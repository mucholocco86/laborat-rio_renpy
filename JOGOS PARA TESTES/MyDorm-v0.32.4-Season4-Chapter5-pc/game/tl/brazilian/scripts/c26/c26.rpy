# game/scripts/c26/c26.rpy:396
translate brazilian c26s001_MeeDate_6cd5eb37:

    # mee "*Risa* Aunque estén aislados, sigo pensando que no es la mejor idea. No sé si los gemidos se escucharán desde las cocinas. O atraerán a algún jabalí."
    mee "*Risos* Mesmo estando isolados, ainda acho que não é a melhor ideia. Não sei se os gemidos serão ouvidos das cozinhas. Ou se atrairão um javali."

# game/scripts/c26/c26.rpy:397
translate brazilian c26s001_MeeDate_7d644cee:

