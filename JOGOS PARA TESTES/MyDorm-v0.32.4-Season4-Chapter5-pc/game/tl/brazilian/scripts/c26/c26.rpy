

# game/scripts/c26/c26.rpy:60
translate brazilian c26s001_MeeDate_e99f27ed:

    # mc "¡Estás guapísima!"
    mc "Você está deslumbrante!"

# game/scripts/c26/c26.rpy:61
translate brazilian c26s001_MeeDate_ba895501:

    # mee "Bueno, una chica tiene que arreglarse para una cita, ¿no? *Risita*"
    mee "Bom, uma garota tem que se arrumar para um encontro, né? *Risos*"

# game/scripts/c26/c26.rpy:62
translate brazilian c26s001_MeeDate_0d115086:

    # mc "Creía que no era una cita. O que decidirías luego si era una cita."
    mc "Achei que não fosse um encontro. Ou que você decidiria depois se era um encontro."

# game/scripts/c26/c26.rpy:64
translate brazilian c26s001_MeeDate_e3bc7b7a:

    # mee "Bueno, pues una mujer tiene que arreglarse cuando va a cenar con su nieto."
    mee "Bem, uma mulher tem que se vestir bem quando vai jantar com o neto."

# game/scripts/c26/c26.rpy:65
translate brazilian c26s001_MeeDate_2e05c372:

    # mee "Ya decidiremos luego si ha sido una cita o no."
    mee "Decidiremos mais tarde se foi um encontro ou não."

# game/scripts/c26/c26.rpy:66
translate brazilian c26s001_MeeDate_5f06014d:

    # mc "Sea lo que sea, te aseguro que, en el restaurante, todos los clientes me van a mirar preguntándose cómo puedo ir con una mujer tan guapa."
    mc "Seja o que for, garanto que, no restaurante, todos os clientes vão me olhar, se perguntando como posso estar com uma mulher tão bonita."

# game/scripts/c26/c26.rpy:68
translate brazilian c26s001_MeeDate_459bf8be:

    # mee "No te va a mirar nadie preguntándose eso mientras cenamos. *Risa*"
    mee "Ninguém vai ficar te olhando com essa cara de espanto enquanto estivermos jantando. *Risos*"

# game/scripts/c26/c26.rpy:69
translate brazilian c26s001_MeeDate_881dfb18:

    # mc "¿Quieres apostar?"
    mc "Quer apostar?"

# game/scripts/c26/c26.rpy:70
translate brazilian c26s001_MeeDate_d11d3718:

    # mee "Vale. ¿Qué quieres apostar?"
    mee "Certo. Em que você quer apostar?"

# game/scripts/c26/c26.rpy:71
translate brazilian c26s001_MeeDate_8d6c7502:

    # mc "Si me miran al menos cinco clientes... y decides que es una cita... hoy duermes en mi habitación."
    mc "Se pelo menos cinco clientes olharem para mim... e você decidir que é um encontro... você vai dormir no meu quarto hoje à noite."

# game/scripts/c26/c26.rpy:72
translate brazilian c26s001_MeeDate_1813fcb9:

    # mc "Aunque mi cama ha sufrido un pequeño accidente por culpa de un gato."
    mc "Embora minha cama tenha sofrido um pequeno acidente por causa de um gato."

# game/scripts/c26/c26.rpy:74
translate brazilian c26s001_MeeDate_9be46529:

    # mee "*Risa* Lo sé, me lo ha contado [nor]."
    mee "*Risos* Eu sei, [nor] me contou."

# game/scripts/c26/c26.rpy:75
translate brazilian c26s001_MeeDate_28bf38f2:

    # mee "La apuesta me parece bien, pero ¿y si no te mira nadie?"
    mee "A ideia me parece boa, mas e se ninguém estiver assistindo?"

# game/scripts/c26/c26.rpy:76
translate brazilian c26s001_MeeDate_efcb438e:

    # mc "No sé. Decide tú."
    mc "Não sei. Você decide."

# game/scripts/c26/c26.rpy:77
translate brazilian c26s001_MeeDate_72d55a83:

    # mee "Si no te mira nadie, tú duermes en la mía. Si decidimos que es una cita, claro. *Risita* Al menos la mía tiene una cama en buen estado."
    mee "Se ninguém estiver olhando, você pode dormir na minha. Se decidirmos que é um encontro, claro. *Risos* Pelo menos a minha tem uma cama decente."

# game/scripts/c26/c26.rpy:78
translate brazilian c26s001_MeeDate_996f86d2:

    # mc "Parece un buen plan. *Risa* Sea como sea, hoy dormiremos juntos. Si {b}decides{/b} que es una cita."
    mc "Parece um bom plano. *Risos* Enfim, vamos dormir juntos hoje à noite. Se você decidir que é um encontro."

# game/scripts/c26/c26.rpy:80
translate brazilian c26s001_MeeDate_1a6fe4e8:

    # mee "[mc]..."
    mee "[mc]..."

# game/scripts/c26/c26.rpy:81
translate brazilian c26s001_MeeDate_b9ae80eb:

    # mc "¿Pasa algo, Meemaw?"
    mc "Aconteceu alguma coisa, vovó?"

# game/scripts/c26/c26.rpy:83
translate brazilian c26s001_MeeDate_7dde478e:

    # mee "¿Podemos dejar de fingir que esto no es una cita?"
    mee "Podemos parar de fingir que isso não é um encontro?"

# game/scripts/c26/c26.rpy:84
translate brazilian c26s001_MeeDate_1da4a18b:

    # mee "Hace días que decidí que lo sería, y me muero por besarte..."
    mee "Eu decidi há dias que seria, e estou louca para te beijar..."

# game/scripts/c26/c26.rpy:86
translate brazilian c26s001_MeeDate_e2be6ff0:

    # "No tienes que responder. Al menos no con palabras. Tus labios besan los de [mee] con dulzura."
    "Você não precisa responder. Pelo menos não com palavras. Seus lábios beijam os de [mee] suavemente."

# game/scripts/c26/c26.rpy:87
translate brazilian c26s001_MeeDate_672bd482:

    # "Su cuerpo tiembla bajo tu tacto hasta que se separa reluctantemente de tus labios."
    "Seu corpo estremece sob seu toque até que, relutantemente, ela se afasta de seus lábios."

# game/scripts/c26/c26.rpy:89
translate brazilian c26s001_MeeDate_bf01fb4d:

    # mee "*Respirando pesadamente* Creo que como aperitivo hay suficiente."
    mee "*Respirando fundo* Acho que isso já basta como aperitivo."

# game/scripts/c26/c26.rpy:90
translate brazilian c26s001_MeeDate_7ee46f6f:

    # mc "Hay que dejar más besos para después de la cena, ¿no?"
    mc "Não deveríamos guardar os beijos para depois do jantar?"

# game/scripts/c26/c26.rpy:91
translate brazilian c26s001_MeeDate_dc680032:

    # mc "Por cierto, ¿dónde vamos a ir?"
    mc "A propósito, para onde vamos?"

# game/scripts/c26/c26.rpy:93
translate brazilian c26s001_MeeDate_91f1b43e:

    # mee "He alquilado un sitio en San Luis."
    mee "Aluguei um imóvel em San Luis."

# game/scripts/c26/c26.rpy:94
translate brazilian c26s001_MeeDate_9413e0d6:

    # mc "¿Alquilado? Querrás decir reservado, ¿no?"
    mc "Alugado? Você quis dizer reservado, certo?"

# game/scripts/c26/c26.rpy:95
translate brazilian c26s001_MeeDate_95b80b24:

    # mee "Lo tendrás que descubrir cuando lleguemos."
    mee "Você terá que descobrir quando chegarmos lá."

# game/scripts/c26/c26.rpy:97
translate brazilian c26s001_MeeDate_057020cc:

    # "[mee] introduce la dirección en el GPS. Llegaréis en unos 30 minutos."
    "Insira o endereço no seu GPS. Você chegará em cerca de 30 minutos."

# game/scripts/c26/c26.rpy:98
translate brazilian c26s001_MeeDate_0bc6dfbf:

    # "Cuando faltan unos minutos para llegar, hace una llamada, indicando que estáis a menos de cinco minutos."
    "Quando faltam apenas alguns minutos para chegar, ele faz uma ligação, indicando que você está a menos de cinco minutos de distância."

# game/scripts/c26/c26.rpy:99
translate brazilian c26s001_MeeDate_6a7ea241:

    # "Parece que le dan unas indicaciones con las que te guía hasta una rotonda desde la que salen varios caminos empedrados que se adentran en el bosque."
    "Parece que eles te dão indicações que te levam a uma rotunda de onde partem vários caminhos de pedra que conduzem à floresta."

# game/scripts/c26/c26.rpy:101
translate brazilian c26s001_MeeDate_455e492e:

    # "Aparcas la camioneta en el lugar que te indica [mee] y camináis unos minutos por uno de los caminos rodeado de árboles."
    "Estacione a van no local indicado por [mee] e caminhe por alguns minutos ao longo de um dos caminhos rodeados de árvores."

# game/scripts/c26/c26.rpy:103
translate brazilian c26s001_MeeDate_ab3a7912:

    # "Al girar por una de las curvas del camino, aparece una visión de cuento en medio de un claro en el bosque."
    "Ao contornar uma das curvas da estrada, uma visão de conto de fadas surge no meio de uma clareira na floresta."

# game/scripts/c26/c26.rpy:105
translate brazilian c26s001_MeeDate_7f6a5a0f:

    # mc "¡Wow, Meemaw! ¡Es precioso!"
    mc "Nossa, vovó! Que lindo!"

# game/scripts/c26/c26.rpy:106
translate brazilian c26s001_MeeDate_4b08a348:

    # mee "¿Te gusta? No mucha gente conoce este sitio."
    mee "Você gosta? Poucas pessoas conhecem este lugar."

# game/scripts/c26/c26.rpy:107
translate brazilian c26s001_MeeDate_cbb0a18f:

    # mc "Es increíble. ¿Cómo es que tú lo conoces?"
    mc "Isso é incrível. Como você o conhece?"

# game/scripts/c26/c26.rpy:109
translate brazilian c26s001_MeeDate_7cab5fb6:

    # mee "Vendí estos terrenos unos años antes de que nacieras."
    mee "Vendi este terreno alguns anos antes de você nascer."

# game/scripts/c26/c26.rpy:110
translate brazilian c26s001_MeeDate_9f3b7009:

    # mee "Iban a construir un hotel también, pero al final no lo hicieron y sólo construyeron el restaurante."
    mee "Eles também iam construir um hotel, mas no final não o fizeram e construíram apenas o restaurante."

# game/scripts/c26/c26.rpy:111
translate brazilian c26s001_MeeDate_1723bb21:

    # mc "¿Dónde están los camareros? Si tienen que venir por el camino empedrado más les vale ir en patinete."
    mc "Onde estão os garçons? Se eles tiverem que vir pelo caminho de paralelepípedos, é melhor que venham de scooter."

# game/scripts/c26/c26.rpy:113
translate brazilian c26s001_MeeDate_d63bcc5f:

    # mee "*Risa* Este sitio no funciona así, cariño. Pedí la comida cuando lo alquilé."
    mee "*Risos* Aqui não funciona assim, querida. Eu pedi a comida quando aluguei o imóvel."

# game/scripts/c26/c26.rpy:114
translate brazilian c26s001_MeeDate_99282fef:

    # mee "Lo han preparado todo en el gazebo cuando he llamado."
    mee "Quando liguei, já tinha tudo pronto no gazebo."

# game/scripts/c26/c26.rpy:115
translate brazilian c26s001_MeeDate_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c26/c26.rpy:117
translate brazilian c26s001_MeeDate_173a4dc2:

    # mee "¿Qué tal si respondo a tus preguntas allí? *Risa* Parecemos dos idiotas en medio del bosque."
    mee "Que tal eu responder às suas perguntas lá? *Risos* Parecemos dois idiotas no meio da floresta."

# game/scripts/c26/c26.rpy:118
translate brazilian c26s001_MeeDate_6d7821fa:

    # mc "*Risa* Tienes razón. Te sigo."
    mc "*Risos* Você tem razão. Eu vou te seguir."

# game/scripts/c26/c26.rpy:120
translate brazilian c26s001_MeeDate_f6d4cb0b:

    # mee "¿Ves? Detrás tuyo tienes los cortes fríos y aquí la comida caliente."
    mee "Veja? Atrás de você estão os frios e aqui está a comida quente."

# game/scripts/c26/c26.rpy:121
translate brazilian c26s001_MeeDate_52b33d7d:

    # mc "Incluso tiene un sofá. Es un sitio genial. Muy romántico."
    mc "Tem até um sofá. É um ótimo lugar. Muito romântico."

# game/scripts/c26/c26.rpy:123
translate brazilian c26s001_MeeDate_b9260d76:

    # mee "Nunca más vamos a tener una primera cita, con lo que quería que fuera especial."
    mee "Nunca mais teremos um primeiro encontro, então eu queria que fosse especial."

# game/scripts/c26/c26.rpy:124
translate brazilian c26s001_MeeDate_5ebadfc3:

    # mc "Lo has conseguido. Es precioso."
    mc "Você conseguiu. Ficou lindo."

# game/scripts/c26/c26.rpy:126
translate brazilian c26s001_MeeDate_f21303a6:

    # mee "Y, como puedes ver, ningún cliente te va a mirar preguntándose nada. *Risa*"
    mee "E, como você pode ver, nenhum cliente vai olhar para você com alguma dúvida. *Risos*"

# game/scripts/c26/c26.rpy:127
translate brazilian c26s001_MeeDate_17501436:

    # mee "Hoy duermes en mi habitación."
    mee "Você vai dormir no meu quarto esta noite."

# game/scripts/c26/c26.rpy:128
translate brazilian c26s001_MeeDate_0cf017ca:

    # mc "*Risa* Eso es trampa. Tú sabías que habías ganado la apuesta antes de hacerla."
    mc "*Risos* Isso é trapaça. Você sabia que tinha ganhado a aposta antes mesmo de fazê-la."

# game/scripts/c26/c26.rpy:130
translate brazilian c26s001_MeeDate_b614db1b:

    # mee "*Risa* Nunca apuestes a ciegas, cielo."
    mee "*Risos* Nunca aposte às cegas, querida."

# game/scripts/c26/c26.rpy:131
translate brazilian c26s001_MeeDate_402e9590:

    # mee "Además, no quieres que una pobre anciana duerma en un colchón en el suelo."
    mee "Além disso, você não quer uma pobre senhora idosa dormindo em um colchão no chão."

# game/scripts/c26/c26.rpy:132
translate brazilian c26s001_MeeDate_2b8fc357:

    # mc "*Risa* En este caso, es una apuesta que no me importa perder."
    mc "*Risos* Nesse caso, é uma aposta que não me importo de perder."

# game/scripts/c26/c26.rpy:133
translate brazilian c26s001_MeeDate_9f69baf8:

    # mee "Coge la comida que quieras. No sabía qué te apetecería y he pedido muchísima comida."
    mee "Pode pegar a comida que quiser. Eu não sabia do que você gostaria, então pedi bastante comida."

# game/scripts/c26/c26.rpy:135
translate brazilian c26s001_MeeDate_9a3a27e0:

    # "[mee] no miente. Hay comida para alimentar a la mitad de la familia. Especialmente si dentro de esa mitad no está Jamaal."
    "[mee] Ele não está mentindo. Há comida suficiente para alimentar metade da família. Principalmente se Jamaal não fizer parte dessa metade."

# game/scripts/c26/c26.rpy:137
translate brazilian c26s001_MeeDate_d9243e15:

    # mc "Tenías razón. Has pedido demasiada comida. ¡Pero si hay incluso bacon canadiense!"
    mc "Você tinha razão. Pediu comida demais. Tem até bacon canadense!"

# game/scripts/c26/c26.rpy:138
translate brazilian c26s001_MeeDate_e3bdc460:

    # mee "*Risa* Ese es para mí. Ya sé que no te gusta, pero para mí es un placer culpable."
    mee "*Risos* Essa é para mim. Eu sei que você não gosta, mas para mim é um prazer secreto."

# game/scripts/c26/c26.rpy:139
translate brazilian c26s001_MeeDate_7ecfb6d9:

    # mc "*Risa* ¿Qué va a ser lo siguiente? ¿Pizza con cosas raras?"
    mc "*Risos* O que vem a seguir? Pizza com ingredientes estranhos?"

# game/scripts/c26/c26.rpy:141
translate brazilian c26s001_MeeDate_8e5336a4:

    # mee "*Risa* No, eso se lo dejo a [bet]. Creo que si pones un bisonte entero encima de una base de pizza sería capaz de comérselo."
    mee "*Risos* Não, vou deixar isso para o [bet]. Acho que se você colocasse um bisão inteiro em cima de uma base de pizza, ele conseguiria comê-la."

# game/scripts/c26/c26.rpy:142
translate brazilian c26s001_MeeDate_cca5d0e0:

    # mc "*Risa* Me lo creo."
    mc "*Risos* Eu acredito."

# game/scripts/c26/c26.rpy:143
translate brazilian c26s001_MeeDate_8d4dc8e7:

    # mc "Pero explícame la historia de este sitio. Parece un sitio muy especial."
    mc "Mas conte-me a história deste lugar. Parece ser um lugar muito especial."

# game/scripts/c26/c26.rpy:145
translate brazilian c26s001_MeeDate_750f1bd5:

    # mee "Lo es. Querían construir un complejo de lujo para famosos que huyeran de L.A. Por eso los gazebos están escondidos, para darles intimidad."
    mee "Sim, é isso mesmo. Eles queriam construir um resort de luxo para celebridades que fugiam de Los Angeles. É por isso que os gazebos estão escondidos, para lhes dar privacidade."

# game/scripts/c26/c26.rpy:146
translate brazilian c26s001_MeeDate_46edd6a8:

    # mee "Siempre pensé que estaba pensado para que pudieran venir aquí para escapar de los paparazzis."
    mee "Sempre achei que fosse intencional, para que eles pudessem vir aqui e escapar dos paparazzi."

# game/scripts/c26/c26.rpy:147
translate brazilian c26s001_MeeDate_7d596d39:

    # mc "Tiene lógica."
    mc "Faz sentido."

# game/scripts/c26/c26.rpy:150
translate brazilian c26s001_MeeDate_455c54e7:

    # mee "Yo vendí los terrenos y tu abuelo hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "Eu vendi o terreno e seu avô projetou o restaurante. Foi um dos seus últimos projetos."

# game/scripts/c26/c26.rpy:152
translate brazilian c26s001_MeeDate_51144d46:

    # mee "Yo vendí los terrenos y John hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "Vendi o terreno e John projetou o restaurante. Foi um de seus últimos projetos."

# game/scripts/c26/c26.rpy:153
translate brazilian c26s001_MeeDate_5098616f:

    # mee "El hotel fue diseñado por un estudio de San Francisco. Una cosa muy lujosa. Y muy fea a mi parecer."
    mee "O hotel foi projetado por um estúdio de São Francisco. Muito luxuoso. E muito feio, na minha opinião."

# game/scripts/c26/c26.rpy:154
translate brazilian c26s001_MeeDate_4ca75ceb:

    # mee "John no llegó a verlo completado, ni a saber que el hotel no se construiría."
    mee "John não viveu para ver a obra concluída, nem para saber que o hotel não seria construído."

# game/scripts/c26/c26.rpy:155
translate brazilian c26s001_MeeDate_4ce4b479:

    # mc "Creo que no deberíamos haber venido a este sitio, Meemaw. Te debe traer recuerdos dolorosos."
    mc "Acho que não deveríamos ter vindo a este lugar, vovó. Deve trazer à tona lembranças dolorosas."

# game/scripts/c26/c26.rpy:157
translate brazilian c26s001_MeeDate_7d1c8a20:

    # mee "Tan dolorosos como cualquier otro de sus edificios. Este no es más especial que otros."
    mee "Tão doloroso quanto qualquer outro de seus edifícios. Este não é mais especial do que os demais."

# game/scripts/c26/c26.rpy:158
translate brazilian c26s001_MeeDate_4a461efb:

    # mee "Además, para mí es un sitio nuevo. No estaba acabado cuando John murió y nunca vine después."
    mee "Além disso, é um lugar novo para mim. Não estava terminado quando John morreu, e eu nunca mais voltei depois disso."

# game/scripts/c26/c26.rpy:159
translate brazilian c26s001_MeeDate_8aa83788_1:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c26/c26.rpy:162
translate brazilian c26s001_MeeDate_e33e7362:

    # mee "Cuando a tu abuelo le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Quando seu avô foi diagnosticado com câncer, ele me fez prometer que eu reconstruiria minha vida sem ele."

# game/scripts/c26/c26.rpy:164
translate brazilian c26s001_MeeDate_4ca1d8d2:

    # mee "Cuando a John le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Quando John foi diagnosticado com câncer, ele me fez prometer que eu reconstruiria minha vida sem ele."

# game/scripts/c26/c26.rpy:165
translate brazilian c26s001_MeeDate_5bea8fa1:

    # mee "He tardado 23 años. Y un sitio que diseñó él me parece un buen lugar para empezar."
    mee "Levei 23 anos. E um site que ele projetou parece um bom ponto de partida."

# game/scripts/c26/c26.rpy:166
translate brazilian c26s001_MeeDate_85439d39:

    # mc "No creo que hayas tardado 23 años. Has vivido una vida plena todos esos años."
    mc "Não acho que tenha levado 23 anos. Você viveu uma vida plena durante todos esses anos."

# game/scripts/c26/c26.rpy:167
translate brazilian c26s001_MeeDate_0a6f7cf6:

    # mc "Estar o no en una relación no debería ser la definición de reconstruir una vida."
    mc "Estar ou não em um relacionamento não deveria ser a definição de reconstruir uma vida."

# game/scripts/c26/c26.rpy:169
translate brazilian c26s001_MeeDate_bd7cf37a:

    # mee "Ah, OK. Entonces ya nos podemos ir. *Risa*"
    mee "Ah, ok. Então podemos ir. *Risos*"

# game/scripts/c26/c26.rpy:170
translate brazilian c26s001_MeeDate_5b15d382:

    # mc "Lo estoy diciendo en serio."
    mc "Estou falando sério."

# game/scripts/c26/c26.rpy:172
translate brazilian c26s001_MeeDate_0d8d6878:

    # mee "Yo también, [mc]. Hasta ahora había pensado que estaba viviendo una buena vida, pero estos últimos días..."
    mee "Eu também, [mc]. Até agora eu achava que estava vivendo uma boa vida, mas nesses últimos dias..."

# game/scripts/c26/c26.rpy:173
translate brazilian c26s001_MeeDate_0d9728e8:

    # mee "Me han hecho recuperar una ilusión que no recordaba, si es que alguna vez la he tenido."
    mee "Eles reacenderam uma esperança que eu havia esquecido, se é que algum dia a tive."

# game/scripts/c26/c26.rpy:175
translate brazilian c26s001_MeeDate_056ce8f9:

    # mc "Con el abuelo la tendrías, ¿no?"
    mc "Você faria isso com seu avô, não faria?"

# game/scripts/c26/c26.rpy:177
translate brazilian c26s001_MeeDate_6a446d59:

    # mc "Con John la tendrías, ¿no?"
    mc "Com o John você teria isso, certo?"

# game/scripts/c26/c26.rpy:179
translate brazilian c26s001_MeeDate_521da6e2:

    # mee "Era diferente. Todo se desarrolló muy rápido..."
    mee "Foi diferente. Tudo se desenvolveu muito rapidamente..."

# game/scripts/c26/c26.rpy:180
translate brazilian c26s001_MeeDate_511397d9:

    # mee "[bet] me dijo que te explicó nuestra historia, con lo que ya lo sabes."
    mee "[bet] me disse que explicou nossa história para você, então você já sabe."

# game/scripts/c26/c26.rpy:182
translate brazilian c26s001_MeeDate_41f1f948:

    # mee "No había sentimiento de anticipación después del fin de semana en el que nos conocimos."
    mee "Não havia qualquer expectativa após o fim de semana em que nos conhecemos."

# game/scripts/c26/c26.rpy:184
translate brazilian c26s001_MeeDate_e3224f3c:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener hijos..."
    mee "Tudo parecia estar acontecendo naturalmente. O encontro, o casamento, os filhos..."

# game/scripts/c26/c26.rpy:186
translate brazilian c26s001_MeeDate_45784042:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener a [nor]..."
    mee "Tudo parecia estar acontecendo naturalmente. O encontro, o casamento, a gravidez..."

# game/scripts/c26/c26.rpy:187
translate brazilian c26s001_MeeDate_bf512acf:

    # mc "Y lo que está pasando ahora es diferente, ¿no?"
    mc "E o que está acontecendo agora é diferente, não é?"

# game/scripts/c26/c26.rpy:189
translate brazilian c26s001_MeeDate_30ccb98f:

    # mee "Lo es. Es muy diferente. No vamos a tener hijos. No creo que los quisiera a mi edad aunque pudiera."
    mee "É verdade. É muito diferente. Não vamos ter filhos. Acho que nem gostaria de tê-los na minha idade, mesmo se pudesse."

# game/scripts/c26/c26.rpy:191
translate brazilian c26s001_MeeDate_f83019ab:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que tu madre ahora!"
    mee "Eu te conheço desde que você nasceu. Caramba, eu era mais velho quando você nasceu do que sua mãe é agora!"

# game/scripts/c26/c26.rpy:193
translate brazilian c26s001_MeeDate_d20de51a:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que [mar] ahora!"
    mee "Eu te conheço desde que você nasceu. Caramba, eu era mais velho quando você nasceu do que sou agora!"

# game/scripts/c26/c26.rpy:194
translate brazilian c26s001_MeeDate_3283d3bc:

    # mc "Tenías la edad de [nor]..."
    mc "Você tinha a idade de [nor]..."

# game/scripts/c26/c26.rpy:196
translate brazilian c26s001_MeeDate_4cb3b6e2:

    # mee "Sí. Exactamente la misma edad que [nor] tiene ahora."
    mee "Sim. Exatamente a mesma idade que [nor] tem agora."

# game/scripts/c26/c26.rpy:197
translate brazilian c26s001_MeeDate_50252c25:

    # mee "Y no es... natural... que tú y yo estemos juntos."
    mee "E não é... natural... que você e eu estejamos juntos."

# game/scripts/c26/c26.rpy:199
translate brazilian c26s001_MeeDate_07ee4791:

    # mee "Aunque no renunciaría a ello por nada ni por nadie. Me da lo mismo lo que puedan pensar los demás."
    mee "Embora eu não trocasse isso por nada nem por ninguém. Não me importo com o que os outros possam pensar."

# game/scripts/c26/c26.rpy:200
translate brazilian c26s001_MeeDate_ba3e2b07:

    # mc "Yo tampoco renunciaría a esto."
    mc "Eu também não desistiria disso."

# game/scripts/c26/c26.rpy:202
translate brazilian c26s001_MeeDate_cd488b7f:

    # mee "*Risa* ¿Aunque me guste el bacon canadiense?"
    mee "*Risos* Mesmo eu gostando de bacon canadense?"

# game/scripts/c26/c26.rpy:203
translate brazilian c26s001_MeeDate_c68ede67:

    # mc "*Risa* Aunque te guste el bacon canadiense."
    mc "*Risos* Mesmo que você goste de bacon canadense."

# game/scripts/c26/c26.rpy:205
translate brazilian c26s001_MeeDate_a143917f:

    # mee "Pero hablando en serio, me encanta lo que ha pasado entre nosotros en los últimos días."
    mee "Mas falando sério, adorei o que aconteceu entre nós nos últimos dias."

# game/scripts/c26/c26.rpy:206
translate brazilian c26s001_MeeDate_14dd0f5d:

    # mee "Me encanta no saber qué va a pasar la siguiente vez que estemos juntos. Me encanta ese sentimiento de anticipación."
    mee "Adoro não saber o que vai acontecer da próxima vez que estivermos juntos. Adoro essa sensação de expectativa."

# game/scripts/c26/c26.rpy:207
translate brazilian c26s001_MeeDate_f9a83ae8:

    # mc "Pasará lo que queramos que pase. No hay nadie poniendo límites."
    mc "Tudo o que quisermos que aconteça, acontecerá. Ninguém está impondo limites."

# game/scripts/c26/c26.rpy:209
translate brazilian c26s001_MeeDate_1a6713c0:

    # mee "*Risa* Sí que lo hay. Yo. No quiero descubrir todo lo que somos capaces de hacer en nuestra primera noche."
    mee "*Risos* Sim, existe. Eu. Não quero descobrir tudo o que somos capazes de fazer na nossa primeira noite."

# game/scripts/c26/c26.rpy:210
translate brazilian c26s001_MeeDate_5771e687:

    # mee "No quiero que ese sentimiento de anticipación desaparezca."
    mee "Não quero que essa sensação de expectativa desapareça."

# game/scripts/c26/c26.rpy:211
translate brazilian c26s001_MeeDate_1d35912a:

    # mc "No tiene por qué desaparecer. Siempre podemos inventar cosas nuevas que hacer."
    mc "Não precisa desaparecer. Podemos sempre inventar novas coisas para fazer."

# game/scripts/c26/c26.rpy:213
translate brazilian c26s001_MeeDate_b4196dd9:

    # mc "Por ejemplo, helado. Estaba bueno."
    mc "Por exemplo, sorvete. Estava bom."

# game/scripts/c26/c26.rpy:215
translate brazilian c26s001_MeeDate_b74870ab:

    # mee "¿Ya lo has probado?"
    mee "Você já experimentou?"

# game/scripts/c26/c26.rpy:216
translate brazilian c26s001_MeeDate_ea9e253c:

    # mc "Justo antes de ir a buscarte. Era tentador."
    mc "Pouco antes de eu vir te buscar. Foi tentador."

# game/scripts/c26/c26.rpy:217
translate brazilian c26s001_MeeDate_35bd7889:

    # mee "¿Qué te ha parecido? ¿Te ha gustado? Esperaba ser la primera en hacerlo."
    mee "O que você achou? Gostou? Eu esperava ser o primeiro a dizer isso."

# game/scripts/c26/c26.rpy:218
translate brazilian c26s001_MeeDate_d91826e5:

    # mc "Estaba bueno. No he notado mucha diferencia con el helado normal."
    mc "Estava bom. Não notei muita diferença em relação ao sorvete normal."

# game/scripts/c26/c26.rpy:219
translate brazilian c26s001_MeeDate_bdd5010c:

    # mc "Pero volviendo al sentimiento de anticipación..."
    mc "Mas voltando à sensação de expectativa..."

# game/scripts/c26/c26.rpy:221
translate brazilian c26s001_MeeDate_e03cbced:

    # mee "¿Qué crees que pasará esta noche?"
    mee "O que você acha que vai acontecer esta noite?"

# game/scripts/c26/c26.rpy:222
translate brazilian c26s001_MeeDate_2d8c85ca:

    # mc "¡Qué directa! *Risa*"
    mc "Que direto! *Risos*"

# game/scripts/c26/c26.rpy:223
translate brazilian c26s001_MeeDate_0c2e6399:

    # mc "Creo que vamos a seguir disfrutando de una bonita cena."
    mc "Acho que vamos continuar desfrutando de um jantar agradável."

# game/scripts/c26/c26.rpy:225
translate brazilian c26s001_MeeDate_e0402574:

    # mee "¡No me refiero a eso! *Risa* Sabes a lo que me refiero."
    mee "Não é isso que eu quero dizer! *Risos* Você sabe o que eu quero dizer."

# game/scripts/c26/c26.rpy:226
translate brazilian c26s001_MeeDate_40fb7c8b:

    # mc "¿Te refieres a cuando me quede a dormir en tu habitación?"
    mc "Você quer dizer quando eu passei a noite no seu quarto?"

# game/scripts/c26/c26.rpy:227
translate brazilian c26s001_MeeDate_446c0699:

    # mc "Pues que tendré que ir a por un pijama a la mía primero."
    mc "Bom, primeiro preciso ir à loja comprar um pijama."

# game/scripts/c26/c26.rpy:229
translate brazilian c26s001_MeeDate_6a457054:

    # mee "Había oído que dormías desnudo..."
    mee "Ouvi dizer que você dormia nu..."

# game/scripts/c26/c26.rpy:230
translate brazilian c26s001_MeeDate_c65cfc16:

    # mc "Por norma sí, pero no sé si querrás que lo haga."
    mc "Em regra geral, sim, mas não sei se você gostaria que eu fizesse isso."

# game/scripts/c26/c26.rpy:231
translate brazilian c26s001_MeeDate_287f90ba:

    # mee "Por mí no hace falta que duermas con más ropa de la que sueles usar."
    mee "Na minha opinião, você não precisa dormir com mais roupas do que costuma usar."

# game/scripts/c26/c26.rpy:232
translate brazilian c26s001_MeeDate_d2756205:

    # mc "¿Y tú? ¿Cómo duermes?"
    mc "E você? Como você consegue dormir?"

# game/scripts/c26/c26.rpy:234
translate brazilian c26s001_MeeDate_b4b4ad67:

    # mee "Por norma con un pijama. Pero hoy... esperaba que me dieras calor suficiente como para no necesitarlo."
    mee "Normalmente uso pijama. Mas hoje... eu esperava que você me mantivesse aquecida o suficiente para que eu não precisasse usá-lo."

# game/scripts/c26/c26.rpy:235
translate brazilian c26s001_MeeDate_038a732f:

    # mc "Me siento un hombre objeto usado como si fuera una mera bolsa de agua caliente. *Risa*"
    mc "Me sinto como um homem objetificado, usado como uma mera bolsa de água quente. *Risos*"

# game/scripts/c26/c26.rpy:236
translate brazilian c26s001_MeeDate_ac2c5c33:

    # mc "Pero me parece una buena idea. No vamos a ver nada que no hayamos visto con anterioridad."
    mc "Mas acho que é uma boa ideia. Não vamos ver nada que já não tenhamos visto antes."

# game/scripts/c26/c26.rpy:237
translate brazilian c26s001_MeeDate_f2bafc07:

    # mc "¿Lado derecho o izquierdo de la cama?"
    mc "Lado direito ou esquerdo da cama?"

# game/scripts/c26/c26.rpy:239
translate brazilian c26s001_MeeDate_bb0d87ac:

    # mee "Derecho. Y no pienso ceder sobre eso, al menos en mi cama."
    mee "Certo. E não pretendo ceder nisso, pelo menos não na minha cama."

# game/scripts/c26/c26.rpy:240
translate brazilian c26s001_MeeDate_6279dea7:

    # mc "*Risa* No hace falta que cedas. Yo duermo en el centro o en la izquierda."
    mc "*Risos* Você não precisa ceder. Eu durmo no meio ou à esquerda."

# game/scripts/c26/c26.rpy:241
translate brazilian c26s001_MeeDate_24a618e2:

    # mc "Nuestra primera discusión como pareja no va a ser sobre el lado de la cama en el que dormimos."
    mc "Nossa primeira discussão como casal não será sobre em qual lado da cama vamos dormir."

# game/scripts/c26/c26.rpy:243
translate brazilian c26s001_MeeDate_385d9d9c:

    # mee "Pero sabes que llegará tarde o temprano, ¿verdad? Un día discutiremos."
    mee "Mas você sabe que isso vai acontecer mais cedo ou mais tarde, não é? Um dia a gente discute."

# game/scripts/c26/c26.rpy:244
translate brazilian c26s001_MeeDate_6d613ec8:

    # mc "Estoy seguro de que lo hará, pero ese puente habrá que cruzarlo en su momento. No es necesario pensar en ese puente cuando ni siquiera sabemos que río atraviesa."
    mc "Tenho certeza que sim, mas essa questão terá que ser resolvida no devido tempo. Não adianta pensar nessa questão quando nem sequer sabemos qual rio ela atravessa."

# game/scripts/c26/c26.rpy:246
translate brazilian c26s001_MeeDate_14d0ba4f:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde tu abuelo..."
    mee "Você tem razão. Eu me preocupo demais, mas não estou com ninguém desde o seu avô..."

# game/scripts/c26/c26.rpy:248
translate brazilian c26s001_MeeDate_268b26d5:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde John..."
    mee "Você tem razão. Eu me preocupo demais, mas não estou com ninguém desde o John..."

# game/scripts/c26/c26.rpy:249
translate brazilian c26s001_MeeDate_91f7a39a:

    # mc "Si te sirve de algo, Tía [bet] dijo que me parecía mucho a él. A lo mejor las discusiones son parecidas."
    mc "Se isso ajudar, a tia [bet] disse que eu me pareço muito com ele. Talvez nossos argumentos sejam parecidos."

# game/scripts/c26/c26.rpy:251
translate brazilian c26s001_MeeDate_274a0851:

    # mee "*Risa* Te pareces a él en algunas cosas, pero hay más diferencias que similitudes."
    mee "*Risos* Você se parece com ele em alguns aspectos, mas as diferenças superam as semelhanças."

# game/scripts/c26/c26.rpy:252
translate brazilian c26s001_MeeDate_ae926927:

    # mc "¿Por ejemplo?"
    mc "Por exemplo?"

# game/scripts/c26/c26.rpy:254
translate brazilian c26s001_MeeDate_20d01048:

    # mee "Tu eres más directo y asertivo cuando quieres algo. Él le daba vueltas y más vueltas hasta que ya no recordabas de quién había sido la idea original."
    mee "Você é mais direto e assertivo quando quer alguma coisa. Ele ficou dando voltas e voltas até você nem se lembrar mais de quem tinha sido a ideia original."

# game/scripts/c26/c26.rpy:255
translate brazilian c26s001_MeeDate_c7669102:

    # mc "Bueno, creo que los rodeos innecesarios son... innecesarios."
    mc "Bem, eu acho que desvios desnecessários são... desnecessários."

# game/scripts/c26/c26.rpy:257
translate brazilian c26s001_MeeDate_a54c5d48:

    # mee "Después está vuestro concepto de familia. Es muy diferente."
    mee "Depois, há o seu conceito de família. É muito diferente."

# game/scripts/c26/c26.rpy:258
translate brazilian c26s001_MeeDate_1c8fc493:

    # mc "Tía [bet] me dijo lo contrario, que los dos aceptábamos a todo el mundo en la familia."
    mc "A tia [bet] me disse o contrário, que nós dois aceitávamos todos na família."

# game/scripts/c26/c26.rpy:259
translate brazilian c26s001_MeeDate_11873b42:

    # mee "Ahí está la diferencia. Tú aceptas a todo el mundo en la familia."
    mee "Essa é a diferença. Você aceita todos na família."

# game/scripts/c26/c26.rpy:260
translate brazilian c26s001_MeeDate_981a38ec:

    # mee "El daba la bienvenida a todo el mundo a {b}nuestra{/b} familia. Nosotros siempre íbamos a ser el centro de esa familia extendida."
    mee "Ele acolheu a todos em nossa família. Nós sempre seríamos o centro dessa grande família."

# game/scripts/c26/c26.rpy:261
translate brazilian c26s001_MeeDate_5b43c1a9:

    # mee "Quien quisiera unirse debía adaptarse a nosotros. Tú permites que cada cual siga siendo como es."
    mee "Quem quisesse se juntar a nós tinha que se adaptar. Vocês permitem que todos permaneçam como são."

# game/scripts/c26/c26.rpy:262
translate brazilian c26s001_MeeDate_40ddff33:

    # mc "Es que la familia no es mía. Es de todos. Los de siempre y los nuevos."
    mc "A questão é que família não é só minha. Pertence a todos. Àqueles que sempre estiveram presentes e àqueles que são novos."

# game/scripts/c26/c26.rpy:264
translate brazilian c26s001_MeeDate_a3d32e63:

    # mee "¿Puedes ver la diferencia? Tú no quieres ser el centro de la familia ni imponer normas."
    mee "Consegue ver a diferença? Você não quer ser o centro das atenções da família nem impor regras."

# game/scripts/c26/c26.rpy:265
translate brazilian c26s001_MeeDate_64ee2e3f:

    # mee "Para él, la familia era nuestra, suya y mía."
    mee "Para ele, a família era nossa, dele e minha."

# game/scripts/c26/c26.rpy:267
translate brazilian c26s001_MeeDate_57807ca8:

    # mee "Y de nuestros hijos más tarde."
    mee "E mais tarde, nossos filhos."

# game/scripts/c26/c26.rpy:269
translate brazilian c26s001_MeeDate_2491ac7c:

    # mee "Y de [nor] más tarde."
    mee "E de [nor] mais tarde."

# game/scripts/c26/c26.rpy:270
translate brazilian c26s001_MeeDate_6a4e5029:

    # mee "Pero si alguien más quería ser parte de la familia, lo tenía que hacer bajo nuestras condiciones."
    mee "Mas se mais alguém quisesse fazer parte da família, teria que fazê-lo nos nossos termos."

# game/scripts/c26/c26.rpy:271
translate brazilian c26s001_MeeDate_6e5d5b3a:

    # mc "Supongo que son otros tiempos y el concepto de familia ha cambiado. No hay que juzgarle en base a nuestros valores actuales."
    mc "Imagino que os tempos mudaram e o conceito de família evoluiu. Não devemos julgá-lo com base em nossos valores atuais."

# game/scripts/c26/c26.rpy:273
translate brazilian c26s001_MeeDate_4110b322:

    # mee "No le estoy juzgando, [mc]. Sólo digo que es un aspecto importante en el que sois diferentes. Ni mejores ni peores."
    mee "Não estou julgando ele, [mc]. Estou apenas dizendo que é um aspecto importante em que vocês dois são diferentes. Nem melhor nem pior."

# game/scripts/c26/c26.rpy:274
translate brazilian c26s001_MeeDate_990d0171:

    # mee "Como has dicho, eran otros tiempos. El poliamor o los harenes eran cosas... raras."
    mee "Como você disse, eram outros tempos. Poliamor e haréns eram... coisas estranhas."

# game/scripts/c26/c26.rpy:276
translate brazilian c26s001_MeeDate_f5eccc60:

    # mc "¿Cómo te sientes al formar parte de un harén? Supongo que no debe de ser fácil para ti."
    mc "Como é se sentir parte de um harém? Imagino que não seja fácil para você."

# game/scripts/c26/c26.rpy:278
translate brazilian c26s001_MeeDate_e4426ebc:

    # mee "No he pensado mucho en ello. Siempre me había parecido algo... tercermundista... con un macho dominante y unas mujeres sumisas, quizás contra su voluntad."
    mee "Não pensei muito nisso. Sempre me pareceu... coisa de terceiro mundo... com um homem dominante e mulheres submissas, talvez contra a vontade delas."

# game/scripts/c26/c26.rpy:279
translate brazilian c26s001_MeeDate_ef81bc07:

    # mee "Yo también soy de otros tiempos..."
    mee "Eu também sou de outra época..."

# game/scripts/c26/c26.rpy:280
translate brazilian c26s001_MeeDate_868910ac:

    # mee "Pero lo que tú has construido no tiene nada que ver con eso. Se ha creado de una forma natural. Lo has hecho muy bien."
    mee "Mas o que você construiu não tem nada a ver com isso. Foi criado naturalmente. Você fez um ótimo trabalho."

# game/scripts/c26/c26.rpy:281
translate brazilian c26s001_MeeDate_c6217544:

    # mc "Gracias, pero supongo que hay un 'pero'."
    mc "Obrigado, mas suponho que haja um \"mas\"."

# game/scripts/c26/c26.rpy:305
translate brazilian c26s001_MeeDate_d11b5e72:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hermana."
    mee "*Risos* É estranho dividir um homem com a minha irmã."

# game/scripts/c26/c26.rpy:308
translate brazilian c26s001_MeeDate_96313940:

    # mee "O con mis hijas..."
    mee "Ou com as minhas filhas..."

# game/scripts/c26/c26.rpy:310
translate brazilian c26s001_MeeDate_2a85f530:

    # mee "O con una de mis hijas..."
    mee "Ou com uma das minhas filhas..."

# game/scripts/c26/c26.rpy:313
translate brazilian c26s001_MeeDate_b9945fa1:

    # mee "O con mi hija..."
    mee "Ou com a minha filha..."

# game/scripts/c26/c26.rpy:315
translate brazilian c26s001_MeeDate_2dd9104d:

    # mee "O con mis nietas..."
    mee "Ou com minhas netas..."

# game/scripts/c26/c26.rpy:317
translate brazilian c26s001_MeeDate_bfa3b927:

    # mee "O con una de mis nietas..."
    mee "Ou com uma das minhas netas..."

# game/scripts/c26/c26.rpy:322
translate brazilian c26s001_MeeDate_48cebf41:

    # mee "*Risa* Se me hace extraño compartir hombre con mis hijas."
    mee "*Risos* É estranho ter que dividir um homem com minhas filhas."

# game/scripts/c26/c26.rpy:324
translate brazilian c26s001_MeeDate_de2865f9:

    # mee "*Risa* Se me hace extraño compartir hombre con una de mis hijas."
    mee "*Risos* É estranho ter que dividir um homem com uma das minhas filhas."

# game/scripts/c26/c26.rpy:326
translate brazilian c26s001_MeeDate_2dd9104d_1:

    # mee "O con mis nietas..."
    mee "Ou com minhas netas..."

# game/scripts/c26/c26.rpy:328
translate brazilian c26s001_MeeDate_bfa3b927_1:

    # mee "O con una de mis nietas..."
    mee "Ou com uma das minhas netas..."

# game/scripts/c26/c26.rpy:331
translate brazilian c26s001_MeeDate_a96ad341:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hija."
    mee "*Risos* É estranho ter que dividir um homem com a minha filha."

# game/scripts/c26/c26.rpy:333
translate brazilian c26s001_MeeDate_2dd9104d_2:

    # mee "O con mis nietas..."
    mee "Ou com minhas netas..."

# game/scripts/c26/c26.rpy:335
translate brazilian c26s001_MeeDate_bfa3b927_2:

    # mee "O con una de mis nietas..."
    mee "Ou com uma das minhas netas..."

# game/scripts/c26/c26.rpy:339
translate brazilian c26s001_MeeDate_d5aa94ac:

    # mee "*Risa* Se me hace extraño compartir hombre con mis nietas."
    mee "*Risos* É estranho ter que dividir um homem com minhas netas."

# game/scripts/c26/c26.rpy:341
