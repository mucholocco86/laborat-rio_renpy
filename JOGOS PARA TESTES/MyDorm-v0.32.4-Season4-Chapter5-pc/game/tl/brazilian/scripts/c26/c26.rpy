    "Você consegue sentir o calor emanando da virilha dela acima do Mjolnir e como seus mamilos úmidos roçam em seu peito."

# game/scripts/c26/c26.rpy:515
translate brazilian c26s001_MeeSex_eddf9c22:

    # "Puedes notar el calor que emana de su entrepierna encima de Mjolnir."
    "É possível sentir o calor emanando de sua virilha acima do Mjolnir."

# game/scripts/c26/c26.rpy:517
translate brazilian c26s001_MeeSex_82e2c83b:

    # "Los besos continúan, en una lucha por saber quién besa más apasionadamente."
    "Os beijos continuam, numa disputa para ver quem beija com mais paixão."

# game/scripts/c26/c26.rpy:518
translate brazilian c26s001_MeeSex_d2960e92:

