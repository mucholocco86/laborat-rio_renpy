# game/scripts/c26/c26.rpy:360
translate brazilian c26s001_MeeDate_e01c9273:

    # mee "Es una buena forma de decirle a alguna de las chicas lo que debería pulir sin que nadie se sienta ofendido."
    mee "É uma boa maneira de dizer a uma das meninas o que ela deve polir sem que ninguém se sinta ofendido."

# game/scripts/c26/c26.rpy:361
translate brazilian c26s001_MeeDate_b2cf3746:

    # mc "A veces me alegro de no estar en ese grupo. Lo pasaría mal con las 22 mujeres y Jamaal criticándome, aunque fuera medio en broma."
    mc "Às vezes, fico feliz por não estar nesse grupo. Eu teria muita dificuldade em lidar com todas as 22 mulheres e o Jamaal me criticando, mesmo que fosse meio que brincando."

# game/scripts/c26/c26.rpy:363
translate brazilian c26s001_MeeDate_fcfd0d77:

    # mee "No lo harías. Siempre que alguien ha comentado algo que deberías cambiar, alguna de 'Las Bestias' han salido en tu defensa."
    mee "Você não faria isso. Sempre que alguém sugeriu que você mudasse algo, um dos \"Monstros\" veio em sua defesa."

# game/scripts/c26/c26.rpy:365
translate brazilian c26s001_MeeDate_3c295872:

    # mee "Alguna te defendía incluso antes de salir contigo."
