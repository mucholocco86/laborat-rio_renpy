# game/scripts/c26/c26.rpy:400
translate brazilian c26s001_MeeDate_c9e9ed84:

    # "A medio camino a casa el cielo parece abrirse y deja caer todo su contenido sobre vosotros en forma de una intensa lluvia."
    "Na metade do caminho para casa, o céu parece se abrir e despejar seu conteúdo sobre você na forma de uma chuva intensa."

# game/scripts/c26/c26.rpy:401
