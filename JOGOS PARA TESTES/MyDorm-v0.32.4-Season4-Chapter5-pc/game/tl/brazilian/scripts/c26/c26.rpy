# game/scripts/c26/c26.rpy:366
translate brazilian c26s001_MeeDate_3fa83091:

    # mc "*Risa* ¿Las Bestias? ¿Quiénes son? ¿Qué decís que debería cambiar?"
    mc "*Risos* As Feras? Quem são elas? O que você acha que eu deveria mudar?"

# game/scripts/c26/c26.rpy:368
translate brazilian c26s001_MeeDate_f2c8ef91:

    # mee "No creo que te convenga saberlo. Además, son cosas entre nosotras. Nada serio. Si hay algún problema serio, lo hablamos en persona."
    mee "Não acho que seja do seu interesse saber. Além disso, é algo só entre nós. Nada sério. Se houver algum problema sério, conversaremos pessoalmente."

# game/scripts/c26/c26.rpy:369
translate brazilian c26s001_MeeDate_8365d317:

