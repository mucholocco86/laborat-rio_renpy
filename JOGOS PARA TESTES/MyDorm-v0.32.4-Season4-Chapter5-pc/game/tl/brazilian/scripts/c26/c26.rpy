    "Nenhum de vocês se importa. Vocês nem sabem que estão brigando por isso."

# game/scripts/c26/c26.rpy:520
translate brazilian c26s001_MeeSex_28dacd32:

    # "Cambiáis de posición diversas veces, dejándote guiar por la diminuta mujer."
    "Você muda de posição várias vezes, deixando-se guiar pela mulherzinha."

# game/scripts/c26/c26.rpy:521
