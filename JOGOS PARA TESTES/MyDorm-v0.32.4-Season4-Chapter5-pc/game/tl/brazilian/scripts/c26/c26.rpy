# game/scripts/c26/c26.rpy:494
translate brazilian c26s001_MeeSex_b72494bc:

    # mc "No te preocupes, me he secado bien. Y una lluvia de verano no va a hacerme coger frío. Tu pelo mojado, sin embargo..."
    mc "Não se preocupe, eu já me sequei. E uma chuva de verão não vai me fazer sentir frio. Mas seu cabelo molhado..."

# game/scripts/c26/c26.rpy:499
translate brazilian c26s001_MeeSex_f7c43031:

    # mee "No voy a esperar a que se seque, ni a pasarme media hora en el baño con el secador."
    mee "Não vou esperar secar, nem ficar meia hora no banheiro com o secador de cabelo."

# game/scripts/c26/c26.rpy:500
