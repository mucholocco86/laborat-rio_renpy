    mc "Vejo que o meu já está preparado."

# game/scripts/c26/c26.rpy:505
translate brazilian c26s001_MeeSex_8eecaa3c:

    # mee "Llevo un rato pensando en lo que vamos a hacer y... ya sabes lo que me pasa..."
    mee "Já faz um tempo que venho pensando no que vamos fazer e... você sabe como eu sou..."

# game/scripts/c26/c26.rpy:510
translate brazilian c26s001_MeeSex_e12d4839:

