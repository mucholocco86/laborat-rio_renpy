    mee "Se eu disser que sim, você começará a justificar por que faz as coisas dessa maneira."

# game/scripts/c26/c26.rpy:374
translate brazilian c26s001_MeeDate_dbc8eb83:

    # mee "Si tienes que cambiar algo, ya lo descubrirás por ti mismo."
    mee "Se precisar mudar alguma coisa, você mesmo descobrirá como."

# game/scripts/c26/c26.rpy:376
translate brazilian c26s001_MeeDate_88c27f0d:

