# game/scripts/c22/c22.rpy:3126
translate brazilian c22s005_SamCall_59db7e02:

    # "Parece empeñada en hacerte engordar otra vez, pero no puedes declinar la invitación."
    "Ela parece determinada a fazer você engordar novamente, mas você não pode recusar o convite."

# game/scripts/c22/c22.rpy:3128
translate brazilian c22s005_SamCall_d9e47835:

    # "La prueba de embarazo hace un día que ha dado el resultado."
    "O teste de gravidez deu resultado há um dia."

# game/scripts/c22/c22.rpy:3129
translate brazilian c22s005_SamCall_9f560e10:

    # "Quedáis para una hora después."
