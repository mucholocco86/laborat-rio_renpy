    # ama "¡Ah, no! Ya las he recogido yo. Me había olvidado..."
    ama "Ah, não! Eu já os peguei. Tinha me esquecido..."

# game/scripts/c22/c22.rpy:2256
translate brazilian c22s004_EveNoRoute_cd149d43:

    # eva "Has dicho prima y no novia."
    eva "Você disse prima, não namorada."

# game/scripts/c22/c22.rpy:2260
translate brazilian c22s004_EveNoRoute_66b2c48a:

    # eva "Supongo que no te refieres a lo que haces con [dap.nick] y [eri.nick]..."
    eva "Suponho que você não esteja se referindo ao que você faz com [dap.nick] e [eri.nick]..."

# game/scripts/c22/c22.rpy:2262
translate brazilian c22s004_EveNoRoute_380047ea:

    # eva "Supongo que no te refieres a lo que haces con [dap.nick]..."
    eva "Suponho que você não esteja se referindo ao que você faz com [dap.nick]..."

# game/scripts/c22/c22.rpy:2265
translate brazilian c22s004_EveNoRoute_76894bd1:

    # eva "Supongo que no te refieres a lo que haces con [eri.nick]..."
    eva "Suponho que você não esteja se referindo ao que você faz com [eri.nick]..."

# game/scripts/c22/c22.rpy:2266
translate brazilian c22s004_EveNoRoute_2e706747:

    # mc "[eva], te quiero, pero no de esa forma."
    mc "[eva], Eu te amo, mas não desse jeito."

# game/scripts/c22/c22.rpy:2267
translate brazilian c22s004_EveNoRoute_8d85247c:

    # mc "Quizás no sea el mejor momento para decirte algo así, pero tengo que ser sincero contigo y evitar que te hagas falsas esperanzas."
    mc "Talvez este não seja o melhor momento para lhe dizer algo assim, mas preciso ser honesto e evitar que você crie falsas expectativas."

# game/scripts/c22/c22.rpy:2269
translate brazilian c22s004_EveNoRoute_97986df1:

    # "Salta como impulsada por un resorte."
    "Ele salta como se fosse impulsionado por uma mola."

# game/scripts/c22/c22.rpy:2270
translate brazilian c22s004_EveNoRoute_aeb4230e:

    # eva "Pues llegas un poco tarde para eso... ¿Quieres que cambie algo de mí?"
    eva "Bom, você está um pouco atrasado para isso... Quer que eu mude algo em mim?"

# game/scripts/c22/c22.rpy:2272
translate brazilian c22s004_EveNoRoute_bff80ff8:

    # eva "Creía que... tengo la cara de [dap.nick]... ¿Quieres que me haga una trenza?"
    eva "Pensei... Tenho cara de [dap.nick]... Quer que eu faça uma trança no meu cabelo?"

# game/scripts/c22/c22.rpy:2274
translate brazilian c22s004_EveNoRoute_0cf10a52:

    # eva "Creía que... tengo la cara de [eri.nick]... ¿Quieres que me haga gótica?"
    eva "Pensei... Eu tenho cara de [eri.nick]... Quer que eu vire gótica?"

# game/scripts/c22/c22.rpy:2275
translate brazilian c22s004_EveNoRoute_769a0512:

    # mc "No, [eva]. Eres perfecta tal como eres, pero no siento por ti lo que quieres que sienta."
    mc "Não, [eva]. Você é perfeita do jeito que é, mas eu não sinto por você o que você quer que eu sinta."

# game/scripts/c22/c22.rpy:2277
translate brazilian c22s004_EveNoRoute_2bdb8f13:

    # eva "¿Entonces por qué no?"
    eva "Então, por que não?"

# game/scripts/c22/c22.rpy:2278
translate brazilian c22s004_EveNoRoute_fb78d9cd:

    # mc "Porque no le puedo decir al corazón de quién tiene que enamorarse."
    mc "Porque não posso dizer ao coração por quem ele deve se apaixonar."

# game/scripts/c22/c22.rpy:2279
translate brazilian c22s004_EveNoRoute_66f88345:

    # mc "Lo último que quiero es hacerte daño. Eres una mujer maravillosa, pero no siento nada romántico por ti."
    mc "A última coisa que eu quero é te magoar. Você é uma mulher maravilhosa, mas eu não sinto nada romântico por você."

# game/scripts/c22/c22.rpy:2280
translate brazilian c22s004_EveNoRoute_9a87d34e:

    # mc "Lo siento."
    mc "Desculpe."

# game/scripts/c22/c22.rpy:2282
translate brazilian c22s004_EveNoRoute_d0a757c2:

    # eva "Me siento como una idiota ahora mismo."
    eva "Eu me sinto um idiota agora."

# game/scripts/c22/c22.rpy:2283
translate brazilian c22s004_EveNoRoute_a2081f6a:

    # mc "No tienes que sentirte así. Nadie elige de quién se enamora."
    mc "Você não precisa se sentir assim. Ninguém escolhe por quem se apaixona."

# game/scripts/c22/c22.rpy:2284
translate brazilian c22s004_EveNoRoute_187e8fe2:

    # eva "No me refiero a eso..."
    eva "Não me refiro a isso..."

# game/scripts/c22/c22.rpy:2285
translate brazilian c22s004_EveNoRoute_39834124:

    # mc "¿Entonces a qué te refieres?"
    mc "Então, o que você quer dizer?"

# game/scripts/c22/c22.rpy:2287
translate brazilian c22s004_EveNoRoute_0b7bf467:

    # eva "A que te estoy pidiendo explicaciones sobre algo que no tengo ningún derecho a hacer."
    eva "Por que estou pedindo explicações sobre algo que não tenho o direito de fazer?"

# game/scripts/c22/c22.rpy:2288
translate brazilian c22s004_EveNoRoute_e7791b8c:

    # mc "Eso casi suena como [ama]. Pero siempre me podrás pedir explicaciones sobre lo que quieras."
    mc "Isso quase soa como [ama]. Mas você sempre pode me pedir explicações sobre qualquer coisa que quiser."

# game/scripts/c22/c22.rpy:2291
translate brazilian c22s004_EveNoRoute_5d9b0e4a:

    # eva "Incluso te he propuesto cambiar físicamente. Es algo que no debería hacer."
    eva "Eu até sugeri que você mudasse sua aparência. É algo que você não deveria fazer."

# game/scripts/c22/c22.rpy:2292
translate brazilian c22s004_EveNoRoute_894ebe24:

    # eva "Yo soy yo y no tengo que parecerme a nadie."
    eva "Eu sou eu mesma e não preciso me parecer com ninguém."

# game/scripts/c22/c22.rpy:2293
translate brazilian c22s004_EveNoRoute_9843b2bc:

    # mc "Voy a repetirlo, [eva]. Eres perfecta como eres, pero yo no soy perfecto para ti."
    mc "Vou repetir, [eva]. Você é perfeita do jeito que é, mas eu não sou perfeito para você."

# game/scripts/c22/c22.rpy:2295
translate brazilian c22s004_EveNoRoute_6fa08cef:

    # eva "Y además, me he comportado muy mal con [ama] desde ayer."
    eva "E além disso, tenho me comportado muito mal com [ama] desde ontem."

# game/scripts/c22/c22.rpy:2296
translate brazilian c22s004_EveNoRoute_f9ef55d9:

    # eva "Ella también conocía a Gavin, aunque no había tenido tanto trato con él como yo. También lo debe estar pasando mal."
    eva "Ela também conhecia Gavin, embora não tivesse tido tanto contato com ele quanto eu. Ela também deve estar passando por um momento difícil."

# game/scripts/c22/c22.rpy:2297
translate brazilian c22s004_EveNoRoute_65c96ef7:

    # mc "Deberías hablar con ella y disculparte, si crees que lo has hecho mal."
    mc "Você deve conversar com ela e pedir desculpas se achar que fez algo errado."

# game/scripts/c22/c22.rpy:2299
translate brazilian c22s004_EveNoRoute_5e059f15:

    # eva "¿Puedes esperar aquí mientras hablo con ella?"
    eva "Você pode esperar aqui enquanto eu falo com ela?"

# game/scripts/c22/c22.rpy:2300
translate brazilian c22s004_EveNoRoute_e6b42cb7:

    # eva "Me gustaría hablar en privado, si no te molesta."
    eva "Gostaria de conversar em particular, se não se importar."

# game/scripts/c22/c22.rpy:2301
translate brazilian c22s004_EveNoRoute_97dbc3a2:

    # mc "Ningún problema. Es vuestra conversación y tus disculpas."
    mc "Sem problemas. É a sua conversa e o seu pedido de desculpas."

# game/scripts/c22/c22.rpy:2302
translate brazilian c22s004_EveNoRoute_e8cb8c5f:

    # eva "Te veo en cinco minutos."
    eva "Te vejo em cinco minutos."

# game/scripts/c22/c22.rpy:2304
translate brazilian c22s004_EveNoRoute_4c8540f5:

    # "Nunca te fíes de una mujer hermosa cuando diga cinco minutos."
    "Nunca confie em uma mulher bonita quando ela diz cinco minutos."

# game/scripts/c22/c22.rpy:2306
translate brazilian c22s004_EveNoRoute_c0f374b2:

    # "Tras quince minutos de mirar el móvil, aparece [eva] de nuevo."
    "Após quinze minutos olhando para o celular, [eva] aparece novamente."

# game/scripts/c22/c22.rpy:2307
translate brazilian c22s004_EveNoRoute_df2abffe:

    # eva "Ya está. Ya me he disculpado."
    eva "Pronto. Eu já me desculpei."

# game/scripts/c22/c22.rpy:2308
translate brazilian c22s004_EveNoRoute_1e0bcec0:

    # mc "¿Estás mejor?"
    mc "Você está se sentindo melhor?"

# game/scripts/c22/c22.rpy:2310
translate brazilian c22s004_EveNoRoute_e55d0ee7:

    # eva "Mucho mejor. Sienta bien quitarse ese peso de encima."
    eva "Muito melhor. É ótimo tirar esse peso dos ombros."

# game/scripts/c22/c22.rpy:2313
translate brazilian c22s004_EveNoRoute_a7267a48:

    # eva "Por cierto, felicidades. No vas a encontrar a nadie mejor que mi hermana."
    eva "Aliás, parabéns. Você não encontrará ninguém melhor que minha irmã."

# game/scripts/c22/c22.rpy:2315
translate brazilian c22s004_EveNoRoute_572bbbe6:

    # eva "Bueno, sí, pero no quieres salir conmigo. *Risa*"
    eva "Sim, mas você não quer sair comigo. *Risos*"

# game/scripts/c22/c22.rpy:2316
translate brazilian c22s004_EveNoRoute_1922a406:

    # mc "No sabía que te lo iba a decir ahora."
    mc "Eu não sabia que ia te contar isso agora."

# game/scripts/c22/c22.rpy:2318
translate brazilian c22s004_EveNoRoute_7c4f0b77:

    # eva "Cuando llegó ayer yo estaba molida. Quería contármelo cuando me despertara, antes de ir a cenar a casa."
    eva "Quando ele chegou ontem, eu estava exausta. Ele queria me contar quando eu acordasse, antes de irmos para casa jantar."

# game/scripts/c22/c22.rpy:2319
translate brazilian c22s004_EveNoRoute_fdd9098f:

    # eva "Pero me despertó la llamada de Aaron para decirnos lo de Gavin."
    eva "Mas fui acordado pelo telefonema de Aaron para nos contar sobre Gavin."

# game/scripts/c22/c22.rpy:2320
translate brazilian c22s004_EveNoRoute_269fe6c5:

    # eva "Supongo que me puse demasiado borde y no quería contármelo entonces."
    eva "Acho que fui muito grosseira e ele não quis me dizer naquele momento."

# game/scripts/c22/c22.rpy:2321
translate brazilian c22s004_EveNoRoute_d21196a6:

    # mc "Sabes que a mí no me gustan los secretos."
    mc "Você sabe que eu não gosto de segredos."

# game/scripts/c22/c22.rpy:2323
translate brazilian c22s004_EveNoRoute_01e892ae:

    # eva "Lo sé. Y en este caso era justificado. No sé cómo hubiera recibido la noticia antes de que llegaras."
    eva "Eu sei. E, neste caso, foi justificado. Não sei como teria recebido a notícia antes da sua chegada."

# game/scripts/c22/c22.rpy:2324
translate brazilian c22s004_EveNoRoute_c949557a:

    # eva "Tus abrazos tienen algo de curativo. ¿Te lo han dicho alguna vez?"
    eva "Seus abraços têm um poder curativo. Alguém já te disse isso?"

# game/scripts/c22/c22.rpy:2325
translate brazilian c22s004_EveNoRoute_c0c7f532:

    # mc "*Risa* Sí, alguna vez me lo han dicho."
    mc "*Risos* Sim, já me disseram isso antes."

# game/scripts/c22/c22.rpy:2327
translate brazilian c22s004_EveNoRoute_f28a609b:

    # eva "Ahora vas a tener que irte. Quiero ducharme. Apesto."
    eva "Agora você vai ter que ir embora. Quero tomar um banho. Estou fedendo."

# game/scripts/c22/c22.rpy:2328
translate brazilian c22s004_EveNoRoute_9ecb9510:

    # eva "[ama] quería hablar contigo sobre algo del viaje a Aruba."
    eva "[ama] Eu queria falar com você sobre algo da viagem a Aruba."

# game/scripts/c22/c22.rpy:2329
translate brazilian c22s004_EveNoRoute_344bf5f0:

    # mc "¿Te veo luego?"
    mc "Até mais?"

# game/scripts/c22/c22.rpy:2330
translate brazilian c22s004_EveNoRoute_362ece90:

    # eva "¡Por supuesto!"
    eva "Claro!"

# game/scripts/c22/c22.rpy:2333
translate brazilian c22s004_EveNoRoute_5fa41bfe:

    # "Nada más entrar en la sala de control, suena tu teléfono"
    "Assim que você entra na sala de controle, seu telefone toca."

# game/scripts/c22/c22.rpy:2341
translate brazilian c22s003_IronFistCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c22/c22.rpy:2343
translate brazilian c22s003_IronFistCalls_9ba0a8c0:

    # mcp "(Número desconocido...)"
    mcp "(Número desconhecido...)"

# game/scripts/c22/c22.rpy:2346
translate brazilian c22s003_IronFistCalls_6c5f241b:

    # mc "Hola, [mc] Marks al habla."
    mc "Olá, [mc] Marks falando."

# game/scripts/c22/c22.rpy:2347
translate brazilian c22s003_IronFistCalls_5d7bf905:

    # mcp "(Acabo de sonar super ridículo.)"
    mcp "(Eu acabei de soar extremamente ridícula.)"

# game/scripts/c22/c22.rpy:2348
translate brazilian c22s003_IronFistCalls_391a3adf:

    # man "Buenos días, Sr. Marks. Le llamo de Iron Fist, soy Jeff Sound, el asistente del Sr. Ichigo, Vicepresidente de Operaciones."
    man "Bom dia, Sr. Marks. Estou ligando da Iron Fist, aqui é Jeff Sound, assistente do Sr. Ichigo e vice-presidente de operações."

# game/scripts/c22/c22.rpy:2349
translate brazilian c22s003_IronFistCalls_a40dc997:

    # mc "Un momento, Sr. Sound. Le pongo en manos libres, tengo una persona de mi equipo aquí que va a estar interesada en esta conversación."
    mc "Só um momento, Sr. Sound. Vou colocar no viva-voz; tenho alguém da minha equipe aqui que estará interessado nesta conversa."

# game/scripts/c22/c22.rpy:2351
translate brazilian c22s003_IronFistCalls_dd32dc13:

    # jef "Ningún problema, Sr. Marks."
    jef "Sem problema, Sr. Marks."

# game/scripts/c22/c22.rpy:2353
translate brazilian c22s003_IronFistCalls_ea0ae3a0:

    # ama "Buenos días, Sr. Sound. Soy [ama] Gilford. Le escucho bien."
    ama "Bom dia, Sr. Sound. Aqui é Gilford. Consigo ouvi-lo perfeitamente."

# game/scripts/c22/c22.rpy:2354
translate brazilian c22s003_IronFistCalls_6b91c75d:

    # jef "Encantado de hablar con usted, Srta. Gilford. ¿O es Sra.?"
    jef "É um prazer falar com você, Srta. Gilford. Ou seria Sra.?"

# game/scripts/c22/c22.rpy:2356
translate brazilian c22s003_IronFistCalls_1b076072:

    # ama "Srta. está bien."
    ama "Senhorita, a senhora está bem?"

# game/scripts/c22/c22.rpy:2357
translate brazilian c22s003_IronFistCalls_015cdb0f:

    # mc "Dígame, Sr. Sound."
    mc "Diga-me, Sr. Som."

# game/scripts/c22/c22.rpy:2358
translate brazilian c22s003_IronFistCalls_6804df4e:

    # jef "Les llamo porque han llegado a nosotros informaciones sobre el cambio de propiedad de NTR y..."
    jef "Estou ligando porque recebemos informações sobre uma mudança na propriedade da NTR e..."

# game/scripts/c22/c22.rpy:2359
translate brazilian c22s003_IronFistCalls_5d519b79:

    # mc "¿Me puede decir de dónde han sacado esa información? ¿Y este número de teléfono?"
    mc "Você pode me dizer onde conseguiu essa informação? E esse número de telefone?"

# game/scripts/c22/c22.rpy:2360
translate brazilian c22s003_IronFistCalls_306afe27:

    # jef "Esa es una información reservada, Sr. Marks. No podemos revelar nuestras fuentes."
    jef "Essa é informação confidencial, Sr. Marks. Não podemos revelar nossas fontes."

# game/scripts/c22/c22.rpy:2362
translate brazilian c22s003_IronFistCalls_886708b9:

    # ama "Estaba hablando usted del cambio de propiedad de NTR. Siga, por favor."
    ama "Você estava falando sobre a mudança de proprietários da NTR. Por favor, continue."

# game/scripts/c22/c22.rpy:2363
translate brazilian c22s003_IronFistCalls_2caf15f7:

    # jef "Sí. Nos hemos enterado del cambio de propiedad y de que ésta ha recaído en un grupo representado por el Sr. Marks."
    jef "Sim. Tomamos conhecimento da mudança de proprietários e de que a empresa passou a ser controlada por um grupo representado pelo Sr. Marks."

# game/scripts/c22/c22.rpy:2364
translate brazilian c22s003_IronFistCalls_3fa127ba:

    # ama "Exacto."
    ama "Exato."

# game/scripts/c22/c22.rpy:2365
translate brazilian c22s003_IronFistCalls_6c01e46a:

    # jef "También nos han llegado noticias de que el Sr. Marks va a ocupar el puesto de CEO en breve."
    jef "Também recebemos a notícia de que o Sr. Marks assumirá o cargo de CEO em breve."

# game/scripts/c22/c22.rpy:2366
translate brazilian c22s003_IronFistCalls_528a8536:

    # ama "Sí. Esas informaciones son exactas."
    ama "Sim. Essa informação está correta."

# game/scripts/c22/c22.rpy:2367
translate brazilian c22s003_IronFistCalls_db3ac24a:

    # jef "¿Me podrían decir quién es ese grupo de accionistas, por favor?"
    jef "Poderia me dizer quem é esse grupo de acionistas?"

# game/scripts/c22/c22.rpy:2369
translate brazilian c22s003_IronFistCalls_2e120bea:

    # mc "Son..."
    mc "São..."

# game/scripts/c22/c22.rpy:2370
translate brazilian c22s003_IronFistCalls_19797f13:

    # ama "No creo que sea de su interés, Sr. Sound. Están representados por el Sr. Marks y él es capaz de hablar por ellos."
    ama "Não creio que seja do seu interesse, Sr. Sound. O senhor é representado pelo Sr. Marks, e ele pode falar em seu nome."

# game/scripts/c22/c22.rpy:2371
translate brazilian c22s003_IronFistCalls_a6c58ba9:

    # ama "¿Quería algo más?"
    ama "Você queria outra coisa?"

# game/scripts/c22/c22.rpy:2372
translate brazilian c22s003_IronFistCalls_ae258745:

    # jef "También llamaba porque al Sr. Ichigo le gustaría reunirse con el Sr. Marks."
    jef "Ele também estava ligando porque o Sr. Ichigo gostaria de se encontrar com o Sr. Marks."

# game/scripts/c22/c22.rpy:2373
translate brazilian c22s003_IronFistCalls_f68c9824:

    # mc "¿Por alguna razón en concreto?"
    mc "Por algum motivo específico?"

# game/scripts/c22/c22.rpy:2374
translate brazilian c22s003_IronFistCalls_b8e36178:

    # jef "Una primera toma de contacto entre dos de las principales empresas del sector. El Sr. Ichigo se había reunido varias veces con el Sr. Daniels."
    jef "Este foi um encontro inicial entre duas das principais empresas do setor. O Sr. Ichigo já havia se reunido com o Sr. Daniels diversas vezes."

# game/scripts/c22/c22.rpy:2376
translate brazilian c22s003_IronFistCalls_6f9ec9b5:

    # ama "*Pone el móvil en mute* Xabier Daniels era el jefe de GILF que empezó la Guerra Clon."
    ama "*Coloca o telefone no silencioso* Xabier Daniels era o chefe da GILF que iniciou a Guerra dos Clones."

# game/scripts/c22/c22.rpy:2377
translate brazilian c22s003_IronFistCalls_c95b64af:

    # "Asientes."
    "Você acena com a cabeça."

# game/scripts/c22/c22.rpy:2378
translate brazilian c22s003_IronFistCalls_372a491b:

    # mc "Desafortunadamente, el Sr. Daniels ya no trabaja con nosotros, pero si se trata de una visita de cortesía, no tengo ningún problema en conocer al Sr. Ichigo."
    mc "Infelizmente, o Sr. Daniels não trabalha mais conosco, mas se for uma visita de cortesia, não terei problema algum em conhecer o Sr. Ichigo."

# game/scripts/c22/c22.rpy:2379
translate brazilian c22s003_IronFistCalls_72b19fea:

    # jef "Muchas gracias, Sr. Marks. El Sr. Ichigo estará en Vandenberg mañana por la tarde, y dará una recepción para algunos clientes en su yate por la noche."
    jef "Muito obrigado, Sr. Marks. O Sr. Ichigo estará em Vandenberg amanhã à tarde e oferecerá uma recepção para alguns clientes em seu iate naquela noite."

# game/scripts/c22/c22.rpy:2380
translate brazilian c22s003_IronFistCalls_5d55801b:

    # jef "Le gustaría que acudiera."
    jef "Ele gostaria que ela viesse."

# game/scripts/c22/c22.rpy:2382
translate brazilian c22s003_IronFistCalls_7f58a0aa:

    # ama "Imposible. El Sr. Marks tiene la agenda ocupada hasta el viernes. Debería ser a partir del sábado."
    ama "Impossível. A agenda do Sr. Marks está lotada até sexta-feira. Teria que ser a partir de sábado."

# game/scripts/c22/c22.rpy:2383
translate brazilian c22s003_IronFistCalls_f359de1c:

    # jef "Déjeme mirar un tema. Un momento..."
    jef "Deixe-me verificar uma coisa. Só um instante..."

# game/scripts/c22/c22.rpy:2384
translate brazilian c22s003_IronFistCalls_e8924f49:

    # jef "El sábado es un buen día. Hay un evento más pequeño en el yate frente al puerto de Westport. Tendrán más oportunidades de conocerse."
    jef "Sábado é um bom dia. Haverá um evento menor no iate em frente ao porto de Westport. Eles terão mais oportunidades de se conhecerem."

# game/scripts/c22/c22.rpy:2386
translate brazilian c22s003_IronFistCalls_68fcb964:

    # ama "El sábado entonces. ¿Transporte?"
    ama "Sábado, então. Transporte?"

# game/scripts/c22/c22.rpy:2387
translate brazilian c22s003_IronFistCalls_1337076f:

    # jef "Podemos enviar un helicóptero a recoger al Sr. Marks."
    jef "Podemos enviar um helicóptero para buscar o Sr. Marks."

# game/scripts/c22/c22.rpy:2388
translate brazilian c22s003_IronFistCalls_f3ffb496:

    # ama "Y a mí. Iremos juntos."
    ama "E eu. Iremos juntos."

# game/scripts/c22/c22.rpy:2389
translate brazilian c22s003_IronFistCalls_2135db09:

    # jef "Perfecto. Nos tendrán que indicar dónde quieren que les recojamos."
    jef "Perfeito. Você precisa nos dizer onde quer que a gente te busque."

# game/scripts/c22/c22.rpy:2391
translate brazilian c22s003_IronFistCalls_647b9adc:

    # "[ama] continúa atando detalles de la reunión, dando indicaciones y detalles, pero sin revelar ninguna información."
    "[ama] continua a reunir detalhes da reunião, dando instruções e detalhes, mas sem revelar nenhuma informação."

# game/scripts/c22/c22.rpy:2392
translate brazilian c22s003_IronFistCalls_ed693545:

    # "Consigue algunos nombres de las personas que asistirán al evento menor, y el Sr. Sound se compromete a enviarle la lista completa de invitados."
    "Anote os nomes das pessoas que irão comparecer ao evento menor, e o Sr. Sound promete enviar a lista completa de convidados."

# game/scripts/c22/c22.rpy:2393
translate brazilian c22s003_IronFistCalls_a48b253f:

    # "Aunque vaya vestida de mecánico, es mucho mejor en esto de lo que tú serías con un traje."
    "Mesmo vestida de mecânica, ela é muito melhor nisso do que você seria de terno."

# game/scripts/c22/c22.rpy:2394
translate brazilian c22s003_IronFistCalls_fcea9a6f:

    # "Unos minutos después os despedís del Sr. Sound."
    "Poucos minutos depois, você se despede do Sr. Som."

# game/scripts/c22/c22.rpy:2396
translate brazilian c22s003_IronFistCalls_d96573d6:

    # ama "Ya está. El sábado nos reunimos con Ichigo."
    ama "É isso aí. Vamos nos encontrar com Ichigo no sábado."

# game/scripts/c22/c22.rpy:2397
translate brazilian c22s003_IronFistCalls_2d22882c:

    # mc "He estado a punto de meter la pata con lo de los accionistas, ¿verdad?"
    mc "Quase meti os pés pelas mãos com aquela história dos acionistas, não é?"

# game/scripts/c22/c22.rpy:2399
translate brazilian c22s003_IronFistCalls_180508eb:

    # ama "Sí, un poco. Nunca des información si no es necesario. Si no tienen los nombres de los accionistas tienen que pasar por ti para todo."
    ama "Sim, um pouco. Nunca forneça informações a menos que seja necessário. Se eles não tiverem os nomes dos acionistas, terão que recorrer a você para tudo."

# game/scripts/c22/c22.rpy:2400
translate brazilian c22s003_IronFistCalls_3c34a0cb:

    # ama "Es nuestra forma de controlar el flujo de información. Cuánto más anónimas sean las chicas, mejor. No podrán contactarlas directamente."
    ama "Essa é a nossa forma de controlar o fluxo de informações. Quanto mais anônimas as garotas forem, melhor. Elas não poderão ser contatadas diretamente."

# game/scripts/c22/c22.rpy:2401
translate brazilian c22s003_IronFistCalls_2d2ddaaa:

    # mc "Me viene muy grande todo esto."
    mc "Isso tudo é demais para mim."

# game/scripts/c22/c22.rpy:2403
translate brazilian c22s003_IronFistCalls_6f275ac6:

    # ama "No te preocupes, aprenderás. Esto es nuevo para ti, pero al menos te das cuenta de cuándo estás a punto de cometer un error."
    ama "Não se preocupe, você vai aprender. Isso é novo para você, mas pelo menos você vai perceber quando estiver prestes a cometer um erro."

# game/scripts/c22/c22.rpy:2404
translate brazilian c22s003_IronFistCalls_070a9693:

    # ama "Lo que tienes que aprender es a darte cuenta antes de cometerlo."
    ama "O que você precisa aprender é a perceber isso antes de cometer o erro."

# game/scripts/c22/c22.rpy:2405
translate brazilian c22s003_IronFistCalls_d3ffc09e:

    # mc "Si no hubieras estado aquí... hubiera aceptado la reunión de mañana. ¿Por qué la has rechazado?"
    mc "Se você não estivesse aqui... eu teria aceitado a reunião de amanhã. Por que você recusou?"

# game/scripts/c22/c22.rpy:2407
translate brazilian c22s003_IronFistCalls_f0a1b841:

    # ama "*Risa* Porque la han propuesto ellos. Si nos negamos a su primera propuesta, se pueden poner ansiosos."
    ama "*Risos* Porque foram eles que propuseram. Se recusarmos a primeira proposta, eles podem ficar ansiosos."

# game/scripts/c22/c22.rpy:2408
translate brazilian c22s003_IronFistCalls_bcad0b66:

    # ama "Si aceptamos una propuesta así con tan poca antelación, parece que estemos besándoles el culo."
    ama "Se aceitarmos uma proposta dessas com tão pouco aviso prévio, parecerá que estamos bajulando-os."

# game/scripts/c22/c22.rpy:2410
translate brazilian c22s003_IronFistCalls_1f6dad46:

    # ama "De esta forma demostramos que son ellos los que tienen interés y no nosotros."
    ama "Dessa forma, demonstramos que são eles que têm interesse, e não nós."

# game/scripts/c22/c22.rpy:2411
translate brazilian c22s003_IronFistCalls_111d4888:

    # ama "Si no hubieran tenido el evento del sábado, posiblemente se hubieran tenido que inventar algo para forzar esa reunión informal."
    ama "Se não tivesse havido o evento de sábado, eles poderiam ter tido que inventar algo para forçar aquele encontro informal."

# game/scripts/c22/c22.rpy:2412
translate brazilian c22s003_IronFistCalls_2d9d8c2c:

    # mc "Que de informal tendrá poco, ¿no?"
    mc "Não pode ser muito informal, pode?"

# game/scripts/c22/c22.rpy:2414
translate brazilian c22s003_IronFistCalls_51ab4840:

    # ama "Poquísimo. Vandenberg es una base de la Fuerza Aérea, más dedicada al espacio que a algo con lo que Iron Fist tenga algo que ver."
    ama "Muito pouco. Vandenberg é uma base da Força Aérea, mais dedicada ao espaço do que a qualquer coisa relacionada ao Punho de Ferro."

# game/scripts/c22/c22.rpy:2415
translate brazilian c22s003_IronFistCalls_6e0ea7a5:

    # ama "Te querían demostrar que son fuertes y que tienen contactos en todos lados. No te conocen y te quieren impresionar."
    ama "Eles queriam mostrar que são poderosos e têm conexões em todos os lugares. Eles não te conhecem e querem te impressionar."

# game/scripts/c22/c22.rpy:2416
translate brazilian c22s003_IronFistCalls_dbeb0dd0:

    # ama "Seguro que al evento en Westport va algún coronel de Fort Hunter Liggett. Está a menos de dos horas."
    ama "Tenho certeza de que um coronel de Fort Hunter Liggett estará presente no evento em Westport. Fica a menos de duas horas daqui."

# game/scripts/c22/c22.rpy:2417
translate brazilian c22s003_IronFistCalls_e950b2e2:

    # mc "Hay demasiados matices en todo esto y yo no tengo ni idea... Creo que tú, [eva], o [aar] seríais mejores CEO que yo."
    mc "Há muitas nuances em tudo isso e eu não tenho ideia... Acho que você, [eva], ou [aar] seriam CEOs melhores do que eu."

# game/scripts/c22/c22.rpy:2419
translate brazilian c22s003_IronFistCalls_7b341c6d:

    # ama "Nosotros somos operativos de campo. No tenemos ni idea de cómo gestionar una empresa, pero conocemos el negocio."
    ama "Somos operadores de campo. Não temos ideia de como administrar uma empresa, mas conhecemos o negócio."

# game/scripts/c22/c22.rpy:2420
translate brazilian c22s003_IronFistCalls_d110c58d:

    # ama "Nuestro problema es de visión, al menos el mío. Tengo una visión limitada del conjunto."
    ama "Nosso problema é de visão, pelo menos o meu é. Tenho uma visão limitada do quadro geral."

# game/scripts/c22/c22.rpy:2421
translate brazilian c22s003_IronFistCalls_dd063c89:

    # ama "[aar] no es una figura cómoda en NTR para los que trabajaron bajo las órdenes de Xabier."
    ama "[aar] não é uma figura confortável em NTR para aqueles que trabalharam sob as ordens de Xabier."

# game/scripts/c22/c22.rpy:2422
translate brazilian c22s003_IronFistCalls_5bc7e3dd:

    # ama "Y [eva] tiene el problema del martillo."
    ama "E [eva] tem o problema do martelo."

# game/scripts/c22/c22.rpy:2423
translate brazilian c22s003_IronFistCalls_55a23645:

    # mc "¿Martillo?"
    mc "Martelo?"

# game/scripts/c22/c22.rpy:2425
translate brazilian c22s003_IronFistCalls_1b21ec91:

    # ama "Para [eva], sus armas son sus herramientas. Su martillo. Y cualquier problema es un clavo."
    ama "Para [eva], suas armas são suas ferramentas. Seu martelo. E qualquer problema é um prego."

# game/scripts/c22/c22.rpy:2426
translate brazilian c22s003_IronFistCalls_aebbd428:

    # ama "Intentaría resolver cualquier problema con la fuerza, y no es la dirección que queremos darle a la empresa, ¿no?"
    ama "Ele tentaria resolver qualquer problema pela força, e não é essa a direção que queremos dar à empresa, não é?"

# game/scripts/c22/c22.rpy:2427
translate brazilian c22s003_IronFistCalls_ab6417a5:

    # mc "No, en eso tienes razón. *Risa* No queremos que hundan el yate de Ichigo."
    mc "Não, você tem razão. *Risos* Não queremos que o iate do Ichigo afunde."

# game/scripts/c22/c22.rpy:2429
translate brazilian c22s003_IronFistCalls_a3396ac1:

    # ama "Bueno, tengo que arreglar unos temas para la reunión del sábado y buscar información sobre los asistentes. Te voy a tener que dejar."
    ama "Certo, preciso organizar algumas coisas para a reunião de sábado e encontrar algumas informações sobre os participantes. Preciso ir agora."

# game/scripts/c22/c22.rpy:2430
translate brazilian c22s003_IronFistCalls_a12fc195:

    # mc "¿Has pensado en pedirle ayuda a [jam]? Creo que os podría ser útil para buscar cosas."
    mc "Você já pensou em pedir ajuda ao [jam]? Acho que poderia ser útil para você encontrar as coisas."

# game/scripts/c22/c22.rpy:2431
translate brazilian c22s003_IronFistCalls_27c95d9c:

    # ama "No es mala idea. Le llamaré esta tarde, cuando volvamos de comer en casa de [nor]."
    ama "Não é uma má ideia. Vou ligar para ele esta tarde, quando voltarmos do almoço no [nor]'s."

# game/scripts/c22/c22.rpy:2433
translate brazilian c22s003_IronFistCalls_e0575fec:

    # ama "Y, por cierto, gracias por lo de [eva]."
    ama "E, aliás, obrigado pelo [eva]."

# game/scripts/c22/c22.rpy:2434
translate brazilian c22s003_IronFistCalls_46cea44c:

    # mc "¿Gracias por qué? Es tu hermana, pero es mi prima."
    mc "Obrigada por quê? Ela é sua irmã, mas é minha prima."

# game/scripts/c22/c22.rpy:2435
translate brazilian c22s003_IronFistCalls_131c04dc:

    # ama "Tienes razón, pero no por ello estoy menos agradecida por lo que has hecho."
    ama "Você tem razão, mas isso não diminui em nada minha gratidão pelo que você fez."

# game/scripts/c22/c22.rpy:2437
translate brazilian c22s003_IronFistCalls_6ed672c4:

    # mc "Y también mi novia, por lo que parece."
    mc "E minha namorada também, pelo visto."

# game/scripts/c22/c22.rpy:2439
translate brazilian c22s003_IronFistCalls_31693633:

    # ama "*Risa* ¿Por qué odias tanto esa palabra?"
    ama "*Risos* Por que você odeia tanto essa palavra?"

# game/scripts/c22/c22.rpy:2440
translate brazilian c22s003_IronFistCalls_f8cb2d92:

    # mc "Porque cuando se dice tantas veces pierde el significado. Además nunca me han gustado las etiquetas."
    mc "Porque, quando se repete tantas vezes, perde o sentido. Além disso, nunca gostei de rótulos."

# game/scripts/c22/c22.rpy:2442
translate brazilian c22s003_IronFistCalls_c1490d2d:

    # mc "*Risa* Suena muy raro decir que las dos sois mis novias. Creo que no es el uso que tenían pensado cuando inventaron la puta palabra."
    mc "*Risos* Soa muito estranho dizer que vocês duas são minhas namoradas. Acho que não era isso que eles tinham em mente quando inventaram essa palavra."

# game/scripts/c22/c22.rpy:2444
translate brazilian c22s003_IronFistCalls_f45f20b0:

    # ama "Tienes razón. Te veo luego... novio. *Risa*"
    ama "Você tem razão. Até mais... namorado. *Risos*"

# game/scripts/c22/c22.rpy:2446
translate brazilian c22s003_IronFistCalls_1cb86906:

    # ama "No te entretengo más."
    ama "Não vou te deter mais."

# game/scripts/c22/c22.rpy:2450
translate brazilian c22s003_IronFistCalls_689458b3:

    # ama "Te veo luego."
    ama "Até mais."

# game/scripts/c22/c22.rpy:2452
translate brazilian c22s003_IronFistCalls_614f43b7:

    # mc "Hasta dentro de un rato."
    mc "Até daqui a pouco."

# game/scripts/c22/c22.rpy:2459
translate brazilian c22s004_EriPregnancyResult_eb0ace6b:

    # "Conduces a casa esperando que [ama] tenga razón en que vas a aprender rápido el nuevo oficio."
    "Você dirige para casa esperando que [ama] esteja certo e que você aprenderá o novo trabalho rapidamente."

# game/scripts/c22/c22.rpy:2460
translate brazilian c22s004_EriPregnancyResult_38ff4c55:

    # "Estás seguro de que no eres un buen negociador. Ni siquiera sabes que salario vas a tener y ya has aceptado el puesto."
    "Você tem certeza de que não é um bom negociador. Você nem sabe qual será o seu salário e já aceitou o cargo."

# game/scripts/c22/c22.rpy:2463
translate brazilian c22s004_EriPregnancyResult_d97e40d3:

    # "Al volver a casa, encuentras a [eri] charlando con [kat] en la planta de las estudiantes."
    "Ao retornar para casa, você encontra [eri] conversando com [kat] no andar dos estudantes."

# game/scripts/c22/c22.rpy:2464
translate brazilian c22s004_EriPregnancyResult_a9d94cc5:

    # eri "... Creo que deberías unirte. El yoga puede ser divertido."
    eri "Acho que você deveria participar. Yoga pode ser divertido."

# game/scripts/c22/c22.rpy:2465
translate brazilian c22s004_EriPregnancyResult_97b63234:

    # kat "No me vas a convencer, [eri]. Hoy es mi día de descanso de hacer deporte."
    kat "Você não vai me convencer, [eri]. Hoje é meu dia de folga dos esportes."

# game/scripts/c22/c22.rpy:2466
translate brazilian c22s004_EriPregnancyResult_e2488fb9:

    # kat "Suficiente tengo con despertarme pronto porque [kim] pone la alarma para levantarse en un día que no tengo clase por la mañana."
    kat "Já tenho problemas suficientes só por ter que acordar cedo porque [kim] programa o alarme para tocar num dia em que não tenho aula de manhã."

# game/scripts/c22/c22.rpy:2467
translate brazilian c22s004_EriPregnancyResult_67e2393e:

    # mc "Hola, chicas, ¿qué tal?"
    mc "Olá meninas, tudo bem?"

# game/scripts/c22/c22.rpy:2469
translate brazilian c22s004_EriPregnancyResult_0d644090:

    # kat "[eri] sigue la tendencia del día de intentar que me una a las sesiones de yoga. *Risa*"
    kat "[eri] Ela continua com a mania de tentar me convencer a participar das aulas de ioga. *Risos*"

# game/scripts/c22/c22.rpy:2470
translate brazilian c22s004_EriPregnancyResult_e2acc59a:

    # mc "Ya les has dicho que no te vas a unir mientras lleven ropa, ¿no?"
    mc "Você já disse a eles que não vai participar enquanto eles estiverem vestidos, certo?"

# game/scripts/c22/c22.rpy:2472
translate brazilian c22s004_EriPregnancyResult_20ef6082:

    # kat "*Risa* Ni siquiera entonces. Me sentaría en una tumbona a mirarlas."
    kat "*Risos* Nem assim. Eu simplesmente me sentaria numa espreguiçadeira e ficaria observando."

# game/scripts/c22/c22.rpy:2473
translate brazilian c22s004_EriPregnancyResult_aaafa764:

    # mc "*Risa* Guárdame un sitio en esa tumbona."
    mc "*Risos* Guarda um lugar pra mim naquela espreguiçadeira."

# game/scripts/c22/c22.rpy:2475
translate brazilian c22s004_EriPregnancyResult_4b5d8867:

    # eri "*Risa* Y por eso no haremos nunca yoga desnudas. Queremos que os unáis, y no como público."
    eri "*Risos* E é por isso que nunca faremos ioga nus. Queremos que vocês participem conosco, não como espectadores."

# game/scripts/c22/c22.rpy:2476
translate brazilian c22s004_EriPregnancyResult_00ff4d75:

    # mc "*Risa* Ya sabes que la flexibilidad no es lo mío."
    mc "*Risos* Você sabe que flexibilidade não é meu forte."

# game/scripts/c22/c22.rpy:2478
translate brazilian c22s004_EriPregnancyResult_5870f805:

    # kat "Bueno, yo voy a ir a estudiar un rato. Hoy quería acabar un informe sobre las belugas."
    kat "Bem, vou estudar um pouco. Hoje eu queria terminar um relatório sobre belugas."

# game/scripts/c22/c22.rpy:2479
translate brazilian c22s004_EriPregnancyResult_3be3a8ac:

    # mc "Las belugas son primas de las ballenas, ¿no?"
    mc "As belugas são primas das baleias, não são?"

# game/scripts/c22/c22.rpy:2481
translate brazilian c22s004_EriPregnancyResult_c983b5c7:

    # kat "No son primas de las ballenas. Son ballenas."
    kat "Eles não são parentes das baleias. Eles são baleias."

# game/scripts/c22/c22.rpy:2482
translate brazilian c22s004_EriPregnancyResult_0bbf2f8b:

    # kat "Pero bien hecho, [mc]. Ya era hora que te atrevieras."
    kat "Muito bem, [mc]. Já estava na hora de você ousar."

# game/scripts/c22/c22.rpy:2483
translate brazilian c22s004_EriPregnancyResult_7a2136d1:

    # mc "¿Qué he hecho?"
    mc "O que eu fiz?"

# game/scripts/c22/c22.rpy:2485
translate brazilian c22s004_EriPregnancyResult_2b1883cb:

    # kat "Insinuar que, al ser ballenas, tengo algún tipo de ventaja para escribir el informe. Es un buen chiste de gordos. Un poco cruel, pero es bueno."
    kat "Sugerir que, por sermos baleias, eu tenho algum tipo de vantagem em escrever o relatório. É uma boa piada sobre gordura. Um pouco cruel, mas é boa."

# game/scripts/c22/c22.rpy:2486
translate brazilian c22s004_EriPregnancyResult_6dfd96c5:

    # mc "¿Qué? ¡No! ¡No quería decir eso!"
    mc "O quê? Não! Não foi isso que eu quis dizer!"

# game/scripts/c22/c22.rpy:2488
translate brazilian c22s004_EriPregnancyResult_47ce2a6e:

    # eri "¡[mc]! ¿Cómo te atreves? No tienes que intentar acomplejar a nadie sobre su cuerpo."
    eri "Que absurdo! Você não precisa tentar fazer ninguém se sentir inseguro em relação ao próprio corpo."

# game/scripts/c22/c22.rpy:2489
translate brazilian c22s004_EriPregnancyResult_f2370a05:

    # mc "¡De verdad! ¡No he insinuado nada de eso!"
    mc "Sério?! Eu não quis dizer nada disso!"

# game/scripts/c22/c22.rpy:2492
translate brazilian c22s004_EriPregnancyResult_ca594ec9:

    # eri "*Risa* Tenías razón..."
    eri "*Risos* Você tinha razão..."

# game/scripts/c22/c22.rpy:2493
translate brazilian c22s004_EriPregnancyResult_ae4a07a5:

    # kat "*Risa* Nunca falla..."
    kat "*Risos* É infalível..."

# game/scripts/c22/c22.rpy:2494
translate brazilian c22s004_EriPregnancyResult_f8f197a8:

    # mc "¿Qué está pasando aquí?"
    mc "O que está acontecendo aqui?"

# game/scripts/c22/c22.rpy:2496
translate brazilian c22s004_EriPregnancyResult_a1697737:

    # eri "*Risa* [kat] me estaba diciendo que si consigue que alguien piense que se ha metido con su físico sin darse cuenta, por norma se ponen incómodos."
    eri "*Risos* [kat] Ele estava me dizendo que, se ele consegue fazer alguém pensar que zombou da aparência dela sem perceber, ela geralmente fica desconfortável."

# game/scripts/c22/c22.rpy:2497
translate brazilian c22s004_EriPregnancyResult_4dbd5471:

    # kat "*Risa* Y diez minutos después llegas tú y me das la oportunidad de demostrarlo. Gracias por ser mi conejillo de indias."
    kat "*Risos* E dez minutos depois você chega e me dá a oportunidade de provar isso. Obrigado por ser minha cobaia."

# game/scripts/c22/c22.rpy:2498
translate brazilian c22s004_EriPregnancyResult_6b5bdb3b:

    # mc "Sois malas personas. *Risa* Y yo he caído en vuestra broma. ¡Me voy a mi habitación hasta la hora de comer! Castigado por tonto. *Risa*"
    mc "Vocês são todos malvados. *Risos* E eu caí na sua pegadinha. Vou para o meu quarto até a hora do almoço! De castigo por ter feito besteira. *Risos*"

# game/scripts/c22/c22.rpy:2503
translate brazilian c22s004_EriPregnancyResult_d2cbeeda:

    # ambas "Hasta luego, [mc]."
    ambas "Até logo, [mc]."

# game/scripts/c22/c22.rpy:2519
translate brazilian c22s004_EriPregnancy_91543177:

    # eri "Ahora subo a verte. Tengo un tema que tratar contigo."
    eri "Estou subindo para falar com você agora. Preciso conversar sobre algo."

# game/scripts/c22/c22.rpy:2525
translate brazilian c22s004_EriPregnancy_08b5df7f:

    # mc "Ok."
    mc "OK."

# game/scripts/c22/c22.rpy:2527
translate brazilian c22s004_EriPregnancy_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c22/c22.rpy:2529
translate brazilian c22s004_EriPregnancy_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c22/c22.rpy:2531
translate brazilian c22s004_EriPregnancy_fbcb10e3:

    # eri "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    eri "*Pela porta* Sou eu. Posso entrar?"

# game/scripts/c22/c22.rpy:2532
translate brazilian c22s004_EriPregnancy_3b55a4ab:

    # mc "Sí, entra."
    mc "Sim, entre."

# game/scripts/c22/c22.rpy:2534
translate brazilian c22s004_EriPregnancy_70251361:

    # mc "Dime. Parecía urgente."
    mc "Diga-me. Parecia urgente."

# game/scripts/c22/c22.rpy:2535
translate brazilian c22s004_EriPregnancy_5c69d3c4:

    # eri "No, todo lo contrario que urgente."
    eri "Não, muito pelo contrário de urgente."

# game/scripts/c22/c22.rpy:2536
translate brazilian c22s004_EriPregnancy_9b6f6612:

    # eri "Hace un par de días que la prueba de embarazo tiene que haber dado los resultados..."
    eri "O teste de gravidez deveria ter dado o resultado há alguns dias..."

# game/scripts/c22/c22.rpy:2537
translate brazilian c22s004_EriPregnancy_5e4174aa:

    # mc "¡Es verdad! ¡Me había olvidado de ella!"
    mc "É verdade! Eu tinha me esquecido dela!"

# game/scripts/c22/c22.rpy:2538
translate brazilian c22s004_EriPregnancy_3198ded4:

    # mc "¿Quieres hacer los honores? Está en ese armario."
    mc "Você quer fazer as honras? Está naquele armário."

# game/scripts/c22/c22.rpy:2541
translate brazilian c22s004_EriPregnancy_27e10dda:

    # eri "¡Verde! ¡Vamos a tener a Hope!"
    eri "Verde! Teremos esperança!"

# game/scripts/c22/c22.rpy:2542
translate brazilian c22s004_EriPregnancy_6d51f1a5:

    # mc "¡Felicidades, futura mamá!"
    mc "Parabéns, futura mamãe!"

# game/scripts/c22/c22.rpy:2544
translate brazilian c22s004_EriPregnancy_6bb6d4cd:

    # eri "Felicidades a ti también, Papá."
    eri "Parabéns para você também, pai."

# game/scripts/c22/c22.rpy:2545
translate brazilian c22s004_EriPregnancy_05e3eae1:

    # mc "Gracias, cielo."
    mc "Obrigado, querido."

# game/scripts/c22/c22.rpy:2547
translate brazilian c22s004_EriPregnancy_f004ec1b:

    # mc "¿Has hablado con [nor] sobre lo del nombre?"
    mc "Você já falou com [nor] sobre o nome?"

# game/scripts/c22/c22.rpy:2549
translate brazilian c22s004_EriPregnancy_06c017cb:

    # eri "Sí, le dije que me hacía mucha ilusión ponerle Hope a mi hija y no tuvo ningún problema."
    eri "Sim, eu disse a ela que estava muito animada para dar o nome de Hope à minha filha e ela não teve nenhum problema com isso."

# game/scripts/c22/c22.rpy:2550
translate brazilian c22s004_EriPregnancy_68b8233f:

    # eri "Al fin y al cabo, el nombre lo había elegido yo."
    eri "Afinal, eu havia escolhido o nome."

# game/scripts/c22/c22.rpy:2551
translate brazilian c22s004_EriPregnancy_7db9fc44:

    # mc "Me alegra que lo hayáis podido resolver sin dramas."
    mc "Fico feliz que você tenha conseguido resolver a situação sem maiores problemas."

# game/scripts/c22/c22.rpy:2553
translate brazilian c22s004_EriPregnancy_ad07759b:

    # eri "Y ¿ahora qué?"
    eri "E agora?"

# game/scripts/c22/c22.rpy:2554
translate brazilian c22s004_EriPregnancy_28760dbb:

    # mc "Supongo que después de la Gran Revelación, debemos comunicar estas cosas a la familia, ¿no?"
    mc "Imagino que, após a Grande Revelação, devamos comunicar essas coisas à família, não é?"

# game/scripts/c22/c22.rpy:2555
translate brazilian c22s004_EriPregnancy_7ed1aafd:

    # mc "Me he cansado de guardar cosas en secreto."
    mc "Estou cansado de guardar segredos."

# game/scripts/c22/c22.rpy:2557
translate brazilian c22s004_EriPregnancy_fd25e266:

    # eri "Me parece buena idea. Me gustaría decírselo a mi madre y a mi hermana en persona."
    eri "Parece uma boa ideia. Gostaria de contar pessoalmente para minha mãe e minha irmã."

# game/scripts/c22/c22.rpy:2558
translate brazilian c22s004_EriPregnancy_e0602a5e:

    # eri "Al resto se lo podemos decir en la comida y publicarlo en el grupo de WhatsUp."
    eri "Podemos contar o resto no almoço e postar no grupo do WhatsApp."

# game/scripts/c22/c22.rpy:2559
translate brazilian c22s004_EriPregnancy_90552759:

    # mc "En el que no estoy... *Risa*"
    mc "Do qual eu não faço parte... *Risos*"

# game/scripts/c22/c22.rpy:2561
translate brazilian c22s004_EriPregnancy_04ebd4e9:

    # eri "*Risa* Y en el que no estarás. [emm] me ha dicho que crearemos otro contigo, pero ese es solo para chicas."
    eri "*Risos* E você não estará nesse. [emm] Ela me disse que vamos criar outro com você, mas esse é só para meninas."

# game/scripts/c22/c22.rpy:2562
translate brazilian c22s004_EriPregnancy_922c24f9:

    # mc "Y [jam]..."
    mc "E [jam]..."

# game/scripts/c22/c22.rpy:2563
translate brazilian c22s004_EriPregnancy_f8a1e499:

    # eri "*Risa* Y [jam]."
    eri "*Risos* E [jam]."

# game/scripts/c22/c22.rpy:2566
translate brazilian c22s004_EriPregnancy_02babdd4:

    # eri "Vamos a decírselo a [dap.nick] y a mi madre."
    eri "Vamos contar para [dap.nick] e para minha mãe."

# game/scripts/c22/c22.rpy:2567
translate brazilian c22s004_EriPregnancy_f6878a68:

    # mc "Cuando quieras."
    mc "Quando você quiser."

# game/scripts/c22/c22.rpy:2569
translate brazilian c22s004_EriPregnancy_9b24d617:

    # "Las reacciones de [nor] y [dap] por la llegada de Hope son de pura alegría."
    "As reações de [nor] e [dap] à chegada de Hope são de pura alegria."

# game/scripts/c22/c22.rpy:2570
translate brazilian c22s004_EriPregnancy_8404d54b:

    # "Después, durante la comida, se lo comunicáis al resto de la familia y os llueven las felicitaciones."
    "Então, durante o almoço, você conta para o resto da família e será inundado de parabéns."

# game/scripts/c22/c22.rpy:2571
translate brazilian c22s004_EriPregnancy_f09cdca5:

