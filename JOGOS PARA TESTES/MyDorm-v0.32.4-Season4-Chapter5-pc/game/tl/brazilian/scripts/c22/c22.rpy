    # deb "*A través de la puerta* Ya te he dicho que a mí no me importa. ¡[mc] y yo no tenemos una relación exclusiva!"
    deb "*Através da porta* Eu já te disse que não me importo. [mc] e eu não temos um relacionamento exclusivo!"

# game/scripts/c22/c22.rpy:3980
translate brazilian c22s007_LisChat_f136de80:

    # deb "*A través de la puerta* ¡Además, no seríamos la primera pareja de hermanas con las que sale!"
    deb "*Através da porta* Além disso, não seríamos o primeiro par de irmãs com quem ele namorou!"

# game/scripts/c22/c22.rpy:3982
translate brazilian c22s007_LisChat_21e0743d:

    # deb "*A través de la puerta* ¡Tan solo nos convertiría en la primera pareja de hermanas con las que sale!"
    deb "*Através da porta* Isso faria de nós o primeiro par de irmãs com quem ele já namorou!"

# game/scripts/c22/c22.rpy:3983
translate brazilian c22s007_LisChat_9aa0485f:

    # mcp "([lis] miente fatal y está claro lo que está pasando aquí. ¿Pero qué quiero yo?)"
    mcp "([lis] Ele é um péssimo mentiroso e está claro o que está acontecendo aqui. Mas o que eu quero?)"

# game/scripts/c22/c22.rpy:4000
translate brazilian c22s007_LisChat_83cbc837:

    # mc "Bueno, entonces si yo no te gusto de esa forma, creo que [deb.nick] ha malinterpretado algo en vuestras conversaciones."
    mc "Bem, se você não gosta de mim desse jeito, então acho que [deb.nick] interpretou mal algo em suas conversas."

# game/scripts/c22/c22.rpy:4002
translate brazilian c22s007_LisChat_cf56160d:

    # "Está a punto de decir algo, pero no dejas que te interrumpa."
    "Ele está prestes a dizer algo, mas você não o deixa interrompê-lo."

# game/scripts/c22/c22.rpy:4003
translate brazilian c22s007_LisChat_8ebe1c51:

    # mc "Que ninguno de los dos nos gustemos de esa forma es una suerte. Así seguro que no hay malentendidos."
    mc "Ainda bem que nenhum de nós gosta do outro dessa forma. Assim, com certeza não haverá mal-entendidos."

# game/scripts/c22/c22.rpy:4004
translate brazilian c22s007_LisChat_dbb07ff3:

    # mcp "(Y de esta forma, si realmente le gusto de esa forma, no se sentirá tan humillada o rechazada como si hubiera tenido que confesarlo.)"
    mcp "(E assim, se ela realmente gosta de mim desse jeito, não se sentirá tão humilhada ou rejeitada como se tivesse que confessar.)"

# game/scripts/c22/c22.rpy:4006
translate brazilian c22s007_LisChat_7f531c70:

    # lis "Sí, es una suerte... A veces mi hermana es idiota... Ella creía que tú..."
    lis "Sim, é uma sorte... Às vezes minha irmã é uma idiota... Ela pensou que você..."

# game/scripts/c22/c22.rpy:4007
translate brazilian c22s007_LisChat_47e936da:

    # mc "Que tú y yo podíamos hacer una buena pareja, pero creo que sólo veía dos amigos y lo ha malinterpretado."
    mc "Que você e eu poderíamos formar um bom casal, mas acho que ele só viu dois amigos e interpretou mal a situação."

# game/scripts/c22/c22.rpy:4009
translate brazilian c22s007_LisChat_1d9e4a6d:

    # lis "Gracias, [mc]. Por hacérselo ver."
    lis "Obrigado, [mc], por ter apontado isso."

# game/scripts/c22/c22.rpy:4010
translate brazilian c22s007_LisChat_974e2d2c:

    # mc "No hay de qué, [lis]. Todo el mundo puede equivocarse..."
    mc "De nada, [lis]. Todos podem cometer erros..."

# game/scripts/c22/c22.rpy:4012
translate brazilian c22s007_LisChat_7d0c9a47:

    # mc "[deb.nick], ¿puedo salir ya? Creo que todo se ha aclarado ya."
    mc "[deb.nick], posso ir agora? Acho que tudo está esclarecido."

# game/scripts/c22/c22.rpy:4014
translate brazilian c22s007_LisChat_2b37af5e:

    # deb "Sí, ya puedes salir."
    deb "Sim, você pode ir agora."

# game/scripts/c22/c22.rpy:4015
translate brazilian c22s007_LisChat_8043e6a3:

    # deb "Susurrando* Y gracias por como lo has llevado..."
    deb "*Sussurrando* E obrigada pela forma como você lidou com isso..."

# game/scripts/c22/c22.rpy:4017
translate brazilian c22s007_LisChat_01d232ba:

    # kat "Muy elegante tu forma de rechazarla."
    kat "Sua maneira de rejeitá-la foi muito elegante."

# game/scripts/c22/c22.rpy:4018
translate brazilian c22s007_LisChat_a7d46bb1:

    # kim "Has evitado que se sintiera humillada. Eres un caballero."
    kim "Você a impediu de se sentir humilhada. Você é um cavalheiro."

# game/scripts/c22/c22.rpy:4019
translate brazilian c22s007_LisChat_70e01204:

    # mc "No sé de qué estáis hablando. [deb.nick] ha malinterpretado una situación y se ha vuelto incómodo para [lis]."
    mc "Não sei do que você está falando. [deb.nick] interpretou mal uma situação e ficou constrangedor para [lis]."

# game/scripts/c22/c22.rpy:4021
translate brazilian c22s007_LisChat_189fcf18:

    # kat "Sí, sí. Malinterpretado."
    kat "Sim, sim. Mal-entendido."

# game/scripts/c22/c22.rpy:4022
translate brazilian c22s007_LisChat_d24890b4:

    # mc "Exacto, malinterpretado. Si alguno de los dos hubiera sentido algo que el otro no sentía, se podría haber sentido mal."
    mc "Exatamente, houve um mal-entendido. Se algum deles tivesse sentido algo que o outro não sentiu, poderia ter se sentido mal."

# game/scripts/c22/c22.rpy:4023
translate brazilian c22s007_LisChat_f60473d9:

    # mc "Por suerte {b}ninguno de los dos{/b} siente nada por el otro y tan solo somos amigos."
    mc "Felizmente, nenhum de nós sente nada pelo outro e somos apenas amigos."

# game/scripts/c22/c22.rpy:4024
translate brazilian c22s007_LisChat_3bce8079:

    # kim "*Risa* Lo que he dicho. Un caballero. Gracias por portarte así con [lis]."
    kim "*Risos* Exatamente como eu disse. Um cavalheiro. Obrigado por ser tão gentil com [lis]."

# game/scripts/c22/c22.rpy:4026
translate brazilian c22s007_LisChat_057ec83d:

    # kat "Sí, gracias. Me gustaría que cada vez que me rechacen lo hagan así."
    kat "Sim, obrigada. Gostaria que, todas as vezes que fosse rejeitada, fosse dessa forma."

# game/scripts/c22/c22.rpy:4027
translate brazilian c22s007_LisChat_048f9334:

    # kim "Por suerte, [mc] {b}no ha tenido que rechazar a [lis]{/b}, ya que {b}ninguno de los dos{/b} siente nada por el otro y [deb.nick] se ha equivocado."
    kim "Felizmente, [mc] {b}não precisou rejeitar [lis]{/b}, já que {b}nenhum deles sente nada pelo outro e [deb.nick] estava errado."

# game/scripts/c22/c22.rpy:4028
translate brazilian c22s007_LisChat_e3a36807:

    # kim "¿Lo entiendes, [kat]?"
    kim "Você entende, [kat]?"

# game/scripts/c22/c22.rpy:4029
translate brazilian c22s007_LisChat_6fddcb46:

    # mc "Exacto. *Risa* Y ahora, si me lo permitís, voy a subir a mi habitación. Hasta mañana, chicas."
    mc "Exatamente. *Risos* E agora, com licença, vou subir para o meu quarto. Até amanhã, meninas."

# game/scripts/c22/c22.rpy:4031
translate brazilian c22s007_LisChat_4fe3dae7:

    # kim "Hasta mañana, [mc]."
    kim "Até amanhã, [mc]."

# game/scripts/c22/c22.rpy:4032
translate brazilian c22s007_LisChat_f8769173:

    # kat "Te vemos mañana, [mc]."
    kat "Até amanhã, [mc]."

# game/scripts/c22/c22.rpy:4035
translate brazilian c22s007_LisChat_897b82e9:

    # mc "Bueno, si no te gusto de esa forma, no hay mucho que podamos hacer."
    mc "Bem, se você não gosta de mim desse jeito, não há muito que possamos fazer."

# game/scripts/c22/c22.rpy:4037
translate brazilian c22s007_LisChat_62f8906f:

    # lis "Lo dices como si yo te gustara de esa forma..."
    lis "Você diz isso como se gostasse de mim desse jeito..."

# game/scripts/c22/c22.rpy:4038
translate brazilian c22s007_LisChat_37115ec4:

    # mc "Sabiendo que tú no sientes nada por mí, aunque yo lo sintiera, no te lo podría decir."
    mc "Sabendo que você não sente nada por mim, mesmo que eu sentisse, eu não conseguiria te dizer."

# game/scripts/c22/c22.rpy:4039
translate brazilian c22s007_LisChat_0716c43e:

    # mc "El resultado es que tú estarías incómoda o yo acabaría humillado y rechazado. Con lo que mejor no hacerlo."
    mc "O resultado é que você se sentiria desconfortável, ou eu acabaria humilhado e rejeitado. Portanto, é melhor não fazer isso."

# game/scripts/c22/c22.rpy:4041
translate brazilian c22s007_LisChat_b45db4e7:

    # lis "Sí, mejor no hacerlo..."
    lis "Sim, é melhor não..."

# game/scripts/c22/c22.rpy:4043
translate brazilian c22s007_LisChat_5935ef32:

    # deb "¡Sois idiotas los dos!"
    deb "Vocês dois são idiotas!"

# game/scripts/c22/c22.rpy:4044
translate brazilian c22s007_LisChat_cd3c1346:

    # kat "¿Tan difícil les es decir que los dos se gustan?"
    kat "É tão difícil para eles dizerem que gostam um do outro?"

# game/scripts/c22/c22.rpy:4045
translate brazilian c22s007_LisChat_3ae603bd:

    # kim "Para [lis] es difícil, y ha empezado negándolo. Contradecirse ahora es más difícil todavía."
    kim "É difícil para [lis], e ele começou negando isso. Contradizer-se agora é ainda mais difícil."

# game/scripts/c22/c22.rpy:4047
translate brazilian c22s007_LisChat_60d8965e:

    # lis "¡Y más aún con público, joder!"
    lis "E ainda mais com uma plateia, droga!"

# game/scripts/c22/c22.rpy:4048
translate brazilian c22s007_LisChat_0b8fef29:

    # mc "*Risa* Creo que es la primera vez que te oigo decir un taco."
    mc "*Risos* Acho que esta é a primeira vez que te ouço dizer um palavrão."

# game/scripts/c22/c22.rpy:4050
translate brazilian c22s007_LisChat_cf7f5f46:

    # lis "Es que me sacan de mis casillas... no es así como había pensado que pasaría..."
    lis "Eles me irritam muito... não era assim que eu imaginava que seria..."

# game/scripts/c22/c22.rpy:4052
translate brazilian c22s007_LisChat_05931c5c:

    # lis "Antes de que empezaras a salir con [deb.nick], claro..."
    lis "Antes de você começar a namorar [deb.nick], é claro..."

# game/scripts/c22/c22.rpy:4053
translate brazilian c22s007_LisChat_33346e7c:

    # mc "Cómo habías pensado que pasaría... ¿qué, exactamente?"
    mc "Como você achou que isso ia acontecer... o quê, exatamente?"

# game/scripts/c22/c22.rpy:4055
translate brazilian c22s007_LisChat_312b9172:

    # lis "Nada, una estupidez..."
    lis "Nada, só estupidez..."

# game/scripts/c22/c22.rpy:4056
translate brazilian c22s007_LisChat_598d3c5f:

    # mc "OK, dado que no te gusto... de esa forma... habías pensado que en algún momento te pediría una cita o algo así y en como rechazarme, ¿no?"
    mc "Ok, já que você não gosta de mim... desse jeito... você pensou que em algum momento eu te chamaria para sair ou algo assim e como você poderia me rejeitar, né?"

# game/scripts/c22/c22.rpy:4057
translate brazilian c22s007_LisChat_4fa4d568:

    # mc "Lo querías hacer de tal forma que yo no me sintiera humillado porque, a pesar de la imagen que das a veces, eres una buena chica."
    mc "Você queria fazer isso de um jeito que eu não me sentisse humilhada porque, apesar da imagem que você às vezes projeta, você é uma boa menina."

# game/scripts/c22/c22.rpy:4058
translate brazilian c22s007_LisChat_94fb0cd7:

    # mc "Y con ese peinado, incluso parece que el palo por el culo que [kat] decía que tenías ha desaparecido."
    mc "E com esse penteado, até parece que o cabo de vassoura enfiado no seu traseiro que [kat] disse que você tinha sumiu."

# game/scripts/c22/c22.rpy:4060
translate brazilian c22s007_LisChat_b19fb341:

    # lis "¡[mc]!" (multiple=2)
    lis "[mc]!" (multiple=2)

# game/scripts/c22/c22.rpy:4061
translate brazilian c22s007_LisChat_711645d9:

    # kat "*A través de la puerta* ¡[mc]!" (multiple=2)
    kat "*Pela porta* [mc]!" (multiple=2)

# game/scripts/c22/c22.rpy:4062
translate brazilian c22s007_LisChat_4dbf355d:

    # mc "¡Hey! Me gusta más esta nueva versión de ti, pero déjame seguir. Estoy intentando atar cabos."
    mc "Ei! Gostei mais dessa nova versão sua, mas deixe-me continuar. Estou tentando juntar as peças."

# game/scripts/c22/c22.rpy:4063
translate brazilian c22s007_LisChat_a43ce881:

    # mc "Como ahora tenemos público, tu plan de hacerlo en privado para que yo no me sintiera mal ha desaparecido."
    mc "Agora que temos uma plateia, seu plano de fazer isso em particular para que eu não me sentisse mal desapareceu."

# game/scripts/c22/c22.rpy:4064
translate brazilian c22s007_LisChat_675dbe40:

    # mc "Porque desde que [deb.nick] me ha metido en la habitación, crees que voy a pedirte esa cita o algo así, ¿no?"
    mc "Porque desde que [deb.nick] me trouxe para a sala, você acha que eu vou te convidar para sair ou algo assim, né?"

# game/scripts/c22/c22.rpy:4066
translate brazilian c22s007_LisChat_a9487cb4:

    # lis "No. No es eso. [deb.nick] te ha metido en la habitación para que {b}yo{/b} te pida una cita o algo así."
    lis "Não. Não é isso. [deb.nick] trouxe você para a sala para que {b}eu{/b} pudesse te convidar para sair ou algo assim."

# game/scripts/c22/c22.rpy:4067
translate brazilian c22s007_LisChat_178b3447:

    # mc "¿Por qué ibas a hacerlo? No te gusto de esa forma..."
    mc "Por que você faria isso? Você não gosta de mim desse jeito..."

# game/scripts/c22/c22.rpy:4069
translate brazilian c22s007_LisChat_bab46458:

    # lis "Porque mi hermana es idiota. Cree que tú me gustas de esa forma... y que... si me gustaras... yo sería lo suficientemente valiente como para hacerlo."
    lis "Porque minha irmã é uma idiota. Ela acha que eu gosto de você desse jeito... e que... se eu gostasse de você... eu teria coragem de fazer isso."

# game/scripts/c22/c22.rpy:4070
translate brazilian c22s007_LisChat_da41b373:

    # lis "Lo suficientemente valiente como para decírtelo."
    lis "Corajosa o suficiente para te contar."

# game/scripts/c22/c22.rpy:4071
translate brazilian c22s007_LisChat_c4be73ae:

    # mc "¿Y es verdad?"
    mc "E será verdade?"

# game/scripts/c22/c22.rpy:4072
translate brazilian c22s007_LisChat_d6a4eb1a:

    # lis "No."
    lis "Não."

# game/scripts/c22/c22.rpy:4073
translate brazilian c22s007_LisChat_0d43cec6:

    # mc "¿Lo de que no eres lo suficientemente valiente para decírmelo o lo de que no eres lo suficientemente valiente para pedirme esa cita?"
    mc "Você está dizendo que não tem coragem suficiente para me contar, ou que não tem coragem suficiente para me convidar para sair?"

# game/scripts/c22/c22.rpy:4074
translate brazilian c22s007_LisChat_90acf2e3:

    # lis "Ninguna de las dos cosas..."
    lis "Nenhuma dessas coisas..."

# game/scripts/c22/c22.rpy:4076
translate brazilian c22s007_LisChat_3fa92898:

    # lis "¡Oh!"
    lis "Oh!"

# game/scripts/c22/c22.rpy:4077
translate brazilian c22s007_LisChat_879e1f5a:

    # mc "[lis], ¿puedes mirarme un momento?"
    mc "[lis], você pode olhar para mim por um momento?"

# game/scripts/c22/c22.rpy:4079
translate brazilian c22s007_LisChat_e4c57dc1:

    # kim "¿Oyes algo, [deb.nick]? Llevan un minuto en silencio..."
    kim "Você ouve alguma coisa, [deb.nick]? Eles estão em silêncio há um minuto..."

# game/scripts/c22/c22.rpy:4080
translate brazilian c22s007_LisChat_bee3bcb7:

    # deb "Callad, no oigo nada..."
    deb "Silêncio, não consigo ouvir nada..."

# game/scripts/c22/c22.rpy:4081
translate brazilian c22s007_LisChat_015369d5:

    # kat "Lo ha matado y está descuartizando el cadáver con las tijeras de manualidades, seguro."
    kat "Ele o matou e está desmembrando o cadáver com uma tesoura de artesanato, disso eu tenho certeza."

# game/scripts/c22/c22.rpy:4082
translate brazilian c22s007_LisChat_bf894edb:

    # deb "*Susurrando* Voy a abrir un poco la puerta..."
    deb "*Sussurrando* Vou abrir um pouco a porta..."

# game/scripts/c22/c22.rpy:4084
translate brazilian c22s007_LisChat_09947f91:

    # deb "¡Oh!"
    deb "Oh!"

# game/scripts/c22/c22.rpy:4086
translate brazilian c22s007_LisChat_2b73efda:

    # deb "Chicas, nada que ver aquí. Voy a ir a la piscina un rato. Me he dejado un libro allí."
    deb "Meninas, nada para ver aqui. Vou para a piscina por um tempo. Deixei um livro lá."

# game/scripts/c22/c22.rpy:4087
translate brazilian c22s007_LisChat_a43745f0:

    # kim "¿Se están besando? ¡Qué romántico!"
    kim "Eles estão se beijando? Que romântico!"

# game/scripts/c22/c22.rpy:4088
translate brazilian c22s007_LisChat_bbff4a5a:

    # kat "Lo matará en la noche de bodas. *Risa*"
    kat "Ele vai matá-lo na noite de núpcias. *Risos*"

# game/scripts/c22/c22.rpy:4089
translate brazilian c22s007_LisChat_357923a1:

    # deb "Hasta luego, chicas."
    deb "Até logo, meninas."

# game/scripts/c22/c22.rpy:4093
translate brazilian c22s007_LisChat_aec556da:

    # "Tras varios minutos ininterrumpidos de besos..."
    "Após vários minutos ininterruptos de beijos..."

# game/scripts/c22/c22.rpy:4095
translate brazilian c22s007_LisChat_892efbd8:

    # lis "¿Por qué me has besado?"
    lis "Por que você me beijou?"

# game/scripts/c22/c22.rpy:4096
translate brazilian c22s007_LisChat_88162013:

    # mc "*Risa* Que me preguntes eso después de diez minutos devolviéndome el beso me desconcierta..."
    mc "*Risos* Perguntar isso depois de dez minutos de você estar me beijando é desconcertante..."

# game/scripts/c22/c22.rpy:4097
translate brazilian c22s007_LisChat_668e14bf:

    # mc "Por cierto, besas mejor de lo que esperaba."
    mc "Aliás, você beija melhor do que eu esperava."

# game/scripts/c22/c22.rpy:4099
translate brazilian c22s007_LisChat_ef093f13:

    # lis "¿Qué? ¿Esperabas que besara mal?"
    lis "O quê? Você esperava que eu beijasse mal?"

# game/scripts/c22/c22.rpy:4100
translate brazilian c22s007_LisChat_15249e72:

    # mc "No, pero no esperaba que besaras {b}tan{/b} bien."
    mc "Não, mas eu não esperava que você beijasse tão bem."

# game/scripts/c22/c22.rpy:4102
translate brazilian c22s007_LisChat_39ba8155:

    # lis "¿Cómo nos deja este beso?"
    lis "Como esse beijo nos deixa?"

# game/scripts/c22/c22.rpy:4103
translate brazilian c22s007_LisChat_a3b100b9:

    # mc "A mí me ha dejado contento. *Risa* Y con ganas de más."
    mc "Estou feliz com isso. *Risos* E quero mais."

# game/scripts/c22/c22.rpy:4105
translate brazilian c22s007_LisChat_1a94f17b:

    # lis "Pero... ¿significa que estamos saliendo juntos? ¿Que soy tu...?"
    lis "Mas... isso significa que estamos namorando? Que eu sou seu/sua...?"

# game/scripts/c22/c22.rpy:4106
translate brazilian c22s007_LisChat_0d948812:

    # mc "¡No digas esa palabra! *Risa* Significa que los dos hemos querido besarnos. Y que si quieres que seamos algo más que amigos, habrá más besos."
    mc "Não diga essa palavra! *Risos* Significa que nós dois queríamos nos beijar. E se você quiser que sejamos mais do que amigos, haverá mais beijos."

# game/scripts/c22/c22.rpy:4108
translate brazilian c22s007_LisChat_a6efa58a:

    # lis "No sé qué responder a eso... pero sí cómo responder."
    lis "Não sei o que responder a isso... mas sei como responder."

# game/scripts/c22/c22.rpy:4110
translate brazilian c22s007_LisChat_ead45daf:

    # "La boca de [lis] dice lo que sus palabras no pueden."
    "A boca de [lis] diz o que suas palavras não conseguem."

# game/scripts/c22/c22.rpy:4111
translate brazilian c22s007_LisChat_5d99b787:

    # "La princesa se pasa los siguientes minutos hablando en silencio."
    "A princesa passa os minutos seguintes falando em silêncio."

# game/scripts/c22/c22.rpy:4112
translate brazilian c22s007_LisChat_2f3b75dc:

    # "Usa sus labios para dibujar el contorno de tu boca mientras su lengua empieza una larga amistad con la tuya."
    "Ele usa os lábios para traçar o contorno da sua boca enquanto a língua dele inicia uma longa amizade com a sua."

# game/scripts/c22/c22.rpy:4113
translate brazilian c22s007_LisChat_a468a431:

    # "Ahora es tu princesa."
    "Agora ela é sua princesa."

# game/scripts/c22/c22.rpy:4115
translate brazilian c22s007_LisChat_a6d824d6:

    # "Pasan varios minutos antes de que vuelvas a tu habitación con una sonrisa en la cara."
    "Passam-se alguns minutos antes de você retornar ao seu quarto com um sorriso no rosto."

# game/scripts/c22/c22.rpy:4116
translate brazilian c22s007_LisChat_120e4acd:

