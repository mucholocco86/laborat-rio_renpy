    # mom "Si no te importa, voy a volver con [sca] antes de que la abrumen demasiado."
    mom "Se não se importar, vou voltar para [sca] antes que ela fique muito sobrecarregada."

# game/scripts/c22/c22.rpy:3100
translate brazilian c22s004_MarChat_65eba579:

