# game/scripts/c22/c22.rpy:1836
translate brazilian c22s003_AmaCalls_1e3e6765:

    # ama "Aunque le hicimos los primeros auxilios y lo evacuamos a Aruba en un avión medicalizado, no le han podido salvar el brazo."
    ama "Apesar de termos prestado os primeiros socorros e o termos evacuado para Aruba em um avião médico, não conseguiram salvar seu braço."

# game/scripts/c22/c22.rpy:1837
translate brazilian c22s003_AmaCalls_4e1bc8fc:

    # ama "[eva] le destrozó los nervios."
    ama "[eva] destruiu seus nervos."

# game/scripts/c22/c22.rpy:1838
translate brazilian c22s003_AmaCalls_c3dc8ad6:

    # mc "Pero eran los malos, no se debería sentir así. Nos salvasteis."
    mc "Mas eles eram os vilões, você não deveria se sentir assim. Você nos salvou."

# game/scripts/c22/c22.rpy:1840
translate brazilian c22s003_AmaCalls_74575155:

    # ama "[mc], parte del entrenamiento de los G lo hicieron [eva] y Diana. Conocíamos a los chicos desde que eran niños..."
    ama "[mc], parte do treinamento dos G foi feito por [eva] e Diana. Conhecíamos os meninos desde que eram crianças..."

# game/scripts/c22/c22.rpy:1841
translate brazilian c22s003_AmaCalls_c691fab9:

    # mc "Lo entiendo. ¿Cómo está ella?"
    mc "Entendo. Como ela está?"

# game/scripts/c22/c22.rpy:1843
translate brazilian c22s003_AmaCalls_5dae45bb:

    # ama "Muy jodida. Después de vaciar seis cargadores se ha metido en su habitación."
    ama "Ela está realmente perturbada. Depois de esvaziar seis revistas, ela foi para o quarto dela."

# game/scripts/c22/c22.rpy:1844
translate brazilian c22s003_AmaCalls_9d125419:

    # ama "No quiere hablar conmigo. Por eso te he llamado."
    ama "Ele não quer falar comigo. Por isso liguei para você."

# game/scripts/c22/c22.rpy:1845
translate brazilian c22s003_AmaCalls_8ac27694:

    # mc "¿Y cómo estás tú?"
    mc "E você, como está?"

# game/scripts/c22/c22.rpy:1847
translate brazilian c22s003_AmaCalls_55ed25ae:

    # ama "Jodida, pero menos. No lo conocía tanto como [eva], y no fui yo quien disparó."
    ama "Foi complicado, mas menos grave. Eu não o conhecia tão bem quanto [eva], e não fui eu quem atirou nele."

# game/scripts/c22/c22.rpy:1848
translate brazilian c22s003_AmaCalls_1450603d:

    # ama "[eva] es quién necesita hablar ahora mismo, no te preocupes por mí."
    ama "[eva] é quem precisa falar agora, não se preocupe comigo."

# game/scripts/c22/c22.rpy:1849
translate brazilian c22s003_AmaCalls_ae45af4c:

    # mc "¿Crees que va a querer hablar conmigo?"
    mc "Você acha que ele vai querer falar comigo?"

# game/scripts/c22/c22.rpy:1851
translate brazilian c22s003_AmaCalls_ac09df05:

    # ama "Hasta cierto punto representas la razón por la que disparó."
    ama "Em certa medida, você representa o motivo pelo qual ele atirou."

# game/scripts/c22/c22.rpy:1852
translate brazilian c22s003_AmaCalls_f4956f9a:

    # ama "No por ti. Por la familia."
    ama "Não para você. Para a família."

# game/scripts/c22/c22.rpy:1853
translate brazilian c22s003_AmaCalls_93f7def9:

    # ama "Una familia que ni siquiera sabíamos que teníamos por entonces."
    ama "Uma família que nem sabíamos que tínhamos naquela época."

# game/scripts/c22/c22.rpy:1855
translate brazilian c22s003_AmaCalls_cc0a482f:

    # mc "Lo entiendo. Déjame intentarlo. Sólo espero que no me dispare."
    mc "Entendo. Deixe-me tentar. Só espero que ele não atire em mim."

# game/scripts/c22/c22.rpy:1858
translate brazilian c22s003_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c22/c22.rpy:1860
translate brazilian c22s003_AmaCalls_7ee1cfab:

    # mc "[eva], soy yo. ¿Puedo pasar?"
    mc "[eva], sou eu. Posso entrar?"

# game/scripts/c22/c22.rpy:1861
translate brazilian c22s003_AmaCalls_913eaf57:

    # eva "*A través de la puerta* ¡No!"
    eva "*Pela porta* Não!"

# game/scripts/c22/c22.rpy:1862
translate brazilian c22s003_AmaCalls_35a4914f:

    # mc "No me voy a ir a menos que salgas con un arma y me eches."
    mc "Eu não vou embora a menos que você apareça com uma arma e me expulse à força."

# game/scripts/c22/c22.rpy:1863
translate brazilian c22s003_AmaCalls_96b3f929:

    # eva "*A través de la puerta* No quiero ver a nadie, [mc]."
    eva "*Pela porta* Não quero ver ninguém, [mc]."

# game/scripts/c22/c22.rpy:1864
translate brazilian c22s003_AmaCalls_be088dc4:

    # mc "OK. Me voy."
    mc "Certo. Estou indo embora."

# game/scripts/c22/c22.rpy:1865
translate brazilian c22s003_AmaCalls_1d338278:

    # eva "*A través de la puerta* Gracias por entenderlo, [mc]."
    eva "*Pela porta* Obrigado pela compreensão, [mc]."

# game/scripts/c22/c22.rpy:1867
translate brazilian c22s003_AmaCalls_efd3647b:

    # "Esperas un minuto al lado de la puerta antes de volver a llamar."
    "Você espera um minuto junto à porta antes de bater novamente."

# game/scripts/c22/c22.rpy:1869
translate brazilian c22s003_AmaCalls_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c22/c22.rpy:1870
translate brazilian c22s003_AmaCalls_7bb8904d:

    # "No hay respuesta."
    "Não há resposta."

# game/scripts/c22/c22.rpy:1872
translate brazilian c22s003_AmaCalls_dd0461ef_2:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c22/c22.rpy:1873
translate brazilian c22s003_AmaCalls_003de099:

    # eva "*A través de la puerta* ¡Vete, [ama]!"
    eva "*Pela porta* Vá embora, [ama]!"

# game/scripts/c22/c22.rpy:1874
translate brazilian c22s003_AmaCalls_e2696b73:

    # mc "*Cambiando la voz* Traigo una entrega para la Srta. [eva] Gilford."
    mc "*Mudando a voz* Tenho uma entrega para a Srta. Gilford."

# game/scripts/c22/c22.rpy:1875
translate brazilian c22s003_AmaCalls_357dc4bd:

    # eva "*A través de la puerta* [mc], no estoy de humor para bromas."
    eva "*Pela porta* [mc], não estou com paciência para piadas."

# game/scripts/c22/c22.rpy:1876
translate brazilian c22s003_AmaCalls_8c2a994e:

    # mc "*Cambiando la voz* Es un abrazo del Sr. [mc] Marks."
    mc "*Mudando a voz* É um abraço do Sr. [mc] Marks."

# game/scripts/c22/c22.rpy:1877
translate brazilian c22s003_AmaCalls_03d54948:

    # "Pasan unos segundos sin que se oiga nada."
    "Passam-se alguns segundos sem qualquer som."

# game/scripts/c22/c22.rpy:1878
translate brazilian c22s003_AmaCalls_163cb1f9:

    # eva "*A través de la puerta* Pasa..."
    eva "*Pela porta* Entre..."

# game/scripts/c22/c22.rpy:1880
translate brazilian c22s003_AmaCalls_a9487c9a:

    # mc "¿Cómo estás?"
    mc "Como vai você?"

# game/scripts/c22/c22.rpy:1881
translate brazilian c22s003_AmaCalls_95e2709c:

    # eva "Queriendo estar sola, pero no me dejáis."
    eva "Quero ficar sozinha, mas você não me deixa."

# game/scripts/c22/c22.rpy:1882
translate brazilian c22s003_AmaCalls_c200bccf:

    # mc "¿Quieres ese abrazo?"
    mc "Você quer esse abraço?"

# game/scripts/c22/c22.rpy:1884
translate brazilian c22s003_AmaCalls_fa05883a:

    # eva "Te he dicho que no estoy de humor para bromas, [mc]."
    eva "Eu te disse que não estou com vontade de piadas, [mc]."

# game/scripts/c22/c22.rpy:1885
translate brazilian c22s003_AmaCalls_3a76a33d:

    # eva "No quiero ponerme borde o maleducada, pero no es el mejor momento."
    eva "Não quero ser rude ou indelicado, mas este não é o melhor momento."

# game/scripts/c22/c22.rpy:1886
translate brazilian c22s003_AmaCalls_26e320bf:

    # mc "OK. Te entiendo."
    mc "OK. Entendi."

# game/scripts/c22/c22.rpy:1887
translate brazilian c22s003_AmaCalls_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Você se importa se eu me sentar?"

# game/scripts/c22/c22.rpy:1889
translate brazilian c22s003_AmaCalls_1efe5fbb:

    # eva "Lo vas a hacer quiera o no quiera yo, ¿verdad?"
    eva "Você vai fazer isso quer eu goste ou não, certo?"

# game/scripts/c22/c22.rpy:1890
translate brazilian c22s003_AmaCalls_494a6419:

    # mc "Sí."
    mc "Sim."

# game/scripts/c22/c22.rpy:1891
translate brazilian c22s003_AmaCalls_97a257c1:

    # eva "Entonces siéntate."
    eva "Então sente-se."

# game/scripts/c22/c22.rpy:1893
translate brazilian c22s003_AmaCalls_13d27f07:

    # "Te sientas en silencio durante un rato, mirándola, contagiándote de su tristeza."
    "Você fica sentado em silêncio por um tempo, olhando para ela, percebendo sua tristeza."

# game/scripts/c22/c22.rpy:1894
translate brazilian c22s003_AmaCalls_8ddd4361:

    # "No puedes sentirlo por Gavin más allá de que sea una persona que ha perdido un brazo. Una persona que ahora es tu responsabilidad."
    "Você não consegue sentir nada por Gavin além do fato de ele ser uma pessoa que perdeu um braço. Uma pessoa que agora está sob sua responsabilidade."

# game/scripts/c22/c22.rpy:1895
translate brazilian c22s003_AmaCalls_b5ce6cb1:

    # "Entraron en casa de tu familia y os amenazaron. Pusieron en peligro a [nor], [bet] y [mee]."
    "Eles invadiram a casa da sua família e ameaçaram você. Eles colocaram em perigo [nor], [bet] e [mee]."

# game/scripts/c22/c22.rpy:1896
translate brazilian c22s003_AmaCalls_478e5cdb:

    # "Ahora conoces su historia a través de las historias de [eva] y [ama]. Notas algo de empatía hacia él creciendo en ti."
    "Agora você conhece a história dele através das histórias de [eva] e [ama]. Você percebe que uma certa empatia por ele está crescendo dentro de você."

# game/scripts/c22/c22.rpy:1897
translate brazilian c22s003_AmaCalls_733dfc17:

    # "Pero lo que te está rompiendo el alma es ver a [eva]."
    "Mas o que está partindo seu coração é ver [eva]."

# game/scripts/c22/c22.rpy:1898
translate brazilian c22s003_AmaCalls_485bae61:

    # "Ver cómo juega con Fee mientras las lágrimas están a punto de asomar a sus ojos."
    "Observá-lo brincar com Fee enquanto as lágrimas começam a brotar em seus olhos."

# game/scripts/c22/c22.rpy:1899
translate brazilian c22s003_AmaCalls_d38b993d:

    # "Decides levantarte."
    "Você decide se levantar."

# game/scripts/c22/c22.rpy:1901
translate brazilian c22s003_AmaCalls_355187ae:

    # eva "¿Ya te vas?"
    eva "Você já vai embora?"

# game/scripts/c22/c22.rpy:1903
translate brazilian c22s003_AmaCalls_ed54cc7a:

    # mc "No, no te vas a librar tan rápido de mí."
    mc "Não, você não vai se livrar de mim tão facilmente."

# game/scripts/c22/c22.rpy:1906
translate brazilian c22s003_AmaCalls_cda63e2d:

    # mc "El abrazo que traía estaba a punto de caducar."
    mc "O abraço que eu lhe dei estava prestes a acabar."

# game/scripts/c22/c22.rpy:1908
translate brazilian c22s003_AmaCalls_c25fedb0:

    # eva "Gracias..."
    eva "Obrigado..."

# game/scripts/c22/c22.rpy:1909
translate brazilian c22s003_AmaCalls_4559c981:

    # "Os pasáis un rato abrazados en silencio antes de que [eva] diga algo."
    "Vocês passam um tempo se abraçando em silêncio antes de [eva] dizer qualquer coisa."

# game/scripts/c22/c22.rpy:1911
translate brazilian c22s003_AmaCalls_742528ea:

    # eva "No te vas a ir hasta que hable contigo de lo que me pasa, ¿verdad?"
    eva "Você não vai embora até que eu fale com você sobre o que está errado, vai?"

# game/scripts/c22/c22.rpy:1912
translate brazilian c22s003_AmaCalls_bfbddfc6:

    # mc "Yo solo estoy disfrutando del abrazo. Si quieres hablar de ello, habla. Si no quieres, podemos seguir en silencio."
    mc "Estou apenas curtindo o abraço. Se você quiser conversar sobre isso, fique à vontade. Se não quiser, podemos continuar em silêncio."

# game/scripts/c22/c22.rpy:1913
translate brazilian c22s003_AmaCalls_f60662ab:

    # mc "No me voy a ir a ninguna parte. Ni ahora ni nunca."
    mc "Não vou a lugar nenhum. Nem agora, nem nunca."

# game/scripts/c22/c22.rpy:1915
translate brazilian c22s003_AmaCalls_bb5ca692:

    # eva "Es que no lo vas a entender..."
    eva "Você simplesmente não vai entender..."

# game/scripts/c22/c22.rpy:1916
translate brazilian c22s003_AmaCalls_3eeb4099:

    # mc "Dame una oportunidad. No soy tan tonto como parezco."
    mc "Me dê uma chance. Eu não sou tão estúpido quanto pareço."

# game/scripts/c22/c22.rpy:1917
translate brazilian c22s003_AmaCalls_c9516075:

    # mc "Al menos a veces..."
    mc "Pelo menos às vezes..."

# game/scripts/c22/c22.rpy:1919
translate brazilian c22s003_AmaCalls_641085b4:

    # eva "*Risa triste* Sólo a veces..."
    eva "*Risada triste* Só às vezes..."

# game/scripts/c22/c22.rpy:1920
translate brazilian c22s003_AmaCalls_e634a4df:

    # mc "Bueno, alguna que otra vez. Ahora he sido tan listo como para conseguir entrar en tu fortaleza. *Risa*"
    mc "Bem, de vez em quando. Agora fui esperto o suficiente para entrar na sua fortaleza. *Risos*"

# game/scripts/c22/c22.rpy:1922
translate brazilian c22s003_AmaCalls_c73f839f:

    # eva "En más de un sentido..."
    eva "Em mais de um sentido..."

# game/scripts/c22/c22.rpy:1923
translate brazilian c22s003_AmaCalls_628758e0:

    # eva "No sé qué tienes, pero haces que la gente se sienta cómoda hablando."
    eva "Não sei o que você tem, mas você faz as pessoas se sentirem à vontade para conversar."

# game/scripts/c22/c22.rpy:1924
translate brazilian c22s003_AmaCalls_92a69b0a:

    # mc "Será mi don de gentes. A veces puedo ser encantador."
    mc "Deve ser minha habilidade de lidar com pessoas. Às vezes, consigo ser encantador."

# game/scripts/c22/c22.rpy:1926
translate brazilian c22s003_AmaCalls_e112eb74:

    # eva "Gavin ha perdido el brazo, aunque supongo que [ama] ya te lo ha contado."
    eva "Gavin perdeu o braço, embora eu suponha que [ama] já tenha te contado."

# game/scripts/c22/c22.rpy:1927
translate brazilian c22s003_AmaCalls_36f66786:

    # mc "Sí, me lo ha contado."
    mc "Sim, ele me disse."

# game/scripts/c22/c22.rpy:1929
translate brazilian c22s003_AmaCalls_d5ee0b2a:

    # eva "Si hubiera apuntado un par de centímetros a la derecha no hubiera pasado."
    eva "Se eu tivesse mirado alguns centímetros para a direita, não teria passado."

# game/scripts/c22/c22.rpy:1930
translate brazilian c22s003_AmaCalls_e4a5b722:

    # mc "Y si no hubieras disparado, te hubiera disparado él."
    mc "E se você não tivesse atirado, ele teria atirado em você."

# game/scripts/c22/c22.rpy:1932
translate brazilian c22s003_AmaCalls_c4752d40:

    # eva "Gavin tenía la puntería de un stormtrooper. Nunca conseguí que mejorara."
    eva "Gavin tinha a mira de um stormtrooper. Nunca consegui fazê-lo melhorar."

# game/scripts/c22/c22.rpy:1933
translate brazilian c22s003_AmaCalls_a438d52d:

    # eva "Sin embargo, era bueno en el cuerpo a cuerpo."
    eva "No entanto, ele era bom em combate corpo a corpo."

# game/scripts/c22/c22.rpy:1934
translate brazilian c22s003_AmaCalls_1ac56caf:

    # mc "¿Lo conocías mucho? Me refiero aparte del entrenamiento."
    mc "Você o conhecia bem? Quero dizer, além do período de treino."

# game/scripts/c22/c22.rpy:1936
translate brazilian c22s003_AmaCalls_a99858d6:

    # eva "Imagínate convivir con 500 personas las 24 horas del día durante 19 años. Cuando no estábamos en misiones, claro."
    eva "Imagine viver com 500 pessoas 24 horas por dia durante 19 anos. Isso quando não estávamos em missão, é claro."

# game/scripts/c22/c22.rpy:1937
translate brazilian c22s003_AmaCalls_1f00698f:

    # eva "Doce o trece años en el caso de los G. Sí, nos conocíamos. No, no éramos amigos, pero nos llevábamos bien."
    eva "Doze ou treze anos, no caso dos Gs. Sim, nos conhecíamos. Não, não éramos amigos, mas nos dávamos bem."

# game/scripts/c22/c22.rpy:1938
translate brazilian c22s003_AmaCalls_ccb3b460:

    # mc "Entiendo..."
    mc "Eu entendo..."

# game/scripts/c22/c22.rpy:1940
translate brazilian c22s003_AmaCalls_1aa524a0:

    # eva "No, [mc]. No lo puedes entender. Tenía mis órdenes y las cumplí. Y alguien salió herido en el proceso. Irreversiblemente."
    eva "Não, [mc]. Você não consegue entender. Eu recebi ordens e as cumpri. E alguém se feriu no processo. Irreversivelmente."

# game/scripts/c22/c22.rpy:1941
translate brazilian c22s003_AmaCalls_ebbc4e6f:

    # eva "Pero conocía a ese alguien."
    eva "Mas eu conhecia essa pessoa."

# game/scripts/c22/c22.rpy:1942
translate brazilian c22s003_AmaCalls_f3bec387:

    # eva "He matado a gente, [mc]. Soy una puta asesina. Pero nunca había hecho daño a alguien a quien conociera."
    eva "Eu matei pessoas, [mc]. Eu sou um assassino do caralho. Mas eu nunca machuquei ninguém que eu conhecia."

# game/scripts/c22/c22.rpy:1943
translate brazilian c22s003_AmaCalls_c8af1e5d:

    # eva "O a alguien que no se lo mereciera."
    eva "Ou para alguém que não merecia."

# game/scripts/c22/c22.rpy:1944
translate brazilian c22s003_AmaCalls_775b3eb4:

    # mc "¿Nunca?"
    mc "Nunca?"

# game/scripts/c22/c22.rpy:1946
translate brazilian c22s003_AmaCalls_41fe9448:

    # eva "No así, al menos."
    eva "Não dessa forma, pelo menos."

# game/scripts/c22/c22.rpy:1947
translate brazilian c22s003_AmaCalls_bff6921b:

    # eva "Tu primer domingo aquí, evité que otro serie G os matara, en el bosque."
    eva "No seu primeiro domingo aqui, eu impedi que outro cara da série G te matasse na floresta."

# game/scripts/c22/c22.rpy:1948
translate brazilian c22s003_AmaCalls_316ec7e7:

    # mc "¿Cuando estaba con [eil]?"
    mc "Quando eu estive com [eil]?"

# game/scripts/c22/c22.rpy:1950
translate brazilian c22s003_AmaCalls_490e543a:

    # eva "No, mientras vosotros comíais en casa. En el bosque estábamos él y yo. Él tenía un rifle de francotirador."
    eva "Não, enquanto você jantava em casa. Estávamos só nós dois na floresta. Ele tinha um rifle de precisão."

# game/scripts/c22/c22.rpy:1951
translate brazilian c22s003_AmaCalls_9c3c9f68:

    # eva "Sólo necesité un disparo de advertencia para que Gustav bajara el arma y pudiera apresarlo y traerlo a la base."
    eva "Bastou um único tiro de advertência para que Gustav baixasse a arma, o que me permitiu prendê-lo e levá-lo de volta à base."

# game/scripts/c22/c22.rpy:1952
translate brazilian c22s003_AmaCalls_1cd0c3fa:

    # eva "Aparte de un ataque de nervios, no recibió más daños."
    eva "Além de um colapso nervoso, ela não sofreu mais nenhum dano."

# game/scripts/c22/c22.rpy:1953
translate brazilian c22s003_AmaCalls_a1555d01:

    # mc "No sé cómo darte las gracias por eso..."
    mc "Não sei como te agradecer por isso..."

# game/scripts/c22/c22.rpy:1955
translate brazilian c22s003_AmaCalls_6e623447:

    # eva "No hace falta que me las des. Eran mis órdenes. No lo hacía por ti, ni por la familia."
    eva "Você não precisa me entregar isso. Foram ordens minhas. Eu não estava fazendo isso por você, nem pela família."

# game/scripts/c22/c22.rpy:1956
translate brazilian c22s003_AmaCalls_ef009b77:

    # eva "No erais nuestra familia aún. Ni siquiera lo erais el día del secuestro."
    eva "Vocês ainda não eram da nossa família. Nem mesmo no dia do sequestro vocês eram da família."

# game/scripts/c22/c22.rpy:1957
translate brazilian c22s003_AmaCalls_9d40879e:

    # mc "Lo sé..."
    mc "Eu sei..."

# game/scripts/c22/c22.rpy:1959
translate brazilian c22s003_AmaCalls_44489a93:

    # eva "Nunca he estado en las circunstancias en las que estuvieron Beatrice, Claire, o Diana."
    eva "Eu nunca estive nas circunstâncias em que Beatrice, Claire ou Diana estiveram."

# game/scripts/c22/c22.rpy:1960
translate brazilian c22s003_AmaCalls_3cda6ecc:

    # eva "Nunca tuve que luchar por mi vida contra nuestra gente."
    eva "Eu nunca precisei lutar pela minha vida contra o nosso povo."

# game/scripts/c22/c22.rpy:1961
translate brazilian c22s003_AmaCalls_c8563811:

    # eva "Y la primera vez que lo hago, alguien sale herido."
    eva "E na primeira vez que faço isso, alguém se machuca."

# game/scripts/c22/c22.rpy:1962
translate brazilian c22s003_AmaCalls_93eff6a9:

    # mc "Ellos querían hacernos daño, [eva]."
    mc "Eles queriam nos machucar, [eva]."

# game/scripts/c22/c22.rpy:1964
translate brazilian c22s003_AmaCalls_1aa74c76:

    # eva "Lo sé. Y Eric nos hubiese matado si hubiera tenido la oportunidad, como hicieron con mis hermanas."
    eva "Eu sei. E Eric teria nos matado se tivesse tido a chance, assim como fizeram com minhas irmãs."

# game/scripts/c22/c22.rpy:1965
translate brazilian c22s003_AmaCalls_b625d932:

    # eva "Pero Gavin no. Gavin estaba ahí cumpliendo órdenes. Igual que yo. Y no se merecía acabar así..."
    eva "Mas não Gavin. Gavin estava lá cumprindo ordens. Assim como eu. E ele não merecia terminar assim..."

# game/scripts/c22/c22.rpy:1966
translate brazilian c22s003_AmaCalls_61e87c1d:

    # mc "No quiero sonar insensible, pero prefiero que sea él quien haya acabado así en vez de ser tú."
    mc "Não quero parecer insensível, mas preferiria que fosse ele a acabar assim do que você."

# game/scripts/c22/c22.rpy:1968
translate brazilian c22s003_AmaCalls_7b8f7b14:

    # eva "Gracias. Yo... Gracias..."
    eva "Obrigado. Eu... Obrigado..."

# game/scripts/c22/c22.rpy:1970
translate brazilian c22s003_AmaCalls_26d2f151:

    # eva "No te puedes imaginar lo complicado que es todo en mi cabeza."
    eva "Você não imagina o quão complicado tudo é na minha cabeça."

# game/scripts/c22/c22.rpy:1971
translate brazilian c22s003_AmaCalls_9468925e:

    # eva "He herido a una persona a la que aprecio por salvar a una familia a la que quiero."
    eva "Eu magoei alguém de quem gosto para salvar uma família que amo."

# game/scripts/c22/c22.rpy:1972
translate brazilian c22s003_AmaCalls_6a058b62:

    # eva "No sé qué le voy a decir la próxima vez que le vea..."
    eva "Não sei o que vou dizer a ele na próxima vez que o vir..."

# game/scripts/c22/c22.rpy:1973
translate brazilian c22s003_AmaCalls_e2c467b9:

    # mc "Los dos cumplíais órdenes, y tú estabas en el bando ganador."
    mc "Vocês dois estavam seguindo ordens e estavam do lado vencedor."

# game/scripts/c22/c22.rpy:1974
translate brazilian c22s003_AmaCalls_b201a47a:

    # mc "Tú hiciste que ese bando ganara."
    mc "Você fez aquele lado vencer."

# game/scripts/c22/c22.rpy:1976
translate brazilian c22s003_AmaCalls_7f51842a:

    # eva "Pero no se tenía que haber llegado a esto. Ha muerto gente en esta guerra clon. Mis hermanas."
    eva "Mas não deveria ter chegado a este ponto. Pessoas morreram nesta guerra de clones. Minhas irmãs."

# game/scripts/c22/c22.rpy:1977
translate brazilian c22s003_AmaCalls_5ef9f1ea:

    # eva "Gavin ha perdido el brazo..."
    eva "Gavin perdeu o braço..."

# game/scripts/c22/c22.rpy:1978
translate brazilian c22s003_AmaCalls_865d5e8f:

    # mc "Y Eric los dientes..."
    mc "E os dentes do Eric..."

# game/scripts/c22/c22.rpy:1980
translate brazilian c22s003_AmaCalls_50c59d76:

    # eva "Eric es quien menos me importa. Los E tenían una vena cruel."
    eva "Eric é de quem menos gosto. Os E's tinham um lado cruel."

# game/scripts/c22/c22.rpy:1981
translate brazilian c22s003_AmaCalls_73caf2a5:

    # mc "¿Clonamos dientes en NTR? *Risa*"
    mc "Será que clonamos dentes na NTR? *Risos*"

# game/scripts/c22/c22.rpy:1983
translate brazilian c22s003_AmaCalls_edbc953c:

    # eva "*Risa triste* No, y tampoco brazos."
    eva "*Risada triste* Não, e nem os braços."

# game/scripts/c22/c22.rpy:1984
translate brazilian c22s003_AmaCalls_f8af6c01:

    # eva "¿Qué va a hacer ahora?"
    eva "O que ele vai fazer agora?"

# game/scripts/c22/c22.rpy:1985
translate brazilian c22s003_AmaCalls_0dae425a:

    # mc "Supongo que le podemos buscar un puesto donde siga siendo útil con un solo brazo y donde se sienta a gusto."
    mc "Imagino que possamos encontrar para ele uma posição em que ele ainda possa ser útil com apenas um braço e em que se sinta confortável."

# game/scripts/c22/c22.rpy:1986
translate brazilian c22s003_AmaCalls_283db93c:

    # mc "Ahora soy su jefe y una de las cosas que debe hacer un jefe es conseguir sacar el mejor partido de sus empleados."
    mc "Agora eu sou seu chefe e uma das coisas que um chefe deve fazer é extrair o melhor de seus funcionários."

# game/scripts/c22/c22.rpy:1988
translate brazilian c22s003_AmaCalls_19b090fc:

    # eva "No sé qué podría hacer con un solo brazo, la verdad..."
    eva "Sinceramente, não sei o que eu poderia fazer com apenas um braço..."

# game/scripts/c22/c22.rpy:1989
translate brazilian c22s003_AmaCalls_f1281ea7:

    # eva "No sé qué podría hacer yo si sólo tuviera un brazo."
    eva "Não sei o que eu poderia fazer se tivesse apenas um braço."

# game/scripts/c22/c22.rpy:1990
translate brazilian c22s003_AmaCalls_4f0f86a0:

    # mc "Seguramente patearías culos con un solo brazo, pero ¿sabes una cosa?"
    mc "Você provavelmente conseguiria dar uma surra em qualquer um com um braço só, mas sabe de uma coisa?"

# game/scripts/c22/c22.rpy:2011
translate brazilian c22s004_EveRoute_2be0c5eb:

    # eva "¿Qué? ¿Pareja? ¿Como si fuera tu novia?"
    eva "O quê? Uma parceira? Tipo, ela é sua namorada?"

# game/scripts/c22/c22.rpy:2012
translate brazilian c22s004_EveRoute_0d9c3d27:

    # mcp "(¡Por Dios! ¡Cómo odio esa palabra!)"
    mcp "(Meu Deus! Como eu detesto essa palavra!)"

# game/scripts/c22/c22.rpy:2013
translate brazilian c22s004_EveRoute_61ca86f1:

    # mc "Sí, he dicho pareja. Como si fueras novia. ¿Demasiados disparos están afectando a tu audición?"
    mc "Sim, eu disse parceira. Como se você fosse minha namorada. Muitos tiros estão afetando sua audição?"

# game/scripts/c22/c22.rpy:2015
translate brazilian c22s004_EveRoute_8e994c1b:

    # "[eva] salta como impulsada por un muelle."
    "[eva] salta como se impulsionado por uma mola."

# game/scripts/c22/c22.rpy:2016
translate brazilian c22s004_EveRoute_351f6459:

    # eva "¿Me estás tomando el pelo?"
    eva "Você está brincando comigo?"

# game/scripts/c22/c22.rpy:2017
translate brazilian c22s004_EveRoute_fca52711:

    # mc "No."
    mc "Não."

# game/scripts/c22/c22.rpy:2019
translate brazilian c22s004_EveRoute_b4a622fd:

    # eva "¿Lo estás haciendo porque te doy pena?"
    eva "Você está fazendo isso porque sente pena de mim?"

# game/scripts/c22/c22.rpy:2020
translate brazilian c22s004_EveRoute_fca52711_1:

    # mc "No."
    mc "Não."

# game/scripts/c22/c22.rpy:2022
translate brazilian c22s004_EveRoute_226cf3ff:

    # eva "¿Entonces por qué? ¿Por qué ahora?"
    eva "Então por quê? Por que agora?"

# game/scripts/c22/c22.rpy:2023
translate brazilian c22s004_EveRoute_00da5eaf:

    # mc "Porque me gustas desde que te conocí... más o menos."
    mc "Porque eu gosto de você desde que te conheci... mais ou menos."

# game/scripts/c22/c22.rpy:2024
translate brazilian c22s004_EveRoute_83dd1981:

    # mc "Y porque ahora [ama] y tú habéis arreglado vuestras diferencias."
    mc "E porque agora [ama] e você resolveram suas diferenças."

# game/scripts/c22/c22.rpy:2025
translate brazilian c22s004_EveRoute_01dfadaf:

    # mc "¿No puedes aceptar una buena noticia cuando la escuchas? O lo que para ti es una buena noticia..."
    mc "Você não consegue aceitar boas notícias quando as ouve? Ou o que para você é uma boa notícia...?"

# game/scripts/c22/c22.rpy:2027
translate brazilian c22s004_EveRoute_125ce26d:

    # eva "¿Y [ama]?"
    eva "E [ama]?"

# game/scripts/c22/c22.rpy:2028
translate brazilian c22s004_EveRoute_e8df90f5:

    # mc "[ama] no tiene nada que ver con lo que hagamos tú y yo."
    mc "[ama] não tem nada a ver com o que você e eu fazemos."

# game/scripts/c22/c22.rpy:2029
translate brazilian c22s004_EveRoute_3b2521e3:

    # eva "¿Crees que se va a enfadar porque me hayas elegido a mí antes que a ella? También vas a querer salir con ella, ¿verdad?"
    eva "Você acha que ela vai ficar brava por você ter me escolhido em vez dela? Você também vai querer sair com ela, não é?"

# game/scripts/c22/c22.rpy:2030
translate brazilian c22s004_EveRoute_f150a240:

    # mcp "(No le ha dicho lo que pasó ayer en el café.)"
    mcp "(Ela não lhe contou o que aconteceu ontem no café.)"

# game/scripts/c22/c22.rpy:2031
translate brazilian c22s004_EveRoute_2833b24b:

    # mc "No, no creo que se enfade."
    mc "Não, não acho que ele ficará zangado."

# game/scripts/c22/c22.rpy:2032
translate brazilian c22s004_EveRoute_00c1bef0:

    # mc "Y no te tienes que preocupar por si salgo con ella o no. No sois un pack indivisible como los yogures."
    mc "E você não precisa se preocupar se eu saio com ela ou não. Você não é um pacote inseparável como iogurte."

# game/scripts/c22/c22.rpy:2034
translate brazilian c22s004_EveRoute_c7fac3f2:

    # eva "Pero..."
    eva "Mas..."

# game/scripts/c22/c22.rpy:2035
translate brazilian c22s004_EveRoute_215caa51:

    # mc "Yo esperaba un beso en vez de un interrogatorio."
    mc "Eu esperava um beijo em vez de um interrogatório."

# game/scripts/c22/c22.rpy:2037
translate brazilian c22s004_EveRoute_cafec592:

    # "La asesina pelirroja se lanza hacia ti, tumbándote en el arcón, y empieza a recorrer tus labios con ansia."
    "A assassina ruiva se atira sobre você, derrubando-a no peito, e começa a traçar seus lábios com avidez."

# game/scripts/c22/c22.rpy:2038
translate brazilian c22s004_EveRoute_161d4452:

    # "Y mucha más torpeza de la que hubieras esperado."
    "E muito mais desajeitado do que você poderia esperar."

# game/scripts/c22/c22.rpy:2040
translate brazilian c22s004_EveRoute_34f26697:

    # eva "¿Contento?"
    eva "Alegre?"

# game/scripts/c22/c22.rpy:2041
translate brazilian c22s004_EveRoute_a0adf509:

    # mc "Sí. ¿Y tú?"
    mc "Sim, e você?"

# game/scripts/c22/c22.rpy:2043
translate brazilian c22s004_EveRoute_6fff242d:

    # eva "Ermmm... Sí..."
    eva "Hum... Sim..."

# game/scripts/c22/c22.rpy:2044
translate brazilian c22s004_EveRoute_00731f2d:

    # mc "No creo que estés muy convencida."
    mc "Acho que você não está muito convencido."

# game/scripts/c22/c22.rpy:2046
translate brazilian c22s004_EveRoute_6b8aa6b2:

    # eva "Me siento rara... hace unos minutos tenía ganas de llorar."
    eva "Estou me sentindo estranha... há alguns minutos eu estava com vontade de chorar."

# game/scripts/c22/c22.rpy:2047
translate brazilian c22s004_EveRoute_37b4782c:

    # eva "Ahora tengo ganas de reír. Y de llorar a la vez..."
    eva "Agora me dá vontade de rir. E de chorar ao mesmo tempo..."

# game/scripts/c22/c22.rpy:2048
translate brazilian c22s004_EveRoute_39b5f54e:

    # mc "Supongo que estás en medio de una montaña rusa emocional."
    mc "Imagino que você esteja passando por uma montanha-russa emocional."

# game/scripts/c22/c22.rpy:2050
translate brazilian c22s004_EveRoute_a9be9b21:

    # eva "Supongo... No sé cómo actuar ahora..."
    eva "Acho que... não sei como agir agora..."

# game/scripts/c22/c22.rpy:2051
translate brazilian c22s004_EveRoute_155a73b6:

    # mc "¿Qué tal un largo abrazo? No hace falta que digas nada si no quieres."
    mc "Que tal um longo abraço? Você não precisa dizer nada se não quiser."

# game/scripts/c22/c22.rpy:2053
translate brazilian c22s004_EveRoute_59a046a5:

    # eva "Creo que me puedo conformar con eso."
    eva "Acho que posso me contentar com isso."

# game/scripts/c22/c22.rpy:2054
translate brazilian c22s004_EveRoute_45a53858:

    # mc "*Risa* No sé si sentirme como que mis abrazos son un premio menor."
    mc "*Risos* Não sei se devo considerar meus abraços como um pequeno prêmio."

# game/scripts/c22/c22.rpy:2056
translate brazilian c22s004_EveRoute_f3211d1f:

    # eva "No te rías de mí. Lo que sí sé es que quiero tener una cita contigo."
    eva "Não ria de mim. O que eu sei é que quero sair num encontro com você."

# game/scripts/c22/c22.rpy:2057
translate brazilian c22s004_EveRoute_e2f99f94:

    # mc "¿Quieres que busque un sitio bonito?"
    mc "Você quer que eu encontre um lugar legal?"

# game/scripts/c22/c22.rpy:2059
translate brazilian c22s004_EveRoute_c7e6be72:

    # eva "No. Quiero planear la cita yo."
    eva "Não. Quero planejar o encontro eu mesma."

# game/scripts/c22/c22.rpy:2060
translate brazilian c22s004_EveRoute_f84ba5ae:

    # eva "Estoy segura de que has tenido mil citas y no quiero que sea como ninguna que hayas tenido con anterioridad."
    eva "Tenho certeza de que você já teve milhares de encontros, e não quero que este seja igual a nenhum outro que você já teve."

# game/scripts/c22/c22.rpy:2061
translate brazilian c22s004_EveRoute_2d00f394:

    # mc "Me parece bien. Sorpréndeme."
    mc "Isso me parece ótimo. Me surpreenda."

# game/scripts/c22/c22.rpy:2063
translate brazilian c22s004_EveRoute_7894efb0:

    # eva "¡Mierda!"
    eva "Merda!"

# game/scripts/c22/c22.rpy:2064
translate brazilian c22s004_EveRoute_788fe75f:

    # mc "¿Qué pasa, cielo?"
    mc "O que foi, querida?"

# game/scripts/c22/c22.rpy:2066
translate brazilian c22s004_EveRoute_0c0618a7:

    # eva "Se lo tengo que contar a [ama]. Ahora."
    eva "Tenho que contar [ama]. Agora."

# game/scripts/c22/c22.rpy:2067
translate brazilian c22s004_EveRoute_3ed89801:

    # eva "Levántate. Vamos a decírselo. No quiero que piense que se lo estamos ocultando."
    eva "Levanta. Vamos contar para ele. Não quero que ele pense que estamos escondendo isso dele."

# game/scripts/c22/c22.rpy:2068
translate brazilian c22s004_EveRoute_48688e12:

    # mc "*Risa* Lo de estar quieta disfrutando del abrazo no se te da muy bien. Vamos."
    mc "*Risos* Você não é muito bom em ficar parado e curtir o abraço. Vamos lá."

# game/scripts/c22/c22.rpy:2070
translate brazilian c22s004_EveRoute_f9704243:

    # eva "[ama], tenemos algo que decirte."
    eva "[ama], temos algo para lhe dizer."

# game/scripts/c22/c22.rpy:2072
translate brazilian c22s004_EveRoute_6cdbd57d:

    # ama "¿Te encuentras mejor?"
    ama "Você está se sentindo melhor?"

# game/scripts/c22/c22.rpy:2074
translate brazilian c22s004_EveRoute_db54e694:

    # eva "Mas o menos. Todavía me siento mal por Gavin..."
    eva "Mais ou menos. Ainda me sinto mal pelo Gavin..."

# game/scripts/c22/c22.rpy:2075
translate brazilian c22s004_EveRoute_b33399f4:

    # eva "Pero... queríamos decirte que..."
    eva "Mas... queríamos te contar que..."

# game/scripts/c22/c22.rpy:2077
translate brazilian c22s004_EveRoute_ac83c3e7:

    # eva "Ayúdame, [mc]..."
    eva "Ajude-me, [mc]..."

# game/scripts/c22/c22.rpy:2078
translate brazilian c22s004_EveRoute_fd12ea1d:

    # mc "Nope. Esto es algo que tienes que hacer tú."
    mc "Não. Isso é algo que você precisa fazer sozinho."

# game/scripts/c22/c22.rpy:2080
translate brazilian c22s004_EveRoute_a40c1f78:

    # eva "*Grrr* ¡Capullo!"
    eva "*Grrr* Idiota!"

# game/scripts/c22/c22.rpy:2081
translate brazilian c22s004_EveRoute_eef46fb8:

    # eva "¡Vale!"
    eva "OK!"

# game/scripts/c22/c22.rpy:2083
translate brazilian c22s004_EveRoute_98f390cb:

    # eva "¡[mc] y yo estamos saliendo juntos! Aunque no sé por qué salgo con capullos."
    eva "[mc] e eu estamos namorando! Embora eu não saiba por que namoro idiotas."

# game/scripts/c22/c22.rpy:2084
translate brazilian c22s004_EveRoute_c1284afa:

    # eva "¡Vamos a tener una cita!"
    eva "Vamos sair num encontro!"

# game/scripts/c22/c22.rpy:2086
translate brazilian c22s004_EveRoute_9e8efeb1:

    # eva "Y nos hemos besado..."
    eva "E nos beijamos..."

# game/scripts/c22/c22.rpy:2088
translate brazilian c22s004_EveRoute_bb654dc4:

    # ama "¡Eso es fantástico, [eva]!"
    ama "Isso é fantástico, [eva]!"

# game/scripts/c22/c22.rpy:2090
translate brazilian c22s004_EveRoute_90b2909c:

    # ama "Felicidades, [mc]. No podrías salir con nadie mejor."
    ama "Parabéns, [mc]. Você não poderia estar namorando ninguém melhor."

# game/scripts/c22/c22.rpy:2092
translate brazilian c22s004_EveRoute_f104a946:

    # eva "Ahora solo falta que se decida contigo."
    eva "Agora só falta ele decidir se quer ficar com você."

# game/scripts/c22/c22.rpy:2094
translate brazilian c22s004_EveRoute_9d066684:

    # eva "Obviamente, me ha elegido a mi primero, pero me gustaría que también tú pudieras salir con él."
    eva "Obviamente, ele me escolheu primeiro, mas eu gostaria que você também pudesse sair com ele."

# game/scripts/c22/c22.rpy:2096
translate brazilian c22s004_EveRoute_8f8d9b64:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego. *Risa mental*)"
    mcp "(Não sei o que ele está tramando, mas é melhor entrar na brincadeira. *Risos mentais*)"

# game/scripts/c22/c22.rpy:2098
translate brazilian c22s004_EveRoute_8ee39ad0:

    # ama "Aunque si [mc] quiere salir conmigo, sabe lo que yo pienso y lo puede decir {b}ahora mismo{/b}."
    ama "Embora se [mc] quiser sair comigo, ela sabe o que eu penso e pode dizer isso {b}agora mesmo{/b}."

# game/scripts/c22/c22.rpy:2099
translate brazilian c22s004_EveRoute_aa92414a:

    # mc "Me encantaría. Estar con las dos sería maravilloso."
    mc "Eu adoraria. Estar com os dois seria maravilhoso."

# game/scripts/c22/c22.rpy:2101
translate brazilian c22s004_EveRoute_cb287e39:

    # eva "¡Felicidades, [ama]!"
    eva "Parabéns, [ama]!"

# game/scripts/c22/c22.rpy:2102
translate brazilian c22s004_EveRoute_22901ee7:

    # eva "¡Nuestro primer novio oficial y lo compartimos!"
    eva "Nosso primeiro namorado oficial e estamos dividindo ele!"

# game/scripts/c22/c22.rpy:2103
translate brazilian c22s004_EveRoute_7d0ef333:

    # mc "¿Qué es eso del primer novio oficial?"
    mc "Que história é essa de primeiro namorado oficial?"

# game/scripts/c22/c22.rpy:2105
translate brazilian c22s004_EveRoute_7af743dd:

    # eva "En una misión en Budapest tuvimos que fingir que salíamos con dos operativos de la serie F."
    eva "Em uma missão em Budapeste, tivemos que fingir que estávamos saindo com dois agentes da série F."

# game/scripts/c22/c22.rpy:2106
translate brazilian c22s004_EveRoute_6cd56b27:

    # ama "Ellos se hacían pasar por gemelos ricos y nosotras por sus novias."
    ama "Eles fingiam ser gêmeos ricos e nós fingíamos ser suas namoradas."

# game/scripts/c22/c22.rpy:2108
translate brazilian c22s004_EveRoute_b68d22d1:

    # eva "¡Pero nunca pasó nada entre nosotros!"
    eva "Mas nunca aconteceu nada entre nós!"

# game/scripts/c22/c22.rpy:2109
translate brazilian c22s004_EveRoute_aa885f6b:

    # ama "Más allá de algún beso fingido."
    ama "Além de alguns beijos fingidos."

# game/scripts/c22/c22.rpy:2111
translate brazilian c22s004_EveRoute_4edb2e23:

    # eva "¡Oops! ¡Te he abrazado y no te he dejado besar a tu novio!"
    eva "Ops! Eu te abracei e não deixei você beijar seu namorado!"

# game/scripts/c22/c22.rpy:2112
translate brazilian c22s004_EveRoute_f1d23f62:

    # mcp "(Cada vez odio más la palabra. Pero en esto es como una niña, y necesita poner etiquetas.)"
    mcp "(Odeio essa palavra cada vez mais. Mas, neste caso, ela se comporta como uma criança e precisa rotular as coisas.)"

# game/scripts/c22/c22.rpy:2114
translate brazilian c22s004_EveRoute_648e3dbd:

    # ama "¿Puedo?"
    ama "Pode?"

# game/scripts/c22/c22.rpy:2115
translate brazilian c22s004_EveRoute_15025985:

    # eva "¡Di que sí!"
    eva "Diga sim!"

# game/scripts/c22/c22.rpy:2116
translate brazilian c22s004_EveRoute_a3a04cea:

    # ama "*Susurrando* Me da un poco de vergüenza delante de [eva]."
    ama "*Sussurrando* Eu me sinto um pouco envergonhado na frente de [eva]."

# game/scripts/c22/c22.rpy:2117
translate brazilian c22s004_EveRoute_6e49d741:

    # mc "Sólo hay una forma de superar la vergüenza, preciosa."
    mc "Só existe uma maneira de superar a vergonha, querida."

# game/scripts/c22/c22.rpy:2119
translate brazilian c22s004_EveRoute_069ebbec:

    # "Sin dejarle responder, tu boca se acerca a la suya y le das un tierno beso."
    "Sem deixá-lo responder, sua boca se aproxima da dele e você lhe dá um beijo terno."

# game/scripts/c22/c22.rpy:2120
translate brazilian c22s004_EveRoute_63fd7115:

    # "Ella responde de forma mucho menos apasionada que el día anterior en el café."
    "Ela responde de uma forma muito menos apaixonada do que no dia anterior, no café."

# game/scripts/c22/c22.rpy:2121
translate brazilian c22s004_EveRoute_bede44a2:

    # "La vergüenza es una barrera que le cuesta superar."
    "A vergonha é uma barreira que ela tem dificuldade em superar."

# game/scripts/c22/c22.rpy:2123
translate brazilian c22s004_EveRoute_57cd6c62:

    # mc "¿Bien?"
    mc "Bom?"

# game/scripts/c22/c22.rpy:2124
translate brazilian c22s004_EveRoute_350a7b0e:

    # ama "Bien."
    ama "Bom."

# game/scripts/c22/c22.rpy:2126
translate brazilian c22s004_EveRoute_cdfd0960:

    # eva "¿Bien? ¡Ha sido precioso!"
    eva "Bom? Foi maravilhoso!"

# game/scripts/c22/c22.rpy:2159
translate brazilian c22s004_EveRoute_2a8de6b7:

    # eva "¡Ha sido como cuando besa a las otras chicas!"
    eva "Foi exatamente como quando ele beija as outras garotas!"

# game/scripts/c22/c22.rpy:2162
translate brazilian c22s004_EveRoute_0ae1c79d:

    # eva "Ha sido como cuando besa a [gf]."
    eva "Foi como quando ele beija [gf]."

# game/scripts/c22/c22.rpy:2163
translate brazilian c22s004_EveRoute_29959d60:

    # mc "¿Cómo querías que fuera?"
    mc "Como você queria que fosse?"

# game/scripts/c22/c22.rpy:2165
translate brazilian c22s004_EveRoute_e662d2a0:

    # eva "No tengo ni idea... pero presenciar vuestro primer beso me ha hecho sentir especial."
    eva "Não faço ideia... mas presenciar seu primeiro beijo me fez sentir especial."

# game/scripts/c22/c22.rpy:2167
translate brazilian c22s004_EveRoute_acabbfe7:

    # eva "¡Tengo que irme!"
    eva "Tenho que ir!"

# game/scripts/c22/c22.rpy:2168
translate brazilian c22s004_EveRoute_a613997b:

    # mc "¿Dónde?"
    mc "Onde?"

# game/scripts/c22/c22.rpy:2169
translate brazilian c22s004_EveRoute_fa3e71ef:

    # eva "¡Tengo que poner un mensaje en el grupo de WhatsUp! ¡Quiero que todas sepan que las dos estamos contigo!"
    eva "Preciso postar uma mensagem no grupo do WhatsApp! Quero que todos saibam que estamos juntos com você!"

# game/scripts/c22/c22.rpy:2171
translate brazilian c22s004_EveRoute_8cb7a7b1:

    # eva "Y tengo que ducharme. Apesto."
    eva "E eu preciso tomar banho. Estou fedendo."

# game/scripts/c22/c22.rpy:2174
translate brazilian c22s004_EveRoute_7980a049:

    # mc "Y se fue."
    mc "E ele foi embora."

# game/scripts/c22/c22.rpy:2175
translate brazilian c22s004_EveRoute_7ef1027e:

    # ama "Sí. Gracias por seguirme el juego."
    ama "Sim. Obrigado por participar."

# game/scripts/c22/c22.rpy:2176
translate brazilian c22s004_EveRoute_8b0c6de9:

    # mc "¿A qué venía eso?"
    mc "Do que se tratava?"

# game/scripts/c22/c22.rpy:2178
translate brazilian c22s004_EveRoute_f877ba9c:

    # ama "Ayer, cuando llegué, quería contárselo, pero [eva] estaba muy cansada y se fue a dormir en seguida. La tenía que despertar para ir a casa a cenar."
    ama "Ontem, quando cheguei, quis contar para ela, mas ela estava muito cansada e dormiu imediatamente. Tive que acordá-la para irmos jantar em casa."

# game/scripts/c22/c22.rpy:2179
translate brazilian c22s004_EveRoute_4a174a9a:

    # ama "La despertó la llamada de [aar]. Y se puso como la has visto cuando has llegado."
    ama "Ela foi acordada pela ligação de [aar]. E ela estava exatamente como você a viu quando chegou."

# game/scripts/c22/c22.rpy:2180
translate brazilian c22s004_EveRoute_3750bc87:

    # mc "Por eso llamaste para decir que no os encontrabais bien, ¿no?"
    mc "Foi por isso que você ligou para dizer que não estava se sentindo bem, certo?"

# game/scripts/c22/c22.rpy:2182
translate brazilian c22s004_EveRoute_77c898c5:

    # ama "Exacto. Ella no estaba de humor para socializar, y yo no quería dejarla sola, por muchas ganas que tuviera de volver a verte. De veros a todos."
    ama "Exatamente. Ela não estava com vontade de socializar, e eu não queria deixá-la sozinha, por mais que eu quisesse ver vocês de novo. Ver todos vocês."

# game/scripts/c22/c22.rpy:2183
translate brazilian c22s004_EveRoute_bb76bcc2:

    # ama "Después de la llamada, no estaba de humor para nada, menos aún para que se lo contara."
    ama "Depois da ligação, ela não estava com vontade de nada, muito menos de ouvir o que eu tinha a dizer."

# game/scripts/c22/c22.rpy:2185
translate brazilian c22s004_EveRoute_acb231af:

    # ama "Ya has visto lo feliz que le ha hecho que la \"eligieras antes que a mí\"."
    ama "Você já viu o quanto ela ficou feliz por você \"ter escolhido ela em vez de mim\"."

# game/scripts/c22/c22.rpy:2186
translate brazilian c22s004_EveRoute_ae2d444e:

    # mc "Si se lo hubieras dicho, se hubiera sentido más miserable aún, sumado a lo de Gavin."
    mc "Se você tivesse contado para ele, ele teria se sentido ainda mais miserável, além do que aconteceu com Gavin."

# game/scripts/c22/c22.rpy:2188
translate brazilian c22s004_EveRoute_0ce98a1f:

    # ama "Exacto. Por eso envié el mensaje individualmente a todas las chicas."
    ama "Exatamente. Por isso enviei a mensagem individualmente para todas as meninas."

# game/scripts/c22/c22.rpy:2189
translate brazilian c22s004_EveRoute_2999362c:

    # mc "Hablando del mensaje. Deberías avisar a [emm] de que no le responda diciendo que ya sabía lo tuyo."
    mc "Falando da mensagem, você deve avisar [emm] para não responder dizendo que ele já sabia sobre você."

# game/scripts/c22/c22.rpy:2190
translate brazilian c22s004_EveRoute_4533066c:

    # mc "Si lo lee en el grupo, es capaz de descubrirte."
    mc "Se ele ler isso no grupo, ele consegue te descobrir."

# game/scripts/c22/c22.rpy:2192
translate brazilian c22s004_EveRoute_102790c8:

    # ama "*Risa* No te preocupes."
    ama "*Risos* Não se preocupe."

# game/scripts/c22/c22.rpy:2193
translate brazilian c22s004_EveRoute_bddecb9f:

    # ama "Llamé a [emm] después de enviar el mensaje y le dije que, hasta que [eva] no dijera algo o yo lo publicara en el grupo, ella no sabía nada."
    ama "Liguei para [emm] depois de enviar a mensagem e disse a ela que, até [eva] dizer algo ou eu postar no grupo, ela não saberia de nada."

# game/scripts/c22/c22.rpy:2194
translate brazilian c22s004_EveRoute_429b41cd:

    # mc "Me sorprende lo mucho que nos conoces, [ama]."
    mc "Estou surpreso com o quão bem você nos conhece, [ama]."

# game/scripts/c22/c22.rpy:2196
translate brazilian c22s004_EveRoute_55913309:

    # ama "*Risa* Gajes del oficio."
    ama "*Risos* Riscos ocupacionais."

# game/scripts/c22/c22.rpy:2199
translate brazilian c22s004_EveRoute_1c771fe6:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego.)"
    mcp "(Não sei o que ele está tramando, mas é melhor entrar na brincadeira.)"

# game/scripts/c22/c22.rpy:2201
translate brazilian c22s004_EveRoute_1095c513:

    # ama "[mc] y yo decidimos ayer que no vamos a salir juntos de momento."
    ama "[mc] e eu decidimos ontem que não vamos namorar por enquanto."

# game/scripts/c22/c22.rpy:2202
translate brazilian c22s004_EveRoute_f54fd145:

    # ama "Entre otras cosas, con la preparación del viaje a Aruba y todo lo que hay que hacer, hubiera sido una distracción."
    ama "Entre outras coisas, com os preparativos para a viagem a Aruba e tudo o que precisa ser feito, isso teria sido uma distração."

# game/scripts/c22/c22.rpy:2203
translate brazilian c22s004_EveRoute_ed5bbd50:

    # mc "Entre otras cosas..."
    mc "Entre outras coisas..."

# game/scripts/c22/c22.rpy:2205
translate brazilian c22s004_EveRoute_cc99be57:

    # eva "Entonces yo también debería dejar de salir con él, ¿no?"
    eva "Então eu também deveria parar de vê-lo, certo?"

# game/scripts/c22/c22.rpy:2206
translate brazilian c22s004_EveRoute_6bc93654:

    # ama "No hace falta. Las preparaciones las estoy llevando a cabo yo."
    ama "Não precisa. Estou cuidando dos preparativos sozinho."

# game/scripts/c22/c22.rpy:2207
translate brazilian c22s004_EveRoute_ec8a8faf:

    # ama "Tú disfruta de tu novio y yo me ocupo del resto."
    ama "Aproveite seu namorado e eu cuido do resto."

# game/scripts/c22/c22.rpy:2209
translate brazilian c22s004_EveRoute_ebaf0c4f:

    # eva "¡Gracias, [ama]! ¡Eres la mejor hermana del mundo!"
    eva "Obrigada, [ama]! Você é a melhor irmã do mundo!"

