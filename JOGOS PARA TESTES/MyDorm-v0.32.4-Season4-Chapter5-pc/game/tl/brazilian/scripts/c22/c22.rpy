translate brazilian c22s004_EveRoute_e79836da:

    # ama "Por eso tampoco le he dicho toda la verdad. No quiero estropear su felicidad ahora mismo."
    ama "Por isso também não contei toda a verdade para ela. Não quero estragar a felicidade dela agora."

# game/scripts/c22/c22.rpy:2232
translate brazilian c22s004_EveRoute_252d779b:

    # ama "Mejor ocultar un poco la verdad, aunque no sea mentira del todo."
    ama "É melhor esconder um pouco a verdade, mesmo que não seja uma mentira completa."

# game/scripts/c22/c22.rpy:2233
