# game/scripts/c22/c22.rpy:2237
translate brazilian c22s004_EveRoute_a4bc4165:

    # mc "Ciertamente, eres una muy buena hermana."
    mc "Você é, sem dúvida, uma ótima irmã."

# game/scripts/c22/c22.rpy:2240
translate brazilian c22s004_EveRoute_952aa276:

    # "En ese momento suena tu teléfono."
    "Nesse momento, seu telefone toca."

# game/scripts/c22/c22.rpy:2244
translate brazilian c22s004_Convo_a444a745:

    # ama "No te preocupes por eso, habrá tiempo para decidirnos. Ahora tenéis que disfrutar vosotros."
    ama "Não se preocupem com isso, haverá tempo para decidir. Agora vocês precisam se divertir."

# game/scripts/c22/c22.rpy:2246
translate brazilian c22s004_Convo_c4e93806:

    # ama "Pero antes, tienes que recoger esas cajas de munición."
    ama "Mas primeiro, você precisa coletar aquelas caixas de munição."

# game/scripts/c22/c22.rpy:2248
translate brazilian c22s004_Convo_e5582b0b:

    # eva "¿Qué cajas?"
    eva "Quais caixas?"

# game/scripts/c22/c22.rpy:2249
