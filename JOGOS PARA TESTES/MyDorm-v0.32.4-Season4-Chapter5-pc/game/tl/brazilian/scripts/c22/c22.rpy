    emm "A mesma coisa aconteceu comigo na primeira vez que fizemos isso... normal..."

# game/scripts/c22/c22.rpy:915
translate brazilian c22s002_EmmMarChat_209dbdee:

    # mc "Entonces será mejor no volver a probarlo."
    mc "Então é melhor não tentar novamente."

# game/scripts/c22/c22.rpy:917
translate brazilian c22s002_EmmMarChat_624953b1:

    # emm "¿Qué? ¡NO! No me refería a eso. La primera vez normal también me arrepentí, y ahora ya no tengo molestias nunca."
    emm "O quê? NÃO! Não era isso que eu queria dizer. Da primeira vez que fiz isso normalmente, também me arrependi, mas agora nunca sinto nenhum desconforto."

# game/scripts/c22/c22.rpy:919
translate brazilian c22s002_EmmMarChat_4c3fa8c1:

