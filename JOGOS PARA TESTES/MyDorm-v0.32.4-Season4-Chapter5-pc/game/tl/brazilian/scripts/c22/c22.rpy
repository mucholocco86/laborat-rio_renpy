    # dap "Bienvenida oficialmente a la familia, [sca]. Ahora eres una Marks de pleno derecho."
    dap "Bem-vindo oficialmente à família, [sca]. Agora você é um Marks de fato."

# game/scripts/c22/c22.rpy:2887
translate brazilian c22s004_ScaPatch_cad353ae:

    # mom "Ven aquí, cielo."
    mom "Vem cá, meu amor."

# game/scripts/c22/c22.rpy:2888
translate brazilian c22s004_ScaPatch_cc349d22:

    # "[mar] se acerca a [sca], ignorando las caras de sorpresa del resto de mujeres, y se funde en un abrazo con la chica a medio camino."
    "[mar] se aproxima de [sca], ignorando os rostos surpresos das outras mulheres, e se entrega a um abraço na garota que está a meio caminho."

# game/scripts/c22/c22.rpy:2889
translate brazilian c22s004_ScaPatch_5409146d:

    # mom "Bienvenida a la familia, cariño."
    mom "Bem-vinda à família, querida."

# game/scripts/c22/c22.rpy:2891
translate brazilian c22s004_ScaPatch_6d953712:

    # mee "¿Qué está pasando aquí?"
    mee "O que está acontecendo aqui?"

# game/scripts/c22/c22.rpy:2893
translate brazilian c22s004_ScaPatch_f3b02d0c:

    # "[dap] decide pasar a un segundo plano. Ella ha puesto los cimientos para esta situación."
    "[dap] decide ficar em segundo plano. Ela preparou o terreno para essa situação."

# game/scripts/c22/c22.rpy:2894
translate brazilian c22s004_ScaPatch_bd0c6666:

    # "Pero contar la verdad podría ser muy humillante para [mar]. No es algo a lo que tenga derecho."
    "Mas dizer a verdade poderia ser muito humilhante para [mar]. Não é algo que ela tenha o direito de fazer."

# game/scripts/c22/c22.rpy:2896
translate brazilian c22s004_ScaPatch_a6a34926:

    # "[sca] está demasiado abrumada para hablar. El desarrollo del \"experimento de [dap]\" la ha dejado con las emociones a flor de piel."
    "[sca] está demasiado emocionada para falar. O desenrolar do \"experimento [dap]\" deixou-a emocionalmente devastada."

# game/scripts/c22/c22.rpy:2897
translate brazilian c22s004_ScaPatch_187b6314:

    # "Tú tampoco puedes dar las explicaciones por las mismas razones que [dap]. Te alegras de haber tenido la conversación con [mar] por la mañana."
    "Você também não pode dar explicações, pelos mesmos motivos que [dap]. Você está feliz por ter tido a conversa com [mar] esta manhã."

# game/scripts/c22/c22.rpy:2899
translate brazilian c22s004_ScaPatch_b6bed2ee:

    # mar "[sca] es la hija de Edmund. Me engañó hace años y este es el resultado."
    mar "[sca] é filha de Edmund. Ele me enganou anos atrás e este é o resultado."

# game/scripts/c22/c22.rpy:2901
translate brazilian c22s004_ScaPatch_c322422b:

    # todas "¿QUÉ?"
    todas "QUE?"

# game/scripts/c22/c22.rpy:2903
translate brazilian c22s004_ScaPatch_cdf1519b:

    # mar "Sí, lleva años siendo un cabrón, por lo visto, pero..."
    mar "Sim, aparentemente ele tem sido um canalha durante anos, mas..."

# game/scripts/c22/c22.rpy:2904
translate brazilian c22s004_ScaPatch_82f9c8e3:

    # mar "No creía que pudiera pensar esto, pero [sca] es un regalo que ha llegado a casa con retraso, aunque lo hemos tenido delante todos estos años."
    mar "Eu não pensei que pudesse pensar isso, mas [sca] é um presente que chegou tarde em casa, embora o tenhamos tido diante de nós todos esses anos."

# game/scripts/c22/c22.rpy:2906
translate brazilian c22s004_ScaPatch_75d74da8:

    # mar "Cielo, no eres mi hija, pero... ¿me permitirías ejercer de madre?"
    mar "Querida, você não é minha filha, mas... você me permitiria agir como sua mãe?"

# game/scripts/c22/c22.rpy:2907
translate brazilian c22s004_ScaPatch_f7b54a42:

    # sca "No podría tener una madre mejor, [mar]."
    sca "Eu não poderia ter uma mãe melhor, [mar]."

# game/scripts/c22/c22.rpy:2909
translate brazilian c22s004_ScaPatch_c9c66e1d:

    # emm "¿Puedo abrazar a mi nueva hermana?"
    emm "Posso abraçar minha nova irmã?"

# game/scripts/c22/c22.rpy:2911
translate brazilian c22s004_ScaPatch_48d5b831:

    # emm "Dos hermanas nuevas en una semana. Al final me voy a hacer un lío..."
    emm "Duas irmãs novas em uma semana. Vou ficar confusa..."

# game/scripts/c22/c22.rpy:2912
translate brazilian c22s004_ScaPatch_2d7e9c6d:

    # emm "Bienvenida a casa, hermanita."
    emm "Bem-vinda de volta, irmãzinha."

# game/scripts/c22/c22.rpy:2913
translate brazilian c22s004_ScaPatch_c051dd51:

    # sca "Gracias, [emm]. Me alegra muchísimo que seas mi hermana."
    sca "Obrigada, [emm]. Estou tão feliz que você seja minha irmã."

# game/scripts/c22/c22.rpy:2915
translate brazilian c22s004_ScaPatch_64313a6f:

    # "El resto os vais turnando para abrazar a [sca]. Dándole la bienvenida a la familia."
    "O resto de vocês se reveza abraçando [sca], dando-lhe as boas-vindas à família."

# game/scripts/c22/c22.rpy:2917
translate brazilian c22s004_ScaPatch_08a6e81d:

    # "Sienta tan bien quitarse los secretos de encima..."
    "É tão bom se livrar de todos os seus segredos..."

# game/scripts/c22/c22.rpy:2918
translate brazilian c22s004_ScaPatch_a6c1761f:

    # "[dap] envía un mensaje al grupo de WhatsUp mientras el resto de las chicas acaban de abrazar a [sca]."
    "[dap] envia uma mensagem para o grupo do WhatsUp enquanto o resto das meninas acabaram de se abraçar [sca]."

# game/scripts/c22/c22.rpy:2919
translate brazilian c22s004_ScaPatch_adfcbf79:

    # "El resto de la familia también tiene derecho a saber la verdad."
    "O resto da família também tem o direito de saber a verdade."

# game/scripts/c22/c22.rpy:2925
translate brazilian c22s004_ScaUnPatch_92dacd4e:

    # sca "¿Qué?"
    sca "Que?"

# game/scripts/c22/c22.rpy:2927
translate brazilian c22s004_ScaUnPatch_3cf8b728:

    # dap "Ven aquí. *Risa* Parezco una gaviota idiota con el ala levantada."
    dap "Vem cá. *Risos* Eu pareço uma gaivota idiota com a asa levantada."

# game/scripts/c22/c22.rpy:2929
translate brazilian c22s004_ScaUnPatch_c1a59b8a:

    # sca "*Susurrando* ¿De qué va esto?"
    sca "*Sussurrando* Do que se trata tudo isso?"

# game/scripts/c22/c22.rpy:2930
translate brazilian c22s004_ScaUnPatch_87041c3e:

    # dap "Calla y escucha."
    dap "Fique em silêncio e escute."

# game/scripts/c22/c22.rpy:2933
translate brazilian c22s004_ScaUnPatch_4951328c:

    # dap "Os habéis dado cuenta de que, menos con [lis] y [deb.nick], y con Tía [bet] y la abuela, el resto de las parejas de hermanos no lo son de sangre, ¿verdad?"
    dap "Você deve ter notado que, além de [lis] e [deb.nick], e da tia [bet] e da avó, os demais pares de irmãos não são parentes de sangue, certo?"

# game/scripts/c22/c22.rpy:2935
translate brazilian c22s004_ScaUnPatch_03e2ab71:

    # dap "Os habéis dado cuenta con los ejemplos de [eva] y [ama] de que no es necesario compartir genes para ser hermanas."
    dap "Você percebeu pelos exemplos de [eva] e [ama] que não é necessário compartilhar genes para serem irmãs."

# game/scripts/c22/c22.rpy:2936
translate brazilian c22s004_ScaUnPatch_90b541cb:

    # todas "Sí."
    todas "Sim."

# game/scripts/c22/c22.rpy:2939
translate brazilian c22s004_ScaUnPatch_d42c5c3b:

    # dap "He estado hablando estos días con mi madre sobre nuestro parentesco legal."
    dap "Tenho conversado com minha mãe nos últimos dias sobre nossa filiação legal."

# game/scripts/c22/c22.rpy:2940
translate brazilian c22s004_ScaUnPatch_ccc4a29c:

    # dap "Ni siquiera soy adoptada. Ni siquiera es mi madre legalmente."
    dap "Eu nem sou adotada. Ela nem é minha mãe legal."

# game/scripts/c22/c22.rpy:2941
translate brazilian c22s004_ScaUnPatch_8c7306ee:

    # dap "¿Alguien pone en duda que [nor] sea mi madre?"
    dap "Alguém duvida que [nor] seja minha mãe?"

# game/scripts/c22/c22.rpy:2943
translate brazilian c22s004_ScaUnPatch_664969f4:

    # dap "Pero nadie duda de que sean hermanas. O de que [eva] sea mi hermana."
    dap "Mas ninguém duvida que elas sejam irmãs. Ou que [eva] seja minha irmã."

# game/scripts/c22/c22.rpy:2944
translate brazilian c22s004_ScaUnPatch_c425aa82:

    # todas "No."
    todas "Não."

# game/scripts/c22/c22.rpy:2947
translate brazilian c22s004_ScaUnPatch_4e4e916b:

    # mee "Yo lo hice durante años. Ya no."
    mee "Fiz isso durante anos. Não faço mais."

# game/scripts/c22/c22.rpy:2949
translate brazilian c22s004_ScaUnPatch_29c985f9:

    # mee "Es tu hermana y es mi nieta perdida."
    mee "Ela é sua irmã e minha neta, que eu não via há muito tempo."

# game/scripts/c22/c22.rpy:2952
translate brazilian c22s004_ScaUnPatch_17168897:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por Mi Abuela\"?"
    dap "Tudo bem, vovó. Ou devo dizer \"Sra. Fingindo Ser Minha Avó\"?"

# game/scripts/c22/c22.rpy:2954
translate brazilian c22s004_ScaUnPatch_951671e8:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por La Abuela de [eva] y [ama]\"?"
    dap "Tudo bem, vovó. Ou devo dizer \"Sra. Fingindo ser a vovó de [eva] e [ama]\"?"

# game/scripts/c22/c22.rpy:2957
translate brazilian c22s004_ScaUnPatch_a698cdd3:

    # mee "*Risa* Ni se te ocurra. Soy tu abuela te guste o no."
    mee "*Risos* Nem pense nisso. Sou sua avó, quer você goste ou não."

# game/scripts/c22/c22.rpy:2959
translate brazilian c22s004_ScaUnPatch_ea73dd64:

    # mee "*Risa* Ni se te ocurra. Soy su abuela les guste o no."
    mee "*Risos* Nem pense nisso. Sou a avó deles, quer queiram ou não."

# game/scripts/c22/c22.rpy:2960
translate brazilian c22s004_ScaUnPatch_4a7779fa:

    # mee "Y, si quieren, también puedo serlo para cualquier chica que necesite una abuela."
    mee "E, se você quiser, também posso ser uma avó para qualquer menina que precise de uma."

# game/scripts/c22/c22.rpy:2961
translate brazilian c22s004_ScaUnPatch_c8ee8ea5:

    # mee "No hago galletas, por cierto."
    mee "Aliás, eu não faço biscoitos."

# game/scripts/c22/c22.rpy:2962
translate brazilian c22s004_ScaUnPatch_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c22/c22.rpy:2964
translate brazilian c22s004_ScaUnPatch_550ac64e:

    # dap "¿Puedo continuar? Gracias."
    dap "Posso continuar? Obrigada."

# game/scripts/c22/c22.rpy:2965
translate brazilian c22s004_ScaUnPatch_ff63ea89:

    # dap "A lo que me refiero es a que esta familia es rara. Se ha creado a través de mentiras, secretos, y clonaciones."
    dap "O que eu quero dizer é que essa família é estranha. Ela foi criada através de mentiras, segredos e clonagem."

# game/scripts/c22/c22.rpy:2966
translate brazilian c22s004_ScaUnPatch_797171cd:

    # dap "¿Pero alguien duda de que sea una familia?"
    dap "Mas alguém duvida que eles sejam uma família?"

# game/scripts/c22/c22.rpy:2967
translate brazilian c22s004_ScaUnPatch_c425aa82_1:

    # todas "No."
    todas "Não."

# game/scripts/c22/c22.rpy:2969
translate brazilian c22s004_ScaUnPatch_90cb866e:

    # deb "Es una familia increíble, [dap]. Los lazos de sangre importan menos que la voluntad de ser una familia."
    deb "É uma família incrível. Os laços de sangue importam menos do que a vontade de ser uma família."

# game/scripts/c22/c22.rpy:2970
translate brazilian c22s004_ScaUnPatch_1f3ae072:

    # lis "Si leyera esto en un libro, no me lo creería. Vivirlo es totalmente diferente."
    lis "Se eu lesse isso em um livro, não acreditaria. Vivenciar é completamente diferente."

# game/scripts/c22/c22.rpy:2972
translate brazilian c22s004_ScaUnPatch_fb14b4c6:

    # dap "Eso es exactamente lo que quiero decir."
    dap "É exatamente isso que eu quero dizer."

# game/scripts/c22/c22.rpy:2973
translate brazilian c22s004_ScaUnPatch_4901efbe:

    # dap "Me da lo mismo lo que piense la gente de fuera de la familia."
    dap "Não me importo com o que as pessoas de fora da família pensam."

# game/scripts/c22/c22.rpy:2974
translate brazilian c22s004_ScaUnPatch_b487daa7:

    # dap "Me da lo mismo lo que digan las leyes."
    dap "Não me importo com o que dizem as leis."

# game/scripts/c22/c22.rpy:2977
translate brazilian c22s004_ScaUnPatch_49550204:

    # dap "Si [nor] es mi madre porque elegimos que lo sea..."
    dap "Se [nor] é minha mãe porque a escolhemos para ser..."

# game/scripts/c22/c22.rpy:2978
translate brazilian c22s004_ScaUnPatch_d8503a7a:

    # dap "Si [mee] es mi abuela porque así lo hemos decidido..."
    dap "Se [mee] é minha avó porque decidimos que sim..."

# game/scripts/c22/c22.rpy:2980
translate brazilian c22s004_ScaUnPatch_36b275d9:

    # dap "Si [ama] y [eva] son de la familia porque elegimos que lo sean..."
    dap "Se [ama] e [eva] são família porque nós os escolhemos para ser..."

# game/scripts/c22/c22.rpy:2981
translate brazilian c22s004_ScaUnPatch_dc19810b:

    # dap "Si la abuela es también su abuela porque así lo han decidido..."
    dap "Se a avó também é avó deles porque eles decidiram assim..."

# game/scripts/c22/c22.rpy:2982
translate brazilian c22s004_ScaUnPatch_35ae7fab:

    # mc "Y porque si no, seguramente sí que nos haría esas galletas y nos obligaría a comerlas como tortura."
    mc "E porque, caso contrário, ele certamente faria aqueles biscoitos para nós e nos obrigaria a comê-los como forma de tortura."

# game/scripts/c22/c22.rpy:2983
translate brazilian c22s004_ScaUnPatch_b3b94564_1:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c22/c22.rpy:2985
translate brazilian c22s004_ScaUnPatch_8364dc4d:

    # dap "Bueno, pues una vez establecida la premisa..."
    dap "Bem, uma vez estabelecida essa premissa..."

# game/scripts/c22/c22.rpy:2986
translate brazilian c22s004_ScaUnPatch_6998dd2e:

    # dap "He decidido que [sca] es mi hermana."
    dap "Eu decidi que [sca] é minha irmã."

# game/scripts/c22/c22.rpy:2988
translate brazilian c22s004_ScaUnPatch_9d49d5cf:

    # dap "Joder, me ha quedado totalmente anticlimático con tantas interrupciones."
    dap "Puxa, acabou sendo totalmente anticlimático com tantas interrupções."

# game/scripts/c22/c22.rpy:2990
translate brazilian c22s004_ScaUnPatch_7dbc2656:

    # mee "¡Ese lenguaje, señorita! Como tu abuela no te dejo usarlo."
    mee "Essa linguagem, mocinha! Assim como sua avó, eu não deixo você usá-la."

# game/scripts/c22/c22.rpy:2991
translate brazilian c22s004_ScaUnPatch_b3b94564_2:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c22/c22.rpy:2992
translate brazilian c22s004_ScaUnPatch_f994bd47:

    # mee "Y a ti tampoco, [sca], antes de que preguntes. Quiero que mis nietas hablen como señoritas bien educadas."
    mee "E você também não, [sca], antes que pergunte. Quero que minhas netas falem como moças bem-educadas."

# game/scripts/c22/c22.rpy:2994
translate brazilian c22s004_ScaUnPatch_4ebbfbb7:

    # sca "..."
    sca "..."

# game/scripts/c22/c22.rpy:2996
translate brazilian c22s004_ScaUnPatch_490df30a:

    # sca "Gracias, [dap.nick]..."
    sca "Obrigado, [dap.nick]..."

# game/scripts/c22/c22.rpy:2997
translate brazilian c22s004_ScaUnPatch_1504d153:

    # dap "Es lo menos que podía hacer. Sabes que te considero mi hermana. Ahora lo saben todos."
    dap "É o mínimo que eu podia fazer. Você sabe que eu te considero minha irmã. Agora todo mundo sabe."

# game/scripts/c22/c22.rpy:2999
translate brazilian c22s004_ScaUnPatch_61677265:

    # eri "[dap], ¿puedes dejar de monopolizar a mi hermana? Yo también quiero abrazarla."
    eri "[dap], você pode parar de monopolizar minha irmã? Eu também quero abraçá-la."

# game/scripts/c22/c22.rpy:3001
translate brazilian c22s004_ScaUnPatch_b4b3c095:

    # sca "Me vais a hacer llorar..."
    sca "Você vai me fazer chorar..."

# game/scripts/c22/c22.rpy:3002
translate brazilian c22s004_ScaUnPatch_d31d2ea0:

    # eri "Yo llevaría un rato llorando. Ya sabes que soy muy llorona, y lo que ha dicho [dap] es muy bonito."
    eri "Eu ficaria chorando por um tempo. Você sabe que eu sou muito chorona, e o que [dap] disse foi muito doce."

# game/scripts/c22/c22.rpy:3004
translate brazilian c22s004_ScaUnPatch_b851f5fa:

    # "El resto os vais turnando para abrazar a [sca]. Todas dicen algo que la hace sentir querida."
    "O resto de vocês se reveza abraçando [sca]. Todos dizem algo que a faça se sentir amada."

# game/scripts/c22/c22.rpy:3006
translate brazilian c22s004_ScaUnPatch_923f197c:

    # "[sca] ha pasado de tener una madre de mierda a tener dos madres y dos abuelas maravillosas. Y un montón de hermanas."
    "[sca] passou de ter uma mãe péssima para ter duas mães e duas avós maravilhosas. E um monte de irmãs."

# game/scripts/c22/c22.rpy:3009
translate brazilian c22s004_hugs_d8a24664:

    # "La escena te recuerda mucho a la fiesta de la piscina, cuando [mee] contó su secreto sobre el cáncer."
    "A cena lembra muito a festa na piscina, quando [mee] revelou seu segredo sobre o câncer."

# game/scripts/c22/c22.rpy:3010
translate brazilian c22s004_hugs_5dc73603:

    # "No podrías estar más orgulloso de tu familia."
    "Você não poderia estar mais orgulhoso da sua família."

# game/scripts/c22/c22.rpy:3019
translate brazilian c22s004_BetCallsBishop_bea50ff2:

    # bet "Lo que pasa en esta familia es increíble."
    bet "O que está acontecendo nessa família é inacreditável."

# game/scripts/c22/c22.rpy:3020
translate brazilian c22s004_BetCallsBishop_9ef0ffa9:

    # mc "Pero es para sentirse orgulloso de formar parte de ella."
    mc "Mas é algo de que se orgulhar de fazer parte."

# game/scripts/c22/c22.rpy:3021
translate brazilian c22s004_BetCallsBishop_2e68811e:

    # mc "El día menos pensado, pasará un perro callejero por delante de casa y le diremos \"Tú también eres de la familia\"."
    mc "Um dia, de repente, um cachorro de rua passará em frente à nossa casa e diremos a ele: \"Você também faz parte da família.\""

# game/scripts/c22/c22.rpy:3022
translate brazilian c22s004_BetCallsBishop_c0d47adb:

    # mc "Y que conste que no estoy comparando a [sca] con un perro callejero. Se merece formar parte de esta familia."
    mc "E que fique claro que não estou comparando [sca] a um cão de rua. Ele merece fazer parte desta família."

# game/scripts/c22/c22.rpy:3025
translate brazilian c22s004_BetCallsBishop_dea11c03:

    # bet "Claro que sí. Es tu hermana. Y aunque no lo fuera, esa chica es adorable y necesita una familia que la quiera."
    bet "Claro que sim. Ela é sua irmã. E mesmo que não fosse, essa menina é adorável e precisa de uma família que a ame."

# game/scripts/c22/c22.rpy:3026
translate brazilian c22s004_BetCallsBishop_13dcbbbf:

    # mc "Sí, es sorprendente lo adorable que es con la mierda de padres que tiene."
    mc "Sim, é surpreendente o quão adorável ele é, considerando os pais horríveis que ele tem."

# game/scripts/c22/c22.rpy:3028
translate brazilian c22s004_BetCallsBishop_32aaa9c5:

    # bet "Claro que sí. Es una chica adorable y necesita una familia que la quiera."
    bet "Claro. Ela é uma menina adorável e precisa de uma família amorosa."

# game/scripts/c22/c22.rpy:3029
translate brazilian c22s004_BetCallsBishop_65e9f4b0:

    # mc "Sí, es sorprendente lo adorable que es con la madre que tiene."
    mc "Sim, é incrível como ele é adorável com a mãe que tem."

# game/scripts/c22/c22.rpy:3031
translate brazilian c22s004_BetCallsBishop_b53ef1e8:

    # bet "Quería hablar contigo de una cosa..."
    bet "Queria falar com você sobre algo..."

# game/scripts/c22/c22.rpy:3032
translate brazilian c22s004_BetCallsBishop_7ff9267a:

    # mc "Dime. ¿Tiene algo que ver con lo que ha pasado antes?"
    mc "Diga-me. Isso tem alguma relação com o que aconteceu antes?"

# game/scripts/c22/c22.rpy:3034
translate brazilian c22s004_BetCallsBishop_6c7ed6f0:

    # bet "No. No quiero hablar de eso."
    bet "Não. Não quero falar sobre isso."

# game/scripts/c22/c22.rpy:3035
translate brazilian c22s004_BetCallsBishop_8e7ec810:

    # mc "Quitarse los secretos de encima es liberador, [bet]. Y hablar las cosas también."
    mc "Livrar-se de segredos é libertador, [bet]. E conversar sobre as coisas também."

# game/scripts/c22/c22.rpy:3037
translate brazilian c22s004_BetCallsBishop_9f6bdc68:

    # bet "Es posible, pero hoy no es el día."
    bet "É possível, mas hoje não é o dia."

# game/scripts/c22/c22.rpy:3038
translate brazilian c22s004_BetCallsBishop_f7a2d776:

    # mc "Como quieras. ¿De qué querías hablar?"
    mc "O que você quiser. Sobre o que você queria conversar?"

# game/scripts/c22/c22.rpy:3040
translate brazilian c22s004_BetCallsBishop_425ea172:

    # bet "Me han llamado de Monterey después de comer. Tengo una cita con el secretario del obispo el jueves por la tarde."
    bet "Recebi uma ligação de Monterey depois do almoço. Tenho uma reunião marcada com a secretária do bispo na quinta-feira à tarde."

# game/scripts/c22/c22.rpy:3041
translate brazilian c22s004_BetCallsBishop_ffceb4d2:

    # bet "¿Crees que me podrías llevar? Si no puedes, puedo ir en autobús."
    bet "Você acha que poderia me dar uma carona? Se não, posso pegar o ônibus."

# game/scripts/c22/c22.rpy:3042
translate brazilian c22s004_BetCallsBishop_5692500e:

    # mc "Ningún problema. Voy a intentar mover el alquiler del coche de [emm] para el jueves, y así matamos dos pájaros de un tiro."
    mc "Sem problema. Vou tentar transferir o aluguel do carro de [emm] para quinta-feira, assim matamos dois coelhos com uma cajadada só."

# game/scripts/c22/c22.rpy:3044
translate brazilian c22s004_BetCallsBishop_b1e9ff19:

    # bet "Gracias, [mc]. Voy a ir a mi habitación, dime algo si no puedes mover lo de [emm], para sacar los billetes de autobús."
    bet "Obrigado, [mc]. Vou para o meu quarto, me avise se você não conseguir mover a coisa [emm], para que eu possa pegar as passagens de ônibus."

# game/scripts/c22/c22.rpy:3045
translate brazilian c22s004_BetCallsBishop_0716effd:

    # mc "No me he explicado bien. Te voy a llevar el jueves sea como sea, aunque tenga que volver el día siguiente con [emm]."
    mc "Não me expliquei bem. Vou te levar na quinta-feira, aconteça o que acontecer, mesmo que eu tenha que voltar no dia seguinte com [emm]."

# game/scripts/c22/c22.rpy:3046
translate brazilian c22s004_BetCallsBishop_6435ce3f:

    # mc "No hemos tenido la oportunidad de pasar mucho tiempo juntos, y me parece un buen plan. No voy a dejar que hagas esto sola."
    mc "Não tivemos muitas oportunidades de passar tempo juntos, e este parece ser um bom plano. Não vou deixar você fazer isso sozinho."

# game/scripts/c22/c22.rpy:3048
translate brazilian c22s004_BetCallsBishop_c959b3f2:

    # bet "¡Oh! ¡Gracias!"
    bet "Oh! Obrigada!"

# game/scripts/c22/c22.rpy:3049
translate brazilian c22s004_BetCallsBishop_6147dd59:

    # mc "Y cuando quieras hablar de lo que ha pasado antes en el baño, avísame."
    mc "E quando você quiser conversar sobre o que aconteceu mais cedo no banheiro, me avise."

# game/scripts/c22/c22.rpy:3051
translate brazilian c22s004_BetCallsBishop_55d2a73c:

    # bet "Lo haré. Hasta luego."
    bet "Sim, eu vou. Até mais tarde."

# game/scripts/c22/c22.rpy:3053
translate brazilian c22s004_BetCallsBishop_457d2405:

    # mc "Hasta luego, Tía [bet]."
    mc "Até logo, tia [bet]."

# game/scripts/c22/c22.rpy:3062
translate brazilian c22s004_MarChat_990cce59:

    # mom "[dap] es increíble. La que ha montado para dar la noticia..."
    mom "[dap] É incrível. O alvoroço que ela fez para dar a notícia..."

# game/scripts/c22/c22.rpy:3063
translate brazilian c22s004_MarChat_db580cbd:

    # mc "No creo que fuera una noticia que se tuviera que dar por el grupo de WhatsUp."
