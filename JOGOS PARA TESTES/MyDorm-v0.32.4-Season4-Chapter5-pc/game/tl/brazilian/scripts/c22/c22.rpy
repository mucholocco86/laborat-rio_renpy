translate brazilian c22s004_MarChat_5d75b6da:

    # mc "Ningún problema. Estaré en mi habitación. Tengo algunas cosas que hacer."
    mc "Sem problema. Vou para o meu quarto. Tenho algumas coisas para fazer."

# game/scripts/c22/c22.rpy:3108
translate brazilian c22s004_BookFerrarini_f4a3cb37:

    # "Subes a tu habitación después de despedirte de todo el mundo y darle un largo abrazo a [sca]."
