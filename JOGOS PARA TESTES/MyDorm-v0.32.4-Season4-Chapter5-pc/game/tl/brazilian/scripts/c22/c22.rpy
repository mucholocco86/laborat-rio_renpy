    "*Ding-Dong*"

# game/scripts/c22/c22.rpy:3134
translate brazilian c22s005_SamCall_d1342aee:

    # sam "Buenas tardes, [mc]. Pasa, acabo de sacar las pastas del horno."
    sam "Boa tarde, [mc]. Entre, acabei de tirar os doces do forno."

# game/scripts/c22/c22.rpy:3135
translate brazilian c22s005_SamCall_bc600f6c:

    # mc "¿[jam] y [sim] no están?"
    mc "Não existem [jam] e [sim]?"

