    # sam "Hay cosas que podemos hablar entre chicas, y que las cohibiría si un chico hetero estuviera en el grupo."
    sam "Existem assuntos que podemos conversar entre nós, garotas, e que nos deixariam constrangidas se um cara hétero estivesse no grupo."

# game/scripts/c22/c22.rpy:3157
translate brazilian c22s005_SamCall_d56b9c53:

    # mc "Lo entiendo."
    mc "Eu entendo."

# game/scripts/c22/c22.rpy:3158
