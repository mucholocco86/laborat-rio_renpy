

# game/scripts/c15/c15.rpy:209
translate brazilian c15s001_DapDate_9988d3d9:

    # "[dap] introduce en el GPS la dirección del restaurante y conduces hasta allí. Está a poco menos de 20 minutos de la tienda de Maddie."
    "Insira o endereço do restaurante no seu GPS e dirija até lá. Fica a pouco menos de 20 minutos da loja da Maddie."

# game/scripts/c15/c15.rpy:212
translate brazilian c15s001_DapDate_ffd0c998:

    # dap "Ya hemos llegado. No te sorprendas por lo que veas ahí dentro..."
    dap "Chegamos. Não se surpreenda com o que verá lá dentro..."

# game/scripts/c15/c15.rpy:213
translate brazilian c15s001_DapDate_2eb99d0b:

    # dap "O mejor aún, sorpréndete."
    dap "Ou melhor ainda, surpreenda-se."

# game/scripts/c15/c15.rpy:214
translate brazilian c15s001_DapDate_34550ae0:

    # mc "Ya estoy sorprendido. Esto antes era un gimnasio, ¿no? ¿Ahora es un restaurante?"
    mc "Já estou surpreso. Isto costumava ser uma academia, certo? Agora é um restaurante?"

# game/scripts/c15/c15.rpy:216
translate brazilian c15s001_DapDate_f0a216c1:

    # dap "Son unos cuantos restaurantes... y algo más. Lo abrieron hace unos meses. Tenía ganas de venir, pero no tenía nadie con quién venir hasta que... tú y yo... ya sabes..."
    dap "São alguns restaurantes... e mais alguma coisa. Abriram há alguns meses. Eu queria muito ir, mas não tinha companhia até... você e eu... sabe..."

# game/scripts/c15/c15.rpy:217
translate brazilian c15s001_DapDate_267e2c14:

    # mc "[dap], puedes decir hasta que empezamos a salir."
    mc "[dap], você pode dizer até começarmos a namorar."

# game/scripts/c15/c15.rpy:218
translate brazilian c15s001_DapDate_6df6d6d0:

    # dap "Lo sé, pero se me hace raro decirlo."
    dap "Eu sei, mas parece estranho dizer isso."

# game/scripts/c15/c15.rpy:220
translate brazilian c15s001_DapDate_5c7d5522:

    # dap "Pues ya estamos aquí."
    dap "Bem, aqui estamos."

# game/scripts/c15/c15.rpy:221
translate brazilian c15s001_DapDate_b14bd407:

    # mc "¿Black Crow? Suena bien, debería haber mirado la página web. Pero es un poco pronto para ir a cenar, ¿no?"
    mc "Black Crow? Parece bom, eu devia ter consultado o site deles. Mas ainda é um pouco cedo para jantar, não é?"

# game/scripts/c15/c15.rpy:222
translate brazilian c15s001_DapDate_09756934:

    # dap "No creas. Tenemos que ducharnos y pasar por la peluquería. Al menos yo. Contigo no van a poder hacer gran cosa."
    dap "Não se preocupe. Precisamos tomar banho e ir ao cabeleireiro. Pelo menos eu preciso. Eles não poderão fazer muita coisa com você."

# game/scripts/c15/c15.rpy:223
translate brazilian c15s001_DapDate_b69e38e4:

    # mc "¿Peluquería? *Risa* ¿Dónde me has traído?"
    mc "Cabeleireiro? *Risos* Onde você me trouxe?"

# game/scripts/c15/c15.rpy:224
translate brazilian c15s001_DapDate_99c55155:

    # dap "Entremos y lo verás."
    dap "Vamos entrar e você verá."

# game/scripts/c15/c15.rpy:226
translate brazilian c15s001_DapDate_117275b9:

    # _("Recepcionista") "Buenas tardes, ¿tienen reserva?"
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:227
translate brazilian c15s001_DapDate_0eaa88ba:

    # mc "Sí, a nombre de Marks."
    mc "Sim, em nome de Marks."

# game/scripts/c15/c15.rpy:229
translate brazilian c15s001_DapDate_420fa7af:

    # dap "¡[mc] Marks!"
    dap "Marcas!"

# game/scripts/c15/c15.rpy:231
translate brazilian c15s001_DapDate_bf0b72ec:

    # _("Recepcionista") "Ah, vale, perfecto. Tienen reserva en el restaurante Black Crow."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:232
translate brazilian c15s001_DapDate_1ce75b02:

    # mc "Exacto."
    mc "Exato."

# game/scripts/c15/c15.rpy:233
translate brazilian c15s001_DapDate_6a4c1705:

    # _("Recepcionista") "Entonces, subiendo por estas escaleras encontrarán el vestuario donde les atenderán mis compañeros."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:234
translate brazilian c15s001_DapDate_b2516466:

    # mc "Gracias."
    mc "Obrigado."

# game/scripts/c15/c15.rpy:236
translate brazilian c15s001_DapDate_8bec7690:

    # mc "¿Vestuario? Ahí es donde nos podremos duchar, supongo."
    mc "Vestiário? É onde podemos tomar banho, suponho."

# game/scripts/c15/c15.rpy:237
translate brazilian c15s001_DapDate_a768d130:

    # dap "Y cambiarnos. Vas a poder elegir a tu gusto. Tan solo recuerda esto. 14. Para ir a juego."
    dap "E mude. Você poderá escolher como quiser. Só lembre-se disso. 14. Para combinar."

# game/scripts/c15/c15.rpy:238
translate brazilian c15s001_DapDate_0f97df03:

    # mc "Estás siendo muy misteriosa."
    mc "Você está sendo muito misterioso(a)."

# game/scripts/c15/c15.rpy:240
translate brazilian c15s001_DapDate_a11aa689:

    # dap "¿Quieres que te lo cuente todo y estropee la sorpresa?"
    dap "Você quer que eu te conte tudo e estrague a surpresa?"

# game/scripts/c15/c15.rpy:241
translate brazilian c15s001_DapDate_4a5ebed8:

    # mc "No, prefiero que me sorprendas, pero sigo pensando que es un poco pronto para cenar."
    mc "Não, eu preferiria que você me surpreendesse, mas ainda acho que é um pouco cedo para o jantar."

# game/scripts/c15/c15.rpy:242
translate brazilian c15s001_DapDate_90d35b9d:

    # dap "No te preocupes, entre ducha, cambiarme, y peluquería yo voy a tardar cerca de una hora."
    dap "Não se preocupe, entre o banho, a troca de roupa e a ida ao cabeleireiro, levarei cerca de uma hora."

# game/scripts/c15/c15.rpy:243
translate brazilian c15s001_DapDate_c476ef12:

    # mc "¿Qué? ¿Una hora?"
    mc "O quê? Uma hora?"

# game/scripts/c15/c15.rpy:245
translate brazilian c15s001_DapDate_faf803d9:

    # dap "Querrás que tu novia esté guapa en nuestra primera cita, ¿verdad?"
    dap "Você vai querer que sua namorada esteja linda no nosso primeiro encontro, certo?"

# game/scripts/c15/c15.rpy:246
translate brazilian c15s001_DapDate_742b9e83:

    # mc "[dap], tú estás guapa siempre, pero esperaré. Cada vez siento más curiosidad."
    mc "[dap], você está sempre linda, mas vou esperar. Estou ficando cada vez mais curioso."

# game/scripts/c15/c15.rpy:247
translate brazilian c15s001_DapDate_89e81213:

    # dap "Bueno, la curiosidad se acabará en cuanto entres por esa puerta. Nos vemos en una hora."
    dap "Bem, sua curiosidade será satisfeita assim que você atravessar aquela porta. Vejo você em uma hora."

# game/scripts/c15/c15.rpy:249
translate brazilian c15s001_DapDate_bcb25274:

    # "Es el momento de saber a qué viene tanto secretismo."
    "Chegou a hora de descobrir o motivo de tanto segredo."

# game/scripts/c15/c15.rpy:251
translate brazilian c15s001_DapDate_02f50975:

    # "Entras en el vestuario y te está esperando alguien de la plantilla vestido como la recepcionista."
    "Você entra no vestiário e alguém da equipe está esperando por você vestido de recepcionista."

# game/scripts/c15/c15.rpy:252
translate brazilian c15s001_DapDate_1c1c93b1:

    # "Elliot" "Buenas tardes, Sr. Marks. Soy Elliot y seré su Ayudante de Vestuario."
    "Elliot" "Boa tarde, Sr. Marks. Meu nome é Elliot e serei seu assistente de figurino."

# game/scripts/c15/c15.rpy:253
translate brazilian c15s001_DapDate_14dedc8d:

    # "Elliot" "Tiene las duchas al fondo. Recomendamos su uso antes de cambiarse."
    "Elliot" "Os chuveiros ficam na parte de trás. Recomendamos usá-los antes de se trocar."

# game/scripts/c15/c15.rpy:254
translate brazilian c15s001_DapDate_4a8bf992:

    # mc "Perfecto. Venimos de la playa y necesito una ducha. Pero no he traído ropa."
    mc "Perfeito. Acabamos de voltar da praia e preciso tomar um banho. Mas não trouxe roupa nenhuma."

# game/scripts/c15/c15.rpy:255
translate brazilian c15s001_DapDate_b8a43021:

    # "Elliot" "Veo que es su primera vez en nuestras instalaciones. ¿Quiere que le explique cómo funciona?"
    "Elliot" "Vejo que esta é a sua primeira vez em nossas instalações. Gostaria que eu explicasse como funciona?"

# game/scripts/c15/c15.rpy:256
translate brazilian c15s001_DapDate_890c041b:

    # mc "Por supuesto."
    mc "Claro."

# game/scripts/c15/c15.rpy:258
translate brazilian c15s001_DapDate_4f648d8a:

    # "Elliot" "Lo primero que me tiene que decir es de qué siglo se quiere vestir. Puede ser XIV, XVI, o XVIII. Eso nos ayuda a que las salas sean más homogéneas y a la inmersión de los clientes."
    "Elliot" "A primeira coisa que você precisa me dizer é em qual século você quer se vestir. Pode ser o século XIV, XVI ou XVIII. Isso nos ajuda a criar ambientes mais harmoniosos e aprimora a experiência do visitante."

# game/scripts/c15/c15.rpy:259
translate brazilian c15s001_DapDate_58e3f529:

    # mc "Mi novia me ha dicho que recuerde el número 14. Supongo que se refería a esto. No sabía que era un restaurante temático."
    mc "Minha namorada me disse para lembrar do número 14. Acho que ela se referia a isso. Eu não sabia que era um restaurante temático."

# game/scripts/c15/c15.rpy:260
translate brazilian c15s001_DapDate_72269408:

    # "Elliot" "Perfecto. Siendo el Siglo XIV puede escoger entre vestirse de caballero, cortesano, o pícaro. Teníamos un disfraz de campesino, pero no triunfó demasiado."
    "Elliot" "Perfeito. Como se trata do século XIV, você pode escolher se vestir de cavaleiro, cortesão ou malandro. Tínhamos uma fantasia de camponês, mas não fez muito sucesso."

# game/scripts/c15/c15.rpy:261
translate brazilian c15s001_DapDate_4a851eec:

    # mc "¿Caballero con armadura, espada y esas cosas?"
    mc "Um cavaleiro de armadura, com espada e tudo mais?"

# game/scripts/c15/c15.rpy:263
translate brazilian c15s001_DapDate_52998d60:

    # "Elliot" "Sí a la armadura, no a la espada. No proporcionamos armas, lo siento. Pese a que es uno de los más populares, le tengo que avisar que no es el más cómodo."
    "Elliot" "Sim para armaduras, não para espadas. Não fornecemos armas, desculpe. Embora seja uma das opções mais populares, preciso avisar que não é a mais confortável."

# game/scripts/c15/c15.rpy:264
translate brazilian c15s001_DapDate_2d013c95:

    # "Elliot" "Estar cenando con armadura, aunque sea falsa, puede resultar un poco incómodo si no está acostumbrado."
    "Elliot" "Jantar usando armadura, mesmo que seja falsa, pode ser um pouco desconfortável se você não estiver acostumado."

# game/scripts/c15/c15.rpy:265
translate brazilian c15s001_DapDate_d4e39871:

    # mc "¿Podría probarme los tres y decidir?"
    mc "Será que eu poderia experimentar os três e decidir depois?"

# game/scripts/c15/c15.rpy:266
translate brazilian c15s001_DapDate_aa2be2e3:

    # "Elliot" "No lo podemos permitir por un tema de higiene. Todos nuestros disfraces se envían a la lavandería después de cada uso."
    "Elliot" "Não podemos permitir isso por motivos de higiene. Todas as nossas fantasias são enviadas para a lavanderia após cada uso."

# game/scripts/c15/c15.rpy:267
translate brazilian c15s001_DapDate_605879ae:

    # mc "Entonces me disfrazaré de..."
    mc "Então eu me disfarçarei de..."

# game/scripts/c15/c15.rpy:276
translate brazilian c15s001_DapDate_12d962b0:

    # "Elliot" "Perfecto. Pues si quiere pasar a la ducha y le preparo su ropa. Se la dejaré en la taquilla. Aquí tiene la llave. Número 93. La combinación es 23129. Supongo que no quiere servicio de peluquería."
    "Elliot" "Perfeito. Se quiser tomar um banho, vou preparar suas roupas. Vou deixá-las no seu armário. Aqui está a chave. Número 93. A combinação é 23129. Presumo que não queira os serviços de cabeleireiro."

# game/scripts/c15/c15.rpy:277
translate brazilian c15s001_DapDate_447ba67f:

    # mc "No, no es necesario. ¿Por qué lo dice?"
    mc "Não, não é necessário. Por que você diz isso?"

# game/scripts/c15/c15.rpy:278
translate brazilian c15s001_DapDate_9cc3265b:

    # "Elliot" "Normalmente los clientes masculinos suelen rechazarlo a menos que lleven el pelo largo."
    "Elliot" "Os clientes do sexo masculino geralmente rejeitam, a menos que tenham cabelo comprido."

# game/scripts/c15/c15.rpy:279
translate brazilian c15s001_DapDate_6464cdcf:

    # mc "Entonces seré como el resto. *Risa* Rechazaré el servicio de peluquería."
    mc "Então serei como todo mundo. *Risos* Recusarei o serviço de cabeleireiro."

# game/scripts/c15/c15.rpy:280
translate brazilian c15s001_DapDate_99dbf3ae:

    # "Elliot" "Perfecto. Cuando esté listo, o si necesita ayuda para vestirse, llame a aquel timbre y volveré para acompañarle a la sala de espera."
    "Elliot" "Perfeito. Quando estiver pronto(a), ou se precisar de ajuda para se vestir, toque a campainha e eu voltarei para acompanhá-lo(a) até a sala de espera."

# game/scripts/c15/c15.rpy:282
translate brazilian c15s001_DapDate_12356f46:

    # "Después de darle tu talla, pasas a la ducha. Está claro que han mantenido las instalaciones del antiguo gimnasio."
    "Depois de escolher o seu tamanho, você vai para o chuveiro. É evidente que eles mantiveram as instalações da antiga academia."

# game/scripts/c15/c15.rpy:283
translate brazilian c15s001_DapDate_fb07d82b:

    # "Al volver tienes tu disfraz en la taquilla. Tienes curiosidad por saber cómo te va a quedar. Y especialmente tienes curiosidad sobre cómo se va a vestir [dap]. Esperas haber acertado."
    "Ao voltar, seu traje está no seu armário. Você está curioso para ver como ficará em você. E está especialmente curioso para saber o que [dap] estará vestindo. Você espera ter escolhido corretamente."

# game/scripts/c15/c15.rpy:286
translate brazilian c15s001_DapDate_1b8f0299:

    # mc "No quedo mal de caballero. Aunque el escudero tenía razón. No es muy cómodo. *Risa* Escudero... ya me estoy metiendo en el papel."
    mc "Não fico mal como cavaleiro. Embora o escudeiro tivesse razão. Não é muito confortável. *Risos* Escudeiro... Estou entrando no personagem agora."

# game/scripts/c15/c15.rpy:289
translate brazilian c15s001_DapDate_c35f0399:

    # mc "El disfraz de cortesano es chulo. El tacto es suave. Me alegra haber hecho caso al sirviente y no haber cogido el de caballero. *Risa* Sirviente... ya me estoy metiendo en el papel."
    mc "A roupa do cortesão é legal. É macia ao toque. Ainda bem que ouvi o servo e não peguei a do cavaleiro. *Risos* Servo... Já estou entrando no personagem."

# game/scripts/c15/c15.rpy:292
translate brazilian c15s001_DapDate_2a2c73a7:

    # mc "Creo que Vilfredo vestirá así en la partida de DnD. Me alegra haber hecho caso al tabernero y no haber cogido el de caballero. *Risa* Tabernero... ya me estoy metiendo en el papel."
    mc "Acho que o Vilfredo vai se vestir assim no jogo de D&D. Ainda bem que ouvi o dono da taverna e não escolhi a roupa de cavaleiro. *Risos* Dono da taverna... já estou entrando no personagem."

# game/scripts/c15/c15.rpy:294
translate brazilian c15s001_DapDate_ee7db50a:

    # "Justo cuando vas a pulsar el timbre para llamar a Elliot, te das cuenta de que no estás solo en el vestuario."
    "No momento em que você está prestes a apertar a campainha para chamar Elliot, você percebe que não está sozinho no vestiário."

# game/scripts/c15/c15.rpy:295
translate brazilian c15s001_DapDate_e6341375:

    # _("Hombre") "Buenas tardes. ¿Siglo XIV?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:296
translate brazilian c15s001_DapDate_fa27330b:

    # mc "Hola, buenas tardes. Sí."
    mc "Olá, boa tarde. Sim."

# game/scripts/c15/c15.rpy:297
translate brazilian c15s001_DapDate_30081bbe:

    # _("Hombre") "Nosotros estuvimos la semana pasada. Hoy toca cenar en el Siglo XXXII. Lo han abierto esta semana. Supongo que mi mujer se disfrazará de Princesa Laia. ¿De qué se disfrazará su esposa?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:298
translate brazilian c15s001_DapDate_9ccdfc53:

    # mc "Mi novia. No lo sé, es la primera vez que venimos y yo ni siquiera sabía qué tipo de restaurante era."
    mc "Minha namorada. Não sei, é a nossa primeira vez aqui e eu nem sabia que tipo de restaurante era."

# game/scripts/c15/c15.rpy:300
translate brazilian c15s001_DapDate_20d0961c:

    # _("Hombre") "Si es la primera vez, prepárate para esperar. A nosotros nos dan tres o cuatro opciones, dependiendo del restaurante. A ellas les dan seis o siete."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:301
translate brazilian c15s001_DapDate_9353de80:

    # mc "Pero no pudiéndoselos probar, no tardarán tanto, ¿no?"
    mc "Mas como eles não podem experimentá-las, não vão demorar muito, não é?"

# game/scripts/c15/c15.rpy:303
translate brazilian c15s001_DapDate_a3241e0f:

    # _("Hombre") "No se los pueden probar, pero pueden verlos en la percha. Mi mujer se pasó 20 minutos intentando decidir entre siete vestidos la semana pasada."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:304
translate brazilian c15s001_DapDate_2ef2849b:

    # _("Hombre") "Y obviamente, una vez deciden el vestido, tienen que decidir qué peinado le pega mejor a ese estilo. Media hora más. Espero que tengas batería en el móvil. *Risa*"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:305
translate brazilian c15s001_DapDate_0b486eb8:

    # mc "*Risa* Sí, por suerte voy servido de batería."
    mc "*Risos* Sim, felizmente tenho bastante bateria."

# game/scripts/c15/c15.rpy:307
translate brazilian c15s001_DapDate_3659900c:

    # _("Hombre") "Bueno, te dejo con tu espera. Ahí viene mi copiloto."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:308
translate brazilian c15s001_DapDate_021a7a94:

    # mc "Que pase una buena noche."
    mc "Tenha uma boa noite."

# game/scripts/c15/c15.rpy:309
translate brazilian c15s001_DapDate_00c9df17:

    # _("Hombre") "Igualmente, hijo."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:311
translate brazilian c15s001_DapDate_6397acfa:

    # "Elliot os lleva a diferentes salas de espera y te sientas a hacer tiempo hasta que [dap] esté preparada. Por lo que ha dicho el hombre en el vestuario, te tocará esperar un rato."
    "Elliot te leva a diferentes salas de espera, e você fica sentado matando tempo até que [dap] esteja pronto. Pelo que o homem no vestiário disse, você terá que esperar um pouco."

# game/scripts/c15/c15.rpy:313
translate brazilian c15s001_DapDate_82ffc13f:

    # "Cuando ya has leído todas las noticias locales, internacionales, sobre videojuegos, e incluso sobre la vida de los famosos..."
    "Quando você já leu todas as notícias locais e internacionais, sobre videogames e até mesmo sobre a vida das celebridades..."

# game/scripts/c15/c15.rpy:315
translate brazilian c15s001_DapDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:316
translate brazilian c15s001_DapDate_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Número oculto?)"

# game/scripts/c15/c15.rpy:330
translate brazilian c15s001_DapDate_27e07c02:

    # "Justo al colgar, oyes pasos en las escaleras por las que has bajado."
    "Assim que você desliga o telefone, ouve passos na escada por onde desceu."

# game/scripts/c15/c15.rpy:332
translate brazilian c15s001_DapDate_4c40f33f:

    # dap "¿Llevas mucho tiempo esperándome?"
    dap "Você estava me esperando há muito tempo?"

# game/scripts/c15/c15.rpy:342
translate brazilian c15s001_DapDate_f4004887:

    # mc "¡Wow, [dap]! ¡Pareces salida de un cuento de hadas! Estás preciosa."
    mc "Uau, [dap]! Você parece ter saído diretamente de um conto de fadas! Você é deslumbrante."

# game/scripts/c15/c15.rpy:343
translate brazilian c15s001_DapDate_4d29251f:

    # dap "¡Gracias, [mc]! Me preocupaba quedar ridícula."
    dap "Obrigada, [mc]! Eu estava preocupada que fosse parecer ridícula."

# game/scripts/c15/c15.rpy:345
translate brazilian c15s001_DapDate_76a5d3f6:

    # dap "Tú también estás muy guapo, pero no sé si va a ser cómodo cenar con la armadura."
    dap "Você também está muito bonito, mas não sei se seria confortável jantar usando armadura."

# game/scripts/c15/c15.rpy:346
translate brazilian c15s001_DapDate_8d6b7b9b:

    # mc "Me lo ha comentado el ayudante del vestuario, pero no podía dejarlo pasar."
    mc "A assistente no vestiário me contou sobre isso, mas eu não consegui esquecer."

# game/scripts/c15/c15.rpy:348
translate brazilian c15s001_DapDate_343db1df:

    # dap "Lástima que no hayas hecho a Vilfredo un guerrero o un paladín. Me hubiera gustado imaginarte así en la partida."
    dap "É uma pena que você não tenha feito do Vilfredo um guerreiro ou um paladino. Eu gostaria de ter imaginado você jogando com ele dessa forma no jogo."

# game/scripts/c15/c15.rpy:350
translate brazilian c15s001_DapDate_48b8e592:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿príncipe?"
    dap "Você também está muito bonito, o visual de príncipe combina perfeitamente com você..."

# game/scripts/c15/c15.rpy:351
translate brazilian c15s001_DapDate_d6612785:

    # mc "Oficialmente cortesano, pero si quieres que sea tu príncipe solo tienes que pedirlo."
    mc "Oficialmente um cortesão, mas se você quiser que ele seja seu príncipe, basta pedir."

# game/scripts/c15/c15.rpy:353
translate brazilian c15s001_DapDate_9cc03b0f:

    # dap "Lástima que no hayas hecho a Vilfredo noble. Me hubiera gustado imaginarte así en la partida."
    dap "É uma pena que você não tenha feito de Vilfredo um nobre. Eu gostaria de tê-lo imaginado assim no jogo."

# game/scripts/c15/c15.rpy:355
translate brazilian c15s001_DapDate_ea236d73:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿espadachín?"
    dap "Você também está muito bonito, o visual de espadachim combina perfeitamente com você...?"

# game/scripts/c15/c15.rpy:356
translate brazilian c15s001_DapDate_994e2502:

    # mc "Me lo han ofrecido como pícaro y, después de generar el personaje de Vilfredo, no podía dejarlo pasar. Quiero que vista parecido a esto, si es posible."
    mc "Eles me ofereceram o papel de ladino, e depois de criar o personagem Vilfredo, não pude recusar. Gostaria que ele se vestisse de forma semelhante a esta, se possível."

# game/scripts/c15/c15.rpy:358
translate brazilian c15s001_DapDate_93c0bc47:

    # dap "Ningún problema. No me perdería un pícaro tan guapo por nada del mundo."
    dap "Sem problema nenhum. Eu não perderia um malandro tão charmoso por nada neste mundo."

# game/scripts/c15/c15.rpy:359
translate brazilian c15s001_DapDate_e5242538:

    # mc "Vas a hacer que este pobre pícaro se ruborice. *Risa*"
    mc "Você vai fazer esse pobre coitado corar de vergonha. *Risos*"

# game/scripts/c15/c15.rpy:361
translate brazilian c15s001_DapDate_ec28650e:

    # dap "¿Pasamos a cenar? Tengo ganas de ver el restaurante."
    dap "Vamos jantar? Gostaria de conhecer o restaurante."

# game/scripts/c15/c15.rpy:362
translate brazilian c15s001_DapDate_c996350e:

    # mc "Cuando quieras. A mí me ha entrado hambre mientras esperaba. Pero la espera ha valido la pena."
    mc "Quando quiser. Fiquei com fome enquanto esperava. Mas a espera valeu a pena."

# game/scripts/c15/c15.rpy:365
translate brazilian c15s001_DapDate_08921eec:

    # dap "Gracias, mi amable caballero."
    dap "Obrigado, meu caro senhor."

# game/scripts/c15/c15.rpy:368
translate brazilian c15s001_DapDate_6cada05b:

    # dap "Gracias, mi apuesto príncipe."
    dap "Obrigada, meu lindo príncipe."

# game/scripts/c15/c15.rpy:371
translate brazilian c15s001_DapDate_dbf1df63:

    # dap "Gracias, mi pícaro seductor."
    dap "Obrigada, meu sedutor astuto."

# game/scripts/c15/c15.rpy:373
translate brazilian c15s001_DapDate_607ded3e:

    # "Llamáis al timbre y aparece alguien nuevo del personal."
    "Você toca a campainha e aparece alguém novo da equipe."

# game/scripts/c15/c15.rpy:374
translate brazilian c15s001_DapDate_d17bca35:

    # "Mathilda" "Buenas tardes les de Dios a vuesas mercedes. Mi nombre es Mathilda. Si tienen el placer de acompañarme, les guiaré a su mesa para que puedan disfrutar del yantar."
    "Mathilda" "Boa tarde, que Deus te abençoe. Meu nome é Mathilda. Se desejar, posso te acompanhar até a sua mesa para que possa desfrutar da sua refeição."

# game/scripts/c15/c15.rpy:376
translate brazilian c15s001_DapDate_e3023a37:

    # dap "Cuando quiera. Estamos listos."
    dap "Quando você estiver pronto. Nós estamos prontos."

# game/scripts/c15/c15.rpy:377
translate brazilian c15s001_DapDate_23a0c42a:

    # mc "*Susurrando* Ahora pillo lo del acento raro del tipo que me cogió el teléfono. Era este falso acento medieval."
    mc "*Sussurrando* Agora entendi o sotaque estranho do cara que atendeu o telefone. Era um sotaque medieval falso."

# game/scripts/c15/c15.rpy:379
translate brazilian c15s001_DapDate_f92c238c:

    # dap "De momento me está gustando, y eso que aún no hemos visto el restaurante."
    dap "Até agora estou gostando, mesmo sem termos visto o restaurante ainda."

# game/scripts/c15/c15.rpy:380
translate brazilian c15s001_DapDate_35cd64fb:

    # mc "El vestido te queda increíble, y el peinado te hace preciosa... más preciosa de lo habitual."
    mc "O vestido fica incrível em você, e seu penteado te deixa deslumbrante... ainda mais deslumbrante do que o normal."

# game/scripts/c15/c15.rpy:382
translate brazilian c15s001_DapDate_08e27722:

    # dap "Gracias, pero debería haberme quedado con mi trenza. También pega con el vestido y hubiera estado más cómoda. No me siento demasiado confortable con esto."
    dap "Obrigada, mas eu devia ter mantido a minha trança. Ela também combina com o vestido e eu teria me sentido mais confortável. Não me sinto muito confortável com este vestido."

# game/scripts/c15/c15.rpy:383
translate brazilian c15s001_DapDate_b7322079:

    # mc "Bueno, cuando volvamos al vestuario tendrás que devolver todo, incluidos los anillos del pelo. Solo será una hora o dos, ¿no?"
    mc "Certo, quando voltarmos ao vestiário, você terá que devolver tudo, inclusive os elásticos de cabelo. Vai levar só uma ou duas horas, né?"

# game/scripts/c15/c15.rpy:385
translate brazilian c15s001_DapDate_b001bca2:

    # "Atravesáis todo el restaurante y Mathilda os lleva a una zona que parece tranquila. El restaurante parece salido de una película. Al menos es una de aquellas películas donde todo está limpio."
    "Você atravessa todo o restaurante e Mathilda te conduz a uma área mais tranquila. O restaurante parece saído de um filme. Ou melhor, de um daqueles filmes em que tudo é impecável."

# game/scripts/c15/c15.rpy:387
translate brazilian c15s001_DapDate_f87f2ef8:

    # "Mathilda" "Hoy está bastante vacío, y esta es la zona más resguardada de miradas ajenas. ¿Les va bien sentarse aquí?"
    "Mathilda" "Está bem vazio hoje, e esta é a área mais isolada. Você se importaria de se sentar aqui?"

# game/scripts/c15/c15.rpy:388
translate brazilian c15s001_DapDate_39d84591:

    # mc "Gracias, Mathilda, es perfecto."
    mc "Obrigada, Mathilda, está perfeito."

# game/scripts/c15/c15.rpy:389
translate brazilian c15s001_DapDate_a8caf72d:

    # "Mathilda" "¿Saben cómo funciona el menú? Si quieren se lo explico."
    "Mathilda" "Você sabe como funciona o menu? Se quiser, posso explicar."

# game/scripts/c15/c15.rpy:390
translate brazilian c15s001_DapDate_8b13deee:

    # mc "Sí, por favor."
    mc "Sim, por favor."

# game/scripts/c15/c15.rpy:391
translate brazilian c15s001_DapDate_a1ac9ffa:

    # "Mathilda" "Nuestros platos son típicos de la Europa medieval, pero con un toque moderno, con lo que pueden encontrar ingredientes como patata o maíz, que no estaban disponibles en la época."
    "Mathilda" "Nossos pratos são típicos da Europa medieval, mas com um toque moderno, por isso você pode encontrar ingredientes como batatas ou milho, que não estavam disponíveis na época."

# game/scripts/c15/c15.rpy:392
translate brazilian c15s001_DapDate_72902248:

    # "Mathilda" "Nosotros recomendamos el menú degustación mixto, de carne, o de pescado, donde podrán disfrutar de algunas de nuestras especialidades. También pueden pedir platos individuales."
    "Mathilda" "Recomendamos o menu degustação misto, com opções de carne ou peixe, onde poderá desfrutar de algumas das nossas especialidades. Também pode encomendar pratos individuais."

# game/scripts/c15/c15.rpy:394
translate brazilian c15s001_DapDate_9603f8f9:

    # dap "Yo querré el menú degustación mixto. Y cerveza tostada para beber."
    dap "Vou querer o menu degustação misto. E uma cerveja escura para acompanhar."

# game/scripts/c15/c15.rpy:395
translate brazilian c15s001_DapDate_33d9f672:

    # mc "¿Qué platos individuales tienen? Cosas con carne, por favor."
    mc "Quais pratos individuais vocês têm? Pratos com carne, por favor."

# game/scripts/c15/c15.rpy:397
translate brazilian c15s001_DapDate_8f5494fa:

    # "Mathilda" "Tenemos asado del pastor, que lleva patata sustituyendo al nabo, cazuela del granjero, que lleva maíz para sustituir a la avena, chuletas con salsa de calabaza, o albóndigas de ternera."
    "Mathilda" "Temos assado de pastor, que usa batatas em vez de nabos, caçarola do fazendeiro, que usa milho em vez de aveia, costeletas com molho de abóbora ou almôndegas de carne."

# game/scripts/c15/c15.rpy:398
translate brazilian c15s001_DapDate_a9336dad:

    # "Mathilda" "El menú degustación de carne consiste en asado del pastor, cazuela del granjero y las albóndigas de ternera. Normalmente lo recomendamos para compartir entre dos personas."
    "Mathilda" "O menu degustação de carnes inclui rosbife de pastor, caçarola do fazendeiro e almôndegas de carne. Normalmente, recomendamos que seja compartilhado entre duas pessoas."

# game/scripts/c15/c15.rpy:399
translate brazilian c15s001_DapDate_841d565c:

    # "Mathilda" "Con una ensalada o unas verduras para compartir como complemento."
    "Mathilda" "Servido com salada ou legumes para compartilhar."

# game/scripts/c15/c15.rpy:400
translate brazilian c15s001_DapDate_044c02a7:

    # mc "¿Ensalada? ¿Verduras? *Risa* Esa es la comida de mi comida... Siempre he querido decir esa frase."
    mc "Salada? Legumes? *Risos* Essa é a minha comida... Sempre quis dizer isso."

# game/scripts/c15/c15.rpy:412
translate brazilian c15s001_DapDate_d26cabd8:

    # mc "Pero si algún plato lleva brócoli, no lo ponga, por favor. Soy alérgico."
    mc "Mas se algum prato contiver brócolis, por favor, não o inclua. Sou alérgico."

# game/scripts/c15/c15.rpy:413
translate brazilian c15s001_DapDate_0b9b511f:

    # "Mathilda" "Como vuesa merced desee. ¿Para beber, señor?"
    "Mathilda" "Como desejar. Gostaria de beber algo, senhor?"

# game/scripts/c15/c15.rpy:414
translate brazilian c15s001_DapDate_40c4e7c6:

    # mc "Agua. Tengo que conducir luego."
    mc "Água. Preciso dirigir mais tarde."

# game/scripts/c15/c15.rpy:416
translate brazilian c15s001_DapDate_f4abf09d:

    # dap "Tráigale una cerveza tostada también a él. Vamos a tardar mucho en coger el coche."
    dap "Traga também uma cerveja escura para ele. Vai demorar um pouco para chegarmos ao carro."

# game/scripts/c15/c15.rpy:418
translate brazilian c15s001_DapDate_5663e49e:

    # "Mathilda" "Perfecto. Voy a cursar su pedido y ahora mismo les traigo la bebida."
    "Mathilda" "Perfeito. Vou processar seu pedido e trazer as bebidas imediatamente."

# game/scripts/c15/c15.rpy:420
translate brazilian c15s001_DapDate_ec98a50b:

    # dap "¿Desde cuándo eres alérgico al brócoli? No lo sabía."
    dap "Desde quando você tem alergia a brócolis? Eu não sabia disso."

# game/scripts/c15/c15.rpy:421
translate brazilian c15s001_DapDate_f6a5786d:

    # mc "*Risa* No soy alérgico, pero para mí estropea cualquier comida. Siempre digo \"si lleva brócoli no lo pongan\" y la mitad de las veces se olvidan."
    mc "*Risos* Eu não sou alérgica, mas para mim estraga qualquer refeição. Eu sempre digo \"se tiver brócolis, não coloque\" e metade das vezes eles esquecem."

# game/scripts/c15/c15.rpy:422
translate brazilian c15s001_DapDate_4db266ee:

    # mc "Diciendo que soy alérgico, van con cuidado de no ponerlo. No se han olvidado ni una sola vez."
    mc "Como digo que sou alérgica, eles tomam cuidado para não aplicar o produto. Eles nunca se esqueceram disso."

# game/scripts/c15/c15.rpy:423
translate brazilian c15s001_DapDate_de7990a8:

    # dap "Es una buena idea. Poco honesta, pero buena idea. Aunque si pidiéndolo correctamente no te hacen caso, es la única forma que te queda de hacerlo."
    dap "É uma boa ideia. Um pouco desonesta, mas uma boa ideia. Embora, se eles não derem ouvidos quando você pedir direito, é o único jeito de conseguir."

# game/scripts/c15/c15.rpy:425
translate brazilian c15s001_DapDate_0799ddb5:

    # dap "Cambiando de tema, ¿qué te parece el sitio? Es original, ¿verdad?"
    dap "Mudando de assunto, o que você acha do site? É original, não é?"

# game/scripts/c15/c15.rpy:426
translate brazilian c15s001_DapDate_71dbec9b:

    # mc "Es muy original, e ir así vestidos le da un giro interesante, es como si tuvieras una inmersión total."
    mc "É muito original, e ir vestido assim dá um toque interessante; é como uma imersão total."

# game/scripts/c15/c15.rpy:427
translate brazilian c15s001_DapDate_6ef36d5e:

    # dap "Yo siempre he querido probar algo así, sentirte dentro de una partida de DnD, aunque solo sea durante la cena."
    dap "Sempre quis experimentar algo assim, para me sentir como se estivesse dentro de um jogo de D&D, mesmo que seja apenas durante o jantar."

# game/scripts/c15/c15.rpy:428
translate brazilian c15s001_DapDate_4951d89e:

    # mc "Si en la partida visitamos una taberna o una posada, será difícil imaginársela diferente a esto."
    mc "Se durante o jogo visitarmos uma taverna ou uma estalagem, será difícil imaginá-la de outra forma."

# game/scripts/c15/c15.rpy:430
translate brazilian c15s001_DapDate_4bc16d01:

    # dap "Esa era una de las razones para traerte aquí. *Risa* Quiero que sepas qué cosas me gustan. No hemos tenido mucho tiempo de hablar de hobbies y nimiedades."
    dap "Esse foi um dos motivos pelos quais te trouxe aqui. *Risos* Quero que você saiba do que eu gosto. Não tivemos muito tempo para falar sobre hobbies e coisas triviais."

# game/scripts/c15/c15.rpy:431
translate brazilian c15s001_DapDate_40e70b21:

    # mc "Bueno, sé que te gusta estudiar, leer y aprender, los videojuegos, los juegos de rol... ¿la música pop?"
    mc "Bem, eu sei que você gosta de estudar, ler e aprender, videogames, jogos de RPG... música pop?"

# game/scripts/c15/c15.rpy:432
translate brazilian c15s001_DapDate_f77f275c:

    # dap "*Risa* Sí, la música pop. Si llegas a fallar en eso... Te hubiera torturado con los peores discos de Taylor Shift. *Risa*"
    dap "*Risos* É, música pop. Se você falhasse nisso... eu teria te torturado com os piores álbuns do Taylor Shift. *Risos*"

# game/scripts/c15/c15.rpy:434
translate brazilian c15s001_DapDate_0ae8448f:

    # dap "Pero a lo que me refiero es a que me encanta este ambiente. Hacer cosas diferentes. No soy tan aventurera como [emm], pero en un sitio así me siento... especial."
    dap "Mas o que eu quero dizer é que adoro esta atmosfera. Fazer coisas diferentes. Não sou tão aventureiro quanto [emm], mas num lugar como este eu me sinto... especial."

# game/scripts/c15/c15.rpy:435
translate brazilian c15s001_DapDate_70fffa0f:

    # mc "[dap], tú eres especial. Nunca se me hubiera ocurrido venir a un restaurante así, con lo que la noche ya es diferente."
    mc "[dap], você é especial. Eu nunca teria pensado em vir a um restaurante como este, então a noite já está diferente."

# game/scripts/c15/c15.rpy:436
translate brazilian c15s001_DapDate_251aa2ff:

    # mc "Pasarla contigo, vestida así, la hace verdaderamente especial."
    mc "Passar esse tempo com você, vestida assim, torna tudo verdadeiramente especial."

# game/scripts/c15/c15.rpy:438
translate brazilian c15s001_DapDate_7937683b:

    # dap "No creía que vestirme de molinera para una cita fuera lo mejor, lo mismo que de tabernera. Imagínate que las otras mesas empiezan a pedirme cosas. *Risa*"
    dap "Não achei que me vestir de esposa de moleiro para um encontro fosse a melhor ideia, nem de garçonete de taverna. Imagina se as outras mesas começassem a me pedir coisas! *Risos*"

# game/scripts/c15/c15.rpy:439
translate brazilian c15s001_DapDate_5e2c75b5:

    # mc "Vestida de tabernera seguro que estabas monísima, pero no puedo imaginarme a una molinera sexy. *Risa* Ni siquiera a ti."
    mc "Vestida de taberneira, você devia estar adorável, mas não consigo imaginar você como uma esposa de moleiro sexy. *Risos* Nem você."

# game/scripts/c15/c15.rpy:440
translate brazilian c15s001_DapDate_51b8bcd3:

    # dap "Había un disfraz de guerrera, pero seguía la norma de Hollywood para las armaduras femeninas de que cuanto menos cubra más protege. *Risa*"
    dap "Havia uma fantasia de guerreira, mas seguia a regra de Hollywood para armaduras femininas: quanto menos cobre, mais protege. *Risos*"

# game/scripts/c15/c15.rpy:441
translate brazilian c15s001_DapDate_f95f3509:

    # mc "Interesante. No me hubiera importado verte así. *Risa*"
    mc "Interessante. Eu não me importaria de te ver assim. *Risos*"

# game/scripts/c15/c15.rpy:442
translate brazilian c15s001_DapDate_0c601860:

    # dap "No seas impaciente. *Risa* Me verás con menos cobertura hoy... si quieres..."
    dap "Não se impaciente. *Risos* Você me verá com menos cobertura hoje... se quiser..."

# game/scripts/c15/c15.rpy:443
translate brazilian c15s001_DapDate_a49f5d57:

    # mc "Por supuesto que quiero, si es lo que quieres tú."
    mc "Claro que quero, se é isso que você quer."

# game/scripts/c15/c15.rpy:445
translate brazilian c15s001_DapDate_8433b02a:

    # dap "Llevo deseándolo desde nuestra segunda lección. Con lo que sí. Es lo que quiero."
    dap "Eu queria isso desde a nossa segunda aula. Então, sim. É isso que eu quero."

# game/scripts/c15/c15.rpy:446
translate brazilian c15s001_DapDate_7e494062:

    # mc "Yo también llevo tiempo deseándolo."
    mc "Eu também já queria isso há algum tempo."

# game/scripts/c15/c15.rpy:447
translate brazilian c15s001_DapDate_9a30c032:

    # "Justo en ese momento, Mathilda trae las cervezas."
    "Nesse instante, Mathilda traz as cervejas."

# game/scripts/c15/c15.rpy:449
translate brazilian c15s001_DapDate_849e9eb6:

    # dap "Por una noche especial con mi novio. Mi primer novio."
    dap "Para uma noite especial com meu namorado. Meu primeiro namorado."

# game/scripts/c15/c15.rpy:450
translate brazilian c15s001_DapDate_4fab5f29:

    # mc "Por la chica más especial de la noche."
    mc "Para a garota mais especial da noite."

# game/scripts/c15/c15.rpy:452
translate brazilian c15s001_DapDate_f9c75c73:

    # dap "¡Está buenísima!"
    dap "É delicioso!"

# game/scripts/c15/c15.rpy:453
translate brazilian c15s001_DapDate_f057ccd6:

    # mc "*Risa*"
    mc "*Risada*"

# game/scripts/c15/c15.rpy:455
translate brazilian c15s001_DapDate_a147bdfe:

    # dap "¿Qué pasa?"
    dap "O que está acontecendo?"

# game/scripts/c15/c15.rpy:456
translate brazilian c15s001_DapDate_adaea1c1:

    # mc "Que estás super graciosa con el bigote de espuma, aunque no te pega con el vestido. *Risa* Te pegaría más con un uniforme de fontanero y una gorra roja."
    mc "Você fica tão engraçada com esse bigode de espuma, embora não combine muito com o vestido. *Risos* Ficaria melhor em você com um uniforme de encanador e um boné vermelho."

# game/scripts/c15/c15.rpy:458
translate brazilian c15s001_DapDate_55ee868d:

    # dap "¡Oops, perdón! *Risa* Tendré que beber como una princesita."
    dap "Ops, desculpe! *Risos* Vou ter que beber como uma princesa."

# game/scripts/c15/c15.rpy:459
translate brazilian c15s001_DapDate_536b041f:

    # mc "*Risa*. Ya te he dicho que estabas muy graciosa."
    mc "*Risos*. Eu já te disse que você é muito engraçado."

# game/scripts/c15/c15.rpy:461
translate brazilian c15s001_DapDate_2be763cd:

    # dap "Pero no quiero estar graciosa. Quiero estar guapa y sexy para ti en nuestra primera cita."
    dap "Mas eu não quero parecer fofa. Quero estar linda e sexy para você no nosso primeiro encontro."

# game/scripts/c15/c15.rpy:462
translate brazilian c15s001_DapDate_9b23af18:

    # mc "[dap], ya te he dicho que estabas preciosa. Y lo de estar sexy lo llevas dentro, no tienes que hacer nada especial para estarlo."
    mc "[dap], Eu já te disse que você estava linda. E você é naturalmente sexy, não precisa fazer nada de especial para ser sexy."

# game/scripts/c15/c15.rpy:464
translate brazilian c15s001_DapDate_7a902e65:

    # dap "Entonces, ¿me harías el amor esta noche, aunque no llevase este vestido?"
    dap "Então, você faria amor comigo esta noite, mesmo que eu não estivesse usando este vestido?"

# game/scripts/c15/c15.rpy:465
translate brazilian c15s001_DapDate_87bc4363:

    # mc "Espero que cuando hagamos el amor no lo lleves. *Risa* Pero sí, te haría el amor aunque fueras con un saco de patatas en vez de con ese vestido."
    mc "Espero que você não esteja usando isso quando fizermos amor. *Risos* Mas sim, eu faria amor com você mesmo se você estivesse usando um saco de batatas em vez desse vestido."

# game/scripts/c15/c15.rpy:467
translate brazilian c15s001_DapDate_b4286511:

    # dap "Perfecto, porque no pienso dejarte escapar esta noche."
    dap "Perfeito, porque não pretendo deixar você escapar esta noite."

# game/scripts/c15/c15.rpy:468
translate brazilian c15s001_DapDate_c00e8be0:

    # mc "No tengo intención de escaparme. Esta noche soy todo para ti."
    mc "Não tenho intenção de fugir. Esta noite sou toda sua."

# game/scripts/c15/c15.rpy:470
translate brazilian c15s001_DapDate_5661754e:

    # dap "Sabes que, si seguimos hablando de esto, voy a estar pensando en lo que pasará después toda la cena, ¿verdad?"
    dap "Você sabe que se continuarmos falando sobre isso, vou ficar pensando no que vai acontecer durante todo o jantar, não é?"

# game/scripts/c15/c15.rpy:471
translate brazilian c15s001_DapDate_1c835586:

    # mc "¿Quieres cambiar de tema?"
    mc "Deseja mudar de assunto?"

# game/scripts/c15/c15.rpy:473
translate brazilian c15s001_DapDate_402ecb75:

    # dap "El problema es que ahora mismo solo me apetece hablar sobre nosotros y de nuestra relación."
    dap "O problema é que, neste momento, eu só quero falar sobre nós e sobre o nosso relacionamento."

# game/scripts/c15/c15.rpy:474
translate brazilian c15s001_DapDate_f01e22f5:

    # dap "Sobre qué piensas que va a pasar con nosotros... somos primos..."
    dap "O que você acha que vai acontecer conosco... somos primos..."

# game/scripts/c15/c15.rpy:475
translate brazilian c15s001_DapDate_8e9f18ea:

    # mc "Me da lo mismo que lo seamos, [dap]."
    mc "Não me importo se somos, [dap]."

# game/scripts/c15/c15.rpy:477
translate brazilian c15s001_DapDate_81e21e06:

    # mc "Y más teniendo en cuenta que los dos sabemos que no lo somos."
    mc "E ainda mais considerando que ambos sabemos que não somos."

# game/scripts/c15/c15.rpy:479
translate brazilian c15s001_DapDate_15000879:

    # dap "Lo sé, pero todo el mundo piensa que sí. Bueno, todo el mundo no. Mi madre lo sabe y lógicamente la tuya también... y la abuela... y Tía Betty, supongo... Y a Scarlett se lo dije yo."
    dap "Eu sei, mas todo mundo pensa assim. Bem, nem todo mundo. Minha mãe sabe, e logicamente a sua também... e a vovó... e a tia Betty, eu acho... E eu contei para a Scarlett."

# game/scripts/c15/c15.rpy:482
translate brazilian c15s001_DapDate_cbdc2f5d:

    # dap "Pero ¿qué pensará la gente si lo hacemos público? ¿Mi hermana o la tuya? ¿Eileen o Jamaal? Ya viste las caras de las estudiantes cuando me besaste durante el juego."
    dap "Mas o que as pessoas vão pensar se tornarmos isso público? Minha irmã ou a sua? Eileen ou Jamaal? Você viu a cara dos alunos quando me beijou durante o jogo."

# game/scripts/c15/c15.rpy:483
translate brazilian c15s001_DapDate_ec193f05:

    # mc "¿Te soy sincero? No me importa lo que piensen. Lo único que deben pensar es que estoy con una chica maravillosa que me hace feliz."
    mc "Sinceramente, não me importo com o que eles pensam. A única coisa que eles deveriam pensar é que estou com uma garota maravilhosa que me faz feliz."

# game/scripts/c15/c15.rpy:484
translate brazilian c15s001_DapDate_4b28ab0d:

    # mc "Quiero pasar el resto de mi vida contigo, [dap]. Quiero que envejezcamos juntos. Quiero que sepas lo importante que eres para mí. Y quiero que todo el mundo lo sepa también."
    mc "Quero passar o resto da minha vida com você. Quero que envelheçamos juntos. Quero que você saiba o quanto é importante para mim. E quero que todos saibam disso também."

# game/scripts/c15/c15.rpy:485
translate brazilian c15s001_DapDate_6e91adb8:

    # mc "¿Y a ti? ¿Te importa lo que piensen los demás?"
    mc "E você? Se importa com o que os outros pensam?"

# game/scripts/c15/c15.rpy:487
translate brazilian c15s001_DapDate_b25e09cd:

    # dap "Después de lo que acabas de decir... no debería decir que me importe... pero me importa. No sé cómo decírselo a mi hermana. O al resto de la familia."
    dap "Depois do que você acabou de dizer... eu não deveria dizer que me importo... mas me importo. Não sei como contar para minha irmã. Ou para o resto da família."

# game/scripts/c15/c15.rpy:488
translate brazilian c15s001_DapDate_da0cbb2a:

    # dap "Quiero hacerlo, pero no sé cómo... cualquier escenario que en el que puedo pensar acaba en discusión... con mi madre, con la tuya, con la abuela..."
    dap "Eu quero fazer isso, mas não sei como... todos os cenários que consigo imaginar terminam em discussão... com a minha mãe, com a sua, com a sua avó..."

# game/scripts/c15/c15.rpy:489
translate brazilian c15s001_DapDate_0962fc03:

    # mc "Se lo puedes decir con un beso..."
    mc "Você pode dizer isso com um beijo..."

# game/scripts/c15/c15.rpy:491
translate brazilian c15s001_DapDate_5d11e3dd:

    # dap "¡[mc]! ¡Ya te dije que no beso a chicas! ¡Lo de Scarlett fue solo para aprender!"
    dap "[mc]! Eu já te disse que não beijo garotas! O que eu fiz com a Scarlett foi só para aprender!"

# game/scripts/c15/c15.rpy:492
translate brazilian c15s001_DapDate_56c18a7f:

    # mc "*Risa* No me refería a que las besaras a ellas, sino a que me besaras a mí delante de ellas."
    mc "*Risos* Eu não queria que você os beijasse, mas sim que me beijasse na frente deles."

# game/scripts/c15/c15.rpy:494
translate brazilian c15s001_DapDate_7d70a208:

    # "La conversación es interrumpida por Mathilda, que llega con la comida."
    "A conversa é interrompida por Mathilda, que chega trazendo a comida."

# game/scripts/c15/c15.rpy:495
translate brazilian c15s001_DapDate_c957812e:

    # "Mathilda" "Aquí traigo su yantar. Disfruten de nuestros manjares. ¿Puedo ofrecerles algo más a vuesas mercedes?"
    "Mathilda" "Aqui está sua refeição. Aproveite nossas iguarias. Posso lhe oferecer mais alguma coisa?"

# game/scripts/c15/c15.rpy:497
translate brazilian c15s001_DapDate_370648d3:

    # dap "Por mí no, gracias. Esto tiene una pinta deliciosa."
    dap "Não, obrigada. Isso parece delicioso."

# game/scripts/c15/c15.rpy:498
translate brazilian c15s001_DapDate_7abb4579:

    # mc "Por mí tampoco, gracias."
    mc "Eu também não, obrigado."

# game/scripts/c15/c15.rpy:500
translate brazilian c15s001_DapDate_0871ec30:

    # dap "Esto tiene una pinta excelente. ¿Qué tal lo tuyo?"
    dap "Isso parece ótimo. Como vão as coisas para você?"

# game/scripts/c15/c15.rpy:511
translate brazilian c15s001_DapDate_3d866d0f:

    # mc "Tiene muy buena pinta. Cuidan hasta el mínimo detalle, fíjate en los platos."
    mc "Está tudo muito bonito. Eles prestam atenção até aos mínimos detalhes, basta olhar para os pratos."

# game/scripts/c15/c15.rpy:513
translate brazilian c15s001_DapDate_e06be625:

    # dap "Ya te he dicho que tenía ganas de venir. Los comentarios en ThreeSquare eran muy buenos para un sitio que lleva tan poco tiempo abierto. ¿Empezamos?"
    dap "Eu já te disse que estava ansioso para vir. As avaliações no Threesquare eram muito boas para um lugar que abriu há tão pouco tempo. Vamos começar?"

# game/scripts/c15/c15.rpy:514
translate brazilian c15s001_DapDate_e8380814:

    # mc "Sí, pero estábamos hablando de hacer público lo nuestro."
    mc "Sim, mas estávamos falando sobre tornar nosso relacionamento público."

# game/scripts/c15/c15.rpy:516
translate brazilian c15s001_DapDate_8dc912e1:

    # dap "Sí, y tú has dicho que te bese delante de mi madre o de [eri]. *Risa* Estás loco. ¿O crees que soy tonta?"
    dap "Sim, e você disse que eu deveria te beijar na frente da minha mãe ou [eri]. *Risos* Você é louco. Ou acha que eu sou estúpido?"

# game/scripts/c15/c15.rpy:518
translate brazilian c15s001_DapDate_ac41c310:

    # mc "No es tan mala idea. Ha funcionado con anterioridad."
    mc "Não é uma ideia tão ruim. Já funcionou antes."

# game/scripts/c15/c15.rpy:520
translate brazilian c15s001_DapDate_1faf8f84:

    # dap "{b}¿Qué? ¿Quién? ¿Cuándo?{/b} ¿Cómo se lo tomaron?"
    dap "{b}O quê? Quem? Quando?{/b} Como eles tomaram isso?"

# game/scripts/c15/c15.rpy:521
translate brazilian c15s001_DapDate_6f4149b0:

    # mc "Sigo vivo, con lo que la cosa no acabó mal. *Risa*"
    mc "Ainda estou vivo, então não terminou mal. *Risos*"

# game/scripts/c15/c15.rpy:523
translate brazilian c15s001_DapDate_9273e56e:

    # mc "No me parece una mala idea. Eres tú quien tiene que decidir si quieres que lo sepan y cuando quieres que lo sepan."
    mc "Não acho que seja uma má ideia. Cabe a você decidir se e quando quer que eles saibam."

# game/scripts/c15/c15.rpy:525
translate brazilian c15s001_DapDate_f6f171e5:

    # dap "Yo no podría hacerlo. Sabes que soy más de hablar que de actuar."
    dap "Eu não conseguiria. Sabe, eu falo mais do que ajo."

# game/scripts/c15/c15.rpy:526
translate brazilian c15s001_DapDate_8adad7a1:

    # mc "Entonces tendremos que buscar el momento correcto para explicarlo. O puedo besarte yo."
    mc "Então teremos que encontrar o momento certo para explicar. Ou posso te dar um beijo."

# game/scripts/c15/c15.rpy:527
translate brazilian c15s001_DapDate_f1a13d58:

    # dap "Prefiero hablarlo, a ser posible de una en una. Primero [eri], después mi madre. Con un poco de suerte cuando le toque a la abuela ya estará de nuevo en Florida."
    dap "Prefiro falar sobre isso, se possível, uma pessoa de cada vez. Primeiro minha mãe, depois minha avó. Com sorte, quando chegar a vez da minha avó, ela já estará de volta à Flórida."

# game/scripts/c15/c15.rpy:528
translate brazilian c15s001_DapDate_2ee09558:

    # mc "¡Cuánto miedo le tenéis todas a Meemaw!"
    mc "Como vocês têm medo da vovó!"

# game/scripts/c15/c15.rpy:530
translate brazilian c15s001_DapDate_fcd16a07:

    # dap "¿Le tenemos? ¿Todas? ¿Quién más?"
    dap "Temos todos eles? Quem mais?"

# game/scripts/c15/c15.rpy:531
translate brazilian c15s001_DapDate_9eeedcfb:

    # mc "Ermmm... tu madre, por ejemplo. Desde que sabemos que venía, ha estado preocupada sobre lo que diría sobre la casa... y esas cosas..."
    mc "Hum... sua mãe, por exemplo. Desde que descobrimos que ela viria, ela está preocupada com o que diria sobre a casa... e coisas do tipo..."

# game/scripts/c15/c15.rpy:533
translate brazilian c15s001_DapDate_743b8e3d:

    # dap "Ah, vale, te refieres a eso. ¡Qué susto! Creía que te referías a que estabas con alguien más de la familia... y no estoy preguntando porque sé que no vas a contestar."
    dap "Ah, entendi, então é isso que você quer dizer. Que susto! Pensei que você estivesse com outra pessoa da família... e não estou perguntando porque sei que você não vai responder."

# game/scripts/c15/c15.rpy:535
translate brazilian c15s001_DapDate_6b4a6a87:

    # dap "Pero volviendo al tema encima de la mesa. Tú querrías hacerlo público y yo no estoy preparada. ¿Te importa que nos lo tomemos con calma?"
    dap "Mas voltando ao assunto principal. Você gostaria de tornar isso público, e eu não estou pronto. Você se importaria se fizéssemos as coisas com calma?"

# game/scripts/c15/c15.rpy:536
translate brazilian c15s001_DapDate_a38cc4aa:

    # mc "Mientras me sigas dejando disfrutar de tu compañía, mientras me dejes seguir besándote y acariciándote, no me importa quién lo sepa."
    mc "Contanto que você me permita desfrutar da sua companhia, contanto que você me permita continuar te beijando e acariciando, não me importo com quem saiba."

# game/scripts/c15/c15.rpy:537
translate brazilian c15s001_DapDate_f8bd74f2:

    # mc "¿Preferiría poder llegar a casa y decírselo a todo el mundo? Por supuesto, pero no te voy a forzar a ello."
    mc "Você prefere poder ir para casa e contar para todo mundo? Claro, mas eu não vou te obrigar a fazer isso."

# game/scripts/c15/c15.rpy:539
translate brazilian c15s001_DapDate_4816d419:

    # dap "Gracias, [mc]."
    dap "Obrigado, [mc]."

# game/scripts/c15/c15.rpy:540
translate brazilian c15s001_DapDate_6811d74a:

    # dap "Cambiando de tema, ¿cómo nos ves en cinco años?"
    dap "Mudando de assunto, como você nos vê daqui a cinco anos?"

# game/scripts/c15/c15.rpy:541
translate brazilian c15s001_DapDate_66e93671:

    # mc "Eso es más una pregunta para una entrevista de trabajo que para una cita. *Risa* Pero es fácil de contestar."
    mc "Essa é mais uma pergunta de entrevista de emprego do que uma pergunta para um encontro. *Risos* Mas é fácil de responder."

# game/scripts/c15/c15.rpy:544
translate brazilian c15s001_DapDate_58ea6be9:

    # mc "Me gustaría tener, como mínimo, una pequeña [dap] correteando por casa."
    mc "Eu gostaria de ter, pelo menos, um pequeno [dap] correndo pela casa."

# game/scripts/c15/c15.rpy:545
translate brazilian c15s001_DapDate_8513a3d6:

    # mc "Me gustaría que hubieras acabado tus estudios y encontrases algún trabajo que te llenara en un sitio donde pudiéramos estar juntos."
    mc "Eu gostaria que você tivesse terminado seus estudos e encontrado um emprego que te realizasse em um lugar onde pudéssemos estar juntos."

# game/scripts/c15/c15.rpy:547
translate brazilian c15s001_DapDate_a91faff1:

    # mc "Me gustaría que mirásemos hacia atrás, a esta noche, y pensáramos \"¿Ya han pasado cinco años?\" y nos sorprendiéramos."
    mc "Gostaria que olhássemos para trás, para esta noite, e pensássemos: \"Já se passaram cinco anos?\" e nos surpreendêssemos."

# game/scripts/c15/c15.rpy:549
translate brazilian c15s001_DapDate_664e0fa8:

    # mc "Me gustaría que de lo único que nos arrepintiéramos fuera de no haber empezado antes, de haber desperdiciado unos preciosos días juntos."
    mc "Gostaria que nosso único arrependimento fosse não termos começado antes, por termos desperdiçado alguns dias preciosos juntos."

# game/scripts/c15/c15.rpy:551
translate brazilian c15s001_DapDate_7928fb23:

    # dap "¡Joder, [mc]! ¡No podías haber dicho algo más bonito!"
    dap "Puxa, [mc]! Você não poderia ter dito nada mais gentil!"

# game/scripts/c15/c15.rpy:552
translate brazilian c15s001_DapDate_00a4148f:

    # mc "No se lo podía haber dicho a alguien más bonita."
    mc "Eu não poderia ter dito isso para alguém mais bonita."

# game/scripts/c15/c15.rpy:554
translate brazilian c15s001_DapDate_ff938204:

    # dap "¡Un brindis porque todo lo que has dicho se cumpla!"
    dap "Um brinde a tudo o que você disse que se tornará realidade!"

# game/scripts/c15/c15.rpy:555
translate brazilian c15s001_DapDate_299c3501:

    # mc "¡Brindo por ello!"
    mc "Um brinde a isso!"

# game/scripts/c15/c15.rpy:557
translate brazilian c15s001_DapDate_4f20587c:

    # dap "Veo que lo de beber como una princesa no se me da bien. A lo mejor puedo trabajar aquí de tabernera. *Risa*"
    dap "Acho que beber como uma princesa não é o meu forte. Talvez eu pudesse trabalhar aqui como garçonete. *Risos*"

# game/scripts/c15/c15.rpy:558
translate brazilian c15s001_DapDate_c5a66d6b:

    # mc "Es posible. *Risa* Pero siempre serás mi princesa. Tengo una duda."
    mc "É possível. *Risos* Mas você sempre será minha princesa. Eu tenho uma pergunta."

# game/scripts/c15/c15.rpy:559
translate brazilian c15s001_DapDate_031bfa8a:

    # dap "Dime."
    dap "Diga-me."

# game/scripts/c15/c15.rpy:561
translate brazilian c15s001_DapDate_3b5ddfbc:

    # mc "Has brindado por que se cumpla todo. ¿Todo? ¿Incluida la pequeña [dap]?"
    mc "Você fez um brinde à realização de todos os seus sonhos. Todos? Inclusive o bebê?"

# game/scripts/c15/c15.rpy:563
translate brazilian c15s001_DapDate_80f8b652:

    # dap "*Susurrando* ¿Tú has traído condones? Porque yo no estoy con la pastilla, nunca la he necesitado, y no voy a empezar ahora."
    dap "*Sussurrando* Você trouxe camisinhas? Porque eu não tomo pílula, nunca precisei e não vou começar agora."

# game/scripts/c15/c15.rpy:564
translate brazilian c15s001_DapDate_d1122d1c:

    # mc "No, no he traído."
    mc "Não, não trouxe nenhum."

# game/scripts/c15/c15.rpy:566
translate brazilian c15s001_DapDate_31abef77:

    # dap "Entonces podemos ir a comprarlos cuando acabemos de cenar, o podemos hacer el primer intento de hacer a la pequeña [dap]."
    dap "Então podemos ir comprá-los quando terminarmos o jantar, ou podemos fazer a primeira tentativa de fazer o pequeno [dap]."

# game/scripts/c15/c15.rpy:567
translate brazilian c15s001_DapDate_d61cf959:

    # dap "Hoy quiero hacer el amor contigo, si quieres con condón, si quieres sin. No me da miedo quedarme embarazada. Sé que voy a pasar el resto de mi vida contigo."
    dap "Hoje quero fazer amor com você, com camisinha se você quiser, ou sem se preferir. Não tenho medo de engravidar. Sei que vou passar o resto da minha vida com você."

# game/scripts/c15/c15.rpy:568
translate brazilian c15s001_DapDate_774417e9:

    # dap "Y no quiero que, dentro de cinco años, cuando miremos hacia atrás, a esta noche, nos arrepintamos de no haberlo hecho."
    dap "E eu não quero que, daqui a cinco anos, olhemos para trás e nos arrependamos de não termos feito isso."

# game/scripts/c15/c15.rpy:569
translate brazilian c15s001_DapDate_81d9ec17:

    # dap "La pequeña [dap] va a tener una gran familia. Quiero que la disfrute el máximo de tiempo posible."
    dap "A pequena [dap] vai ter uma família grande. Quero que ela aproveite isso pelo máximo de tempo possível."

# game/scripts/c15/c15.rpy:570
translate brazilian c15s001_DapDate_cb2a79b5:

    # mc "Sabes que ahora mismo me podría levantar y besarte, ¿verdad?"
    mc "Você sabe que eu poderia me levantar e te beijar agora mesmo, não é?"

# game/scripts/c15/c15.rpy:572
translate brazilian c15s001_DapDate_9f80b391:

    # dap "Después del discurso que acabo de soltar, me están temblando las piernas. Pero si te levantas y me besas, nos vamos a tener que ir sin acabar de cenar. Dudo que pudiera parar."
    dap "Depois desse discurso que acabei de fazer, minhas pernas estão tremendo. Mas se você se levantar e me beijar, teremos que ir embora sem terminar o jantar. Duvido que eu consiga parar."

# game/scripts/c15/c15.rpy:573
translate brazilian c15s001_DapDate_14cf106f:

    # dap "Mejor guarda esos besos para cuando estemos solos. Los vas a necesitar."
    dap "Guarde esses beijos para quando estivermos a sós. Você vai precisar deles."

# game/scripts/c15/c15.rpy:574
translate brazilian c15s001_DapDate_f393e816:

    # mc "No te preocupes, no se agotan."
    mc "Não se preocupe, eles não acabam."

# game/scripts/c15/c15.rpy:575
translate brazilian c15s001_DapDate_02d88677:

    # mc "¿Tienes pensado algún nombre para la pequeña [dap]?"
    mc "Já pensou em um nome para o bebê?"

# game/scripts/c15/c15.rpy:577
translate brazilian c15s001_DapDate_a53f9b89:

    # dap "Sí. Me gustan Maeve y Claire. También me gusta Hope, pero es un nombre que [eri] siempre ha querido ponerle a nuestra hermana, si mi madre encontraba a alguien."
    dap "Sim. Eu gosto de Maeve e Claire. Também gosto de Hope, mas é um nome que [eri] sempre quis dar à nossa irmã, caso minha mãe encontrasse alguém."

# game/scripts/c15/c15.rpy:578
translate brazilian c15s001_DapDate_995bee38:

    # dap "Supongo que con la edad que tiene mi madre, ese nombre pasará a la hija de [eri] cuando ella encuentre un chico que valga la mitad de lo que vales tú."
    dap "Suponho que, dada a idade da minha mãe, esse nome passará para a filha de [eri] quando ela encontrar um rapaz que valha metade do que você vale."

# game/scripts/c15/c15.rpy:579
translate brazilian c15s001_DapDate_5c01de9c:

    # mc "Me gustan los dos nombres. *Risa* Podemos seguir tu tradición familiar y tener gemelas."
    mc "Gosto dos dois nomes. *Risos* Podemos seguir a tradição da sua família e ter gêmeos."

# game/scripts/c15/c15.rpy:581
translate brazilian c15s001_DapDate_f9bc189f:

    # dap "Si pudiera elegirlo, las tendría. *Risa* Pero no es algo que se elija."
    dap "Se eu pudesse escolher, eu os teria. *Risos* Mas não é algo que se escolha."

# game/scripts/c15/c15.rpy:582
translate brazilian c15s001_DapDate_33851ada:

    # mc "Lo sé, pero sería bonito tener dos pequeñas [dap] correteando por casa en vez de solo una."
    mc "Eu sei, mas seria bom ter duas crianças pequenas correndo pela casa em vez de apenas uma."

# game/scripts/c15/c15.rpy:583
translate brazilian c15s001_DapDate_d208f71f:

    # dap "Sí, sería bonito... pero todo se andará."
    dap "Sim, seria ótimo... mas tudo vai dar certo."

# game/scripts/c15/c15.rpy:584
translate brazilian c15s001_DapDate_cb7cbdfc:

    # mc "Sobre lo del trabajo, sé que vas a estudiar Química. ¿De qué quieres trabajar? ¿Qué posibilidades laborales tienes en Newport?"
    mc "Em relação ao trabalho, sei que você vai estudar Química. Que tipo de trabalho você quer fazer? Quais são as perspectivas de emprego em Newport?"

# game/scripts/c15/c15.rpy:586
translate brazilian c15s001_DapDate_3e2a869e:

    # dap "Enseñar en la NWU o en algún instituto. O investigación, que es lo que me gustaría, en la NWU o en la Cal Poly."
    dap "Lecionar na NWU ou em alguma outra instituição. Ou fazer pesquisa, que é o que eu gostaria, na NWU ou na Cal Poly."

# game/scripts/c15/c15.rpy:587
translate brazilian c15s001_DapDate_0d6cc6bb:

    # dap "En San Luís, en Paso Robles, o en Atascadero hay algunas empresas donde también podría trabajar. Pero vete a saber cómo estará el tema laboral en cuatro años."
    dap "Em San Luis, Paso Robles ou Atascadero, existem algumas empresas onde eu também poderia trabalhar. Mas quem sabe como estará o mercado de trabalho daqui a quatro anos."

# game/scripts/c15/c15.rpy:588
translate brazilian c15s001_DapDate_b1336de6:

    # mc "Con lo que podrías seguir viviendo en Newport, ¿no?"
    mc "Então você poderia continuar morando em Newport, certo?"

# game/scripts/c15/c15.rpy:590
translate brazilian c15s001_DapDate_96e39944:

    # dap "No lo sé. Me tendrían que contratar en alguno de esos sitios. Pero nunca había pensado en mudarme. Me gustaría vivir en Newport siempre. ¿Qué opinas?"
    dap "Não sei. Eu teria que ser contratada por um desses lugares. Mas nunca pensei em me mudar. Gostaria de morar em Newport para sempre. O que você acha?"

# game/scripts/c15/c15.rpy:591
translate brazilian c15s001_DapDate_09dc82f3:

    # mc "Que me da lo mismo donde vivamos. Pero a mí también me gustaría quedarme en Newport."
    mc "Não me importo com o lugar onde moramos. Mas também gostaria de ficar em Newport."

# game/scripts/c15/c15.rpy:592
translate brazilian c15s001_DapDate_d5379c54:

    # dap "¿Y tú? ¿Qué planes tienes para el futuro? Una vez el Dormitorio esté totalmente en marcha, vas a tener muy poco trabajo."
    dap "E você? Quais são seus planos para o futuro? Assim que o dormitório estiver totalmente operacional, você terá muito pouco trabalho a fazer."

# game/scripts/c15/c15.rpy:593
translate brazilian c15s001_DapDate_5bfdc0cd:

    # mc "He estado haciendo números, y no pintan bien. Con lo que pagan 12 chicas, y una vez se acabe la subvención extra que nos da la NWU, los números salen muy justos."
    mc "Estive fazendo as contas e elas não são nada animadoras. Com o que 12 meninas pagam, e quando a verba extra da NWU acabar, o orçamento fica bem apertado."

# game/scripts/c15/c15.rpy:595
translate brazilian c15s001_DapDate_e871c428:

    # dap "¿Tan mal estamos?"
    dap "Será que as coisas estão mesmo tão ruins assim?"

# game/scripts/c15/c15.rpy:596
translate brazilian c15s001_DapDate_263a5054:

    # mc "Entre impuestos y los costes operativos estimados, quedarán un par de sueldos medianos. Somos tres personas trabajando, con lo que seguramente tendré que buscar algo. En Newport o alrededores."
    mc "Entre impostos e custos operacionais estimados, sobrará o equivalente a alguns salários médios. Somos três trabalhando, então provavelmente terei que procurar outro emprego. Em Newport ou nas proximidades."

# game/scripts/c15/c15.rpy:597
translate brazilian c15s001_DapDate_f9099e9b:

    # mc "La NWU nos subvenciona este año y el que viene, con lo que tengo tiempo para buscar algo."
    mc "A NWU está nos subsidiando este ano e no próximo, então tenho tempo para procurar algo."

# game/scripts/c15/c15.rpy:599
translate brazilian c15s001_DapDate_62428f0a:

    # dap "Mierda. Si fueran cuatro años, yo podría aportar mis ingresos en vez de generar gastos, pero en dos años..."
    dap "Droga. Se fossem quatro anos, eu poderia contribuir com minha renda em vez de gerar despesas, mas em dois anos..."

# game/scripts/c15/c15.rpy:600
translate brazilian c15s001_DapDate_a790315f:

    # mc "No es una noche para que te preocupes, cielo. Los dos primeros años estaremos bien, y después ya se verá. Pero no tendré problemas en encontrar trabajo en Newport o los alrededores."
    mc "Não precisa se preocupar, querida. Vamos ficar bem nos primeiros dois anos, e depois veremos. Mas não terei dificuldade nenhuma em encontrar emprego em Newport ou arredores."

# game/scripts/c15/c15.rpy:602
translate brazilian c15s001_DapDate_36bb7a11:

    # "En ese momento llega Mathilda..."
    "Nesse momento, Mathilda chega..."

# game/scripts/c15/c15.rpy:603
translate brazilian c15s001_DapDate_2918b3d8:

    # "Mathilda" "¿Han disfrutado de la comida? ¿Puedo ofrecerles algún dulce?"
    "Mathilda" "Gostou da refeição? Posso lhe oferecer uma sobremesa?"

# game/scripts/c15/c15.rpy:604
translate brazilian c15s001_DapDate_d2efded5:

    # mc "Estaba todo muy bueno, pero yo voy a tener que renunciar al postre."
    mc "Estava tudo muito bom, mas vou ter que abrir mão da sobremesa."

# game/scripts/c15/c15.rpy:606
translate brazilian c15s001_DapDate_46f7365e:

    # dap "Todo estaba exquisito, pero yo también voy a pasar. ¿Nos puede cargar la cuenta a la habitación?"
    dap "Estava tudo delicioso, mas também vou pular essa parte. Vocês podem lançar a conta na nossa conta do quarto?"

# game/scripts/c15/c15.rpy:607
translate brazilian c15s001_DapDate_26666239:

    # mc "¿Qué habitación?"
    mc "Qual quarto?"

# game/scripts/c15/c15.rpy:609
translate brazilian c15s001_DapDate_2419419d:

    # dap "¡Hush, [mc]!"
    dap "Silêncio, [mc]!"

# game/scripts/c15/c15.rpy:610
translate brazilian c15s001_DapDate_3bb8e5d7:

    # dap "La habitación está a nombre de Marks, [dap] Marks."
    dap "O quarto está em nome de Marks, [dap] Marks."

# game/scripts/c15/c15.rpy:612
translate brazilian c15s001_DapDate_d994c62a:

    # "Mathilda" "Sin ningún problema. No olviden recoger sus cosas de los vestuarios, por la mañana estarán cerrados. Los disfraces los pueden dejar en la habitación."
    "Mathilda" "Sem problema algum. Não se esqueça de pegar suas coisas nos vestiários; eles estarão fechados pela manhã. Você pode deixar seus figurinos no quarto."

# game/scripts/c15/c15.rpy:613
translate brazilian c15s001_DapDate_eb5b17f9:

    # "Mathilda" "Esperamos verles de nuevo en nuestras instalaciones."
    "Mathilda" "Esperamos vê-lo(a) novamente em nossas instalações."

# game/scripts/c15/c15.rpy:614
translate brazilian c15s001_DapDate_ef11e901:

    # mc "Gracias, Mathilda. Creo que volveremos."
    mc "Obrigada, Mathilda. Acho que voltaremos."

# game/scripts/c15/c15.rpy:616
translate brazilian c15s001_DapDate_381c9caa:

    # dap "Es probable que volvamos. Ha sido una experiencia muy buena. Gracias, Mathilda."
    dap "Provavelmente voltaremos. Foi uma ótima experiência. Obrigada, Mathilda."

# game/scripts/c15/c15.rpy:618
translate brazilian c15s001_DapDate_8594335b:

    # dap "¿Vamos?"
    dap "Vamos?"

# game/scripts/c15/c15.rpy:619
translate brazilian c15s001_DapDate_81d08733:

    # mc "¿Qué es eso de la habitación?"
    mc "O que é isso no quarto?"

# game/scripts/c15/c15.rpy:620
translate brazilian c15s001_DapDate_4fa2926c:

    # dap "Ya te he dicho que había varios restaurantes. El Black Crow es éste, el Pitch Raven es el de ciencia ficción, y el Nigrum Corvus es el de la era clásica, romanos, griegos, y esas cosas."
    dap "Eu já te disse que havia vários restaurantes. Este é o Black Crow, o Pitch Raven é o de ficção científica, e o Nigrum Corvus é o da era clássica, romanos, gregos e coisas do gênero."

# game/scripts/c15/c15.rpy:621
translate brazilian c15s001_DapDate_e7b6e193:

    # dap "Y después tienen la Red Crow Inn, con habitaciones temáticas. Tenemos una habitación medieval, aunque seguramente no se parezca en nada a como dormían entonces."
    dap "E depois há o Red Crow Inn, com quartos temáticos. Temos um quarto medieval, embora provavelmente não se pareça em nada com a forma como as pessoas dormiam naquela época."

# game/scripts/c15/c15.rpy:622
translate brazilian c15s001_DapDate_dd6716bd:

    # mc "Así que la otra reserva a nombre de \"otros\" Marks era tuya, ¿no?"
    mc "Então a outra reserva em nome de \"outros\" Marks era sua, certo?"

# game/scripts/c15/c15.rpy:624
translate brazilian c15s001_DapDate_d9aef484:

    # dap "Sí. Te hice reservar el restaurante por si querías meterte en la web y cambiar la época. La habitación la tenía elegida yo. Me parece más romántica la medieval que la de ciencia ficción."
    dap "Sim. Fiz você reservar o restaurante caso quisesse alterar o horário online. Eu já havia escolhido o quarto. Acho o medieval mais romântico que o de ficção científica."

# game/scripts/c15/c15.rpy:625
translate brazilian c15s001_DapDate_82d9a650:

    # mc "Me ha encantado el Black Crow, con lo que me alegro de no haberlo hecho. La próxima vez, podemos probar uno de los otros."
    mc "Eu adorei o Black Crow, então ainda bem que não o pedi. Da próxima vez, podemos experimentar um dos outros."

# game/scripts/c15/c15.rpy:627
translate brazilian c15s001_DapDate_42533991:

    # dap "Mejor no..."
    dap "É melhor não..."

# game/scripts/c15/c15.rpy:628
translate brazilian c15s001_DapDate_90696e73:

    # mc "¿Pasa algo, [dap]?"
    mc "Há algo errado, [dap]?"

# game/scripts/c15/c15.rpy:629
translate brazilian c15s001_DapDate_d46383ba:

    # dap "Si estamos mal de dinero, me conformo con que la próxima vez sea en un Burger Prince y durmamos en un motel. Si es contigo, me da lo mismo el sitio."
    dap "Se estivermos com pouco dinheiro, não me importo se da próxima vez formos ao Burger Prince e dormirmos num motel. Contanto que seja com você, não me importo com o lugar."

# game/scripts/c15/c15.rpy:630
translate brazilian c15s001_DapDate_66412d2f:

    # mc "Es caro, ¿verdad?"
    mc "É caro, não é?"

# game/scripts/c15/c15.rpy:631
translate brazilian c15s001_DapDate_32ccc251:

    # dap "Un poco, pero no te preocupes. La habitación ya está pagada. Solo me falta pagar la cena."
    dap "Um pouco, mas não se preocupe. O quarto já está pago. Só preciso pagar o jantar."

# game/scripts/c15/c15.rpy:632
translate brazilian c15s001_DapDate_818816ed:

    # mc "¿De dónde has sacado el dinero, [dap]?"
    mc "De onde você tirou o dinheiro, [dap]?"

# game/scripts/c15/c15.rpy:634
translate brazilian c15s001_DapDate_36039b3d:

    # dap "Había estado ahorrando la paga para comprarme un nuevo portátil gaming. He invertido parte de ese dinero en la habitación y en la cena."
    dap "Eu estava guardando minha mesada para comprar um novo notebook gamer. Gastei parte desse dinheiro com o quarto e o jantar."

# game/scripts/c15/c15.rpy:635
translate brazilian c15s001_DapDate_03ebce68:

    # mc "De eso nada, cielo. No puedo hacer nada con la habitación, pero no voy a permitirte pagar la cena. Igual que tú no vas a permitirme devolverte el dinero de la habitación, ¿verdad?"
    mc "De jeito nenhum, querida. Não posso fazer nada em relação ao quarto, mas não vou deixar você pagar o jantar. Assim como você não vai me deixar reembolsar o valor do quarto, vai?"

# game/scripts/c15/c15.rpy:637
translate brazilian c15s001_DapDate_aa71adc3:

    # dap "¡Ni de coña! Ha sido elección mía y lo pago yo todo."
    dap "De jeito nenhum! Foi minha escolha e eu estou pagando por tudo."

# game/scripts/c15/c15.rpy:638
translate brazilian c15s001_DapDate_51cd79e3:

    # mc "Eso no va a pasar. La cena corre de mi cuenta. Tú has ahorrado para ese portátil y te lo mereces."
    mc "Isso não vai acontecer. O jantar é por minha conta. Você juntou dinheiro para comprar esse laptop e merece."

# game/scripts/c15/c15.rpy:640
translate brazilian c15s001_DapDate_767f581f:

    # dap "Bueno, ya lo hablaremos mañana. Es el momento de ver la habitación."
    dap "Certo, conversaremos sobre isso amanhã. É hora de ver o quarto."

# game/scripts/c15/c15.rpy:641
translate brazilian c15s001_DapDate_57d4b6c8:

    # mc "¡Vamos!"
    mc "Vamos!"

# game/scripts/c15/c15.rpy:663
translate brazilian c15s001_AmandaCall_76586480:

    # mc "¿Hola? ¿Quién es?"
    mc "Olá? Quem é?"

# game/scripts/c15/c15.rpy:667
translate brazilian c15s001_AmandaCall_09b3092f:

    # ama "Hola, [mc]. No quiero molestarte demasiado."
    ama "Olá, [mc]. Não quero incomodá-lo(a) muito."

# game/scripts/c15/c15.rpy:668
translate brazilian c15s001_AmandaCall_25bb6224:

    # mc "No molestas, Amanda. ¿Puedo ayudarte en algo?"
    mc "Você não está me incomodando, Amanda. Posso te ajudar em alguma coisa?"

# game/scripts/c15/c15.rpy:671
translate brazilian c15s001_AmandaCall_2d2c711f:

    # ama "Me iba a acostar cuando he recibido una llamada y te tenía que avisar."
    ama "Eu estava prestes a ir para a cama quando recebi uma ligação e precisava te avisar."

# game/scripts/c15/c15.rpy:672
translate brazilian c15s001_AmandaCall_1b04504d:

    # ama "Aaron, nuestro supervisor, llega mañana por la mañana y él querría reunirse con vosotros por la tarde para explicaros la situación."
    ama "Aaron, nosso supervisor, chega amanhã de manhã e gostaria de se encontrar com você à tarde para explicar a situação."

# game/scripts/c15/c15.rpy:674
translate brazilian c15s001_AmandaCall_88603816:

    # ama "Me acaban de despertar con una llamada y te tenía que avisar."
    ama "Acabei de ser acordado por uma ligação e precisava te avisar."

# game/scripts/c15/c15.rpy:675
translate brazilian c15s001_AmandaCall_e6912b06:

    # ama "Aaron, nuestro supervisor, acaba de aterrizar y él querría reunirse con vosotros esta tarde para explicaros la situación."
    ama "Aaron, nosso supervisor, acaba de chegar e gostaria de se encontrar com você esta tarde para explicar a situação."

# game/scripts/c15/c15.rpy:676
translate brazilian c15s001_AmandaCall_1cb46252:

    # mc "¿Nosotros? ¿[mar], [nor], [emm], [eri], [dap] y yo?"
    mc "Nós? [mar], [nor], [emm], [eri], [dap] e eu?"

# game/scripts/c15/c15.rpy:678
translate brazilian c15s001_AmandaCall_3e162582:

    # ama "De momento solo con [mar], [nor] y contigo. Eva y yo también vamos a estar ahí, y las chicas podrían flipar un poco."
    ama "Por enquanto, só com [mar], [nor] e você. Eu e a Eva também estaremos lá, e as meninas podem ficar um pouco assustadas."

# game/scripts/c15/c15.rpy:679
translate brazilian c15s001_AmandaCall_12d46e7b:

    # ama "Además, no es cosa nuestra decirles la verdad, sino de sus madres."
    ama "Além disso, não cabe a nós dizer a verdade a elas, mas sim às mães delas."

# game/scripts/c15/c15.rpy:681
translate brazilian c15s001_AmandaCall_8f92426d:

    # ama "Y tuya."
    ama "E a sua também."

# game/scripts/c15/c15.rpy:682
translate brazilian c15s001_AmandaCall_c431475a:

    # mc "Lo entiendo. No me gusta ocultarles la verdad, pero hablaré con [mar] y con [nor]. ¿A qué hora os esperamos?"
    mc "Entendo. Não gosto de esconder a verdade de você, mas falarei com [mar] e [nor]. A que horas podemos esperar você?"

# game/scripts/c15/c15.rpy:684
translate brazilian c15s001_AmandaCall_095f53d4:

    # ama "A las 1700. Aaron volará fuera del país por la noche."
    ama "Às 17h. Aaron embarcará para fora do país esta noite."

# game/scripts/c15/c15.rpy:685
translate brazilian c15s001_AmandaCall_a022ff35:

    # mc "Intentaré que las chicas no estén en casa a esa hora. ¿Cuánto tiempo necesitáis que estén fuera?"
    mc "Vou tentar garantir que as meninas não estejam em casa nesse horário. Por quanto tempo você precisa que elas fiquem fora?"

# game/scripts/c15/c15.rpy:687
translate brazilian c15s001_AmandaCall_90a0d55c:

    # ama "No más de una hora, supongo. Depende de las preguntas que tengáis. Por eso es mejor que sólo estéis [nor], [mar], y tú. Nada de Olivia o Betty."
    ama "Não mais do que uma hora, eu acho. Depende das perguntas que você tiver. É por isso que é melhor se forem só você, [nor] e [mar]. Sem Olivia ou Betty."

# game/scripts/c15/c15.rpy:688
translate brazilian c15s001_AmandaCall_3fbaf73d:

    # mc "Van a querer estar. También sufrieron el... *Susurro* secuestro."
    mc "Eles vão querer estar lá. Eles também sofreram o... *Sussurro* sequestro."

# game/scripts/c15/c15.rpy:690
translate brazilian c15s001_AmandaCall_aa3f445e:

    # ama "Es posible que sea la última vez que nos veamos. Nuestra misión con vosotros ya está acabando."
    ama "Esta pode ser a última vez que nos vemos. Nossa missão com vocês está chegando ao fim."

# game/scripts/c15/c15.rpy:691
translate brazilian c15s001_AmandaCall_14a8e762:

    # mc "¿Aaron se os va a llevar? ¿A alguna base de NTR?"
    mc "O Aaron vai te levar embora? Para alguma base de NTR?"

# game/scripts/c15/c15.rpy:693
translate brazilian c15s001_AmandaCall_4b11cc55:

    # ama "Aaron solo quiere hablar con vosotros de momento. El resto ya se verá."
    ama "Aaron só quer conversar com você agora. Depois a gente vê o que acontece."

# game/scripts/c15/c15.rpy:694
translate brazilian c15s001_AmandaCall_5493f95e:

    # ama "Por cierto, deberíais informar a [mar] de lo que pasó el lunes con Eric y los demás. Nos ahorraremos preguntas incómodas."
    ama "Aliás, você deveria contar para [mar] o que aconteceu na segunda-feira com o Eric e os outros. Isso vai nos poupar de perguntas constrangedoras."

# game/scripts/c15/c15.rpy:695
translate brazilian c15s001_AmandaCall_f53c18eb:

    # mc "No te preocupes, hablaré con ella antes de que lleguéis."
    mc "Não se preocupe, falarei com ela antes de você chegar."

# game/scripts/c15/c15.rpy:698
translate brazilian c15s001_AmandaCall_9fe47f69:

    # ama "Perfecto. Entonces nos vemos mañana por la tarde. Feliz Navidad de nuevo, [mc]."
    ama "Perfeito. Então te vejo amanhã à tarde. Feliz Natal novamente, [mc]."

# game/scripts/c15/c15.rpy:699
translate brazilian c15s001_AmandaCall_4bb39419:

    # mc "Hasta mañana. No sé si es un poco tarde para seguir celebrando la Navidad, pero Feliz Navidad de nuevo, Amanda."
    mc "Até amanhã. Não sei se já é um pouco tarde para continuarmos a celebrar o Natal, mas Feliz Natal novamente, Amanda."

# game/scripts/c15/c15.rpy:701
translate brazilian c15s001_AmandaCall_a8d9df18:

    # ama "Perfecto. Entonces nos vemos esta tarde. A las 1700."
    ama "Perfeito. Então nos vemos esta tarde, às 17h."

# game/scripts/c15/c15.rpy:702
translate brazilian c15s001_AmandaCall_f2240889:

    # mc "Hasta luego, Amanda."
    mc "Adeus, Amanda."

# game/scripts/c15/c15.rpy:706
translate brazilian c15s001_WakeUp_7ea49a16:

    # centered "{size=+20}{b}DÍA 17 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}DIA 17 – QUINTA-FEIRA{/b}{/size}"

# game/scripts/c15/c15.rpy:708
translate brazilian c15s001_WakeUp_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:709
translate brazilian c15s001_WakeUp_0e03d86c:

    # "Suena el teléfono y te saca de tus sueños, si es que los has tenido. Despertarse tan de golpe ha hecho que olvides lo que estabas soñando."
    "O telefone toca e te arranca dos seus sonhos, se é que você estava sonhando. Acordar tão repentinamente fez você esquecer com o que estava sonhando."

# game/scripts/c15/c15.rpy:710
translate brazilian c15s001_WakeUp_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Número oculto?)"

# game/scripts/c15/c15.rpy:714
translate brazilian c15s001_WakeUp_032240cf:

    # "Cuando cuelgas te das cuenta de que has dormido hasta tarde. Casi no vale la pena bajar a desayunar."
    "Ao desligar o telefone, você percebe que dormiu demais. Quase não vale a pena descer para tomar café da manhã."

# game/scripts/c15/c15.rpy:716
translate brazilian c15s001_WakeUp_ff52f651:

    # "Decides jugar un rato a My Residence, El MC por fin lleva a Laura a una cita, aunque es ella la que elige restaurante."
    "Você decide jogar My Residence por um tempo. O protagonista finalmente leva Laura para um encontro, embora seja ela quem escolha o restaurante."

# game/scripts/c15/c15.rpy:717
translate brazilian c15s001_WakeUp_e049b78d:

    # "Como ella es fan de las novelas de fantasía, elige un restaurante temático medieval en el que pueden disfrazarse. Laura cada vez te recuerda más a [dap]."
    "Como ela é fã de romances de fantasia, escolhe um restaurante com temática medieval onde eles podem se vestir a caráter. Laura lembra cada vez mais você de [dap]."

# game/scripts/c15/c15.rpy:746
translate brazilian c15s002_DapLewd_4d952482:

    # dap "¡Es fantástica! ¡Está muy bien hecha! Quizás algún detalle aquí y allí está fuera de lugar, pero por el resto está muy bien."
    dap "É fantástico! É muito bem feito! Talvez um detalhe aqui e ali esteja fora do lugar, mas fora isso é muito bom."

# game/scripts/c15/c15.rpy:747
translate brazilian c15s002_DapLewd_2a83610e:

    # dap "Después de encontrar patatas, maíz, y pimiento en el menú, no me voy a quejar. Esperaba algo más... turístico."
    dap "Depois de encontrar batatas, milho e pimentões no cardápio, não vou reclamar. Eu esperava algo mais... turístico."

# game/scripts/c15/c15.rpy:748
translate brazilian c15s002_DapLewd_0d7a13a6:

    # mc "A mí me parece muy lograda. Parece sacada de una película."
