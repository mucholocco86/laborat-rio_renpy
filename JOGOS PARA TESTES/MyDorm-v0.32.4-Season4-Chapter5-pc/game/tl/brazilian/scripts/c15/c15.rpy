    # nor "Te miro a los ojos y no puedo dejar de ver a mis niñas, pero está claro que nadie os podría confundir."
    nor "Olho nos seus olhos e não consigo deixar de ver minhas filhas, mas é evidente que ninguém poderia confundi-la com você."

# game/scripts/c15/c15.rpy:2860
translate brazilian c15s006_AaronVisit_5f1c0d0f:

    # eva "No, seguramente solo un tonto nos confundiría..."
    eva "Não, certamente só um tolo nos confundiria..."

# game/scripts/c15/c15.rpy:2861
translate brazilian c15s006_AaronVisit_178bfedd:

    # mcp "(Mierda, la [eri] de los tatuajes que se corrían... ¡El tonto soy yo!)"
    mcp "(Droga, as tatuagens [eri] que estavam correndo... Eu sou um idiota!)"

# game/scripts/c15/c15.rpy:2863
translate brazilian c15s006_AaronVisit_1317e58f:

    # mc "Aaron, ¿quieres sentarte? Dejemos un poco de tiempo para que se acostumbren. Mi madre y mi tía, me refiero."
    mc "Aaron, você gostaria de se sentar? Vamos dar um tempo para elas se acostumarem. Quero dizer, minha mãe e minha tia."

# game/scripts/c15/c15.rpy:2864
translate brazilian c15s006_AaronVisit_8f8992ca:

    # aar "Sí, será mejor que nos sentemos y les demos un poco de espacio, aunque tenemos un tiempo limitado y os tengo que explicar muchas cosas."
    aar "Sim, seria melhor se nos sentássemos e lhes déssemos algum espaço, embora tenhamos pouco tempo e eu tenha muitas coisas para lhe explicar."

# game/scripts/c15/c15.rpy:2865
translate brazilian c15s006_AaronVisit_af0e4cb7:

    # mc "¿Quieres beber algo? ¿Café, una copa de algo?"
    mc "Você gostaria de beber algo? Café, um copo de alguma coisa?"

# game/scripts/c15/c15.rpy:2866
translate brazilian c15s006_AaronVisit_3d25cc0e:

    # aar "Un vaso de agua, por favor. Voy a tener que hablar mucho."
    aar "Um copo d'água, por favor. Tenho muito a dizer."

# game/scripts/c15/c15.rpy:2867
translate brazilian c15s006_AaronVisit_7bce90a4:

    # mc "Ahora vuelvo."
    mc "Já volto."

# game/scripts/c15/c15.rpy:2869
translate brazilian c15s006_AaronVisit_96009662:

    # mc "Una pregunta, Aaron. ¿Nos hemos visto? Tu cara me resulta familiar. ¿Viniste a casa alguna vez antes del accidente, cuando yo era niño?"
    mc "Uma pergunta, Aaron. Já nos conhecemos? Seu rosto me parece familiar. Você já veio à nossa casa antes do acidente, quando eu era criança?"

# game/scripts/c15/c15.rpy:2870
translate brazilian c15s006_AaronVisit_3d7b5e6f:

    # aar "No, tú y yo no nos hemos visto nunca en persona, pero mejor os explico todo cuando las chicas hayan acabado con las presentaciones."
    aar "Não, você e eu nunca nos encontramos pessoalmente, mas explicarei tudo quando as meninas terminarem as apresentações."

# game/scripts/c15/c15.rpy:2871
translate brazilian c15s006_AaronVisit_a23381e1:

    # mc "¿Qué me puedes contar de ellas? ¿De Amanda y Eva?"
    mc "O que você pode me dizer sobre elas? Sobre Amanda e Eva?"

# game/scripts/c15/c15.rpy:2873
translate brazilian c15s006_AaronVisit_309108da:

    # aar "Aparte de que son unas de las mejores agentes con las que he trabajado nunca, no creo que pueda contarte demasiado. O al menos no demasiado que te interese."
    aar "Além do fato de serem alguns dos melhores agentes com quem já trabalhei, acho que não tenho muito a dizer. Ou pelo menos não muito que lhe interesse."

# game/scripts/c15/c15.rpy:2874
translate brazilian c15s006_AaronVisit_ba48432d:

    # mc "Eso ya lo veremos..."
    mc "Veremos..."

# game/scripts/c15/c15.rpy:2876
translate brazilian c15s006_AaronVisit_bbb5cb4f:

    # eva "Creo que la reunión debe empezar ya... *Mascullando* Yo puedo aguantar un número de abrazos limitado."
    eva "Acho que a reunião deveria começar agora... *Resmungando* Só consigo lidar com um número limitado de abraços."

# game/scripts/c15/c15.rpy:2877
translate brazilian c15s006_AaronVisit_5ec9c01b:

    # ama "Sí, empecemos ya o no va a dar tiempo de explicároslo todo."
    ama "Sim, vamos começar agora ou não teremos tempo de explicar tudo para você."

# game/scripts/c15/c15.rpy:2878
translate brazilian c15s006_AaronVisit_bbe94d2d:

    # mc "¿Os sentáis?"
    mc "Você está sentado?"

# game/scripts/c15/c15.rpy:2879
translate brazilian c15s006_AaronVisit_82842932:

    # eva "Yo prefiero continuar de pie... para... para poder contrarrestar cualquier amenaza..."
    eva "Prefiro permanecer de pé... para poder neutralizar qualquer ameaça..."

# game/scripts/c15/c15.rpy:2881
translate brazilian c15s006_AaronVisit_17bf61a3:

    # nor "Siéntate al lado de Amanda, Eva, por favor. Yo me sentaré a tu lado."
    nor "Sente-se ao lado de Amanda, Eva, por favor. Eu me sento ao seu lado."

# game/scripts/c15/c15.rpy:2882
translate brazilian c15s006_AaronVisit_1b44d8be:

    # eva "Mmmm... OK."
    eva "Hum... OK."

# game/scripts/c15/c15.rpy:2884
translate brazilian c15s006_AaronVisit_1498326d:

    # mc "Explícanos, Aaron. ¿Qué es tan importante?"
    mc "Explique-nos, Aaron. O que é tão importante?"

# game/scripts/c15/c15.rpy:2885
translate brazilian c15s006_AaronVisit_e51a58e2:

    # aar "¿Qué sabéis de NTR y de GILF?"
    aar "O que você sabe sobre NTR e GILF?"

# game/scripts/c15/c15.rpy:2887
translate brazilian c15s006_AaronVisit_ba1749c2:

    # mc "Que fue fundada por mis tíos y que ahora, debido a un extraño testamento, somos prácticamente los dueños."
    mc "Foi fundada pelos meus tios e agora, devido a um testamento peculiar, somos praticamente os donos."

# game/scripts/c15/c15.rpy:2889
translate brazilian c15s006_AaronVisit_ea3fd0d6:

    # mc "Que fue fundada por mi madre, mi tío y por Dominic Andersen. Y que ahora, debido a un extraño testamento, somos prácticamente los dueños."
    mc "Foi fundada pela minha mãe, meu tio e Dominic Andersen. E agora, devido a um testamento peculiar, somos praticamente os donos."

# game/scripts/c15/c15.rpy:2890
translate brazilian c15s006_AaronVisit_9fdc7264:

    # aar "Exacto. Prácticamente. Vuestra familia tiene el 75%% del accionariado. La mía el 25%% restante."
    aar "Exatamente. Praticamente. Sua família detém 75%% das ações. A minha detém os 25%% restantes."

# game/scripts/c15/c15.rpy:2892
translate brazilian c15s006_AaronVisit_195d2a73:

    # nor "¿La tuya?"
    nor "Seu?"

# game/scripts/c15/c15.rpy:2893
translate brazilian c15s006_AaronVisit_d17fb48f:

    # mc "¿Nos puedes explicar eso? Por lo que sé el 25%% restante lo heredaban la Serie XY-A y la Serie XX a partes iguales."
    mc "Você pode nos explicar isso? Pelo que sei, os 25%% restantes foram herdados igualmente pelas séries XY-A e XX."

# game/scripts/c15/c15.rpy:2894
translate brazilian c15s006_AaronVisit_4ef4cab8:

    # mc "Hemos descubierto que Eva y Amanda son XX. Pero tú no puedes ser Serie A."
    mc "Descobrimos que Eva e Amanda são XX. Mas você não pode ser da Série A."

# game/scripts/c15/c15.rpy:2896
translate brazilian c15s006_AaronVisit_d54ab48b:

    # ama "Quizás sería bueno que empezases por el principio, Aaron."
    ama "Talvez fosse bom se você começasse do começo, Aaron."

# game/scripts/c15/c15.rpy:2903
translate brazilian c15s006_AaronVisit_312d0efb:

    # mc "Es decir, somos los dueños de una empresa millonaria que se dedica a trabajar como mercenarios."
    mc "Em outras palavras, somos donos de uma empresa multimilionária que trabalha como mercenários."

# game/scripts/c15/c15.rpy:2904
translate brazilian c15s006_AaronVisit_a8337876:

    # aar "Sí, esa es la actividad económica principal. La secundaria es la investigación y diseño de dispositivos de medicina avanzada."
    aar "Sim, essa é a principal atividade econômica. A atividade secundária é a pesquisa e o desenvolvimento de dispositivos médicos avançados."

# game/scripts/c15/c15.rpy:2905
translate brazilian c15s006_AaronVisit_37a3d752:

    # mc "Vale, ¿y ahora qué?"
    mc "Certo, e agora?"

# game/scripts/c15/c15.rpy:2907
translate brazilian c15s006_AaronVisit_1f65be02:

    # aar "Ahora tenéis que tomar una decisión sobre qué queréis hacer con la empresa. Podéis venderla, mantenerla o cambiarla."
    aar "Agora você precisa decidir o que quer fazer com a empresa. Você pode vendê-la, mantê-la ou transformá-la."

# game/scripts/c15/c15.rpy:2908
translate brazilian c15s006_AaronVisit_8c794037:

    # aar "No hace falta que toméis la decisión ahora. Antes deberíais decirle la verdad a [emm], [dap] y [eri]. Ellas también tienen voto. Igual que nosotros."
    aar "Você não precisa tomar essa decisão agora. Primeiro, você deve contar a verdade para [emm], [dap] e [eri]. Eles também têm direito a voto. Assim como nós."

# game/scripts/c15/c15.rpy:2910
translate brazilian c15s006_AaronVisit_34321809:

    # mc "¿Y mi padre?"
    mc "E meu pai?"

# game/scripts/c15/c15.rpy:2912
translate brazilian c15s006_AaronVisit_dc7bae01:

    # aar "¿Tu padre? ¿Qué tiene que ver Edmund en todo esto?"
    aar "Seu pai? O que Edmund tem a ver com tudo isso?"

# game/scripts/c15/c15.rpy:2913
translate brazilian c15s006_AaronVisit_1a9a442f:

    # mc "Le perseguíais... o le perseguían... aquí en Newport. Cuando se fugó también le persiguieron..."
    mc "Você estava perseguindo ele... ou eles estavam perseguindo ele... aqui em Newport. Quando ele escapou, eles o perseguiram também..."

# game/scripts/c15/c15.rpy:2915
translate brazilian c15s006_AaronVisit_541b2858:

    # mom "¿Qué? ¿Has estado en contacto con tu padre? ¿Has hablado con él?"
    mom "O quê? Você teve contato com seu pai? Vocês conversaram?"

# game/scripts/c15/c15.rpy:2916
translate brazilian c15s006_AaronVisit_dd2ee5e5:

    # mc "Sí, Mamá. Te lo explico luego."
    mc "Sim, mãe. Eu explico para você mais tarde."

# game/scripts/c15/c15.rpy:2918
translate brazilian c15s006_AaronVisit_79ef2db6:

    # aar "Tu padre no ha sido un objetivo nunca. No soy consciente de que nadie le haya seguido a ningún sitio o de que le estén vigilando."
    aar "Seu pai nunca foi alvo de vigilância. Não tenho conhecimento de ninguém que o esteja seguindo ou vigiando."

# game/scripts/c15/c15.rpy:2919
translate brazilian c15s006_AaronVisit_52160b59:

    # mc "Vuestros Serie G le siguieron hasta Aruba..."
    mc "Seu G-Series o acompanhou até Aruba..."

# game/scripts/c15/c15.rpy:2921
translate brazilian c15s006_AaronVisit_cc928158:

    # aar "¿Aruba? *Risa* ¿Tu padre se fugó a Aruba?"
    aar "Aruba? *Risos* Seu pai fugiu para Aruba?"

# game/scripts/c15/c15.rpy:2922
translate brazilian c15s006_AaronVisit_5f18d335:

    # mc "Sí... no entiendo qué tiene de gracioso..."
    mc "É... eu não entendo o que tem de engraçado nisso..."

# game/scripts/c15/c15.rpy:2924
translate brazilian c15s006_AaronVisit_ecde917c:

    # aar "¿Te acuerdas que te he dicho que NTR compró laboratorios en el extranjero? El laboratorio principal está en Aruba."
    aar "Você se lembra de quando eu te disse que a NTR comprou laboratórios no exterior? O laboratório principal fica em Aruba."

# game/scripts/c15/c15.rpy:2925
translate brazilian c15s006_AaronVisit_4300af04:

    # aar "Nadie le vigilaba y nadie le siguió... *Risa* Fue él quien se metió en la boca del lobo..."
    aar "Ninguém o observava e ninguém o seguia... *Risos* Ele entrou direto na boca do leão..."

# game/scripts/c15/c15.rpy:2926
translate brazilian c15s006_AaronVisit_628c5930:

    # aar "Si decidís mantener la empresa, uno de vosotros debería venir a Aruba con nosotros en unas semanas, una vez se calmen las aguas."
    aar "Se decidirem manter a empresa em funcionamento, um de vocês deverá vir para Aruba conosco daqui a algumas semanas, quando as coisas estiverem mais calmas."

# game/scripts/c15/c15.rpy:2927
translate brazilian c15s006_AaronVisit_65c4b1d4:

    # mc "¿Para qué?"
    mc "Para que?"

# game/scripts/c15/c15.rpy:2929
translate brazilian c15s006_AaronVisit_3fd69b48:

    # aar "Ahora mismo la empresa está sin liderazgo. Con Xabier apartado de su puesto, GILF desaparecerá y todo el personal será absorbido por NTR."
    aar "A empresa está atualmente sem liderança. Com a saída de Xabier do cargo, a GILF deixará de existir e todos os funcionários serão absorvidos pela NTR."

# game/scripts/c15/c15.rpy:2930
translate brazilian c15s006_AaronVisit_0d720591:

    # aar "Alguien debe dirigir ese cambio y decidir el rumbo que queréis... queremos darle a la empresa, sea para mantenerlo o cambiarlo."
    aar "Alguém precisa liderar essa mudança e decidir a direção que queremos dar à empresa, seja para mantê-la como está ou para transformá-la."

# game/scripts/c15/c15.rpy:2931
translate brazilian c15s006_AaronVisit_074dd798:

    # mc "Ninguno de nosotros sabe nada de operaciones encubiertas, clonación, o medicina..."
    mc "Nenhum de nós entende nada de operações secretas, clonagem ou medicina..."

# game/scripts/c15/c15.rpy:2933
translate brazilian c15s006_AaronVisit_5b630dd0:

    # nor "Pero tú sabes cómo dirigir una empresa. Es lo que has estudiado."
    nor "Mas você sabe como administrar uma empresa. Foi isso que você estudou."

# game/scripts/c15/c15.rpy:2934
translate brazilian c15s006_AaronVisit_2c5471cc:

    # mc "Tú también... y yo solo he estudiado. No tendría ni idea de por dónde empezar..."
    mc "Você também... e eu só estudei. Não teria a mínima ideia de por onde começar..."

# game/scripts/c15/c15.rpy:2935
translate brazilian c15s006_AaronVisit_40badfe1:

    # nor "Yo sufro para administrar el Dormitorio... estoy demasiado oxidada..."
    nor "Tenho dificuldades em me virar no dormitório... Estou muito enferrujado..."

# game/scripts/c15/c15.rpy:2937
translate brazilian c15s006_AaronVisit_12742e75:

    # aar "Yo podría ayudarte en eso... si quieres."
    aar "Eu poderia te ajudar com isso... se você quiser."

# game/scripts/c15/c15.rpy:2938
translate brazilian c15s006_AaronVisit_de7691c5:

    # mc "¿Y por qué no la diriges tú? También eres accionista..."
    mc "E por que você não administra? Você também é acionista..."

# game/scripts/c15/c15.rpy:2939
translate brazilian c15s006_AaronVisit_8ed5b5bb:

    # aar "Hay demasiada mala sangre ahora mismo como para que yo tome el poder. Además, tu familia tiene la mayoría de las acciones..."
    aar "Há muita animosidade no ar para que eu assuma o poder. Além disso, sua família detém a maior parte das ações..."

# game/scripts/c15/c15.rpy:2940
translate brazilian c15s006_AaronVisit_8b1f69e9:

    # aar "Puedo dirigir el proceso de transición, pero no puedo hacerme cargo de la empresa."
    aar "Posso gerir o processo de transição, mas não posso assumir o controlo da empresa."

# game/scripts/c15/c15.rpy:2941
translate brazilian c15s006_AaronVisit_2a5a1ac4:

    # mc "¿Y Amanda y Eva?"
    mc "E Amanda e Eva?"

# game/scripts/c15/c15.rpy:2943
translate brazilian c15s006_AaronVisit_d77a0a89:

    # ama "Si tú no sabes por dónde empezar, imagínate nosotras... y estamos en la misma posición que Aaron. Hay gente que no lo aceptaría. Volveremos a la base hoy con Aaron para allanarte el camino."
    ama "Se você não sabe por onde começar, imagine como nos sentimos... e estamos na mesma situação que o Aaron. Algumas pessoas não aceitariam isso. Hoje, voltaremos à base com o Aaron para facilitar o processo para você."

# game/scripts/c15/c15.rpy:2944
translate brazilian c15s006_AaronVisit_51bbbf53:

    # ama "Además, sólo serían unos meses. Una vez toméis la decisión sobre qué hacer con la empresa, una vez aprendas en quién puedes delegar, podrás dirigirlo todo desde aquí."
    ama "Além disso, seriam apenas alguns meses. Assim que você decidir o que fazer com a empresa e descobrir a quem delegar tarefas, você conseguirá gerenciar tudo a partir daqui."

# game/scripts/c15/c15.rpy:2945
translate brazilian c15s006_AaronVisit_ce7ece0f:

    # mc "¿Meses? ¡No puedo irme meses!"
    mc "Meses? Não posso ficar fora por meses!"

# game/scripts/c15/c15.rpy:2947
translate brazilian c15s006_AaronVisit_0f161008:

    # eva "¿No te puedes separar de tu familia? Si decidís mantener la empresa y no venderla, sabes que es lo mejor."
    eva "Você não consegue se separar da sua família? Se você decidir manter a empresa e não vendê-la, saberá que está fazendo o melhor."

# game/scripts/c15/c15.rpy:2948
translate brazilian c15s006_AaronVisit_47f99024:

    # eva "Ayer se te llenaba la boca con la palabra familia. Hoy parece que no estás dispuesto a sacrificar unos meses por su bien."
    eva "Ontem você só falava de família. Hoje parece que não está disposto a sacrificar alguns meses por eles."

# game/scripts/c15/c15.rpy:2949
translate brazilian c15s006_AaronVisit_bfbfe313:

    # mc "Espera... ¿tenemos la oportunidad de venderla? ¿Hay compradores? ¿Qué valor tiene?"
    mc "Espere... temos alguma chance de vendê-lo? Há algum comprador? Quanto vale?"

# game/scripts/c15/c15.rpy:2951
translate brazilian c15s006_AaronVisit_f00a197d:

    # aar "No hemos calculado el valor todavía. Pero bastante. Seguramente diez u once cifras. No creíamos que quisierais poner en venta la empresa familiar."
    aar "Ainda não calculamos o valor. Mas é bastante alto. Provavelmente na casa dos dez ou onze dígitos. Não imaginávamos que você quisesse colocar a empresa familiar à venda."

# game/scripts/c15/c15.rpy:2952
translate brazilian c15s006_AaronVisit_d8922672:

    # mc "¡Wow! Es para pensarlo..."
    mc "Uau! Isso é algo para se pensar..."

# game/scripts/c15/c15.rpy:2954
translate brazilian c15s006_AaronVisit_c3e497ce:

    # aar "Es posible que en las próximas semanas os hagan alguna oferta. Va a ser difícil que vuestra identidad no se filtre en algunos círculos."
    aar "Você poderá receber uma oferta nas próximas semanas. Será difícil evitar que sua identidade seja divulgada em certos círculos."

# game/scripts/c15/c15.rpy:2955
translate brazilian c15s006_AaronVisit_cd53b7f0:

    # aar "Si decidís venderla, nos gustaría pediros un favor. Dadnos la oportunidad de comprar vuestra parte."
    aar "Se você decidir vender, gostaríamos de lhe pedir um favor. Por favor, nos dê a oportunidade de comprar sua participação."

# game/scripts/c15/c15.rpy:2956
translate brazilian c15s006_AaronVisit_8120dd94:

    # aar "O al menos lo suficiente para tener el control de la empresa. No queremos que caiga en manos equivocadas."
    aar "Ou pelo menos o suficiente para ter o controle da empresa. Não queremos que ela caia em mãos erradas."

# game/scripts/c15/c15.rpy:2958
translate brazilian c15s006_AaronVisit_ccb7b165:

    # nor "De momento me parecería buena idea no venderla hasta no saber más, y si decidimos hacerlo, creo que os debemos el derecho de tanteo."
    nor "Por agora, acho que seria uma boa ideia não vendê-lo até sabermos mais, e se decidirmos fazê-lo, creio que lhe devemos o direito de preferência."

# game/scripts/c15/c15.rpy:2959
translate brazilian c15s006_AaronVisit_53fef2fa:

    # "En ese momento te das cuenta de que [nor] y [mar] han estado usando sus teléfonos los últimos minutos. Estabas demasiado concentrado en la conversación para notarlo."
    "Nesse momento você percebe que [nor] e [mar] estavam usando seus celulares nos últimos minutos. Você estava tão absorto na conversa que não notou."

# game/scripts/c15/c15.rpy:2960
translate brazilian c15s006_AaronVisit_bf424847:

    # nor "Pero nosotras también queremos algo a cambio. Al menos hasta que [mc] decida si va a Aruba en unas semanas."
    nor "Mas nós também queremos algo em troca. Pelo menos até que [mc] decida se vai para Aruba daqui a algumas semanas."

# game/scripts/c15/c15.rpy:2962
translate brazilian c15s006_AaronVisit_1b61ee21:

    # mom "Queremos que Amanda y Eva se queden en Newport durante ese tiempo."
    mom "Queremos que Amanda e Eva permaneçam em Newport durante esse período."

# game/scripts/c15/c15.rpy:2963
translate brazilian c15s006_AaronVisit_eb701fd5:

    # "Y ahora entiendes qué hacían con los teléfonos. Estaban creando su propia estrategia de negociación."
    "E agora você entende o que eles estavam fazendo com os telefones. Eles estavam criando sua própria estratégia de negociação."

# game/scripts/c15/c15.rpy:2965
translate brazilian c15s006_AaronVisit_7c4d48bc:

    # ama "¡Sí!... Digo... ¿Qué?" (multiple=2)
    ama "Sim!... Quer dizer... O quê?" (multiple=2)

# game/scripts/c15/c15.rpy:2966
translate brazilian c15s006_AaronVisit_f537aa30:

    # eva "¿Por qué nosotras?" (multiple=2)
    eva "Por que nós?" (multiple=2)

# game/scripts/c15/c15.rpy:2968
translate brazilian c15s006_AaronVisit_ec319464:

    # aar "Eso no va a ser posible..."
    aar "Isso não vai ser possível..."

# game/scripts/c15/c15.rpy:2970
translate brazilian c15s006_AaronVisit_2e543abb:

    # mom "Aaron, déjame hablar."
    mom "Aaron, deixe-me falar."

# game/scripts/c15/c15.rpy:2971
translate brazilian c15s006_AaronVisit_791a3641:

    # mom "Queremos que se queden por varias razones. La primera es que queremos conocerlas mejor."
    mom "Queremos que eles fiquem por vários motivos. O primeiro é que queremos conhecê-los melhor."

# game/scripts/c15/c15.rpy:2973
translate brazilian c15s006_AaronVisit_05ac2f66:

    # mom "También queremos que conozcan a las chicas. Creemos que las cinco tienen el derecho a conocerse."
    mom "Também queremos que eles conheçam as meninas. Acreditamos que todos os cinco têm o direito de se conhecerem."

# game/scripts/c15/c15.rpy:2975
translate brazilian c15s006_AaronVisit_e8fbeb86:

    # nor "Habrá que dar muchas explicaciones... pero..."
    nor "Haverá muito o que explicar... mas..."

# game/scripts/c15/c15.rpy:2976
translate brazilian c15s006_AaronVisit_a1007f8f:

    # nor "Queremos que pasen tiempo en casa una vez se lo hayamos contado a las chicas. Una comida o una cena cada día. Se pueden turnar."
    nor "Queremos que eles passem um tempo em casa depois que contarmos para as meninas. Um almoço ou jantar por dia. Eles podem se revezar."

# game/scripts/c15/c15.rpy:2977
translate brazilian c15s006_AaronVisit_9c03d934:

    # nor "Obviamente, solo si ellas quieren. Así podrán conocer a toda la familia."
    nor "Obviamente, só se eles quiserem. Assim, eles podem conhecer toda a família."

# game/scripts/c15/c15.rpy:2979
translate brazilian c15s006_AaronVisit_2b800b5f:

    # nor "Nos habéis dicho que hay agentes a los que todavía no les habéis cancelado las órdenes, y no creemos que haya nadie mejor para protegernos."
    nor "Você nos disse que há agentes cujas ordens você ainda não cancelou, e não achamos que haja ninguém melhor para nos proteger."

# game/scripts/c15/c15.rpy:2981
translate brazilian c15s006_AaronVisit_5c76298d:

    # aar "Eso va a ser muy complicado, no podemos..."
    aar "Isso vai ser muito complicado, não podemos..."

# game/scripts/c15/c15.rpy:2982
translate brazilian c15s006_AaronVisit_8ac0354b:

    # mc "Creo que tienes la batalla perdida, Aaron."
    mc "Acho que você perdeu a batalha, Aaron."

# game/scripts/c15/c15.rpy:2983
translate brazilian c15s006_AaronVisit_f3cfad35:

    # mc "Yo también tengo un par de condiciones si queréis el derecho a tanteo. Serían tres, pero con una se me han adelantado."
    mc "Tenho também algumas condições caso queira o direito de preferência. Seriam três, mas uma já foi acordada."

# game/scripts/c15/c15.rpy:2985
translate brazilian c15s006_AaronVisit_ab7b8520:

    # ama "¿Qué condiciones, [mc]?"
    ama "Quais as condições, [mc]?"

# game/scripts/c15/c15.rpy:2986
translate brazilian c15s006_AaronVisit_5525bc3c:

    # mc "Quiero que me enseñéis a disparar. No quiero volver a sentirme tan indefenso como me sentí con Eric el otro día."
    mc "Quero que você me ensine a atirar. Não quero me sentir tão impotente de novo como me senti com o Eric outro dia."

# game/scripts/c15/c15.rpy:2987
translate brazilian c15s006_AaronVisit_307728bf:

    # mc "Y quiero que me enseñen Eva y Amanda, con lo que la condición de que se queden es indispensable."
    mc "E eu quero que Eva e Amanda me ensinem, então a condição de que elas fiquem é essencial."

# game/scripts/c15/c15.rpy:2989
translate brazilian c15s006_AaronVisit_e4d66cae:

    # eva "¡De eso me ocupo yo!... Si no le importa a Amanda..."
    eva "Eu cuido disso!... Se Amanda não se importar..."

# game/scripts/c15/c15.rpy:2990
translate brazilian c15s006_AaronVisit_afe403e9:

    # mc "Y quiero que retiréis las cámaras de los espacios privados de la casa. Habitaciones, baños..."
    mc "E quero que retirem as câmeras das áreas privadas da casa. Quartos, banheiros..."

# game/scripts/c15/c15.rpy:2992
translate brazilian c15s006_AaronVisit_b16d4240:

    # mom "¿De qué estás hablando?" (multiple=2)
    mom "O que você está falando?" (multiple=2)

# game/scripts/c15/c15.rpy:2993
translate brazilian c15s006_AaronVisit_9dae3966:

    # nor "¿Nos han grabado en las habitaciones?" (multiple=2)
    nor "Eles nos gravaram nos quartos?" (multiple=2)

# game/scripts/c15/c15.rpy:2994
translate brazilian c15s006_AaronVisit_5f14fd9d:

    # mc "Sí, y eso se acaba hoy."
    mc "Sim, e isso termina hoje."

# game/scripts/c15/c15.rpy:2996
translate brazilian c15s006_AaronVisit_c3c94543:

    # ama "Eso va a hacer más complicado protegeros. Si se infiltra alguien y no sabemos dónde está..."
    ama "Isso vai dificultar a sua proteção. Se alguém se infiltrar e não soubermos onde está..."

# game/scripts/c15/c15.rpy:2997
translate brazilian c15s006_AaronVisit_54f928f5:

    # mc "Podéis revisar los pasillos y las zonas comunes. Pero se acabó grabarnos... durmiendo o duchándonos."
    mc "Podem dar uma olhada nos corredores e áreas comuns. Mas chega de nos filmar... enquanto dormimos ou tomamos banho."

# game/scripts/c15/c15.rpy:2999
translate brazilian c15s006_AaronVisit_a37e3844:

    # eva "Vale... no me gusta la idea, pero lo entiendo..."
    eva "Ok... Eu não gosto da ideia, mas entendo..."

# game/scripts/c15/c15.rpy:3000
translate brazilian c15s006_AaronVisit_e06f882a:

    # mc "Perfecto. ¿Mañana empezamos las lecciones sobre armas de fuego?"
    mc "Perfeito. Podemos começar as aulas de armas de fogo amanhã?"

# game/scripts/c15/c15.rpy:3002
translate brazilian c15s006_AaronVisit_c6eb1aae:

    # eva "¡Sí!"
    eva "Sim!"

# game/scripts/c15/c15.rpy:3004
translate brazilian c15s006_AaronVisit_a48835b3:

    # eva "Digo... sí. Ya que es tu condición, podemos hacerlo a mediodía si te va bien. En el lago."
    eva "Quer dizer... sim. Já que essa é a sua situação, podemos fazer isso ao meio-dia, se for conveniente para você. No lago."

# game/scripts/c15/c15.rpy:3005
translate brazilian c15s006_AaronVisit_2a22efe0:

    # mc "Genial. Entonces todo está aclarado."
    mc "Ótimo. Então tudo está claro."

# game/scripts/c15/c15.rpy:3007
translate brazilian c15s006_AaronVisit_3884d4c1:

    # aar "Nosotros nos vamos a tener que ir ya. Nuestro... mi vuelo sale en menos de dos horas."
    aar "Precisamos ir agora. Meu voo sai em menos de duas horas."

# game/scripts/c15/c15.rpy:3033
translate brazilian c15s006_AaronVisit_e78b50ef:

    # eva "¡Mierda! ¡Me he dejado la caja en el coche!"
    eva "Droga! Deixei a caixa no carro!"

# game/scripts/c15/c15.rpy:3034
translate brazilian c15s006_AaronVisit_ee341e90:

    # mc "¿Qué caja?"
    mc "Qual caixa?"

# game/scripts/c15/c15.rpy:3035
translate brazilian c15s006_AaronVisit_b662f280:

    # eva "Dame las llaves del garaje y ahora la traigo... que te lo vaya explicando Aaron..."
    eva "Me dê as chaves da garagem e eu a trago... Aaron vai te explicar..."

# game/scripts/c15/c15.rpy:3036
translate brazilian c15s006_AaronVisit_059dc465:

    # mc "Tranquila, cuando os acompañe al coche la cogeré yo. ¿Qué es?"
    mc "Não se preocupe, eu pego quando te acompanhar até o carro. O que é?"

# game/scripts/c15/c15.rpy:3038
translate brazilian c15s006_AaronVisit_5a3a37fe:

    # aar "Es uno de los últimos productos de NTR. Un test de embarazo rápido. Todavía no está aprobado por la FDA, pero las chicas me pidieron que trajera una caja."
    aar "É um dos produtos mais recentes da NTR: um teste rápido de gravidez. Ainda não foi aprovado pelo FDA, mas as meninas me pediram para levar um."

# game/scripts/c15/c15.rpy:3039
translate brazilian c15s006_AaronVisit_3d20d171:

    # mc "¿Rápido? ¿15 segundos? Los normales tardan cinco minutos..."
    mc "Rápido? 15 segundos? Os normais levam cinco minutos..."

# game/scripts/c15/c15.rpy:3040
translate brazilian c15s006_AaronVisit_52fde766:

    # aar "No me refiero a eso. Es un test que se puede hacer 48 horas después de tener relaciones. Solo necesita una gota de sangre y en 24 horas el resultado es 99.9%% preciso."
    aar "Não é a isso que me refiro. É um teste que pode ser feito 48 horas após a relação sexual. Basta uma gota de sangue e o resultado tem 99,9%% de precisão em 24 horas."

# game/scripts/c15/c15.rpy:3051
translate brazilian c15s006_AaronVisit_cdcbc3f6:

    # aar "Las chicas me dijeron que tú sabrías qué hacer con los tests... hay 50. Espero que sean suficientes."
    aar "As meninas me disseram que você saberia o que fazer com os testes... são 50. Espero que seja o suficiente."

# game/scripts/c15/c15.rpy:3053
translate brazilian c15s006_AaronVisit_84885411:

    # aar "Bueno, creo que con esto acaba esta reunión. Nos veremos en unas semanas, espero, si no tengo que volver antes."
    aar "Bem, acho que isso conclui esta reunião. Espero vê-los em algumas semanas, a menos que eu precise voltar antes."

# game/scripts/c15/c15.rpy:3054
translate brazilian c15s006_AaronVisit_8de2db0e:

    # mc "Encantado de haberte conocido, Aaron."
    mc "Prazer em conhecê-lo, Aaron."

# game/scripts/c15/c15.rpy:3056
translate brazilian c15s006_AaronVisit_83e99fc2:

    # nor "Me ha gustado mucho conocerte, Eva. ¿Por qué no vienes a comer mañana después de las lecciones con [mc]?"
    nor "Foi um prazer te conhecer, Eva. Que tal vir almoçar comigo amanhã depois das suas aulas com [mc]?"

# game/scripts/c15/c15.rpy:3057
translate brazilian c15s006_AaronVisit_45252bbd:

    # nor "Mientras estáis fuera, les contaremos la verdad a las chicas y al resto de la familia."
    nor "Enquanto você estiver fora, contaremos a verdade às meninas e ao resto da família."

# game/scripts/c15/c15.rpy:3058
translate brazilian c15s006_AaronVisit_d12b9728:

    # eva "Si no hay más remedio... es una de las condiciones que habéis puesto."
    eva "Se não houver outra opção... essa é uma das condições que você estabeleceu."

# game/scripts/c15/c15.rpy:3060
translate brazilian c15s006_AaronVisit_2f3e7864:

    # nor "Sólo si quieres. No quiero que te sientas obligada."
    nor "Só se você quiser. Não quero que você se sinta obrigado(a)."

# game/scripts/c15/c15.rpy:3061
translate brazilian c15s006_AaronVisit_3ed3cf5c:

    # eva "No, no... lo habéis pedido y vendré, no es justo que os echéis atrás ahora. Cuenta conmigo para comer. Por la tarde retiraré las cámaras de las habitaciones."
    eva "Não, não... você pediu e eu irei. Não seria justo desistir agora. Conte comigo para o almoço. Retirarei as câmeras dos quartos esta tarde."

# game/scripts/c15/c15.rpy:3063
translate brazilian c15s006_AaronVisit_a23e326b:

    # mom "Eso te deja a ti para cenar, Amanda. ¿Te apetece?"
    mom "Isso deixa você livre para o jantar, Amanda. Gostaria de jantar?"

# game/scripts/c15/c15.rpy:3064
translate brazilian c15s006_AaronVisit_26baa1a8:

    # ama "Me muero de ganas."
    ama "Estou louca para fazer isso."

# game/scripts/c15/c15.rpy:3066
translate brazilian c15s006_AaronVisit_6eaf2b59:

    # mom "[emm] te va a caer muy bien, estoy segura."
    mom "[emm] Tenho certeza de que você vai gostar muito."

# game/scripts/c15/c15.rpy:3067
translate brazilian c15s006_AaronVisit_06a2c2b7:

    # ama "Lo sé. Tengo experiencia tratando con... alguien parecido. *Risita*"
    ama "Eu sei. Tenho experiência em lidar com... alguém assim. *Risos*"

# game/scripts/c15/c15.rpy:3069
translate brazilian c15s006_AaronVisit_1d21ebb8:

    # aar "*Susurrando* Me gustaría tener una conversación privada contigo en unos días. ¿Puedo llamarte?"
    aar "*Sussurrando* Gostaria de ter uma conversa particular com você daqui a alguns dias. Posso te ligar?"

# game/scripts/c15/c15.rpy:3070
translate brazilian c15s006_AaronVisit_b8472ded:

    # mc "Por supuesto. ¿Sobre qué?"
    mc "Claro. Sobre o quê?"

# game/scripts/c15/c15.rpy:3071
translate brazilian c15s006_AaronVisit_38c631f6:

    # aar "*Susurrando* Entre otras cosas, sobre dónde me has visto con anterioridad. Recuerda que éramos tres. Pero ahora no es el momento."
    aar "*Sussurrando* Entre outras coisas, sobre onde você já me viu antes. Lembre-se que éramos três. Mas agora não é hora para isso."

# game/scripts/c15/c15.rpy:3073
translate brazilian c15s006_AaronVisit_9e633314:

    # mom "Eva, estoy deseando que vengas a comer mañana y tener más tiempo para conocernos, si las chicas te dejan un minuto."
    mom "Eva, estou ansiosa para que você venha almoçar amanhã e tenhamos mais tempo para nos conhecermos melhor, se as meninas te permitirem um minutinho."

# game/scripts/c15/c15.rpy:3074
translate brazilian c15s006_AaronVisit_88319b2f:

    # eva "Seguro que sí... no suelo ser muy sociable... y se van a aburrir de mí enseguida."
    eva "Tenho certeza que sim... Normalmente não sou muito sociável... e eles vão se cansar de mim rapidamente."

# game/scripts/c15/c15.rpy:3075
translate brazilian c15s006_AaronVisit_77253fee:

    # mom "*Risa* Lo dudo, pero ya lo veremos mañana."
    mom "*Risos* Duvido, mas veremos amanhã."

# game/scripts/c15/c15.rpy:3077
translate brazilian c15s006_AaronVisit_4a071ec3:

    # nor "Gracias por lo del otro día, Amanda. Tengo muchas ganas de conocerte mejor."
    nor "Obrigada pelo outro dia, Amanda. Estou ansiosa para te conhecer melhor."

# game/scripts/c15/c15.rpy:3078
translate brazilian c15s006_AaronVisit_1109e5d4:

    # ama "Yo también... a todas. Observándoos a distancia parecéis una familia... muy interesante."
    ama "Eu também... para todos vocês. Observando vocês de longe, parecem uma família... muito interessante."

# game/scripts/c15/c15.rpy:3079
translate brazilian c15s006_AaronVisit_ed609ed6:

    # nor "No sé lo que habrás visto... quizás sí que somos un poco diferentes de lo normal..."
    nor "Não sei o que você viu... talvez sejamos mesmo um pouco diferentes do normal..."

# game/scripts/c15/c15.rpy:3080
translate brazilian c15s006_AaronVisit_5a0794bd:

    # mc "¡Ejem! Creo que es momento de acabar con los abrazos. El vuelo de Aaron no va a esperar."
    mc "Hum! Acho que está na hora de parar com os abraços. O voo do Aaron não pode esperar."

# game/scripts/c15/c15.rpy:3082
translate brazilian c15s006_AaronVisit_7b7499f5:

    # mc "¡Vale, vale! No hace falta que me miréis como si yo fuera el enemigo. Os vais a ver mañana..."
    mc "Tá bem, tá bem! Não precisa me olhar como se eu fosse o inimigo. Vocês se veem amanhã..."

# game/scripts/c15/c15.rpy:3083
translate brazilian c15s006_AaronVisit_07e65a90:

    # mc "Os acompaño al coche."
    mc "Eu te acompanharei até o carro."

# game/scripts/c15/c15.rpy:3085
translate brazilian c15s006_AaronVisit_ca487079:

    # "Después de despedirte de Aaron..."
    "Depois de me despedir de Aaron..."

# game/scripts/c15/c15.rpy:3086
translate brazilian c15s006_AaronVisit_44e10fe8:

    # mc "Bueno, chicas, nos veremos mañana. Eva, a mediodía en el lago, ¿OK?"
    mc "Ok, meninas, vejo vocês amanhã. Eva, ao meio-dia no lago, combinado?"

# game/scripts/c15/c15.rpy:3088
translate brazilian c15s006_AaronVisit_388fd1ad:

    # eva "Sí, a mediodía... y gracias..."
    eva "Sim, ao meio-dia... e obrigada..."

# game/scripts/c15/c15.rpy:3089
translate brazilian c15s006_AaronVisit_8ee6cc36:

    # mc "No sé por qué, pero no hay de qué..."
    mc "Não sei porquê, mas de nada..."

# game/scripts/c15/c15.rpy:3090
translate brazilian c15s006_AaronVisit_e514a195:

    # eva "Por convencer a [mar] y [nor] de que nos aceptaran... ha sido intenso..."
    eva "Convencer [mar] e [nor] a nos aceitarem... tem sido intenso..."

# game/scripts/c15/c15.rpy:3091
translate brazilian c15s006_AaronVisit_a9428d84:

    # mc "Yo no..."
    mc "Eu não..."

# game/scripts/c15/c15.rpy:3093
translate brazilian c15s006_AaronVisit_817cd02b:

    # ama "No lo niegues, [mc]... ha quedado muy claro que lo de pedir que nos quedáramos lo teníais pactado."
    ama "Não negue, [mc]... ficou muito claro que você concordou em nos pedir para ficar."

# game/scripts/c15/c15.rpy:3094
translate brazilian c15s006_AaronVisit_d85f17d1:

    # mc "Ha sido cosa de ellas, te aseguro que no he tenido nada que ver. No quiero un mérito que no es mío. Aunque yo también lo iba a pedir."
    mc "Foi obra deles, garanto que não tive nada a ver com isso. Não quero crédito que não é meu. Embora eu também fosse pedir por ele."

# game/scripts/c15/c15.rpy:3095
translate brazilian c15s006_AaronVisit_4917fad3:

    # mc "Pero me alegra que os hayáis sentido así."
    mc "Mas fico feliz que você tenha se sentido assim."

# game/scripts/c15/c15.rpy:3096
translate brazilian c15s006_AaronVisit_bcb467c7:

    # ama "A ver si Eva me deja despedirme."
    ama "Vamos ver se a Eva vai me deixar me despedir."

# game/scripts/c15/c15.rpy:3098
translate brazilian c15s006_AaronVisit_085ba100:

    # eva "Solo un minuto más..."
    eva "Só mais um minutinho..."

# game/scripts/c15/c15.rpy:3099
translate brazilian c15s006_AaronVisit_41f840aa:

    # aar "Chicas, el plan de vuelo..."
    aar "Meninas, o plano de voo..."

# game/scripts/c15/c15.rpy:3100
translate brazilian c15s006_AaronVisit_f2f2e83b:

    # eva "Vaaale..."
    eva "OK..."

# game/scripts/c15/c15.rpy:3102
translate brazilian c15s006_AaronVisit_62f8c090:

    # ama "Gracias, [mc]. Ha sido casi como sentirse parte de la familia por un momento."
    ama "Obrigado, [mc]. Foi quase como me sentir parte da família por um momento."

# game/scripts/c15/c15.rpy:3103
translate brazilian c15s006_AaronVisit_790380f1:

    # ama "Me costaba creerte ayer, cuando hablabas de la familia... pero después de esto... tengo muchas ganas de cenar mañana."
    ama "Ontem, quando você falou sobre família, achei difícil acreditar... mas depois disso... estou realmente ansioso para o jantar de amanhã."

# game/scripts/c15/c15.rpy:3104
translate brazilian c15s006_AaronVisit_960b0d54:

    # mc "Me temo que se te pasarán en cuanto llegues. Ser el centro de atención puede ser complicado en esta familia. Ármate de paciencia."
    mc "Receio que eles passem assim que você chegar. Ser o centro das atenções pode ser complicado nesta família. Tenha paciência."

# game/scripts/c15/c15.rpy:3108
translate brazilian c15s006_AaronVisit_c062ae71:

    # "Tras la segunda queja de Aaron sobre el plan de vuelo, te entregan la caja y se marchan a regañadientes."
    "Após a segunda reclamação de Aaron sobre o plano de voo, eles entregam a caixa e saem a contragosto."

# game/scripts/c15/c15.rpy:3110
translate brazilian c15s006_AaronVisit_27422f28:

    # "Tras la segunda queja de Aaron sobre el plan de vuelo, se marchan a regañadientes."
    "Após a segunda reclamação de Aaron sobre o plano de voo, eles partem a contragosto."

# game/scripts/c15/c15.rpy:3113
translate brazilian c15s006_AaronVisit_250687f0:

    # mc "Ya se han ido. ¿Qué os ha parecido la reunión?"
    mc "Eles já foram embora. O que você achou da reunião?"

# game/scripts/c15/c15.rpy:3114
translate brazilian c15s006_AaronVisit_120bb197:

    # mom "Extraño... tener a una [emm] que no es nuestra [emm] delante, ha sido extraño... Si no fuera por el pelo..."
    mom "Estranho... ter alguém que não é nosso na nossa frente tem sido estranho... Se não fosse pelo cabelo..."

# game/scripts/c15/c15.rpy:3115
translate brazilian c15s006_AaronVisit_08fd2832:

    # nor "Eva me ha parecido... encantadora de una forma rara... al principio estaba distante, pero después... no sé... creo que al final no quería irse."
    nor "Eva me pareceu... encantadora de um jeito estranho... a princípio ela era distante, mas depois... não sei... acho que no fim ela não queria ir embora."

# game/scripts/c15/c15.rpy:3116
translate brazilian c15s006_AaronVisit_dc245214:

    # mc "Ninguna de las dos quería irse. Ayer estuve hablando con las dos, en la playa..."
    mc "Nenhum dos dois queria ir embora. Eu estava conversando com os dois ontem na praia..."

# game/scripts/c15/c15.rpy:3118
translate brazilian c15s006_AaronVisit_498f76f2:

    # mom "¿Estaban en la playa?" (multiple=2)
    mom "Eles estavam na praia?" (multiple=2)

# game/scripts/c15/c15.rpy:3119
translate brazilian c15s006_AaronVisit_4598e340:

    # nor "¿Por qué no les dijiste que se unieran?" (multiple=2)
    nor "Por que você não os convidou para participar?" (multiple=2)

# game/scripts/c15/c15.rpy:3120
translate brazilian c15s006_AaronVisit_d25fc767:

    # mc "Sólo Eva estaba en la playa, vigilándonos. Amanda estaba en su base."
    mc "Só Eva estava na praia, cuidando de nós. Amanda estava em sua base."

# game/scripts/c15/c15.rpy:3121
translate brazilian c15s006_AaronVisit_5471076d:

    # mc "Y decirles que se unieran podría haber sido complicado sin que nuestras chicas supieran de su existencia. Ni nuestras chicas ni el resto, claro."
    mc "E dizer para elas se juntarem a nós poderia ter sido complicado sem que nossas meninas soubessem disso. Nem nossas meninas, nem as outras, é claro."

# game/scripts/c15/c15.rpy:3123
translate brazilian c15s006_AaronVisit_e29a0f0c:

    # nor "Tienes razón. Solo nosotros, Betty y tu abuela saben de su existencia. Demasiadas explicaciones."
    nor "Você tem razão. Só a Betty, sua avó, e nós sabemos disso. São muitas explicações."

# game/scripts/c15/c15.rpy:3124
translate brazilian c15s006_AaronVisit_eb746bde:

    # nor "Y esas explicaciones habrá que darlas mañana. Realmente me da miedo la reacción de las chicas..."
    nor "E essas explicações terão que ser dadas amanhã. Estou realmente com medo da reação das meninas..."

# game/scripts/c15/c15.rpy:3125
translate brazilian c15s006_AaronVisit_8931b604:

    # mc "Aprovechad mientras Eva me enseña a disparar. Creo que es una cosa que cada una de vosotras tiene que hacer con sus hijas. Y no es que me esté escaqueando."
    mc "Aproveitem enquanto a Eva me ensina a atirar. Acho que é algo que cada um de vocês deveria fazer com suas filhas. E não é como se eu estivesse me esquivando das minhas responsabilidades."

# game/scripts/c15/c15.rpy:3127
translate brazilian c15s006_AaronVisit_ee1d1851:

    # mom "Yo también lo creo. Prefiero explicárselo a [emm] a solas."
    mom "Eu também acho. Prefiro explicar isso apenas para [emm]."

# game/scripts/c15/c15.rpy:3128
translate brazilian c15s006_AaronVisit_e26bbebf:

    # mom "Pero ¿qué hacemos con el resto? Si Scarlett o las estudiantes... o Kiara y Eileen... ven a Eva con [dap] y [eri], o a Amanda con [emm]..."
    mom "Mas o que fazemos com o resto? Se Scarlett ou os alunos... ou Kiara e Eileen... virem Eva com [dap] e [eri], ou Amanda com [emm]..."

# game/scripts/c15/c15.rpy:3129
translate brazilian c15s006_AaronVisit_5bc1056f:

    # mc "¡Uff! No había pensado en eso. Yo confío en que Eileen y Saira podrán guardar el secreto..."
    mc "Ufa! Eu não tinha pensado nisso. Confio que Eileen e Saira conseguirão guardar o segredo..."

# game/scripts/c15/c15.rpy:3131
translate brazilian c15s006_AaronVisit_d73d6923:

    # nor "Yo pondría la mano en el fuego por Kiara... Supongo que es mejor explicarles algo al resto de las estudiantes antes de que lo descubran ellas."
    nor "Eu confiaria na Kiara... Acho que é melhor explicar algo para o resto dos alunos antes que eles descubram."

# game/scripts/c15/c15.rpy:3132
translate brazilian c15s006_AaronVisit_e487bdc0:

    # nor "Podemos decir que son... unas primas que viven lejos..."
    nor "Poderíamos dizer que são... primos que moram longe..."

# game/scripts/c15/c15.rpy:3133
translate brazilian c15s006_AaronVisit_b0356c07:

    # mc "¿Más mentiras, [nor]? Creo que nadie de los que estuvieron ayer en la playa va a hacer nada que pueda perjudicar a las chicas... a ninguna de las cinco."
    mc "Mais mentiras, [nor]? Não acho que alguém que estava na praia ontem vá fazer algo que possa prejudicar as meninas... nenhuma das cinco."

# game/scripts/c15/c15.rpy:3135
translate brazilian c15s006_AaronVisit_5a0ce203:

    # mom "Estoy de acuerdo contigo. Y eso incluye a Samantha, Simone, Alexia... y también a Jamaal. Creo que no nos dejamos a nadie."
    mom "Concordo com você. E isso inclui Samantha, Simone, Alexia... e Jamaal também. Acho que já falamos de todos."

# game/scripts/c15/c15.rpy:3137
translate brazilian c15s006_AaronVisit_5de91de3:

    # mc "Tan solo a Megan... la invitaste a dormir en casa el fin de semana... va a ver a las chicas juntas."
    mc "Só a Megan... você a convidou para dormir aqui no fim de semana... ela vai encontrar as amigas."

# game/scripts/c15/c15.rpy:3139
translate brazilian c15s006_AaronVisit_d8aad798:

    # mc "Tan solo a Megan, una amiga... la invité a dormir en casa el fin de semana... va a ver a las chicas juntas."
    mc "Eu só convidei a Megan, uma amiga... para dormir aqui em casa no fim de semana... ela vai se encontrar com as amigas."

# game/scripts/c15/c15.rpy:3140
translate brazilian c15s006_AaronVisit_28e839c3:

    # mom "¿Confías en ella?"
    mom "Você confia nela?"

# game/scripts/c15/c15.rpy:3141
translate brazilian c15s006_AaronVisit_edb89c5b:

    # mc "Sí. Además, también es amiga de Saira, con lo que es mejor que se lo cuente yo antes de que se entere por otros medios."
    mc "Sim. Além disso, ela também é amiga da Saira, então é melhor eu contar para ela antes que ela descubra por outros meios."

# game/scripts/c15/c15.rpy:3142
translate brazilian c15s006_AaronVisit_4760328a:

    # mc "¡Joder! Tantos años guardando el secreto y ahora lo destapamos a lo grande..."
    mc "Caramba! Tantos anos guardando o segredo e agora vamos revelá-lo em grande estilo..."

# game/scripts/c15/c15.rpy:3143
translate brazilian c15s006_AaronVisit_f360ee27:

    # mc "Un tema aclarado. ¿Qué opináis del tema de la empresa? ¿Qué hacemos?"
    mc "Essa questão já foi esclarecida. Qual a sua opinião sobre a situação da empresa? O que devemos fazer?"

# game/scripts/c15/c15.rpy:3145
translate brazilian c15s006_AaronVisit_e81ed396:

    # nor "Mientras despedías a Eva y a Amanda, hemos decidido que primero hay que explicárselo a nuestras chicas. Ellas también tienen que decidir."
    nor "Enquanto você se despedia de Eva e Amanda, decidimos que primeiro precisamos explicar isso às nossas filhas. Elas também precisam decidir."

# game/scripts/c15/c15.rpy:3146
translate brazilian c15s006_AaronVisit_ff0e29d7:

    # nor "La empresa es tan suya como nuestra, o de Aaron, Eva y Amanda, y a lo mejor tienen ideas diferentes sobre qué hacer a las que podamos tener nosotras."
    nor "A empresa é tanto deles quanto nossa, ou de Aaron, Eva e Amanda, já que eles podem ter ideias diferentes sobre o que fazer."

# game/scripts/c15/c15.rpy:3147
translate brazilian c15s006_AaronVisit_a37abb9b:

    # mc "Me parece lo más correcto."
    mc "Acho que é a coisa certa a fazer."

# game/scripts/c15/c15.rpy:3150
translate brazilian c15s006_AaronVisit_4e552617:

    # mom "Cambiando de tema... ¿Qué has hecho con la caja? ¿La de los tests?"
    mom "Mudando de assunto... O que você fez com a caixa? Aquela com os testes?"

# game/scripts/c15/c15.rpy:3153
translate brazilian c15s006_AaronVisit_551b52c3:

    # nor "Cambiando de tema... ¿Qué has hecho con la caja? ¿La de los tests?"
    nor "Mudando de assunto... O que você fez com a caixa? Aquela com os testes?"

# game/scripts/c15/c15.rpy:3155
translate brazilian c15s006_AaronVisit_d321a2ef:

    # mc "La he dejado en el recibidor."
    mc "Deixei no corredor."

# game/scripts/c15/c15.rpy:3163
translate brazilian c15s006_AaronVisit_7df20501:

    # mcp "(No creo que venga de un minuto. Hay que esperar 24 horas para saber los resultados. *Risa mental*)"
    mcp "(Acho que não vai sair em um minuto. Temos que esperar 24 horas pelos resultados. *Risos mentais*)"

# game/scripts/c15/c15.rpy:3166
translate brazilian c15s006_AaronVisit_100bf87f:

    # "Hacéis las pruebas de embarazo. Son tan sencillas como poner una gota de sangre en una tira de plástico y ponerla dentro de una pequeña máquina."
    "Você faz testes de gravidez. É tão simples quanto colocar uma gota de sangue em uma tira de plástico e inseri-la em um pequeno aparelho."

# game/scripts/c15/c15.rpy:3167
translate brazilian c15s006_AaronVisit_d5786b61:

    # "Etiquetáis las pruebas con el nombre de [nor] y [mar] y las guardáis en lugar seguro, en la habitación de [nor]."
    "Você etiqueta as evidências com os nomes [nor] e [mar] e as guarda em um local seguro, no quarto de [nor]."

# game/scripts/c15/c15.rpy:3169
translate brazilian c15s006_AaronVisit_74934509:

    # "Hacéis la prueba de embarazo. Es tan sencilla como poner una gota de sangre en una tira de plástico y ponerla dentro de una pequeña máquina. La guardáis en lugar seguro."
    "Você faz um teste de gravidez. É tão simples quanto colocar uma gota de sangue em uma tira de plástico e inseri-la em um pequeno aparelho. Você guarda o teste em um local seguro."

# game/scripts/c15/c15.rpy:3171
translate brazilian c15s006_AaronVisit_e0220bc1:

    # "Continuáis hablando sobre la reunión un rato, antes de que empiecen a volver las chicas que han ido a la ciudad."
    "Vocês continuam conversando sobre o encontro por um tempo, até que as garotas que foram para a cidade começam a voltar."

# game/scripts/c15/c15.rpy:3174
translate brazilian c15s006_AaronVisit_977d1c5d:

    # "Te llevas la caja con las otras 48 pruebas a tu habitación. Esperas tener suficientes para el resto de tu vida."
    "Você leva a caixa com os outros 48 testes para o seu quarto. Espera ter o suficiente para o resto da vida."

# game/scripts/c15/c15.rpy:3176
translate brazilian c15s006_AaronVisit_2fd66ddd:

    # "Te llevas la caja con las 50 pruebas de embarazo a tu habitación. Esperas tener suficientes para el resto de tu vida."
    "Você leva a caixa com 50 testes de gravidez para o seu quarto. Espera ter o suficiente para o resto da vida."

# game/scripts/c15/c15.rpy:3181
translate brazilian c15s006_Story_2e4e4045:

    # aar "OK. Ya sabéis quién fundó NTR. Tenéis que entender que eran unos genios."
    aar "Certo. Você já sabe quem fundou a NTR. Você precisa entender que eles eram gênios."

# game/scripts/c15/c15.rpy:3184
translate brazilian c15s006_Story_0986c2d4:

    # aar "OK. Ya sabéis quién fundó NTR. Tienes que saber que tu madre era un genio, [mc]. Todos lo eran."
    aar "OK. Você sabe quem fundou a NTR. Você precisa saber que sua mãe era uma gênia, [mc]. Todas elas eram."

# game/scripts/c15/c15.rpy:3185
translate brazilian c15s006_Story_88dfca2e:

    # aar "Empezaron estudiando árboles genealógicos basándose en el ADN. Pero hicieron un descubrimiento rompedor."
    aar "Eles começaram estudando árvores genealógicas com base no DNA. Mas fizeram uma descoberta inovadora."

# game/scripts/c15/c15.rpy:3186
translate brazilian c15s006_Story_fe83aec9:

    # aar "Ya se habían hecho clonaciones anteriormente de animales. Todos recordamos a Dolly."
    aar "Animais já haviam sido clonados antes. Todos nos lembramos da Dolly."

# game/scripts/c15/c15.rpy:3187
translate brazilian c15s006_Story_bec1f593:

    # aar "Pero ellos descubrieron como hacer clonaciones aceleradas. De embrión a individuo viable en un tercio del tiempo de gestación."
    aar "Mas eles descobriram como realizar clonagem acelerada. Do embrião ao indivíduo viável em um terço do tempo de gestação."

# game/scripts/c15/c15.rpy:3189
translate brazilian c15s006_Story_7c1c7aca:

    # aar "Daniel era la gran mente detrás de ello."
    aar "Daniel foi a grande mente por trás disso."

# game/scripts/c15/c15.rpy:3191
translate brazilian c15s006_Story_c2848b1c:

    # aar "Anna era la gran mente detrás de ello."
    aar "Anna foi a grande mente por trás disso."

# game/scripts/c15/c15.rpy:3193
translate brazilian c15s006_Story_39cd7c12:

    # aar "Empezaron clonando animales... ovejas, cerdos..."
    aar "Eles começaram clonando animais... ovelhas, porcos..."

# game/scripts/c15/c15.rpy:3194
translate brazilian c15s006_Story_17d1281c:

    # aar "Pero Dominic convenció al resto para que probasen la clonación humana. Ahí es donde estaría el dinero de verdad. Imaginaros tener un clon humano en solo tres meses."
    aar "Mas Dominic convenceu os outros a tentar a clonagem humana. Era aí que estava o verdadeiro dinheiro. Imagine ter um clone humano em apenas três meses."

# game/scripts/c15/c15.rpy:3195
translate brazilian c15s006_Story_4a1d0b10:

    # aar "Obviamente en los Estados Unidos era ilegal, con lo que compraron laboratorios en un par de países donde la legislación era poco clara al respecto."
    aar "Obviamente, isso era ilegal nos Estados Unidos, então eles compraram laboratórios em alguns países onde a legislação sobre o assunto era ambígua."

# game/scripts/c15/c15.rpy:3196
translate brazilian c15s006_Story_53280390:

    # aar "Después de varios experimentos en el extranjero consiguen la primera clonación más o menos correcta. La Serie A. Yo y mis dos hermanos. Alfred y Arnau."
    aar "Após diversas experiências no exterior, eles conseguem a primeira clonagem, mais ou menos bem-sucedida. Série A. Eu e meus dois irmãos. Alfred e Arnau."

# game/scripts/c15/c15.rpy:3198
translate brazilian c15s006_Story_0a2a7e26:

    # mc "Espera... has dicho que eso pasó hace 20 o 21 años. ¿Cómo puedes ser tú?"
    mc "Espere... você disse que isso aconteceu há 20 ou 21 anos. Como pode ser você?"

# game/scripts/c15/c15.rpy:3199
translate brazilian c15s006_Story_ba72dc5e:

    # aar "Porque yo tengo 21 años. No solo se triplicaba la velocidad de gestación. El envejecimiento no se paraba al \"nacer\"."
    aar "Porque tenho 21 anos. Não só a taxa de gestação triplicou, como o envelhecimento não parou no nascimento."

# game/scripts/c15/c15.rpy:3200
translate brazilian c15s006_Story_5dce615d:

    # aar "Además, el material genético inicial... Bueno, eso es para otro día... hoy no hay tiempo."
    aar "Além disso, o material genético inicial... Bem, isso é assunto para outro dia... não há tempo hoje."

# game/scripts/c15/c15.rpy:3201
translate brazilian c15s006_Story_e218d169:

    # mc "¡Joder! Entonces..."
    mc "Caramba! Então..."

# game/scripts/c15/c15.rpy:3203
translate brazilian c15s006_Story_f1ce2633:

    # aar "Sí, mi cuerpo tiene más de 60. Pero no estamos aquí para hablar de mí."
    aar "Sim, meu corpo tem mais de 60 anos. Mas não estamos aqui para falar de mim."

# game/scripts/c15/c15.rpy:3204
translate brazilian c15s006_Story_110a83f1:

    # aar "Después llegó la Serie B. Brandon, Bryce, Brady, Benito, y Bart. Los chicos no salieron bien."
    aar "Em seguida veio a Série B. Brandon, Bryce, Brady, Benito e Bart. Os garotos não se saíram bem."

# game/scripts/c15/c15.rpy:3205
translate brazilian c15s006_Story_784d8983:

    # aar "Intentaron controlar el envejecimiento una vez fuera de los tubos, pero no funcionó. El resultado fue inverso. A los 10 años estaban peor que yo ahora."
    aar "Eles tentaram controlar o envelhecimento depois que as crianças saíram dos tubos, mas não funcionou. O resultado foi o oposto. Aos 10 anos de idade, elas estavam em pior estado do que eu estou agora."

# game/scripts/c15/c15.rpy:3208
translate brazilian c15s006_Story_392aaa06:

    # aar "Para la tercera serie, Daniel decidió probar otra cosa. Clonar chicas introduciendo algunos cambios."
    aar "Para a terceira temporada, Daniel decidiu tentar algo diferente: clonar garotas, com algumas modificações."

# game/scripts/c15/c15.rpy:3209
translate brazilian c15s006_Story_87f5648a:

    # mc "Y aparecen Amanda y Eva, ¿no?"
    mc "E Amanda e Eva aparecem, certo?"

# game/scripts/c15/c15.rpy:3210
translate brazilian c15s006_Story_479d6206:

    # aar "Exacto."
    aar "Exato."

# game/scripts/c15/c15.rpy:3212
translate brazilian c15s006_Story_2812f62f:

    # eva "También Beatrice, Claire, y Diana... y Fiona..."
    eva "Beatrice, Claire e Diana também... e Fiona..."

# game/scripts/c15/c15.rpy:3214
translate brazilian c15s006_Story_a75c0ec1:

    # nor "Pero ¿De dónde sacaron el material?"
    nor "Mas onde eles conseguiram o material?"

# game/scripts/c15/c15.rpy:3215
translate brazilian c15s006_Story_4d81478d:

    # mom "Nunca perdí a [emm] de vista. Nunca se quedó sola cuando íbamos al médico."
    mom "Eu nunca perdi [emm] de vista. Ela nunca foi deixada sozinha quando íamos ao médico."

# game/scripts/c15/c15.rpy:3217
translate brazilian c15s006_Story_28e6945d:

    # aar "Estabais embarazadas a la vez. A Daniel se le ocurrió la idea de extraer células de los fetos."
    aar "Vocês duas estavam grávidas ao mesmo tempo. Daniel teve a ideia de extrair células dos fetos."

# game/scripts/c15/c15.rpy:3218
translate brazilian c15s006_Story_c7952ef3:

    # aar "En algún momento os debieron llevar engañadas a las instalaciones de NTR a haceros algunas pruebas y aprovecharon para extraer el material genético."
    aar "Em algum momento, você deve ter sido enganado e levado às instalações da NTR para se submeter a alguns testes, e eles aproveitaram a oportunidade para extrair seu material genético."

# game/scripts/c15/c15.rpy:3220
translate brazilian c15s006_Story_b349305b:

    # mom "¿Sin nuestro consentimiento? ¿Cómo pudieron hacernos eso?"
    mom "Sem o nosso consentimento? Como puderam fazer isso conosco?"

# game/scripts/c15/c15.rpy:3222
translate brazilian c15s006_Story_11a6de7c:

    # nor "¡Qué hijos de puta! ¿Cómo pudo Mike aceptar hacer eso con sus propias hijas?"
    nor "Que filhos da puta! Como é que o Mike pôde concordar em fazer isso com as próprias filhas?"

# game/scripts/c15/c15.rpy:3224
translate brazilian c15s006_Story_98b6c55b:

    # mom "No te lo tomes mal, cielo... esto es nuevo para nosotras... me alegra que estéis aquí ahora."
    mom "Não me leve a mal, querida... isso é novo para nós... fico feliz que você esteja aqui agora."

# game/scripts/c15/c15.rpy:3225
translate brazilian c15s006_Story_ccc0dba7:

    # ama "Gracias, [mar]..."
    ama "Obrigado, [mar]..."

# game/scripts/c15/c15.rpy:3227
translate brazilian c15s006_Story_3e69544b:

    # nor "Sí, vosotras no tenéis la culpa... pero si Mike no estuviera muerto... lo volvería a matar yo ahora mismo."
    nor "Sim, não é sua culpa... mas se o Mike não estivesse morto... eu o mataria de novo agora mesmo."

# game/scripts/c15/c15.rpy:3228
translate brazilian c15s006_Story_35c1ea13:

    # eva "Me gusta como piensas. Yo seguramente haría lo mismo."
    eva "Gosto da sua maneira de pensar. Provavelmente faria o mesmo."

# game/scripts/c15/c15.rpy:3230
translate brazilian c15s006_Story_591209eb:

    # aar "El experimento XX fue todo un éxito como podéis ver. Solucionaron el problema de los telómeros cortos y..."
    aar "O experimento XX foi um sucesso absoluto, como vocês podem ver. Eles resolveram o problema dos telômeros curtos e..."

# game/scripts/c15/c15.rpy:3231
translate brazilian c15s006_Story_6e399718:

    # mc "¿Telo-qué?"
    mc "Telo-o quê?"

# game/scripts/c15/c15.rpy:3232
translate brazilian c15s006_Story_4485fc64:

    # aar "Telómeros. Es lo que produce el envejecimiento acelerado. Como podéis ver, Eva y Amanda no parecen mayores que [emm], [eri], o [dap]."
    aar "Telômeros. É isso que causa o envelhecimento acelerado. Como você pode ver, Eva e Amanda não parecem mais velhas do que [emm], [eri] ou [dap]."

# game/scripts/c15/c15.rpy:3233
translate brazilian c15s006_Story_85db7d6a:

    # mc "Ah, OK."
    mc "Ah, ok."

# game/scripts/c15/c15.rpy:3234
translate brazilian c15s006_Story_cbc25f4f:

    # mcp "(Necesitaríamos que [dap] estuviera aquí para que nos tradujese la jerga científica.)"
    mcp "(Precisaríamos de [dap] aqui para traduzir o jargão científico para nós.)"

# game/scripts/c15/c15.rpy:3235
translate brazilian c15s006_Story_ce50c030:

    # mc "Pero habéis nombrado a seis chicas, y solo había dos embarazos... o tres si contáis que [nor] tenía gemelas... ¿Quiénes eran las otras...? ¿Donantes?"
    mc "Mas você mencionou seis meninas, e houve apenas duas gravidezes... ou três, se você contar que [nor] teve gêmeos... Quem foram as outras...? Doadoras?"

# game/scripts/c15/c15.rpy:3237
translate brazilian c15s006_Story_9c193365:

    # ama "No había más donantes. Los sujetos A, B, y C, Beatrice, Claire y yo, nacimos de material genético de [emm]. D, E, y F, Diana, Eva, y Fiona, del de [dap] o [eri]."
    ama "Não havia mais doadores. Os indivíduos A, B e C, Beatrice, Claire e eu, nascemos do material genético de [emm]. Os indivíduos D, E e F, Diana, Eva e Fiona, nasceram do material genético de [dap] ou [eri]."

# game/scripts/c15/c15.rpy:3238
translate brazilian c15s006_Story_301d0456:

    # mc "Ah, vale... tres clones por cada chica."
    mc "Ah, ok... três clones para cada garota."

# game/scripts/c15/c15.rpy:3240
translate brazilian c15s006_Story_56c4dc33:

    # eva "Sí. La idea era que sirviéramos como \"material de repuesto\" por si alguna vez necesitaban un trasplante."
    eva "Sim. A ideia era que serviríamos como \"material de reserva\" caso eles precisassem de um transplante."

# game/scripts/c15/c15.rpy:3241
translate brazilian c15s006_Story_f0baba46:

    # mc "¡Pero eso es inhumano! ¡Sois personas! No podían pensar en sacrificaros si [dap] hubiera necesitado... yo que sé... un pulmón..."
    mc "Mas isso é desumano! Vocês são pessoas! Eles nem pensariam em sacrificar vocês se [dap] precisasse de... sei lá... um pulmão..."

# game/scripts/c15/c15.rpy:3242
translate brazilian c15s006_Story_d41e55ac:

    # eva "Sí, lo es. Y sí, lo pensaban hacer. A ellos les daba lo mismo en ese momento. Solo éramos experimentos."
    eva "Sim, é verdade. E sim, eles estavam planejando fazer isso. Eles não se importavam na época. Éramos apenas cobaias."

# game/scripts/c15/c15.rpy:3244
translate brazilian c15s006_Story_93eae1e7:

    # aar "Y ahí es cuando empezó a torcerse la cosa. Si puedes crear clones y usarlos como repositorio de órganos de cara al futuro..."
    aar "E foi aí que as coisas começaram a dar errado. Se você consegue criar clones e usá-los como um repositório de órgãos para o futuro..."

# game/scripts/c15/c15.rpy:3245
translate brazilian c15s006_Story_7e521a9a:

    # mc "Los billonarios se volverían locos por tener eso para sus hijos."
    mc "Bilionários ficariam loucos para ter isso para seus filhos."

# game/scripts/c15/c15.rpy:3246
translate brazilian c15s006_Story_c4f8d22a:

    # aar "Exacto. Mis chicas nacieron antes que las vuestras. Y se comprobó que el envejecimiento no continuaba una vez fuera del tanque."
    aar "Exatamente. Minhas filhas nasceram antes das suas. E foi comprovado que o envelhecimento não continuava depois que elas saíam do tanque."

# game/scripts/c15/c15.rpy:3248
translate brazilian c15s006_Story_a6f80731:

    # aar "Para la tercera serie, Anna decidió probar otra cosa. Clonar chicas introduciendo algunos cambios."
    aar "Para a terceira temporada, Anna decidiu tentar algo diferente: clonar garotas, com algumas modificações."

# game/scripts/c15/c15.rpy:3249
translate brazilian c15s006_Story_20f8a1d8:

    # mc "Y aparecen [emm], [eri] y [dap], ¿no?"
    mc "E [emm], [eri] e [dap] aparecem, certo?"

# game/scripts/c15/c15.rpy:3250
translate brazilian c15s006_Story_479d6206_1:

    # aar "Exacto."
    aar "Exato."

# game/scripts/c15/c15.rpy:3252
translate brazilian c15s006_Story_63f39f20:

    # nor "Pero ¿De dónde sacaron el material genético?"
    nor "Mas onde eles obtiveram o material genético?"

# game/scripts/c15/c15.rpy:3253
translate brazilian c15s006_Story_12addd33:

    # mom "Mike y Dominic nunca nos lo contaron."
    mom "Mike e Dominic nunca nos contaram."

# game/scripts/c15/c15.rpy:3255
translate brazilian c15s006_Story_a377904d:

    # aar "Se pagó a mujeres embarazadas que querían dar sus bebés en adopción. NTR los adoptaría a cambio de hacer unas pruebas con los fetos."
    aar "Mulheres grávidas que desejavam entregar seus bebês para adoção recebiam pagamento. A NTR os adotava em troca da realização de exames nos fetos."

# game/scripts/c15/c15.rpy:3256
translate brazilian c15s006_Story_09c7b928:

    # aar "En total había seis chicas."
    aar "Havia seis meninas no total."

# game/scripts/c15/c15.rpy:3257
translate brazilian c15s006_Story_0cf76729:

    # mc "Amanda, Eva, y ¿quién más?"
    mc "Amanda, Eva, e quem mais?"

# game/scripts/c15/c15.rpy:3259
translate brazilian c15s006_Story_5559fa61:

    # eva "También Beatrice, Claire, y Diana... y Fiona... Ninguna de ellas está entre nosotras a día de hoy."
    eva "Também Beatrice, Claire e Diana... e Fiona... Nenhuma delas está conosco hoje."

# game/scripts/c15/c15.rpy:3260
translate brazilian c15s006_Story_7a2f7317:

    # mc "Lo siento..."
    mc "Desculpe..."

# game/scripts/c15/c15.rpy:3262
translate brazilian c15s006_Story_591209eb_1:

    # aar "El experimento XX fue todo un éxito como podéis ver. Solucionaron el problema de los telómeros cortos y..."
    aar "O experimento XX foi um sucesso absoluto, como vocês podem ver. Eles resolveram o problema dos telômeros curtos e..."

# game/scripts/c15/c15.rpy:3263
translate brazilian c15s006_Story_6e399718_1:

    # mc "¿Telo-qué?"
    mc "Telo-o quê?"

# game/scripts/c15/c15.rpy:3264
translate brazilian c15s006_Story_d246e0ec:

    # aar "Telómeros. Es lo que produce el envejecimiento acelerado. Como podéis ver, [emm], [eri], o [dap] no parecen mayores que Eva y Amanda."
    aar "Telômeros. É isso que causa o envelhecimento acelerado. Como você pode ver, [emm], [eri] ou [dap] não parecem mais velhos que Eva e Amanda."

# game/scripts/c15/c15.rpy:3265
translate brazilian c15s006_Story_85db7d6a_1:

    # mc "Ah, OK."
    mc "Ah, ok."

# game/scripts/c15/c15.rpy:3266
translate brazilian c15s006_Story_cbc25f4f_1:

    # mcp "(Necesitaríamos que [dap] estuviera aquí para que nos tradujese la jerga científica.)"
    mcp "(Precisaríamos de [dap] aqui para traduzir o jargão científico para nós.)"

# game/scripts/c15/c15.rpy:3267
translate brazilian c15s006_Story_9cd3f61e:

    # mc "Pero habéis nombrado a seis chicas, y solo acaba por haber tres clones... o dos si contamos a [eri] y [dap] como uno."
    mc "Mas você deu nome a seis meninas, e acabam havendo apenas três clones... ou dois se contarmos [eri] e [dap] como uma só."

# game/scripts/c15/c15.rpy:3269
translate brazilian c15s006_Story_9834d149:

    # ama "Los clones de Beatrice, Claire, Diana, y Fiona no fueron viables. Dos no llegaron a nacer y otros dos murieron a los pocos días."
    ama "Os clones de Beatrice, Claire, Diana e Fiona não eram viáveis. Dois não eclodiram e outros dois morreram em poucos dias."

# game/scripts/c15/c15.rpy:3270
translate brazilian c15s006_Story_9f6b6fd0:

    # mom "Eso es muy triste..."
    mom "Isso é muito triste..."

# game/scripts/c15/c15.rpy:3272
translate brazilian c15s006_Story_3d41feca:

    # nor "¡Qué hijos de puta! ¿Cómo pudo Mike experimentar así con niñas pequeñas?"
    nor "Que filhos da puta! Como é que o Mike pôde fazer experiências desse tipo com meninas pequenas?"

# game/scripts/c15/c15.rpy:3274
translate brazilian c15s006_Story_77996f81:

    # mom "No te lo tomes mal, cielo... esto es nuevo para nosotras... me alegra que estés aquí ahora."
    mom "Não me leve a mal, querida... isso é novo para nós... fico feliz que você esteja aqui agora."

# game/scripts/c15/c15.rpy:3275
translate brazilian c15s006_Story_ccc0dba7_1:

    # ama "Gracias, [mar]..."
    ama "Obrigado, [mar]..."

# game/scripts/c15/c15.rpy:3277
translate brazilian c15s006_Story_3e69544b_1:

    # nor "Sí, vosotras no tenéis la culpa... pero si Mike no estuviera muerto... lo volvería a matar yo ahora mismo."
    nor "Sim, não é sua culpa... mas se o Mike não estivesse morto... eu o mataria de novo agora mesmo."

# game/scripts/c15/c15.rpy:3278
translate brazilian c15s006_Story_35c1ea13_1:

    # eva "Me gusta como piensas. Yo seguramente haría lo mismo."
    eva "Gosto da sua maneira de pensar. Provavelmente faria o mesmo."

# game/scripts/c15/c15.rpy:3280
translate brazilian c15s006_Story_e6e4453b:

    # aar "Y ahí es cuando empezó a torcerse la cosa. Si puedes crear clones que envejezcan a la vez que sus donantes y usarlos como repositorio de órganos de cara al futuro..."
    aar "E foi aí que as coisas começaram a dar errado. Se você puder criar clones que envelhecem na mesma velocidade que seus doadores e usá-los como um futuro banco de órgãos..."

# game/scripts/c15/c15.rpy:3281
translate brazilian c15s006_Story_7e521a9a_1:

    # mc "Los billonarios se volverían locos por tener eso para sus hijos."
    mc "Bilionários ficariam loucos para ter isso para seus filhos."

# game/scripts/c15/c15.rpy:3282
translate brazilian c15s006_Story_4cbe5d92:

    # aar "Exacto. Cuando vuestras chicas nacieron, se comprobó que el envejecimiento no continuaba una vez fuera del tanque."
    aar "Exatamente. Quando suas filhas nasceram, ficou comprovado que o envelhecimento não continuava depois que elas saíam do tanque."

# game/scripts/c15/c15.rpy:3283
translate brazilian c15s006_Story_11e815f4:

    # aar "Dominic hizo contactos con un tipo muy rico. Había mucho dinero en juego."
    aar "Dominic entrou em contato com um cara muito rico. Havia muito dinheiro em jogo."

# game/scripts/c15/c15.rpy:3285
translate brazilian c15s006_Story_b740950d:

    # aar "Y entoces, llegó el accidente de avión. Se sospechó de un sabotaje, pero no se pudo probar nada."
    aar "E então, ocorreu o acidente de avião. Suspeitou-se de sabotagem, mas nada pôde ser comprovado."

# game/scripts/c15/c15.rpy:3286
translate brazilian c15s006_Story_19fe89de:

    # aar "Después de la reestructuración de NTR y GILF, se intentó llevar a cabo la primera clonación del hijo de un millonario."
    aar "Após a reestruturação da NTR e da GILF, foi feita a primeira tentativa de clonar o filho de um milionário."

# game/scripts/c15/c15.rpy:3288
translate brazilian c15s006_Story_f1b6d097:

    # aar "No funcionó. Creemos que una parte fundamental del trabajo en parar el envejecimiento estaba en alguno de los portátiles que se destruyeron en el accidente."
    aar "Não funcionou. Acreditamos que uma parte crucial do trabalho para interromper o processo de envelhecimento estava em um dos laptops que foram destruídos no acidente."

# game/scripts/c15/c15.rpy:3289
translate brazilian c15s006_Story_cec9ae65:

    # aar "Faltaban datos en los servidores de NTR. Se redujo el ratio de envejecimiento. Primero a 2.8, 2.5, 2... pero nunca han conseguido que sea inferior a 1.7."
    aar "Havia dados faltantes nos servidores da NTR. A taxa de envelhecimento foi reduzida. Primeiro para 2,8, 2,5, 2... mas nunca conseguiram reduzi-la para menos de 1,7."

# game/scripts/c15/c15.rpy:3290
translate brazilian c15s006_Story_fd8b467e:

    # mc "¿Qué pasó con esos clones fallidos?"
    mc "O que aconteceu com aqueles clones que não deram certo?"

# game/scripts/c15/c15.rpy:3292
translate brazilian c15s006_Story_9f9374c8:

    # aar "Si no puedes utilizarlos como repositorio de órganos para sus donantes millonarios, ¿qué puedes hacer con unos clones que a los 6 años tienen el cuerpo de alguien de 18?"
    aar "Se não for possível usá-los como um repositório de órgãos para seus doadores milionários, o que se pode fazer com clones que, aos 6 anos de idade, têm o corpo de um jovem de 18 anos?"

# game/scripts/c15/c15.rpy:3293
translate brazilian c15s006_Story_e7141d72:

    # aar "Con la capacidad de aprendizaje de un niño pequeño, pero con la fuerza y la agilidad de un adulto."
    aar "Com a capacidade de aprendizado de uma criança pequena, mas com a força e agilidade de um adulto."

# game/scripts/c15/c15.rpy:3294
translate brazilian c15s006_Story_0ca5cad8:

    # mc "Un ejército de clones."
    mc "Um exército de clones."

# game/scripts/c15/c15.rpy:3296
translate brazilian c15s006_Story_8df4e326:

    # aar "Exacto. Los entrenas para realizar operaciones encubiertas y los alquilas al mejor postor."
    aar "Exatamente. Você os treina para realizar operações secretas e depois os aluga para o maior lance."

# game/scripts/c15/c15.rpy:3297
translate brazilian c15s006_Story_63b919cf:

    # mc "No es justo. Seguían... seguíais siendo niños..."
    mc "Não é justo. Vocês ainda eram... vocês ainda eram crianças..."

# game/scripts/c15/c15.rpy:3299
translate brazilian c15s006_Story_77c9af73:

    # ama "Si y no. Eric solo tiene 15 años aunque su cuerpo ronde los 30. Pero ya has visto como puede ser..."
    ama "Sim e não. Eric tem apenas 15 anos, embora seu corpo pareça ser de alguém na casa dos 30. Mas você já viu como pode ser..."

# game/scripts/c15/c15.rpy:3300
translate brazilian c15s006_Story_9ff9cb54:

    # mc "Lo había leído, pero las edades reales y aparentes no encajaban."
    mc "Eu tinha lido, mas as idades reais e aparentes não coincidiam."

# game/scripts/c15/c15.rpy:3302
translate brazilian c15s006_Story_2d96ce22:

    # eva "Y no le hubiera importado mataros si hubiera sido necesario, si no hubierais querido firmar... al menos a uno de vosotros, para forzar a los demás."
    eva "E ele não teria hesitado em te matar, se necessário, caso você não quisesse assinar... pelo menos um de vocês, para forçar os outros."

# game/scripts/c15/c15.rpy:3303
translate brazilian c15s006_Story_96945c8f:

    # mc "¿Iba en serio lo de matarnos?"
    mc "Eles estavam mesmo querendo nos matar?"

# game/scripts/c15/c15.rpy:3305
translate brazilian c15s006_Story_7e100c10:

    # aar "Ya llegaremos al tema de los asesinatos más tarde..."
    aar "Abordaremos o tema dos assassinatos mais tarde..."

# game/scripts/c15/c15.rpy:3306
translate brazilian c15s006_Story_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c15/c15.rpy:3307
translate brazilian c15s006_Story_9cf5b234:

    # aar "Mas tarde, [mc]."
    aar "Mais tarde, [mc]."

# game/scripts/c15/c15.rpy:3309
translate brazilian c15s006_Story_82aff823:

    # aar "En definitiva, en pocos años NTR y GILF tuvieron un pequeño ejército de clones entrenados. Cuando los A teníamos 8 años empezamos a hacer misiones."
    aar "Resumindo, em poucos anos, a NTR e a GILF já tinham um pequeno exército de clones treinados. Quando tínhamos 8 anos, começamos a fazer missões."

# game/scripts/c15/c15.rpy:3310
translate brazilian c15s006_Story_ad275ac8:

    # aar "Después se unieron los C, los D... Había gobiernos, como el vuestro, que pagaban muy bien por un equipo de mercenarios que no se pudiera relacionar con ellos."
    aar "Então, os C's e os D's se juntaram... Existiram governos, como o seu, que pagavam muito bem por uma equipe de mercenários que não podiam ser associados a eles."

# game/scripts/c15/c15.rpy:3311
translate brazilian c15s006_Story_e24de9ea:

    # aar "Las chicas empezaron con sus misiones hace cuatro años, cuando cumplieron 14. Menos Fiona, que había muerto en un accidente durante el entrenamiento."
    aar "As meninas começaram suas missões há quatro anos, quando completaram 14 anos. Com exceção de Fiona, que morreu em um acidente durante o treinamento."

# game/scripts/c15/c15.rpy:3313
translate brazilian c15s006_Story_3a26c691:

    # mom "Lo siento mucho, Amanda... supongo que... debía ser como una hermana para vosotras."
    mom "Sinto muito, Amanda... Acho que... eu deveria ter sido como uma irmã para você."

# game/scripts/c15/c15.rpy:3314
translate brazilian c15s006_Story_cf031570:

    # ama "No como una hermana... era una hermana de verdad..."
    ama "Não como uma irmã... ela era uma irmã de verdade..."

# game/scripts/c15/c15.rpy:3316
translate brazilian c15s006_Story_c39c3603:

    # nor "Debió de ser duro para vosotras."
    nor "Deve ter sido difícil para você."

# game/scripts/c15/c15.rpy:3317
translate brazilian c15s006_Story_21d2693c:

    # eva "Fue la primera en morir. Es un golpe duro cuando ves morir a tu hermana a los 12 años en una explosión."
    eva "Ela foi a primeira a morrer. É um golpe devastador ver sua irmã de 12 anos morrer em uma explosão."

# game/scripts/c15/c15.rpy:3318
translate brazilian c15s006_Story_4e64105c:

    # mc "¿12 años? ¡Joder! ¿Cuándo empezasteis a entrenar?"
    mc "12 anos? Caramba! Quando vocês começaram a treinar?"

# game/scripts/c15/c15.rpy:3320
translate brazilian c15s006_Story_3ce96331:

    # aar "Las chicas empezaron a entrenar a los 6 años. Tenían el cuerpo de una niña de 6 años, pero cuando todo lo que haces es entrenar... te conviertes en bueno. Y ellas son muy buenas."
    aar "As meninas começaram a treinar aos 6 anos. Elas tinham corpos de crianças de 6 anos, mas quando você só treina... você fica boa. E elas são muito boas."

# game/scripts/c15/c15.rpy:3321
translate brazilian c15s006_Story_e84add3c:

    # mcp "(No puedo evitar imaginarme a [emm] o [dap] con una metralleta con 6 años. Es una imagen ridícula. No puedo imaginar por lo que han pasado Eva y Amanda.)"
    mcp "(Não consigo deixar de imaginar [emm] ou [dap] com uma metralhadora aos 6 anos de idade. É uma imagem ridícula. Não consigo imaginar o que Eva e Amanda passaram.)"

# game/scripts/c15/c15.rpy:3323
translate brazilian c15s006_Story_04cda04d:

    # aar "Con un suministro cada vez mayor de agentes, NTR creció mucho."
    aar "Com um número cada vez maior de agentes, a NTR cresceu bastante."

# game/scripts/c15/c15.rpy:3324
translate brazilian c15s006_Story_da6d06a8:

    # aar "El director de GILF, Richard, sabía que eso podría funcionar por un tiempo limitado, conocía el testamento de los fundadores y sabía que heredaríais... heredaríamos la empresa."
    aar "O diretor da GILF, Richard, sabia que isso poderia funcionar apenas por um tempo limitado, ele conhecia a vontade dos fundadores e sabia que você herdaria... nós herdaríamos a empresa."

# game/scripts/c15/c15.rpy:3325
translate brazilian c15s006_Story_4c8cf79a:

    # mc "Y no podía saber qué haríamos con ella o si estaríamos de acuerdo con la forma de operarla."
    mc "E eu não tinha como saber o que faríamos com isso ou se concordaríamos com a forma como o operávamos."

# game/scripts/c15/c15.rpy:3327
translate brazilian c15s006_Story_6d1ab377:

    # aar "Exacto. Pero Richard había sido amigo y compañero de los Fundadores desde el principio y estaba dispuesto a cumplir su última voluntad."
    aar "Exatamente. Mas Richard era amigo e colega dos Fundadores desde o início e estava disposto a realizar o último desejo deles."

# game/scripts/c15/c15.rpy:3328
translate brazilian c15s006_Story_429f5091:

    # aar "Pero Richard murió hace unos meses. Causas naturales. Su segundo, Xabier, tomó el mando y descubrió el testamento."
    aar "Mas Richard morreu há alguns meses. Causas naturais. Seu braço direito, Xabier, assumiu o cargo e descobriu o testamento."

# game/scripts/c15/c15.rpy:3329
translate brazilian c15s006_Story_efe17ca5:

    # mc "Y él no estaba dispuesto a cumplir con las condiciones."
    mc "E ele não estava disposto a cumprir as condições."

# game/scripts/c15/c15.rpy:3331
translate brazilian c15s006_Story_8e805ceb:

    # aar "Exacto. Si moríais antes de que la última cláusula del testamento entrara en vigor, la propiedad de NTR pasaba definitivamente a GILF."
    aar "Isso mesmo. Se você falecesse antes da última cláusula do testamento entrar em vigor, a propriedade da NTR passaria permanentemente para a GILF."

# game/scripts/c15/c15.rpy:3332
translate brazilian c15s006_Story_b7be54a4:

    # aar "Se ordenó a la serie XX asesinaros. A todos."
    aar "A série XX recebeu ordens para assassinar vocês. Todos vocês."

# game/scripts/c15/c15.rpy:3333
translate brazilian c15s006_Story_55a2b5a8:

    # mc "{b}¿Qué?{/b} ¡Nos han estado defendiendo!"
    mc "{b}O quê?{/b} Eles estavam nos defendendo!"

# game/scripts/c15/c15.rpy:3335
translate brazilian c15s006_Story_91acd48b:

    # mom "¿Nos iban a matar por una empresa?" (multiple=2)
    mom "Será que eles iam nos matar por causa de uma empresa?" (multiple=2)

# game/scripts/c15/c15.rpy:3336
translate brazilian c15s006_Story_b1c8da99:

    # nor "¿Tan importante es?" (multiple=2)
    nor "Será mesmo tão importante assim?" (multiple=2)

# game/scripts/c15/c15.rpy:3338
translate brazilian c15s006_Story_e9cea5ee:

    # eva "No seáis inocentes. La mayoría de los asesinatos tienen que ver con dinero o con poder. Y NTR vale MUCHO dinero, y los propietarios de NTR pueden tener MUCHO poder."
    eva "Não seja ingênuo. A maioria dos assassinatos envolve dinheiro ou poder. E o NTR vale MUITO dinheiro, e os donos de NTR podem ter MUITO poder."

# game/scripts/c15/c15.rpy:3339
translate brazilian c15s006_Story_ee93f2ac:

    # eva "La orden de asesinato tenía una parte oculta. La que nos llegó a nosotras decía que cuando acabáramos con vosotros teníamos que matar también a los A."
    eva "A ordem de assassinato tinha uma parte oculta. A que recebemos dizia que, quando terminássemos com você, também tínhamos que matar os A's."

# game/scripts/c15/c15.rpy:3341
translate brazilian c15s006_Story_9fb6de33:

    # ama "Erais unos civiles, con lo que no se dedicaron muchos recursos. Cinco agentes a la caza de seis civiles. Una misión fácil."
    ama "Vocês eram civis, então não havia muitos recursos disponíveis para isso. Cinco agentes caçando seis civis. Uma missão fácil."

# game/scripts/c15/c15.rpy:3343
translate brazilian c15s006_Story_45cf3476:

    # aar "Cuando las chicas recibieron las órdenes, vinieron a vernos a Arnau y a mí a explicarnos las órdenes que habían recibido respecto a nosotros."
    aar "Quando as garotas receberam as ordens, vieram falar comigo e com Arnau para explicar o que haviam recebido a nosso respeito."

# game/scripts/c15/c15.rpy:3344
translate brazilian c15s006_Story_0ef75901:

    # aar "Debía tratarse de un error. Arnau fue a hablar con Xabier para aclararlo y nunca volvió. Nosotros nos fuimos de la base. Pudimos huir por los pelos."
    aar "Deve ter sido um engano. Arnau foi falar com Xabier para esclarecer as coisas e nunca mais voltou. Saímos da base. Por pouco não fomos pegos."

# game/scripts/c15/c15.rpy:3345
translate brazilian c15s006_Story_305abcf0:

    # mc "Y fue cuando decidisteis protegernos, ¿no?"
    mc "E foi aí que você decidiu nos proteger, não é?"

# game/scripts/c15/c15.rpy:3347
translate brazilian c15s006_Story_7a277806:

    # eva "Ya sabes... el enemigo de mi enemigo... Si os querían muertos sería por algo y nosotros aún no sabíamos por qué."
    eva "Sabe... o inimigo do meu inimigo... Se eles queriam você morto, devia haver algum motivo, e nós ainda não sabíamos qual era."

# game/scripts/c15/c15.rpy:3349
translate brazilian c15s006_Story_cb647f23:

    # ama "Aaron y Claire investigaron y descubrieron la cláusula del testamento mientras Eva y yo protegíamos a la familia en Newport, y Beatrice y Diana te protegían a ti en Portland."
    ama "Aaron e Claire investigaram e descobriram a cláusula no testamento, enquanto Eva e eu protegíamos a família em Newport, e Beatrice e Diana protegiam você em Portland."

# game/scripts/c15/c15.rpy:3350
translate brazilian c15s006_Story_1a127223:

    # ama "Como es normal en estos casos, la información fluía entre nosotros, con lo que, cuando llegaste a Newport, sabíamos mucho de ti."
    ama "Como é normal nesses casos, houve troca de informações entre nós, de modo que, quando você chegou a Newport, já sabíamos bastante sobre você."

# game/scripts/c15/c15.rpy:3352
translate brazilian c15s006_Story_6e917ecd:

    # aar "Decidimos que, si queríamos sobrevivir, erais nuestra mejor opción. Además, lo que hacía Xabier iba en contra de la voluntad de los Fundadores."
    aar "Decidimos que, se quiséssemos sobreviver, você era nossa melhor opção. Além disso, o que Xabier estava fazendo ia contra os desejos dos Fundadores."

# game/scripts/c15/c15.rpy:3353
translate brazilian c15s006_Story_fd9977e5:

    # aar "Pero la mayoría de los agentes, menos los G, son buenos. Nos acabaron encontrando."
    aar "Mas a maioria dos agentes, com exceção dos Gs, são bons. Eles acabaram nos encontrando."

# game/scripts/c15/c15.rpy:3354
translate brazilian c15s006_Story_4df10028:

    # aar "Primero murió Claire, después Beatrice y Diana. Ahora solo quedamos nosotros tres."
    aar "Primeiro Claire morreu, depois Beatrice e Diana. Agora só restam nós três."

# game/scripts/c15/c15.rpy:3355
translate brazilian c15s006_Story_0801f748:

    # mc "¿Y qué va a pasar ahora? ¿Van a seguir intentando asesinarnos?"
    mc "E o que vai acontecer agora? Vão continuar tentando nos matar?"

# game/scripts/c15/c15.rpy:3357
translate brazilian c15s006_Story_a13e8619:

    # ama "No. Una vez entró en vigor la cláusula, mataros no tiene sentido. Por eso Eric quería que firmarais el traspaso de acciones."
    ama "Não. Uma vez que a cláusula entrasse em vigor, matar você seria inútil. É por isso que Eric queria que você assinasse o contrato de transferência de ações."

# game/scripts/c15/c15.rpy:3358
translate brazilian c15s006_Story_8f638558:

    # ama "Tampoco tiene sentido que nos den caza a nosotros. Ya tenemos el control de NTR y Aaron ha cancelado las órdenes."
    ama "Não faz sentido eles nos caçarem. Já temos o controle da NTR, e Aaron cancelou as ordens."

# game/scripts/c15/c15.rpy:3360
translate brazilian c15s006_Story_ee3f23fd:

    # eva "Hemos tenido que falsificar alguna de vuestras firmas... *Risita*"
    eva "Tivemos que falsificar algumas de suas assinaturas... *Risos*"

# game/scripts/c15/c15.rpy:3362
translate brazilian c15s006_Story_0bbb8565:

    # aar "Xabier ha sido apartado de su puesto y ahora está todo bajo control... más o menos."
    aar "Xabier foi afastado do cargo e agora tudo está sob controle... mais ou menos."

# game/scripts/c15/c15.rpy:3363
translate brazilian c15s006_Story_9c1a047c:

    # mc "¿Más o menos?"
    mc "Mais ou menos?"

# game/scripts/c15/c15.rpy:3364
translate brazilian c15s006_Story_ec76c9ea:

    # aar "Hay todavía algún agente con el que no hemos logrado contactar para anular sus órdenes, pero estará resuelto en los próximos días."
    aar "Ainda não conseguimos entrar em contato com alguns agentes para cancelar seus pedidos, mas isso será resolvido nos próximos dias."

# game/scripts/c15/c15.rpy:3404
translate brazilian c15s007_KiaraHouse_35660b71:

    # "Por fin llega la hora de ir a casa de Eileen y Kiara a buscar sus cosas. Esperas que Solomon no esté allí."
    "Finalmente, chegou a hora de ir à casa de Eileen e Kiara para pegar as coisas delas. Você espera que Solomon não esteja lá."

# game/scripts/c15/c15.rpy:3405
translate brazilian c15s007_KiaraHouse_d9eadcbf:

    # "Llamas a Alexia y quedáis en la puerta. Está a punto de terminar su turno y os acompañará antes de volver a la comisaría."
    "Você liga para Alexia e combina de se encontrar na porta. Ela está quase terminando o turno e irá acompanhá-lo antes de retornar à delegacia."

# game/scripts/c15/c15.rpy:3408
translate brazilian c15s007_KiaraHouse_8de98c3a:

    # "Antes de salir le das a Eileen una de las pruebas de embarazo de Aaron, ponéis la gota de sangre y la guarda en su habitación."
    "Antes de sair, você entrega a Eileen um dos testes de gravidez de Aaron, coloca a gota de sangue nele e ela o guarda em seu quarto."

# game/scripts/c15/c15.rpy:3409
translate brazilian c15s007_KiaraHouse_742d918d:

    # "Explicarle de dónde ha salido ha sido difícil. Contarle la verdad sobre [eri], [emm] y [dap] ha sido una odisea."
    "Explicar de onde veio tem sido difícil. Contar-lhe a verdade sobre [eri], [emm] e [dap] tem sido uma provação."

# game/scripts/c15/c15.rpy:3411
translate brazilian c15s007_KiaraHouse_0c5702e1:

    # "Coges otra prueba para Alexia."
    "Você pega outro teste para Alexia."

# game/scripts/c15/c15.rpy:3413
translate brazilian c15s007_KiaraHouse_55b681dd:

    # "Antes de salir coges una de las pruebas de embarazo de Aaron para dársela a Alexia. Tendrás que explicarle de dónde ha salido."
    "Antes de sair, você pega um dos testes de gravidez de Aaron para dar a Alexia. Você terá que explicar de onde ele veio."

# game/scripts/c15/c15.rpy:3415
translate brazilian c15s007_KiaraHouse_48823e75:

    # "Aprovechas el viaje para explicarle también a Kiara la situación de [eri], [emm], [dap], Amanda y Eva."
    "Você aproveita a viagem para também explicar a Kiara a situação de [eri], [emm], [dap], Amanda e Eva."

# game/scripts/c15/c15.rpy:3417
translate brazilian c15s007_KiaraHouse_0af164cc:

    # "Aprovechas el viaje para explicarles a Eileen y a Kiara la situación de [eri], [emm], [dap], Amanda y Eva."
    "Você aproveita a viagem para explicar a Eileen e Kiara a situação de [eri], [emm], [dap], Amanda e Eva."

# game/scripts/c15/c15.rpy:3418
translate brazilian c15s007_KiaraHouse_e9358946:

    # "Lo vas a llamar La Conversación de los Clones. O simplemente \"La Conversación\". La vas a tener mucho en los próximos días."
    "Você vai chamar isso de \"A Conversa sobre Clones\". Ou simplesmente \"A Conversa\". Você vai ouvir falar muito disso nos próximos dias."

# game/scripts/c15/c15.rpy:3419
translate brazilian c15s007_KiaraHouse_193cf1fe:

    # "Flipan. Hablan entre ellas. Prometen guardar el secreto. Caen en un silencio pensativo hasta estar cerca de su casa."
    "Eles ficam maravilhados. Conversam entre si. Prometem guardar segredo. Mergulham num silêncio pensativo até estarem perto de casa."

# game/scripts/c15/c15.rpy:3422
translate brazilian c15s007_KiaraHouse_505890c5:

    # mc "¿Nerviosas?"
    mc "Nervoso?"

# game/scripts/c15/c15.rpy:3423
translate brazilian c15s007_KiaraHouse_299e1217:

    # eil "No deberíamos estarlo. Tan solo volvemos a casa a por unas cosas, pero..."
    eil "Não deveríamos. Só estamos voltando para casa para pegar algumas coisas, mas..."

# game/scripts/c15/c15.rpy:3425
translate brazilian c15s007_KiaraHouse_af3c5ba5:

    # kia "Pero parece que volvamos como unas ladronas... es una sensación rara..."
    kia "Mas parece que estamos voltando como ladrões... é uma sensação estranha..."

# game/scripts/c15/c15.rpy:3426
translate brazilian c15s007_KiaraHouse_e2538f64:

    # kia "He llamado a mi vecina y me ha dicho que Solomon no está en casa, con lo que no debería haber problemas."
    kia "Liguei para minha vizinha e ela disse que Solomon não estava em casa, então não deveria haver nenhum problema."

# game/scripts/c15/c15.rpy:3427
translate brazilian c15s007_KiaraHouse_cdc1add0:

    # mc "Bueno, cojamos las cosas antes de que vuelva y no tendremos ningún problema. Alexia ya debe estar allí."
    mc "Certo, vamos arrumar nossas coisas antes que ela volte e não teremos problemas. Alexia já deve estar lá."

# game/scripts/c15/c15.rpy:3430
translate brazilian c15s007_KiaraHouse_e9cda0cf:

    # mc "Gracias por venir, Alexia."
    mc "Obrigada por ter vindo, Alexia."

# game/scripts/c15/c15.rpy:3432
translate brazilian c15s007_KiaraHouse_3d306583:

    # oma "Es lo menos que podía hacer, ¿no? Para eso estamos las amigas"
    oma "É o mínimo que eu posso fazer, né? É para isso que servem os amigos."

# game/scripts/c15/c15.rpy:3433
translate brazilian c15s007_KiaraHouse_b618bf92:

    # mc "Tengo que hablar contigo un momento."
    mc "Preciso falar com você um instante."

# game/scripts/c15/c15.rpy:3435
translate brazilian c15s007_KiaraHouse_df29e7bd:

    # kia "Os dejamos que habléis mientras vamos trayendo cosas. Supongo que vas a tener \"La Conversación\"."
    kia "Vamos deixar vocês dois conversando enquanto trazemos as coisas. Imagino que vocês vão ter \"A Conversa\"."

# game/scripts/c15/c15.rpy:3436
translate brazilian c15s007_KiaraHouse_8013bb0b:

    # mc "Sí, es algo que quiero que sepa toda la familia lo antes posible."
    mc "Sim, é algo que quero que toda a família saiba o mais rápido possível."

# game/scripts/c15/c15.rpy:3438
translate brazilian c15s007_KiaraHouse_3f1adecd:

    # oma "¿Que es eso de La Conversación? Casi se podían escuchar las mayúsculas."
    oma "O que é isso sobre \"A Conversa\"? Quase dava para ouvir as letras maiúsculas."

# game/scripts/c15/c15.rpy:3439
translate brazilian c15s007_KiaraHouse_e13243d4:

    # mc "Te acuerdas de que te llamé el lunes mientras llevabas a tu abuelo a San Diego, ¿verdad?"
    mc "Você se lembra que eu te liguei na segunda-feira enquanto você estava levando seu avô para San Diego, certo?"

# game/scripts/c15/c15.rpy:3441
translate brazilian c15s007_KiaraHouse_45c4f46b:

    # "Le explicas el secuestro, por qué la llamaste ese día mientras conducía a San Diego, y todo lo que ha pasado desde entonces."
    "Você explica o sequestro, por que ligou para ela naquele dia enquanto dirigia para San Diego e tudo o que aconteceu desde então."

# game/scripts/c15/c15.rpy:3442
translate brazilian c15s007_KiaraHouse_1a5d58e4:

    # "También todo lo que va a pasar a partir de ahora y el secreto familiar."
    "Além disso, tudo o que acontecerá daqui para frente e o segredo de família."

# game/scripts/c15/c15.rpy:3444
translate brazilian c15s007_KiaraHouse_0e6979b3:

    # oma "Es alucinante... parece sacado de una novela mala de ciencia ficción y espionaje escrita por un escritor tarado..."
    oma "É de deixar qualquer um boquiaberto... parece algo saído de um romance de ficção científica ruim escrito por um autor desequilibrado..."

# game/scripts/c15/c15.rpy:3445
translate brazilian c15s007_KiaraHouse_968dde08:

    # mc "Yo he pensado lo mismo cuando nos han dicho que sobre el accidente hubo sospechas de sabotaje."
    mc "Pensei a mesma coisa quando nos disseram que havia suspeitas de sabotagem em relação ao acidente."

# game/scripts/c15/c15.rpy:3447
translate brazilian c15s007_KiaraHouse_4fb1e461:

    # oma "Gracias por confiar en mí, [mc]... supongo que también tendré que agradecérselo a [mar] y [nor]."
    oma "Obrigado por confiar em mim, [mc]... Acho que também terei que agradecer a [mar] e [nor]."

# game/scripts/c15/c15.rpy:3449
translate brazilian c15s007_KiaraHouse_cda2c728:

    # mc "¿Cómo querías que no confiara en mi novia? Te confiaría mi vida."
    mc "Como você pode esperar que eu não confie na minha namorada? Eu confiaria minha vida a você."

# game/scripts/c15/c15.rpy:3451
translate brazilian c15s007_KiaraHouse_f99c9cfc:

    # mc "¿Cómo querías que no confiara en ti? Te confiaría mi vida."
    mc "Como você poderia esperar que eu não confiasse em você? Eu confiaria minha vida a você."

# game/scripts/c15/c15.rpy:3452
translate brazilian c15s007_KiaraHouse_5a1ff281:

    # oma "Pero... no sé... después de lo de ayer... ahora esto... ¿me podéis adoptar?"
    oma "Mas... não sei... depois do que aconteceu ontem... e agora isso... você pode me adotar?"

# game/scripts/c15/c15.rpy:3453
translate brazilian c15s007_KiaraHouse_9ae2b2cf:

    # mc "Yo creía que ya lo habíamos hecho. *Risa*"
    mc "Pensei que já tivéssemos feito isso. *Risos*"

# game/scripts/c15/c15.rpy:3456
translate brazilian c15s007_KiaraHouse_2e616ea7:

    # oma "Genial, pero... ¿cuánto vas a tardar en darme el test? Me muero de ganas por saberlo."
    oma "Ótimo, mas... quanto tempo você vai levar para me aplicar o teste? Estou morrendo de curiosidade."

# game/scripts/c15/c15.rpy:3457
translate brazilian c15s007_KiaraHouse_a5ae2e37:

    # mc "Alexia, el test tarda 24 horas en dar el resultado. ¿No querrías hacerlo en casa, más tranquila?"
    mc "Alexia, o teste demora 24 horas para ficar pronto. Você não preferiria fazê-lo em casa, onde pode relaxar?"

# game/scripts/c15/c15.rpy:3459
translate brazilian c15s007_KiaraHouse_80c99b29:

    # oma "Soy la primera latina en tu vida, ¿verdad?"
    oma "Sou a primeira latina na sua vida, certo?"

# game/scripts/c15/c15.rpy:3460
translate brazilian c15s007_KiaraHouse_22367688:

    # oma "¡Lo quiero ahora! *Risa* No me hagas cometer un delito y robártelo."
    oma "Eu quero agora! *Risos* Não me faça cometer um crime e roubar isso de você."

# game/scripts/c15/c15.rpy:3461
translate brazilian c15s007_KiaraHouse_caf77453:

    # mc "Vale, vale. Ahora te lo doy."
    mc "Ok, ok. Vou te dar agora."

# game/scripts/c15/c15.rpy:3463
translate brazilian c15s007_KiaraHouse_438aa405:

    # "Coges el test de la guantera y lo abres. Buscas un sitio donde hacerlo y no encuentras ninguno mejor que el asiento del copiloto."
    "Você pega o teste no porta-luvas e o abre. Procura um lugar para fazê-lo e não encontra lugar melhor do que o banco do passageiro."

# game/scripts/c15/c15.rpy:3464
translate brazilian c15s007_KiaraHouse_5ddf1c56:

    # "Sacáis una gota de sangre del dedo de Alexia, la ponéis en la tira de plástico, y la introducís en la máquina. Se enciende una luz roja."
    "Você retira uma gota de sangue do dedo de Alexia, coloca-a na tira de plástico e a insere na máquina. Uma luz vermelha acende."

# game/scripts/c15/c15.rpy:3466
translate brazilian c15s007_KiaraHouse_f0fdd940:

    # oma "¿Qué es esa luz roja? ¿Significa que no estoy embarazada? ¿O que lo estoy?"
    oma "O que significa aquela luz vermelha? Será que significa que eu não estou grávida? Ou que estou?"

# game/scripts/c15/c15.rpy:3467
translate brazilian c15s007_KiaraHouse_912d48a3:

    # mc "Significa que ha reconocido la tira de plástico y que hay sangre dentro. Se pondrá verde cuando tenga el resultado mañana a esta hora."
    mc "Significa que reconheceu a tira de plástico e que há sangue dentro. Vai ficar verde quando eu receber o resultado amanhã a esta hora."

# game/scripts/c15/c15.rpy:3468
translate brazilian c15s007_KiaraHouse_e3b61f66:

    # mc "La otra luz se pondrá verde si el resultado es positivo y roja si es negativo."
    mc "A outra luz ficará verde se o resultado for positivo e vermelha se for negativo."

# game/scripts/c15/c15.rpy:3470
translate brazilian c15s007_KiaraHouse_68ac5c07:

    # oma "¿Y si se queda sin batería?"
    oma "E se a bateria acabar?"

# game/scripts/c15/c15.rpy:3471
translate brazilian c15s007_KiaraHouse_d6fd4739:

    # mc "Alexia, es una empresa de tecnología punta que hace clones. Creo que habrán pensado en ponerle la batería suficiente para que pueda funcionar durante 24 horas."
    mc "A Alexia é uma empresa de tecnologia de ponta que fabrica clones. Acho que eles devem ter pensado em equipá-la com uma bateria potente o suficiente para durar 24 horas."

# game/scripts/c15/c15.rpy:3472
translate brazilian c15s007_KiaraHouse_ceb1c2d3:

    # oma "Tienes razón... es que estoy muy nerviosa... es la primera vez que quiero estar embarazada en mi vida..."
    oma "Você tem razão... Estou tão nervosa... É a primeira vez que quero engravidar..."

# game/scripts/c15/c15.rpy:3473
translate brazilian c15s007_KiaraHouse_bf1793d4:

    # mc "Mañana sabremos si lo estás. ¿Te lo quieres llevar?"
    mc "Saberemos amanhã se você é. Você quer aceitar?"

# game/scripts/c15/c15.rpy:3475
translate brazilian c15s007_KiaraHouse_3009562d:

    # oma "No, mejor llévatelo tú. Imagínate que me lo dejo en el coche patrulla y lo coge otro compañero sin saber qué es."
    oma "Não, você deveria ficar com isso. Imagine se eu deixasse no carro da polícia e outro policial pegasse sem saber o que era."

# game/scripts/c15/c15.rpy:3476
translate brazilian c15s007_KiaraHouse_f2e15f15:

    # mc "Vale, lo meteré en la guantera y al llegar a casa..."
    mc "Certo, vou colocar no porta-luvas e quando chegar em casa..."

# game/scripts/c15/c15.rpy:3478
translate brazilian c15s007_KiaraHouse_f3c00517:

    # eil "Aquí está la bici. Mi madre está llenando sus maletas. Ahora voy a llenar yo las mías."
    eil "Aqui está a bicicleta. Minha mãe está arrumando as malas dela. Agora eu vou arrumar as minhas."

# game/scripts/c15/c15.rpy:3479
translate brazilian c15s007_KiaraHouse_657d8c2b:

    # mc "¿Necesitáis ayuda?"
    mc "Você precisa de ajuda?"

# game/scripts/c15/c15.rpy:3481
translate brazilian c15s007_KiaraHouse_6cefec08:

    # eil "Gracias, pero no. No te quiero ver revolviendo entre mi ropa. *Risa*"
    eil "Obrigada, mas não. Não quero te ver revirando minhas roupas. *Risos*"

# game/scripts/c15/c15.rpy:3482
translate brazilian c15s007_KiaraHouse_891de431:

    # mc "Yo tenía pensado robarte el uniforme de animadora. *Risa*"
    mc "Eu estava planejando roubar seu uniforme de líder de torcida. *Risos*"

# game/scripts/c15/c15.rpy:3483
translate brazilian c15s007_KiaraHouse_784e493f:

    # eil "Voy a empezar a recoger la ropa. Os dejo con La Conversación."
    eil "Vou começar a guardar as roupas. Deixo vocês com a Conversa."

# game/scripts/c15/c15.rpy:3485
translate brazilian c15s007_KiaraHouse_cc7205ff:

    # oma "Ya la hemos tenido. Es totalmente increíble."
    oma "Nós já experimentamos. É absolutamente incrível."

# game/scripts/c15/c15.rpy:3487
translate brazilian c15s007_KiaraHouse_058208ae:

    # oma "Y ya hemos hecho el test también."
    oma "E nós já fizemos o teste também."

# game/scripts/c15/c15.rpy:3488
translate brazilian c15s007_KiaraHouse_e0828f32:

    # mc "Ahora solo falta esperar las 24 horas para saber el resultado."
    mc "Agora só temos que esperar 24 horas para saber o resultado."

# game/scripts/c15/c15.rpy:3491
translate brazilian c15s007_KiaraHouse_c381f290:

    # eil "El tuyo y el mío darán el resultado con una hora de diferencia..."
    eil "O seu e o meu darão o resultado com uma hora de diferença..."

# game/scripts/c15/c15.rpy:3492
translate brazilian c15s007_KiaraHouse_081330e5:

    # eil "¿Quieres que los miremos juntas? Yo estaré en el trabajo cuando pasen las 24 horas del mío."
    eil "Você quer assistir juntos? Estarei no trabalho quando meu turno de 24 horas terminar."

# game/scripts/c15/c15.rpy:3494
translate brazilian c15s007_KiaraHouse_e60f6be0:

    # oma "Te paso a buscar mañana por el trabajo y vamos a casa de [mc]. Así los podremos mirar juntas, no te preocupes."
    oma "Amanhã te busco no trabalho e vamos à casa de [mc]. Assim podemos vê-los juntos, não se preocupe."

# game/scripts/c15/c15.rpy:3495
translate brazilian c15s007_KiaraHouse_3f262791:

    # oma "Ahora hay que convencer a éste de que no los mire sin nosotras allí."
    oma "Agora temos que convencê-lo a não assistir a esses programas sem a nossa presença."

# game/scripts/c15/c15.rpy:3496
translate brazilian c15s007_KiaraHouse_9de3276e:

    # mc "¡Hey! ¡Estoy aquí! Tranquilas, no lo voy a mirar sin vosotras delante."
    mc "Ei! Cheguei! Não se preocupem, não vou olhar sem vocês por perto."

# game/scripts/c15/c15.rpy:3497
translate brazilian c15s007_KiaraHouse_89338246:

    # mc "Eileen, hay unas maletas esperándote. ¿Podemos hablar luego del tema? No me gustaría que tu padre llegara y nos pillara aquí."
    mc "Eileen, há algumas malas esperando por você. Podemos conversar sobre isso mais tarde? Eu não gostaria que seu pai chegasse e nos pegasse aqui."

# game/scripts/c15/c15.rpy:3499
translate brazilian c15s007_KiaraHouse_ba97cdcc:

    # eil "Tranquilo, no volverá hasta medianoche, pero tienes razón, voy a llenar las maletas. Hasta ahora."
    eil "Não se preocupe, ele só volta à meia-noite, mas você tem razão, vou arrumar minhas malas. Até mais."

# game/scripts/c15/c15.rpy:3500
translate brazilian c15s007_KiaraHouse_4996e67f:

    # mc "Te esperamos aquí."
    mc "Estaremos esperando por você aqui."

# game/scripts/c15/c15.rpy:3502
translate brazilian c15s007_KiaraHouse_600034e3:

    # mc "La situación de Eileen y Kiara es muy jodida."
    mc "A situação de Eileen e Kiara está realmente complicada."

# game/scripts/c15/c15.rpy:3503
translate brazilian c15s007_KiaraHouse_20bbc1e1:

    # oma "Sí que lo es. Si Kiara no quiere denunciar, no podemos hacer nada si no lo pillamos in fraganti."
    oma "Sim, é verdade. Se a Kiara não quiser denunciar, não há nada que possamos fazer a menos que o peguemos em flagrante."

# game/scripts/c15/c15.rpy:3504
translate brazilian c15s007_KiaraHouse_43c63566:

    # mc "¿Ni siquiera con el testimonio de Eileen?"
    mc "Nem mesmo com o depoimento de Eileen?"

# game/scripts/c15/c15.rpy:3506
translate brazilian c15s007_KiaraHouse_ab10cb2a:

    # oma "Es complicado. Cuando se produjo la agresión, Eileen no estaba. Cuando llegó no hubo más violencia, y la violencia de hace años no nos sirve de nada ahora."
    oma "É complicado. Eileen não estava lá quando o ataque aconteceu. Quando ela chegou, a violência já havia cessado, e a violência de anos atrás não nos serve de nada agora."

# game/scripts/c15/c15.rpy:3507
translate brazilian c15s007_KiaraHouse_3c0d9d26:

    # mc "Por suerte ahora están a salvo en casa de [nor]."
    mc "Felizmente, eles agora estão seguros na casa de [nor]."

# game/scripts/c15/c15.rpy:3508
translate brazilian c15s007_KiaraHouse_b5ce8526:

    # oma "Sí, pero ¿qué pasará cuando vuelvan aquí la semana que viene?"
    oma "Sim, mas o que acontecerá quando eles voltarem aqui na próxima semana?"

# game/scripts/c15/c15.rpy:3509
translate brazilian c15s007_KiaraHouse_ae2d41ee:

    # mc "Si Solomon es inteligente, las tratará como reinas porque debe estar acojonado ahora mismo."
    mc "Se Salomão for esperto, ele as tratará como rainhas, porque ele deve estar apavorado neste momento."

# game/scripts/c15/c15.rpy:3511
translate brazilian c15s007_KiaraHouse_2d3b1c23:

    # oma "¡Venga ya! Si fuera inteligente no habría hecho lo que ha hecho. Además, ese tipo de personas difícilmente cambian."
    oma "Ora essa! Se ela fosse esperta, não teria feito o que fez. Além disso, esse tipo de gente raramente muda."

# game/scripts/c15/c15.rpy:3512
translate brazilian c15s007_KiaraHouse_81876fb1:

    # mc "Es lo que le dije a Kiara..."
    mc "Foi isso que eu disse para a Kiara..."

# game/scripts/c15/c15.rpy:3513
translate brazilian c15s007_KiaraHouse_164c2a16:

    # oma "El mayor problema es que no tienen donde ir... o no quieren tener donde ir. Yo les he ofrecido mi casa..."
    oma "O maior problema é que eles não têm para onde ir... ou não querem ir para lugar nenhum. Eu ofereci a eles a minha casa..."

# game/scripts/c15/c15.rpy:3514
translate brazilian c15s007_KiaraHouse_e90670f1:

    # mc "Y en mi casa se pueden quedar tanto tiempo como quieran, pero Kiara tiene prisa en volver a la suya."
    mc "Eles podem ficar na minha casa o tempo que quiserem, mas a Kiara está com pressa de voltar para a dela."

# game/scripts/c15/c15.rpy:3516
translate brazilian c15s007_KiaraHouse_a93e5aab:

    # oma "¿No la tendrías tú? En tu casa son invitadas, pero su casa es esta. No es un hogar, pero es su casa."
    oma "Você não teria uma? Eles são hóspedes na sua casa, mas este é o lar deles. Não é bem um lar, mas é a casa deles."

# game/scripts/c15/c15.rpy:3517
translate brazilian c15s007_KiaraHouse_ad6ac7ea:

    # mc "Lo entiendo, pero ¿y si la próxima vez Solomon no se contenta con hacerle unos hematomas?"
    mc "Eu entendo, mas e se da próxima vez Salomão não se contentar apenas em lhe causar alguns hematomas?"

# game/scripts/c15/c15.rpy:3518
translate brazilian c15s007_KiaraHouse_68527cba:

    # oma "Entonces tendrá que denunciar, o irse, o..."
    oma "Então ele terá que denunciar, ou ir embora, ou..."

# game/scripts/c15/c15.rpy:3520
translate brazilian c15s007_KiaraHouse_0d05effb:

    # "Radio" "Martínez, ¿estás operativa todavía? Todavía veo la chatarra de tu coche en el aparcamiento."
    "Radio" "Martinez, você ainda está trabalhando? Ainda vejo os destroços do seu carro no estacionamento."

# game/scripts/c15/c15.rpy:3522
translate brazilian c15s007_KiaraHouse_55f41ab6:

    # oma "Sí, Schrute. He acabado mi turno, pero estoy haciendo un último servicio. Dime."
    oma "Sim, Schrute. Terminei meu turno, mas vou fazer uma última ligação. Diga-me."

# game/scripts/c15/c15.rpy:3526
translate brazilian c15s007_KiaraHouse_4975e053:

    # sch "Ha habido un accidente en Mill Road. ¿Te puedes acercar?"
    sch "Houve um acidente na Mill Road. Você pode vir?"

# game/scripts/c15/c15.rpy:3527
translate brazilian c15s007_KiaraHouse_00e4560a:

    # oma "¿No pueden ir Jones o Garcia? Hace una hora que han empezado su turno."
    oma "Jones ou Garcia não podem ir? Eles começaram o turno há uma hora."

# game/scripts/c15/c15.rpy:3528
translate brazilian c15s007_KiaraHouse_4cb0461b:

    # sch "Ahí está el problema. El accidente lo ha tenido Jones contra un civil. Él está bien, pero su coche no. El civil necesitará atención. Ya he enviado la grúa y la ambulancia."
    sch "Esse é o problema. Jones se envolveu em um acidente com um civil. Ele está bem, mas o carro dele não. O civil precisará de atendimento médico. Eu já enviei o guincho e a ambulância."

# game/scripts/c15/c15.rpy:3529
translate brazilian c15s007_KiaraHouse_2633fd2e:

    # sch "Y antes de que preguntes, Garcia está en un servicio, esta vez no se está escaqueando."
    sch "E antes que você pergunte, Garcia está de plantão, e desta vez ele não está se esquivando de suas responsabilidades."

# game/scripts/c15/c15.rpy:3530
translate brazilian c15s007_KiaraHouse_aba38a4c:

    # oma "Lo entiendo. Voy para allá."
    oma "Entendo. Já estou a caminho."

# game/scripts/c15/c15.rpy:3531
translate brazilian c15s007_KiaraHouse_2c87ba1a:

    # sch "Gracias, preciosa. Trae a Jones aquí. Le tendrás que dejar tu coche patrulla para esta noche."
    sch "Obrigada, querida. Traga o Jones aqui. Você vai ter que deixar ele usar a viatura esta noite."

# game/scripts/c15/c15.rpy:3532
translate brazilian c15s007_KiaraHouse_060e0583:

    # oma "Corto y cierro."
    oma "Terminei."

# game/scripts/c15/c15.rpy:3534
translate brazilian c15s007_KiaraHouse_723ab410:

    # oma "Ya lo has oído, me tengo que ir."
    oma "Você me ouviu, eu preciso ir."

# game/scripts/c15/c15.rpy:3535
translate brazilian c15s007_KiaraHouse_dd3faeed:

    # mc "Ya, el deber es lo primero. No te preocupes, ya me quedo yo con Kiara y Eileen."
    mc "Sim, o dever vem em primeiro lugar. Não se preocupe, eu cuidarei da Kiara e da Eileen."

# game/scripts/c15/c15.rpy:3536
translate brazilian c15s007_KiaraHouse_29c7394c:

    # oma "Llámame si hay algún problema. En cuanto acabe vendré, no me debería llevar más de 30 o 40 minutos..."
    oma "Ligue-me se houver algum problema. Chegarei assim que terminar; não devo demorar mais de 30 ou 40 minutos."

# game/scripts/c15/c15.rpy:3537
translate brazilian c15s007_KiaraHouse_d441cc08:

    # mc "En 30 minutos ya no deberíamos estar aquí, no te preocupes. Y ya has oído a Eileen, su padre no volverá hasta medianoche."
    mc "Não devemos chegar em 30 minutos, não se preocupe. E você ouviu a Eileen, o pai dela só volta à meia-noite."

# game/scripts/c15/c15.rpy:3538
translate brazilian c15s007_KiaraHouse_31fcb459:

    # oma "De todas formas, llámame o escríbeme cuando estéis en casa. Me quedaré más tranquila. Yo te llamaré cuando acabe, por si aún estáis aquí."
    oma "Enfim, me liga ou manda mensagem quando chegar em casa. Vou me sentir melhor assim. Eu te ligo quando terminar, só para garantir que você ainda esteja aqui."

# game/scripts/c15/c15.rpy:3541
translate brazilian c15s007_KiaraHouse_e3496bc5:

    # oma "Te quiero."
    oma "Eu te amo."

# game/scripts/c15/c15.rpy:3542
translate brazilian c15s007_KiaraHouse_6616e794:

    # mc "Yo también te quiero."
    mc "Eu também te amo."

# game/scripts/c15/c15.rpy:3545
translate brazilian c15s007_KiaraHouse_046d047e:

    # mc "Perfecto, te llamo luego."
    mc "Perfeito, eu te ligo mais tarde."

# game/scripts/c15/c15.rpy:3546
translate brazilian c15s007_KiaraHouse_56a81578:

    # oma "Hasta luego."
    oma "Até mais."

# game/scripts/c15/c15.rpy:3549
translate brazilian c15s007_KiaraHouse_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c15/c15.rpy:3551
translate brazilian c15s007_KiaraHouse_4734d7b5:

    # eil "¿Dónde está Alexia?"
    eil "Onde está Alexia?"

# game/scripts/c15/c15.rpy:3552
translate brazilian c15s007_KiaraHouse_ba6bbf0d:

    # mc "La han llamado para un servicio de urgencia. Si no habéis terminado cuando lo acabe, volverá."
    mc "Ela foi chamada para atender uma emergência. Se você não tiver terminado até ela terminar, ela voltará."

# game/scripts/c15/c15.rpy:3554
translate brazilian c15s007_KiaraHouse_600cdfd6:

    # mc "Una maleta hecha. ¿Os queda mucho?"
    mc "Mala pronta. Já está quase a chegar?"

# game/scripts/c15/c15.rpy:3555
translate brazilian c15s007_KiaraHouse_62eaf6c6:

    # eil "Yo casi he acabado, mi otra maleta ya está hecha y solo me falta cerrarla. Voy a ayudar a mi madre con las suyas."
    eil "Estou quase terminando; minha outra mala está pronta e só preciso fechá-la. Vou ajudar minha mãe com a dela."

# game/scripts/c15/c15.rpy:3556
translate brazilian c15s007_KiaraHouse_75d335e2:

    # mc "¿Queréis ayuda?"
    mc "Você precisa de ajuda?"

# game/scripts/c15/c15.rpy:3558
translate brazilian c15s007_KiaraHouse_2c55182e:

    # eil "No te preocupes, entre las dos acabaremos rápido. No creo que a mi madre le gustara que hurgaras entre su ropa interior."
    eil "Não se preocupe, vamos terminar rapidinho entre nós duas. Acho que minha mãe não ia gostar nada de você mexendo nas roupas íntimas dela."

# game/scripts/c15/c15.rpy:3559
translate brazilian c15s007_KiaraHouse_923db28a:

    # mc "Ermmm..."
    mc "Hummm..."

# game/scripts/c15/c15.rpy:3561
translate brazilian c15s007_KiaraHouse_ecdeef43:

    # eil "*Risa* ¡Y no hagas ninguna broma sobre meterte en sus bragas, que te conozco!"
    eil "*Risos* E nem pense em fazer piada sobre entrar nas calcinhas dela, eu te conheço!"

# game/scripts/c15/c15.rpy:3562
translate brazilian c15s007_KiaraHouse_ef344348:

    # mc "Maleta cargada. Solo quedan tres más."
    mc "Mala cheia. Só faltam três."

# game/scripts/c15/c15.rpy:3563
translate brazilian c15s007_KiaraHouse_20af0adf:

    # mc "No iba a hacer ninguna broma... Y no me des ideas. *Risa*"
    mc "Eu não ia fazer nenhuma piada... E nem me dê ideias. *Risos*"

# game/scripts/c15/c15.rpy:3565
translate brazilian c15s007_KiaraHouse_f296a3d2:

    # eil "¿Lo estás diciendo en serio?"
    eil "Você está falando sério?"

# game/scripts/c15/c15.rpy:3566
translate brazilian c15s007_KiaraHouse_7c61d712:

    # mc "Por supuesto, que sí."
    mc "Claro."

# game/scripts/c15/c15.rpy:3567
translate brazilian c15s007_KiaraHouse_116e1bbc:

    # mc "No iba a hacer ninguna broma. *Risa*"
    mc "Eu não ia fazer nenhuma piada. *Risos*"

# game/scripts/c15/c15.rpy:3569
translate brazilian c15s007_KiaraHouse_d9f8a862:

    # eil "No, idiota. Estoy hablando en serio. Lo de tener ideas con mi madre."
    eil "Não, seu idiota. Estou falando sério. Sobre ter ideias com a minha mãe."

# game/scripts/c15/c15.rpy:3570
translate brazilian c15s007_KiaraHouse_563efdbb:

    # mc "¿Qué? ¡No! No se me ha ocurrido nunca. Tan solo te seguía la broma."
    mc "O quê? Não! Nunca me passou pela cabeça. Eu só estava entrando na sua brincadeira."

# game/scripts/c15/c15.rpy:3572
translate brazilian c15s007_KiaraHouse_c175e4d2:

    # eil "Casi me habías asustado... después del beso de antes..."
    eil "Você quase me assustou... depois daquele beijo mais cedo..."

# game/scripts/c15/c15.rpy:3573
translate brazilian c15s007_KiaraHouse_2958262e:

    # mc "Me ha besado porque la has puesto entre la espada y la pared, no porque quisiera."
    mc "Ela me beijou porque você a encurralou, não porque ela quis."

# game/scripts/c15/c15.rpy:3574
translate brazilian c15s007_KiaraHouse_250e2188:

    # mc "Y ha sido el beso menos sensual que me han dado nunca... hasta el de Tía Betty ha sido mejor. *Risa*"
    mc "E foi o beijo menos sensual que já recebi... até o da tia Betty era melhor. *Risos*"

# game/scripts/c15/c15.rpy:3576
translate brazilian c15s007_KiaraHouse_41ab5b18:

    # kia "¿Hasta una monja besa mejor que yo? Tendré que mejorar eso. *Risa* ¿Y por qué te has asustado, Eile? Solo ha sido un beso."
    kia "Até uma freira beija melhor do que eu? Preciso melhorar isso. *Risos* E por que você estava com medo, Eile? Foi só um beijo."

# game/scripts/c15/c15.rpy:3578
translate brazilian c15s007_KiaraHouse_5344fdd4:

    # eil "Por nada... [mc] ha hecho una broma sobre tu ropa interior y..."
    eil "De nada... [mc] fez uma piada sobre sua roupa íntima e..."

# game/scripts/c15/c15.rpy:3579
translate brazilian c15s007_KiaraHouse_8e155502:

    # mc "¡Pero si yo no he llegado a decir nada!"
    mc "Mas eu não disse uma palavra!"

# game/scripts/c15/c15.rpy:3581
translate brazilian c15s007_KiaraHouse_6926ab84:

    # eil "¡Vale, tú no has dicho nada! Me he montado yo sola la película en la cabeza... Pero imaginaros juntos..."
    eil "Ok, você não disse nada! Eu acabei de inventar todo esse cenário na minha cabeça... Mas imagine vocês dois juntos..."

# game/scripts/c15/c15.rpy:3583
translate brazilian c15s007_KiaraHouse_878dee2e:

    # kia "*Risa* ¿Qué? ¿[mc] y yo juntos? ¡Después la loca soy yo! *Risa* Espero que no me estés retando como con el beso."
    kia "*Risos* O quê? [mc] e eu juntos? Então eu sou o louco! *Risos* Espero que você não esteja me desafiando como fez com o beijo."

# game/scripts/c15/c15.rpy:3584
translate brazilian c15s007_KiaraHouse_83156cd5:

    # mc "*Risa* No sé si sentirme ofendido ahora mismo."
    mc "*Risos* Não sei se devo me sentir ofendido agora."

# game/scripts/c15/c15.rpy:3586
translate brazilian c15s007_KiaraHouse_c5acc1c8:

    # kia "No me refiero a eso, cielo. ¿Qué ibas a hacer tú con una mujer como yo, con todos los problemas que hay en mi vida ahora mismo? *Risa*"
    kia "Não é isso que eu quero dizer, querido. O que você faria com uma mulher como eu, com todos os problemas que tenho na minha vida agora? *Risos*"

# game/scripts/c15/c15.rpy:3587
translate brazilian c15s007_KiaraHouse_fd47b3ec:

    # mc "Ayudarte a resolverlos, por supuesto. *Risa*"
    mc "Ajudando você a resolvê-los, é claro. *Risos*"

# game/scripts/c15/c15.rpy:3590
translate brazilian c15s007_KiaraHouse_bfff1ac2:

    # kia "No me extraña que le echaras el lazo en cuanto volvió, Eile. Siempre tiene la respuesta adecuada para todo."
    kia "Não me surpreende que você o tenha contratado assim que ele voltou, Eile. Ele sempre tem a resposta certa para tudo."

# game/scripts/c15/c15.rpy:3592
translate brazilian c15s007_KiaraHouse_d7f0cc96:

    # kia "Es una lástima que no le echaras el lazo en cuanto volvió, Eile. Siempre tiene la respuesta adecuada para todo."
    kia "É uma pena que você não o tenha agarrado assim que ele voltou, Eile. Ele sempre tem a resposta certa para tudo."

# game/scripts/c15/c15.rpy:3593
translate brazilian c15s007_KiaraHouse_214c0463:

    # mc "Eso no es verdad, pero sabes que estoy para ayudarte en cualquier cosa que necesites. Que necesitéis las dos."
    mc "Isso não é verdade, mas você sabe que estou aqui para te ajudar com tudo o que precisar. Tudo o que vocês dois precisarem."

# game/scripts/c15/c15.rpy:3596
translate brazilian c15s007_KiaraHouse_c9219344:

    # kia "Eile, si alguna vez te cansas de él, me lo pido para mí. *Risa*"
    kia "Eile, se você se cansar disso, eu fico com ele para mim. *Risos*"

# game/scripts/c15/c15.rpy:3598
translate brazilian c15s007_KiaraHouse_b59c4edf:

    # kia "Estoy por pedírmelo para mí ahora que no lo tendría que compartir contigo, Eile. *Risa*"
    kia "Estou pensando em encomendar um para mim agora que não precisarei mais dividir com você, Eile. *Risos*"

# game/scripts/c15/c15.rpy:3599
translate brazilian c15s007_KiaraHouse_893f3ba7:

    # mc "Yo estoy abierto a ser compartido. *Risa*"
    mc "Estou aberta a ser compartilhada. *Risos*"

# game/scripts/c15/c15.rpy:3600
translate brazilian c15s007_KiaraHouse_0e8ac2f3:

    # kia "Si tuviera 25 años menos y estuviera soltera... *Risa*"
    kia "Se eu fosse 25 anos mais jovem e solteira... *Risos*"

# game/scripts/c15/c15.rpy:3602
translate brazilian c15s007_KiaraHouse_e721f458:

    # eil "¿Ves? ¡A eso me refiero! Empezáis con las bromas, los abrazos y los besos y acabáis..."
    eil "Viu? É isso que eu quero dizer! Você começa com piadas, abraços e beijos, e termina..."

# game/scripts/c15/c15.rpy:3604
translate brazilian c15s007_KiaraHouse_908d8ff1:

    # mc "Eile, ¿en serio te preocupa que tu madre y yo acabemos juntos?"
    mc "Eile, você está mesmo preocupada que eu e sua mãe acabemos juntas?"

# game/scripts/c15/c15.rpy:3610
translate brazilian c15s007_KiaraHouse_deadd5c9:

    # sol "*Voz de borracho* A ella quizás no, pero a mí sí. *Hic* ¡Quítale las manos de encima a mi mujer!"
    sol "*Voz de bêbado* Talvez não ela, mas eu. *Soluço* Tire as mãos da minha esposa!"

# game/scripts/c15/c15.rpy:3612
translate brazilian c15s007_KiaraHouse_eee087a9:

    # kia "¡Solomon! ¡No es lo que pueda parecerte! ¿Qué haces aquí?"
    kia "Salomão! Não é o que parece! O que você está fazendo aqui?"

# game/scripts/c15/c15.rpy:3614
translate brazilian c15s007_KiaraHouse_5da65093:

    # sol "*Voz de borracho* ¿Qué hago aquí? ¡Es mi puta casa! *Hic* Un amigo me ha llamado para decirme que la policía estaba en la puerta de casa."
    sol "*Voz de bêbado* O que eu estou fazendo aqui? Esta é a minha casa, caramba! *Soluço* Um amigo ligou para avisar que a polícia estava na minha porta."

# game/scripts/c15/c15.rpy:3615
translate brazilian c15s007_KiaraHouse_6d2f572d:

    # sol "*Voz de borracho* Y llego para ver que mi propia mujer me está robando y está *Hic* en los brazos de otro hombre! ¡De un niñato!"
    sol "*Voz de bêbado* E eu chego em casa e encontro minha própria esposa me roubando e *Soluço* nos braços de outro homem! Um garoto!"

# game/scripts/c15/c15.rpy:3617
translate brazilian c15s007_KiaraHouse_d3f4ddda:

    # kia "No estamos robando, hemos venido a por algo de ropa. Nuestra ropa. Y..."
    kia "Não estamos roubando, viemos buscar roupas. Nossas roupas. E..."

# game/scripts/c15/c15.rpy:3619
translate brazilian c15s007_KiaraHouse_7a4c5a2f:

    # sol "*Voz de borracho* Y a avergonzarme delante de todo el barrio *Hic* abrazando a otro delante de casa. ¡Además, al ex-novio de tu hija!"
    sol "*Voz de bêbado* E para piorar tudo, ainda me envergonho na frente de toda a vizinhança *Soluço* abraçando outra pessoa na frente da minha casa. E para completar, é o ex-namorado da sua filha!"

# game/scripts/c15/c15.rpy:3620
translate brazilian c15s007_KiaraHouse_a7717ec8:

    # mc "Solomon, no te acerques más. Solo era un abrazo."
    mc "Salomão, não se aproxime mais. Foi só um abraço."

# game/scripts/c15/c15.rpy:3622
translate brazilian c15s007_KiaraHouse_cf4bc285:

    # mc "Eileen, ve a buscar las maletas. Kiara, detrás de mí."
    mc "Eileen, vá buscar as malas. Kiara, atrás de mim."

# game/scripts/c15/c15.rpy:3623
translate brazilian c15s007_KiaraHouse_8ea34bcc:

    # eil "Voy."
    eil "Ir."

# game/scripts/c15/c15.rpy:3625
translate brazilian c15s007_KiaraHouse_59d54302:

    # sol "*Voz de borracho* ¿Ahora me das ordenes? *Hic* ¿Y también a tus putitas?"
    sol "*Voz de bêbado* Agora você está me dando ordens? *Soluço* E suas putinhas também?"

# game/scripts/c15/c15.rpy:3626
translate brazilian c15s007_KiaraHouse_790048dd:

    # mc "No les faltes al respeto, Solomon. Estás borracho."
    mc "Não os desrespeite, Salomão. Você está bêbado."

# game/scripts/c15/c15.rpy:3628
translate brazilian c15s007_KiaraHouse_c5b6263f:

    # kia "[mc] solo ha venido a ayudarnos y se lo estaba agradeciendo con un simple abrazo."
    kia "[mc] Ele só veio para nos ajudar e eu o agradeci com um simples abraço."

# game/scripts/c15/c15.rpy:3629
translate brazilian c15s007_KiaraHouse_d3b76a72:

    # mc "Déjanos acabar de recoger lo que hemos venido a llevarnos y no habrá problemas, Solomon."
    mc "Vamos terminar de recolher o que viemos buscar e não haverá problemas, Salomão."

# game/scripts/c15/c15.rpy:3631
translate brazilian c15s007_KiaraHouse_077feee2:

    # sol "*Voz de borracho* ¡Tú quieres robarme mi familia! *Hic* ¡Pero esta se queda aquí!"
    sol "*Voz de bêbado* Você quer roubar minha família! *Soluço* Mas eles vão ficar aqui!"

# game/scripts/c15/c15.rpy:3633
translate brazilian c15s007_KiaraHouse_9b9e2061:

    # mc "¡Te he dicho que no te acerques! ¿No tuviste suficiente con lo que le hiciste el otro día?"
    mc "Eu te disse para não chegar perto dela! O que você fez com ela outro dia não foi suficiente?"

# game/scripts/c15/c15.rpy:3635
translate brazilian c15s007_KiaraHouse_c1c29318:

    # sol "*Voz de borracho* ¡No te entrometas en los asuntos de mi familia!"
    sol "*Voz de bêbado* Não se meta nos assuntos da minha família!"

# game/scripts/c15/c15.rpy:3637
translate brazilian c15s007_KiaraHouse_abbde0c3:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3640
translate brazilian c15s007_KiaraHouse_ec3de842:

    # kia "¡Solomon! ¡Para ahora mismo! ¡Déjanos irnos con nuestras cosas!"
    kia "Salomão! Pare agora mesmo! Deixe-nos ir com as nossas coisas!"

# game/scripts/c15/c15.rpy:3641
translate brazilian c15s007_KiaraHouse_fcc3b65f:

    # mc "Haz caso a tu mujer y vete, Solomon. No quiero hacerte daño."
    mc "Ouça sua esposa e vá embora, Salomão. Não quero te magoar."

# game/scripts/c15/c15.rpy:3643
translate brazilian c15s007_KiaraHouse_971d4615:

    # sol "*Voz de borracho* ¡Pelea como un hombre!"
    sol "*Voz de bêbado* Lute como um homem!"

# game/scripts/c15/c15.rpy:3644
translate brazilian c15s007_KiaraHouse_688798af:

    # mc "No quiero pelear contigo, Solomon."
    mc "Não quero brigar com você, Salomão."

# game/scripts/c15/c15.rpy:3646
translate brazilian c15s007_KiaraHouse_317a15ac:

    # sol "*Voz de borracho* ¡Hijo de puta!"
    sol "*Voz de bêbado* Seu filho da puta!"

# game/scripts/c15/c15.rpy:3648
translate brazilian c15s007_KiaraHouse_abbde0c3_1:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3649
translate brazilian c15s007_KiaraHouse_3cb40196:

    # mc "Quédate ahí, Solomon. No quiero pegarte delante de tu mujer, pero no dudaré en hacerlo si vuelves a intentar pegarme a mí."
    mc "Fique aí mesmo, Salomão. Não quero te bater na frente da sua esposa, mas não hesitarei em fazê-lo se você tentar me bater de novo."

# game/scripts/c15/c15.rpy:3651
translate brazilian c15s007_KiaraHouse_47381df1:

    # kia "No te levantes, por favor, Sol. No quiero que te hagan daño."
    kia "Não se levante, por favor, Sol. Não quero que você se machuque."

# game/scripts/c15/c15.rpy:3652
translate brazilian c15s007_KiaraHouse_e9057d29:

    # mc "Haz caso a Kiara. Kiara, sube al coche, por favor."
    mc "Escuta a Kiara. Kiara, entra no carro, por favor."

# game/scripts/c15/c15.rpy:3654
translate brazilian c15s007_KiaraHouse_e4f4810e:

    # mc "*Susurrando* Mira, puto desperdicio humano, no quiero que te vuelvas a acercar a Kiara o Eileen si no se acercan ellas primero."
    mc "*Sussurrando* Olha aqui, seu verme humano de merda, eu não quero você chegando perto da Kiara ou da Eileen de novo, a menos que elas te abordem primeiro."

# game/scripts/c15/c15.rpy:3655
translate brazilian c15s007_KiaraHouse_b004bac7:

    # mc "*Susurrando* Sólo he necesitado un pequeño empujón para que acabes en el suelo. Si se te ocurre tocarlas, a cualquiera de las dos, entonces vendré a por ti y no seré comprensivo. ¿Entendido?"
    mc "*Sussurrando* Bastou um empurrãozinho para você cair. Se você sequer pensar em tocá-los, qualquer um deles, eu vou atrás de você, e não vou ter piedade. Entendeu?"

# game/scripts/c15/c15.rpy:3656
translate brazilian c15s007_KiaraHouse_e445a441:

    # sol "¡Son mi mujer y mi hija! ¡Tú no eres nadie...!"
    sol "Elas são minha esposa e minha filha! Você não é ninguém...!"

# game/scripts/c15/c15.rpy:3658
translate brazilian c15s007_KiaraHouse_abbde0c3_2:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3659
translate brazilian c15s007_KiaraHouse_1b8e8c72:

    # mc "¡Oops, qué asco! Me parece que he pisado una mierda de perro. Pero al menos así las dos manos te dolerán igual."
    mc "Ops, que nojo! Acho que pisei em cocô de cachorro. Mas pelo menos suas duas mãos vão doer do mesmo jeito."

# game/scripts/c15/c15.rpy:3660
translate brazilian c15s007_KiaraHouse_06190750:

    # mc "Te he preguntado si me has entendido."
    mc "Eu te perguntei se você me entendeu."

# game/scripts/c15/c15.rpy:3661
translate brazilian c15s007_KiaraHouse_68ffbd79:

    # sol "¡Sí, sí!"
    sol "Sim, sim!"

# game/scripts/c15/c15.rpy:3663
translate brazilian c15s007_KiaraHouse_0ab3179f:

    # eil "Ya está, esto es lo último."
    eil "É isso, este é o último."

# game/scripts/c15/c15.rpy:3665
translate brazilian c15s007_KiaraHouse_8737adc7:

    # eil "¿Qué ha pasado? ¿Lo has tumbado?"
    eil "O que aconteceu? Você derrubou?"

# game/scripts/c15/c15.rpy:3666
translate brazilian c15s007_KiaraHouse_6d60bc3c:

    # mc "No, Eile, Se ha tumbado solo. Ha intentado pegarme y ha acabado con la cabeza en la camioneta. Está muy borracho."
    mc "Não, Eile, ele se deitou sozinho. Tentou me bater e acabou com a cabeça dentro da caminhonete. Ele está muito bêbado."

# game/scripts/c15/c15.rpy:3668
translate brazilian c15s007_KiaraHouse_e23d4eaa:

    # sol "*Voz de borracho* Tu exnovio no pelea limpio. *Hic* Pero iré a buscaros cuando él no esté."
    sol "*Voz de bêbado* Seu ex-namorado não sabe lutar limpo. *Soluço* Mas eu vou te procurar quando ele não estiver por perto."

# game/scripts/c15/c15.rpy:3670
translate brazilian c15s007_KiaraHouse_55d1d921:

    # sol "¡Aaargh! ¡Hija de puta!"
    sol "Aaargh! Seu filho da puta!"

# game/scripts/c15/c15.rpy:3672
translate brazilian c15s007_KiaraHouse_dce52b93:

    # eil "*Susurrando* Escuchame bien, saco de mierda. No te vas a volver a acercar a Mamá, ¿vale?"
    eil "*Sussurrando* Escuta bem, seu merda. Você não vai chegar perto da mamãe de novo, entendeu?"

# game/scripts/c15/c15.rpy:3673
translate brazilian c15s007_KiaraHouse_1b5df64c:

    # eil "*Susurrando* Voy a hacer todo lo posible para que no vuelva con una basura como tú."
    eil "*Sussurrando* Vou fazer tudo o que estiver ao meu alcance para garantir que ela nunca mais volte a se envolver com gente desprezível como você."

# game/scripts/c15/c15.rpy:3674
translate brazilian c15s007_KiaraHouse_7ab896f7:

    # eil "*Susurrando* Si se te ocurre tocarla o, aunque sea, amenazarla, todo el mundo se va a enterar de que ya no eres un hombre. ¿Vale?"
    eil "*Sussurrando* Se você sequer pensar em tocá-la, ou mesmo em ameaçá-la, todos saberão que você não é mais homem. Entendeu?"

# game/scripts/c15/c15.rpy:3675
translate brazilian c15s007_KiaraHouse_e0fc56bd:

    # eil "*Susurrando* A ver qué mote te sacan tus amigos cuando se enteren ¿Fideo? ¿Picha blanda?"
    eil "*Sussurrando* Vamos ver que apelido seus amigos vão inventar quando descobrirem. Macarrão? Pau mole?"

# game/scripts/c15/c15.rpy:3676
translate brazilian c15s007_KiaraHouse_3dff952e:

    # mc "Eileen, déjalo. Está tan borracho que mañana no se va a acordar de lo que le has dicho."
    mc "Eileen, deixe-o em paz. Ele está tão bêbado que não se lembrará do que você disse amanhã."

# game/scripts/c15/c15.rpy:3678
translate brazilian c15s007_KiaraHouse_f96733b5:

    # eil "No, esto no se le va a olvidar. Cuando se pregunte por qué le duele la mano, lo recordará."
    eil "Não, ele não vai esquecer isso. Quando se perguntar por que sua mão dói, ele vai se lembrar disso."

# game/scripts/c15/c15.rpy:3679
translate brazilian c15s007_KiaraHouse_cda2aaab:

    # mc "No te conviertas en lo que es él. No vale la pena."
    mc "Não se torne como ele. Não vale a pena."

# game/scripts/c15/c15.rpy:3681
translate brazilian c15s007_KiaraHouse_18173db3:

    # eil "Tienes razón, no merece la pena... pero sienta tan bien... Es tan fácil convertirse en una mala persona..."
    eil "Você tem razão, não vale a pena... mas é uma sensação tão boa... É tão fácil se tornar uma pessoa má..."

# game/scripts/c15/c15.rpy:3682
translate brazilian c15s007_KiaraHouse_dab57d09:

    # mc "Vámonos, Eile."
    mc "Vamos lá, Eile."

# game/scripts/c15/c15.rpy:3685
translate brazilian c15s007_KiaraHouse_0594242f:

    # "Conduces en silencio durante unos minutos hasta que salís del barrio donde está la casa que tan malos recuerdos les trae ahora mismo."
    "Você dirige em silêncio por alguns minutos até sair do bairro onde fica a casa que traz de volta lembranças tão ruins."

# game/scripts/c15/c15.rpy:3688
translate brazilian c15s007_KiaraHouse_6024bbc3:

    # eil "¿Puedes parar un momento? Necesito estirar las piernas... me tiembla todo."
    eil "Você pode parar um instante? Preciso esticar as pernas... Estou tremendo toda."

# game/scripts/c15/c15.rpy:3689
translate brazilian c15s007_KiaraHouse_490a5904:

    # mc "Eso es la adrenalina. Te has enfrentado a él por primera vez."
    mc "Isso é adrenalina. Você o encarou pela primeira vez."

# game/scripts/c15/c15.rpy:3690
translate brazilian c15s007_KiaraHouse_5e820541:

    # eil "También voy a necesitar un abrazo..."
    eil "Eu também preciso de um abraço..."

# game/scripts/c15/c15.rpy:3692
translate brazilian c15s007_KiaraHouse_83b332aa:

    # eil "Gracias, [mc]."
    eil "Obrigado, [mc]."

# game/scripts/c15/c15.rpy:3693
translate brazilian c15s007_KiaraHouse_2ed9f919:

    # mc "No hace falta que las des. Me encanta abrazar."
    mc "Você não precisa dar. Eu adoro abraçar."

# game/scripts/c15/c15.rpy:3694
translate brazilian c15s007_KiaraHouse_45c28a94:

    # eil "¡Idiota! No me refería a eso y lo sabes."
    eil "Idiota! Não foi isso que eu quis dizer, e você sabe disso."

# game/scripts/c15/c15.rpy:3696
translate brazilian c15s007_KiaraHouse_29d5100b:

    # kia "Gracias por como lo has tratado, [mc]... Cualquier otro le hubiera pegado... sé que se lo hubiera merecido... pero no deja de ser mi marido..."
    kia "Obrigada pela forma como o tratou, [mc]... Qualquer outra pessoa o teria agredido... Eu sei que ele mereceria... mas ele ainda é meu marido..."

# game/scripts/c15/c15.rpy:3697
translate brazilian c15s007_KiaraHouse_598681bc:

    # mc "Ver en la piltrafa de hombre que se ha convertido me ha revuelto el estómago."
    mc "Ver o homem patético em que ele se transformou me deu ânsia de vômito."

# game/scripts/c15/c15.rpy:3698
translate brazilian c15s007_KiaraHouse_3c1818df:

    # mc "Pegarle no hubiera mejorado nada, tan solo lo hubiera empeorado."
    mc "Bater nele não teria melhorado nada, só teria piorado a situação."

# game/scripts/c15/c15.rpy:3700
translate brazilian c15s007_KiaraHouse_7d20f598:

    # eil "Mamá, hay espacio aquí para ti también. Sé que te encantan los abrazos de [mc]."
    eil "Mãe, tem espaço aqui para você também. Eu sei que você adora abraços."

# game/scripts/c15/c15.rpy:3702
translate brazilian c15s007_KiaraHouse_8de6ffc6:

    # eil "Pero no tengas ideas raras con mi novio."
    eil "Mas não tirem ideias estranhas sobre o meu namorado."

# game/scripts/c15/c15.rpy:3704
translate brazilian c15s007_KiaraHouse_f81c97e7:

    # eil "Pero no tengas ideas raras con mi ex-novio."
    eil "Mas não tirem ideias estranhas sobre meu ex-namorado."

# game/scripts/c15/c15.rpy:3705
translate brazilian c15s007_KiaraHouse_62d4aaf0:

    # mc "Será mejor que no vuelvas a retar a tu madre, Eileen... ya has visto como ha ido con los besos. *Risa*"
    mc "É melhor você não desafiar sua mãe de novo, Eileen... você viu como isso terminou com os beijos. *Risos*"

# game/scripts/c15/c15.rpy:3707
translate brazilian c15s007_KiaraHouse_555e84df:

    # eil "¿Qué? ¡No! ¡No te estoy retando, Mamá!"
    eil "O quê? Não! Eu não estou te desafiando, mãe!"

# game/scripts/c15/c15.rpy:3708
translate brazilian c15s007_KiaraHouse_42b2c0ff:

    # eil "Si te lo tomas como un reto... No creo que sea capaz de mantener sus manos alejadas de ti."
    eil "Se você encarar isso como um desafio... acho que ele não conseguirá tirar as mãos de você."

# game/scripts/c15/c15.rpy:3710
translate brazilian c15s007_KiaraHouse_cf9822ed:

    # kia "*Risa* No funciona así, cielo. No te preocupes, [mc] es un buen amigo, pero soy demasiado vieja para él."
    kia "*Risos* Não funciona assim, querida. Não se preocupe, [mc] é um bom amigo, mas eu sou velha demais para ele."

# game/scripts/c15/c15.rpy:3712
translate brazilian c15s007_KiaraHouse_45a8e18b:

    # kia "{i}(Aunque parece que a él la edad no le importa demasiado.){/i}"
    kia "{i}(Embora pareça que a idade não importe muito para ele.){/i}"

# game/scripts/c15/c15.rpy:3714
translate brazilian c15s007_KiaraHouse_15e5bde7:

    # kia "{i}(¡No! ¡Eile tiene razón! Estos pensamientos son peligrosos y no debo tenerlos... y soy una mujer casada.){/i}"
    kia "{i}(Não! Eile tem razão! Esses pensamentos são perigosos e eu não devo tê-los... e eu sou uma mulher casada.){/i}"

# game/scripts/c15/c15.rpy:3716
translate brazilian c15s007_KiaraHouse_8178f3f3:

    # kia "{i}(Pero se está tan bien aquí... estos abrazos y los besos...){/i}"
    kia "{i}(Mas é tão bom aqui... esses abraços e beijos...){/i}"

# game/scripts/c15/c15.rpy:3718
translate brazilian c15s007_KiaraHouse_f71f4962:

    # kia "{i}(¡Los besos! ¿Por qué he aceptado? ¿Cómo puedo ser tan fácil de manipular? ¿Me está manipulando Eileen?){/i}"
    kia "{i}(Os beijos! Por que eu concordei? Como posso ser tão facilmente manipulado? Será que Eileen está me manipulando?){/i}"

# game/scripts/c15/c15.rpy:3720
translate brazilian c15s007_KiaraHouse_e7da7f88:

    # "Cuando las chicas se calman del todo, pasáis a recoger a [eri] y volvéis a casa. Entre los cuatro subís sus maletas a su habitación."
    "Quando as meninas se acalmarem completamente, você pega [eri] e volta para casa. Vocês quatro carregam as malas dela até o quarto."

# game/scripts/c15/c15.rpy:3785
translate brazilian c15s007_Night_11553dbe:

    # "La noticia de que los saludos con besos se han reanudado ha corrido como la pólvora. [emm], [dap], [eri], y Scarlett se unen a la nueva costumbre sin hacer preguntas."
    "A notícia de que as saudações com beijos voltaram a acontecer se espalhou como fogo em palha seca. [emm], [dap], [eri] e Scarlett aderem ao novo costume sem fazer perguntas."

# game/scripts/c15/c15.rpy:3786
translate brazilian c15s007_Night_6d229a41:

    # "[mar], [nor] y Betty continúan con ella. Incluso Olivia te saluda con un beso en los labios al llegar. Reluctantemente, pero menos que por la tarde."
    "[mar], [nor], e Betty continuam com ela. Até Olivia te cumprimenta com um beijo nos lábios ao chegar. Relutantemente, mas menos do que à tarde."

# game/scripts/c15/c15.rpy:3787
translate brazilian c15s007_Night_a7d29042:

    # "Después de cenar, Kiara se despide de ti con un beso, casi tan reluctante como el de Meemaw, lo cual te sorprende después del último beso de la tarde. El de Eileen es normal."
    "Depois do jantar, Kiara se despede com um beijo, quase tão relutante quanto o da vovó, o que surpreende depois do último beijo da noite. O de Eileen é normal."

# game/scripts/c15/c15.rpy:3788
translate brazilian c15s007_Night_c5de8e5b:

    # "Vuelves a casa después de un día lleno de emociones, pero escuchas risas en la sala nada más entrar."
    "Você volta para casa depois de um dia emocionante, mas ouve risadas na sala de estar assim que entra."

# game/scripts/c15/c15.rpy:3791
translate brazilian c15s007_Night_14b8b428:

    # mc "Buenas noches, chicas. ¿Parece que tenéis una fiesta hoy? Veo mucho vino ahí, y algunas botellas vacías."
    mc "Boa noite, senhoras. Parece que vocês vão dar uma festa hoje à noite? Vejo bastante vinho aí, e algumas garrafas vazias."

# game/scripts/c15/c15.rpy:3792
translate brazilian c15s007_Night_3c75717d:

    # kat "Es noche de chicas. Muchas confidencias que hacernos. *Risa*"
    kat "É noite das garotas. Muitos segredos para compartilhar. *Risos*"

# game/scripts/c15/c15.rpy:3793
translate brazilian c15s007_Night_1f225020:

    # kim "No sabíamos que saliste con Saira en Portland."
    kim "Não sabíamos que você tinha saído com a Saira em Portland."

# game/scripts/c15/c15.rpy:3794
translate brazilian c15s007_Night_c79860bd:

    # sai "No salíamos... al menos no oficialmente."
    sai "Nós não estávamos namorando... pelo menos não oficialmente."

# game/scripts/c15/c15.rpy:3795
translate brazilian c15s007_Night_dc049906:

    # deb "Bueno, pero erais pareja, ¿no?"
    deb "Bem, mas vocês eram um casal, não eram?"

# game/scripts/c15/c15.rpy:3796
translate brazilian c15s007_Night_2173493f:

    # lis "No, Deb, tenían una relación abierta, podrían haber salido con otras personas si hubieran querido. Lo ha explicado Saira cuando has ido al lavabo."
    lis "Não, Deb, eles tinham um relacionamento aberto; poderiam ter namorado outras pessoas se quisessem. A Saira explicou isso quando você foi ao banheiro."

# game/scripts/c15/c15.rpy:3797
translate brazilian c15s007_Night_a7bdb9e3:

    # mc "Supongo que no soy bienvenido a quedarme, ¿no?"
    mc "Acho que não sou bem-vindo para ficar, né?"

# game/scripts/c15/c15.rpy:3799
translate brazilian c15s007_Night_c868fcce:

    # todas "¡No!"
    todas "Não!"

# game/scripts/c15/c15.rpy:3800
translate brazilian c15s007_Night_521b6a53:

    # kim "Hemos dicho noche de chicas, y si estás delante, Saira no nos va a poder contar cosas sobre ti. *Risa*"
    kim "Dissemos que seria uma noite das garotas, e se você está aqui, a Saira não vai poder nos dizer nada sobre você. *Risos*"

# game/scripts/c15/c15.rpy:3802
translate brazilian c15s007_Night_8d7fc1fa:

    # deb "Después de los besos de ayer en la playa, ya has aparecido en la conversación."
    deb "Depois dos beijos de ontem na praia, você já entrou na conversa."

# game/scripts/c15/c15.rpy:3803
translate brazilian c15s007_Night_e73bdc90:

    # kat "Y queremos saber más *Risa*"
    kat "E queremos saber mais *Risos*"

# game/scripts/c15/c15.rpy:3804
translate brazilian c15s007_Night_978db81f:

    # lis "Aunque no solo hemos hablado de ti, ¿eh?"
    lis "Embora não tenhamos falado apenas sobre você, sabe?"

# game/scripts/c15/c15.rpy:3805
translate brazilian c15s007_Night_3585ba5d:

    # mc "*Sniff* Pues me voy desconsolado a mi habitación sintiéndome rechazado. *Risa*"
    mc "*Snif* Bom, vou para o meu quarto com o coração partido e me sentindo rejeitada. *Risos*"

# game/scripts/c15/c15.rpy:3806
translate brazilian c15s007_Night_31685440:

    # sai "¿Puedo hablar contigo un momento antes de que te vayas?"
    sai "Posso falar com você um instante antes de você ir embora?"

# game/scripts/c15/c15.rpy:3807
translate brazilian c15s007_Night_890c041b:

    # mc "Por supuesto."
    mc "Claro."

# game/scripts/c15/c15.rpy:3809
translate brazilian c15s007_Night_8d8742d1:

    # sai "[emm] nos ha contado lo de la nueva costumbre de saludos con besos. ¿Eso también nos incluye a nosotras? *Susurrando* ¿A mí?"
    sai "[emm] nos contou sobre o novo costume de cumprimentar com beijos. Isso inclui a gente também? *Sussurrando* Eu?"

# game/scripts/c15/c15.rpy:3810
translate brazilian c15s007_Night_b11f1345:

    # sai "Algunas queremos participar."
    sai "Alguns de nós querem participar."

# game/scripts/c15/c15.rpy:3811
translate brazilian c15s007_Night_9cd5fa47:

    # kim "¡Di que sí, [mc]! Al menos con Saira..."
    kim "Diga sim, [mc]! Pelo menos com a Saira..."

# game/scripts/c15/c15.rpy:3813
translate brazilian c15s007_Night_34139240:

    # sai "*Susurrando* Así podría robarte algunos besos sin que fuera sospechoso para estas chicas."
    sai "*Sussurrando* Assim eu poderia roubar uns beijos sem que essas garotas suspeitassem de nada."

# game/scripts/c15/c15.rpy:3815
translate brazilian c15s007_Night_1914eba4:

    # sai "*Susurrando* Así podría robarte algunos besos sin que fuera sospechoso para estas chicas, al menos hasta que decidamos que hacer con lo nuestro."
    sai "*Sussurrando* Assim eu poderia roubar uns beijos sem que essas garotas suspeitassem de nada, pelo menos até decidirmos o que fazer entre nós."

# game/scripts/c15/c15.rpy:3816
translate brazilian c15s007_Night_6cfce5e6:

    # sai "*Susurrando* Y si las incluyes a ellas... mejor todavía."
    sai "*Sussurrando* E se você os incluir... melhor ainda."

# game/scripts/c15/c15.rpy:3817
