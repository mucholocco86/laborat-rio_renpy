translate brazilian c15s003_PickUpEileen_8a3c4ca8:

    # mc "¿A qué hora sales hoy?"
    mc "A que horas você vai sair hoje?"

# game/scripts/c15/c15.rpy:1498
translate brazilian c15s003_PickUpEileen_c6878542:

    # eri "A las 8 PM. ¿Por qué?"
    eri "Às 20h. Por quê?"

# game/scripts/c15/c15.rpy:1499
translate brazilian c15s003_PickUpEileen_c8a329a9:

    # mc "Es posible que pase a buscarte cuando salgas. A esa hora deberíamos estar volviendo de casa de Eileen. Hoy Solomon sale a cenar con amigos. O de copas. O algo."
    mc "Talvez eu te busque quando você sair do trabalho. A gente deve estar voltando da casa da Eileen por volta desse horário. O Solomon vai sair para jantar com os amigos hoje à noite. Ou para tomar uns drinques. Ou algo assim."

# game/scripts/c15/c15.rpy:1501
translate brazilian c15s003_PickUpEileen_fd534d5e:

    # eri "Id con cuidado."
    eri "Tome cuidado."

# game/scripts/c15/c15.rpy:1502
translate brazilian c15s003_PickUpEileen_673ed1d8:

    # mc "Ayer hablé con Alexia y nos acompañará. Uniformada. Por lo que pueda ser. Pero Kiara dice que Solomon estará fuera hasta medianoche, con lo que, en principio, no hay peligro."
    mc "Falei com a Alexia ontem e ela vai se juntar a nós. De uniforme. Só por precaução. Mas a Kiara disse que o Solomon vai ficar fora até meia-noite, então, em princípio, não há perigo."

# game/scripts/c15/c15.rpy:1504
translate brazilian c15s003_PickUpEileen_3a062587:

    # eri "Hablando de Eileen y Alexia. ¿Puedes llevar a Eileen de vuelta a casa? Acaba su turno ya y ella no te lo va a pedir..."
    eri "Falando em Eileen e Alexia, você pode levar a Eileen para casa? O turno dela está terminando em breve, e ela não vai te pedir..."

# game/scripts/c15/c15.rpy:1505
translate brazilian c15s003_PickUpEileen_bbbe904d:

    # mc "¿Por qué no me lo iba a pedir?"
    mc "Por que ele não me perguntaria?"

# game/scripts/c15/c15.rpy:1507
translate brazilian c15s003_PickUpEileen_c74ce6f8:

    # eri "Porque no quiere molestar. Ayer estaba diciendo que éramos mucha gente en casa y que daban más trabajo del necesario."
    eri "Porque ela não quer incomodar ninguém. Ontem ela estava dizendo que havia gente demais em casa e que estávamos dando mais trabalho do que o necessário."

# game/scripts/c15/c15.rpy:1508
translate brazilian c15s003_PickUpEileen_eb3f3345:

    # eri "Ella no está segura del todo de que volver a casa, aunque sea esperando una semana, vaya a funcionar."
    eri "Ela não tem certeza se voltar para casa, mesmo que isso signifique esperar uma semana, vai funcionar."

# game/scripts/c15/c15.rpy:1509
translate brazilian c15s003_PickUpEileen_fedcf671:

    # eri "Ayer por la noche estuvimos hablando en la piscina. Me dijo que, si tenían que volver a irse, le pediría una habitación a Alexia. O incluso irse antes."
    eri "Estávamos conversando na piscina ontem à noite. Ele me disse que, se tivessem que ir embora de novo, pediria um quarto para a Alexia. Ou até mesmo sairia mais cedo."

# game/scripts/c15/c15.rpy:1510
translate brazilian c15s003_PickUpEileen_877143b9:

    # mc "Aprovecharé el viaje de vuelta a casa para quitarle esas tonterías de la cabeza."
    mc "Vou aproveitar a viagem de volta para casa para tirar essa bobagem da cabeça dele."

# game/scripts/c15/c15.rpy:1512
translate brazilian c15s003_PickUpEileen_86f7c213:

    # "Pasáis el resto del trayecto hablando del día anterior en la playa. No vale la pena seguir hablando del tema hasta no hablar con Eileen."
    "Você passa o resto da viagem falando sobre o dia anterior na praia. Não vale a pena continuar a conversa até que você tenha falado com Eileen."

# game/scripts/c15/c15.rpy:1515
translate brazilian c15s003_PickUpEileen_4a21f2ad:

    # mc "Buenas tardes, Eileen. ¿Acabas ya tu turno?"
    mc "Boa tarde, Eileen. Você já terminou seu turno?"

# game/scripts/c15/c15.rpy:1516
translate brazilian c15s003_PickUpEileen_d4a814c3:

    # eil "Hola, [eri] y [mc]. Sí, en dos minutos. Por fin. Ha sido un día de locos."
    eil "Olá, [eri] e [mc]. Sim, em dois minutos. Finalmente. Foi um dia louco."

# game/scripts/c15/c15.rpy:1517
translate brazilian c15s003_PickUpEileen_ed026424:

    # mc "Genial, entonces te llevo a casa, si quieres."
    mc "Ótimo, então eu te levo para casa, se você quiser."

# game/scripts/c15/c15.rpy:1519
translate brazilian c15s003_PickUpEileen_2699ad59:

    # eil "No hace falta que te molestes. No he tenido tiempo de comer nada y pensaba ir al Burger Prince a comer algo antes de volver. ¡Me muero de hambre!"
    eil "Não precisa se preocupar. Não tive tempo de comer nada e estava planejando ir ao Burger Prince para comer alguma coisa antes de voltar. Estou morrendo de fome!"

# game/scripts/c15/c15.rpy:1520
translate brazilian c15s003_PickUpEileen_5673d381:

    # mc "Pues si no te importa que te acompañe, al menos no comes sola. Yo ya he comido, pero sabes que los helados del Burger Prince siempre me han gustado."
    mc "Bom, se você não se importa que eu me junte a você, pelo menos você não vai comer sozinho. Eu já comi, mas você sabe que eu sempre gostei do sorvete do Burger Prince."

# game/scripts/c15/c15.rpy:1522
translate brazilian c15s003_PickUpEileen_7b11548e:

    # eil "¡Perfecto!"
    eil "Perfeito!"

# game/scripts/c15/c15.rpy:1525
translate brazilian c15s003_PickUpEileen_2de0b1b2:

    # eil "Antes de ir a cambiarme quiero un beso."
    eil "Antes de me trocar, quero um beijo."

# game/scripts/c15/c15.rpy:1526
translate brazilian c15s003_PickUpEileen_636c88b5:

    # eil "¡Ahora vuelvo! ¡Me muero de hambre! *Risa*"
    eil "Já volto! Estou morrendo de fome! *Risos*"

# game/scripts/c15/c15.rpy:1528
translate brazilian c15s003_PickUpEileen_645e5ca4:

    # eri "Bien jugado, [mc]. Mientras tiene la boca llena no puede discutir. *Risa*"
    eri "Muito bem jogado, [mc]. Ele não pode discutir com a boca cheia. *Risos*"

# game/scripts/c15/c15.rpy:1529
translate brazilian c15s003_PickUpEileen_84402b53:

    # mc "Tampoco es que quiera discutir. Quiero hacerle saber que ni ella ni Kiara molestan en casa."
    mc "Não é que eu queira discutir. Só quero que ela saiba que nem ela nem a Kiara incomodam em casa."

# game/scripts/c15/c15.rpy:1530
translate brazilian c15s003_PickUpEileen_26106c70:

    # eri "¿Quieres tomar algo mientras la esperas?"
    eri "Você gostaria de beber algo enquanto espera por ela?"

# game/scripts/c15/c15.rpy:1531
translate brazilian c15s003_PickUpEileen_2af0b3ac:

    # mc "No gracias, tengo que mantener la línea. *Risa*"
    mc "Não, obrigada, preciso cuidar da minha forma física. *Risos*"

# game/scripts/c15/c15.rpy:1537
translate brazilian c15s003_PickUpEileen_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c15/c15.rpy:1542
translate brazilian c15s003_PickUpEileen_85c55011:

    # eil "Ya estoy lista. ¿Nos vamos?"
    eil "Estou pronto. Vamos?"

# game/scripts/c15/c15.rpy:1543
translate brazilian c15s003_PickUpEileen_f6878a68:

    # mc "Cuando quieras."
    mc "Quando você quiser."

# game/scripts/c15/c15.rpy:1546
translate brazilian c15s003_PickUpEileen_7882f242:

    # mc "Te quiero."
    mc "Eu te amo."

# game/scripts/c15/c15.rpy:1547
translate brazilian c15s003_PickUpEileen_6253bdcd:

    # eri "Yo también te quiero."
    eri "Eu também te amo."

# game/scripts/c15/c15.rpy:1550
translate brazilian c15s003_PickUpEileen_00214848:

    # mc "Te recogemos cuando volvamos de casa de Eileen. Hasta luego."
    mc "Buscaremos você quando voltarmos da casa da Eileen. Até mais."

# game/scripts/c15/c15.rpy:1551
translate brazilian c15s003_PickUpEileen_ee01e3e3:

    # eri "Hasta luego."
    eri "Até mais."

# game/scripts/c15/c15.rpy:1554
translate brazilian c15s003_PickUpEileen_f8a69689:

    # eil "Se me hace extraño verte besar a [eri] delante mío."
    eil "É estranho ver você beijando [eri] na minha frente."

# game/scripts/c15/c15.rpy:1556
translate brazilian c15s003_PickUpEileen_78357846:

    # mc "¿Te molesta? También te beso a ti delante de ella..."
    mc "Isso te incomoda? Eu te beijo na frente dela também..."

# game/scripts/c15/c15.rpy:1558
translate brazilian c15s003_PickUpEileen_afd7fcb9:

    # eil "No, me refiero a todo lo contrario. Cuando nos lo contamos, creía que iba a haber rivalidad entre nosotras compitiendo por ti."
    eil "Não, eu quis dizer exatamente o oposto. Quando nos declaramos um para o outro, pensei que haveria rivalidade entre nós, uma competição por você."

# game/scripts/c15/c15.rpy:1559
translate brazilian c15s003_PickUpEileen_a9e9418d:

    # eil "Pero ha sido justo lo contrario. Nos ha hecho más amigas todavía. Casi todos los días que nos coinciden turnos nos lo pasamos hablando de ti."
    eil "Mas aconteceu exatamente o contrário. Nos tornou ainda mais amigas. Quase todos os dias nossos turnos se sobrepõem e passamos o tempo conversando sobre você."

# game/scripts/c15/c15.rpy:1560
translate brazilian c15s003_PickUpEileen_a21fdf91:

    # mc "*Risa* No sé si sentirme halagado o preocuparme."
    mc "*Risos* Não sei se me sinto lisonjeada ou preocupada."

# game/scripts/c15/c15.rpy:1562
translate brazilian c15s003_PickUpEileen_a4d94c1a:

    # eil "Nada de lo que preocuparte. Pero no sabía que me sentiría así con ella. Veo el bien que nos haces a las dos y no puedo evitar quererte más todavía."
    eil "Não precisa se preocupar. Mas eu não sabia que me sentiria assim por ela. Vejo o quanto você é boa para nós duas, e não consigo evitar de te amar ainda mais."

# game/scripts/c15/c15.rpy:1563
translate brazilian c15s003_PickUpEileen_79ac9ab9:

    # mc "Si sigues así me voy a ruborizar. *Risa*"
    mc "Se você continuar assim, vou ficar vermelha. *Risos*"

# game/scripts/c15/c15.rpy:1565
translate brazilian c15s003_PickUpEileen_eff545a9:

    # mc "¿Te molesta? No quisiera que te sintieras incómoda..."
    mc "Isso te incomoda? Eu não gostaria que você se sentisse desconfortável..."

# game/scripts/c15/c15.rpy:1567
translate brazilian c15s003_PickUpEileen_dc05f0be:

    # eil "No, me refiero a que cuando descubrí lo vuestro, creía que me iba a importar más. Después acepté que mi momento había pasado y era el suyo."
    eil "Não, o que eu quis dizer é que, quando descobri sobre vocês dois, pensei que isso teria mais importância para mim. Depois, aceitei que meu tempo havia passado e que agora era a vez de vocês."

# game/scripts/c15/c15.rpy:1568
translate brazilian c15s003_PickUpEileen_6e9418c3:

    # eil "Lo que se me hace raro es precisamente que no me moleste... Ahora hablamos de ti un montón."
    eil "O que eu acho estranho é justamente que isso não me incomoda... Agora falamos muito de você."

# game/scripts/c15/c15.rpy:1569
translate brazilian c15s003_PickUpEileen_a21fdf91_1:

    # mc "*Risa* No sé si sentirme halagado o preocuparme."
    mc "*Risos* Não sei se me sinto lisonjeada ou preocupada."

# game/scripts/c15/c15.rpy:1571
translate brazilian c15s003_PickUpEileen_2bda1052:

    # eil "Nada de lo que preocuparte. Me pregunta sobre qué hacíamos cuando estábamos juntos y esas cosas."
    eil "Não precisa se preocupar. Ele me pergunta sobre o que costumávamos fazer quando estávamos juntos e coisas assim."

# game/scripts/c15/c15.rpy:1572
translate brazilian c15s003_PickUpEileen_e90a2cc6:

    # eil "Si puedo ayudar a que la relación entre mi ex-novio y una de mis mejores amigas prospere, no tenéis más que pedirlo. Aún te quiero, aunque sea solo como amigo."
    eil "Se eu puder ajudar meu ex-namorado e uma das minhas melhores amigas a reatarem, é só pedir. Eu ainda te amo, mesmo que seja só como amiga."

# game/scripts/c15/c15.rpy:1573
translate brazilian c15s003_PickUpEileen_79ac9ab9_1:

    # mc "Si sigues así me voy a ruborizar. *Risa*"
    mc "Se você continuar assim, vou ficar vermelha. *Risos*"

# game/scripts/c15/c15.rpy:1575
translate brazilian c15s003_PickUpEileen_52b34a58:

    # "Unos minutos después, ya en el Burger Prince..."
    "Poucos minutos depois, já no Burger Prince..."

# game/scripts/c15/c15.rpy:1576
translate brazilian c15s003_PickUpEileen_adad4347:

    # eil "Si quieres puedes robarme UNA O DOS patatas. *Risa*"
    eil "Se quiser, pode roubar uma ou duas batatas minhas. *Risos*"

# game/scripts/c15/c15.rpy:1577
translate brazilian c15s003_PickUpEileen_a5075f5b:

    # mc "*Risa* No te preocupes. He comido mucho en casa y con el helado tengo de sobras. Además, la que me robaba patatas siempre eras tú."
    mc "*Risos* Não se preocupe. Eu já comi bastante em casa, e o sorvete é mais do que suficiente. Além disso, era você quem sempre roubava minhas batatas."

# game/scripts/c15/c15.rpy:1578
translate brazilian c15s003_PickUpEileen_3e91eda1:

    # eil "*Risa* Pero eso es porque estabas gordo y no quería que te engordaras más."
    eil "*Risos* Mas isso porque você era gordinha e eu não queria que você engordasse mais."

# game/scripts/c15/c15.rpy:1614
translate brazilian c15s003_LunchEileen_656360a7:

    # mc "¿Tienes ganas de volver a casa a por vuestras cosas?"
    mc "Você está ansioso para voltar para casa e pegar suas coisas?"

# game/scripts/c15/c15.rpy:1615
translate brazilian c15s003_LunchEileen_e51ec80d:

    # eil "Sobre todo, tengo ganas de coger mi bici. No me gusta coger el bus o depender de vosotros para que me traigáis al trabajo o me llevéis a casa."
    eil "O que mais me anima é andar de bicicleta. Não gosto de pegar ônibus nem de depender de você para me levar ao trabalho ou me buscar em casa."

# game/scripts/c15/c15.rpy:1616
translate brazilian c15s003_LunchEileen_7e63b1b6:

    # mc "Sabes que no es ninguna molestia, ¿verdad?"
    mc "Você sabe que não é nenhum incômodo, né?"

# game/scripts/c15/c15.rpy:1618
translate brazilian c15s003_LunchEileen_48d5d8fe:

    # eil "No, no lo sé. Sé que lo decís y que os ofrecéis a hacer de taxista para todas nosotras, pero sé que es una molestia."
    eil "Não, não sei. Sei que você diz isso e que se oferece para ser motorista de táxi para todos nós, mas sei que é um transtorno."

# game/scripts/c15/c15.rpy:1619
translate brazilian c15s003_LunchEileen_02e7aa1d:

    # eil "Vosotros tenéis cosas que hacer, una empresa que administrar. No podéis estar dejando de hacer vuestras cosas para llevarnos arriba o abajo."
    eil "Você tem coisas para fazer, uma empresa para administrar. Não pode negligenciar suas próprias responsabilidades para nos levar ao sucesso ou ao fracasso."

# game/scripts/c15/c15.rpy:1620
translate brazilian c15s003_LunchEileen_9e4e5a10:

    # mc "Eile, el dormitorio lo llevan entre [mar] y [nor]. Yo apenas hago nada. Si puedo ayudar haciendo que os sintáis más cómodas y llevándoos a los sitios, no es algo que me moleste hacer."
    mc "Eile, o quarto fica dividido entre [mar] e [nor]. Eu quase não faço nada. Se eu puder ajudar fazendo você se sentir mais confortável e te levando a lugares, não me importo de fazer isso."

# game/scripts/c15/c15.rpy:1622
translate brazilian c15s003_LunchEileen_7c0355d4:

    # eil "Pero es a eso a lo que me refiero. Que tengas que llevar a Kate o Lisa tiene cierta lógica. Son vuestras clientas, al fin y al cabo."
    eil "Mas é isso que eu quero dizer. Faz sentido que você tenha que trazer a Kate ou a Lisa. Afinal, elas são suas clientes."

# game/scripts/c15/c15.rpy:1623
translate brazilian c15s003_LunchEileen_add80054:

    # eil "Mi madre y yo somos poco más que una imposición. Nos hemos colado en vuestras vidas cuando más ocupados estáis."
    eil "Minha mãe e eu somos pouco mais que uma intrusão. Invadimos suas vidas justamente quando vocês estão mais ocupados."

# game/scripts/c15/c15.rpy:1624
translate brazilian c15s003_LunchEileen_e7332ea8:

    # mc "Y nosotros estamos contentos de que lo hayáis hecho."
    mc "E ficamos felizes que você tenha feito isso."

# game/scripts/c15/c15.rpy:1626
translate brazilian c15s003_LunchEileen_a19f17e5:

    # eil "Al menos solo serán unos días antes de que os dejemos tranquilos."
    eil "Pelo menos serão apenas alguns dias antes de deixarmos vocês em paz."

# game/scripts/c15/c15.rpy:1627
translate brazilian c15s003_LunchEileen_6915ef1f:

    # eil "O volvemos a casa o buscamos otra solución la semana que viene."
    eil "Ou voltamos para casa ou encontramos outra solução na próxima semana."

# game/scripts/c15/c15.rpy:1628
translate brazilian c15s003_LunchEileen_e72d62c5:

    # mc "O os quedáis en casa."
    mc "Ou você fica em casa."

# game/scripts/c15/c15.rpy:1630
translate brazilian c15s003_LunchEileen_1d3d794a:

    # eil "Mejor no, he hablado con Alexia y, ahora que su abuelo se ha ido, podríamos usar su habitación."
    eil "É melhor não, eu já falei com a Alexia e agora que o avô dela foi embora, podemos usar o quarto dela."

# game/scripts/c15/c15.rpy:1631
translate brazilian c15s003_LunchEileen_d08a3786:

    # mc "Y en su casa no seríais una imposición por alguna razón que desconozco, ¿verdad?"
    mc "E na casa deles você não seria um incômodo por algum motivo que eu desconheço, certo?"

# game/scripts/c15/c15.rpy:1633
translate brazilian c15s003_LunchEileen_61c7262a:

    # eil "¡Claro que lo seríamos! Pero vive en la ciudad, seríamos más independientes para movernos."
    eil "Claro que sim! Mas se você morasse na cidade, seríamos mais independentes e poderíamos nos locomover com mais facilidade."

# game/scripts/c15/c15.rpy:1634
translate brazilian c15s003_LunchEileen_1fefb2e8:

    # eil "Y ella no tiene que atender a una familia, invitadas y clientas. Además, nos dejaría ayudarle en casa, cosa que ni [mar] ni [nor] hacen."
    eil "E ela não precisa cuidar de família, hóspedes e clientes. Além disso, ela nos deixaria ajudá-la em casa, o que nem [mar] nem [nor] fazem."

# game/scripts/c15/c15.rpy:1635
translate brazilian c15s003_LunchEileen_c8486eb7:

    # mc "Si es por eso, ya hablaré con ellas para que os dejen colaborar. Si os vais a sentir más a gusto..."
    mc "Se for esse o motivo, conversarei com eles sobre a possibilidade de você colaborar. Se isso te deixar mais à vontade..."

# game/scripts/c15/c15.rpy:1637
translate brazilian c15s003_LunchEileen_fcfea6cb:

    # eil "No es solo eso, [mc]. Son muchas cosas. Ayer, en la comida... "
    eil "Não é só isso, [mc]. São muitas coisas. Ontem, no almoço..."

# game/scripts/c15/c15.rpy:1638
translate brazilian c15s003_LunchEileen_15b8e411:

    # mc "¿Qué pasó? ¿Alguien os hizo sentir mal?"
    mc "O que aconteceu? Alguém te fez sentir mal?"

# game/scripts/c15/c15.rpy:1639
translate brazilian c15s003_LunchEileen_de303d51:

    # eil "No, todo lo contrario... Hemos comido dos veces con tu familia... el día que llegamos y ayer..."
    eil "Não, muito pelo contrário... Jantamos com a sua família duas vezes... no dia em que chegamos e ontem..."

# game/scripts/c15/c15.rpy:1640
translate brazilian c15s003_LunchEileen_40382aa3:

    # mc "Con nuestra familia..."
    mc "Com nossa família..."

# game/scripts/c15/c15.rpy:1642
translate brazilian c15s003_LunchEileen_a8596415:

    # eil "¿Ves? Es a lo que me refiero... "
    eil "Entende? É isso que eu quero dizer..."

# game/scripts/c15/c15.rpy:1643
translate brazilian c15s003_LunchEileen_ef117816:

    # eil "Yo sé cómo funciona tu... la familia... pero mi madre no. Anoche estaba excitada con el día de playa... tenías que haberla oído hablar..."
    eil "Eu sei como funciona a sua família... mas a minha mãe não. Ontem à noite ela estava tão animada com o dia na praia... você devia ter ouvido o que ela disse..."

# game/scripts/c15/c15.rpy:1644
translate brazilian c15s003_LunchEileen_c84ea306:

    # mc "Pero eso es bueno, ¿no?"
    mc "Mas isso é bom, não é?"

# game/scripts/c15/c15.rpy:1646
translate brazilian c15s003_LunchEileen_8516f971:

    # eil "No, no lo es. Después de descubrir cómo es una familia de verdad... vamos a tener que volver a casa... a nuestra familia... si es que se le puede llamar así."
    eil "Não, não é. Depois de descobrir como é uma família de verdade... vamos ter que voltar para casa... para a nossa família... se é que podemos chamar aquilo de família."

# game/scripts/c15/c15.rpy:1647
translate brazilian c15s003_LunchEileen_3240139f:

    # eil "En casa mi madre tiene a su marido y yo a mi padre, pero mi madre está descubriendo que eso no nos convierte en familia."
    eil "Em casa, minha mãe tem o marido dela e eu tenho meu pai, mas minha mãe está descobrindo que isso não nos torna uma família."

# game/scripts/c15/c15.rpy:1648
translate brazilian c15s003_LunchEileen_65d9ae89:

    # eil "Y solo llevamos dos días en casa de [nor]. Cuando haya pasado la semana, volver a casa va a ser deprimente para mi madre, una vez se acostumbre a los Marks."
    eil "E só estamos na casa dos [nor] há dois dias. Quando a semana terminar, voltar para casa vai ser deprimente para minha mãe, depois que ela se acostumar com os Marks."

# game/scripts/c15/c15.rpy:1649
translate brazilian c15s003_LunchEileen_9b663313:

    # mc "Y crees que, si os vais a casa de Alexia, la cosa va a ser diferente, ¿verdad?"
    mc "E você acha que se for à casa da Alexia, as coisas serão diferentes, não é?"

# game/scripts/c15/c15.rpy:1651
translate brazilian c15s003_LunchEileen_94ddbcc7:

    # eil "En cierto modo, sí. Los Marks sois fantásticos, pero podéis ser un poco abrumadores. Y con toda la familia volcada en nosotras por el momento que estamos atravesando..."
    eil "De certa forma, sim. Vocês, Marks, são fantásticos, mas podem ser um pouco intensos. E com toda a família focada em nós por causa do que estamos passando..."

# game/scripts/c15/c15.rpy:1652
translate brazilian c15s003_LunchEileen_03856f93:

    # mc "Eile, en la comida de ayer en el merendero, ¿quién estaba?"
    mc "Eile, quem estava no almoço de ontem na área de piquenique?"

# game/scripts/c15/c15.rpy:1654
translate brazilian c15s003_LunchEileen_a088959b:

    # eil "La familia..."
    eil "A família..."

# game/scripts/c15/c15.rpy:1655
translate brazilian c15s003_LunchEileen_8a4eca21:

    # mc "Exacto. La familia. Nuestra familia. No solo los Marks. También estabais vosotras, las Lamb. Y las Washington, Samantha y Simone. Y las estudiantes. Y Alexia."
    mc "Exatamente. A família. Nossa família. Não só os Marks. Tinha vocês, Lambs, também. E os Washingtons, Samantha e Simone. E os alunos. E Alexia."

# game/scripts/c15/c15.rpy:1656
translate brazilian c15s003_LunchEileen_03715fd3:

    # mc "Y técnicamente mi Meemaw y Tía Betty no son Marks. *Risa*"
    mc "E tecnicamente, minha avó e minha tia Betty não são Marks. *Risos*"

# game/scripts/c15/c15.rpy:1657
translate brazilian c15s003_LunchEileen_280c1562:

    # mc "¿Estás diciendo que Alexia es menos familia que Samantha? ¿O que Debbie? ¿O que tú? Iros a casa de Alexia no os va a librar de la familia."
    mc "Você está dizendo que Alexia é menos família do que Samantha? Ou Debbie? Ou você? Ir à casa da Alexia não vai te afastar da família."

# game/scripts/c15/c15.rpy:1659
translate brazilian c15s003_LunchEileen_5e84dd4b:

    # eil "Pero no es lo mismo... veros todos los días hace que nos demos cuenta de lo que no tenemos en nuestras vidas."
    eil "Mas não é a mesma coisa... ver você todos os dias nos faz perceber o que não temos em nossas vidas."

# game/scripts/c15/c15.rpy:1660
translate brazilian c15s003_LunchEileen_e323172a:

    # mc "Podéis tenerlo si queréis, pero no si huis de nosotros."
    mc "Você pode ficar com isso se quiser, mas não se fugir de nós."

# game/scripts/c15/c15.rpy:1661
translate brazilian c15s003_LunchEileen_f0789d8b:

    # mc "[nor] ya os lo dijo. Podéis quedaros tanto tiempo como sea necesario."
    mc "[nor] Ele já te disse. Você pode ficar o tempo que precisar."

# game/scripts/c15/c15.rpy:1663
translate brazilian c15s003_LunchEileen_f6cb0b3b:

    # eil "Ya... mi madre está encantada... "
    eil "Sim... minha mãe está encantada..."

# game/scripts/c15/c15.rpy:1664
translate brazilian c15s003_LunchEileen_ee0cfb56:

    # eil "Ya te digo que estaba muy excitada con la comida de ayer..."
    eil "Eu te digo, eu estava realmente empolgado com a refeição de ontem..."

# game/scripts/c15/c15.rpy:1667
translate brazilian c15s003_LunchEileen_b7277ef8:

    # eil "Y con algo que pasó antes y que no me ha querido contar..."
    eil "E algo que aconteceu antes e que ela não quis me contar..."

# game/scripts/c15/c15.rpy:1668
translate brazilian c15s003_LunchEileen_3bcf4276:

    # mc "Bueno, pasó algo que la sorprendió, pero no es el momento de hablar de ello."
    mc "Bem, aconteceu algo que a surpreendeu, mas não é hora de falar sobre isso."

# game/scripts/c15/c15.rpy:1669
translate brazilian c15s003_LunchEileen_bcbb23ec:

    # mc "Lo importante para mí es que estuvo totalmente integrada con el resto de la familia. Y, como tú dices, solo lleváis dos días en casa."
    mc "O que é importante para mim é que ela esteja totalmente integrada ao resto da família. E, como você disse, você só está em casa há dois dias."

# game/scripts/c15/c15.rpy:1671
translate brazilian c15s003_LunchEileen_28a5bdc5:

    # eil "Y, como también he dicho, cuando pase la semana y tengamos que volver a casa, puede ser deprimente para ella. Parece que solo escuchas lo que quieres escuchar. *Risa*"
    eil "E, como eu também já disse, quando a semana acaba e temos que voltar para casa, isso pode ser deprimente para ela. Parece que a gente só ouve o que quer ouvir. *Risos*"

# game/scripts/c15/c15.rpy:1672
translate brazilian c15s003_LunchEileen_619087d4:

    # mc "Siempre buscando el lado bueno de la vida, ¿no? *Risa*"
    mc "Você sempre vê o lado bom da vida, não é? *Risos*"

# game/scripts/c15/c15.rpy:1673
translate brazilian c15s003_LunchEileen_96c62fff:

    # mc "Pero no hacemos más que hablar de Kiara. ¿Cómo estás tú en casa?"
    mc "Mas só falamos da Kiara. Como você está em casa?"

# game/scripts/c15/c15.rpy:1675
translate brazilian c15s003_LunchEileen_a74528bb:

    # eil "¿Cómo quieres que esté? Genial, tu familia... la familia... siempre me ha gustado. Vivirlo desde dentro es alucinante."
    eil "Como você quer que eu seja? Ótimo, sua família... família... Eu sempre adorei. Experimentá-la por dentro é incrível."

# game/scripts/c15/c15.rpy:1677
translate brazilian c15s003_LunchEileen_ba75ff18:

    # eil "Y saber que estamos juntos y que puede que un día también sea mi familia... mi familia de verdad... es increíble."
    eil "E saber que estamos juntos e que talvez um dia vocês também sejam minha família... minha verdadeira família... é incrível."

# game/scripts/c15/c15.rpy:1679
translate brazilian c15s003_LunchEileen_480cda9a:

    # eil "Aunque saber que ya no estamos juntos y que nunca va a ser mi familia... mi familia de verdad... es un poco raro, pero no deja de ser increíble."
    eil "Embora saber que não estamos mais juntos e que eles nunca serão minha família... minha verdadeira família... seja um pouco estranho, ainda assim é incrível."

# game/scripts/c15/c15.rpy:1680
translate brazilian c15s003_LunchEileen_29e1d82f:

    # mc "Ya es tu familia de verdad. Pregúntale a cualquiera de las chicas y verás que te ven como a una hermana o prima más."
    mc "Elas são como família para você agora. Pergunte a qualquer uma das meninas e você verá que elas te tratam como uma irmã ou prima."

# game/scripts/c15/c15.rpy:1682
translate brazilian c15s003_LunchEileen_4fc1f4b7:

    # eil "Lo sé... especialmente [emm] y [eri]..."
    eil "Eu sei... especialmente [emm] e [eri]..."

# game/scripts/c15/c15.rpy:1683
translate brazilian c15s003_LunchEileen_b7ebfda9:

    # mc "Hablando de [emm]... tengo que pedirte un favor..."
    mc "Falando em [emm]... preciso te pedir um favor..."

# game/scripts/c15/c15.rpy:1684
translate brazilian c15s003_LunchEileen_0f7c3336:

    # eil "Dime..."
    eil "Diga-me..."

# game/scripts/c15/c15.rpy:1685
translate brazilian c15s003_LunchEileen_11a7a1f9:

    # mc "¿Se te ocurre cómo puedo sacar de casa a [emm], [dap], Meemaw y Betty esta tarde? Necesitaría que estuvieran fuera de 5 a 6 de la tarde."
    mc "Você consegue pensar em uma maneira de eu tirar [emm], [dap], Meemaw e Betty de casa esta tarde? Eu precisaria que elas saíssem entre 17h e 18h."

# game/scripts/c15/c15.rpy:1687
translate brazilian c15s003_LunchEileen_4d128773:

    # eil "¿Puedo saber por qué o es otro de tus secretos?"
    eil "Posso saber o porquê, ou isso é mais um dos seus segredos?"

# game/scripts/c15/c15.rpy:1688
translate brazilian c15s003_LunchEileen_215a602e:

    # mc "Vamos a recibir unas visitas por un tema de negocios. Y nos han pedido que estemos solo mi madre, [nor], y yo."
    mc "Estamos esperando alguns visitantes a negócios. Eles pediram que apenas minha mãe, [nor], e eu estivéssemos presentes."

# game/scripts/c15/c15.rpy:1690
translate brazilian c15s003_LunchEileen_dbd48779:

    # eil "¿No sería más lógico pedirles que no entren dónde sea que vayáis a tener la reunión?"
    eil "Não seria mais lógico pedir que eles não entrassem no local onde a reunião está sendo realizada?"

# game/scripts/c15/c15.rpy:1691
translate brazilian c15s003_LunchEileen_a2c24c7c:

    # mc "Es más complicado que todo eso, Eile."
    mc "É mais complicado do que tudo isso, Eile."

# game/scripts/c15/c15.rpy:1693
translate brazilian c15s003_LunchEileen_de82b92e:

    # eil "No te preocupes. Ayer, hablando con Betty, me dijo que tenía que comprarse ropa. Olivia seguramente la querrá acompañar, y no será difícil convencer a [emm] y a [dap] para que vengan también."
    eil "Não se preocupe. Ontem, quando eu estava conversando com a Betty, ela me disse que precisava comprar algumas roupas. A Olivia com certeza vai querer ir com ela, e não será difícil convencer a [emm] e a [dap] a irem também."

# game/scripts/c15/c15.rpy:1694
translate brazilian c15s003_LunchEileen_d0881f87:

    # eil "Si me dejas el coche, les puedo llevar a un par de tiendas de ropa y después ir a tomar algo para daros tiempo de que acabéis la reunión."
    eil "Se você me emprestar o carro, posso te levar a algumas lojas de roupa e depois ir tomar um drinque para te dar tempo de terminar a reunião."

# game/scripts/c15/c15.rpy:1695
translate brazilian c15s003_LunchEileen_5ff1fa81:

    # mc "Gracias, Eile."
    mc "Obrigada, Eile."

# game/scripts/c15/c15.rpy:1697
translate brazilian c15s003_LunchEileen_684e2887:

    # eil "No hay de qué. Para eso está la familia. *Risa*"
    eil "De nada. É para isso que serve a família. *Risos*"

# game/scripts/c15/c15.rpy:1698
translate brazilian c15s003_LunchEileen_ea034722:

    # eil "¿Voy al lavabo y nos vamos? Tengo que convencerlas de ir a comprar ropa... *Risa* ¿Qué tipo de ropa usa una monja en su tiempo libre?"
    eil "Devo ir ao banheiro e depois podemos ir? Preciso convencê-las a ir comprar roupas... *Risos* Que tipo de roupa uma freira usa no tempo livre?"

# game/scripts/c15/c15.rpy:1699
translate brazilian c15s003_LunchEileen_ad564295:

    # mc "No tengo ni idea, pero Betty parece vestir bastante normal. *Risa* Te espero aquí."
    mc "Não faço ideia, mas a Betty parece se vestir normalmente. *Risos* Vou te esperar aqui."

# game/scripts/c15/c15.rpy:1701
translate brazilian c15s003_LunchEileen_08c017ee:

    # "Te dispones a esperar a Eileen cuando oyes una conversación en una mesa a tu espalda."
    "Você está prestes a esperar por Eileen quando ouve uma conversa em uma mesa atrás de você."

# game/scripts/c15/c15.rpy:1702
translate brazilian c15s003_LunchEileen_e32c891a:

    # "No puedes evitar escucharla. No habla alto, pero el local está prácticamente vacío."
    "É impossível não ouvi-la. Ela não fala alto, mas o lugar está praticamente vazio."

# game/scripts/c15/c15.rpy:1703
translate brazilian c15s003_LunchEileen_1b99a9fd:

    # "Hombre al teléfono" "... lo sé, hermanita, lo sé. Lo último que desearía sería hacerle daño..."
    "Hombre al teléfono" "Eu sei, maninha, eu sei. A última coisa que eu quero é te magoar..."

# game/scripts/c15/c15.rpy:1704
translate brazilian c15s003_LunchEileen_e025db26:

    # "Hombre al teléfono" "No, no creo que sienta nada por mí ahora mismo, apenas nos conocemos. Yo nos definiría con amigos con posibilidades de llegar a algo más."
    "Hombre al teléfono" "Não, acho que ela não sente nada por mim agora; mal nos conhecemos. Eu diria que somos amigos com potencial para algo mais."

# game/scripts/c15/c15.rpy:1705
translate brazilian c15s003_LunchEileen_083722c9:

    # "Hombre al teléfono" "Pero no consigo sentir nada por ella. Es una chica fantástica... deberías haberla visto el otro día..."
    "Hombre al teléfono" "Mas não consigo sentir nada por ela. Ela é uma garota fantástica... você devia tê-la visto outro dia..."

# game/scripts/c15/c15.rpy:1706
translate brazilian c15s003_LunchEileen_79ee7506:

    # "Hombre al teléfono" "Y sé que ahora me deberían gustar las chicas... pero no lo consigo..."
    "Hombre al teléfono" "E eu sei que deveria gostar de garotas agora... mas não consigo..."

# game/scripts/c15/c15.rpy:1707
translate brazilian c15s003_LunchEileen_2b0e9ace:

    # "Hombre al teléfono" "Sí, también lo sé... ¿Soy raro, Olga?"
    "Hombre al teléfono" "Sim, eu também sei disso... Sou estranha, Olga?"

# game/scripts/c15/c15.rpy:1708
translate brazilian c15s003_LunchEileen_2c9ed693:

    # "Hombre al teléfono" "¡Qué fácil es para ti decirlo! Para hacerlo más complicado todavía, hace unos días conocí a un chico..."
    "Hombre al teléfono" "Como é fácil para você dizer isso! Para complicar ainda mais as coisas, há alguns dias conheci um cara..."

# game/scripts/c15/c15.rpy:1709
translate brazilian c15s003_LunchEileen_3e084095:

    # "Hombre al teléfono" "No, no ha pasado nada... solo hemos hablado un par de veces... pero me atrae..."
    "Hombre al teléfono" "Não, não aconteceu nada... só conversamos algumas vezes... mas eu me sinto atraída por ele..."

# game/scripts/c15/c15.rpy:1710
translate brazilian c15s003_LunchEileen_0cfef5d5:

    # "La conversación se va alejando de ti, como si el hombre se estuviera marchando del Burger Prince."
    "A conversa se distancia de você, como se o homem estivesse saindo do Burger Prince."

# game/scripts/c15/c15.rpy:1711
translate brazilian c15s003_LunchEileen_1f2707f9:

    # "Hombre al teléfono" "Ser alguien como yo en una ciudad como esta... es complicado... Si estuviera en San Francisco contigo... sería diferente..."
    "Hombre al teléfono" "Ser alguém como eu numa cidade como esta... é complicado... Se eu estivesse em São Francisco com você... seria diferente..."

# game/scripts/c15/c15.rpy:1712
translate brazilian c15s003_LunchEileen_21a8671b:

    # "Empiezas a sentir curiosidad por saber quién está hablando. La voz te resulta familiar, pero no la ubicas."
    "Você começa a sentir curiosidade para saber quem está falando. A voz parece familiar, mas você não consegue se lembrar de onde a conhece."

# game/scripts/c15/c15.rpy:1717
translate brazilian c15s003_LunchEileen_6806f90f:

    # "Te giras justo a tiempo de ver como sale del restaurante mientras habla."
    "Você se vira bem a tempo de vê-lo sair do restaurante enquanto ainda está falando."

# game/scripts/c15/c15.rpy:1718
translate brazilian c15s003_LunchEileen_25dcca5b:

    # mcp "(¿Ese es Anthony? No le he podido ver la cara, pero la voz...)"
    mcp "(É o Anthony? Não consegui ver o rosto dele, mas reconheci a voz...)"

# game/scripts/c15/c15.rpy:1720
translate brazilian c15s003_LunchEileen_c186e998:

    # mcp "(No debería meterme en los asuntos de los demás. Suficiente tengo con todo lo que tengo entre manos.)"
    mcp "(Não devo me intrometer na vida alheia. Já tenho problemas suficientes."

# game/scripts/c15/c15.rpy:1722
translate brazilian c15s003_LunchEileen_b0334eba:

    # "Tras unos minutos más, Eileen vuelve del lavabo."
    "Após mais alguns minutos, Eileen retorna do banheiro."

# game/scripts/c15/c15.rpy:1723
translate brazilian c15s003_LunchEileen_0a4afa4b:

    # eil "¿Nos vamos? Quiero enseñarte algo que encontré en el bosque antes de irnos a casa y tener que llevar a las chicas de compras."
    eil "Vamos? Quero te mostrar uma coisa que encontrei na floresta antes de irmos para casa, e eu tenho que levar as meninas para fazer compras."

# game/scripts/c15/c15.rpy:1724
translate brazilian c15s003_LunchEileen_f3186348:

    # mc "¿Qué encontraste?"
    mc "O que você descobriu?"

# game/scripts/c15/c15.rpy:1725
translate brazilian c15s003_LunchEileen_35249c2d:

    # eil "Me tendrás que llevar allí para enseñártelo. Ya te indicaré dónde tienes que parar."
    eil "Você vai ter que me levar lá para que eu possa te mostrar. Eu te direi onde parar."

# game/scripts/c15/c15.rpy:1726
translate brazilian c15s003_LunchEileen_dd819fac:

    # mc "Entonces vamos."
    mc "Então vamos lá."

# game/scripts/c15/c15.rpy:1780
translate brazilian c15s004_LewdEileen_06d9040c:

    # "Cuando estáis a unos minutos de casa, Eileen te indica que pares en el arcén de la carretera y que la sigas al interior del bosque."
    "Quando você estiver a poucos minutos de casa, Eileen lhe dirá para parar no acostamento da estrada e segui-la até a floresta."

# game/scripts/c15/c15.rpy:1783
translate brazilian c15s004_LewdEileen_d6ec8a34:

    # eil "Aquí está."
    eil "Aqui está."

# game/scripts/c15/c15.rpy:1784
translate brazilian c15s004_LewdEileen_a1f7c898:

    # mc "¿Un columpio?"
    mc "Um balanço?"

# game/scripts/c15/c15.rpy:1786
translate brazilian c15s004_LewdEileen_b5c9f5b8:

    # eil "Sí, es un columpio, no una nave espacial. *Risa* Lo vi hace unos días cuando salí a correr y me acordé de aquel que había detrás de tu casa."
    eil "Sim, é um balanço, não uma nave espacial. *Risos* Eu o vi há alguns dias quando fui correr e me lembrei daquele que fica atrás da sua casa."

# game/scripts/c15/c15.rpy:1787
translate brazilian c15s004_LewdEileen_2ab45146:

    # mc "Pero aquel tenía un neumático en vez de una tabla. Lo hizo el Tío Mike poco antes de morir. Tía [nor] cambió la cuerda varias veces mientras las chicas crecían."
    mc "Mas aquela tinha um pneu em vez de uma tábua. O tio Mike a fez pouco antes de morrer. A tia [nor] trocou a corda várias vezes conforme as meninas cresciam."

# game/scripts/c15/c15.rpy:1788
translate brazilian c15s004_LewdEileen_adfa564d:

    # mc "Debería montar uno igual que aquel, creo que a las chicas les gustaría."
    mc "Eu devia montar uma igualzinha àquela, acho que as meninas iam gostar."

# game/scripts/c15/c15.rpy:1789
translate brazilian c15s004_LewdEileen_b96d68e2:

    # mc "¿Sabes a quién pertenece este?"
    mc "Você sabe a quem pertence isto?"

# game/scripts/c15/c15.rpy:1791
translate brazilian c15s004_LewdEileen_3b485f52:

    # eil "No tengo ni idea. Creo que esto es terreno municipal, con lo que no será de nadie. Lo habrán construido unos críos."
    eil "Não faço ideia. Acho que este terreno é municipal, então provavelmente não pertence a ninguém. Algumas crianças devem tê-lo construído."

# game/scripts/c15/c15.rpy:1792
translate brazilian c15s004_LewdEileen_7d0dba18:

    # mc "Seguro que sí."
    mc "Com certeza, sim."

# game/scripts/c15/c15.rpy:1795
translate brazilian c15s004_LewdEileen_f5906a66:

    # eil "Hablando de críos... tengo unas ganas enormes de que llegue la semana que viene..."
    eil "Falando em crianças... Estou realmente ansiosa pela próxima semana..."

# game/scripts/c15/c15.rpy:1796
translate brazilian c15s004_LewdEileen_13f4d24b:

    # mc "¿Por qué? No lo entiendo..."
    mc "Por quê? Não entendo..."

# game/scripts/c15/c15.rpy:1798
translate brazilian c15s004_LewdEileen_21c3d3e3:

    # eil "El tiempo de espera para la prueba de embarazo..."
    eil "O tempo de espera para um teste de gravidez..."

# game/scripts/c15/c15.rpy:1799
translate brazilian c15s004_LewdEileen_d9e04079:

    # mc "¿Todavía tienes molestias?"
    mc "Você ainda está sentindo desconforto?"

# game/scripts/c15/c15.rpy:1801
translate brazilian c15s004_LewdEileen_586112dc:

    # eil "Sí, y cada vez van a más. No solo son los pezones sensibles... llevo una semana sin poderme poner un sujetador si no es deportivo...."
    eil "Sim, e está piorando. Não são apenas os mamilos sensíveis... Faz uma semana que não consigo usar sutiã, a não ser que seja um sutiã esportivo..."

# game/scripts/c15/c15.rpy:1802
translate brazilian c15s004_LewdEileen_a943a11a:

    # eil "Esta mañana he vomitado... pero podría ser porque ayer comí demasiado también... Me estoy volviendo paranoica y a todo le veo un significado."
    eil "Vomitei esta manhã... mas pode ser porque comi demais ontem também... Estou ficando paranoico, agora vejo sentido em tudo."

# game/scripts/c15/c15.rpy:1803
translate brazilian c15s004_LewdEileen_dd3afa54:

    # mc "¿Pero tú te encuentras bien? ¿Puedes seguir trabajando? ¿Cuándo te dijeron que te podías hacer la prueba?"
    mc "Mas você está se sentindo bem? Consegue continuar trabalhando? Quando te disseram que você poderia fazer o teste?"

