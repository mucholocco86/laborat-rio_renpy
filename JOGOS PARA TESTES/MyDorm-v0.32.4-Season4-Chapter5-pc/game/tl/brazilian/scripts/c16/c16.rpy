translate brazilian c16s003_ShootingLessons_79582e9b:

    # mc "Hasta la cena, Amanda."
    mc "Te vejo no jantar, Amanda."

# game/scripts/c16/c16.rpy:2245
translate brazilian c16s003_ShootingLessons_1363b7d9:

    # eva "Amanda estaba bromeando..."
    eva "Amanda estava brincando..."

# game/scripts/c16/c16.rpy:2246
translate brazilian c16s003_ShootingLessons_10febebe:

    # mc "Sí, ya me lo imagino. Como tú el día que te disfrazaste de [eri]..."
    mc "Sim, consigo imaginar. Como você no dia em que se vestiu de [eri]..."

# game/scripts/c16/c16.rpy:2248
translate brazilian c16s003_ShootingLessons_adc67db5:

    # eva "Sobre eso..."
    eva "Sobre isso..."

# game/scripts/c16/c16.rpy:2249
translate brazilian c16s003_ShootingLessons_3def96d5:

    # mc "¿Por qué no hablamos sobre eso cuando bajemos? Se nos va a hacer tarde para aprender a disparar."
    mc "Por que não conversamos sobre isso quando chegarmos lá? Vamos nos atrasar para aprender a atirar."

# game/scripts/c16/c16.rpy:2250
translate brazilian c16s003_ShootingLessons_27820783:

    # mc "Aunque no me importará si tenemos que hacer varias lecciones. Y no {b}solo{/b} por lo que ha dicho Amanda."
    mc "Embora eu não me importasse se tivéssemos que fazer várias aulas. E não apenas por causa do que Amanda disse."

# game/scripts/c16/c16.rpy:2252
translate brazilian c16s003_ShootingLessons_87ff4708:

    # eva "¡Me parece genial! ¡Vamos! Ya estamos llegando."
    eva "Isso parece ótimo! Vamos lá! Já estamos quase lá."

# game/scripts/c16/c16.rpy:2253
translate brazilian c16s003_ShootingLessons_c9b98326:

    # mc "Las damas primero."
    mc "As damas primeiro."

# game/scripts/c16/c16.rpy:2255
translate brazilian c16s003_ShootingLessons_540f7bd2:

    # "Llegáis al \"campo de tiro\" y Eva te lo muestra orgullosa."
    "Você chega ao \"campo de tiro\" e Eva o mostra orgulhosamente para você."

# game/scripts/c16/c16.rpy:2256
translate brazilian c16s003_ShootingLessons_71da2111:

    # eva "He traído unas latas y unos botes. No me gustan las botellas, si llegas a darles no son reutilizables. Además, algún animal se podría cortar con los cristales."
    eva "Trouxe algumas latas e potes. Não gosto de garrafas; se você as der para os animais, elas não serão reutilizáveis. Além disso, alguns animais podem se cortar no vidro."

# game/scripts/c16/c16.rpy:2257
translate brazilian c16s003_ShootingLessons_1e566a4d:

    # mc "Me gusta descubrir esa faceta de ti, Eva. No me imaginaba que te preocuparan los animales del bosque."
    mc "Gosto de descobrir esse seu lado, Eva. Nunca imaginei que você se importasse com os animais da floresta."

# game/scripts/c16/c16.rpy:2259
translate brazilian c16s003_ShootingLessons_ba2328f7:

    # eva "¿Preocupada por los animales? ¿Yo?"
    eva "Preocupado com os animais? Eu?"

# game/scripts/c16/c16.rpy:2260
translate brazilian c16s003_ShootingLessons_a795668c:

    # eva "Es que... si algún animal se hiriese en una pata... mmmm.... dejaría un rastro de sangre... sí, exactamente eso..."
    eva "Bem... se um animal machucasse a pata... hum... deixaria um rastro de sangue... sim, exatamente isso..."

# game/scripts/c16/c16.rpy:2261
translate brazilian c16s003_ShootingLessons_69dbaf90:

    # eva "Y podría ponérmelo más difícil si alguna vez... no sé... tengo que seguir la pista a uno de mis objetivos a los que haya herido... Sí. Es por eso."
    eva "E isso poderia tornar as coisas ainda mais difíceis para mim se eu... sei lá... tivesse que rastrear um dos meus alvos que eu machuquei... Sim. É por isso."

# game/scripts/c16/c16.rpy:2263
translate brazilian c16s003_ShootingLessons_51dbdf0d:

    # eva "*Mascullando* Como que uno de mis objetivos iba a poder andar si le disparo..."
    eva "*Resmungando* Como se um dos meus alvos fosse capaz de andar se eu atirasse nele..."

# game/scripts/c16/c16.rpy:2264
translate brazilian c16s003_ShootingLessons_5afb7f67:

    # mc "Vale. Fingiré que te creo. *Risa*"
    mc "Ok. Vou fingir que acredito em você. *Risos*"

# game/scripts/c16/c16.rpy:2265
translate brazilian c16s003_ShootingLessons_709983fe:

    # mc "¿Empezamos a disparar?"
    mc "Vamos começar a filmar?"

# game/scripts/c16/c16.rpy:2267
translate brazilian c16s003_ShootingLessons_78a959a1:

    # eva "¡No! Primero la clase teórica. Tienes que aprenderte las cinco leyes de las armas de fuego."
    eva "Não! Primeiro, a aula teórica. Você precisa aprender as cinco leis das armas de fogo."

# game/scripts/c16/c16.rpy:2268
translate brazilian c16s003_ShootingLessons_0afa9162:

    # mc "¿Una clase sobre leyes?"
    mc "Uma aula de direito?"

# game/scripts/c16/c16.rpy:2270
translate brazilian c16s003_ShootingLessons_d1c5adfa:

    # eva "No, idiota. *Risa* Es sobre cómo usar un arma y lo que nunca debes hacer con ella."
    eva "Não, idiota. *Risos* É sobre como usar uma arma e o que você nunca deve fazer com ela."

# game/scripts/c16/c16.rpy:2271
translate brazilian c16s003_ShootingLessons_e0ce829f:

    # mc "Ah, vale. ¿Tipo \"nunca mires por el cañón de un arma\" y cosas así?"
    mc "Ah, entendi. Tipo \"nunca olhe para o cano de uma arma\" e coisas do tipo?"

# game/scripts/c16/c16.rpy:2272
translate brazilian c16s003_ShootingLessons_7ad5a606:

    # eva "Esa es solo para idiotas. Para ti van a ser las cinco leyes básicas. *Risa* Bueno seis."
    eva "Isso é coisa de idiota. Para você, serão as cinco leis básicas. *Risos* Bem, seis."

# game/scripts/c16/c16.rpy:2273
translate brazilian c16s003_ShootingLessons_42ce3c2b:

    # mc "Adelante. Soy todo oídos."
    mc "Pode falar. Estou todo ouvidos."

# game/scripts/c16/c16.rpy:2275
translate brazilian c16s003_ShootingLessons_a9dc3613:

    # eva "Uno. Nunca apuntes tu arma a algo a lo que no tengas intención de dispararle."
    eva "Primeiro. Nunca aponte sua arma para algo que você não pretende atingir."

# game/scripts/c16/c16.rpy:2276
translate brazilian c16s003_ShootingLessons_30aa421a:

    # mc "O lo que es lo mismo, no juegues con ella."
    mc "Ou seja, não se meta com ela."

# game/scripts/c16/c16.rpy:2277
translate brazilian c16s003_ShootingLessons_02b71c6e:

    # eva "Exacto. Te sorprendería la cantidad de civiles que os matáis en accidentes idiotas."
    eva "Exatamente. Você ficaria surpreso com a quantidade de civis que matamos em acidentes estúpidos."

# game/scripts/c16/c16.rpy:2278
translate brazilian c16s003_ShootingLessons_d3381c5a:

    # eva "Dos. No acerques tu dedo al gatillo hasta que estés listo para disparar."
    eva "Segundo. Não coloque o dedo perto do gatilho até estar pronto para atirar."

# game/scripts/c16/c16.rpy:2279
translate brazilian c16s003_ShootingLessons_0c9a95d1:

    # mc "Una buena forma de evitar accidentes."
    mc "Uma boa maneira de evitar acidentes."

# game/scripts/c16/c16.rpy:2281
translate brazilian c16s003_ShootingLessons_1ffae699:

    # eva "Las leyes para ti acaban de convertirse en siete."
    eva "As leis que regem você agora são sete."

# game/scripts/c16/c16.rpy:2283
translate brazilian c16s003_ShootingLessons_1e5248f2:

    # eva "Tres. Sé consciente de tu objetivo y de lo que hay más allá."
    eva "Três. Tenha consciência do seu objetivo e do que está além dele."

# game/scripts/c16/c16.rpy:2284
translate brazilian c16s003_ShootingLessons_a7be44d7:

    # mc "No te entiendo."
    mc "Não entendo você."

# game/scripts/c16/c16.rpy:2286
translate brazilian c16s003_ShootingLessons_dcc952f3:

    # eva "Una bala va en línea recta. Realmente no, pero para el ejemplo piensa que sí. Tienes que saber dónde está tu objetivo, pero también que pasa más allá de él."
    eva "Uma bala viaja em linha reta. Bem, não exatamente, mas para fins deste exemplo, vamos considerar que sim. Você precisa saber onde está o seu alvo, mas também o que está além dele."

# game/scripts/c16/c16.rpy:2287
translate brazilian c16s003_ShootingLessons_f3af7099:

    # eva "No quieres que, si fallas o la bala atraviesa el objetivo, haya una niña pequeña detrás a la que puedas matar, ¿verdad? O a [dap]. O a mí."
    eva "Você não quer uma garotinha atrás de você que você possa matar se errar o alvo ou se a bala atravessar o alvo, quer? Ou [dap]. Ou eu."

# game/scripts/c16/c16.rpy:2288
translate brazilian c16s003_ShootingLessons_e9602af6:

    # mc "Tienes razón, no se me habría ocurrido nunca. Sigue, por favor."
    mc "Você tem razão, eu jamais teria pensado nisso. Por favor, continue."

# game/scripts/c16/c16.rpy:2290
translate brazilian c16s003_ShootingLessons_34b79ed1:

    # eva "Cuatro. Nunca bebas alcohol o consumas drogas antes de disparar o mientras lo haces."
    eva "Quatro. Nunca consuma álcool ou drogas antes ou durante as filmagens."

# game/scripts/c16/c16.rpy:2291
translate brazilian c16s003_ShootingLessons_6bec7215:

    # mc "Esa tiene lógica."
    mc "Faz sentido."

# game/scripts/c16/c16.rpy:2292
translate brazilian c16s003_ShootingLessons_31216bdc:

    # eva "Cinco. Manipula cualquier arma como si estuviera cargada."
    eva "Cinco. Manuseie qualquer arma como se estivesse carregada."

# game/scripts/c16/c16.rpy:2293
translate brazilian c16s003_ShootingLessons_02112f7a:

    # mc "También es lógica."
    mc "Também é lógico."

# game/scripts/c16/c16.rpy:2295
translate brazilian c16s003_ShootingLessons_bdf9310d:

    # eva "Ahora llegan las específicas para ti."
    eva "Agora, aqueles feitos especialmente para você estão chegando."

# game/scripts/c16/c16.rpy:2296
translate brazilian c16s003_ShootingLessons_a250f8e2:

    # mc "¿Algo sobre cómo disparar desde la terraza o algo así?"
    mc "Tem alguma coisa sobre filmar do terraço ou algo parecido?"

# game/scripts/c16/c16.rpy:2297
translate brazilian c16s003_ShootingLessons_f362f41f:

    # eva "Seis: Siempre sé puntual cuando quedes con alguien. Especialmente si lo has pedido tú."
    eva "Seis: Seja sempre pontual quando encontrar alguém. Principalmente se você foi quem fez o convite."

# game/scripts/c16/c16.rpy:2298
translate brazilian c16s003_ShootingLessons_a1e21fce:

    # eva "Y más especialmente todavía cuando ese alguien esté armado."
    eva "E ainda mais quando essa pessoa está armada."

# game/scripts/c16/c16.rpy:2299
translate brazilian c16s003_ShootingLessons_e4c61d0d:

    # mc "Eva, lo siento..."
    mc "Eva, me desculpe..."

# game/scripts/c16/c16.rpy:2301
translate brazilian c16s003_ShootingLessons_ebc8279d:

    # eva "¡Hush!"
    eva "Silêncio!"

# game/scripts/c16/c16.rpy:2302
translate brazilian c16s003_ShootingLessons_d0074ed3:

    # eva "Siete: Cuando te esté instruyendo puedes hacer preguntas, pero te puedes ahorrar los comentarios obvios."
    eva "Sete: Quando ele estiver lhe dando instruções, você pode fazer perguntas, mas evite fazer comentários óbvios."

# game/scripts/c16/c16.rpy:2304
translate brazilian c16s003_ShootingLessons_093731fb:

    # eva "Ini bini firmi di ivitir iccidintis..."
    eva "Ini bini firmi di ivitir iccidintis..."

# game/scripts/c16/c16.rpy:2306
translate brazilian c16s003_ShootingLessons_0cab2a59:

    # eva "Eso sobra. Claro que es por eso. Por eso te estoy enseñando. Pero no puedes estar callado un segundo."
    eva "Isso é desnecessário. Claro que é por isso. É por isso que estou te ensinando. Mas você não pode ficar em silêncio nem por um segundo."

# game/scripts/c16/c16.rpy:2307
translate brazilian c16s003_ShootingLessons_2529e0cb:

    # mc "Lo siento, Eva. No quería interrumpirte. Tan solo quería saber la lógica detrás de cada ley."
    mc "Desculpe, Eva. Não queria interromper. Eu só queria entender a lógica por trás de cada lei."

# game/scripts/c16/c16.rpy:2309
translate brazilian c16s003_ShootingLessons_267d8b68:

    # eva "Vale. Si tienes dudas, pregunta. No hagas comentarios."
    eva "Certo. Se tiverem alguma dúvida, perguntem. Não façam comentários."

# game/scripts/c16/c16.rpy:2310
translate brazilian c16s003_ShootingLessons_55120abd:

    # mc "¡A sus órdenes! *Risa*"
    mc "Às suas ordens! *Risos*"

# game/scripts/c16/c16.rpy:2312
translate brazilian c16s003_ShootingLessons_0fee774d:

    # eva "*Risa* ¡Y déjate de payasadas! No soy tu superior en rango."
    eva "*Risos* E pare com essa palhaçada! Eu não sou seu superior hierárquico."

# game/scripts/c16/c16.rpy:2313
translate brazilian c16s003_ShootingLessons_68a61123:

    # eva "Vamos a por las armas. Hoy dispararás con pistola y con balas de práctica. Tienen menos potencia y no expulsa el casquillo automáticamente."
    eva "Vamos falar das armas. Hoje vocês vão atirar com uma pistola e munição de treino. Elas têm menos potência e não ejetam o cartucho automaticamente."

# game/scripts/c16/c16.rpy:2314
translate brazilian c16s003_ShootingLessons_0e592995:

    # eva "Depende de como te vaya, el próximo día puede que te permita disparar con balas de verdad."
    eva "Dependendo de como correr, da próxima vez posso deixar você atirar com balas de verdade."

# game/scripts/c16/c16.rpy:2315
translate brazilian c16s003_ShootingLessons_57d4b6c8:

    # mc "¡Vamos!"
    mc "Vamos!"

# game/scripts/c16/c16.rpy:2317
translate brazilian c16s003_ShootingLessons_9334e9d2:

    # eva "Esto es una pistola y..."
    eva "Esta é uma arma e..."

# game/scripts/c16/c16.rpy:2318
translate brazilian c16s003_ShootingLessons_36c91770:

    # "Eva empieza a darte explicaciones sobre como cogerla, el seguro, la introducción del cargador, y un montón de cosas más."
    "Eva começa a dar explicações sobre como segurar o aparelho, as medidas de segurança, como inserir o carregador e muito mais."

# game/scripts/c16/c16.rpy:2319
translate brazilian c16s003_ShootingLessons_d81891fb:

    # "Siempre con la recámara vacía y el cargador extraído. Eva pone mucho énfasis en la seguridad y te va repitiendo las leyes hasta que puedes recitarlas de memoria."
    "Sempre com a câmara vazia e o carregador removido. Eva dá muita ênfase à segurança e repete as regras até que você as memorize."

# game/scripts/c16/c16.rpy:2321
translate brazilian c16s003_ShootingLessons_8f989143:

    # eva "Vale, eso es lo más básico. Otro día te enseñaré a desmontar y limpiar tu arma. Vamos a lo divertido. Casi estás listo para tu primer disparo."
    eva "Certo, isso é o básico. Outro dia mostrarei como desmontar e limpar sua arma. Agora vem a parte divertida. Você está quase pronto para o seu primeiro tiro."

# game/scripts/c16/c16.rpy:2322
translate brazilian c16s003_ShootingLessons_c95a51fc:

    # mc "Eso, desde luego, suena más divertido que la teoría."
    mc "Isso com certeza parece mais divertido do que a teoria."

# game/scripts/c16/c16.rpy:2323
translate brazilian c16s003_ShootingLessons_49b1896a:

    # eva "Ponte en posición para disparar. Coge el arma con las dos manos y apunta a una lata. Dedo fuera del gatillo."
    eva "Posicione-se para atirar. Segure a arma com as duas mãos e aponte para uma lata. Tire o dedo do gatilho."

# game/scripts/c16/c16.rpy:2325
translate brazilian c16s003_ShootingLessons_1e9e90ba:

    # "Te pones en tu mejor imitación de las poses que usan los actores en las películas."
    "Você imita da melhor forma possível as poses usadas pelos atores nos filmes."

# game/scripts/c16/c16.rpy:2326
translate brazilian c16s003_ShootingLessons_6d27e1bc:

    # "Pies separados y las rodillas un poco flexionadas. Lo has visto tantas veces en las películas que casi parece una postura natural."
    "Pés afastados e joelhos ligeiramente flexionados. Você já viu essa postura tantas vezes em filmes que ela quase parece natural."

# game/scripts/c16/c16.rpy:2328
translate brazilian c16s003_ShootingLessons_1d1a89a9:

    # eva "Casi bien. Para un civil. Énfasis en casi. En esa postura no le darás ni a un elefante. No es que el elefante tenga la culpa, claro."
    eva "Quase. Para um civil. Ênfase no \"quase\". Nessa posição, você não acertaria nem um elefante. Não que a culpa seja do elefante, claro."

# game/scripts/c16/c16.rpy:2329
translate brazilian c16s003_ShootingLessons_c22a84a4:

    # mc "¿Qué estoy haciendo mal?"
    mc "O que estou fazendo de errado?"

# game/scripts/c16/c16.rpy:2331
translate brazilian c16s003_ShootingLessons_7fa6dd90:

    # eva "Esto. Los pies."
    eva "Isto. Os pés."

# game/scripts/c16/c16.rpy:2332
translate brazilian c16s003_ShootingLessons_091cbf26:

    # "Eva da un golpe seco en el cañón del arma descargada que te desequilibra."
    "Eva desfere um golpe certeiro no cano da arma descarregada, que te desequilibra."

# game/scripts/c16/c16.rpy:2334
translate brazilian c16s003_ShootingLessons_2fbb26e9:

    # eva "Tal como tienes los pies, paralelos al arma y entre sí, el retroceso hará que pierdas el equilibrio."
    eva "Com os pés paralelos à arma e entre si, o recuo fará com que você perca o equilíbrio."

# game/scripts/c16/c16.rpy:2335
translate brazilian c16s003_ShootingLessons_6c79fc2e:

    # eva "Solo ha sido un pequeño empujón, menor que el que te dará la munición de práctica. El arma te dará una pequeña coz cuando uses munición de verdad."
    eva "Foi apenas um pequeno empurrão, menor do que o que você sentiria com munição de treino. A arma dará um pequeno coice quando você usar munição de verdade."

# game/scripts/c16/c16.rpy:2336
translate brazilian c16s003_ShootingLessons_7b63615a:

    # eva "Y esta es solo una 9mm. Si disparas con una .45 será peor. Te caerías de culo encima de esa roca."
    eva "E isso é só uma 9mm. Se você atirar com uma .45, vai ser pior. Você ia cair de costas naquela pedra."

# game/scripts/c16/c16.rpy:2337
translate brazilian c16s003_ShootingLessons_6eba0262:

    # eva "Vuelve a ponerte en la misma posición."
    eva "Retorne à mesma posição."

# game/scripts/c16/c16.rpy:2339
translate brazilian c16s003_ShootingLessons_8e36ee80:

    # eva "¿Ves? Este pie lo tienes bien. Apuntando al objetivo."
    eva "Veja? Este pé está à direita. Apontando para o alvo."

# game/scripts/c16/c16.rpy:2341
translate brazilian c16s003_ShootingLessons_4c718521:

    # eva "Este muévelo un poco hacia atrás y gíralo. 45 o 60° respecto al otro, lo que te sea más cómodo."
    eva "Desloque este um pouco para trás e gire-o. 45 ou 60° em relação ao outro, o que for mais confortável para você."

# game/scripts/c16/c16.rpy:2343
translate brazilian c16s003_ShootingLessons_4d0846ed:

    # eva "Así mucho mejor. Ahora que sabes la teoría busca una posición cómoda para ti."
    eva "Isso é muito melhor. Agora que você conhece a teoria, encontre uma posição confortável para si."

# game/scripts/c16/c16.rpy:2345
translate brazilian c16s003_ShootingLessons_16ecc6ac:

    # eva "¿Ves? Mucho más firme y equilibrado."
    eva "Viu? Muito mais firme e equilibrado."

# game/scripts/c16/c16.rpy:2346
translate brazilian c16s003_ShootingLessons_d73d1ed7:

    # mc "Sí, tienes razón. Pero he visto en muchas películas que se ponen así."
    mc "Sim, você tem razão. Mas eu já os vi agir assim em muitos filmes."

# game/scripts/c16/c16.rpy:2348
translate brazilian c16s003_ShootingLessons_7ecf0af1:

    # eva "Nunca te fíes de lo que ves en las películas. Y menos aún en lo referido a las armas."
    eva "Nunca confie no que você vê nos filmes. E muito menos quando se trata de armas."

# game/scripts/c16/c16.rpy:2349
translate brazilian c16s003_ShootingLessons_fe2d5191:

    # eva "Yo crecí pensando que todo el mundo tenía armas y vivía en casas enormes en Estados Unidos. Y que las calles estarían llenas de Brad Pits y Charlize Terons."
    eva "Cresci achando que todo mundo nos Estados Unidos tinha armas e morava em casas enormes. E que as ruas estariam cheias de Brad Pitt e Charlize Theron."

# game/scripts/c16/c16.rpy:2350
translate brazilian c16s003_ShootingLessons_a02d352a:

    # mc "Y la realidad te debió decepcionar un poco. Por cierto, Charlize es sudafricana."
    mc "E a realidade deve ter te decepcionado um pouco. Aliás, Charlize é sul-africana."

# game/scripts/c16/c16.rpy:2352
translate brazilian c16s003_ShootingLessons_a3ad98b6:

    # eva "Lo sé, pero no lo sabía entonces. Hasta que no estudiamos acentos y dialectos no lo supe."
    eva "Eu sei, mas não sabia disso naquela época. Só descobri quando estudamos sotaques e dialetos."

# game/scripts/c16/c16.rpy:2353
translate brazilian c16s003_ShootingLessons_0fc8bc3f:

    # mc "¿Acentos y dialectos?"
    mc "Sotaques e dialetos?"

# game/scripts/c16/c16.rpy:2355
translate brazilian c16s003_ShootingLessons_ef782ed4:

    # eva "Soy capaz de hablar 17 idiomas, y usar localismos en varios de ellos. Mientras tu jugabas a la Play, nuestros juegos eran hablar en Árabe, con acento de Libia o de Yemen."
    eva "Falo 17 idiomas e uso expressões locais em vários deles. Enquanto você jogava PlayStation, nossos jogos envolviam falar árabe, com sotaque líbio ou iemenita."

# game/scripts/c16/c16.rpy:2356
translate brazilian c16s003_ShootingLessons_ec601d26:

    # mc "Tiene que haber sido difícil."
    mc "Deve ter sido difícil."

# game/scripts/c16/c16.rpy:2358
translate brazilian c16s003_ShootingLessons_574806c6:

    # eva "No lo era. No conocíamos nada más, para nosotras era normal. Lo echábamos de menos tanto como echas tú de menos ser Spiderman."
    eva "Não era. Não conhecíamos outra realidade; para nós, era normal. Sentíamos tanta falta disso quanto você sente falta de ser o Homem-Aranha."

# game/scripts/c16/c16.rpy:2359
translate brazilian c16s003_ShootingLessons_870ff905:

    # eva "Lo que veíamos en la TV no existía. Era ciencia ficción para nosotras. Las niñas no disparaban y no morían en la TV."
    eva "O que víamos na TV não existia. Era ficção científica para nós. Menininhas não atiravam com armas e morriam na TV."

# game/scripts/c16/c16.rpy:2361
translate brazilian c16s003_ShootingLessons_b146110d:

    # eva "Pero dejemos de hablar de nosotras. Carga el arma y mete una bala en la recámara."
    eva "Mas vamos parar de falar de nós. Carregue a arma e coloque uma bala na câmara."

# game/scripts/c16/c16.rpy:2362
translate brazilian c16s003_ShootingLessons_984f4a1a:

    # eva "Dedo lejos del gatillo. Sin apuntar en mi dirección o en la de tus pies."
    eva "Dedo longe do gatilho. Não aponte na minha direção nem para os seus pés."

# game/scripts/c16/c16.rpy:2363
translate brazilian c16s003_ShootingLessons_8f911973:

    # mc "¡A sus órdenes!"
    mc "À sua disposição!"

# game/scripts/c16/c16.rpy:2365
translate brazilian c16s003_ShootingLessons_b9e3210a:

    # eva "Ahora apunta con una mano y dispara a la lata que menos te guste."
    eva "Agora mire com uma mão e atire na lata de que você menos gosta."

# game/scripts/c16/c16.rpy:2366
translate brazilian c16s003_ShootingLessons_b1a93e78:

    # eva "Recuerda. Vas a disparar con munición de práctica. No expulsa el casquillo y no recarga automáticamente. Tienes que amartillarla manualmente."
    eva "Lembre-se: você vai usar munição de treino. Ela não ejeta o cartucho e não recarrega automaticamente. Você precisa armá-la manualmente."

# game/scripts/c16/c16.rpy:2367
translate brazilian c16s003_ShootingLessons_a645c1e2:

    # mc "Será mejor que te apartes, ¿no?"
    mc "É melhor você se afastar, não acha?"

# game/scripts/c16/c16.rpy:2368
translate brazilian c16s003_ShootingLessons_4d2f0adf:

    # eva "No te preocupes. No me puedes dar aquí. Mi instructor se pondría detrás tuyo, con su arma apuntando a tu cabeza, pero yo prefiero estar aquí. Dispara tres veces."
    eva "Não se preocupe. Você não pode me acertar aqui. Meu instrutor ficaria atrás de você, com a arma apontada para sua cabeça, mas eu prefiro ficar aqui. Atire três vezes."

# game/scripts/c16/c16.rpy:2371
translate brazilian c16s003_ShootingLessons_ee71ee81:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2372
translate brazilian c16s003_ShootingLessons_25a15966:

    # "No tienes ni idea de dónde va el primer disparo. La pequeña coz de la que ha hablado Eva es más fuerte de lo que esperabas y el retroceso ha hecho que el cañón se levante."
    "Você não tem ideia de para onde o primeiro tiro vai. O pequeno coice que Eva mencionou é mais forte do que você esperava, e o recuo fez o cano subir."

# game/scripts/c16/c16.rpy:2373
translate brazilian c16s003_ShootingLessons_697265d2:

    # eva "Ningún pato muerto de momento. Las latas están mucho más abajo. *Risa* Otra vez."
    eva "Ainda não encontrei nenhum pato morto. As latas estão bem mais abaixo. *Risos* De novo."

# game/scripts/c16/c16.rpy:2374
translate brazilian c16s003_ShootingLessons_d9fcd1cc:

    # eva "Por cierto, pareces salido del Doomfenstein cogiendo la pistola así. *Risa*"
    eva "Aliás, você parece ter saído direto de um filme do Doomfenstein segurando a arma desse jeito. *Risos*"

# game/scripts/c16/c16.rpy:2376
translate brazilian c16s003_ShootingLessons_a37b6d3e:

    # mcp "(No me importaría disparar a Eric en un videojuego.)"
    mcp "(Eu não me importaria de atirar no Eric em um videogame.)"

# game/scripts/c16/c16.rpy:2379
translate brazilian c16s003_ShootingLessons_ee71ee81_1:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2380
translate brazilian c16s003_ShootingLessons_c819ef3f:

    # "Esta vez el retroceso no te sorprende y eres capaz de controlarlo. Esta vez sí que ves donde impacta la bala. En el árbol que hay detras del bote al que apuntabas."
    "Dessa vez, o recuo não te surpreende e você consegue controlá-lo. Dessa vez, você realmente vê onde a bala acerta. Na árvore atrás do barco para o qual você estava mirando."

# game/scripts/c16/c16.rpy:2381
translate brazilian c16s003_ShootingLessons_2da7ca91:

    # eva "Nos vamos acercando. Si el bote devolviera el fuego, ya estarías muerto. Porque estás apuntando al bote, ¿verdad? *Risa* Al menos no has matado ninguna ardilla."
    eva "Estamos chegando perto. Se o barco revidasse, você estaria morto. Porque você está mirando no barco, certo? *Risos* Pelo menos você não matou nenhum esquilo."

# game/scripts/c16/c16.rpy:2384
translate brazilian c16s003_ShootingLessons_ee71ee81_2:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2385
translate brazilian c16s003_ShootingLessons_50a5cf56:

    # "Intentas compensar más todavía el retroceso. Esta vez levantas un poco de polvo delante de la lata. Lo has compensado en exceso, pero la dirección era buena."
    "Você tenta compensar ainda mais o recuo. Desta vez, você levanta um pouco de poeira na frente da lata. Você exagerou na compensação, mas a direção estava boa."

# game/scripts/c16/c16.rpy:2386
translate brazilian c16s003_ShootingLessons_95d2920f:

    # eva "¡Ese ha sido casi bueno! Hay un topo teniendo un ataque de ansiedad ahora mismo. *Risa* Pero ha sido el mejor disparo."
    eva "Quase deu certo! Tem uma toupeira tendo um ataque de ansiedade agora. *Risos* Mas foi a melhor foto."

# game/scripts/c16/c16.rpy:2388
translate brazilian c16s003_ShootingLessons_886f2a3d:

    # eva "Saca la bala de la recámara, ponle el seguro, saca el cargador, y dame el arma."
    eva "Retire a bala da câmara, acione a trava de segurança, remova o carregador e me dê a arma."

# game/scripts/c16/c16.rpy:2389
translate brazilian c16s003_ShootingLessons_8cc59136:

    # mc "Es más difícil de lo que parece. En las películas lo pillan en seguida."
    mc "É mais difícil do que parece. Nos filmes, eles descobrem rapidinho."

# game/scripts/c16/c16.rpy:2390
translate brazilian c16s003_ShootingLessons_dbc49818:

    # eva "¿Qué te he dicho sobre Spiderman hace un rato? No te creas nada de lo que veas en una película."
    eva "O que eu te disse sobre o Homem-Aranha há um tempo? Não acredite em tudo que você vê nos filmes."

# game/scripts/c16/c16.rpy:2391
translate brazilian c16s003_ShootingLessons_8fb1373c:

    # eva "Si esto fuera una película habrías acertado a la primera y estaríamos follando contra un árbol."
    eva "Se isso fosse um filme, você teria adivinhado certo na primeira vez e estaríamos transando encostados em uma árvore."

# game/scripts/c16/c16.rpy:2392
translate brazilian c16s003_ShootingLessons_1c09825e:

    # mc "*Risa* Antes me vas a tener que invitar a cenar. *Risa*"
    mc "*Risos* Primeiro você vai ter que me convidar para jantar. *Risos*"

# game/scripts/c16/c16.rpy:2394
translate brazilian c16s003_ShootingLessons_3ae0c5f5:

    # eva "Tú crees que eres gracioso, ¿verdad? No hace falta que contestes."
    eva "Você acha que é engraçado, não é? Não precisa responder."

# game/scripts/c16/c16.rpy:2395
translate brazilian c16s003_ShootingLessons_83ba66b2:

    # eva "Tu problema es que tiras del gatillo."
    eva "Seu problema é que você aperta o gatilho."

# game/scripts/c16/c16.rpy:2396
translate brazilian c16s003_ShootingLessons_7e0d352a:

    # mc "Eso es lo que hay que hacer, ¿no? Si no, no dispara."
    mc "É isso que você tem que fazer, certo? Senão, não vai disparar."

# game/scripts/c16/c16.rpy:2397
translate brazilian c16s003_ShootingLessons_4d2a88ea:

    # eva "No, si tiras del gatillo estás desequilibrando el arma. Hacia abajo, como ahora. Eso si eres capaz de controlar el retroceso, que lo estás empezando a hacer bien."
    eva "Não, se você puxar o gatilho, estará desequilibrando a arma. Para baixo, como agora. Isso, claro, se você conseguir controlar o recuo, o que você está começando a fazer bem."

# game/scripts/c16/c16.rpy:2398
translate brazilian c16s003_ShootingLessons_61279e7e:

    # eva "Lo que tienes que hacer es estrujar con toda la mano. Empuñadura y gatillo. Como si fuera una pelota antiestrés. ¿Ves?"
    eva "O que você precisa fazer é apertá-lo com a mão toda. Segure firme e aperte. Como se fosse uma bola antiestresse. Entendeu?"

# game/scripts/c16/c16.rpy:2399
translate brazilian c16s003_ShootingLessons_c97c5a04:

    # mc "Vale, lo veo. Déjame probar otra vez"
    mc "Certo, entendi. Deixe-me tentar novamente."

# game/scripts/c16/c16.rpy:2402
translate brazilian c16s003_ShootingLessons_ee71ee81_3:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2403
translate brazilian c16s003_ShootingLessons_49e3887e:

    # "La teoría de estrujar empuñadura y gatillo a la vez es fácil. La práctica no."
    "A teoria por trás de apertar o punho e o gatilho simultaneamente é simples. A prática, não."

# game/scripts/c16/c16.rpy:2404
translate brazilian c16s003_ShootingLessons_c55629c2:

    # eva "Casi. El topo acaba de reservar unas vacaciones en Florida. *Risa* Prefiere los caimanes. Controla un poco más como estrujas el conjunto y casi lo tendrás."
    eva "Quase. A toupeira acabou de reservar férias na Flórida. *Risos* Ela prefere jacarés. Se você apertar com mais cuidado, quase vai pegá-la."

# game/scripts/c16/c16.rpy:2407
translate brazilian c16s003_ShootingLessons_ee71ee81_4:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2408
translate brazilian c16s003_ShootingLessons_261480da:

    # "Esta vez sí que impactas en el bote. La sensación de alegría es inmensa."
    "Dessa vez você realmente ganhou na loteria. A sensação de alegria é imensa."

# game/scripts/c16/c16.rpy:2409
translate brazilian c16s003_ShootingLessons_01891b38:

    # mc "¡Sí!"
    mc "Sim!"

# game/scripts/c16/c16.rpy:2410
translate brazilian c16s003_ShootingLessons_9f9ce441:

    # eva "¡Muy bien, [mc]! Un último disparo para comprobar que no ha sido casualidad."
    eva "Muito bem, [mc]! Uma última tentativa para garantir que não foi um acaso."

# game/scripts/c16/c16.rpy:2413
translate brazilian c16s003_ShootingLessons_ee71ee81_5:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2414
translate brazilian c16s003_ShootingLessons_9aa56c1a:

    # "La lata salta por los aires. ¡Estás aprendiendo a disparar!"
    "A lata voa pelo ar. Você está aprendendo a atirar!"

# game/scripts/c16/c16.rpy:2415
translate brazilian c16s003_ShootingLessons_65608ae9:

    # eva "¡Genial!"
    eva "Brilhante!"

# game/scripts/c16/c16.rpy:2416
translate brazilian c16s003_ShootingLessons_d11b853e:

    # eva "Te quedan 11 balas y cuatro objetivos. A ver cuántos puedes derribar."
    eva "Você tem 11 balas restantes e quatro alvos. Vamos ver quantos você consegue derrubar."

# game/scripts/c16/c16.rpy:2419
translate brazilian c16s003_ShootingLessons_61d2f1fa:

    # "*Bang* *Bang* *Bang*"
    "*Bang* *Bang* *Bang*"

# game/scripts/c16/c16.rpy:2420
translate brazilian c16s003_ShootingLessons_2dd5869c:

    # "Disparas tres veces a la botella de gel de manos. No hay suerte. Dirías que le has dado, pero no ha saltado por los aires. Ocho balas. Cuatro objetivos todavía."
    "Você dispara três tiros contra o frasco de álcool em gel. Sem sucesso. Você acha que acertou, mas ele não explodiu. Oito balas. Quatro alvos ainda."

# game/scripts/c16/c16.rpy:2421
translate brazilian c16s003_ShootingLessons_f27f9b21:

    # eva "Esa botella no quiere morir. *Risa*"
    eva "Essa garrafa não quer morrer. *Risos*"

# game/scripts/c16/c16.rpy:2424
translate brazilian c16s003_ShootingLessons_54c88ec6:

    # "*Bang* *Bang*"
    "*Bang* *Bang*"

# game/scripts/c16/c16.rpy:2425
translate brazilian c16s003_ShootingLessons_dfb9a365:

    # "La siguiente lata salta volando al segundo disparo. Seis balas. Tres objetivos."
    "A próxima lata voa pelos ares com o segundo disparo. Seis balas. Três alvos."

# game/scripts/c16/c16.rpy:2426
translate brazilian c16s003_ShootingLessons_ab282110:

    # eva "¡Muy bien!"
    eva "Muito bom!"

# game/scripts/c16/c16.rpy:2429
translate brazilian c16s003_ShootingLessons_ee71ee81_6:

    # "*Bang*"
    "*Bang*"

# game/scripts/c16/c16.rpy:2430
translate brazilian c16s003_ShootingLessons_71cea6f0:

    # "La siguiente al primero. Cinco balas. Dos objetivos."
    "A próxima depois da primeira. Cinco balas. Dois alvos."

# game/scripts/c16/c16.rpy:2431
translate brazilian c16s003_ShootingLessons_21c9233d:

    # eva "¡Alucinante!"
    eva "Alucinatório!"

# game/scripts/c16/c16.rpy:2432
translate brazilian c16s003_ShootingLessons_2a0ec6bb:

    # "Cambias de objetivo."
    "Você muda seu objetivo."

# game/scripts/c16/c16.rpy:2435
translate brazilian c16s003_ShootingLessons_61d2f1fa_1:

    # "*Bang* *Bang* *Bang*"
    "*Bang* *Bang* *Bang*"

# game/scripts/c16/c16.rpy:2436
translate brazilian c16s003_ShootingLessons_c6603222:

    # "Te cuesta tres balas acabar con la siguiente lata. Últimas dos balas. Solo queda la botella de gel de manos."
    "São necessárias três balas para acabar com a próxima lata. Só restam duas balas. Só sobrou o frasco de álcool em gel."

# game/scripts/c16/c16.rpy:2437
translate brazilian c16s003_ShootingLessons_f3699c6d:

    # eva "Esa se ha resistido, pero bien. A por la última."
    eva "Essa foi difícil, mas boa. Vamos para a última."

# game/scripts/c16/c16.rpy:2440
translate brazilian c16s003_ShootingLessons_54c88ec6_1:

    # "*Bang* *Bang*"
    "*Bang* *Bang*"

# game/scripts/c16/c16.rpy:2441
translate brazilian c16s003_ShootingLessons_16e68d53:

    # "Vuelves a la botella. Disparas. Volverías a jurar que le has dado, pero la botella sigue ahí. No has fallado porque sea transparente, ¿verdad?"
    "Você volta para a garrafa. Atira. Você juraria que acertou de novo, mas a garrafa continua lá. Você não errou porque ela é transparente, errou?"

# game/scripts/c16/c16.rpy:2443
translate brazilian c16s003_ShootingLessons_785266c5:

    # eva "Muy bien, [mc]."
    eva "Muito bom, [mc]."

# game/scripts/c16/c16.rpy:2444
translate brazilian c16s003_ShootingLessons_4e17dc40:

    # mc "Muy bien no. La botella se ha resistido."
    mc "Não muito bem. A garrafa me deu trabalho."

# game/scripts/c16/c16.rpy:2445
translate brazilian c16s003_ShootingLessons_84d67cbf:

    # eva "¿Estás seguro? Ve a verla."
    eva "Tem certeza? Vá ver."

# game/scripts/c16/c16.rpy:2447
translate brazilian c16s003_ShootingLessons_a3d8938e:

    # mc "¿Has clavado la botella al suelo? *Risa*"
    mc "Você enfiou a garrafa no chão? *Risos*"

# game/scripts/c16/c16.rpy:2449
translate brazilian c16s003_ShootingLessons_485a1eef:

    # eva "*Risa* ¡Sí! Ha sido divertido ver cómo te frustrabas. Se me saltan las lágrimas."
    eva "*Risos* Sim! Foi engraçado ver você ficar frustrado. Estou até com os olhos marejados."

# game/scripts/c16/c16.rpy:2450
translate brazilian c16s003_ShootingLessons_11f2057b:

    # mc "Muy graciosa... *Risa*"
    mc "Muito engraçado... *Risos*"

# game/scripts/c16/c16.rpy:2451
translate brazilian c16s003_ShootingLessons_5449829a:

    # mc "Pero no sé cuántas veces le he dado. No sé ni cuántas le he disparado..."
    mc "Mas não sei quantas vezes acertei. Nem sei quantas vezes atirei..."

# game/scripts/c16/c16.rpy:2453
translate brazilian c16s003_ShootingLessons_3a0f7938:

    # eva "Le has disparado cinco veces y le has dado dos. No está nada mal para tu primera vez. 17 balas y siete aciertos."
    eva "Você atirou nele cinco vezes e o acertou duas. Nada mal para a sua primeira vez. 17 balas e sete acertos."

# game/scripts/c16/c16.rpy:2454
translate brazilian c16s003_ShootingLessons_90d53fbc:

    # eva "Mi primera vez fue bastante peor. Y fui la mejor de todas."
    eva "Minha primeira vez foi muito pior. E eu fui a melhor de todas."

# game/scripts/c16/c16.rpy:2457
translate brazilian c16s003_ShootingLessons_6ef6c4c4:

    # eva "Sí, lo sé Amanda, conseguí la misma puntuación que tú, pero más dieces."
    eva "Sim, eu sei, Amanda, tirei a mesma nota que você, mas com mais notas 10."

# game/scripts/c16/c16.rpy:2459
translate brazilian c16s003_ShootingLessons_feb7a9e4:

    # mc "¿Qué edad tenías?"
    mc "Quantos anos você tinha?"

# game/scripts/c16/c16.rpy:2461
translate brazilian c16s003_ShootingLessons_7316c5b5:

    # eva "6 años. Aquellas pistolas fueron nuestro regalo de cumpleaños."
    eva "6 anos de idade. Aquelas armas de brinquedo foram nosso presente de aniversário."

# game/scripts/c16/c16.rpy:2462
translate brazilian c16s003_ShootingLessons_ee6d7077:

    # mc "Eso es muy triste. ¿Ni una muñeca? ¿Ni un juguete?"
    mc "Que triste. Nem uma boneca? Nem um brinquedo?"

# game/scripts/c16/c16.rpy:2464
translate brazilian c16s003_ShootingLessons_61687f98:

    # eva "Es tan triste como que a ti nunca te regalaran un sable laser que funcionara."
    eva "É tão triste quanto nunca ganhar um sabre de luz funcional de presente."

# game/scripts/c16/c16.rpy:2465
translate brazilian c16s003_ShootingLessons_61df8865:

    # mc "No existen, Eva."
    mc "Eles não existem, Eva."

# game/scripts/c16/c16.rpy:2467
translate brazilian c16s003_ShootingLessons_307d9685:

    # eva "Igual que en nuestro mundo no existían juguetes o muñecas."
    eva "Assim como em nosso mundo não havia brinquedos nem bonecas."

# game/scripts/c16/c16.rpy:2468
translate brazilian c16s003_ShootingLessons_dc077a5f:

    # eva "Nuestros juguetes eran armas y dispositivos de vigilancia. Era lo normal. Y espiarnos entre nosotras era divertido."
    eva "Nossos brinquedos eram armas e dispositivos de vigilância. Era normal. E espionar uns aos outros era divertido."

# game/scripts/c16/c16.rpy:2469
translate brazilian c16s003_ShootingLessons_8944a074:

    # eva "Con el tiempo, los A nos empezaron a traer cosas de sus misiones. Bolas de nieve y cosas así."
    eva "Com o tempo, os A's começaram a nos trazer coisas de suas missões. Bolas de neve e coisas do tipo."

# game/scripts/c16/c16.rpy:2470
translate brazilian c16s003_ShootingLessons_d46f30be:

    # eva "Era casi como sentirse en una película. Eran casi como nuestros tíos favoritos."
    eva "Era quase como estar em um filme. Eles eram quase como nossos tios favoritos."

# game/scripts/c16/c16.rpy:2471
translate brazilian c16s003_ShootingLessons_7e47bbdd:

    # mc "Joder, Eva. ¿Puedo abrazarte?"
    mc "Nossa, Eva. Posso te dar um abraço?"

# game/scripts/c16/c16.rpy:2473
translate brazilian c16s003_ShootingLessons_7a266f30:

    # eva "{b}¿Qué? ¿A mí? ¿Por qué?{/b}"
    eva "{b}O quê? Eu? Por quê?{/b}"

# game/scripts/c16/c16.rpy:2474
translate brazilian c16s003_ShootingLessons_5a9dce8e:

    # mc "*Risa* Costumbre familiar. Cuando alguien explica algo triste, nos abrazamos. Nos consolamos."
    mc "*Risos* Costume de família. Quando alguém nos conta algo triste, nos abraçamos. Nos consolamos mutuamente."

# game/scripts/c16/c16.rpy:2476
translate brazilian c16s003_ShootingLessons_5df147c8:

    # eva "¿Te ha puesto triste?"
    eva "Isso te deixou triste?"

# game/scripts/c16/c16.rpy:2477
translate brazilian c16s003_ShootingLessons_65178f3d:

    # mc "Me pone triste que no hayas tenido una infancia normal."
    mc "Fico triste por você não ter tido uma infância normal."

# game/scripts/c16/c16.rpy:2478
translate brazilian c16s003_ShootingLessons_dc77e864:

    # eva "No tienes que ponerte triste por eso. Para mí... para nosotras, era normal. No echábamos nada de menos."
    eva "Você não precisa ficar triste por isso. Para mim... para nós, foi normal. Não sentimos falta de nada."

# game/scripts/c16/c16.rpy:2479
translate brazilian c16s003_ShootingLessons_3c24a76c:

    # mc "¿Estás intentando consolarme? ¿Tú a mí?"
    mc "Você está tentando me consolar? Você está tentando me consolar?"

# game/scripts/c16/c16.rpy:2481
translate brazilian c16s003_ShootingLessons_66f22b48:

    # eva "En eso consiste, ¿no? Has dicho que cuando algo os pone tristes, os consoláis. ¿O lo he entendido mal?"
    eva "É disso que se trata, não é? Você disse que quando algo te deixa triste, vocês se consolam mutuamente. Ou eu entendi errado?"

# game/scripts/c16/c16.rpy:2482
translate brazilian c16s003_ShootingLessons_0d0f1f21:

    # mc "No, lo has entendido perfectamente."
    mc "Não, você entendeu perfeitamente."

# game/scripts/c16/c16.rpy:2484
translate brazilian c16s003_ShootingLessons_18706471:

    # "Vuelves a abrazarla. Ya no sabes si para consolarla a ella o a ti mismo. Ella parece no necesitar consuelo, pero ayer demostró que necesita cariño."
    "Você a abraça novamente. Já não sabe se é para confortá-la ou a si mesmo. Ela não parece precisar de conforto, mas ontem demonstrou que precisa de afeto."

# game/scripts/c16/c16.rpy:2485
translate brazilian c16s003_ShootingLessons_8a720530:

    # mcp "(¡Qué difícil va a ser esto! Ni siquiera entiende lo triste que es su situación.)"
    mcp "(Isso vai ser muito difícil! Ele nem sequer entende o quão triste é a situação dele.)"

# game/scripts/c16/c16.rpy:2486
translate brazilian c16s003_ShootingLessons_5a621af3:

    # eva "Si este es el premio por ponerte triste, tengo un montón de historias para contar."
    eva "Se essa é a recompensa por estar triste, tenho muitas histórias para contar."

# game/scripts/c16/c16.rpy:2487
translate brazilian c16s003_ShootingLessons_512d67f8:

    # mc "Las quiero oír todas, Eva."
    mc "Quero ouvir todas elas, Eva."

# game/scripts/c16/c16.rpy:2488
translate brazilian c16s003_ShootingLessons_6822f159:

    # mc "Y en casa también querrán hacerlo. Prepárate para muchos abrazos."
    mc "E eles também vão querer fazer isso em casa. Prepare-se para muitos abraços."

# game/scripts/c16/c16.rpy:2490
translate brazilian c16s003_ShootingLessons_e14b574a:

    # eva "¡Oh, mierda! ¿Qué hora es? ¿A qué hora me esperan para comer?"
    eva "Puxa! Que horas são? A que horas eles estão me esperando para o almoço?"

# game/scripts/c16/c16.rpy:2491
translate brazilian c16s003_ShootingLessons_0f00cee4:

    # mc "A la una y media. No sé qué hora es. Tengo el móvil en la mochila."
    mc "Às 13h30. Não sei que horas são. Meu celular está na minha mochila."

# game/scripts/c16/c16.rpy:2493
translate brazilian c16s003_ShootingLessons_59346b24:

    # eva "Por eso llegas tarde a los sitios. *Risa* Vamos a recoger las latas y empecemos a bajar. A mí no me gusta llegar tarde."
    eva "É por isso que você está sempre atrasado. *Risos* Vamos pegar as latas e começar a descer. Eu não gosto de me atrasar."

# game/scripts/c16/c16.rpy:2494
translate brazilian c16s003_ShootingLessons_02e83dae:

    # mc "¿Cuánto tiempo me lo vas a echar en cara?"
    mc "Até quando você vai continuar insistindo nesse assunto?"

# game/scripts/c16/c16.rpy:2495
translate brazilian c16s003_ShootingLessons_9cc61597:

    # eva "Hasta que llegues puntual. *Risita*"
    eva "Até você chegar na hora. *Risos*"

# game/scripts/c16/c16.rpy:2498
translate brazilian c16s003_ShootingLessons_db5b72df:

    # "Recogéis el campo de tiro. Eva hace hincapié en no dejaros ningún casquillo. Las balas son irrecuperables en su mayoría."
    "Você limpa o estande de tiro. Eva enfatiza que você não deve deixar nenhuma cápsula deflagrada para trás. A maioria das balas não pode ser recuperada."

# game/scripts/c16/c16.rpy:2499
translate brazilian c16s003_ShootingLessons_339de07e:

    # "Se hace una cola y empezáis a bajar hacia casa. Ella es mucho más rápida y ágil que tú. También tiene más prisa. Ni una gota de sudor perla su frente."
    "Forma-se uma fila e vocês dois começam a caminhar em direção a casa. Ela é muito mais rápida e ágil do que você. Ela também está com mais pressa. Nem uma gota de suor escorre pela testa dela."

# game/scripts/c16/c16.rpy:2502
translate brazilian c16s003_ShootingLessons_46540fd2:

    # eva "Venga, tortuguilla. Vamos a llegar tarde por tu culpa."
    eva "Vamos lá, tartaruguinha. Vamos nos atrasar por sua causa."

# game/scripts/c16/c16.rpy:2503
translate brazilian c16s003_ShootingLessons_238c4bb3:

    # mc "Hay tiempo de sobra, Eva."
    mc "Você tem bastante tempo, Eva."

# game/scripts/c16/c16.rpy:2504
translate brazilian c16s003_ShootingLessons_6362713e:

    # eva "No tanto. Me tengo que cambiar de ropa. No quiero que la primera impresión que tenga la familia de mí sea vestida así."
    eva "Na verdade, não. Preciso trocar de roupa. Não quero que a primeira impressão que minha família tenha de mim seja essa."

# game/scripts/c16/c16.rpy:2505
translate brazilian c16s003_ShootingLessons_6c9962db:

    # mc "¿Por eso te has hecho la coleta?"
    mc "É por isso que você prende o cabelo em um rabo de cavalo?"

# game/scripts/c16/c16.rpy:2507
translate brazilian c16s003_ShootingLessons_fb1c88a0:

    # eva "Tengo más pinta de buena chica con ella, ¿no? *Risita*"
    eva "Para ela, eu pareço mais uma garota legal, não é? *Risos*"

# game/scripts/c16/c16.rpy:2508
translate brazilian c16s003_ShootingLessons_aae332f6:

    # mc "Eva, la primera impresión que se van a llevar es que eres una buena chica. Porque lo eres."
    mc "Eva, a primeira impressão que eles terão de você é que você é uma boa menina. Porque você é."

# game/scripts/c16/c16.rpy:2509
translate brazilian c16s003_ShootingLessons_7bc3e73a:

    # mc "Ahora vas a decirme que llevas un vestido en la mochila."
    mc "Agora você vai me dizer que está carregando um vestido na sua mochila?"

# game/scripts/c16/c16.rpy:2511
translate brazilian c16s003_ShootingLessons_ce4ddcbd:

    # eva "¿Un vestido? ¿Qué tiene de malo un vestido? ¿No sería apropiado?"
    eva "Um vestido? Qual o problema com um vestido? Não seria apropriado?"

# game/scripts/c16/c16.rpy:2512
translate brazilian c16s003_ShootingLessons_40705795:

    # mc "Puedes ponerte lo que quieras, pero apuesto a que [dap] y [emm] van a ir con shorts. Ya las habéis visto. Ante todo, quieren estar cómodas en casa."
    mc "Você pode usar o que quiser, mas aposto que [dap] e [emm] vão usar bermudas. Você já as viu. Acima de tudo, elas querem se sentir confortáveis em casa."

# game/scripts/c16/c16.rpy:2513
translate brazilian c16s003_ShootingLessons_61ec2cf1:

    # eva "¿Shorts? Perfecto. También llevo."
    eva "Calções? Perfeito. Eu também vou usar."

# game/scripts/c16/c16.rpy:2514
translate brazilian c16s003_ShootingLessons_8e2099cf:

    # mcp "(¿Está tan nerviosa que se ha traído todo su guardarropa?)"
    mcp "(Será que ela está tão nervosa que trouxe todo o seu guarda-roupa?)"

# game/scripts/c16/c16.rpy:2515
translate brazilian c16s003_ShootingLessons_9871aeb0:

    # mc "El vestido iría mejor para una cena. O para la comida del domingo."
    mc "O vestido seria mais apropriado para um jantar. Ou para um almoço de domingo."

# game/scripts/c16/c16.rpy:2517
translate brazilian c16s003_ShootingLessons_58a403c5:

    # eva "El domingo también me toca ir a comer a mí, ¿no?"
    eva "Eu também tenho que ir jantar no domingo, né?"

# game/scripts/c16/c16.rpy:2518
translate brazilian c16s003_ShootingLessons_a12c28ce:

    # mc "Claro. Hoy y el domingo vienes a comer. Mañana a cenar."
    mc "Claro. Você vem almoçar hoje e domingo. E jantar amanhã."

# game/scripts/c16/c16.rpy:2520
translate brazilian c16s003_ShootingLessons_0333a8e4:

    # eva "Lo digo porque vais a celebrar el cumpleaños de las chicas. A lo mejor queréis que sea algo familiar."
    eva "Digo isso porque você vai comemorar o aniversário das meninas. Talvez você queira que seja uma comemoração em família."

# game/scripts/c16/c16.rpy:2521
translate brazilian c16s003_ShootingLessons_6a7e79ec:

    # mc "Será familiar. Te lo dije en la playa. De alguna forma formáis parte de esta familia. Hoy lo terminarás de descubrir."
    mc "Vai parecer familiar. Eu te disse isso na praia. De certa forma, você faz parte desta família. Você vai descobrir com certeza hoje."

# game/scripts/c16/c16.rpy:2522
translate brazilian c16s003_ShootingLessons_65de1a0d:

    # mc "Amanda. El domingo ven tú también a comer. Y antes de que preguntes quién va a vigilar, la respuesta es vosotras mientas coméis."
    mc "Amanda, você também deveria vir almoçar no domingo. E antes que você pergunte quem vai supervisionar, a resposta é: vocês duas, enquanto comem."

# game/scripts/c16/c16.rpy:2524
translate brazilian c16s003_ShootingLessons_8ac9bed3:

    # eva "Dice que OK."
    eva "Ele diz \"OK\"."

# game/scripts/c16/c16.rpy:2525
translate brazilian c16s003_ShootingLessons_55637707:

    # eva "Sois raros. Celebráis los tres cumpleaños juntos. Hoy es el de [emm], el lunes el de [dap] y [eri]... y lo celebráis el domingo... raros."
    eva "Vocês são estranhos. Vocês comemoram os três aniversários juntos. Hoje é aniversário do [emm], na segunda-feira é aniversário do [dap] e do [eri]... e vocês comemoram no domingo... que estranho."

# game/scripts/c16/c16.rpy:2527
translate brazilian c16s003_ShootingLessons_7d2ca042:

    # mc "Se llevan tres días de diferencia."
    mc "Eles estão separados por três dias."

# game/scripts/c16/c16.rpy:2529
translate brazilian c16s003_ShootingLessons_32797ee1:

    # mc "Se llevan tres días de diferencia. Al menos por lo que sabemos."
    mc "Eles estão separados por três dias. Pelo menos até onde sabemos."

# game/scripts/c16/c16.rpy:2530
translate brazilian c16s003_ShootingLessons_9cc74fde:

    # mc "Celebrar el cumpleaños de [emm] y tres días después los otros dos hubiera sido agotador. [nor] y [mar] las educaron para que la celebración fuera el domingo más cercano."
    mc "Comemorar o aniversário de [emm] e depois o dos outros dois três dias depois teria sido exaustivo. [nor] e [mar] os incentivaram a comemorar no domingo mais próximo."

# game/scripts/c16/c16.rpy:2532
translate brazilian c16s003_ShootingLessons_a3fa256e:

    # eva "No parece algo que [emm] aceptara de buen grado."
    eva "Não parece ser algo que [emm] aceitaria facilmente."

# game/scripts/c16/c16.rpy:2533
translate brazilian c16s003_ShootingLessons_a1391750:

    # mc "Para cuando fue consciente de su cumpleaños estaba acostumbrada a hacerlo así. Nunca supuso un problema. Hoy recibe los besos y abrazos. El domingo los regalos."
    mc "Quando se deu conta de que era seu aniversário, já estava acostumada. Nunca foi um problema. Hoje ela recebe beijos e abraços. No domingo, os presentes."

# game/scripts/c16/c16.rpy:2535
translate brazilian c16s003_ShootingLessons_af2c0fe4:

    # eva "¿Ves, Amanda? Te lo dije. No hacía falta que trajéramos nada hoy."
    eva "Viu, Amanda? Eu te disse. Não precisamos trazer nada hoje."

# game/scripts/c16/c16.rpy:2536
translate brazilian c16s003_ShootingLessons_c53b4e30:

    # mc "Bueno, vosotras vais a ser un regalo especial para ella. Seguro. También para [dap] y [eri]."
    mc "Bom, vocês dois serão um presente especial para ela. Com certeza. E para [dap] e [eri] também."

# game/scripts/c16/c16.rpy:2537
translate brazilian c16s003_ShootingLessons_c9dfce51:

    # mc "Hablando de [eri]... tenemos una conversación pendiente sobre el día que te disfrazaste."
    mc "Por falar em [eri]... tivemos uma conversa excelente sobre o dia em que você se arrumou."

# game/scripts/c16/c16.rpy:2539
translate brazilian c16s003_ShootingLessons_620a9dc4:

    # eva "Amanda, corto la comunicación."
    eva "Amanda, interrompi a comunicação."

# game/scripts/c16/c16.rpy:2540
translate brazilian c16s003_ShootingLessons_ef47d46b:

    # eva "¿Qué quieres saber?"
    eva "O que você quer saber?"

# game/scripts/c16/c16.rpy:2541
translate brazilian c16s003_ShootingLessons_fbcdae8f:

    # mc "¿Por qué lo hiciste? ¿Qué querías?"
    mc "Por que você fez isso? O que você queria?"

# game/scripts/c16/c16.rpy:2543
translate brazilian c16s003_ShootingLessons_01b145ef:

    # eva "Ahora te va a parecer ridículo. A mí también me lo parece. Anoche le estuve dando vueltas. Sabía que querrías tener esta conversación."
    eva "Você vai achar isso ridículo agora. Eu também acho. Fiquei pensando nisso ontem à noite. Eu sabia que você ia querer ter essa conversa."

# game/scripts/c16/c16.rpy:2544
translate brazilian c16s003_ShootingLessons_f6f66c34:

    # mc "Prueba a explicármelo y después decidimos si es ridículo."
    mc "Tente me explicar e depois decidiremos se é ridículo."

# game/scripts/c16/c16.rpy:2545
translate brazilian c16s003_ShootingLessons_92304697:

    # eva "Piensa que no entraba en nuestros planes que llegáramos a conocerte nunca."
    eva "Ele acha que não estava nos nossos planos te conhecer."

# game/scripts/c16/c16.rpy:2546
translate brazilian c16s003_ShootingLessons_6ca0a4be:

    # eva "Me quedé atrapada en la habitación de Saira mientras ponía las cámaras. Me empecé a disfrazar de [eri] para matar el rato mientras os dormíais todos."
    eva "Fiquei presa no quarto da Saira enquanto configurava as câmeras. Comecei a me vestir de [eri] para passar o tempo enquanto vocês dormiam."

# game/scripts/c16/c16.rpy:2547
translate brazilian c16s003_ShootingLessons_4cd55467:

    # eva "Mi disfraz de [eri] estaba allí, era una habitación que no se iba a usar durante un tiempo. Y se me ocurrió una idea."
    eva "Meu traje [eri] estava lá; era um quarto que não seria usado por um tempo. E uma ideia me veio."

# game/scripts/c16/c16.rpy:2548
translate brazilian c16s003_ShootingLessons_8ce0712b:

    # mc "Me das miedo."
    mc "Você me assusta."

# game/scripts/c16/c16.rpy:2550
translate brazilian c16s003_ShootingLessons_302f2f3a:

    # eva "Mira... estás bueno, ¿vale?"
    eva "Olha... você é bonito(a), tá bem?"

# game/scripts/c16/c16.rpy:2551
translate brazilian c16s003_ShootingLessons_39810c93:

    # mc "Ermmm... gracias, supongo..."
    mc "Hum... obrigado, eu acho..."

# game/scripts/c16/c16.rpy:2554
translate brazilian c16s003_ShootingLessons_a18290a8:

    # eva "Después de lo de la sauna, tarde o temprano ibas a tener sexo con [eri], y parecía que necesitabas un empujón con todo eso de \"cuando estés lista\"."
    eva "Depois do incidente na sauna, você estava fadado a transar com [eri] mais cedo ou mais tarde, e parecia que você precisava de um empurrãozinho com toda aquela história de \"quando você estiver pronto\"."

# game/scripts/c16/c16.rpy:2555
translate brazilian c16s003_ShootingLessons_cc79a3a1:

    # eva "Y pensé... ¿por qué no catarlo yo antes y a la vez darte ese empujón? Ya lo sé, estúpido y ridículo."
    eva "E eu pensei... por que não tentar eu mesmo primeiro e te dar esse empurrãozinho? Eu sei, estúpido e ridículo."

# game/scripts/c16/c16.rpy:2556
translate brazilian c16s003_ShootingLessons_6c5fbb10:

    # mc "Aparte de todo lo que hay de malo en ese plan, no se te ocurrió pensar que, cuando tuviéramos sexo por primera vez, yo me sorprendería de que siguiera siendo virgen, ¿verdad?"
    mc "Além de todos os problemas que esse plano tinha, você não imaginou que, quando fizéssemos sexo pela primeira vez, eu ficaria surpresa por ainda ser virgem, não é?"

# game/scripts/c16/c16.rpy:2558
translate brazilian c16s003_ShootingLessons_3b39a5ec:

    # eva "Después de lo de la sauna, creí que necesitabas un empujón en la dirección de [eri]."
    eva "Depois do incidente na sauna, achei que você precisava de um empurrão na direção de [eri]."

# game/scripts/c16/c16.rpy:2559
translate brazilian c16s003_ShootingLessons_2aaf23b4:

    # eva "A la chica le gustas mucho."
    eva "A garota gosta muito de você."

# game/scripts/c16/c16.rpy:2560
translate brazilian c16s003_ShootingLessons_93064ed0:

    # eva "Y pensé... que si podía llevarme una alegría mientras ayudaba un poco a [eri], ¿por qué no? Ya lo sé, estúpido y ridículo."
    eva "E eu pensei... se eu pudesse sentir alguma alegria enquanto ajudava um pouco [eri], por que não? Eu sei, estúpido e ridículo."

# game/scripts/c16/c16.rpy:2561
translate brazilian c16s003_ShootingLessons_0965790e:

    # mc "Aparte de todo lo que hay de malo en ese plan, no se te ocurrió que, si hubiera funcionado, yo me hubiera sorprendido de que siguiera siendo virgen, ¿verdad?"
    mc "Além de todos os problemas que esse plano tinha, você não pensou que, se tivesse dado certo, eu ficaria surpresa por ainda ser virgem, não é?"

# game/scripts/c16/c16.rpy:2562
translate brazilian c16s003_ShootingLessons_5cdd8eba:

    # mc "Podrías haber arruinado nuestra relación con ese plan tuyo. Nuestra primera vez juntos no hubiera significado lo mismo."
    mc "Você poderia ter arruinado nosso relacionamento com esse seu plano. Nossa primeira vez juntos não teria sido a mesma coisa."

# game/scripts/c16/c16.rpy:2564
translate brazilian c16s003_ShootingLessons_975add47:

    # eva "Ya te he dicho que fue estúpido. Parece uno de los planes de [emm]. A veces me parezco más a [emm] que a [dap] o a [eri]."
    eva "Eu já te disse que era estúpido. Parece um dos planos de [emm]. Às vezes eu sou mais parecido com [emm] do que com [dap] ou [eri]."

# game/scripts/c16/c16.rpy:2565
translate brazilian c16s003_ShootingLessons_9d2dc00a:

    # eva "Espero que no me odies por ello. Me arrepiento mucho de haberlo intentado."
    eva "Espero que você não me odeie por isso. Me arrependo profundamente de ter tentado."

# game/scripts/c16/c16.rpy:2566
translate brazilian c16s003_ShootingLessons_1ab31e72:

    # mc "No, Eva. Ayer me sentí estúpido cuando até cabos. Pero no te odio."
    mc "Não, Eva. Eu me senti idiota ontem quando juntei as peças. Mas eu não te odeio."

# game/scripts/c16/c16.rpy:2567
translate brazilian c16s003_ShootingLessons_321b543c:

    # mc "Es algo que yo no hubiera hecho nunca... Y sí. Es ridículo. Quiero que me prometas que no se volverá a repetir."
    mc "É algo que eu jamais teria feito... E sim, é ridículo. Quero que você me prometa que não vai acontecer de novo."

# game/scripts/c16/c16.rpy:2569
translate brazilian c16s003_ShootingLessons_0cb1f14a:

    # eva "Ahora no tiene sentido que se repita. Ahora me caes bien y no creo que tu relación con [eri] vaya a cambiar mucho. O con [dap]."
    eva "Não há necessidade de repetir agora. Eu gosto de você agora, e não acho que seu relacionamento com [eri] vá mudar muito. Ou com [dap]."

# game/scripts/c16/c16.rpy:2570
translate brazilian c16s003_ShootingLessons_512d083c:

    # mc "¿Ahora te caigo bien? ¿Antes no?"
    mc "Você gosta de mim agora? Não gostava antes?"

# game/scripts/c16/c16.rpy:2572
translate brazilian c16s003_ShootingLessons_29db94d3:

    # eva "¡Oops! ¿Ves como me parezco a [emm]? No sé tener la boca cerrada."
    eva "Ops! Veja como eu pareço [emm]? Não consigo ficar de boca fechada."

# game/scripts/c16/c16.rpy:2573
translate brazilian c16s003_ShootingLessons_431475a2:

    # eva "La verdad es que con lo que veía cuando llegaste... me parecías un poco manipulador."
    eva "A verdade é que, pelo que vi quando você chegou... você pareceu um pouco manipulador(a)."

# game/scripts/c16/c16.rpy:2575
translate brazilian c16s003_ShootingLessons_3491d572:

    # eva "Tienes que entenderlo. Llevábamos dos meses vigilando a tu familia. Son bastante adorables y nos salió el instinto protector."
    eva "Você precisa entender. Estamos de olho na sua família há dois meses. Eles são muito simpáticos, e nosso instinto protetor falou mais alto."

# game/scripts/c16/c16.rpy:2576
translate brazilian c16s003_ShootingLessons_43725223:

    # eva "Llegas tú y todo empezó a cambiar. Empiezaron a haber secretos y... No, no me caías bien... pero estabas bueno."
    eva "Então você apareceu e tudo começou a mudar. Segredos começaram a vir à tona e... Não, eu não gostava de você... mas você era atraente."

# game/scripts/c16/c16.rpy:2577
translate brazilian c16s003_ShootingLessons_be678b85:

    # mc "Puedo entenderlo. Y me alegra que no se vaya a repetir. Y de que tengas ese instinto hacia las chicas."
    mc "Eu entendo. E fico feliz que não vá acontecer de novo. E que você tenha esse instinto em relação às garotas."

# game/scripts/c16/c16.rpy:2578
translate brazilian c16s003_ShootingLessons_1184be89:

    # mc "Bueno, estamos a cinco minutos de casa. ¿Quieres pasar por mi casa a cambiarte de ropa? La comida será en casa de [nor]."
