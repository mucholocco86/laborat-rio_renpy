# game/scripts/c16/c16.rpy:2772
translate brazilian c16s003_LunchWithEva_87f4593a:

    # mc "Muy bien. Me ha enseñado a disparar... un poco. Y hemos estado charlando. Ya te contaré. Ha tenido una infancia... diferente."
    mc "Muito bem. Ele me ensinou a atirar... um pouco. E nós ficamos conversando. Eu te conto depois. Ele teve uma infância... diferente."

# game/scripts/c16/c16.rpy:2774
translate brazilian c16s003_LunchWithEva_70b91aa6:

    # mom "¿Por qué no te vas a cambiar? No vas a comer con la ropa de correr, ¿verdad?"
    mom "Por que você não vai se trocar? Você não vai comer com a roupa de corrida, vai?"

# game/scripts/c16/c16.rpy:2775
translate brazilian c16s003_LunchWithEva_0807a31c:

    # mc "¿Quieres que la deje sola con vosotras? Piensa que yo tengo que subir más días al lago con ella y su venganza puede ser cruél. *Risa*"
    mc "Você quer que eu a deixe sozinha com você? Lembre-se que ainda tenho que ir até o lago com ela por mais alguns dias, e a vingança dela pode ser cruel. *Risos*"

# game/scripts/c16/c16.rpy:2777
translate brazilian c16s003_LunchWithEva_389258af:

    # mom "No somos tan malas. *Risa* Abrumadoras sí, pero malas no. Además, apestas un poco."
    mom "Não somos tão ruins assim. *Risos* É muita coisa, sim, mas não é ruim. Além disso, você é meio ruim."

# game/scripts/c16/c16.rpy:2778
translate brazilian c16s003_LunchWithEva_9af0ee6f:

    # mc "Vale, voy a darme una ducha rápida y ahora vuelvo. *Risa*"
    mc "Ok, vou tomar um banho rápido e já volto. *Risos*"

# game/scripts/c16/c16.rpy:2781
translate brazilian c16s003_LunchWithEva_75866e1d:

    # mom "*Susurrando* Por cierto, he dejado mi... *Susurrando más aún* prueba de embarazo... en tu habitación, en el armario grande. Ahí estará más segura."
    mom "*Sussurrando* A propósito, deixei meu... *Sussurrando ainda mais* teste de gravidez... no seu quarto, no armário grande. Vai ficar mais seguro lá."

# game/scripts/c16/c16.rpy:2783
translate brazilian c16s003_LunchWithEva_4f5334ff:

    # mom "*Susurrando* [nor] me ha dicho que [dap] casi la encuentra esta mañana mientras buscaba un top que ponerse. ¡Como que [dap] iba a llenar un top de [nor]!"
    mom "*Sussurrando* [nor] me contou que [dap] quase esbarrou nela hoje de manhã enquanto procurava uma blusa para vestir. Como se [dap] fosse encher uma blusa com [nor]!"

# game/scripts/c16/c16.rpy:2785
translate brazilian c16s003_LunchWithEva_ebbd1574:

    # mom "*Susurrando* [emm] casi la encuentra esta mañana mientras buscaba algo que ponerse en mi armario."
    mom "*Sussurrando* [emm] Quase encontrei esta manhã enquanto procurava algo para vestir no meu armário."

# game/scripts/c16/c16.rpy:2786
translate brazilian c16s003_LunchWithEva_dd23c706:

    # mc "*Susurrando* Perfecto, [mar.mc!t]. En mi armario nadie va a buscar nada. Cuando llegue la hora sube y lo comprobamos."
    mc "*Sussurrando* Perfeito, [mar.mc!t]. Ninguém vai mexer no meu armário. Quando chegar a hora, suba e a gente dá uma olhada."

# game/scripts/c16/c16.rpy:2787
translate brazilian c16s003_LunchWithEva_049594b2:

    # mc "Voy a darme esa ducha antes de que me dejen sin comida. *Risa* Voy a decírselo a Eva."
    mc "Vou tomar esse banho antes que me deixem sem comida. *Risos* Vou contar para a Eva."

# game/scripts/c16/c16.rpy:2789
translate brazilian c16s003_LunchWithEva_2ad7dba9:

    # mc "Eva, ¿puedo hablar un momento contigo?"
    mc "Eva, posso falar com você um instante?"

# game/scripts/c16/c16.rpy:2790
translate brazilian c16s003_LunchWithEva_b3661827:

    # emm "¡No puedes llevártela ahora! ¡Acaba de llegar!"
    emm "Você não pode levar agora! Acabou de chegar!"

# game/scripts/c16/c16.rpy:2791
translate brazilian c16s003_LunchWithEva_db315a44:

    # eri "Ha dicho que es un momento, [emm]."
    eri "Ele disse que é um momento, [emm]."

# game/scripts/c16/c16.rpy:2792
translate brazilian c16s003_LunchWithEva_07a7b5da:

    # dap "Nos la devuelves en seguida, ¿verdad?"
    dap "Você vai nos devolver imediatamente, certo?"

# game/scripts/c16/c16.rpy:2793
translate brazilian c16s003_LunchWithEva_40e50bb5:

    # eva "Ahora vuelvo, chicas. No voy a dejar que me secuestre. *Risita*"
    eva "Já volto, meninas. Não vou deixar ele me sequestrar. *Risos*"

# game/scripts/c16/c16.rpy:2795
translate brazilian c16s003_LunchWithEva_c0579bb2:

    # eva "Dime."
    eva "Diga-me."

# game/scripts/c16/c16.rpy:2796
translate brazilian c16s003_LunchWithEva_feab26bb:

    # mc "¿Cómo lo llevas? ¿Te estamos agobiando mucho?"
    mc "Como você está lidando com isso? Estamos te sobrecarregando?"

# game/scripts/c16/c16.rpy:2797
translate brazilian c16s003_LunchWithEva_c9f22343:

    # eva "Más que agobiando, abrumando un poco. Pero todo está bien. Raro, pero bien."
    eva "Mais do que avassalador, é um pouco assustador. Mas está tudo bem. Estranho, mas bem."

# game/scripts/c16/c16.rpy:2798
translate brazilian c16s003_LunchWithEva_fda0182f:

    # mc "Voy a dejarte un momento en sus manos. Me acaban de decir que apesto un poco y voy a darme una ducha y a cambiarme."
    mc "Vou te deixar aos cuidados deles por um instante. Acabei de ser informada de que estou com um cheiro um pouco ruim, então vou tomar um banho e me trocar."

# game/scripts/c16/c16.rpy:2800
translate brazilian c16s003_LunchWithEva_9401856e:

    # eva "¿No vas a quedarte a comer?"
    eva "Você não vai ficar para o almoço?"

# game/scripts/c16/c16.rpy:2801
translate brazilian c16s003_LunchWithEva_8dd9ea08:

    # mc "Sí, va a ser una ducha rápida y vuelvo en un momento. ¿Estarás bien?"
    mc "Sim, vou tomar só um banho rápido e já volto. Você vai ficar bem?"

# game/scripts/c16/c16.rpy:2803
translate brazilian c16s003_LunchWithEva_d97b00b1:

    # eva "C-creo que sí... creo que estaba más preocupada de lo necesario."
    eva "Acho que sim... Acho que me preocupei mais do que o necessário."

# game/scripts/c16/c16.rpy:2804
translate brazilian c16s003_LunchWithEva_b7c8d2a4:

    # mc "Si necesitas algún plan de extracción, habla con [mar] o [nor]. Ellas te ayudarán."
    mc "Se você precisar de um plano de extração, fale com [mar] ou [nor]. Eles irão te ajudar."

# game/scripts/c16/c16.rpy:2806
translate brazilian c16s003_LunchWithEva_ca7d62e0:

    # eva "¡Gracias!"
    eva "Obrigado!"

# game/scripts/c16/c16.rpy:2807
translate brazilian c16s003_LunchWithEva_7b1f4816:

    # mc "¡Hey! ¿A qué viene ese abrazo?"
    mc "Ei! Que abraço foi esse?"

# game/scripts/c16/c16.rpy:2809
translate brazilian c16s003_LunchWithEva_92824df2:

    # eva "Costumbres familiares, dijiste. Me pone triste haber sido tan tonta. Haberte prejuzgado..."
    eva "\"Costumes familiares\", você disse. Fico triste por ter sido tão tolo. Por ter te julgado tão duramente..."

# game/scripts/c16/c16.rpy:2810
translate brazilian c16s003_LunchWithEva_176fdc2a:

    # eva "No eres manipulador, solo un idiota que no sabe que no debe preocuparse tanto por las chicas de la familia. Sabemos... saben cuidarse solas."
    eva "Você não é manipulador, você é apenas um idiota que não sabe que não deveria se preocupar tanto com as meninas da família. Nós sabemos... elas sabem se cuidar."

# game/scripts/c16/c16.rpy:2811
translate brazilian c16s003_LunchWithEva_fca1fa8c:

    # mc "¿Acabas de decir \"sabemos\"? *Risa*"
    mc "Você acabou de dizer \"nós sabemos\"? *Risos*"

# game/scripts/c16/c16.rpy:2813
translate brazilian c16s003_LunchWithEva_92380e41:

    # eva "¡Joder! Hacéis muy difícil no sentirse aceptada. Me han dicho \"bienvenida a la familia\" quince veces en cinco minutos."
    eva "Caramba! Vocês tornam tão difícil não se sentir aceito. Já me disseram \"bem-vindo à família\" quinze vezes em cinco minutos."

# game/scripts/c16/c16.rpy:2814
translate brazilian c16s003_LunchWithEva_e0f693e3:

    # mc "Ya te lo dije. Ahora solo hace falta que te lo termines de creer."
    mc "Eu já te disse. Agora você só precisa acreditar."

# game/scripts/c16/c16.rpy:2816
translate brazilian c16s003_LunchWithEva_3babefea:

    # "Eva te abraza un poco más fuerte durante un segundo, apoyando su cabeza contra tu cuello."
    "Eva te abraça um pouco mais forte por um segundo, encostando a cabeça no seu pescoço."

# game/scripts/c16/c16.rpy:2817
translate brazilian c16s003_LunchWithEva_77a2abd6:

    # eva "Bueno, vete ya. Al final tu peste se me va a pegar a la ropa."
    eva "Ok, vá embora agora. Seu fedor vai acabar impregnando minhas roupas."

# game/scripts/c16/c16.rpy:2818
translate brazilian c16s003_LunchWithEva_ff158c35:

    # mc "Bonita forma de decir que prefieres estar con las chicas a estar conmigo. *Risa*"
    mc "Uma forma elegante de dizer que você prefere estar com as garotas do que comigo. *Risos*"

# game/scripts/c16/c16.rpy:2819
translate brazilian c16s003_LunchWithEva_241ddbc7:

    # mc "Vuelvo en un rato. No dejes que te agobien demasiado."
    mc "Já volto. Não deixe que isso te sobrecarregue demais."

# game/scripts/c16/c16.rpy:2821
translate brazilian c16s003_LunchWithEva_7fabacc8:

    # mc "Hola, Saira. Hola, Kate. ¿Habéis comido ya?"
    mc "Oi Saira. Oi Kate. Vocês já comeram?"

# game/scripts/c16/c16.rpy:2822
translate brazilian c16s003_LunchWithEva_5b29a970:

    # sai "Sí, Lisa y Kim tenían clase esta tarde y hemos comido todas juntas antes de que se fueran."
    sai "Sim, Lisa e Kim tiveram aula esta tarde e todos nós jantamos juntos antes de elas irem embora."

# game/scripts/c16/c16.rpy:2823
translate brazilian c16s003_LunchWithEva_5c9c51b9:

    # kat "Después de tener La Conversación. Por cierto, una oportunidad perdida de llamarla... *Voz profunda* \"La Clonversación\". *Risa*"
    kat "Depois de termos tido A Conversa. Aliás, uma oportunidade perdida de chamá-la de... *Voz grave* \"A Clonconversação\". *Risos*"

# game/scripts/c16/c16.rpy:2824
translate brazilian c16s003_LunchWithEva_5e013d06:

    # mc "*Risa* No se me había ocurrido"
    mc "*Risos* Eu não tinha pensado nisso."

# game/scripts/c16/c16.rpy:2825
translate brazilian c16s003_LunchWithEva_3df6fa10:

    # mc "¿No vais a ir a la comida con Eva?"
    mc "Você não vai almoçar com a Eva?"

# game/scripts/c16/c16.rpy:2827
translate brazilian c16s003_LunchWithEva_a194e8af:

    # kat "[mar] nos ha dicho que fuéramos, pero hemos pensado que era mejor dejaros un rato en familia. Pasaremos luego a conocerla."
    kat "[mar] nos disse para virmos, mas achamos melhor deixá-lo com sua família por um tempo. Iremos encontrá-la mais tarde."

# game/scripts/c16/c16.rpy:2828
translate brazilian c16s003_LunchWithEva_5f367032:

    # sai "Y tú deberías estar allí, ¿no?"
    sai "E você deveria estar lá, não deveria?"

# game/scripts/c16/c16.rpy:2829
translate brazilian c16s003_LunchWithEva_98e156c0:

    # mc "Voy a ducharme y a cambiarme."
    mc "Vou tomar um banho e me trocar."

# game/scripts/c16/c16.rpy:2831
translate brazilian c16s003_LunchWithEva_85b0831c:

    # sai "No te entretenemos más entonces. Por cierto, buenos días."
    sai "Não vamos mais te incomodar. A propósito, bom dia."

# game/scripts/c16/c16.rpy:2832
translate brazilian c16s003_LunchWithEva_35324926:

    # mc "Buenos días, Saira. *Risa*"
    mc "Bom dia, Saira. *Risos*"

# game/scripts/c16/c16.rpy:2833
translate brazilian c16s003_LunchWithEva_3e841c14:

    # mc "Luego tengo que hablar contigo."
    mc "Preciso falar com você mais tarde."

# game/scripts/c16/c16.rpy:2834
translate brazilian c16s003_LunchWithEva_ea965c45:

    # sai "OK."
    sai "OK."

# game/scripts/c16/c16.rpy:2837
translate brazilian c16s003_LunchWithEva_741044eb:

    # kat "Buenos días, [mc]."
    kat "Bom dia, [mc]."

# game/scripts/c16/c16.rpy:2838
translate brazilian c16s003_LunchWithEva_f5d23c52:

    # mc "Buenos días, Kate."
    mc "Bom dia, Kate."

# game/scripts/c16/c16.rpy:2840
translate brazilian c16s003_LunchWithEva_d4eeb63f:

    # kat "Vete a duchar antes de que nos aromatizes la planta con Eau de Sobac. *Risa* ¡Apestas!"
    kat "Vá tomar um banho antes de perfumar a planta com Eau de Sobac. *Risos* Você está fedendo!"

# game/scripts/c16/c16.rpy:2841
translate brazilian c16s003_LunchWithEva_597d90d7:

    # sai "¡Es verdad! *Risa* Yo notaba un olor conocido y no lo localizaba."
    sai "Isso mesmo! *Risos* Percebi um cheiro familiar, mas não consegui identificar de onde era."

# game/scripts/c16/c16.rpy:2842
translate brazilian c16s003_LunchWithEva_74cf13bd:

    # mc "A lo mejor es por la costumbre de Kate de ir descalza. *Risa* Eau de Rochefort."
    mc "Talvez seja por causa do hábito da Kate de andar descalça. *Risos* Eau de Rochefort."

# game/scripts/c16/c16.rpy:2843
translate brazilian c16s003_LunchWithEva_4c4d2b0d:

    # mc "Me voy antes de que empecéis a deprimirme. *Risa*"
    mc "Estou indo embora antes que vocês comecem a me deprimir. *Risos*"

# game/scripts/c16/c16.rpy:2845
translate brazilian c16s003_LunchWithEva_4923eed1:

    # "Vuelves a la cocina de [nor] después de ducharte y, tal como te imaginabas, Eva es el centro de atención de las chicas. Las mujeres se mantienen apartadas, hablando entre ellas."
    "Você retorna à cozinha de [nor] após o banho e, como você esperava, Eva é o centro das atenções das garotas. As mulheres ficam juntas, conversando entre si."

# game/scripts/c16/c16.rpy:2846
translate brazilian c16s003_LunchWithEva_6e78f223:

    # eva "... y entonces Amanda me avisó por radio y..."
    eva "...e então Amanda me chamou pelo rádio e..."

# game/scripts/c16/c16.rpy:2848
translate brazilian c16s003_LunchWithEva_ad2c1764:

    # eva "Ya ha vuelto la mofeta. *Risa*"
    eva "O gambá voltou. *Risos*"

# game/scripts/c16/c16.rpy:2849
translate brazilian c16s003_LunchWithEva_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c16/c16.rpy:2850
translate brazilian c16s003_LunchWithEva_c0c00b97:

    # mc "Parece que ya te estás integrando en la familia. *Risa* El deporte familiar es reírse de mí."
    mc "Parece que você já está se adaptando à família. *Risos* O pessoal do esporte em família está rindo de mim."

# game/scripts/c16/c16.rpy:2851
translate brazilian c16s003_LunchWithEva_c8490af3:

    # emm "Porque te lo mereces. Siempre haces algo para que nos riamos contigo y de ti."
    emm "Porque você merece. Você sempre faz algo para nos fazer rir com você e de você."

# game/scripts/c16/c16.rpy:2852
translate brazilian c16s003_LunchWithEva_220d4b3f:

    # eri "No como tú, ¿verdad, [emm]? *Risa*"
    eri "Não como você, né, [emm]? *Risos*"

# game/scripts/c16/c16.rpy:2853
translate brazilian c16s003_LunchWithEva_f758be34:

    # dap "Al menos él lo suele hacer a propósito. *Risa*"
    dap "Pelo menos ele costuma fazer isso de propósito. *Risos*"

# game/scripts/c16/c16.rpy:2854
translate brazilian c16s003_LunchWithEva_46ca4104:

    # sca "*Risa* Y nadie le suele prohibir ningún color."
    sca "*Risos* E normalmente ninguém lhe proíbe nenhuma cor."

# game/scripts/c16/c16.rpy:2856
translate brazilian c16s003_LunchWithEva_13a76ecd:

    # emm "Ni siquiera en mi cumpleaños me vais a dejar tranquila, ¿verdad?"
    emm "Você não vai me deixar em paz nem no meu aniversário, vai?"

# game/scripts/c16/c16.rpy:2857
translate brazilian c16s003_LunchWithEva_962e612f:

    # mc "Elige. No nos reímos de ti hoy o el domingo."
    mc "Escolha. Não vamos rir de você hoje nem no domingo."

# game/scripts/c16/c16.rpy:2858
translate brazilian c16s003_LunchWithEva_e64c798e:

    # emm "*Gruñido* El domingo. Es el cumpleaños de verdad."
    emm "*Grunhido* Domingo. É o aniversário de verdade."

# game/scripts/c16/c16.rpy:2859
translate brazilian c16s003_LunchWithEva_b3b94564_1:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c16/c16.rpy:2861
translate brazilian c16s003_LunchWithEva_8024e8af:

    # mom "Ve a comer algo. Es tarde y todo el mundo estaba hambriento. Si [nor] y yo no llegamos a intervenir no te hubieran dejado nada."
    mom "Vá comer alguma coisa. Já é tarde e todos estavam com fome. Se eu e [nor] não tivéssemos intervido, eles não teriam deixado nada para você."

# game/scripts/c16/c16.rpy:2862
translate brazilian c16s003_LunchWithEva_a935706d:

    # mc "Gracias, [mar.mc!t]."
    mc "Obrigado, [mar.mc!t]."

# game/scripts/c16/c16.rpy:2863
translate brazilian c16s003_LunchWithEva_5f6e293a:

    # mom "Te he dejado un plato con pato, salmon, rollitos, carne con gambas, y falafel al lado del fregadero. No sabíamos que le gustaría a Eva."
    mom "Deixei um prato com pato, salmão, rolinhos primavera, carne com camarão e falafel ao lado da pia. Não sabíamos o que Eva gostaria."

# game/scripts/c16/c16.rpy:2865
translate brazilian c16s003_LunchWithEva_0678140b:

    # "Ver esta reunión y cómo Eva se siente más cómoda de lo que nunca hubiera pensado te llena de alegría de alguna forma."
    "Ver esse encontro e perceber como Eva se sente mais à vontade do que jamais imaginou ser possível nos enche de alegria de alguma forma."

# game/scripts/c16/c16.rpy:2866
translate brazilian c16s003_LunchWithEva_91a4b366:

    # "Después de lo que ha contado sobre su infancia... sí, como diría ella, te sientes como un idiota con ganas de protegerla."
    "Depois do que ela disse sobre a infância dela... é, como ela mesma diria, você se sente um idiota por querer protegê-la."

# game/scripts/c16/c16.rpy:2869
translate brazilian c16s003_LunchWithEva_2516780d:

    # "Proteger. A Eva. La protectora. Quizás la tengas que proteger de cosas que ni siquiera sabe que existen. De las amenazas de una vida normal."
    "Proteger. Eva. A protetora. Talvez você tenha que protegê-la de coisas que ela nem sabe que existem. Das ameaças de uma vida normal."

# game/scripts/c16/c16.rpy:2871
translate brazilian c16s003_LunchWithEva_be289a5c:

    # eri "Es especial, ¿verdad?"
    eri "É especial, não é?"

# game/scripts/c16/c16.rpy:2873
translate brazilian c16s003_LunchWithEva_a18e2524:

    # mc "¡Oh, [eri]! No te había visto. Estaba inmerso en mis pensamientos."
    mc "Oh, [eri]! Eu não tinha te visto. Estava absorto em pensamentos."

# game/scripts/c16/c16.rpy:2874
translate brazilian c16s003_LunchWithEva_bbad04e8:

    # mc "Sí, lo es. Ha tenido una vida tan diferente de lo que estamos acostumbrados que llamarla especial es quedarse corto."
    mc "Sim, ela é. Ela teve uma vida tão diferente da que estamos acostumados que chamá-la de especial é um eufemismo."

# game/scripts/c16/c16.rpy:2875
translate brazilian c16s003_LunchWithEva_81778c0a:

    # eri "Cuando te has ido parecía un animalillo acorralado. Hasta que mi madre le ha dado un abrazo y..."
    eri "Quando você saiu, ele parecia um bichinho encurralado. Até que minha mãe o abraçou e..."

# game/scripts/c16/c16.rpy:2878
translate brazilian c16s003_LunchWithEva_a3f86bb8:

    # eri "Hasta cierto punto también es su madre, ¿no?"
    eri "Em certa medida, ela também é mãe dele, não é?"

# game/scripts/c16/c16.rpy:2880
translate brazilian c16s003_LunchWithEva_3c9b0d23:

    # eri "Mi madre..."
    eri "Minha mãe..."

# game/scripts/c16/c16.rpy:2881
translate brazilian c16s003_LunchWithEva_213694ad:

    # mc "¿Cómo ha ido La Conversación?"
    mc "Como foi a conversa?"

# game/scripts/c16/c16.rpy:2883
translate brazilian c16s003_LunchWithEva_8f8ae0f8:

    # eri "Aún la estoy asimilando. No sé como sentirme..."
    eri "Ainda estou processando tudo. Não sei como me sentir..."

# game/scripts/c16/c16.rpy:2885
translate brazilian c16s003_LunchWithEva_9c448045:

    # eri "Saber que tengo una segunda gemela... y que perdí dos por el camino a quien nunca conoceré... es raro... y duro..."
    eri "Saber que tenho uma segunda irmã gêmea... e que perdi duas ao longo da vida que nunca conhecerei... é estranho... e difícil..."

# game/scripts/c16/c16.rpy:2886
translate brazilian c16s003_LunchWithEva_c102ed34:

    # eri "El mismo día que gano una hermana me entero que he perdido a dos."
    eri "No mesmo dia em que ganho uma irmã, descubro que perdi duas."

# game/scripts/c16/c16.rpy:2888
translate brazilian c16s003_LunchWithEva_37872221:

    # eri "Pero he ganado una hermana y ganaré una prima esta noche. No me puedo quejar demasiado... ¿verdad?"
    eri "Mas ganhei uma irmã e ganharei uma prima esta noite. Não posso reclamar muito... posso?"

# game/scripts/c16/c16.rpy:2890
translate brazilian c16s003_LunchWithEva_3bb3cddf:

    # eri "Saber que mi madre no es mi madre biológica... que no tengo madre biológica... es raro... y duro..."
    eri "Saber que minha mãe não é minha mãe biológica... que eu não tenho uma mãe biológica... é estranho... e difícil..."

# game/scripts/c16/c16.rpy:2891
translate brazilian c16s003_LunchWithEva_ea86602e:

    # eri "Mi madre siempre será mi madre. No importa que no lleve sus genes... pero es difícil de asimilar."
    eri "Minha mãe sempre será minha mãe. Não importa que eu não tenha herdado seus genes... mas é difícil aceitar."

# game/scripts/c16/c16.rpy:2893
translate brazilian c16s003_LunchWithEva_d0630f8b:

    # eri "Pero he ganado una hermana y no pienso perder a mi madre, con lo que, en el fondo, no me puedo quejar demasiado... ¿verdad?"
    eri "Mas ganhei uma irmã e não pretendo perder minha mãe, então, no fundo, não posso reclamar muito... né?"

# game/scripts/c16/c16.rpy:2894
translate brazilian c16s003_LunchWithEva_5148d458:

    # mc "¿Un abrazo?"
    mc "Um abraço?"

# game/scripts/c16/c16.rpy:2895
translate brazilian c16s003_LunchWithEva_389e215f:

    # eri "Sí, por favor..."
    eri "Sim, por favor..."

# game/scripts/c16/c16.rpy:2897
translate brazilian c16s003_LunchWithEva_d24d96d7:

    # "Os abrazáis en silencio durante unos minutos. Conoces lo suficientemente bien a [eri] como para saber que solo necesita el abrazo. No necesita, no quiere, que hables en ese momento."
    "Vocês se abraçam em silêncio por alguns minutos. Você conhece [eri] bem o suficiente para saber que tudo o que ela precisa é do abraço. Ela não precisa, não quer, que você fale naquele momento."

# game/scripts/c16/c16.rpy:2899
translate brazilian c16s003_LunchWithEva_d4bc4005:

    # eri "Ya está, gracias..."
    eri "É isso, obrigado..."

# game/scripts/c16/c16.rpy:2900
translate brazilian c16s003_LunchWithEva_03bcbd68:

    # mc "Ya sabes que me encanta abrazarte. No deberías dar las gracias por ello."
    mc "Você sabe que eu adoro te abraçar. Você não precisa me agradecer por isso."

# game/scripts/c16/c16.rpy:2903
translate brazilian c16s003_LunchWithEva_baba7214:

    # eri "El día que no le de las gracias a mi novio por un abrazo..."
    eri "O dia em que eu não agradecer ao meu namorado por um abraço..."

# game/scripts/c16/c16.rpy:2904
translate brazilian c16s003_LunchWithEva_14ded962:

    # eri "Hablando de novios... mi madre me ha hablado de las pruebas de embarazo. Me gustaría hacérmela."
    eri "Por falar em namorados... minha mãe me contou sobre testes de gravidez. Eu gostaria de fazer um."

# game/scripts/c16/c16.rpy:2905
translate brazilian c16s003_LunchWithEva_82f87563:

    # mc "Las tengo en mi habitación. Después de comer si quieres vamos a hacerla, y mañana sabremos el resultado."
    mc "Tenho-os no meu quarto. Depois do almoço, se quiser, podemos fazê-lo e saberemos o resultado amanhã."

# game/scripts/c16/c16.rpy:2906
translate brazilian c16s003_LunchWithEva_13ff2faa:

    # mc "¿Has notado algún síntoma?"
    mc "Você notou algum sintoma?"

# game/scripts/c16/c16.rpy:2908
translate brazilian c16s003_LunchWithEva_a4814f99:

    # eri "No, pero me gustaría saber si mi novio me ha dejado embarazada el mismo día que me desvirgó. *Risita*"
    eri "Não, mas eu gostaria de saber se meu namorado me engravidou no mesmo dia em que me desvirginou. *Risos*"

# game/scripts/c16/c16.rpy:2909
translate brazilian c16s003_LunchWithEva_df33eba7:

    # mc "A mí también me gustaría. Eso sería casi un record, ¿no?"
    mc "Eu também gostaria disso. Seria um recorde e tanto, não seria?"

# game/scripts/c16/c16.rpy:2910
translate brazilian c16s003_LunchWithEva_6e5dd189:

    # eri "Entonces, cuando acabe la comida te secuestro y vamos a tu habitación. A solas."
    eri "Então, quando terminarmos de comer, eu vou te sequestrar e iremos para o seu quarto. Sozinhos."

# game/scripts/c16/c16.rpy:2911
translate brazilian c16s003_LunchWithEva_ebffbfc7:

    # eri "Ahora voy ir al lavabo y a volver con Eva antes de que [emm] le pregunte a cuanta gente ha matado. Hasta ahora, cielo."
    eri "Vou ao banheiro agora e volto com a Eva antes que [emm] pergunte quantas pessoas ela matou. Até mais, querida."

# game/scripts/c16/c16.rpy:2912
translate brazilian c16s003_LunchWithEva_a84b9718:

    # mc "Hasta ahora, mi amor."
    mc "Até agora, meu amor."

# game/scripts/c16/c16.rpy:2915
translate brazilian c16s003_LunchWithEva_2d375889:

    # eri "Debería ir al lavabo y volver con Eva antes de que [emm] le pregunte a cuanta gente ha matado."
    eri "Eu deveria ir ao banheiro e voltar para Eva antes que [emm] pergunte a ela quantas pessoas ela matou."

# game/scripts/c16/c16.rpy:2916
translate brazilian c16s003_LunchWithEva_f16f0b17:

    # mc "Hasta ahora, [eri]."
    mc "Até agora, [eri]."

# game/scripts/c16/c16.rpy:2919
translate brazilian c16s003_LunchWithEva_d27faf05:

    # "Continúas comiendo mientras observas como se va desarrollando la reunión. Al cabo de un rato, [dap] y Scarlett se dirigen hacia ti."
    "Você continua comendo enquanto observa a reunião se desenrolar. Depois de um tempo, [dap] e Scarlett se aproximam de você."

# game/scripts/c16/c16.rpy:2922
translate brazilian c16s003_LunchWithEva_525cc9aa:

    # mc "¿Qué tal, chicas?"
    mc "Olá meninas!"

# game/scripts/c16/c16.rpy:2923
translate brazilian c16s003_LunchWithEva_790aa11e:

    # dap "Bien, Eva es fantástica."
    dap "Bem, Eva é fantástica."

# game/scripts/c16/c16.rpy:2924
translate brazilian c16s003_LunchWithEva_5fd4bf20:

    # sca "Es muy divertida. Y tiene fijación en hacer bromas sobre ti."
    sca "Ela é muito engraçada. E tem uma obsessão por fazer piadas sobre você."

# game/scripts/c16/c16.rpy:2925
translate brazilian c16s003_LunchWithEva_a83f03fe:

    # dap "Nos ha explicado tu cacería del topo en las lecciones de hoy. *Risa*"
    dap "Ele nos explicou a sua caça à toupeira na aula de hoje. *Risos*"

# game/scripts/c16/c16.rpy:2926
translate brazilian c16s003_LunchWithEva_47633bb5:

    # mc "Y, aparte de eso..."
    mc "E além disso..."

# game/scripts/c16/c16.rpy:2928
translate brazilian c16s003_LunchWithEva_3fbff912:

    # dap "Aparte de eso... quiero ir a Aruba."
    dap "Além disso... quero ir para Aruba."

# game/scripts/c16/c16.rpy:2929
translate brazilian c16s003_LunchWithEva_ce705018:

    # mc "¿Qué? ¿Por qué?"
    mc "O quê? Por quê?"

# game/scripts/c16/c16.rpy:2930
translate brazilian c16s003_LunchWithEva_f25d7f31:

    # dap "Bueno, ahora soy accionista de una empresa de tecnología punta. Quiero aprender todo lo posible sobre como funciona."
    dap "Bom, agora sou acionista de uma empresa de tecnologia de ponta. Quero aprender tudo o que puder sobre como ela funciona."

# game/scripts/c16/c16.rpy:2931
translate brazilian c16s003_LunchWithEva_1a25afb3:

    # dap "Incluso trabajar en NTR cuando acabe la carrera."
    dap "Até mesmo trabalhar na NTR quando eu terminar minha graduação."

# game/scripts/c16/c16.rpy:2933
translate brazilian c16s003_LunchWithEva_71d808a4:

    # sca "A mí tampoco me importaría trabajar allí. Me encanta la medicina, pero no sé si estoy hecha para tratar con pacientes."
    sca "Eu também não me importaria de trabalhar lá. Adoro medicina, mas não sei se tenho vocação para lidar com pacientes."

# game/scripts/c16/c16.rpy:2934
translate brazilian c16s003_LunchWithEva_4a04d38c:

    # sca "Espero que me contratéis para hacer investigación médica."
    sca "Espero que me contratem para realizar pesquisas médicas."

# game/scripts/c16/c16.rpy:2935
translate brazilian c16s003_LunchWithEva_2be33e05:

    # mc "Chicas, esperad. Acabáis de enteraros que NTR existe y ya estáis pensando en cambiar vuestros planes de futuro."
    mc "Meninas, esperem. Vocês acabaram de descobrir que NTR existe e já estão pensando em mudar seus planos para o futuro."

# game/scripts/c16/c16.rpy:2937
translate brazilian c16s003_LunchWithEva_0e2731a9:

    # dap "Es lógico hacerlo. Las circunstancias han cambiado y es una oportunidad increíble."
    dap "Faz sentido fazer isso. As circunstâncias mudaram e é uma oportunidade incrível."

# game/scripts/c16/c16.rpy:2938
translate brazilian c16s003_LunchWithEva_681ec9ba:

    # sca "No es cambiar los planes, sino adaptarlos a la nueva realidad. Clonación, nuevos dispositivos médicos... es el sueño de cualquier investigador."
    sca "Não se trata de mudar os planos, mas de adaptá-los à nova realidade. Clonagem, novos dispositivos médicos... é o sonho de todo pesquisador."

# game/scripts/c16/c16.rpy:2939
translate brazilian c16s003_LunchWithEva_7b9baae8:

    # dap "Y una legislación que no pone demasiados impedimentos." (multiple=2)
    dap "E uma legislação que não apresente muitos obstáculos." (multiple=2)

# game/scripts/c16/c16.rpy:2940
translate brazilian c16s003_LunchWithEva_37efe932:

    # sca "En un pais donde todo eso es legal." (multiple=2)
    sca "Num país onde tudo isso é legal." (multiple=2)

# game/scripts/c16/c16.rpy:2941
translate brazilian c16s003_LunchWithEva_46a6680d:

    # mc "Por suerte os quedan años para acabar vuestras carreras... aún os quedan meses para empezarla..."
    mc "Felizmente, você tem anos para concluir seus cursos... e ainda tem meses para começar o seu..."

# game/scripts/c16/c16.rpy:2942
translate brazilian c16s003_LunchWithEva_a071d4be:

    # mc "Aparte de eso, ¿como ha ido La Conversación?"
    mc "Além disso, como tem corrido a conversa?"

# game/scripts/c16/c16.rpy:2944
translate brazilian c16s003_LunchWithEva_c31717ed:

    # dap "Ha sido extraño. Saber que mi madre... y el resto... nos habéis ocultado algo tan importante como esto..."
    dap "Tem sido estranho. Saber que minha mãe... e todos vocês... esconderam algo tão importante quanto isso de nós..."

# game/scripts/c16/c16.rpy:2947
translate brazilian c16s003_LunchWithEva_a4c92c6a:

    # dap "Una empresa de tecnología punta, clonación, espionaje, secuestros... ¡Me encanta! Pero me hubiera gustado saberlo antes."
    dap "Uma empresa especializada em tecnologia de ponta, clonagem, espionagem, sequestros... Adorei! Mas gostaria de tê-la conhecido antes."

# game/scripts/c16/c16.rpy:2949
translate brazilian c16s003_LunchWithEva_dbe632d6:

    # dap "Creía que [eri] y yo éramos adoptadas. Ahora resulta que somos clones de Eva. ¡Mola mucho más!"
    dap "Eu achava que eu e [eri] éramos adotados. Agora descobrimos que somos clones da Eva. Isso é muito mais legal!"

# game/scripts/c16/c16.rpy:2950
translate brazilian c16s003_LunchWithEva_1cc99e46:

    # dap "Y tener a Eva delante es como mirarse en un espejo. Un espejo más musculoso de lo que yo nunca seré, pero un espejo."
    dap "E ter Eva na minha frente é como me olhar no espelho. Um espelho mais musculoso do que eu jamais serei, mas ainda assim um espelho."

# game/scripts/c16/c16.rpy:2952
translate brazilian c16s003_LunchWithEva_0b68b1b2:

    # dap "Sé que los genes no tienen nada que ver en cómo somos, aparte de físicamente, pero llevo toda la comida estudiándola esperando que reaccione de una forma... o ponga una expresión..."
    dap "Eu sei que os genes não têm nada a ver com quem somos, além da nossa aparência física, mas passei todo o meu tempo estudando comida, na esperança de que ela reagisse de uma certa maneira... ou fizesse uma certa expressão..."

# game/scripts/c16/c16.rpy:2953
translate brazilian c16s003_LunchWithEva_4006a498:

    # dap "Y la mayoría de veces actúa de una forma distinta de como lo haría yo."
    dap "E na maioria das vezes ele age de forma diferente da que eu agiria."

# game/scripts/c16/c16.rpy:2955
translate brazilian c16s003_LunchWithEva_d7401d97:

    # sca "Es raro ver como crece la familia. Y más aún creciendo de esta forma."
    sca "É estranho ver uma família crescer. E ainda mais quando cresce assim."

# game/scripts/c16/c16.rpy:2956
translate brazilian c16s003_LunchWithEva_f864bf12:

    # sca "No todos los días te enteras de que la clonación humana existe, ni de que tu mejor amiga es accionista de una empresa que la lleva a cabo."
    sca "Não é todo dia que se descobre que a clonagem humana existe, ou que seu melhor amigo é acionista de uma empresa que a realiza."

# game/scripts/c16/c16.rpy:2957
translate brazilian c16s003_LunchWithEva_65956472:

    # mc "Últimamente están pasando muchas cosas, y aún pueden pasar muchas cosas con la empresa."
    mc "Muita coisa tem acontecido ultimamente, e muita coisa mais pode acontecer com a empresa."

# game/scripts/c16/c16.rpy:2960
translate brazilian c16s003_LunchWithEva_738fa1d3:

    # dap "Hablando de la empresa... Mi madre me ha dicho que tienes unos test de embarazo especiales, por si alguna vez los necesito... desde la semana pasada sabe que tengo novio..."
    dap "Falando na empresa... Minha mãe me disse que vocês têm uns testes de gravidez especiais, caso eu precise algum dia... Ela sabe que eu tenho namorado desde a semana passada..."

# game/scripts/c16/c16.rpy:2961
translate brazilian c16s003_LunchWithEva_55a2125c:

    # mc "Sí, los tengo, pero aún no los puedes usar. Tienen que pasar 48 horas, con lo que hasta esta noche o mañana no van a servir."
    mc "Sim, eu os tenho, mas você ainda não pode usá-los. Eles precisam estar prontos em 48 horas, então só funcionarão hoje à noite ou amanhã."

# game/scripts/c16/c16.rpy:2962
translate brazilian c16s003_LunchWithEva_99cd6460:

    # dap "Mejor mañana entonces. Así aseguramos el resultado si me dejaste embarazada al segundo intento."
    dap "Melhor amanhã, então. Assim teremos certeza se você me engravidou na segunda tentativa."

# game/scripts/c16/c16.rpy:2965
translate brazilian c16s003_LunchWithEva_2024531d:

    # sca "¿Dos? ¿La misma noche? Yo no tuve tanta suerte..."
    sca "Duas? Na mesma noite? Eu não tive essa sorte..."

# game/scripts/c16/c16.rpy:2966
translate brazilian c16s003_LunchWithEva_8e3562a6:

    # mc "Tú no me dejaste quedarme a dormir. *Risa* ¿Tú también quieres hacerte la prueba?"
    mc "Você não me deixou ficar aqui. *Risos* Você também quer fazer o teste?"

# game/scripts/c16/c16.rpy:2968
translate brazilian c16s003_LunchWithEva_e1318a12:

    # sca "Sí. Puedo esperar a hacerla mañana con [dap]."
    sca "Sim. Posso esperar para fazer isso amanhã com [dap]."

# game/scripts/c16/c16.rpy:2969
translate brazilian c16s003_LunchWithEva_f36560a9:

    # mc "Perfecto entonces. Mañana llevo un par de pruebas a vuestra habitación."
    mc "Perfeito então. Levarei algumas amostras ao seu quarto amanhã."

# game/scripts/c16/c16.rpy:2971
translate brazilian c16s003_LunchWithEva_fe2ab8d2:

    # dap "¿Te imaginas que nos quedáramos embarazadas a la vez? Por cierto, me he pedido Maeve si es niña. *Risita*"
    dap "Você consegue imaginar se engravidássemos ao mesmo tempo? Aliás, já pedi o nome de Maeve se for menina. *Risos*"

# game/scripts/c16/c16.rpy:2972
translate brazilian c16s003_LunchWithEva_57835088:

    # sca "Yo aún no he pensado en nombres... la próxima vez que esté a solas con mi novio lo hablaremos. *Risita*"
    sca "Ainda não pensei em nenhum nome... conversaremos sobre isso na próxima vez que eu estiver sozinha com meu namorado. *Risos*"

# game/scripts/c16/c16.rpy:2975
translate brazilian c16s003_LunchWithEva_fc8a8deb:

    # sca "¿Te imaginas que te quedaras embarazada en tu primera cita? *Risita* "
    sca "Você consegue imaginar engravidar no primeiro encontro? *Risos*"

# game/scripts/c16/c16.rpy:2976
translate brazilian c16s003_LunchWithEva_f48016d0:

    # dap "Si es de [mc] me da lo mismo que sea en la primera o en la tercera. *Risita*"
    dap "Se for de [mc], não me importo se está na primeira ou na terceira página. *Risos*"

# game/scripts/c16/c16.rpy:2978
translate brazilian c16s003_LunchWithEva_3d7a8a28:

    # mc "Hablando de pasar cosas... Scarlett, tenemos unas pruebas de embarazo especiales, por si quieres hacerte la prueba."
    mc "Por falar em acontecimentos... Scarlett, temos alguns testes de gravidez especiais, caso você queira fazer um."

# game/scripts/c16/c16.rpy:2980
translate brazilian c16s003_LunchWithEva_ac94068e:

    # sca "Pero se necesitan 15 días o así para que sean efectivas, ¿no?"
    sca "Mas eles precisam de cerca de 15 dias para fazer efeito, certo?"

# game/scripts/c16/c16.rpy:2981
translate brazilian c16s003_LunchWithEva_e947d54f:

    # mc "No con estas. 48 horas después del sexo. Con lo que ya te las podrías hacer y tener el resultado mañana. Si quieres."
    mc "Com esses não. 48 horas após a relação sexual. Então você poderia fazer o exame e ter o resultado amanhã. Se quiser."

# game/scripts/c16/c16.rpy:2983
translate brazilian c16s003_LunchWithEva_7c05c25b:

    # sca "Si, quiero. *Risita* Ahora parece que me hayas pedido matrimonio. ¿Te va bien que lo hagamos mañana por la mañana? Hoy estás muy ocupado..."
    sca "Sim, eu aceito. *Risos* Parece que você me pediu em casamento. Amanhã de manhã seria bom? Você está muito ocupado hoje..."

# game/scripts/c16/c16.rpy:2984
translate brazilian c16s003_LunchWithEva_3af1604d:

    # mc "Perfecto. Mañana te llevo el test a vuestra habitación."
    mc "Perfeito. Levarei o teste ao seu quarto amanhã."

# game/scripts/c16/c16.rpy:2986
translate brazilian c16s003_LunchWithEva_07f080b3:

    # dap "¿Te imaginas que te quedaras embarazada en tu primera cita? *Risita* "
    dap "Você consegue imaginar engravidar no primeiro encontro? *Risos*"

# game/scripts/c16/c16.rpy:2987
translate brazilian c16s003_LunchWithEva_9f27126b:

    # sca "Si es de [mc] me da lo mismo que sea en la primera o en la tercera. *Risita*"
    sca "Se for de [mc], não me importo se está na primeira ou na terceira página. *Risos*"

# game/scripts/c16/c16.rpy:2989
translate brazilian c16s003_LunchWithEva_08595e82:

    # mc "[dap], ¿puedo hablar un momento a solas con Scarlett?"
    mc "[dap], posso falar com Scarlett a sós por um instante?"

# game/scripts/c16/c16.rpy:2991
translate brazilian c16s003_LunchWithEva_a37bb8d0:

    # dap "Por supuesto, yo debo volver a mirarme en los ojos de Eva."
    dap "É claro que preciso me olhar novamente nos olhos de Eva."

# game/scripts/c16/c16.rpy:2993
translate brazilian c16s003_LunchWithEva_bb4f9a94:

    # sca "¿Pasa algo, [mc]?"
    sca "Há algo errado, [mc]?"

# game/scripts/c16/c16.rpy:2994
translate brazilian c16s003_LunchWithEva_a845c0c4:

    # mc "Le he preguntado a Amanda y a Eva por los tests de ADN, sin decirle para quien era, y Amanda me traerá uno esta noche. Por si quieres que lo hagamos."
    mc "Perguntei à Amanda e à Eva sobre os testes de DNA, sem lhes dizer para quem eram, e a Amanda vai me trazer um hoje à noite. Só para o caso de você querer fazer."

# game/scripts/c16/c16.rpy:2996
translate brazilian c16s003_LunchWithEva_a9cb68de:

    # sca "¡Sí! ¿Cuándo podríamos tener los resultados?"
    sca "Sim! Quando podemos esperar os resultados?"

# game/scripts/c16/c16.rpy:2997
translate brazilian c16s003_LunchWithEva_ab5bab3f:

    # mc "Por lo que me ha dicho, el martes. No son de NTR, sino de un laboratorio de Atascadero."
    mc "Pelo que ele me disse, foi na terça-feira. Eles não são da NTR, mas de um laboratório em Atascadero."

# game/scripts/c16/c16.rpy:2998
translate brazilian c16s003_LunchWithEva_0456b85d:

    # sca "¡Genial! Tengo muchas ganas de saber si lo que sospechamos es cierto. Y de poder contárselo a la familia."
    sca "Ótimo! Estou muito ansioso para descobrir se o que suspeitamos é verdade. E para poder contar para minha família."

# game/scripts/c16/c16.rpy:2999
translate brazilian c16s003_LunchWithEva_707b74ba:

    # mc "A lo mejor no hay nada que contar."
    mc "Talvez não haja nada para contar."

# game/scripts/c16/c16.rpy:3001
translate brazilian c16s003_LunchWithEva_1c89d20c:

    # sca "Salga lo que salga... al menos saldremos de dudas."
    sca "Aconteça o que acontecer... pelo menos vamos descobrir."

# game/scripts/c16/c16.rpy:3003
translate brazilian c16s003_LunchWithEva_18317d0b:

    # sca "Lo podemos hacer mañana cuando hagamos el test de embarazo."
    sca "Podemos fazer isso amanhã, quando fizermos o teste de gravidez."

# game/scripts/c16/c16.rpy:3005
translate brazilian c16s003_LunchWithEva_5c7d69cb:

    # sca "Lo podemos hacer mañana por la mañana. Hoy va a haber mucho movimiento en casa. ¿Lo hacemos en mi habitación?"
    sca "Podemos fazer isso amanhã de manhã. Vai haver muita coisa acontecendo em casa hoje. Podemos fazer isso no meu quarto?"

# game/scripts/c16/c16.rpy:3006
translate brazilian c16s003_LunchWithEva_fc41272f:

    # mc "¿Con [dap]? ¿Qué le vamos a contar?"
    mc "Com [dap]? O que vamos dizer a ele?"

# game/scripts/c16/c16.rpy:3008
translate brazilian c16s003_LunchWithEva_32eb378b:

    # sca "Es posible... que se me escapara el otro día... sabe que existe la posibilidad de que haya encontrado a mi padre."
    sca "É possível... que eu tenha deixado escapar outro dia... que ele saiba que existe a possibilidade de ter encontrado meu pai."

# game/scripts/c16/c16.rpy:3009
translate brazilian c16s003_LunchWithEva_c52156df:

    # mc "Scarlett, dijimos de guardarlo en secreto hasta no tener confirmación."
    mc "Scarlett, dissemos para manter segredo até termos a confirmação."

# game/scripts/c16/c16.rpy:3010
translate brazilian c16s003_LunchWithEva_8d4e5d35:

    # sca "Lo sé, pero estaba muy emocionada, y [dap] me conoce demasiado bien. Preguntó y no quería mentirle. Pero no le he dicho quién podría ser."
    sca "Eu sei, mas eu estava muito animada, e ela me conhece muito bem. Ela perguntou, e eu não quis mentir para ela. Mas eu não contei para ela quem poderia ser."

# game/scripts/c16/c16.rpy:3011
translate brazilian c16s003_LunchWithEva_e0c92f79:

    # mc "Te entiendo. Cada vez odio más los secretos. Entonces, mañana en tu habitación."
    mc "Entendo. Odeio segredos cada vez mais. Então, amanhã no seu quarto."

# game/scripts/c16/c16.rpy:3013
translate brazilian c16s003_LunchWithEva_ab1adc1c:

    # sca "Sí, mañana en mi habitación. Te voy a dejar y a volver con Eva. No te gires, pero [emm] lleva un rato mirando en esta dirección, como si quisiera hablar contigo."
    sca "Sim, amanhã no meu quarto. Vou deixar você voltar para Eva agora. Não se vire, mas [emm] está olhando para cá há um tempo, como se quisesse falar com você."

# game/scripts/c16/c16.rpy:3014
translate brazilian c16s003_LunchWithEva_db33957c:

    # sca "Creo que necesitáis hablar. No gritéis mucho. No se ha tomado muy bien las noticias."
    sca "Acho que você precisa conversar. Não grite muito. Ela não reagiu muito bem à notícia."

# game/scripts/c16/c16.rpy:3016
translate brazilian c16s003_LunchWithEva_5f502bfd:

    # sca "No te gires, pero [emm] lleva un rato mirando en esta dirección, como si quisiera hablar contigo."
    sca "Não se vire, mas [emm] está olhando nesta direção há algum tempo, como se quisesse falar com você."

# game/scripts/c16/c16.rpy:3017
translate brazilian c16s003_LunchWithEva_07863757:

    # dap "Creo que os vamos a dejar para que habléis. No gritéis mucho. No se ha tomado muy bien las noticias."
    dap "Acho que vamos deixar vocês dois a sós para conversar. Não gritem muito. Ela não reagiu muito bem à notícia."

# game/scripts/c16/c16.rpy:3018
translate brazilian c16s003_LunchWithEva_3060c416:

    # mc "OK. Me da un poco de miedo. Esconde los cuchillos."
    mc "Certo. Estou um pouco assustado. Escondam as facas."

# game/scripts/c16/c16.rpy:3020
translate brazilian c16s003_LunchWithEva_ef771bce:

    # sca "Acaban de llegar Kate, Debbie, y Saira... Es una buena oportunidad para presentarles a Eva."
    sca "Kate, Debbie e Saira acabaram de chegar... É uma boa oportunidade para apresentá-las à Eva."

# game/scripts/c16/c16.rpy:3023
translate brazilian c16s003_LunchWithEva_6d00e267:

    # emm "Sabes que hoy te odio, ¿verdad?"
    emm "Você sabe que eu te odeio hoje, né?"

# game/scripts/c16/c16.rpy:3024
translate brazilian c16s003_LunchWithEva_df6f92ce:

    # mc "Me lo imagino. Pero yo no tengo la culpa, [emm]."
    mc "Posso imaginar. Mas não é minha culpa, [emm]."

# game/scripts/c16/c16.rpy:3025
translate brazilian c16s003_LunchWithEva_cd617eb8:

    # emm "Tú tienes la culpa de no habérmelo explicado antes."
    emm "A culpa é sua por não ter me explicado isso antes."

# game/scripts/c16/c16.rpy:3026
translate brazilian c16s003_LunchWithEva_2faba497:

    # mc "No podía hacerlo, [emm]. Tenía que ser Mamá."
    mc "Eu não consegui fazer isso, [emm]. Tinha que ser a mamãe."

# game/scripts/c16/c16.rpy:3029
translate brazilian c16s003_LunchWithEva_b2bb31ae:

    # emm "No puedo creer que, sabiendo lo que sabíais anoche, no me lo dijeráis."
    emm "Não consigo acreditar que, sabendo o que você sabia ontem à noite, você não me contou."

# game/scripts/c16/c16.rpy:3031
translate brazilian c16s003_LunchWithEva_0166e0bd:

    # emm "¡Joder! Yo creía que eramos una familia y que no tenía que haber secretos."
    emm "Puxa! Eu pensei que éramos uma família e que não deveria haver segredos."

# game/scripts/c16/c16.rpy:3033
translate brazilian c16s003_LunchWithEva_e3ea68ec:

    # emm "*Susurrando* Yo pensando que estaba teniendo una sesión de sexo con mi hermano y mi madre y resulta que son dos desconocidos. Y todo por guardar secretos."
    emm "*Sussurrando* Eu pensei que estava transando com meu irmão e minha mãe, mas descobri que eram dois estranhos. E tudo porque eu guardei segredos."

# game/scripts/c16/c16.rpy:3035
translate brazilian c16s003_LunchWithEva_bbf612b0:

    # mc "Hemos tenido secretos desde que estamos juntos. Tú guardaste en secreto que sabías lo mío con Mamá. ¿Sólo importan los secretos cuando eres tú quien no los sabe?"
    mc "Temos segredos desde que começamos a namorar. Você guardou meu segredo sobre meu relacionamento com a mamãe. Os segredos só importam quando você é quem não os conhece?"

# game/scripts/c16/c16.rpy:3036
translate brazilian c16s003_LunchWithEva_ef8ad7f9:

    # mc "Y Mamá quería tener una conversación a solas contigo hoy. Ayer estaba muy afectada por todo esto. ¿Por qué crees que pasó ayer precisamente?"
    mc "E a mamãe queria ter uma conversa particular com você hoje. Ela ficou muito chateada com tudo isso ontem. Por que você acha que aconteceu especificamente ontem?"

# game/scripts/c16/c16.rpy:3039
translate brazilian c16s003_LunchWithEva_f1a34bc8:

    # emm "No puedo creer que, sabiendo lo que sabías, no me lo dijeráis."
    emm "Não consigo acreditar que, sabendo o que você sabia, você não me contou."

# game/scripts/c16/c16.rpy:3041
translate brazilian c16s003_LunchWithEva_2edefc34:

    # emm "¡Joder! Yo creía que eramos una familia y que no tenía que haber secretos. *Susurrando* ¡Y eres mi novio!"
    emm "Puxa! Eu pensei que fôssemos uma família e que não houvesse segredos. *Sussurrando* E você é meu namorado!"

# game/scripts/c16/c16.rpy:3043
translate brazilian c16s003_LunchWithEva_51f985ac:

    # emm "Yo pensando que me estaba acostando con mi hermano y resulta que era un desconocido. Y todo por guardar secretos."
    emm "Eu pensava que estava dormindo com meu irmão, mas descobri que era um estranho. E tudo porque eu guardava segredos."

# game/scripts/c16/c16.rpy:3045
translate brazilian c16s003_LunchWithEva_76213b79:

    # mc "Hemos tenido secretos desde que estamos juntos. ¿O le has contado lo nuestro a alguien sin que se te escapara? ¿Sólo importan los secretos cuando eres tú quien no los sabe?"
    mc "Temos segredos desde que começamos a namorar. Ou você já contou para alguém sobre nós sem que ninguém descobrisse? Os segredos só importam quando você é quem não os conhece?"

# game/scripts/c16/c16.rpy:3046
translate brazilian c16s003_LunchWithEva_3211e247:

    # mc "Y Mamá quería tener una conversación a solas contigo hoy. Ayer estaba muy afectada por todo esto."
    mc "E a mamãe queria ter uma conversa particular com você hoje. Ela ficou muito chateada com tudo isso ontem."

# game/scripts/c16/c16.rpy:3049
translate brazilian c16s003_LunchWithEva_f1a34bc8_1:

    # emm "No puedo creer que, sabiendo lo que sabías, no me lo dijeráis."
    emm "Não consigo acreditar que, sabendo o que você sabia, você não me contou."

# game/scripts/c16/c16.rpy:3051
translate brazilian c16s003_LunchWithEva_0166e0bd_1:

    # emm "¡Joder! Yo creía que eramos una familia y que no tenía que haber secretos."
    emm "Puxa! Eu pensei que éramos uma família e que não deveria haver segredos."

# game/scripts/c16/c16.rpy:3053
translate brazilian c16s003_LunchWithEva_4c5e15c0:

    # emm "Yo pensando que me tenía una familia y resulta que eran unos desconocidos. Y todo por guardar secretos."
    emm "Eu achava que tinha uma família, mas descobri que eram completos estranhos. E tudo por causa de segredos."

# game/scripts/c16/c16.rpy:3055
translate brazilian c16s003_LunchWithEva_99b78c4b:

    # mc "Hemos tenido secretos desde siempre. ¿O le has contado a alguien que me besaste al volver del Twins? ¿Sólo importan los secretos cuando eres tú quien no los sabe?"
    mc "Sempre tivemos segredos. Ou você contou para alguém que me beijou voltando do Twins? Os segredos só importam quando você é quem não os conhece?"

# game/scripts/c16/c16.rpy:3056
translate brazilian c16s003_LunchWithEva_3211e247_1:

    # mc "Y Mamá quería tener una conversación a solas contigo hoy. Ayer estaba muy afectada por todo esto."
    mc "E a mamãe queria ter uma conversa particular com você hoje. Ela ficou muito chateada com tudo isso ontem."

# game/scripts/c16/c16.rpy:3058
translate brazilian c16s003_LunchWithEva_f4c1e79c:

    # emm "¿Afectada por qué? ¿Porque su secreto se iba a la mierda?"
    emm "Afetada por quê? Porque o segredo dela estava indo para o inferno?"

# game/scripts/c16/c16.rpy:3059
translate brazilian c16s003_LunchWithEva_19edf872:

    # mc "No, [emm]. Porque sabía lo que te podía afectar La Conversación. Porque sabía que te podías enfadar. Yo intenté convencerla de que has madurado, de que ya eres adulta."
    mc "Não, [emm]. Porque eu sabia como a conversa poderia te afetar. Porque eu sabia que você poderia ficar com raiva. Tentei convencê-la de que você amadureceu, que agora você é um adulto."

# game/scripts/c16/c16.rpy:3060
translate brazilian c16s003_LunchWithEva_c413a301:

    # mc "Pero veo que me equivoqué."
    mc "Mas vejo que estava enganado."

# game/scripts/c16/c16.rpy:3063
translate brazilian c16s003_LunchWithEva_8b630532:

    # emm "¡Ahora resulta que no soy adulta! Sois vosotros los que vais con secretos y la que no es adulta soy yo. *Susurrando* Para follar contigo soy adulta, pero para saber esto no."
    emm "Então agora eu não sou mais adulta! Vocês é que estão guardando segredos, e eu é que não sou adulta. *Sussurrando* Eu sou adulta quando se trata de dormir com você, mas não quando se trata de saber disso."

# game/scripts/c16/c16.rpy:3065
translate brazilian c16s003_LunchWithEva_66d743b2:

    # emm "¡Ahora resulta que no soy adulta! Sois vosotros los que vais con secretos y la que no es adulta soy yo."
    emm "Agora descobri que não sou adulto! Vocês é que estão guardando segredos, e eu é que não sou adulto."

# game/scripts/c16/c16.rpy:3066
translate brazilian c16s003_LunchWithEva_fee11b3b:

    # mc "[emm], yo siempre te he considerado una adulta desde que volví. Te lo he demostrado. *Susurrando* Y el sexo no tiene nada que ver."
    mc "[emm], Eu sempre te considerei um adulto desde que voltei. Eu te mostrei isso. *Sussurrando* E sexo não tem nada a ver com isso."

# game/scripts/c16/c16.rpy:3068
translate brazilian c16s003_LunchWithEva_3530d5a6:

    # mc "Vale, sí. Hay una empresa y hay un clon tuyo por ahí. ¿Qué ibas a hacer con esa información? Imágína que te lo hubiéramos dicho hace cuatro años."
    mc "Certo, sim. Existe uma empresa, e existe um clone seu por aí. O que você ia fazer com essa informação? Imagine se tivéssemos te contado isso quatro anos atrás."

# game/scripts/c16/c16.rpy:3070
translate brazilian c16s003_LunchWithEva_35067ce4:

    # mc "Y por eso te lo ha contado ahora. Por entonces ni siquiera sabíamos que Amanda existía. Solo que Mamá y Tía [nor] tenían acciones de la empresa que fundaron nuestros tíos."
    mc "E é por isso que ela te contou agora. Naquela época, nem sabíamos que Amanda existia. Só sabíamos que a mamãe e a tia tinham ações na empresa que nossos tios fundaram."

# game/scripts/c16/c16.rpy:3072
translate brazilian c16s003_LunchWithEva_a466527e:

    # mc "Vale, sí. Hay una empresa y eres el clon de Amanda. ¿Qué ibas a hacer con esa información? Imágína que te lo hubiéramos dicho hace cuatro años."
    mc "Certo, sim. Existe uma empresa, e você é um clone da Amanda. O que você ia fazer com essa informação? Imagine se tivéssemos te contado isso quatro anos atrás."

# game/scripts/c16/c16.rpy:3074
translate brazilian c16s003_LunchWithEva_0942aa08:

    # mc "Y por eso te lo ha contado ahora. Por entonces ni siquiera sabíamos que Amanda existía. Sabíamos que eras un clon, pero no de quién."
    mc "E é por isso que ela te contou agora. Naquela época, nem sabíamos que Amanda existia. Sabíamos que você era um clone, mas não de quem."

# game/scripts/c16/c16.rpy:3076
translate brazilian c16s003_LunchWithEva_1cf3d603:

    # emm "¡Pero hace casi una semana que sabéis lo de Amanda y Eva!"
    emm "Mas você já sabe sobre Amanda e Eva há quase uma semana!"

# game/scripts/c16/c16.rpy:3077
translate brazilian c16s003_LunchWithEva_ed018052:

    # mc "Cuatro días. Y no estábamos seguros del todo. Mamá vió a Amanda ayer por primera vez. Y te lo ha contado hoy. No le puedes pedir más."
    mc "Quatro dias. E nós não tínhamos certeza de nada. Mamãe viu Amanda pela primeira vez ontem. E ela te contou hoje. Não dá para pedir mais nada."

# game/scripts/c16/c16.rpy:3079
translate brazilian c16s003_LunchWithEva_fc077648:

    # emm "No crees que estoy exagerando, ¿verdad?"
    emm "Você não acha que estou exagerando, acha?"

# game/scripts/c16/c16.rpy:3080
translate brazilian c16s003_LunchWithEva_3fa1d457:

    # mc "Sabía que te ibas a enfadar, pero creo que sí, que lo estás exagerando."
    mc "Eu sabia que você ia ficar com raiva, mas acho que você está exagerando."

# game/scripts/c16/c16.rpy:3082
translate brazilian c16s003_LunchWithEva_345bd271:

    # mc "Yo tambén descubrí ayer que es posible que nuestros tíos fueran asesinados..."
    mc "Descobri ontem também que é possível que nossos tios tenham sido assassinados..."

# game/scripts/c16/c16.rpy:3084
translate brazilian c16s003_LunchWithEva_41f9646b:

    # mc "Tú has descubierto que eras un clon. Yo descubrí ayer que es posible que a mi madre biológica la asesinaran..."
    mc "Você descobriu que era um clone. Eu descobri ontem que minha mãe biológica pode ter sido assassinada..."

# game/scripts/c16/c16.rpy:3086
translate brazilian c16s003_LunchWithEva_0ceb94f2:

    # emm "¿Qué?"
    emm "Que?"

# game/scripts/c16/c16.rpy:3087
translate brazilian c16s003_LunchWithEva_12273dd4:

    # mc "Si Mamá no te lo ha dicho es porque no hay pruebas, pero Aaron, Amanda, y Eva piensan que el accidente de avión pudo ser un sabotaje."
    mc "Se a mamãe não te contou, é porque não há provas, mas Aaron, Amanda e Eva acham que a queda do avião pode ter sido sabotagem."

# game/scripts/c16/c16.rpy:3088
translate brazilian c16s003_LunchWithEva_4c10f7de:

    # emm "¡Eso es muy jodido! Yo estaba histérica porque pensaba que alguien nos quisiera matar. Con el accidente de avión lo consiguieron..."
    emm "Que coisa horrível! Eu fiquei histérica porque achei que alguém queria nos matar. Com a queda do avião, eles conseguiram..."

# game/scripts/c16/c16.rpy:3090
translate brazilian c16s003_LunchWithEva_ace30f5a:

    # mc "Ellos no tenían a Eva y a Amanda para protegerlos. Nosotros sí."
    mc "Eles não tinham Eva e Amanda para protegê-los. Nós tínhamos."

# game/scripts/c16/c16.rpy:3093
translate brazilian c16s003_LunchWithEva_cb7c35c7:

    # emm "Es diferente de lo que me había imaginado... Me imaginaba una [dap]... por alguna razón no me imaginaba que se pareciera a [eri]."
    emm "É diferente do que eu imaginei... Eu imaginei um [dap]... por algum motivo eu não imaginei que ficaria parecido com [eri]."

# game/scripts/c16/c16.rpy:3094
translate brazilian c16s003_LunchWithEva_e4de96fb:

    # emm "Pero cuanto más hablo con ella, más me recuerda a alguien, y no sé a quien. Pero no es a [dap] ni a [eri]."
    emm "Mas quanto mais converso com ela, mais ela me lembra alguém, e não sei quem. Mas não é [dap] nem [eri]."

# game/scripts/c16/c16.rpy:3095
translate brazilian c16s003_LunchWithEva_97645c33:

    # mc "Yo sé a quién te recuerda. Si en un par de días no lo has descubierto, te lo diré."
    mc "Eu sei de quem isso te lembra. Se você não descobrir em alguns dias, eu te conto."

# game/scripts/c16/c16.rpy:3097
translate brazilian c16s003_LunchWithEva_abc4d74c:

    # emm "Pero me cae muy bien. Creo que podríamos ser amigas. Además tiene muy buen gusto, el top es precioso, aunque sea blanco."
    emm "Mas eu gosto muito dela. Acho que poderíamos ser amigas. Além disso, ela tem ótimo gosto; a blusa é linda, mesmo sendo branca."

# game/scripts/c16/c16.rpy:3098
translate brazilian c16s003_LunchWithEva_6d3b4e42:

    # mc "Me ha preguntado si se ponía uno rosa para gustarte más. Estaba muy nerviosa por conoceros. Piensa que para ella también tiene que ser difícil."
    mc "Ela me perguntou se deveria usar um vestido rosa para te impressionar mais. Ela estava muito nervosa para te conhecer. Acho que deve ser difícil para ela também."

# game/scripts/c16/c16.rpy:3100
translate brazilian c16s003_LunchWithEva_33814444:

    # emm "Me lo imagino. No ha querido contar mucho de ella misma, pero por lo que me ha contado Mamá..."
    emm "Imagino. Ela não tem querido falar muito sobre si mesma, mas pelo que a mãe me contou..."

# game/scripts/c16/c16.rpy:3102
translate brazilian c16s003_LunchWithEva_cc7c281d:

    # mcp "(Vuelve a ser Mamá...)"
    mcp "(Ela voltou a ser mãe...)"

# game/scripts/c16/c16.rpy:3103
translate brazilian c16s003_LunchWithEva_f528ecac:

    # mc "Ha tenido una vida que ninguno de nosotros desearíamos."
    mc "Ela teve uma vida que nenhum de nós desejaria."

# game/scripts/c16/c16.rpy:3105
translate brazilian c16s003_LunchWithEva_81a195c7:

    # emm "Pero ahora que somos sus jefes, podemos dejarle hacer lo que quiera, ¿no? Que deje de ser una mercenaria, que tenga una vida más normal."
    emm "Mas agora que somos os chefes dela, podemos deixá-la fazer o que quiser, certo? Deixá-la parar de ser mercenária e ter uma vida mais normal."

# game/scripts/c16/c16.rpy:3106
translate brazilian c16s003_LunchWithEva_70aaa442:

    # mc "Si quiere, supongo que sí."
    mc "Se você quiser, acho que sim."

# game/scripts/c16/c16.rpy:3107
translate brazilian c16s003_LunchWithEva_148970db:

    # emm "Claro, si quiere."
    emm "Claro, se você quiser."

# game/scripts/c16/c16.rpy:3109
translate brazilian c16s003_LunchWithEva_a5baf386:

    # emm "Y ahora que somos ricos, ¿puedo comprarme un Ferarri rosa?"
    emm "E agora que estamos ricos, posso comprar uma Ferrari rosa?"

# game/scripts/c16/c16.rpy:3110
translate brazilian c16s003_LunchWithEva_5751a753:

    # mc "*Risa* Aún no somos ricos, [emm]. Hay que decidir qué hacer con la empresa. Pero dejémoslo para otro día."
    mc "*Risos* Ainda não somos ricos, [emm]. Precisamos decidir o que fazer com a empresa. Mas vamos deixar isso para outro dia."

# game/scripts/c16/c16.rpy:3112
translate brazilian c16s003_LunchWithEva_8f978b7c:

    # emm "Mira, nuestra invitada se acerca. Puede que nos haya oído hablar de ella."
    emm "Olha, nossa convidada está chegando. Ela pode ter nos ouvido falando dela."

# game/scripts/c16/c16.rpy:3114
translate brazilian c16s003_LunchWithEva_48ca2285:

    # eva "[emm], perdona si te interrumpo. ¿Puedo hablar con [mc] a solas un momento?"
    eva "[emm], desculpe interromper. Posso falar com [mc] a sós por um instante?"

# game/scripts/c16/c16.rpy:3116
translate brazilian c16s003_LunchWithEva_ab690064:

    # emm "Por supuesto. Tengo que ir a... disculparme con mi madre."
    emm "Claro. Preciso ir... pedir desculpas à minha mãe."

# game/scripts/c16/c16.rpy:3119
translate brazilian c16s003_LunchWithEva_bc2e3fce:

    # eva "¿Me puedes sacar de aquí?"
    eva "Você pode me tirar daqui?"

# game/scripts/c16/c16.rpy:3121
translate brazilian c16s003_LunchWithEva_af52567e:

    # mc "¿Ya te han aburrido?"
    mc "Você já está entediado com eles?"

# game/scripts/c16/c16.rpy:3123
translate brazilian c16s003_LunchWithEva_1e01afef:

    # eva "No, para nada. Pero se están portando todas tan bien conmigo... "
    eva "Não, de jeito nenhum. Mas eles estão sendo todos muito gentis comigo..."

# game/scripts/c16/c16.rpy:3124
translate brazilian c16s003_LunchWithEva_fb6cead6:

    # eva "Necesito aire fresco. Creo que [nor] ha cortado muchas cebollas hoy en esta cocina."
    eva "Preciso de ar fresco. Acho que [nor] picou muita cebola nesta cozinha hoje."

# game/scripts/c16/c16.rpy:3125
translate brazilian c16s003_LunchWithEva_759e2f5a:

    # mc "¿Cuánto tiempo te va a llevar retirar las cámaras?"
    mc "Quanto tempo você levará para remover as câmeras?"

# game/scripts/c16/c16.rpy:3127
translate brazilian c16s003_LunchWithEva_972238ff:

    # eva "Un par de horas, ¿por qué?"
    eva "Algumas horas, por quê?"

# game/scripts/c16/c16.rpy:3128
translate brazilian c16s003_LunchWithEva_db46cab2:

    # mc "Ahí tienes tu excusa. Un par de horas para las cámaras, volver a la base para relevar a Amanda... Si no empiezas ahora no te va a dar tiempo de todo."
    mc "Aí está sua desculpa. Algumas horas para as câmeras, depois de volta à base para substituir a Amanda... Se você não começar agora, não terá tempo para tudo."

# game/scripts/c16/c16.rpy:3129
translate brazilian c16s003_LunchWithEva_9848e752:

    # eva "Tengo tiempo de sobras."
    eva "Tenho bastante tempo."

# game/scripts/c16/c16.rpy:3130
translate brazilian c16s003_LunchWithEva_97bf5564:

    # mc "Pero yo no lo sabía hasta ahora mismo y nadie lo sabe. No sabemos donde está la base. Y, de momento, no sé si quieres que lo sepamos."
    mc "Mas eu só descobri isso agora, e ninguém sabe. Não sabemos onde fica a base. E, por enquanto, não sei se você quer que a gente saiba."

# game/scripts/c16/c16.rpy:3132
translate brazilian c16s003_LunchWithEva_07be78d4:

    # eva "¡Jodido manipulador! *Risa*"
    eva "Maldito manipulador! *Risos*"

# game/scripts/c16/c16.rpy:3133
translate brazilian c16s003_LunchWithEva_eca4b62c:

    # mc "Tú misma lo has dicho. No soy manipulador, protejo a mis chicas... de mis otras chicas. *Risa*"
    mc "Você mesma disse. Eu não sou manipuladora, eu protejo minhas garotas... das minhas outras garotas. *Risos*"

# game/scripts/c16/c16.rpy:3135
translate brazilian c16s003_LunchWithEva_2fef2240:

    # eva "{b}¿Qué?{/b} ¿Tus chicas? {b}¿Me consideras una de tus chicas?{/b}"
    eva "{b}O quê?{/b} Suas garotas? {b}Você me considera uma de suas garotas?{/b}"

# game/scripts/c16/c16.rpy:3136
translate brazilian c16s003_LunchWithEva_adfaedd6:

    # mc "Sí, Eva. Tú y Amanda sois unas de mis chicas... de nuestras chicas. No lo voy a volver a repetir más. Sois parte de esta familia."
    mc "Sim, Eva. Você e Amanda são algumas das minhas meninas... nossas meninas. Não vou me repetir. Você faz parte desta família."

# game/scripts/c16/c16.rpy:3138
translate brazilian c16s003_LunchWithEva_d5671cc3:

    # eva "Mmmm... vaaale..."
    eva "Hum... ok..."

# game/scripts/c16/c16.rpy:3139
translate brazilian c16s003_LunchWithEva_0c3ae172:

    # eva "¿Por dónde quieres que empiece a retirar las cámaras?"
    eva "Por onde você quer que eu comece a remover as câmeras?"

# game/scripts/c16/c16.rpy:3140
translate brazilian c16s003_LunchWithEva_4727d6fb:

    # mc "Puedes empezar por mi casa. Ahora mismo está vacía."
    mc "Você pode começar pela minha casa. No momento, ela está vazia."

# game/scripts/c16/c16.rpy:3142
translate brazilian c16s003_LunchWithEva_f9170af1:

    # "Eva se despide de todo el mundo, prometiendo pasar de nuevo por la cocina antes de irse para despedirse de verdad."
    "Eva se despede de todos, prometendo passar na cozinha novamente antes de ir embora para se despedir como deve ser."

# game/scripts/c16/c16.rpy:3143
translate brazilian c16s003_LunchWithEva_5f1438bc:

    # "Nadie quiere que Eva se vaya, pero nadie quiere tener cámaras en su habitación. Difícil disyuntiva. A regañadientes, dejan que te lleves a Eva."
    "Ninguém quer que Eva vá embora, mas ninguém quer câmeras no quarto. Um dilema difícil. A contragosto, eles deixam você levar Eva."

# game/scripts/c16/c16.rpy:3145
translate brazilian c16s003_LunchWithEva_973cc815:

    # "Quedas con [eri] en 10 minutos en tu habitación para hacer el test."
    "Você encontrará [eri] em 10 minutos em seu quarto para fazer o teste."

# game/scripts/c16/c16.rpy:3147
translate brazilian c16s003_LunchWithEva_8525ed60:

    # eva "¡Phew! Ha sido intenso."
    eva "Ufa! Isso foi intenso."

# game/scripts/c16/c16.rpy:3148
translate brazilian c16s003_LunchWithEva_ee67543d:

    # mc "¿Peor de lo que creías?"
    mc "Pior do que você pensava?"

# game/scripts/c16/c16.rpy:3150
translate brazilian c16s003_LunchWithEva_0dbf0260:

    # eva "¡Mucho mejor! Pero demasiado intenso."
    eva "Muito melhor! Mas intenso demais."

# game/scripts/c16/c16.rpy:3151
translate brazilian c16s003_LunchWithEva_538a91a1:

    # mc "Me alegra que te lo hayas pasado bien."
    mc "Que bom que você se divertiu."

# game/scripts/c16/c16.rpy:3153
translate brazilian c16s003_LunchWithEva_fd5b4c15:

    # eva "Tengo una pregunta..."
    eva "Tenho uma pergunta..."

# game/scripts/c16/c16.rpy:3154
translate brazilian c16s003_LunchWithEva_1afe9f90:

    # mc "Dime."
    mc "Diga-me."

# game/scripts/c16/c16.rpy:3155
translate brazilian c16s003_LunchWithEva_5b91a292:

    # eva "Has dicho que formamos parte de esta familia..."
    eva "Você disse que fazemos parte desta família..."

# game/scripts/c16/c16.rpy:3156
translate brazilian c16s003_LunchWithEva_494a6419:

    # mc "Sí."
    mc "Sim."

# game/scripts/c16/c16.rpy:3157
translate brazilian c16s003_LunchWithEva_53522e63:

    # eva "¿Para todo?"
    eva "Para tudo?"

# game/scripts/c16/c16.rpy:3158
translate brazilian c16s003_LunchWithEva_6a1f62a4:

    # mc "Claro."
    mc "Claro."

# game/scripts/c16/c16.rpy:3160
translate brazilian c16s003_LunchWithEva_6db421fd:

    # eva "Buenos días, [mc]... o buenas tardes ya."
    eva "Bom dia, [mc]... ou boa tarde já."

# game/scripts/c16/c16.rpy:3161
translate brazilian c16s003_LunchWithEva_d054dd06:

    # mc "¡Wow, Eva! ¿Lo decías por eso?"
    mc "Nossa, Eva! Era isso que você queria dizer?"

# game/scripts/c16/c16.rpy:3163
translate brazilian c16s003_LunchWithEva_ed8b1216:

    # eva "Si ellas pueden besar a mi primo cañón, o lo que seas, yo también."
    eva "Se elas podem beijar meu primo gato, ou seja lá o que ele for, então eu também posso."

# game/scripts/c16/c16.rpy:3164
translate brazilian c16s003_LunchWithEva_8fc39dda:

    # mc "*Risa* Vamos a quitar las cámaras."
    mc "*Risos* Vamos remover as câmeras."

# game/scripts/c16/c16.rpy:3167
translate brazilian c16s003_LunchWithEva_f1b2346b:

    # "Acompañas a Eva a tu habitación, de donde saca un par de cámaras y un micrófono. Ella seguirá en solitario por la casa"
    "Você acompanha Eva até seu quarto, de onde ela pega algumas câmeras e um microfone. Ela continuará explorando a casa sozinha."

# game/scripts/c16/c16.rpy:3169
translate brazilian c16s003_LunchWithEva_eb2435a6:

    # "[eri] llega unos minutos después y hacéis el test. Ahora solo queda esperar 24 horas para saber el resultado. Empiezas a estar ansioso."
    "[eri] chega alguns minutos depois e você faz o teste. Agora você só precisa esperar 24 horas pelo resultado. Você começa a ficar ansioso."

# game/scripts/c16/c16.rpy:3172
translate brazilian c16s003_Text1_54f0683b:

    # mc "¿Me puedes asegurar que la [emm] de hace cuatro años no iba a fanfarronear sobre ello? ¿Con lo que te gustaba ser el centro de atención?"
    mc "Você pode me garantir que o(a) [emm] de quatro anos atrás não ia se gabar disso? Considerando o quanto você adorava ser o centro das atenções?"

# game/scripts/c16/c16.rpy:3174
translate brazilian c16s003_Text1_2a79e1d0:

    # emm "Seguramente lo hubiera hecho... pero ya no soy así."
    emm "Provavelmente eu teria feito isso... mas não sou mais assim."

# game/scripts/c16/c16.rpy:3177
translate brazilian c16s003_Text2_2af8d137:

    # emm "Y deja de llamarla Mamá. Es tan tu madre como la mía."
    emm "E pare de chamá-la de mãe. Ela é tão mãe sua quanto minha."

# game/scripts/c16/c16.rpy:3178
translate brazilian c16s003_Text2_4206b51f:

    # mc "[emm], Mamá sigue siendo Mamá, y tú sigues siendo mi hermana. Me da lo mismo no llevar los mismos genes que vosotras."
    mc "[emm], Mamãe continua sendo mamãe, e você continua sendo minha irmã. Não me importo de não ter os mesmos genes que você."

# game/scripts/c16/c16.rpy:3196
translate brazilian c16s004_DateWithMaddie_c8143cb3:

    # "Decides llamar a Maddie para retrasar la cita. No vas a poder llegar antes de que acabe la cena con Amanda."
    "Você decide ligar para Maddie para adiar o encontro. Você não poderá chegar antes que ela termine o jantar com Amanda."

# game/scripts/c16/c16.rpy:3199
translate brazilian c16s004_DateWithMaddie_ceba9ff4:

    # mc "Hola, Maddie. Tengo malas noticias."
    mc "Oi, Maddie. Tenho más notícias."

# game/scripts/c16/c16.rpy:3202
translate brazilian c16s004_DateWithMaddie_a2f426b2:

    # mad "Hola, guapo. Al final tienes que recoger a aquella chica, ¿verdad?"
    mad "Ei, bonitão. Você ainda tem que conquistar aquela garota, né?"

# game/scripts/c16/c16.rpy:3203
translate brazilian c16s004_DateWithMaddie_31169d8e:

    # mc "Sí, y además después hay una cena en mi casa a la que no puedo faltar."
    mc "Sim, e depois tem um jantar na minha casa que eu não posso perder."

# game/scripts/c16/c16.rpy:3205
translate brazilian c16s004_DateWithMaddie_7530335a:

    # mad "Con lo que tendremos que pasar nuestra película a otro día... o anularla..."
    mad "Então teremos que remarcar o filme para outro dia... ou cancelá-lo..."

# game/scripts/c16/c16.rpy:3206
translate brazilian c16s004_DateWithMaddie_28138b9e:

    # mc "Había pensado en pasarme al acabar la cena, si quieres."
    mc "Estava pensando em dar uma passada depois do jantar, se você quiser."

# game/scripts/c16/c16.rpy:3208
translate brazilian c16s004_DateWithMaddie_975c1bd2:

    # mad "¡Me parece genial! Tengo una sorpresa para ti en mis manos ahora mismo."
    mad "Isso parece ótimo! Tenho uma surpresa para você agora mesmo."

# game/scripts/c16/c16.rpy:3209
translate brazilian c16s004_DateWithMaddie_b8ae0305:

    # mc "Espero que sea lo que pienso. *Risa*"
    mc "Espero que seja o que eu estou pensando. *Risos*"

# game/scripts/c16/c16.rpy:3211
translate brazilian c16s004_DateWithMaddie_21111bb8:

    # mad "¡Picarón! Es algo que me he probado para esta noche. Creo que te va a gustar."
    mad "Ei, seu danadinho! É uma roupa que experimentei para usar hoje à noite. Acho que você vai gostar."

# game/scripts/c16/c16.rpy:3212
translate brazilian c16s004_DateWithMaddie_053e0851:

    # mc "Estoy deseando verlo. Cuando salga de casa, ¿te llamo para decirte que voy en camino?"
    mc "Estou ansiosa para vê-lo. Quando eu sair de casa, devo te ligar para avisar que estou a caminho?"

# game/scripts/c16/c16.rpy:3214
translate brazilian c16s004_DateWithMaddie_c6b79b00:

    # mad "Lo estoy deseando. Te veo luego."
    mad "Estou ansioso por isso. Até mais."

# game/scripts/c16/c16.rpy:3215
translate brazilian c16s004_DateWithMaddie_ad3700a5:

    # mc "Hasta luego, preciosa."
    mc "Até logo, linda."

# game/scripts/c16/c16.rpy:3218
translate brazilian c16s004_DateWithMaddie_b21c186a:

    # mad "Hola, [mc]. No vas a poder venir, ¿verdad? Tienes que recoger a aquella chica..."
    mad "Olá, [mc]. Você não poderá vir, não é? Você tem que buscar aquela garota..."

# game/scripts/c16/c16.rpy:3219
translate brazilian c16s004_DateWithMaddie_1590d894:

    # mc "La tengo que recoger, y después hay una cena en mi casa a la que no puedo faltar."
    mc "Tenho que buscar, e depois tem um jantar na minha casa que não posso perder."

# game/scripts/c16/c16.rpy:3221
translate brazilian c16s004_DateWithMaddie_b72a7315:

    # mad "Entonces... ¿quieres retrasar nuestra... cita... a otro día?"
    mad "Então... você quer adiar nosso... encontro... para outro dia?"

# game/scripts/c16/c16.rpy:3222
translate brazilian c16s004_DateWithMaddie_64718b1a:

    # mc "No, me pasaré al acabar la cena por tu casa."
    mc "Não, eu passo na sua casa depois do jantar."

# game/scripts/c16/c16.rpy:3224
translate brazilian c16s004_DateWithMaddie_e9e69033:

    # mad "¡Sí!... si es lo que quieres... Precisamente tengo en las manos algo para ti ahora mismo."
    mad "Sim!... se é isso que você quer... por acaso tenho algo para você agora."

# game/scripts/c16/c16.rpy:3225
translate brazilian c16s004_DateWithMaddie_e5b196fc:

    # mc "Toda tú eres para mí, Maddie. *Risa*"
    mc "Você é tudo para mim, Maddie. *Risos*"

# game/scripts/c16/c16.rpy:3227
translate brazilian c16s004_DateWithMaddie_4ef7a959:

    # mad "No me refería a eso, es algo que me he comprado para ti. Creo que te va a gustar."
    mad "Não era isso que eu queria dizer; é algo que comprei para você. Acho que você vai gostar."

# game/scripts/c16/c16.rpy:3228
translate brazilian c16s004_DateWithMaddie_1a5aee1d:

    # mc "Estoy deseando verlo. Te llamo cuando salga de casa para decirte que voy en camino."
    mc "Mal posso esperar para vê-lo. Ligarei para você quando sair de casa para avisar que estou a caminho."

# game/scripts/c16/c16.rpy:3230
translate brazilian c16s004_DateWithMaddie_c6b79b00_1:

    # mad "Lo estoy deseando. Te veo luego."
    mad "Estou ansioso por isso. Até mais."

# game/scripts/c16/c16.rpy:3231
translate brazilian c16s004_DateWithMaddie_ad3700a5_1:

    # mc "Hasta luego, preciosa."
    mc "Até logo, linda."

# game/scripts/c16/c16.rpy:3234
translate brazilian c16s004_DateWithMaddie_60bad8a3:

    # mad "Hola, guapo. Al final quieres anteponer a aquella chica a mí, ¿verdad?"
    mad "Ei, bonitão. No fim das contas, você quer colocar aquela garota na minha frente, não é?"

# game/scripts/c16/c16.rpy:3235
translate brazilian c16s004_DateWithMaddie_0f8b3d74:

    # mc "No es eso. La tengo que recoger, sí, y después hay una cena en mi casa a la que no puedo faltar."
    mc "Não é isso. Eu tenho que buscar, sim, e depois tem um jantar na minha casa que eu não posso perder."

# game/scripts/c16/c16.rpy:3237
translate brazilian c16s004_DateWithMaddie_6a3da0de:

    # mad "¿Me estás pidiendo permiso para cambiar nuestra cita a otro día?"
    mad "Você está pedindo permissão para alterar nossa consulta para outro dia?"

# game/scripts/c16/c16.rpy:3238
translate brazilian c16s004_DateWithMaddie_dddcc6f8:

    # mc "Había pensado en pasarme al acabar la cena, si me lo permites."
    mc "Estava pensando em dar uma passada aí depois do jantar, se você não se importar."

# game/scripts/c16/c16.rpy:3240
translate brazilian c16s004_DateWithMaddie_821cf022:

    # mad "No es mala idea. Además demuestras iniciativa. Sólo por eso, tengo un premio para ti en mis manos ahora mismo."
    mad "Essa não é uma má ideia. Além disso, você está demonstrando iniciativa. Só por isso, já tenho um prêmio para você."

# game/scripts/c16/c16.rpy:3241
translate brazilian c16s004_DateWithMaddie_a883c276:

    # mc "Estoy deseando verlo."
    mc "Estou ansioso para ver."

# game/scripts/c16/c16.rpy:3243
translate brazilian c16s004_DateWithMaddie_c82ffe90:

    # mad "No es lo que crees. Es algo que me he probado para esta tarde... noche. Creo que va a darle un tono diferente a la noche."
    mad "Não é o que você está pensando. É algo que experimentei para esta tarde... noite. Acho que vai dar um toque diferente à noite."

# game/scripts/c16/c16.rpy:3244
translate brazilian c16s004_DateWithMaddie_4f0dfd0b:

    # mc "Estoy deseando verlo. Cuando salga de casa, ¿quieres que te llame para decirte que voy en camino?"
    mc "Estou ansiosa para vê-lo. Quando eu sair de casa, você gostaria que eu ligasse para avisar que estou a caminho?"

# game/scripts/c16/c16.rpy:3246
translate brazilian c16s004_DateWithMaddie_38b30e17:

    # mad "Sí, hazlo. Te veo luego."
    mad "Sim, faça isso. Até mais."

# game/scripts/c16/c16.rpy:3247
translate brazilian c16s004_DateWithMaddie_ba83e5e1:

    # mc "Hasta luego, Maddie."
    mc "Adeus, Maddie."

# game/scripts/c16/c16.rpy:3301
translate brazilian c16s004_ConvoSairaAboutMegan_5e179c79:

    # "Llega el momento de ir a buscar a Megan a la estación. Está siendo un día muy ocupado."
    "Está na hora de ir buscar a Megan na estação. Foi um dia muito corrido."

# game/scripts/c16/c16.rpy:3302
translate brazilian c16s004_ConvoSairaAboutMegan_07a0777b:

    # "Se te ha ocurrido una idea para no tener que cederle tu cama, pero tienes que hablar con Saira."
    "Você teve uma ideia para não precisar abrir mão da sua cama, mas precisa conversar com a Saira."

# game/scripts/c16/c16.rpy:3305
translate brazilian c16s004_ConvoSairaAboutMegan_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c16/c16.rpy:3306
translate brazilian c16s004_ConvoSairaAboutMegan_25c2df4d:

    # mc "Soy yo."
    mc "Sou eu."

# game/scripts/c16/c16.rpy:3308
translate brazilian c16s004_ConvoSairaAboutMegan_11ab7668:

    # sai "*A través de la puerta* Pasa."
    sai "*Pela porta* Entre."

# game/scripts/c16/c16.rpy:3311
translate brazilian c16s004_ConvoSairaAboutMegan_ec9d095a:

    # sai "Hola, mi amor. Me cuesta mucho no besarte de verdad delante de todas..."
    sai "Oi, meu amor. É tão difícil não te beijar de verdade na frente de todo mundo..."

# game/scripts/c16/c16.rpy:3312
translate brazilian c16s004_ConvoSairaAboutMegan_1b1f0156:

    # mc "A mí también."
    mc "Eu também."

# game/scripts/c16/c16.rpy:3314
translate brazilian c16s004_ConvoSairaAboutMegan_08449544:

    # sai "Te va a parecer gracioso, pero ahora soy yo la que está dudando si deberíamos hacerlo público."
    sai "Você vai achar engraçado, mas agora sou eu que estou me perguntando se devemos tornar isso público."

# game/scripts/c16/c16.rpy:3317
translate brazilian c16s004_ConvoSairaAboutMegan_123ce4ba:

    # sai "Eileen y Scarlett ya lo saben. Creo que, de momento, es suficiente. Déjame establecerme un poco en la casa antes de hacerlo público."
    sai "Eileen e Scarlett já sabem. Acho que isso basta por agora. Deixe-me me instalar um pouco na casa antes de tornar isso público."

# game/scripts/c16/c16.rpy:3318
translate brazilian c16s004_ConvoSairaAboutMegan_654ea5d9:

    # mc "Sí, me parece bien. Quiero que te sientas a gusto en casa, y si crees que esto te va a ayudar..."
    mc "Sim, isso me parece ótimo. Quero que você se sinta confortável em casa, e se você acha que isso vai ajudar..."

# game/scripts/c16/c16.rpy:3319
translate brazilian c16s004_ConvoSairaAboutMegan_fffcef6b:

    # mc "Hablando de ayuda, venía a pedirte un favor..."
    mc "Por falar em ajuda, vim pedir um favor..."

# game/scripts/c16/c16.rpy:3323
translate brazilian c16s004_ConvoSairaAboutMegan_4ea8435c:

    # sai "Hola, [mc]. ¿Vienes a hablar o te puedo ayudar en algo?"
    sai "Olá, [mc]. Você está aqui para conversar ou posso te ajudar em algo?"

# game/scripts/c16/c16.rpy:3324
translate brazilian c16s004_ConvoSairaAboutMegan_30a73ae4:

    # mc "Las dos cosas."
    mc "Ambos."

# game/scripts/c16/c16.rpy:3326
translate brazilian c16s004_ConvoSairaAboutMegan_147bbc22:

    # sai "Te ayudaré en lo que necesites, pero me gustaría hablar de nosotros primero."
    sai "Posso te ajudar com o que você precisar, mas primeiro gostaria de falar sobre nós."

# game/scripts/c16/c16.rpy:3327
translate brazilian c16s004_ConvoSairaAboutMegan_6d8b7d19:

    # mc "Hablemos..."
    mc "Vamos conversar..."

# game/scripts/c16/c16.rpy:3329
translate brazilian c16s004_ConvoSairaAboutMegan_f2c05d38:

    # sai "He estado pensando, y he decidido que sí, que podría aceptar una relación abierta contigo otra vez."
    sai "Refleti bastante e decidi que sim, eu poderia aceitar um relacionamento aberto com você novamente."

# game/scripts/c16/c16.rpy:3330
translate brazilian c16s004_ConvoSairaAboutMegan_e3032c81:

    # sai "Pero con unas diferencias sobre lo que teníamos en Portland."
    sai "Mas com algumas diferenças em comparação com o que tínhamos em Portland."

# game/scripts/c16/c16.rpy:3331
translate brazilian c16s004_ConvoSairaAboutMegan_1afe9f90:

    # mc "Dime."
    mc "Diga-me."

# game/scripts/c16/c16.rpy:3333
translate brazilian c16s004_ConvoSairaAboutMegan_31b4d99c:

    # sai "La principal es que, de momento, no quiero que nadie sepa que estamos juntos."
    sai "O principal motivo é que, por enquanto, não quero que ninguém saiba que estamos juntos."

# game/scripts/c16/c16.rpy:3337
translate brazilian c16s004_ConvoSairaAboutMegan_890a79e2:

    # sai "Además, estás con Eileen, y no quiero que me pueda ver como una amenaza. Creo que realmente puede convertirse en mi mejor amiga. ¡Vaya sorpresa!"
    sai "Além disso, você está com a Eileen, e eu não quero que ela me veja como uma ameaça. Acho mesmo que ela pode se tornar minha melhor amiga. Que surpresa!"

# game/scripts/c16/c16.rpy:3338
translate brazilian c16s004_ConvoSairaAboutMegan_f9ba0ecd:

    # mc "Es una mujer fantástica."
    mc "Ela é uma mulher fantástica."

# game/scripts/c16/c16.rpy:3341
translate brazilian c16s004_ConvoSairaAboutMegan_7ff31940:

    # sai "Scarlett lo ha pasado muy mal y está encontrando estabilidad en casa y contigo. No quiero ser un elemento que la ponga nerviosa."
    sai "Scarlett passou por momentos muito difíceis e está encontrando estabilidade em casa e com você. Não quero ser algo que a deixe nervosa."

# game/scripts/c16/c16.rpy:3342
translate brazilian c16s004_ConvoSairaAboutMegan_44d3c9ca:

    # mc "Scarlett es más fuerte de lo que parece, te lo aseguro."
    mc "Scarlett é mais forte do que parece, eu garanto."

# game/scripts/c16/c16.rpy:3344
translate brazilian c16s004_ConvoSairaAboutMegan_516e06bb:

    # sai "Y tu familia... no sé cómo aceptaría que volviéramos a estar juntos. He visto algunas miradas que no he sabido como interpretar."
    sai "E sua família... Não sei como eles aceitariam nossa volta. Vi alguns olhares que não soube interpretar."

# game/scripts/c16/c16.rpy:3345
translate brazilian c16s004_ConvoSairaAboutMegan_5b21661f:

    # mc "Supongo que es porque, como yo, no entienden por qué te mudaste sin avisarme. Yo puedo entenderlo ahora, pero a ellas no se lo ha explicado nadie y las desconciertas."
    mc "Imagino que seja porque, assim como eu, eles não entendem por que você se mudou sem me avisar. Eu entendo agora, mas ninguém explicou para eles, e isso os confunde."

# game/scripts/c16/c16.rpy:3346
translate brazilian c16s004_ConvoSairaAboutMegan_d0df7ce3:

    # mc "¿Y el resto de diferencias?"
    mc "E quanto às outras diferenças?"

# game/scripts/c16/c16.rpy:3348
translate brazilian c16s004_ConvoSairaAboutMegan_0ed09bfa:

    # sai "No quiero una relación abierta como teníamos en Portland. Nunca me acosté con nadie que no fueras tú."
    sai "Eu não quero um relacionamento aberto como o que tínhamos em Portland. Eu nunca dormi com ninguém além de você."

# game/scripts/c16/c16.rpy:3349
translate brazilian c16s004_ConvoSairaAboutMegan_fe47dda8:

    # sai "Si tengo que aceptar que tú puedas salir con otras, lo haré. Es lo que teníamos allí. Pero en mi lado de la relación va a ser cerrada."
    sai "Se eu tiver que aceitar que você pode sair com outras pessoas, eu aceitarei. Era isso que tínhamos. Mas a minha parte no relacionamento vai ficar encerrada."

# game/scripts/c16/c16.rpy:3350
translate brazilian c16s004_ConvoSairaAboutMegan_df57f747:

    # sai "No quiero tener la opción de salir con otros tíos. Nunca la voy a utilizar de todas formas."
    sai "Eu não quero a opção de sair com outros caras. De qualquer forma, eu nunca vou usá-la."

# game/scripts/c16/c16.rpy:3351
translate brazilian c16s004_ConvoSairaAboutMegan_ee15d045:

    # mc "¡Wow, Saira! Me pones en una encrucijada."
    mc "Nossa, Saira! Você me colocou numa situação difícil."

# game/scripts/c16/c16.rpy:3370
translate brazilian c16s004_ConvoSairaAboutMegan_78a7a233:

    # sai "Te quiero. Conduce con cuidado. Te veo luego."
    sai "Eu te amo. Dirija com cuidado. Até mais."

# game/scripts/c16/c16.rpy:3373
translate brazilian c16s004_ConvoSairaAboutMegan_27639a7b:

    # sai "Conduce con cuidado. Te veo luego."
    sai "Dirija com cuidado. Até logo."

# game/scripts/c16/c16.rpy:3374
translate brazilian c16s004_ConvoSairaAboutMegan_ad3700a5:

    # mc "Hasta luego, preciosa."
    mc "Até logo, linda."

# game/scripts/c16/c16.rpy:3375
translate brazilian c16s004_ConvoSairaAboutMegan_35760211:

    # mc "Por cierto, me gusta el nuevo peinado."
    mc "Aliás, gostei do novo corte de cabelo."

# game/scripts/c16/c16.rpy:3379
translate brazilian c16s004_ConvoSairaAboutGirls_375e12b4:

    # mc "Me acabas de sorprender mucho."
    mc "Você realmente me surpreendeu."

# game/scripts/c16/c16.rpy:3381
translate brazilian c16s004_ConvoSairaAboutGirls_f3295ca7:

    # sai "Sabes que no tenía muchas amigas en Portland..."
    sai "Sabe, eu não tinha muitos amigos em Portland..."

# game/scripts/c16/c16.rpy:3382
translate brazilian c16s004_ConvoSairaAboutGirls_56bcf030:

    # mc "Si tu definición de no tener muchas amigas es no tener ninguna, sí. Tenías conocidas y chicas con las que te llevabas bien, pero ¿amigas de verdad?... no creo que tuvieras ninguna."
    mc "Se a sua definição de não ter muitos amigos é não ter nenhum, então sim. Você tinha conhecidos e garotas com quem se dava bem, mas amigos de verdade?... Acho que você não tinha nenhum."

# game/scripts/c16/c16.rpy:3384
translate brazilian c16s004_ConvoSairaAboutGirls_4ac17d53:

    # sai "Bueno, sí, eso..."
    sai "Bem, sim, isso..."

# game/scripts/c16/c16.rpy:3385
translate brazilian c16s004_ConvoSairaAboutGirls_4ace5f8c:

    # sai "No voy a decir que la culpa fuera tuya, claro..."
    sai "Claro que não vou dizer que foi sua culpa..."

# game/scripts/c16/c16.rpy:3386
translate brazilian c16s004_ConvoSairaAboutGirls_4148b323:

    # mc "¿Mía? ¿Por qué?"
    mc "Meu? Por quê?"

# game/scripts/c16/c16.rpy:3388
translate brazilian c16s004_ConvoSairaAboutGirls_2a399634:

    # sai "Porque salía contigo. O teníamos la falsa relación abierta que teníamos, para ser más exactos."
    sai "Porque eu estava namorando com você. Ou melhor, tínhamos aquele relacionamento aberto de mentira que tínhamos."

# game/scripts/c16/c16.rpy:3389
translate brazilian c16s004_ConvoSairaAboutGirls_a09ee97a:

    # sai "Muchas de las chicas que se me acercaban era porque querían saber si me importaría que intentaran algo contigo."
    sai "Muitas das garotas que se aproximaram de mim o fizeram porque queriam saber se eu me importaria se elas tentassem algo comigo."

# game/scripts/c16/c16.rpy:3390
translate brazilian c16s004_ConvoSairaAboutGirls_3d3a40fa:

    # sai "Pese a que les decía que podían intentarlo, creo que se me debía notar en la cara que mentía. Es difícil que quisieran ser mis amigas después de eso."
    sai "Mesmo tendo dito que eles podiam tentar, acho que ficou óbvio pela minha expressão que eu estava mentindo. É improvável que eles queiram ser meus amigos depois disso."

# game/scripts/c16/c16.rpy:3391
translate brazilian c16s004_ConvoSairaAboutGirls_588e2975:

    # mc "No me lo habías dicho nunca."
    mc "Você nunca tinha me dito isso antes."

# game/scripts/c16/c16.rpy:3393
translate brazilian c16s004_ConvoSairaAboutGirls_70851882:

    # sai "Una cosa es que tuvieras libertad para salir con quien quisieras, y otra diferente que te las buscara yo, ¿no?"
    sai "Uma coisa é você ter a liberdade de sair com quem quiser, e outra bem diferente é eu encontrar essas pessoas para você, não é?"

# game/scripts/c16/c16.rpy:3394
translate brazilian c16s004_ConvoSairaAboutGirls_eccf9a0e:

    # mc "Entiendo, pero ¿qué tiene que ver con esto?"
    mc "Entendo, mas o que isso tem a ver com o assunto?"

# game/scripts/c16/c16.rpy:3396
translate brazilian c16s004_ConvoSairaAboutGirls_437a30d6:

    # sai "Que no quiero que se repita lo mismo aquí. Anoche estuvimos hablando mucho sobre ti. Me bombardearon a preguntas."
    sai "Não quero que a mesma coisa aconteça aqui. Falamos muito de você ontem à noite. Fui bombardeado com perguntas."

# game/scripts/c16/c16.rpy:3397
translate brazilian c16s004_ConvoSairaAboutGirls_9c717159:

    # sai "No fuiste el único tema de conversación, pero la mayoría de la conversación giró en torno a ti cuando supieron lo que teníamos en Portland."
    sai "Você não era o único assunto da conversa, mas a maior parte dela girou em torno de você quando descobriram o que tínhamos em Portland."

# game/scripts/c16/c16.rpy:3402
translate brazilian c16s004_ConvoSairaAboutGirls_d75df251:

    # sai "A Debbie le gustas. No es que me haya dicho nada, pero se le nota."
    sai "A Debbie gosta de você. Ela não me disse nada, mas é óbvio."

# game/scripts/c16/c16.rpy:3404
translate brazilian c16s004_ConvoSairaAboutGirls_97078413:

    # mc "Creo que es muy tímida como para hablar de eso con nadie que no sea su hermana."
    mc "Acho que ela é tímida demais para falar sobre isso com qualquer pessoa que não seja a irmã."

# game/scripts/c16/c16.rpy:3406
translate brazilian c16s004_ConvoSairaAboutGirls_c04f9297:

    # mc "No sé si le gusto de esa forma."
    mc "Não sei se ele gosta de mim desse jeito."

# game/scripts/c16/c16.rpy:3410
translate brazilian c16s004_ConvoSairaAboutGirls_52497885:

    # sai "Kim está deseando echarte el lazo. Anoche no hacía más que preguntar por ti y por nuestra relación."
    sai "Kim está louca para te conquistar. Ontem à noite, ela não parava de perguntar sobre você e sobre o nosso relacionamento."

# game/scripts/c16/c16.rpy:3411
translate brazilian c16s004_ConvoSairaAboutGirls_58a5beb9:

    # sai "No me extrañaría que te tirase los trastos en breve."
    sai "Não me surpreenderia se ele desse em cima de você em breve."

# game/scripts/c16/c16.rpy:3412
translate brazilian c16s004_ConvoSairaAboutGirls_56791744:

    # mc "Creo que le caigo bien, pero no sé si llegará a eso."
    mc "Acho que ele gosta de mim, mas não sei se vai chegar a esse ponto."

# game/scripts/c16/c16.rpy:3416
translate brazilian c16s004_ConvoSairaAboutGirls_58b2bed5:

    # sai "Lisa aún no ha decidido si le gustas o no. Al menos de esa forma. Anoche parecía que estaba luchando consigo misma cada vez que hacía una pregunta sobre ti."
    sai "Lisa ainda não decidiu se gosta de você ou não. Pelo menos não dessa forma. Ontem à noite, ela parecia estar em conflito consigo mesma cada vez que fazia uma pergunta sobre você."

# game/scripts/c16/c16.rpy:3417
translate brazilian c16s004_ConvoSairaAboutGirls_80049e53:

    # sai "Creo que ha dejado al tal Anthony, si es que alguna vez han estado juntos, por ti."
    sai "Acho que ela terminou com aquele cara, Anthony, se é que eles chegaram a ficar juntos, por sua causa."

# game/scripts/c16/c16.rpy:3418
translate brazilian c16s004_ConvoSairaAboutGirls_6dfda06e:

    # mc "¿Lisa? Creo que te equivocas. Anthony no ha resultado ser lo que ella esperaba."
    mc "Lisa? Acho que você está enganada. Anthony não se tornou o que ela esperava."

# game/scripts/c16/c16.rpy:3422
translate brazilian c16s004_ConvoSairaAboutGirls_349ef1fc:

    # sai "Diría que Kate siente curiosidad hacia ti. No sé si en plan romántico o es que no sabe dónde encajarte en su idea del mundo."
    sai "Eu diria que Kate está curiosa a seu respeito. Não sei se é de uma forma romântica ou se ela simplesmente não sabe onde você se encaixa na visão de mundo dela."

# game/scripts/c16/c16.rpy:3423
translate brazilian c16s004_ConvoSairaAboutGirls_10400194:

    # mc "Creo que te equivocas respecto a Kate."
    mc "Acho que você está enganado sobre Kate."

# game/scripts/c16/c16.rpy:3424
translate brazilian c16s004_ConvoSairaAboutGirls_317dacfe:

    # sai "¿Por qué? ¿Porque dice que es lesbiana? No te dejes engañar. Es bisexual. Le gustan chicos y chicas. Nos contó algo que... que tiene que quedar entre las chicas."
    sai "Por quê? Porque ela diz que é lésbica? Não se enganem. Ela é bissexual. Ela gosta de meninos e meninas. Ela nos contou algo que... isso tem que ficar entre nós."

# game/scripts/c16/c16.rpy:3425
translate brazilian c16s004_ConvoSairaAboutGirls_a5435a2a:

    # sai "Pero hazme caso. No es una lesbiana de esas que piensan que todos los hombres son el diablo. Al menos ya no."
    sai "Mas acredite em mim. Ela não é uma daquelas lésbicas que acham que todos os homens são o diabo. Pelo menos não mais."

# game/scripts/c16/c16.rpy:3426
translate brazilian c16s004_ConvoSairaAboutGirls_c1872771:

    # mc "Pero sigo sin entender qué tiene que ver eso con hacerlo público."
    mc "Mas ainda não entendo o que isso tem a ver com tornar isso público."

# game/scripts/c16/c16.rpy:3428
translate brazilian c16s004_ConvoSairaAboutGirls_4cc07e63:

    # sai "A veces te cuesta entender las cosas..."
    sai "Às vezes é difícil entender as coisas..."

# game/scripts/c16/c16.rpy:3430
translate brazilian c16s004_ConvoSairaAboutGirls_7f7f16f6:

    # sai "Me estoy empezando a llevar bien con el resto de las chicas, y no querría que ella me empezara a mirar de otra forma si se enteran que hemos reanudado lo nuestro."
    sai "Estou começando a me dar bem com as outras garotas, e não gostaria que ela começasse a me olhar de forma diferente se descobrissem que retomamos nosso relacionamento."

# game/scripts/c16/c16.rpy:3431
translate brazilian c16s004_ConvoSairaAboutGirls_b29d55de:

    # sai "Además, creo que si se enterara de que estamos juntos, no intentaría nada contigo. Y no te puedo negar eso si acepto esta relación."
    sai "Além disso, acho que se ele descobrisse que estamos juntos, não tentaria nada com você. E eu não posso negar isso se aceitar este relacionamento."

# game/scripts/c16/c16.rpy:3434
translate brazilian c16s004_ConvoSairaAboutGirls_267a3396:

    # sai "Me estoy empezando a llevar bien con el resto de las chicas, y no querría que ninguna me empezara a mirar de otra forma si se enteran que hemos reanudado lo nuestro."
    sai "Estou começando a me dar bem com as outras garotas, e não gostaria que nenhuma delas começasse a me olhar de forma diferente se descobrissem que retomamos nosso relacionamento."

# game/scripts/c16/c16.rpy:3436
translate brazilian c16s004_ConvoSairaAboutGirls_96a47ec0:

    # sai "Me estoy empezando a llevar bien con el resto de las chicas. No sé si le gustas a alguna de ellas, pero si lo hacemos público empezarían a mirarme de otra forma."
    sai "Estou começando a me dar bem com as outras garotas. Não sei se alguma delas gosta de você, mas se tornarmos isso público, elas começarão a me olhar de forma diferente."

# game/scripts/c16/c16.rpy:3437
translate brazilian c16s004_ConvoSairaAboutGirls_45e66c38:

    # sai "Además, creo que si se enteraran de que estamos juntos, no intentarían nada contigo. Y no te puedo negar eso si acepto esta relación."
    sai "Além disso, acho que se descobrissem que estamos juntos, não tentariam nada com você. E eu não posso te negar isso se aceitar esse relacionamento."

# game/scripts/c16/c16.rpy:3438
translate brazilian c16s004_ConvoSairaAboutGirls_abe0a4bc:

    # mc "Vale, lo entiendo. No me gustan los secretos, pero te entiendo."
    mc "Certo, entendi. Não gosto de segredos, mas compreendo."

# game/scripts/c16/c16.rpy:3441
translate brazilian c16s004_SairaPath_73c9cbcc:

    # mc "Hubiera aceptado con cualquier condición que hubieras puesto. Has expuesto tus razones de una forma que las hacen irrechazables."
    mc "Eu teria aceitado sob quaisquer condições que você impusesse. Você apresentou seus motivos de uma forma que os torna irresistíveis."

# game/scripts/c16/c16.rpy:3443
translate brazilian c16s004_SairaPath_5582a88a:

    # sai "¡Me alegra tanto haberlo aclarado!"
    sai "Que bom que esclareci isso!"

# game/scripts/c16/c16.rpy:3444
translate brazilian c16s004_SairaPath_c024ebc0:

    # mc "Es muy difícil rechazar esos ojos."
    mc "É muito difícil rejeitar esses olhos."

# game/scripts/c16/c16.rpy:3446
translate brazilian c16s004_SairaPath_289ee7fd:

    # sai "Siempre sabes qué decir para hacerme sentir bien."
    sai "Você sempre sabe o que dizer para me fazer sentir bem."

# game/scripts/c16/c16.rpy:3447
translate brazilian c16s004_SairaPath_a627cdaf:

    # sai "Ahora me tienes que explicar cuál era la ayuda que necesitabas de mí, y después podemos empezar a desnudarnos."
    sai "Agora você precisa me explicar de que tipo de ajuda precisou, e então podemos começar a nos despir."

# game/scripts/c16/c16.rpy:3448
translate brazilian c16s004_SairaPath_74a65e0c:

    # mc "Sobre eso... no va a poder ser y lo entenderás en cuanto te pida el favor."
    mc "Sobre isso... não vai ser possível e você vai entender assim que eu lhe pedir o favor."

# game/scripts/c16/c16.rpy:3452
translate brazilian c16s004_NoSairaPath_db5d5467:

    # mc "Saira, te querré siempre, pero no estoy enamorado de ti. Lo estuve, pero me alejaste."
    mc "Saira, eu sempre vou te amar, mas não estou apaixonado por você. Eu estava, mas você me afastou."

# game/scripts/c16/c16.rpy:3455
translate brazilian c16s004_NoSairaPath_667ac86e:

    # mc "No puedo atarte a una relación en la que no se te va a amar como te mereces."
    mc "Não posso te prender a um relacionamento onde você não será amada da maneira que merece."

# game/scripts/c16/c16.rpy:3456
translate brazilian c16s004_NoSairaPath_846e3aff:

    # sai "Pero me dijiste que..."
    sai "Mas você me disse que..."

# game/scripts/c16/c16.rpy:3457
translate brazilian c16s004_NoSairaPath_7f9d4f3a:

    # mc "Que teníamos que hablar. Y lo hemos hecho. Tu estás dispuesta a dar mucho más que yo, y eso sería injusto."
    mc "Precisávamos conversar. E conversamos. Você está disposto a ceder muito mais do que eu, e isso seria injusto."

# game/scripts/c16/c16.rpy:3459
translate brazilian c16s004_NoSairaPath_5880dfae:

    # sai "No te preocupes, después del semestre de otoño, volveré a Portland a acabar la carrera. No quiero ser una molestia."
    sai "Não se preocupe, depois do semestre de outono, estarei de volta a Portland para terminar minha graduação. Não quero ser um incômodo."

# game/scripts/c16/c16.rpy:3460
translate brazilian c16s004_NoSairaPath_9fe2475c:

    # mc "No quiero que te vayas, Saira. Quédate y acaba la carrera aquí. Sé parte de esta familia. Y después decide qué quieres hacer."
    mc "Eu não quero que você vá embora, Saira. Fique e termine sua graduação aqui. Faça parte desta família. E depois decida o que você quer fazer."

# game/scripts/c16/c16.rpy:3461
translate brazilian c16s004_NoSairaPath_ac540211:

    # mc "Tú misma lo has dicho, empiezas a llevarte bien con las chicas, y con el resto de la familia no vas a tardar en hacerlo."
    mc "Você mesmo disse, está começando a se dar bem com as meninas e não vai demorar muito para fazer o mesmo com o resto da família."

# game/scripts/c16/c16.rpy:3462
translate brazilian c16s004_NoSairaPath_6c2a5b84:

    # mc "Quédate, por favor. Quiero que formes parte de mi vida, aunque no como te gustaría a ti."
    mc "Por favor, fique. Quero que você faça parte da minha vida, mesmo que não seja da maneira que você gostaria."

# game/scripts/c16/c16.rpy:3464
translate brazilian c16s004_NoSairaPath_688619d0:

    # sai "¡Joder, [mc]! Eres capaz de hacer sentir bien a una chica a la que acabas de rechazar."
    sai "Caramba, [mc]! Você é capaz de fazer uma garota que você acabou de rejeitar se sentir bem."

# game/scripts/c16/c16.rpy:3465
translate brazilian c16s004_NoSairaPath_75a38ec1:

    # sai "No lo haces sólo porque ahora me vayas a pedir un favor, ¿verdad?"
    sai "Você não está fazendo isso só porque vai me pedir um favor agora, está?"

# game/scripts/c16/c16.rpy:3466
translate brazilian c16s004_NoSairaPath_03f328f1:

    # mc "*Risa* Sobre eso..."
    mc "*Risos* Sobre isso..."

# game/scripts/c16/c16.rpy:3470
translate brazilian c16s004_SleepingArrangements_27eec3de:

    # mc "¿Te acuerdas de Megan Peel? ¿De Portland?"
    mc "Você se lembra de Megan Peel? De Portland?"

# game/scripts/c16/c16.rpy:3471
translate brazilian c16s004_SleepingArrangements_ce2ed4f1:

    # sai "¿La cantante? Sí, claro. Nunca fuimos buenas amigas, pero nos caíamos bien. ¿Por qué?"
    sai "A cantora? Sim, claro. Nunca fomos amigas íntimas, mas nos dávamos bem. Por quê?"

# game/scripts/c16/c16.rpy:3473
translate brazilian c16s004_SleepingArrangements_a5f3c7bf:

    # mc "Vive en Westport, al norte. Canta en un club de Jazz, aquí en Newport, los fines de semana."
    mc "Ela mora em Westport, no norte. Ela canta em um clube de jazz aqui em Newport nos fins de semana."

# game/scripts/c16/c16.rpy:3474
translate brazilian c16s004_SleepingArrangements_ded958db:

    # sai "Oh, eso está genial. Tenía una voz preciosa, podríamos ir a escucharla un día. Pero ¿qué tiene que ver conmigo?"
    sai "Ah, que ótimo! Ela tinha uma voz linda; poderíamos ir ouvi-la qualquer dia desses. Mas o que isso tem a ver comigo?"

# game/scripts/c16/c16.rpy:3475
translate brazilian c16s004_SleepingArrangements_bc0ffb5c:

    # mc "Va a pasar este fin de semana en casa. Tiene el coche averiado."
    mc "Ele vai passar o fim de semana em casa. O carro dele está avariado."

# game/scripts/c16/c16.rpy:3477
translate brazilian c16s004_SleepingArrangements_8315bf71:

    # sai "¿Dónde va a dormir? Tenéis la casa llena."
    sai "Onde ele vai dormir? Sua casa está cheia."

# game/scripts/c16/c16.rpy:3478
translate brazilian c16s004_SleepingArrangements_127f3f45:

    # mc "Ese es el favor que te quería pedir. ¿Te importaría compartir habitación con ella?"
    mc "Esse é o favor que eu queria te pedir. Você se importaria de dividir o quarto com ela?"

# game/scripts/c16/c16.rpy:3479
translate brazilian c16s004_SleepingArrangements_d2118bd0:

    # mc "Si no te parece bien le puedo ceder mi habitación y buscarme algún sitio donde dormir."
    mc "Se você não gostar disso, posso ceder meu quarto e encontrar outro lugar para dormir."

# game/scripts/c16/c16.rpy:3482
translate brazilian c16s004_SleepingArrangements_cd2483fe:

    # sai "Cédele tu habitación y duerme aquí todo el fin de semana. O mejor aún, pasa aquí todo el fin de semana sin dormir. *Risa*"
    sai "Dê seu quarto para ele e durma aqui o fim de semana todo. Ou melhor ainda, passe o fim de semana inteiro aqui sem dormir. *Risos*"

# game/scripts/c16/c16.rpy:3483
translate brazilian c16s004_SleepingArrangements_2f91b13d:

    # mc "Perfecto. Te pasarás todo el fin de semana gimiendo y tu secreto se esfumará. Las chicas no te hablarán y mi madre te echará laxante en el desayuno. *Risa*"
    mc "Perfeito. Você vai passar o fim de semana inteiro gemendo e seu segredo será revelado. As meninas não vão falar com você e minha mãe vai colocar laxante no seu café da manhã. *Risos*"

# game/scripts/c16/c16.rpy:3486
translate brazilian c16s004_SleepingArrangements_7186f082:

    # sai "No hay ningún problema. Megan me gustaba y podemos aprovechar para ponernos al día."
    sai "Sem problema. Gostei da Megan, e podemos aproveitar esta oportunidade para colocar a conversa em dia."

# game/scripts/c16/c16.rpy:3487
translate brazilian c16s004_SleepingArrangements_3795d185:

    # mc "Genial, no os paséis hablando hasta muy tarde cuando vuelva del trabajo, o molestaréis a todo el mundo. Las chicas no te hablarán y mi madre te echará laxante en el desayuno. *Risa*"
    mc "Ótimo, mas não fique falando até muito tarde quando eu chegar do trabalho, senão você vai incomodar todo mundo. As meninas não vão querer falar com você, e minha mãe vai colocar laxante no seu café da manhã. *Risos*"

# game/scripts/c16/c16.rpy:3489
translate brazilian c16s004_SleepingArrangements_0f7c323c:

    # sai "Eileen me defendería de las chicas y me traería pañales. *Risa*"
    sai "Eileen me defendia das meninas e me trazia fraldas. *Risos*"

# game/scripts/c16/c16.rpy:3490
translate brazilian c16s004_SleepingArrangements_eb1ccacd:

    # mc "De querer sacarle los ojos a ser las mejores amigas."
    mc "De querer arrancar os olhos um do outro a serem melhores amigos."

# game/scripts/c16/c16.rpy:3492
translate brazilian c16s004_SleepingArrangements_22e2f28c:

    # sai "Estaba totalmente equivocada con ella. Se ha portado muy bien conmigo."
    sai "Eu estava completamente enganado a respeito dela. Ela tem sido muito boa para mim."

# game/scripts/c16/c16.rpy:3493
translate brazilian c16s004_SleepingArrangements_4ee0bfcd:

    # mc "Es normal que estuvieras equivocada. *Risa* No la conocías y para ti ya era La Bruja Pelirroja."
    mc "É normal que você estivesse errado. *Risos* Você não a conhecia e para você ela já era a Bruxa Ruiva."

# game/scripts/c16/c16.rpy:3495
translate brazilian c16s004_SleepingArrangements_9e38dbc9:

    # sai "No me lo recuerdes..."
    sai "Não me lembre..."

# game/scripts/c16/c16.rpy:3496
translate brazilian c16s004_SleepingArrangements_03993d19:

    # mc "Bueno, yo me voy a ir a buscar a Megan. No sé si tienes que ordenar algo o hacerle hueco en el armario."
    mc "Certo, vou procurar a Megan. Não sei se você precisa arrumar alguma coisa ou abrir espaço para ela no armário."

# game/scripts/c16/c16.rpy:3498
translate brazilian c16s004_SleepingArrangements_9a6d3243:

    # sai "Sí, recogeré las bragas de debajo de la cama y guardaré los consoladores bajo llave. *Risa* ¡Soy una chica ordenada, [mc]! ¡No tengo bragas bajo la cama!"
    sai "Sim, vou pegar as calcinhas debaixo da cama e trancar os vibradores. *Risos* Sou uma garota organizada, [mc]! Não guardo calcinhas debaixo da cama!"

# game/scripts/c16/c16.rpy:3499
translate brazilian c16s004_SleepingArrangements_79047ed1:

    # mc "¡No lo decía por eso! *Risa* Pero no has dicho que no tengas consoladores."
    mc "Não quis dizer isso! *Risos* Mas você não disse que não tem nenhum vibrador."

# game/scripts/c16/c16.rpy:3500
translate brazilian c16s004_SleepingArrangements_7ef9a421:

    # sai "¡Vete antes de que te pegue con uno en la frente!"
    sai "Vaza daqui antes que eu te dê uma pancada na testa!"

# game/scripts/c16/c16.rpy:3525
translate brazilian c16s005_PickUpMegan_58d72156:

    # "Cuando llegas a la parada de autobús, Megan interrumpe su conversación con una anciana para saludarte. La anciana te mira con una sonrisa."
    "Ao chegar no ponto de ônibus, Megan interrompe sua conversa com uma senhora idosa para cumprimentá-lo(a). A senhora olha para você com um sorriso."

# game/scripts/c16/c16.rpy:3528
translate brazilian c16s005_PickUpMegan_09f24ce5:

    # mc "Hola, preciosa. ¡Cuánta efusividad! ¿Qué le estabas contando a la anciana? Me ha mirado como si me conociera."
    mc "Oi, linda. Que elogio! O que você estava dizendo para a senhora? Ela me olhou como se me conhecesse."

# game/scripts/c16/c16.rpy:3531
translate brazilian c16s005_PickUpMegan_b3ac6cf4:

    # meg "Hola, guapísimo. Le he dicho que mi novio venía a buscarme y ha empezado a cotillear. *Risa*"
    meg "Oi, lindo. Eu disse a ele que meu namorado viria me buscar e ele começou a fofocar. *Risos*"

# game/scripts/c16/c16.rpy:3533
translate brazilian c16s005_PickUpMegan_369b2446:

    # meg "Hola, [mc]. Le he dicho que un amigo venía a buscarme y ha empezado a cotillear y a hacer preguntas incómodas. *Risa*"
    meg "Oi, [mc]. Eu disse a ela que uma amiga viria me buscar, e ela começou a bisbilhotar e a fazer perguntas constrangedoras. *Risos*"

# game/scripts/c16/c16.rpy:3534
translate brazilian c16s005_PickUpMegan_8fbab4d7:

    # meg "Ahora puede pensar lo que quiera. *Risa*"
    meg "Agora você pode pensar o que quiser. *Risos*"

# game/scripts/c16/c16.rpy:3536
translate brazilian c16s005_PickUpMegan_32973cd1:

    # mc "¿Hace mucho que has llegado? ¿A qué hora tienes que estar en el club?"
    mc "Você está aqui há muito tempo? A que horas você precisa estar no clube?"

# game/scripts/c16/c16.rpy:3537
translate brazilian c16s005_PickUpMegan_fb0a2596:

    # meg "Diez minutos, pero se me han hecho eternos con las preguntas de la abuela. *Risa*"
    meg "Dez minutos, mas pareceu uma eternidade com as perguntas da vovó. *Risos*"

# game/scripts/c16/c16.rpy:3538
translate brazilian c16s005_PickUpMegan_8f9b6a51:

    # meg "Entro a trabajar a las 9. ¿Por qué lo preguntas?"
    meg "Começo a trabalhar às 9. Por que você pergunta?"

# game/scripts/c16/c16.rpy:3539
translate brazilian c16s005_PickUpMegan_1995580b:

    # mc "Déjame coger tu maleta. ¿Te dará tiempo de cenar en casa? "
    mc "Deixe-me levar sua mala. Você terá tempo para jantar em casa?"

# game/scripts/c16/c16.rpy:3541
translate brazilian c16s005_PickUpMegan_481d78d0:

    # meg "No puedo, los viernes vamos a cenar todo el personal antes de abrir el Jazz Corner. Es una costumbre. Pero mañana seguro que puedo cenar con vosotros."
    meg "Não poderei ir; às sextas-feiras, toda a equipe sai para jantar antes de abrir o Jazz Corner. É uma tradição. Mas tenho certeza de que poderei jantar com você amanhã."

# game/scripts/c16/c16.rpy:3543
translate brazilian c16s005_PickUpMegan_3204c9b1:

    # meg "Si tu madre no me echa de casa cuando le diga que las dos estamos contigo, claro."
    meg "Claro que, se sua mãe não me expulsar de casa quando eu disser que estamos os dois com você."

# game/scripts/c16/c16.rpy:3544
translate brazilian c16s005_PickUpMegan_28facc1f:

    # mc "Estoy seguro de que te vas a llevar una sorpresa con mi madre. Por no hablar de la que te vas a llevar en la comida de mañana."
    mc "Tenho certeza de que você ficará surpreso(a) com a minha mãe. Sem falar na surpresa que você terá no almoço amanhã."

# game/scripts/c16/c16.rpy:3546
translate brazilian c16s005_PickUpMegan_6d12f5dc:

    # mc "Entonces la sorpresa te la llevarás mañana durante la comida de mañana."
    mc "Então você terá a surpresa amanhã durante o almoço."

# game/scripts/c16/c16.rpy:3548
translate brazilian c16s005_PickUpMegan_d1f41f32:

    # meg "¿A qué te refieres? ¿Qué sorpresa tienes preparada?"
    meg "O que você quer dizer? Que surpresa você preparou?"

# game/scripts/c16/c16.rpy:3549
translate brazilian c16s005_PickUpMegan_d3016bbb:

    # mc "Es el momento de que tengamos La Clonversación. Te lo explico en el coche."
    mc "Chegou a hora de termos a conversa sobre o Clones. Eu explico tudo para você no carro."

# game/scripts/c16/c16.rpy:3552
translate brazilian c16s005_PickUpMegan_7db563ba:

    # "Para cuando acabas La Conversación, ya estáis tan solo a unos minutos de casa. Megan ha tenido la boca abierta con un gesto de sorpresa los últimos minutos."
    "Ao terminar de ler \"A Conversa\", você estará a poucos minutos de casa. Megan está boquiaberta de surpresa há alguns minutos."

# game/scripts/c16/c16.rpy:3553
translate brazilian c16s005_PickUpMegan_4a2893c6:

    # meg "¡Alucinante! ¿Me estás diciendo que habéis estado en peligro de que os asesinaran?"
    meg "Incrível! Você está me dizendo que correu o risco de ser assassinado?"

# game/scripts/c16/c16.rpy:3555
translate brazilian c16s005_PickUpMegan_8c6c9dec:

    # meg "¿Que es posible que asesinaran a tus tíos en el accidente de avión?"
    meg "É possível que seus tios tenham sido assassinados no acidente de avião?"

# game/scripts/c16/c16.rpy:3556
translate brazilian c16s005_PickUpMegan_86b2f47c:

    # meg "¿Que tienes clones como guardaespaldas? ¿Y que son clones de tu hermana y tus primas?"
    meg "Você tem clones como guarda-costas? E eles são clones da sua irmã e dos seus primos?"

# game/scripts/c16/c16.rpy:3558
translate brazilian c16s005_PickUpMegan_57d3b6a5:

    # meg "¿Que es posible que asesinaran a tu madre en el accidente de avión?"
    meg "É possível que sua mãe tenha sido assassinada no acidente de avião?"

# game/scripts/c16/c16.rpy:3559
translate brazilian c16s005_PickUpMegan_09ccdf39:

    # meg "¿Que tu hermana y tus primas son clones de vuestros guardaespaldas?"
    meg "Sua irmã e seus primos são clones dos seus guarda-costas?"

# game/scripts/c16/c16.rpy:3560
translate brazilian c16s005_PickUpMegan_fa3e2e1a:

    # meg "¿Que eres propietario de una empresa de clonación y que tienes un ejército privado... de clones?"
    meg "Você é dono de uma empresa de clonagem e tem um exército particular... de clones?"

# game/scripts/c16/c16.rpy:3561
translate brazilian c16s005_PickUpMegan_5562402a:

    # mc "Más o menos. En resumen es eso. Aunque ni el ejército ni la empresa son míos. Son de la familia, y aún no sabemos qué vamos a hacer con ello."
    mc "Mais ou menos. Essa é a essência da questão. Embora nem o exército nem a empresa sejam meus. Pertencem à família, e ainda não sabemos o que faremos com eles."

# game/scripts/c16/c16.rpy:3563
translate brazilian c16s005_PickUpMegan_a672ab84:

    # meg "¡Creía que esas cosas no existían hasta hace diez minutos! Me da lo mismo de quien sean. ¡Es una mezcla de James Bind y la segunda trilogía de Galaxy Wars!"
    meg "Eu nem imaginava que isso existisse até dez minutos atrás! Não me importa quem fez. É uma mistura de James Bond com a segunda trilogia de Guerras Galácticas!"

# game/scripts/c16/c16.rpy:3564
translate brazilian c16s005_PickUpMegan_7f3d950f:

    # mc "Esa frase me la esperaría de [dap]. Te va a caer bien."
    mc "Eu esperaria isso de [dap]. Você vai gostar dele."

# game/scripts/c16/c16.rpy:3566
translate brazilian c16s005_PickUpMegan_6fe73f4b:

    # meg "Estoy flipando. Parece que te lo tomas como lo más normal del mundo."
    meg "Estou impressionado. Você parece encarar isso como a coisa mais normal do mundo."

# game/scripts/c16/c16.rpy:3567
translate brazilian c16s005_PickUpMegan_c8bcc9a6:

    # mc "He tenido La Clonversación cinco veces en las últimas 24 horas. He oído todo tipo de reacciones. Cuánto más la repito, más normal me parece todo."
    mc "Já tive a conversa sobre o clone cinco vezes nas últimas 24 horas. Ouvi todos os tipos de reações. Quanto mais repito, mais normal tudo parece."

# game/scripts/c16/c16.rpy:3568
translate brazilian c16s005_PickUpMegan_8eb0e1df:

    # mc "Y cuando conozcas a las chicas, verás que son personas normales."
    mc "E quando você conhecer as garotas, verá que elas são pessoas normais."

# game/scripts/c16/c16.rpy:3570
translate brazilian c16s005_PickUpMegan_81313c4c:

    # meg "No lo dudo. Seguro que son fantásticas. No quería que sonara así."
    meg "Não duvido. Tenho certeza de que são fantásticos. Não era minha intenção dar essa impressão."

# game/scripts/c16/c16.rpy:3571
translate brazilian c16s005_PickUpMegan_edcbd774:

    # mc "Ya te he dicho que he tenido la conversación varias veces. Conozco las reacciones. Yo estaría igual de flipado que tú."
    mc "Eu já te disse que já tive essa conversa várias vezes. Conheço as reações. Eu ficaria tão chocado quanto você."

# game/scripts/c16/c16.rpy:3572
translate brazilian c16s005_PickUpMegan_d52ab70f:

    # mc "Pero volviendo al tema de la cena, ¿quieres que te lleve a la cena del Jazz Corner?"
    mc "Mas voltando ao assunto do jantar, você gostaria que eu te levasse para jantar no Jazz Corner?"

# game/scripts/c16/c16.rpy:3574
translate brazilian c16s005_PickUpMegan_eae91794:

    # meg "No hace falta. Parece que tienes un día muy ocupado hoy. Pediré un Under para ir, y otro para volver cuando cerremos."
    meg "Não precisa. Parece que você está tendo um dia corrido. Vou pedir um Under para viagem e outro para trazer quando fecharmos."

# game/scripts/c16/c16.rpy:3575
translate brazilian c16s005_PickUpMegan_d20119c8:

    # meg "No quiero despertar a nadie al volver, ni que tengas que quedarte despierto hasta tarde para recogerme."
    meg "Não quero acordar ninguém quando voltar, nem que você fique acordado até tarde para me buscar."

# game/scripts/c16/c16.rpy:3576
translate brazilian c16s005_PickUpMegan_483e268d:

    # mc "Bueno... sobre lo de despertar a alguien..."
    mc "Bem... sobre acordar alguém..."

# game/scripts/c16/c16.rpy:3577
translate brazilian c16s005_PickUpMegan_90ed5b3c:

    # mc "Ha habido un pequeño problema logístico con las camas. Puedes dormir en mi habitación o en la de Saira."
    mc "Houve um pequeno problema logístico com as camas. Você pode dormir no meu quarto ou no da Saira."

# game/scripts/c16/c16.rpy:3579
translate brazilian c16s005_PickUpMegan_c2b571c1:

    # meg "¿Saira? ¿Tu Saira de Portland?"
    meg "Saira? Sua Saira de Portland?"

# game/scripts/c16/c16.rpy:3580
translate brazilian c16s005_PickUpMegan_5a2352f5:

    # mc "Claro, tú no lo sabes. Sí, está haciendo un curso de verano aquí."
    mc "Claro que você não sabe disso. Sim, ele está fazendo um curso de verão aqui."

# game/scripts/c16/c16.rpy:3583
translate brazilian c16s005_PickUpMegan_a3a6e20f:

    # meg "¿Saira está aquí? ¿volvéis a estar juntos? ¿Cómo nos deja eso a nosotros?"
    meg "A Saira está aqui? Vocês dois voltaram a ficar juntos? Como isso nos deixa?"

# game/scripts/c16/c16.rpy:3584
translate brazilian c16s005_PickUpMegan_48ff20d3:

    # mc "Megan, que esté o no con Saira no afecta a cómo estemos tú y yo. Yo estoy contigo y ninguna otra mujer va a cambiar eso. Sea quién sea."
    mc "Megan, o fato de eu estar ou não com a Saira não afeta em nada a nossa relação. Estou com você, e nenhuma outra mulher vai mudar isso. Seja quem for."

# game/scripts/c16/c16.rpy:3586
translate brazilian c16s005_PickUpMegan_b90364a8:

    # meg "Me quitas un peso de encima. Por un momento he pensado que... no sé..."
    meg "Você tirou um peso dos meus ombros. Por um momento pensei que... não sei..."

# game/scripts/c16/c16.rpy:3588
translate brazilian c16s005_PickUpMegan_69510d4b:

    # meg "Si a eso le sumas lo de tu madre... ¿Cuándo crees que sería un buen momento para hablar con tu madre? Ya sabes... sobre nosotros... y vosotros..."
    meg "Se você somar a situação da sua mãe a isso... Quando você acha que seria um bom momento para conversar com ela? Sabe... sobre nós... e sobre vocês..."

# game/scripts/c16/c16.rpy:3589
translate brazilian c16s005_PickUpMegan_e83e8012:

    # mc "Seguramente mañana. Hoy tú vas justa de tiempo y ella estará ocupada preparando la cena para Amanda. Es la primera vez que viene a cenar."
    mc "Provavelmente amanhã. Você está com pouco tempo hoje, e ela estará ocupada preparando o jantar para Amanda. É a primeira vez que ela vem jantar aqui."

# game/scripts/c16/c16.rpy:3591
translate brazilian c16s005_PickUpMegan_d7553f4e:

    # meg "Creo que es lógico. Amanda es la que es igual que tu hermana, ¿no? Tiene que ser difícil para tu madre. Y emotivo."
    meg "Acho que faz sentido. Amanda é igualzinha à sua irmã, não é? Deve ser difícil para sua mãe. E emocionalmente desgastante."

# game/scripts/c16/c16.rpy:3592
translate brazilian c16s005_PickUpMegan_03f1791a:

    # mc "Lo es. Más emotivo que difícil. Para ella es como conocer a una hija con la que no ha tenido contacto nunca."
    mc "Sim, é. Mais emocionante do que difícil. Para ela, é como reencontrar uma filha com quem nunca teve contato."

# game/scripts/c16/c16.rpy:3594
translate brazilian c16s005_PickUpMegan_12b52c47:

    # meg "Sobre lo de la habitación, creo que será mejor que no duerma contigo en su casa hasta que no hable con ella. Me quedaré con Saira si a ella no le importa."
    meg "Em relação ao quarto, acho melhor que ela não durma na casa dela até que eu fale com ela. Eu ficarei com a Saira, se ela não se importar."

# game/scripts/c16/c16.rpy:3595
translate brazilian c16s005_PickUpMegan_04742302:

    # mc "*Risa* No le importa, ya se lo he preguntado. Siempre le caíste bien. Y en mi habitación ibas a estar sola. Yo iba a dormir en algún sofá."
    mc "*Risos* Ele não se importa, eu já perguntei. Ele sempre gostou de você. E você ia ficar sozinha no meu quarto. Eu ia dormir no sofá."

# game/scripts/c16/c16.rpy:3596
translate brazilian c16s005_PickUpMegan_45f5cf1a:

    # mc "Creo que tenéis que hablar antes de que tú y yo podamos dormir juntos en casa."
    mc "Acho que vocês dois precisam conversar antes que eu e você possamos dormir juntos em casa."

# game/scripts/c16/c16.rpy:3598
translate brazilian c16s005_PickUpMegan_ca2a7d3a:

    # mc "No te preocupes, me gustas mucho y eso no va a cambiar."
    mc "Não se preocupe, eu gosto muito de você e isso não vai mudar."

# game/scripts/c16/c16.rpy:3600
translate brazilian c16s005_PickUpMegan_7ba64c70:

    # meg "Creo que será mejor que no duerma contigo hasta que no hable con ella. Me quedaré con Saira si a ella no le importa."
    meg "Acho melhor não dormir com você até falar com ela. Vou ficar com a Saira se ela não se importar."

# game/scripts/c16/c16.rpy:3601
translate brazilian c16s005_PickUpMegan_04742302_1:

    # mc "*Risa* No le importa, ya se lo he preguntado. Siempre le caíste bien. Y en mi habitación ibas a estar sola. Yo iba a dormir en algún sofá."
    mc "*Risos* Ele não se importa, eu já perguntei. Ele sempre gostou de você. E você ia ficar sozinha no meu quarto. Eu ia dormir no sofá."

# game/scripts/c16/c16.rpy:3602
translate brazilian c16s005_PickUpMegan_dcb1b23a:

    # mc "Creo que será bueno que os pongáis al día."
    mc "Acho que seria bom para você se atualizar."

# game/scripts/c16/c16.rpy:3604
translate brazilian c16s005_PickUpMegan_bd04d5e6:

    # mc "Hay otro tema del que te quería hablar. ¿Has sentido algún tipo de molestias últimamente?"
