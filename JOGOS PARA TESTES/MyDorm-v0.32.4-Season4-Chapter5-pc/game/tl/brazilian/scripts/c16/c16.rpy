# game/scripts/c16/c16.rpy:66
translate brazilian c16s001_Whatif_7247ad10:

    # "No estás en ruta con [emm] y [mar] a la vez y hay una escena interesante que necesita las dos rutas abiertas. ¿Quieres verla?"
    "Você não está nas rotas [emm] e [mar] ao mesmo tempo, e há uma cena interessante que exige que ambas as rotas estejam abertas. Quer ver?"

# game/scripts/c16/c16.rpy:112
translate brazilian c16s001_EmmaLessons_716a5ffc:

    # mc "¿Pero qué estás diciendo, [mar.mc!t]?"
    mc "O que você está dizendo, [mar.mc!t]?"

# game/scripts/c16/c16.rpy:113
translate brazilian c16s001_EmmaLessons_8cd9cd9a:

    # mc "¿Cómo voy a enseñar a [emm] a besar contigo aquí?"
    mc "Como vou ensinar [emm] a te beijar aqui?"

# game/scripts/c16/c16.rpy:115
translate brazilian c16s001_EmmaLessons_1d3dc463:

    # mom "Bueno, yo preferiría estar para poder corregir lo que vea que hace mal. Pero si creéis que si me quedo aquí os cohibiría..."
    mom "Bem, eu preferiria estar aqui para poder corrigir o que vejo que ele está fazendo de errado. Mas se você acha que, se eu ficar aqui, isso te deixaria desconfortável..."

# game/scripts/c16/c16.rpy:117
translate brazilian c16s001_EmmaLessons_e0c0c11d:

    # emm "No, Mamá, yo preferiría que estuvieras."
    emm "Não, mãe, eu preferia que você estivesse aqui."

# game/scripts/c16/c16.rpy:118
translate brazilian c16s001_EmmaLessons_bd9fb73f:

    # emm "Si te vas, ¿cómo voy a saber si lo hago bien o no?"
    emm "Se você for embora, como vou saber se estou fazendo certo ou não?"

# game/scripts/c16/c16.rpy:120
translate brazilian c16s001_EmmaLessons_036c6829:

    # mom "No sé... supongo que [mc] te lo podría decir, aunque ver a mis hijos besándose... podría ser raro, ¿no?"
    mom "Não sei... Acho que poderia te contar, embora ver meus filhos se beijando... talvez seja estranho, né?"

# game/scripts/c16/c16.rpy:122
translate brazilian c16s001_EmmaLessons_58b4823c:

    # mcp "(A partir de mañana, una vez le cuentes la verdad a [emm], ya no vas a poder decir eso. Realmente no te envidio teniendo que tener esa conversación.)"
    mcp "(A partir de amanhã, depois de contar a verdade para [emm], você não poderá mais dizer isso. Não te invejo por ter que ter essa conversa.)"

# game/scripts/c16/c16.rpy:123
translate brazilian c16s001_EmmaLessons_f4182a73:

    # mcp "(No sé a lo que está jugando [emm], pero voy a seguirle el juego.)"
    mcp "(Não sei o que [emm] está aprontando, mas vou entrar na brincadeira.)"

# game/scripts/c16/c16.rpy:124
translate brazilian c16s001_EmmaLessons_f575c78b:

    # mc "Si [emm] se va a sentir más cómoda contigo aquí, por mí no hay ningún problema en que te quedes."
    mc "Se [emm] se sentir mais confortável com você aqui, não tenho problema nenhum em você ficar."

# game/scripts/c16/c16.rpy:125
translate brazilian c16s001_EmmaLessons_850ffdca:

    # mc "Lo que me sorprende es que quieras que le enseñe a besar yo. ¿Eso no lo hacéis entre chicas?"
    mc "O que me surpreende é que você queira que eu a ensine a beijar. Vocês não fazem isso?"

# game/scripts/c16/c16.rpy:127
translate brazilian c16s001_EmmaLessons_6c57c742:

    # mom "Bueno, sí, pero normalmente cuando somos más jóvenes que [emm]. A esta edad... pueden pasar cosas..."
    mom "Bem, sim, mas geralmente quando somos mais jovens que [emm]. Nessa idade... as coisas podem acontecer..."

# game/scripts/c16/c16.rpy:128
translate brazilian c16s001_EmmaLessons_492b8be0:

    # mom "[emm] es una flor tardía. 18 años y aún no ha besado a ningún chico... al menos un beso de verdad."
    mom "[emm] Ela é uma pessoa que amadureceu tarde. Tem dezoito anos e ainda não beijou um rapaz... pelo menos não um beijo de verdade."

# game/scripts/c16/c16.rpy:130
translate brazilian c16s001_EmmaLessons_dd1ac1df:

    # emm "Si no fuera porque esto ha sido idea tuya, casi me enfadaría por lo que acabas de decir, Mamá."
    emm "Se não tivesse sido ideia sua, eu quase ficaria brava com o que você acabou de dizer, mãe."

# game/scripts/c16/c16.rpy:131
translate brazilian c16s001_EmmaLessons_8ae85801:

    # mc "[emm], ser una flor tardía no es nada malo. Imagínate que eres una rosa."
    mc "[emm], ser uma pessoa que floresce mais tarde não é nada ruim. Imagine que você é uma rosa."

# game/scripts/c16/c16.rpy:133
translate brazilian c16s001_EmmaLessons_da480aac:

    # emm "¿Puedo ser una rosa de color rosa?"
    emm "Posso ser uma rosa cor-de-rosa?"

# game/scripts/c16/c16.rpy:134
translate brazilian c16s001_EmmaLessons_48ac0d55:

    # mcp "(Me está costando horrores aguantarme la risa. [emm] está sobreactuando comportándose como una niña pequeña.)"
    mcp "(Estou tendo muita dificuldade em conter o riso. [emm] Ela está exagerando, se comportando como uma menininha.)"

# game/scripts/c16/c16.rpy:135
translate brazilian c16s001_EmmaLessons_a8c9557f:

    # mc "Sí, [emm], puedes ser una rosa rosa."
    mc "Sim, [emm], você pode ser uma rosa cor-de-rosa."

# game/scripts/c16/c16.rpy:137
translate brazilian c16s001_EmmaLessons_34db9ec4:

    # emm "Entonces, ¿te quedas, Mamá? Ya sabes... para darme consejos sobre lo que hago mal."
    emm "Então, você vai ficar, mãe? Sabe... para me dar conselhos sobre o que estou fazendo de errado."

# game/scripts/c16/c16.rpy:138
translate brazilian c16s001_EmmaLessons_ea119207:

    # mc "A mí no me importa que te quedes, ya te lo he dicho. Parece que [emm] necesita tu apoyo."
    mc "Não me importo que você fique, eu já lhe disse isso. Parece que [emm] precisa do seu apoio."

# game/scripts/c16/c16.rpy:140
translate brazilian c16s001_EmmaLessons_8d27d7a6:

    # mom "OK. Os miraré desde el sofá y le daré las indicaciones necesarias."
    mom "Certo. Vou observar você do sofá e lhe dar as instruções necessárias."

# game/scripts/c16/c16.rpy:141
translate brazilian c16s001_EmmaLessons_e51ff240:

    # mc "¿Me dais un momento para que me quite esta ropa? Yo iba a dormir, pero creo que estas lecciones pueden ser divertidas."
    mc "Você pode me dar um minutinho para tirar essas roupas? Eu ia dormir, mas acho que essas aulas podem ser divertidas."

# game/scripts/c16/c16.rpy:143
translate brazilian c16s001_EmmaLessons_0a784105:

    # mom "Vale, ¿salimos de la habitación?"
    mom "Certo, podemos sair da sala?"

# game/scripts/c16/c16.rpy:144
translate brazilian c16s001_EmmaLessons_3fc0f0e1:

    # mc "¿Para qué? Las dos me visteis dormir desnudo la última vez. No vais a ver nada que no hayáis visto."
    mc "Pra quê? Vocês dois me viram dormindo nua da última vez. Não vão ver nada que já não tenham visto."

# game/scripts/c16/c16.rpy:146
translate brazilian c16s001_EmmaLessons_30672f27:

    # emm "¿Te vas a desnudar? Pero yo... yo..."
    emm "Você vai ficar nu? Mas eu... eu..."

# game/scripts/c16/c16.rpy:147
translate brazilian c16s001_EmmaLessons_63017d86:

    # mom "No me parece correcto, [mc]. Si [emm] lo hace bien y Mjolnir empieza a crecer... no creo que haya visto ninguna... erección nunca..."
    mom "Acho que isso não está certo, [mc]. Se [emm] fizer direito e Mjolnir começar a crescer... Acho que nunca vi uma ereção..."

# game/scripts/c16/c16.rpy:148
translate brazilian c16s001_EmmaLessons_008f3a27:

    # mc "¿Ni siquiera en el porno?"
    mc "Nem mesmo em filmes pornográficos?"

# game/scripts/c16/c16.rpy:150
translate brazilian c16s001_EmmaLessons_c5bd2ffd:

    # emm "¿Por quién me has tomado, [mc]? ¿Por una pervertida que ve porno?"
    emm "Quem você pensa que eu sou, [mc]? Um pervertido que assiste pornografia?"

# game/scripts/c16/c16.rpy:151
translate brazilian c16s001_EmmaLessons_5febbab6:

    # mcp "(No te pases, [emm]. Si yo sé que ves porno, lo más probable es que [mar.mc!t] también lo sepa.)"
    mcp "(Não exagere, [emm]. Se eu sei que você assiste pornografia, é provável que [mar.mc!t] também saiba.)"

# game/scripts/c16/c16.rpy:152
translate brazilian c16s001_EmmaLessons_b87cb3be:

    # mc "Como ya os he dicho, me voy a desnudar. Mi habitación, mis normas. Dadme un segundo."
    mc "Como já lhe disse, vou ficar nu. Meu quarto, minhas regras. Só um segundo."

# game/scripts/c16/c16.rpy:154
translate brazilian c16s001_EmmaLessons_4c1c0296:

    # mc "Ya está. ¿Cómo quieres hacerlo, Mamá?"
    mc "Certo. Como você quer fazer, mãe?"

# game/scripts/c16/c16.rpy:155
translate brazilian c16s001_EmmaLessons_ccb72c29:

    # mom "Pues creo que... ahí, de pie... sería lo mejor... cuando [emm] bese a su novio... los primeros besos serán... de pie, ¿no?"
    mom "Bem, eu acho que... ficar de pé lá em cima... seria melhor... quando [emm] beijar o namorado... os primeiros beijos serão... de pé, certo?"

# game/scripts/c16/c16.rpy:156
translate brazilian c16s001_EmmaLessons_3deb5bbc:

    # emm "A mí me parece... buena idea... así puedes... corregirme... si hago algo mal..."
    emm "Acho que é uma boa ideia... assim você pode me corrigir se eu fizer algo errado..."

# game/scripts/c16/c16.rpy:157
translate brazilian c16s001_EmmaLessons_5e2f8223:

    # mc "Me parece bien. [emm], ven aquí."
    mc "Parece-me ótimo. Venha cá."

# game/scripts/c16/c16.rpy:159
translate brazilian c16s001_EmmaLessons_1cb1e37c:

    # emm "¿Preparado para el mejor beso del mundo?"
    emm "Preparado(a) para o melhor beijo do mundo?"

# game/scripts/c16/c16.rpy:161
translate brazilian c16s001_EmmaLessons_a08d05ab:

    # mc "Seguro que lo es, [emm]."
    mc "Tenho certeza que sim, [emm]."

# game/scripts/c16/c16.rpy:164
translate brazilian c16s001_EmmaLessons_7d26a247:

    # "Tras guiñarte un ojo, [emm] te da posiblemente el peor beso de tu vida. Solo comparable al de Scarlett en el Twins."
    "Depois de piscar para você, [emm] te dá possivelmente o pior beijo da sua vida. Comparável apenas ao da Scarlett em Twins."

# game/scripts/c16/c16.rpy:165
translate brazilian c16s001_EmmaLessons_27c96495:

    # emm "¿Qué tal lo he hecho?"
    emm "Como me saí?"

# game/scripts/c16/c16.rpy:166
translate brazilian c16s001_EmmaLessons_41bba42b:

    # mc "La abuela me besa con más pasión, [emm]."
    mc "A vovó me beija com mais paixão, [emm]."

# game/scripts/c16/c16.rpy:168
translate brazilian c16s001_EmmaLessons_e932921a:

    # mom "¡Por Dios, [emm]! ¡Eso se parece más a los besos que me dabas a mí cuando eras una niña que a cómo deberías besar a un chico!"
    mom "Meu Deus, [emm]! Isso parece mais com os beijos que você me dava quando era pequena do que com a maneira como você deveria beijar um menino!"

# game/scripts/c16/c16.rpy:169
translate brazilian c16s001_EmmaLessons_40d572cc:

    # mc "Bueno, para eso estamos aquí, ¿no? ¿Por qué no le explicas lo que ha hecho mal? Tú tenías mejor visión."
    mc "Bem, é para isso que estamos aqui, não é? Por que você não explica a ele o que ele fez de errado? Você tem uma visão melhor."

# game/scripts/c16/c16.rpy:171
translate brazilian c16s001_EmmaLessons_ac3ca6e7:

    # "[mar] se enzarza en una serie de explicaciones sobre cómo poner los labios, qué hacer con la boca, cuál debe ser la actitud..."
    "[mar] inicia uma série de explicações sobre como posicionar os lábios, o que fazer com a boca, qual deve ser a atitude..."

# game/scripts/c16/c16.rpy:172
translate brazilian c16s001_EmmaLessons_f88ddcc2:

    # mom "... y ahora me voy a poner aquí. Desde el sofá no he tenido una buena visión. Aquí podré ver qué haces mal."
    mom "...e agora vou ficar aqui. Não tenho tido uma boa visão do sofá. Daqui poderei ver o que você está fazendo de errado."

# game/scripts/c16/c16.rpy:174
translate brazilian c16s001_EmmaLessons_e1ad5def:

    # "Se vuelve a repetir la secuencia y [emm] vuelve besarte mal. Aún no sabes a qué está jugando."
    "A sequência se repete e [emm] te beija mal de novo. Você ainda não sabe que jogo ele está jogando."

# game/scripts/c16/c16.rpy:175
translate brazilian c16s001_EmmaLessons_bf56ebf6:

    # emm "¿Mejor ahora?"
    emm "Melhor agora?"

# game/scripts/c16/c16.rpy:177
translate brazilian c16s001_EmmaLessons_8b799d1a:

    # mc "Algo mejor... ¿no?"
    mc "Algo melhor... não é?"

# game/scripts/c16/c16.rpy:178
translate brazilian c16s001_EmmaLessons_3933e3b7:

    # mom "Si, algo mejor, pero va a necesitar mucha práctica. A esto me refería con que no podía besar a su chico así."
    mom "Sim, está melhor, mas ela vai precisar de muita prática. Era isso que eu queria dizer quando falei que ela não podia beijar o namorado daquele jeito."

# game/scripts/c16/c16.rpy:180
translate brazilian c16s001_EmmaLessons_42bb600f:

    # emm "¿Y si lo besas tú para que yo pueda verlo?"
    emm "E se você o beijasse para que eu pudesse ver?"

# game/scripts/c16/c16.rpy:181
translate brazilian c16s001_EmmaLessons_0cf81bd1:

    # mcp "(Así que es a eso a lo que estaba jugando, ¿no? [mar.mc!t] no se puede estar tragando eso, ¿verdad?)"
    mcp "(Então era isso que ele estava tramando, né? [mar.mc!t] Você não vai cair nessa, vai?)"

# game/scripts/c16/c16.rpy:183
translate brazilian c16s001_EmmaLessons_cf65c388:

    # mom "{b}¿Estás loca?{/b} ¿Cómo voy a besarlo? ¡Es mi hijo!"
    mom "{b}Você está louco?{/b}Como é que eu vou beijá-lo? Ele é meu filho!"

# game/scripts/c16/c16.rpy:185
translate brazilian c16s001_EmmaLessons_51527562:

    # mcp "(A ver cómo le explicas mañana que no lo soy y que te has negado a besarme con una excusa falsa.)"
    mcp "(Vamos ver como você vai explicar para ela amanhã que eu não sou ela e que você se recusou a me beijar com uma desculpa esfarrapada.)"

# game/scripts/c16/c16.rpy:186
translate brazilian c16s001_EmmaLessons_af1887fa:

    # mcp "(Además, como si eso te importara mucho. *Risa mental*)"
    mcp "(Além disso, como se você se importasse muito. *Risos mentais*)"

# game/scripts/c16/c16.rpy:188
translate brazilian c16s001_EmmaLessons_bf028e3d:

    # mcp "(Como si eso te importara mucho. *Risa mental*)"
    mcp "(Como se você se importasse muito. *Risos mentais*)"

# game/scripts/c16/c16.rpy:190
translate brazilian c16s001_EmmaLessons_e71d4ac2:

    # emm "Porfi, porfi, porfi..."
    emm "Por favor, por favor, por favor..."

# game/scripts/c16/c16.rpy:191
translate brazilian c16s001_EmmaLessons_143a6549:

    # mc "[emm], si le incomoda hacerlo, no la fuerces. Tiene que ser complicado para ella..."
    mc "Se ela não se sentir à vontade para fazer isso, não a force. Deve ser difícil para ela..."

# game/scripts/c16/c16.rpy:193
translate brazilian c16s001_EmmaLessons_b735fe07:

    # mom "No es que me incomode o que sea complicado... es que viendo cómo te beso no va a aprender más que viendo un beso en una película."
    mom "Não é que me deixe desconfortável ou que seja complicado... é só que me ver te beijando não vai ensinar a ele mais do que ver um beijo em um filme."

# game/scripts/c16/c16.rpy:194
translate brazilian c16s001_EmmaLessons_f9b26ebc:

    # mc "En eso tienes razón."
    mc "Você tem razão quanto a isso."

# game/scripts/c16/c16.rpy:196
translate brazilian c16s001_EmmaLessons_78f70c88:

    # emm "¿Creéis que me fijo en cómo se besan en una película? No es que me haya interesado nunca... son actores..."
    emm "Você acha que eu presto atenção em como eles se beijam em um filme? Não é como se eu alguma vez tivesse tido interesse... eles são atores..."

# game/scripts/c16/c16.rpy:197
translate brazilian c16s001_EmmaLessons_d4210aa1:

    # emm "Porfi, Mamá... ahora me fijaré bien en cómo lo haces tú..."
    emm "Por favor, mãe... agora vou prestar bastante atenção em como você faz isso..."

# game/scripts/c16/c16.rpy:199
translate brazilian c16s001_EmmaLessons_7a402623:

    # mom "¿No te importa?"
    mom "Você não se importa?"

# game/scripts/c16/c16.rpy:200
translate brazilian c16s001_EmmaLessons_e67d343d:

    # mc "No, no me importa, Mamá. Si es por enseñar a [emm]..."
    mc "Não, mãe, não me importo. Se for para ensinar [emm]..."

# game/scripts/c16/c16.rpy:201
translate brazilian c16s001_EmmaLessons_be8c7606:

    # mcp "(Si descubre que ya es una experta besando... besándome... nos va a matar a los dos.)"
    mcp "(Se ela descobrir que já é especialista em beijar... em me beijar... ela vai nos matar.)"

# game/scripts/c16/c16.rpy:203
translate brazilian c16s001_EmmaLessons_3dcf73b4:

    # mom "Observa bien, [emm]. No lo vamos a repetir."
    mom "Observe com atenção, [emm]. Não vamos repetir isso."

# game/scripts/c16/c16.rpy:204
translate brazilian c16s001_EmmaLessons_85bee377:

    # emm "Entonces necesitaré que sea un beso largo, para poder verlo desde todos los ángulos."
    emm "Então, preciso que seja um beijo longo, para que eu possa vê-lo de todos os ângulos."

# game/scripts/c16/c16.rpy:206
translate brazilian c16s001_EmmaLessons_a3b9535d:

    # "El beso con [mar] empieza con cierta timidez, pero va ganando en pasión tal como pasan los segundos y [emm] va dando vueltas alrededor vuestro como si estuviera tomando notas."
    "O beijo com [mar] começa um tanto tímido, mas ganha paixão à medida que os segundos passam e [emm] circula ao seu redor como se estivesse tomando notas."

# game/scripts/c16/c16.rpy:207
translate brazilian c16s001_EmmaLessons_caee7d60:

    # mom "*Susurrando* ¡Ufff! ¡Cómo echaba de menos esto! Me has puesto cachonda con un solo beso..."
    mom "*Sussurrando* Ah! Como eu senti falta disso! Você me excitou com apenas um beijo..."

# game/scripts/c16/c16.rpy:208
translate brazilian c16s001_EmmaLessons_b96d3726:

    # mc "*Susurrando* Tú a mí también."
    mc "*Sussurrando* Você também."

# game/scripts/c16/c16.rpy:211
translate brazilian c16s001_EmmaLessons_da4159dd:

    # "Después de eso se pasan la noche jugando al ajedrez. Sí, ajedrez para tres. Cosas más ridículas se han visto, como un gato en con el logo del desarrollador."
    "Depois disso, eles passam a noite jogando xadrez. Sim, xadrez para três. Coisas ainda mais ridículas já aconteceram, como um gato com o logotipo da desenvolvedora."

# game/scripts/c16/c16.rpy:212
translate brazilian c16s001_EmmaLessons_a1700e9d:

    # mcp "(Yo no recuerdo esto así, creo que hicimos algo diferente. Seguro que si pregunto en Discord alguien me lo recuerda. Me estoy cansando de jugar tanto al ajedrez.)"
    mcp "(Não me lembro assim; acho que fizemos algo diferente. Tenho certeza de que se eu perguntar no Discord alguém vai me lembrar. Estou ficando cansado de jogar tanto xadrez.)"

# game/scripts/c16/c16.rpy:215
translate brazilian c16s001_EmmaLessons_da108a7d:

    # emm "Mamá, tienes que ser una fiera besando. Fíjate cómo se ha puesto [mc] con un solo beso."
    emm "Mãe, você deve beijar muito bem. Olha só como ele ficou excitado com apenas um beijo."

# game/scripts/c16/c16.rpy:216
translate brazilian c16s001_EmmaLessons_1c5cd16e:

    # mc "Besa muy bien, no podrías tener una mejor maestra."
    mc "Ela beija muito bem, você não poderia ter uma professora melhor."

# game/scripts/c16/c16.rpy:217
translate brazilian c16s001_EmmaLessons_46831f12:

    # mom "¡No mires! Aunque eso es lo que les pasa a los chicos cuando se les besa bien."
    mom "Não olhe! Embora seja isso que acontece com os meninos quando recebem um bom beijo."

# game/scripts/c16/c16.rpy:218
translate brazilian c16s001_EmmaLessons_fcc3c740:

    # mc "Ya la ha visto..."
    mc "Ela já viu..."

# game/scripts/c16/c16.rpy:219
translate brazilian c16s001_EmmaLessons_51753740:

    # mom "Bueno, sí, pero no tiene por qué recrearse mirando."
    mom "Sim, mas você não precisa ficar muito tempo olhando."

# game/scripts/c16/c16.rpy:221
translate brazilian c16s001_EmmaLessons_3ccd497a:

    # emm "¡Ahora creo que lo haré mejor! Ya he visto cómo lo hacías y creo que ya sé lo que yo hacía mal."
    emm "Agora acho que vou me sair melhor! Vi como você fez e acho que sei o que estava fazendo de errado."

# game/scripts/c16/c16.rpy:222
translate brazilian c16s001_EmmaLessons_25d9fd46:

    # mc "[emm], mis ojos están aquí..."
    mc "[emm], meus olhos estão aqui..."

# game/scripts/c16/c16.rpy:224
translate brazilian c16s001_EmmaLessons_c4dc53e3:

    # emm "Perdón... ¿probamos?"
    emm "Com licença... vamos tentar?"

# game/scripts/c16/c16.rpy:225
translate brazilian c16s001_EmmaLessons_de4d03e5:

    # mc "Perfecto."
    mc "Perfeito."

# game/scripts/c16/c16.rpy:228
translate brazilian c16s001_EmmaLessons_4373f18b:

    # "El beso de [emm] es mucho mejor que los anteriores, pero muy lejos de sus besos habituales o de cómo te ha besado [mar]."
    "O beijo de [emm] é muito melhor que os anteriores, mas está longe de ser como os beijos dele costumam ser ou como [mar] te beijou."

# game/scripts/c16/c16.rpy:230
translate brazilian c16s001_EmmaLessons_b4d6c9f6:

    # "El beso de [emm] es mucho mejor que los anteriores, demostrándole a [mar] que ha aprendido la lección. Una lección que no necesitaba."
    "O beijo de [emm] é muito melhor que os anteriores, mostrando a [mar] que ele aprendeu a lição. Uma lição que ele não precisava."

# game/scripts/c16/c16.rpy:231
translate brazilian c16s001_EmmaLessons_fbc288bd:

    # emm "¡Ahora sí que ha ido bien! Ya he entendido qué hacía mal. Gracias, Mamá."
    emm "É isso aí! Finalmente entendi o que estava fazendo de errado. Obrigada, mãe."

# game/scripts/c16/c16.rpy:232
translate brazilian c16s001_EmmaLessons_1841e041:

    # mc "Mucho mejor, desde luego."
    mc "Muito melhor, é claro."

# game/scripts/c16/c16.rpy:235
translate brazilian c16s001_EmmaLessons_33baaf8c:

    # mom "Ha estado mucho mejor, pero han faltado cosas. Desde aquí parecía que no movías tu lengua dentro de la boca de [mc]. ¿Me equivoco?"
    mom "Tem sido muito melhor, mas ainda falta alguma coisa. Daqui, parece que você não está movendo a língua dentro da boca de [mc]. Estou enganado?"

# game/scripts/c16/c16.rpy:236
translate brazilian c16s001_EmmaLessons_b58eb69c:

    # mc "Bueno, la ha dejado bastante quieta..."
    mc "Bem, isso a deixou bastante imóvel..."

# game/scripts/c16/c16.rpy:238
translate brazilian c16s001_EmmaLessons_24e55400:

    # mom "A eso es a lo que me refiero, tiene que aprender ella. No puede hacerlo mal con su chico ni esperar que sea él quien lleve la iniciativa."
    mom "É isso que eu quero dizer, ela precisa aprender. Ela não pode estragar as coisas com o namorado nem esperar que ele tome a iniciativa."

# game/scripts/c16/c16.rpy:240
translate brazilian c16s001_EmmaLessons_87c2898e:

    # emm "En vuestro beso no podía ver qué hacíais con la lengua. Y en los dibujos japoneses tienen la lengua fuera de la boca cuando se besan, pero vosotros lo habéis hecho diferente."
    emm "Não consegui ver o que vocês estavam fazendo com as línguas durante o beijo. Nos desenhos animados japoneses, eles costumam colocar a língua para fora da boca quando se beijam, mas vocês fizeram diferente."

# game/scripts/c16/c16.rpy:242
translate brazilian c16s001_EmmaLessons_fd4a5a9d:

    # emm "Se me ocurre una idea... ¿por qué no me enseñas tú lo que tengo que hacer con la lengua, Mamá?"
    emm "Já sei... por que você não me ensina o que fazer com a minha língua, mãe?"

# game/scripts/c16/c16.rpy:244
translate brazilian c16s001_EmmaLessons_11a7d59a:

    # mom "{b}¿Qué?{/b} ¿Quieres que {b}yo{/b} te enseñe a besar?"
    mom "{b}O quê?{/b} Você quer que eu te ensine a beijar?"

# game/scripts/c16/c16.rpy:246
translate brazilian c16s001_EmmaLessons_61451ff1:

    # emm "Así sabría lo que tiene que hacer una chica. [mc] me podría enseñar sólo a besar como un chico..."
    emm "Assim eu saberia o que uma garota deve fazer. Ela poderia me ensinar como beijar como um garoto..."

# game/scripts/c16/c16.rpy:247
translate brazilian c16s001_EmmaLessons_1753a486:

    # mcp "(Cada vez es más difícil contenerse la risa. Creo que desde que sabe que [mar.mc!t] y yo estamos juntos ha estado buscando algo así.)"
    mcp "(Está cada vez mais difícil conter o riso. Acho que desde que descobriu que eu e [mar.mc!t] estamos juntos, ele tem procurado algo assim.)"

# game/scripts/c16/c16.rpy:248
translate brazilian c16s001_EmmaLessons_67ff2bbd:

    # mc "Aunque no creyera que iba a decir esto nunca, la lógica de [emm] es correcta en este caso. *Risa*"
    mc "Embora eu nunca tenha pensado que diria isso, a lógica de [emm] está correta neste caso. *Risos*"

# game/scripts/c16/c16.rpy:250
translate brazilian c16s001_EmmaLessons_028c5c97:

    # mom "Tienes razón. Por una vez la lógica de [emm] no tiene fallos."
    mom "Você tem razão. Desta vez, a lógica de [emm] é impecável."

# game/scripts/c16/c16.rpy:252
translate brazilian c16s001_EmmaLessons_bb706933:

    # emm "¡Mamaaaa!"
    emm "Mãe!"

# game/scripts/c16/c16.rpy:254
translate brazilian c16s001_EmmaLessons_c087c4da:

    # mom "Sé que me voy a arrepentir de esto, pero ven aquí."
    mom "Eu sei que vou me arrepender disso, mas venha aqui."

# game/scripts/c16/c16.rpy:255
translate brazilian c16s001_EmmaLessons_dfa5602a:

    # mom "Sigue los movimientos que haga yo. Que tu lengua no pierda contacto con la mía. Pero no hagas nada brusco..."
    mom "Siga meus movimentos. Mantenha sua língua em contato com a minha. Mas não faça nada brusco..."

# game/scripts/c16/c16.rpy:256
translate brazilian c16s001_EmmaLessons_30aa2cf9:

    # mom "¿Te acuerdas cuando te enseñé a amasar? Pues algo así, suave pero continuo. No se me ocurre otra forma de describirlo. Mejor te lo demuestro."
    mom "Você se lembra de quando eu te ensinei a sovar massa? Bem, algo assim, delicado, mas contínuo. Não consigo pensar em outra maneira de descrever. É melhor eu te mostrar."

# game/scripts/c16/c16.rpy:258
translate brazilian c16s001_EmmaLessons_f801b914:

    # "El beso empieza como algo tierno."
    "O beijo começa de forma terna."

# game/scripts/c16/c16.rpy:260
translate brazilian c16s001_EmmaLessons_4d7ca59d:

    # "Pero parece que [emm] le va pillando el truco... aunque sabes que ya lo domina. Al final, casi te ha hecho pensar que necesitaba las clases."
    "Mas parece que [emm] está pegando o jeito... mesmo você sabendo que ele já domina a técnica. No fim, ele quase te fez pensar que precisava mesmo das aulas."

# game/scripts/c16/c16.rpy:262
translate brazilian c16s001_EmmaLessons_dd71f45a:

    # "Poco a poco va haciéndose más apasionado y las manos de ambas empiezan a explorar el cuerpo de la otra."
    "Aos poucos, a relação se torna mais intensa e ambos começam a explorar os corpos um do outro com as mãos."

# game/scripts/c16/c16.rpy:264
translate brazilian c16s001_EmmaLessons_28fc7066:

    # "Nunca hubieras imaginado que pudiera ser tan tórrido verlas gemir en la boca de la otra."
    "Você jamais imaginaria que seria tão excitante vê-los gemendo na boca um do outro."

# game/scripts/c16/c16.rpy:266
translate brazilian c16s001_EmmaLessons_ff7336c1:

    # "Aunque después de lo que pasó hace un par de días en la piscina, deberías haber aprendido como pueden ser las cosas."
    "Embora, depois do que aconteceu há alguns dias na piscina, você já devesse ter aprendido como as coisas podem ser."

# game/scripts/c16/c16.rpy:268
translate brazilian c16s001_EmmaLessons_2af27120:

    # mom "*Jadeando* Creo que ya está... ya ha aprendido lo que había que aprender..."
    mom "*Ofegante* Acho que é isso... ele aprendeu o que precisava aprender..."

# game/scripts/c16/c16.rpy:269
translate brazilian c16s001_EmmaLessons_9a44d0f1:

    # mom "Ahora que repita el beso contigo aplicando lo que hemos hecho juntas..."
    mom "Agora deixe que ela repita o beijo com você, aplicando o que fizemos juntos..."

# game/scripts/c16/c16.rpy:271
translate brazilian c16s001_EmmaLessons_9980d60b:

    # "Esta vez [emm] te besa como sabe hacerlo. Después de ver el espectáculo que ambas han dado notas como tu polla podría reventar en cualquier momento."
    "Dessa vez, [emm] te beija como só ela sabe. Depois de ver o show que vocês dois deram, notas como \"seu pau pode explodir a qualquer momento\" te deixam excitado."

# game/scripts/c16/c16.rpy:272
translate brazilian c16s001_EmmaLessons_f106d8e8:

    # "Si a eso le sumas que puedes notar el calor que emana de la entrepierna de [emm] a través de la fina tela de su pijama, y que parece que [mar] también se está poniendo cachonda..."
    "Some a isso o fato de que você consegue sentir o calor emanando da virilha de [emm] através do tecido fino do pijama dela, e que [mar] parece estar ficando excitada também..."

# game/scripts/c16/c16.rpy:274
translate brazilian c16s001_EmmaLessons_b51c3e08:

    # emm "¡Wow! Ahora lo entiendo todo. Mamá es una maestra genial. ¿Lo he hecho bien?"
    emm "Uau! Agora entendi tudo. Mamãe é uma ótima professora. Fiz certo?"

# game/scripts/c16/c16.rpy:275
translate brazilian c16s001_EmmaLessons_d34bf9b0:

    # mc "Lo has hecho genial ahora, [emm]."
    mc "Você se saiu muito bem, [emm]."

# game/scripts/c16/c16.rpy:277
translate brazilian c16s001_EmmaLessons_5335ebc1:

    # emm "¿Lo he hecho bien, Mami?"
    emm "Fiz certo, mamãe?"

# game/scripts/c16/c16.rpy:278
translate brazilian c16s001_EmmaLessons_0dd6907a:

    # mom "Sí, muy bien, cielo. Ha sido... muy bonito veros besaros..."
    mom "Sim, muito bom, querida. Foi... muito bom ver vocês se beijando..."

# game/scripts/c16/c16.rpy:279
translate brazilian c16s001_EmmaLessons_1d0b762a:

    # emm "¿Tu conejito también tiene calor, Mamá?"
    emm "Sua coelhinha também é gostosa, mãe?"

# game/scripts/c16/c16.rpy:281
translate brazilian c16s001_EmmaLessons_9c302d47:

    # mom "{b}¿Qué?{/b}"
    mom "{b}O quê?{/b}"

# game/scripts/c16/c16.rpy:283
translate brazilian c16s001_EmmaLessons_7d04d5eb:

    # emm "Hace calor en esta habitación. Después de nuestro beso he empezado a notar que mi conejito se ponía caliente y a sudar..."
    emm "Está quente neste quarto. Depois do nosso beijo, comecei a perceber que minha vagina estava ficando quente e suada..."

# game/scripts/c16/c16.rpy:284
translate brazilian c16s001_EmmaLessons_62b1af2e:

    # emm "Y ahora, con el beso con [mc]... parece que tenga fiebre..."
    emm "E agora, com o beijo com [mc]... parece que estou com febre..."

# game/scripts/c16/c16.rpy:286
translate brazilian c16s001_EmmaLessons_d289f7a3:

    # emm "Hace calor en esta habitación. Durante el beso he empezado a notar que mi conejito se ponía caliente y a sudar..."
    emm "Está quente neste quarto. Durante o beijo, comecei a perceber que minha vagina estava ficando quente e suada..."

# game/scripts/c16/c16.rpy:287
translate brazilian c16s001_EmmaLessons_3c5d4d43:

    # emm "Veo que el tuyo también está pasando calor, Mamá. Te lo estás tocando..."
    emm "Vejo que o seu também está sentindo o calor, mãe. Você está tocando nele..."

# game/scripts/c16/c16.rpy:288
translate brazilian c16s001_EmmaLessons_c6b481a3:

    # mc "*Risa* Es cierto que hace calor en esta habitación. Por eso duermo desnudo."
    mc "*Risos* É verdade que está quente neste quarto. É por isso que durmo nu."

# game/scripts/c16/c16.rpy:290
translate brazilian c16s001_EmmaLessons_32411430:

    # mom "¿Qué? ¡No!... Digo... Sí... hace calor en esta habitación... al estar debajo del tejado es la habitación más... caliente... de la casa. ¿Verdad, [mc]?"
    mom "O quê? Não!... Quer dizer... Sim... está quente neste quarto... por estar debaixo do telhado, é o quarto mais quente da casa. Certo, [mc]?"

# game/scripts/c16/c16.rpy:292
translate brazilian c16s001_EmmaLessons_c95644e4:

    # mom "¿Qué estás haciendo, [emm]?"
    mom "O que você está fazendo, [emm]?"

# game/scripts/c16/c16.rpy:294
translate brazilian c16s001_EmmaLessons_52c61de2:

    # emm "Desnudarme yo también. Ya has oído a [mc] y lo acabas de reconocer. Hace calor aquí y mi conejito está ardiendo y sudando."
    emm "Eu também vou ficar nua. Você ouviu [mc] e acabou de admitir. Está quente aqui e meu coelhinho está queimando de calor e suando."

# game/scripts/c16/c16.rpy:295
translate brazilian c16s001_EmmaLessons_7585f791:

    # mc "*Risa* No me refería a que os tuvierais que desnudar vosotras, [emm]."
    mc "*Risos* Eu não quis dizer que você tinha que ficar nu, [emm]."

# game/scripts/c16/c16.rpy:297
translate brazilian c16s001_EmmaLessons_e14db1ea:

    # emm "Y tu zanahoria también está sudando... No sabía que las zanahorias sudaran..."
    emm "E a sua cenoura também está suando... Eu não sabia que cenouras suavam..."

# game/scripts/c16/c16.rpy:298
translate brazilian c16s001_EmmaLessons_52da6ae5:

    # mc "*Risa* No es sudor, [emm]..."
    mc "*Risos* Não é suor, [emm]..."

# game/scripts/c16/c16.rpy:299
translate brazilian c16s001_EmmaLessons_bbc5f02a:

    # mcp "(Me siento ridículo explicándole cosas que sabe perfectamente, pero quiero ver a dónde quiere llegar con este juego.)"
    mcp "(Sinto-me ridícula por ter de lhe explicar coisas que ele já sabe perfeitamente bem, mas quero ver aonde ele quer chegar com este jogo.)"

# game/scripts/c16/c16.rpy:300
translate brazilian c16s001_EmmaLessons_ef929c35:

    # mc "Eso es lo que pasa cuando a un chico le besan muy bien."
    mc "É isso que acontece quando um garoto recebe um beijo realmente bom."

# game/scripts/c16/c16.rpy:302
translate brazilian c16s001_EmmaLessons_f6335312:

    # mom "*Mascullando para sí misma* Esto se me está yendo de las manos... no es lo que había pensado..."
    mom "*Resmungando para si mesma* Isto está saindo do controle... não era o que eu pensava..."

# game/scripts/c16/c16.rpy:303
translate brazilian c16s001_EmmaLessons_82450f63:

    # mom "Bueno, creo que con esto hemos llegado al final de la clase de hoy. Está claro que ya has aprendido a besar. ¡Vístete, [emm]! Nos vamos."
    mom "Bom, acho que chegamos ao fim da aula de hoje. Ficou claro que você aprendeu a beijar. Vista-se! Vamos embora."

# game/scripts/c16/c16.rpy:305
translate brazilian c16s001_EmmaLessons_876cf006:

    # emm "¿Es normal que se ponga tan duro? Parece que tienes una rampa..."
    emm "É normal ficar tão duro? Parece que você está com uma cãibra..."

# game/scripts/c16/c16.rpy:306
translate brazilian c16s001_EmmaLessons_591e6d63:

    # mc "Sí, es normal. Ya te digo que cuando a un chico le besan tan bien pasan estas cosas."
    mc "Sim, é normal. Como eu disse, quando um cara recebe um beijo tão bom assim, essas coisas acontecem."

# game/scripts/c16/c16.rpy:307
translate brazilian c16s001_EmmaLessons_1b57a296:

    # emm "Y ¿duele?"
    emm "E dói?"

# game/scripts/c16/c16.rpy:308
translate brazilian c16s001_EmmaLessons_a01c24b7:

    # mc "No, ahora mismo no, pero si se pasa así mucho tiempo sin... bueno... si se pasa así mucho tiempo, puede doler un poco, pero más bien lo que duelen los..."
    mc "Não, não agora, mas se continuar assim por muito tempo sem... bem... se continuar assim por muito tempo, pode doer um pouco, mas mais como..."

# game/scripts/c16/c16.rpy:309
translate brazilian c16s001_EmmaLessons_70b6a02a:

    # emm "¿Los champiñones?"
    emm "Cogumelos?"

# game/scripts/c16/c16.rpy:311
translate brazilian c16s001_EmmaLessons_96c51ef6:

    # mom "{b}¡[emm]!{/b} ¡Deja de tocarle la polla a tu hermano! Vamos a irnos y a dejarle... arreglarlo por él mismo..."
    mom "{b}¡[emm]!{/b} Pare de tocar no pênis do seu irmão! Vamos lá deixar que ele... resolva isso sozinho..."

# game/scripts/c16/c16.rpy:313
translate brazilian c16s001_EmmaLessons_34e7d4c9:

    # mom "*Susurrando* Lo siento..."
    mom "*Sussurrando* Me desculpe..."

# game/scripts/c16/c16.rpy:315
translate brazilian c16s001_EmmaLessons_dc63cc5c:

    # emm "Pero Mamá, no podemos irnos y dejar a su zanahoria así y que después le duelan los champiñones."
    emm "Mas mãe, não podemos simplesmente deixar a cenoura dela assim e depois os cogumelos dela ficarem machucados."

# game/scripts/c16/c16.rpy:316
translate brazilian c16s001_EmmaLessons_2a00da51:

    # emm "¿Hay algo que pueda hacer para solucionarlo? Ya que lo he provocado yo..."
    emm "Há algo que eu possa fazer para corrigir isso? Já que eu mesmo causei o problema..."

# game/scripts/c16/c16.rpy:318
translate brazilian c16s001_EmmaLessons_d6aba605:

    # mom "{b}¡[emm]! ¿Qué crees que estás haciendo?{/b}"
    mom "{b}¡[emm]! O que você pensa que está fazendo?{/b}"

# game/scripts/c16/c16.rpy:320
translate brazilian c16s001_EmmaLessons_3b43825b:

    # emm "Quizás dándole un besito..."
    emm "Talvez dando-lhe um beijinho..."

# game/scripts/c16/c16.rpy:322
translate brazilian c16s001_EmmaLessons_d3bd7231:

    # mom "{b}¡[emm]!{/b}"
    mom "{b}¡[emm]!{/b}"

# game/scripts/c16/c16.rpy:324
translate brazilian c16s001_EmmaLessons_527e31ec:

    # emm "¿Qué? Parece que le ha gustado. Ha saltado de alegría en mi mano cuando le he dado un besito... Además se está poniendo más duro aún."
    emm "O quê? Parece que ele gostou. Ele pulou de alegria na minha mão quando lhe dei um beijinho... E está ficando ainda mais excitado."

# game/scripts/c16/c16.rpy:325
translate brazilian c16s001_EmmaLessons_eb6b405d:

    # mc "*Risa* Sí, le ha gustado. Y lo de ponerse más duro es normal cuando le besa una preciosa chica desnuda."
    mc "*Risos* Sim, ele gostou. E ter uma ereção é normal quando se é beijado por uma linda garota nua."

# game/scripts/c16/c16.rpy:326
translate brazilian c16s001_EmmaLessons_33e23d0a:

    # emm "¿No podemos hacer nada para ayudarle, Mamá?"
    emm "Não há nada que possamos fazer para te ajudar, mãe?"

# game/scripts/c16/c16.rpy:328
translate brazilian c16s001_EmmaLessons_c080d8d1:

    # mom "*Susurrando* ¿Qué quieres hacer?"
    mom "*Sussurrando* O que você quer fazer?"

# game/scripts/c16/c16.rpy:329
translate brazilian c16s001_EmmaLessons_9c718281:

    # mc "*Encogiéndose de hombros* Tú misma, tú has empezado esto de las lecciones..."
    mc "*Dando de ombros* Você que começou tudo isso com as aulas..."

# game/scripts/c16/c16.rpy:330
translate brazilian c16s001_EmmaLessons_21ed3390:

    # mom "Vale, quédate donde estás... *Entre dientes* Se me ha ido totalmente de las manos..."
    mom "Certo, fique onde está... *Entre dentes cerrados* Isso saiu completamente do controle..."

# game/scripts/c16/c16.rpy:332
translate brazilian c16s001_EmmaLessons_20f24776:

    # mom "Escúchame, [emm]. Tienes que cogerle la... mira, me niego a llamarle zanahoria... tienes que cogerle la polla rodeándola con los dedos."
    mom "Escuta aqui, [emm]. Você tem que agarrar o... olha, eu me recuso a chamá-lo de cenourinha... você tem que agarrar o pênis dele envolvendo-o com os dedos."

# game/scripts/c16/c16.rpy:333
translate brazilian c16s001_EmmaLessons_7efd4c7f:

    # emm "¿Y con eso dejará de dolerle?"
    emm "E isso fará com que a dor pare?"

# game/scripts/c16/c16.rpy:334
translate brazilian c16s001_EmmaLessons_01fc610f:

    # mom "No, tienes que subir y bajar la mano, desde la base hasta la punta... creo que con eso habrá suficiente..."
    mom "Não, você tem que mover a mão para cima e para baixo, da base até a ponta... Acho que isso será suficiente..."

# game/scripts/c16/c16.rpy:337
translate brazilian c16s001_EmmaLessons_b3b63198:

    # emm "¿Así, Mamá?"
    emm "É isso mesmo, mãe?"

# game/scripts/c16/c16.rpy:338
translate brazilian c16s001_EmmaLessons_41adf945:

    # mom "Exactamente así, [emm]. [mc] te indicará si quiere que hagas más presión o no."
    mom "Exatamente assim, [emm]. [mc] irá lhe dizer se deseja que você aplique mais pressão ou não."

# game/scripts/c16/c16.rpy:339
translate brazilian c16s001_EmmaLessons_de09770b:

    # emm "¿Te gusta así, [mc]?"
    emm "Você gosta assim, [mc]?"

# game/scripts/c16/c16.rpy:340
translate brazilian c16s001_EmmaLessons_9ca085f9:

    # mc "Sí, me está gustando mucho, pero puedes hacer un poco más de presión."
    mc "Sim, estou gostando muito, mas você poderia aumentar um pouco a pressão."

# game/scripts/c16/c16.rpy:344
translate brazilian c16s001_EmmaLessons_7e8f800a:

    # emm "Mamá, ¿tu conejito te está dando calor todavía? Como has vuelto a tocártelo..."
    emm "Mãe, seu coelhinho ainda te excita? Você andou tocando nele de novo..."

# game/scripts/c16/c16.rpy:345
translate brazilian c16s001_EmmaLessons_a1bfb4c4:

    # mom "A mi conejito le gusta ver como uno de mis hijos le da placer al otro..."
    mom "Meu coelho gosta de observar um dos meus filhos dando prazer ao outro..."

# game/scripts/c16/c16.rpy:347
translate brazilian c16s001_EmmaLessons_3784aad9:

    # mcp "(Cada vez te entiendo más. Me da lo mismo que unos papeles digan que no eres mi madre y que [emm] no es mi hermana.)"
    mcp "(Eu te entendo cada vez mais. Não me importo se alguns documentos dizem que você não é minha mãe e que [emm] não é minha irmã.)"

