# game/scripts/c16/c16.rpy:1589
translate brazilian c16s002_RunWithDebbie_8e9213ec:

    # "Es como ver una niña en el cuerpo de una mujer. Una mujer enorme, pero con la ilusión de una niña."
    "É como ver uma menininha no corpo de uma mulher. Uma mulher enorme, mas com o entusiasmo de uma criança."

# game/scripts/c16/c16.rpy:1590
translate brazilian c16s002_RunWithDebbie_c046eb09:

    # mc "Ahora mismo eres como una Princesa Disseny. *Risa*"
    mc "Neste momento você é como uma princesa da Disney. *Risos*"

# game/scripts/c16/c16.rpy:1591
translate brazilian c16s002_RunWithDebbie_7d99381c:

    # deb "Solo me falta pillar un pétalo, o mejor una flor, y ponérmela en el pelo. *Risa*"
    deb "Só preciso agora de uma pétala, ou melhor ainda, de uma flor, e colocá-la no meu cabelo. *Risos*"

# game/scripts/c16/c16.rpy:1592
translate brazilian c16s002_RunWithDebbie_7408f431:

    # "Se te ocurre una idea, quizás sea un poco osada..."
    "Você teve uma ideia, talvez um pouco ousada..."

# game/scripts/c16/c16.rpy:1609
translate brazilian c16s002_RunWithDebbie_fe833cd9:

    # "Una margarita pasa volando por delante tuyo y la cazas al vuelo."
    "Uma margarida passa voando por você e você a pega no ar."

# game/scripts/c16/c16.rpy:1610
translate brazilian c16s002_RunWithDebbie_f52661d1:

    # mc "¿Una como esta?"
    mc "Uma parecida com esta?"

# game/scripts/c16/c16.rpy:1611
translate brazilian c16s002_RunWithDebbie_9e3cddaa:

    # "El remolino sigue su camino, llevándose los pétalos y las flores."
    "O redemoinho continua seu curso, levando consigo as pétalas e as flores."

# game/scripts/c16/c16.rpy:1612
translate brazilian c16s002_RunWithDebbie_4d0a4e9a:

    # deb "Exactamente como esa. Además, justo a tiempo. *Risita*"
    deb "Exatamente igual a essa. E na hora certa. *Risos*"

# game/scripts/c16/c16.rpy:1614
translate brazilian c16s002_RunWithDebbie_fad2761f:

    # mc "¿Me permites?"
    mc "Posso?"

# game/scripts/c16/c16.rpy:1615
translate brazilian c16s002_RunWithDebbie_a3f20181:

    # deb "Por supuesto... tú la has cazado... para mí... gracias..."
    deb "Claro... você a pegou... por mim... obrigada..."

# game/scripts/c16/c16.rpy:1619
translate brazilian c16s002_RunWithDebbie_bd472ab8:

    # "Una margarita pasa volando por delante suyo y Debbie la caza al vuelo."
    "Uma margarida passa voando por ela e Debbie a apanha no ar."

# game/scripts/c16/c16.rpy:1620
translate brazilian c16s002_RunWithDebbie_cf53752c:

    # mc "¿Una como esa?"
    mc "Uma dessas?"

# game/scripts/c16/c16.rpy:1621
translate brazilian c16s002_RunWithDebbie_9e3cddaa_1:

    # "El remolino sigue su camino, llevándose los pétalos y las flores."
    "O redemoinho continua seu curso, levando consigo as pétalas e as flores."

# game/scripts/c16/c16.rpy:1622
translate brazilian c16s002_RunWithDebbie_eb061492:

    # deb "Exactamente como esta. Además, justo a tiempo. *Risita*"
    deb "Exatamente assim. E na hora certa. *Risos*"

# game/scripts/c16/c16.rpy:1624
translate brazilian c16s002_RunWithDebbie_6de33996:

    # mc "Te queda muy bien. Ahora eres una auténtica Princesa Disseny."
    mc "Ficou ótimo em você. Agora você é uma verdadeira princesa da Disney."

# game/scripts/c16/c16.rpy:1625
translate brazilian c16s002_RunWithDebbie_eaa26fff:

    # deb "Aunque los pétalos ya se han ido."
    deb "Embora as pétalas já tenham murchado."

# game/scripts/c16/c16.rpy:1626
translate brazilian c16s002_RunWithDebbie_249545ca:

    # mc "Ahora solo falta que cantes y que se te pose un pajarillo en el dedo."
    mc "Agora só falta você cantar e um passarinho pousar no seu dedo."

# game/scripts/c16/c16.rpy:1628
translate brazilian c16s002_RunWithDebbie_64d45b23:

    # deb "*Risa* Mejor no, creo que habría una migración de aves en California si me pongo a cantar. En dirección contraria a mi dedo."
    deb "*Risos* Melhor não, acho que haveria uma migração de pássaros na Califórnia se eu começasse a cantar. Na direção oposta à do meu dedo."

# game/scripts/c16/c16.rpy:1629
translate brazilian c16s002_RunWithDebbie_60ecec49:

    # mc "No me lo creo. *Risa* ¿Seguimos?"
    mc "Não acredito! *Risos* Podemos continuar?"

# game/scripts/c16/c16.rpy:1630
translate brazilian c16s002_RunWithDebbie_cbe3b417:

    # deb "Sí, sigamos hasta el lago. Tengo ganas de bañarme."
    deb "Sim, vamos continuar até o lago. Estou com vontade de nadar."

# game/scripts/c16/c16.rpy:1633
translate brazilian c16s002_RunWithDebbie_a4aca7b8:

    # "El remolino de pétalos ha sido una experiencia bonita, pero ha interrumpido la conversación que estabais teniendo sobre como desconciertas a Debbie."
    "O redemoinho de pétalas foi uma experiência encantadora, mas interrompeu a conversa que vocês estavam tendo sobre como você confunde a Debbie."

# game/scripts/c16/c16.rpy:1634
translate brazilian c16s002_RunWithDebbie_8d09d5ac:

    # "Con lo tímida que es, va a ser difícil volver a hablar del tema."
    "Considerando o quão tímida ela é, vai ser difícil voltar a abordar o assunto."

# game/scripts/c16/c16.rpy:1637
translate brazilian c16s002_RunWithDebbie_6ffed3d9:

    # "Unos minutos después, en el lago, una vez os habéis cambiado de ropa cada cual en su arbusto habitual..."
    "Poucos minutos depois, no lago, depois de todos terem trocado de roupa nos arbustos de sempre..."

# game/scripts/c16/c16.rpy:1638
translate brazilian c16s002_RunWithDebbie_eb44829e:

    # mc "¿Nos bañamos?"
    mc "Vamos tomar um banho?"

# game/scripts/c16/c16.rpy:1640
translate brazilian c16s002_RunWithDebbie_c4f8f570:

    # deb "Dame un segundo. Quiero guardar la flor."
    deb "Só um segundo. Quero ficar com a flor."

# game/scripts/c16/c16.rpy:1642
translate brazilian c16s002_RunWithDebbie_d1a22536:

    # deb "Ya está. Así se secará y durará por siempre."
    deb "Pronto. Vai secar assim e durar para sempre."

# game/scripts/c16/c16.rpy:1643
translate brazilian c16s002_RunWithDebbie_1c2c2660:

    # mc "¿Llevas un libro cuando sales a correr?"
    mc "Você leva um livro consigo quando vai correr?"

# game/scripts/c16/c16.rpy:1644
translate brazilian c16s002_RunWithDebbie_9532d122:

    # deb "Estudio Literatura, [mc], y tengo que volver sola. Si encuentro un sitio bonito donde quedarme a leer..."
    deb "Estudo Literatura e preciso voltar para casa sozinha. Se eu encontrar um lugar agradável para ficar e ler..."

# game/scripts/c16/c16.rpy:1645
translate brazilian c16s002_RunWithDebbie_256ddbd9:

    # mc "Pero es una flor corriente..."
    mc "Mas é apenas uma flor comum..."

# game/scripts/c16/c16.rpy:1647
translate brazilian c16s002_RunWithDebbie_d1a83591:

    # deb "Puede que la flor sea corriente, pero la has cazado tú para mí."
    deb "A flor pode até ser comum, mas você a colheu para mim."

# game/scripts/c16/c16.rpy:1648
translate brazilian c16s002_RunWithDebbie_42039d98:

    # deb "Verla me recordará siempre el remolino de pétalos y como me pusiste la flor en el pelo."
    deb "Ver isso sempre me lembrará do redemoinho de pétalas e de como você colocou a flor no meu cabelo."

# game/scripts/c16/c16.rpy:1649
translate brazilian c16s002_RunWithDebbie_c8be821b:

    # mc "Eso es muy bonito, Debbie."
    mc "Que bom, Debbie."

# game/scripts/c16/c16.rpy:1650
translate brazilian c16s002_RunWithDebbie_df90d381:

    # deb "¡Vamos!"
    deb "Vamos!"

# game/scripts/c16/c16.rpy:1652
translate brazilian c16s002_RunWithDebbie_da61d265:

    # deb "¡No te quedes atrás! *Risa* ¡Sólo tenemos media hora!"
    deb "Não fiquem para trás! *Risos* Só temos meia hora!"

# game/scripts/c16/c16.rpy:1653
translate brazilian c16s002_RunWithDebbie_d365fdd4:

    # "Otra vez aparece la niña adorable para sustituir a la tímida mujer."
    "Mais uma vez, a adorável garotinha surge para substituir a mulher tímida."

# game/scripts/c16/c16.rpy:1659
translate brazilian c16s002_RunWithDebbie_ca53953c:

    # deb "El agua está a la temperatura perfecta hoy. Ni muy fría ni muy caliente. Y es tan transparente..."
    deb "A água está na temperatura perfeita hoje. Nem muito fria, nem muito quente. E está tão cristalina..."

# game/scripts/c16/c16.rpy:1660
translate brazilian c16s002_RunWithDebbie_36959404:

    # mc "Este lago siempre ha estado muy limpio. Casi nadie sube aquí nunca y los arroyos que lo alimentan bajan muy limpios."
    mc "Este lago sempre foi muito limpo. Quase ninguém vem aqui, e os riachos que o alimentam são muito limpos."

# game/scripts/c16/c16.rpy:1661
translate brazilian c16s002_RunWithDebbie_3bde6d15:

    # mc "Solo está turbio los días después de llover. La lluvia arrastra barro de las laderas, pero en un par de días vuelve a estar transparente."
    mc "O céu só fica nublado nos dias seguintes à chuva. A chuva carrega lama pelas encostas, mas o tempo volta a abrir em alguns dias."

# game/scripts/c16/c16.rpy:1663
translate brazilian c16s002_RunWithDebbie_fbb39a25:

    # deb "Eso me da una idea... ¿has jugado alguna vez a buscar tesoros en este lago? Lisa y yo jugábamos en la playa."
    deb "Isso me deu uma ideia... você já brincou de caça ao tesouro nesse lago? Eu e a Lisa costumávamos brincar na praia."

# game/scripts/c16/c16.rpy:1664
translate brazilian c16s002_RunWithDebbie_1abcb75d:

    # mc "¿Buscar tesoros? No creo que haya nada interesante..."
    mc "Caça ao tesouro? Não acho que haja nada de interessante nisso..."

# game/scripts/c16/c16.rpy:1666
translate brazilian c16s002_RunWithDebbie_9a61adeb:

    # deb "Bueno, no consiste en encontrar doblones españoles. *Risa*"
    deb "Bem, não se trata de encontrar dobrões espanhóis. *Risos*"

# game/scripts/c16/c16.rpy:1667
translate brazilian c16s002_RunWithDebbie_fa3f1b3d:

    # deb "Consiste en hacer una inmersión buscando cosas en el fondo. El que consiga encontrar la cosa más bonita, valiosa, o rara, gana la ronda."
    deb "Consiste em mergulhar e procurar objetos no fundo do mar. Quem encontrar o item mais bonito, valioso ou incomum vence a rodada."

# game/scripts/c16/c16.rpy:1668
translate brazilian c16s002_RunWithDebbie_109fa44c:

    # mc "Suena interesante. Nunca he buscado nada aquí. ¡Hagámoslo!"
    mc "Isso parece interessante. Nunca pesquisei nada aqui antes. Vamos lá!"

# game/scripts/c16/c16.rpy:1669
translate brazilian c16s002_RunWithDebbie_71f6139d:

    # mc "Pero ¿hay premio para el que gane?"
    mc "Mas haverá algum prêmio para o vencedor?"

# game/scripts/c16/c16.rpy:1671
translate brazilian c16s002_RunWithDebbie_46b767c6:

    # deb "Nunca he jugado por un premio. Siempre he jugado por diversión..."
    deb "Nunca joguei por um prêmio. Sempre joguei por diversão..."

# game/scripts/c16/c16.rpy:1672
translate brazilian c16s002_RunWithDebbie_162e597b:

    # mc "Si estuviera Kate aquí seguro que decía que el que pierde paga prenda. *Risa*"
    mc "Se Kate estivesse aqui, com certeza diria que quem perde paga a prenda. *Risos*"

# game/scripts/c16/c16.rpy:1675
translate brazilian c16s002_RunWithDebbie_91782b6a:

    # deb "Pero no lo vamos a hacer, ¿verdad? ¿Qué te parece un beso?"
    deb "Mas não vamos fazer isso, né? Que tal um beijo?"

# game/scripts/c16/c16.rpy:1676
translate brazilian c16s002_RunWithDebbie_094adc07:

    # mc "¿Cómo funcionaría? Un beso es mutuo..."
    mc "Como funcionaria? Um beijo é mútuo..."

# game/scripts/c16/c16.rpy:1677
translate brazilian c16s002_RunWithDebbie_fe902c79:

    # deb "Si tú encuentras el mejor tesoro, te beso yo... si lo encuentro yo, me besas tú..."
    deb "Se você encontrar o maior tesouro, eu te beijo... se eu o encontrar, você me beija..."

# game/scripts/c16/c16.rpy:1678
translate brazilian c16s002_RunWithDebbie_3fb014b0:

    # mc "Es decir, que habrá beso después de cada ronda, ¿no?"
    mc "Então, vai ter um beijo depois de cada rodada, certo?"

# game/scripts/c16/c16.rpy:1680
translate brazilian c16s002_RunWithDebbie_9dea28d6:

    # deb "A menos que haya empate... *Risita*"
    deb "A menos que haja um empate... *Risos*"

# game/scripts/c16/c16.rpy:1681
translate brazilian c16s002_RunWithDebbie_62d84d6b:

    # mc "*Risa* A menos que haya empate."
    mc "*Risos* A menos que haja um empate."

# game/scripts/c16/c16.rpy:1692
translate brazilian c16s002_RunWithDebbie_ffa16180:

    # mc "No sé si me apetece ganar o perder. Pero seguro que no quiero empatar."
    mc "Não sei se quero ganhar ou perder. Mas definitivamente não quero um empate."

# game/scripts/c16/c16.rpy:1694
translate brazilian c16s002_RunWithDebbie_aeed3e2c:

    # deb "Te aseguro que estoy en la misma situación. *Risita*"
    deb "Garanto que estou na mesma situação. *Risos*"

# game/scripts/c16/c16.rpy:1695
translate brazilian c16s002_RunWithDebbie_141e4de2:

    # mc "¿Empezamos a jugar? Al mejor de tres."
    mc "Vamos começar a jogar? Melhor de três."

# game/scripts/c16/c16.rpy:1697
translate brazilian c16s002_RunWithDebbie_132350b6:

    # mcp "(Me duele hacerte esto, Debbie, pero no puedo dejar que te ilusiones viendo cosas donde no las hay.)"
    mcp "(Dói-me fazer isto com você, Debbie, mas não posso deixar que você crie expectativas ao ver coisas que não existem.)"

# game/scripts/c16/c16.rpy:1698
translate brazilian c16s002_RunWithDebbie_6c54ff70:

    # mc "No me malinterpretes, me gustas, pero creo que esto podría llevar a algo que no deberíamos hacer."
    mc "Não me entenda mal, eu gosto de você, mas acho que isso pode levar a algo que não deveríamos fazer."

# game/scripts/c16/c16.rpy:1699
translate brazilian c16s002_RunWithDebbie_5d4ff3ad:

    # mc "Me gustas, pero no de ese modo, Debbie, lo siento."
    mc "Eu gosto de você, mas não desse jeito, Debbie, me desculpe."

# game/scripts/c16/c16.rpy:1701
translate brazilian c16s002_RunWithDebbie_852ea924:

    # deb "Pero... pero... creo que... tú también me has malinterpretado..."
    deb "Mas... mas... acho que... você também me entendeu mal..."

# game/scripts/c16/c16.rpy:1702
translate brazilian c16s002_RunWithDebbie_31a33386:

    # deb "No es que... quiera salir contigo... No. Nada de eso... es solo que... besarte es divertido..."
    deb "Não é que... eu queira sair com você... Não. Nada disso... é só que... te beijar é divertido..."

# game/scripts/c16/c16.rpy:1703
translate brazilian c16s002_RunWithDebbie_95009036:

    # mc "¿Te parece bien si dejamos los besos sólo como buenos días y buenas noches?"
    mc "Seria aceitável se usássemos apenas beijos para bom dia e boa noite?"

# game/scripts/c16/c16.rpy:1705
translate brazilian c16s002_RunWithDebbie_d9fbc30c:

    # deb "Ermmm... sí, vale. Así evitaremos... malentendidos..."
    deb "Hum... sim, tudo bem. Assim evitaremos... mal-entendidos..."

# game/scripts/c16/c16.rpy:1706
translate brazilian c16s002_RunWithDebbie_173875ba:

    # deb "Podríamos jugar por... no sé... El que gane menos rondas le paga una cerveza al otro."
    deb "Poderíamos jogar por... sei lá... Quem ganhar menos rodadas paga uma cerveja para o outro."

# game/scripts/c16/c16.rpy:1707
translate brazilian c16s002_RunWithDebbie_a8f158c9:

    # mc "Me parece genial. Al mejor de tres ¿Empezamos a jugar?"
    mc "Parece ótimo para mim. Melhor de três. Vamos começar a jogar?"

# game/scripts/c16/c16.rpy:1709
translate brazilian c16s002_RunWithDebbie_cf7b1fe4:

    # deb "Pero no lo vamos a hacer, ¿verdad? ¿Qué te parece una cerveza? El que gane menos rondas le paga una cerveza al otro."
    deb "Mas não vamos fazer isso, né? Que tal uma cerveja? Quem ganhar menos rodadas paga uma cerveja para o outro."

# game/scripts/c16/c16.rpy:1710
translate brazilian c16s002_RunWithDebbie_1eb54c01:

    # mc "Me parece genial. ¿Empezamos a jugar? Al mejor de tres."
    mc "Ótimo. Vamos começar a jogar? Melhor de três."

# game/scripts/c16/c16.rpy:1712
translate brazilian c16s002_RunWithDebbie_e6504547:

    # "Te sumerges y buscas por el fondo del lago y solo encuentras una piedra con una forma especial antes de que tus pulmones empiecen a pedirte aire."
    "Você mergulha e vasculha o fundo do lago, encontrando apenas uma pedra com um formato peculiar antes que seus pulmões comecem a implorar por ar."

# game/scripts/c16/c16.rpy:1714
translate brazilian c16s002_RunWithDebbie_00e450f8:

    # "Cuando sacas la cabeza del agua Debbie todavía está sumergida. Como dijo Kim, es como una sirenita. ¿O lo dijiste tú?"
    "Quando você tira a cabeça da água, Debbie ainda está submersa. Como disse Kim, ela é como uma pequena sereia. Ou foi você que disse isso?"

# game/scripts/c16/c16.rpy:1717
translate brazilian c16s002_RunWithDebbie_551d07df:

    # "Aparece de pronto, como surgida de la nada, esparciendo agua a su alrededor."
    "Aparece de repente, como se viesse do nada, espalhando água por toda parte."

# game/scripts/c16/c16.rpy:1719
translate brazilian c16s002_RunWithDebbie_367bc4c2:

    # deb "¿Qué has encontrado? Tenías razón sobre que estaba muy limpio, es difícil encontrar nada."
    deb "O que você encontrou? Você tinha razão, estava muito limpo; é difícil encontrar qualquer coisa."

# game/scripts/c16/c16.rpy:1720
translate brazilian c16s002_RunWithDebbie_cf8f509f:

    # mc "¿Lo enseñamos a la vez?"
    mc "Devemos ensinar isso ao mesmo tempo?"

# game/scripts/c16/c16.rpy:1721
translate brazilian c16s002_RunWithDebbie_0a73a9e8:

    # deb "¡Venga!"
    deb "Vamos!"

# game/scripts/c16/c16.rpy:1723
translate brazilian c16s002_RunWithDebbie_17307285:

    # deb "Una taza oxidada. *Risa*" (multiple=2)
    deb "Uma xícara enferrujada. *Risos*" (multiple=2)

# game/scripts/c16/c16.rpy:1724
translate brazilian c16s002_RunWithDebbie_8a9a7840:

    # mc "Una piedra. *Risa* Pero tiene una forma especial." (multiple=2)
    mc "Uma pedra. *Risos* Mas tem um formato especial." (multiple=2)

# game/scripts/c16/c16.rpy:1725
translate brazilian c16s002_RunWithDebbie_2432bdfb:

    # mc "Mal empezamos si lo primero que encuentras es una lata. Te acabo de hacer publicidad de que el lago estaba muy limpio. *Risa*"
    mc "Começamos com o pé esquerdo se a primeira coisa que você encontra é uma lata. Acabei de te dar publicidade gratuita sobre como o lago estava limpo. *Risos*"

# game/scripts/c16/c16.rpy:1726
translate brazilian c16s002_RunWithDebbie_d60d007a:

    # deb "¿Has encontrado una piedra que parece un corazón? Está claro que esta ronda la ganas tú. 1-0."
    deb "Você encontrou uma pedra que parece um coração? Você claramente ganhou esta rodada. 1 a 0."

# game/scripts/c16/c16.rpy:1729
translate brazilian c16s002_RunWithDebbie_19fe362f:

    # deb "Es el momento de que te pague, ¿no?"
    deb "Já está na hora de eu te pagar, não é?"

# game/scripts/c16/c16.rpy:1730
translate brazilian c16s002_RunWithDebbie_10ad818e:

    # mc "Por supuesto. ¡Quiero mi pago!"
    mc "Claro. Quero meu pagamento!"

# game/scripts/c16/c16.rpy:1732
translate brazilian c16s002_RunWithDebbie_f3be97b8:

    # "El beso de Debbie es muy tierno, como todas las veces que te ha besado hasta ahora. Pero hay algo más, una seguridad que no habías notado anteriormente."
    "O beijo de Debbie é muito terno, como todas as vezes que ela te beijou até agora. Mas há algo mais, uma certeza que você não tinha notado antes."

# game/scripts/c16/c16.rpy:1733
translate brazilian c16s002_RunWithDebbie_b0ac62f5:

    # mcp "(Aceptar besos como pago la ha hecho sentirse más segura de sí misma. Es una buena señal.)"
    mcp "(Aceitar beijos como pagamento a fez se sentir mais confiante. Isso é um bom sinal.)"

# game/scripts/c16/c16.rpy:1734
translate brazilian c16s002_RunWithDebbie_01fc50f9:

    # "El beso acaba abruptamente, como si a Debbie se le hubiera ocurrido una idea de repente."
    "O beijo termina abruptamente, como se Debbie tivesse tido uma ideia repentina."

# game/scripts/c16/c16.rpy:1736
translate brazilian c16s002_RunWithDebbie_f6a02aa0:

    # deb "¿Puedo pedirte un favor?"
    deb "Posso te pedir um favor?"

# game/scripts/c16/c16.rpy:1737
translate brazilian c16s002_RunWithDebbie_bb3703fb:

    # mc "Lo que quieras."
    mc "O que você quiser."

# game/scripts/c16/c16.rpy:1738
translate brazilian c16s002_RunWithDebbie_4bf2bb0b:

    # deb "¿Me regalas la Piedra Corazón?"
    deb "Você me dará a Pedra do Coração?"

# game/scripts/c16/c16.rpy:1739
translate brazilian c16s002_RunWithDebbie_ffcffc62:

    # mc "Lo que quieras menos eso. No puedo, Debbie, es muy valiosa."
    mc "Qualquer coisa, menos isso. Não posso, Debbie, é precioso demais."

# game/scripts/c16/c16.rpy:1741
translate brazilian c16s002_RunWithDebbie_41d447f7:

    # deb "Pero si solo es una piedra..."
    deb "Mas é apenas uma pedra..."

# game/scripts/c16/c16.rpy:1742
translate brazilian c16s002_RunWithDebbie_14218cf8:

    # mc "Pero encontrarla me ha hecho ganar un beso de una chica preciosa. Tiene que ser una piedra increíble."
    mc "Mas encontrá-la me rendeu um beijo de uma garota linda. Deve ser uma pedra incrível."

# game/scripts/c16/c16.rpy:1743
translate brazilian c16s002_RunWithDebbie_1116f50c:

    # mc "Te la podría vender... por otro beso..."
    mc "Eu poderia te vender isso... em troca de outro beijo..."

# game/scripts/c16/c16.rpy:1745
translate brazilian c16s002_RunWithDebbie_f10217f9:

    # deb "No puedo aceptar. *Risita* Si es tan valiosa... sentiría que te estoy timando."
    deb "Não posso aceitar. *Risos* Se é tão valioso assim... eu me sentiria como se estivesse te enganando."

# game/scripts/c16/c16.rpy:1746
translate brazilian c16s002_RunWithDebbie_5390541b:

    # mc "Mmmmm... ¿qué propones, entonces?"
    mc "Hum... então, o que você propõe?"

# game/scripts/c16/c16.rpy:1747
translate brazilian c16s002_RunWithDebbie_23da9877:

    # deb "¿Qué te parecería un pago a plazos?"
    deb "Que tal pagar em parcelas?"

# game/scripts/c16/c16.rpy:1748
translate brazilian c16s002_RunWithDebbie_1fddbcd6:

    # mc "¿Cómo funcionaría eso? ¿Tengo que llamar a mi abogado?"
    mc "Como isso funcionaria? Preciso ligar para meu advogado?"

# game/scripts/c16/c16.rpy:1749
translate brazilian c16s002_RunWithDebbie_78bf1ad8:

    # deb "Un beso ahora y puedes venir a por más cuando quieras. *Risita*"
    deb "Um beijo agora, e você pode voltar para mais quando quiser. *Risos*"

# game/scripts/c16/c16.rpy:1750
translate brazilian c16s002_RunWithDebbie_ffa967c3:

    # mc "Me parece un trato que no voy a poder rechazar. Creo que podemos dejar a los abogados en sus despachos."
    mc "Parece um acordo irrecusável. Acho que podemos deixar os advogados em seus escritórios."

# game/scripts/c16/c16.rpy:1751
translate brazilian c16s002_RunWithDebbie_cece6ae1:

    # deb "Pues aquí va el primer pago..."
    deb "Bem, aqui está o primeiro pagamento..."

# game/scripts/c16/c16.rpy:1753
translate brazilian c16s002_RunWithDebbie_7e613c72:

    # mcp "(Cada vez es más segura besando, también más ansiosa. Demostrarle que yo también quiero estos besos lo está cambiando todo para ella.)"
    mcp "(Ela está ficando mais confiante nos beijos e também mais ansiosa. Mostrar a ela que eu também quero esses beijos está mudando tudo para ela.)"

# game/scripts/c16/c16.rpy:1755
translate brazilian c16s002_RunWithDebbie_8223a4a9:

    # deb "¡Wow! Lo de dejarme sin aliento, ¿es alguna táctica para que tenga menos tiempo para buscar algo en la siguiente ronda?"
    deb "Uau! Isso me deixou sem fôlego, será que é alguma tática para dificultar minha busca na próxima rodada?"

# game/scripts/c16/c16.rpy:1756
translate brazilian c16s002_RunWithDebbie_803e5147:

    # mc "El premio es tan sabroso que tengo que utilizar todos los trucos sucios a mi alcance. *Risa*"
    mc "O prêmio é tão tentador que preciso usar todos os truques sujos à minha disposição. *Risos*"

# game/scripts/c16/c16.rpy:1758
translate brazilian c16s002_RunWithDebbie_1605d854:

    # deb "Dame un segundo que voy a guardar mi Piedra Corazón en la mochila. No quiero perderla."
    deb "Só um segundo, vou guardar minha Pedra do Coração na mochila. Não quero perdê-la."

# game/scripts/c16/c16.rpy:1759
translate brazilian c16s002_RunWithDebbie_fd80f95e:

    # mc "Es tuya, mientras sigas pagando los plazos. *Risa*"
    mc "É seu, contanto que você continue fazendo os pagamentos. *Risos*"

# game/scripts/c16/c16.rpy:1761
translate brazilian c16s002_RunWithDebbie_2c5ffd05:

    # mc "¿Segunda ronda?"
    mc "Segunda rodada?"

# game/scripts/c16/c16.rpy:1762
translate brazilian c16s002_RunWithDebbie_90599b34:

    # deb "Vamos. Esta vez tengo que encontrar algo que te supere o habrás ganado la partida."
    deb "Vamos lá. Desta vez, preciso encontrar algo que te supere, ou você terá vencido o jogo."

# game/scripts/c16/c16.rpy:1765
translate brazilian c16s002_RunWithDebbie_98ee6541:

    # "Debbie ha dejado su taza al lado de su mochila. Ya la recogeréis cuando acabe la partida."
    "Debbie deixou a caneca dela ao lado da mochila. Você pode pegá-la quando o jogo terminar."

# game/scripts/c16/c16.rpy:1767
translate brazilian c16s002_RunWithDebbie_ad0afd56:

    # "Lanzáis la taza y la piedra fuera del lago, ya las recogeréis cuando acabe la partida."
    "Jogue o copo e a pedra para fora do lago; você poderá pegá-los quando o jogo terminar."

# game/scripts/c16/c16.rpy:1768
translate brazilian c16s002_RunWithDebbie_babc9790:

    # "Os volvéis a sumergir y a rebuscar en el fondo del lago. No está tan limpio cómo creías, con varias botellas y latas repartidas por el fondo."
    "Você mergulha de volta e começa a vasculhar o fundo do lago. Não está tão limpo quanto você pensava, com várias garrafas e latas espalhadas pelo fundo."

# game/scripts/c16/c16.rpy:1769
translate brazilian c16s002_RunWithDebbie_bf7d7de6:

    # "Supones que algún excursionista las dejaría en el bosque y serían arrastradas por la lluvia."
    "Você presume que algum excursionista os deixaria na floresta e que eles seriam levados pela chuva."

# game/scripts/c16/c16.rpy:1770
translate brazilian c16s002_RunWithDebbie_0fa77e3f:

    # "Los pulmones no aguantan más antes de que tengas que salir con una lata en la mano."
    "Seus pulmões não aguentam mais, então você precisa sair com uma lata na mão."

# game/scripts/c16/c16.rpy:1772
translate brazilian c16s002_RunWithDebbie_c1b31f4b:

    # deb "Creía que tendría que ir a buscarte... *Risa* O que te habías ahogado."
    deb "Pensei que teria que vir te procurar... *Risos* Ou que você tivesse se afogado."

# game/scripts/c16/c16.rpy:1773
translate brazilian c16s002_RunWithDebbie_a59c4a00:

    # mc "No había piedras bonitas esta vez. *Risa* ¿Qué has encontrado?"
    mc "Dessa vez não havia nenhuma pedra bonita. *Risos* O que você encontrou?"

# game/scripts/c16/c16.rpy:1775
translate brazilian c16s002_RunWithDebbie_72418e04:

    # deb "*Risa* ¡Una lata!" (multiple=2)
    deb "*Risos* Que saco!" (multiple=2)

# game/scripts/c16/c16.rpy:1776
translate brazilian c16s002_RunWithDebbie_a210ffc7:

    # mc "*Risa* ¡Una lata esta vez!" (multiple=2)
    mc "*Risos* Dessa vez é uma lata!" (multiple=2)

# game/scripts/c16/c16.rpy:1777
translate brazilian c16s002_RunWithDebbie_44136401:

    # deb "*Risa*" (multiple=2)
    deb "*Risada*" (multiple=2)

# game/scripts/c16/c16.rpy:1778
translate brazilian c16s002_RunWithDebbie_192941cc:

    # mc "*Risa*" (multiple=2)
    mc "*Risada*" (multiple=2)

# game/scripts/c16/c16.rpy:1779
translate brazilian c16s002_RunWithDebbie_121154f5:

    # deb "Eso significa empate, ¿no?"
    deb "Isso significa empate, certo?"

# game/scripts/c16/c16.rpy:1781
translate brazilian c16s002_RunWithDebbie_211c3725:

    # mc "Bueno, creo que tu lata está en bastante mejor estado que la mía, aún tiene la anilla, con lo que yo te daría por ganadora de esta ronda."
    mc "Bem, acho que sua lata está em muito melhor estado que a minha; ela ainda tem o anel, então eu diria que você ganhou esta rodada."

# game/scripts/c16/c16.rpy:1783
translate brazilian c16s002_RunWithDebbie_81a031c1:

    # mc "Además, con un empate me quedo sin beso y tendría que empezar a cobrar los de la Piedra Corazón. *Risa*"
    mc "Além disso, com uma gravata eu perderia o beijo e teria que começar a coletar as recompensas da Pedra do Coração. *Risos*"

# game/scripts/c16/c16.rpy:1784
translate brazilian c16s002_RunWithDebbie_85bb4ef9:

    # deb "¿Prefieres perder tú a quedarte con el empate? *Risita*"
    deb "Você prefere perder a empatar? *Risos*"

# game/scripts/c16/c16.rpy:1785
translate brazilian c16s002_RunWithDebbie_45f32f86:

    # mc "Es imposible que besarte signifique perder, Debbie."
    mc "É impossível que te beijar signifique perder, Debbie."

# game/scripts/c16/c16.rpy:1787
translate brazilian c16s002_RunWithDebbie_39ac7a8d:

    # deb "¡Ufff! ¿Sabes que me podría acostumbrar a oír esas cosas?"
    deb "Puxa! Sabe que eu poderia me acostumar a ouvir essas coisas?"

# game/scripts/c16/c16.rpy:1788
translate brazilian c16s002_RunWithDebbie_e46b3b1b:

    # mc "Y yo me podría acostumbrar a decírtelas. Y ahora tengo que pagar."
    mc "E eu poderia me acostumar a te contar. E agora tenho que pagar."

# game/scripts/c16/c16.rpy:1790
translate brazilian c16s002_RunWithDebbie_665ce14d:

    # mcp "(Veamos qué pasa si ponemos un poco de lengua en el beso)"
    mcp "(Vamos ver o que acontece se adicionarmos um pouco de língua ao beijo)"

# game/scripts/c16/c16.rpy:1791
translate brazilian c16s002_RunWithDebbie_c6fc8e3a:

    # deb "*Jadeo de sorpresa*"
    deb "*Suspiro de surpresa*"

# game/scripts/c16/c16.rpy:1793
translate brazilian c16s002_RunWithDebbie_1d4bae82:

    # "Después de la sorpresa inicial, Debbie entiende lo que tiene que hacer y, sorprendentemente, su lengua sigue la tuya con mucha agilidad."
    "Após o choque inicial, Debbie entende o que precisa fazer e, surpreendentemente, sua língua segue a sua com grande agilidade."

# game/scripts/c16/c16.rpy:1794
translate brazilian c16s002_RunWithDebbie_3772e5de:

    # "Poco a poco el beso va subiendo la velocidad y la pasión."
    "Aos poucos, o beijo aumenta em velocidade e paixão."

# game/scripts/c16/c16.rpy:1796
translate brazilian c16s002_RunWithDebbie_b74e41b9:

    # deb "¡Ufff! Eso ha sido alucinante. Y otra vez me falta la respiración."
    deb "Uau! Isso foi incrível. E estou sem fôlego de novo."

# game/scripts/c16/c16.rpy:1797
translate brazilian c16s002_RunWithDebbie_856169ff:

    # mc "Ha sido nuestro primer beso... \"de verdad\". Si quieres vendrán más."
    mc "Foi nosso primeiro beijo... \"de verdade\". Se você quiser, haverá mais."

# game/scripts/c16/c16.rpy:1799
translate brazilian c16s002_RunWithDebbie_d4cf42d5:

    # deb "¿Si quiero? ¿Puedo elegir?"
    deb "Eu quero? Posso escolher?"

# game/scripts/c16/c16.rpy:1800
translate brazilian c16s002_RunWithDebbie_52fa6308:

    # deb "Los besos de antes me ponían la carne de gallina. Este ha convertido mis piernas de gelatina."
    deb "Os beijos dele costumavam me arrepiar. Este me deixou com as pernas bambas."

# game/scripts/c16/c16.rpy:1801
translate brazilian c16s002_RunWithDebbie_58ea3556:

    # mc "¿Y cuáles prefieres?"
    mc "E quais você prefere?"

# game/scripts/c16/c16.rpy:1803
translate brazilian c16s002_RunWithDebbie_9826a326:

    # deb "¿Por qué no ambos? Creo que debe haber uno para cada circunstancia, ¿no?"
    deb "Por que não ambos? Acho que deveria haver um para cada circunstância, não acha?"

# game/scripts/c16/c16.rpy:1804
translate brazilian c16s002_RunWithDebbie_2ea22504:

    # mc "Bien pensado. ¿Última ronda?"
    mc "Boa ideia. Última rodada?"

# game/scripts/c16/c16.rpy:1806
translate brazilian c16s002_RunWithDebbie_cfeec243:

    # deb "Me parece bien, eso nos deja la última ronda para decidir quién gana."
    deb "Parece-me ótimo, o que nos deixa com a última rodada para decidir quem vence."

# game/scripts/c16/c16.rpy:1807
translate brazilian c16s002_RunWithDebbie_e3fe8334:

    # mc "¿Vamos a por ella?"
    mc "Vamos em frente?"

# game/scripts/c16/c16.rpy:1809
translate brazilian c16s002_RunWithDebbie_df90d381_1:

    # deb "¡Vamos!"
    deb "Vamos!"

# game/scripts/c16/c16.rpy:1811
translate brazilian c16s002_RunWithDebbie_e9427085:

    # "Te diriges a la otra orilla antes de sumergirte. No queda nada interesante donde has estado buscando hasta ahora."
    "Você se dirige para o outro lado antes de mergulhar. Não há mais nada de interessante onde você estava procurando até agora."

# game/scripts/c16/c16.rpy:1813
translate brazilian c16s002_RunWithDebbie_d538ca1f:

    # "Sigues buscando por el fondo del lago sin ver nada que te llame la atención. Puedes ver que Debbie está en la misma situación a través de la cristalina agua del lago."
    "Você continua vasculhando o fundo do lago sem encontrar nada que lhe chame a atenção. Através da água cristalina, você percebe que Debbie está na mesma situação."

# game/scripts/c16/c16.rpy:1815
translate brazilian c16s002_RunWithDebbie_ae246103:

    # "Encuentras una piedra redondeada y pulida. No es la Piedra Corazón, pero es mejor que otra lata. Subes a la superficie antes de quedarte sin aire."
    "Você encontra uma pedra arredondada e polida. Não é a Pedra do Coração, mas é melhor do que outra lata. Você emerge antes de ficar sem ar."

# game/scripts/c16/c16.rpy:1817
translate brazilian c16s002_RunWithDebbie_7dfa881d:

    # "Debbie ya está allí, esperándote con las manos en la espalda. Mala señal para tu sencilla piedra."
    "Debbie já está lá, esperando por você com as mãos para trás. Mau presságio para sua simples pedra."

# game/scripts/c16/c16.rpy:1818
translate brazilian c16s002_RunWithDebbie_dcd369fa:

    # deb "¿Qué has encontrado esta vez?"
    deb "O que você descobriu desta vez?"

# game/scripts/c16/c16.rpy:1819
translate brazilian c16s002_RunWithDebbie_731e088c:

    # mc "Vamos a mostrarlo a la vez. Esta ronda designa el ganador."
    mc "Vamos mostrar todos de uma vez. Esta rodada determina o vencedor."

# game/scripts/c16/c16.rpy:1822
translate brazilian c16s002_RunWithDebbie_054be045:

    # mc "Otra piedra. Pero más simple."
    mc "Outra pedra. Mas mais simples."

# game/scripts/c16/c16.rpy:1824
translate brazilian c16s002_RunWithDebbie_88b1c9b8:

    # mc "¿Debbie? ¿Qué has encontrado?"
    mc "Débbie? O que você descobriu?"

# game/scripts/c16/c16.rpy:1826
translate brazilian c16s002_RunWithDebbie_3ebc731d:

    # deb "Esto. Y no voy a aceptar que me digas que no he ganado la ronda."
    deb "Isso. E não vou aceitar que você me diga que eu não ganhei a rodada."

# game/scripts/c16/c16.rpy:1828
translate brazilian c16s002_RunWithDebbie_91db9549:

    # deb "A ti."
    deb "Para você."

# game/scripts/c16/c16.rpy:1829
translate brazilian c16s002_RunWithDebbie_40cd3e84:

    # mc "¡Wow, Debbie! Me siento super halagado ahora mismo..."
    mc "Nossa, Debbie! Estou me sentindo super lisonjeada agora..."

# game/scripts/c16/c16.rpy:1831
translate brazilian c16s002_RunWithDebbie_c3f76876:

    # deb "¿Pero...?"
    deb "Mas...?"

# game/scripts/c16/c16.rpy:1832
translate brazilian c16s002_RunWithDebbie_2e5bbd4b:

    # mc "¿Qué? ¡No! No hay ningún pero. Me ha sorprendido como lo has dicho."
    mc "O quê? Não! Não tem \"mas\". Fiquei surpreso com a forma como você disse isso."

# game/scripts/c16/c16.rpy:1834
translate brazilian c16s002_RunWithDebbie_c693eb11:

    # deb "¿Puedo serte sincera?"
    deb "Posso ser sincero com você?"

# game/scripts/c16/c16.rpy:1835
translate brazilian c16s002_RunWithDebbie_28927394:

    # mc "Siempre."
    mc "Sempre."

# game/scripts/c16/c16.rpy:1836
translate brazilian c16s002_RunWithDebbie_d613aede:

    # deb "No sé qué está pasando."
    deb "Não sei o que está acontecendo."

# game/scripts/c16/c16.rpy:1837
translate brazilian c16s002_RunWithDebbie_cdb26d12:

    # deb "Me gustas. Mucho. Y me gusta que nos besemos. Pero no sé qué somos... o si somos algo. No hemos hablado de nada. Tan solo hemos empezado a besarnos como..."
    deb "Eu gosto de você. Muito. E gosto que a gente se beije. Mas não sei o que somos... ou se somos alguma coisa. Não conversamos sobre nada. Simplesmente começamos a nos beijar assim..."

# game/scripts/c16/c16.rpy:1838
translate brazilian c16s002_RunWithDebbie_9b2e2259:

    # mc "¿Como si fuera lo más natural del mundo?"
    mc "Como se fosse a coisa mais natural do mundo?"

# game/scripts/c16/c16.rpy:1840
translate brazilian c16s002_RunWithDebbie_4d6167ff:

    # deb "Exacto. No sé cómo funciona esto. No sé si tenemos que decidir... o decir si eres mi novio o no. O si solo soy una amiga con derecho a besos. No sé nada..."
    deb "Exatamente. Eu não sei como isso funciona. Não sei se temos que decidir... ou dizer se você é meu namorado ou não. Ou se sou apenas uma amiga com benefícios. Eu não sei de nada..."

# game/scripts/c16/c16.rpy:1841
translate brazilian c16s002_RunWithDebbie_4ca09d7e:

    # mc "No hace falta decir o decidir nada. Tú también me gustas mucho..."
    mc "Não precisa dizer nem decidir nada. Eu também gosto muito de você..."

# game/scripts/c16/c16.rpy:1843
translate brazilian c16s002_RunWithDebbie_a65a904f:

    # mc "Pero ya sabes que hay alguien más."
    mc "Mas você sabe que existe outra pessoa."

# game/scripts/c16/c16.rpy:1846
translate brazilian c16s002_RunWithDebbie_734ecb73:

    # deb "Sí, [dap]. Y no sé si está bien que le haga esto."
    deb "Sim, [dap]. E eu não sei se é certo eu fazer isso com ela."

# game/scripts/c16/c16.rpy:1847
translate brazilian c16s002_RunWithDebbie_8363c8f2:

    # mc "No le estás haciendo nada. Ella sabe, y acepta, que puedo salir con otras chicas."
    mc "Você não está fazendo nada com ela. Ela sabe, e aceita, que eu posso sair com outras garotas."

# game/scripts/c16/c16.rpy:1849
translate brazilian c16s002_RunWithDebbie_6a551e30:

    # deb "Eso me sorprende aún más. Saliendo con alguien quieres pasar tiempo conmigo... besarme... y..."
    deb "Isso me surpreende ainda mais. Quando você está namorando alguém, você quer passar tempo comigo... me beijar... e..."

# game/scripts/c16/c16.rpy:1851
translate brazilian c16s002_RunWithDebbie_91bea49b:

    # mc "Y ya te he dicho que no salgo con nadie ahora mismo."
    mc "E eu já te disse que não estou namorando ninguém no momento."

# game/scripts/c16/c16.rpy:1853
translate brazilian c16s002_RunWithDebbie_68e1c7e0:

    # deb "Eso me desconcierta aún más. Pudiendo salir con quien quisieras, quieres pasar tiempo conmigo... besarme... y..."
    deb "Isso me confunde ainda mais. Quando você poderia sair com quem quisesse, você quer passar um tempo comigo... me beijar... e..."

# game/scripts/c16/c16.rpy:1854
translate brazilian c16s002_RunWithDebbie_4b5eee26:

    # mc "De momento dejémoslo ahí. No sigas con ese \"y\"."
    mc "Vamos parar por aqui por enquanto. Não continue com esse \"e\"."

# game/scripts/c16/c16.rpy:1855
translate brazilian c16s002_RunWithDebbie_232e9a3b:

    # mc "Me gusta pasar tiempo contigo. Me gusta besarte. Y el día que quieras, continuaremos con ese \"y\", pero no ahora."
    mc "Gosto de passar tempo com você. Gosto de te beijar. E no dia em que você quiser, continuaremos com esse \"e\", mas não agora."

# game/scripts/c16/c16.rpy:1857
translate brazilian c16s002_RunWithDebbie_f4045637:

    # deb "¿Me estás diciendo que soy tu novia? ¿O una amiga con derecho a roce como era Saira? ¿O alguien con quien pasar el rato si no hay otra chica disponible?"
    deb "Você está me dizendo que sou sua namorada? Ou uma amiga com benefícios como a Saira era? Ou alguém para sair se não houver outra garota disponível?"

# game/scripts/c16/c16.rpy:1858
translate brazilian c16s002_RunWithDebbie_8ff2a5d7:

    # mc "No me gustan las etiquetas, pero desde luego no eres con quien pasar el rato. Ahora soy yo el que tiene una pregunta."
    mc "Eu não gosto de rótulos, mas você definitivamente não é alguém com quem eu sairia. Agora é a minha vez de fazer uma pergunta."

# game/scripts/c16/c16.rpy:1859
translate brazilian c16s002_RunWithDebbie_0430a13b:

    # mc "¿Qué quieres que seamos?"
    mc "O que vocês querem que sejamos?"

# game/scripts/c16/c16.rpy:1861
translate brazilian c16s002_RunWithDebbie_87b8442e:

    # deb "¿Qué? ¿Tengo que decidirlo yo?"
    deb "O quê? Eu que tenho que decidir?"

# game/scripts/c16/c16.rpy:1862
translate brazilian c16s002_RunWithDebbie_d4eb9317:

    # mc "Tú tienes que decidir qué quieres que seamos. Lo que tú quieres es algo que no puedo decidir yo."
    mc "Você precisa decidir o que quer que sejamos. O que você quer é algo que eu não posso decidir."

# game/scripts/c16/c16.rpy:1865
translate brazilian c16s002_RunWithDebbie_5788175d:

    # deb "No tengo ni idea... hace un rato, cuando me has puesto la flor en el pelo, te hubiera dicho que preferiría ser tu novia. Y no nos habíamos besado... de verdad."
    deb "Não faço ideia... há pouco tempo, quando você colocou a flor no meu cabelo, eu teria dito que preferia ser sua namorada. E nós nem tínhamos nos beijado... de verdade."

# game/scripts/c16/c16.rpy:1867
translate brazilian c16s002_RunWithDebbie_b7243ee3:

    # deb "No tengo ni idea... hace un rato, cuando hemos salido de casa, te hubiera dicho que preferiría ser tu novia. Y no nos habíamos besado... de verdad."
    deb "Não faço ideia... há pouco tempo, quando saímos de casa, eu teria te dito que preferia ser sua namorada. E a gente nem tinha se beijado... de verdade."

# game/scripts/c16/c16.rpy:1868
translate brazilian c16s002_RunWithDebbie_481ca0c6:

    # deb "Pero creo que tienes razón. Quizás sea pronto para poner etiquetas todavía, ¿no?"
    deb "Mas acho que você tem razão. Talvez seja cedo demais para rotular as coisas, não é?"

# game/scripts/c16/c16.rpy:1869
translate brazilian c16s002_RunWithDebbie_468c4f51:

    # mc "Me parece bien. Cuando lo tengamos más claro, podemos poner las etiquetas que queramos, o inventarnos una que sólo nos defina a nosotros."
    mc "Isso me parece ótimo. Assim que tivermos uma compreensão mais clara, podemos adicionar os rótulos que quisermos, ou até mesmo inventar um que nos defina por completo."

# game/scripts/c16/c16.rpy:1871
translate brazilian c16s002_RunWithDebbie_d1a81114:

    # deb "Pero lo que no te voy a perdonar es mi premio... si quieres dármelo."
    deb "Mas o que eu não vou te perdoar é o meu prêmio... se você quiser me dar."

# game/scripts/c16/c16.rpy:1872
translate brazilian c16s002_RunWithDebbie_e975a156:

    # mc "Un Marks siempre paga sus deudas. *Risa*"
    mc "Um Marks sempre paga suas dívidas. *Risos*"

# game/scripts/c16/c16.rpy:1874
translate brazilian c16s002_RunWithDebbie_92fa167f:

    # "Esta vez el beso tiene una pasión desatada que no ha tenido ninguno de los anteriores."
    "Desta vez, o beijo tem uma paixão desenfreada, diferente de todos os anteriores."

# game/scripts/c16/c16.rpy:1875
translate brazilian c16s002_RunWithDebbie_2878decc:

    # "Tienes que luchar con tus manos para que no empiecen a recorrer el cuerpo de Debbie, empezar a seguir los picos y valles de su musculatura."
    "Você precisa lutar com as mãos para impedi-las de percorrer todo o corpo de Debbie, de seguir os altos e baixos de sua musculatura."

# game/scripts/c16/c16.rpy:1877
translate brazilian c16s002_RunWithDebbie_3fe21357:

    # deb "¡Ufff! Me ha costado tener las manos quietas, [mc]."
    deb "Ufa! Foi difícil manter as mãos paradas, [mc]."

# game/scripts/c16/c16.rpy:1878
translate brazilian c16s002_RunWithDebbie_0f34832b:

    # mc "A mí me ha pasado lo mismo. Pero puedes usarlas si quieres."
    mc "A mesma coisa aconteceu comigo. Mas você pode usá-los se quiser."

# game/scripts/c16/c16.rpy:1879
translate brazilian c16s002_RunWithDebbie_05619fae:

    # deb "Pero me has dicho que no continuara con el \"y\"..."
    deb "Mas você me disse para não continuar com o \"e\"..."

# game/scripts/c16/c16.rpy:1880
translate brazilian c16s002_RunWithDebbie_4619879d:

    # mc "¿Te referías a eso? ¡Oops! Te malentendí, culpa mía."
    mc "Era isso mesmo que você queria dizer? Ops! Eu entendi errado, foi mal."

# game/scripts/c16/c16.rpy:1882
translate brazilian c16s002_RunWithDebbie_5fcce661:

    # deb "¿Qué habías entendido?"
    deb "O que você entendeu?"

# game/scripts/c16/c16.rpy:1883
translate brazilian c16s002_RunWithDebbie_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c16/c16.rpy:1885
translate brazilian c16s002_RunWithDebbie_82f12fab:

    # deb "¡Oh! ¡No! ¡Qué idiota soy! Para ti unos besos están más que superados... tú ya estabas pensando en... eso..."
    deb "Oh! Não! Que idiota eu sou! Para você, uns beijinhos são coisa do passado... você já estava pensando... nisso..."

# game/scripts/c16/c16.rpy:1886
translate brazilian c16s002_RunWithDebbie_61254abf:

    # mc "No, Debbie, no estaba pensando en \"eso\". Hay muchos pasos intermedios entre los besos y \"eso\". Y quiero que los demos juntos."
    mc "Não, Debbie, eu não estava pensando \"nisso\". Há muitos passos entre o beijo e \"aquilo\". E eu quero que os percorramos juntos."

# game/scripts/c16/c16.rpy:1888
translate brazilian c16s002_RunWithDebbie_dea11191:

    # deb "Ahora mismo te debo parecer una niña tonta para la que unos besos son un tesoro..."
    deb "Neste momento, devo parecer uma garotinha boba para você, para quem beijos são um tesouro..."

# game/scripts/c16/c16.rpy:1889
translate brazilian c16s002_RunWithDebbie_23d69cc1:

    # mc "Para nada, cielo. Tus besos son un tesoro, y cada paso que demos hacia \"eso\" lo será también, pero los daremos cuando llegue el momento y cuando estés cómoda con ello."
    mc "De jeito nenhum, querida. Seus beijos são um tesouro, e cada passo que dermos em direção a \"isso\" também será, mas daremos esses passos quando for a hora certa e quando você se sentir confortável com isso."

# game/scripts/c16/c16.rpy:1890
translate brazilian c16s002_RunWithDebbie_ce942098:

    # eva "¡Ejem!"
    eva "Hum!"

# game/scripts/c16/c16.rpy:1892
translate brazilian c16s002_RunWithDebbie_c15a5fa7:

    # deb "¡Oh, [dap]! ¡Esto no es lo que parece!"
    deb "Oh, [dap]! Não é o que parece!"

# game/scripts/c16/c16.rpy:1895
translate brazilian c16s002_RunWithDebbie_3e391e5b:

    # deb "Una herradura." (multiple=2)
    deb "Uma ferradura." (multiple=2)

# game/scripts/c16/c16.rpy:1896
translate brazilian c16s002_RunWithDebbie_b370d95f:

    # mc "Otra piedra. Pero más simple." (multiple=2)
    mc "Outra pedra. Mas mais simples." (multiple=2)

# game/scripts/c16/c16.rpy:1898
translate brazilian c16s002_RunWithDebbie_bdaf2039:

    # deb "¡Sí! Definitivamente esta vez he ganado yo."
    deb "Sim! Desta vez eu definitivamente ganhei."

# game/scripts/c16/c16.rpy:1899
translate brazilian c16s002_RunWithDebbie_d9a7bd9f:

    # mc "Desde luego. Esa herradura debe llevar décadas ahí. Te debo una cerveza."
    mc "Com certeza. Essa ferradura deve estar aí há décadas. Te devo uma cerveja."

# game/scripts/c16/c16.rpy:1901
translate brazilian c16s002_RunWithDebbie_2abce8fc:

    # deb "Un día que vayamos a la ciudad me la pagas. Ahora me debería ir yendo a secar y a vestir. Quiero llegar a casa y ducharme."
    deb "Você me pagará quando formos à cidade. Devo ir me secar e me vestir agora. Quero chegar em casa e tomar um banho."

# game/scripts/c16/c16.rpy:1902
translate brazilian c16s002_RunWithDebbie_0622f1f0:

    # mc "Perfecto. En unos minutos llegará mi cita."
    mc "Perfeito. Meu encontro chegará em alguns minutos."

# game/scripts/c16/c16.rpy:1903
translate brazilian c16s002_RunWithDebbie_ce942098_1:

    # eva "¡Ejem!"
    eva "Hum!"

# game/scripts/c16/c16.rpy:1905
translate brazilian c16s002_RunWithDebbie_88cf3c99:

    # deb "¡Oh, [dap]! ¿Qué haces aquí?"
    deb "Oh, [dap]! O que você está fazendo aqui?"

# game/scripts/c16/c16.rpy:1906
translate brazilian c16s002_RunWithDebbie_4dd47fcf:

    # mc "Hola, Eva. No es [dap], Debbie. Ven, os presento. Tengo que explicarte algo."
    mc "Oi, Eva. Não sou a Debbie. Venha, deixe-me apresentá-la. Preciso explicar uma coisa para você."

# game/scripts/c16/c16.rpy:1908
translate brazilian c16s002_RunWithDebbie_eadd3d25:

    # "Después de las presentaciones y de que Debbie se cambie, Eva os deja un poco de espacio para que puedas tener La Conversación con Debbie."
    "Após as apresentações e depois de Debbie se trocar, Eva lhe dá um pouco de espaço para que vocês possam ter A Conversa com Debbie."

# game/scripts/c16/c16.rpy:1910
translate brazilian c16s002_RunWithDebbie_53102d3d:

    # deb "Es alucinante. Si no tuviera a Eva delante de mis ojos, te diría que me estás tomando el pelo."
    deb "É incrível. Se eu não tivesse a Eva na minha frente, diria que você estava me zoando."

# game/scripts/c16/c16.rpy:1912
translate brazilian c16s002_RunWithDebbie_e01241f3:

    # deb "Solo pensar que es un clon de [dap]... o de [eri]... No me lo puedo creer..."
    deb "Só de pensar que é um clone de [dap]... ou [eri]... não consigo acreditar..."

# game/scripts/c16/c16.rpy:1914
translate brazilian c16s002_RunWithDebbie_3a789ddf:

    # deb "Solo pensar que [dap] y [eri] son clones suyos... No me lo puedo creer..."
    deb "Só de pensar que [dap] e [eri] são clones dele... Não consigo acreditar..."

# game/scripts/c16/c16.rpy:1915
translate brazilian c16s002_RunWithDebbie_c137c561:

    # deb "No podía imaginar que estas cosas pasaran..."
    deb "Eu não conseguia imaginar que essas coisas acontecessem..."

# game/scripts/c16/c16.rpy:1916
translate brazilian c16s002_RunWithDebbie_295f3a58:

    # mc "Hoy os lo iban a contar [mar] y [nor], después de contárselo a [emm], [eri], y [dap]."
    mc "Hoje [mar] e [nor] iriam te contar, depois de contarem [emm], [eri] e [dap]."

# game/scripts/c16/c16.rpy:1917
translate brazilian c16s002_RunWithDebbie_2a51cfb7:

    # mc "Como has venido a correr conmigo no han tenido la oportunidad de hacerlo contigo."
    mc "Desde que você veio correr comigo, eles não tiveram a oportunidade de fazer isso com você."

# game/scripts/c16/c16.rpy:1919
translate brazilian c16s002_RunWithDebbie_69165295:

    # deb "Gracias por confiar en nosotras con un secreto tan grande."
    deb "Obrigado por confiar em nós com um segredo tão importante."

# game/scripts/c16/c16.rpy:1920
translate brazilian c16s002_RunWithDebbie_cd5cb341:

    # mc "No creo que vayáis a hacer nada que perjudique a las chicas, y de todas formas, Eva va a venir a comer hoy a casa, con lo que lo descubriríais igualmente."
    mc "Não acho que você vá fazer nada para prejudicar as meninas, e de qualquer forma, a Eva vem almoçar aqui hoje, então você descobriria de qualquer jeito."

# game/scripts/c16/c16.rpy:1921
translate brazilian c16s002_RunWithDebbie_0c4ef9b4:

    # deb "Nunca haría nada que pudiera hacer daño a [emm], [eri], o [dap]. Lisa tampoco. Y pondría la mano en el fuego por el resto."
    deb "Eu jamais faria algo que pudesse prejudicar [emm], [eri] ou [dap]. Lisa também não. E eu garanto pelo resto."

# game/scripts/c16/c16.rpy:1922
translate brazilian c16s002_RunWithDebbie_169c7bc9:

    # deb "Pero ahora os voy a dejar con vuestras cosas. Voy a volver a casa para ver si puedo ayudar en algo."
    deb "Mas agora vou deixar você com suas coisas. Vou voltar para casa para ver se posso ajudar em alguma coisa."

# game/scripts/c16/c16.rpy:1925
translate brazilian c16s002_RunWithDebbie_dd4a2c67:

    # "Es un beso tierno, no sensual. Es un beso que dice \"te veré luego y continuaremos\"."
    "É um beijo terno, não sensual. É um beijo que diz: \"Te vejo mais tarde e continuamos.\""

# game/scripts/c16/c16.rpy:1926
translate brazilian c16s002_RunWithDebbie_64cdd974:

    # deb "Hasta luego, guapo. Recuerda que me llevo la Piedra Corazón y que puedes cobrar tus besos cuando quieras."
    deb "Até mais, lindo. Lembre-se que estou pegando a Pedra do Coração e você pode coletar seus beijos quando quiser."

# game/scripts/c16/c16.rpy:1927
translate brazilian c16s002_RunWithDebbie_0f5727bc:

    # mc "Hasta luego, preciosa. Lo haré."
    mc "Até logo, linda. Pode deixar."

# game/scripts/c16/c16.rpy:1929
translate brazilian c16s002_RunWithDebbie_1f1f5279:

    # deb "Hasta luego, [mc]."
    deb "Até logo, [mc]."

# game/scripts/c16/c16.rpy:1930
translate brazilian c16s002_RunWithDebbie_d207ca37:

    # mc "Nos vemos en casa, Debbie."
    mc "Te vejo em casa, Debbie."

# game/scripts/c16/c16.rpy:1932
translate brazilian c16s002_RunWithDebbie_1d8c41b7:

    # deb "Hasta dentro de un rato, Eva."
    deb "Até daqui a pouco, Eva."

# game/scripts/c16/c16.rpy:1934
translate brazilian c16s002_RunWithDebbie_71b77468:

    # eva "Te veo en casa, Debbie."
    eva "Te vejo em casa, Debbie."

# game/scripts/c16/c16.rpy:2043
translate brazilian c16s003_ShootingLessons_7d9e18ed:

    # eva "Llegas tarde."
    eva "Você está atrasado(a)."

# game/scripts/c16/c16.rpy:2044
translate brazilian c16s003_ShootingLessons_a93d1747:

    # mc "No, llevo aquí media hora."
    mc "Não, estou aqui há meia hora."

# game/scripts/c16/c16.rpy:2045
translate brazilian c16s003_ShootingLessons_9a5c8c45:

    # eva "36 minutos. Con lo que empezamos 6 minutos tarde."
    eva "36 minutos. Portanto, começamos com 6 minutos de atraso."

# game/scripts/c16/c16.rpy:2046
translate brazilian c16s003_ShootingLessons_eed0145f:

    # mc "¿Has estado aquí todo este tiempo? ¿Por qué no nos has avisado?"
    mc "Você esteve aqui o tempo todo? Por que não nos contou?"

# game/scripts/c16/c16.rpy:2048
translate brazilian c16s003_ShootingLessons_31789036:

    # eva "Porque habíamos quedado a las 12. Yo he venido antes para prepararlo todo. Y no quería interrumpir vuestro... juego."
    eva "Porque tínhamos combinado de nos encontrar às 12h. Cheguei mais cedo para preparar tudo. E não queria interromper o seu... jogo."

# game/scripts/c16/c16.rpy:2049
translate brazilian c16s003_ShootingLessons_c8f04224:

    # eva "Pero a las 12 eres mío. Tú pediste que te enseñara y lo voy a hacer, pero pido puntualidad."
    eva "Mas aos 12 anos você é minha. Você me pediu para te ensinar e eu vou fazer isso, mas peço pontualidade."

# game/scripts/c16/c16.rpy:2051
translate brazilian c16s003_ShootingLessons_995f1376:

    # "Cuando llegas al lago, Eva ya te está esperando, con cara de evidente enfado."
    "Ao chegar ao lago, Eva já está à sua espera, com uma expressão visivelmente irritada."

# game/scripts/c16/c16.rpy:2052
translate brazilian c16s003_ShootingLessons_7d9e18ed_1:

    # eva "Llegas tarde."
    eva "Você está atrasado(a)."

# game/scripts/c16/c16.rpy:2053
translate brazilian c16s003_ShootingLessons_8ff7e8b4:

    # mc "Lo siento, he tenido que llevar a Meemaw al médico para un chequeo."
    mc "Sinto muito, tive que levar a vovó ao médico para um exame de rotina."

# game/scripts/c16/c16.rpy:2055
translate brazilian c16s003_ShootingLessons_4950e5b3:

    # eva "¿Está bien?"
    eva "Tudo bem?"

# game/scripts/c16/c16.rpy:2056
translate brazilian c16s003_ShootingLessons_720dc198:

    # mc "Sí, era sólo un chequeo por sus enfermedades. Nada importante."
    mc "Sim, foi apenas um exame de rotina para verificar os problemas de saúde dela. Nada sério."

# game/scripts/c16/c16.rpy:2058
translate brazilian c16s003_ShootingLessons_e05a80e0:

    # eva "Con lo que empezamos 6 minutos tarde por algo que no era importante. Dijimos que a las 12 eras mío."
    eva "Então começamos com 6 minutos de atraso para algo que não era importante. Dissemos que às 12 você era minha."

# game/scripts/c16/c16.rpy:2059
translate brazilian c16s003_ShootingLessons_237c919d:

    # eva "Tú pediste que te enseñara y lo voy a hacer, pero pido puntualidad."
    eva "Você me pediu para te ensinar e eu vou ensinar, mas peço pontualidade."

# game/scripts/c16/c16.rpy:2060
translate brazilian c16s003_ShootingLessons_9cb30c09:

    # mc "De acuerdo, disculpa. No sabía que 6 minutos fueran tan importantes."
    mc "Ok, desculpe. Eu não sabia que 6 minutos eram tão importantes."

# game/scripts/c16/c16.rpy:2062
translate brazilian c16s003_ShootingLessons_77f92da9:

    # eva "Vamos a tratar con armas de verdad, [mc], todo es importante. ¿Vamos?"
    eva "Estamos lidando com armas de verdade, C4, tudo importa. Vamos lá?"

# game/scripts/c16/c16.rpy:2063
translate brazilian c16s003_ShootingLessons_a613997b:

    # mc "¿Dónde?"
    mc "Onde?"

# game/scripts/c16/c16.rpy:2064
translate brazilian c16s003_ShootingLessons_5c4d03d5:

    # eva "Ahí detrás de ese repecho. Más tranquilos que en el lago. Menos animales... y menos personas."
    eva "Ali, atrás daquela elevação. Mais tranquilo do que no lago. Menos animais... e menos pessoas."

# game/scripts/c16/c16.rpy:2065
translate brazilian c16s003_ShootingLessons_0aea45ba:

    # mc "Perfecto. Te sigo."
    mc "Perfeito. Vou te seguir."

# game/scripts/c16/c16.rpy:2078
translate brazilian c16s003_ShootingLessons_0ed08ea3:

    # eva "¿Así que otra más para el harén? No sabía que te gustaban musculosas."
    eva "Então, mais uma para o harém? Não sabia que você gostava de mulheres musculosas."

# game/scripts/c16/c16.rpy:2080
translate brazilian c16s003_ShootingLessons_3b105dbc:

    # eva "No sabía que te gustaban musculosas."
    eva "Eu não sabia que você gostava de mulheres musculosas."

# game/scripts/c16/c16.rpy:2081
translate brazilian c16s003_ShootingLessons_0beb8d12:

    # mc "Sin querer parecer maleducado, no creo que..."
    mc "Sem querer parecer rude, eu não acho..."

# game/scripts/c16/c16.rpy:2083
translate brazilian c16s003_ShootingLessons_183a235d:

    # eva "¿Que sea asunto mío? ¡Oh! No lo es, solo hacía una observación."
    eva "Isso é da minha conta? Ah! Não, não é. Eu estava apenas fazendo uma observação."

# game/scripts/c16/c16.rpy:2084
translate brazilian c16s003_ShootingLessons_f162da72:

    # eva "*Susurrando para sí misma* Pero si no llego a interrumpiros te hubieras podido acostar con ella."
    eva "*Sussurrando para si mesma* Mas se eu não tivesse te interrompido, você poderia ter dormido com ela."

# game/scripts/c16/c16.rpy:2085
translate brazilian c16s003_ShootingLessons_e245da95:

    # mc "Sabes que te he oído, ¿verdad?"
    mc "Você sabe que eu ouvi você, né?"

# game/scripts/c16/c16.rpy:2086
translate brazilian c16s003_ShootingLessons_2728ab9d:

    # mc "Debbie y yo aún no estamos ahí."
    mc "Eu e a Debbie ainda não chegamos lá."

# game/scripts/c16/c16.rpy:2088
translate brazilian c16s003_ShootingLessons_90a084c5:

    # eva "¡Oops! No pretendía que me escucharas."
    eva "Ops! Não era minha intenção que você me ouvisse."

# game/scripts/c16/c16.rpy:2089
translate brazilian c16s003_ShootingLessons_eb585346:

    # eva "Me refería a que, está claro lo que la chica siente por ti..."
    eva "O que eu quis dizer é que está claro o que a garota sente por você..."

# game/scripts/c16/c16.rpy:2090
translate brazilian c16s003_ShootingLessons_dfcd2792:

    # mc "Bueno, hoy hemos dado un paso, pero sigo pensando que es algo que no te debería importar."
    mc "Bem, demos um passo em frente hoje, mas ainda acho que é algo com que você não deveria se preocupar."

# game/scripts/c16/c16.rpy:2093
translate brazilian c16s003_ShootingLessons_d4384259:

    # mc "Tengo una pregunta..."
    mc "Tenho uma pergunta..."

# game/scripts/c16/c16.rpy:2095
translate brazilian c16s003_ShootingLessons_3288126a:

    # mc "Con todo el tema de las cámaras y el espionaje... ¿sabéis con quién más salgo? ¿Y cuánto habéis visto?"
    mc "Com toda essa conversa sobre câmeras e espionagem... você sabe com quem mais estou saindo? E o quanto você viu?"

# game/scripts/c16/c16.rpy:2097
translate brazilian c16s003_ShootingLessons_f603d417:

    # mc "Con todo el tema de las cámaras y el espionaje... ¿sabéis con quién salgo?"
    mc "Com toda essa conversa sobre câmeras e espionagem... você sabe com quem estou namorando?"

# game/scripts/c16/c16.rpy:2100
translate brazilian c16s003_ShootingLessons_a0b821fb:

    # eva "¿Sales con alguien? No teníamos ni idea..."
    eva "Você está saindo com alguém? Não tínhamos ideia..."

# game/scripts/c16/c16.rpy:2101
translate brazilian c16s003_ShootingLessons_cc63ec5d:

    # mc "Es bueno que no lo sepáis todo."
    mc "É bom que você não saiba tudo."

# game/scripts/c16/c16.rpy:2105
translate brazilian c16s003_ShootingLessons_186aa672:

    # eva "[mar]. Os vimos al volver de vuestra cita."
    eva "[mar]. Nós te vimos voltando do seu encontro."

# game/scripts/c16/c16.rpy:2107
translate brazilian c16s003_ShootingLessons_239f4eb8:

    # eva "Y sí, vimos lo de anoche. Fue bonito y sexy a partes iguales."
    eva "E sim, vimos o que aconteceu ontem à noite. Foi lindo e sensual na mesma medida."

# game/scripts/c16/c16.rpy:2109
translate brazilian c16s003_ShootingLessons_e0107257:

    # eva "[nor]. Os hemos visto un par de veces."
    eva "[nor]. Já te vimos algumas vezes."

# game/scripts/c16/c16.rpy:2111
translate brazilian c16s003_ShootingLessons_885a1583:

    # eva "[emm]. Solo una vez contigo en solitario."
