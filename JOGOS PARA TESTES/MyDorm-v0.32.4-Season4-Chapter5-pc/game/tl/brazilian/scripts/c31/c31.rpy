translate brazilian c31s004_flight1_5d631bde:

    # "A guy from the airport staff takes your bags and leads you to the plane, where a flight attendant is waiting for you."
    "Um cara da equipe do aeroporto pega suas malas e te leva até o avião, onde uma comissária de bordo está te esperando."

# game/scripts/c31/c31.rpy:2503
translate brazilian c31s004_flight1_06190e71:

    # "You approach her while the guy loads your luggage. [ama] and [bet] packed relatively light."
    "Você se aproxima dela enquanto o cara carrega sua bagagem. [ama] e [bet] fizeram malas relativamente leves."

# game/scripts/c31/c31.rpy:2504
translate brazilian c31s004_flight1_e099c1b3:

    # "But he's going to earn his day's pay with your luggage."
    "Mas ele vai ganhar o salário do dia com a sua bagagem."

# game/scripts/c31/c31.rpy:2506
translate brazilian c31s004_flight1_f5b1b9f7:

    # alb "Good afternoon, Mr. Marks, Miss Cavendish. Hello, [ama]."
    alb "Boa tarde, Sr. Marks, Srta. Cavendish. Olá, [ama]."

# game/scripts/c31/c31.rpy:2508
translate brazilian c31s004_flight1_08093088:

    # "[bet] doesn't correct her by telling her she's no longer a 'Miss'."
    "[bet] não a corrige dizendo que não é mais uma 'Senhorita'."

# game/scripts/c31/c31.rpy:2509
translate brazilian c31s004_flight1_412333a9:

    # alb "I'm [alb], and I'll be your flight attendant. I hope you have a pleasant trip."
    alb "Eu sou [alb], e serei sua comissária de bordo. Espero que tenham uma viagem agradável."

# game/scripts/c31/c31.rpy:2510
translate brazilian c31s004_flight1_7c16e55c:

    # mc "Thanks, [alb]. I see you know [ama]. Are you NTR staff?"
    mc "Obrigado, [alb]. Vejo que você conhece a [ama]. Você é da equipe da NTR?"

# game/scripts/c31/c31.rpy:2512
translate brazilian c31s004_flight1_81e5c231:

    # alb "Yes, Mr. Marks. Both the pilots and I are part of the Support Department."
    alb "Sim, Sr. Marks. Tanto os pilotos quanto eu fazemos parte do Departamento de Suporte."

# game/scripts/c31/c31.rpy:2513
translate brazilian c31s004_flight1_fccbe7c2:

    # alb "Before you ask, the pilots are... not clones."
    alb "Antes que pergunte, os pilotos... não são clones."

# game/scripts/c31/c31.rpy:2514
translate brazilian c31s004_flight1_86ac42d1:

    # mc "I wasn't going to ask. If they do their job well, I don't think it matters."
    mc "Eu não ia perguntar. Se eles fizerem bem o trabalho deles, acho que não importa."

# game/scripts/c31/c31.rpy:2516
translate brazilian c31s004_flight1_df590dd6:

    # alb "If you'd like to board, the flight plan indicates we'll be taking off in a few minutes."
    alb "Se quiserem embarcar, o plano de voo indica que decolaremos em alguns minutos."

# game/scripts/c31/c31.rpy:2517
translate brazilian c31s004_flight1_e133b440:

    # alb "The flight will take us about six hours, so we'll arrive around 3:15 AM in Aruba, local time."
    alb "O voo levará cerca de seis horas, então chegaremos por volta das 3:15 da manhã em Aruba, horário local."

# game/scripts/c31/c31.rpy:2518
translate brazilian c31s004_flight1_debba945:

    # mc "Perfect. Let's board."
    mc "Perfeito. Vamos embarcar."

# game/scripts/c31/c31.rpy:2521
translate brazilian c31s004_flight1_13da10ce:

    # "Once on the plane, [alb] guides you to your seats and tells you to prepare for takeoff, which happens a few minutes later."
    "Uma vez no avião, [alb] guia vocês até seus assentos e diz para se prepararem para a decolagem, que acontece alguns minutos depois."

# game/scripts/c31/c31.rpy:2522
translate brazilian c31s004_flight1_26bcab8d:

    # mc "[alb] said something... 'the pilots are...', but she didn't finish the sentence. She changed the end mid-sentence to 'not clones.'"
    mc "A [alb] disse algo... 'os pilotos são...', mas ela não terminou a frase. Ela mudou o final no meio da frase para 'não são clones'."

# game/scripts/c31/c31.rpy:2523
translate brazilian c31s004_flight1_ff922d40:

    # mc "Do you know what she meant?"
    mc "Você sabe o que ela quis dizer?"

# game/scripts/c31/c31.rpy:2524
translate brazilian c31s004_flight1_97d39f90:

    # ama "She was probably going to say 'human' or 'normal'. She must have changed the end of the sentence because she doesn't know what you think of clones."
    ama "Ela provavelmente ia dizer 'humanos' ou 'normais'. Ela deve ter mudado o final da frase porque não sabe o que você acha de clones."

# game/scripts/c31/c31.rpy:2525
translate brazilian c31s004_flight1_b321445a:

    # ama "And now you're the big boss. Get used to people walking on eggshells around you."
    ama "E agora você é o chefão. Acostume-se com as pessoas pisando em ovos perto de você."

# game/scripts/c31/c31.rpy:2527
translate brazilian c31s004_flight1_e59b2a38:

    # mc "That's unacceptable! You and [eva] are just as normal or human as she is."
    mc "Isso é inaceitável! Você e a [eva] são tão normais ou humanas quanto ela."

# game/scripts/c31/c31.rpy:2529
translate brazilian c31s004_flight1_5b8d657d:

    # mc "That's unacceptable! [eri], [dap], or [emm] are just as normal or human as she is."
    mc "Isso é inaceitável! A [eri], a [dap], ou a [emm] são tão normais ou humanas quanto ela."

# game/scripts/c31/c31.rpy:2531
translate brazilian c31s004_flight1_e8c48027:

    # ama "*Laugh* I hope not. [alb] is a bit of an airhead. But she's not a bad girl."
    ama "*Risos* Espero que não. A [alb] é meio cabeça de vento. Mas ela não é uma garota má."

# game/scripts/c31/c31.rpy:2533
translate brazilian c31s004_flight1_b5529fa2:

    # ama "But seriously, some of the cross-departmental staff think that about clones."
    ama "Mas falando sério, parte da equipe de outros departamentos pensa isso sobre os clones."

# game/scripts/c31/c31.rpy:2535
translate brazilian c31s004_flight1_fc13afce:

    # ama "They think we're a product, that we aren't complete people."
    ama "Eles acham que somos um produto, que não somos pessoas completas."

# game/scripts/c31/c31.rpy:2537
translate brazilian c31s004_flight1_6dcdd2e6:

    # ama "They think they're a product, that they aren't complete people."
    ama "Eles acham que são um produto, que não são pessoas completas."

# game/scripts/c31/c31.rpy:2538
translate brazilian c31s004_flight1_5c8035dc:

    # mc "I'll talk to her after takeoff. It's one of the things we need to change."
    mc "Vou falar com ela depois da decolagem. É uma das coisas que precisamos mudar."

# game/scripts/c31/c31.rpy:2540
translate brazilian c31s004_flight1_074add6d:

    # bet "I don't think you should. It's not the time to try and change someone's mind, because you won't succeed."
    bet "Acho melhor não. Não é o momento de tentar mudar a cabeça de alguém, porque você não vai conseguir."

# game/scripts/c31/c31.rpy:2541
translate brazilian c31s004_flight1_b7312607:

    # bet "You have to show that you see clones as people, but you have to show it with actions, not words."
    bet "Você tem que mostrar que vê os clones como pessoas, mas tem que mostrar isso com ações, não com palavras."

# game/scripts/c31/c31.rpy:2542
translate brazilian c31s004_flight1_45192528:

    # bet "And it won't do any good to have the girl worrying the whole trip about whether you're going to fire her for a slip-up she corrected in time."
    bet "E não vai adiantar nada deixar a garota preocupada a viagem toda se você vai demiti-la por um deslize que ela corrigiu a tempo."

# game/scripts/c31/c31.rpy:2543
translate brazilian c31s004_flight1_cbe66f7a:

    # mc "You're right, I can't tell her off for something she didn't actually say."
    mc "Você tem razão, não posso dar uma bronca nela por algo que ela nem chegou a dizer."

# game/scripts/c31/c31.rpy:2545
translate brazilian c31s004_flight1_c4422946:

    # ama "Besides, it wouldn't do any good. People who hold that opinion aren't going to change it just because of what you say to them."
    ama "Além disso, não adiantaria nada. As pessoas que têm essa opinião não vão mudar só por causa do que você diz a elas."

# game/scripts/c31/c31.rpy:2546
translate brazilian c31s004_flight1_c864fea1:

    # ama "If they see clones as disposable tools, they'll only change their minds when you make changes that prove otherwise."
    ama "Se eles veem os clones como ferramentas descartáveis, só vão mudar de ideia quando você fizer mudanças que provem o contrário."

# game/scripts/c31/c31.rpy:2547
translate brazilian c31s004_flight1_d767ced3:

    # mc "Well, we'll have to start looking into what measures we can take in that regard."
    mc "Bom, vamos ter que começar a ver quais medidas podemos tomar em relação a isso."

# game/scripts/c31/c31.rpy:2548
translate brazilian c31s004_flight1_898cbc62:

    # mc "We have six hours ahead of us to start making plans."
    mc "Temos seis horas pela frente para começar a fazer planos."

# game/scripts/c31/c31.rpy:2550
translate brazilian c31s004_flight1_bea35b7e:

    # bet "While you guys work, I'm going to take the opportunity to take a nap on that couch back there."
    bet "Enquanto vocês trabalham, vou aproveitar para tirar um cochilo naquele sofá ali atrás."

# game/scripts/c31/c31.rpy:2551
translate brazilian c31s004_flight1_ee53125c:

    # bet "If we get to Aruba at 3 AM, and we have to wake up early tomorrow, I'd rather get some sleep ahead of time."
    bet "Se chegarmos a Aruba às 3 da manhã, e tivermos que acordar cedo amanhã, prefiro dormir um pouco antes."

# game/scripts/c31/c31.rpy:2552
translate brazilian c31s004_flight1_fe3c9d06:

    # mc "I hadn't thought about that. We're going to get very little sleep tonight."
    mc "Eu não tinha pensado nisso. Vamos dormir muito pouco esta noite."

# game/scripts/c31/c31.rpy:2554
translate brazilian c31s004_flight1_574bd71a:

    # mc "Do you want to get some sleep too?"
    mc "Você quer dormir um pouco também?"

# game/scripts/c31/c31.rpy:2555
translate brazilian c31s004_flight1_b61f2ea5:

    # ama "I'm not sleepy at all right now. Working for a bit sounds like a good idea."
    ama "Não estou com sono nenhum agora. Trabalhar um pouco parece uma boa ideia."

# game/scripts/c31/c31.rpy:2556
translate brazilian c31s004_flight1_fd576e9e:

    # mc "Then let's brainstorm on what we can do over the next few days."
    mc "Então vamos fazer um brainstorm sobre o que podemos fazer nos próximos dias."

# game/scripts/c31/c31.rpy:2558
translate brazilian c31s004_flight1_b2209ad3:

    # "While you and [ama] work for the next three hours, [bet] sleeps quietly on the couch behind you."
    "Enquanto você e [ama] trabalham pelas próximas três horas, [bet] dorme tranquilamente no sofá atrás de você."

# game/scripts/c31/c31.rpy:2559
translate brazilian c31s004_flight1_1a7868ba:

    # "She once told you that, during her time in Africa, she learned to fall asleep whenever she had the chance."
    "Ela te disse uma vez que, durante seu tempo na África, aprendeu a dormir sempre que tivesse a chance."

# game/scripts/c31/c31.rpy:2560
translate brazilian c31s004_flight1_b4f0434d:

    # "She never knew when an emergency would come up that would keep her awake for hours."
    "Ela nunca sabia quando surgiria uma emergência que a manteria acordada por horas."

# game/scripts/c31/c31.rpy:2561
translate brazilian c31s004_flight1_e34443db:

    # "A lot of interesting ideas come up while talking with [ama] about the things you can do once you get to Aruba."
    "Muitas ideias interessantes surgem enquanto você conversa com [ama] sobre as coisas que podem fazer quando chegarem a Aruba."

# game/scripts/c31/c31.rpy:2562
translate brazilian c31s004_flight1_b2e6d814:

    # "But you need more information on how to carry them out."
    "Mas você precisa de mais informações sobre como realizá-las."

# game/scripts/c31/c31.rpy:2567
translate brazilian c31s004_noMileHighClub_5b587eeb:

    # "In the dead of night, while flying over the Gulf of Mexico..."
    "Na calada da noite, enquanto voam sobre o Golfo do México..."

# game/scripts/c31/c31.rpy:2568
translate brazilian c31s004_noMileHighClub_1fda0035:

    # bet "*Laugh*"
    bet "*Risos*"

# game/scripts/c31/c31.rpy:2569
translate brazilian c31s004_noMileHighClub_fd186e08:

    # ama "I thought you were sleeping, Aunt [bet]."
    ama "Achei que você estivesse dormindo, Tia [bet]."

# game/scripts/c31/c31.rpy:2570
translate brazilian c31s004_noMileHighClub_feeabc39:

    # mc "We thought you were going to sleep through the whole trip."
    mc "Achamos que você ia dormir a viagem toda."

# game/scripts/c31/c31.rpy:2573
translate brazilian c31s004_noMileHighClub_b432c3c6:

    # bet "This flight is taking forever. I guess Aruba is still far away. How long have I been asleep?"
    bet "Esse voo está demorando uma eternidade. Acho que Aruba ainda está longe. Há quanto tempo estou dormindo?"

# game/scripts/c31/c31.rpy:2574
translate brazilian c31s004_noMileHighClub_fe45e54d:

    # mc "About three hours. We've already left the US."
    mc "Umas três horas. Já saímos dos EUA."

# game/scripts/c31/c31.rpy:2576
translate brazilian c31s004_noMileHighClub_2558f871:

    # ama "There's still about another three hours left. Relax, [bet]."
    ama "Ainda faltam umas três horas. Relaxa, [bet]."

# game/scripts/c31/c31.rpy:2577
translate brazilian c31s004_noMileHighClub_bc0ea06c:

    # mc "*Laugh* That gives you time to take another nap."
    mc "*Risos* Isso te dá tempo para tirar outro cochilo."

# game/scripts/c31/c31.rpy:2579
translate brazilian c31s004_noMileHighClub_f9014de1:

    # mc "What were you laughing at?"
    mc "Do que você estava rindo?"

# game/scripts/c31/c31.rpy:2580
translate brazilian c31s004_noMileHighClub_baa4f3ac:

    # bet "I woke up a few minutes ago and, since I didn't want to bother you guys, I was watching some MeTube videos [emm] sent to me."
    bet "Acordei há alguns minutos e, como não queria incomodar vocês, estava assistindo uns vídeos do MeTube que a [emm] me mandou."

# game/scripts/c31/c31.rpy:2581
translate brazilian c31s004_noMileHighClub_88c7be4d:

    # bet "One of them was about a nun getting caught having sex on a plane. Though you could tell it was a set."
    bet "Um deles era sobre uma freira sendo pega transando num avião. Embora desse pra notar que era um cenário."

# game/scripts/c31/c31.rpy:2583
translate brazilian c31s004_noMileHighClub_693f9c70:

    # ama "The Mile High Club. It's a classic."
    ama "O Mile High Club. É um clássico."

# game/scripts/c31/c31.rpy:2584
translate brazilian c31s004_noMileHighClub_0a74f4ca:

    # mc "I've never found it that interesting. An airplane restroom is way too small."
    mc "Nunca achei isso tão interessante. O banheiro de um avião é pequeno demais."

# game/scripts/c31/c31.rpy:2586
translate brazilian c31s004_noMileHighClub_38b0078e:

    # ama "*Laugh* A space where whoever is in there has to get along VERY well."
    ama "*Risos* Um espaço onde quem estiver lá dentro tem que se dar MUITO bem."

# game/scripts/c31/c31.rpy:2587
translate brazilian c31s004_noMileHighClub_fba7313c:

    # mc "*Laugh* If you put it that way..."
    mc "*Risos* Colocando dessa forma..."

# game/scripts/c31/c31.rpy:2589
translate brazilian c31s004_noMileHighClub_4531727b:

    # bet "*Laugh* I've always imagined what it must be like to have sex on a plane during turbulence."
    bet "*Risos* Sempre imaginei como deve ser transar num avião durante uma turbulência."

# game/scripts/c31/c31.rpy:2590
translate brazilian c31s004_noMileHighClub_66938e53:

    # mc "*Laugh* Bumpy sex."
    mc "*Risos* Uma transa turbulenta."

# game/scripts/c31/c31.rpy:2592
translate brazilian c31s004_noMileHighClub_c181b602:

    # ama "It would be easier on this plane. The back restroom is big. And behind the last bulkhead there's a bed."
    ama "Seria mais fácil neste avião. O banheiro dos fundos é grande. E atrás da última divisória tem uma cama."

# game/scripts/c31/c31.rpy:2593
translate brazilian c31s004_noMileHighClub_d6342b7a:

    # mc "There's a bed and [bet] is sleeping on the couch?"
    mc "Tem uma cama e a [bet] tá dormindo no sofá?"

# game/scripts/c31/c31.rpy:2595
translate brazilian c31s004_noMileHighClub_2733f5f3:

    # bet "*Laugh* Don't mess with my couch. It's super comfortable."
    bet "*Risos* Não fale mal do meu sofá. Ele é super confortável."

# game/scripts/c31/c31.rpy:2596
translate brazilian c31s004_noMileHighClub_a1fffaa8:

    # bet "And I'm going back to it right now. I'll let you guys keep working."
    bet "E eu vou voltar pra ele agora mesmo. Vou deixar vocês continuarem trabalhando."

# game/scripts/c31/c31.rpy:2597
translate brazilian c31s004_noMileHighClub_7950c729:

    # bet "Wake me up when we get to Aruba."
    bet "Me acordem quando chegarmos em Aruba."

# game/scripts/c31/c31.rpy:2598
translate brazilian c31s004_noMileHighClub_aaa1b5a2:

    # mc "Good night, Aunt [bet]."
    mc "Boa noite, Tia [bet]."

# game/scripts/c31/c31.rpy:2605
translate brazilian c31s004_mileHighClub_5bacb60d:

    # "When you are flying over the Gulf of Mexico..."
    "Quando você está voando sobre o Golfo do México..."

# game/scripts/c31/c31.rpy:2606
translate brazilian c31s004_mileHighClub_b432c3c6:

    # bet "This flight is taking forever. I guess Aruba is still a ways off. How long did I sleep?"
    bet "Esse voo tá demorando uma eternidade. Acho que Aruba ainda tá longe. Quanto tempo eu dormi?"

# game/scripts/c31/c31.rpy:2607
translate brazilian c31s004_mileHighClub_fe45e54d:

    # mc "About three hours. We're already out of the US."
    mc "Umas três horas. Já saímos dos Estados Unidos."

# game/scripts/c31/c31.rpy:2609
translate brazilian c31s004_mileHighClub_2558f871:

    # ama "We still have about three more hours to go. Just relax, [bet]."
    ama "Ainda temos umas três horas pela frente. Só relaxa, [bet]."

# game/scripts/c31/c31.rpy:2610
translate brazilian c31s004_mileHighClub_bc0ea06c:

    # mc "*Laugh* That gives you time for another nap."
    mc "*Risos* Isso te dá tempo pra mais um cochilo."

# game/scripts/c31/c31.rpy:2612
translate brazilian c31s004_mileHighClub_56084b84:

    # bet "Relax... yeah. Or do something more interesting."
    bet "Relaxar... é. Ou fazer algo mais interessante."

# game/scripts/c31/c31.rpy:2613
translate brazilian c31s004_mileHighClub_041473fd:

    # bet "[ama]... do you mind if I steal your boss for a bit? I'm taking him to the restroom."
    bet "[ama]... você se importa se eu roubar seu chefe um pouquinho? Vou levar ele pro banheiro."

# game/scripts/c31/c31.rpy:2615
translate brazilian c31s004_mileHighClub_f4b5b85d:

    # ama "A private jet's restroom? Classic, from what I've read. You want to join the Mile High Club?"
    ama "O banheiro de um jato particular? Clássico, pelo que eu li. Você quer entrar pro Mile High Club?"

# game/scripts/c31/c31.rpy:2617
translate brazilian c31s004_mileHighClub_80463e18:

    # bet "I always thought it was a silly thing. Until I woke up and you guys told me we still have three hours left."
    bet "Eu sempre achei que era uma bobeira. Até eu acordar e vocês me dizerem que ainda faltam três horas."

# game/scripts/c31/c31.rpy:2618
translate brazilian c31s004_mileHighClub_4549df59:

    # mc "*Laugh* I think that's the least romantic reason I've ever been propositioned for sex."
    mc "*Risos* Acho que esse é o motivo menos romântico pelo qual já me propuseram sexo."

# game/scripts/c31/c31.rpy:2620
translate brazilian c31s004_mileHighClub_e8a0b7b5:

    # ama "Go ahead. But don't take too long. I need to keep talking to him afterwards."
    ama "Vão em frente. Mas não demorem muito. Preciso continuar conversando com ele depois."

# game/scripts/c31/c31.rpy:2621
translate brazilian c31s004_mileHighClub_7b11f280:

    # ama "And [bet]... try not to hurt yourself. Airplane restrooms are tiny."
    ama "E [bet]... tente não se machucar. Banheiros de avião são minúsculos."

# game/scripts/c31/c31.rpy:2623
translate brazilian c31s004_mileHighClub_00cae64a:

    # bet "*Laugh* Do you think you are funny?"
    bet "*Risos* Você se acha engraçadinha?"

# game/scripts/c31/c31.rpy:2624
translate brazilian c31s004_mileHighClub_dff3a3cc:

    # mc "Is nobody going to ask me?"
    mc "Ninguém vai me perguntar?"

# game/scripts/c31/c31.rpy:2626
translate brazilian c31s004_mileHighClub_7dab3510:

    # bet "No."
    bet "Não."

# game/scripts/c31/c31.rpy:2628
translate brazilian c31s004_mileHighClub_11ebe623:

    # ama "No. We know what you'd answer, so... why bother?"
    ama "Não. Nós sabemos o que você responderia, então... pra que se dar ao trabalho?"

# game/scripts/c31/c31.rpy:2629
translate brazilian c31s004_mileHighClub_e8b80335:

    # ama "By the way, use the restroom in the back, it's bigger than the one in the front."
    ama "A propósito, usem o banheiro lá de trás, é maior que o da frente."

# game/scripts/c31/c31.rpy:2630
translate brazilian c31s004_mileHighClub_66928687:

    # mc "*Laugh* Thanks, [ama]. I think [bet] will appreciate it."
    mc "*Risos* Valeu, [ama]. Acho que a [bet] vai gostar."

# game/scripts/c31/c31.rpy:2632
translate brazilian c31s004_mileHighClub_07ea0b32:

    # bet "Do you want to fuck or not? *Laugh* If you keep joking about this poor old lady, I might reconsider..."
    bet "Você quer foder ou não? *Risos* Se continuar fazendo piada com essa pobre velhinha, eu posso reconsiderar..."

# game/scripts/c31/c31.rpy:2633
translate brazilian c31s004_mileHighClub_0d098189:

    # mc "Not one more joke. I promise."
    mc "Nem mais uma piada. Eu prometo."

# game/scripts/c31/c31.rpy:2635
translate brazilian c31s004_mileHighClub_371311da:

    # mc "Are you sure? Two people can barely fit standing up in there if they get along VERY well."
