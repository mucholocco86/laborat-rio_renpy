# game/scripts/c31/c31.rpy:964
translate brazilian c31s002_morning_877a42d4:

    # "After last night, you thought you'd wake up with [kat] by your side, looking at you."
    "Depois da noite passada, você achou que acordaria com [kat] ao seu lado, olhando para você."

# game/scripts/c31/c31.rpy:966
translate brazilian c31s002_morning_c00bd7cb:

    # "You wake up relatively early. Although surely some of the girls are already in class."
    "Você acorda relativamente cedo. Embora com certeza algumas das garotas já estejam na aula."

# game/scripts/c31/c31.rpy:967
translate brazilian c31s002_morning_b7d1fea9:

    # "You decide to go down for breakfast before it gets too late."
    "Você decide descer para tomar café da manhã antes que fique muito tarde."

# game/scripts/c31/c31.rpy:977
translate brazilian c31s002_lisFork_a38d722e:

