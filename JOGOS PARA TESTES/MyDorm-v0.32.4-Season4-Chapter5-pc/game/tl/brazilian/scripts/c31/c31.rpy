# game/scripts/c31/c31.rpy:2936
translate brazilian c31s004_flight2_96825b34:

    # mc "Hey!"
    mc "Ei!"

# game/scripts/c31/c31.rpy:2938
translate brazilian c31s004_flight2_ac50cdcf:

    # bet "*Laugh* We don't know what your taste in men was like before, so we can't know if you've evolved for better or worse."
    bet "*Risos* Não sabemos como era o seu gosto para homens antes, então não temos como saber se você evoluiu para melhor ou para pior."

# game/scripts/c31/c31.rpy:2939
translate brazilian c31s004_flight2_85e7ec37:

    # mc "Hey! I'm right here. You know that, right?"
    mc "Ei! Eu tô bem aqui. Vocês sabem disso, né?"

# game/scripts/c31/c31.rpy:2941
translate brazilian c31s004_flight2_9fbf1aa0:

    # bet "I mean, if she used to like Jason Moanoa and ended up marrying you..."
    bet "Digo, se ela gostava do Jason Momoa e acabou casando com você..."

# game/scripts/c31/c31.rpy:2942
translate brazilian c31s004_flight2_ffee94dd:

    # mc "*Laugh* If you take away Jason's fame, money, hair, beard, and muscles... What does he have that I don't?"
    mc "*Risos* Se você tirar a fama, o dinheiro, o cabelo, a barba e os músculos do Jason... O que ele tem que eu não tenho?"

# game/scripts/c31/c31.rpy:2944
translate brazilian c31s004_flight2_66ef0658:

    # bet "*Laugh* Nothing, nothing..." (multiple=2)
    bet "*Risos* Nada, nada..." (multiple=2)

# game/scripts/c31/c31.rpy:2945
translate brazilian c31s004_flight2_79b7f536:

    # ama "*Laugh* Acting talent?" (multiple=2)
    ama "*Risos* Talento pra atuar?" (multiple=2)

# game/scripts/c31/c31.rpy:2946
translate brazilian c31s004_flight2_3267f1ce:

    # mc "Stop this plane, I want to get off!"
    mc "Parem esse avião, eu quero descer!"

# game/scripts/c31/c31.rpy:2948
translate brazilian c31s004_flight2_e1ac6040:

    # bet "But seriously..."
    bet "Mas falando sério..."

# game/scripts/c31/c31.rpy:2949
translate brazilian c31s004_flight2_3ba4b337:

    # bet "What [mc] wanted to say, even though he likes to beat around the bush, is that you're not the same person we met three weeks ago."
    bet "O que o [mc] queria dizer, mesmo que ele goste de enrolar, é que você não é a mesma pessoa que conhecemos três semanas atrás."

# game/scripts/c31/c31.rpy:2952
translate brazilian c31s004_flight2_e0f4645a:

    # bet "What [mc] means to say, even though he likes to beat around the bush, is that you're not the same person we met three weeks ago."
    bet "O que o [mc] quer dizer, mesmo que ele goste de enrolar, é que você não é a mesma pessoa que conhecemos três semanas atrás."

# game/scripts/c31/c31.rpy:2953
translate brazilian c31s004_flight2_b36be703:

    # bet "It's no longer just you and [eva] against the world. Now you have us too."
    bet "Não é mais só você e a [eva] contra o mundo. Agora você tem a gente também."

# game/scripts/c31/c31.rpy:2954
translate brazilian c31s004_flight2_0ebf2174:

    # bet "Nobody messes with a Marks without 23 people jumping at their throat."
    bet "Ninguém mexe com uma Marks sem que 23 pessoas pulem no pescoço deles."

# game/scripts/c31/c31.rpy:2955
translate brazilian c31s004_flight2_b547ee30:

    # mc "And if not, we can always send Jamaal to run them over. Even though he can't jump too high."
    mc "E se não, a gente sempre pode mandar o Jamaal atropelar eles. Mesmo que ele não consiga pular muito alto."

# game/scripts/c31/c31.rpy:2957
translate brazilian c31s004_flight2_736d580a:

    # ama "I couldn't do this without you guys. Thank you..."
    ama "Eu não conseguiria fazer isso sem vocês. Obrigada..."

# game/scripts/c31/c31.rpy:2959
translate brazilian c31s004_flight2_520e658b:

    # ama "And about running someone over... *Giggles* I think when you meet a certain [dam], a D-series clone, you'll feel like doing it."
    ama "E sobre atropelar alguém... *Risadinhas* Acho que quando você conhecer um certo [dam], um clone da série D, você vai ter vontade de fazer isso."

# game/scripts/c31/c31.rpy:2960
translate brazilian c31s004_flight2_8c86aede:

    # alb "*PA system* We will be landing in a few minutes. Please remember to fasten your seatbelts."
    alb "*Sistema de som* Pousaremos em alguns minutos. Por favor, lembrem-se de apertar os cintos."

# game/scripts/c31/c31.rpy:2961
translate brazilian c31s004_flight2_1f8baac2:

    # mc "Well, I think the real trip starts now. It's nothing we can't do together."
    mc "Bom, acho que a verdadeira viagem começa agora. Não é nada que não possamos fazer juntos."

# game/scripts/c31/c31.rpy:2962
translate brazilian c31s004_flight2_9584d0e2:

    # mc "And if we have to run over this [dam] guy, we'll run him over."
    mc "E se tivermos que passar por cima desse tal de [dam], nós vamos passar."

# game/scripts/c31/c31.rpy:2969
translate brazilian c31s005_AarPicksUp_62c3affa:

    # "Once the plane lands, it goes straight to what looks like a military hangar."
    "Assim que o avião pousa, ele vai direto para o que parece ser um hangar militar."

# game/scripts/c31/c31.rpy:2970
translate brazilian c31s005_AarPicksUp_2ede401c:

    # "[aar] is waiting for you with a car inside the hangar."
    "[aar] está esperando por vocês com um carro dentro do hangar."

# game/scripts/c31/c31.rpy:2974
translate brazilian c31s005_AarPicksUp_41b5383b:

    # "[ama]'s face lights up when she sees him through the window."
    "O rosto de [ama] se ilumina quando ela o vê pela janela."

# game/scripts/c31/c31.rpy:2976
translate brazilian c31s005_AarPicksUp_770cf792:

    # "And she does what you would never have expected from someone like [ama]."
    "E ela faz o que você nunca esperaria de alguém como [ama]."

# game/scripts/c31/c31.rpy:2977
translate brazilian c31s005_AarPicksUp_350aa7cb:

    # "Judging by his surprised face, [aar] would never have expected it either."
    "A julgar pela cara de surpresa dele, [aar] também nunca teria esperado por isso."

# game/scripts/c31/c31.rpy:2979
translate brazilian c31s005_AarPicksUp_dcb99871:

    # ama "You didn't have to bother coming."
    ama "Você não precisava se incomodar em vir."

# game/scripts/c31/c31.rpy:2980
translate brazilian c31s005_AarPicksUp_06c41f7f:

    # aar "It was the least I could do..."
    aar "Era o mínimo que eu podia fazer..."

# game/scripts/c31/c31.rpy:2982
translate brazilian c31s005_AarPicksUp_3a4f68fa:

    # mc "[aar], it's a pleasure to see you in person instead of through a screen."
    mc "[aar], é um prazer te ver pessoalmente em vez de através de uma tela."

# game/scripts/c31/c31.rpy:2983
translate brazilian c31s005_AarPicksUp_2e0531e7:

    # aar "Likewise, [mc]. I was looking forward to handing the CEO job over to you."
    aar "Igualmente, [mc]. Eu estava ansioso para passar o cargo de CEO pra você."


# game/scripts/c31/c31.rpy:2985
translate brazilian c31s005_AarPicksUp_ba759fc9:

    # aar "*Whispering* What have you done to [ama]?"
    aar "*Sussurrando* O que você fez com a [ama]?"

# game/scripts/c31/c31.rpy:2986
translate brazilian c31s005_AarPicksUp_5c450db9:

    # mc "*Laugh* We taught her to express what she feels. It's a good change."
    mc "*Rindo* Nós a ensinamos a expressar o que sente. É uma boa mudança."

# game/scripts/c31/c31.rpy:2988
translate brazilian c31s005_AarPicksUp_39c9cc94:

    # ama "Jeetje mina*! [aar] is your clone! \n* 'Mother of mine!' in Dutch."
    ama "Jeetje mina*! O [aar] é o seu clone! \n* 'Minha mãe!' em Holandês."

# game/scripts/c31/c31.rpy:2990
translate brazilian c31s005_AarPicksUp_a51b1017:

    # mc "I told you she'd figure it out the moment she saw us together."
    mc "Eu te disse que ela ia sacar no momento em que nos visse juntos."

# game/scripts/c31/c31.rpy:2991
translate brazilian c31s005_AarPicksUp_238515b8:

    # aar "I had to try."
    aar "Eu tinha que tentar."

# game/scripts/c31/c31.rpy:2993
translate brazilian c31s005_AarPicksUp_211c275e:

    # ama "You knew? Why didn't you tell me?"
    ama "Você sabia? Por que não me contou?"

# game/scripts/c31/c31.rpy:2994
translate brazilian c31s005_AarPicksUp_6e71b403:

    # mc "I promised [aar]. He told me he wanted to tell you himself."
    mc "Eu prometi ao [aar]. Ele me disse que queria contar pra você ele mesmo."

# game/scripts/c31/c31.rpy:2996
translate brazilian c31s005_AarPicksUp_5d401034:

    # bet "If it was obvious over a video call, only a blind person wouldn't figure it out seeing you together."
    bet "Se já era óbvio por chamada de vídeo, só um cego não perceberia vendo vocês juntos."

# game/scripts/c31/c31.rpy:2997
translate brazilian c31s005_AarPicksUp_8f5a1fb0:

    # mc "Yeah, that's what I thought."
    mc "É, foi o que eu pensei."

# game/scripts/c31/c31.rpy:2999
translate brazilian c31s005_AarPicksUp_1e2626b7:

    # ama "You knew too? Does [eva] know too? Am I the only idiot who didn't know?"
    ama "Você também sabia? A [eva] também sabe? Eu sou a única idiota que não sabia?"

# game/scripts/c31/c31.rpy:3000
translate brazilian c31s005_AarPicksUp_aa6c3611:

    # mc "No, [ama]. [eva] doesn't know either. [aar] wanted to tell both of you in person."
    mc "Não, [ama]. A [eva] também não sabe. O [aar] queria contar para vocês duas pessoalmente."

# game/scripts/c31/c31.rpy:3002
translate brazilian c31s005_AarPicksUp_eb18b069:

    # aar "I think I was a bit naive."
    aar "Acho que fui um pouco ingênuo."

# game/scripts/c31/c31.rpy:3003
translate brazilian c31s005_AarPicksUp_780c2b55:

    # mc "Just a bit?"
    mc "Só um pouco?"

# game/scripts/c31/c31.rpy:3005
translate brazilian c31s005_AarPicksUp_cc91dae0:

    # ama "Well, we knew you were someone's clone. We just didn't know whose."
    ama "Bom, a gente sabia que você era clone de alguém. Só não sabíamos de quem."

# game/scripts/c31/c31.rpy:3006
translate brazilian c31s005_AarPicksUp_28d13ec0:

    # ama "When did you find out? Why didn't you tell us anything?"
    ama "Quando você descobriu? Por que não contou nada pra gente?"

# game/scripts/c31/c31.rpy:3008
translate brazilian c31s005_AarPicksUp_f3692149:

    # aar "I've known for a few months, since the Clone War started. But it wasn't the right time to say anything."
    aar "Eu sei há alguns meses, desde que a Guerra dos Clones começou. Mas não era a hora certa de falar nada."

# game/scripts/c31/c31.rpy:3009
translate brazilian c31s005_AarPicksUp_95ab0870:

    # aar "I was surprised you didn't say anything the day we met [mar] and [nor], so I thought it wasn't too obvious."
    aar "Fiquei surpreso que você não disse nada no dia que conhecemos a [mar] e a [nor], então achei que não tava muito óbvio."

# game/scripts/c31/c31.rpy:3011
translate brazilian c31s005_AarPicksUp_69720dec:

    # aar "I haven't looked like you for years, and I don't think the girls remember how I looked back then."
    aar "Eu não me pareço com você há anos, e não acho que as garotas lembram como eu era na época."

# game/scripts/c31/c31.rpy:3012
translate brazilian c31s005_AarPicksUp_ca38fbc7:

    # mc "I think it has more to do with how shocked they were to meet [mar] and [nor]."
    mc "Acho que tem mais a ver com o quão chocadas elas ficaram ao conhecer a [mar] e a [nor]."

# game/scripts/c31/c31.rpy:3013
translate brazilian c31s005_AarPicksUp_fa493f58:

    # mc "I don't think they looked at us more than a couple of times."
    mc "Não acho que elas olharam pra nós mais que um par de vezes."

# game/scripts/c31/c31.rpy:3015
translate brazilian c31s005_AarPicksUp_74cb3c6a:

    # ama "I guess that must be it. It took me less than a minute to see it now."
    ama "Acho que deve ser isso. Levei menos de um minuto pra perceber agora."

# game/scripts/c31/c31.rpy:3016
translate brazilian c31s005_AarPicksUp_c69d3bfc:

    # mc "It's normal that you only had eyes for [mar] and [nor] that day, sweetie."
    mc "É normal que você só tivesse olhos pra [mar] e pra [nor] naquele dia, docinho."

# game/scripts/c31/c31.rpy:3019
translate brazilian c31s005_AarPicksUp_2a441c4a:

    # ama "*Laugh* At least I know my husband isn't going to go bald."
    ama "*Risos* Pelo menos eu sei que meu marido não vai ficar careca."

# game/scripts/c31/c31.rpy:3020
translate brazilian c31s005_AarPicksUp_464ccb1b:

    # mc "*Laugh* I'm pretty happy about that too."
    mc "*Risos* Eu também fico bem feliz com isso."

# game/scripts/c31/c31.rpy:3021
translate brazilian c31s005_AarPicksUp_7d031e06:

    # mc "Although I'd be a proud bald guy if it happened, the kind who shaves it all off. No wigs for me."
    mc "Apesar de que eu seria um careca orgulhoso se acontecesse, do tipo que raspa tudo. Nada de perucas pra mim."

# game/scripts/c31/c31.rpy:3023
translate brazilian c31s005_AarPicksUp_0b43a49d:

    # aar "What? Husband? What's this about? Is it some kind of cover?"
    aar "O quê? Marido? Qual é a dessa história? É algum tipo de disfarce?"

# game/scripts/c31/c31.rpy:3024
translate brazilian c31s005_AarPicksUp_6e4b6d37:

    # mc "I think [ama] has to explain some things to you, [aar]."
    mc "Acho que a [ama] tem que te explicar algumas coisas, [aar]."

# game/scripts/c31/c31.rpy:3026
translate brazilian c31s005_AarPicksUp_4ca237a9:

    # ama "*Laugh* At least you know you're not going to go bald."
    ama "*Risos* Pelo menos você sabe que não vai ficar careca."

# game/scripts/c31/c31.rpy:3027
translate brazilian c31s005_AarPicksUp_464ccb1b_1:

    # mc "*Laugh* I'm pretty happy about that too."
    mc "*Risos* Eu também fico bem feliz com isso."

# game/scripts/c31/c31.rpy:3028
translate brazilian c31s005_AarPicksUp_7d031e06_1:

    # mc "Although I'd be a proud bald guy if it happened, the kind who shaves it all off. No wigs for me."
    mc "Apesar de que eu seria um careca orgulhoso se acontecesse, do tipo que raspa tudo. Nada de perucas pra mim."

# game/scripts/c31/c31.rpy:3030
translate brazilian c31s005_AarPicksUp_48f1f471:

    # bet "Can we talk about baldness and whatever else you want on the way to the base?"
    bet "Podemos falar sobre calvície e o que mais vocês quiserem no caminho pra base?"

# game/scripts/c31/c31.rpy:3031
translate brazilian c31s005_AarPicksUp_de620dd9:

    # bet "It's late and we should get some rest before starting the day tomorrow."
    bet "Já é tarde e devíamos descansar um pouco antes de começar o dia amanhã."

# game/scripts/c31/c31.rpy:3033
translate brazilian c31s005_AarPicksUp_7a93eca1:

    # aar "You're not going to sleep at the base. I'm taking you to the CEO's House."
    aar "Vocês não vão dormir na base. Vou levar vocês pra Casa do CEO."

# game/scripts/c31/c31.rpy:3034
translate brazilian c31s005_AarPicksUp_de627ecd:

    # mc "I thought the CEO's House was at the base..."
    mc "Eu achei que a Casa do CEO ficasse na base..."

# game/scripts/c31/c31.rpy:3036
translate brazilian c31s005_AarPicksUp_8c4b6f25:

    # aar "No. Neither Richards nor Daniels ever wanted to live at the base. The house is about fifteen kilometers away. About ten miles for you."
    aar "Não. Nem o Richards nem o Daniels quiseram morar na base. A casa fica a uns quinze quilômetros de distância. Umas dez milhas pra você."

# game/scripts/c31/c31.rpy:3037
translate brazilian c31s005_AarPicksUp_6111ea36:

    # mc "Do you live there too? You've been acting CEO..."
    mc "Você mora lá também? Você tem sido o CEO interino..."

# game/scripts/c31/c31.rpy:3038
translate brazilian c31s005_AarPicksUp_7e28962c:

    # aar "I live at the base, with the rest of the guys. Nothing has changed regarding that."
    aar "Eu moro na base, com o resto do pessoal. Nada mudou em relação a isso."

# game/scripts/c31/c31.rpy:3040
translate brazilian c31s005_AarPicksUp_f47e96c8:

    # aar "By the way... welcome, [bet]. They didn't let me greet you."
    aar "A propósito... bem-vinda, [bet]. Não me deixaram te cumprimentar."

# game/scripts/c31/c31.rpy:3041
translate brazilian c31s005_AarPicksUp_1297831f:

    # mc "Get your surprised face ready, [aar]."
    mc "Prepara a cara de surpresa, [aar]."

# game/scripts/c31/c31.rpy:3043
translate brazilian c31s005_AarPicksUp_ac1abe42:

    # aar "What do you mean?"
    aar "Como assim?"

# game/scripts/c31/c31.rpy:3046
translate brazilian c31s005_AarPicksUp_e7633ab4:

    # bet "What's with holding out your hand? You're the clone of my great-nephew. You're family!"
    bet "Qual é a de estender a mão? Você é o clone do meu sobrinho-neto. Você é da família!"

# game/scripts/c31/c31.rpy:3047
translate brazilian c31s005_AarPicksUp_b15b59b5:

    # "[aar] realizes what you meant a second too late."
    "[aar] percebe o que você quis dizer um segundo tarde demais."

# game/scripts/c31/c31.rpy:3048
translate brazilian c31s005_AarPicksUp_2941fcf9:

    # mc "*Laugh* I meant exactly that, [aar]."
    mc "*Risos* Eu quis dizer exatamente isso, [aar]."

# game/scripts/c31/c31.rpy:3049
translate brazilian c31s005_AarPicksUp_26634e50:

    # mc "And [aar] doesn't think we're family because we share genes, {b}Aunt{/b} [bet]."
    mc "E o [aar] não acha que somos família porque compartilhamos genes, {b}Tia{/b} [bet]."

# game/scripts/c31/c31.rpy:3050
translate brazilian c31s005_AarPicksUp_0d5b86d1:

    # "You emphasize the 'Aunt' to make it clear that you are family."
    "Você enfatiza o 'Tia' para deixar claro que vocês são família."

# game/scripts/c31/c31.rpy:3051
translate brazilian c31s005_AarPicksUp_260cc0df:

    # bet "Nonsense!"
    bet "Bobagem!"

# game/scripts/c31/c31.rpy:3053
translate brazilian c31s005_AarPicksUp_c70c8356:

    # "It doesn't matter that you and [bet] don't share genes. You're family because you choose to be."
    "Não importa que você e [bet] não compartilhem genes. Vocês são família porque escolheram ser."

# game/scripts/c31/c31.rpy:3055
translate brazilian c31s005_AarPicksUp_d10156a2:

    # "You also hope that, by emphasizing the 'Aunt', [bet] won't say anything about you two being married also."
    "Você também espera que, ao enfatizar o 'Tia', [bet] não diga nada sobre vocês dois serem casados também."

# game/scripts/c31/c31.rpy:3056
translate brazilian c31s005_AarPicksUp_03b2ffbf:

    # "You don't want [aar]'s head to explode in the first ten minutes of meeting you. You wouldn't know how to get to the CEO's House. Maybe [ama] knows?"
    "Você não quer que a cabeça de [aar] exploda nos primeiros dez minutos de conhecê-lo. Você não saberia como chegar à Casa do CEO. Talvez [ama] saiba?"

# game/scripts/c31/c31.rpy:3058
translate brazilian c31s005_AarPicksUp_5a7d2b7d:

    # "After a few uncomfortable seconds for [aar], [bet] lets him go and takes a couple of steps back."
    "Após alguns segundos desconfortáveis para [aar], [bet] o solta e dá alguns passos para trás."

# game/scripts/c31/c31.rpy:3059
translate brazilian c31s005_AarPicksUp_a93bced7:

    # bet "Well, we've done the introductions. Next time I expect you to hug me back, [aar]."
    bet "Bem, já fizemos as apresentações. Na próxima vez, espero que você me abrace de volta, [aar]."

# game/scripts/c31/c31.rpy:3060
translate brazilian c31s005_AarPicksUp_547c8a1f:

    # mc "Let his brain start working again before demanding things for next time."
    mc "Deixe o cérebro dele voltar a funcionar antes de exigir coisas para a próxima vez."

# game/scripts/c31/c31.rpy:3062
translate brazilian c31s005_AarPicksUp_43cff04b:

    # aar "What? There's going to be a next time?"
    aar "O quê? Vai ter uma próxima vez?"

# game/scripts/c31/c31.rpy:3063
translate brazilian c31s005_AarPicksUp_f982b868:

    # "The tough mercenary looks ridiculous, made uncomfortable by an old woman's hugs."
    "O mercenário durão parece ridículo, desconfortável com os abraços de uma velha."

# game/scripts/c31/c31.rpy:3064
translate brazilian c31s005_AarPicksUp_81ba533a:

    # mc "*Laugh* You know nothing, [aar] Gilford."
    mc "*Risos* Você não sabe de nada, [aar] Gilford."

# game/scripts/c31/c31.rpy:3066
translate brazilian c31s005_AarPicksUp_22d58535:

    # ama "That's from a TV show, [aar]."
    ama "Isso é de um programa de TV, [aar]."

# game/scripts/c31/c31.rpy:3067
translate brazilian c31s005_AarPicksUp_1879d4b9:

    # ama "And yes. There are going to be a lot of next times. You'll get used to it."
    ama "E sim. Vai ter muitas próximas vezes. Você vai se acostumar."

# game/scripts/c31/c31.rpy:3068
translate brazilian c31s005_AarPicksUp_c0280c35:

    # ama "We Marks are a family of huggers. We Gilfords should learn a lot from the Marks."
    ama "Nós Marks somos uma família que gosta de abraços. Nós Gilfords deveríamos aprender muito com os Marks."

# game/scripts/c31/c31.rpy:3069
translate brazilian c31s005_AarPicksUp_12da8da0:

    # "You love that she includes herself in both families in a single line."
    "Você adora que ela se inclua em ambas as famílias em uma única frase."

# game/scripts/c31/c31.rpy:3070
translate brazilian c31s005_AarPicksUp_7943f579:

    # mc "And now I think we should go before [aar] has a stroke."
    mc "E agora acho que devíamos ir antes que o [aar] tenha um derrame."

# game/scripts/c31/c31.rpy:3072
translate brazilian c31s005_AarPicksUp_ab32aab2:

    # "After saying goodbye to [alb] and the pilots, you get into the limo and begin the journey to what will be your home for the next few months."
    "Depois de se despedir de [alb] e dos pilotos, você entra na limusine e começa a jornada para o que será sua casa pelos próximos meses."

# game/scripts/c31/c31.rpy:3073
translate brazilian c31s005_AarPicksUp_ea94d5cc:

    # "[aar] acts as chauffeur while [ama] sits next to him and explains everything that has happened since he returned to Aruba."
    "[aar] atua como motorista enquanto [ama] senta ao lado dele e explica tudo o que aconteceu desde que ele voltou para Aruba."

# game/scripts/c31/c31.rpy:3074
translate brazilian c31s005_AarPicksUp_af4c1341:

    # "The beautiful woman's words and excitement resonate in the empty streets, lighting up the night with her smile."
    "As palavras e a empolgação da bela mulher ressoam nas ruas vazias, iluminando a noite com seu sorriso."

# game/scripts/c31/c31.rpy:3075
translate brazilian c31s005_AarPicksUp_8f198eeb:

    # "She doesn't talk about missions or surveillance devices. She talks about family. She recounts laughter and hugs. She talks about the girls and Jamaal."
    "Ela não fala sobre missões ou dispositivos de vigilância. Ela fala sobre família. Ela relembra risadas e abraços. Ela fala sobre as garotas e o Jamaal."

# game/scripts/c31/c31.rpy:3077
translate brazilian c31s005_AarPicksUp_20404727:

    # "She talks about your wedding."
    "Ela fala sobre o seu casamento."

# game/scripts/c31/c31.rpy:3078
translate brazilian c31s005_AarPicksUp_9e5c9fc4:

    # "[bet] and you only intervene when [ama] leaves out some detail that you consider important."
    "[bet] e você só intervêm quando [ama] deixa de fora algum detalhe que vocês consideram importante."

# game/scripts/c31/c31.rpy:3079
translate brazilian c31s005_AarPicksUp_6ec8d16d:

    # "Neither of you wants to interrupt the excitement with which the blonde mercenary is explaining her new life."
    "Nenhum de vocês quer interromper a empolgação com que a mercenária loira está explicando sua nova vida."

# game/scripts/c31/c31.rpy:3080
translate brazilian c31s005_AarPicksUp_9943de76:

    # "The [ama] that almost broke your arm on the plane has disappeared again, although you know she's still in there."
    "A [ama] que quase quebrou seu braço no avião desapareceu de novo, embora você saiba que ela ainda está lá dentro."

# game/scripts/c31/c31.rpy:3081
translate brazilian c31s005_AarPicksUp_91095358:

    # "[aar] survives the trip without strokes or heart attacks. Barely."
    "[aar] sobrevive à viagem sem derrames ou ataques cardíacos. Por pouco."

# game/scripts/c31/c31.rpy:3082
translate brazilian c31s005_AarPicksUp_b69dc59d:

    # "Which is lucky. He's the one driving."
    "O que é uma sorte. É ele quem está dirigindo."

# game/scripts/c31/c31.rpy:3088
translate brazilian c31s005_houseArrival_de4378fb:

    # "You arrive at the CEO's House around 4 AM. There are a couple of cars in the garage, apart from the limo you arrived in."
    "Vocês chegam à Casa da CEO por volta das 4 da manhã. Há alguns carros na garagem, além da limusine em que vocês chegaram."

# game/scripts/c31/c31.rpy:3089
translate brazilian c31s005_houseArrival_0a13cb57:

    # "You had seen pictures of the interior, but something doesn't add up. What you've seen in the photos doesn't fit in that building."
    "Você tinha visto fotos do interior, mas algo não bate. O que você viu nas fotos não cabe naquele prédio."

# game/scripts/c31/c31.rpy:3091
translate brazilian c31s005_houseArrival_afcbb943:

    # bet "I thought it would be bigger..."
    bet "Achei que seria maior..."

# game/scripts/c31/c31.rpy:3092
translate brazilian c31s005_houseArrival_fc82af07:

    # bet "No offense, but it looks like a shack and a small building."
    bet "Sem ofensa, mas parece um barraco e um prédio pequeno."

# game/scripts/c31/c31.rpy:3093
translate brazilian c31s005_houseArrival_542448ce:

    # bet "Not that I'm complaining. The terrace on the shack looks impressive and I've lived in worse places."
    bet "Não que eu esteja reclamando. O terraço no barraco parece impressionante e eu já morei em lugares piores."

# game/scripts/c31/c31.rpy:3095
translate brazilian c31s005_houseArrival_0dd8e3b2:

    # aar "The official name is A House on the Cliff. There are two floors below what you see."
    aar "O nome oficial é Uma Casa no Penhasco. Há dois andares abaixo do que você vê."

# game/scripts/c31/c31.rpy:3096
translate brazilian c31s005_houseArrival_05359c75:

    # aar "This is just the kitchen, the living room, and the terrace. The bedrooms are on the next floor."
    aar "Isto é só a cozinha, a sala de estar e o terraço. Os quartos ficam no próximo andar."

# game/scripts/c31/c31.rpy:3097
translate brazilian c31s005_houseArrival_fda14927:

    # mc "And on the third floor?"
    mc "E no terceiro andar?"

# game/scripts/c31/c31.rpy:3099
translate brazilian c31s005_houseArrival_ee80499b:

    # aar "The panic room. Officially called The Bunker."
    aar "O quarto do pânico. Oficialmente chamado de O Bunker."

# game/scripts/c31/c31.rpy:3100
translate brazilian c31s005_houseArrival_0dca65a0:

    # aar "There are secure communications with the base from that room, in case of an attack or if the CEO wants to follow an operation from here."
    aar "Há comunicações seguras com a base a partir daquela sala, em caso de ataque ou se o CEO quiser acompanhar uma operação daqui."

# game/scripts/c31/c31.rpy:3101
translate brazilian c31s005_houseArrival_e46ec2b8:

    # aar "There's also a small armory and the surveillance room."
    aar "Também há um pequeno arsenal e a sala de vigilância."

# game/scripts/c31/c31.rpy:3102
translate brazilian c31s005_houseArrival_5809d825:

    # mc "Do we have security personnel?"
    mc "Temos pessoal de segurança?"

# game/scripts/c31/c31.rpy:3104
translate brazilian c31s005_houseArrival_42d4edcb:

    # ama "No. I told [aar] it wasn't necessary for tonight."
    ama "Não. Eu disse ao [aar] que não seria necessário para esta noite."

# game/scripts/c31/c31.rpy:3105
translate brazilian c31s005_houseArrival_6c1174f1:

    # ama "No one knows we were coming and the house has been empty for a few weeks, so we don't expect to need it."
    ama "Ninguém sabe que vínhamos e a casa esteve vazia por algumas semanas, então não esperamos precisar."

# game/scripts/c31/c31.rpy:3107
translate brazilian c31s005_houseArrival_d1515b34:

    # ama "Besides, I didn't want you to run into any operatives until we know what to expect from each of them."
    ama "Além disso, eu não queria que você topasse com nenhum agente até sabermos o que esperar de cada um deles."

# game/scripts/c31/c31.rpy:3108
translate brazilian c31s005_houseArrival_2af4d6d9:

    # mc "That sounds very smart."
    mc "Isso parece muito inteligente."

# game/scripts/c31/c31.rpy:3110
translate brazilian c31s005_houseArrival_178d9d9a:

    # aar "You should rest now. You're going to have a very long day tomorrow."
    aar "Você deveria descansar agora. Você vai ter um dia muito longo amanhã."

# game/scripts/c31/c31.rpy:3111
translate brazilian c31s005_houseArrival_4b98d4ab:

    # mc "I think you're right. See you tomorrow at the base?"
    mc "Acho que você tem razão. Vejo você amanhã na base?"

# game/scripts/c31/c31.rpy:3113
translate brazilian c31s005_houseArrival_a8133fae:

    # aar "Yeah, your first meeting is at 10 AM, with the department heads. I'll be there too."
    aar "Sim, sua primeira reunião é às 10h, com os chefes de departamento. Eu também estarei lá."

# game/scripts/c31/c31.rpy:3114
translate brazilian c31s005_houseArrival_f5044b8c:

    # aar "But before that, you're scheduled for a tour of the facilities, so you should be there around 8 AM."
    aar "Mas antes disso, você tem um tour agendado pelas instalações, então deve chegar lá por volta das 8h."

# game/scripts/c31/c31.rpy:3115
translate brazilian c31s005_houseArrival_0b03e858:

    # mc "Perfect. See you there then."
    mc "Perfeito. Te vejo lá então."

# game/scripts/c31/c31.rpy:3117
translate brazilian c31s005_houseArrival_9afeb654:

    # "Both [bet] and [ama] say goodbye to [aar] with a hug after he helps you bring the luggage into the kitchen."
    "Tanto [bet] quanto [ama] se despedem de [aar] com um abraço depois que ele ajuda você a trazer as malas para a cozinha."

# game/scripts/c31/c31.rpy:3118
translate brazilian c31s005_houseArrival_b45d2904:

    # "At this rate, he's going to get used to the Marks' hugs very quickly, even if he doesn't want to be part of the family."
    "Nesse ritmo, ele vai se acostumar com os abraços das Marks bem rápido, mesmo que não queira fazer parte da família."

# game/scripts/c31/c31.rpy:3119
translate brazilian c31s005_houseArrival_8fa90c79:

    # "All it will take is for [eva] and a couple more of the girls to come and hug him... He'll have no choice but to change his mind."
    "Tudo o que vai precisar é que [eva] e mais algumas das garotas venham e o abracem... Ele não terá escolha a não ser mudar de ideia."

# game/scripts/c31/c31.rpy:3120
translate brazilian c31s005_houseArrival_ca836ce4:

    # "In a weird way, he's your brother too."
    "De um jeito estranho, ele é seu irmão também."

# game/scripts/c31/c31.rpy:3121
translate brazilian c31s005_houseArrival_9540a212:

    # "He drives off in the limo. For a moment you thought he'd leave the limo and take the Humvee."
    "Ele vai embora na limusine. Por um momento você achou que ele deixaria a limusine e pegaria o Humvee."

# game/scripts/c31/c31.rpy:3124
translate brazilian c31s005_houseArrival_07d83ba2:

    # ama "I think we should go to sleep now. I'll show you your rooms."
    ama "Acho que devíamos ir dormir agora. Vou mostrar os quartos de vocês."

# game/scripts/c31/c31.rpy:3125
translate brazilian c31s005_houseArrival_cf2aa8fc:

    # mc "Have you been here before?"
    mc "Você já esteve aqui antes?"

# game/scripts/c31/c31.rpy:3127
translate brazilian c31s005_houseArrival_2f025de4:

    # ama "Never, but I know how to read a floor plan and I can guide you to the rooms [aar] has assigned you."
    ama "Nunca, mas eu sei ler uma planta baixa e posso guiar vocês até os quartos que [aar] designou."

# game/scripts/c31/c31.rpy:3128
translate brazilian c31s005_houseArrival_9c0fca5d:

    # ama "Neither Richards nor Daniels wanted us girls to be part of the mansion's security team."
    ama "Nem o Richards nem o Daniels queriam que nós, garotas, fizéssemos parte da equipe de segurança da mansão."

# game/scripts/c31/c31.rpy:3129
translate brazilian c31s005_houseArrival_0510d4a5:

    # mc "Was there a reason for that?"
    mc "Tinha algum motivo pra isso?"

# game/scripts/c31/c31.rpy:3131
translate brazilian c31s005_houseArrival_e926464f:

    # ama "They said we could do more interesting things than stare at a monitor."
    ama "Eles disseram que a gente podia fazer coisas mais interessantes do que ficar olhando pra um monitor."

# game/scripts/c31/c31.rpy:3132
translate brazilian c31s005_houseArrival_771f29b2:

    # mc "And they were right. Despite that, you've spent the last few months doing just that."
    mc "E eles tinham razão. Apesar disso, você passou os últimos meses fazendo exatamente isso."

# game/scripts/c31/c31.rpy:3134
translate brazilian c31s005_houseArrival_ae617da5:

    # ama "*Laugh* And if it weren't for [emm] and [kat]... well, and the rest of you... it would have been really boring."
    ama "*Risos* E se não fosse pela [emm] e pela [kat]... bom, e o resto de vocês... teria sido muito chato."

# game/scripts/c31/c31.rpy:3135
translate brazilian c31s005_houseArrival_48236755:

    # mc "I can't argue with that."
    mc "Não posso discordar disso."

# game/scripts/c31/c31.rpy:3137
translate brazilian c31s005_houseArrival_defe69fb:

    # bet "Guys, just a reminder that it's past 4. We need to get some sleep if we have to be at the base by 8 tomorrow."
    bet "Gente, só lembrando que já passa das 4. Precisamos dormir um pouco se tivermos que estar na base às 8 amanhã."

# game/scripts/c31/c31.rpy:3138
translate brazilian c31s005_houseArrival_337435f8:

    # mc "You're going to sleep more? You spent almost the whole flight sleeping!"
    mc "Você vai dormir mais? Você passou quase o voo inteiro dormindo!"

# game/scripts/c31/c31.rpy:3140
translate brazilian c31s005_houseArrival_ce05bbbe:

    # bet "*Laugh* At my age, a girl needs her beauty sleep."
    bet "*Risos* Na minha idade, uma garota precisa do seu sono de beleza."

# game/scripts/c31/c31.rpy:3142
translate brazilian c31s005_houseArrival_823cdb3f:

    # ama "Leave the big suitcases in the kitchen. We'll sort everything out tomorrow. It's too late to start unpacking today."
    ama "Deixem as malas grandes na cozinha. A gente resolve tudo amanhã. É muito tarde pra começar a desfazer as malas hoje."

# game/scripts/c31/c31.rpy:3143
translate brazilian c31s005_houseArrival_32d864f3:

    # ama "Grab the essentials for the night."
    ama "Peguem só o essencial pra noite."

# game/scripts/c31/c31.rpy:3144
translate brazilian c31s005_houseArrival_dbe078ec:

    # mc "My toiletry bag and not much else."
    mc "Minha necessaire e não muito mais."

# game/scripts/c31/c31.rpy:3146
translate brazilian c31s005_houseArrival_bc145742:

    # "[ama] walks [bet] to her room first, before showing you to yours."
    "[ama] acompanha [bet] até o quarto dela primeiro, antes de mostrar o seu."

# game/scripts/c31/c31.rpy:3147
translate brazilian c31s005_houseArrival_de7cc760:

    # "It's exactly like the photos you saw, with spectacular views of the Caribbean."
    "É exatamente como nas fotos que você viu, com vistas espetaculares do Caribe."

# game/scripts/c31/c31.rpy:3149
translate brazilian c31s005_houseArrival_97ff6797:

    # ama "This is the master bedroom. There's the restroom, and over there are the stairs down to the panic room."
    ama "Este é o quarto principal. Ali fica o banheiro, e logo ali estão as escadas que descem para a sala do pânico."

# game/scripts/c31/c31.rpy:3150
translate brazilian c31s005_houseArrival_dc2088e7:

    # mc "I hope I never have to use them."
    mc "Espero nunca ter que usá-las."

# game/scripts/c31/c31.rpy:3151
translate brazilian c31s005_houseArrival_afdf5be0:

    # ama "Me too. The house has never been attacked, so that room has only been used as a command and surveillance center."
    ama "Eu também. A casa nunca foi atacada, então aquela sala só foi usada como centro de comando e vigilância."

# game/scripts/c31/c31.rpy:3155
translate brazilian c31s005_houseArrival_d259401b:

    # ama "Good night, [mc]. I'll see you tomorrow... Or in about two and a half hours."
    ama "Boa noite, [mc]. Vejo você amanhã... Ou em umas duas horas e meia."

# game/scripts/c31/c31.rpy:3156
translate brazilian c31s005_houseArrival_47450581:

    # mc "Good night, sweetheart. Get some rest."
    mc "Boa noite, querida. Descanse um pouco."

# game/scripts/c31/c31.rpy:3158
translate brazilian c31s005_houseArrival_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."

# game/scripts/c31/c31.rpy:3160
translate brazilian c31s005_houseArrival_09360d88:

    # ama "Yes...?"
    ama "Sim...?"

# game/scripts/c31/c31.rpy:3161
translate brazilian c31s005_houseArrival_a17fb7e0:

    # mc "Are you going to be okay? If you want to stay the night, that bed is big."
    mc "Você vai ficar bem? Se quiser passar a noite, aquela cama é grande."

# game/scripts/c31/c31.rpy:3163
translate brazilian c31s005_houseArrival_016fcb47:

    # ama "Don't worry about me. I'll be fine. But thanks anyway."
    ama "Não se preocupe comigo. Eu vou ficar bem. Mas obrigada mesmo assim."

# game/scripts/c31/c31.rpy:3164
translate brazilian c31s005_houseArrival_0307e973:

    # mc "If you need me, you know where I live. *Laugh*"
    mc "Se precisar de mim, você sabe onde eu moro. *Risos*"

# game/scripts/c31/c31.rpy:3165
translate brazilian c31s005_houseArrival_5e0780c6:

    # ama "I'll keep that in mind. Get some rest."
    ama "Vou ter isso em mente. Descanse um pouco."

# game/scripts/c31/c31.rpy:3167
translate brazilian c31s005_houseArrival_d4e77122:

    # "You undress and freshen up. You leave your boxers on just in case one of the two women decides to make an appearance in the room."
    "Você se despe e se refresca. Você deixa sua cueca boxer caso uma das duas mulheres decida aparecer no quarto."

# game/scripts/c31/c31.rpy:3168
translate brazilian c31s005_houseArrival_fb690820:

    # "You're not sleepy after the time you spent sleeping on the plane."
    "Você não está com sono depois do tempo que passou dormindo no avião."

# game/scripts/c31/c31.rpy:3169
translate brazilian c31s005_houseArrival_45763d5d:

    # mcp "(Tomorrow is going to be an interesting day.)"
    mcp "(Amanhã vai ser um dia interessante.)"

# game/scripts/c31/c31.rpy:3171
translate brazilian c31s005_houseArrival_3b889a27:

    # "You pour yourself some pineapple juice and step out onto the room's balcony."
    "Você se serve de um pouco de suco de abacaxi e sai para a varanda do quarto."

# game/scripts/c31/c31.rpy:3172
translate brazilian c31s005_houseArrival_656c6488:

    # "The Caribbean shines beneath the stars."
    "O Caribe brilha sob as estrelas."

# game/scripts/c31/c31.rpy:3173
translate brazilian c31s005_houseArrival_88d83a1b:

    # "If you haven't lost your sense of direction, you figure this balcony faces East, so the sun will wake you up when it rises."
    "Se você não perdeu seu senso de direção, imagina que esta varanda fica de frente para o Leste, então o sol vai te acordar quando nascer."

# game/scripts/c31/c31.rpy:3175
translate brazilian c31s005_houseArrival_892927af:

    # "You can only imagine what the house would look like from a boat on the sea."
    "Você só consegue imaginar como a casa seria vista de um barco no mar."

# game/scripts/c31/c31.rpy:3176
translate brazilian c31s005_houseArrival_669c279f:

    # "It's probably just a dark mass against the starry sky right now. You'll have to see it during the day."
    "Provavelmente é apenas uma massa escura contra o céu estrelado agora. Você terá que ver durante o dia."

# game/scripts/c31/c31.rpy:3177
translate brazilian c31s005_houseArrival_c34fa20d:

    # mcp "(I should go to sleep. It wouldn't make a very good impression if the CEO fell asleep in the middle of meetings on his first day.)"
    mcp "(Eu devia ir dormir. Não causaria uma impressão muito boa se o CEO pegasse no sono no meio das reuniões no seu primeiro dia.)"

# game/scripts/c31/c31.rpy:3179
translate brazilian c31s005_houseArrival_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c31/c31.rpy:3180
translate brazilian c31s005_houseArrival_ab770f08:

    # "A knock snaps you out of your daydreams. Some habits never change, even if you change countries."
    "Uma batida na porta tira você dos seus devaneios. Alguns hábitos nunca mudam, mesmo que você mude de país."

# game/scripts/c31/c31.rpy:3181
translate brazilian c31s005_houseArrival_2ffbba0b:

    # ama "*Through the door* It's me. Can I come in?"
    ama "*Através da porta* Sou eu. Posso entrar?"

# game/scripts/c31/c31.rpy:3182
translate brazilian c31s005_houseArrival_3b55a4ab:

    # mc "Yes, come in."
    mc "Sim, pode entrar."

# game/scripts/c31/c31.rpy:3184
translate brazilian c31s005_houseArrival_0269f882:

    # mc "Did you forget something?"
    mc "Você esqueceu alguma coisa?"

# game/scripts/c31/c31.rpy:3185
translate brazilian c31s005_houseArrival_203fd4fe:

    # ama "To accept your offer to stay the night."
    ama "De aceitar sua oferta para passar a noite."

# game/scripts/c31/c31.rpy:3186
translate brazilian c31s005_houseArrival_98c81edc:

    # ama "I saw a light on your balcony and..."
    ama "Eu vi uma luz na sua varanda e..."

# game/scripts/c31/c31.rpy:3187
translate brazilian c31s005_houseArrival_6e83634c:

    # mc "You don't have to explain yourself for accepting an offer I made you."
    mc "Você não precisa se explicar por aceitar uma oferta que eu te fiz."

# game/scripts/c31/c31.rpy:3189
translate brazilian c31s005_houseArrival_5d454985:

    # ama "This is going to be really hard..."
    ama "Isso vai ser muito difícil..."

# game/scripts/c31/c31.rpy:3190
translate brazilian c31s005_houseArrival_96bd13db:

    # mc "Nothing we can't overcome together, [ama]."
    mc "Nada que não possamos superar juntos, [ama]."

# game/scripts/c31/c31.rpy:3191
translate brazilian c31s005_houseArrival_b5587787:

    # mc "And you survived [emm]'s room without gouging your eyes out."
    mc "E você sobreviveu ao quarto da [emm] sem arrancar os próprios olhos."

# game/scripts/c31/c31.rpy:3192
translate brazilian c31s005_houseArrival_06edb69f:

    # mc "I don't think a few clones will be able to defeat you."
    mc "Eu não acho que alguns clones vão ser capazes de te derrotar."

# game/scripts/c31/c31.rpy:3194
translate brazilian c31s005_houseArrival_f0ab3851:

    # ama "The problem isn't going to be the clones... Or at least they won't be the main problem."
    ama "O problema não vão ser os clones... Ou pelo menos eles não serão o problema principal."

# game/scripts/c31/c31.rpy:3195
translate brazilian c31s005_houseArrival_63f18179:

    # ama "I don't know how the rest of the staff will take the changes we want to make to the company."
    ama "Eu não sei como o resto da equipe vai aceitar as mudanças que queremos fazer na empresa."

# game/scripts/c31/c31.rpy:3196
translate brazilian c31s005_houseArrival_74d2ffe2:

    # mc "Me neither, but you know what?"
    mc "Nem eu, mas sabe de uma coisa?"

# game/scripts/c31/c31.rpy:3198
translate brazilian c31s005_houseArrival_e44310b5:

    # ama "What?"
    ama "O quê?"

# game/scripts/c31/c31.rpy:3199
translate brazilian c31s005_houseArrival_58c4108e:

    # mc "That's something we'll start figuring out tomorrow. Let's not worry about it today."
    mc "Isso é algo que vamos começar a descobrir amanhã. Não vamos nos preocupar com isso hoje."

# game/scripts/c31/c31.rpy:3201
translate brazilian c31s005_houseArrival_c1cd90f3:

    # mc "Today all I want is to sleep with my wife. Even if it's only for two and a half hours."
    mc "Hoje tudo que eu quero é dormir com a minha esposa. Mesmo que seja só por duas horas e meia."

# game/scripts/c31/c31.rpy:3203
translate brazilian c31s005_houseArrival_86ee3907:

    # ama "Two and a quarter hours. But it's just going to be sleeping..."
    ama "Duas horas e quinze. Mas vai ser só dormir mesmo..."

# game/scripts/c31/c31.rpy:3204
translate brazilian c31s005_houseArrival_214247f0:

    # mc "Yeah, don't worry. I don't want our first time to be like this, or so rushed."
    mc "É, não se preocupe. Eu não quero que nossa primeira vez seja assim, ou tão apressada."

# game/scripts/c31/c31.rpy:3205
translate brazilian c31s005_houseArrival_a73b2ab8:

    # mc "Besides, we're tired from the trip today."
    mc "Além disso, estamos cansados da viagem de hoje."

# game/scripts/c31/c31.rpy:3207
translate brazilian c31s005_houseArrival_69c786b7:

    # ama "You're right. And no. I'm not going to buy you that shirt."
    ama "Você tem razão. E não. Eu não vou comprar aquela camisa pra você."

# game/scripts/c31/c31.rpy:3208
translate brazilian c31s005_houseArrival_f7270242:

    # mc "*Laugh* I think I'll end up having to order it online."
    mc "*Risos* Acho que vou acabar tendo que pedir online."

# game/scripts/c31/c31.rpy:3212
translate brazilian c31s005_houseArrival_bd33b22a:

    # ama "Then, let's go to bed."
    ama "Então, vamos pra cama."

# game/scripts/c31/c31.rpy:3213
translate brazilian c31s005_houseArrival_c898a30c:

    # mc "After you."
    mc "Depois de você."

# game/scripts/c31/c31.rpy:3215
translate brazilian c31s005_houseArrival_28bd9c12:

    # ama "By the way... I heard you slept naked. I don't know whether to feel disappointed."
    ama "A propósito... ouvi dizer que você dormia pelado. Não sei se fico decepcionada."

# game/scripts/c31/c31.rpy:3216
translate brazilian c31s005_houseArrival_f826b8e1:

    # mc "That's something I can fix, if you want."
    mc "Isso é algo que eu posso dar um jeito, se você quiser."

# game/scripts/c31/c31.rpy:3217
translate brazilian c31s005_houseArrival_7ed56edc:

    # ama "*Laugh* I don't think I want to."
    ama "*Risos* Acho que não quero."

# game/scripts/c31/c31.rpy:3219
translate brazilian c31s005_houseArrival_f5187d42:

    # ama "At least, not today."
    ama "Pelo menos, não hoje."

# game/scripts/c31/c31.rpy:3220
translate brazilian c31s005_houseArrival_f4cc3d5f:

    # ama "Remember we had cameras in your room. I've already seen everything there is to see."
    ama "Lembre-se de que tínhamos câmeras no seu quarto. Eu já vi tudo o que tinha pra ver."

# game/scripts/c31/c31.rpy:3221
translate brazilian c31s005_houseArrival_f1c647f7:

    # mc "Changing the subject, I love the Zeus nightgown."
    mc "Mudando de assunto, eu adorei a camisola do Zeus."

# game/scripts/c31/c31.rpy:3222
translate brazilian c31s005_houseArrival_3fa66fd4:

    # ama "I bought it before I met him, so it was just a nightgown with a bunch of cats on it."
    ama "Eu comprei antes de conhecer ele, então era só uma camisola com um monte de gatos."

# game/scripts/c31/c31.rpy:3223
translate brazilian c31s005_houseArrival_ada77496:

    # mc "Are you going to take long to get into bed?"
    mc "Você vai demorar muito pra vir pra cama?"

# game/scripts/c31/c31.rpy:3224
translate brazilian c31s005_houseArrival_0a2c7118:

    # ama "No..."
    ama "Não..."

# game/scripts/c31/c31.rpy:3226
translate brazilian c31s005_houseArrival_5f11d045:

    # "Finally, [ama] decides to turn off the lights and get into bed with you."
    "Finalmente, [ama] decide apagar as luzes e deitar na cama com você."

# game/scripts/c31/c31.rpy:3227
translate brazilian c31s005_houseArrival_390ccea4:

    # "As soon as you settle into each other's arms, you fall asleep like dormice under the moonlight filtering through the large window."
    "Assim que vocês se ajeitam nos braços um do outro, vocês dormem como pedras sob a luz do luar que entra pela grande janela."

# game/scripts/c31/c31.rpy:3228
translate brazilian c31s005_houseArrival_1c43d281:

    # "The day has been longer than either of you expected, and exhaustion has taken its toll on you."
    "O dia foi mais longo do que qualquer um de vocês esperava, e a exaustão cobrou seu preço."

# game/scripts/c31/c31.rpy:3230
translate brazilian c31s005_houseArrival_f2ebf9cc:

    # "You sleep with your wife for the first time. Even if it's just for a little over two hours."
    "Você dorme com a sua esposa pela primeira vez. Mesmo que seja por pouco mais de duas horas."

# game/scripts/c31/c31.rpy:3231
translate brazilian c31s005_houseArrival_bdb3931a:

    # "You're going to have a month to sleep with her plenty of nights."
    "Você vai ter um mês para dormir com ela muitas noites."

# game/scripts/c31/c31.rpy:3236
translate brazilian c31s006_Caroline_1a10c5f8:

    # "After breakfast, [ama] drives you to the base. It's less than 30 minutes from the house."
    "Depois do café da manhã, [ama] te leva de carro até a base. Fica a menos de 30 minutos da casa."

# game/scripts/c31/c31.rpy:2451
translate brazilian c31s006_Caroline_020a6dc8:

    # "After breakfast, [ama] takes you to the base. It's less than 15 minutes from the house."
    "Depois do café da manhã, [ama] te leva até a base. Fica a menos de 15 minutos da casa."

# game/scripts/c31/c31.rpy:2452
translate brazilian c31s006_Caroline_36340068:

    # ama "Well, here we are. This is NTR's main base."
    ama "Bom, chegamos. Esta é a base principal da NTR."

# game/scripts/c31/c31.rpy:2453
translate brazilian c31s006_Caroline_b8d84426:

    # mc "It's impressive. Although it looks more like a factory than what you'd imagine a military base to be."
    mc "É impressionante. Embora pareça mais uma fábrica do que o que você imaginaria que fosse uma base militar."

# game/scripts/c31/c31.rpy:2455
translate brazilian c31s006_Caroline_e6d884d4:

    # bet "It has acted as a factory of clones, death, and misery for a long time."
    bet "Isso tem funcionado como uma fábrica de clones, morte e miséria por muito tempo."

# game/scripts/c31/c31.rpy:2456
translate brazilian c31s006_Caroline_1e4592a3:

    # mc "You're right..."
    mc "Você tem razão..."

# game/scripts/c31/c31.rpy:2458
translate brazilian c31s006_Caroline_0ac894ba:

    # ama "We're going to start the tour with the most important person you'll have to deal with in the coming months."
    ama "Vamos começar o tour com a pessoa mais importante com quem você terá que lidar nos próximos meses."

# game/scripts/c31/c31.rpy:2459
translate brazilian c31s006_Caroline_263e99ec:

    # mc "[mael], the Head of the Science Department? Or [vin], from Accounting? I thought we had a meeting with them later."
    mc "[mael], o Chefe do Departamento de Ciências? Ou [vin], da Contabilidade? Achei que tínhamos uma reunião com eles mais tarde."

# game/scripts/c31/c31.rpy:2461
translate brazilian c31s006_Caroline_7619f015:

    # ama "[car], your secretary."
    ama "[car], sua secretária."

# game/scripts/c31/c31.rpy:2462
translate brazilian c31s006_Caroline_27bb2658:

    # "That index finger pointing to the sky is such a Marks pose... You haven't been here a day and you're already missing the family."
    "Aquele dedo indicador apontando para o céu é tão a cara dos Marks... Você não está aqui nem há um dia e já está com saudades da família."

# game/scripts/c31/c31.rpy:2463
translate brazilian c31s006_Caroline_23850e58:

    # mc "I wasn't expecting that. I read her file... She was Daniels' secretary... And Richards' before him."
    mc "Eu não esperava por isso. Eu li a ficha dela... Ela era a secretária do Daniels... E do Richards antes dele."

# game/scripts/c31/c31.rpy:2464
translate brazilian c31s006_Caroline_ef968228:

    # mc "And Uncle Mike's. She's been here since the company moved to Aruba."
    mc "E do Tio Mike. Ela está aqui desde que a empresa se mudou para Aruba."

# game/scripts/c31/c31.rpy:2465
translate brazilian c31s006_Caroline_a78ce96d:

    # ama "She's loyal to the company, not the CEO of the moment. If you win her over, she'll be a great help to you."
    ama "Ela é leal à empresa, não ao CEO do momento. Se você conquistá-la, ela será de grande ajuda para você."

# game/scripts/c31/c31.rpy:2466
translate brazilian c31s006_Caroline_759e31a4:

    # ama "You won't be able to make this work without her help. She knows everything and everyone."
    ama "Você não vai conseguir fazer isso funcionar sem a ajuda dela. Ela conhece tudo e todos."

# game/scripts/c31/c31.rpy:2467
translate brazilian c31s006_Caroline_33ab9927:

    # ama "And don't let her looks fool you. She could chew bullets if she wanted to."
    ama "E não deixe a aparência dela te enganar. Ela poderia mastigar balas se quisesse."

# game/scripts/c31/c31.rpy:2469
translate brazilian c31s006_Caroline_237d6a3c:

    # bet "A secretary can make your life very easy or very difficult."
    bet "Uma secretária pode tornar sua vida muito fácil ou muito difícil."

# game/scripts/c31/c31.rpy:2470
translate brazilian c31s006_Caroline_7b639aef:

    # bet "I think [ama] is right that she should be the first person you meet."
    bet "Acho que a [ama] tem razão em dizer que ela deveria ser a primeira pessoa que você conhece."

# game/scripts/c31/c31.rpy:2471
translate brazilian c31s006_Caroline_3dc08b87:

    # bet "And remember, first impressions are important. Don't fuck it up."
    bet "E lembre-se, a primeira impressão é a que fica. Não foda tudo."

# game/scripts/c31/c31.rpy:2472
translate brazilian c31s006_Caroline_f02557ac:

    # mc "*Laughs* The confidence you place in me is reassuring."
    mc "*Risos* A confiança que você deposita em mim é reconfortante."

# game/scripts/c31/c31.rpy:2473
translate brazilian c31s006_Caroline_ff41ca5a:

    # mc "Let's go meet the fearsome [car]."
    mc "Vamos conhecer a temível [car]."

# game/scripts/c31/c31.rpy:2475
translate brazilian c31s006_Caroline_b8f4b2ad:

    # ama "Caroline, meet [mc] Marks. The new CEO."
    ama "Caroline, conheça [mc] Marks. O novo CEO."

# game/scripts/c31/c31.rpy:2476
translate brazilian c31s006_Caroline_f4df7136:

    # ama "[bet] Cavendish is also here, the surgeon who's going to operate on [gav]."
    ama "A [bet] Cavendish também está aqui, a cirurgiã que vai operar o [gav]."

# game/scripts/c31/c31.rpy:2477
translate brazilian c31s006_Caroline_2e8abe0d:

    # car "Nice to meet you. I hope the house was to your liking, Mr. Marks."
    car "Prazer em conhecê-lo. Espero que a casa tenha sido do seu agrado, Sr. Marks."

# game/scripts/c31/c31.rpy:2478
translate brazilian c31s006_Caroline_d982c5ca:

    # mc "Likewise, [car]."
    mc "O prazer é meu, [car]."

# game/scripts/c31/c31.rpy:2479
translate brazilian c31s006_Caroline_05f1df77:

    # mc "The house is impressive, thank you."
    mc "A casa é impressionante, obrigado."

# game/scripts/c31/c31.rpy:2481
translate brazilian c31s006_Caroline_a543b3ea:

    # car "You have a tight schedule today, Mr. Marks."
    car "O senhor tem uma agenda apertada hoje, Sr. Marks."

# game/scripts/c31/c31.rpy:2482
translate brazilian c31s006_Caroline_86007264:

    # mc "Call me [mc], please."
    mc "Me chame de [mc], por favor."

# game/scripts/c31/c31.rpy:2483
translate brazilian c31s006_Caroline_4046077a:

    # car "First up is the sightseeing tour of the main base facilities."
    car "Primeiro, temos o passeio turístico pelas instalações da base principal."

# game/scripts/c31/c31.rpy:2485
translate brazilian c31s006_Caroline_aa575e46:

    # bet "*Laughs* The 'sightseeing tour' part sounded funny, [car]."
    bet "*Risos* A parte do 'passeio turístico' soou engraçada, [car]."

# game/scripts/c31/c31.rpy:2487
translate brazilian c31s006_Caroline_f114ee19:

    # car "It's the first time we've had to show the facilities to a CEO. Until now, previous CEOs had risen through the ranks of the company."
    car "É a primeira vez que temos que mostrar as instalações para um CEO. Até agora, os CEOs anteriores tinham subido na hierarquia da empresa."

# game/scripts/c31/c31.rpy:2488
translate brazilian c31s006_Caroline_2210dd78:

    # car "They had earned the right to be here after years of service."
    car "Eles conquistaram o direito de estar aqui depois de anos de serviço."

# game/scripts/c31/c31.rpy:2489
translate brazilian c31s006_Caroline_1bf6c3c8:

    # mc "I hope I can earn that right."
    mc "Espero poder conquistar esse direito."

# game/scripts/c31/c31.rpy:2491
translate brazilian c31s006_Caroline_eae358d5:

    # car "I hope so too, Mr. Marks."
    car "Eu também espero, Sr. Marks."

# game/scripts/c31/c31.rpy:2492
translate brazilian c31s006_Caroline_e2a2531e:

    # car "There's been a problem with David, the operative who was supposed to give you the tour."
    car "Houve um problema com o David, o agente que deveria te dar o tour."

# game/scripts/c31/c31.rpy:2494
translate brazilian c31s006_Caroline_2c93df91:

    # ama "Is he okay?"
    ama "Ele está bem?"

# game/scripts/c31/c31.rpy:2495
translate brazilian c31s006_Caroline_ad909581:

    # car "Just a sprained ankle. I'm waiting for [aar] to tell me who's going to replace him for the tour."
    car "Só torceu o tornozelo. Estou esperando o [aar] me dizer quem vai substituí-lo no tour."

# game/scripts/c31/c31.rpy:2497
translate brazilian c31s006_Caroline_232d656f:

    # ama "Don't worry about that. Tell [aar] that I'll show [mc] around the base."
    ama "Não se preocupe com isso. Diga ao [aar] que eu vou mostrar a base para o [mc]."

# game/scripts/c31/c31.rpy:2498
translate brazilian c31s006_Caroline_d5aa9e6d:

    # car "Sounds like a good solution. If we have to wait for [aar], we'd probably have to cut the tour short."
    car "Parece uma boa solução. Se tivermos que esperar pelo [aar], provavelmente teríamos que encurtar o tour."

# game/scripts/c31/c31.rpy:2499
translate brazilian c31s006_Caroline_720cfcd9:

    # mc "So that's one problem solved. Anything else?"
    mc "Então esse é um problema resolvido. Mais alguma coisa?"

# game/scripts/c31/c31.rpy:2501
translate brazilian c31s006_Caroline_9d99232a:

    # car "After the tour, you have the meeting with the department heads. In two hours."
    car "Depois do tour, você tem a reunião com os chefes de departamento. Em duas horas."

# game/scripts/c31/c31.rpy:2502
translate brazilian c31s006_Caroline_287f1372:

    # mc "Sweet, [car]."
    mc "Beleza, [car]."

# game/scripts/c31/c31.rpy:2505
translate brazilian c31s006_Caroline_fa033f4c:

    # bet "Bam Bam Baa."
    bet "Bam Bam Baa."

# game/scripts/c31/c31.rpy:2507
translate brazilian c31s006_Caroline_ebfa80d0:

    # car "..."
    car "..."

# game/scripts/c31/c31.rpy:2509
translate brazilian c31s006_Caroline_103e00b6:

    # car "After that, you have a meeting with IT Support, where they'll give you a brief training on the company's software."
    car "Depois disso, você tem uma reunião com o Suporte de TI, onde eles vão te dar um breve treinamento sobre o software da empresa."

# game/scripts/c31/c31.rpy:2510
translate brazilian c31s006_Caroline_0b829346:

    # car "And, whenever you have a moment, I need to give you the Employee Handbook, where you'll find all the information you need."
    car "E, sempre que tiver um momento, preciso te entregar o Manual do Funcionário, onde você encontrará todas as informações que precisa."

# game/scripts/c31/c31.rpy:2511
translate brazilian c31s006_Caroline_9f74374e:

    # car "I've left enough time between both meetings so you won't be stressed for time on your first day."
    car "Deixei tempo suficiente entre as duas reuniões para que você não fique estressado com o tempo no seu primeiro dia."

# game/scripts/c31/c31.rpy:2512
translate brazilian c31s006_Caroline_da378e55:

    # mc "Thanks, [car]."
    mc "Valeu, [car]."

# game/scripts/c31/c31.rpy:2516
translate brazilian c31s006_Caroline_9402cb80:

    # car "In the afternoon, you have a meeting with [aar]. He will give you an {b}{u}exhaustive{/u}{/b} report on his management these past few days."
    car "À tarde, você tem uma reunião com o [aar]. Ele vai te dar um relatório {b}{u}exaustivo{/u}{/b} sobre a gestão dele nesses últimos dias."

# game/scripts/c31/c31.rpy:2517
translate brazilian c31s006_Caroline_76404822:

    # mc "That sounds like you've suffered through [aar]'s reports too."
    mc "Parece que você também sofreu com os relatórios do [aar]."

# game/scripts/c31/c31.rpy:2519
translate brazilian c31s006_Caroline_49687396:

    # car "Executive reports should be concise, Mr. Marks."
    car "Relatórios executivos devem ser concisos, Sr. Marks."

# game/scripts/c31/c31.rpy:2520
translate brazilian c31s006_Caroline_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c31/c31.rpy:2521
translate brazilian c31s006_Caroline_4725d612:

    # car "You're not going to have time to worry about whether the ammo stock will last nine months and two days or only nine months."
    car "Você não vai ter tempo para se preocupar se o estoque de munição vai durar nove meses e dois dias ou apenas nove meses."

# game/scripts/c31/c31.rpy:2522
translate brazilian c31s006_Caroline_7f36e1a2:

    # mc "I agree."
    mc "Eu concordo."

# game/scripts/c31/c31.rpy:2524
translate brazilian c31s006_Caroline_d8af4fd3:

    # car "You should leave now if you don't want to cut the visit short. We'll talk later when the first meeting is over."
    car "Você deveria ir agora se não quiser encurtar a visita. Conversaremos mais tarde quando a primeira reunião acabar."

# game/scripts/c31/c31.rpy:2525
translate brazilian c31s006_Caroline_b3b3c37a:

    # mc "Perfect, [car]."
    mc "Perfeito, [car]."

# game/scripts/c31/c31.rpy:2527
translate brazilian c31s006_Caroline_4f14db7a:

    # mc "[bet], I think you forgot about the first impression thing."
    mc "[bet], acho que você esqueceu daquela história de primeira impressão."

# game/scripts/c31/c31.rpy:2528
translate brazilian c31s006_Caroline_17051cf0:

    # bet "I didn't forget. But ever since I heard her name, I've had that song stuck in my head."
    bet "Eu não esqueci. Mas desde que ouvi o nome dela, fiquei com aquela música na cabeça."

# game/scripts/c31/c31.rpy:2529
translate brazilian c31s006_Caroline_568bf98f:

    # bet "And if she focuses on the CEO's eccentric aunt, you'll look better by comparison."
    bet "E se ela focar na tia excêntrica do CEO, você vai parecer melhor em comparação."

# game/scripts/c31/c31.rpy:2530
translate brazilian c31s006_Caroline_941197f0:

    # ama "I don't know what song you're talking about, nor did I understand your gesture, Aunt [bet]."
    ama "Não sei de que música você está falando, nem entendi o seu gesto, Tia [bet]."

# game/scripts/c31/c31.rpy:2532
translate brazilian c31s006_Caroline_1b5e90ca:

    # bet "We need to start working on your musical education, my girl. It's a classic from '69!"
    bet "Precisamos começar a trabalhar na sua educação musical, garota. É um clássico de 69!"

# game/scripts/c31/c31.rpy:2533
translate brazilian c31s006_Caroline_7d262a9a:

    # ama "There will be time for that later. We should start the tour now."
    ama "Vai ter tempo pra isso depois. Devemos começar o tour agora."

# game/scripts/c31/c31.rpy:2534
translate brazilian c31s006_Caroline_4f9d9d29:

    # mc "Whenever you're ready. I think I would've gotten lost a couple of times by now."
    mc "Quando estiver pronta. Acho que eu já teria me perdido algumas vezes a essa altura."

# game/scripts/c31/c31.rpy:3136
translate brazilian c31s006_baseArrival_a0b85b73:

    # ama "This way. I'll try not to overwhelm you, but there's a lot to see."
    ama "Por aqui. Vou tentar não te sobrecarregar, mas tem muita coisa pra ver."

# game/scripts/c31/c31.rpy:3137
translate brazilian c31s006_baseArrival_4bb2aef5:

    # mc "Don't worry. I prefer to see everything at once and get a real feel for the place."
    mc "Não se preocupe. Prefiro ver tudo de uma vez e ter uma noção real do lugar."

# game/scripts/c31/c31.rpy:3138
translate brazilian c31s006_baseArrival_0c5b78d4:

    # ama "As you wish. Let's start with the troop dorms."
    ama "Como quiser. Vamos começar pelos dormitórios das tropas."

# game/scripts/c31/c31.rpy:3141
translate brazilian c31s006_baseArrival_c5972219:

    # ama "The operatives sleep here. Bunk beds, individual lockers, common area at the back."
    ama "Os agentes dormem aqui. Beliches, armários individuais, área comum nos fundos."

# game/scripts/c31/c31.rpy:3142
translate brazilian c31s006_baseArrival_744b9b50:

    # mc "It's... functional."
    mc "É... funcional."

# game/scripts/c31/c31.rpy:3144
translate brazilian c31s006_baseArrival_10e00322:

    # ama "That's the nicest thing you could say about it."
    ama "Essa é a coisa mais gentil que você poderia dizer sobre isso."

# game/scripts/c31/c31.rpy:3145
translate brazilian c31s006_baseArrival_214be116:

    # mc "How many share a room?"
    mc "Quantos dividem um quarto?"

# game/scripts/c31/c31.rpy:3147
translate brazilian c31s006_baseArrival_d9244d75:

    # ama "Sixteen per module. There are six modules in this block. There are six blocks."
    ama "Dezesseis por módulo. Tem seis módulos neste bloco. E são seis blocos."

# game/scripts/c31/c31.rpy:3148
translate brazilian c31s006_baseArrival_620f54f4:

    # mc "And this hasn't changed in years?"
    mc "E isso não mudou em anos?"

# game/scripts/c31/c31.rpy:3149
translate brazilian c31s006_baseArrival_aa62e8ee:

    # ama "No. The previous management saw no reason to improve what they considered sufficient."
    ama "Não. A gerência anterior não via motivo para melhorar o que consideravam suficiente."

# game/scripts/c31/c31.rpy:3150
translate brazilian c31s006_baseArrival_f985dcb7:

    # mc "Well, I do."
    mc "Bom, eu vejo."

# game/scripts/c31/c31.rpy:3152
translate brazilian c31s006_baseArrival_af45e037:

    # ama "I know."
    ama "Eu sei."

# game/scripts/c31/c31.rpy:3150
translate brazilian c31s006_baseArrival_1f2a88c0:

    # mc "Did you grow up here?"
    mc "Você cresceu aqui?"

# game/scripts/c31/c31.rpy:3152
translate brazilian c31s006_baseArrival_a216b640:

    # ama "In a smaller module, just for the girls. It's basically the same, but our common area is bigger."
    ama "Em um módulo menor, só para as garotas. É basicamente a mesma coisa, mas nossa área comum é maior."

# game/scripts/c31/c31.rpy:3153
translate brazilian c31s006_baseArrival_e71c5eb9:

    # ama "We had to specialize in more things, so we had to train with different devices."
    ama "Tínhamos que nos especializar em mais coisas, então precisávamos treinar com dispositivos diferentes."

# game/scripts/c31/c31.rpy:3154
translate brazilian c31s006_baseArrival_d56b9c53:

    # mc "I get it."
    mc "Entendi."

# game/scripts/c31/c31.rpy:3154
translate brazilian c31s006_baseArrival_db787fdc:

    # bet "I'd say it smells like a gym locker room, but I don't want to be cruel... with gym locker rooms."
    bet "Eu diria que tem cheiro de vestiário de academia, mas não quero ser cruel... com os vestiários de academia."

# game/scripts/c31/c31.rpy:3155
translate brazilian c31s006_baseArrival_460a30af:

    # mc "You notice it too?"
    mc "Você também percebeu?"

# game/scripts/c31/c31.rpy:3156
translate brazilian c31s006_baseArrival_2318742c:

    # bet "I've been here five minutes and I'm already getting used to it. That's scarier."
    bet "Estou aqui há cinco minutos e já estou me acostumando. Isso é o mais assustador."

# game/scripts/c31/c31.rpy:3158
translate brazilian c31s006_baseArrival_7bead8a2:

    # ama "Poor ventilation. It's been on the pending renovations list for two years."
    ama "Ventilação ruim. Está na lista de reformas pendentes há dois anos."

# game/scripts/c31/c31.rpy:3159
translate brazilian c31s006_baseArrival_fc784a98:

    # mc "Let me know when it moves to the top of that list."
    mc "Me avise quando for pro topo dessa lista."

# game/scripts/c31/c31.rpy:3160
translate brazilian c31s006_baseArrival_53dd844a:

    # ama "Noted. Let's continue the visit."
    ama "Anotado. Vamos continuar a visita."

# game/scripts/c31/c31.rpy:3163
translate brazilian c31s006_baseArrival_d4e96205:

    # ama "Main laboratory. Analysis, protocol development, applied research."
    ama "Laboratório principal. Análise, desenvolvimento de protocolos, pesquisa aplicada."

# game/scripts/c31/c31.rpy:3164
translate brazilian c31s006_baseArrival_772f75f4:

    # mc "Applied to what exactly?"
    mc "Aplicada a quê exatamente?"

# game/scripts/c31/c31.rpy:3165
translate brazilian c31s006_baseArrival_8591b7a4:

    # ama "Physical performance enhancements, recovery treatments, field adaptations."
    ama "Melhorias de desempenho físico, tratamentos de recuperação, adaptações de campo."

# game/scripts/c31/c31.rpy:3166
translate brazilian c31s006_baseArrival_c102562d:

    # ama "And, obviously, improvements in cloning protocols."
    ama "E, obviamente, melhorias nos protocolos de clonagem."

# game/scripts/c31/c31.rpy:3168
translate brazilian c31s006_baseArrival_3a86785f:

    # bet "This place is going to be a treat for [dap] and [sca]..."
    bet "Esse lugar vai ser um prato cheio pra [dap] e pra [sca]..."

# game/scripts/c31/c31.rpy:3169
translate brazilian c31s006_baseArrival_48cc3e9a:

    # mc "I don't understand what half the things I'm seeing are, but it all looks high-tech."
    mc "Eu não entendo o que é metade das coisas que tô vendo, mas tudo parece de alta tecnologia."

# game/scripts/c31/c31.rpy:3171
translate brazilian c31s006_baseArrival_fe823e67:

    # ama "[mael], the head of the Science Department, has very refined tastes when it comes to ordering equipment."
    ama "O [mael], chefe do Departamento de Ciências, tem gostos muito refinados quando se trata de encomendar equipamentos."

# game/scripts/c31/c31.rpy:3172
translate brazilian c31s006_baseArrival_f349d67a:

    # ama "And the most interesting part is what has been developed here, as proprietary technology."
    ama "E a parte mais interessante é o que foi desenvolvido aqui, como tecnologia proprietária."

# game/scripts/c31/c31.rpy:3173
translate brazilian c31s006_baseArrival_4c9e2cef:

    # mc "That could be the cornerstone of what we want to do for the company's change in direction."
    mc "Isso pode ser o pilar do que queremos fazer para a mudança de direção da empresa."

# game/scripts/c31/c31.rpy:3175
translate brazilian c31s006_baseArrival_4811af7c:

    # ama "I think we have a good foundation to start growing, but it will be clearer to you in the meeting in a little while."
    ama "Acho que temos uma boa base para começar a crescer, mas isso vai ficar mais claro para você na reunião daqui a pouco."

# game/scripts/c31/c31.rpy:3176
translate brazilian c31s006_baseArrival_eb9629cd:

    # mc "Was all this operational before I got the job?"
    mc "Tudo isso estava operacional antes de eu conseguir o cargo?"

# game/scripts/c31/c31.rpy:3177
translate brazilian c31s006_baseArrival_8be0bdfa:

    # ama "The lab, yes. Although some projects were put on hold with the change in management."
    ama "O laboratório, sim. Embora alguns projetos tenham sido suspensos com a mudança na gerência."

# game/scripts/c31/c31.rpy:3178
translate brazilian c31s006_baseArrival_276a0d79:

    # mc "Which ones?"
    mc "Quais?"

# game/scripts/c31/c31.rpy:3180
translate brazilian c31s006_baseArrival_1d155b77:

    # ama "The ones that weren't profitable in the short term. Which coincidentally were the most interesting."
    ama "Os que não eram lucrativos a curto prazo. Que, por coincidência, eram os mais interessantes."

# game/scripts/c31/c31.rpy:3181
translate brazilian c31s006_baseArrival_5feeb067:

    # mc "Can I see what was put on hold?"
    mc "Posso ver o que foi suspenso?"

# game/scripts/c31/c31.rpy:3182
translate brazilian c31s006_baseArrival_6b7fdc17:

    # ama "I'll prepare a report for you. But let's keep moving for now."
    ama "Vou preparar um relatório para você. Mas vamos continuar andando por enquanto."

# game/scripts/c31/c31.rpy:3184
translate brazilian c31s006_baseArrival_30a04035:

    # mc "Is no one working?"
    mc "Ninguém está trabalhando?"

# game/scripts/c31/c31.rpy:3185
translate brazilian c31s006_baseArrival_b2e407c2:

    # ama "I think there are several team meetings going on, where they're finalizing the information they'll present to you shortly."
    ama "Acho que há várias reuniões de equipe acontecendo, onde estão finalizando as informações que vão apresentar a você em breve."

# game/scripts/c31/c31.rpy:3186
translate brazilian c31s006_baseArrival_8c0b8827:

    # ama "I get the feeling no one wanted to run into you before that meeting."
    ama "Tenho a sensação de que ninguém queria esbarrar com você antes dessa reunião."

# game/scripts/c31/c31.rpy:3187
translate brazilian c31s006_baseArrival_3fac017b:

    # mc "I understand."
    mc "Eu entendo."

# game/scripts/c31/c31.rpy:3190
translate brazilian c31s006_baseArrival_18890a76:

    # ama "Cloning Room 1."
    ama "Sala de Clonagem 1."

# game/scripts/c31/c31.rpy:3193
translate brazilian c31s006_baseArrival_437a7119:

    # mc "For God's sake!"
    mc "Pelo amor de Deus!"

# game/scripts/c31/c31.rpy:3191
translate brazilian c31s006_baseArrival_0a835d55:

    # mc "For God's sake!"
    mc "Pelo amor de Deus!"

# game/scripts/c31/c31.rpy:3194
translate brazilian c31s006_baseArrival_61ec9ea1:

    # ama "Yeah. [eva] and I were born in there."
    ama "É. A [eva] e eu nascemos aí dentro."

# game/scripts/c31/c31.rpy:3196
translate brazilian c31s006_baseArrival_b55592fd:

    # ama "Yes. [eri], [dap], and [emm] were born in there."
    ama "Sim. A [eri], a [dap] e a [emm] nasceram aí dentro."

# game/scripts/c31/c31.rpy:3197
translate brazilian c31s006_baseArrival_6109e69f:

    # ama "I haven't been here in years..."
    ama "Eu não venho aqui há anos..."

# game/scripts/c31/c31.rpy:3201
translate brazilian c31s006_baseArrival_a1060dd4:

    # "You feel tempted to hug the mercenary, but the emotional weight in her voice tells you it's not the best time."
    "Você se sente tentado a abraçar a mercenária, mas o peso emocional na voz dela diz que não é o melhor momento."

# game/scripts/c31/c31.rpy:3203
translate brazilian c31s006_baseArrival_874cb6b0:

    # "The emotional weight in her voice tells you that, even though she wasn't born in this room, it's not a pleasant place for her."
    "O peso emocional na voz dela diz que, mesmo ela não tendo nascido nesta sala, não é um lugar agradável para ela."

# game/scripts/c31/c31.rpy:3198
translate brazilian c31s006_baseArrival_6c0f2e3f:

    # mc "Is it still active?"
    mc "Ainda está ativa?"

# game/scripts/c31/c31.rpy:3200
translate brazilian c31s006_baseArrival_f0d573c0:

    # ama "Yes, all the cloning tubes are full. [mael] can give you the details on them."
    ama "Sim, todos os tubos de clonagem estão cheios. O [mael] pode te dar os detalhes sobre eles."

# game/scripts/c31/c31.rpy:3201
translate brazilian c31s006_baseArrival_df3eb5ca:

    # ama "I'm not going to give you the numbers right now."
    ama "Não vou te dar os números agora."

# game/scripts/c31/c31.rpy:3202
translate brazilian c31s006_baseArrival_442d7fdf:

    # mc "Why not?"
    mc "Por que não?"

# game/scripts/c31/c31.rpy:3204
translate brazilian c31s006_baseArrival_4b72efc3:

    # ama "Because we're on a tour and I prefer you go into today's meeting with a clear head."
    ama "Porque estamos em um tour e prefiro que você vá para a reunião de hoje com a cabeça fria."

# game/scripts/c31/c31.rpy:3206
translate brazilian c31s006_baseArrival_973dfa6e:

    # bet "It's her way of saying they're impressive numbers."
    bet "É o jeito dela de dizer que são números impressionantes."

# game/scripts/c31/c31.rpy:3207
translate brazilian c31s006_baseArrival_bf29b46d:

    # mc "Are they?"
    mc "E são?"

# game/scripts/c31/c31.rpy:3208
translate brazilian c31s006_baseArrival_ce891c2e:

    # bet "Very. I've been talking to [mael] these past few days."
    bet "Muito. Eu estive conversando com o [mael] nesses últimos dias."

# game/scripts/c31/c31.rpy:3210
translate brazilian c31s006_baseArrival_41618d42:

    # mc "What do we do with all this? With the room, with the equipment?"
    mc "O que a gente faz com tudo isso? Com a sala, com o equipamento?"

# game/scripts/c31/c31.rpy:3211
translate brazilian c31s006_baseArrival_5d21dd38:

    # ama "That's exactly the kind of question we need you to ask at the meeting. And answer it."
    ama "Esse é exatamente o tipo de pergunta que precisamos que você faça na reunião. E que responda."

# game/scripts/c31/c31.rpy:3212
translate brazilian c31s006_baseArrival_e6326af3:

    # mc "I don't have an answer yet."
    mc "Eu ainda não tenho uma resposta."

# game/scripts/c31/c31.rpy:3213
translate brazilian c31s006_baseArrival_76b508e2:

    # ama "You don't need one today."
    ama "Você não precisa de uma hoje."

# game/scripts/c31/c31.rpy:3215
translate brazilian c31s006_baseArrival_3a77c5a2:

    # mc "Can we go in? [bet] is going to smash her nose against the glass..."
    mc "Podemos entrar? A [bet] vai esmagar o nariz no vidro..."

# game/scripts/c31/c31.rpy:3216
translate brazilian c31s006_baseArrival_5bc34429:

    # ama "Not in street clothes. We have to wear protective suits and go through a decontamination process first."
    ama "Não com roupas normais. Temos que usar trajes de proteção e passar por um processo de descontaminação primeiro."

# game/scripts/c31/c31.rpy:3223
translate brazilian c31s006_baseArrival_714d05fb:

    # ama "You enter from the back. This door is only used when there's no cloning process underway and the room doesn't need to be sterile."
    ama "Você entra pelos fundos. Esta porta só é usada quando não há nenhum processo de clonagem em andamento e a sala não precisa estar estéril."

# game/scripts/c31/c31.rpy:3217
translate brazilian c31s006_baseArrival_19e1bb29:

    # mc "Makes sense."
    mc "Faz sentido."

# game/scripts/c31/c31.rpy:3219
translate brazilian c31s006_baseArrival_77840939:

    # bet "Some things take time to process. I think this is one of them."
    bet "Algumas coisas levam tempo para processar. Acho que essa é uma delas."

# game/scripts/c31/c31.rpy:3220
translate brazilian c31s006_baseArrival_feaf16a6:

    # mc "How are you holding up? It's giving me the creeps."
    mc "Como você está lidando com isso? Isso está me dando arrepios."

# game/scripts/c31/c31.rpy:3221
translate brazilian c31s006_baseArrival_7bccaec0:

    # bet "I'm going to focus on being useful. On doing what I know how to do."
    bet "Vou me concentrar em ser útil. Em fazer o que sei fazer."

# game/scripts/c31/c31.rpy:3226
translate brazilian c31s006_baseArrival_c407e765:

    # bet "There are things that take time to digest. I think this room is one of them."
    bet "Tem coisas que levam tempo para digerir. Acho que essa sala é uma delas."

# game/scripts/c31/c31.rpy:3229
translate brazilian c31s006_baseArrival_801f91e4:

    # bet "I'm not going to judge what was done here previously. I'll judge if it doesn't stop."
    bet "Não vou julgar o que foi feito aqui antes. Vou julgar se isso não parar."

# game/scripts/c31/c31.rpy:3224
translate brazilian c31s006_baseArrival_5606b665:

    # ama "Medical facilities. Operating rooms, recovery, and consultation rooms."
    ama "Instalações médicas. Salas de cirurgia, recuperação e consultórios."

# game/scripts/c31/c31.rpy:3225
translate brazilian c31s006_baseArrival_54346d53:

    # mc "Impressive. It's bigger than I expected."
    mc "Impressionante. É maior do que eu esperava."

# game/scripts/c31/c31.rpy:3227
translate brazilian c31s006_baseArrival_cf26a2dc:

    # bet "I suppose a small hospital is needed in a place like this."
    bet "Suponho que um pequeno hospital seja necessário num lugar como este."

# game/scripts/c31/c31.rpy:3228
translate brazilian c31s006_baseArrival_ba9d6eb4:

    # bet "I imagine the injuries can be quite diverse, knowing what the company does."
    bet "Imagino que os ferimentos possam ser bem diversos, sabendo o que a empresa faz."

# game/scripts/c31/c31.rpy:3230
translate brazilian c31s006_baseArrival_20b85ec0:

    # ama "Diverse is a very diplomatic word."
    ama "Diverso é uma palavra bem diplomática."

# game/scripts/c31/c31.rpy:3232
translate brazilian c31s006_baseArrival_c15af9f7:

    # bet "I'm a doctor. Diplomacy is part of the job."
    bet "Eu sou médica. Diplomacia faz parte do trabalho."

# game/scripts/c31/c31.rpy:3233
translate brazilian c31s006_baseArrival_460bdb97:

    # mc "How many recovery beds are there?"
    mc "Quantos leitos de recuperação tem aqui?"

# game/scripts/c31/c31.rpy:3235
translate brazilian c31s006_baseArrival_1f28ec2e:

    # ama "Twenty-four. Although we've had more occupancy than desirable."
    ama "Vinte e quatro. Embora a gente tenha tido mais ocupação do que o desejável."

# game/scripts/c31/c31.rpy:3236
translate brazilian c31s006_baseArrival_716f5230:

    # mc "And right now?"
    mc "E agora mesmo?"

# game/scripts/c31/c31.rpy:3238
translate brazilian c31s006_baseArrival_93a1d949:

    # ama "Nine patients, from what I've read. Ranging from a flu to... [gav] and several wounded from the Clone War."
    ama "Nove pacientes, pelo que eu li. Variando de uma gripe até... [gav] e vários feridos da Guerra dos Clones."

# game/scripts/c31/c31.rpy:3239
translate brazilian c31s006_baseArrival_7c29365d:

    # mc "Is [gav] still here?"
    mc "O [gav] ainda tá aqui?"

# game/scripts/c31/c31.rpy:3241
translate brazilian c31s006_baseArrival_d9d3c8b1:

    # bet "After talking to him, I thought it would be best if he stayed in a controlled environment."
    bet "Depois de falar com ele, achei que seria melhor se ele ficasse num ambiente controlado."

# game/scripts/c31/c31.rpy:3242
translate brazilian c31s006_baseArrival_2fd9fae1:

    # bet "He can leave his room and move around the base, but no more excursions to the beach for now."
    bet "Ele pode sair do quarto e andar pela base, mas nada de excursões pra praia por enquanto."

# game/scripts/c31/c31.rpy:3243
translate brazilian c31s006_baseArrival_871edece:

    # mc "Is the arm thing going to work well?"
    mc "Aquele lance do braço vai funcionar bem?"

# game/scripts/c31/c31.rpy:3245
translate brazilian c31s006_baseArrival_ac4a8c8b:

    # bet "It's going to work better than the original. That's no exaggeration, it's an engineering marvel."
    bet "Vai funcionar melhor que o original. Não é exagero, é uma maravilha da engenharia."

# game/scripts/c31/c31.rpy:3246
translate brazilian c31s006_baseArrival_918d07e8:

    # bet "I'm looking forward to seeing the real device. So far I've only seen photos and blueprints."
    bet "Tô ansiosa pra ver o dispositivo real. Até agora só vi fotos e plantas."

# game/scripts/c31/c31.rpy:3247
translate brazilian c31s006_baseArrival_b1ec7853:

    # mc "When is the surgery?"
    mc "Quando é a cirurgia?"

# game/scripts/c31/c31.rpy:3249
translate brazilian c31s006_baseArrival_2a7468a5:

    # bet "On Sunday. If everything goes well, he'll be in physical therapy in two weeks."
    bet "No domingo. Se tudo der certo, ele vai estar na fisioterapia em duas semanas."

# game/scripts/c31/c31.rpy:3250
translate brazilian c31s006_baseArrival_d88fdbbc:

    # mc "And does [gav] know how it's going to turn out?"
    mc "E o [gav] sabe como vai ficar?"

# game/scripts/c31/c31.rpy:3252
translate brazilian c31s006_baseArrival_4f0709d4:

    # bet "I explained every step to him. He asked if he could go back to the field."
    bet "Eu expliquei cada passo pra ele. Ele perguntou se poderia voltar a campo."

# game/scripts/c31/c31.rpy:3253
translate brazilian c31s006_baseArrival_5c602d0c:

    # mc "And?"
    mc "E aí?"

# game/scripts/c31/c31.rpy:3254
translate brazilian c31s006_baseArrival_ac93f27d:

    # bet "I told him probably yes. That the arm wasn't going to be his limit."
    bet "Eu disse que provavelmente sim. Que o braço não seria o limite dele."

# game/scripts/c31/c31.rpy:3255
translate brazilian c31s006_baseArrival_457c1076:

    # mc "And how did he react?"
    mc "E como ele reagiu?"

# game/scripts/c31/c31.rpy:3265
translate brazilian c31s006_baseArrival_33cfb197:

    # ama "He must have been happy."
    ama "Ele deve ter ficado feliz."

# game/scripts/c31/c31.rpy:3257
translate brazilian c31s006_baseArrival_c759d1da:

    # bet "His face lit up. It was sweet."
    bet "O rosto dele se iluminou. Foi fofo."

# game/scripts/c31/c31.rpy:3258
translate brazilian c31s006_baseArrival_5e02bf30:

    # ama "You hadn't told me."
    ama "Você não tinha me contado."

# game/scripts/c31/c31.rpy:3259
translate brazilian c31s006_baseArrival_84c34bcb:

    # bet "Doctor-patient confidentiality..."
    bet "Confidencialidade médico-paciente..."

# game/scripts/c31/c31.rpy:3260
translate brazilian c31s006_baseArrival_0dd13cac:

    # mc "Thanks for doing this, really."
    ama "Obrigada por fazer isso, de verdade."

# game/scripts/c31/c31.rpy:3261
translate brazilian c31s006_baseArrival_323f3ee6:

    # bet "It's my job. But also... after talking to the kid... I care."
    bet "É o meu trabalho. Mas também... depois de falar com o garoto... eu me importo."

# game/scripts/c31/c31.rpy:3263
translate brazilian c31s006_baseArrival_391f88cf:

    # ama "We have to keep going. The hangar is waiting for us."
    ama "Temos que continuar. O hangar está esperando por nós."

# game/scripts/c31/c31.rpy:3264
translate brazilian c31s006_baseArrival_46ba6c1e:

    # bet "I'm going to stay here. I have no interest in seeing weapons. Let's see if I can find someone to show me this in depth."
    bet "Eu vou ficar aqui. Não tenho interesse em ver armas. Vamos ver se encontro alguém para me mostrar isso a fundo."

# game/scripts/c31/c31.rpy:3265
translate brazilian c31s006_baseArrival_aa2ffe0d:

    # ama "Will you know how to find the meeting room? We have one in forty minutes with the department heads."
    ama "Você vai saber como encontrar a sala de reuniões? Temos uma em quarenta minutos com os chefes de departamento."

# game/scripts/c31/c31.rpy:3267
translate brazilian c31s006_baseArrival_542718fc:

    # bet "I hadn't thought about that..."
    bet "Eu não tinha pensado nisso..."

# game/scripts/c31/c31.rpy:3268
translate brazilian c31s006_baseArrival_b830a32c:

    # ama "Second door on the right from the elevator on the second floor."
    ama "Segunda porta à direita do elevador no segundo andar."

# game/scripts/c31/c31.rpy:3269
translate brazilian c31s006_baseArrival_9eff3961:

    # bet "I'll find something resembling that and trust my intuition."
    bet "Vou encontrar algo parecido com isso e confiar na minha intuição."

# game/scripts/c31/c31.rpy:3272
translate brazilian c31s006_baseArrival_72521cef:

    # mc "How long have we been here? I don't want to be late for the meeting."
    mc "Há quanto tempo estamos aqui? Não quero me atrasar para a reunião."

# game/scripts/c31/c31.rpy:3273
translate brazilian c31s006_baseArrival_2bfccbf6:

    # ama "There are forty minutes left. We have some time."
    ama "Faltam quarenta minutos. Temos um tempo."

# game/scripts/c31/c31.rpy:3274
translate brazilian c31s006_baseArrival_66b76905:

    # mc "What's in the hangar?"
    mc "O que tem no hangar?"

# game/scripts/c31/c31.rpy:3275
translate brazilian c31s006_baseArrival_c47cb59c:

    # ama "Operational vehicles. What we use on the training ground."
    ama "Veículos operacionais. O que usamos no campo de treinamento."

# game/scripts/c31/c31.rpy:3278
translate brazilian c31s006_baseArrival_41701d6a:

    # ama "Main hangar. This is where we keep the vehicles in regular use."
    ama "Hangar principal. É aqui que guardamos os veículos de uso regular."

# game/scripts/c31/c31.rpy:3279
translate brazilian c31s006_baseArrival_dd2ebd94:

    # mc "There are more than I thought."
    mc "Tem mais do que eu pensava."

# game/scripts/c31/c31.rpy:3280
translate brazilian c31s006_baseArrival_bcc6af59:

    # ama "NTR operates in varied environments. We need versatility."
    ama "A NTR opera em ambientes variados. Precisamos de versatilidade."

# game/scripts/c31/c31.rpy:3281
translate brazilian c31s006_baseArrival_777b2cc3:

    # mc "Can you explain them to me?"
    mc "Pode me explicar sobre eles?"

# game/scripts/c31/c31.rpy:3283
translate brazilian c31s006_baseArrival_14786c38:

    # ama "Light vehicles for recon and rapid deployment. Trucks for logistics and personnel."
    ama "Veículos leves para reconhecimento e mobilização rápida. Caminhões para logística e pessoal."

# game/scripts/c31/c31.rpy:3284
translate brazilian c31s006_baseArrival_0a4a32b3:

    # ama "AFVs for areas with moderate resistance. And IFVs for direct combat operations."
    ama "AFVs para áreas com resistência moderada. E IFVs para operações de combate direto."

# game/scripts/c31/c31.rpy:3285
translate brazilian c31s006_baseArrival_d4107052:

    # ama "Many of them are captures we've brought to the base so we can train with them and get to know different types of vehicles."
    ama "Muitos deles são capturas que trouxemos para a base para podermos treinar com eles e conhecer diferentes tipos de veículos."

# game/scripts/c31/c31.rpy:3296
translate brazilian c31s006_baseArrival_0ce93641:

    # "You follow her gestures with your eyes, trying to guess which vehicle corresponds to which acronym. You're only able to name the trucks."
    "Você acompanha os gestos dela com os olhos, tentando adivinhar qual veículo corresponde a qual sigla. Você só consegue nomear os caminhões."

# game/scripts/c31/c31.rpy:3286
translate brazilian c31s006_baseArrival_18a46dcd:

    # mc "Are these the vehicles we rent out to other companies?"
    mc "Esses são os veículos que alugamos para outras empresas?"

# game/scripts/c31/c31.rpy:3288
translate brazilian c31s006_baseArrival_3a71b47d:

    # ama "Some of them. In most infiltration missions we don't use land vehicles, or they're provided for us at the destination."
    ama "Alguns deles. Na maioria das missões de infiltração, não usamos veículos terrestres, ou eles são fornecidos para nós no destino."

# game/scripts/c31/c31.rpy:3289
translate brazilian c31s006_baseArrival_734bc7f6:

    # ama "Most of them are used for training or transport."
    ama "A maioria deles é usada para treinamento ou transporte."

# game/scripts/c31/c31.rpy:3290
translate brazilian c31s006_baseArrival_49346031:

    # mc "Wait. Is that a tank over there?"
    mc "Espera. Aquilo ali é um tanque?"

# game/scripts/c31/c31.rpy:3303
translate brazilian c31s006_baseArrival_a17f9edc:

    # ama "That one?"
    ama "Aquele ali?"

# game/scripts/c31/c31.rpy:3294
translate brazilian c31s006_baseArrival_b5e6776f:

    # ama "No, that isn't a tank."
    ama "Não, aquilo não é um tanque."

# game/scripts/c31/c31.rpy:3295
translate brazilian c31s006_baseArrival_27d7305e:

    # mc "It looks like a tank."
    mc "Parece um tanque."

# game/scripts/c31/c31.rpy:3296
translate brazilian c31s006_baseArrival_f9bba86a:

    # ama "It has tracks, a turret, and a cannon. I get it. But it's not a tank."
    ama "Tem esteiras, uma torre e um canhão. Eu entendo. Mas não é um tanque."

# game/scripts/c31/c31.rpy:3308
translate brazilian c31s006_baseArrival_535a70b6:

    # "She seems genuinely surprised that you don't know. To you, it still looks like a tank."
    "Ela parece genuinamente surpresa que você não saiba. Para você, ainda parece um tanque."

# game/scripts/c31/c31.rpy:4093
translate brazilian c31s006_baseArrival_0b7ce2f7:

    # "She seems genuinely surprised that you don't know. It still looks like a tank to you."
    "Ela parece genuinamente surpresa que você não saiba. Ainda parece um tanque para você."

# game/scripts/c31/c31.rpy:3297
translate brazilian c31s006_baseArrival_65325c94:

    # mc "What is it then?"
    mc "O que é então?"

# game/scripts/c31/c31.rpy:3298
translate brazilian c31s006_baseArrival_3122cafb:

    # ama "An IFV. Infantry Fighting Vehicle. A Bradley, if you want the specific name."
    ama "Um VCI. Veículo de Combate de Infantaria. Um Bradley, se você quiser o nome específico."

# game/scripts/c31/c31.rpy:3299
translate brazilian c31s006_baseArrival_9f66fff7:

    # ama "That one in particular came out of Lebanon a few years ago."
    ama "Esse em particular veio do Líbano há alguns anos."

# game/scripts/c31/c31.rpy:3300
translate brazilian c31s006_baseArrival_2399641f:

    # mc "What's the difference between an IFV and a tank?"
    mc "Qual é a diferença entre um VCI e um tanque?"

# game/scripts/c31/c31.rpy:3302
translate brazilian c31s006_baseArrival_e8712b86:

    # ama "A tank is designed to destroy other armored vehicles and fortified positions."
    ama "Um tanque é projetado para destruir outros veículos blindados e posições fortificadas."

# game/scripts/c31/c31.rpy:3303
translate brazilian c31s006_baseArrival_261cb618:

    # ama "The IFV carries infantry into combat and provides fire support. It's a different philosophy."
    ama "O VCI transporta a infantaria para o combate e fornece fogo de apoio. É uma filosofia diferente."

# game/scripts/c31/c31.rpy:3304
translate brazilian c31s006_baseArrival_44e6c996:

    # mc "And NTR doesn't have tanks?"
    mc "E a NTR não tem tanques?"

# game/scripts/c31/c31.rpy:3306
translate brazilian c31s006_baseArrival_fdb1c96e:

    # ama "No. We don't even need them."
    ama "Não. Nós nem precisamos deles."

# game/scripts/c31/c31.rpy:3307
translate brazilian c31s006_baseArrival_442d7fdf_1:

    # mc "Why not?"
    mc "Por que não?"

# game/scripts/c31/c31.rpy:3308
translate brazilian c31s006_baseArrival_11187978:

    # ama "NTR doesn't do conventional warfare. We aren't an army. We do precision operations, espionage, extraction, elimination..."
    ama "A NTR não faz guerra convencional. Nós não somos um exército. Nós fazemos operações de precisão, espionagem, extração, eliminação..."

# game/scripts/c31/c31.rpy:3309
translate brazilian c31s006_baseArrival_d4dcc286:

    # ama "A tank in that context is a huge logistical problem and a very visible signal."
    ama "Um tanque nesse contexto é um enorme problema logístico e um sinal muito visível."

# game/scripts/c31/c31.rpy:3310
translate brazilian c31s006_baseArrival_ac15cdf7:

    # mc "We don't want visibility."
    mc "Nós não queremos visibilidade."

# game/scripts/c31/c31.rpy:3312
translate brazilian c31s006_baseArrival_58fb179c:

    # ama "Exactly. IFVs give us protection and firepower without announcing that we're coming."
    ama "Exatamente. Os IFVs nos dão proteção e poder de fogo sem anunciar que estamos chegando."

# game/scripts/c31/c31.rpy:3326
translate brazilian c31s006_baseArrival_974c9428:

    # "Her smile tells you that you guessed right. She looks happy that you're starting to understand her world. A world that's going to be yours too."
    "O sorriso dela diz que você adivinhou certo. Ela parece feliz que você está começando a entender o mundo dela. Um mundo que também será seu."

# game/scripts/c31/c31.rpy:3313
translate brazilian c31s006_baseArrival_d3b5cf1c:

    # ama "If one falls into our hands on a mission, we're trained to use it at a basic level, but it's not the norm."
    ama "Se um cair em nossas mãos em uma missão, somos treinados para usá-lo em um nível básico, mas não é a norma."

# game/scripts/c31/c31.rpy:3314
translate brazilian c31s006_baseArrival_67dcdea5:

    # mc "Makes sense."
    mc "Faz sentido."

# game/scripts/c31/c31.rpy:3316
translate brazilian c31s006_baseArrival_17a38d52:

    # ama "Besides, moving tanks, maintaining them, crewing them... requires infrastructure we don't have here."
    ama "Além disso, mover tanques, mantê-los, tripulá-los... requer uma infraestrutura que não temos aqui."

# game/scripts/c31/c31.rpy:3317
translate brazilian c31s006_baseArrival_ce77575f:

    # ama "And capturing a tank is much rarer, so we don't need that training."
    ama "E capturar um tanque é muito mais raro, então não precisamos desse treinamento."

# game/scripts/c31/c31.rpy:3318
translate brazilian c31s006_baseArrival_f4f0bbbf:

    # mc "I see. How many IFVs do we have?"
    mc "Entendi. Quantos VCIs nós temos?"

# game/scripts/c31/c31.rpy:3320
translate brazilian c31s006_baseArrival_62d67e93:

    # ama "Four operational ones of different models. A couple more are non-operational, but we also use them for training."
    ama "Quatro operacionais de modelos diferentes. Mais alguns não estão operacionais, mas também os usamos para treinamento."

# game/scripts/c31/c31.rpy:4120
translate brazilian c31s006_baseArrival_092456e0:

    # ama "There are eight AFVs. They're like an IFV, but with wheels instead of tracks. In some places they're called the same thing."
    ama "Temos oito AFVs. Eles são como um VCI, mas com rodas em vez de esteiras. Em alguns lugares, eles são chamados da mesma coisa."

# game/scripts/c31/c31.rpy:3321
translate brazilian c31s006_baseArrival_4851b21c:

    # ama "There are eight AFVs. They're like an IFV but with wheels instead of tracks. In some places they're called the same thing."
    ama "Temos oito AFVs. Eles são como um VCI, mas com rodas em vez de esteiras. Em alguns lugares, eles são chamados da mesma coisa."

# game/scripts/c31/c31.rpy:3322
translate brazilian c31s006_baseArrival_c1661fd9:

    # mc "Does all of this fit in here?"
    mc "Tudo isso cabe aqui?"

# game/scripts/c31/c31.rpy:3324
translate brazilian c31s006_baseArrival_314abfa6:

    # ama "This is the main hangar of the base. There's another one, even bigger, at the training facilities."
    ama "Este é o hangar principal da base. Tem outro, ainda maior, nas instalações de treinamento."

# game/scripts/c31/c31.rpy:3325
translate brazilian c31s006_baseArrival_8f8a907a:

    # mc "What about the planes and helicopters?"
    mc "E os aviões e helicópteros?"

# game/scripts/c31/c31.rpy:3326
translate brazilian c31s006_baseArrival_a3430981:

    # ama "At the airport or the training facilities. They're a bit away from the base."
    ama "No aeroporto ou nas instalações de treinamento. Ficam um pouco afastados da base."

# game/scripts/c31/c31.rpy:3327
translate brazilian c31s006_baseArrival_73982012:

    # mc "How far are they?"
    mc "A que distância ficam?"

# game/scripts/c31/c31.rpy:3329
translate brazilian c31s006_baseArrival_b637b71b:

    # ama "About three kilometers. Over there is the training ground, the weapons depots, the airstrip, the aircraft hangar, and the other vehicle hangar."
    ama "Cerca de três quilômetros. Lá ficam o campo de treinamento, os depósitos de armas, a pista de pouso, o hangar de aeronaves e o outro hangar de veículos."

# game/scripts/c31/c31.rpy:3330
translate brazilian c31s006_baseArrival_c438ab01:

    # mc "Why are they separate?"
    mc "Por que são separados?"

# game/scripts/c31/c31.rpy:3331
translate brazilian c31s006_baseArrival_d531339f:

    # ama "Security and logistics. If something fails at one point, it doesn't compromise the other."
    ama "Segurança e logística. Se algo der errado em um ponto, não compromete o outro."

# game/scripts/c31/c31.rpy:3332
translate brazilian c31s006_baseArrival_fb8daad5:

    # mc "Will we see it today?"
    mc "Vamos ver isso hoje?"

# game/scripts/c31/c31.rpy:3334
translate brazilian c31s006_baseArrival_60167086:

    # ama "We don't have time before the meeting. I'll schedule it for tomorrow if you want."
    ama "Não temos tempo antes da reunião. Vou agendar para amanhã, se você quiser."

# game/scripts/c31/c31.rpy:3335
translate brazilian c31s006_baseArrival_c9243ff0:

    # mc "Yes. I want to see everything."
    mc "Sim. Eu quero ver tudo."

# game/scripts/c31/c31.rpy:3336
translate brazilian c31s006_baseArrival_3d9906cf:

    # ama "I figured."
    ama "Imaginei."

# game/scripts/c31/c31.rpy:3338
translate brazilian c31s006_baseArrival_27f0abd1:

    # mc "Hey."
    mc "Ei."

# game/scripts/c31/c31.rpy:3339
translate brazilian c31s006_baseArrival_45b012e8:

    # ama "Yeah?"
    ama "Sim?"

# game/scripts/c31/c31.rpy:3340
translate brazilian c31s006_baseArrival_29e72cc7:

    # mc "This is really big."
    mc "Isso é muito grande."

# game/scripts/c31/c31.rpy:3341
translate brazilian c31s006_baseArrival_af45e037_1:

    # ama "I know."
    ama "Eu sei."

# game/scripts/c31/c31.rpy:3342
translate brazilian c31s006_baseArrival_e39094cc:

    # mc "I don't mean it in a logistical sense, nor am I referring to the base. I mean it in the sense of... it's a lot of responsibility."
    mc "Não digo no sentido logístico, nem estou me referindo à base. Digo no sentido de... é muita responsabilidade."

# game/scripts/c31/c31.rpy:3343
translate brazilian c31s006_baseArrival_c1fc5fcc:

    # mc "While we were at home everything was very abstract. Now I'm seeing that it's... real."
    mc "Enquanto estávamos em casa, tudo era muito abstrato. Agora estou vendo que é... real."

# game/scripts/c31/c31.rpy:3345
translate brazilian c31s006_baseArrival_8f0140e6:

    # ama "I know that too."
    ama "Eu sei disso também."

# game/scripts/c31/c31.rpy:3346
translate brazilian c31s006_baseArrival_2437b094:

    # mc "And you think I can handle this?"
    mc "E você acha que eu dou conta disso?"

# game/scripts/c31/c31.rpy:3347
translate brazilian c31s006_baseArrival_4f80d06f:

    # ama "I wouldn't have supported you if I didn't believe it."
    ama "Eu não teria te apoiado se não acreditasse nisso."

# game/scripts/c31/c31.rpy:3348
translate brazilian c31s006_baseArrival_b2ff6979:

    # mc "That doesn't exactly answer my question."
    mc "Isso não responde exatamente à minha pergunta."

# game/scripts/c31/c31.rpy:3350
translate brazilian c31s006_baseArrival_64b655c1:

    # ama "*Laugh* Yes it does. You just have to listen carefully to the answer."
    ama "*Risos* Responde sim. Você só precisa ouvir a resposta com atenção."


# game/scripts/c31/c31.rpy:3351
translate brazilian c31s006_baseArrival_63fd57b4:

    # mc "You're very direct when you want to be."
    mc "Você é bem direta quando quer."

# game/scripts/c31/c31.rpy:3352
translate brazilian c31s006_baseArrival_18975b19:

    # ama "*Laugh* I'm always direct. The thing is, this place..."
    ama "*Risos* Eu sou sempre direta. O problema é que esse lugar..."

# game/scripts/c31/c31.rpy:3353
translate brazilian c31s006_baseArrival_51492c4a:

    # mc "Is coming back getting to you?"
    mc "Voltar pra cá tá mexendo com você?"

# game/scripts/c31/c31.rpy:3355
translate brazilian c31s006_baseArrival_ca001451:

    # ama "A little. This company needed a real change, not a cosmetic one."
    ama "Um pouco. Essa empresa precisava de uma mudança real, não só de fachada."

# game/scripts/c31/c31.rpy:3356
translate brazilian c31s006_baseArrival_7bf6aaa2:

    # ama "What you've planned for today, the meeting in a little while..."
    ama "O que você planejou pra hoje, a reunião daqui a pouco..."

# game/scripts/c31/c31.rpy:3357
translate brazilian c31s006_baseArrival_445ce296:

    # ama "That's not what the previous CEO did. Not at all."
    ama "Não foi isso que o CEO anterior fez. De jeito nenhum."

# game/scripts/c31/c31.rpy:3358
translate brazilian c31s006_baseArrival_cfcb856a:

    # mc "The bar wasn't very high."
    mc "O nível não era muito alto."

# game/scripts/c31/c31.rpy:3360
translate brazilian c31s006_baseArrival_6517222d:

    # ama "No. But you raised it anyway. That matters. And you haven't even started working yet..."
    ama "Não. Mas você elevou mesmo assim. Isso importa. E você nem começou a trabalhar ainda..."

# game/scripts/c31/c31.rpy:3361
translate brazilian c31s006_baseArrival_872828eb:

    # mc "Thanks, Amanda."
    mc "Obrigado, Amanda."

# game/scripts/c31/c31.rpy:3362
translate brazilian c31s006_baseArrival_3330b244:

    # ama "Don't thank me yet. There's a lot of work left."
    ama "Não me agradeça ainda. Tem muito trabalho pela frente."

# game/scripts/c31/c31.rpy:3363
translate brazilian c31s006_baseArrival_50d8828a:

    # mc "I know."
    mc "Eu sei."

# game/scripts/c31/c31.rpy:3365
translate brazilian c31s006_baseArrival_93634100:

    # ama "We have twenty minutes left before the meeting. Do you have any questions before we go in?"
    ama "Temos vinte minutos antes da reunião. Você tem alguma pergunta antes de entrarmos?"

# game/scripts/c31/c31.rpy:3366
translate brazilian c31s006_baseArrival_46661b66:

    # mc "Several. But they can wait."
    mc "Várias. Mas elas podem esperar."

# game/scripts/c31/c31.rpy:3367
translate brazilian c31s006_baseArrival_868eb3a1:

    # ama "Good. Oh, and one more thing."
    ama "Ótimo. Ah, e mais uma coisa."

# game/scripts/c31/c31.rpy:3368
translate brazilian c31s006_baseArrival_a3db9a7f:

    # mc "What?"
    mc "O quê?"

# game/scripts/c31/c31.rpy:3370
translate brazilian c31s006_baseArrival_827244e5:

    # ama "If they ask something you don't know how to answer, don't pretend you do."
    ama "Se eles perguntarem algo que você não sabe como responder, não finja que sabe."

# game/scripts/c31/c31.rpy:3385
translate brazilian c31s006_baseArrival_6197c694:

    # "It seems the conversation about the not-tank right behind her has opened her eyes to the fact that you're a rookie at this."
    "Parece que a conversa sobre o não-tanque bem atrás dela abriu os olhos dela para o fato de que você é um novato nisso."

# game/scripts/c31/c31.rpy:3371
translate brazilian c31s006_baseArrival_aa3d4492:

    # mc "Does that happen a lot in these meetings?"
    mc "Isso acontece muito nessas reuniões?"

# game/scripts/c31/c31.rpy:3372
translate brazilian c31s006_baseArrival_abe99241:

    # ama "With the department heads, always."
    ama "Com os chefes de departamento, sempre."

# game/scripts/c31/c31.rpy:3373
translate brazilian c31s006_baseArrival_54ae708d:

    # mc "Advice noted."
    mc "Conselho anotado."

# game/scripts/c31/c31.rpy:3375
translate brazilian c31s006_baseArrival_e9d0c3cc:

    # ama "They're good at what they do, but they haven't had to answer to anyone for years."
    ama "Eles são bons no que fazem, mas não precisam prestar contas a ninguém há anos."

# game/scripts/c31/c31.rpy:3376
translate brazilian c31s006_baseArrival_dc214e2a:

    # mc "Is that a warning?"
    mc "Isso é um aviso?"

# game/scripts/c31/c31.rpy:3377
translate brazilian c31s006_baseArrival_a65f3029:

    # ama "It's context. The warning is that some of them will try to confuse you with technicalities."
    ama "É contexto. O aviso é que alguns deles vão tentar te confundir com tecnicalidades."

# game/scripts/c31/c31.rpy:3378
translate brazilian c31s006_baseArrival_520db1fc:

    # mc "And what do I do?"
    mc "E o que eu faço?"

# game/scripts/c31/c31.rpy:3380
translate brazilian c31s006_baseArrival_64550313:

    # ama "Listen. Ask questions. And don't sign anything you don't understand."
    ama "Ouça. Faça perguntas. E não assine nada que não entender."

# game/scripts/c31/c31.rpy:3381
translate brazilian c31s006_baseArrival_daf55b5f:

    # mc "Has that happened before?"
    mc "Isso já aconteceu antes?"

# game/scripts/c31/c31.rpy:3382
translate brazilian c31s006_baseArrival_b2952f57:

    # ama "With Daniels, yes. Several times. He let them do as they pleased as long as they met the objectives."
    ama "Com o Daniels, sim. Várias vezes. Ele deixava eles fazerem o que quisessem, desde que cumprissem os objetivos."

# game/scripts/c31/c31.rpy:3383
translate brazilian c31s006_baseArrival_6ba3cf84:

    # mc "And how did that end?"
    mc "E como isso terminou?"

# game/scripts/c31/c31.rpy:3385
translate brazilian c31s006_baseArrival_d3b0eca8:

    # ama "You know how it ended. Badly. That's why I'm telling you now."
    ama "Você sabe como terminou. Mal. É por isso que estou te falando agora."

# game/scripts/c31/c31.rpy:3386
translate brazilian c31s006_baseArrival_035146fc:

    # mc "Are you going to be in the meeting?"
    mc "Você vai estar na reunião?"

# game/scripts/c31/c31.rpy:3387
translate brazilian c31s006_baseArrival_0051c6a3:

    # ama "By your side. The whole time. I'm not going to leave you alone among the sharks."
    ama "Ao seu lado. O tempo todo. Não vou te deixar sozinho no meio dos tubarões."

# game/scripts/c31/c31.rpy:3388
translate brazilian c31s006_baseArrival_9a2a7c2b:

    # mc "Good."
    mc "Bom."

# game/scripts/c31/c31.rpy:3391
translate brazilian c31s006_baseArrival_b5ecfb44:

    # "At the door of the meeting room, a few minutes later..."
    "Na porta da sala de reuniões, alguns minutos depois..."

# game/scripts/c31/c31.rpy:3392
translate brazilian c31s006_baseArrival_e7c0540e:

    # ama "Anything else before we go in?"
    ama "Mais alguma coisa antes de entrarmos?"

# game/scripts/c31/c31.rpy:3393
translate brazilian c31s006_baseArrival_5956fca8:

    # mc "Yeah. One thing."
    mc "Sim. Uma coisa."

# game/scripts/c31/c31.rpy:3394
translate brazilian c31s006_baseArrival_ebe0f4ba:

    # ama "Tell me."
    ama "Diga."

# game/scripts/c31/c31.rpy:3395
translate brazilian c31s006_baseArrival_8d0e1a50:

    # mc "I want to meet with the clones. With the operatives."
    mc "Quero me encontrar com os clones. Com os agentes."

# game/scripts/c31/c31.rpy:3397
translate brazilian c31s006_baseArrival_63f13e2e:

    # ama "When? Today?"
    ama "Quando? Hoje?"

# game/scripts/c31/c31.rpy:3398
translate brazilian c31s006_baseArrival_9c149142:

    # mc "After the department heads meeting. If possible."
    mc "Depois da reunião com os chefes de departamento. Se possível."

# game/scripts/c31/c31.rpy:3400
translate brazilian c31s006_baseArrival_5c8cd1b7:

    # ama "[aar] told me they've formed a committee. To talk to you in an organized manner."
    ama "[aar] me disse que eles formaram um comitê. Para falar com você de forma organizada."

# game/scripts/c31/c31.rpy:3401
translate brazilian c31s006_baseArrival_185554ac:

    # mc "Perfect. That's exactly what I want."
    mc "Perfeito. É exatamente isso que eu quero."

# game/scripts/c31/c31.rpy:3402
translate brazilian c31s006_baseArrival_0b2f1aca:

    # ama "When do you suggest?"
    ama "Quando você sugere?"

# game/scripts/c31/c31.rpy:3403
translate brazilian c31s006_baseArrival_06d1e40e:

    # mc "An hour after we finish with the department heads. Is that doable?"
    mc "Uma hora depois de terminarmos com os chefes de departamento. É possível?"

# game/scripts/c31/c31.rpy:3419
translate brazilian c31s006_baseArrival_c39437dd:

    # mc "I need to talk to [car] and IT Support. I can meet with the clones in between."
    mc "Preciso falar com a [car] e o Suporte de TI. Posso me encontrar com os clones nesse meio tempo."

# game/scripts/c31/c31.rpy:3405
translate brazilian c31s006_baseArrival_30108ff2:

    # ama "I can set that up. Give me a second to let them know so they can be ready in a couple of hours."
    ama "Posso arranjar isso. Me dê um segundo para avisá-los para que possam estar prontos em algumas horas."

# game/scripts/c31/c31.rpy:3406
translate brazilian c31s006_baseArrival_eca8e830:

    # mc "Good. I don't want it to seem like an imposition. I want them to know I'm the one asking."
    mc "Bom. Não quero que pareça uma imposição. Quero que saibam que sou eu quem está pedindo."

# game/scripts/c31/c31.rpy:3407
translate brazilian c31s006_baseArrival_a647bd2d:

    # ama "I'll let them know."
    ama "Eu vou avisá-los."

# game/scripts/c31/c31.rpy:3408
translate brazilian c31s006_baseArrival_b2516466:

    # mc "Thanks."
    mc "Obrigado."

# game/scripts/c31/c31.rpy:3410
translate brazilian c31s006_baseArrival_df4ae749:

    # ama "Do you know what you're going to say to them?"
    ama "Você sabe o que vai dizer a eles?"

# game/scripts/c31/c31.rpy:3411
translate brazilian c31s006_baseArrival_7bcfe1d1:

    # mc "Not yet. But I know I'm going to listen to them."
    mc "Ainda não. Mas sei que vou ouvi-los."

# game/scripts/c31/c31.rpy:3412
translate brazilian c31s006_baseArrival_3a6c3597:

    # ama "That's enough to start with."
    ama "Isso já é o suficiente para começar."

# game/scripts/c31/c31.rpy:3413
translate brazilian c31s006_baseArrival_31fd88d8:

    # mc "Do you think they'll trust me?"
    mc "Você acha que eles vão confiar em mim?"

# game/scripts/c31/c31.rpy:3415
translate brazilian c31s006_baseArrival_0969eb05:

    # ama "Some of them will. Others will need time. It's normal."
    ama "Alguns vão. Outros vão precisar de tempo. É normal."

# game/scripts/c31/c31.rpy:3416
translate brazilian c31s006_baseArrival_e703eb26:

    # mc "And do you trust me?"
    mc "E você confia em mim?"

# game/scripts/c31/c31.rpy:3417
translate brazilian c31s006_baseArrival_d3a517c8:

    # ama "I've told you before. There's no one I trust more than you when it comes to this."
    ama "Eu já te disse antes. Não há ninguém em quem eu confie mais do que em você quando se trata disso."

# game/scripts/c31/c31.rpy:3418
translate brazilian c31s006_baseArrival_a223bcfb:

    # mc "I know, but I like hearing it."
    mc "Eu sei, mas eu gosto de ouvir."

# game/scripts/c31/c31.rpy:3420
translate brazilian c31s006_baseArrival_0a05c01e:

    # ama "*Laugh* I'm not going to repeat it again or it'll end up going to your head."
    ama "*Risos* Não vou repetir de novo, senão vai acabar subindo à sua cabeça."

# game/scripts/c31/c31.rpy:3421
translate brazilian c31s006_baseArrival_c03e6302:

    # mc "*Laugh* Alright. I had to try."
    mc "*Risos* Beleza. Eu tinha que tentar."

# game/scripts/c31/c31.rpy:3422
translate brazilian c31s006_baseArrival_3673040a:

    # ama "Come on. The meeting awaits us."
    ama "Vamos. A reunião nos aguarda."

# game/scripts/c31/c31.rpy:3423
translate brazilian c31s006_baseArrival_63cd8ebd:

    # mc "Let's go."
    mc "Vamos lá."

# game/scripts/c31/c31.rpy:3424
translate brazilian c31s006_baseArrival_de79a378:

    # "[ama] sends a couple of text messages before going in."
    "[ama] manda algumas mensagens de texto antes de entrar."

# game/scripts/c31/c31.rpy:3425
translate brazilian c31s006_baseArrival_1d1dfe8b:

    # "A chill runs down your spine."
    "Um calafrio percorre sua espinha."

# game/scripts/c31/c31.rpy:2869
translate brazilian c31s006_departmentMeeting_23940c53:

    # "Upon entering the room, everyone sits down quickly. [gav]'s future arm looks impressive."
    "Ao entrar na sala, todos se sentam rapidamente. O futuro braço de [gav] parece impressionante."

# game/scripts/c31/c31.rpy:2870
translate brazilian c31s006_departmentMeeting_13f81308:

    # "You have to hold yourself back from going over to look at it in detail. It looks like something out of a sci-fi movie."
    "Você tem que se segurar para não ir até lá olhar em detalhes. Parece algo saído de um filme de ficção científica."

# game/scripts/c31/c31.rpy:2871
translate brazilian c31s006_departmentMeeting_824948ce:

    # "You realize you're going to hate this room as soon as you walk in. It's dark and oppressive. Right in line with the company's image."
    "Você percebe que vai odiar essa sala assim que entra. É escura e opressiva. Bem de acordo com a imagem da empresa."

# game/scripts/c31/c31.rpy:2873
translate brazilian c31s006_departmentMeeting_b5425eca:

    # "[aar] makes the introductions. Nobody stands up to shake your hand."
    "[aar] faz as apresentações. Ninguém se levanta para apertar sua mão."

# game/scripts/c31/c31.rpy:2874
translate brazilian c31s006_departmentMeeting_68e75baa:

    # aar "[flo], Head of the Commercial Department."
    aar "[flo], Chefe do Departamento Comercial."

# game/scripts/c31/c31.rpy:2876
translate brazilian c31s006_departmentMeeting_f7532d1f:

    # aar "[vin], Head of the Financial Department."
    aar "[vin], Chefe do Departamento Financeiro."

# game/scripts/c31/c31.rpy:2878
translate brazilian c31s006_departmentMeeting_3f0b9abf:

    # aar "[mael], Head of the Cloning and Medicine Department."
    aar "[mael], Chefe do Departamento de Clonagem e Medicina."

# game/scripts/c31/c31.rpy:2880
translate brazilian c31s006_departmentMeeting_54f4ccaf:

    # aar "[cal], Cloning and Medicine Department."
    aar "[cal], Departamento de Clonagem e Medicina."

# game/scripts/c31/c31.rpy:2881
translate brazilian c31s006_departmentMeeting_a694a0a1:

    # "You notice the absence of the title 'Head' when naming [cal]. He's the designer of the arm."
    "Você nota a ausência do título 'Chefe' ao nomear [cal]. Ele é o projetista do braço."

# game/scripts/c31/c31.rpy:2883
translate brazilian c31s006_departmentMeeting_4412ee22:

    # mc "Good. Thank you all for coming."
    mc "Bom. Obrigado a todos por virem."

# game/scripts/c31/c31.rpy:2885
translate brazilian c31s006_departmentMeeting_6c0fdd61:

    # "You point to the electromechanical arm before continuing. You would have liked to examine it closely before starting the meeting."
    "Você aponta para o braço eletromecânico antes de continuar. Você gostaria de tê-lo examinado de perto antes de começar a reunião."

# game/scripts/c31/c31.rpy:2886
translate brazilian c31s006_departmentMeeting_e86b371d:

    # "Everyone looks at it, following the direction your hand is pointing."
    "Todos olham para ele, seguindo a direção que sua mão está apontando."

# game/scripts/c31/c31.rpy:2887
translate brazilian c31s006_departmentMeeting_36cd575a:

    # mc "I know it's not the most conventional way to start a management meeting, but I wanted it here."
    mc "Eu sei que não é a maneira mais convencional de começar uma reunião de diretoria, mas eu o queria aqui."

# game/scripts/c31/c31.rpy:2888
translate brazilian c31s006_departmentMeeting_ad70f504:

    # mc "To remind myself, and to remind you, of what we're capable of when we look in the right direction."
    mc "Para me lembrar, e para lembrar a vocês, do que somos capazes quando olhamos na direção certa."

# game/scripts/c31/c31.rpy:2890
translate brazilian c31s006_departmentMeeting_d321dd09:

    # mc "Before getting down to business, I'd like each of you to give me a summary of your area."
    mc "Antes de irmos direto ao assunto, eu gostaria que cada um de vocês me desse um resumo da sua área."

# game/scripts/c31/c31.rpy:2891
translate brazilian c31s006_departmentMeeting_aa402515:

    # mc "What state is the company in? No sugarcoating. Let's start with you, [aar]."
    mc "Em que estado a empresa se encontra? Sem enrolação. Vamos começar com você, [aar]."

# game/scripts/c31/c31.rpy:2893
translate brazilian c31s006_departmentMeeting_233b51bd:

    # aar "Alright. The Operations Area is active and running at full capacity."
    aar "Certo. A Área de Operações está ativa e funcionando com capacidade total."

# game/scripts/c31/c31.rpy:2894
translate brazilian c31s006_departmentMeeting_560d333d:

    # aar "We have signed commitments with several clients for the next two quarters: Colombia, the United States, the United Kingdom, and France."
    aar "Temos compromissos assinados com vários clientes para os próximos dois trimestres: Colômbia, Estados Unidos, Reino Unido e França."

# game/scripts/c31/c31.rpy:2895
translate brazilian c31s006_departmentMeeting_2ff5a840:

    # aar "In total, there are seven contracts of varying scope, all in the execution or advanced preparation phase."
    aar "No total, são sete contratos de escopos variados, todos em fase de execução ou preparação avançada."

# game/scripts/c31/c31.rpy:2896
translate brazilian c31s006_departmentMeeting_70600eb1:

    # aar "The field teams are operational. There are no serious casualties at the moment, except for [gav]'s case, which you already know about."
    aar "As equipes de campo estão operacionais. Não há baixas graves no momento, exceto pelo caso do [gav], que você já sabe."

# game/scripts/c31/c31.rpy:2898
translate brazilian c31s006_departmentMeeting_96b7f82a:

    # aar "Apart from that, we have several support contracts with other PMCs. Iron Fist and Walküre are our main clients in that area."
    aar "Fora isso, temos vários contratos de suporte com outras PMCs. Iron Fist e Walküre são nossos principais clientes nessa área."

# game/scripts/c31/c31.rpy:2899
translate brazilian c31s006_departmentMeeting_0ba968c5:

    # aar "Atlas and Chimera are clients with smaller, but more continuous contracts. I sent you a detailed list of the rest of the clients."
    aar "Atlas e Chimera são clientes com contratos menores, mas mais contínuos. Eu te enviei uma lista detalhada do resto dos clientes."

# game/scripts/c31/c31.rpy:2900
translate brazilian c31s006_departmentMeeting_920a77d8:

    # mc "I know. I saw it. And I saw that it included clients we haven't worked with in ten years."
    mc "Eu sei. Eu vi. E vi que incluía clientes com quem não trabalhamos há dez anos."

# game/scripts/c31/c31.rpy:2902
translate brazilian c31s006_departmentMeeting_e085fbfc:

    # "[aar] turns a deaf ear to your veiled criticism before continuing."
    "[aar] finge que não ouviu sua crítica velada antes de continuar."

# game/scripts/c31/c31.rpy:2903
translate brazilian c31s006_departmentMeeting_646688bc:

    # aar "The problem is that all those contracts, both operations and support, have deadlines."
    aar "O problema é que todos esses contratos, tanto de operações quanto de suporte, têm prazos."

# game/scripts/c31/c31.rpy:2904
translate brazilian c31s006_departmentMeeting_f55cc2c5:

    # aar "If we touch the operational structure, I need to know with enough time so we don't leave anyone stranded in the middle of a mission."
    aar "Se formos mexer na estrutura operacional, preciso saber com tempo suficiente para não deixarmos ninguém na mão no meio de uma missão."

# game/scripts/c31/c31.rpy:2905
translate brazilian c31s006_departmentMeeting_962b4142:

    # mc "Understood."
    mc "Entendido."

# game/scripts/c31/c31.rpy:2907
translate brazilian c31s006_departmentMeeting_64d383ed:

    # mc "[flo], Commercial Department?"
    mc "[flo], Departamento Comercial?"

# game/scripts/c31/c31.rpy:2908
translate brazilian c31s006_departmentMeeting_003a31f7:

    # flo "The outlook is interesting. We have open negotiations with the Colombian government for three medium-term covert operations."
    flo "O panorama é interessante. Temos negociações abertas com o governo colombiano para três operações secretas de médio prazo."

# game/scripts/c31/c31.rpy:2909
translate brazilian c31s006_departmentMeeting_b4c7cb3e:

    # flo "With the United States, there are preliminary talks about six extra operations on top of the ones already contracted. Our contact with them is solid."
    flo "Com os Estados Unidos, há conversas preliminares sobre seis operações extras além das já contratadas. Nosso contato com eles é sólido."

# game/scripts/c31/c31.rpy:2910
translate brazilian c31s006_departmentMeeting_d092d406:

    # flo "The UK and France each have one ongoing operation. I'm in negotiations with France to expand our area of operations to the Sahel."
    flo "O Reino Unido e a França têm cada um uma operação em andamento. Estou em negociações com a França para expandir nossa área de operações para o Sahel."

# game/scripts/c31/c31.rpy:2911
translate brazilian c31s006_departmentMeeting_a3167936:

    # flo "They're all high-paying, repeat clients."
    flo "São todos clientes recorrentes e que pagam bem."

# game/scripts/c31/c31.rpy:2913
translate brazilian c31s006_departmentMeeting_d4bd0ba1:

    # flo "China and Israel have wanted to hire us on several occasions, but Richards never wanted to reach an agreement with them. They pay well."
    flo "A China e Israel quiseram nos contratar em várias ocasiões, mas Richards nunca quis chegar a um acordo com eles. Eles pagam bem."

# game/scripts/c31/c31.rpy:2914
translate brazilian c31s006_departmentMeeting_a75bc9e3:

    # flo "North Korea and Iran have reached out several times, but they were vetoed because it could cause us to lose contracts with other clients."
    flo "A Coreia do Norte e o Irã entraram em contato várias vezes, mas foram vetados porque isso poderia nos fazer perder contratos com outros clientes."

# game/scripts/c31/c31.rpy:2916
translate brazilian c31s006_departmentMeeting_128e5c09:

    # flo "That being said... and I know it might sound weird coming from me... I think there's a huge market waiting in the medical sector."
    flo "Dito isso... e eu sei que pode soar estranho vindo de mim... acho que há um mercado enorme esperando no setor médico."

# game/scripts/c31/c31.rpy:2917
translate brazilian c31s006_departmentMeeting_5b9b1d71:

    # flo "High tech, hospital equipment, and consumer devices."
    flo "Alta tecnologia, equipamentos hospitalares e dispositivos de consumo."

# game/scripts/c31/c31.rpy:2918
translate brazilian c31s006_departmentMeeting_ee75ed15:

    # flo "If we pivot well, we could compete in a sector with very different margins and much less legal exposure."
    flo "Se mudarmos de direção bem, poderíamos competir em um setor com margens muito diferentes e muito menos exposição legal."

# game/scripts/c31/c31.rpy:2919
translate brazilian c31s006_departmentMeeting_f4046e66:

    # mc "That's exactly the direction I want us to think in. Thank you."
    mc "É exatamente nessa direção que eu quero que a gente pense. Obrigado."

# game/scripts/c31/c31.rpy:2921
translate brazilian c31s006_departmentMeeting_6f9238d1:

    # mc "[vin], the numbers."
    mc "[vin], os números."

# game/scripts/c31/c31.rpy:2922
translate brazilian c31s006_departmentMeeting_b7df0e0b:

    # vin "Yes, the numbers."
    vin "Sim, os números."

# game/scripts/c31/c31.rpy:2923
translate brazilian c31s006_departmentMeeting_50a9e85e:

    # vin "Available funds: two hundred twelve million dollars. Monthly operating costs: twenty-six million."
    vin "Fundos disponíveis: duzentos e doze milhões de dólares. Custos operacionais mensais: vinte e seis milhões."

# game/scripts/c31/c31.rpy:2924
translate brazilian c31s006_departmentMeeting_58c0faea:

    # vin "Which means that, without new income, we have a little over eight months before the situation gets... uncomfortable."
    vin "O que significa que, sem novas receitas, temos pouco mais de oito meses antes que a situação fique... desconfortável."

# game/scripts/c31/c31.rpy:2925
translate brazilian c31s006_departmentMeeting_21c61ebd:

    # "He has one of those voices that makes continental drift seem fun to listen to."
    "Ele tem uma daquelas vozes que faz a deriva continental parecer divertida de se ouvir."

# game/scripts/c31/c31.rpy:2927
translate brazilian c31s006_departmentMeeting_9665be25:

    # vin "However, in the next quarter we expect an influx of one hundred eighty-three million from operations already completed and pending collection."
    vin "No entanto, no próximo trimestre esperamos uma entrada de cento e oitenta e três milhões de operações já concluídas e pendentes de cobrança."

# game/scripts/c31/c31.rpy:2928
translate brazilian c31s006_departmentMeeting_0536ab7d:

    # vin "So, in strictly financial terms, we're good."
    vin "Então, em termos estritamente financeiros, estamos bem."

# game/scripts/c31/c31.rpy:2929
translate brazilian c31s006_departmentMeeting_94125296:

    # mc "Good good, or good for now?"
    mc "Bem mesmo, ou bem por enquanto?"

# game/scripts/c31/c31.rpy:2931
translate brazilian c31s006_departmentMeeting_c626803d:

    # vin "Good for now, as always in this industry. But good."
    vin "Bem por enquanto, como sempre nesta indústria. Mas bem."

# game/scripts/c31/c31.rpy:2932
translate brazilian c31s006_departmentMeeting_da6f08cb:

    # vin "The previous CEO, Daniels... was of the opinion that the numbers always added up if you knew where to look."
    vin "O CEO anterior, Daniels... era da opinião de que os números sempre batiam se você soubesse onde procurar."

# game/scripts/c31/c31.rpy:2933
translate brazilian c31s006_departmentMeeting_46424ae7:

    # mc "Daniels is in prison for things like that, [vin]."
    mc "O Daniels está na prisão por coisas assim, [vin]."

# game/scripts/c31/c31.rpy:2935
translate brazilian c31s006_departmentMeeting_9ee1c93a:

    # vin "Yes. I know."
    vin "Sim. Eu sei."

# game/scripts/c31/c31.rpy:2936
translate brazilian c31s006_departmentMeeting_bf1b3875:

    # "He pauses briefly before continuing."
    "Ele faz uma breve pausa antes de continuar."

# game/scripts/c31/c31.rpy:2937
translate brazilian c31s006_departmentMeeting_b4dedfd0:

    # vin "It was just a comment on his accounting philosophy. Not on his other... hobbies."
    vin "Foi apenas um comentário sobre a filosofia contábil dele. Não sobre os outros... hobbies dele."

# game/scripts/c31/c31.rpy:2938
translate brazilian c31s006_departmentMeeting_1b3e3cc3:

    # "You just realized that he has ridiculously small hands."
    "Você acabou de perceber que ele tem mãos ridiculamente pequenas."

# game/scripts/c31/c31.rpy:2939
translate brazilian c31s006_departmentMeeting_e2f3bb15:

    # "It takes a bit of effort to hold back your laughter imagining him counting bills with those hands."
    "É preciso um pouco de esforço para segurar o riso imaginando ele contando notas com aquelas mãos."

# game/scripts/c31/c31.rpy:2941
translate brazilian c31s006_departmentMeeting_157c1ec8:

    # mc "[mael], your turn."
    mc "[mael], sua vez."

# game/scripts/c31/c31.rpy:2942
translate brazilian c31s006_departmentMeeting_43daf923:

    # "[mael]'s attitude makes you uncomfortable."
    "A atitude de [mael] te deixa desconfortável."

# game/scripts/c31/c31.rpy:2943
translate brazilian c31s006_departmentMeeting_7319db52:

    # "It's the attitude of someone who has spent years waiting to be asked this so they can say exactly the opposite of what people want to hear."
    "É a atitude de alguém que passou anos esperando ser questionado sobre isso para poder dizer exatamente o oposto do que as pessoas querem ouvir."

# game/scripts/c31/c31.rpy:2944
translate brazilian c31s006_departmentMeeting_9001b5f1:

    # mael "The cloning and genetics department is the real technological core of this company."
    mael "O departamento de clonagem e genética é o verdadeiro núcleo tecnológico desta empresa."

# game/scripts/c31/c31.rpy:2945
translate brazilian c31s006_departmentMeeting_9f573c51:

    # mael "Everything else, the operations, the contracts, even that arm you have there on the table..."
    mael "Todo o resto, as operações, os contratos, até mesmo esse braço que você tem aí na mesa..."

# game/scripts/c31/c31.rpy:2947
translate brazilian c31s006_departmentMeeting_a17cf71d:

    # mael "All of that exists because we've spent over 20 years pushing the limits of what biology and science allow."
    mael "Tudo isso existe porque passamos mais de 20 anos forçando os limites do que a biologia e a ciência permitem."

# game/scripts/c31/c31.rpy:2948
translate brazilian c31s006_departmentMeeting_4d7e8f81:

    # mael "We currently have forty-two subjects in advanced stages of gestation. They will be born in the coming weeks."
    mael "Atualmente temos quarenta e dois sujeitos em estágios avançados de gestação. Eles nascerão nas próximas semanas."

# game/scripts/c31/c31.rpy:2950
translate brazilian c31s006_departmentMeeting_f33b7a5f:

    # mael "They are viable human beings, and we'll have to decide what to do with them regardless of any strategic decision."
    mael "Eles são seres humanos viáveis, e teremos que decidir o que fazer com eles independentemente de qualquer decisão estratégica."

# game/scripts/c31/c31.rpy:2951
translate brazilian c31s006_departmentMeeting_4c67d937:

    # mael "[aar] said you want to shut down the Cloning Department. I think that's a mistake."
    mael "[aar] disse que você quer fechar o Departamento de Clonagem. Eu acho que isso é um erro."

# game/scripts/c31/c31.rpy:2952
translate brazilian c31s006_departmentMeeting_80b136cb:

    # mc "Why? If we stop producing clones? What exactly do we lose?"
    mc "Por quê? Se pararmos de produzir clones? O que exatamente nós perdemos?"

# game/scripts/c31/c31.rpy:2954
translate brazilian c31s006_departmentMeeting_d8f998f2:

    # mael "We lose living knowledge. Cloning isn't just a product, it's a process."
    mael "Perdemos conhecimento vivo. A clonagem não é apenas um produto, é um processo."

# game/scripts/c31/c31.rpy:2955
translate brazilian c31s006_departmentMeeting_3c382f8c:

    # mael "Every batch teaches us something new about gene expression, about cellular differentiation, about the limits of embryonic development."
    mael "Cada lote nos ensina algo novo sobre expressão gênica, sobre diferenciação celular, sobre os limites do desenvolvimento embrionário."

# game/scripts/c31/c31.rpy:2956
translate brazilian c31s006_departmentMeeting_60d48f74:

    # mael "If we turn off the tap, in five years we'll have lost technical capacity that took us decades to build."
    mael "Se fecharmos a torneira, em cinco anos teremos perdido a capacidade técnica que levamos décadas para construir."

# game/scripts/c31/c31.rpy:2957
translate brazilian c31s006_departmentMeeting_073cda67:

    # mc "I understand the logic. But... I don't know..."
    mc "Eu entendo a lógica. Mas... eu não sei..."

# game/scripts/c31/c31.rpy:2958
translate brazilian c31s006_departmentMeeting_aa20c7a3:

    # mc "Couldn't we maintain that knowledge by making... I don't know... animal clones or something? Cloning a loose pancreas for transplants?"
    mc "Não poderíamos manter esse conhecimento fazendo... sei lá... clones de animais ou algo assim? Clonando um pâncreas avulso para transplantes?"

# game/scripts/c31/c31.rpy:2959
translate brazilian c31s006_departmentMeeting_b5345e3d:

    # "You feel a bit stupid. You should have studied alternatives for NTR's central department."
    "Você se sente um pouco estúpido. Você deveria ter estudado alternativas para o departamento central da NTR."

# game/scripts/c31/c31.rpy:2960
translate brazilian c31s006_departmentMeeting_8f120e10:

    # "You feel like you're just talking without knowing what you are talking about. You finally understand how [emm] feels a lot of the time."
    "Você sente que está apenas falando sem saber sobre o que está falando. Você finalmente entende como a [emm] se sente na maior parte do tempo."

# game/scripts/c31/c31.rpy:2962
translate brazilian c31s006_departmentMeeting_a69e0430:

    # mael "A loose pancreas?"
    mael "Um pâncreas solto?"

# game/scripts/c31/c31.rpy:2963
translate brazilian c31s006_departmentMeeting_53b10eb4:

    # mc "Or whatever. A kidney. I'm just improvising, I'm not a biologist or a geneticist."
    mc "Ou o que seja. Um rim. Eu só estou improvisando, não sou biólogo nem geneticista."

# game/scripts/c31/c31.rpy:2964
translate brazilian c31s006_departmentMeeting_f52d080e:

    # mael "No, yeah... I can see you're improvising."
    mael "Não, é... Dá pra ver que você tá improvisando."

# game/scripts/c31/c31.rpy:2965
translate brazilian c31s006_departmentMeeting_84fa2f30:

    # "His tone seems to say that if he had a gun in his hands right now, he'd rather pull the trigger than have to deal with you."
    "O tom dele parece dizer que se ele tivesse uma arma nas mãos agora, preferiria puxar o gatilho a ter que lidar com você."

# game/scripts/c31/c31.rpy:2967
translate brazilian c31s006_departmentMeeting_60ddea4a:

    # "[mael] takes a deep breath before continuing, as if gathering the patience to explain something basic to a child."
    "[mael] respira fundo antes de continuar, como se estivesse reunindo paciência para explicar algo básico para uma criança."

# game/scripts/c31/c31.rpy:2968
translate brazilian c31s006_departmentMeeting_4809f22b:

    # mael "Animals would be viable, yes."
    mael "Animais seriam viáveis, sim."

# game/scripts/c31/c31.rpy:2969
translate brazilian c31s006_departmentMeeting_146d7360:

    # mael "There wouldn't be any legal problems in Aruba, and from a technical standpoint, it would allow us to maintain the team's skills and keep researching."
    mael "Não haveria problemas legais em Aruba e, do ponto de vista técnico, isso nos permitiria manter as habilidades da equipe e continuar pesquisando."

# game/scripts/c31/c31.rpy:2970
translate brazilian c31s006_departmentMeeting_78660419:

    # mael "Pigs, primates, even endangered animals if we want to give it a positive public image angle."
    mael "Porcos, primatas, até mesmo animais em risco de extinção se quisermos dar um ângulo positivo para a imagem pública."

# game/scripts/c31/c31.rpy:2972
translate brazilian c31s006_departmentMeeting_0398d4eb:

    # mael "Isolated human organs are a different story."
    mael "Órgãos humanos isolados são outra história."

# game/scripts/c31/c31.rpy:2973
translate brazilian c31s006_departmentMeeting_7e196cab:

    # mael "It's technically possible, but there are huge obstacles: vascularization, immune rejection, maturation outside of a complete organism. It hasn't been solved."
    mael "É tecnicamente possível, mas há obstáculos enormes: vascularização, rejeição imunológica, maturação fora de um organismo completo. Isso não foi resolvido."

# game/scripts/c31/c31.rpy:2974
translate brazilian c31s006_departmentMeeting_e9a74422:

    # mael "It would be a research project, not a short-term product."
    mael "Seria um projeto de pesquisa, não um produto de curto prazo."

# game/scripts/c31/c31.rpy:2975
translate brazilian c31s006_departmentMeeting_8941e2bd:

    # mc "But is it worth a try?"
    mc "Mas vale a pena tentar?"

# game/scripts/c31/c31.rpy:2977
translate brazilian c31s006_departmentMeeting_fc69572f:

    # mael "I need to study it in more detail before giving you an honest answer."
    mael "Preciso estudar isso com mais detalhes antes de te dar uma resposta honesta."

# game/scripts/c31/c31.rpy:2978
translate brazilian c31s006_departmentMeeting_89babaaa:

    # mael "What I can tell you is that the idea of keeping the department open with that direction... doesn't displease me. In fact, I like it."
    mael "O que posso te dizer é que a ideia de manter o departamento aberto com essa direção... não me desagrada. Na verdade, eu gosto."

# game/scripts/c31/c31.rpy:2979
translate brazilian c31s006_departmentMeeting_cf1ffbc6:

    # "A slight feeling of surprise runs across the table. It seems no one expected [mael] to accept the change so easily."
    "Um leve sentimento de surpresa percorre a mesa. Parece que ninguém esperava que [mael] aceitasse a mudança tão facilmente."

# game/scripts/c31/c31.rpy:2981
translate brazilian c31s006_departmentMeeting_af97d9fc:

    # mael "Most of the medical products that have come out of my department have been happy accidents."
    mael "A maioria dos produtos médicos que saíram do meu departamento foram acidentes felizes."

# game/scripts/c31/c31.rpy:2982
translate brazilian c31s006_departmentMeeting_b4a35668:

    # mael "Side effects of research where we were heading in another direction. Do you know how our rapid pregnancy test came about?"
    mael "Efeitos colaterais de pesquisas onde estávamos indo em outra direção. Sabe como surgiu o nosso teste de gravidez rápido?"

# game/scripts/c31/c31.rpy:2984
translate brazilian c31s006_departmentMeeting_762a101a:

    # flo "The one we'll start marketing in the European Union next month?"
    flo "Aquele que vamos começar a comercializar na União Europeia no mês que vem?"

# game/scripts/c31/c31.rpy:2985
translate brazilian c31s006_departmentMeeting_b415f974:

    # mael "Yes, that exact one."
    mael "Sim, exatamente esse."

# game/scripts/c31/c31.rpy:2987
translate brazilian c31s006_departmentMeeting_fd64c5fa:

    # mael "Well, it came about because we were studying molecular markers in early-stage embryos and one of my researchers detected something weird."
    mael "Bom, surgiu porque estávamos estudando marcadores moleculares em embriões em estágio inicial e um dos meus pesquisadores detectou algo estranho."

# game/scripts/c31/c31.rpy:2988
translate brazilian c31s006_departmentMeeting_1b694428:

    # mael "There was a molecule that the body produces long before hCG levels, the traditional pregnancy hormone, are detectable."
    mael "Havia uma molécula que o corpo produz muito antes dos níveis de hCG, o hormônio tradicional da gravidez, serem detectáveis."

# game/scripts/c31/c31.rpy:2989
translate brazilian c31s006_departmentMeeting_e53d55a4:

    # mael "We detect pregnancies several weeks earlier than any test on the market."
    mael "Nós detectamos gravidezes várias semanas antes de qualquer teste no mercado."

# game/scripts/c31/c31.rpy:2991
translate brazilian c31s006_departmentMeeting_b0910916:

    # mael "Were we looking for that? No. We were looking for something completely different."
    mael "Estávamos procurando por isso? Não. Estávamos procurando por algo completamente diferente."

# game/scripts/c31/c31.rpy:2992
translate brazilian c31s006_departmentMeeting_03400293:

    # mael "But that's how frontier research works. If you close the lab, you also close doors you don't even know are there."
    mael "Mas é assim que a pesquisa de ponta funciona. Se você fechar o laboratório, também fecha portas que nem sabe que estão lá."

# game/scripts/c31/c31.rpy:2993
translate brazilian c31s006_departmentMeeting_43446e1d:

    # mael "The doors might not even exist, or what's behind them might not be worth it, but sometimes..."
    mael "As portas podem nem existir, ou o que está atrás delas pode não valer a pena, mas às vezes..."

# game/scripts/c31/c31.rpy:2994
translate brazilian c31s006_departmentMeeting_b6967b68:

    # mc "I get it..."
    mc "Eu entendi..."

# game/scripts/c31/c31.rpy:2996
translate brazilian c31s006_departmentMeeting_8e10ced4:

    # "[bet], who until that moment had been looking at the arm with the concentration of someone taking a patient's pulse, looks up."
    "[bet], que até aquele momento estava olhando para o braço com a concentração de alguém medindo o pulso de um paciente, levanta o olhar."

# game/scripts/c31/c31.rpy:2997
translate brazilian c31s006_departmentMeeting_152c853e:

    # bet "Sorry to interrupt... how many of those forty-two subjects have genetic anomalies detected at this stage?"
    bet "Desculpe interromper... quantos desses quarenta e dois indivíduos têm anomalias genéticas detectadas nesta fase?"

# game/scripts/c31/c31.rpy:2998
translate brazilian c31s006_departmentMeeting_aa92ca51:

    # mael "None. Our clones are perfect within the parameters. Nothing we haven't handled before."
    mael "Nenhum. Nossos clones são perfeitos dentro dos parâmetros. Nada com que não tenhamos lidado antes."

# game/scripts/c31/c31.rpy:2999
translate brazilian c31s006_departmentMeeting_c502921a:

    # bet "And the protocol if there are complications during... birth?"
    bet "E o protocolo se houver complicações durante o... parto?"

# game/scripts/c31/c31.rpy:3000
translate brazilian c31s006_departmentMeeting_bed15091:

    # mael "We have an internal medical team specialized in that."
    mael "Temos uma equipe médica interna especializada nisso."

# game/scripts/c31/c31.rpy:3001
translate brazilian c31s006_departmentMeeting_dfc3ea70:

    # bet "Neonatologists?"
    bet "Neonatologistas?"

# game/scripts/c31/c31.rpy:3002
translate brazilian c31s006_departmentMeeting_4ff43295:

    # mael "Hired externally when necessary."
    mael "Contratados externamente quando necessário."

# game/scripts/c31/c31.rpy:3003
translate brazilian c31s006_departmentMeeting_715b8968:

    # bet "Alright. Just asking."
    bet "Tudo bem. Só perguntando."

# game/scripts/c31/c31.rpy:3005
translate brazilian c31s006_departmentMeeting_f82768d2:

    # "[bet] looks at the arm again. She doesn't seem entirely satisfied with the answer, but she doesn't push it."
    "[bet] olha para o braço de novo. Ela não parece totalmente satisfeita com a resposta, mas não insiste."

# game/scripts/c31/c31.rpy:3006
translate brazilian c31s006_departmentMeeting_0c5d71f1:

    # mc "Good. Let's move on. [cal]."
    mc "Bom. Vamos em frente. [cal]."

# game/scripts/c31/c31.rpy:3008
translate brazilian c31s006_departmentMeeting_41a92896:

    # "[cal] hasn't spoken until now. He has been looking at the arm, just like [bet], although with a very different expression."
    "[cal] não tinha falado até agora. Ele estava olhando para o braço, assim como [bet], embora com uma expressão bem diferente."

# game/scripts/c31/c31.rpy:3009
translate brazilian c31s006_departmentMeeting_19d12001:

    # "That of someone looking proudly at something they built with their own hands because no one paid them enough attention."
    "A de alguém olhando com orgulho para algo que construiu com as próprias mãos porque ninguém lhe deu atenção suficiente."

# game/scripts/c31/c31.rpy:3010
translate brazilian c31s006_departmentMeeting_92496b3f:

    # "He is one of the few clones who have left field operations and successfully retrained for other roles."
    "Ele é um dos poucos clones que deixaram as operações de campo e se requalificaram com sucesso para outras funções."

# game/scripts/c31/c31.rpy:3011
translate brazilian c31s006_departmentMeeting_dc816664:

    # cal "The arm is functional. All the tests we've been able to run without an actual implantation give results within the expected parameters."
    cal "O braço é funcional. Todos os testes que conseguimos realizar sem um implante real deram resultados dentro dos parâmetros esperados."

# game/scripts/c31/c31.rpy:3012
translate brazilian c31s006_departmentMeeting_a453d02d:

    # cal "The neuromuscular integration system is the most delicate part."
    cal "O sistema de integração neuromuscular é a parte mais delicada."

# game/scripts/c31/c31.rpy:3013
translate brazilian c31s006_departmentMeeting_1898ae7a:

    # cal "Basically, we tell the peripheral nervous system that this piece of titanium and rubber is a limb, and we hope it believes it."
    cal "Basicamente, dizemos ao sistema nervoso periférico que esse pedaço de titânio e borracha é um membro, e esperamos que ele acredite."

# game/scripts/c31/c31.rpy:3015
translate brazilian c31s006_departmentMeeting_28871556:

    # flo "And does the peri... the nervous system believe it?"
    flo "E o peri... o sistema nervoso acredita nisso?"

# game/scripts/c31/c31.rpy:3016
translate brazilian c31s006_departmentMeeting_7aabb92b:

    # cal "The simulation models say yes. But until we do it on a real person, it's just theory."
    cal "Os modelos de simulação dizem que sim. Mas até fazermos isso em uma pessoa real, é só teoria."

# game/scripts/c31/c31.rpy:3017
translate brazilian c31s006_departmentMeeting_e11cf90e:

    # flo "Right, right..."
    flo "Certo, certo..."

# game/scripts/c31/c31.rpy:3018
translate brazilian c31s006_departmentMeeting_fe32cd00:

    # "[flo] nods with that kind of nod people do when they're actually thinking about something else. Maybe they're starting to think about where they can sell it."
    "[flo] acena com a cabeça com aquele tipo de aceno que as pessoas fazem quando na verdade estão pensando em outra coisa. Talvez ele esteja começando a pensar em onde pode vender isso."

# game/scripts/c31/c31.rpy:3019
translate brazilian c31s006_departmentMeeting_2a29672a:

    # mc "What can that arm do that a natural one can't?"
    mc "O que esse braço pode fazer que um natural não pode?"

# game/scripts/c31/c31.rpy:3021
translate brazilian c31s006_departmentMeeting_514e0087:

    # cal "In terms of strength, quite a bit more. We're not going to turn [gav] into the Autumn Soldier, just to be clear."
    cal "Em termos de força, bem mais. Não vamos transformar o [gav] no Soldado de Outono, só para deixar claro."

# game/scripts/c31/c31.rpy:3022
translate brazilian c31s006_departmentMeeting_93ecd837:

    # cal "But he will have muscular strength in that arm equivalent to two to three times that of his original arm."
    cal "Mas ele terá uma força muscular nesse braço equivalente a duas ou três vezes a do seu braço original."

# game/scripts/c31/c31.rpy:3024
translate brazilian c31s006_departmentMeeting_466e155d:

    # cal "Fine motor control, precision tasks, that's going to require rehabilitation and time. It's a process."
    cal "Controle motor fino, tarefas de precisão, isso vai exigir reabilitação e tempo. É um processo."

# game/scripts/c31/c31.rpy:3025
translate brazilian c31s006_departmentMeeting_1db19429:

    # cal "It's not an instant upgrade; it's a recovery with added perks."
    cal "Não é um upgrade instantâneo; é uma recuperação com vantagens adicionais."

# game/scripts/c31/c31.rpy:3026
translate brazilian c31s006_departmentMeeting_35859867:

    # mc "And could we do the same with other limbs? Legs, for example? Or hands...?"
    mc "E poderíamos fazer o mesmo com outros membros? Pernas, por exemplo? Ou mãos...?"

# game/scripts/c31/c31.rpy:3028
translate brazilian c31s006_departmentMeeting_bbb8fa51:

    # cal "In principle, the architecture can be extrapolated. Legs have more mass, more structural load, the balance system adds complexity..."
    cal "Em princípio, a arquitetura pode ser extrapolada. Pernas têm mais massa, mais carga estrutural, o sistema de equilíbrio adiciona complexidade..."

# game/scripts/c31/c31.rpy:3029
translate brazilian c31s006_departmentMeeting_ae5be5b0:

    # cal "A hand or a forearm would be simple to design based on the arm. The problem would be the total weight and battery life."
    cal "Uma mão ou um antebraço seria simples de projetar com base no braço. O problema seria o peso total e a duração da bateria."

# game/scripts/c31/c31.rpy:3031
translate brazilian c31s006_departmentMeeting_1b4c2492:

    # cal "But if [gav]'s surgery goes well, I don't see why not."
    cal "Mas se a cirurgia do [gav] correr bem, não vejo por que não."

# game/scripts/c31/c31.rpy:3032
translate brazilian c31s006_departmentMeeting_4c4d1ff4:

    # cal "It's work, not magic. And we've already done the hardest part."
    cal "É trabalho, não mágica. E já fizemos a parte mais difícil."

# game/scripts/c31/c31.rpy:3034
translate brazilian c31s006_departmentMeeting_7554c245:

    # bet "How long have you been developing this?"
    bet "Há quanto tempo você está desenvolvendo isso?"

# game/scripts/c31/c31.rpy:3035
translate brazilian c31s006_departmentMeeting_9dd5abb2:

    # cal "Seven years. In my free time."
    cal "Sete anos. No meu tempo livre."

# game/scripts/c31/c31.rpy:3036
translate brazilian c31s006_departmentMeeting_31e6f40a:

    # bet "In your free time?"
    bet "No seu tempo livre?"

# game/scripts/c31/c31.rpy:3037
translate brazilian c31s006_departmentMeeting_64d26b3a:

    # cal "The company didn't consider it a priority until I put the prototype on the table."
    cal "A empresa não considerava isso uma prioridade até eu colocar o protótipo na mesa."

# game/scripts/c31/c31.rpy:3039
translate brazilian c31s006_departmentMeeting_9326bc02:

    # bet "And do you have...?"
    bet "E você tem...?"

# game/scripts/c31/c31.rpy:3040
translate brazilian c31s006_departmentMeeting_9296ded0:

    # cal "A mechanical hand? Me? No. I never made it that high up the priority list."
    cal "Uma mão mecânica? Eu? Não. Eu nunca cheguei tão alto na lista de prioridades."

# game/scripts/c31/c31.rpy:3041
translate brazilian c31s006_departmentMeeting_dbf775cd:

    # bet "Well, that's the first thing we should fix when we're done with [gav]."
    bet "Bom, essa é a primeira coisa que devemos resolver quando terminarmos com o [gav]."

# game/scripts/c31/c31.rpy:3043
translate brazilian c31s006_departmentMeeting_a1aac41c:

    # "[bet] looks at you apologetically in case she overstepped."
    "[bet] olha para você com um olhar de desculpas, caso tenha passado dos limites."

# game/scripts/c31/c31.rpy:3044
translate brazilian c31s006_departmentMeeting_8e1a0aed:

    # "[cal] says nothing, but looks at you with a mix of anticipation and hope."
    "[cal] não diz nada, mas olha para você com uma mistura de expectativa e esperança."

# game/scripts/c31/c31.rpy:3045
translate brazilian c31s006_departmentMeeting_8cbf93b6:

    # mc "I agree with that proposal."
    mc "Eu concordo com essa proposta."

# game/scripts/c31/c31.rpy:3046
translate brazilian c31s006_departmentMeeting_ad04ddba:

    # vin "From a budgetary standpoint, an additional unit of the prototype shouldn't be a..."
    vin "Do ponto de vista orçamentário, uma unidade adicional do protótipo não deveria ser um..."

# game/scripts/c31/c31.rpy:3047
translate brazilian c31s006_departmentMeeting_2ff084c3:

    # mc "[vin], it's not a budgetary decision. It's a debt."
    mc "[vin], não é uma decisão orçamentária. É uma dívida."

# game/scripts/c31/c31.rpy:3048
translate brazilian c31s006_departmentMeeting_f8dca959:

    # vin "Understood."
    vin "Entendido."

# game/scripts/c31/c31.rpy:3050
translate brazilian c31s006_departmentMeeting_d1155cd4:

    # flo "If you'll allow me to get back to the commercial side for a moment..."
    flo "Se me permitem voltar ao lado comercial por um momento..."

# game/scripts/c31/c31.rpy:3051
translate brazilian c31s006_departmentMeeting_590b3479:

    # flo "If [gav]'s operation is a success, and I'm convinced it will be, we're looking at something that doesn't exist anywhere else."
    flo "Se a operação do [gav] for um sucesso, e estou convencido de que será, estamos diante de algo que não existe em nenhum outro lugar."

# game/scripts/c31/c31.rpy:3053
translate brazilian c31s006_departmentMeeting_8c744874:

    # flo "There is no prosthesis on the market with this level of neuromuscular integration."
    flo "Não há prótese no mercado com esse nível de integração neuromuscular."

# game/scripts/c31/c31.rpy:3054
translate brazilian c31s006_departmentMeeting_82b40b02:

    # flo "None. I've studied it and the most advanced competitors are years away."
    flo "Nenhuma. Eu estudei isso e os concorrentes mais avançados estão a anos de distância."

# game/scripts/c31/c31.rpy:3055
translate brazilian c31s006_departmentMeeting_65a0f41a:

    # flo "The potential market is huge: military, civilians, elite athletes, workplace accidents, degenerative diseases..."
    flo "O mercado potencial é enorme: militares, civis, atletas de elite, acidentes de trabalho, doenças degenerativas..."

# game/scripts/c31/c31.rpy:3056
translate brazilian c31s006_departmentMeeting_788216b8:

    # flo "We could go from the premium hospital segment to medical insurance agreements. It's exactly the kind of high-tech product you were talking about, [mc]."
    flo "Poderíamos ir do segmento de hospitais premium para acordos de seguro médico. É exatamente o tipo de produto de alta tecnologia de que você estava falando, [mc]."

# game/scripts/c31/c31.rpy:3057
translate brazilian c31s006_departmentMeeting_0325cf8a:

    # mc "That's exactly it."
    mc "É exatamente isso."

# game/scripts/c31/c31.rpy:3059
translate brazilian c31s006_departmentMeeting_081f9d77:

    # ama "Although the patent issue would have to be resolved first. If this was developed inside the company in... free time, you said?"
    ama "Embora a questão da patente tenha que ser resolvida primeiro. Se isso foi desenvolvido dentro da empresa no... tempo livre, você disse?"

# game/scripts/c31/c31.rpy:3060
translate brazilian c31s006_departmentMeeting_4d33f325:

    # cal "Yes."
    cal "Sim."

# game/scripts/c31/c31.rpy:3061
translate brazilian c31s006_departmentMeeting_5b5b1de6:

    # ama "That could create ambiguity in intellectual property. We'd need to clean that up before launching to market."
    ama "Isso poderia criar ambiguidade na propriedade intelectual. Precisaríamos resolver isso antes de lançar no mercado."

# game/scripts/c31/c31.rpy:3062
translate brazilian c31s006_departmentMeeting_729cfafb:

    # cal "Whatever is necessary."
    cal "O que for necessário."

# game/scripts/c31/c31.rpy:3063
translate brazilian c31s006_departmentMeeting_8ef747fc:

    # mc "Good. Then let's recap what we have on the table, literally and metaphorically."
    mc "Ótimo. Então vamos recapitular o que temos na mesa, literal e metaforicamente."

# game/scripts/c31/c31.rpy:3065
translate brazilian c31s006_departmentMeeting_b89df83f:

    # mc "The covert operations committed for the next two quarters will be carried out. [aar], we're not going to leave any contracts unfulfilled."
    mc "As operações secretas comprometidas para os próximos dois trimestres serão realizadas. [aar], não vamos deixar nenhum contrato por cumprir."

# game/scripts/c31/c31.rpy:3066
translate brazilian c31s006_departmentMeeting_99d46b80:

    # aar "Thank you."
    aar "Obrigado."

# game/scripts/c31/c31.rpy:3068
translate brazilian c31s006_departmentMeeting_afbdee79:

    # mc "[flo], negotiations with Colombia and the United States are moving forward for now."
    mc "[flo], as negociações com a Colômbia e os Estados Unidos estão avançando por enquanto."

# game/scripts/c31/c31.rpy:3069
translate brazilian c31s006_departmentMeeting_c8c77ded:

    # mc "China and Israel need to be studied carefully. North Korea and Iran remain banned, or we run the risk of sanctions."
    mc "China e Israel precisam ser estudados com cuidado. Coreia do Norte e Irã continuam banidos, ou corremos o risco de sofrer sanções."

# game/scripts/c31/c31.rpy:3070
translate brazilian c31s006_departmentMeeting_bc3fbb39:

    # mc "But I want you to start exploring contacts in the medical sector in parallel."
    mc "Mas quero que você comece a explorar contatos no setor médico em paralelo."

# game/scripts/c31/c31.rpy:3071
translate brazilian c31s006_departmentMeeting_79762cb3:

    # mc "Hospitals, insurance companies, healthcare investment funds. Not for tomorrow, but I want to know what's out there."
    mc "Hospitais, seguradoras, fundos de investimento em saúde. Não para amanhã, mas quero saber o que tem por aí."

# game/scripts/c31/c31.rpy:3072
translate brazilian c31s006_departmentMeeting_e5df2b21:

    # mc "I also want to know what technologies we have that can be sold or manufactured, and whose commercial possibilities we haven't explored yet."
    mc "Também quero saber quais tecnologias temos que podem ser vendidas ou fabricadas, e cujas possibilidades comerciais ainda não exploramos."

# game/scripts/c31/c31.rpy:3073
translate brazilian c31s006_departmentMeeting_605259e4:

    # flo "Consider it done."
    flo "Considere feito."

# game/scripts/c31/c31.rpy:3075
translate brazilian c31s006_departmentMeeting_569c1da7:

    # mc "[mael], I want a report in two weeks on the real viability of keeping the cloning department focused on animals and organ research."
    mc "[mael], quero um relatório em duas semanas sobre a real viabilidade de manter o departamento de clonagem focado em animais e pesquisa de órgãos."

# game/scripts/c31/c31.rpy:3076
translate brazilian c31s006_departmentMeeting_00eb2451:

    # mc "No compromises, just data."
    mc "Sem concessões, apenas dados."

# game/scripts/c31/c31.rpy:3077
translate brazilian c31s006_departmentMeeting_d30b29a9:

    # mael "Two weeks. Understood."
    mael "Duas semanas. Entendido."

# game/scripts/c31/c31.rpy:3078
translate brazilian c31s006_departmentMeeting_0e2e7a77:

    # mc "The forty-two subjects currently in gestation... we're going to guarantee they get a proper welcome and are given a suitable outcome, whatever that may be."
    mc "Os quarenta e dois sujeitos atualmente em gestação... vamos garantir que recebam as boas-vindas adequadas e tenham um desfecho apropriado, seja ele qual for."

# game/scripts/c31/c31.rpy:3079
translate brazilian c31s006_departmentMeeting_84c837a9:

    # mc "We're not who we used to be. I don't think they'll become field operatives."
    mc "Não somos mais quem costumávamos ser. Não acho que eles se tornarão agentes de campo."

# game/scripts/c31/c31.rpy:3081
translate brazilian c31s006_departmentMeeting_854445a9:

    # mc "[vin], I need you to prepare three financial scenarios for me."
    mc "[vin], preciso que você prepare três cenários financeiros para mim."

# game/scripts/c31/c31.rpy:3082
translate brazilian c31s006_departmentMeeting_e4d39871:

    # mc "One with the company as it is, one with the gradual shutdown of covert operations, and one with a serious investment in the medical division."
    mc "Um com a empresa como está, um com o encerramento gradual das operações secretas e um com um investimento sério na divisão médica."

# game/scripts/c31/c31.rpy:3083
translate brazilian c31s006_departmentMeeting_1d0a32fe:

    # mc "Real numbers, not optimistic projections."
    mc "Números reais, não projeções otimistas."

# game/scripts/c31/c31.rpy:3084
translate brazilian c31s006_departmentMeeting_d267c4b5:

    # vin "When?"
    vin "Quando?"

# game/scripts/c31/c31.rpy:3085
translate brazilian c31s006_departmentMeeting_b3e51eee:

    # mc "Next week."
    mc "Semana que vem."

# game/scripts/c31/c31.rpy:3086
translate brazilian c31s006_departmentMeeting_4783c894:

    # vin "Sure."
    vin "Claro."

# game/scripts/c31/c31.rpy:3088
translate brazilian c31s006_departmentMeeting_85ec888d:

    # mc "[ama], operational security during the transition. I need no one on the outside to know we're changing course until we're ready to announce it ourselves."
    mc "[ama], segurança operacional durante a transição. Preciso que ninguém de fora saiba que estamos mudando de rumo até estarmos prontos para anunciar nós mesmos."

# game/scripts/c31/c31.rpy:3089
translate brazilian c31s006_departmentMeeting_4a06d11e:

    # ama "Understood."
    ama "Entendido."

# game/scripts/c31/c31.rpy:3091
translate brazilian c31s006_departmentMeeting_11b93c94:

    # mc "And [cal]..."
    mc "E [cal]..."

# game/scripts/c31/c31.rpy:3092
translate brazilian c31s006_departmentMeeting_3a412510:

    # mc "What you and your team have done is extraordinary."
    mc "O que você e sua equipe fizeram é extraordinário."

# game/scripts/c31/c31.rpy:3093
translate brazilian c31s006_departmentMeeting_f483d35b:

    # mc "I want [gav]'s operation to be a success, and I want you to have your hand."
    mc "Quero que a operação do [gav] seja um sucesso, e quero que você tenha sua mão."

# game/scripts/c31/c31.rpy:3094
translate brazilian c31s006_departmentMeeting_6312b14e:

    # mc "In that order, but I want both."
    mc "Nessa ordem, mas eu quero os dois."

# game/scripts/c31/c31.rpy:3095
translate brazilian c31s006_departmentMeeting_e4a4f714:

    # cal "Agreed."
    cal "De acordo."

# game/scripts/c31/c31.rpy:3097
translate brazilian c31s006_departmentMeeting_80ede5b5:

    # bet "I've reviewed the implantation protocol three times and I have some suggestions for the procedure that I'd like to discuss with you, [cal], before going into surgery."
    bet "Revisei o protocolo de implantação três vezes e tenho algumas sugestões para o procedimento que gostaria de discutir com você, [cal], antes de ir para a cirurgia."

# game/scripts/c31/c31.rpy:3098
translate brazilian c31s006_departmentMeeting_6e5a6591:

    # cal "Whenever you want."
    cal "Quando você quiser."

# game/scripts/c31/c31.rpy:3099
translate brazilian c31s006_departmentMeeting_1027abb3:

    # bet "This afternoon?"
    bet "Esta tarde?"

# game/scripts/c31/c31.rpy:3100
translate brazilian c31s006_departmentMeeting_4643f46b:

    # cal "This afternoon."
    cal "Esta tarde."

# game/scripts/c31/c31.rpy:3102
translate brazilian c31s006_departmentMeeting_ef97fcde:

    # flo "Do you know what would be a perfect marketing story?"
    flo "Sabe o que seria uma história de marketing perfeita?"

# game/scripts/c31/c31.rpy:3103
translate brazilian c31s006_departmentMeeting_8ca89ddc:

    # flo "The engineer who designed the prosthesis because he needed it, receiving the prosthesis he designed. That's worth more than any ad campaign."
    flo "O engenheiro que projetou a prótese porque precisava dela, recebendo a prótese que ele mesmo projetou. Isso vale mais do que qualquer campanha publicitária."

# game/scripts/c31/c31.rpy:3104
translate brazilian c31s006_departmentMeeting_e4888b9b:

    # cal "I'm not an ad campaign, [flo]."
    cal "Eu não sou uma campanha publicitária, [flo]."

# game/scripts/c31/c31.rpy:3105
translate brazilian c31s006_departmentMeeting_139e482b:

    # flo "I know. That's why it would work."
    flo "Eu sei. É por isso que funcionaria."

# game/scripts/c31/c31.rpy:3107
translate brazilian c31s006_departmentMeeting_ee5012d9:

    # ama "[flo]..."
    ama "[flo]..."

# game/scripts/c31/c31.rpy:3108
translate brazilian c31s006_departmentMeeting_1c50af4c:

    # flo "What? It's true."
    flo "O que foi? É verdade."

# game/scripts/c31/c31.rpy:3109
translate brazilian c31s006_departmentMeeting_e25971c4:

    # ama "It is true. And even so..."
    ama "É verdade. E mesmo assim..."

# game/scripts/c31/c31.rpy:3110
translate brazilian c31s006_departmentMeeting_1b9e71c5:

    # vin "If we're done with the emotional part... can we wrap up this meeting? I have to prepare three reports..."
    vin "Se já terminamos com a parte emocional... podemos encerrar essa reunião? Tenho que preparar três relatórios..."

# game/scripts/c31/c31.rpy:3111
translate brazilian c31s006_departmentMeeting_4aab074c:

    # mc "I don't think there's anything else to talk about."
    mc "Acho que não temos mais nada para conversar."

# game/scripts/c31/c31.rpy:3113
translate brazilian c31s006_departmentMeeting_271e4c07:

    # "People start getting up."
    "As pessoas começam a se levantar."

# game/scripts/c31/c31.rpy:3114
translate brazilian c31s006_departmentMeeting_0fc156a4:

    # "[bet] slowly walks around the table and stops next to the electromechanical arm. She looks at it closely, without touching it, as if she were reading something written on it."
    "[bet] anda lentamente ao redor da mesa e para ao lado do braço eletromecânico. Ela olha de perto, sem tocar, como se estivesse lendo algo escrito nele."

# game/scripts/c31/c31.rpy:3115
translate brazilian c31s006_departmentMeeting_19d2a449:

    # bet "How much does it weigh? It looks heavier than in the specs you sent me."
    bet "Quanto pesa? Parece mais pesado do que nas especificações que você me enviou."

# game/scripts/c31/c31.rpy:3117
translate brazilian c31s006_departmentMeeting_6be20864:

    # cal "This is the prototype. It weighs a little more than the one you'll implant. Four kilos, one hundred grams. And it doesn't have the batteries."
    cal "Este é o protótipo. Pesa um pouco mais do que o que você vai implantar. Quatro quilos e cem gramas. E está sem as baterias."

# game/scripts/c31/c31.rpy:3118
translate brazilian c31s006_departmentMeeting_87a6afc6:

    # cal "The one you'll put on [gav], three kilos, eight hundred grams in total."
    cal "O que você vai colocar no [gav], três quilos e oitocentos gramas no total."

# game/scripts/c31/c31.rpy:3119
translate brazilian c31s006_departmentMeeting_67a68b86:

    # "He sounds like a proud father."
    "Ele soa como um pai orgulhoso."

# game/scripts/c31/c31.rpy:3121
translate brazilian c31s006_departmentMeeting_9a8b8a88:

    # bet "Less than I expected."
    bet "Menos do que eu esperava."

# game/scripts/c31/c31.rpy:3122
translate brazilian c31s006_departmentMeeting_709652dc:

    # cal "It was a design requirement. If it weighs too much, the shoulder pays for it in the long run."
    cal "Foi um requisito do projeto. Se pesar muito, o ombro paga o preço a longo prazo."

# game/scripts/c31/c31.rpy:3123
translate brazilian c31s006_departmentMeeting_4328d08d:

    # bet "You thought of everything."
    bet "Você pensou em tudo."

# game/scripts/c31/c31.rpy:3124
translate brazilian c31s006_departmentMeeting_2e29ef91:

    # cal "I had seven years to do it."
    cal "Eu tive sete anos para isso."

# game/scripts/c31/c31.rpy:3126
translate brazilian c31s006_departmentMeeting_5e264f03:

    # vin "*Muttering to himself* Daniels also thought he had everything figured out."
    vin "*Resmungando para si mesmo* Daniels também achava que tinha pensado em tudo."

# game/scripts/c31/c31.rpy:3127
translate brazilian c31s006_departmentMeeting_0f8ef23c:

    # "You prefer not to answer and head with [ama] to your office to review the files of the clones you'll be meeting with in a little over an hour."
    "Você prefere não responder e vai com [ama] para o seu escritório para revisar os arquivos dos clones com os quais você vai se encontrar em pouco mais de uma hora."

# game/scripts/c31/c31.rpy:3129
translate brazilian c31s006_departmentMeeting_31652e76:

    # "You stop for a moment in front of a window."
    "Você para por um momento em frente a uma janela."

# game/scripts/c31/c31.rpy:3130
translate brazilian c31s006_departmentMeeting_017a6969:

    # "Outside, the Caribbean shines in the distance with that perfect indifference the sea has when it doesn't know someone is watching it."
    "Lá fora, o Caribe brilha ao longe com aquela indiferença perfeita que o mar tem quando não sabe que alguém o está observando."

# game/scripts/c31/c31.rpy:3131
translate brazilian c31s006_departmentMeeting_38152f55:

    # "Someone who has just inherited an illegal enterprise and who has the intention, still without a precise shape, to turn it into something different."
    "Alguém que acabou de herdar uma empresa ilegal e que tem a intenção, ainda sem uma forma precisa, de transformá-la em algo diferente."

# game/scripts/c31/c31.rpy:3132
translate brazilian c31s006_departmentMeeting_d4666650:

    # "It's a good start. Or at least, it's a start."
    "É um bom começo. Ou pelo menos, é um começo."

# game/scripts/c31/c31.rpy:2541
translate brazilian c31s006_cloneMeeting_5d882aa2:

    # "Later, back in the meeting room and after the introductions..."
    "Mais tarde, de volta à sala de reuniões e após as apresentações..."

# game/scripts/c31/c31.rpy:2542
translate brazilian c31s006_cloneMeeting_d9a84e78:

    # mc "Thank you all for coming on such short notice. I know this is new for a lot of you."
    mc "Obrigado a todos por virem em cima da hora. Eu sei que isso é novo para muitos de vocês."

# game/scripts/c31/c31.rpy:2543
translate brazilian c31s006_cloneMeeting_36093761:

    # mc "First of all, let me introduce myself. I'm [mc] Marks and I'm acting as the new CEO. This is as new to me as it is to you."
    mc "Antes de mais nada, deixem-me apresentar. Sou [mc] Marks e estou atuando como o novo CEO. Isso é tão novo para mim quanto é para vocês."

# game/scripts/c31/c31.rpy:2544
translate brazilian c31s006_cloneMeeting_92a548af:

    # mc "My intention is to listen to you. You have the floor to raise whatever you need."
    mc "Minha intenção é ouvir vocês. Vocês têm a palavra para levantar o que precisarem."

# game/scripts/c31/c31.rpy:2546
translate brazilian c31s006_cloneMeeting_40b3e942:

    # aar "We appreciate the gesture, [mc]. The guys have been wanting to talk to management for a while. They've never been given this opportunity before."
    aar "Agradecemos o gesto, [mc]. O pessoal já queria falar com a gerência há um tempo. Nunca deram essa oportunidade pra eles antes."

# game/scripts/c31/c31.rpy:2548
translate brazilian c31s006_cloneMeeting_0a0a0928:

    # ama "[mc] wanted this meeting to be open and unfiltered. You can speak freely."
    ama "O [mc] queria que essa reunião fosse aberta e sem filtros. Vocês podem falar livremente."

# game/scripts/c31/c31.rpy:2549
translate brazilian c31s006_cloneMeeting_f2431388:

    # ama "[mc] is... different from the previous management."
    ama "O [mc] é... diferente da gerência anterior."

# game/scripts/c31/c31.rpy:2551
translate brazilian c31s006_cloneMeeting_5920525f:

    # dam "Seriously? We can ask for whatever we want?"
    dam "Sério? Podemos pedir o que quisermos?"

# game/scripts/c31/c31.rpy:2552
translate brazilian c31s006_cloneMeeting_52e3172c:

    # dam "Because I have a pretty interesting list..."
    dam "Porque eu tenho uma lista bem interessante..."

# game/scripts/c31/c31.rpy:2554
translate brazilian c31s006_cloneMeeting_267a1e65:

    # gav "[dam], please. Let's start with what's important. We agreed on a series of points yesterday."
    gav "[dam], por favor. Vamos começar pelo que é importante. Nós concordamos com uma série de pontos ontem."

# game/scripts/c31/c31.rpy:2556
translate brazilian c31s006_cloneMeeting_6545731e:

    # fred "[gav] is right. There are urgent matters on the table."
    fred "[gav] tem razão. Há assuntos urgentes na mesa."

# game/scripts/c31/c31.rpy:2558
translate brazilian c31s006_cloneMeeting_d22e1119:

    # carl "I've prepared a summary of the requests we agreed on in the previous meeting."
    carl "Eu preparei um resumo dos pedidos que concordamos na reunião anterior."

# game/scripts/c31/c31.rpy:2559
translate brazilian c31s006_cloneMeeting_b62c57a5:

    # carl "If it's alright with you, I'll go over them one by one."
    carl "Se estiver tudo bem para vocês, vou passar por eles um por um."

# game/scripts/c31/c31.rpy:2560
translate brazilian c31s006_cloneMeeting_bec1d115:

    # mc "Go ahead, Carl."
    mc "Vá em frente, Carl."

# game/scripts/c31/c31.rpy:2562
translate brazilian c31s006_cloneMeeting_98cff6b5:

    # carl "The first request is of a personal nature. The operatives want to be able to grow beards, or change their haircuts. The current regulations prohibit it."
    carl "O primeiro pedido é de natureza pessoal. Os agentes querem poder deixar a barba crescer ou mudar o corte de cabelo. O regulamento atual proíbe isso."

# game/scripts/c31/c31.rpy:2563
translate brazilian c31s006_cloneMeeting_11aa53e4:

    # carl "[aar] is the only operative you'll see with a beard on base, and that's because he let it grow while he was... off duty."
    carl "[aar] é o único agente que você verá com barba na base, e isso porque ele deixou crescer enquanto estava... de folga."

# game/scripts/c31/c31.rpy:2565
translate brazilian c31s006_cloneMeeting_d3af2b5f:

    # dam "I've been wanting to grow a beard for two years. Two years!"
    dam "Eu tô querendo deixar a barba crescer há dois anos. Dois anos!"

# game/scripts/c31/c31.rpy:2567
translate brazilian c31s006_cloneMeeting_1a59eca7:

    # gav "It's a matter of identity. For us... it means more than it seems."
    gav "É uma questão de identidade. Para nós... significa mais do que parece."

# game/scripts/c31/c31.rpy:2568
translate brazilian c31s006_cloneMeeting_a2603103:

    # mc "I understand. Is there any operational reason to keep that restriction, [ama]?"
    mc "Eu entendo. Tem algum motivo operacional para manter essa restrição, [ama]?"

# game/scripts/c31/c31.rpy:2570
translate brazilian c31s006_cloneMeeting_5fe2c92c:

    # ama "None that I can see. In some infiltration missions it might be relevant, but that can be handled on a case-by-case basis."
    ama "Nenhum que eu consiga ver. Em algumas missões de infiltração pode ser relevante, mas isso pode ser tratado caso a caso."

# game/scripts/c31/c31.rpy:2571
translate brazilian c31s006_cloneMeeting_012f0ad6:

    # ama "As long as it doesn't interfere with the equipment... gas masks, helmets, night vision goggles... I don't see a problem."
    ama "Contanto que não interfira no equipamento... máscaras de gás, capacetes, óculos de visão noturna... não vejo problema."

# game/scripts/c31/c31.rpy:2572
translate brazilian c31s006_cloneMeeting_70a1e99b:

    # mc "Alright. From now on, every operative can wear whatever personal style they prefer."
    mc "Certo. A partir de agora, cada agente pode usar o estilo pessoal que preferir."

# game/scripts/c31/c31.rpy:2573
translate brazilian c31s006_cloneMeeting_e379e758:

    # mc "If there's a mission that requires a specific look, you'll be notified in advance."
    mc "Se houver uma missão que exija um visual específico, vocês serão notificados com antecedência."

# game/scripts/c31/c31.rpy:2575
translate brazilian c31s006_cloneMeeting_350bba27:

    # gav "Thank you, [mc]. Really."
    gav "Obrigado, [mc]. De verdade."

# game/scripts/c31/c31.rpy:2576
translate brazilian c31s006_cloneMeeting_dafd1765:

    # fred "It was the bare minimum, but it's appreciated."
    fred "Foi o mínimo, mas a gente agradece."

# game/scripts/c31/c31.rpy:2577
translate brazilian c31s006_cloneMeeting_b7ad0f36:

    # dam "Finally! I'm going to grow some epic sideburns."
    dam "Até que enfim! Vou deixar crescer umas costeletas épicas."

# game/scripts/c31/c31.rpy:2578
translate brazilian c31s006_cloneMeeting_c9821169:

    # aar "[dam]..."
    aar "[dam]..."

# game/scripts/c31/c31.rpy:2580
translate brazilian c31s006_cloneMeeting_6e6be4ea:

    # dam "What? It's legit!"
    dam "Que foi? É válido!"

# game/scripts/c31/c31.rpy:2582
translate brazilian c31s006_cloneMeeting_5edb2419:

    # "Carl decides to ignore his partner and continue with the requests."
    "Carl decide ignorar seu parceiro e continuar com os pedidos."

# game/scripts/c31/c31.rpy:2583
translate brazilian c31s006_cloneMeeting_6445500f:

    # carl "The second request is more delicate. It's about Eric."
    carl "O segundo pedido é mais delicado. É sobre o Eric."

# game/scripts/c31/c31.rpy:2584
translate brazilian c31s006_cloneMeeting_443be3c6:

    # fred "Eric has been detained for a month, accused of treason."
    fred "Eric está detido há um mês, acusado de traição."

# game/scripts/c31/c31.rpy:2585
translate brazilian c31s006_cloneMeeting_290f8b0f:

    # dam "I never liked him... I didn't like anyone from E, but it's unfair."
    dam "Eu nunca gostei dele... Eu não gostava de ninguém do E, mas é injusto."

# game/scripts/c31/c31.rpy:2586
translate brazilian c31s006_cloneMeeting_09fdf597:

    # aar "He acted against the owners of the company, yes. But there's context."
    aar "Ele agiu contra os donos da empresa, sim. Mas tem um contexto."

# game/scripts/c31/c31.rpy:2587
translate brazilian c31s006_cloneMeeting_19c6561a:

    # mc "I know. I was reviewing the file. He was following Daniels' orders. He was his superior..."
    mc "Eu sei. Eu estava revisando o arquivo. Ele estava seguindo as ordens do Daniels. Ele era o superior dele..."

# game/scripts/c31/c31.rpy:2589
translate brazilian c31s006_cloneMeeting_ff5c7a7f:

    # ama "A superior who is now also under arrest, by the way."
    ama "Um superior que agora também está preso, por sinal."

# game/scripts/c31/c31.rpy:2590
translate brazilian c31s006_cloneMeeting_6054290a:

    # ama "A superior who ordered the murders of my sisters, the A's, and your family."
    ama "Um superior que ordenou os assassinatos das minhas irmãs, as A's, e da sua família."

# game/scripts/c31/c31.rpy:2592
translate brazilian c31s006_cloneMeeting_43ce085f:

    # gav "Nobody is saying Eric is a good guy, far from it. But he was caught in the crossfire. He didn't have a real choice."
    gav "Ninguém tá dizendo que o Eric é um cara bom, longe disso. Mas ele foi pego no fogo cruzado. Ele não teve uma escolha de verdade."

# game/scripts/c31/c31.rpy:2594
translate brazilian c31s006_cloneMeeting_97c7d6f5:

    # fred "We didn't have one either, back in those days. We did what we were told... Or there were consequences."
    fred "Nós também não tínhamos uma, naquela época. A gente fazia o que mandavam... Ou tinha consequências."

# game/scripts/c31/c31.rpy:2595
translate brazilian c31s006_cloneMeeting_ef160ee3:

    # fred "I was in the other operation at that time... We were misled, and if Eric should be arrested, [gav] or I should be too."
    fred "Eu estava na outra operação naquela época... Nós fomos enganados, e se o Eric deve ser preso, o [gav] ou eu também deveríamos."

# game/scripts/c31/c31.rpy:2596
translate brazilian c31s006_cloneMeeting_a4e84d83:

    # mc "I'm aware of that. The previous structure left no room for disobedience."
    mc "Eu tô ciente disso. A estrutura anterior não deixava espaço pra desobediência."

# game/scripts/c31/c31.rpy:2598
translate brazilian c31s006_cloneMeeting_d1d190a1:

    # fred "I'm sorry, [ama]..."
    fred "Sinto muito, [ama]..."

# game/scripts/c31/c31.rpy:2599
translate brazilian c31s006_cloneMeeting_f9671a0f:

    # "[ama] doesn't bother to answer. Beatrice and Diana died at the hands of the group [fred] belonged to."
    "[ama] não se dá ao trabalho de responder. Beatrice e Diana morreram nas mãos do grupo ao qual [fred] pertencia."

# game/scripts/c31/c31.rpy:2601
translate brazilian c31s006_cloneMeeting_a52d66e4:

    # dam "Eric is not a traitor. He's someone who survived however he could. He remained loyal to whoever was in command at the time."
    dam "O Eric não é um traidor. Ele é alguém que sobreviveu como pôde. Ele permaneceu leal a quem estivesse no comando na época."

# game/scripts/c31/c31.rpy:2603
translate brazilian c31s006_cloneMeeting_a33e4933:

    # carl "The formal request is his immediate release and the dropping of the charges."
    carl "O pedido formal é a sua libertação imediata e a retirada das acusações."

# game/scripts/c31/c31.rpy:2604
translate brazilian c31s006_cloneMeeting_7218061a:

    # mc "I'm not going to make that decision lightly today. I need to review the whole case."
    mc "Não vou tomar essa decisão levianamente hoje. Preciso revisar o caso todo."

# game/scripts/c31/c31.rpy:2605
translate brazilian c31s006_cloneMeeting_587a9a90:

    # mc "But I give you my word that I will look into it personally. Eric will have a fair review."
    mc "Mas dou a minha palavra de que vou analisar isso pessoalmente. O Eric terá uma revisão justa."

# game/scripts/c31/c31.rpy:2606
translate brazilian c31s006_cloneMeeting_defcc6d3:

    # carl "We'll settle for that. For now, sir."
    carl "Nós nos contentamos com isso. Por enquanto, senhor."

# game/scripts/c31/c31.rpy:2607
translate brazilian c31s006_cloneMeeting_e32a1a09:

    # "That 'sir' at the end of the sentence almost sounds like a challenge for you not to keep your word."
    "Aquele 'senhor' no final da frase quase soa como um desafio para você não cumprir sua palavra."

# game/scripts/c31/c31.rpy:2609
translate brazilian c31s006_cloneMeeting_bd556b53:

    # carl "Third request: the operatives request a leave system to go off-base."
    carl "Terceiro pedido: os agentes solicitam um sistema de folgas para sair da base."

# game/scripts/c31/c31.rpy:2610
translate brazilian c31s006_cloneMeeting_bc448111:

    # carl "Currently, they cannot leave the perimeter without an active mission."
    carl "Atualmente, eles não podem sair do perímetro sem uma missão ativa."

# game/scripts/c31/c31.rpy:2612
translate brazilian c31s006_cloneMeeting_aa45883c:

    # fred "We've gone years without being able to go to a bar, to the movies, to see anyone."
    fred "Passamos anos sem poder ir a um bar, ao cinema, ver alguém."

# game/scripts/c31/c31.rpy:2613
translate brazilian c31s006_cloneMeeting_e0add868:

    # dam "Without being able to get laid, let's get to the important stuff."
    dam "Sem poder transar, vamos ao que interessa."

# game/scripts/c31/c31.rpy:2614
translate brazilian c31s006_cloneMeeting_30c6f52e:

    # gav "Without being able to breathe any air other than this."
    gav "Sem poder respirar outro ar que não seja este."

# game/scripts/c31/c31.rpy:2615
translate brazilian c31s006_cloneMeeting_dd5407b0:

    # aar "It's one of the harshest restrictions. It keeps them isolated from the world."
    aar "É uma das restrições mais severas. Mantém eles isolados do mundo."

# game/scripts/c31/c31.rpy:2616
translate brazilian c31s006_cloneMeeting_c76ddba6:

    # mc "Is that literal? You can't leave under any circumstances?"
    mc "Isso é literal? Vocês não podem sair sob nenhuma circunstância?"

# game/scripts/c31/c31.rpy:2618
translate brazilian c31s006_cloneMeeting_2da319ae:

    # ama "That was the rule, yes. Total movement control."
    ama "Essa era a regra, sim. Controle total de movimento."

# game/scripts/c31/c31.rpy:2619
translate brazilian c31s006_cloneMeeting_36e05359:

    # mc "That's... unacceptable. You aren't prisoners."
    mc "Isso é... inaceitável. Vocês não são prisioneiros."

# game/scripts/c31/c31.rpy:2621
translate brazilian c31s006_cloneMeeting_17a3be4b:

    # fred "For years they treated us like we were."
    fred "Por anos eles nos trataram como se fôssemos."

# game/scripts/c31/c31.rpy:2622
translate brazilian c31s006_cloneMeeting_660a0965:

    # mc "That's over. We're going to establish a leave system immediately."
    mc "Isso acabou. Nós vamos estabelecer um sistema de saídas imediatamente."

# game/scripts/c31/c31.rpy:2623
translate brazilian c31s006_cloneMeeting_653c9398:

    # mc "Individual outings with reasonable notice. No asking for permission like you're children."
    mc "Saídas individuais com aviso prévio razoável. Sem pedir permissão como se fossem crianças."

# game/scripts/c31/c31.rpy:2625
translate brazilian c31s006_cloneMeeting_11db2a81:

    # gav "Seriously?"
    gav "Sério?"

# game/scripts/c31/c31.rpy:2626
translate brazilian c31s006_cloneMeeting_5f6a2c7a:

    # mc "Seriously. You're no longer slaves. You never should have been."
    mc "Sério. Vocês não são mais escravos. Nunca deveriam ter sido."

# game/scripts/c31/c31.rpy:2627
translate brazilian c31s006_cloneMeeting_c9bdddee:

    # aar "That... means a lot, [mc]. More than you can imagine."
    aar "Isso... significa muito, [mc]. Mais do que você pode imaginar."

# game/scripts/c31/c31.rpy:2628
translate brazilian c31s006_cloneMeeting_6f54b9bc:

    # dam "Yeah! Freedom! First stop: anywhere but here!"
    dam "É! Liberdade! Primeira parada: qualquer lugar menos aqui!"

# game/scripts/c31/c31.rpy:2629
translate brazilian c31s006_cloneMeeting_3df29d04:

    # fred "Thank you, [mc]."
    fred "Obrigado, [mc]."

# game/scripts/c31/c31.rpy:2631
translate brazilian c31s006_cloneMeeting_50973adb:

    # "There's a brief silence in the room. Several of the clones exchange glances."
    "Há um breve silêncio na sala. Vários dos clones trocam olhares."

# game/scripts/c31/c31.rpy:2632
translate brazilian c31s006_cloneMeeting_db0ff1e8:

    # "You don't know them well enough yet to interpret those glances, but you detect a hint of hope."
    "Você ainda não os conhece bem o suficiente para interpretar esses olhares, mas detecta um toque de esperança."

# game/scripts/c31/c31.rpy:2634
translate brazilian c31s006_cloneMeeting_3a371344:

    # carl "The fourth request is related to [gav]."
    carl "O quarto pedido está relacionado ao [gav]."

# game/scripts/c31/c31.rpy:2635
translate brazilian c31s006_cloneMeeting_907ec0ae:

    # carl "The operatives want everyone who lost limbs or suffered serious injuries to receive the same treatment that has been approved for [gav]."
    carl "Os agentes querem que todos que perderam membros ou sofreram ferimentos graves recebam o mesmo tratamento que foi aprovado para o [gav]."

# game/scripts/c31/c31.rpy:2636
translate brazilian c31s006_cloneMeeting_66a8af5e:

    # carl "Within what's possible and the availability of prosthetics and other devices, of course."
    carl "Dentro do possível e da disponibilidade de próteses e outros dispositivos, é claro."

# game/scripts/c31/c31.rpy:2638
translate brazilian c31s006_cloneMeeting_003f416c:

    # gav "It doesn't seem fair that I get this opportunity and the others don't. There are several other guys with amputations. And others with permanent damage."
    gav "Não parece justo que eu tenha essa oportunidade e os outros não. Há vários outros caras com amputações. E outros com danos permanentes."

# game/scripts/c31/c31.rpy:2639
translate brazilian c31s006_cloneMeeting_d8f8a3d1:

    # mc "How many operatives are in that situation?"
    mc "Quantos agentes estão nessa situação?"

# game/scripts/c31/c31.rpy:2641
translate brazilian c31s006_cloneMeeting_e55778cc:

    # aar "With amputations, 19 counting [gav]. [gav] is the most... recent. And the only one we have a prosthesis ready for."
    aar "Com amputações, 19 contando com o [gav]. O [gav] é o mais... recente. E o único para quem temos uma prótese pronta."

# game/scripts/c31/c31.rpy:2642
translate brazilian c31s006_cloneMeeting_09d2579d:

    # aar "They were working on what's going to be his prosthesis before the... incident."
    aar "Eles estavam trabalhando no que vai ser a prótese dele antes do... incidente."

# game/scripts/c31/c31.rpy:2643
translate brazilian c31s006_cloneMeeting_6e9ec8f2:

    # aar "With severe permanent injuries, another six or seven."
    aar "Com ferimentos graves e permanentes, mais uns seis ou sete."

# game/scripts/c31/c31.rpy:2644
translate brazilian c31s006_cloneMeeting_d26e96d6:

    # aar "[carl] would fall into this category because of his eye, for example, but we don't have any device that can help him."
    aar "O [carl] se encaixaria nessa categoria por causa do olho dele, por exemplo, mas não temos nenhum dispositivo que possa ajudá-lo."

# game/scripts/c31/c31.rpy:2646
translate brazilian c31s006_cloneMeeting_3b3e3fd0:

    # ama "High-end prosthetics don't grow on trees. We'd have to look into the development costs."
    ama "Próteses de ponta não dão em árvore. Teríamos que analisar os custos de desenvolvimento."

# game/scripts/c31/c31.rpy:2647
translate brazilian c31s006_cloneMeeting_09d3f3e7:

    # ama "I don't even know what we have available, apart from [gav]'s arm."
    ama "Eu nem sei o que temos disponível, além do braço do [gav]."

# game/scripts/c31/c31.rpy:2648
translate brazilian c31s006_cloneMeeting_aa3483b3:

    # mc "I know. But it's the right thing to do. I can't look the other way."
    mc "Eu sei. Mas é a coisa certa a se fazer. Não posso simplesmente ignorar."

# game/scripts/c31/c31.rpy:2649
translate brazilian c31s006_cloneMeeting_8ffdce37:

    # mc "I can't promise it'll be immediate, but it's on my list of real priorities."
    mc "Não posso prometer que será imediato, mas está na minha lista de prioridades reais."

# game/scripts/c31/c31.rpy:2650
translate brazilian c31s006_cloneMeeting_97f8a630:

    # mc "I'll talk to Caleb. If he could make the prototype in his free time..."
    mc "Vou falar com o Caleb. Se ele conseguiu construir o protótipo no seu tempo livre..."

# game/scripts/c31/c31.rpy:2652
translate brazilian c31s006_cloneMeeting_b503035e:

    # fred "That's good enough for us for now."
    fred "Isso já é o suficiente para nós por enquanto."

# game/scripts/c31/c31.rpy:2653
translate brazilian c31s006_cloneMeeting_4d7e5b76:

    # gav "Thank you, [mc]. For all of them."
    gav "Obrigado, [mc]. Por todos eles."

# game/scripts/c31/c31.rpy:2654
translate brazilian c31s006_cloneMeeting_8be5769f:

    # dam "Hey, what if they give me a prosthetic arm even though I have both of mine..."
    dam "Ei, e se me dessem um braço protético mesmo eu tendo os meus dois..."

# game/scripts/c31/c31.rpy:2655
translate brazilian c31s006_cloneMeeting_732c07b7:

    # dam "Would I have three arms? Asking for scientific curiosity."
    dam "Eu ficaria com três braços? Só perguntando por curiosidade científica."

# game/scripts/c31/c31.rpy:2657
translate brazilian c31s006_cloneMeeting_488b001f:

    # carl "[dam]..."
    carl "[dam]..."

# game/scripts/c31/c31.rpy:2658
translate brazilian c31s006_cloneMeeting_7c5120c7:

    # dam "Just kidding. Mostly."
    dam "Tô brincando. Na maior parte."

# game/scripts/c31/c31.rpy:2660
translate brazilian c31s006_cloneMeeting_6b0ae0e2:

    # carl "Fifth request: Salary. The operatives feel that the compensation does not reflect the risk or the nature of their work."
    carl "Quinto pedido: Salário. Os agentes sentem que a compensação não reflete o risco ou a natureza do trabalho deles."

# game/scripts/c31/c31.rpy:2661
translate brazilian c31s006_cloneMeeting_8f3e2338:

    # "At that moment, you realize what's weird every time [carl] speaks."
    "Naquele momento, você percebe o que é estranho toda vez que [carl] fala."

# game/scripts/c31/c31.rpy:2662
translate brazilian c31s006_cloneMeeting_7dec5d66:

    # "He never says 'we' or 'the clones'. He always talks about 'the operatives', as if he wants to distance himself emotionally from the requests."
    "Ele nunca diz 'nós' ou 'os clones'. Ele sempre fala sobre 'os agentes', como se quisesse se distanciar emocionalmente dos pedidos."

# game/scripts/c31/c31.rpy:2664
translate brazilian c31s006_cloneMeeting_fd08ef19:

    # fred "We've gone years without any income... Just two things: room and board."
    fred "Passamos anos sem nenhuma renda... Apenas duas coisas: casa e comida."

# game/scripts/c31/c31.rpy:2665
translate brazilian c31s006_cloneMeeting_51009217:

    # fred "You said we aren't slaves. But that sounds a lot like slavery. Without a salary, we'll remain so."
    fred "Você disse que não somos escravos. Mas isso soa muito como escravidão. Sem um salário, continuaremos sendo."

# game/scripts/c31/c31.rpy:2666
translate brazilian c31s006_cloneMeeting_f3d381eb:

    # mc "That's a reasonable request. I'm not going to say no."
    mc "Esse é um pedido razoável. Eu não vou dizer não."

# game/scripts/c31/c31.rpy:2667
translate brazilian c31s006_cloneMeeting_b0308632:

    # mc "But I need to sit down and review the numbers before committing to concrete figures."
    mc "Mas eu preciso sentar e revisar os números antes de me comprometer com valores concretos."

# game/scripts/c31/c31.rpy:2669
translate brazilian c31s006_cloneMeeting_96d356a7:

    # ama "NTR's finances aren't at their best after the last few months, [fred]."
    ama "As finanças da NTR não estão no seu melhor momento depois dos últimos meses, [fred]."

# game/scripts/c31/c31.rpy:2670
translate brazilian c31s006_cloneMeeting_6e9d39d7:

    # mc "Even so, this has to change. The company owes it to you."
    mc "Mesmo assim, isso tem que mudar. A empresa deve isso a vocês."

# game/scripts/c31/c31.rpy:2672
translate brazilian c31s006_cloneMeeting_1eb2cb12:

    # gav "No one expects you to solve it today, [mc]."
    gav "Ninguém espera que você resolva isso hoje, [mc]."

# game/scripts/c31/c31.rpy:2673
translate brazilian c31s006_cloneMeeting_8209b7f8:

    # dam "I do, a little."
    dam "Até que sim, um pouco."

# game/scripts/c31/c31.rpy:2674
translate brazilian c31s006_cloneMeeting_1758e8bc:

    # fred "[dam]..."
    fred "[dam]..."

# game/scripts/c31/c31.rpy:2675
translate brazilian c31s006_cloneMeeting_dac900f8:

    # dam "I'm kidding. Sort of."
    dam "Tô brincando. Mais ou menos."

# game/scripts/c31/c31.rpy:2676
translate brazilian c31s006_cloneMeeting_25abb483:

    # dam "But I think a 40%% raise would be good."
    dam "Mas acho que um aumento de 40%% seria bom."

# game/scripts/c31/c31.rpy:2678
translate brazilian c31s006_cloneMeeting_885eaeec:

    # gav "You realize that 40%% of zero is still zero, right?"
    gav "Você percebe que 40%% de zero ainda é zero, né?"

# game/scripts/c31/c31.rpy:2679
translate brazilian c31s006_cloneMeeting_f5cd6f0f:

    # fred "Wasn't there another D that could come to this meeting?"
    fred "Não tinha outro D que pudesse vir a essa reunião?"

# game/scripts/c31/c31.rpy:2680
translate brazilian c31s006_cloneMeeting_2ebc5798:

    # carl "The Ds... There's not much to choose from..."
    carl "Os Ds... Não tem muito de onde escolher..."

# game/scripts/c31/c31.rpy:2681
translate brazilian c31s006_cloneMeeting_6fae1d7d:

    # dam "Hey! We're the best..."
    dam "Ei! Nós somos os melhores..."

# game/scripts/c31/c31.rpy:2682
translate brazilian c31s006_cloneMeeting_df3c1e0f:

    # aar "Yeah, at talking bullshit."
    aar "É, em falar merda."

# game/scripts/c31/c31.rpy:2683
translate brazilian c31s006_cloneMeeting_44a5e86c:

    # mc "Be patient. But know that I take it seriously."
    mc "Sejam pacientes. Mas saibam que eu levo isso a sério."

# game/scripts/c31/c31.rpy:2685
translate brazilian c31s006_cloneMeeting_f017a5ef:

    # dam "Speaking of compensation... I had another request that I don't think made it to the agenda."
    dam "Falando em compensação... Eu tinha outro pedido que acho que não entrou na pauta."

# game/scripts/c31/c31.rpy:2686
translate brazilian c31s006_cloneMeeting_7798aff2:

    # dam "What about sports cars? One for each operative. At least for those of us old enough to drive..."
    dam "Que tal carros esportivos? Um para cada agente. Pelo menos para aqueles de nós com idade suficiente para dirigir..."

# game/scripts/c31/c31.rpy:2688
translate brazilian c31s006_cloneMeeting_90cb4332:

    # carl "[dam], we already discussed that in the previous meeting. We ruled it out in the first five minutes."
    carl "[dam], já discutimos isso na reunião anterior. Descartamos a ideia nos primeiros cinco minutos."

# game/scripts/c31/c31.rpy:2690
translate brazilian c31s006_cloneMeeting_55506672:

    # dam "Yeah, but it seems [mc] is open to things we thought he'd reject. Maybe he sees it differently."
    dam "É, mas parece que o [mc] está aberto a coisas que achamos que ele rejeitaria. Talvez ele veja de outra forma."

# game/scripts/c31/c31.rpy:2691
translate brazilian c31s006_cloneMeeting_a78db22b:

    # carl "He'll see it the same way we do. It's an absurd request. He's already used the excuse of funds..."
    carl "Ele vai ver da mesma forma que a gente. É um pedido absurdo. Ele já usou a desculpa da falta de fundos..."

# game/scripts/c31/c31.rpy:2692
translate brazilian c31s006_cloneMeeting_4d5c0c4f:

    # dam "It's a legitimate employee wellness request!"
    dam "É um pedido legítimo de bem-estar dos funcionários!"

# game/scripts/c31/c31.rpy:2693
translate brazilian c31s006_cloneMeeting_bd3ad819:

    # carl "A Ferrarini isn't employee wellness, [dam]."
    carl "Uma Ferrarini não é bem-estar dos funcionários, [dam]."

# game/scripts/c31/c31.rpy:2694
translate brazilian c31s006_cloneMeeting_e4a1a67c:

    # dam "And what do you know? Have you ever tried driving a Ferrarini?"
    dam "E o que você sabe? Você já tentou dirigir uma Ferrarini?"

# game/scripts/c31/c31.rpy:2695
translate brazilian c31s006_cloneMeeting_8f6962fb:

    # gav "[dam], please..."
    gav "[dam], por favor..."

# game/scripts/c31/c31.rpy:2696
translate brazilian c31s006_cloneMeeting_9e391f69:

    # mc "I appreciate the enthusiasm, [dam]. But I think we can focus the budget on other things."
    mc "Eu aprecio o entusiasmo, [dam]. Mas acho que podemos focar o orçamento em outras coisas."

# game/scripts/c31/c31.rpy:2698
translate brazilian c31s006_cloneMeeting_d8f2cdcc:

    # ama "Much more urgent things."
    ama "Coisas muito mais urgentes."

# game/scripts/c31/c31.rpy:2699
translate brazilian c31s006_cloneMeeting_2f9869dc:

    # dam "Fine. But let the record show that I tried."
    dam "Tá bom. Mas que fique registrado que eu tentei."

# game/scripts/c31/c31.rpy:2700
translate brazilian c31s006_cloneMeeting_4ed99d1c:

    # aar "Noted, noted. Don't worry. I'm also going to put on the record that you're an idiot."
    aar "Anotado, anotado. Não se preocupe. Também vou registrar que você é um idiota."

# game/scripts/c31/c31.rpy:2702
translate brazilian c31s006_cloneMeeting_ff0bb406:

    # carl "Getting back to the salaries. The request includes that the salary, if approved, be retroactive. Going back several years."
    carl "Voltando aos salários. O pedido inclui que o salário, se aprovado, seja retroativo. Voltando vários anos."

# game/scripts/c31/c31.rpy:2704
translate brazilian c31s006_cloneMeeting_4cf65e13:

    # fred "We've been working for a long time without getting paid what we deserved. It's a real debt. And not just a financial one."
    fred "Estamos trabalhando há muito tempo sem receber o que merecíamos. É uma dívida real. E não apenas financeira."

# game/scripts/c31/c31.rpy:2705
translate brazilian c31s006_cloneMeeting_c9697095:

    # fred "Starting to pay us now won't fix the historical injustice."
    fred "Começar a nos pagar agora não vai consertar a injustiça histórica."

# game/scripts/c31/c31.rpy:2706
translate brazilian c31s006_cloneMeeting_45c8c975:

    # mc "I understand the logic. And you're right. Morally and legally."
    mc "Eu entendo a lógica. E vocês têm razão. Moral e legalmente."

# game/scripts/c31/c31.rpy:2707
translate brazilian c31s006_cloneMeeting_351a5f1f:

    # mc "The problem is that right now there aren't enough funds to cover that amount."
    mc "O problema é que agora não há fundos suficientes para cobrir esse valor."

# game/scripts/c31/c31.rpy:2709
translate brazilian c31s006_cloneMeeting_ef2f9cea:

    # gav "How much are we talking about?"
    gav "De quanto estamos falando?"

# game/scripts/c31/c31.rpy:2710
translate brazilian c31s006_cloneMeeting_888f293b:

    # ama "With the accumulated years and the number of operatives, it would be a very substantial amount."
    ama "Com os anos acumulados e o número de agentes, seria uma quantia muito substancial."

# game/scripts/c31/c31.rpy:2711
translate brazilian c31s006_cloneMeeting_76829767:

    # fred "We know. But that doesn't make the debt disappear."
    fred "Nós sabemos. Mas isso não faz a dívida desaparecer."

# game/scripts/c31/c31.rpy:2712
translate brazilian c31s006_cloneMeeting_d8b6fce0:

    # dam "Of course not. We work. We risk our lives. We deserve recognition."
    dam "Claro que não. Nós trabalhamos. Arriscamos nossas vidas. Merecemos reconhecimento."

# game/scripts/c31/c31.rpy:2713
translate brazilian c31s006_cloneMeeting_c142e264:

    # mc "You're right. Completely. But if I promise something I can't deliver, I'll be failing you just like the previous management."
    mc "Vocês têm razão. Completamente. Mas se eu prometer algo que não posso cumprir, estarei falhando com vocês assim como a gestão anterior."

# game/scripts/c31/c31.rpy:2714
translate brazilian c31s006_cloneMeeting_0582f20e:

    # mc "I need to look into how to compensate you in another way."
    mc "Preciso ver como compensar vocês de outra forma."

# game/scripts/c31/c31.rpy:2716
translate brazilian c31s006_cloneMeeting_eb822c4e:

    # fred "In what way?"
    fred "De que forma?"

# game/scripts/c31/c31.rpy:2717
translate brazilian c31s006_cloneMeeting_34d2d78e:

    # mc "I don't know yet. But I'll figure it out. I promise you."
    mc "Ainda não sei. Mas vou dar um jeito. Eu prometo."

# game/scripts/c31/c31.rpy:2719
translate brazilian c31s006_cloneMeeting_61d93fdf:

    # carl "With all due respect, [mc], we've heard promises before."
    carl "Com todo o respeito, [mc], já ouvimos promessas antes."

# game/scripts/c31/c31.rpy:2720
translate brazilian c31s006_cloneMeeting_40646422:

    # mc "I know, [carl]. And I understand that those promises don't mean much to you anymore."
    mc "Eu sei, [carl]. E entendo que essas promessas não significam mais muita coisa pra vocês."

# game/scripts/c31/c31.rpy:2721
translate brazilian c31s006_cloneMeeting_f351a33a:

    # mc "I can only ask for time and prove it with actions."
    mc "Só posso pedir tempo e provar com atitudes."

# game/scripts/c31/c31.rpy:2723
translate brazilian c31s006_cloneMeeting_75deed05:

    # gav "Listen to me for a moment. We've been in this meeting for half an hour."
    gav "Me escutem um instante. Estamos nessa reunião há meia hora."

# game/scripts/c31/c31.rpy:2724
translate brazilian c31s006_cloneMeeting_a4b4835f:

    # gav "We're talking about the promises that were made to us and weren't kept. And the best of those promises was improving the ranch."
    gav "Estamos falando das promessas que nos fizeram e não foram cumpridas. E a melhor dessas promessas era melhorar o rancho."

# game/scripts/c31/c31.rpy:2726
translate brazilian c31s006_cloneMeeting_270d8286:

    # gav "[mc] said yes to the beards and the time off. He promised to look into Eric's situation, the prosthetics, and the wages."
    gav "O [mc] disse sim para as barbas e as folgas. Ele prometeu ver a situação do Eric, as próteses e os salários."

# game/scripts/c31/c31.rpy:2727
translate brazilian c31s006_cloneMeeting_5e468e30:

    # gav "Daniels wouldn't even let us in this room. And Richards, before him, wasn't much better at this."
    gav "O Daniels nem deixava a gente entrar nessa sala. E o Richards, antes dele, não era muito melhor nisso."

# game/scripts/c31/c31.rpy:2728
translate brazilian c31s006_cloneMeeting_8247a637:

    # gav "Let's give him the benefit of the doubt. At least for a while..."
    gav "Vamos dar a ele o benefício da dúvida. Pelo menos por um tempo..."

# game/scripts/c31/c31.rpy:2730
translate brazilian c31s006_cloneMeeting_3af2bc72:

    # fred "It's true. You're right."
    fred "É verdade. Você tem razão."

# game/scripts/c31/c31.rpy:2731
translate brazilian c31s006_cloneMeeting_7cf0ccd8:

    # dam "You're getting a new arm and he promised to take you with him to the States. It's normal for you to support him..."
    dam "Você vai ganhar um braço novo e ele prometeu te levar com ele pros Estados Unidos. É normal que você apoie ele..."

# game/scripts/c31/c31.rpy:2732
translate brazilian c31s006_cloneMeeting_3698fcc9:

    # carl "I don't think [gav]'s support has anything to do with that."
    carl "Eu não acho que o apoio do [gav] tenha algo a ver com isso."

# game/scripts/c31/c31.rpy:2734
translate brazilian c31s006_cloneMeeting_1db3544a:

    # gav "It has nothing to do with that, [dam]. I promise you. I was there when... the Eric thing happened. Daniels would never have acted the way [mc] did."
    gav "Não tem nada a ver com isso, [dam]. Eu te prometo. Eu tava lá quando... aquela parada com o Eric aconteceu. O Daniels nunca teria agido do jeito que o [mc] agiu."

# game/scripts/c31/c31.rpy:2735
translate brazilian c31s006_cloneMeeting_6f6ba7bf:

    # gav "He probably would have ordered [ama] and [eva] to execute us all."
    gav "Ele provavelmente teria ordenado que a [ama] e a [eva] executassem todos nós."

# game/scripts/c31/c31.rpy:2736
translate brazilian c31s006_cloneMeeting_e1f6efbe:

    # mcp "(At that time I didn't even know their names. It wouldn't have occurred to me to order them to do anything.)"
    mcp "(Naquela época eu nem sabia os nomes delas. Não teria me passado pela cabeça dar qualquer ordem a elas.)"

# game/scripts/c31/c31.rpy:2737
translate brazilian c31s006_cloneMeeting_68908b9b:

    # mcp "(And having you killed wouldn't be among the orders I would have given them, if I could have given them any.)"
    mcp "(E mandar matar vocês não estaria entre as ordens que eu daria a elas, se eu pudesse dar alguma.)"

# game/scripts/c31/c31.rpy:2738
translate brazilian c31s006_cloneMeeting_cf677da0:

    # gav "I'm not saying we should settle for crumbs. But we have to recognize the difference."
    gav "Não tô dizendo que a gente deva se contentar com migalhas. Mas temos que reconhecer a diferença."

# game/scripts/c31/c31.rpy:2739
translate brazilian c31s006_cloneMeeting_d2466246:

    # gav "[mc] is listening. That's already something none of us expected a month ago... Or an hour ago."
    gav "O [mc] tá ouvindo. Isso já é algo que nenhum de nós esperava um mês atrás... Ou uma hora atrás."

# game/scripts/c31/c31.rpy:2741
translate brazilian c31s006_cloneMeeting_64dd59a0:

    # dam "[gav] is right. And I, being the biggest complainer, admit it."
    dam "O [gav] tem razão. E eu, sendo o maior reclamão, admito isso."

# game/scripts/c31/c31.rpy:2742
translate brazilian c31s006_cloneMeeting_e3efb808:

    # aar "The kid's got a good head on his shoulders. I mean [gav], not [dam]..."
    aar "O garoto tem a cabeça no lugar. Quero dizer o [gav], não o [dam]..."

# game/scripts/c31/c31.rpy:2743
translate brazilian c31s006_cloneMeeting_38f4ac6a:

    # mc "Thanks, [gav]. That... means a lot."
    mc "Obrigado, [gav]. Isso... significa muito."

# game/scripts/c31/c31.rpy:2744
translate brazilian c31s006_cloneMeeting_4ebd9be0:

    # ama "And they aren't just empty promises. [mc] has been working on this for days since he took over."
    ama "E não são apenas promessas vazias. O [mc] tem trabalhado nisso há dias desde que assumiu."

# game/scripts/c31/c31.rpy:2745
translate brazilian c31s006_cloneMeeting_8d81aa3d:

    # ama "[aar] and I have flooded him with information. Think about it, it can't be easy for him either."
    ama "O [aar] e eu o inundamos de informações. Pensem bem, também não deve ser fácil pra ele."

# game/scripts/c31/c31.rpy:2747
translate brazilian c31s006_cloneMeeting_0ee149c1:

    # carl "I think we're demanding that [mc] take responsibility for the mistakes of the previous management. It's his first day here and so far he's listening to us."
    carl "Acho que estamos exigindo que o [mc] assuma a responsabilidade pelos erros da gestão anterior. É o primeiro dia dele aqui e, até agora, ele está nos ouvindo."

# game/scripts/c31/c31.rpy:2748
translate brazilian c31s006_cloneMeeting_708f9b21:

    # carl "I'm not saying we should give up on our demands, but I think we should give him the benefit of the doubt."
    carl "Não estou dizendo que devemos desistir das nossas exigências, mas acho que deveríamos dar a ele o benefício da dúvida."

# game/scripts/c31/c31.rpy:2749
translate brazilian c31s006_cloneMeeting_a4ba8285:

    # "Surprisingly, everyone nods. You realize you're starting to like [carl]. And you think he's starting to like you too."
    "Surpreendentemente, todos concordam com a cabeça. Você percebe que está começando a gostar do [carl]. E acha que ele também está começando a gostar de você."

# game/scripts/c31/c31.rpy:2751
translate brazilian c31s006_cloneMeeting_e1766345:

    # carl "Let's continue, then. The next request is the most important one for many of us."
    carl "Vamos continuar, então. O próximo pedido é o mais importante para muitos de nós."

# game/scripts/c31/c31.rpy:2752
translate brazilian c31s006_cloneMeeting_260fe742:

    # carl "The operatives want to be able to choose their future. Their position within NTR. And, in the long term, to be able to terminate their contracts if they so decide."
    carl "Os agentes querem poder escolher o futuro deles. A posição deles dentro da NTR. E, a longo prazo, poder rescindir seus contratos se assim decidirem."

# game/scripts/c31/c31.rpy:2754
translate brazilian c31s006_cloneMeeting_cbc49dee:

    # "The room falls silent for a few seconds. It's the request they're most excited about of all the ones they've made. You can read it on their faces."
    "A sala fica em silêncio por alguns segundos. É o pedido que mais os anima de todos os que fizeram. Você consegue ler isso no rosto deles."

# game/scripts/c31/c31.rpy:2755
translate brazilian c31s006_cloneMeeting_3a9dd54b:

    # aar "This is the one that matters most to us. To all of us."
    aar "Esse é o que mais importa pra gente. Pra todos nós."

# game/scripts/c31/c31.rpy:2756
translate brazilian c31s006_cloneMeeting_534c6c70:

    # fred "We don't want to be anyone's property. We were already the company's property once, and [aar] told us that it's not going to happen again."
    fred "Não queremos ser propriedade de ninguém. Já fomos propriedade da empresa uma vez, e o [aar] nos disse que isso não vai acontecer de novo."

# game/scripts/c31/c31.rpy:2757
translate brazilian c31s006_cloneMeeting_50d8828a:

    # mc "I know."
    mc "Eu sei."

# game/scripts/c31/c31.rpy:2758
translate brazilian c31s006_cloneMeeting_985d148b:

    # dam "We want to be able to say 'I want to leave' and have it be a real option. Not a sentence."
    dam "Queremos poder dizer 'Eu quero ir embora' e que isso seja uma opção real. Não uma sentença."

# game/scripts/c31/c31.rpy:2759
translate brazilian c31s006_cloneMeeting_afd3c51c:

    # gav "Or stay. But let it be our choice."
    gav "Ou ficar. Mas que seja a nossa escolha."

# game/scripts/c31/c31.rpy:2760
translate brazilian c31s006_cloneMeeting_45aef16d:

    # mc "I hear you. And I understand you."
    mc "Eu ouço vocês. E eu entendo vocês."

# game/scripts/c31/c31.rpy:2761
translate brazilian c31s006_cloneMeeting_42d9f9ce:

    # mc "Changing positions within the company: we can start structuring that shortly."
    mc "Mudar de cargo dentro da empresa: podemos começar a estruturar isso em breve."

# game/scripts/c31/c31.rpy:2762
translate brazilian c31s006_cloneMeeting_417a1c7d:

    # mc "That everyone can apply for different roles, train, grow. Of course. As long as the person is qualified for that role."
    mc "Que todos possam se candidatar a diferentes funções, treinar, crescer. Claro. Desde que a pessoa seja qualificada para essa função."

# game/scripts/c31/c31.rpy:2764
translate brazilian c31s006_cloneMeeting_f83340c0:

    # "None of them can hide their smile... Or their surprise."
    "Nenhum deles consegue esconder o sorriso... Ou a surpresa."

# game/scripts/c31/c31.rpy:2765
translate brazilian c31s006_cloneMeeting_bfe72352:

    # ama "We'll have to create an internal promotion system, but it's viable."
    ama "Teremos que criar um sistema de promoção interna, mas é viável."

# game/scripts/c31/c31.rpy:2766
translate brazilian c31s006_cloneMeeting_b4efce6e:

    # mc "As for terminating contracts... that's more complex."
    mc "Quanto à rescisão de contratos... isso é mais complexo."

# game/scripts/c31/c31.rpy:2767
translate brazilian c31s006_cloneMeeting_04621e4a:

    # mc "Not because I don't want to allow it, but because there are legal and security implications regarding your own origins."
    mc "Não porque eu não queira permitir, mas porque há implicações legais e de segurança em relação às suas próprias origens."

# game/scripts/c31/c31.rpy:2768
translate brazilian c31s006_cloneMeeting_c60be5bb:

    # mc "You are people. You deserve to choose. But I have to make sure that leaving protects you."
    mc "Vocês são pessoas. Vocês merecem escolher. Mas eu tenho que garantir que ir embora proteja vocês."

# game/scripts/c31/c31.rpy:2769
translate brazilian c31s006_cloneMeeting_aa2b0b0e:

    # mc "I don't want to sound patronizing, but I also don't want you to leave and have the outside world treat you worse than this place did."
    mc "Não quero parecer condescendente, mas também não quero que vocês saiam e o mundo lá fora os trate pior do que este lugar tratou."

# game/scripts/c31/c31.rpy:2771
translate brazilian c31s006_cloneMeeting_f1fcd014:

    # fred "Is that a 'no'?"
    fred "Isso é um 'não'?"

# game/scripts/c31/c31.rpy:2772
translate brazilian c31s006_cloneMeeting_a81552cd:

    # mc "It's a 'we'll work together on it, so it's a yes in due time. Soon'."
    mc "É um 'vamos trabalhar juntos nisso, então é um sim no devido tempo. Em breve'."

# game/scripts/c31/c31.rpy:2773
translate brazilian c31s006_cloneMeeting_26733e06:

    # aar "I don't think we can expect a more positive answer on this matter."
    aar "Não acho que possamos esperar uma resposta mais positiva sobre esse assunto."

# game/scripts/c31/c31.rpy:2774
translate brazilian c31s006_cloneMeeting_15a2dd8e:

    # gav "I'm staying. For the record. But I want to know that I could leave if I wanted to."
    gav "Eu vou ficar. Só para constar. Mas quero saber que eu poderia sair se quisesse."

# game/scripts/c31/c31.rpy:2775
translate brazilian c31s006_cloneMeeting_265ba84f:

    # mc "That's exactly what we're going to guarantee. Not today, but we will."
    mc "É exatamente isso que vamos garantir. Não hoje, mas vamos."

# game/scripts/c31/c31.rpy:2776
translate brazilian c31s006_cloneMeeting_7c3256b6:

    # mc "And I want to work with you so that no one wants to terminate that contract."
    mc "E eu quero trabalhar com vocês para que ninguém queira rescindir esse contrato."

# game/scripts/c31/c31.rpy:2778
translate brazilian c31s006_cloneMeeting_cb1f10de:

    # "[carl] has a smile on his face as he begins to speak. You're becoming more and more convinced that he likes what he's hearing in this meeting."
    "[carl] tem um sorriso no rosto quando começa a falar. Você está cada vez mais convencido de que ele gosta do que está ouvindo nesta reunião."

# game/scripts/c31/c31.rpy:2779
translate brazilian c31s006_cloneMeeting_9b6d484d:

    # carl "Last request on the official list. We're requesting documentation with alternative identities."
    carl "Último pedido da lista oficial. Estamos solicitando documentação com identidades alternativas."

# game/scripts/c31/c31.rpy:2780
translate brazilian c31s006_cloneMeeting_2a81a620:

    # carl "Passports and other documentation with real names so we can move around the world with some degree of normalcy."
    carl "Passaportes e outras documentações com nomes reais para que possamos nos mover pelo mundo com algum grau de normalidade."

# game/scripts/c31/c31.rpy:2781
translate brazilian c31s006_cloneMeeting_2c7ff0f4:

    # mc "That's... illegal. And I wouldn't even know where to start. It's complicated territory..."
    mc "Isso é... ilegal. E eu nem saberia por onde começar. É um território complicado..."

# game/scripts/c31/c31.rpy:2783
translate brazilian c31s006_cloneMeeting_87443324:

    # fred "We're illegal clones of living people, [mc]. We're already in complicated territory."
    fred "Nós somos clones ilegais de pessoas vivas, [mc]. Já estamos em um território complicado."

# game/scripts/c31/c31.rpy:2784
translate brazilian c31s006_cloneMeeting_6cb0ef94:

    # aar "We don't have recognized identities. We don't exist to the official world."
    aar "Não temos identidades reconhecidas. Não existimos para o mundo oficial."

# game/scripts/c31/c31.rpy:2785
translate brazilian c31s006_cloneMeeting_b6aa904a:

    # gav "We can't take a commercial flight. We can't open a bank account. We can't exist outside these walls without being ghosts."
    gav "Não podemos pegar um voo comercial. Não podemos abrir uma conta no banco. Não podemos existir fora destas paredes sem sermos fantasmas."

# game/scripts/c31/c31.rpy:2786
translate brazilian c31s006_cloneMeeting_70bd8a87:

    # dam "Or criminals. Even if we haven't done anything."
    dam "Ou criminosos. Mesmo que não tenhamos feito nada."

# game/scripts/c31/c31.rpy:2789
translate brazilian c31s006_cloneMeeting_fac812b0:

    # ama "They're right, [mc]. Our legal situation is... peculiar."
    ama "Eles têm razão, [mc]. Nossa situação legal é... peculiar."

# game/scripts/c31/c31.rpy:2791
translate brazilian c31s006_cloneMeeting_5aa4184e:

    # ama "They're right, [mc]. Their legal situation is... peculiar."
    ama "Eles têm razão, [mc]. A situação legal deles é... peculiar."

# game/scripts/c31/c31.rpy:2792
translate brazilian c31s006_cloneMeeting_964a076b:

    # ama "Without that documentation, the promise of being able to leave the company would be an empty promise."
    ama "Sem essa documentação, a promessa de poder sair da empresa seria uma promessa vazia."

# game/scripts/c31/c31.rpy:2793
translate brazilian c31s006_cloneMeeting_e07341a8:

    # mc "I know. And it's a real problem that needs a real solution."
    mc "Eu sei. E é um problema real que precisa de uma solução real."

# game/scripts/c31/c31.rpy:2794
translate brazilian c31s006_cloneMeeting_c41e143f:

    # mc "Alternative documentation isn't something I can approve right now. There's a significant logistical cost. And there are legal risks for NTR."
    mc "Documentação alternativa não é algo que eu possa aprovar agora. Há um custo logístico significativo. E há riscos legais para a NTR."

# game/scripts/c31/c31.rpy:2796
translate brazilian c31s006_cloneMeeting_fbbc292e:

    # fred "More risks than the ones we take every day in the field?"
    fred "Mais riscos do que os que corremos todos os dias em campo?"

# game/scripts/c31/c31.rpy:2797
translate brazilian c31s006_cloneMeeting_e0b8fd70:

    # mc "No. You're right, [fred]."
    mc "Não. Você tem razão, [fred]."

# game/scripts/c31/c31.rpy:2798
translate brazilian c31s006_cloneMeeting_1ac0ae7d:

    # mc "I'm going to look into how much it would cost and how to do it as safely as possible."
    mc "Vou pesquisar quanto custaria e como fazer isso da forma mais segura possível."

# game/scripts/c31/c31.rpy:2799
translate brazilian c31s006_cloneMeeting_a7f7fa71:

    # mc "For you guys and for the company. I'm not saying no. I'm saying I need to think about it."
    mc "Para vocês e para a empresa. Não estou dizendo não. Estou dizendo que preciso pensar sobre isso."

# game/scripts/c31/c31.rpy:2800
translate brazilian c31s006_cloneMeeting_1a935044:

    # mc "I guess one of the governments we've worked with could help, but..."
    mc "Acho que um dos governos com os quais trabalhamos poderia ajudar, mas..."

# game/scripts/c31/c31.rpy:2802
translate brazilian c31s006_cloneMeeting_bc4cee13:

    # aar "It's more than we expected."
    aar "É mais do que esperávamos."

# game/scripts/c31/c31.rpy:2803
translate brazilian c31s006_cloneMeeting_92be3381:

    # gav "That works for me."
    gav "Por mim, tudo bem."

# game/scripts/c31/c31.rpy:2804
translate brazilian c31s006_cloneMeeting_896fb231:

    # dam "I want a cool name. Something like... Dan Steel. Dan is dead. I can take his name."
    dam "Eu quero um nome foda. Algo tipo... Dan Steel. O Dan tá morto. Eu posso pegar o nome dele."

# game/scripts/c31/c31.rpy:2806
translate brazilian c31s006_cloneMeeting_d1d35694:

    # carl "[dam], for the love of..."
    carl "[dam], pelo amor de..."

# game/scripts/c31/c31.rpy:2807
translate brazilian c31s006_cloneMeeting_687be014:

    # dam "It's for the passport! We have to think about it ahead of time!"
    dam "É pro passaporte! Temos que pensar nisso com antecedência!"

# game/scripts/c31/c31.rpy:2808
translate brazilian c31s006_cloneMeeting_c3c3efcd:

    # fred "Sometimes I wonder how he's survived so many missions."
    fred "Às vezes me pergunto como ele sobreviveu a tantas missões."

# game/scripts/c31/c31.rpy:2809
translate brazilian c31s006_cloneMeeting_ba4c8276:

    # dam "Charisma. Pure and simple."
    dam "Carisma. Pura e simplesmente."

# game/scripts/c31/c31.rpy:2811
translate brazilian c31s006_cloneMeeting_60ee7b62:

    # "The initial tension has dissipated. The room now has a warmer atmosphere. As if they trust you."
    "A tensão inicial se dissipou. A sala agora tem uma atmosfera mais acolhedora. Como se eles confiassem em você."

# game/scripts/c31/c31.rpy:2812
translate brazilian c31s006_cloneMeeting_132a95ae:

    # "Not because of what [aar] has told them over the last few days, but because of what they've heard come out of your mouth."
    "Não por causa do que [aar] disse a eles nos últimos dias, mas por causa do que ouviram sair da sua boca."

# game/scripts/c31/c31.rpy:2813
translate brazilian c31s006_cloneMeeting_2b614ac8:

    # "You look at everyone present before speaking."
    "Você olha para todos os presentes antes de falar."

# game/scripts/c31/c31.rpy:2814
translate brazilian c31s006_cloneMeeting_0087789a:

    # mc "Alright. I think, if you have no further requests, we've covered everything on the table."
    mc "Certo. Acho que, se não tiverem mais nenhum pedido, discutimos tudo o que estava em pauta."

# game/scripts/c31/c31.rpy:2815
translate brazilian c31s006_cloneMeeting_17b74da1:

    # mc "I want you to know that this isn't the last meeting. It's the first."
    mc "Quero que saibam que esta não é a última reunião. É a primeira."

# game/scripts/c31/c31.rpy:2816
translate brazilian c31s006_cloneMeeting_6331ccac:

    # ama "[mc] plans to establish a direct channel so you can submit new requests."
    ama "[mc] planeja estabelecer um canal direto para que vocês possam fazer novas solicitações."

# game/scripts/c31/c31.rpy:2817
translate brazilian c31s006_cloneMeeting_3a850659:

    # aar "That... has never existed before."
    aar "Isso... nunca existiu antes."

# game/scripts/c31/c31.rpy:2818
translate brazilian c31s006_cloneMeeting_b3fbfa36:

    # mc "Well, it exists now. And I want you to use it."
    mc "Bom, existe agora. E eu quero que vocês usem."

# game/scripts/c31/c31.rpy:2819
translate brazilian c31s006_cloneMeeting_d78b839c:

    # fred "When is the next meeting?"
    fred "Quando é a próxima reunião?"

# game/scripts/c31/c31.rpy:2820
translate brazilian c31s006_cloneMeeting_3422f581:

    # mc "In a few weeks. I need time to make progress on the pending issues."
    mc "Em algumas semanas. Preciso de tempo para progredir nos assuntos pendentes."

# game/scripts/c31/c31.rpy:2821
translate brazilian c31s006_cloneMeeting_efafc640:

    # mc "I don't want to call a meeting until I have something concrete to offer you. Progress on what you asked for today."
    mc "Não quero convocar uma reunião até ter algo concreto para oferecer a vocês. Progresso no que pediram hoje."

# game/scripts/c31/c31.rpy:2822
translate brazilian c31s006_cloneMeeting_a359479c:

    # gav "Sounds good to us."
    gav "Parece bom para nós."

# game/scripts/c31/c31.rpy:2823
translate brazilian c31s006_cloneMeeting_7fb9b9c6:

    # carl "I'll take note of the agreements reached and the issues pending resolution."
    carl "Vou anotar os acordos alcançados e as questões pendentes de resolução."

# game/scripts/c31/c31.rpy:2824
translate brazilian c31s006_cloneMeeting_8e87bc32:

    # dam "And I'll take note of the cool names in case there are passports."
    dam "E eu vou anotar os nomes legais caso tenha passaportes."

# game/scripts/c31/c31.rpy:2826
translate brazilian c31s006_cloneMeeting_c9821169_1:

    # aar "[dam]..."
    aar "[dam]..."

# game/scripts/c31/c31.rpy:2827
translate brazilian c31s006_cloneMeeting_e81182d9:

    # dam "*Laugh* I'm doing it for the team!"
    dam "*Risos* Eu tô fazendo isso pela equipe!"

# game/scripts/c31/c31.rpy:2828
translate brazilian c31s006_cloneMeeting_e5663045:

    # "Some can't hide their smiles beneath the fuss caused by [dam]'s latest nonsense."
    "Alguns não conseguem esconder os sorrisos por baixo do alvoroço causado pela última besteira do [dam]."

# game/scripts/c31/c31.rpy:2829
translate brazilian c31s006_cloneMeeting_32202f04:

    # "You think it's the first time that room has heard clones laughing."
    "Você acha que é a primeira vez que essa sala ouve clones rindo."

# game/scripts/c31/c31.rpy:2830
translate brazilian c31s006_cloneMeeting_e660ffee:

    # mc "One more thing before you leave."
    mc "Mais uma coisa antes de vocês irem."

# game/scripts/c31/c31.rpy:2832
translate brazilian c31s006_cloneMeeting_a51d42fd:

    # "You stand up. Everyone looks at you for a moment before you start speaking. You know you have their attention."
    "Você se levanta. Todos olham para você por um momento antes de você começar a falar. Você sabe que tem a atenção deles."

# game/scripts/c31/c31.rpy:2833
translate brazilian c31s006_cloneMeeting_9dcc6b4d:

    # mc "I know what you've been through here. What they did to you. What they denied you. Though I'll never fully understand what you went through."
    mc "Eu sei o que vocês passaram aqui. O que fizeram com vocês. O que negaram a vocês. Embora eu nunca vá entender completamente o que vocês passaram."

# game/scripts/c31/c31.rpy:2834
translate brazilian c31s006_cloneMeeting_e4d2717b:

    # mc "But I can't change the past. All I can do is make sure the future is different."
    mc "Mas eu não posso mudar o passado. Tudo o que posso fazer é garantir que o futuro seja diferente."

# game/scripts/c31/c31.rpy:2835
translate brazilian c31s006_cloneMeeting_0a023c18:

    # mc "Not as a favor. As an obligation. This company owes it to you. I owe it to you."
    mc "Não como um favor. Como uma obrigação. Esta empresa deve isso a vocês. Eu devo isso a vocês."

# game/scripts/c31/c31.rpy:2837
translate brazilian c31s006_cloneMeeting_2c06cb3d:

    # "No one speaks for a moment as you sit back down. They look at each other before reacting."
    "Ninguém fala por um momento enquanto você se senta novamente. Eles se olham antes de reagir."

# game/scripts/c31/c31.rpy:2838
translate brazilian c31s006_cloneMeeting_c6f6798b:

    # "Despite everything that's been said in the meeting, there's still surprise in their voices when they start speaking."
    "Apesar de tudo que foi dito na reunião, ainda há surpresa em suas vozes quando começam a falar."

# game/scripts/c31/c31.rpy:2839
translate brazilian c31s006_cloneMeeting_c07c1cd5:

    # fred "It's the first time someone in that position has said something like that."
    fred "É a primeira vez que alguém nessa posição diz algo assim."

# game/scripts/c31/c31.rpy:2840
translate brazilian c31s006_cloneMeeting_68bc852a:

    # carl "Or that someone in that position even bothers to listen to us."
    carl "Ou que alguém nessa posição sequer se dá ao trabalho de nos ouvir."

# game/scripts/c31/c31.rpy:2841
translate brazilian c31s006_cloneMeeting_bf1248f6:

    # gav "And he means it. You can tell."
    gav "E ele está falando sério. Dá pra notar."

# game/scripts/c31/c31.rpy:2842
translate brazilian c31s006_cloneMeeting_9c08ca87:

    # aar "Thank you, [mc]. On behalf of everyone. Including those who aren't here."
    aar "Obrigado, [mc]. Em nome de todos. Incluindo os que não estão aqui."

# game/scripts/c31/c31.rpy:2843
translate brazilian c31s006_cloneMeeting_6a1067c2:

    # ama "See you in a few weeks, then."
    ama "Vejo você em algumas semanas, então."

# game/scripts/c31/c31.rpy:2845
translate brazilian c31s006_cloneMeeting_51527a49:

    # carl "I think this meeting is over. We should leave [mc], [ama], and [aar] to discuss what we've talked about here."
    carl "Acho que esta reunião acabou. Devemos deixar [mc], [ama] e [aar] discutirem o que conversamos aqui."

# game/scripts/c31/c31.rpy:2847
translate brazilian c31s006_cloneMeeting_45cd0cb2:

    # aar "I'm going to start preparing all the necessary documentation so you can make decisions having all the information."
    aar "Vou começar a preparar toda a documentação necessária para que você possa tomar decisões tendo todas as informações."

# game/scripts/c31/c31.rpy:2848
translate brazilian c31s006_cloneMeeting_1f861dbf:

    # mc "All the {b}relevant{/b} information, [aar]. I don't need to know how much shaving cream we're going to save because they can grow a beard now."
    mc "Todas as informações {b}relevantes{/b}, [aar]. Eu não preciso saber quanta espuma de barbear vamos economizar porque eles podem deixar a barba crescer agora."

# game/scripts/c31/c31.rpy:2850
translate brazilian c31s006_cloneMeeting_7e991351:

    # aar "*Laugh* Am I too thorough in my reports?"
    aar "*Risos* Sou muito minucioso nos meus relatórios?"

# game/scripts/c31/c31.rpy:2851
translate brazilian c31s006_cloneMeeting_ebaf1abf:

    # mc "*Laugh* I wouldn't say that. I don't know what word could be used for 'three orders of magnitude above too thorough'."
    mc "*Risos* Eu não diria isso. Não sei que palavra poderia ser usada para 'três ordens de magnitude acima de minucioso demais'."

# game/scripts/c31/c31.rpy:2852
translate brazilian c31s006_cloneMeeting_69379918:

    # aar "*Laugh* Okay. No shaving cream or time we'll save at the barbershop."
    aar "*Risos* Ok. Nada de creme de barbear ou tempo que vamos economizar na barbearia."

# game/scripts/c31/c31.rpy:2854
translate brazilian c31s006_cloneMeeting_2714547c:

    # "The meeting slowly dissolves. The clones leave talking among themselves."
    "A reunião se dissolve lentamente. Os clones saem conversando entre si."

# game/scripts/c31/c31.rpy:2855
translate brazilian c31s006_cloneMeeting_cd518edd:

    # "For the first time, there's something resembling hope at NTR headquarters. At least among the clones."
    "Pela primeira vez, há algo parecido com esperança na sede da NTR. Pelo menos entre os clones."

# game/scripts/c31/c31.rpy:2856
translate brazilian c31s006_cloneMeeting_7e82245b:

    # dam "I'm already thinking about my sideburns. Maybe they're better than a beard..."
    dam "Já estou pensando nas minhas costeletas. Talvez sejam melhores que uma barba..."

# game/scripts/c31/c31.rpy:2857
translate brazilian c31s006_cloneMeeting_a7101ebe:

    # gav "[dam], stop it."
    gav "[dam], para com isso."

# game/scripts/c31/c31.rpy:2858
translate brazilian c31s006_cloneMeeting_24012bf9:

    # dam "They're a symbol of freedom!"
    dam "Elas são um símbolo de liberdade!"

# game/scripts/c31/c31.rpy:2860
translate brazilian c31s006_cloneMeeting_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."

# game/scripts/c31/c31.rpy:2861
translate brazilian c31s006_cloneMeeting_45b012e8:

    # ama "Yes?"
    ama "Sim?"

# game/scripts/c31/c31.rpy:2862
translate brazilian c31s006_cloneMeeting_3bd14d0a:

    # mc "Do you think we'll do well?"
    mc "Você acha que vamos nos sair bem?"

# game/scripts/c31/c31.rpy:2864
translate brazilian c31s006_cloneMeeting_ae2832b2:

    # ama "I think you're already doing well."
    ama "Eu acho que vocês já estão se saindo bem."

# game/scripts/c31/c31.rpy:2865
translate brazilian c31s006_cloneMeeting_28818800:

    # "You nod, thoughtful. There's a lot of work ahead. But today, at least, someone listened to the people who have suffered the most at NTR."
    "Você assente, pensativo. Há muito trabalho pela frente. Mas hoje, pelo menos, alguém ouviu as pessoas que mais sofreram na NTR."

# game/scripts/c31/c31.rpy:4233
translate brazilian c31s006_DanielsFate_5bc3d28a:

    # "The rest of the day flies by."
    "O resto do dia passa voando."

# game/scripts/c31/c31.rpy:4234
translate brazilian c31s006_DanielsFate_31873a0c:

    # "If the meeting room was oppressive, your office isn't much better. It looks like it's straight out of a 70s movie."
    "Se a sala de reuniões era opressiva, seu escritório não é muito melhor. Parece que saiu direto de um filme dos anos 70."

# game/scripts/c31/c31.rpy:4235
translate brazilian c31s006_DanielsFate_ceae195a:

    # "[car] gives you the Employee Handbook. It's a huge book with a bunch of outdated concepts."
    "[car] te entrega o Manual do Funcionário. É um livro enorme com um monte de conceitos ultrapassados."

# game/scripts/c31/c31.rpy:4236
translate brazilian c31s006_DanielsFate_7ae54631:

    # "There isn't a single mention of clones in it. It's meant for staff in non-operations departments."
    "Não há uma única menção a clones nele. É voltado para funcionários de departamentos não operacionais."

# game/scripts/c31/c31.rpy:4237
translate brazilian c31s006_DanielsFate_bbb50372:

    # "You leave it in a prominent place on your desk. Another thing for your to-do list."
    "Você o deixa em um lugar de destaque na sua mesa. Mais uma coisa para a sua lista de tarefas."

# game/scripts/c31/c31.rpy:4239
translate brazilian c31s006_DanielsFate_4bce495a:

    # "You have a meeting with the head of the IT department, [geo]."
    "Você tem uma reunião com o chefe do departamento de TI, [geo]."

# game/scripts/c31/c31.rpy:4240
translate brazilian c31s006_DanielsFate_81a7ccbb:

    # "He seems like a good guy, although he has a bit of a weird sense of humor, especially regarding his wardrobe choices."
    "Ele parece ser um cara legal, embora tenha um senso de humor meio estranho, especialmente em relação às suas escolhas de guarda-roupa."

# game/scripts/c31/c31.rpy:4241
translate brazilian c31s006_DanielsFate_84a9636e:

    # "The company's management application seems quite operational, although you see possible areas for improvement."
    "O aplicativo de gerenciamento da empresa parece bem operacional, embora você veja possíveis áreas de melhoria."

# game/scripts/c31/c31.rpy:4242
translate brazilian c31s006_DanielsFate_b3e74f2e:

    # "You think that, later on, you'll put [geo] in touch with Jamaal."
    "Você pensa que, mais tarde, vai colocar [geo] em contato com Jamaal."

# game/scripts/c31/c31.rpy:4243
translate brazilian c31s006_DanielsFate_d187b752:

    # "If your favorite IT guy was able to hack NTR's database, tech security should be increased."
    "Se o seu cara de TI favorito conseguiu hackear o banco de dados da NTR, a segurança tecnológica deve ser aumentada."

# game/scripts/c31/c31.rpy:4244
translate brazilian c31s006_DanielsFate_1a02dcb5:

    # "He leaves a folder with the IT systems manual on your desk. He also sends you the electronic version by email."
    "Ele deixa uma pasta com o manual de sistemas de TI na sua mesa. Ele também te envia a versão eletrônica por e-mail."

# game/scripts/c31/c31.rpy:4247
translate brazilian c31s006_DanielsFate_f5af9d6f:

    # "You receive three visits from [vin] throughout the day."
    "Você recebe três visitas do [vin] ao longo do dia."

# game/scripts/c31/c31.rpy:4248
translate brazilian c31s006_DanielsFate_285df287:

    # "He wants meticulous details about the reports you requested."
    "Ele quer detalhes meticulosos sobre os relatórios que você solicitou."

# game/scripts/c31/c31.rpy:4249
translate brazilian c31s006_DanielsFate_015e3769:

    # "The only question of interest to you is whether you want the reports on 'Real Accounting' or 'Creative Accounting'."
    "A única pergunta que te interessa é se você quer os relatórios da 'Contabilidade Real' ou da 'Contabilidade Criativa'."

# game/scripts/c31/c31.rpy:4250
translate brazilian c31s006_DanielsFate_4cb0d9d4:

    # "You think you're going to hate [vin] and his tiny hands."
    "Você acha que vai odiar o [vin] e suas mãozinhas."

# game/scripts/c31/c31.rpy:4251
translate brazilian c31s006_DanielsFate_5c08256c:

    # "After his last visit, you've lost track of how many coffees [car] has brought you."
    "Depois da última visita dele, você perdeu a conta de quantos cafés a [car] te trouxe."

# game/scripts/c31/c31.rpy:4254
translate brazilian c31s006_DanielsFate_b95aee08:

    # "Late in the afternoon, [aar] shows up at your office. You haven't left it since lunchtime."
    "No final da tarde, [aar] aparece no seu escritório. Você não saiu de lá desde a hora do almoço."

# game/scripts/c31/c31.rpy:4255
translate brazilian c31s006_DanielsFate_fb3be0c9:

    # mc "Can I help you with anything, [aar]?"
    mc "Posso te ajudar com alguma coisa, [aar]?"

# game/scripts/c31/c31.rpy:4256
translate brazilian c31s006_DanielsFate_6729bbf0:

    # aar "I came to talk about Daniels."
    aar "Eu vim falar sobre o Daniels."

# game/scripts/c31/c31.rpy:4257
translate brazilian c31s006_DanielsFate_1afe9f90:

    # mc "Tell me."
    mc "Diga."

# game/scripts/c31/c31.rpy:4261
translate brazilian c31s006_DanielsFate_e230c02e:

    # aar "You said you wanted to be part of whatever decision was made."
    aar "Você disse que queria fazer parte de qualquer decisão que fosse tomada."

# game/scripts/c31/c31.rpy:4263
translate brazilian c31s006_DanielsFate_e6eb5187:

    # aar "I know you said you were leaving whatever decision was made in our hands."
    aar "Eu sei que você disse que deixaria qualquer decisão que fosse tomada em nossas mãos."

# game/scripts/c31/c31.rpy:4264
translate brazilian c31s006_DanielsFate_30809b45:

    # mc "Is it necessary to do this on my first day here, [aar]? I'm still catching up on a thousand things..."
    mc "É necessário fazer isso no meu primeiro dia aqui, [aar]? Ainda estou me atualizando sobre mil coisas..."

# game/scripts/c31/c31.rpy:4266
translate brazilian c31s006_DanielsFate_9fb22617:

    # aar "I think it'll be better to act as soon as possible... I haven't been able to find out if he still has supporters in the company and..."
    aar "Acho que vai ser melhor agir o mais rápido possível... Não consegui descobrir se ele ainda tem apoiadores na empresa e..."

# game/scripts/c31/c31.rpy:4267
translate brazilian c31s006_DanielsFate_9632c43c:

    # mc "And I think we can't do anything until [eva] is here."
    mc "E eu acho que não podemos fazer nada até a [eva] estar aqui."

# game/scripts/c31/c31.rpy:4268
translate brazilian c31s006_DanielsFate_f8fd0e7f:

    # mc "It's not something that can be done over a video call with someone like her."
    mc "Não é algo que possa ser feito por videochamada com alguém como ela."

# game/scripts/c31/c31.rpy:4270
translate brazilian c31s006_DanielsFate_adbfb54e:

    # aar "What do you mean by 'someone like her'?"
    aar "O que você quer dizer com 'alguém como ela'?"

# game/scripts/c31/c31.rpy:4271
translate brazilian c31s006_DanielsFate_7f8f069c:

    # mc "[eva] is impulsive and emotional. She's going to want to be here when the decision is made."
    mc "A [eva] é impulsiva e emocional. Ela vai querer estar aqui quando a decisão for tomada."

# game/scripts/c31/c31.rpy:4273
translate brazilian c31s006_DanielsFate_a1af67e0:

    # aar "Phew! You scared me for a second."
    aar "Ufa! Você me assustou por um segundo."

# game/scripts/c31/c31.rpy:4274
translate brazilian c31s006_DanielsFate_322d2ec8:

    # aar "I was starting to think you guys had changed [eva] as much as [ama]."
    aar "Eu estava começando a achar que vocês tinham mudado a [eva] tanto quanto a [ama]."

# game/scripts/c31/c31.rpy:4275
translate brazilian c31s006_DanielsFate_1bfaba52:

    # mc "Maybe a bit more than her."
    mc "Talvez um pouco mais que ela."

# game/scripts/c31/c31.rpy:4276
translate brazilian c31s006_DanielsFate_3dc0f085:

    # mc "Have you noticed she's changed a lot?"
    mc "Você notou que ela mudou muito?"

# game/scripts/c31/c31.rpy:4278
translate brazilian c31s006_DanielsFate_267ff005:

    # aar "Yesterday in the hangar... That was a surprise."
    aar "Ontem no hangar... Aquilo foi uma surpresa."

# game/scripts/c31/c31.rpy:4279
translate brazilian c31s006_DanielsFate_b74dda34:

    # aar "But today I had a really long meeting with her and... She's different."
    aar "Mas hoje eu tive uma reunião bem longa com ela e... Ela está diferente."

# game/scripts/c31/c31.rpy:4280
translate brazilian c31s006_DanielsFate_615fa532:

    # mc "What did you notice?"
    mc "O que você notou?"

# game/scripts/c31/c31.rpy:4282
translate brazilian c31s006_DanielsFate_4cd641e2:

    # aar "She's more... assertive. More self-confident."
    aar "Ela está mais... assertiva. Mais autoconfiante."

# game/scripts/c31/c31.rpy:4283
translate brazilian c31s006_DanielsFate_445aac14:

    # aar "Before leaving her with your family, she would have accepted my orders without question. But now..."
    aar "Antes de deixá-la com a sua família, ela teria aceitado minhas ordens sem questionar. Mas agora..."

# game/scripts/c31/c31.rpy:4284
translate brazilian c31s006_DanielsFate_351a34ca:

    # "You're not going to correct him to say that it's also [ama]'s family now."
    "Você não vai corrigi-lo para dizer que agora também é a família da [ama]."

# game/scripts/c31/c31.rpy:4285
translate brazilian c31s006_DanielsFate_2b486b52:

    # mc "*Laugh* Did you try to give her orders? You're even more brave than you look."
    mc "*Risos* Você tentou dar ordens a ela? Você é ainda mais corajoso do que parece."

# game/scripts/c31/c31.rpy:4286
translate brazilian c31s006_DanielsFate_fc7f2958:

    # mc "She's no longer under your command. You're the head of the Operations Department. She's the head of Security."
    mc "Ela não está mais sob o seu comando. Você é o chefe do Departamento de Operações. Ela é a chefe da Segurança."

# game/scripts/c31/c31.rpy:4288
translate brazilian c31s006_DanielsFate_faefc4a8:

    # aar "I know, I know. But I expected... I don't know... I guess it's old habits."
    aar "Eu sei, eu sei. Mas eu esperava... sei lá... acho que são velhos hábitos."

# game/scripts/c31/c31.rpy:4289
translate brazilian c31s006_DanielsFate_e0a2d44b:

    # mc "Everyone changes, [aar]. Some faster than others."
    mc "Todo mundo muda, [aar]. Alguns mais rápido que os outros."

# game/scripts/c31/c31.rpy:4290
translate brazilian c31s006_DanielsFate_935b12ed:

    # mc "And getting back to Daniels... Where is he right now?"
    mc "E voltando ao Daniels... Onde ele está agora?"

# game/scripts/c31/c31.rpy:4292
translate brazilian c31s006_DanielsFate_224198b2:

    # aar "In a cell, isolated. Guarded by two operatives at all times."
    aar "Em uma cela, isolado. Vigiado por dois agentes o tempo todo."

# game/scripts/c31/c31.rpy:4293
translate brazilian c31s006_DanielsFate_7cea5e69:

    # mc "Are they trustworthy?"
    mc "Eles são de confiança?"

# game/scripts/c31/c31.rpy:4294
translate brazilian c31s006_DanielsFate_1f31b4f0:

    # aar "They do 8-hour shifts, which means there are six operatives involved in his surveillance."
    aar "Eles fazem turnos de 8 horas, o que significa que há seis agentes envolvidos na vigilância dele."

# game/scripts/c31/c31.rpy:4295
translate brazilian c31s006_DanielsFate_7d163951:

    # aar "I think so, they are trustworthy. But..."
    aar "Acho que sim, eles são de confiança. Mas..."

# game/scripts/c31/c31.rpy:4296
translate brazilian c31s006_DanielsFate_ad3deade:

    # mc "We have to trust our own men, [aar]."
    mc "Temos que confiar nos nossos próprios homens, [aar]."

# game/scripts/c31/c31.rpy:4297
translate brazilian c31s006_DanielsFate_68b5d643:

    # mc "If you think we can trust them, we can postpone the decision until [eva] arrives."
    mc "Se você acha que podemos confiar neles, podemos adiar a decisão até a [eva] chegar."

# game/scripts/c31/c31.rpy:4299
translate brazilian c31s006_DanielsFate_4b956114:

    # aar "You surprise me... You... 'normals'... don't usually trust clones this much."
    aar "Você me surpreende... Vocês... 'normais'... não costumam confiar tanto em clones."

# game/scripts/c31/c31.rpy:4301
translate brazilian c31s006_DanielsFate_040859a5:

    # mc "I've lived with [ama] and [eva] for three weeks."
    mc "Eu convivi com a [ama] e a [eva] por três semanas."

# game/scripts/c31/c31.rpy:4303
translate brazilian c31s006_DanielsFate_e0030a5d:

    # mc "I've lived with [eri], [emm], and [dap] my whole life."
    mc "Eu vivi com a [eri], a [emm] e a [dap] a minha vida toda."

# game/scripts/c31/c31.rpy:4304
translate brazilian c31s006_DanielsFate_3feae8d5:

    # mc "I'd trust them with my life without hesitation. I don't care if they're clones or... 'normals'."
    mc "Eu confiaria a minha vida a elas sem hesitar. Não me importo se são clones ou... 'normais'."

# game/scripts/c31/c31.rpy:4305
translate brazilian c31s006_DanielsFate_20211331:

    # mc "I think I'm going to hate that word."
    mc "Acho que vou odiar essa palavra."

# game/scripts/c31/c31.rpy:4306
translate brazilian c31s006_DanielsFate_2aebb2ac:

    # mc "They're just as human as me or [mael]. You trust people for who they are. Not for how they were born."
    mc "Eles são tão humanos quanto eu ou o [mael]. Você confia nas pessoas pelo que elas são. Não por como elas nasceram."

# game/scripts/c31/c31.rpy:4308
translate brazilian c31s006_DanielsFate_56db95f1:

    # aar "I'll say it again. You surprise me."
    aar "Vou dizer de novo. Você me surpreende."

# game/scripts/c31/c31.rpy:4309
translate brazilian c31s006_DanielsFate_c7ee3827:

    # mc "Get ready for more surprises with the Marks, [aar]."
    mc "Prepare-se para mais surpresas com os Marks, [aar]."

# game/scripts/c31/c31.rpy:4311
translate brazilian c31s006_DanielsFate_5c27be9e:

    # aar "About that..."
    aar "Sobre isso..."

# game/scripts/c31/c31.rpy:4312
translate brazilian c31s006_DanielsFate_3b916da8:

    # mc "What's up?"
    mc "O que foi?"

# game/scripts/c31/c31.rpy:4313
translate brazilian c31s006_DanielsFate_82cb7a38:

    # aar "Could you tell [bet] to stop hugging me every time she sees me?"
    aar "Você poderia pedir pra [bet] parar de me abraçar toda vez que me vê?"

# game/scripts/c31/c31.rpy:4314
translate brazilian c31s006_DanielsFate_e7a4ddae:

    # mc "*Laugh* You're delusional if you think that's gonna happen."
    mc "*Risos* Você tá delirando se acha que isso vai acontecer."

# game/scripts/c31/c31.rpy:4315
translate brazilian c31s006_DanielsFate_b1e73e56:

    # mc "She's found a new great-nephew. Good luck getting her to stop hugging you."
    mc "Ela encontrou um novo sobrinho-neto. Boa sorte tentando fazer ela parar de te abraçar."

# game/scripts/c31/c31.rpy:4317
translate brazilian c31s006_DanielsFate_719b1d35:

    # aar "I had to try..."
    aar "Eu tinha que tentar..."

# game/scripts/c31/c31.rpy:4318
translate brazilian c31s006_DanielsFate_9aeb76ed:

    # mc "It's a losing battle, [aar]. But you can try telling her yourself."
    mc "É uma batalha perdida, [aar]. Mas você pode tentar falar com ela você mesmo."

# game/scripts/c31/c31.rpy:4320
translate brazilian c31s006_DanielsFate_474f4ce4:

    # aar "What? No! That woman scares me! I'm sure she'd treat me like a kid saying nonsense if I tried."
    aar "O quê? Não! Aquela mulher me assusta! Tenho certeza que ela me trataria como uma criança falando besteira se eu tentasse."

# game/scripts/c31/c31.rpy:4321
translate brazilian c31s006_DanielsFate_14833ab2:

    # mc "*Laugh* That's probably exactly what she'd do."
    mc "*Risos* Provavelmente é exatamente isso que ela faria."

# game/scripts/c31/c31.rpy:4322
translate brazilian c31s006_DanielsFate_2ce522b5:

    # mc "But you're right. Beneath that sweet old lady exterior, Aunt [bet] is really tough and can be scary."
    mc "Mas você tem razão. Por baixo daquela fachada de velhinha doce, a Tia [bet] é bem durona e pode ser assustadora."

# game/scripts/c31/c31.rpy:4323
translate brazilian c31s006_DanielsFate_7e5a79df:

    # mc "And she has a sixth sense for picking up on things."
    mc "E ela tem um sexto sentido pra perceber as coisas."

# game/scripts/c31/c31.rpy:4325
translate brazilian c31s006_DanielsFate_26a131b5:

    # aar "Sixth sense like in 'I see dead people'?"
    aar "Sexto sentido tipo 'Eu vejo gente morta'?"

# game/scripts/c31/c31.rpy:4326
translate brazilian c31s006_DanielsFate_c976430b:

    # mc "*Laugh* No, but she can tell when someone is keeping a secret."
    mc "*Risos* Não, mas ela sabe quando alguém tá guardando um segredo."

# game/scripts/c31/c31.rpy:4327
translate brazilian c31s006_DanielsFate_ef9ea1d7:

    # mc "If she finds out you're afraid of her, you're a goner."
    mc "Se ela descobrir que você tem medo dela, você já era."

# game/scripts/c31/c31.rpy:4329
translate brazilian c31s006_DanielsFate_b3729bea:

    # aar "*Laugh* My fear level went up a couple of notches just now."
    aar "*Risos* Meu nível de medo acabou de subir uns degraus agora."

# game/scripts/c31/c31.rpy:4330
translate brazilian c31s006_DanielsFate_8edf7e93:

    # aar "See you tomorrow?"
    aar "Até amanhã?"

# game/scripts/c31/c31.rpy:4331
translate brazilian c31s006_DanielsFate_1035461a:

    # mc "Yeah, of course."
    mc "Sim, claro."

# game/scripts/c31/c31.rpy:4333
translate brazilian c31s006_DanielsFate_e91e60c1:

    # "Half an hour after [aar] left..."
    "Meia hora depois que [aar] saiu..."

# game/scripts/c31/c31.rpy:4334
translate brazilian c31s006_DanielsFate_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c31/c31.rpy:4335
translate brazilian c31s006_DanielsFate_2a46e597:

    # car "*Through the door* May I come in, Sir?"
    car "*Através da porta* Posso entrar, senhor?"

# game/scripts/c31/c31.rpy:4336
translate brazilian c31s006_DanielsFate_75e013e9:

    # mc "Come in, [car]."
    mc "Pode entrar, [car]."

# game/scripts/c31/c31.rpy:4338
translate brazilian c31s006_DanielsFate_0e603514:

    # car "I came to tell you that I'm going home."
    car "Vim avisar que estou indo para casa."

# game/scripts/c31/c31.rpy:4339
translate brazilian c31s006_DanielsFate_db660419:

    # mc "Perfect, [car], and thank you. See you on Monday."
    mc "Perfeito, [car], e obrigado. Até segunda-feira."

# game/scripts/c31/c31.rpy:4341
translate brazilian c31s006_DanielsFate_b6221dd6:

    # car "Monday? Aren't you coming in tomorrow?"
    car "Segunda-feira? O senhor não vem amanhã?"

# game/scripts/c31/c31.rpy:4342
translate brazilian c31s006_DanielsFate_bfc9ec9e:

    # mc "It's Saturday... Do you work on Saturdays?"
    mc "É sábado... Você trabalha aos sábados?"

# game/scripts/c31/c31.rpy:4344
translate brazilian c31s006_DanielsFate_83d0ff1c:

    # car "Almost all the staff works on Saturdays, Sir. The Company is open 365 days a year."
    car "Quase todos os funcionários trabalham aos sábados, senhor. A Empresa fica aberta 365 dias por ano."

# game/scripts/c31/c31.rpy:4345
translate brazilian c31s006_DanielsFate_5ad60fc8:

    # mc "How many days off do you get a week?"
    mc "Quantos dias de folga você tem por semana?"

# game/scripts/c31/c31.rpy:4346
translate brazilian c31s006_DanielsFate_312573f0:

    # car "Sundays and Mondays. On Sunday you'll meet [lar], the girl who covers for me when I have my days off."
    car "Domingos e segundas. No domingo o senhor vai conhecer a [lar], a garota que me cobre quando estou de folga."

# game/scripts/c31/c31.rpy:4347
translate brazilian c31s006_DanielsFate_24d33c21:

    # car "Well, that's if you come to work on Sunday... It was Mr. Daniels' day off."
    car "Bem, isso se o senhor vier trabalhar no domingo... Era o dia de folga do Sr. Daniels."

# game/scripts/c31/c31.rpy:4348
translate brazilian c31s006_DanielsFate_f02e70cd:

    # mc "Yes, I'll come. At least this Sunday. It's [gav]'s surgery, and I want to be here."
    mc "Sim, eu virei. Pelo menos neste domingo. É a cirurgia do [gav], e eu quero estar aqui."

# game/scripts/c31/c31.rpy:4350
translate brazilian c31s006_DanielsFate_48081ed2:

    # car "You are... different."
    car "Você é... diferente."

# game/scripts/c31/c31.rpy:4351
translate brazilian c31s006_DanielsFate_9267f44a:

    # mc "If you mean different from Daniels, I'll take that as a compliment."
    mc "Se você quer dizer diferente do Daniels, vou aceitar como um elogio."

# game/scripts/c31/c31.rpy:4353
translate brazilian c31s006_DanielsFate_f95f1c9e:

    # car "Ms. [ama] told me she is waiting for you in the parking lot."
    car "A Sra. [ama] me disse que está esperando por você no estacionamento."

# game/scripts/c31/c31.rpy:4355
translate brazilian c31s006_DanielsFate_8b0ed010:

    # "After that, she disappears without saying anything else."
    "Depois disso, ela desaparece sem dizer mais nada."

# game/scripts/c31/c31.rpy:4357
translate brazilian c31s006_DanielsFate_442334d0:

    # "When you get home, you have dinner with [bet] and [ama]."
    "Quando você chega em casa, você janta com a [bet] e a [ama]."

# game/scripts/c31/c31.rpy:4358
translate brazilian c31s006_DanielsFate_bfdd6feb:

    # "Someone took care of sending catering to the house, which arrives 20 minutes after you do."
    "Alguém se encarregou de enviar um serviço de buffet para a casa, que chega 20 minutos depois de você."

# game/scripts/c31/c31.rpy:4359
translate brazilian c31s006_DanielsFate_8b9dbb6e:

    # "They hit the mark with your favorite dishes, although [bet] complains about the size of the pizza."
    "Eles acertaram em cheio nos seus pratos favoritos, embora a [bet] reclame do tamanho da pizza."

# game/scripts/c31/c31.rpy:4360
translate brazilian c31s006_DanielsFate_73dd2286:

    # "No one complains about the desserts being too plentiful."
    "Ninguém reclama das sobremesas serem tão fartas."

# game/scripts/c31/c31.rpy:4361
translate brazilian c31s006_DanielsFate_3ea72f07:

    # "You have to thank [car]."
    "Você tem que agradecer à [car]."

# game/scripts/c31/c31.rpy:4362
translate brazilian c31s006_DanielsFate_3b458c9c:

    # "You tell each other how your first and exhausting day at NTR went."
    "Vocês contam uns aos outros como foi o primeiro e exaustivo dia de vocês na NTR."

# game/scripts/c31/c31.rpy:4363
translate brazilian c31s006_DanielsFate_1b388b6e:

    # "There are laughs and surprised comments. It was less tough for [ama] than she thought."
    "Há risadas e comentários surpresos. Foi menos difícil para a [ama] do que ela pensava."

# game/scripts/c31/c31.rpy:4365
translate brazilian c31s006_DanielsFate_e4eddf89:

    # "You fall into bed exhausted once again."
    "Você cai na cama exausto mais uma vez."

# game/scripts/c31/c31.rpy:4366
translate brazilian c31s006_DanielsFate_f7b1ca57:

    # "[ama] goes back to sleep in your bed. It's been a long day for her too."
    "[ama] volta a dormir na sua cama. Foi um longo dia para ela também."

# game/scripts/c31/c31.rpy:4372
translate brazilian c31s007_AmaTour_d6d5fd1a:

    # centered "{size=+20}{b}DAY 40 – SATURDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 40 – SÁBADO{/b}{/size}"

# game/scripts/c31/c31.rpy:4374
translate brazilian c31s007_AmaTour_aea2d136:

    # "Your second morning as CEO follows the same pattern as the afternoon of the first."
    "Sua segunda manhã como CEO segue o mesmo padrão da tarde do primeiro dia."

# game/scripts/c31/c31.rpy:4375
translate brazilian c31s007_AmaTour_163c1808:

    # "The occasional visitor leaving a folder on your desk."
    "O visitante ocasional deixando uma pasta na sua mesa."

# game/scripts/c31/c31.rpy:4376
translate brazilian c31s007_AmaTour_64ffe962:

    # "If there are no visitors, it's [car] who hands you a new folder."
    "Se não há visitantes, é a [car] quem te entrega uma nova pasta."

# game/scripts/c31/c31.rpy:4378
translate brazilian c31s007_AmaTour_bafbf60f:

    # "After the last folder before lunchtime..."
    "Depois da última pasta antes da hora do almoço..."

# game/scripts/c31/c31.rpy:4379
translate brazilian c31s007_AmaTour_5c69a606:

    # mc "[car], one moment, please."
    mc "[car], um momento, por favor."

# game/scripts/c31/c31.rpy:4380
translate brazilian c31s007_AmaTour_7a61fa95:

    # car "Yes, Sir?"
    car "Sim, Senhor?"

# game/scripts/c31/c31.rpy:4381
translate brazilian c31s007_AmaTour_87c206c0:

    # mc "Is there any reason why you're bringing me all the documentation on paper?"
    mc "Tem algum motivo para você estar me trazendo toda a documentação em papel?"

# game/scripts/c31/c31.rpy:4382
translate brazilian c31s007_AmaTour_2d96cacb:

    # mc "The only email I've received with documentation was from [geo]."
    mc "O único e-mail que recebi com documentação foi do [geo]."

# game/scripts/c31/c31.rpy:4384
translate brazilian c31s007_AmaTour_12e83ca4:

    # car "Mr. Daniels liked printed documentation. That's why he has so many filing cabinets here."
    car "O Sr. Daniels gostava de documentação impressa. É por isso que ele tem tantos arquivos aqui."

# game/scripts/c31/c31.rpy:4385
translate brazilian c31s007_AmaTour_465d1089:

    # mc "I feel... buried under all these folders and dossiers."
    mc "Eu me sinto... enterrado debaixo de todas essas pastas e dossiês."

# game/scripts/c31/c31.rpy:4387
translate brazilian c31s007_AmaTour_0979b03b:

    # car "So... I don't need to print out your emails or attachments anymore?"
    car "Então... eu não preciso mais imprimir seus e-mails ou anexos?"

# game/scripts/c31/c31.rpy:4388
translate brazilian c31s007_AmaTour_3ca00806:

    # mc "I think you can just forward me whatever you think I should read."
    mc "Acho que você pode apenas me encaminhar o que achar que eu devo ler."

# game/scripts/c31/c31.rpy:4389
translate brazilian c31s007_AmaTour_9d943355:

    # mc "And printing an email? Never, please. It'll be easier for me to find them on my laptop than in the filing cabinets."
    mc "E imprimir um e-mail? Nunca, por favor. Vai ser mais fácil para mim encontrá-los no meu notebook do que nos arquivos."

# game/scripts/c31/c31.rpy:4391
translate brazilian c31s007_AmaTour_272c00ba:

    # car "Understood, Sir."
    car "Entendido, Senhor."

# game/scripts/c31/c31.rpy:4392
translate brazilian c31s007_AmaTour_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c31/c31.rpy:4393
translate brazilian c31s007_AmaTour_154a2f8b:

    # car "At this rate, I wouldn't be able to see you over the folders."
    car "Nesse ritmo, eu não conseguiria ver você por cima das pastas."

# game/scripts/c31/c31.rpy:4394
translate brazilian c31s007_AmaTour_f1c6d19f:

    # car "I'll let [lar] know not to print your messages."
    car "Vou avisar a [lar] para não imprimir suas mensagens."

# game/scripts/c31/c31.rpy:4395
translate brazilian c31s007_AmaTour_da378e55:

    # mc "Thanks, [car]."
    mc "Obrigado, [car]."

# game/scripts/c31/c31.rpy:4398
translate brazilian c31s007_AmaTour_0c2f92fb:

    # "A few minutes later, [ama] walks in without knocking, holding a bag."
    "Alguns minutos depois, [ama] entra sem bater, segurando uma bolsa."

# game/scripts/c31/c31.rpy:4399
translate brazilian c31s007_AmaTour_729887b3:

    # ama "I need to get out of here."
    ama "Eu preciso sair daqui."

# game/scripts/c31/c31.rpy:4400
translate brazilian c31s007_AmaTour_5d36d0c4:

    # mc "What's up? You told me you'd show me the training facilities today."
    mc "O que foi? Você me disse que me mostraria as instalações de treinamento hoje."

# game/scripts/c31/c31.rpy:4401
translate brazilian c31s007_AmaTour_b38e7d1d:

    # mc "But I've had a... complicated day."
    mc "Mas eu tive um dia... complicado."

# game/scripts/c31/c31.rpy:4403
translate brazilian c31s007_AmaTour_8c64f585:

    # ama "Today is going to be impossible."
    ama "Hoje vai ser impossível."

# game/scripts/c31/c31.rpy:4404
translate brazilian c31s007_AmaTour_22da587c:

    # ama "Word got out that we were going to create a surveillance team for Newport."
    ama "Vazou a notícia de que íamos criar uma equipe de vigilância para Newport."

# game/scripts/c31/c31.rpy:4405
translate brazilian c31s007_AmaTour_cabb2e9e:

    # ama "I have over 90 applications to join. And I have to interview them all!"
    ama "Eu tenho mais de 90 inscrições para entrar. E eu tenho que entrevistar todos eles!"

# game/scripts/c31/c31.rpy:4406
translate brazilian c31s007_AmaTour_0c1a63ae:

    # mc "I don't know how it could have leaked. We haven't made it public yet."
    mc "Não sei como pode ter vazado. Nós ainda não tornamos isso público."

# game/scripts/c31/c31.rpy:4408
translate brazilian c31s007_AmaTour_bfa06431:

    # ama "[dam]. His application was the first one. I told you we'd have to run him over."
    ama "[dam]. A inscrição dele foi a primeira. Eu te disse que teríamos que atropelar ele."

# game/scripts/c31/c31.rpy:4409
translate brazilian c31s007_AmaTour_877bd78e:

    # mc "*Laugh* I felt like doing that yesterday. Taking the Not-Tank and running him over."
    mc "*Risos* Eu tive vontade de fazer isso ontem. Pegar o Não-Tanque e atropelar ele."

# game/scripts/c31/c31.rpy:4411
translate brazilian c31s007_AmaTour_7086b554:

    # ama "*Laugh* IFV. If you're going to run this, you have to learn the names of the vehicles and devices."
    ama "*Risos* VCI. Se você vai comandar isso, tem que aprender os nomes dos veículos e dispositivos."

# game/scripts/c31/c31.rpy:4412
translate brazilian c31s007_AmaTour_41d5fd3d:

    # mc "Somewhere among these folders is an inventory of everything we have. With pictures for dummies like me."
    mc "Em algum lugar no meio dessas pastas tem um inventário de tudo que a gente tem. Com fotos para idiotas como eu."

# game/scripts/c31/c31.rpy:4413
translate brazilian c31s007_AmaTour_89ff149b:

    # mc "Someone thought it was a good idea to send it to me."
    mc "Alguém achou que seria uma boa ideia me mandar isso."

# game/scripts/c31/c31.rpy:4415
translate brazilian c31s007_AmaTour_fe3cc708:

    # ama "*Laugh* [aar]. And you can't run him over."
    ama "*Risos* [aar]. E você não pode atropelar ele."

# game/scripts/c31/c31.rpy:4416
translate brazilian c31s007_AmaTour_53e3513d:

    # mc "*Laugh* That's the downside of him also being a shareholder."
    mc "*Risos* Esse é o lado ruim dele também ser um acionista."

# game/scripts/c31/c31.rpy:4417
translate brazilian c31s007_AmaTour_a961595d:

    # mc "But you told me you wanted to get out of here. Are you done with the interviews?"
    mc "Mas você me disse que queria sair daqui. Já terminou com as entrevistas?"

# game/scripts/c31/c31.rpy:4419
translate brazilian c31s007_AmaTour_cf83b6aa:

    # ama "No, but I have an hour and a half free for lunch. I want to show you something at the training ground."
    ama "Não, mas eu tenho uma hora e meia livre pro almoço. Quero te mostrar uma coisa no campo de treinamento."

# game/scripts/c31/c31.rpy:4420
translate brazilian c31s007_AmaTour_127b916c:

    # ama "It's not going to be a sightseeing tour, but there's something I want you to see."
    ama "Não vai ser um passeio turístico, mas tem uma coisa que eu quero que você veja."

# game/scripts/c31/c31.rpy:4421
translate brazilian c31s007_AmaTour_3c59e95c:

    # mc "Is that why you're dressed like that instead of wearing a suit?"
    mc "É por isso que você tá vestida assim em vez de usar um terno?"

# game/scripts/c31/c31.rpy:4423
translate brazilian c31s007_AmaTour_83feee36:

    # ama "Yes, and there are clothes in the bag for you to change into as well."
    ama "Sim, e tem roupas na bolsa pra você se trocar também."

# game/scripts/c31/c31.rpy:4424
translate brazilian c31s007_AmaTour_09bd4eb0:

    # mc "I'm on it. Can you let [car] know that I'll be out for an hour and a half?"
    mc "Pode deixar. Você pode avisar a [car] que eu vou ficar fora por uma hora e meia?"

# game/scripts/c31/c31.rpy:4425
translate brazilian c31s007_AmaTour_0a844e08:

    # mc "I don't have anything on my schedule, but..."
    mc "Eu não tenho nada na minha agenda, mas..."

# game/scripts/c31/c31.rpy:4426
translate brazilian c31s007_AmaTour_b8895caf:

    # ama "I'm on it. Don't take too long."
    ama "Pode deixar. Não demore muito."

# game/scripts/c31/c31.rpy:4427
translate brazilian c31s007_AmaTour_ab9274b5:

    # mc "Five minutes. Five actual minutes."
    mc "Cinco minutos. Cinco minutos de verdade."

# game/scripts/c31/c31.rpy:4430
translate brazilian c31s007_AmaTour_09f25124:

    # "It takes you four minutes. And four minutes later, you're in a military car on your way to the training camp."
    "Você leva quatro minutos. E quatro minutos depois, você está em um carro militar a caminho do acampamento de treinamento."

# game/scripts/c31/c31.rpy:4431
translate brazilian c31s007_AmaTour_11209234:

    # mc "What do you want to show me?"
    mc "O que você quer me mostrar?"

# game/scripts/c31/c31.rpy:4432
translate brazilian c31s007_AmaTour_9aea9237:

    # ama "Do you remember the day your bed broke?"
    ama "Você lembra do dia em que sua cama quebrou?"

# game/scripts/c31/c31.rpy:4433
translate brazilian c31s007_AmaTour_c587b003:

    # mc "Yeah, the day Zeus broke my bed."
    mc "Sim, o dia que o Zeus quebrou a minha cama."

# game/scripts/c31/c31.rpy:4435
translate brazilian c31s007_AmaTour_ff7a6680:

    # ama "I told you I'd show you my most prized possessions. I can't wait to show it to you anymore."
    ama "Eu te disse que te mostraria minhas posses mais valiosas. Não consigo mais esperar para te mostrar."

# game/scripts/c31/c31.rpy:4436
translate brazilian c31s007_AmaTour_dcb682b5:

    # mc "You also told me you hoped I wouldn't consider you a psychopath."
    mc "Você também me disse que esperava que eu não te considerasse uma psicopata."

# game/scripts/c31/c31.rpy:4438
translate brazilian c31s007_AmaTour_75a7f326:

    # ama "Well, my most prized possessions are next to... other things."
    ama "Bem, minhas posses mais valiosas estão perto de... outras coisas."

# game/scripts/c31/c31.rpy:4440
translate brazilian c31s007_AmaTour_299c84a1:

    # mc "Let's see what dark secrets my wife is hiding. I won't stop loving you because of it."
    mc "Vamos ver que segredos obscuros minha esposa está escondendo. Eu não vou deixar de te amar por causa disso."

# game/scripts/c31/c31.rpy:4442
translate brazilian c31s007_AmaTour_d8a39aca:

    # mc "Let's see what dark secrets you're hiding. I won't stop loving you because of it."
    mc "Vamos ver que segredos obscuros você está escondendo. Eu não vou deixar de te amar por causa disso."

# game/scripts/c31/c31.rpy:4444
translate brazilian c31s007_AmaTour_937ccf9d:

    # ama "*Laugh* I hope so. Don't expect me to keep the severed ears of everyone I've killed, either."
    ama "*Risos* Espero que sim. Mas também não espere que eu guarde as orelhas decepadas de todo mundo que eu matei."

# game/scripts/c31/c31.rpy:4445
translate brazilian c31s007_AmaTour_480f108c:

    # "The casual way she says it, between laughter, sends a shiver down your spine."
    "O jeito casual que ela diz isso, entre risadas, dá um arrepio na sua espinha."

# game/scripts/c31/c31.rpy:4446
translate brazilian c31s007_AmaTour_8d66038f:

    # "You will never be able to fully understand the blonde mercenary or her redheaded sister. That makes you feel a bit sad."
    "Você nunca será capaz de entender completamente a mercenária loira ou sua irmã ruiva. Isso faz você se sentir um pouco triste."

# game/scripts/c31/c31.rpy:4447
translate brazilian c31s007_AmaTour_5a740667:

    # "You decide to continue the conversation as if she were joking."
    "Você decide continuar a conversa como se ela estivesse brincando."

# game/scripts/c31/c31.rpy:4448
translate brazilian c31s007_AmaTour_e4406e69:

    # mc "*Fake laugh* At least a few teeth?"
    mc "*Risada falsa* Pelo menos alguns dentes?"

# game/scripts/c31/c31.rpy:4450
translate brazilian c31s007_AmaTour_b982ed32:

    # ama "Movies lie about that. It's harder than it looks to pull a tooth. And it takes time that we usually don't have."
    ama "Os filmes mentem sobre isso. É mais difícil do que parece arrancar um dente. E leva um tempo que geralmente não temos."

# game/scripts/c31/c31.rpy:4451
translate brazilian c31s007_AmaTour_33ef7237:

    # ama "Besides, it would be pretty disgusting to have a collection of teeth."
    ama "Além disso, seria bem nojento ter uma coleção de dentes."

# game/scripts/c31/c31.rpy:4452
translate brazilian c31s007_AmaTour_acec8169:

    # mc "I totally agree."
    mc "Eu concordo totalmente."

# game/scripts/c31/c31.rpy:4453
translate brazilian c31s007_AmaTour_14e552be:

    # "You figure that, if she knows how long it takes to pull a tooth... You'd rather not ask."
    "Você imagina que, se ela sabe quanto tempo leva para arrancar um dente... É melhor não perguntar."

# game/scripts/c31/c31.rpy:4455
translate brazilian c31s007_AmaTour_c0ed0383:

    # "You continue on your way for a few more minutes before [ama] stops the car."
    "Você continua seu caminho por mais alguns minutos antes de [ama] parar o carro."

# game/scripts/c31/c31.rpy:4456
translate brazilian c31s007_AmaTour_74cd2940:

    # "You aren't following any path or road that you can see, but [ama] seems very sure of where she's driving."
    "Você não está seguindo nenhum caminho ou estrada que possa ver, mas [ama] parece muito certa de para onde está dirigindo."

# game/scripts/c31/c31.rpy:4459
translate brazilian c31s007_AmaTour_ce0696f3:

    # "You stop next to a barbed wire fence."
    "Você para perto de uma cerca de arame farpado."

# game/scripts/c31/c31.rpy:4460
translate brazilian c31s007_AmaTour_b9e2c68b:

    # ama "Here we are. You can get out of the car now."
    ama "Aqui estamos. Você já pode sair do carro."

# game/scripts/c31/c31.rpy:4461
translate brazilian c31s007_AmaTour_1de52e47:

    # mc "This isn't the training camp."
    mc "Isso não é o acampamento de treinamento."

# game/scripts/c31/c31.rpy:4463
translate brazilian c31s007_AmaTour_0c5e41c9:

    # ama "*Laugh* Do you want a prize for your observation skills?"
    ama "*Risos* Você quer um prêmio pelas suas habilidades de observação?"

# game/scripts/c31/c31.rpy:4464
translate brazilian c31s007_AmaTour_6c2f2ec1:

    # ama "The training camp starts on the other side of the fence."
    ama "O acampamento de treinamento começa do outro lado da cerca."

# game/scripts/c31/c31.rpy:4465
translate brazilian c31s007_AmaTour_a2ac8600:

    # mc "Can we jump it?"
    mc "A gente consegue pular?"

# game/scripts/c31/c31.rpy:4467
translate brazilian c31s007_AmaTour_c134d120:

    # ama "No need. We'll go under it."
    ama "Não precisa. Nós vamos passar por baixo."

# game/scripts/c31/c31.rpy:4468
translate brazilian c31s007_AmaTour_08aa36f9:

    # mc "Lead the way."
    mc "Mostre o caminho."

# game/scripts/c31/c31.rpy:4470
translate brazilian c31s007_AmaTour_df1542f1:

    # "You walk about a hundred and fifty steps among small gullies created by rainwater runoff."
    "Você anda cerca de cento e cinquenta passos entre pequenas valas criadas pelo escoamento da água da chuva."

# game/scripts/c31/c31.rpy:4471
translate brazilian c31s007_AmaTour_42ad5c91:

    # "You use one of those gullies to pass under the fence."
    "Você usa uma dessas valas para passar por baixo da cerca."

# game/scripts/c31/c31.rpy:4472
translate brazilian c31s007_AmaTour_32ba3773:

    # "You only need to crouch. No crawling. You make a mental note that something needs to be done about the gullies."
    "Você só precisa se agachar. Sem rastejar. Você faz uma nota mental de que algo precisa ser feito sobre as valas."

# game/scripts/c31/c31.rpy:4473
translate brazilian c31s007_AmaTour_d52f7618:

    # "You walk about fifty more steps after crossing the fence."
    "Você anda mais uns cinquenta passos depois de cruzar a cerca."

# game/scripts/c31/c31.rpy:4476
translate brazilian c31s007_AmaTour_db9b9307:

    # ama "Here it is."
    ama "Aqui está."

# game/scripts/c31/c31.rpy:4477
translate brazilian c31s007_AmaTour_5f4607c0:

    # mc "Here? But there's nothing here."
    mc "Aqui? Mas não tem nada aqui."

# game/scripts/c31/c31.rpy:4478
translate brazilian c31s007_AmaTour_10a95077:

    # mc "It's exactly the same as thirty meters back there. I think I've seen that rock three times today."
    mc "É exatamente igual a trinta metros atrás. Acho que já vi aquela pedra umas três vezes hoje."

# game/scripts/c31/c31.rpy:4480
translate brazilian c31s007_AmaTour_5967a00a:

    # "[ama] surprises you by dropping to the ground."
    "[ama] te surpreende ao se jogar no chão."

# game/scripts/c31/c31.rpy:4481
translate brazilian c31s007_AmaTour_690646ab:

    # ama "Except for this burrow... Just a moment... I almost have it."
    ama "Exceto por essa toca... Só um momento... Quase peguei."

# game/scripts/c31/c31.rpy:4482
translate brazilian c31s007_AmaTour_4ec5b0f7:

    # ama "It has rained quite a bit since the last time I was here, and there's more dirt than I expected."
    ama "Choveu bastante desde a última vez que estive aqui, e tem mais terra do que eu esperava."

# game/scripts/c31/c31.rpy:4484
translate brazilian c31s007_AmaTour_7bbd55c5:

    # "After a while, [ama] pulls out a pretty dirty waterproof bag."
    "Depois de um tempo, [ama] puxa uma bolsa impermeável bem suja."

# game/scripts/c31/c31.rpy:4485
translate brazilian c31s007_AmaTour_0028cf35:

    # "She tries to wipe it clean with her hand, without much success."
    "Ela tenta limpá-la com a mão, sem muito sucesso."

# game/scripts/c31/c31.rpy:4486
translate brazilian c31s007_AmaTour_58a4054a:

    # mc "What's in there? It's not very big."
    mc "O que tem aí? Não é muito grande."

# game/scripts/c31/c31.rpy:4488
translate brazilian c31s007_AmaTour_031b17bd:

    # ama "I already told you, my most prized possessions. Sit down."
    ama "Eu já te disse, meus bens mais preciosos. Senta aí."

# game/scripts/c31/c31.rpy:4489
translate brazilian c31s007_AmaTour_4d4c7852:

    # "The sadness in her eyes is enough to make you sit down without opening your mouth."
    "A tristeza nos olhos dela é o suficiente para fazer você se sentar sem abrir a boca."

# game/scripts/c31/c31.rpy:4490
translate brazilian c31s007_AmaTour_4a29174e:

    # "The bag is small. You expect something with sentimental value, but you can't imagine what it is."
    "A bolsa é pequena. Você espera algo com valor sentimental, mas não consegue imaginar o que é."

# game/scripts/c31/c31.rpy:4495
translate brazilian c31s007_AmaTour_ae3e3856:

    # "[ama] takes a faded polaroid out of the bag. It shows a little girl in military gear that looks too big for her."
    "[ama] tira uma polaroid desbotada da bolsa. Ela mostra uma garotinha com um equipamento militar que parece grande demais para ela."

# game/scripts/c31/c31.rpy:4496
translate brazilian c31s007_AmaTour_1519bf7e:

    # ama "Meet Fiona. It's the only existing picture of her."
    ama "Conheça a Fiona. É a única foto que existe dela."

# game/scripts/c31/c31.rpy:4497
translate brazilian c31s007_AmaTour_7a085a2a:

    # ama "It's from a training session a week before she died."
    ama "É de uma sessão de treinamento uma semana antes dela morrer."

# game/scripts/c31/c31.rpy:4499
translate brazilian c31s007_AmaTour_0e5674ee:

    # mc "She reminds me of young [eri] more than young [dap]."
    mc "Ela me lembra mais a [eri] jovem do que a [dap] jovem."

# game/scripts/c31/c31.rpy:4501
translate brazilian c31s007_AmaTour_4f2aeb04:

    # mc "For some reason, I imagined a miniature [eva]. I guess because of the name she gave the doll."
    mc "Por algum motivo, eu imaginei uma [eva] em miniatura. Acho que por causa do nome que ela deu à boneca."

# game/scripts/c31/c31.rpy:4502
translate brazilian c31s007_AmaTour_17129545:

    # mc "But she reminds me more of young [eri] than [eva]."
    mc "Mas ela me lembra mais a [eri] jovem do que a [eva]."

# game/scripts/c31/c31.rpy:4504
translate brazilian c31s007_AmaTour_4a0ca034:

    # ama "I think she would've liked to hear that. She was the most empathetic of all of us."
    ama "Acho que ela teria gostado de ouvir isso. Ela era a mais empática de todas nós."

# game/scripts/c31/c31.rpy:4505
translate brazilian c31s007_AmaTour_043e1d38:

    # ama "I think you are right, she would've been like [eri] if she'd had the chance."
    ama "Acho que você tem razão, ela teria sido como a [eri] se tivesse tido a chance."

# game/scripts/c31/c31.rpy:4506
translate brazilian c31s007_AmaTour_834e9fe5:

    # mc "I'm sorry, [ama]. I'm sorry for everything you guys had to go through."
    mc "Sinto muito, [ama]. Sinto muito por tudo que vocês tiveram que passar."

# game/scripts/c31/c31.rpy:4507
translate brazilian c31s007_AmaTour_6a5616d7:

    # mc "I'm sorry about Fiona. But also about Clarice, Beatrice, and Diana."
    mc "Sinto muito pela Fiona. Mas também pela Clarice, Beatrice e Diana."

# game/scripts/c31/c31.rpy:4508
translate brazilian c31s007_AmaTour_63223d14:

    # mc "I'm sorry I never got the chance to meet them."
    mc "Sinto muito por nunca ter tido a chance de conhecê-las."

# game/scripts/c31/c31.rpy:4511
translate brazilian c31s007_AmaTour_f7321d28:

    # "You spend a while looking at the photo. You'd like to hug the woman you adore, but you know she's deep in thought."
    "Você passa um tempo olhando para a foto. Você gostaria de abraçar a mulher que adora, mas sabe que ela está perdida em pensamentos."

# game/scripts/c31/c31.rpy:4513
translate brazilian c31s007_AmaTour_a2a37865:

    # "You spend a while looking at the photo. You'd like to hug the sad mercenary, but you know she's deep in thought."
    "Você passa um tempo olhando para a foto. Você gostaria de abraçar a mercenária triste, mas sabe que ela está perdida em pensamentos."

# game/scripts/c31/c31.rpy:4514
translate brazilian c31s007_AmaTour_44855285:

    # "You hate Daniels for depriving you of the chance to meet Diana, Beatrice, and Clarice."
    "Você odeia Daniels por privá-lo da chance de conhecer Diana, Beatrice e Clarice."

# game/scripts/c31/c31.rpy:4515
translate brazilian c31s007_AmaTour_40f021f2:

    # "You hate Richards, the CEO before Daniels, because Fiona's death happened under his watch."
    "Você odeia Richards, o CEO antes de Daniels, porque a morte de Fiona aconteceu sob a vigilância dele."

# game/scripts/c31/c31.rpy:4516
translate brazilian c31s007_AmaTour_3007892c:

    # "But above all, you pity the girls. The living and the dead. For what they went through. For what they suffered."
    "Mas, acima de tudo, você tem pena das garotas. As vivas e as mortas. Pelo que elas passaram. Pelo que elas sofreram."

# game/scripts/c31/c31.rpy:4518
translate brazilian c31s007_AmaTour_7f74b570:

    # "And the rest of the clones, too. They went through the same thing."
    "E o resto dos clones também. Eles passaram pela mesma coisa."

# game/scripts/c31/c31.rpy:4520
translate brazilian c31s007_AmaTour_ac792836:

    # "And the clones, too. They went through the same thing."
    "E os clones também. Eles passaram pela mesma coisa."

# game/scripts/c31/c31.rpy:4521
translate brazilian c31s007_AmaTour_c0b79d13:

    # "None of them deserved it."
    "Nenhum deles merecia isso."

# game/scripts/c31/c31.rpy:4523
translate brazilian c31s007_AmaTour_a8136d8d:

    # mc "Are you okay?"
    mc "Você está bem?"

# game/scripts/c31/c31.rpy:4524
translate brazilian c31s007_AmaTour_e5064004:

    # ama "No. But I wanted you to meet them."
    ama "Não. Mas eu queria que você as conhecesse."

# game/scripts/c31/c31.rpy:4525
translate brazilian c31s007_AmaTour_c6c6b70c:

    # mc "Did you say 'them'?"
    mc "Você disse 'elas'?"

# game/scripts/c31/c31.rpy:4530
translate brazilian c31s007_AmaTour_fef26734:

    # ama "These are the other girls. Well, we are..."
    ama "Essas são as outras garotas. Bem, nós somos..."

# game/scripts/c31/c31.rpy:4531
translate brazilian c31s007_AmaTour_be330c67:

    # ama "Diana, me, Beatrice, [eva], and Clarice."
    ama "Diana, eu, Beatrice, [eva] e Clarice."

# game/scripts/c31/c31.rpy:4532
translate brazilian c31s007_AmaTour_3d2bf7e0:

    # mc "You're all so different from each other... And it's weird seeing you as a brunette."
    mc "Vocês são todas tão diferentes umas das outras... E é estranho ver você morena."

# game/scripts/c31/c31.rpy:4534
translate brazilian c31s007_AmaTour_8b7fa035:

    # ama "We tried to maintain our individuality by dyeing our hair and wearing different makeup."
    ama "Nós tentamos manter nossa individualidade tingindo o cabelo e usando maquiagens diferentes."

# game/scripts/c31/c31.rpy:4535
translate brazilian c31s007_AmaTour_7329578b:

    # ama "We were allowed to do that, unlike the rest of the clones."
    ama "Nós tínhamos permissão para fazer isso, diferente do resto dos clones."

# game/scripts/c31/c31.rpy:4536
translate brazilian c31s007_AmaTour_26f78c73:

    # ama "Diana was the prettiest of us. Her specialties were... seduction and assassination."
    ama "Diana era a mais bonita de nós. As especialidades dela eram... sedução e assassinato."

# game/scripts/c31/c31.rpy:4537
translate brazilian c31s007_AmaTour_f98baf20:

    # ama "Beatrice always liked being the strongest. She specialized in heavy weaponry and logistics."
    ama "Beatrice sempre gostou de ser a mais forte. Ela era especialista em armamento pesado e logística."

# game/scripts/c31/c31.rpy:4538
translate brazilian c31s007_AmaTour_e409203c:

    # ama "Clarice was the most fragile of us all. She was sick when we were kids and... Well, she was the smallest along with Fiona."
    ama "Clarice era a mais frágil de todas nós. Ela ficou doente quando éramos crianças e... Bem, ela era a menor junto com a Fiona."

# game/scripts/c31/c31.rpy:4539
translate brazilian c31s007_AmaTour_0f21242b:

    # ama "She was the communications specialist. But she would have crushed anyone in a fight."
    ama "Ela era a especialista em comunicações. Mas ela teria esmagado qualquer um numa briga."

# game/scripts/c31/c31.rpy:4540
translate brazilian c31s007_AmaTour_9840f65d:

    # ama "And [eva] and me, you already know us."
    ama "E [eva] e eu, você já nos conhece."

# game/scripts/c31/c31.rpy:4541
translate brazilian c31s007_AmaTour_68830a2a:

    # mc "What was your specialty?"
    mc "Qual era a sua especialidade?"

# game/scripts/c31/c31.rpy:4543
translate brazilian c31s007_AmaTour_90632b16:

    # ama "Mine was surveillance, interrogation, and espionage. I broke my leg when I was six and spent a month glued to the monitors."
    ama "A minha era vigilância, interrogatório e espionagem. Eu quebrei a perna quando tinha seis anos e passei um mês grudada nos monitores."

# game/scripts/c31/c31.rpy:4544
translate brazilian c31s007_AmaTour_1cd31f0d:

    # ama "[eva]'s specialty was... is... infiltration and elimination."
    ama "A especialidade da [eva] era... é... infiltração e eliminação."

# game/scripts/c31/c31.rpy:4545
translate brazilian c31s007_AmaTour_9090a1f8:

    # ama "Fiona would have been our sniper."
    ama "Fiona teria sido nossa franco-atiradora."

# game/scripts/c31/c31.rpy:4546
translate brazilian c31s007_AmaTour_e178a7a4:

    # ama "But don't get me wrong. Any of us could do everything."
    ama "Mas não me entenda mal. Qualquer uma de nós podia fazer de tudo."

# game/scripts/c31/c31.rpy:4548
translate brazilian c31s007_AmaTour_47b70cce:

    # ama "Well... maybe everything except the seduction part. Only Diana and Clarice did that."
    ama "Bem... talvez tudo, exceto a parte da sedução. Só a Diana e a Clarice faziam isso."

# game/scripts/c31/c31.rpy:4549
translate brazilian c31s007_AmaTour_368fcaef:

    # mc "You told me."
    mc "Você me disse."

# game/scripts/c31/c31.rpy:4551
translate brazilian c31s007_AmaTour_3c2aed6c:

    # ama "But as for the rest, any of us could use a grenade launcher or comms equipment."
    ama "Mas quanto ao resto, qualquer uma de nós sabia usar um lança-granadas ou equipamento de comunicação."

# game/scripts/c31/c31.rpy:4552
translate brazilian c31s007_AmaTour_37eb576e:

    # ama "And, obviously, we could all beat anyone on the base at the shooting range with an M4A1 or a Glock."
    ama "E, obviamente, todas nós podíamos vencer qualquer um na base no estande de tiro com uma M4A1 ou uma Glock."

# game/scripts/c31/c31.rpy:4553
translate brazilian c31s007_AmaTour_c90cfebc:

    # ama "And in hand-to-hand combat, we could compete with anyone."
    ama "E no combate corpo a corpo, podíamos competir com qualquer um."

# game/scripts/c31/c31.rpy:4554
translate brazilian c31s007_AmaTour_1386d5a0:

    # mc "Sounds very strange to me... Specialists, but at the same time generalists."
    mc "Parece muito estranho pra mim... Especialistas, mas ao mesmo tempo generalistas."

# game/scripts/c31/c31.rpy:4556
translate brazilian c31s007_AmaTour_5eef60ce:

    # ama "You never know what you're going to encounter on a mission. We all had to know how to do everything."
    ama "Nunca se sabe o que vai encontrar numa missão. Todos nós tínhamos que saber fazer de tudo."

# game/scripts/c31/c31.rpy:4557
translate brazilian c31s007_AmaTour_53f9fb7c:

    # ama "Some of the other operatives are more specialized. The Ds are really good with heavy weapons. They're big guys."
    ama "Alguns dos outros agentes são mais especializados. Os Ds são muito bons com armas pesadas. São caras grandes."

# game/scripts/c31/c31.rpy:4558
translate brazilian c31s007_AmaTour_30a0ae8c:

    # ama "But they'll never be as good as Beatrice was."
    ama "Mas eles nunca serão tão bons quanto a Beatrice era."

# game/scripts/c31/c31.rpy:4559
translate brazilian c31s007_AmaTour_d56b9c53:

    # mc "I get it."
    mc "Entendi."

# game/scripts/c31/c31.rpy:4560
translate brazilian c31s007_AmaTour_2280aea1:

    # mc "You said that was the only photo of Fiona. That's weird, right?"
    mc "Você disse que aquela era a única foto da Fiona. Isso é estranho, né?"

# game/scripts/c31/c31.rpy:4561
translate brazilian c31s007_AmaTour_37550ed7:

    # mc "I guess there aren't many photos of all of you together either."
    mc "Acho que também não há muitas fotos de vocês todos juntos."

# game/scripts/c31/c31.rpy:4566
translate brazilian c31s007_AmaTour_692c7fce:

    # ama "This is the only one there is, as far as I know."
    ama "Esse é o único que existe, pelo que eu saiba."

# game/scripts/c31/c31.rpy:4567
translate brazilian c31s007_AmaTour_d7520798:

    # ama "Photos are forbidden on the base, except when they want to make a promotional poster. And even then we wear masks."
    ama "É proibido tirar fotos na base, a não ser quando querem fazer um pôster promocional. E mesmo nessas ocasiões, usamos máscaras."

# game/scripts/c31/c31.rpy:4568
translate brazilian c31s007_AmaTour_72786cbc:

    # ama "Nobody wants a photo of 10 G-series clones circulating on the internet. Or a photo of six 6-year-old girls training."
    ama "Ninguém quer que circule na internet uma foto com dez clones da série G. Nem uma foto de seis meninas de 6 anos treinando."

# game/scripts/c31/c31.rpy:4569
translate brazilian c31s007_AmaTour_8dabad0f:

    # mc "I get it. So much secrecy..."
    mc "Entendi. Tanto mistério..."

# game/scripts/c31/c31.rpy:4570
translate brazilian c31s007_AmaTour_3c07ff49:

    # mc "I'm glad you showed me these photos. It makes me happy and sad at the same time."
    mc "Fico feliz que você tenha me mostrado essas fotos. Isso me deixa feliz e triste ao mesmo tempo."


# game/scripts/c31/c31.rpy:4572
translate brazilian c31s007_AmaTour_76b8b592:

    # ama "Fiona's photo was taken by Arnau, one of [aar]'s brothers, with a smuggled camera."
    ama "A foto da Fiona foi tirada pelo Arnau, um dos irmãos do [aar], com uma câmera contrabandeada."

# game/scripts/c31/c31.rpy:4573
translate brazilian c31s007_AmaTour_dc702d85:

    # ama "Ours was taken by [aar]. They found the camera and took it away."
    ama "A nossa foi tirada pelo [aar]. Eles acharam a câmera e a levaram embora."

# game/scripts/c31/c31.rpy:4574
translate brazilian c31s007_AmaTour_f26029ae:

    # ama "That's why I kept them here. It was my secret hiding spot. No one could take them from me here."
    ama "É por isso que eu as guardei aqui. Era o meu esconderijo secreto. Ninguém poderia tirá-las de mim aqui."

# game/scripts/c31/c31.rpy:4576
translate brazilian c31s007_AmaTour_191509e1:

    # ama "The last time I was here, I didn't know that I'd never see my sisters alive again."
    ama "A última vez que estive aqui, eu não sabia que nunca mais veria minhas irmãs vivas."

# game/scripts/c31/c31.rpy:4577
translate brazilian c31s007_AmaTour_47b414f6:

    # ama "I wish you guys could have met them. And that they could have met you."
    ama "Eu queria que vocês tivessem conhecido elas. E que elas pudessem ter conhecido vocês."

# game/scripts/c31/c31.rpy:4578
translate brazilian c31s007_AmaTour_e8427a0e:

    # "You know she's trying to act tough. The [ama] from back home would probably be crying by now. Coming back to Aruba is changing her."
    "Você sabe que ela está tentando se fazer de durona. A [ama] de casa provavelmente já estaria chorando agora. Voltar para Aruba está mudando ela."

# game/scripts/c31/c31.rpy:4579
translate brazilian c31s007_AmaTour_8908deda:

    # mc "You don't need to hide them anymore. No one is ever going to take those photos from you."
    mc "Você não precisa mais escondê-las. Ninguém nunca vai tirar essas fotos de você."

# game/scripts/c31/c31.rpy:4580
translate brazilian c31s007_AmaTour_844d759b:

    # mc "I'll take care of it if anyone tries."
    mc "Eu dou um jeito se alguém tentar."

# game/scripts/c31/c31.rpy:4582
translate brazilian c31s007_AmaTour_550cd2ea:

    # ama "Thanks, [mc]. Though I guess now that I own part of the company, no one would dare."
    ama "Obrigada, [mc]. Embora eu ache que agora que sou dona de parte da empresa, ninguém ousaria."

# game/scripts/c31/c31.rpy:4583
translate brazilian c31s007_AmaTour_d91cc20f:

    # mc "I guess not."
    mc "Acho que não."

# game/scripts/c31/c31.rpy:4584
translate brazilian c31s007_AmaTour_863c2920:

    # mc "But I don't see anything that would make me call you a psychopath. Having photos of your sisters isn't it."
    mc "Mas não vejo nada que me faria te chamar de psicopata. Ter fotos das suas irmãs não é isso."

# game/scripts/c31/c31.rpy:4586
translate brazilian c31s007_AmaTour_54748aeb:

    # ama "There's something else in the bag."
    ama "Tem mais uma coisa na bolsa."

# game/scripts/c31/c31.rpy:4588
translate brazilian c31s007_AmaTour_c60ffa46:

    # "[ama] takes a piece of metal out of the bag and leaves it on her knee. You have no idea what it could be."
    "[ama] tira um pedaço de metal da bolsa e o deixa no joelho. Você não faz ideia do que possa ser."

# game/scripts/c31/c31.rpy:4589
translate brazilian c31s007_AmaTour_81df295e:

    # ama "It's a piece of shrapnel from the device that killed Fiona."
    ama "É um pedaço de estilhaço do dispositivo que matou a Fiona."

# game/scripts/c31/c31.rpy:4590
translate brazilian c31s007_AmaTour_cda67e0f:

    # ama "Each of us kept a piece. I hid mine here and couldn't get it back when we had to leave."
    ama "Cada uma de nós guardou um pedaço. Eu escondi o meu aqui e não consegui pegar de volta quando tivemos que ir embora."

# game/scripts/c31/c31.rpy:4591
translate brazilian c31s007_AmaTour_8149625e:

    # mc "What's wrong with that?"
    mc "Qual o problema nisso?"

# game/scripts/c31/c31.rpy:4593
translate brazilian c31s007_AmaTour_65f7e344:

    # ama "Don't you think it's weird that we kept a piece of the thing that killed our sister?"
    ama "Você não acha estranho que a gente tenha guardado um pedaço da coisa que matou a nossa irmã?"

# game/scripts/c31/c31.rpy:4594
translate brazilian c31s007_AmaTour_44e7274b:

    # mc "It's not common, but I've seen mothers wearing a lock of their dead child's hair around their necks and..."
    mc "Não é comum, mas eu já vi mães usando uma mecha do cabelo do filho morto no pescoço e..."

# game/scripts/c31/c31.rpy:4595
translate brazilian c31s007_AmaTour_49ad248f:

    # mc "Wait... Show me the picture of the five of you again."
    mc "Espera... Me mostra a foto de vocês cinco de novo."

# game/scripts/c31/c31.rpy:4600
translate brazilian c31s007_AmaTour_bd368d65:

    # mc "The heart [eva] always wears around her neck... Is that her piece of the explosive?"
    mc "O coração que a [eva] sempre usa no pescoço... É o pedaço do explosivo dela?"

# game/scripts/c31/c31.rpy:4602
translate brazilian c31s007_AmaTour_22c2d107:

    # ama "Yes. It's the biggest piece. The one that killed her. She shaped it into a heart and made a pendant out of it."
    ama "Sim. É o maior pedaço. O que a matou. Ela moldou em formato de coração e fez um pingente."

# game/scripts/c31/c31.rpy:4603
translate brazilian c31s007_AmaTour_4c4fe98d:

    # ama "That's why she always wears it. It's her way of letting Fiona... see the world she missed out on."
    ama "É por isso que ela sempre usa. É o jeito dela de deixar a Fiona... ver o mundo que ela perdeu."

# game/scripts/c31/c31.rpy:4604
translate brazilian c31s007_AmaTour_655658b1:

    # ama "I know it might sound twisted to anyone other than her sisters, but..."
    ama "Eu sei que pode soar doentio para qualquer um além das irmãs dela, mas..."

# game/scripts/c31/c31.rpy:4605
translate brazilian c31s007_AmaTour_03aed379:

    # mc "It's not twisted, [ama]. It's a very sweet gesture on [eva]'s part."
    mc "Não é doentio, [ama]. É um gesto muito doce da parte da [eva]."

# game/scripts/c31/c31.rpy:4607
translate brazilian c31s007_AmaTour_5d8674bc:

    # ama "Don't tell her I told you. Not even that you figured it out yourself."
    ama "Não conte a ela que eu te falei. Nem mesmo que você descobriu sozinho."

# game/scripts/c31/c31.rpy:4608
translate brazilian c31s007_AmaTour_61af9c86:

    # ama "She'd probably kill me and then feel very lonely being the only one alive out of the six of us."
    ama "Ela provavelmente me mataria e depois se sentiria muito solitária sendo a única viva de nós seis."

# game/scripts/c31/c31.rpy:4609
translate brazilian c31s007_AmaTour_c77894c6:

    # mc "That would be very typical of [eva]. Don't worry, I won't say anything."
    mc "Isso seria bem típico da [eva]. Não se preocupe, eu não vou dizer nada."

# game/scripts/c31/c31.rpy:4610
translate brazilian c31s007_AmaTour_9122b12e:

    # mc "I asked her about the heart and she told me she'd tell me about it someday. I have to give her the chance to do that when she's ready."
    mc "Eu perguntei a ela sobre o coração e ela me disse que me contaria sobre isso algum dia. Tenho que dar a ela a chance de fazer isso quando estiver pronta."

# game/scripts/c31/c31.rpy:4613
translate brazilian c31s007_AmaTour_ae79eb17:

    # "[ama] stands up after putting the photos and the fragment back into the bag."
    "[ama] se levanta depois de colocar as fotos e o fragmento de volta na bolsa."

# game/scripts/c31/c31.rpy:4614
translate brazilian c31s007_AmaTour_ef2df167:

    # "She doesn't put it back in the hiding spot, but instead puts it in one of her pants pockets."
    "Ela não coloca de volta no esconderijo, mas sim em um dos bolsos da calça."

# game/scripts/c31/c31.rpy:4615
translate brazilian c31s007_AmaTour_168388e6:

    # ama "And now we should get going. Our hour and a half is almost up. I still have to interview several operatives today."
    ama "E agora devemos ir. Nossa uma hora e meia está quase acabando. Eu ainda tenho que entrevistar vários agentes hoje."

# game/scripts/c31/c31.rpy:4616
translate brazilian c31s007_AmaTour_396d4bef:

    # ama "And [car] won't like it if you're late."
    ama "E a [car] não vai gostar se você se atrasar."

# game/scripts/c31/c31.rpy:4617
translate brazilian c31s007_AmaTour_9ec71eb9:

    # mc "Do we have time to do one thing?"
    mc "Temos tempo para fazer uma coisa?"

# game/scripts/c31/c31.rpy:4618
translate brazilian c31s007_AmaTour_e474bb73:

    # ama "Depends. What do you want to do?"
    ama "Depende. O que você quer fazer?"

# game/scripts/c31/c31.rpy:4620
translate brazilian c31s007_AmaTour_902b3dcc:

    # "You stand up and hug her. You have no words to express what you feel. Your arms around her body will have to convey the message."
    "Você se levanta e a abraça. Você não tem palavras para expressar o que sente. Seus braços ao redor do corpo dela terão que transmitir a mensagem."

# game/scripts/c31/c31.rpy:4622
translate brazilian c31s007_AmaTour_95ec8f3f:

    # "For the first time since she took the bag out of the hideout, [ama] lets her feelings flow."
    "Pela primeira vez desde que ela tirou a bolsa do esconderijo, [ama] deixa seus sentimentos fluírem."

# game/scripts/c31/c31.rpy:4623
translate brazilian c31s007_AmaTour_d5276be1:

    # "You hate making her cry, but these tears are also part of her healing process."
    "Você odeia fazê-la chorar, mas essas lágrimas também fazem parte do processo de cura dela."

# game/scripts/c31/c31.rpy:4624
translate brazilian c31s007_AmaTour_0bb7ae79:

    # "Neither of you cares about being a little late to the next appointment on your schedule."
    "Nenhum de vocês se importa em se atrasar um pouco para o próximo compromisso na sua agenda."

# game/scripts/c31/c31.rpy:4628
translate brazilian c31s007_surgery_ea02b104:

    # "The rest of the day passes with what seems to be the new normal."
    "O resto do dia passa com o que parece ser o novo normal."

# game/scripts/c31/c31.rpy:4629
translate brazilian c31s007_surgery_b69f9398:

    # "At least the folders stop piling up on your desk."
    "Pelo menos as pastas param de se acumular na sua mesa."

# game/scripts/c31/c31.rpy:4631
translate brazilian c31s007_surgery_50007757:

    # "Upon returning to the CEO's House, and after showering, you eat the catering that [car] ordered for dinner."
    "Ao retornar para a Casa do CEO, e depois de tomar banho, você come a comida que [car] pediu para o jantar."

# game/scripts/c31/c31.rpy:4632
translate brazilian c31s007_surgery_6f280d90:

    # "Once again she nailed it with dishes you like. You have to find out how she does it."
    "Mais uma vez ela acertou em cheio com os pratos que você gosta. Você tem que descobrir como ela faz isso."

# game/scripts/c31/c31.rpy:4633
translate brazilian c31s007_surgery_8b9e4664:

    # "[bet] is a little nervous about the next day's surgery."
    "[bet] está um pouco nervosa com a cirurgia do dia seguinte."

# game/scripts/c31/c31.rpy:4634
translate brazilian c31s007_surgery_91b38331:

    # "She has spent the last two days meeting with surgeons and engineers, and rehearsing the surgery."
    "Ela passou os últimos dois dias se reunindo com cirurgiões e engenheiros, e ensaiando a cirurgia."

# game/scripts/c31/c31.rpy:4635
translate brazilian c31s007_surgery_f357ce29:

    # "She thinks it'll go well, but it's a surgery that has never been done before. There are too many things that could go wrong."
    "Ela acha que vai dar tudo certo, mas é uma cirurgia que nunca foi feita antes. Tem muitas coisas que podem dar errado."

# game/scripts/c31/c31.rpy:4637
translate brazilian c31s007_surgery_9117775c:

    # "This time, the two women decide to sleep with you."
    "Dessa vez, as duas mulheres decidem dormir com você."

# game/scripts/c31/c31.rpy:4638
translate brazilian c31s007_surgery_117c5f6b:

    # "You go to bed early. [gav]'s surgery is scheduled for 10 AM."
    "Você vai para a cama cedo. A cirurgia do [gav] está marcada para as 10 da manhã."

# game/scripts/c31/c31.rpy:4639
translate brazilian c31s007_surgery_7ea9f7c2:

    # "The bed is big enough for the three of you."
    "A cama é grande o suficiente para vocês três."

# game/scripts/c31/c31.rpy:4641
translate brazilian c31s007_surgery_66562efc:

    # centered "{size=+20}{b}DAY 41 – SUNDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 41 – DOMINGO{/b}{/size}"

# game/scripts/c31/c31.rpy:4643
translate brazilian c31s007_surgery_6ef2d0b1:

    # "In the morning, [bet] barely touches the freshly baked croissants that [car] sends every morning."
    "De manhã, [bet] mal toca nos croissants recém-assados que [car] manda toda manhã."

# game/scripts/c31/c31.rpy:4644
translate brazilian c31s007_surgery_4cc9ee8e:

    # "If you needed any sign of how nervous she is, that's more than enough."
    "Se você precisava de algum sinal de quão nervosa ela está, isso é mais do que suficiente."

# game/scripts/c31/c31.rpy:4646
translate brazilian c31s007_surgery_35bcb1b1:

    # "You arrive at your office a little before 8. It feels weird not seeing [car] when you arrive."
    "Você chega ao seu escritório um pouco antes das 8. É estranho não ver [car] quando você chega."

# game/scripts/c31/c31.rpy:4647
translate brazilian c31s007_surgery_19ad6719:

    # "The folders have disappeared from your desk and a bunch of emails have appeared in your inbox."
    "As pastas desapareceram da sua mesa e um monte de e-mails apareceram na sua caixa de entrada."

# game/scripts/c31/c31.rpy:4648
translate brazilian c31s007_surgery_2e8b336a:

    # "There's a coffee waiting for you, which means [lar] is probably already in the building."
    "Tem um café esperando por você, o que significa que [lar] provavelmente já está no prédio."

# game/scripts/c31/c31.rpy:4649
translate brazilian c31s007_surgery_6e2893d5:

    # "You think you're going to love [car]'s efficiency."
    "Você acha que vai adorar a eficiência da [car]."

# game/scripts/c31/c31.rpy:4652
translate brazilian c31s007_surgery_f00b0076:

    # "After a few minutes of reading emails..."
    "Depois de alguns minutos lendo e-mails..."

# game/scripts/c31/c31.rpy:4653
translate brazilian c31s007_surgery_26e21393:

    # lar "Oops! I didn't know you had arrived already."
    lar "Opa! Eu não sabia que você já tinha chegado."

# game/scripts/c31/c31.rpy:4654
translate brazilian c31s007_surgery_293e4618:

    # mc "Good morning. I assume you're [lar]. I'm [mc]. Nice to meet you."
    mc "Bom dia. Presumo que você seja a [lar]. Eu sou o [mc]. Prazer em conhecê-la."

# game/scripts/c31/c31.rpy:4656
translate brazilian c31s007_surgery_230e9949:

    # lar "Good morning, Mr. Marks. Yes, I'm [lar], your assistant on Sundays and Mondays."
    lar "Bom dia, Sr. Marks. Sim, eu sou a [lar], sua assistente aos domingos e segundas-feiras."

# game/scripts/c31/c31.rpy:4657
translate brazilian c31s007_surgery_5f9e6b36:

    # mc "Nice to meet you, [lar]."
    mc "Prazer em conhecê-la, [lar]."

# game/scripts/c31/c31.rpy:4659
translate brazilian c31s007_surgery_f03da9f8:

    # lar "I've filed all the folders that [car] told me to. If you want to check them, they are in..."
    lar "Eu arquivei todas as pastas que a [car] me pediu. Se quiser verificá-las, elas estão em..."

# game/scripts/c31/c31.rpy:4660
translate brazilian c31s007_surgery_892040b7:

    # mc "No need. I saw that [car] sent me emails with the documentation. I doubt I'll need the folders."
    mc "Não precisa. Vi que a [car] me enviou e-mails com a documentação. Duvido que eu vá precisar das pastas."

# game/scripts/c31/c31.rpy:4661
translate brazilian c31s007_surgery_0f24195a:

    # lar "Perfect, sir."
    lar "Perfeito, senhor."

# game/scripts/c31/c31.rpy:4663
translate brazilian c31s007_surgery_70cc744a:

    # lar "If you need me, I'll be right outside."
    lar "Se precisar de mim, estarei lá fora."

# game/scripts/c31/c31.rpy:4664
translate brazilian c31s007_surgery_4e5b80f5:

    # mc "Thank you, [lar]."
    mc "Obrigado, [lar]."

# game/scripts/c31/c31.rpy:4667
translate brazilian c31s007_surgery_63f6a1b1:

    # "As the time for the surgery approaches..."
    "À medida que a hora da cirurgia se aproxima..."

# game/scripts/c31/c31.rpy:4668
translate brazilian c31s007_surgery_c5caecb7:

    # mc "[lar], I'm going to the medical facilities. If anything {b}urgent{/b} comes up, please let me know."
    mc "[lar], vou para as instalações médicas. Se surgir algo {b}urgente{/b}, por favor, me avise."

# game/scripts/c31/c31.rpy:4669
translate brazilian c31s007_surgery_54a5742e:

    # lar "I understand, Sir. Only what's truly urgent."
    lar "Entendido, Senhor. Apenas o que for realmente urgente."

# game/scripts/c31/c31.rpy:4670
translate brazilian c31s007_surgery_ac67d23a:

    # mc "Today, the urgent thing is [gav]'s surgery. The rest can wait unless the sky falls on our heads."
    mc "Hoje, o urgente é a cirurgia do [gav]. O resto pode esperar, a menos que o céu caia sobre nossas cabeças."

# game/scripts/c31/c31.rpy:4672
translate brazilian c31s007_surgery_306f80db:

    # "[aar] is already there, next to a G you haven't met."
    "[aar] já está lá, ao lado de um G que você ainda não conheceu."

# game/scripts/c31/c31.rpy:4673
translate brazilian c31s007_surgery_6f5648e0:

    # mc "Good morning, [aar]. Good morning..."
    mc "Bom dia, [aar]. Bom dia..."

# game/scripts/c31/c31.rpy:4674
translate brazilian c31s007_surgery_1fa85298:

    # gid "[gid], Sir. Good morning."
    gid "[gid], Senhor. Bom dia."

# game/scripts/c31/c31.rpy:4675
translate brazilian c31s007_surgery_816e2552:

    # aar "Good morning, [mc]."
    aar "Bom dia, [mc]."

# game/scripts/c31/c31.rpy:4676
translate brazilian c31s007_surgery_5434f45c:

    # mc "Is everything going according to plan?"
    mc "Está tudo correndo conforme o plano?"

# game/scripts/c31/c31.rpy:4678
translate brazilian c31s007_surgery_c43223f3:

    # aar "For now, yes. [bet] hasn't entered the operating room yet."
    aar "Por enquanto, sim. A [bet] ainda não entrou na sala de cirurgia."

# game/scripts/c31/c31.rpy:4679
translate brazilian c31s007_surgery_d8e3f095:

    # mc "I imagined it like in the TV shows."
    mc "Eu imaginei que seria como nos programas de TV."

# game/scripts/c31/c31.rpy:4680
translate brazilian c31s007_surgery_d3807f28:

    # mc "I thought we could watch the operation live, from a balcony or something like that."
    mc "Achei que poderíamos assistir à operação ao vivo, de uma varanda ou algo do tipo."

# game/scripts/c31/c31.rpy:4681
translate brazilian c31s007_surgery_72f81c55:

    # aar "We've never needed that kind of facility. That operating room is usually used to treat combat wounds."
    aar "Nós nunca precisamos desse tipo de instalação. Aquela sala de cirurgia geralmente é usada para tratar ferimentos de combate."

# game/scripts/c31/c31.rpy:4682
translate brazilian c31s007_surgery_d56b9c53:

    # mc "I get it."
    mc "Eu entendo."

# game/scripts/c31/c31.rpy:4683
translate brazilian c31s007_surgery_f5935eeb:

    # aar "One of [bet]'s assistants will bring us updates from time to time. If there's anything interesting to report."
    aar "Um dos assistentes da [bet] vai nos trazer atualizações de tempos em tempos. Se houver algo interessante para relatar."

# game/scripts/c31/c31.rpy:4684
translate brazilian c31s007_surgery_8f535801:

    # gid "If you'll excuse me, I'm going to take my leave. My shift starts in a few minutes."
    gid "Se me dão licença, eu vou me retirar. Meu turno começa em alguns minutos."

# game/scripts/c31/c31.rpy:4685
translate brazilian c31s007_surgery_c7e29479:

    # mc "Of course, [gid]." (multiple=2)
    mc "Claro, [gid]." (multiple=2)

# game/scripts/c31/c31.rpy:4686
translate brazilian c31s007_surgery_c62cdc45:

    # aar "Go ahead, [gid]." (multiple=2)
    aar "Vá em frente, [gid]." (multiple=2)

# game/scripts/c31/c31.rpy:4687
translate brazilian c31s007_surgery_4a4472e4:

    # "Neither of you knows who he was addressing. It doesn't matter."
    "Nenhum de vocês sabe a quem ele estava se dirigindo. Não importa."

# game/scripts/c31/c31.rpy:4689
translate brazilian c31s007_surgery_13e94e4b:

    # aar "How is [bet]?"
    aar "Como a [bet] está?"

# game/scripts/c31/c31.rpy:4690
translate brazilian c31s007_surgery_b3f642c9:

    # mc "Nervous. I guess that's what comes with performing a unique surgery."
    mc "Nervosa. Acho que é o que acontece quando se realiza uma cirurgia única."

# game/scripts/c31/c31.rpy:4691
translate brazilian c31s007_surgery_34a1e70a:

    # mc "I don't know if I could stay focused the entire time during a six-hour operation."
    mc "Não sei se eu conseguiria manter o foco o tempo todo durante uma operação de seis horas."

# game/scripts/c31/c31.rpy:4692
translate brazilian c31s007_surgery_b78f8095:

    # aar "Surgeons are cut from a different cloth. They know what a single slip-up can mean for their patients."
    aar "Cirurgiões são feitos de outra fibra. Eles sabem o que um único deslize pode significar para seus pacientes."

# game/scripts/c31/c31.rpy:4694
translate brazilian c31s007_surgery_2a327b37:

    # "To your surprise, [car] appears in the waiting room. She sits in a lone chair."
    "Para sua surpresa, [car] aparece na sala de espera. Ela se senta em uma cadeira isolada."

# game/scripts/c31/c31.rpy:4696
translate brazilian c31s007_surgery_bdeda2e4:

    # mc "[aar], I'm going to leave you for a moment. I want to talk to [car]."
    mc "[aar], vou te deixar por um momento. Quero falar com a [car]."

# game/scripts/c31/c31.rpy:4697
translate brazilian c31s007_surgery_244012f6:

    # aar "No problem."
    aar "Sem problema."

# game/scripts/c31/c31.rpy:4699
translate brazilian c31s007_surgery_9d268e96:

    # mc "Good morning, [car]. I didn't expect to see you here."
    mc "Bom dia, [car]. Não esperava ver você aqui."

# game/scripts/c31/c31.rpy:4700
translate brazilian c31s007_surgery_ef4f2a5e:

    # car "I've known [gav]... all these kids... since they were born."
    car "Eu conheço o [gav]... todas essas crianças... desde que nasceram."

# game/scripts/c31/c31.rpy:4701
translate brazilian c31s007_surgery_20dbf9c5:

    # car "I don't think I could stay home during the surgery without going crazy."
    car "Acho que não conseguiria ficar em casa durante a cirurgia sem enlouquecer."

# game/scripts/c31/c31.rpy:4702
translate brazilian c31s007_surgery_cf9e99c3:

    # car "I didn't expect to see you here either, Sir."
    car "Também não esperava ver o senhor aqui, Senhor."

# game/scripts/c31/c31.rpy:4703
translate brazilian c31s007_surgery_33778031:

    # mc "I told you I'd come today."
    mc "Eu te disse que viria hoje."

# game/scripts/c31/c31.rpy:4705
translate brazilian c31s007_surgery_55552d4e:

    # car "I know. But I thought you'd wait for the results in your office. Mr. Richards and Mr. Daniels..."
    car "Eu sei. Mas achei que o senhor esperaria pelos resultados no seu escritório. O Sr. Richards e o Sr. Daniels..."

# game/scripts/c31/c31.rpy:4706
translate brazilian c31s007_surgery_43265ac1:

    # mc "I'm neither Richards nor Daniels, [car]. Maybe my way of doing things isn't as efficient, but..."
    mc "Não sou o Richards nem o Daniels, [car]. Talvez o meu jeito de fazer as coisas não seja tão eficiente, mas..."

# game/scripts/c31/c31.rpy:4707
translate brazilian c31s007_surgery_90d11605:

    # mc "I care about [gav]'s surgery."
    mc "Eu me importo com a cirurgia do [gav]."

# game/scripts/c31/c31.rpy:4709
translate brazilian c31s007_surgery_4e81318d:

    # car "I already told you that you were different, Sir."
    car "Eu já te disse que você era diferente, Senhor."

# game/scripts/c31/c31.rpy:4710
translate brazilian c31s007_surgery_d04eb723:

    # mc "And I told you I took it as a compliment."
    mc "E eu te disse que encarei isso como um elogio."

# game/scripts/c31/c31.rpy:4711
translate brazilian c31s007_surgery_d9330084:

    # car "In this case, it is."
    car "Neste caso, é."

# game/scripts/c31/c31.rpy:4713
translate brazilian c31s007_surgery_7b9d0210:

    # "[ama] arrives along with [cal] a few minutes before the surgery starts."
    "[ama] chega junto com [cal] alguns minutos antes da cirurgia começar."

# game/scripts/c31/c31.rpy:4715
translate brazilian c31s007_surgery_e8de27bb:

    # "Time, rather than passing, crawls on the clocks the moment the operation begins."
    "O tempo, em vez de passar, se arrasta nos relógios no momento em que a operação começa."

# game/scripts/c31/c31.rpy:4716
translate brazilian c31s007_surgery_44e060b7:

    # "Conversations die down at the same rate."
    "As conversas morrem no mesmo ritmo."

# game/scripts/c31/c31.rpy:4718
translate brazilian c31s007_surgery_6933e30b:

    # "There is nothing to see in this room. And the door through which the assistant who is supposed to bring news should appear doesn't open."
    "Não há nada para ver nesta sala. E a porta por onde a assistente que deveria trazer notícias deveria aparecer não se abre."

# game/scripts/c31/c31.rpy:4720
translate brazilian c31s007_surgery_24355797:

    # "You take it as a good sign. You have blind faith in [bet] as a surgeon."
    "Você leva isso como um bom sinal. Você tem fé cega em [bet] como cirurgiã."

# game/scripts/c31/c31.rpy:4722
translate brazilian c31s007_surgery_d058b5bd:

    # "Some clones show up from time to time. They take a peek into the room before leaving again."
    "Alguns clones aparecem de vez em quando. Eles dão uma espiada na sala antes de sair novamente."

# game/scripts/c31/c31.rpy:4724
translate brazilian c31s007_surgery_18b70d76:

    # "Every time one of them shows up, you get the feeling you're being watched."
    "Toda vez que um deles aparece, você tem a sensação de estar sendo observado."

# game/scripts/c31/c31.rpy:4726
translate brazilian c31s007_surgery_fde3c3ac:

    # "As if they want to make sure the new CEO is in the room, worrying about how the surgery of one of their own is going."
    "Como se quisessem ter certeza de que o novo CEO está na sala, se preocupando com o andamento da cirurgia de uma das suas."

# game/scripts/c31/c31.rpy:4728
translate brazilian c31s007_surgery_a5f9d4a0:

    # "[mael] shows up towards the end of the operation. He is also interested in knowing how everything is going."
    "[mael] aparece perto do fim da operação. Ele também está interessado em saber como tudo está indo."

# game/scripts/c31/c31.rpy:4729
translate brazilian c31s007_surgery_2856c1b6:

    # "Although perhaps his reasons are different from yours."
    "Embora talvez os motivos dele sejam diferentes dos seus."

# game/scripts/c31/c31.rpy:4731
translate brazilian c31s007_surgery_8813668f:

    # "Six hours come and go. The damn assistant doesn't show up to give any explanation."
    "Seis horas vêm e vão. O maldito assistente não aparece para dar nenhuma explicação."

# game/scripts/c31/c31.rpy:4733
translate brazilian c31s007_surgery_6eef5cfb:

    # "As the seventh hour of the surgery approaches, the door you've all been staring at for an hour finally opens."
    "Conforme a sétima hora da cirurgia se aproxima, a porta para a qual todos vocês estão olhando há uma hora finalmente se abre."

# game/scripts/c31/c31.rpy:4734
translate brazilian c31s007_surgery_3d6be1e6:

    # ass "The operation was a success. Everything went as expected. The patient is under observation."
    ass "A operação foi um sucesso. Tudo ocorreu como o esperado. A paciente está sob observação."

# game/scripts/c31/c31.rpy:4736
translate brazilian c31s007_surgery_40ac48e0:

    # "You can see the emotions reflected on the faces of everyone present."
    "Você pode ver as emoções refletidas nos rostos de todos os presentes."

# game/scripts/c31/c31.rpy:4737
translate brazilian c31s007_surgery_662bdd9c:

    # "There is relief, joy, and even a calculating look or two."
    "Há alívio, alegria e até mesmo um ou dois olhares calculistas."

# game/scripts/c31/c31.rpy:4738
translate brazilian c31s007_surgery_eb37aced:

    # "There are even some inquisitive eyes studying your reaction."
    "Há até mesmo alguns olhos inquisitivos estudando a sua reação."

# game/scripts/c31/c31.rpy:4740
translate brazilian c31s007_surgery_7c16b76a:

    # "Everyone slowly leaves the room, leaving you alone with [ama]."
    "Todos saem lentamente da sala, deixando você sozinho com [ama]."

# game/scripts/c31/c31.rpy:4742
translate brazilian c31s007_surgery_cb167bc5:

    # ama "Are you going to stay here?"
    ama "Você vai ficar aqui?"

# game/scripts/c31/c31.rpy:4743
translate brazilian c31s007_surgery_4a0e9d80:

    # mc "Yes. I want to talk to Aunt [bet] and have her explain how everything went. I know I won't understand half of what she tells me, but..."
    mc "Vou. Quero falar com a Tia [bet] e pedir pra ela explicar como tudo foi. Eu sei que não vou entender metade do que ela me disser, mas..."

# game/scripts/c31/c31.rpy:4744
translate brazilian c31s007_surgery_682c1495:

    # ama "I understand. I have to go to my office for a moment, but I'll be back as soon as I can."
    ama "Eu entendo. Tenho que ir ao meu escritório por um momento, mas volto o mais rápido que puder."

# game/scripts/c31/c31.rpy:4745
translate brazilian c31s007_surgery_b44d7909:

    # mc "More interviews?"
    mc "Mais entrevistas?"

# game/scripts/c31/c31.rpy:4747
translate brazilian c31s007_surgery_b0f46c42:

    # ama "No. Nobody wanted to do an interview today. Everyone would be thinking about the surgery."
    ama "Não. Ninguém quis fazer entrevista hoje. Todo mundo estaria pensando na cirurgia."

# game/scripts/c31/c31.rpy:4748
translate brazilian c31s007_surgery_f25da4af:

    # ama "Most people like [gav]."
    ama "A maioria das pessoas gosta do [gav]."

# game/scripts/c31/c31.rpy:4749
translate brazilian c31s007_surgery_1d39dbd0:

    # ama "I just have to check the guard shift changes."
    ama "Só tenho que verificar as mudanças de turno dos guardas."

# game/scripts/c31/c31.rpy:4750
translate brazilian c31s007_surgery_1da6a712:

    # mc "I get it. See you later."
    mc "Entendi. Até mais."

# game/scripts/c31/c31.rpy:4752
translate brazilian c31s007_surgery_11598801:

    # "You're left alone in the waiting room. There's nothing to see and no new news."
    "Você fica sozinho na sala de espera. Não há nada para ver e nenhuma novidade."

# game/scripts/c31/c31.rpy:4753
translate brazilian c31s007_surgery_df85b949:

    # "Just waiting for Aunt [bet]. You spend a few minutes staring at the door."
    "Apenas esperando pela tia [bet]. Você passa alguns minutos encarando a porta."

# game/scripts/c31/c31.rpy:4756
translate brazilian c31s007_surgery_d45f3ced:

    # "She appears fifteen minutes later. Time has gone back to moving at its usual speed."
    "Ela aparece quinze minutos depois. O tempo voltou a passar na sua velocidade normal."

# game/scripts/c31/c31.rpy:4757
translate brazilian c31s007_surgery_2d81eaa5:

    # bet "I didn't expect anyone to still be here. I just came for a coffee."
    bet "Eu não esperava que alguém ainda estivesse aqui. Só vim pegar um café."

# game/scripts/c31/c31.rpy:4758
translate brazilian c31s007_surgery_be261e8b:

    # mc "Everything okay with the surgery?"
    mc "Tudo bem com a cirurgia?"

# game/scripts/c31/c31.rpy:4760
translate brazilian c31s007_surgery_c9b11614:

    # bet "Everything's perfect. Even better than perfect. The rest of the surgeons are very good at what they do."
    bet "Tudo está perfeito. Melhor que perfeito. O resto dos cirurgiões são muito bons no que fazem."

# game/scripts/c31/c31.rpy:4761
translate brazilian c31s007_surgery_f27c6efb:

    # bet "The kid is going to recover from the surgery sooner than I expected."
    bet "O garoto vai se recuperar da cirurgia mais rápido do que eu esperava."

# game/scripts/c31/c31.rpy:4762
translate brazilian c31s007_surgery_7762f78f:

    # mc "That's good. How did everything go? What's the next step?"
    mc "Isso é bom. Como foi tudo? Qual é o próximo passo?"

# game/scripts/c31/c31.rpy:4764
translate brazilian c31s007_surgery_12e96dec:

    # "She explains how the surgery went. As you imagined, you don't understand even a quarter of what she's explaining."
    "Ela explica como foi a cirurgia. Como você imaginou, você não entende nem um quarto do que ela está explicando."

# game/scripts/c31/c31.rpy:4765
translate brazilian c31s007_surgery_5569ce06:

    # bet "We'll keep [gav] under observation for a few days. We don't want the wound to get infected."
    bet "Vamos manter o [gav] em observação por alguns dias. Não queremos que a ferida infeccione."

# game/scripts/c31/c31.rpy:4766
translate brazilian c31s007_surgery_6ff9db01:

    # bet "With a little luck, we'll be able to turn on the arm in a week and see how he reacts."
    bet "Com um pouco de sorte, poderemos ligar o braço em uma semana e ver como ele reage."

# game/scripts/c31/c31.rpy:4767
translate brazilian c31s007_surgery_d3e1e5ee:

    # mc "Will I be able to be there when you do it?"
    mc "Vou poder estar lá quando vocês fizerem isso?"

# game/scripts/c31/c31.rpy:4769
translate brazilian c31s007_surgery_d68d4772:

    # bet "I hadn't thought about it, but I think it's a good idea for you to be there when we do it."
    bet "Eu não tinha pensado nisso, mas acho que é uma boa ideia você estar lá quando fizermos isso."

# game/scripts/c31/c31.rpy:4770
translate brazilian c31s007_surgery_2eddb174:

    # bet "The fact that you're the last one left here shows how much you care about this."
    bet "O fato de você ser o último a ficar aqui mostra o quanto você se importa com isso."

# game/scripts/c31/c31.rpy:4771
translate brazilian c31s007_surgery_fa39a046:

    # bet "Someone is probably talking about it right now around the base."
    bet "Alguém provavelmente está falando sobre isso agora mesmo pela base."

# game/scripts/c31/c31.rpy:4772
translate brazilian c31s007_surgery_43bd1d06:

    # mc "I don't really care about that right now."
    mc "Eu não tô nem aí pra isso agora."

# game/scripts/c31/c31.rpy:4773
translate brazilian c31s007_surgery_875b4e55:

    # mc "How are you doing?"
    mc "Como você está?"

# game/scripts/c31/c31.rpy:4775
translate brazilian c31s007_surgery_a860f15f:

    # bet "Exhausted. But very happy. There was a moment when I thought we wouldn't make it."
    bet "Exausta. Mas muito feliz. Teve um momento em que achei que não conseguiríamos."

# game/scripts/c31/c31.rpy:4776
translate brazilian c31s007_surgery_dae02f71:

    # bet "But everything turned out fine in the end."
    bet "Mas tudo deu certo no final."

# game/scripts/c31/c31.rpy:4777
translate brazilian c31s007_surgery_b77a74c6:

    # bet "Now I just want to take a shower. I can still feel the sweat running down my back."
    bet "Agora eu só quero tomar um banho. Ainda consigo sentir o suor escorrendo pelas minhas costas."

# game/scripts/c31/c31.rpy:4778
translate brazilian c31s007_surgery_b5bc5456:

    # mc "Then I won't keep you any longer. I'll see you later so we can go home."
    mc "Então não vou te segurar mais. Te vejo mais tarde para irmos para casa."

# game/scripts/c31/c31.rpy:4780
translate brazilian c31s007_surgery_3a86df9c:

    # bet "I'm not going home. I want to stay here for the night in case there are any complications."
    bet "Eu não vou para casa. Quero passar a noite aqui caso haja alguma complicação."

# game/scripts/c31/c31.rpy:4781
translate brazilian c31s007_surgery_9ff6f9b6:

    # mc "But you're exhausted..."
    mc "Mas você está exausta..."

# game/scripts/c31/c31.rpy:4782
translate brazilian c31s007_surgery_d99a2dda:

    # bet "The rest of the surgeons are just as exhausted as I am. But it's my surgery."
    bet "O resto dos cirurgiões está tão exausto quanto eu. Mas a cirurgia é minha."

# game/scripts/c31/c31.rpy:4784
translate brazilian c31s007_surgery_59c27817:

    # mc "Thanks for everything, Aunt [bet]."
    mc "Obrigado por tudo, tia [bet]."

# game/scripts/c31/c31.rpy:4785
translate brazilian c31s007_surgery_dafd98c2:

    # bet "Thank you for giving me the chance to help the boy."
    bet "Obrigada por me dar a chance de ajudar o garoto."

# game/scripts/c31/c31.rpy:4787
translate brazilian c31s007_surgery_5eedca3f:

    # "You go back to your office and give the news to [lar]. Obviously, she already knew."
    "Você volta para o seu escritório e dá a notícia para a [lar]. Obviamente, ela já sabia."

# game/scripts/c31/c31.rpy:4789
translate brazilian c31s007_surgery_cb4e7a9f:

    # "You sit behind your desk and stare at the walls for a while."
    "Você senta atrás da sua mesa e encara as paredes por um tempo."

# game/scripts/c31/c31.rpy:4790
translate brazilian c31s007_surgery_a849c7e5:

    # "Now the waiting game begins."
    "Agora começa o jogo de espera."

# game/scripts/c31/c31.rpy:4795
translate brazilian c31s007_ama_5e64d07e:

    # "After about 40 minutes..."
    "Depois de uns 40 minutos..."

# game/scripts/c31/c31.rpy:4796
translate brazilian c31s007_ama_56411a58:

    # ama "I just talked to Aunt [bet]. She explained everything about the surgery."
    ama "Acabei de falar com a tia [bet]. Ela explicou tudo sobre a cirurgia."

# game/scripts/c31/c31.rpy:4797
translate brazilian c31s007_ama_3df02708:

    # ama "It's great that everything went so well."
    ama "É ótimo que tudo tenha corrido tão bem."

# game/scripts/c31/c31.rpy:4798
translate brazilian c31s007_ama_6580b0cb:

    # mc "Absolutely. [gav] deserves it, and [eva] doesn't deserve to carry that guilt."
    mc "Com certeza. O [gav] merece, e a [eva] não merece carregar essa culpa."

# game/scripts/c31/c31.rpy:4799
translate brazilian c31s007_ama_29adea49:

    # ama "[eva] is going to be very happy."
    ama "A [eva] vai ficar muito feliz."

# game/scripts/c31/c31.rpy:4802
translate brazilian c31s007_ama_d527c7c8:

    # ama "Aunt [bet] told me she's going to spend the night at the medical facilities..."
    ama "A tia [bet] me disse que vai passar a noite nas instalações médicas..."

# game/scripts/c31/c31.rpy:4803
translate brazilian c31s007_ama_5f57d6d8:

    # ama "Do you want to go out for dinner in Oranjestad? You haven't had the chance to visit it yet..."
    ama "Você quer sair pra jantar em Oranjestad? Você ainda não teve a chance de visitar lá..."

# game/scripts/c31/c31.rpy:4804
translate brazilian c31s007_ama_b68ffdd9:

    # mc "I'd love to. And if it's not in the city, I don't care if it's on the beach, as long as it's with you."
    mc "Eu adoraria. E se não for na cidade, não me importo se for na praia, desde que seja com você."

# game/scripts/c31/c31.rpy:4806
translate brazilian c31s007_ama_b28bb679:

    # ama "Great! Tell [aar] to take you home. I'm leaving now. I have some things to do!"
    ama "Ótimo! Diga pro [aar] te levar pra casa. Tô saindo agora. Tenho umas coisas pra fazer!"


# game/scripts/c31/c31.rpy:4808
translate brazilian c31s007_ama_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c31/c31.rpy:4809
translate brazilian c31s007_ama_ecc08f69:

    # mcp "(I'll take that as this is going to be our first real date.)"
    mcp "(Vou entender isso como se fosse o nosso primeiro encontro de verdade.)"

# game/scripts/c31/c31.rpy:4810
translate brazilian c31s007_ama_ba089e8c:

    # ama "*Through the door* [lar], do you know if there's an iron at the CEO's house?"
    ama "*Através da porta* [lar], você sabe se tem um ferro de passar na casa do CEO?"

# game/scripts/c31/c31.rpy:4812
translate brazilian c31s007_ama_d6744449:

    # "Upon arriving home..."
    "Ao chegar em casa..."

# game/scripts/c31/c31.rpy:4813
translate brazilian c31s007_ama_814504cd:

    # mc "[ama]?"
    mc "[ama]?"

# game/scripts/c31/c31.rpy:4814
translate brazilian c31s007_ama_7395eff6:

    # ama "*From downstairs* I'm just finishing getting ready. Go take a shower if you want."
    ama "*Lá de baixo* Só estou terminando de me arrumar. Vai tomar um banho se quiser."

# game/scripts/c31/c31.rpy:4816
translate brazilian c31s007_ama_df6011ca:

    # "After your shower, you go back to the kitchen and still find it empty."
    "Depois do banho, você volta para a cozinha e ainda a encontra vazia."

# game/scripts/c31/c31.rpy:4817
translate brazilian c31s007_ama_1d47d51e:

    # "So empty that there's no catering today. You assume [ama] told [lar]."
    "Tão vazia que não tem buffet hoje. Você presume que [ama] avisou a [lar]."

# game/scripts/c31/c31.rpy:4818
translate brazilian c31s007_ama_814504cd_1:

    # mc "[ama]?"
    mc "[ama]?"

# game/scripts/c31/c31.rpy:4819
translate brazilian c31s007_ama_518ce32b:

    # ama "I'm on the terrace."
    ama "Estou no terraço."

# game/scripts/c31/c31.rpy:4825
translate brazilian c31s007_ama_89600869:

    # ama "We can leave whenever you want. You are the one driving today."
