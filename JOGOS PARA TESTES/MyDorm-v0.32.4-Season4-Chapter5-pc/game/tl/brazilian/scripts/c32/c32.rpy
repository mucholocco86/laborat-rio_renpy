# game/scripts/c32/c32.rpy:4397
translate brazilian c32s006_AmaSecTeam_65a1f1df:

    # "It's time for the plane to leave."
    "É hora do avião partir."

# game/scripts/c32/c32.rpy:4399
translate brazilian c32s006_AmaSecTeam_86ded6ed:

    # mc "Get going, or you won't make your flight plan."
    mc "Vão logo, ou não vão conseguir cumprir o plano de voo."

# game/scripts/c32/c32.rpy:4400
translate brazilian c32s006_AmaSecTeam_7882f242:

    # mc "I love you."
    mc "Eu te amo."

# game/scripts/c32/c32.rpy:4401
translate brazilian c32s006_AmaSecTeam_3e867ae5:

    # mom "I love you too."
    mom "Eu também te amo."

# game/scripts/c32/c32.rpy:4403
translate brazilian c32s006_AmaSecTeam_b98ae025:

    # "When the plane closes its door and retracts the stairs, it's as if the island lost some of its shine."
    "Quando o avião fecha a porta e recolhe as escadas, é como se a ilha perdesse um pouco do seu brilho."

# game/scripts/c32/c32.rpy:4404
translate brazilian c32s006_AmaSecTeam_7f38e20d:

    # bet "It's only been two days, but it made me realize how much I miss everyone."
    bet "Faz só dois dias, mas me fez perceber o quanto sinto falta de todo mundo."

# game/scripts/c32/c32.rpy:4405
translate brazilian c32s006_AmaSecTeam_8d5273cf:

    # ama "I was just thinking that I'm looking forward to [eva] coming back. Not just to see her, but to go back home for a while."
    ama "Eu estava justamente pensando que estou ansiosa para a [eva] voltar. Não só para vê-la, mas para voltar para casa por um tempo."

# game/scripts/c32/c32.rpy:4406
translate brazilian c32s006_AmaSecTeam_65099634:

    # mc "I think even [aar] is going to miss them."
    mc "Acho que até o [aar] vai sentir falta delas."

# game/scripts/c32/c32.rpy:4407
translate brazilian c32s006_AmaSecTeam_d0b076f7:

    # aar "They are very... nice."
    aar "Elas são muito... legais."
# game/scripts/c32/c32.rpy:4408
translate brazilian c32s006_AmaSecTeam_ef3fcfbe:

    # mc "*Laugh* I think we'll have to give you their share of hugs ourselves."
    mc "*Risos* Acho que teremos que te dar a parte deles dos abraços nós mesmos."

# game/scripts/c32/c32.rpy:4409
translate brazilian c32s006_AmaSecTeam_74a7d883:

    # bet "*Laugh* And I think if we do, [aar] will ask for a transfer to some obscure base in Antarctica."
    bet "*Risos* E eu acho que se fizermos isso, o [aar] vai pedir transferência para alguma base obscura na Antártica."

# game/scripts/c32/c32.rpy:4411
translate brazilian c32s006_AmaSecTeam_a184399d:

    # ama "*Laugh* We don't have bases in Antarctica, but [aar] will get used to hugs before you leave, Aunt [bet]."
    ama "*Risos* Nós não temos bases na Antártica, mas o [aar] vai se acostumar com abraços antes de você ir embora, Tia [bet]."

# game/scripts/c32/c32.rpy:4412
translate brazilian c32s006_AmaSecTeam_99ad5ef5:

    # aar "Can you drop the hug thing already?"
    aar "Dá pra vocês esquecerem essa história de abraço logo?"

# game/scripts/c32/c32.rpy:4413
translate brazilian c32s006_AmaSecTeam_ba637e21:

    # mc "Only if you come over for dinner. [mar]'s orders."
    mc "Só se você vier jantar em casa. Ordens da [mar]."

# game/scripts/c32/c32.rpy:4414
translate brazilian c32s006_AmaSecTeam_95df4376:

    # aar "Deal."
    aar "Fechado."

# game/scripts/c32/c32.rpy:4415
translate brazilian c32s006_AmaSecTeam_b98328a6:

    # ama "*Laugh* Then we'll save the hugs for after dinner."
    ama "*Risos* Então vamos guardar os abraços para depois do jantar."

# game/scripts/c32/c32.rpy:4416
translate brazilian c32s006_AmaSecTeam_0d524ac6:

    # aar "*Grunt*"
    aar "*Grunhido*"

# game/scripts/c32/c32.rpy:4417
translate brazilian c32s006_AmaSecTeam_b3b94564:

    # todas "*Laugh*"
    todas "*Risos*"

# game/scripts/c32/c32.rpy:4421
translate brazilian c32s006_Hailey_6bd107c2:

    # centered "{size=+20}{b}DAY 64 – TUESDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 64 – TERÇA-FEIRA{/b}{/size}"

# game/scripts/c32/c32.rpy:4422
translate brazilian c32s006_Hailey_0b813ea9:

    # "The days continue with the usual routine, now including dinners with [aar]."
    "Os dias continuam com a rotina de sempre, agora incluindo jantares com o [aar]."
# game/scripts/c32/c32.rpy:4424
translate brazilian c32s006_Hailey_14b8fb1e:

    # "Video calls back home also continue. After [sam] and [mar]'s visit, you miss the girls at home even more."
    "As videochamadas para casa também continuam. Depois da visita da [sam] e da [mar], você sente ainda mais falta das garotas em casa."

# game/scripts/c32/c32.rpy:4425
translate brazilian c32s006_Hailey_5986051d:

    # mc "So the first student has already arrived? What's she like?"
    mc "Então a primeira aluna já chegou? Como ela é?"

# game/scripts/c32/c32.rpy:4426
translate brazilian c32s006_Hailey_7c9f657a:

    # dap "*Laugh* Gorgeous."
    dap "*Risos* Maravilhosa."

# game/scripts/c32/c32.rpy:4427
translate brazilian c32s006_Hailey_059241e7:

    # mc "*Laugh* I didn't mean that, I meant personality-wise."
    mc "*Risos* Não quis dizer isso, quis dizer em termos de personalidade."

# game/scripts/c32/c32.rpy:4429
translate brazilian c32s006_Hailey_8928953d:

    # dap "I don't know yet. It's too early for that."
    dap "Ainda não sei. É muito cedo para isso."

# game/scripts/c32/c32.rpy:4430
translate brazilian c32s006_Hailey_f9a50126:

    # dap "But there have already been a couple of funny anecdotes."
    dap "Mas já teve algumas histórias engraçadas."

# game/scripts/c32/c32.rpy:4431
translate brazilian c32s006_Hailey_fd0578ac:

    # mc "For example..."
    mc "Por exemplo..."

# game/scripts/c32/c32.rpy:4433
translate brazilian c32s006_Hailey_3b2d1dc1:

    # dap "The first one was when we were driving through SLO and she says..."
    dap "A primeira foi quando estávamos dirigindo por SLO e ela diz..."

# game/scripts/c32/c32.rpy:4436
translate brazilian c32s006_Hailey_2fd0409a:

    # hai "There are more people in this city than in my entire county..."
    hai "Tem mais gente nessa cidade do que no meu condado inteiro..."

# game/scripts/c32/c32.rpy:4437
translate brazilian c32s006_Hailey_4db2fcf4:

    # hai "My brother says I'm going to miss the horses, and I think he's right."
    hai "Meu irmão diz que vou sentir falta dos cavalos, e acho que ele tem razão."

# game/scripts/c32/c32.rpy:4439
translate brazilian c32s006_Hailey_006d9bfc:

    # mc "This is the girl from Alabama, right? If she lives in the country, the lifestyle change can be overwhelming."
    mc "Essa é a garota do Alabama, né? Se ela mora no interior, a mudança de estilo de vida pode ser avassaladora."
# game/scripts/c32/c32.rpy:4440
translate brazilian c32s006_Hailey_3e47d165:

    # dap "Yeah, but that's not what I found funny. I was thinking about whether my mother would let her keep a horse in the yard."
    dap "É, mas não foi isso que eu achei engraçado. Eu estava pensando se a minha mãe deixaria ela manter um cavalo no quintal."

# game/scripts/c32/c32.rpy:4441
translate brazilian c32s006_Hailey_b23ab8a7:

    # dap "The answer, obviously, is no, but that led to the really funny part."
    dap "A resposta, obviamente, é não, mas isso levou à parte realmente engraçada."

# game/scripts/c32/c32.rpy:4442
translate brazilian c32s006_Hailey_29714f61:

    # mc "What happened?"
    mc "O que aconteceu?"

# game/scripts/c32/c32.rpy:4444
translate brazilian c32s006_Hailey_ffab185b:

    # dap "When we got to Newport, we took her to [mad.nick]'s store to buy a swimsuit."
    dap "Quando chegamos a Newport, nós a levamos na loja da [mad.nick] para comprar uma roupa de banho."

# game/scripts/c32/c32.rpy:4445
translate brazilian c32s006_Hailey_e6fa8c53:

    # mc "*Laugh* Are you already introducing her to the whole family?"
    mc "*Risos* Você já está apresentando ela para a família toda?"

# game/scripts/c32/c32.rpy:4447
translate brazilian c32s006_Hailey_821d6e86:

    # dap "Not yet, but a girl needs to know where to buy clothes in a new city."
    dap "Ainda não, mas uma garota precisa saber onde comprar roupas numa cidade nova."

# game/scripts/c32/c32.rpy:4448
translate brazilian c32s006_Hailey_4ceccdba:

    # dap "When they all arrive, we'll have a welcome lunch so they can meet everyone."
    dap "Quando todos chegarem, vamos fazer um almoço de boas-vindas para que possam conhecer todo mundo."

# game/scripts/c32/c32.rpy:4449
translate brazilian c32s006_Hailey_0527783e:

    # mc "I think that's a good idea. [ama] is still worried about how they're going to fit into the family."
    mc "Acho que é uma boa ideia. A [ama] ainda está preocupada em como elas vão se encaixar na família."

# game/scripts/c32/c32.rpy:4450
translate brazilian c32s006_Hailey_250cb9db:

    # mc "But I don't see anything funny about going to buy a swimsuit..."
    mc "Mas eu não vejo nada de engraçado em ir comprar uma roupa de banho..."

# game/scripts/c32/c32.rpy:4452
translate brazilian c32s006_Hailey_cea486d0:

    # dap "*Laugh* Men...!"
    dap "*Risos* Homens...!"

# game/scripts/c32/c32.rpy:4453
translate brazilian c32s006_Hailey_db1d11ea:

    # dap "The funny part is... Wait. I'll send you a video."
    dap "A parte engraçada é... Espera. Vou te mandar um vídeo."
# game/scripts/c32/c32.rpy:4456
translate brazilian c32s006_Hailey_07543468:

    # mc "*Laugh* Reminds me of that old 90s movie with the girl on the coin-operated horse."
    mc "*Risos* Me lembra daquele filme antigo dos anos 90 com a garota no cavalinho de ficha."

# game/scripts/c32/c32.rpy:4457
translate brazilian c32s006_Hailey_27729f5e:

    # dap "That's what I thought was funny. The way she was dressed and saying she was going to miss the horses..."
    dap "Foi isso que eu achei engraçado. O jeito que ela estava vestida e dizendo que ia sentir falta dos cavalos..."

# game/scripts/c32/c32.rpy:4458
translate brazilian c32s006_Hailey_e2e32ab4:

    # dap "As soon as she saw it, she told me..."
    dap "Assim que ela viu, ela me disse..."

# game/scripts/c32/c32.rpy:4460
translate brazilian c32s006_Hailey_c776defd:

    # hai "Let me get on that horse to send a picture to my brother."
    hai "Deixa eu subir nesse cavalo pra mandar uma foto pro meu irmão."

# game/scripts/c32/c32.rpy:4463
translate brazilian c32s006_Hailey_794e2919:

    # dap "And I convinced her to take a video instead of a picture."
    dap "E eu a convenci a gravar um vídeo em vez de tirar uma foto."

# game/scripts/c32/c32.rpy:4464
translate brazilian c32s006_Hailey_6f79ef42:

    # dap "She was making faces, like she was going full speed on the horse, but in slow motion. I don't know if I'm making sense."
    dap "Ela tava fazendo umas caretas, como se estivesse a toda velocidade no cavalo, mas em câmera lenta. Não sei se faz sentido."

# game/scripts/c32/c32.rpy:4465
translate brazilian c32s006_Hailey_66b8ad26:

    # mc "She seems like a fun girl. And the horse is beat up. I didn't remember it like that."
    mc "Ela parece ser uma garota divertida. E o cavalo tá bem surrado. Eu não lembrava dele assim."

# game/scripts/c32/c32.rpy:4466
translate brazilian c32s006_Hailey_2115b405:

    # dap "I think it needs a coat of paint."
    dap "Acho que precisa de uma mão de tinta."

# game/scripts/c32/c32.rpy:4468
translate brazilian c32s006_Hailey_31fdfbc4:

    # dap "But there's something about her you're not going to like..."
    dap "Mas tem uma coisa sobre ela que você não vai gostar..."

# game/scripts/c32/c32.rpy:4469
translate brazilian c32s006_Hailey_19c6b5c7:

    # mc "Do you think she could be trouble?"
    mc "Você acha que ela pode ser problema?"

# game/scripts/c32/c32.rpy:4471
translate brazilian c32s006_Hailey_b153d119:

    # dap "*Laugh* No, nothing like that, but..."
    dap "*Risos* Não, nada disso, mas..."
# game/scripts/c32/c32.rpy:4472
translate brazilian c32s006_Hailey_1165d191:

    # dap "*Laugh* [emm] convinced her to make the swimsuit she was buying... pink..."
    dap "*Risos* A [emm] convenceu ela a pegar o maiô que estava comprando... rosa..."

# game/scripts/c32/c32.rpy:4473
translate brazilian c32s006_Hailey_37b59b4c:

    # mc "*Laugh* Another woman in pink in the house! Noooo!"
    mc "*Risos* Mais uma mulher de rosa na casa! Nãããão!"

# game/scripts/c32/c32.rpy:4475
translate brazilian c32s006_Hailey_bc8f983b:

    # dap "I think she gave in because of [emm]'s pressure. She didn't seem very convinced about the color."
    dap "Acho que ela cedeu por causa da pressão da [emm]. Ela não parecia muito convencida com a cor."

# game/scripts/c32/c32.rpy:4476
translate brazilian c32s006_Hailey_c349a8fd:

    # dap "You know [emm], and how persistent she can be."
    dap "Você conhece a [emm], e sabe o quanto ela pode ser insistente."

# game/scripts/c32/c32.rpy:4477
translate brazilian c32s006_Hailey_fbbb24ad:

    # mc "*Laugh* We'll have to let [hai] spend time with your sister to counteract [emm]'s influence."
    mc "*Risos* Vamos ter que deixar a [hai] passar um tempo com a sua irmã pra neutralizar a influência da [emm]."

# game/scripts/c32/c32.rpy:4479
translate brazilian c32s006_Hailey_219173ed:

    # dap "*Laugh* Well, for now, they've appointed [emm] and me as the welcoming committee."
    dap "*Risos* Bom, por enquanto, nomearam a [emm] e eu como o comitê de boas-vindas."

# game/scripts/c32/c32.rpy:4480
translate brazilian c32s006_Hailey_96e71156:

    # dap "I think it's because [emm] won't leave your truck alone and because I can control her if she does anything too crazy."
    dap "Acho que é porque a [emm] não sai de perto da sua caminhonete e porque eu consigo controlar ela se ela fizer alguma loucura."

# game/scripts/c32/c32.rpy:4481
translate brazilian c32s006_Hailey_7c49f364:

    # dap "With [eri] and [sca] working, there weren't many options left."
    dap "Com a [eri] e a [sca] trabalhando, não sobraram muitas opções."

# game/scripts/c32/c32.rpy:4482
translate brazilian c32s006_Hailey_9e782ae4:

    # mc "You guys have changed in the last few months! Do you remember how it was when I arrived?"
    mc "Vocês mudaram muito nos últimos meses! Lembra como era quando eu cheguei?"

# game/scripts/c32/c32.rpy:4483
translate brazilian c32s006_Hailey_111a8cd4:

    # mc "You two were constantly pushing each other's buttons."
    mc "Vocês duas viviam se provocando o tempo todo."

# game/scripts/c32/c32.rpy:4485
translate brazilian c32s006_Hailey_3deccfe6:

    # dap "Well, everything has changed a lot in the last few months. I think we're both more mature now."
    dap "Bom, tudo mudou muito nos últimos meses. Acho que nós duas estamos mais maduras agora."
# game/scripts/c32/c32.rpy:4486
translate brazilian c32s006_Hailey_4abcf97d:

    # dap "And, speaking of maturity, I'm going to leave you and help [hai] unpack."
    dap "E, falando em maturidade, vou deixar você e ajudar a [hai] a desfazer as malas."

# game/scripts/c32/c32.rpy:4487
translate brazilian c32s006_Hailey_bb9513cf:

    # dap "We arrived just in time for the afternoon yoga session and she decided to join. I guess she must be done showering by now."
    dap "Chegamos bem a tempo para a sessão de yoga da tarde e ela decidiu participar. Acho que ela já deve ter terminado o banho a essa altura."

# game/scripts/c32/c32.rpy:4488
translate brazilian c32s006_Hailey_5dd1f6e9:

    # mc "You guys do yoga in the afternoon too?"
    mc "Vocês fazem yoga de tarde também?"

# game/scripts/c32/c32.rpy:4490
translate brazilian c32s006_Hailey_40529c7e:

    # dap "With so many people and so many different schedules, we decided to do two sessions."
    dap "Com tanta gente e tantos horários diferentes, decidimos fazer duas sessões."

# game/scripts/c32/c32.rpy:4491
translate brazilian c32s006_Hailey_6315c2d9:

    # dap "That way, the girls who can't make it to the morning session can join in the afternoon."
    dap "Assim, as garotas que não conseguem ir na sessão da manhã podem participar à tarde."

# game/scripts/c32/c32.rpy:4492
translate brazilian c32s006_Hailey_48095fe2:

    # mc "I guess that makes sense."
    mc "Acho que faz sentido."

# game/scripts/c32/c32.rpy:4494
translate brazilian c32s006_Hailey_5a00f793:

    # dap "I'm off. See you tomorrow. Love you."
    dap "Tô indo. Te vejo amanhã. Te amo."

# game/scripts/c32/c32.rpy:4495
translate brazilian c32s006_Hailey_6616e794:

    # mc "Love you too."
    mc "Também te amo."

# game/scripts/c32/c32.rpy:4499
translate brazilian c32s006_Gav_81b66a7e:

    # centered "{size=+20}{b}DAY 66 – THURSDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 66 – QUINTA-FEIRA{/b}{/size}"

# game/scripts/c32/c32.rpy:4500
translate brazilian c32s006_Gav_7dda0259:

    # "*Ring-Ring*"
    "*Trim-Trim*"

# game/scripts/c32/c32.rpy:4502
translate brazilian c32s006_Gav_e61bf0ac:

    # mc "Hey, [ama]. Are you going to take much longer to pick me up? We're going to be late."
    mc "Ei, [ama]. Você vai demorar muito pra me buscar? A gente vai se atrasar."
# game/scripts/c32/c32.rpy:4504
translate brazilian c32s006_Gav_343eeb9b:

    # ama "Don't you remember I told you I'd be here all morning?"
    ama "Você não lembra que eu te disse que estaria aqui a manhã toda?"

# game/scripts/c32/c32.rpy:4505
translate brazilian c32s006_Gav_f977818d:

    # ama "You have to come on your own. I'm not going to be your chauffeur today."
    ama "Você tem que vir por conta própria. Não vou ser sua motorista hoje."

# game/scripts/c32/c32.rpy:4506
translate brazilian c32s006_Gav_d700bf3a:

    # mc "I forgot. I'll grab a car now and head over there."
    mc "Eu esqueci. Vou pegar um carro agora e ir pra aí."

# game/scripts/c32/c32.rpy:4507
translate brazilian c32s006_Gav_e6c4b65b:

    # mc "Go ahead and start without me."
    mc "Pode ir começando sem mim."

# game/scripts/c32/c32.rpy:4509
translate brazilian c32s006_Gav_bd2a410d:

    # ama "You should be here..."
    ama "Você deveria estar aqui..."

# game/scripts/c32/c32.rpy:4510
translate brazilian c32s006_Gav_c53d5136:

    # mc "I know, but I don't want to delay it any longer. Everyone must be very anxious."
    mc "Eu sei, mas não quero atrasar mais. Todo mundo deve estar bem ansioso."

# game/scripts/c32/c32.rpy:4511
translate brazilian c32s006_Gav_1e600698:

    # ama "Yes, especially [gav]."
    ama "Sim, especialmente [gav]."

# game/scripts/c32/c32.rpy:4512
translate brazilian c32s006_Gav_bff6628d:

    # mc "That's why you should start without me. It was my mistake. I'll be there in fifteen minutes."
    mc "É por isso que vocês deveriam começar sem mim. Foi erro meu. Chego aí em quinze minutos."

# game/scripts/c32/c32.rpy:4514
translate brazilian c32s006_Gav_1bc6f0ed:

    # "When you arrive at the camp, [gav] is demonstrating the use of his arm."
    "Quando você chega ao acampamento, [gav] está demonstrando o uso do seu braço."

# game/scripts/c32/c32.rpy:4515
translate brazilian c32s006_Gav_96b6372a:

    # "Today is the day the power has been set to maximum for the first time."
    "Hoje é o dia em que a potência foi ajustada para o máximo pela primeira vez."

# game/scripts/c32/c32.rpy:4516
translate brazilian c32s006_Gav_e1e5ade6:

    # "An area has been cleared where he can do the planned exercises and the operatives can observe him."
    "Uma área foi liberada onde ele pode fazer os exercícios planejados e os agentes podem observá-lo."
# game/scripts/c32/c32.rpy:4518
translate brazilian c32s006_Gav_8deb53c4:

    # "Movement coordination and object handling seem to be going well under [cal]'s watchful eye."
    "A coordenação de movimentos e o manuseio de objetos parecem estar indo bem sob o olhar atento de [cal]."

# game/scripts/c32/c32.rpy:4519
translate brazilian c32s006_Gav_3aaa7291:

    # "You decide to keep a safe distance, blending in with the clones who are watching the tests in silence."
    "Você decide manter uma distância segura, misturando-se com os clones que assistem aos testes em silêncio."

# game/scripts/c32/c32.rpy:4520
translate brazilian c32s006_Gav_b2e23ffc:

    # "Not just to hide the fact that you're late, but because today [gav] should be the star of the show."
    "Não apenas para esconder o fato de que você está atrasado, mas porque hoje [gav] deve ser a estrela do show."

# game/scripts/c32/c32.rpy:4521
translate brazilian c32s006_Gav_7129abe1:

    # "Some see you arrive and make room for you. Others don't even notice your presence."
    "Alguns veem você chegar e abrem espaço para você. Outros nem notam sua presença."

# game/scripts/c32/c32.rpy:4522
translate brazilian c32s006_Gav_a309f127:

    # "They only have eyes for their comrade. Almost everyone likes [gav]."
    "Eles só têm olhos para o seu camarada. Quase todo mundo gosta de [gav]."

# game/scripts/c32/c32.rpy:4524
translate brazilian c32s006_Gav_7e24f04c:

    # "The strength exercises also yield the expected results."
    "Os exercícios de força também dão os resultados esperados."

# game/scripts/c32/c32.rpy:4525
translate brazilian c32s006_Gav_dcae3a18:

    # "[gav] was especially anxious about this exercise since he couldn't complete it three days ago."
    "[gav] estava especialmente ansioso com esse exercício, já que não conseguiu completá-lo três dias atrás."

# game/scripts/c32/c32.rpy:4526
translate brazilian c32s006_Gav_7882fe19:

    # "The new adjustments [cal] introduced seem to be working better than expected."
    "Os novos ajustes que [cal] introduziu parecem estar funcionando melhor do que o esperado."

# game/scripts/c32/c32.rpy:4528
translate brazilian c32s006_Gav_531877ea:

    # "When the planned series of exercises finishes, [gav] does an exercise that wasn't in the plan."
    "Quando a série planejada de exercícios termina, [gav] faz um exercício que não estava no plano."

# game/scripts/c32/c32.rpy:4529
translate brazilian c32s006_Gav_5cdbc14c:

    # "The boy wants to test the arm beyond what [cal], always conservative, is willing to add to the exercise plan."
    "O garoto quer testar o braço além do que [cal], sempre conservador, está disposto a adicionar ao plano de exercícios."

# game/scripts/c32/c32.rpy:4530
translate brazilian c32s006_Gav_53296186:

    # "It's a success, and you can hear murmurs of surprise among the clones around you."
    "É um sucesso, e você pode ouvir murmúrios de surpresa entre os clones ao seu redor."

# game/scripts/c32/c32.rpy:4532
translate brazilian c32s006_Gav_0fdb0d19:

    # "When the series of exercises finally ends, the clones disperse and you approach [cal] and [gav]."
    "Quando a série de exercícios finalmente termina, os clones se dispersam e você se aproxima de [cal] e [gav]."

# game/scripts/c32/c32.rpy:4533
translate brazilian c32s006_Gav_66735849:

    # "You see that [bet], [ama], and [aar] are also approaching from various points of the camp."
    "Você vê que [bet], [ama] e [aar] também estão se aproximando de vários pontos do acampamento."

# game/scripts/c32/c32.rpy:4536
translate brazilian c32s006_Gav_0ffc38e0:

    # mc "Congratulations, [gav]. It looks like everything went well, from what I could see."
    mc "Parabéns, [gav]. Parece que tudo correu bem, pelo que pude ver."

# game/scripts/c32/c32.rpy:4537
translate brazilian c32s006_Gav_b503bb9c:

    # gav "Thanks, [mc]. [cal] says there are still some parameters to adjust, but the performance is better than expected."
    gav "Valeu, [mc]. [cal] disse que ainda tem alguns parâmetros pra ajustar, mas o desempenho foi melhor que o esperado."

# game/scripts/c32/c32.rpy:4538
translate brazilian c32s006_Gav_5ba2afdf:

    # mc "That's great, [gav]. Does that mean you'll be able to return to active duty soon?"
    mc "Isso é ótimo, [gav]. Isso significa que você vai poder voltar à ativa em breve?"

# game/scripts/c32/c32.rpy:4540
translate brazilian c32s006_Gav_9e0510a3:

    # cal "Not so fast, [mc]. I think he's got at least a week left."
    cal "Não tão rápido, [mc]. Acho que ele ainda tem pelo menos uma semana."

# game/scripts/c32/c32.rpy:4541
translate brazilian c32s006_Gav_a9af48a8:

    # mc "A week? I was wondering if he'd be ready to go back to Newport with [eva] when she leaves in over a month!"
    mc "Uma semana? Eu tava me perguntando se ele estaria pronto pra voltar pra Newport com a [eva] quando ela for embora daqui a mais de um mês!"

# game/scripts/c32/c32.rpy:4543
translate brazilian c32s006_Gav_b6d2b6d3:

    # cal "I'm sorry. I thought..."
    cal "Desculpe. Eu achei que..."

# game/scripts/c32/c32.rpy:4544
translate brazilian c32s006_Gav_fda42358:

    # mc "No one is going back to active duty before they're ready, [cal]."
    mc "Ninguém vai voltar à ativa antes de estar pronto, [cal]."

# game/scripts/c32/c32.rpy:4545
translate brazilian c32s006_Gav_173110f1:

    # mc "But... A week? That's fantastic!"
    mc "Mas... Uma semana? Isso é fantástico!"

# game/scripts/c32/c32.rpy:4547
translate brazilian c32s006_Gav_2c6488e2:

    # bet "If today's tests went as planned, we were planning for him to return with [ama] and me in a couple of weeks."
    bet "Se os testes de hoje saíram como planejado, a gente tava planejando que ele voltasse com a [ama] e comigo em algumas semanas."

# game/scripts/c32/c32.rpy:4548
translate brazilian c32s006_Gav_eafb47b0:

    # bet "I think we'll be able to stick to the plan."
    bet "Acho que vamos conseguir seguir o plano."

# game/scripts/c32/c32.rpy:4549
translate brazilian c32s006_Gav_72ea7601:

    # mc "I didn't know you were going back with [ama]..."
    mc "Eu não sabia que você ia voltar com a [ama]..."

# game/scripts/c32/c32.rpy:4551
translate brazilian c32s006_Gav_7d8cd541:

    # bet "If my patient is in Newport, I should be there also."
    bet "Se meu paciente está em Newport, eu também deveria estar lá."

# game/scripts/c32/c32.rpy:4552
translate brazilian c32s006_Gav_0a8e2187:

    # bet "At least until you build the hand for [cal] and I have to come back."
    bet "Pelo menos até você construir a mão para o [cal] e eu ter que voltar."

# game/scripts/c32/c32.rpy:4553
translate brazilian c32s006_Gav_a870f222:

    # mc "Then you'll be back in Aruba soon."
    mc "Então você estará de volta a Aruba em breve."

# game/scripts/c32/c32.rpy:4555
translate brazilian c32s006_Gav_faada1f8:

    # ama "With [gav] in Newport, there will be nine of us on the surveillance team."
    ama "Com o [gav] em Newport, seremos nove na equipe de vigilância."

# game/scripts/c32/c32.rpy:4556
translate brazilian c32s006_Gav_f3d75845:

    # ama "It's a good number to be able to run three shifts and get enough rest."
    ama "É um bom número para podermos fazer três turnos e descansar o suficiente."

# game/scripts/c32/c32.rpy:4557
translate brazilian c32s006_Gav_e91acf60:

    # ama "The guys on the team have already been working hard to remodel the hacienda."
    ama "Os caras da equipe já estão trabalhando duro para reformar a hacienda."

# game/scripts/c32/c32.rpy:4558
translate brazilian c32s006_Gav_6044aba1:

    # mc "I leave that in your hands."
    mc "Deixo isso em suas mãos."

# game/scripts/c32/c32.rpy:4560
translate brazilian c32s006_Gav_ec1a8bf0:

    # gav "And today I proved I'm good for more than just staring at screens."
    gav "E hoje eu provei que sirvo para mais do que apenas ficar olhando para telas."

# game/scripts/c32/c32.rpy:4561
translate brazilian c32s006_Gav_95209e42:

    # mc "I saw. I'm really happy for you, [gav]."
    mc "Eu vi. Estou muito feliz por você, [gav]."

# game/scripts/c32/c32.rpy:4563
translate brazilian c32s006_Gav_8c33030c:

    # aar "And, in the afternoon, we'll go to the shooting range to do more tests. This time without spectators."
    aar "E, de tarde, vamos ao estande de tiro para fazer mais testes. Dessa vez sem espectadores."

# game/scripts/c32/c32.rpy:4564
translate brazilian c32s006_Gav_62ec13b7:

    # aar "Though you can come, of course. You're the boss."
    aar "Embora você possa vir, claro. Você é o chefe."

# game/scripts/c32/c32.rpy:4565
translate brazilian c32s006_Gav_df82ff91:

    # mc "I wasn't aware of it, and I have a meeting with [vin] and his small hands."
    mc "Eu não estava sabendo, e tenho uma reunião com o [vin] e as mãozinhas dele."

# game/scripts/c32/c32.rpy:4567
translate brazilian c32s006_Gav_42da85f6:

    # aar "*Laugh* I don't envy you. I'll send you a report with the test results."
    aar "*Risos* Não invejo você. Vou te mandar um relatório com os resultados dos testes."

# game/scripts/c32/c32.rpy:4568
translate brazilian c32s006_Gav_e426dde9:

    # mc "*Laugh* Can [cal] send it to me? You still haven't grasped the meaning of 'concise'."
    mc "*Risos* O [cal] pode me mandar? Você ainda não entendeu o significado de 'conciso'."

# game/scripts/c32/c32.rpy:4569
translate brazilian c32s006_Gav_cbf2b236:

    # aar "*Laugh* I'll end up hating you."
    aar "*Risos* Vou acabar te odiando."

# game/scripts/c32/c32.rpy:4570
translate brazilian c32s006_Gav_00c97bf0:

    # mc "*Laugh* Then I'll stop asking you to come over for dinner."
    mc "*Risos* Então vou parar de te convidar para jantar."

# game/scripts/c32/c32.rpy:4571
translate brazilian c32s006_Gav_4bc43f5f:

    # aar "*Laugh* Okay, I won't hate you too much."
    aar "*Risos* Beleza, não vou te odiar tanto assim."

# game/scripts/c32/c32.rpy:4573
translate brazilian c32s006_Gav_56c97377:

    # "In the afternoon, after the meeting with [vin] in your temporary office, you read [cal]'s report on the shooting tests."
    "À tarde, depois da reunião com o [vin] no seu escritório temporário, você lê o relatório do [cal] sobre os testes de tiro."

# game/scripts/c32/c32.rpy:4574
translate brazilian c32s006_Gav_77894759:

    # "They are the best results [gav] has ever had at the shooting range. You remember [eva] telling you he wasn't very good."
    "São os melhores resultados que o [gav] já teve no estande de tiro. Você se lembra da [eva] te dizendo que ele não era muito bom."

# game/scripts/c32/c32.rpy:4575
translate brazilian c32s006_Gav_ca50e93c:

    # "He's far from [ama]'s or even [dam]'s scores, but he's gone from being one of the worst G's to being near the top."
    "Ele está longe das pontuações da [ama] ou até mesmo do [dam], mas ele passou de um dos piores G's para estar perto do topo."
# game/scripts/c32/c32.rpy:4576
translate brazilian c32s006_Gav_c6c73a5d:

    # "The mechanical arm has given him a stability he didn't have before. And it can only get better as he keeps training."
    "O braço mecânico deu a ele uma estabilidade que não tinha antes. E só pode melhorar conforme ele continua treinando."

# game/scripts/c32/c32.rpy:4587
translate brazilian c32s007_cult_48a8a1c4:

    # centered "{size=+20}{b}DAY 69 – SUNDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 69 – DOMINGO{/b}{/size}"

# game/scripts/c32/c32.rpy:4589
translate brazilian c32s007_cult_99af4077:

    # mc "Are you ready to come over yet?"
    mc "Você já está pronta para vir para cá?"

# game/scripts/c32/c32.rpy:4590
translate brazilian c32s007_cult_68477913:

    # eva "I've been ready for a month. The ones I'm not so sure are ready are the guys."
    eva "Eu estou pronta há um mês. Quem eu não tenho tanta certeza se estão prontos são os caras."

# game/scripts/c32/c32.rpy:4591
translate brazilian c32s007_cult_954cd086:

    # eva "I'm scared to leave them alone. They still haven't learned everyone's names... And they've been here for a week already."
    eva "Estou com medo de deixá-los sozinhos. Eles ainda não aprenderam o nome de todo mundo... E já estão aqui há uma semana."

# game/scripts/c32/c32.rpy:4592
translate brazilian c32s007_cult_897e721e:

    # mc "*Laugh* Do they sometimes hesitate between the names of two of the 20 girls? Do they still not know everyone's favorite color?"
    mc "*Risos* Eles às vezes hesitam entre os nomes de duas das 20 garotas? Eles ainda não sabem a cor favorita de todo mundo?"

# game/scripts/c32/c32.rpy:4594
translate brazilian c32s007_cult_2b1c8aa9:

    # eva "Don't laugh! These are important things!"
    eva "Não ria! Essas são coisas importantes!"

# game/scripts/c32/c32.rpy:4595
translate brazilian c32s007_cult_498911c7:

    # eva "If someone showed up disguised as [emm] but dressed in... I don't know... green... maybe they wouldn't spot her..."
    eva "Se alguém aparecesse disfarçada de [emm] mas vestida de... sei lá... verde... talvez eles não a reconhecessem..."

# game/scripts/c32/c32.rpy:4596
translate brazilian c32s007_cult_604f76fb:

    # mc "I'm sure that, after more than a week there, they already know that [emm] is the Pink Queen."
    mc "Tenho certeza de que, depois de mais de uma semana aí, eles já sabem que a [emm] é a Rainha Rosa."

# game/scripts/c32/c32.rpy:4599
translate brazilian c32s007_cult_7acb2f8a:

    # eva "*Laugh* Well, they do know that. I think [isr] almost gouged his eyes out when he saw [emm]'s room for the first time."
    eva "*Risos* Bom, isso eles sabem. Acho que o [isr] quase arrancou os próprios olhos quando viu o quarto da [emm] pela primeira vez."

# game/scripts/c32/c32.rpy:4600
translate brazilian c32s007_cult_b574169f:

    # eva "But I'm not so sure they'd spot a clone of [eri] dressed in pink."
    eva "Mas não tenho tanta certeza se eles reconheceriam um clone da [eri] vestida de rosa."
# game/scripts/c32/c32.rpy:4602
translate brazilian c32s007_cult_07b37995:

    # mc "*Laugh* Luckily, the only clone of [eri] is you."
    mc "*Risos* Por sorte, o único clone da [eri] é você."

# game/scripts/c32/c32.rpy:4604
translate brazilian c32s007_cult_4a7899e8:

    # mc "*Laugh* I think the only one who could pass for [eri] is you."
    mc "*Risos* Acho que a única que poderia se passar pela [eri] é você."

# game/scripts/c32/c32.rpy:4605
translate brazilian c32s007_cult_fd86c42f:

    # mc "And they'd recognize you instantly. [eri] doesn't walk around like she's about to murder someone."
    mc "E eles te reconheceriam na hora. A [eri] não anda por aí como se estivesse prestes a assassinar alguém."

# game/scripts/c32/c32.rpy:4607
translate brazilian c32s007_cult_508d6e3b:

    # eva "I don't do that either! That would be like giving the enemy an advantage by revealing my intentions."
    eva "Eu também não faço isso! Isso seria como dar uma vantagem ao inimigo revelando minhas intenções."

# game/scripts/c32/c32.rpy:4608
translate brazilian c32s007_cult_f01a99c1:

    # mc "*Laugh* Never change, [eva]."
    mc "*Risos* Nunca mude, [eva]."

# game/scripts/c32/c32.rpy:4611
translate brazilian c32s007_cult_e9b16481:

    # eva "Well, thanks to you and your magic cum, I am going to change. I'm going to get fat as fuck."
