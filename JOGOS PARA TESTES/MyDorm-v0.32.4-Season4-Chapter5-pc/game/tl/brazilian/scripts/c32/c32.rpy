    # mc "*Laugh* That sounded like it bothered you."
    mc "*Risos* Isso soou como se tivesse te incomodado."

# game/scripts/c32/c32.rpy:2930
translate brazilian c32s004_MarSamArrival_cf92202c:

    # mom "Don't listen to him, Aunt [bet]."
    mom "Não dê ouvidos a ele, Tia [bet]."

# game/scripts/c32/c32.rpy:2931
translate brazilian c32s004_MarSamArrival_973f2d06:

    # mom "It's been ages since [sam.nick] had three days off in a row."
    mom "Faz séculos que a [sam.nick] não tem três dias de folga seguidos."

# game/scripts/c32/c32.rpy:2933
translate brazilian c32s004_MarSamArrival_47a855ba:

    # sam "And [mar] won't be available starting next week, with the arrival of the new students."
    sam "E a [mar] não vai estar disponível a partir da semana que vem, com a chegada dos novos alunos."

# game/scripts/c32/c32.rpy:2934
