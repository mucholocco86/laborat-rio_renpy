# game/scripts/c32/c32.rpy:2812
translate brazilian c32s004_routine_d6482ace:

    # "One night, after dinner, [ama] informs you that she's pregnant."
    "Uma noite, depois do jantar, [ama] te informa que está grávida."

# game/scripts/c32/c32.rpy:2814
translate brazilian c32s004_routine_8dcd9e38:

    # "She wants to talk to [mael] to find out if there are any implications due to being a clone. Luckily, there aren't any."
