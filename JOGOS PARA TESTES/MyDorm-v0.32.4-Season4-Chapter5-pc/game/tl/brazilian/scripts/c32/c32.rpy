# game/scripts/c32/c32.rpy:1145
translate brazilian c32s002_trainingCamp_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c32/c32.rpy:1146
translate brazilian c32s002_trainingCamp_3e597b1c:

    # mc "Come in, [ama]."
    mc "Pode entrar, [ama]."

# game/scripts/c32/c32.rpy:1149
translate brazilian c32s002_trainingCamp_6905e83d:

    # mc "Do you need to get out of here again?"
    mc "Você precisa sair daqui de novo?"

# game/scripts/c32/c32.rpy:1150
translate brazilian c32s002_trainingCamp_b98d12cd:

    # ama "No. YOU need to get out of here."
    ama "Não. VOCÊ precisa sair daqui."

# game/scripts/c32/c32.rpy:1151
translate brazilian c32s002_trainingCamp_2ee38508:

    # ama "I asked [car], and your schedule is clear for the whole morning."
    ama "Eu perguntei pra [car], e sua agenda tá livre a manhã toda."
# game/scripts/c32/c32.rpy:1152
translate brazilian c32s002_trainingCamp_c9c869d9:

    # mc "Where are we going?"
    mc "Para onde estamos indo?"

# game/scripts/c32/c32.rpy:1154
translate brazilian c32s002_trainingCamp_3089f2d7:

    # ama "You wanted to see the training camp, right?"
    ama "Você queria ver o acampamento de treinamento, certo?"

# game/scripts/c32/c32.rpy:1155
translate brazilian c32s002_trainingCamp_1042eedd:

    # ama "It's almost empty right now, so it's a good time."
    ama "Está quase vazio agora, então é uma boa hora."

# game/scripts/c32/c32.rpy:1156
translate brazilian c32s002_trainingCamp_35c82184:

    # mc "Almost empty? We don't have that many missions going on."
    mc "Quase vazio? Não temos tantas missões acontecendo."

# game/scripts/c32/c32.rpy:1158
translate brazilian c32s002_trainingCamp_5cef495a:

    # ama "*Laugh* I might have told [aar] to send the boys on maneuvers until the afternoon."
    ama "*Risos* Eu posso ter dito ao [aar] para mandar os garotos para manobras até a tarde."

# game/scripts/c32/c32.rpy:1159
translate brazilian c32s002_trainingCamp_102ad838:

    # mc "*Laugh* You don't want me hanging out with tough guys?"
    mc "*Risos* Você não quer que eu ande com os caras durões?"

# game/scripts/c32/c32.rpy:1161
translate brazilian c32s002_trainingCamp_7f2f6e54:

    # ama "I don't want you hanging out with tough KIDS. They aren't ready to meet you yet."
    ama "Eu não quero que você ande com CRIANÇAS duronas. Eles não estão prontos para te conhecer ainda."

# game/scripts/c32/c32.rpy:1162
translate brazilian c32s002_trainingCamp_78a2e242:

    # mc "We're still training the kids?"
    mc "Ainda estamos treinando as crianças?"

# game/scripts/c32/c32.rpy:1163
translate brazilian c32s002_trainingCamp_0452cf97:

    # ama "Yes. You haven't decided what to do with them yet, and [aar] doesn't want them sitting idle and wasting time."
    ama "Sim. Você ainda não decidiu o que fazer com eles, e o [aar] não quer que eles fiquem ociosos perdendo tempo."

# game/scripts/c32/c32.rpy:1164
translate brazilian c32s002_trainingCamp_0a135cd4:

    # mc "Deciding what to do with them just became one of my top priorities. I thought..."
    mc "Decidir o que fazer com eles acabou de virar uma das minhas maiores prioridades. Eu achei..."

# game/scripts/c32/c32.rpy:1166
translate brazilian c32s002_trainingCamp_3781b298:

    # ama "Did you think [aar] was going to make that decision for you? He can't."
    ama "Você achou que o [aar] ia tomar essa decisão por você? Ele não pode."
# game/scripts/c32/c32.rpy:1167
translate brazilian c32s002_trainingCamp_5beb8d55:

    # ama "It's an order that has to come from this office. Only you can make it."
    ama "É uma ordem que tem que vir deste escritório. Só você pode dar."

# game/scripts/c32/c32.rpy:1168
translate brazilian c32s002_trainingCamp_29c99abf:

    # mc "Should we meet tomorrow and talk about it? We also need to discuss the rest of the requests the operatives made."
    mc "Devemos nos encontrar amanhã e conversar sobre isso? Também precisamos discutir o resto dos pedidos que os agentes fizeram."

# game/scripts/c32/c32.rpy:1169
translate brazilian c32s002_trainingCamp_5394274e:

    # mc "But I want the younger kids away from weapons as soon as possible."
    mc "Mas eu quero as crianças mais novas longe das armas o mais rápido possível."

# game/scripts/c32/c32.rpy:1171
translate brazilian c32s002_trainingCamp_e79f43ef:

    # ama "I think it's a good idea. But we need to find something to do with them."
    ama "Acho que é uma boa ideia. Mas precisamos encontrar algo para fazer com elas."

# game/scripts/c32/c32.rpy:1172
translate brazilian c32s002_trainingCamp_91ec79dd:

    # ama "You'll have a problem with anyone who wants to be a field operative. What are you going to do if one of them wants to keep training with weapons?"
    ama "Você terá um problema com qualquer um que queira ser um agente de campo. O que você vai fazer se um deles quiser continuar treinando com armas?"

# game/scripts/c32/c32.rpy:1173
translate brazilian c32s002_trainingCamp_52ee661c:

    # mc "I think that's a bridge we'll cross when we get to it."
    mc "Acho que vamos lidar com isso quando chegar a hora."

# game/scripts/c32/c32.rpy:1174
translate brazilian c32s002_trainingCamp_b57a80cf:

    # mc "But I think I'm going to have to act like they're normal kids. There's an age for school and an age for making decisions."
    mc "Mas acho que vou ter que agir como se fossem crianças normais. Tem idade para a escola e idade para tomar decisões."

# game/scripts/c32/c32.rpy:1176
translate brazilian c32s002_trainingCamp_a45ddc36:

    # ama "*Laugh* Do you realize you just used the word 'normal' to leave our kids out of it?"
    ama "*Risos* Você percebe que acabou de usar a palavra 'normal' para deixar nossas crianças de fora disso?"

# game/scripts/c32/c32.rpy:1177
translate brazilian c32s002_trainingCamp_32990a61:

    # mc "I didn't realize it. And I don't think it's funny."
    mc "Não percebi. E não acho engraçado."

# game/scripts/c32/c32.rpy:1178
translate brazilian c32s002_trainingCamp_ba32d449:

    # ama "What I think is funny is that a few days ago you wanted to tell [alb] off for the exact same thing."
    ama "O que eu acho engraçado é que alguns dias atrás você queria dar uma bronca na [alb] exatamente pela mesma coisa."

# game/scripts/c32/c32.rpy:1179
translate brazilian c32s002_trainingCamp_54283b73:

    # mc "You're right. Sometimes language plays tricks on us because we're used to using it in a specific way."
    mc "Você tem razão. Às vezes a linguagem nos prega peças porque estamos acostumados a usá-la de uma maneira específica."
# game/scripts/c32/c32.rpy:1180
translate brazilian c32s002_trainingCamp_c58e2da7:

    # mc "But you'll never hear me use 'humans' to leave clones out of that word. Or at least I hope not."
    mc "Mas você nunca vai me ouvir usar 'humanos' pra deixar os clones de fora dessa palavra. Ou pelo menos espero que não."

# game/scripts/c32/c32.rpy:1182
translate brazilian c32s002_trainingCamp_f9c39b1b:

    # ama "I hope so too. Now get dressed. Jeans aren't a good outfit for the training camp."
    ama "Eu também espero. Agora se vista. Jeans não é uma boa roupa pro campo de treinamento."

# game/scripts/c32/c32.rpy:1183
translate brazilian c32s002_trainingCamp_006b4b86:

    # mc "Are you going to make me run around the walls?"
    mc "Você vai me fazer correr em volta dos muros?"

# game/scripts/c32/c32.rpy:1185
translate brazilian c32s002_trainingCamp_45da8c5a:

    # ama "You already know about the walls? Did [aar] take you there?"
    ama "Você já sabe sobre os muros? [aar] te levou lá?"

# game/scripts/c32/c32.rpy:1186
translate brazilian c32s002_trainingCamp_e8a68b02:

    # mc "No, but I've checked the blueprints. And I was impressed."
    mc "Não, mas eu dei uma olhada nas plantas. E fiquei impressionado."

# game/scripts/c32/c32.rpy:1187
translate brazilian c32s002_trainingCamp_c8bbda3f:

    # mc "The walls seem extensive enough that it wouldn't be pleasant to run around them in this heat."
    mc "Os muros parecem extensos o suficiente pra não ser nada agradável correr em volta deles nesse calor."

# game/scripts/c32/c32.rpy:1189
translate brazilian c32s002_trainingCamp_9cf08c40:

    # ama "Then you'd better get dressed quickly. Or I'll have to make you run."
    ama "Então é melhor você se vestir rápido. Ou vou ter que te fazer correr."

# game/scripts/c32/c32.rpy:1190
translate brazilian c32s002_trainingCamp_507f27d6:

    # mc "At your command, Ma'am!"
    mc "Às suas ordens, Senhora!"

# game/scripts/c32/c32.rpy:1192
translate brazilian c32s002_trainingCamp_83d048aa:

    # "This time, [ama] drives the same beat-up Humvee down a normal road."
    "Dessa vez, [ama] dirige o mesmo Humvee surrado por uma estrada normal."

# game/scripts/c32/c32.rpy:1193
translate brazilian c32s002_trainingCamp_7a72735a:

    # "You assume the transport trucks need asphalt to drive on."
    "Você presume que os caminhões de transporte precisam de asfalto para rodar."

# game/scripts/c32/c32.rpy:1195
translate brazilian c32s002_trainingCamp_9377038d:

    # "After a few minutes, you arrive at the main base. It's big, but not as big as you thought."
    "Depois de alguns minutos, você chega à base principal. É grande, mas não tão grande quanto você pensava."
# game/scripts/c32/c32.rpy:1196
translate brazilian c32s002_trainingCamp_2a23c3a3:

    # "The blueprints seem to have fooled you. An airstrip wouldn't fit here."
    "As plantas parecem ter te enganado. Uma pista de pouso não caberia aqui."

# game/scripts/c32/c32.rpy:1197
translate brazilian c32s002_trainingCamp_4758d1c4:

    # "The base is empty, except for a few guards in the watchtowers."
    "A base está vazia, exceto por alguns guardas nas torres de vigia."

# game/scripts/c32/c32.rpy:1199
translate brazilian c32s002_trainingCamp_92862130:

    # mc "I thought it would be bigger."
    mc "Eu achei que seria maior."

# game/scripts/c32/c32.rpy:1200
translate brazilian c32s002_trainingCamp_0c46102b:

    # ama "The blueprints you checked are probably outdated."
    ama "As plantas que você olhou provavelmente estão desatualizadas."

# game/scripts/c32/c32.rpy:1201
translate brazilian c32s002_trainingCamp_f7b9a57f:

    # ama "This was built a couple of years ago to mimic an American outpost in Jordan."
    ama "Isso foi construído há alguns anos para imitar um posto avançado americano na Jordânia."

# game/scripts/c32/c32.rpy:1202
translate brazilian c32s002_trainingCamp_dd973a24:

    # ama "Except for the desert, of course."
    ama "Exceto pelo deserto, é claro."

# game/scripts/c32/c32.rpy:1203
translate brazilian c32s002_trainingCamp_a9f7e2b1:

    # mc "So, the airstrip and the hangars...?"
    mc "Então, a pista de pouso e os hangares...?"

# game/scripts/c32/c32.rpy:1205
translate brazilian c32s002_trainingCamp_0e384c41:

    # ama "They're beyond the north wall. A couple of transport planes, three training planes, and a couple more helicopters are there."
    ama "Estão além do muro norte. Alguns aviões de transporte, três aviões de treinamento e mais alguns helicópteros estão lá."

# game/scripts/c32/c32.rpy:1206
translate brazilian c32s002_trainingCamp_0b0708ad:

    # ama "We'll see them when I'm done showing you this."
    ama "Nós vamos vê-los quando eu terminar de te mostrar isso."

# game/scripts/c32/c32.rpy:1207
translate brazilian c32s002_trainingCamp_5bf71cb7:

    # ama "And no, we don't have fighter jets for the same reason we don't have tanks."
    ama "E não, nós não temos caças pelo mesmo motivo que não temos tanques."

# game/scripts/c32/c32.rpy:1208
translate brazilian c32s002_trainingCamp_082b3008:

    # ama "The closest thing you'll see is that black beauty over there."
    ama "A coisa mais próxima que você vai ver é aquela belezinha preta ali."
# game/scripts/c32/c32.rpy:1209
translate brazilian c32s002_trainingCamp_819af20e:

    # mc "Is that an attack helicopter?"
    mc "Isso é um helicóptero de ataque?"

# game/scripts/c32/c32.rpy:1211
translate brazilian c32s002_trainingCamp_d4e01ea4:

    # ama "Now it's more of a ground support helicopter. It's an AH-60L."
    ama "Agora é mais um helicóptero de apoio terrestre. É um AH-60L."

# game/scripts/c32/c32.rpy:1212
translate brazilian c32s002_trainingCamp_8546ac1d:

    # ama "This one was... stolen by some D's in Riohacha. It has machine guns and rockets, but no Hellfire missiles. Again, we don't have them and we don't need them."
    ama "Esse aqui foi... roubado por alguns D's em Riohacha. Tem metralhadoras e foguetes, mas não tem mísseis Hellfire. Novamente, não temos e não precisamos deles."

# game/scripts/c32/c32.rpy:1213
translate brazilian c32s002_trainingCamp_5511b27c:

    # mc "*Surprised Gasp* We steal equipment from our customers?"
    mc "*Suspiro de surpresa* Nós roubamos equipamento dos nossos clientes?"

# game/scripts/c32/c32.rpy:1215
translate brazilian c32s002_trainingCamp_2d4448b2:

    # ama "Theft or payment in kind. Whatever you prefer to call it."
    ama "Roubo ou pagamento em bens. Como você preferir chamar."

# game/scripts/c32/c32.rpy:1216
translate brazilian c32s002_trainingCamp_25261f89:

    # ama "It's not official company policy, but if they refuse to pay... We don't risk our lives for nothing."
    ama "Não é a política oficial da empresa, mas se eles se recusam a pagar... Nós não arriscamos nossas vidas por nada."

# game/scripts/c32/c32.rpy:1217
translate brazilian c32s002_trainingCamp_bb0d884a:

    # "You realize that, despite everything, that sentence shows a loyalty to the company that's hard to understand in the world outside of NTR."
    "Você percebe que, apesar de tudo, essa frase mostra uma lealdade à empresa que é difícil de entender no mundo fora da NTR."

# game/scripts/c32/c32.rpy:1219
translate brazilian c32s002_trainingCamp_fd08b1fe:

    # ama "There haven't been any more problems with payments from Colombia."
    ama "Não houve mais problemas com pagamentos da Colômbia."

# game/scripts/c32/c32.rpy:1220
translate brazilian c32s002_trainingCamp_8091043c:

    # ama "The loss of that helicopter hurt them more than the benefit it brings us."
    ama "A perda daquele helicóptero doeu mais neles do que o benefício que nos traz."

# game/scripts/c32/c32.rpy:1221
translate brazilian c32s002_trainingCamp_b3961c59:

    # mc "Why?"
    mc "Por quê?"

# game/scripts/c32/c32.rpy:1223
translate brazilian c32s002_trainingCamp_e9f6640a:

    # ama "We have limited deployment capabilities. We can't take it on a mission to Cambodia, for example."
    ama "Temos capacidades de mobilização limitadas. Não podemos levá-lo em uma missão para o Camboja, por exemplo."
# game/scripts/c32/c32.rpy:1224
translate brazilian c32s002_trainingCamp_5d434da7:

    # ama "Well, we could, but the American government wouldn't be very happy if we did. Too close to China, in case we lose it."
    ama "Bom, a gente poderia, mas o governo americano não ficaria muito feliz se a gente fizesse isso. Perto demais da China, caso a gente perca."

# game/scripts/c32/c32.rpy:1225
translate brazilian c32s002_trainingCamp_f9d06dcf:

    # ama "And we don't have the infrastructure to get the most out of it. Spare parts, weaponry, etc."
    ama "E a gente não tem a infraestrutura pra tirar o máximo proveito dele. Peças de reposição, armamento, etc."

# game/scripts/c32/c32.rpy:1226
translate brazilian c32s002_trainingCamp_15a161b6:

    # ama "But it's useful for training, in case we need to fly one someday."
    ama "Mas é útil pra treinar, caso a gente precise pilotar um algum dia."

# game/scripts/c32/c32.rpy:1227
translate brazilian c32s002_trainingCamp_5a02179d:

    # mc "Or if we need to steal another one."
    mc "Ou se a gente precisar roubar outro."

# game/scripts/c32/c32.rpy:1229
translate brazilian c32s002_trainingCamp_63310262:

    # ama "*Laugh* Exactly. Next time, we'll try not to kill any soldiers in the process."
    ama "*Risos* Exatamente. Da próxima vez, vamos tentar não matar nenhum soldado no processo."

# game/scripts/c32/c32.rpy:1230
translate brazilian c32s002_trainingCamp_1de43f72:

    # "The casualness of the phrase, said between laughs, makes your blood run cold."
    "A casualidade da frase, dita entre risadas, faz seu sangue gelar."

# game/scripts/c32/c32.rpy:1231
translate brazilian c32s002_trainingCamp_6389fc17:

    # ama "*Laugh* But we make no promises. Pay up to make sure we don't need to."
    ama "*Risos* Mas não prometemos nada. Pague pra garantir que não precisemos."

# game/scripts/c32/c32.rpy:1232
translate brazilian c32s002_trainingCamp_3f645419:

    # "You hadn't realized that, to steal a helicopter, the D's had to kill Colombian soldiers."
    "Você não tinha percebido que, pra roubar um helicóptero, os D's tiveram que matar soldados colombianos."

# game/scripts/c32/c32.rpy:1235
translate brazilian c32s002_trainingCamp_90d4ac56:

    # ama "Oh! Shit!"
    ama "Ah! Merda!"

# game/scripts/c32/c32.rpy:1236
translate brazilian c32s002_trainingCamp_e8bdf55d:

    # ama "Did I say that laughing?"
    ama "Eu falei isso rindo?"

# game/scripts/c32/c32.rpy:1237
translate brazilian c32s002_trainingCamp_ebb33a63:

    # mc "I'm afraid so..."
    mc "Temo que sim..."
# game/scripts/c32/c32.rpy:1239
translate brazilian c32s002_trainingCamp_a495d38f:

    # ama "Right now I feel inhuman..."
    ama "Neste momento eu me sinto desumana..."

# game/scripts/c32/c32.rpy:1241
translate brazilian c32s002_trainingCamp_8ed395fb:

    # ama "Just like how those who don't consider clones to be people see us..."
    ama "Exatamente como aqueles que não consideram clones como pessoas nos veem..."

# game/scripts/c32/c32.rpy:1242
translate brazilian c32s002_trainingCamp_57f14506:

    # ama "Those soldiers must have had mothers and families who will miss them..."
    ama "Aqueles soldados deviam ter mães e famílias que vão sentir falta deles..."

# game/scripts/c32/c32.rpy:1243
translate brazilian c32s002_trainingCamp_65f9676b:

    # mc "Yes..."
    mc "Sim..."

# game/scripts/c32/c32.rpy:1246
translate brazilian c32s002_trainingCamp_ca5334ee:

    # ama "We all celebrated when Dax and [dec] brought that helicopter back."
    ama "Nós todos comemoramos quando Dax e [dec] trouxeram aquele helicóptero de volta."

# game/scripts/c32/c32.rpy:1247
translate brazilian c32s002_trainingCamp_fd4f4e50:

    # ama "Colombia had tried to rob us and we had robbed them."
    ama "A Colômbia tinha tentado nos roubar e nós os roubamos."

# game/scripts/c32/c32.rpy:1248
translate brazilian c32s002_trainingCamp_e73abae1:

    # ama "No one thought about the 14 soldiers they killed between the two of them to take the bird. No one cared."
    ama "Ninguém pensou nos 14 soldados que eles mataram juntos para pegar o pássaro. Ninguém se importou."

# game/scripts/c32/c32.rpy:1249
translate brazilian c32s002_trainingCamp_6700eb92:

    # mc "You didn't know what a family was beyond these walls. It was you against the rest of the world."
    mc "Você não sabia o que era uma família além dessas paredes. Era você contra o resto do mundo."

# game/scripts/c32/c32.rpy:1250
translate brazilian c32s002_trainingCamp_e7668583:

    # mc "Now you know. And you understand what loss is, or what [mar], [nor], or [emm] would feel if you didn't come home from a mission."
    mc "Agora você sabe. E você entende o que é a perda, ou o que [mar], [nor] ou [emm] sentiriam se você não voltasse para casa de uma missão."

# game/scripts/c32/c32.rpy:1252
translate brazilian c32s002_trainingCamp_7456d26c:

    # ama "[mar] is the first one I thought of."
    ama "[mar] é a primeira em quem eu pensei."

# game/scripts/c32/c32.rpy:1253
translate brazilian c32s002_trainingCamp_15784a87:

    # ama "And I feel ashamed of what she would think if she heard me say that while I was laughing..."
    ama "E eu me sinto envergonhada do que ela pensaria se me ouvisse dizer aquilo enquanto eu ria..."
# game/scripts/c32/c32.rpy:1254
translate brazilian c32s002_trainingCamp_12748f12:

    # mc "You're changing, [ama]. And that's good. But it's a process. Don't expect to be a different person overnight."
    mc "Você está mudando, [ama]. E isso é bom. Mas é um processo. Não espere ser uma pessoa diferente da noite para o dia."

# game/scripts/c32/c32.rpy:1256
translate brazilian c32s002_trainingCamp_8af89b15:

    # ama "It's... so hard."
    ama "É... tão difícil."

# game/scripts/c32/c32.rpy:1257
translate brazilian c32s002_trainingCamp_26fbc775:

    # mc "It's not hard, [ama]. It's something that requires learning."
    mc "Não é difícil, [ama]. É algo que requer aprendizado."

# game/scripts/c32/c32.rpy:1258
translate brazilian c32s002_trainingCamp_3c091858:

    # mc "While you were learning to shoot bazookas and speak 30 languages, we were learning to live as a family, to feel empathy."
    mc "Enquanto você aprendia a atirar com bazucas e falar 30 idiomas, nós estávamos aprendendo a viver como uma família, a sentir empatia."

# game/scripts/c32/c32.rpy:1259
translate brazilian c32s002_trainingCamp_7cecae76:

    # mc "In less than a month you've taken a crash course on family and empathy, but..."
    mc "Em menos de um mês você fez um curso intensivo sobre família e empatia, mas..."

# game/scripts/c32/c32.rpy:1261
translate brazilian c32s002_trainingCamp_a66b9a63:

    # ama "But I still speak the language of empathy with a weird accent, right?"
    ama "Mas eu ainda falo a língua da empatia com um sotaque estranho, né?"

# game/scripts/c32/c32.rpy:1262
translate brazilian c32s002_trainingCamp_e62dd4bb:

    # mc "I like the analogy. Yes, that's exactly it. And every now and then a word in your native language slips out."
    mc "Gostei da analogia. Sim, é exatamente isso. E de vez em quando escapa uma palavra na sua língua nativa."

# game/scripts/c32/c32.rpy:1263
translate brazilian c32s002_trainingCamp_3bc0cfcd:

    # mc "But that gets fixed with practice."
    mc "Mas isso se conserta com a prática."

# game/scripts/c32/c32.rpy:1265
translate brazilian c32s002_trainingCamp_e0260a26:

    # "At that moment, you hear the gates of the replica outpost open."
    "Naquele momento, você ouve os portões da réplica do posto avançado se abrirem."

# game/scripts/c32/c32.rpy:1266
translate brazilian c32s002_trainingCamp_ccd8fce5:

    # "A troop transport truck makes its appearance."
    "Um caminhão de transporte de tropas aparece."

# game/scripts/c32/c32.rpy:1268
translate brazilian c32s002_trainingCamp_09eeff9d:

    # mc "I thought we were going to be alone..."
    mc "Achei que fôssemos ficar sozinhos..."
# game/scripts/c32/c32.rpy:1269
translate brazilian c32s002_trainingCamp_1d7c36fe:

    # ama "Me too. No one was supposed to be back for another two hours, at least."
    ama "Eu também. Ninguém deveria voltar por pelo menos mais duas horas."

# game/scripts/c32/c32.rpy:1271
translate brazilian c32s002_trainingCamp_a903f090:

    # mc "Hey, [dam]... Wait, you're not [dam]."
    mc "Ei, [dam]... Peraí, você não é o [dam]."

# game/scripts/c32/c32.rpy:1276
translate brazilian c32s002_trainingCamp_c35ea246:

    # dec "Hello, Sir. I'm [dec]. How did you know?"
    dec "Olá, Senhor. Eu sou o [dec]. Como você sabia?"

# game/scripts/c32/c32.rpy:1278
translate brazilian c32s002_trainingCamp_522a4dbc:

    # dam "Because I'm unmistakable, [dec]. I don't think I'll ever get tired of saying it."
    dam "Porque eu sou inconfundível, [dec]. Acho que nunca vou me cansar de dizer isso."

# game/scripts/c32/c32.rpy:1280
translate brazilian c32s002_trainingCamp_eeaa3e2f:

    # dam "Hey, [ama] and [mc]."
    dam "E aí, [ama] e [mc]."

# game/scripts/c32/c32.rpy:1281
translate brazilian c32s002_trainingCamp_b8710cc5:

    # mc "Hey, [dam]. I thought you guys would be on maneuvers all day."
    mc "E aí, [dam]. Achei que vocês ficariam em manobras o dia todo."

# game/scripts/c32/c32.rpy:1282
translate brazilian c32s002_trainingCamp_4555acbd:

    # dam "One of the guys got hurt."
    dam "Um dos caras se machucou."

# game/scripts/c32/c32.rpy:1284
translate brazilian c32s002_trainingCamp_e5b8eb24:

    # dam "Take Henry to the infirmary while I talk to the... boss."
    dam "Leve o Henry para a enfermaria enquanto eu falo com o... chefe."

# game/scripts/c32/c32.rpy:1285
translate brazilian c32s002_trainingCamp_a6c4ce43:

    # "The 'guys' who got off the truck could be your age. They've been staring at your interaction with [dam] and [dec]."
    "Os 'caras' que desceram do caminhão podem ter a sua idade. Eles ficaram encarando a sua interação com o [dam] e o [dec]."

# game/scripts/c32/c32.rpy:1286
translate brazilian c32s002_trainingCamp_b1d39e06:

    # dec "Don't worry, Dam. I'll go with them."
    dec "Não se preocupe, Dam. Eu vou com eles."

# game/scripts/c32/c32.rpy:1287
translate brazilian c32s002_trainingCamp_c578bcfc:

    # dec "Guys, stop gawking at the boss and follow me."
    dec "Galera, parem de babar no chefe e me sigam."
# game/scripts/c32/c32.rpy:1290
translate brazilian c32s002_trainingCamp_52fc87e2:

    # mc "Is the kid okay?"
    mc "O garoto tá bem?"

# game/scripts/c32/c32.rpy:1291
translate brazilian c32s002_trainingCamp_abbbed43:

    # dam "Yeah, a sprained ankle. The H's are small but tough. He'll be walking in a couple of hours."
    dam "Sim, torceu o tornozelo. Os H's são pequenos, mas durões. Ele vai estar andando em algumas horas."

# game/scripts/c32/c32.rpy:1292
translate brazilian c32s002_trainingCamp_70936128:

    # dam "We've notified the base and Doc said he'll be here in five or six minutes."
    dam "Avisamos a base e o Doutor disse que chega aqui em cinco ou seis minutos."

# game/scripts/c32/c32.rpy:1293
translate brazilian c32s002_trainingCamp_7f952e9c:

    # "Some of the H's and a G, you think it's [gid], have taken shelter in the shade of a tent. Watching you."
    "Alguns dos H's e um G, você acha que é o [gid], se abrigaram na sombra de uma tenda. Observando você."

# game/scripts/c32/c32.rpy:1295
translate brazilian c32s002_trainingCamp_74226d1c:

    # "Neither [dam] nor [ama] bother to introduce you to them. They whisper with little subtlety."
    "Nem [dam] nem [ama] se dão ao trabalho de apresentar você a eles. Eles sussurram com pouca sutileza."

# game/scripts/c32/c32.rpy:1296
translate brazilian c32s002_trainingCamp_13e3bbec:

    # cl1 "*Whispering* How dare he dress like one of us? Is he going to train?"
    cl1 "*Sussurrando* Como ele ousa se vestir como um de nós? Ele vai treinar?"

# game/scripts/c32/c32.rpy:1297
translate brazilian c32s002_trainingCamp_fd7edea0:

    # cl2 "*Whispering* [gav] and [fred] say he's different, but until I see it..."
    cl2 "*Sussurrando* [gav] e [fred] dizem que ele é diferente, mas até eu ver..."

# game/scripts/c32/c32.rpy:1299
translate brazilian c32s002_trainingCamp_7966bd9f:

    # mc "Isn't there a doctor at the outpost?"
    mc "Não tem um médico no posto avançado?"

# game/scripts/c32/c32.rpy:1300
translate brazilian c32s002_trainingCamp_eee74502:

    # dam "[carl] acts as a nurse. The C's are good with technical stuff and he can't fight anymore."
    dam "O [carl] atua como enfermeiro. Os C's são bons com coisas técnicas e ele não pode mais lutar."

# game/scripts/c32/c32.rpy:1301
translate brazilian c32s002_trainingCamp_be52efb0:

    # mc "You only have one nurse?"
    mc "Vocês só têm um enfermeiro?"

# game/scripts/c32/c32.rpy:1302
translate brazilian c32s002_trainingCamp_a1f246ea:

    # gid "*Whispering* I saw him in the waiting room while [gav] was in surgery..."
    gid "*Sussurrando* Eu vi ele na sala de espera enquanto o [gav] estava na cirurgia..."
# game/scripts/c32/c32.rpy:1303
translate brazilian c32s002_trainingCamp_55b3d01b:

    # cl1 "*Whispering* I bet the only thing he cared about was if the surgery went well and he could sell the arm."
    cl1 "*Sussurrando* Aposto que a única coisa que importava pra ele era se a cirurgia ia dar certo e ele ia poder vender o braço."

# game/scripts/c32/c32.rpy:1304
translate brazilian c32s002_trainingCamp_1226a41c:

    # cl2 "*Whispering* I was told he stayed until the very last moment. Even after the surgery was already over."
    cl2 "*Sussurrando* Me falaram que ele ficou até o último segundo. Mesmo depois da cirurgia já ter acabado."

# game/scripts/c32/c32.rpy:1305
translate brazilian c32s002_trainingCamp_a8c05bbf:

    # cl3 "*Whispering* I saw him too. And it wasn't the worried face of someone thinking about how much money they can make."
    cl3 "*Sussurrando* Eu também vi ele. E não era a cara de preocupação de quem tá pensando em quanta grana pode fazer."

# game/scripts/c32/c32.rpy:1307
translate brazilian c32s002_trainingCamp_82a8419d:

    # ama "It's not a combat zone, it's a training ground. [carl] probably doesn't see more than one guy a day."
    ama "Não é uma zona de combate, é um campo de treinamento. O [carl] provavelmente não vê mais de um cara por dia."

# game/scripts/c32/c32.rpy:1308
translate brazilian c32s002_trainingCamp_1ac44143:

    # ama "And Doc probably doesn't have to come more than once a month."
    ama "E o Doutor provavelmente não precisa vir mais de uma vez por mês."

# game/scripts/c32/c32.rpy:1309
translate brazilian c32s002_trainingCamp_386896de:

    # cl1 "*Whispering* I bet he just wants to save on the gas Doc uses when he comes."
    cl1 "*Sussurrando* Aposto que ele só quer economizar na gasolina que o Doutor gasta quando vem."

# game/scripts/c32/c32.rpy:1310
translate brazilian c32s002_trainingCamp_1a2de688:

    # cl3 "*Whispering* Didn't you hear? The first thing he did was to ask about Henry."
    cl3 "*Sussurrando* Vocês não ouviram? A primeira coisa que ele fez foi perguntar sobre o Henry."

# game/scripts/c32/c32.rpy:1311
translate brazilian c32s002_trainingCamp_46228ead:

    # cl2 "*Whispering* He looked worried..."
    cl2 "*Sussurrando* Ele parecia preocupado..."

# game/scripts/c32/c32.rpy:1313
translate brazilian c32s002_trainingCamp_e2c47665:

    # dam "Guys, you wanna see how the boss handles himself at the old shooting range?"
    dam "Aí galera, querem ver como o chefe se sai no velho estande de tiro?"

# game/scripts/c32/c32.rpy:1314
translate brazilian c32s002_trainingCamp_66b631dd:

    # mc "*Whispering* What are you doing?"
    mc "*Sussurrando* O que você tá fazendo?"

# game/scripts/c32/c32.rpy:1315
translate brazilian c32s002_trainingCamp_d80ccc61:

    # cl2 "Yeah!"
    cl2 "Bora!"
# game/scripts/c32/c32.rpy:1316
translate brazilian c32s002_trainingCamp_74435f2a:

    # cl1 "If he dresses like that, he should earn the right to do so."
    cl1 "Se ele se veste assim, deveria conquistar o direito de fazer isso."

# game/scripts/c32/c32.rpy:1317
translate brazilian c32s002_trainingCamp_381504a5:

    # cl3 "It's not necessary, but I'd like to see what he's made of."
    cl3 "Não é necessário, mas eu gostaria de ver do que ele é feito."

# game/scripts/c32/c32.rpy:1318
translate brazilian c32s002_trainingCamp_13416aa7:

    # dam "I think I'm going to kick his and [ama]'s asses."
    dam "Acho que vou dar uma surra nele e na [ama]."

# game/scripts/c32/c32.rpy:1320
translate brazilian c32s002_trainingCamp_f960e63f:

    # ama "*Whispering* [dam], what are you doing? He's not ready."
    ama "*Sussurrando* [dam], o que você está fazendo? Ele não está pronto."

# game/scripts/c32/c32.rpy:1322
translate brazilian c32s002_trainingCamp_73e30a03:

    # ama "You don't have to do this, [mc]. I think [dam] wants to make a fool out of you."
    ama "Você não precisa fazer isso, [mc]. Acho que o [dam] quer te fazer de idiota."

# game/scripts/c32/c32.rpy:1323
translate brazilian c32s002_trainingCamp_df6d2739:

    # ama "And out of me too, while he's at it."
    ama "E de mim também, aproveitando a deixa."

# game/scripts/c32/c32.rpy:1324
translate brazilian c32s002_trainingCamp_40de2197:

    # mc "I'm going to do it, [ama]. I'm not going to pretend to be someone I'm not."
    mc "Eu vou fazer isso, [ama]. Não vou fingir ser alguém que não sou."

# game/scripts/c32/c32.rpy:1326
translate brazilian c32s002_trainingCamp_475c75cb:

    # dam "Let's go to the old shooting range. Ladies, get in the truck."
    dam "Vamos para o velho estande de tiro. Senhoritas, entrem na caminhonete."

# game/scripts/c32/c32.rpy:1328
translate brazilian c32s002_trainingCamp_9de2bbd1:

    # "[dam] drives for a few minutes until reaching the shooting range."
    "[dam] dirige por alguns minutos até chegar ao estande de tiro."

# game/scripts/c32/c32.rpy:1329
translate brazilian c32s002_trainingCamp_0c63ec9d:

    # "The ride in the back of the truck is uncomfortable. Aside from the three H's, there's only [gid], the G you met in the waiting room."
    "A viagem na caçamba da caminhonete é desconfortável. Além das três H's, há apenas [gid], o G que você conheceu na sala de espera."

# game/scripts/c32/c32.rpy:1330
translate brazilian c32s002_trainingCamp_79ad38b7:

    # "No one says a word to [ama] or you. [ama] is lost in a strange silence."
    "Ninguém diz uma palavra para [ama] ou para você. [ama] está perdida em um silêncio estranho."
# game/scripts/c32/c32.rpy:1331
translate brazilian c32s002_trainingCamp_8a3bb6db:

    # "She's probably wondering what vehicle she's going to use to run over [dam]. And regretting not having a tank."
    "Ela provavelmente está se perguntando qual veículo vai usar para atropelar o [dam]. E se arrependendo de não ter um tanque."

# game/scripts/c32/c32.rpy:1333
translate brazilian c32s002_trainingCamp_2f31eedc:

    # "Upon arriving at the shooting range, the clones stay behind you, except for [dam]..."
    "Ao chegar no estande de tiro, os clones ficam atrás de você, exceto pelo [dam]..."

# game/scripts/c32/c32.rpy:1334
translate brazilian c32s002_trainingCamp_a108674e:

    # dam "Let's make it easy. 10 shots, standing, at 25 meters and we add up the scores."
    dam "Vamos facilitar. 10 tiros, em pé, a 25 metros e a gente soma os pontos."

# game/scripts/c32/c32.rpy:1335
translate brazilian c32s002_trainingCamp_278f4e71:

    # ama "*Whispering* He's never shot at 25 meters, [dam]."
    ama "*Sussurrando* Ele nunca atirou a 25 metros, [dam]."

# game/scripts/c32/c32.rpy:1337
translate brazilian c32s002_trainingCamp_69799174:

    # dam "If he wants to dress like us, he has to prove he's one of us. Right, boys?"
    dam "Se ele quer se vestir como a gente, tem que provar que é um de nós. Certo, garotos?"

# game/scripts/c32/c32.rpy:1339
translate brazilian c32s002_trainingCamp_a23a6e36:

    # cl4 "*Shouting* Yeah!"
    cl4 "*Gritando* É!"

# game/scripts/c32/c32.rpy:1341
translate brazilian c32s002_trainingCamp_16a67e4d:

    # dam "Him being old [aar]'s original isn't going to exempt him from having to show us how good he is."
    dam "Ele ser o original do velho [aar] não vai isentá-lo de ter que nos mostrar o quão bom ele é."

# game/scripts/c32/c32.rpy:1342
translate brazilian c32s002_trainingCamp_7446952a:

    # dam "Hank, get my gun from the truck and some magazines."
    dam "Hank, pega minha arma na caminhonete e alguns carregadores."

# game/scripts/c32/c32.rpy:1344
translate brazilian c32s002_trainingCamp_0bf6647d:

    # cl2 "What?"
    cl2 "O quê?"

# game/scripts/c32/c32.rpy:1345
translate brazilian c32s002_trainingCamp_794b0a75:

    # cl1 "Did you know?"
    cl1 "Você sabia?"

# game/scripts/c32/c32.rpy:1346
translate brazilian c32s002_trainingCamp_04bfcb4f:

    # gid "I saw them together on Sunday... [dam] is right."
    gid "Eu vi os dois juntos no domingo... O [dam] tem razão."
# game/scripts/c32/c32.rpy:1347
translate brazilian c32s002_trainingCamp_93cac421:

    # cl3 "I told you he was different..."
    cl3 "Eu te disse que ele era diferente..."

# game/scripts/c32/c32.rpy:1349
translate brazilian c32s002_trainingCamp_ee477e51:

    # dam "Ladies first."
    dam "Damas primeiro."

# game/scripts/c32/c32.rpy:1350
translate brazilian c32s002_trainingCamp_3047d0c2:

    # ama "*Whispering* I still don't get what you're trying to pull, asshole."
    ama "*Sussurrando* Eu ainda não entendi o que você tá tentando armar, seu cuzão."

# game/scripts/c32/c32.rpy:1351
translate brazilian c32s002_trainingCamp_dfc207a7:

    # dam "Move that ass to the shooting position and show us you haven't gotten rusty with your comfy life in Newport."
    dam "Mexe essa bunda pra posição de tiro e mostra pra gente que não enferrujou com a sua vidinha confortável em Newport."

# game/scripts/c32/c32.rpy:1352
translate brazilian c32s002_trainingCamp_a9b9aa4d:

    # dam "Here's my gun."
    dam "Aqui tá a minha arma."

# game/scripts/c32/c32.rpy:1354
translate brazilian c32s002_trainingCamp_8fcfd3d3:

    # dam "*Laugh* See, boys? You have to be gentle when you give something to a lady."
    dam "*Rindo* Viram, rapazes? Tem que ser gentil quando se dá algo a uma dama."

# game/scripts/c32/c32.rpy:1356
translate brazilian c32s002_trainingCamp_ee71ee81:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1357
translate brazilian c32s002_trainingCamp_96aef4f9:

    # "Watching [ama] shoot with no apparent effort is like watching a leopard chase a gazelle."
    "Ver a [ama] atirar sem nenhum esforço aparente é como observar um leopardo perseguir uma gazela."

# game/scripts/c32/c32.rpy:1358
translate brazilian c32s002_trainingCamp_b812fa12:

    # "Focused, making an art out of economy of movement."
    "Focada, fazendo da economia de movimentos uma verdadeira arte."

# game/scripts/c32/c32.rpy:1360
translate brazilian c32s002_trainingCamp_070f6b7f:

    # "Beautiful and deadly at the same time."
    "Linda e mortal ao mesmo tempo."

# game/scripts/c32/c32.rpy:1362
translate brazilian c32s002_trainingCamp_967be4be:

    # "Deadly."
    "Mortal."
# game/scripts/c32/c32.rpy:1364
translate brazilian c32s002_trainingCamp_ca34ba5e:

    # ama "Done. Hank, go count the scores. Please."
    ama "Pronto. Hank, vá contar os pontos. Por favor."

# game/scripts/c32/c32.rpy:1368
translate brazilian c32s002_trainingCamp_cce713a9:

    # cl1 "Yes, Ma'am."
    cl1 "Sim, Senhora."

# game/scripts/c32/c32.rpy:1370
translate brazilian c32s002_trainingCamp_7446f74b:

    # "[cl1] returns after a minute. He ran there and back. He hasn't even started sweating under the Caribbean summer sun."
    "[cl1] volta depois de um minuto. Ele correu até lá e voltou. Ele nem começou a suar sob o sol de verão do Caribe."

# game/scripts/c32/c32.rpy:1371
translate brazilian c32s002_trainingCamp_179b7413:

    # "You are drenched in sweat. Partly from the heat, partly from the nervousness of what is happening."
    "Você está encharcado de suor. Em parte pelo calor, em parte pelo nervosismo do que está acontecendo."

# game/scripts/c32/c32.rpy:1372
translate brazilian c32s002_trainingCamp_5905370c:

    # cl1 "97.5 points, [ama]. Two of the shots hit the 9 and another on the line between the 9 and the 10. The rest in the 10."
    cl1 "97,5 pontos, [ama]. Dois dos tiros acertaram o 9 e outro na linha entre o 9 e o 10. O resto no 10."

# game/scripts/c32/c32.rpy:1373
translate brazilian c32s002_trainingCamp_e45d6dd6:

    # ama "Thanks, Hank."
    ama "Obrigada, Hank."

# game/scripts/c32/c32.rpy:1374
translate brazilian c32s002_trainingCamp_acda52cf:

    # dam "*Laugh* Are you out of practice? Give me the gun."
    dam "*Risos* Você está fora de prática? Me dá a arma."

# game/scripts/c32/c32.rpy:1376
translate brazilian c32s002_trainingCamp_bc518237:

    # "[ama] unloads the gun and hands it to [dam]. You're sure that barrel must be really hot."
    "[ama] descarrega a arma e a entrega para [dam]. Você tem certeza de que o cano deve estar muito quente."

# game/scripts/c32/c32.rpy:1377
translate brazilian c32s002_trainingCamp_d5ef2e16:

    # dam "I see we taught you well. Safety first."
    dam "Vejo que te ensinamos bem. Segurança em primeiro lugar."

# game/scripts/c32/c32.rpy:1378
translate brazilian c32s002_trainingCamp_220dc0f6:

    # ama "*Whispering* You know there are 7 bullets left in that magazine, right? Don't make me say where I want to shove them right now."
    ama "*Sussurrando* Você sabe que ainda tem 7 balas nesse carregador, né? Não me faça dizer onde eu quero enfiar elas agora."

# game/scripts/c32/c32.rpy:1379
translate brazilian c32s002_trainingCamp_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."
# game/scripts/c32/c32.rpy:1381
translate brazilian c32s002_trainingCamp_263a634e:

    # "They both ignore you. [dam] checks again that the chamber is empty before pulling out a new magazine."
    "Eles dois te ignoram. [dam] verifica novamente se a câmara está vazia antes de pegar um novo carregador."

# game/scripts/c32/c32.rpy:1383
translate brazilian c32s002_trainingCamp_70ff9d7f:

    # dam "Your turn, boss..."
    dam "Sua vez, chefe..."

# game/scripts/c32/c32.rpy:1384
translate brazilian c32s002_trainingCamp_1114cc9a:

    # "He makes the gesture of handing you the gun in 'damsel mode' as he said before. You don't think it's the safest way to hand a gun to anyone."
    "Ele faz o gesto de te entregar a arma no 'modo donzela', como disse antes. Você não acha que é a maneira mais segura de entregar uma arma a alguém."

# game/scripts/c32/c32.rpy:1385
translate brazilian c32s002_trainingCamp_f2dda412:

    # dam "*Whispering* I'm going to drop the gun. Don't catch it."
    dam "*Sussurrando* Eu vou deixar a arma cair. Não tente pegar."

# game/scripts/c32/c32.rpy:1386
translate brazilian c32s002_trainingCamp_969c08b9:

    # mc "*Whispering* What?"
    mc "*Sussurrando* O quê?"

# game/scripts/c32/c32.rpy:1388
translate brazilian c32s002_trainingCamp_8d77159f:

    # "Without letting you react, [dam] discreetly drops the unloaded gun."
    "Sem deixar você reagir, [dam] discretamente deixa a arma descarregada cair."

# game/scripts/c32/c32.rpy:1389
translate brazilian c32s002_trainingCamp_b43a6143:

    # "You don't understand what's going on."
    "Você não entende o que está acontecendo."

# game/scripts/c32/c32.rpy:1391
translate brazilian c32s002_trainingCamp_80e5a899:

    # dam "Sorry, boss. My bad. I let it go before you grabbed it. I thought you'd have better reflexes."
    dam "Foi mal, chefe. Erro meu. Eu soltei antes de você pegar. Achei que você tivesse reflexos melhores."

# game/scripts/c32/c32.rpy:1392
translate brazilian c32s002_trainingCamp_19b901d1:

    # mc "Thanks?"
    mc "Valeu?"

# game/scripts/c32/c32.rpy:1393
translate brazilian c32s002_trainingCamp_4dc455aa:

    # "You don't understand what game the mercenary is playing."
    "Você não entende que joguinho o mercenário está fazendo."

# game/scripts/c32/c32.rpy:1395
translate brazilian c32s002_trainingCamp_ffa0f3d2:

    # dam "Your turn, {b}boss{/b}. Remember that the bullets come out of the hole in the front."
    dam "Sua vez, {b}chefe{/b}. Lembre-se de que as balas saem pelo buraco da frente."
# game/scripts/c32/c32.rpy:1396
translate brazilian c32s002_trainingCamp_62c6f937:

    # dam "*Whispering* Make the first shot go way off."
    dam "*Sussurrando* Faça o primeiro tiro errar feio."

# game/scripts/c32/c32.rpy:1397
translate brazilian c32s002_trainingCamp_a7583bcd:

    # dam "And that's how you hand a gun to an {b}experienced damsel{/b}, boys."
    dam "E é assim que se entrega uma arma para uma {b}donzela experiente{/b}, garotos."

# game/scripts/c32/c32.rpy:1398
translate brazilian c32s002_trainingCamp_430d4dfc:

    # dam "Don't try this with rookies. You see what can happen."
    dam "Não tentem isso com novatos. Vocês veem o que pode acontecer."

# game/scripts/c32/c32.rpy:1400
translate brazilian c32s002_trainingCamp_75aec83f:

    # "You get into the stance [eva] taught you, but this time you decide to use both hands."
    "Você entra na postura que a [eva] te ensinou, mas dessa vez decide usar as duas mãos."

# game/scripts/c32/c32.rpy:1401
translate brazilian c32s002_trainingCamp_20b86b0b:

    # "It's not just about impressing a girl, but tough mercenaries. Even if the girl there is a tough mercenary."
    "Não se trata apenas de impressionar uma garota, mas sim mercenários durões. Mesmo que a garota lá seja uma mercenária durona."

# game/scripts/c32/c32.rpy:1402
translate brazilian c32s002_trainingCamp_e0a5ff4e:

    # "And you know you're not going to get anywhere near [ama]'s score. If you even manage to hit the target from that distance, of course."
    "E você sabe que não vai chegar nem perto da pontuação da [ama]. Se você ao menos conseguir acertar o alvo daquela distância, é claro."

# game/scripts/c32/c32.rpy:1403
translate brazilian c32s002_trainingCamp_e10fbc1a:

    # "A drop of sweat runs down the back of your neck to join the sea of sweat on your back."
    "Uma gota de suor escorre pela sua nuca para se juntar ao mar de suor nas suas costas."

# game/scripts/c32/c32.rpy:1404
translate brazilian c32s002_trainingCamp_63aac271:

    # "The target looks incredibly far away."
    "O alvo parece incrivelmente longe."

# game/scripts/c32/c32.rpy:1406
translate brazilian c32s002_trainingCamp_ee71ee81_1:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1407
translate brazilian c32s002_trainingCamp_218541ad:

    # "You try to shoot low, just like [dam] told you to. Obviously, the target doesn't move."
    "Você tenta atirar baixo, exatamente como [dam] te disse. Obviamente, o alvo não se move."

# game/scripts/c32/c32.rpy:1409
translate brazilian c32s002_trainingCamp_6de95574:

    # "A dust cloud appears to the right of the target, pretty high up."
    "Uma nuvem de poeira aparece à direita do alvo, bem no alto."
# game/scripts/c32/c32.rpy:1411
translate brazilian c32s002_trainingCamp_865fa0cd:

    # dam "*Laugh* Is that the best you can do? If you ever face an army of moles, maybe you'll hit them."
    dam "*Risos* Isso é o melhor que você consegue fazer? Se você um dia enfrentar um exército de toupeiras, talvez você acerte elas."

# game/scripts/c32/c32.rpy:1412
translate brazilian c32s002_trainingCamp_e0d54415:

    # cl1 "*Laughing whisper* I don't think I've missed that miserably since I was seven."
    cl1 "*Sussurro rindo* Eu acho que não erro tão feio assim desde que eu tinha sete anos."

# game/scripts/c32/c32.rpy:1413
translate brazilian c32s002_trainingCamp_e68282f9:

    # cl2 "*Whispering* Don't lie. You were at least eight."
    cl2 "*Sussurrando* Não minta. Você tinha pelo menos oito."

# game/scripts/c32/c32.rpy:1414
translate brazilian c32s002_trainingCamp_5c2c25ff:

    # cl3 "*Whispering* Hard to believe he's the old man's original."
    cl3 "*Sussurrando* Difícil acreditar que ele é o original do velho."

# game/scripts/c32/c32.rpy:1415
translate brazilian c32s002_trainingCamp_1c899f33:

    # gid "*Whispering* Maybe he isn't used to the weight of the Glock..."
    gid "*Sussurrando* Talvez ele não esteja acostumado com o peso da Glock..."

# game/scripts/c32/c32.rpy:1417
translate brazilian c32s002_trainingCamp_1c30c8d9:

    # "This must be what [dam] wanted. To make a fool of you in front of the rest of the guys."
    "Isso deve ser o que o [dam] queria. Fazer você de idiota na frente do resto dos caras."

# game/scripts/c32/c32.rpy:1418
translate brazilian c32s002_trainingCamp_de2fa46e:

    # "You adjust your aim as best you can. With nine bullets you won't be able to reach [ama]'s score."
    "Você ajusta sua mira o melhor que pode. Com nove balas você não vai conseguir alcançar a pontuação da [ama]."

# game/scripts/c32/c32.rpy:1419
translate brazilian c32s002_trainingCamp_2d8e903d:

    # "You probably wouldn't manage it with 90 bullets."
    "Você provavelmente não conseguiria nem com 90 balas."

# game/scripts/c32/c32.rpy:1420
translate brazilian c32s002_trainingCamp_00a996b8:

    # "You focus on the target, just like [eva] taught you."
    "Você foca no alvo, do jeito que a [eva] te ensinou."

# game/scripts/c32/c32.rpy:1422
translate brazilian c32s002_trainingCamp_ee71ee81_2:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1423
translate brazilian c32s002_trainingCamp_cd78e42a:

    # "You fire the nine shots in quick succession, slightly adjusting your position between shots."
    "Você dispara os nove tiros em rápida sucessão, ajustando levemente sua posição entre os tiros."
# game/scripts/c32/c32.rpy:1424
translate brazilian c32s002_trainingCamp_e11a2b20:

    # "You could swear the dust cloud kicked up behind the target on every single one of them, but you were too focused to be sure."
    "Você poderia jurar que a nuvem de poeira subiu atrás do alvo em cada um deles, mas você estava focado demais para ter certeza."

# game/scripts/c32/c32.rpy:1427
translate brazilian c32s002_trainingCamp_df04cecb:

    # "You unload the weapon and hand it to [dam], looking him straight in the eyes defiantly."
    "Você descarrega a arma e a entrega para [dam], olhando-o diretamente nos olhos de forma desafiadora."

# game/scripts/c32/c32.rpy:1428
translate brazilian c32s002_trainingCamp_6f9d9285:

    # "You know he's won, whatever game he's playing."
    "Você sabe que ele venceu, seja lá qual for o jogo que ele está jogando."

# game/scripts/c32/c32.rpy:1429
translate brazilian c32s002_trainingCamp_4d4a0b0d:

    # mc "Done."
    mc "Pronto."

# game/scripts/c32/c32.rpy:1430
translate brazilian c32s002_trainingCamp_b4729405:

    # dam "*Laugh* Careful, don't drop the gun."
    dam "*Risos* Cuidado, não deixe a arma cair."

# game/scripts/c32/c32.rpy:1431
translate brazilian c32s002_trainingCamp_bf7c647c:

    # "Without breaking eye contact with the mercenary..."
    "Sem quebrar o contato visual com o mercenário..."

# game/scripts/c32/c32.rpy:1432
translate brazilian c32s002_trainingCamp_0f3b981c:

    # mc "[gid], can you go check the score, please?"
    mc "[gid], você pode ir checar a pontuação, por favor?"

# game/scripts/c32/c32.rpy:1434
translate brazilian c32s002_trainingCamp_dec27729:

    # "A minute later..."
    "Um minuto depois..."

# game/scripts/c32/c32.rpy:1435
translate brazilian c32s002_trainingCamp_4e8b7ccc:

    # gid "48.5, Sir. Less than half of [ama]'s."
    gid "48,5, Senhor. Menos da metade da de [ama]."

# game/scripts/c32/c32.rpy:1436
translate brazilian c32s002_trainingCamp_dbfa764d:

    # "Under any other circumstances, you'd feel proud of yourself. But you still don't understand what game [dam] is playing."
    "Sob quaisquer outras circunstâncias, você se sentiria orgulhoso de si mesmo. Mas você ainda não entende qual jogo [dam] está jogando."

# game/scripts/c32/c32.rpy:1437
translate brazilian c32s002_trainingCamp_ca327555:

    # "[ama] looks at you with disbelief and pride."
    "[ama] olha para você com descrença e orgulho."
# game/scripts/c32/c32.rpy:1439
translate brazilian c32s002_trainingCamp_85a87ecd:

    # dam "Not bad for a rookie. Especially considering you wasted the first bullet."
    dam "Nada mal para um novato. Especialmente considerando que você desperdiçou a primeira bala."

# game/scripts/c32/c32.rpy:1440
translate brazilian c32s002_trainingCamp_e8a14f9f:

    # dam "*Whispering* Don't answer."
    dam "*Sussurrando* Não responda."

# game/scripts/c32/c32.rpy:1441
translate brazilian c32s002_trainingCamp_166632e1:

    # dam "Now I'm going to show you what a real man does."
    dam "Agora eu vou te mostrar o que um homem de verdade faz."

# game/scripts/c32/c32.rpy:1442
translate brazilian c32s002_trainingCamp_dd29310d:

    # "You follow his advice and don't respond to his provocation. You think you're starting to see his game."
    "Você segue o conselho dele e não responde à provocação. Você acha que está começando a entender o jogo dele."

# game/scripts/c32/c32.rpy:1444
translate brazilian c32s002_trainingCamp_b8f2d890:

    # dam "Pay attention, boys. Watch how it's done."
    dam "Prestem atenção, garotos. Vejam como se faz."

# game/scripts/c32/c32.rpy:1446
translate brazilian c32s002_trainingCamp_f75f79fc:

    # ama "*Whispering* I feel like killing him right now. Where's a Bradley when you need one?"
    ama "*Sussurrando* Eu tô com vontade de matar ele agora mesmo. Cadê um Bradley quando a gente precisa?"

# game/scripts/c32/c32.rpy:1447
translate brazilian c32s002_trainingCamp_efeb9587:

    # mc "*Whispering* I'm not sure yet, but I think there's more to this than what we can see."
    mc "*Sussurrando* Não tenho certeza ainda, mas acho que tem mais nisso do que podemos ver."

# game/scripts/c32/c32.rpy:1448
translate brazilian c32s002_trainingCamp_9814655f:

    # ama "*Whispering* [dam] is pretty simple. I don't think he's thought of anything complicated."
    ama "*Sussurrando* O [dam] é bem simples. Não acho que ele tenha pensado em nada complicado."

# game/scripts/c32/c32.rpy:1449
translate brazilian c32s002_trainingCamp_b267efde:

    # mc "*Whispering* Give him the benefit of the doubt..."
    mc "*Sussurrando* Dê a ele o benefício da dúvida..."

# game/scripts/c32/c32.rpy:1451
translate brazilian c32s002_trainingCamp_07a1dfb7:

    # "[dam] gets into a one-handed shooting stance."
    "[dam] entra em uma postura de tiro com uma mão."

# game/scripts/c32/c32.rpy:1452
translate brazilian c32s002_trainingCamp_2e83baa6:

    # "It's clear he's showing off in front of the other clones."
    "Fica claro que ele está se exibindo na frente dos outros clones."
# game/scripts/c32/c32.rpy:1454
translate brazilian c32s002_trainingCamp_ee71ee81_3:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1455
translate brazilian c32s002_trainingCamp_b2b3e98a:

    # "He fires the first bullet."
    "Ele dispara a primeira bala."

# game/scripts/c32/c32.rpy:1457
translate brazilian c32s002_trainingCamp_4ce8d8ce:

    # "The dust cloud rises far from the target, in a position similar to your first shot."
    "A nuvem de poeira sobe longe do alvo, em uma posição semelhante ao seu primeiro tiro."

# game/scripts/c32/c32.rpy:1458
translate brazilian c32s002_trainingCamp_546b9e13:

    # "Now you understand his game perfectly."
    "Agora você entende o joguinho dele perfeitamente."

# game/scripts/c32/c32.rpy:1460
translate brazilian c32s002_trainingCamp_ee71ee81_4:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1461
translate brazilian c32s002_trainingCamp_97d3991b:

    # "He fires for the second time."
    "Ele atira pela segunda vez."

# game/scripts/c32/c32.rpy:1463
translate brazilian c32s002_trainingCamp_1eecee43:

    # "The cloud rises in exactly the same spot."
    "A nuvem sobe exatamente no mesmo lugar."

# game/scripts/c32/c32.rpy:1465
translate brazilian c32s002_trainingCamp_ee71ee81_5:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1466
translate brazilian c32s002_trainingCamp_e69bc401:

    # "He fires for the third time."
    "Ele atira pela terceira vez."

# game/scripts/c32/c32.rpy:1468
translate brazilian c32s002_trainingCamp_70ae0ece:

    # "This time, the dust cloud rises behind the target."
    "Desta vez, a nuvem de poeira sobe atrás do alvo."

# game/scripts/c32/c32.rpy:1470
translate brazilian c32s002_trainingCamp_d7da26e2:

    # dam "[cl2], give me your gun. I think my sight got misaligned when the boss dropped it."
    dam "[cl2], me dá a sua arma. Acho que a minha mira desregulou quando o chefe a derrubou."
# game/scripts/c32/c32.rpy:1471
translate brazilian c32s002_trainingCamp_0daa77dc:

    # dam "I have to correct my aim down and to the left."
    dam "Tenho que corrigir minha mira para baixo e para a esquerda."

# game/scripts/c32/c32.rpy:1473
translate brazilian c32s002_trainingCamp_ebb93b56:

    # "After swapping guns, he returns to the shooting position."
    "Depois de trocar de arma, ele volta à posição de tiro."

# game/scripts/c32/c32.rpy:1475
translate brazilian c32s002_trainingCamp_ee71ee81_6:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1476
translate brazilian c32s002_trainingCamp_c4ac4da5:

    # "He fires seven shots, one after the other."
    "Ele dá sete tiros, um atrás do outro."

# game/scripts/c32/c32.rpy:1478
translate brazilian c32s002_trainingCamp_dbbbf1aa:

    # dam "That's better. I'll have to check my gun when we get back to the outpost."
    dam "Melhorou. Vou ter que checar minha arma quando voltarmos para o posto avançado."

# game/scripts/c32/c32.rpy:1479
translate brazilian c32s002_trainingCamp_2f23ab16:

    # dam "[cl3], go check the scores. With only 8 good shots, I couldn't have caught up to [ama]."
    dam "[cl3], vá checar as pontuações. Com apenas 8 tiros bons, eu não conseguiria alcançar a [ama]."

# game/scripts/c32/c32.rpy:1481
translate brazilian c32s002_trainingCamp_904e2706:

    # "After a couple of minutes..."
    "Depois de alguns minutos..."

# game/scripts/c32/c32.rpy:1482
translate brazilian c32s002_trainingCamp_a122138c:

    # cl3 "62 points, [dam]. One of the first three shots hit the target, but... on the one. It must have been the third shot."
    cl3 "62 pontos, [dam]. Um dos três primeiros tiros acertou o alvo, mas... no um. Deve ter sido o terceiro tiro."

# game/scripts/c32/c32.rpy:1483
translate brazilian c32s002_trainingCamp_96dbd380:

    # cl3 "Of the rest, one ten, three nines, and three eights."
    cl3 "Do resto, um dez, três noves e três oitos."

# game/scripts/c32/c32.rpy:1485
translate brazilian c32s002_trainingCamp_3b69c48a:

    # dam "[cl2], I'm keeping your weapon. It seems a bit off too. I'll take a look at it."
    dam "[cl2], vou ficar com a sua arma. Parece um pouco desregulada também. Vou dar uma olhada."

# game/scripts/c32/c32.rpy:1486
translate brazilian c32s002_trainingCamp_516803cc:

    # dam "I didn't beat [ama], but it's clear I'm several levels above the... {b}boss{/b}."
    dam "Eu não ganhei da [ama], mas está claro que estou vários níveis acima do... {b}chefe{/b}."
# game/scripts/c32/c32.rpy:1488
translate brazilian c32s002_trainingCamp_3f2ce5d4:

    # gid "Don't be unfair, [dam]. With your faulty gun, he scored... more than five points per shot once he adjusted."
    gid "Não seja injusto, [dam]. Com a sua arma defeituosa, ele marcou... mais de cinco pontos por tiro depois que se ajustou."

# game/scripts/c32/c32.rpy:1489
translate brazilian c32s002_trainingCamp_333527c6:

    # gid "And he only needed one shot to adjust. You used two and got a miserable one on the third."
    gid "E ele só precisou de um tiro para se ajustar. Você usou dois e conseguiu um mísero ponto no terceiro."

# game/scripts/c32/c32.rpy:1491
translate brazilian c32s002_trainingCamp_05887a0a:

    # dam "I think I'm going to make you run laps when we get back to the outpost. But you're {b}somewhat{/b} right."
    dam "Acho que vou fazer você dar umas voltas correndo quando voltarmos pro posto avançado. Mas você tem {b}um pouco{/b} de razão."

# game/scripts/c32/c32.rpy:1492
translate brazilian c32s002_trainingCamp_bcc1a34b:

    # dam "Luckily, his role isn't to fight, but to make decisions."
    dam "Por sorte, o papel dele não é lutar, mas tomar decisões."

# game/scripts/c32/c32.rpy:1494
translate brazilian c32s002_trainingCamp_84e0fe8c:

    # dam "We're heading back to base, guys. I think the boss has earned the right to ride up front with me."
    dam "Estamos voltando pra base, pessoal. Acho que o chefe ganhou o direito de ir na frente comigo."

# game/scripts/c32/c32.rpy:1495
translate brazilian c32s002_trainingCamp_10c8e61e:

    # dam "You guys ride in the back like damsels. And no causing trouble. The deadliest damsel on the base will be watching you."
    dam "Vocês vão atrás como donzelas. E sem arrumar confusão. A donzela mais mortal da base vai estar de olho em vocês."

# game/scripts/c32/c32.rpy:1498
translate brazilian c32s002_trainingCamp_895151c4:

    # "In the truck..."
    "No caminhão..."

# game/scripts/c32/c32.rpy:1499
translate brazilian c32s002_trainingCamp_a60ad23a:

    # mc "*Whispering* Why, [dam]?"
    mc "*Sussurrando* Por que, [dam]?"

# game/scripts/c32/c32.rpy:1500
translate brazilian c32s002_trainingCamp_67852316:

    # dam "Why what?"
    dam "Por que o quê?"

# game/scripts/c32/c32.rpy:1501
translate brazilian c32s002_trainingCamp_5e7c2edc:

    # mc "*Whispering* Why did you put on that act with the gun dropping?"
    mc "*Sussurrando* Por que você fez aquele teatrinho de deixar a arma cair?"

# game/scripts/c32/c32.rpy:1503
translate brazilian c32s002_trainingCamp_3f1c365c:

    # dam "No need to whisper. You can't hear anything back there."
    dam "Não precisa sussurrar. Não dá pra ouvir nada lá atrás."
# game/scripts/c32/c32.rpy:1504
translate brazilian c32s002_trainingCamp_ab518dac:

    # dam "[ama] told me that [eva] had been teaching you, and I wanted to see how good you were."
    dam "A [ama] me disse que a [eva] estava te ensinando, e eu queria ver o quão bom você era."

# game/scripts/c32/c32.rpy:1506
translate brazilian c32s002_trainingCamp_00bd99ba:

    # dam "I knew someone was going to challenge you sooner or later. Why not me?"
    dam "Eu sabia que alguém ia te desafiar mais cedo ou mais tarde. Por que não eu?"

# game/scripts/c32/c32.rpy:1507
translate brazilian c32s002_trainingCamp_78556c65:

    # dam "Everyone says us D's are show-offs, not too bright, and have problems with authority. So I was a good choice."
    dam "Todo mundo diz que nós, os D's, somos exibidos, não muito espertos e temos problemas com autoridade. Então eu fui uma boa escolha."

# game/scripts/c32/c32.rpy:1509
translate brazilian c32s002_trainingCamp_8f252dd6:

    # dam "*Laugh* But I couldn't make a fool out of you in front of the guys."
    dam "*Risos* Mas eu não podia te fazer de idiota na frente dos caras."

# game/scripts/c32/c32.rpy:1510
translate brazilian c32s002_trainingCamp_4d505fd7:

    # dam "They would have lost respect for you."
    dam "Eles teriam perdido o respeito por você."

# game/scripts/c32/c32.rpy:1511
translate brazilian c32s002_trainingCamp_313980c0:

    # mc "But you knew I couldn't match [ama]..."
    mc "Mas você sabia que eu não conseguiria bater de frente com a [ama]..."

# game/scripts/c32/c32.rpy:1513
translate brazilian c32s002_trainingCamp_88d2c2dc:

    # dam "Not you, not me, not anyone, except [eva]. And the other girls, of course. But they're not here anymore."
    dam "Nem você, nem eu, nem ninguém, exceto a [eva]. E as outras garotas, claro. Mas elas não estão mais aqui."

# game/scripts/c32/c32.rpy:1514
translate brazilian c32s002_trainingCamp_8d14edb3:

    # dam "Do you know anything about basketball?"
    dam "Você sabe alguma coisa sobre basquete?"

# game/scripts/c32/c32.rpy:1515
translate brazilian c32s002_trainingCamp_54eef042:

    # mc "A little..."
    mc "Um pouco..."

# game/scripts/c32/c32.rpy:1517
translate brazilian c32s002_trainingCamp_c48eac61:

    # dam "You'd be a high school player. You wouldn't be the star of your team, but from what I've seen today, you'd be good."
    dam "Você seria um jogador de ensino médio. Não seria a estrela do seu time, mas pelo que vi hoje, você seria bom."

# game/scripts/c32/c32.rpy:1518
translate brazilian c32s002_trainingCamp_5b3bd0f8:

    # dam "If you trained your ass off, you might make it to the NCAA."
    dam "Se você treinasse pra caralho, talvez chegasse na NCAA."
# game/scripts/c32/c32.rpy:1519
translate brazilian c32s002_trainingCamp_77b0e51f:

    # dam "A regular soldier would be a decent NCAA player."
    dam "Um soldado comum seria um jogador decente da NCAA."

# game/scripts/c32/c32.rpy:1520
translate brazilian c32s002_trainingCamp_ac74606f:

    # dam "SEALs, Green Berets, and the like would be NBA players. Some starters, some benchwarmers."
    dam "SEALs, Boinas Verdes e afins seriam jogadores da NBA. Alguns titulares, alguns esquenta-bancos."

# game/scripts/c32/c32.rpy:1521
translate brazilian c32s002_trainingCamp_46ba947d:

    # dam "Most of us clones would be the star players of our NBA teams."
    dam "A maioria de nós, clones, seríamos os astros dos nossos times da NBA."

# game/scripts/c32/c32.rpy:1523
translate brazilian c32s002_trainingCamp_e0028ce1:

    # dam "[ama] and [eva] are like if Kareem, Magic, Michael, Larry, Lebron, and Kobe had a crazy night of sex and gave birth to them."
    dam "A [ama] e a [eva] são como se o Kareem, Magic, Michael, Larry, Lebron e o Kobe tivessem uma noite louca de sexo e dessem à luz a elas."

# game/scripts/c32/c32.rpy:1524
translate brazilian c32s002_trainingCamp_b701ed4e:

    # mc "Are they really that good? I know they're good, but..."
    mc "Elas são tão boas assim? Eu sei que elas são boas, mas..."

# game/scripts/c32/c32.rpy:1526
translate brazilian c32s002_trainingCamp_1ca4d774:

    # dam "Good? They're the best there is in the killing business."
    dam "Boas? Elas são as melhores que existem no negócio de matar."

# game/scripts/c32/c32.rpy:1527
translate brazilian c32s002_trainingCamp_1df0d75f:

    # dam "They know how to do everything, and they do it well. I promise you I tried my hardest on those last seven shots."
    dam "Elas sabem fazer de tudo, e fazem bem. Eu te garanto que dei o meu melhor naqueles últimos sete tiros."

# game/scripts/c32/c32.rpy:1528
translate brazilian c32s002_trainingCamp_33b00cd1:

    # dam "I'm good, and I didn't even average a 9. [ama] did it almost perfectly."
    dam "Eu sou bom, e nem consegui uma média de 9. A [ama] fez quase perfeitamente."

# game/scripts/c32/c32.rpy:1530
translate brazilian c32s002_trainingCamp_21a1ff26:

    # dam "Olympic shooter level. But she could do the same with a rifle, a knife, or a grenade launcher. An Olympic shooter couldn't."
    dam "Nível de atirador olímpico. Mas ela conseguiria fazer o mesmo com um rifle, uma faca ou um lança-granadas. Um atirador olímpico não conseguiria."

# game/scripts/c32/c32.rpy:1531
translate brazilian c32s002_trainingCamp_06b407f6:

    # dam "They also couldn't fly a plane or a helicopter like [eva], or design an improvised defense post like [ama]."
    dam "Eles também não conseguiriam pilotar um avião ou um helicóptero como a [eva], ou projetar um posto de defesa improvisado como a [ama]."

# game/scripts/c32/c32.rpy:1532
translate brazilian c32s002_trainingCamp_b2e12b56:

    # dam "Although with a grenade launcher I'd probably beat them. Both of them and the Olympic shooter."
    dam "Embora com um lança-granadas eu provavelmente ganharia delas. Das duas e do atirador olímpico."
# game/scripts/c32/c32.rpy:1533
translate brazilian c32s002_trainingCamp_ce4f99cf:

    # mc "*Laugh* And we'd have to change the targets after every shot."
    mc "*Risos* E a gente teria que trocar os alvos depois de cada tiro."

# game/scripts/c32/c32.rpy:1535
translate brazilian c32s002_trainingCamp_567cf30e:

    # dam "*Laugh* I like your sense of humor. I think it's the first time I've heard you laugh."
    dam "*Risos* Eu gosto do seu senso de humor. Acho que é a primeira vez que te ouço rir."

# game/scripts/c32/c32.rpy:1536
translate brazilian c32s002_trainingCamp_9732a5e6:

    # mc "But you still haven't told me why. That thing about wanting to see how good I was, I don't buy it."
    mc "Mas você ainda não me disse o porquê. Aquela história de querer ver o quão bom eu era, eu não engulo essa."

# game/scripts/c32/c32.rpy:1537
translate brazilian c32s002_trainingCamp_b43ddd82:

    # mc "You could have asked me to go together and... test me."
    mc "Você poderia ter me chamado pra irmos juntos e... me testar."

# game/scripts/c32/c32.rpy:1539
translate brazilian c32s002_trainingCamp_bb501a4f:

    # dam "You don't get it. I already told you someone had to challenge you sooner or later."
    dam "Você não entende. Eu já te disse que alguém teria que te desafiar mais cedo ou mais tarde."

# game/scripts/c32/c32.rpy:1540
translate brazilian c32s002_trainingCamp_8d01d0d8:

    # dam "Ever since we had the meeting and saw you with [aar], we know whose clone the old man is. And the guys are starting to talk about it."
    dam "Desde que tivemos a reunião e vimos você com o [aar], nós sabemos de quem o velho é clone. E os caras estão começando a falar sobre isso."

# game/scripts/c32/c32.rpy:1541
translate brazilian c32s002_trainingCamp_5a2df039:

    # dam "The old man was really good on the range back there."
    dam "O velho era muito bom no estande de tiro lá atrás."

# game/scripts/c32/c32.rpy:1543
translate brazilian c32s002_trainingCamp_46c5f32f:

    # dam "Besides, you were at [gav]'s surgery. Someone saw you leave the waiting room last."
    dam "Além disso, você estava na cirurgia do [gav]. Alguém viu você sair da sala de espera por último."

# game/scripts/c32/c32.rpy:1544
translate brazilian c32s002_trainingCamp_43d5c0b9:

    # dam "You were in there alone for over 20 minutes."
    dam "Você ficou lá sozinho por mais de 20 minutos."

# game/scripts/c32/c32.rpy:1545
translate brazilian c32s002_trainingCamp_12e114a8:

    # mc "I wanted to talk to [bet], the surgeon. Not just because she's my aunt and I wanted to know how she was doing."
    mc "Eu queria falar com a [bet], a cirurgiã. Não só porque ela é minha tia e eu queria saber como ela estava."

# game/scripts/c32/c32.rpy:1546
translate brazilian c32s002_trainingCamp_2cd1eb53:

    # mc "I also wanted to know details about [gav]. Not just an 'Everything went as expected.'"
    mc "Eu também queria saber detalhes sobre o [gav]. Não só um 'Tudo correu como o esperado'."
# game/scripts/c32/c32.rpy:1547
translate brazilian c32s002_trainingCamp_e5757408:

    # dam "That's what I mean."
    dam "É isso que eu quero dizer."

# game/scripts/c32/c32.rpy:1549
translate brazilian c32s002_trainingCamp_b5c17d6e:

    # dam "And besides, you realized that [dec] wasn't me. How did you know? You only saw me for an hour in a meeting."
    dam "E além disso, você percebeu que [dec] não era eu. Como você sabia? Você só me viu por uma hora em uma reunião."

# game/scripts/c32/c32.rpy:1550
translate brazilian c32s002_trainingCamp_8f695b74:

    # mc "I don't know. I knew it wasn't you a second after saying your name."
    mc "Eu não sei. Eu soube que não era você um segundo depois de dizer o seu nome."

# game/scripts/c32/c32.rpy:1551
translate brazilian c32s002_trainingCamp_e2ba9e50:

    # dam "And is that important to you?"
    dam "E isso é importante pra você?"

# game/scripts/c32/c32.rpy:1552
translate brazilian c32s002_trainingCamp_4c9a4f2c:

    # mc "Of course it is. I said you aren't slaves. You're just as human as I am, and you have to maintain your individuality."
    mc "Claro que é. Eu disse que vocês não são escravos. Vocês são tão humanos quanto eu, e têm que manter a sua individualidade."

# game/scripts/c32/c32.rpy:1553
translate brazilian c32s002_trainingCamp_e04bcd7e:

    # mc "And I have to be the first to treat you as individuals."
    mc "E eu tenho que ser o primeiro a tratar vocês como indivíduos."

# game/scripts/c32/c32.rpy:1555
translate brazilian c32s002_trainingCamp_7f7be5ed:

    # dam "Do you know what Daniels called me after more than 15 years of seeing me almost every day?"
    dam "Sabe como o Daniels me chamava depois de mais de 15 anos me vendo quase todo dia?"

# game/scripts/c32/c32.rpy:1556
translate brazilian c32s002_trainingCamp_cc761816:

    # mc "No..."
    mc "Não..."

# game/scripts/c32/c32.rpy:1558
translate brazilian c32s002_trainingCamp_bcd9ff64:

    # dam "*Faking a derogatory tone* 'Hey, you. That D over there.'"
    dam "*Fingindo um tom depreciativo* 'Ei, você. Aquele D ali.'"

# game/scripts/c32/c32.rpy:1559
translate brazilian c32s002_trainingCamp_525ea951:

    # mc "I'm not Daniels."
    mc "Eu não sou o Daniels."

# game/scripts/c32/c32.rpy:1561
translate brazilian c32s002_trainingCamp_888ebbb1:

    # dam "I know. You proved it the other day at the meeting and you've proved it today. That's why I want to help you."
    dam "Eu sei. Você provou isso no outro dia na reunião e provou hoje. É por isso que eu quero te ajudar."
# game/scripts/c32/c32.rpy:1562
translate brazilian c32s002_trainingCamp_3df83acc:

    # dam "Daniels would have come in a suit and wouldn't have accepted the shooting range challenge."
    dam "O Daniels teria vindo de terno e não teria aceitado o desafio no estande de tiro."

# game/scripts/c32/c32.rpy:1563
translate brazilian c32s002_trainingCamp_6c3949fc:

    # dam "And he wouldn't have known that [dec] wasn't me."
    dam "E ele não saberia que o [dec] não era eu."

# game/scripts/c32/c32.rpy:1564
translate brazilian c32s002_trainingCamp_528348ad:

    # mc "*Laugh* Well, [dec] didn't ask me for a Ferrarini."
    mc "*Risos* Bom, o [dec] não me pediu uma Ferrarini."

# game/scripts/c32/c32.rpy:1566
translate brazilian c32s002_trainingCamp_8be9b251:

    # dam "*Laugh* I told you I liked your sense of humor. I think I'm going to regret saying that."
    dam "*Risos* Eu te disse que gostava do seu senso de humor. Acho que vou me arrepender de ter dito isso."

# game/scripts/c32/c32.rpy:1567
translate brazilian c32s002_trainingCamp_25ef46ee:

    # dam "But back to my point. You're different from Daniels, even though you'll never be one of us."
    dam "Mas voltando ao meu ponto. Você é diferente do Daniels, mesmo que nunca vá ser um de nós."

# game/scripts/c32/c32.rpy:1569
translate brazilian c32s002_trainingCamp_ef9c9507:

    # dam "But you carry [aar]'s genes and you try to fit in with us. You listen to us and show that you care about us."
    dam "Mas você carrega os genes do [aar] e tenta se enturmar com a gente. Você nos escuta e mostra que se importa com a gente."

# game/scripts/c32/c32.rpy:1570
translate brazilian c32s002_trainingCamp_09460c0a:

    # dam "Those guys back there will say you almost kicked my ass at the shooting range with a defective gun."
    dam "Aqueles caras lá atrás vão dizer que você quase me deu um pau no estande de tiro com uma arma defeituosa."

# game/scripts/c32/c32.rpy:1572
translate brazilian c32s002_trainingCamp_4bebf0f9:

    # dam "Even though I beat you with my seven bullets against your nine. But they're going to exaggerate and, in a few days, someone will say you scored 70 points."
    dam "Mesmo eu tendo ganhado de você com as minhas sete balas contra as suas nove. Mas eles vão exagerar e, em alguns dias, alguém vai dizer que você fez 70 pontos."

# game/scripts/c32/c32.rpy:1573
translate brazilian c32s002_trainingCamp_8d5f9a05:

    # dam "At least no one is dumb enough to say you beat [ama]. No one would believe that."
    dam "Pelo menos ninguém é burro o suficiente pra dizer que você ganhou da [ama]. Ninguém acreditaria nisso."

# game/scripts/c32/c32.rpy:1574
translate brazilian c32s002_trainingCamp_6dd6f2ee:

    # mc "They could have noticed you playing tricks."
    mc "Eles poderiam ter percebido você trapaceando."

# game/scripts/c32/c32.rpy:1576
translate brazilian c32s002_trainingCamp_c007af19:

    # dam "The G's, except for [gav] and Grant, aren't very smart. I knew [gid] was predisposed to support you because he saw you in the waiting room."
    dam "Os G's, exceto o [gav] e o Grant, não são muito espertos. Eu sabia que o [gid] tava predisposto a te apoiar porque ele te viu na sala de espera."
# game/scripts/c32/c32.rpy:1577
translate brazilian c32s002_trainingCamp_4ba72e84:

    # dam "The H's are a bit smarter, but the moment [gid] fell into the trap, they followed him."
    dam "Os H's são um pouco mais espertos, mas no momento em que [gid] caiu na armadilha, eles o seguiram."

# game/scripts/c32/c32.rpy:1579
translate brazilian c32s002_trainingCamp_e4a5568d:

    # dam "Gear gets fucked up in the field every day, and the guys know it. It's easier to think about that than me helping you."
    dam "O equipamento dá merda no campo todo dia, e os caras sabem disso. É mais fácil pensar nisso do que em mim ajudando você."

# game/scripts/c32/c32.rpy:1580
translate brazilian c32s002_trainingCamp_44d390b5:

    # dam "You're not going to have to prove anything to anyone else."
    dam "Você não vai ter que provar nada pra mais ninguém."

# game/scripts/c32/c32.rpy:1581
translate brazilian c32s002_trainingCamp_39e82539:

    # mc "Yes. I'm going to have to prove that everything you said is true. And I plan to do it."
    mc "Sim. Eu vou ter que provar que tudo que você disse é verdade. E eu planejo fazer isso."

# game/scripts/c32/c32.rpy:1583
translate brazilian c32s002_trainingCamp_c284c804:

    # dam "*Laugh* You better. Remember I'm the one who knows how to use grenade launchers and cannons."
    dam "*Risos* É bom mesmo. Lembra que sou eu quem sabe usar lança-granadas e canhões."

# game/scripts/c32/c32.rpy:1584
translate brazilian c32s002_trainingCamp_2ebf26db:

    # mc "*Laugh* If you attack me with that, I won't give you the Ferrarini."
    mc "*Risos* Se você me atacar com isso, eu não te dou a Ferrarini."

# game/scripts/c32/c32.rpy:1586
translate brazilian c32s002_trainingCamp_e2564258:

    # dam "What? You're going to give me the Ferrarini?"
    dam "O quê? Você vai me dar a Ferrarini?"

# game/scripts/c32/c32.rpy:1587
translate brazilian c32s002_trainingCamp_50d089ac:

    # mc "*Laugh* Nope."
    mc "*Risos* Não."

# game/scripts/c32/c32.rpy:1589
translate brazilian c32s002_trainingCamp_79bfddef:

    # dam "*Grunt* I hate your sense of humor."
    dam "*Grunhido* Eu odeio seu senso de humor."

# game/scripts/c32/c32.rpy:1593
translate brazilian c32s002_choices_94fcc3b1:

    # centered "{size=+20}{b}DAY 44 – WEDNESDAY{/b}{/size}"
    centered "{size=+20}{b}DIA 44 – QUARTA-FEIRA{/b}{/size}"

# game/scripts/c32/c32.rpy:1595
translate brazilian c32s002_choices_31e7a1d4:

    # mcp "(Tomorrow marks a week since I arrived in Aruba.)"
    mcp "(Amanhã faz uma semana que cheguei em Aruba.)"
# game/scripts/c32/c32.rpy:1596
translate brazilian c32s002_choices_6b1bf788:

    # mcp "(There's a ton of things to do, but I have to take it one step at a time.)"
    mcp "(Tem coisa pra caralho pra fazer, mas tenho que ir um passo de cada vez.)"

# game/scripts/c32/c32.rpy:1598
translate brazilian c32s002_choices_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c32/c32.rpy:1599
translate brazilian c32s002_choices_3e597b1c:

    # mc "Come in, [ama]."
    mc "Pode entrar, [ama]."

# game/scripts/c32/c32.rpy:1601
translate brazilian c32s002_choices_ddb8a5e8:

    # ama "You know it's creepy when you do that, right?"
    ama "Você sabe que é meio bizarro quando você faz isso, né?"

# game/scripts/c32/c32.rpy:1602
translate brazilian c32s002_choices_05bc6133:

    # mc "Do what?"
    mc "Faço o quê?"

# game/scripts/c32/c32.rpy:1603
translate brazilian c32s002_choices_60e2acf7:

    # ama "Know who's knocking on the door just by how their knuckles sound on the wood."
    ama "Saber quem tá batendo na porta só pelo som dos nós dos dedos na madeira."

# game/scripts/c32/c32.rpy:1604
translate brazilian c32s002_choices_f8a95736:

    # mc "It makes sense. You're soft, though not as much as [car]. [vin] is shy. [flo] and [mael] are assertive, but in different ways."
    mc "Faz sentido. Você bate suave, embora não tanto quanto a [car]. O [vin] é tímido. O [flo] e o [mael] são assertivos, mas de jeitos diferentes."

# game/scripts/c32/c32.rpy:1605
translate brazilian c32s002_choices_9acceccf:

    # mc "And [aar] never knocks."
    mc "E o [aar] nunca bate."

# game/scripts/c32/c32.rpy:1606
translate brazilian c32s002_choices_5044cb74:

    # mc "No one else visits me, except [geo] from IT. And I can hear his voice from here when he asks [car] if I'm around."
    mc "Ninguém mais me visita, exceto o [geo] da TI. E eu consigo ouvir a voz dele daqui quando ele pergunta pra [car] se eu tô por aqui."

# game/scripts/c32/c32.rpy:1608
translate brazilian c32s002_choices_84d8ad22:

    # ama "You look overwhelmed. Did something happen?"
    ama "Você parece sobrecarregado. Aconteceu alguma coisa?"

# game/scripts/c32/c32.rpy:1609
translate brazilian c32s002_choices_a2bfa642:

    # mc "[vin] and his tiny hands just left. This morning he sent me the three reports I asked for the other day."
    mc "O [vin] e as mãozinhas dele acabaram de sair. Hoje de manhã ele me mandou os três relatórios que eu pedi no outro dia."
# game/scripts/c32/c32.rpy:1611
translate brazilian c32s002_choices_65e9afd8:

    # ama "That's more efficient than I expected... Why are you like this, then?"
    ama "Isso é mais eficiente do que eu esperava... Por que você está assim, então?"

# game/scripts/c32/c32.rpy:1612
translate brazilian c32s002_choices_e1821513:

    # mc "Because I've been looking at the numbers, and I don't think I'll be able to meet the expectations set during the meeting with the operatives."
    mc "Porque eu estive olhando os números, e não acho que vou conseguir atender às expectativas criadas durante a reunião com as agentes."

# game/scripts/c32/c32.rpy:1613
translate brazilian c32s002_choices_d004ed67:

    # mc "There's not enough money to do it all, and they're not going to be happy. I have to leave out one of the promises we made."
    mc "Não tem dinheiro suficiente para fazer tudo, e elas não vão ficar felizes. Vou ter que deixar de lado uma das promessas que fizemos."

# game/scripts/c32/c32.rpy:1615
translate brazilian c32s002_choices_6d115153:

    # ama "If I can help... Explain the situation to me."
    ama "Se eu puder ajudar... Me explica a situação."

# game/scripts/c32/c32.rpy:1616
translate brazilian c32s002_choices_687a3364:

    # ama "You already gave them personal style and the ability to leave the base. The first ones will go out this weekend."
    ama "Você já deu a elas estilo pessoal e a capacidade de sair da base. As primeiras vão sair neste fim de semana."

# game/scripts/c32/c32.rpy:1617
translate brazilian c32s002_choices_757c50f3:

    # mc "But there are still prosthetics, salaries, back pay, potential contract terminations, internal promotions, and passports."
    mc "Mas ainda tem as próteses, salários, pagamentos atrasados, possíveis rescisões de contrato, promoções internas e passaportes."

# game/scripts/c32/c32.rpy:1619
translate brazilian c32s002_choices_cffed37b:

    # ama "Well, I don't think we know the cost of each of those things."
    ama "Bom, eu não acho que a gente saiba o custo de cada uma dessas coisas."

# game/scripts/c32/c32.rpy:1620
translate brazilian c32s002_choices_e2352b74:

    # mc "Oh, yes! We do know. There are some tiny hands that type very fast."
    mc "Ah, sim! Nós sabemos. Tem umas mãozinhas que digitam muito rápido."

# game/scripts/c32/c32.rpy:1622
translate brazilian c32s002_choices_860b0df6:

    # "You're having a hard time concentrating with the new blouse [ama] is wearing. Did her tits grow in the last three days?"
    "Você está tendo dificuldade em se concentrar com a blusa nova que a [ama] está usando. Os peitos dela cresceram nos últimos três dias?"

# game/scripts/c32/c32.rpy:1624
translate brazilian c32s002_choices_3942ae45:

    # ama "The passport issue too?"
    ama "A questão dos passaportes também?"

# game/scripts/c32/c32.rpy:1625
translate brazilian c32s002_choices_0b7cfa00:

    # mc "Yeah. I talked to [flo] to see if he could think of anything, since he has contacts with foreign governments."
    mc "É. Eu falei com o [flo] pra ver se ele conseguia pensar em algo, já que ele tem contatos com governos estrangeiros."
# game/scripts/c32/c32.rpy:1626
translate brazilian c32s002_choices_4556bcda:

    # mc "He gave [vin] the numbers on what it's going to cost us... in bribes."
    mc "Ele deu ao [vin] os números de quanto isso vai nos custar... em propinas."

# game/scripts/c32/c32.rpy:1627
translate brazilian c32s002_choices_40942838:

    # mc "And as for the rest, [vin] has made an estimate. And we can't afford it all."
    mc "E quanto ao resto, o [vin] fez uma estimativa. E não temos como pagar tudo."

# game/scripts/c32/c32.rpy:1628
translate brazilian c32s002_choices_38cf63f7:

    # mc "If only I knew how it would affect the operatives' opinion if I break each of these promises..."
    mc "Se eu ao menos soubesse como isso afetaria a opinião dos agentes se eu quebrar cada uma dessas promessas..."

# game/scripts/c32/c32.rpy:1630
translate brazilian c32s002_choices_2c4da2b2:

    # ama "I think I can help you with that. After all, I'm just another operative... or I was until a few months ago."
    ama "Acho que posso te ajudar com isso. Afinal, sou só mais uma agente... ou era até uns meses atrás."

# game/scripts/c32/c32.rpy:1631
translate brazilian c32s002_choices_51ef8059:

    # ama "If I had to rate from one to ten how much unhappiness each promise you leave out creates..."
    ama "Se eu tivesse que dar uma nota de um a dez sobre quanta insatisfação cada promessa não cumprida gera..."

# game/scripts/c32/c32.rpy:1633
translate brazilian c32s002_choices_9b0e52c3:

    # ama "The prosthetics would be a 9 for those who need them, but a 1 for the rest."
    ama "As próteses seriam um 9 para quem precisa, mas um 1 para o resto."

# game/scripts/c32/c32.rpy:1634
translate brazilian c32s002_choices_455ef5af:

    # ama "If we're going to stop doing dangerous missions, they're going to think they'll never need them."
    ama "Se vamos parar de fazer missões perigosas, eles vão achar que nunca vão precisar delas."

# game/scripts/c32/c32.rpy:1635
translate brazilian c32s002_choices_aba4f93f:

    # ama "So I'd say a 3 overall."
    ama "Então eu diria um 3 no geral."

# game/scripts/c32/c32.rpy:1636
translate brazilian c32s002_choices_6105f3e2:

    # mc "That helps. I hadn't thought of it that way."
    mc "Isso ajuda. Eu não tinha pensado por esse lado."

# game/scripts/c32/c32.rpy:1637
translate brazilian c32s002_choices_f003b06f:

    # mc "But it would suck to leave [cal] without his prosthetic. He worked hard on [gav]'s."
    mc "Mas seria uma merda deixar o [cal] sem a prótese dele. Ele deu um duro danado na do [gav]."

# game/scripts/c32/c32.rpy:1638
translate brazilian c32s002_choices_399fde01:

    # ama "That's why I don't envy your job. These aren't easy decisions."
    ama "É por isso que não invejo o seu trabalho. Não são decisões fáceis."

# game/scripts/c32/c32.rpy:1640
translate brazilian c32s002_choices_8e984af3:

    # mc "What if we leave the salary out?"
    mc "E se a gente deixar o salário de fora?"

# game/scripts/c32/c32.rpy:1641
translate brazilian c32s002_choices_0dc6f52f:

    # ama "They'd probably jump at your throat. A 10, for sure. For everyone."
    ama "Eles provavelmente pulariam no seu pescoço. Um 10, com certeza. Pra todo mundo."

# game/scripts/c32/c32.rpy:1642
translate brazilian c32s002_choices_55b7c020:

    # ama "Besides, that was tied to the retroactive pay. What are you going to do about that?"
    ama "Além disso, isso estava atrelado ao pagamento retroativo. O que você vai fazer sobre isso?"

# game/scripts/c32/c32.rpy:1643
translate brazilian c32s002_choices_966728e7:

    # mc "I don't know yet. I can't give them both without leaving something else out."
    mc "Ainda não sei. Não posso dar os dois sem deixar outra coisa de fora."

# game/scripts/c32/c32.rpy:1644
translate brazilian c32s002_choices_8e41c56e:

    # mc "I thought giving them the salary might be a good idea."
    mc "Achei que dar o salário a eles poderia ser uma boa ideia."

# game/scripts/c32/c32.rpy:1645
translate brazilian c32s002_choices_f7b95eaa:

    # mc "Not only would it be fair, but it would also be a way of saying 'From now on, things are changing.'"
    mc "Não só seria justo, mas também seria uma forma de dizer 'A partir de agora, as coisas estão mudando'."

# game/scripts/c32/c32.rpy:1647
translate brazilian c32s002_choices_0f886ed8:

    # ama "That's a good idea. And you can deny them the retroactive pay by saying that's a problem from the previous management."
    ama "É uma boa ideia. E você pode negar o pagamento retroativo dizendo que isso é um problema da gestão anterior."

# game/scripts/c32/c32.rpy:1648
translate brazilian c32s002_choices_276f2f87:

    # ama "That would create... about 6 points of unhappiness."
    ama "Isso geraria... uns 6 pontos de insatisfação."

# game/scripts/c32/c32.rpy:1649
translate brazilian c32s002_choices_017c6753:

    # mc "We can't do that. It's the company that owes them. And now we are the company."
    mc "Não podemos fazer isso. É a empresa que deve a eles. E agora nós somos a empresa."

# game/scripts/c32/c32.rpy:1650
translate brazilian c32s002_choices_afe105b3:

    # mc "I was thinking that, if that's what we leave out, it should be temporary."
    mc "Eu estava pensando que, se for isso que vamos deixar de fora, deveria ser temporário."

# game/scripts/c32/c32.rpy:1651
translate brazilian c32s002_choices_48532c43:

    # mc "Like, we're not going to give a million to the A series, plus whatever to each of the C's, plus whatever the D's get..."
    mc "Tipo, não vamos dar um milhão pra série A, mais não sei quanto pra cada um dos C's, mais o que os D's recebem..."
# game/scripts/c32/c32.rpy:1653
translate brazilian c32s002_choices_01f03d7e:

    # ama "*Laugh* And don't forget about [eva] and me..."
    ama "*Risos* E não se esqueça da [eva] e de mim..."

# game/scripts/c32/c32.rpy:1654
translate brazilian c32s002_choices_ae6332de:

    # mc "*Laugh* I haven't forgotten. You're in the 'Halfling Fingers' report."
    mc "*Risos* Eu não esqueci. Vocês estão no relatório 'Dedos de Halfling'."

# game/scripts/c32/c32.rpy:1655
translate brazilian c32s002_choices_2c712dc7:

    # mc "I mean not paying it all at once. Giving it as a salary supplement until we settle the accounts with each of them."
    mc "Quero dizer, não pagar tudo de uma vez. Dar como um suplemento salarial até acertarmos as contas com cada um deles."

# game/scripts/c32/c32.rpy:1656
translate brazilian c32s002_choices_6fa8024f:

    # mc "I'm sure I know what [dam] would spend the money on if he got it all at once."
    mc "Tenho certeza de que sei com o que o [dam] gastaria o dinheiro se recebesse tudo de uma vez."

# game/scripts/c32/c32.rpy:1658
translate brazilian c32s002_choices_2ec02901:

    # ama "That's none of our business. But I think I like your idea."
    ama "Isso não é da nossa conta. Mas acho que gostei da sua ideia."

# game/scripts/c32/c32.rpy:1659
translate brazilian c32s002_choices_c406347e:

    # ama "When [eva] and I received the money from the shares, we went to [mar] and [nor] for guidance on how to spend it."
    ama "Quando a [eva] e eu recebemos o dinheiro das ações, fomos até a [mar] e a [nor] para pedir orientação sobre como gastá-lo."

# game/scripts/c32/c32.rpy:1661
translate brazilian c32s002_choices_369e6a74:

    # ama "The guys aren't going to have them here to ask."
    ama "Os caras não vão tê-las aqui para perguntar."

# game/scripts/c32/c32.rpy:1662
translate brazilian c32s002_choices_a75a49e4:

    # ama "But if you link receiving the supplement to... I don't know... some kind of home economics lessons..."
    ama "Mas se você vincular o recebimento do suplemento a... sei lá... algum tipo de aula de economia doméstica..."

# game/scripts/c32/c32.rpy:1663
translate brazilian c32s002_choices_45946b11:

    # ama "I think that would lower the unhappiness from 6 to 2 points. They know they'll get it, even if not all at once."
    ama "Acho que isso diminuiria a insatisfação de 6 para 2 pontos. Eles sabem que vão receber, mesmo que não seja tudo de uma vez."

# game/scripts/c32/c32.rpy:1664
translate brazilian c32s002_choices_f5271567:

    # mc "Sounds like a good idea to me."
    mc "Me parece uma boa ideia."

# game/scripts/c32/c32.rpy:1666
translate brazilian c32s002_choices_a0298ab4:

    # ama "Of course, you could just not pay their salary and give them the back pay."
    ama "Claro, você poderia simplesmente não pagar o salário deles e dar o pagamento retroativo."
# game/scripts/c32/c32.rpy:1667
translate brazilian c32s002_choices_4bec6998:

    # ama "*Laugh* I'd almost bet many would leave the company and we'd save on their salaries."
    ama "*Risos* Eu quase apostaria que muitos sairiam da empresa e economizaríamos nos salários deles."

# game/scripts/c32/c32.rpy:1668
translate brazilian c32s002_choices_0e4a7c10:

    # mc "*Laugh* Would they leave the company before or after killing me?"
    mc "*Risos* Eles sairiam da empresa antes ou depois de me matar?"

# game/scripts/c32/c32.rpy:1669
translate brazilian c32s002_choices_806401e9:

    # mc "You said they'd jump at my throat, and pissing off 400 guys who are trained to kill doesn't sound like a good idea."
    mc "Você disse que eles pulariam no meu pescoço, e deixar 400 caras treinados pra matar putos da vida não parece uma boa ideia."

# game/scripts/c32/c32.rpy:1671
translate brazilian c32s002_choices_23783ce4:

    # ama "*Laugh* [aar] and I would defend you."
    ama "*Risos* [aar] e eu te defenderíamos."

# game/scripts/c32/c32.rpy:1672
translate brazilian c32s002_choices_7b0c4e87:

    # mc "*Laugh* You two wouldn't get paid either."
    mc "*Risos* Vocês dois também não seriam pagos."

# game/scripts/c32/c32.rpy:1673
translate brazilian c32s002_choices_31174db0:

    # ama "*Laugh* Then I'll correct myself. [car] would defend you."
    ama "*Risos* Então vou me corrigir. A [car] te defenderia."

# game/scripts/c32/c32.rpy:1674
translate brazilian c32s002_choices_353e4ea1:

    # mc "*Laugh* Then I'm safe, as long as I don't leave the office."
    mc "*Risos* Então estou a salvo, desde que eu não saia do escritório."

# game/scripts/c32/c32.rpy:1675
translate brazilian c32s002_choices_e2728bc7:

    # mc "No one would dare cross her."
    mc "Ninguém ousaria bater de frente com ela."

# game/scripts/c32/c32.rpy:1677
translate brazilian c32s002_choices_f367cf65:

    # ama "Well, let's move on before we spout too much nonsense and [car] comes in to see what's wrong with us."
    ama "Bom, vamos continuar antes que a gente fale muita merda e a [car] entre pra ver qual é o nosso problema."

# game/scripts/c32/c32.rpy:1678
translate brazilian c32s002_choices_40000b84:

    # ama "What's the next promise?"
    ama "Qual é a próxima promessa?"

# game/scripts/c32/c32.rpy:1679
translate brazilian c32s002_choices_52599a5d:

    # mc "Contract terminations. The part about you being able to leave the company whenever you want."
    mc "Rescisões de contrato. A parte sobre você poder sair da empresa quando quiser."
# game/scripts/c32/c32.rpy:1681
translate brazilian c32s002_choices_105c6197:

    # ama "Oof! I think if I had to rate the unhappiness that would cause... A 5 overall."
    ama "Putz! Acho que se eu tivesse que dar uma nota pra infelicidade que isso causaria... Um 5 no geral."

# game/scripts/c32/c32.rpy:1682
translate brazilian c32s002_choices_6a258d65:

    # mc "Only a 5?"
    mc "Só um 5?"

# game/scripts/c32/c32.rpy:1684
translate brazilian c32s002_choices_41645337:

    # ama "There are some who will probably never want to leave. [aar], the C's, the D's..."
    ama "Tem alguns que provavelmente nunca vão querer sair. [aar], os C's, os D's..."

# game/scripts/c32/c32.rpy:1685
translate brazilian c32s002_choices_75c47816:

    # ama "They're too... old... to start making a living outside of here. And it's the same as with the prosthetics. For them, it would be a 1."
    ama "Eles são muito... velhos... para começar a ganhar a vida lá fora. E é a mesma coisa com as próteses. Para eles, seria um 1."

# game/scripts/c32/c32.rpy:1686
translate brazilian c32s002_choices_59d5d9da:

    # ama "For the younger ones, it might be closer to a 10. If you deny them that, they'd still feel like slaves. I just averaged it out."
    ama "Para os mais novos, talvez seja mais perto de um 10. Se você negar isso a eles, ainda se sentiriam como escravos. Eu só fiz uma média."

# game/scripts/c32/c32.rpy:1687
translate brazilian c32s002_choices_2d8b5842:

    # mc "I get it. A 5 then."
    mc "Entendi. Um 5 então."

# game/scripts/c32/c32.rpy:1689
translate brazilian c32s002_choices_dd541633:

    # ama "We're making progress. Next?"
    ama "Estamos progredindo. Próximo?"

# game/scripts/c32/c32.rpy:1690
translate brazilian c32s002_choices_ae585396:

    # mc "Next would be the internal promotion system and applying for different positions."
    mc "O próximo seria o sistema de promoção interna e a candidatura para diferentes cargos."

# game/scripts/c32/c32.rpy:1691
translate brazilian c32s002_choices_22346e53:

    # mc "I thought that was going to be cheap, but when I explained it to [vin], he said it wasn't that easy."
    mc "Achei que isso ia ser barato, mas quando expliquei pro [vin], ele disse que não era tão fácil assim."

# game/scripts/c32/c32.rpy:1692
translate brazilian c32s002_choices_1ef53656:

    # mc "There would have to be a training program for the various positions. And he made the budget. He loves making budgets!"
    mc "Teria que haver um programa de treinamento para os vários cargos. E ele fez o orçamento. Ele adora fazer orçamentos!"

# game/scripts/c32/c32.rpy:1693
translate brazilian c32s002_choices_c39aa0d6:

    # mc "We shouldn't accept that you ask for the accountant position, for example, if you don't have the training for it."
    mc "Não deveríamos aceitar que você peça o cargo de contador, por exemplo, se não tiver o treinamento para isso."
# game/scripts/c32/c32.rpy:1695
translate brazilian c32s002_choices_8a2bcda6:

    # ama "It pisses me off to agree with [vin]."
    ama "Fico puta de concordar com o [vin]."

# game/scripts/c32/c32.rpy:1696
translate brazilian c32s002_choices_0eae8b01:

    # ama "If you present it as a long-term thing, with training programs, you're going to make the younger ones very happy."
    ama "Se você apresentar isso como algo a longo prazo, com programas de treinamento, vai deixar os mais novos muito felizes."

# game/scripts/c32/c32.rpy:1697
translate brazilian c32s002_choices_65bf15d4:

    # mc "That is, if it's not the idea we leave out..."
    mc "Isso se não for a ideia que vamos deixar de fora..."

# game/scripts/c32/c32.rpy:1699
translate brazilian c32s002_choices_6da0627d:

    # ama "Exactly. If you leave it out, it would anger a lot of people. A 7, I'd say. And it would have ramifications."
    ama "Exatamente. Se você deixar de fora, isso irritaria muita gente. Um 7, eu diria. E teria ramificações."

# game/scripts/c32/c32.rpy:1700
translate brazilian c32s002_choices_64c0c948:

    # ama "For example, for the Newport team. Instead of choosing volunteers, we should handpick them."
    ama "Por exemplo, para a equipe de Newport. Em vez de escolher voluntários, deveríamos escolhê-los a dedo."

# game/scripts/c32/c32.rpy:1701
translate brazilian c32s002_choices_43bd7f7f:

    # mc "But if there are enough volunteers, we could choose from among them."
    mc "Mas se houver voluntários suficientes, poderíamos escolher entre eles."

# game/scripts/c32/c32.rpy:1703
translate brazilian c32s002_choices_0c5f88a8:

    # ama "You'd be sending a mixed message. 'To protect my family, yes, for the rest, no.'"
    ama "Você estaria passando uma mensagem confusa. 'Para proteger minha família, sim, para o resto, não.'"

# game/scripts/c32/c32.rpy:1704
translate brazilian c32s002_choices_32f8f8f4:

    # mc "I hadn't thought of it like that, but you're right. I wasn't looking at it from the kids' psychology."
    mc "Eu não tinha pensado por esse lado, mas você tem razão. Eu não estava olhando pela psicologia das crianças."

# game/scripts/c32/c32.rpy:1706
translate brazilian c32s002_choices_870bc08c:

    # ama "Although you could implement the promotion system for things they are prepared for, like security."
    ama "Embora você pudesse implementar o sistema de promoção para coisas para as quais eles estão preparados, como segurança."

# game/scripts/c32/c32.rpy:1707
translate brazilian c32s002_choices_bf533a1e:

    # ama "And leave the positions that need training for later. Imagine someone from the P Series who wants to be a doctor."
    ama "E deixar os cargos que precisam de treinamento para depois. Imagina alguém da Série P que quer ser médico."

# game/scripts/c32/c32.rpy:1708
translate brazilian c32s002_choices_83e8d4c5:

    # ama "They are five years old now, even if their bodies are eight. It gives them time to prepare for whatever they want to be."
    ama "Eles têm cinco anos agora, mesmo que seus corpos tenham oito. Isso dá tempo para se prepararem para o que quiserem ser."
# game/scripts/c32/c32.rpy:1710
translate brazilian c32s002_choices_e14d3140:

    # ama "If we do it like that, it would be a... possibly a 2?"
    ama "Se fizermos desse jeito, seria um... possivelmente um 2?"

# game/scripts/c32/c32.rpy:1711
translate brazilian c32s002_choices_62df770a:

    # ama "There might be someone who wants to be a CFO tomorrow, but the rest will understand."
    ama "Pode ter alguém que queira ser CFO amanhã, mas o resto vai entender."

# game/scripts/c32/c32.rpy:1712
translate brazilian c32s002_choices_b5e5ca31:

    # mc "I like that idea."
    mc "Gosto dessa ideia."

# game/scripts/c32/c32.rpy:1713
translate brazilian c32s002_choices_aa942b95:

    # mc "Besides, we can combine it with a normal education program for the little ones. I told you yesterday I don't want them near weapons."
    mc "Além disso, podemos combinar com um programa de educação normal para os pequenos. Te falei ontem que não quero eles perto de armas."

# game/scripts/c32/c32.rpy:1715
translate brazilian c32s002_choices_e2ffec41:

    # ama "We can create something similar to a rural school with our own teachers."
    ama "Podemos criar algo parecido com uma escola rural com nossos próprios professores."

# game/scripts/c32/c32.rpy:1716
translate brazilian c32s002_choices_b4c994f7:

    # ama "You can't send 20 Q-series kids to the same school."
    ama "Você não pode mandar 20 crianças da série Q para a mesma escola."

# game/scripts/c32/c32.rpy:1717
translate brazilian c32s002_choices_878fcbb9:

    # mc "I know. I already have the budget for it, courtesy of [vin]. That option is already approved in my head."
    mc "Eu sei. Já tenho o orçamento pra isso, cortesia do [vin]. Essa opção já tá aprovada na minha cabeça."

# game/scripts/c32/c32.rpy:1718
translate brazilian c32s002_choices_904513b8:

    # mc "And only the last one is left. Passports."
    mc "E só falta a última. Passaportes."

# game/scripts/c32/c32.rpy:1720
translate brazilian c32s002_choices_78fa534d:

    # ama "It makes no sense for you to let them terminate the contract and not give them passports. Nor vice versa."
    ama "Não faz sentido você deixar eles rescindirem o contrato e não dar os passaportes. Nem vice-versa."

# game/scripts/c32/c32.rpy:1721
translate brazilian c32s002_choices_8ef72c39:

    # mc "I know. They are two choices that are linked together. One without the other would be useless."
    mc "Eu sei. São duas escolhas que estão ligadas. Uma sem a outra seria inútil."

# game/scripts/c32/c32.rpy:1722
translate brazilian c32s002_choices_378afdc8:

    # mc "But, since we're ranking them by unpopularity, how many points would you give this if we left it out?"
    mc "Mas, já que estamos classificando por impopularidade, quantos pontos você daria pra isso se deixássemos de fora?"
# game/scripts/c32/c32.rpy:1724
translate brazilian c32s002_choices_4aed6620:

    # ama "It's complicated. You'd condemn anyone who wanted to leave the company to a life as a pariah."
    ama "É complicado. Você condenaria qualquer um que quisesse sair da empresa a uma vida de pária."

# game/scripts/c32/c32.rpy:1725
translate brazilian c32s002_choices_e4568a61:

    # ama "Although it would be a way to make them not want to leave."
    ama "Embora fosse uma forma de fazer com que não quisessem ir embora."

# game/scripts/c32/c32.rpy:1726
translate brazilian c32s002_choices_862b697e:

    # mc "That's playing dirty, [ama]. I don't want to be like Daniels or Richards in that regard."
    mc "Isso é jogar sujo, [ama]. Eu não quero ser como o Daniels ou o Richards nesse aspecto."

# game/scripts/c32/c32.rpy:1728
translate brazilian c32s002_choices_998e98ee:

    # ama "I know, I was just thinking out loud."
    ama "Eu sei, só estava pensando alto."

# game/scripts/c32/c32.rpy:1729
translate brazilian c32s002_choices_8c2ea8cb:

    # ama "I think a 6."
    ama "Eu acho que um 6."

# game/scripts/c32/c32.rpy:1730
translate brazilian c32s002_choices_99c784a0:

    # mc "More than not letting them terminate their contracts? I don't get it."
    mc "Mais do que não deixar que rescindam seus contratos? Eu não entendo."

# game/scripts/c32/c32.rpy:1732
translate brazilian c32s002_choices_578b616c:

    # ama "If we can leave the company but not live a normal life, you'd be fucking us over more than if you didn't let us leave."
    ama "Se pudermos sair da empresa, mas não tivermos uma vida normal, você estaria nos fodendo mais do que se não nos deixasse sair."

# game/scripts/c32/c32.rpy:1733
translate brazilian c32s002_choices_2ed1354b:

    # ama "Besides, some would think the same as you, that it's playing dirty."
    ama "Além disso, alguns pensariam o mesmo que você, que é jogar sujo."

# game/scripts/c32/c32.rpy:1734
translate brazilian c32s002_choices_4fda04ae:

    # mc "Okay. A 6 then. Let's recap..."
    mc "Beleza. Um 6 então. Vamos recapitular..."

# game/scripts/c32/c32.rpy:1735
translate brazilian c32s002_choices_f1fddce4:

    # mc "If we leave out the prosthetics, a 3. The salary a 10."
    mc "Se deixarmos as próteses de fora, um 3. O salário um 10."

# game/scripts/c32/c32.rpy:1736
translate brazilian c32s002_choices_4a125ac8:

    # mc "Retroactive pay is a 6, but if we apply it with long-term monthly bonuses, it's a 2."
    mc "O pagamento retroativo é um 6, mas se aplicarmos com bônus mensais de longo prazo, é um 2."
# game/scripts/c32/c32.rpy:1737
translate brazilian c32s002_choices_bf9e9b45:

    # mc "Contract terminations are a 5. Internal promotions, if we secure a training program, a 2. And passports a 6."
    mc "Rescisões de contrato são um 5. Promoções internas, se garantirmos um programa de treinamento, um 2. E passaportes um 6."

# game/scripts/c32/c32.rpy:1739
translate brazilian c32s002_choices_a79d5f13:

    # ama "I think it's clear. You have to choose between retroactive pay and internal promotions."
    ama "Acho que está claro. Você tem que escolher entre pagamento retroativo e promoções internas."

# game/scripts/c32/c32.rpy:1740
translate brazilian c32s002_choices_6bc58a8b:

    # ama "They're both longer-term things. The cost would be distributed over time and it would give them a reason to stay in the company."
    ama "Ambas são coisas de longo prazo. O custo seria distribuído ao longo do tempo e daria a eles um motivo para ficar na empresa."

# game/scripts/c32/c32.rpy:1741
translate brazilian c32s002_choices_05f0e4b9:

    # mc "You're right. I don't like leaving either off the list, but they're the best candidates."
    mc "Você tem razão. Não gosto de deixar nenhum dos dois fora da lista, mas são os melhores candidatos."

# game/scripts/c32/c32.rpy:1743
translate brazilian c32s002_choices_040de9eb:

    # ama "But there's one request we haven't talked about."
    ama "Mas tem um pedido sobre o qual não conversamos."

# game/scripts/c32/c32.rpy:1744
translate brazilian c32s002_choices_77c47ed2:

    # mc "Which one?"
    mc "Qual?"

# game/scripts/c32/c32.rpy:1745
translate brazilian c32s002_choices_f8979f1b:

    # ama "[erc]."
    ama "[erc]."

# game/scripts/c32/c32.rpy:1746
translate brazilian c32s002_choices_9812bb0a:

    # mc "I'm going to fulfill that. I said he'd get a fair review and he will."
    mc "Eu vou cumprir isso. Eu disse que ele teria uma avaliação justa e ele terá."

# game/scripts/c32/c32.rpy:1747
translate brazilian c32s002_choices_e4f9fd90:

    # mc "I plan to talk to him next week."
    mc "Pretendo falar com ele na semana que vem."

# game/scripts/c32/c32.rpy:1749
translate brazilian c32s002_choices_f6e252b9:

    # ama "[eva] is going to want to be there."
    ama "A [eva] vai querer estar lá."

# game/scripts/c32/c32.rpy:1750
translate brazilian c32s002_choices_195b5051:

    # mc "I know, but it's going to be impossible to delay it until she gets here."
    mc "Eu sei, mas vai ser impossível adiar até ela chegar aqui."
# game/scripts/c32/c32.rpy:1751
translate brazilian c32s002_choices_ad5bfb96:

    # mc "I thought she would join by video conference."
    mc "Eu achei que ela ia participar por videoconferência."

# game/scripts/c32/c32.rpy:1752
translate brazilian c32s002_choices_18468d4b:

    # mc "And that gave me an idea. But let's finish first with the decision we have to leave out."
    mc "E isso me deu uma ideia. Mas vamos terminar primeiro com a decisão que temos que deixar de fora."

# game/scripts/c32/c32.rpy:1754
translate brazilian c32s002_choices_442ed32e:

    # ama "The decision YOU have to leave out. I'm just the head of security. That's the CEO's responsibility."
    ama "A decisão que VOCÊ tem que deixar de fora. Eu sou só a chefe de segurança. Essa é a responsabilidade do CEO."

# game/scripts/c32/c32.rpy:1755
translate brazilian c32s002_choices_7ab88910:

    # mc "*Laugh* That's how I like it. No pressure. Since you can defend yourself against the clones..."
    mc "*Risos* É assim que eu gosto. Sem pressão. Já que você consegue se defender contra os clones..."

# game/scripts/c32/c32.rpy:1756
translate brazilian c32s002_choices_2ef1da78:

    # mc "According to your unpopularity ranking, the two decisions would be equally unpopular, but much less than the others."
    mc "De acordo com o seu ranking de impopularidade, as duas decisões seriam igualmente impopulares, mas muito menos que as outras."

# game/scripts/c32/c32.rpy:1763
translate brazilian c32s002_choices_a2cf0a9f:

    # ama "I think you made a good decision."
    ama "Acho que você tomou uma boa decisão."

# game/scripts/c32/c32.rpy:1765
translate brazilian c32s002_choices_7df8f792:

    # ama "If you keep giving them their back pay over a few years, they're going to be happy during those years."
