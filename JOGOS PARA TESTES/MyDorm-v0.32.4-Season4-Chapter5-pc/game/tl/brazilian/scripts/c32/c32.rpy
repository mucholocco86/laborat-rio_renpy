# game/scripts/c32/c32.rpy:4623
translate brazilian c32s007_cult_6d49b02e:

    # mc "*Laugh* I do know you, but I don't know if any of your boys are listening to this conversation."
    mc "*Risos* Eu conheço sim, mas não sei se algum dos seus garotos está ouvindo essa conversa."

# game/scripts/c32/c32.rpy:4625
translate brazilian c32s007_cult_6219725a:

    # mc "*Laugh* But that doesn't make you want to come here and hug me any less."
    mc "*Risos* Mas isso não faz você ter menos vontade de vir aqui me abraçar."

# game/scripts/c32/c32.rpy:4627
translate brazilian c32s007_cult_e4875296:

    # eva "Getting back to the boys..."
    eva "Voltando aos garotos..."

# game/scripts/c32/c32.rpy:4628
translate brazilian c32s007_cult_728bb72f:

    # mc "What about them?"
    mc "O que tem eles?"

# game/scripts/c32/c32.rpy:4629
translate brazilian c32s007_cult_1c463e27:

    # eva "There's something we hadn't counted on."
    eva "Tem uma coisa que a gente não contava."

# game/scripts/c32/c32.rpy:4630
translate brazilian c32s007_cult_c41e8d00:

    # mc "Accommodation is sorted. Food too. They've already received their first paychecks..."
    mc "Acomodação tá resolvida. Comida também. Eles já receberam os primeiros pagamentos..."

# game/scripts/c32/c32.rpy:4631
translate brazilian c32s007_cult_5c5af901:

    # mc "What have we overlooked about them?"
    mc "O que deixamos passar sobre eles?"

# game/scripts/c32/c32.rpy:4633
translate brazilian c32s007_cult_9580f0d6:

    # eva "We hadn't thought about how the new girls were going to see them."
    eva "Não pensamos em como as garotas novas iam enxergar eles."

# game/scripts/c32/c32.rpy:4634
translate brazilian c32s007_cult_8e02e08b:

    # eva "We're already a weird family as it is, but having armed guys wandering around a college dorm...?"
    eva "Nós já somos uma família estranha, mas ter caras armados andando por um dormitório universitário...?"
# game/scripts/c32/c32.rpy:4635
translate brazilian c32s007_cult_109c330f:

    # eva "I don't think the girls are handling it very well."
    eva "Acho que as garotas não estão lidando muito bem com isso."

# game/scripts/c32/c32.rpy:4636
translate brazilian c32s007_cult_917904d0:

    # mc "I hadn't thought about that. I thought it would be like with you girls at first, when we didn't know you were there."
    mc "Eu não tinha pensado nisso. Achei que seria como com vocês no começo, quando não sabíamos que vocês estavam lá."

# game/scripts/c32/c32.rpy:4638
translate brazilian c32s007_cult_a57aad26:

    # eva "That was our idea, but [mar] and [nor] force whoever is guarding the perimeter to come in every now and then to have a cold drink."
    eva "Essa era a nossa ideia, mas a [mar] e a [nor] forçam quem estiver vigiando o perímetro a entrar de vez em quando para tomar uma bebida gelada."

# game/scripts/c32/c32.rpy:4639
translate brazilian c32s007_cult_fd91d471:

    # eva "They say they can't accept them walking around the woods their whole shift in this heat."
    eva "Elas dizem que não podem aceitar que elas fiquem andando pela floresta o turno todo nesse calor."

# game/scripts/c32/c32.rpy:4640
translate brazilian c32s007_cult_4a30ea04:

    # mc "Does that affect their effectiveness in guarding the house?"
    mc "Isso afeta a eficácia delas em vigiar a casa?"

# game/scripts/c32/c32.rpy:4641
translate brazilian c32s007_cult_0acc9e87:

    # mc "You're in charge of the security team, if you think [mar] and [nor] are overstepping..."
    mc "Você é a encarregada da equipe de segurança, se você acha que a [mar] e a [nor] estão passando dos limites..."

# game/scripts/c32/c32.rpy:4643
translate brazilian c32s007_cult_048c0345:

    # eva "No, don't worry. It's good that they come into the house."
    eva "Não, não se preocupe. É bom que elas entrem na casa."

# game/scripts/c32/c32.rpy:4644
translate brazilian c32s007_cult_973364be:

    # eva "They get to know the family better and make mental routes to get from one place to another if they're needed."
    eva "Elas passam a conhecer melhor a família e criam rotas mentais para ir de um lugar a outro se forem necessárias."

# game/scripts/c32/c32.rpy:4645
translate brazilian c32s007_cult_a185f6b1:

    # eva "But we hadn't counted on how that would impact the new girls."
    eva "Mas não contávamos com o impacto que isso teria nas garotas novas."

# game/scripts/c32/c32.rpy:4646
translate brazilian c32s007_cult_6a84c73d:

    # mc "My priority is your safety, not what six girls I don't know think about that safety."
    mc "Minha prioridade é a segurança de vocês, não o que seis garotas que eu não conheço pensam sobre essa segurança."

# game/scripts/c32/c32.rpy:4647
translate brazilian c32s007_cult_f5e9c5ec:

    # mc "Have any of them complained?"
    mc "Alguma delas reclamou?"
# game/scripts/c32/c32.rpy:4649
