# game/scripts/c32/c32.rpy:4612
translate brazilian c32s007_cult_c94c854a:

    # mc "*Laugh* Are you going to stop being a deadly leopard and become an equally deadly hippo?"
    mc "*Risos* Você vai deixar de ser um leopardo mortal e se tornar um hipopótamo igualmente mortal?"

# game/scripts/c32/c32.rpy:4614
translate brazilian c32s007_cult_1eeb6128:

    # eva "*Laugh* Don't laugh at me! And never tell a pregnant woman she looks like a hippo."
    eva "*Risos* Não ria de mim! E nunca diga a uma mulher grávida que ela parece um hipopótamo."

# game/scripts/c32/c32.rpy:4615
translate brazilian c32s007_cult_ed7f7471:

    # mc "I didn't say you looked like one. I just asked what you were going to turn into. You're not even showing yet."
    mc "Eu não disse que você parecia um. Só perguntei no que você ia se transformar. Nem tá aparecendo a barriga ainda."

# game/scripts/c32/c32.rpy:4616
translate brazilian c32s007_cult_1dd61643:

    # mc "And when you do show, I won't dare say it. I read that hippos are the mammals that cause the most deaths in Africa."
    mc "E quando aparecer, eu não vou ousar dizer isso. Li que os hipopótamos são os mamíferos que mais causam mortes na África."

# game/scripts/c32/c32.rpy:4618
