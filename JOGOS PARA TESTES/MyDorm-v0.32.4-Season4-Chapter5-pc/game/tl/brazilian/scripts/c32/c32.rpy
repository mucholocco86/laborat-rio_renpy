    # sam "I don't know if I missed these hugs more, or you. No one at home hugs as well as you do."
    sam "Não sei se senti mais falta desses abraços, ou de você. Ninguém em casa abraça tão bem quanto você."

# game/scripts/c32/c32.rpy:2895
translate brazilian c32s004_MarSamArrival_a8033ed5:

    # mc "I missed both. Even though Aunt [bet] and [ama] give great hugs."
    mc "Eu senti falta dos dois. Mesmo que a Tia [bet] e a [ama] deem ótimos abraços."

# game/scripts/c32/c32.rpy:2897
translate brazilian c32s004_MarSamArrival_b482f55f:
    # bet "But it seems like no one wants to hug me. *Laugh* I feel lonely!"
    bet "Mas parece que ninguém quer me abraçar. *Risos* Me sinto solitária!"

# game/scripts/c32/c32.rpy:2899
