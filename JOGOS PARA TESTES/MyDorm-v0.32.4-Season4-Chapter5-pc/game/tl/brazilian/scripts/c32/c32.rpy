# game/scripts/c32/c32.rpy:2788
translate brazilian c32s004_routine_b43d4424:
    # "Sometimes it seems like they agree on who gets to spend the night with you."
    "Às vezes parece que elas entram em acordo sobre quem vai passar a noite com você."

# game/scripts/c32/c32.rpy:2789
translate brazilian c32s004_routine_395c7f15:

    # "On other occasions, a kiss somewhere in the house ends up in your room, while the other woman discreetly disappears."
