    sam "*Risos* Acho que vou pegar um voo de volta se essa é a recepção que eu ganho."

# game/scripts/c32/c32.rpy:2910
translate brazilian c32s004_MarSamArrival_c24cdc35:

    # bet "Enough joking around. There's food waiting."
    bet "Chega de brincadeira. Tem comida esperando."

# game/scripts/c32/c32.rpy:2913
translate brazilian c32s004_MarSamArrival_a867c9a2:

    # mc "First of all, how are our little girls doing?"
    mc "Antes de mais nada, como estão nossas garotinhas?"

# game/scripts/c32/c32.rpy:2920
translate brazilian c32s004_MarSamArrival_ce5c2bc1:

    # mc "First of all, how is our little girl doing?"
    mc "Antes de mais nada, como está nossa garotinha?"

# game/scripts/c32/c32.rpy:2922
translate brazilian c32s004_MarSamArrival_f0f3dd24:

    # mom "Everything's going great. I went with [sam.nick] to the hospital on Tuesday, and there's nothing to worry about."
    mom "Tudo está indo muito bem. Eu fui com a [sam.nick] ao hospital na terça, e não há com o que se preocupar."

# game/scripts/c32/c32.rpy:2923
translate brazilian c32s004_MarSamArrival_a3adb3e0:

    # sam "These first-time dads... You won't stop worrying until you're changing diapers."
    sam "Esses pais de primeira viagem... Você não vai parar de se preocupar até estar trocando fraldas."

# game/scripts/c32/c32.rpy:2924
translate brazilian c32s004_MarSamArrival_b0967253:

    # mc "*Laugh* And then, I'll worry about other things."
    mc "*Risos* E então, vou me preocupar com outras coisas."

# game/scripts/c32/c32.rpy:2926
translate brazilian c32s004_MarSamArrival_396d0aed:

    # "Once in the car..."
    "Já no carro..."

# game/scripts/c32/c32.rpy:2927
translate brazilian c32s004_MarSamArrival_d0764ff6:

    # bet "I was so happy when [mc] told me you were coming. But, why did you come?"
    bet "Fiquei tão feliz quando o [mc] me disse que vocês viriam. Mas, por que vocês vieram?"

# game/scripts/c32/c32.rpy:2928
