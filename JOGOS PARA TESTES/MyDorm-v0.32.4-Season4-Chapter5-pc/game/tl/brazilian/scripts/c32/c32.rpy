# game/scripts/c32/c32.rpy:32
translate brazilian c32s002_noAma_f0705f57:

    # "After dinner..."
    "Depois do jantar..."

# game/scripts/c32/c32.rpy:33
translate brazilian c32s002_noAma_3071531a:

    # mc "What are you doing, [ama]?"
    mc "O que você está fazendo, [ama]?"

# game/scripts/c32/c32.rpy:35
translate brazilian c32s002_noAma_fa46e1a6:

    # ama "I was looking at this picture. I know it's a generic picture of a field with daisies, but..."
    ama "Eu estava olhando para esta foto. Eu sei que é uma foto genérica de um campo com margaridas, mas..."

# game/scripts/c32/c32.rpy:36
translate brazilian c32s002_noAma_a82490ef:

    # ama "If it weren't for that rock right in the middle, I'd think it was the old shooting range."
    ama "Se não fosse por aquela pedra bem no meio, eu acharia que era o antigo estande de tiro."

# game/scripts/c32/c32.rpy:37
translate brazilian c32s002_noAma_f45c8fd6:

    # mc "The old shooting range?"
    mc "O antigo estande de tiro?"

# game/scripts/c32/c32.rpy:39
translate brazilian c32s002_noAma_8c4dde0d:

    # ama "I guess [eva] told you about when they used to aim a gun at our heads at the shooting range the moment they gave us a weapon."
    ama "Acho que a [eva] te contou sobre quando eles costumavam apontar uma arma para nossas cabeças no estande de tiro no momento em que nos davam uma arma."

# game/scripts/c32/c32.rpy:40
translate brazilian c32s002_noAma_75b75cf1:

    # mc "Yes. It was inhumane."
    mc "Sim. Foi desumano."

# game/scripts/c32/c32.rpy:42
translate brazilian c32s002_noAma_26db4307:

    # ama "The older series went through that. The A's, B's, C's, D's, and us. I think even the E's."
    ama "As séries mais antigas passaram por isso. As A, B, C, D e nós. Acho que até as E."

# game/scripts/c32/c32.rpy:43
translate brazilian c32s002_noAma_72451634:

    # ama "When the A's were old enough to train the rest of the series, the company fired those instructors."
    ama "Quando as A tinham idade suficiente para treinar o resto das séries, a empresa demitiu aqueles instrutores."

# game/scripts/c32/c32.rpy:44
translate brazilian c32s002_noAma_73af92e2:

    # ama "Then, the A's refused to use that shooting range to train us ever again."
    ama "Então, as A se recusaram a usar aquele estande de tiro para nos treinar de novo."

# game/scripts/c32/c32.rpy:46
translate brazilian c32s002_noAma_69e2182f:

    # ama "The excuse is that it had gotten too small for the new series, which were larger. 20 F's couldn't fit on the shooting range at the same time."
    ama "A desculpa é que tinha ficado pequeno demais para as novas séries, que eram maiores. 20 F não caberiam no estande de tiro ao mesmo tempo."
# game/scripts/c32/c32.rpy:47
translate brazilian c32s002_noAma_be0cdaf9:

    # ama "But the real reason is that nobody wanted to go back there."
    ama "Mas o verdadeiro motivo é que ninguém queria voltar lá."

# game/scripts/c32/c32.rpy:48
translate brazilian c32s002_noAma_751296a6:

    # mc "I understand. I guess you guys had a hard time."
    mc "Eu entendo. Imagino que vocês passaram por momentos difíceis."

# game/scripts/c32/c32.rpy:50
translate brazilian c32s002_noAma_2040272f:

    # ama "Now, some of the guys use it when they want to compete with each other."
    ama "Agora, alguns dos caras usam quando querem competir entre si."

# game/scripts/c32/c32.rpy:51
translate brazilian c32s002_noAma_07b4435e:

    # ama "Usually, they're guys who didn't live through that era and who aren't allowed to compete on the range that's currently in use."
    ama "Geralmente, são caras que não viveram aquela época e que não têm permissão para competir no estande que está em uso atualmente."

# game/scripts/c32/c32.rpy:52
translate brazilian c32s002_noAma_23ae9f31:

    # ama "The old shooting range has become an oasis of tranquility."
    ama "O antigo estande de tiro se tornou um oásis de tranquilidade."

# game/scripts/c32/c32.rpy:53
translate brazilian c32s002_noAma_f7421095:

    # mc "Except when they want to compete, right?"
    mc "Exceto quando eles querem competir, né?"

# game/scripts/c32/c32.rpy:55
translate brazilian c32s002_noAma_e1898150:

    # ama "They don't do it often. The instructors, from the C's to the F's, keep them busy."
    ama "Eles não fazem isso com frequência. Os instrutores, dos C's aos F's, mantêm eles ocupados."

# game/scripts/c32/c32.rpy:56
translate brazilian c32s002_noAma_944beacd:

    # ama "But it's a beautiful place with ugly memories. I'll show it to you when we go to the training base... if you want."
    ama "Mas é um lugar bonito com memórias feias. Eu te mostro quando formos para a base de treinamento... se você quiser."

# game/scripts/c32/c32.rpy:57
translate brazilian c32s002_noAma_02848cdf:

    # mc "If you're going to have a hard time going back there, we don't have to."
    mc "Se vai ser difícil pra você voltar lá, não precisamos ir."

# game/scripts/c32/c32.rpy:59
translate brazilian c32s002_noAma_7598dae1:

    # ama "I think going back there after so long might be good. To make new memories."
    ama "Acho que voltar lá depois de tanto tempo pode ser bom. Para criar novas memórias."

# game/scripts/c32/c32.rpy:60
translate brazilian c32s002_noAma_330ac222:

    # ama "Different memories for a different company."
    ama "Memórias diferentes para uma companhia diferente."

# game/scripts/c32/c32.rpy:61
translate brazilian c32s002_noAma_e803d73e:

    # mc "If that's what you think, alright. I'd be glad to go on a tour of the shooting range."
    mc "Se é isso que você acha, beleza. Eu adoraria fazer um tour pelo estande de tiro."

# game/scripts/c32/c32.rpy:63
translate brazilian c32s002_noAma_cfdb63b9:

    # ama "But we'll talk about that tomorrow. I'm dead tired."
    ama "Mas a gente fala sobre isso amanhã. Tô morta de cansaço."

# game/scripts/c32/c32.rpy:64
translate brazilian c32s002_noAma_6d00f607:

    # mc "Then I won't keep you any longer. Go to sleep."
    mc "Então não vou te segurar mais. Vai dormir."

# game/scripts/c32/c32.rpy:66
translate brazilian c32s002_noAma_b166bf00:

    # ama "Thanks for everything, [mc]."
    ama "Obrigada por tudo, [mc]."

# game/scripts/c32/c32.rpy:67
translate brazilian c32s002_noAma_21a7515b:

    # mc "I'm here for whatever you need."
    mc "Tô aqui pro que você precisar."

# game/scripts/c32/c32.rpy:68
translate brazilian c32s002_noAma_d5bbf685:

    # ama "I knew you were going to say that."
    ama "Eu sabia que você ia dizer isso."

# game/scripts/c32/c32.rpy:70
translate brazilian c32s002_noAma_9f2c1078:

    # "While [ama] goes to the bathroom before bed, you check if there's any news on the My Residence forums."
    "Enquanto [ama] vai ao banheiro antes de dormir, você checa se tem alguma novidade nos fóruns de My Residence."

# game/scripts/c32/c32.rpy:71
translate brazilian c32s002_noAma_83aae2f9:

    # "It seems there's going to be a date with one of the humans infiltrated among the aliens."
    "Parece que vai ter um encontro com uma das humanas infiltradas entre os alienígenas."

# game/scripts/c32/c32.rpy:72
translate brazilian c32s002_noAma_b5a288d9:

    # "You're sure Clichecita must have done something interesting with her."
    "Você tem certeza de que Clichecita deve ter feito algo interessante com ela."

# game/scripts/c32/c32.rpy:73
translate brazilian c32s002_noAma_fcd27786:

    # "The highest tiers among his subscribers, who have already played the update, say the date is really cute."
    "Os tiers mais altos entre os assinantes dele, que já jogaram a atualização, dizem que o encontro é muito fofo."

# game/scripts/c32/c32.rpy:74
translate brazilian c32s002_noAma_ebd3af98:

    # "She's been the girl who took the longest to have an intimate moment with the MC, and there's a lot of hype on the forums."
    "Ela foi a garota que mais demorou pra ter um momento íntimo com o MC, e o hype tá gigante nos fóruns."
# game/scripts/c32/c32.rpy:82
translate brazilian c32s001_AmaDate_da8c937e:

    # ama "Thanks, [mc]. And now we should leave."
    ama "Obrigada, [mc]. E agora devemos ir."

# game/scripts/c32/c32.rpy:83
translate brazilian c32s001_AmaDate_f7212587:

    # mc "Already? In such a rush? Oranjestad will still be there if we take five more minutes."
    mc "Já? Com tanta pressa? Oranjestad ainda vai estar lá se a gente levar mais cinco minutos."

# game/scripts/c32/c32.rpy:85
translate brazilian c32s001_AmaDate_c93c439e:

    # ama "We're not going to Oranjestad after all. I asked [car] for help, and we have a reservation at a small restaurant."
    ama "Afinal, não vamos para Oranjestad. Pedi ajuda para a [car], e temos uma reserva num restaurante pequeno."

# game/scripts/c32/c32.rpy:86
translate brazilian c32s001_AmaDate_b61dfb5b:

    # ama "She told me it's far from the tourist spots, so we'll be almost alone. But we have to leave now."
    ama "Ela me disse que fica longe dos pontos turísticos, então vamos ficar quase sozinhos. Mas temos que ir agora."

# game/scripts/c32/c32.rpy:87
translate brazilian c32s001_AmaDate_5af7be8b:

    # mc "Are you hungry?"
    mc "Você tá com fome?"

# game/scripts/c32/c32.rpy:89
translate brazilian c32s001_AmaDate_1703a995:

    # ama "No, but I don't want to miss the sunset. You know what? I'd better drive or we'll be late."
    ama "Não, mas não quero perder o pôr do sol. Quer saber? É melhor eu dirigir, senão vamos nos atrasar."

# game/scripts/c32/c32.rpy:90
translate brazilian c32s001_AmaDate_7231029a:

    # mc "That sounds interesting. I wouldn't want to miss it either."
    mc "Parece interessante. Eu também não gostaria de perder."

# game/scripts/c32/c32.rpy:92
translate brazilian c32s001_AmaDate_a99d229e:

    # "[ama] drives like a maniac through the narrow roads. Luckily, there isn't too much traffic."
    "[ama] dirige como uma maníaca pelas estradas estreitas. Por sorte, não há muito trânsito."

# game/scripts/c32/c32.rpy:93
translate brazilian c32s001_AmaDate_53627598:

    # "She's really in a hurry to get there in time to see the sun hide behind the horizon."
    "Ela está com muita pressa para chegar a tempo de ver o sol se esconder atrás do horizonte."

# game/scripts/c32/c32.rpy:95
translate brazilian c32s001_AmaDate_6a54722a:

    # "After a few minutes, she parks the car and you head down a pedestrian alley. She takes your hand as soon as you get out of the car."
    "Depois de alguns minutos, ela estaciona o carro e vocês descem por uma viela de pedestres. Ela pega a sua mão assim que você sai do carro."

# game/scripts/c32/c32.rpy:96
translate brazilian c32s001_AmaDate_06a59e27:

    # "The street has the typical colors you've seen in all the online travel guides about Aruba, although the architecture is a bit different."
    "A rua tem as cores típicas que você viu em todos os guias de viagem online sobre Aruba, embora a arquitetura seja um pouco diferente."
# game/scripts/c32/c32.rpy:97
translate brazilian c32s001_AmaDate_e9fcd934:

    # "There's a terrace with parasols in the middle of the street. You assume that's where you're going to have dinner."
    "Há um terraço com guarda-sóis no meio da rua. Você presume que é lá que vão jantar."

# game/scripts/c32/c32.rpy:99
translate brazilian c32s001_AmaDate_76a93cba:

    # ama "Here we are."
    ama "Chegamos."

# game/scripts/c32/c32.rpy:100
translate brazilian c32s001_AmaDate_90a91ac6:

    # mc "Are we going to that restaurant over there?"
    mc "Nós vamos naquele restaurante ali?"

# game/scripts/c32/c32.rpy:101
translate brazilian c32s001_AmaDate_eb2d6a0f:

    # ama "Yes, but not on the terrace, from what [car] told me. Follow me."
    ama "Sim, mas não no terraço, pelo que a [car] me disse. Vem comigo."

# game/scripts/c32/c32.rpy:103
translate brazilian c32s001_AmaDate_131172a3:

    # "When you reach the parasols..."
    "Quando você chega aos guarda-sóis..."

# game/scripts/c32/c32.rpy:104
translate brazilian c32s001_AmaDate_ce60889d:

    # ama "Wait here for a moment. I need to go inside."
    ama "Espera aqui um momento. Eu preciso entrar."

# game/scripts/c32/c32.rpy:105
translate brazilian c32s001_AmaDate_eac27608:

    # mc "Don't take too long. I miss you already."
    mc "Não demora muito. Já tô com saudade."

# game/scripts/c32/c32.rpy:108
translate brazilian c32s001_AmaDate_3b7e8910:

    # ama "*Giggle* To make the wait a little shorter."
    ama "*Risos* Pra fazer a espera ser um pouco mais curta."

# game/scripts/c32/c32.rpy:109
translate brazilian c32s001_AmaDate_57fcd56b:

    # mc "*Laugh* That gives you a couple of extra seconds."
    mc "*Risos* Isso te dá uns segundinhos a mais."

# game/scripts/c32/c32.rpy:111
translate brazilian c32s001_AmaDate_ef36b3bd:

    # "You look around while you wait. The first thing that catches your eye is the restaurant's sign."
    "Você olha em volta enquanto espera. A primeira coisa que chama sua atenção é a placa do restaurante."

# game/scripts/c32/c32.rpy:112
translate brazilian c32s001_AmaDate_b82312d2:

    # "In a country that lives off tourism, you would have expected the sign to be in English, but it looks like a mix of Dutch, Italian, and Spanish."
    "Em um país que vive do turismo, você esperaria que a placa estivesse em inglês, mas parece uma mistura de holandês, italiano e espanhol."
# game/scripts/c32/c32.rpy:113
translate brazilian c32s001_AmaDate_58cde655:

    # "It must be in the local language. Papiamento or something like that."
    "Deve ser no idioma local. Papiamento ou algo do tipo."

# game/scripts/c32/c32.rpy:115
translate brazilian c32s001_AmaDate_49b97d80:

    # "Only one of the four tables is occupied, so, unless people dine very late here, you're going to have some privacy."
    "Apenas uma das quatro mesas está ocupada, então, a menos que as pessoas jantem muito tarde por aqui, você terá um pouco de privacidade."

# game/scripts/c32/c32.rpy:116
translate brazilian c32s001_AmaDate_e64a6722:

    # "You'll have to thank [car] for recommending this beautiful place."
    "Você terá que agradecer à [car] por recomendar este lugar lindo."

# game/scripts/c32/c32.rpy:117
translate brazilian c32s001_AmaDate_3b135ebd:

    # "If you had planned it yourself, you probably would have looked at the same travel guides as every other tourist on the island."
    "Se você tivesse planejado sozinho, provavelmente teria olhado os mesmos guias de viagem que qualquer outro turista na ilha."

# game/scripts/c32/c32.rpy:118
translate brazilian c32s001_AmaDate_47cf6a77:

    # "And you would have ended up in a noisy restaurant surrounded by tourists looking for exactly the same tropical romantic experience."
    "E teria acabado em um restaurante barulhento cercado por turistas procurando exatamente a mesma experiência romântica tropical."

# game/scripts/c32/c32.rpy:121
translate brazilian c32s001_AmaDate_fb922154:

    # "After a few minutes, [ama] appears with the waitress."
    "Depois de alguns minutos, [ama] aparece com a garçonete."

# game/scripts/c32/c32.rpy:122
translate brazilian c32s001_AmaDate_27992950:

    # ama "[mc], this is [saa], the owner of the restaurant."
    ama "[mc], esta é [saa], a dona do restaurante."

# game/scripts/c32/c32.rpy:123
translate brazilian c32s001_AmaDate_86321bc6:

    # "Well, it looks like she isn't the waitress."
    "Bem, parece que ela não é a garçonete."

# game/scripts/c32/c32.rpy:124
translate brazilian c32s001_AmaDate_196abb99:

    # mc "Nice to meet you, [saa]."
    mc "Prazer em conhecê-la, [saa]."

# game/scripts/c32/c32.rpy:125
translate brazilian c32s001_AmaDate_10bd9872:

    # saa "Likewise, [mc]. Follow me, I've prepared a table for you on the pier."
    saa "O prazer é meu, [mc]. Siga-me, preparei uma mesa para vocês no píer."

# game/scripts/c32/c32.rpy:126
translate brazilian c32s001_AmaDate_490db2e5:

    # mc "On the pier?"
    mc "No píer?"
# game/scripts/c32/c32.rpy:127
translate brazilian c32s001_AmaDate_bef705b7:

    # "You haven't seen any pier nearby, but you looked like a clueless tourist focusing on unimportant things."
    "Você não viu nenhum píer por perto, mas parecia um turista perdido focando em coisas sem importância."

# game/scripts/c32/c32.rpy:129
translate brazilian c32s001_AmaDate_53ee9166:

    # saa "Oma [car] told me to treat you guys like royalty."
    saa "A Oma [car] me disse para tratar vocês como realeza."

# game/scripts/c32/c32.rpy:130
translate brazilian c32s001_AmaDate_fa393c42:

    # saa "And the pier has the best views."
    saa "E o píer tem as melhores vistas."

# game/scripts/c32/c32.rpy:131
translate brazilian c32s001_AmaDate_074cd552:

    # mc "We'll follow you."
    mc "Nós vamos te seguir."

# game/scripts/c32/c32.rpy:134
translate brazilian c32s001_AmaDate_6598394a:

    # "The pier is at the end of the street, behind some colonial arches. The parasols were blocking it from view."
    "O píer fica no final da rua, atrás de alguns arcos coloniais. Os guarda-sóis estavam bloqueando a visão dele."

# game/scripts/c32/c32.rpy:135
translate brazilian c32s001_AmaDate_b40f67b2:

    # "The views of the sunset over the Caribbean are mind-blowing."
    "A vista do pôr do sol sobre o Caribe é de cair o queixo."

# game/scripts/c32/c32.rpy:136
translate brazilian c32s001_AmaDate_7abf5ea9:

    # saa "This is your table. I hope you like it."
    saa "Esta é a mesa de vocês. Espero que gostem."

# game/scripts/c32/c32.rpy:137
translate brazilian c32s001_AmaDate_22ff5d85:

    # mc "It's spectacular."
    mc "É espetacular."

# game/scripts/c32/c32.rpy:139
translate brazilian c32s001_AmaDate_8c3b4fba:

    # ama "The place is gorgeous, [saa]. Masha danki."
    ama "O lugar é maravilhoso, [saa]. Masha danki."

# game/scripts/c32/c32.rpy:140
translate brazilian c32s001_AmaDate_0506264a:

    # saa "An! Mi no tabata sa ku bo ta papia papiamentu."
    saa "An! Mi no tabata sa ku bo ta papia papiamentu."

# game/scripts/c32/c32.rpy:141
translate brazilian c32s001_AmaDate_bc3edc00:

    # ama "I speak a little Papiamento, but [mc] doesn't. *Laugh* From the look on his face, I think it sounded like Greek to him."
    ama "Eu falo um pouco de papiamento, mas o [mc] não. *Risos* Pela cara dele, acho que soou como grego pra ele."
# game/scripts/c32/c32.rpy:143
translate brazilian c32s001_AmaDate_09c9a6c1:

    # saa "Sorry, [mc]. It's rare to meet tourists who speak my language, and I switched languages instinctively."
    saa "Desculpa, [mc]. É raro encontrar turistas que falam a minha língua, e eu mudei de idioma instintivamente."

# game/scripts/c32/c32.rpy:144
translate brazilian c32s001_AmaDate_7a226f94:

    # mc "Don't worry, [saa]. *Laugh* This is my 'what's going on here?' face."
    mc "Não se preocupe, [saa]. *Risos* Essa é a minha cara de 'o que tá acontecendo aqui?'."

# game/scripts/c32/c32.rpy:145
translate brazilian c32s001_AmaDate_38123692:

    # saa "Well, sit down or else you're going to miss the sunset."
    saa "Bom, senta aí senão você vai perder o pôr do sol."

# game/scripts/c32/c32.rpy:147
translate brazilian c32s001_AmaDate_b284de32:

    # saa "Do you want to see the menu, or would you prefer a typical Aruban dish?"
    saa "Você quer ver o cardápio, ou prefere um prato típico de Aruba?"

# game/scripts/c32/c32.rpy:148
translate brazilian c32s001_AmaDate_04da265d:

    # mc "A typical dish is fine by me. If I look at the menu, I'll order something I know, so surprise me."
    mc "Um prato típico tá ótimo pra mim. Se eu olhar o cardápio, vou pedir algo que já conheço, então me surpreenda."

# game/scripts/c32/c32.rpy:149
translate brazilian c32s001_AmaDate_5ae1ab75:

    # ama "I prefer something typical too."
    ama "Eu também prefiro algo típico."

# game/scripts/c32/c32.rpy:151
translate brazilian c32s001_AmaDate_551cd1b4:

    # saa "Do you like cheese?"
    saa "Você gosta de queijo?"

# game/scripts/c32/c32.rpy:152
translate brazilian c32s001_AmaDate_5d196d07:

    # mc "I love it."
    mc "Eu adoro."

# game/scripts/c32/c32.rpy:153
translate brazilian c32s001_AmaDate_6d34ae6f:

    # ama "Keshi yená? Sounds perfect to me."
    ama "Keshi yená? Parece perfeito pra mim."

# game/scripts/c32/c32.rpy:155
translate brazilian c32s001_AmaDate_2515be4b:

    # saa "That's what I was going to suggest. It's stuffed Dutch cheese, [mc]. It's practically the national dish of Aruba."
    saa "Era isso que eu ia sugerir. É queijo holandês recheado, [mc]. É praticamente o prato nacional de Aruba."

# game/scripts/c32/c32.rpy:156
translate brazilian c32s001_AmaDate_6fbc3ec4:

    # saa "And it's perfect for sharing."
    saa "E é perfeito pra dividir."
# game/scripts/c32/c32.rpy:157
translate brazilian c32s001_AmaDate_4b6ce816:

    # ama "I think you'll like it. Plus, it NEVER has broccoli in it."
    ama "Acho que você vai gostar. Além disso, NUNCA tem brócolis."

# game/scripts/c32/c32.rpy:158
translate brazilian c32s001_AmaDate_107095be:

    # mc "Then it sounds perfect to me."
    mc "Então parece perfeito pra mim."

# game/scripts/c32/c32.rpy:161
translate brazilian c32s001_AmaDate_1f3d13f5:

    # "After [saa] takes the rest of your dinner order..."
    "Depois que [saa] anota o resto do pedido do jantar..."

# game/scripts/c32/c32.rpy:162
translate brazilian c32s001_AmaDate_7f672bcf:

    # ama "Even though [saa] is very nice, I couldn't wait for her to leave."
    ama "Mesmo a [saa] sendo muito legal, eu mal podia esperar pra ela sair."

# game/scripts/c32/c32.rpy:163
translate brazilian c32s001_AmaDate_b3961c59:

    # mc "Why?"
    mc "Por quê?"

# game/scripts/c32/c32.rpy:164
translate brazilian c32s001_AmaDate_ed50e134:

    # ama "To ask you to stand up. I've been wanting to kiss you for a while."
    ama "Pra te pedir pra levantar. Eu tava querendo te beijar faz um tempo."

# game/scripts/c32/c32.rpy:166
translate brazilian c32s001_AmaDate_7ab86280:

    # "Neither of you needs to say anything. It's not a typical first date, and kisses are part of your relationship."
    "Nenhum de vocês precisa dizer nada. Não é um primeiro encontro típico, e beijos fazem parte do relacionamento de vocês."

# game/scripts/c32/c32.rpy:167
translate brazilian c32s001_AmaDate_ba679b52:

    # "But it's your first kiss during a sunset. It won't be the last one."
    "Mas é o primeiro beijo de vocês durante um pôr do sol. Não vai ser o último."

# game/scripts/c32/c32.rpy:170
translate brazilian c32s001_AmaDate_1839c8d8:

    # "When you sit back down..."
    "Quando vocês se sentam de novo..."

# game/scripts/c32/c32.rpy:171
translate brazilian c32s001_AmaDate_6d08fe9f:

    # mc "I guess you've never been here, right? Your surprised face when you saw the pier looked a lot like the one I think I had."
    mc "Acho que você nunca esteve aqui, né? Sua cara de surpresa quando viu o píer parecia muito com a que eu acho que fiz."

# game/scripts/c32/c32.rpy:172
translate brazilian c32s001_AmaDate_a43c6547:

    # ama "This place is beautiful. You know we couldn't leave the base unless it was for a mission."
    ama "Esse lugar é lindo. Você sabe que a gente não podia sair da base a não ser que fosse pra uma missão."
# game/scripts/c32/c32.rpy:173
translate brazilian c32s001_AmaDate_047d1d7e:

    # ama "Us girls were a bit different, a part of our training included blending in with... normal... people."
    ama "Nós, garotas, éramos um pouco diferentes, uma parte do nosso treinamento incluía nos misturarmos com... pessoas... normais."

# game/scripts/c32/c32.rpy:174
translate brazilian c32s001_AmaDate_884c7a26:

    # ama "It wasn't all combat for us. But we were always supervised, and I've never been here."
    ama "Não era só combate para nós. Mas sempre fomos supervisionadas, e eu nunca estive aqui."

# game/scripts/c32/c32.rpy:175
translate brazilian c32s001_AmaDate_912eef03:

    # mc "Then it seems like an even more ideal place. The first time for both of us."
    mc "Então parece um lugar ainda mais ideal. A primeira vez para nós dois."

# game/scripts/c32/c32.rpy:176
translate brazilian c32s001_AmaDate_f8209983:

    # mc "And speaking Papiamento, that's another surprise in [ama]'s endless box of surprises, right?"
    mc "E falar Papiamento, essa é mais uma surpresa na caixa de surpresas sem fim da [ama], né?"

# game/scripts/c32/c32.rpy:178
translate brazilian c32s001_AmaDate_208b125e:

    # ama "There are many languages in Aruba. We grew up with Dutch, English, and Spanish as our main languages."
    ama "Existem muitas línguas em Aruba. Nós crescemos com holandês, inglês e espanhol como nossas línguas principais."

# game/scripts/c32/c32.rpy:179
translate brazilian c32s001_AmaDate_0d17775d:

    # ama "But we also learned Papiamento and other Caribbean Creole languages. Aside from the typical ones: German, Chinese, French..."
    ama "Mas também aprendemos Papiamento e outras línguas crioulas do Caribe. Além das típicas: alemão, chinês, francês..."

# game/scripts/c32/c32.rpy:180
translate brazilian c32s001_AmaDate_9eba5728:

    # mc "How many languages do you speak?"
    mc "Quantas línguas você fala?"

# game/scripts/c32/c32.rpy:182
translate brazilian c32s001_AmaDate_6c486d6f:

    # ama "I've never counted them. [eva] says it's 17, but she's been saying it's 17 for years, and we learned more languages after that."
    ama "Eu nunca contei. A [eva] diz que são 17, mas ela diz que são 17 há anos, e nós aprendemos mais línguas depois disso."

# game/scripts/c32/c32.rpy:183
translate brazilian c32s001_AmaDate_92047158:

    # ama "I guess I must speak about 15 languages fluently, with different regionalisms, and around another 15 with a pretty heavy accent."
    ama "Acho que devo falar umas 15 línguas fluentemente, com diferentes regionalismos, e mais umas 15 com um sotaque bem forte."

# game/scripts/c32/c32.rpy:185
translate brazilian c32s001_AmaDate_78ffd9e0:

    # ama "But I don't want to talk about that. How are you liking your first days on the island?"
    ama "Mas eu não quero falar sobre isso. O que está achando dos seus primeiros dias na ilha?"

# game/scripts/c32/c32.rpy:186
translate brazilian c32s001_AmaDate_54f0f36c:

    # mc "Most of it has been working on things I wasn't ready for. But, little by little, I'm adapting."
    mc "A maior parte tem sido trabalhar em coisas para as quais eu não estava pronto. Mas, pouco a pouco, estou me adaptando."
# game/scripts/c32/c32.rpy:187
translate brazilian c32s001_AmaDate_e9a81f5a:

    # mc "Tonight is going to be the best time since we arrived."
    mc "Hoje à noite vai ser a melhor desde que chegamos."

# game/scripts/c32/c32.rpy:188
translate brazilian c32s001_AmaDate_58a5e581:

    # mc "And you? How are you handling being back in Aruba?"
    mc "E você? Como está lidando com a volta a Aruba?"

# game/scripts/c32/c32.rpy:190
translate brazilian c32s001_AmaDate_9a46fb69:

    # ama "It's different from what I thought it would be. Switching from operations to security..."
    ama "É diferente do que eu achei que seria. Mudar de operações para segurança..."

# game/scripts/c32/c32.rpy:191
translate brazilian c32s001_AmaDate_aecc9d35:

    # ama "Sometimes I miss training with the guys."
    ama "Às vezes sinto falta de treinar com os caras."

# game/scripts/c32/c32.rpy:192
translate brazilian c32s001_AmaDate_401cbcd8:

    # mc "You know you can do that, right? Just because you're the head of security now doesn't mean you can't go shoot with non-tanks."
    mc "Você sabe que pode fazer isso, né? Só porque você é a chefe de segurança agora não significa que não possa ir atirar com não-tanques."

# game/scripts/c32/c32.rpy:194
translate brazilian c32s001_AmaDate_f246318a:

    # ama "*Laugh* It's a...!"
    ama "*Risos* É um...!"

# game/scripts/c32/c32.rpy:195
translate brazilian c32s001_AmaDate_03274b92:

    # mc "*Laugh* A Bradley, an IFV, I know. But you always laugh when I don't remember the name."
    mc "*Risos* Um Bradley, um IFV, eu sei. Mas você sempre ri quando eu não lembro o nome."

# game/scripts/c32/c32.rpy:196
translate brazilian c32s001_AmaDate_dc8d0f44:

    # mc "Well, almost always. Sometimes you look at me like you're wondering if I'll ever learn it."
    mc "Bom, quase sempre. Às vezes você me olha como se estivesse se perguntando se eu algum dia vou aprender."

# game/scripts/c32/c32.rpy:198
translate brazilian c32s001_AmaDate_126dd5c5:

    # ama "And you already have. I guess it must be complicated for you too. Too many new things."
    ama "E você já aprendeu. Acho que deve ser complicado pra você também. Muitas coisas novas."

# game/scripts/c32/c32.rpy:199
translate brazilian c32s001_AmaDate_71959540:

    # mc "I grew up knowing how to distinguish between car models and gaming consoles. You grew up knowing how to distinguish between a Bradley and a T-72."
    mc "Eu cresci sabendo distinguir entre modelos de carros e consoles de videogame. Você cresceu sabendo distinguir entre um Bradley e um T-72."

# game/scripts/c32/c32.rpy:200
translate brazilian c32s001_AmaDate_24291fd2:

    # mc "I just have to learn in a few weeks what you've spent years learning."
    mc "Eu só tenho que aprender em algumas semanas o que você passou anos aprendendo."
# game/scripts/c32/c32.rpy:202
translate brazilian c32s001_AmaDate_826405ad:

    # ama "You don't need to learn every weapon model in the world. That would be almost impossible in such a short time, besides everything else you have to do."
    ama "Você não precisa aprender todos os modelos de armas do mundo. Isso seria quase impossível em tão pouco tempo, além de tudo o que você tem que fazer."

# game/scripts/c32/c32.rpy:203
translate brazilian c32s001_AmaDate_22359eef:

    # ama "I think learning the categories and what each thing is for should be enough."
    ama "Acho que aprender as categorias e para que serve cada coisa já deve ser o suficiente."

# game/scripts/c32/c32.rpy:205
translate brazilian c32s001_AmaDate_675aaff2:

    # ama "You have staff to design the operations, so you don't need to master it perfectly."
    ama "Você tem uma equipe para planejar as operações, então não precisa dominar isso perfeitamente."

# game/scripts/c32/c32.rpy:206
translate brazilian c32s001_AmaDate_c6f8623e:

    # ama "But at least you wouldn't look like an idiot when they talk to you about rifles, shotguns, and carbines."
    ama "Mas pelo menos você não pareceria um idiota quando falarem com você sobre rifles, escopetas e carabinas."

# game/scripts/c32/c32.rpy:207
translate brazilian c32s001_AmaDate_fff47989:

    # mc "*Laugh* Do I look like an idiot?"
    mc "*Risos* Eu pareço um idiota?"

# game/scripts/c32/c32.rpy:209
translate brazilian c32s001_AmaDate_f645f345:

    # ama "*Laugh* I'd rather not answer that. It's our first date and I don't want you to feel bad."
    ama "*Risos* Prefiro não responder. É o nosso primeiro encontro e eu não quero que você se sinta mal."

# game/scripts/c32/c32.rpy:210
translate brazilian c32s001_AmaDate_38a3de91:

    # ama "*Laugh* I want us to go on a second date someday."
    ama "*Risos* Eu quero que a gente tenha um segundo encontro algum dia."

# game/scripts/c32/c32.rpy:211
translate brazilian c32s001_AmaDate_88e70f89:

    # mc "*Laugh* Sounds good to me."
    mc "*Risos* Por mim, tudo bem."

# game/scripts/c32/c32.rpy:212
translate brazilian c32s001_AmaDate_f702d746:

    # mc "I just have one question. Why today?"
    mc "Eu só tenho uma pergunta. Por que hoje?"

# game/scripts/c32/c32.rpy:214
translate brazilian c32s001_AmaDate_9d4a1e5e:

    # ama "Because [bet] was staying at the base. I wouldn't have felt comfortable leaving her home alone."
    ama "Porque a [bet] ia ficar na base. Eu não me sentiria confortável deixando ela sozinha em casa."

# game/scripts/c32/c32.rpy:215
translate brazilian c32s001_AmaDate_d2a254d7:

    # mc "If that's why, we could have had our first date in Newport."
    mc "Se é por isso, poderíamos ter tido nosso primeiro encontro em Newport."
# game/scripts/c32/c32.rpy:216
translate brazilian c32s001_AmaDate_2f1368a5:

    # mc "There's something else, I'm sure."
    mc "Tem mais alguma coisa, tenho certeza."

# game/scripts/c32/c32.rpy:218
translate brazilian c32s001_AmaDate_d377b642:

    # ama "Yes. Yesterday, you didn't think I was a psycho for having... you know."
    ama "Sim. Ontem, você não achou que eu era uma psicopata por ter... você sabe."

# game/scripts/c32/c32.rpy:219
translate brazilian c32s001_AmaDate_ee3425b3:

    # ama "I didn't want to have our first date until I had shown it to you."
    ama "Eu não queria ter nosso primeiro encontro até ter te mostrado aquilo."

# game/scripts/c32/c32.rpy:220
translate brazilian c32s001_AmaDate_4bebfb2f:

    # ama "I didn't want you to think you'd slept with a crazy woman when I showed it to you."
    ama "Eu não queria que você achasse que tinha transado com uma maluca quando eu te mostrasse."

# game/scripts/c32/c32.rpy:221
translate brazilian c32s001_AmaDate_4e2b5b5b:

    # mc "Sleep together? We only talked about going out for dinner."
    mc "Transar? A gente só falou sobre sair pra jantar."

# game/scripts/c32/c32.rpy:224
translate brazilian c32s001_AmaDate_64c38b5d:

    # ama "WHAT? You don't want to sleep with me?"
    ama "O QUÊ? Você não quer transar comigo?"

# game/scripts/c32/c32.rpy:225
translate brazilian c32s001_AmaDate_ee19ac53:

    # mc "*Laugh* Of course I do. But I also wanted to see that surprised face."
    mc "*Risos* Claro que quero. Mas eu também queria ver essa sua cara de surpresa."

# game/scripts/c32/c32.rpy:226
translate brazilian c32s001_AmaDate_58517f7e:

    # mc "*Laugh* I'm not the only one at this table who can make an idiot face."
    mc "*Risos* Não sou o único nessa mesa que consegue fazer cara de idiota."

# game/scripts/c32/c32.rpy:228
translate brazilian c32s001_AmaDate_90ed2013:

    # ama "*Laugh* But you're the only one at this table who doesn't know how to break a hand in thirteen different places."
    ama "*Risos* Mas você é o único nessa mesa que não sabe como quebrar uma mão em treze lugares diferentes."

# game/scripts/c32/c32.rpy:229
translate brazilian c32s001_AmaDate_7b3c64f8:

    # mc "*Laugh* Okay. No more jokes that make you look idiot. Or that put my hands in danger."
    mc "*Risos* Tá bom. Chega de piadas que te façam parecer idiota. Ou que coloquem minhas mãos em perigo."

# game/scripts/c32/c32.rpy:230
translate brazilian c32s001_AmaDate_543f1f7a:

    # ama "*Laugh* We don't want to have to amputate your fingers and have you end up with smaller hands than [vin]."
    ama "*Risos* Não queremos ter que amputar seus dedos e fazer você acabar com mãos menores que as do [vin]."
# game/scripts/c32/c32.rpy:231
translate brazilian c32s001_AmaDate_50d089ac:

    # mc "*Laugh* Nope."
    mc "*Risos* Não."

# game/scripts/c32/c32.rpy:232
translate brazilian c32s001_AmaDate_53ae1b94:

    # mc "But seriously, I think you were worrying too much about my reaction."
    mc "Mas falando sério, acho que você estava se preocupando demais com a minha reação."

# game/scripts/c32/c32.rpy:234
translate brazilian c32s001_AmaDate_f81c8740:

    # ama "I also didn't know how coming back to this place would affect me."
    ama "Eu também não sabia como voltar para este lugar me afetaria."

# game/scripts/c32/c32.rpy:235
translate brazilian c32s001_AmaDate_f1c86679:

    # ama "I mean the base..."
    ama "Digo, a base..."

# game/scripts/c32/c32.rpy:236
translate brazilian c32s001_AmaDate_ac5bd3f4:

    # mc "I think you're handling it really well."
    mc "Acho que você está lidando muito bem com isso."

# game/scripts/c32/c32.rpy:237
translate brazilian c32s001_AmaDate_8a5f4bc2:

    # mc "From what you guys explained to me, I thought you'd have some scores to settle with your old instructors."
    mc "Pelo que vocês me explicaram, achei que você teria umas contas a acertar com seus antigos instrutores."

# game/scripts/c32/c32.rpy:239
translate brazilian c32s001_AmaDate_5d4674b4:

    # ama "The worst ones aren't with the company anymore. When the A's and C's were able to train the rest of the series, they got rid of the external ex-military guys."
    ama "Os piores não estão mais na empresa. Quando as A's e C's puderam treinar o resto das séries, eles se livraram dos ex-militares externos."

# game/scripts/c32/c32.rpy:240
translate brazilian c32s001_AmaDate_8c4dde0d:

    # ama "I guess [eva] told you about when they would aim a gun at our heads at the shooting range, the moment they gave us a weapon."
    ama "Acho que a [eva] te contou sobre quando eles apontavam uma arma para as nossas cabeças no estande de tiro, no momento em que nos davam uma arma."

# game/scripts/c32/c32.rpy:241
translate brazilian c32s001_AmaDate_31abe2d0:

    # mc "Yes, that's exactly what I meant. It's inhumane."
    mc "Sim, é exatamente o que eu quis dizer. É desumano."

# game/scripts/c32/c32.rpy:243
translate brazilian c32s001_AmaDate_26db4307:

    # ama "The older series went through that. The A's, B's, C's, D's, and us. I think even the E's."
    ama "As séries mais velhas passaram por isso. As A's, B's, C's, D's e nós. Acho que até as E's."

# game/scripts/c32/c32.rpy:244
translate brazilian c32s001_AmaDate_16dc8bb1:

    # ama "When those instructors were fired, the A's refused to ever use that shooting range to train us again."
    ama "Quando esses instrutores foram demitidos, as A's se recusaram a usar aquele estande de tiro para nos treinar de novo."
# game/scripts/c32/c32.rpy:246
translate brazilian c32s001_AmaDate_69e2182f:

    # ama "The excuse was that it had become too small for the new series, which were larger. You couldn't fit 20 F's at the shooting range at the same time."
    ama "A desculpa foi que tinha ficado pequeno demais para as novas séries, que eram maiores. Não dava pra colocar 20 F's no estande de tiro ao mesmo tempo."

# game/scripts/c32/c32.rpy:247
translate brazilian c32s001_AmaDate_be0cdaf9:

    # ama "But the real reason is that nobody wanted to go back there."
    ama "Mas o verdadeiro motivo é que ninguém queria voltar lá."

# game/scripts/c32/c32.rpy:248
translate brazilian c32s001_AmaDate_751296a6:

    # mc "I get it. I guess you guys had a hard time."
    mc "Eu entendo. Imagino que vocês passaram por um momento difícil."

# game/scripts/c32/c32.rpy:250
translate brazilian c32s001_AmaDate_2040272f:

    # ama "Now some of the guys use it when they want to compete with each other."
    ama "Agora alguns dos caras usam quando querem competir entre si."

# game/scripts/c32/c32.rpy:251
translate brazilian c32s001_AmaDate_d0ce68a4:

    # ama "Usually, they're guys who weren't around back then, and who aren't allowed to compete in the active range."
    ama "Geralmente, são caras que não estavam por aqui naquela época, e que não têm permissão para competir no estande ativo."

# game/scripts/c32/c32.rpy:252
translate brazilian c32s001_AmaDate_23ae9f31:

    # ama "The old shooting range has become an oasis of tranquility."
    ama "O antigo estande de tiro se tornou um oásis de tranquilidade."

# game/scripts/c32/c32.rpy:253
translate brazilian c32s001_AmaDate_f7421095:

    # mc "Except when they want to compete, right?"
    mc "Exceto quando eles querem competir, né?"

# game/scripts/c32/c32.rpy:255
translate brazilian c32s001_AmaDate_e1898150:

    # ama "They don't do it often. The instructors, from the C's to the F's, keep them busy."
    ama "Eles não fazem isso com frequência. Os instrutores, dos C's aos F's, mantêm eles ocupados."

# game/scripts/c32/c32.rpy:256
translate brazilian c32s001_AmaDate_944beacd:

    # ama "But it's a beautiful place with ugly memories. I'll show it to you when we go to the training base... if you want."
    ama "Mas é um lugar lindo com memórias feias. Eu te mostro quando formos para a base de treinamento... se você quiser."

# game/scripts/c32/c32.rpy:257
translate brazilian c32s001_AmaDate_02848cdf:

    # mc "If going back there is going to be hard for you, it's not necessary."
    mc "Se voltar lá vai ser difícil pra você, não é necessário."

# game/scripts/c32/c32.rpy:259
translate brazilian c32s001_AmaDate_556a06dd:

    # ama "Like you said, I think I'm handling it... well."
    ama "Como você disse, acho que estou lidando com isso... bem."
# game/scripts/c32/c32.rpy:260
translate brazilian c32s001_AmaDate_7d959a14:

    # ama "I think going back there after so long could be good. To create new memories with you."
    ama "Acho que voltar lá depois de tanto tempo pode ser bom. Para criar novas memórias com você."

# game/scripts/c32/c32.rpy:261
translate brazilian c32s001_AmaDate_e803d73e:

    # mc "If that's what you think, alright. I'd be glad to take the sightseeing tour of the shooting range."
    mc "Se é o que você acha, tudo bem. Eu adoraria fazer um passeio turístico pelo estande de tiro."

# game/scripts/c32/c32.rpy:263
translate brazilian c32s001_AmaDate_a39ccc8c:

    # ama "The {b}old{/b} shooting range."
    ama "O {b}antigo{/b} estande de tiro."

# game/scripts/c32/c32.rpy:264
translate brazilian c32s001_AmaDate_7f95a52d:

    # ama "And if we keep talking about things that aren't important anymore, we're going to miss the sunset."
    ama "E se continuarmos falando sobre coisas que não são mais importantes, vamos perder o pôr do sol."

# game/scripts/c32/c32.rpy:265
translate brazilian c32s001_AmaDate_1b203f69:

    # mc "I'm not going to decide what's important and what's not in this case."
    mc "Eu não vou decidir o que é importante e o que não é nesse caso."

# game/scripts/c32/c32.rpy:266
translate brazilian c32s001_AmaDate_9070dfa5:

    # mc "I have to decide too much of that every day at the company."
    mc "Eu já tenho que decidir muito disso todo dia na empresa."

# game/scripts/c32/c32.rpy:268
translate brazilian c32s001_AmaDate_791227f7:

    # "You hold hands across the table while watching a giant ball of fire continue its inexorable journey towards the horizon."
    "Vocês dão as mãos por cima da mesa enquanto observam uma bola de fogo gigante continuar sua jornada inexorável em direção ao horizonte."

# game/scripts/c32/c32.rpy:269
translate brazilian c32s001_AmaDate_577e0109:

    # "Sometimes you worry about [ama]'s sudden mood swings. Maybe this trip came too soon for her."
    "Às vezes você se preocupa com as mudanças repentinas de humor da [ama]. Talvez essa viagem tenha acontecido cedo demais para ela."

# game/scripts/c32/c32.rpy:272
translate brazilian c32s001_AmaDate_bfc1334f:

    # saa "Guys, I brought your food just in time for the sunset. I added some krokechi for you to try."
    saa "Gente, trouxe a comida de vocês bem a tempo do pôr do sol. Adicionei um pouco de krokechi para vocês provarem."

# game/scripts/c32/c32.rpy:273
translate brazilian c32s001_AmaDate_5400cd44:

    # saa "I hope you like fish and seafood."
    saa "Espero que gostem de peixe e frutos do mar."

# game/scripts/c32/c32.rpy:274
translate brazilian c32s001_AmaDate_235479d8:

    # mc "Sounds perfect to me."
    mc "Parece perfeito para mim."
# game/scripts/c32/c32.rpy:275
translate brazilian c32s001_AmaDate_0058a860:

    # ama "Thank you, [saa]."
    ama "Obrigada, [saa]."

# game/scripts/c32/c32.rpy:276
translate brazilian c32s001_AmaDate_63e7db9a:

    # saa "Enjoy your meal. I'll come check on you in case you need anything else."
    saa "Aproveitem a refeição. Eu venho checar vocês caso precisem de mais alguma coisa."

# game/scripts/c32/c32.rpy:278
translate brazilian c32s001_AmaDate_6ecffa80:

    # "You look at the appetizing food for a second before deciding it looks amazing."
    "Você olha para a comida apetitosa por um segundo antes de decidir que parece incrível."

# game/scripts/c32/c32.rpy:279
translate brazilian c32s001_AmaDate_e45fc385:

    # "You've always thought that many tourists miss out on local delicacies by playing it safe and eating at MacDonald's."
    "Você sempre pensou que muitos turistas perdem as iguarias locais por jogarem seguro e comerem no McDonald's."

# game/scripts/c32/c32.rpy:280
translate brazilian c32s001_AmaDate_583d1f30:

    # "Maybe the glutton inside you is the one directing your thoughts right now."
    "Talvez o glutão dentro de você seja quem está direcionando seus pensamentos agora."

# game/scripts/c32/c32.rpy:282
translate brazilian c32s001_AmaDate_75b4cdd2:

    # ama "*Laugh* I know what you're going to say."
    ama "*Risos* Eu sei o que você vai dizer."

# game/scripts/c32/c32.rpy:283
translate brazilian c32s001_AmaDate_c40ec18b:

    # mc "What am I going to say?"
    mc "O que eu vou dizer?"

# game/scripts/c32/c32.rpy:285
translate brazilian c32s001_AmaDate_d55d42e1:

    # ama "*Faking a manly voice* It looks good, but I'd be just as happy eating a burger."
    ama "*Fingindo uma voz masculina* Parece bom, mas eu ficaria igualmente feliz comendo um hambúrguer."

# game/scripts/c32/c32.rpy:286
translate brazilian c32s001_AmaDate_c506ce89:

    # ama "*Faking a manly voice* The important thing is that I'm going to share it with you."
    ama "*Fingindo uma voz masculina* O importante é que eu vou dividir isso com você."

# game/scripts/c32/c32.rpy:287
translate brazilian c32s001_AmaDate_1222260d:

    # mc "*Laugh* You almost got it. The second part would be 'The important thing is the company.'"
    mc "*Risos* Você quase acertou. A segunda parte seria 'O importante é a companhia.'"

# game/scripts/c32/c32.rpy:288
translate brazilian c32s001_AmaDate_f5699506:

    # mc "But I was just thinking what a waste it would be to eat a burger right now."
    mc "Mas eu estava justamente pensando que desperdício seria comer um hambúrguer agora."

# game/scripts/c32/c32.rpy:289
translate brazilian c32s001_AmaDate_11e13a2d:

    # mc "This looks excellent! And we can eat all the burgers we want when we get back home."
    mc "Isso parece excelente! E podemos comer todos os hambúrgueres que quisermos quando voltarmos para casa."

# game/scripts/c32/c32.rpy:291
translate brazilian c32s001_AmaDate_ebb631bc:

    # ama "The Keshi yená is really good. The krokechi are like fish croquettes, but round. It's not my favorite dish, but they're good too."
    ama "O Keshi yená é muito bom. Os krokechi são como croquetes de peixe, mas redondos. Não é meu prato favorito, mas também são bons."

# game/scripts/c32/c32.rpy:292
translate brazilian c32s001_AmaDate_d63c5db5:

    # mc "I've never asked you what your favorite dish is. And it's the typical first date question."
    mc "Eu nunca te perguntei qual é o seu prato favorito. E é a típica pergunta de primeiro encontro."

# game/scripts/c32/c32.rpy:294
translate brazilian c32s001_AmaDate_7ca4113a:

    # ama "*Laugh* Anything [mar] or [nor] cook. They are great cooks, but also... their food tastes like home."
    ama "*Risos* Qualquer coisa que a [mar] ou a [nor] cozinhem. Elas são ótimas cozinheiras, mas também... a comida delas tem gosto de casa."

# game/scripts/c32/c32.rpy:295
translate brazilian c32s001_AmaDate_f90fff0d:

    # mc "Do you miss them already? I know the feeling."
    mc "Já está com saudade delas? Eu sei como é."

# game/scripts/c32/c32.rpy:297
translate brazilian c32s001_AmaDate_7f81a1de:

    # ama "I miss everyone, but especially those two and [eva]."
    ama "Sinto falta de todo mundo, mas especialmente daquelas duas e da [eva]."

# game/scripts/c32/c32.rpy:298
translate brazilian c32s001_AmaDate_59191d5b:

    # ama "Don't get me wrong. I love being here with you and Aunt [bet], being able to sleep with you every night..."
    ama "Não me leve a mal. Eu amo estar aqui com você e a Tia [bet], poder dormir com você toda noite..."

# game/scripts/c32/c32.rpy:299
translate brazilian c32s001_AmaDate_8d44a29b:

    # mc "But there's nothing like being home."
    mc "Mas não há nada como estar em casa."

# game/scripts/c32/c32.rpy:301
translate brazilian c32s001_AmaDate_4d4e4d47:

    # ama "Exactly. Even though I've only been part of the family for a short time... Newport is more my home than Aruba ever was."
    ama "Exatamente. Mesmo que eu faça parte da família há pouco tempo... Newport é mais minha casa do que Aruba jamais foi."

# game/scripts/c32/c32.rpy:302
translate brazilian c32s001_AmaDate_5fe77f18:

    # mc "I'm glad you feel that way about Newport. We have to change your perception of Aruba."
    mc "Fico feliz que você se sinta assim sobre Newport. Temos que mudar sua percepção sobre Aruba."

# game/scripts/c32/c32.rpy:303
translate brazilian c32s001_AmaDate_54396300:

    # mc "We need to make new memories, like what you said about the old shooting range."
    mc "Precisamos criar novas memórias, como o que você disse sobre o antigo estande de tiro."
# game/scripts/c32/c32.rpy:304
translate brazilian c32s001_AmaDate_03377b16:

    # mc "And we're going to start doing that today."
    mc "E vamos começar a fazer isso hoje."

# game/scripts/c32/c32.rpy:306
translate brazilian c32s001_AmaDate_bea5db30:

    # "And you create new memories."
    "E vocês criam novas memórias."

# game/scripts/c32/c32.rpy:307
translate brazilian c32s001_AmaDate_03babefe:

    # "It seems like the sunset pauses to give you the perfect moment to have dinner under its light."
    "Parece que o pôr do sol faz uma pausa para dar a vocês o momento perfeito para jantar sob sua luz."

# game/scripts/c32/c32.rpy:308
translate brazilian c32s001_AmaDate_465be367:

    # "To create a new memory."
    "Para criar uma nova memória."

# game/scripts/c32/c32.rpy:309
translate brazilian c32s001_AmaDate_a82ac7a3:

    # "You enjoy the exquisite dinner that [saa] has prepared for you."
    "Você aproveita o jantar requintado que [saa] preparou para vocês."

# game/scripts/c32/c32.rpy:310
translate brazilian c32s001_AmaDate_4a43aaaf:

    # "You really wouldn't care if it were a burger. The important thing is the company."
    "Você realmente não se importaria se fosse um hambúrguer. O importante é a companhia."

# game/scripts/c32/c32.rpy:312
translate brazilian c32s001_AmaDate_cfa87aec:

    # "Not even the appearance of a tourist boat at the last minute can ruin the magic of the moment."
    "Nem mesmo o aparecimento de um barco de turismo no último minuto pode arruinar a magia do momento."

# game/scripts/c32/c32.rpy:313
translate brazilian c32s001_AmaDate_48aa883a:

    # "Neither of you is able to see it."
    "Nenhum de vocês é capaz de vê-lo."

# game/scripts/c32/c32.rpy:315
translate brazilian c32s001_AmaDate_3b61fbcc:

    # "You only have eyes for each other."
    "Vocês só têm olhos um para o outro."

# game/scripts/c32/c32.rpy:316
translate brazilian c32s001_AmaDate_09994c39:

    # "You'll have to come back to watch the sunset another day."
    "Vocês terão que voltar para assistir ao pôr do sol outro dia."

# game/scripts/c32/c32.rpy:317
translate brazilian c32s001_AmaDate_78aefecf:

    # "And you will."
    "E vocês vão."
# game/scripts/c32/c32.rpy:318
translate brazilian c32s001_AmaDate_f22f5d53:

    # "And you'll miss it again."
    "E você vai perder de novo."

# game/scripts/c32/c32.rpy:321
translate brazilian c32s001_AmaDate_9537abf0:

    # "You didn't even notice that [saa] turned on the lights at some point."
    "Você nem percebeu que [saa] ligou as luzes em algum momento."

# game/scripts/c32/c32.rpy:322
translate brazilian c32s001_AmaDate_a0c3a3d5:

    # mc "Looks like we missed the sunset."
    mc "Parece que perdemos o pôr do sol."

# game/scripts/c32/c32.rpy:323
translate brazilian c32s001_AmaDate_9b0f8974:

    # ama "There was something more interesting to look at."
    ama "Tinha algo mais interessante para olhar."

# game/scripts/c32/c32.rpy:324
translate brazilian c32s001_AmaDate_2ebb5df0:

    # mc "That should've been my line..."
    mc "Essa deveria ser a minha fala..."

# game/scripts/c32/c32.rpy:325
translate brazilian c32s001_AmaDate_1704db63:

    # ama "We're a team. It doesn't matter who says the lines."
    ama "Nós somos uma equipe. Não importa quem diz as falas."

# game/scripts/c32/c32.rpy:327
translate brazilian c32s001_AmaDate_7fdab66d:

    # ama "Do you know how to dive?"
    ama "Você sabe mergulhar?"

# game/scripts/c32/c32.rpy:328
translate brazilian c32s001_AmaDate_ae23b10c:

    # mc "Like with oxygen tanks and stuff? I've never done it, but it can't be {b}that{/b} hard, right?"
    mc "Tipo com tanques de oxigênio e tudo mais? Eu nunca fiz isso, mas não deve ser {b}tão{/b} difícil assim, né?"

# game/scripts/c32/c32.rpy:329
translate brazilian c32s001_AmaDate_da5e3d4c:

    # ama "It's harder than it looks. But I meant snorkeling and skin diving."
    ama "É mais difícil do que parece. Mas eu quis dizer mergulho com snorkel e mergulho livre."

# game/scripts/c32/c32.rpy:330
translate brazilian c32s001_AmaDate_339ee637:

    # mc "Oh, yeah! I definitely know how to do that."
    mc "Ah, sim! Eu definitivamente sei fazer isso."

# game/scripts/c32/c32.rpy:332
translate brazilian c32s001_AmaDate_a1363d08:

    # ama "Then let's go. [car] sent me the address of a place where they do night dives."
    ama "Então vamos lá. [car] me mandou o endereço de um lugar onde eles fazem mergulhos noturnos."
# game/scripts/c32/c32.rpy:333
translate brazilian c32s001_AmaDate_9b5dddfb:

    # mc "Now?"
    mc "Agora?"

# game/scripts/c32/c32.rpy:335
translate brazilian c32s001_AmaDate_c3531e5a:

    # ama "*Laugh* Doing night dives during the day isn't very fun. Besides, it's impossible."
    ama "*Risos* Fazer mergulhos noturnos durante o dia não é muito divertido. Além disso, é impossível."

# game/scripts/c32/c32.rpy:336
translate brazilian c32s001_AmaDate_6f56ef04:

    # mc "*Laugh* Okay, I'm an idiot. But [car] wants to kill me!"
    mc "*Risos* Beleza, eu sou um idiota. Mas a [car] quer me matar!"

# game/scripts/c32/c32.rpy:338
translate brazilian c32s001_AmaDate_e161fd1b:

    # ama "It was my idea. I asked her if she knew a place where we could do it."
    ama "Foi ideia minha. Eu perguntei se ela conhecia um lugar onde a gente pudesse fazer isso."

# game/scripts/c32/c32.rpy:339
translate brazilian c32s001_AmaDate_6a5fdb75:

    # ama "I'm sure none of your dates have included a diving session."
    ama "Tenho certeza de que nenhum dos seus encontros incluiu uma sessão de mergulho."

# game/scripts/c32/c32.rpy:340
translate brazilian c32s001_AmaDate_29f1bdca:

    # mc "Once again, you're right. And once again, [ama]'s box of surprises seems bottomless."
    mc "Mais uma vez, você tem razão. E mais uma vez, a caixinha de surpresas da [ama] parece não ter fundo."

# game/scripts/c32/c32.rpy:342
translate brazilian c32s001_AmaDate_4a189bfb:

    # "Before you can go pay, [ama] gives you a passionate kiss under the light of the stars."
    "Antes que você possa ir pagar, [ama] te dá um beijo apaixonado sob a luz das estrelas."

# game/scripts/c32/c32.rpy:343
translate brazilian c32s001_AmaDate_011d3867:

    # "The date is going fantastic."
    "O encontro está sendo fantástico."

# game/scripts/c32/c32.rpy:346
translate brazilian c32s001_AmaDate_b6211181:

    # "Once you pay the bill and say goodbye to [saa], back in the car..."
    "Depois de pagar a conta e se despedir de [saa], de volta ao carro..."

# game/scripts/c32/c32.rpy:347
translate brazilian c32s001_AmaDate_0f007347:

    # ama "Are you having a good time? Is the date going as you expected?"
    ama "Você está se divertindo? O encontro está sendo como você esperava?"

# game/scripts/c32/c32.rpy:348
translate brazilian c32s001_AmaDate_52af21d5:

    # mc "The dinner and the place were great. And the company was unbeatable."
    mc "O jantar e o lugar foram ótimos. E a companhia foi imbatível."
# game/scripts/c32/c32.rpy:349
translate brazilian c32s001_AmaDate_bbe48600:

    # mc "But, again, that was supposed to be my line."
    mc "Mas, de novo, essa era pra ser a minha fala."

# game/scripts/c32/c32.rpy:350
translate brazilian c32s001_AmaDate_bf1c000c:

    # mc "How's your first date?"
    mc "Como está sendo o seu primeiro encontro?"

# game/scripts/c32/c32.rpy:352
translate brazilian c32s001_AmaDate_9eed93bf:

    # ama "Wanting it to never end. And wanting it to be over."
    ama "Querendo que nunca acabe. E querendo que termine logo."

# game/scripts/c32/c32.rpy:353
translate brazilian c32s001_AmaDate_3af1be9b:

    # mc "You know we don't have to go snorkeling if you don't want to, right?"
    mc "Você sabe que não precisamos fazer mergulho se não quiser, né?"

# game/scripts/c32/c32.rpy:354
translate brazilian c32s001_AmaDate_feba2e80:

    # mc "If you want it to end, there will be other days we can do it."
    mc "Se você quer que acabe, teremos outros dias pra fazer isso."

# game/scripts/c32/c32.rpy:356
translate brazilian c32s001_AmaDate_4e4dc524:

    # ama "But then it wouldn't be a memorable first date."
    ama "Mas aí não seria um primeiro encontro memorável."

# game/scripts/c32/c32.rpy:357
translate brazilian c32s001_AmaDate_c9346d2d:

    # mc "*Laugh* You're wrong this time. It's already memorable."
    mc "*Risos* Você tá errada dessa vez. Já é memorável."

# game/scripts/c32/c32.rpy:359
translate brazilian c32s001_AmaDate_b3e22bf7:

    # ama "In 20 years, if we have kids and they ask how our first date was..."
    ama "Daqui a 20 anos, se a gente tiver filhos e eles perguntarem como foi nosso primeiro encontro..."

# game/scripts/c32/c32.rpy:360
translate brazilian c32s001_AmaDate_ffb3119e:

    # ama "Do you want to tell them 'we went to dinner and that was it'?"
    ama "Você quer dizer pra eles 'a gente foi jantar e foi só isso'?"

# game/scripts/c32/c32.rpy:361
translate brazilian c32s001_AmaDate_25b5c5de:

    # mc "*Laugh* I don't care what those little rascals think about our first date."
    mc "*Risos* Eu não tô nem aí pro que aqueles pestinhas vão pensar do nosso primeiro encontro."

# game/scripts/c32/c32.rpy:362
translate brazilian c32s001_AmaDate_90bf980e:

    # mc "Besides, it wasn't just a dinner."
    mc "Além disso, não foi só um jantar."
# game/scripts/c32/c32.rpy:364
translate brazilian c32s001_AmaDate_ef922001:

    # ama "*Laugh* Yeah, yeah. *Imitating [mc]* 'I spent two hours watching the setting sun reflecting in your mother's eyes.'"
    ama "*Rindo* É, é. *Imitando [mc]* 'Passei duas horas observando o pôr do sol refletindo nos olhos da sua mãe.'"

# game/scripts/c32/c32.rpy:365
translate brazilian c32s001_AmaDate_825d0bce:

    # ama "'The sea paled with envy before such beauty. The universe stopped time so the sunset would last longer just for us.'"
    ama "'O mar empalideceu de inveja diante de tanta beleza. O universo parou o tempo para que o pôr do sol durasse mais só para nós.'"

# game/scripts/c32/c32.rpy:366
translate brazilian c32s001_AmaDate_77e751de:

    # mc "*Laugh* Do I really sound that cheesy?"
    mc "*Rindo* Eu realmente pareço tão brega assim?"

# game/scripts/c32/c32.rpy:368
translate brazilian c32s001_AmaDate_8502cadb:

    # ama "That was a watered-down imitation of your cheesiness. But I don't like it any less for it."
    ama "Essa foi uma imitação suavizada da sua cafonice. Mas eu não gosto menos de você por isso."

# game/scripts/c32/c32.rpy:369
translate brazilian c32s001_AmaDate_014601af:

    # mc "*Imitating a tough guy* Hey, you, driver. Are we there yet? You drive like a grandma!"
    mc "*Imitando um cara durão* Ei, você, motorista. Já chegamos? Você dirige que nem uma avó!"

# game/scripts/c32/c32.rpy:371
translate brazilian c32s001_AmaDate_b936ee4d:

    # ama "*Laugh* You can't even get it right when you try, [mc]. It's not in your character to talk like that."
    ama "*Rindo* Você não consegue nem acertar quando tenta, [mc]. Não faz o seu estilo falar assim."

# game/scripts/c32/c32.rpy:372
translate brazilian c32s001_AmaDate_603a1586:

    # ama "And nobody wants you to, or even wants you to try to change. You're a tough guy in many other ways."
    ama "E ninguém quer que você fale, ou sequer quer que você tente mudar. Você é um cara durão de muitas outras formas."

# game/scripts/c32/c32.rpy:373
translate brazilian c32s001_AmaDate_5bcf09f4:

    # mc "*Laugh* I think that's the first time anyone's called me a tough guy."
    mc "*Rindo* Acho que essa é a primeira vez que alguém me chama de cara durão."

# game/scripts/c32/c32.rpy:375
translate brazilian c32s001_AmaDate_e0f88d70:

    # ama "Few people have seen how you dealt with [kev] or [sol]."
    ama "Poucas pessoas viram como você lidou com o [kev] ou o [sol]."

# game/scripts/c32/c32.rpy:376
translate brazilian c32s001_AmaDate_d9ff6e54:

    # ama "Someone isn't tough because of how they talk, but because of how they act when it really matters."
    ama "Alguém não é durão pelo jeito que fala, mas pelo jeito que age quando realmente importa."

# game/scripts/c32/c32.rpy:377
translate brazilian c32s001_AmaDate_c53c0510:

    # mc "Well, with [sol], [eva] and you had to save my ass. And if you hadn't shown up at [sca]'s house..."
    mc "Bom, com o [sol], a [eva] e você tiveram que salvar meu rabo. E se você não tivesse aparecido na casa da [sca]..."
# game/scripts/c32/c32.rpy:379
translate brazilian c32s001_AmaDate_e8c9cbd6:

    # ama "That's not important. What matters is that [kia] was part of the family and you defended her."
    ama "Isso não é importante. O que importa é que a [kia] fazia parte da família e você a defendeu."

# game/scripts/c32/c32.rpy:380
translate brazilian c32s001_AmaDate_5cd8c9d0:

    # ama "That you defended [sca] in her house, confronting [kev]. I just stopped him from pressing charges against you."
    ama "Que você defendeu a [sca] na casa dela, confrontando o [kev]. Eu só impedi que ele prestasse queixa contra você."

# game/scripts/c32/c32.rpy:381
translate brazilian c32s001_AmaDate_72dd2ab2:

    # ama "That you faced armed mercenaries when [erc] held you hostage at [nor]'s house."
    ama "Que você enfrentou mercenários armados quando o [erc] te fez de refém na casa da [nor]."

# game/scripts/c32/c32.rpy:383
translate brazilian c32s001_AmaDate_ab03d45d:

    # ama "That you stopped [ich] in his tracks when it was necessary to defend [kim]."
    ama "Que você parou o [ich] quando foi necessário para defender a [kim]."

# game/scripts/c32/c32.rpy:384
translate brazilian c32s001_AmaDate_1b59a524:

    # ama "A lot of those tough guys you were trying to imitate would have folded under those circumstances."
    ama "Muitos daqueles caras durões que você tentava imitar teriam arregado nessas circunstâncias."

# game/scripts/c32/c32.rpy:386
translate brazilian c32s001_AmaDate_1c3a390f:

    # ama "And, by the way, we've arrived. Don't ever say I drive like a grandma again."
    ama "E, a propósito, chegamos. Nunca mais diga que eu dirijo como uma avó."

# game/scripts/c32/c32.rpy:387
translate brazilian c32s001_AmaDate_d2645100:

    # mc "*Laugh* As long as I don't say you cook like a grandma, you can't complain."
    mc "*Risos* Contanto que eu não diga que você cozinha como uma avó, você não pode reclamar."

# game/scripts/c32/c32.rpy:389
translate brazilian c32s001_AmaDate_94fb603e:

    # "You pay for the excursion and board a beautiful sailboat where you put on some wetsuits."
    "Você paga pela excursão e embarca em um lindo veleiro onde vocês vestem roupas de mergulho."

# game/scripts/c32/c32.rpy:390
translate brazilian c32s001_AmaDate_ce1d816b:

    # "The guy on the boat tells you that you got lucky. You'll be alone during the excursion."
    "O cara do barco diz que vocês deram sorte. Vocês estarão sozinhos durante a excursão."

# game/scripts/c32/c32.rpy:391
translate brazilian c32s001_AmaDate_be06eba6:

    # "On the previous excursion, there were eight Russian tourists. Some of them drunk. He says it wasn't a pleasant experience."
    "Na excursão anterior, havia oito turistas russos. Alguns deles bêbados. Ele diz que não foi uma experiência agradável."

# game/scripts/c32/c32.rpy:393
translate brazilian c32s001_AmaDate_eedc870d:

    # "After sailing for a while..."
    "Depois de navegar por um tempo..."
# game/scripts/c32/c32.rpy:394
translate brazilian c32s001_AmaDate_b69a5b0c:

    # usn "Well, we've arrived. All you have to do now, is to enjoy."
    usn "Bom, chegamos. Tudo que vocês têm que fazer agora é aproveitar."

# game/scripts/c32/c32.rpy:395
translate brazilian c32s001_AmaDate_a5d3b85c:

    # "He speaks with a Colombian accent so thick it makes [oma] sound like an Oxford native."
    "Ele fala com um sotaque colombiano tão forte que faz a [oma] parecer uma nativa de Oxford."

# game/scripts/c32/c32.rpy:396
translate brazilian c32s001_AmaDate_47df0b8f:

    # usn "I'll light up the coolest areas with that spotlight back there. You have 45 minutes to enjoy."
    usn "Vou iluminar as áreas mais legais com aquele holofote ali atrás. Vocês têm 45 minutos para aproveitar."

# game/scripts/c32/c32.rpy:398
translate brazilian c32s001_AmaDate_fa5a7068:

    # ama "Are there any safety guidelines?"
    ama "Tem alguma instrução de segurança?"

# game/scripts/c32/c32.rpy:399
translate brazilian c32s001_AmaDate_6ec9608d:

    # "Of course, [ama] looks better in her wetsuit than you do in yours."
    "Claro que a [ama] fica melhor na roupa de mergulho dela do que você na sua."

# game/scripts/c32/c32.rpy:401
translate brazilian c32s001_AmaDate_2768801e:

    # usn "*Laugh* Don't forget to come up to the surface to breathe."
    usn "*Risos* Não se esqueçam de subir à superfície para respirar."

# game/scripts/c32/c32.rpy:402
translate brazilian c32s001_AmaDate_b446bb87:

    # usn "I'm serious. Don't wait until you run out of air."
    usn "Tô falando sério. Não esperem até ficarem sem ar."

# game/scripts/c32/c32.rpy:403
translate brazilian c32s001_AmaDate_8dc5f1df:

    # usn "It's easy to lose track of time down there, surrounded by so much beauty."
