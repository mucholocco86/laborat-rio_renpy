    # mc "And I hope you take [mar]'s place while she hugs [bet] and [ama]."
    mc "E eu espero que você tome o lugar da [mar] enquanto ela abraça a [bet] e a [ama]."

# game/scripts/c32/c32.rpy:2889
translate brazilian c32s004_MarSamArrival_f0ad2dd6:

    # "The nurse takes over your arms the moment [mar] frees them. Your lips, too."
    "A enfermeira toma conta dos seus braços no momento em que [mar] os liberta. Dos seus lábios, também."

# game/scripts/c32/c32.rpy:2892
