translate brazilian c29s004_BetMeeCall_d65aa413:

    # bet "Ciao! *Laugh* I have to practice my Italian so I can order the pizza correctly."
    bet "Ciao! *Risos* Tenho que praticar meu italiano pra poder pedir a pizza direito."

# game/scripts/c29/c29.rpy:2032
