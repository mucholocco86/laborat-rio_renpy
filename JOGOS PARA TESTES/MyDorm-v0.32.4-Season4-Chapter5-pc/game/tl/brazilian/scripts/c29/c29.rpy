    mc "Infelizmente, tem umas garotas esperando você para assistir a um programa de TV."

# game/scripts/c29/c29.rpy:4520
translate brazilian c29s007_KiaWatersports_15300ec3:

    # kia "You're right. I'm going to have to leave, or they'll start wondering where I am."
    kia "Você tem razão. Vou ter que ir, ou elas vão começar a se perguntar onde eu estou."

# game/scripts/c29/c29.rpy:4524
translate brazilian c29s007_KiaWatersports_50761504:

    # "You walk her to the hallway, where you met a few minutes ago."
    "Você a acompanha até o corredor, onde se encontraram alguns minutos atrás."

# game/scripts/c29/c29.rpy:4526
translate brazilian c29s007_KiaWatersports_aedaa5e2:

    # mc "It was good to try it, and I'm not saying we won't repeat it, but right now I just need to go to the bathroom."
    mc "Foi bom experimentar, e não estou dizendo que não vamos repetir, mas agora eu só preciso ir ao banheiro."

# game/scripts/c29/c29.rpy:4528
translate brazilian c29s007_KiaWatersports_bdafcfcd:

    # kia "Don't worry. I understand. The situation is different than in that hotel shower."
    kia "Não se preocupe. Eu entendo. A situação é diferente daquele chuveiro de hotel."

# game/scripts/c29/c29.rpy:4529
translate brazilian c29s007_KiaWatersports_e19a6a51:

    # mc "It doesn't bother you, right?"
    mc "Isso não te incomoda, né?"

# game/scripts/c29/c29.rpy:4530
translate brazilian c29s007_KiaWatersports_582df8c0:

    # kia "No. It's understandable. It's different doing it in the heat of the moment than now."
    kia "Não. É compreensível. É diferente fazer isso no calor do momento do que agora."

# game/scripts/c29/c29.rpy:4533
translate brazilian c29s007_KiaWatersports_65d82413:

    # kia "I'll let you go to the bathroom before you have an accident."
    kia "Vou deixar você ir ao banheiro antes que tenha um acidente."

# game/scripts/c29/c29.rpy:4534
translate brazilian c29s007_KiaWatersports_7888d23f:

    # kia "See you tomorrow, [mc]."
    kia "Até amanhã, [mc]."

# game/scripts/c29/c29.rpy:4535
translate brazilian c29s007_KiaWatersports_22a24876_1:

    # mc "See you tomorrow, beautiful."
    mc "Até amanhã, linda."

# game/scripts/c29/c29.rpy:4537
translate brazilian c29s007_KiaWatersports_63158096:

    # "You go up to your room, thinking it would have been nice to give her that back massage."
    "Você sobe para o seu quarto, pensando que teria sido bom dar aquela massagem nas costas dela."

# game/scripts/c29/c29.rpy:4541
translate brazilian c29s009_ScaDapTeaser_24b393ba:

    # "You find a surprise when you arrive at your room."
    "Você encontra uma surpresa quando chega ao seu quarto."

# game/scripts/c29/c29.rpy:4542
translate brazilian c29s009_ScaDapTeaser_93a1608b:

    # dap "We thought you were never going to arrive."
    dap "Achamos que você nunca ia chegar."

# game/scripts/c29/c29.rpy:4543
translate brazilian c29s009_ScaDapTeaser_cac640ae:

    # sca "We've been waiting for you for a while."
    sca "Estamos esperando por você há um tempo."

