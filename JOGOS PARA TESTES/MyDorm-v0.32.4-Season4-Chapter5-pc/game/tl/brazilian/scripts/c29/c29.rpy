    # mc "See you Tuesday. Have fun."
    mc "Vejo vocês na terça. Divirtam-se."

# game/scripts/c29/c29.rpy:2045
translate brazilian c29s004_SamMegMarTattoo_bc4a0b78:

    # "Meanwhile, in a cafe on the other side of Newport..."
    "Enquanto isso, em um café do outro lado de Newport..."

# game/scripts/c29/c29.rpy:2047
translate brazilian c29s004_SamMegMarTattoo_d6768315:

    # mar "Well, it's done. It wasn't that bad, right?"
    mar "Bom, tá feito. Não foi tão ruim, né?"

# game/scripts/c29/c29.rpy:2048
translate brazilian c29s004_SamMegMarTattoo_709bc7a9:

    # meg "I really thought it was going to be much worse. It was very bearable."
    meg "Eu realmente achei que ia ser muito pior. Foi bem suportável."

# game/scripts/c29/c29.rpy:2049
