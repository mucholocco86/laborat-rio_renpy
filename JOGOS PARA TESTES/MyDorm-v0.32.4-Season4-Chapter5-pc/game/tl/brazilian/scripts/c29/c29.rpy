translate brazilian c29s004_BetMeeCall_d953e167:

    # mc "Why? What happened?"
    mc "Por quê? O que aconteceu?"

# game/scripts/c29/c29.rpy:1956
translate brazilian c29s004_BetMeeCall_8d8279c7:

    # mee "A house sells better if it's decorated... Well, if it's decorated with minimal taste. At least for a certain type of client."
    mee "Uma casa vende melhor se estiver decorada... Bom, se estiver decorada com um mínimo de bom gosto. Pelo menos para um certo tipo de cliente."

# game/scripts/c29/c29.rpy:1957
translate brazilian c29s004_BetMeeCall_61b5d4fb:

    # mee "Buyers can see how the spaces in the house look and get an idea of how it would look with their furniture."
