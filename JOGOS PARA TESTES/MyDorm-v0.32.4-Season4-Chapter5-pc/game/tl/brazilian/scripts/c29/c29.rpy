translate brazilian c29s004_BetMeeCall_ef9fc207:

    # mee "And we love you too." (multiple=2)
    mee "E nós também te amamos." (multiple=2)

# game/scripts/c29/c29.rpy:2023
translate brazilian c29s004_BetMeeCall_1b6c33dd:

    # bet "We do too." (multiple=2)
    bet "Nós também." (multiple=2)

# game/scripts/c29/c29.rpy:2026
