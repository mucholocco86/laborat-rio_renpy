    ama "Eu compartilhei um quarto com [mar], [eva] com [emm] e [oma] com [sai]."

# game/scripts/c27/c27.rpy:2937
translate brazilian c27s004_KatBreakfast_57137de4:

    # oma "Y con [eil]. Te lo perdiste, estuvo muy bien. Estuvimos estrechando lazos."
    oma "E com [eil]. Você perdeu, foi ótimo. Estávamos fortalecendo nosso vínculo."

# game/scripts/c27/c27.rpy:2938
translate brazilian c27s004_KatBreakfast_a5eed460:

    # oma "Las que no tenemos tantas oportunidades de pasar tiempo en casa las tenemos que aprovechar."
