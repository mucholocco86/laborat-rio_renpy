    mc "Fiquei surpreso(a) em te ver aqui."

# game/scripts/c27/c27.rpy:2933
translate brazilian c27s004_KatBreakfast_25454c7d:

    # ama "Bueno, anoche nos pusimos en plan familia y algunas nos quedamos a dormir."
