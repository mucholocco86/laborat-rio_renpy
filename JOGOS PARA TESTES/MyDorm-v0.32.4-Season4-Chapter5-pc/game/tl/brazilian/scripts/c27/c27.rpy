    # mc "¿Qué tal la noche durmiendo en camas ajenas?"
    mc "Como foi sua noite dormindo na cama de outras pessoas?"

# game/scripts/c27/c27.rpy:2954
translate brazilian c27s004_KatBreakfast_96b55a0d:

    # eva "Demasiado rosa para mi gusto en esa habitación, pero muy bien."
