# game/scripts/c27/c27.rpy:2959
translate brazilian c27s004_KatBreakfast_13c0664e:

    # oma "Compartir cama con [sai] y [eil] es un poco complicado. *Risa* Creo que todas acabamos con pelo de las otras en la cara durante la noche."
    oma "Dividir a cama com [sai] e [eil] é um pouco complicado. *Risos* Acho que todos acabamos com o cabelo um do outro no rosto durante a noite."

# game/scripts/c27/c27.rpy:2960
translate brazilian c27s004_KatBreakfast_145009ff:

