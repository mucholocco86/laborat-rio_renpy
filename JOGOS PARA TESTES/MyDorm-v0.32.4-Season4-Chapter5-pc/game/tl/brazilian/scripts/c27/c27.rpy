# game/scripts/c27/c27.rpy:2957
translate brazilian c27s004_KatBreakfast_7fb6a97e:

    # emm "No traía pijama y le he prestado uno mío. Pero con lo que acaba de decir, creo que le voy a obligar a quitárselo. *Risa*"
