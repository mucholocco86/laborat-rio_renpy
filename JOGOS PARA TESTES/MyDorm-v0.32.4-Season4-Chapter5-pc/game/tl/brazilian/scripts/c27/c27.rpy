# game/scripts/c27/c27.rpy:2950
translate brazilian c27s004_KatBreakfast_59474397:

    # mc "¿Y qué tal la noche durmiendo en camas ajenas?"
    mc "E como foi a noite dormindo na cama de outras pessoas?"

