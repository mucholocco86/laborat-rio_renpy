    mc "Mas vou me sentir muito sozinho lá."

# game/scripts/c27/c27.rpy:3027
translate brazilian c27s004_MeeBetFarewell_2692e43f:

    # mee "Bueno, vas con [ama] y después irá [eva]. ¿Vivirán contigo?"
    mee "Certo, você escolhe [ama] e depois [eva]. Eles vão morar com você?"

# game/scripts/c27/c27.rpy:3028
translate brazilian c27s004_MeeBetFarewell_f522f3b5:

    # mc "Aún no lo hemos hablado. Aaron también es su familia y él vive en la base. No sé qué querrán hacer ellas."
    mc "Ainda não conversamos sobre isso. Aaron também é como da família para eles e mora na base. Não sei o que eles querem fazer."

# game/scripts/c27/c27.rpy:3031
translate brazilian c27s004_MeeBetFarewell_0e5a408f:

    # mee "Yo lo tendría clarísimo. ¿Cuántas camas hay en esa casa? Porque las querré probar todas cuando vaya a verte."
    mee "Eu saberia exatamente o que fazer. Quantas camas tem naquela casa? Porque eu vou querer experimentar todas quando for te visitar."

# game/scripts/c27/c27.rpy:3032
translate brazilian c27s004_MeeBetFarewell_797a78c3:

    # mc "*Risa* Veo que alguien quiere recuperar el tiempo perdido."
    mc "*Risos* Vejo que alguém quer recuperar o tempo perdido."

# game/scripts/c27/c27.rpy:3033
translate brazilian c27s004_MeeBetFarewell_82c1f004:

    # mc "*Risa* En ese caso, sería mejor para tus planes que [ama] y [eva] durmieran en la base."
    mc "*Risos* Nesse caso, seria melhor para seus planos se [ama] e [eva] dormissem na base."

# game/scripts/c27/c27.rpy:3036
translate brazilian c27s004_MeeBetFarewell_c59bd940:

    # mee "*Risa* Seguro que sí. Lo de decirles 'vete a dormir al sofá porque mi nieto y yo vamos a follar en tu cama' no parece diplomático."
    mee "*Risos* Tenho certeza disso. Dizer para eles \"vão dormir no sofá porque meu neto e eu vamos transar na cama de vocês\" não parece nada diplomático."

# game/scripts/c27/c27.rpy:3038
translate brazilian c27s004_MeeBetFarewell_916a31d2:

    # mee "*Risa* Seguro que sí. Lo de decirles 'vete a dormir al sofá porque [mc] y yo vamos a follar en tu cama' no parece diplomático."
    mee "*Risos* Tenho certeza que sim. Dizer para eles \"vão dormir no sofá porque eu e [mc] vamos transar na cama de vocês\" não parece nada diplomático."

# game/scripts/c27/c27.rpy:3040
translate brazilian c27s004_MeeBetFarewell_b76347d2:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que se quisieran unir, aunque en el caso de [ama] lo dudo."
    mc "*Risos* Acho que não. Além disso, eles podem querer unir forças, embora no caso do [ama] eu duvide."

# game/scripts/c27/c27.rpy:3041
translate brazilian c27s004_MeeBetFarewell_c044b689:

    # mc "Pero no me sorprendería que [eva] quisiera estrechar lazos contigo con un trío."
    mc "Mas não me surpreenderia se [eva] quisesse se aproximar de você com um ménage à trois."

# game/scripts/c27/c27.rpy:3043
translate brazilian c27s004_MeeBetFarewell_6fbad351:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que [ama] uniera, aunque lo dudo."
    mc "*Risos* Acho que não. Além disso, é possível que [ama] se una, embora eu duvide."

# game/scripts/c27/c27.rpy:3045
translate brazilian c27s004_MeeBetFarewell_ebb9d771:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que [eva] se quisiera unir. No me sorprendería que quisiera estrechar lazos contigo con un trío."
    mc "*Risos* Acho que não. Além disso, é possível que [eva] queira participar. Não me surpreenderia se ele quisesse se aproximar de você em um ménage à trois."

# game/scripts/c27/c27.rpy:3047
translate brazilian c27s004_MeeBetFarewell_2850f646:

    # mc "*Risa* Creo que no lo sería."
    mc "*Risos* Acho que não."

# game/scripts/c27/c27.rpy:3048
translate brazilian c27s004_MeeBetFarewell_25c265ea:

    # mc "Pero podemos probar todas las camas no ocupadas."
    mc "Mas podemos experimentar todas as camas desocupadas."

# game/scripts/c27/c27.rpy:3051
translate brazilian c27s004_MeeBetFarewell_be8d3267:

    # "Tu abuela te da un beso como pocos nietos han recibido de sus abuelas."
    "Sua avó lhe dá um beijo como poucos netos receberam de suas avós."

# game/scripts/c27/c27.rpy:3053
translate brazilian c27s004_MeeBetFarewell_cae9380c:

    # "[mee] te da un beso como pocos nietos han recibido de sus abuelas. Da lo mismo que no estéis emparentados. Siempre será tu abuela."
    "Ela te dá um beijo como poucos netos receberam de suas avós. Não importa que vocês não sejam parentes. Ela sempre será sua avó."

# game/scripts/c27/c27.rpy:3054
translate brazilian c27s004_MeeBetFarewell_f42214e9:

    # "Es un beso que sabe a despedida."
    "É um beijo com gosto de despedida."

# game/scripts/c27/c27.rpy:3056
translate brazilian c27s004_MeeBetFarewell_afc77b99:

    # mee "Deberías bajar la maleta e ir a ver a [bet]. Es posible que ella también necesite ayuda."
    mee "Você deve levar sua mala para baixo e ir ver [bet]. Ela também pode precisar de ajuda."

# game/scripts/c27/c27.rpy:3057
translate brazilian c27s004_MeeBetFarewell_36c3f932:

    # mee "Y no quiero alargar nuestra despedida más de lo necesario o me voy a poner triste antes de irme."
    mee "E não quero prolongar nossa despedida mais do que o necessário, senão ficarei triste antes de ir embora."

# game/scripts/c27/c27.rpy:3058
translate brazilian c27s004_MeeBetFarewell_8231049d:

    # mc "De acuerdo. Y no te pongas triste. Nos veremos en menos de una semana."
    mc "Certo. E não fique triste. Nos veremos em menos de uma semana."

# game/scripts/c27/c27.rpy:3060
translate brazilian c27s004_MeeBetFarewell_b511dc15:

    # mee "Hasta dentro de una semana, [mc]."
    mee "Até daqui a uma semana, [mc]."

# game/scripts/c27/c27.rpy:3061
translate brazilian c27s004_MeeBetFarewell_d4b33b85:

    # mc "Hasta dentro de una semana, Meemaw."
    mc "Te vejo daqui a uma semana, vovó."

# game/scripts/c27/c27.rpy:3064
translate brazilian c27s004_MeeBetFarewell_a302fc1a:

    # "Bajas la maleta de [mee] a la planta baja y vas a ver a [bet]."
    "Você pega a mala de [mee] lá embaixo e vai ver [bet]."

# game/scripts/c27/c27.rpy:3065
translate brazilian c27s004_MeeBetFarewell_c6a7df6d:

    # mc "Hola, Tía [bet]. ¿Necesitas ayuda con las maletas?"
    mc "Olá tia [bet]. Precisa de ajuda com as malas?"

# game/scripts/c27/c27.rpy:3066
translate brazilian c27s004_MeeBetFarewell_67d948a9:

    # bet "No hace falta. Era solo una y la he bajado hace un rato. Ya está en el coche de [nor]."
    bet "Não precisa. Era só um e eu tirei faz um tempo. Já está no carro do [nor]."

# game/scripts/c27/c27.rpy:3067
translate brazilian c27s004_MeeBetFarewell_feda2bd5:

    # mc "Perfecto, acabo de bajar la de Meemaw. Dejo que te acabes de vestir, entonces."
    mc "Perfeito, acabei de baixar o aplicativo da vovó. Vou deixar você terminar de se vestir, então."

# game/scripts/c27/c27.rpy:3069
translate brazilian c27s004_MeeBetFarewell_71b37506:

    # bet "Te voy a echar mucho de menos."
    bet "Vou sentir muita saudade de você."

# game/scripts/c27/c27.rpy:3070
translate brazilian c27s004_MeeBetFarewell_94a17613:

    # mc "Y yo a ti, pero Meemaw me ha dicho que estaréis fuera menos de una semana."
    mc "Eu também te amo, mas a vovó me disse que você vai ficar fora por menos de uma semana."

# game/scripts/c27/c27.rpy:3071
translate brazilian c27s004_MeeBetFarewell_221f7234:

    # mc "Y después espero que vengas a Aruba conmigo para operar a Gavin."
    mc "E então espero que você venha comigo a Aruba para operar o Gavin."

# game/scripts/c27/c27.rpy:3073
translate brazilian c27s004_MeeBetFarewell_2fd3634b:

    # bet "Aún tengo que acabar de estudiar la información que me ha mandado Aaron, pero creo que iré finalmente."
    bet "Ainda preciso terminar de estudar as informações que o Aaron me enviou, mas acho que finalmente vou."

# game/scripts/c27/c27.rpy:3074
translate brazilian c27s004_MeeBetFarewell_8603f6b3:

    # bet "La perspectiva de hacer una operación que no se ha hecho nunca es el sueño de cualquier cirujano."
    bet "A perspectiva de realizar uma operação nunca antes feita é o sonho de todo cirurgião."

# game/scripts/c27/c27.rpy:3075
translate brazilian c27s004_MeeBetFarewell_d91b64eb:

    # mc "Entonces no tendrás mucho tiempo para echarme de menos."
    mc "Então você não terá muito tempo para sentir minha falta."

# game/scripts/c27/c27.rpy:3077
translate brazilian c27s004_MeeBetFarewell_427bd3f8:

    # bet "Pero entonces echaré de menos a todas las chicas. Incluso a [mee]."
    bet "Mas aí vou sentir falta de todas as garotas. Até mesmo da [mee]."

# game/scripts/c27/c27.rpy:3078
translate brazilian c27s004_MeeBetFarewell_5f0efc15:

    # mc "Sobre eso no puedo hacer mucho. Yo también las voy a echar de menos."
    mc "Não há muito que eu possa fazer quanto a isso. Também vou sentir falta deles."

# game/scripts/c27/c27.rpy:3081
translate brazilian c27s004_MeeBetFarewell_9500ecfc:

    # bet "Bueno, vete ya antes de que se me salten las lágrimas. Tengo que acabar de vestirme."
    bet "Ok, pode ir agora antes que eu comece a chorar. Preciso terminar de me vestir."

# game/scripts/c27/c27.rpy:3082
translate brazilian c27s004_MeeBetFarewell_28ab7de5:

    # mc "OK. Te veo abajo."
    mc "Certo. Te vejo lá embaixo."

# game/scripts/c27/c27.rpy:3085
translate brazilian c27s004_MeeBetFarewell_a0b4fbbe:

    # "Al pasar por delante de la puerta de [mee] oyes voces en el interior."
    "Ao passar pela porta de [mee] você ouve vozes lá dentro."

# game/scripts/c27/c27.rpy:3086
translate brazilian c27s004_MeeBetFarewell_b3a82761:

    # mee "*A través de la puerta* Hola, [mad.nick], dime..."
    mee "*Através da porta* Olá, [mad.nick], diga-me..."

# game/scripts/c27/c27.rpy:3089
translate brazilian c27s004_MeeBetFarewell_9553287f:

    # bet "Por otro lado, tengo ganas de estar tiempo a solas contigo en Aruba."
    bet "Por outro lado, estou ansioso para passar um tempo a sós com você em Aruba."

# game/scripts/c27/c27.rpy:3090
translate brazilian c27s004_MeeBetFarewell_be5410f6:

    # mc "No sé si vamos a tener mucho tiempo libre, pero lo pasaremos juntos."
    mc "Não sei se teremos muito tempo livre, mas vamos aproveitá-lo juntos."

# game/scripts/c27/c27.rpy:3092
translate brazilian c27s004_MeeBetFarewell_08ca220d:

    # bet "*Risa* Si hacer esa operación imposible no fuera incentivo suficiente para ir, pasar tiempo contigo en un paraíso tropical sería un aliciente extra."
    bet "*Risos* Se realizar essa operação impossível não fosse incentivo suficiente para ir, passar um tempo com você em um paraíso tropical seria um incentivo extra."

# game/scripts/c27/c27.rpy:3093
translate brazilian c27s004_MeeBetFarewell_0cc2bfc0:

    # mc "*Risa* A mí lo del paraíso tropical no me suena demasiado bien. Calor, humedad, mosquitos..."
    mc "*Risos* Essa coisa toda de paraíso tropical não me parece muito atraente. Calor, umidade, mosquitos..."

# game/scripts/c27/c27.rpy:3095
translate brazilian c27s004_MeeBetFarewell_c78f41a4:

    # bet "*Risa* Entonces haremos el amor dentro de tu casa, bajo el aire acondicionado."
    bet "*Risos* Então faremos amor dentro da sua casa, com o ar condicionado ligado."

# game/scripts/c27/c27.rpy:3096
translate brazilian c27s004_MeeBetFarewell_10a004f4:

    # mc "*Risa* Me parece una idea fantástica."
    mc "*Risos* Acho que é uma ideia fantástica."

# game/scripts/c27/c27.rpy:3098
translate brazilian c27s004_MeeBetFarewell_e19ccd08:

    # "La ex-monja te da un beso dulce en el que hay anticipación, pero también algo de tristeza por el tiempo que vais a pasar separados."
    "A ex-freira te dá um beijo doce, cheio de expectativa, mas também com um toque de tristeza pelo tempo que vocês passarão separados."

# game/scripts/c27/c27.rpy:3099
translate brazilian c27s004_MeeBetFarewell_d6b3a35e:

    # "No habéis tenido muchas oportunidades de pasar tiempo juntos desde el viaje a Monterey y ahora ella se tiene que ir."
    "Vocês não tiveram muitas oportunidades de passar tempo juntos desde a viagem a Monterey, e agora ela tem que ir embora."

# game/scripts/c27/c27.rpy:3100
translate brazilian c27s004_MeeBetFarewell_e170e6ec:

    # "Aún no sabes cuánto tiempo estará ella en Aruba para la operación, lo que sabes es que lo vais a aprovechar."
    "Você ainda não sabe quanto tempo ela ficará em Aruba para a cirurgia, mas sabe que vai aproveitar ao máximo esse tempo."

# game/scripts/c27/c27.rpy:3102
translate brazilian c27s004_MeeBetFarewell_57ef5208:

    # bet "Deberías irte antes de que te tumbe en la cama o perderé el avión."
    bet "É melhor você ir embora antes que eu te mande para a cama, senão vou perder meu voo."

# game/scripts/c27/c27.rpy:3103
translate brazilian c27s004_MeeBetFarewell_6d28a58f:

    # mc "*Risa* Entonces voy a dejar que te vistas. Te veo abajo, [bet]."
    mc "*Risos* Então vou deixar você se vestir. Te vejo lá embaixo, [bet]."

# game/scripts/c27/c27.rpy:3106
translate brazilian c27s004_MeeBetFarewell_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:3107
translate brazilian c27s004_MeeBetFarewell_a7399e02:

    # "Mientras te diriges a la puerta de su habitación, suena el teléfono de [bet]."
    "Enquanto você se dirige para a porta do quarto dele, o telefone de [bet] toca."

# game/scripts/c27/c27.rpy:3108
translate brazilian c27s004_MeeBetFarewell_81c9703e:

    # bet "Hola, [mad.nick], dime..."
    bet "Olá, [mad.nick], diga-me..."

# game/scripts/c27/c27.rpy:3110
translate brazilian c27s004_MeeBetFarewell_4371cdd5:

    # mcp "(Estoy super contento con las dinámicas que se están creando en la familia. Que [mad.nick] llame para despedirse es una muestra de ello.)"
    mcp "(Estou muito feliz com a dinâmica que está se desenvolvendo na família. A ligação de despedida é a prova disso.)"

# game/scripts/c27/c27.rpy:3112
translate brazilian c27s004_MeeBetFarewell_46b5b83d:

    # "Bajas a la cocina a esperar a que las mujeres acaben de arreglarse y con la esperanza de poder preguntarle a [nor] o a [kim] sobre lo que le pasa a [kat]."
    "Você desce até a cozinha para esperar que as mulheres terminem de se arrumar, na esperança de poder perguntar a [nor] ou [kim] o que há de errado com [kat]."

# game/scripts/c27/c27.rpy:3114
translate brazilian c27s004_MeeBetFarewell_fe049a43:

    # "Por desgracia, preguntarles sobre [kat] con [kat] delante no es una opción."
    "Infelizmente, perguntar sobre [kat] com [kat] na frente não é uma opção."

# game/scripts/c27/c27.rpy:3115
translate brazilian c27s004_MeeBetFarewell_96b1bfb2:

    # "Menos aún cuando [kat] rehúye tu mirada. Cada vez estás seguro de que le pasa algo."
    "Menos ainda quando [kat] evita seu olhar. Você está cada vez mais certo de que algo está errado com ela."

# game/scripts/c27/c27.rpy:3117
translate brazilian c27s004_MeeBetFarewell_c2cf213b:

    # "La despedida de las dos mujeres es demasiado triste."
    "A despedida entre as duas mulheres é muito triste."

# game/scripts/c27/c27.rpy:3118
translate brazilian c27s004_MeeBetFarewell_62fce943:

    # "Es la primera vez desde que se empezó a formar el sentimiento familiar que alguien va a estar fuera durante una semana."
    "É a primeira vez, desde que o espírito de família começou a se formar, que alguém vai ficar fora por uma semana."

# game/scripts/c27/c27.rpy:3119
translate brazilian c27s004_MeeBetFarewell_939927ea:

    # "Se derraman algunas lágrimas, pero las chicas me han pedido que no diga quién lloró. Especialmente [eva]."
    "Algumas lágrimas foram derramadas, mas as meninas me pediram para não dizer quem chorou. Especialmente [eva]."

# game/scripts/c27/c27.rpy:3120
translate brazilian c27s004_MeeBetFarewell_3691ba7a:

    # "¡Oops! Me parezco a [lis] guardando secretos."
    "Ops! Parece que estou guardando segredos."

# game/scripts/c27/c27.rpy:3122
translate brazilian c27s004_MeeBetFarewell_8416b25b:

    # "Cuando se van, tampoco tienes la oportunidad de hablar con [kim]. Vuelve a casa charlando con [kat]."
    "Quando eles saem, você também não tem a chance de falar com [kim]. Volte para casa conversando com [kat]."

# game/scripts/c27/c27.rpy:3123
translate brazilian c27s004_MeeBetFarewell_9c1c8d5a:

    # "Bueno, habrá tiempo para hablar. O incluso es posible que a [kat] se le pase lo que sea que le está pasando."
    "Bem, haverá tempo para conversar. Ou é até possível que o problema com [kat] seja resolvido."

# game/scripts/c27/c27.rpy:3130
translate brazilian c27s004_ScaInterview_7149bc57:

    # "Ayudas a [emm] a mover los trastos del sótano. Ha hecho un buen trabajo con las pegatinas rosas."
    "Você ajuda [emm] a mover as coisas para o porão. Ela fez um bom trabalho com os adesivos rosa."

# game/scripts/c27/c27.rpy:3131
translate brazilian c27s004_ScaInterview_0c33a256:

    # "Todos los trastos que hay que tirar son fácilmente identificables."
    "Todo o lixo que precisa ser descartado é facilmente identificável."

# game/scripts/c27/c27.rpy:3132
translate brazilian c27s004_ScaInterview_1d1831fd:

    # "[emm] derrama algunas lágrimas cuando ve todas las pegatinas que ha perdido una vez subes las cosas a la camioneta."
    "[emm] Ela derrama algumas lágrimas quando vê todos os adesivos que perdeu depois que você carrega as coisas na van."

# game/scripts/c27/c27.rpy:3133
translate brazilian c27s004_ScaInterview_a7d3ec7e:

    # "Ha intentado recuperar las pegatinas sin éxito."
    "Ele tentou, sem sucesso, recuperar os adesivos."

# game/scripts/c27/c27.rpy:3134
translate brazilian c27s004_ScaInterview_e1793bd0:

    # "[oma] aprovecha su día de fiesta para ayudarte a llevar los trastos al chatarrero antes de comer."
    "[oma] Ele aproveita o dia de folga para te ajudar a levar a sucata para o ferro-velho antes do almoço."

# game/scripts/c27/c27.rpy:3136
translate brazilian c27s004_ScaInterview_732888d7:

    # "Después de comer las chicas van a la piscina y tú vuelves a tu habitación..."
    "Depois do almoço, as meninas vão para a piscina e você volta para o seu quarto..."

# game/scripts/c27/c27.rpy:3138
translate brazilian c27s004_ScaInterview_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c27/c27.rpy:3139
translate brazilian c27s004_ScaInterview_941004dc:

    # eri "*A través de la puerta* Somos nosotras, ¿podemos pasar?"
    eri "*Pela porta* Somos nós, podemos entrar?"

# game/scripts/c27/c27.rpy:3141
translate brazilian c27s004_ScaInterview_157376e5:

    # mc "Adelante, tú y tu silenciosa compañera."
    mc "Vá em frente, você e seu companheiro silencioso."

# game/scripts/c27/c27.rpy:3143
translate brazilian c27s004_ScaInterview_9dbded77:

    # eri "*Risa* Mi silenciosa compañera es [sca]."
    eri "*Risos* Meu companheiro silencioso é [sca]."

# game/scripts/c27/c27.rpy:3144
translate brazilian c27s004_ScaInterview_14ba5775:

    # sca "Hola, [mc]."
    sca "Olá, [mc]."

# game/scripts/c27/c27.rpy:3145
translate brazilian c27s004_ScaInterview_83848b48:

    # mc "¿Te pasa algo, [sca]?"
    mc "Há algo errado, [sca]?"

# game/scripts/c27/c27.rpy:3147
translate brazilian c27s004_ScaInterview_c819908b:

    # eri "Está nerviosa. [eil] me acaba de llamar para decirme que nuestro jefe quiere conocer a [sca]."
    eri "Ela está nervosa. [eil] acabou de me ligar para dizer que nosso chefe quer se encontrar com [sca]."

# game/scripts/c27/c27.rpy:3148
translate brazilian c27s004_ScaInterview_3af951a3:

    # eri "Ayer le hablamos de ella y hoy se pasará por el café. ¿Nos puedes llevar?"
    eri "Nós contamos a ela sobre ela ontem, e ela virá ao café hoje. Você pode nos dar uma carona?"

# game/scripts/c27/c27.rpy:3149
translate brazilian c27s004_ScaInterview_fb875d3b:

    # mc "Claro, ningún problema. ¿Cuándo os tengo que llevar?"
    mc "Claro, sem problema. Quando preciso te trazer?"

# game/scripts/c27/c27.rpy:3151
translate brazilian c27s004_ScaInterview_264982e2:

    # eri "Yo empiezo mi turno en 50 minutos. Si nos llevas a las dos, [sca] puede esperar allí hasta que llegue mi jefe."
    eri "Meu turno começa em 50 minutos. Se você nos levar, [sca] pode esperar lá até meu chefe chegar."

# game/scripts/c27/c27.rpy:3152
translate brazilian c27s004_ScaInterview_e3c40d2c:

    # mc "OK. Podríamos salir en 30 minutos y llegamos con tiempo antes de que empieces el turno."
    mc "Certo. Podemos sair em 30 minutos e chegar bem antes do início do seu turno."

# game/scripts/c27/c27.rpy:3154
translate brazilian c27s004_ScaInterview_cf1a89a2:

    # mc "No estés nerviosa, es sólo una entrevista de trabajo."
    mc "Não fique nervoso, é apenas uma entrevista de emprego."

# game/scripts/c27/c27.rpy:3155
translate brazilian c27s004_ScaInterview_6939201a:

    # sca "Es que va a ser mi primera entrevista. Mi madre no me dejaba trabajar, decía que me tenía que centrar en los estudios."
    sca "Esta será minha primeira entrevista. Minha mãe não me deixava trabalhar; ela dizia que eu tinha que me concentrar nos meus estudos."

# game/scripts/c27/c27.rpy:3156
translate brazilian c27s004_ScaInterview_19f45738:

    # mc "Eres lo suficientemente inteligente como para hacer las dos cosas, [sca]."
    mc "Você é inteligente o suficiente para fazer as duas coisas, [sca]."

# game/scripts/c27/c27.rpy:3157
translate brazilian c27s004_ScaInterview_a90a0a92:

    # mc "Además, estoy seguro de que tanto [eri] como [eil] te han dado consejos."
    mc "Além disso, tenho certeza de que tanto [eri] quanto [eil] lhe deram conselhos."

# game/scripts/c27/c27.rpy:3159
translate brazilian c27s004_ScaInterview_96554d74:

    # eri "Básicamente que se convierta en nuestra esclava mientras esté en el café. *Risa* Es broma."
    eri "Basicamente, queremos que ela se torne nossa escrava enquanto estiver no café. *Risos* Brincadeirinha."

# game/scripts/c27/c27.rpy:3160
translate brazilian c27s004_ScaInterview_3c01bec4:

    # eri "Mi jefe no es muy exigente y ella viene recomendada por nosotras, con lo que tiene muchas posibilidades de que la contrate."
    eri "Meu chefe não é muito exigente, e ela foi recomendada por nós, então há uma boa chance de ele contratá-la."

# game/scripts/c27/c27.rpy:3162
translate brazilian c27s004_ScaInterview_00b08729:

    # eri "Y una vez empiece a trabajar, [eil] y yo moveremos nuestros turnos para que una de las dos esté con ella cada día al menos las primeras semanas."
    eri "E assim que ela começar a trabalhar, [eil] e eu trocaremos nossos turnos para que um de nós fique com ela todos os dias, pelo menos durante as primeiras semanas."

# game/scripts/c27/c27.rpy:3163
translate brazilian c27s004_ScaInterview_73c8887a:

    # mc "Estoy seguro de que eso la ayudará mucho."
    mc "Tenho certeza de que isso a ajudará muito."

# game/scripts/c27/c27.rpy:3165
translate brazilian c27s004_ScaInterview_8b833349:

    # mc "¿Ves? No tienes que estar nerviosa. [eri] y [eil] lo tienen todo planificado."
    mc "Viu? Não precisa ficar nervoso. [eri] e [eil] já têm tudo planejado."

# game/scripts/c27/c27.rpy:3166
translate brazilian c27s004_ScaInterview_acb4c634:

    # sca "Pero es que ya me conocéis. Soy tímida y me cuesta mucho hablar con desconocidos..."
    sca "Mas você me conhece. Sou tímida e tenho muita dificuldade em conversar com estranhos..."

# game/scripts/c27/c27.rpy:3167
translate brazilian c27s004_ScaInterview_d45826f5:

    # sca "¿Y si empiezo a balbucear en la entrevista? ¿Y si me quedo en blanco?"
    sca "E se eu começar a gaguejar durante a entrevista? E se eu travar?"

# game/scripts/c27/c27.rpy:3168
translate brazilian c27s004_ScaInterview_99735a43:

    # mc "¿Y si se te escapa un eructo durante la entrevista?"
    mc "E se você arrotar sem querer durante a entrevista?"

# game/scripts/c27/c27.rpy:3170
translate brazilian c27s004_ScaInterview_92dacd4e:

    # sca "¿Qué?"
    sca "Que?"

# game/scripts/c27/c27.rpy:3171
translate brazilian c27s004_ScaInterview_42f09261:

    # mc "Te estás poniendo nerviosa pensando en todo lo que puede salir mal. *Risa* Yo solo te doy un escenario nuevo en el que no habías pensado."
    mc "Você está ficando nervoso pensando em tudo que pode dar errado. *Risos* Estou apenas lhe apresentando um novo cenário que você não havia considerado."

# game/scripts/c27/c27.rpy:3173
translate brazilian c27s004_ScaInterview_b5c01fcd:

    # sca "¡Eres un capullo! ¡Eso no ayuda!"
    sca "Você é um idiota! Isso não ajuda em nada!"

# game/scripts/c27/c27.rpy:3174
translate brazilian c27s004_ScaInterview_07f595b1:

    # mc "Sí que ayuda. *Risa* La [sca] tímida de hace un mes nunca me hubiera llamado capullo."
    mc "Ajuda sim. *Risos* A garota tímida de um mês atrás jamais teria me chamado de idiota."

# game/scripts/c27/c27.rpy:3175
translate brazilian c27s004_ScaInterview_40ebeab9:

    # mc "Ya no eres la que eras. Desde que llegaron las chicas te has abierto mucho y has perdido la timidez. No tienes que temer nada en la entrevista."
    mc "Você não é mais a mesma pessoa. Desde que as meninas chegaram, você se soltou bastante e perdeu a timidez. Você não tem nada a temer na entrevista."

# game/scripts/c27/c27.rpy:3177
translate brazilian c27s004_ScaInterview_58df713d:

    # eri "¿Ves cómo hemos hecho bien en venir a ver a [mc]? Sabía que te quitaría los nervios."
    eri "Viu? Estávamos certos em vir ver [mc]. Eu sabia que isso acalmaria seus nervos."

# game/scripts/c27/c27.rpy:3178
translate brazilian c27s004_ScaInterview_15e80be3:

    # mc "Veo que no vas con el uniforme. ¿Hablaste con tu jefe respecto a la taquillas de [eil]?"
    mc "Vejo que você não está de uniforme. Você conversou com seu chefe sobre os armários em [eil]?"

# game/scripts/c27/c27.rpy:3180
translate brazilian c27s004_ScaInterview_8c090681:

    # eri "Sí, y fue la cosa más tonta del mundo. Él creía que ya compartíamos taquilla porque somos amigas."
    eri "Sim, e foi a coisa mais idiota de todas. Ele achou que já dividíamos o armário porque somos amigos."

# game/scripts/c27/c27.rpy:3181
translate brazilian c27s004_ScaInterview_c7700068:

    # eri "Dijo que todo el mundo lo hace..."
    eri "Ele disse que todo mundo faz isso..."

# game/scripts/c27/c27.rpy:3182
translate brazilian c27s004_ScaInterview_b8183412:

    # mc "*Risa* Todo el mundo lo pensó menos vosotras. Sois demasiado legales."
    mc "*Risos* Todo mundo pensou isso, menos você. Você é muito cumpridor da lei."

# game/scripts/c27/c27.rpy:3184
translate brazilian c27s004_ScaInterview_91b2843c:

    # sca "Pues voy a cambiarme de ropa para la entrevista. No creo que ir así sea lo mejor..."
    sca "Bem, vou trocar de roupa para a entrevista. Acho que ir assim não é a melhor ideia..."

# game/scripts/c27/c27.rpy:3185
translate brazilian c27s004_ScaInterview_069acffe:

    # mc "Nope. En eso tienes razón. *Risa* Aunque yo te contrataría."
    mc "Não. Você tem razão. *Risos* Embora eu te contratasse."

# game/scripts/c27/c27.rpy:3187
translate brazilian c27s004_ScaInterview_bb6d2873:

    # "Las dos chicas se van y te dejan solo en la habitación."
    "As duas garotas saem e te deixam sozinho no quarto."

# game/scripts/c27/c27.rpy:3189
translate brazilian c27s004_ScaInterview_f92ce853:

    # "Bajas a sacar la camioneta del garaje unos minutos antes de lo acordado."
    "Você desce para tirar o caminhão da garagem alguns minutos antes do combinado."

# game/scripts/c27/c27.rpy:3191
translate brazilian c27s004_ScaInterview_bd1ed2d9:

    # "[eri] y [sca] ya te están esperando. Los nervios no han desaparecido del todo."
    "[eri] e [sca] já estão à sua espera. O nervosismo ainda não desapareceu completamente."

# game/scripts/c27/c27.rpy:3193
translate brazilian c27s004_ScaInterview_f85205d9:

    # "Durante el trayecto [sca] hace mil preguntas a [eri]. Quiere saber cómo funciona todo antes de la entrevista."
    "Durante a viagem, [sca] faz [eri] mil perguntas. Ele quer saber como tudo funciona antes da entrevista."

# game/scripts/c27/c27.rpy:3195
translate brazilian c27s004_ScaInterview_3055ef57:

    # "Al llegar al café, [eri] sustituye a [eil], que se sienta a tomar un café con [sca] y contigo."
    "Ao chegar ao café, [eri] substitui [eil], que se senta para tomar um café com [sca] e você."

# game/scripts/c27/c27.rpy:3196
translate brazilian c27s004_ScaInterview_a65a65bb:

    # "El bombardeo de preguntas se dirige a la pelirroja ahora."
    "A enxurrada de perguntas agora se dirige à ruiva."

# game/scripts/c27/c27.rpy:3198
translate brazilian c27s004_ScaInterview_8d5eabbe:

    # "La llegada de [oma] salva tu salud mental. A la vigésima pregunta sobre la cafetera, tu cerebro se ha desconectado."
    "A chegada de [oma] salva sua saúde mental. Na vigésima pergunta sobre a cafeteira, seu cérebro já desligou."

# game/scripts/c27/c27.rpy:3199
translate brazilian c27s004_ScaInterview_c200dcae:

    # oma "¿Qué tal? ¿Ya ha tenido la entrevista?"
    oma "Como vai? Já fez a entrevista?"

# game/scripts/c27/c27.rpy:3200
translate brazilian c27s004_ScaInterview_2f9620ba:

    # mc "No, aún no. El jefe llegará en una hora más o menos."
    mc "Não, ainda não. O chefe chega em cerca de uma hora."

# game/scripts/c27/c27.rpy:3201
translate brazilian c27s004_ScaInterview_043d7282:

    # oma "¿Te vas a quedar hasta que acabe la entrevista?"
    oma "Você vai ficar até o final da entrevista?"

# game/scripts/c27/c27.rpy:3202
translate brazilian c27s004_ScaInterview_43567b9e:

    # mc "Sí, entonces la llevaré a ella y a [eil] a casa. Quiero saber si le han dado el trabajo."
    mc "Sim, então vou levá-la para casa agora. Quero saber se ela conseguiu o emprego."

# game/scripts/c27/c27.rpy:3204
translate brazilian c27s004_ScaInterview_8f0f2c6c:

    # eil "No lo sabrá hoy. Hay un par de chicas más que vienen a hacer entrevistas después de ella."
    eil "Ela não saberá hoje. Mais algumas garotas virão para entrevistas depois dela."

# game/scripts/c27/c27.rpy:3205
translate brazilian c27s004_ScaInterview_116e0b4a:

    # eil "Lo más probable es que mi jefe avise a la chica que contrate mañana."
    eil "Meu chefe provavelmente avisará a moça que contratar amanhã."

# game/scripts/c27/c27.rpy:3206
translate brazilian c27s004_ScaInterview_eb12d7be:

    # mc "De todas formas esperaré para llevaros a casa."
    mc "De qualquer forma, vou esperar para te levar para casa."

# game/scripts/c27/c27.rpy:3208
translate brazilian c27s004_ScaInterview_44cb32fb:

    # eil "No hace falta. Puedes llevar a [oma] y que ella me deje su coche y yo llevo a [sca]."
    eil "Não precisa. Você pode levar [oma] e ela pode me emprestar o carro dela e eu levo [sca]."

# game/scripts/c27/c27.rpy:3209
translate brazilian c27s004_ScaInterview_e36f2161:

    # eil "*Risa* De todas formas vamos a seguir ignorándote."
    eil "*Risos* Enfim, vamos continuar te ignorando."

# game/scripts/c27/c27.rpy:3210
translate brazilian c27s004_ScaInterview_a8c4b70f:

    # mc "*Risa* Creo que puedo nombrar 17 partes de la cafetera ahora mismo. Y seis tipos de pastas que vendéis."
    mc "*Risos* Acho que consigo nomear 17 peças da cafeteira agora mesmo. E seis tipos de doces que vocês vendem."

# game/scripts/c27/c27.rpy:3212
translate brazilian c27s004_ScaInterview_ccb885b8:

    # sca "Lo siento, [mc]. Sé que no soy una buena compañía cuando me pongo así. Quiero saber todo lo posible antes de la entrevista."
    sca "Sinto muito, [mc]. Sei que não sou uma boa companhia quando fico assim. Quero saber o máximo possível antes da entrevista."

# game/scripts/c27/c27.rpy:3213
translate brazilian c27s004_ScaInterview_8b945464:

    # mc "No te preocupes, es lógico. Va a ser tu primer trabajo."
    mc "Não se preocupe, é normal. Vai ser seu primeiro emprego."

# game/scripts/c27/c27.rpy:3214
translate brazilian c27s004_ScaInterview_cd4ee309:

    # sca "Si consigo el trabajo..."
    sca "Se eu conseguir o emprego..."

# game/scripts/c27/c27.rpy:3215
translate brazilian c27s004_ScaInterview_d042c476:

    # mc "Cuando consigas el trabajo."
    mc "Quando você conseguir o emprego."

# game/scripts/c27/c27.rpy:3217
translate brazilian c27s004_ScaInterview_e7c8aee0:

    # oma "Entonces, ¿me llevas a casa?"
    oma "Então, você me levará para casa?"

# game/scripts/c27/c27.rpy:3218
translate brazilian c27s004_ScaInterview_8baab0ee:

    # mc "Sí, si estas dos van a seguir ignorándome no tiene ningún sentido que me quede. *Risa*"
    mc "Sim, se esses dois continuarem me ignorando, não faz sentido eu ficar. *Risos*"

# game/scripts/c27/c27.rpy:3219
translate brazilian c27s004_ScaInterview_f298e3b6:

    # oma "Tengo que pasar por mi apartamento a coger los pijamas para dejarlos en casa."
    oma "Preciso ir ao meu apartamento buscar meu pijama para deixá-lo em casa."

# game/scripts/c27/c27.rpy:3220
translate brazilian c27s004_ScaInterview_0a1c3e79:

    # mc "¿También te vas a quedar a dormir hoy?"
    mc "Você também vai passar a noite aqui?"

# game/scripts/c27/c27.rpy:3222
translate brazilian c27s004_ScaInterview_3444ddb5:

    # oma "No puedo. Empiezo mi turno a medianoche. Me iré después de cenar, pero así ya tendré los pijamas allí para el día que me pueda quedar."
    oma "Não posso. Meu turno começa à meia-noite. Saio depois do jantar, mas assim posso ficar com meu pijama durante o dia."

# game/scripts/c27/c27.rpy:3224
translate brazilian c27s004_ScaInterview_c77fdd8c:

    # oma "*Risa* ¡[sai] no tiene pijamas! Y no estoy acostumbrada a dormir en camisón."
    oma "*Risos* [sai] Ela não tem pijama! E eu não estou acostumada a dormir de camisola."

# game/scripts/c27/c27.rpy:3226
translate brazilian c27s004_ScaInterview_dd92fb48:

    # mc "Pues te quedaba genial. Estabas super sexy."
    mc "Ficou ótimo em você. Você estava super sexy."

# game/scripts/c27/c27.rpy:3228
translate brazilian c27s004_ScaInterview_017f6902:

    # mc "Pues te quedaba muy bien."
    mc "Ficou ótimo em você."

# game/scripts/c27/c27.rpy:3229
translate brazilian c27s004_ScaInterview_cbc8533a:

    # mc "Al menos te quedaba mejor de lo que le quedaba el pijama de [deb.nick] a [ama]."
    mc "Pelo menos ficou melhor em você do que o pijama de [deb.nick] ficou em [ama]."

# game/scripts/c27/c27.rpy:3231
translate brazilian c27s004_ScaInterview_bfc67aac:

    # "Te despides de [sca], [eil] y [eri] y emprendes el camino al apartamento de [oma]."
    "Você se despede de [sca], [eil] e [eri] e inicia sua jornada para o apartamento de [oma]."

# game/scripts/c27/c27.rpy:3232
translate brazilian c27s004_ScaInterview_2d46c0f1:

    # "Vive a dos calles y vais dando un paseo."
    "Ele mora a duas ruas daqui e você pode ir caminhando."

# game/scripts/c27/c27.rpy:3235
translate brazilian c27s004_ScaInterview_c5432ede:

    # "Se te hace raro pasear cogido de la mano con [oma]. Maravillosamente raro."
    "É estranho andar de mãos dadas com [oma]. Maravilhosamente estranho."

# game/scripts/c27/c27.rpy:3236
translate brazilian c27s004_ScaInterview_ab172596:

    # "No habéis hecho muchas cosas de las que hacen las parejas normales. Nunca habéis paseado ni salido a cenar."
    "Vocês não fizeram muitas das coisas que casais normais fazem. Nunca saíram para passear ou jantar fora."

# game/scripts/c27/c27.rpy:3237
translate brazilian c27s004_ScaInterview_9a395341:

    # "Pero no por ello estás menos loco por ella. La normalidad está sobrevalorada."
    "Mas isso não faz com que você seja menos apaixonado por ela. A normalidade é superestimada."

# game/scripts/c27/c27.rpy:3239
translate brazilian c27s004_ScaInterview_6b0d3e09:

    # "Y vas a ver su apartamento por primera vez."
    "E você vai ver o apartamento dele pela primeira vez."

# game/scripts/c27/c27.rpy:3256
translate brazilian c27s005_PaintBasement_b8c29d77:

    # "Mientras tanto, en el sótano..."
    "Entretanto, no porão..."

# game/scripts/c27/c27.rpy:3257
translate brazilian c27s005_PaintBasement_eb887920:

    # mom "Parece que hace años que pintamos la habitación de [sai]."
    mom "Parece que já faz anos desde que pintamos o quarto de [sai]."

# game/scripts/c27/c27.rpy:3258
translate brazilian c27s005_PaintBasement_ae49dea8:

    # nor "Tienes razón. Aunque parezca mentira, no ha pasado un mes todavía de aquello."
    nor "Você tem razão. Acredite ou não, ainda não faz nem um mês que isso aconteceu."

# game/scripts/c27/c27.rpy:3259
translate brazilian c27s005_PaintBasement_b4661f5d:

    # emm "Y aquel día estaba [mc] en vez de [kim]. Hoy no podremos humillarlo con una batalla de pintura."
    emm "E naquele dia foi [mc] em vez de [kim]. Hoje não conseguiremos humilhá-lo com uma batalha de tinta."

# game/scripts/c27/c27.rpy:3260
translate brazilian c27s005_PaintBasement_6f1acaa2:

    # kim "¿Hicisteis una batalla de pintura?"
    kim "Vocês fizeram uma batalha de tinta?"

# game/scripts/c27/c27.rpy:3262
translate brazilian c27s005_PaintBasement_41cfb172:

    # mom "Ya sabes cómo va esto. *Risa* [mc] dijo algo que no le gustó a [emm] y [emm] le pegó con el rodillo."
    mom "Você sabe como isso funciona. *Risos* [mc] disse algo que [emm] não gostou e [emm] bateu nele com o rolo de massa."

# game/scripts/c27/c27.rpy:3263
translate brazilian c27s005_PaintBasement_49686b65:

    # mom "Acabamos haciendo una batalla [emm] y yo contra [nor] y [mc]."
    mom "Acabamos tendo uma batalha: [emm] e eu contra [nor] e [mc]."

# game/scripts/c27/c27.rpy:3265
translate brazilian c27s005_PaintBasement_0a696588:

    # kim "Me encanta cómo hacéis algo divertido de cualquier situación."
    kim "Adoro como você consegue transformar qualquer situação em algo divertido."

# game/scripts/c27/c27.rpy:3267
translate brazilian c27s005_PaintBasement_81cdea0f:

    # emm "No, [kim]. No es 'hacéis'. Ahora es 'hacemos'. Tienes que empezar a incluirte cuando hables de la familia."
    emm "Não, [kim]. Não é \"todos vocês fazem\". Agora é \"nós fazemos\". Você precisa começar a se incluir quando fala de família."

# game/scripts/c27/c27.rpy:3268
translate brazilian c27s005_PaintBasement_f988f88e:

    # emm "Por cierto, la batalla la ganamos nosotras como es normal."
    emm "Aliás, vencemos a batalha, como de costume."

# game/scripts/c27/c27.rpy:3270
translate brazilian c27s005_PaintBasement_503ff04b:

    # nor "*Risa* No estoy demasiado segura de que eso sea verdad."
    nor "*Risos* Não tenho muita certeza se isso é verdade."

# game/scripts/c27/c27.rpy:3272
translate brazilian c27s005_PaintBasement_a6cc3943:

    # emm "¡Por supuesto que ganamos nosotras!"
    emm "É claro que ganhamos!"

# game/scripts/c27/c27.rpy:3274
translate brazilian c27s005_PaintBasement_33392f5a:

    # kim "¿A qué te refieres, [nor]?"
    kim "O que você quer dizer, [nor]?"

# game/scripts/c27/c27.rpy:3277
translate brazilian c27s005_PaintBasement_fd412187:

    # nor "Perder aquella batalla de pintura fue el primer paso para que [mc] y yo acabáramos juntos."
    nor "Perder aquela batalha de tinta foi o primeiro passo para que [mc] e eu acabássemos juntos."

# game/scripts/c27/c27.rpy:3279
translate brazilian c27s005_PaintBasement_618fb198:

    # nor "Nos acabamos duchando juntos. Y no una ducha inocente como las que tomábamos cuando él era un niño."
    nor "Acabamos tomando banho juntos. E não foi um banho qualquer, como aqueles que costumávamos tomar quando ele era criança."

# game/scripts/c27/c27.rpy:3281
translate brazilian c27s005_PaintBasement_3b59ea40:

    # emm "¿Qué? ¿Follasteis aquel día? ¿En la ducha?"
    emm "O quê? Vocês transaram naquele dia? No chuveiro?"

# game/scripts/c27/c27.rpy:3283
translate brazilian c27s005_PaintBasement_a2b1e979:

    # nor "*Risa* No, pero aún no sé cómo conseguimos parar a tiempo. Fue muy tórrido."
    nor "*Risos* Não, mas ainda não sei como conseguimos parar a tempo. Estava muito quente."

# game/scripts/c27/c27.rpy:3285
translate brazilian c27s005_PaintBasement_939f40b9:

    # nor "Estuve a punto de meterme en la ducha con él."
    nor "Eu estava prestes a entrar no chuveiro com ele."

# game/scripts/c27/c27.rpy:3287
translate brazilian c27s005_PaintBasement_c28db764:

    # emm "¿Qué? ¿Follasteis aquel día? ¿En el baño?"
    emm "O quê? Vocês transaram naquele dia? No banheiro?"

# game/scripts/c27/c27.rpy:3289
translate brazilian c27s005_PaintBasement_7fb497eb:

    # nor "*Risa* No, no me dejó entrar en la ducha, pero no sé qué hubiera pasado si me hubiera dejado."
    nor "*Risos* Não, ele não me deixou entrar no chuveiro, mas não sei o que teria acontecido se tivesse deixado."

# game/scripts/c27/c27.rpy:3291
translate brazilian c27s005_PaintBasement_60baacae:

    # nor "Después de aquella batalla estaba buscando un sitio donde ducharme y quitarme la pintura. Encontré a [mc] en la ducha."
    nor "Depois daquela batalha, eu estava procurando um lugar para tomar banho e tirar a tinta. Encontrei [mc] no chuveiro."

# game/scripts/c27/c27.rpy:3292
translate brazilian c27s005_PaintBasement_cfb00f0c:

    # nor "¿Os acordáis del pestillo roto en el baño? Creo que fui la primera en verlo desnudo desde que volvió a casa."
    nor "Você se lembra da fechadura quebrada no banheiro? Acho que fui a primeira a vê-lo nu desde que ele voltou para casa."

# game/scripts/c27/c27.rpy:3294
translate brazilian c27s005_PaintBasement_b562ea2d:

    # emm "Nope. *Risita* Yo lo vi el día anterior, en la ducha del gimnasio."
    emm "Não. *Risos* Eu o vi no dia anterior, no chuveiro da academia."

# game/scripts/c27/c27.rpy:3295
translate brazilian c27s005_PaintBasement_185bf539:

    # emm "Y [sca] y [dap] un poco más tarde, en la piscina, mientras hacíamos una batalla de caballos."
    emm "E [sca] e [dap] um pouco mais tarde, na piscina, enquanto estávamos tendo uma batalha de cavalos."

# game/scripts/c27/c27.rpy:3297
translate brazilian c27s005_PaintBasement_2a6ffe0e:

    # emm "Y [eri] ese mismo día, pero más tarde, también en la ducha del pestillo roto."
    emm "E naquele mesmo dia, mas mais tarde, também no chuveiro, com a trava quebrada."

# game/scripts/c27/c27.rpy:3298
translate brazilian c27s005_PaintBasement_3c88db8d:

    # emm "*Risa* Con lo que, como mínimo, fuiste la quinta, Tía [nor], dependiendo de si mi madre lo vio antes que tú."
    emm "*Risos* Então, no mínimo, você foi a quinta, tia [nor], dependendo se minha mãe viu antes de você."

# game/scripts/c27/c27.rpy:3300
translate brazilian c27s005_PaintBasement_c67edef3:

    # mom "*Risa* Yo el día de la batalla de pintura, pero por la noche."
    mom "*Risos* Eu no dia da batalha de tinta, mas à noite."

# game/scripts/c27/c27.rpy:3301
translate brazilian c27s005_PaintBasement_18bd1ac0:

    # mom "Todas lo visteis desnudo antes que yo."
    mom "Todos vocês o viram nu antes de mim."

# game/scripts/c27/c27.rpy:3303
translate brazilian c27s005_PaintBasement_4d0d3242:

    # kim "*Risa* Parece uno de esos juegos a los que juega [deb.nick]."
    kim "*Risos* Parece um daqueles jogos que o [deb.nick] joga."

# game/scripts/c27/c27.rpy:3305
translate brazilian c27s005_PaintBasement_e5faa4e4:

    # nor "La verdad es que pasaron cosas realmente extrañas en aquellos días después de la llegada de [mc]."
    nor "A verdade é que coisas realmente estranhas aconteceram naqueles dias após a chegada de [mc]."

# game/scripts/c27/c27.rpy:3306
translate brazilian c27s005_PaintBasement_ec19456d:

    # nor "La paliza que recibió de Jack, el ex-novio de [eri]... Aunque después se la devolviera..."
    nor "A surra que ela levou de Jack, ex-namorado de [eri]... Embora mais tarde ela tenha revidado..."

# game/scripts/c27/c27.rpy:3308
translate brazilian c27s005_PaintBasement_a7bbd184:

    # mom "La fiesta de disfraces..."
    mom "A festa à fantasia..."

# game/scripts/c27/c27.rpy:3310
translate brazilian c27s005_PaintBasement_c949951d:

    # emm "El juego de verdad o reto..."
    emm "O jogo da verdade ou desafio..."

# game/scripts/c27/c27.rpy:3312
translate brazilian c27s005_PaintBasement_221b8344:

    # kim "Y después pasó lo más raro. *Risa* Llegamos nosotras."
    kim "E então aconteceu a coisa mais estranha. *Risos* Nós chegamos."

# game/scripts/c27/c27.rpy:3314
translate brazilian c27s005_PaintBasement_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c27/c27.rpy:3315
translate brazilian c27s005_PaintBasement_956292ce:

    # mom "Bueno, lo realmente raro fue la llegada de [sai]. *Risa* Nadie la esperaba."
    mom "Bem, o que foi realmente estranho foi a chegada de [sai]. *Risos* Ninguém a esperava."

# game/scripts/c27/c27.rpy:3316
translate brazilian c27s005_PaintBasement_8b5d3123:

    # nor "*Risa* Bueno, todos la esperábamos, pero no esperábamos que fuera la novia de [mc] en Portland."
    nor "*Risos* Bem, todos nós a esperávamos, mas não esperávamos que ela fosse a namorada do [mc] em Portland."

# game/scripts/c27/c27.rpy:3318
translate brazilian c27s005_PaintBasement_23677926:

    # emm "Bueno, no era la novia exactamente, ¿no?"
    emm "Bem, ela não era exatamente a namorada, era?"

# game/scripts/c27/c27.rpy:3319
translate brazilian c27s005_PaintBasement_3e96ff03:

    # emm "Tenían una relación abierta y todo eso."
    emm "Eles tinham um relacionamento aberto e tudo mais."

# game/scripts/c27/c27.rpy:3321
translate brazilian c27s005_PaintBasement_0bb922b6:

    # kim "A ver qué sorpresas nos deparan las chicas nuevas. Tengo ganas de conocerlas."
    kim "Vamos ver que surpresas as novas garotas nos reservam. Estou ansioso para conhecê-las."

# game/scripts/c27/c27.rpy:3322
translate brazilian c27s005_PaintBasement_6a212ef5:

    # kim "Y también tengo ganas de saber si se integrarán en la familia igual que nosotras."
    kim "E também estou ansiosa para saber se eles se integrarão à família da mesma forma que nós."

# game/scripts/c27/c27.rpy:3324
translate brazilian c27s005_PaintBasement_20ebb414:

    # nor "He intercambiado algunos correos con ellas, y parecen buenas chicas."
    nor "Troquei alguns e-mails com elas e parecem ser moças simpáticas."

# game/scripts/c27/c27.rpy:3325
translate brazilian c27s005_PaintBasement_de3aa4eb:

    # nor "Pero hay uno de los correos que me ha sorprendido mucho. Espera que lo busco en el móvil."
    nor "Mas houve um e-mail que realmente me surpreendeu. Deixe-me encontrá-lo no meu celular."

# game/scripts/c27/c27.rpy:3327
translate brazilian c27s005_PaintBasement_0a01fb8e:

    # emm "*Risa* ¿Ya son raras antes de llegar?"
    emm "*Risos* Eles já são estranhos antes mesmo de chegarem?"

# game/scripts/c27/c27.rpy:3329
translate brazilian c27s005_PaintBasement_0ccc548e:

    # mom "Ya sé a qué correo se refiere [nor]. Más que raro, es algo que nunca se nos hubiera ocurrido."
    mom "Eu sei a qual e-mail [nor] se refere. É mais do que apenas estranho; é algo que nunca teríamos imaginado."

# game/scripts/c27/c27.rpy:3331
translate brazilian c27s005_PaintBasement_fafda3c4:

    # nor "Ya lo tengo. Os lo leo."
    nor "Já entendi. Vou ler para você."

# game/scripts/c27/c27.rpy:3332
translate brazilian c27s005_PaintBasement_1a24ae6c:

    # nor "Querida Señora Marks,"
    nor "Prezada Sra. Marks,"

# game/scripts/c27/c27.rpy:3333
translate brazilian c27s005_PaintBasement_51d96265:

    # nor "Soy [kal], una de las estudiantes que se van a alojar en su casa a partir del mes que viene."
    nor "Eu sou [kal], um dos alunos que ficará hospedado em sua casa a partir do próximo mês."

# game/scripts/c27/c27.rpy:3334
translate brazilian c27s005_PaintBasement_533665d4:

    # nor "Es mi primera experiencia viviendo en el extranjero y con chicas de otras culturas."
    nor "Esta é minha primeira experiência morando no exterior e com garotas de outras culturas."

# game/scripts/c27/c27.rpy:3335
translate brazilian c27s005_PaintBasement_776c3ca5:

    # nor "La universidad me ha informado de que todas las chicas somos de primer año, con lo que es posible que a ellas les pase lo mismo."
    nor "A universidade me informou que todas as meninas são calouras, então é possível que a mesma coisa aconteça com elas."

# game/scripts/c27/c27.rpy:3337
translate brazilian c27s005_PaintBasement_cf5f2e87:

    # nor "No lo de diferentes culturas, claro, ya que ellas, por lo que tengo entendido son americanas."
    nor "Não se trata de diferenças culturais, claro, já que, pelo que entendi, eles são americanos."

# game/scripts/c27/c27.rpy:3338
translate brazilian c27s005_PaintBasement_e1317dcc:

    # nor "Para empezar a conocernos, ya que vamos a compartir habitaciones durante al menos un año, me gustaría proponerle una idea."
    nor "Para nos conhecermos melhor, já que vamos dividir o quarto por pelo menos um ano, gostaria de propor uma ideia."

# game/scripts/c27/c27.rpy:3339
translate brazilian c27s005_PaintBasement_23e4f570:

    # nor "Si fuera posible, nos podríamos hacer una foto cada una, y así sabríamos qué aspecto tenemos."
    nor "Se fosse possível, cada um de nós poderia tirar uma foto, e assim saberíamos como somos."

# game/scripts/c27/c27.rpy:3340
translate brazilian c27s005_PaintBasement_5db14712:

    # nor "Para hacerlo más divertido, me gustaría proponer que fuera el mismo día a la misma hora, si fuera posible."
    nor "Para tornar tudo mais divertido, sugiro que seja no mesmo dia e horário, se possível."

# game/scripts/c27/c27.rpy:3341
translate brazilian c27s005_PaintBasement_c653ea79:

    # nor "Así sería como si estuviéramos juntas por primera vez, aunque nos separen muchos kilómetros de distancia."
    nor "Seria como se estivéssemos juntos pela primeira vez, mesmo estando separados por muitos quilômetros."

# game/scripts/c27/c27.rpy:3343
translate brazilian c27s005_PaintBasement_af1884bc:

    # nor "He estado pensando en las diferencias horarias, y creo que hacerlo a las 19:00 GMT del 4 de agosto estaría bien."
    nor "Estive pensando nas diferenças de fuso horário e acho que fazer isso às 19h GMT do dia 4 de agosto seria perfeito."

# game/scripts/c27/c27.rpy:3344
translate brazilian c27s005_PaintBasement_7f844e8d:

    # nor "De esa forma, en Estados Unidos serían entre las 11:00 y las 14:00, y las chicas no tendrían que madrugar demasiado."
    nor "Dessa forma, nos Estados Unidos seria entre 11h e 14h, e as meninas não precisariam acordar muito cedo."

# game/scripts/c27/c27.rpy:3345
translate brazilian c27s005_PaintBasement_6f1ccc27:

    # nor "Si le parece bien, por favor, reenvíe este correo a las chicas con las que compartiré casa."
    nor "Se quiser, encaminhe este e-mail para as meninas com quem vou dividir a casa."

# game/scripts/c27/c27.rpy:3346
translate brazilian c27s005_PaintBasement_64b67f90:

    # nor "Se lo enviaría yo, pero la Universidad no ha querido darme sus correos electrónicos."
    nor "Eu enviaria para eles, mas a universidade se recusou a me fornecer seus endereços de e-mail."

# game/scripts/c27/c27.rpy:3347
translate brazilian c27s005_PaintBasement_2b5dedf8:

    # nor "Después, cada una de las que acepten hacerse la foto podemos enviárselas a usted para que nos las reenvíe al resto."
    nor "Em seguida, podemos enviar as fotos de cada pessoa que concordar em ser fotografada para você, para que você possa encaminhá-las para o restante de nós."

# game/scripts/c27/c27.rpy:3349
translate brazilian c27s005_PaintBasement_c80e7c9d:

    # nor "Estoy muy emocionada por conocerla a usted y a su familia. Mi prima me ha contado cosas alucinantes."
    nor "Estou muito animada para conhecer você e sua família. Minha prima me contou coisas incríveis sobre você."

# game/scripts/c27/c27.rpy:3350
translate brazilian c27s005_PaintBasement_19ad2b08:

    # nor "Gracias por todo por adelantado,"
    nor "Agradeço antecipadamente por tudo."

# game/scripts/c27/c27.rpy:3351
translate brazilian c27s005_PaintBasement_2ff14579:

    # nor "[kal] Singh"
    nor "[kal] Singh"

# game/scripts/c27/c27.rpy:3352
translate brazilian c27s005_PaintBasement_ef8ca24f:

    # nor "Hace días que lo recibí y se lo mandé al resto de las chicas. El 4 de agosto es mañana. A ver cuántas responden."
    nor "Recebi o convite há alguns dias e o enviei para as outras meninas. Amanhã é dia 4 de agosto. Vamos ver quantas respondem."

# game/scripts/c27/c27.rpy:3354
translate brazilian c27s005_PaintBasement_3085eb00:

    # kim "¿[kal]? Esa es la prima de [sai]."
    kim "[kal]? Esse é o primo de [sai]."

# game/scripts/c27/c27.rpy:3355
translate brazilian c27s005_PaintBasement_21bc27ff:

    # kim "Me hubiera gustado que la idea se nos hubiera ocurrido a nosotras antes de venir."
    kim "Quem me dera tivéssemos tido essa ideia antes de virmos para cá."

# game/scripts/c27/c27.rpy:3356
translate brazilian c27s005_PaintBasement_c04a8f0e:

    # kim "Aunque hubiera venido acojonada. [kat], [lis], [deb.nick], y [sai] son guapísimas..." id c27s005_PaintBasement_c04a8f0e
    kim "Mesmo tendo chegado apavorada. [kat], [lis], [deb.nick] e [sai] são belíssimos..." id c27s005_PaintBasement_c04a8f0e

# game/scripts/c27/c27.rpy:3358
translate brazilian c27s005_PaintBasement_5ddd31e5:

    # emm "*Risa* Claro, como tú eres la prima fea de Quasimodo te tendrías que preocupar por cómo son las demás."
    emm "*Risos* Claro, já que você é o primo feio do Quasimodo, deveria se preocupar com a aparência de todos os outros."

# game/scripts/c27/c27.rpy:3360
translate brazilian c27s005_PaintBasement_bdd0c787:

    # mom "La belleza es subjetiva, [emm]. Puede que yo te vea muy guapa y que para otras chicas parezcas un orco..."
    mom "A beleza é subjetiva. Eu posso te achar muito bonita, mas outras garotas podem achar que você parece um ogro..."

# game/scripts/c27/c27.rpy:3362
translate brazilian c27s005_PaintBasement_f9b92aa1:

    # emm "¿Qué? ¿Un orco? ¿Yo?"
    emm "O quê? Um orc? Eu?"

# game/scripts/c27/c27.rpy:3364
translate brazilian c27s005_PaintBasement_80f9105c:

    # nor "*Risa* Uno orco rosa. Cambiarías la armadura por un vestidito mono... y rosa."
    nor "*Risos* Uma orc rosa. Você trocaria a armadura por um vestidinho fofo... e rosa."

# game/scripts/c27/c27.rpy:3366
translate brazilian c27s005_PaintBasement_b3b94564_1:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c27/c27.rpy:3367
translate brazilian c27s005_PaintBasement_1f8e7881:

    # emm "*Risa* A veces os odio. Por suerte, soy la que tiene el mejor gusto para los colores en casa."
    emm "*Risos* Às vezes eu odeio vocês. Felizmente, sou eu quem tem o melhor gosto para cores em casa."

# game/scripts/c27/c27.rpy:3368
translate brazilian c27s005_PaintBasement_15a2fed2:

    # emm "[kim] me cayó bien el día que llegó con aquel vestido rosa. ¿Os acordáis?"
    emm "[kim] Gostei dela no dia em que ela chegou com aquele vestido rosa. Você se lembra?"

# game/scripts/c27/c27.rpy:3369
translate brazilian c27s005_PaintBasement_8a54ed4a:

    # mom "Me encanta cómo le quedaba aquel vestido, pero no se lo he vuelto a ver puesto."
    mom "Adorei como aquele vestido ficou nela, mas nunca mais a vi usá-lo."

# game/scripts/c27/c27.rpy:3370
translate brazilian c27s005_PaintBasement_d646a85f:

    # kim "*Risa* No quiero que [emm] me lo robe. Aunque se lo puedo prestar un día."
    kim "*Risos* Não quero que [emm] roube. Embora eu possa emprestar para ele por um dia."

# game/scripts/c27/c27.rpy:3371
translate brazilian c27s005_PaintBasement_13327ac7:

    # nor "*Risa* ¡No alimentes al orco!"
    nor "*Risos* Não alimente o orc!"

# game/scripts/c27/c27.rpy:3372
translate brazilian c27s005_PaintBasement_b3b94564_2:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c27/c27.rpy:3373
translate brazilian c27s005_PaintBasement_2f46c808:

    # emm "*Risa* Cada vez os odio más veces."
    emm "*Risos* Eu te odeio cada vez mais."

# game/scripts/c27/c27.rpy:3375
translate brazilian c27s005_PaintBasement_8084dbd9:

    # emm "Cambiando de tema y hablando de otras chicas, aunque me consideren un orco. ¿Puedo hacerte una pregunta personal, Tía [nor]?"
    emm "Mudando de assunto e falando de outras garotas, mesmo que elas pensem que eu sou um ogro. Posso te fazer uma pergunta pessoal, tia [nor]?"

# game/scripts/c27/c27.rpy:3377
translate brazilian c27s005_PaintBasement_462da680:

    # nor "Claro, cielo, pregunta lo que quieras saber. Ya sabes que lo de tener secretos se nos ha dado mal."
    nor "Claro, querida, pergunte o que quiser saber. Você sabe que não somos bons em guardar segredos."

# game/scripts/c27/c27.rpy:3379
translate brazilian c27s005_PaintBasement_f02d297e:

    # emm "A ver... no es que tenga dudas, pero como tú eres más... lanzada... que mi madre..."
    emm "Bem... não é que eu tenha dúvidas, mas já que você é mais... direta... do que minha mãe..."

# game/scripts/c27/c27.rpy:3380
translate brazilian c27s005_PaintBasement_be4b2e4b:

    # emm "¿Alguna vez has tenido alguna experiencia con alguna chica?"
    emm "Você já teve alguma experiência com uma garota?"

# game/scripts/c27/c27.rpy:3382
translate brazilian c27s005_PaintBasement_de940220:

    # nor "*Risa* ¡Eso sí que es un cambio de tema!"
    nor "*Risos* Agora sim, uma mudança de assunto!"

# game/scripts/c27/c27.rpy:3384
translate brazilian c27s005_PaintBasement_9ad01b51:

    # nor "Pero sí. Tres veces, una en la universidad y otra poco después de acabar."
    nor "Sim, com certeza. Três vezes, uma na universidade e outra logo depois de me formar."

# game/scripts/c27/c27.rpy:3385
translate brazilian c27s005_PaintBasement_2d5d8d0b:

    # nor "{i}(Espero que no se den cuenta de que falta una. No sé si [eri] querría que les dijera lo que pasó en la piscina.){/i}"
    nor "{i}(Espero que eles não percebam que um está faltando. Não sei se [eri] gostaria que eu contasse o que aconteceu na piscina.){/i}"

# game/scripts/c27/c27.rpy:3387
translate brazilian c27s005_PaintBasement_b4f9bad9:

    # nor "Pero sí. Dos veces, una en la universidad y otra poco después de acabar."
    nor "Sim, com certeza. Duas vezes, uma na universidade e outra logo depois de me formar."

# game/scripts/c27/c27.rpy:3389
translate brazilian c27s005_PaintBasement_3028d3df:

    # kim "¿Y cómo fue? ¿Tenías dudas sobre tu sexualidad?"
    kim "E como foi? Você teve dúvidas sobre sua sexualidade?"

# game/scripts/c27/c27.rpy:3391
translate brazilian c27s005_PaintBasement_c51aad71:

    # nor "No, cielo, nunca he tenido dudas, pero quería experimentar."
    nor "Não, querida, nunca tive dúvidas, mas queria experimentar."

# game/scripts/c27/c27.rpy:3392
translate brazilian c27s005_PaintBasement_5ea5d3ad:

    # nor "La primera vez no me gustó. La segunda fue mucho mejor."
    nor "Não gostei da primeira vez. A segunda vez foi muito melhor."

# game/scripts/c27/c27.rpy:3394
translate brazilian c27s005_PaintBasement_d288c764:

    # emm "¡Me sorprendes mucho, Tía [nor]! Pensaba que podías haber probado, pero no repetido si no te gustó la primera vez."
    emm "Você realmente me surpreende, tia [nor]! Eu pensei que você poderia ter experimentado, mas não repetir se não gostasse da primeira vez."

# game/scripts/c27/c27.rpy:3396
translate brazilian c27s005_PaintBasement_f7c6d72b:

    # nor "Bueno, la segunda vez fue con una persona especial. No especial en cuanto a que sintiera algo por ella, pero... especial."
    nor "Bem, a segunda vez foi com alguém especial. Não especial no sentido de que eu tivesse sentimentos por ela, mas... especial."

# game/scripts/c27/c27.rpy:3397
translate brazilian c27s005_PaintBasement_9228143d:

    # nor "Pero, ¿por qué lo preguntas?"
    nor "Mas por que você pergunta?"

# game/scripts/c27/c27.rpy:3401
translate brazilian c27s005_PaintBasement_d9df3ce6:

    # emm "Por nada especial. Me he sentido tentada de experimentar en un par de ocasiones."
    emm "Sem nenhum motivo específico. Já tive vontade de experimentar algumas vezes."

# game/scripts/c27/c27.rpy:3403
translate brazilian c27s005_PaintBasement_d9df3ce6_1:

    # emm "Por nada especial. Me he sentido tentada de experimentar en un par de ocasiones."
    emm "Sem nenhum motivo específico. Já tive vontade de experimentar algumas vezes."

# game/scripts/c27/c27.rpy:3405
translate brazilian c27s005_PaintBasement_35c6e3f7:

    # emm "Por nada especial. Después de lo de los saludos con besos, me sentí tentada de experimentar."
    emm "Sem nenhum motivo específico. Depois de toda aquela história de cumprimentos com beijos, fiquei tentada a experimentar."

# game/scripts/c27/c27.rpy:3407
translate brazilian c27s005_PaintBasement_857534b9:

    # emm "Por nada especial. Cuando lo de los saludos con besos, pensé que experimentar podría estar bien. Después se me pasó."
    emm "Sem nenhum motivo específico. Quando essa história de cumprimentar com beijos começou, achei que experimentar poderia ser uma boa ideia. Depois, superei."

# game/scripts/c27/c27.rpy:3409
translate brazilian c27s005_PaintBasement_e14abd5d:

    # kim "¿Y tú, [mar]? ¿Alguna experiencia?"
    kim "E você, [mar]? Alguma experiência?"

# game/scripts/c27/c27.rpy:3411
translate brazilian c27s005_PaintBasement_989fa86b:

    # mom "*Risa* Según [emm] no soy lo suficientemente lanzada para probarlo."
    mom "*Risos* De acordo com [emm], não sou ousado o suficiente para tentar."

# game/scripts/c27/c27.rpy:3413
translate brazilian c27s005_PaintBasement_8120f84d:

    # emm "¡Mamá! Lo he dicho porque le pega más a Tía [nor]."
    emm "Mãe! Eu disse isso porque combina mais com a tia [nor]."

# game/scripts/c27/c27.rpy:3415
translate brazilian c27s005_PaintBasement_e82d9990:

    # mom "Bueno, pues sí. Una vez en la universidad..."
    mom "Bem, sim. Quando entrar na universidade..."

# game/scripts/c27/c27.rpy:3417
translate brazilian c27s005_PaintBasement_0ceb94f2:

    # emm "¿Qué?"
    emm "Que?"

# game/scripts/c27/c27.rpy:3420
translate brazilian c27s005_PaintBasement_280a82f0:

    # mom "Poco después de que tu tía acabara la universidad."
    mom "Pouco depois de sua tia terminar a universidade."

# game/scripts/c27/c27.rpy:3422
translate brazilian c27s005_PaintBasement_43ced4d4:

    # emm "¿QUÉ?" (multiple=2)
    emm "QUE?" (multiple=2)

# game/scripts/c27/c27.rpy:3423
translate brazilian c27s005_PaintBasement_e6800f64:

    # kim "¿Vosotras dos?" (multiple=2)
    kim "Vocês dois?" (multiple=2)

# game/scripts/c27/c27.rpy:3425
translate brazilian c27s005_PaintBasement_dac0c039:

    # mom "*Risa*" (multiple=2)
    mom "*Risada*" (multiple=2)

# game/scripts/c27/c27.rpy:3426
translate brazilian c27s005_PaintBasement_12a0453c:

    # nor "*Risa*" (multiple=2)
    nor "*Risada*" (multiple=2)

# game/scripts/c27/c27.rpy:3427
translate brazilian c27s005_PaintBasement_d5803862:

    # mom "Creo que deberíamos empezar a pintar o se va a hacer tarde."
    mom "Acho que devemos começar a pintar, senão vai ficar tarde."

# game/scripts/c27/c27.rpy:3428
translate brazilian c27s005_PaintBasement_cba98c67:

    # nor "Yo también creo lo mismo."
    nor "Penso o mesmo."

# game/scripts/c27/c27.rpy:3430
translate brazilian c27s005_PaintBasement_c7ec6c81:

    # emm "¡No es justo! ¡Ahora quiero saber más!"
    emm "Isso não é justo! Agora eu quero saber mais!"

# game/scripts/c27/c27.rpy:3432
translate brazilian c27s005_PaintBasement_c9b588f5:

    # mom "Yo creía que querías tener un estudio de fotografía."
    mom "Pensei que você quisesse ter um estúdio de fotografia."

# game/scripts/c27/c27.rpy:3433
translate brazilian c27s005_PaintBasement_bb7a4767:

    # nor "Si no empezamos a pintar, no lo podrás tener montado para el fin de semana."
    nor "Se não começarmos a pintar, você não conseguirá montá-lo até o fim de semana."

# game/scripts/c27/c27.rpy:3436
translate brazilian c27s005_PaintBasement_c37315aa:

    # mom "No me gustó y no volví a repetir mientras estaba en la universidad."
    mom "Eu não gostei e não repeti a experiência enquanto estava na universidade."

# game/scripts/c27/c27.rpy:3437
translate brazilian c27s005_PaintBasement_17a567f2:

    # mom "Quizás es porque estábamos experimentando y no sentíamos nada la una por la otra..."
    mom "Talvez seja porque estávamos experimentando e não sentíamos nada um pelo outro..."

# game/scripts/c27/c27.rpy:3439
translate brazilian c27s005_PaintBasement_b3f8cbfd:

    # emm "Me acabas de dejar sorprendida. No creía que hubieras probado algo así."
    emm "Você me surpreendeu. Não pensei que você tivesse tentado algo assim."

# game/scripts/c27/c27.rpy:3440
translate brazilian c27s005_PaintBasement_76646c41:

    # kim "Yo también estoy sorprendida. No porque lo probaras, sino porque lo probaras con alguien por quién no sintieras nada."
    kim "Eu também estou surpreso. Não por você ter tentado, mas por ter tentado com alguém por quem você não tinha nenhum sentimento."

# game/scripts/c27/c27.rpy:3442
translate brazilian c27s005_PaintBasement_239aacbc:

    # mom "La universidad es un momento para experimentar. Yo no pensaba demasiado en esas cosas todavía."
    mom "A universidade é uma época para experimentar. Eu ainda não estava pensando muito nessas coisas."

# game/scripts/c27/c27.rpy:3443
translate brazilian c27s005_PaintBasement_ae2b3a6d:

    # mom "A día de hoy no lo haría con nadie por quién no sintiera algo."
    mom "Hoje em dia eu não faria isso com ninguém por quem eu não sentisse nada."

# game/scripts/c27/c27.rpy:3445
translate brazilian c27s005_PaintBasement_99ab8c4a:

    # mom "Pero creo que deberíamos empezar a pintar o no vamos a acabar nunca."
    mom "Mas acho que devemos começar a pintar, senão nunca vamos terminar."

# game/scripts/c27/c27.rpy:3446
translate brazilian c27s005_PaintBasement_196942a8:

    # nor "Estoy de acuerdo. Así estará seco para el fin de semana y [emm] podrá montar el estudio de fotografía."
    nor "Concordo. Assim estará seco até o fim de semana e poderei montar o estúdio fotográfico."

# game/scripts/c27/c27.rpy:3448
translate brazilian c27s005_PaintBasement_99b0cb63:

    # emm "Vale, pero no es justo. Sabéis que voy a seguir preguntando por eso."
    emm "Tudo bem, mas isso não é justo. Você sabe que vou continuar perguntando sobre isso."

# game/scripts/c27/c27.rpy:3451
translate brazilian c27s005_PaintBasement_b3b94564_3:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c27/c27.rpy:3459
translate brazilian c27s006_OmaHouse_8c39eab6:

    # "En el apartamento de [oma]..."
    "No apartamento de [oma]..."

# game/scripts/c27/c27.rpy:3460
translate brazilian c27s006_OmaHouse_d412e958:

    # oma "Pues este es mi pasillo. Casi no se puede considerar un apartamento."
    oma "Bem, este é o meu corredor. Mal dá para chamar isso de apartamento."

# game/scripts/c27/c27.rpy:3461
translate brazilian c27s006_OmaHouse_5280379f:

    # oma "*Risa* Un pasillo con puertas a un lado."
    oma "*Risos* Um corredor com portas de um lado."

# game/scripts/c27/c27.rpy:3462
translate brazilian c27s006_OmaHouse_cc59f643:

    # mc "*Risa* Pero es un pasillo muy bien arreglado para una persona."
    mc "*Risos* Mas é um corredor muito bem organizado para uma pessoa."

# game/scripts/c27/c27.rpy:3464
translate brazilian c27s006_OmaHouse_6addfb14:

    # oma "*Risa* El mayor problema es que puedo recordar y oler lo que cociné hace tres días cuando estoy viendo la tele."
    oma "*Risos* O maior problema é que consigo me lembrar e sentir o cheiro do que cozinhei há três dias quando estou assistindo TV."

# game/scripts/c27/c27.rpy:3465
translate brazilian c27s006_OmaHouse_3b603823:

    # oma "No hay forma de que la campana se lleve todos los olores antes de que lleguen al sofá."
    oma "Não há como o exaustor eliminar todos os odores antes que eles cheguem ao sofá."

# game/scripts/c27/c27.rpy:3466
translate brazilian c27s006_OmaHouse_c99670bb:

    # mc "Si lo que cocinas está bueno..."
    mc "Se a comida que você cozinha for boa..."

# game/scripts/c27/c27.rpy:3468
translate brazilian c27s006_OmaHouse_4591f911:

    # oma "No. Por muy bueno que esté, no quiero olerlo tres días después. Y abrir las ventanas no sirve de mucho."
    oma "Não. Por mais gostoso que seja, não quero sentir o cheiro três dias depois. E abrir as janelas não ajuda muito."

# game/scripts/c27/c27.rpy:3469
translate brazilian c27s006_OmaHouse_d016f00b:

    # oma "Dan a un patio interior y entonces entran los olores de lo que cocinan los vecinos."
    oma "Eles ficam de frente para um pátio interno, e então os cheiros da comida que os vizinhos estão preparando entram."

# game/scripts/c27/c27.rpy:3470
translate brazilian c27s006_OmaHouse_8e4da8c2:

    # mc "*Risa* Se pueden dar combinaciones horribles entonces."
    mc "*Risos* Combinações horríveis são possíveis, então."

# game/scripts/c27/c27.rpy:3472
translate brazilian c27s006_OmaHouse_62a6b4a3:

    # oma "Ven a mi habitación, te la enseño antes de coger los pijamas."
    oma "Venha ao meu quarto, eu lhe mostrarei antes de pegar meu pijama."

# game/scripts/c27/c27.rpy:3473
translate brazilian c27s006_OmaHouse_ddbb2b57:

    # mc "*Risa* ¿Has hecho la cama?"
    mc "*Risos* Você já arrumou a cama?"

# game/scripts/c27/c27.rpy:3474
translate brazilian c27s006_OmaHouse_0d321078:

    # oma "No dormí aquí anoche, con lo que no era necesario. Pero la hago siempre que me levanto."
    oma "Eu não dormi aqui ontem à noite, então não era necessário. Mas eu faço isso toda vez que me levanto."

# game/scripts/c27/c27.rpy:3476
translate brazilian c27s006_OmaHouse_c9d0cc38:

    # oma "Pues esta es mi habitación. No es gran cosa pero suficiente para mí."
    oma "Bem, este é o meu quarto. Não tem nada de especial, mas é suficiente para mim."

# game/scripts/c27/c27.rpy:3477
translate brazilian c27s006_OmaHouse_3ca2575e:

    # oma "Al otro lado de esa pared está la habitación de invitados y detrás de ésta, el baño que también sirve de sala de la colada."
    oma "Do outro lado dessa parede fica o quarto de hóspedes e, atrás dele, o banheiro, que também serve como lavanderia."

# game/scripts/c27/c27.rpy:3478
translate brazilian c27s006_OmaHouse_9105bad6:

    # mc "Me gustan los cuadros."
    mc "Eu gosto de pinturas."

# game/scripts/c27/c27.rpy:3480
translate brazilian c27s006_OmaHouse_6697c725:

    # mc "Y ese póster de reclutamiento."
    mc "E aquele cartaz de recrutamento."

# game/scripts/c27/c27.rpy:3481
translate brazilian c27s006_OmaHouse_cc3253ed:

    # oma "*Risa* A ti lo que te gusta es la chica."
    oma "*Risos* O que você gosta é da garota."

# game/scripts/c27/c27.rpy:3482
translate brazilian c27s006_OmaHouse_6835d88e:

    # mc "Es mona."
    mc "Ela é fofa."

# game/scripts/c27/c27.rpy:3484
translate brazilian c27s006_OmaHouse_57b8be37:

    # oma "Es el poster de reclutamiento que veía por todos lados cuando era adolescente."
    oma "É o cartaz de recrutamento que eu via em todo lugar quando era adolescente."

# game/scripts/c27/c27.rpy:3485
translate brazilian c27s006_OmaHouse_a6e51f62:

    # oma "Ver a una Latina tan mona con el uniforme me ayudó a cambiar mi idea sobre ser abogada. No es que me compare con ella, claro."
    oma "Ver uma latina tão bonita de uniforme me ajudou a mudar minha perspectiva sobre ser advogada. Não que eu me compare a ela, claro."

# game/scripts/c27/c27.rpy:3487
translate brazilian c27s006_OmaHouse_45f56c03:

    # oma "Cuando vino a mi instituto a una de esas charlas que da la policía de vez en cuando, la idea ya estaba en mi cabeza y le pedí uno de los posters."
    oma "Quando ele veio à minha escola para uma daquelas palestras que a polícia dá de vez em quando, a ideia já estava na minha cabeça e eu pedi a ele um dos cartazes."

# game/scripts/c27/c27.rpy:3488
translate brazilian c27s006_OmaHouse_169c5cf5:

    # oma "Su charla y las explicaciones que dio sobre cómo podía ayudar al vecindario me acabó de convencer."
    oma "O discurso dele e as explicações que ele deu sobre como poderia ajudar a vizinhança finalmente me convenceram."

# game/scripts/c27/c27.rpy:3489
translate brazilian c27s006_OmaHouse_975f8d96:

    # mc "Siempre pensé que la gente de esos carteles eran modelos."
    mc "Eu sempre achei que as pessoas naqueles pôsteres fossem modelos."

# game/scripts/c27/c27.rpy:3491
translate brazilian c27s006_OmaHouse_5b93f3fa:

    # oma "No en el caso de Esperanza. Ella es... o era... una patrullera, pero la escogieron para la campaña de reclutamiento y de relaciones públicas."
    oma "Não é o caso de Esperanza. Ela é... ou era... uma policial, mas foi escolhida para a campanha de recrutamento e relações públicas."

# game/scripts/c27/c27.rpy:3492
translate brazilian c27s006_OmaHouse_50086073:

    # mc "¿Has dicho 'era'...?"
    mc "Você disse 'era'...?"

# game/scripts/c27/c27.rpy:3494
translate brazilian c27s006_OmaHouse_63f4c0a2:

    # oma "¡Oh, no! No me refiero a que haya muerto. *Risa* Me refería a que hace años de eso y a lo mejor ya es detective o sargento."
    oma "Ah, não! Não quis dizer que ele morreu. *Risos* Quis dizer que já se passaram anos; a melhor coisa sobre ele era ser detetive ou sargento."

# game/scripts/c27/c27.rpy:3495
translate brazilian c27s006_OmaHouse_0f7784d4:

    # mc "*Risa triste* Menos mal. Por un momento había pensado que..."
    mc "*Risada triste* Ainda bem. Por um momento pensei que..."

# game/scripts/c27/c27.rpy:3497
translate brazilian c27s006_OmaHouse_01a7133e:

    # oma "Lo entiendo. Cada vez que sale alguna noticia de un policía que ha muerto en acto de servicio en cualquier parte del país mi madre me llama."
    oma "Eu entendo. Toda vez que sai uma notícia sobre um policial que morreu em serviço em qualquer lugar do país, minha mãe me liga."

# game/scripts/c27/c27.rpy:3498
translate brazilian c27s006_OmaHouse_d6fea21b:

    # oma "Hablamos todas las semanas por teléfono, pero cuando ve algo así en las noticias hace una video conferencia."
    oma "Conversamos por telefone toda semana, mas quando ele vê algo assim no noticiário, ele faz uma videoconferência."

# game/scripts/c27/c27.rpy:3499
translate brazilian c27s006_OmaHouse_fe7a2701:

    # mc "Quiere asegurarse de que estés bien. Y quiere verlo con sus propios ojos."
    mc "Ele quer ter certeza de que você está bem. E quer ver com os próprios olhos."

# game/scripts/c27/c27.rpy:3501
translate brazilian c27s006_OmaHouse_bbc76ed2:

    # oma "Es exactamente eso, aunque ella no se dé cuenta. Da lo mismo si hemos hablado hoy. Si mañana muere un agente en Florida, mi madre hará una video llamada."
    oma "É exatamente isso, mesmo que ela não perceba. Não importa se conversamos hoje. Se um agente morrer na Flórida amanhã, minha mãe fará uma chamada de vídeo."

# game/scripts/c27/c27.rpy:3502
translate brazilian c27s006_OmaHouse_fc49d380:

    # mc "Es normal. Yo también lo haría. Es más, yo haría video conferencias en cada llamada."
    mc "Isso é normal. Eu também faria isso. Aliás, eu usaria videoconferência para todas as chamadas."

# game/scripts/c27/c27.rpy:3503
translate brazilian c27s006_OmaHouse_dc521bb9:

    # mc "Creo que me voy a pasar el día pegado a la cámara cuando esté en Aruba."
    mc "Acho que vou passar o dia inteiro grudado na câmera quando estiver em Aruba."

# game/scripts/c27/c27.rpy:3505
translate brazilian c27s006_OmaHouse_4b1692cc:

    # oma "Te vamos a echar mucho de menos."
    oma "Vamos sentir muito a sua falta."

# game/scripts/c27/c27.rpy:3506
translate brazilian c27s006_OmaHouse_3c28c0bd:

    # mc "Y yo a vosotras. Va a ser raro estar tanto tiempo separados."
    mc "E eu sinto o mesmo por você. Vai ser estranho ficarmos separados por tanto tempo."

# game/scripts/c27/c27.rpy:3509
translate brazilian c27s006_OmaHouse_26c2ab2a:

    # oma "Por suerte, aún quedan días para que te vayas."
    oma "Felizmente, ainda faltam alguns dias para a sua partida."

# game/scripts/c27/c27.rpy:3510
translate brazilian c27s006_OmaHouse_cd0aac55:

    # oma "Déjame coger los pijamas y el uniforme y vamos a casa."
    oma "Vou pegar meu pijama e uniforme e vamos para casa."

# game/scripts/c27/c27.rpy:3511
translate brazilian c27s006_OmaHouse_52721442:

    # mc "Voy a cotillear tu piso un poco más y te espero al final del pasillo, en eso que llamas salón."
    mc "Vou me divertir um pouco mais no seu apartamento e vou te esperar no final do corredor, no que você chama de sala de estar."

# game/scripts/c27/c27.rpy:3516
translate brazilian c27s006_OmaHouse_bb0c65a1:

    # mc "Aunque puedes venir a verme cuando quieras o cuando puedas."
    mc "Embora você possa vir me ver quando quiser ou quando puder."

# game/scripts/c27/c27.rpy:3517
translate brazilian c27s006_OmaHouse_2262068a:

    # oma "Lo he pensado. Este año aún me quedan dos semanas de vacaciones."
    oma "Já pensei nisso. Ainda tenho duas semanas de férias este ano."

# game/scripts/c27/c27.rpy:3518
translate brazilian c27s006_OmaHouse_70a6390e:

    # mc "Pues espero que vengas a Aruba a verme, al menos parte de esas dos semanas."
    mc "Bem, espero que você venha a Aruba para me ver, pelo menos durante parte dessas duas semanas."

# game/scripts/c27/c27.rpy:3520
translate brazilian c27s006_OmaHouse_37cf521c:

    # oma "Déjame coger una cosa en el baño. Espérame aquí."
    oma "Vou pegar uma coisa no banheiro. Espere aqui."

# game/scripts/c27/c27.rpy:3521
translate brazilian c27s006_OmaHouse_9bbfd447:

    # mc "OK. ¿Tienes el uniforme y los pijamas en el baño?"
    mc "Certo. Você tem seu uniforme e pijama no banheiro?"

# game/scripts/c27/c27.rpy:3523
translate brazilian c27s006_OmaHouse_d08669e4:

    # oma "Ya te he dicho que también era la sala de lavandería. No tardo."
    oma "Eu já te disse que também era a lavanderia. Já volto."

# game/scripts/c27/c27.rpy:3531
translate brazilian c27s006_OmaHouse_c39ffd4d:

    # oma "Ya estoy lista."
    oma "Estou pronto."

# game/scripts/c27/c27.rpy:3536
translate brazilian c27s006_ColombiaPics_83c5e73e:

    # mc "¿Los cuadros son de Colombia?"
    mc "As pinturas são da Colômbia?"

# game/scripts/c27/c27.rpy:3537
translate brazilian c27s006_ColombiaPics_03b11b44:

    # oma "*Desde el baño* Sí, me los regaló mi abuelo. No me gustan, pero me recuerdan a él, con lo que no quiero quitarlos."
    oma "*Do banheiro* Sim, meu avô me deu. Eu não gosto delas, mas elas me lembram dele, então não quero tirá-las."

# game/scripts/c27/c27.rpy:3538
translate brazilian c27s006_ColombiaPics_7c91e6b4:

    # mc "Te entiendo. Creo que voy a tener fotos de todas vosotras en la casa de Aruba."
    mc "Entendo. Acho que vou tirar fotos de todos vocês na casa em Aruba."

# game/scripts/c27/c27.rpy:3540
translate brazilian c27s006_ColombiaPics_e3c7c9e9:

    # mc "El salón es sorprendentemente cómodo."
    mc "A sala de estar é surpreendentemente confortável."

# game/scripts/c27/c27.rpy:3541
translate brazilian c27s006_ColombiaPics_a8a8affc:

    # oma "*Desde el baño* Gracias. No me gusta tener demasiadas cosas, y menos en un piso tan pequeño."
    oma "*Do banheiro* Obrigada. Não gosto de ter muitas coisas, principalmente em um apartamento tão pequeno."

# game/scripts/c27/c27.rpy:3542
translate brazilian c27s006_ColombiaPics_ffdf72ba:

    # oma "*Desde el baño* Con todo lo que ahorré en decoración, compré un buen sofá."
    oma "*Do banheiro* Com todo o dinheiro que economizei na decoração, comprei um sofá bonito."

# game/scripts/c27/c27.rpy:3546
translate brazilian c27s006_Ready_8554240f:

    # oma "Ya estoy lista. Nos podemos ir cuando quieras."
    oma "Estou pronto. Podemos ir embora quando você quiser."

# game/scripts/c27/c27.rpy:3547
translate brazilian c27s006_Ready_b58b04d2:

    # mc "Vamos, las chicas estarán deseando volverte a ver."
    mc "Vamos lá, as garotas vão adorar te ver de novo."

# game/scripts/c27/c27.rpy:3551
translate brazilian c27s006_Drive_c2b33a74:

    # "Poco después volvéis a por la camioneta y sigues charlando con [oma] mientras la llevas a casa."
    "Logo depois você volta para a van e continua conversando com [oma] enquanto a leva para casa."

# game/scripts/c27/c27.rpy:3552
translate brazilian c27s006_Drive_df6dcad8:

    # "Nunca se había subido a tu camioneta y van dos veces en el mismo día."
    "Ele nunca tinha andado na sua caminhonete antes, e esta é a segunda vez no mesmo dia."

# game/scripts/c27/c27.rpy:3553
translate brazilian c27s006_Drive_9cf55007:

    # "Le gusta más que su viejo coche. No te sorprende."
    "Ele gosta mais deste do que do carro antigo. Não é de admirar."

# game/scripts/c27/c27.rpy:3558
translate brazilian c27s008_NoOma_450ebe3b:

    # "Mientras esperas que [eil] y [sca] vuelvan del café, subes a tu habitación a jugar a My Residence un rato."
    "Enquanto espera que [eil] e [sca] voltem do café, você sobe para o seu quarto para jogar My Residence por um tempo."

# game/scripts/c27/c27.rpy:3559
translate brazilian c27s008_NoOma_b4156144:

    # "Tienes una tórrida escena con Alejandra, la bombera Latina, que se disfraza de policía para la escena, reforzando su parecido con [oma]."
    "Você tem uma cena quente com Alejandra, a bombeira latina, que se veste de policial para a cena, reforçando sua semelhança com [oma]."

# game/scripts/c27/c27.rpy:3569
translate brazilian c27s006_Teaser_aeca0d27:

    # "Al cabo de un rato..."
    "Depois de um tempo..."

# game/scripts/c27/c27.rpy:3571
translate brazilian c27s006_Teaser_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c27/c27.rpy:3572
translate brazilian c27s006_Teaser_dba43fc1:

    # mc "¿Esperas a alguien?"
    mc "Você está esperando por alguém?"

# game/scripts/c27/c27.rpy:3573
translate brazilian c27s006_Teaser_a566da44:

    # oma "Es posible que sea mi casera."
    oma "Ela pode ser minha senhoria."

# game/scripts/c27/c27.rpy:3575
translate brazilian c27s006_Teaser_a1261f46:

    # mc "Inoportuna casera..."
    mc "Proprietária inconveniente..."

# game/scripts/c27/c27.rpy:3577
translate brazilian c27s006_Teaser_59d8b241:

    # oma "*Risa* Con los gritos que he estado dando, alguien podría pensar que me estaban asesinando."
