

# game/scripts/c27/c27.rpy:40
translate brazilian c27_0ae9bcd0:

    # ""
    ""

# game/scripts/c27/c27.rpy:55
translate brazilian c27s001_DebDate_6e671808:

    # deb "Gracias, pero no intentes ruborizarme. Creo que ya lo has hecho suficiente con [kat] esta mañana."
    deb "Obrigado, mas não tente me constranger. Acho que você já fez o suficiente com [kat] esta manhã."

# game/scripts/c27/c27.rpy:56
translate brazilian c27s001_DebDate_0d4c2f91:

    # mc "No lo digo por ruborizarte, lo digo porque es verdad. Además, me encanta cómo te queda ese vestido."
    mc "Não estou dizendo isso para te constranger, estou dizendo porque é verdade. Além disso, adorei como esse vestido ficou em você."

# game/scripts/c27/c27.rpy:58
translate brazilian c27s001_DebDate_81172e04:

    # deb "[kim] me ha dicho que... como tengo las piernas tan largas... un vestido asimétrico las realzaría."
    deb "[kim] me disse que... já que tenho pernas tão longas... um vestido assimétrico as valorizaria."

# game/scripts/c27/c27.rpy:59
translate brazilian c27s001_DebDate_51301f4a:

    # deb "No sé si creerla. Siempre he pensado que tengo las piernas {b}demasiado{/b} largas. No es una cosa que me guste realzar."
    deb "Não sei se acredito nela. Sempre achei que minhas pernas são muito compridas. Não é algo que eu goste de enfatizar."

# game/scripts/c27/c27.rpy:60
translate brazilian c27s001_DebDate_ef669374:

    # mc "Cielo, no existen 'piernas {b}demasiado{/b} largas'."
    mc "Querida, não existe essa coisa de 'pernas {b}muito{/b}compridas'."

# game/scripts/c27/c27.rpy:61
translate brazilian c27s001_DebDate_20b041d4:

    # mc "Como se suele decir, las tuyas son tan largas que, al recorrerlas, apetece hacer un descanso a medio camino."
    mc "Como se costuma dizer, as suas são tão compridas que, ao caminhar por elas, dá vontade de parar a meio do caminho."

# game/scripts/c27/c27.rpy:63
translate brazilian c27s001_DebDate_a513a08c:

    # deb "¡[mc]! ¡Eso ha sonado más travieso de lo que creo que querías sonar!"
    deb "[mc]! Isso soou mais malicioso do que você pretendia!"

# game/scripts/c27/c27.rpy:64
translate brazilian c27s001_DebDate_442b68f3:

    # mc "*Risa* No te imaginas lo travieso que quería sonar."
    mc "*Risos* Você não imagina o quão maliciosa eu queria parecer."

# game/scripts/c27/c27.rpy:65
translate brazilian c27s001_DebDate_f5cc2b81:

    # mc "Pero, ¿puedo besar a mi cita?"
    mc "Mas posso beijar meu(minha) namorado(a)?"

# game/scripts/c27/c27.rpy:67
translate brazilian c27s001_DebDate_a10869e9:

    # "La sirena no te contesta y toma la iniciativa por sí misma, besándote dulcemente. Los tacones y la diferencia de altura te hacen sentirte pequeño."
    "A sereia não responde e toma a iniciativa, beijando-o(a) docemente. Os saltos altos e a diferença de altura fazem você se sentir pequeno(a)."

# game/scripts/c27/c27.rpy:68
translate brazilian c27s001_DebDate_72f51c6f:

    # "¡Cómo ha cambiado la nadadora! Ha pasado de inventarse juegos para robarte un beso a tomar la iniciativa."
    "Como a nadadora mudou! Ela passou de inventar brincadeiras para roubar um beijo a tomar a iniciativa."

# game/scripts/c27/c27.rpy:69
translate brazilian c27s001_DebDate_db44b796:

    # "Es un beso que te dejará con ganas de más cuando termine. Da lo mismo que dure un segundo o una hora."
    "É um beijo que vai te deixar querendo mais quando acabar. Não importa se dura um segundo ou uma hora."

# game/scripts/c27/c27.rpy:71
translate brazilian c27s001_DebDate_4b388357:

    # "Cuando separa sus labios de los tuyos sientes una sensación de pérdida."
    "Quando ele separa os lábios dos seus, você sente uma sensação de perda."

# game/scripts/c27/c27.rpy:72
translate brazilian c27s001_DebDate_b763e483:

    # deb "Vámonos antes de que tenga que llevarte a tu habitación a probar esa cama nueva."
    deb "Vamos embora antes que eu tenha que te levar ao seu quarto para experimentar aquela cama nova."

# game/scripts/c27/c27.rpy:73
translate brazilian c27s001_DebDate_e4ee9aa0:

    # mc "*Risa* Ahora eres tú la que has sonado traviesa..."
    mc "*Risos* Agora sim, você que falou besteira..."

# game/scripts/c27/c27.rpy:75
translate brazilian c27s001_DebDate_151de55f:

    # deb "*Risa* Pero no más de lo que quería sonar."
    deb "*Risos* Mas não mais do que eu queria parecer."

# game/scripts/c27/c27.rpy:76
translate brazilian c27s001_DebDate_4730b6b0:

    # deb "Tengo intención de que me enseñes esa cama cuando volvamos de comer."
    deb "Quero que você me mostre aquela cama quando voltarmos do jantar."

# game/scripts/c27/c27.rpy:77
translate brazilian c27s001_DebDate_9e51209c:

    # "Otra vez te maravillas de lo mucho que ha evolucionado la siempre tímida [deb.nick]."
    "Mais uma vez você se maravilha com o quanto o sempre tímido [deb.nick] evoluiu."

# game/scripts/c27/c27.rpy:78
translate brazilian c27s001_DebDate_e9d72f3f:

    # mc "Entonces será mejor que nos vayamos. [emm] quería ser la primera en probar la cama."
    mc "Então é melhor irmos. [emm] Eu queria ser o primeiro a experimentar a cama."

# game/scripts/c27/c27.rpy:80
translate brazilian c27s001_DebDate_e8b5c3db:

    # deb "Ya veremos..."
    deb "Veremos..."

# game/scripts/c27/c27.rpy:81
translate brazilian c27s001_DebDate_04df0c90:

    # mc "Me gusta esa nueva [deb.nick]. Pero espera..."
    mc "Gostei desse novo [deb.nick]. Mas espere..."

# game/scripts/c27/c27.rpy:83
translate brazilian c27s001_DebDate_9b1b27ed:

    # deb "¿Qué pasa?"
    deb "O que está acontecendo?"

# game/scripts/c27/c27.rpy:84
translate brazilian c27s001_DebDate_dc5fdda3:

    # mc "Quiero un beso antes de irnos."
    mc "Quero um beijo antes de irmos."

# game/scripts/c27/c27.rpy:86
translate brazilian c27s001_DebDate_0d0a276b:

    # deb "¡Soy idiota! ¡Estaba tan nerviosa por si te gustaría el vestido que ni he pensado en el beso!"
    deb "Que idiota eu sou! Estava tão nervosa para saber se você ia gostar do vestido que nem pensei no beijo!"

# game/scripts/c27/c27.rpy:87
translate brazilian c27s001_DebDate_29ea87c7:

    # mc "Y sigues nerviosa. Ya nos hemos besado."
    mc "E você ainda está nervoso. Nós já nos beijamos."

# game/scripts/c27/c27.rpy:88
translate brazilian c27s001_DebDate_8ca2a38c:

    # deb "¿Qué? ¿Cuándo?"
    deb "O quê? Quando?"

# game/scripts/c27/c27.rpy:89
translate brazilian c27s001_DebDate_e9fe48bf:

    # mc "*Risa* Hace un minuto. Ven aquí."
    mc "*Risos* Há um minuto. Venha aqui."

# game/scripts/c27/c27.rpy:91
translate brazilian c27s001_DebDate_e23c623f:

    # "Las tres pulgadas que [deb.nick] es más alta que tú, más los tacones suplen el escalón que ella está más abajo."
    "Os três centímetros que [deb.nick] tem a mais de altura do que você, mais os saltos, compensam o degrau que ela é mais baixa."

# game/scripts/c27/c27.rpy:92
translate brazilian c27s001_DebDate_792ce7a8:

    # "Por primera vez no tienes que inclinar tu cabeza hacia atrás para besarla. Lo echas de menos. Adoras la altura de la nadadora."
    "Pela primeira vez, você não precisa inclinar a cabeça para trás para beijá-la. Você sente falta disso. Você adora a altura dela como nadadora."

# game/scripts/c27/c27.rpy:94
translate brazilian c27s001_DebDate_9cb06c4d:

    # deb "Si me besas así, se me van a pasar los nervios. Pero creo que entonces podré pasar de la comida e ir directamente a ver esa cama."
    deb "Se você me beijar assim, eu me acalmo. Mas acho que depois posso pular a refeição e ir direto para a cama."

# game/scripts/c27/c27.rpy:95
translate brazilian c27s001_DebDate_8cc92cfd:

    # mc "Entonces dejaré de besarte hasta que acabemos de comer. Tengo muchas ganas de ir a comer contigo."
    mc "Então, vou parar de te beijar até terminarmos de comer. Estou muito ansiosa para comer com você."

# game/scripts/c27/c27.rpy:97
translate brazilian c27s001_DebDate_dc12975b:

    # deb "Besar o comer. *Risa* Me pones entre la espada y la pared. Vámonos antes de que haga una locura."
    deb "Beijar ou comer. *Risos* Você me colocou numa situação difícil. Vamos embora antes que eu faça alguma loucura."

# game/scripts/c27/c27.rpy:98
translate brazilian c27s001_DebDate_765d6b56:

    # mc "Cualquier locura compartida me parecería bien. Pero podemos esperar a después de comer."
    mc "Qualquer loucura compartilhada seria ótima para mim. Mas podemos esperar até depois do almoço."

# game/scripts/c27/c27.rpy:101
translate brazilian c27s001_DebDate_cec05883:

    # "Una vez llegáis al restaurante..."
    "Assim que você chegar ao restaurante..."

# game/scripts/c27/c27.rpy:103
translate brazilian c27s001_DebDate_2a2dd50a:

    # deb "Es bonito. Me recuerda a un sitio en el que estuvimos hace un par de años, en Verona."
    deb "É lindo. Me lembra um lugar que visitamos há alguns anos em Verona."

# game/scripts/c27/c27.rpy:104
translate brazilian c27s001_DebDate_2c8bb01b:

    # deb "Se nota que es un decorado, pero está muy logrado."
    deb "É claramente um cenário, mas é muito bem feito."

# game/scripts/c27/c27.rpy:105
translate brazilian c27s001_DebDate_9a611046:

    # mc "¿Has viajado mucho fuera de Estados Unidos?"
    mc "Você já viajou muito para fora dos Estados Unidos?"

# game/scripts/c27/c27.rpy:107
translate brazilian c27s001_DebDate_844704a1:

    # deb "Un poco. Creo que este año es el primer verano que recuerdo sin ningún viaje al extranjero en los últimos 13 o 14 años."
    deb "Um pouco. Acho que este ano é o primeiro verão de que me lembro sem nenhuma viagem ao exterior nos últimos 13 ou 14 anos."

# game/scripts/c27/c27.rpy:108
translate brazilian c27s001_DebDate_ebd54c03:

    # mc "¿En qué países has estado?"
    mc "Quais países você já visitou?"

# game/scripts/c27/c27.rpy:109
translate brazilian c27s001_DebDate_eb037365:

    # deb "Italia, Reino Unido, Portugal, España, Francia, Dinamarca, Suecia, Noruega, Suiza, Alemania, Grecia, Turquía, Japón, China, Australia, Nueva Zelanda, India, Vietnam..."
    deb "Itália, Reino Unido, Portugal, Espanha, França, Dinamarca, Suécia, Noruega, Suíça, Alemanha, Grécia, Turquia, Japão, China, Austrália, Nova Zelândia, Índia, Vietnã..."

# game/scripts/c27/c27.rpy:111
translate brazilian c27s001_DebDate_57e9a0d2:

    # deb "¿Cuánto rato me vas a seguir dejando decir países?"
    deb "Até quando você vai me deixar ficar citando nomes de países?"

# game/scripts/c27/c27.rpy:112
translate brazilian c27s001_DebDate_fb7527d3:

    # mc "Pensaba dejarte hasta que recorrieras la ONU al completo. *Risa*"
    mc "Eu planejava te deixar lá até que você tivesse explorado toda a ONU. *Risos*"

# game/scripts/c27/c27.rpy:114
translate brazilian c27s001_DebDate_ee968cba:

    # deb "*Risa* No, qué va. En África sólo he estado en Marruecos, Túnez y Egipto. En Latino América sólo en México, Perú, Guatemala, Ecuador, Brasil y Colombia."
    deb "*Risos* Não, de jeito nenhum. Na África, só estive em Marrocos, Tunísia e Egito. Na América Latina, apenas no México, Peru, Guatemala, Equador, Brasil e Colômbia."

# game/scripts/c27/c27.rpy:115
translate brazilian c27s001_DebDate_79a6b884:

    # deb "La Unión Europea la he recorrido entera, y de Asia me quedaban por decir Camboya y Tailandia. Creo que no me dejo ningún país de la lista..."
    deb "Já viajei por toda a União Europeia e, na Ásia, ainda me faltam mencionar Camboja e Tailândia. Acho que não me esqueci de nenhum país da lista..."

# game/scripts/c27/c27.rpy:116
translate brazilian c27s001_DebDate_d5f11554:

    # mc "Es decir... unos 50 países en 13 o 14 años... es impresionante. Pero casi te daba tiempo a aterrizar y poco más, ¿no?"
    mc "Quer dizer... uns 50 países em 13 ou 14 anos... isso é impressionante. Mas você mal teve tempo de pousar e pouco mais, né?"

# game/scripts/c27/c27.rpy:118
translate brazilian c27s001_DebDate_02eeb9de:

    # deb "Bueno, en verano hacíamos viajes de un mes con mi madre cuando acababan las clases. Y después un par de semanas extras con mi padre en Agosto."
    deb "Bem, no verão costumávamos fazer viagens de um mês com minha mãe quando as aulas terminavam. E depois mais algumas semanas com meu pai em agosto."

# game/scripts/c27/c27.rpy:119
translate brazilian c27s001_DebDate_f42e0d10:

    # deb "Suma a eso Acción de Gracias, Navidad... Quizás eran un par de meses viajando cada año. Y no son 50 países, sólo 48."
    deb "Acrescente a isso o Dia de Ação de Graças, o Natal... Talvez fossem alguns meses de viagens por ano. E não são 50 países, apenas 48."

# game/scripts/c27/c27.rpy:120
translate brazilian c27s001_DebDate_96ed9f61:

    # mc "Sigue siendo impresionante."
    mc "Continua sendo impressionante."

# game/scripts/c27/c27.rpy:122
translate brazilian c27s001_DebDate_e5b3767a:

    # deb "Hay países que me hubiera gustado ver más en profundidad. De algunos sólo he estado en una o dos ciudades."
    deb "Há países que eu gostaria de ter explorado mais a fundo. Em alguns, visitei apenas uma ou duas cidades."

# game/scripts/c27/c27.rpy:123
translate brazilian c27s001_DebDate_24a624ac:

    # deb "Y hay otros a los que he ido varias veces, como Italia, Francia, España, Canadá..."
    deb "E há outros lugares que visitei várias vezes, como Itália, França, Espanha, Canadá..."

# game/scripts/c27/c27.rpy:124
translate brazilian c27s001_DebDate_9b15654d:

    # mc "¿Tienes algún país favorito?"
    mc "Você tem um país favorito?"

# game/scripts/c27/c27.rpy:126
translate brazilian c27s001_DebDate_9ff5f84b:

    # deb "Muchos. No podría elegir uno. Cada país tiene su encanto, su cultura... Por norma mi país favorito es en el que estoy en ese momento."
    deb "Muitos. Não consigo escolher apenas um. Cada país tem seu próprio charme, sua própria cultura... Via de regra, meu país favorito é aquele em que estou no momento."

# game/scripts/c27/c27.rpy:127
translate brazilian c27s001_DebDate_0559c921:

    # deb "Si empiezas a pensar cosas como 'esto era más bonito, o estaba más bueno, en otro sitio' no disfrutas lo que estás viviendo."
    deb "Se você começar a pensar coisas como \"isso era mais bonito ou melhor em outro lugar\", você não aproveitará o que está vivenciando."

# game/scripts/c27/c27.rpy:128
translate brazilian c27s001_DebDate_5dc520e9:

    # deb "Me encanta viajar, y cuando estoy en un sitio sólo existe ese sitio. No puedo compararlo con otros."
    deb "Adoro viajar, e quando estou em algum lugar, aquele é o único lugar que existe. Não consigo comparar com outros."

# game/scripts/c27/c27.rpy:129
translate brazilian c27s001_DebDate_97045e27:

    # mc "Nunca lo había visto así. Siempre he oído a gente decir 'Estoy enamorado de Japón, Italia, o España'."
    mc "Nunca tinha pensado nisso dessa forma. Sempre ouvi as pessoas dizerem: \"Sou apaixonado pelo Japão, pela Itália ou pela Espanha\"."

# game/scripts/c27/c27.rpy:130
translate brazilian c27s001_DebDate_120ee616:

    # mc "Tiene mucha más lógica cómo lo dices tú."
    mc "Faz muito mais sentido do jeito que você diz."

# game/scripts/c27/c27.rpy:132
translate brazilian c27s001_DebDate_c9ea9070:

    # deb "¿Y tú? ¿En qué países has estado?"
    deb "E você? Que países você já visitou?"

# game/scripts/c27/c27.rpy:133
translate brazilian c27s001_DebDate_2998f279:

    # mc "De toda tu lista, sólo en Canadá. Fui a un concierto en Vancouver cuando estaba en Portland, el primer año."
    mc "De tudo que está na sua lista, só no Canadá. Eu fui a um show em Vancouver quando estava em Portland, no meu primeiro ano."

# game/scripts/c27/c27.rpy:134
translate brazilian c27s001_DebDate_1eb823d3:

    # deb "¿Y sitios que no estén en mi lista?"
    deb "E quanto aos lugares que não estão na minha lista?"

# game/scripts/c27/c27.rpy:135
translate brazilian c27s001_DebDate_dbbd4c94:

    # mc "*Risa* Ninguno. No hemos viajado mucho, ni dentro ni fuera de Estados Unidos."
    mc "*Risos* Nenhuma. Não viajamos muito, nem dentro nem fora dos Estados Unidos."

# game/scripts/c27/c27.rpy:136
translate brazilian c27s001_DebDate_64d51d8f:

    # mc "Pero estaré en Aruba, que no está en tu lista. *Risa*"
    mc "Mas eu estarei em Aruba, que não está na sua lista. *Risos*"

# game/scripts/c27/c27.rpy:138
translate brazilian c27s001_DebDate_2553ffcc:

    # deb "Bueno, el status de Aruba como país es diferente a lo que estamos acostumbrados los americanos."
    deb "Bem, o status de Aruba como país é diferente do que nós, americanos, estamos acostumados."

# game/scripts/c27/c27.rpy:139
translate brazilian c27s001_DebDate_cd1fe8ab:

    # deb "Casi sería como hablar de un estado de los Países Bajos. Como si habláramos de Virginia respecto a Estados Unidos."
    deb "Seria quase como falar de um estado da Holanda. Como falar da Virgínia em relação aos Estados Unidos."

# game/scripts/c27/c27.rpy:140
translate brazilian c27s001_DebDate_7b3ff11f:

    # mc "Siempre he pensado que era un país independiente."
    mc "Eu sempre pensei que fosse um país independente."

# game/scripts/c27/c27.rpy:142
translate brazilian c27s001_DebDate_c9eceb4a:

    # deb "Yo también. Nunca había leído nada sobre él hasta que decidiste irte allí."
    deb "Eu também. Nunca tinha lido nada sobre isso até você decidir ir."

# game/scripts/c27/c27.rpy:143
translate brazilian c27s001_DebDate_e8dc22b4:

    # deb "Conozco gente que ha ido a hacer turismo, pero no sabía nada del país."
    deb "Conheço pessoas que foram lá como turistas, mas eu não sabia nada sobre o país."

# game/scripts/c27/c27.rpy:144
translate brazilian c27s001_DebDate_af3ebf53:

    # mc "Es conmovedor que te preocupes así por mí."
    mc "É comovente que você se importe comigo dessa forma."

# game/scripts/c27/c27.rpy:146
translate brazilian c27s001_DebDate_7f378831:

    # deb "*Risa* Tenía que comprobar si iban a secuestrar a mi novio o algo así."
    deb "*Risos* Tive que verificar se eles iam sequestrar meu namorado ou algo assim."

# game/scripts/c27/c27.rpy:147
translate brazilian c27s001_DebDate_acd21027:

    # mc "Creo que el riesgo de secuestro es más alto por parte de la empresa que del país."
    mc "Acredito que o risco de sequestro seja maior por parte da empresa do que por parte do país."

# game/scripts/c27/c27.rpy:148
translate brazilian c27s001_DebDate_43673dbb:

    # mc "*Risa* Y que me protejan de un posible secuestro también."
    mc "*Risos* E que eles também me protegem de um possível sequestro."

# game/scripts/c27/c27.rpy:149
translate brazilian c27s001_DebDate_a7f8dac3:

    # deb "*Risa* Tienes razón. Yo no intentaría secuestrarte con [ama] o [eva] cerca. *Susurrando* Y un ejército de clones."
    deb "*Risos* Você tem razão. Eu não tentaria te sequestrar com [ama] ou [eva] por perto. *Sussurrando* E um exército de clones."

# game/scripts/c27/c27.rpy:151
translate brazilian c27s001_DebDate_69705291:

    # deb "Por suerte hoy no están en casa..."
    deb "Ainda bem que eles não estão em casa hoje..."

# game/scripts/c27/c27.rpy:152
translate brazilian c27s001_DebDate_c5aaca27:

    # mc "Te noto muy traviesa hoy. *Risa* No me lo esperaba."
    mc "Você parece muito travesso hoje. *Risos* Eu não esperava por isso."

# game/scripts/c27/c27.rpy:154
translate brazilian c27s001_DebDate_91aa1172:

    # deb "Empecé a hacer bromas con [lis] anoche para ocultar lo insegura que me sentía."
    deb "Comecei a fazer piadas com [lis] ontem à noite para esconder o quão inseguro eu me sentia."

# game/scripts/c27/c27.rpy:155
translate brazilian c27s001_DebDate_e927e82f:

    # deb "¿Sabes lo de fingir una sonrisa hasta que sea real? Pues con las bromas sobre sexo funcionó. Tras varias bromas, dejé de preocuparme."
    deb "Sabe aquela coisa de fingir um sorriso até que ele se torne real? Bem, funcionou com piadas de sexo. Depois de algumas piadas, parei de me preocupar."

# game/scripts/c27/c27.rpy:156
translate brazilian c27s001_DebDate_073c9c8e:

    # deb "Empecé a verlo como la continuación de lo que hicimos en el lago. Se que es un paso más, y un paso muy importante, pero..."
    deb "Comecei a ver isso como uma continuação do que fizemos no lago. Sei que é mais um passo, e um passo muito importante, mas..."

# game/scripts/c27/c27.rpy:157
translate brazilian c27s001_DebDate_c1a5986e:

    # mc "Pero lo ves natural ahora, ¿no?"
    mc "Mas agora você vê isso como algo natural, não é?"

# game/scripts/c27/c27.rpy:159
translate brazilian c27s001_DebDate_1fc4c21d:

    # deb "Lo veo el paso más natural del mundo. No es que no hayamos hecho cosas tórridas ya, con lo que el siguiente paso parece menos grande."
    deb "Vejo isso como o passo mais natural do mundo. Não é que já não tenhamos feito coisas picantes, então o próximo passo parece menos assustador."

# game/scripts/c27/c27.rpy:160
translate brazilian c27s001_DebDate_8244b8f2:

    # deb "Y bromear anoche... y seguir bromeando contigo, hace que dé menos miedo."
    deb "E as brincadeiras de ontem à noite... e continuar brincando com você, tornam tudo menos assustador."

# game/scripts/c27/c27.rpy:161
translate brazilian c27s001_DebDate_0b3f517b:

    # mc "Si tienes miedo..."
    mc "Se você tem medo..."

# game/scripts/c27/c27.rpy:163
translate brazilian c27s001_DebDate_00f1240c:

    # deb "De lo único que tengo miedo es de hacerte daño. *Risa* ¡Mis músculos son de acero!"
    deb "A única coisa que me assusta é te machucar. *Risos* Meus músculos são de aço!"

# game/scripts/c27/c27.rpy:164
translate brazilian c27s001_DebDate_29b7bf87:

    # mc "Preciosos músculos, por cierto."
    mc "Aliás, que músculos lindos."

# game/scripts/c27/c27.rpy:166
translate brazilian c27s001_DebDate_1aa8bd84:

    # deb "Pero no adelantemos acontecimientos y sigamos como si fuera una cita normal. ¿Cuál es tu libro favorito?"
    deb "Mas não vamos nos precipitar e vamos continuar como se fosse um encontro normal. Qual é o seu livro favorito?"

# game/scripts/c27/c27.rpy:167
translate brazilian c27s001_DebDate_db8e0778:

    # mc "¡Ufff! Esa es una pregunta complicada. Hay muchísimos libros que me gustan, pero si tuviera que elegir un favorito..."
    mc "Nossa! Essa é uma pergunta difícil. Tem tantos livros que eu gosto, mas se eu tivesse que escolher um favorito..."

# game/scripts/c27/c27.rpy:168
translate brazilian c27s001_DebDate_38165e76:

    # mc "Seguramente sería el tercero del Círculo del Tiempo. ¿Y el tuyo?"
    mc "Provavelmente seria o terceiro no Círculo do Tempo. E o seu?"

# game/scripts/c27/c27.rpy:170
translate brazilian c27s001_DebDate_f9ee2129:

    # deb "Yo lo tengo muy fácil. Orgullo y Prejuicio. Es el libro que me hizo amar los libros. Y por eso empecé a estudiar Literatura Inglesa."
    deb "Tenho muita facilidade. Orgulho e Preconceito. É o livro que me fez amar os livros. E é por isso que comecei a estudar Literatura Inglesa."

# game/scripts/c27/c27.rpy:171
translate brazilian c27s001_DebDate_3e25f0ac:

    # deb "He leído libros mejores, pero Orgullo y Prejuicio siempre tendrá un lugar especial en mi cabeza."
    deb "Já li livros melhores, mas Orgulho e Preconceito sempre terá um lugar especial no meu coração."

# game/scripts/c27/c27.rpy:172
translate brazilian c27s001_DebDate_82b97cbd:

    # mc "Suena a una relación especial con un libro. Yo también tengo un libro así, pero en sentido opuesto."
    mc "Parece uma relação especial com um livro. Eu também tenho um livro assim, mas no sentido oposto."

# game/scripts/c27/c27.rpy:173
translate brazilian c27s001_DebDate_7f2176e2:

    # mc "Estadística Avanzada (III) del último año de carrera. *Risa* Odié ese libro en cada una de sus páginas."
    mc "Estatística Avançada (III) do último ano da minha graduação. *Risos* Eu odiava aquele livro em cada página."

# game/scripts/c27/c27.rpy:175
translate brazilian c27s001_DebDate_2ac0b655:

    # deb "*Risa* Puedo entenderlo. Hay libros académicos que parecen ser escritos para que odies cada momento que pasas estudiando esa asignatura."
    deb "*Risos* Eu entendo. Existem livros acadêmicos que parecem ter sido escritos para fazer você odiar cada momento gasto estudando aquele assunto."

# game/scripts/c27/c27.rpy:176
translate brazilian c27s001_DebDate_ec400438:

    # mc "Sí, hay profesores que deberían tener prohibido escribir libros."
    mc "Sim, existem professores que deveriam ser proibidos de escrever livros."

# game/scripts/c27/c27.rpy:177
translate brazilian c27s001_DebDate_76358196:

    # mc "Pero hablando de estudios, ¿por qué elegiste Newport?"
    mc "Mas por falar em estudos, por que você escolheu Newport?"

# game/scripts/c27/c27.rpy:179
translate brazilian c27s001_DebDate_9cc8bb8e:

    # deb "Después de meses de chatear con Anthony, [lis] quería venir un fin de semana a conocerlo."
    deb "Depois de meses conversando com Anthony, [lis] quis vir encontrá-lo por um fim de semana."

# game/scripts/c27/c27.rpy:180
translate brazilian c27s001_DebDate_7acc7880:

    # deb "Cuando le dije que quería irme de Phoenix, empezó a planearlo todo para hacer el traslado aquí."
    deb "Quando lhe disse que queria sair de Phoenix, ele começou a planejar tudo para que eu me mudasse para cá."

# game/scripts/c27/c27.rpy:181
translate brazilian c27s001_DebDate_ce183507:

    # deb "Tienen un buen programa de Literatura Inglesa y un entrenador conocido de natación, con lo que me pareció bien."
    deb "Eles têm um bom programa de Literatura Inglesa e um treinador de natação renomado, o que me pareceu ótimo."

# game/scripts/c27/c27.rpy:182
translate brazilian c27s001_DebDate_3a584d81:

    # mc "¿Cambiasteis de universidad por Anthony?"
    mc "Você mudou de universidade por causa do Anthony?"

# game/scripts/c27/c27.rpy:184
translate brazilian c27s001_DebDate_18f5ef8b:

    # deb "No, Anthony fue lo que hizo que [lis] se interesara por la NWU. Es una universidad pequeña que ni siquiera conocíamos."
    deb "Não, foi o Anthony quem despertou o interesse de [lis] pela NWU. É uma universidade pequena que nem sabíamos que existia."

# game/scripts/c27/c27.rpy:185
translate brazilian c27s001_DebDate_e2c60607:

    # deb "Si no hubiera sido por él, habríamos acabado en alguna otra universidad. [lis] quería que estuviera en la costa."
    deb "Se não fosse por ele, teríamos acabado em outra universidade. Ele queria que eu estudasse no litoral."

# game/scripts/c27/c27.rpy:186
translate brazilian c27s001_DebDate_5f59394e:

    # deb "De todas formas, sólo nos matriculamos para el curso de verano, con lo que era una decisión poco arriesgada para probar."
    deb "De qualquer forma, nos matriculamos apenas no curso de verão, então foi uma decisão de baixo risco experimentar."

# game/scripts/c27/c27.rpy:187
translate brazilian c27s001_DebDate_0e5eaaf0:

    # mc "¿Sólo el curso de verano? Creía que os quedabais en septiembre también."
    mc "Só o curso de verão? Pensei que você também ficaria em setembro."

# game/scripts/c27/c27.rpy:189
translate brazilian c27s001_DebDate_2691dc9a:

    # deb "Nos quedamos. Pero queríamos probar la universidad antes de decidir."
    deb "Ficamos. Mas queríamos experimentar a universidade antes de decidir."

# game/scripts/c27/c27.rpy:190
translate brazilian c27s001_DebDate_eda4a3fc:

    # deb "La universidad nos ha convencido lo suficiente. Y de todas formas yo no querría irme. Al menos no para volver a Phoenix."
    deb "A universidade nos convenceu o suficiente. E de qualquer forma, eu não gostaria de ir embora. Pelo menos não para voltar a Phoenix."

# game/scripts/c27/c27.rpy:191
translate brazilian c27s001_DebDate_51bef97d:

    # mc "Si quería costa, ¿cómo acabasteis en Phoenix en primer lugar?"
    mc "Se você queria o litoral, como foi que acabou em Phoenix?"

# game/scripts/c27/c27.rpy:193
translate brazilian c27s001_DebDate_cef27452:

    # deb "Ella quería una universidad lejos de casa, para poder vivir su vida lejos donde nadie la conociera y lejos de la influencia de mi padre."
    deb "Ela queria uma universidade longe de casa, para poder viver sua vida longe de tudo, onde ninguém a conhecesse e longe da influência do meu pai."

# game/scripts/c27/c27.rpy:194
translate brazilian c27s001_DebDate_284c3d14:

    # deb "Cuando me tocó elegir universidad a mí, fui con ella."
    deb "Quando chegou a minha vez de escolher uma universidade, fui com ela."

# game/scripts/c27/c27.rpy:195
translate brazilian c27s001_DebDate_ff408941:

    # mc "Y después de un año, decidiste que querías irte de allí. ¿El clima?"
    mc "E depois de um ano, você decidiu que queria ir embora. O tempo?"

# game/scripts/c27/c27.rpy:197
translate brazilian c27s001_DebDate_4f5affb8:

    # deb "No, un asistente de entrenador... demasiado cariñoso. Yo me sentía muy incómoda con él."
    deb "Não, um treinador adjunto... muito afetuoso. Senti-me muito desconfortável perto dele."

# game/scripts/c27/c27.rpy:198
translate brazilian c27s001_DebDate_4a05a759:

    # deb "[lis] quería que lo denunciara, pero no tenía ninguna prueba, con lo que irme era lo mejor."
    deb "[lis] queria que eu denunciasse, mas eu não tinha provas, então ir embora foi a melhor coisa a fazer."

# game/scripts/c27/c27.rpy:199
translate brazilian c27s001_DebDate_bc5966e7:

    # mc "Cuando dices cariñoso..."
    mc "Quando você diz afetuoso..."

# game/scripts/c27/c27.rpy:201
translate brazilian c27s001_DebDate_deabdb51:

    # deb "Una mano que se escapa y toca donde no debe a la hora de corregir una postura. Abrazos que duran demasiado para celebrar victorias..."
    deb "Uma mão que vagueia e toca onde não deve ao corrigir a postura. Abraços que duram tempo demais para celebrar vitórias..."

# game/scripts/c27/c27.rpy:202
translate brazilian c27s001_DebDate_2bc39e06:

    # deb "Cosas así. Cosas que, visto desde fuera, pueden parecer que no son nada, pero cuando las vas sumando... te hacen sentir incómoda."
    deb "Coisas assim. Coisas que, vistas de fora, podem parecer insignificantes, mas quando você as soma... elas te deixam desconfortável."

# game/scripts/c27/c27.rpy:203
translate brazilian c27s001_DebDate_d19a604f:

    # mc "Es normal. ¿Cómo empezó? ¿Lo hacía con otras chicas también?"
    mc "É normal. Como começou? Ele fez isso com outras garotas também?"

# game/scripts/c27/c27.rpy:205
translate brazilian c27s001_DebDate_e46d8acf:

    # deb "Cuando llegué, era muy simpático y me hizo sentir integrada en el equipo. Fue el primero que empezó a llamarme 'Deb'."
    deb "Quando cheguei, ele foi muito simpático e me fez sentir como se eu pertencesse à equipe. Ele foi o primeiro a começar a me chamar de 'Deb'."

# game/scripts/c27/c27.rpy:207
translate brazilian c27s001_DebDate_ea46801a:

    # deb "Por eso me molestó cuando me lo llamaste tú. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_ea46801a
    deb "Por isso me incomodou quando você me chamou assim. Só minha avó e [lis] me chamam assim, e se qualquer outra pessoa fizer isso, vou associar ao treinador." id c27s001_DebDate_ea46801a

# game/scripts/c27/c27.rpy:209
translate brazilian c27s001_DebDate_a42fff8c:

    # deb "Por eso no me gusta que me llamen así. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_a42fff8c
    deb "É por isso que não gosto de ser chamado assim. Só minha avó e [lis] me chamam assim, e se qualquer outra pessoa fizer isso, vou associar ao treinador." id c27s001_DebDate_a42fff8c

# game/scripts/c27/c27.rpy:211
translate brazilian c27s001_DebDate_554cc2f4:

    # deb "Poco a poco la cosa se fue poniendo más incómoda, pero como veía que con algunas de las otras chicas hacía lo mismo, pensé que era normal."
    deb "Aos poucos, as coisas foram ficando mais desconfortáveis, mas como eu vi que ele fazia a mesma coisa com algumas das outras garotas, achei que fosse normal."

# game/scripts/c27/c27.rpy:212
translate brazilian c27s001_DebDate_7148f2b7:

    # deb "A ellas no parecía importarles. Era guapo y ellas se lo consentían. Pero a mí me molestaba. Intenté hablarlo con él, pero negó estar haciendo nada incorrecto."
    deb "Eles pareciam não se importar. Ele era bonito e deixaram passar. Mas isso me incomodava. Tentei conversar com ele sobre o assunto, mas ele negou ter feito algo errado."

# game/scripts/c27/c27.rpy:213
translate brazilian c27s001_DebDate_3dbcc7d5:

    # mc "Y decidiste irte. Si puedo hacer algo..."
    mc "E você decidiu ir embora. Se houver algo que eu possa fazer..."

# game/scripts/c27/c27.rpy:215
translate brazilian c27s001_DebDate_7e4b3d06:

    # deb "Gracias, pero no. Yéndome ha quedado resuelto."
    deb "Obrigado, mas não. Sair resolveu o problema."

# game/scripts/c27/c27.rpy:216
translate brazilian c27s001_DebDate_b9d7f0f7:

    # deb "Mis tiempos se resintieron. No iba a gusto a entrenar y se notaba. En dos años hay Juegos Olímpicos en París y me gustaría estar ahí."
    deb "Meus tempos pioraram. Eu não estava gostando dos treinos, e isso ficou evidente. As Olimpíadas serão em Paris daqui a dois anos, e eu gostaria de estar lá."

# game/scripts/c27/c27.rpy:217
translate brazilian c27s001_DebDate_2faf6ea9:

    # deb "Al menos intentarlo. Si seguía en Phoenix no iba a poder hacerlo. Con lo que el cambio es bienvenido."
    deb "Ao menos tente. Se eu tivesse ficado em Phoenix, não teria conseguido. Então, a mudança é bem-vinda."

# game/scripts/c27/c27.rpy:218
translate brazilian c27s001_DebDate_07b6ae05:

    # mc "¿Juegos Olímpicos? Entonces [sim] tenía razón. ¡Eres buenísima!"
    mc "As Olimpíadas? Então [sim] estava certo. Você é incrível!"

# game/scripts/c27/c27.rpy:220
translate brazilian c27s001_DebDate_59776c96:

    # deb "Ahora mismo no me clasificaría, pero si trabajo duro... Tengo una posibilidad. Quedan casi dos años para los Trials y sólo necesitaría unos meses para ponerme en forma."
    deb "No momento, eu não me qualificaria, mas se eu me esforçar... tenho uma chance. Faltam quase dois anos para as seletivas e eu precisaria de apenas alguns meses para entrar em forma."

# game/scripts/c27/c27.rpy:221
translate brazilian c27s001_DebDate_0cf8fd2b:

    # deb "Si Dara Vollmer y Dana Torres pudieron ganar medallas en las olimpiadas después de dar a luz... "
    deb "Se Dara Vollmer e Dana Torres conseguiram ganhar medalhas nas Olimpíadas depois de darem à luz..."

# game/scripts/c27/c27.rpy:222
translate brazilian c27s001_DebDate_36a2a20e:

    # mc "No sé quiénes son. Supongo que nadadoras que han tenido hijos."
    mc "Não sei quem são. Suponho que sejam nadadores que tiveram filhos."

# game/scripts/c27/c27.rpy:224
translate brazilian c27s001_DebDate_921c2fc2:

    # deb "Sí, las dos compitieron después de sus embarazos y las dos ganaron medallas en las olimpiadas. En Pekín y en Rio."
    deb "Sim, ambas competiram após a gravidez e ambas ganharam medalhas olímpicas. Em Pequim e no Rio."

# game/scripts/c27/c27.rpy:225
translate brazilian c27s001_DebDate_6345e182:

    # deb "Pero claro, ellas eran mejores de lo que yo soy ahora antes de quedarse embarazadas..."
    deb "Mas é claro, elas eram melhores do que eu sou agora antes de engravidarem..."

# game/scripts/c27/c27.rpy:226
translate brazilian c27s001_DebDate_a6de434a:

    # mc "Te iba a preguntar si querías tener hijos, pero viendo que has investigado..."
    mc "Eu ia te perguntar se você queria ter filhos, mas já que você pesquisou bastante..."

# game/scripts/c27/c27.rpy:231
translate brazilian c27s001_DebDate_80342353:

    # deb "Todas las que se han hecho la prueba han salido positivas. Eso significa que quieres tener muchos hijos."
    deb "Todos que fizeram o teste deram positivo. Isso significa que você deve ter muitos filhos."

# game/scripts/c27/c27.rpy:232
translate brazilian c27s001_DebDate_b32708d1:

    # deb "No me gustaría ser la única con la que no los tienes."
    deb "Eu não gostaria de ser a única pessoa com quem você não tem isso."

# game/scripts/c27/c27.rpy:234
translate brazilian c27s001_DebDate_87cec64c:

    # deb "Sabiendo que quieres tener hijos, me gustaría que los tuviéramos."
    deb "Sabendo que você quer ter filhos, eu gostaria que nós os tivéssemos."

# game/scripts/c27/c27.rpy:236
translate brazilian c27s001_DebDate_0ccba3b9:

    # deb "No sé si quieres tener hijos o no, pero a mí no me importaría."
    deb "Não sei se você quer ter filhos ou não, mas eu não me importaria."

# game/scripts/c27/c27.rpy:237
translate brazilian c27s001_DebDate_5e145226:

    # deb "Dentro de un año me afectaría más para mi carrera de nadadora. Si los quieres tener, ahora o justo después de unas olimpiadas serían los mejores momentos."
    deb "Daqui a um ano, isso afetaria mais a minha carreira na natação. Se você quer conquistá-los, agora ou logo depois das Olimpíadas seriam os melhores momentos."

# game/scripts/c27/c27.rpy:238
translate brazilian c27s001_DebDate_da88ba8b:

    # mc "No había pensado en cómo te podría afectar en tu carrera. Me gusta que lo hayas hecho tú por los dos."
    mc "Eu não tinha pensado em como isso poderia afetar sua carreira. Fico feliz que você tenha feito isso por nós dois."

# game/scripts/c27/c27.rpy:240
translate brazilian c27s001_DebDate_7b849e5f:

    # deb "Sé que quizás suene muy frío dicho así, pero uno de mis sueños es participar en unas olimpiadas. Y no quiero renunciar a él."
    deb "Sei que pode soar frio da minha parte dizer isso, mas um dos meus sonhos é participar das Olimpíadas. E não quero desistir dele."

# game/scripts/c27/c27.rpy:241
translate brazilian c27s001_DebDate_2c0460ba:

    # mc "No te preocupes. No me ha sonado frío. Son cosas en las que, los que sólo hacemos deporte en los videojuegos, no solemos pensar."
    mc "Não se preocupe. Não me pareceu frio. Essas são coisas que nós, que só praticamos esportes em videogames, geralmente não levamos em consideração."

# game/scripts/c27/c27.rpy:242
translate brazilian c27s001_DebDate_5543d3d8:

    # mc "Y, teniendo todo el tiempo del mundo para tener hijos, no tienes por qué renunciar a tus sueños."
    mc "E, tendo todo o tempo do mundo para ter filhos, você não precisa desistir dos seus sonhos."

# game/scripts/c27/c27.rpy:243
translate brazilian c27s001_DebDate_0d4449b2:

    # mc "Lo que me extraña es tu elección de estudios. ¿Literatura Inglesa en vez de algo relacionado con el deporte?"
    mc "O que me surpreende é a sua escolha de estudos. Literatura Inglesa em vez de algo relacionado a esportes?"

# game/scripts/c27/c27.rpy:245
translate brazilian c27s001_DebDate_670ba289:

    # deb "Mi segunda opción era Ciencias del Deporte, pero no estaba segura de si querría dedicarme a entrenar a otras nadadoras cuando dejase de nadar."
    deb "Minha segunda opção era Ciências do Esporte, mas eu não tinha certeza se gostaria de me dedicar a treinar outros nadadores quando parasse de nadar."

# game/scripts/c27/c27.rpy:246
translate brazilian c27s001_DebDate_94666eeb:

    # deb "Sería una forma de seguir ligada al mundo de la natación, pero aún no estoy segura de querer hacerlo."
    deb "Seria uma forma de me manter ligado ao mundo da natação, mas ainda não tenho certeza se quero fazer isso."

# game/scripts/c27/c27.rpy:247
translate brazilian c27s001_DebDate_5fde71bc:

    # mc "¿Prefieres ser una profesora de literatura en un instituto?"
    mc "Você preferiria ser professor de literatura em uma escola de ensino médio?"

# game/scripts/c27/c27.rpy:249
translate brazilian c27s001_DebDate_7f8f4c84:

    # deb "*Risa* Dudo que alguna vez pueda ser profesora de instituto. Los alumnos me tomarían el pelo. Hay que ser más dura de lo que soy yo para manejar un grupo de 20 adolescentes."
    deb "*Risos* Duvido que eu consiga ser professor do ensino médio. Os alunos iam tirar sarro de mim. Tem que ser muito mais durão do que eu para lidar com um grupo de 20 adolescentes."

# game/scripts/c27/c27.rpy:250
translate brazilian c27s001_DebDate_b197bbe0:

    # deb "Elegí la carrera porque me encanta la literatura, no para ejercer. Ya sabes..."
    deb "Escolhi este curso porque adoro literatura, não para trabalhar na área. Sabe..."

# game/scripts/c27/c27.rpy:251
translate brazilian c27s001_DebDate_6862479b:

    # mc "Sí, dinero viejo y falta de necesidad de trabajar."
    mc "Sim, dinheiro antigo e sem necessidade de trabalhar."

# game/scripts/c27/c27.rpy:253
translate brazilian c27s001_DebDate_2575181e:

    # deb "Mas o menos. No somos dinero MUY viejo, pero lo suficiente. A principios del siglo pasado mi tatarabuelo era un pequeño granjero en Aurora."
    deb "Mais ou menos. Não somos de família rica tradicional, mas temos idade suficiente. No início do século passado, meu tataravô era um pequeno agricultor em Aurora."

# game/scripts/c27/c27.rpy:254
translate brazilian c27s001_DebDate_06f581e8:

    # mc "De granjero a familia rica..."
    mc "De agricultor a família rica..."

# game/scripts/c27/c27.rpy:256
translate brazilian c27s001_DebDate_989e8c07:

    # deb "En la Gran Depresión y durante el Dust Bowl compró un montón de tierras a bajo precio en Illinois y Missouri. También algunas minas de plomo."
    deb "Durante a Grande Depressão e o Dust Bowl, ele comprou muitas terras a preços baixos em Illinois e Missouri. Ele também comprou algumas minas de chumbo."

# game/scripts/c27/c27.rpy:257
translate brazilian c27s001_DebDate_3a0c2978:

    # deb "Él y mi bisabuelo diversificaron la fortuna durante la Segunda Guerra Mundial. Industria, investigación, contratos con el ejército..."
    deb "Ele e meu bisavô diversificaram sua fortuna durante a Segunda Guerra Mundial. Indústria, pesquisa, contratos com os militares..."

# game/scripts/c27/c27.rpy:258
translate brazilian c27s001_DebDate_98584c64:

    # deb "Nunca he sabido la lista completa de empresas en las que tenemos participación. Ni me interesa."
    deb "Nunca soube a lista completa das empresas em que temos participação. Nem tenho interesse em saber."

# game/scripts/c27/c27.rpy:259
translate brazilian c27s001_DebDate_049fbf8d:

    # mc "Supongo que tiene que ser complicado."
    mc "Imagino que deva ser complicado."

# game/scripts/c27/c27.rpy:261
translate brazilian c27s001_DebDate_8d14cd96:

    # deb "Complicado y aburrido. Nunca me ha interesado el dinero. Quizás porque nunca me ha faltado."
    deb "Complicado e entediante. Nunca me interessei por dinheiro. Talvez porque nunca me faltou."

# game/scripts/c27/c27.rpy:262
translate brazilian c27s001_DebDate_e38dd30a:

    # deb "A [lis], aunque tampoco le interese, siempre le ha gustado más todo lo que rodea el dinero. Alta sociedad, famosos, y todo eso."
    deb "A, embora também não se interesse por isso, sempre gostou de tudo que envolve dinheiro. Alta sociedade, celebridades e tudo mais."

# game/scripts/c27/c27.rpy:263
translate brazilian c27s001_DebDate_f43cd1ef:

    # deb "Pero a mí no. El dinero tiene que servir para cubrir las necesidades propias y de la familia."
    deb "Mas não para mim. O dinheiro tem que ser usado para suprir as necessidades pessoais e as da família."

# game/scripts/c27/c27.rpy:264
translate brazilian c27s001_DebDate_a94459db:

    # mc "Es normal. En el fondo es para lo único que sirve. Una vez cubiertas las necesidades, el resto son caprichos."
    mc "É normal. No fundo, é só para isso que serve. Uma vez que suas necessidades são atendidas, todo o resto é apenas um capricho."

# game/scripts/c27/c27.rpy:266
translate brazilian c27s001_DebDate_de64881b:

    # deb "Por suerte, mis caprichos son relativamente baratos. *Risa* Libros, videojuegos, música..."
    deb "Por sorte, meus pequenos luxos são relativamente baratos. *Risos* Livros, videogames, música..."

# game/scripts/c27/c27.rpy:267
translate brazilian c27s001_DebDate_f92bf164:

    # mc "Hemos hablado de libros y videojuegos, pero nunca de música. ¿Qué música te gusta?"
    mc "Já falamos sobre livros e videogames, mas nunca sobre música. Que tipo de música você gosta?"

# game/scripts/c27/c27.rpy:268
translate brazilian c27s001_DebDate_02794b27:

    # deb "Tengo gustos muy variados y que [lis] dice que no pegan demasiado. Pop, Folk, Blues, Metal, Rock, Clásica..."
    deb "Tenho gostos muito variados, e [lis] diz que eles não combinam muito bem. Pop, Folk, Blues, Metal, Rock, Clássica..."

# game/scripts/c27/c27.rpy:269
translate brazilian c27s001_DebDate_b12523bf:

    # mc "*Risa* Es cierto que no pegan demasiado."
    mc "*Risos* É verdade que eles não combinam muito bem."

# game/scripts/c27/c27.rpy:271
translate brazilian c27s001_DebDate_549d5b2a:

    # deb "*Risa* Imagíname con una peluca barroca haciendo así. ¡Yeahhh!"
    deb "*Risos* Imagina eu com uma peruca barroca fazendo isso. É isso aí!"

# game/scripts/c27/c27.rpy:272
translate brazilian c27s001_DebDate_34fc4868:

    # mc "*Risa* Puedo hacerlo. Además, oliendo a pachuli, con un bolso de diseño y con una chaqueta de cuero."
    mc "*Risos* Eu consigo. Além disso, cheirando a patchouli, com uma bolsa de grife e uma jaqueta de couro."

# game/scripts/c27/c27.rpy:274
translate brazilian c27s001_DebDate_b01b50cd:

    # deb "¡Ni siquiera yo iría así! *Risa* ¡[lis] no me dejaría salir de mi habitación! Bueno, de nuestra habitación."
    deb "Nem eu iria assim! *Risos* [lis] Ele não me deixou sair do meu quarto! Bem, do nosso quarto."

# game/scripts/c27/c27.rpy:275
translate brazilian c27s001_DebDate_d4dec132:

    # deb "Pero sea la música que sea, me gusta escucharla, no bailarla."
    deb "Mas seja qual for o tipo de música, eu gosto de ouvi-la, não de dançar ao som dela."

# game/scripts/c27/c27.rpy:276
translate brazilian c27s001_DebDate_9ccbcedc:

    # mc "Bueno, en el Jazz Corner bailamos."
    mc "Bem, nós dançamos no Jazz Corner."

# game/scripts/c27/c27.rpy:278
translate brazilian c27s001_DebDate_c56d3f1b:

    # deb "No bailamos. Me hiciste volar."
    deb "Nós não dançamos. Você me fez sentir como se eu estivesse voando."

# game/scripts/c27/c27.rpy:279
translate brazilian c27s001_DebDate_6f9af9ef:

    # mc "La próxima vez te dejaré poner los pies en el suelo."
    mc "Da próxima vez, deixarei você colocar os pés no chão."

# game/scripts/c27/c27.rpy:280
translate brazilian c27s001_DebDate_4c81d3ec:

    # deb "¿A riesgo de que te pise?"
    deb "Correndo o risco de ser pisoteado?"

# game/scripts/c27/c27.rpy:281
translate brazilian c27s001_DebDate_d65ffcb1:

    # mc "Aceptaré ese riesgo. Aunque dudo que lo hagas. Deberías tener más seguridad en ti misma."
    mc "Eu assumo esse risco. Embora eu duvide que você o faça. Você deveria ter mais confiança em si mesmo."

# game/scripts/c27/c27.rpy:282
translate brazilian c27s001_DebDate_047876a6:

    # mc "No eres [kim] y no vas a tropezarte con tus propios pies. Y ni siquiera ella me pisó."
    mc "Você não é [kim] e não vai tropeçar nos seus próprios pés. E ela nem sequer pisou em mim."

# game/scripts/c27/c27.rpy:284
translate brazilian c27s001_DebDate_0359da27:

    # deb "¡No te metas con [kim]! Yo sería incapaz de andar por una pasarela como lo hace ella."
    deb "Não se meta com a [kim]! Eu não conseguiria desfilar numa passarela como ela."

# game/scripts/c27/c27.rpy:285
translate brazilian c27s001_DebDate_98cbb0ea:

    # mc "No me estoy metiendo con ella. *Risa* Tan solo estoy haciendo una constatación de hechos."
    mc "Não estou zombando dela. *Risos* Estou apenas constatando um fato."

# game/scripts/c27/c27.rpy:287
translate brazilian c27s001_DebDate_be4b8545:

    # deb "*Risita* Se puede tropezar con su sombra, ¿verdad?"
    deb "*Risos* Você pode tropeçar na sua própria sombra, né?"

# game/scripts/c27/c27.rpy:288
translate brazilian c27s001_DebDate_f0a2a5b5:

    # mc "*Risa* Aún no la he visto hacerlo, pero estoy seguro de que sería capaz."
    mc "*Risos* Ainda não a vi fazer isso, mas tenho certeza de que ela seria capaz."

# game/scripts/c27/c27.rpy:289
translate brazilian c27s001_DebDate_d9213a52:

    # mc "Tan solo estoy diciendo que si alguien como ella puede reunir la confianza para subirse a una pasarela, tu deberías reunirla para bailar."
    mc "Só estou dizendo que, se alguém como ela consegue ter a confiança necessária para desfilar numa passarela, você também deveria conseguir ter a confiança necessária para dançar."

# game/scripts/c27/c27.rpy:290
translate brazilian c27s001_DebDate_8a7979ea:

    # mc "Creo que tienes más miedo a lo que pensarán los que te vean que a pisarme."
    mc "Acho que você tem mais medo do que as pessoas vão pensar do que de me pisar."

# game/scripts/c27/c27.rpy:292
translate brazilian c27s001_DebDate_78d7344c:

    # deb "Un poco... No tengo demasiado ritmo..."
    deb "Um pouco... Não tenho muito ritmo..."

# game/scripts/c27/c27.rpy:293
translate brazilian c27s001_DebDate_ddc9e81a:

    # mc "Pues aprovechando que te gustan los libros. Mark Twain dijo algo de lo que puedes aprender."
    mc "Já que você gosta de livros, Mark Twain disse algo que você pode aprender."

# game/scripts/c27/c27.rpy:294
translate brazilian c27s001_DebDate_0e187ff3:

    # mc "Tienes que bailar como si nadie te estuviera mirando, amar como si nunca te fueran a hacer daño, cantar como si nadie te estuviera escuchando y... algo más."
    mc "Você tem que dançar como se ninguém estivesse olhando, amar como se nunca fosse se machucar, cantar como se ninguém estivesse ouvindo e... algo mais."

# game/scripts/c27/c27.rpy:296
translate brazilian c27s001_DebDate_2780dfb9:

    # deb "...y vivir como si estuvieras en el cielo."
    deb "...e viva como se estivesse no paraíso."

# game/scripts/c27/c27.rpy:297
translate brazilian c27s001_DebDate_6b540cb0:

    # deb "Lo segundo ya lo hago. Sé que no me vas a hacer daño. Lo del cielo... no soy creyente."
    deb "Eu já faço a segunda coisa. Sei que você não vai me machucar. Quanto ao céu... não acredito."

# game/scripts/c27/c27.rpy:298
translate brazilian c27s001_DebDate_a833f795:

    # mc "Pues hay que trabajar en el resto. Un día iremos tú y yo solos a bailar. A un sitio donde nadie te conozca."
    mc "Bem, temos que trabalhar no resto. Um dia, você e eu iremos dançar, só nós dois. Em algum lugar onde ninguém te conheça."

# game/scripts/c27/c27.rpy:299
translate brazilian c27s001_DebDate_4f2b6878:

    # mc "Así, aunque te miren, dará lo mismo. ¿Qué te importa lo que piensen personas a las que no conoces?"
    mc "Então, mesmo que fiquem olhando, não vai fazer diferença. Por que se importar com o que pessoas que você não conhece pensam?"

# game/scripts/c27/c27.rpy:300
translate brazilian c27s001_DebDate_ffaf1105:

    # mc "Yo estaré mirándote a los ojos, con lo que no sabré si bailas bien o mal. Ni me importará."
    mc "Estarei olhando nos seus olhos, então não saberei se você dança bem ou mal. E não me importarei."

# game/scripts/c27/c27.rpy:302
translate brazilian c27s001_DebDate_128a2e45:

    # deb "¿Dónde has estado toda mi vida, [mc]?"
    deb "Onde você esteve durante toda a minha vida, [mc]?"

# game/scripts/c27/c27.rpy:303
translate brazilian c27s001_DebDate_08f4e540:

    # mc "Esperando que vinieras a Newport."
    mc "Espero que você venha a Newport."

# game/scripts/c27/c27.rpy:304
translate brazilian c27s001_DebDate_65c76376:

    # mc "Y cuando resolvamos lo de bailar, lo siguiente será un karaoke."
    mc "E depois de resolvermos a questão da dança, a próxima coisa será o karaokê."

# game/scripts/c27/c27.rpy:306
translate brazilian c27s001_DebDate_7e1a98b6:

    # deb "¡No! *Risa* ¡Eso no, por favor!"
    deb "Não! *Risos* Isso não, por favor!"

# game/scripts/c27/c27.rpy:307
translate brazilian c27s001_DebDate_16262c90:

    # deb "Una cosa es que no me veas bailar si estás mirándome a los ojos. Pero no vas a poder evitar escuchar lo mal que canto si vamos a un karaoke."
    deb "Uma coisa é você não conseguir me ver dançando enquanto me olha nos olhos. Mas você não vai conseguir evitar ouvir o quão mal eu canto se formos ao karaokê."

# game/scripts/c27/c27.rpy:308
translate brazilian c27s001_DebDate_b77a7ca3:

    # mc "¿Tan mal cantas?"
    mc "Você canta tão mal assim?"

# game/scripts/c27/c27.rpy:309
translate brazilian c27s001_DebDate_78e4296c:

    # deb "Digamos que, si canto en la ducha, el champú se suicida. *Risa* No quiero torturar a nadie."
    deb "Digamos que, se eu cantar no chuveiro, o shampoo se suicida. *Risos* Não quero torturar ninguém."

# game/scripts/c27/c27.rpy:310
translate brazilian c27s001_DebDate_f0a4f26d:

    # mc "Entonces tendremos que hablar con [meg] para que te dé clases de canto."
    mc "Então teremos que falar com [meg] para que ele possa te dar aulas de canto."

# game/scripts/c27/c27.rpy:312
translate brazilian c27s001_DebDate_c011313a:

    # deb "¿Sabes de lo que me acabo de dar cuenta?"
    deb "Sabe o que eu acabei de perceber?"

# game/scripts/c27/c27.rpy:313
translate brazilian c27s001_DebDate_1a6ca3d7:

    # mc "¿De qué?"
    mc "Sobre o quê?"

# game/scripts/c27/c27.rpy:314
translate brazilian c27s001_DebDate_238eeee4:

    # deb "Esto no se parece a la típica cita de las películas."
    deb "Essa não é uma frase típica de filme."

# game/scripts/c27/c27.rpy:315
translate brazilian c27s001_DebDate_7cf3844e:

    # mc "¿Decepcionada?"
    mc "Decepcionado?"

# game/scripts/c27/c27.rpy:317
translate brazilian c27s001_DebDate_4889e93c:

    # deb "Todo lo contrario. Es mucho mejor. Estamos hablando de un montón de cosas y no estoy nada nerviosa."
    deb "Muito pelo contrário. É muito melhor. Estamos conversando sobre muitas coisas e eu não estou nada nervoso."

# game/scripts/c27/c27.rpy:318
translate brazilian c27s001_DebDate_5e890471:

    # mc "¿Por qué ibas a estar nerviosa? Tan solo estamos comiendo y charlando. Conociéndonos mejor."
    mc "Por que você estaria nervoso? Estamos apenas comendo e conversando. Nos conhecendo melhor."

# game/scripts/c27/c27.rpy:319
translate brazilian c27s001_DebDate_0e6ff9a9:

    # deb "Precisamente por eso. Todo es muy natural. Creía que iba a ser una situación tensa... ya sabes... por lo que vendrá después."
    deb "É exatamente por isso. É tudo muito natural. Achei que ia ser uma situação tensa... sabe... por causa do que vem a seguir."

# game/scripts/c27/c27.rpy:320
translate brazilian c27s001_DebDate_d4207e8d:

    # mc "No he pensado ni por un momento en lo que vendrá después, [deb.nick]. Estoy disfrutando de cada minuto de esta comida contigo."
    mc "Não pensei nem por um momento no que virá a seguir, [deb.nick]. Estou aproveitando cada minuto desta refeição com você."

# game/scripts/c27/c27.rpy:322
translate brazilian c27s001_DebDate_62daf288:

    # deb "Yo lo he pensado un par de veces, pero consigues que se me olvide. Es como estar comiendo... con un amigo..."
    deb "Já pensei nisso algumas vezes, mas você me faz esquecer. É como comer... com um amigo..."

# game/scripts/c27/c27.rpy:323
translate brazilian c27s001_DebDate_e89958f6:

    # mc "*Fingiendo sorpresa* ¿Ya no soy tu novio? *Risa*"
    mc "*Fingindo surpresa* Eu não sou mais seu namorado? *Risos*"

# game/scripts/c27/c27.rpy:324
translate brazilian c27s001_DebDate_acac9f02:

    # mc "Hablando en serio, en eso consiste una cita. Creo que fuimos amigos antes que pareja, y eso no se debe perder."
    mc "Sério, é para isso que serve um encontro. Acho que éramos amigos antes de sermos um casal, e isso é algo que não devemos perder."

# game/scripts/c27/c27.rpy:325
translate brazilian c27s001_DebDate_10fcd32c:

    # mc "No hay que estar hablando de amor y sentimientos todo el día, aunque suene poco romántico."
    mc "Você não precisa ficar falando sobre amor e sentimentos o dia todo, mesmo que isso soe pouco romântico."

# game/scripts/c27/c27.rpy:327
translate brazilian c27s001_DebDate_65999903:

    # deb "Prefiero esto al romanticismo impostado. Para eso están los libros y los videojuegos."
    deb "Prefiro isso ao romantismo forçado. Para isso, existem livros e videogames."

# game/scripts/c27/c27.rpy:328
translate brazilian c27s001_DebDate_1bde9f70:

    # deb "Esto es más natural, más... auténtico. Pero no por ello menos sexy."
    deb "Isso é mais natural, mais... autêntico. Mas nem por isso menos sexy."

# game/scripts/c27/c27.rpy:329
translate brazilian c27s001_DebDate_8abd0f2e:

    # deb "En realidad has estado hablando de amor todo el rato, interesándote por mí, queriendo llevarme a bailar..."
    deb "Na verdade, você esteve falando de amor o tempo todo, demonstrando interesse em mim, querendo me levar para dançar..."

# game/scripts/c27/c27.rpy:330
translate brazilian c27s001_DebDate_8aba94ec:

    # deb "Si llevase bragas, las tendría mojadas después de todo lo que has dicho hoy."
    deb "Se eu estivesse usando calcinha, ela estaria molhada depois de tudo o que você disse hoje."

# game/scripts/c27/c27.rpy:332
translate brazilian c27s001_DebDate_c5a6879d:

    # mc "*Susurrando* ¿No llevas bragas? Antes has dicho que estabas en modo travieso. Ahora me lo creo del todo."
    mc "*Sussurrando* Você não está usando calcinha? Você disse antes que estava no clima para travessuras. Agora eu acredito totalmente em você."

# game/scripts/c27/c27.rpy:334
translate brazilian c27s001_DebDate_ad38a363:

    # deb "Bueno, este vestido transparenta un poco dependiendo de cómo le dé la luz. [kim] y [lis] me han recomendado no llevarlas."
    deb "Bem, este vestido é um pouco transparente dependendo da luz. [kim] e [lis] me aconselharam a não usá-los."

# game/scripts/c27/c27.rpy:335
translate brazilian c27s001_DebDate_391e4a3f:

    # deb "Además, han dicho que así habrá menos estorbos luego."
    deb "Além disso, afirmaram que isso criará menos obstáculos posteriormente."

# game/scripts/c27/c27.rpy:337
translate brazilian c27s001_DebDate_3ccfc812:

    # deb "He estado de acuerdo con ellas. *Risita* Lo de no llevar sujetador ha sido idea mía."
    deb "Concordei com elas. *Risos* A ideia de não usar sutiã foi minha."

# game/scripts/c27/c27.rpy:338
translate brazilian c27s001_DebDate_94f623d6:

    # mc "Es decir... ¿me estás diciendo que estás desnuda debajo de ese ligero vestido?"
    mc "Então... você está me dizendo que está nua por baixo desse vestido claro?"

# game/scripts/c27/c27.rpy:339
translate brazilian c27s001_DebDate_d913fd69:

    # mc "¿Sabes que ahora voy a ser yo el que no va a poder dejar de pensar en lo que pasará después?"
    mc "Você sabe que agora serei eu quem não conseguirá parar de pensar no que acontecerá a seguir?"

# game/scripts/c27/c27.rpy:341
translate brazilian c27s001_DebDate_a5f63b9b:

    # deb "*Risa* Creo que ha sido un error decírtelo. Ahora no vamos a poder dejar de pensar ninguno de los dos en eso."
    deb "*Risos* Acho que foi um erro te contar. Agora nenhum de nós vai conseguir parar de pensar nisso."

# game/scripts/c27/c27.rpy:342
translate brazilian c27s001_DebDate_b4a350df:

    # mc "A menos que reconduzcamos la conversación."
    mc "A menos que mudemos o rumo da conversa."

# game/scripts/c27/c27.rpy:344
translate brazilian c27s001_DebDate_a2956840:

    # "[deb.nick] mira a todos lados para comprobar que nadie os está mirando."
    "[deb.nick] Olhe ao redor para ter certeza de que ninguém está observando você."

# game/scripts/c27/c27.rpy:346
translate brazilian c27s001_DebDate_9702315b:

    # deb "¿Estás seguro de que quieres que reconduzcamos la conversación?"
    deb "Tem certeza de que deseja que mudemos o rumo da conversa?"

# game/scripts/c27/c27.rpy:347
translate brazilian c27s001_DebDate_dc44bf7c:

    # mc "¡Eso es injusto! *Risa* ¡Ahora voy a tener que pedir la cuenta y nos vamos a quedar sin postre!"
    mc "Isso é injusto! *Risos* Agora vou ter que pedir a conta e vamos perder a sobremesa!"

# game/scripts/c27/c27.rpy:349
translate brazilian c27s001_DebDate_c8dcb238:

    # deb "Nunca he sido de esas personas a las que les importa mucho el postre. Al menos hasta que empecé a probar los de [mar]."
    deb "Eu nunca fui uma daquelas pessoas que se importam muito com sobremesas. Pelo menos não até começar a experimentar as do [mar]."

# game/scripts/c27/c27.rpy:350
translate brazilian c27s001_DebDate_38add229:

    # deb "Por muy buena que esté la comida aquí, creo que esa abuela italiana no está al mismo nivel que [mar]."
    deb "Por melhor que seja a comida aqui, não acho que a avó italiana esteja no mesmo nível que [mar]."

# game/scripts/c27/c27.rpy:352
translate brazilian c27s001_DebDate_7a0e4b54:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que mi madre si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Risos* Duvido que haja muitas pessoas no nível da minha mãe quando se trata de sobremesas. Nem mesmo [sam] ou [nor], embora eu adore as sobremesas delas."

# game/scripts/c27/c27.rpy:354
translate brazilian c27s001_DebDate_e269bf6f:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que [mar] si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Risos* Duvido que haja muitas pessoas no mesmo nível que [mar] quando se trata de sobremesas. Nem mesmo [sam] ou [nor], embora eu adore as sobremesas deles."

# game/scripts/c27/c27.rpy:355
translate brazilian c27s001_DebDate_6071fd30:

    # mc "¿Pido la cuenta, entonces?"
    mc "Devo pedir a conta, então?"

# game/scripts/c27/c27.rpy:357
translate brazilian c27s001_DebDate_b61664cf:

    # deb "Creía que ya la habrías pedido a estas alturas..."
    deb "Pensei que você já tivesse feito o pedido..."

# game/scripts/c27/c27.rpy:359
translate brazilian c27s001_DebDate_d7e2a6ff:

    # "Pides la cuenta, que tardan lo que te parece una eternidad en traer."
    "Você pede a conta, que demora o que parece uma eternidade para chegar."

# game/scripts/c27/c27.rpy:360
translate brazilian c27s001_DebDate_8c5b91a0:

    # "Por suerte, el camarero viene con el datáfono, ahorrándoos unos interminables segundos de espera por un segundo viaje."
    "Por sorte, o garçom traz a maquininha de cartão, poupando-lhe preciosos segundos de espera para uma segunda viagem."

# game/scripts/c27/c27.rpy:361
translate brazilian c27s001_DebDate_97bb0187:

    # "Dejas una generosa propina y os marcháis."
    "Você deixa uma gorjeta generosa e vai embora."

# game/scripts/c27/c27.rpy:364
translate brazilian c27s001_DebDate_f7db6f75:

    # "El viaje a casa se hace raro. ¿Ha estado siempre tan lejos tu casa del centro de la ciudad?"
    "A viagem de volta para casa parece estranha. Sua casa sempre foi tão longe do centro da cidade?"

# game/scripts/c27/c27.rpy:373
translate brazilian c27s001_NoDeb_0db2828d:

    # "Después de que se vayan los montadores, juegas un rato a My Residence."
    "Depois que os instaladores forem embora, você joga My Residence por um tempo."

# game/scripts/c27/c27.rpy:374
translate brazilian c27s001_NoDeb_d95a7f64:

    # "Tienes una cita más traviesa de lo esperado con Missy, la hermana deportista de Karen."
    "Você tem um encontro mais ousado do que o esperado com Missy, a irmã esportiva de Karen."

# game/scripts/c27/c27.rpy:375
translate brazilian c27s001_NoDeb_0966a996:

    # "Desde que [deb.nick] te dijo lo de los parecidos, parece que estés alucinando."
    "Desde que [deb.nick] lhe falou sobre as semelhanças, parece que você está alucinando."

# game/scripts/c27/c27.rpy:376
translate brazilian c27s001_NoDeb_3d9a940c:

    # "Missy se parecería a la propia [deb.nick] si no fuera por el tamaño de sus tetas y porque es esgrimista en vez de nadadora."
    "Missy seria exatamente igual a ela mesma se não fosse pelo tamanho dos seus seios e pelo fato de ela ser esgrimista em vez de nadadora."

# game/scripts/c27/c27.rpy:377
translate brazilian c27s001_NoDeb_80086d2b:

