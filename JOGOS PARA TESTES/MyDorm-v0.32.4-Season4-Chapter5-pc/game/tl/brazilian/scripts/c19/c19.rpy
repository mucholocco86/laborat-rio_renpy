# game/scripts/c19/c19.rpy:2702
translate brazilian c19s005_Meemaw_f90087f5:

    # mee "Confesar que te he dado la razón... NUNCA. *Risa*"
    mee "Admita que eu já concordei com você... NUNCA. *Risos*"

# game/scripts/c19/c19.rpy:2703
translate brazilian c19s005_Meemaw_0ab74392:

    # mee "Te veo luego, cariño. Si no me voy ya, voy a tener que besarte, y no como un saludo."
    mee "Te vejo mais tarde, querida. Se eu não for embora agora, vou ter que te dar um beijo, e não só de cumprimento."

# game/scripts/c19/c19.rpy:2704
translate brazilian c19s005_Meemaw_bc229371:

    # mc "Hasta luego, Meemaw."
    mc "Adeus, vovó."

# game/scripts/c19/c19.rpy:2706
translate brazilian c19s005_Meemaw_bc8fe434:

    # mcp "(Ha ido mejor de lo que esperaba cuando ha salido la conversación. Por un momento he pensado que se iba a negar en redondo.)"
    mcp "(A conversa correu melhor do que eu esperava. Por um momento, pensei que ela fosse recusar categoricamente.)"

# game/scripts/c19/c19.rpy:2752
translate brazilian c19s005_Kiara_07c96ce4:

    # "Ves que Kiara se ha quedado sola. Es tu momento de hablar con ella otra vez sobre sus razones para evitarte."
    "Você percebe que Kiara está sozinha. É a sua chance de conversar com ela novamente sobre os motivos que a levaram a te evitar."

# game/scripts/c19/c19.rpy:2754
translate brazilian c19s005_Kiara_8d5528f4:

    # "Te lanzas a la piscina y buceas hasta donde está Kiara. Si no te ve llegar no podrá huir."
    "Você pula na piscina e mergulha até onde Kiara está. Se ela não te vir chegando, não conseguirá escapar."

# game/scripts/c19/c19.rpy:2757
translate brazilian c19s005_Kiara_caa910bc:

    # kia "¡[mc]!"
    kia "[mc]!"

# game/scripts/c19/c19.rpy:2758
translate brazilian c19s005_Kiara_2c2d1726:

    # "Tu objetivo era que no tuviera la oportunidad de huir, pero consigues sobresaltarla sin pretenderlo."
    "Seu objetivo era impedi-la de escapar, mas você a assustou sem querer."

# game/scripts/c19/c19.rpy:2761
translate brazilian c19s005_Kiara_41854e1e:

    # kia "Me has asustado. Estaba... ausente."
    kia "Você me assustou. Eu estava... distraído."

# game/scripts/c19/c19.rpy:2762
translate brazilian c19s005_Kiara_273db28f:

    # mc "Lo siento, Kiara. No era mi intención."
    mc "Me desculpe, Kiara. Eu não queria fazer isso."

# game/scripts/c19/c19.rpy:2763
translate brazilian c19s005_Kiara_b6d81fd7:

    # mc "¿Qué tal lo estás pasando?"
    mc "Como vai?"

# game/scripts/c19/c19.rpy:2765
translate brazilian c19s005_Kiara_391e6771:

    # kia "Ya te lo he dicho antes. Eileen me había hablado de vuestras fiestas, pero esto es más grande de lo que me imaginaba."
    kia "Eu já te disse antes. A Eileen tinha me falado das suas festas, mas isso é maior do que eu imaginava."

# game/scripts/c19/c19.rpy:2766
translate brazilian c19s005_Kiara_3b9fe803:

    # "Su tono intenta ser cortante pero educado. Tan solo consigue sonar triste."
    "Seu tom pretende ser seco, mas educado. Ele simplesmente consegue soar triste."

# game/scripts/c19/c19.rpy:2767
translate brazilian c19s005_Kiara_36b7c2b2:

    # mc "Bueno, este año somos más gente de lo que hemos sido nunca. Para nosotros también es más grande."
    mc "Bem, este ano somos mais pessoas do que nunca. É maior para nós também."

# game/scripts/c19/c19.rpy:2768
translate brazilian c19s005_Kiara_35ebcd10:

    # mc "Vosotras, las chicas nuevas, hacéis que este año sea diferente. Mejor. Mucho mejor."
    mc "Vocês, as meninas novas, estão fazendo deste ano um ano diferente. Melhor. Muito melhor."

# game/scripts/c19/c19.rpy:2770
translate brazilian c19s005_Kiara_03ccecb8:

    # kia "*Risa triste* Creo que hace 20 años que nadie me llamaba \"chica\"."
    kia "*Risada triste* Acho que já faz 20 anos que ninguém me chama de \"garota\"."

# game/scripts/c19/c19.rpy:2771
translate brazilian c19s005_Kiara_b344e1ce:

    # mc "*Risa* Es difícil hablar de un grupo tan grande sin generalizar. Para Meemaw todas sois \"las chicas\". A veces incluso Tía Betty."
    mc "*Risos* É difícil falar de um grupo tão grande sem generalizar. Para a vovó, vocês são todas \"as meninas\". Às vezes até a tia Betty."

# game/scripts/c19/c19.rpy:2772
translate brazilian c19s005_Kiara_b5b742fd:

    # mc "Para mí también."
    mc "Eu também."

# game/scripts/c19/c19.rpy:2774
translate brazilian c19s005_Kiara_90048c1a:

    # kia "Te debes sentir como el gallo en un gallinero."
    kia "Você deve se sentir como o galo no galinheiro."

# game/scripts/c19/c19.rpy:2776
translate brazilian c19s005_Kiara_102a91ba:

    # kia "Con varias gallinas para ti..."
    kia "Com várias galinhas para você..."

# game/scripts/c19/c19.rpy:2777
translate brazilian c19s005_Kiara_ba2375ad:

    # mc "Para nada, Kiara. Me siento afortunado de estar aquí, de teneros a todas cerca."
    mc "De jeito nenhum, Kiara. Me sinto com sorte por estar aqui, por ter todos vocês por perto."

# game/scripts/c19/c19.rpy:2779
translate brazilian c19s005_Kiara_3c494dd6:

    # kia "Creo que te voy a dejar, si no te importa. Están jugando a algo en el jacuzzi y quiero ir a ver a qué."
    kia "Acho que vou indo, se não se importar. Estão tocando alguma coisa na jacuzzi e eu quero ir ver o que é."

# game/scripts/c19/c19.rpy:2780
translate brazilian c19s005_Kiara_156630f4:

    # mc "Y sigues evitándome."
    mc "E você continua me evitando."

# game/scripts/c19/c19.rpy:2782
translate brazilian c19s005_Kiara_a1f689e4:

    # kia "¿Qué? No..."
    kia "Não..."

# game/scripts/c19/c19.rpy:2783
translate brazilian c19s005_Kiara_8f23f75d:

    # mc "Kiara, engáñate a ti misma si quieres, pero no niegues lo evidente."
    mc "Kiara, iluda-se se quiser, mas não negue o óbvio."

# game/scripts/c19/c19.rpy:2784
translate brazilian c19s005_Kiara_c1ed017b:

    # mc "Desde que estuvimos en tu casa, cada vez que he intentado hablar contigo a solas hemos intercambiado cinco o seis frases y has salido corriendo."
    mc "Desde que estivemos na sua casa, todas as vezes que tentei falar com você a sós, trocamos cinco ou seis frases e você fugiu."

# game/scripts/c19/c19.rpy:2786
translate brazilian c19s005_Kiara_f44decf9:

    # kia "Nunca he salido corriendo..."
    kia "Eu nunca fugi..."

# game/scripts/c19/c19.rpy:2787
translate brazilian c19s005_Kiara_207548e5:

    # mc "Lo hiciste en la cena de anteayer y lo estás volviendo a hacer ahora."
    mc "Você fez isso no jantar anteontem e está fazendo de novo agora."

# game/scripts/c19/c19.rpy:2789
translate brazilian c19s005_Kiara_25f2ae9f:

    # kia "Es que... lo pones muy difícil..."
    kia "Você está tornando as coisas muito difíceis..."

# game/scripts/c19/c19.rpy:2790
translate brazilian c19s005_Kiara_683715e2:

    # mc "No entiendo qué es lo que pongo difícil, Kiara."
    mc "Não entendo por que estou dificultando as coisas, Kiara."

# game/scripts/c19/c19.rpy:2793
translate brazilian c19s005_Kiara_c0bbf255:

    # kia "Sales con mi hija..."
    kia "Você está namorando minha filha..."

# game/scripts/c19/c19.rpy:2795
translate brazilian c19s005_Kiara_14fe3b34:

    # kia "Y no sólo con ella..."
    kia "E não apenas com ela..."

# game/scripts/c19/c19.rpy:2797
translate brazilian c19s005_Kiara_2e22e1e2:

    # kia "Alguna cercana a mi edad..."
    kia "Alguém próximo da minha idade..."

# game/scripts/c19/c19.rpy:2799
translate brazilian c19s005_Kiara_cd4bd1cb:

    # kia "Sales con más de una mujer..."
    kia "Você está saindo com mais de uma mulher..."

# game/scripts/c19/c19.rpy:2801
translate brazilian c19s005_Kiara_2e22e1e2_1:

    # kia "Alguna cercana a mi edad..."
    kia "Alguém próximo da minha idade..."

# game/scripts/c19/c19.rpy:2803
translate brazilian c19s005_Kiara_67539b1b:

    # kia "Sales con una mujer cercana a mi edad..."
    kia "Você está namorando uma mulher próxima da minha idade..."

# game/scripts/c19/c19.rpy:2805
translate brazilian c19s005_Kiara_4dfd91f7:

    # kia "Estás saliendo con alguien..."
    kia "Você está namorando alguém..."

# game/scripts/c19/c19.rpy:2807
translate brazilian c19s005_Kiara_9d8cf43c:

    # kia "Eres como el soltero de oro..."
    kia "Você é o solteiro mais cobiçado..."

# game/scripts/c19/c19.rpy:2808
translate brazilian c19s005_Kiara_78c902a2:

    # mc "No entiendo qué tiene que ver eso con que me rehúyas."
    mc "Não entendo o que isso tem a ver com você me evitar."

# game/scripts/c19/c19.rpy:2809
translate brazilian c19s005_Kiara_05c13bee:

    # mc "Me parece que, de alguna forma, te sientes atraída por mí. Pero, por alguna razón que no entiendo, no quieres hablarlo..."
    mc "Acho que você sente atração por mim de alguma forma. Mas, por algum motivo que não entendo, você não quer falar sobre isso..."

# game/scripts/c19/c19.rpy:2811
translate brazilian c19s005_Kiara_d682e018:

    # kia "[mc], mi familia es como un castillo en ruinas."
    kia "[mc], minha família é como um castelo em ruínas."

# game/scripts/c19/c19.rpy:2812
translate brazilian c19s005_Kiara_600ddba0:

    # mcp "(No ha negado que se sienta atraída por mí. Tía Betty tenía razón.)"
    mcp "(Ela não negou que se sente atraída por mim. Tia Betty tinha razão.)"

# game/scripts/c19/c19.rpy:2813
translate brazilian c19s005_Kiara_2b213eb0:

    # kia "Mi marido se ha pasado años socavando los cimientos. Mi hija tan solo quiere demolerlo."
    kia "Meu marido passou anos minando os alicerces. Minha filha só quer demolir tudo."

# game/scripts/c19/c19.rpy:2814
translate brazilian c19s005_Kiara_c7a0a5b1:

    # kia "Soy la única que aún... hasta el otro día, cuando te enfrentaste a Solomon... estaba empeñada en hacer obras para evitar que se derrumbara del todo."
    kia "Eu era o único que ainda estava determinado a trabalhar para impedir que tudo desmoronasse completamente, até o outro dia, quando você confrontou Salomão."

# game/scripts/c19/c19.rpy:2815
translate brazilian c19s005_Kiara_52492523:

    # mc "¿Ya no?"
    mc "Não mais?"

# game/scripts/c19/c19.rpy:2817
translate brazilian c19s005_Kiara_ce1f7849:

    # kia "Reparar ese castillo... que ha dejado de servir para protegernos..."
    kia "Reparem esse castelo... que já não nos serve para nos proteger..."

# game/scripts/c19/c19.rpy:2818
translate brazilian c19s005_Kiara_094c58d5:

    # kia "Un castillo que se ha convertido tan solo en una prisión..."
    kia "Um castelo que se tornou nada mais que uma prisão..."

# game/scripts/c19/c19.rpy:2820
translate brazilian c19s005_Kiara_c761da29:

    # kia "No, ya no."
    kia "Não, não mais."

# game/scripts/c19/c19.rpy:2821
translate brazilian c19s005_Kiara_d22c428d:

    # kia "Que Solomon quisiera pegarte, cuando lo único que hacías era ayudarme, fue la gota que colmó el vaso."
    kia "O fato de Salomão querer te bater, quando você só estava me ajudando, foi a gota d'água."

# game/scripts/c19/c19.rpy:2822
translate brazilian c19s005_Kiara_1646283b:

    # mc "Y me culpas por ello. Lo entiendo."
    mc "E você me culpa por isso. Eu entendo."

# game/scripts/c19/c19.rpy:2824
translate brazilian c19s005_Kiara_32deec70:

    # kia "No, no te culpo por ello."
    kia "Não, eu não te culpo por isso."

# game/scripts/c19/c19.rpy:2825
translate brazilian c19s005_Kiara_f92c920a:

    # kia "Tú tan solo me has enseñado que un castillo no tiene por qué ser opresivo. Que puede guardar cosas hermosas en su interior."
    kia "Você simplesmente me ensinou que um castelo não precisa ser opressivo. Que ele pode abrigar coisas belas em seu interior."

# game/scripts/c19/c19.rpy:2826
translate brazilian c19s005_Kiara_c1f7737f:

    # mc "¿Por eso me evitas? Ahora es cuando no entiendo nada."
    mc "É por isso que você está me evitando? Agora não entendo nada."

# game/scripts/c19/c19.rpy:2828
translate brazilian c19s005_Kiara_45638f5c:

    # kia "Aquí tenéis un castillo precioso. Pero también es un palacio. Nadie es prisionero en su propia casa."
    kia "Aqui você tem um belo castelo. Mas também é um palácio. Ninguém é prisioneiro em sua própria casa."

# game/scripts/c19/c19.rpy:2829
translate brazilian c19s005_Kiara_ddca5414:

    # mc "Sigo sin entender qué tiene que ver eso con que me evites."
    mc "Ainda não entendo o que isso tem a ver com você me evitar."

# game/scripts/c19/c19.rpy:2831
translate brazilian c19s005_Kiara_47d2b49b:

    # kia "No sé si es agradecimiento o algo más, pero cada vez que hablo contigo pienso que la vida puede ser diferente de lo que he vivido con Solomon."
    kia "Não sei se é gratidão ou algo mais, mas toda vez que converso com você, penso que a vida pode ser diferente da que vivi com Salomão."

# game/scripts/c19/c19.rpy:2834
translate brazilian c19s005_Kiara_ecdc1086:

    # kia "Pero ya estás con mi hija... "
    kia "Mas você já está com a minha filha..."

# game/scripts/c19/c19.rpy:2836
translate brazilian c19s005_Kiara_d4651e69:

    # kia "Pero ya estás con alguien. Una mujer a la que aprecio... Además saliste con mi hija y al volver de la universidad no habéis vuelto juntos."
    kia "Mas você já está com outra pessoa. Uma mulher de quem eu gosto... Além disso, você namorou a minha filha e não voltou quando ela voltou da universidade."

# game/scripts/c19/c19.rpy:2839
translate brazilian c19s005_Kiara_ff4d60c8:

    # kia "Pero estás con más de una mujer. Una de ellas mi hija..."
    kia "Mas você está com mais de uma mulher. Uma delas é minha filha..."

# game/scripts/c19/c19.rpy:2841
translate brazilian c19s005_Kiara_9d5c9c27:

    # kia "Pero estás con más de una mujer. Y pese a todo no has vuelto con mi hija después de volver de la universidad."
    kia "Mas você está saindo com mais de uma mulher. E apesar disso tudo, você não voltou para a minha filha desde que retornou da universidade."

# game/scripts/c19/c19.rpy:2843
translate brazilian c19s005_Kiara_022dd757:

    # kia "Pero saliste con mi hija. Y cuando has vuelto de la universidad no has querido volver con ella."
    kia "Mas você namorou minha filha. E quando voltou da universidade, não quis reatar com ela."

# game/scripts/c19/c19.rpy:2844
translate brazilian c19s005_Kiara_2c060141:

    # kia "No puedo ni siquiera pensar en cómo se sentiría si tú y yo... No. No puedo hacerle eso. Ni siquiera planteármelo."
    kia "Nem consigo imaginar como ela se sentiria se você e eu... Não. Não posso fazer isso com ela. Nem consigo pensar nisso."

# game/scripts/c19/c19.rpy:2845
translate brazilian c19s005_Kiara_85297243:

    # mc "Si tú y yo... ¿Qué, Kiara?"
    mc "Se você e eu... O quê, Kiara?"

# game/scripts/c19/c19.rpy:2846
translate brazilian c19s005_Kiara_52fc8bfa:

    # mcp "(Dilo, Kiara. Aclara las cosas y borra esta barrera que nos está separando.)"
    mcp "(Diga isso, Kiara. Esclareça as coisas e derrube essa barreira que nos separa.)"

# game/scripts/c19/c19.rpy:2848
translate brazilian c19s005_Kiara_6f6095b4:

    # kia "Nada... no es posible, con lo que no vale la pena ni siquiera hablarlo."
    kia "Nada... não é possível, então nem vale a pena falar sobre isso."

# game/scripts/c19/c19.rpy:2849
translate brazilian c19s005_Kiara_9ed7ad67:

    # kia "Mañana es el cumpleaños... el de verdad... de [eri] y [dap]. No quiero fastidiárselo. Pero mañana mismo empezaré a buscar algún sitio a donde mudarme."
    kia "Amanhã é o aniversário de [eri] e [dap]... o aniversário deles de verdade. Não quero estragar a surpresa. Mas começarei a procurar um lugar para me mudar amanhã."

# game/scripts/c19/c19.rpy:2850
translate brazilian c19s005_Kiara_6d4a8883:

    # mc "¿Por qué? ¿Qué es tan importante como para querer irte de un sitio en el que estás a gusto y donde todo el mundo te quiere?"
    mc "Por quê? O que poderia ser tão importante a ponto de você querer deixar um lugar onde se sente confortável e onde todos te amam?"

# game/scripts/c19/c19.rpy:2852
translate brazilian c19s005_Kiara_ca2e8356:

    # kia "No sé si es que no lo estás entendiendo, si tienes un ego tan enorme que me lo quieres oír decir, o si quieres que lo diga para evitar malentendidos."
    kia "Não sei se você não está entendendo, se tem um ego tão grande que quer me ouvir dizer isso, ou se quer que eu diga para evitar mal-entendidos."

# game/scripts/c19/c19.rpy:2853
translate brazilian c19s005_Kiara_830d976e:

    # mc "Puede haber más razones para querer oírtelo decir."
    mc "Pode haver mais razões para querer ouvir você dizer isso."

# game/scripts/c19/c19.rpy:2854
translate brazilian c19s005_Kiara_9a8dbc47:

    # mc "Quizás para poder rebatir tu idea de marcharte."
    mc "Talvez assim possamos refutar sua ideia de ir embora."

# game/scripts/c19/c19.rpy:2856
translate brazilian c19s005_Kiara_cc5662f9:

    # kia "No vas a lograr convencerme..."
    kia "Você não vai me convencer..."

# game/scripts/c19/c19.rpy:2857
translate brazilian c19s005_Kiara_2ce614d9:

    # mc "Dime tus razones para irte y yo te expondré mis argumentos para que te quedes."
    mc "Diga-me os motivos da sua saída e eu explicarei os meus argumentos para que você fique."

# game/scripts/c19/c19.rpy:2858
translate brazilian c19s005_Kiara_093b0f53:

    # mc "Si no te puedo hacer cambiar de opinión, no volveré a insistir."
    mc "Se eu não conseguir te fazer mudar de ideia, não vou insistir novamente."

# game/scripts/c19/c19.rpy:2860
translate brazilian c19s005_Kiara_f8804faf:

    # kia "¡Vale! Vas a conseguir que me avergüence a mí misma como una colegiala, pero si es lo que quieres..."
    kia "Tudo bem! Você vai me fazer passar vergonha como uma colegial, mas se é isso que você quer..."

# game/scripts/c19/c19.rpy:2862
translate brazilian c19s005_Kiara_c9ea3afc:

    # kia "¿Sabes lo que sentí el otro día? ¿Cuándo me defendiste delante de Solomon?"
    kia "Você sabe como me senti outro dia? Quando você me defendeu diante de Salomão?"

# game/scripts/c19/c19.rpy:2863
translate brazilian c19s005_Kiara_f52b80de:

    # mc "Me lo puedo imaginar. Te sentiste protegida."
    mc "Imagino. Você se sentiu protegido(a)."

# game/scripts/c19/c19.rpy:2865
translate brazilian c19s005_Kiara_42360f8c:

    # kia "Como no me había sentido nunca..."
    kia "Eu nunca tinha me sentido assim antes..."

# game/scripts/c19/c19.rpy:2867
translate brazilian c19s005_Kiara_06ad52c3:

    # kia "Esto no lo sabe nadie, pero hace unos años, fuimos a San Francisco para nuestro aniversario a pasar un fin de semana."
    kia "Ninguém sabe disso, mas há alguns anos, fomos a São Francisco para passar um fim de semana no nosso aniversário."

# game/scripts/c19/c19.rpy:2868
translate brazilian c19s005_Kiara_ddc24f51:

    # kia "Nos perdimos y acabamos en un sitio sospechoso. Un tipo nos intentó atracar."
    kia "Nos perdemos e acabamos num lugar suspeito. Um cara tentou nos assaltar."

# game/scripts/c19/c19.rpy:2869
translate brazilian c19s005_Kiara_656b5e8a:

    # kia "¿Sabes lo que hizo Solomon?"
    kia "Você sabe o que Salomão fez?"

# game/scripts/c19/c19.rpy:2870
translate brazilian c19s005_Kiara_6107583b:

    # mc "Supongo que nada. Darle el dinero. Y entonces llegó la policía."
    mc "Acho que não tem problema. Só dê o dinheiro para ele. E aí a polícia chegou."

# game/scripts/c19/c19.rpy:2872
translate brazilian c19s005_Kiara_18924225:

    # kia "¿Qué? ¿Cómo sabes lo de la policía? Nunca se lo contamos a Eileen..."
    kia "O quê? Como você sabe sobre a polícia? Nós nunca contamos para a Eileen..."

# game/scripts/c19/c19.rpy:2873
translate brazilian c19s005_Kiara_433b7cee:

    # mc "Has dicho que el tipo intentó atracaros, no que os atracara. He supuesto que, después de que Solomon le diera el dinero, llegó la policía."
    mc "Você disse que o cara tentou te assaltar, não que ele te assaltou. Presumi que a polícia chegou depois que Solomon entregou o dinheiro a ele."

# game/scripts/c19/c19.rpy:2875
translate brazilian c19s005_Kiara_c11a7aaf:

    # kia "Casi has acertado. No le dio el dinero. Me dijo \"corre\" y empezó a correr él también."
    kia "Você quase acertou. Ele não deu o dinheiro para ele. Ele me disse para \"correr\" e saiu correndo também."

# game/scripts/c19/c19.rpy:2876
translate brazilian c19s005_Kiara_ca58b031:

    # kia "Sin mirar atrás. Sin comprobar si le seguía."
    kia "Sem olhar para trás. Sem verificar se ele estava seguindo."

# game/scripts/c19/c19.rpy:2878
translate brazilian c19s005_Kiara_454935c8:

    # mc "¡Qué hijo de puta!"
    mc "Que filho da puta!"

# game/scripts/c19/c19.rpy:2879
translate brazilian c19s005_Kiara_3fae328f:

    # kia "Corrimos durante dos manzanas. Solomon cada vez más lejos. El atracador cada vez más cerca. Yo gritando, pidiendo ayuda."
    kia "Corremos por dois quarteirões. Solomon se distanciava cada vez mais. O assaltante se aproximava cada vez mais. Eu gritava, implorando por ajuda."

# game/scripts/c19/c19.rpy:2881
translate brazilian c19s005_Kiara_3f6420e1:

    # kia "Y me topé de bruces con dos policías. Solomon había pasado corriendo por su lado sin pararse."
    kia "E me deparei com dois policiais. Solomon passou correndo por eles sem parar."

# game/scripts/c19/c19.rpy:2883
translate brazilian c19s005_Kiara_3db11475:

    # mc "Y el atracador desapareció. Y el hijo de puta de tu marido también."
    mc "E o ladrão sumiu. E aquele seu marido filho da puta também sumiu."

# game/scripts/c19/c19.rpy:2885
translate brazilian c19s005_Kiara_e4c3f2f1:

    # kia "Exacto. Llegó corriendo al hotel. Estaba a cinco o seis manzanas de donde encontré a los policías."
    kia "Exatamente. Ele veio correndo para o hotel. Ficava a cinco ou seis quarteirões de onde encontrei os policiais."

# game/scripts/c19/c19.rpy:2886
translate brazilian c19s005_Kiara_348a690d:

    # kia "Sólo entonces se le ocurrió mirar atrás y descubrió que no estaba. Me llamó al móvil... para ver si estaba bien."
    kia "Só então ele se lembrou de olhar para trás e percebeu que eu não estava lá. Ele me ligou no celular... para saber se eu estava bem."

# game/scripts/c19/c19.rpy:2887
translate brazilian c19s005_Kiara_ce1483e1:

    # mc "No sé cómo no le pediste el divorcio en ese mismo momento."
    mc "Não sei por que você não pediu o divórcio naquele momento."

# game/scripts/c19/c19.rpy:2889
translate brazilian c19s005_Kiara_757196fc:

    # kia "Eileen tenía siete años, [mc]. Yo no tenía trabajo y Solomon aún no bebía como hizo tiempo después."
    kia "Eileen tinha sete anos, [mc]. Eu não tinha emprego e Solomon ainda não bebia como fez mais tarde."

# game/scripts/c19/c19.rpy:2890
translate brazilian c19s005_Kiara_3ac895a6:

    # kia "Le hubieran concedido la custodia a él. Hubiera perdido a mi hija. Ya me había amenazado con eso..."
    kia "Eles teriam lhe concedido a guarda. Eu teria perdido minha filha. Ele já havia me ameaçado com isso..."

# game/scripts/c19/c19.rpy:2891
translate brazilian c19s005_Kiara_111b30e7:

    # mc "¿Qué? ¿Cuándo?"
    mc "O quê? Quando?"

# game/scripts/c19/c19.rpy:2893
translate brazilian c19s005_Kiara_f1630e7f:

    # kia "Unos meses después de que naciera Eileen. Cuando empecé a ver a mis amigas de nuevo. Me dijo que ya era una mujer con una hija."
    kia "Alguns meses depois do nascimento de Eileen, quando voltei a ver meus amigos, ela me disse que eu agora era uma mulher com uma filha."

# game/scripts/c19/c19.rpy:2895
translate brazilian c19s005_Kiara_924f253f:

    # kia "Que mi lugar estaba en casa con mi hija, no paseando a la niña y quedando con mis amigas. Si le tenía que dar el sol, teníamos un jardín."
    kia "Meu lugar era em casa com minha filha, não saindo para passear com ela e encontrar meus amigos. Se ela precisasse de um pouco de sol, tínhamos um jardim."

# game/scripts/c19/c19.rpy:2896
translate brazilian c19s005_Kiara_b6b9daed:

    # kia "Que si no quería comportarme como una mujer casada, pediría el divorcio y se quedaría con la niña porque yo no la podía mantener."
    kia "Ele disse que se eu não me comportasse como uma mulher casada, ele pediria o divórcio e ficaria com a menina, porque eu não teria condições de sustentá-la."

# game/scripts/c19/c19.rpy:2898
translate brazilian c19s005_Kiara_3f529544:

    # mc "Me estoy arrepintiendo de no haberle pegado el jueves."
    mc "Estou arrependido de não ter batido nele na quinta-feira."

# game/scripts/c19/c19.rpy:2900
translate brazilian c19s005_Kiara_7a917878:

    # kia "No tienes que rebajarte a su altura..."
    kia "Você não precisa se rebaixar ao nível deles..."

# game/scripts/c19/c19.rpy:2901
translate brazilian c19s005_Kiara_a4c31c35:

    # kia "Pero volviendo a San Francisco... Volví al hotel con los policías. No había denuncia que presentar. Por mi vida no podría recordar el aspecto del atracador."
    kia "Mas voltando a São Francisco... Voltei ao hotel com a polícia. Não havia boletim de ocorrência para registrar. Eu não conseguia me lembrar da aparência do ladrão, se é que cheguei a vê-lo."

# game/scripts/c19/c19.rpy:2902
translate brazilian c19s005_Kiara_3af2f1b2:

    # kia "Y cuando llegué, ¿sabes qué pasó?"
    kia "E quando eu cheguei, sabe o que aconteceu?"

# game/scripts/c19/c19.rpy:2903
translate brazilian c19s005_Kiara_92519760:

    # mc "Me puedo llegar a imaginar cualquier cosa. Espero que no te pegara encima de haberte dejado sola."
    mc "Posso imaginar qualquer coisa. Espero que ele não tenha te batido além de te deixar sozinha."

# game/scripts/c19/c19.rpy:2905
translate brazilian c19s005_Kiara_1f44fd04:

    # kia "No, por entonces aún no se emborrachaba y no era violento. Pero estaba enfadado."
    kia "Não, naquela época ele não se embriagava nem era violento. Mas ele estava com raiva."

# game/scripts/c19/c19.rpy:2906
translate brazilian c19s005_Kiara_e81d91e4:

    # kia "Se había puesto nervioso al ver que yo no llegaba al hotel. Estaba enfadado porque yo lo había dejado solo. Porque no había corrido lo suficiente."
    kia "Ele ficou nervoso quando viu que eu não tinha chegado ao hotel. Estava zangado porque eu o tinha deixado sozinho. Porque eu não tinha corrido rápido o suficiente."

# game/scripts/c19/c19.rpy:2908
translate brazilian c19s005_Kiara_b1884c43:

    # kia "Empezó a gritarme... y se fue sin decirme a dónde."
    kia "Ele começou a gritar comigo... e saiu sem me dizer para onde ia."

# game/scripts/c19/c19.rpy:2909
translate brazilian c19s005_Kiara_3b3b52d4:

    # kia "En nuestro aniversario cenó él solo en el restaurante que había reservado para nosotros y después fue de bar en bar hasta que volvió al hotel."
    kia "No nosso aniversário, ele jantou sozinho no restaurante que havia reservado para nós e depois foi de bar em bar até voltar para o hotel."

# game/scripts/c19/c19.rpy:2911
translate brazilian c19s005_Kiara_ba1d6dc1:

    # kia "Mientras tanto, yo estaba en la habitación sin saber si volvería o cuándo lo haría."
    kia "Enquanto isso, eu estava no quarto sem saber se ou quando voltaria."

# game/scripts/c19/c19.rpy:2913
translate brazilian c19s005_Kiara_61e563a9:

    # mc "¡Es increíble!"
    mc "É incrível!"

# game/scripts/c19/c19.rpy:2915
translate brazilian c19s005_Kiara_c41de8f0:

    # kia "Y catorce años después, por fin tuvo el valor de encararse con un hombre. Y fue el hombre equivocado."
    kia "E quatorze anos depois, ela finalmente teve coragem de confrontar um homem. E era o homem errado."

# game/scripts/c19/c19.rpy:2916
translate brazilian c19s005_Kiara_d8af1d8b:

    # kia "No estabas haciendo nada malo. Nos estabas ayudando a recoger nuestras cosas. Y quiso pegarte."
    kia "Você não estava fazendo nada de errado. Você estava nos ajudando a pegar nossas coisas. E ele tentou te bater."

# game/scripts/c19/c19.rpy:2917
translate brazilian c19s005_Kiara_9e3c4220:

    # mc "Estaba muy borracho."
    mc "Ele estava muito bêbado."

# game/scripts/c19/c19.rpy:2919
translate brazilian c19s005_Kiara_da697a61:

    # kia "Podrías haberte apartado. Decir que no era tu problema. Salir corriendo..."
    kia "Você poderia ter ido embora. Dizido que não era problema seu. Fugido..."

# game/scripts/c19/c19.rpy:2920
translate brazilian c19s005_Kiara_168be713:

    # kia "Pero no lo hiciste. Me defendiste como no lo hizo mi marido cuando tuvo la oportunidad."
    kia "Mas você não fez isso. Você me defendeu de uma forma que meu marido não fez quando teve a chance."

# game/scripts/c19/c19.rpy:2922
translate brazilian c19s005_Kiara_d818f7ba:

    # kia "Nos diste un techo cuando más lo necesitábamos. Cuando no teníamos a donde ir."
    kia "Vocês nos deram um teto sobre nossas cabeças quando mais precisávamos. Quando não tínhamos para onde ir."

# game/scripts/c19/c19.rpy:2923
translate brazilian c19s005_Kiara_1048259e:

    # kia "Incluso nos dejaste tu cama el día que llegamos y fuiste a dormir a un sofá."
    kia "Você até cedeu sua cama no dia em que chegamos e foi dormir no sofá."

# game/scripts/c19/c19.rpy:2924
translate brazilian c19s005_Kiara_8c75bb40:

    # mc "Es lo menos que podía hacer, ¿no?"
    mc "É o mínimo que eu poderia fazer, não é?"

# game/scripts/c19/c19.rpy:2926
translate brazilian c19s005_Kiara_d6e12a48:

    # kia "No tenías que hacer nada. No tenías que cedernos tu cama. Ni pelearte con mi marido."
    kia "Você não precisava fazer nada. Não precisava ceder sua cama. Nem discutir com meu marido."

# game/scripts/c19/c19.rpy:2927
translate brazilian c19s005_Kiara_20e185dc:

    # kia "No tenías ninguna obligación."
    kia "Você não tinha nenhuma obrigação."

# game/scripts/c19/c19.rpy:2928
translate brazilian c19s005_Kiara_bf0c59d8:

    # mc "Sí que la tenía, aunque sólo fuera por decencia humana."
    mc "Sim, eu tinha, mesmo que apenas por decência humana."

# game/scripts/c19/c19.rpy:2929
translate brazilian c19s005_Kiara_818942b0:

    # mc "Aunque hubiera hecho lo mismo sin esa obligación. Necesitabais mi ayuda y yo estaba ahí para prestárosla."
    mc "Embora eu tivesse feito o mesmo mesmo sem essa obrigação, você precisava da minha ajuda e eu estava lá para ajudá-lo(a)."

# game/scripts/c19/c19.rpy:2931
translate brazilian c19s005_Kiara_35b1109c:

    # kia "A eso me refiero, [mc]. Mi marido salió corriendo en nuestro aniversario. Y un chico sin ninguna obligación lo dejó todo y se enfrentó a él por nosotras."
    kia "É isso que eu quero dizer, [mc]. Meu marido fugiu no nosso aniversário. E um cara sem compromissos largou tudo e o enfrentou por nós."

# game/scripts/c19/c19.rpy:2932
translate brazilian c19s005_Kiara_7a0746eb:

    # kia "Por mí."
    kia "Para mim."

# game/scripts/c19/c19.rpy:2933
translate brazilian c19s005_Kiara_59c00afe:

    # mc "No sé cómo lo estás viendo tú, pero yo cada vez lo veo peor como razón para querer irte."
    mc "Não sei como você vê isso, mas eu vejo como um motivo ainda pior para querer ir embora."

# game/scripts/c19/c19.rpy:2935
translate brazilian c19s005_Kiara_ffcc8586:

    # kia "*Risa triste* No, esa es la razón que ha creado la razón para querer irme."
    kia "*Risada triste* Não, essa é a razão que criou o motivo para querer ir embora."

# game/scripts/c19/c19.rpy:2936
translate brazilian c19s005_Kiara_73bd2b28:

    # kia "Después de sentirme tratada como un pedazo de mierda por mi marido durante años... llegas tú y me tratas como a una persona."
    kia "Depois de me sentir um lixo pelas mãos do meu marido durante anos... você aparece e me trata como gente."

# game/scripts/c19/c19.rpy:2937
translate brazilian c19s005_Kiara_347e7179:

    # kia "Me enseñas cómo funciona una familia. Me lo enseñáis entre todos."
    kia "Vocês me ensinam como funciona uma família. Todos vocês me ensinam."

# game/scripts/c19/c19.rpy:2938
translate brazilian c19s005_Kiara_205ab6f1:

    # mc "Bueno, no se puede decir que seamos una familia ejemplar..."
    mc "Bem, não dá para dizer exatamente que somos uma família modelo..."

# game/scripts/c19/c19.rpy:2940
translate brazilian c19s005_Kiara_a46ab22c:

    # kia "No, pero todos os queréis y os protegéis. Todos os ayudáis. Y tú estás en todos sitios. Sólo había que verte durante la comida."
    kia "Não, mas vocês todos se amam e se protegem. Vocês todos se ajudam. E vocês estão em todo lugar. Bastava vocês dois na hora do almoço."

# game/scripts/c19/c19.rpy:2941
translate brazilian c19s005_Kiara_2f521a7e:

    # kia "¿Ha habido alguna chica con quién no hayas hablado hoy? ¿A alguien a quién hayas dejado de lado?"
    kia "Houve alguma garota com quem você não falou hoje? Alguém que você ignorou?"

# game/scripts/c19/c19.rpy:2942
translate brazilian c19s005_Kiara_88558e50:

    # mc "Creo que no... y si lo ha habido debería compensarla."
    mc "Acho que não... e se houve, ela deveria ser indenizada."

# game/scripts/c19/c19.rpy:2944
translate brazilian c19s005_Kiara_ab896e98:

    # kia "Pues todas esas cosas hacen que esté empezando a albergar sentimientos por ti que no deberían estar ahí."
    kia "Bem, todas essas coisas estão fazendo com que eu comece a ter sentimentos por você que não deveriam existir."

# game/scripts/c19/c19.rpy:2945
translate brazilian c19s005_Kiara_caf7057f:

    # kia "Ya está. Ya lo he dicho."
    kia "Pronto, falei."

# game/scripts/c19/c19.rpy:2947
translate brazilian c19s005_Kiara_e903a592:

    # kia "Por eso te he estado evitando. No quiero que esos sentimientos crezcan."
    kia "É por isso que tenho te evitado. Não quero que esses sentimentos cresçam."

# game/scripts/c19/c19.rpy:2949
translate brazilian c19s005_Kiara_db2f0b58:

    # kia "Con la relación que tienes con mi hija, no puedo permitirme enamorarme de ti y... Sencillamente, no puedo."
    kia "Com a relação que você tem com a minha filha, não posso me permitir apaixonar por você e... simplesmente não posso."

# game/scripts/c19/c19.rpy:2951
translate brazilian c19s005_Kiara_e977573d:

    # kia "Después de la relación que tuviste con mi hija... no puedo permitirme enamorarme de ti. ¿Cómo se sentiría después de que no hayas vuelto con ella?"
    kia "Depois do relacionamento que você teve com a minha filha... eu não posso me permitir me apaixonar por você. Como ela se sentiria se vocês não voltassem?"

# game/scripts/c19/c19.rpy:2952
translate brazilian c19s005_Kiara_8f240a7e:

    # mc "Y ¿cómo llevas lo de que los sentimientos no crezcan? Ya llevas tres días evitándome."
    mc "E como você está lidando com o fato de seus sentimentos não estarem se desenvolvendo? Você está me evitando há três dias."

# game/scripts/c19/c19.rpy:2954
translate brazilian c19s005_Kiara_82754d03:

    # kia "Fatal... Sólo espero que cuando me mude podamos seguir siendo amigos."
    kia "Terrível... Só espero que, quando eu me mudar, ainda possamos ser amigos."

# game/scripts/c19/c19.rpy:2968
translate brazilian c19s005_Kiara_d470a96f:

    # mc "Yo también estoy empezando a albergar sentimientos por ti. Pero en mi caso, no me avergüenzo de ellos."
    mc "Estou começando a desenvolver sentimentos por você também. Mas, no meu caso, não tenho vergonha deles."

# game/scripts/c19/c19.rpy:2970
translate brazilian c19s005_Kiara_c517504e:

    # kia "¿Qué? ¿Desde cuándo?"
    kia "O quê? Desde quando?"

# game/scripts/c19/c19.rpy:2971
translate brazilian c19s005_Kiara_1023e69c:

    # mc "Desde que he tenido la oportunidad de conocerte mejor. Conocerte como mujer, no como la madre de mi novia del instituto."
    mc "Desde que tive a oportunidade de te conhecer melhor. De te conhecer como mulher, e não como a mãe da minha namorada do ensino médio."

# game/scripts/c19/c19.rpy:2972
translate brazilian c19s005_Kiara_fa0d14d4:

    # mc "Desde que sé por lo que has pasado. Desde que pude ver a Solomon en el momento en que más asco daba."
    mc "Desde que soube o que você passou. Desde que vi Salomão em sua forma mais repulsiva."

# game/scripts/c19/c19.rpy:2973
translate brazilian c19s005_Kiara_f6a5b899:

    # mc "Llámalo complejo del caballero de brillante armadura o como quieras. Pero aquel día algo hizo clic en mí."
    mc "Pode chamar isso de complexo de cavaleiro de armadura brilhante ou o que quiser. Mas naquele dia, algo mudou para mim."

# game/scripts/c19/c19.rpy:2975
translate brazilian c19s005_Kiara_f695a937:

    # kia "Pero... ¿qué pasa con Eileen?"
    kia "Mas... e quanto a Eileen?"

# game/scripts/c19/c19.rpy:2977
translate brazilian c19s005_Kiara_3e500748:

    # mc "Podemos hablar con ella. Si a ninguna de las dos os importa que la otra esté conmigo, no veo dónde puede estar el problema."
    mc "Podemos conversar com ela. Se nenhum de vocês se importa que o outro esteja comigo, não vejo qual seria o problema."

# game/scripts/c19/c19.rpy:2979
translate brazilian c19s005_Kiara_a3e56306:

    # mc "Ella y yo tuvimos nuestro momento. Fuimos felices. ¿Crees que, si quieres estar conmigo, te va a negar la oportunidad de tener la felicidad que ella tuvo?"
    mc "Ela e eu tivemos o nosso momento. Fomos felizes. Você acha que, se quiser ficar comigo, vou negar a você a chance de ter a felicidade que ela teve?"

# game/scripts/c19/c19.rpy:2980
translate brazilian c19s005_Kiara_2d097cac:

    # mc "Creo que es algo que podemos hablar los tres, si quieres."
    mc "Acho que é algo sobre o qual nós três podemos conversar, se você quiser."

# game/scripts/c19/c19.rpy:2981
translate brazilian c19s005_Kiara_777ceb0e:

    # mcp "(Sabiendo que Eileen quiere que estés lo más lejos posible de Solomon, va a superar cualquier reparo que tenga.)"
    mcp "(Sabendo que Eileen quer que você fique o mais longe possível de Solomon, ela superará quaisquer reservas que tiver.)"

# game/scripts/c19/c19.rpy:2984
translate brazilian c19s005_Kiara_2c78da6b:

    # kia "¿Y con tu novia? No podría aceptar ser \"la otra\", ni hacerle daño o engañarla a sus espaldas."
    kia "E quanto à sua namorada? Eu não conseguiria aceitar ser \"a outra\", magoá-la ou traí-la pelas costas."

# game/scripts/c19/c19.rpy:2985
translate brazilian c19s005_Kiara_f376de56:

    # mc "Podemos hablar con ella también. Si a ella no le importa, y a ti tampoco, no veo dónde puede estar el problema."
    mc "Podemos falar com ela também. Se ela não se importar, e você também não, não vejo qual seria o problema."

# game/scripts/c19/c19.rpy:2987
translate brazilian c19s005_Kiara_a1a393a8:

    # kia "¿Y con tu harén?"
    kia "E quanto ao seu harém?"

# game/scripts/c19/c19.rpy:2988
translate brazilian c19s005_Kiara_e2468207:

    # mc "¿Crees que no te van a aceptar en el harén? ¿Has visto algún problema con las revelaciones de hoy?"
    mc "Você acha que eles não vão te aceitar no harém? Você percebeu algum problema com as revelações de hoje?"

# game/scripts/c19/c19.rpy:2990
translate brazilian c19s005_Kiara_045e22dc:

    # kia "Haces que todo parezca tan fácil... pero no lo es."
    kia "Você faz tudo parecer tão fácil... mas não é."

# game/scripts/c19/c19.rpy:2991
translate brazilian c19s005_Kiara_eb6bb8e6:

    # mc "Hagamos una cosa... empecemos hablando con Eileen. Después puedes tomar una decisión. Pero que esa decisión no incluya mudarte, por favor."
    mc "Vamos lá... vamos começar conversando com a Eileen. Depois você pode tomar uma decisão. Mas, por favor, não deixe que essa decisão envolva uma mudança."

# game/scripts/c19/c19.rpy:2993
translate brazilian c19s005_Kiara_626625d7:

    # mc "Siempre vamos a ser amigos, Kiara. A mí siempre me has caído bien, pero no creo que debamos ir más allá de ser amigos."
    mc "Sempre seremos amigas, Kiara. Sempre gostei de você, mas não acho que devamos ir além da amizade."

# game/scripts/c19/c19.rpy:2995
translate brazilian c19s005_Kiara_087874d0:

    # kia "Eso ayuda..."
    kia "Isso ajuda..."

# game/scripts/c19/c19.rpy:2997
translate brazilian c19s005_Kiara_d8d56bc4:

    # kia "Después de ver que sales con más de una mujer... casi había empezado a albergar esperanzas. Aunque me negara a aceptarlas."
    kia "Depois de te ver saindo com mais de uma mulher... quase comecei a criar expectativas. Mesmo que eu me recusasse a aceitá-las."

# game/scripts/c19/c19.rpy:2998
translate brazilian c19s005_Kiara_df5fd914:

    # mc "Te quiero, pero no así. Te quiero porque eres una mujer maravillosa y siempre me vas a tener a tu lado para lo que necesites."
    mc "Eu te amo, mas não desse jeito. Eu te amo porque você é uma mulher maravilhosa e sempre poderá contar comigo para o que precisar."

# game/scripts/c19/c19.rpy:2999
translate brazilian c19s005_Kiara_75ab4beb:

    # mc "Pero no puedo tener una relación contigo. Comparto varios de tus reparos."
    mc "Mas não posso ter um relacionamento com você. Compartilho várias das suas preocupações."

# game/scripts/c19/c19.rpy:3001
translate brazilian c19s005_Kiara_81a0ebac:

    # kia "Y hasta aquí ha llegado esta conversación, ¿no?"
    kia "E essa é o fim da conversa, certo?"

# game/scripts/c19/c19.rpy:3002
translate brazilian c19s005_Kiara_9d640a05:

    # mc "Aún queda lo de irte de la casa. Yo me voy a ir a Aruba en unas semanas, con lo que no creo que debas hacerlo. Vas a estar mejor aquí que en cualquier otro sitio."
    mc "Você ainda tem a opção de sair de casa. Vou para Aruba daqui a algumas semanas, então acho que você não deveria. Você estará melhor aqui do que em qualquer outro lugar."

# game/scripts/c19/c19.rpy:3004
translate brazilian c19s005_Kiara_98195484:

    # kia "Creo que debería irme igualmente. De todas formas, en septiembre deberemos dejar la habitación libre para las estudiantes nuevas..."
    kia "Acho que devo ir embora de qualquer forma. Em todo caso, teremos que desocupar a sala para os novos alunos em setembro..."

# game/scripts/c19/c19.rpy:3005
translate brazilian c19s005_Kiara_d85b58bd:

    # mc "Pero yo no estaré. Podéis usar mi habitación mientras esté en Aruba. No hay ninguna prisa en que os vayáis."
    mc "Mas eu não estarei lá. Você pode usar meu quarto enquanto eu estiver em Aruba. Não precisa ter pressa para ir embora."

# game/scripts/c19/c19.rpy:3007
translate brazilian c19s005_Kiara_d34be1e0:

    # kia "Pero volverás. No podemos pedirte que duermas en el sofá eternamente. Igualmente tendremos que irnos a algún sitio."
    kia "Mas você vai voltar. Não podemos esperar que você durma no sofá para sempre. Eventualmente, teremos que ir a algum lugar."

# game/scripts/c19/c19.rpy:3009
translate brazilian c19s005_Kiara_fb061c9a:

    # mc "Lo entiendo, pero no tomes ninguna decisión precipitada. Creo que se me está ocurriendo una idea."
    mc "Entendo, mas não tome nenhuma decisão precipitada. Acho que estou começando a entender."

# game/scripts/c19/c19.rpy:3012
translate brazilian c19s005_Kiara_70cb7ff7:

    # mad "Hola, ¿interrumpo algo?"
    mad "Olá, estou interrompendo algo?"

# game/scripts/c19/c19.rpy:3013
translate brazilian c19s005_Kiara_5423af24:

    # mc "Hola de nuevo, Maddie. No, no te preocupes. ¿Necesitas algo?"
    mc "Olá de novo, Maddie. Não, não se preocupe. Precisa de alguma coisa?"

# game/scripts/c19/c19.rpy:3015
translate brazilian c19s005_Kiara_0d69ec4c:

    # mad "Estamos haciendo un juego en el Jacuzzi y venía a preguntarle a Kiara si se quería apuntar."
    mad "Estamos jogando um jogo na jacuzzi e eu vim perguntar à Kiara se ela queria participar."

# game/scripts/c19/c19.rpy:3016
translate brazilian c19s005_Kiara_3643a8af:

    # mc "¿Sólo Kiara?"
    mc "Só a Kiara?"

# game/scripts/c19/c19.rpy:3017
translate brazilian c19s005_Kiara_ccd329d1:

    # mad "Es un juego solo de chicas, [mc]. Lo siento. Algo para crear más vínculos entre nosotras."
    mad "É um jogo só para meninas, [mc]. Desculpe. Algo para criar mais laços entre nós."

# game/scripts/c19/c19.rpy:3019
translate brazilian c19s005_Kiara_eddcc4ea:

    # kia "¡Me apunto! ¿De qué va el juego?"
    kia "Eu topo! Do que se trata o jogo?"

# game/scripts/c19/c19.rpy:3021
translate brazilian c19s005_Kiara_71fc6a2a:

    # mad "Mejor te lo explico por el camino. Ya estamos unas cuantas allí."
    mad "Eu explico tudo para você no caminho. Já tem bastante gente lá."

# game/scripts/c19/c19.rpy:3023
translate brazilian c19s005_Kiara_a96c5624:

    # kia "Te veo luego, [mc]. Me tienes que explicar esa idea que has tenido."
    kia "Te vejo mais tarde, [mc]. Você tem que me explicar aquela ideia que você teve."

# game/scripts/c19/c19.rpy:3024
translate brazilian c19s005_Kiara_de4d03e5:

    # mc "Perfecto."
    mc "Perfeito."

# game/scripts/c19/c19.rpy:3026
translate brazilian c19s005_Kiara_8aa8992c:

    # "Kiara cruza la piscina a nado y se va junto a Maddie hacia el Jacuzzi."
    "Kiara atravessa a piscina a nado e vai com Maddie em direção à jacuzzi."

# game/scripts/c19/c19.rpy:3027
translate brazilian c19s005_Kiara_13a99306:

    # mcp "(Al menos ha quedado aclarado el tema de Kiara. A ver cómo evoluciona.)"
    mcp "(Pelo menos a situação da Kiara foi esclarecida. Vamos ver como as coisas se desenvolvem.)"

# game/scripts/c19/c19.rpy:3061
translate brazilian c19s005_KateNorah_e9d933f4:

    # "Buscas a Eileen con la mirada, pero no la ves por ningún lado. Supones que estará en el juego del jacuzzi."
    "Você procura Eileen com o olhar, mas não a encontra em lugar nenhum. Você presume que ela esteja na jacuzzi."

# game/scripts/c19/c19.rpy:3062
translate brazilian c19s005_KateNorah_ef1f610a:

    # "Cada vez quedan menos chicas en la piscina. Te acercas a Kate y a [nor]."
    "Há cada vez menos garotas na piscina. Você está se aproximando de Kate agora [nor]."

# game/scripts/c19/c19.rpy:3065
translate brazilian c19s005_KateNorah_79127472:

    # kat "Aquí llega mi héroe. *Risa* Salir con una de las preciosidades de esta familia ya es un triunfo. Tú lo haces con más de una."
    kat "Eis que surge meu herói. *Risos* Namorar uma das beldades desta família já é uma vitória. Imagine com mais de uma!"

# game/scripts/c19/c19.rpy:3066
translate brazilian c19s005_KateNorah_734d98ae:

    # mc "No es heroísmo. *Risa* Es suerte."
    mc "Não é heroísmo. *Risos* É sorte."

# game/scripts/c19/c19.rpy:3068
translate brazilian c19s005_KateNorah_180c6917:

    # mc "Y me refiero a suerte por mi parte. Estar con alguien como [nor] es increíble."
    mc "E, quer dizer, eu tenho sorte. Estar com alguém como [nor] é incrível."

# game/scripts/c19/c19.rpy:3069
translate brazilian c19s005_KateNorah_979b2ad2:

    # nor "Gracias, mi amor."
    nor "Obrigado, meu amor."

# game/scripts/c19/c19.rpy:3071
translate brazilian c19s005_KateNorah_ee6e34cd:

    # mc "Y me refiero a suerte por mi parte."
    mc "E quero dizer que foi sorte da minha parte."

# game/scripts/c19/c19.rpy:3072
translate brazilian c19s005_KateNorah_7f7a7a24:

    # nor "Por tu parte y por la de ellas."
    nor "Por sua parte e pela deles."

# game/scripts/c19/c19.rpy:3074
translate brazilian c19s005_KateNorah_15f32294:

    # kat "Aquí llega el hombre del día. *Risa* Que hayas conseguido una relación en esta familia es para felicitarte."
    kat "Eis que surge o homem do dia. *Risos* O fato de você ter conseguido criar um relacionamento com essa família é algo digno de parabéns."

# game/scripts/c19/c19.rpy:3076
translate brazilian c19s005_KateNorah_aa1ff343:

    # mc "Gracias. No podría estar con nadie mejor. *Risa* Y no lo digo porque esté delante."
    mc "Obrigada. Não poderia estar com ninguém melhor. *Risos* E não estou dizendo isso só porque estou aqui."

# game/scripts/c19/c19.rpy:3077
translate brazilian c19s005_KateNorah_979b2ad2_1:

    # nor "Gracias, mi amor."
    nor "Obrigado, meu amor."

# game/scripts/c19/c19.rpy:3079
translate brazilian c19s005_KateNorah_d5bd004d:

    # mc "Gracias, Kate. Soy un hombre con suerte."
    mc "Obrigado, Kate. Sou um homem de sorte."

# game/scripts/c19/c19.rpy:3080
translate brazilian c19s005_KateNorah_196f9628:

    # nor "Y ella también, [mc]. No lo olvides."
    nor "E ela também, [mc]. Não se esqueça disso."

# game/scripts/c19/c19.rpy:3082
translate brazilian c19s005_KateNorah_84bdcf3b:

    # kat "Aquí llega el hombre más desafortunado del mundo. *Risa* La única mujer que le escribe y es un número equivocado."
    kat "Eis que surge o homem mais azarado do mundo. *Risos* A única mulher que lhe manda mensagem é um número errado."

# game/scripts/c19/c19.rpy:3083
translate brazilian c19s005_KateNorah_10c75dbb:

    # mc "No sabemos si escribía una mujer o un hombre. *Risa*"
    mc "Não sabemos se foi escrito por uma mulher ou por um homem. *Risos*"

# game/scripts/c19/c19.rpy:3084
translate brazilian c19s005_KateNorah_53ec85ae:

    # nor "En eso tienes razón, pero todas hemos pensado que era una chica."
    nor "Você tem razão, mas todos nós pensávamos que era uma menina."

# game/scripts/c19/c19.rpy:3086
translate brazilian c19s005_KateNorah_301b109c:

    # kat "Desde La Revelación te he visto hablar con Tía Betty, Amanda, Olivia, y Kiara."
    kat "Desde a Revelação, eu vi você conversando com a Tia Betty, Amanda, Olivia e Kiara."

# game/scripts/c19/c19.rpy:3088
translate brazilian c19s005_KateNorah_716518ff:

    # kat "Ninguna está en tu harén..."
    kat "Nenhuma delas faz parte do seu harém..."

# game/scripts/c19/c19.rpy:3090
translate brazilian c19s005_KateNorah_d0ffcda4:

    # kat "Supongo que te han ametrallado a preguntas, con lo que no lo voy a hacer yo."
    kat "Imagino que você já tenha sido bombardeado com perguntas, então não vou respondê-las."

# game/scripts/c19/c19.rpy:3092
translate brazilian c19s005_KateNorah_1147508f:

    # kat "Supongo que lo de Meemaw se ha convertido en la comidilla del día."
    kat "Acho que o assunto da vovó virou a fofoca da cidade."

# game/scripts/c19/c19.rpy:3093
translate brazilian c19s005_KateNorah_50e84a49:

    # mc "El tema de conversación ha salido, pero hemos hablado de otros temas que teníamos pendientes. No todo gira alrededor de La Revelación."
    mc "O assunto da conversa surgiu, mas também falamos sobre outras coisas que tínhamos pendentes. Nem tudo gira em torno do Apocalipse."

# game/scripts/c19/c19.rpy:3095
translate brazilian c19s005_KateNorah_89e5b452:

    # nor "Son estas cosas por las que no se deberían soltar noticias bomba en una fiesta familiar. Absorben las conversaciones."
    nor "São essas coisas que tornam uma pena dar notícias bombásticas em uma festa de família. Elas dominam a conversa."

# game/scripts/c19/c19.rpy:3096
translate brazilian c19s005_KateNorah_cc688986:

    # mc "Por otro lado, es el mejor momento. Ahora ya lo sabe todo el mundo."
    mc "Por outro lado, é o momento perfeito. Agora todos sabem."

# game/scripts/c19/c19.rpy:3098
translate brazilian c19s005_KateNorah_ccb9c144:

    # mc "Pero cambiemos de tema y volvamos a la fiesta. ¿Qué tal tu primera experiencia con una fiesta con toda la familia?"
    mc "Mas vamos mudar de assunto e voltar à festa. Como foi sua primeira experiência com uma festa em família?"

# game/scripts/c19/c19.rpy:3099
translate brazilian c19s005_KateNorah_70c9a0e6:

    # kat "Te recuerdo que estuve en la playa en Navidad. *Risa*"
    kat "Lembro que estive na praia no Natal. *Risos*"

# game/scripts/c19/c19.rpy:3100
translate brazilian c19s005_KateNorah_c98ca203:

    # mc "*Risa* Lo sé, pero ahora la familia ha crecido. Al menos hasta que lleguen las chichas nuevas, creo que no van a aparecer nuevos miembros."
    mc "*Risos* Eu sei, mas agora a família cresceu. Pelo menos até as novas meninas chegarem, acho que não vai aparecer nenhum membro novo."

# game/scripts/c19/c19.rpy:3102
translate brazilian c19s005_KateNorah_201b9f35:

    # kat "En eso tienes razón. Megan, Amanda, Eva... No estuvieron en la playa, pero son parte de esto."
    kat "Você tem razão. Megan, Amanda, Eva... Elas não estavam na praia, mas fazem parte disso."

# game/scripts/c19/c19.rpy:3104
translate brazilian c19s005_KateNorah_7c8a4812:

    # kat "Y Maddie supongo que también, saliendo contigo... pero se la ve cohibida aún."
    kat "E eu imagino que a Maddie se sinta da mesma forma, saindo com você... mas ela ainda parece insegura."

# game/scripts/c19/c19.rpy:3106
translate brazilian c19s005_KateNorah_c404829b:

    # kat "Y creo que Maddie también podría unirse si le damos la oportunidad. Es muy buena chica."
    kat "E acho que a Maddie também poderia participar se lhe déssemos a oportunidade. Ela é uma menina muito simpática."

# game/scripts/c19/c19.rpy:3108
translate brazilian c19s005_KateNorah_2ef2993a:

    # nor "No la conocía mucho, más allá de comprarle ropa, pero es una chica muy agradable."
    nor "Eu não a conhecia muito bem, além de comprar roupas para ela, mas ela é uma garota muito legal."

# game/scripts/c19/c19.rpy:3109
translate brazilian c19s005_KateNorah_69e25ce6:

    # mc "Lo es. Y creo que se está integrando bien hoy. Al menos para ser su primera vez."
    mc "Sim, é. E acho que está se adaptando bem hoje. Pelo menos para uma primeira vez."

# game/scripts/c19/c19.rpy:3111
translate brazilian c19s005_KateNorah_14313d0e:

    # kat "Cambiando de tema, cuando te vayas a Aruba, ¿quién se ocupará de lo que haces tú en el Dormitorio?"
    kat "Mudando de assunto, quando você for para Aruba, quem cuidará do que você fizer no dormitório?"

# game/scripts/c19/c19.rpy:3112
translate brazilian c19s005_KateNorah_7289dceb:

    # kat "Creo que entre todas podríamos ayudar para que [mar] y [nor] no tengan demasiado trabajo."
    kat "Acho que todos nós poderíamos ajudar para que [mar] e [nor] não tenham muito trabalho."

# game/scripts/c19/c19.rpy:3113
translate brazilian c19s005_KateNorah_496d8c87:

    # mc "No te preocupes. Vosotras tenéis vuestros estudios. Y la contabilidad la puedo seguir haciendo desde allí. No lleva mucho tiempo."
    mc "Não se preocupe. Você tem seus estudos. E eu posso continuar cuidando da contabilidade a partir daí. Não leva muito tempo."

# game/scripts/c19/c19.rpy:3115
translate brazilian c19s005_KateNorah_b5cc84c6:

    # mc "Ahora mismo es mi trabajo principal. Bueno, y hacer de taxista. *Risa*"
    mc "Este é meu trabalho principal no momento. Bem, e dirigir um táxi. *Risos*"

# game/scripts/c19/c19.rpy:3117
translate brazilian c19s005_KateNorah_7af261d5:

    # kat "¿Puedo preguntar cómo empezasteis a salir juntos vosotros dos? ¿Y cómo habéis conseguido ocultarlo?"
    kat "Posso perguntar como vocês dois começaram a namorar? E como conseguiram manter isso em segredo?"

# game/scripts/c19/c19.rpy:3118
translate brazilian c19s005_KateNorah_6794e850:

    # kat "Si me hubieran dicho que salías con una de las chicas Marks, seguramente [nor] hubiera sido mi última elección."
    kat "Se tivessem me dito que você estava namorando uma das garotas Marks, eu definitivamente teria sido minha última opção."

# game/scripts/c19/c19.rpy:3119
translate brazilian c19s005_KateNorah_1c1f2c26:

    # kat "Bueno, no la última... nunca hubiese pensado en Olivia o Betty tampoco."
    kat "Bem, não a última... Eu nunca teria pensado em Olivia ou Betty."

# game/scripts/c19/c19.rpy:3120
translate brazilian c19s005_KateNorah_3d4aa2e4:

    # mc "Bueno, todo empezó mientras pintábamos la habitación de Saira."
    mc "Bem, tudo começou enquanto estávamos pintando o quarto da Saira."

# game/scripts/c19/c19.rpy:3122
translate brazilian c19s005_KateNorah_d7982167:

    # nor "Después yo me metí en el baño dónde se estaba duchando después de pintar."
    nor "Então entrei no banheiro onde ele estava tomando banho depois de pintar."

# game/scripts/c19/c19.rpy:3124
translate brazilian c19s005_KateNorah_fa4f6932:

    # nor "Y me metí en la ducha con él."
    nor "E eu entrei no chuveiro com ele."

# game/scripts/c19/c19.rpy:3126
translate brazilian c19s005_KateNorah_2f9853a4:

    # nor "No pasó nada, pero nos dio pie a hablar."
    nor "Não aconteceu nada, mas isso nos deu a oportunidade de conversar."

# game/scripts/c19/c19.rpy:3128
translate brazilian c19s005_KateNorah_c4379c1f:

    # kat "¿Qué? ¡No puede ser! ¡Yo nunca me atrevería a algo así!"
    kat "O quê? De jeito nenhum! Eu jamais ousaria fazer uma coisa dessas!"

# game/scripts/c19/c19.rpy:3130
translate brazilian c19s005_KateNorah_d822dae8:

    # kat "¿Y tú no sabes que existen los pestillos?"
    kat "E você não sabe que existem fechos?"

# game/scripts/c19/c19.rpy:3131
translate brazilian c19s005_KateNorah_db6800e4:

    # mc "*Risa* El de ese baño estaba roto. Me alegra que lo estuviera."
    mc "*Risos* A daquele banheiro estava quebrada. Ainda bem."

# game/scripts/c19/c19.rpy:3133
translate brazilian c19s005_KateNorah_9d314019:

    # mc "Y para las pequeñas reparaciones pueden llamar a alguien para que las haga."
    mc "E para pequenos reparos, eles podem chamar alguém para fazê-los."

# game/scripts/c19/c19.rpy:3135
translate brazilian c19s005_KateNorah_3207426c:

    # nor "Los pestillos de los baños están aguantando bien. Y eso que ahora hay mucho más tráfico en esos baños que antes."
    nor "As fechaduras dos banheiros estão resistindo bem. E isso apesar de haver muito mais movimento nesses banheiros agora do que antes."

# game/scripts/c19/c19.rpy:3137
translate brazilian c19s005_KateNorah_1919e27e:

    # kat "¿Teníais roto algún pestillo antes de que nosotras llegáramos?"
    kat "Havia alguma fechadura quebrada antes de chegarmos?"

# game/scripts/c19/c19.rpy:3139
translate brazilian c19s005_KateNorah_af7fcf4c:

    # nor "Sí, yo una vez pillé a [mc] duchándose. El día que pintamos la habitación de Saira."
    nor "Sim, uma vez flagrei [mc] tomando banho. No dia em que pintamos o quarto da Saira."

# game/scripts/c19/c19.rpy:3140
translate brazilian c19s005_KateNorah_49f9aa49:

    # mc "¡Es verdad! ¡Casi ni me acordaba!"
    mc "É verdade! Eu quase tinha esquecido!"

# game/scripts/c19/c19.rpy:3142
translate brazilian c19s005_KateNorah_cf4dbc66:

    # kat "Mmmm... ¿Qué baño es el que tiene el pestillo roto?"
    kat "Hum... Qual banheiro tem a fechadura quebrada?"

# game/scripts/c19/c19.rpy:3143
translate brazilian c19s005_KateNorah_78c5db4c:

    # mc "*Risa* Ahora ninguno. Arreglé el de la planta baja pocos días antes de que llegarais, y puse uno en vuestra planta."
    mc "*Risos* Agora não tem mais. Consertei o do andar de baixo alguns dias antes de você chegar e coloquei um no seu andar."

# game/scripts/c19/c19.rpy:3144
translate brazilian c19s005_KateNorah_d1207734:

    # mc "Los únicos que no tienen son los de las habitaciones de [mar] y Saira, y el del gimnasio."
    mc "Os únicos que eles não têm são os que estão nos quartos de [mar] e Saira, e o que está no ginásio."

# game/scripts/c19/c19.rpy:3145
translate brazilian c19s005_KateNorah_fdc763e7:

    # mc "No estás pensando en meterte en algún baño mientras alguna de las chicas se ducha, ¿verdad?"
    mc "Você não está pensando em entrar sorrateiramente no banheiro enquanto uma das meninas está tomando banho, está?"

# game/scripts/c19/c19.rpy:3147
translate brazilian c19s005_KateNorah_4093d35b:

    # kat "¿Qué? ¿Alguna de las chicas? ¡No!"
    kat "O quê? Alguma das meninas? Não!"

# game/scripts/c19/c19.rpy:3148
translate brazilian c19s005_KateNorah_fd73ed68:

    # kat "Sólo lo decía en caso de... en caso de... en caso de tener que atrancar la puerta o algo."
    kat "Eu só estava dizendo isso caso... caso... caso eu precisasse trancar a porta ou algo assim."

# game/scripts/c19/c19.rpy:3149
translate brazilian c19s005_KateNorah_58e96678:

    # mc "*Risa* Yo siempre llamo antes de entrar en un baño, no te preocupes. Crecí rodeado de chicas."
    mc "*Risos* Eu sempre bato na porta antes de entrar no banheiro, não se preocupe. Cresci rodeado de garotas."

# game/scripts/c19/c19.rpy:3151
translate brazilian c19s005_KateNorah_0e095aba:

    # nor "Y si quieres pillar a [mc] duchándose, tu mejor opción es el baño del gimnasio."
    nor "E se você quiser flagrar [mc] tomando banho, a melhor opção é o banheiro da academia."

# game/scripts/c19/c19.rpy:3153
translate brazilian c19s005_KateNorah_743e5f3d:

    # nor "Es el primero que probé yo, pero por entonces había menos gente en la casa. Se estaba duchando en otro."
    nor "Foi a primeira que experimentei, mas havia menos pessoas na casa naquela altura. Ela estava a tomar banho noutra."

# game/scripts/c19/c19.rpy:3154
translate brazilian c19s005_KateNorah_1774101e:

    # mc "No creo que Kate tenga ningún interés en pillarme en la ducha, mi vida."
    mc "Acho que Kate não tem o menor interesse em me pegar no chuveiro, meu amor."

# game/scripts/c19/c19.rpy:3156
translate brazilian c19s005_KateNorah_4d9c45f3:

    # mc "No creo que Kate tenga ningún interés en pillarme en la ducha, [nor]."
    mc "Não acho que Kate tenha qualquer interesse em me pegar no chuveiro, [nor]."

# game/scripts/c19/c19.rpy:3159
translate brazilian c19s005_KateNorah_835e08cc:

    # kat "¡Por supuesto que no! ¡Además, ya estás con [nor]!"
    kat "Claro que não! Além disso, você já está com [nor]!"

# game/scripts/c19/c19.rpy:3161
translate brazilian c19s005_KateNorah_42c54e48:

    # kat "¡Por supuesto que no! ¡Además, ya estás con alguien!"
    kat "Claro que não! Além disso, você já está com alguém!"

# game/scripts/c19/c19.rpy:3163
translate brazilian c19s005_KateNorah_8a5c59b3:

    # kat "¡Por supuesto que no! ¡Además, tú ya tienes tu harén!"
    kat "Claro que não! Além disso, você já tem seu harém!"

# game/scripts/c19/c19.rpy:3165
translate brazilian c19s005_KateNorah_76cc7daf:

    # kat "¡Por supuesto que no! ¡Además, saliste con Eileen y Saira!"
    kat "Claro que não! Além disso, você saiu com a Eileen e a Saira!"

# game/scripts/c19/c19.rpy:3167
translate brazilian c19s005_KateNorah_bf87f68f:

    # nor "*Risa*"
    nor "*Risada*"

# game/scripts/c19/c19.rpy:3168
translate brazilian c19s005_KateNorah_9e3dcc61:

    # mc "¿Qué pasa, [nor]?"
    mc "E aí, [nor]?"

# game/scripts/c19/c19.rpy:3171
translate brazilian c19s005_KateNorah_6485e52e:

    # nor "Nada, mi amor. Pero creo que deberías ir a hablar con otras chicas antes de que piensen que te monopolizamos."
    nor "Nada, meu amor. Mas acho que você deveria conversar com outras garotas antes que elas pensem que nós te monopolizamos."

# game/scripts/c19/c19.rpy:3173
translate brazilian c19s005_KateNorah_a68c14ce:

    # nor "Nada, cielo. Pero creo que deberías ir a hablar con otras chicas antes de que piensen que te monopolizamos."
    nor "Nada, querida. Mas acho que você deveria conversar com outras garotas antes que elas pensem que estamos monopolizando você."

# game/scripts/c19/c19.rpy:3174
translate brazilian c19s005_KateNorah_e61c9ffd:

    # mcp "(No soy tan obtuso como para no darme cuenta de cuando quieren hablar a solas.)"
    mcp "(Não sou tão obtuso a ponto de não perceber quando eles querem conversar a sós.)"

# game/scripts/c19/c19.rpy:3176
translate brazilian c19s005_KateNorah_2f90526d:

    # mc "De acuerdo. Además, tenía que hablar con Eileen, y veo que está ahí, hablando con Lisa."
    mc "Certo. Além disso, eu precisava falar com a Eileen, e vejo que ela está lá, conversando com a Lisa."

# game/scripts/c19/c19.rpy:3177
translate brazilian c19s005_KateNorah_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "Até logo, meninas."

# game/scripts/c19/c19.rpy:3215
translate brazilian c19s007_KateWithNor_de805308:

    # "Mientras tú hablabas con Eileen..."
    "Enquanto você conversava com Eileen..."

# game/scripts/c19/c19.rpy:3218
translate brazilian c19s007_KateWithNor_e9260096:

    # nor "Te gusta, ¿verdad?"
    nor "Você gosta, não é?"

# game/scripts/c19/c19.rpy:3220
translate brazilian c19s007_KateWithNor_420624a2:

    # kat "¿Qué? ¡No! No sé si lo sabes, pero a mí me gustan las mujeres, no los hombres."
    kat "O quê? Não! Não sei se você sabe, mas eu gosto de mulheres, não de homens."

# game/scripts/c19/c19.rpy:3222
translate brazilian c19s007_KateWithNor_f367d73b:

    # nor "Sabes que te pueden gustar las mujeres... y [mc], ¿verdad?"
    nor "Você sabe que pode gostar de mulheres... e de [mc], né?"

# game/scripts/c19/c19.rpy:3223
translate brazilian c19s007_KateWithNor_9f118cce:

    # nor "No es necesario que te gusten el resto de los hombres."
    nor "Você não precisa gostar de outros homens."

# game/scripts/c19/c19.rpy:3225
translate brazilian c19s007_KateWithNor_bfc51426:

    # kat "No sé de dónde has sacado la ridícula idea de que me puede gustar [mc]."
    kat "Não sei de onde você tirou a ideia ridícula de que eu poderia gostar de [mc]."

# game/scripts/c19/c19.rpy:3227
translate brazilian c19s007_KateWithNor_3fc1dc89:

    # nor "De hace un momento. Cuando has dicho ese vehemente \"por supuesto que no\"."
    nor "Agora mesmo. Quando você disse com tanta veemência \"claro que não\"."

# game/scripts/c19/c19.rpy:3229
translate brazilian c19s007_KateWithNor_69ad2e01:

    # nor "Tu razón para ese \"por supuesto que no\" es que está conmigo."
    nor "Sua resposta para esse \"claro que não\" é que ele está comigo."

# game/scripts/c19/c19.rpy:3231
translate brazilian c19s007_KateWithNor_dbfe7880:

    # nor "Tu razón para ese \"por supuesto que no\" es con quién sale."
    nor "O motivo do seu \"claro que não\" é com quem ela está namorando."

# game/scripts/c19/c19.rpy:3233
translate brazilian c19s007_KateWithNor_cbb891e7:

    # nor "Tu razón para ese \"por supuesto que no\" es que tiene un harén."
    nor "Sua resposta para \"claro que não\" é que ele tem um harém."

# game/scripts/c19/c19.rpy:3235
translate brazilian c19s007_KateWithNor_f4154e92:

    # nor "Tu razón para ese \"por supuesto que no\" es con quién salió en el pasado."
    nor "Sua resposta para esse \"claro que não\" se baseia em com quem ela namorou no passado."

# game/scripts/c19/c19.rpy:3236
translate brazilian c19s007_KateWithNor_aa57dace:

    # nor "Sólo estábamos hablando de pillarlo desnudo, no de salir con él. No debería importar... a menos que te guste."
    nor "Estávamos falando sobre flagrá-lo nu, não sobre namorar com ele. Não deveria importar... a menos que você goste dele."

# game/scripts/c19/c19.rpy:3238
translate brazilian c19s007_KateWithNor_f08bb232:

    # kat "Supongo que lo consideraba algún tipo de traición... pillarlo desnudo a propósito, me refiero."
    kat "Suponho que ele tenha considerado isso uma espécie de traição... tê-lo flagrado nu de propósito, quero dizer."

# game/scripts/c19/c19.rpy:3240
translate brazilian c19s007_KateWithNor_11f61b1e:

    # nor "¿Sabes lo que realmente sería una traición? Que no aceptaras lo que sientes."
    nor "Sabe o que seria uma verdadeira traição? Não aceitar o que você sente."

# game/scripts/c19/c19.rpy:3241
translate brazilian c19s007_KateWithNor_5d309e37:

    # nor "Sería una traición a ti misma."
    nor "Seria uma traição a si mesmo."

# game/scripts/c19/c19.rpy:3243
translate brazilian c19s007_KateWithNor_0bd65c6a:

    # kat "Pero..."
    kat "Mas..."

# game/scripts/c19/c19.rpy:3245
translate brazilian c19s007_KateWithNor_042b7c89:

    # nor "No hay peros, Kate. Si, sé que te gustan las mujeres. Todas lo sabemos."
    nor "Sem \"mas\", Kate. Sim, eu sei que você gosta de mulheres. Todos nós sabemos disso."

# game/scripts/c19/c19.rpy:3246
translate brazilian c19s007_KateWithNor_faac1dc3:

    # nor "Cuando [eri] pidió la fiesta topless, se te caía la baba mientras [mar] la autorizaba."
    nor "Quando [eri] pediu a festa de topless, você estava babando enquanto [mar] a autorizava."

# game/scripts/c19/c19.rpy:3247
translate brazilian c19s007_KateWithNor_0b35142a:

    # nor "Te pasaste el resto de la cena imaginándonos a todas en topless."
    nor "Você passou o resto do jantar imaginando todas nós sem blusa."

# game/scripts/c19/c19.rpy:3249
translate brazilian c19s007_KateWithNor_04a4fdec:

    # kat "Lo siento... creía que había sido más discreta."
    kat "Me desculpe... pensei que tivesse sido mais discreto."

# game/scripts/c19/c19.rpy:3251
translate brazilian c19s007_KateWithNor_fb473e61:

    # nor "No pasa nada, cielo. La discreción no es lo tuyo, pero no pasa nada."
    nor "Tudo bem, querida. Discrição não é o seu forte, mas não tem problema."

# game/scripts/c19/c19.rpy:3252
translate brazilian c19s007_KateWithNor_07e92efc:

    # nor "Lo estoy diciendo porque hoy, con doce o trece chicas en topless, nos has dedicado menos miradas de las que todas esperábamos."
    nor "Digo isso porque hoje, com doze ou treze garotas de topless, vocês nos deram menos atenção do que esperávamos."

# game/scripts/c19/c19.rpy:3253
translate brazilian c19s007_KateWithNor_5edf6d55:

    # nor "Has pasado más tiempo mirando a [mc] que a nosotras."
    nor "Você passou mais tempo olhando para [mc] do que para nós."

# game/scripts/c19/c19.rpy:3255
translate brazilian c19s007_KateWithNor_ee886111:

    # kat "*Risa* Eso es porque hoy he sido más discreta mirando."
    kat "*Risos* É porque hoje me vesti de forma mais discreta."

# game/scripts/c19/c19.rpy:3257
translate brazilian c19s007_KateWithNor_be4d06de:

    # nor "*Risa* No, Kate, no lo has sido."
    nor "*Risos* Não, Kate, você não esteve."

# game/scripts/c19/c19.rpy:3258
translate brazilian c19s007_KateWithNor_d458055b:

    # nor "Creo que te he pillado mirándome los pechos unas seis veces. Y mis ojos están aquí arriba. *Risa* Siete."
    nor "Acho que te peguei olhando para os meus seios umas seis vezes. E meus olhos estão aqui em cima. *Risos* Sete."

# game/scripts/c19/c19.rpy:3260
translate brazilian c19s007_KateWithNor_e069c8cf:

    # kat "Lo siento..."
    kat "Desculpe..."

# game/scripts/c19/c19.rpy:3261
translate brazilian c19s007_KateWithNor_7dd50e9e:

    # kat "Como Jamaal ha dicho, mi cerebro lésbico está confundido."
    kat "Como disse Jamaal, meu cérebro lésbico está confuso."

# game/scripts/c19/c19.rpy:3263
translate brazilian c19s007_KateWithNor_f1f5021b:

    # kat "No por un exceso de tetas. De esas nunca hay suficientes. Pero es que [mc] me confunde."
    kat "Não é por causa de seios demais. Nunca se tem seios demais. Mas [mc] me confunde."

# game/scripts/c19/c19.rpy:3265
translate brazilian c19s007_KateWithNor_90d594f3:

    # kat "Me cae muy bien, se porta genial conmigo... no es el concepto de hombre que siempre he tenido."
    kat "Gosto muito dele, ele me trata muito bem... ele não é o tipo de homem que eu sempre tive."

# game/scripts/c19/c19.rpy:3267
translate brazilian c19s007_KateWithNor_27ec38d7:

    # kat "Aún no lo tengo calado. La mayoría de las veces no me cae bien, pero tengo que reconocer que no es el concepto de hombre que siempre he tenido."
    kat "Ainda não consegui decifrá-lo completamente. Na maioria das vezes, não gosto dele, mas tenho que admitir que ele não é o tipo de homem que sempre imaginei."

# game/scripts/c19/c19.rpy:3269
translate brazilian c19s007_KateWithNor_31a8b8f6:

    # nor "[mc] es cualquier cosa menos el hombre estándar. Creo que deberías hablar con él."
    nor "[mc] está longe de ser um cara comum. Acho que você deveria falar com ele."

# game/scripts/c19/c19.rpy:3272
translate brazilian c19s007_KateWithNor_310ac2ad:

    # kat "¿Para qué? Ya está contigo..."
    kat "Por que se preocupar? Já está aí com você..."

# game/scripts/c19/c19.rpy:3274
translate brazilian c19s007_KateWithNor_9a1afd46:

    # kat "Y estáis esperando un hijo..."
    kat "E você está esperando um filho..."

# game/scripts/c19/c19.rpy:3276
translate brazilian c19s007_KateWithNor_6bd23a69:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Ao menos para esclarecer as coisas que você tem na cabeça."

# game/scripts/c19/c19.rpy:3277
translate brazilian c19s007_KateWithNor_0e819036:

    # nor "No tienes que preocuparte por mí. No soy la dueña de [mc]."
    nor "Você não precisa se preocupar comigo. Eu não sou dono de [mc]."

# game/scripts/c19/c19.rpy:3278
translate brazilian c19s007_KateWithNor_784caf1e:

    # nor "Lo amo con locura, pero cuando empezamos a salir no me prometió exclusividad. Ni yo se la exigí."
    nor "Eu o amo perdidamente, mas quando começamos a namorar, ele não me prometeu exclusividade. Nem eu a exigi."

# game/scripts/c19/c19.rpy:3280
translate brazilian c19s007_KateWithNor_049737ee:

    # kat "¿Para qué? Ya está con alguien..."
    kat "Por que se incomodar? Ela já está com alguém..."

# game/scripts/c19/c19.rpy:3282
translate brazilian c19s007_KateWithNor_4f89fb2b:

    # kat "Y están esperando un hijo..."
    kat "E eles estão esperando um filho..."

# game/scripts/c19/c19.rpy:3284
translate brazilian c19s007_KateWithNor_6bd23a69_1:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Ao menos para esclarecer as coisas que você tem na cabeça."

# game/scripts/c19/c19.rpy:3285
translate brazilian c19s007_KateWithNor_fa3c4374:

    # nor "Si ves que puede haber alguna posibilidad para vosotros, deberías hablar con ella. Pero primero debes hablar con [mc]."
    nor "Se você vir alguma possibilidade para você, deve falar com ela. Mas primeiro você deve falar com [mc]."

# game/scripts/c19/c19.rpy:3287
translate brazilian c19s007_KateWithNor_831fb81a:

    # kat "¿Para qué? Ya tiene su harén... yo no pinto nada ahí."
    kat "Para quê? Ela já tem o harém dela... Não tenho nada a ver com isso."

# game/scripts/c19/c19.rpy:3289
translate brazilian c19s007_KateWithNor_442ac76c:

    # kat "Y tiene un hijo en camino..."
    kat "E ela está grávida..."

# game/scripts/c19/c19.rpy:3291
translate brazilian c19s007_KateWithNor_c202d563:

    # kat "Y tiene varios hijos en camino..."
    kat "E ela está grávida de vários outros filhos..."

# game/scripts/c19/c19.rpy:3293
translate brazilian c19s007_KateWithNor_6bd23a69_2:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Ao menos para esclarecer as coisas que você tem na cabeça."

# game/scripts/c19/c19.rpy:3294
translate brazilian c19s007_KateWithNor_d662d106:

    # nor "Si ves que puede haber alguna posibilidad para vosotros, quizás deberías hablar con el resto de las chicas."
    nor "Se você perceber que pode haver uma possibilidade para você, talvez devesse conversar com as outras garotas."

# game/scripts/c19/c19.rpy:3296
translate brazilian c19s007_KateWithNor_a1b63678:

    # nor "Yo no tendría ningún problema en que tú también estuvieras en el harén."
    nor "Eu não teria problema nenhum se você também estivesse no harém."

# game/scripts/c19/c19.rpy:3298
translate brazilian c19s007_KateWithNor_7f8e060b:

    # kat "¿Para qué? Si no está con nadie... debe ser porque no quiere, ¿no?"
    kat "Por que se incomodar? Se ela não está com ninguém... deve ser porque ela não quer, certo?"

# game/scripts/c19/c19.rpy:3300
translate brazilian c19s007_KateWithNor_6bd23a69_3:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Ao menos para esclarecer as coisas que você tem na cabeça."

# game/scripts/c19/c19.rpy:3301
translate brazilian c19s007_KateWithNor_92c9ac8e:

    # nor "No puedes saber si no está con nadie porque está esperando que alguien se decida a hablar."
    nor "Você não consegue saber se ela não está com ninguém porque está esperando que alguém tome a iniciativa de falar."

# game/scripts/c19/c19.rpy:3303
translate brazilian c19s007_KateWithNor_30dc9c53:

    # kat "Haces que todo suene tan lógico... pero es que, además, hay también una chica..."
    kat "Você faz tudo parecer tão lógico... mas, por outro lado, também tem uma garota..."

# game/scripts/c19/c19.rpy:3305
translate brazilian c19s007_KateWithNor_e69c73b1:

    # "Kate y [nor] hablan largo y tendido sobre las dudas que acucian a Kate y cómo encararlas."
    "Kate e [nor] conversam longamente sobre as dúvidas que afligem Kate e como lidar com elas."

# game/scripts/c19/c19.rpy:3307
translate brazilian c19s007_KateWithNor_ce50db7c:

    # "Se pasan el resto de la tarde hablando. Al menos hasta que un evento externo corte su conversación."
    "Eles passam o resto da tarde conversando. Pelo menos até que um evento externo interrompa a conversa."

# game/scripts/c19/c19.rpy:3394
translate brazilian c19s007_EileenLisa_908cfe8b:

    # mc "Hola, chicas. ¿Interrumpo algo?"
    mc "Oi, meninas. Estou interrompendo alguma coisa?"

# game/scripts/c19/c19.rpy:3395
translate brazilian c19s007_EileenLisa_2a1730b0:

    # eil "No, que va. Lisa me estaba pidiendo que me uniera al juego en el jacuzzi."
    eil "De jeito nenhum. A Lisa estava me convidando para participar da brincadeira na jacuzzi."

# game/scripts/c19/c19.rpy:3396
translate brazilian c19s007_EileenLisa_50790d46:

    # lis "Está siendo muy divertido."
    lis "Foi muito divertido."

# game/scripts/c19/c19.rpy:3397
translate brazilian c19s007_EileenLisa_d12ca1f4:

    # mc "¿A qué estáis jugando?"
    mc "Que jogo você está jogando?"

# game/scripts/c19/c19.rpy:3399
translate brazilian c19s007_EileenLisa_993cb0db:

    # lis "Es una cosa que se le ha ocurrido a Simone. Como hoy la cosa parece que iba de secretos..."
    lis "Foi uma ideia da Simone. Já que hoje parece ser o dia dos segredos..."

# game/scripts/c19/c19.rpy:3400
translate brazilian c19s007_EileenLisa_77a47938:

    # lis "Todas tenemos que contar un secreto y votamos por el más jugoso."
    lis "Todos nós temos que contar um segredo e votamos no mais interessante."

# game/scripts/c19/c19.rpy:3401
translate brazilian c19s007_EileenLisa_8df01667:

    # lis "La que ha contado el menos jugoso tiene que pagar prenda o se le encarga una tarea... y se pierde los secretos que se cuenten. Mi tarea es conseguir que Eileen se una a nosotras."
    lis "Quem contar o segredo menos interessante terá que pagar uma prenda ou receberá uma tarefa... e perderá todos os segredos que forem revelados. Minha tarefa é convencer a Eileen a se juntar a nós."

# game/scripts/c19/c19.rpy:3402
translate brazilian c19s007_EileenLisa_0e1655ae:

    # mc "Ahora entiendo por qué yo no estaba invitado. *Risa* ¿No os vais a quedar sin secretos?"
    mc "Agora entendi por que não fui convidado. *Risos* Você não vai ficar sem segredos?"

# game/scripts/c19/c19.rpy:3404
translate brazilian c19s007_EileenLisa_dc84da9d:

    # lis "Ahí está lo divertido del juego. En saber cuándo contar los secretos más jugosos y cuándo los menos."
    lis "Essa é a graça do jogo. Saber quando revelar os segredos mais interessantes e quando guardar os menos interessantes para si."

# game/scripts/c19/c19.rpy:3405
translate brazilian c19s007_EileenLisa_fc6145f9:

    # lis "Si has perdido tu top, puedes recuperarlo si tu secreto es el mejor."
    lis "Se você perdeu sua blusa, pode recuperá-la se o seu segredo for o melhor."

# game/scripts/c19/c19.rpy:3407
translate brazilian c19s007_EileenLisa_02d0754b:

    # eil "Si hubiera sabido antes a qué estaban jugando, me hubiera apuntado sin que me vinieran a buscar. *Risa*"
    eil "Se eu soubesse o que eles estavam tramando, teria me inscrito sem que precisassem vir me buscar. *Risos*"

# game/scripts/c19/c19.rpy:3408
translate brazilian c19s007_EileenLisa_f05287fa:

    # eil "Es una forma genial de conocernos más entre nosotras."
    eil "É uma ótima maneira de se conhecerem melhor."

# game/scripts/c19/c19.rpy:3409
translate brazilian c19s007_EileenLisa_1adb1d1b:

    # mc "Antes de que os vayáis, ¿puedo hablar un momento contigo, Eile?"
    mc "Antes de você ir, posso falar com você um instante, Eile?"

# game/scripts/c19/c19.rpy:3411
translate brazilian c19s007_EileenLisa_0875d8da:

    # lis "Os espero aquí sentada. No puedo volver con las manos vacías o volveré a perder mi top."
    lis "Vou esperar você aqui. Não posso voltar de mãos vazias ou perderei minha blusa de novo."

# game/scripts/c19/c19.rpy:3413
translate brazilian c19s007_EileenLisa_49f00a56:

    # mc "Solo serán dos minutos, no te preocupes."
    mc "Vai levar apenas dois minutos, não se preocupe."

# game/scripts/c19/c19.rpy:3416
translate brazilian c19s007_EileenLisa_0c6631c5:

    # eil "Dime, supongo que es sobre mi madre."
    eil "Diga-me, suponho que seja sobre minha mãe."

# game/scripts/c19/c19.rpy:3417
translate brazilian c19s007_EileenLisa_2b70e735:

    # eil "Os he visto antes, hablando."
    eil "Eu vi vocês dois conversando mais cedo."

# game/scripts/c19/c19.rpy:3418
translate brazilian c19s007_EileenLisa_d2517362:

    # mc "Sí, sigue empeñada en mudarse. Al menos ya no quiere volver a vuestra casa."
    mc "Sim, ela ainda está decidida a se mudar. Pelo menos ela não quer voltar para a sua casa."

# game/scripts/c19/c19.rpy:3419
translate brazilian c19s007_EileenLisa_3de2f27f:

    # mc "He conseguido que retrase la decisión. Al menos por unos días."
    mc "Consegui convencê-lo a adiar a decisão. Pelo menos por alguns dias."

# game/scripts/c19/c19.rpy:3421
translate brazilian c19s007_EileenLisa_45024033:

    # eil "Gracias, [mc]. No sé cómo lo has conseguido, pero gracias."
    eil "Obrigado, [mc]. Não sei como você fez isso, mas obrigado."

# game/scripts/c19/c19.rpy:3422
translate brazilian c19s007_EileenLisa_b1824f5d:

    # eil "Estar aquí le está haciendo mucho bien, e irnos ahora sería un error."
    eil "Estar aqui está lhe fazendo muito bem, e ir embora agora seria um erro."

# game/scripts/c19/c19.rpy:3423
translate brazilian c19s007_EileenLisa_1dd81765:

    # mc "Tengo una idea que podría resolverlo todo, pero tengo que atar unos cabos sueltos antes."
    mc "Tenho uma ideia que pode resolver tudo, mas preciso acertar alguns detalhes primeiro."

# game/scripts/c19/c19.rpy:3425
translate brazilian c19s007_EileenLisa_e3903992:

    # eil "¿Que nos mudemos con Tía Betty y Yaya Olivia?"
    eil "Será que deveríamos ir morar com a tia Betty e a vovó Olivia?"

# game/scripts/c19/c19.rpy:3426
translate brazilian c19s007_EileenLisa_bb0db76e:

    # mc "¿Yaya Olivia? ¡Eso es nuevo!"
    mc "Vovó Olivia? Essa é nova!"

# game/scripts/c19/c19.rpy:3428
translate brazilian c19s007_EileenLisa_c6640cbb:

    # eil "*Risa* Sí. Lexi ha empezado a llamarla así. Yaya es abuela en español, creo. Pienso que se le va a quedar el nombre."
    eil "*Risos* Sim. A Lexi começou a chamá-la assim. Yaya significa avó em espanhol, eu acho. Acho que o apelido vai pegar."

# game/scripts/c19/c19.rpy:3429
translate brazilian c19s007_EileenLisa_dfee4cac:

    # mc "¡Es genial! Eso muestra que el cariño en esta familia va en todos los sentidos."
    mc "Que ótimo! Isso mostra que o amor nessa família é incondicional."

# game/scripts/c19/c19.rpy:3430
translate brazilian c19s007_EileenLisa_c842883c:

    # mc "Meemaw se ha emocionado mucho con todos los abrazos."
    mc "A vovó ficou muito emocionada com todos os abraços."

# game/scripts/c19/c19.rpy:3432
translate brazilian c19s007_EileenLisa_11853e29:

    # eil "Claro que va en todos los sentidos. Todas nos hemos sentido aliviadas cuando ha unido las palabras cáncer y limpia."
    eil "É claro que funciona nos dois sentidos. Todos nós nos sentimos aliviados quando ela juntou as palavras câncer e limpeza."

# game/scripts/c19/c19.rpy:3433
translate brazilian c19s007_EileenLisa_81bfafc9:

    # eil "Pero a lo que íbamos. ¿Esa ha sido tu idea? ¿Que nos mudemos con ellas?"
    eil "Mas voltando ao assunto. Foi ideia sua? Que fôssemos morar com eles?"

# game/scripts/c19/c19.rpy:3434
translate brazilian c19s007_EileenLisa_10287fce:

    # mc "Sí, sería bueno que hablarais sobre ello."
    mc "Sim, seria bom se você falasse sobre isso."

# game/scripts/c19/c19.rpy:3436
translate brazilian c19s007_EileenLisa_ec47dea0:

    # eil "A mí también se me había ocurrido y quería hablar con ellas un día de estos. Pagarles un alquiler o algo por una habitación."
    eil "Eu também tinha pensado nisso e queria falar com eles um dia desses. Pagar aluguel ou algo assim por um quarto."

# game/scripts/c19/c19.rpy:3437
translate brazilian c19s007_EileenLisa_7c3629ba:

    # eil "Por alguna razón mi madre no quiere seguir viviendo aquí. Posiblemente con Olivia y Tía Betty le parezca mejor."
    eil "Por algum motivo, minha mãe não quer mais morar aqui. Talvez ela se adaptasse melhor com a Olivia e a tia Betty."

# game/scripts/c19/c19.rpy:3438
translate brazilian c19s007_EileenLisa_df887235:

    # mc "Las grandes mentes piensan igual. *Risa* Y te has olvidado lo de Yaya..."
    mc "Grandes mentes pensam igual. *Risos* E você se esqueceu da Yaya..."

# game/scripts/c19/c19.rpy:3440
translate brazilian c19s007_EileenLisa_db479b5b:

    # mc "Pero hay otra cosa..."
    mc "Mas há algo mais..."

# game/scripts/c19/c19.rpy:3442
translate brazilian c19s007_EileenLisa_158d3825:

    # eil "Me das miedo cuando lo dices así. ¿Qué ha pasado?"
    eil "Você me assusta quando fala assim. O que aconteceu?"

# game/scripts/c19/c19.rpy:3445
translate brazilian c19s007_EileenLisa_ffc1d4b8:

    # mc "Ya has visto que sólo estoy contigo..."
    mc "Você já viu que estou apenas com você..."

# game/scripts/c19/c19.rpy:3447
translate brazilian c19s007_EileenLisa_4490f0cd:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3448
translate brazilian c19s007_EileenLisa_5bbf18c6:

    # mc "Pero aquel día, en el bosque, hablaste de un harén, y de ser la Primera Concubina..."
    mc "Mas naquele dia, na floresta, você falou de um harém e de ser a Primeira Concubina..."

# game/scripts/c19/c19.rpy:3449
translate brazilian c19s007_EileenLisa_4490f0cd_1:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3451
translate brazilian c19s007_EileenLisa_97804d23:

    # mc "Ahora ya sabes quién forma parte del harén..."
    mc "Agora você sabe quem faz parte do harém..."

# game/scripts/c19/c19.rpy:3453
translate brazilian c19s007_EileenLisa_4490f0cd_2:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3454
translate brazilian c19s007_EileenLisa_c3027cf4:

    # mc "Recuerdo aquel día, en el bosque, cuando hablaste de ser la Primera Concubina..."
    mc "Lembro-me daquele dia na floresta quando você falou em ser a Primeira Concubina..."

# game/scripts/c19/c19.rpy:3455
translate brazilian c19s007_EileenLisa_4490f0cd_3:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3457
translate brazilian c19s007_EileenLisa_8b0c7515:

    # mc "Tú y yo fuimos felices en el instituto..."
    mc "Você e eu éramos felizes no ensino médio..."

# game/scripts/c19/c19.rpy:3459
translate brazilian c19s007_EileenLisa_4490f0cd_4:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3460
translate brazilian c19s007_EileenLisa_c8f95a2b:

    # mc "Y, cuando rompimos, prometimos no inmiscuirnos en las futuras relaciones del otro..."
    mc "E quando terminamos, prometemos não interferir nos relacionamentos futuros um do outro..."

# game/scripts/c19/c19.rpy:3461
translate brazilian c19s007_EileenLisa_4490f0cd_5:

    # eil "Sí..."
    eil "Sim..."

# game/scripts/c19/c19.rpy:3462
translate brazilian c19s007_EileenLisa_1c83c84a:

    # mc "Creo que deberías hablar con Kiara sobre ello."
    mc "Acho que você deveria conversar com a Kiara sobre isso."

# game/scripts/c19/c19.rpy:3464
translate brazilian c19s007_EileenLisa_4f31b07d:

    # eil "¿Qué? ¿Tú y mi madre?"
    eil "O quê? Você e minha mãe?"

# game/scripts/c19/c19.rpy:3465
translate brazilian c19s007_EileenLisa_67858e4c:

    # mc "No, no estamos juntos, no te preocupes."
    mc "Não, não estamos juntos, não se preocupe."

# game/scripts/c19/c19.rpy:3467
translate brazilian c19s007_EileenLisa_3ecc353d:

    # eil "No entiendo de qué quieres que hable con ella, entonces."
    eil "Então não entendo sobre o que você quer que eu converse com ela."

# game/scripts/c19/c19.rpy:3468
translate brazilian c19s007_EileenLisa_a4aaae33:

    # mc "De cual sería tu posición si lo estuviéramos."
    mc "Qual seria a sua posição se estivéssemos lá?"

# game/scripts/c19/c19.rpy:3470
translate brazilian c19s007_EileenLisa_f5c04f5d:

    # eil "¿Me estás pidiendo permiso para salir con mi madre? *Risa* ¿No solía ser al revés?"
    eil "Você está me pedindo permissão para sair com a minha mãe? *Risos* Não era normalmente o contrário?"

# game/scripts/c19/c19.rpy:3471
translate brazilian c19s007_EileenLisa_e6a598c7:

    # mc "En cierto modo, sí. También te estoy pidiendo que hables con ella para despejar sus dudas sobre cómo te sentirías si lo hiciéramos."
    mc "De certa forma, sim. Também estou pedindo que você converse com ela para esclarecer quaisquer dúvidas que ela possa ter sobre como você se sentiria se fizéssemos isso."

# game/scripts/c19/c19.rpy:3473
translate brazilian c19s007_EileenLisa_db29dff9:

    # eil "Sabes que va a ser rarísimo tener esa conversación, ¿verdad?"
    eil "Você sabe que vai ser muito estranho ter essa conversa, né?"

# game/scripts/c19/c19.rpy:3474
translate brazilian c19s007_EileenLisa_19622137:

    # mc "Me lo imagino, pero a ella le preocupa."
    mc "Posso imaginar, mas isso a preocupa."

# game/scripts/c19/c19.rpy:3476
translate brazilian c19s007_EileenLisa_466d2f0a:

    # mc "Le preocupa como te sentirías si ella y yo empezáramos algo teniendo en cuenta que tú y yo no hemos vuelto."
    mc "Ela está preocupada com o que você acharia se nós duas começássemos algo, considerando que nós duas não reatamos."

# game/scripts/c19/c19.rpy:3478
translate brazilian c19s007_EileenLisa_49d206e0:

    # mc "Le preocupa que la percibas como \"la otra\". Cómo te sentirías si saliera con las dos."
    mc "Ela tem medo de que você a veja como \"a outra\". Como você se sentiria se ela namorasse vocês dois?"

# game/scripts/c19/c19.rpy:3480
translate brazilian c19s007_EileenLisa_a6b63113:

    # mc "Le preocupa tener que compartir harén contigo."
    mc "Ele está preocupado em ter que dividir um harém com você."

# game/scripts/c19/c19.rpy:3483
translate brazilian c19s007_EileenLisa_24380e09:

    # eil "¡Joder! ¡A mí también me preocuparía! ¡Compartir hombre con mi madre no es normal!"
    eil "Puxa! Eu também ficaria preocupada! Dividir um homem com a minha mãe não é normal!"

# game/scripts/c19/c19.rpy:3485
translate brazilian c19s007_EileenLisa_2d8661b4:

    # eil "¡Joder! ¡A mí también me preocuparía! ¡Primero sales con la hija y después con la madre!"
    eil "Puxa! Eu também ficaria preocupado! Primeiro você sai com a filha e depois com a mãe!"

# game/scripts/c19/c19.rpy:3505
translate brazilian c19s007_EileenLisa_cdba0774:

    # eil "Aunque no seamos la primera pareja madre e hija con la que estás."
    eil "Embora não sejamos a primeira dupla mãe-filha com quem você já esteve."

# game/scripts/c19/c19.rpy:3509
translate brazilian c19s007_EileenLisa_904c6474:

    # eil "Sólo te quedarían Olivia y [nor], y Olivia y [mar]."
    eil "Você só teria Olivia e [nor] restantes, e Olivia e [mar]."

# game/scripts/c19/c19.rpy:3511
translate brazilian c19s007_EileenLisa_857de542:

    # eil "Y con las hijas ya estás... te faltaría añadir a Olivia al harén."
    eil "E com as filhas você está pronto... só precisa adicionar Olivia ao harém."

# game/scripts/c19/c19.rpy:3513
translate brazilian c19s007_EileenLisa_d6210b7a:

    # eil "Sólo te quedarían Olivia y [nor]."
    eil "Você só teria Olivia e [nor] restantes."

# game/scripts/c19/c19.rpy:3515
translate brazilian c19s007_EileenLisa_67eeb0bb:

    # eil "Y con [nor] ya estás... te faltaría añadir a Olivia al harén."
    eil "E com [nor] você está pronto... você só precisa adicionar Olivia ao harém."

# game/scripts/c19/c19.rpy:3518
translate brazilian c19s007_EileenLisa_b02930f2:

    # eil "Esto es muy raro, [mc]."
    eil "Isso é muito estranho, [mc]."

# game/scripts/c19/c19.rpy:3519
translate brazilian c19s007_EileenLisa_d59729c7:

    # mc "Lo es. Pero hablarás con ella, ¿verdad?"
    mc "É sim. Mas você vai falar com ela, certo?"

# game/scripts/c19/c19.rpy:3521
translate brazilian c19s007_EileenLisa_514b4fed:

    # eil "¡Claro que hablaré con ella! Es raro, pero también creo que puedes ser muy bueno para ella."
    eil "Claro que vou falar com ela! É estranho, mas também acho que você pode ser muito bom para ela."

# game/scripts/c19/c19.rpy:3522
translate brazilian c19s007_EileenLisa_d4843377:

    # eil "Y ella para ti. Por raro que parezca. Aunque no va a ser una conversación fácil. Me pones en una situación complicada."
    eil "E ela está do seu lado. Por mais estranho que pareça. Embora não vá ser uma conversa fácil. Você está me colocando numa posição difícil."

# game/scripts/c19/c19.rpy:3523
translate brazilian c19s007_EileenLisa_f1898c0c:

    # mc "Gracias, Eileen. ¿Realmente no te importa? Lo último que querría es que te sientas incómoda."
    mc "Obrigada, Eileen. Você realmente não se importa? A última coisa que eu gostaria é que você se sentisse desconfortável."

# game/scripts/c19/c19.rpy:3525
translate brazilian c19s007_EileenLisa_b0c40e9e:

    # eil "Después de todo lo que hemos pasado juntos, ¿aún dudas de si te voy a ayudar a salir con mi madre?"
    eil "Depois de tudo que passamos juntos, você ainda duvida que eu vá te ajudar a namorar minha mãe?"

# game/scripts/c19/c19.rpy:3526
translate brazilian c19s007_EileenLisa_99ae5a34:

    # eil "Hace unos días me hubiera hecho sentir incómoda, como bien dices, pero ya no. Ahora entiendo muchas cosas sobre cómo se siente mi madre."
    eil "Há alguns dias, isso teria me deixado desconfortável, como você bem disse, mas não mais. Agora entendo muitas coisas sobre como minha mãe se sente."

# game/scripts/c19/c19.rpy:3528
translate brazilian c19s007_EileenLisa_9a85e76e:

    # eil "No sé si se dice así o no, pero tenéis mi bendición. *Risa*"
    eil "Não sei se essa é a melhor maneira de dizer, mas você tem a minha bênção. *Risos*"

# game/scripts/c19/c19.rpy:3529
translate brazilian c19s007_EileenLisa_43ce655b:

    # mc "*Risa* Creo que ya no se usa esa frase, pero gracias."
    mc "*Risos* Acho que essa expressão não é mais usada, mas obrigada."

# game/scripts/c19/c19.rpy:3531
translate brazilian c19s007_EileenLisa_dcd90d58:

    # eil "¿Sabes dónde está?"
    eil "Você sabe onde fica?"

# game/scripts/c19/c19.rpy:3532
translate brazilian c19s007_EileenLisa_6132fad6:

    # mc "En el jacuzzi. Maddie la ha venido a buscar para que se uniera al juego hace un rato."
    mc "Na jacuzzi. A Maddie veio buscá-la para participar do jogo há pouco tempo."

# game/scripts/c19/c19.rpy:3534
translate brazilian c19s007_EileenLisa_32de6297:

    # eil "Entonces voy a ir al jacuzzi antes de que Lisa empiece a morderse las uñas."
    eil "Depois vou para a jacuzzi antes que a Lisa comece a roer as unhas."

# game/scripts/c19/c19.rpy:3535
translate brazilian c19s007_EileenLisa_523c95b6:

    # eil "A ver si tengo oportunidad de hablar con ella antes de que acabe la fiesta. Si no, hablaré con ella esta noche."
    eil "Vou ver se consigo falar com ela antes que a festa termine. Se não, falo com ela hoje à noite."

# game/scripts/c19/c19.rpy:3538
translate brazilian c19s007_EileenLisa_927ad361:

    # eil "Si no hay nada más, voy a ir al jacuzzi antes de que Lisa empiece a morderse las uñas."
    eil "Se nada mais acontecer, vou para a jacuzzi antes que a Lisa comece a roer as unhas."

# game/scripts/c19/c19.rpy:3539
translate brazilian c19s007_EileenLisa_108cf442:

    # mc "De acuerdo, Eileen. Hablamos luego."
    mc "Certo, Eileen. Conversamos mais tarde."

# game/scripts/c19/c19.rpy:3541
translate brazilian c19s007_EileenLisa_da96b6bb:

    # "Las dos chicas se dirigen al jacuzzi, Lisa visiblemente con prisa."
    "As duas garotas se dirigem para a jacuzzi, Lisa visivelmente com pressa."

# game/scripts/c19/c19.rpy:3542
translate brazilian c19s007_EileenLisa_242c54f4:

    # mcp "(¿Tiene la tarea un tiempo establecido para cumplirla?)"
    mcp "(A tarefa tem um prazo limite para ser concluída?)"

# game/scripts/c19/c19.rpy:3543
translate brazilian c19s007_EileenLisa_7940a77b:

    # "Ves que Megan se acerca a ti. ¿Es un plato de galletas y un vaso de leche lo que lleva en las manos?"
    "Você vê Megan se aproximando. Será que ela está carregando um prato de biscoitos e um copo de leite?"

# game/scripts/c19/c19.rpy:3586
translate brazilian c19s007_MeganJamaal_06a72514:

    # "Mientras tanto, al otro lado de la casa..."
    "Entretanto, do outro lado da casa..."

# game/scripts/c19/c19.rpy:3588
translate brazilian c19s007_MeganJamaal_0b398993:

    # mc "¿Te has quedado con hambre, Megan? No podrás quejarte si no entras en el vestido esta noche."
    mc "Você ainda está com fome, Megan? Não pode reclamar se o vestido não te servir hoje à noite."

# game/scripts/c19/c19.rpy:3589
translate brazilian c19s007_MeganJamaal_fd0c7fb7:

    # meg "*Risa* No es para mí, es para Jamaal. Me ha pedido que le trajera algo para merendar."
    meg "*Risos* Não é para mim, é para o Jamaal. Ele me pediu para trazer um lanche para ele."

# game/scripts/c19/c19.rpy:3590
translate brazilian c19s007_MeganJamaal_03d26645:

    # mc "¡Maldito tragón! *Risa* ¿Dónde está? Déjame ayudarte."
    mc "Maldito glutão! *Risos* Onde ele está? Deixe-me ajudá-lo."

# game/scripts/c19/c19.rpy:3592
translate brazilian c19s007_MeganJamaal_86645f15:

    # meg "Ha aparcado detrás de casa. *Risa* Toma la leche, mi pulso no es el mejor"
    meg "Ele estacionou atrás da casa. *Risos* Beba um pouco de leite, meu pulso não está dos melhores."

# game/scripts/c19/c19.rpy:3593
translate brazilian c19s007_MeganJamaal_28ba74d4:

    # meg "No sé cómo he llegado hasta aquí sin derramar nada."
    meg "Não sei como cheguei aqui sem derramar nada."

# game/scripts/c19/c19.rpy:3594
translate brazilian c19s007_MeganJamaal_63cd8ebd:

    # mc "Vamos."
    mc "Vamos."

# game/scripts/c19/c19.rpy:3596
translate brazilian c19s007_MeganJamaal_19e4cdeb:

    # "Por fin descubres dónde está la silla que faltaba. Jamaal es más culpable de lo que Olivia pensaba."
    "Você finalmente descobre onde está a cadeira desaparecida. Jamaal é mais culpado do que Olivia imaginava."

# game/scripts/c19/c19.rpy:3597
translate brazilian c19s007_MeganJamaal_9efdb09b:

    # mc "He oído que alguien insaciable había pedido comida por aquí. Tragón."
    mc "Ouvi dizer que alguém com um apetite insaciável pediu comida daqui. Glutão."

# game/scripts/c19/c19.rpy:3598
translate brazilian c19s007_MeganJamaal_a96131b7:

    # jam "¡Hey! No he comido demasiado durante la comida. ¡No he repetido de ninguno de los tres pasteles!"
    jam "Ei! Eu não comi muito no almoço. Não repeti nenhum dos três bolos!"

# game/scripts/c19/c19.rpy:3599
translate brazilian c19s007_MeganJamaal_a4be2fb1:

    # mc "Creo que voy a dejar de meterme contigo por hoy. Aunque sólo sea para agradecerte lo que has intentado hacer con el mensaje."
    mc "Acho que vou parar de te incomodar por hoje. Nem que seja só para te agradecer pelo que você tentou fazer com a mensagem."

# game/scripts/c19/c19.rpy:3601
translate brazilian c19s007_MeganJamaal_3c3d3bb0:

    # jam "No lo he hecho por ti. *Risa* Creía que era de alguna de las chicas."
    jam "Eu não fiz isso por você. *Risos* Achei que fosse de uma das meninas."

# game/scripts/c19/c19.rpy:3602
translate brazilian c19s007_MeganJamaal_a3f6d506:

    # jam "No de mi madre o de mi hermana, las dos estuvieron en casa ayer."
    jam "Não foi da minha mãe nem da minha irmã, ambas estavam em casa ontem."

# game/scripts/c19/c19.rpy:3605
translate brazilian c19s007_MeganJamaal_6620eaab:

    # jam "Aunque sospechara que tenías algo con mi madre, ha sido una grata sorpresa confirmarlo, padrastro."
    jam "Embora eu suspeitasse que você tivesse um caso com a minha mãe, foi uma grata surpresa confirmar isso, padrasto."

# game/scripts/c19/c19.rpy:3607
translate brazilian c19s007_MeganJamaal_964befa8:

    # jam "Además nunca sospeché que estuvieras con mi madre."
    jam "Além disso, eu nunca suspeitei que você estivesse com a minha mãe."

# game/scripts/c19/c19.rpy:3610
translate brazilian c19s007_MeganJamaal_bfa91bda:

    # jam "Y lo de Simone no ha llegado ni a sorpresa. Desde aquel día en el café me olía algo."
    jam "E o que aconteceu com a Simone nem foi uma surpresa. Eu já tinha a sensação de que algo estava acontecendo naquele dia no café."

# game/scripts/c19/c19.rpy:3612
translate brazilian c19s007_MeganJamaal_da426c82:

    # jam "Y Simone me ha dado un poquito de pena. Siempre le has gustado..."
    jam "E eu fiquei com um pouco de pena da Simone. Ela sempre gostou de você..."

# game/scripts/c19/c19.rpy:3614
translate brazilian c19s007_MeganJamaal_45cbceeb:

    # jam "Y si estabas con alguna de las otras chicas, había que protegerlas, ¿no?"
    jam "E se você estivesse com alguma das outras garotas, você tinha que protegê-las, certo?"

# game/scripts/c19/c19.rpy:3617
translate brazilian c19s007_MeganJamaal_135d8630:

    # meg "Yo te lo agradezco. Si el mensaje lo hubiera enviado yo, me hubiera muerto de vergüenza mientras lo leía Samantha."
    meg "Obrigada. Se eu tivesse enviado a mensagem, teria morrido de vergonha enquanto Samantha a estivesse lendo."

# game/scripts/c19/c19.rpy:3618
translate brazilian c19s007_MeganJamaal_d26ebeda:

    # meg "Aunque nunca hubiera mandado un mensaje como ese. Has actuado como un buen amigo."
    meg "Embora eu jamais tivesse enviado uma mensagem assim, você agiu como um bom amigo."

# game/scripts/c19/c19.rpy:3620
translate brazilian c19s007_MeganJamaal_974e0a19:

    # meg "Dudo que ninguna de las chicas de la familia enviara un mensaje como ese, pero has actuado como un buen amigo."
    meg "Duvido que alguma das meninas da família mandaria uma mensagem dessas, mas você agiu como uma boa amiga."

# game/scripts/c19/c19.rpy:3622
translate brazilian c19s007_MeganJamaal_9f1d7bd0:

    # meg "Hubieras quedado mejor si Tía Betty no hubiera intentado lo mismo que tú, claro. *Risa*"
    meg "Você teria se saído melhor se a tia Betty não tivesse tentado a mesma coisa que você, é claro. *Risos*"

