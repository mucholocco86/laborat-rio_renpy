    # "Todo el mundo está contento de que Meemaw y Betty no vuelvan a Florida."
    "Todos estão felizes que a vovó e a Betty não vão voltar para a Flórida."

# game/scripts/c19/c19.rpy:1911
translate brazilian c19s004_Meemaw_fb7020b1:

    # "Bueno... parece que todo el mundo no..."
    "Bem... parece que nem todos..."

# game/scripts/c19/c19.rpy:1912
translate brazilian c19s004_Meemaw_43d1e735:

    # "Decides acercarte a Betty. Quería hablar contigo. ¿Será de esto? Pero Meemaw no se lo había comentado aún..."
    "Você decide abordar Betty. Ela queria conversar com você. Será que é sobre isso? Mas a vovó ainda não tinha mencionado nada para ela..."

# game/scripts/c19/c19.rpy:1934
translate brazilian c19s004_Betty_b47e88b5:

    # mc "Gracias por lo de antes, Tía Betty."
    mc "Obrigada por mais cedo, tia Betty."

# game/scripts/c19/c19.rpy:1935
translate brazilian c19s004_Betty_ac0dfc98:

    # bet "No sé a lo que te refieres... yo no he hecho nada."
    bet "Não sei o que você quer dizer... Eu não fiz nada."

# game/scripts/c19/c19.rpy:1936
translate brazilian c19s004_Betty_b3d82627:

    # mc "Bueno, pues gracias por NO intentar cubrirme cuando ha pasado lo del mensaje."
    mc "Bom, obrigado por NÃO tentar me acobertar quando o incidente com a mensagem aconteceu."

# game/scripts/c19/c19.rpy:1938
translate brazilian c19s004_Betty_8f36a777:

    # bet "Ya te digo que no he hecho nada que no hubiera hecho cualquier tía abuela por su sobrino nieto favorito."
    bet "Eu digo a vocês, não fiz nada que qualquer tia-avó não faria por seu sobrinho-neto favorito."

# game/scripts/c19/c19.rpy:1939
translate brazilian c19s004_Betty_e359f8d2:

    # mc "¿Ha pasado algo, Tía Betty? Te veo... ¿triste?"
    mc "Aconteceu alguma coisa, tia Betty? Você parece... triste?"

# game/scripts/c19/c19.rpy:1942
translate brazilian c19s004_Betty_41d79523:

    # bet "Felicidades por haber salido a la luz con tus chicas, aunque no hayas tenido mucho que ver."
    bet "Parabéns por ter saído com suas amigas, mesmo que você não tenha tido muita participação nisso."

# game/scripts/c19/c19.rpy:1944
translate brazilian c19s004_Betty_c8e94463:

    # bet "Felicidades por haber salido a la luz, aunque no hayas tenido mucho que ver."
    bet "Parabéns por ter vindo à tona, mesmo que você não tenha tido muita participação nisso."

# game/scripts/c19/c19.rpy:1946
translate brazilian c19s004_Betty_cd4ae234:

    # bet "Excepto tu pequeño asentimiento antes de la revelación. Creo que le ha pasado desapercibido a la mayoría."
    bet "Com exceção daquela pequena menção que você fez antes da revelação. Acho que a maioria das pessoas não percebeu."

# game/scripts/c19/c19.rpy:1948
translate brazilian c19s004_Betty_113c75fb:

    # bet "Y felicidades por tu futura paternidad."
    bet "E parabéns pela sua futura paternidade."

# game/scripts/c19/c19.rpy:1949
translate brazilian c19s004_Betty_abe924e8:

    # mc "Gracias, pero..."
    mc "Obrigado, mas..."

# game/scripts/c19/c19.rpy:1950
translate brazilian c19s004_Betty_a5f7e8c3:

    # mc "No parece que te alegres demasiado. Y no has respondido a mi pregunta."
    mc "Você não parece muito feliz. E você não respondeu à minha pergunta."

# game/scripts/c19/c19.rpy:1952
translate brazilian c19s004_Betty_5a2702bf:

    # bet "No es eso... es que la sobredosis de noticias me ha dejado un poco anonadada."
    bet "Não é isso... é só que a sobrecarga de notícias me deixou um pouco atordoado."

# game/scripts/c19/c19.rpy:1955
translate brazilian c19s004_Betty_d7480c8d:

    # bet "Has tenido suerte que la revelación de Olivia haya desviado la atención sobre la tuya."
    bet "Você tem sorte de a revelação de Olivia ter desviado o foco de você."

# game/scripts/c19/c19.rpy:1957
translate brazilian c19s004_Betty_00031a46:

    # bet "Podrías haberte encontrado con un problema con las noticias simultáneas y con las chicas a las que les gustaría poder dar una noticia similar y a las que no has hecho mucho caso."
    bet "Você pode ter se deparado com um problema relacionado a notícias simultâneas e com as garotas que gostariam de poder dar notícias semelhantes, e com aquelas às quais você não tem dado muita atenção."

# game/scripts/c19/c19.rpy:1958
translate brazilian c19s004_Betty_ba092666:

    # mc "Si te refieres a Kiara, aún no hemos tenido la oportunidad de hablar..."
    mc "Se você está se referindo à Kiara, ainda não tivemos a oportunidade de conversar..."

# game/scripts/c19/c19.rpy:1960
translate brazilian c19s004_Betty_4357113e:

    # bet "No solo a Kiara, cielo... Ver a toda la familia aquí, y ver cómo te miraban las que no tenían noticias que dar sobre ti..."
    bet "Não só a Kiara, querida... Ver toda a família aqui, e ver como aqueles que não tinham notícias suas olharam para você..."

# game/scripts/c19/c19.rpy:1961
translate brazilian c19s004_Betty_86582942:

    # bet "Alguna parecía querer estar en posición de poder darla."
    bet "Alguns pareciam querer estar em posição de oferecê-lo."

# game/scripts/c19/c19.rpy:1962
translate brazilian c19s004_Betty_b3ca2984:

    # mc "Tú tampoco tenías ninguna noticia que dar sobre mí. *Risa* ¿También te hubiera gustado?"
    mc "Você também não tinha nenhuma notícia sobre mim. *Risos* Você também gostaria disso?"

# game/scripts/c19/c19.rpy:1964
translate brazilian c19s004_Betty_0cc2f8c2:

    # bet "No apliques mi psicología contra mí. *Risa triste*"
    bet "Não use minha psicologia contra mim. *Risada triste*"

# game/scripts/c19/c19.rpy:1965
translate brazilian c19s004_Betty_27aff9ed:

    # bet "Hoy han salido a la luz noticias importantes que una vieja monja nunca podrá igualar."
    bet "Hoje, veio à tona uma notícia importante que nenhuma freira idosa jamais conseguirá igualar."

# game/scripts/c19/c19.rpy:1966
translate brazilian c19s004_Betty_ef8b341d:

    # mc "No es una competición para ver quién da la noticia más grande."
    mc "Não se trata de uma competição para ver quem divulga a notícia mais importante."

# game/scripts/c19/c19.rpy:1967
translate brazilian c19s004_Betty_b811fab2:

    # mc "Por raro que parezca, me parece más importante la noticia de Meemaw. Que quiera confiar en todos nosotros y la mudanza. Creo que la mudanza te ha sorprendido incluso a ti."
    mc "Por mais estranho que pareça, acho que a notícia da vovó é mais importante. O fato de ela querer confiar em todos nós, e a mudança. Acho que a mudança até te surpreendeu."

# game/scripts/c19/c19.rpy:1969
translate brazilian c19s004_Betty_97daa0f6:

    # mc "La mudanza y el cáncer. Creo que la mudanza te ha sorprendido incluso a ti."
    mc "A mudança e o câncer. Acho que a mudança surpreendeu até você."

# game/scripts/c19/c19.rpy:1971
translate brazilian c19s004_Betty_9e0f4c0b:

    # bet "Un poco..."
    bet "Um pouco..."

# game/scripts/c19/c19.rpy:1972
translate brazilian c19s004_Betty_5c402a64:

    # mcp "(Obviamente le pasa algo de lo que no quiere hablar tan cerca del resto.)"
    mcp "(Obviamente, há algo errado com ela que ela não quer comentar na frente de todos."

# game/scripts/c19/c19.rpy:1973
translate brazilian c19s004_Betty_37998e47:

    # mc "Antes has dicho que querías hablar conmigo. ¿Te parece un buen momento?"
    mc "Você disse antes que queria falar comigo. Parece um bom momento para isso?"

# game/scripts/c19/c19.rpy:1974
translate brazilian c19s004_Betty_aa288525:

    # bet "Sí, pero... ¿podemos ir a sentarnos?"
    bet "Sim, mas... podemos ir nos sentar?"

# game/scripts/c19/c19.rpy:1975
translate brazilian c19s004_Betty_890c041b:

    # mc "Por supuesto."
    mc "Claro."

# game/scripts/c19/c19.rpy:1977
translate brazilian c19s004_Betty_0fc7d311:

    # mc "Dime, ¿de qué querías hablar?"
    mc "Diga-me, sobre o que você queria conversar?"

# game/scripts/c19/c19.rpy:1978
translate brazilian c19s004_Betty_8ecb9d01:

    # bet "Desde que te lo he dicho han cambiado tanto las cosas..."
    bet "Muita coisa mudou desde que eu te contei..."

# game/scripts/c19/c19.rpy:1979
translate brazilian c19s004_Betty_82a2fe7f:

    # bet "Esta mañana he ido a misa... con el coche de [nor]."
    bet "Esta manhã fui à missa... no carro [nor]."

# game/scripts/c19/c19.rpy:1980
translate brazilian c19s004_Betty_24821487:

    # mc "Muy valiente por tu parte. *Risa*"
    mc "Isso é muita coragem da sua parte. *Risos*"

# game/scripts/c19/c19.rpy:1982
translate brazilian c19s004_Betty_8cf0bafc:

    # bet "*Risa triste* Sí... es más viejo aún que yo... o al menos tiene más achaques..."
    bet "*Risada triste* Sim... ele é ainda mais velho do que eu... ou pelo menos tem mais problemas de saúde..."

# game/scripts/c19/c19.rpy:1983
translate brazilian c19s004_Betty_8850bccf:

    # mc "No eres vieja, Tía Betty... digamos que eres vintage. *Risa* Pero aún estás muy bien... de salud, me refiero."
    mc "Você não é velha, tia Betty... digamos que você é vintage. *Risos* Mas você ainda está muito bem... em termos de saúde, quero dizer."

# game/scripts/c19/c19.rpy:1985
translate brazilian c19s004_Betty_18c81b3f:

    # bet "Bueno... hoy me he saltado un Stop al volver de misa. No ha pasado nada grave, excepto que me ha parado la policía."
    bet "Bem... hoje eu passei um sinal de pare quando voltava da missa. Não aconteceu nada de grave, só que a polícia me parou."

# game/scripts/c19/c19.rpy:1986
translate brazilian c19s004_Betty_91c7642d:

    # mc "¿Estás así por una multa? No pasa nada. A Mamá le ponen como mínimo una al mes."
    mc "Você está chateado com uma multa? Tudo bem. Sua mãe recebe pelo menos uma por mês."

# game/scripts/c19/c19.rpy:1988
translate brazilian c19s004_Betty_a061466f:

    # bet "No es por la multa... cuando el agente me ha pedido la documentación... mi permiso de conducir está caducado desde hace más de un año."
    bet "Não se trata da multa... quando o policial me pediu meus documentos... minha carteira de motorista estava vencida há mais de um ano."

# game/scripts/c19/c19.rpy:1989
translate brazilian c19s004_Betty_ac67df24:

    # bet "Ni me había dado cuenta de cuándo caducaba."
    bet "Nem sequer tinha reparado quando expirou."

# game/scripts/c19/c19.rpy:1990
translate brazilian c19s004_Betty_c73045ad:

    # bet "El agente ha sido muy amable y me ha dejado volver a casa conduciendo, pero voy a tener que hacer unas gestiones en la DMV para renovar la licencia."
    bet "O policial foi muito gentil e me deixou dirigir até em casa, mas terei que fazer alguns trâmites no Detran para renovar minha carteira de habilitação."

# game/scripts/c19/c19.rpy:1991
translate brazilian c19s004_Betty_2f2a790c:

    # mc "Y quieres que te lleve a renovarla, no hay ningún problema."
    mc "E se você quiser que eu a leve para renová-lo, não há problema."

# game/scripts/c19/c19.rpy:1993
translate brazilian c19s004_Betty_f5c29cf4:

    # bet "No hace falta. Me ha dicho que lo puedo hacer online, pero no voy a poder conducir hasta que llegue el nuevo permiso."
    bet "Não precisa. Ele me disse que posso fazer online, mas não poderei dirigir até que a nova carteira de habilitação chegue."

# game/scripts/c19/c19.rpy:1994
translate brazilian c19s004_Betty_f8be02d5:

    # bet "Y aquí es donde se pone raro. Te iba a pedir que me llevases a Monterey antes de saber lo que le habías regalado a [emm]."
    bet "E é aqui que a coisa fica estranha. Eu ia te pedir para me levar a Monterey antes de descobrir o que você tinha me dado [emm]."

# game/scripts/c19/c19.rpy:1995
translate brazilian c19s004_Betty_f561ecab:

    # mc "¿A Monterey? ¿Qué tienes que hacer allí? No hay ningún problema en llevarte. No lo habría aunque no le hubiera regalado el alquiler a [emm]."
    mc "Para Monterey? O que você tem para fazer lá? Não há problema em te levar. Não haveria problema mesmo se eu não tivesse dado o carro alugado de graça para [emm]."

# game/scripts/c19/c19.rpy:1997
translate brazilian c19s004_Betty_32b311f3:

    # bet "¿Qué te han contado de por qué dejé África?"
    bet "O que eles te disseram sobre o motivo de eu ter saído da África?"

# game/scripts/c19/c19.rpy:1998
translate brazilian c19s004_Betty_a8fa27a0:

    # mc "Nada. Creía que volviste para unas vacaciones o algo así y te quedaste por lo de Meemaw."
    mc "Nada. Pensei que você tivesse voltado para passar férias ou algo assim e ficado por causa da vovó."

# game/scripts/c19/c19.rpy:2000
translate brazilian c19s004_Betty_80b5fd53:

    # bet "Volví porque me expulsaron de Tanzania..."
    bet "Voltei porque fui expulso da Tanzânia..."

# game/scripts/c19/c19.rpy:2001
translate brazilian c19s004_Betty_7d703b8a:

    # bet "No del país, sino de la Iglesia de allí. Me abrieron expediente... por enfrentarme a un Obispo local."
    bet "Não do país, mas da Igreja de lá. Abriram um processo contra mim... por eu ter me oposto a um bispo local."

# game/scripts/c19/c19.rpy:2002
translate brazilian c19s004_Betty_2d7a7ac6:

    # mc "¿Qué hiciste, Tía Betty?"
    mc "O que você fez, tia Betty?"

# game/scripts/c19/c19.rpy:2004
translate brazilian c19s004_Betty_dc65b1f9:

    # bet "Negarme a operar el cerebro de alguien para curarle la homosexualidad. O lobotomizarlo si no era posible hacerlo."
    bet "Eu me recusaria a operar o cérebro de alguém para curá-lo da homossexualidade. Ou a lobotomizá-lo, se isso não fosse possível."

# game/scripts/c19/c19.rpy:2005
translate brazilian c19s004_Betty_f112c7ee:

    # mc "¿Qué? ¿Eso aún pasa?"
    mc "O quê? Isso ainda acontece?"

# game/scripts/c19/c19.rpy:2007
translate brazilian c19s004_Betty_2b7fcdd0:

    # bet "No, no pasa. Pero el Obispo quería demostrar al jefe de uno de los kraal, aldeas Masái, que aún sigue religiones tradicionales, el poder de Cristo..."
    bet "Não, isso não vai acontecer. Mas o bispo queria demonstrar ao chefe de um dos kraals, aldeias Maasai que ainda seguem religiões tradicionais, o poder de Cristo..."

# game/scripts/c19/c19.rpy:2008
translate brazilian c19s004_Betty_69646794:

    # bet "Aunque fuera de una forma rastrera y mintiéndole. Si el jefe se convertía, parte del kraal también lo haría... y el hijo gay de un jefe era una oportunidad."
    bet "Mesmo que tenha sido feito de maneira desprezível, mentindo para ele. Se o chefe se convertesse, parte do kraal também se converteria... e o filho gay do chefe era uma oportunidade."

# game/scripts/c19/c19.rpy:2009
translate brazilian c19s004_Betty_080b2c91:

    # bet "Mucha gente en Tanzania piensa que la homosexualidad no está bien y que los homosexuales no tienen lugar en la sociedad."
    bet "Muitas pessoas na Tanzânia acreditam que a homossexualidade é errada e que os homossexuais não têm lugar na sociedade."

# game/scripts/c19/c19.rpy:2010
translate brazilian c19s004_Betty_3b5202cf:

    # bet "Un jefe con un hijo gay, por muy integrado que esté en la sociedad tanzana, tiene un problema grave."
    bet "Um chefe com um filho gay, por mais integrado que esteja na sociedade tanzaniana, tem um problema sério."

# game/scripts/c19/c19.rpy:2011
translate brazilian c19s004_Betty_98971d5c:

    # mc "¡Eso es terrible! ¿Qué pasó?"
    mc "Que terrível! O que aconteceu?"

# game/scripts/c19/c19.rpy:2013
translate brazilian c19s004_Betty_4bac6634:

    # bet "Que me negué a operar un cerebro completamente sano para buscar algo que no se puede extirpar."
    bet "Recusei-me a operar um cérebro completamente saudável para procurar algo que não pudesse ser removido."

# game/scripts/c19/c19.rpy:2014
translate brazilian c19s004_Betty_6601e231:

    # bet "Se lo dije al jefe y al chico, y eso llevó a problemas con el Obispo."
    bet "Contei ao chefe e ao rapaz, e isso gerou problemas com o bispo."

# game/scripts/c19/c19.rpy:2015
translate brazilian c19s004_Betty_aa30d813:

    # bet "Él sabe que estaba mintiendo, pero en vez de reconocerlo, me echó las culpas a mí y consiguió que la Iglesia me echara de allí. Había socavado su imagen."
    bet "Ele sabia que estava mentindo, mas em vez de admitir, culpou-me e fez com que a Igreja me expulsasse. Ele havia prejudicado sua reputação."

# game/scripts/c19/c19.rpy:2016
translate brazilian c19s004_Betty_f01efb88:

    # mc "Pero podrías haberte quedado aunque no fuera trabajando para la Iglesia, ¿no?"
    mc "Mas você poderia ter ficado mesmo que não estivesse funcionando para a Igreja, certo?"

# game/scripts/c19/c19.rpy:2018
translate brazilian c19s004_Betty_5dbca6a5:

    # bet "No, [mc]. El permiso de residencia y trabajo lo tenía gracias a la Iglesia. Puedo visitar el país a nivel particular, pero no trabajar allí."
    bet "Não, [mc]. Eu tinha minha autorização de residência e de trabalho graças à Igreja. Posso visitar o país por motivos pessoais, mas não posso trabalhar lá."

# game/scripts/c19/c19.rpy:2019
translate brazilian c19s004_Betty_40a2ab04:

    # bet "Y adoro ese país."
    bet "E eu amo aquele país."

# game/scripts/c19/c19.rpy:2020
translate brazilian c19s004_Betty_b0c668cb:

    # mc "Lo que no entiendo es qué tiene esto que ver con la visita a Monterey."
    mc "O que eu não entendo é o que isso tem a ver com a visita a Monterey."

# game/scripts/c19/c19.rpy:2022
translate brazilian c19s004_Betty_e2234509:

    # bet "Hoy he estado hablando con el Padre Matthews en la iglesia. Me ha dicho que mis papeles han llegado ya desde Florida y que debería ir al Obispado de Monterey."
    bet "Hoje conversei com o padre Matthews na igreja. Ele me disse que meus documentos chegaram da Flórida e que eu devo ir à Diocese de Monterey."

# game/scripts/c19/c19.rpy:2023
translate brazilian c19s004_Betty_62b78b45:

    # bet "Como visita de cortesía y para informarme sobre cómo está mi expediente."
    bet "Foi uma visita de cortesia e para me informar sobre o andamento do meu processo."

# game/scripts/c19/c19.rpy:2024
translate brazilian c19s004_Betty_aa98d535:

    # mc "¿Tus papeles? No lo entiendo. ¿Tienes que informar a la Iglesia de dónde vives?"
    mc "Seus documentos? Não entendi. Você precisa informar à Igreja onde mora?"

# game/scripts/c19/c19.rpy:2026
translate brazilian c19s004_Betty_28266ce5:

    # bet "Normalmente no. Pero con un expediente sancionador en curso... Es lo mejor. No quiero parecer una monja rebelde más de lo que ya lo parezco."
    bet "Normalmente não. Mas com um processo disciplinar em andamento... É melhor assim. Não quero parecer mais uma freira rebelde do que já pareço."

# game/scripts/c19/c19.rpy:2027
translate brazilian c19s004_Betty_ad1e8093:

    # mc "Lo entiendo. No hay ningún problema. Puedo llevarte cuando vaya con [emm]. *Risa* Aunque no iremos al Obispado con el Ferrarini."
    mc "Entendo. Sem problema. Posso te levar quando eu for com [emm]. *Risos* Embora não iremos ao Bispado com os Ferrarini."

# game/scripts/c19/c19.rpy:2029
translate brazilian c19s004_Betty_581b8f5e:

    # bet "*Risa* No, no quedaría muy profesional."
    bet "*Risos* Não, isso não pareceria muito profissional."

# game/scripts/c19/c19.rpy:2030
translate brazilian c19s004_Betty_c31bd86d:

    # mc "¿Y por eso estás tan... triste? ¿Una multa y una visita al Obispado?"
    mc "E é por isso que você está tão... triste? Uma multa e uma visita ao gabinete do bispo?"

# game/scripts/c19/c19.rpy:2032
translate brazilian c19s004_Betty_1a32b7f8:

    # bet "No es eso. Me siento inútil. Hace un año que no piso un quirófano. Lo intenté en Florida. Hay buenos hospitales católicos allí."
    bet "Não é isso. Eu me sinto inútil. Faz um ano que não entro numa sala de cirurgia. Tentei na Flórida. Lá existem bons hospitais católicos."

# game/scripts/c19/c19.rpy:2033
translate brazilian c19s004_Betty_de9f8ba6:

    # bet "Y me dijeron que no podían darme ningún puesto hasta que no se resolviera mi expediente."
    bet "E me disseram que não poderiam me oferecer nenhuma vaga até que meu caso fosse resolvido."

# game/scripts/c19/c19.rpy:2035
translate brazilian c19s004_Betty_0ee07c20:

    # bet "Llevo un tiempo pensando que quizás acabe relegada en un convento. E ir a Monterey me tiene asustada."
    bet "Há algum tempo venho pensando que talvez acabe confinada a um convento. E ir para Monterey me assusta."

# game/scripts/c19/c19.rpy:2036
translate brazilian c19s004_Betty_72f3df68:

    # mc "¿Van a perder una cirujana porque te negaste a operar lo inoperable?"
    mc "Eles vão perder um cirurgião porque você se recusou a operar pacientes inoperáveis?"

# game/scripts/c19/c19.rpy:2038
translate brazilian c19s004_Betty_768c79bc:

    # bet "No, es posible que releguen a una monja rebelde que desobedeció una orden de un Obispo. Y, además, lo dejó en mal lugar."
    bet "Não, é possível que rebaixem uma freira rebelde que desobedeceu à ordem de um bispo. E, além disso, ela o fez passar vergonha."

# game/scripts/c19/c19.rpy:2039
translate brazilian c19s004_Betty_ca878c65:

    # bet "Para ellos, puedo seguir sirviendo a Dios en un convento igual que lo hago en un quirófano."
    bet "Para eles, posso continuar servindo a Deus em um convento da mesma forma que faço em uma sala de cirurgia."

# game/scripts/c19/c19.rpy:2040
translate brazilian c19s004_Betty_09faa47d:

    # mc "¿Incluso si había razones médicas para hacerlo?"
    mc "Mesmo que houvesse razões médicas para isso?"

# game/scripts/c19/c19.rpy:2042
translate brazilian c19s004_Betty_72fa1c9f:

    # bet "A los Obispos eso les da lo mismo. Piensa en ellos como políticos más que como sacerdotes."
    bet "Os bispos não se importam com isso. Pense neles mais como políticos do que como sacerdotes."

# game/scripts/c19/c19.rpy:2043
translate brazilian c19s004_Betty_433100f4:

    # mc "Y que Meemaw diga que cuenta con tu sueldo para la mudanza es la gota que ha colmado el vaso, ¿no?"
    mc "E a vovó dizendo que está contando com o seu salário para a mudança é a gota d'água, não é?"

# game/scripts/c19/c19.rpy:2045
translate brazilian c19s004_Betty_4e1fed18:

    # bet "Más o menos. Desde que llegué a Florida estoy cobrando un sueldo reducido, hasta que se resuelva el expediente. Es suficiente para colaborar, pero no para lo que quiere Olivia."
    bet "Mais ou menos. Desde que cheguei à Flórida, tenho recebido um salário reduzido até que o caso seja resolvido. É o suficiente para ajudar, mas não o suficiente para o que Olivia quer."

# game/scripts/c19/c19.rpy:2046
translate brazilian c19s004_Betty_6f20622b:

    # bet "Si acabo en un convento será aún menos. Si depende de mi sueldo..."
    bet "Se eu acabar num convento, será ainda menos. Se depender do meu salário..."

# game/scripts/c19/c19.rpy:2047
translate brazilian c19s004_Betty_cd9714cc:

    # mc "Si depende de tu sueldo y éste desaparece o se reduce, el resto de la familia colaboraremos."
    mc "Se depender do seu salário e ele desaparecer ou for reduzido, o resto da família ajudará."

# game/scripts/c19/c19.rpy:2048
translate brazilian c19s004_Betty_04e2e737:

    # mc "Tenemos una empresa millonaria. Supongo que como CEO tendré un sueldo... algo más alto que el de una monja."
    mc "Temos uma empresa multimilionária. Suponho que, como CEO, terei um salário... um pouco maior que o de uma freira."

# game/scripts/c19/c19.rpy:2050
translate brazilian c19s004_Betty_987feb0a:

    # bet "Es tan fácil olvidarse de eso..."
    bet "É tão fácil esquecer que..."

# game/scripts/c19/c19.rpy:2051
translate brazilian c19s004_Betty_1ac6fd98:

    # mc "Vale. Un problema resuelto. El permiso de conducir lo renovaremos mañana online. El transporte a Monterey también está resuelto. Hay que llevar a [emm] de todos modos."
    mc "Certo. Problema resolvido. Vamos renovar a carteira de motorista online amanhã. O transporte para Monterey também está resolvido. De qualquer forma, ainda precisamos pegar o [emm]."

# game/scripts/c19/c19.rpy:2052
translate brazilian c19s004_Betty_83ee38ab:

    # bet "Las casualidades que pasan en esta familia..."
    bet "As coincidências que acontecem nesta família..."

# game/scripts/c19/c19.rpy:2053
translate brazilian c19s004_Betty_ab7c5950:

    # mc "¿Algún problema más del que quieras hablar?"
    mc "Há algum outro problema que você gostaria de discutir?"

# game/scripts/c19/c19.rpy:2055
translate brazilian c19s004_Betty_71b1082b:

    # bet "No, pero un abrazo sí que aceptaría..."
    bet "Não, mas eu aceitaria um abraço..."

# game/scripts/c19/c19.rpy:2056
translate brazilian c19s004_Betty_1fe2d1ce:

    # mc "De esos tengo muchos y no se van a agotar."
    mc "Tenho muitos desses e eles não vão acabar."

# game/scripts/c19/c19.rpy:2058
translate brazilian c19s004_Betty_08928961:

    # bet "Gracias por ayudar a esta vieja, [mc]. Te has convertido en el hombre de la casa sin que nadie se diera cuenta. Sin que nadie te lo pidiera."
    bet "Obrigado por ajudar esta senhora idosa, [mc]. Você se tornou o homem da casa sem que ninguém percebesse. Sem que ninguém lhe pedisse."

# game/scripts/c19/c19.rpy:2059
translate brazilian c19s004_Betty_93101b7a:

    # bet "Cada día que pasa te pareces más a John..."
    bet "A cada dia que passa, você fica mais e mais parecido com o John..."

# game/scripts/c19/c19.rpy:2061
translate brazilian c19s004_Betty_21981656:

    # bet "Y ahora además también vas a ser padre. No sé cuándo vas a tener tiempo para ti."
    bet "E agora você também vai ser pai. Não sei quando você terá tempo para si mesmo."

# game/scripts/c19/c19.rpy:2062
translate brazilian c19s004_Betty_4682b4ea:

    # bet "Tienes que guardar tiempo para hacer las cosas que te gustan o al final explotarás."
    bet "Você precisa reservar tempo para as coisas que gosta, ou acabará explodindo."

# game/scripts/c19/c19.rpy:2063
translate brazilian c19s004_Betty_396539c5:

    # mc "Ya lo hago, Tía Betty. Dar abrazos es uno de mis mayores hobbies."
    mc "Eu já faço isso, tia Betty. Dar abraços é um dos meus maiores passatempos."

# game/scripts/c19/c19.rpy:2065
translate brazilian c19s004_Betty_440839a0:

    # bet "*Risa* Te conformas con poco."
    bet "*Risos* Você se contenta com pouco."

# game/scripts/c19/c19.rpy:2066
translate brazilian c19s004_Betty_ebf89824:

    # mc "Si el dormitorio no me da más trabajo que hacer la contabilidad y la compra, me tengo que buscar entretenimientos, ¿no? *Risa*"
    mc "Se o quarto não me der mais trabalho do que fazer a contabilidade e as compras, preciso encontrar maneiras de me entreter, não é? *Risos*"

# game/scripts/c19/c19.rpy:2067
translate brazilian c19s004_Betty_b9126f5e:

    # mc "Y estar con mis chicas es una de las mejores cosas que hay. Sois 22 aquí. No puedo pedir estar mejor acompañado."
    mc "E estar com as minhas amigas é uma das melhores coisas do mundo. Vocês são 22 aqui. Não poderia pedir companhia melhor."

# game/scripts/c19/c19.rpy:2068
translate brazilian c19s004_Betty_a3deeba9:

    # mc "Incluso Jamaal está bien para pasar un rato. *Risa* Pero a él no voy a darle abrazos."
    mc "Até o Jamaal é legal para sair junto. *Risos* Mas eu não vou abraçá-lo."

# game/scripts/c19/c19.rpy:2070
translate brazilian c19s004_Betty_49ccb84e:

    # bet "Debería dejarte ir o el resto de las chicas me van a odiar por acapararte."
    bet "Eu deveria te deixar ir, senão as outras garotas vão me odiar por eu estar monopolizando você."

# game/scripts/c19/c19.rpy:2071
translate brazilian c19s004_Betty_61151f95:

    # mc "Deberías disfrutar el abrazo y callar. Después puedes hablar con Scarlett sobre la app que usó anoche. Se acabarían los problemas de acaparamiento."
    mc "Aproveite o abraço e fique em silêncio. Depois, você pode conversar com a Scarlett sobre o aplicativo que ela usou ontem à noite. Isso resolveria todos os problemas de acumulação."

# game/scripts/c19/c19.rpy:2072
translate brazilian c19s004_Betty_996f6a40:

    # bet "¿Qué app?"
    bet "Qual aplicativo?"

# game/scripts/c19/c19.rpy:2073
translate brazilian c19s004_Betty_f9e38380:

    # "Le explicas la app de los turnos de baile. Alargas la explicación innecesariamente para estar más rato abrazado a ella."
    "Você explica o aplicativo Dance Shift para ela. Você prolonga a explicação desnecessariamente para poder abraçá-la por mais tempo."

# game/scripts/c19/c19.rpy:2074
translate brazilian c19s004_Betty_797c1d45:

    # "La mujer que siempre da apoyo a los demás necesita apoyo hoy."
    "A mulher que sempre apoia os outros precisa de apoio hoje."

# game/scripts/c19/c19.rpy:2076
translate brazilian c19s004_Betty_71f2a5aa:

    # "Al cabo de un largo rato, se separa de ti reluctantemente."
    "Após um longo período, ele se separa de você com relutância."

# game/scripts/c19/c19.rpy:2077
translate brazilian c19s004_Betty_188003d1:

    # bet "Creo que ahora sí que debería dejarte... pero antes..."
    bet "Acho que já devia ir embora... mas antes de ir..."

# game/scripts/c19/c19.rpy:2079
translate brazilian c19s004_Betty_ee227c78:

    # bet "Gracias por todo, [mc]. Deberías cobrar por esos abrazos."
    bet "Obrigado por tudo, [mc]. Você deveria cobrar por esses abraços."

# game/scripts/c19/c19.rpy:2080
translate brazilian c19s004_Betty_fe864c02:

    # mc "Ese beso me parece un buen pago. *Risa*"
    mc "Esse beijo parece um bom pagamento. *Risos*"

# game/scripts/c19/c19.rpy:2082
translate brazilian c19s004_Betty_2ad3bbab:

    # bet "De esos tengo muchos y no se van a agotar."
    bet "Tenho muitos desses e eles não vão acabar."

# game/scripts/c19/c19.rpy:2084
translate brazilian c19s004_Betty_b3890ebb:

    # mcp "(Espero que Eva y tú no habléis demasiado. Me acabas de recordar a lo que hizo anoche.)"
    mcp "(Espero que você e a Eva não conversem muito. Você me lembrou do que ela fez ontem à noite.)"

# game/scripts/c19/c19.rpy:2086
translate brazilian c19s004_Betty_f1db23b1:

    # mcp "(¡Oh, mierda! Me había olvidado de que le había dicho que tenía que hablar con ella y con Amanda! Hora de hacerlo)"
    mcp "(Ai, droga! Eu tinha me esquecido que disse a ela que precisava falar com ela e com a Amanda! Hora de fazer isso!)"

# game/scripts/c19/c19.rpy:2106
translate brazilian c19s004_AmandaEva_40cc353b:

    # "Pillas a Amanda a solas, volviendo de la casa. El resto de las chicas siguen alrededor de Meemaw."
    "Você encontra Amanda sozinha, voltando de casa. As outras meninas ainda estão perto da vovó."

# game/scripts/c19/c19.rpy:2108
translate brazilian c19s004_AmandaEva_3b172093:

    # "Se han formado grupos, supones que comentando todas las revelaciones del día."
    "Formaram-se grupos, presumivelmente para discutir todas as revelações do dia."

# game/scripts/c19/c19.rpy:2109
translate brazilian c19s004_AmandaEva_29bbc125:

    # "Nadie se acuerda ya de la lucha de caballos a la que ibais a jugar."
    "Ninguém mais se lembra da luta de cavalos que você ia encenar."

# game/scripts/c19/c19.rpy:2110
translate brazilian c19s004_AmandaEva_251ac38c:

    # mc "Amanda, ¿puedo veros a ti y a Eva en mi habitación en cinco minutos?"
    mc "Amanda, posso ver você e a Eva no meu quarto daqui a cinco minutos?"

# game/scripts/c19/c19.rpy:2111
translate brazilian c19s004_AmandaEva_9a682629:

    # ama "¿Para qué? Aún no hemos acabado de concretar lo que hablamos anoche..."
    ama "Por quê? Ainda não terminamos de finalizar o que conversamos ontem à noite..."

# game/scripts/c19/c19.rpy:2112
translate brazilian c19s004_AmandaEva_ac645562:

    # mc "No tiene que ver con lo de anoche, no te preocupes."
    mc "Não se preocupe, isso não tem nada a ver com o que aconteceu ontem à noite."

# game/scripts/c19/c19.rpy:2113
translate brazilian c19s004_AmandaEva_dca2111d:

    # mc "¿Vas a buscarla y os veo arriba?"
    mc "Você vai procurá-la? A gente se vê lá em cima."

# game/scripts/c19/c19.rpy:2115
translate brazilian c19s004_AmandaEva_2722a54e:

    # ama "De acuerdo, voy a avisarla."
    ama "Certo, eu aviso ela."

# game/scripts/c19/c19.rpy:2117
translate brazilian c19s004_AmandaEva_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c19/c19.rpy:2118
translate brazilian c19s004_AmandaEva_2b4c2398:

    # ama "¿Qué necesitas, [mc]?"
    ama "Do que você precisa, [mc]?"

# game/scripts/c19/c19.rpy:2119
translate brazilian c19s004_AmandaEva_14ff3a77:

    # eva "¿Es urgente? Las chicas... la fiesta..."
    eva "É urgente? As garotas... a festa..."

# game/scripts/c19/c19.rpy:2120
translate brazilian c19s004_AmandaEva_83f07e4b:

    # mc "Van a ser dos minutos. Tengo algo para vosotras."
    mc "Vai levar só dois minutos. Tenho uma coisa para você."

# game/scripts/c19/c19.rpy:2122
translate brazilian c19s004_AmandaEva_e961bfce:

    # eva "¿Para nosotras?" (multiple=2)
    eva "Para nós?" (multiple=2)

# game/scripts/c19/c19.rpy:2123
translate brazilian c19s004_AmandaEva_90c9b239:

    # ama "¿Qué es? ¿Algo sobre NTR?" (multiple=2)
    ama "O que é isso? Tem algo a ver com NTR?" (multiple=2)

# game/scripts/c19/c19.rpy:2124
translate brazilian c19s004_AmandaEva_c4198fb9:

    # mc "No os conocía en vuestro cumpleaños, con lo que he pensado que sería una buena idea dároslo hoy."
    mc "Eu não te conhecia no seu aniversário, então achei que seria uma boa ideia te dar hoje."

# game/scripts/c19/c19.rpy:2125
translate brazilian c19s004_AmandaEva_09866e1d:

    # mc "No es nada... importante... Tan solo algo que se me ocurrió."
    mc "Não é nada... importante... Só uma coisa que me ocorreu."

# game/scripts/c19/c19.rpy:2127
translate brazilian c19s004_AmandaEva_bcdae3e2:

    # mc "Son esas dos cajas que hay encima de la mesa."
    mc "Essas são as duas caixas que estão sobre a mesa."

# game/scripts/c19/c19.rpy:2128
translate brazilian c19s004_AmandaEva_c71034f4:

    # mc "La caja púrpura es para Eva y la azul para Amanda."
    mc "A caixa roxa é para Eva e a azul é para Amanda."

# game/scripts/c19/c19.rpy:2130
translate brazilian c19s004_AmandaEva_e7073f13:

    # "Las chicas casi corren hacia las cajas. Las sopesan y escuchan en su interior."
    "As meninas quase correm em direção às caixas. Elas as pesam nas mãos e escutam o que há dentro."

# game/scripts/c19/c19.rpy:2132
translate brazilian c19s004_AmandaEva_8a18531c:

    # "Las caras de sorpresa cuando las abren valen la pena. No sabes lo que esperaban, pero desde luego no lo que hay en las cajas."
    "A expressão de surpresa no rosto deles ao abrirem as caixas vale a pena. Você não sabe o que eles esperavam, mas com certeza não sabe o que tem dentro delas."

# game/scripts/c19/c19.rpy:2133
translate brazilian c19s004_AmandaEva_dff084ed:

    # ama "¿Le has dicho algo?"
    ama "Você disse alguma coisa para ele?"

# game/scripts/c19/c19.rpy:2134
translate brazilian c19s004_AmandaEva_8c2bc341:

    # eva "Salió la conversación el otro día..."
    eva "A conversa surgiu outro dia..."

# game/scripts/c19/c19.rpy:2136
translate brazilian c19s004_AmandaEva_291fb3f1:

    # eva "Tengo que sentarme..."
    eva "Preciso me sentar..."

# game/scripts/c19/c19.rpy:2137
translate brazilian c19s004_AmandaEva_458bec5d:

    # "No es el efecto que esperabas... A lo mejor la cara de sorpresa no era por una \"buena sorpresa\"."
    "Não foi o efeito que você esperava... Talvez a cara de surpresa não tenha sido por causa de uma \"surpresa agradável\"."

# game/scripts/c19/c19.rpy:2138
translate brazilian c19s004_AmandaEva_7d9eb707:

    # mc "¿No os gustan? Creía que..."
    mc "Você não gosta deles? Eu pensei..."

# game/scripts/c19/c19.rpy:2140
translate brazilian c19s004_AmandaEva_6ca94c36:

    # eva "¿Una muñeca, [mc]? ¿Crees que somos niñas pequeñas?"
    eva "Uma boneca, [mc]? Você acha que somos menininhas?"

# game/scripts/c19/c19.rpy:2141
translate brazilian c19s004_AmandaEva_7c9a1719:

    # mc "No. No es lo que quería decir con ese regalo... dijiste que nunca habíais tenido una. Encontré esas que eran personalizables y... No son pistolas... creía que os gustarían..."
    mc "Não. Não era isso que eu queria dizer com aquele presente... você disse que nunca tinha recebido um. Encontrei estes personalizáveis e... não são armas... achei que você gostaria deles..."

# game/scripts/c19/c19.rpy:2142
translate brazilian c19s004_AmandaEva_eab1ef1c:

    # mc "No sé... quería regalaros vuestra primera muñeca... no quería ofenderos."
    mc "Não sei... Eu queria te dar sua primeira boneca... Não queria te ofender."

# game/scripts/c19/c19.rpy:2144
translate brazilian c19s004_AmandaEva_51ebcfdf:

    # eva "No creía que te acordaras... o que hubieras prestado atención..."
    eva "Não pensei que você se lembrasse... ou que sequer estivesse prestando atenção..."

# game/scripts/c19/c19.rpy:2145
translate brazilian c19s004_AmandaEva_ac971ab0:

    # mc "Siempre presto atención a lo que decís, Eva."
    mc "Eu sempre presto atenção no que você diz, Eva."

# game/scripts/c19/c19.rpy:2147
translate brazilian c19s004_AmandaEva_ddde49c2:

    # mc "¿A ti tampoco te gusta la tuya, Amanda?"
    mc "Você também não gosta do seu, Amanda?"

# game/scripts/c19/c19.rpy:2148
translate brazilian c19s004_AmandaEva_128915ea:

    # ama "¿Gustarme? ¿Tampoco?"
    ama "Gostou? Nem isso?"

# game/scripts/c19/c19.rpy:2149
translate brazilian c19s004_AmandaEva_e25c54c0:

    # ama "[mc], a veces pareces tan listo y a veces parece que no sabes de qué estás hablando... eres desconcertante."
    ama "[mc], às vezes você parece tão inteligente e às vezes parece que não sabe do que está falando... você é desconcertante."

# game/scripts/c19/c19.rpy:2151
translate brazilian c19s004_AmandaEva_6ed7a82f:

    # ama "Me encanta... La has vestido como el día que nos conocimos, durante el secuestro, pero sin el pasamontañas..."
    ama "Adorei... Você a vestiu como no dia em que nos conhecemos, durante o sequestro, mas sem a balaclava..."

# game/scripts/c19/c19.rpy:2153
translate brazilian c19s004_AmandaEva_965b482b:

    # ama "Gracias, [mc]. Es increíble que te hayas tomado tantas molestias por nosotras."
    ama "Obrigado, [mc]. É incrível que você tenha se dado a tanto trabalho por nós."

# game/scripts/c19/c19.rpy:2154
translate brazilian c19s004_AmandaEva_17fd7601:

    # ama "Y a Eva también le gusta la suya. Pero no sabe expresar agradecimiento."
    ama "E Eva também gosta da dela. Mas ela não sabe como expressar gratidão."

# game/scripts/c19/c19.rpy:2155
translate brazilian c19s004_AmandaEva_cc761816:

    # mc "No..."
    mc "Não..."

# game/scripts/c19/c19.rpy:2157
translate brazilian c19s004_AmandaEva_a99fdb2f:

    # mc "... pasa..."
    mc "... acontece..."

# game/scripts/c19/c19.rpy:2159
translate brazilian c19s004_AmandaEva_68668214:

    # mc "... nada..."
    mc "... nada..."

# game/scripts/c19/c19.rpy:2160
translate brazilian c19s004_AmandaEva_d908e823:

    # eva "¡Gracias, [mc]!"
    eva "Obrigado, [mc]!"

# game/scripts/c19/c19.rpy:2162
translate brazilian c19s004_AmandaEva_720943b8:

    # eva "¡Gracias, gracias, gracias!"
    eva "Muito obrigado, muito obrigado, muito obrigado!"

# game/scripts/c19/c19.rpy:2163
translate brazilian c19s004_AmandaEva_c37deefe:

    # mc "Me alegra que os gusten..."
    mc "Que bom que você gostou..."

# game/scripts/c19/c19.rpy:2165
translate brazilian c19s004_AmandaEva_bc503d70:

    # eva "Tu turno, Amanda."
    eva "Sua vez, Amanda."

# game/scripts/c19/c19.rpy:2167
translate brazilian c19s004_AmandaEva_dd958d13:

    # ama "Gracias, [mc]."
    ama "Obrigado, [mc]."

# game/scripts/c19/c19.rpy:2169
translate brazilian c19s004_AmandaEva_9c56d7c9:

    # ama "No sabes lo que significa esto para nosotras."
    ama "Você não sabe o que isso significa para nós."

# game/scripts/c19/c19.rpy:2170
translate brazilian c19s004_AmandaEva_d18f7820:

    # mc "No lo puedo imaginar, pero me encantan vuestras reacciones. Aunque me habéis acojonado al principio."
    mc "Não consigo imaginar, mas adorei suas reações. Apesar de ter me assustado um pouco no começo."

# game/scripts/c19/c19.rpy:2172
translate brazilian c19s004_AmandaEva_3ed2cd9e:

    # ama "La próxima vez, añade un set de maquillaje. Últimamente, por tu culpa, parezco un mapache demasiado a menudo."
    ama "Da próxima vez, inclua um kit de maquiagem. Ultimamente, graças a você, estou parecendo um guaxinim com muita frequência."

# game/scripts/c19/c19.rpy:2173
translate brazilian c19s004_AmandaEva_07490a72:

    # mc "*Risa* Y yo que creía que erais mercenarias duras..."
    mc "*Risos* E eu que pensava que vocês eram mercenários durões..."

# game/scripts/c19/c19.rpy:2175
translate brazilian c19s004_AmandaEva_07200d65:

    # eva "Ponme a luchar con guerrillas africanas y te demostraré lo dura que soy..."
    eva "Me coloque em uma luta com guerrilheiros africanos e eu lhe mostrarei o quão durão eu sou..."

# game/scripts/c19/c19.rpy:2176
translate brazilian c19s004_AmandaEva_37bc5e40:

    # mc "Pero una muñeca te hace llorar..."
    mc "Mas uma boneca te faz chorar..."

# game/scripts/c19/c19.rpy:2178
translate brazilian c19s004_AmandaEva_68e44313:

    # ama "No es la muñeca en sí, [mc]. Es que hayas pensado que podrían gustarnos a nosotras."
    ama "Não é a boneca em si, [mc]. É que você achou que nós poderíamos gostar dela."

# game/scripts/c19/c19.rpy:2180
translate brazilian c19s004_AmandaEva_6fbf7c40:

    # eva "Y que hayas pensado que nosotras también debíamos recibir regalos. El día del cumpleaños de las chicas."
    eva "E você achou que nós também deveríamos receber presentes. No aniversário das meninas."

# game/scripts/c19/c19.rpy:2181
translate brazilian c19s004_AmandaEva_16628867:

    # mc "Sois tan parte de esta familia como cualquiera de nosotros. Os debemos 18 regalos de cumpleaños."
    mc "Você faz parte desta família tanto quanto qualquer um de nós. Devemos a você 18 presentes de aniversário."

# game/scripts/c19/c19.rpy:2183
translate brazilian c19s004_AmandaEva_098e99fa:

    # mc "¿Por qué no dejas la muñeca y vuelves aquí? Creo que un abrazo triple estaría bien, ¿no?"
    mc "Por que você não larga a boneca e volta aqui? Acho que um abraço triplo seria legal, não acha?"

# game/scripts/c19/c19.rpy:2186
translate brazilian c19s004_AmandaEva_8e1c8d0a:

    # eva "Sí. Se está bien aquí..."
    eva "Sim. É agradável aqui..."

# game/scripts/c19/c19.rpy:2187
translate brazilian c19s004_AmandaEva_553de1bd:

    # ama "Rechazo tu idea, Eva."
    ama "Rejeito sua ideia, Eva."

# game/scripts/c19/c19.rpy:2188
translate brazilian c19s004_AmandaEva_696e52fa:

    # eva "Creo que yo también la rechazo."
    eva "Acho que também rejeito isso."

# game/scripts/c19/c19.rpy:2189
translate brazilian c19s004_AmandaEva_704e5ecf:

    # mc "¿De qué habláis?"
    mc "O que você está falando?"

# game/scripts/c19/c19.rpy:2190
translate brazilian c19s004_AmandaEva_a26e8fee:

    # eva "Te hemos dicho que no habíamos acabado de concretar lo que hablamos ayer..."
    eva "Já tínhamos avisado que não tínhamos finalizado o que conversamos ontem..."

# game/scripts/c19/c19.rpy:2191
translate brazilian c19s004_AmandaEva_6517a50c:

    # ama "Mi hermana tuvo la \"genial\" idea de decirte que, o nos elegías a las dos, o a ninguna."
    ama "Minha irmã teve a \"brilhante\" ideia de lhe dizer que ou você escolhia nós duas, ou nenhuma de nós."

# game/scripts/c19/c19.rpy:2192
translate brazilian c19s004_AmandaEva_e96689fc:

    # eva "No contestes qué elegirías... Ese plan se acaba de ir a la mierda. De todas formas, Amanda no estaba convencida."
    eva "Não responda qual seria sua escolha... Esse plano foi por água abaixo. De qualquer forma, Amanda não estava convencida."

# game/scripts/c19/c19.rpy:2193
translate brazilian c19s004_AmandaEva_54ad3bcb:

    # eva "Es lo que se me ocurrió para que no discutiéramos."
    eva "Foi isso que eu pensei para evitarmos discussões."

# game/scripts/c19/c19.rpy:2194
translate brazilian c19s004_AmandaEva_c702702c:

    # mc "Y ¿por qué la rechazáis ahora?"
    mc "E por que você a está rejeitando agora?"

# game/scripts/c19/c19.rpy:2196
translate brazilian c19s004_AmandaEva_1638ef54:

    # ama "No podría aceptar que rechazaras a Eva por ese ultimátum si no quieres estar conmigo pero sí con ella."
    ama "Eu não poderia aceitar que você rejeitasse a Eva por causa desse ultimato, se você não quer ficar comigo, mas quer ficar com ela."

# game/scripts/c19/c19.rpy:2197
translate brazilian c19s004_AmandaEva_aa6aab58:

    # mcp "(Cada día te pareces más a [eri].)"
    mcp "(A cada dia você se parece mais com [eri].)"

# game/scripts/c19/c19.rpy:2198
translate brazilian c19s004_AmandaEva_fa9a6811:

    # mc "¿Y tú, Eva? Si la idea fue tuya..."
    mc "E você, Eva? Se a ideia foi sua..."

# game/scripts/c19/c19.rpy:2200
translate brazilian c19s004_AmandaEva_f584551c:

    # eva "Me he imaginado cómo reaccionaría yo si me pusieran entre la espada y la pared como pensaba hacerte."
    eva "Imaginei como eu reagiria se fosse colocado entre a cruz e a espada, como eu planejava fazer com você."

# game/scripts/c19/c19.rpy:2201
translate brazilian c19s004_AmandaEva_b6612b91:

    # eva "Mi reacción no hubiera sido... agradable. Ha hecho falta que me hagas llorar para que lo entienda."
    eva "Minha reação não teria sido... agradável. Você teve que me fazer chorar para que eu entendesse."

# game/scripts/c19/c19.rpy:2202
translate brazilian c19s004_AmandaEva_017af769:

    # mcp "(Y tú cada día te pareces más a [emm].)"
    mcp "(E você se parece cada vez mais com [emm] a cada dia que passa.)"

# game/scripts/c19/c19.rpy:2204
translate brazilian c19s004_AmandaEva_54c92f55:

    # eva "No quiero que pases por eso porque nosotras nos estemos comportando como niñas pequeñas."
    eva "Não quero que você passe por isso porque estamos nos comportando como menininhas."

# game/scripts/c19/c19.rpy:2205
translate brazilian c19s004_AmandaEva_72d03917:

    # mc "Gracias, Eva..."
    mc "Obrigada, Eva..."

# game/scripts/c19/c19.rpy:2207
translate brazilian c19s004_AmandaEva_5cd7a77d:

    # ama "Al menos ahora seremos niñas pequeñas con muñecas. *Risa* Poco a poco iremos aprendiendo."
    ama "Pelo menos agora seremos menininhas com bonecas. *Risos* Vamos aprender aos poucos."

# game/scripts/c19/c19.rpy:2208
translate brazilian c19s004_AmandaEva_4353756b:

    # mc "*Risa* Poco a poco. Os iremos dando un curso acelerado de \"normalidad\". O tanta \"normalidad\" como esta familia sea capaz."
    mc "*Risos* Aos poucos. Vamos dar a vocês um curso intensivo de \"normalidade\". Ou o máximo de \"normalidade\" que esta família é capaz de ter."

# game/scripts/c19/c19.rpy:2210
translate brazilian c19s004_AmandaEva_966d6274:

    # "El abrazo dura un rato, con conversaciones intrascendentes y risas."
    "O abraço dura um tempo, com conversas triviais e risos."

# game/scripts/c19/c19.rpy:2212
translate brazilian c19s004_AmandaEva_6fcceb24:

    # "La revelación de secretos se intercala entre las conversaciones."
    "A revelação de segredos ocorre de forma intercalada ao longo das conversas."

# game/scripts/c19/c19.rpy:2213
translate brazilian c19s004_AmandaEva_facc4e5a:

    # "Coinciden con lo que ha dicho Betty sobre el secreto de Meemaw dejando los tuyos en segundo plano."
    "Eles concordam com o que Betty disse sobre o segredo da vovó, deixando o seu em segundo plano."

# game/scripts/c19/c19.rpy:2215
translate brazilian c19s004_AmandaEva_fca1cfd9:

    # "También te felicitan por tu futura paternidad. Has dado un buen uso a los tests."
    "Eles também te parabenizam pela futura paternidade. Você soube aproveitar bem os testes."

# game/scripts/c19/c19.rpy:2217
translate brazilian c19s004_AmandaEva_0cd35f80:

    # ama "Creo que deberíamos ir bajando. Las chicas se van a preguntar dónde estamos."
    ama "Acho que devemos descer. As meninas vão ficar curiosas para saber onde estamos."

# game/scripts/c19/c19.rpy:2219
translate brazilian c19s004_AmandaEva_5164513e:

    # ama "O si va a haber más secretos que revelar cuando bajemos. *Risa*"
    ama "Ou se haverá mais segredos para revelar quando descermos. *Risos*"

# game/scripts/c19/c19.rpy:2220
translate brazilian c19s004_AmandaEva_4693d2db:

    # mc "Sería buena idea bajar. No os olvidéis las muñecas."
    mc "Seria uma boa ideia descer. Não se esqueça dos seus pulsos."

# game/scripts/c19/c19.rpy:2221
translate brazilian c19s004_AmandaEva_1e102db9:

    # ama "De camino a la piscina, las dejaremos en la habitación de [emm], con nuestra ropa."
    ama "No caminho para a piscina, vamos deixá-los no quarto [emm], junto com nossas roupas."

# game/scripts/c19/c19.rpy:2223
translate brazilian c19s004_AmandaEva_c4765bf0:

    # eva "Dadme un segundo..."
    eva "Só me dê um segundo..."

# game/scripts/c19/c19.rpy:2229
translate brazilian c19s004_AmandaEva_59564e51:

    # eva "Ya. Podemos bajar. También dejaré esto en la habitación de [emm]."
    eva "Certo. Podemos descer. Também deixarei isto no quarto [emm]."

# game/scripts/c19/c19.rpy:2230
translate brazilian c19s004_AmandaEva_56a609cd:

    # mc "¿Por qué has cambiado de opinión?"
    mc "Por que você mudou de ideia?"

# game/scripts/c19/c19.rpy:2232
translate brazilian c19s004_AmandaEva_eb2836da:

    # eva "Alguien me dijo que tenía que dejar con ganas de más a los chicos que me interesaran y que contara las veces que lo hacía."
    eva "Alguém me disse que eu deveria deixar os caras por quem eu estava interessada querendo mais e contar quantas vezes eu fazia isso."

# game/scripts/c19/c19.rpy:2233
translate brazilian c19s004_AmandaEva_b1a421fc:

    # eva "Van dos."
    eva "São dois."

# game/scripts/c19/c19.rpy:2236
translate brazilian c19s004_AmandaEva_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c19/c19.rpy:2238
translate brazilian c19s004_AmandaEva_6e1fa55a:

    # mc "Creo que he creado un monstruo. *Risa*"
    mc "Acho que criei um monstro. *Risos*"

# game/scripts/c19/c19.rpy:2239
translate brazilian c19s004_AmandaEva_b1b109ab:

    # ama "Es culpa tuya. *Risa*"
    ama "A culpa é sua. *Risos*"

# game/scripts/c19/c19.rpy:2242
translate brazilian c19s004_AmandaEva_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c19/c19.rpy:2243
translate brazilian c19s004_AmandaEva_05886884:

    # eva "*A través de la puerta* Soy yo..."
    eva "*Através da porta* Sou eu..."

# game/scripts/c19/c19.rpy:2244
translate brazilian c19s004_AmandaEva_cff3b865:

    # mc "Adelante..."
    mc "Avançar..."

# game/scripts/c19/c19.rpy:2246
translate brazilian c19s004_AmandaEva_a27de6a1:

    # eva "He querido hacer una salida tan dramática que me he olvidado a Fee."
    eva "Eu queria fazer uma saída tão dramática que me esqueci da Fee."

# game/scripts/c19/c19.rpy:2247
translate brazilian c19s004_AmandaEva_728e94ab:

    # mc "*Risa* Cógela y nos vemos abajo."
    mc "*Risos* Pegue e nos vemos lá embaixo."

# game/scripts/c19/c19.rpy:2248
translate brazilian c19s004_AmandaEva_edd753ce:

    # mcp "(¿Fee? ¿Ya le ha puesto nombre? ¿Es posible que sea por Fiona, la primera de las chicas que murió?)"
    mcp "(Taxa? Ela já deu um nome? Será que é em homenagem à Fiona, a primeira das meninas a morrer?)"

# game/scripts/c19/c19.rpy:2250
translate brazilian c19s004_AmandaEva_9ffd506a:

    # mcp "(La he diseñado para que se parezca a Eva, lo cual significa que también se parece a Fiona.)"
    mcp "(Eu a projetei para se parecer com Eva, o que significa que ela também se parece com Fiona.)"

# game/scripts/c19/c19.rpy:2252
translate brazilian c19s004_AmandaEva_4250dff2:

    # eva "Hasta luego, [mc]." (multiple=2)
    eva "Até logo, [mc]." (multiple=2)

# game/scripts/c19/c19.rpy:2253
translate brazilian c19s004_AmandaEva_09450795:

    # ama "Te vemos en la piscina." (multiple=2)
    ama "Te vejo na piscina." (multiple=2)

# game/scripts/c19/c19.rpy:2254
translate brazilian c19s004_AmandaEva_a7dace93:

    # mc "Hasta ahora, chicas. No os quedéis jugando con las muñecas en la habitación de [emm]. O al menos no os quedéis demasiado rato."
    mc "Já chega, meninas. Não fiquem brincando com as bonecas no quarto [emm]. Ou pelo menos não fiquem lá por muito tempo."

# game/scripts/c19/c19.rpy:2331
translate brazilian c19s004_MaddieDebbie_e0e383bc:

    # "Al llegar a la piscina, te acercas a Maddie, que parece que se acaba de quedar sola."
    "Ao chegar à piscina, você se aproxima de Maddie, que parece ter acabado de ser deixada sozinha."

# game/scripts/c19/c19.rpy:2333
translate brazilian c19s004_MaddieDebbie_a7d0ffb9:

    # mc "¿Qué tal te lo estás pasando, Maddie?"
    mc "Como você está, Maddie?"

# game/scripts/c19/c19.rpy:2334
translate brazilian c19s004_MaddieDebbie_92bcd6b6:

    # mad "Muy bien, había algunas chicas a las que solo conocía de pasada. Hacía mucho tiempo que no estaba en una fiesta con tanta gente y con tan buen rollo."
    mad "Foi ótimo; tinha umas garotas que eu só conhecia de vista. Fazia muito tempo que eu não ia a uma festa com tanta gente e um clima tão bom."

# game/scripts/c19/c19.rpy:2335
translate brazilian c19s004_MaddieDebbie_9c828053:

    # mad "Incluso lo del mensaje se ha solucionado de una forma... diferente a como me imaginaba."
    mad "Até mesmo a questão das mensagens foi resolvida de uma forma... diferente da que eu imaginava."

# game/scripts/c19/c19.rpy:2336
translate brazilian c19s004_MaddieDebbie_a427241e:

    # mc "Bueno... creo que somos diferentes a lo habitual."
    mc "Bem... acho que somos diferentes da norma."

# game/scripts/c19/c19.rpy:2337
translate brazilian c19s004_MaddieDebbie_65598d11:

    # mad "Siéntate conmigo un rato. Apenas hemos tenido tiempo de hablar."
    mad "Sente-se comigo um pouco. Mal tivemos tempo de conversar."

# game/scripts/c19/c19.rpy:2341
translate brazilian c19s004_MaddieDebbie_6eeb2c71:

    # mad "No todas las chicas descubren todos los días que el chico con el que pensabas que tenías algo especial lo tiene también con más chicas."
    mad "Nem toda garota descobre todos os dias que o cara com quem ela achava que tinha algo especial também tem algo especial com outras garotas."

# game/scripts/c19/c19.rpy:2342
translate brazilian c19s004_MaddieDebbie_1a8d88c3:

    # mc "Nunca me he escondido sobre eso."
    mc "Eu nunca escondi isso."

# game/scripts/c19/c19.rpy:2344
translate brazilian c19s004_MaddieDebbie_34c91fae:

    # mc "Te dije que estaba con alguien más. No me puedes acusar de no ser sincero."
    mc "Eu te disse que estava com outra pessoa. Você não pode me acusar de desonestidade."

# game/scripts/c19/c19.rpy:2346
translate brazilian c19s004_MaddieDebbie_2559aa01:

    # mc "Tu relación y la mía es diferente a cualquier otra que tenga."
    mc "Nossa relação é diferente de qualquer outra que eu já tive."

# game/scripts/c19/c19.rpy:2348
translate brazilian c19s004_MaddieDebbie_cadc6741:

    # mad "Pero que Betty haya querido cubrirte... ha sido alucinante."
    mad "Mas o fato de Betty ter se disposto a te acobertar... foi incrível."

# game/scripts/c19/c19.rpy:2350
translate brazilian c19s004_MaddieDebbie_b005c7f2:

    # mad "Ha sido alucinante que Betty haya intentado cubrirnos sin ni siquiera saber a quién cubría."
    mad "Foi incrível como a Betty tentou nos acobertar sem nem saber quem estava acobertando."

# game/scripts/c19/c19.rpy:2352
translate brazilian c19s004_MaddieDebbie_ad1b6620:

    # mad "Ha sido alucinante que Betty haya intentado cubriros sin ni siquiera saber a quién cubría."
    mad "Foi incrível como a Betty tentou te acobertar sem nem saber quem ela estava acobertando."

# game/scripts/c19/c19.rpy:2354
translate brazilian c19s004_MaddieDebbie_c35adc9f:

    # mc "Lo sabía, pero eso no le quita mérito a que haya querido cubrirnos."
    mc "Eu sabia disso, mas isso não diminui o mérito da sua intenção de nos acobertar."

# game/scripts/c19/c19.rpy:2356
translate brazilian c19s004_MaddieDebbie_86978398:

    # mc "No me extrañaría que lo hubiera sospechado en todo momento, conociendo a Tía Betty."
    mc "Não me surpreenderia se ela já suspeitasse de tudo, conhecendo a tia Betty."

# game/scripts/c19/c19.rpy:2358
translate brazilian c19s004_MaddieDebbie_3494d574:

    # mad "Has tenido que alucinar mucho cuando has recibido ese mensaje, no saliendo con nadie, y con Betty confesando algo que no es cierto para cubrirte."
    mad "Você deve ter ficado realmente assustado(a) quando recebeu aquela mensagem, sem estar namorando ninguém, e com a Betty confessando algo que não é verdade para te acobertar."

# game/scripts/c19/c19.rpy:2359
translate brazilian c19s004_MaddieDebbie_482dcf08:

    # mc "Betty es así. La razón que ha dado es tan propia de ella... Ha preferido cargar con la culpa antes de que se descubriera el posible culpable."
    mc "Essa é a Betty. A razão que ela deu é tão típica dela... Ela preferiu assumir a culpa a ter o culpado descoberto."

# game/scripts/c19/c19.rpy:2361
translate brazilian c19s004_MaddieDebbie_6995a6a6:

    # mad "Es bueno tener a alguien así cerca. Todos sois alucinantes... Betty, Olivia, [mar], [nor], las chicas... Obviamente Amanda y Eva..."
    mad "É ótimo ter alguém assim por perto. Vocês são todos incríveis... Betty, Olivia, [mar], [nor], as meninas... Obviamente Amanda e Eva..."

# game/scripts/c19/c19.rpy:2362
translate brazilian c19s004_MaddieDebbie_7376f5f2:

    # mc "¿Y el resto? Creo que no conocías a Kim, Lisa, o Kate. Te he visto hablando con ellas antes."
    mc "E o resto? Acho que você não conhecia a Kim, a Lisa ou a Kate. Já vi você conversando com elas antes."

# game/scripts/c19/c19.rpy:2364
translate brazilian c19s004_MaddieDebbie_b82b8fac:

    # mad "A Kate y a Lisa sí que las había visto. Vinieron con Debbie hace unos días a la tienda."
    mad "Eu tinha visto Kate e Lisa. Elas vieram à loja com Debbie alguns dias atrás."

# game/scripts/c19/c19.rpy:2365
translate brazilian c19s004_MaddieDebbie_7b51f5a0:

    # mad "A Kim no la había visto. Es espectacular. No me extraña que sea modelo."
    mad "Eu nunca tinha visto a Kim antes. Ela é deslumbrante. Não é à toa que ela é modelo."

# game/scripts/c19/c19.rpy:2366
translate brazilian c19s004_MaddieDebbie_c083502f:

    # mc "Es una chica muy especial."
    mc "Ela é uma menina muito especial."

# game/scripts/c19/c19.rpy:2368
translate brazilian c19s004_MaddieDebbie_296e4b5f:

    # mad "Y muy amable. Después de los regalos, hablando con Lisa y Kim, hemos estado hablando de pintura."
    mad "E muito gentis. Depois dos presentes, enquanto conversávamos com Lisa e Kim, estávamos falando sobre pintura."

# game/scripts/c19/c19.rpy:2369
translate brazilian c19s004_MaddieDebbie_4d9d0c2b:

    # mc "Lisa estudia arte, es lógico."
    mc "Lisa estuda arte, faz sentido."

# game/scripts/c19/c19.rpy:2372
translate brazilian c19s004_MaddieDebbie_b80e802c:

    # mad "Les ha hablado de los cuadros de Zeus, y de los diseños de vestidos."
    mad "Ele contou-lhes sobre as pinturas de Zeus e os desenhos das vestimentas."

# game/scripts/c19/c19.rpy:2374
translate brazilian c19s004_MaddieDebbie_86e63501:

    # mad "Les he hablado de unos cuadros de Zeus que tengo en mi habitación y... no sé si sabes que diseño ropa."
    mad "Já te falei de alguns quadros de Zeus que tenho no meu quarto e... não sei se você sabe que eu desenho roupas."

# game/scripts/c19/c19.rpy:2375
translate brazilian c19s004_MaddieDebbie_fadddf46:

    # mc "No, no lo sabía..."
    mc "Não, eu não sabia disso..."

# game/scripts/c19/c19.rpy:2377
translate brazilian c19s004_MaddieDebbie_672886fe:

    # mad "¡Pues Kim se ha ofrecido a servirme como maniquí para probar cómo quedan los vestidos en una persona real!"
    mad "Bem, a Kim se ofereceu para servir de manequim para eu testar como os vestidos ficam em uma pessoa de verdade!"

# game/scripts/c19/c19.rpy:2378
translate brazilian c19s004_MaddieDebbie_cb38ff1b:

    # mc "¡Eso es fantástico!"
    mc "Isso é fantástico!"

# game/scripts/c19/c19.rpy:2379
translate brazilian c19s004_MaddieDebbie_2e60e84b:

    # mc "No tengo ni idea de si eso puede ayudarte, pero supongo que es mejor que verlos en papel o en un ordenador."
    mc "Não sei se isso vai te ajudar, mas suponho que seja melhor do que vê-los no papel ou no computador."

# game/scripts/c19/c19.rpy:2381
translate brazilian c19s004_MaddieDebbie_38ffef5a:

    # mad "¡Es increíble! Muchas veces, cuando tengo el vestido cortado y pre-cosido, me lo pruebo y no se parece en nada a lo que tenía en mente."
    mad "É incrível! Muitas vezes, quando o vestido já está cortado e pré-costurado, eu o experimento e ele não se parece em nada com o que eu tinha imaginado."

# game/scripts/c19/c19.rpy:2382
translate brazilian c19s004_MaddieDebbie_cd44ea46:

    # mad "Hacer modificaciones sobre mí misma es muy complicado, pero tener a Kim para ayudarme en eso... sería de una ayuda que no te puedes imaginar."
    mad "Fazer mudanças em mim mesma é muito complicado, mas ter a Kim para me ajudar com isso... seria uma ajuda indescritível."

# game/scripts/c19/c19.rpy:2383
translate brazilian c19s004_MaddieDebbie_90e9b615:

    # mc "*Risa* Se te ve muy emocionada, con lo que empiezo a imaginármelo."
    mc "*Risos* Você parece muito animado, então estou começando a imaginar."

# game/scripts/c19/c19.rpy:2384
translate brazilian c19s004_MaddieDebbie_09ae50f6:

    # mc "Y voy más allá. Ya me estoy imaginando a Kim desfilando en una pasarela con tus vestidos. *Risa*"
    mc "E vou ainda mais longe. Já consigo imaginar a Kim desfilando numa passarela com os seus vestidos. *Risos*"

# game/scripts/c19/c19.rpy:2386
translate brazilian c19s004_MaddieDebbie_3d483a02:

    # mad "Mmmm... creo que me acabas de dar una idea muy interesante. Si encontráramos un fotógrafo... las dos podríamos sacar algo de esto..."
    mad "Hum... Acho que você acabou de me dar uma ideia muito interessante. Se conseguíssemos encontrar um fotógrafo... poderíamos fazer algo com isso..."

# game/scripts/c19/c19.rpy:2387
translate brazilian c19s004_MaddieDebbie_4ab91928:

    # mc "Habla con [emm]. No es profesional ni nada por el estilo, pero es buena con la cámara."
    mc "Fale com a [emm]. Ela não é profissional nem nada, mas é boa com uma câmera."

# game/scripts/c19/c19.rpy:2389
translate brazilian c19s004_MaddieDebbie_5465ec3b:

    # mad "¿Qué? ¡No lo sabía!"
    mad "O quê? Eu não sabia disso!"

# game/scripts/c19/c19.rpy:2390
translate brazilian c19s004_MaddieDebbie_b67c00ab:

    # mc "La fotografía es una de sus pasiones. Creo que las tres podríais sacar algo de esto."
    mc "A fotografia é uma das paixões dela. Acho que vocês três poderiam aprender algo com isso."

# game/scripts/c19/c19.rpy:2391
translate brazilian c19s004_MaddieDebbie_bac1142b:

    # mc "[emm] aumentar su portfolio, Kim su book, y tú poder promocionar tus vestidos."
    mc "[emm] Aumente o portfólio dela, Kim o livro dela, e você poderá promover seus vestidos."

# game/scripts/c19/c19.rpy:2392
translate brazilian c19s004_MaddieDebbie_54a87386:

    # mad "¡Tengo que hablar con ella!"
    mad "Preciso falar com ela!"

# game/scripts/c19/c19.rpy:2393
translate brazilian c19s004_MaddieDebbie_7e00dc7d:

    # mc "*Risa* La he visto entrar en casa hace un momento. Supongo que no tardará."
    mc "*Risos* Eu a vi entrar em casa agora há pouco. Acho que ela não vai demorar."

# game/scripts/c19/c19.rpy:2395
translate brazilian c19s004_MaddieDebbie_d2896817:

    # mad "Bueno, tampoco es el momento de hablar de negocios. Además es su cumpleaños."
    mad "Bem, também não é hora de falar de negócios. Além disso, é aniversário dele."

# game/scripts/c19/c19.rpy:2396
translate brazilian c19s004_MaddieDebbie_d6a64fa2:

    # mc "Le harás un regalo increíble... otro regalo increíble, si le ofreces hacer fotos profesionales el día de su cumpleaños, o casi."
    mc "Você vai dar a ela um presente incrível... e outro presente incrível se você se oferecer para tirar fotos profissionais no aniversário dela, ou quase."

# game/scripts/c19/c19.rpy:2399
translate brazilian c19s004_MaddieDebbie_fc818920:

    # mc "Tengo una pregunta, hablando de regalos. ¿Qué ha sido del cuadro de Zeus disfrazado de superhéroe?"
    mc "A propósito de presentes, tenho uma pergunta. O que aconteceu com o quadro de Zeus vestido de super-herói?"

# game/scripts/c19/c19.rpy:2400
translate brazilian c19s004_MaddieDebbie_6b57974e:

    # mad "No me gustaba. No estaba tan personalizado como me hubiera gustado. Sabiendo que [dap] quiere dedicarse a la química me pareció una mejor opción."
    mad "Eu não gostei. Não foi tão personalizado quanto eu gostaria. Sabendo que [dap] quer seguir carreira em química, parecia uma opção melhor."

# game/scripts/c19/c19.rpy:2401
translate brazilian c19s004_MaddieDebbie_3a40886a:

    # mc "Es una buena razón. Me ha gustado más el de químico que el de superhéroe."
    mc "É uma boa razão. Gostei mais da história do químico do que da do super-herói."

# game/scripts/c19/c19.rpy:2402
translate brazilian c19s004_MaddieDebbie_231faf9e:

    # mad "*Risa* El de superhéroe se quedará en mi pared cuando lo acabe. Lo dejé apartado mientras pintaba el de químico."
    mad "*Risos* O do super-herói vai ficar na minha parede quando eu terminar. Deixei de lado enquanto pintava o do químico."

# game/scripts/c19/c19.rpy:2405
translate brazilian c19s004_MaddieDebbie_c3a76666:

    # deb "¿Interrumpo algo?"
    deb "Estou interrompendo alguma coisa?"

# game/scripts/c19/c19.rpy:2407
translate brazilian c19s004_MaddieDebbie_5dfa73fe:

    # mc "No, Debbie, estábamos hablando de las fotos de [emm]."
    mc "Não, Debbie, estávamos falando das fotos de [emm]."

# game/scripts/c19/c19.rpy:2409
translate brazilian c19s004_MaddieDebbie_715a205e:

    # deb "¡Oh! ¡Son fantásticas! Tiene muy buen ojo para la composición y la luz... al menos eso dice Lisa. Yo no entiendo de fotografía."
    deb "Ah! Elas são fantásticas! Ela tem um ótimo olhar para composição e luz... pelo menos é o que a Lisa diz. Eu não entendo nada de fotografia."

# game/scripts/c19/c19.rpy:2410
translate brazilian c19s004_MaddieDebbie_be516646:

    # deb "Yo sólo sé si una foto me gusta o no. Y las de [emm] me gustan. Igual que tus cuadros, Maddie. Son super bonitos y muy graciosos."
    deb "Só eu sei se gosto de uma foto ou não. E eu gosto das fotos da [emm]. Assim como das suas pinturas, Maddie. Elas são lindas e muito engraçadas."

# game/scripts/c19/c19.rpy:2412
translate brazilian c19s004_MaddieDebbie_3bc2500a:

    # mad "Gracias. Fue muy divertido pintarlos y disfrazar a Zeus."
    mad "Obrigada. Foi muito divertido pintá-los e vestir Zeus."

# game/scripts/c19/c19.rpy:2414
translate brazilian c19s004_MaddieDebbie_d403ee6e:

    # deb "¿Lo has traído también?"
    deb "Você também trouxe?"

# game/scripts/c19/c19.rpy:2416
translate brazilian c19s004_MaddieDebbie_aceede83:

    # mad "¿A qué te refieres?"
    mad "O que você está falando?"

# game/scripts/c19/c19.rpy:2418
translate brazilian c19s004_MaddieDebbie_6abc1eb1:

    # deb "Has traído al otro gato, ¿no? Por eso preguntaba si habías traído a Zeus."
    deb "Você trouxe o outro gato, não foi? Por isso que eu perguntei se você trouxe Zeus."

# game/scripts/c19/c19.rpy:2420
translate brazilian c19s004_MaddieDebbie_4c5b75ff:

    # mad "No... solo tengo a Zeus... bueno \"tengo\"... Él seguramente pensaría diferente. ¿Por qué?"
    mad "Não... Eu só tenho Zeus... bem, \"eu tenho\"... Ele certamente pensaria diferente. Por quê?"

# game/scripts/c19/c19.rpy:2422
translate brazilian c19s004_MaddieDebbie_f900d9ac:

    # deb "Cuando he subido a mi habitación, por la ventana se ve el jacuzzi de [nor]. Me ha parecido que Alexia tenía un gato en el regazo."
    deb "Quando subi para o meu quarto, pude ver a jacuzzi de [nor] pela janela. Pensei que Alexia estivesse com um gato no colo."

# game/scripts/c19/c19.rpy:2423
translate brazilian c19s004_MaddieDebbie_2aadbf07:

    # mc "¿El jacuzzi nudista? ¿Un gato negro?"
    mc "Uma jacuzzi para nudistas? Um gato preto?"

# game/scripts/c19/c19.rpy:2425
translate brazilian c19s004_MaddieDebbie_24d0be7e:

    # deb "Sí, pero... ¿cómo... lo... sabes?"
    deb "Sim, mas... como... você... sabe?"

# game/scripts/c19/c19.rpy:2427
translate brazilian c19s004_MaddieDebbie_e6423ea6:

    # deb "¡Oh! ¡No! ¡Era otro tipo de animal peludo!"
    deb "Oh! Não! Era outro tipo de animal peludo!"

# game/scripts/c19/c19.rpy:2429
translate brazilian c19s004_MaddieDebbie_54ef0908:

    # mad "*Risa* ¡Un conejo!"
    mad "*Risos* Um coelho!"

# game/scripts/c19/c19.rpy:2430
translate brazilian c19s004_MaddieDebbie_885c856a:

    # mc "*Risa* Puedes preguntarle a Alexia cómo se llama su mascota."
    mc "*Risos* Você pode perguntar à Alexia qual é o nome do animal de estimação dela."

# game/scripts/c19/c19.rpy:2432
translate brazilian c19s004_MaddieDebbie_a757e446:

    # deb "¡Por el amor de Dios! A veces soy tan pardilla..."
    deb "Pelo amor de Deus! Às vezes sou tão ingênua..."

# game/scripts/c19/c19.rpy:2433
translate brazilian c19s004_MaddieDebbie_9c32f411:

    # mc "No pasa nada, supongo que a esa distancia no podías tener una buena vista."
    mc "Tudo bem, acho que não dava para ter uma boa visão a essa distância."

# game/scripts/c19/c19.rpy:2435
translate brazilian c19s004_MaddieDebbie_dee9d07a:

    # mad "Creo que yo pasaré del jacuzzi nudista. A [eri] le ha costado convencerme para hacer topless..."
    mad "Acho que vou pular a jacuzzi de nudismo. Precisou de muita persuasão para me convencer a ficar de topless..."

# game/scripts/c19/c19.rpy:2436
translate brazilian c19s004_MaddieDebbie_b9efa879:

    # mad "Creía que iba a ser la única que no lo hiciera. Si llego a saber que habría más mujeres tapadas... Aunque te acabas acostumbrando."
    mad "Pensei que seria a única que não usaria. Se eu soubesse que havia mais mulheres cobrindo a cabeça... Embora a gente acabe se acostumando."

# game/scripts/c19/c19.rpy:2438
translate brazilian c19s004_MaddieDebbie_27ba0d3f:

    # deb "Dejaron claro que era opcional. A lo mejor no te lo han transmitido bien."
    deb "Eles deixaram claro que era opcional. Talvez não tenham explicado direito para você."

# game/scripts/c19/c19.rpy:2439
translate brazilian c19s004_MaddieDebbie_0e722984:

    # mc "Debbie tiene razón. Ni en el jacuzzi ni en la piscina hay nada obligatorio. Todo es opcional."
    mc "Debbie tem razão. Nada é obrigatório, nem na jacuzzi nem na piscina. Tudo é opcional."

# game/scripts/c19/c19.rpy:2441
translate brazilian c19s004_MaddieDebbie_99e87ec0:

    # mad "Entonces creo que sí que voy a ir. Me apetece un rato relajante. ¿Os apuntáis?"
    mad "Então acho que vou indo. Quero relaxar um pouco. Você vem?"

# game/scripts/c19/c19.rpy:2442
translate brazilian c19s004_MaddieDebbie_f403ae00:

    # deb "Si a [mc] no le importa que le dejemos solo... si no se quiere apuntar, claro."
    deb "Se [mc] não se importar de ser deixado em paz... se ele não quiser se inscrever, é claro."

# game/scripts/c19/c19.rpy:2444
translate brazilian c19s004_MaddieDebbie_cfdb49fc:

    # mc "No os preocupéis. Acabo de ver que Meemaw se ha quedado sola y quiero hablar con ella. Id y disfrutad."
    mc "Não se preocupem. Eu só vi que a vovó está sozinha e quero falar com ela. Vão e divirtam-se."

# game/scripts/c19/c19.rpy:2513
translate brazilian c19s005_Meemaw_efa0a712:

    # mc "¿Qué tal, Meemaw? ¿Ya te has cansado de los abrazos? *Risa* Te veo muy apartada."
    mc "Ei, vovó, como vai? Já está cansada de abraços? *Risos* Você parece muito distante."

# game/scripts/c19/c19.rpy:2514
translate brazilian c19s005_Meemaw_3b7b48ed:

    # mee "No. *Risa* De eso nunca me canso. Pero necesitaba un momento a solas."
    mee "Não. *Risos* Nunca me canso disso. Mas eu precisava de um momento sozinha."

# game/scripts/c19/c19.rpy:2516
translate brazilian c19s005_Meemaw_990bf3c5:

    # mee "He entendido cómo se tuvieron que sentir Amanda y Eva."
    mee "Compreendo como Amanda e Eva devem ter se sentido."

# game/scripts/c19/c19.rpy:2517
translate brazilian c19s005_Meemaw_253f8e22:

    # mee "Estoy... abrumada..."
    mee "Estou... sobrecarregado(a)..."

# game/scripts/c19/c19.rpy:2518
translate brazilian c19s005_Meemaw_49d7607e:

    # mc "Con la bomba que has dejado caer... las bombas, si incluimos la mudanza... ¿Esperabas otra reacción?"
    mc "Com a bomba que você soltou... as bombas, se incluirmos a mudança... Você esperava uma reação diferente?"

# game/scripts/c19/c19.rpy:2520
translate brazilian c19s005_Meemaw_66c61ef7:

    # mee "No de las chicas..."
    mee "Nenhuma das garotas..."

# game/scripts/c19/c19.rpy:2522
translate brazilian c19s005_Meemaw_0f63f396:

    # mee "Y cuando hablo de las chicas incluyo a mis hijas."
    mee "E quando falo de meninas, incluo minhas filhas."

# game/scripts/c19/c19.rpy:2524
translate brazilian c19s005_Meemaw_8f566270:

    # mee "Y cuando hablo de las chicas incluyo a [nor] y [mar]."
    mee "E quando falo das meninas, incluo [nor] e [mar]."

# game/scripts/c19/c19.rpy:2526
translate brazilian c19s005_Meemaw_f13292ff:

    # mee "Pero me ha sorprendido mucho cómo se han comportado el resto de las chicas..."
    mee "Mas fiquei muito surpresa com o comportamento das outras meninas..."

# game/scripts/c19/c19.rpy:2527
translate brazilian c19s005_Meemaw_e95d6748:

    # mc "Te has ganado su cariño en los últimos días, Meemaw. Casi todas se sienten parte de la familia, y os ven a Tía Betty y a ti de una forma especial."
    mc "Você conquistou o coração deles nesses últimos dias, vovó. Quase todos se sentem parte da família e têm um carinho especial por você e pela tia Betty."

# game/scripts/c19/c19.rpy:2528
translate brazilian c19s005_Meemaw_bfb08a0c:

    # mc "No te digo que alguien como Maddie, que es la primera vez que viene, sienta eso, ¿pero el resto? Seguro que sí."
    mc "Não estou dizendo que alguém como a Maddie, que está aqui pela primeira vez, se sinta assim, mas e os outros? Tenho certeza que sim."

# game/scripts/c19/c19.rpy:2530
translate brazilian c19s005_Meemaw_d2bb86d3:

    # mee "El cariño es mutuo, [mc]. Pero... no sé... ha habido casi demasiados abrazos y ha sido muy emocionante."
    mee "O afeto é mútuo, [mc]. Mas... não sei... houve abraços demais e foi muito emocionante."

# game/scripts/c19/c19.rpy:2531
translate brazilian c19s005_Meemaw_1914d8e5:

    # mc "Entonces no te ofreceré el abrazo que venía a darte."
    mc "Então não vou te dar o abraço que vim te dar."

# game/scripts/c19/c19.rpy:2532
translate brazilian c19s005_Meemaw_f4eac813:

    # mc "Me voy a abrazar a otras chicas por ahí... seguro que ellas sí que lo necesitan. *Risa*"
    mc "Vou abraçar outras garotas por aí... Tenho certeza de que elas realmente precisam disso. *Risos*"

# game/scripts/c19/c19.rpy:2534
translate brazilian c19s005_Meemaw_f4c5a07d:

    # mee "¡Ni se te ocurra! Nunca le niegues un abrazo a una anciana. *Risa*"
    mee "Nem pense nisso! Nunca negue um abraço a uma senhora idosa. *Risos*"

# game/scripts/c19/c19.rpy:2535
translate brazilian c19s005_Meemaw_e2e05749:

    # mc "*Risa* Sabía que ibas de farol..."
    mc "*Risos* Eu sabia que você estava blefando..."

# game/scripts/c19/c19.rpy:2537
translate brazilian c19s005_Meemaw_43b45589:

    # mee "Cuando te suelte... dentro de un par de horas... ¿quieres sentarte un rato conmigo?"
    mee "Quando eu te liberar... daqui a algumas horas... você gostaria de ficar um pouco comigo?"

# game/scripts/c19/c19.rpy:2538
translate brazilian c19s005_Meemaw_f6156b94:

    # mc "Por supuesto. Pero solo queda un sillón. ¿Quién se ha llevado el otro?"
    mc "Claro. Mas só sobrou uma poltrona. Quem levou a outra?"

# game/scripts/c19/c19.rpy:2540
translate brazilian c19s005_Meemaw_c5cfc7cd:

    # mee "No lo sé... el único de quien no sospecho es de Jamaal... *Risa* Viene con asiento incorporado."
    mee "Não sei... o único de quem não suspeito é o Jamaal... *Risos* Ele já vem com um assento embutido."

# game/scripts/c19/c19.rpy:2541
translate brazilian c19s005_Meemaw_b393a9b8:

    # mc "*Risa* Me encanta que te unas al grupo de Whack a Jamaal. Lo del estante de arriba de antes ha sido ingenioso."
    mc "*Risos* Adorei que você vai participar do grupo Whack a Jamaal. A parte sobre a prateleira de cima foi genial."

# game/scripts/c19/c19.rpy:2542
translate brazilian c19s005_Meemaw_beef2d1f:

    # mee "Si no me hubiera pedido leche para sus pastitas no lo habría hecho. *Risa*"
    mee "Se ela não tivesse me pedido leite para os biscoitos, eu não teria feito. *Risos*"

# game/scripts/c19/c19.rpy:2543
translate brazilian c19s005_Meemaw_fb5a2c3c:

    # mc "Pues te tendrás que sentar en mis rodillas. No creo que yo pueda sentarme en las tuyas después de tantos años. *Risa*"
    mc "Bem, você vai ter que sentar no meu colo. Acho que não consigo sentar no seu depois de todos esses anos. *Risos*"

# game/scripts/c19/c19.rpy:2546
translate brazilian c19s005_Meemaw_3930f6de:

    # mee "Por cierto, felicidades por la paternidad. Me vas a hacer bisabuela... Cuando te pedí bisnietos en el aeropuerto no me imaginaba que sería tan pronto."
    mee "Aliás, parabéns por se tornar pai. Você vai me fazer bisavó... Quando te pedi bisnetos no aeroporto, jamais imaginei que aconteceria tão cedo."

# game/scripts/c19/c19.rpy:2548
translate brazilian c19s005_Meemaw_683c9096:

    # mc "Por partida doble en el caso de [dap]."
    mc "Isso é duplamente verdadeiro no caso de [dap]."

# game/scripts/c19/c19.rpy:2550
translate brazilian c19s005_Meemaw_3347e1a0:

    # mee "Y aún podrían llegar más que me hicieran doblemente bisabuela."
    mee "E ainda pode haver mais coisas que me tornariam uma bisavó dupla."

# game/scripts/c19/c19.rpy:2551
translate brazilian c19s005_Meemaw_5a963f79:

    # mc "No estaba planeado, pero han llegado y estoy contento."
    mc "Não estava planejado, mas eles chegaram e estou feliz."

# game/scripts/c19/c19.rpy:2552
translate brazilian c19s005_Meemaw_8905cdcf:

    # mee "Yo también. Esta familia cada vez es más rara, pero cada vez me gusta más."
    mee "Eu também. Essa família está ficando cada vez mais estranha, mas eu gosto cada vez mais dela."

# game/scripts/c19/c19.rpy:2555
translate brazilian c19s005_Meemaw_f97f9ee2:

    # mc "Al menos con la revelación de tu secreto, nadie ha prestado demasiada atención a mis relaciones."
    mc "Pelo menos, com a revelação do seu segredo, ninguém tem prestado muita atenção aos meus relacionamentos."

# game/scripts/c19/c19.rpy:2556
translate brazilian c19s005_Meemaw_83d9c8f0:

    # mee "En parte lo he hecho por eso. Era un buen momento antes de que nadie se escandalizara o se sorprendiera demasiado de que salieras con más de una mujer."
    mee "Fiz isso em parte por esse motivo. Era uma boa época, antes que alguém ficasse muito escandalizado ou surpreso por você estar saindo com mais de uma mulher."

# game/scripts/c19/c19.rpy:2557
translate brazilian c19s005_Meemaw_cb20e64a:

    # mee "Hay gente muy retrógrada en esta familia... y yo soy una de ellas. Quizás la que más."
    mee "Há algumas pessoas muito retrógradas nesta família... e eu sou uma delas. Talvez a mais retrógrada de todas."

# game/scripts/c19/c19.rpy:2558
translate brazilian c19s005_Meemaw_7970aee0:

    # mee "Si yo lo tengo que aceptar... el resto también. Que se jodan."
    mee "Se eu tiver que aceitar... então todos os outros também terão que aceitar. Que se danem."

# game/scripts/c19/c19.rpy:2559
translate brazilian c19s005_Meemaw_06a3e9b9:

    # mc "*Risa* A veces eres maravillosa, Meemaw."
    mc "*Risos* Às vezes você é maravilhosa, vovó."

# game/scripts/c19/c19.rpy:2561
translate brazilian c19s005_Meemaw_35e4ae37:

    # mee "*Risa* ¿Sólo a veces?"
    mee "*Risos* Só às vezes?"

# game/scripts/c19/c19.rpy:2562
translate brazilian c19s005_Meemaw_6d9fd2ee:

    # mc "Sí, [emm]... digo... Meemaw. *Risa*"
    mc "Sim, [emm]... Quer dizer... Vovó. *Risos*"

# game/scripts/c19/c19.rpy:2564
translate brazilian c19s005_Meemaw_025d666b:

    # mc "¿Cómo sienta salir a la luz con tus secretos?"
    mc "Como se sente ao revelar seus segredos?"

# game/scripts/c19/c19.rpy:2565
translate brazilian c19s005_Meemaw_0aa5eb83:

    # mee "Cuando he empezado a hablar estaba asustada. No sabía cómo se lo iban a tomar. Lo he ocultado durante demasiado tiempo y temía la reacción de [nor]."
    mee "Quando comecei a falar, fiquei com medo. Não sabia como eles reagiriam. Eu tinha escondido isso por muito tempo e estava com medo da reação de [nor]."

# game/scripts/c19/c19.rpy:2566
translate brazilian c19s005_Meemaw_1c81faaa:

    # mee "Y la de [emm]. Nunca sabes por dónde puede explotar esa chica."
    mee "E aquela de [emm]. Nunca se sabe o que aquela garota pode fazer em seguida."

# game/scripts/c19/c19.rpy:2568
translate brazilian c19s005_Meemaw_f33f1e37:

    # mee "Y entonces [emm] ha hablado, sin dejar reaccionar a nadie."
    mee "E então [emm] falou, sem deixar ninguém reagir."

# game/scripts/c19/c19.rpy:2569
translate brazilian c19s005_Meemaw_d236c436:

    # mee "Cuando ha venido a abrazarme, casi se me saltan las lágrimas. Después han venido el resto... ha sido increíble."
    mee "Quando ele veio me abraçar, quase desabei em lágrimas. Depois veio o resto... foi incrível."

# game/scripts/c19/c19.rpy:2570
translate brazilian c19s005_Meemaw_82490061:

    # mc "No era el momento de echarte en cara que hubieras guardado el secreto. Todas estaban muy contentas con que lo hubieras superado."
    mc "Não era hora de te repreender por guardar o segredo. Todos ficaram muito felizes por você ter superado isso."

# game/scripts/c19/c19.rpy:2572
translate brazilian c19s005_Meemaw_0127ebab:

    # mee "Cuando han pasado los abrazos, [nor] me lo ha echado en cara. Pero de una forma diferente a como esperaba..."
    mee "Depois dos abraços, [nor] me confrontou sobre isso. Mas de uma forma diferente da que eu esperava..."

# game/scripts/c19/c19.rpy:2573
