# game/scripts/c19/c19.rpy:895
translate brazilian c19s002_Simone_0107b8f9:

    # mc "En la playa no te importó quién hubiera. No sé por qué te tiene que importar contárselo una vez pase este fin de semana."
    mc "Você não se importou com quem estava na praia. Não sei por que você deveria se importar em contar para eles depois deste fim de semana."

# game/scripts/c19/c19.rpy:897
translate brazilian c19s002_Simone_bd8620de:

    # sim "Me parece una buena idea. A ver si podemos decírselo un día de la semana que viene."
    sim "Parece uma boa ideia. Vamos ver se conseguimos contar para ele na semana que vem."

# game/scripts/c19/c19.rpy:898
translate brazilian c19s002_Simone_afbee7a6:

    # sim "¿Bajamos?"
    sim "Vamos descer?"

# game/scripts/c19/c19.rpy:899
translate brazilian c19s002_Simone_63cd8ebd:

    # mc "Vamos."
    mc "Vamos."

# game/scripts/c19/c19.rpy:903
translate brazilian c19s002_Simone_527a9781:

    # "[mar] te llama cuando pasas por delante de la cocina. Simone continúa bajando."
    "[mar] te chama quando você passa pela cozinha. Simone continua descendo as escadas."

# game/scripts/c19/c19.rpy:905
translate brazilian c19s002_Simone_eeb45310:

    # "Sigilosamente."
    "Furtivamente."

# game/scripts/c19/c19.rpy:906
translate brazilian c19s002_Simone_33f8d209:

    # "Sus piernas aguantan mejor de lo que ella pensaba."
    "As pernas dela estão aguentando melhor do que ela imaginava."

# game/scripts/c19/c19.rpy:908
translate brazilian c19s002_Simone_80b51a6f:

    # mom "¿Puedes bajar esas cosas mientras acabo esto? Es lo último que queda por bajar."
    mom "Você pode baixar esses arquivos enquanto eu termino isso? É a última coisa que falta baixar."

# game/scripts/c19/c19.rpy:909
translate brazilian c19s002_Simone_274e9fc0:

    # mc "¿Aún estás cocinando?"
    mc "Você ainda está cozinhando?"

# game/scripts/c19/c19.rpy:911
translate brazilian c19s002_Simone_20ccee0a:

    # mom "Sí, un imprevisto. Samantha estaba buscando a Simone hace un rato."
    mom "Sim, um acontecimento inesperado. Samantha estava procurando por Simone há pouco tempo."

# game/scripts/c19/c19.rpy:912
translate brazilian c19s002_Simone_3236cccb:

    # mom "[emm] le ha dicho que estaba en el lavabo desde que se han cambiado... por lo visto la pobre chica tiene diarrea."
    mom "[emm] disse a ela que estava no banheiro desde que eles se trocaram... aparentemente a pobre garota está com diarreia."

# game/scripts/c19/c19.rpy:913
translate brazilian c19s002_Simone_7a4cd27f:

    # mom "Le estoy haciendo un poco de arroz hervido. No va a poder comer la mayoría de las cosas que hemos preparado si está mal del estómago."
    mom "Estou preparando arroz cozido para ele. Ele não vai conseguir comer a maioria das coisas que preparamos se estiver com dor de estômago."

# game/scripts/c19/c19.rpy:914
translate brazilian c19s002_Simone_4eea99ab:

    # mc "Pobre Simone, con lo que le gustan tus pasteles."
    mc "Coitada da Simone, ela adora tanto seus bolos."

# game/scripts/c19/c19.rpy:915
translate brazilian c19s002_Simone_489e2eb0:

    # mcp "(¿Algún tipo de broma por parte de [emm]? ¿O no se le ha ocurrido una excusa mejor para cubrirnos?)"
    mcp "(Será que [emm] está a pregar uma peça? Ou não podiam ter inventado uma desculpa melhor para nos acobertar?)"

# game/scripts/c19/c19.rpy:916
translate brazilian c19s002_Simone_51901cc9:

    # mc "Vale, bajo esto. No tardes demasiado, o Tía Betty y Jamaal van a matar a alguien si no pueden empezar a comer."
    mc "Certo, vou anotar isso. Não demore muito, ou a tia Betty e o Jamaal vão matar alguém se não começarem a comer."

# game/scripts/c19/c19.rpy:918
translate brazilian c19s002_Simone_8f633f00:

    # mom "Vale. Te veo abajo."
    mom "Certo. Te vejo lá embaixo."

# game/scripts/c19/c19.rpy:920
translate brazilian c19s002_Simone_2bfaa87a:

    # "Cuando toda la comida está en la piscina, empieza la fiesta."
    "Quando toda a comida estiver na piscina, a festa começa."

# game/scripts/c19/c19.rpy:960
translate brazilian c19s003_Gifts_652a5657:

    # "En seguida se forman grupos de chicas para comer juntas. Esta vez, a diferencia de la comida de Navidad, no hace falta organizarlo como hizo Scarlett."
    "Rapidamente, grupos de meninas se formam para comer juntas. Desta vez, ao contrário do almoço de Natal, não há necessidade de organizá-lo como Scarlett fez."

# game/scripts/c19/c19.rpy:961
translate brazilian c19s003_Gifts_f5d70af6:

    # "Todas quieren hablar con todas, especialmente con las que menos contacto tienen. [emm] está en su salsa."
    "Todos querem conversar uns com os outros, especialmente aqueles com quem têm menos contato. [emm] Ela está em seu elemento."

# game/scripts/c19/c19.rpy:963
translate brazilian c19s003_Gifts_878d04a2:

    # "O con las que son más afines con ellas. Kim no es capaz de separarse de [mar] más de unos pocos minutos."
    "Ou com aqueles que são mais compatíveis com eles. Kim é incapaz de se separar de [mar] por mais de alguns minutos."

# game/scripts/c19/c19.rpy:970
translate brazilian c19s003_Gifts_fd44337a:

    # "También hay grupos en los que no se puede intuir afinidad ninguna a simple vista, pero todo se desarrolla de buen rollo."
    "Existem também grupos onde, à primeira vista, não se percebe nenhuma afinidade, mas tudo se desenrola num ambiente amigável."

# game/scripts/c19/c19.rpy:972
translate brazilian c19s003_Gifts_bdf06753:

    # "O grupos realmente peligrosos a los que acercarse. Si te unes a ese trío sabes que vas a salir escaldado."
    "Ou grupos realmente perigosos dos quais é difícil se aproximar. Se você entrar para esse trio, sabe que vai se dar mal."

# game/scripts/c19/c19.rpy:978
translate brazilian c19s003_Gifts_0c3b2183:

    # "Eileen se ha perdido muchos de los últimos eventos debido a su trabajo, y no pierde oportunidad en asaltar a las chicas nuevas."
    "Eileen perdeu muitos dos eventos recentes devido ao seu trabalho, e não perde uma oportunidade de agredir as garotas novas."

# game/scripts/c19/c19.rpy:984
translate brazilian c19s003_Gifts_5b828359:

    # "Maddie se ha convertido en la novedad y siempre está escoltada por una o dos chicas como mínimo para hacerla sentir a gusto."
    "Maddie se tornou a nova sensação e está sempre acompanhada por pelo menos uma ou duas garotas para que se sinta à vontade."

# game/scripts/c19/c19.rpy:986
translate brazilian c19s003_Gifts_2c5d1bf5:

    # "Pero hay algo en su actitud que dice que no se siente parte de todo esto."
    "Mas há algo em sua atitude que demonstra que ele não se sente parte de tudo isso."

# game/scripts/c19/c19.rpy:988
translate brazilian c19s003_Gifts_c8f0c085:

    # "Poco a poco se va integrando, pero está claro que esto es nuevo para ella."
    "Ela está se adaptando aos poucos, mas é evidente que isso é novo para ela."

# game/scripts/c19/c19.rpy:993
translate brazilian c19s003_Gifts_1c27b9d3:

    # "Es su primera visita a casa, al fin y al cabo."
    "Afinal, é a primeira vez que ele visita a casa."

# game/scripts/c19/c19.rpy:1000
translate brazilian c19s003_Gifts_424fc071:

    # "Lo mismo pasa con las chicas del cumpleaños. Es imposible pillarlas a solas en ningún momento."
    "O mesmo acontece com as aniversariantes. É impossível encontrá-las sozinhas em qualquer momento."

# game/scripts/c19/c19.rpy:1006
translate brazilian c19s003_Gifts_d96cf42c:

    # "Y Olivia no puede dejar pasar la oportunidad de pasar más tiempo con sus nuevas nietas. No te has dado cuenta de cuándo Amanda y Alexia se han hecho amigas."
    "E Olivia não pode perder a oportunidade de passar mais tempo com suas novas netinhas. Você nem percebeu quando Amanda e Alexia se tornaram amigas."

# game/scripts/c19/c19.rpy:1013
translate brazilian c19s003_Gifts_0b6737c0:

    # "Puedes ver como [emm] le pasa comida a Simone a escondidas para paliar un poco su mierda de excusa."
    "Você pode ver como [emm] secretamente passa comida para Simone para amenizar um pouco sua desculpa esfarrapada."

# game/scripts/c19/c19.rpy:1016
translate brazilian c19s003_Gifts_2ff4d609:

    # "[emm] y Simone están conversando animadamente."
    "[emm] e Simone estão conversando animadamente."

# game/scripts/c19/c19.rpy:1017
translate brazilian c19s003_Gifts_ccc4c8ae:

    # "Decides acercarte a ellas."
    "Você decide abordá-los."

# game/scripts/c19/c19.rpy:1019
translate brazilian c19s003_Gifts_25255d85:

    # mc "¿Qué tal os lo estáis pasando, chicas?"
    mc "Como vocês estão, meninas?"

# game/scripts/c19/c19.rpy:1020
translate brazilian c19s003_Gifts_77e1b186:

    # emm "¡Genial! ¡Tener tanta gente en casa es alucinante!"
    emm "Que ótimo! Ter tanta gente em casa é maravilhoso!"

# game/scripts/c19/c19.rpy:1021
translate brazilian c19s003_Gifts_13fcc421:

    # sim "Está muy bien. Además, si miras a todo el mundo, te das cuenta de que no hay ningún mal rollo pendiente. Eso es rarísimo con tanta gente."
    sim "É ótimo. Além disso, se você olhar em volta, vai perceber que não há ressentimentos. Isso é muito raro com tanta gente."

# game/scripts/c19/c19.rpy:1023
translate brazilian c19s003_Gifts_eed00e93:

    # mc "¿Ningún mal rollo? ¿Ni siquiera por inventar excusas de mierda? *Risa*"
    mc "Nenhuma energia negativa? Nem mesmo por inventar desculpas esfarrapadas? *Risos*"

# game/scripts/c19/c19.rpy:1025
translate brazilian c19s003_Gifts_bfe67ac3:

    # sim "Se está portando bien para compensarme. *Risa* Me está trayendo comida de verdad que meto en el bol de arroz."
    sim "Ele está sendo gentil para compensar. *Risos* Ele está me trazendo comida de verdade que eu coloco na minha tigela de arroz."

# game/scripts/c19/c19.rpy:1026
translate brazilian c19s003_Gifts_95d73018:

    # emm "¡No es culpa mía! Si no os hubierais puesto a follar como conejos no hubiera tenido que inventar esa excusa de mierda."
    emm "Não é minha culpa! Se vocês não tivessem começado a transar como coelhos, eu não teria precisado inventar essa desculpa esfarrapada."

# game/scripts/c19/c19.rpy:1027
translate brazilian c19s003_Gifts_adf592d0:

    # mc "Excusa de mierda... sobre diarrea. *Risa* ¿En qué estás pensando hoy, [emm]?"
    mc "Desculpa esfarrapada... sobre diarreia. *Risos* No que você está pensando hoje, [emm]?"

# game/scripts/c19/c19.rpy:1029
translate brazilian c19s003_Gifts_9ebfe424:

    # emm "*Risa* ¡No lo había pensado!" (multiple=2)
    emm "*Risos* Eu não tinha pensado nisso!" (multiple=2)

# game/scripts/c19/c19.rpy:1030
translate brazilian c19s003_Gifts_0550bcae:

    # sim "*Risa* ¡Es verdad!" (multiple=2)
    sim "*Risos* É verdade!" (multiple=2)

# game/scripts/c19/c19.rpy:1032
translate brazilian c19s003_Gifts_bb03f452:

    # emm "Y no me digas que no pienso nunca. *Gruñido*"
    emm "E não me diga que eu nunca penso. *Grunhido*"

# game/scripts/c19/c19.rpy:1033
translate brazilian c19s003_Gifts_cd30365c:

    # mc "No pensaba decirlo, no te preocupes. *Risa* Pero ¿puedo pensarlo aunque sea tu cumpleaños?"
    mc "Eu não ia dizer isso, não se preocupe. *Risos* Mas posso pensar nisso mesmo sendo seu aniversário?"

# game/scripts/c19/c19.rpy:1035
translate brazilian c19s003_Gifts_c3c2af19:

    # mc "Todos vamos con pies de plomo para no fastidiar el cumpleaños. *Risa* Imagínate a [emm] enfadada un día como hoy."
    mc "Estamos todos agindo com cuidado para não estragar o aniversário. *Risos* Imagine [emm] ficar bravo num dia como hoje."

# game/scripts/c19/c19.rpy:1037
translate brazilian c19s003_Gifts_a49e20c0:

    # emm "Por mucho que lo intentéis, hoy no voy a enfadarme por nada. Toda la familia está aquí y eso es suficiente para pasárselo bien."
    emm "Por mais que você tente, não vou me irritar com nada hoje. Toda a família está aqui, e isso já é o suficiente para nos divertirmos."

# game/scripts/c19/c19.rpy:1038
translate brazilian c19s003_Gifts_b356810d:

    # emm "A menos que mi hermano me haga un regalo... de mierda. *Risa*"
    emm "A menos que meu irmão me dê um presente horrível. *Risos*"

# game/scripts/c19/c19.rpy:1039
translate brazilian c19s003_Gifts_bcf66f4a:

    # mc "Estoy seguro de que te va a gustar, no te preocupes. Aunque no lo puedas disfrutar hoy."
    mc "Tenho certeza de que você vai gostar, não se preocupe. Mesmo que não possa aproveitar hoje."

# game/scripts/c19/c19.rpy:1041
translate brazilian c19s003_Gifts_4fa7b2d5:

    # sim "¡Eso es cruel por tu parte, [mc]! *Risa*"
    sim "Que crueldade a sua, [mc]! *Risos*"

# game/scripts/c19/c19.rpy:1043
translate brazilian c19s003_Gifts_571327f2:

    # sim "Aunque se lo merezca por sus excusas de mierda."
    sim "Mesmo que ele mereça por suas desculpas esfarrapadas."

# game/scripts/c19/c19.rpy:1044
translate brazilian c19s003_Gifts_99cb2a14:

    # mc "También estoy seguro de que no le va a importar esperar para disfrutarlo."
    mc "Tenho certeza também de que ele não se importará de esperar para aproveitar."

# game/scripts/c19/c19.rpy:1046
translate brazilian c19s003_Gifts_534a2ad1:

    # emm "Me voy a tener que fiar de ti, pero ahora estoy ansiosa. ¿Por qué todo el mundo come tan lento? *Risa* ¿No se dan cuenta de que cuanto más tarden en comer más tardaremos en recibir los regalos?"
    emm "Vou ter que confiar em você, mas agora estou ansiosa. Por que todo mundo está comendo tão devagar? *Risos* Será que eles não percebem que quanto mais tempo demorarem para comer, mais tempo vai demorar para recebermos nossos presentes?"

# game/scripts/c19/c19.rpy:1047
translate brazilian c19s003_Gifts_69fddffa:

    # sim "Para tu próximo cumpleaños compra unos embudos y nos cebas a todos como a pollos. *Risa*"
    sim "No seu próximo aniversário, compre uns funis e nos alimente como galinhas. *Risos*"

# game/scripts/c19/c19.rpy:1048
translate brazilian c19s003_Gifts_b763bd8b:

    # emm "Ve a meterles prisa, [mc]. *Risa* Diles que estoy a punto de sufrir un infarto por la ansiedad de saber qué me habéis regalado."
    emm "Vai lá e apressa eles, [mc]. *Risos* Diga a eles que estou prestes a ter um ataque cardíaco de tanta ansiedade por não saber o que você me deu."

# game/scripts/c19/c19.rpy:1050
translate brazilian c19s003_Gifts_e2754d2f:

    # mc "Rara forma de comportarse para la adulta de la casa. *Risa*"
    mc "Que comportamento estranho para o adulto da casa. *Risos*"

# game/scripts/c19/c19.rpy:1051
translate brazilian c19s003_Gifts_5983cb22:

    # mc "Vale, voy a ello. Os veo luego."
    mc "Certo, vou começar. Até mais."

# game/scripts/c19/c19.rpy:1053
translate brazilian c19s003_Gifts_38a76f30:

    # "Te acercas al grupo de los bromistas. Al menos bromistas cuando tú estás cerca y puedes ser el centro de sus bromas."
    "Você está se aproximando do grupo de brincalhões. Pelo menos eles são brincalhões quando você está por perto e pode ser o alvo das piadas deles."

# game/scripts/c19/c19.rpy:1054
translate brazilian c19s003_Gifts_7b7ba207:

    # "Quizás te salve que Kate y Jamaal aún no se conocen lo suficiente."
    "Talvez isso te poupe o fato de que Kate e Jamaal ainda não se conhecem bem o suficiente."

# game/scripts/c19/c19.rpy:1055
translate brazilian c19s003_Gifts_d419d581:

    # mc "¿Qué tal lo estáis pasando por aquí?"
    mc "Como vocês estão por aqui?"

# game/scripts/c19/c19.rpy:1056
translate brazilian c19s003_Gifts_399e9378:

    # jam "Bien hasta que has llegado. *Risa* Tengo a estas chicas tan guapas trayéndome comida y ahora la tendré que compartir contigo."
    jam "Bom, você está aqui agora. *Risos* Tenho essas lindas moças me trazendo comida, e agora terei que dividir com você."

# game/scripts/c19/c19.rpy:1057
translate brazilian c19s003_Gifts_1579c0c8:

    # bet "No te pases con [mc], Jamaal. *Risa* El pobre chico lleva un día de locos."
    bet "Não exagere no [mc], Jamaal. *Risos* O coitado está tendo um dia louco."

# game/scripts/c19/c19.rpy:1058
translate brazilian c19s003_Gifts_004e5557:

    # kat "¿Un día? *Risa* Creo que cuando acabe la fiesta vendrán a buscarlo del manicomio más cercano."
    kat "Um dia? *Risos* Acho que quando a festa acabar, vão procurá-lo no hospital psiquiátrico mais próximo."

# game/scripts/c19/c19.rpy:1059
translate brazilian c19s003_Gifts_eedcdcc5:

    # "De acuerdo. Nada te va a salvar de ser el centro de las bromas."
    "Certo. Nada vai te salvar de ser alvo de piadas."

# game/scripts/c19/c19.rpy:1060
translate brazilian c19s003_Gifts_34ea3fb8:

    # mc "No te preocupes por la comida, Jamaal. Ya no como tanto como comía antes."
    mc "Não se preocupe com a comida, Jamaal. Eu não como tanto quanto antes."

# game/scripts/c19/c19.rpy:1062
translate brazilian c19s003_Gifts_9dbf5d27:

    # jam "Es una suerte para todos. Tienes que llevar una vida sana y dejarnos la comida a Betty, Kate, y a mí."
    jam "É uma sorte para todos. Você tem que levar uma vida saudável e deixar a comida para Betty, Kate e para mim."

# game/scripts/c19/c19.rpy:1063
translate brazilian c19s003_Gifts_2c27d5b5:

    # mc "Estoy seguro de que comes más de lo que te toca y dejas a estas señoritas sin su parte."
    mc "Tenho certeza de que você come mais do que a sua parte e deixa essas senhoras sem a delas."

# game/scripts/c19/c19.rpy:1065
translate brazilian c19s003_Gifts_2d7262a9:

    # kat "Yo no puedo comer mucho por tu culpa, [mc]. Me duelen tanto los brazos de tanto nadar que casi no puedo aguantar el plato. Y Jamaal es un devorador de rollitos."
    kat "Não consigo comer muito por sua causa, [mc]. Meus braços doem tanto de tanto nadar que mal consigo segurar o prato. E Jamaal adora pãezinhos."

# game/scripts/c19/c19.rpy:1066
translate brazilian c19s003_Gifts_208d246a:

    # mc "Puedes usar a Jamaal de carrito de la comida. No se va a ir corriendo a ningún sitio y es bastante estable. Pero marca cuál es tu plato."
    mc "Você pode usar o Jamaal como um carrinho de comida. Ele não vai fugir e é bem estável. Mas marque qual prato é seu."

# game/scripts/c19/c19.rpy:1068
translate brazilian c19s003_Gifts_4c2fc65c:

    # bet "No es mala idea. *Risa* Lo podemos llevar arriba y abajo en vez de dar tantos viajes nosotras. Le podemos poner una bandeja encima de las piernas y quitarle el pollo frito."
    bet "Não é uma má ideia. *Risos* Podemos carregá-lo para cima e para baixo em vez de fazermos tantas viagens nós mesmos. Podemos colocar uma bandeja nas pernas dele e levar o frango frito embora."

# game/scripts/c19/c19.rpy:1069
translate brazilian c19s003_Gifts_667029c7:

    # mc "Sólo si lo queréis ver llorar. *Risa* Ese pollo lo hace [mar] casi exclusivamente para él."
    mc "Só se você quiser vê-lo chorar. *Risos* Essa galinha faz isso [mar] quase exclusivamente para si mesma."

# game/scripts/c19/c19.rpy:1070
translate brazilian c19s003_Gifts_4c2aefc0:

    # mc "Pero podéis aparcarlo al lado de la mesa de la comida. Así está a la sombra y no se le cuece el cerebro."
    mc "Mas você pode estacioná-lo perto da mesa do almoço. Assim, ele ficará na sombra e seu cérebro não cozinhará."

# game/scripts/c19/c19.rpy:1072
translate brazilian c19s003_Gifts_2fdac9e6:

    # jam "Chicas, el trato consistía en meterse con [mc], no conmigo. ¡Y con mi pollo no se juega!"
    jam "Meninas, o combinado era mexer com o [mc], não comigo. E vocês não mexem com o meu frango!"

# game/scripts/c19/c19.rpy:1073
translate brazilian c19s003_Gifts_a46a6666:

    # kat "Si no te hubieras comido el último rollito de calabacín, a lo mejor hubiera respetado el trato. *Risa*"
    kat "Se você não tivesse comido o último rolinho de abobrinha, talvez eu tivesse cumprido o combinado. *Risos*"

# game/scripts/c19/c19.rpy:1074
translate brazilian c19s003_Gifts_49b608bc:

    # bet "Pero es que serías un carrito de la comida fantástico. *Risa* Especialmente si te atamos las manos para que no comas. Nos ahorrarías muchos paseos."
    bet "Mas você seria um carrinho de comida fantástico. *Risos* Principalmente se amarrássemos suas mãos para que você não pudesse comer. Você nos pouparia muitas viagens."

# game/scripts/c19/c19.rpy:1075
translate brazilian c19s003_Gifts_8c14de26:

    # mc "Bueno, yo os dejo discutiendo la logística. Voy a saludar por allí."
    mc "Certo, vou deixar vocês discutirem a logística. Vou dar um alô para lá."

# game/scripts/c19/c19.rpy:1076
translate brazilian c19s003_Gifts_2b739f1b:

    # mcp "(Si no puedes con ellos, desvía la atención hacia uno de ellos.)"
    mcp "(Se você não conseguir lidar com eles, concentre-se em apenas um deles.)"

# game/scripts/c19/c19.rpy:1078
translate brazilian c19s003_Gifts_cc2c5edb:

    # bet "Luego tengo que hablar contigo, [mc]."
    bet "Então eu preciso falar com você, [mc]."

# game/scripts/c19/c19.rpy:1079
translate brazilian c19s003_Gifts_3d7fbf62:

    # mc "Cuando quieras, dime que necesitas."
    mc "Sempre que quiser, diga-me o que precisa."

# game/scripts/c19/c19.rpy:1080
translate brazilian c19s003_Gifts_369e3228:

    # bet "Luego. En privado."
    bet "Mais tarde. Em particular."

# game/scripts/c19/c19.rpy:1081
translate brazilian c19s003_Gifts_46249754:

    # mc "Perfecto. ¿Después de los regalos?"
    mc "Perfeito. E depois dos presentes?"

# game/scripts/c19/c19.rpy:1082
translate brazilian c19s003_Gifts_5f64dbe0:

    # bet "Vale."
    bet "OK."

# game/scripts/c19/c19.rpy:1084
translate brazilian c19s003_Gifts_452f0448:

    # mc "¿Cómo lo estáis pasando?"
    mc "Como vocês estão?"

# game/scripts/c19/c19.rpy:1085
translate brazilian c19s003_Gifts_7823ff68:

    # kim "¡Es impresionante! Nunca había estado en una fiesta familiar tan grande."
    kim "É incrível! Nunca estive numa festa de família tão grande."

# game/scripts/c19/c19.rpy:1086
translate brazilian c19s003_Gifts_77125091:

    # mom "Todo está saliendo bien, la comida no está demasiado fría, ni la bebida demasiado caliente, con lo que no me puedo quejar. Cocinar para 24 personas es complicado."
    mom "Está tudo indo bem; a comida não está muito fria, nem as bebidas muito quentes, então não posso reclamar. Cozinhar para 24 pessoas é complicado."

# game/scripts/c19/c19.rpy:1087
translate brazilian c19s003_Gifts_ebf8d108:

    # mom "No había cocinado para tanta gente desde que dejé de trabajar."
    mom "Eu não cozinhava para tanta gente desde que parei de trabalhar."

# game/scripts/c19/c19.rpy:1088
translate brazilian c19s003_Gifts_8d59ca67:

    # sam "Y además teniendo que hacer opciones veganas para Lisa. [nor] y tu madre se han lucido."
    sam "E além disso, ter que fazer opções veganas para a Lisa. [nor] e sua mãe realmente se superaram."

# game/scripts/c19/c19.rpy:1090
translate brazilian c19s003_Gifts_0e9d180a:

    # sam "Por no hablar del arroz hervido para Simone a última hora. ¡Pobre hija mía! Se está perdiendo esta comida deliciosa."
    sam "Sem falar do arroz cozido de última hora para a Simone. Coitada da minha filha! Ela está perdendo essa refeição deliciosa."

# game/scripts/c19/c19.rpy:1091
translate brazilian c19s003_Gifts_5c517b7b:

    # mc "Está todo genial, Mamá. ¿Cuántos sois en vuestras reuniones familiares, Kim?"
    mc "Está tudo ótimo, mãe. Quantas pessoas comparecem às reuniões de família, Kim?"

# game/scripts/c19/c19.rpy:1093
translate brazilian c19s003_Gifts_cdf6c120:

    # kim "Mi padre, mi madrastra, mi abuelo, mi hermano y yo."
    kim "Meu pai, minha madrasta, meu avô, meu irmão e eu."

# game/scripts/c19/c19.rpy:1094
translate brazilian c19s003_Gifts_1c57be3a:

    # mcp "(No hay madre en esa frase...)"
    mcp "(Não há mãe nessa frase...)"

# game/scripts/c19/c19.rpy:1095
translate brazilian c19s003_Gifts_f92831f0:

    # "Kim parece leerte el pensamiento sin que tengas que pronunciar una palabra."
    "Kim parece ler seus pensamentos sem que você precise dizer uma palavra."

# game/scripts/c19/c19.rpy:1096
translate brazilian c19s003_Gifts_6cafd409:

    # kim "Mi madre no está entre nosotros desde que nació mi hermano, cuando yo tenía dos años."
    kim "Minha mãe não está conosco desde que meu irmão nasceu, quando eu tinha dois anos de idade."

# game/scripts/c19/c19.rpy:1098
translate brazilian c19s003_Gifts_5d140d85:

    # mom "¡Oh, mi niña! ¡No lo sabía! ¡Lo siento mucho!"
    mom "Oh, meu filho! Eu não sabia! Me desculpe!"

# game/scripts/c19/c19.rpy:1099
translate brazilian c19s003_Gifts_3be81e5f:

    # kim "No pasa nada, [mar]. No la recuerdo. Solo he visto fotos y videos suyos. Era guapísima."
    kim "Tudo bem, [mar]. Eu não me lembro dela. Só vi fotos e vídeos dela. Ela era linda."

# game/scripts/c19/c19.rpy:1100
translate brazilian c19s003_Gifts_e43896b5:

    # mom "Como tú, mi niña. Como tú."
    mom "Assim como você, minha garota. Assim como você."

# game/scripts/c19/c19.rpy:1102
translate brazilian c19s003_Gifts_62946987:

    # sam "Si algún día quieres hablar de ello, sabes que nos tienes aquí para lo que necesites."
    sam "Se algum dia quiser conversar sobre isso, sabe que pode contar conosco para o que precisar."

# game/scripts/c19/c19.rpy:1103
translate brazilian c19s003_Gifts_fee9f069:

    # kim "Gracias, Samantha, pero ya os digo que no os tenéis que preocupar. Hace mucho..."
    kim "Obrigada, Samantha, mas eu te digo, você não precisa se preocupar. Já faz muito tempo..."

# game/scripts/c19/c19.rpy:1104
translate brazilian c19s003_Gifts_8fdf2e6d:

    # mc "Puede que haga mucho, pero..."
    mc "Pode fazer muita coisa, mas..."

# game/scripts/c19/c19.rpy:1106
translate brazilian c19s003_Gifts_fb16c012:

    # kim "*Risa* Sí, [mc]. Hay que hablarlo todo. Lo sé."
    kim "*Risos* Sim, [mc]. Precisamos conversar sobre tudo. Eu sei."

# game/scripts/c19/c19.rpy:1107
translate brazilian c19s003_Gifts_22a79e71:

    # sam "Tu manía de hablarlo todo le ha devuelto la sonrisa. *Risa* Tenía que servir de algo."
    sam "Seu hábito de falar sobre tudo trouxe um sorriso de volta ao rosto dela. *Risos* Isso deve ter servido para alguma coisa."

# game/scripts/c19/c19.rpy:1108
translate brazilian c19s003_Gifts_d6f34000:

    # mom "¿Por qué no vas a ver cómo les va a Eva y Amanda? Creo que esta comida también puede ser un poco abrumadora para ellas siendo su primera fiesta... normal."
    mom "Por que você não vai ver como Eva e Amanda estão? Acho que essa refeição pode ser um pouco demais para elas também, já que é a primeira festa delas... o que é normal."

# game/scripts/c19/c19.rpy:1109
translate brazilian c19s003_Gifts_8d027de7:

    # mcp "(Eso es lo más parecido a ordenarme que las deje solas que voy a oír. No quiere que Kim se sienta mal, pero quiere hablar con ella sin que yo esté delante.)"
    mcp "(Essa é a coisa mais próxima de me mandar deixá-las em paz que vou ouvir. Ela não quer que Kim se sinta mal, mas quer conversar com ela sem a minha presença.)"

# game/scripts/c19/c19.rpy:1110
translate brazilian c19s003_Gifts_8bda4aa7:

    # mc "Voy a ver cómo se lo están pasando. Hablamos luego."
    mc "Vou ver como eles estão. Conversamos mais tarde."

# game/scripts/c19/c19.rpy:1112
translate brazilian c19s003_Gifts_4b10166f:

    # mc "Están dos pelirrojas y una rubia en la puerta de un garaje... casi podría parecer el inicio de un chiste."
    mc "Há duas ruivas e uma loira na porta de uma garagem... quase poderia ser o início de uma piada."

# game/scripts/c19/c19.rpy:1113
translate brazilian c19s003_Gifts_29292411:

    # eva "Y una de las pelirrojas mata al humorista y se acaba el chiste. *Risa*"
    eva "E uma das ruivas mata o comediante, e a piada acaba. *Risos*"

# game/scripts/c19/c19.rpy:1114
translate brazilian c19s003_Gifts_3bd5ec2f:

    # sca "No me acaba de gustar ese final, Eva. Yo estaba pensando en tirar al humorista a la piscina. *Risa*"
    sca "Eu não gostei muito desse final, Eva. Pensei em jogar o comediante na piscina. *Risos*"

# game/scripts/c19/c19.rpy:1115
translate brazilian c19s003_Gifts_c43d530c:

    # eil "Esperad un momento... ¿Vosotras le habéis dado el beso de buenos días?"
    eil "Espere um minuto... Você deu um beijo de bom dia nele?"

# game/scripts/c19/c19.rpy:1117
translate brazilian c19s003_Gifts_de2ded86:

    # eva "Cuando hemos llegado. Después de que [emm] nos presentara a Simone."
    eva "Quando chegamos. Depois que [emm] nos apresentou a Simone."

# game/scripts/c19/c19.rpy:1118
translate brazilian c19s003_Gifts_08e8802a:

    # sca "Yo esta mañana... cuando me lo he cruzado en la cocina."
    sca "Esta manhã... quando o encontrei na cozinha."

# game/scripts/c19/c19.rpy:1119
translate brazilian c19s003_Gifts_5410d897:

    # eil "Pues no os dejo que lo matéis ni que lo tiréis a la piscina antes de mi beso. *Risa*"
    eil "Bem, não vou deixar você matá-lo ou jogá-lo na piscina antes de eu beijá-lo. *Risos*"

# game/scripts/c19/c19.rpy:1121
translate brazilian c19s003_Gifts_86ac7e6b:

    # eil "Buenos días, [mc]."
    eil "Bom dia, [mc]."

# game/scripts/c19/c19.rpy:1122
translate brazilian c19s003_Gifts_36356f93:

    # mc "Buenos días, Eileen."
    mc "Bom dia, Eileen."

# game/scripts/c19/c19.rpy:1124
translate brazilian c19s003_Gifts_7af1ee95:

    # eil "Vale, todo vuestro. Merece una muerte horrible por empezar ese chiste. No puede definirnos por nuestro color de pelo. Yo soy algo más que una maravillosa pelirroja. *Risa*"
    eil "Ok, agora é tudo seu. Ela merece uma morte horrível por ter começado essa piada. Ela não pode nos definir pela cor do nosso cabelo. Eu sou muito mais do que uma ruiva linda. *Risos*"

# game/scripts/c19/c19.rpy:1126
translate brazilian c19s003_Gifts_164935f5:

    # eva "Creo que su sangre podría estropear el cumpleaños un poquito. Ya sabes, Alexia tendría que investigar en vez de seguir disfrutando de la comida. *Risa*"
    eva "Acho que o sangue dela pode estragar um pouco o aniversário. Sabe, a Alexia teria que fazer pesquisas em vez de só aproveitar a comida. *Risos*"

# game/scripts/c19/c19.rpy:1127
translate brazilian c19s003_Gifts_842436bf:

    # eva "[mar] y [nor] se pondrían a limpiar. Es posible que alguna chica se pusiera triste... Mejor dejamos el asesinato para otro día. *Risa*"
    eva "[mar] e [nor] começariam a limpar. Alguma garota poderia ficar triste... Vamos deixar o assassinato para outro dia. *Risos*"

# game/scripts/c19/c19.rpy:1128
translate brazilian c19s003_Gifts_69dd8f15:

    # mc "Muy graciosa..."
    mc "Muito engraçado..."

# game/scripts/c19/c19.rpy:1130
translate brazilian c19s003_Gifts_7cf5470b:

    # sca "Y si lo tiramos a la piscina... ¿cuánto pesa? Seguro que salpica mucho y le moja la comida a alguien. *Risa*"
    sca "E se a gente jogar na piscina... quanto pesa? Tenho certeza que vai espirrar bastante e molhar a comida de alguém. *Risos*"

# game/scripts/c19/c19.rpy:1131
translate brazilian c19s003_Gifts_6e285c12:

    # mc "¡Por Dios! Creía que el grupo peligroso era el de Jamaal y Kate."
    mc "Meu Deus! Eu pensava que o grupo perigoso era o do Jamaal e da Kate."

# game/scripts/c19/c19.rpy:1133
translate brazilian c19s003_Gifts_0d28448b:

    # eil "Pobrecitos, suficiente tienen con aguantar el monokini de Jam. *Risa* Pero te lo tienes merecido por todos los años en los que te has metido con Jamaal."
    eil "Pobrezinhas, já têm problemas suficientes só aguentando o monokini do Jam. *Risos* Mas vocês merecem por todos esses anos atormentando o Jamaal."

# game/scripts/c19/c19.rpy:1134
translate brazilian c19s003_Gifts_9f42bcd6:

    # sca "Y Kate es un amor. Nunca se mete con nadie que no sea ella misma. *Risa*"
    sca "E a Kate é um amor. Ela nunca incomoda ninguém além de si mesma. *Risos*"

# game/scripts/c19/c19.rpy:1135
translate brazilian c19s003_Gifts_e7b92bbc:

    # eva "Bueno, yo tengo algunas grabaciones de Kate metiéndose con [mc]. *Risa* Son relevantes para vuestra protección. O, al menos, la de [mc]."
    eva "Bem, eu tenho algumas gravações da Kate mexendo com o [mc]. *Risos* Elas são relevantes para a sua proteção. Ou pelo menos para a do [mc]."

# game/scripts/c19/c19.rpy:1136
translate brazilian c19s003_Gifts_b912b637:

    # eva "Esa chica puede ser una fiera. *Risa*"
    eva "Aquela garota pode ser bem selvagem. *Risos*"

# game/scripts/c19/c19.rpy:1137
translate brazilian c19s003_Gifts_3825f6bb:

    # mc "*Risa* Me parece que voy a seguir mi ronda con el resto de las chicas. Algún sitio donde me dejen respirar."
    mc "*Risos* Acho que vou continuar minhas rondas com o resto das garotas. Em algum lugar elas me deixarão respirar."

# game/scripts/c19/c19.rpy:1138
translate brazilian c19s003_Gifts_c2076849:

    # mc "Os veo luego. Y... Eva, luego quiero hablar en privado con Amanda y contigo. Después de los regalos."
    mc "Te vejo mais tarde. E... Eva, quero conversar com a Amanda e com você em particular mais tarde. Depois dos presentes."

# game/scripts/c19/c19.rpy:1140
translate brazilian c19s003_Gifts_d994e5b8:

    # eva "¿Sobre qué? Amanda y yo aún no hemos acabado de aclarar lo que hablamos anoche..."
    eva "Sobre o quê? Amanda e eu ainda não terminamos de esclarecer o que conversamos ontem à noite..."

# game/scripts/c19/c19.rpy:1141
translate brazilian c19s003_Gifts_063fe740:

    # mc "¿Sabes lo malo de amenazar con asesinarme? Que ahora puedo tenerte intrigada hasta que tengamos esa conversación. *Risa*"
    mc "Sabe o que há de errado em ameaçar me matar? Posso manter sua curiosidade até que realmente tenhamos essa conversa. *Risos*"

# game/scripts/c19/c19.rpy:1142
translate brazilian c19s003_Gifts_54279f0a:

    # mc "Y con ganas de más..."
    mc "E querendo mais..."

# game/scripts/c19/c19.rpy:1143
translate brazilian c19s003_Gifts_f3b5f675:

    # mc "Hasta luego chicas."
    mc "Até logo, meninas."

# game/scripts/c19/c19.rpy:1145
translate brazilian c19s003_Gifts_8b2f8c2f:

    # "Te giras sin darle tiempo a contestar (o a asesinarte) y te diriges al siguiente grupo."
    "Você se vira sem dar tempo para que eles respondam (ou para que te matem) e segue em direção ao próximo grupo."

# game/scripts/c19/c19.rpy:1146
translate brazilian c19s003_Gifts_0744ac4c:

    # mc "Hola, chicas. Felicidades, [eri]. Antes te has llevado a Maddie tan rápido que no me ha dado tiempo de felicitarte."
    mc "Olá meninas. Parabéns, [eri]. Vocês levaram a Maddie tão rápido que eu não tive tempo de parabenizá-las."

# game/scripts/c19/c19.rpy:1147
translate brazilian c19s003_Gifts_7c512e3c:

    # meg "¡Qué maleducado por tu parte, [mc]! *Risa* Y además llegas aquí y no nos das los buenos días a ninguna."
    meg "Que falta de educação a sua, [mc]! *Risos* E você vem aqui e nem sequer diz bom dia a nenhum de nós."

# game/scripts/c19/c19.rpy:1148
translate brazilian c19s003_Gifts_1c14653f:

    # lis "Dice que es el hombre de la casa y esas cosas. *Risa* Y tiene aquí a tres damiselas desatendidas."
    lis "Ele diz que é o homem da casa e tudo mais. *Risos* E tem três donzelas negligenciadas aqui."

# game/scripts/c19/c19.rpy:1149
translate brazilian c19s003_Gifts_29c11cbb:

    # eri "Como es mi cumpleaños, reclamo el primer beso. *Risa* Después os lo presto un rato."
    eri "Já que é meu aniversário, eu reivindico o primeiro beijo. *Risos* Vou emprestá-lo para vocês por um tempo mais tarde."

# game/scripts/c19/c19.rpy:1151
translate brazilian c19s003_Gifts_bb2d882b:

    # mc "Felicidades, [eri]."
    mc "Parabéns, [eri]."

# game/scripts/c19/c19.rpy:1152
translate brazilian c19s003_Gifts_44152844:

    # eri "Gracias, [mc]. Más vale que las beses también a ellas si no quieres que no llegue a mañana a cumplir los 19."
    eri "Obrigado, [mc]. É melhor você beijá-los também se não quiser que eu perca meu aniversário de 19 anos amanhã."

# game/scripts/c19/c19.rpy:1154
translate brazilian c19s003_Gifts_b9f68b48:

    # mc "Buenos días, Lisa. ¿Cuánto habéis bebido?"
    mc "Bom dia, Lisa. Quanto você já bebeu?"

# game/scripts/c19/c19.rpy:1155
translate brazilian c19s003_Gifts_41e50b3f:

    # lis "Buenos días. Megan y [eri] no quieren beber, con lo que yo tengo que beber por las tres, ¿no?"
    lis "Bom dia. Megan e [eri] não querem beber, então eu tenho que beber pelos três, certo?"

# game/scripts/c19/c19.rpy:1156
translate brazilian c19s003_Gifts_0ecf28f9:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Você sabe que não é necessário, né?"

# game/scripts/c19/c19.rpy:1157
translate brazilian c19s003_Gifts_05aba25f:

    # lis "No te preocupes, tan solo he bebido tres copas de vino."
    lis "Não se preocupe, eu só tomei três taças de vinho."

# game/scripts/c19/c19.rpy:1159
translate brazilian c19s003_Gifts_c81b117b:

    # mc "Buenos días, Megan. Gracias por lo de anoche en el Jazz Corner."
    mc "Bom dia, Megan. Obrigada pela noite passada no Jazz Corner."

# game/scripts/c19/c19.rpy:1160
translate brazilian c19s003_Gifts_58d15963:

    # meg "Buenos días, [mc]. Era el cumpleaños de tres de mis chicas favoritas, es lo menos que podía hacer."
    meg "Bom dia, [mc]. Era aniversário de três das minhas garotas favoritas, é o mínimo que eu podia fazer."

# game/scripts/c19/c19.rpy:1162
translate brazilian c19s003_Gifts_53439648:

    # mc "¿Estabais hablando de algo en lo que pueda participar? ¿O me vais a echar como han hecho el resto?"
    mc "Você estava falando de algo em que eu pudesse participar? Ou vai me expulsar como faz com todos os outros?"

# game/scripts/c19/c19.rpy:1163
translate brazilian c19s003_Gifts_a8d5d0d3:

    # eri "Estábamos hablando del topless."
    eri "Estávamos falando sobre topless."

# game/scripts/c19/c19.rpy:1164
translate brazilian c19s003_Gifts_83d0c4f3:

    # meg "Se han apuntado muchas más chicas de lo que cualquiera de nosotras había pensado."
    meg "O número de inscritas foi muito maior do que qualquer um de nós imaginava."

# game/scripts/c19/c19.rpy:1165
translate brazilian c19s003_Gifts_ba742736:

    # lis "Y alguna que las tres pensábamos que lo haría, como Eva, no lo ha hecho."
    lis "E algumas pessoas que nós três pensávamos que fariam isso, como a Eva, não fizeram."

# game/scripts/c19/c19.rpy:1166
translate brazilian c19s003_Gifts_9b5969f4:

    # mc "¿Quién os ha sorprendido más de las que se han apuntado?"
    mc "Dentre os inscritos, quem mais te surpreendeu?"

# game/scripts/c19/c19.rpy:1168
translate brazilian c19s003_Gifts_a6d298e5:

    # eri "Yo no pensaba que [dap] fuera a hacerlo. Demasiada atención sobre ella el día que tiene que abrir los regalos."
    eri "Eu não achei que [dap] fosse fazer isso. Muita atenção voltada para ela no dia em que ela tem que abrir os presentes."

# game/scripts/c19/c19.rpy:1169
translate brazilian c19s003_Gifts_f5e8f977:

    # mc "Creo que era muy consciente de por qué lo pediste, con lo que creo que también quería apoyar a tu madre."
    mc "Acho que ele tinha plena consciência do motivo pelo qual você pediu isso, então acredito que ele também queria apoiar sua mãe."

# game/scripts/c19/c19.rpy:1170
translate brazilian c19s003_Gifts_c0c5a33a:

    # eri "Es posible..."
    eri "É possível..."

# game/scripts/c19/c19.rpy:1172
translate brazilian c19s003_Gifts_406ae3fe:

    # lis "A mí me ha sorprendido mucho Alexia. Cuando la conocí parecía tan seria y profesional, que no me la imaginaba así."
    lis "Alexia me surpreendeu muito. Quando a conheci, ela parecia tão séria e profissional; eu não a imaginava assim."

# game/scripts/c19/c19.rpy:1173
translate brazilian c19s003_Gifts_538a8eab:

    # lis "Después hemos hablado mucho y sé que es muy abierta y simpática, pero esa primera impresión sigue contando para mí."
    lis "Já conversamos bastante desde então e sei que ela é muito aberta e simpática, mas a primeira impressão ainda é importante para mim."

# game/scripts/c19/c19.rpy:1174
translate brazilian c19s003_Gifts_a238acdc:

    # mc "Alexia puede ser una caja de sorpresas. Después iré a hablar con ella."
    mc "Alexia pode ser uma caixinha de surpresas. Vou falar com ela mais tarde."

# game/scripts/c19/c19.rpy:1176
translate brazilian c19s003_Gifts_497ec1ea:

    # meg "A mí me ha sorprendido Kim. Si yo tuviera un cuerpo tan perfecto como el suyo, no dudaría en enseñarlo."
    meg "Kim me surpreendeu. Se eu tivesse um corpo tão perfeito quanto o dela, não hesitaria em exibi-lo."

# game/scripts/c19/c19.rpy:1177
translate brazilian c19s003_Gifts_341cd6f6:

    # mc "Estaba preocupada por ser la única en no hacerlo, y pese a todo no lo ha hecho, con lo que debe ser importante para ella."
    mc "Ela estava preocupada em ser a única que não fazia isso, mas como não fez, deve ser importante para ela."

# game/scripts/c19/c19.rpy:1178
translate brazilian c19s003_Gifts_13280cd3:

    # meg "Tienes razón, no lo había pensado así. ¿Y a ti? ¿Quién te ha sorprendido más?"
    meg "Você tem razão, eu não tinha pensado nisso dessa forma. E você? Quem te surpreendeu mais?"

# game/scripts/c19/c19.rpy:1179
translate brazilian c19s003_Gifts_e7898737:

    # mc "Samantha y Simone. Si me hubieran preguntado ayer, hubiera dicho que las dos habrían hecho justo lo contrario de lo que han hecho."
    mc "Samantha e Simone. Se você me perguntasse ontem, eu diria que as duas teriam feito exatamente o oposto do que fizeram."

# game/scripts/c19/c19.rpy:1181
translate brazilian c19s003_Gifts_b41f859c:

    # lis "Ahora sólo falta que se acabe la comida y empezar a abrir regalos. Tengo ganas de saber si hemos acertado con lo que les hemos regalado a las chicas."
    lis "Agora só falta terminar a comida e aí podemos começar a abrir os presentes. Estou ansiosa para ver se escolhemos os presentes certos para as meninas."

# game/scripts/c19/c19.rpy:1182
translate brazilian c19s003_Gifts_8865ba85:

    # eri "Los regalos son lo de menos. Yo cambiaría todos los regalos por poder repetir esto más a menudo."
    eri "Os presentes são a coisa menos importante. Eu trocaria todos os presentes pela chance de fazer isso com mais frequência."

# game/scripts/c19/c19.rpy:1183
translate brazilian c19s003_Gifts_1f0e072c:

    # meg "Tú quieres que no entre en ninguno de mis vestidos del trabajo. *Risa* [nor] y [mar] cocinan demasiado bien para mí."
    meg "Você quer que eu não caiba em nenhum dos meus vestidos de trabalho. *Risos* [nor] e [mar] cozinham muito bem para mim."

# game/scripts/c19/c19.rpy:1184
translate brazilian c19s003_Gifts_92b01289:

    # mc "Con los que somos aquí, habrá celebraciones de sobras solamente con los cumpleaños. Suma el 4 de julio, Acción de gracias, Navidad, Nochevieja..."
    mc "Com a quantidade de pessoas aqui, haverá comemorações mais do que suficientes só para aniversários. Some a isso o 4 de julho, o Dia de Ação de Graças, o Natal, o Ano Novo..."

# game/scripts/c19/c19.rpy:1185
translate brazilian c19s003_Gifts_ffdbdeae:

    # mc "No vamos a ir cortos de celebraciones los próximos meses."
    mc "Não faltarão motivos para comemorar nos próximos meses."

# game/scripts/c19/c19.rpy:1187
translate brazilian c19s003_Gifts_bb54d10e:

    # meg "Es fantástico, aunque tenga que comprar vestuario nuevo. *Risa*"
    meg "É fantástico, mesmo que eu tenha que comprar roupas novas. *Risos*"

# game/scripts/c19/c19.rpy:1188
translate brazilian c19s003_Gifts_95f51cf3:

    # lis "Tengo ganas de pasar Nochevieja con vosotros. Me gustan más las fiestas con vestido formal que en bikini, aunque me podría acostumbrar."
    lis "Estou ansiosa para passar a véspera de Ano Novo com todos vocês. Prefiro festas de vestido formal a biquíni, embora pudesse me acostumar com a ideia."

# game/scripts/c19/c19.rpy:1189
translate brazilian c19s003_Gifts_0b82ebad:

    # eri "Pues te llevarás una sorpresa. Lo solemos celebrar en pijama. *Risa*"
    eri "Bem, você vai ter uma surpresa. Normalmente comemoramos de pijama. *Risos*"

# game/scripts/c19/c19.rpy:1190
translate brazilian c19s003_Gifts_27059b6c:

    # mc "¿No vais a volver a Aurora para Navidad?"
    mc "Você não vai voltar para Aurora no Natal?"

# game/scripts/c19/c19.rpy:1192
translate brazilian c19s003_Gifts_2d57d172:

    # lis "Debbie y yo hemos estado hablando sobre eso. Seguramente pasemos Acción de Gracias y Navidad con mis padres, pero querríamos estar aquí para Nochevieja."
    lis "Eu e a Debbie temos conversado sobre isso. Provavelmente passaremos o Dia de Ação de Graças e o Natal com meus pais, mas gostaríamos de estar aqui para o Ano Novo."

# game/scripts/c19/c19.rpy:1193
translate brazilian c19s003_Gifts_f50c83ed:

    # lis "Si no os importa, claro... no sé si el Dormitorio seguirá abierto durante las fiestas."
    lis "Se não se importar, claro... Não sei se o dormitório ainda estará aberto durante as férias."

# game/scripts/c19/c19.rpy:1194
translate brazilian c19s003_Gifts_8fff7466:

    # mc "Creo que no habrá ningún problema con eso, Lisa."
    mc "Não acho que haverá qualquer problema com isso, Lisa."

# game/scripts/c19/c19.rpy:1196
translate brazilian c19s003_Gifts_8089f1ae:

    # meg "¿Os está apeteciendo tanto como a mí empezar a planear todas esas fiestas? *Risa*"
    meg "Você está tão animado quanto eu para começar a planejar todas essas festas? *Risos*"

# game/scripts/c19/c19.rpy:1197
translate brazilian c19s003_Gifts_83900991:

    # eri "Es un poco pronto... pero ¡sí! *Risa*"
    eri "É um pouco cedo... mas sim! *Risos*"

# game/scripts/c19/c19.rpy:1198
translate brazilian c19s003_Gifts_b0d76e05:

    # lis "Aún no ha acabado tu cumpleaños y ya estamos hablando de las siguientes fiestas. *Risa* El cumpleaños de Debbie es en octubre..."
    lis "Seu aniversário nem acabou ainda e já estamos falando da próxima festa. *Risos* O aniversário da Debbie é em outubro..."

# game/scripts/c19/c19.rpy:1199
translate brazilian c19s003_Gifts_b10b012a:

    # mc "Antes van los de Simone y Scarlett. Ya os pasaré una lista, pero si os vais a poner a organizar más fiestas, os voy a dejar y seguir disfrutando de esta."
    mc "As próximas festas são da Simone e da Scarlett. Vou te mandar uma lista depois, mas se você estiver planejando mais festas, pode continuar aproveitando esta."

# game/scripts/c19/c19.rpy:1200
translate brazilian c19s003_Gifts_83fb187a:

    # mc "Os veo luego chicas."
    mc "Até logo, meninas."

# game/scripts/c19/c19.rpy:1202
translate brazilian c19s003_Gifts_d6430870:

    # todas "Hasta luego, [mc]."
    todas "Até logo, [mc]."

# game/scripts/c19/c19.rpy:1209
translate brazilian c19s003_Gifts_c00541dc:

    # "Pasas a recargar el plato por la mesa de la comida y te acercas al siguiente grupo."
    "Você dá a volta na mesa de comida para encher seu prato novamente e se aproxima do próximo grupo."

# game/scripts/c19/c19.rpy:1210
translate brazilian c19s003_Gifts_e7abd37f:

    # mcp "(Me sorprende que Maddie se haya apuntado al topless siendo su primera vez en casa.)"
    mcp "(Fiquei surpresa que a Maddie tenha decidido ficar de topless, sendo a primeira vez dela em casa.)"

# game/scripts/c19/c19.rpy:1211
translate brazilian c19s003_Gifts_3e9d00d3:

    # mc "¿Qué tal lo estáis pasando?"
    mc "Como vocês estão?"

# game/scripts/c19/c19.rpy:1212
translate brazilian c19s003_Gifts_1a1dc6dc:

    # nor "Genial, hay comida de sobras y todo el mundo está divirtiéndose. No se puede pedir más."
    nor "Ótimo, tem comida em abundância e todos estão se divertindo muito. Não dá para pedir mais nada."

# game/scripts/c19/c19.rpy:1213
translate brazilian c19s003_Gifts_3e62b690:

    # kia "Me encantan estas celebraciones familiares. Eileen me había hablado de ellas hace años, pero no me las imaginaba así."
    kia "Adoro essas celebrações em família. Eileen tinha me falado delas anos atrás, mas eu não as imaginava assim."

# game/scripts/c19/c19.rpy:1214
translate brazilian c19s003_Gifts_44148589:

    # mad "Es una inmersión forzada en vuestra familia. *Risa* Aunque conocía a la mayoría de la tienda, no habíamos tenido la oportunidad de hablar mucho."
    mad "É uma imersão forçada na sua família. *Risos* Embora eu conhecesse a maioria das pessoas na loja, não tínhamos tido muita oportunidade de conversar."

# game/scripts/c19/c19.rpy:1215
translate brazilian c19s003_Gifts_d9c43713:

    # mc "Espero que no te parezcamos demasiado raros. *Risa*"
    mc "Espero que não pareçamos muito estranhos para você. *Risos*"

# game/scripts/c19/c19.rpy:1217
translate brazilian c19s003_Gifts_877f0b76:

    # mc "Veo que el hematoma de tu brazo ha mejorado mucho."
    mc "Vejo que o hematoma no seu braço melhorou bastante."

# game/scripts/c19/c19.rpy:1219
translate brazilian c19s003_Gifts_30a60798:

    # kia "Sí, el ungüento de Samantha ha obrado maravillas. Me ha dicho que amarilleará durante unos días y desaparecerá antes del próximo fin de semana."
    kia "Sim, a pomada da Samantha fez maravilhas. Ela me disse que vai amarelar por alguns dias e depois desaparecer antes do próximo fim de semana."

# game/scripts/c19/c19.rpy:1220
translate brazilian c19s003_Gifts_17f2ab3a:

    # mc "Eso es fantástico. En una semana ya no nos acordaremos del hematoma."
    mc "Isso é fantástico. Em uma semana, nem nos lembraremos mais do hematoma."

# game/scripts/c19/c19.rpy:1222
translate brazilian c19s003_Gifts_b60da254:

    # mad "¿Qué te pasó? ¿Te caíste? Tuvo que ser una caída muy fuerte..."
    mad "O que aconteceu com você? Você caiu? Deve ter sido uma queda muito feia..."

# game/scripts/c19/c19.rpy:1223
translate brazilian c19s003_Gifts_0f70d3c3:

    # "Le haces señas de que no continúe por ahí, pero llegas tarde."
    "Você faz sinal para ele não ir por aquele caminho, mas já é tarde demais."

# game/scripts/c19/c19.rpy:1224
translate brazilian c19s003_Gifts_bcdc6fdd:

    # kia "No... es un tema... de mi pasado..."
    kia "Não... é um assunto... do meu passado..."

# game/scripts/c19/c19.rpy:1225
translate brazilian c19s003_Gifts_6abb8ee6:

    # mc "Lo tienes que ver así. Algo que pasó y no volverá a pasar. Me ocupare... nos ocuparemos... de que no pase de nuevo."
    mc "Você precisa ver as coisas desta forma. Algo que aconteceu e não acontecerá novamente. Eu vou garantir... nós vamos garantir... que isso não aconteça novamente."

# game/scripts/c19/c19.rpy:1226
translate brazilian c19s003_Gifts_25ea25b9:

    # nor "Aquí estás segura y nadie te volverá a hacer daño. Todos te vamos a proteger"
    nor "Você está seguro aqui e ninguém nunca mais vai te machucar. Todos nós vamos te proteger."

# game/scripts/c19/c19.rpy:1228
translate brazilian c19s003_Gifts_cc8f0d0a:

    # mad "¡Oops! Lo siento, Kiara... no lo sabía..."
    mad "Ops! Desculpe, Kiara... Eu não sabia..."

# game/scripts/c19/c19.rpy:1229
translate brazilian c19s003_Gifts_de7961c8:

    # mc "Mejor hablar de cosas más alegres, ¿no? Luego traeré tus regalos. Supongo que son los más voluminosos."
    mc "Vamos falar de coisas mais alegres, que tal? Eu trago seus presentes mais tarde. Imagino que sejam os mais volumosos."

# game/scripts/c19/c19.rpy:1231
translate brazilian c19s003_Gifts_6b3579c4:

    # nor "Creo que casi todo el mundo ha comido lo que podía comer ya, con lo que en veinte o treinta minutos haremos la entrega de regalos. Si quieres llevarlos a la pérgola, puedes hacerlo."
    nor "Acho que quase todos já comeram o suficiente, então começaremos a distribuir os presentes em vinte ou trinta minutos. Se quiserem trazê-los para a pérgola, fiquem à vontade."

# game/scripts/c19/c19.rpy:1232
translate brazilian c19s003_Gifts_a0d0098b:

    # kia "Yo tengo los míos en mi habitación. También tendré que ir a buscarlos."
    kia "Eu tenho os meus no meu quarto. Vou ter que ir buscá-los também."

# game/scripts/c19/c19.rpy:1233
translate brazilian c19s003_Gifts_1938185b:

    # mad "Si quieres te ayudo a traerlos. No pesan, pero son incómodos de llevar para una sola persona."
    mad "Se você quiser, posso te ajudar a trazê-los. Eles não são pesados, mas são difíceis de carregar sozinhos."

# game/scripts/c19/c19.rpy:1234
translate brazilian c19s003_Gifts_7b866421:

    # mc "Perfecto. ¿Vamos?"
    mc "Perfeito. Vamos?"

# game/scripts/c19/c19.rpy:1236
translate brazilian c19s003_Gifts_3783c213:

    # "Llevas los regalos de Maddie a la pérgola del fondo del jardín y vas a buscar los tuyos a tu habitación."
    "Você leva os presentes de Maddie para a pérgola no fundo do jardim e vai para o seu quarto buscar os seus."

# game/scripts/c19/c19.rpy:1238
translate brazilian c19s003_Gifts_6eced475:

    # "Después te acercas a algunas de las últimas chicas con las que no has hablado aún."
    "Em seguida, você aborda algumas das últimas garotas com quem ainda não conversou."

# game/scripts/c19/c19.rpy:1239
translate brazilian c19s003_Gifts_3a5656ef:

    # mc "¿Qué tal chicas? ¿Ya no coméis?"
    mc "Ei, meninas, vocês não estão mais comendo?"

# game/scripts/c19/c19.rpy:1240
translate brazilian c19s003_Gifts_c8440b69:

    # sai "Estoy a punto de reventar. Y aún queda el pastel."
    sai "Estou prestes a explodir. E ainda tem bolo para comer."

# game/scripts/c19/c19.rpy:1241
translate brazilian c19s003_Gifts_6896fb67:

    # ama "Con lo que había aquí se podría alimentar a un país pequeño. *Risa*"
    ama "O que havia aqui daria para alimentar um país pequeno. *Risos*"

# game/scripts/c19/c19.rpy:1242
translate brazilian c19s003_Gifts_dc8ea16c:

    # mee "Estas chicas están descubriendo cómo nos organizamos cuando hay comida por en medio. *Risa*"
    mee "Essas meninas estão descobrindo como nos organizamos quando a comida está envolvida. *Risos*"

# game/scripts/c19/c19.rpy:1244
translate brazilian c19s003_Gifts_419fe907:

    # sai "Pero es que es imposible no querer probarlo todo. Cada plato es más delicioso que el anterior."
    sai "Mas é impossível não querer experimentar tudo. Cada prato é mais delicioso que o anterior."

# game/scripts/c19/c19.rpy:1245
translate brazilian c19s003_Gifts_91f54910:

    # mc "Hay que hacer sacrificios y renunciar a cosas. Yo era una bola hasta que no lo aprendí. *Risa*"
    mc "Você precisa fazer sacrifícios e abrir mão de algumas coisas. Eu era um verdadeiro desleixado até aprender isso. *Risos*"

# game/scripts/c19/c19.rpy:1246
translate brazilian c19s003_Gifts_f3005491:

    # mc "Por ejemplo, va a haber tres pasteles. Solo hay que comer de uno de ellos. O una porción minúscula de cada una."
    mc "Por exemplo, haverá três bolos. Você só precisa comer um deles. Ou uma pequena porção de cada um."

# game/scripts/c19/c19.rpy:1248
translate brazilian c19s003_Gifts_15f43a02:

    # ama "Es lo que estaba diciéndole a Olivia. No sé cómo puede mantener una figura así, a su edad, si las comidas familiares son así."
    ama "Era isso que eu estava dizendo para a Olivia. Não sei como ela consegue manter essa forma física na idade dela, com refeições em família assim."

# game/scripts/c19/c19.rpy:1249
translate brazilian c19s003_Gifts_10f59ace:

    # ama "Creo que me he engordado un par de kilos desde que os conozco."
    ama "Acho que engordei uns dois quilos desde que te conheci."

# game/scripts/c19/c19.rpy:1250
translate brazilian c19s003_Gifts_462c42be:

    # mc "Bueno, Meemaw tiene un truco, cuando no está con nosotros adelgaza rápidamente. *Pretendiendo susurrar* Cocina fatal cualquier cosa más allá de una ensalada. *Risa*"
    mc "Bem, a vovó tem um truque na manga: quando não está conosco, ela emagrece rapidinho. *Fingindo sussurrar* Ela cozinha muito mal qualquer coisa além de salada. *Risos*"

# game/scripts/c19/c19.rpy:1252
translate brazilian c19s003_Gifts_9aaa3c85:

    # mee "No es cierto del todo. No sabéis apreciar las cualidades del arroz duro o del filete carbonizado. *Risa*"
    mee "Isso não é totalmente verdade. Você não sabe apreciar as qualidades de um arroz bem cozido ou de um bife bem tostado. *Risos*"

# game/scripts/c19/c19.rpy:1253
translate brazilian c19s003_Gifts_2080f8d0:

    # mc "Si que sabemos. Como materiales de construcción son geniales. Como alimento... no tanto. *Risa*"
    mc "Sabemos sim. Como material de construção, são ótimos. Como alimento... nem tanto. *Risos*"

# game/scripts/c19/c19.rpy:1255
translate brazilian c19s003_Gifts_1ba13645:

    # sai "¿Y tú? ¿Cómo lo estás pasando? Te hemos visto ir como un pollo sin cabeza entre todas nosotras."
    sai "E você? Como vai? Vimos você correndo de um lado para o outro como uma barata tonta no meio de todos nós."

# game/scripts/c19/c19.rpy:1256
translate brazilian c19s003_Gifts_d68c062a:

    # ama "Parece que quieras hablar con todas nosotras, pero no te quedas más de cinco o diez minutos con cada grupo."
    ama "Você parece querer conversar com todos nós, mas não fica mais do que cinco ou dez minutos com cada grupo."

# game/scripts/c19/c19.rpy:1257
translate brazilian c19s003_Gifts_5e8507c3:

    # mee "Es que [mc] sería el perfecto anfitrión en cualquier fiesta. Quiere que todo el mundo se sienta a gusto y se lo pase bien."
    mee "[mc] seria o anfitrião perfeito em qualquer festa. Ele quer que todos se sintam à vontade e se divirtam."

# game/scripts/c19/c19.rpy:1258
translate brazilian c19s003_Gifts_2374f6a3:

    # mc "¿Acaso me perdonaríais si me quedara todo el día charlando con el mismo grupo?"
    mc "Você me perdoaria se eu passasse o dia todo conversando com o mesmo grupo?"

# game/scripts/c19/c19.rpy:1260
translate brazilian c19s003_Gifts_6535f8f6:

    # ama "*Risa* No, tendríamos que secuestrarte."
    ama "*Risos* Não, teríamos que te sequestrar."

# game/scripts/c19/c19.rpy:1261
translate brazilian c19s003_Gifts_d267b4bf:

    # sai "Sólo te perdonaríamos si ese grupo fuese el nuestro. *Risa*"
    sai "Só te perdoaríamos se esse grupo fosse nosso. *Risos*"

# game/scripts/c19/c19.rpy:1262
translate brazilian c19s003_Gifts_41256648:

    # mee "Y entonces el resto de las mujeres de la familia vendrían a este grupo a secuestrarte y sería lo mismo. *Risa*"
    mee "E aí o resto das mulheres da família se juntava a esse grupo para te sequestrar, e era a mesma coisa. *Risos*"

# game/scripts/c19/c19.rpy:1263
translate brazilian c19s003_Gifts_9fc714f5:

    # mee "Por alguna razón, todas queremos nuestra ración de [mc]."
    mee "Por algum motivo, todos nós queremos a nossa parte de [mc]."

# game/scripts/c19/c19.rpy:1264
translate brazilian c19s003_Gifts_0d20ae82:

    # mc "Lo acabas de decir como si fuera el cuarto pastel de cumpleaños. *Risa*"
    mc "Você falou isso como se fosse seu quarto bolo de aniversário. *Risos*"

# game/scripts/c19/c19.rpy:1266
translate brazilian c19s003_Gifts_a10b2e34:

    # "*Ding-Ding-Ding*"
    "*Ding-Ding-Ding*"

# game/scripts/c19/c19.rpy:1267
translate brazilian c19s003_Gifts_01acbf16:

    # mar "¿Podéis prestarnos un momento de atención?"
    mar "Você poderia nos conceder um momento de sua atenção?"

# game/scripts/c19/c19.rpy:1268
translate brazilian c19s003_Gifts_2989b6d2:

    # nor "Nos hemos dado cuenta de que nadie está comiendo ya."
    nor "Percebemos que ninguém mais está comendo."

# game/scripts/c19/c19.rpy:1269
translate brazilian c19s003_Gifts_5c4f3b50:

    # mar "Suponemos que os estáis reservando para los pasteles."
    mar "Imaginamos que vocês estejam guardando energia para os bolos."

# game/scripts/c19/c19.rpy:1270
translate brazilian c19s003_Gifts_d36f0935:

    # nor "Con lo que sería el momento para que las chicas soplaran las velas."
    nor "Esse seria o momento para as meninas apagarem as velas."

# game/scripts/c19/c19.rpy:1271
translate brazilian c19s003_Gifts_3b9f6dee:

    # mar "Y nos comamos el pastel antes de que este calor lo derrita."
    mar "E vamos comer o bolo antes que esse calor o derreta."

# game/scripts/c19/c19.rpy:1272
translate brazilian c19s003_Gifts_e889d994:

    # mom "No os preocupéis. Hay más pasteles, no sólo estos tres."
    mom "Não se preocupe. Há mais bolos, não apenas esses três."

# game/scripts/c19/c19.rpy:1273
translate brazilian c19s003_Gifts_492dfc10:

    # nor "Después, cuando todos vosotros estéis hartos de pastel, haremos la entrega de regalos y no os molestaremos más."
    nor "Depois que todos estiverem satisfeitos com o bolo, entregaremos os presentes e não incomodaremos mais vocês."

# game/scripts/c19/c19.rpy:1274
translate brazilian c19s003_Gifts_fe38e22c:

    # todas "¡Sí!"
    todas "Sim!"

# game/scripts/c19/c19.rpy:1276
translate brazilian c19s003_Gifts_d5a6db69:

    # "Las chicas soplan las velas rodeadas por los regalos mientras todo el mundo aplaude."
    "As meninas apagam as velas rodeadas pelos presentes enquanto todos aplaudem."

# game/scripts/c19/c19.rpy:1277
translate brazilian c19s003_Gifts_b56fcced:

    # "Se reparten las porciones de pastel y todo el mundo vuelve a sus conversaciones. Todas las chicas menos Betty piden una ración pequeña. Jamaal pide una ración grande de cada pastel."
    "As fatias de bolo são distribuídas e todos retomam suas conversas. Todas as meninas, exceto Betty, pedem uma fatia pequena. Jamaal pede uma fatia grande de cada bolo."

# game/scripts/c19/c19.rpy:1278
translate brazilian c19s003_Gifts_0da62fda:

    # "Pruebas un pedacito MUY pequeño de cada uno. Como siempre, están deliciosos, pero la experiencia te ha enseñado que tres trozos normales son demasiados."
    "Você experimenta um pedacinho bem pequeno de cada. Como sempre, estão deliciosos, mas a experiência lhe ensinou que três pedaços normais são demais."

# game/scripts/c19/c19.rpy:1279
translate brazilian c19s003_Gifts_be4c42f1:

    # "El niño gordo de tu pasado grita angustiado en tu mente."
    "A criança gorda do seu passado grita de angústia em sua mente."

# game/scripts/c19/c19.rpy:1280
translate brazilian c19s003_Gifts_1cc36a4f:

    # "Todo el mundo se vuelve a dividir en grupos para comer el pastel antes de abrir los regalos."
    "Todos se dividem novamente em grupos para comer o bolo antes de abrir os presentes."

# game/scripts/c19/c19.rpy:1282
translate brazilian c19s003_Gifts_d3b54025:

    # "Te diriges al grupo de [dap]. Aún no has tenido oportunidad de charlar con ellas."
    "Você está indo para o grupo [dap]. Você ainda não teve a chance de conversar com eles."

# game/scripts/c19/c19.rpy:1283
translate brazilian c19s003_Gifts_304d2606:

    # mc "¿Qué tal, chicas? ¿Ya os habéis comido el pastel?"
    mc "Olá meninas! Vocês já comeram o bolo?"

# game/scripts/c19/c19.rpy:1284
translate brazilian c19s003_Gifts_57b2d432:

    # deb "[dap] tiene prisa por que todo el mundo se lo acabe. Tiene ganas de abrir los regalos. *Risa* No nos ha prestado atención hasta que no nos hemos acabado el pastel."
    deb "[dap] Ela está com pressa para que todos terminem. Ela está ansiosa para abrir os presentes. *Risos* Ela não prestou atenção em nós até que tivéssemos terminado o bolo."

# game/scripts/c19/c19.rpy:1285
translate brazilian c19s003_Gifts_3a8e31b3:

    # dap "Es lógico. Solo se cumplen 19 una vez. Bueno, en mi caso dos. Hoy y mañana. *Risa*"
    dap "Faz sentido. A gente só faz 19 anos uma vez. Bom, no meu caso, duas. Hoje e amanhã. *Risos*"

# game/scripts/c19/c19.rpy:1286
translate brazilian c19s003_Gifts_394e26cf:

    # oma "Ahora solo falta que Jamaal y Betty se acaben los suyos. *Risa* Creo que la impaciencia está matando a [dap]."
    oma "Agora só falta o Jamaal e a Betty terminarem os deles. *Risos* Acho que a impaciência está matando [dap]."

# game/scripts/c19/c19.rpy:1287
translate brazilian c19s003_Gifts_f6f5f399:

    # mc "Bueno, no hemos tenido tanta gente en una fiesta nunca. La comida está siendo mucho más larga."
    mc "Bem, nunca tivemos tanta gente numa festa. A refeição está demorando muito mais."

# game/scripts/c19/c19.rpy:1289
translate brazilian c19s003_Gifts_71559710:

    # dap "Y más gente son más regalos para abrir. *Risa* Va a llevar un rato..."
    dap "E mais gente significa mais presentes para abrir. *Risos* Vai demorar um pouco..."

# game/scripts/c19/c19.rpy:1290
translate brazilian c19s003_Gifts_842b4d8d:

    # mc "Y todavía quedará mucha tarde para seguir charlando."
    mc "E ainda haverá bastante tempo à tarde para continuarmos conversando."

# game/scripts/c19/c19.rpy:1292
translate brazilian c19s003_Gifts_3970537f:

    # deb "Y podríamos jugar a algo en la piscina. Estar tan cerca del agua y no meterme dentro me está matando."
    deb "E poderíamos jogar alguma coisa na piscina. Estar tão perto da água e não poder entrar está me matando."

# game/scripts/c19/c19.rpy:1293
translate brazilian c19s003_Gifts_37d243e2:

    # mc "Habló la sirenita. *Risa* Supongo que después de abrir los regalos habrá pasado el tiempo prudencial para bañarse después de comer."
    mc "A pequena sereia falou. *Risos* Imagino que, depois de abrir os presentes, já terá passado tempo suficiente para tomar um banho depois de comer."

# game/scripts/c19/c19.rpy:1295
translate brazilian c19s003_Gifts_46bf8553:

    # oma "Las madres latinas siempre dicen que son dos horas desde que acabas de comer hasta que te puedes bañar. Espero que [mar] y [nor] no tengan genes latinos o sean más razonables."
    oma "As mães latinas sempre dizem que se passam duas horas desde que você termina de comer até poder tomar banho. Espero que [mar] e [nor] não tenham genes latinos ou sejam mais razoáveis."

# game/scripts/c19/c19.rpy:1296
translate brazilian c19s003_Gifts_a8469e3a:

    # mc "Y que la apertura de regalos no dure tanto. *Risa*"
    mc "E que a abertura dos presentes não demore muito. *Risos*"

# game/scripts/c19/c19.rpy:1298
translate brazilian c19s003_Gifts_b7ffe0fb:

    # dap "Creo que todo el mundo ha acabado de comerse el pastel ya. Voy a preguntarle a mi madre si podemos abrir los regalos."
    dap "Acho que todos já terminaram de comer o bolo. Vou perguntar à minha mãe se podemos abrir os presentes."

# game/scripts/c19/c19.rpy:1299
translate brazilian c19s003_Gifts_332d4f92:

    # mc "No te preocupes, ya voy yo a hacerlo."
    mc "Não se preocupe, eu farei isso."

# game/scripts/c19/c19.rpy:1300
translate brazilian c19s003_Gifts_6301f5f1:

    # oma "¿Ya nos abandonas? Sólo has estado un par de minutos con nosotras."
    oma "Você já vai embora? Você só está conosco há alguns minutos."

# game/scripts/c19/c19.rpy:1301
translate brazilian c19s003_Gifts_f2f6bd0e:

    # mc "Tu no quieres que a [dap] le entre un ataque de ansiedad, ¿verdad? *Risa* Pero no te preocupes, después de los regalos tendré tiempo para todas vosotras también."
    mc "Você não quer que [dap] tenha um ataque de ansiedade, quer? *Risos* Mas não se preocupe, depois dos presentes terei tempo para todos vocês também."

# game/scripts/c19/c19.rpy:1302
translate brazilian c19s003_Gifts_66ce6f9e:

    # deb "Mejor que no. *Risa* Ve a preguntarle a [nor]."
    deb "Melhor não. *Risos* Vá perguntar [nor]."

# game/scripts/c19/c19.rpy:1303
translate brazilian c19s003_Gifts_7bce90a4:

    # mc "Ahora vuelvo."
    mc "Já volto."

# game/scripts/c19/c19.rpy:1305
translate brazilian c19s003_Gifts_2d2b2875:

    # "Preguntas a [mar] y [nor] sobre la apertura de regalos."
    "Perguntas para [mar] e [nor] sobre a abertura de presentes."

# game/scripts/c19/c19.rpy:1306
translate brazilian c19s003_Gifts_f097e388:

    # "Como cada año se sorprenden de lo mucho que han aguantado las chicas antes de pedir permiso para abrirlos."
    "Como todos os anos, eles ficam surpresos com o quanto as meninas suportaram antes de pedirem permissão para abri-las."

# game/scripts/c19/c19.rpy:1307
translate brazilian c19s003_Gifts_da1e9db6:

    # "Todo el mundo se reúne alrededor de la pérgola para ver cómo reaccionan las chicas a cada uno de los regalos."
    "Todos se reúnem ao redor da pérgola para ver como as meninas reagem a cada um dos presentes."

# game/scripts/c19/c19.rpy:1309
translate brazilian c19s003_Gifts_00690be5:

    # "Todas las chicas reciben ropa. Mucha ropa. En la mayoría de los casos aciertan con sus gustos."
    "Todas as meninas recebem roupas. Muitas roupas. Na maioria dos casos, elas acertam no gosto."

# game/scripts/c19/c19.rpy:1310
translate brazilian c19s003_Gifts_1bd082a1:

    # "También reciben vales para ir a un spa, colonias, complementos..."
    "Eles também recebem vouchers para tratamentos de spa, perfumes, acessórios..."

# game/scripts/c19/c19.rpy:1311
translate brazilian c19s003_Gifts_aad9effa:

    # "Todos los regalos son recibidos con sonrisas y abrazos de agradecimiento."
    "Todos os presentes são recebidos com sorrisos e abraços de gratidão."

# game/scripts/c19/c19.rpy:1314
translate brazilian c19s003_Gifts_25e705e9:

    # "Los cuadros de Maddie son una sensación. Las chicas están contentísimas con ellos y todo el mundo se ríe con lo adorable que está Zeus."
    "As pinturas de Maddie são um sucesso. As meninas estão encantadas com elas, e todos riem de como Zeus ficou adorável."

# game/scripts/c19/c19.rpy:1315
translate brazilian c19s003_Gifts_f52b2dd7:

    # "El cuadro de [dap] es diferente del que estaba pintando Maddie cuando estuviste en su casa. Le tienes que preguntar por qué."
    "A pintura em [dap] é diferente daquela que Maddie estava pintando quando você estava na casa dela. Você precisa perguntar a ela por quê."

# game/scripts/c19/c19.rpy:1317
translate brazilian c19s003_Gifts_e6d54ec6:

    # "Las cajas que ha traído Maddie son cuadros personalizados para las chicas. Les encantan y todo el mundo se ríe con lo adorable que está Zeus, el gato de Maddie."
    "As caixas que a Maddie trouxe são quadros personalizados para as meninas. Elas adoraram, e todo mundo riu de como o Zeus, o gato da Maddie, ficou adorável."

# game/scripts/c19/c19.rpy:1319
translate brazilian c19s003_Gifts_99b9f6d5:

    # "Las chicas dicen que los colgarán en sus habitaciones antes de acabar el día."
    "As meninas disseram que vão pendurá-las em seus quartos antes do fim do dia."

# game/scripts/c19/c19.rpy:1322
translate brazilian c19s003_Gifts_478da912:

    # "[emm] es la primera en llegar a tu regalo para ella."
    "[emm] é o primeiro a chegar ao seu presente para ela."

# game/scripts/c19/c19.rpy:1323
translate brazilian c19s003_Gifts_0750d1ad:

    # emm "¿Un sobre, [mc]? No has sido tan cutre como para regalarme dinero, ¿verdad?"
    emm "Um envelope, [mc]? Você não foi mesquinho o suficiente para me dar dinheiro, foi?"

# game/scripts/c19/c19.rpy:1324
translate brazilian c19s003_Gifts_1c32212c:

    # mc "*Risa* Ábrelo y lo sabrás. Pero no, no es dinero."
    mc "*Risos* Abra e você descobrirá. Mas não, não é dinheiro."

# game/scripts/c19/c19.rpy:1326
translate brazilian c19s003_Gifts_e18aee28:

    # emm "¿QUÉ? ¿Un vale de alquiler por un Ferrarini rosa? ¿Dónde has encontrado esto?"
    emm "O QUÊ? Um voucher de aluguel para uma Ferrari rosa? Onde você encontrou isso?"

# game/scripts/c19/c19.rpy:1327
translate brazilian c19s003_Gifts_79e24cc9:

    # mc "En Monterey. Es el único en todo el estado fuera de LA."
    mc "Em Monterey. É o único em todo o estado fora de Los Angeles."

# game/scripts/c19/c19.rpy:1329
translate brazilian c19s003_Gifts_52c65b1d:

    # emm "¡Me encanta! Cuando el otro día dije que quería uno no creía que existieran de alquiler."
    emm "Eu adorei! Quando eu disse outro dia que queria um, não imaginava que existissem para alugar."

# game/scripts/c19/c19.rpy:1330
translate brazilian c19s003_Gifts_b460952f:

    # mc "*Risa* Hace una semana que lo reservé. Tienes que usar el vale durante los próximos siete días."
    mc "*Risos* Reservei há uma semana. Você precisa usar o voucher nos próximos sete dias."

# game/scripts/c19/c19.rpy:1331
translate brazilian c19s003_Gifts_50cede59:

    # emm "¡Pues hay que organizar un viaje a Monterey! ¡Estoy impaciente!"
    emm "Precisamos planejar uma viagem para Monterey! Mal posso esperar!"

# game/scripts/c19/c19.rpy:1333
translate brazilian c19s003_Gifts_8846acee:

    # "La siguiente en llegar a tu regalo es [dap]."
    "O próximo item a chegar para o seu presente é [dap]."

# game/scripts/c19/c19.rpy:1334
translate brazilian c19s003_Gifts_466a6e26:

    # dap "¡Hey! Esto pesa... ¿Qué es?"
    dap "Ei! Isto é pesado... O que é isso?"

# game/scripts/c19/c19.rpy:1335
translate brazilian c19s003_Gifts_1724be0a:

    # mc "Lo tendrás que abrir para saberlo. *Risa*"
    mc "Você terá que abrir para descobrir. *Risos*"

# game/scripts/c19/c19.rpy:1337
translate brazilian c19s003_Gifts_72ceeaed:

    # dap "¡Es el Super Gamertron 4090! ¡Es mejor que el portátil que quería comprarme!"
    dap "É o Super Gamertron 4090! É melhor do que o notebook que eu queria comprar!"

# game/scripts/c19/c19.rpy:1338
translate brazilian c19s003_Gifts_1a14174b:

    # mc "Pues ya no necesitas comprártelo. Ya puedes jubilar tu viejo portátil."
    mc "Bom, você não precisa mais comprar um. Pode aposentar seu laptop antigo agora."

# game/scripts/c19/c19.rpy:1339
translate brazilian c19s003_Gifts_834fb5ec:

    # dap "Pero te has pasado mucho. ¡Es carísimo!"
    dap "Mas você exagerou demais. Está incrivelmente caro!"

# game/scripts/c19/c19.rpy:1341
translate brazilian c19s003_Gifts_3743811b:

    # dap "¡Gracias, [mc]! Es una auténtica pasada de portátil."
    dap "Obrigado, [mc]! É um laptop absolutamente incrível."

# game/scripts/c19/c19.rpy:1342
translate brazilian c19s003_Gifts_628fd6f6:

    # mc "Disfrútalo, pero no te pases la vida encerrada en tu habitación jugando. *Risa*"
    mc "Divirta-se, mas não passe a vida trancado no quarto jogando videogame. *Risos*"

# game/scripts/c19/c19.rpy:1343
translate brazilian c19s003_Gifts_72133550:

    # dap "Tranquilo, no lo haré. Hay cosas demasiado buenas aquí fuera."
    dap "Não se preocupe, não vou. Há muitas coisas boas por aí."

# game/scripts/c19/c19.rpy:1345
translate brazilian c19s003_Gifts_81e3e407:

    # "La última en llegar a tu regalo es [eri]."
    "O último a chegar ao seu presente é [eri]."

# game/scripts/c19/c19.rpy:1346
translate brazilian c19s003_Gifts_7324a3c8:

    # eri "¡Qué cajita más mona! ¿Un anillo?"
    eri "Que caixinha mais fofa! Um anel?"

# game/scripts/c19/c19.rpy:1347
translate brazilian c19s003_Gifts_998bae65:

    # mc "Tú también vas a tener que abrirlo para descubrirlo."
    mc "Você também terá que abri-lo para descobrir."

# game/scripts/c19/c19.rpy:1349
translate brazilian c19s003_Gifts_04d89bbe:

    # eri "¡Oh! ¡Son preciosos!"
    eri "Oh! São lindos!"

# game/scripts/c19/c19.rpy:1351
translate brazilian c19s003_Gifts_55acbb6c:

    # eri "¡Me encanta el triskelion!"
    eri "Adoro o triskelion!"

# game/scripts/c19/c19.rpy:1352
translate brazilian c19s003_Gifts_91052178:

    # mc "Al representar la evolución de una persona, pasado, presente, y futuro, creo que te pegan. Los diseñé y los hice fabricar para ti."
    mc "Ao representar a evolução de uma pessoa — passado, presente e futuro — acredito que elas criam uma conexão com você. Eu as desenhei e as mandei fazer especialmente para você."

# game/scripts/c19/c19.rpy:1353
translate brazilian c19s003_Gifts_44a5da68:

    # todas "¡Qué bonitos!"
    todas "Que lindo!"

# game/scripts/c19/c19.rpy:1355
translate brazilian c19s003_Gifts_3eacd17c:

    # eri "Déjame ponérmelos un momento."
    eri "Deixe-me colocá-los por um instante."

# game/scripts/c19/c19.rpy:1357
translate brazilian c19s003_Gifts_9880e837:

    # eri "¡Muchas gracias, [mc]! ¡Se acaban de convertir en mis pendientes favoritos!"
    eri "Muito obrigada, [mc]! Eles acabaram de se tornar meus brincos favoritos!"

# game/scripts/c19/c19.rpy:1358
translate brazilian c19s003_Gifts_588a4e65:

    # mc "Te quedan muy bien. Obsidiana sobre plata. Son tus colores."
    mc "Ficam ótimas em você. Obsidiana sobre prata. São as suas cores."

# game/scripts/c19/c19.rpy:1360
translate brazilian c19s003_Gifts_58b9e4fb:

    # "Después de eso siguen abriendo más regalos y dando más abrazos hasta que se acaban las cajas."
    "Depois disso, eles continuam abrindo mais presentes e dando mais abraços até que as caixas acabem."

# game/scripts/c19/c19.rpy:1363
translate brazilian c19s003_Gifts_48da537d:

    # "Mientras unos cuantos ayudáis a las chicas a subir sus regalos a sus habitaciones, otros recogéis toda la comida y los platos sucios."
    "Enquanto alguns de vocês ajudam as meninas a levar os presentes para os quartos, outros recolhem toda a comida e a louça suja."

# game/scripts/c19/c19.rpy:1365
translate brazilian c19s003_Gifts_95c286b9:

    # "Vais a comer sobras durante unos días. [nor] y [mar] siempre cocinan demasiado."
    "Você vai comer sobras por alguns dias. [nor] e [mar] sempre cozinham demais."

# game/scripts/c19/c19.rpy:1366
translate brazilian c19s003_Gifts_d6b2303e:

    # dap "Propongo una lucha de caballos en la piscina. Podemos hacer equipos..."
    dap "Proponho uma luta de cavalos na piscina. Podemos formar equipes..."

# game/scripts/c19/c19.rpy:1367
translate brazilian c19s003_Gifts_5789983e:

    # mc "Mucho ejercicio después de comer, ¿no? Aunque yo me apunto."
    mc "Bastante exercício depois de comer, não é? Mas eu topo."

# game/scripts/c19/c19.rpy:1368
translate brazilian c19s003_Gifts_10d194be:

    # mcp "(Tan solo espero que no pase lo mismo que la última vez.)"
    mcp "(Só espero que não aconteça a mesma coisa que da última vez.)"

# game/scripts/c19/c19.rpy:1369
translate brazilian c19s003_Gifts_dbbd2da2:

    # emm "Yo montaré a [mc] como la última vez. ¡Somos invencibles! Lo siento, [eri]."
    emm "Vou cavalgar [mc] como da última vez. Somos invencíveis! Desculpe, [eri]."

# game/scripts/c19/c19.rpy:1370
translate brazilian c19s003_Gifts_cc92d099:

    # eri "Podemos hacer equipos topless contra top. No sé si cuadran los números."
    eri "Podemos formar times sem camisa contra times de elite. Não sei se os números batem."

# game/scripts/c19/c19.rpy:1372
translate brazilian c19s003_Gifts_e886c995:

    # nor "Conmigo no contéis. Yo necesito reposar la comida un rato."
    nor "Não contem comigo. Preciso deixar a comida assentar um pouco."

# game/scripts/c19/c19.rpy:1373
translate brazilian c19s003_Gifts_669179a0:

    # mee "Yo también... Como dice [mc], demasiado ejercicio después de comer. Necesito un poco de descanso a la sombra."
    mee "Eu também... Como disse [mc], muito exercício depois de comer. Preciso descansar um pouco na sombra."

# game/scripts/c19/c19.rpy:1374
translate brazilian c19s003_Gifts_8037e8ad:

    # kat "Yo me apunto, no he comido tanto como para perderme la diversión. Aunque es difícil decidir..."
    kat "Eu topo! Não comi tanto a ponto de não querer perder a diversão. Embora seja uma decisão difícil..."

# game/scripts/c19/c19.rpy:1375
translate brazilian c19s003_Gifts_88eadbbb:

    # jam "Conmigo tampoco contéis. *Risa*"
    jam "Não conte com mim também. *Risos*"

# game/scripts/c19/c19.rpy:1376
translate brazilian c19s003_Gifts_11f06190:

    # "Al final, tan solo doce decidís lanzaros a la piscina. Podréis hacer dos equipos de seis."
    "No final, apenas doze de vocês decidem se aventurar. Vocês podem formar duas equipes de seis."

# game/scripts/c19/c19.rpy:1541
translate brazilian c19s004_PhoneMessage_d1504cf8:

    # "Mientras estáis discutiendo cómo distribuís los grupos, suena tu móvil"
    "Enquanto vocês discutem como distribuir os grupos, seu celular toca."

# game/scripts/c19/c19.rpy:1543
translate brazilian c19s004_PhoneMessage_b616f7c9:

    # sam "Te acaba de sonar el móvil, [mc]. Un mensaje de texto."
    sam "Seu celular acabou de tocar, [mc]. Uma mensagem de texto."

# game/scripts/c19/c19.rpy:1544
translate brazilian c19s004_PhoneMessage_f6cb428b:

    # mc "Léemelo. La clave para desbloquearlo es el cumpleaños de Jamaal."
    mc "Leia para mim. A chave para decifrá-lo é o aniversário de Jamaal."

# game/scripts/c19/c19.rpy:1546
translate brazilian c19s004_PhoneMessage_c01cdb95:

    # sam "¿Estás seguro?"
    sam "Tem certeza?"

# game/scripts/c19/c19.rpy:1547
translate brazilian c19s004_PhoneMessage_c0d76fae:

    # mc "No tengo ningún secreto que esconder. Puedes leerlo."
    mc "Não tenho segredos a esconder. Você pode ler."

# game/scripts/c19/c19.rpy:1549
translate brazilian c19s004_PhoneMessage_05633e0f:

    # sam "Un pedido de Amazonian, una mesa. Llega mañana."
    sam "Uma mesa, encomendada pela Amazon. Chega amanhã."

# game/scripts/c19/c19.rpy:1550
translate brazilian c19s004_PhoneMessage_617b883f:

    # mc "¿Ves como no era ningún secreto? *Risa*"
    mc "Viu? Não era segredo nenhum. *Risos*"

# game/scripts/c19/c19.rpy:1551
translate brazilian c19s004_PhoneMessage_e80224bf:

    # mc "Lo que es raro es que solo llegue la mesa."
    mc "O que é estranho é que só a mesa chega."

# game/scripts/c19/c19.rpy:1553
translate brazilian c19s004_PhoneMessage_ba794966:

    # "Suena el móvil de nuevo."
    "O celular toca novamente."

# game/scripts/c19/c19.rpy:1555
translate brazilian c19s004_PhoneMessage_311b391a:

    # mc "Si antes lo digo... Ese debe ser el otro pedido. ¿Puedes mirar cuando llega?"
    mc "Se eu disser isso antes... Deve ser o outro pedido. Você pode verificar quando chegar?"

# game/scripts/c19/c19.rpy:1558
translate brazilian c19s004_PhoneMessage_c7288ed0:

    # sam "No es de Amazonian... y no creo que quieras que lea este mensaje."
    sam "Não é da Amazon... e acho que você não quer que eu leia esta mensagem."

# game/scripts/c19/c19.rpy:1559
translate brazilian c19s004_PhoneMessage_b1d1f4eb:

    # mc "Puedes leerlo. Ya te he dicho que no tengo ningún secreto."
    mc "Você pode ler. Eu já disse que não tenho segredos."

# game/scripts/c19/c19.rpy:1560
translate brazilian c19s004_PhoneMessage_b5a0e928:

    # sam "Es... privado..."
    sam "É... privado..."

# game/scripts/c19/c19.rpy:1561
translate brazilian c19s004_PhoneMessage_8eda67a6:

    # mc "Léelo, Sam. Tengo las manos mojadas y no hay ningún secreto mío que no quiera que la familia conozca."
    mc "Leia, Sam. Minhas mãos estão molhadas, e não há nenhum segredo meu que eu não queira que a família saiba."

# game/scripts/c19/c19.rpy:1563
translate brazilian c19s004_PhoneMessage_e982ddfe:

    # sam "A ver si hay suerte y hoy también te puedes librar de la zorra de tu novia y podemos volver a estar juntos. Lo de anoche fue alucinante."
