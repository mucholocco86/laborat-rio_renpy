

# game/scripts/c19/c19.rpy:38
translate brazilian c19s001_JamaalSamantha_5118050b:

    # nor "Pasa a la piscina antes de ir a ponerte el bañador, si tienes curiosidad. Descubrirás que hay alguien con bañador de cuerpo entero."
    nor "Se você estiver curioso(a), vá até a piscina antes de vestir seu traje de banho. Você vai descobrir que tem alguém usando um maiô de uma peça."

# game/scripts/c19/c19.rpy:39
translate brazilian c19s001_JamaalSamantha_6d705a83:

    # mc "*Risa* Ya lo supongo. No esperaba que la mayoría fuera como vais tú y [eri]."
    mc "*Risos* Acho que sim. Não esperava que a maioria deles fosse como você e [eri]."

# game/scripts/c19/c19.rpy:41
translate brazilian c19s001_JamaalSamantha_311ca098:

    # nor "Yo voy a la cocina a por más cosas."
    nor "Vou até a cozinha pegar mais coisas."

# game/scripts/c19/c19.rpy:43
translate brazilian c19s001_JamaalSamantha_dd4c0927:

    # "Levantas una ceja mientras la miras inquisitivamente."
    "Você ergue uma sobrancelha enquanto a olha com um olhar interrogativo."

# game/scripts/c19/c19.rpy:45
translate brazilian c19s001_JamaalSamantha_357a6c4c:

    # nor "Vaaale, no voy a coger peso."
    nor "Ok, eu não vou engordar."

# game/scripts/c19/c19.rpy:46
translate brazilian c19s001_JamaalSamantha_22cabccc:

    # mc "Voy a saludar y a ponerme el bañador. En unos minutos iré a ayudarte."
    mc "Vou cumprimentá-lo e vestir meu maiô. Já volto para ajudá-lo."

# game/scripts/c19/c19.rpy:47
translate brazilian c19s001_JamaalSamantha_2aaf243c:

    # nor "OK. Te espero allí."
    nor "Certo. Vou esperar você lá."

# game/scripts/c19/c19.rpy:49
translate brazilian c19s001_JamaalSamantha_fe114f6e:

    # mc "¡Samantha y Jamaal! ¡Ya habéis llegado! ¿Dónde está Simone?"
    mc "Samantha e Jamaal! Vocês chegaram! Onde está a Simone?"

# game/scripts/c19/c19.rpy:50
translate brazilian c19s001_JamaalSamantha_e700eaaf:

    # mcp "(Samantha haciendo topless. La primera sorpresa del día.)"
    mcp "(Samantha de topless. A primeira surpresa do dia.)"

# game/scripts/c19/c19.rpy:56
translate brazilian c19s001_JamaalSamantha_503e55c5:

    # sam "Ha ido a cambiarse a la habitación de [emm]."
    sam "Ela foi se trocar no quarto [emm]."

# game/scripts/c19/c19.rpy:57
translate brazilian c19s001_JamaalSamantha_43126fd6:

    # jam "El más rápido cambiándome he sido yo. *Risa* No tenía que subir a ninguna habitación y he escondido la ropa detrás de un seto."
    jam "Eu fui a mais rápida na hora de me trocar. *Risos* Não precisei subir as escadas e escondi minhas roupas atrás de uma cerca viva."

# game/scripts/c19/c19.rpy:58
translate brazilian c19s001_JamaalSamantha_cd735ec2:

    # mc "*Risa* ¿Qué llevas puesto?"
    mc "*Risos* O que você está vestindo?"

# game/scripts/c19/c19.rpy:60
translate brazilian c19s001_JamaalSamantha_5db16ac1:

    # jam "Me escribiste que viniera en bikini. *Risa* Me probé uno de mi madre, pero no lo llenaba, con lo que me puse este que compré para una fiesta hace un par de años."
    jam "Você me mandou uma mensagem pedindo para eu ir de biquíni. *Risos* Eu experimentei um da minha mãe, mas não serviu, então usei este que comprei para uma festa há uns dois anos."

# game/scripts/c19/c19.rpy:61
translate brazilian c19s001_JamaalSamantha_83de7a24:

    # mc "*Risa* ¡Estás ridículo! Más incluso de lo habitual."
    mc "*Risos* Você está ridícula! Ainda mais do que o normal."

# game/scripts/c19/c19.rpy:63
translate brazilian c19s001_JamaalSamantha_ab0d92b9:

    # jam "Al menos yo no llevo una camiseta con un puerco dibujado. *Risa*"
    jam "Pelo menos não estou usando uma camiseta com um porco estampado. *Risos*"

# game/scripts/c19/c19.rpy:64
translate brazilian c19s001_JamaalSamantha_cb3a2f52:

    # mc "¡Me la regalaste tú antes de ir a la universidad! *Risa*"
    mc "Você me deu isso antes de eu ir para a universidade! *Risos*"

# game/scripts/c19/c19.rpy:66
translate brazilian c19s001_JamaalSamantha_51c20bf7:

    # jam "Que yo tenga un gusto pésimo para regalar ropa no significa que te la tengas que poner. *Risa* Además, te la regalé porque entonces estabas hecho un cerdo. Gordo."
    jam "Só porque eu tenho um gosto horrível para roupas não significa que você tenha que usá-las. *Risos* Além disso, eu as dei para você porque você era um porco naquela época. Gordo."

# game/scripts/c19/c19.rpy:67
translate brazilian c19s001_JamaalSamantha_2528113c:

    # mc "Volviendo a tu monokini... No sé si atreverme a preguntar que has hecho con tus herramientas para que te quepan ahí. *Risa*"
    mc "Voltando ao seu monokini... Não sei se me atrevo a perguntar o que você fez com suas ferramentas para que elas coubessem aí dentro. *Risos*"

# game/scripts/c19/c19.rpy:69
translate brazilian c19s001_JamaalSamantha_8e03d075:

    # jam "He tomado malas decisiones en mi vida, como regalarte esa camiseta. *Risa* Pero estar sentado encima de mis pelotas todo el día va a ser una de las peores."
    jam "Já tomei algumas decisões ruins na minha vida, como te dar aquela camisa. *Risos* Mas ficar sentado em cima dos meus testículos o dia todo vai ser uma das piores."

# game/scripts/c19/c19.rpy:70
translate brazilian c19s001_JamaalSamantha_326f4bd9:

    # mc "También has tomado alguna buena. *Risa* Te hiciste amigo mío."
    mc "Você também teve algumas boas. *Risos* Você se tornou meu amigo."

# game/scripts/c19/c19.rpy:71
translate brazilian c19s001_JamaalSamantha_5bdfd4aa:

    # jam "Dabas pena, siempre sentado solo, tú, tu panza, y tu caja de donuts. *Risa* Lo mejor de nuestra amistad fueron los donuts."
    jam "Você era patético, sempre sentado sozinho, você, sua barriga e sua caixa de donuts. *Risos* A melhor coisa da nossa amizade eram os donuts."

# game/scripts/c19/c19.rpy:73
translate brazilian c19s001_JamaalSamantha_10777086:

    # sam "No vais a cambiar nunca, ¿verdad?"
    sam "Você nunca vai mudar, não é?"

# game/scripts/c19/c19.rpy:74
translate brazilian c19s001_JamaalSamantha_eca07bee:

    # mc "Yo he cambiado. Ya no llevo la panza ni la caja de donuts."
    mc "Eu mudei. Não tenho mais barriga nem carrego mais uma caixa de donuts."

# game/scripts/c19/c19.rpy:76
translate brazilian c19s001_JamaalSamantha_1eddbf8f:

    # jam "Y yo también. *Risa* Sigo siendo su amigo aunque ya no tenga donuts."
    jam "Eu também. *Risos* Continuo sendo amigo dele, mesmo sem ter mais donuts."

# game/scripts/c19/c19.rpy:77
translate brazilian c19s001_JamaalSamantha_fe6cdaac:

    # mc "Porque soy tu único amigo y no puedes vivir sin mí. *Risa*"
    mc "Porque eu sou seu único amigo e você não consegue viver sem mim. *Risos*"

# game/scripts/c19/c19.rpy:79
translate brazilian c19s001_JamaalSamantha_7e992004:

    # sam "Me han dicho que se ha instaurado una nueva costumbre en esta casa. Algo sobre besos. ¿No me incluye a mí?"
    sam "Me disseram que existe um novo costume nesta casa. Algo relacionado a beijos. Isso não me inclui?"

# game/scripts/c19/c19.rpy:80
translate brazilian c19s001_JamaalSamantha_e3d54d03:

    # mc "Por supuesto, a toda la familia. Ven aquí."
    mc "Claro, toda a família. Venham cá."

# game/scripts/c19/c19.rpy:82
translate brazilian c19s001_JamaalSamantha_71e2ade5:

    # mc "Buenos días, Sam."
    mc "Bom dia, Sam."

# game/scripts/c19/c19.rpy:83
translate brazilian c19s001_JamaalSamantha_d7b7ee12:

    # sam "Buenos días, [mc]."
    sam "Bom dia, [mc]."

# game/scripts/c19/c19.rpy:85
translate brazilian c19s001_JamaalSamantha_6a9e914a:

    # jam "¡Yo también quiero! *Risa*"
    jam "Eu também quero! *Risos*"

# game/scripts/c19/c19.rpy:86
translate brazilian c19s001_JamaalSamantha_ef5f909f:

    # mc "*Risa* Para ti no hay."
    mc "*Risos* Não tem nenhum para você."

# game/scripts/c19/c19.rpy:88
translate brazilian c19s001_JamaalSamantha_ac72d3a7:

    # jam "¿Yo no soy de la familia? *Sniff*"
    jam "Eu não sou da família? *Snif*"

# game/scripts/c19/c19.rpy:89
translate brazilian c19s001_JamaalSamantha_ec18faec:

    # mc "Claro que lo eres, pero no quiero que tus herramientas sufran más si te tengo que besar. *Risa*"
    mc "Claro que sim, mas não quero que suas ferramentas sofram mais se eu tiver que te beijar. *Risos*"

# game/scripts/c19/c19.rpy:91
translate brazilian c19s001_JamaalSamantha_6105c928:

    # sam "¡[mc]!"
    sam "[mc]!"

# game/scripts/c19/c19.rpy:92
translate brazilian c19s001_JamaalSamantha_6adc66e8:

    # mc "¿Qué? Mis besos son irresistibles. *Risa* Pueden levantar a un muerto, pero no a Jamaal."
    mc "O quê? Meus beijos são irresistíveis. *Risos* Eles podem ressuscitar os mortos, mas não o Jamaal."

# game/scripts/c19/c19.rpy:93
translate brazilian c19s001_JamaalSamantha_6105c928_1:

    # sam "¡[mc]!"
    sam "[mc]!"

# game/scripts/c19/c19.rpy:94
translate brazilian c19s001_JamaalSamantha_2c98e69f:

    # mc "Va a tener que seguir sentado encima de su tesoro más preciado. Y no queremos que se le salga de ese bañador ridículo."
    mc "Ele vai ter que continuar sentado em cima do seu bem mais precioso. E não queremos que ele escape daquele maiô ridículo."

# game/scripts/c19/c19.rpy:96
translate brazilian c19s001_JamaalSamantha_96c786d6:

    # jam "¡Hey! Esa es nueva. *Risa* Estaba un poco harto de las bromas sobre morir de pie o vivir de rodillas."
    jam "Ei! Essa é nova. *Risos* Eu já estava ficando um pouco cansado das piadas sobre morrer de pé ou viver de joelhos."

# game/scripts/c19/c19.rpy:97
translate brazilian c19s001_JamaalSamantha_f13881dc:

    # mc "A tu servicio. Siempre pensando en nuevas formas de meterme contigo. *Risa*"
    mc "À sua disposição. Sempre pensando em novas maneiras de te perturbar. *Risos*"

# game/scripts/c19/c19.rpy:99
translate brazilian c19s001_JamaalSamantha_8199cab3:

    # mc "Voy a tener que llevarme a tu madre un rato."
    mc "Vou ter que levar sua mãe embora por um tempo."

# game/scripts/c19/c19.rpy:101
translate brazilian c19s001_JamaalSamantha_85640f55:

    # sam "¿A dónde? [nor] y [mar] me han dicho que no me acercara a las cocinas. Han dicho que hoy soy una invitada."
    sam "Para onde? [nor] e [mar] me disseram para não chegar perto das cozinhas. Disseram que hoje sou um convidado."

# game/scripts/c19/c19.rpy:102
translate brazilian c19s001_JamaalSamantha_578f0966:

    # mc "No tiene que ver con la comida, no te preocupes. Quiero enseñarte una cosa que tengo en mi habitación."
    mc "Não se preocupe, não tem nada a ver com comida. Quero te mostrar algo que tenho no meu quarto."

# game/scripts/c19/c19.rpy:103
translate brazilian c19s001_JamaalSamantha_1d3e8c57:

    # sam "Ah, OK. Vamos entonces."
    sam "Ah, ok. Vamos então."

# game/scripts/c19/c19.rpy:105
translate brazilian c19s001_JamaalSamantha_6950d2e0:

    # mc "Voy a subir a ponerme el bañador a mi habitación. Bajo en un momento."
    mc "Vou subir para o meu quarto para vestir meu maiô. Já desço."

# game/scripts/c19/c19.rpy:107
translate brazilian c19s001_JamaalSamantha_bcd2c740:

    # mc "Tú puedes venir también si quieres, Jam."
    mc "Você também pode vir se quiser, Jam."

# game/scripts/c19/c19.rpy:108
translate brazilian c19s001_JamaalSamantha_90dab542:

    # jam "Creo que voy a pasar. Ya te he visto desnudo antes y no vale la pena arrastrarme por esas escaleras para volver a hacerlo."
    jam "Acho que vou passar. Já te vi nua antes, e não vale a pena descer aquelas escadas de novo."

# game/scripts/c19/c19.rpy:109
translate brazilian c19s001_JamaalSamantha_2819466c:

    # jam "Seguro que cuando bajase tu madre había tirado la silla porque molestaba o estaba fuera de su sitio. *Risa*"
    jam "Aposto que quando sua mãe desceu as escadas, já tinha derrubado a cadeira porque estava atrapalhando ou fora do lugar. *Risos*"

# game/scripts/c19/c19.rpy:110
translate brazilian c19s001_JamaalSamantha_d49d398e:

    # mc "Entonces te veo luego. Bajo en un momento."
    mc "Então, te vejo mais tarde. Já desço."

# game/scripts/c19/c19.rpy:112
translate brazilian c19s001_JamaalSamantha_dac5c695:

    # jam "Hasta ahora. Yo esperaré aquí, al lado de los entremeses que va a bajar [mar]. No sé si quedarán cuando bajes."
    jam "Até a próxima. Vou esperar aqui, ao lado dos aperitivos que você vai trazer [mar]. Não sei se ainda vai ter sobrado algum quando você descer."

# game/scripts/c19/c19.rpy:113
translate brazilian c19s001_JamaalSamantha_ff25755d:

    # mc "Ahora mando a Betty para que los proteja. *Risa* Le diré que quiero bendecir la mesa y no dejará que nadie coma hasta que vuelva."
    mc "Vou mandar a Betty protegê-los agora. *Risos* Vou dizer a ela que quero abençoar a mesa, e ela não vai deixar ninguém comer até eu voltar."

# game/scripts/c19/c19.rpy:114
translate brazilian c19s001_JamaalSamantha_f174f893:

    # jam "Eres un mal amigo... *Risa*"
    jam "Você é um péssimo amigo... *Risos*"

# game/scripts/c19/c19.rpy:117
translate brazilian c19s001_JamaalSamantha_86b6560f:

    # sam "Antes de que te vayas... ¿puedo hablar un momento contigo?"
    sam "Antes de você ir... posso falar com você um instante?"

# game/scripts/c19/c19.rpy:118
translate brazilian c19s001_JamaalSamantha_99e18188:

    # mc "Por supuesto. Hoy va a estar toda la familia y va a ser complicado estar a solas."
    mc "Claro. Toda a família estará aqui hoje, e vai ser difícil ficar sozinha."

# game/scripts/c19/c19.rpy:120
translate brazilian c19s001_JamaalSamantha_6fc4168e:

    # mc "¿De qué quieres hablar?"
    mc "Sobre o que você quer conversar?"

# game/scripts/c19/c19.rpy:125
translate brazilian c19s001_JamaalSamantha_55baa74f:

    # sam "Entonces no te entretengo más."
    sam "Então não vou te reter mais."

# game/scripts/c19/c19.rpy:126
translate brazilian c19s001_JamaalSamantha_5de00e22:

    # mc "Nos vemos en un rato."
    mc "Te vejo daqui a pouco."

# game/scripts/c19/c19.rpy:153
translate brazilian c19s001_Samantha_f1bce70a:

    # "Al llegar a tu habitación..."
    "Ao chegar ao seu quarto..."

# game/scripts/c19/c19.rpy:155
translate brazilian c19s001_Samantha_f46a3ca1:

    # sam "¡Qué difícil se hace mantener el secreto delante de Jamaal y darte solamente un besito!"
    sam "Como é difícil guardar o segredo do Jamaal e te dar só um beijinho!"

# game/scripts/c19/c19.rpy:156
translate brazilian c19s001_Samantha_f788e185:

    # sam "¡Ven aquí!"
    sam "Venha aqui!"

# game/scripts/c19/c19.rpy:157
translate brazilian c19s001_Samantha_f1ade4c5:

    # mc "A tus órdenes."
    mc "À sua disposição."

# game/scripts/c19/c19.rpy:159
translate brazilian c19s001_Samantha_53af3091:

    # "Los jugosos labios de Samantha aprisionan los tuyos."
    "Os lábios carnudos de Samantha aprisionam os seus."

# game/scripts/c19/c19.rpy:160
translate brazilian c19s001_Samantha_c2df9130:

    # "Sus tetas presionan contra tu pecho."
    "Os seios dela estão pressionando seu peito."

# game/scripts/c19/c19.rpy:161
translate brazilian c19s001_Samantha_946683a0:

    # "Vuestras manos recorren la piel del otro."
    "Suas mãos percorrem a pele uma da outra."

# game/scripts/c19/c19.rpy:162
translate brazilian c19s001_Samantha_37a64a23:

    # "Hasta que Sam se separa de ti."
    "Até Sam te deixar."

# game/scripts/c19/c19.rpy:164
translate brazilian c19s001_Samantha_353e217f:

    # sam "Si quieres llegar a tiempo para la comida, mejor parar, ¿no?"
    sam "Se você quiser chegar a tempo para o almoço, o melhor é parar, não é?"

# game/scripts/c19/c19.rpy:165
translate brazilian c19s001_Samantha_8c9617c3:

    # mc "Es difícil parar. Te veo tan poco que cuando te tengo entre mis brazos se me hace casi imposible."
    mc "É difícil parar. Vejo você tão pouco que, quando te tenho em meus braços, parece quase impossível."

# game/scripts/c19/c19.rpy:167
translate brazilian c19s001_Samantha_687f7a10:

    # sam "Lo sé... pero con el trabajo tengo muy poco tiempo libre..."
    sam "Eu sei... mas com o trabalho tenho muito pouco tempo livre..."

# game/scripts/c19/c19.rpy:168
translate brazilian c19s001_Samantha_7f3c1fa3:

    # sam "Y cuando tengo tiempo libre, Jamaal está en casa."
    sam "E quando tenho tempo livre, Jamaal está em casa."

# game/scripts/c19/c19.rpy:169
translate brazilian c19s001_Samantha_659d9eab:

    # mc "No te preocupes, encontraremos tiempo para nosotros."
    mc "Não se preocupe, encontraremos tempo para nós mesmos."

# game/scripts/c19/c19.rpy:171
translate brazilian c19s001_Samantha_511116f9:

    # sam "¿Qué querías enseñarme?"
    sam "O que você queria me ensinar?"

# game/scripts/c19/c19.rpy:172
translate brazilian c19s001_Samantha_3f736ac8:

    # mc "¿Cuánto te han contado de Amanda y Eva?"
    mc "O quanto eles te contaram sobre Amanda e Eva?"

# game/scripts/c19/c19.rpy:173
translate brazilian c19s001_Samantha_8128d629:

    # "Te pone al día sobre cuánto sabe. Tú la pones al día sobre las pruebas de embarazo."
    "Ela te atualiza sobre o que sabe. Você a atualiza sobre os testes de gravidez."

# game/scripts/c19/c19.rpy:175
translate brazilian c19s001_Samantha_dce327da:

    # sam "¿Eso existe? Tiene que ser tecnología muy avanzada... no he oído nunca hablar de algo así."
    sam "Isso existe mesmo? Deve ser uma tecnologia muito avançada... Nunca ouvi falar de nada parecido."

# game/scripts/c19/c19.rpy:176
translate brazilian c19s001_Samantha_de67792a:

    # mc "Por lo que me comentó Amanda, mide no-se-qué hormonas de una forma que no se había podido medir hasta ahora, al menos de forma doméstica."
    mc "Segundo o que Amanda me contou, ele mede alguns hormônios de uma forma que não era possível medir até agora, pelo menos não em casa."

# game/scripts/c19/c19.rpy:177
translate brazilian c19s001_Samantha_642ca2f7:

    # mc "NTR no solo se dedica a lo que todos sabemos, sino que parece ser que tiene una división muy importante de medicina aplicada."
    mc "A NTR não só faz o que todos nós sabemos, como também parece ter uma divisão de medicina aplicada muito importante."

# game/scripts/c19/c19.rpy:179
translate brazilian c19s001_Samantha_598345fc:

    # sam "Y quieres que me haga la prueba, ¿no?"
    sam "E você quer que eu faça o teste, não é?"

# game/scripts/c19/c19.rpy:180
translate brazilian c19s001_Samantha_4be413bb:

    # mc "Sólo si tú quieres. O si has notado algún síntoma. Tenemos los tests, con lo que creo que sería una buena idea saberlo."
    mc "Só se você quiser. Ou se tiver notado algum sintoma. Temos os testes, então acho que seria uma boa ideia saber."

# game/scripts/c19/c19.rpy:182
translate brazilian c19s001_Samantha_df3f7f8e:

    # sam "¿Y qué querrías que saliera en el test?"
    sam "E o que você gostaria de ver na prova?"

# game/scripts/c19/c19.rpy:185
translate brazilian c19s001_Samantha_c9913328:

    # mc "No me malinterpretes, no voy a sentirme mal si sale negativo, pero me haría ilusión tener un hijo contigo."
    mc "Não me entenda mal, não ficarei chateada se o resultado for negativo, mas adoraria ter um filho com você."

# game/scripts/c19/c19.rpy:187
translate brazilian c19s001_Samantha_71d0efb3:

    # mc "No me malinterpretes, pero hasta que se lo digamos a Jamaal preferiría no enredarlo más."
    mc "Não me interpretem mal, mas até contarmos ao Jamaal, prefiro não complicar ainda mais as coisas."

# game/scripts/c19/c19.rpy:189
translate brazilian c19s001_Samantha_e821820e:

    # mc "Te voy a querer igual salga una cosa o la otra."
    mc "Eu te amarei não importa o que aconteça."

# game/scripts/c19/c19.rpy:190
translate brazilian c19s001_Samantha_43623649:

    # mc "¿Y tú? ¿Qué te gustaría a ti que saliera en el test?"
    mc "E você? O que gostaria de ver na prova?"

# game/scripts/c19/c19.rpy:192
translate brazilian c19s001_Samantha_a4a61ba3:

    # sam "No lo he pensado aún. Si sale positivo me alegraré, aunque tiene riesgos a mi edad. Ya he pasado de los 40..."
    sam "Ainda não pensei nisso. Se o resultado for positivo, ficarei feliz, embora existam riscos na minha idade. Já passei dos 40..."

# game/scripts/c19/c19.rpy:193
translate brazilian c19s001_Samantha_8f06e46a:

    # sam "Pero si sale negativo no me voy a sentir decepcionada. A mi edad la fertilidad cae considerablemente, con lo que no espero que me dejes embarazada en dos intentos."
    sam "Mas se o resultado for negativo, não ficarei desapontada. Na minha idade, a fertilidade diminui consideravelmente, então não espero engravidar em duas tentativas."

