    # oma "Ponte el bañador. Yo voy a ponerme algo y bajo contigo."
    oma "Vista seu traje de banho. Eu vou vestir algo e descer com você."

# game/scripts/c19/c19.rpy:4287
translate brazilian c19s008_LeeroyJenkins_1be34397:

    # mc "Mejor que no te metas, al menos de momento. Voy a intentar solucionarlo por las buenas."
    mc "É melhor você não se envolver, pelo menos por enquanto. Vou tentar resolver isso amigavelmente."

# game/scripts/c19/c19.rpy:4288
translate brazilian c19s008_LeeroyJenkins_240030cf:

    # mc "Mantén a las chicas alejadas. Ese tío puede ser imprevisible."
    mc "Mantenha as garotas longe. Aquele cara pode ser imprevisível."

# game/scripts/c19/c19.rpy:4290
translate brazilian c19s008_LeeroyJenkins_a915782e:

    # sol "¡Eres una puta zorra! Paseándote con las tetas al aire en casa de ese... perdedor."
    sol "Você é uma puta do caralho! Andando por aí com os peitos de fora na casa daquele perdedor."

# game/scripts/c19/c19.rpy:4291
translate brazilian c19s008_LeeroyJenkins_ea4ca4c7:

    # mcp "(El top de Kiara se ha quedado en el jacuzzi...)"
    mcp "(A blusa da Kiara ainda está na jacuzzi...)"

# game/scripts/c19/c19.rpy:4292
translate brazilian c19s008_LeeroyJenkins_462b782c:

    # kia "Solomon, por favor, vete a casa. Estamos celebrando un cumpleaños."
    kia "Solomon, por favor, vá para casa. Estamos comemorando um aniversário."

# game/scripts/c19/c19.rpy:4293
translate brazilian c19s008_LeeroyJenkins_3a034dbd:

    # mc "Haz caso a Kiara, Solomon. No eres bienvenido en esta casa."
    mc "Escuta a Kiara, Solomon. Você não é bem-vindo nesta casa."

# game/scripts/c19/c19.rpy:4295
translate brazilian c19s008_LeeroyJenkins_01e183f2:

    # sol "¡Tú cállate! He venido a llevarme a mi mujer a casa, donde debe estar."
    sol "Cale-se! Vim buscar minha esposa para levá-la para casa, para onde ela pertence."

# game/scripts/c19/c19.rpy:4296
translate brazilian c19s008_LeeroyJenkins_df2883a4:

    # kia "No me voy a ir, Solomon."
    kia "Eu não vou a lugar nenhum, Salomão."

# game/scripts/c19/c19.rpy:4297
translate brazilian c19s008_LeeroyJenkins_810a241b:

    # mc "Ya la has oído. Ella no va a salir, y tú no vas a entrar en mi casa."
    mc "Você ouviu o que ela disse. Ela não vai sair e você não vai entrar na minha casa."

# game/scripts/c19/c19.rpy:4298
translate brazilian c19s008_LeeroyJenkins_eb6d7957:

    # mc "Kiara, no salgas de la propiedad. Ponte detrás mío."
    mc "Kiara, não saia da propriedade. Fique atrás de mim."

# game/scripts/c19/c19.rpy:4300
translate brazilian c19s008_LeeroyJenkins_a91ceb59:

    # mc "Id a la piscina, por favor. Alexia, ¿puedes ocuparte?"
    mc "Vá para a piscina, por favor. Alexia, você pode cuidar disso?"

# game/scripts/c19/c19.rpy:4301
translate brazilian c19s008_LeeroyJenkins_f172a36b:

    # oma "No te preocupes. Chicas, acompañadme, por favor."
    oma "Não se preocupem. Meninas, por favor, venham comigo."

# game/scripts/c19/c19.rpy:4302
translate brazilian c19s008_LeeroyJenkins_0a722cb6:

    # eil "Yo me quedo. Quiero ver qué hace la piltrafa humana."
    eil "Vou ficar. Quero ver o que aquele desastre humano vai aprontar."

# game/scripts/c19/c19.rpy:4304
translate brazilian c19s008_LeeroyJenkins_459224bd:

    # "Alexia te mira interrogativamente."
    "Alexia olha para você com um olhar interrogativo."

# game/scripts/c19/c19.rpy:4305
translate brazilian c19s008_LeeroyJenkins_c95b64af:

    # "Asientes."
    "Você acena com a cabeça."

# game/scripts/c19/c19.rpy:4306
translate brazilian c19s008_LeeroyJenkins_8203bdc9:

    # "Eileen tiene todo el derecho a estar aquí."
    "Eileen tem todo o direito de estar aqui."

# game/scripts/c19/c19.rpy:4308
translate brazilian c19s008_LeeroyJenkins_0ce3bd13:

    # sol "¿Llamas piltrafa a tu exnovio? *Risa* Eso no le deja en muy buen lugar."
    sol "Você chama seu ex-namorado de lixo? *Risos* Isso não o pinta exatamente de uma forma positiva."

# game/scripts/c19/c19.rpy:4309
translate brazilian c19s008_LeeroyJenkins_9e43f0c3:

    # mc "Y esa frase no te deja a ti en muy buen lugar. Se refiere a ti, no a mí."
    mc "E essa declaração não pega bem para você. Diz respeito a você, não a mim."

# game/scripts/c19/c19.rpy:4311
translate brazilian c19s008_LeeroyJenkins_e85c874f:

    # sol "¡Puta zorra! ¡De tal palo tal astilla!"
    sol "Sua puta desgraçada! Tal mãe, tal filha!"

# game/scripts/c19/c19.rpy:4312
translate brazilian c19s008_LeeroyJenkins_19c5956b:

    # mc "No vuelvas a insultar a ninguna de las dos, Solomon. Ni a nadie que esté en esta casa."
    mc "Nunca mais insulte nenhum deles, Salomão. Nem ninguém mais nesta casa."

# game/scripts/c19/c19.rpy:4313
translate brazilian c19s008_LeeroyJenkins_f2c838ea:

    # "La sangre empieza a calentársete."
    "Seu sangue começa a esquentar."

# game/scripts/c19/c19.rpy:4315
translate brazilian c19s008_LeeroyJenkins_c3142867:

    # kia "Por favor, Solomon. Vete. No voy a volver a casa contigo."
    kia "Por favor, Salomão, vá embora. Eu não vou para casa com você."

# game/scripts/c19/c19.rpy:4317
translate brazilian c19s008_LeeroyJenkins_974aad27:

    # sol "¿Por qué? ¿Te estás follando a este perdedor?"
    sol "Por quê? Você está dormindo com esse perdedor?"

# game/scripts/c19/c19.rpy:4318
translate brazilian c19s008_LeeroyJenkins_fb0ba74e:

    # sol "¿No te das cuenta de lo patética que eres a tu edad persiguiendo a críos?"
    sol "Você não percebe o quão patético você é nessa idade, correndo atrás de crianças?"

# game/scripts/c19/c19.rpy:4319
translate brazilian c19s008_LeeroyJenkins_71efead2:

    # "La sangre empieza a hervir. Mantienes la calma."
    "Seu sangue começa a ferver. Você mantém a calma."

# game/scripts/c19/c19.rpy:4321
translate brazilian c19s008_LeeroyJenkins_9cb80a8b:

    # "Sales de casa."
    "Você sai de casa."

# game/scripts/c19/c19.rpy:4322
translate brazilian c19s008_LeeroyJenkins_3795eb8b:

    # mc "Te he dicho que no vuelvas a insultarla."
    mc "Eu te disse para não insultá-la novamente."

# game/scripts/c19/c19.rpy:4323
translate brazilian c19s008_LeeroyJenkins_912bc6cc:

    # sol "Cuidadito con lo que haces con ese dedo, gilipollas."
    sol "Cuidado com o que você faz com esse dedo, seu idiota."

# game/scripts/c19/c19.rpy:4325
translate brazilian c19s008_LeeroyJenkins_d85c0de5:

    # mc "Mira, capullo. Estoy usando el dedo por no usar el puño."
    mc "Olha aqui, seu idiota. Estou usando meu dedo porque não quero usar meu punho."

# game/scripts/c19/c19.rpy:4327
translate brazilian c19s008_LeeroyJenkins_20afbd2e:

    # mc "La última vez no lo necesité para tumbarte. No quise humillarte delante de Kiara y Eileen en frente de tu casa."
    mc "Da última vez, não precisei fazer isso para te derrubar. Eu não queria te humilhar na frente da Kiara e da Eileen, em frente à sua casa."

# game/scripts/c19/c19.rpy:4329
translate brazilian c19s008_LeeroyJenkins_c0379dce:

    # mc "Esta vez has venido a mi casa. No voy a tener tantos miramientos. Te he dicho que no volvieras a insultar a nadie de esta casa y acabas de insultarme a mí."
    mc "Dessa vez você veio à minha casa. Não vou ser tão tolerante. Eu disse para você não insultar mais ninguém nesta casa, e você acabou de me insultar."

# game/scripts/c19/c19.rpy:4330
translate brazilian c19s008_LeeroyJenkins_c07ea8e0:

    # mc "No voy a permitirte que insultes a Kiara."
    mc "Não permitirei que você insulte Kiara."

# game/scripts/c19/c19.rpy:4332
translate brazilian c19s008_LeeroyJenkins_c78e1851:

    # eil "Vete, Solomon. No tienes nada que hacer aquí."
    eil "Vá embora, Salomão. Você não tem nada a ver com este lugar."

# game/scripts/c19/c19.rpy:4333
translate brazilian c19s008_LeeroyJenkins_728104ba:

    # mcp "(Solomon, no Papá.)"
    mcp "(Salomão, não o pai.)"

# game/scripts/c19/c19.rpy:4335
translate brazilian c19s008_LeeroyJenkins_8fa531ad:

    # sol "Déjame llevarme a mi mujer y no te molestaré más."
    sol "Deixe-me levar minha esposa e não o incomodarei mais."

# game/scripts/c19/c19.rpy:4336
translate brazilian c19s008_LeeroyJenkins_d26bc837:

    # sol "Puedes quedarte con la zorra de mi hija."
    sol "Pode ficar com a minha filha vadia."

# game/scripts/c19/c19.rpy:4337
translate brazilian c19s008_LeeroyJenkins_3d39fe45:

    # "Tienes la sangre a punto de explotar."
    "Seu sangue está prestes a explodir."

# game/scripts/c19/c19.rpy:4349
translate brazilian c19s008_LeeroyJenkins_fc7df051:

    # "Nunca habías abofeteado a nadie. Sienta bien en este caso. Sabes que una bofetada así es humillante."
    "Você nunca deu um tapa em ninguém antes. Nesse caso, a sensação é boa. Você sabe que um tapa desses é humilhante."

# game/scripts/c19/c19.rpy:4350
translate brazilian c19s008_LeeroyJenkins_4e228a13:

    # mc "Te he dicho que no insultes a nadie."
    mc "Eu te disse para não insultar ninguém."

# game/scripts/c19/c19.rpy:4352
translate brazilian c19s008_LeeroyJenkins_41f7eec9:

    # sol "¡Me has abofeteado!"
    sol "Você me deu um tapa!"

# game/scripts/c19/c19.rpy:4353
translate brazilian c19s008_LeeroyJenkins_4c91d575:

    # mc "Los puños los guardo para los hombres de verdad."
    mc "Guardo meus punhos para homens de verdade."

# game/scripts/c19/c19.rpy:4354
translate brazilian c19s008_LeeroyJenkins_7ea246e2:

    # mc "Tú estás lejos de serlo."
    mc "Você está longe de ser um deles."

# game/scripts/c19/c19.rpy:4356
translate brazilian c19s008_LeeroyJenkins_1a9ad5a1:

    # sol "¡Pelea como un hombre, capullo!"
    sol "Lute como um homem, seu idiota!"

# game/scripts/c19/c19.rpy:4357
translate brazilian c19s008_LeeroyJenkins_e3a7942a:

    # mc "Hoy no tienes la excusa de estar borracho, gilipollas."
    mc "Você não pode usar a embriaguez como desculpa hoje, seu idiota."

# game/scripts/c19/c19.rpy:4358
translate brazilian c19s008_LeeroyJenkins_578f34f3:

    # mc "Si tú empiezas una pelea, la voy a acabar yo."
    mc "Se você começar uma briga, eu vou acabar com ela."

# game/scripts/c19/c19.rpy:4360
translate brazilian c19s008_LeeroyJenkins_630b2e1f:

    # kia "No hace falta que le pegues, [mc]."
    kia "Você não precisa bater nele, [mc]."

# game/scripts/c19/c19.rpy:4361
translate brazilian c19s008_LeeroyJenkins_bdc91648:

    # kia "No me voy a ir con él. Ni ahora ni nunca."
    kia "Eu não vou com ele. Nem agora, nem nunca."

# game/scripts/c19/c19.rpy:4363
translate brazilian c19s008_LeeroyJenkins_7b5310a4:

    # "Detectas movimiento en la periferia de tu visión."
    "Você percebe movimentos na periferia do seu campo de visão."

# game/scripts/c19/c19.rpy:4364
translate brazilian c19s008_LeeroyJenkins_4e4f74ea:

    # "Te giras justo a tiempo."
    "Você se vira bem a tempo."

# game/scripts/c19/c19.rpy:4366
translate brazilian c19s008_LeeroyJenkins_5bf09d2d:

    # "La piltrafa humana, como lo ha llamado Eileen, ha intentado un puñetazo a traición."
    "O homem, como Eileen o chamava, tentou desferir um soco traiçoeiro."

# game/scripts/c19/c19.rpy:4367
translate brazilian c19s008_LeeroyJenkins_c89ee1a6:

    # "Esos reflejos que no habías usado desde la segunda pelea con Jack entran en funcionamiento."
    "Aqueles reflexos que você não usava desde a segunda luta com Jack voltam à tona."

# game/scripts/c19/c19.rpy:4370
translate brazilian c19s008_LeeroyJenkins_ef88d85c:

    # "Paras su puño con tu mano izquierda. Te queda la derecha libre."
    "Você para o punho dele com a mão esquerda. Sua mão direita fica livre."

# game/scripts/c19/c19.rpy:4371
translate brazilian c19s008_LeeroyJenkins_946e1d97:

    # "Tu sangre entra en erupción."
    "Seu sangue jorra."

# game/scripts/c19/c19.rpy:4381
translate brazilian c19s008_LeeroyJenkins_6af241dd:

    # "Tu puño derecho pasa de estar al lado de tu cintura a estar en la nariz de Solomon. Casi parece que se ha movido solo."
    "Seu punho direito se move da lateral da sua cintura até o nariz de Salomão. Parece até que se moveu sozinho."

# game/scripts/c19/c19.rpy:4382
translate brazilian c19s008_LeeroyJenkins_1ef4d8c1:

    # mcp "(¡Joder! El capullo tiene la cabeza más dura que Jack.)"
    mcp "(Caramba! Aquele idiota tem a cabeça mais dura que a do Jack.)"

# game/scripts/c19/c19.rpy:4384
translate brazilian c19s008_LeeroyJenkins_cdcf862e:

    # "Solomon sale volando, dejando un rastro de sangre saliendo a reacción por su nariz."
    "Salomão voa para longe, deixando um rastro de sangue jorrando de seu nariz."

# game/scripts/c19/c19.rpy:4385
translate brazilian c19s008_LeeroyJenkins_2b91c97b:

    # "Acabas de hacer un favor a todos los hombres que recibieron como respuesta \"cuando los cerdos vuelen\" al pedirle sexo anal a su mujer."
    "Você acabou de fazer um favor a todos os homens que receberam como resposta \"só quando porcos voarem\" ao pedirem sexo anal às suas esposas."

# game/scripts/c19/c19.rpy:4386
translate brazilian c19s008_LeeroyJenkins_76b98c01:

    # "Vuela como un cerdo. Sangra como un cerdo."
    "Voa como um porco. Sangra como um porco."

# game/scripts/c19/c19.rpy:4389
translate brazilian c19s008_LeeroyJenkins_73d69c06:

    # "*Dong*"
    "*Dong*"

# game/scripts/c19/c19.rpy:4390
translate brazilian c19s008_LeeroyJenkins_9fc04637:

    # "Su cabeza al impactar contra la furgoneta suena como un gong."
    "Ao bater com a cabeça na van, o som que ele faz é semelhante ao de um gongo."

# game/scripts/c19/c19.rpy:4392
translate brazilian c19s008_LeeroyJenkins_ee81eee1:

    # mc "No te levantes, Solomon. O mejor aún, levántate para irte."
    mc "Não se levante, Salomão. Ou melhor ainda, levante-se e vá embora."

# game/scripts/c19/c19.rpy:4393
translate brazilian c19s008_LeeroyJenkins_1b1dcd26:

    # sol "¡Me has pegado!"
    sol "Você me bateu!"

# game/scripts/c19/c19.rpy:4394
translate brazilian c19s008_LeeroyJenkins_a8340ccf:

    # mc "¿Vas a dejar de decir obviedades? Levántate, sube al coche, y vete."
    mc "Vai parar de falar o óbvio? Levante-se, entre no seu carro e vá embora."

# game/scripts/c19/c19.rpy:4395
translate brazilian c19s008_LeeroyJenkins_6e3cd313:

    # mc "O ven a por más."
    mc "Ou venha para mais."

# game/scripts/c19/c19.rpy:4397
translate brazilian c19s008_LeeroyJenkins_d2ca2fd2:

    # kia "Solomon, vete a tu casa. No voy a irme contigo."
    kia "Salomão, vá para casa. Eu não vou com você."

# game/scripts/c19/c19.rpy:4399
translate brazilian c19s008_LeeroyJenkins_638073db:

    # eil "No hagas caso a Mama, Solomon. Levántate e intenta pegarle de nuevo."
    eil "Não dê ouvidos à mamãe, Solomon. Levante-se e tente bater nele de novo."

# game/scripts/c19/c19.rpy:4400
translate brazilian c19s008_LeeroyJenkins_ba0f98bd:

    # eil "[mc] es mucho más hombre de lo que tú nunca has sido. No es una mujer, que es a lo que estás acostumbrado a pegarle."
    eil "[mc] é muito mais homem do que você jamais foi. Ele não é uma mulher, que é o tipo de mulher que você costuma bater."

# game/scripts/c19/c19.rpy:4402
translate brazilian c19s008_LeeroyJenkins_696e0f70:

    # mc "No tengo ganas de darte una paliza, pero lo haré si es necesario."
    mc "Não estou com vontade de te bater, mas farei isso se for necessário."

# game/scripts/c19/c19.rpy:4403
translate brazilian c19s008_LeeroyJenkins_5a6c0259:

    # mc "¡Qué coño! Tengo ganas de dártela, pero no quiero fastidiar la fiesta."
    mc "Que droga! Eu realmente quero te dar, mas não quero estragar a festa."

# game/scripts/c19/c19.rpy:4404
translate brazilian c19s008_LeeroyJenkins_1af643d0:

    # sol "No te vas a quedar con mi mujer, hijo de puta."
    sol "Você não vai ficar com a minha esposa, seu filho da puta."

# game/scripts/c19/c19.rpy:4416
translate brazilian c19s008_LeeroyJenkins_ab20f4de:

    # mc "Me vas a poner muy difícil lo de no darte una paliza si no dejas de insultar a mi familia."
    mc "Você vai dificultar muito a minha vida se não parar de insultar a minha família e acabar me dando uma surra."

# game/scripts/c19/c19.rpy:4418
translate brazilian c19s008_LeeroyJenkins_a0150e17:

    # sol "¿Tu familia? ¡Esa es mi familia! Solo quiero recuperarla."
    sol "Sua família? Essa é a minha família! Eu só quero eles de volta."

# game/scripts/c19/c19.rpy:4420
translate brazilian c19s008_LeeroyJenkins_4c4b2720:

    # eil "¿Recuperarla? ¿Así?"
    eil "Recuperar? Assim?"

# game/scripts/c19/c19.rpy:4421
translate brazilian c19s008_LeeroyJenkins_02e8ee48:

    # eil "Vienes aquí tratando a Mamá como mierda. Como has hecho siempre. Exigiéndole que vuelva a casa..."
    eil "Você vem aqui tratando a mamãe como lixo. Como sempre fez. Exigindo que ela volte para casa..."

# game/scripts/c19/c19.rpy:4423
translate brazilian c19s008_LeeroyJenkins_113e14c7:

    # kia "Llevo casi una semana aquí, Solomon. En una semana me han mostrado más respeto y cariño que tú en 22 años."
    kia "Já faz quase uma semana que estou aqui, Salomão. Em uma semana, recebi mais respeito e carinho do que você em 22 anos."

# game/scripts/c19/c19.rpy:4424
translate brazilian c19s008_LeeroyJenkins_9069d1ab:

    # kia "Esto es una familia. Lo que nosotros teníamos era una mala imitación de lo que debe ser una familia."
    kia "Isto é uma família. O que tínhamos era uma pobre imitação do que uma família deveria ser."

# game/scripts/c19/c19.rpy:4426
translate brazilian c19s008_LeeroyJenkins_28d74db7:

    # eil "Mamá es feliz aquí. Nunca volverá contigo."
    eil "Mamãe está feliz aqui. Ela nunca mais voltará para você."

# game/scripts/c19/c19.rpy:4428
translate brazilian c19s008_LeeroyJenkins_66e08abe:

    # sol "¡Estamos casados! ¡Nunca te daré el divorcio!"
    sol "Estamos casados! Eu nunca vou te dar o divórcio!"

# game/scripts/c19/c19.rpy:4429
translate brazilian c19s008_LeeroyJenkins_5f892040:

    # sol "¡Estarás viviendo en pecado con este niñato!"
    sol "Você vai viver em pecado com esse pirralho!"

# game/scripts/c19/c19.rpy:4430
translate brazilian c19s008_LeeroyJenkins_98593f5b:

    # mc "A mí puedes insultarme. Esta vez."
    mc "Você pode me insultar. Desta vez."

# game/scripts/c19/c19.rpy:4432
translate brazilian c19s008_LeeroyJenkins_24bbc047:

    # kia "[mc] y yo no estamos juntos, Solomon. Tan solo lo estamos en tu imaginación."
    kia "[mc] e eu não estamos juntos, Salomão. Estamos juntos apenas na sua imaginação."

# game/scripts/c19/c19.rpy:4433
translate brazilian c19s008_LeeroyJenkins_dd16249f:

    # kia "Vete a tu casa y déjanos en paz. Esta es una fiesta a la que no estás invitado."
    kia "Vá para casa e nos deixe em paz. Esta é uma festa para a qual você não foi convidado."

# game/scripts/c19/c19.rpy:4435
translate brazilian c19s008_LeeroyJenkins_a0336692:

    # eil "No están juntos..."
    eil "Eles não estão juntos..."

# game/scripts/c19/c19.rpy:4437
translate brazilian c19s008_LeeroyJenkins_52feb4c8:

    # eil "Pero, si de mí depende, lo van a estar. Yo me ocuparé de ello."
    eil "Mas se depender de mim, eles estarão lá. Eu cuidarei disso."

# game/scripts/c19/c19.rpy:4439
translate brazilian c19s008_LeeroyJenkins_6cc920fb:

    # eil "Pero podrían estarlo. [mc] es más y mejor hombre de lo que tú serás nunca."
    eil "Mas eles poderiam ser. [mc] Ele é mais homem e melhor do que você jamais será."

# game/scripts/c19/c19.rpy:4441
translate brazilian c19s008_LeeroyJenkins_2772c22a:

    # kia "¡Calla, Eileen!"
    kia "Cala a boca, Eileen!"

# game/scripts/c19/c19.rpy:4442
translate brazilian c19s008_LeeroyJenkins_a50eb134:

    # mc "Puede opinar, Kiara. También es... era su familia."
    mc "Você pode ter sua opinião, Kiara. Mas... era a família dela."

# game/scripts/c19/c19.rpy:4444
translate brazilian c19s008_LeeroyJenkins_a05bb931:

    # kia "Puede opinar sobre su padre. No sobre lo que yo haga con mi vida o con quién esté. Es mi vida, no la suya."
    kia "Você pode ter uma opinião sobre seu pai. Mas não sobre o que eu faço da minha vida ou com quem eu ando. É a minha vida, não a sua."

# game/scripts/c19/c19.rpy:4446
translate brazilian c19s008_LeeroyJenkins_e30ddaa0:

    # mcp "(Parece que la conversación entre ellas no ha ido como Eileen esperaba.)"
    mcp "(Ao que parece, a conversa entre eles não correu como Eileen esperava.)"

# game/scripts/c19/c19.rpy:4447
translate brazilian c19s008_LeeroyJenkins_fc0388ef:

    # mc "Tienes razón. Es algo que solo tú puedes decidir."
    mc "Você tem razão. É algo que só você pode decidir."

# game/scripts/c19/c19.rpy:4449
translate brazilian c19s008_LeeroyJenkins_99d5d37c:

    # sol "¿Con quién estés? ¡Tienes que estar conmigo, maldita zorra! ¡Soy tu marido a los ojos de Dios!"
    sol "Com quem você está? Você tem que estar comigo, sua puta desgraçada! Eu sou seu marido aos olhos de Deus!"

# game/scripts/c19/c19.rpy:4450
translate brazilian c19s008_LeeroyJenkins_ab7fb63b:

    # mc "Te lo he advertido..."
    mc "Eu te avisei..."

# game/scripts/c19/c19.rpy:4452
translate brazilian c19s008_LeeroyJenkins_d1bab443:

    # sol "¡Oh, no!"
    sol "Oh não!"

# game/scripts/c19/c19.rpy:4462
translate brazilian c19s008_LeeroyJenkins_f5e6587d:

    # "La sensación de tu pie desnudo impactando en sus testículos es desagradable."
    "A sensação do seu pé descalço impactando os testículos dele é desagradável."

# game/scripts/c19/c19.rpy:4463
translate brazilian c19s008_LeeroyJenkins_a40dfba0:

    # "La sensación de darle su merecido es increíble."
    "A sensação de dar a ele o que ele merece é incrível."

# game/scripts/c19/c19.rpy:4465
translate brazilian c19s008_LeeroyJenkins_e2ab98af:

    # sol "*Voz aguda* ¡Cabrón!"
    sol "*Voz aguda* Seu desgraçado!"

# game/scripts/c19/c19.rpy:4466
translate brazilian c19s008_LeeroyJenkins_d08ef8bb:

    # mc "No te vuelvas a levantar si no es para subirte al coche e irte."
    mc "Não se levante novamente, a menos que seja para entrar no carro e ir embora."

# game/scripts/c19/c19.rpy:4467
translate brazilian c19s008_LeeroyJenkins_38ec08ab:

    # mc "No vuelvas a abrir la boca. Ni siquiera para despedirte."
    mc "Não abra a boca novamente. Nem mesmo para dizer adeus."

# game/scripts/c19/c19.rpy:4468
translate brazilian c19s008_LeeroyJenkins_65c209ee:

    # mc "Esto ya está dejando de ser divertido."
    mc "Isso está começando a deixar de ser divertido."

# game/scripts/c19/c19.rpy:4469
translate brazilian c19s008_LeeroyJenkins_5349938f:

    # mcp "(Nunca he sido un tipo violento, y estoy disfrutando esto demasiado.)"
    mcp "(Nunca fui um cara violento, e estou gostando demais disso.)"

# game/scripts/c19/c19.rpy:4471
translate brazilian c19s008_LeeroyJenkins_095a2187:

    # "Solomon te hace caso. Se levanta y se dirige al coche, con la cabeza baja, sin decir una palabra."
    "Salomão te ouve. Ele se levanta e vai até o carro, de cabeça baixa, sem dizer uma palavra."

# game/scripts/c19/c19.rpy:4474
translate brazilian c19s008_LeeroyJenkins_753a8298:

    # "Se sienta en el coche, en silencio, durante unos segundos, antes de encender el motor."
    "Ele permanece sentado no carro, em silêncio, por alguns segundos, antes de ligar o motor."

# game/scripts/c19/c19.rpy:4477
translate brazilian c19s008_LeeroyJenkins_283f1067:

    # "Kiara te coge de los hombros y te gira hacia ella."
    "Kiara segura seus ombros e te vira para ela."

# game/scripts/c19/c19.rpy:4478
translate brazilian c19s008_LeeroyJenkins_158d2335:

    # kia "Gracias, [mc]. Tenías razón. No voy a estar mejor que en esta familia en ningún sitio."
    kia "Obrigado, [mc]. Você tinha razão. Não estaria melhor em nenhum outro lugar a não ser com esta família."

# game/scripts/c19/c19.rpy:4479
translate brazilian c19s008_LeeroyJenkins_891b627e:

    # "Las piernas empiezan a temblarte. La adrenalina empieza a mostrar sus desagradables efectos secundarios."
    "Suas pernas começam a tremer. A adrenalina começa a mostrar seus efeitos colaterais desagradáveis."

# game/scripts/c19/c19.rpy:4480
translate brazilian c19s008_LeeroyJenkins_67d9bfb6:

    # mc "Siempre tendrás tu lugar aquí, Kiara."
    mc "Você sempre terá seu lugar aqui, Kiara."

# game/scripts/c19/c19.rpy:4482
translate brazilian c19s008_LeeroyJenkins_b40e2d98:

    # kia "¡Gracias, [mc]! ¡Gracias a todos vosotros!"
    kia "Obrigado, [mc]! Obrigado a todos!"

# game/scripts/c19/c19.rpy:4483
translate brazilian c19s008_LeeroyJenkins_5471c728:

    # "Tus piernas están temblando. Todo el cuerpo de Kiara tiembla como una hoja en un otoño ventoso."
    "Suas pernas estão tremendo. O corpo inteiro de Kiara está tremendo como uma folha ao vento no outono."

# game/scripts/c19/c19.rpy:4484
translate brazilian c19s008_LeeroyJenkins_c1aace3c:

    # "La abrazas fuertemente. Te abraza como si su vida dependiera de ello."
    "Você a abraça com força. Ela retribui o abraço como se sua vida dependesse disso."

# game/scripts/c19/c19.rpy:4485
translate brazilian c19s008_LeeroyJenkins_6f4b263a:

    # "Escuchas un sonido detrás tuyo. La puerta del coche de Solomon abriéndose."
    "Você ouve um barulho atrás de você. É a porta do carro de Solomon se abrindo."

# game/scripts/c19/c19.rpy:4486
translate brazilian c19s008_LeeroyJenkins_714fc161:

    # ama "¡Cuidado!"
    ama "Cuidadoso!"

# game/scripts/c19/c19.rpy:4487
translate brazilian c19s008_LeeroyJenkins_adf0f7a9:

    # eil "¡[mc]!"
    eil "[mc]!"

# game/scripts/c19/c19.rpy:4488
translate brazilian c19s008_LeeroyJenkins_439d3b98:

    # oma "¡Detrás tuyo!"
    oma "Atrás de você!"

# game/scripts/c19/c19.rpy:4489
translate brazilian c19s008_LeeroyJenkins_85fbbe57:

    # todas "*Cacofonía de advertencias*"
    todas "*Cacofonia de avisos*"

# game/scripts/c19/c19.rpy:4491
translate brazilian c19s008_LeeroyJenkins_8bdc711a:

    # "Giras la cabeza en el último segundo. Tus brazos aún alrededor de Kiara."
    "Você vira a cabeça no último segundo. Seus braços ainda estão em volta de Kiara."

# game/scripts/c19/c19.rpy:4492
translate brazilian c19s008_LeeroyJenkins_337ec51e:

    # sol "¡Hijo de la gran puta!"
    sol "Seu filho da puta!"

# game/scripts/c19/c19.rpy:4493
translate brazilian c19s008_LeeroyJenkins_f08408ee:

    # "Si esquivas el golpe se lo puede llevar Kiara. Te preparas para detener el golpe. Estás en situación de desventaja"
    "Se você se esquivar do golpe, Kiara pode recebê-lo. Você se prepara para bloquear o golpe. Você está em desvantagem."

# game/scripts/c19/c19.rpy:4496
translate brazilian c19s008_LeeroyJenkins_ee71ee81:

    # "*Bang*"
    "*Bang*"

# game/scripts/c19/c19.rpy:4497
translate brazilian c19s008_LeeroyJenkins_83dbbdbf:

    # sol "¿Qué?"
    sol "Que?"

# game/scripts/c19/c19.rpy:4502
translate brazilian c19s008_LeeroyJenkins_d5a56970:

    # "Amanda aparece de la nada, saltando la valla, y pegándole una patada a Solomon que parece salida de una película."
    "Amanda surge do nada, pula a cerca e chuta Solomon de um jeito que parece saído diretamente de um filme."

# game/scripts/c19/c19.rpy:4505
translate brazilian c19s008_LeeroyJenkins_af65a8e7:

    # "¿De dónde ha salido el disparo?"
    "De onde veio o tiro?"

# game/scripts/c19/c19.rpy:4507
translate brazilian c19s008_LeeroyJenkins_755f8aaa:

    # "Eva te mira, con una mezcla de alivio, sonrisa, y disculpa en su cara."
    "Eva olha para você com uma mistura de alívio, um sorriso e um pedido de desculpas no rosto."

# game/scripts/c19/c19.rpy:4508
translate brazilian c19s008_LeeroyJenkins_cf3fbc11:

    # "Sabe que [mar] no quiere armas en casa. ¿La tenía escondida entre las plantas?"
    "Ela sabe que [mar] não quer armas em casa. Será que ela as escondeu entre as plantas?"

# game/scripts/c19/c19.rpy:4509
translate brazilian c19s008_LeeroyJenkins_7eaf563f:

    # "Por una vez, te alegra que su respeto por las normas sea más bien laxo."
    "Desta vez, você fica feliz por eles não respeitarem tanto as regras."

# game/scripts/c19/c19.rpy:4511
translate brazilian c19s008_LeeroyJenkins_8b2fdf10:

    # ama "Sube al coche y vete, pedazo de mierda. A menos que quieras probar a hacer un Leroy Jenkins."
    ama "Entra no carro e vai embora, seu merda. A menos que queira tentar um Leroy Jenkins."

# game/scripts/c19/c19.rpy:4512
translate brazilian c19s008_LeeroyJenkins_00ba3df1:

    # ama "Mi hermana nunca falla. Si vuelves a intentar algo así..."
    ama "Minha irmã nunca falha. Se você tentar algo assim de novo..."

# game/scripts/c19/c19.rpy:4513
translate brazilian c19s008_LeeroyJenkins_b42a3937:

    # ama "Piensa que en este bosque hay mucho terreno donde enterrar un cadáver y que no lo encuentren nunca."
    ama "Ele acha que nesta floresta há muito terreno onde poderia enterrar um corpo e nunca o encontrar."

# game/scripts/c19/c19.rpy:4514
translate brazilian c19s008_LeeroyJenkins_899e0325:

    # "Habla tan calmadamente que da miedo."
    "Ele fala com tanta calma que chega a ser assustador."

# game/scripts/c19/c19.rpy:4516
translate brazilian c19s008_LeeroyJenkins_aa925d4b:

    # "Solomon se levanta, cada vez más magullado. Mantiene la puerta de la camioneta entre él y Amanda. Como si le fuese a servir de defensa."
    "Solomon se levanta, cada vez mais machucado. Ele mantém a porta da caminhonete entre ele e Amanda, como se fosse servir de defesa."

# game/scripts/c19/c19.rpy:4517
translate brazilian c19s008_LeeroyJenkins_c1ae4f17:

    # sol "¡Os voy a denunciar! ¡Me habéis disparado!"
    sol "Vou denunciá-lo! Você atirou em mim!"

# game/scripts/c19/c19.rpy:4518
translate brazilian c19s008_LeeroyJenkins_b95a66f9:

    # mc "Demuéstralo, gilipollas."
    mc "Prove, seu idiota."

# game/scripts/c19/c19.rpy:4520
translate brazilian c19s008_LeeroyJenkins_e0428106:

    # ama "Hazlo si quieres. O mejor. Inténtalo."
    ama "Faça se quiser. Ou melhor ainda, experimente."

# game/scripts/c19/c19.rpy:4521
translate brazilian c19s008_LeeroyJenkins_ebfd2b74:

    # ama "Vuelve a amenazar a alguien más de mi familia, vuelve a intentar tocarlos, y no podrás contarlo."
    ama "Ameaçar qualquer outro membro da minha família novamente, tentar tocá-los novamente, e você não estará aqui para contar a história."

# game/scripts/c19/c19.rpy:4522
translate brazilian c19s008_LeeroyJenkins_50b1e620:

    # "Ahora sí que da miedo."
    "Isso é assustador."

# game/scripts/c19/c19.rpy:4523
translate brazilian c19s008_LeeroyJenkins_87555f7c:

    # mc "Creo que lo ha entendido, Amanda."
    mc "Acho que ela entende, Amanda."

# game/scripts/c19/c19.rpy:4525
translate brazilian c19s008_LeeroyJenkins_dfea3863:

    # mc "No te quiero volver a ver en mi casa."
    mc "Não quero te ver na minha casa novamente."

# game/scripts/c19/c19.rpy:4526
translate brazilian c19s008_LeeroyJenkins_a1c1d637:

    # mc "No quiero volver a escuchar tu voz."
    mc "Não quero ouvir sua voz novamente."

# game/scripts/c19/c19.rpy:4527
translate brazilian c19s008_LeeroyJenkins_a8d1d279:

    # mc "No te quiero volver a ver cerca de Kiara ni de Eileen."
    mc "Não quero te ver perto da Kiara ou da Eileen novamente."

# game/scripts/c19/c19.rpy:4528
translate brazilian c19s008_LeeroyJenkins_2f31a434:

    # sol "Me las pagarás..."
    sol "Você vai pagar por isso..."

# game/scripts/c19/c19.rpy:4529
translate brazilian c19s008_LeeroyJenkins_992d8a38:

    # mc "Te he dicho que no quiero volver a escuchar tu voz."
    mc "Eu já disse que não quero ouvir sua voz novamente."

# game/scripts/c19/c19.rpy:4531
translate brazilian c19s008_LeeroyJenkins_dcf06b9f:

    # "Solomon parece entrar en razón. O quizás su cerebro ha entendido que no le queda ninguna ventaja."
    "Parece que Salomão está voltando a si. Ou talvez seu cérebro tenha percebido que ele não tem mais nenhuma vantagem."

# game/scripts/c19/c19.rpy:4533
translate brazilian c19s008_LeeroyJenkins_55b2617c:

    # "Entra en el coche sin decir una palabra. Se sienta en silencio, bajo la atenta mirada de Amanda."
    "Ele entra no carro sem dizer uma palavra. Senta-se em silêncio, sob o olhar atento de Amanda."

# game/scripts/c19/c19.rpy:4537
translate brazilian c19s008_LeeroyJenkins_7887c072:

    # eil "Hazlo, Mamá."
    eil "Faça isso, mãe."

# game/scripts/c19/c19.rpy:4539
translate brazilian c19s008_LeeroyJenkins_f74dc452:

    # kia "Pero..."
    kia "Mas..."

# game/scripts/c19/c19.rpy:4541
translate brazilian c19s008_LeeroyJenkins_8193ee6f:

    # eil "Hazlo, Mamá. Es el momento."
    eil "Faça isso, mãe. Já está na hora."

# game/scripts/c19/c19.rpy:4543
translate brazilian c19s008_LeeroyJenkins_b2bf6aaa:

    # kia "Chicas... siento todo esto..."
    kia "Meninas... Me desculpem por tudo isso..."

# game/scripts/c19/c19.rpy:4544
translate brazilian c19s008_LeeroyJenkins_8e0d5d9c:

    # kia "Siento que esta situación haya fastidiado la fiesta."
    kia "Lamento que essa situação tenha estragado a festa."

# game/scripts/c19/c19.rpy:4545
translate brazilian c19s008_LeeroyJenkins_64882bcd:

    # kia "Pero tengo una cosa que decir..."
    kia "Mas tenho uma coisa a dizer..."

# game/scripts/c19/c19.rpy:4547
translate brazilian c19s008_LeeroyJenkins_b02f5fdb:

    # kia "[mc] y yo hemos estado hablando... y después he hablado con mi hija..."
    kia "[mc] e eu estávamos conversando... e então falei com minha filha..."

# game/scripts/c19/c19.rpy:4550
translate brazilian c19s008_LeeroyJenkins_29736878:

    # kia "También he hablado con [mar] y está de acuerdo."
    kia "Eu também falei com [mar] e ele concorda."

# game/scripts/c19/c19.rpy:4552
translate brazilian c19s008_LeeroyJenkins_cab30a92:

    # kia "También he hablado con Saira y está de acuerdo."
    kia "Também falei com a Saira e ela concorda."

# game/scripts/c19/c19.rpy:4554
translate brazilian c19s008_LeeroyJenkins_c18db85a:

    # kia "También he hablado con [nor] y está de acuerdo."
    kia "Eu também falei com [nor] e ele concorda."

# game/scripts/c19/c19.rpy:4556
translate brazilian c19s008_LeeroyJenkins_d1d910a8:

    # kia "También he hablado con [emm] y está de acuerdo."
    kia "Eu também falei com [emm] e ele concorda."

# game/scripts/c19/c19.rpy:4558
translate brazilian c19s008_LeeroyJenkins_66e7499e:

    # kia "También he hablado con [eri] y está de acuerdo."
    kia "Eu também falei com [eri] e ele concorda."

# game/scripts/c19/c19.rpy:4560
translate brazilian c19s008_LeeroyJenkins_d8f5783b:

    # kia "También he hablado con [dap] y está de acuerdo."
    kia "Eu também falei com [dap] e ele concorda."

# game/scripts/c19/c19.rpy:4562
translate brazilian c19s008_LeeroyJenkins_12d06e69:

    # kia "También he hablado con Scarlett y está de acuerdo."
    kia "Também falei com a Scarlett e ela concorda."

# game/scripts/c19/c19.rpy:4564
translate brazilian c19s008_LeeroyJenkins_1e87bf9b:

    # kia "También he hablado con Sam y está de acuerdo."
    kia "Também falei com o Sam e ele concorda."

# game/scripts/c19/c19.rpy:4566
translate brazilian c19s008_LeeroyJenkins_e1070de7:

    # kia "También he hablado con Simone y está de acuerdo."
    kia "Também falei com a Simone e ela concorda."

# game/scripts/c19/c19.rpy:4568
translate brazilian c19s008_LeeroyJenkins_e7e6c60f:

    # kia "No he tenido la oportunidad de hablar con Alexia, y no sé si estará de acuerdo..."
    kia "Não tive oportunidade de falar com a Alexia, e não sei se ela concordará..."

# game/scripts/c19/c19.rpy:4570
translate brazilian c19s008_LeeroyJenkins_76167c06:

    # oma "Si vas a decir lo que me imagino, por mí adelante."
    oma "Se você vai dizer o que eu imagino, fique à vontade."

# game/scripts/c19/c19.rpy:4572
translate brazilian c19s008_LeeroyJenkins_7b835157:

    # kia "También he hablado con Maddie y está de acuerdo."
    kia "Também falei com a Maddie e ela concorda."

# game/scripts/c19/c19.rpy:4574
translate brazilian c19s008_LeeroyJenkins_41e754ec:

    # kia "También he hablado con Debbie y está de acuerdo."
    kia "Também falei com a Debbie e ela concorda."

# game/scripts/c19/c19.rpy:4576
translate brazilian c19s008_LeeroyJenkins_46e2f77a:

    # kia "También he hablado con Megan y está de acuerdo."
    kia "Também falei com a Megan e ela concorda."

# game/scripts/c19/c19.rpy:4578
translate brazilian c19s008_LeeroyJenkins_5ac4d5c9:

    # kia "No sé si las chicas del harén vais a odiarme o a aceptarme... Espero que sea lo último. Al menos con las que he tenido la oportunidad de hablar así ha sido."
    kia "Não sei se vocês, garotas do harém, vão me odiar ou me aceitar... Espero que seja a segunda opção. Pelo menos foi assim com as que tive a oportunidade de conversar."

# game/scripts/c19/c19.rpy:4580
translate brazilian c19s008_LeeroyJenkins_15ee5a58:

    # kia "Es el momento de que deje de engañarme. De que afronte mis sentimientos..."
    kia "Chegou a hora de parar de me enganar. Chegou a hora de encarar meus sentimentos..."

# game/scripts/c19/c19.rpy:4581
translate brazilian c19s008_LeeroyJenkins_a0565c6d:

    # kia "Si me aceptas, me gustaría explorar los sentimientos de los que hemos hablado antes. No voy a conseguir que dejen de crecer."
    kia "Se você concordar, gostaria de explorar os sentimentos que já discutimos. Não poderei impedir que eles cresçam."

# game/scripts/c19/c19.rpy:4582
translate brazilian c19s008_LeeroyJenkins_27c7f22c:

    # mc "Kiara, ¿aceptarte? Estaría loco si no lo hiciera. Y ya has hecho tú todo el trabajo..."
    mc "Kiara, te aceitar? Eu seria louco de não aceitar. E você já fez todo o trabalho..."

# game/scripts/c19/c19.rpy:4584
translate brazilian c19s008_LeeroyJenkins_eabde2c9:

    # "Kiara se lanza a tus brazos otra vez. Esta vez no busca un abrazo, busca tus labios."
    "Kiara se joga em seus braços novamente. Desta vez, ela não está buscando um abraço, mas sim seus lábios."

# game/scripts/c19/c19.rpy:4585
translate brazilian c19s008_LeeroyJenkins_5ee15f04:

    # "Tímidamente al principio. Con más énfasis mientras pasan los segundos..."
    "Inicialmente hesitante. Com mais ênfase à medida que os segundos passam..."

# game/scripts/c19/c19.rpy:4586
translate brazilian c19s008_LeeroyJenkins_0287327d:

    # "Los dos sabéis que es el primer beso de muchos, que va a hacer de tus labios su hogar."
    "Vocês dois sabem que este é o primeiro de muitos beijos, que ele fará dos seus lábios a sua morada."

# game/scripts/c19/c19.rpy:4587
translate brazilian c19s008_LeeroyJenkins_4565571c:

    # "Un hogar que, obviamente, nunca compartirá con Solomon."
    "Uma casa que, obviamente, ela nunca compartilhará com Solomon."

# game/scripts/c19/c19.rpy:4589
translate brazilian c19s008_LeeroyJenkins_d03b200e:

    # "Tan solo Amanda presta atención a la cara de sorpresa de Solomon."
    "Apenas Amanda presta atenção à expressão de surpresa no rosto de Solomon."

# game/scripts/c19/c19.rpy:4591
translate brazilian c19s008_LeeroyJenkins_64ced3c3:

    # "Solo ella se da cuenta de que arranca el coche y se va."
    "Só ela percebe que ele liga o carro e vai embora."

# game/scripts/c19/c19.rpy:4593
translate brazilian c19s008_LeeroyJenkins_b0cdee7e:

    # kia "*Susurrando* Creo que es lo más difícil que he hecho nunca. Pero sienta tan bien..."
    kia "*Sussurrando* Acho que esta é a coisa mais difícil que já fiz. Mas a sensação é ótima..."

# game/scripts/c19/c19.rpy:4594
translate brazilian c19s008_LeeroyJenkins_05625234:

    # mc "Me alegra que hayas dado este paso, Kiara."
    mc "Fico feliz que você tenha dado esse passo, Kiara."

# game/scripts/c19/c19.rpy:4596
translate brazilian c19s008_LeeroyJenkins_81b096b8:

    # emm "¡Ha sido tan romántico! ¡Parece el guion de una película romántica mala! Pero ha quedado tan bonito..."
    emm "Foi tão romântico! Parece o roteiro de um filme romântico ruim! Mas no final ficou tão lindo..."

# game/scripts/c19/c19.rpy:4599
translate brazilian c19s008_LeeroyJenkins_88eba539:

    # "Kiara se vuelve a lanzar a tus brazos en un abrazo lleno de agradecimiento."
    "Kiara se joga de volta em seus braços num abraço agradecido."

# game/scripts/c19/c19.rpy:4601
translate brazilian c19s008_LeeroyJenkins_08bd797a:

    # emm "¡Ha sido alucinante! ¡Parece el guion de una película romántica mala! Sólo ha faltado que os besarais..."
    emm "Foi incrível! Parece o roteiro de um filme romântico ruim! Só faltou você me beijar..."

# game/scripts/c19/c19.rpy:4603
translate brazilian c19s008_LeeroyJenkins_622f6099:

    # "Solo Amanda se da cuenta de que Solomon arranca el coche y se va."
    "Somente Amanda percebe Solomon ligando o carro e saindo dirigindo."

# game/scripts/c19/c19.rpy:4606
translate brazilian c19s008_LeeroyJenkins_d9c3e52d:

    # "Las chicas arrancan a Kiara de tus brazos y se la llevan hacia la piscina. Ellas también quieren consolarla."
    "As meninas tiram Kiara dos seus braços e a levam para a piscina. Elas também querem confortá-la."

# game/scripts/c19/c19.rpy:4609
translate brazilian c19s008_LeeroyJenkins_122e328a:

    # "O felicitarla por su decisión de dejar completamente atrás su pasado."
    "Ou parabenize-a pela decisão de deixar completamente o passado para trás."

# game/scripts/c19/c19.rpy:4611
translate brazilian c19s008_LeeroyJenkins_07195c57:

    # ama "Nunca más vuelvas a hacerme esto, [mc]."
    ama "Nunca mais faça isso comigo, [mc]."

# game/scripts/c19/c19.rpy:4612
translate brazilian c19s008_LeeroyJenkins_bd40a085:

    # ama "Nunca des la espalda a un enemigo, aunque parezca derrotado."
    ama "Nunca dê as costas a um inimigo, mesmo que ele pareça derrotado."

# game/scripts/c19/c19.rpy:4613
translate brazilian c19s008_LeeroyJenkins_bff1a070:

    # mc "Lo siento... y gracias."
    mc "Sinto muito... e agradeço."

# game/scripts/c19/c19.rpy:4615
translate brazilian c19s008_LeeroyJenkins_4ec51ccf:

    # eva "Y pídele disculpas a [mar] de mi parte por haber escondido algunas armas en su casa..."
    eva "E peça desculpas a [mar] por mim por ter escondido algumas armas na casa dele..."

# game/scripts/c19/c19.rpy:4616
translate brazilian c19s008_LeeroyJenkins_d9b09568:

    # eva "A mí me da vergüenza... nos habéis tratado tan bien que... siento que os he traicionado... un poco."
    eva "Tenho vergonha... você nos tratou tão bem que... sinto que te traí... um pouco."

# game/scripts/c19/c19.rpy:4617
translate brazilian c19s008_LeeroyJenkins_3197866c:

    # mc "No creo que le importe en este caso."
    mc "Acho que, neste caso, ele não se importa."

# game/scripts/c19/c19.rpy:4618
translate brazilian c19s008_LeeroyJenkins_1f570604:

    # mc "Y gracias a ti también."
    mc "E eu também agradeço."

# game/scripts/c19/c19.rpy:4619
translate brazilian c19s008_LeeroyJenkins_b5724e16:

    # mc "¿Cuántas armas tienes repartidas por la casa?"
    mc "Quantas armas você tem espalhadas pela casa?"

# game/scripts/c19/c19.rpy:4621
translate brazilian c19s008_LeeroyJenkins_57e5295a:

    # eva "Siete... no, ocho... Pero nadie las ha encontrado nunca."
    eva "Sete... não, oito... Mas ninguém nunca os encontrou."

# game/scripts/c19/c19.rpy:4622
translate brazilian c19s008_LeeroyJenkins_04eb13ec:

    # mc "Creo que sería bueno que las retiraras, o las pusieras en una caja fuerte o algo..."
    mc "Acho que seria uma boa ideia removê-los, ou guardá-los em um cofre ou algo assim..."

# game/scripts/c19/c19.rpy:4624
translate brazilian c19s008_LeeroyJenkins_691a5fed:

    # eva "Pero hoy han servido de algo... Si hubiera estado en una caja fuerte, dentro de casa..."
    eva "Mas hoje elas me foram úteis... Se eu estivesse em um cofre, dentro de casa..."

# game/scripts/c19/c19.rpy:4625
translate brazilian c19s008_LeeroyJenkins_de5dddd4:

    # mc "Por eso no le va a importar. Pero no va a querer armas por casa al alcance de cualquiera."
    mc "É por isso que ele não vai se importar. Mas ele não vai querer armas espalhadas pela casa, facilmente acessíveis a qualquer pessoa."

# game/scripts/c19/c19.rpy:4627
translate brazilian c19s008_LeeroyJenkins_66cce053:

    # ama "No, no le va a hacer ilusión, pero tenemos que tener medios para proteger a la familia."
    ama "Não, ele não ficará feliz com isso, mas precisamos ter os meios para proteger a família."

# game/scripts/c19/c19.rpy:4628
translate brazilian c19s008_LeeroyJenkins_7d371bd8:

    # ama "Aunque hoy lo has hecho muy bien excepto por lo de darle la espalda. La violencia justa y, especialmente, necesaria. No te has excedido."
    ama "Embora você tenha se saído muito bem hoje, exceto por ter lhe dado as costas, a violência foi justificada e, sobretudo, necessária. Você não foi longe demais."

# game/scripts/c19/c19.rpy:4630
translate brazilian c19s008_LeeroyJenkins_647239d8:

    # eva "Yo seguramente hubiese dejado su cara hecha pulpa al segundo insulto. Me habría costado contenerme."
    eva "Com certeza eu teria esmagado a cara dele depois do segundo insulto. Teria sido difícil me conter."

# game/scripts/c19/c19.rpy:4631
translate brazilian c19s008_LeeroyJenkins_b0c58024:

    # eva "Y me ha costado no fallar cuando he disparado a la llave. Esa cabeza era un blanco tentador."
    eva "E era difícil não errar quando atirei na chave. Aquela cabeça era um alvo tentador."

# game/scripts/c19/c19.rpy:4632
translate brazilian c19s008_LeeroyJenkins_05535524:

    # mc "*Risa* Ya has dicho antes que un asesinato podía fastidiar la fiesta. Limpiar sangre y esas cosas..."
    mc "*Risos* Você já disse que um assassinato poderia arruinar a festa. Limpar sangue e tudo mais..."

# game/scripts/c19/c19.rpy:4635
translate brazilian c19s008_LeeroyJenkins_f815701b:

    # ama "Solo tengo una pregunta, [mc]."
    ama "Eu só tenho uma pergunta, [mc]."

# game/scripts/c19/c19.rpy:4636
translate brazilian c19s008_LeeroyJenkins_1afe9f90:

    # mc "Dime."
    mc "Diga-me."

# game/scripts/c19/c19.rpy:4638
translate brazilian c19s008_LeeroyJenkins_182b7480:

    # ama "¿Vamos a tener que ponernos en plan damisela en apuros nosotras también para conseguir un beso como ese?"
    ama "Será que também vamos ter que bancar a donzela em perigo para ganhar um beijo desses?"

# game/scripts/c19/c19.rpy:4641
translate brazilian c19s008_LeeroyJenkins_b547db77:

    # ama "¿Sabes que por un momento he pensado que Kiara iba besarte?"
    ama "Você sabia que por um instante eu achei que a Kiara ia te beijar?"

# game/scripts/c19/c19.rpy:4642
translate brazilian c19s008_LeeroyJenkins_76361516:

    # ama "He pensado que el modo damisela en apuros iba a forzarte a aceptarla."
    ama "Pensei que o modo donzela em perigo te obrigaria a aceitar isso."

# game/scripts/c19/c19.rpy:4644
translate brazilian c19s008_LeeroyJenkins_196b4397:

    # ama "Y después he pensado en qué pasaría si nosotras también estuviéramos en esa situación."
    ama "E então pensei no que aconteceria se nós também estivéssemos nessa situação."

# game/scripts/c19/c19.rpy:4645
translate brazilian c19s008_LeeroyJenkins_43256da6:

    # mc "*Risa* No os pegaría el papel de damisela en apuros, Amanda. O al menos no como lo estaba Kiara."
    mc "*Risos* Eu não combinaria com você como donzela em perigo, Amanda. Ou pelo menos não como a Kiara."

# game/scripts/c19/c19.rpy:4646
translate brazilian c19s008_LeeroyJenkins_4f2b1bc1:

    # mc "Aún no sé si quiero tener una relación con vosotras y no lo voy a saber hasta que no resolváis lo que hablamos anoche."
    mc "Ainda não sei se quero ter um relacionamento com você e só saberei quando você resolver o que conversamos ontem à noite."

# game/scripts/c19/c19.rpy:4648
translate brazilian c19s008_LeeroyJenkins_8cb4e257:

    # eva "¿Qué? ¿Aún no lo sabes?"
    eva "O quê? Você ainda não sabe?"

# game/scripts/c19/c19.rpy:4649
translate brazilian c19s008_LeeroyJenkins_106e7b58:

    # mc "No, Eva. Hasta que no me digáis qué condiciones va a tener esa relación... o esas relaciones."
    mc "Não, Eva. Só depois que você me disser quais serão as condições desse relacionamento... ou desses relacionamentos."

# game/scripts/c19/c19.rpy:4651
translate brazilian c19s008_LeeroyJenkins_2bfff79d:

    # eva "¡Entonces no hay tiempo que perder, Amanda!"
    eva "Então não há tempo a perder, Amanda!"

# game/scripts/c19/c19.rpy:4653
translate brazilian c19s008_LeeroyJenkins_c4d99572:

    # eva "Nos vamos a algún lugar donde podamos hablar en privado."
    eva "Vamos para algum lugar onde possamos conversar em particular."

# game/scripts/c19/c19.rpy:4655
translate brazilian c19s008_LeeroyJenkins_20ce56a9:

    # "Eva y Amanda se van, dejándote solo."
    "Eva e Amanda vão embora, deixando você sozinho."

# game/scripts/c19/c19.rpy:4656
translate brazilian c19s008_LeeroyJenkins_b5e1b84a:

    # "El resto de las chicas están con Kiara."
    "As outras meninas estão com a Kiara."

# game/scripts/c19/c19.rpy:4658
translate brazilian c19s008_LeeroyJenkins_5dd83e48:

    # "Solomon no ha conseguido su objetivo de que Kiara se fuera con él."
    "Salomão não conseguiu atingir seu objetivo de convencer Kiara a ir com ele."

# game/scripts/c19/c19.rpy:4659
translate brazilian c19s008_LeeroyJenkins_4566a869:

    # "Pero su aparición ha matado el ambiente de la fiesta de cumpleaños."
    "Mas a presença dela acabou com o clima da festa de aniversário."

# game/scripts/c19/c19.rpy:4660
translate brazilian c19s008_LeeroyJenkins_8a72d8c4:

    # "El resto de la tarde gira alrededor de su visita. Todo el mundo quiere apoyar a Kiara."
    "O resto da tarde gira em torno da visita dela. Todos querem apoiar Kiara."

# game/scripts/c19/c19.rpy:4664
translate brazilian c19s008_LeeroyJenkins_e1f3e549:

    # "Que Kiara se haya unido a las revelaciones del día tan solo ayuda a ello."
    "A participação de Kiara nas revelações do dia só ajuda."

# game/scripts/c19/c19.rpy:4666
translate brazilian c19s008_LeeroyJenkins_82bc7200:

    # "Es la primera vez que alguien pide permiso para entrar en el harén, lo cual lo hace especial en cierto modo."
    "É a primeira vez que alguém pede permissão para entrar no harém, o que torna isso especial de certa forma."

# game/scripts/c19/c19.rpy:4668
translate brazilian c19s008_LeeroyJenkins_24af7778:

    # "Que haya mostrado el respeto suficiente hacia tu relación previa para pedir permiso, lo hace especial en cierto modo."
    "O fato de ele ter demonstrado respeito suficiente pelo seu relacionamento anterior a ponto de pedir permissão torna isso especial de certa forma."

# game/scripts/c19/c19.rpy:4670
translate brazilian c19s008_LeeroyJenkins_1fd645c8:

    # "Amanda no es la única que ha pensado que Kiara iba a besarte."
    "Amanda não foi a única que pensou que Kiara ia te beijar."

# game/scripts/c19/c19.rpy:4672
translate brazilian c19s008_LeeroyJenkins_05ab3366:

    # "Todas las chicas se acercan a ti en algún momento de la tarde, preocupadas por cómo te sientes tras lo que ha pasado."
    "Todas as garotas se aproximam de você em algum momento da tarde, preocupadas com como você se sente depois do que aconteceu."

# game/scripts/c19/c19.rpy:4673
translate brazilian c19s008_LeeroyJenkins_1820d88b:

    # "Todas ellas saben que la violencia no va contigo y que has actuado movido por la necesidad."
    "Todos sabem que a violência não combina com você e que você agiu por necessidade."

# game/scripts/c19/c19.rpy:4674
translate brazilian c19s008_LeeroyJenkins_a176d9c9:

    # "Ninguna sabe que has disfrutado cada bofetón, puñetazo, y patada."
    "Nenhum deles sabe que você gostou de cada tapa, soco e chute."

# game/scripts/c19/c19.rpy:4675
translate brazilian c19s008_LeeroyJenkins_d74e08bf:

    # "Lo ocultas haciendo bromas sobre la fiesta y los regalos. Evitas hablar de la visita de Solomon."
    "Você disfarça fazendo piadas sobre a festa e os presentes. Evita falar sobre a visita de Salomão."

# game/scripts/c19/c19.rpy:4677
translate brazilian c19s008_LeeroyJenkins_f0df114b:

    # "Amanda y Eva se pasan el resto de la tarde charlando, intentando resolver sus diferencias."
    "Amanda e Eva passam o resto da tarde conversando, tentando resolver suas diferenças."

# game/scripts/c19/c19.rpy:4679
translate brazilian c19s008_LeeroyJenkins_06942bef:

    # "Prefieres no acercarte demasiado. Aún no estás preparado para tomar una decisión."
    "Você prefere não se aproximar muito. Você ainda não está pronto para tomar uma decisão."

# game/scripts/c19/c19.rpy:4682
translate brazilian c19s008_LeeroyJenkins_5e5a1702:

    # "Cuando el sol deja de calentar, las chicas que viven en la ciudad empiezan a irse."
    "Quando o sol para de esquentar, as meninas que moram na cidade começam a ir embora."

# game/scripts/c19/c19.rpy:4683
translate brazilian c19s008_LeeroyJenkins_4cc0d06b:

    # "Excepto Maddie, que se queda para la partida de DnD."
    "Com exceção de Maddie, que fica para jogar RPG de mesa."

# game/scripts/c19/c19.rpy:4684
translate brazilian c19s008_LeeroyJenkins_c0080cf2:

    # "Todas rechazan la invitación a quedarse a cenar, para tristeza de Jamaal."
    "Todos recusaram o convite para ficar para o jantar, para grande tristeza de Jamaal."

# game/scripts/c19/c19.rpy:4685
translate brazilian c19s008_LeeroyJenkins_09b6671c:

    # "Jamaal se lleva sobras para cenar. Sobras con las que cenarían cuatro o cinco personas."
    "Jamaal leva as sobras para o jantar. Sobra o suficiente para quatro ou cinco pessoas."

# game/scripts/c19/c19.rpy:4687
translate brazilian c19s008_LeeroyJenkins_5792b57a:

    # "Las que viven en casa pasan por la ducha haciendo turnos o duchándose en grupo."
    "Quem mora em casa se reveza no banho ou toma banho em grupo."

# game/scripts/c19/c19.rpy:4688
translate brazilian c19s008_LeeroyJenkins_1458e440:

    # "Tú te duchas en el gimnasio. Nadie intenta pillarte desnudo mientras lo haces."
    "Você toma banho na academia. Ninguém tenta te pegar nu enquanto você faz isso."

# game/scripts/c19/c19.rpy:4690
translate brazilian c19s008_LeeroyJenkins_49031071:

    # "Una vez rechazadas las invitaciones a cenar, descubrís que nadie tiene hambre. Todos habéis comido demasiado."
    "Depois de recusar os convites para jantar, você descobre que ninguém está com fome. Todos comeram demais."

# game/scripts/c19/c19.rpy:4691
translate brazilian c19s008_LeeroyJenkins_9e204a7d:

    # "Un día entero en la piscina os ha dejado a todos agotados. La mayoría de las chicas se retiran pronto a sus habitaciones."
    "Um dia inteiro na piscina deixou vocês todas exaustas. A maioria das meninas vai voltar cedo para os quartos."

# game/scripts/c19/c19.rpy:4692
translate brazilian c19s008_LeeroyJenkins_fb9e1b73:

    # "[emm] se queja de que una partida de DnD sin pizza va a ser rara. Alguien comenta que le apetecía pizza con kiwi."
    "[emm] reclama que um jogo de D&D sem pizza vai ser estranho. Outra pessoa comenta que gostaria de pizza com kiwi."

# game/scripts/c19/c19.rpy:4693
translate brazilian c19s008_LeeroyJenkins_af00b4fc:

    # "Es un alivio que todos hayáis comido demasiado y no tengáis que pedir ese crimen contra la humanidad. Si la piña tiene mala fama en la pizza, el kiwi tiene que ser el peor invento de la historia."
    "Que alívio saber que vocês já comeram demais e não precisam pedir esse crime contra a humanidade. Se o abacaxi tem má fama na pizza, o kiwi deve ser a pior invenção da história."

# game/scripts/c19/c19.rpy:4697
translate brazilian c19s009_Teaser_df652625:

    # "Te preparas para tu primera partida de DnD. No tienes ni idea de lo que esperar pese a que [dap] y Scarlett te lo han explicado cien veces los últimos días."
    "Você está se preparando para sua primeira partida de D&D. Você não tem ideia do que esperar, mesmo que [dap] e Scarlett tenham explicado tudo para você cem vezes nos últimos dias."

# game/scripts/c19/c19.rpy:4700
translate brazilian c19s009_Teaser_1ec36538:

    # "Cuando llegas a la cocina, solo están [dap] y Scarlett. [dap] tiene un montón de cosas extrañas encima de la mesa."
    "Ao chegar à cozinha, apenas [dap] e Scarlett estão lá. [dap] tem muitas coisas estranhas sobre a mesa."

# game/scripts/c19/c19.rpy:4701
translate brazilian c19s009_Teaser_0377f5a7:

    # "Deben ser los famosos dados para jugar a rol."
    "Devem ser os famosos dados de RPG."

# game/scripts/c19/c19.rpy:4702
translate brazilian c19s009_Teaser_07138114:

    # dap "¡Qué puntual! Siéntate a ese lado, en la segunda silla. La primera es de Scarlett."
    dap "Que pontualidade! Sente-se ali, na segunda cadeira. A primeira é da Scarlett."

# game/scripts/c19/c19.rpy:4704
translate brazilian c19s009_Teaser_156bd6b7:

    # sca "Necesito estar al lado de [dap] para mover las figuras. Ella no llega."
    sca "Preciso estar perto de [dap] para mover as figuras. Ela não consegue alcançar."

# game/scripts/c19/c19.rpy:4705
translate brazilian c19s009_Teaser_43d47f54:

    # mc "Ningún problema. Así también me ayudas a mí. Soy el único novato."
    mc "Sem problema. Isso também me ajuda. Sou o único novato."

# game/scripts/c19/c19.rpy:4707
translate brazilian c19s009_Teaser_5643f7fe:

    # dap "¿Preparado para la mayor aventura de tu vida?"
    dap "Preparado para a maior aventura da sua vida?"

# game/scripts/c19/c19.rpy:4708
translate brazilian c19s009_Teaser_306193d8:

    # sca "No te asustes, es posible que no sea tanto como esperas."
    sca "Não entre em pânico, pode não ser tão ruim quanto você imagina."

# game/scripts/c19/c19.rpy:4709
translate brazilian c19s009_Teaser_6e42abed:

    # dap "Tendrás que esperar un poco. Tienen que llegar el resto de las chicas."
    dap "Você terá que esperar um pouco. As outras meninas precisam chegar."

# game/scripts/c19/c19.rpy:4710
translate brazilian c19s009_Teaser_91f128d3:

    # sca "Suelen ser más puntuales, pero [eri] se está cambiando con Maddie. Empezaremos en poco tiempo."
    sca "Eles costumam ser mais pontuais, mas isso está mudando com a Maddie. Começaremos em breve."

