    # mcp "(Podría hacer algún comentario sobre que no solo tienen unas tetas increíbles sino unos culos preciosos, pero podría incomodarlas.)"
    mcp "(Eu poderia comentar que elas não só têm seios incríveis, como também bundas maravilhosas, mas isso poderia deixá-las desconfortáveis.)"

# game/scripts/c19/c19.rpy:340
translate brazilian c19s001_Samantha_8b8ffcde:

    # mcp "(Y se fueron. Hora de ponerme el bañador.)"
    mcp "(E eles foram embora. Hora de colocar meu maiô.)"

# game/scripts/c19/c19.rpy:345
translate brazilian c19s001_SamConvSecret_3d15dead:

    # sam "Sobre eso... sobre la familia... ¿Cómo te sientes sabiendo que [mar] no es tu madre y que las chicas no son tu hermana y tus primas?"
    sam "Sobre isso... sobre família... Como você se sente sabendo que [mar] não é sua mãe e que as meninas não são sua irmã e primas?"

# game/scripts/c19/c19.rpy:347
translate brazilian c19s001_SamConvSecret_e62c54e4:

    # sam "Precisamente sobre eso... sobre la familia... ¿Cómo te sientes sabiendo que [mar] no es tu madre y que las chicas no son tu hermana y tus primas?"
    sam "Falando nisso... sobre família... Como você se sente sabendo que [mar] não é sua mãe e que as meninas não são sua irmã e primas?"

# game/scripts/c19/c19.rpy:348
translate brazilian c19s001_SamConvSecret_c7598f5c:

    # sam "Cuando [mar] me lo contó... por un momento me enfadé. No había confiado en mí para algo así."
    sam "Quando [mar] me contou... por um momento fiquei com raiva. Ele não havia confiado em mim para algo assim."

# game/scripts/c19/c19.rpy:349
translate brazilian c19s001_SamConvSecret_6064bacf:

    # sam "Por otro lado lo entendí. Es algo demasiado grande para contarlo por ahí."
    sam "Por outro lado, eu entendi. É um assunto muito complexo para ser discutido em qualquer lugar."

# game/scripts/c19/c19.rpy:350
translate brazilian c19s001_SamConvSecret_d72cb6c8:

    # mc "Sam, yo siempre lo he sabido. La noticia ha sido una sorpresa para las chicas, pero no para mí."
    mc "Sam, eu sempre soube. A notícia foi uma surpresa para as meninas, mas não para mim."

# game/scripts/c19/c19.rpy:355
translate brazilian c19s001_SamConvSecret_1eac7179:

    # sam "¿Y siempre guardaste el secreto? ¡Lo debes saber desde muy niño!"
    sam "E você sempre guardou o segredo? Você devia saber disso desde muito jovem!"

# game/scripts/c19/c19.rpy:356
translate brazilian c19s001_SamConvSecret_a3480968:

    # mc "Me inculcaron que era algo de lo que no debía hablar ni fuera ni dentro de casa si un adulto no sacaba el tema. No ha sido difícil no hablar de ello."
    mc "Fui ensinada que era algo sobre o qual eu não deveria falar, nem em casa nem na rua, a menos que um adulto tocasse no assunto. Não tem sido difícil evitar falar sobre isso."

# game/scripts/c19/c19.rpy:357
translate brazilian c19s001_SamConvSecret_428ee4bc:

    # mc "No es un tema de conversación que salga habitualmente con otros niños. \"Tengo una hermana pero es un clon de alguien\". Nunca me he sentido tentado de hacerlo."
    mc "Não é um assunto que surge com frequência nas conversas com outras crianças. \"Eu tenho uma irmã, mas ela é a cara de alguém.\" Nunca tive vontade de fazer isso."

# game/scripts/c19/c19.rpy:358
translate brazilian c19s001_SamConvSecret_e58ec852:

    # mc "Además, no es que lo supiera todo con cinco años. Quizás tuve toda la información a los once. O al menos toda la que tenía hasta hace unos días."
    mc "Além disso, não é como se eu soubesse tudo aos cinco anos de idade. Talvez eu tivesse todas as informações aos onze. Ou pelo menos todas as informações que eu tinha até alguns dias atrás."

# game/scripts/c19/c19.rpy:363
translate brazilian c19s001_SamConvSecret_18851e4a:

    # sam "Ha tenido que ser muy duro para todos vosotros. Tanto guardar el secreto, como para las chicas descubrirlo ahora."
    sam "Deve ter sido muito difícil para todos vocês. Tanto guardar o segredo quanto para as meninas descobrirem agora."

# game/scripts/c19/c19.rpy:364
translate brazilian c19s001_SamConvSecret_b49800e8:

    # mc "Hubo de todo un poco, pero se lo tomaron mejor de lo que esperaba. Quizás excepto [emm], que estuvo enfadada unas horas. Aunque también menos de las que esperaba."
    mc "Havia um pouco de tudo, mas eles reagiram melhor do que eu esperava. Talvez com exceção de [emm], que ficou irritado por algumas horas. Embora mesmo isso tenha sido menos do que eu esperava."

# game/scripts/c19/c19.rpy:365
translate brazilian c19s001_SamConvSecret_2b8b9014:

    # mc "No te preocupes por nosotros. Todos estamos bien."
    mc "Não se preocupem conosco. Estamos todos bem."

# game/scripts/c19/c19.rpy:372
translate brazilian c19s001_SamConvAmEv_fe8f1641:

    # sam "¿Qué me puedes contar de Amanda y Eva? Me han dicho que son... especiales."
    sam "O que você pode me dizer sobre Amanda e Eva? Ouvi dizer que elas são... especiais."

# game/scripts/c19/c19.rpy:373
translate brazilian c19s001_SamConvAmEv_c4691a03:

    # mc "Lo son. Os habéis perdido algunas cosas muy emotivas estos últimos días. Te van a encantar."
    mc "São sim. Você perdeu momentos muito emocionantes nestes últimos dias. Você vai adorá-los."

# game/scripts/c19/c19.rpy:374
translate brazilian c19s001_SamConvAmEv_71dc63be:

    # mc "Pero prefiero no explicarte muchas cosas. Quiero que te formes tu propia opinión cuando las conozcas."
    mc "Mas prefiro não explicar muito. Quero que você forme sua própria opinião quando souber dos fatos."

# game/scripts/c19/c19.rpy:379
translate brazilian c19s001_SamConvAmEv_2b8191fb:

    # sam "No puedo ser imparcial. He estado hablando con [mar] antes. Se le iluminaban los ojos hablando de ellas."
    sam "Não consigo ser imparcial. Já conversei com [mar] antes. Os olhos dela brilharam quando ela falou sobre eles."

# game/scripts/c19/c19.rpy:380
translate brazilian c19s001_SamConvAmEv_2d74b3d2:

    # sam "Especialmente de Amanda. Es la que es igual que [emm], ¿no?"
    sam "Principalmente Amanda. Ela é igual à [emm], certo?"

# game/scripts/c19/c19.rpy:381
translate brazilian c19s001_SamConvAmEv_8f69c2cd:

    # mc "Sí. Pero son muy diferentes. Y también Amanda y Eva son diferentes entre ellas."
    mc "Sim. Mas elas são muito diferentes. E Amanda e Eva também são diferentes uma da outra."

# game/scripts/c19/c19.rpy:382
translate brazilian c19s001_SamConvAmEv_4935486c:

    # sam "No podía parar de sonreír. Si alguien es capaz de poner así de contenta a tu madre... ya se ha ganado mi cariño."
    sam "Eu não conseguia parar de sorrir. Se alguém consegue fazer sua mãe tão feliz assim... já ganhou meu coração."

# game/scripts/c19/c19.rpy:383
translate brazilian c19s001_SamConvAmEv_25d8c5cf:

    # mc "Ya te digo que son especiales. Todo el mundo en la familia las adora."
    mc "Eu te digo, eles são especiais. Todo mundo na família os adora."

# game/scripts/c19/c19.rpy:388
translate brazilian c19s001_MarthaKim_2c696c32:

    # "Después de cambiarte pasas por la cocina..."
    "Depois de se trocar, você atravessa a cozinha..."

# game/scripts/c19/c19.rpy:389
translate brazilian c19s001_MarthaKim_1975db8f:

    # kim "No estaba segura de qué hacer. Es... raro..."
    kim "Eu não tinha certeza do que fazer. É... estranho..."

# game/scripts/c19/c19.rpy:390
translate brazilian c19s001_MarthaKim_ab30d862:

    # kim "No creía que tú lo fueras a hacer. Ha sido una sorpresa."
    kim "Eu não pensei que você faria isso. Foi uma surpresa."

# game/scripts/c19/c19.rpy:391
translate brazilian c19s001_MarthaKim_c2ce47e2:

    # mom "Lo autoricé porque lo pidió [eri]. Sabía que [nor] también lo iba a hacer, con lo que no me parecía bien dejarlas solas."
    mom "Eu autorizei porque [eri] pediu. Eu sabia que [nor] também ia fazer isso, então não achei certo deixá-los sozinhos."

# game/scripts/c19/c19.rpy:392
translate brazilian c19s001_MarthaKim_9ea9d7d7:

    # mc "¿Estáis hablando del topless?"
    mc "Você está falando de topless?"

# game/scripts/c19/c19.rpy:394
translate brazilian c19s001_MarthaKim_9d2e5159:

    # mom "Sí. De momento me ha sorprendido un poco quién se ha apuntado."
    mom "Sim. Estou um pouco surpreso com quem se inscreveu."

# game/scripts/c19/c19.rpy:395
translate brazilian c19s001_MarthaKim_0618c67d:

    # kim "Y quién no se ha apuntado..."
    kim "E quem ainda não se inscreveu...?"

# game/scripts/c19/c19.rpy:397
translate brazilian c19s001_MarthaKim_1e43dc19:

    # mom "No, cariño. Cada una de vosotras sois libres para decidir por vosotras mismas. Era una posibilidad y no una obligación."
    mom "Não, querida. Cada um de vocês é livre para decidir por si mesmo. Era uma possibilidade, não uma obrigação."

# game/scripts/c19/c19.rpy:398
translate brazilian c19s001_MarthaKim_de2b4947:

    # mom "Igual que nadie te va a obligar a desnudarte en el jacuzzi o la sauna de [nor]."
    mom "Assim como ninguém vai te obrigar a ficar nu na jacuzzi ou sauna de [nor]."

# game/scripts/c19/c19.rpy:399
translate brazilian c19s001_MarthaKim_ee939c4f:

    # mc "En eso tiene razón, Kim. Tienes permiso para hacerlo, pero no tienes por qué hacerlo si no quieres."
    mc "Você tem razão, Kim. Você tem permissão para fazer isso, mas não precisa se não quiser."

# game/scripts/c19/c19.rpy:400
translate brazilian c19s001_MarthaKim_b70b3927:

    # kim "Pero si soy la única..."
    kim "Mas se eu for o único..."

# game/scripts/c19/c19.rpy:402
translate brazilian c19s001_MarthaKim_9be33c8e:

    # mom "No eres la única. Las hay que llevan un bañador de cuerpo entero. Y hay más chicas que se han decidido por un bikini igual que tú."
    mom "Você não está sozinha. Algumas usam maiô de uma peça. E há muitas outras garotas que optaram pelo biquíni, assim como você."

# game/scripts/c19/c19.rpy:404
translate brazilian c19s001_MarthaKim_463a85dd:

    # mom "Mi madre y mi tía también llevan bikinis. Al resto aún no las he visto, pero seguro que hay más."
    mom "Minha mãe e minha tia também estão de biquíni. Ainda não vi as outras, mas tenho certeza de que há mais."

# game/scripts/c19/c19.rpy:406
translate brazilian c19s001_MarthaKim_761fdd8d:

    # mom "Olivia y Betty también llevan bikinis. Al resto aún no las he visto, pero seguro que hay más."
    mom "Olivia e Betty também estão usando biquínis. Ainda não vi as outras, mas tenho certeza de que há mais."

# game/scripts/c19/c19.rpy:407
translate brazilian c19s001_MarthaKim_bca264aa:

    # mc "¡Ohhh! ¿Tía Betty no va a hacer topless? *Risa* ¡Qué decepción! Nunca me lo hubiera imaginado."
    mc "Ohhh! A tia Betty não vai ficar de topless? *Risos* Que decepção! Eu jamais imaginaria isso."

# game/scripts/c19/c19.rpy:409
translate brazilian c19s001_MarthaKim_99f8e0ea:

    # mom "[mc], esto es serio. Kim se siente insegura y cohibida con Jamaal y contigo aquí. Estoy segura de que si no estuvierais no tendría dudas."
    mom "[mc], isto é sério. A Kim sente-se insegura e constrangida com o Jamaal e você aqui. Tenho a certeza de que se você não estivesse aqui, ela não teria dúvidas."

# game/scripts/c19/c19.rpy:410
translate brazilian c19s001_MarthaKim_317656c2:

    # mc "¿Habéis visto a Jamaal?"
    mc "Você já viu Jamaal?"

# game/scripts/c19/c19.rpy:412
translate brazilian c19s001_MarthaKim_3d9b8d5a:

    # mom "No. Aún no he bajado a la piscina desde que han llegado."
    mom "Não. Ainda não fui à piscina desde que eles chegaram."

# game/scripts/c19/c19.rpy:413
translate brazilian c19s001_MarthaKim_ac38f7fe:

    # mc "¿Y él no ha subido a saludarte a la cocina? *Risa* ¡Qué maleducado!"
    mc "E ele não veio até a cozinha para dizer olá? *Risos* Que falta de educação!"

# game/scripts/c19/c19.rpy:414
translate brazilian c19s001_MarthaKim_dd1da067:

    # kim "¡[mc]! ¡Eso es cruel y no es digno de ti!"
    kim "[mc]! Isso é cruel e indigno de você!"

# game/scripts/c19/c19.rpy:416
translate brazilian c19s001_MarthaKim_384a6bc5:

    # mom "No te preocupes. No lo dice con maldad y siempre están buscando excusas para meterse el uno con el otro."
    mom "Não se preocupe. Ele não faz por mal, e eles sempre procuram desculpas para provocar um ao outro."

# game/scripts/c19/c19.rpy:417
translate brazilian c19s001_MarthaKim_3ba4fbb1:

    # mom "Y, aunque deberían, no ponen ningún límite a lo que es correcto y lo que no."
    mom "E, embora devessem, não estabelecem limites para o que é certo e o que é errado."

# game/scripts/c19/c19.rpy:418
translate brazilian c19s001_MarthaKim_8a7e7d8f:

    # mc "Si lo pusiéramos dejaría de ser divertido. O tan divertido al menos."
    mc "Se adicionássemos isso, não seria mais divertido. Ou pelo menos não tão divertido."

# game/scripts/c19/c19.rpy:420
translate brazilian c19s001_MarthaKim_93786d3a:

    # kim "Ah, OK. Nunca he entendido ese tipo de humor..."
    kim "Ah, entendi. Nunca compreendi esse tipo de humor..."

# game/scripts/c19/c19.rpy:421
translate brazilian c19s001_MarthaKim_991ec918:

    # mc "Es fácil de entender. En el instituto éramos los perdedores. La gente se metía conmigo por gordo y con Jamaal por su velocidad y su movilidad."
    mc "É fácil de entender. No ensino médio, éramos os perdedores. As pessoas me zoavam por ser gordo e zoavam o Jamaal por sua velocidade e agilidade."

# game/scripts/c19/c19.rpy:422
translate brazilian c19s001_MarthaKim_6795a5ee:

    # mc "Si nosotros nos decíamos en broma lo que otras personas podían decirnos en serio, no tenía sentido que nos lo dijeran porque sabían que no nos iban a hacer daño."
    mc "Se estivéssemos dizendo em tom de brincadeira coisas que outras pessoas poderiam nos dizer a sério, não haveria motivo para que elas as dissessem para nós, porque saberiam que não nos magoariam."

# game/scripts/c19/c19.rpy:423
translate brazilian c19s001_MarthaKim_6a9ba4ba:

    # mc "Es el tipo de humor que utiliza Kate también."
    mc "É o tipo de humor que Kate também usa."

# game/scripts/c19/c19.rpy:424
translate brazilian c19s001_MarthaKim_9d7f7965:

    # kim "Pese a todo sigo sin entenderlo. Yo no podría bromear con mis defectos..."
    kim "Apesar de tudo, ainda não entendo. Eu não conseguiria fazer piada com meus defeitos..."

# game/scripts/c19/c19.rpy:426
translate brazilian c19s001_MarthaKim_d8d5af8d:

    # kim "Pero volviendo a Jamaal, nos han presentado antes. Iba con camiseta y bermudas. ¿Por qué preguntas si lo hemos visto?"
    kim "Mas voltando a Jamaal, que já nos foi apresentado, ele estava usando camiseta e bermuda. Por que você está perguntando se já o vimos?"

# game/scripts/c19/c19.rpy:427
translate brazilian c19s001_MarthaKim_9b39bbc6:

    # mc "Cuando puedas, baja a la piscina y mira cómo va ahora. Se te quitará cualquier tipo de complejo sobre cómo debes vestirte o qué debes ponerte."
    mc "Quando puder, vá até a piscina e veja como está agora. Isso vai eliminar qualquer insegurança que você possa ter sobre como se vestir ou o que usar."

# game/scripts/c19/c19.rpy:429
translate brazilian c19s001_MarthaKim_ed6bdda9:

    # mom "Y sobre [mc], creo que no debería importarte que esté aquí. No lo eduqué para que se quede mirando a una mujer mientras babea porque haga topless."
    mom "E quanto ao [mc], não acho que deva importar para você que ele esteja aqui. Eu não o criei para ficar olhando para uma mulher enquanto ela baba porque está de topless."

# game/scripts/c19/c19.rpy:430
translate brazilian c19s001_MarthaKim_10d47669:

    # mom "Ni siquiera a una tan bonita como tú."
    mom "Nem mesmo uma tão linda quanto você."

# game/scripts/c19/c19.rpy:431
translate brazilian c19s001_MarthaKim_4aa02246:

    # mc "Pero una mirada de reojo sí que puedo echar de vez en cuando. *Risa*"
    mc "Mas posso dar uma olhadinha de vez em quando. *Risos*"

# game/scripts/c19/c19.rpy:433
translate brazilian c19s001_MarthaKim_6b0243b7:

    # mom "¡[mc]!" (multiple=2)
    mom "[mc]!" (multiple=2)

# game/scripts/c19/c19.rpy:434
translate brazilian c19s001_MarthaKim_f0d34027:

    # kim "¿Ves?" (multiple=2)
    kim "Ver?" (multiple=2)

# game/scripts/c19/c19.rpy:435
translate brazilian c19s001_MarthaKim_45f7dfbd:

    # mc "Sólo estaba bromeando. Si te sirve de algo, prometo no mirar ni una sola vez en tu dirección."
    mc "Eu estava só brincando. Se isso te consola, prometo não olhar na sua direção nem uma vez sequer."

# game/scripts/c19/c19.rpy:436
translate brazilian c19s001_MarthaKim_8ac18f63:

    # mc "Independientemente de lo que hagas con el top de tu bikini."
    mc "Independentemente do que você faça com a parte de cima do seu biquíni."

# game/scripts/c19/c19.rpy:438
translate brazilian c19s001_MarthaKim_287e05fd:

    # kim "Cambiando de tema... ¿Cuándo vais a dar los regalos a las chicas?"
    kim "Mudando de assunto... Quando você vai entregar os presentes para as meninas?"

# game/scripts/c19/c19.rpy:439
translate brazilian c19s001_MarthaKim_5b5edb8e:

    # mc "Después de comer. ¿Por qué?"
    mc "Depois de comer. Por quê?"

# game/scripts/c19/c19.rpy:440
translate brazilian c19s001_MarthaKim_6118e1c8:

    # kim "En mi familia de Cleveland lo hacemos como en Navidad, nada más levantarnos."
    kim "Na minha família em Cleveland, fazemos isso como no Natal, assim que acordamos."

# game/scripts/c19/c19.rpy:441
translate brazilian c19s001_MarthaKim_51ca3b9e:

    # kim "Pero tiene lógica hacerlo así, viniendo gente de fuera de la casa."
    kim "Mas faz sentido fazer dessa forma, já que as pessoas estão vindo de fora da casa."

# game/scripts/c19/c19.rpy:443
translate brazilian c19s001_MarthaKim_09d4be70:

    # mom "Hasta este año sólo habían venido Samantha, Simone, y Jamaal."
    mom "Até este ano, apenas Samantha, Simone e Jamaal tinham vindo."

# game/scripts/c19/c19.rpy:444
translate brazilian c19s001_MarthaKim_87a9e775:

    # mc "Y Eileen cuando salíamos juntos en el instituto."
    mc "E a Eileen, quando a gente saía junto no ensino médio."

# game/scripts/c19/c19.rpy:445
translate brazilian c19s001_MarthaKim_6f9a7e6e:

    # mom "Y Scarlett los últimos seis o siete años. Lo máximo que estuvimos fue... el año antes de que [mc] se marchara. Fuimos catorce."
    mom "E Scarlett nos últimos seis ou sete anos. O período mais longo que ficamos juntos foi... o ano anterior à partida de [mc]. Éramos quatorze."

# game/scripts/c19/c19.rpy:447
translate brazilian c19s001_MarthaKim_72685ce7:

    # kim "Este año somos 24. Lo he contado..."
    kim "Este ano somos 24. Eu contei..."

# game/scripts/c19/c19.rpy:448
translate brazilian c19s001_MarthaKim_ad22e22e:

    # mc "Va a ser la celebración más grande en la historia de esta casa. No creo que lo superemos."
    mc "Esta será a maior celebração da história desta casa. Acho que nunca conseguiremos superar isso."

# game/scripts/c19/c19.rpy:450
translate brazilian c19s001_MarthaKim_75812567:

    # kim "Mmmm... ¿Cuándo es el próximo cumpleaños?"
    kim "Hum... Quando é o próximo aniversário?"

# game/scripts/c19/c19.rpy:451
translate brazilian c19s001_MarthaKim_9a4de637:

    # mc "Scarlett, Simone, y Debbie en octubre. Después de ellas vas tú, en noviembre."
    mc "Scarlett, Simone e Debbie em outubro. Depois delas, é a sua vez, em novembro."

# game/scripts/c19/c19.rpy:453
translate brazilian c19s001_MarthaKim_4e0da2a2:

    # kim "¿Te sabes el cumpleaños de todo el mundo?"
    kim "Você sabe o aniversário de todos?"

# game/scripts/c19/c19.rpy:454
translate brazilian c19s001_MarthaKim_50ae5637:

    # mc "Sí... Es lógico, ¿no? Pero ¿por qué lo preguntabas?"
    mc "Sim... Faz sentido, não é? Mas por que você perguntou?"

# game/scripts/c19/c19.rpy:456
translate brazilian c19s001_MarthaKim_75f8689d:

    # kim "Para los próximos cumpleaños ya estarán aquí las seis chicas que van a vivir en casa de [nor]."
    kim "Nos próximos aniversários, as seis meninas que vão morar na casa de [nor] já estarão aqui."

# game/scripts/c19/c19.rpy:457
translate brazilian c19s001_MarthaKim_bf8d9ef0:

    # kim "Si se quieren integrar en la familia... ¡Podríamos llegar a ser 30!"
    kim "Se você quiser se juntar à família... podemos chegar a 30 pessoas!"

# game/scripts/c19/c19.rpy:458
translate brazilian c19s001_MarthaKim_de053f9d:

    # mc "Pero no estarán Meemaw y Betty; están ocupando sus habitaciones y tenían planes para volver a Florida. Tampoco vivirán con nosotros Kiara y Eileen, están ocupando otra."
    mc "Mas a vovó e a Betty não estarão aqui; elas estão em seus próprios quartos e planejavam voltar para a Flórida. A Kiara e a Eileen também não ficarão conosco; elas estão em outro quarto."

# game/scripts/c19/c19.rpy:459
translate brazilian c19s001_MarthaKim_785b8661:

    # mc "Y yo seguramente estaré en Aruba todavía, con Eva o Amanda, o las dos."
    mc "E provavelmente ainda estarei em Aruba, com Eva ou Amanda, ou ambas."

# game/scripts/c19/c19.rpy:461
translate brazilian c19s001_MarthaKim_dd4949b4:

    # kim "No me había dado cuenta... La familia se separará tarde o temprano... pero es demasiado pronto."
    kim "Eu não tinha me dado conta... A família vai se separar mais cedo ou mais tarde... mas é cedo demais."

# game/scripts/c19/c19.rpy:462
translate brazilian c19s001_MarthaKim_0fecad0a:

    # mc "Y eso no es lo peor. Lisa y Kate acaban sus carreras en un par de años..."
    mc "E isso não é o pior. Lisa e Kate vão terminar seus cursos daqui a alguns anos..."

# game/scripts/c19/c19.rpy:464
translate brazilian c19s001_MarthaKim_3d0e1a6d:

    # mom "No adelantemos acontecimientos aún. Queda muchísimo para eso."
    mom "Não vamos nos precipitar. Ainda há um longo caminho a percorrer."

# game/scripts/c19/c19.rpy:465
translate brazilian c19s001_MarthaKim_c2b16046:

    # mc "Sí, sólo hace una semana que han llegado y ya estamos pensando lo que las echaremos de menos dentro de uno o dos años."
    mc "Sim, eles estão aqui há apenas uma semana e já estamos pensando em quanta falta sentiremos deles daqui a um ou dois anos."

# game/scripts/c19/c19.rpy:467
translate brazilian c19s001_MarthaKim_526bb2f8:

    # kim "Dame algo para bajar antes de que me pongáis triste solo de pensarlo. *Risa*"
    kim "Me dê algo para me acalmar antes que eu fique triste só de pensar nisso. *Risos*"

# game/scripts/c19/c19.rpy:468
translate brazilian c19s001_MarthaKim_7608029f:

    # mom "Coge ese pastel de ahí si quieres. [mc] bajará el resto mientras yo acabo de preparar unas cosas."
    mom "Pode levar esse bolo se quiser. O resto vem depois, enquanto termino de preparar algumas coisas."

# game/scripts/c19/c19.rpy:469
translate brazilian c19s001_MarthaKim_4c864ff7:

    # mc "Y después tengo que ir a la cocina de [nor]. Le he prometido que la ayudaría."
    mc "E depois tenho que ir à cozinha da [nor]. Prometi a ela que ajudaria."

# game/scripts/c19/c19.rpy:471
translate brazilian c19s001_MarthaKim_5c9a7435:

    # "Kim se dirige a la puerta y se para justo antes de abrirla."
    "Kim dirige-se à porta e para mesmo antes de a abrir."

# game/scripts/c19/c19.rpy:472
translate brazilian c19s001_MarthaKim_d051963f:

    # kim "Pero..."
    kim "Mas..."

# game/scripts/c19/c19.rpy:473
translate brazilian c19s001_MarthaKim_e5a94576:

    # mc "¿Qué pasa, Kim?"
    mc "O que houve, Kim?"

# game/scripts/c19/c19.rpy:475
translate brazilian c19s001_MarthaKim_642ce33f:

    # kim "Aunque hayamos acabado nuestras carreras... ¿podremos venir a visitaros?"
    kim "Mesmo tendo concluído nossos estudos... ainda poderemos visitá-los?"

# game/scripts/c19/c19.rpy:477
translate brazilian c19s001_MarthaKim_c9d37ae4:

    # mom "Claro que sí, cielo. Siempre seréis bienvenidas en casa."
    mom "Claro, querida. Você sempre será bem-vinda em casa."

# game/scripts/c19/c19.rpy:478
translate brazilian c19s001_MarthaKim_48c1e7e2:

    # mc "Y si tenemos las habitaciones ocupadas, ya apañaremos algo. Yo ya sé lo que es dormir en el sofá."
    mc "E se nossos quartos estiverem ocupados, a gente dá um jeito. Eu já sei como é dormir no sofá."

# game/scripts/c19/c19.rpy:479
translate brazilian c19s001_MarthaKim_8b6aea9e:

    # mom "Y Newport ha crecido mucho en los últimos años. ¿Quién sabe si alguna de vosotras encuentra un trabajo aquí y decide quedarse?"
    mom "E Newport cresceu muito nos últimos anos. Quem sabe, talvez um de vocês encontre um emprego aqui e decida ficar?"

# game/scripts/c19/c19.rpy:482
translate brazilian c19s001_MarthaKim_d498802f:

    # "Kim planta un sorprendente beso en tus labios tras entregarte la tarta."
    "Kim te dá um beijo surpresa nos lábios depois de te entregar o bolo."

# game/scripts/c19/c19.rpy:484
translate brazilian c19s001_MarthaKim_02aaaf64:

    # "Y rodea la península de la cocina hasta abrazar a [mar]."
    "E circunda a península da cozinha até abraçar [mar]."

# game/scripts/c19/c19.rpy:485
translate brazilian c19s001_MarthaKim_61174454:

    # kim "¡Gracias, [mar]!"
    kim "Obrigado, [mar]!"

# game/scripts/c19/c19.rpy:486
translate brazilian c19s001_MarthaKim_63641cc2:

    # mom "No pasa nada, cielo."
    mom "Está tudo bem, querida."

# game/scripts/c19/c19.rpy:487
translate brazilian c19s001_MarthaKim_698f2269:

    # kim "*Susurrando* No se lo digas a nadie, pero... ¡Qué vergüenza! He estado a punto de decir \"Gracias, Mamá\". *Risita* Creo que paso demasiado tiempo con [emm] y [mc]."
    kim "*Sussurrando* Não conte para ninguém, mas... Meu Deus! Eu ia dizer \"Obrigada, mãe\". *Risos* Acho que passo muito tempo com [emm] e [mc]."

# game/scripts/c19/c19.rpy:488
translate brazilian c19s001_MarthaKim_11a1c192:

    # mom "*Susurrando* Tampoco pasa nada por eso, cielo."
    mom "*Sussurrando* Não é nada demais, querida."

# game/scripts/c19/c19.rpy:489
translate brazilian c19s001_MarthaKim_7cf49b5f:

    # mc "¿Qué estáis susurrando? Me gustaría recordaros que estoy aquí. *Risa*"
    mc "O que você está sussurrando? Gostaria de lembrá-lo de que estou aqui. *Risos*"

# game/scripts/c19/c19.rpy:491
translate brazilian c19s001_MarthaKim_cf556a00:

    # kim "Cosas nuestras..."
    kim "Nossas coisas..."

# game/scripts/c19/c19.rpy:492
translate brazilian c19s001_MarthaKim_0789f5b0:

    # mom "Nada que sea de tu interés ahora mismo, cielo."
    mom "Nada que te interesse agora, querida."

# game/scripts/c19/c19.rpy:493
translate brazilian c19s001_MarthaKim_e7726718:

    # mom "¿Por qué no bajas la tarta? Voy a quedarme hablando con Kim un rato."
    mom "Por que você não larga o bolo? Vou ficar aqui conversando um pouco com a Kim."

# game/scripts/c19/c19.rpy:494
translate brazilian c19s001_MarthaKim_fbbedea1:

    # mc "Ningún problema. Os dejo solas."
    mc "Sem problema. Vou deixar vocês dois a sós."

# game/scripts/c19/c19.rpy:497
translate brazilian c19s001_MarthaKim_79a869c3:

    # "Bajas las bandejas que te ha indicado [mar] y vas a por más a la cocina de [nor]."
    "Pegue as bandejas que [mar] indicou e vá até a cozinha de [nor] para pegar mais."

# game/scripts/c19/c19.rpy:516
translate brazilian c19s002_Simone_9e3c374f:

    # "Cuando acabas de llevar todo lo que está preparado a la piscina, oyes las voces de Simone y [emm] en la sala y decides pasar a saludar."
    "Assim que você termina de levar tudo o que está pronto para a piscina, ouve as vozes de Simone e [emm] no quarto e decide ir cumprimentá-las."

# game/scripts/c19/c19.rpy:523
translate brazilian c19s002_Simone_0b7f4e77:

    # mc "Felicidades, [emm]."
    mc "Parabéns, [emm]."

# game/scripts/c19/c19.rpy:524
translate brazilian c19s002_Simone_969f2b94:

    # emm "Gracias, [mc]. Creo que va a ser el mejor cumpleaños de la historia."
    emm "Obrigado, [mc]. Acho que vai ser o melhor aniversário de todos."

# game/scripts/c19/c19.rpy:526
translate brazilian c19s002_Simone_36621a6b:

    # mc "Buenos días, Simone."
    mc "Bom dia, Simone."

# game/scripts/c19/c19.rpy:527
translate brazilian c19s002_Simone_f93886f9:

    # sim "Buenos días... "
    sim "Bom dia..."

# game/scripts/c19/c19.rpy:529
translate brazilian c19s002_Simone_0051c153:

    # sim "..."
    sim "..."

# game/scripts/c19/c19.rpy:530
translate brazilian c19s002_Simone_697b367a:

    # mc "¿Qué pasa, Simone?"
    mc "O que houve, Simone?"

# game/scripts/c19/c19.rpy:531
translate brazilian c19s002_Simone_6dd2dcb6:

    # emm "Oh... ¿nadie le ha explicado que ahora todas saludamos a [mc] así?"
    emm "Ah... ninguém explicou para ela que agora todos nós cumprimentamos [mc] assim?"

# game/scripts/c19/c19.rpy:533
translate brazilian c19s002_Simone_0b5cc1ec:

    # sim "¿Qué? ¿Por qué?"
    sim "O quê? Por quê?"

# game/scripts/c19/c19.rpy:534
translate brazilian c19s002_Simone_827454e2:

    # mc "Un invento de Tía Betty para sacar a Meemaw de sus casillas."
    mc "Uma invenção da tia Betty para enlouquecer a vovó."

# game/scripts/c19/c19.rpy:536
translate brazilian c19s002_Simone_2146c7e2:

    # emm "Yo no estaba, pero por lo que me ha contado mi madre, a mi abuela casi le explota la cabeza. *Risa*"
    emm "Eu não estava lá, mas pelo que minha mãe me contou, a cabeça da minha avó quase explodiu. *Risos*"

# game/scripts/c19/c19.rpy:537
translate brazilian c19s002_Simone_ff6d131d:

    # mc "Yo sí que estaba. Le faltó muy poco para esa explosión."
    mc "Eu estava lá. Foi por pouco."

# game/scripts/c19/c19.rpy:539
translate brazilian c19s002_Simone_2d28b8be:

    # sim "¡Qué susto! Por un momento he pensado que vosotros..."
    sim "Que susto! Por um momento pensei que vocês..."

# game/scripts/c19/c19.rpy:540
translate brazilian c19s002_Simone_fe92ead7:

    # mc "Lo hace toda la familia, por eso te he besado también a ti. Ya lo he tomado yo también como costumbre y no se me ha ocurrido preguntar."
    mc "Toda a família faz isso, por isso também te beijei. Eu mesma acabei criando esse hábito e nem me ocorreu perguntar."

# game/scripts/c19/c19.rpy:543
translate brazilian c19s002_Simone_298c9f8a:

    # emm "Pero si nosotros... supongo que te refieres a estar juntos... ¿Sería un problema para ti? Sé que siempre te ha gustado mi hermano."
    emm "Mas se nós... suponho que você queira dizer ficarmos juntos... Isso seria um problema para você? Eu sei que você sempre gostou do meu irmão."

# game/scripts/c19/c19.rpy:544
translate brazilian c19s002_Simone_01485643:

    # sim "No, para nada. Ya me dijo que era posible que saliera con otras chicas... aunque me sorprendería un poco siendo tú..."
    sim "Não, de jeito nenhum. Ele já me disse que é possível que ele saia com outras garotas... embora eu fique um pouco surpresa, vindo de você..."

# game/scripts/c19/c19.rpy:546
translate brazilian c19s002_Simone_22589af8:

    # sim "Eres su hermana..."
    sim "Você é a irmã dele..."

# game/scripts/c19/c19.rpy:548
translate brazilian c19s002_Simone_53a32bab:

    # sim "Os habéis criado como hermanos..."
    sim "Vocês cresceram como irmãos..."

# game/scripts/c19/c19.rpy:550
translate brazilian c19s002_Simone_27c59e18:

    # emm "Me alegro mucho por vosotros."
    emm "Estou muito feliz por você."

# game/scripts/c19/c19.rpy:551
translate brazilian c19s002_Simone_0b5cc1ec_1:

    # sim "¿Qué? ¿Por qué?"
    sim "O quê? Por quê?"

# game/scripts/c19/c19.rpy:552
translate brazilian c19s002_Simone_cf3285a1:

    # emm "No te hubiera dicho eso si no saliera también contigo."
    emm "Eu não teria te dito isso se não estivéssemos namorando."

# game/scripts/c19/c19.rpy:554
translate brazilian c19s002_Simone_3a502115:

    # sim "¡Oh, mielda! ¡Lo siento!"
    sim "Puxa! Me desculpe!"

# game/scripts/c19/c19.rpy:555
translate brazilian c19s002_Simone_6b006395:

    # mc "*Risa* Nunca os metáis a espías. Sois horribles guardando secretos."
    mc "*Risos* Nunca se tornem espiões. Vocês são péssimos em guardar segredos."

# game/scripts/c19/c19.rpy:557
translate brazilian c19s002_Simone_7bad20f4:

    # emm "¿Yo? ¡Esta vez no he dicho nada!"
    emm "Eu? Desta vez não disse nada!"

# game/scripts/c19/c19.rpy:558
translate brazilian c19s002_Simone_0a7385f2:

    # mc "Acabas de decir \"si no saliera también contigo\". *Risa*"
    mc "Você acabou de dizer: \"Se eu não estivesse namorando com você também.\" *Risos*"

# game/scripts/c19/c19.rpy:560
translate brazilian c19s002_Simone_6d198937:

    # emm "¡Oh, mierda! *Risa* ¡Tienes razón!"
    emm "Puxa! *Risos* Você tem razão!"

# game/scripts/c19/c19.rpy:561
translate brazilian c19s002_Simone_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c19/c19.rpy:562
translate brazilian c19s002_Simone_ed995493:

    # emm "*Risa* Sí, lo sé. Siempre tienes razón."
    emm "*Risos* Sim, eu sei. Você sempre tem razão."

# game/scripts/c19/c19.rpy:564
translate brazilian c19s002_Simone_fa2f2d3e:

    # emm "¿Ya te has hecho la prueba de embarazo? ¿O vosotros todavía no...?"
    emm "Vocês já fizeram um teste de gravidez? Ou ainda não...?"

# game/scripts/c19/c19.rpy:565
translate brazilian c19s002_Simone_b9ea5f6b:

    # sim "¿Qué prueba de embarazo?"
    sim "Qual teste de gravidez?"

# game/scripts/c19/c19.rpy:566
translate brazilian c19s002_Simone_0cddf3b3:

    # mc "Te lo iba a comentar..."
    mc "Eu ia te contar isso..."

# game/scripts/c19/c19.rpy:568
translate brazilian c19s002_Simone_d578f76d:

    # "Tras ponerla al día..."
    "Após a atualização..."

# game/scripts/c19/c19.rpy:569
translate brazilian c19s002_Simone_e15cf325:

    # emm "Yo me la he hecho esta mañana y tendré los resultados mañana."
    emm "Fiz o exame hoje de manhã e terei os resultados amanhã."

# game/scripts/c19/c19.rpy:570
translate brazilian c19s002_Simone_acb21f59:

    # mc "Las tengo en mi habitación. Cuando quieras podemos ir y hacerla."
    mc "Eu os tenho no meu quarto. Podemos ir lá e fazer isso quando você quiser."

# game/scripts/c19/c19.rpy:571
translate brazilian c19s002_Simone_5b235fae:

    # sim "Estaría bien... no tengo ninguna molestia, pero... siempre es bueno saber algo así, ¿no?"
    sim "Seria bom... Não tenho nenhum problema, mas... é sempre bom saber dessas coisas, não é?"

# game/scripts/c19/c19.rpy:573
translate brazilian c19s002_Simone_befba6d9:

    # emm "Pues subid y hacerla. Y si os queréis tomar vuestro tiempo, hacedlo. Yo os cubro."
    emm "Vá em frente e faça. E se quiser levar o tempo que precisar, fique à vontade. Pode contar comigo."

# game/scripts/c19/c19.rpy:574
translate brazilian c19s002_Simone_d006dc6d:

    # mc "Me parece alucinante lo que has cambiado en un par de semanas, [emm]."
    mc "Estou impressionado com o quanto você mudou em apenas algumas semanas, [emm]."

# game/scripts/c19/c19.rpy:576
translate brazilian c19s002_Simone_6888dff4:

    # emm "Ya tengo 19. Es hora de que me empiece a comportar como la adulta de la casa, ¿no?"
    emm "Agora tenho 19 anos. Já está na hora de eu começar a agir como o adulto da casa, não é?"

# game/scripts/c19/c19.rpy:577
translate brazilian c19s002_Simone_44485f83:

    # mc "*Risa* No sé qué diría Mamá si te oyera decir eso."
    mc "*Risos* Não sei o que a mamãe diria se ouvisse você falar isso."

# game/scripts/c19/c19.rpy:579
translate brazilian c19s002_Simone_0229aa26:

    # sim "O Tía Betty y Olivia. *Risa*"
    sim "Ah, tia Betty e Olivia. *Risos*"

# game/scripts/c19/c19.rpy:581
translate brazilian c19s002_Simone_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c19/c19.rpy:583
translate brazilian c19s002_Simone_7d7cf906:

    # emm "Voy a abrir. Seguro que son chicas que vienen a felicitarme el cumpleaños. *Risita*"
    emm "Vou abrir. Tenho certeza de que são só garotas vindo me desejar feliz aniversário. *Risos*"

# game/scripts/c19/c19.rpy:585
translate brazilian c19s002_Simone_93d45d6b:

    # mc "Muy adulta... *Risa*"
    mc "Muito adulto... *Risos*"

# game/scripts/c19/c19.rpy:587
translate brazilian c19s002_Simone_4996e67f:

    # mc "Te esperamos aquí."
    mc "Estaremos esperando por você aqui."

# game/scripts/c19/c19.rpy:589
translate brazilian c19s002_Simone_34fca039:

    # "Unos segundos después..."
    "Alguns segundos depois..."

# game/scripts/c19/c19.rpy:590
translate brazilian c19s002_Simone_d0e5fec6:

    # emm "Mirad quién ha venido."
    emm "Olha quem chegou."

# game/scripts/c19/c19.rpy:591
translate brazilian c19s002_Simone_5255c088:

    # ama "Buenos días, [mc]. Encantada de conocerte por fin, Simone."
    ama "Bom dia, [mc]. Prazer em finalmente conhecê-la, Simone."

# game/scripts/c19/c19.rpy:592
translate brazilian c19s002_Simone_5b8e32a8:

    # eva "Buenos días a los dos. Ya era hora de que nos conociéramos. Creo que tu madre y tu hermano son los últimos que me quedan por conocer."
    eva "Bom dia para vocês dois. Já estava na hora de nos conhecermos. Acho que sua mãe e seu irmão são as últimas pessoas que ainda não conheci."

# game/scripts/c19/c19.rpy:593
translate brazilian c19s002_Simone_ae656f40:

    # mc "Están en la piscina. Podréis conocerlos cuando os cambiéis de ropa."
    mc "Eles estão na piscina. Você poderá encontrá-los quando trocar de roupa."

# game/scripts/c19/c19.rpy:595
translate brazilian c19s002_Simone_8cb7b297:

    # sim "Si no os tuviera delante no podría creerlo... es increíble."
    sim "Se você não estivesse aqui na minha frente, eu não acreditaria... é incrível."

# game/scripts/c19/c19.rpy:596
translate brazilian c19s002_Simone_d0819d50:

    # mc "Te acostumbrarás muy pronto. *Risa*"
    mc "Você vai se acostumar rapidinho. *Risos*"

# game/scripts/c19/c19.rpy:598
translate brazilian c19s002_Simone_3245347d:

    # emm "Las llevo a mi habitación a que se cambien."
    emm "Eu as levo para o meu quarto para trocar de roupa."

# game/scripts/c19/c19.rpy:599
translate brazilian c19s002_Simone_9bbc852f:

    # ama "Un segundo, [emm]."
    ama "Um segundo, [emm]."

# game/scripts/c19/c19.rpy:601
translate brazilian c19s002_Simone_9e70d621:

    # ama "Buenos días, [mc]."
    ama "Bom dia, [mc]."

# game/scripts/c19/c19.rpy:602
translate brazilian c19s002_Simone_7aaa020f:

    # mc "Buenos días, Amanda."
    mc "Bom dia, Amanda."

# game/scripts/c19/c19.rpy:604
translate brazilian c19s002_Simone_e567f8ab:

    # eva "Buenos días, [mc]."
    eva "Bom dia, [mc]."

# game/scripts/c19/c19.rpy:605
translate brazilian c19s002_Simone_eb772fe5:

    # mc "Buenos días, Eva."
    mc "Bom dia, Eva."

# game/scripts/c19/c19.rpy:606
translate brazilian c19s002_Simone_feb4db75:

    # eva "Ya nos podemos ir."
    eva "Podemos ir agora."

# game/scripts/c19/c19.rpy:607
translate brazilian c19s002_Simone_aaad63eb:

    # mcp "(Sin un cronómetro en la mano no podría asegurarlo, pero juraría que sus besos no se han desviado más de una décima de segundo.)"
    mcp "(Sem um cronômetro, não posso afirmar com certeza, mas juraria que os beijos deles não variaram mais do que um décimo de segundo.)"

# game/scripts/c19/c19.rpy:609
translate brazilian c19s002_Simone_25449169:

    # eva "Hablamos luego, Simone. Tengo ganas de conocerte mejor."
    eva "Conversaremos mais tarde, Simone. Estou ansioso para te conhecer melhor."

# game/scripts/c19/c19.rpy:610
translate brazilian c19s002_Simone_035146f7:

    # ama "Yo también, además... bueno ya lo hablaremos otro día."
    ama "Eu também, além disso... bem, falaremos sobre isso outro dia."

# game/scripts/c19/c19.rpy:611
translate brazilian c19s002_Simone_b7d55cbe:

    # emm "Vámonos o no podremos cotillear mientras os cambiáis."
    emm "Vamos logo, senão não vamos poder fofocar enquanto você se troca."

# game/scripts/c19/c19.rpy:613
translate brazilian c19s002_Simone_657589d0:

    # "Una vez se han ido..."
    "Assim que eles forem embora..."

# game/scripts/c19/c19.rpy:614
translate brazilian c19s002_Simone_4c0bb3f1:

    # sim "Voy a volver a repetirlo... Increíble..."
    sim "Vou repetir... Incrível..."

# game/scripts/c19/c19.rpy:615
translate brazilian c19s002_Simone_4582416e:

    # mc "*Risa* Tranquila. La sorpresa se pasa en cuanto empieces a hablar con ellas."
    mc "*Risos* Relaxa. A surpresa vai passar assim que você começar a conversar com eles."

# game/scripts/c19/c19.rpy:616
translate brazilian c19s002_Simone_0d0430c8:

    # mc "Son buenas chicas, aunque prefiero que te formes una opinión tú, una vez hayas tenido la oportunidad de conocerlas."
    mc "São boas moças, embora eu prefira que você forme sua própria opinião depois de ter a oportunidade de conhecê-las."

# game/scripts/c19/c19.rpy:618
