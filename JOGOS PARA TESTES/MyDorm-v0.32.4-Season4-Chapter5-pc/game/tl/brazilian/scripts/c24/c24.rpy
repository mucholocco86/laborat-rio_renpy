

# game/scripts/c24/c24.rpy:37
translate brazilian c24s001_Bet_6854d5fe:

    # mc "Pues sí, creo que nos ha oído."
    mc "Sim, acho que ele nos ouviu."

# game/scripts/c24/c24.rpy:38
translate brazilian c24s001_Bet_bdb3454f:

    # mc "¿Vas a dormir con eso?"
    mc "Você vai dormir com isso ligado?"

# game/scripts/c24/c24.rpy:40
translate brazilian c24s001_Bet_747077f8:

    # bet "No he dormido con un sujetador en mi vida... Esto tiene que ser super incómodo."
    bet "Nunca dormi de sutiã na minha vida... Isso deve ser extremamente desconfortável."

# game/scripts/c24/c24.rpy:41
translate brazilian c24s001_Bet_26f867c8:

    # mc "Te puedo dejar la camiseta que me iba a poner mañana, si quieres."
    mc "Posso te emprestar a camisa que eu ia usar amanhã, se você quiser."

# game/scripts/c24/c24.rpy:43
translate brazilian c24s001_Bet_1c3588bf:

    # bet "Sí, por favor..."
    bet "Sim, por favor..."

# game/scripts/c24/c24.rpy:44
translate brazilian c24s001_Bet_b71ed625:

    # mc "Aunque también podrías dormir sin el sujetador. No voy a ver nada que no haya visto en la piscina..."
    mc "Embora você também possa dormir sem sutiã. Não vou ver nada que já não tenha visto na piscina..."

# game/scripts/c24/c24.rpy:45
translate brazilian c24s001_Bet_1f50df54:

    # mc "O en la cocina, durante la partida de DnD."
    mc "Ou na cozinha, durante uma partida de D&D."

# game/scripts/c24/c24.rpy:47
translate brazilian c24s001_Bet_7c4deb52:

    # bet "¡[mc]! ¡Es diferente!"
    bet "É diferente!"

# game/scripts/c24/c24.rpy:48
translate brazilian c24s001_Bet_e1e7e3f0:

    # bet "No íbamos a compartir cama y no habíamos tenido la conversación que hemos tenido esta mañana en el coche."
    bet "Não íamos dividir a cama e ainda não tínhamos tido a conversa que tivemos esta manhã no carro."

# game/scripts/c24/c24.rpy:49
translate brazilian c24s001_Bet_6b8e33f0:

    # mc "No te preocupes, te presto mi camiseta."
    mc "Não se preocupe, eu te empresto minha camisa."

# game/scripts/c24/c24.rpy:50
translate brazilian c24s001_Bet_3e6d5518:

    # mc "De todas formas, no iba a pasar nada. Te dije que podríamos tener una oportunidad de estar juntos si no eras monja. Y aún lo eres."
    mc "De qualquer forma, nada ia acontecer. Eu te disse que poderíamos ter uma chance de ficar juntos se você não fosse freira. E você ainda é."

# game/scripts/c24/c24.rpy:52
translate brazilian c24s001_Bet_2d289fcf:

    # bet "Lo sé..."
    bet "Eu sei..."

# game/scripts/c24/c24.rpy:53
translate brazilian c24s001_Bet_190311ff:

    # bet "Dame esa camiseta, por favor."
    bet "Me dê essa camisa, por favor."

# game/scripts/c24/c24.rpy:54
translate brazilian c24s001_Bet_ba2cbe37:

    # mc "Se la presté a [eil] el día que llegó a casa y me parece que ha dado el cuello de sí un poco..."
    mc "Emprestei para [eil] no dia em que ela chegou em casa e me parece que o pescoço esticou um pouco..."

# game/scripts/c24/c24.rpy:56
translate brazilian c24s001_Bet_a5a52c4a:

    # bet "*Desde el lavabo* ¿En serio? ¿No tenías otra camiseta?"
    bet "*Do banheiro* Sério? Você não tinha outra camisa?"

# game/scripts/c24/c24.rpy:57
translate brazilian c24s001_Bet_cc013ef9:

    # mc "*Risa* Lo sé, casi parece hecho a propósito."
    mc "*Risos* Eu sei, parece até que foi feito de propósito."

# game/scripts/c24/c24.rpy:58
translate brazilian c24s001_Bet_b09f2caa:

    # bet "*Desde el lavabo* ¿Estás seguro de que esto no es un plan tuyo y de [emm]?"
    bet "*Do banheiro* Tem certeza de que isso não é um plano que você e [emm] bolaram?"

# game/scripts/c24/c24.rpy:59
translate brazilian c24s001_Bet_6f244a5c:

    # mc "*Risa* No podía haber planeado algo así antes de la conversación de esta mañana."
    mc "*Risos* Eu jamais teria conseguido planejar algo assim antes da conversa desta manhã."

# game/scripts/c24/c24.rpy:60
translate brazilian c24s001_Bet_b9f3d257:

    # mc "[emm] ha tenido tiempo de planearlo si ha fingido estar dormida, pero lo de la camiseta es casualidad. *Risa* Me la regaló Jam hace años."
    mc "[emm] Ela teve tempo para planejar tudo se estava fingindo dormir, mas a coisa da camiseta é só uma coincidência. *Risos* Jam me deu ela anos atrás."

# game/scripts/c24/c24.rpy:61
translate brazilian c24s001_Bet_ce5e6d01:

    # mc "Y antes de que preguntes, me gustaría recuperarla. Es un préstamo."
    mc "E antes que você pergunte, eu gostaria de tê-lo de volta. É um empréstimo."

# game/scripts/c24/c24.rpy:67
translate brazilian c24s001_Bet_38add06f:

    # bet "Al menos es grande. No creo que entrase en una camiseta tuya de ahora. Pero es cortísima..."
    bet "Pelo menos é grande. Acho que não caberia em nenhuma das suas camisetas atuais. Mas é bem curtinho..."

# game/scripts/c24/c24.rpy:68
translate brazilian c24s001_Bet_baa147e2:

    # mc "No voy a ver nada que no haya visto hace cinco minutos. *Risa* Porque sigues llevando las bragas, ¿verdad?"
    mc "Não vou ver nada que eu já não tenha visto cinco minutos atrás. *Risos* Porque você ainda está de calcinha, né?"

# game/scripts/c24/c24.rpy:70
translate brazilian c24s001_Bet_5573fb9b:

    # bet "¡Claro que sigo llevándolas!"
    bet "É claro que ainda os uso!"

# game/scripts/c24/c24.rpy:71
translate brazilian c24s001_Bet_0a4dd1d1:

    # mc "Sólo bromeaba, Tía [bet]. Vamos a la cama; se está haciendo tarde."
    mc "Eu estava só brincando, tia [bet]. Vamos para a cama; está ficando tarde."

# game/scripts/c24/c24.rpy:73
translate brazilian c24s001_Bet_67289901:

    # "Tras apagar las luces..."
    "Depois de apagar as luzes..."

# game/scripts/c24/c24.rpy:74
translate brazilian c24s001_Bet_aaa1b5a2:

    # mc "Buenas noches, Tía [bet]."
    mc "Boa noite, tia [bet]."

# game/scripts/c24/c24.rpy:75
translate brazilian c24s001_Bet_5f3e1bd6:

    # bet "Buenas noches, [mc]."
    bet "Boa noite, [mc]."

# game/scripts/c24/c24.rpy:77
translate brazilian c24s001_Bet_2b7a1410:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y que tu mano acabe en el mismo sitio que acabó con [sca]. Salvando las diferencias de tamaño."
    "Você tenta dormir, mas é inútil. Você se preocupa em se mexer enquanto dorme e com a possibilidade de sua mão acabar no mesmo lugar onde estava [sca]. Diferenças de tamanho à parte."

# game/scripts/c24/c24.rpy:79
translate brazilian c24s001_Bet_6dd4bc9d:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y hacer algo que incomode a Tía [bet]."
    "Você tenta dormir, mas não consegue. Você está preocupado em se mexer enquanto dorme e fazer algo que possa incomodar a tia [bet]."

# game/scripts/c24/c24.rpy:80
translate brazilian c24s001_Bet_aeca0d27:

    # "Al cabo de un rato..."
    "Depois de um tempo..."

# game/scripts/c24/c24.rpy:81
translate brazilian c24s001_Bet_6a5cc46a:

    # bet "*Susurrando* ¿Estás dormido?"
    bet "*Sussurrando* Você está dormindo?"

# game/scripts/c24/c24.rpy:82
translate brazilian c24s001_Bet_142b9233:

    # mc "No, no puedo dormir. ¿Tú tampoco?"
    mc "Não, eu não consigo dormir. Você também não?"

# game/scripts/c24/c24.rpy:84
translate brazilian c24s001_Bet_ba16db52:

    # bet "No, estaba pensando en todo lo que ha pasado hoy..."
    bet "Não, eu estava pensando em tudo o que aconteceu hoje..."

# game/scripts/c24/c24.rpy:85
translate brazilian c24s001_Bet_2cab15e3:

    # mc "¿Quieres hablarlo?"
    mc "Você quer conversar sobre isso?"

# game/scripts/c24/c24.rpy:86
translate brazilian c24s001_Bet_bd85b516:

    # bet "No, no quiero que pierdas horas de sueño. Intenta dormir."
    bet "Não, não quero que você perca o sono. Tente dormir um pouco."

# game/scripts/c24/c24.rpy:87
translate brazilian c24s001_Bet_c250bdf1:

    # mc "No voy a poder. Voy a encender la luz."
    mc "Não vou conseguir. Vou acender a luz."

# game/scripts/c24/c24.rpy:89
translate brazilian c24s001_Bet_1c55fdce:

    # mc "Sé que es tontería preguntarte qué te preocupa, pero no tienes que tomar la decisión hoy. Tienes dos meses para pensarlo."
    mc "Sei que pode parecer bobagem perguntar o que está te preocupando, mas você não precisa tomar essa decisão hoje. Você tem dois meses para pensar sobre isso."

# game/scripts/c24/c24.rpy:90
translate brazilian c24s001_Bet_0d21d4ba:

    # bet "Esa decisión ya la he tomado. No voy a entrar en un convento de clausura ni me voy a ir a Latinoamérica."
    bet "Eu já tomei essa decisão. Não vou entrar para um convento de clausura, nem vou para a América Latina."

# game/scripts/c24/c24.rpy:91
translate brazilian c24s001_Bet_4845b11d:

    # bet "Las dos cosas significarían perder a la familia, y no estoy dispuesta a ello."
    bet "Ambas as opções significariam perder minha família, e eu não estou disposto a fazer isso."

# game/scripts/c24/c24.rpy:92
translate brazilian c24s001_Bet_640320c2:

    # mc "Bueno, volver a África, que era tu plan inicial, también hubiera significado que no nos verías..."
    mc "Bem, voltar para a África, que era o seu plano inicial, também significaria que você não nos veria..."

# game/scripts/c24/c24.rpy:94
translate brazilian c24s001_Bet_cb00520d:

    # bet "Es diferente. De allí podría volver una o dos veces al año para veros. De un convento en Perú, no."
    bet "É diferente. De lá eu poderia voltar uma ou duas vezes por ano para te ver. De um convento no Peru, não."

# game/scripts/c24/c24.rpy:95
translate brazilian c24s001_Bet_b2431031:

    # mc "Tienes razón, no lo había pensado así. Para mí sería casi igual de duro que te fueras a Perú que a... no sé... un país de África que no fuera Tanzania."
    mc "Você tem razão, eu não tinha pensado nisso dessa forma. Para mim, seria quase tão difícil se você fosse para o Peru quanto seria se você fosse para... sei lá... algum país africano que não fosse a Tanzânia."

# game/scripts/c24/c24.rpy:96
translate brazilian c24s001_Bet_1d335301:

    # mc "Me he acostumbrado a verte todos los días, y sería difícil si te tuvieras que ir."
    mc "Eu me acostumei a te ver todos os dias, e seria difícil se você tivesse que ir embora."

# game/scripts/c24/c24.rpy:98
translate brazilian c24s001_Bet_fb7a27b1:

    # bet "Por eso te digo que la decisión está tomada. Por lo que a mí respecta, he dejado de ser monja hace horas, aunque deje de serlo oficialmente en unos meses."
    bet "Por isso estou lhe dizendo que a decisão está tomada. No que me diz respeito, deixei de ser freira há algumas horas, embora oficialmente só deixe de sê-lo daqui a alguns meses."

# game/scripts/c24/c24.rpy:99
translate brazilian c24s001_Bet_c1614e7a:

    # mc "Si tienes la decisión tomada, ¿por qué no hacerlo oficial mañana cuando vayas a por la documentación de los conventos?"
    mc "Se você já tomou sua decisão, por que não oficializá-la amanhã, quando for buscar a documentação para os conventos?"

# game/scripts/c24/c24.rpy:100
translate brazilian c24s001_Bet_44470795:

    # mc "Supongo que la iglesia pensará que tomarás la decisión entre las dos opciones que te han propuesto, no una tercera opción."
    mc "Imagino que a igreja espere que você tome a decisão entre as duas opções que eles propuseram, e não uma terceira opção."

# game/scripts/c24/c24.rpy:101
translate brazilian c24s001_Bet_5ce4fd71:

    # mc "No sé si tendrán que preparar algún papel para que te des de baja, o como se diga."
    mc "Não sei se eles precisarão preparar algum documento para você cancelar a assinatura, ou algo parecido."

# game/scripts/c24/c24.rpy:103
translate brazilian c24s001_Bet_7d4ff649:

    # bet "Tienes razón... sería una forma de cerrar todo este asunto, al menos hasta que firme los papeles que seguro que me harán firmar."
    bet "Você tem razão... seria uma forma de encerrar todo esse assunto, pelo menos até eu assinar os papéis que certamente me farão assinar."

# game/scripts/c24/c24.rpy:104
translate brazilian c24s001_Bet_d0033555:

    # mc "Genial. Un tema resuelto. Supongo que lo otro a lo que le estabas dando vueltas era a lo de la certificación, pero eso ya ha quedado resuelto."
    mc "Ótimo. Problema resolvido. Imagino que a outra coisa em que você estava pensando era a certificação, mas isso já foi resolvido."

# game/scripts/c24/c24.rpy:106
translate brazilian c24s001_Bet_b1035ecd:

    # bet "Me preocupa ponerme a estudiar a mi edad, y empezar a buscar trabajo... Soy una anciana a punto de retirarse, al fin y al cabo."
    bet "Estou preocupada em começar a estudar na minha idade e em começar a procurar emprego... Afinal, sou uma senhora idosa prestes a me aposentar."

# game/scripts/c24/c24.rpy:107
translate brazilian c24s001_Bet_1e4e4c73:

    # mc "Eres una mujer con un montón de experiencia. Creo que eso también lo valorarán. ¿Alguna cosa más que te preocupe?"
    mc "Você é uma mulher com muita experiência. Acho que eles também vão valorizar isso. Tem mais alguma coisa em mente?"

# game/scripts/c24/c24.rpy:110
translate brazilian c24s001_Bet_770afeaa:

    # bet "Lo que has dicho antes."
    bet "Concordo com o que você disse antes."

# game/scripts/c24/c24.rpy:111
translate brazilian c24s001_Bet_17f34aa8:

    # mc "¿Qué he dicho?"
    mc "O que eu disse?"

# game/scripts/c24/c24.rpy:114
translate brazilian c24s001_Bet_676009a9:

    # bet "Lo de que podríamos tener una oportunidad de estar juntos si no era monja. Y que aún lo era. Aunque solo sea oficialmente..."
    bet "A ideia de que poderíamos ter uma chance de ficar juntos se ela não fosse freira. E que ela ainda era. Mesmo que apenas oficialmente..."

# game/scripts/c24/c24.rpy:115
translate brazilian c24s001_Bet_2d82726b:

    # mc "¿Y qué te preocupa sobre eso?"
    mc "E o que te preocupa nisso?"

# game/scripts/c24/c24.rpy:117
translate brazilian c24s001_Bet_dcbab1f8:

    # bet "Hace 40 años que no estoy con nadie... Ya no sé qué hacer o cómo hacerlo. Y no me refiero al sexo... me refiero... a esa oportunidad de la que hablabas."
    bet "Faz 40 anos que não me relaciono com ninguém... Não sei mais o que fazer nem como fazer. E não estou falando de sexo... Quero dizer... daquela oportunidade que você mencionou."

# game/scripts/c24/c24.rpy:118
translate brazilian c24s001_Bet_c88be3be:

    # mc "Eso es muy fácil. Se habla todo. Cualquier duda que tengas sobre lo que debes o no debes hacer, solo tienes que hablarlo conmigo."
    mc "É muito fácil. Conversaremos sobre tudo. Se tiver alguma dúvida sobre o que deve ou não fazer, basta falar comigo."

# game/scripts/c24/c24.rpy:120
translate brazilian c24s001_Bet_debec0dd:

    # mc "Por ejemplo, yo podría preguntar si puedo hacer esto ahora que sólo eres monja oficialmente pero ya no te consideras una."
    mc "Por exemplo, eu poderia perguntar se posso fazer isso agora que você é oficialmente uma freira, mas não se considera mais como tal."

# game/scripts/c24/c24.rpy:121
translate brazilian c24s001_Bet_57cad9b2:

    # mc "Y tú podrías contestar sí o no, o no contestar y dejarme seguir."
    mc "Você pode responder sim ou não, ou não responder e me deixar continuar."

# game/scripts/c24/c24.rpy:122
translate brazilian c24s001_Bet_09ec5f6e:

    # bet "O podría preguntar qué pretendes con eso..."
    bet "Ou eu poderia perguntar o que você espera alcançar com isso..."

# game/scripts/c24/c24.rpy:123
translate brazilian c24s001_Bet_46c34fcd:

    # mc "Podrías, pero... ¿lo estás preguntando?"
    mc "Você poderia, mas... está perguntando?"

# game/scripts/c24/c24.rpy:125
translate brazilian c24s001_Bet_2fd44d12:

    # bet "No..."
    bet "Não..."

# game/scripts/c24/c24.rpy:126
translate brazilian c24s001_Bet_0d02ac2b:

    # mc "Yo tampoco he preguntado si puedo..."
    mc "Eu também não perguntei se posso..."

# game/scripts/c24/c24.rpy:127
translate brazilian c24s001_Bet_c7bbd3dd:

    # bet "Pero puedes..."
    bet "Mas você pode..."

# game/scripts/c24/c24.rpy:128
translate brazilian c24s001_Bet_3c1ea0e5:

    # mc "Y si te dijera que quiero recuperar mi camiseta, ¿cuál sería tu respuesta?"
    mc "E se eu lhe dissesse que queria minha camisa de volta, qual seria sua resposta?"

# game/scripts/c24/c24.rpy:130
translate brazilian c24s001_Bet_46c8122d:

    # bet "*Risa* Que te la tendré que devolver porque me la has prestado mientras aún era monja..."
    bet "*Risos* Vou ter que te devolver, porque você me emprestou quando eu ainda era freira..."

# game/scripts/c24/c24.rpy:132
translate brazilian c24s001_Bet_a8f8ea5e:

    # bet "[sca] te enseño cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "[sca] Vou te mostrar como isso funciona quando você empresta roupas para seu parceiro, certo? Isso não mudou desde a minha época."

# game/scripts/c24/c24.rpy:134
translate brazilian c24s001_Bet_bc00184a:

    # bet "Ya sabes cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "Você sabe como funciona quando você empresta roupas para seu parceiro, certo? Isso não mudou desde a minha época."

# game/scripts/c24/c24.rpy:135
translate brazilian c24s001_Bet_afb45094:

    # mc "*Risa* Creo que gastaré mucho en ropa entonces. Pero de momento, quiero mi camiseta."
    mc "*Risos* Acho que vou gastar muito com roupas então. Mas por enquanto, quero minha camiseta."

# game/scripts/c24/c24.rpy:138
translate brazilian c24s001_Bet_20be496e:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a tu Tía Abuela?"
    bet "*Suprimindo o riso enquanto finge surpresa* [mc]! Você quer ver os peitos da sua tia-avó?"

# game/scripts/c24/c24.rpy:140
translate brazilian c24s001_Bet_03021ef5:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a una anciana exmonja?"
    bet "*Suprimindo o riso enquanto finge surpresa* [mc]! Você quer ver os peitos de uma ex-freira?"

# game/scripts/c24/c24.rpy:141
translate brazilian c24s001_Bet_aedbe009:

    # mc "No solo verlas. Aunque no me canse de verlas, hoy quiero hacer más que solo mirarlas."
    mc "Não apenas para admirá-las. Embora eu nunca me canse de admirá-las, hoje quero fazer mais do que simplesmente observá-las."

# game/scripts/c24/c24.rpy:143
translate brazilian c24s001_Bet_0cf9ce16:

    # bet "¿Mejor así, entonces?"
    bet "Então, está melhor assim?"

# game/scripts/c24/c24.rpy:144
translate brazilian c24s001_Bet_70eac7fa:

    # mc "Mucho mejor... pero antes de continuar quiero preguntarte si estás realmente segura de esto."
    mc "Muito melhor... mas antes de prosseguirmos, quero perguntar se você tem mesmo certeza disso."

# game/scripts/c24/c24.rpy:145
translate brazilian c24s001_Bet_68c35d5c:

    # mc "Aún eres oficialmente una monja y no me gustaría que por la mañana te sintieras mal por lo que pase ahora."
    mc "Você ainda é oficialmente uma freira, e eu não gostaria que você se sentisse mal amanhã por causa do que acontecer agora."

# game/scripts/c24/c24.rpy:147
translate brazilian c24s001_Bet_13a4ced8:

    # bet "Estoy segurísima, no te preocupes. No me voy a volver a poner el hábito nunca más."
    bet "Tenho absoluta certeza, não se preocupe. Nunca mais vou usar esse hábito."

# game/scripts/c24/c24.rpy:148
translate brazilian c24s001_Bet_f0e73b0b:

    # mc "En ese caso, creo que necesito acariciarte. *Risa* Y eliminar la camiseta de la ecuación."
    mc "Nesse caso, acho que preciso te fazer um carinho. *Risos* E tirar a camisa da equação."

# game/scripts/c24/c24.rpy:149
translate brazilian c24s001_Bet_69b8fde0:

    # bet "En ese caso, creo que estoy de acuerdo en devolverte la camiseta. Por esta vez."
    bet "Nesse caso, acho que concordo em devolver a camisa. Só desta vez."

# game/scripts/c24/c24.rpy:151
translate brazilian c24s001_Bet_007a24b7:

    # bet "¿Así o quieres que me desnude del todo?"
    bet "Então, você quer que eu fique completamente nu?"

# game/scripts/c24/c24.rpy:152
translate brazilian c24s001_Bet_3c378150:

    # mc "Querré, pero todo a su tiempo. Ahora es el momento de entregar las caricias prometidas."
    mc "Farei isso, mas tudo a seu tempo. Agora é a hora de cumprir as promessas de carinho."

# game/scripts/c24/c24.rpy:153
translate brazilian c24s001_Bet_1c7d23d5:

    # mc "Túmbate, por favor, quiero disfrutar de ese cuerpo como es debido."
    mc "Deite-se, por favor, quero desfrutar desse corpo como deve ser."

# game/scripts/c24/c24.rpy:155
translate brazilian c24s001_Bet_0c11c9c5:

    # bet "¿Así va bien?"
    bet "Está tudo bem assim?"

# game/scripts/c24/c24.rpy:156
translate brazilian c24s001_Bet_cf5358cd:

    # mc "Así estás perfecta. Y super sexy."
    mc "Você está perfeita assim. E super sexy."

