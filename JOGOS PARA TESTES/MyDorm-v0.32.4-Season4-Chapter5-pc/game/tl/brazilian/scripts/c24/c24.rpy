translate brazilian c24s004_Mad_Lis_Emm_7a8239e6:

    # "[ama] está sentada dentro, parece que está escribiendo algo."
    "[ama] está sentada lá dentro, parece que ela está escrevendo alguma coisa."

# game/scripts/c24/c24.rpy:3273
translate brazilian c24s004_Mad_Lis_Emm_d9be006a:

    # "Te acercas a la furgoneta, dispuesto a golpear en la ventanilla."
    "Você se aproxima da van, pronto para bater na janela."

# game/scripts/c24/c24.rpy:3274
translate brazilian c24s004_Mad_Lis_Emm_4671c751:

    # ama "Un momento, [mc], por favor."
    ama "Um momento, [mc], por favor."

# game/scripts/c24/c24.rpy:3276
translate brazilian c24s004_Mad_Lis_Emm_f63377ab:

    # "Esperas."
    "Você espera."

# game/scripts/c24/c24.rpy:3280
translate brazilian c24s004_Kim_Mee_Meg_1657ce25:

    # "Unos minutos antes, en la cocina de [nor]..."
    "Poucos minutos antes, na cozinha de [nor]..."

# game/scripts/c24/c24.rpy:3282
translate brazilian c24s004_Kim_Mee_Meg_c653479e:

    # mee "Un día tengo que ir a oírte cantar. Siempre me ha gustado el jazz."
    mee "Um dia preciso ir te ouvir cantar. Sempre adorei jazz."

# game/scripts/c24/c24.rpy:3283
translate brazilian c24s004_Kim_Mee_Meg_af457e4a:

    # meg "Aunque el sitio se llame Jazz Corner, no solo canto jazz. Tenemos un repertorio muy variado."
    meg "Embora o local se chame Jazz Corner, eu não canto apenas jazz. Temos um repertório muito variado."

# game/scripts/c24/c24.rpy:3285
translate brazilian c24s004_Kim_Mee_Meg_3af7fb04:

    # mee "Bueno, igualmente me gustaría ir. Hace años que no voy a ningún sitio con música en directo."
    mee "Bom, eu ainda gostaria de ir. Faz anos que não vou a nenhum lugar com música ao vivo."

# game/scripts/c24/c24.rpy:3287
translate brazilian c24s004_Kim_Mee_Meg_ff447e67:

    # meg "¿Ibas mucho cuando...?"
    meg "Você costumava ir muito quando...?"

# game/scripts/c24/c24.rpy:3289
translate brazilian c24s004_Kim_Mee_Meg_1dfbe6a8:

    # mee "*Risa* ¿Cuando era joven?"
    mee "*Risos* Quando eu era jovem?"

# game/scripts/c24/c24.rpy:3290
translate brazilian c24s004_Kim_Mee_Meg_441cb2fd:

    # mee "Sí, a John y a mí nos gustaba mucho ir, especialmente antes de casarnos, cuando él aún vivía en San Francisco."
    mee "Sim, John e eu gostávamos muito de ir lá, especialmente antes de nos casarmos, quando ele ainda morava em São Francisco."

# game/scripts/c24/c24.rpy:3292
translate brazilian c24s004_Kim_Mee_Meg_ee6c2dee:

    # meg "San Francisco siempre ha tenido buenos clubes de jazz. ¿Teníais algún favorito?"
    meg "São Francisco sempre teve ótimos clubes de jazz. Você tinha algum favorito?"

# game/scripts/c24/c24.rpy:3294
translate brazilian c24s004_Kim_Mee_Meg_19267300:

    # mee "Sí, el Keystone Korner. Un clásico. Incluso estuvimos allí en un par de ocasiones cuando hicieron grabaciones de directos."
    mee "Sim, o Keystone Korner. Um clássico. Chegamos a ir lá algumas vezes quando eles estavam gravando shows ao vivo."

# game/scripts/c24/c24.rpy:3295
translate brazilian c24s004_Kim_Mee_Meg_fee7d91a:

    # mee "Todavía tengo los vinilos de esas grabaciones."
    mee "Eu ainda tenho os discos de vinil dessas gravações."

# game/scripts/c24/c24.rpy:3297
translate brazilian c24s004_Kim_Mee_Meg_add89710:

    # meg "¡Oh! ¡Eso es increíble! ¿De quién son los discos?"
    meg "Nossa! Que incrível! De quem são esses discos?"

# game/scripts/c24/c24.rpy:3299
translate brazilian c24s004_Kim_Mee_Meg_050b1da4:

    # mee "Uno es de Tete Montoliu y otro de Jaki Byard, los dos en el '79 o el '80. Son fantásticos."
    mee "Uma é de Tete Montoliu e a outra de Jaki Byard, ambas de 79 ou 80. São fantásticas."

# game/scripts/c24/c24.rpy:3301
translate brazilian c24s004_Kim_Mee_Meg_90e7cdda:

    # meg "¡Me tienes que dejar escucharlos!"
    meg "Você tem que me deixar ouvi-los!"

# game/scripts/c24/c24.rpy:3302
translate brazilian c24s004_Kim_Mee_Meg_c08e7e22:

    # meg "Me das mucha envidia. ¡Estuviste ahí cuando se escribía historia de la música!"
    meg "Tenho tanta inveja de você! Você estava lá quando a história da música estava sendo escrita!"

# game/scripts/c24/c24.rpy:3304
translate brazilian c24s004_Kim_Mee_Meg_db86b5aa:

    # mee "Bueno, eran otros tiempos. Todo era más artesanal."
    mee "Bem, eram outros tempos. Tudo era mais artesanal."

# game/scripts/c24/c24.rpy:3305
translate brazilian c24s004_Kim_Mee_Meg_5a09e21b:

    # mee "Los tengo en la casa de Florida. Te los traeré cuando vaya la semana que viene a poner la casa en venta."
    mee "Tenho-as em minha casa na Flórida. Vou levá-las para você quando for na semana que vem colocar a casa à venda."

# game/scripts/c24/c24.rpy:3307
translate brazilian c24s004_Kim_Mee_Meg_efa5a653:

    # meg "Explícame cosas de aquella época, por favor. Es una de mis épocas favoritas de la música."
    meg "Fale-me sobre essa época, por favor. É um dos meus períodos favoritos na música."

# game/scripts/c24/c24.rpy:3309
translate brazilian c24s004_Kim_Mee_Meg_a17d78ab:

    # "Las dos mujeres se enzarzan en una conversación sobre una época pasada de clubs de música donde pasaban cosas importantes."
    "As duas mulheres começam uma conversa sobre uma era passada de clubes de música onde coisas importantes aconteciam."

# game/scripts/c24/c24.rpy:3311
translate brazilian c24s004_Kim_Mee_Meg_8015d8a9:

    # "Un tiempo en el que podías coincidir con músicos famosos en clubs que no estaban abarrotados."
    "Uma época em que era possível encontrar músicos famosos em clubes que não estivessem lotados."

# game/scripts/c24/c24.rpy:3314
translate brazilian c24s004_Kim_Mee_Meg_96cd1768:

    # kim "Hola, [mee]. ¿Qué hay, [meg]?"
    kim "Olá, [mee]. E aí, [meg]?"

# game/scripts/c24/c24.rpy:3315
translate brazilian c24s004_Kim_Mee_Meg_acb33e75:

    # kim "¿Puedo pedirte un favor, [mee]?"
    kim "Posso te pedir um favor, [mee]?"

# game/scripts/c24/c24.rpy:3317
translate brazilian c24s004_Kim_Mee_Meg_566154d1:

    # mee "Lo que quieras, cielo."
    mee "O que você quiser, querida."

# game/scripts/c24/c24.rpy:3318
translate brazilian c24s004_Kim_Mee_Meg_f494511a:

    # meg "¿Qué pasa, [kim]?"
    meg "E aí, [kim]?"

# game/scripts/c24/c24.rpy:3320
translate brazilian c24s004_Kim_Mee_Meg_37bf481f:

    # kim "Al ponerme el uniforme para esta noche lo he roto. Me va un poco apretado..."
    kim "Rasguei meu uniforme quando o vesti para hoje à noite. Está um pouco apertado demais..."

# game/scripts/c24/c24.rpy:3321
translate brazilian c24s004_Kim_Mee_Meg_551c25ce:

    # kim "He intentado coserlo, pero... estoy muy nerviosa y soy incapaz de enhebrar la aguja."
    kim "Tentei costurar, mas... estou muito nervosa e não consigo passar a linha na agulha."

# game/scripts/c24/c24.rpy:3323
translate brazilian c24s004_Kim_Mee_Meg_af0836b9:

    # mee "Dame ese uniforme. Deja que la abuela haga su magia con la aguja."
    mee "Me dê esse uniforme. Deixe a vovó fazer sua mágica com a agulha."

# game/scripts/c24/c24.rpy:3324
translate brazilian c24s004_Kim_Mee_Meg_b57a3de6:

    # mee "¿Hay hilo y aguja en esa bolsa? Siéntate mientras lo coso."
    mee "Tem linha e agulha nessa bolsa? Sente-se enquanto eu costuro."

# game/scripts/c24/c24.rpy:3326
translate brazilian c24s004_Kim_Mee_Meg_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c24/c24.rpy:3327
translate brazilian c24s004_Kim_Mee_Meg_330d4fd8:

    # mee "Ya está cosido. He reforzado alguna de las costuras que parecían más débiles."
    mee "Já está costurado. Reforcei algumas das costuras que pareciam mais frágeis."

# game/scripts/c24/c24.rpy:3328
translate brazilian c24s004_Kim_Mee_Meg_29f1f78b:

    # mee "Ese uniforme estaba muy mal cosido."
    mee "Aquele uniforme estava muito mal costurado."

# game/scripts/c24/c24.rpy:3330
translate brazilian c24s004_Kim_Mee_Meg_b8c3d049:

    # kim "Gracias, [mee]. No sé qué habría hecho sin ti. Voy a probármelo a ver si no rompo nada esta vez."
    kim "Obrigado, [mee]. Não sei o que teria feito sem você. Vou experimentar e ver se não quebro nada desta vez."

# game/scripts/c24/c24.rpy:3332
translate brazilian c24s004_Kim_Mee_Meg_c1aba282:

    # meg "Pruébatelo en el baño si quieres y así te lo vemos puesto."
    meg "Experimente no banheiro, se quiser, e depois a gente vê você usando."

# game/scripts/c24/c24.rpy:3333
translate brazilian c24s004_Kim_Mee_Meg_5dabd8a1:

    # meg "Y [mee] puede repararlo si se rompe alguna otra costura."
    meg "E [mee] você pode consertá-lo se qualquer outra costura se romper."

# game/scripts/c24/c24.rpy:3335
translate brazilian c24s004_Kim_Mee_Meg_7c4a90bf:

    # mee "O puedes subir a mi habitación si quieres. O incluso cambiarte aquí."
    mee "Ou você pode subir ao meu quarto, se quiser. Ou até mesmo se trocar aqui."

# game/scripts/c24/c24.rpy:3336
translate brazilian c24s004_Kim_Mee_Meg_7741ec41:

    # mee "*Risa* Esta cocina ya ha visto a mucha gente desnuda últimamente."
    mee "*Risos* Esta cozinha tem visto muita gente nua ultimamente."

# game/scripts/c24/c24.rpy:3338
translate brazilian c24s004_Kim_Mee_Meg_fcd06ab9:

    # meg "¿A quién? Creía que la zona nudista era solo en el jacuzzi."
    meg "Para quem? Pensei que a área de nudismo fosse apenas na jacuzzi."

# game/scripts/c24/c24.rpy:3340
translate brazilian c24s004_Kim_Mee_Meg_71aa2cba:

    # kim "Oí que [mc] se había desnudado aquí para poner fin a una discusión sobre la desnudez el día del secuestro."
    kim "Ouvi dizer que [mc] se despiu aqui para pôr fim a uma discussão sobre nudez no dia do sequestro."

# game/scripts/c24/c24.rpy:3341
translate brazilian c24s004_Kim_Mee_Meg_393174ef:

    # kim "A veces tiene unos métodos... extraños..."
    kim "Às vezes ele usa uns métodos... estranhos..."

# game/scripts/c24/c24.rpy:3342
translate brazilian c24s004_Kim_Mee_Meg_d05e16a5:

    # kim "Dame la bolsa. [mc] está ocupado en la piscina y el resto somos todas chicas. Voy a cambiarme en ese rincón."
    kim "Me dá a bolsa. [mc] está ocupada na piscina e o resto de nós somos todas meninas. Vou me trocar naquele canto."

# game/scripts/c24/c24.rpy:3344
translate brazilian c24s004_Kim_Mee_Meg_0c47b986:

    # meg "¿Es eso cierto? ¿[mc] se desnudó durante el secuestro?"
    meg "É verdade? Ela se despiu durante o sequestro?"

# game/scripts/c24/c24.rpy:3346
translate brazilian c24s004_Kim_Mee_Meg_9c24b532:

    # mee "*Risa* No, [mc] lo hizo después del secuestro. Me estaba comportando como una idiota y me puso en mi sitio."
    mee "*Risos* Não, [mc] fez isso depois do sequestro. Eu estava agindo como um idiota e ele me colocou no meu lugar."

# game/scripts/c24/c24.rpy:3347
translate brazilian c24s004_Kim_Mee_Meg_e869658b:

    # mee "*Risa* La que se desnudó durante el secuestro fui yo. O más bien, ya estaba desnuda pero dejé caer la toalla."
    mee "*Risos* Fui eu quem ficou nua durante o sequestro. Ou melhor, eu já estava nua, mas deixei a toalha cair."

# game/scripts/c24/c24.rpy:3349
translate brazilian c24s004_Kim_Mee_Meg_ce6e31d7:

    # kim "Tía [bet] me lo contó. Fuiste muy valiente y sirvió para que los secuestradores se despistaran y [eva] pudiera entrar."
    kim "Minha tia me contou. Você foi muito corajosa, e isso ajudou a despistar os sequestradores e me deixar entrar."

# game/scripts/c24/c24.rpy:3351
translate brazilian c24s004_Kim_Mee_Meg_5881d1d8:

    # meg "¡Esperad! Había oído lo del secuestro, pero no me había enterado de nada de eso..."
    meg "Espere! Eu tinha ouvido falar do sequestro, mas não sabia nenhum detalhe..."

# game/scripts/c24/c24.rpy:3352
translate brazilian c24s004_Kim_Mee_Meg_0e4a078c:

    # meg "¡Me lo tenéis que explicar todo!"
    meg "Você tem que me explicar tudo!"

# game/scripts/c24/c24.rpy:3354
translate brazilian c24s004_Kim_Mee_Meg_435c2cc6:

    # "Mientras [mee] pone en antecedentes a [meg], [kim] se prueba el uniforme para el evento de la noche."
    "Enquanto [mee] define o fundo para [meg], [kim] experimenta o uniforme para o evento da noite."

# game/scripts/c24/c24.rpy:3357
translate brazilian c24s004_Kim_Mee_Meg_04f6548a:

    # kim "¡Ha quedado genial, [mee]! ¡Muchas gracias!"
    kim "Ficou ótimo, [mee]! Muito obrigado!"

# game/scripts/c24/c24.rpy:3359
translate brazilian c24s004_Kim_Mee_Meg_43720c20:

    # meg "¡Estás monísima con ese uniforme!"
    meg "Você está adorável nesse uniforme!"

# game/scripts/c24/c24.rpy:3360
translate brazilian c24s004_Kim_Mee_Meg_c1f18785:

    # mee "Es super gracioso. Pareces salida de una película de Corea o Vietnam, cuando las actrices y cantantes se vestían de militares para apoyar a las tropas."
    mee "É hilário. Você parece ter saído de um filme sobre a Guerra da Coreia ou do Vietnã, da época em que atrizes e cantoras se vestiam de soldados para apoiar as tropas."

# game/scripts/c24/c24.rpy:3362
translate brazilian c24s004_Kim_Mee_Meg_fefc7116:

    # kim "La verdad es que es muy chulo. Tengo ganas de hacer este evento. El yate es increíble."
    kim "É muito legal. Estou ansioso por este evento. O iate é incrível."

# game/scripts/c24/c24.rpy:3364
translate brazilian c24s004_Kim_Mee_Meg_ca9e7bac:

    # kim "Ahora solo necesito llamar a un Under para que me lleve a Westport."
    kim "Agora só preciso chamar um motorista da Under para me levar até Westport."

# game/scripts/c24/c24.rpy:3366
translate brazilian c24s004_Kim_Mee_Meg_d27e5cac:

    # meg "¿Dónde de Westport tienes que ir y a qué hora tienes que estar?"
    meg "Em que local de Westport você precisa ir e a que horas precisa estar lá?"

# game/scripts/c24/c24.rpy:3367
translate brazilian c24s004_Kim_Mee_Meg_ef69494f:

    # meg "Te podría llevar yo antes de ir al club."
    meg "Eu poderia te levar antes de irmos para a balada."

# game/scripts/c24/c24.rpy:3369
translate brazilian c24s004_Kim_Mee_Meg_75c4ea81:

    # "Las tres mujeres pasan un rato hablando sobre el trabajo de [kim] y geografía de Westport."
    "As três mulheres passam algum tempo conversando sobre o trabalho de [kim] e a geografia de Westport."

# game/scripts/c24/c24.rpy:3370
translate brazilian c24s004_Kim_Mee_Meg_04244bf3:

    # "También hablan de la familia y de los planes que tiene cada una de ellas."
    "Eles também falam sobre família e os planos que cada um deles tem."

# game/scripts/c24/c24.rpy:3371
translate brazilian c24s004_Kim_Mee_Meg_2fd41570:

    # "[kim] llama 'Abuela' un par de veces a [mee]."
    "[kim] chama [mee] de 'Vovó' algumas vezes."

# game/scripts/c24/c24.rpy:3373
translate brazilian c24s004_Kim_Mee_Meg_5b8e52db:

    # "Ninguna de ellas se da cuenta."
    "Nenhum deles se dá conta disso."

# game/scripts/c24/c24.rpy:3381
translate brazilian c24s005_Ama_ee6ec8ff:

    # "De vuelta en la furgoneta..."
    "De volta à van..."

# game/scripts/c24/c24.rpy:3383
translate brazilian c24s005_Ama_f22882bc:

    # ama "Disculpa, tenía que acabar de escribir algo que tienes que firmar."
    ama "Com licença, eu precisava terminar de escrever algo que você precisa assinar."

# game/scripts/c24/c24.rpy:3384
translate brazilian c24s005_Ama_f5b226b8:

    # mc "¿Qué es?"
    mc "O que é?"

# game/scripts/c24/c24.rpy:3386
translate brazilian c24s005_Ama_c65a50a2:

    # ama "Aquí no. Te lo explico en tu habitación."
    ama "Não aqui. Eu explico para você no seu quarto."

# game/scripts/c24/c24.rpy:3387
translate brazilian c24s005_Ama_aed47ba9:

    # mc "¡Qué misteriosa! Pero es muy pronto para que venga el helicóptero ¿no?"
    mc "Que misterioso! Mas ainda é muito cedo para o helicóptero chegar, não é?"

# game/scripts/c24/c24.rpy:3389
translate brazilian c24s005_Ama_98187efb:

    # ama "No va a venir aquí. No quieres que Iron Fist sepa dónde vives, ¿verdad?"
    ama "Ele não virá para cá. Você não quer que o Punho de Ferro saiba onde você mora, quer?"

# game/scripts/c24/c24.rpy:3390
translate brazilian c24s005_Ama_f29cba8a:

    # mc "Si tienen mi teléfono, supongo que también tienen mi dirección."
    mc "Se eles têm meu número de telefone, presumo que também tenham meu endereço."

# game/scripts/c24/c24.rpy:3392
translate brazilian c24s005_Ama_13ff6026:

    # ama "En tu ficha de empleado de NTR figura tu teléfono, pero tu dirección es de San Luis Obispo."
    ama "Seu registro de funcionário na NTR lista seu número de telefone, mas seu endereço é em San Luis Obispo."

# game/scripts/c24/c24.rpy:3393
translate brazilian c24s005_Ama_b4118369:

    # ama "*Risa* Vives en el campo de beisbol de la universidad. Por si teníamos algún topo."
    ama "*Risos* Você mora no campo de beisebol da universidade. Só por precaução, caso tenhamos um informante."

# game/scripts/c24/c24.rpy:3394
translate brazilian c24s005_Ama_a01d843a:

    # mc "*Risa* Espero que sea debajo de las gradas o me mojaré cuando llueva."
    mc "*Risos* Espero que seja debaixo das arquibancadas, senão vou me molhar quando chover."

# game/scripts/c24/c24.rpy:3395
translate brazilian c24s005_Ama_e8a1b105:

    # mc "¿Dónde va a ir a buscarnos el helicóptero, entonces?"
    mc "Então, onde o helicóptero vai nos buscar?"

# game/scripts/c24/c24.rpy:3397
translate brazilian c24s005_Ama_3cb607a6:

    # ama "Hemos alquilado un campo de tiro todo el fin de semana. Mañana por la tarde [eva] enseñará a disparar a algunas chicas."
    ama "Alugamos um estande de tiro para o fim de semana inteiro. Amanhã à tarde, [eva] vai ensinar algumas meninas a atirar."

# game/scripts/c24/c24.rpy:3398
translate brazilian c24s005_Ama_325b4e17:

    # ama "El helicóptero nos recogerá allí en cuatro horas."
    ama "O helicóptero nos buscará lá em quatro horas."

# game/scripts/c24/c24.rpy:3399
translate brazilian c24s005_Ama_827d0a03:

    # mc "OK. Voy a ducharme."
    mc "Certo. Vou tomar um banho."

# game/scripts/c24/c24.rpy:3401
translate brazilian c24s005_Ama_8f56740e:

    # ama "Voy a saludar a [mar] y te veo en 15 minutos en tu habitación."
    ama "Vou cumprimentar [mar] e te vejo em 15 minutos no seu quarto."

# game/scripts/c24/c24.rpy:3402
translate brazilian c24s005_Ama_525112d5:

    # mc "¿15 minutos? Acabo de decir que me tenía que duchar. ¡Tenemos cuatro horas!"
    mc "15 minutos? Eu acabei de dizer que precisava tomar banho. Temos quatro horas!"

# game/scripts/c24/c24.rpy:3403
translate brazilian c24s005_Ama_7deaa528:

    # ama "*Risa* La última vez que te espié duchándote, no eras tan lento como [emm]. ¿Te tienes que maquillar y depilar las piernas?"
    ama "*Risos* Da última vez que te espiei tomando banho, você não estava tão lenta quanto [emm]. Você precisa se maquiar e depilar as pernas?"

# game/scripts/c24/c24.rpy:3404
translate brazilian c24s005_Ama_d1f01a44:

    # mc "*Risa* Vale, 15 minutos ¿Qué llevas en esa bolsa?"
    mc "*Risos* Ok, 15 minutos. O que você tem nessa bolsa?"

# game/scripts/c24/c24.rpy:3405
translate brazilian c24s005_Ama_1ca49a82:

    # ama "Lo que vas a firmar y lo que te vas a poner."
    ama "O que você vai assinar e o que você vai vestir."

# game/scripts/c24/c24.rpy:3407
translate brazilian c24s005_Ama_738d9a61:

    # "15 minutos después..."
    "15 minutos depois..."

# game/scripts/c24/c24.rpy:3408
translate brazilian c24s005_Ama_2dcb8dae:

    # mc "Ya estoy aquí. ¿Qué querías que firmara? ¿Y por qué tanta prisa?"
    mc "Já estou aqui. O que você queria que eu assinasse? E por que tanta pressa?"

# game/scripts/c24/c24.rpy:3411
translate brazilian c24s005_Ama_1eadca4e:

    # "[ama] se levanta y te da un tierno beso."
    "[ama] se levanta e te dá um beijo carinhoso."

# game/scripts/c24/c24.rpy:3413
translate brazilian c24s005_Ama_a4e24b27:

    # ama "Primero, mis labios..."
    ama "Primeiro, meus lábios..."

# game/scripts/c24/c24.rpy:3414
translate brazilian c24s005_Ama_d9236e6a:

    # mc "Me parece la forma ideal de empezar una reunión de trabajo."
    mc "Acho que é a maneira ideal de começar uma reunião de trabalho."

# game/scripts/c24/c24.rpy:3416
translate brazilian c24s005_Ama_d0b258b1:

    # ama "*Risa* Espero que no hagas lo mismo con Ichigo esta noche."
    ama "*Risos* Espero que você não faça o mesmo com o Ichigo hoje à noite."

# game/scripts/c24/c24.rpy:3417
translate brazilian c24s005_Ama_8d80c347:

    # mc "No, eso solo lo hago con mercenarias rubias."
    mc "Não, eu só faço isso com mercenárias loiras."

# game/scripts/c24/c24.rpy:3418
translate brazilian c24s005_Ama_a7fbeadb:

    # ama "*Risa* Que no te oiga [eva]."
    ama "*Risos* Não deixe que ele te ouça [eva]."

# game/scripts/c24/c24.rpy:3420
translate brazilian c24s005_Ama_de43ceea:

    # "[ama] se gira para sacar algo de la bolsa de viaje que ha traído."
    "[ama] vira-se para tirar algo da mala de viagem que trouxe."

# game/scripts/c24/c24.rpy:3421
translate brazilian c24s005_Ama_3fef17f8:

    # "Las vistas son excelentes."
    "As vistas são excelentes."

# game/scripts/c24/c24.rpy:3423
translate brazilian c24s005_Ama_9b4bf20c:

    # ama "Lo siguiente que tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "O próximo documento que você precisa assinar é este. Hoje é seu primeiro dia como CEO e o primeiro documento que você assinará."

# game/scripts/c24/c24.rpy:3426
translate brazilian c24s005_Ama_c3551559:

    # ama "Dame un segundo."
    ama "Só me dê um segundo."

# game/scripts/c24/c24.rpy:3427
translate brazilian c24s005_Ama_85ade774:

    # "[ama] se agacha para sacar algo de la bolsa de viaje que ha traído."
    "[ama] se abaixa para tirar algo da mala de viagem que trouxe."

# game/scripts/c24/c24.rpy:3429
translate brazilian c24s005_Ama_f3f3881d:

    # ama "Tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "Você precisa assinar isto. Hoje é seu primeiro dia como CEO e este é o primeiro documento que você vai assinar."

# game/scripts/c24/c24.rpy:3431
translate brazilian c24s005_Ama_3bca18c7:

    # "[ama] te entrega un papel escrito a mano, con varios tachones."
    "[ama] entrega-lhe um papel manuscrito, com várias palavras riscadas."

# game/scripts/c24/c24.rpy:3441
translate brazilian c24s005_Ama_15062ef8:

    # "Carta de autorización"
    "Carta de autorização"

# game/scripts/c24/c24.rpy:3442
translate brazilian c24s005_Ama_92f35414:

    # "Como CEO de NTR, por la presente autorizo a la Srta. Gilford a realizar un estudio exhaustivo de las necesidades"
    "Na qualidade de CEO da NTR, autorizo a Sra. Gilford a realizar uma avaliação completa das necessidades."

# game/scripts/c24/c24.rpy:3443
translate brazilian c24s005_Ama_55b4d0ec:

    # "y requisitos pertinentes para establecer la Beca NTR para el próximo año académico."
    "e os requisitos pertinentes para a criação da Bolsa de Estudos NTR para o próximo ano letivo."

# game/scripts/c24/c24.rpy:3444
translate brazilian c24s005_Ama_105a3ed5:

    # "Esta beca {s}del programa{/s} tiene como objetivo apoyar a los nadadores de Newport que han decidido abandonar la natación de competición"
    "Esta bolsa de estudos do programa tem como objetivo apoiar nadadores de Newport que decidiram abandonar a natação competitiva."

# game/scripts/c24/c24.rpy:3445
translate brazilian c24s005_Ama_7e68bbd5:

    # "y {s}desean{/s} aspiran a convertirse en entrenadores de natación."
    "e aspiram a se tornar treinadores de natação."

# game/scripts/c24/c24.rpy:3446
translate brazilian c24s005_Ama_5e0df578:

    # "A la Srta. Gilford se le confían las siguientes responsabilidades:"
    "A senhorita Gilford tem as seguintes responsabilidades:"

# game/scripts/c24/c24.rpy:3447
translate brazilian c24s005_Ama_f6a40645:

    # "*Realizar una evaluación exhaustiva para determinar los criterios y requisitos específicos para {s}la{/s} esta nueva beca."
    "*Realizar uma avaliação completa para determinar os critérios e requisitos específicos para esta nova bolsa de estudos."

# game/scripts/c24/c24.rpy:3448
translate brazilian c24s005_Ama_e1fac448:

    # "*Interactuar con posibles {s}estudiantes{/s} candidatos para comprender sus motivaciones, desafíos y aspiraciones en la transición de nadadores a entrenadores."
    "*Interagir com potenciais candidatos a {s}estudantes{/s} para compreender suas motivações, desafios e aspirações na transição de nadadores para treinadores."

# game/scripts/c24/c24.rpy:3449
translate brazilian c24s005_Ama_6f084748:

    # "*Colaborar con clubes de natación locales, instituciones educativas y partes interesadas relevantes para desarrollar un marco de becas sólido."
    "*Colaborar com clubes de natação locais, instituições de ensino e partes interessadas relevantes para desenvolver uma estrutura robusta de bolsas de estudo."

# game/scripts/c24/c24.rpy:3450
translate brazilian c24s005_Ama_504d1964:

    # "*Asegurarse de que la beca proporcione el apoyo financiero, los recursos y las oportunidades de desarrollo profesional adecuados para los candidatos seleccionados."
    "*Garantir que a bolsa de estudos ofereça apoio financeiro, recursos e oportunidades de desenvolvimento profissional adequados aos candidatos selecionados."

# game/scripts/c24/c24.rpy:3451
translate brazilian c24s005_Ama_f54b3c12:

    # "Se espera que la Srta. Gilford presente sus conclusiones y recomendaciones en los próximos tres días,"
    "A Sra. Gilford deverá apresentar suas conclusões e recomendações nos próximos três dias."

# game/scripts/c24/c24.rpy:3452
translate brazilian c24s005_Ama_bb1971f7:

    # "tras lo cual se desarrollará la estructura final y el plan de implementación de la Beca NTR."
    "Na sequência, serão desenvolvidos a estrutura final e o plano de implementação da Bolsa NTR."

# game/scripts/c24/c24.rpy:3453
translate brazilian c24s005_Ama_0419c24d:

    # "Esta autorización entra en vigor inmediatamente y permanecerá vigente hasta la finalización del proyecto."
    "Esta autorização entra em vigor imediatamente e permanecerá em vigor até a conclusão do projeto."

# game/scripts/c24/c24.rpy:3454
translate brazilian c24s005_Ama_29859d0b:

    # "Firmado:"
    "Assinado:"

# game/scripts/c24/c24.rpy:3455
translate brazilian c24s005_Ama_31adcaef:

    # "[mc] Marks"
    "[mc] Marcas"

# game/scripts/c24/c24.rpy:3456
translate brazilian c24s005_Ama_eae190af:

    # "CEO de NTR"
    "CEO da NTR"

# game/scripts/c24/c24.rpy:3460
translate brazilian c24s005_Ama_220637b1:

    # mc "Esto es la creación de una beca hecha a medida para [sim]. 'Nadadores de Newport que han decidido abandonar la natación de competición y aspiran a convertirse en entrenadores'."
    mc "Trata-se da criação de uma bolsa de estudos feita sob medida para [sim]. 'Nadadores de Newport que decidiram deixar a natação competitiva e aspiram a se tornarem treinadores'."

# game/scripts/c24/c24.rpy:3461
translate brazilian c24s005_Ama_1856ed1b:

    # ama "He oído vuestra conversación en la piscina y he creído que, con todo el mal que ha hecho NTR, es hora de que haga algo bueno."
    ama "Ouvi a conversa de vocês na piscina e pensei que, com todo o mal que o NTR fez, já está na hora de ele fazer algo de bom."

# game/scripts/c24/c24.rpy:3462
translate brazilian c24s005_Ama_1fadd701:

    # mc "Pero puedes hacer esto sin mi autorización. Tú también eres accionista."
    mc "Mas você pode fazer isso sem a minha autorização. Você também é acionista."

# game/scripts/c24/c24.rpy:3464
translate brazilian c24s005_Ama_0434ed66:

    # ama "Todavía no tengo un cargo oficial en NTR, con lo que no puedo hacerlo. Tiene que ser todo legal si queremos que la empresa evolucione, [mc]."
    ama "Eu ainda não ocupo um cargo oficial na NTR, então não posso fazer isso. Tudo precisa estar dentro da lei para que a empresa evolua."

# game/scripts/c24/c24.rpy:3465
translate brazilian c24s005_Ama_2ae863ca:

    # ama "La estaba acabando de escribir en la furgoneta. De ahí los tachones."
    ama "Eu estava terminando de escrever isso na van. Por isso as palavras riscadas."

# game/scripts/c24/c24.rpy:3466
translate brazilian c24s005_Ama_42507974:

    # mc "*Risa* Le quitan un punto de oficialidad, pero supongo que es igual de legal."
    mc "*Risos* Eles retiram um ponto do status oficial, mas suponho que seja tão legal quanto."

# game/scripts/c24/c24.rpy:3467
translate brazilian c24s005_Ama_ade9dc87:

    # mc "Y tú vuelves a demostrar que eres una mujer increíble."
    mc "E você prova mais uma vez que é uma mulher incrível."

# game/scripts/c24/c24.rpy:3468
translate brazilian c24s005_Ama_88b0999c:

    # "Firmas el documento."
    "Você assina o documento."

# game/scripts/c24/c24.rpy:3470
translate brazilian c24s005_Ama_409b61d4:

    # ama "Gracias, pero no hay nada que no estuviera dispuesta a hacer por esta familia."
    ama "Obrigado, mas não há nada que eu não faria por esta família."

# game/scripts/c24/c24.rpy:3471
translate brazilian c24s005_Ama_8f570b82:

    # ama "Haga lo que haga, nunca os podré devolver lo que me estáis dando vosotros."
    ama "Independentemente do que eu faça, jamais conseguirei retribuir tudo o que você me dá."

# game/scripts/c24/c24.rpy:3472
translate brazilian c24s005_Ama_38dcce63:

    # mc "La familia no es un negocio, [ama]. No hay que pesar lo que se da o se recibe. Pero tú estás dando mucho."
    mc "Família não é um negócio. Você não deveria pesar o que dá ou recebe. Mas você está dando muito."

# game/scripts/c24/c24.rpy:3476
translate brazilian c24s005_Ama_f3231476:

    # ama "Y lo siguiente es lo que te vas a poner esta tarde."
    ama "E aqui está o que você vai vestir esta tarde."

# game/scripts/c24/c24.rpy:3477
translate brazilian c24s005_Ama_4a49ef0b:

    # mcp "(Como siempre, cambiando de tema en el momento en que alguien la alaba. Al menos esta vez sonríe.)"
    mcp "(Como sempre, ela muda de assunto no momento em que alguém a elogia. Pelo menos desta vez ela sorri.)"

# game/scripts/c24/c24.rpy:3478
translate brazilian c24s005_Ama_c607143e:

    # mc "¿Mis trajes no son adecuados para la reunión con Iron Fist?"
    mc "Meus trajes não são adequados para o encontro com o Punho de Ferro?"

# game/scripts/c24/c24.rpy:3480
translate brazilian c24s005_Ama_ce59d6cf:

    # ama "Sí, y ahora me darás uno. El que te pondrás esta noche."
    ama "Sim, e agora você vai me dar uma. Aquela que você vai usar esta noite."

# game/scripts/c24/c24.rpy:3481
translate brazilian c24s005_Ama_eb603de7:

    # mc "No lo entiendo. ¿Me traes un traje para la tarde y yo te doy uno para la noche? ¿Me voy a cambiar en el yate?"
    mc "Não entendi. Você me traz um terno para a tarde e eu te dou um para a noite? Vou ter que me trocar no iate?"

# game/scripts/c24/c24.rpy:3483
translate brazilian c24s005_Ama_92867519:

    # ama "¿No has hablado con [eva]?"
    ama "Você não falou com [eva]?"

# game/scripts/c24/c24.rpy:3484
translate brazilian c24s005_Ama_9e545ae0:

    # mc "Hoy no. ¿Por qué?"
    mc "Hoje não. Por quê?"

# game/scripts/c24/c24.rpy:3485
translate brazilian c24s005_Ama_1ac21101:

    # ama "Te tenía que haber llamado esta mañana."
    ama "Eu deveria ter te ligado hoje de manhã."

# game/scripts/c24/c24.rpy:3486
translate brazilian c24s005_Ama_38fa9700:

    # mc "He dormido hasta tarde y me quedé sin batería anoche. Lo he puesto a cargar cuando me he levantado. Ni siquiera lo he encendido aún."
    mc "Dormi até tarde e a bateria descarregou ontem à noite. Coloquei para carregar quando acordei. Nem sequer liguei ainda."

# game/scripts/c24/c24.rpy:3488
translate brazilian c24s005_Ama_7478643a:

    # ama "Eso lo explica todo."
    ama "Isso explica tudo."

# game/scripts/c24/c24.rpy:3489
translate brazilian c24s005_Ama_1b5b5f4b:

    # ama "Vas a hacer prácticas de tiro con [eva] antes de ir a la reunión. Dice que no has practicado más después del primer día en el bosque."
    ama "Você vai praticar tiro ao alvo com o dado de seis lados antes da reunião. Diz que você não pratica desde o primeiro dia na mata."

# game/scripts/c24/c24.rpy:3490
translate brazilian c24s005_Ama_e2d41494:

    # mc "¿Por eso habéis alquilado el campo de tiro?"
    mc "Foi por isso que você alugou o estande de tiro?"

# game/scripts/c24/c24.rpy:3492
translate brazilian c24s005_Ama_147bd032:

    # ama "Por eso, para enseñar a las chicas a disparar, y para que venga el helicóptero a buscarnos."
    ama "Por isso, para ensinar as meninas a atirar, e para que o helicóptero possa vir nos buscar."

# game/scripts/c24/c24.rpy:3495
translate brazilian c24s005_Ama_8c75a391:

    # ama "[eva] quería pasar un rato a solas contigo. Ella no lo llama cita sino entrenamiento."
    ama "[eva] Eu queria passar um tempo a sós com você. Ela não chama isso de encontro, mas de treinamento."

# game/scripts/c24/c24.rpy:3496
translate brazilian c24s005_Ama_26751aa9:

    # ama "Pero no lo dudes. Es una cita. Con armas en vez de con comida o vino."
    ama "Mas não se engane. É um encontro. Com armas em vez de comida ou vinho."

# game/scripts/c24/c24.rpy:3497
translate brazilian c24s005_Ama_6c430bd0:

    # mc "¿No crees que me lo debería haber preguntado antes a mí?"
    mc "Você não acha que ele deveria ter me perguntado primeiro?"

# game/scripts/c24/c24.rpy:3499
translate brazilian c24s005_Ama_e48042ab:

    # ama "*Risa* Si no te hubieras quedado sin batería o lo hubieras encendido..."
    ama "*Risos* Se ao menos a bateria não tivesse acabado ou se você tivesse ligado o aparelho..."

# game/scripts/c24/c24.rpy:3500
translate brazilian c24s005_Ama_3069ddbb:

    # mc "*Risa* Touché."
    mc "*Risos* Touché."

# game/scripts/c24/c24.rpy:3501
translate brazilian c24s005_Ama_28d7ea60:

    # mc "¿Qué tengo que ponerme para la cita?"
    mc "Que roupa devo usar para o encontro?"

# game/scripts/c24/c24.rpy:3503
translate brazilian c24s005_Ama_a580d8cf:

    # ama "Lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "O que tem na sacola? Vou te esperar lá fora enquanto você se troca."

# game/scripts/c24/c24.rpy:3505
translate brazilian c24s005_Ama_0ecf28f9:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Você sabe que não é necessário, né?"

# game/scripts/c24/c24.rpy:3507
translate brazilian c24s005_Ama_509365cd:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la cita con [eva]."
    ama "*Risos* Se você ficar nu na minha frente, você pode não conseguir ir ao encontro com [eva]."

# game/scripts/c24/c24.rpy:3508
translate brazilian c24s005_Ama_208599b9:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Risos* E ele provavelmente vai me fazer pagar por isso. Com muita dor. Enquanto eu durmo."

# game/scripts/c24/c24.rpy:3510
translate brazilian c24s005_Ama_e79e417a:

    # mc "OK. En dos minutos estaré vestido."
    mc "Certo. Estarei vestido em dois minutos."

# game/scripts/c24/c24.rpy:3514
translate brazilian c24s005_Ama_1bdbea1e:

    # ama "Ponte lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "Vista o que está na sacola. Vou esperar lá fora enquanto você se troca."

# game/scripts/c24/c24.rpy:3516
translate brazilian c24s005_Ama_0ecf28f9_1:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Você sabe que não é necessário, né?"

# game/scripts/c24/c24.rpy:3518
translate brazilian c24s005_Ama_047ab889:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la clase de tiro con [eva]."
    ama "*Risos* Se você ficar nu na minha frente, você pode não conseguir entrar na aula de tiro com [eva]."

# game/scripts/c24/c24.rpy:3519
translate brazilian c24s005_Ama_208599b9_1:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Risos* E ele provavelmente vai me fazer pagar por isso. Com muita dor. Enquanto eu durmo."

# game/scripts/c24/c24.rpy:3521
translate brazilian c24s005_Ama_e79e417a_1:

    # mc "OK. En dos minutos estaré vestido."
    mc "Certo. Estarei vestido em dois minutos."

# game/scripts/c24/c24.rpy:3523
translate brazilian c24s005_Ama_dda3e113:

    # ama "Saca el traje que te vas a poner para el yate."
    ama "Separe o terno que você vai usar no iate."

# game/scripts/c24/c24.rpy:3525
translate brazilian c24s005_Ama_0d0a47eb:

    # "Dos minutos después..."
    "Dois minutos depois..."

# game/scripts/c24/c24.rpy:3526
translate brazilian c24s005_Ama_1a08177b:

    # mc "[ama], ya estoy vestido. Aunque no entiendo para qué necesito esto..."
    mc "[ama], já estou vestido. Embora eu não entenda por que preciso disso..."

# game/scripts/c24/c24.rpy:3528
translate brazilian c24s005_Ama_cac620c4:

    # ama "*Risa* ¡Estás ridículo!"
    ama "*Risos* Você está ridículo!"

# game/scripts/c24/c24.rpy:3529
translate brazilian c24s005_Ama_b2246951:

    # mc "*Risa* Lo sé. Más que a practicar tiro, parece que voy a hacer una carrera en Laguna Seca."
    mc "*Risos* Eu sei. Parece mais que vou para uma corrida em Laguna Seca do que para treinar tiro."

# game/scripts/c24/c24.rpy:3532
translate brazilian c24s005_Ama_027cb8e1:

    # ama "*Risa* Bueno, esa es la otra parte de la cita con [eva]."
    ama "*Risos* Bem, essa é a outra parte do encontro com [eva]."

# game/scripts/c24/c24.rpy:3533
translate brazilian c24s005_Ama_736e1139:

    # ama "¿Has montado en moto alguna vez?"
    ama "Você já andou de moto?"

# game/scripts/c24/c24.rpy:3534
translate brazilian c24s005_Ama_cc761816:

    # mc "No..."
    mc "Não..."

# game/scripts/c24/c24.rpy:3536
translate brazilian c24s005_Ama_30e93606:

    # ama "Pues hoy va a ser tu primera vez. [eva] quería que fueras seguro. El traje lo ha elegido ella."
    ama "Bem, hoje será sua primeira vez. [eva] Eu queria que você tivesse certeza. Ela escolheu o terno."

# game/scripts/c24/c24.rpy:3537
translate brazilian c24s005_Ama_0d907c5a:

    # ama "Es uno de los trajes de skydiving de NTR. Era lo más adecuado que teníamos para ti."
    ama "É um dos trajes de paraquedismo da NTR. Era o melhor que tínhamos para você."

# game/scripts/c24/c24.rpy:3538
translate brazilian c24s005_Ama_4058bc50:

    # mc "¿No vamos a ir en la furgoneta al campo de tiro?"
    mc "Não vamos ao campo de tiro na van?"

# game/scripts/c24/c24.rpy:3540
translate brazilian c24s005_Ama_6c2bceab:

    # ama "No, te lleva [eva]. Yo me quedaré con [mar] y [nor], pasando la tarde hasta que se acerque la hora de que llegue el helicóptero."
    ama "Não, é preciso [eva]. Vou ficar com [mar] e [nor], passando a tarde até a chegada do helicóptero."

# game/scripts/c24/c24.rpy:3541
translate brazilian c24s005_Ama_5eda9e51:

    # mc "*Risa* Es decir, motos y armas. ¿Alguna cosa peligrosa más?"
    mc "*Risos* Quer dizer, motocicletas e armas. Tem mais alguma coisa perigosa?"

# game/scripts/c24/c24.rpy:3543
translate brazilian c24s005_Ama_e6a8262e:

    # ama "*Risa* [eva]."
    ama "*Risos* [eva]."

# game/scripts/c24/c24.rpy:3544
translate brazilian c24s005_Ama_a1e0e3b7:

    # mc "*Risa* No me da miedo. Seguramente porque no soy capaz de imaginar la mitad de las cosas que puede hacerme."
    mc "*Risos* Não estou com medo. Provavelmente porque nem consigo imaginar metade das coisas que ele poderia me fazer."

# game/scripts/c24/c24.rpy:3545
translate brazilian c24s005_Ama_4bcaaf83:

    # mc "Bueno, las armas tampoco después del primer entrenamiento. Y las motos..."
    mc "Bem, as armas também não eram boas depois da primeira sessão de treinamento. E as motocicletas..."

# game/scripts/c24/c24.rpy:3548
translate brazilian c24s005_Ama_e7521246:

    # "Suena una moto a toda velocidad por la carretera, todavía lejos."
    "O som de uma motocicleta em alta velocidade na estrada, ainda distante, pode ser ouvido."

# game/scripts/c24/c24.rpy:3549
translate brazilian c24s005_Ama_c629957a:

    # ama "Creo que la tuya está llegando."
    ama "Acho que o seu está a caminho."

# game/scripts/c24/c24.rpy:3550
translate brazilian c24s005_Ama_83b2b023:

    # mc "Te veo luego, entonces."
    mc "Até logo, então."

# game/scripts/c24/c24.rpy:3551
translate brazilian c24s005_Ama_162ef4fb:

    # ama "Sí, cuando falten 20 minutos para que llegue el helicóptero, iré al campo de tiro. Así tienes tiempo de cambiarte."
    ama "Sim, quando faltarem 20 minutos para o helicóptero chegar, irei ao estande de tiro. Assim você terá tempo para se trocar."

# game/scripts/c24/c24.rpy:3554
translate brazilian c24s005_Ama_18f5f726:

    # "[ama] se despide de ti con otro tierno beso."
    "[ama] se despede de você com outro beijo carinhoso."

# game/scripts/c24/c24.rpy:3555
translate brazilian c24s005_Ama_689458b3:

    # ama "Te veo luego."
    ama "Até mais."

# game/scripts/c24/c24.rpy:3558
translate brazilian c24s005_Ama_5b63b58c:

    # "Mientras bajas las escaleras, enciendes el móvil. Tienes 32 llamadas perdidas de [eva]. Y 24 mensajes de texto."
    "Ao descer as escadas, você liga o celular. Você tem 32 chamadas perdidas de [eva]. E 24 mensagens de texto."

# game/scripts/c24/c24.rpy:3565
translate brazilian c24s005_Eva_5f0fa22f:

    # "Al salir a la calle, [eva] ya te está esperando."
    "Quando você sair, [eva] já estará esperando por você."

# game/scripts/c24/c24.rpy:3566
translate brazilian c24s005_Eva_3b8ddfb4:

    # mc "Hola, [eva]."
    mc "Olá, [eva]."

# game/scripts/c24/c24.rpy:3569
translate brazilian c24s005_Eva_6f818418:

    # "[eva] salta a tus brazos buscando tus labios. Hace días que no os habéis besado."
    "[eva] pula em seus braços, procurando seus lábios. Faz dias desde o último beijo."

# game/scripts/c24/c24.rpy:3571
translate brazilian c24s005_Eva_6c435b77:

    # eva "Hola, [mc]. ¿Preparado para el entrenamiento?"
    eva "Olá, [mc]. Pronto para o treinamento?"

# game/scripts/c24/c24.rpy:3572
translate brazilian c24s005_Eva_e69ff49e:

    # mc "*Risa* Para el entrenamiento sí. Para la moto no tanto."
    mc "*Risos* Para treinar, sim. Para andar de bicicleta, nem tanto."

# game/scripts/c24/c24.rpy:3575
translate brazilian c24s005_Eva_0d100dc8:

    # "[eva] te pega un puñetazo en el hombro. No es un puñetazo suave. Los matones del colegio te pegaban más flojo."
    "[eva] te dá um soco no ombro. Não é um soco leve. Os valentões da escola batem mais suavemente."

# game/scripts/c24/c24.rpy:3576
translate brazilian c24s005_Eva_eb7708ca:

    # mc "¡Ouch! ¿A qué ha venido eso?"
    mc "Ai! O que foi isso?"

# game/scripts/c24/c24.rpy:3577
translate brazilian c24s005_Eva_81215681:

    # eva "A que así aprenderás a responder a mis llamadas."
    eva "Assim você aprenderá a atender minhas ligações."

# game/scripts/c24/c24.rpy:3578
translate brazilian c24s005_Eva_6b7cc6ac:

    # mc "¡Me quedé sin batería y no me he acordado de encenderlo hasta hace un momento!"
    mc "A bateria descarregou e eu só me lembrei de ligá-la agora há pouco!"

# game/scripts/c24/c24.rpy:3580
translate brazilian c24s005_Eva_4f44b872:

    # eva "Seguro que no se te vuelve a olvidar."
    eva "Tenho certeza de que você não se esquecerá disso novamente."

# game/scripts/c24/c24.rpy:3582
translate brazilian c24s005_Eva_37099f52:

    # eva "¿Has montado alguna vez en moto?"
    eva "Você já andou de moto?"

# game/scripts/c24/c24.rpy:3583
translate brazilian c24s005_Eva_ce0ec26c:

    # mc "No... ¿Hay algo que deba saber?"
    mc "Não... Há algo que eu deva saber?"

# game/scripts/c24/c24.rpy:3584
translate brazilian c24s005_Eva_cb9f023f:

    # eva "Tan solo agárrate fuerte a mí e intenta no moverte demasiado. Actúa como si fueras mi mochila."
    eva "Apenas se agarre a mim com firmeza e tente não se mexer muito. Aja como se você fosse minha mochila."

# game/scripts/c24/c24.rpy:3586
translate brazilian c24s005_Eva_45865617:

    # eva "*Risa* Y no grites ni llores en las curvas."
    eva "*Risos* E não grite nem chore nas curvas."

# game/scripts/c24/c24.rpy:3587
translate brazilian c24s005_Eva_6a83a2b3:

    # mc "*Risa* Lo intentaré, pero no prometo nada."
    mc "*Risos* Vou tentar, mas não prometo nada."

# game/scripts/c24/c24.rpy:3588
translate brazilian c24s005_Eva_0619b416:

    # mc "*Risa* ¿En las rectas puedo llorar?"
    mc "*Risos* Posso chorar nos momentos de tensão?"

# game/scripts/c24/c24.rpy:3590
translate brazilian c24s005_Eva_c5e1570a:

    # eva "*Risa* Puedes hacerlo, pero no te voy a oír ni voy a parar."
    eva "*Risos* Você pode fazer isso, mas eu não vou te ouvir e não vou te impedir."

# game/scripts/c24/c24.rpy:3593
translate brazilian c24s005_Eva_8e46c040:

    # eva "¡Sube en la moto!"
    eva "Suba na motocicleta!"

# game/scripts/c24/c24.rpy:3600
translate brazilian c24s005_Eva_2ad01fba:

    # "[eva] arranca para llevarte a la cita más extraña de tu vida."
    "[eva] começa a te levar para o encontro mais estranho da sua vida."

# game/scripts/c24/c24.rpy:3602
translate brazilian c24s005_Eva_08fe7d89:

    # "[eva] arranca para llevarte al entrenamiento más extraño de tu vida."
    "[eva] começa a te levar para o treino mais estranho da sua vida."

# game/scripts/c24/c24.rpy:3603
translate brazilian c24s005_Eva_257de6ea:

    # "Consigues no gritar en la primera curva pese al frenazo de [eva]. Te comportas como una buena mochila."
    "Você consegue não gritar na primeira curva apesar da forte frenagem em [eva]. Você se comporta como uma boa mochila."

