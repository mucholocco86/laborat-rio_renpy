translate brazilian c24s002_BetNoNun_963f1ff6:

    # mc "Si no acepta los conventos también la expulsarán, con lo que nada evita que vayamos a la prensa."
    mc "Se ela se recusar a entrar nos conventos, eles a expulsarão, então nada nos impede de recorrer à imprensa."

# game/scripts/c24/c24.rpy:1140
translate brazilian c24s002_BetNoNun_7b4c3d17:

    # bet "[mc], déjalo. La decisión ya estaba tomada."
    bet "[mc], deixe para lá. A decisão já havia sido tomada."

# game/scripts/c24/c24.rpy:1141
translate brazilian c24s002_BetNoNun_cd05795e:

    # mc "Déjame un momento, por favor."
    mc "Só me dê um momento, por favor."

# game/scripts/c24/c24.rpy:1143
translate brazilian c24s002_BetNoNun_0733a41f:

    # mc "Entonces, una pequeña indemnización por los años de servicio sería lo idóneo y lo justo, ¿no?"
    mc "Então, uma pequena compensação por anos de serviço seria ideal e justa, não seria?"

# game/scripts/c24/c24.rpy:1144
translate brazilian c24s002_BetNoNun_38e5141f:

    # "Segismund" "Eso no se ha hecho nunca. Sentaría un precedente."
    "Segismund" "Isso nunca foi feito antes. Criaria um precedente."

# game/scripts/c24/c24.rpy:1145
translate brazilian c24s002_BetNoNun_beaa8c9e:

    # mc "Mire, no le estoy diciendo que compre nuestro silencio. Eso sería chantaje. Solo le estoy pidiendo lo que es justo para mi tía."
    mc "Olha, eu não estou pedindo que você compre nosso silêncio. Isso seria chantagem. Estou apenas pedindo o que é justo para minha tia."

# game/scripts/c24/c24.rpy:1146
translate brazilian c24s002_BetNoNun_8be17c10:

    # mc "Ustedes la expulsan y ella tiene que empezar una vida nueva después de 40 años de servicio sin tener un dólar ahorrado."
    mc "Você a demite e ela tem que começar uma nova vida depois de 40 anos de serviço sem ter economizado um único dólar."

# game/scripts/c24/c24.rpy:1147
translate brazilian c24s002_BetNoNun_271ef249:

    # mc "No es justo, ¿no?"
    mc "Não é justo, não é?"

# game/scripts/c24/c24.rpy:1149
translate brazilian c24s002_BetNoNun_ca634ae9:

    # "Segismund" "No... pero... es legal."
    "Segismund" "Não... mas... é legal."

# game/scripts/c24/c24.rpy:1150
translate brazilian c24s002_BetNoNun_1abd3170:

    # mc "También es legal ir a la prensa a explicar la situación."
    mc "Também é legal recorrer à imprensa para explicar a situação."

# game/scripts/c24/c24.rpy:1151
translate brazilian c24s002_BetNoNun_eb986132:

    # mc "Podrán comprobar como descienden las donaciones cuando se descubra cómo trata esta diócesis a personas que han trabajado 40 años para la Iglesia."
    mc "Vocês verão como as doações diminuem quando se descobrir como esta diocese trata as pessoas que trabalharam para a Igreja por 40 anos."

# game/scripts/c24/c24.rpy:1153
translate brazilian c24s002_BetNoNun_435cc83a:

    # bet "¿Qué haces, [mc]?"
    bet "O que você está fazendo, [mc]?"

# game/scripts/c24/c24.rpy:1154
translate brazilian c24s002_BetNoNun_66fdf6fa:

    # mc "Tratar a la Iglesia como te ha intentado tratar a ti."
    mc "Trate a Igreja da mesma forma que ela tentou tratar você."

# game/scripts/c24/c24.rpy:1155
translate brazilian c24s002_BetNoNun_5210031e:

    # mc "Si ellos pueden usar sus armas, nosotros podemos usar las nuestras."
    mc "Se eles podem usar as armas deles, nós podemos usar as nossas."

# game/scripts/c24/c24.rpy:1156
translate brazilian c24s002_BetNoNun_e157e17d:

    # mc "Supongo que no habían pensado que pudieras tener un sobrino abogado laboralista."
    mc "Acho que eles não tinham imaginado que você pudesse ter um sobrinho que fosse advogado trabalhista."

# game/scripts/c24/c24.rpy:1158
translate brazilian c24s002_BetNoNun_3b973a9c:

    # "Segismund" "¿Abogado laboralista? Entonces, ¿qué propone?"
    "Segismund" "Um advogado trabalhista? Então, o que ele propõe?"

# game/scripts/c24/c24.rpy:1159
translate brazilian c24s002_BetNoNun_0a5736cf:

    # mc "Una pequeña indemnización por cada año trabajado."
    mc "Uma pequena compensação por cada ano trabalhado."

# game/scripts/c24/c24.rpy:1160
translate brazilian c24s002_BetNoNun_3cf6aad0:

    # mc "No le estoy pidiendo que lo haga teniendo en cuenta el sueldo de un cirujano con los años de experiencia de mi tía."
    mc "Não estou pedindo que ela faça isso levando em consideração o salário de um cirurgião com os anos de experiência da minha tia."

# game/scripts/c24/c24.rpy:1161
translate brazilian c24s002_BetNoNun_97335d6b:

    # mc "Puede usar su sueldo actual como referencia. Nos conformamos con 30 días de indemnización por año trabajado."
    mc "Você pode usar seu salário atual como referência. Estamos satisfeitos com uma indenização equivalente a 30 dias de salário por ano de serviço."

# game/scripts/c24/c24.rpy:1162
translate brazilian c24s002_BetNoNun_6f19be5d:

    # mc "No sé si, en alguno de los países en los que ha trabajado, la indemnización puede llegar a los 40 días por año trabajado. Lo tendría que mirar."
    mc "Não sei se, em algum dos países onde ele trabalhou, a indenização por rescisão de contrato pode chegar a 40 dias por ano de serviço. Teria que verificar."

# game/scripts/c24/c24.rpy:1164
translate brazilian c24s002_BetNoNun_56cc5e5f:

    # "Segismund" "¡Eso sería mucho dinero! La Iglesia..."
    "Segismund" "Isso seria muito dinheiro! A Igreja..."

# game/scripts/c24/c24.rpy:1165
translate brazilian c24s002_BetNoNun_344c5410:

    # mc "La Iglesia va a perder mucho más en donaciones si esto sale en la prensa."
    mc "A Igreja perderá muito mais em doações se isso for divulgado na imprensa."

# game/scripts/c24/c24.rpy:1166
translate brazilian c24s002_BetNoNun_b220ae06:

    # mc "Son poco más de tres años de sueldo de una monja. Lo acabo de calcular."
    mc "Isso equivale a pouco mais de três anos de salário de uma freira. Acabei de calcular."

# game/scripts/c24/c24.rpy:1168
translate brazilian c24s002_BetNoNun_d5a797ff:

    # "Segismund" "No puedo autorizar eso. No tengo poder para ello."
    "Segismund" "Não posso autorizar isso. Não tenho poderes para tal."

# game/scripts/c24/c24.rpy:1169
translate brazilian c24s002_BetNoNun_7e4db1e6:

    # "Segismund" "¿Podrían volver en un mes y les hacemos una propuesta?"
    "Segismund" "Você poderia voltar daqui a um mês e nós lhe faremos uma proposta?"

# game/scripts/c24/c24.rpy:1170
translate brazilian c24s002_BetNoNun_fca52711:

    # mc "No."
    mc "Não."

# game/scripts/c24/c24.rpy:1172
translate brazilian c24s002_BetNoNun_d31c8329:

    # bet "¿No?"
    bet "Não?"

# game/scripts/c24/c24.rpy:1173
translate brazilian c24s002_BetNoNun_51d522b1:

    # mc "No, Tía [bet]. En un mes estaré fuera del país, y no quiero que te intenten estafar."
    mc "Não, tia [bet]. Vou estar fora do país daqui a um mês e não quero que você seja enganada."

# game/scripts/c24/c24.rpy:1175
translate brazilian c24s002_BetNoNun_29eb690c:

    # mc "Dice que no tiene poder para tomar esa decisión. Consúltelo con quién lo tenga que consultar y volveremos en tres horas."
    mc "Ele diz que não tem autoridade para tomar essa decisão. Consulte quem você precisar e voltaremos em três horas."

# game/scripts/c24/c24.rpy:1176
translate brazilian c24s002_BetNoNun_cd0aa0e1:

    # "Segismund" "¿Tres horas? No sé si tendré tiempo de..."
    "Segismund" "Três horas? Não sei se terei tempo para..."

# game/scripts/c24/c24.rpy:1177
translate brazilian c24s002_BetNoNun_a3d0111e:

    # mc "Si en tres horas no tiene una propuesta, en tres días aparecerá en prensa nuestra versión de los hechos."
    mc "Se vocês não tiverem uma proposta em três horas, nossa versão dos fatos será publicada na imprensa em três dias."

# game/scripts/c24/c24.rpy:1178
translate brazilian c24s002_BetNoNun_6fc27c56:

    # mc "Para que no puedan adelantarse y mentir, publicaré ahora mismo un twirp indicando el inicio de la historia."
    mc "Para que eles não se precipitem e mintam, vou postar um tweet agora mesmo indicando o início da história."

# game/scripts/c24/c24.rpy:1179
translate brazilian c24s002_BetNoNun_5eb435dd:

    # mc "Deme un segundo."
    mc "Só me dê um segundo."

# game/scripts/c24/c24.rpy:1181
translate brazilian c24s002_BetNoNun_60f8d2ab:

    # "Después de publicar el twirp..."
    "Depois de postar o tweet..."

# game/scripts/c24/c24.rpy:1182
translate brazilian c24s002_BetNoNun_ec06f76b:

    # mc "Ya está hecho. La historia de una monja maltratada y chantajeada por la iglesia. En tres días sabrán toda la verdad."
    mc "Está feito. A história de uma freira maltratada e chantageada pela Igreja. Em três dias, toda a verdade será revelada."

# game/scripts/c24/c24.rpy:1183
translate brazilian c24s002_BetNoNun_0dee7c33:

    # mc "Nos vemos en tres horas. Tic-tac."
    mc "Te vejo em três horas. Tic-tac."

# game/scripts/c24/c24.rpy:1185
translate brazilian c24s002_BetNoNun_ae9f9ed3:

    # mc "¿Nos vamos, Tía [bet]?"
    mc "Vamos, tia [bet]?"

# game/scripts/c24/c24.rpy:1186
translate brazilian c24s002_BetNoNun_24af5e07:

    # bet "Sí, vámonos. Creo que el Padre Segismund tiene unas llamadas que hacer."
    bet "Sim, vamos. Acho que o padre Segismund tem algumas ligações para fazer."

# game/scripts/c24/c24.rpy:1189
translate brazilian c24s002_BetNoNun_825c2221:

    # "Al salir del edificio de la Iglesia..."
    "Ao sair do prédio da igreja..."

# game/scripts/c24/c24.rpy:1191
translate brazilian c24s002_BetNoNun_eccb5103:

    # bet "¿Qué has hecho? Ya habíamos hablado de que venía a informarles de que dejaba de ser monja."
    bet "O que você fez? Já tínhamos combinado que eu viria lhe informar que estava deixando o convento."

# game/scripts/c24/c24.rpy:1192
translate brazilian c24s002_BetNoNun_5530c9aa:

    # mc "Vas a dejar de ser monja igualmente, no te van a permitir seguir en la Iglesia y moverte libremente. Pero te irás con los bolsillos llenos."
    mc "Você ainda deixará de ser freira; não poderão mais permitir que você permaneça na Igreja e circule livremente. Mas você sairá de lá com os bolsos cheios."

# game/scripts/c24/c24.rpy:1193
translate brazilian c24s002_BetNoNun_5c16c34c:

    # mc "Podrás pagar la certificación y ayudar a Meemaw con su nueva casa, tal como queréis las dos."
    mc "Você pode pagar pela certificação e ajudar a vovó com a nova casa dela, do jeito que vocês dois querem."

# game/scripts/c24/c24.rpy:1195
translate brazilian c24s002_BetNoNun_f72c981a:

    # bet "*Risa* Tienes razón. No se me hubiera ocurrido nunca."
    bet "*Risos* Você tem razão. Eu nunca teria pensado nisso."

# game/scripts/c24/c24.rpy:1196
translate brazilian c24s002_BetNoNun_7a807ac2:

    # mc "*Risa* Para eso me tienes a mí."
    mc "*Risos* É para isso que estou aqui."

# game/scripts/c24/c24.rpy:1198
translate brazilian c24s002_BetNoNun_89b009df:

    # bet "Por cierto, creía que no mentías nunca."
    bet "Aliás, pensei que você nunca mentisse."

# game/scripts/c24/c24.rpy:1199
translate brazilian c24s002_BetNoNun_4190fe76:

    # mc "Y no he mentido."
    mc "E eu não menti."

# game/scripts/c24/c24.rpy:1200
translate brazilian c24s002_BetNoNun_277eb0a0:

    # bet "¿Abogado laboralista? ¿Desde cuándo eres abogado?"
    bet "Advogado trabalhista? Há quanto tempo você exerce a advocacia?"

# game/scripts/c24/c24.rpy:1201
translate brazilian c24s002_BetNoNun_1502332f:

    # mc "Yo no he dicho que lo fuera. He dicho que ellos no podían imaginar que tuvieras un sobrino que lo fuera."
    mc "Eu não disse que ele era. Eu disse que eles não conseguiam imaginar você tendo um sobrinho que fosse."

# game/scripts/c24/c24.rpy:1202
translate brazilian c24s002_BetNoNun_5c2166f5:

    # mc "Yo tampoco. *Risa* Porque no lo tienes."
    mc "Nem eu. *Risos* Porque você não tem."

# game/scripts/c24/c24.rpy:1204
translate brazilian c24s002_BetNoNun_b6d42a34:

    # bet "¿Y lo de las indemnizaciones de 40 días en los países en los que he trabajado?"
    bet "E quanto à indenização de 40 dias nos países onde trabalhei?"

# game/scripts/c24/c24.rpy:1205
translate brazilian c24s002_BetNoNun_57b7c2d1:

    # mc "He dicho que no sabía si alguno de esos países tenía 40 días de indemnización. *Risa*"
    mc "Eu disse que não sabia se algum desses países oferecia 40 dias de indenização. *Risos*"

# game/scripts/c24/c24.rpy:1206
translate brazilian c24s002_BetNoNun_2a5f9b56:

    # mc "He pedido 30 días esperando que nos den 15. Lo de los 40 días de indemnización lo he dicho para ponerlo nervioso."
    mc "Pedi 30 dias na esperança de que nos dessem 15. Mencionei os 40 dias de compensação apenas para deixá-lo nervoso."

# game/scripts/c24/c24.rpy:1207
translate brazilian c24s002_BetNoNun_ee19411c:

    # mc "Tanto él como tú habéis entendido lo que habéis creído oír, pero que yo no he dicho. *Risa* No hay una sola mentira en lo que he dicho."
    mc "Você e ele entenderam o que pensaram ter ouvido, mas que eu não disse. *Risos* Não há uma única mentira no que eu disse."

# game/scripts/c24/c24.rpy:1209
translate brazilian c24s002_BetNoNun_7af3c1c9:

    # bet "*Risa* A partir de ahora tendré que analizar todo lo que digas."
    bet "*Risos* De agora em diante, terei que analisar tudo o que você disser."

# game/scripts/c24/c24.rpy:1210
translate brazilian c24s002_BetNoNun_538d6a77:

    # mc "No hace falta. Esos trucos solo los uso con gente de fuera de la familia."
    mc "Não precisa. Eu só uso esses truques com pessoas de fora da família."

# game/scripts/c24/c24.rpy:1211
translate brazilian c24s002_BetNoNun_87171caa:

    # mc "Con la familia tendrían un recorrido muy corto."
    mc "Com a família, a viagem seria muito curta."

# game/scripts/c24/c24.rpy:1212
translate brazilian c24s002_BetNoNun_a08b775d:

    # mc "¿Vamos a buscar a [emm]? Tenemos tres horas para hacer turismo antes de tener que volver."
    mc "Vamos procurar [emm]? Temos três horas para passear antes de termos que voltar."

# game/scripts/c24/c24.rpy:1214
translate brazilian c24s002_BetNoNun_c73d7a39:

    # bet "Eso es otra cosa que no he entendido. ¿Por qué tres horas y no dos o cinco?"
    bet "Outra coisa que não entendo é: por que três horas e não duas ou cinco?"

# game/scripts/c24/c24.rpy:1215
translate brazilian c24s002_BetNoNun_5ae5607f:

    # mc "Sonaba bien lo de tres horas para arreglarlo o tres días para publicarlo."
    mc "Três horas para corrigir ou três dias para publicar parecia uma boa ideia."

# game/scripts/c24/c24.rpy:1216
translate brazilian c24s002_BetNoNun_e04d2764:

    # mc "Hoy es viernes, con el fin de semana por en medio, se publicaría el lunes. No tenían mucho tiempo para reaccionar."
    mc "Hoje é sexta-feira e, com o fim de semana no meio, a notícia seria publicada na segunda-feira. Eles não tiveram muito tempo para reagir."

# game/scripts/c24/c24.rpy:1217
translate brazilian c24s002_BetNoNun_3f06bdb9:

    # mc "Además, a ese pobre hombre se le veía muy agobiado, como si no supiera de dónde le venían los golpes."
    mc "Além disso, aquele pobre homem parecia muito aflito, como se não soubesse de onde vinham os golpes."

# game/scripts/c24/c24.rpy:1218
translate brazilian c24s002_BetNoNun_0b5eb55b:

    # mc "Y lo del twirp ha sido lo que ha acabado de descolocarlo. Por suerte solo me sigue Jamaal en Twirper."
    mc "E o lance do Twirper foi o que realmente o desconcentrou. Por sorte, só o Jamaal me segue no Twirper."

# game/scripts/c24/c24.rpy:1220
translate brazilian c24s002_BetNoNun_e573a454:

    # bet "*Risa* ¿Y todo eso lo has pensado en un minuto?"
    bet "*Risos* E você pensou em tudo isso em um minuto?"

# game/scripts/c24/c24.rpy:1221
translate brazilian c24s002_BetNoNun_ba1d33a2:

    # mc "No, ayer estuve pensando en diferentes escenarios, pero hasta que no ha dicho lo de la expulsión no he atado cabos."
    mc "Não, ontem eu estava pensando em diferentes cenários, mas até ele mencionar a expulsão eu não tinha me dado conta."

# game/scripts/c24/c24.rpy:1222
translate brazilian c24s002_BetNoNun_27ccb0ee:

    # mc "En mi mente expulsión y despido venía a ser lo mismo, y he ido planeando cosas mientras hablaba."
    mc "Na minha cabeça, expulsão e demissão eram essencialmente a mesma coisa, e eu já estava planejando coisas enquanto falava."

# game/scripts/c24/c24.rpy:1224
translate brazilian c24s002_BetNoNun_4cfa58a6:

    # bet "Pero les estás haciendo chantaje con lo de ir a la prensa. Podríamos acabar en la cárcel."
    bet "Mas você está chantageando-os ao ameaçar ir à imprensa. Podemos acabar na cadeia."

# game/scripts/c24/c24.rpy:1225
translate brazilian c24s002_BetNoNun_a710e820:

    # mc "No, no les estoy chantajeando. Son ellos los que intentaron chantajearte a ti diciendo que si ibas a la prensa retiraban su oferta."
    mc "Não, eu não estou chantageando eles. Foram eles que tentaram chantageá-lo, dizendo que se você fosse à imprensa, eles retirariam a oferta."

# game/scripts/c24/c24.rpy:1226
translate brazilian c24s002_BetNoNun_ca7e35a8:

    # mc "Yo tan solo les he dicho que pueden retirar la oferta porque vamos a ir a la prensa igualmente."
    mc "Eu simplesmente disse a eles que podiam retirar a oferta, pois de qualquer forma iríamos à imprensa."

# game/scripts/c24/c24.rpy:1227
translate brazilian c24s002_BetNoNun_35aa0b2b:

    # mc "Si no quieren prensa, queremos un trato justo. Tan solo estamos rechazando su chantaje."
    mc "Se eles não querem cobertura da imprensa, nós queremos um tratamento justo. Estamos simplesmente rejeitando a chantagem deles."

# game/scripts/c24/c24.rpy:1229
translate brazilian c24s002_BetNoNun_a06661e2:

    # bet "Y si intentaran denunciarnos, tendrían que reconocer que estaban intentando chantajearme."
    bet "E se eles tentassem nos processar, teriam que admitir que estavam tentando me chantagear."

# game/scripts/c24/c24.rpy:1230
translate brazilian c24s002_BetNoNun_a82b70fa:

    # mc "Exacto. No soy abogado, pero el cura tampoco lo es. El sentido común es lo que me dice, y supongo que a él también."
    mc "Exatamente. Eu não sou advogado, mas o padre também não é. O bom senso me diz isso, e suponho que diga o mesmo a ele."

# game/scripts/c24/c24.rpy:1231
translate brazilian c24s002_BetNoNun_4c6701dc:

    # mc "Por eso le he dado poco tiempo para decidir. No va a poder consultar con mucha gente."
    mc "Por isso, dei-lhe pouco tempo para decidir. Ele não poderá consultar muitas pessoas."

# game/scripts/c24/c24.rpy:1233
translate brazilian c24s002_BetNoNun_c944ee30:

    # bet "*Risa* Espero no tenerte nunca de enemigo."
    bet "*Risos* Espero nunca ter você como inimigo."

# game/scripts/c24/c24.rpy:1234
translate brazilian c24s002_BetNoNun_b446b678:

    # mc "No deberías temerme a mí. *Risa* [ama] y [eva] te deberían preocupar más. Especialmente si no tienes un rodillo a mano."
    mc "Você não deveria ter medo de mim. *Risos* [ama] e [eva] deveriam te preocupar mais. Principalmente se você não tiver um rolo de massa à mão."

# game/scripts/c24/c24.rpy:1235
translate brazilian c24s002_BetNoNun_2f33abec:

    # mc "Vamos a buscar a [emm] y a hacer un poco de turismo. Solo tenemos tres horas."
    mc "Vamos encontrar [emm] e fazer um pouco de turismo. Só temos três horas."

# game/scripts/c24/c24.rpy:1237
translate brazilian c24s002_BetNoNun_3e3e712e:

    # "Pasáis a buscar a [emm] por la heladería y le explicáis el resultado de la reunión."
    "Você pega [emm] na sorveteria e explica o resultado da reunião para ele."

# game/scripts/c24/c24.rpy:1238
translate brazilian c24s002_BetNoNun_eb17b87f:

    # emm "Menos mal que no he ido."
    emm "Ainda bem que não fui."

# game/scripts/c24/c24.rpy:1239
translate brazilian c24s002_BetNoNun_b3961c59:

    # mc "¿Por qué?"
    mc "Porque?"

# game/scripts/c24/c24.rpy:1240
translate brazilian c24s002_BetNoNun_b2a91863:

    # emm "Lo primero que le hubiera dicho al cura hubiese sido 'Mi tía os abandona, gilipollas. Vosotros os lo perdéis.'"
    emm "A primeira coisa que eu teria dito ao padre seria: 'Minha tia está deixando vocês, seus idiotas. Vocês é que vão perder tudo.'"

# game/scripts/c24/c24.rpy:1241
translate brazilian c24s002_BetNoNun_7ae3d058:

    # emm "Y no hubiera habido indemnización. *Risa* Además, no se me hubiera ocurrido nunca."
    emm "E não haveria nenhuma compensação. *Risos* Além disso, isso nunca me ocorreria."

# game/scripts/c24/c24.rpy:1243
translate brazilian c24s002_BetNoNun_7d2c8bc1:

    # bet "A mí tampoco. Pero [mc] ha pensado muy rápido y no ha dejado un segundo para que el Padre Segismund pudiera pararse a pensar."
    bet "Nem eu. Mas [mc] pensou muito rápido e não deu ao Padre Segismund um segundo para parar e pensar."

# game/scripts/c24/c24.rpy:1244
translate brazilian c24s002_BetNoNun_8c2de467:

    # mc "Bueno, es una de las técnicas de negociación que me enseñaron en la universidad."
    mc "Bem, essa é uma das técnicas de negociação que me ensinaram na universidade."

# game/scripts/c24/c24.rpy:1245
translate brazilian c24s002_BetNoNun_74514363:

    # mc "No la recomiendan por ser demasiado agresiva, y normalmente la gente tiene tiempo para pensar después, con lo que se dan cuenta de los fallos que haya cometido."
    mc "Não é recomendável porque é muito agressivo, e as pessoas geralmente têm tempo para refletir depois, percebendo assim os erros que possam ter cometido."

# game/scripts/c24/c24.rpy:1247
translate brazilian c24s002_BetNoNun_54844984:

    # emm "Lo importante es que está resuelto... a medias."
    emm "O importante é que está resolvido... mais ou menos."

# game/scripts/c24/c24.rpy:1248
translate brazilian c24s002_BetNoNun_42ea4e89:

    # emm "¿Preparados para que os haga de guía turístico de Monterey?"
    emm "Pronto para que eu seja seu guia turístico em Monterey?"

# game/scripts/c24/c24.rpy:1249
translate brazilian c24s002_BetNoNun_377e71a0:

    # mc "No sabía que habías estado aquí antes."
    mc "Eu não sabia que você já tinha estado aqui antes."

# game/scripts/c24/c24.rpy:1251
translate brazilian c24s002_BetNoNun_eddf0b65:

    # emm "No he estado nunca, pero he tenido tiempo de mirarme unas guías por internet mientras esperaba."
    emm "Nunca fui, mas tive tempo de consultar alguns guias online enquanto esperava."

# game/scripts/c24/c24.rpy:1253
translate brazilian c24s002_BetNoNun_5e38cf5d:

    # emm "Y anoche, mientras alguien hacía otras cosas más divertidas."
    emm "E ontem à noite, enquanto alguém estava fazendo outras coisas, mais divertidas."

# game/scripts/c24/c24.rpy:1254
translate brazilian c24s002_BetNoNun_ea8e8ae5:

    # mc "*Risa* Es un buen entrenamiento para ti. Querías ser fotógrafa de guías de viaje."
    mc "*Risos* É um bom treinamento para você. Você queria ser fotógrafo de guia de viagens."

# game/scripts/c24/c24.rpy:1256
translate brazilian c24s002_BetNoNun_aa056308:

    # bet "Nunca me has dicho como [eri] y tú decidisteis que vuestro sueño era algo tan específico y que coincidieseis en lo que queríais ser."
    bet "Você nunca me disse como [eri] e você decidiu que seu sonho era algo tão específico e que você concordou com o que queria ser."

# game/scripts/c24/c24.rpy:1258
translate brazilian c24s002_BetNoNun_061db69d:

    # emm "Encontramos unas guías de Europa en la biblioteca del instituto, de esas viejas, en papel."
    emm "Encontramos alguns guias antigos de viagem pela Europa em papel na biblioteca da escola."

# game/scripts/c24/c24.rpy:1259
translate brazilian c24s002_BetNoNun_5d5079a9:

    # emm "Venecia, París, Roma, Barcelona, Atenas..."
    emm "Veneza, Paris, Roma, Barcelona, Atenas..."

# game/scripts/c24/c24.rpy:1260
translate brazilian c24s002_BetNoNun_863ae883:

    # emm "Decidimos que queríamos conocer todas esas ciudades. *Risa* Y que no había mejor forma de hacerlo que si nos pagaban."
    emm "Decidimos que queríamos visitar todas essas cidades. *Risos* E que não havia maneira melhor de fazer isso do que se fôssemos pagos para isso."

# game/scripts/c24/c24.rpy:1261
translate brazilian c24s002_BetNoNun_45cf909a:

    # mc "El plan se le ocurrió a [eri], ¿no?"
    mc "O plano foi ideia do [eri], não foi?"

# game/scripts/c24/c24.rpy:1263
translate brazilian c24s002_BetNoNun_6f9ba524:

    # emm "¿Qué insinúas con eso? ¿Que mis planes no son realistas?"
    emm "O que você está insinuando? Que meus planos são irrealistas?"

# game/scripts/c24/c24.rpy:1265
translate brazilian c24s002_BetNoNun_e228ff71:

    # emm "El de anoche funcionó."
    emm "A de ontem à noite funcionou."

# game/scripts/c24/c24.rpy:1266
translate brazilian c24s002_BetNoNun_b84309d8:

    # mc "Pero se le ocurrió a [eri], ¿verdad?"
    mc "Mas foi ideia do [eri], certo?"

# game/scripts/c24/c24.rpy:1268
translate brazilian c24s002_BetNoNun_08debe65:

    # emm "Sí. *Risa* Y vámonos a visitar Monterey o al final no podré enseñaros los sitios que he descubierto."
    emm "Sim. *Risos* E vamos visitar Monterey, senão não vou poder te mostrar os lugares que descobri."

# game/scripts/c24/c24.rpy:1269
translate brazilian c24s002_BetNoNun_d9a0c285:

    # mc "Vamos. Tenemos menos de tres horas."
    mc "Vamos lá. Temos menos de três horas."

# game/scripts/c24/c24.rpy:1271
translate brazilian c24s002_BetNoNun_2f35927b:

    # "[emm] os lleva por algunos de los sitios más emblemáticos de Monterey, aprovechando para sacar fotografías en cada uno de ellos."
    "[emm] leva você a conhecer alguns dos locais mais icônicos de Monterey, aproveitando a oportunidade para tirar fotos em cada um deles."

# game/scripts/c24/c24.rpy:1272
translate brazilian c24s002_BetNoNun_a4dee4f8:

    # "Os da explicaciones sorprendentemente detalladas sobre cada uno de los lugares que visitáis."
    "Ele oferece explicações surpreendentemente detalhadas sobre cada um dos lugares que você visita."

# game/scripts/c24/c24.rpy:1273
translate brazilian c24s002_BetNoNun_bf6175b6:

    # "Pero esas tres horas se hacen muy cortas y tenéis que dejar muchas cosas en el tintero, para otra visita."
    "Mas essas três horas passam muito rápido, e você acaba deixando muitas coisas por fazer para outra visita."

# game/scripts/c24/c24.rpy:1274
translate brazilian c24s002_BetNoNun_5706c58a:

    # "La última parada es la Catedral de Monterey, muy cerca del edificio donde os habéis reunido con el Padre Segismund."
    "A última parada é a Catedral de Monterey, bem perto do prédio onde você se encontrou com o Padre Segismund."

# game/scripts/c24/c24.rpy:1275
translate brazilian c24s002_BetNoNun_c926f7ff:

    # emm "Y esta es la catedral más pequeña de los Estados Unidos. Se fundó como la capilla de un presidio español."
    emm "E esta é a menor catedral dos Estados Unidos. Ela foi fundada como capela de um presídio espanhol."

# game/scripts/c24/c24.rpy:1276
translate brazilian c24s002_BetNoNun_77f2441d:

    # emm "Era como llamaban a sus fuertes."
    emm "Era assim que eles chamavam seus fortes."

# game/scripts/c24/c24.rpy:1277
translate brazilian c24s002_BetNoNun_27596bdb:

    # bet "Muy interesante la visita, [emm]. Nos has dado un montón de información para haber estudiado la ciudad solo unas horas."
    bet "A visita foi muito interessante, [emm]. Você nos deu muitas informações mesmo tendo estudado a cidade por apenas algumas horas."

# game/scripts/c24/c24.rpy:1278
translate brazilian c24s002_BetNoNun_6c389925:

    # mc "Si lo de hacerte fotógrafa no funciona, tienes futuro como guía turística."
    mc "Se a carreira de fotógrafo não der certo, você tem um futuro como guia turístico."

# game/scripts/c24/c24.rpy:1280
translate brazilian c24s002_BetNoNun_6b6926e8:

    # emm "Iros antes de que me hagáis ruborizar. No estoy acostumbrada a los elogios."
    emm "Vá embora antes que eu fique sem graça. Não estou acostumada a elogios."

# game/scripts/c24/c24.rpy:1281
translate brazilian c24s002_BetNoNun_c9198b76:

    # emm "Me llevo la camioneta a la heladería y os espero allí. Ya me estoy haciendo amiga de Margaret, la camarera."
    emm "Vou levar a caminhonete até a sorveteria e te espero lá. Já estou fazendo amizade com a Margaret, a garçonete."

# game/scripts/c24/c24.rpy:1282
translate brazilian c24s002_BetNoNun_e57e09a3:

    # bet "Déjame un poco de helado. El dónut de antes me ha dejado con hambre."
    bet "Me deixa um pouco de sorvete. Aquele donut de antes me deu fome."

# game/scripts/c24/c24.rpy:1284
translate brazilian c24s002_BetNoNun_733dc6d8:

    # mc "Te vemos en un rato."
    mc "Te vejo daqui a pouco."

# game/scripts/c24/c24.rpy:1287
translate brazilian c24s002_BetNoNun_efd32a54:

    # bet "Hola de nuevo, Hermana. Venimos a ver al Padre Segismund de nuevo."
    bet "Olá novamente, irmã. Viemos visitar o padre Segismund mais uma vez."

# game/scripts/c24/c24.rpy:1288
translate brazilian c24s002_BetNoNun_e9c67058:

    # "Monja" "Les está esperando. Pasen."
    "Monja" "Ele está esperando por você. Entre."

# game/scripts/c24/c24.rpy:1290
translate brazilian c24s002_BetNoNun_61637fb9:

    # "Segismund" "Hola de nuevo. Tengo noticias para ustedes. Siéntense, por favor."
    "Segismund" "Olá novamente. Tenho novidades para você. Por favor, sente-se."

# game/scripts/c24/c24.rpy:1291
translate brazilian c24s002_BetNoNun_03495d72:

    # "Segismund" "He hablado con mis superiores y, por desgracia, no han aceptado lo de los 30 días de indemnización por año trabajado."
    "Segismund" "Conversei com meus superiores e, infelizmente, eles não aceitaram a compensação de 30 dias por ano trabalhado."

# game/scripts/c24/c24.rpy:1292
translate brazilian c24s002_BetNoNun_19bf6c02:

    # mc "Bueno, entonces no nos deja más opciones que ir a la prensa."
    mc "Bem, então não nos resta outra opção senão recorrer à imprensa."

# game/scripts/c24/c24.rpy:1294
translate brazilian c24s002_BetNoNun_d3db4a6b:

    # "Segismund" "No, espere. Me han autorizado a pagarle a la Hermana Beatrix tan solo 20 días de indemnización."
    "Segismund" "Não, espere. Só fui autorizado a pagar à Irmã Beatrix o equivalente a 20 dias de remuneração."

# game/scripts/c24/c24.rpy:1295
translate brazilian c24s002_BetNoNun_f4c62f42:

    # "Segismund" "Usted tenía razón en que hay países en los que ha trabajado con indemnizaciones de hasta 45, pero otros tienen menos."
    "Segismund" "Você estava certo ao dizer que existem países onde você trabalhou com uma remuneração de até 45, mas outros oferecem menos."

# game/scripts/c24/c24.rpy:1296
translate brazilian c24s002_BetNoNun_4911aef5:

    # "Segismund" "Sé que no era lo que esperaban, pero..."
    "Segismund" "Eu sei que não era o que você esperava, mas..."

# game/scripts/c24/c24.rpy:1297
translate brazilian c24s002_BetNoNun_dc7f482b:

    # mc "Entonces eso sería... algo más de dos años de sueldo."
    mc "Isso daria... um pouco mais de dois anos de salário."

# game/scripts/c24/c24.rpy:1299
translate brazilian c24s002_BetNoNun_830701cc:

    # "Segismund" "Algo más. He pedido que, al no cumplir con sus peticiones, añadieran algo más por algunos complementos para su tía."
    "Segismund" "Só mais uma coisa. Eu pedi que, já que não atenderam aos pedidos dela, adicionassem algo a mais, como alguns acessórios para a tia dela."

# game/scripts/c24/c24.rpy:1300
translate brazilian c24s002_BetNoNun_61103e94:

    # "Segismund" "Al final, serán 2.64 años de sueldo. Lo siento pero no he podido conseguir más." id c24s002_BetNoNun_61103e94
    "Segismund" "No final, serão 2,64 anos de salário. Sinto muito, mas não consegui mais." id c24s002_BetNoNun_61103e94

# game/scripts/c24/c24.rpy:1301
translate brazilian c24s002_BetNoNun_0f58b44f:

    # "Segismund" "Obviamente tendrá que firmar un acuerdo de confidencialidad sobre todo este asunto."
    "Segismund" "Obviamente, você terá que assinar um acordo de confidencialidade referente a todo esse assunto."

# game/scripts/c24/c24.rpy:1302
translate brazilian c24s002_BetNoNun_d093d5c0:

    # mc "2.64 años y acuerdo de confidencialidad. ¿Cómo lo ves, Tía [bet]?" id c24s002_BetNoNun_d093d5c0
    mc "2,64 anos e um acordo de confidencialidade. O que você acha, tia [bet]?" id c24s002_BetNoNun_d093d5c0

# game/scripts/c24/c24.rpy:1304
translate brazilian c24s002_BetNoNun_3c013f7c:

    # bet "Me parece bien..."
    bet "Parece-me bem..."

# game/scripts/c24/c24.rpy:1306
translate brazilian c24s002_BetNoNun_d957b91c:

    # mc "¿Hay oferta por escrito de todo esto?"
    mc "Existe alguma proposta por escrito para tudo isso?"

# game/scripts/c24/c24.rpy:1307
translate brazilian c24s002_BetNoNun_56633b5c:

    # "Segismund" "Sí, también tengo el acuerdo de confidencialidad. Ha llegado todo hace unos minutos. Tres horas era muy poco tiempo."
    "Segismund" "Sim, eu também tenho o acordo de confidencialidade. Tudo chegou há alguns minutos. Três horas foi muito pouco tempo."

# game/scripts/c24/c24.rpy:1308
translate brazilian c24s002_BetNoNun_5917cbbf:

    # "Segismund" "La oferta indica que dejará la Iglesia a final de mes, que es cuando se les entregará el dinero. Pero el acuerdo de confidencialidad entra en vigor hoy."
    "Segismund" "A proposta estipula que ele deixará a Igreja no final do mês, data em que o dinheiro será entregue à instituição. No entanto, o acordo de confidencialidade entra em vigor hoje."

# game/scripts/c24/c24.rpy:1309
translate brazilian c24s002_BetNoNun_987ab9f2:

    # mc "Me parece bien. ¿Firmamos?"
    mc "Parece-me ótimo. Vamos assinar?"

# game/scripts/c24/c24.rpy:1311
translate brazilian c24s002_BetNoNun_e16f9f5e:

    # "Después de firmar todos los papeles..."
    "Após assinar todos os papéis..."

# game/scripts/c24/c24.rpy:1312
translate brazilian c24s002_BetNoNun_149060ab:

    # mc "Bueno, Tía [bet], en unos días dejarás de ser monja y tendrás una buena cantidad de dinero en tu cuenta."
    mc "Bem, tia [bet], em alguns dias você deixará de ser freira e terá uma boa quantia de dinheiro em sua conta."

# game/scripts/c24/c24.rpy:1313
translate brazilian c24s002_BetNoNun_fa655e45:

    # bet "Sí. Creo que es lo mejor para todos. Para la Iglesia y para mí."
    bet "Sim. Acho que é o melhor para todos. Para a Igreja e para mim."

# game/scripts/c24/c24.rpy:1314
translate brazilian c24s002_BetNoNun_48ee1e2b:

    # mc "Creo que, ahora que todo está firmado, le puedes decir al Padre Segismund cuál era tu intención al entrar por esa puerta esta mañana."
    mc "Creio que, agora que tudo está assinado, você pode dizer ao padre Segismund qual era a sua intenção ao entrar por aquela porta esta manhã."

# game/scripts/c24/c24.rpy:1316
translate brazilian c24s002_BetNoNun_3938639c:

    # bet "¿Qué? ¿Crees que es necesario?"
    bet "O quê? Você acha isso necessário?"

# game/scripts/c24/c24.rpy:1317
translate brazilian c24s002_BetNoNun_0f1781b4:

    # mc "Creo que vas a disfrutar cada segundo."
    mc "Acho que você vai aproveitar cada segundo."

# game/scripts/c24/c24.rpy:1319
translate brazilian c24s002_BetNoNun_d1f08a29:

    # bet "Padre Segismund, primero quiero darle las gracias por hacer las gestiones tan rápido."
    bet "Padre Segismund, em primeiro lugar, quero agradecer-lhe por ter resolvido as coisas tão rapidamente."

# game/scripts/c24/c24.rpy:1321
translate brazilian c24s002_BetNoNun_5165c59d:

    # "Segismund" "Supongo que hay algún pero por lo que ha dicho su sobrino."
    "Segismund" "Imagino que haja um \"mas\" por causa do que o sobrinho dele disse."

# game/scripts/c24/c24.rpy:1323
translate brazilian c24s002_BetNoNun_97c571f0:

    # bet "Sí. Pero mi intención al venir hoy era abandonar la Iglesia. Nunca pensé en una indemnización ya que era yo la que me iba."
    bet "Sim. Mas minha intenção ao vir aqui hoje era deixar a Igreja. Nunca pensei em compensação, já que era eu quem estava saindo."

# game/scripts/c24/c24.rpy:1324
translate brazilian c24s002_BetNoNun_492795a5:

    # bet "Gracias por 2.64 años de mi sueldo." id c24s002_BetNoNun_492795a5
    bet "Obrigado por 2,64 anos do meu salário." id c24s002_BetNoNun_492795a5

# game/scripts/c24/c24.rpy:1326
translate brazilian c24s002_BetNoNun_7ed23dc3:

    # "Segismund" "¿Qué?"
    "Segismund" "Que?"

# game/scripts/c24/c24.rpy:1327
translate brazilian c24s002_BetNoNun_f3acb3c7:

    # mc "*Risa* Por suerte, todo está firmado y mi tía ya no se puede echar atrás."
    mc "*Risos* Felizmente, tudo está assinado e minha tia não pode mais desistir."

# game/scripts/c24/c24.rpy:1328
translate brazilian c24s002_BetNoNun_5cd145b7:

    # mc "Gracias por todo, Padre Segismund."
    mc "Obrigado por tudo, Padre Segismund."

# game/scripts/c24/c24.rpy:1329
translate brazilian c24s002_BetNoNun_d78cd553:

    # "Abandonáis el edificio de la Iglesia con la cara de sorpresa del Padre Segismund grabada en vuestras retinas."
    "Você sai da igreja com o rosto surpreso do Padre Segismund gravado em suas retinas."

# game/scripts/c24/c24.rpy:1332
translate brazilian c24s002_BetNoNun_b438befd:

    # "Una vez en el exterior..."
    "Assim que estiver lá fora..."

# game/scripts/c24/c24.rpy:1334
translate brazilian c24s002_BetNoNun_3aa48686:

    # bet "Gracias por todo, [mc]. Si no hubiera sido por ti..."
    bet "Obrigado por tudo, [mc]. Se não fosse por você..."

# game/scripts/c24/c24.rpy:1335
translate brazilian c24s002_BetNoNun_5dc15e44:

    # mc "No tienes por qué darlas. He visto una oportunidad y la he aprovechado. Esperaba 15 días y nos han dado 20. No está mal."
    mc "Você não precisa desistir deles. Eu vi uma oportunidade e a aproveitei. Esperava 15 dias e eles nos deram 20. Nada mal."

# game/scripts/c24/c24.rpy:1336
translate brazilian c24s002_BetNoNun_a0116eca:

    # mc "Ahora tienes dinero suficiente para la recertificación, supongo."
    mc "Agora você tem dinheiro suficiente para a recertificação, suponho."

# game/scripts/c24/c24.rpy:1339
translate brazilian c24s002_BetNoNun_a26a6a4e:

    # bet "Lo que más me jode de no haber dejado de ser monja hoy es que no te puedo besar ahora mismo aquí delante."
    bet "O que mais me irrita em não ter deixado de ser freira hoje é não poder te beijar aqui mesmo, na sua frente."

# game/scripts/c24/c24.rpy:1340
translate brazilian c24s002_BetNoNun_f2817d0d:

    # bet "Serían capaces de excomulgarme para ahorrarse el dinero. *Risa*"
    bet "Eles seriam capazes de me excomungar para economizar dinheiro. *Risos*"

# game/scripts/c24/c24.rpy:1341
translate brazilian c24s002_BetNoNun_5c2c04f5:

    # mc "*Risa* Habrá mucho tiempo para eso. No te preocupes."
    mc "*Risos* Haverá bastante tempo para isso. Não se preocupe."

# game/scripts/c24/c24.rpy:1342
translate brazilian c24s002_BetNoNun_c72099de:

    # mc "Vamos a buscar a [emm]. Se tiene que estar mordiendo las uñas del nerviosismo."
    mc "Vamos encontrar [emm]. Ele deve estar roendo as unhas de nervosismo."

# game/scripts/c24/c24.rpy:1344
translate brazilian c24s002_BetNoNun_583d8878:

    # "Después de recoger a [emm] y explicárselo todo..."
    "Depois de pegar [emm] e explicar tudo para ele..."

# game/scripts/c24/c24.rpy:1346
translate brazilian c24s002_BetNoNun_7f514a72:

    # emm "Si queréis puedo conducir yo de vuelta a casa. Por si estáis cansados después de la noche de ayer. *Risita*"
    emm "Se você quiser, posso te levar de volta para casa. Caso esteja cansada depois da noite passada. *Risos*"

# game/scripts/c24/c24.rpy:1347
translate brazilian c24s002_BetNoNun_5321e4ac:

    # mc "Me parece una buena idea. Así podemos echar una siesta mientras tú conduces."
    mc "Parece uma boa ideia. Assim podemos tirar um cochilo enquanto você dirige."

# game/scripts/c24/c24.rpy:1348
translate brazilian c24s002_BetNoNun_e7093740:

    # mc "Tu dormiste en el viaje de ida y nosotros en el de vuelta."
    mc "Você dormiu na viagem de ida e nós dormimos na viagem de volta."

# game/scripts/c24/c24.rpy:1350
translate brazilian c24s002_BetNoNun_e9b48284:

    # emm "Vuelvo a pedirme el asiento de atrás. He dormido poco con los ronquidos de Tía [bet]."
    emm "Vou sentar no banco de trás de novo. Não consegui dormir direito com o ronco da tia."

# game/scripts/c24/c24.rpy:1351
translate brazilian c24s002_BetNoNun_5db2a345:

    # emm "¡De vuelta a casa!"
    emm "De volta para casa!"

# game/scripts/c24/c24.rpy:1353
translate brazilian c24s002_BetNoNun_4bdf22d8:

    # "Durante el viaje a casa, Tía [bet] manda varios mensajes al grupo de WhatsUp para informar de cómo ha ido todo."
    "Durante a viagem de volta para casa, a tia [bet] envia várias mensagens para o grupo do WhatsApp para relatar como tudo correu."

# game/scripts/c24/c24.rpy:1355
translate brazilian c24s002_BetNoNun_ceeade09:

    # "Se queda profundamente dormida después de contestar todos los mensajes del resto de las chicas."
    "Ela cai num sono profundo depois de responder a todas as mensagens das outras garotas."

# game/scripts/c24/c24.rpy:1366
translate brazilian c24s003_Mar_203aaac2:

    # "Paráis a comer en King City. Pizza para todos. Idea de [bet]."
    "Você para para almoçar em King City. Pizza para todos. Ideia de [bet]."

# game/scripts/c24/c24.rpy:1367
translate brazilian c24s003_Mar_ac4278e6:

    # "Después de charlar un rato y reposar la comida, seguís camino a casa."
    "Depois de conversar um pouco e deixar a comida assentar, você continua seu caminho para casa."

# game/scripts/c24/c24.rpy:1369
translate brazilian c24s003_Mar_60eee3d4:

    # "Conduces tú después de comer. [emm] ha querido competir con [bet] comiendo pizza y se siente pesada."
    "Você dirige depois de comer. [emm] queria competir com [bet] comendo pizza e se sente pesado."

# game/scripts/c24/c24.rpy:1372
translate brazilian c24s003_Mar_8d1d0d97:

    # "En cuanto abres la puerta del garaje, aparece [mar] en la puerta de casa. Parece que os ha estado esperando."
    "Assim que você abre a porta da garagem, [mar] aparece na sua porta da frente. Parece que ele estava esperando por você."

# game/scripts/c24/c24.rpy:1374
translate brazilian c24s003_Mar_1b82c39b:

    # mom "Hola, [emm]. ¿Te lo has pasado bien con el coche?"
    mom "Olá, [emm]. Você se divertiu com o carro?"

# game/scripts/c24/c24.rpy:1375
translate brazilian c24s003_Mar_6d205f3c:

    # emm "Ha sido fantástico. Incluso hemos tenido un poco de tiempo para hacer turismo en Monterey."
    emm "Tem sido fantástico. Até tivemos um tempinho para passear e conhecer alguns pontos turísticos em Monterey."

# game/scripts/c24/c24.rpy:1376
translate brazilian c24s003_Mar_57e1baed:

    # emm "¿Todo bien por aquí?"
    emm "Está tudo bem por aqui?"

# game/scripts/c24/c24.rpy:1377
translate brazilian c24s003_Mar_7f0d05a4:

    # mom "Sí, cielo. Os he echado de menos. Déjame abrazar a Tía [bet]."
    mom "Sim, querida. Senti muita falta de vocês. Deixa eu abraçar a tia [bet]."

# game/scripts/c24/c24.rpy:1379
translate brazilian c24s003_Mar_cc2845ff:

    # mom "Felicidades por haberlo resuelto todo, Tía."
    mom "Parabéns por ter resolvido tudo, tia."

# game/scripts/c24/c24.rpy:1382
translate brazilian c24s003_Mar_725c9f3b:

    # mom "Y bienvenida al harén."
    mom "E bem-vindos ao harém."

# game/scripts/c24/c24.rpy:1384
translate brazilian c24s003_Mar_da4826a4:

    # mom "Y por entrar en el harén de [mc]."
    mom "E para entrar no harém de [mc]."

# game/scripts/c24/c24.rpy:1386
translate brazilian c24s003_Mar_2aee896c:

    # mom "Y por lo tuyo con [mc]."
    mom "E quanto à sua questão com [mc]."

# game/scripts/c24/c24.rpy:1387
translate brazilian c24s003_Mar_2d1c0355:

    # bet "Gracias, cielo. Ha sido un viaje muy intenso."
    bet "Obrigada, querida. Foi uma viagem muito intensa."

# game/scripts/c24/c24.rpy:1388
translate brazilian c24s003_Mar_798c6d0d:

    # bet "Ve a abrazar a [mc]. Te veo ansiosa. [emm] y yo vamos a meter las maletas dentro."
    bet "Vá abraçar [mc]. Você parece ansioso. [emm] e eu vamos colocar as malas lá dentro."

# game/scripts/c24/c24.rpy:1390
translate brazilian c24s003_Mar_b5bb3a83:

    # emm "¿No nos va a ayudar [mc]? ¡Yo tengo tres maletas!"
    emm "Você não vai nos ajudar? Eu tenho três malas!"

# game/scripts/c24/c24.rpy:1392
translate brazilian c24s003_Mar_4307645b:

    # bet "Él las ha bajado de la camioneta."
    bet "Ele os tirou do caminhão."

# game/scripts/c24/c24.rpy:1393
translate brazilian c24s003_Mar_29b2db10:

    # bet "Si quieres trabajar viajando tendrás que aprender a llevar menos equipaje. Esta es tu primera lección."
    bet "Se você quer trabalhar enquanto viaja, terá que aprender a levar menos coisas na mala. Essa é a sua primeira lição."

# game/scripts/c24/c24.rpy:1394
translate brazilian c24s003_Mar_b278f219:

    # bet "Yo subo una y tú otra. Después subes la tercera mientras yo recojo la mía."
    bet "Eu pego uma, e você pega outra. Depois você pega a terceira enquanto eu pego a minha."

# game/scripts/c24/c24.rpy:1396
translate brazilian c24s003_Mar_7ef7b476:

    # "[mar] te da un abrazo que sería la envidia de cualquier mamá oso."
    "[mar] te dá um abraço que seria a inveja de qualquer mãe ursa."

# game/scripts/c24/c24.rpy:1397
translate brazilian c24s003_Mar_9520bae5:

    # mom "Se me ha hecho muy largo no teneros por aquí."
    mom "Faz muito tempo que não tenho vocês todos aqui."

# game/scripts/c24/c24.rpy:1398
translate brazilian c24s003_Mar_9846dfae:

    # mc "Sólo ha sido un día. Pero me alegro de volver, y más con este recibimiento."
    mc "Faz apenas um dia. Mas estou feliz por estar de volta, especialmente com esta recepção."

# game/scripts/c24/c24.rpy:1402
translate brazilian c24s003_Mar_8e84404a:

    # "Tu madre te da un apasionado beso que te deja sin aliento."
    "Sua mãe lhe dá um beijo apaixonado que lhe deixa sem fôlego."

# game/scripts/c24/c24.rpy:1404
translate brazilian c24s003_Mar_4f036114:

    # "[mar] te da un apasionado beso que te deja sin aliento."
    "[mar] te dá um beijo apaixonado que te deixa sem fôlego."

# game/scripts/c24/c24.rpy:1406
translate brazilian c24s003_Mar_c153a469:

    # mom "Ahora todo está mejor. Ya estáis en casa."
    mom "Agora está tudo melhor. Você está em casa."

# game/scripts/c24/c24.rpy:1409
translate brazilian c24s003_Mar_3f492dcd:

    # "Después de un largo abrazo..."
    "Após um longo abraço..."

# game/scripts/c24/c24.rpy:1410
translate brazilian c24s003_Mar_fee1222a:

    # mom "Hoy tienes tu primera cita con [kia], no lo olvides."
    mom "Hoje é seu primeiro encontro com [kia], não se esqueça."

# game/scripts/c24/c24.rpy:1411
translate brazilian c24s003_Mar_3f4dc75d:

    # mc "*Risa* No lo puedo olvidar, aunque para nosotros es la tercera. Salimos a comer y dimos un paseo."
    mc "*Risos* Não consigo esquecer, mesmo sendo a terceira vez. Saímos para jantar e demos uma caminhada."

# game/scripts/c24/c24.rpy:1412
translate brazilian c24s003_Mar_86c2bfee:

    # mom "¿Dónde vais a ir?"
    mom "Onde você está indo?"

# game/scripts/c24/c24.rpy:1413
translate brazilian c24s003_Mar_c6bff8c9:

    # mc "No tengo ni idea. Me dijo que lo organizaba ella, con lo que es una sorpresa también para mí."
    mc "Não faço ideia. Ela me disse que estava organizando, então é uma surpresa para mim também."

# game/scripts/c24/c24.rpy:1415
translate brazilian c24s003_Mar_941e8bf1:

    # mom "Ah, por eso me estuvo preguntando por restaurantes bonitos. ¡Seré tonta!"
    mom "Ah, então é por isso que ele estava me perguntando sobre bons restaurantes. Que boba eu sou!"

# game/scripts/c24/c24.rpy:1416
translate brazilian c24s003_Mar_1bbfa337:

    # mom "El único que conozco es el de la cueva al que me llevaste. Parece que hace mil años."
    mom "A única que conheço é aquela na caverna para onde você me levou. Parece que foi há mil anos."

# game/scripts/c24/c24.rpy:1418
translate brazilian c24s003_Mar_c696b1b4:

    # mom "Pero ese no se lo voy a recomendar a nadie. Ese es nuestro. Nuestra primera cita, aunque no saliéramos juntos aún."
    mom "Mas não vou recomendar essa para ninguém. Essa é nossa. Nosso primeiro encontro, mesmo que ainda não estivéssemos namorando."

# game/scripts/c24/c24.rpy:1419
translate brazilian c24s003_Mar_7518d039:

    # mc "Un día tenemos que volver a ese sitio. Fue una noche fantástica."
    mc "Temos que voltar àquele lugar um dia. Foi uma noite fantástica."

# game/scripts/c24/c24.rpy:1421
translate brazilian c24s003_Mar_693f7f38:

    # mom "Estoy segura de que, te lleve donde te lleve [kia] también os lo vais a pasar muy bien."
    mom "Tenho certeza de que onde quer que [kia] te leve, você vai se divertir muito."

# game/scripts/c24/c24.rpy:1422
translate brazilian c24s003_Mar_77981c86:

    # mom "Ayer estaba nerviosa por la cita."
    mom "Ontem eu estava nervoso com o encontro."

# game/scripts/c24/c24.rpy:1423
translate brazilian c24s003_Mar_2f7cf5dc:

    # mc "A lo mejor debería hablar con ella antes..."
    mc "Talvez eu devesse falar com ela primeiro..."

# game/scripts/c24/c24.rpy:1425
translate brazilian c24s003_Mar_07317058:

    # mom "No creo que tengas mucho tiempo para eso. Está trabajando y supongo que, cuando vuelva a casa, se querrá poner guapa para ti."
    mom "Acho que você não tem muito tempo para isso. Ela está trabalhando e imagino que vai querer se arrumar toda para você quando chegar em casa."

# game/scripts/c24/c24.rpy:1426
translate brazilian c24s003_Mar_2bed33bd:

    # mom "Los nervios se le pasarán en cuanto la recojas."
    mom "O nervosismo dela desaparecerá assim que você a pegar no colo."

# game/scripts/c24/c24.rpy:1427
translate brazilian c24s003_Mar_100c80b0:

    # mc "*Risa* Espero que también se me pasen a mí."
    mc "*Risos* Espero que também me sirvam."

# game/scripts/c24/c24.rpy:1429
translate brazilian c24s003_Mar_5874c68b:

    # mom "*Risa* Bueno, ve a descansar un rato antes de esa cita."
    mom "*Risos* Bom, vá descansar um pouco antes desse encontro."

# game/scripts/c24/c24.rpy:1431
translate brazilian c24s003_Mar_10c61dcb:

    # mom "Será mejor que vayas a descansar un rato antes de la cena."
    mom "É melhor você ir descansar um pouco antes do jantar."

# game/scripts/c24/c24.rpy:1432
translate brazilian c24s003_Mar_8bb863a8:

    # mom "Dame la mochila. Bajaré a dejar la ropa en la lavadora."
    mom "Me dê a mochila. Vou descer e colocar as roupas na máquina de lavar."

# game/scripts/c24/c24.rpy:1433
translate brazilian c24s003_Mar_7ce5b618:

    # mom "Veo que al final te has puesto la camisa azul. *Risa*"
    mom "Vejo que finalmente vestiu a camisa azul. *Risos*"

# game/scripts/c24/c24.rpy:1435
translate brazilian c24s003_Mar_03172388:

    # mc "*Risa* Si, te veo luego."
    mc "*Risos* Sim, até mais tarde."

# game/scripts/c24/c24.rpy:1441
translate brazilian c24s003_NoKia_e8c88a3a:

    # "Subes a tu habitación a dejar tus cosas y aprovechas para jugar un rato a My Residence."
    "Você sobe para o seu quarto para deixar suas coisas e aproveita para jogar My Residence por um tempo."

# game/scripts/c24/c24.rpy:1442
translate brazilian c24s003_NoKia_55699688:

    # "Hoy toca cita con Claire, la preciosa irlandesa que es la madre de la exnovia del protagonista."
    "Hoje temos um encontro marcado com Claire, a bela irlandesa que é mãe da ex-namorada do protagonista."

# game/scripts/c24/c24.rpy:1443
translate brazilian c24s003_NoKia_c128ba42:

    # "Hay una tórrida escena en la ducha que crees que rejugarás varias veces en la galería."
    "Há uma cena de banho quente que você provavelmente vai querer rever várias vezes na galeria."

# game/scripts/c24/c24.rpy:1445
translate brazilian c24s003_NoKia_90b73b27:

    # "Después de cenar, te retiras a tu habitación, donde lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Após o jantar, você se retira para o seu quarto, onde lê alguns documentos que [ama] lhe enviou sobre Punho de Ferro."

# game/scripts/c24/c24.rpy:1446
translate brazilian c24s003_NoKia_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Você precisa estar preparado para a reunião de amanhã no iate."

# game/scripts/c24/c24.rpy:1447
translate brazilian c24s003_NoKia_14a02826:

    # "Es información muy aburrida y te quedas dormido mientras la lees."
    "É uma informação muito chata e você acaba dormindo enquanto lê."

# game/scripts/c24/c24.rpy:1448
translate brazilian c24s003_NoKia_479b95c0:

    # centered "{size=+20}{b}DÍA 26 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}DIA 26 – SÁBADO{/b}{/size}"

# game/scripts/c24/c24.rpy:1450
translate brazilian c24s003_NoKia_7e47640e:

    # "Te levantas muy tarde, casi a mediodía. Debías estar más cansado de lo que creías."
    "Você acordou muito tarde, quase ao meio-dia. Você devia estar mais cansado do que pensava."

# game/scripts/c24/c24.rpy:1459
translate brazilian c24s003_KiaDate_2237f21b:

    # "Subes a tu habitación a dejar tus cosas y lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Você sobe para o seu quarto para guardar suas coisas e ler alguns documentos que [ama] lhe enviou sobre Punho de Ferro."

# game/scripts/c24/c24.rpy:1460
translate brazilian c24s003_KiaDate_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Você precisa estar preparado para a reunião de amanhã no iate."

# game/scripts/c24/c24.rpy:1461
translate brazilian c24s003_KiaDate_06007255:

    # "Cuando se acerca la hora de tu cita, te das una ducha y te cambias. No sabes dónde vais a ir, con lo que eliges algo que pueda ir bien en casi cualquier sitio."
    "Conforme o encontro se aproxima, você toma um banho e se veste. Como não sabe para onde vai, escolhe uma roupa que sirva em quase qualquer lugar."

# game/scripts/c24/c24.rpy:1464
translate brazilian c24s003_KiaDate_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c24/c24.rpy:1465
translate brazilian c24s003_KiaDate_93c9ba13:

    # kia "*A través de la puerta* Soy yo, ¿puedo pasar?"
    kia "*Pela porta* Sou eu, posso entrar?"

# game/scripts/c24/c24.rpy:1467
translate brazilian c24s003_KiaDate_4d601f0e:

    # mc "Sí, pasa."
    mc "Sim, acontece."

# game/scripts/c24/c24.rpy:1473
translate brazilian c24s003_KiaDate_7cf199b5:

    # mc "¡Wow, [kia]! ¡Estás preciosa!"
    mc "Uau, [kia]! Você está deslumbrante!"

# game/scripts/c24/c24.rpy:1474
translate brazilian c24s003_KiaDate_0018e517:

    # kia "Gracias, [mc]. Tú también estás muy guapo."
    kia "Obrigado, [mc]. Você também está muito bonito."

# game/scripts/c24/c24.rpy:1475
translate brazilian c24s003_KiaDate_0ad25d4f:

    # kia "¿Estás preparado para irnos?"
    kia "Você está pronto para ir?"

# game/scripts/c24/c24.rpy:1476
translate brazilian c24s003_KiaDate_75d3cb24:

    # mc "Cuando tú quieras. ¿Dónde vamos a ir? ¿Voy bien así?"
    mc "Quando você quiser. Para onde vamos? Estou bem assim?"

# game/scripts/c24/c24.rpy:1478
translate brazilian c24s003_KiaDate_8e87288a:

    # kia "Estás perfecto."
    kia "Você está perfeita."

# game/scripts/c24/c24.rpy:1479
translate brazilian c24s003_KiaDate_85bd524c:

    # kia "Voy a ser la envidia de todas las mujeres."
    kia "Serei a inveja de todas as mulheres."

# game/scripts/c24/c24.rpy:1480
translate brazilian c24s003_KiaDate_5ff2e895:

    # mc "Y a mí me van a envidiar todos los hombres vayamos donde vayamos."
    mc "E todos os homens me invejarão aonde quer que formos."

# game/scripts/c24/c24.rpy:1482
translate brazilian c24s003_KiaDate_bfcf7a77:

    # kia "*Risa* Van a pensar que sales a cenar con tu madre. Nada envidiable."
    kia "*Risos* Eles vão pensar que você vai jantar fora com a sua mãe. Nada invejável."

# game/scripts/c24/c24.rpy:1485
translate brazilian c24s003_KiaDate_4930ddd9:

    # kia "¡Oh! No me refería a [mar] y a ti. Hacéis una pareja perfecta."
    kia "Ah! Eu não estava me referindo a você. Vocês dois formam um casal perfeito."

# game/scripts/c24/c24.rpy:1486
translate brazilian c24s003_KiaDate_1268706e:

    # mc "Ya lo sé. Entiendo a lo que te refieres y, aunque no seas mi madre, te aseguro que cualquier hombre querría estar en mi posición hoy."
    mc "Eu sei. Entendo o que você quer dizer, e mesmo que você não seja minha mãe, garanto que qualquer homem gostaria de estar no meu lugar hoje."

# game/scripts/c24/c24.rpy:1487
translate brazilian c24s003_KiaDate_b8ec88c3:

    # mc "Si piensan que eres mi madre y que además estamos saliendo juntos, más hombres aún me van a envidiar. Ya sabes, fetiche con el incesto..." id c24s003_KiaDate_b8ec88c3
    mc "Se eles acharem que você é minha mãe e que estamos namorando, ainda mais homens vão me invejar. Sabe, fetiche por incesto..." id c24s003_KiaDate_b8ec88c3

# game/scripts/c24/c24.rpy:1488
translate brazilian c24s003_KiaDate_5bb546fa:

    # mc "La mitad de los hombres del mundo darían lo que fuera por tener una madre como tú y poder hacer esto con ella."
    mc "Metade dos homens do mundo dariam tudo para ter uma mãe como você e poder fazer isso com ela."

# game/scripts/c24/c24.rpy:1490
translate brazilian c24s003_KiaDate_33452344:

    # "Sin dejarle reaccionar, la coges entre tus brazos y dejas que tus labios recorran los suyos."
    "Sem dar-lhe tempo para reagir, você a toma em seus braços e deixa seus lábios percorrerem o caminho dos lábios dela."

# game/scripts/c24/c24.rpy:1491
translate brazilian c24s003_KiaDate_83561e84:

    # "Tras un segundo de sorpresa, la hermosa pelirroja entreabre su boca y deja que su lengua empiece a jugar con la tuya."
    "Após um segundo de surpresa, a bela ruiva abre ligeiramente a boca e deixa sua língua começar a brincar com a sua."

# game/scripts/c24/c24.rpy:1493
translate brazilian c24s003_KiaDate_721bb120:

    # kia "¡Hey! ¡Para! Tenemos una reserva para cenar, y quiero una cena tranquila."
    kia "Ei! Pare! Temos uma reserva para jantar e eu quero um jantar tranquilo."

# game/scripts/c24/c24.rpy:1494
translate brazilian c24s003_KiaDate_09d5b8a8:

    # mc "*Risa* ¿Te pones nerviosa cenando?"
    mc "*Risos* Você fica nervoso(a) quando está jantando?"

# game/scripts/c24/c24.rpy:1496
translate brazilian c24s003_KiaDate_d620db7b:

    # kia "*Risa* No, idiota. Pero si empiezas así antes de que nos vayamos, no voy a poder pensar en otra cosa mientras cenamos."
    kia "*Risos* Não, idiota. Mas se você começar assim antes mesmo de sairmos, não vou conseguir pensar em mais nada enquanto jantamos."

# game/scripts/c24/c24.rpy:1497
translate brazilian c24s003_KiaDate_0d0f8a07:

    # mc "Eres consciente de que, aunque estemos en un restaurante, podemos besarnos, ¿verdad?"
    mc "Você sabe que podemos nos beijar mesmo se estivermos em um restaurante, certo?"

# game/scripts/c24/c24.rpy:1499
translate brazilian c24s003_KiaDate_18057fc8:

    # kia "Sí, lo sé. Y seguramente te besaré. Pero no serán besos así."
    kia "Sim, eu sei. E provavelmente vou te beijar. Mas não serão beijos desse tipo."

# game/scripts/c24/c24.rpy:1500
translate brazilian c24s003_KiaDate_ce099bae:

    # kia "Nunca me han gustado las parejas que se enrollan en público. Son cosas que se tienen que hacer en la intimidad."
    kia "Nunca gostei de casais que se beijam em público. Isso é algo que deve ser feito em particular."

# game/scripts/c24/c24.rpy:1501
translate brazilian c24s003_KiaDate_f2bcde51:

    # mc "Me parece bien. A mí nunca me han importado, pero si a ti no te gusta esperaré a disfrutar de tus labios."
    mc "Por mim, tudo bem. Nunca me importei, mas se você não gostar, posso esperar para desfrutar dos seus lábios."

# game/scripts/c24/c24.rpy:1503
translate brazilian c24s003_KiaDate_3be31b74:

    # kia "Tengo pensado pedir una ensalada de aguacate, con lo que espero que te siga gustando la combinación con mi pintalabios."
    kia "Pretendo pedir uma salada de abacate, então espero que você ainda goste da combinação com o meu batom."

# game/scripts/c24/c24.rpy:1504
translate brazilian c24s003_KiaDate_8666bcd5:

    # mc "Me gustaría aunque no llevaras pintalabios. Aunque no comieras aguacate."
    mc "Eu gostaria mesmo que você não estivesse usando batom. Mesmo que você não estivesse comendo abacate."

# game/scripts/c24/c24.rpy:1506
translate brazilian c24s003_KiaDate_aafcc2ca:

    # kia "Entonces vámonos antes de que te tenga que volver a besar."
    kia "Então vamos embora antes que eu tenha que te beijar de novo."

# game/scripts/c24/c24.rpy:1507
translate brazilian c24s003_KiaDate_d2aa7bb0:

    # mc "Me tendrás que decir dónde vamos si tengo que conducir hasta allí. ¿O vamos a coger un Under?"
    mc "Você vai ter que me dizer para onde vamos se eu tiver que dirigir até lá. Ou vamos arriscar um pouco?"

# game/scripts/c24/c24.rpy:1509
translate brazilian c24s003_KiaDate_606649cc:

    # kia "Conduzco yo. Le he pedido el coche a [mar]. Vamos a un par de sitios donde coger un Under sería complicado."
    kia "Estou dirigindo. Peguei o carro emprestado do [mar]. Vamos a alguns lugares onde seria difícil passar por baixo do carro."

# game/scripts/c24/c24.rpy:1510
translate brazilian c24s003_KiaDate_d3f0e0fb:

    # mc "¡Oh! Eso quiere decir que no quieres revelar la sorpresa."
    mc "Ah! Isso significa que você não quer revelar a surpresa."

# game/scripts/c24/c24.rpy:1512
translate brazilian c24s003_KiaDate_4f1d7478:

    # kia "Exacto. Ya he dejado la bolsa y el bolso en el coche."
    kia "Exatamente. Já deixei minha bolsa e carteira no carro."

# game/scripts/c24/c24.rpy:1513
translate brazilian c24s003_KiaDate_03682c61:

    # mc "¿Bolsa? ¿Para qué necesitas una bolsa?"
    mc "Uma bolsa? Para que você precisa de uma bolsa?"

# game/scripts/c24/c24.rpy:1514
translate brazilian c24s003_KiaDate_9171ef72:

    # kia "Esa es la segunda sorpresa de esta noche."
    kia "Essa é a segunda surpresa da noite."

# game/scripts/c24/c24.rpy:1516
translate brazilian c24s003_KiaDate_050a880b:

    # "[kia] conduce durante 20 minutos antes de aparcar el coche en lo que parece una viejo edificio."
    "[kia] dirige por 20 minutos antes de estacionar o carro no que parece ser um prédio antigo."

# game/scripts/c24/c24.rpy:1517
translate brazilian c24s003_KiaDate_36c8bdc3:

    # "Por alguna razón, acabas cargando con su bolso."
    "Por algum motivo, você acaba carregando a bolsa dela."

# game/scripts/c24/c24.rpy:1519
translate brazilian c24s003_KiaDate_5dc99045:

    # "Cuando entráis al restaurante está totalmente vacío. Es muy pronto para cenar."
    "Ao entrar no restaurante, ele está completamente vazio. É muito cedo para o jantar."

# game/scripts/c24/c24.rpy:1520
translate brazilian c24s003_KiaDate_3220c059:

    # kia "Ya hemos llegado. Creo que no debes conocer este sitio. Lo abrieron mientras estabas en Portland."
    kia "Estamos aqui. Acho que você nunca esteve aqui. Abriu enquanto você estava em Portland."

# game/scripts/c24/c24.rpy:1521
translate brazilian c24s003_KiaDate_eb55958c:

    # kia "Y ninguna de las chicas lo conocía, con lo que seguramente no habrás venido nunca."
    kia "E nenhuma das garotas o conhecia, então você provavelmente nunca esteve aqui."

# game/scripts/c24/c24.rpy:1522
translate brazilian c24s003_KiaDate_44e12ef9:

    # mc "No, no he venido nunca. No sabía ni que habían hecho un restaurante en este viejo almacén."
    mc "Não, nunca estive aqui. Nem sabia que tinham transformado este antigo armazém em restaurante."

# game/scripts/c24/c24.rpy:1524
translate brazilian c24s003_KiaDate_e57afa09:

    # kia "Las fotos de internet parecían muy bonitas y le hacen justicia. Espero que te guste."
    kia "As fotos que encontrei online são realmente lindas e fazem jus ao lugar. Espero que gostem."

# game/scripts/c24/c24.rpy:1525
translate brazilian c24s003_KiaDate_e47f72b7:

    # mc "Me gustaría aunque fuera tu carrito de perritos calientes favorito."
    mc "Eu gostaria, mesmo que fosse o seu carrinho de cachorro-quente favorito."

# game/scripts/c24/c24.rpy:1526
translate brazilian c24s003_KiaDate_94812cb4:

    # mc "Me importa estar aquí contigo. Me da lo mismo dónde sea 'aquí'."
    mc "Para mim, é importante estar aqui com você. Não me importa onde seja esse \"aqui\"."

# game/scripts/c24/c24.rpy:1527
translate brazilian c24s003_KiaDate_3e238f06:

    # mc "Pero es pronto para cenar, ¿no?"
    mc "Mas ainda é muito cedo para o jantar, não é?"

# game/scripts/c24/c24.rpy:1529
translate brazilian c24s003_KiaDate_5c661d6f:

    # kia "Quiero acabar de cenar pronto para llevarte a un sitio."
    kia "Quero terminar o jantar cedo para poder te levar a algum lugar."

# game/scripts/c24/c24.rpy:1530
translate brazilian c24s003_KiaDate_5c4c9c2b:

    # mc "Eso suena interesante. ¿Es para ese sitio la bolsa?"
    mc "Isso parece interessante. É a bolsa de valores daquele site?"

# game/scripts/c24/c24.rpy:1531
translate brazilian c24s003_KiaDate_91ddeff0:

    # kia "Sí, y no preguntes qué hay dentro."
    kia "Sim, e nem pergunte o que tem dentro."

# game/scripts/c24/c24.rpy:1532
translate brazilian c24s003_KiaDate_b3621a01:

    # mc "*Risa* Estoy empezando a ponerme nervioso por esa sorpresa."
    mc "*Risos* Estou começando a ficar nervoso com essa surpresa."

# game/scripts/c24/c24.rpy:1534
translate brazilian c24s003_KiaDate_708aa274:

    # kia "No hace falta que te pongas nervioso. Es uno de mis lugares favoritos de Newport. E ir esta noche contigo me apetece mucho."
    kia "Não precisa ficar nervoso. É um dos meus lugares favoritos em Newport. E eu adoraria ir com você hoje à noite."

# game/scripts/c24/c24.rpy:1535
translate brazilian c24s003_KiaDate_24fdb8f4:

    # mc "Entonces vamos a cenar. Casi tengo ganas de ir a ver tu sitio favorito."
    mc "Então vamos jantar. Quase me deu vontade de ir ao seu lugar favorito."

# game/scripts/c24/c24.rpy:1538
translate brazilian c24s003_KiaDate_77bca2e2:

    # wai "Buenas noches, perdón por la espera. ¿Tenían reserva?"
    wai "Boa noite, desculpe a demora. Você tinha uma reserva?"

# game/scripts/c24/c24.rpy:1539
translate brazilian c24s003_KiaDate_9f4e6521:

    # kia "Sí, a nombre de [kia] Wellesley."
    kia "Sim, em nome de Wellesley."

# game/scripts/c24/c24.rpy:1540
translate brazilian c24s003_KiaDate_5b089228:

    # wai "Sí, acompáñeme, por favor."
    wai "Sim, por favor, venha comigo."

# game/scripts/c24/c24.rpy:1542
translate brazilian c24s003_KiaDate_4c334347:

    # "La camarera os acompaña a la mesa y os entrega los menús."
    "A garçonete acompanha você até a mesa e lhe entrega os cardápios."

# game/scripts/c24/c24.rpy:1543
translate brazilian c24s003_KiaDate_8ca89980:

    # mc "¿Wellesley?"
    mc "Wellesley?"

# game/scripts/c24/c24.rpy:1544
translate brazilian c24s003_KiaDate_e21185a8:

    # kia "Sí. No pienso usar nunca más el apellido Lamb, si puedo evitarlo. Quiero recuperar mi apellido de soltera."
    kia "Sim. Não pretendo usar o sobrenome Lamb novamente, se puder evitar. Quero retomar meu nome de solteira."

# game/scripts/c24/c24.rpy:1545
translate brazilian c24s003_KiaDate_79b41575:

    # mc "Me parece una gran idea. Creo que brindaré por ello en cuanto nos traigan el vino."
    mc "Parece uma ótima ideia. Acho que farei um brinde assim que nos trouxerem o vinho."

# game/scripts/c24/c24.rpy:1547
translate brazilian c24s003_KiaDate_47bed3e8:

    # kia "No voy a beber vino, [mc]. Hoy conduzco yo, y no quiero que la noche acabe con el coche de [mar] en la cuneta o nosotros detenidos."
    kia "Não vou beber vinho, [mc]. Vou dirigir hoje à noite e não quero que a noite termine com o carro de [mar] na vala ou com a gente sendo parado pela polícia."

# game/scripts/c24/c24.rpy:1548
translate brazilian c24s003_KiaDate_8871f35d:

    # kia "Pero tú puedes beber si quieres."
    kia "Mas você pode beber se quiser."

# game/scripts/c24/c24.rpy:1549
translate brazilian c24s003_KiaDate_2af4c5b6:

    # mc "No me apetece beber si no lo haces tú pero, si quieres, podemos pedir mosto. Veo que tienen en la carta. No es lo mismo, pero..."
    mc "Não estou com vontade de beber a menos que você beba, mas se quiser, podemos pedir suco de uva. Vi que está no cardápio. Não é a mesma coisa, mas..."

# game/scripts/c24/c24.rpy:1551
translate brazilian c24s003_KiaDate_1f8250a7:

    # kia "Nunca lo he probado. ¿Sabe a vino?"
    kia "Nunca experimentei. Tem gosto de vinho?"

# game/scripts/c24/c24.rpy:1552
translate brazilian c24s003_KiaDate_8aa61e12:

    # mc "No. *Risa* Es mucho más dulce. Básicamente es zumo de uva."
    mc "Não. *Risos* É muito mais doce. É basicamente suco de uva."

# game/scripts/c24/c24.rpy:1553
translate brazilian c24s003_KiaDate_8eccb780:

    # kia "*Risa* Entonces sí que lo he probado. Bebía mucho zumo de uva cuando era niña. Me gustaba. Y voy a cambiar la ensalada por filete."
    kia "*Risos* Então, eu já experimentei. Eu bebia muito suco de uva quando era criança. Eu gostava. E vou trocar a salada por bife."

# game/scripts/c24/c24.rpy:1554
translate brazilian c24s003_KiaDate_b63d19d6:

    # mc "Entonces no se hable más. Zumo de uva y filete para la señora. Echaré de menos el aguacate."
    mc "Então está decidido. Suco de uva e bife para a dama. Eu sentirei falta do abacate."

# game/scripts/c24/c24.rpy:1555
translate brazilian c24s003_KiaDate_514b4ad6:

    # "Miras la carta durante un momento."
    "Você olha para a carta por um instante."

# game/scripts/c24/c24.rpy:1556
translate brazilian c24s003_KiaDate_80a7d886:

    # mc "Y zumo de uva y pollo para mí."
    mc "E suco de uva e frango para mim."

# game/scripts/c24/c24.rpy:1558
translate brazilian c24s003_KiaDate_22e872b3:

    # "Después de que la camarera os tome nota..."
    "Depois que a garçonete anotar seu pedido..."

# game/scripts/c24/c24.rpy:1559
translate brazilian c24s003_KiaDate_ec2f9a24:

    # kia "Llevo desde el día que comimos juntos queriendo salir a cenar contigo."
    kia "Desde o dia em que almoçamos juntos, tenho vontade de sair para jantar com você."

# game/scripts/c24/c24.rpy:1560
translate brazilian c24s003_KiaDate_9e42db99:

    # mc "Han sido unos días muy ocupados. Siento que no haya podido ser antes."
    mc "Foram alguns dias muito corridos. Lamento não ter podido ser antes."

# game/scripts/c24/c24.rpy:1561
translate brazilian c24s003_KiaDate_5b3de040:

    # mc "¿Le has dicho a Geneviève que salimos a cenar? ¿Sigue pensando que me quiero aprovechar de ti?"
    mc "Você já contou para a Geneviève que vamos jantar fora? Ela ainda acha que estou tentando me aproveitar de você?"

# game/scripts/c24/c24.rpy:1563
translate brazilian c24s003_KiaDate_89718c77:

    # kia "No, al menos no me ha dicho nada más. Cuando te fuiste se disculpó por meterse donde no le llamaban."
    kia "Não, pelo menos ele não me disse mais nada. Quando você foi embora, ele se desculpou por ter se intrometido onde não era bem-vindo."

# game/scripts/c24/c24.rpy:1564
translate brazilian c24s003_KiaDate_70432cf4:

    # kia "Pero no hemos vuelto a hablar de ti."
    kia "Mas não falamos mais de você desde então."

# game/scripts/c24/c24.rpy:1565
translate brazilian c24s003_KiaDate_a9d6a22b:

    # mc "Cuando me fui pensé que quizás había sido un poco duro con ella. Solo estaba intentando cuidar de ti. Protegerte."
    mc "Quando saí, pensei que talvez tivesse sido um pouco dura com ela. Eu só estava tentando cuidar de você. Te proteger."

# game/scripts/c24/c24.rpy:1567
translate brazilian c24s003_KiaDate_3e5fbbb7:

    # kia "Sus intenciones eran buenas, [mc], pero la forma de hacerlo no."
    kia "Suas intenções eram boas, [mc], mas a maneira como ele fez isso não foi."

# game/scripts/c24/c24.rpy:1568
translate brazilian c24s003_KiaDate_7e77b0fb:

    # kia "No debería juzgarte sin conocerte. Y si te conociera..."
    kia "Não deveria julgá-lo sem conhecê-lo. E se eu o conhecesse..."

# game/scripts/c24/c24.rpy:1571
translate brazilian c24s003_KiaDate_7ff36164:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, habría que hacerle un hueco en el harén."
    kia "*Risos* Se ela não fosse recém-casada e apaixonada pelo marido, teríamos que abrir espaço para ela no harém."

# game/scripts/c24/c24.rpy:1573
translate brazilian c24s003_KiaDate_58c340bc:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, seguramente me pediría compartirte."
    kia "*Risos* Se ela não fosse recém-casada e apaixonada pelo marido, com certeza me pediria para te dividir com ela."

# game/scripts/c24/c24.rpy:1574
translate brazilian c24s003_KiaDate_4cb32db6:

    # kia "*Risa* Con lo que prefiero que no te conozca a fondo. Nos pasaríamos el día hablando de ti en la biblioteca."
    kia "*Risos* É por isso que eu prefiro não te conhecer muito bem. Passaríamos o dia inteiro falando de você na biblioteca."

# game/scripts/c24/c24.rpy:1575
translate brazilian c24s003_KiaDate_5067e76e:

    # mc "*Risa* Lo dices como si las mujeres cayeran a mis pies a los cinco minutos de conocerme."
    mc "*Risos* Você diz isso como se as mulheres se jogassem aos meus pés cinco minutos depois de me conhecerem."

# game/scripts/c24/c24.rpy:1577
translate brazilian c24s003_KiaDate_e8271815:

    # kia "*Risa* Bueno, yo tardé cinco días viviendo en la misma casa. O en la de [nor] para ser más exactos."
    kia "*Risos* Bem, levei cinco dias morando na mesma casa. Ou na casa do [nor], para ser mais preciso."

# game/scripts/c24/c24.rpy:1578
translate brazilian c24s003_KiaDate_13e7e7dc:

    # mc "Tú me conocías de antes. Sabías cómo era."
    mc "Você já me conhecia. Sabia como eu era."

# game/scripts/c24/c24.rpy:1580
translate brazilian c24s003_KiaDate_edcd5283:

    # "La camarera interrumpe vuestra conversación trayendo vuestro pedido. Continuáis en cuanto se va."
    "A garçonete interrompe sua conversa ao trazer seu pedido. Você continua assim que ela sai."

# game/scripts/c24/c24.rpy:1581
translate brazilian c24s003_KiaDate_489d1cf1:

    # kia "Aunque te conociera de antes, nunca me hubiera planteado estar aquí contigo."
    kia "Mesmo que eu já te conhecesse antes, jamais imaginaria estar aqui com você."

# game/scripts/c24/c24.rpy:1582
translate brazilian c24s003_KiaDate_ecaeda33:

    # kia "No, [mc]. No eres el mismo chico que conocí. Hay que ver el hombre en el que te has convertido para entender lo que siento."
    kia "Não, [mc]. Você não é o mesmo garoto que eu conheci. Você precisa ver o homem em que se tornou para entender como me sinto."

# game/scripts/c24/c24.rpy:1583
translate brazilian c24s003_KiaDate_b2516466:

    # mc "Gracias."
    mc "Obrigado."

# game/scripts/c24/c24.rpy:1585
translate brazilian c24s003_KiaDate_7fb94f8f:

    # kia "Y no solo me refiero a cómo eres conmigo o a las dos veces que te enfrentaste a Solomon."
    kia "E não me refiro apenas à forma como você me trata ou às duas vezes em que confrontou Salomão."

# game/scripts/c24/c24.rpy:1586
translate brazilian c24s003_KiaDate_4cfeb268:

    # kia "Cómo trataste al Decano para defender a [mar]. Cómo solucionaste el tema con el antiguo novio de [eri]."
    kia "Como você lidou com o reitor para defender [mar]? Como você resolveu o problema com o ex-namorado de [eri]?"

# game/scripts/c24/c24.rpy:1587
translate brazilian c24s003_KiaDate_96302297:

    # kia "Cómo actuaste con el novio de la madre de [sca]. O cómo has solucionado lo de [bet]."
    kia "Como você lidou com o namorado da mãe de [sca]? Ou como você resolveu a situação de [bet]?"

# game/scripts/c24/c24.rpy:1589
translate brazilian c24s003_KiaDate_949b0c0b:

    # kia "Todo eso no lo hace un chico. Son cosas que hace un hombre que toma las riendas cuando debe."
    kia "Um menino não faz tudo isso. Essas são coisas que um homem faz quando assume o controle."

# game/scripts/c24/c24.rpy:1590
translate brazilian c24s003_KiaDate_baea7e73:

    # mc "*Risa* Me vas a hacer ruborizar."
    mc "*Risos* Você vai me fazer corar."

# game/scripts/c24/c24.rpy:1591
translate brazilian c24s003_KiaDate_31c784a3:

    # mc "No lo he hecho todo solo. [mar] ayudó mucho con el Decano. [eva] y [ama] con Solomon y Kevin..."
    mc "Eu não fiz tudo sozinho. [mar] ajudou muito com o Reitor. [eva] e [ama] com Solomon e Kevin..."

# game/scripts/c24/c24.rpy:1593
translate brazilian c24s003_KiaDate_a795c765:

    # kia "A eso me refiero. No sólo haces lo que tienes que hacer. Nos das ejemplo a las demás y nos inspiras para que nosotras hagamos lo que debemos."
    kia "É isso que eu quero dizer. Você não faz apenas o que tem que fazer. Você dá o exemplo para o resto de nós e nos inspira a fazer o que devemos."

# game/scripts/c24/c24.rpy:1594
translate brazilian c24s003_KiaDate_532f5c8b:

    # mc "*Risa* ¡Joder, [kia]! Haces que parezca el líder de una secta."
    mc "*Risos* Caramba, [kia]! Você me faz parecer o líder de um culto."

# game/scripts/c24/c24.rpy:1596
translate brazilian c24s003_KiaDate_cee6e392:

    # kia "Mas o menos. *Risa* Has creado una familia de elección a tu alrededor."
    kia "Mais ou menos. *Risos* Você criou uma família escolhida ao seu redor."

# game/scripts/c24/c24.rpy:1598
translate brazilian c24s003_KiaDate_976b3965:

    # kia "Y no me refiero solo a las mujeres que estamos contigo. No eres el líder de esa familia. Pero eres el centro."
    kia "E não me refiro apenas às mulheres que estão com você. Você não é o chefe dessa família. Mas você é o centro."

# game/scripts/c24/c24.rpy:1600
translate brazilian c24s003_KiaDate_fab6b4e0:

    # kia "Y aunque no seas el líder de esa familia, pero eres el centro..."
    kia "E mesmo que você não seja o líder dessa família, você ainda é o centro..."

# game/scripts/c24/c24.rpy:1601
translate brazilian c24s003_KiaDate_14d6182a:

    # kia "Eres el factor común para todas nosotras. De [kat] a [mee], pasando por mí o por [mar]."
    kia "Você é o fator comum para todos nós. De [kat] a [mee], passando por mim ou [mar]."

# game/scripts/c24/c24.rpy:1602
translate brazilian c24s003_KiaDate_ef310305:

    # mc "¿[kat]? Ella ya iba a venir a casa antes de que yo volviera de la universidad."
    mc "[kat]? Ela já estava voltando para casa antes de eu chegar da universidade."

# game/scripts/c24/c24.rpy:1604
translate brazilian c24s003_KiaDate_be7cdbc8:

    # kia "Sí, pero antes de que llegaran las chicas ya habías creado el ambiente que hay ahora."
    kia "Sim, mas antes da chegada das meninas você já havia criado a atmosfera que existe agora."

# game/scripts/c24/c24.rpy:1605
translate brazilian c24s003_KiaDate_3424a685:

    # kia "Sólo con la familia cercana, pero suficiente para que fuera fácil que ellas se sumaran. Después nos hemos sumado el resto."
    kia "Começou com a família mais próxima, mas foi o suficiente para que eles se juntassem facilmente. Depois, o resto de nós também entrou na brincadeira."

# game/scripts/c24/c24.rpy:1606
translate brazilian c24s003_KiaDate_e0583063:

    # mc "No hice nada de eso, [kia]. Me encanta que me veas así, pero no me puedo otorgar el mérito."
    mc "Eu não fiz nada disso, [kia]. Adoro que você me veja dessa forma, mas não posso levar o crédito por isso."

# game/scripts/c24/c24.rpy:1607
translate brazilian c24s003_KiaDate_3391d298:

    # mc "Además, estamos hablando mucho de la familia y poco de nosotros."
    mc "Além disso, falamos muito sobre família e muito pouco sobre nós mesmos."

# game/scripts/c24/c24.rpy:1609
translate brazilian c24s003_KiaDate_320e7130:

    # kia "Me da un poco de miedo hablar de nosotros. Hablar de ello lo hace demasiado real."
    kia "Tenho um pouco de medo de falar sobre nós. Falar sobre isso torna tudo muito real."

# game/scripts/c24/c24.rpy:1610
translate brazilian c24s003_KiaDate_7987df6b:

    # mc "¿Es por Solomon? ¿Porque aún sigues casada con él?"
    mc "É por causa de Salomão? Porque você ainda é casada com ele?"

# game/scripts/c24/c24.rpy:1612
translate brazilian c24s003_KiaDate_eba57e1f:

    # kia "En parte sí. Pese a que soy católica, no soy de esas que rechaza el divorcio, pero él sí. Nunca me lo va a dar."
    kia "Em parte, sim. Mesmo sendo católica, não sou daquelas que rejeitam o divórcio, mas ele rejeita. Ele nunca vai me conceder isso."

# game/scripts/c24/c24.rpy:1614
translate brazilian c24s003_KiaDate_ecbea4c6:

    # kia "Y aunque me lo diera, tú y yo no nos vamos a poder casar nunca."
    kia "E mesmo que ele me desse, você e eu nunca conseguiríamos nos casar."

# game/scripts/c24/c24.rpy:1615
translate brazilian c24s003_KiaDate_44b2af23:

    # kia "No sería justo que sólo una de nosotras se pudiera casar contigo, con lo que lo hemos hablado entre nosotras y ninguna va a aceptar casarse contigo."
    kia "Não seria justo se apenas um de nós pudesse se casar com você, então conversamos entre nós e nenhum de nós vai concordar em se casar com você."

# game/scripts/c24/c24.rpy:1617
translate brazilian c24s003_KiaDate_a7ce1239:

    # kia "Y eso hace que tú y yo no nos vayamos a casar nunca."
    kia "E isso significa que você e eu nunca vamos nos casar."

# game/scripts/c24/c24.rpy:1618
translate brazilian c24s003_KiaDate_18a88386:

    # mc "Se puede vivir una vida muy feliz sin estar casados, [kia]."
    mc "Você pode viver uma vida muito feliz sem ser casado, [kia]."

# game/scripts/c24/c24.rpy:1620
translate brazilian c24s003_KiaDate_93e42b6c:

    # kia "Lo sé, pero me educaron para casarme con el hombre de mi vida. Creí que era Solomon y resultó no serlo."
    kia "Eu sei, mas fui criada para casar com o homem dos meus sonhos. Pensei que fosse Salomão, mas acabou não sendo."

# game/scripts/c24/c24.rpy:1621
translate brazilian c24s003_KiaDate_fd166dc8:

    # kia "Y si al final lo eres tú, no podremos hacerlo."
    kia "E se for você, não poderemos fazer isso."

# game/scripts/c24/c24.rpy:1623
translate brazilian c24s003_KiaDate_04a0ca8e:

    # kia "No voy a decir que me entristezca tener una relación contigo sin estar casados, pero..."
    kia "Não vou dizer que estou triste por estar num relacionamento com você sem sermos casados, mas..."

# game/scripts/c24/c24.rpy:1624
translate brazilian c24s003_KiaDate_8d55fe6c:

    # mc "Te entiendo. Pero tiene difícil solución."
    mc "Entendo. Mas é um problema difícil de resolver."

# game/scripts/c24/c24.rpy:1625
translate brazilian c24s003_KiaDate_d912836c:

    # kia "Lo sé. Pero hablemos de cosas más alegres."
    kia "Eu sei. Mas vamos falar de coisas mais alegres."

# game/scripts/c24/c24.rpy:1627
translate brazilian c24s003_KiaDate_34ea56d4:

    # kia "[bet] me ha explicado lo que has hecho con la Iglesia en Monterey."
    kia "[bet] explicou-me o que você fez com a Igreja em Monterey."

# game/scripts/c24/c24.rpy:1628
translate brazilian c24s003_KiaDate_6753da62:

    # mc "*Risa* Tenías que haber visto la cara del pobre cura al final."
    mc "*Risos* Você devia ter visto a cara do pobre padre no final."

# game/scripts/c24/c24.rpy:1629
translate brazilian c24s003_KiaDate_a2e76ea8:

    # kia "Soy católica, pero no me gustan muchas de las cosas que hace la Iglesia."
    kia "Sou católico, mas não gosto de muitas coisas que a Igreja faz."

# game/scripts/c24/c24.rpy:1630
translate brazilian c24s003_KiaDate_e94bfd37:

    # "Empiezas a explicarle cómo ha ido la reunión. Ella ya lo sabe porque se lo ha explicado [bet], pero te escucha atentamente."
    "Você começa a explicar para ela como foi a reunião. Ela já sabe porque você explicou para ela [bet], mas ela escuta atentamente."

# game/scripts/c24/c24.rpy:1631
translate brazilian c24s003_KiaDate_3a324a98:

    # "Disfrutando del cambio de conversación."
    "Estou gostando da mudança de assunto."

# game/scripts/c24/c24.rpy:1633
translate brazilian c24s003_KiaDate_18f9417f:

    # "Cuando estás llegando al final de la explicación entra un grupo de ruidosos chicos, algo mayores que tú."
    "Quando você está quase terminando a explicação, um grupo de garotos barulhentos, um pouco mais velhos que você, entra."

# game/scripts/c24/c24.rpy:1634
translate brazilian c24s003_KiaDate_66f128d6:

    # "Todos se quedan mirando a [kia], que brilla como una estrella en el casi vacío restaurante."
    "Todos olham fixamente para [kia], que brilha como uma estrela no restaurante quase vazio."

# game/scripts/c24/c24.rpy:1636
translate brazilian c24s003_KiaDate_ea867ee3:

    # "[kia] se da cuenta de sus miradas y baja la suya."
    "[kia] percebe os olhares deles e baixa o seu próprio."

# game/scripts/c24/c24.rpy:1637
translate brazilian c24s003_KiaDate_2a7c7656:

    # mc "Te he dicho que sería la envidia del restaurante."
    mc "Eu te disse que seria a inveja do restaurante."

# game/scripts/c24/c24.rpy:1638
translate brazilian c24s003_KiaDate_99b16475:

    # kia "No estoy acostumbrada..."
    kia "Não estou acostumado com isso..."

# game/scripts/c24/c24.rpy:1639
translate brazilian c24s003_KiaDate_87be2d7e:

    # mc "Estoy seguro de que los chicos del instituto te miran igual en la biblioteca que esos de ahí."
    mc "Tenho certeza de que os alunos do ensino médio olham para você da mesma forma na biblioteca que olham para aqueles caras ali."

# game/scripts/c24/c24.rpy:1641
translate brazilian c24s003_KiaDate_bda69feb:

    # kia "¡Qué va! Miran a Gen. Es mucho más joven que yo."
    kia "De jeito nenhum! Estão de olho no Gen. Ele é bem mais novo do que eu."

# game/scripts/c24/c24.rpy:1642
translate brazilian c24s003_KiaDate_16a2e00a:

    # mc "Puede que sea más joven, pero no te cambiaría por dos Genevièves. Ni siquiera para hacer un trío con ellas dos."
    mc "Ela pode ser mais nova, mas eu não te trocaria por duas Genevièves. Nem mesmo por um ménage à trois com elas."

# game/scripts/c24/c24.rpy:1643
translate brazilian c24s003_KiaDate_5c527e8d:

    # mc "Ella es mona. Tú eres preciosa."
    mc "Ela é fofa. Você é linda."

# game/scripts/c24/c24.rpy:1645
translate brazilian c24s003_KiaDate_e3c79d87:

    # kia "Ellos no deben pensar lo mismo. Nunca me han mirado, y no es que me importe. Casi lo prefiero."
    kia "Eles não pensam da mesma forma. Nunca nem olharam para mim, e não que eu me importe. Quase prefiro assim."

# game/scripts/c24/c24.rpy:1646
translate brazilian c24s003_KiaDate_e03cdab1:

    # mc "Geneviève va maquillada al trabajo. Cada vez que te he visto ir a la biblioteca, excepto el día que quedamos para comer, ibas sin maquillaje."
    mc "Geneviève usa maquiagem para trabalhar. Todas as vezes que te vi ir à biblioteca, exceto no dia em que nos encontramos para almoçar, você estava sem maquiagem."

# game/scripts/c24/c24.rpy:1647
translate brazilian c24s003_KiaDate_7d344cf0:

    # mc "Y no quiero decir que lo necesites para estar preciosa. Pero en igualdad de condiciones, estoy seguro de que nadie miraría a Geneviève."
    mc "E não estou dizendo que você precisa disso para ser bonita. Mas, em condições iguais, tenho certeza de que ninguém olharia para Geneviève."

# game/scripts/c24/c24.rpy:1649
translate brazilian c24s003_KiaDate_4db88899:

    # kia "*Risita* Ahora voy maquillada todos los días. Por si decides pasarte por la biblioteca. Sé que te gusta." id c24s003_KiaDate_4db88899
    kia "*Risos* Agora eu uso maquiagem todos os dias. Só por precaução, caso você resolva dar uma passadinha na biblioteca. Eu sei que você gosta." id c24s003_KiaDate_4db88899

# game/scripts/c24/c24.rpy:1650
translate brazilian c24s003_KiaDate_4c98d145:

    # mc "Tendré que hacerlo más a menudo. Aunque solo sea para hacer esto."
    mc "Vou ter que fazer isso com mais frequência. Nem que seja só para fazer isso."

# game/scripts/c24/c24.rpy:1654
translate brazilian c24s003_KiaDate_32860475:

    # "La besas sin avisarla. Lo que empieza como un dulce beso, acaba como el beso que os habéis dado en la habitación."
    "Você a beija sem aviso prévio. O que começa como um beijo doce termina como o beijo que vocês trocaram no quarto."

# game/scripts/c24/c24.rpy:1655
translate brazilian c24s003_KiaDate_29306c14:

    # "No puedes evitar desear abrir los ojos para ver la cara de los ruidosos chicos cuando oyes sus sonidos de sorpresa."
    "É impossível não querer abrir os olhos para ver o rosto dos meninos barulhentos ao ouvir suas reações de surpresa."

# game/scripts/c24/c24.rpy:1656
translate brazilian c24s003_KiaDate_327ef64d:

    # "Pero después del primer segundo, no existen para ti. Tan solo existen vuestros labios y vuestras lenguas rozándose y jugando."
    "Mas, após o primeiro segundo, eles deixam de existir para você. Só existem seus lábios e línguas, roçando um no outro e brincando."

# game/scripts/c24/c24.rpy:1657
translate brazilian c24s003_KiaDate_5e918d8d:

    # "Escribiendo con saliva una carta de amor."
    "Escrevendo uma carta de amor com saliva."

# game/scripts/c24/c24.rpy:1659
translate brazilian c24s003_KiaDate_c46855bc:

    # mc "Creía que no te gustaban las parejas que se enrollan en público."
    mc "Pensei que você não gostasse de casais que se beijam em público."

# game/scripts/c24/c24.rpy:1660
translate brazilian c24s003_KiaDate_1f661852:

    # kia "Y no me gustan, pero no sé si has oído al grupo de chicos. Se han sorprendido cuando me has besado."
    kia "E eu não gosto deles, mas não sei se você ouviu o grupo de garotos. Eles ficaram surpresos quando você me beijou."

# game/scripts/c24/c24.rpy:1661
translate brazilian c24s003_KiaDate_65f9676b:

    # mc "Sí..."
    mc "Sim..."

# game/scripts/c24/c24.rpy:1663
translate brazilian c24s003_KiaDate_eadb2922:

    # kia "Pues me ha encantado ese sonido."
    kia "Bem, eu adorei esse som."

# game/scripts/c24/c24.rpy:1664
translate brazilian c24s003_KiaDate_961be510:

    # mc "*Risa* Por mí pueden sorprenderse todo lo que quieran. Soy el tío más afortunado en el restaurante."
    mc "*Risos* Eles podem ficar tão surpresos quanto quiserem. Eu sou o cara mais sortudo do restaurante."

# game/scripts/c24/c24.rpy:1665
translate brazilian c24s003_KiaDate_2e8f6f7b:

    # mc "En el mundo."
    mc "No mundo."

# game/scripts/c24/c24.rpy:1667
translate brazilian c24s003_KiaDate_dbb63d53:

    # kia "Además de eso..."
    kia "Além disso..."

# game/scripts/c24/c24.rpy:1668
translate brazilian c24s003_KiaDate_a3db9a7f:

    # mc "¿Qué?"
    mc "Que?"

# game/scripts/c24/c24.rpy:1669
translate brazilian c24s003_KiaDate_b22ca392:

    # kia "Hoy he entendido por primera vez a esas parejas. Me daba lo mismo que estuviéramos en público. Era como si sólo existiéramos tú y yo."
    kia "Hoje finalmente entendi aqueles casais. Não me importava que estivéssemos em público. Era como se só existíssemos nós dois."

# game/scripts/c24/c24.rpy:1670
translate brazilian c24s003_KiaDate_a2ab25f7:

    # mc "Es que solo existimos tú y yo, cielo."
    mc "Somos só nós dois, querida."

# game/scripts/c24/c24.rpy:1672
translate brazilian c24s003_KiaDate_de836a6e:

    # "Vuelves a besarla para demostrárselo."
    "Você a beija novamente para mostrar a ela."

# game/scripts/c24/c24.rpy:1673
translate brazilian c24s003_KiaDate_dc92a470:

    # "Vuelve a besarte para decirte que está de acuerdo."
    "Ele te beija novamente para dizer que concorda."

# game/scripts/c24/c24.rpy:1674
translate brazilian c24s003_KiaDate_23adfe77:

    # "Esta vez no escucháis sonidos de sorpresa. No hay nadie para emitirlos."
    "Desta vez, você não ouve nenhum som de surpresa. Não há ninguém aqui para proferi-los."

# game/scripts/c24/c24.rpy:1676
translate brazilian c24s003_KiaDate_a23cf46f:

    # kia "Necesito beber algo... y recuperar el aliento."
    kia "Preciso beber alguma coisa... e recuperar o fôlego."

# game/scripts/c24/c24.rpy:1677
translate brazilian c24s003_KiaDate_319ec1d2:

    # mc "La combinación del filete con tu pintalabios también está deliciosa."
    mc "A combinação de bife com batom também é deliciosa."

# game/scripts/c24/c24.rpy:1678
translate brazilian c24s003_KiaDate_be8e3a1f:

    # mc "Ahora me gustaría probarla con el mosto."
    mc "Agora eu gostaria de experimentar com o must."

# game/scripts/c24/c24.rpy:1680
translate brazilian c24s003_KiaDate_1033a2cc:

    # "[kia] bebe un largo sorbo de mosto mientras aparta la mirada. Esperas que acabe para volver a besarla."
    "[kia] Ela toma um longo gole de suco de uva enquanto desvia o olhar. Você espera que ela termine para poder beijá-la novamente."

# game/scripts/c24/c24.rpy:1682
translate brazilian c24s003_KiaDate_b838b453:

    # kia "Creo que deberíamos dejar los besos para después. O se nos va a hacer tarde para ir donde te quiero llevar."
    kia "Acho que devemos deixar os beijos para depois. Senão, vamos nos atrasar para onde eu quero te levar."

# game/scripts/c24/c24.rpy:1683
translate brazilian c24s003_KiaDate_f3a3e63d:

    # kia "Allí podremos besarnos todo lo que quieras. No hay nadie nunca."
    kia "Lá podemos nos beijar o quanto quisermos. Nunca há ninguém por perto."

# game/scripts/c24/c24.rpy:1684
translate brazilian c24s003_KiaDate_86071e2e:

    # mc "¿Pido la cuenta entonces?"
    mc "Devo pedir a conta então?"

# game/scripts/c24/c24.rpy:1686
translate brazilian c24s003_KiaDate_eb1388a2:

    # kia "*Risa* ¿Tan ansioso estás? ¿No quieres postre?"
    kia "*Risos* Você está tão ansioso assim? Não quer sobremesa?"

# game/scripts/c24/c24.rpy:1687
translate brazilian c24s003_KiaDate_d117af68:

    # mc "Voy a sonar cursi, pero acabo de besar los labios más dulces. Cualquier postre me sabrá soso."
    mc "Sei que vai soar piegas, mas acabei de beijar os lábios mais doces. Qualquer sobremesa vai ter gosto de sobremesa para mim."

# game/scripts/c24/c24.rpy:1689
translate brazilian c24s003_KiaDate_767fc431:

    # kia "*Risa* Pues sí, has sonado cursi. Pero me encanta."
    kia "*Risos* É, você soou piegas. Mas eu adorei."

# game/scripts/c24/c24.rpy:1690
translate brazilian c24s003_KiaDate_3957492e:

    # kia "Pide la cuenta mientras voy al lavabo. Seguro que me tengo que retocar el pintalabios."
    kia "Peça a conta enquanto vou ao banheiro. Tenho certeza de que preciso retocar o batom."

# game/scripts/c24/c24.rpy:1692
translate brazilian c24s003_KiaDate_ff456594:

    # kia "No pagues. Hoy me toca a mí."
    kia "Não pague. Hoje é a minha vez."

# game/scripts/c24/c24.rpy:1693
translate brazilian c24s003_KiaDate_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c24/c24.rpy:1695
translate brazilian c24s003_KiaDate_a4273a91:

    # "La preciosa bibliotecaria te da un suave beso indicando que no empieces una discusión que no vas a ganar."
    "A adorável bibliotecária lhe dá um beijo suave, indicando que você não deve iniciar uma discussão que não vai vencer."

# game/scripts/c24/c24.rpy:1697
translate brazilian c24s003_KiaDate_31a63462:

    # "Pides la cuenta y te das cuenta de que el restaurante sigue medio vacío. Aunque hayáis acabado de cenar, sigue siendo pronto."
    "Você pede a conta e percebe que o restaurante ainda está meio vazio. Mesmo tendo terminado o jantar, ainda é cedo."

# game/scripts/c24/c24.rpy:1698
translate brazilian c24s003_KiaDate_e9534601:

    # "Siempre te ha gustado hacer figuritas con la capa de estaño que protege el corcho."
    "Você sempre gostou de fazer pequenas figuras com a camada de estanho que protege a cortiça."

# game/scripts/c24/c24.rpy:1699
translate brazilian c24s003_KiaDate_1d6014e1:

    # "Empiezas a juguetear con la cápsula del mosto mientras tu mente divaga, pensando en la conversación que habéis tenido."
    "Você começa a mexer na cápsula enquanto sua mente divaga, pensando na conversa que teve."

# game/scripts/c24/c24.rpy:1700
translate brazilian c24s003_KiaDate_0a131c61:

    # "La camarera trae la cuenta al mismo tiempo que [kia] vuelve del lavabo."
    "A garçonete traz a conta ao mesmo tempo que [kia] retorna do banheiro."

# game/scripts/c24/c24.rpy:1702
translate brazilian c24s003_KiaDate_95755e39:

    # "Cuando vuelve [kia]..."
    "Quando [kia] retornar..."

# game/scripts/c24/c24.rpy:1703
translate brazilian c24s003_KiaDate_1ec91d72:

    # wai "¿Estaba todo a su gusto?"
    wai "Estava tudo do seu agrado?"

# game/scripts/c24/c24.rpy:1704
translate brazilian c24s003_KiaDate_cfcef8ad:

    # mc "Sí, todo perfecto."
    mc "Sim, está tudo perfeito."

# game/scripts/c24/c24.rpy:1705
translate brazilian c24s003_KiaDate_7965fbc1:

    # kia "Un sitio muy bonito y con una calidad excelente. Volveremos."
    kia "Um lugar lindíssimo, com excelente qualidade. Voltaremos."

# game/scripts/c24/c24.rpy:1707
translate brazilian c24s003_KiaDate_6ec69178:

    # "Después de que [kia] pague la cuenta, una vez en el coche..."
    "Depois que [kia] pagar a conta, assim que entrar no carro..."

# game/scripts/c24/c24.rpy:1708
translate brazilian c24s003_KiaDate_55c4ae5e:

    # mc "¿Siguiente parada?"
    mc "Próxima parada?"

# game/scripts/c24/c24.rpy:1709
translate brazilian c24s003_KiaDate_cf0aee0d:

    # kia "Ahí es donde está la sorpresa."
    kia "É aí que reside a surpresa."

# game/scripts/c24/c24.rpy:1710
translate brazilian c24s003_KiaDate_35bb01ce:

    # mc "Tenía que intentarlo."
    mc "Eu tive que tentar."

# game/scripts/c24/c24.rpy:1712
translate brazilian c24s003_KiaDate_5e17a1ec:

    # kia "Aunque me gustaría explicártelo, no lo podrías entender hasta que lo vieras, con lo que prefiero llevarte allí."
    kia "Embora eu quisesse explicar para você, você não entenderia até ver com os próprios olhos, então prefiro te levar lá."

# game/scripts/c24/c24.rpy:1713
translate brazilian c24s003_KiaDate_3937d899:

    # mc "Cada vez estás más misteriosa. *Risa*"
    mc "Você está se tornando cada vez mais misterioso(a). *Risos*"

# game/scripts/c24/c24.rpy:1714
translate brazilian c24s003_KiaDate_bbf64fe2:

    # kia "Allí te explicaré por qué me gusta ese sitio. Pero nos tenemos que ir ya o no llegaremos a tiempo."
    kia "Eu explico lá por que gosto tanto daquele lugar. Mas precisamos ir agora, senão não chegaremos a tempo."

# game/scripts/c24/c24.rpy:1716
translate brazilian c24s003_KiaDate_eb706e74:

    # mc "Entonces vamos. Quiero saberlo todo de ti."
    mc "Então vamos lá. Quero saber tudo sobre você."

# game/scripts/c24/c24.rpy:1726
translate brazilian c24s003_KiaBeach_c321fe03:

    # "[kia] conduce diez minutos por una carretera estrecha hasta llegar a un camino sin asfaltar cerca del mar, donde aparca el coche."
    "[kia] Ele dirige por dez minutos ao longo de uma estrada estreita até chegar a uma trilha não pavimentada perto do mar, onde estaciona o carro."

# game/scripts/c24/c24.rpy:1727
translate brazilian c24s003_KiaBeach_b0d89349:

    # "Ella coge su bolso y te toca cargar con la bolsa del maletero."
    "Ela pega a bolsa e você tem que carregá-la do porta-malas."

# game/scripts/c24/c24.rpy:1728
translate brazilian c24s003_KiaBeach_e1a61012:

    # mc "¿Aquí? ¿En medio de la nada?"
    mc "Aqui? No meio do nada?"

# game/scripts/c24/c24.rpy:1729
translate brazilian c24s003_KiaBeach_adb64eac:

    # kia "*Risa* No, tenemos que caminar un par de minutos."
    kia "*Risos* Não, temos que caminhar por alguns minutos."

# game/scripts/c24/c24.rpy:1730
translate brazilian c24s003_KiaBeach_42b7ae76:

    # mc "Déjame llevar la bolsa."
    mc "Deixe-me carregar a sacola."

# game/scripts/c24/c24.rpy:1731
translate brazilian c24s003_KiaBeach_0589cccb:

    # kia "Vale, pero no la abras."
    kia "Certo, mas não abra."

# game/scripts/c24/c24.rpy:1732
translate brazilian c24s003_KiaBeach_6882bb03:

    # "Más misterios."
    "Mais mistérios."

# game/scripts/c24/c24.rpy:1734
translate brazilian c24s003_KiaBeach_d153e3b3:

    # "Tras dos minutos andando por el camino de tierra, puedes ver el que supones que es el lugar al que [kia] se refería."
    "Após caminhar por dois minutos pela estrada de terra, você pode ver o que você presume ser o lugar ao qual [kia] estava se referindo."

# game/scripts/c24/c24.rpy:1735
translate brazilian c24s003_KiaBeach_5ce76cd8:

    # "Con el tiempo perfectamente medido, llegáis cuando el cielo empieza a teñirse de naranja con la puesta de sol."
    "Com o momento perfeitamente calculado, você chega quando o céu começa a ficar alaranjado com o pôr do sol."

# game/scripts/c24/c24.rpy:1737
translate brazilian c24s003_KiaBeach_5bcc7d86:

    # mc "¡Es precioso! No había estado nunca aquí."
    mc "É lindo! Nunca estive aqui antes."

# game/scripts/c24/c24.rpy:1738
translate brazilian c24s003_KiaBeach_17ca26fa:

    # kia "Está escondido. Lo descubrí un día mirando mapas en internet. Marcaba que había un mirador y decidí venir a verlo."
    kia "Está escondido. Descobri-o um dia enquanto olhava mapas online. Mostrava um mirante, então decidi vir conferir."

# game/scripts/c24/c24.rpy:1739
translate brazilian c24s003_KiaBeach_c365e15c:

    # kia "Me gustó el sitio el primer día que vine. Me enamoré de él la primera vez que vine a ver la puesta de sol."
    kia "Gostei do lugar no primeiro dia em que o visitei. Apaixonei-me por ele na primeira vez que vim ver o pôr do sol."

# game/scripts/c24/c24.rpy:1740
translate brazilian c24s003_KiaBeach_3e0e061e:

    # kia "Hoy la marea está baja y es menos espectacular, pero sigue siendo muy bonito."
    kia "Hoje a maré está baixa e o espetáculo é menos impressionante, mas ainda assim é muito bonito."

# game/scripts/c24/c24.rpy:1741
translate brazilian c24s003_KiaBeach_2eaf27bc:

    # kia "Vamos a aquella punta y déjame sacar una cosa de la bolsa."
    kia "Vamos direto ao ponto e deixe-me revelar algo importante."

# game/scripts/c24/c24.rpy:1743
translate brazilian c24s003_KiaBeach_a87881f2:

    # "Siendo una mujer previsora, ha traído una manta de picnic, en la que se sienta tras extenderla."
    "Por ser uma mulher que planeja com antecedência, ela trouxe uma manta de piquenique, sobre a qual se senta depois de estendê-la."

# game/scripts/c24/c24.rpy:1744
translate brazilian c24s003_KiaBeach_d9cb06de:

    # mc "Hay un banco justo ahí detrás..."
    mc "Tem um banco ali atrás..."

# game/scripts/c24/c24.rpy:1745
translate brazilian c24s003_KiaBeach_447b9601:

    # kia "*Risa* Siempre está lleno de cacas de gaviota. Por eso vengo con la manta."
    kia "*Risos* Está sempre cheio de cocô de gaivota. Por isso que levo um cobertor."

# game/scripts/c24/c24.rpy:1746
translate brazilian c24s003_KiaBeach_f978bbdc:

    # mc "*Risa* Ni me había fijado. Me hubiera llevado un montón de cacas a casa pegadas en los pantalones."
    mc "*Risos* Nem tinha reparado. Ia chegar em casa com um monte de cocô grudado nas calças."

# game/scripts/c24/c24.rpy:1748
translate brazilian c24s003_KiaBeach_3c569df0:

    # "Te tumbas a su lado. Mirarla desde abajo, por una vez, te da una perspectiva diferente de su belleza."
    "Você se deita ao lado dela. Observá-la de baixo, pela primeira vez, lhe proporciona uma perspectiva diferente de sua beleza."

# game/scripts/c24/c24.rpy:1749
translate brazilian c24s003_KiaBeach_24dafdd2:

    # kia "*Risa* Por suerte vienes con una mujer previsora."
    kia "*Risos* Ainda bem que você está com uma mulher que planeja com antecedência."

# game/scripts/c24/c24.rpy:1750
translate brazilian c24s003_KiaBeach_728c6dcc:

    # mc "Una mujer que me tiene que explicar la historia de este sitio para ella, aparte de encontrarlo en un mapa por casualidad."
    mc "Uma mulher que precisa me explicar a história deste lugar, além de tê-lo encontrado por acaso num mapa."

# game/scripts/c24/c24.rpy:1752
translate brazilian c24s003_KiaBeach_a7c3bcd5:

    # kia "No es una historia alegre..."
    kia "Não é uma história feliz..."

# game/scripts/c24/c24.rpy:1753
translate brazilian c24s003_KiaBeach_03418fd9:

    # mc "Pero es tu historia. Quiero escucharla."
    mc "Mas é a sua história. Quero ouvi-la."

# game/scripts/c24/c24.rpy:1755
translate brazilian c24s003_KiaBeach_1c484da6:

    # kia "Lo descubrí el verano de hace seis años. Unos meses antes de que [eil.nick] y tú empezarais a salir."
    kia "Eu o descobri há seis anos, no verão. Alguns meses antes de você e [eil.nick] começarem a namorar."

# game/scripts/c24/c24.rpy:1756
translate brazilian c24s003_KiaBeach_714a706b:

    # kia "Ella se fue dos semanas a un campamento de animadoras y estaba en casa sola con Solomon."
    kia "Ela foi para um acampamento de líderes de torcida por duas semanas e ficou sozinha em casa com Solomon."

# game/scripts/c24/c24.rpy:1757
translate brazilian c24s003_KiaBeach_83fbd330:

    # kia "Por entonces Solomon bebía y estaba agresivo. No tanto como se puso después."
    kia "Naquela época, Salomão bebia e era agressivo. Não tão ruim quanto se tornou depois."

# game/scripts/c24/c24.rpy:1758
translate brazilian c24s003_KiaBeach_b8ff51ed:

    # mc "Recuerdo como empeoró durante el año siguiente..."
    mc "Lembro-me de como a situação piorou no ano seguinte..."

# game/scripts/c24/c24.rpy:1760
translate brazilian c24s003_KiaBeach_2f40382c:

    # kia "Exacto. Él trabajaba en el turno de tarde en la fábrica aquel verano, con lo que yo estaba sola en casa casi todo el día."
    kia "Exatamente. Ele estava trabalhando no turno da tarde na fábrica naquele verão, então eu ficava sozinha em casa quase o dia todo."

# game/scripts/c24/c24.rpy:1761
translate brazilian c24s003_KiaBeach_401b72ff:

    # kia "Por la mañana él dormía, se levantaba, iba a trabajar, volvía de noche y bebía hasta caer dormido."
    kia "De manhã, ele dormia, levantava, ia trabalhar, voltava à noite e bebia até adormecer."

# game/scripts/c24/c24.rpy:1762
translate brazilian c24s003_KiaBeach_68db1dba:

    # kia "En los días buenos."
    kia "Em dias bons."

# game/scripts/c24/c24.rpy:1763
translate brazilian c24s003_KiaBeach_fb61827f:

    # mc "Una vida de mierda que eligió él."
    mc "Uma vida de merda que ele escolheu."

# game/scripts/c24/c24.rpy:1764
translate brazilian c24s003_KiaBeach_46f639b5:

    # kia "Sí, y que nos hacía pagar a [eil.nick] y a mí."
    kia "Sim, e que ele nos fez pagar [eil.nick] e a mim."

# game/scripts/c24/c24.rpy:1766
translate brazilian c24s003_KiaBeach_1b5d6271:

    # kia "Pero a lo que iba... Cuando se iba a trabajar, no quería estar sola en casa. Me parecía opresiva."
    kia "Mas o que eu queria dizer era... Quando ela ia trabalhar, não queria ficar sozinha em casa. Eu achava isso opressivo."

# game/scripts/c24/c24.rpy:1767
translate brazilian c24s003_KiaBeach_d5176a34:

    # kia "Empecé a conducir sin rumbo fijo. Después de un par de días, empecé a buscar en internet sitios cerca de Newport donde no hubiera estado nunca."
    kia "Comecei a dirigir sem rumo. Depois de alguns dias, comecei a pesquisar online lugares perto de Newport onde eu nunca tinha estado antes."

# game/scripts/c24/c24.rpy:1768
translate brazilian c24s003_KiaBeach_b6967b68:

    # mc "Lo entiendo..."
    mc "Eu entendo..."

# game/scripts/c24/c24.rpy:1770
translate brazilian c24s003_KiaBeach_5997eb17:

    # kia "Descubrí algunos sitios bonitos, pero ninguno como este. Se convirtió en mi lugar favorito."
    kia "Descobri lugares lindos, mas nenhum como este. Tornou-se meu lugar favorito."

# game/scripts/c24/c24.rpy:1771
translate brazilian c24s003_KiaBeach_575229bd:

    # kia "Me daba... paz."
    kia "Isso me trouxe... paz."

# game/scripts/c24/c24.rpy:1772
translate brazilian c24s003_KiaBeach_7ee7c847:

    # kia "Aquí me sentía segura. Sola pero segura."
    kia "Eu me senti segura aqui. Sozinha, mas segura."

# game/scripts/c24/c24.rpy:1774
translate brazilian c24s003_KiaBeach_87833168:

    # kia "Aquí nadie me decía que era una inútil ni me agarraba del pelo, llevándome por la casa para enseñarme lo que había hecho mal."
    kia "Ninguém aqui me disse que eu era inútil ou me agarrou pelos cabelos, me arrastando pela casa para me mostrar o que eu tinha feito de errado."

# game/scripts/c24/c24.rpy:1776
translate brazilian c24s003_KiaBeach_6740bf72:

    # kia "Me podía imaginar navegando hacia la puesta de sol en un barco con [eil.nick]. Para no volver nunca."
    kia "Eu podia me imaginar navegando rumo ao pôr do sol em um barco com [eil.nick]. Para nunca mais voltar."

# game/scripts/c24/c24.rpy:1778
translate brazilian c24s003_KiaBeach_fb35d1b6:

    # kia "Sé que es una tontería. El sueño de un ama de casa infeliz."
    kia "Eu sei que é bobagem. O sonho de uma dona de casa infeliz."

# game/scripts/c24/c24.rpy:1779
translate brazilian c24s003_KiaBeach_b7bf6898:

    # kia "Pero me daba tranquilidad."
    kia "Mas isso me trouxe paz de espírito."

# game/scripts/c24/c24.rpy:1780
translate brazilian c24s003_KiaBeach_b1600ea5:

    # mc "Lo entiendo, pero ¿por qué volver ahora que has dejado eso atrás?"
    mc "Eu entendo, mas por que voltar agora que você deixou isso para trás?"

# game/scripts/c24/c24.rpy:1782
translate brazilian c24s003_KiaBeach_4fb7752b:

    # kia "Porque, aunque sea un sitio que evoca recuerdos oscuros, hace que los recuerdos felices que estamos creando se vean más brillantes."
    kia "Porque, embora seja um lugar que evoca memórias sombrias, faz com que as memórias felizes que estamos criando pareçam mais brilhantes."

# game/scripts/c24/c24.rpy:1783
translate brazilian c24s003_KiaBeach_8a3915a6:

    # kia "Y porque es un lugar precioso que quería compartir contigo."
    kia "E porque é um lugar lindo que eu queria compartilhar com vocês."

# game/scripts/c24/c24.rpy:1784
translate brazilian c24s003_KiaBeach_cd6b8591:

    # mc "Entonces deberíamos empezar a crear recuerdos felices aquí, ¿no?"
    mc "Então, não deveríamos começar a criar memórias felizes aqui?"

# game/scripts/c24/c24.rpy:1786
translate brazilian c24s003_KiaBeach_6dc0e356:

    # kia "Estar aquí hoy, contigo, ya es un recuerdo feliz, aunque lo esté viviendo ahora mismo."
    kia "Estar aqui hoje, com vocês, já é uma lembrança feliz, mesmo que eu esteja vivendo isso agora."

# game/scripts/c24/c24.rpy:1787
translate brazilian c24s003_KiaBeach_f93717c6:

    # mc "Pienso lo mismo. Pero me has prometido que habría besos aquí."
    mc "Eu penso o mesmo. Mas você me prometeu que haveria beijos aqui."

# game/scripts/c24/c24.rpy:1789
translate brazilian c24s003_KiaBeach_1e80552e:

    # kia "*Risa* Si empezamos a besarnos, nos perderemos la puesta de sol."
    kia "*Risos* Se começarmos a nos beijar, vamos perder o pôr do sol."

# game/scripts/c24/c24.rpy:1790
translate brazilian c24s003_KiaBeach_9482bb51:

    # mc "Prefiero mirarte a ti que a la puesta de sol. Además, aún queda mucho."
    mc "Prefiro olhar para você do que para o pôr do sol. Além disso, ainda temos bastante tempo."

# game/scripts/c24/c24.rpy:1792
translate brazilian c24s003_KiaBeach_18249387:

    # kia "A mí me puedes mirar cuando quieras. La puesta de sol sólo dura un segundo."
    kia "Você pode me olhar quando quiser. O pôr do sol dura apenas um segundo."

# game/scripts/c24/c24.rpy:1793
translate brazilian c24s003_KiaBeach_477b69bf:

    # mc "Entonces déjame hacer algo antes de que se ponga el sol. Sé que puede parecerte una tontería."
    mc "Então deixe-me fazer algo antes do pôr do sol. Eu sei que pode parecer bobagem para você."

# game/scripts/c24/c24.rpy:1795
translate brazilian c24s003_KiaBeach_5d83a112:

    # kia "Ahora soy yo la que tiene curiosidad por lo que vas a hacer."
    kia "Agora sou eu que estou curioso para saber o que você vai fazer."

# game/scripts/c24/c24.rpy:1796
translate brazilian c24s003_KiaBeach_e29a6b75:

    # mc "Antes has dicho que tú y yo no nos podríamos casar nunca. Porque Solomon nunca te dará el divorcio."
    mc "Você disse antes que nós dois nunca poderíamos nos casar, porque Salomão nunca lhe concederia o divórcio."

# game/scripts/c24/c24.rpy:1799
translate brazilian c24s003_KiaBeach_5b9f333e:

    # mc "Y porque, aunque te lo diera, sería injusto que solo me casara contigo."
    mc "E porque, mesmo que eu te desse, seria injusto se eu me casasse apenas com você."

# game/scripts/c24/c24.rpy:1801
translate brazilian c24s003_KiaBeach_14df12c2:

    # mc "Y, aunque te lo diera, pasarían meses antes de que pudiéramos hacer algo así."
    mc "E mesmo que eu lhe desse, levariam meses até que pudéssemos fazer algo assim."

# game/scripts/c24/c24.rpy:1802
translate brazilian c24s003_KiaBeach_8ea327c4:

    # kia "Sí. Pero lo entiendo, aunque me hubiera gustado si todo esto hubiera pasado en otras circunstancias."
    kia "Sim. Mas eu entendo, embora preferisse que tudo isso tivesse acontecido em outras circunstâncias."

# game/scripts/c24/c24.rpy:1804
translate brazilian c24s003_KiaBeach_c9956e94:

    # mc "Podemos crear nuestras propias circunstancias."
    mc "Podemos criar as nossas próprias circunstâncias."

# game/scripts/c24/c24.rpy:1805
translate brazilian c24s003_KiaBeach_3952fb47:

    # kia "¿A qué te refieres?"
    kia "O que você está falando?"

# game/scripts/c24/c24.rpy:1807
translate brazilian c24s003_KiaBeach_fdb6c9c3:

    # mc "[kia] Wellesley, ¿quieres casarte conmigo aunque nunca lo legalicemos?"
    mc "[kia] Wellesley, você quer casar comigo mesmo que nunca oficializemos a união?"

# game/scripts/c24/c24.rpy:1808
translate brazilian c24s003_KiaBeach_757bfbc7:

    # mc "Estaremos casados a nuestros ojos, aunque no lo estemos a los ojos del mundo."
    mc "Estaremos casados aos nossos próprios olhos, mesmo que não estejamos casados aos olhos do mundo."

# game/scripts/c24/c24.rpy:1809
translate brazilian c24s003_KiaBeach_adbf85c5:

    # kia "¿QUÉ?"
    kia "QUE?"

# game/scripts/c24/c24.rpy:1810
translate brazilian c24s003_KiaBeach_56304b23:

    # kia "¿De dónde has sacado un anillo?"
    kia "Onde você comprou o anel?"

# game/scripts/c24/c24.rpy:1811
translate brazilian c24s003_KiaBeach_a237cbdb:

    # mc "Del bolsillo..."
    mc "Do meu bolso..."

# game/scripts/c24/c24.rpy:1813
translate brazilian c24s003_KiaBeach_1da5a730:

    # kia "Me refiero... ¿Tenías esto planeado? ¿Has llevado un anillo todo este tiempo?"
    kia "Quer dizer... Você planejou isso? Você estava usando um anel esse tempo todo?"

# game/scripts/c24/c24.rpy:1814
translate brazilian c24s003_KiaBeach_e6ec41e7:

    # mc "No, cielo. Sé que es un muy cutre, pero lo he hecho con el estaño del tapón del mosto cuando has ido al lavabo."
    mc "Não, querida. Eu sei que é bem barato, mas eu fiz com a latinha da tampa do frasco de mosto que você usava quando ia ao banheiro."

# game/scripts/c24/c24.rpy:1818
translate brazilian c24s003_KiaBeach_f35fd59b:

    # mc "Mis dedos han empezado a jugar con el metal y ha salido un anillo. Mi subconsciente me ha dicho que tenía que pedirte que te casaras conmigo."
    mc "Meus dedos começaram a brincar com o metal e um anel apareceu. Meu subconsciente me disse que eu tinha que te pedir em casamento."

# game/scripts/c24/c24.rpy:1820
translate brazilian c24s003_KiaBeach_d4001fa4:

    # kia "¡Sí quiero!"
    kia "Sim, eu quero!"

# game/scripts/c24/c24.rpy:1821
translate brazilian c24s003_KiaBeach_8162835f:

    # mc "Te prometo cambiarlo por uno de verdad en cuanto pueda."
    mc "Prometo substituí-lo por um verdadeiro assim que puder."

# game/scripts/c24/c24.rpy:1823
translate brazilian c24s003_KiaBeach_c774bda3:

    # "Tu prometida se lanza a tus labios con una pasión desconocida hasta ese momento."
    "Sua noiva se atira aos seus lábios com uma paixão desconhecida até aquele momento."

# game/scripts/c24/c24.rpy:1825
translate brazilian c24s003_KiaBeach_63ac09ce:

    # kia "Sí quiero. No te puedes imaginar lo bonito que es lo que acabas de hacer."
    kia "Sim, eu sei. Você não imagina o quão lindo foi o que você acabou de fazer."

# game/scripts/c24/c24.rpy:1826
translate brazilian c24s003_KiaBeach_d572b899:

    # mc "Sólo es un anillo hecho con el estaño de una botella..."
    mc "É apenas um anel feito com a lata de uma garrafa..."

# game/scripts/c24/c24.rpy:1827
translate brazilian c24s003_KiaBeach_b8fa6c64:

    # kia "No es el anillo. Es el hecho. Sabías que era importante para mí y lo has hecho."
    kia "Não é o anel. É a atitude. Você sabia que era importante para mim, e você fez."

# game/scripts/c24/c24.rpy:1830
translate brazilian c24s003_KiaBeach_7a750b76:

    # kia "Pero tengo que poner una condición."
    kia "Mas preciso estabelecer uma condição."

# game/scripts/c24/c24.rpy:1831
translate brazilian c24s003_KiaBeach_77c47ed2:

    # mc "¿Cuál?"
    mc "Qual?"

# game/scripts/c24/c24.rpy:1832
translate brazilian c24s003_KiaBeach_ab2e544a:

    # kia "Que yo no sea la única a quién se lo pidas."
    kia "Não quero ser o único a quem você pergunta."

# game/scripts/c24/c24.rpy:1833
translate brazilian c24s003_KiaBeach_18f223f2:

    # mc "Me parece una condición que puedo cumplir."
    mc "Acho que é uma condição que posso cumprir."

# game/scripts/c24/c24.rpy:1834
translate brazilian c24s003_KiaBeach_3f179b78:

    # mc "Y vuelve a demostrar lo maravillosa que eres."
    mc "E mostre-nos mais uma vez o quão maravilhoso você é."

# game/scripts/c24/c24.rpy:1836
translate brazilian c24s003_KiaBeach_2e521197:

    # kia "¿Por qué?"
    kia "Porque?"

# game/scripts/c24/c24.rpy:1837
translate brazilian c24s003_KiaBeach_8b4e3db9:

    # mc "Porque en un momento importante para ti, lo que haces es pensar en otras personas."
    mc "Porque num momento importante para você, o que você faz é pensar nos outros."

# game/scripts/c24/c24.rpy:1838
translate brazilian c24s003_KiaBeach_0356e1ef:

    # kia "Es lo lógico, ¿no? Somos una familia..."
    kia "Essa é a coisa lógica a se fazer, não é? Somos uma família..."

# game/scripts/c24/c24.rpy:1839
translate brazilian c24s003_KiaBeach_3672b52e:

    # mc "Sí, es lo lógico. Pero no todo el mundo lo haría en tus circunstancias."
    mc "Sim, faz sentido. Mas nem todos fariam isso nas suas circunstâncias."

# game/scripts/c24/c24.rpy:1841
translate brazilian c24s003_KiaBeach_b351e505:

    # mc "Lo que es importante para ti, es importante para mí."
    mc "O que é importante para você é importante para mim."

# game/scripts/c24/c24.rpy:1843
translate brazilian c24s003_KiaBeach_1c9399f7:

    # kia "¿Puedo volver a besar a mi prometido?"
    kia "Posso beijar meu noivo de novo?"

# game/scripts/c24/c24.rpy:1844
translate brazilian c24s003_KiaBeach_33974255:

    # mc "Por supuesto, pero... ¿y la puesta de sol?"
    mc "Claro, mas... e o pôr do sol?"

# game/scripts/c24/c24.rpy:1845
translate brazilian c24s003_KiaBeach_b1b12e44:

    # kia "Ya la veremos otro día."
    kia "Nós a veremos outro dia."

# game/scripts/c24/c24.rpy:1847
translate brazilian c24s003_KiaBeach_39520351:

    # "Os empezáis a besar como si no hubiera un mañana, como si el tiempo se hubiera paralizado y el sol no se fuera a poner nunca."
    "Vocês começam a se beijar como se não houvesse amanhã, como se o tempo tivesse parado e o sol nunca fosse se pôr."

# game/scripts/c24/c24.rpy:1848
translate brazilian c24s003_KiaBeach_7da5e73a:

    # "No eres capaz de saber cómo es posible que acabarais ese beso con la misma ropa que lo empezasteis."
    "Você não tem a menor ideia de como foi possível terminar aquele beijo vestindo as mesmas roupas com que começou."

# game/scripts/c24/c24.rpy:1849
translate brazilian c24s003_KiaBeach_c1073a74:

    # "Tan solo recuerdas que fue uno de los besos más maravillosos de tu vida. Tu primer beso como prometido de alguien."
    "Você só se lembra de que foi um dos beijos mais maravilhosos da sua vida. Seu primeiro beijo como noiva de alguém."

# game/scripts/c24/c24.rpy:1850
translate brazilian c24s003_KiaBeach_fd099c8e:

    # "Y el sol se puso sin que os dierais cuenta."
    "E o sol se pôs sem que você percebesse."

# game/scripts/c24/c24.rpy:1852
translate brazilian c24s003_KiaBeach_bef69e4a:

    # "Os da lo mismo."
    "Para você, tanto faz."

# game/scripts/c24/c24.rpy:1863
translate brazilian c24s004_Eri_Dap_Kat_Nor_8e4c7523:

    # "Después de cenar, en la cocina de [nor]..."
    "Após o jantar, na cozinha de [nor]..."

# game/scripts/c24/c24.rpy:1865
translate brazilian c24s004_Eri_Dap_Kat_Nor_75401fcb:

    # nor "Estoy muy contenta por Tía [bet]. Era injusto..."
    nor "Estou tão feliz pela tia [bet]. Foi injusto..."

# game/scripts/c24/c24.rpy:1866
translate brazilian c24s004_Eri_Dap_Kat_Nor_76f0a7ee:

    # eri "Estoy de acuerdo. Querían aprovecharse de lo que creían que era un momento de vulnerabilidad de la tía."
    eri "Concordo. Eles queriam se aproveitar do que acreditavam ser um momento de vulnerabilidade da tia."

# game/scripts/c24/c24.rpy:1867
translate brazilian c24s004_Eri_Dap_Kat_Nor_b58475de:

    # dap "Pero no contaban con [mc]. *Risita*"
    dap "Mas eles não contavam com o C4. *Risos*"

# game/scripts/c24/c24.rpy:1869
translate brazilian c24s004_Eri_Dap_Kat_Nor_2aa59a1a:

    # nor "¿Tenéis algún plan para el fin de semana?"
    nor "Você tem algum plano para o fim de semana?"

# game/scripts/c24/c24.rpy:1871
translate brazilian c24s004_Eri_Dap_Kat_Nor_d1d3ee28:

    # dap "He quedado con [eva] para que me enseñe a disparar el domingo por la tarde. También vienen varias de las chicas."
    dap "Combinei de me encontrar com [eva] para que ela me ensine a atirar no domingo à tarde. Várias das meninas também virão."

# game/scripts/c24/c24.rpy:1873
translate brazilian c24s004_Eri_Dap_Kat_Nor_f0f38756:

    # nor "¿Vas a ir tú también, [eri]?"
    nor "Você também vai, [eri]?"

# game/scripts/c24/c24.rpy:1875
translate brazilian c24s004_Eri_Dap_Kat_Nor_121141d3:

    # eri "Me hubiera gustado ir. Ha alquilado un campo de tiro y podría haber estado bien, pero trabajo, con lo que quedaremos otro día."
    eri "Eu teria gostado de ir. Ele alugou um estande de tiro e teria sido legal, mas eu tenho que trabalhar, então a gente se encontra outro dia."

# game/scripts/c24/c24.rpy:1876
translate brazilian c24s004_Eri_Dap_Kat_Nor_e4a29f7f:

    # eri "Iremos al bosque, donde le enseñó a disparar a [mc]."
    eri "Iremos à floresta, onde ele o ensinou a disparar C4."

# game/scripts/c24/c24.rpy:1878
translate brazilian c24s004_Eri_Dap_Kat_Nor_13a3344b:

    # nor "Ir con cuidado con las armas... No son juguetes."
    nor "Tenha cuidado com as armas... Elas não são brinquedos."

# game/scripts/c24/c24.rpy:1880
translate brazilian c24s004_Eri_Dap_Kat_Nor_7ab70709:

    # dap "Lo sabemos, Mamá. Creo que tú también deberías aprender a disparar."
    dap "A gente sabe, mãe. Acho que você também devia aprender a atirar."

# game/scripts/c24/c24.rpy:1881
translate brazilian c24s004_Eri_Dap_Kat_Nor_742d8287:

    # dap "Nunca puedes saber cuándo se repetirá otro secuestro, y creo que deberíamos tener armas en casa."
    dap "Nunca se sabe quando outro sequestro vai acontecer, e eu acho que deveríamos ter armas em casa."

# game/scripts/c24/c24.rpy:1883
translate brazilian c24s004_Eri_Dap_Kat_Nor_5fb4770a:

    # eri "Yo creo que no son necesarias, pese a lo bien que fue que [eva] tuviera una pistola escondida cuando pasó lo de Solomon."
    eri "Não acho que sejam necessários, apesar de ter sido bom que [eva] tivesse uma arma escondida quando o incidente de Salomão aconteceu."

# game/scripts/c24/c24.rpy:1885
translate brazilian c24s004_Eri_Dap_Kat_Nor_6c8ae9f0:

    # nor "Yo pienso lo mismo. Yo ya sé disparar pero, si hubiera intentado hacer lo que hizo [eva], lo más probable es que le hubiera dado en la mano a Solomon."
    nor "Penso o mesmo. Eu já sei atirar, mas se eu tivesse tentado fazer o que [eva] fez, muito provavelmente teria acertado Salomão na mão."

# game/scripts/c24/c24.rpy:1886
translate brazilian c24s004_Eri_Dap_Kat_Nor_ce7a280b:

    # nor "O incluso sería más probable que hubiera matado a una ardilla en el bosque al otro lado de la calle. *Risa*"
    nor "Ou seria ainda mais provável que ele tivesse matado um esquilo na mata do outro lado da rua. *Risos*"

# game/scripts/c24/c24.rpy:1888
translate brazilian c24s004_Eri_Dap_Kat_Nor_1a092b52:

    # nor "[eva] y [ama] no van a ir a ningún sitio, con lo que creo que es mejor si son ellas las que se ocupan de las armas."
    nor "[eva] e [ama] não vão a lugar nenhum, então acho melhor que eles cuidem das armas."

# game/scripts/c24/c24.rpy:1889
translate brazilian c24s004_Eri_Dap_Kat_Nor_ad0b0264:

    # nor "Es bueno que aprendáis, pero no me gustaría tener armas en casa."
    nor "Que bom que você está aprendendo, mas eu não gostaria de ter armas em casa."

# game/scripts/c24/c24.rpy:1891
translate brazilian c24s004_Eri_Dap_Kat_Nor_02763481:

    # eri "Aparte de las que tiene [eva] escondidas, ¿no? *Risa*"
    eri "Além daquelas que ela escondeu, né? *Risos*"

# game/scripts/c24/c24.rpy:1892
translate brazilian c24s004_Eri_Dap_Kat_Nor_fb5e8d29:

    # nor "*Risa* Exacto. Aparte de esas."
    nor "*Risos* Exatamente. Tirando esses."

# game/scripts/c24/c24.rpy:1893
translate brazilian c24s004_Eri_Dap_Kat_Nor_7be2239a:

    # dap "Bueno, una vez nos enseñe a disparar, nos podría decir dónde están..."
    dap "Bem, depois que você nos ensinar a atirar, poderá nos dizer onde eles estão..."

# game/scripts/c24/c24.rpy:1894
translate brazilian c24s004_Eri_Dap_Kat_Nor_7df8a7a2:

    # nor "*Risa* Entonces dejarían de estar escondidas. ¿Te imaginas a [emm] sabiendo dónde están las armas?"
    nor "*Risos* Então elas não estariam mais escondidas. Você consegue imaginar [emm] sabendo onde as armas estão?"

# game/scripts/c24/c24.rpy:1896
translate brazilian c24s004_Eri_Dap_Kat_Nor_b711c9e5:

    # kat "Hola, chicas. ¿De qué habláis?"
    kat "Ei, meninas. Do que vocês estão falando?"

# game/scripts/c24/c24.rpy:1898
translate brazilian c24s004_Eri_Dap_Kat_Nor_226c8906:

    # "Todas" "De armas."
    "Todas" "De armas."

# game/scripts/c24/c24.rpy:1900
translate brazilian c24s004_Eri_Dap_Kat_Nor_7c813c76:

    # kat "¿Ah, de lo de [eva] el domingo? Va a ser divertido."
    kat "Ah, e quanto ao lance do [eva] no domingo? Vai ser divertido."

# game/scripts/c24/c24.rpy:1901
translate brazilian c24s004_Eri_Dap_Kat_Nor_2fc0434f:

    # kat "Al final [kim] también vendrá."
    kat "No final, [kim] também virá."

# game/scripts/c24/c24.rpy:1903
translate brazilian c24s004_Eri_Dap_Kat_Nor_daefa916:

    # dap "*Risa* Yo que tú iría con cuidado si [kim] está armada cerca de ti."
    dap "*Risos* Se eu fosse você, tomaria cuidado se [kim] estivesse armado perto de você."

# game/scripts/c24/c24.rpy:1905
translate brazilian c24s004_Eri_Dap_Kat_Nor_d8fca8c5:

    # kat "¿Por qué? Le he hecho un favor..."
    kat "Por quê? Eu lhe fiz um favor..."

# game/scripts/c24/c24.rpy:1907
translate brazilian c24s004_Eri_Dap_Kat_Nor_1bfe855c:

    # eri "Sí, probablemente, pero las formas no han sido las correctas y lo sabes, [kat]."
    eri "Sim, provavelmente, mas os métodos não foram corretos e você sabe disso, [kat]."

# game/scripts/c24/c24.rpy:1908
translate brazilian c24s004_Eri_Dap_Kat_Nor_d8a5c890:

    # eri "La podías haber puesto en una situación desagradable cuando no estaba preparada."
    eri "Você poderia tê-la colocado em uma situação desagradável quando ela não estava preparada."

# game/scripts/c24/c24.rpy:1910
translate brazilian c24s004_Eri_Dap_Kat_Nor_75b6556d:

    # kat "Si no lo hubiera hecho, le hubiera estado dando vueltas al mismo tema durante meses..."
    kat "Se eu não tivesse feito isso, ficaria remoendo o mesmo problema por meses..."

# game/scripts/c24/c24.rpy:1912
translate brazilian c24s004_Eri_Dap_Kat_Nor_ea410f3c:

    # nor "Chicas, ¿me podéis dejar a solas con [kat] un momento?"
    nor "Meninas, vocês podem me deixar a sós com [kat] por um momento?"

# game/scripts/c24/c24.rpy:1914
translate brazilian c24s004_Eri_Dap_Kat_Nor_e0a53f01:

    # dap "Sí, quiero acostarme pronto hoy."
    dap "Sim, quero ir para a cama cedo hoje à noite."

# game/scripts/c24/c24.rpy:1915
translate brazilian c24s004_Eri_Dap_Kat_Nor_b88c34fe:

    # eri "No seas muy dura con ella, Mamá."
    eri "Não seja tão dura com ela, mãe."

# game/scripts/c24/c24.rpy:1917
translate brazilian c24s004_Eri_Dap_Kat_Nor_1c4ddfff:

    # kat "¿Tan malo ha sido lo que he hecho?"
    kat "O que eu fiz foi realmente tão ruim assim?"

# game/scripts/c24/c24.rpy:1919
translate brazilian c24s004_Eri_Dap_Kat_Nor_fc1e12cb:

    # nor "Solo ha sido malo que lo hicieras sin consultarle a [kim] previamente."
    nor "A única coisa ruim foi que você fez isso sem consultar [kim] antes."

# game/scripts/c24/c24.rpy:1922
translate brazilian c24s004_Eri_Dap_Kat_Nor_b0d28bba:

    # nor "Cuando ha venido a preguntarme si me importaría que entrara en el harén estaba muy enfadada."
    nor "Quando ele veio me perguntar se eu me importaria que ele entrasse no harém, fiquei muito zangada."

# game/scripts/c24/c24.rpy:1924
translate brazilian c24s004_Eri_Dap_Kat_Nor_16589389:

    # nor "Cuando ha venido a preguntarme si me importaría que intentara algo con [mc] estaba muy enfadada."
    nor "Quando ele veio me perguntar se eu me importaria se ele tentasse algo com [mc], fiquei muito bravo."

# game/scripts/c24/c24.rpy:1926
translate brazilian c24s004_Eri_Dap_Kat_Nor_0150f8d4:

    # nor "Cuando me ha contado lo que has hecho estaba muy enfadada."
    nor "Quando ela me contou o que você fez, fiquei muito zangado."

# game/scripts/c24/c24.rpy:1928
translate brazilian c24s004_Eri_Dap_Kat_Nor_8912c844:

    # kat "Lo siento, supongo que debería disculparme..."
    kat "Sinto muito, acho que devo me desculpar..."

# game/scripts/c24/c24.rpy:1930
translate brazilian c24s004_Eri_Dap_Kat_Nor_a706ac1f:

    # nor "Como ha dicho [eri], el problema han sido las formas."
    nor "Como disse [eri], o problema tem sido os métodos."

# game/scripts/c24/c24.rpy:1931
translate brazilian c24s004_Eri_Dap_Kat_Nor_486e0076:

    # nor "Imagínate que yo hago lo mismo contigo."
    nor "Imagine se eu fizesse o mesmo com você."

# game/scripts/c24/c24.rpy:1933
translate brazilian c24s004_Eri_Dap_Kat_Nor_a275e1f1:

    # kat "No es lo mismo, [nor]..."
    kat "Não é a mesma coisa, [nor]..."

# game/scripts/c24/c24.rpy:1935
translate brazilian c24s004_Eri_Dap_Kat_Nor_84383461:

    # nor "¿Cuál es la diferencia? Tú también vas a darle vueltas al tema durante mucho tiempo, por lo que parece."
    nor "Qual é a diferença? Parece que você também vai ficar pensando nisso por um bom tempo."

# game/scripts/c24/c24.rpy:1936
translate brazilian c24s004_Eri_Dap_Kat_Nor_57295e46:

    # nor "Y no me digas que es más complicado."
    nor "E não me diga que é mais complicado."

# game/scripts/c24/c24.rpy:1938
translate brazilian c24s004_Eri_Dap_Kat_Nor_d3d12574:

    # kat "Es que es más complicado..."
    kat "É mais complicado do que isso..."

# game/scripts/c24/c24.rpy:1940
translate brazilian c24s004_Eri_Dap_Kat_Nor_b2ffd429:

    # nor "¿Por qué? ¿Porque incluye a [kim] y a [mc] en tu caso?"
    nor "Por quê? Porque inclui [kim] e [mc] no seu caso?"

# game/scripts/c24/c24.rpy:1941
translate brazilian c24s004_Eri_Dap_Kat_Nor_3feb4a95:

    # nor "¿Te encierro con los dos en una habitación mañana? ¿O espero a saber si acaban juntos?"
    nor "Devo trancar você e os dois em um quarto amanhã? Ou devo esperar para ver se eles acabam juntos?"

# game/scripts/c24/c24.rpy:1943
translate brazilian c24s004_Eri_Dap_Kat_Nor_71da3642:

    # kat "Me moriría de vergüenza..."
    kat "Eu morreria de vergonha..."

# game/scripts/c24/c24.rpy:1945
translate brazilian c24s004_Eri_Dap_Kat_Nor_0e9fbcee:

    # nor "Eso es lo que le ha pasado a [kim] esta mañana."
    nor "Foi isso que aconteceu com [kim] esta manhã."

# game/scripts/c24/c24.rpy:1946
translate brazilian c24s004_Eri_Dap_Kat_Nor_ccee749e:

    # nor "[deb.nick] lo podía hacer con [lis] porque son hermanas. Sabía cómo iba a reaccionar ella saliera lo que saliera de ese encierro."
    nor "[deb.nick] Eu poderia fazer isso com [lis] porque elas são irmãs. Eu sabia como ela reagiria, não importa o que acontecesse durante aquele confinamento."

# game/scripts/c24/c24.rpy:1948
translate brazilian c24s004_Eri_Dap_Kat_Nor_17a5433c:

    # nor "No la has encerrado con [mc], pero sí con [mar], que es casi más importante para ella."
    nor "Você não o envolveu com [mc], mas o fez com [mar], o que é quase mais importante para ela."

# game/scripts/c24/c24.rpy:1949
translate brazilian c24s004_Eri_Dap_Kat_Nor_e6ee482d:

    # nor "Y tú te podías imaginar la respuesta que iba a dar [mar], pero pese a todo has forzado una situación que no tenías derecho a forzar."
    nor "E você pode imaginar a resposta que eu ia dar [mar], mas apesar de tudo você forçou uma situação que você não tinha o direito de forçar."

# game/scripts/c24/c24.rpy:1951
translate brazilian c24s004_Eri_Dap_Kat_Nor_117fad36:

    # kat "Pero es que... necesitaba forzarla..."
    kat "Mas... eu precisei forçar a barra..."

# game/scripts/c24/c24.rpy:1953
translate brazilian c24s004_Eri_Dap_Kat_Nor_0b9824dc:

    # nor "¿Por qué? ¿Crees que, si [kim] y [mc] acaban juntos, te vas a quitar a los dos de la cabeza?"
    nor "Por quê? Você acha que se [kim] e [mc] acabarem juntos, você conseguirá tirá-los da cabeça?"

# game/scripts/c24/c24.rpy:1955
translate brazilian c24s004_Eri_Dap_Kat_Nor_c90b7790:

    # kat "Sí, esa es la idea. Matar dos pájaros de un tiro..."
    kat "Sim, essa é a ideia. Matar dois coelhos com uma cajadada só..."

# game/scripts/c24/c24.rpy:1956
translate brazilian c24s004_Eri_Dap_Kat_Nor_6455063e:

    # kat "*Susurrando para sí misma* O dos esperanzas a la vez..."
    kat "*Sussurrando para si mesma* Ou duas esperanças ao mesmo tempo..."

# game/scripts/c24/c24.rpy:1958
translate brazilian c24s004_Eri_Dap_Kat_Nor_6e890a8a:

    # nor "Eso no va a funcionar, [kat]."
    nor "Isso não vai funcionar, [kat]."

# game/scripts/c24/c24.rpy:1959
translate brazilian c24s004_Eri_Dap_Kat_Nor_0904c7da:

    # nor "Si acaban juntos te empezarás a imaginar las posibilidades."
    nor "Se eles acabarem juntos, você começará a imaginar as possibilidades."

# game/scripts/c24/c24.rpy:1960
translate brazilian c24s004_Eri_Dap_Kat_Nor_25c26731:

    # nor "Y si no acaban juntos, seguirás como estás ahora mismo, pero habrás conseguido enfadar a [kim]."
    nor "E se eles não ficarem juntos, você continuará como está agora, mas terá conseguido irritar [kim]."

# game/scripts/c24/c24.rpy:1962
translate brazilian c24s004_Eri_Dap_Kat_Nor_69402303:

    # kat "Pero es que no sabes lo difícil que es compartir habitación con una de las mujeres más bonitas que he visto nunca."
    kat "Mas você não faz ideia de como é difícil dividir um quarto com uma das mulheres mais lindas que eu já vi."

# game/scripts/c24/c24.rpy:1963
translate brazilian c24s004_Eri_Dap_Kat_Nor_bfef32ac:

    # kat "Reír juntas, hacernos amigas... verla desnuda cada día..."
    kat "Rindo juntos, tornando-nos amigos... vendo-a nua todos os dias..."

# game/scripts/c24/c24.rpy:1965
translate brazilian c24s004_Eri_Dap_Kat_Nor_7fac8621:

    # nor "¿Y con [mc]? ¿Qué esperas conseguir con él? ¿Ya has conseguido aclararte?"
    nor "E quanto a [mc]? O que você espera alcançar com ele? Já descobriu como?"

# game/scripts/c24/c24.rpy:1967
translate brazilian c24s004_Eri_Dap_Kat_Nor_aebf4443:

    # kat "Ahí está el problema... yo era feliz mientras sólo me gustaban las mujeres..."
    kat "Esse é o problema... Eu era feliz enquanto gostasse apenas de mulheres..."

# game/scripts/c24/c24.rpy:1969
translate brazilian c24s004_Eri_Dap_Kat_Nor_2f49e779:

    # kat "Entonces llega [mc] y me empieza a tratar como una persona normal, y eso me desconcierta."
    kat "Então [mc] chega e começa a me tratar como uma pessoa normal, e isso me confunde."

# game/scripts/c24/c24.rpy:1971
translate brazilian c24s004_Eri_Dap_Kat_Nor_9aa444f3:

    # kat "Entonces llega [mc] y, pese a que se ha comportado como un capullo muchas veces, me desconcierta."
    kat "Então aparece o [mc] e, apesar de ter se comportado como um idiota muitas vezes, ele me deixa perplexo."

# game/scripts/c24/c24.rpy:1973
translate brazilian c24s004_Eri_Dap_Kat_Nor_b47939bc:

    # kat "Aún no sé si siento algo por él, o si tan solo estoy tan desconcertada con él que tengo la cabeza hecha un lío."
    kat "Ainda não sei se sinto algo por ele, ou se estou apenas tão confusa que minha cabeça está uma bagunça."

# game/scripts/c24/c24.rpy:1974
translate brazilian c24s004_Eri_Dap_Kat_Nor_58fa7ef1:

    # kat "Pero si [kim] y él acaban juntos, en el fondo les habré hecho un favor... ¿no?"
    kat "Mas se [kim] e ele acabarem juntos, no fundo terei feito um favor a eles... certo?"

# game/scripts/c24/c24.rpy:1976
translate brazilian c24s004_Eri_Dap_Kat_Nor_eb6b5d3f:

    # nor "Mi niña, las cosas no funcionan así."
    nor "Minha querida, as coisas não funcionam dessa maneira."

# game/scripts/c24/c24.rpy:1977
translate brazilian c24s004_Eri_Dap_Kat_Nor_7fb92b5e:

    # nor "Respóndeme a esta pregunta sin pensarlo. Si tuvieras que elegir entre estar con [kim] o estar con [mc], ¿qué escogerías?"
    nor "Responda a esta pergunta sem pensar. Se você tivesse que escolher entre estar com [kim] ou estar com [mc], qual você escolheria?"

# game/scripts/c24/c24.rpy:1979
translate brazilian c24s004_Eri_Dap_Kat_Nor_f6372631:

    # "[kat] responde automáticamente, sin pensar."
    "[kat] responde automaticamente, sem pensar."

# game/scripts/c24/c24.rpy:1982
translate brazilian c24s004_Eri_Dap_Kat_Nor_9b4bb496:

    # kat "Con los dos."
    kat "Com ambos."

# game/scripts/c24/c24.rpy:1984
translate brazilian c24s004_Eri_Dap_Kat_Nor_dfd0c326:

    # kat "Con [mc]."
    kat "Com [mc]."

# game/scripts/c24/c24.rpy:1986
translate brazilian c24s004_Eri_Dap_Kat_Nor_f9c67328:

    # kat "Con [kim]."
    kat "Com [kim]."

# game/scripts/c24/c24.rpy:1987
translate brazilian c24s004_Eri_Dap_Kat_Nor_fdcb1017:

    # kat "Y si [mc] fuera menos capullo, con los dos."
    kat "E se [mc] fosse menos idiota, então com ambos."

# game/scripts/c24/c24.rpy:1989
translate brazilian c24s004_Eri_Dap_Kat_Nor_218c765e:

    # nor "Ahí tienes la respuesta a tus dilemas. A veces, no pensar las cosas es la mejor forma de descubrir la respuesta adecuada."
    nor "Aí está a resposta para os seus dilemas. Às vezes, não pensar demais é a melhor maneira de descobrir a resposta certa."

# game/scripts/c24/c24.rpy:1991
translate brazilian c24s004_Eri_Dap_Kat_Nor_b887f943:

    # kat "¡Joder! ¿Así de fácil?"
    kat "Caramba! Assim, do nada?"

# game/scripts/c24/c24.rpy:1993
translate brazilian c24s004_Eri_Dap_Kat_Nor_c3456495:

    # nor "Así de fácil. Dame un abrazo."
    nor "É muito fácil. Me dá um abraço."

# game/scripts/c24/c24.rpy:1995
translate brazilian c24s004_Eri_Dap_Kat_Nor_aae2f98d:

    # nor "Aunque no lo necesites, tienes que saber que me alegrará si te unes al harén."
    nor "Mesmo que você não precise, saiba que ficarei feliz se você se juntar ao harém."

# game/scripts/c24/c24.rpy:1997
translate brazilian c24s004_Eri_Dap_Kat_Nor_3ee61ccc:

    # kat "Gracias, [nor]."
    kat "Obrigado, [nor]."

# game/scripts/c24/c24.rpy:1998
translate brazilian c24s004_Eri_Dap_Kat_Nor_9d4daee9:

    # kat "¿Puedes hacer el mismo truco en mis exámenes y preguntarme cosas sobre las belugas? *Risa*"
    kat "Você pode fazer a mesma coisa nas minhas provas e me fazer perguntas sobre belugas? *Risos*"

# game/scripts/c24/c24.rpy:1999
translate brazilian c24s004_Eri_Dap_Kat_Nor_b44227f7:

    # nor "*Risa* Creo que no funcionaría."
    nor "*Risos* Acho que não daria certo."

# game/scripts/c24/c24.rpy:2001
translate brazilian c24s004_Eri_Dap_Kat_Nor_594f02f7:

    # nor "*Risa* Y creo que deberías sacar tu nariz de entre mis tetas."
    nor "*Risos* E acho que você deveria tirar o nariz de entre meus peitos."

# game/scripts/c24/c24.rpy:2002
translate brazilian c24s004_Eri_Dap_Kat_Nor_cab82560:

    # kat "*Risa* Yo también lo creo, pero... ¡Por el amor de Dios, [nor]!"
    kat "*Risos* Eu também acho, mas... Pelo amor de Deus, [nor]!"

# game/scripts/c24/c24.rpy:2004
translate brazilian c24s004_Eri_Dap_Kat_Nor_5d16767d:

    # "Ambas" "*Risa*"
    "Ambas" "*Risada*"

# game/scripts/c24/c24.rpy:2005
translate brazilian c24s004_Eri_Dap_Kat_Nor_a705a70a:

    # "Las dos mujeres pasan un rato abrazadas, entre silencios y risas."
    "As duas mulheres passam algum tempo abraçadas, em meio a silêncios e risos."

# game/scripts/c24/c24.rpy:2006
translate brazilian c24s004_Eri_Dap_Kat_Nor_a1de1663:

    # "[kat] por fin ha decidido qué es lo que quiere. Ahora solo necesita un plan para conseguirlo."
    "[kat] finalmente decidiu o que quer. Agora ela só precisa de um plano para conseguir."

# game/scripts/c24/c24.rpy:2014
translate brazilian c24s003_KiaSex_3e9f0529:

    # "De vuelta en la playa..."
