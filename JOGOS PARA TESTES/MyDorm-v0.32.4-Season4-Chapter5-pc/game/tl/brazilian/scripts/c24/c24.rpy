    mc "*Risos* Funcionou com você, mesmo sem eu ter que fazer nada para te seduzir."

# game/scripts/c24/c24.rpy:3201
translate brazilian c24s004_Mad_Lis_Emm_ab9a09cf:

    # mc "*Risa* Podría ser divertido."
    mc "*Risos* Isso pode ser divertido."

# game/scripts/c24/c24.rpy:3202
translate brazilian c24s004_Mad_Lis_Emm_91fefb40:

    # mc "¿También hay trajes para mí?"
    mc "Existem ternos que também servem para mim?"

# game/scripts/c24/c24.rpy:3204
translate brazilian c24s004_Mad_Lis_Emm_4cefdcd6:

    # lis "No, [mad.nick] no hace ropa para hombre, al menos aún."
    lis "Não, a [mad.nick] não fabrica roupas para homens, pelo menos ainda não."

# game/scripts/c24/c24.rpy:3205
translate brazilian c24s004_Mad_Lis_Emm_cd94c3a4:

    # lis "Pero estarías muy bien con el traje que llevaste al Jazz Corner."
    lis "Mas você ficaria ótimo com o terno que usou no Jazz Corner."

# game/scripts/c24/c24.rpy:3207
translate brazilian c24s004_Mad_Lis_Emm_5b71ce45:

    # mad "*Risa* Sabéis que os odio a veces, ¿verdad?"
    mad "*Risos* Vocês sabem que às vezes eu odeio vocês, né?"

# game/scripts/c24/c24.rpy:3208
translate brazilian c24s004_Mad_Lis_Emm_b3961c59:

    # mc "¿Por qué?"
    mc "Porque?"

# game/scripts/c24/c24.rpy:3210
translate brazilian c24s004_Mad_Lis_Emm_801f217c:

    # mad "Es una tontería pero, excepto el cumpleaños de las chicas, me he perdido todas las actividades familiares."
    mad "É bobagem, mas, tirando o aniversário das meninas, senti falta de todas as atividades em família."

# game/scripts/c24/c24.rpy:3211
translate brazilian c24s004_Mad_Lis_Emm_b40dc845:

    # mad "La fiesta en la playa, la noche en el club de Jazz... A veces os ponéis a hablar de esas cosas y estoy un poco fuera de lugar."
    mad "A festa na praia, a noite no clube de jazz... Às vezes vocês começam a falar dessas coisas e eu me sinto um pouco deslocado."

# game/scripts/c24/c24.rpy:3212
translate brazilian c24s004_Mad_Lis_Emm_a2ed892b:

    # mad "Me hubiera gustado estar, pero hasta la partida de DnD no me sentía parte de esto..."
    mad "Eu gostaria de ter estado lá, mas até D&D ir embora, eu não me sentia parte daquilo..."

# game/scripts/c24/c24.rpy:3214
translate brazilian c24s004_Mad_Lis_Emm_89c7a297:

    # emm "No te preocupes, [mad.nick]. A partir de ahora vendrás siempre que hagamos algo especial."
    emm "Não se preocupe, [mad.nick]. De agora em diante você virá sempre que fizermos algo especial."

# game/scripts/c24/c24.rpy:3215
translate brazilian c24s004_Mad_Lis_Emm_c4691a62:

    # emm "Estoy pensando que, si tú te sientes así, ¿cómo se van a sentir las chicas que llegan en Septiembre?"
    emm "Fico pensando, se você se sente assim, como as meninas que chegarem em setembro vão se sentir?"

# game/scripts/c24/c24.rpy:3216
translate brazilian c24s004_Mad_Lis_Emm_ea950fdc:

    # mc "Bueno, falta por ver si se integran en la familia tan rápido como..."
    mc "Bem, resta saber se eles se integrarão à família tão rapidamente quanto..."

# game/scripts/c24/c24.rpy:3218
translate brazilian c24s004_Mad_Lis_Emm_13336c01:

    # lis "¿Como nosotras? Estoy segura de que lo harán. [sca] me dijo que una de ellas era amiga suya y de [dap] hace años, que vivía en Newport."
    lis "Como nós? Tenho certeza que sim. [sca] me disse que um deles era um amigo dela e de [dap] de anos atrás, que morava em Newport."

# game/scripts/c24/c24.rpy:3219
translate brazilian c24s004_Mad_Lis_Emm_d2bfd7da:

    # lis "Integrarla a ella en la familia será fácil, y a la prima de [sai] también."
    lis "Integrá-la à família será fácil, assim como o primo de [sai]."

# game/scripts/c24/c24.rpy:3220
translate brazilian c24s004_Mad_Lis_Emm_73e1891a:

    # mc "¿Quién es la amiga de [dap] y [sca]?"
    mc "Quem é amigo de [dap] e [sca]?"

# game/scripts/c24/c24.rpy:3222
translate brazilian c24s004_Mad_Lis_Emm_2006bb97:

    # emm "Patty. No sé si la recuerdas, morena, ojos grandes... era un par de días mayor que [sca]. No era muy amiga mía, pero nos llevábamos bien."
    emm "Patty. Não sei se você se lembra dela, morena, olhos grandes... ela era alguns dias mais velha que [sca]. Ela não era uma amiga muito próxima, mas nos dávamos bem."

# game/scripts/c24/c24.rpy:3223
translate brazilian c24s004_Mad_Lis_Emm_c6e65843:

    # emm "Su madre encontró trabajo en Dallas, y se marcharon un año antes de que tú te graduaras."
    emm "Sua mãe conseguiu um emprego em Dallas, e eles foram embora um ano antes de você se formar."

# game/scripts/c24/c24.rpy:3224
translate brazilian c24s004_Mad_Lis_Emm_9735c5af:

    # mc "Me suena el nombre, pero no le puedo poner cara."
    mc "O nome me soa familiar, mas não consigo me lembrar da pessoa."

# game/scripts/c24/c24.rpy:3225
translate brazilian c24s004_Mad_Lis_Emm_361c0599:

    # emm "Deberías mirar los expedientes de las chicas nuevas y..."
    emm "Você deveria dar uma olhada nos arquivos das novas garotas e..."

# game/scripts/c24/c24.rpy:3227
translate brazilian c24s004_Mad_Lis_Emm_7e4f81b9:

    # kim "[mad.nick], ¿me puedes ayudar a...?"
    kim "[mad.nick], você pode me ajudar com...?"

