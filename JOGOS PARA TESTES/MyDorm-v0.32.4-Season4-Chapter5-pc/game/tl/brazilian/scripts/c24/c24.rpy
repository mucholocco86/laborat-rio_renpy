    # kim "¡Oops! Veo que estáis ocupadas. No os preocupéis."
    kim "Opa! Vejo que você está ocupado(a). Não se preocupe."

# game/scripts/c24/c24.rpy:3231
translate brazilian c24s004_Mad_Lis_Emm_92ebf9da:

    # kim "Voy a pedirle ayuda a la Abuela..."
    kim "Vou pedir ajuda à vovó..."

# game/scripts/c24/c24.rpy:3233
translate brazilian c24s004_Mad_Lis_Emm_0cf2d20b:

    # mc "¿Qué le pasa?"
    mc "O que há de errado com ele?"

# game/scripts/c24/c24.rpy:3234
translate brazilian c24s004_Mad_Lis_Emm_1312c559:

    # emm "¿No la has oído? Ha visto que [mad.nick] está ocupada y..."
    emm "Você não a ouviu? Ela viu que [mad.nick] estava ocupado e..."

# game/scripts/c24/c24.rpy:3235
translate brazilian c24s004_Mad_Lis_Emm_4c912813:

    # mad "... Y no ha querido entretenerme por si..."
    mad "...E ele não queria me manter por precaução..."

# game/scripts/c24/c24.rpy:3236
translate brazilian c24s004_Mad_Lis_Emm_ae12de5d:

    # lis "... Por si estaba haciendo algo importante... supongo..."
    lis "...Caso ele estivesse fazendo algo importante... eu acho..."

# game/scripts/c24/c24.rpy:3237
translate brazilian c24s004_Mad_Lis_Emm_8fb9d37f:

    # mc "¿Qué me estáis ocultando, chicas?"
    mc "O que vocês estão escondendo de mim, meninas?"

# game/scripts/c24/c24.rpy:3239
translate brazilian c24s004_Mad_Lis_Emm_82af4742:

    # lis "¿Nosotras?"
    lis "Nós?"

# game/scripts/c24/c24.rpy:3240
translate brazilian c24s004_Mad_Lis_Emm_54273a9a:

    # emm "¿Qué íbamos a querer ocultarte?"
    emm "O que gostaríamos de esconder de você?"

# game/scripts/c24/c24.rpy:3241
translate brazilian c24s004_Mad_Lis_Emm_c88f9707:

    # mad "Si es algo en lo que puede ayudarle [mee]..." id c24s004_Mad_Lis_Emm_c88f9707
    mad "Se houver algo em que eu possa te ajudar..." id c24s004_Mad_Lis_Emm_c88f9707

# game/scripts/c24/c24.rpy:3242
translate brazilian c24s004_Mad_Lis_Emm_926339a4:

    # mc "Vale, no os voy a sacar nada, ¿verdad?"
    mc "Ok, não vou conseguir arrancar nada de você, certo?"

# game/scripts/c24/c24.rpy:3244
translate brazilian c24s004_Mad_Lis_Emm_358c1155:

    # "Todas" "Nope."
    "Todas" "Não."

# game/scripts/c24/c24.rpy:3245
translate brazilian c24s004_Mad_Lis_Emm_0d14768e:

    # lis "Además, lo dices como si... en el caso de que le pasara algo a [kim]... nosotras supiéramos qué es."
    lis "Além disso, você fala como se... caso algo acontecesse com [kim]... nós saberíamos o que é."

# game/scripts/c24/c24.rpy:3246
translate brazilian c24s004_Mad_Lis_Emm_e6e01b5f:

    # emm "Y no estamos diciendo que le pase nada..."
    emm "E não estamos dizendo que algo de ruim vai acontecer com ele..."

# game/scripts/c24/c24.rpy:3247
translate brazilian c24s004_Mad_Lis_Emm_64443da5:

    # mad "Ni que sepamos qué le pasa... si es que le pasa algo. O que te lo fuéramos a decir si lo supiéramos."
    mad "Não que saibamos o que há de errado com ele... se é que há algo de errado. Ou que lhe diríamos mesmo se soubéssemos."

# game/scripts/c24/c24.rpy:3248
translate brazilian c24s004_Mad_Lis_Emm_6245c0df:

    # mc "*Risa* Vale, vale. Pero... ¿ha llamado 'Abuela' a Meemaw?"
    mc "*Risos* Tá bom, tá bom. Mas... ela chamou a vovó de \"vovó\"?"

# game/scripts/c24/c24.rpy:3250
translate brazilian c24s004_Mad_Lis_Emm_d2f469c8:

    # emm "*Risa* Sí. [kim] está llevando lo de integrarse en la familia a un nuevo nivel. Pero aún no se atreve a llamárselo a ella."
    emm "*Risos* Sim. [kim] está levando a integração na família a um nível totalmente novo. Mas ele ainda não se atreve a ligar para ela."

# game/scripts/c24/c24.rpy:3251
translate brazilian c24s004_Mad_Lis_Emm_07cfc36c:

    # lis "*Risa* El día menos pensado nos empieza a llamar hermanas a todas."
    lis "*Risos* Um dia desses ele vai começar a nos chamar de irmãs."

# game/scripts/c24/c24.rpy:3252
translate brazilian c24s004_Mad_Lis_Emm_d9c03e82:

    # mad "*Risa* No dejaría de ser divertido que tantas chicas de razas diferentes nos empezásemos a considerar hermanas algún día."
    mad "*Risos* Seria divertido se tantas garotas de raças diferentes começassem a se considerar irmãs algum dia."

# game/scripts/c24/c24.rpy:3253
translate brazilian c24s004_Mad_Lis_Emm_e2655347:

    # "En ese momento oís una furgoneta y cómo se abre la verja de entrada."
    "Nesse momento você ouve uma van e o portão de entrada se abrindo."

# game/scripts/c24/c24.rpy:3256
translate brazilian c24s004_Mad_Lis_Emm_d4ec7df7:

    # emm "Creo que esa es [ama]. Debe venir a buscarte para lo de esta noche."
    emm "Acho que é [ama]. Ele deve vir te buscar hoje à noite."

# game/scripts/c24/c24.rpy:3257
translate brazilian c24s004_Mad_Lis_Emm_36dfb3ee:

    # mc "Pero es muy pronto para que venga el helicóptero."
    mc "Mas ainda é muito cedo para o helicóptero chegar."

# game/scripts/c24/c24.rpy:3258
translate brazilian c24s004_Mad_Lis_Emm_43266a7a:

    # emm "A lo mejor quiere repasar algunos datos."
    emm "Talvez ele queira analisar alguns dados."

# game/scripts/c24/c24.rpy:3259
translate brazilian c24s004_Mad_Lis_Emm_605d1430:

    # mc "Voy a ver..."
    mc "Verei..."

# game/scripts/c24/c24.rpy:3269
translate brazilian c24s004_Mad_Lis_Emm_66e9c8c2:

    # "Te despides de las chicas y te diriges a la furgoneta."
    "Você se despede das garotas e vai em direção à van."

