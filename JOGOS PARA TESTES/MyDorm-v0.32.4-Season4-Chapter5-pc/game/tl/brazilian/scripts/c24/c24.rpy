# game/scripts/c24/c24.rpy:2790
translate brazilian c24s003_peeOnKia_26ab93d1:

    # "Tal como pasan los segundos, te va gustando más a ti también."
    "Conforme os segundos passam, você também gosta cada vez mais."

# game/scripts/c24/c24.rpy:2791
translate brazilian c24s003_peeOnKia_9eefd18b:

    # "Pero puedes notar cómo tu vejiga se va vaciando. No queda mucho pis que expulsar."
    "Mas você consegue sentir sua bexiga esvaziando. Não resta muita urina para expelir."

# game/scripts/c24/c24.rpy:2793
translate brazilian c24s003_peeOnKia_2419596f:

    # kia "¿Quieres apuntar más arriba?"
    kia "Você quer almejar mais alto?"

# game/scripts/c24/c24.rpy:2794
translate brazilian c24s003_peeOnKia_4cf18f3e:

    # "La propuesta te vuelve a sorprender. La caja de sorpresas tiene una menos en su interior."
    "O pedido de casamento te surpreende novamente. A caixa de surpresas tem uma a menos dentro."

# game/scripts/c24/c24.rpy:2797
translate brazilian c24s003_peeOnKia_f5f94846:

    # kia "Segurísima. Si estamos probando cosas..."
    kia "Com certeza. Se estivermos testando coisas..."

# game/scripts/c24/c24.rpy:2799
translate brazilian c24s003_peeOnKia_9af451d6:

    # "Apuntas más arriba, salpicando la cara de [kia] con el último chorro de tu orina, que es lavada por la ducha en el mismo momento del impacto."
    "Você mira mais alto, respingando o rosto de [kia] com o último jato de sua urina, que é lavado pelo chuveiro no exato momento do impacto."

# game/scripts/c24/c24.rpy:2800
translate brazilian c24s003_peeOnKia_2cfb03ac:

    # kia "¡Sí! ¡Me gusta!"
    kia "Sim, eu gostei!"

# game/scripts/c24/c24.rpy:2801
translate brazilian c24s003_peeOnKia_4a5248a4:

    # "A ti también. Tal como van pasando los segundos lo vas disfrutando más."
    "Você também. Conforme os segundos passam, você aproveita cada vez mais."

# game/scripts/c24/c24.rpy:2802
translate brazilian c24s003_peeOnKia_37588e2d:

    # "Descubrir junto a la hermosa pelirroja una nueva experiencia compartida es increíble."
    "Descobrir uma nova experiência compartilhada com a linda ruiva é incrível."

# game/scripts/c24/c24.rpy:2803
translate brazilian c24s003_peeOnKia_9199ce03:

    # "Pero tu vejiga se vacía por completo antes de que te des cuenta."
    "Mas sua bexiga se esvazia completamente antes que você perceba."

# game/scripts/c24/c24.rpy:2805
translate brazilian c24s003_peeOnKia_535d05eb:

    # kia "¿Ya se ha acabado? ¡Se me ha hecho cortísimo! Pero me ha gustado."
    kia "Já acabou? Parece que passou tão rápido! Mas eu gostei."

# game/scripts/c24/c24.rpy:2807
translate brazilian c24s003_peeOnKia_fdaa7ccb:

    # mc "Es demasiado para mí y, además, ya se está acabando."
    mc "É demais para mim, e além disso, já está terminando."

# game/scripts/c24/c24.rpy:2809
translate brazilian c24s003_peeOnKia_535d05eb_1:

    # kia "¿Ya se ha acabado? ¡Se me ha hecho cortísimo! Pero me ha gustado."
    kia "Já acabou? Parece que passou tão rápido! Mas eu gostei."

# game/scripts/c24/c24.rpy:2810
translate brazilian c24s003_peeOnKia_16abe8df:

    # kia "Quizás lo de apuntar a mi cara era demasiado para la primera vez. Perdona por habértelo pedido."
    kia "Talvez apontar isso para o meu rosto tenha sido demais na primeira vez. Me desculpe por ter pedido isso."

# game/scripts/c24/c24.rpy:2811
translate brazilian c24s003_peeOnKia_f9fceaca:

    # mc "No tienes que pedir perdón por eso, ni por nada que quieras probar."
    mc "Você não precisa se desculpar por isso, nem por nada que queira experimentar."

# game/scripts/c24/c24.rpy:2812
translate brazilian c24s003_peeOnKia_62b3d6b6:

    # mc "A mí también me ha gustado. Verte disfrutar ha sido increíblemente caliente."
    mc "Eu também gostei. Ver você gostando foi incrivelmente excitante."

# game/scripts/c24/c24.rpy:2813
translate brazilian c24s003_peeOnKia_a9cc0909:

    # mc "Nunca temas preguntar cualquier cosa que quieras probar. Puede ser tan caliente como esto..."
    mc "Nunca tenha medo de perguntar sobre qualquer coisa que você queira experimentar. Pode ser tão quente quanto isso..."

# game/scripts/c24/c24.rpy:2818
translate brazilian c24s003_peeOnFloor_facc9562:

    # mc "Y no te preocupes, nunca te juzgaría por querer probar cosas nuevas."
    mc "E não se preocupe, eu jamais te julgaria por querer experimentar coisas novas."

# game/scripts/c24/c24.rpy:2819
translate brazilian c24s003_peeOnFloor_e9de2eee:

    # mc "Pero si quieres que mee en la ducha, estoy dispuesto a descubrir yo también cosas nuevas esta noche. Nunca lo he hecho delante de nadie."
    mc "Mas se você quiser que eu faça xixi no chuveiro, estou disposta a descobrir coisas novas esta noite também. Nunca fiz isso na frente de ninguém."

# game/scripts/c24/c24.rpy:2821
translate brazilian c24s003_peeOnFloor_baa65ab3:

    # kia "*Risa* ¡Eso significa que has meado en la ducha con anterioridad!"
    kia "*Risos* Isso significa que você já fez xixi no chuveiro antes!"

# game/scripts/c24/c24.rpy:2822
translate brazilian c24s003_peeOnFloor_cdc08a9a:

    # mc "*Risa* Quien diga que no lo ha hecho nunca miente. ¿O acaso no lo has hecho nunca?"
    mc "*Risos* Quem disser que nunca fez isso está mentindo. Ou você nunca fez isso?"

# game/scripts/c24/c24.rpy:2824
translate brazilian c24s003_peeOnFloor_f13af688:

    # kia "*Risa* ¡Por supuesto!"
    kia "*Risos* Claro!"

# game/scripts/c24/c24.rpy:2825
translate brazilian c24s003_peeOnFloor_28afb4bb:

    # mc "*Risa* ¿Quieres que apunte a algún lugar concreto?"
    mc "*Risos* Quer que eu aponte para um lugar específico?"

# game/scripts/c24/c24.rpy:2827
translate brazilian c24s003_peeOnFloor_50abc921:

    # "La preciosa pelirroja coge tu polla en su mano mientras la mira hipnotizada."
    "A ruiva deslumbrante pega seu pênis na mão enquanto o encara, hipnotizada."

# game/scripts/c24/c24.rpy:2828
translate brazilian c24s003_peeOnFloor_1f285a5f:

    # kia "Si no te importa, prefiero apuntar yo."
    kia "Se não se importar, prefiro fazer as anotações."

# game/scripts/c24/c24.rpy:2829
translate brazilian c24s003_peeOnFloor_32926e28:

    # mc "No me importa. Es tu petición, con lo que adelante. Voy a empezar."
    mc "Não me importo. É um pedido seu, então prossiga. Vou começar."

# game/scripts/c24/c24.rpy:2831
translate brazilian c24s003_peeOnFloor_4187ec6b:

    # "Un caliente chorro de orina sale de tu polla, estrellándose contra el suelo. Hace un charco que el agua de la ducha lucha por eliminar en el momento en que se forma."
    "Um jato quente de urina sai do seu pênis, respingando no chão. Forma uma poça que a água do chuveiro mal consegue dissolver assim que aparece."

# game/scripts/c24/c24.rpy:2832
translate brazilian c24s003_peeOnFloor_50e002b1:

    # kia "Puedo notar cómo recorre tu polla en mi mano..."
    kia "Consigo sentir seu pau deslizando na minha mão..."

# game/scripts/c24/c24.rpy:2833
translate brazilian c24s003_peeOnFloor_1a9d65ca:

    # mc "¿Te gusta la sensación? A mí me está pareciendo muy tórrida..."
    mc "Você gosta dessa sensação? Eu estou achando muito quente..."

# game/scripts/c24/c24.rpy:2835
translate brazilian c24s003_peeOnFloor_ff39826d:

    # "[kia] empieza a jugar con tu polla a la vez que redirige el chorro de orina."
    "[kia] começa a brincar com seu pênis enquanto redireciona o jato de urina."

# game/scripts/c24/c24.rpy:2836
translate brazilian c24s003_peeOnFloor_5e5aba09:

    # kia "¡Me encanta!"
    kia "Eu amo isso!"

# game/scripts/c24/c24.rpy:2837
translate brazilian c24s003_peeOnFloor_c5a26ab7:

    # mc "Podemos repetir esto en casa si quieres, cada vez que vaya al lavabo..."
    mc "Podemos repetir isso em casa, se quiser, toda vez que você for ao banheiro..."

# game/scripts/c24/c24.rpy:2839
translate brazilian c24s003_peeOnFloor_2ca6dd01:

    # kia "No me tientes..."
    kia "Não me tente..."

# game/scripts/c24/c24.rpy:2840
translate brazilian c24s003_peeOnFloor_ab451eca:

    # "Tu meada acaba mientras vuestros ojos están prendidos en los del otro."
    "Você termina de urinar enquanto seus olhares estão fixos um no outro."

# game/scripts/c24/c24.rpy:2842
translate brazilian c24s003_peeOnFloor_731bd82d:

    # kia "¿Ya está? ¡Ha durado menos de lo que esperaba!"
    kia "Está pronto? Durou menos tempo do que eu esperava!"

# game/scripts/c24/c24.rpy:2843
translate brazilian c24s003_peeOnFloor_7435a62c:

    # mc "Me parece que sí. No queda más."
    mc "Acho que sim. Não há mais nada a dizer."

# game/scripts/c24/c24.rpy:2845
translate brazilian c24s003_peeOnFloor_78c77cf7:

    # kia "Me ha gustado más de lo que pensaba."
    kia "Gostei mais do que esperava."

# game/scripts/c24/c24.rpy:2846
translate brazilian c24s003_peeOnFloor_0eee6097:

    # mc "A mí también. No esperaba tener ese fetiche."
    mc "Eu também. Não esperava ter esse fetiche."

# game/scripts/c24/c24.rpy:2848
translate brazilian c24s003_peeOnFloor_4d151eb5:

    # kia "No sabía si atreverme a pedírtelo. Es algo muy específico... y no creo que a todo el mundo le guste."
    kia "Não tinha certeza se deveria me atrever a te perguntar. É algo muito específico... e acho que nem todos gostariam."

# game/scripts/c24/c24.rpy:2849
translate brazilian c24s003_peeOnFloor_a9cc0909:

    # mc "Nunca temas preguntar cualquier cosa que quieras probar. Puede ser tan caliente como esto..."
    mc "Nunca tenha medo de perguntar sobre qualquer coisa que você queira experimentar. Pode ser tão quente quanto isso..."

# game/scripts/c24/c24.rpy:2854
translate brazilian c24s003_peeInWC_facc9562:

    # mc "Y no te preocupes, nunca te juzgaría por querer probar cosas nuevas."
    mc "E não se preocupe, eu jamais te julgaria por querer experimentar coisas novas."

# game/scripts/c24/c24.rpy:2855
translate brazilian c24s003_peeInWC_26a45c17:

    # mc "Pero esto no es algo que me haya llamado nunca la atención."
    mc "Mas isso nunca foi algo que me chamou a atenção."

# game/scripts/c24/c24.rpy:2857
translate brazilian c24s003_peeInWC_4d151eb5:

    # kia "No sabía si atreverme a pedírtelo. Es algo muy específico... y no creo que a todo el mundo le guste."
    kia "Não tinha certeza se deveria me atrever a te perguntar. É algo muito específico... e acho que nem todos gostariam."

# game/scripts/c24/c24.rpy:2858
translate brazilian c24s003_peeInWC_293a2b39:

    # mc "Nunca temas preguntar cualquier cosa que quieras probar. Puede ser que nos guste a los dos..."
    mc "Nunca tenha receio de perguntar sobre qualquer coisa que você queira experimentar. Podemos gostar juntos..."

# game/scripts/c24/c24.rpy:2859
translate brazilian c24s003_peeInWC_861e73be:

    # mc "Y ahora voy a mear antes de hacérmelo encima. *Risa* ¿Te quedas acabando de ducharte?"
    mc "E agora vou fazer xixi antes que eu me molhe. *Risos* Você vai ficar para terminar o banho?"

# game/scripts/c24/c24.rpy:2860
translate brazilian c24s003_peeInWC_e8ea5fcd:

    # kia "Sí, espérame en la habitación."
    kia "Sim, espere por mim no quarto."

# game/scripts/c24/c24.rpy:2862
translate brazilian c24s003_peeInWC_5ff4afd8:

    # "Vuelves a la habitación después de mear y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Você retorna ao quarto depois de urinar e se secar. Você espera [kia] terminar o banho, olhando para a lareira."

# game/scripts/c24/c24.rpy:2865
translate brazilian c24s004_kiaPee_27413b38:

    # kia "Si puedo preguntar cualquier cosa... ¿te importaría si yo meo en la ducha?"
    kia "Se me permite perguntar uma coisa... você se importaria se eu fizesse xixi no chuveiro?"

# game/scripts/c24/c24.rpy:2880
translate brazilian c24s004_kiaPee_787a2374:

    # kia "Ningún problema. Espérame allí y ahora voy."
    kia "Sem problema. Espere por mim aí e já chego."

# game/scripts/c24/c24.rpy:2882
translate brazilian c24s004_kiaPee_5ff4afd8:

    # "Vuelves a la habitación después secarte. Esperas que [kia] termine la ducha mirando la chimenea." id c24s004_kiaPee_5ff4afd8
    "Você retorna ao quarto depois de se secar. Você espera [kia] terminar o banho, olhando para a lareira." id c24s004_kiaPee_5ff4afd8

# game/scripts/c24/c24.rpy:2887
translate brazilian c24s004_kiaOnMC_07bd7913:

    # "Te tumbas en el suelo mientras la bellísima pelirroja pone un pie a cada lado de tu cuerpo."
    "Você se deita no chão enquanto a linda ruiva coloca um pé de cada lado do seu corpo."

# game/scripts/c24/c24.rpy:2888
translate brazilian c24s004_kiaOnMC_5dd2bafb:

    # kia "¿Preparado?"
    kia "Preparado?"

# game/scripts/c24/c24.rpy:2889
translate brazilian c24s004_kiaOnMC_937a60fc:

    # mc "*Risa* No muy convencido, pero preparado."
    mc "*Risos* Não estou totalmente convencido, mas estou preparado."

# game/scripts/c24/c24.rpy:2891
translate brazilian c24s004_kiaOnMC_c9783400:

    # kia "Si quieres lo podemos dejar, si no estás muy seguro."
    kia "Se você quiser, podemos deixar por isso mesmo, caso não tenha muita certeza."

# game/scripts/c24/c24.rpy:2892
translate brazilian c24s004_kiaOnMC_3f4124af:

    # mc "No te preocupes. Quiero probarlo. Hoy es día de descubrimientos."
    mc "Não se preocupe. Quero experimentar. Hoje é um dia de descobertas."

# game/scripts/c24/c24.rpy:2893
translate brazilian c24s004_kiaOnMC_4873ef6e:

    # kia "Voy entonces..."
    kia "Então eu vou..."

# game/scripts/c24/c24.rpy:2895
translate brazilian c24s004_kiaOnMC_2d070b65:

    # "La bibliotecaria deja caer un chorro que impacta en tu pecho. Se siente muy caliente mientras el agua de la ducha elimina la orina nada más tocarte."
    "A bibliotecária deixa cair um jato de água sobre o seu peito. A sensação é de muito calor, pois a água do chuveiro lava a urina assim que toca a sua pele."

# game/scripts/c24/c24.rpy:2896
translate brazilian c24s004_kiaOnMC_e3667a29:

    # mc "Está muy caliente."
    mc "Está muito quente."

# game/scripts/c24/c24.rpy:2897
translate brazilian c24s004_kiaOnMC_ad9a03e7:

    # kia "¿Te gusta?"
    kia "Você gosta disso?"

# game/scripts/c24/c24.rpy:2899
translate brazilian c24s004_kiaOnMC_3b9c8a65:

    # mc "Me gusta, es un descubrimiento interesante. Y tórrido. ¿Qué tal por ahí arriba?"
    mc "Gostei, é uma descoberta interessante. E quente. Como está aí em cima?"

# game/scripts/c24/c24.rpy:2900
translate brazilian c24s004_kiaOnMC_5d36c1ec:

    # kia "Es una sensación... de poder. Me gusta."
    kia "É uma sensação... de poder. Eu gosto disso."

# game/scripts/c24/c24.rpy:2901
translate brazilian c24s004_kiaOnMC_e43aa32d:

    # kia "Sin embargo, al haberlo pedido tú, no me siento como si te estuviera humillando. Eso me gusta aún más."
    kia "No entanto, já que você pediu, não sinto que estou te humilhando. Gosto ainda mais disso."

# game/scripts/c24/c24.rpy:2903
translate brazilian c24s004_kiaOnMC_22e6ad9b:

    # mc "Te estás poniendo cachonda, ¿verdad?"
    mc "Você está ficando excitado(a), não está?"

# game/scripts/c24/c24.rpy:2904
translate brazilian c24s004_kiaOnMC_3aaff82b:

    # kia "No te puedes imaginar cuánto."
    kia "Você não imagina o quanto."

# game/scripts/c24/c24.rpy:2905
translate brazilian c24s004_kiaOnMC_804770bd:

    # kia "Lo malo es que no dura mucho..."
    kia "O problema é que não dura muito..."

# game/scripts/c24/c24.rpy:2906
translate brazilian c24s004_kiaOnMC_46698566:

    # mc "Lo podremos repetir en otro momento, si quieres."
    mc "Podemos repetir em outra ocasião, se você quiser."

# game/scripts/c24/c24.rpy:2908
translate brazilian c24s004_kiaOnMC_e4a948f1:

    # "El chorro acaba inesperadamente. Casi lo echas de menos."
    "O fluxo de água para inesperadamente. Você quase perde a oportunidade."

# game/scripts/c24/c24.rpy:2909
translate brazilian c24s004_kiaOnMC_57759d02:

    # kia "Me parece una idea excelente. Ya me estoy imaginando escenarios..."
    kia "Acho que é uma excelente ideia. Já estou imaginando cenários..."

# game/scripts/c24/c24.rpy:2910
translate brazilian c24s004_kiaOnMC_06dd01f1:

    # mc "*Risa* Voy a acabar de limpiarme y te espero en la habitación. Me tienes que contar esos escenarios."
    mc "*Risos* Vou terminar de arrumar e te espero no quarto. Você tem que me contar sobre esses cenários."

# game/scripts/c24/c24.rpy:2912
translate brazilian c24s004_kiaOnMC_54e794a2:

    # "Vuelves a la habitación después de limpiarte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Você retorna ao quarto depois de se limpar e se secar. Você espera [kia] terminar o banho, olhando para a lareira."

# game/scripts/c24/c24.rpy:2916
translate brazilian c24s004_kiaOnFloor_6d537bfa:

    # kia "¿Cómo va a importarme que mires? Eso era lo más interesante de mi petición..."
    kia "Por que eu deveria me importar se você assiste? Essa foi a parte mais interessante do meu pedido..."

# game/scripts/c24/c24.rpy:2917
translate brazilian c24s004_kiaOnFloor_bd03522c:

    # mc "Eres mucho más traviesa de lo que imaginaba. Me encanta..."
    mc "Você é muito mais travesso do que eu imaginava. Adoro isso..."

# game/scripts/c24/c24.rpy:2919
translate brazilian c24s004_kiaOnFloor_2408be39:

    # kia "¿Vas a mirar desde ahí arriba?"
    kia "Você vai olhar para baixo lá de cima?"

# game/scripts/c24/c24.rpy:2920
translate brazilian c24s004_kiaOnFloor_9b21b8ce:

    # mc "Voy a mirar desde todos los ángulos. No es algo que quiera perderme."
    mc "Vou analisar isso de todos os ângulos. Não é algo que eu queira perder."

# game/scripts/c24/c24.rpy:2921
translate brazilian c24s004_kiaOnFloor_852a656d:

    # kia "Ahí voy, entonces."
    kia "Aqui vou eu, então."

# game/scripts/c24/c24.rpy:2923
translate brazilian c24s004_kiaOnFloor_bbfbdeee:

    # "Un potente chorro amarillento hace su aparición en un momento. Es hipnótico."
    "Um jato amarelo potente surge num instante. É hipnotizante."

# game/scripts/c24/c24.rpy:2924
translate brazilian c24s004_kiaOnFloor_5b30cf74:

    # kia "Me está poniendo cómo me miras..."
    kia "O jeito que você me olha está me excitando..."

# game/scripts/c24/c24.rpy:2925
translate brazilian c24s004_kiaOnFloor_b875b0be:

    # mc "A mí me está poniendo mirarte..."
    mc "Estou ficando excitado(a) só de olhar para você..."

# game/scripts/c24/c24.rpy:2927
translate brazilian c24s004_kiaOnFloor_3947b7fb:

    # "Se forma un pequeño charco en el suelo que lucha por no ser lavado por el agua de la ducha."
    "Uma pequena poça se forma no chão, lutando para não ser levada pela água do chuveiro."

# game/scripts/c24/c24.rpy:2928
translate brazilian c24s004_kiaOnFloor_bc241615:

    # kia "¿Te pongo yo o verme mear?"
    kia "Devo te dar ou devo te observar enquanto eu faço xixi?"

# game/scripts/c24/c24.rpy:2929
translate brazilian c24s004_kiaOnFloor_b65ed262:

    # mc "Las dos cosas... que seas tú quién mee. Que seas tú quién lo ha propuesto."
    mc "As duas coisas... que foi você quem fez xixi. Que foi você quem sugeriu isso."

# game/scripts/c24/c24.rpy:2931
translate brazilian c24s004_kiaOnFloor_dfa67c31:

    # "Cambias de ángulo, no queriendo perderte nada del espectáculo. [kia] cambia de posición para darte una mejor visión."
    "Você muda seu ângulo, não querendo perder nada. [kia] Mude sua posição para ter uma visão melhor."

# game/scripts/c24/c24.rpy:2932
translate brazilian c24s004_kiaOnFloor_01ab4c6d:

    # kia "Ya se está acabando..."
    kia "Está quase no fim..."

# game/scripts/c24/c24.rpy:2933
translate brazilian c24s004_kiaOnFloor_25bda972:

    # mc "Habrá que disfrutar las vistas hasta el último momento, entonces."
    mc "Teremos que aproveitar a vista até o último momento, então."

# game/scripts/c24/c24.rpy:2935
translate brazilian c24s004_kiaOnFloor_caed8249:

    # "El chorro desaparece casi de golpe y el charco un par de segundos después."
    "O jato desaparece quase instantaneamente, e a poça alguns segundos depois."

# game/scripts/c24/c24.rpy:2936
translate brazilian c24s004_kiaOnFloor_a36448f8:

    # mc "Ha durado menos de lo que esperaba... pero ha valido la pena."
    mc "Durou menos do que eu esperava... mas valeu a pena."

# game/scripts/c24/c24.rpy:2937
translate brazilian c24s004_kiaOnFloor_4a613eab:

    # kia "Una experiencia nueva para los dos."
    kia "Uma experiência nova para nós dois."

# game/scripts/c24/c24.rpy:2939
translate brazilian c24s004_kiaOnFloor_2201430b:

    # kia "Ahora mismo estoy cachondísima. Hacer esto delante tuyo ha sido super caliente."
    kia "Estou muito excitada agora. Fazer isso na sua frente foi incrivelmente excitante."

# game/scripts/c24/c24.rpy:2940
translate brazilian c24s004_kiaOnFloor_b406bea8:

    # kia "Y veo que a ti también te ha puesto igual de cachondo. Mjolnir vuelve a estar enorme."
    kia "E vejo que isso também te empolgou bastante. Mjolnir voltou a ser enorme."

# game/scripts/c24/c24.rpy:2941
translate brazilian c24s004_kiaOnFloor_d3071c47:

    # mc "*Risa* ¿Quieres el cuarto asalto? Te estás volviendo avariciosa..."
    mc "*Risos* Quer uma quarta rodada? Você está ficando ganancioso..."

# game/scripts/c24/c24.rpy:2943
translate brazilian c24s004_kiaOnFloor_9f1dbd4c:

    # kia "No creo que pudiera. Ahora quiero acabar de ducharme e ir a la cama a darnos abrazos antes de dormir."
    kia "Acho que não conseguiria. Agora só quero terminar o banho e ir para a cama para podermos ficar de conchinha antes de dormir."

# game/scripts/c24/c24.rpy:2944
translate brazilian c24s004_kiaOnFloor_f5fd80b6:

    # mc "Me parece una idea estupenda. Déjame aclararme y te espero en la cama mientras acabas de ducharte."
    mc "Parece uma ótima ideia. Deixe-me pensar um pouco e eu espero você na cama enquanto termina o banho."

# game/scripts/c24/c24.rpy:2946
translate brazilian c24s004_kiaOnFloor_3935088c:

    # "Vuelves a la habitación después de aclararte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Você retorna ao quarto depois de se enxaguar e se secar. Espera o banho terminar, contemplando a lareira."

# game/scripts/c24/c24.rpy:2954
translate brazilian c24s004_Deb_Sim_f573cf4a:

    # "Después de comer, algunas de las chicas te preguntan si te vas a unir a ellas en la piscina."
    "Depois de comer, algumas das garotas perguntam se você vai se juntar a elas na piscina."

# game/scripts/c24/c24.rpy:2955
translate brazilian c24s004_Deb_Sim_0b862711:

    # "Subes a tu habitación a ponerte el bañador. Quieres relajarte un rato antes de la reunión con Iron Fist de la noche."
    "Você sobe para o seu quarto para vestir seu traje de banho. Você quer relaxar um pouco antes do seu encontro com o Punho de Ferro esta noite."

# game/scripts/c24/c24.rpy:2957
translate brazilian c24s004_Deb_Sim_69ea716e:

    # "Cuando bajas a la piscina, encuentras a [deb.nick] y a [sim] charlando animadamente en el agua."
    "Quando você desce até a piscina, encontra [deb.nick] já [sim] conversando animadamente na água."

# game/scripts/c24/c24.rpy:2959
translate brazilian c24s004_Deb_Sim_9262c7af:

    # mc "¿Qué tal, chicas? ¿Cómo están las dos sirenas?"
    mc "Olá meninas! Como estão as duas sereias?"

# game/scripts/c24/c24.rpy:2960
translate brazilian c24s004_Deb_Sim_b368d369:

    # sim "Genial. Después de ver a un montón de niños nadando esta mañana, tenía ganas de nadar un rato. Y no hay nadie mejor que [deb.nick] para hacerlo."
    sim "Ótimo. Depois de ver um monte de crianças nadando esta manhã, me deu vontade de dar um mergulho também. E não há ninguém melhor que [deb.nick] para fazer isso."

# game/scripts/c24/c24.rpy:2961
translate brazilian c24s004_Deb_Sim_e7d1088a:

    # deb "No exageres, [sim]."
    deb "Não exagere, [sim]."

# game/scripts/c24/c24.rpy:2962
translate brazilian c24s004_Deb_Sim_8db86fd1:

    # mc "¿Hacéis carreras entre vosotras?"
    mc "Vocês competem entre si?"

# game/scripts/c24/c24.rpy:2964
translate brazilian c24s004_Deb_Sim_a7c2f323:

    # sim "*Risa* ¡Qué va! [deb.nick] es demasiado buena para mí."
    sim "*Risos* De jeito nenhum! [deb.nick] Ela é boa demais para mim."

# game/scripts/c24/c24.rpy:2965
translate brazilian c24s004_Deb_Sim_4e273363:

    # sim "Hicimos una amistosa y no tuvo que esforzarse para darme una paliza."
    sim "Tivemos uma partida amistosa e ele não precisou se esforçar muito para me vencer."

# game/scripts/c24/c24.rpy:2967
translate brazilian c24s004_Deb_Sim_74c39d65:

    # deb "No le hagas caso. Está exagerando y está desentrenada."
    deb "Não dê ouvidos a ela. Ela está exagerando e está fora de prática."

# game/scripts/c24/c24.rpy:2968
translate brazilian c24s004_Deb_Sim_be167096:

    # mc "Bueno, lleva tiempo sin nadar. Es lógico."
    mc "Bem, ele não nada há algum tempo. É compreensível."

# game/scripts/c24/c24.rpy:2970
translate brazilian c24s004_Deb_Sim_72045934:

    # sim "Llevo un año sin nadar en una competición y ni siquiera entonces llegué a los campeonatos nacionales."
    sim "Faz um ano que não participo de uma competição de natação, e mesmo assim não consegui me classificar para o campeonato nacional."

# game/scripts/c24/c24.rpy:2971
translate brazilian c24s004_Deb_Sim_0d68806d:

    # sim "Ella llegó y los ganó. Creo que la diferencia está clara, ¿no?"
    sim "Ela entrou e venceu. Acho que a diferença é clara, não é?"

# game/scripts/c24/c24.rpy:2973
translate brazilian c24s004_Deb_Sim_164b1d20:

    # deb "Ya sabes por qué fue. No tienes el cuerpo adecuado para ser nadadora competitiva."
    deb "Você sabe por quê. Você não tem o corpo adequado para ser um nadador competitivo."

# game/scripts/c24/c24.rpy:2974
translate brazilian c24s004_Deb_Sim_b60a4e8e:

    # deb "Te desarrollaste donde no me desarrollé yo, y eso te quita centésimas en cada brazada."
    deb "Você se desenvolveu onde eu não, e isso reduz centésimos de segundo em cada braçada."

# game/scripts/c24/c24.rpy:2976
translate brazilian c24s004_Deb_Sim_abcd2cb9:

    # sim "A veces odio estas tetas..."
    sim "Às vezes eu odeio esses peitos..."

# game/scripts/c24/c24.rpy:2978
translate brazilian c24s004_Deb_Sim_2b71414e:

    # mc "A mí me encantan..."
    mc "Eu os amo..."

# game/scripts/c24/c24.rpy:2981
translate brazilian c24s004_Deb_Sim_cd85f167:

    # sim "También te encantan las de [deb.nick]. *Risa* Tu opinión es bienvenida, pero eres poco quisquilloso en cuanto a tetas."
    sim "Você também adora as da [deb.nick]. *Risos* Sua opinião é bem-vinda, mas você não é muito exigente quando se trata de seios."

# game/scripts/c24/c24.rpy:2982
translate brazilian c24s004_Deb_Sim_a140637f:

    # mc "Tienes razón, ¿para qué negarlo? *Risa*"
    mc "Você tem razão, por que negar? *Risos*"

# game/scripts/c24/c24.rpy:2983
translate brazilian c24s004_Deb_Sim_9f4a647f:

    # mc "Todos tenemos que aceptar el cuerpo que nos toca, [sim]."
    mc "Todos nós temos que aceitar o corpo que nos foi dado, [sim]."

# game/scripts/c24/c24.rpy:2985
translate brazilian c24s004_Deb_Sim_6e665169:

    # mc "Y a mí me gustan los vuestros. Los de las dos."
    mc "E eu gosto da sua. Das duas."

# game/scripts/c24/c24.rpy:2987
translate brazilian c24s004_Deb_Sim_52e20141:

    # deb "¿Sí?" (multiple=2)
    deb "Sim?" (multiple=2)

# game/scripts/c24/c24.rpy:2988
translate brazilian c24s004_Deb_Sim_5a8cda6f:

    # sim "¡Sí!" (multiple=2)
    sim "Sim!" (multiple=2)

# game/scripts/c24/c24.rpy:2989
translate brazilian c24s004_Deb_Sim_4761ff8d:

    # mc "Sí, ¿sobre qué?"
    mc "Sim, sobre o quê?"

# game/scripts/c24/c24.rpy:2992
translate brazilian c24s004_Deb_Sim_7010c693:

    # sim "¡Ahora!"
    sim "Agora!"

# game/scripts/c24/c24.rpy:2993
translate brazilian c24s004_Deb_Sim_5e482cd8:

    # mc "¿QUÉ?"
    mc "QUE?"

# game/scripts/c24/c24.rpy:2995
translate brazilian c24s004_Deb_Sim_d0b5fe9c:

    # mc "*Risa* ¿A qué ha venido eso?"
    mc "*Risos* O que foi isso?"

# game/scripts/c24/c24.rpy:2996
translate brazilian c24s004_Deb_Sim_9d5b35df:

    # sim "*Risa* Me estaba entrando tortícolis de mirar tan arriba."
    sim "*Risos* Fiquei com torcicolo de tanto olhar para cima."

# game/scripts/c24/c24.rpy:2997
translate brazilian c24s004_Deb_Sim_bab7afa5:

    # deb "*Risa* Y a ti te ha tocado un cuerpo poco ágil que no ha podido esquivar nuestros ataques."
    deb "*Risos* E você ficou com um corpo desajeitado que não conseguia se esquivar dos nossos ataques."

# game/scripts/c24/c24.rpy:3000
translate brazilian c24s004_Deb_Sim_e83606cc:

    # sim "Además, tenía ganas de hacer esto."
    sim "Além disso, eu realmente queria fazer isso."

# game/scripts/c24/c24.rpy:3001
translate brazilian c24s004_Deb_Sim_f953d662:

    # mc "Entonces no me voy a quejar del ataque a traición."
    mc "Então não vou reclamar do ataque surpresa."

# game/scripts/c24/c24.rpy:3004
translate brazilian c24s004_Deb_Sim_ff0a09ef:

    # deb "Yo también tenía ganas de besarte."
    deb "Eu também queria te beijar."

# game/scripts/c24/c24.rpy:3005
translate brazilian c24s004_Deb_Sim_fe762c04:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Risos* Você pode me atacar quando quiser, se essa for a recompensa."

# game/scripts/c24/c24.rpy:3008
translate brazilian c24s004_Deb_Sim_229a9d02:

    # deb "Además, tenía ganas de besarte."
    deb "Além disso, eu queria te beijar."

# game/scripts/c24/c24.rpy:3009
translate brazilian c24s004_Deb_Sim_fe762c04_1:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Risos* Você pode me atacar quando quiser, se essa for a recompensa."

# game/scripts/c24/c24.rpy:3011
translate brazilian c24s004_Deb_Sim_0393a250:

    # mc "Y, aparte de atacar a pobres hombres que pasaban por aquí, ¿de qué estabais hablando?"
    mc "E, além de atacar homens pobres que passavam por ali, do que mais você estava falando?"

# game/scripts/c24/c24.rpy:3013
translate brazilian c24s004_Deb_Sim_371b629d:

    # deb "Precisamente estábamos hablando de nadar."
    deb "Estávamos justamente falando sobre natação."

# game/scripts/c24/c24.rpy:3014
translate brazilian c24s004_Deb_Sim_179d63bb:

    # deb "Le estaba diciendo a [sim] que quizás pudiera convencer al entrenador de la universidad para que la dejara entrenar algunos días con nosotras."
    deb "Eu estava dizendo [sim] que talvez eu pudesse convencer o treinador da universidade a deixá-la treinar conosco por alguns dias."

# game/scripts/c24/c24.rpy:3015
translate brazilian c24s004_Deb_Sim_0cb3e1bd:

    # mc "¿Puedes hacer eso?"
    mc "Você consegue fazer isso?"

# game/scripts/c24/c24.rpy:3017
translate brazilian c24s004_Deb_Sim_ea14bc84:

    # sim "¡Claro que puede! ¡Es la estrella de la universidad! Seguro que no le niegan nada."
    sim "Claro que pode! Ela é a estrela da universidade! Tenho certeza de que não vão negar nada a ela."

# game/scripts/c24/c24.rpy:3019
translate brazilian c24s004_Deb_Sim_1ce3d555:

    # sim "Pero prefiero que no lo haga. Sería como... no sé... probar cómo hubiera sido mi vida en otras circunstancias pero no poder vivirla del todo."
    sim "Mas eu preferiria não. Seria como... sei lá... tentar imaginar como teria sido minha vida em outras circunstâncias, mas sem poder vivenciá-la plenamente."

# game/scripts/c24/c24.rpy:3021
translate brazilian c24s004_Deb_Sim_bf03d1c9:

    # deb "¡Es tan cabezota como su hermano!"
    deb "Ele é tão teimoso quanto o irmão!"

# game/scripts/c24/c24.rpy:3022
translate brazilian c24s004_Deb_Sim_52bdc56e:

    # deb "Aprendería técnicas nuevas y cómo se entrena en la universidad. Sólo por eso ya valdría la pena."
    deb "Eu aprenderia novas técnicas e como o treinamento é feito na universidade. Só isso já valeria a pena."

# game/scripts/c24/c24.rpy:3023
translate brazilian c24s004_Deb_Sim_b8aabfc3:

    # mc "Creo que tienes razón, pero también comprendo a [sim]."
    mc "Acho que você tem razão, mas também entendo [sim]."

# game/scripts/c24/c24.rpy:3025
translate brazilian c24s004_Deb_Sim_5a84b9a5:

    # sim "¿Ves? ¡El me entiende!"
    sim "Viu? Ele me entende!"

# game/scripts/c24/c24.rpy:3026
translate brazilian c24s004_Deb_Sim_4ea9139c:

    # mc "Te entiendo, pero no comparto tu decisión."
    mc "Eu entendo você, mas não concordo com a sua decisão."

# game/scripts/c24/c24.rpy:3028
translate brazilian c24s004_Deb_Sim_2e41f7dc:

    # sim "¿Qué?"
    sim "Que?"

# game/scripts/c24/c24.rpy:3029
translate brazilian c24s004_Deb_Sim_1c685b6d:

    # mc "Siempre te ha gustado nadar y ahora tienes que ver cómo otros lo hacen y esperar a que se ahoguen para salvarlos."
    mc "Você sempre adorou nadar, e agora tem que assistir os outros nadando e esperar que eles se afoguem para poder salvá-los."

# game/scripts/c24/c24.rpy:3031
translate brazilian c24s004_Deb_Sim_c2dd440a:

    # sim "*Risa* ¡No se ahoga nadie en mi guardia!"
    sim "*Risos* Ninguém se afoga enquanto eu estiver por perto!"

# game/scripts/c24/c24.rpy:3032
translate brazilian c24s004_Deb_Sim_e2a3c315:

    # mc "[sim], hablo en serio. Entiendo cómo te sientes, pero creo que deberías aceptar la oferta de [deb.nick]."
    mc "[sim], Estou falando sério. Eu entendo como você se sente, mas acho que você deveria aceitar a oferta de [deb.nick]."

# game/scripts/c24/c24.rpy:3033
translate brazilian c24s004_Deb_Sim_fb51b049:

    # mc "Entrenarías con las mejores de la ciudad y, aunque no vuelvas a competir, aprenderás muchísimo."
    mc "Você treinaria com os melhores da cidade e, mesmo que nunca mais competisse, aprenderia muito."

# game/scripts/c24/c24.rpy:3035
translate brazilian c24s004_Deb_Sim_a9a18e0c:

    # deb "Es lo que le he dicho. Además, nuestro entrenador es muy bueno y aprenderá cómo entrenar a otros."
    deb "Foi isso que eu lhe disse. Além disso, nosso treinador é muito bom e ele aprenderá a treinar outros."

# game/scripts/c24/c24.rpy:3037
translate brazilian c24s004_Deb_Sim_df1264f7:

    # deb "Es lo que querías estudiar, ¿no?"
    deb "Era isso que você queria estudar, certo?"

# game/scripts/c24/c24.rpy:3039
translate brazilian c24s004_Deb_Sim_142d4e09:

    # sim "Sí, pero sin la beca, no voy a ir nunca a la universidad. Dudo que nunca sea entrenadora."
    sim "Sim, mas sem a bolsa de estudos, eu nunca vou para a universidade. Duvido que algum dia eu me torne treinador."

# game/scripts/c24/c24.rpy:3040
translate brazilian c24s004_Deb_Sim_cb3953ee:

    # sim "Y con mis récords, nunca voy a conseguir una beca."
    sim "E com o meu histórico, eu nunca vou conseguir uma bolsa de estudos."

# game/scripts/c24/c24.rpy:3041
translate brazilian c24s004_Deb_Sim_f7506dbb:

    # mc "Pero aprenderás mucho igualmente. Y seguirás nadando, que es lo que importa."
    mc "Mas você vai aprender muito de qualquer forma. E vai continuar nadando, que é o que importa."

# game/scripts/c24/c24.rpy:3043
translate brazilian c24s004_Deb_Sim_0f43e16d:

    # deb "Creo que no la vas a convencer. Como he dicho, es casi peor que intentar convencer a Jamaal para que suelte un plato de comida."
    deb "Acho que você não vai convencê-la. Como eu disse, é quase pior do que tentar convencer o Jamaal a dividir um prato de comida."

# game/scripts/c24/c24.rpy:3044
translate brazilian c24s004_Deb_Sim_58e478ce:

    # mc "Siempre he dicho que se parecen mucho. No sé cuál de los dos es más terco."
    mc "Sempre disse que são muito parecidos. Não sei qual é o mais teimoso."

# game/scripts/c24/c24.rpy:3046
translate brazilian c24s004_Deb_Sim_9e085d60:

    # sim "¡Hey! Estoy aquí, ¿sabéis?"
    sim "Ei! Estou aqui, sabia?"

# game/scripts/c24/c24.rpy:3047
translate brazilian c24s004_Deb_Sim_188127f9:

    # "[deb.nick] y tú la ignoráis. Habéis encontrado su punto débil."
    "[deb.nick] e você a ignora. Você descobriu o ponto fraco dela."

# game/scripts/c24/c24.rpy:3049
translate brazilian c24s004_Deb_Sim_30cf8c66:

    # deb "No creas que no la entiendo. Con esos dos flotadores tiene que ser incómodo nadar. En eso se diferencia de Jamaal."
    deb "Não pense que eu não a entendo. Nadar com aquelas duas boias deve ser desconfortável. É isso que a diferencia de Jamaal."

# game/scripts/c24/c24.rpy:3050
translate brazilian c24s004_Deb_Sim_c021f347:

    # mc "*Risa* Sí, creo que Jamaal tiene poca flotabilidad con la silla de ruedas."
    mc "*Risos* Sim, acho que Jamaal tem pouca sustentação na cadeira de rodas."

# game/scripts/c24/c24.rpy:3051
translate brazilian c24s004_Deb_Sim_31753902:

    # mc "Pero, ¿sabes en lo que sí que se parecen? A los dos les cuesta aceptar retos."
    mc "Mas sabe o que eles têm em comum? Ambos têm dificuldade em aceitar desafios."

# game/scripts/c24/c24.rpy:3052
translate brazilian c24s004_Deb_Sim_de0144ff:

    # mc "Jamaal tardó tiempo en descubrir que, aunque tuviera que vivir una vida diferente, podía hacer lo que le gustaba."
    mc "Jamaal levou algum tempo para descobrir que, mesmo tendo que viver uma vida diferente, ele podia fazer o que amava."

# game/scripts/c24/c24.rpy:3054
translate brazilian c24s004_Deb_Sim_903a7b4e:

    # sim "¡Tenía once años! ¡Era un niño!"
    sim "Ele tinha onze anos! Era apenas uma criança!"

# game/scripts/c24/c24.rpy:3055
translate brazilian c24s004_Deb_Sim_866a67f9:

    # "Seguís ignorándola."
    "Você continua a ignorá-la."

# game/scripts/c24/c24.rpy:3057
translate brazilian c24s004_Deb_Sim_f9147568:

    # deb "Y es una lástima que [sim] se comporte como una niña de once años, ¿verdad?"
    deb "E é uma pena que [sim] esteja agindo como uma menina de onze anos, não é?"

# game/scripts/c24/c24.rpy:3058
translate brazilian c24s004_Deb_Sim_a34fa9e3:

    # mc "Sí, una verdadera lástima. Va a dejar de hacer lo que le gusta porque no puede hacerlo al nivel que le gustaría."
    mc "Sim, é uma verdadeira pena. Ela vai ter que parar de fazer o que ama porque não consegue fazê-lo no nível que gostaria."

# game/scripts/c24/c24.rpy:3059
translate brazilian c24s004_Deb_Sim_ce1a8e38:

    # deb "*Risa* Justo como su hermano." (multiple=2)
    deb "*Risos* Igualzinho ao irmão dele." (multiple=2)

# game/scripts/c24/c24.rpy:3060
translate brazilian c24s004_Deb_Sim_c7beffad:

    # mc "*Risa* Justo como Jamaal." (multiple=2)
    mc "*Risos* Igualzinho ao Jamaal." (multiple=2)

# game/scripts/c24/c24.rpy:3061
translate brazilian c24s004_Deb_Sim_def7e49a:

    # mc "¿Sabes que Jam estuvo a punto de no ir al baile de graduación?"
    mc "Você sabia que Jam quase não foi ao baile de formatura?"

# game/scripts/c24/c24.rpy:3063
translate brazilian c24s004_Deb_Sim_28bc3de6:

    # sim "¡Porque le dejó su novio dos semanas antes del baile!"
    sim "Porque o namorado dela terminou com ela duas semanas antes do baile!"

# game/scripts/c24/c24.rpy:3065
translate brazilian c24s004_Deb_Sim_fad15be1:

    # "[deb.nick] continúa como si no hubiera escuchado nada."
    "[deb.nick] continua como se não tivesse ouvido nada."

# game/scripts/c24/c24.rpy:3066
translate brazilian c24s004_Deb_Sim_14558884:

    # deb "¿Porque no podía bailar?"
    deb "Por que ela não conseguia dançar?"

# game/scripts/c24/c24.rpy:3067
translate brazilian c24s004_Deb_Sim_78320f97:

    # mc "No, le encanta bailar y hace unas cosas tremendas con las ruedas. Pero no quería porque no podía bailar con quién él hubiera querido bailar."
    mc "Não, ele adora dançar e faz coisas incríveis com as rodas. Mas ele não queria porque não podia dançar com a pessoa com quem queria dançar."

# game/scripts/c24/c24.rpy:3068
translate brazilian c24s004_Deb_Sim_bd261694:

    # mc "Es como su hermana. Ella no quiere nadar porque no puede nadar en competiciones."
    mc "Ela é igualzinha à irmã. Não quer nadar porque não consegue competir."

# game/scripts/c24/c24.rpy:3069
translate brazilian c24s004_Deb_Sim_befe1427:

    # mc "Yo convencí a Jam, pero te tocará a ti convencer a [sim]."
    mc "Eu convenci Jam, mas caberá a você convencer [sim]."

