translate brazilian c24s002_Breakfast_c2aea1ca:

    # bet "*Risa* Algún día te lo explicaré. De momento me voy a vestir y vamos a desayunar."
    bet "*Risos* Um dia eu explico. Por agora, vou me vestir e vamos tomar café da manhã."

# game/scripts/c24/c24.rpy:858
translate brazilian c24s002_Breakfast_74611842:

    # bet "¡Estoy hambrienta!"
    bet "Estou com fome!"

# game/scripts/c24/c24.rpy:861
translate brazilian c24s002_Breakfast_faa0be63:

    # "Después de desayunar, vais a devolver el coche de [emm] antes de ir a la iglesia."
    "Após o café da manhã, você devolverá o carro [emm] antes de ir à igreja."

# game/scripts/c24/c24.rpy:871
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_3e742448:

    # "Mientras tanto, en casa..."
    "Enquanto isso, em casa..."

# game/scripts/c24/c24.rpy:874
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_adb8ee67:

    # mom "Buenos días, [kim] y [kat]."
    mom "Bom dia, [kim] e [kat]."

# game/scripts/c24/c24.rpy:875
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_ebe2be00:

    # mom "¿Cómo fue el trabajo, [kim]? No he tenido oportunidad de preguntarte."
    mom "Como foi o trabalho, [kim]? Não tive oportunidade de te perguntar."

# game/scripts/c24/c24.rpy:877
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8764505b:

    # kat "Buenos días, [mar]. Voy a preparar el café."
    kat "Bom dia, [mar]. Vou fazer o café."

# game/scripts/c24/c24.rpy:878
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_981a280b:

    # kim "Buenos días, [mar]."
    kim "Bom dia, [mar]."

# game/scripts/c24/c24.rpy:879
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_0e81fe60:

    # kim "Fue muy bien. El yate era increíble, y estuve casi todo el rato en el helipuerto, recibiendo a los invitados."
    kim "Tudo correu muito bem. O iate era incrível e passei quase todo o tempo no heliporto, cumprimentando os convidados."

# game/scripts/c24/c24.rpy:881
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_4658f748:

    # mom "¿Un yate con helipuerto? Tenía que ser enorme."
    mom "Um iate com heliponto? Tinha que ser enorme."

# game/scripts/c24/c24.rpy:883
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_d40564ed:

    # kim "Era gigantesco. Hay otro evento mañana en el mismo yate y me han llamado de la agencia porque me vuelven a contratar."
    kim "Foi gigantesco. Amanhã haverá outro evento no mesmo iate, e a agência me ligou porque vão me contratar novamente."

# game/scripts/c24/c24.rpy:884
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_572aa522:

    # kim "Estoy muy contenta. Si me siguen llamando de eventos así, no voy a tener problemas económicos por un tiempo."
    kim "Estou muito feliz. Se eu continuar recebendo convites para eventos como este, não terei problemas financeiros por um bom tempo."

# game/scripts/c24/c24.rpy:885
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_c3af110c:

    # kim "Me daba miedo no encontrar demasiados trabajos en el área de Newport."
    kim "Tinha receio de não encontrar muitos empregos na região de Newport."

# game/scripts/c24/c24.rpy:887
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_0ee60a3b:

    # mom "[kim], si en algún momento tuvieras algún tipo de problema de dinero, no te preocupes por pagar la residencia."
    mom "[kim], se em algum momento você tiver algum tipo de problema financeiro, não se preocupe em pagar pela residência."

# game/scripts/c24/c24.rpy:888
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_596f889b:

    # mom "Podemos aplazar los pagos el tiempo que sea necesario."
    mom "Podemos adiar os pagamentos pelo tempo que for necessário."

# game/scripts/c24/c24.rpy:890
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_eb9d0edd:

    # kim "Gracias, [mar], pero no creo que sea necesario. Este tipo de eventos paga muy bien."
    kim "Obrigado, [mar], mas não acho necessário. Esse tipo de evento paga muito bem."

# game/scripts/c24/c24.rpy:891
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_51dcb881:

    # kim "Y si la agencia me ha llamado para otro evento del mismo cliente que paga aún mejor, significa que están contentos conmigo."
    kim "E se a agência me chamou para outro evento do mesmo cliente, que paga ainda melhor, significa que eles estão satisfeitos comigo."

# game/scripts/c24/c24.rpy:893
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_b087125c:

    # kat "Aquí tienes tu café, [kim]."
    kat "Aqui está seu café, [kim]."

# game/scripts/c24/c24.rpy:894
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_4304a774:

    # kim "Gracias, [kat]."
    kim "Obrigado, [kat]."

# game/scripts/c24/c24.rpy:896
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8adf96a4:

    # kat "¿Tienes algo que hacer ahora mismo, [mar]? ¿Tienes unos minutos libres?"
    kat "Você tem algo para fazer agora, [mar]? Você tem alguns minutos livres?"

# game/scripts/c24/c24.rpy:898
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8a55e7e1:

    # mom "Para vosotras siempre tengo tiempo libre, ¿por qué? ¿Qué necesitáis?"
    mom "Eu sempre tenho tempo livre para você, por quê? Do que você precisa?"

# game/scripts/c24/c24.rpy:900
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_9aac37a3:

    # kat "Yo no necesito nada en concreto, pero lo que hizo [deb.nick] el otro día me dio una idea."
    kat "Não preciso de nada específico, mas o que [deb.nick] fez outro dia me deu uma ideia."

# game/scripts/c24/c24.rpy:901
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_d2733ffc:

    # kat "[kim] lleva días queriendo hablar contigo, pero siempre lo retrasa diciendo que estás muy ocupada."
    kat "[kim] está querendo falar com você há dias, mas você sempre adia dizendo que está muito ocupado."

# game/scripts/c24/c24.rpy:903
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_0252c9ed:

    # kim "¡[kat]!"
    kim "[kat]!"

# game/scripts/c24/c24.rpy:905
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8128c913:

    # kat "Y no os voy a encerrar en la cocina para que habléis, pero si ahora tienes un momento para que lo hagáis..."
    kat "E eu não vou te trancar na cozinha para conversar, mas se você tiver um tempinho agora para isso..."

# game/scripts/c24/c24.rpy:906
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_4c5d3b6a:

    # kat "Creo que si nadie fuerza un poco la situación, vamos a acabar nuestras carreras antes de que [kim] se atreva a hacerlo."
    kat "Acho que se ninguém pressionar um pouco a situação, vamos acabar com nossas carreiras antes mesmo que [kim] se atreva a fazer isso."

# game/scripts/c24/c24.rpy:908
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_241a1e06:

    # kim "¡[kat]! ¡No hay prisa en hablarlo!"
    kim "[kat]! Não há pressa para falar sobre isso!"

# game/scripts/c24/c24.rpy:910
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_2a9e0064:

    # mom "¿Qué pasa [kim]? ¿Hay algo en la casa que no te guste?"
    mom "O que há de errado, [kim]? Tem alguma coisa na casa que você não gosta?"

# game/scripts/c24/c24.rpy:912
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_6726d263:

    # kat "*Risa* Más bien al contrario."
    kat "*Risos* Muito pelo contrário."

# game/scripts/c24/c24.rpy:913
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_396339f7:

    # kat "Bueno, yo os dejo y voy a tomarme el café a mi habitación."
    kat "Bem, vou indo tomar meu café no meu quarto."

# game/scripts/c24/c24.rpy:915
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_daffc386:

    # kim "¡[kat], esta me la apunto!"
    kim "[kat], Vou anotar isso!"

# game/scripts/c24/c24.rpy:917
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_9c97a615:

    # mom "¿Qué pasa, [kim]?"
    mom "E aí, [kim]?"

# game/scripts/c24/c24.rpy:919
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_b9c2dae2:

    # kim "No es nada, en serio. Es sólo una tontería."
    kim "Não é nada, na verdade. É só uma bobagem."

# game/scripts/c24/c24.rpy:921
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_a6248df6:

    # mom "Sabes que puedes hablar conmigo de cualquier cosa, ¿verdad?"
    mom "Você sabe que pode conversar comigo sobre qualquer coisa, né?"

# game/scripts/c24/c24.rpy:923
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_33cb449b:

    # mom "*Risa* Acabo de sonar como sonaba cuando hablaba con [emm] cuando era más joven."
    mom "*Risos* Eu estava falando exatamente como quando conversava com [emm] quando era mais jovem."

# game/scripts/c24/c24.rpy:924
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_6693b324:

    # mom "Me sale la vena maternal con tantas chicas en casa."
    mom "Meus instintos maternos afloram com tantas meninas em casa."

# game/scripts/c24/c24.rpy:926
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_64ee79a9:

    # kim "Precisamente por eso..."
    kim "É exatamente por isso..."

# game/scripts/c24/c24.rpy:928
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_06ebc64d:

    # mom "¿Es por lo del otro día cuando estuviste a punto de llamarme Mamá?"
    mom "É por causa do que aconteceu outro dia, quando você quase me chamou de mãe?"

# game/scripts/c24/c24.rpy:929
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8a940879:

    # mom "No te preocupes por eso. A mí no me importa... Es más, me gusta que te sientas tan cómoda conmigo."
    mom "Não se preocupe com isso. Não me incomoda... Na verdade, gosto que você se sinta tão à vontade comigo."

# game/scripts/c24/c24.rpy:930
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_5c4ce74c:

    # mom "Ven aquí, dame un abrazo."
    mom "Vem cá, me dá um abraço."

# game/scripts/c24/c24.rpy:932
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_5de54c7a:

    # kim "Gracias, [mar]. Pero solo tiene que ver parcialmente con eso."
    kim "Obrigado, [mar]. Mas isso só está parcialmente relacionado."

# game/scripts/c24/c24.rpy:933
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_666b222d:

    # kim "Me gusta mucho la relación que estamos desarrollando y no quiero estropearla."
    kim "Gosto muito da relação que estamos desenvolvendo e não quero estragá-la."

# game/scripts/c24/c24.rpy:935
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_7eb4d1d9:

    # mom "¿Por qué ibas a estropearla? Eres una chica fantástica, [kim], y no creo que hayas hecho nada malo desde que has llegado a casa."
    mom "Por que você estragaria tudo? Você é uma garota fantástica, [kim], e eu não acho que você tenha feito nada de errado desde que voltou para casa."

# game/scripts/c24/c24.rpy:937
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_daaea5ea:

    # kim "Al final me vas a emocionar. *Risa* Si me pongo a llorar como una tonta será culpa tuya."
    kim "Você vai me emocionar no final. *Risos* Se eu começar a chorar feito boba, a culpa será sua."

# game/scripts/c24/c24.rpy:939
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_31f1468d:

    # mom "Si necesitas llorar como una tonta, hazlo. Si quieres que lloremos juntas, explícame qué te pasa y lloramos juntas."
    mom "Se você precisar chorar como uma boba, chore à vontade. Se quiser que choremos juntas, me diga o que há de errado e choraremos juntas."

# game/scripts/c24/c24.rpy:941
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_bcd80104:

    # kim "Lo pones tan fácil y tan difícil a la vez..."
    kim "Você torna tudo tão fácil e tão difícil ao mesmo tempo..."

# game/scripts/c24/c24.rpy:943
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_1095ab3d:

    # mom "[kim], dime que te pasa. Va a ser muy difícil ayudarte si no me lo explicas."
    mom "[kim], diga-me o que está errado. Vai ser muito difícil te ajudar se você não me explicar."

# game/scripts/c24/c24.rpy:945
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_340e6cf6:

    # kim "Es por [mc]."
    kim "É por causa de [mc]."

# game/scripts/c24/c24.rpy:947
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_332a4ee8:

    # mom "¿Qué pasa con él? ¿Ha hecho algo malo? ¿Te ha dicho algo que no te haya gustado?"
    mom "O que há de errado com ele? Ele fez algo errado? Ele disse algo que você não gostou?"

# game/scripts/c24/c24.rpy:949
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_45bba21c:

    # mom "Aparte de la tontería que dijo sobre tu maquillaje corporal, claro."
    mom "Deixando de lado as bobagens que ela disse sobre a sua maquiagem corporal, é claro."

# game/scripts/c24/c24.rpy:951
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_b873221a:

    # kim "No. No ha hecho nada malo. Es justo al revés. Es... demasiado bueno conmigo..."
    kim "Não. Ele não fez nada de errado. Pelo contrário. Ele é... bom demais para mim..."

# game/scripts/c24/c24.rpy:953
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_875e2296:

    # mom "Y crees que estás empezando a desarrollar sentimientos por él, ¿no?"
    mom "E você acha que está começando a desenvolver sentimentos por ele, não é?"

# game/scripts/c24/c24.rpy:955
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_c77fa3fa:

    # kim "¿Cómo lo sabes?"
    kim "Como você sabe?"

# game/scripts/c24/c24.rpy:957
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8c059369:

    # mom "Sólo hace falta verte cuando está cerca, cielo."
    mom "Você só precisa me ver quando eu estiver por perto, querida."

# game/scripts/c24/c24.rpy:958
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_dd583115:

    # mom "Cuando empezamos a sentir algo por alguien creemos que nadie se da cuenta, y tan solo no se dan cuenta quienes no nos ven... y [mc]."
    mom "Quando começamos a sentir algo por alguém, pensamos que ninguém percebe, e apenas aqueles que não nos veem não percebem... e [mc]."

# game/scripts/c24/c24.rpy:959
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_cfec4b4f:

    # mom "Además, yo pasé por lo mismo, con lo que reconozco los síntomas."
    mom "Além disso, passei pela mesma situação, então reconheço os sintomas."

# game/scripts/c24/c24.rpy:962
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_f922bef6:

    # kim "¿Qué? ¿Tú?"
    kim "O quê? Você?"

# game/scripts/c24/c24.rpy:965
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_eb6333b2:

    # mom "Sí. Fue unos días antes de que llegarais. Me sentía confundida y creía que me estaba enamorando de mi propio hijo."
    mom "Sim. Foi alguns dias antes da sua chegada. Eu estava confusa e pensei que estava me apaixonando pelo meu próprio filho."

# game/scripts/c24/c24.rpy:967
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_86bd4195:

    # mom "Sí. Fue unos días antes de que llegarais. Me sentía confundida y creía que me estaba enamorando de [mc]."
    mom "Sim. Foi alguns dias antes de você chegar. Eu estava me sentindo confusa e pensei que estava me apaixonando por [mc]."

# game/scripts/c24/c24.rpy:968
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_c3e1e9f9:

    # mom "Por suerte, [mc] tiene la costumbre de hablarlo todo y lo aclaramos muy rápido antes de que nadie saliera herido."
    mom "Felizmente, [mc] tem o hábito de conversar sobre tudo e esclarecemos as coisas muito rapidamente antes que alguém se machucasse."

# game/scripts/c24/c24.rpy:969
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_3f4e2da7:

    # mom "Quizás deberías hacer lo mismo. ¿Lo has hecho ya?"
    mom "Talvez você devesse fazer o mesmo. Você já fez isso?"

# game/scripts/c24/c24.rpy:972
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_db849359:

    # kim "Por eso es un problema..."
    kim "É por isso que é um problema..."

# game/scripts/c24/c24.rpy:974
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_2414f6c0:

    # mom "¿Te preocupa compartir a [mc] conmigo?"
    mom "Você está preocupado em compartilhar [mc] comigo?"

# game/scripts/c24/c24.rpy:976
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_58a888ab:

    # kim "Me preocupa cómo te vas a sentir tú si intento algo con [mc]. Salís juntos."
    kim "Estou preocupada com o que você vai achar se eu tentar algo com [mc]. Vocês dois estão namorando."

# game/scripts/c24/c24.rpy:978
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_702f9a83:

    # kim "Y es tu hijo."
    kim "E ele é seu filho."

# game/scripts/c24/c24.rpy:981
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_e11d19e1:

    # mom "Ya sabes que no tenemos una relación exclusiva y que no soy la única mujer con la que sale."
    mom "Você sabe que não temos um relacionamento exclusivo e que eu não sou a única mulher com quem ele sai."

# game/scripts/c24/c24.rpy:982
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_8a03cbc8:

    # mom "No sé por qué me debería importar que una chica tan fantástica como tú se uniera al harén."
    mom "Não sei por que deveria me importar se uma garota tão fantástica como você entrasse para o harém."

# game/scripts/c24/c24.rpy:984
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_e1945317:

    # mom "Salimos juntos, pero nunca hemos hablado de exclusividad."
    mom "Saímos juntos, mas nunca falamos sobre exclusividade."

# game/scripts/c24/c24.rpy:985
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_b53d6dcd:

    # mom "Si alguna vez [mc] se plantea tener un harén, me encantaría que tú formaras parte de él, si quieres."
    mom "Se [mc] algum dia considerar ter um harém, adoraria que você fizesse parte dele, se quiser."

# game/scripts/c24/c24.rpy:986
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_79e93dbf:

    # mom "Pero para eso, primero tienes que hablar con él. ¿Lo has hecho ya?"
    mom "Mas para isso, primeiro você precisa falar com ele. Você já fez isso?"

# game/scripts/c24/c24.rpy:988
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_1b5d5547:

    # kim "Lo intenté... o para ser más exactos, lo hablé."
    kim "Eu tentei... ou, para ser mais preciso, eu falei sobre isso."

# game/scripts/c24/c24.rpy:989
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_198169d6:

    # kim "Se dio cuenta de que me pasaba algo cuando estaba cerca y me preguntó. No pude mentirle."
    kim "Ela percebeu que algo estava errado quando estava perto de mim e perguntou. Eu não podia mentir para ela."

# game/scripts/c24/c24.rpy:991
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_031d8a54:

    # mom "¿Y qué dijo? No estaríamos hablando de esto si no te hubiera dado esperanzas."
    mom "E o que ele disse? Não estaríamos falando sobre isso se ele não tivesse te dado esperança."

# game/scripts/c24/c24.rpy:992
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_1976cc2f:

    # mom "Y si te dio falsas esperanzas se lo haremos pagar juntas."
    mom "E se ele te deu falsas esperanças, faremos com que ele pague por isso juntos."

# game/scripts/c24/c24.rpy:994
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_b9b815f2:

    # kim "No, se comportó muy bien. Le dije que me preocupaba tu opinión y dijo que no me daría una respuesta... o esperanzas... hasta que no lo hablara contigo."
    kim "Não, ele se comportou muito bem. Eu disse a ele que estava preocupada com a sua opinião, e ele disse que não me daria uma resposta... nem qualquer esperança... até que tivesse falado com você sobre isso."

# game/scripts/c24/c24.rpy:996
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_c510c23b:

    # mom "Típico de [mc]. Él ya debería saber lo que yo iba a responder."
    mom "Típico do [mc]. Ele já deveria saber o que eu ia responder."

# game/scripts/c24/c24.rpy:998
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_2874cf78:

    # mom "Me encantaría que salieras con mi hijo si los dos queréis."
    mom "Eu adoraria que você saísse com meu filho, se ambos quiserem."

# game/scripts/c24/c24.rpy:1000
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_d18c97e6:

    # mom "Me encantaría que salieras con [mc] si los dos queréis."
    mom "Eu adoraria que você saísse com [mc] se ambos quiserem."

# game/scripts/c24/c24.rpy:1001
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_3ff3fc95:

    # mom "Pero quería que lo solucionaras en tus propios términos sin importar lo que él quisiera o pensara sobre mi respuesta."
    mom "Mas eu queria que você resolvesse isso por conta própria, independentemente do que ele quisesse ou pensasse da minha resposta."

# game/scripts/c24/c24.rpy:1002
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_d73474a4:

    # mom "Y no te dio esperanzas para que, una vez te diera mi respuesta, todo dependiera de ti."
    mom "E ele não te deu nenhuma esperança de que, uma vez que eu te desse minha resposta, tudo dependeria de você."

# game/scripts/c24/c24.rpy:1004
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_1a8e2c1a:

    # kim "Para lo inocente que es a veces, parece un plan muy taimado. *Risita*"
    kim "Por mais inocente que ele seja às vezes, parece um plano muito astuto. *Risos*"

# game/scripts/c24/c24.rpy:1006
translate brazilian c24s002_Meanwhile_Kim_Mar_Kat_7b05d62a:

    # mom "Es muy inocente para muchas cosas, y eso me encanta de él, pero creo que está evolucionando mucho."
