# game/scripts/c24/c24.rpy:3180
translate brazilian c24s004_Mad_Lis_Emm_b12266cc:

    # emm "*Risa* Y si haces un vestido rosa, yo me presto voluntaria para posar con él."
    emm "*Risos* E se você fizer um vestido rosa, eu me ofereço para posar com ele."

# game/scripts/c24/c24.rpy:3181
translate brazilian c24s004_Mad_Lis_Emm_980c43f9:

