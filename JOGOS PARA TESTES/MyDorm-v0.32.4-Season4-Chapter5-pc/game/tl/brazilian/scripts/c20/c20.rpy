translate brazilian c20s004_Farewell_59d20dac:

    # mcdd "Pues cuando quieras, nos podemos ir."
    mcdd "Bom, podemos ir quando você quiser."

# game/scripts/c20/c20.rpy:2179
translate brazilian c20s004_Farewell_18598a42:

    # dap "*En el mundo real* Os despedís de Marzia..."
    dap "*No mundo real* Você se despede de Marzia..."

# game/scripts/c20/c20.rpy:2180
translate brazilian c20s004_Farewell_3e35ca29:

    # mad "*En el mundo real* Nos aseguramos de darle las gracias por las provisiones."
    mad "*Na vida real* Fizemos questão de agradecer pelos materiais."

# game/scripts/c20/c20.rpy:2182
translate brazilian c20s004_Farewell_b032d0ca:

    # mad "*En el mundo real* También nos despedimos de Alba, la chica a la que gritó que se ocupara de los clientes cuando llegaron los BDSM. Supongo que debe ser su ayudante."
    mad "*Na vida real* Também nos despedimos de Alba, a garota para quem ele gritou para cuidar dos clientes quando os caras do BDSM chegaram. Acho que ela deve ser a assistente dele."

# game/scripts/c20/c20.rpy:2183
translate brazilian c20s004_Farewell_d673b801:

    # mc "*En el mundo real* Ni siquiera me acordaba de ella... no hemos interactuado con ella para nada."
    mc "*No mundo real*, eu nem me lembrava dela... não interagimos com ela em nenhum momento."

# game/scripts/c20/c20.rpy:2184
translate brazilian c20s004_Farewell_c8543d85:

    # mad "*En el mundo real* Bueno, se supone que si es la camarera de la taberna, nos habrá traído comida o bebida."
    mad "*No mundo real* Bem, se ela é a garçonete da taverna, deveria ter nos trazido comida ou bebida."

# game/scripts/c20/c20.rpy:2185
translate brazilian c20s004_Farewell_b2ad90a0:

    # dap "*En el mundo real* Bien visto, Maddie. Scarlett, [eri], y [emm] casi siempre se olvidan de ella."
    dap "*No mundo real* Muito bem observado, Maddie. Scarlett, [eri] e [emm] quase sempre se esquecem dela."

# game/scripts/c20/c20.rpy:2186
translate brazilian c20s004_Farewell_785efda1:

    # dap "*En el mundo real* No hay rastro de Beagan, Aelia, Paula, o Pia."
    dap "*No mundo real* Não há nenhum vestígio de Beagan, Aelia, Paula ou Pia."

# game/scripts/c20/c20.rpy:2187
translate brazilian c20s004_Farewell_11698653:

    # mc "*En el mundo real* Le pedimos a Marzia que nos despida de ellas y nos vamos a los establos. No olvido las provisiones."
    mc "*No mundo real* Pedimos a Marzia que se despeça de nós e seguimos para os estábulos. Não me esqueci dos suprimentos."

# game/scripts/c20/c20.rpy:2189
translate brazilian c20s004_Farewell_a38145c0:

    # dap "*En el mundo real* De camino a los establos veis a Thiel y el chico de la alabarda charlando, sentados en un banco."
    dap "*No mundo real* No caminho para os estábulos, você vê Thiel e o garoto com a alabarda conversando, sentados em um banco."

# game/scripts/c20/c20.rpy:2191
translate brazilian c20s004_Farewell_60a85db1:

    # dap "*En el mundo real* ¡Están cogidos de la mano! *Risa* Parece que tu fallo crítico ha creado una pareja en el pueblo."
    dap "*Na vida real* Eles estão de mãos dadas! *Risos* Parece que seu fracasso crítico gerou um casal na cidade."

# game/scripts/c20/c20.rpy:2193
translate brazilian c20s004_Farewell_885f9659:

    # mc "*En el mundo real* Me acerco a ellos para despedirnos... pero solo si no parece que vaya a interrumpir algo."
    mc "*No mundo real*, eu me aproximo deles para me despedir... mas só se não parecer que vou interromper algo."

# game/scripts/c20/c20.rpy:2194
translate brazilian c20s004_Farewell_166b13f1:

    # mad "*En el mundo real* Yo también me acerco. Quiero despedirme de los tortolitos."
    mad "*No mundo real*, eu também vou. Quero me despedir dos pombinhos."

# game/scripts/c20/c20.rpy:2196
translate brazilian c20s004_Farewell_87c418f9:

    # mcd "Thiel, [wil], nos vamos ya. Un placer haberos conocido."
    mcd "Thiel, [wil], estamos indo embora agora. Foi um prazer conhecê-lo."

# game/scripts/c20/c20.rpy:2197
translate brazilian c20s004_Farewell_f149b226:

    # madd "Lo mismo digo, chicos."
    madd "Aqui também, pessoal."

# game/scripts/c20/c20.rpy:2199
translate brazilian c20s004_Farewell_360e7491:

    # thi "Muchas gracias por lo de ayer. Es una lástima que no se puedan quedar ustedes en el pueblo. La Señora Paula ya nos ha dicho que se tienen que marchar."
    thi "Muito obrigada por ontem. É uma pena que você não possa ficar na vila. A Sra. Paula já nos disse que você precisa ir embora."

# game/scripts/c20/c20.rpy:2201
translate brazilian c20s004_Farewell_c34ebee4:

    # madd "Sí, muchacha. Vamos a buscar trabajo a Vindobona."
    madd "Sim, querida. Vamos procurar trabalho em Vindobona."

# game/scripts/c20/c20.rpy:2202
translate brazilian c20s004_Farewell_fb4cbe08:

    # mcd "Nos han dicho que aquí no vamos a encontrar trabajo escoltando caravanas."
    mcd "Nos disseram que não encontraremos trabalho aqui escoltando caravanas."

# game/scripts/c20/c20.rpy:2204
translate brazilian c20s004_Farewell_27f53f3c:

    # wil "Pero aquí hay mucho trabajo si lo quieren, hay muchas granjas sin manos que las trabajen. O podrían trabajar para las Protectoras."
    wil "Mas há muito trabalho por aqui, se eles quiserem; existem muitas fazendas sem trabalhadores. Ou eles poderiam trabalhar em abrigos de animais."

# game/scripts/c20/c20.rpy:2205
translate brazilian c20s004_Farewell_3dcff2aa:

    # mcd "Suena tentador, pero no es el tipo de trabajo que buscamos ahora mismo."
    mcd "Parece tentador, mas não é o tipo de trabalho que estamos procurando no momento."

# game/scripts/c20/c20.rpy:2207
translate brazilian c20s004_Farewell_af9de7cd:

    # thi "Es una lástima. Echaré de menos a Júpiter, Señora. Me cae muy bien. Me ha pedido que le dé las gracias por lo de Capua. No me ha dicho de qué se trata."
    thi "Que pena. Vou sentir falta de Júpiter, senhora. Eu gostava muito dele. Ele me pediu para lhe agradecer por Cápua. Ele não me disse do que se tratava."

# game/scripts/c20/c20.rpy:2209
translate brazilian c20s004_Farewell_724d248b:

    # madd "¿Qué? ¿Puedes hablar con Júpiter?"
    madd "O quê? Você consegue falar com Júpiter?"

# game/scripts/c20/c20.rpy:2211
translate brazilian c20s004_Farewell_cdd8f6cd:

    # thi "Claro... Soy una chica gato, al fin y al cabo. Habla con un acento raro, pero nos entendemos."
    thi "Claro... afinal, eu sou uma garota-gato. Ela fala com um sotaque engraçado, mas a gente se entende."

# game/scripts/c20/c20.rpy:2212
translate brazilian c20s004_Farewell_5e9087b4:

    # mcd "*Risa* Me parece la mejor explicación que he oído nunca."
    mcd "*Risos* Essa é a melhor explicação que já ouvi."

# game/scripts/c20/c20.rpy:2213
translate brazilian c20s004_Farewell_8a10a3d2:

    # thi "Él le entiende casi todo lo que dice, al menos cuando habla Latín, pero no puede contestarle."
    thi "Ele entende quase tudo o que ela diz, pelo menos quando ela fala em latim, mas não consegue respondê-la."

# game/scripts/c20/c20.rpy:2215
translate brazilian c20s004_Farewell_d58e1c0c:

    # mad "*En el mundo real* Abrazo a Júpiter."
    mad "*No mundo real*, eu abraço Júpiter."

# game/scripts/c20/c20.rpy:2216
translate brazilian c20s004_Farewell_6f8bb913:

    # madd "Sabes que eres mi compañero, gatito."
    madd "Você sabe que é minha parceira, gatinha."

# game/scripts/c20/c20.rpy:2217
translate brazilian c20s004_Farewell_3fb43df7:

    # jup "*Ronroneo*"
    jup "*Ronronar*"

# game/scripts/c20/c20.rpy:2218
translate brazilian c20s004_Farewell_2d298b27:

    # thi "Dice que no podría tener una compañera mejor."
    thi "Ele diz que não poderia ter um parceiro melhor."

# game/scripts/c20/c20.rpy:2220
translate brazilian c20s004_Farewell_f5fac812:

    # mcd "Sólo queríamos despedirnos, chicos. Ha sido un placer conoceros."
    mcd "Só queríamos nos despedir, pessoal. Foi um prazer conhecer vocês."

# game/scripts/c20/c20.rpy:2222
translate brazilian c20s004_Farewell_fd570581:

    # wil "Guardaré su moneda siempre, Señor. Muchas gracias."
    wil "Guardarei sua moeda para sempre, senhor. Muito obrigado."

# game/scripts/c20/c20.rpy:2223
translate brazilian c20s004_Farewell_8d9f58ec:

    # mcd "*Susurrando* Si puedo darte un consejo, ponte un nombre más fácil de recordar, [wil]."
    mcd "*Sussurrando* Se eu puder te dar um conselho, escolha um nome que seja mais fácil de lembrar, [wil]."

# game/scripts/c20/c20.rpy:2224
translate brazilian c20s004_Farewell_e0e0f25c:

    # mc "*En el mundo real* *Risa*"
    mc "*No mundo real* *Risos*"

# game/scripts/c20/c20.rpy:2226
translate brazilian c20s004_Farewell_6cb39545:

    # wil "¡Oh, lo haré! Cuando tenga mi propia AVN."
    wil "Ah, com certeza! Quando eu tiver meu próprio AVN."

# game/scripts/c20/c20.rpy:2228
translate brazilian c20s004_Farewell_ae66b4fc:

    # mc "*En el mundo real* ¿Qué? ¿AVN?" (multiple=2)
    mc "*No mundo real* O quê? AVN?" (multiple=2)

# game/scripts/c20/c20.rpy:2229
translate brazilian c20s004_Farewell_d1c1869d:

    # mcd "¿Qué quieres decir con AVN?" (multiple=2)
    mcd "O que você quer dizer com AVN?" (multiple=2)

# game/scripts/c20/c20.rpy:2231
translate brazilian c20s004_Farewell_2f8db68f:

    # wil "Oh, sí, Señor. Agrum Vaccis Nostrum. Nuestro propio campo con vacas, para alimentar a mi familia."
    wil "Ah, sim, senhor. Agrum Vaccis Nostrum. Nosso próprio campo com vacas, para alimentar minha família."

# game/scripts/c20/c20.rpy:2232
translate brazilian c20s004_Farewell_11ebef1d:

    # mcd "Me habías asustado, creía que te referías a otra cosa..."
    mcd "Você me assustou, pensei que você quisesse dizer outra coisa..."

# game/scripts/c20/c20.rpy:2233
translate brazilian c20s004_Farewell_27c39f60:

    # dap "*En el mundo real* *Risa* Eso es porque tienes una mente traviesa."
    dap "*No mundo real* *Risos* Isso porque você tem uma mente travessa."

# game/scripts/c20/c20.rpy:2235
translate brazilian c20s004_Farewell_b64267a5:

    # thi "No queremos entretenerles más, o si no van a llegar cuando las puertas de Vindobona ya estén cerradas."
    thi "Não queremos retê-lo por mais tempo, senão você chegará quando as portas de Vindobona já estiverem fechadas."

# game/scripts/c20/c20.rpy:2236
translate brazilian c20s004_Farewell_8da3180b:

    # mcd "Gracias, Thiel. Si volvemos a hacer esta ruta pararemos a saludaros."
    mcd "Obrigado, Thiel. Se fizermos esse trajeto novamente, pararemos para cumprimentá-lo."

# game/scripts/c20/c20.rpy:2237
translate brazilian c20s004_Farewell_7e1b4108:

    # madd "Cuidaos, chicos."
    madd "Cuidem-se, pessoal."

# game/scripts/c20/c20.rpy:2238
translate brazilian c20s004_Farewell_93865483:

    # wil "Tengan cuidado ustedes en el camino. A veces... pasan cosas... y los viajeros desaparecen."
    wil "Tenha cuidado na estrada. Às vezes... coisas acontecem... e viajantes desaparecem."

# game/scripts/c20/c20.rpy:2240
translate brazilian c20s004_Farewell_e7e1a826:

    # dap "*En el mundo real* Cuando llegáis a los establos, veis que Paula, Aelia, Beagan y Pia están allí. Esta vez sin armaduras."
    dap "*No mundo real* Ao chegar aos estábulos, você vê que Paula, Aelia, Beagan e Pia estão lá. Desta vez sem suas armaduras."

# game/scripts/c20/c20.rpy:2242
translate brazilian c20s004_Farewell_247c5474:

    # centered "{size=+20}{b}DÍA 21 – LUNES{/b}{/size}"
    centered "{size=+20}{b}DIA 21 – SEGUNDA-FEIRA{/b}{/size}"

# game/scripts/c20/c20.rpy:2244
translate brazilian c20s004_Farewell_b7f824e7:

    # dapd "Creía que habíais decidido quedaros."
    dapd "Pensei que você tivesse decidido ficar."

# game/scripts/c20/c20.rpy:2246
translate brazilian c20s004_Farewell_3868638f:

    # erid "Si nosotras tuviéramos que ir a Vindobona, Pia nos hubiera hecho salir al amanecer."
    erid "Se tivéssemos que ir para Vindobona, Pia teria nos feito sair ao amanhecer."

# game/scripts/c20/c20.rpy:2248
translate brazilian c20s004_Farewell_8a2eb5dd:

    # scad "Y se hubiera pasado el camino quejándose de que no había dormido suficiente."
    scad "E ele teria passado a viagem inteira reclamando que não tinha dormido o suficiente."

# game/scripts/c20/c20.rpy:2250
translate brazilian c20s004_Farewell_2991cdd8:

    # emmd "No os metáis con Pia. Al menos nos evita tener que hacer todos los cálculos de las provisiones que necesitamos."
    emmd "Não se meta com a Pia. Pelo menos ela nos poupa de ter que fazer todos os cálculos dos suprimentos que precisamos."

# game/scripts/c20/c20.rpy:2252
translate brazilian c20s004_Farewell_ef93e412:

    # mad "Muchas gracias por las cervezas de anoche, chicas."
    mad "Muito obrigada pelas cervejas de ontem à noite, meninas."

# game/scripts/c20/c20.rpy:2253
translate brazilian c20s004_Farewell_24aa2dc7:

    # mcd "Y por lo de después... la cena... me refiero..."
    mcd "E sobre o que aconteceu depois... o jantar... quer dizer..."

# game/scripts/c20/c20.rpy:2255
translate brazilian c20s004_Farewell_5c3bfa02:

    # emmd "Hemos ensillado vuestros caballos..."
    emmd "Nós selamos seus cavalos..."

# game/scripts/c20/c20.rpy:2256
translate brazilian c20s004_Farewell_fca62baf:

    # erid "Y os hemos puesto un par de mantas extra, en caso de que encontréis una caravana que vaya más al norte de Vindobona. Hace frío allí."
    erid "E preparamos alguns cobertores extras para você, caso encontre uma caravana indo mais ao norte de Vindobona. Faz frio lá."

# game/scripts/c20/c20.rpy:2257
translate brazilian c20s004_Farewell_9555181e:

    # dapd "Si volvéis a pasar por Novum Templum, no os olvidéis de parar a saludar."
    dapd "Se por acaso você estiver passando por Novum Templum novamente, não se esqueça de parar e dizer olá."

# game/scripts/c20/c20.rpy:2258
translate brazilian c20s004_Farewell_91d0d3fe:

    # scad "Y a traernos noticias de lo que pasa en el resto del Imperio. Casi no nos enteramos de nada aquí."
    scad "E tragam-nos notícias do que está acontecendo no resto do Império. Quase não ficamos sabendo de nada por aqui."

# game/scripts/c20/c20.rpy:2262
translate brazilian c20s004_Farewell_5b196794:

    # mad "¿Queda mucho, [dap]? Mañana me tengo que levantar pronto para abrir la tienda."
    mad "Vai demorar muito mais, [dap]? Preciso acordar cedo amanhã para abrir a loja."

# game/scripts/c20/c20.rpy:2263
translate brazilian c20s004_Farewell_2c223719:

    # mad "No quiero estropear la partida, pero si va a durar mucho más, ¿podríamos dejarlo para otro día?"
    mad "Não quero estragar a surpresa, mas se for demorar muito mais, podemos deixar para outro dia?"

# game/scripts/c20/c20.rpy:2265
translate brazilian c20s004_Farewell_7e0c9c16:

    # dap "Solo quedan diez minutos a lo sumo. Vamos a acelerar un poco."
    dap "Só restam dez minutos, no máximo. Vamos acelerar um pouco as coisas."

# game/scripts/c20/c20.rpy:2266
translate brazilian c20s004_Farewell_04496536:

    # dap "Acabáis las despedidas y emprendéis camino. Es un día soleado. Parece que la amenaza de lluvia va desapareciendo tal como vais hacia el norte."
    dap "Você termina de se despedir e parte. É um dia ensolarado. A ameaça de chuva parece estar desaparecendo à medida que você segue para o norte."

# game/scripts/c20/c20.rpy:2269
translate brazilian c20s004_Farewell_03ac580c:

    # emm "Vaya, yo quería despedirme de Vilfredo como es debido."
    emm "Bem, eu queria me despedir de Vilfredo como deve ser."

# game/scripts/c20/c20.rpy:2271
translate brazilian c20s004_Farewell_6f17ff93:

    # eri "[emm], Maddie es la única aquí que tiene que madrugar. Tenemos que adaptar la partida a ella."
    eri "[emm], Maddie é a única aqui que precisa acordar cedo. Temos que adaptar o jogo para ela."

# game/scripts/c20/c20.rpy:2272
translate brazilian c20s004_Farewell_00b68d56:

    # eri "Y ni se te ocurra sentirte mal, Maddie. Lo hacemos encantadas."
    eri "E nem pense em se sentir mal, Maddie. Ficaremos felizes em fazer isso."

# game/scripts/c20/c20.rpy:2274
translate brazilian c20s004_Farewell_9780c57c:

    # mad "Gracias, [eri]."
    mad "Obrigado, [eri]."

# game/scripts/c20/c20.rpy:2276
translate brazilian c20s004_Farewell_7109b629:

    # dap "Bueno, vamos a acelerar un poco."
    dap "Ok, vamos acelerar um pouco as coisas."

# game/scripts/c20/c20.rpy:2277
translate brazilian c20s004_Farewell_d1e6de3e:

    # dap "Cuando lleváis un par de horas cabalgando oís un ruido. Tirad por Percepción."
    dap "Após cavalgar por algumas horas, você ouve um ruído. Role para Percepção."

# game/scripts/c20/c20.rpy:2279
translate brazilian c20s004_Farewell_b3015543:

    # mad "15. Con los bonos sumados, 18."
    mad "15. Com os bônus adicionados, 18."

# game/scripts/c20/c20.rpy:2280
translate brazilian c20s004_Farewell_2012bbd5:

    # mc "12... ¿qué bonos había que sumar?... Ah, sí, Sabiduría. No tengo bono. 12."
    mc "12... que bônus eu tive que adicionar?... Ah, sim, Sabedoria. Eu não tenho nenhum bônus. 12."

# game/scripts/c20/c20.rpy:2283
translate brazilian c20s004_Farewell_32adb331:

    # dap "*En el mundo real* Miráis al cielo, hacia el Norte, y veis un dragón, rojo infernal, volando hacia el Oeste."
    dap "*No mundo real* Você olha para o céu, em direção ao norte, e vê um dragão, vermelho infernal, voando para o oeste."

# game/scripts/c20/c20.rpy:2284
translate brazilian c20s004_Farewell_767472c8:

    # dap "*En el mundo real* Maddie, tu dirías que es un ejemplar muy viejo, y que llevaba algo en las garras, pero no puedes percibir qué es."
    dap "*No mundo real*, Maddie, você diria que é um espécime muito antigo e que carregava algo em suas garras, mas você não consegue perceber o quê."

# game/scripts/c20/c20.rpy:2285
translate brazilian c20s004_Farewell_52e72fa8:

    # dap "*En el mundo real* Además, ves al Noreste una pequeña columna de humo."
    dap "*No mundo real*, você também vê uma pequena coluna de fumaça a nordeste."

# game/scripts/c20/c20.rpy:2287
translate brazilian c20s004_Farewell_b69bc0a5:

    # madd "¿Has visto el dragón?"
    madd "Você viu o dragão?"

# game/scripts/c20/c20.rpy:2288
translate brazilian c20s004_Farewell_d8710b26:

    # mcd "Nunca había visto uno. Creo que será difícil olvidarlo..."
    mcd "Eu nunca tinha visto um antes. Acho que vai ser difícil esquecer..."

# game/scripts/c20/c20.rpy:2290
translate brazilian c20s004_Farewell_919b1d43:

    # madd "Hay humo allí. Deberíamos acercarnos."
    madd "Há fumaça ali. Devemos nos aproximar."

# game/scripts/c20/c20.rpy:2291
translate brazilian c20s004_Farewell_bfd38439:

    # mcd "Te sigo. A lo mejor alguien necesita ayuda."
    mcd "Estou te seguindo. Talvez alguém precise de ajuda."

# game/scripts/c20/c20.rpy:2293
translate brazilian c20s004_Farewell_3dc7746f:

    # madd "Por aquí. Este camino parece llevar hacia el humo."
    madd "Por aqui. Este caminho parece levar em direção à fumaça."

# game/scripts/c20/c20.rpy:2295
translate brazilian c20s004_Farewell_7007417b:

    # dap "*En el mundo real* Llegáis a un claro al lado del camino, donde alguien ha acampado para comer."
    dap "*No mundo real* Você chega a uma clareira à beira da estrada, onde alguém acampou para comer."

# game/scripts/c20/c20.rpy:2296
translate brazilian c20s004_Farewell_d3047ce0:

    # dap "*En el mundo real* No hay nadie, pero el fuego está encendido aún con carne en el espeto. Obiamente, la columna de humo salía de aquí."
    dap "*No mundo real* Não há ninguém aqui, mas o fogo ainda está aceso com carne no espeto. Obviamente, a coluna de fumaça vinha daqui."

# game/scripts/c20/c20.rpy:2297
translate brazilian c20s004_Farewell_9bec8cf5:

    # mad "*En el mundo real* Busco huellas. 8+3. 11. No creo que encuentre nada demasiado interesante."
    mad "*No mundo real*, estou procurando pegadas. 8+3. 11. Acho que não vou encontrar nada muito interessante."

# game/scripts/c20/c20.rpy:2298
translate brazilian c20s004_Farewell_8d374f57:

    # dap "*En el mundo real* Ves huellas que van en varias direcciones. El grupo más numeroso va al Norte."
    dap "*No mundo real*, você vê pegadas indo em várias direções. O maior grupo está indo para o norte."

# game/scripts/c20/c20.rpy:2300
translate brazilian c20s004_Farewell_24c78b59:

    # madd "El grupo que había acampado aquí se ha separado. Vamos a seguir las huellas que van al Norte."
    madd "O grupo que estava acampado aqui se dispersou. Vamos seguir as trilhas que levam para o norte."

# game/scripts/c20/c20.rpy:2301
translate brazilian c20s004_Farewell_550def09:

    # mcd "Como quieras. Tu te mueves por los bosques mejor que yo."
    mcd "Faça o que quiser. Você se move pela floresta melhor do que eu."

# game/scripts/c20/c20.rpy:2303
translate brazilian c20s004_Farewell_56891888:

    # dap "*En el mundo real* Llegáis a un claro en el que encontráis una escena dantesca. Hay un par de cadáveres quemados. Uno boca arriba y el otro boca abajo."
    dap "*No mundo real* Você chega a uma clareira onde se depara com uma cena horrível. Há dois cadáveres carbonizados. Um com o rosto para cima e o outro com o rosto para baixo."

# game/scripts/c20/c20.rpy:2304
translate brazilian c20s004_Farewell_b1bfdb6e:

    # dap "*En el mundo real* No parecen haber sido atacados aquí, sino un poco antes, donde habéis visto hierba quemada. Parece que han corrido hasta aquí antes de morir."
    dap "*No mundo real* Eles não parecem ter sido atacados aqui, mas um pouco antes, onde você viu a grama queimada. Parece que eles correram para cá antes de morrerem."

# game/scripts/c20/c20.rpy:2305
translate brazilian c20s004_Farewell_4a2eb8a8:

    # dap "*En el mundo real* Reconocéis la armadura que llevaban los alabarderos en uno de los cadáveres. No lleva la capa."
    dap "*No mundo real* Você reconhece a armadura usada pelos alabardeiros em um dos cadáveres. Ele não está usando a capa."

# game/scripts/c20/c20.rpy:2306
translate brazilian c20s004_Farewell_5820e84c:

    # mc "*En el mundo real* Le doy la vuelta al otro."
    mc "*No mundo real*, eu viro a outra."

# game/scripts/c20/c20.rpy:2308
translate brazilian c20s004_Farewell_a9dc35cc:

    # dap "*En el mundo real* Incluso antes de darle la vuelta, reconoces la armadura. Es la misma que llevaba Euricus, aunque le faltan algunas piezas."
    dap "*No mundo real* Mesmo antes de virá-la, você reconhece a armadura. É a mesma que Euricus usava, embora esteja faltando algumas peças."

# game/scripts/c20/c20.rpy:2309
translate brazilian c20s004_Farewell_48cc2da4:

    # dap "*En el mundo real* En el momento en que le das la vuelta, lo reconoces pese a que está bastante churruscado."
    dap "*No mundo real* No momento em que você o vira, você o reconhece, mesmo que esteja bastante queimado."

# game/scripts/c20/c20.rpy:2310
translate brazilian c20s004_Farewell_cd7b56ba:

    # mad "*En el mundo real* ¿Está el cadáver de Solomon por algún lado?"
    mad "*No mundo real*, o corpo de Salomão está em algum lugar?"

# game/scripts/c20/c20.rpy:2311
translate brazilian c20s004_Farewell_71b45c17:

    # dap "*En el mundo real* Tira por Inteligencia."
    dap "*No mundo real*, role os dados para obter inteligência."

# game/scripts/c20/c20.rpy:2312
translate brazilian c20s004_Farewell_172177b2:

    # mad "*En el mundo real* ¡Sí! 20 natural. Pero le resto 1. Fang no es muy inteligente."
    mad "*No mundo real* Sim! 20 natural. Mas eu subtraio 1. Fang não é muito inteligente."

# game/scripts/c20/c20.rpy:2313
translate brazilian c20s004_Farewell_169eaa96:

    # dap "*En el mundo real* Para nosotras, un 20 natural siempre es un éxito crítico. Así simplificamos las normas."
    dap "*No mundo real*, para nós, um 20 natural é sempre um sucesso crítico. É assim que simplificamos as regras."

# game/scripts/c20/c20.rpy:2315
translate brazilian c20s004_Farewell_6553f9a6:

    # dap "*En el mundo real* Recuerdas la cosa negra que llevaba el dragón entre las garras. Crees que podría ser Solomon."
    dap "*No mundo real* Você se lembra da coisa preta que o dragão carregava em suas garras. Você acha que pode ser Salomão."

# game/scripts/c20/c20.rpy:2316
translate brazilian c20s004_Farewell_051216b6:

    # mad "*En el mundo real* ¡Sí! !Acabar como el almuerzo de un dragón! ¡Ahí tienes tu criatura roja infernal chupadora de almas! ¡Jódete, cabrón! ¡Uy, perdón!"
    mad "*No mundo real* Sim! Para acabar como almoço de dragão! Aí está sua criatura vermelha infernal sugadora de almas! Vai se foder, seu desgraçado! Ops, desculpe!"

# game/scripts/c20/c20.rpy:2317
translate brazilian c20s004_Farewell_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c20/c20.rpy:2319
translate brazilian c20s004_Farewell_a1798ea5:

    # madd "Creo que deberíamos volver a Novum Templum, Vilfredo. Deberíamos avisarles de que hay un dragón en las inmediaciones."
    madd "Acho que devemos retornar a Novum Templum, Vilfredo. Devemos avisá-los de que há um dragão por perto."

# game/scripts/c20/c20.rpy:2320
translate brazilian c20s004_Farewell_6fa26c98:

    # mcd "Me parece que no deben saberlo, o nos lo hubieran dicho. ¡Volvamos!"
    mcd "Acho que eles não sabem, senão teriam nos contado. Vamos voltar!"

# game/scripts/c20/c20.rpy:2321
translate brazilian c20s004_Farewell_4a222b01:

    # madd "Vamos. Vindobona tendrá que esperar."
    madd "Vamos lá. Vindobona terá que esperar."

# game/scripts/c20/c20.rpy:2323
translate brazilian c20s004_Farewell_449382bd:

    # mcd "Fang, presiento que este es el comienzo de una hermosa amistad."
    mcd "Fang, tenho a sensação de que este é o começo de uma bela amizade."

# game/scripts/c20/c20.rpy:2327
translate brazilian c20s004_Farewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "E assim termina a sessão de hoje. Espero que tenham gostado."

# game/scripts/c20/c20.rpy:2353
translate brazilian c20s005_EndGameFarewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "E assim termina a sessão de hoje. Espero que tenham gostado."

# game/scripts/c20/c20.rpy:2356
translate brazilian c20s005_EndGameFarewell_1a297f42:

    # mad "Como introducción al mundo y al grupo ha sido fantástico."
    mad "Como introdução ao mundo e ao grupo, tem sido fantástico."

# game/scripts/c20/c20.rpy:2357
translate brazilian c20s005_EndGameFarewell_4ae9fcaa:

    # mad "No es la típica forma de introducir nuevos miembros en plan \"Os encontráis en una taberna y parecéis amigos de toda la vida\"."
    mad "Não é a maneira típica de apresentar novos membros, como \"Vocês se conhecem em uma taverna e parecem amigos para a vida toda\"."

# game/scripts/c20/c20.rpy:2360
translate brazilian c20s005_EndGameFarewell_5625d6c4:

    # sca "Es más un \"Os encontráis en el foro y os folláis al Semielfo\". *Risa*"
    sca "É mais ou menos assim: \"Você conhece a pessoa no fórum e dorme com a meio-elfa.\" *Risos*"

# game/scripts/c20/c20.rpy:2361
translate brazilian c20s005_EndGameFarewell_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c20/c20.rpy:2364
translate brazilian c20s005_EndGameFarewell_7b8058c9:

    # emm "*Risa* Había que darle razones para volver, ¿no?"
    emm "*Risos* Tínhamos que dar motivos para ele voltar, né?"

# game/scripts/c20/c20.rpy:2365
translate brazilian c20s005_EndGameFarewell_3eba9f66:

    # mc "*Risa* Creo que [dap] nos hubiera dado razones suficientes igualmente."
    mc "*Risos* Acho que [dap] já nos teria dado motivos suficientes de qualquer maneira."

# game/scripts/c20/c20.rpy:2367
translate brazilian c20s005_EndGameFarewell_c15b942d:

    # eri "Ahora hay que darle razones a [madd] para que se quede."
    eri "Agora precisamos dar [madd] motivos para ficar."

# game/scripts/c20/c20.rpy:2369
translate brazilian c20s005_EndGameFarewell_6e4fee88:

    # dap "Por eso habéis conocido a unos enemigos comunes. Además, Vilfredo y Fang volverán para dar la noticia del dragón."
    dap "Por isso você encontrou alguns inimigos em comum. Além disso, Vilfredo e Fang retornarão para trazer notícias sobre o dragão."

# game/scripts/c20/c20.rpy:2370
translate brazilian c20s005_EndGameFarewell_9c2b3da1:

    # dap "Suma a eso que ahora Fang tiene una razón para quedarse. Tiene un intérprete para hablar con Júpiter."
    dap "A isso se soma o fato de que Fang agora tem um motivo para ficar. Ele tem um intérprete para falar com Júpiter."

# game/scripts/c20/c20.rpy:2373
translate brazilian c20s005_EndGameFarewell_f359061e:

    # mad "Y visto lo que pasó anoche, quizás se plantee probar a Vilfredo. Aunque también podría haberlo hecho en Vindobona."
    mad "E, considerando o que aconteceu ontem à noite, talvez eles deem uma chance ao Vilfredo. Embora também pudessem ter feito isso no Vindobona."

# game/scripts/c20/c20.rpy:2376
translate brazilian c20s005_EndGameFarewell_f8a96c09:

    # mad "*Risa* Es la única idiota que se fue a dormir y se quedó sin diversión."
    mad "*Risos* Ela é a única idiota que foi dormir e perdeu a diversão."

# game/scripts/c20/c20.rpy:2378
translate brazilian c20s005_EndGameFarewell_849e73e9:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas."
    bet "Achei muito interessante descobrir essas facetas das minhas quatro sobrinhas."

# game/scripts/c20/c20.rpy:2381
translate brazilian c20s005_EndGameFarewell_4b8e0ca6:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas, aunque [mc] las rechazara."
    bet "Achei muito interessante descobrir essas facetas das minhas quatro sobrinhas, mesmo que eu as tenha rejeitado."

# game/scripts/c20/c20.rpy:2383
translate brazilian c20s005_EndGameFarewell_240e4faf:

    # dap "¿Por qué no te unes, Tía Betty? Siempre hay espacio para más Clérigos en el grupo. Los hechizos de curación de Pia no son eternos y ahora somos más."
    dap "Por que você não se junta a nós, tia Betty? Sempre há espaço para mais clérigos no grupo. Os feitiços de cura da Pia não duram para sempre, e agora somos mais."

# game/scripts/c20/c20.rpy:2385
translate brazilian c20s005_EndGameFarewell_7fccd2cc:

    # bet "*Risa* ¿Me estás diciendo que me una al grupo y me haga una monja curandera en vez de follarme al Semielfo?"
    bet "*Risos* Você está me dizendo para entrar no grupo e me tornar uma freira curandeira em vez de dormir com o meio-elfo?"

# game/scripts/c20/c20.rpy:2386
translate brazilian c20s005_EndGameFarewell_c501fb12:

    # bet "¿Tú te das cuenta de la ironía de eso? *Risa* Me he pasado casi toda mi vida siendo precisamente una monja curandera."
    bet "Você percebe a ironia disso? *Risos* Passei quase toda a minha vida sendo exatamente uma freira curandeira."

# game/scripts/c20/c20.rpy:2388
translate brazilian c20s005_EndGameFarewell_2ac73579:

    # sca "*Risa* Creo que [dap] no lo había pensado. Si quieres puedes jugar con un guerrero o un mago..."
    sca "*Risos* Acho que [dap] não tinha pensado nisso. Se quiser, você pode jogar como guerreiro ou mago..."

# game/scripts/c20/c20.rpy:2389
translate brazilian c20s005_EndGameFarewell_1a93d918:

    # sca "Aunque te hagas una monja, te puedes follar a [mc] igualmente. *Risa*"
    sca "Mesmo se você virar freira, ainda pode transar com [mc]. *Risos*"

# game/scripts/c20/c20.rpy:2391
translate brazilian c20s005_EndGameFarewell_1525074d:

    # sca "Sólo tienes que ver a [dap], la Semielfa putilla. *Risa*"
    sca "Basta olhar para [dap], a pequena vadia meio-elfa. *Risos*"

# game/scripts/c20/c20.rpy:2393
translate brazilian c20s005_EndGameFarewell_01267f8c:

    # bet "Me ha parecido que os lo pasabais muy bien. Podría ser divertido unirme, ahora que parece que no voy a volver a Florida."
    bet "Parecia que vocês estavam se divertindo muito. Talvez seja legal participar também, já que parece que não vou voltar para a Flórida."

# game/scripts/c20/c20.rpy:2395
translate brazilian c20s005_EndGameFarewell_d500f517:

    # bet "Pero dejadme pensarlo unos días..."
    bet "Mas deixe-me pensar nisso por alguns dias..."

# game/scripts/c20/c20.rpy:2396
translate brazilian c20s005_EndGameFarewell_aac421b9:

    # mcp "(Al menos hasta la visita a Monterey, ¿no?)"
    mcp "(Pelo menos até a visita a Monterey, certo?)"

# game/scripts/c20/c20.rpy:2398
translate brazilian c20s005_EndGameFarewell_491b2c1b:

    # emm "No es que te quiera echar, Mads, pero ¿tú no tenías que madrugar?"
    emm "Não quero te expulsar, Mads, mas você não deveria ter acordado cedo?"

# game/scripts/c20/c20.rpy:2400
translate brazilian c20s005_EndGameFarewell_eb79b050:

    # mad "Sí, pero una de las cosas más divertidas de las partidas es comentarlas luego... Estoy dispuesta a sacrificar una hora de sueño."
    mad "Sim, mas uma das coisas mais divertidas nos jogos é discuti-los depois... Estou disposto a sacrificar uma hora de sono."

# game/scripts/c20/c20.rpy:2402
translate brazilian c20s005_EndGameFarewell_6649c9db:

    # eri "No es necesario, Maddie. Mañana iremos todas a la tienda y comentaremos la partida si quieres. Así puedes dormir tranquilamente hoy."
    eri "Não precisa, Maddie. Amanhã vamos todos à loja e conversamos sobre o jogo, se você quiser. Assim você pode dormir em paz esta noite."

# game/scripts/c20/c20.rpy:2404
translate brazilian c20s005_EndGameFarewell_8c0b47f6:

    # sca "Prometemos no comentar nada antes de ir, para que no te pierdas nada de la conversación."
    sca "Prometemos não dizer nada antes de irmos, para que você não perca nada da conversa."

# game/scripts/c20/c20.rpy:2406
translate brazilian c20s005_EndGameFarewell_56648120:

    # mad "Chicas, os lo agradezco. Ha sido un día largo y empiezo a estar cansada."
    mad "Meninas, muito obrigada. Foi um dia longo e estou começando a ficar cansada."

# game/scripts/c20/c20.rpy:2409
translate brazilian c20s005_EndGameFarewell_9abc610e:

    # mad "Casi tanto como Vilfredo. *Risa*"
    mad "Quase tanto quanto Vilfredo. *Risos*"

# game/scripts/c20/c20.rpy:2410
translate brazilian c20s005_EndGameFarewell_f7fd3149:

    # mc "¡Hey! El Semielfo ya ha recargado las baterías. Está listo para más rounds. *Risa*"
    mc "Ei! O meio-elfo recarregou as baterias. Ele está pronto para mais rodadas. *Risos*"

# game/scripts/c20/c20.rpy:2412
translate brazilian c20s005_EndGameFarewell_5d2e6c01:

    # dap "Entonces quedamos así. Mañana en la tienda. No te queremos entretener más y sentirnos culpables si te quedas dormida en un probador. *Risa*"
    dap "Então, está combinado. Amanhã na loja. Não queremos te prender por mais tempo e nos sentiríamos culpados se você dormisse no provador. *Risos*"

# game/scripts/c20/c20.rpy:2413
translate brazilian c20s005_EndGameFarewell_b3b94564_1:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c20/c20.rpy:2415
translate brazilian c20s005_EndGameFarewell_f5dbebe2:

    # mad "Gracias, chicas."
    mad "Obrigada, meninas."

# game/scripts/c20/c20.rpy:2416
translate brazilian c20s005_EndGameFarewell_6598ab25:

    # mc "Te llevo. ¿Tienes que coger alguna cosa?"
    mc "Eu te dou uma carona. Precisa pegar alguma coisa?"

# game/scripts/c20/c20.rpy:2418
translate brazilian c20s005_EndGameFarewell_9002c104:

    # mad "Tengo la mochila en la habitación de [eri]. Ahora bajo con ella. Las cajas de los cuadros ya están en la camioneta."
    mad "Minha mochila está no quarto de [eri]. Vou descer com ela agora. As caixas de pinturas já estão na van."

# game/scripts/c20/c20.rpy:2419
translate brazilian c20s005_EndGameFarewell_e5a907d7:

    # mc "Perfecto entonces. Voy al lavabo y te veo en el garaje."
    mc "Perfeito então. Vou ao banheiro e te vejo na garagem."

# game/scripts/c20/c20.rpy:2420
translate brazilian c20s005_EndGameFarewell_df5c0f2c:

    # eri "Te acompaño, Maddie."
    eri "Eu vou com você, Maddie."

# game/scripts/c20/c20.rpy:2423
translate brazilian c20s005_EndGameFarewell_ae82c249:

    # "Te despides de las chicas y de Tía Betty y vas al lavabo."
    "Você se despede das meninas e da tia Betty e vai ao banheiro."

# game/scripts/c20/c20.rpy:2437
translate brazilian c20s005_Kia_e56161b3:

    # "Al salir del lavabo, te encuentras con Kiara en el pasillo."
    "Ao sair do banheiro, você dá de cara com Kiara no corredor."

# game/scripts/c20/c20.rpy:2438
translate brazilian c20s005_Kia_15498345:

    # mc "¡Hola, Kiara! Perdón si te he despertado."
    mc "Oi Kiara! Desculpe se te acordei."

# game/scripts/c20/c20.rpy:2444
translate brazilian c20s005_Kia_c2279c91:

    # kia "No te preocupes. No podía dormir y te he escuchado subir las escaleras. He venido a ver si tenías un momento para hablar."
    kia "Não se preocupe. Eu não conseguia dormir e ouvi você subindo as escadas. Vim ver se você tinha um momento para conversar."

# game/scripts/c20/c20.rpy:2445
translate brazilian c20s005_Kia_b8414fd1:

    # mc "Ahora no es buen momento, Kiara. Tengo que llevar a Maddie a casa."
    mc "Agora não é uma boa hora, Kiara. Eu preciso levar a Maddie para casa."

# game/scripts/c20/c20.rpy:2448
translate brazilian c20s005_Kia_a4065204:

    # kia "¿Vas a volver a casa o te vas a quedar a dormir?"
    kia "Você vai voltar para casa ou vai passar a noite aqui?"

# game/scripts/c20/c20.rpy:2450
translate brazilian c20s005_Kia_7716d653:

    # kia "No te estoy fiscalizando... Es que me gustaría hablar contigo..."
    kia "Não estou te analisando... Eu só gostaria de conversar com você..."

# game/scripts/c20/c20.rpy:2453
translate brazilian c20s005_Kia_5a1fc550:

    # kia "¿Vas a tardar mucho? Me gustaría hablar contigo..."
    kia "Vai demorar? Gostaria de conversar com você..."

# game/scripts/c20/c20.rpy:2454
translate brazilian c20s005_Kia_a4795cec:

    # mc "La llevo a casa y vuelvo en seguida. ¿Quieres que hablemos cuando vuelva?"
    mc "Vou levá-la para casa e já volto. Quer conversar quando eu voltar?"

# game/scripts/c20/c20.rpy:2456
translate brazilian c20s005_Kia_4e0d1f0f:

    # kia "Me parece fantástico. Te veo en un rato, entonces."
    kia "Isso parece fantástico. Te vejo daqui a pouco, então."

# game/scripts/c20/c20.rpy:2457
translate brazilian c20s005_Kia_e4695014:

    # mc "¿No vas a darme un beso antes de irme?"
    mc "Você não vai me dar um beijo antes de eu ir embora?"

# game/scripts/c20/c20.rpy:2459
translate brazilian c20s005_Kia_d4e8547d:

    # kia "Creía que era solamente en los buenos días y buenas noches..."
    kia "Pensei que fosse apenas para bom dia e boa noite..."

# game/scripts/c20/c20.rpy:2460
translate brazilian c20s005_Kia_15557826:

    # mc "Así era antes de que tú y yo estuviéramos juntos."
    mc "Era assim antes de você e eu estarmos juntos."

# game/scripts/c20/c20.rpy:2461
translate brazilian c20s005_Kia_8da7fb88:

    # mc "Porque estamos juntos, ¿verdad?"
    mc "Porque estamos juntos, certo?"

# game/scripts/c20/c20.rpy:2463
translate brazilian c20s005_Kia_d82d5c59:

    # kia "De eso es de lo que quiero hablar contigo... Pero mejor luego, cuando vuelvas."
    kia "É sobre isso que eu quero conversar com você... Mas é melhor fazer isso mais tarde, quando você voltar."

# game/scripts/c20/c20.rpy:2464
translate brazilian c20s005_Kia_8a4b213f:

    # mc "Como desees."
    mc "Como desejar."

# game/scripts/c20/c20.rpy:2466
translate brazilian c20s005_Kia_96c2af65:

    # kia "Hasta dentro de un rato, [mc]."
    kia "Até daqui a pouco, [mc]."

# game/scripts/c20/c20.rpy:2468
translate brazilian c20s005_Kia_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Adeus, Kiara."

# game/scripts/c20/c20.rpy:2529
translate brazilian c20s005_GivingMaddieARide_36ef4791:

    # "Unos minutos después, después de haber sacado la camioneta del garaje..."
    "Poucos minutos depois, após tirar o caminhão da garagem..."

# game/scripts/c20/c20.rpy:2530
translate brazilian c20s005_GivingMaddieARide_16efac19:

    # mad "Ya nos podemos ir. Ya me he despedido de las chicas y de Betty."
    mad "Podemos ir agora. Já me despedi das meninas e da Betty."

# game/scripts/c20/c20.rpy:2531
translate brazilian c20s005_GivingMaddieARide_bbc35977:

    # mc "Cuando quieras podemos irnos, entonces."
    mc "Podemos ir embora quando você quiser."

# game/scripts/c20/c20.rpy:2533
translate brazilian c20s005_GivingMaddieARide_da70b486:

    # "Al llegar al edificio de Maddie le ayudas a subir las cajas de los cuadros y te despides de ella."
    "Ao chegar ao prédio da Maddie, você a ajuda a levar as caixas de pinturas para o andar de cima e se despede dela."

# game/scripts/c20/c20.rpy:2534
translate brazilian c20s005_GivingMaddieARide_a678922f:

    # mad "Muchas gracias por todo, [mc]. Ha sido un día fantástico."
    mad "Muito obrigado por tudo, [mc]. Foi um dia fantástico."

# game/scripts/c20/c20.rpy:2535
translate brazilian c20s005_GivingMaddieARide_d8cf74d5:

    # mc "Bienvenida a la familia. Bienvenida a los Locos Marks. *Risa* Espero que, a partir de ahora vengas a casa más a menudo."
    mc "Bem-vindo(a) à família. Bem-vindo(a) à família dos Crazy Marks. *Risos* Espero que você venha nos visitar mais vezes daqui para frente."

# game/scripts/c20/c20.rpy:2538
translate brazilian c20s005_GivingMaddieARide_c14779c4:

    # mad "Lo haré, no lo dudes. Ahora, si no te importa, debería irme a dormir."
    mad "Sim, não se preocupe. Agora, se não se importa, eu deveria ir dormir."

# game/scripts/c20/c20.rpy:2539
translate brazilian c20s005_GivingMaddieARide_eba3cfdd:

    # mc "Ningún problema. ¿Zeus está durmiendo? Me gustaría conocerlo."
    mc "Sem problema. Zeus está dormindo? Gostaria de conhecê-lo."

# game/scripts/c20/c20.rpy:2545
translate brazilian c20s005_GivingMaddieARide_eb2c2306:

    # "Parece que el gato ha oído su nombre y aparece para saludar."
    "Parece que o gato ouviu o nome dele e está dizendo olá."

# game/scripts/c20/c20.rpy:2546
translate brazilian c20s005_GivingMaddieARide_fabc3ed0:

    # zeu "*Ronroneo* (¿Quién eres tú? ¿Vienes a acariciarme? ¡Bien hecho, humano!)"
    zeu "*Ronronar* (Quem é você? Veio me fazer carinho? Muito bem, humano!)"

# game/scripts/c20/c20.rpy:2547
translate brazilian c20s005_GivingMaddieARide_7228dac7:

    # mc "*Risa* Parece que me ha oído."
    mc "*Risos* Parece que ele me ouviu."

# game/scripts/c20/c20.rpy:2548
translate brazilian c20s005_GivingMaddieARide_ade7fb2e:

    # mad "*Risa* En cuanto oye su nombre aparece como salido de la nada. Si son mis amigas se vuelve a esconder."
    mad "*Risos* Assim que ouve o próprio nome, aparece do nada. Se forem meus amigos, ela se esconde de novo."

# game/scripts/c20/c20.rpy:2549
translate brazilian c20s005_GivingMaddieARide_f5e03bef:

    # mad "Parece que contigo tiene curiosidad."
    mad "Parece que ele está curioso a seu respeito."

# game/scripts/c20/c20.rpy:2551
translate brazilian c20s005_GivingMaddieARide_4e4279df:

    # zeu "*Ronroneo* (Sus amigas son idiotas y se ríen como gallinas. Eres un humano que acaricia bien, me gustas.)"
    zeu "*Ronronar* (Os amigos dela são idiotas e riem como galinhas. Você é uma pessoa que sabe fazer carinho, eu gosto de você.)"

# game/scripts/c20/c20.rpy:2552
translate brazilian c20s005_GivingMaddieARide_65826775:

    # mc "Encantado de conocerte por fin, Zeus. He visto unos cuadros fantásticos tuyos."
    mc "Que prazer finalmente te conhecer, Zeus. Já vi algumas pinturas suas fantásticas."

# game/scripts/c20/c20.rpy:2553
translate brazilian c20s005_GivingMaddieARide_da4f0765:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronar* (Sou muito versátil. Gótica e cientista ao mesmo tempo. Não vamos falar do vestido rosa. Isso nunca aconteceu. Preciso conversar com minha psicóloga.)"

# game/scripts/c20/c20.rpy:2555
translate brazilian c20s005_GivingMaddieARide_b2b41e5c:

    # mc "Bueno, Maddie, te dejo ir a acostarte. A ver si mañana puedo pasarme por la tienda con las chicas para comentar la partida."
    mc "Tudo bem, Maddie, vou deixar você ir dormir. Amanhã tentarei passar na loja com as meninas para conversarmos sobre o jogo."

# game/scripts/c20/c20.rpy:2556
translate brazilian c20s005_GivingMaddieARide_7f43c3b1:

    # mad "OK. Hasta mañana, [mc]."
    mad "OK. Até amanhã, [mc]."

# game/scripts/c20/c20.rpy:2559
translate brazilian c20s005_GivingMaddieARide_a6cf6482:

    # "Te subes a la camioneta y emprendes el camino a casa."
    "Você entra no caminhão e começa a viagem para casa."

# game/scripts/c20/c20.rpy:2562
translate brazilian c20s005_GivingMaddieARide_78d12f4c:

    # mad "Lo haré. No puedo dejar a Vilfredo solo en el bosque, habiendo un dragón rondando por ahí. *Risa*"
    mad "Eu farei isso. Não posso deixar Vilfredo sozinho na floresta com um dragão à solta. *Risos*"

# game/scripts/c20/c20.rpy:2563
translate brazilian c20s005_GivingMaddieARide_f166ab00:

    # mc "No me refiero solo a las partidas de DnD. Me refiero a las actividades familiares."
    mc "Não estou falando apenas de jogos de D&D. Estou falando de atividades em família."

# game/scripts/c20/c20.rpy:2564
translate brazilian c20s005_GivingMaddieARide_4dd3c1b8:

    # mc "Le has caído genial a todo el mundo que no te conocía, y ya les gustabas a las que te conocían."
    mc "Todos que não te conheciam se encantavam por você, e aqueles que te conheciam já gostavam muito de você."

# game/scripts/c20/c20.rpy:2567
translate brazilian c20s005_GivingMaddieARide_8baf9429:

    # mad "Sobre eso..."
    mad "Sobre isso..."

# game/scripts/c20/c20.rpy:2568
translate brazilian c20s005_GivingMaddieARide_4f14a2cb:

    # mc "¿Qué pasa Maddie?"
    mc "O que houve, Maddie?"

# game/scripts/c20/c20.rpy:2571
translate brazilian c20s005_GivingMaddieARide_d6037b75:

    # mad "Me mentiste..."
    mad "Você mentiu para mim..."

# game/scripts/c20/c20.rpy:2572
translate brazilian c20s005_GivingMaddieARide_e73f25b2:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "De que forma? Não entendo. Nunca menti para você."

# game/scripts/c20/c20.rpy:2574
translate brazilian c20s005_GivingMaddieARide_75ada0a2:

    # mad "Estás saliendo con [mar]..."
    mad "Você está namorando [mar]..."

# game/scripts/c20/c20.rpy:2576
translate brazilian c20s005_GivingMaddieARide_fbe6db5e:

    # mad "Incluso está embarazada..."
    mad "Ela está até grávida..."

# game/scripts/c20/c20.rpy:2577
translate brazilian c20s005_GivingMaddieARide_e3bab36f:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Eu nunca te disse que não ia fazer isso..."

# game/scripts/c20/c20.rpy:2579
translate brazilian c20s005_GivingMaddieARide_84ecc7e4:

    # mad "Pero aceptaste mi chantaje."
    mad "Mas você aceitou minha chantagem."

# game/scripts/c20/c20.rpy:2580
translate brazilian c20s005_GivingMaddieARide_6da9e9f8:

    # mc "Porque quería ver dónde iba. Quería probar como era sentirse dominado."
    mc "Porque ele queria ver aonde isso o levaria. Ele queria experimentar a sensação de ser dominado."

# game/scripts/c20/c20.rpy:2582
translate brazilian c20s005_GivingMaddieARide_027922b0:

    # mad "Me estás diciendo que nunca tuve poder sobre ti, ¿no?"
    mad "Você está me dizendo que eu nunca tive nenhum poder sobre você, não é?"

# game/scripts/c20/c20.rpy:2583
translate brazilian c20s005_GivingMaddieARide_32b8280f:

    # mc "No es eso. Tenías poder sobre mí porque yo te lo dejaba tener. No porque el secreto que guardabas fuera a hacerme daño si lo revelabas."
    mc "Não é isso. Você tinha poder sobre mim porque eu permiti. Não porque o segredo que você guardava me machucaria se você o revelasse."

# game/scripts/c20/c20.rpy:2584
translate brazilian c20s005_GivingMaddieARide_ed69ab30:

    # mc "Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Ela certamente ficaria lisonjeada se você fizesse isso."

# game/scripts/c20/c20.rpy:2586
translate brazilian c20s005_GivingMaddieARide_1b34f9ba:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Fico feliz que você tenha feito isso. Embora eu tenha me sentido um pouco idiota quando descobri a verdade."

# game/scripts/c20/c20.rpy:2587
translate brazilian c20s005_GivingMaddieARide_d5002491:

    # mad "Y eso me lleva a otra pregunta..."
    mad "E isso me leva a outra pergunta..."

# game/scripts/c20/c20.rpy:2588
translate brazilian c20s005_GivingMaddieARide_185a3c0f:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Diga-me, Maddie. Você sabe que pode conversar comigo sobre qualquer coisa."

# game/scripts/c20/c20.rpy:2590
translate brazilian c20s005_GivingMaddieARide_17c8bf13:

    # mad "¿Quiere decir eso que estabas conmigo porque querías? ¿No porque yo te obligara?"
    mad "Isso significa que você estava comigo porque queria? E não porque eu a forcei?"

# game/scripts/c20/c20.rpy:2591
translate brazilian c20s005_GivingMaddieARide_20004a1b:

    # mc "Sí. Estaba contigo porque quería. No podías obligarme, Maddie. El secreto no tenía ningún poder sobre mí."
    mc "Sim. Eu estava com você porque eu queria. Você não podia me forçar, Maddie. O segredo não tinha poder sobre mim."

# game/scripts/c20/c20.rpy:2593
translate brazilian c20s005_GivingMaddieARide_c524525a:

    # mad "Entonces te libero. No quiero estar contigo así."
    mad "Então eu te liberto. Não quero ficar com você assim."

# game/scripts/c20/c20.rpy:2596
translate brazilian c20s005_GivingMaddieARide_d6037b75_1:

    # mad "Me mentiste..."
    mad "Você mentiu para mim..."

# game/scripts/c20/c20.rpy:2597
translate brazilian c20s005_GivingMaddieARide_e73f25b2_1:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "De que forma? Não entendo. Nunca menti para você."

# game/scripts/c20/c20.rpy:2599
translate brazilian c20s005_GivingMaddieARide_75ada0a2_1:

    # mad "Estás saliendo con [mar]..."
    mad "Você está namorando [mar]..."

# game/scripts/c20/c20.rpy:2601
translate brazilian c20s005_GivingMaddieARide_fbe6db5e_1:

    # mad "Incluso está embarazada..."
    mad "Ela está até grávida..."

# game/scripts/c20/c20.rpy:2602
translate brazilian c20s005_GivingMaddieARide_e3bab36f_1:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Eu nunca te disse que não ia fazer isso..."

# game/scripts/c20/c20.rpy:2604
translate brazilian c20s005_GivingMaddieARide_6dd08023:

    # mad "Pero mi intento de chantaje..."
    mad "Mas minha tentativa de chantagem..."

# game/scripts/c20/c20.rpy:2605
translate brazilian c20s005_GivingMaddieARide_753a680c:

    # mc "Tú intentaste chantajearme antes de que estuviéramos juntos. Nada cambia."
    mc "Você tentou me chantagear antes mesmo de estarmos juntos. Nada muda."

# game/scripts/c20/c20.rpy:2607
translate brazilian c20s005_GivingMaddieARide_f837d6fe:

    # mad "Me estás diciendo que, aunque hubiera salido bien nunca hubiera tenido poder sobre ti, ¿no?"
    mad "Você está me dizendo que, mesmo se as coisas tivessem corrido bem, eu nunca teria tido nenhum poder sobre você, certo?"

# game/scripts/c20/c20.rpy:2608
translate brazilian c20s005_GivingMaddieARide_e2e209c3:

    # mc "Más o menos. A menos que yo te lo hubiera dejado tener. Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Mais ou menos. A menos que eu tivesse deixado você ficar com ele. Tenho certeza de que [mar] ficaria lisonjeado se você o fizesse."

# game/scripts/c20/c20.rpy:2609
translate brazilian c20s005_GivingMaddieARide_5519561f:

    # mc "Pero le dimos la vuelta y ahora soy yo el que tiene poder sobre ti, ¿no?"
    mc "Mas nós demos a volta por cima e agora sou eu quem tem poder sobre você, certo?"

# game/scripts/c20/c20.rpy:2611
translate brazilian c20s005_GivingMaddieARide_1b34f9ba_1:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Fico feliz que você tenha feito isso. Embora eu tenha me sentido um pouco idiota quando descobri a verdade."

# game/scripts/c20/c20.rpy:2612
translate brazilian c20s005_GivingMaddieARide_d5002491_1:

    # mad "Y eso me lleva a otra pregunta..."
    mad "E isso me leva a outra pergunta..."

# game/scripts/c20/c20.rpy:2613
translate brazilian c20s005_GivingMaddieARide_185a3c0f_1:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Diga-me, Maddie. Você sabe que pode conversar comigo sobre qualquer coisa."

# game/scripts/c20/c20.rpy:2615
translate brazilian c20s005_GivingMaddieARide_d3d03417:

    # mad "¿Quiere decir eso que estás conmigo sólo porque tienes poder sobre mí?"
    mad "Isso significa que você está comigo apenas porque tem poder sobre mim?"

# game/scripts/c20/c20.rpy:2616
translate brazilian c20s005_GivingMaddieARide_48639672:

    # mc "No. Estoy contigo porque quiero estarlo. No esperaba estarlo en estas circunstancias, pero me gusta estar contigo."
    mc "Não. Estou com você porque quero estar. Não esperava estar nessas circunstâncias, mas gosto de estar com você."

# game/scripts/c20/c20.rpy:2618
translate brazilian c20s005_GivingMaddieARide_38efc1b3:

    # mad "Entonces, si quieres, puedes denunciarme a mi jefe."
    mad "Então, se quiser, pode me denunciar ao meu chefe."

# game/scripts/c20/c20.rpy:2619
translate brazilian c20s005_GivingMaddieARide_65b1fd2a:

    # mad "No quiero estar contigo así."
    mad "Eu não quero ficar com você assim."

# game/scripts/c20/c20.rpy:2621
translate brazilian c20s005_GivingMaddieARide_c05ecd45:

    # mc "{b}¿Qué?{/b} ¿Estás rompiendo conmigo?"
    mc "{b}O quê?{/b} Você está terminando comigo?"

# game/scripts/c20/c20.rpy:2623
translate brazilian c20s005_GivingMaddieARide_e25417f1:

    # mad "Sí. Espérame aquí un momento. Ahora vuelvo."
    mad "Sim. Aguarde um momento. Já volto."

# game/scripts/c20/c20.rpy:2624
translate brazilian c20s005_GivingMaddieARide_704e54a3:

    # mc "¿Me he perdido algo? No te entiendo."
    mc "Perdi alguma coisa? Não te entendi."

# game/scripts/c20/c20.rpy:2626
translate brazilian c20s005_GivingMaddieARide_db54acf2:

    # zeu "¡Miau! (¿Qué le has hecho ahora? ¡Me caías bien!)"
    zeu "Miau! (O que você fez com ele agora? Eu gostava de você!)"

# game/scripts/c20/c20.rpy:2627
translate brazilian c20s005_GivingMaddieARide_1dee14f4:

    # mc "Hola, pequeñín. ¿Sabes que le ha pasado a Maddie? ¿Me has echado de menos?"
    mc "Oi, meu bem. Você sabe o que aconteceu com a Maddie? Sentiu minha falta?"

# game/scripts/c20/c20.rpy:2628
translate brazilian c20s005_GivingMaddieARide_c3aae098:

    # zeu "¡Miau! (No tengo ni idea de qué le has hecho. Y sobre echarte de menos, depende. ¿Me has traído atún para una cena tardía?)"
    zeu "Miau! (Não faço ideia do que você fez com ele. E quanto a sentir sua falta, depende. Você me trouxe atum para um jantar tardio?)"

# game/scripts/c20/c20.rpy:2630
translate brazilian c20s005_GivingMaddieARide_9ee1b869:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Ronronar* (Ok, eu te perdoo... Mas não deixe isso acontecer de novo.)"

# game/scripts/c20/c20.rpy:2631
translate brazilian c20s005_GivingMaddieARide_f20a31cc:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Eu também senti sua falta. Suas pinturas fizeram muito sucesso."

# game/scripts/c20/c20.rpy:2632
translate brazilian c20s005_GivingMaddieARide_da4f0765_1:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronar* (Sou muito versátil. Gótica e cientista ao mesmo tempo. Não vamos falar do vestido rosa. Isso nunca aconteceu. Preciso conversar com minha psicóloga.)"

# game/scripts/c20/c20.rpy:2634
translate brazilian c20s005_GivingMaddieARide_5708e270:

    # mad "Hola, [mc]. ¿Puedo ayudarte en algo?"
    mad "Olá, [mc]. Posso te ajudar em alguma coisa?"

# game/scripts/c20/c20.rpy:2635
translate brazilian c20s005_GivingMaddieARide_60c7fe73:

    # mc "Hola de nuevo, Maddie. ¿Esas gafas?"
    mc "Olá de novo, Maddie. Esses óculos?"

# game/scripts/c20/c20.rpy:2637
translate brazilian c20s005_GivingMaddieARide_9bc8c161:

    # mad "Creo que te equivocas. Maddie vive aquí, pero no lleva gafas. Yo soy Madison... No... Claire... Kent."
    mad "Acho que você está enganado. A Maddie mora aqui, mas ela não usa óculos. Eu sou Madison... Não... Claire... Kent."

# game/scripts/c20/c20.rpy:2638
translate brazilian c20s005_GivingMaddieARide_9c84e9bf:

    # mcp "(OK. Sigamos el juego. Solo te falta una cabina de teléfono para cambiarte de vestimenta.)"
    mcp "(OK. Vamos entrar na brincadeira. Tudo o que você precisa agora é de uma cabine telefônica para trocar de roupa.)"

# game/scripts/c20/c20.rpy:2639
translate brazilian c20s005_GivingMaddieARide_2890b878:

    # mc "Perdón por la confusión. Mi amiga me ha dicho algo que no entiendo y se ha ido."
    mc "Desculpe pela confusão. Meu amigo disse algo que eu não entendi e depois foi embora."

# game/scripts/c20/c20.rpy:2641
translate brazilian c20s005_GivingMaddieARide_59b0dbd7:

    # mad "Sí, ha roto contigo. No quiere seguir teniendo la relación que ha tenido hasta ahora."
    mad "Sim, ela terminou com você. Ela não quer continuar o relacionamento que vocês tinham até agora."

# game/scripts/c20/c20.rpy:2642
translate brazilian c20s005_GivingMaddieARide_b67fb6f4:

    # mad "Es una lástima... hacíais tan buena pareja..."
    mad "É uma pena... vocês formavam um casal tão bonito..."

# game/scripts/c20/c20.rpy:2643
translate brazilian c20s005_GivingMaddieARide_6b6a3698:

    # mc "Pero no lo entiendo..."
    mc "Mas eu não entendo..."

# game/scripts/c20/c20.rpy:2645
translate brazilian c20s005_GivingMaddieARide_adff9d34:

    # mad "Es muy fácil de entender. Después de ver lo que puede ser tener una relación completa... romántica... contigo. No quiere tener un sucedáneo."
    mad "É muito fácil de entender. Depois de ver como pode ser um relacionamento romântico completo com você, ela não quer um substituto."

# game/scripts/c20/c20.rpy:2647
translate brazilian c20s005_GivingMaddieARide_60be8291:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su trabajo a perder la oportunidad de tener algo más sincero contigo."
    mad "Ela diz que foi divertido, mas não é para ela. Ela prefere perder o emprego a perder a chance de ter algo mais genuíno com você."

# game/scripts/c20/c20.rpy:2649
translate brazilian c20s005_GivingMaddieARide_7a79c608:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su poder, si es que lo tenía, a perder la oportunidad de tener algo más sincero contigo."
    mad "Ela diz que foi divertido, mas não é a praia dela. Ela prefere perder o poder, se é que algum dia teve algum, a perder a chance de ter algo mais genuíno com você."

# game/scripts/c20/c20.rpy:2650
translate brazilian c20s005_GivingMaddieARide_49c884ea:

    # mc "Yo pienso lo mismo. Tú no estabas hoy en mi casa, pero con todo el mundo tengo una relación basada en el respeto, no en guardar secretos."
    mc "Penso o mesmo. Você não estava na minha casa hoje, mas tenho um relacionamento com todos baseado no respeito, não em guardar segredos."

# game/scripts/c20/c20.rpy:2651
translate brazilian c20s005_GivingMaddieARide_5db10965:

    # mc "Yo esperaba que nuestra relación evolucionara hacia algo más romántico. Pero si ha roto conmigo, creo que debería irme..."
    mc "Eu esperava que nosso relacionamento evoluísse para algo mais romântico. Mas se ele terminou comigo, acho que devo ir embora..."

# game/scripts/c20/c20.rpy:2653
translate brazilian c20s005_GivingMaddieARide_748c3ccd:

    # mad "¿Qué? ¡No!"
    mad "Não!"

# game/scripts/c20/c20.rpy:2655
translate brazilian c20s005_GivingMaddieARide_d8b39b3d:

    # mad "Digo..."
    mad "Dizer..."

# game/scripts/c20/c20.rpy:2656
translate brazilian c20s005_GivingMaddieARide_31d5dd14:

    # mad "Puedo hacer que Maddie vuelva, si quieres. Estoy segura de que le gustaría oir lo que has dicho."
    mad "Posso trazer a Maddie de volta, se você quiser. Tenho certeza de que ela gostaria de ouvir o que você disse."

# game/scripts/c20/c20.rpy:2657
translate brazilian c20s005_GivingMaddieARide_74bfce3d:

    # mc "Sí, por favor. Hazla volver."
    mc "Sim, por favor. Tragam-na de volta."

# game/scripts/c20/c20.rpy:2659
translate brazilian c20s005_GivingMaddieARide_26028f2c:

    # mad "Un momento, por favor."
    mad "Um momento por favor."

# game/scripts/c20/c20.rpy:2661
translate brazilian c20s005_GivingMaddieARide_9c1cced8:

    # mad "Me ha dicho Claire que quieres hablar conmigo. Sobre por qué he roto contigo."
    mad "Claire me disse que você quer falar comigo. Sobre por que eu terminei com você."

# game/scripts/c20/c20.rpy:2662
translate brazilian c20s005_GivingMaddieARide_ae0a59dd:

    # mc "¿A qué viene esto, Maddie?"
    mc "Do que se trata tudo isso, Maddie?"

# game/scripts/c20/c20.rpy:2664
translate brazilian c20s005_GivingMaddieARide_189eaa31:

    # mad "No sabía cómo decirte que quiero estar contigo... "
    mad "Eu não sabia como te dizer que quero ficar com você..."

# game/scripts/c20/c20.rpy:2666
translate brazilian c20s005_GivingMaddieARide_2701d7a4:

    # mad "... como estás con [mar]..."
    mad "...como você está com [mar]..."

# game/scripts/c20/c20.rpy:2668
translate brazilian c20s005_GivingMaddieARide_715ea0d0:

    # mad "... como estás con el resto de las chicas..."
    mad "...como você faz com as outras garotas..."

# game/scripts/c20/c20.rpy:2669
translate brazilian c20s005_GivingMaddieARide_7fecd2e0:

    # mad "Quiero una relación de verdad. Me gusta mucho lo que tenemos, pero... después de ver lo que podría tener... quiero más."
    mad "Eu quero um relacionamento de verdade. Eu gosto muito do que temos, mas... depois de ver o que eu poderia ter... eu quero mais."

# game/scripts/c20/c20.rpy:2670
translate brazilian c20s005_GivingMaddieARide_05dbb4cf:

    # mc "Y se te ha ocurrido este juego."
    mc "E você criou este jogo."

# game/scripts/c20/c20.rpy:2672
translate brazilian c20s005_GivingMaddieARide_61508003:

    # mad "Llevo desde la Gran Revelación pensando cómo hacerlo. Y al final no he usado ninguna de las ideas que tenía."
    mad "Venho pensando em como fazer isso desde a Grande Revelação. E, no fim, não usei nenhuma das ideias que tive."

# game/scripts/c20/c20.rpy:2673
translate brazilian c20s005_GivingMaddieARide_574339e8:

    # mad "Quería hablarlo en la piscina, pero justo en ese momento ha llegado Debbie..."
    mad "Eu queria conversar sobre isso perto da piscina, mas nesse momento a Debbie chegou..."

# game/scripts/c20/c20.rpy:2674
translate brazilian c20s005_GivingMaddieARide_c2ba7b18:

    # mad "Quiero olvidar lo que hemos hecho hasta ahora y empezar desde cero. ¿Crees que podríamos probarlo?"
    mad "Quero esquecer tudo o que fizemos até agora e começar do zero. Você acha que poderíamos tentar?"

# game/scripts/c20/c20.rpy:2675
translate brazilian c20s005_GivingMaddieARide_add99a6a:

    # mc "No. Lo siento, Maddie."
    mc "Não. Me desculpe, Maddie."

# game/scripts/c20/c20.rpy:2677
translate brazilian c20s005_GivingMaddieARide_2215400f:

    # mad "Pero..."
    mad "Mas..."

# game/scripts/c20/c20.rpy:2678
translate brazilian c20s005_GivingMaddieARide_8755a89a:

    # mc "Déjame hablar un momento."
    mc "Permita-me falar por um instante."

# game/scripts/c20/c20.rpy:2679
translate brazilian c20s005_GivingMaddieARide_b09238b8:

    # mc "No quiero olvidar lo que hemos hecho hasta ahora. Creo que la evolución natural de lo que estábamos haciendo es lo que vamos a hacer ahora."
    mc "Não quero esquecer o que fizemos até agora. Acredito que a evolução natural do que temos feito é o que faremos agora."

# game/scripts/c20/c20.rpy:2680
translate brazilian c20s005_GivingMaddieARide_5d3aacf1:

    # mc "Pero eso no significa que no nos lo hayamos pasado bien."
    mc "Mas isso não significa que não nos divertimos."

# game/scripts/c20/c20.rpy:2681
translate brazilian c20s005_GivingMaddieARide_c3916d55:

    # mc "Podemos tener una relación de verdad, pero sin dejar de hacer las cosas divertidas que hemos hecho hasta ahora."
    mc "Podemos ter um relacionamento de verdade, mas sem deixar de fazer as coisas divertidas que temos feito até agora."

# game/scripts/c20/c20.rpy:2683
translate brazilian c20s005_GivingMaddieARide_82109074:

    # mad "Me parece bien... ¿Significa que ahora soy una más de tus novias?"
    mad "Isso me parece ótimo... Isso significa que agora sou uma de suas namoradas?"

# game/scripts/c20/c20.rpy:2684
translate brazilian c20s005_GivingMaddieARide_d124f304:

    # mc "No me gustan las etiquetas, pero si a ti te gustan, sí, eres una más."
    mc "Eu não gosto de rótulos, mas se você gosta, então sim, você é um deles."

# game/scripts/c20/c20.rpy:2686
translate brazilian c20s005_GivingMaddieARide_8d834bb4:

    # "Maddie se lanza a tus brazos buscando tus labios en un beso lleno de alivio."
    "Maddie se atira em seus braços, buscando seus lábios em um beijo cheio de alívio."

# game/scripts/c20/c20.rpy:2687
translate brazilian c20s005_GivingMaddieARide_7c7f289f:

    # "El beso dura unos segundos antes de que se separe de ti."
    "O beijo dura alguns segundos antes que ele se afaste de você."

# game/scripts/c20/c20.rpy:2689
translate brazilian c20s005_GivingMaddieARide_9ca2ff4a:

    # mad "¡Gracias, [mc]! Estaba aterrorizada de planteártelo."
    mad "Obrigada, [mc]! Eu estava morrendo de medo de falar sobre isso com você."

# game/scripts/c20/c20.rpy:2690
translate brazilian c20s005_GivingMaddieARide_7217336c:

    # mc "No me des las gracias. Los dos ganamos con este cambio. Es lo que los dos queremos."
    mc "Não precisa agradecer. Nós dois saímos ganhando com essa mudança. É o que ambos queremos."

# game/scripts/c20/c20.rpy:2692
translate brazilian c20s005_GivingMaddieARide_bad70e44:

    # mc "Y nunca me pareció que estuvieras muy a gusto en el papel de dominatrix."
    mc "E eu nunca tive a impressão de que você se sentisse muito à vontade no papel de dominatrix."

# game/scripts/c20/c20.rpy:2694
translate brazilian c20s005_GivingMaddieARide_7e73f8d0:

    # mad "No, no lo estaba. Me gustó probarlo y tener el control... pensar que tenía el control..."
    mad "Não, eu não estava. Eu gostava de experimentar e de estar no controle... ou melhor, de pensar que estava no controle..."

# game/scripts/c20/c20.rpy:2696
translate brazilian c20s005_GivingMaddieARide_7412199c:

    # mc "Aunque me pareció que estabas muy a gusto en el papel de gatita sumisa."
    mc "Embora me parecesse que você se sentia muito confortável no papel de gatinha submissa."

# game/scripts/c20/c20.rpy:2698
translate brazilian c20s005_GivingMaddieARide_046425b4:

    # mad "Si, lo estaba. Me gustó probarlo y saber que no tenía el control..."
    mad "Sim, eu estava. Gostei de experimentar e saber que não tinha o controle..."

# game/scripts/c20/c20.rpy:2699
translate brazilian c20s005_GivingMaddieARide_22dd7e9a:

    # mad "Pero no estoy hecha para eso. Soy demasiado... normal..."
    mad "Mas eu não tenho vocação para isso. Sou muito... normal..."

# game/scripts/c20/c20.rpy:2701
translate brazilian c20s005_GivingMaddieARide_ccb07a8b:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con otras mujeres."
    mc "*Risos* Não, Maddie. Você não é normal. Acho que \"normal\" não inclui dividir o namorado com outras mulheres."

# game/scripts/c20/c20.rpy:2703
translate brazilian c20s005_GivingMaddieARide_57756bba:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con su suegra."
    mc "*Risos* Não, Maddie. Você não é normal. Acho que \"normal\" não inclui dividir o namorado com a sogra."

# game/scripts/c20/c20.rpy:2704
translate brazilian c20s005_GivingMaddieARide_30a2cede:

    # mc "Pero me encanta que no seamos normales en esto. Además, ¿quién define qué es normal y qué no?"
    mc "Mas adoro o fato de não sermos normais nesse aspecto. Além disso, quem define o que é normal e o que não é?"

# game/scripts/c20/c20.rpy:2705
translate brazilian c20s005_GivingMaddieARide_338ebfc4:

    # mc "Y la gente a la que le gusta la dominación también son normales. Con otros gustos, pero normales."
    mc "E pessoas que gostam de dominação também são normais. Com gostos diferentes, mas normais."

# game/scripts/c20/c20.rpy:2707
translate brazilian c20s005_GivingMaddieARide_3f0c4ec5:

    # mad "¿Quieres quedarte a dormir? Nuestra primera vez como pareja..."
    mad "Você quer passar a noite aqui? Nossa primeira vez como casal..."

# game/scripts/c20/c20.rpy:2708
translate brazilian c20s005_GivingMaddieARide_656167a3:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Não, Maddie. Já é tarde... já faz algumas horas... e você precisa descansar. Você tem que acordar cedo amanhã."

# game/scripts/c20/c20.rpy:2710
translate brazilian c20s005_GivingMaddieARide_b70c6047:

    # mad "Tienes razón, es tardísimo. Nuestra primera vez tendrá que esperar."
    mad "Você tem razão, é tarde demais. Nossa primeira vez terá que esperar."

# game/scripts/c20/c20.rpy:2711
translate brazilian c20s005_GivingMaddieARide_7a0a6a47:

    # mc "Sólo te pido una cosa. Pídele a Claire las gafas para lo próxima vez. *Risa* Estaba super sexy."
    mc "Só peço uma coisa. Da próxima vez, peça os óculos para a Claire. *Risos* Ela estava super sexy."

# game/scripts/c20/c20.rpy:2713
translate brazilian c20s005_GivingMaddieARide_18d5ae23:

    # mad "*Risa* Sólo las uso cuando estoy en el ordenador muchas horas y me quito las lentillas. Normalmente no las necesito."
    mad "*Risos* Eu só uso quando fico muitas horas no computador e tiro as lentes de contato. Normalmente não preciso delas."

# game/scripts/c20/c20.rpy:2714
translate brazilian c20s005_GivingMaddieARide_f0928b95:

    # mc "Pues creo que las vamos a usar lejos del ordenador también. Estás monísima con ellas."
    mc "Bom, acho que também vamos usá-las fora do computador. Você fica adorável com elas."

# game/scripts/c20/c20.rpy:2716
translate brazilian c20s005_GivingMaddieARide_0371334c:

    # mad "*Risa* Eso tiene fácil arreglo."
    mad "*Risos* Isso se resolve facilmente."

# game/scripts/c20/c20.rpy:2719
translate brazilian c20s005_GivingMaddieARide_f5267c98:

    # mad "Dame un segundo que me quite las lentillas. Los ojos me pican muchísimo."
    mad "Só um minutinho enquanto eu tiro minhas lentes de contato. Meus olhos estão coçando muito."

# game/scripts/c20/c20.rpy:2720
translate brazilian c20s005_GivingMaddieARide_5b2e4889:

    # mc "No sabía que llevaras lentillas... pero ve, no te preocupes."
    mc "Eu não sabia que você usava lentes de contato... mas pode usar, não se preocupe."

# game/scripts/c20/c20.rpy:2722
translate brazilian c20s005_GivingMaddieARide_ab55b4b0:

    # zeu "¡Miau! (¡Has vuelto! ¡Espero que vengas dispuesto a acariciarme!)"
    zeu "Miau! (Você voltou! Espero que esteja pronto para me fazer carinho!)"

# game/scripts/c20/c20.rpy:2723
translate brazilian c20s005_GivingMaddieARide_b7d29416:

    # mc "Hola, pequeñín. ¿Me has echado de menos?"
    mc "Olá, meu pequeno. Sentiu minha falta?"

# game/scripts/c20/c20.rpy:2724
translate brazilian c20s005_GivingMaddieARide_85d29c04:

    # zeu "¡Miau! (¿Me has traído atún para una cena tardía esta vez?)"
    zeu "Miau! (Você trouxe atum para o jantar tardio desta vez?)"

# game/scripts/c20/c20.rpy:2726
translate brazilian c20s005_GivingMaddieARide_9ee1b869_1:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Ronronar* (Ok, eu te perdoo... Mas não deixe isso acontecer de novo.)"

# game/scripts/c20/c20.rpy:2727
translate brazilian c20s005_GivingMaddieARide_f20a31cc_1:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Eu também senti sua falta. Suas pinturas fizeram muito sucesso."

# game/scripts/c20/c20.rpy:2728
translate brazilian c20s005_GivingMaddieARide_da4f0765_2:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronar* (Sou muito versátil. Gótica e cientista ao mesmo tempo. Não vamos falar do vestido rosa. Isso nunca aconteceu. Preciso conversar com minha psicóloga.)"

# game/scripts/c20/c20.rpy:2730
translate brazilian c20s005_GivingMaddieARide_8e201dc2:

    # mad "Ya estoy."
    mad "Estou aqui."

# game/scripts/c20/c20.rpy:2731
translate brazilian c20s005_GivingMaddieARide_e5a0c6fa:

    # mc "¡Wow! Te quedan genial. Deberías llevarlas más a menudo."
    mc "Nossa! Ficaram ótimas em você. Você deveria usá-las com mais frequência."

# game/scripts/c20/c20.rpy:2733
translate brazilian c20s005_GivingMaddieARide_c3f43795:

    # mad "Gracias. ¿Quieres quedarte a dormir?"
    mad "Obrigado. Gostaria de pernoitar?"

# game/scripts/c20/c20.rpy:2734
translate brazilian c20s005_GivingMaddieARide_656167a3_1:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Não, Maddie. Já é tarde... já faz algumas horas... e você precisa descansar. Você tem que acordar cedo amanhã."

# game/scripts/c20/c20.rpy:2736
translate brazilian c20s005_GivingMaddieARide_07711480:

    # mad "Tienes razón, es tardísimo. Espero que el día que te quedes llegue pronto."
    mad "Você tem razão, já é muito tarde. Espero que chegue logo o dia em que você poderá ficar."

# game/scripts/c20/c20.rpy:2737
translate brazilian c20s005_GivingMaddieARide_aa3251b4:

    # mc "No tardará, te lo prometo."
    mc "Não vai demorar muito, eu prometo."

# game/scripts/c20/c20.rpy:2739
translate brazilian c20s005_GivingMaddieARide_fe5338d9:

    # "Os dais un beso de buenas noches, sabiendo que el día siguiente os volveréis a ver en la tienda."
    "Vocês trocam um beijo de boa noite, sabendo que se verão novamente na loja no dia seguinte."

# game/scripts/c20/c20.rpy:2741
translate brazilian c20s005_GivingMaddieARide_98198ac8:

    # mad "¡Oh, mierda!"
    mad "Ah Merda!"

# game/scripts/c20/c20.rpy:2742
translate brazilian c20s005_GivingMaddieARide_b85e5ed2:

    # mc "¿Qué pasa, Maddie?"
    mc "O que houve, Maddie?"

# game/scripts/c20/c20.rpy:2744
translate brazilian c20s005_GivingMaddieARide_b7486548:

    # mad "Habíamos dicho de hacer el test de embarazo al acabar la partida de DnD y nos hemos olvidado los dos."
    mad "Tínhamos combinado de fazer um teste de gravidez depois de terminarmos nossa partida de D&D, e nós dois esquecemos."

# game/scripts/c20/c20.rpy:2745
translate brazilian c20s005_GivingMaddieARide_31b35a13:

    # mc "¡Es verdad! No he pensado en el test en todo el día, lo siento. Mañana te lo llevo a la tienda. Aún estaremos dentro del plazo de las 120 horas para la píldora."
    mc "É verdade! Desculpe, não pensei no teste o dia todo. Vou levar à farmácia amanhã. Ainda estaremos dentro do prazo de 120 horas para a pílula."

# game/scripts/c20/c20.rpy:2747
translate brazilian c20s005_GivingMaddieARide_bbfef618:

    # mad "Sobre eso... Si no te importa... Preferiría no tomarla."
    mad "Sobre isso... Se não se importar... eu preferiria não aceitar."

# game/scripts/c20/c20.rpy:2749
translate brazilian c20s005_GivingMaddieARide_aea65c3d:

    # mad "Nuestra relación ha cambiado y..."
    mad "Nosso relacionamento mudou e..."

# game/scripts/c20/c20.rpy:2751
translate brazilian c20s005_GivingMaddieARide_889469d9:

    # mad "Después de todo lo que ha pasado hoy..."
    mad "Depois de tudo o que aconteceu hoje..."

# game/scripts/c20/c20.rpy:2752
translate brazilian c20s005_GivingMaddieARide_a58a0df2:

    # mc "Te entiendo. Pero ¿quieres saber igualmente si estás embarazada?"
    mc "Entendo. Mas você ainda quer saber se está grávida?"

# game/scripts/c20/c20.rpy:2754
translate brazilian c20s005_GivingMaddieARide_5f0f935a:

    # mad "No. Quiero tener la experiencia de novia normal. Quiero enterarme cuando tenga un retraso y poder llamarte emocionada sin saber si estoy embarazada o no."
    mad "Não. Quero ter uma experiência normal de namorada. Quero saber quando estou atrasada e poder te ligar animada sem saber se estou grávida ou não."

# game/scripts/c20/c20.rpy:2755
translate brazilian c20s005_GivingMaddieARide_83770045:

    # mad "Si a ti te parece bien, claro."
    mad "Se você concordar, é claro."

# game/scripts/c20/c20.rpy:2756
translate brazilian c20s005_GivingMaddieARide_670e0d91:

    # mc "Me parece perfecto, Maddie. Los tests rápidos son fantásticos, pero le quitan un poco de esa emoción de la que hablas."
    mc "Isso parece perfeito, Maddie. Os testes rápidos são fantásticos, mas tiram um pouco da emoção que você mencionou."

# game/scripts/c20/c20.rpy:2758
translate brazilian c20s005_GivingMaddieARide_c180beb8:

    # mad "Y ahora te voy a echar de mi casa antes de que empiece a bostezar. No sería muy glamouroso que me vieras hasta la campanilla cuando bostece."
    mad "E agora vou te expulsar da minha casa antes mesmo de começar a bocejar. Não seria nada glamoroso se você me visse bocejando até a úvula."

# game/scripts/c20/c20.rpy:2759
translate brazilian c20s005_GivingMaddieARide_1f99d993:

    # mc "*Risa* No te preocupes. Descansa y nos vemos mañana."
    mc "*Risos* Não se preocupe. Descanse um pouco e nos vemos amanhã."

# game/scripts/c20/c20.rpy:2761
translate brazilian c20s005_GivingMaddieARide_ef8997c2:

    # "Os volvéis a dar otro beso de buenas noches y te marchas a casa antes de volver a enzarzaros en otro tema de conversación."
    "Vocês trocam mais um beijo de boa noite e vão para casa antes de começarem uma conversa sobre outro assunto."

# game/scripts/c20/c20.rpy:2766
translate brazilian c20s006_ReturningHome_accc05d2:

    # "Cuando llegas a casa, ves a Kiara de pie, al lado del garaje. Se ha cambiado de ropa."
    "Ao chegar em casa, você vê Kiara parada perto da garagem. Ela trocou de roupa."

# game/scripts/c20/c20.rpy:2769
translate brazilian c20s006_ReturningHome_a09a1c32:

    # mc "Hola de nuevo, Kiara. Iba a ir a buscarte a tu habitación."
    mc "Olá de novo, Kiara. Eu ia te procurar no seu quarto."

# game/scripts/c20/c20.rpy:2770
translate brazilian c20s006_ReturningHome_0dc1d7eb:

    # kia "Eileen está durmiendo. Es muy tarde y mañana trabaja por la mañana."
    kia "Eileen está dormindo. Já é muito tarde e ela precisa trabalhar amanhã de manhã."

# game/scripts/c20/c20.rpy:2771
translate brazilian c20s006_ReturningHome_fc68535a:

    # mc "Tú también. Quizás deberías estar durmiendo."
    mc "Você também. Talvez você devesse dormir."

# game/scripts/c20/c20.rpy:2773
translate brazilian c20s006_ReturningHome_7059ec6f:

    # kia "Lo he intentado, pero no puedo pegar ojo. Por eso necesito hablar."
    kia "Eu tentei, mas não consigo pregar o olho. É por isso que preciso conversar."

# game/scripts/c20/c20.rpy:2774
translate brazilian c20s006_ReturningHome_9fcd01ba:

    # mc "¿Quieres que pasemos dentro y hablemos?"
    mc "Você quer entrar e conversar?"

# game/scripts/c20/c20.rpy:2776
translate brazilian c20s006_ReturningHome_9305a04d:

    # kia "Mejor vayamos a sentarnos en la piscina. Así no molestaremos a nadie."
    kia "Vamos sentar perto da piscina. Assim não incomodaremos ninguém."

# game/scripts/c20/c20.rpy:2777
translate brazilian c20s006_ReturningHome_7f866e75:

    # mc "Y nadie nos oirá."
    mc "E ninguém nos ouvirá."

# game/scripts/c20/c20.rpy:2778
translate brazilian c20s006_ReturningHome_c4ae781b:

    # kia "Exacto."
    kia "Exato."

# game/scripts/c20/c20.rpy:2780
translate brazilian c20s006_ReturningHome_8b317a75:

    # "Kiara anda el camino hacia las tumbonas en silencio, delante tuyo. Parece que está ordenando sus ideas, como si estuviera preparando un discurso."
    "Kiara caminha silenciosamente à sua frente em direção às espreguiçadeiras. Ela parece estar reunindo seus pensamentos, como se estivesse preparando um discurso."

# game/scripts/c20/c20.rpy:2782
translate brazilian c20s006_ReturningHome_5deaa470:

    # "Solo hay un problema. No hay tumbonas al llegar. Las han recogido después de la fiesta."
    "Só tem um problema. Não há espreguiçadeiras quando você chega. Elas foram retiradas depois da festa."

# game/scripts/c20/c20.rpy:2783
translate brazilian c20s006_ReturningHome_b0967ddd:

    # "Ninguno de los dos os habéis dado cuenta mientras andabais hacia donde suelen estar."
    "Nenhum de vocês percebeu enquanto caminhavam em direção ao local onde eles costumam estar."

# game/scripts/c20/c20.rpy:2785
translate brazilian c20s006_ReturningHome_74650567:

    # kia "Vaya, han recogido las tumbonas. Tendremos que ir dentro."
    kia "Puxa, já guardaram as espreguiçadeiras. Teremos que entrar."

# game/scripts/c20/c20.rpy:2786
translate brazilian c20s006_ReturningHome_bd191e3f:

    # mc "Podemos sentarnos en el borde de la piscina, como hemos hecho antes."
    mc "Podemos sentar na borda da piscina, como já fizemos antes."

# game/scripts/c20/c20.rpy:2787
translate brazilian c20s006_ReturningHome_b8e83a6c:

    # kia "Como quieras..."
    kia "O que você quiser..."

# game/scripts/c20/c20.rpy:2789
translate brazilian c20s006_ReturningHome_089feeb3:

    # "Una vez descalzos y sentados, con los pies en el agua, Kiara se mantiene en silencio."
    "Assim que se senta descalça, com os pés na água, Kiara permanece em silêncio."

# game/scripts/c20/c20.rpy:2791
translate brazilian c20s006_ReturningHome_a5e044c3:

    # mc "Kiara, ¿de qué quieres hablar? Me estás preocupando."
    mc "Kiara, sobre o que você quer conversar? Você está me preocupando."

# game/scripts/c20/c20.rpy:2792
translate brazilian c20s006_ReturningHome_c7523d18:

    # kia "De nosotros..."
    kia "De nós..."

# game/scripts/c20/c20.rpy:2794
translate brazilian c20s006_ReturningHome_e370d625:

    # kia "No estoy segura de que lo que he hecho esta tarde haya sido lo mejor que podría haber hecho."
    kia "Não tenho certeza se o que fiz esta tarde foi a melhor coisa que eu poderia ter feito."

# game/scripts/c20/c20.rpy:2795
translate brazilian c20s006_ReturningHome_a5df840b:

    # mc "¿Qué has hecho? ¿Besarme?"
    mc "O que você fez? Me beijou?"

# game/scripts/c20/c20.rpy:2797
translate brazilian c20s006_ReturningHome_2b5a2645:

    # kia "Sí. Delante de todas las chicas..."
    kia "Sim. Na frente de todas as garotas..."

# game/scripts/c20/c20.rpy:2798
translate brazilian c20s006_ReturningHome_0469b98b:

    # mc "Y, por lo que me ha parecido, todas te han felicitado por dar el paso de dejar tu pasado atrás, ¿no?"
    mc "E, pelo que vi, todos te parabenizaram por ter dado o passo de deixar o passado para trás, certo?"

# game/scripts/c20/c20.rpy:2799
translate brazilian c20s006_ReturningHome_54747eb3:

    # mc "Precisamente el día en que han visto cómo era tu pasado..."
    mc "Exatamente no dia em que eles viram como era o seu passado..."

# game/scripts/c20/c20.rpy:2801
translate brazilian c20s006_ReturningHome_4ae66f04:

    # kia "Sí... pero es mi vida, no la suya..."
    kia "Sim... mas é a minha vida, não a sua..."

# game/scripts/c20/c20.rpy:2802
translate brazilian c20s006_ReturningHome_7c906f37:

    # mc "Y ninguna de ellas te va a forzar a dar ningún paso que no quieras dar, Kiara."
    mc "E nenhum deles vai te obrigar a tomar qualquer atitude que você não queira, Kiara."

# game/scripts/c20/c20.rpy:2804
translate brazilian c20s006_ReturningHome_738b57de:

    # kia "A eso me refiero... ahora que he recuperado un poco el control de mi vida..."
    kia "É isso que eu quero dizer... agora que recuperei um pouco do controle da minha vida..."

# game/scripts/c20/c20.rpy:2805
translate brazilian c20s006_ReturningHome_e0765801:

    # kia "No sé que se espera de mí..."
    kia "Não sei o que se espera de mim..."

# game/scripts/c20/c20.rpy:2806
translate brazilian c20s006_ReturningHome_9226b533:

    # mc "Nadie espera nada de ti. Lo que esperamos todos, yo incluído, es que consigas ser feliz en esta familia como no lo fuiste en tu familia anterior."
    mc "Ninguém espera nada de você. O que todos nós esperamos, inclusive eu, é que você encontre a felicidade nesta família, ao contrário da anterior."

# game/scripts/c20/c20.rpy:2808
translate brazilian c20s006_ReturningHome_0023fec3:

    # kia "No me digas que nadie espera que nos acostemos juntos hoy."
    kia "Não me diga que ninguém espera que a gente durma junto hoje à noite."

# game/scripts/c20/c20.rpy:2809
translate brazilian c20s006_ReturningHome_f04255d3:

    # mc "¿Qué? ¡No! ¡Eso no lo espero ni siquiera yo!"
    mc "O quê? Não! Nem eu esperava isso!"

# game/scripts/c20/c20.rpy:2813
translate brazilian c20s006_ReturningHome_49695eab:

    # kia "Me acabas de mirar las tetas..."
    kia "Você acabou de olhar para os meus seios..."

# game/scripts/c20/c20.rpy:2814
translate brazilian c20s006_ReturningHome_ef78b8c0:

    # mc "No me malinterpretes. Si me lo propusieras, no diría que no ni por todo el oro del mundo. Pero no creo que sea el momento correcto."
    mc "Não me interprete mal. Se me perguntassem, eu não diria não nem por todo o ouro do mundo. Mas acho que não é o momento certo."

# game/scripts/c20/c20.rpy:2816
translate brazilian c20s006_ReturningHome_de0bcae3:

    # kia "Pues dile eso a mi hija... "
    kia "Pois bem, diga isso à minha filha..."

# game/scripts/c20/c20.rpy:2817
translate brazilian c20s006_ReturningHome_da03b963:

    # mc "¿Eileen? ¿Qué te ha dicho?"
    mc "Eileen? O que ela te disse?"

# game/scripts/c20/c20.rpy:2819
translate brazilian c20s006_ReturningHome_9615fb6d:

    # kia "Me ha intentado convencer de que fuera a tu habitación esta noche. Cuando le he dicho que no, me ha preguntado que cuánto voy a esperar para tener sexo contigo."
    kia "Ele tentou me convencer a ir ao seu quarto hoje à noite. Quando eu disse não, ele me perguntou quanto tempo eu ia esperar para transar com você."

# game/scripts/c20/c20.rpy:2820
translate brazilian c20s006_ReturningHome_272c4fa5:

    # mc "Kiara, ha sido un día muy largo y todo el mundo tiene mucho que procesar. Tú, Eileen, y yo."
    mc "Kiara, foi um dia muito longo e todos nós temos muita coisa para processar. Você, Eileen e eu."

# game/scripts/c20/c20.rpy:2822
translate brazilian c20s006_ReturningHome_da9a66ac:

    # kia "Lo sé, pero no lo entiendes... Soy una mujer que... no sé... Siempre han tomado decisiones por mí. Me las han impuesto."
    kia "Eu sei, mas você não entende... Eu sou uma mulher que... Não sei... As decisões sempre foram tomadas por mim. Elas me foram impostas."

# game/scripts/c20/c20.rpy:2823
translate brazilian c20s006_ReturningHome_f2c76260:

    # kia "Y Eileen lo sabe. Ahora es ella la que intenta hacerlo."
    kia "E Eileen sabe disso. Agora é a vez dela de tentar."

# game/scripts/c20/c20.rpy:2824
translate brazilian c20s006_ReturningHome_77e80691:

    # mc "Eileen es una persona muy sexual. Demuestra su amor con sexo, entre otras cosas."
    mc "Eileen é uma pessoa muito sexual. Ela demonstra seu amor através do sexo, entre outras coisas."

# game/scripts/c20/c20.rpy:2826
translate brazilian c20s006_ReturningHome_bcba7e8d:

    # kia "Lo sé..."
    kia "Eu sei..."

# game/scripts/c20/c20.rpy:2827
translate brazilian c20s006_ReturningHome_f823a140:

    # mc "Pero si le das un momento para pensar se dará cuenta de que tú no eres igual. O al menos no pareces serlo."
    mc "Mas se você lhe der um momento para pensar, ele perceberá que você não é mais a mesma. Ou pelo menos não parece ser."

# game/scripts/c20/c20.rpy:2829
translate brazilian c20s006_ReturningHome_3621ae77:

    # kia "No, no lo soy... para mí el sexo... Siempre he oído que debería ser... no sé... especial. Y nunca lo ha sido..."
    kia "Não, eu não sou... para mim, sexo... sempre ouvi dizer que deveria ser... sei lá... especial. E nunca foi..."

# game/scripts/c20/c20.rpy:2831
translate brazilian c20s006_ReturningHome_48105419:

    # kia "El beso de esta tarde me ha erizado el pelo de sitios donde no sabía que tenía pelo."
    kia "O beijo desta tarde fez meus pelos se arrepiarem em lugares que eu nem sabia que tinha."

# game/scripts/c20/c20.rpy:2832
translate brazilian c20s006_ReturningHome_5beff731:

    # kia "Pero no quiero pensar en nada más allá de ese beso... por ahora..."
    kia "Mas não quero pensar em nada além daquele beijo... por enquanto..."

# game/scripts/c20/c20.rpy:2833
translate brazilian c20s006_ReturningHome_62396cdf:

    # mc "No hay ningún problema con eso. No lo hay conmigo ni lo hay con nadie más. Porque nadie más que tú y yo decidiremos cuándo va a pasar."
    mc "Não há problema nenhum nisso. Não há problema nenhum comigo, e não há problema nenhum com mais ninguém. Porque ninguém além de você e eu decidirá quando isso vai acontecer."

# game/scripts/c20/c20.rpy:2835
translate brazilian c20s006_ReturningHome_6bc1b511:

    # kia "Entonces... ¿no te importa ir paso a paso?"
    kia "Então... você não se importa de ir passo a passo?"

# game/scripts/c20/c20.rpy:2836
translate brazilian c20s006_ReturningHome_d7cc3734:

    # mc "No, no me importa. Es más, mañana te voy a invitar a cenar, si quieres."
    mc "Não, não me importo. Aliás, posso te convidar para jantar amanhã, se você quiser."

# game/scripts/c20/c20.rpy:2837
translate brazilian c20s006_ReturningHome_d759bfe7:

    # mc "Quizás, si empezamos a salir como una pareja tradicional te sientas más cómoda. Pero sólamente si quieres ir a cenar conmigo. Nadie te puede forzar a ello."
    mc "Talvez você se sinta mais à vontade se começarmos a namorar como um casal tradicional. Mas só se você quiser sair para jantar comigo. Ninguém pode te obrigar."

# game/scripts/c20/c20.rpy:2839
translate brazilian c20s006_ReturningHome_62832fad:

    # kia "Sí, quiero. Pero mejor a comer. Si salimos de noche, Eileen me va a interrogar cuando volvamos."
    kia "Sim, eu quero. Mas primeiro devemos ir jantar. Se sairmos à noite, Eileen vai me interrogar quando voltarmos."

# game/scripts/c20/c20.rpy:2840
translate brazilian c20s006_ReturningHome_8b671804:

    # mc "Perfecto. Tenemos una cita para comer."
    mc "Perfeito. Temos um almoço marcado."

# game/scripts/c20/c20.rpy:2841
translate brazilian c20s006_ReturningHome_0139acbd:

    # mc "Y recuerda que, aunque Eileen te interrogue, no tienes porqué contarle nada que no quieras contarle."
    mc "E lembre-se disso: mesmo que Eileen lhe faça perguntas, você não precisa lhe contar nada que não queira."

# game/scripts/c20/c20.rpy:2843
translate brazilian c20s006_ReturningHome_1e9ad038:

    # kia "Lo sé. Ni sentirme forzada a hacer lo que ella quiera que haga."
    kia "Eu sei. E também não me sinto obrigado a fazer o que ela quer que eu faça."

# game/scripts/c20/c20.rpy:2844
translate brazilian c20s006_ReturningHome_1ce75b02:

    # mc "Exacto."
    mc "Exato."

# game/scripts/c20/c20.rpy:2846
translate brazilian c20s006_ReturningHome_54968c6f:

    # kia "Aunque {b}tú{/b} la mandes a que me de la charla y me convenza de cosas, como has hecho esta tarde."
    kia "Mesmo que você a mande para me dar uma palestra e me convencer de certas coisas, como fez esta tarde."

# game/scripts/c20/c20.rpy:2847
translate brazilian c20s006_ReturningHome_c582738d:

    # mc "No, Kiara. No la he mandado a que te convenciera de nada. Estabas preocupada por cómo se sentiría si tú y yo empezábamos algo."
    mc "Não, Kiara. Eu não a mandei para te convencer de nada. Você estava preocupada com o que ela pensaria se nós duas começássemos algo."

# game/scripts/c20/c20.rpy:2848
translate brazilian c20s006_ReturningHome_3979befc:

    # mc "Sólo le he dicho que te dijera cómo se sentiría. No tenía que ir más allá."
    mc "Eu apenas disse para ele te contar como se sentia. Ele não precisava dizer mais nada."

# game/scripts/c20/c20.rpy:2850
translate brazilian c20s006_ReturningHome_8fe26f31:

    # kia "*Risa* ¿No conoces a mi hija? ¿Creías que iba a parar después de decírmelo?"
    kia "*Risos* Você não conhece minha filha? Achou que eu ia parar depois de me contar isso?"

# game/scripts/c20/c20.rpy:2851
translate brazilian c20s006_ReturningHome_ba48a9df:

    # mc "En un principio, sí, era lo que esperaba."
    mc "Inicialmente, sim, era isso que eu esperava."

# game/scripts/c20/c20.rpy:2852
translate brazilian c20s006_ReturningHome_feac233e:

    # mc "Cuando he visto cómo ha reaccionado cuando... durante el incidente... Creo que estaba muy ansiosa de librarse de su padre."
    mc "Quando vi como ela reagiu durante o incidente... acho que ela estava muito ansiosa para se livrar do pai."

# game/scripts/c20/c20.rpy:2854
translate brazilian c20s006_ReturningHome_01979e1c:

    # kia "Es gracioso que digas \"su padre\" en vez de \"Solomon\" o \"tu marido\"."
    kia "É engraçado você dizer \"o pai dela\" em vez de \"Salomão\" ou \"seu marido\"."

# game/scripts/c20/c20.rpy:2855
translate brazilian c20s006_ReturningHome_b63ee2e1:

    # kia "Es como si no quisieras recordarme que estoy casada con el padre de Eileen."
    kia "É como se você não quisesse me lembrar que sou casada com o pai da Eileen."

# game/scripts/c20/c20.rpy:2856
translate brazilian c20s006_ReturningHome_aad7fbb8:

    # mc "Es que no quiero recordártelo. Estais casados sobre el papel, pero has dicho que no volverás con él nunca."
    mc "Não quero te lembrar disso. Vocês estão casados no papel, mas você disse que nunca mais vai voltar com ele."

# game/scripts/c20/c20.rpy:2857
translate brazilian c20s006_ReturningHome_190f1f31:

    # mc "En este caso, vuestro matrimonio es únicamente una formalidad hasta que te divorcies."
    mc "Nesse caso, seu casamento é mera formalidade até que o divórcio seja concretizado."

# game/scripts/c20/c20.rpy:2859
translate brazilian c20s006_ReturningHome_20889386:

    # kia "Sabes que somos católicos, ¿verdad? Solomon nunca me concederá el divorcio."
    kia "Você sabe que somos católicos, né? Salomão nunca vai me conceder o divórcio."

# game/scripts/c20/c20.rpy:2860
translate brazilian c20s006_ReturningHome_38c27be6:

    # mc "Pues tendremos que buscar alguna forma de adecuar nuestra relación a tus creencias religiosas."
    mc "Bem, teremos que encontrar uma maneira de adaptar nosso relacionamento às suas crenças religiosas."

# game/scripts/c20/c20.rpy:2861
translate brazilian c20s006_ReturningHome_b20eb053:

    # mc "No tengo ni idea de como puede afectarte esto."
    mc "Não faço ideia de como isso pode te afetar."

# game/scripts/c20/c20.rpy:2863
translate brazilian c20s006_ReturningHome_bae4722e:

    # kia "Entonces todo arreglado. Mañana comemos juntos y ya veremos... A ver como evoluciona esto... ¿Nos vamos a dormir?"
    kia "Então está tudo resolvido. Almoçaremos juntos amanhã e veremos como as coisas correm... Vamos ver como isso se desenvolve... Vamos dormir?"

# game/scripts/c20/c20.rpy:2864
translate brazilian c20s006_ReturningHome_dbeedd01:

    # mc "Sólo tengo una pregunta antes de irnos."
    mc "Só tenho uma pergunta antes de irmos."

# game/scripts/c20/c20.rpy:2865
translate brazilian c20s006_ReturningHome_7e031e08:

    # mc "El salto de cama que llevabas antes... ¿Ibas a ir a mi habitación? ¿Te había convencido Eileen?"
    mc "A camisola que você estava usando mais cedo... Você ia para o meu quarto? Eileen tinha te convencido?"

# game/scripts/c20/c20.rpy:2867
translate brazilian c20s006_ReturningHome_31cf8c7e:

    # kia "Casi. Me había vestido así por si reunía el valor para hacerlo."
    kia "Quase. Eu me vesti assim caso reunisse coragem para fazer isso."

# game/scripts/c20/c20.rpy:2868
translate brazilian c20s006_ReturningHome_e643b0b5:

    # kia "Cuando te he oído subir las escaleras, he pensado que sería un buen momento para hablarlo en vez de plantarme en tu habitación como una buscona."
    kia "Quando te ouvi subindo as escadas, pensei que seria uma boa hora para conversarmos sobre isso, em vez de aparecer no seu quarto como uma vadia."

# game/scripts/c20/c20.rpy:2870
translate brazilian c20s006_ReturningHome_76a469d6:

    # kia "Por lo que estaba diciendo Eile, tenías que estar ansioso por que lo hiciera."
    kia "Pelo que Eile estava dizendo, era preciso estar ansioso para que ele fizesse isso."

# game/scripts/c20/c20.rpy:2871
translate brazilian c20s006_ReturningHome_c3f188e0:

    # kia "Por suerte, tenías que llevar a Maddie a casa y eso me ha salvado de hacer algo de lo que después seguramente me hubiera arrepentido."
    kia "Por sorte, você teve que levar a Maddie para casa, e isso me impediu de fazer algo de que provavelmente me arrependeria mais tarde."

# game/scripts/c20/c20.rpy:2873
translate brazilian c20s006_ReturningHome_2fb66a60:

    # kia "*Risa* No se lo tengas en cuenta a la chica."
    kia "*Risos* Não leve a garota a mal."

# game/scripts/c20/c20.rpy:2874
translate brazilian c20s006_ReturningHome_6a7e8bf5:

    # mc "Creo que es al revés. Creo que le tenemos que agradecer a Maddie que nos podamos tomar nuestro tiempo y hacer las cosas a nuestro ritmo."
    mc "Acho que é o contrário. Acho que devemos agradecer à Maddie por nos permitir levar o nosso tempo e fazer as coisas no nosso próprio ritmo."

# game/scripts/c20/c20.rpy:2876
translate brazilian c20s006_ReturningHome_07cf9117:

    # kia "Visto así... tienes razón."
    kia "Visto dessa forma... você tem razão."

# game/scripts/c20/c20.rpy:2878
translate brazilian c20s006_ReturningHome_1f0aa400:

    # "Kiara se calza y se levanta para irse. Haces lo mismo."
    "Kiara calça os sapatos e se levanta para sair. Você faz o mesmo."

# game/scripts/c20/c20.rpy:2879
translate brazilian c20s006_ReturningHome_fecf056e:

    # kia "¿Me acompañas a casa de [nor]?"
    kia "Você quer vir comigo até a casa de [nor]?"

# game/scripts/c20/c20.rpy:2880
translate brazilian c20s006_ReturningHome_48d5f2ce:

    # mc "Sólo si me prometes que esta vez habrá beso de despedida y que dejarás de llamarla casa de [nor]. También es tu casa ahora."
    mc "Só se você me prometer que desta vez haverá um beijo de despedida e que você vai parar de chamar esta casa de [nor]. Agora ela também é sua."

# game/scripts/c20/c20.rpy:2882
translate brazilian c20s006_ReturningHome_272ebc82:

    # kia "*Risa* Me parece bien. ¿Me acompañas a casa?"
    kia "*Risos* Parece ótimo. Você me acompanha até em casa?"

# game/scripts/c20/c20.rpy:2884
translate brazilian c20s006_ReturningHome_997a1865:

    # mc "No has dicho nada del beso..."
    mc "Você não disse nada sobre o beijo..."

# game/scripts/c20/c20.rpy:2887
translate brazilian c20s006_ReturningHome_012de196:

    # "Kiara se lanza a por tus labios, con la misma dulzura y avidez que ha hecho por la tarde, sorprendiéndote con ambas."
    "Kiara se lança em direção aos seus lábios, com a mesma doçura e entusiasmo da tarde anterior, surpreendendo você com ambos."

# game/scripts/c20/c20.rpy:2889
translate brazilian c20s006_ReturningHome_6bf383c5:

    # kia "¿Te parece suficiente promesa?"
    kia "Isso lhe parece uma promessa suficiente?"

# game/scripts/c20/c20.rpy:2890
translate brazilian c20s006_ReturningHome_b32ecd82:

    # mc "Me parece perfecta."
    mc "Acho que é perfeito."

# game/scripts/c20/c20.rpy:2892
translate brazilian c20s006_ReturningHome_cf33bef7:

    # "El camino de la piscina hasta la casa de [nor], la casa de Kiara, no os debería llevar más de dos o tres minutos. Os lleva más de quince."
    "A caminhada da piscina até a casa de [nor], a casa da Kiara, não deveria levar mais de dois ou três minutos. Leva mais de quinze."

# game/scripts/c20/c20.rpy:2894
translate brazilian c20s006_ReturningHome_79a713f1:

    # "Os paráis cada pocos metros para volver a besaros."
    "Vocês param a cada poucos metros para se beijarem novamente."

# game/scripts/c20/c20.rpy:2896
translate brazilian c20s006_ReturningHome_f6f158a0:

    # "Y esos pocos metros los recorréis, a paso lento, cogidos de la mano, intentando alargar la experiencia lo máximo posible."
    "E vocês caminham lentamente por aqueles poucos metros, de mãos dadas, tentando prolongar a experiência o máximo possível."

# game/scripts/c20/c20.rpy:2898
translate brazilian c20s006_ReturningHome_5fdefe13:

    # "Pero al final llegáis a la puerta principal. Un último beso antes de separaros."
    "Mas finalmente você chega à porta da frente. Um último beijo antes de se separarem."

# game/scripts/c20/c20.rpy:2900
translate brazilian c20s006_ReturningHome_0dba28f7:

    # kia "Pues hasta aquí ha llegado nuestro paseo..."
    kia "Bem, é aqui que nossa caminhada chega ao fim..."

# game/scripts/c20/c20.rpy:2901
translate brazilian c20s006_ReturningHome_ab22a5bd:

    # mc "Si por mí fuera, lo podríamos repetir todas las noches."
    mc "Se dependesse de mim, poderíamos repetir isso todas as noites."

# game/scripts/c20/c20.rpy:2903
translate brazilian c20s006_ReturningHome_63be4610:

    # kia "No creo que me sentara bien una ducha fría todas las noches a la 1:00 AM... o la hora que sea ya."
    kia "Acho que não ficaria feliz em tomar um banho frio todas as noites à 1h da manhã... ou seja lá que horas forem agora."

# game/scripts/c20/c20.rpy:2904
translate brazilian c20s006_ReturningHome_5a9f0d9e:

    # mc "¿Vas a darte una ducha ahora?"
    mc "Você vai tomar banho agora?"

# game/scripts/c20/c20.rpy:2906
translate brazilian c20s006_ReturningHome_245e31b5:

    # kia "No preguntes lo que no quieras saber. Y no te ofrezcas a enjabonarme la espalda. *Risa*"
    kia "Não pergunte o que você não quer saber. E não se ofereça para lavar minhas costas. *Risos*"

# game/scripts/c20/c20.rpy:2907
translate brazilian c20s006_ReturningHome_dde5cc42:

    # mc "*Risa* No lo voy a hacer. Seguramente no me conformaría con la espalda."
    mc "*Risos* Não vou fazer isso. Com certeza não ficaria satisfeita só com as minhas costas."

# game/scripts/c20/c20.rpy:2909
translate brazilian c20s006_ReturningHome_0268ab97:

    # kia "Entonces, hasta mañana a la hora de comer, ¿no?"
    kia "Então, nos vemos amanhã na hora do almoço, certo?"

# game/scripts/c20/c20.rpy:2910
translate brazilian c20s006_ReturningHome_f7213923:

    # mc "Sí, no creo que esté levantado cuando vayas a trabajar. ¿Quieres que te pase a buscar sobre la 1:00 PM?"
    mc "Sim, acho que não estarei acordado quando você for trabalhar. Gostaria que eu te buscasse por volta das 13h?"

# game/scripts/c20/c20.rpy:2911
translate brazilian c20s006_ReturningHome_375bdc59:

    # kia "Es una buena hora. Normalmente salgo entre la 1:00 y la 1:30 a comer. Tengo una hora de tiempo."
    kia "É um bom horário. Normalmente saio para almoçar entre 13h e 13h30. Tenho uma hora livre."

# game/scripts/c20/c20.rpy:2912
translate brazilian c20s006_ReturningHome_4b85b8a1:

    # mc "Buscaré algún sitio cerca de la biblioteca para ir a comer. Y no, no vamos a ir al puesto de los perritos calientes en nuestra primera cita."
    mc "Vou procurar um lugar para comer perto da biblioteca. E não, não vamos à barraquinha de cachorro-quente no nosso primeiro encontro."

# game/scripts/c20/c20.rpy:2914
translate brazilian c20s006_ReturningHome_949e2cf6:

    # kia "*Risita* Me parece bien, aunque casi consideraría este paseo como nuestra primera cita."
    kia "*Risos* Isso me parece ótimo, embora eu quase considerasse esse passeio como nosso primeiro encontro."

# game/scripts/c20/c20.rpy:2915
translate brazilian c20s006_ReturningHome_270bcedd:

    # mc "Lo será si acaba en beso."
    mc "Será ótimo se terminar em beijo."

# game/scripts/c20/c20.rpy:2917
translate brazilian c20s006_ReturningHome_08df730a:

    # "Acaba en beso. Un beso que dice que mañana habrá más. Un beso que sabe a despedida, aunque solo sea por doce horas."
    "Termina num beijo. Um beijo que diz que haverá mais amanhã. Um beijo com gosto de despedida, mesmo que apenas por doze horas."

# game/scripts/c20/c20.rpy:2918
translate brazilian c20s006_ReturningHome_be90d0b8:

    # "Un beso en el que no hay dudas, que empieza a un ritmo suave y que acelera poco a poco. Como esperas que pase con vuestra relación."
    "Um beijo onde não há dúvidas, que começa suavemente e gradualmente se intensifica. Exatamente como você espera que aconteça no seu relacionamento."

# game/scripts/c20/c20.rpy:2920
translate brazilian c20s006_ReturningHome_d2b8a5a5:

    # kia "Hasta mañana, [mc]. Esperaré ansiosa que vengas a buscarme."
    kia "Até amanhã, [mc]. Estarei ansiosamente esperando você vir me buscar."

# game/scripts/c20/c20.rpy:2921
translate brazilian c20s006_ReturningHome_de54c180:

    # mc "Hasta mañana, Kiara. Yo estaré ansioso por ir."
    mc "Até amanhã, Kiara. Estou ansiosa para ir."

# game/scripts/c20/c20.rpy:2922
translate brazilian c20s006_ReturningHome_39c53149:

    # mc "*Risa* Y tampoco vamos a ir al puesto de los perritos calientes en nuestra segunda cita, ahora que ésta cuenta como la primera."
    mc "*Risos* E nós também não vamos à barraquinha de cachorro-quente no nosso segundo encontro, já que este conta como o primeiro."

