    # "Llegas a la cocina y ves a [sai] con la cabeza metida en la nevera."
    "Você chega à cozinha e vê [sai] com a cabeça presa na geladeira."

# game/scripts/c25/c25.rpy:3107
translate brazilian c25s004_SaiPickles_135f6561:

    # mc "¿Estás buscando algo para comer antes de la hora de la comida? ¿Ya se ha acabado el interrogatorio?"
    mc "Você está procurando algo para comer antes do almoço? O interrogatório já terminou?"

# game/scripts/c25/c25.rpy:3109
translate brazilian c25s004_SaiPickles_d570b58f:

    # sai "Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    sai "Eu gostaria de picles com sorvete de chocolate, mas não temos picles."

# game/scripts/c25/c25.rpy:3110
translate brazilian c25s004_SaiPickles_84f35fa2:

    # mc "¡Aargh! *Risa* ¡Eso tiene que tener un gusto horrendo! No te he visto nunca comer algo así."
    mc "Argh! *Risos* Deve ter um gosto horrível! Nunca te vi comer nada parecido."

# game/scripts/c25/c25.rpy:3111
translate brazilian c25s004_SaiPickles_7613b351:

    # mc "¿Es posible que sea un antojo del embarazo?"
    mc "Será possível que seja um desejo de grávida?"

# game/scripts/c25/c25.rpy:3114
translate brazilian c25s004_SaiPickles_d8b5aa9b:

    # sai "No lo creo. [mar] me ha dicho que los antojos son una tontería para explotar a los pobres padres, y que ella no tuvo cuando estuvo embarazada."
    sai "Acho que não. Ela me disse que desejos alimentares são uma forma boba de se aproveitar de pais inseguros, e que ela não teve nenhum durante a gravidez."

# game/scripts/c25/c25.rpy:3116
translate brazilian c25s004_SaiPickles_b847636e:

    # sai "No lo creo. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    sai "Acho que não. Sempre achei que os desejos incontroláveis são uma forma boba de se aproveitar de pais pobres."

# game/scripts/c25/c25.rpy:3117
translate brazilian c25s004_SaiPickles_ebc3973b:

    # sai "Pero es posible... ahora que lo dices, suena asqueroso."
    sai "Mas é possível... agora que você mencionou, parece nojento."

# game/scripts/c25/c25.rpy:3118
translate brazilian c25s004_SaiPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Você quer que eu vá comprar picles?"

# game/scripts/c25/c25.rpy:3120
translate brazilian c25s004_SaiPickles_1da6546b:

    # sai "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    sai "Se não se importar... Mesmo que pareça nojento, eu ainda os quero."

# game/scripts/c25/c25.rpy:3121
translate brazilian c25s004_SaiPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Não se preocupe, vou comprá-los agora."

# game/scripts/c25/c25.rpy:3123
translate brazilian c25s004_SaiPickles_31a2e821:

    # sai "Gracias, mi amor."
    sai "Obrigado, meu amor."

# game/scripts/c25/c25.rpy:3125
translate brazilian c25s004_SaiPickles_90dcf7fb:

    # sai "¿Puedes pasar a buscar a [mad.nick] también? Así le ahorras tener que coger un Under para venir a comer."
