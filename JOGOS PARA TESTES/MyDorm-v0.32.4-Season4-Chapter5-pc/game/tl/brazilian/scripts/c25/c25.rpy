# game/scripts/c25/c25.rpy:3209
translate brazilian c25s004_GetMad_64444bd1:

    # "Conduces hasta la tienda y compras los pepinillos. También compras una lata de atún para el pequeño dictador."
    "Você dirige até a loja e compra os picles. Você também compra uma lata de atum para o pequeno ditador."

# game/scripts/c25/c25.rpy:3210
translate brazilian c25s004_GetMad_18de90a7:

    # "Empiezas a estar un poco preocupado por si los antojos son reales."
    "Você começa a ficar um pouco preocupado se os desejos são reais."

# game/scripts/c25/c25.rpy:3212
translate brazilian c25s004_GetMad_c910e8e2:

    # "Conduces hasta la tienda y compras el pollo que te ha pedido [mar]. También compras una lata de atún para el pequeño dictador."
    "Você dirige até a loja e compra o frango que [mar] pediu. Você também compra uma lata de atum para o pequeno ditador."

# game/scripts/c25/c25.rpy:3215
translate brazilian c25s004_GetMad_c913ca08:

    # "Una vez hechas las compras, vas a casa de [mad.nick]."
    "Depois de fazer suas compras, você vai para a casa de [mad.nick]."

# game/scripts/c25/c25.rpy:3216
translate brazilian c25s004_GetMad_b9f6f9e6:

    # mc "Buenos días, [mad.nick]. ¿Estás lista para irnos?"
    mc "Bom dia, [mad.nick]. Você está pronto para ir?"

# game/scripts/c25/c25.rpy:3217
translate brazilian c25s004_GetMad_55e1cd45:

    # mad "Aún no, tengo que hacer algunas cosas."
    mad "Ainda não, tenho algumas coisas para fazer."

# game/scripts/c25/c25.rpy:3220
translate brazilian c25s004_GetMad_a268053a:

    # "La preciosa modista te besa apasionadamente. Hace demasiado tiempo que no habéis estado a solas."
    "A bela costureira te beija apaixonadamente. Já faz muito tempo que vocês não ficam a sós."

# game/scripts/c25/c25.rpy:3222
translate brazilian c25s004_GetMad_0b0eee98:

    # mad "*Risita* Una cosa menos que hacer."
    mad "*Risos* Uma coisa a menos para fazer."

# game/scripts/c25/c25.rpy:3225
translate brazilian c25s004_GetMad_ebd3c8be:

    # mad "Estaba a punto de prepararme unos pepinillos con helado de pistacho cuando has llegado, creía que ibas a tardar más. ¿Quieres?"
    mad "Eu estava prestes a preparar uns picles com sorvete de pistache quando você chegou; achei que demoraria mais. Gostaria de um pouco?"

# game/scripts/c25/c25.rpy:3227
translate brazilian c25s004_GetMad_6e76e73d:

    # mc "No sé lo que os ha dado hoy con los pepinillos, pero no, gracias. Suena bastante asqueroso."
    mc "Não sei o que deu em vocês hoje com picles, mas não, obrigada. Parece bem nojento."

# game/scripts/c25/c25.rpy:3229
translate brazilian c25s004_GetMad_95b10980:

    # mc "No, gracias. Suena bastante asqueroso."
    mc "Não, obrigado. Parece bem nojento."

# game/scripts/c25/c25.rpy:3230
translate brazilian c25s004_GetMad_58f9a322:

    # mad "Entonces, dame un momento para prepararle la comida a Zeus y nos podemos ir."
    mad "Então me dê um momento para preparar a comida de Zeus e já podemos ir."

# game/scripts/c25/c25.rpy:3232
translate brazilian c25s004_GetMad_839c0696:

    # mad "Dame un momento para prepararle la comida a Zeus y nos podemos ir."
    mad "Me dê um momento para preparar a comida de Zeus e já podemos ir."

# game/scripts/c25/c25.rpy:3236
translate brazilian c25s004_GetMad_de9248c8:

    # zeu "*¿Miau?* (¿He oído algo sobre comida?)" id c25s004_GetMad_de9248c8
    zeu "*Miau?* (Ouvi algo sobre comida?)" id c25s004_GetMad_de9248c8

# game/scripts/c25/c25.rpy:3238
translate brazilian c25s004_GetMad_6bd709cd:

    # zeu "*¡Miau!* *Miau...* (¡Otra vez tú! Pero esta vez hueles a lata de atún... lata de atún cerrada...)" id c25s004_GetMad_6bd709cd
    zeu "*Miau!* *Miau...* (É você de novo! Mas desta vez você cheira a lata de atum... uma lata de atum lacrada...)" id c25s004_GetMad_6bd709cd

# game/scripts/c25/c25.rpy:3239
translate brazilian c25s004_GetMad_ebcc9aec:

    # mc "Hola, Pequeñajo. ¿Me has echado de menos?"
    mc "Ei, pequenino(a). Sentiu minha falta?"

# game/scripts/c25/c25.rpy:3241
translate brazilian c25s004_GetMad_832eb124:

    # zeu "*¿Miau?* *¡Miau!* (¿Pequeñajo? ¡Para ti, es Lord Simba!)" id c25s004_GetMad_832eb124
    zeu "*Miau?* *Miau!* (Pequenino? Para você, ele é o Senhor Simba!)" id c25s004_GetMad_832eb124

# game/scripts/c25/c25.rpy:3243
translate brazilian c25s004_GetMad_73bdd14d:

    # zeu "*Miau* *Purr* (Pero si me rascas así, puedes llamarme como quieras.)" id c25s004_GetMad_73bdd14d
    zeu "*Miau* *Ronrono* (Mas se você me arranhar assim, pode me chamar do que quiser.)" id c25s004_GetMad_73bdd14d

# game/scripts/c25/c25.rpy:3245
translate brazilian c25s004_GetMad_e0122449:

    # mad "Me encanta ver lo bien que se lleva contigo. *Risa* Más aún teniendo en cuenta que no le traes comida."
    mad "Adoro ver como ele se dá bem com você. *Risos* Principalmente considerando que você não traz comida para ele."

# game/scripts/c25/c25.rpy:3246
translate brazilian c25s004_GetMad_be2a8125:

    # mc "Le he comprado una lata de atún, pero me la he dejado en la camioneta."
    mc "Comprei uma lata de atum para ele, mas deixei na caminhonete."

# game/scripts/c25/c25.rpy:3247
translate brazilian c25s004_GetMad_dbd50b39:

    # mc "Te iba a proponer que lo trajeras a casa, estoy seguro de que a las chicas les va a encantar conocerlo."
    mc "Eu ia sugerir que você o trouxesse para casa; tenho certeza de que as meninas vão adorar conhecê-lo."

# game/scripts/c25/c25.rpy:3249
translate brazilian c25s004_GetMad_2665f6a9:

    # zeu "*Miau* *Purr* (Normal, soy adorable... Especialmente una vez me coma esa lata que has olvidado.)" id c25s004_GetMad_2665f6a9
    zeu "*Miau* *Ronrono* (Normal, eu sou adorável... Principalmente depois de comer aquela lata que você esqueceu.)" id c25s004_GetMad_2665f6a9

# game/scripts/c25/c25.rpy:3251
translate brazilian c25s004_GetMad_0e6853e8:

    # mad "No sé, [mc]. Aunque contigo se lleve bien, no es muy sociable. No sé si arañará a alguna de las chicas."
    mad "Não sei, [mc]. Mesmo que ele se dê bem com você, ele não é muito sociável. Não sei se ele vai dar em cima de alguma das garotas."

# game/scripts/c25/c25.rpy:3252
translate brazilian c25s004_GetMad_c851fea0:

    # mc "Bueno, es tu gato. Tu lo conoces mejor que nadie."
    mc "Bem, é o seu gato. Você o conhece melhor do que ninguém."

# game/scripts/c25/c25.rpy:3254
translate brazilian c25s004_GetMad_0a4d1a18:

    # zeu "*Purr divertido* *¡Miau!* (*Risa* ¡Su gato! Estos humanos son tan graciosos... ¡Mascotas creyéndose los amos!)" id c25s004_GetMad_0a4d1a18
    zeu "*Ronronar (engraçado)* *Miau!* (*Risos* O gato dela! Esses humanos são tão engraçados... Animais de estimação achando que mandam em tudo!)" id c25s004_GetMad_0a4d1a18

# game/scripts/c25/c25.rpy:3255
translate brazilian c25s004_GetMad_3ecd5704:

    # mcp "(¿El gato se ha reido? Deben ser imaginaciones mías...)"
    mcp "(O gato riu? Deve ser coisa da minha cabeça...)"

# game/scripts/c25/c25.rpy:3257
translate brazilian c25s004_GetMad_d68064d0:

    # mad "Zeus, ¿quieres venir a conocer a las chicas? ¿Te vas a portar bien? Seguro que hay comida para ti."
    mad "Zeus, você quer vir conhecer as garotas? Você vai se comportar? Tenho certeza de que haverá comida para você."

# game/scripts/c25/c25.rpy:3258
translate brazilian c25s004_GetMad_e0079f15:

    # mc "*Risa* Le hablas como si te entendiera."
    mc "*Risos* Você fala com ele como se ele te entendesse."

# game/scripts/c25/c25.rpy:3259
translate brazilian c25s004_GetMad_88233d1e:

    # mad "Te sorprenderías de lo mucho que parece entender..."
    mad "Você ficaria surpreso com o quanto ele parece entender..."

# game/scripts/c25/c25.rpy:3261
translate brazilian c25s004_GetMad_dbcaa708:

    # mc "¡Ostias! ¿Dónde ha ido?"
    mc "Meu Deus! Para onde ele foi?"

# game/scripts/c25/c25.rpy:3262
translate brazilian c25s004_GetMad_a465a5d3:

    # mad "*Risa* Te he dicho que te sorprenderías."
    mad "*Risos* Eu te disse que você ficaria surpreso(a)."

# game/scripts/c25/c25.rpy:3264
translate brazilian c25s004_GetMad_70cbe712:

    # zeu "*¿Miau?* (¿Nos podemos ir a conocer a esas chicas que regalan comida?)" id c25s004_GetMad_70cbe712
    zeu "*Miau?* (Podemos ir conhecer aquelas garotas que distribuem comida?)" id c25s004_GetMad_70cbe712

# game/scripts/c25/c25.rpy:3266
translate brazilian c25s004_GetMad_8a261ec7:

    # mad "*Risa* Ya está en la puerta esperando. No hay como decirle que hay comida en algún sitio."
    mad "*Risos* Ele já está esperando na porta. Não adianta dizer para ele que tem comida em algum lugar."

# game/scripts/c25/c25.rpy:3267
translate brazilian c25s004_GetMad_45d1dbca:

    # mad "Dame un momento para que coja el bolso y nos podemos ir. También tengo que coger otra cosa..."
    mad "Só um minutinho para pegar minha bolsa e já podemos ir. Também preciso pegar outra coisa..."

# game/scripts/c25/c25.rpy:3268
translate brazilian c25s004_GetMad_326d9f1b:

    # mc "*Risa* Te espero acariciando a Zeus."
    mc "*Risos* Vou esperar você acariciando Zeus."

# game/scripts/c25/c25.rpy:3270
translate brazilian c25s004_GetMad_b9015529:

    # zeu "*¡Miau!* (¡Sí, caricias para Lord Simba!)" id c25s004_GetMad_b9015529
    zeu "*Miau!* (Sim, carinho para o Senhor Simba!)" id c25s004_GetMad_b9015529

# game/scripts/c25/c25.rpy:3272
translate brazilian c25s004_GetMad_df76e855:

    # "Os ponéis en camino unos minutos después. Zeus se pasa todo el viaje con la cabeza dentro de la bolsa donde está la lata de atún."
    "Você partiu alguns minutos depois. Zeus passou a viagem inteira com a cabeça dentro da sacola onde estava a lata de atum."

# game/scripts/c25/c25.rpy:3274
translate brazilian c25s004_GetMad_8c466a7c:

    # "Por suerte, no sabe abrirla... O es demasiado vago para hacerlo y está esperando que sus sirvientes humanos lo hagan por él."
    "Por sorte, ele não sabe como abri-lo... Ou está com preguiça de fazer isso e espera que seus servos humanos o façam por ele."

# game/scripts/c25/c25.rpy:3331
translate brazilian c25s005_ZeusAtHome_c1e656bf:

    # "Al llegar a casa, vais directos a la cocina de [nor]."
    "Quando você chega em casa, você vai direto para a cozinha de [nor]."

# game/scripts/c25/c25.rpy:3332
translate brazilian c25s005_ZeusAtHome_ef64a4e3:

    # mc "Te dejo los pepinillos que me has pedido en la nevera."
    mc "Coloquei os picles que você pediu na geladeira."

# game/scripts/c25/c25.rpy:3333
translate brazilian c25s005_ZeusAtHome_b1c907a2:

    # nor "Gracias, [mc]."
    nor "Obrigado, [mc]."

# game/scripts/c25/c25.rpy:3334
translate brazilian c25s005_ZeusAtHome_7549b2ae:

    # nor "Hola, [mad.nick]."
    nor "Olá, [mad.nick]."

# game/scripts/c25/c25.rpy:3337
translate brazilian c25s005_ZeusAtHome_9c50a15a:

    # "Al llegar a casa, dejas el pollo que te ha pedido [mar] en la nevera y vais a la cocina de [nor]."
    "Quando você chegar em casa, deixe o frango que [mar] pediu na geladeira e vá para a cozinha de [nor]."

# game/scripts/c25/c25.rpy:3339
translate brazilian c25s005_ZeusAtHome_d6cfd815:

    # "Al llegar a casa, dejas los pepinillos en la nevera, le mandas un mensaje a [whoPickles], y vais a la cocina de [nor]."
    "Quando você chegar em casa, coloque os picles na geladeira, envie uma mensagem para [whoPickles] e vá para a cozinha de [nor]."

# game/scripts/c25/c25.rpy:3340
translate brazilian c25s005_ZeusAtHome_7c234c8f:

    # nor "Hola, [mad.nick]. Hola de nuevo, [mc]."
    nor "Olá, [mad.nick]. Olá novamente, [mc]."

# game/scripts/c25/c25.rpy:3342
translate brazilian c25s005_ZeusAtHome_71b1c336:

    # nor "¿Llevas un gato en la bolsa, [mad.nick]?"
    nor "Você está carregando um gato na sua bolsa, [mad.nick]?"

# game/scripts/c25/c25.rpy:3344
translate brazilian c25s005_ZeusAtHome_57a99d67:

    # mad "Hola, [nor]. *Risa* Sí, es Zeus. Creo que está intentando abrir la lata de atún que [mc] le ha comprado."
    mad "Olá, [nor]. *Risos* Sim, é Zeus. Acho que ele está tentando abrir a lata de atum que [mc] comprou para ele."

# game/scripts/c25/c25.rpy:3345
translate brazilian c25s005_ZeusAtHome_0ca02bc7:

    # mc "Es un pequeño glotón. Te lo ganarás si le das comida."
    mc "Ele é um pequeno glutão. Você o conquistará se o alimentar."

# game/scripts/c25/c25.rpy:3347
translate brazilian c25s005_ZeusAtHome_41f59f42:

    # zeu "*Miau* (¿He oído que esta señora reparte comida?)"
    zeu "*Miau* (Ouvi dizer que essa senhora entrega comida?)"

# game/scripts/c25/c25.rpy:3348
translate brazilian c25s005_ZeusAtHome_3b938227:

    # mc "*Risa* A veces creo que nos entiende. Oye la palabra 'comida' y se olvida de lo que estaba haciendo."
    mc "*Risos* Às vezes acho que ele nos entende. Ele ouve a palavra \"comida\" e esquece o que estava fazendo."

# game/scripts/c25/c25.rpy:3350
translate brazilian c25s005_ZeusAtHome_07ff799a:

    # mad "¿Quieres que lo deje en algún sitio donde no moleste? Está bien educado, y no va a hacer sus cosas en el suelo ni a arañar los muebles."
    mad "Você gostaria que eu o colocasse em algum lugar onde ele não atrapalhasse? Ele se comporta bem e não faz suas necessidades no chão nem arranha os móveis."

# game/scripts/c25/c25.rpy:3352
translate brazilian c25s005_ZeusAtHome_6a2f5e12:

    # nor "Si está bien educado lo puedes dejar suelto. ¿Le puedo dar un trozo de salchicha?"
    nor "Se ele se comportar bem, você pode soltá-lo da coleira. Posso dar um pedaço de linguiça para ele?"

# game/scripts/c25/c25.rpy:3354
translate brazilian c25s005_ZeusAtHome_99acdd36:

    # zeu "*Miau* (Si dices que no, sé dónde duermes. Mi cola puede meterse en tu boca sin que yo pueda, o quiera, hacer nada por evitarlo.)"
    zeu "*Miau* (Se você disser não, eu sei onde você dorme. Meu rabo pode entrar na sua boca e eu não posso, ou não vou, fazer nada para impedir.)"

# game/scripts/c25/c25.rpy:3356
translate brazilian c25s005_ZeusAtHome_fbb3b9ff:

    # mad "Creo que no habrá ningún problema. Come de todo."
    mad "Não acho que haverá qualquer problema. Coma tudo."

# game/scripts/c25/c25.rpy:3357
translate brazilian c25s005_ZeusAtHome_7f2d48c2:

    # mc "*Risa* Además, Zeus tendrá una nueva mejor amiga."
    mc "*Risos* Além disso, Zeus terá um novo melhor amigo."

# game/scripts/c25/c25.rpy:3358
translate brazilian c25s005_ZeusAtHome_8df3ef23:

    # mc "Dame la bolsa, [mad.nick], voy a guardar las cosas en la nevera."
    mc "Me dê a sacola, [mad.nick], vou colocar as coisas na geladeira."

# game/scripts/c25/c25.rpy:3360
translate brazilian c25s005_ZeusAtHome_308493de:

    # "El gato, como siempre, parece entender lo que estáis diciendo y salta ágilmente de la bolsa a la isla de la cocina."
    "O gato, como sempre, parece entender o que você está dizendo e salta agilmente da bolsa para a ilha da cozinha."

# game/scripts/c25/c25.rpy:3361
translate brazilian c25s005_ZeusAtHome_d7055b23:

    # zeu "*Miau* (Tienes mi autorización para alimentarme, humana.)"
    zeu "*Miau* (Você tem minha permissão para me alimentar, humano.)"

# game/scripts/c25/c25.rpy:3363
translate brazilian c25s005_ZeusAtHome_8a4f2de9:

    # mad "¡Zeus! ¡Baja de ahí ahora mismo! Acabo de decirles que estás bien educado."
    mad "Zeus! Desça daí agora mesmo! Acabei de dizer a eles que você é bem-educado."

# game/scripts/c25/c25.rpy:3365
translate brazilian c25s005_ZeusAtHome_f49740ea:

    # zeu "*Miau lastimero* (Pero el tipo feo le ha dicho a la Alimentadora Suprema que si hay comida por en medio me olvido de todo...)"
    zeu "*Miau de pena* (Mas o cara feio disse ao Alimentador Supremo que se houver comida envolvida, eu esqueço tudo...)"

# game/scripts/c25/c25.rpy:3367
translate brazilian c25s005_ZeusAtHome_e98194c3:

    # mad "Zeeeeus..."
    mad "Zeeeeus..."

# game/scripts/c25/c25.rpy:3369
translate brazilian c25s005_ZeusAtHome_0690a050:

    # zeu "*Miaaaau* (Vaaaaale.)"
    zeu "*Miau* (Ok.)"

# game/scripts/c25/c25.rpy:3371
translate brazilian c25s005_ZeusAtHome_ebb7109f:

    # "Baja del mostrador tan ágilmente como ha subido, aunque por alguna razón te parece que lo hace con cara de pena."
    "Ela desce do balcão com a mesma agilidade com que subiu, embora, por algum motivo, pareça que o faz com uma expressão triste."

# game/scripts/c25/c25.rpy:3372
translate brazilian c25s005_ZeusAtHome_94415e2c:

    # "Rodea la isla de la cocina para ir a los pies de [nor]."
    "Dê a volta na ilha da cozinha para chegar aos pés de [nor]."

# game/scripts/c25/c25.rpy:3374
translate brazilian c25s005_ZeusAtHome_4fb1d052:

    # nor "Realmente lo has educado muy bien. Felicidades, [mad.nick]. Siempre he oído que los gatos son más difíciles de educar que los perros."
    nor "Você o treinou muito bem. Parabéns! Sempre ouvi dizer que gatos são mais difíceis de treinar do que cachorros."

# game/scripts/c25/c25.rpy:3375
translate brazilian c25s005_ZeusAtHome_800adf8b:

    # mc "*Risa* A mí siempre me han parecido más listos que los perros."
    mc "*Risos* Sempre achei que eles fossem mais inteligentes que os cachorros."

# game/scripts/c25/c25.rpy:3376
translate brazilian c25s005_ZeusAtHome_eece51dd:

    # mc "Un perro es como un niño pequeño, siempre haciendo ruido, necesitando atención, y emocionándose por todo."
    mc "Um cachorro é como uma criança pequena, sempre fazendo barulho, precisando de atenção e se empolgando com tudo."

# game/scripts/c25/c25.rpy:3377
translate brazilian c25s005_ZeusAtHome_f710df82:

    # mc "Un gato es como un jubilado. *Risa* Se deja alimentar y sólo te presta atención cuando a él le da la gana."
    mc "Um gato é como um aposentado. *Risos* Ele deixa você alimentá-lo e só presta atenção em você quando quer."

# game/scripts/c25/c25.rpy:3379
translate brazilian c25s005_ZeusAtHome_6a8e89aa:

    # zeu "*Miau* (Escuchad a este tío. Sabe de lo que habla.)"
    zeu "*Miau* (Escutem esse cara. Ele sabe do que está falando.)"

# game/scripts/c25/c25.rpy:3380
translate brazilian c25s005_ZeusAtHome_c30791f8:

    # zeu "*Miau?* (¿Dónde está mi salchicha?)" id c25s005_ZeusAtHome_c30791f8
    zeu "*Miau?* (Onde está minha salsicha?)" id c25s005_ZeusAtHome_c30791f8

# game/scripts/c25/c25.rpy:3382
translate brazilian c25s005_ZeusAtHome_5247916e:

    # nor "¿Quieres un trozo de salchicha, chiquitín?"
    nor "Você quer um pedaço de linguiça, pequenino(a)?"

# game/scripts/c25/c25.rpy:3383
translate brazilian c25s005_ZeusAtHome_4917eeff:

    # zeu "*Miau* (¡Sí! ¡Alimenta a tu Señor!)"
    zeu "*Miau* (Sim! Alimente seu Senhor!)"

# game/scripts/c25/c25.rpy:3385
translate brazilian c25s005_ZeusAtHome_903b361d:

    # "La salchicha desaparece en un momento en la boca del felino."
    "A salsicha desaparece num instante na boca do gato."

# game/scripts/c25/c25.rpy:3386
translate brazilian c25s005_ZeusAtHome_bf052574:

    # zeu "*Miau* (He puesto mi sagrada zarpa sobre ti. Ahora eres mía.)"
    zeu "*Miau* (Coloquei minha pata sagrada sobre você. Agora você é meu/minha.)"

# game/scripts/c25/c25.rpy:3388
translate brazilian c25s005_ZeusAtHome_023ef6eb:

    # nor "*Risa* Es super bonito. Y muy simpático."
    nor "*Risos* Ele é super fofo. E muito legal."

# game/scripts/c25/c25.rpy:3389
translate brazilian c25s005_ZeusAtHome_d1866030:

    # mc "*Risa* Mientras le des comida seguirá siendo simpático, no lo dudes."
    mc "*Risos* Enquanto você o alimentar, ele continuará sendo fofo, não duvide."

# game/scripts/c25/c25.rpy:3391
translate brazilian c25s005_ZeusAtHome_766bb000:

    # mad "[mc], ¿podrías enseñarle la casa a Zeus mientras yo ayudo a [nor] con la comida? Sobre todo, enséñale dónde están los lavabos."
    mad "[mc], você poderia mostrar a casa para Zeus enquanto eu ajudo [nor] com a comida? Principalmente mostre a ele onde ficam os banheiros."

# game/scripts/c25/c25.rpy:3392
translate brazilian c25s005_ZeusAtHome_948d1c75:

    # mc "Estás de broma, ¿no?"
    mc "Você está brincando, né?"

# game/scripts/c25/c25.rpy:3393
translate brazilian c25s005_ZeusAtHome_5f5eb2ec:

    # mad "No, le he enseñado a hacer sus cosas en el retrete. Hay que dejar la puerta abierta y la tapa levantada."
    mad "Não, eu o ensinei a fazer as necessidades no banheiro. Você tem que deixar a porta aberta e a tampa levantada."

# game/scripts/c25/c25.rpy:3395
translate brazilian c25s005_ZeusAtHome_f4b4206c:

    # nor "Eso lo he visto en varias películas y en videos de internet. Parece que es algo común. Cada vez más gente vive en apartamentos."
    nor "Já vi isso em vários filmes e vídeos online. Parece ser bastante comum. Cada vez mais pessoas estão morando em apartamentos."

# game/scripts/c25/c25.rpy:3396
translate brazilian c25s005_ZeusAtHome_7b8b0137:

    # mc "Vamos, Zeus. Voy a enseñarte la casa y a presentarte al resto de la familia."
    mc "Vamos lá, Zeus. Vou te mostrar a casa e te apresentar ao resto da família."

# game/scripts/c25/c25.rpy:3398
translate brazilian c25s005_ZeusAtHome_e240b5d7:

    # "Antes de que te dé tiempo de irte con el gato aparecen las dos primeras chicas nuevas. Al menos nuevas para Zeus."
    "Antes que você tenha tempo de ir embora com o gato, as duas primeiras garotas novas aparecem. Pelo menos novas para Zeus."

# game/scripts/c25/c25.rpy:3399
translate brazilian c25s005_ZeusAtHome_b7c47a1e:

    # dap "¿Has traído a Zeus, [mad.nick]?"
    dap "Você trouxe Zeus, [mad.nick]?"

# game/scripts/c25/c25.rpy:3400
translate brazilian c25s005_ZeusAtHome_660e4f31:

    # mad "Sí, [mc] me ha dicho que os gustaría conocerlo."
    mad "Sim, [mc] me disse que você gostaria de conhecê-lo."

# game/scripts/c25/c25.rpy:3401
translate brazilian c25s005_ZeusAtHome_9d2f8ab2:

    # eri "No se ha equivocado. Tanto oír hablar de él, ya tenía ganas de verlo."
    eri "Ele não estava errado. Depois de ouvir falar tanto dele, eu estava ansioso para vê-lo."

# game/scripts/c25/c25.rpy:3403
translate brazilian c25s005_ZeusAtHome_e3998c0a:

    # zeu "*Miau* (Vuestro color de pelo me confunde. Pero ahora sois mías.)"
    zeu "*Miau* (A cor do seu cabelo me confunde. Mas agora você é minha.)"

# game/scripts/c25/c25.rpy:3404
translate brazilian c25s005_ZeusAtHome_8c047715:

    # mad "Creo que le habéis caído bien."
    mad "Acho que ele gostava de você."

# game/scripts/c25/c25.rpy:3406
translate brazilian c25s005_ZeusAtHome_f80ebe80:

    # eri "¡Es precioso!"
    eri "É lindo!"

# game/scripts/c25/c25.rpy:3407
translate brazilian c25s005_ZeusAtHome_c51120b9:

    # dap "¡Y se deja tocar por desconocidos! Me encanta."
    dap "E ela deixa estranhos a tocarem! Adoro isso."

# game/scripts/c25/c25.rpy:3408
translate brazilian c25s005_ZeusAtHome_84ce6875:

    # zeu "*Miau* (Rascad, esclavas, rascad.)"
    zeu "*Miau* (Arranhe, escravos, arranhe.)"

# game/scripts/c25/c25.rpy:3411
translate brazilian c25s005_ZeusAtHome_6c0166bf:

    # dap "Hola, [mc]. Nos tienes que explicar lo que pasó en el barco. [kim] nos ha explicado algo, pero hay partes que no sabe."
    dap "Olá, [mc]. Você precisa explicar o que aconteceu no navio. [kim] explicou algumas coisas, mas há partes que ela não sabe."

# game/scripts/c25/c25.rpy:3412
translate brazilian c25s005_ZeusAtHome_2f307c20:

    # mc "Luego os lo explico."
    mc "Eu explico para você mais tarde."

# game/scripts/c25/c25.rpy:3415
translate brazilian c25s005_ZeusAtHome_3a916b49:

    # eri "Hola, cielo. Antes, durante el yoga, has desaparecido antes de que te saludara."
    eri "Oi, querida. Mais cedo, durante a aula de ioga, você sumiu antes que eu pudesse dizer olá."

# game/scripts/c25/c25.rpy:3416
translate brazilian c25s005_ZeusAtHome_6c43b663:

    # mc "Hola, preciosa."
    mc "Olá, linda."

# game/scripts/c25/c25.rpy:3420
translate brazilian c25s005_ZeusAtHome_ac96826c:

    # zeu "*Miau* (Me confundes. Creía que estabas con mi sirvienta...)"
    zeu "*Miau* (Você está me confundindo. Pensei que você estivesse com a minha empregada...)"

# game/scripts/c25/c25.rpy:3422
translate brazilian c25s005_ZeusAtHome_8dca6ede:

    # zeu "*Miau* (¿Pero también estás con estas dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Mas você também está com essas duas garotas? Você deve ser o equivalente a um garanhão humano!)"

# game/scripts/c25/c25.rpy:3424
translate brazilian c25s005_ZeusAtHome_f1082c23:

    # zeu "*Miau* (¿Pero también esta chica? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Mas essa garota também? Você deve ser o equivalente a um garanhão humano!)"

# game/scripts/c25/c25.rpy:3425
translate brazilian c25s005_ZeusAtHome_9af538dc:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Sim, Zeus, vou te mostrar a casa. Não me apresse."

# game/scripts/c25/c25.rpy:3428
translate brazilian c25s005_ZeusAtHome_4346f707:

    # zeu "*Miau* (¿Estás con las dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Você está com as duas garotas? Você deve ser o equivalente a um garanhão humano!)"

# game/scripts/c25/c25.rpy:3429
translate brazilian c25s005_ZeusAtHome_9af538dc_1:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Sim, Zeus, vou te mostrar a casa. Não me apresse."

# game/scripts/c25/c25.rpy:3430
translate brazilian c25s005_ZeusAtHome_f2dd6715:

    # mc "Os veo luego. Vamos, Zeus."
    mc "Até logo. Vamos lá, Zeus."

# game/scripts/c25/c25.rpy:3432
translate brazilian c25s005_ZeusAtHome_10a86f4b:

    # "La primera parada es la sala de estar, donde están [kat] y [kim]."
    "A primeira parada é a sala de estar, onde estão [kat] e [kim]."

# game/scripts/c25/c25.rpy:3433
translate brazilian c25s005_ZeusAtHome_4c34e75e:

    # mc "Hola, chicas. Traigo visita."
    mc "Oi, meninas. Tenho visitas."

# game/scripts/c25/c25.rpy:3435
translate brazilian c25s005_ZeusAtHome_d625f10a:

    # kim "¡Qué bonito! Supongo que este debe de ser Zeus."
    kim "Que lindo! Suponho que este deva ser Zeus."

# game/scripts/c25/c25.rpy:3436
translate brazilian c25s005_ZeusAtHome_b5e1ca31:

    # zeu "*Miau* (¡Mi fama me precede! Me gustas. Una vez conocí a una gata con la piel como la tuya. Ella era más guapa. Y más peluda.)"
    zeu "*Miau* (Minha reputação me precede! Eu gosto de você. Uma vez conheci uma gata com pelos como o seu. Ela era mais bonita. E mais peluda.)"

# game/scripts/c25/c25.rpy:3438
translate brazilian c25s005_ZeusAtHome_ce9eba37:

    # zeu "*Miau* (Mía.)"
    zeu "*Miau* (Meu.)"

# game/scripts/c25/c25.rpy:3440
translate brazilian c25s005_ZeusAtHome_fc52ad29:

    # kat "¡Es precioso!"
    kat "É lindo!"

# game/scripts/c25/c25.rpy:3441
translate brazilian c25s005_ZeusAtHome_f52acb1f:

    # zeu "*Miau* (Tú también eres mía. Tienes pinta de ser mullida para echarme una siesta encima tuyo. Me entra sueño sólo de pensarlo.)"
    zeu "*Miau* (Você também é meu. Você parece tão fofinho que eu poderia tirar uma soneca em você. Só de pensar nisso já me dá sono.)"

# game/scripts/c25/c25.rpy:3442
translate brazilian c25s005_ZeusAtHome_7f60e2da:

    # mc "Chicas, os tengo que dejar. Voy a seguir enseñándole la casa."
    mc "Meninas, preciso ir. Vou continuar mostrando a casa para ela."

# game/scripts/c25/c25.rpy:3445
translate brazilian c25s005_ZeusAtHome_b2764ae8:

    # kim "Me encanta poder hacer esto ahora."
    kim "Adoro poder fazer isso agora."

# game/scripts/c25/c25.rpy:3446
translate brazilian c25s005_ZeusAtHome_0b02ff88:

    # mc "A mí también, cielo."
    mc "Eu também, querida."

# game/scripts/c25/c25.rpy:3448
translate brazilian c25s005_ZeusAtHome_1456d3b7:

    # kim "Hasta luego, [mc]. ¿Vendrás a la clase de tiro de [eva]?"
    kim "Até logo, [mc]. Você virá à aula de tiro de [eva]?"

# game/scripts/c25/c25.rpy:3449
translate brazilian c25s005_ZeusAtHome_ab5ca70d:

    # mc "No, tuve suficiente con la de ayer y tengo algunas cosas que hacer."
    mc "Não, já chega de ontem e tenho algumas coisas para fazer."

# game/scripts/c25/c25.rpy:3450
translate brazilian c25s005_ZeusAtHome_6e024dc1:

    # kat "Bueno, entonces seremos solo chicas y armas."
    kat "Ok, então serão apenas garotas e armas."

# game/scripts/c25/c25.rpy:3452
translate brazilian c25s005_ZeusAtHome_c36c1d98:

    # "La siguiente parada es el baño de la planta baja, dónde nada más levantar la tapa del retrete, Zeus se sube a él."
    "A próxima parada é o banheiro do andar de baixo, onde, assim que a tampa do vaso sanitário é levantada, Zeus sobe em cima dela."

# game/scripts/c25/c25.rpy:3453
translate brazilian c25s005_ZeusAtHome_89fd84b0:

    # zeu "*¿Miau?* (¿Vas a quedarte ahí mirando?)" id c25s005_ZeusAtHome_89fd84b0
    zeu "*Miau?* (Você vai ficar aí parado olhando?)" id c25s005_ZeusAtHome_89fd84b0

# game/scripts/c25/c25.rpy:3454
translate brazilian c25s005_ZeusAtHome_09c64d23:

    # "Por alguna razón te sientes raro mirando cómo el gato hace sus cosas."
    "Por algum motivo, você se sente estranho observando o gato fazer o que está fazendo."

# game/scripts/c25/c25.rpy:3456
translate brazilian c25s005_ZeusAtHome_a98c077a:

    # "Te giras hasta que acaba, para darle un poco de intimidad. No tienes ni idea de si los gatos necesitan intimidad."
    "Você se afasta até que tudo acabe, para dar um pouco de privacidade ao animal. Você não tem ideia se os gatos precisam de privacidade."

# game/scripts/c25/c25.rpy:3457
translate brazilian c25s005_ZeusAtHome_758c4ae1:

    # "No sabe tirar de la cadena en este retrete y lo haces tú."
    "Ele não sabe como dar descarga nesse vaso sanitário, então você está fazendo isso por ele."

# game/scripts/c25/c25.rpy:3459
translate brazilian c25s005_ZeusAtHome_36109bc7:

    # "Al llegar a la habitación de [dap]..."
    "Ao chegar ao quarto de [dap]..."

# game/scripts/c25/c25.rpy:3460
translate brazilian c25s005_ZeusAtHome_daabbe21:

    # sca "Mira que gracioso. Ha ido en seguida a ver el cuadro que [mad.nick] hizo de él."
    sca "Que engraçado. Ele foi direto ver a pintura que [mad.nick] fez dele."

# game/scripts/c25/c25.rpy:3461
translate brazilian c25s005_ZeusAtHome_b8eb4aca:

    # zeu "*Miau* (Mia. Te nombro Protectora del Sagrado Retrato del Gato Inteligente.)"
    zeu "*Miau* (Miau. Eu te nomeio Protetor do Retrato Sagrado do Gato Inteligente.)"

# game/scripts/c25/c25.rpy:3462
translate brazilian c25s005_ZeusAtHome_43b6b919:

    # sca "De pequeña quería tener un gato, pero mi madre no me hubiera dejado nunca."
    sca "Quando criança, eu queria ter um gato, mas minha mãe nunca teria deixado."

# game/scripts/c25/c25.rpy:3463
translate brazilian c25s005_ZeusAtHome_13721b2f:

    # zeu "*¿Miau?* *Miau* (¿Tener? Voy a tener que educarte. Está claro quién es el inteligente aquí.)" id c25s005_ZeusAtHome_13721b2f
    zeu "*Miau?* *Miau* (Tem? Vou ter que te explicar. Está claro quem é o esperto aqui.)" id c25s005_ZeusAtHome_13721b2f

# game/scripts/c25/c25.rpy:3466
translate brazilian c25s005_ZeusAtHome_f12d5351:

    # mc "Le podemos preguntar a [nor] si te dejaría tener uno."
    mc "Podemos perguntar a [nor] se ele deixaria você ficar com um."

# game/scripts/c25/c25.rpy:3467
translate brazilian c25s005_ZeusAtHome_386cbb86:

    # sca "No hace falta. Creo que Zeus va a venir mucho por casa."
    sca "Não precisa. Acho que Zeus vai passar bastante tempo em casa."

# game/scripts/c25/c25.rpy:3468
translate brazilian c25s005_ZeusAtHome_4ff0b71f:

    # zeu "*Miau* (Depende. De momento sólo me han dado un trozo de salchicha.)"
    zeu "*Miau* (Depende. Agora mesmo eles só me deram um pedaço de linguiça.)"

# game/scripts/c25/c25.rpy:3470
translate brazilian c25s005_ZeusAtHome_ee3410c3:

    # "Salta del armario y sube con curiosidad al regazo de [oma]."
    "Ela salta do armário e, curiosa, sobe no colo de [oma]."

# game/scripts/c25/c25.rpy:3471
translate brazilian c25s005_ZeusAtHome_c19e3ac0:

    # zeu "*Miau* (Por alguna razón huelo a algo peludo aquí, pero esta chica está perfectamente depilada. Bueno, ahora es mía.)"
    zeu "*Miau* (Por algum motivo, estou sentindo cheiro de pelo aqui, mas essa garota é completamente sem pelos. Bom, ela é minha agora.)"

# game/scripts/c25/c25.rpy:3472
translate brazilian c25s005_ZeusAtHome_e7bf0abd:

    # oma "Parece que tiene curiosidad por mí. *Risa* Los cachorros son tan monos..."
    oma "Ele parece curioso a meu respeito. *Risos* Filhotes são tão fofos..."

# game/scripts/c25/c25.rpy:3473
translate brazilian c25s005_ZeusAtHome_c3c3ec4e:

    # mc "*Risa* Creo que le atraen las novedades. Vamos, Zeus. Te tengo que acabar de enseñar la casa."
    mc "*Risos* Acho que ele se interessa por coisas novas. Vamos lá, Zeus. Ainda preciso te mostrar a casa."

# game/scripts/c25/c25.rpy:3475
translate brazilian c25s005_ZeusAtHome_d89e55e2:

    # "Cuando os cruzáis con [bet] en la planta superior..."
    "Quando você se deparar com [bet] no andar superior..."

# game/scripts/c25/c25.rpy:3476
translate brazilian c25s005_ZeusAtHome_09e3044b:

    # zeu "*Bufido* (No me caes bien. Me parece que eres una rival por la comida.)"
    zeu "*Bufa* (Não gosto de você. Acho que você é um rival na disputa por comida.)"

# game/scripts/c25/c25.rpy:3478
translate brazilian c25s005_ZeusAtHome_0058df62:

    # bet "Parece que no le gusto."
    bet "Parece que ele não gosta de mim."

# game/scripts/c25/c25.rpy:3479
translate brazilian c25s005_ZeusAtHome_a6206542:

    # mc "Es extraño. Eres la primera con la que reacciona así."
    mc "É estranho. Você é a primeira pessoa com quem ele reagiu assim."

# game/scripts/c25/c25.rpy:3480
translate brazilian c25s005_ZeusAtHome_8082c2f6:

    # mc "A lo mejor ya está cansado de pasear por toda la casa."
    mc "Talvez ele já esteja cansado de ficar perambulando pela casa toda."

# game/scripts/c25/c25.rpy:3482
translate brazilian c25s005_ZeusAtHome_46078c94:

    # bet "Puedo llevármelo a la cocina y darle algo de comer si quieres."
    bet "Posso levá-lo até a cozinha e dar-lhe algo para comer, se você quiser."

# game/scripts/c25/c25.rpy:3483
translate brazilian c25s005_ZeusAtHome_77fa34b1:

    # mc "*Risa* Creo que eso le va a hacer muy feliz."
    mc "*Risos* Acho que isso a deixará muito feliz."

# game/scripts/c25/c25.rpy:3485
translate brazilian c25s005_ZeusAtHome_fc660de9:

    # zeu "*Miau* (La había juzgado mal. Alguien como ella seguro que sabe dónde está la mejor comida. Ahora es mía.)"
    zeu "*Miau* (Eu a julguei mal. Alguém como ela certamente sabe onde está a melhor comida. Agora ela é minha.)"

# game/scripts/c25/c25.rpy:3486
translate brazilian c25s005_ZeusAtHome_9a7a48ca:

    # mc "*Risa* Creo que ya es tu amigo."
    mc "*Risos* Acho que ele é seu amigo agora."

# game/scripts/c25/c25.rpy:3487
translate brazilian c25s005_ZeusAtHome_230baf06:

    # bet "*Risa* Sí. Los gatos son tan básicos..."
    bet "*Risos* Sim. Gatos são tão básicos..."

# game/scripts/c25/c25.rpy:3489
translate brazilian c25s005_ZeusAtHome_6115ac07:

    # "Durante la comida, Zeus hace nuevas amigas."
    "Durante a refeição, Zeus faz novos amigos."

# game/scripts/c25/c25.rpy:3491
translate brazilian c25s005_ZeusAtHome_d229ff39:

    # "Todas quieren darle de comer algo."
    "Todos querem lhe dar algo para comer."

# game/scripts/c25/c25.rpy:3493
translate brazilian c25s005_ZeusAtHome_fb055bc9:

    # "[mad.nick] da por perdida la batalla por que no se suba a los muebles. El resto de las chicas lo están empezando a malcriar."
    "[mad.nick] considera a batalha perdida porque a impede de subir nos móveis. As outras meninas estão começando a mimá-la."

# game/scripts/c25/c25.rpy:3494
translate brazilian c25s005_ZeusAtHome_0c3fbf91:

    # "Al menos está lo suficientemente bien educado como para no coger la comida directamente de los platos."
    "Ao menos ele tem a educação de não pegar comida diretamente dos pratos."

# game/scripts/c25/c25.rpy:3495
translate brazilian c25s005_ZeusAtHome_773d5a9c:

    # "O es lo suficientemente vago como para esperar a que se la den."
    "Ou ele é preguiçoso o suficiente para esperar que lhe deem."

# game/scripts/c25/c25.rpy:3497
translate brazilian c25s005_ZeusAtHome_b419ad78:

    # "Al único que no se acerca es a Jamaal. De todas formas ninguno de los dos iba a compartir su comida con el otro."
    "O único a quem ele não se aproxima é Jamaal. De qualquer forma, nenhum dos dois iria dividir a comida com o outro."

# game/scripts/c25/c25.rpy:3499
translate brazilian c25s005_ZeusAtHome_e5f1f834:

    # "Supones que, si los gatos tienen un calendario, Zeus estará deseando que lleguen los domingos a partir de ahora."
    "Você imagina que, se os gatos têm um calendário, Zeus estará ansioso pelos domingos a partir de agora."

# game/scripts/c25/c25.rpy:3501
translate brazilian c25s005_ZeusAtHome_f3d76e69:

    # "Al acabar de comer..."
    "Após terminar de comer..."

# game/scripts/c25/c25.rpy:3502
translate brazilian c25s005_ZeusAtHome_207aa8fa:

    # mad "Chicas, creo que es el momento de darle nuestro regalo a [mc]. Ha llegado esta mañana."
    mad "Meninas, acho que está na hora de entregarmos o nosso presente. Ele chegou esta manhã."

# game/scripts/c25/c25.rpy:3503
translate brazilian c25s005_ZeusAtHome_34bc92a6:

    # mc "¿Un regalo? ¿Para mí?"
    mc "Um presente? Para mim?"

# game/scripts/c25/c25.rpy:3505
translate brazilian c25s005_ZeusAtHome_cbca8d35:

    # mad "Es una tontería que les propuse a algunas de las chicas el viernes y les pareció una buena idea."
    mad "É uma ideia boba que sugeri a algumas das meninas na sexta-feira, e elas acharam uma boa ideia."

# game/scripts/c25/c25.rpy:3506
translate brazilian c25s005_ZeusAtHome_fd0be7c6:

    # mad "La he mandado a imprimir y me la han entregado poco antes de que llegaras a mi apartamento."
    mad "Mandei imprimir e me foi entregue pouco antes de você chegar ao meu apartamento."

# game/scripts/c25/c25.rpy:3507
translate brazilian c25s005_ZeusAtHome_d41497fe:

    # mc "Pero no es mi cumpleaños ni nada por el estilo..."
    mc "Mas não é meu aniversário nem nada parecido..."

# game/scripts/c25/c25.rpy:3509
translate brazilian c25s005_ZeusAtHome_d5efef94:

    # nor "Pero te lo mereces más ahora que si lo fuese."
    nor "Mas você merece isso agora mais do que mereceria se já não existisse."

# game/scripts/c25/c25.rpy:3510
translate brazilian c25s005_ZeusAtHome_aa82bc75:

    # bet "Estoy de acuerdo con [nor]. Ha sido una gran idea por parte de [mad.nick]."
    bet "Concordo com [nor]. Foi uma ótima ideia de [mad.nick]."

# game/scripts/c25/c25.rpy:3511
translate brazilian c25s005_ZeusAtHome_e9575096:

    # mc "Dame ese paquete, [mad.nick]." id c25s005_ZeusAtHome_e9575096
    mc "Dê-me esse pacote, [mad.nick]." id c25s005_ZeusAtHome_e9575096

# game/scripts/c25/c25.rpy:3513
translate brazilian c25s005_ZeusAtHome_87a29028:

    # mc "¡Oh! ¿Una camiseta?"
    mc "Ah! Uma camiseta?"

# game/scripts/c25/c25.rpy:3514
translate brazilian c25s005_ZeusAtHome_02f708a9:

    # mc "*Risa* ¿A quién se le ha ocurrido la frase?"
    mc "*Risos* Quem inventou essa expressão?"

# game/scripts/c25/c25.rpy:3515
translate brazilian c25s005_ZeusAtHome_fce971d3:

    # eri "Fue cosa de [mad.nick]. Nos pareció muy graciosa."
    eri "Foi ideia do [mad.nick]. Achamos hilário."

# game/scripts/c25/c25.rpy:3516
translate brazilian c25s005_ZeusAtHome_3091e53e:

    # dap "Póntela. Queremos ver cómo te queda."
    dap "Vista-o. Queremos ver como fica em você."

# game/scripts/c25/c25.rpy:3518
translate brazilian c25s005_ZeusAtHome_21b666b0:

    # mc "*Risa* ¡Me encanta!"
    mc "*Risos* Adorei!"

# game/scripts/c25/c25.rpy:3519
translate brazilian c25s005_ZeusAtHome_7e8ba433:

    # mc "'Desafié a la Iglesia y lo único que conseguí fue esta camiseta y un finiquito para mi tía.'"
    mc "\"Desafiei a Igreja e tudo o que ganhei foi esta camiseta e uma indenização para minha tia.\""

# game/scripts/c25/c25.rpy:3520
translate brazilian c25s005_ZeusAtHome_3b3c29dd:

    # mc "Bien hecho, [mad.nick]. Y gracias a todas."
    mc "Muito bem, [mad.nick]. E obrigado a todos."

# game/scripts/c25/c25.rpy:3522
translate brazilian c25s005_ZeusAtHome_b551a62a:

    # todas "*Risa* No hay de qué."
    todas "*Risos* De nada."

# game/scripts/c25/c25.rpy:3523
translate brazilian c25s005_ZeusAtHome_9e8be2bd:

    # lis "[mad.nick] es una artista con buenas ideas."
    lis "[mad.nick] é um artista com boas ideias."

# game/scripts/c25/c25.rpy:3524
translate brazilian c25s005_ZeusAtHome_8a5e80eb:

    # mad "Chicas... me vais a hacer ruborizar."
    mad "Meninas... vocês vão me fazer corar."

# game/scripts/c25/c25.rpy:3526
translate brazilian c25s005_ZeusAtHome_396433db:

    # "Después de unas cuantas risas y de que todos consigáis que [mad.nick] se ruborice, vas a tu habitación."
    "Depois de algumas risadas e depois de todos vocês conseguirem fazer [mad.nick] corar, você vai para o seu quarto."

# game/scripts/c25/c25.rpy:3527
translate brazilian c25s005_ZeusAtHome_7336d122:

    # "Zeus vuelve a ser el centro de atención después de la pequeña interrupción por la camiseta."
    "Zeus volta a ser o centro das atenções após a breve interrupção causada pela camiseta."

# game/scripts/c25/c25.rpy:3529
translate brazilian c25s005_ZeusAtHome_83af6113:

    # "Ir a comprar los pepinillos no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Ir comprar os picles não lhe permitiu terminar o que estava fazendo com as contas do Quarto."

# game/scripts/c25/c25.rpy:3531
translate brazilian c25s005_ZeusAtHome_ed8271c6:

    # "Ir a comprar el pollo no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Ir comprar o frango não te permitiu terminar o que estavas fazendo com as contas do quarto."

# game/scripts/c25/c25.rpy:3533
translate brazilian c25s005_ZeusAtHome_a42c4d50:

    # "[nor] te dice que el helado no está listo todavía. Prepararlo con la leche de [mee] ha sido más lento de lo esperado."
    "[nor] indica que o sorvete ainda não está pronto. O preparo com o leite de [mee] levou mais tempo do que o esperado."

# game/scripts/c25/c25.rpy:3548
translate brazilian c25s006_AmaCuddle_aeca0d27:

    # "Al cabo de un rato..."
    "Depois de um tempo..."

# game/scripts/c25/c25.rpy:3550
translate brazilian c25s006_AmaCuddle_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c25/c25.rpy:3552
translate brazilian c25s006_AmaCuddle_46915100:

    # ama "*A través de la puerta* Soy yo, ¿puedo pasar?"
    ama "*Pela porta* Sou eu, posso entrar?"

# game/scripts/c25/c25.rpy:3553
translate brazilian c25s006_AmaCuddle_4d601f0e:

    # mc "Sí, pasa."
    mc "Sim, acontece."

# game/scripts/c25/c25.rpy:3555
translate brazilian c25s006_AmaCuddle_d9f612d1:

    # mc "¿Te has cansado ya del gato?"
    mc "Você já se cansou do gato?"

# game/scripts/c25/c25.rpy:3556
translate brazilian c25s006_AmaCuddle_730c3bf8:

    # ama "*Risa* No, pero están todas ocupadas con él, con lo que sabía que estarías solo."
    ama "*Risos* Não, mas eles estão todos ocupados com ele, então eu sabia que você ficaria sozinho."

# game/scripts/c25/c25.rpy:3557
translate brazilian c25s006_AmaCuddle_98dd9003:

    # mc "¿Quieres hablar de algo?"
    mc "Você quer conversar sobre alguma coisa?"

# game/scripts/c25/c25.rpy:3560
translate brazilian c25s006_AmaCuddle_8e4413bb:

    # ama "Bueno, quería besarte. *Risita*"
    ama "Bem, eu queria te dar um beijo. *Risos*"

# game/scripts/c25/c25.rpy:3561
translate brazilian c25s006_AmaCuddle_fb98d4e8:

    # mc "Me parece una buena forma de empezar."
    mc "Acho que é uma boa maneira de começar."

# game/scripts/c25/c25.rpy:3563
translate brazilian c25s006_AmaCuddle_4c1488fc:

    # ama "Y quería darte las gracias por lo que hiciste ayer en el barco."
    ama "E eu queria agradecer pelo que você fez ontem no barco."

# game/scripts/c25/c25.rpy:3566
translate brazilian c25s006_AmaCuddle_611a8c6e:

    # ama "Quería darte las gracias por lo que hiciste ayer en el barco."
    ama "Gostaria de agradecer pelo que você fez ontem no barco."

# game/scripts/c25/c25.rpy:3567
translate brazilian c25s006_AmaCuddle_f6d18e4d:

    # mc "Es lo menos que podía hacer. Me pasé la mitad del tiempo que estuve allí queriendo darle un puñetazo en la cara a Ichigo."
    mc "Era o mínimo que eu podia fazer. Passei metade do tempo que estive lá com vontade de dar um soco na cara do Ichigo."

# game/scripts/c25/c25.rpy:3569
translate brazilian c25s006_AmaCuddle_f437c1d3:

    # ama "Siempre tienes que sacar el caballero de brillante armadura, ¿no?"
    ama "Você sempre tem que trazer o cavaleiro de armadura brilhante, não é?"

# game/scripts/c25/c25.rpy:3571
translate brazilian c25s006_AmaCuddle_b64f279c:

    # mc "Anoche lo retuve bastante. Lo que me extraña es que Alejandra nos apoyara."
    mc "Eu o contive bastante ontem à noite. O que me surpreende é que Alejandra nos apoiou."

# game/scripts/c25/c25.rpy:3573
translate brazilian c25s006_AmaCuddle_91ba4451:

    # mc "Anoche lo retuve bastante. Fuiste tú quien intervino con lo de [kim] cuando yo me quedé paralizado. Lo que me extraña es que Alejandra nos apoyara."
    mc "Eu me contive bastante ontem à noite. Foi você quem interveio com a coisa do [kim] quando eu travei. O que me surpreende é que Alejandra nos apoiou."

# game/scripts/c25/c25.rpy:3575
translate brazilian c25s006_AmaCuddle_0c8268ed:

    # ama "Alejandra estaba allí por negocios. Por suficiente dinero, o en su caso cuando no hay otra opción, se puede aceptar cualquier insulto."
    ama "Alejandra estava lá a negócios. Por dinheiro suficiente, ou no caso dela, quando não há outra opção, qualquer insulto pode ser aceito."

# game/scripts/c25/c25.rpy:3577
translate brazilian c25s006_AmaCuddle_dde97603:

    # ama "Y fue tu discurso junto con el apoyo de Alejandra lo que me permitió sacar a [kim] de allí."
    ama "E foi o seu discurso, juntamente com o apoio de Alejandra, que me permitiu sair de lá."

# game/scripts/c25/c25.rpy:3578
translate brazilian c25s006_AmaCuddle_a54cb1f4:

    # ama "De todas formas, que no reaccionaras tan rápido como yo, no significa que no lo fueras a hacer. O eso quiero pensar."
    ama "De qualquer forma, só porque você não reagiu tão rápido quanto eu não significa que você não fosse reagir. Ou pelo menos é o que eu quero acreditar."

# game/scripts/c25/c25.rpy:3579
translate brazilian c25s006_AmaCuddle_a70383bf:

    # mc "¿Dónde vas? ¿Se ha acabado el abrazo?"
    mc "Para onde você vai? O abraço acabou?"

# game/scripts/c25/c25.rpy:3581
translate brazilian c25s006_AmaCuddle_e75ae730:

    # ama "No, pero quiero quitarme las botas para continuarlo en la cama, si no te importa."
    ama "Não, mas quero tirar minhas botas para que possamos continuar na cama, se você não se importar."

# game/scripts/c25/c25.rpy:3582
translate brazilian c25s006_AmaCuddle_f26db8d2:

    # mc "*Risa* No me importa."
    mc "*Risos* Não me importo."

# game/scripts/c25/c25.rpy:3584
translate brazilian c25s006_AmaCuddle_dc888c21:

    # mc "¿Sólo las botas?"
    mc "Só as botas?"

# game/scripts/c25/c25.rpy:3586
translate brazilian c25s006_AmaCuddle_2018f5e4:

    # ama "*Risa* Sí, sólo las botas. No estás pensando que tengo segundas intenciones, ¿verdad? Tan solo quiero un abrazo muy largo."
    ama "*Risos* Sim, só as botas. Você não está pensando que eu tenho segundas intenções, está? Eu só quero um abraço bem longo."

# game/scripts/c25/c25.rpy:3588
translate brazilian c25s006_AmaCuddle_c8c9b586:

    # ama "Y si cae algún beso no voy a decir que no, pero ya está."
    ama "E se rolar um beijo, eu não vou dizer não, mas é só isso."

# game/scripts/c25/c25.rpy:3589
translate brazilian c25s006_AmaCuddle_d8b96890:

    # mc "Abrazos y besos me sirve."
    mc "Abraços e beijos resolvem o problema."

# game/scripts/c25/c25.rpy:3591
translate brazilian c25s006_AmaCuddle_76bee679:

    # ama "¿Vienes?"
    ama "Você vem?"

# game/scripts/c25/c25.rpy:3592
translate brazilian c25s006_AmaCuddle_617dfb78:

    # mc "Déjame quitarme las zapatillas."
    mc "Deixe-me tirar meus sapatos."

# game/scripts/c25/c25.rpy:3594
translate brazilian c25s006_AmaCuddle_2a766e47:

    # ama "Se está bien aquí."
    ama "É um lugar agradável."

# game/scripts/c25/c25.rpy:3595
translate brazilian c25s006_AmaCuddle_faafae77:

    # mc "¿Pasa algo, [ama]? Hoy estás más dulce de lo normal. No es que tenga ninguna queja, pero..."
    mc "Tem algo errado, [ama]? Você está mais doce que o normal hoje. Não que eu tenha alguma reclamação, mas..."

# game/scripts/c25/c25.rpy:3597
translate brazilian c25s006_AmaCuddle_69801c5e:

    # mc "¿Tiene algo que ver que ayer tuviera la cita-entrenamiento con [eva]?"
    mc "Tem alguma coisa a ver com o fato de eu ter tido a sessão de treinamento com [eva] ontem?"

# game/scripts/c25/c25.rpy:3599
translate brazilian c25s006_AmaCuddle_ba8a0e6b:

    # ama "No, me he alegrado mucho por ella. Por vosotros dos. Cuando llegué a la base, estaba exultante."
    ama "Não, fiquei muito feliz por ela. Por vocês dois. Quando cheguei à base, estava radiante."

# game/scripts/c25/c25.rpy:3600
translate brazilian c25s006_AmaCuddle_254f81c9:

    # ama "*Risa* Y si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Risos* E se você tiver alguma reclamação porque estou me sentindo mais doce hoje, você terá que aturar."

# game/scripts/c25/c25.rpy:3603
translate brazilian c25s006_AmaCuddle_76520bf3:

    # ama "*Risa* Si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Risos* Se você tiver alguma reclamação porque estou me sentindo mais doce hoje, você terá que aturar."

# game/scripts/c25/c25.rpy:3605
translate brazilian c25s006_AmaCuddle_0562a6f7:

    # ama "Tan solo quiero pasar un rato a solas con mi novio, sin hacer nada. No hemos tenido mucho tiempo desde... aquel beso. Siempre estamos hablando de trabajo."
    ama "Só quero passar um tempo a sós com meu namorado, sem fazer nada. Não temos tido muito tempo juntos desde... aquele beijo. Estamos sempre falando de trabalho."

# game/scripts/c25/c25.rpy:3607
translate brazilian c25s006_AmaCuddle_2275ad91:

    # ama "Tan solo quiero pasar un rato a solas con mi hermano, sin hacer nada. No hemos tenido muchas oportunidades de pasar tiempo juntos si no era por trabajo."
    ama "Só quero passar um tempo a sós com meu irmão, sem fazer nada. Não temos tido muitas oportunidades de ficar juntos, a não ser por causa do trabalho."

# game/scripts/c25/c25.rpy:3608
translate brazilian c25s006_AmaCuddle_7f377dcb:

    # mc "Un día tenemos que ir tú y yo a comer, o a cenar. Nada en plan cita. Sólo tú y yo pasando un rato juntos."
    mc "Um dia desses a gente devia sair para almoçar ou jantar, só nós dois. Nada como um encontro. Só nós dois passando um tempo juntos."

# game/scripts/c25/c25.rpy:3610
translate brazilian c25s006_AmaCuddle_b19eddd6:

    # mc "Tenemos que tener tú y yo también una cita algún día."
    mc "Precisamos marcar um encontro qualquer dia desses, você e eu."

# game/scripts/c25/c25.rpy:3612
translate brazilian c25s006_AmaCuddle_33be946b:

    # ama "Estaría bien, pero vas a estar muy ocupado antes de que vayamos a Aruba. Una vez allí te llevaré a mi restaurante favorito."
    ama "Seria ótimo, mas você estará muito ocupado antes de irmos para Aruba. Quando chegarmos lá, levarei você ao meu restaurante favorito."

# game/scripts/c25/c25.rpy:3613
translate brazilian c25s006_AmaCuddle_019feb62:

    # mc "¿Vendrás tú conmigo? ¿[eva] se quedará aquí protegiendo a la familia?"
    mc "Você virá comigo? Você ficará aqui protegendo a família?"

# game/scripts/c25/c25.rpy:3615
translate brazilian c25s006_AmaCuddle_615741e7:

    # ama "Aún no está preparada para ver a Gavin. Aún está muy afectada por lo que pasó, con que perdiera el brazo. Estaré yo contigo el primer mes."
    ama "Ela ainda não está pronta para ver o Gavin. Ela ainda está muito chateada com o que aconteceu, com a perda do braço. Estarei com você durante o primeiro mês."

# game/scripts/c25/c25.rpy:3616
translate brazilian c25s006_AmaCuddle_a02ed068:

    # ama "Después iremos rotando, un mes cada una allí mientras la otra está aquí."
    ama "Então vamos nos revezar, um de nós fica lá por um mês enquanto o outro fica aqui."

# game/scripts/c25/c25.rpy:3617
translate brazilian c25s006_AmaCuddle_36a0b53c:

    # mc "Me parece una buena idea. ¿Estará preparada dentro de un mes?"
    mc "Parece uma boa ideia. Estará pronto em um mês?"

# game/scripts/c25/c25.rpy:3620
translate brazilian c25s006_AmaCuddle_4fc1e6b9:

    # ama "Eso espero. No tengo ganas de estar lejos de las chicas más de ese tiempo."
    ama "Espero que sim. Não quero ficar longe das meninas por mais tempo do que isso."

# game/scripts/c25/c25.rpy:3622
translate brazilian c25s006_AmaCuddle_f4f04ed7:

    # ama "Eso espero. Se va a tener que enfrentar a ese tema tarde o temprano."
    ama "Espero que sim. Ele terá que enfrentar essa questão mais cedo ou mais tarde."

# game/scripts/c25/c25.rpy:3624
translate brazilian c25s006_AmaCuddle_642c555e:

    # ama "Y, después de lo de ayer, dudo que ella quiera estar lejos de ti más de un mes."
    ama "E, depois do que aconteceu ontem, duvido que ela queira ficar longe de você por mais de um mês."

# game/scripts/c25/c25.rpy:3625
translate brazilian c25s006_AmaCuddle_855b4530:

    # mc "¿Cómo te sientes tú por tener que volver a Aruba?"
    mc "Como você se sente em relação a ter que retornar a Aruba?"

# game/scripts/c25/c25.rpy:3627
translate brazilian c25s006_AmaCuddle_3d1a5af3:

    # ama "Tengo sentimientos conflictivos. Quiero enseñarte dónde crecimos, pero hay sitios que me traerán recuerdos tristes."
    ama "Tenho sentimentos contraditórios. Quero mostrar-te onde crescemos, mas há lugares que me trarão lembranças tristes."

# game/scripts/c25/c25.rpy:3628
translate brazilian c25s006_AmaCuddle_d56b9c53:

    # mc "Lo entiendo."
    mc "Eu entendo."

# game/scripts/c25/c25.rpy:3630
translate brazilian c25s006_AmaCuddle_973951c8:

    # ama "Y descubrirás una parte... monstruosa de mí."
    ama "E você descobrirá uma parte monstruosa de mim."

# game/scripts/c25/c25.rpy:3631
translate brazilian c25s006_AmaCuddle_85c68686:

    # mc "No creo que haya ninguna parte monstruosa en ti, [ama]. Te obligaron a hacer cosas monstruosas, pero no eres un monstruo."
    mc "Não acho que haja nada de monstruoso em você, [ama]. Você foi forçado a fazer coisas monstruosas, mas você não é um monstro."

# game/scripts/c25/c25.rpy:3633
translate brazilian c25s006_AmaCuddle_e5fd6cf2:

    # ama "No me refiero a eso. Te enseñaré mi posesión más preciada, y a lo mejor entonces piensas que estoy mal de la cabeza."
    ama "Não é isso que eu quero dizer. Vou te mostrar meu bem mais precioso, e aí você provavelmente vai achar que eu sou louco."

# game/scripts/c25/c25.rpy:3634
translate brazilian c25s006_AmaCuddle_f5b226b8:

    # mc "¿Qué es?"
    mc "O que é?"

# game/scripts/c25/c25.rpy:3636
translate brazilian c25s006_AmaCuddle_f3609450:

    # ama "No sé si decírtelo... no me corresponde sólo a mí."
    ama "Não sei se devo te contar... não depende só de mim."

# game/scripts/c25/c25.rpy:3637
translate brazilian c25s006_AmaCuddle_811f780f:

    # mc "No te preocupes. Ya llegará el momento de hacerlo."
    mc "Não se preocupe. A hora vai chegar."

# game/scripts/c25/c25.rpy:3638
translate brazilian c25s006_AmaCuddle_321ec4e6:

    # ama "Gracias..."
    ama "Obrigado..."

# game/scripts/c25/c25.rpy:3639
translate brazilian c25s006_AmaCuddle_30e9b407:

    # mc "Como supongo que tiene que ver con [eva], ¿le has dicho que me lo enseñarás cuando estemos allí?"
    mc "Já que presumo que tenha algo a ver com [eva], você disse a ele que me mostraria quando chegássemos lá?"

# game/scripts/c25/c25.rpy:3641
translate brazilian c25s006_AmaCuddle_a860af8f:

    # ama "No, aún no... Me da un poco de miedo decírselo."
    ama "Não, ainda não... Estou com um pouco de medo de contar para ele."

# game/scripts/c25/c25.rpy:3642
translate brazilian c25s006_AmaCuddle_f777227d:

    # mc "No le des más vueltas. Si es una cosa vuestra, obviamente me gustaría saberlo, pero habrá tiempo, siempre y cuando [eva] acepte contármelo."
    mc "Não pense demais nisso. Se for algo entre vocês dois, obviamente eu gostaria de saber, mas haverá tempo, contanto que [eva] concorde em me contar."

# game/scripts/c25/c25.rpy:3643
translate brazilian c25s006_AmaCuddle_87cc63f9:

    # ama "Gracias. Para nosotras es muy especial. Para otras personas sería algo... macabro."
    ama "Obrigado. É muito especial para nós. Para outras pessoas, pode ser... macabro."

# game/scripts/c25/c25.rpy:3645
translate brazilian c25s006_AmaCuddle_bb3f24f8:

    # mc "Hablando de cosas especiales. ¿Qué tiene de especial el collar de [eva]?"
    mc "Por falar em coisas especiais, o que há de tão especial no colar de [eva]?"

# game/scripts/c25/c25.rpy:3647
translate brazilian c25s006_AmaCuddle_ad683714:

    # mc "Le he visto ese corazón puesto cada vez que ha hecho algo... nuevo, por decirlo de alguna forma."
    mc "Tenho visto essa garra nele todas as vezes que ele fez algo... novo, por assim dizer."

# game/scripts/c25/c25.rpy:3648
translate brazilian c25s006_AmaCuddle_003e478f:

    # mc "La primera visita con la familia, lo de ayer, y alguna vez más."
    mc "A primeira visita à família, a visita de ontem e em outra ocasião."

# game/scripts/c25/c25.rpy:3650
translate brazilian c25s006_AmaCuddle_31f6a996:

    # ama "No te lo puedo decir, [mc]. Se lo deberías preguntar a ella..."
    ama "Não posso te dizer, [mc]. Você deveria perguntar a ela..."

# game/scripts/c25/c25.rpy:3651
translate brazilian c25s006_AmaCuddle_c34ef301:

    # mc "No te preocupes. Espero que no sea nada... ¿cómo has dicho? Ah, sí. Macabro."
    mc "Não se preocupe. Espero que não seja nada... o que você disse? Ah, sim. Que sinistro."

# game/scripts/c25/c25.rpy:3655
translate brazilian c25s006_AmaCuddle_2c8733c9:

    # mc "Cambiando de tema. ¿Hay alguien a quien quieras evitar en Aruba?"
    mc "Mudando de assunto. Há alguém que você gostaria de evitar em Aruba?"

# game/scripts/c25/c25.rpy:3657
translate brazilian c25s006_AmaCuddle_947dcd6f:

    # ama "Especialmente a Daniels. Por su culpa murieron tres de mis hermanas y Arnau, el hermano de Aaron."
    ama "Principalmente Daniels. Por causa dele, três das minhas irmãs e Arnau, irmão de Aaron, morreram."

# game/scripts/c25/c25.rpy:3658
translate brazilian c25s006_AmaCuddle_9c96c333:

    # mc "Lo entiendo. No tienes por qué verlo. Aaron y yo nos podemos ocupar de hacer lo que sea necesario."
    mc "Entendo. Você não precisa ver. Aaron e eu podemos cuidar de tudo o que for necessário."

# game/scripts/c25/c25.rpy:3661
translate brazilian c25s006_AmaCuddle_58cc0162:

    # ama "Gracias. ¿Por qué no te callas y me dejas disfrutar de este abrazo en paz? No quiero pensar en trabajo."
    ama "Obrigada. Por que você não fica quieta e me deixa aproveitar esse abraço em paz? Não quero pensar em trabalho."

# game/scripts/c25/c25.rpy:3664
translate brazilian c25s006_AmaCuddle_b9c8e4f9:

    # ama "Gracias. Sois muy parecidos y no me vais a dejar hacer nada que me haga daño."
    ama "Obrigada. Você é muito parecida comigo e não me deixa fazer nada que me machuque."

# game/scripts/c25/c25.rpy:3665
translate brazilian c25s006_AmaCuddle_f05d1af5:

    # mc "En eso consiste protegerte, ¿no? Me encanta que, alguna vez, podamos ser otros los que te protegemos a ti."
    mc "É para isso que serve a proteção, não é? Adoro que, às vezes, sejamos nós que estejamos protegendo vocês."

# game/scripts/c25/c25.rpy:3667
translate brazilian c25s006_AmaCuddle_4c9ecae2:

    # ama "*Risa* El caballero de brillante armadura ha vuelto."
    ama "*Risos* O cavaleiro de armadura brilhante retornou."

# game/scripts/c25/c25.rpy:3668
translate brazilian c25s006_AmaCuddle_d9a20a23:

    # mc "*Risa* Ni siquiera me había dado cuenta."
    mc "*Risos* Nem tinha reparado."

# game/scripts/c25/c25.rpy:3669
translate brazilian c25s006_AmaCuddle_67a4ac62:

    # mc "Pero no querías que habláramos de trabajo..."
    mc "Mas você não queria que falássemos de trabalho..."

# game/scripts/c25/c25.rpy:3671
translate brazilian c25s006_AmaCuddle_31c71ae0:

    # ama "No, quería disfrutar de un abrazo en silencio. *Risa* Pero eso contigo es imposible."
    ama "Não, eu queria aproveitar um abraço silencioso. *Risos* Mas isso é impossível com você."

# game/scripts/c25/c25.rpy:3672
translate brazilian c25s006_AmaCuddle_cb0ba765:

    # mc "*Risa* ¿Hablo demasiado?"
    mc "*Risos* Será que eu falo demais?"

# game/scripts/c25/c25.rpy:3673
translate brazilian c25s006_AmaCuddle_0e7ec165:

    # ama "*Risa* La mayoría del tiempo."
    ama "*Risos* Na maioria das vezes."

# game/scripts/c25/c25.rpy:3674
translate brazilian c25s006_AmaCuddle_dc2bd698:

    # mc "*Risa* Déjame hacerte una última pregunta y me callaré."
    mc "*Risos* Deixe-me fazer uma última pergunta e depois me calo."

# game/scripts/c25/c25.rpy:3676
translate brazilian c25s006_AmaCuddle_a30458cd:

    # ama "*Risa* Me das miedo. Haz esa pregunta."
    ama "*Risos* Você me assusta. Faça essa pergunta."

# game/scripts/c25/c25.rpy:3677
translate brazilian c25s006_AmaCuddle_3e88635e:

    # mc "Dices que tengo que esperar a llegar a Aruba para una cita contigo. ¿Por qué no podemos ir a cenar mañana, por ejemplo?"
    mc "Você diz que eu tenho que esperar até chegar em Aruba para um encontro com você. Por que não podemos sair para jantar amanhã, por exemplo?"

# game/scripts/c25/c25.rpy:3679
translate brazilian c25s006_AmaCuddle_aa536e84:

    # ama "Porque no soy como [sai]."
    ama "Porque eu não sou como [sai]."

# game/scripts/c25/c25.rpy:3680
translate brazilian c25s006_AmaCuddle_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "O que você está falando?"

# game/scripts/c25/c25.rpy:3681
translate brazilian c25s006_AmaCuddle_ef86d131:

    # ama "Sabes que [sai] estuvo planificando vuestra primera vez juntos desde vuestra primera cita, ¿no?"
    ama "Você sabe que [sai] está planejando o primeiro encontro de vocês desde o primeiro encontro, certo?"

# game/scripts/c25/c25.rpy:3682
translate brazilian c25s006_AmaCuddle_af008da4:

    # mc "Sí, lo ha comentado varias veces. Siempre me pareció gracioso que se pasara una semana planeándolo para que fuera perfecto."
    mc "Sim, ele já mencionou isso várias vezes. Sempre achei engraçado que ele tenha passado uma semana planejando tudo para garantir que ficasse perfeito."

# game/scripts/c25/c25.rpy:3683
translate brazilian c25s006_AmaCuddle_6ce0b2fd:

    # mc "¿Quieres decir que no quieres planearlo?"
    mc "Você quer dizer que não quer planejar isso?"

# game/scripts/c25/c25.rpy:3685
translate brazilian c25s006_AmaCuddle_d5dec225:

    # ama "Quiero decir que no quiero pensar en ello. A diferencia de [sai], no considero el sexo importante."
    ama "Quer dizer, eu não quero pensar nisso. Ao contrário de [sai], eu não considero sexo importante."

# game/scripts/c25/c25.rpy:3686
translate brazilian c25s006_AmaCuddle_56833dc0:

    # ama "Sé que para ti sí que lo es, pero yo me podría pasar los próximos meses haciendo solo esto, abrazándonos."
    ama "Eu sei que é para você, mas eu poderia passar os próximos meses apenas fazendo isso, nos abraçando."

# game/scripts/c25/c25.rpy:3688
translate brazilian c25s006_AmaCuddle_f2aba790:

    # ama "Y esto."
    ama "E isto."

# game/scripts/c25/c25.rpy:3690
translate brazilian c25s006_AmaCuddle_dd444808:

    # ama "Estar así, abrazados, es suficiente para mí ahora mismo."
    ama "Estar assim, abraçando, já é o suficiente para mim neste momento."

# game/scripts/c25/c25.rpy:3691
translate brazilian c25s006_AmaCuddle_2ef475ba:

    # mc "¿Y qué tiene eso que ver con que salgamos a cenar?"
    mc "E o que isso tem a ver com a gente sair para jantar?"

# game/scripts/c25/c25.rpy:3693
translate brazilian c25s006_AmaCuddle_820a937f:

    # ama "*Risa* Si planificamos una salida a cenar, los dos sabemos qué pasará después."
    ama "*Risos* Se marcarmos um jantar, ambos sabemos o que vai acontecer depois."

# game/scripts/c25/c25.rpy:3694
translate brazilian c25s006_AmaCuddle_f4dac36c:

    # mc "Sólo pasará lo que tú quieras que pase, [ama]."
    mc "Só acontecerá o que você deseja, [ama]."

# game/scripts/c25/c25.rpy:3696
translate brazilian c25s006_AmaCuddle_456bd3ac:

    # ama "La diferencia es que, entonces, querré que pase."
    ama "A diferença é que, nesse caso, eu vou querer que isso aconteça."

# game/scripts/c25/c25.rpy:3697
translate brazilian c25s006_AmaCuddle_52027a02:

    # ama "Mientras nos veamos un ratito aquí, un ratito allá, sin planificar nada... no hay expectativas. Ni tiempo para que pase nada."
    ama "Enquanto nos encontrarmos por um instante aqui, um instante ali, sem planejar nada... não há expectativas. Nem tempo para que algo aconteça."

# game/scripts/c25/c25.rpy:3698
translate brazilian c25s006_AmaCuddle_9fb1ee18:

    # mc "Pero es que no es necesario que pase nada. Abrazarte me encanta."
    mc "Mas não precisa acontecer nada. Adoro te abraçar."

# game/scripts/c25/c25.rpy:3700
translate brazilian c25s006_AmaCuddle_7caf1c9a:

    # ama "Pero tarde o temprano querrás sexo. No me malinterpretes. Lo entiendo."
    ama "Mas, mais cedo ou mais tarde, você vai querer sexo. Não me entenda mal. Eu entendo."

# game/scripts/c25/c25.rpy:3701
translate brazilian c25s006_AmaCuddle_6dc40a64:

    # ama "Pero quiero que mi... nuestra primera vez sea especial. Estar preparada."
    ama "Mas eu quero que a nossa primeira vez seja especial. Que eu esteja preparada."

# game/scripts/c25/c25.rpy:3702
translate brazilian c25s006_AmaCuddle_e1eb3a86:

    # mc "Espera. ¿Has dicho tu primera vez?"
    mc "Espere. Você disse que era sua primeira vez?"

# game/scripts/c25/c25.rpy:3704
translate brazilian c25s006_AmaCuddle_f181a472:

    # ama "Sí..."
    ama "Sim..."

# game/scripts/c25/c25.rpy:3705
translate brazilian c25s006_AmaCuddle_8f1f9cea:

    # mc "Creía que a todas las espías os entrenaban para..."
    mc "Eu pensava que todos os espiões eram treinados para..."

# game/scripts/c25/c25.rpy:3707
translate brazilian c25s006_AmaCuddle_8a16de32:

    # mc "Me sorprendió con [eva], pero me la podía imaginar estrangulando al instructor que se lo propusiera."
    mc "Fiquei surpreso com [eva], mas consigo imaginá-la estrangulando qualquer instrutor que ousasse tentar."

# game/scripts/c25/c25.rpy:3709
translate brazilian c25s006_AmaCuddle_7be4a361:

    # ama "*Risa* Eso solo pasa en las películas sobre el KGB. Yo no tuve que hacer la fase avanzada del entrenamiento de seducción." id c25s006_AmaCuddle_7be4a361
    ama "*Risos* Isso só acontece em filmes da KGB. Eu não precisei fazer o estágio avançado de treinamento de sedução." id c25s006_AmaCuddle_7be4a361

