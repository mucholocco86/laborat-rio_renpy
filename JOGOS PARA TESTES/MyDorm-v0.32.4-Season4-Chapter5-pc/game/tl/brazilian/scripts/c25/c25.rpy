    # eva "Por un momento solo hemos existido tú y yo. Me gusta esa sensación."
    eva "Por um instante, éramos só você e eu. Eu gosto dessa sensação."

# game/scripts/c25/c25.rpy:711
translate brazilian c25s001_Eva_1b1f0156:

    # mc "A mí también."
    mc "Eu também."

# game/scripts/c25/c25.rpy:713
translate brazilian c25s001_Eva_a12cbe27:

    # "Pasáis un rato en silencio, tan solo disfrutando del tacto de la piel desnuda del otro. Notando cómo vuestros latidos se acompasan."
    "Vocês passam um tempo em silêncio, simplesmente apreciando a sensação da pele nua um do outro. Percebendo como seus batimentos cardíacos se sincronizam."

# game/scripts/c25/c25.rpy:714
translate brazilian c25s001_Eva_b36d7d0c:

    # "No hay fantasmas para estropear el momento."
    "Não há fantasmas para estragar o momento."

# game/scripts/c25/c25.rpy:716
translate brazilian c25s001_Eva_83021b8d:

    # "Pero [eva] aún no ha aprendido la lección sobre relajarse."
    "Mas [eva] ele ainda não aprendeu a lição sobre relaxar."

# game/scripts/c25/c25.rpy:717
translate brazilian c25s001_Eva_ba708d2d:

    # eva "Voy a lavarme la cara. Creo que se me ha corrido la pintura. Es la primera vez que tengo un orgasmo tan intenso y tengo que estar horrible."
    eva "Vou lavar o rosto. Acho que minha maquiagem borrou. É a primeira vez que tenho um orgasmo tão intenso, e devo estar com uma aparência horrível."

# game/scripts/c25/c25.rpy:718
translate brazilian c25s001_Eva_b892e3da:

    # mc "No estás horrible, cielo. Estás guapísima."
    mc "Você não está nada mal, querida. Você está linda."

# game/scripts/c25/c25.rpy:719
translate brazilian c25s001_Eva_8749771b:

    # mc "*Risa* Y espero que se te vuelva a correr en el segundo asalto."
    mc "*Risos* E espero que você consiga de novo na segunda rodada."

# game/scripts/c25/c25.rpy:721
translate brazilian c25s001_Eva_5ef9e37d:

    # eva "*Risa* ¡No va a haber segundo asalto!"
    eva "*Risos* Não haverá segunda rodada!"

# game/scripts/c25/c25.rpy:722
translate brazilian c25s001_Eva_ce1a9ab3:

    # eva "Yo tengo que volver a la base en la moto mientras tú vas al yate. *Risa* No sé si voy a poder sentarme en el sillín."
    eva "Tenho que voltar à base de moto enquanto você vai para o iate. *Risos* Não sei se vou conseguir sentar no banco."

# game/scripts/c25/c25.rpy:724
translate brazilian c25s001_Eva_9e8406e9:

    # eva "Además, [ama] tiene que estar al caer y no hay tiempo."
    eva "Além disso, [ama] precisa estar pronto em breve e não há tempo."

# game/scripts/c25/c25.rpy:725
translate brazilian c25s001_Eva_0be2435e:

    # mc "¿Ya es la hora?"
    mc "Já chegou a hora?"

# game/scripts/c25/c25.rpy:727
translate brazilian c25s001_Eva_bf97552f:

    # eva "Casi. Voy a lavarme. Debo oler a sexo y pólvora."
    eva "Quase. Vou me lavar. Devo estar cheirando a sexo e pólvora."

# game/scripts/c25/c25.rpy:729
translate brazilian c25s001_Eva_502d4ee1:

    # eva "Mmmm... Alguien debería sacar una colonia que oliera así. Yo la compraría."
    eva "Hum... Alguém devia lançar uma colônia com esse cheiro. Eu compraria."

# game/scripts/c25/c25.rpy:730
translate brazilian c25s001_Eva_5fc0db58:

    # mc "*Risa* Dame un beso antes de irte."
    mc "*Risos* Me dá um beijo antes de ir."

# game/scripts/c25/c25.rpy:732
translate brazilian c25s001_Eva_32559bad:

    # "Vuestros labios se unen en un dulce beso. No hay urgencia en él. Tan solo muchos sentimientos compartidos."
    "Seus lábios se encontram em um doce beijo. Não há pressa nele. Apenas muitos sentimentos compartilhados."

# game/scripts/c25/c25.rpy:733
translate brazilian c25s001_Eva_e48ff433:

    # "El beso es muy corto. O eso te parece. Te hubiera parecido corto aunque hubiera durado una eternidad."
    "O beijo é muito curto. Ou pelo menos é o que parece para você. Teria parecido curto mesmo que tivesse durado uma eternidade."

# game/scripts/c25/c25.rpy:735
translate brazilian c25s001_Eva_aa33f435:

    # eva "Tú deberías ducharte. Debes oler igual que yo. Hay una ducha en la oficina."
    eva "Você deveria tomar um banho. Você deve estar com o mesmo cheiro que eu. Tem um chuveiro no escritório."

# game/scripts/c25/c25.rpy:737
translate brazilian c25s001_Eva_86ee0f78:

    # eva "[ama] ya está llegando en la furgoneta. Puedo oírla."
    eva "[ama] Ela já está chegando na van. Eu consigo ouvi-la."

# game/scripts/c25/c25.rpy:738
translate brazilian c25s001_Eva_754bfa3b:

    # "Tú no oyes nada. Esta chica tiene unos sentidos más agudos que los tuyos."
    "Você não consegue ouvir nada. Essa garota tem sentidos muito mais aguçados que os seus."

# game/scripts/c25/c25.rpy:739
translate brazilian c25s001_Eva_6b321836:

    # eva "Vístete si no quieres que te encuentre así."
    eva "Vista-se se não quiser que ele a encontre assim."

# game/scripts/c25/c25.rpy:741
translate brazilian c25s001_Eva_af859f6f:

    # "Tras recoger toda la ropa que se ha quitado durante el striptease, la bella mercenaria desaparece."
    "Após recolher todas as roupas que tirou durante o striptease, a bela mercenária desaparece."

# game/scripts/c25/c25.rpy:742
translate brazilian c25s001_Eva_3511eccb:

    # "Un poco más cerca de la curación."
    "Um pouco mais perto da recuperação."

# game/scripts/c25/c25.rpy:743
translate brazilian c25s001_Eva_93bbcdc5:

    # "Te vuelves a poner el traje de paracaidista mientras esperas que llegue [ama]."
    "Você veste seu traje de paraquedista novamente enquanto espera [ama] chegar."

# game/scripts/c25/c25.rpy:745
translate brazilian c25s001_Eva_2e0e534b:

    # "Escuchas abrirse la puerta del almacén donde [eva] ha guardado la moto."
    "Você ouve a porta do armazém onde [eva] guardou a motocicleta se abrir."

# game/scripts/c25/c25.rpy:751
translate brazilian c25s002_AmaHelo_dec27729:

    # "Un minuto después..."
    "Um minuto depois..."

# game/scripts/c25/c25.rpy:753
translate brazilian c25s002_AmaHelo_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c25/c25.rpy:754
translate brazilian c25s002_AmaHelo_7b542366:

    # ama "*A través de la puerta* Soy yo. Dejad de disparar."
    ama "*Pela porta* Sou eu. Parem de atirar."

# game/scripts/c25/c25.rpy:756
translate brazilian c25s002_AmaHelo_494514af:

    # mc "Pasa, [ama]. Estoy solo."
    mc "Entre, [ama]. Estou sozinho."

# game/scripts/c25/c25.rpy:758
translate brazilian c25s002_AmaHelo_6a99b549:

    # ama "¿Dónde está [eva]?"
    ama "Onde está [eva]?"

# game/scripts/c25/c25.rpy:759
translate brazilian c25s002_AmaHelo_3068a9d6:

    # mc "Ha ido al lavabo. En cuanto vuelva iré a darme una ducha."
    mc "Ela foi ao banheiro. Assim que ela voltar, eu vou tomar um banho."

# game/scripts/c25/c25.rpy:761
translate brazilian c25s002_AmaHelo_3fea9d67:

    # ama "Sí, será lo mejor. Hueles a pólvora..."
    ama "Sim, é melhor assim. Você está com cheiro de pólvora..."

# game/scripts/c25/c25.rpy:762
translate brazilian c25s002_AmaHelo_7c98e1a2:

    # mc "*Risa* Para una reunión con tipos malotes no me parece una mala colonia: *Con acento francés* Eau de pólvora."
    mc "*Risos* Para um encontro com bandidos, acho que não é uma má escolha de perfume: *Com sotaque francês* Eau de pólvora."

# game/scripts/c25/c25.rpy:764
translate brazilian c25s002_AmaHelo_9ea68e3b:

    # ama "No son tipos malotes, [mc]. Son asesinos como lo somos [eva] y yo. Ya has visto los expedientes."
    ama "Eles não são apenas caras maus, [mc]. Eles são assassinos, assim como [eva] e eu. Você viu os arquivos."

# game/scripts/c25/c25.rpy:765
translate brazilian c25s002_AmaHelo_8f2da685:

    # ama "Aparte de Ichigo y algunos militares, el resto son mafiosos y traficantes."
    ama "Com exceção de Ichigo e alguns militares, o restante são mafiosos e traficantes."

# game/scripts/c25/c25.rpy:766
translate brazilian c25s002_AmaHelo_044f1a5a:

    # ama "No es para tomárselo a broma."
    ama "Não é algo que deva ser levado levianamente."

# game/scripts/c25/c25.rpy:767
translate brazilian c25s002_AmaHelo_73649545:

    # mc "No me lo tomo a broma, [ama]. Puedo bromear contigo, pero en ningún momento voy a tomármelo a broma."
    mc "Não estou levando isso na brincadeira, [ama]. Posso brincar com você, mas não vou levar isso na brincadeira."

# game/scripts/c25/c25.rpy:769
translate brazilian c25s002_AmaHelo_08ec546e:

    # ama "Si algo bueno ha tenido NTR es que sólo ha aceptado gobiernos como clientes."
    ama "Se há algo de bom no NTR, é que ele só aceitou governos como clientes."

# game/scripts/c25/c25.rpy:770
translate brazilian c25s002_AmaHelo_fe5a0fdd:

    # ama "Es más... limpio."
    ama "É mais limpo."

# game/scripts/c25/c25.rpy:771
translate brazilian c25s002_AmaHelo_73fa82f3:

    # mc "Y será más limpio aún una vez nos libremos de esa parte del negocio, no te preocupes."
    mc "E ficará ainda mais limpo quando nos livrarmos dessa parte do negócio, não se preocupe."

# game/scripts/c25/c25.rpy:774
translate brazilian c25s002_AmaHelo_d6cc1b64:

    # ama "¿Cómo ha ido el entrenamiento-cita?"
    ama "Como foi a sessão de treinamento?"

# game/scripts/c25/c25.rpy:776
translate brazilian c25s002_AmaHelo_6261797a:

    # ama "¿Cómo ha ido el entrenamiento?"
    ama "Como foi o treinamento?"

# game/scripts/c25/c25.rpy:777
translate brazilian c25s002_AmaHelo_a37d1ddb:

    # mc "Muy bien. Creo que [eva] te debe dinero. He conseguido el objetivo a los siete metros."
    mc "Muito bem. Acho que [eva] te deve dinheiro. Acertei o alvo a sete metros."

# game/scripts/c25/c25.rpy:779
translate brazilian c25s002_AmaHelo_42f32fe8:

    # eva "¡Chivato! *Risa* Lo ha hecho mejor de lo que esperaba. Pero no es dinero lo que habíamos apostado."
    eva "Dedo-duro! *Risos* Ele se saiu melhor do que eu esperava. Mas não apostamos dinheiro."

# game/scripts/c25/c25.rpy:780
translate brazilian c25s002_AmaHelo_a1d9da83:

    # mc "¿Qué habíais apostado?"
    mc "Em que você apostou?"

# game/scripts/c25/c25.rpy:782
translate brazilian c25s002_AmaHelo_ea198bf0:

    # ama "[eva] va a tener que hacer la limpieza de la base hasta que nos vayamos a Aruba."
    ama "[eva] terá que limpar a base até partirmos para Aruba."

# game/scripts/c25/c25.rpy:783
translate brazilian c25s002_AmaHelo_5004716a:

    # ama "Le servirá de entrenamiento para cuando estemos fuera. No se le da muy bien la escoba. *Risa* Aún está buscando el gatillo."
    ama "Isso vai servir de treino para quando estivermos fora. Ele não é muito bom com a vassoura. *Risos* Ele ainda está procurando o gatilho."

# game/scripts/c25/c25.rpy:785
translate brazilian c25s002_AmaHelo_edd38c32:

    # eva "*Grrrr*"
    eva "*Grrrr*"

# game/scripts/c25/c25.rpy:786
translate brazilian c25s002_AmaHelo_72de87dc:

    # mc "*Risa* Voy a ducharme."
    mc "*Risos* Vou tomar um banho."

# game/scripts/c25/c25.rpy:788
translate brazilian c25s002_AmaHelo_df416df9:

    # ama "Ahora te llevo el traje a la oficina. Te esperamos aquí."
    ama "Vou levar o terno para o escritório agora. Esperamos você aqui."

# game/scripts/c25/c25.rpy:790
translate brazilian c25s002_AmaHelo_89c5abfd:

    # "Después de la ducha, con el traje puesto..."
    "Depois do banho, com o traje de banho vestido..."

# game/scripts/c25/c25.rpy:791
translate brazilian c25s002_AmaHelo_f6878a68:

    # mc "Cuando quieras."
    mc "Quando você quiser."

# game/scripts/c25/c25.rpy:792
translate brazilian c25s002_AmaHelo_fb1fe5ec:

    # ama "Me dejas sin palabras." (multiple=2)
    ama "Você me deixa sem palavras." (multiple=2)

# game/scripts/c25/c25.rpy:793
translate brazilian c25s002_AmaHelo_57c734ca:

    # eva "¡Wow! Me encanta ese traje." (multiple=2)
    eva "Uau! Adorei essa roupa." (multiple=2)

# game/scripts/c25/c25.rpy:794
translate brazilian c25s002_AmaHelo_cf43b851:

    # mc "Gracias, chicas."
    mc "Obrigada, meninas."

# game/scripts/c25/c25.rpy:796
translate brazilian c25s002_AmaHelo_85a47555:

    # eva "Voy a recoger todo esto un poco antes de volver a la base. Mañana vengo con las chicas..."
    eva "Vou arrumar tudo isso um pouco antes de voltar para a base. Estarei de volta com as meninas amanhã..."

# game/scripts/c25/c25.rpy:797
translate brazilian c25s002_AmaHelo_fbd6731e:

    # eva "Me servirá de entrenamiento con la escoba."
    eva "Isso servirá como treino com a vassoura."

# game/scripts/c25/c25.rpy:798
translate brazilian c25s002_AmaHelo_ebe3097d:

    # mc "*Risa* La parte peluda es la que va hacia el suelo."
    mc "*Risos* A parte peluda é aquela que vai em direção ao chão."

# game/scripts/c25/c25.rpy:799
translate brazilian c25s002_AmaHelo_1b219632:

    # mc "*Risa* Quería devolvértela desde aquel día en el lago cuando me dijiste que la parte del agujero de la pistola es por donde salían las balas."
    mc "*Risos* Eu queria me vingar de você desde aquele dia no lago, quando você me disse que a parte com o buraco na arma é por onde as balas saem."

# game/scripts/c25/c25.rpy:801
translate brazilian c25s002_AmaHelo_5ecb02a4:

    # eva "Muy gracioso..."
    eva "Muito engraçado..."

# game/scripts/c25/c25.rpy:802
translate brazilian c25s002_AmaHelo_e6e3d5a3:

    # eva "Os veo mañana. Suerte."
    eva "Até amanhã. Boa sorte."

# game/scripts/c25/c25.rpy:804
translate brazilian c25s002_AmaHelo_c46d96ad:

    # ama "Nosotros vamos a esperar el helicóptero fuera. Debe estar a punto de llegar."
    ama "Vamos esperar o helicóptero lá fora. Ele deve chegar a qualquer minuto."

# game/scripts/c25/c25.rpy:805
translate brazilian c25s002_AmaHelo_73ceecc0:

    # mc "Como quieras."
    mc "O que você quiser."

# game/scripts/c25/c25.rpy:807
translate brazilian c25s002_AmaHelo_b19024b5:

    # mc "Veo que tú también has escondido la furgoneta."
    mc "Vejo que você também escondeu a van."

# game/scripts/c25/c25.rpy:808
translate brazilian c25s002_AmaHelo_254e14a6:

    # ama "Si dices 'también' supongo que [eva] te ha explicado la razón para hacerlo."
    ama "Se você disser 'também', suponho que [eva] tenha explicado o motivo de fazê-lo."

# game/scripts/c25/c25.rpy:809
translate brazilian c25s002_AmaHelo_13f8337d:

    # mc "Sí, la considero lógica. Son cosas en las que yo no pensaría nunca."
    mc "Sim, acho que faz sentido. São coisas em que eu nunca pensaria."

# game/scripts/c25/c25.rpy:811
translate brazilian c25s002_AmaHelo_2048a6f5:

    # ama "Para eso nos tienes a nosotras. Nos han entrenado para esto."
    ama "É para isso que estamos aqui. Fomos treinados para isso."

# game/scripts/c25/c25.rpy:812
translate brazilian c25s002_AmaHelo_30665ae1:

    # mc "Y sois la mejor compañía que podría tener para hacer esto ¿Algún último consejo para la reunión?"
    mc "E vocês são a melhor empresa com quem eu poderia fazer isso. Alguma dica final para a reunião?"

# game/scripts/c25/c25.rpy:814
translate brazilian c25s002_AmaHelo_2c6c69af:

    # ama "Lo mismo que te he dicho estos días. No muestres tus puntos débiles, no te comprometas a nada, y no caigas en ninguna provocación."
    ama "A mesma coisa que venho dizendo nos últimos dias. Não mostre suas fraquezas, não se comprometa com nada e não caia em nenhuma provocação."

# game/scripts/c25/c25.rpy:815
translate brazilian c25s002_AmaHelo_bbd4519f:

    # ama "Ichigo va a aprovechar cualquier punto débil que pueda encontrar."
    ama "Ichigo explorará qualquer fraqueza que encontrar."

# game/scripts/c25/c25.rpy:816
translate brazilian c25s002_AmaHelo_04a071c1:

    # mc "Por suerte, te tendré conmigo para evitar que cometa cualquier error infantil."
    mc "Por sorte, terei você comigo para me impedir de cometer erros infantis."

# game/scripts/c25/c25.rpy:818
translate brazilian c25s002_AmaHelo_aa80181c:

    # ama "Tan solo tienes que pensar antes de actuar."
    ama "Você só precisa pensar antes de agir."

# game/scripts/c25/c25.rpy:820
translate brazilian c25s002_AmaHelo_7d4fec1e:

    # ama "Es hora de prepararse. Oigo el helicóptero."
    ama "É hora de se preparar. Estou ouvindo o helicóptero."

# game/scripts/c25/c25.rpy:823
translate brazilian c25s002_AmaHelo_065bb374:

    # "Un minuto después, aterriza un helicóptero en el aparcamiento. El ruido es ensordecedor."
    "Um minuto depois, um helicóptero pousa no estacionamento. O barulho é ensurdecedor."

# game/scripts/c25/c25.rpy:825
translate brazilian c25s002_AmaHelo_af736a31:

    # "???" "¿Señor Marks? ¿Señorita Gilford?"
    "???" "Senhor Marks? Senhorita Gilford?"

# game/scripts/c25/c25.rpy:826
translate brazilian c25s002_AmaHelo_8969bc10:

    # mc "Sí, y usted es..."
    mc "Sim, e você é..."

# game/scripts/c25/c25.rpy:827
translate brazilian c25s002_AmaHelo_e5195af9:

    # "Kostner" "Kostner. ¿Me acompañan al helicóptero?"
    "Kostner" "Kostner. Você me acompanhará até o helicóptero?"

# game/scripts/c25/c25.rpy:829
translate brazilian c25s002_AmaHelo_1676d518:

    # "Nada más sentaros, [ama] se pone unos auriculares y te indica que te pongas unos que hay colgando a tu espalda. Te los pones."
    "Assim que você se senta, [ama] coloca uns fones de ouvido e diz para você colocar uns que estão pendurados atrás de você. Você os coloca."

# game/scripts/c25/c25.rpy:830
translate brazilian c25s002_AmaHelo_0bc3e242:

    # mc "*Gritando* Ahora entiendo por qué gritan tanto en las películas cuando van en helicóptero."
    mc "*Gritos* Agora eu entendo por que eles gritam tanto nos filmes quando estão em um helicóptero."

# game/scripts/c25/c25.rpy:831
translate brazilian c25s002_AmaHelo_33d819e7:

    # ama "No hace falta que grites demasiado con esto. De lo que pase en las películas..."
    ama "Não precisa ficar gritando muito sobre isso. É como nos filmes..."

# game/scripts/c25/c25.rpy:832
translate brazilian c25s002_AmaHelo_da069275:

    # mc "Lo sé, no me puedo fiar."
    mc "Eu sei, não posso confiar nele."

# game/scripts/c25/c25.rpy:833
translate brazilian c25s002_AmaHelo_c2bcb16d:

    # ama "Será mejor que no digas nada en este viaje de lo que no quieras que se enteren."
    ama "É melhor não dizer nada nesta viagem que você não queira que eles descubram."

# game/scripts/c25/c25.rpy:834
translate brazilian c25s002_AmaHelo_962b4142:

    # mc "Entendido."
    mc "Entendido."

# game/scripts/c25/c25.rpy:836
translate brazilian c25s002_AmaHelo_212afea5:

    # "El helicóptero viaja mar adentro durante varios minutos alejándose de la costa."
    "O helicóptero navega mar adentro por vários minutos, afastando-se da costa."

# game/scripts/c25/c25.rpy:837
translate brazilian c25s002_AmaHelo_2adbcdb9:

    # "Es tu primera vez en un helicóptero lo que hace los primeros minutos emocionantes. Después, es como ir en un taxi ruidoso."
    "É a sua primeira vez num helicóptero, o que torna os primeiros minutos emocionantes. Depois disso, é como andar num táxi barulhento."

# game/scripts/c25/c25.rpy:839
translate brazilian c25s002_AmaHelo_55cf0135:

    # mc "Creía que la reunión era en el puerto de Westport."
    mc "Pensei que a reunião fosse no porto de Westport."

# game/scripts/c25/c25.rpy:840
translate brazilian c25s002_AmaHelo_af81e864:

    # ama "Creo que vamos a salir de las aguas territoriales de Estados Unidos."
    ama "Acho que vamos sair das águas territoriais dos EUA."

# game/scripts/c25/c25.rpy:841
translate brazilian c25s002_AmaHelo_35e16972:

    # mc "¡Eso son 200 millas!"
    mc "São 200 milhas!"

# game/scripts/c25/c25.rpy:843
translate brazilian c25s002_AmaHelo_647a523d:

    # ama "*Risa* Eso es la Zona Económica Exclusiva, que son 200 millas NÁUTICAS. 225 millas terrestres."
    ama "*Risos* Essa é a Zona Econômica Exclusiva, que tem 200 milhas náuticas. 225 milhas terrestres."

# game/scripts/c25/c25.rpy:844
translate brazilian c25s002_AmaHelo_55db1520:

    # ama "Yo me refiero a las aguas territoriales. 12 millas náuticas, 13.5 millas terrestres."
    ama "Estou me referindo às águas territoriais. 12 milhas náuticas, 13,5 milhas terrestres."

# game/scripts/c25/c25.rpy:845
translate brazilian c25s002_AmaHelo_3574fa84:

    # mc "¿Por qué tan lejos?"
    mc "Por que tão longe?"

# game/scripts/c25/c25.rpy:847
translate brazilian c25s002_AmaHelo_4ad3cccf:

    # ama "Ya has visto la lista de invitados. Seguro que se hace algo ilegal en ese barco. Prostitución, drogas..."
    ama "Você já viu a lista de convidados. Tenho certeza de que algo ilegal está acontecendo naquele navio. Prostituição, drogas..."

# game/scripts/c25/c25.rpy:848
translate brazilian c25s002_AmaHelo_7d2af2cb:

    # ama "En aguas territoriales se aplican las leyes americanas y podrían tener problemas."
    ama "As leis americanas se aplicam em águas territoriais e isso pode gerar problemas."

# game/scripts/c25/c25.rpy:849
translate brazilian c25s002_AmaHelo_cadae66b:

    # mc "Claro. Lo entiendo."
    mc "Claro. Entendo."

# game/scripts/c25/c25.rpy:851
translate brazilian c25s002_AmaHelo_62691890:

    # "Unos minutos después, puedes ver el enorme yate flotando, majestuoso en medio de la nada, cuando el helicóptero gira para hacer la maniobra de aproximación."
    "Poucos minutos depois, é possível ver o enorme iate flutuando majestosamente no meio do nada, enquanto o helicóptero se prepara para a manobra de aproximação."

# game/scripts/c25/c25.rpy:853
translate brazilian c25s002_AmaHelo_4f1281dd:

    # mc "¡Es enorme!"
    mc "É enorme!"

# game/scripts/c25/c25.rpy:854
translate brazilian c25s002_AmaHelo_0c558043:

    # ama "*Risa* ¡Eso dijo ella!"
    ama "*Risos* Foi isso que ela disse!"

# game/scripts/c25/c25.rpy:855
translate brazilian c25s002_AmaHelo_752cb9f2:

    # mc "*Risa* ¡Qué gran serie!"
    mc "*Risos* Que série fantástica!"

# game/scripts/c25/c25.rpy:857
translate brazilian c25s002_AmaHelo_f41581d9:

    # mc "¿Eso son ametralladoras?"
    mc "São metralhadoras?"

# game/scripts/c25/c25.rpy:858
translate brazilian c25s002_AmaHelo_5c5f0774:

    # ama "Estaciones de armas. Pero sí, para ti, son ametralladoras."
    ama "Postos de armas. Mas sim, para você, são metralhadoras."

# game/scripts/c25/c25.rpy:860
translate brazilian c25s002_AmaHelo_2a167ef3:

    # ama "Para mí estaciones bastante inútiles. No pueden cubrir todas las aproximaciones al barco."
    ama "Para mim, essas estações são praticamente inúteis. Elas não conseguem cobrir todas as vias de acesso à nave."

# game/scripts/c25/c25.rpy:861
translate brazilian c25s002_AmaHelo_0c10fbe0:

    # ama "Creo que están para impresionar. Supongo que más a clientes que a posibles asaltantes."
    ama "Acho que estão lá para impressionar. Suponho que haja mais clientes do que potenciais ladrões."

# game/scripts/c25/c25.rpy:862
translate brazilian c25s002_AmaHelo_dc1d549c:

    # ama "Ya he descubierto al menos tres puntos por donde subir al barco fuera del alcance de las estaciones de armas."
    ama "Já descobri pelo menos três pontos onde posso embarcar na nave fora do alcance das estações de armas."

# game/scripts/c25/c25.rpy:863
translate brazilian c25s002_AmaHelo_71e7f957:

    # mc "No dejas de sorprenderme..."
    mc "Você nunca deixa de me surpreender..."

# game/scripts/c25/c25.rpy:872
translate brazilian c25s002_IronFist_1bb816d1:

    # "Al bajar del helicóptero, encuentras una sorpresa esperándote."
    "Ao sair do helicóptero, você encontra uma surpresa à sua espera."

# game/scripts/c25/c25.rpy:875
translate brazilian c25s002_IronFist_33167358:

    # mc "¿Qué hace [kim] aquí?"
    mc "O que [kim] está fazendo aqui?"

# game/scripts/c25/c25.rpy:877
translate brazilian c25s002_IronFist_aab61a7a:

    # ama "No tengo ni idea. Sabía que tenía un evento hoy en un yate, pero no podía imaginar que fuera aquí."
    ama "Não faço ideia. Sabia que tinha um evento hoje num iate, mas não imaginava que fosse aqui."

# game/scripts/c25/c25.rpy:878
translate brazilian c25s002_IronFist_2c196318:

    # ama "No des muestras de conocerla. Me parece que hay algo turbio aquí."
    ama "Não dê a impressão de que a conhece. Acho que tem algo de suspeito acontecendo aqui."

# game/scripts/c25/c25.rpy:879
translate brazilian c25s002_IronFist_20dbbe35:

    # mc "Tienes razón. Me parece que será lo mejor."
    mc "Você tem razão. Acho que será o melhor."

# game/scripts/c25/c25.rpy:880
translate brazilian c25s002_IronFist_5994add1:

    # ama "Vamos a acercarnos."
    ama "Vamos nos aproximar."

# game/scripts/c25/c25.rpy:882
translate brazilian c25s002_IronFist_06d50574:

    # kim "¿[mc]? ¿[ama]? ¿Qué hacéis...?"
    kim "[mc]? [ama]? O que você está fazendo...?"

# game/scripts/c25/c25.rpy:883
translate brazilian c25s002_IronFist_849ad7a0:

    # mc "Sí. [mc] Marks, de NTR. Y mi asistente, la Señorita Gilford."
    mc "Sim. [mc] Marcas, da NTR. E minha assistente, Srta. Gilford."

# game/scripts/c25/c25.rpy:885
translate brazilian c25s002_IronFist_7db32d32:

    # kim "Bienvenidos al Luxe. ¿Les apetece una copa de champagne?"
    kim "Bem-vindo(a) ao Luxe. Gostaria de uma taça de champanhe?"

# game/scripts/c25/c25.rpy:886
translate brazilian c25s002_IronFist_b1fa3eeb:

    # mcp "(Chica lista. Se ha dado cuenta de que estoy fingiendo no conocerla y ha empezado a actuar profesionalmente.)"
    mcp "(Garota esperta. Ela percebeu que estou fingindo que não a conheço e começou a agir profissionalmente.)"

# game/scripts/c25/c25.rpy:887
translate brazilian c25s002_IronFist_58c8c47a:

    # mc "No, gracias."
    mc "Não, obrigado."

# game/scripts/c25/c25.rpy:889
translate brazilian c25s002_IronFist_1f34fcb8:

    # kim "El Sr. Ichigo está en la cubierta superior. ¿Me quieren acompañar, por favor?"
    kim "O Sr. Ichigo está no convés superior. Gostaria de se juntar a mim, por favor?"

# game/scripts/c25/c25.rpy:890
translate brazilian c25s002_IronFist_eee71231:

    # mc "Adelante, por favor. Indíquenos el camino."
    mc "Por favor, vá em frente. Mostre-nos o caminho."

# game/scripts/c25/c25.rpy:892
translate brazilian c25s002_IronFist_91a00641:

    # "Seguís a [kim] a través de unas escaleras hasta la cubierta principal, donde está la piscina."
    "Você segue [kim] subindo algumas escadas até o deck principal, onde fica a piscina."

# game/scripts/c25/c25.rpy:893
translate brazilian c25s002_IronFist_00dc971a:

    # "[ama] te va dando información de quién es quién. No es necesario. Esta vez has leído los expedientes, pero no la quieres interrumpir."
    "[ama] Ela está te dando informações sobre quem é quem. Não é necessário. Desta vez você leu os arquivos, mas não quer interrompê-la."

# game/scripts/c25/c25.rpy:894
translate brazilian c25s002_IronFist_828699f1:

    # ama "Fong, prostitución y tráfico de personas y armas. De una de las tríadas de San Francisco."
    ama "Fong, prostituição e tráfico de pessoas e armas. De uma das tríades de São Francisco."

# game/scripts/c25/c25.rpy:895
translate brazilian c25s002_IronFist_0e18f730:

    # ama "Davidovic, traficante de drogas y armas de Serbia."
    ama "Davidovic, traficante de drogas e armas da Sérvia."

# game/scripts/c25/c25.rpy:896
translate brazilian c25s002_IronFist_a88541c9:

    # mc "Supongo que las chicas deben ser..."
    mc "Acho que as garotas devem ser..."

# game/scripts/c25/c25.rpy:898
translate brazilian c25s002_IronFist_24b8f9b4:

    # ama "Prostitutas, supongo. Como te he dicho, si salíamos de las aguas territoriales sería por algo así."
    ama "Prostitutas, suponho. Como eu disse, se saíssemos das águas territoriais, seria por algo assim."

# game/scripts/c25/c25.rpy:899
translate brazilian c25s002_IronFist_ff00476d:

    # mc "Me da la sensación de estar en un videojuego o una película. Esto suena surrealista."
    mc "Sinto como se estivesse dentro de um videogame ou de um filme. Parece surreal."

# game/scripts/c25/c25.rpy:901
translate brazilian c25s002_IronFist_ba33b84b:

    # "[kim] os lleva a la cubierta superior, donde Ichigo está hablando con un hombre y una mujer."
    "[kim] leva você ao convés superior, onde Ichigo está conversando com um homem e uma mulher."

# game/scripts/c25/c25.rpy:902
translate brazilian c25s002_IronFist_871ea4a4:

    # ama "General Fuckebythenavele. Ejército."
    ama "General Fuckebythenavele. Exército."

# game/scripts/c25/c25.rpy:903
translate brazilian c25s002_IronFist_fd40b062:

    # mcp "(¿Fuckebythenavele? Lo había leído en el expediente, pero creía que era algún tipo de broma de [ama].)"
    mcp "(Fuckebythenavele? Eu tinha lido no arquivo, mas pensei que fosse algum tipo de piada [ama].)"

# game/scripts/c25/c25.rpy:904
translate brazilian c25s002_IronFist_c74cb228:

    # ama "Alejandra García, ministerio de interior de México."
    ama "Alejandra García, Ministério do Interior do México."

# game/scripts/c25/c25.rpy:905
translate brazilian c25s002_IronFist_5ec6f213:

    # ama "Y, óbviamente, Ichigo."
    ama "E, obviamente, Ichigo."

# game/scripts/c25/c25.rpy:906
translate brazilian c25s002_IronFist_bfd72421:

    # mc "Esta cubierta parece casi normal comparada con la de abajo."
    mc "Esta capa parece quase normal em comparação com a de baixo."

# game/scripts/c25/c25.rpy:908
translate brazilian c25s002_IronFist_e9e094ea:

    # mc "Casi me siento como un pececillo entre tiburones."
    mc "Quase me sinto como um peixinho no meio de tubarões."

# game/scripts/c25/c25.rpy:909
translate brazilian c25s002_IronFist_484b8f64:

    # ama "No te preocupes, lo harás bien."
    ama "Não se preocupe, você vai se sair bem."

# game/scripts/c25/c25.rpy:915
translate brazilian c25s002_IronFist_7166247e:

    # "Llegáis a donde están Ichigo y sus acompañantes."
    "Você chega onde Ichigo e seus companheiros estão."

# game/scripts/c25/c25.rpy:916
translate brazilian c25s002_IronFist_64277485:

    # kim "Sr. Ichigo, el Señor Marks y la Señorita Gilford, de NTR."
    kim "Senhor Ichigo, Senhor Marks e Senhorita Gilford, da NTR."

# game/scripts/c25/c25.rpy:917
translate brazilian c25s002_IronFist_59d605cb:

    # ich "Gracias, chica. Puedes volver al helipuerto."
    ich "Obrigada, garota. Você pode voltar para o heliporto."

# game/scripts/c25/c25.rpy:919
translate brazilian c25s002_IronFist_9acadcc3:

    # kim "Creo que eran los últimos invitados."
    kim "Acho que eles foram os últimos convidados."

# game/scripts/c25/c25.rpy:920
translate brazilian c25s002_IronFist_49e86576:

    # ich "Te he dicho que vuelvas al helipuerto, chica. Eres necesaria allí."
    ich "Eu te disse para voltar para o heliporto, garota. Precisamos de você lá."

# game/scripts/c25/c25.rpy:921
translate brazilian c25s002_IronFist_dc0284b3:

    # "El tono despreciativo de Ichigo te molesta por alguna razón. Seguramente porque va dirigido a [kim]."
    "O tom desdenhoso de Ichigo te incomoda por algum motivo. Provavelmente porque é direcionado a [kim]."

# game/scripts/c25/c25.rpy:923
translate brazilian c25s002_IronFist_d668118e:

    # kim "Sí, Sr. Ichigo."
    kim "Sim, Sr. Ichigo."

# game/scripts/c25/c25.rpy:925
translate brazilian c25s002_IronFist_72a5dcb9:

    # ich "Encantado de conocerle por fin, Sr. Marks."
    ich "Foi um prazer finalmente conhecê-lo, Sr. Marks."

# game/scripts/c25/c25.rpy:926
translate brazilian c25s002_IronFist_ad9b86e3:

    # mc "Igualmente, Sr. Ichigo. Un yate impresionante."
    mc "Igualmente, Sr. Ichigo. Um iate impressionante."

# game/scripts/c25/c25.rpy:927
translate brazilian c25s002_IronFist_1aff69e9:

    # ich "Gracias. Es uno de los activos más vistosos de Iron Fist."
    ich "Obrigado. É um dos atributos mais marcantes do Punho de Ferro."

# game/scripts/c25/c25.rpy:929
translate brazilian c25s002_IronFist_e82f729d:

    # ich "Déjame presentarte a algunos de nuestros invitados, muchacho."
    ich "Deixe-me apresentar alguns dos nossos convidados, garoto."

# game/scripts/c25/c25.rpy:930
translate brazilian c25s002_IronFist_1db898aa:

    # ich "General Fuckebythenavele, el Sr. Marks y la Srta. Gilford, de NTR."
    ich "General Fuckebythenavele, Sr. Marks e Srta. Gilford, da NTR."

# game/scripts/c25/c25.rpy:931
translate brazilian c25s002_IronFist_a10a2379:

    # gfu "Un placer conocerle. He trabajado en varias ocasiones con sus predecesores. Espero continuar la relación con usted."
    gfu "É um prazer conhecê-lo(a). Já trabalhei com seus antecessores em diversas ocasiões. Espero que possamos dar continuidade à nossa relação."

# game/scripts/c25/c25.rpy:932
translate brazilian c25s002_IronFist_69da3703:

    # mc "Igualmente. Espero que nuestra relación con su gobierno sea tan provechosa para ambas partes como lo ha sido en el pasado."
    mc "Igualmente. Espero que nossa relação com o seu governo seja tão mutuamente benéfica quanto tem sido no passado."

# game/scripts/c25/c25.rpy:933
translate brazilian c25s002_IronFist_b0f2de53:

    # ich "La Sra. García, del Gobierno de México."
    ich "Sra. Garcia, do Governo do México."

# game/scripts/c25/c25.rpy:934
translate brazilian c25s002_IronFist_9ffe8158:

    # aga "Encantada. No hemos trabajado juntos aún, pero esperamos tener la oportunidad de hacerlo en el futuro."
    aga "Muito satisfeitos. Ainda não trabalhamos juntos, mas esperamos ter essa oportunidade no futuro."

# game/scripts/c25/c25.rpy:935
translate brazilian c25s002_IronFist_cc69bb38:

    # mc "Encantado de conocerla. En NTR siempre estamos abiertos a nuevos socios comerciales."
    mc "Prazer em conhecê-lo(a). Na NTR, estamos sempre abertos a novos parceiros de negócios."

# game/scripts/c25/c25.rpy:936
translate brazilian c25s002_IronFist_5fb056a2:

    # "[ama] estrecha las manos del general y la política en silencio."
    "[ama] aperta as mãos do general e do político em silêncio."

# game/scripts/c25/c25.rpy:938
translate brazilian c25s002_IronFist_612a8788:

    # ich "Luego te presentaré al resto de asistentes. Mientras tanto, disfruta de la fiesta, muchacho."
    ich "Vou te apresentar aos outros convidados mais tarde. Enquanto isso, aproveite a festa, garoto."

# game/scripts/c25/c25.rpy:940
translate brazilian c25s002_IronFist_cc79a861:

    # ich "¡Chica! Trae algo de beber a mis invitados."
    ich "Menina! Traga algo para beber para os meus convidados."

# game/scripts/c25/c25.rpy:942
translate brazilian c25s002_IronFist_3551baf2:

    # "Se acerca una de las camareras, uniformada como [kim]. Crees recordar que, cuando llevaste a [kim] al puerto, dijo que se llamaba Adeline."
    "Uma das garçonetes se aproxima, vestida com um uniforme como [kim]. Você acha que se lembra que quando levou [kim] ao porto, ela disse que seu nome era Adeline."

# game/scripts/c25/c25.rpy:944
translate brazilian c25s002_IronFist_6d4489e6:

    # "Ahora sabes de qué te sonaba la camarera del restaurante donde fuiste con [kia]."
    "Agora você sabe por que a garçonete do restaurante onde você foi com [kia] parecia familiar."

# game/scripts/c25/c25.rpy:945
translate brazilian c25s002_IronFist_23872bda:

    # "Adeline" "¿Puedo traerles algo para beber?"
    "Adeline" "Posso lhe oferecer algo para beber?"

# game/scripts/c25/c25.rpy:946
translate brazilian c25s002_IronFist_55ce625d:

    # ama "Agua para mí, por favor."
    ama "Água para mim, por favor."

# game/scripts/c25/c25.rpy:947
translate brazilian c25s002_IronFist_7d7a1008:

    # mc "Un zumo de piña para mí, si es tan amable."
    mc "Um suco de abacaxi para mim, se você não se importar."

# game/scripts/c25/c25.rpy:948
translate brazilian c25s002_IronFist_8b5e3c4b:

    # "Adeline" "Ahora mismo."
    "Adeline" "Agora mesmo."

# game/scripts/c25/c25.rpy:950
translate brazilian c25s002_IronFist_12b5f176:

    # gfu "Ichigo, ¿no le ofreces las chicas a nuestro amigo?"
    gfu "Ichigo, você não vai oferecer as garotas ao nosso amigo?"

# game/scripts/c25/c25.rpy:951
translate brazilian c25s002_IronFist_54df2213:

    # ich "Oh, claro. Si te apetece, tan solo tienes que elegir una de las chicas. Hay camarotes privados en las cubiertas inferiores."
    ich "Ah, claro. Se quiser, basta escolher uma das garotas. Há cabines privativas nos decks inferiores."

# game/scripts/c25/c25.rpy:952
translate brazilian c25s002_IronFist_43292d06:

    # gfu "*Risa* Cualquiera menos Alejandra, claro."
    gfu "*Risos* Qualquer um, menos a Alejandra, é claro."

# game/scripts/c25/c25.rpy:953
translate brazilian c25s002_IronFist_a2f6fc80:

    # aga "*Risa fingida* Sí, yo no estoy en el menú. Y para nosotras nunca traen chicos. ¿Lo ve justo, Srta. Gilford?"
    aga "*Risada falsa* Sim, eu não estou no cardápio. E eles nunca trazem rapazes para nós. Acha isso justo, Srta. Gilford?"

# game/scripts/c25/c25.rpy:955
translate brazilian c25s002_IronFist_cd4e645c:

    # ama "No se preocupe por mí, Sra. García. Yo no estaría interesada en los chicos que pudieran traer."
    ama "Não se preocupe comigo, Sra. Garcia. Eu não teria interesse em nenhum rapaz que a senhora pudesse trazer."

# game/scripts/c25/c25.rpy:957
translate brazilian c25s002_IronFist_c46d5cc1:

    # ich "¡Oh! Entonces, también le extiendo la invitación por si quiere escoger cualquiera de las chicas, Srta. Gilford."
    ich "Ah! Então, estendo o convite também à senhorita Gilford, caso queira escolher alguma das moças."

# game/scripts/c25/c25.rpy:958
translate brazilian c25s002_IronFist_134f59f6:

    # mcp "(Ha dicho cualquiera. ¿Eso incluye a [kim]? No creo que sepa dónde se ha metido.)"
    mcp "(Ele disse qualquer um. Isso inclui [kim]? Acho que ele não sabe no que se meteu.)"

# game/scripts/c25/c25.rpy:960
translate brazilian c25s002_IronFist_0978aeb5:

    # "Al cabo de unos minutos, Ichigo y Alejandra se disculpan y os dejan a solas con el general."
    "Após alguns minutos, Ichigo e Alejandra pedem desculpas e te deixam a sós com o general."

# game/scripts/c25/c25.rpy:961
translate brazilian c25s002_IronFist_dc9dd7b4:

    # gfu "¿Qué le trae a esta fiesta, Sr. Marks? NTR suele ser más discreta."
    gfu "O que o traz a esta festa, Sr. Marks? NTR costuma ser mais discreto."

# game/scripts/c25/c25.rpy:962
translate brazilian c25s002_IronFist_c8fbb145:

    # mc "El Sr. Ichigo me invitó para conocernos después del cambio de propiedad de NTR. Represento a los accionistas mayoritarios."
    mc "O Sr. Ichigo me convidou para encontrá-lo após a mudança de propriedade da NTR. Eu represento os acionistas majoritários."

# game/scripts/c25/c25.rpy:963
translate brazilian c25s002_IronFist_94137b3e:

    # mc "Tan solo es una visita de cortesía a un posible rival comercial."
    mc "Trata-se apenas de uma visita de cortesia a um potencial concorrente comercial."

# game/scripts/c25/c25.rpy:965
translate brazilian c25s002_IronFist_fa2615bd:

    # gfu "Ichigo es... un personaje interesante. Lleva años intentando que trabajemos con él, pero preferimos compañías más... respetables, como la suya."
    gfu "Ichigo é... um personagem interessante. Ele vem tentando nos convencer a trabalhar com ele há anos, mas preferimos empresas mais... respeitáveis, como a dele."

# game/scripts/c25/c25.rpy:966
translate brazilian c25s002_IronFist_1239ce29:

    # gfu "Dentro de lo respetable que se puede ser en este negocio, claro."
    gfu "Dentro dos limites do que se pode considerar respeitável neste ramo, é claro."

# game/scripts/c25/c25.rpy:967
translate brazilian c25s002_IronFist_eb34503e:

    # mc "Bueno, desde NTR estamos intentando ser tan respetables como sea posible. Sabemos que no es un negocio limpio, pero al menos puede ser un negocio entre caballeros."
    mc "Bem, aqui na NTR estamos tentando ser o mais respeitáveis possível. Sabemos que não é um negócio limpo, mas pelo menos pode ser um negócio de cavalheiros."

# game/scripts/c25/c25.rpy:969
translate brazilian c25s002_IronFist_4ba47aa8:

    # gfu "*Risa* Un bonito objetivo. Pero todos los países necesitamos tener nuestros propios perros de presa sin tener responsabilidades si el perro hace algo que no debe."
    gfu "*Risos* Um belo gol. Mas cada país precisa ter seus próprios cães de guarda, sem qualquer responsabilidade caso o cão faça algo que não deva."

# game/scripts/c25/c25.rpy:970
translate brazilian c25s002_IronFist_a342cad0:

    # gfu "NTR es uno de esos perros. No te lo tomes como un insulto. Sois el perro más quirúrgico que hemos tenido nunca."
    gfu "NTR é um desses cães. Não leve isso como um insulto. Vocês são os cães mais cirúrgicos que já tivemos."

# game/scripts/c25/c25.rpy:971
translate brazilian c25s002_IronFist_03cbb3ba:

    # mc "No se preocupe, General. No me lo tomo como una ofensa. Evitar daños colaterales es una de las políticas de NTR."
    mc "Não se preocupe, General. Não levo isso como uma ofensa. Evitar danos colaterais é uma das políticas da NTR."

# game/scripts/c25/c25.rpy:973
translate brazilian c25s002_IronFist_e417a518:

    # ama "Es una forma de que nadie se intente deshacer de un perro de presa que se ha vuelto rabioso e incómodo."
    ama "É uma forma de impedir que alguém tente se livrar de um cão de guarda que se tornou raivoso e problemático."

# game/scripts/c25/c25.rpy:975
translate brazilian c25s002_IronFist_e9048879:

    # gfu "Me gusta su política. Es una de las razones por las que es tan difícil que trabajemos con Iron Fist."
    gfu "Gosto das posições políticas deles. É um dos motivos pelos quais é tão difícil para nós trabalharmos com o Punho de Ferro."

# game/scripts/c25/c25.rpy:976
translate brazilian c25s002_IronFist_f9e5c659:

    # gfu "Aparte de su lista de clientes, claro. Sería difícil defender en el Pentágono que trabajamos con los mismos tipos que las tríadas."
    gfu "Além da lista de clientes deles, é claro. Seria difícil argumentar no Pentágono que trabalhamos com as mesmas pessoas que as tríades."

# game/scripts/c25/c25.rpy:977
translate brazilian c25s002_IronFist_b46f2676:

    # mc "Lo entiendo. Entonces, ¿qué hace usted aquí, General?"
    mc "Entendo. Então, o que o senhor está fazendo aqui, General?"

# game/scripts/c25/c25.rpy:979
translate brazilian c25s002_IronFist_b61a9edd:

    # gfu "Una cosa es no querer trabajar con ellos. Otra distinta insultarlos rechazando sus invitaciones."
    gfu "Não querer trabalhar com eles é uma coisa. Insultá-los rejeitando seus convites é outra bem diferente."

# game/scripts/c25/c25.rpy:980
translate brazilian c25s002_IronFist_9204ee72:

    # gfu "Ichigo puede ser despreciable, pero ya conoces el dicho, 'Los amigos cerca y los posibles enemigos más cerca aún'."
    gfu "Ichigo pode ser desprezível, mas você conhece o ditado: \"Amigos são próximos, mas inimigos em potencial são ainda mais próximos\"."

# game/scripts/c25/c25.rpy:981
translate brazilian c25s002_IronFist_eae00f1f:

    # gfu "Además, yo estoy aquí extraoficialmente, sin uniforme. No sé si me entiende."
    gfu "Além disso, estou aqui extraoficialmente, sem uniforme. Não sei se você entende."

# game/scripts/c25/c25.rpy:982
translate brazilian c25s002_IronFist_49eb693c:

    # mc "Me parece una buena política."
    mc "Acho que é uma boa política."

# game/scripts/c25/c25.rpy:984
translate brazilian c25s002_IronFist_48a06a3d:

    # gfu "Ha sido soldado y mercenario en varios conflictos, y después fue operativo de campo en Iron Fist antes de ascender."
    gfu "Ele foi soldado e mercenário em diversos conflitos e, posteriormente, agente de campo do Punho de Ferro, antes de ascender na hierarquia."

# game/scripts/c25/c25.rpy:985
translate brazilian c25s002_IronFist_8dca39d2:

    # gfu "Se quemó la cara en una de sus misiones. Sobre todo, no se lo menciones."
    gfu "Ele queimou o rosto em uma de suas missões. Acima de tudo, não mencione isso para ele."

# game/scripts/c25/c25.rpy:986
translate brazilian c25s002_IronFist_d95481d8:

    # gfu "Ya sabes lo que se dice de cuando solo tienes un martillo como ves los problemas."
    gfu "Sabe o que dizem sobre como você enxerga os problemas quando tudo o que você tem é um martelo?"

# game/scripts/c25/c25.rpy:987
translate brazilian c25s002_IronFist_9d03c102:

    # mc "Sí, todos los problemas se convierten en clavos."
    mc "Sim, todos os problemas se transformam em problemas."

# game/scripts/c25/c25.rpy:989
translate brazilian c25s002_IronFist_ae5c924e:

    # "Se os acerca un hombre al que no habías visto."
    "Um homem que você nunca viu antes está se aproximando de você."

# game/scripts/c25/c25.rpy:990
translate brazilian c25s002_IronFist_cdc0c28d:

    # jef "Sr. Marks, Srta. Gilford, soy Jeff Sound, hablamos por teléfono."
    jef "Senhor Marks, Senhorita Gilford, aqui é Jeff Sound, conversamos ao telefone."

# game/scripts/c25/c25.rpy:991
translate brazilian c25s002_IronFist_e2ceb370:

    # mc "Encantado de conocerle, Sr. Sound."
    mc "Prazer em conhecê-lo, Sr. Sound."

# game/scripts/c25/c25.rpy:993
translate brazilian c25s002_IronFist_37d8c613:

    # jef "¿Pueden acompañarme? El Sr. Ichigo querría reunirse con ustedes en el jacuzzi."
    jef "Você pode me acompanhar? O Sr. Ichigo gostaria de encontrá-lo(a) na jacuzzi."

# game/scripts/c25/c25.rpy:994
translate brazilian c25s002_IronFist_5bb55b13:

    # mc "Creo que no vengo con el atuendo adecuado para una visita al jacuzzi, Sr. Sound."
    mc "Não acho que esteja vestida adequadamente para uma visita à jacuzzi, Sr. Sound."

# game/scripts/c25/c25.rpy:996
translate brazilian c25s002_IronFist_70526c4f:

    # jef "No se preocupe, la reunión tendrá lugar en los sofás que hay al lado del jacuzzi, no dentro."
    jef "Não se preocupe, a reunião acontecerá nos sofás ao lado da jacuzzi, não dentro da sala."

# game/scripts/c25/c25.rpy:997
translate brazilian c25s002_IronFist_2d89d0ee:

    # mc "Perdón por el malentendido. Le seguimos."
    mc "Pedimos desculpas pelo mal-entendido. Nós o acompanharemos."

# game/scripts/c25/c25.rpy:999
translate brazilian c25s002_IronFist_8ac84c95:

    # "Sound os deja en el jacuzzi, donde Ichigo ya está sentado en un sofá y hay una chica en topless dentro del agua."
    "O som te deixa na jacuzzi, onde Ichigo já está sentada em um sofá e há uma garota de topless na água."

# game/scripts/c25/c25.rpy:1000
translate brazilian c25s002_IronFist_fe993fb1:

    # "Inteligentemente, el sofá donde se ha sentado solo tiene dos plazas, lo que va a obligar a [ama] a sentarse al lado del jacuzzi o a quedarse de pie."
    "Astutamente, o sofá onde ele se sentou só tem dois lugares, o que o obrigará a sentar-se ao lado da jacuzzi ou a ficar de pé."

# game/scripts/c25/c25.rpy:1001
translate brazilian c25s002_IronFist_deb5067a:

    # "Supones que la chica medio desnuda está para intentar despistaros tanto a [ama] como a ti, tras haber interpretado que [ama] era lesbiana."
    "Você presume que a garota seminua está lá para tentar enganar tanto [ama] quanto você, depois de ter interpretado [ama] como sendo lésbica."

# game/scripts/c25/c25.rpy:1002
translate brazilian c25s002_IronFist_a4b18349:

    # "Todo está perfectamente estudiado. Cada detalle cuenta."
    "Tudo está perfeitamente planejado. Cada detalhe conta."

# game/scripts/c25/c25.rpy:1003
translate brazilian c25s002_IronFist_f0f5052b:

    # ich "Siéntate, muchacho."
    ich "Sente-se, menino."

# game/scripts/c25/c25.rpy:1004
translate brazilian c25s002_IronFist_fab0c3d6:

    # "Cada vez que te llama 'muchacho' tienes ganas de estrangularlo. Seguramente también está estudiado para sacarte de tus casillas."
    "Toda vez que ele te chama de \"garoto\", você tem vontade de estrangulá-lo. Provavelmente é uma jogada calculada para te irritar."

# game/scripts/c25/c25.rpy:1006
translate brazilian c25s002_IronFist_be105551:

    # "Te sientas al lado de Ichigo. [ama] se sienta al lado del jacuzzi, ignorando a la mujer que hay dentro."
    "Você se senta ao lado de Ichigo. [ama] Ele se senta ao lado da jacuzzi, ignorando a mulher lá dentro."

# game/scripts/c25/c25.rpy:1007
translate brazilian c25s002_IronFist_38b3bf7a:

    # mc "Aquí estamos. Las vibraciones se parecen poco a la reunión informal de la que habló Sound."
    mc "E aqui estamos. O clima não tem nada a ver com o encontro informal de que Sound falava."

# game/scripts/c25/c25.rpy:1009
translate brazilian c25s002_IronFist_13ca937b:

    # ich "*Risa* ¿En cuantas reuniones formales has estado, muchacho? ¿Cuántas tenían putas?"
    ich "*Risos* Em quantas reuniões formais você já esteve, garoto? Quantas delas tinham prostitutas?"

# game/scripts/c25/c25.rpy:1010
translate brazilian c25s002_IronFist_7d198584:

    # mc "He estado en unas cuantas reuniones formales, aunque no había prostitutas en ninguna, en eso tiene razón."
    mc "Já participei de algumas reuniões formais, embora não houvesse prostitutas em nenhuma delas, você tem razão."

# game/scripts/c25/c25.rpy:1011
translate brazilian c25s002_IronFist_903246ca:

    # mcp "(¿Las reuniones con los profesores de la universidad se pueden considerar formales? Voy a tener que empezar a mentir si tengo que tratar con tipos como este.)"
    mcp "(Será que reuniões com professores universitários podem ser consideradas formais? Vou ter que começar a mentir se tiver que lidar com caras assim.)"

# game/scripts/c25/c25.rpy:1013
translate brazilian c25s002_IronFist_61debedd:

    # ich "Relájate, muchacho. Realmente es una reunión informal para tener un primer contacto. No pienses que esto te viene grande."
    ich "Relaxa, garoto. É só um encontro informal para nos conhecermos melhor. Não pense que isso é demais para você."

# game/scripts/c25/c25.rpy:1014
translate brazilian c25s002_IronFist_404bcb13:

    # "Deja caer la última frase precisamente para que pienses que no das la talla. Aparte de [ama] y [kim], es posible que seas la persona más joven en el barco."
    "Insere essa última frase precisamente para fazer você pensar que não está à altura. Além de [ama] e [kim], você provavelmente é a pessoa mais jovem a bordo."

# game/scripts/c25/c25.rpy:1015
translate brazilian c25s002_IronFist_3d3dd610:

    # ich "Y para ver qué opinan vuestros accionistas sobre una absorción o una fusión."
    ich "E para saber o que os acionistas pensam sobre uma aquisição ou fusão."

# game/scripts/c25/c25.rpy:1016
translate brazilian c25s002_IronFist_5551abd5:

    # mc "No están interesados en vender."
    mc "Eles não estão interessados em vender."

# game/scripts/c25/c25.rpy:1018
translate brazilian c25s002_IronFist_23f3d422:

    # ich "Aún no sabes el precio que estamos dispuestos a pagar, muchacho."
    ich "Você ainda não sabe o preço que estamos dispostos a pagar, garoto."

# game/scripts/c25/c25.rpy:1019
translate brazilian c25s002_IronFist_e475b953:

    # mc "No, pero sabemos lo que podéis pagar, y no es suficiente."
    mc "Não, mas sabemos o que você pode pagar, e não é suficiente."

# game/scripts/c25/c25.rpy:1021
translate brazilian c25s002_IronFist_d8c0a0eb:

    # mc "¿Se lo explicas, [ama]?"
    mc "Você pode explicar isso para ele, [ama]?"

# game/scripts/c25/c25.rpy:1022
translate brazilian c25s002_IronFist_5f1e10ad:

    # ama "Sabemos que vuestra facturación es algo más de la mitad de la nuestra. Un tercio del valor de NTR aproximadamente."
    ama "Sabemos que sua receita é um pouco mais da metade da nossa. Aproximadamente um terço do valor da NTR."

# game/scripts/c25/c25.rpy:1024
translate brazilian c25s002_IronFist_658ed36d:

    # "Consulta el móvil un momento para comprobar la información que encontró Jamaal."
    "Verifique seu telefone por um instante para confirmar as informações que Jamaal encontrou."

# game/scripts/c25/c25.rpy:1026
translate brazilian c25s002_IronFist_44467747:

    # ama "Conociendo vuestro flujo de caja y vuestro presupuesto, creemos que podríais pagar, incluso con financiación externa, un máximo de 600 millones. Más cerca de 500."
    ama "Conhecendo seu fluxo de caixa e orçamento, acreditamos que você poderia pagar, mesmo com financiamento externo, no máximo 600 milhões. Mais perto de 500 milhões."

# game/scripts/c25/c25.rpy:1027
translate brazilian c25s002_IronFist_68b89a04:

    # ama "Menos de dos tercios del valor de mercado de NTR, en el mejor de los casos. ¿Me equivoco?"
    ama "Menos de dois terços do valor de mercado da NTR, na melhor das hipóteses. Estou errado?"

# game/scripts/c25/c25.rpy:1028
translate brazilian c25s002_IronFist_61f5aecb:

    # "Tras ver que la prostituta no ejerce ningún efecto en [ama], Ichigo le hace una señal para que se vaya."
    "Após ver que a prostituta não tem efeito sobre [ama], Ichigo faz um sinal para ela ir embora."

# game/scripts/c25/c25.rpy:1030
translate brazilian c25s002_IronFist_004bab3e:

    # ich "Las cifras estarían en esos valores, sí."
    ich "Os valores estariam dentro desses intervalos, sim."

# game/scripts/c25/c25.rpy:1031
translate brazilian c25s002_IronFist_a36e819e:

    # "Se dirige a ti, como si [ama] no existiera. Si no existe, no hay que hacer caso de las cifras que ha puesto sobre la mesa. No le ha gustado que tuvierais esa información."
    "Ele está falando com você como se [ama] não existisse. Se não existe, então os números que ele apresentou não devem ser levados a sério. Ele não gostou que você tivesse essa informação."

# game/scripts/c25/c25.rpy:1032
translate brazilian c25s002_IronFist_00575222:

    # ich "Por eso estaba proponiendo también una fusión, muchacho. Si unimos fuerzas..."
    ich "Por isso também propus uma fusão, garoto. Se unirmos forças..."

# game/scripts/c25/c25.rpy:1033
translate brazilian c25s002_IronFist_24e7660c:

    # mc "[ama], ¿puedes darnos números?"
    mc "[ama], você pode nos dar os números?"

# game/scripts/c25/c25.rpy:1035
translate brazilian c25s002_IronFist_0bbe686b:

    # "Su falsa sonrisa se crispa por un momento al volver a dirigir la atención de la conversación sobre [ama]."
    "Seu sorriso falso vacila por um momento enquanto ela redireciona a conversa de volta para [ama]."

# game/scripts/c25/c25.rpy:1037
translate brazilian c25s002_IronFist_16272952:

    # ama "El valor de mercado de Iron Fist, según nuestros cálculos, ronda los 650 millones. 700 como mucho."
    ama "Segundo nossos cálculos, o valor de mercado do Punho de Ferro gira em torno de 650 milhões. No máximo, 700 milhões."

# game/scripts/c25/c25.rpy:1038
translate brazilian c25s002_IronFist_aa5b00ff:

    # ama "El valor de NTR supera los 1,000 millones. Si hay una fusión, NTR será la entidad dominante."
    ama "O valor da NTR ultrapassa US$ 1 bilhão. Caso ocorra uma fusão, a NTR se tornará a entidade dominante."

# game/scripts/c25/c25.rpy:1040
translate brazilian c25s002_IronFist_f11118fa:

    # mc "Y eso no es lo que quieres, ¿verdad?"
    mc "E não é isso que você quer, não é?"

# game/scripts/c25/c25.rpy:1041
translate brazilian c25s002_IronFist_438be0ef:

    # ich "Bueno, creo que esas cifras están un poco sesgadas."
    ich "Bem, acho que esses números estão um pouco distorcidos."

# game/scripts/c25/c25.rpy:1042
translate brazilian c25s002_IronFist_d52f5999:

    # ich "Ahora mismo, NTR carece de liderazgo y dirección, lo cual rebaja el valor considerablemente. Nosotros podríamos darle el empuje que necesita."
    ich "No momento, a NTR carece de liderança e direção, o que diminui significativamente seu valor. Poderíamos dar a ela o impulso necessário."

# game/scripts/c25/c25.rpy:1043
translate brazilian c25s002_IronFist_04947582:

    # mc "¿Te parezco una persona que no proporciona liderazgo a la empresa?"
    mc "Você acha que eu sou alguém que não exerce liderança na empresa?"

# game/scripts/c25/c25.rpy:1045
translate brazilian c25s002_IronFist_580710fb:

    # ich "Sin querer insultarte, muchacho, no tienes experiencia en este negocio. Cero. O en ningún otro, excepto un dormitorio universitario."
    ich "Sem ofensa, garoto, mas você não tem experiência nenhuma nesse ramo. Zero. Nem em nenhum outro, exceto talvez em um dormitório universitário."

# game/scripts/c25/c25.rpy:1046
translate brazilian c25s002_IronFist_d26ca4a4:

    # "Tu cara, que intentas mantener impasible, tiene que reflejar más de lo que esperabas."
    "Seu rosto, que você tenta manter impassível, deve refletir mais do que você esperava."

# game/scripts/c25/c25.rpy:1048
translate brazilian c25s002_IronFist_bb404a98:

    # "La sonrisa de Ichigo se ensancha."
    "O sorriso de Ichigo se alarga."

# game/scripts/c25/c25.rpy:1049
translate brazilian c25s002_IronFist_09b4f67c:

    # ich "¿Creías que erais los únicos que sabían buscar información, muchacho?"
    ich "Você achou que só vocês sabiam como encontrar informações, garoto?"

# game/scripts/c25/c25.rpy:1050
translate brazilian c25s002_IronFist_59c7cff2:

    # "Mantienes el tono de voz lo más neutral posible."
    "Você mantém seu tom de voz o mais neutro possível."

# game/scripts/c25/c25.rpy:1051
translate brazilian c25s002_IronFist_4e7f098e:

    # mc "Si creyéramos que no sabéis ni siquiera buscar en Foogle, no estaríamos perdiendo el tiempo reuniéndonos con vosotros."
    mc "Se acreditássemos que você nem sequer sabe como pesquisar no Google, não estaríamos perdendo nosso tempo nos reunindo com você."

# game/scripts/c25/c25.rpy:1052
translate brazilian c25s002_IronFist_eb47144c:

    # mc "Es cierto que no tengo experiencia en este negocio, pero tengo un equipo que sí que la tiene."
    mc "É verdade que não tenho experiência neste ramo, mas tenho uma equipe que tem."

# game/scripts/c25/c25.rpy:1053
translate brazilian c25s002_IronFist_780daced:

    # mc "No es necesario saber pilotar una nave espacial para construirla. No es necesario ser un operativo de campo para dirigir NTR."
    mc "Você não precisa saber pilotar uma espaçonave para construir uma. Você não precisa ser um agente de campo para gerenciar a NTR."

# game/scripts/c25/c25.rpy:1055
translate brazilian c25s002_IronFist_2d1bda87:

    # ich "Bueno, muchacho, no hace falta que te pongas a la defensiva. Ya te he dicho que esto era una reunión informal."
    ich "Bem, garoto, não precisa ficar na defensiva. Eu já disse que esta é uma reunião informal."

# game/scripts/c25/c25.rpy:1056
translate brazilian c25s002_IronFist_d1ca8f6e:

    # ich "Pero creo que sería bueno que le comunicaras a tu familia nuestra oferta. Te la enviaré la semana que viene."
    ich "Mas acho que seria uma boa ideia informar sua família sobre nossa oferta. Enviarei para vocês na próxima semana."

# game/scripts/c25/c25.rpy:1058
translate brazilian c25s002_IronFist_6d645498:

    # ich "¿Quieres que te la mande por correo electrónico o mando un mensajero a tu casa?"
    ich "Você prefere que eu envie por e-mail ou que eu envie por correio até sua casa?"

# game/scripts/c25/c25.rpy:1059
translate brazilian c25s002_IronFist_1839f8fe:

    # ich "Y no me refiero al campo de baseball en San Luis Obispo."
    ich "E não estou me referindo ao campo de beisebol em San Luis Obispo."

# game/scripts/c25/c25.rpy:1060
translate brazilian c25s002_IronFist_e79bd92e:

    # mc "La puedes mandar por correo electrónico. Una vez la reciba, lo consultaré con el resto de los accionistas."
    mc "Você pode enviar por e-mail. Assim que eu receber, discutirei com os outros acionistas."

# game/scripts/c25/c25.rpy:1062
translate brazilian c25s002_IronFist_8085e2c0:

    # "Miras a [ama], que asiente con la cabeza, felicitándote por no haberte comprometido a nada."
    "Você olha para [ama], que acena com a cabeça, parabenizando você por não se comprometer com nada."

# game/scripts/c25/c25.rpy:1064
translate brazilian c25s002_IronFist_da0b8aed:

    # ich "Entonces, muchacho..."
    ich "Então, rapaz..."

# game/scripts/c25/c25.rpy:1065
translate brazilian c25s002_IronFist_cf39b048:

    # "Tienes que mantener las manos quietas para no estrangularlo."
    "Você precisa manter as mãos imóveis para não estrangulá-lo."

# game/scripts/c25/c25.rpy:1066
translate brazilian c25s002_IronFist_390ac85f:

    # ich "...vamos a la cubierta principal. Tienen que estar a punto de servir la cena."
    ich "Vamos ao convés principal. O jantar já deve estar sendo servido."

# game/scripts/c25/c25.rpy:1067
translate brazilian c25s002_IronFist_6bd70785:

    # ich "Y esto es una reunión informal. No deberíamos hablar de negocios toda la noche."
    ich "E esta é uma reunião informal. Não devemos ficar falando de negócios a noite toda."

# game/scripts/c25/c25.rpy:1069
translate brazilian c25s002_IronFist_602d43e2:

    # "Al llegar a la cubierta principal, ves que han retirado las tumbonas y han puesto algunas mesas altas."
    "Ao chegar ao convés principal, você percebe que removeram as espreguiçadeiras e colocaram algumas mesas altas."

# game/scripts/c25/c25.rpy:1070
translate brazilian c25s002_IronFist_3806b875:

    # "No ves al General por ningún lado, pero el resto de los invitados que has visto están aquí, incluso uno que no habías visto hasta ahora. Alguien de Italia."
    "Você não vê o General em lugar nenhum, mas todos os outros convidados que você viu estão aqui, incluindo um que você não tinha notado antes. Alguém da Itália."

# game/scripts/c25/c25.rpy:1071
translate brazilian c25s002_IronFist_9a6634c2:

    # ich "Bueno, creo que ha llegado el momento que todos estabais esperando. Veo que nuestro amigo [dav] ya tiene cara de tener hambre."
    ich "Bem, acho que o momento que todos vocês estavam esperando chegou. Vejo que nosso amigo [dav] já está com fome."

# game/scripts/c25/c25.rpy:1072
translate brazilian c25s002_IronFist_63a8f934:

    # dav "*Acento de Europa del Este* *Risa* Ya me conoces. Siempre dispuesto a comer."
    dav "*Sotaque do Leste Europeu* *Risos* Você me conhece. Sempre pronto para uma boa briga."

# game/scripts/c25/c25.rpy:1073
translate brazilian c25s002_IronFist_f9954ab4:

    # ich "Señoritas, pueden traer la comida."
    ich "Senhoras, vocês podem trazer a comida."

# game/scripts/c25/c25.rpy:1075
translate brazilian c25s002_IronFist_1fc7d1fb:

    # "Aparecen tres camareras con platos de comida que depositan en las mesas."
    "Três garçonetes aparecem com pratos de comida e os colocam sobre as mesas."

# game/scripts/c25/c25.rpy:1076
translate brazilian c25s002_IronFist_673828b6:

    # dav "¿Sólo hay esto? *Risa* ¿No vas a dar de comer al resto de tus invitados, puto Japo? Esto se lo come [dav] él solo."
    dav "É só isso? *Risos* Você não vai alimentar o resto dos seus convidados, seu japonês de merda? [dav] está comendo tudo sozinho."

# game/scripts/c25/c25.rpy:1078
translate brazilian c25s002_IronFist_7677d865:

    # "A Ichigo se le crispan las facciones por un momento pero disimula rápidamente. No sabes si por lo de 'Japo' o por lo desagradable que es el serbio."
    "As feições de Ichigo se contraem por um instante, mas ele disfarça rapidamente. Não dá para saber se é por causa do comentário sobre o \"Japonês\" ou por causa da antipatia do sérvio."

# game/scripts/c25/c25.rpy:1079
translate brazilian c25s002_IronFist_3fae0390:

    # ich "Tranquilo, Dave, tenéis más comida dentro si queréis. Y bebida. Toda la que queráis."
    ich "Não se preocupe, Dave, tem mais comida lá dentro se você quiser. E bebidas. À vontade."

# game/scripts/c25/c25.rpy:1080
translate brazilian c25s002_IronFist_00439364:

    # ich "Además, ahora llega el plato principal. No te va a decepcionar."
    ich "E agora, o prato principal. Você não vai se decepcionar."

# game/scripts/c25/c25.rpy:1083
translate brazilian c25s002_IronFist_0179df6f:

    # ich "Podéis traer las bandejas."
    ich "Você pode trazer as bandejas."

# game/scripts/c25/c25.rpy:1086
translate brazilian c25s002_IronFist_198b54a5:

    # "Dos de los guardaespaldas traen las tumbonas con chicas sirviendo como bandejas de sushi. Siempre habías pensado que tenían que estar desnudas."
    "Dois dos seguranças trazem as espreguiçadeiras e as moças as servem como se fossem sushi. Você sempre achou que elas tinham que estar nuas."

# game/scripts/c25/c25.rpy:1087
translate brazilian c25s002_IronFist_f70e458b:

    # "Estas conservan los ligueros y las medias, para dar más impresión de algo fetichista."
    "Essas peças mantêm as ligas e as meias, para dar uma impressão mais fetichista."

# game/scripts/c25/c25.rpy:1088
translate brazilian c25s002_IronFist_740b394d:

    # "El espectáculo y la compañía te han quitado el poco hambre que pudieras haber tenido."
    "O programa e a companhia acabaram com qualquer resquício de fome que você pudesse ter tido."

# game/scripts/c25/c25.rpy:1089
translate brazilian c25s002_IronFist_11caea9a:

    # dav "¡Eso le gusta más a [dav]!"
    dav "[dav] gosta mais assim!"

# game/scripts/c25/c25.rpy:1091
translate brazilian c25s002_IronFist_46655a7a:

    # "Nada más llegar las bandejas humanas, el serbio se lanza como una bestia sobre una de las chicas. El tipo de las tríadas hace lo mismo, más delicadamente."
    "Assim que as garotas chegam, o sérvio se atira sobre uma delas como um animal. O membro da tríade faz o mesmo, mas com mais delicadeza."

# game/scripts/c25/c25.rpy:1093
translate brazilian c25s002_IronFist_0e96ca42:

    # "El invitado que no reconoces, el italiano, y la política mejicana están asqueados con la actuación del serbio."
    "O convidado que você não reconhece, o italiano, e a política mexicana estão revoltados com a atuação do sérvio."

# game/scripts/c25/c25.rpy:1095
translate brazilian c25s002_IronFist_ff81b68e:

    # "Te apartas del grotesco espectáculo y te apoyas en la borda, cerca de una de las estaciones de armas."
    "Você se afasta do espetáculo grotesco e se encosta no parapeito, perto de uma das posições de artilharia."

# game/scripts/c25/c25.rpy:1096
translate brazilian c25s002_IronFist_d2ef441b:

    # "Se te pasa por la mente girar la ametralladora y barrer la cubierta del barco. Si no fuera por las chicas y porque no sabes disparar ametralladoras..."
    "O pensamento de virar a metralhadora e varrer o convés do navio lhe ocorre. Se não fossem as garotas e o fato de você não saber atirar com uma metralhadora..."

# game/scripts/c25/c25.rpy:1098
translate brazilian c25s002_IronFist_de7653ca:

    # ama "¿Estás muy asqueado?"
    ama "Você está com muito nojo?"

# game/scripts/c25/c25.rpy:1099
translate brazilian c25s002_IronFist_d6f3faed:

    # mc "No te lo puedes llegar a imaginar. ¿Siempre son así estas 'fiestas'?"
    mc "Você nem imagina. Essas 'férias' são sempre assim?"

# game/scripts/c25/c25.rpy:1101
translate brazilian c25s002_IronFist_5876cddb:

    # ama "Es la primera en la que estoy. Me dan ganas de sacar el arma y hacer una barbaridad."
    ama "É a primeira vez que me encontro nessa situação. Tenho vontade de sacar minha arma e fazer alguma coisa terrível."

# game/scripts/c25/c25.rpy:1102
translate brazilian c25s002_IronFist_ab4456b0:

    # mc "*Risa triste* Yo estaba pensando en las estaciones de armas hace un segundo."
    mc "*Risada triste* Há pouco tempo eu estava pensando em estações de armas."

# game/scripts/c25/c25.rpy:1104
translate brazilian c25s002_IronFist_b274b6f4:

    # ama "No sabía que iba a ser así. Ni que sabían lo de la familia y el dormitorio."
    ama "Eu não sabia que seria assim. Nem que eles sabiam sobre a família e o quarto."

# game/scripts/c25/c25.rpy:1105
translate brazilian c25s002_IronFist_c26beed8:

    # ama "Si lo hubiera sabido, hubiéramos rechazado la invitación. Ha sido una muestra de que te han investigado."
    ama "Se soubéssemos, teríamos recusado o convite. É evidente que eles estão investigando você."

# game/scripts/c25/c25.rpy:1106
translate brazilian c25s002_IronFist_a7dd2707:

    # mc "Bueno, ahora lo sabemos. También sabremos cuánto ofrecen, aunque no vayamos a vender."
    mc "Bom, agora sabemos. Também saberemos quanto eles estão oferecendo, mesmo que não vámos vender."

# game/scripts/c25/c25.rpy:1108
translate brazilian c25s002_IronFist_27752367:

    # ama "¿De qué nos va a servir eso?"
    ama "Que benefício isso nos trará?"

# game/scripts/c25/c25.rpy:1109
translate brazilian c25s002_IronFist_752f4ab9:

    # mc "Sabiendo cuanto ofrecen podemos saber cuánto tienen y, a través de eso, cuánto valen. Ya no será 500 o 600 millones. Será una cifra más concreta."
    mc "Saber quanto eles oferecem nos permite saber quanto eles têm e, por meio disso, quanto valem. Não serão mais 500 ou 600 milhões. Será um valor mais concreto."

# game/scripts/c25/c25.rpy:1111
translate brazilian c25s002_IronFist_c2795dab:

    # ama "Repito. ¿De qué nos va a servir eso? No estás pensando en comprar Iron Fist, ¿verdad? No podríamos hacerlo y..."
    ama "Repito. Que benefício isso nos traria? Vocês não estão pensando em comprar Punho de Ferro, estão? Não poderíamos fazer isso e..."

# game/scripts/c25/c25.rpy:1112
translate brazilian c25s002_IronFist_a1400b69:

    # mc "No sé de qué nos va a servir, [ama]. Pero parece que la información es poder en este juego. Y no, no quiero comprar... esto."
    mc "Não sei que bem isso nos fará, [ama]. Mas parece que informação é poder neste jogo. E não, eu não quero comprar... isso."

# game/scripts/c25/c25.rpy:1113
translate brazilian c25s002_IronFist_0b02b795:

    # mc "Si vamos a cerrar la parte de NTR dedicada a las operaciones encubiertas, no nos aportaría nada..."
    mc "Se fecharmos a seção da NTR dedicada a operações secretas, isso não nos beneficiará em nada..."

# game/scripts/c25/c25.rpy:1114
translate brazilian c25s002_IronFist_69193b37:

    # mc "Aparte de la satisfacción por eliminar Iron Fist, a Ichigo, y este puto barco."
    mc "Além da satisfação de eliminar o Punho de Ferro, o Ichigo e essa maldita nave."

# game/scripts/c25/c25.rpy:1116
translate brazilian c25s002_IronFist_31bcc5d7:

    # dav "¡Japo! Antes había tres tumbonas. ¿No hay tres chicas?"
    dav "Japonesas! Costumava haver três espreguiçadeiras. Não são três garotas?"

# game/scripts/c25/c25.rpy:1118
translate brazilian c25s002_IronFist_ed7b97bb:

    # "Ichigo te mira antes de hacer una seña a uno de los guardaespaldas, que trae la tercera tumbona. Vacía."
    "Ichigo olha para você antes de fazer um sinal para um dos guarda-costas, que traz a terceira espreguiçadeira. Vazia."

# game/scripts/c25/c25.rpy:1119
translate brazilian c25s002_IronFist_2138737c:

    # dav "¿Una tumbona sin chica? ¿Nos estás timando?"
    dav "Uma espreguiçadeira sem nenhuma garota? Você está tentando nos enganar?"

# game/scripts/c25/c25.rpy:1121
translate brazilian c25s002_IronFist_85190d89:

    # ich "Trae a la chica."
    ich "Traga a garota."

# game/scripts/c25/c25.rpy:1122
translate brazilian c25s002_IronFist_81d55cb3:

    # "La mirada de Ichigo antes de pedir la tumbona te ha dado escalofríos."
    "O olhar de Ichigo antes de pedir a espreguiçadeira te deu arrepios."

# game/scripts/c25/c25.rpy:1124
translate brazilian c25s002_IronFist_a9fad70a:

    # mc "¿Qué está pasando, [ama]? ¿A qué ha venido esa mirada?"
    mc "O que está acontecendo, [ama]? Que olhar é esse?"

# game/scripts/c25/c25.rpy:1125
translate brazilian c25s002_IronFist_04e83625:

    # ama "No tengo ni idea. Debes estar preparado para cualquier cosa."
    ama "Não faço ideia. É preciso estar preparado para tudo."

# game/scripts/c25/c25.rpy:1127
translate brazilian c25s002_IronFist_1c379060:

    # "El guardaespaldas vuelve un par de minutos después, acompañando a [kim]. Hace bien no mirándote, con su mirada fija en Ichigo."
    "O guarda-costas retorna alguns minutos depois, acompanhando [kim]. Ele está certo em não olhar para você, seu olhar está fixo em Ichigo."

# game/scripts/c25/c25.rpy:1128
translate brazilian c25s002_IronFist_1beaa9a4:

    # "Cada vez estás más convencido de que vas a tener que usar la estación de armas."
    "Você está cada vez mais convencido de que terá que usar a estação de armas."

# game/scripts/c25/c25.rpy:1130
translate brazilian c25s002_IronFist_15eb703c:

    # dav "¡Oh, sí! ¡La vaca suiza! A [dav] le gusta la idea."
    dav "Ah sim! A vaca suíça! [dav] gosta da ideia."

# game/scripts/c25/c25.rpy:1131
translate brazilian c25s002_IronFist_5fe1e341:

    # "O coger el arma de [ama] y pegarle un tiro al serbio."
    "Ou pegue a arma [ama] e atire no sérvio."

# game/scripts/c25/c25.rpy:1133
translate brazilian c25s002_IronFist_f4d73818:

    # ich "Chica, quítate el uniforme y estírate en la tumbona. Déjate solo la ropa que llevan las otras chicas."
    ich "Menina, tire o uniforme e deite-se na espreguiçadeira. Continue vestindo as roupas que as outras meninas estão usando."

# game/scripts/c25/c25.rpy:1134
translate brazilian c25s002_IronFist_5ea9857f:

    # kim "¿Qué?"
    kim "Que?"

# game/scripts/c25/c25.rpy:1136
translate brazilian c25s002_IronFist_c5cca174:

    # "[kim] os mira incrédula y desamparada, alternando la mirada entre Ichigo y tú."
    "[kim] Ela olha para você incrédula e impotente, alternando o olhar entre Ichigo e você."

# game/scripts/c25/c25.rpy:1137
translate brazilian c25s002_IronFist_77d9d38e:

    # "Ichigo te mira con aires de superioridad. Te ha demostrado que puede hacer daño a personas cercanas a ti."
    "Ichigo olha para você com um ar de superioridade. Ele já demonstrou que é capaz de magoar pessoas próximas a você."

# game/scripts/c25/c25.rpy:1161
translate brazilian c25s002_SaveKim_11ae0633:

    # mc "Espera... Japo Cara Quemada."
    mc "Espera... Japonês com o rosto queimado."

# game/scripts/c25/c25.rpy:1162
translate brazilian c25s002_SaveKim_e48b9522:

    # "Tú también quieres jugar al juego de sacar a la gente de sus casillas y vas con toda la artillería."
    "Você também quer entrar no jogo de irritar as pessoas, e está se dedicando totalmente a isso."

# game/scripts/c25/c25.rpy:1164
translate brazilian c25s002_SaveKim_b9326388:

    # "Ichigo se crispa. No era disgusto por el serbio."
    "Ichigo ficou tenso. Não era antipatia pelo sérvio."

# game/scripts/c25/c25.rpy:1165
translate brazilian c25s002_SaveKim_d4124b03:

    # ich "¿Qué quieres, muchacho? Nuestro amigo serbio tiene hambre."
    ich "O que você quer, garoto? Nosso amigo sérvio está com fome."

# game/scripts/c25/c25.rpy:1166
translate brazilian c25s002_SaveKim_c524af29:

    # mc "Me has dicho antes que me podía llevar a cualquier chica a un camarote privado. La elijo a ella."
    mc "Você me disse antes que eu poderia levar qualquer garota para uma cabine privada. Eu a escolhi."

# game/scripts/c25/c25.rpy:1167
translate brazilian c25s002_SaveKim_c6ba82be:

    # mc "Me la voy a llevar a un camarote ahora mismo."
    mc "Vou levá-la para uma cabana agora mesmo."

# game/scripts/c25/c25.rpy:1169
translate brazilian c25s002_SaveKim_fc9800cd:

    # dav "¡Nos has dicho que cualquiera menos ella, Japo!"
    dav "Você nos disse que qualquer pessoa, menos ela, Japo!"

# game/scripts/c25/c25.rpy:1171
translate brazilian c25s002_SaveKim_48411ab6:

    # mc "A mí me ha dicho cualquier chica y quiero a esa. ¿O esa es la forma de hacer negocios de Iron Fist?"
    mc "Qualquer garota já me disse que me quer. Ou será que é assim que o Punho de Ferro faz negócios?"

# game/scripts/c25/c25.rpy:1172
translate brazilian c25s002_SaveKim_b201a37b:

    # mc "¿Promete cosas que no puede cumplir?"
    mc "Ele promete coisas que não pode cumprir?"

# game/scripts/c25/c25.rpy:1174
translate brazilian c25s002_SaveKim_9865ec09:

    # aga "El Sr. Marks tiene razón. Le ha dicho que podía escoger cualquier chica. Yo estaba ahí."
    aga "O Sr. Marks tem razão. Ele disse a ela que poderia escolher qualquer garota. Eu estava lá."

# game/scripts/c25/c25.rpy:1175
translate brazilian c25s002_SaveKim_c7d7f6a5:

    # "Sabes que Alejandra está tan asqueada por el espectáculo como tú, y decide unirse a tu bando aunque no sabe lo que está en juego."
    "Você sabe que Alejandra está tão revoltada com o espetáculo quanto você, e decide ficar do seu lado mesmo sem saber o que está em jogo."

# game/scripts/c25/c25.rpy:1177
translate brazilian c25s002_SaveKim_61837a44:

    # ich "Todos tenéis razón. He dicho que estaba fuera de límites y he cometido un error al decirle al Sr. Marks que podía escoger cualquier chica."
    ich "Você tem razão. Eu disse que era inaceitável e cometi um erro ao dizer ao Sr. Marks que ele podia escolher qualquer garota."

# game/scripts/c25/c25.rpy:1178
translate brazilian c25s002_SaveKim_3b9f62b5:

    # ich "Puedes escoger cualquier chica menos esta, muchacho. Esta es para disfrute de todos."
    ich "Você pode escolher qualquer garota, menos esta, rapaz. Esta é para o deleite de todos."

# game/scripts/c25/c25.rpy:1180
translate brazilian c25s002_SaveKim_615d9bc1:

    # "[kim] os mira a [ama] y a ti desvalida y asustada a partes iguales."
    "[kim] olha para [ama] você, indefeso e assustado na mesma medida."

# game/scripts/c25/c25.rpy:1181
translate brazilian c25s002_SaveKim_1c0ad054:

    # mc "¿Así es como Iron Fist hace negocios? ¿Ichigo comete un error, promete algo que no puede, o no quiere, cumplir, y ahora se retracta?"
    mc "É assim que o Punho de Ferro trabalha? Ichigo comete um erro, promete algo que não pode, ou não quer, cumprir, e agora está recuando?"

# game/scripts/c25/c25.rpy:1182
translate brazilian c25s002_SaveKim_eb2f3149:

    # mc "Espero que no os haga lo mismo cuando lo contratéis para una operación de la que dependan vuestras organizaciones."
    mc "Espero que ele não faça o mesmo com você quando o contratar para uma operação da qual sua organização depende."

# game/scripts/c25/c25.rpy:1183
translate brazilian c25s002_SaveKim_c18f2b3c:

    # "Notas la mano de [ama] en la espalda, diciéndote que lo estás haciendo bien."
    "Você sente a mão de [ama] nas suas costas, dizendo que você está indo bem."

# game/scripts/c25/c25.rpy:1185
translate brazilian c25s002_SaveKim_f926944d:

    # aga "Ahí te ha pillado, Ichigo. Creo que le deberías permitir irse con la chica."
    aga "Pronto, Ichigo. Acho que você deveria deixá-lo ir com a garota."

# game/scripts/c25/c25.rpy:1186
translate brazilian c25s002_SaveKim_050e8487:

    # aga "Estoy segura de que cualquiera de las chicas que se han estado paseando con las tetas al aire podrán sustituirla."
    aga "Tenho certeza de que qualquer uma das garotas que andam por aí com os peitos de fora pode substituí-la."

# game/scripts/c25/c25.rpy:1187
translate brazilian c25s002_SaveKim_79ee2016:

    # aga "Incluso puedes dejar que [dav] escoja la que quiera como compensación."
    aga "Você pode até deixar [dav] escolher o que quiser como compensação."

# game/scripts/c25/c25.rpy:1189
translate brazilian c25s002_SaveKim_5ed1ae75:

    # ich "Bueno, si lo he prometido, debo cumplir. Te puedes llevar a la chica y que [dav] elija su sustituta."
    ich "Bem, se eu prometi, tenho que cumprir minha palavra. Você pode levar a garota e deixar [dav] escolher a substituta dela."

# game/scripts/c25/c25.rpy:1190
translate brazilian c25s002_SaveKim_ffc907c0:

    # "Temes por las otras camareras por un momento. Pero ellas no son familia."
    "Por um instante, você se preocupa com as outras garçonetes. Mas elas não são da família."

# game/scripts/c25/c25.rpy:1191
translate brazilian c25s002_SaveKim_49801325:

    # dav "A [dav] le parece una buena idea. Elijo a la puta de las tetas grandes. *Risa* ¡A ver cómo se aguanta el sushi en esas tetas!"
    dav "[dav] acha que é uma boa ideia. Eu escolho a puta de peitões. *Risos* Vamos ver como ela segura o sushi nesses peitos!"

# game/scripts/c25/c25.rpy:1193
translate brazilian c25s002_SaveKim_4b4f0e3a:

    # "Coges a [kim] del brazo y te la llevas hacia el interior del barco antes de que alguien cambie de opinión."
    "Você agarra [kim] pelo braço e a leva para dentro da nave antes que alguém mude de ideia."

# game/scripts/c25/c25.rpy:1194
translate brazilian c25s002_SaveKim_1d55b5a9:

    # kim "¿Qué está pasando, [mc]?"
    kim "O que está acontecendo, [mc]?"

# game/scripts/c25/c25.rpy:1195
translate brazilian c25s002_SaveKim_0cdad13c:

    # mc "Luego, [kim]."
    mc "Então, [kim]."

# game/scripts/c25/c25.rpy:1200
translate brazilian c25s002_DontSaveKim_e07fbec1:

    # ama "Espera... Japo Cara Quemada."
    ama "Espera... Japonês com o rosto queimado."

# game/scripts/c25/c25.rpy:1201
translate brazilian c25s002_DontSaveKim_1e433059:

    # "Ella también quiere jugar al juego de sacar a la gente de sus casillas y va con toda la artillería."
    "Ela também quer jogar o jogo de irritar as pessoas e está se dedicando totalmente a isso."

# game/scripts/c25/c25.rpy:1203
translate brazilian c25s002_DontSaveKim_b9326388:

    # "Ichigo se crispa. No era disgusto por el serbio."
    "Ichigo ficou tenso. Não era antipatia pelo sérvio."

# game/scripts/c25/c25.rpy:1204
translate brazilian c25s002_DontSaveKim_539a1099:

    # ich "¿Qué quiere, Srta. Gilford? Nuestro amigo serbio tiene hambre."
    ich "O que deseja, Srta. Gilford? Nosso amigo sérvio está com fome."

# game/scripts/c25/c25.rpy:1206
translate brazilian c25s002_DontSaveKim_6e0ce421:

    # ama "Me has dicho antes que me podía llevar a cualquier chica a un camarote privado. La elijo a ella."
    ama "Você me disse antes que eu poderia levar qualquer garota para uma cabine privada. Eu a escolhi."

# game/scripts/c25/c25.rpy:1207
translate brazilian c25s002_DontSaveKim_990eba46:

    # ama "Me la voy a llevar a un camarote ahora mismo."
    ama "Vou levá-la para uma cabana agora mesmo."

# game/scripts/c25/c25.rpy:1209
translate brazilian c25s002_DontSaveKim_fc9800cd:

    # dav "¡Nos has dicho que cualquiera menos ella, Japo!"
    dav "Você nos disse que qualquer pessoa, menos ela, Japo!"

# game/scripts/c25/c25.rpy:1211
translate brazilian c25s002_DontSaveKim_7da79d62:

    # ama "A mí me ha dicho cualquier chica y quiero a esa. ¿O esa es la forma de hacer negocios de Iron Fist?"
    ama "Qualquer garota já me disse que me quer. Ou será que é assim que o Punho de Ferro faz negócios?"

# game/scripts/c25/c25.rpy:1212
translate brazilian c25s002_DontSaveKim_153c273e:

    # ama "¿Promete cosas que no puede cumplir?"
    ama "Ele promete coisas que não pode cumprir?"

# game/scripts/c25/c25.rpy:1214
translate brazilian c25s002_DontSaveKim_dc116445:

    # aga "La Srta. Gilford tiene razón. Le ha dicho que podía escoger cualquier chica. Yo estaba ahí."
    aga "A senhorita Gilford tem razão. Ela disse a ele que ele podia escolher qualquer garota. Eu estava lá."

# game/scripts/c25/c25.rpy:1215
translate brazilian c25s002_DontSaveKim_4c89fd9e:

    # "Sabes que Alejandra está tan asqueada por el espectáculo como tú, y decide unirse al bando de [ama] aunque no sabe lo que está en juego."
    "Você sabe que Alejandra está tão enojada com o espetáculo quanto você, e ela decide se juntar ao lado [ama] mesmo sem saber o que está em jogo."

# game/scripts/c25/c25.rpy:1217
translate brazilian c25s002_DontSaveKim_18f23169:

    # ich "Todos tenéis razón. He dicho que estaba fuera de límites y he cometido un error al decirle a la Srta. Gilford que podía escoger cualquier chica."
    ich "Você tem razão. Eu disse que era inaceitável e cometi um erro ao dizer à Srta. Gilford que ela podia escolher qualquer garota."

# game/scripts/c25/c25.rpy:1218
translate brazilian c25s002_DontSaveKim_0e37b919:

    # ich "Puede escoger cualquier chica menos esta, Srta. Gilford. Esta es para disfrute de todos."
    ich "Você pode escolher qualquer garota, exceto esta, a Srta. Gilford. Esta é para o deleite de todos."

# game/scripts/c25/c25.rpy:1220
translate brazilian c25s002_DontSaveKim_0f46b098:

    # "[kim] os mira a [ama] y a ti desvalida y asustada a partes iguales. Decides intervenir."
    "[kim] olha para [ama] e para você, impotente e assustado na mesma medida. Você decide intervir."

# game/scripts/c25/c25.rpy:1221
translate brazilian c25s002_DontSaveKim_1c0ad054:

    # mc "¿Así es como Iron Fist hace negocios? ¿Ichigo comete un error, promete algo que no puede, o no quiere, cumplir, y ahora se retracta?"
    mc "É assim que o Punho de Ferro trabalha? Ichigo comete um erro, promete algo que não pode, ou não quer, cumprir, e agora está recuando?"

# game/scripts/c25/c25.rpy:1222
translate brazilian c25s002_DontSaveKim_eb2f3149:

    # mc "Espero que no os haga lo mismo cuando lo contratéis para una operación de la que dependan vuestras organizaciones."
    mc "Espero que ele não faça o mesmo com você quando o contratar para uma operação da qual sua organização depende."

# game/scripts/c25/c25.rpy:1223
translate brazilian c25s002_DontSaveKim_d154f028:

    # "Notas la mano de [ama] en tu brazo, diciéndote que lo estás haciendo bien."
    "Você sente a mão de [ama] no seu braço, dizendo que você está indo bem."

# game/scripts/c25/c25.rpy:1225
translate brazilian c25s002_DontSaveKim_f926944d:

    # aga "Ahí te ha pillado, Ichigo. Creo que le deberías permitir irse con la chica."
    aga "Pronto, Ichigo. Acho que você deveria deixá-lo ir com a garota."

# game/scripts/c25/c25.rpy:1226
translate brazilian c25s002_DontSaveKim_050e8487:

    # aga "Estoy segura de que cualquiera de las chicas que se han estado paseando con las tetas al aire podrán sustituirla."
    aga "Tenho certeza de que qualquer uma das garotas que andam por aí com os peitos de fora pode substituí-la."

# game/scripts/c25/c25.rpy:1227
translate brazilian c25s002_DontSaveKim_79ee2016:

    # aga "Incluso puedes dejar que [dav] escoja la que quiera como compensación."
    aga "Você pode até deixar [dav] escolher o que quiser como compensação."

# game/scripts/c25/c25.rpy:1229
translate brazilian c25s002_DontSaveKim_5ed1ae75:

    # ich "Bueno, si lo he prometido, debo cumplir. Te puedes llevar a la chica y que [dav] elija su sustituta."
    ich "Bem, se eu prometi, tenho que cumprir minha palavra. Você pode levar a garota e deixar [dav] escolher a substituta dela."

# game/scripts/c25/c25.rpy:1230
translate brazilian c25s002_DontSaveKim_0b7fda0a:

    # "Temes por las otras camareras por un momento. Todas miran asustadas a [dav]."
    "Por um momento, você sente medo pelas outras garçonetes. Todas elas olham para [dav] com medo."

# game/scripts/c25/c25.rpy:1231
translate brazilian c25s002_DontSaveKim_ab677966:

    # "Pero ellas no son familia. Estás complacido de que [ama] haya sabido reaccionar."
    "Mas eles não são da família. Você fica feliz que [ama] soube como reagir."

# game/scripts/c25/c25.rpy:1232
translate brazilian c25s002_DontSaveKim_02528ae8:

    # "Quizás puedas hacer lo mismo si elige a una camarera..."
    "Talvez você pudesse fazer o mesmo se escolhesse uma garçonete..."

# game/scripts/c25/c25.rpy:1233
translate brazilian c25s002_DontSaveKim_49801325:

    # dav "A [dav] le parece una buena idea. Elijo a la puta de las tetas grandes. *Risa* ¡A ver cómo se aguanta el sushi en esas tetas!"
    dav "[dav] acha que é uma boa ideia. Eu escolho a puta de peitões. *Risos* Vamos ver como ela segura o sushi nesses peitos!"

# game/scripts/c25/c25.rpy:1235
translate brazilian c25s002_DontSaveKim_bedca6c7:

    # "Ves que [ama] coge a [kim] del brazo y se la lleva hacia el interior del barco antes de que alguien cambie de opinión."
    "Você vê [ama] agarrar [kim] pelo braço e levá-la para dentro da nave antes que alguém mude de ideia."

# game/scripts/c25/c25.rpy:1236
translate brazilian c25s002_DontSaveKim_5c26b5a5:

    # kim "¿Qué está pasando, [ama]?"
    kim "O que está acontecendo, [ama]?"

# game/scripts/c25/c25.rpy:1237
translate brazilian c25s002_DontSaveKim_af750646:

    # ama "Luego, [kim]."
    ama "Então, [kim]."

# game/scripts/c25/c25.rpy:1251
translate brazilian c25s002_KimSaved_2259d25d:

    # "Mientras vas con [kim] hacia el camarote..."
    "Ao seguir com [kim] em direção à cabine..."

# game/scripts/c25/c25.rpy:1252
translate brazilian c25s002_KimSaved_feb187f6:

    # ama "{i}(Joder, como se ha complicado todo.){/i}"
    ama "{i}(Caramba, as coisas ficaram tão complicadas.){/i}"

# game/scripts/c25/c25.rpy:1254
translate brazilian c25s002_KimSaved_172f8095:

    # "Un par de minutos después..."
    "Alguns minutos depois..."

# game/scripts/c25/c25.rpy:1255
translate brazilian c25s002_KimSaved_e62085b0:

    # aga "¿Qué tiene Ichigo contra vosotros? Lo de esa chica parecía algo personal."
    aga "O que Ichigo tem contra você? O que aquela garota fez pareceu pessoal."

# game/scripts/c25/c25.rpy:1257
translate brazilian c25s002_KimSaved_e3b6fb65:

    # ama "No es un tema personal, sino de negocios. Estaba haciendo una competición a ver quién tenía la polla más grande."
    ama "Não é nada pessoal, são negócios. Eu estava fazendo uma competição para ver quem tinha o maior pênis."

# game/scripts/c25/c25.rpy:1258
translate brazilian c25s002_KimSaved_23f566b0:

    # ama "La chica se aloja en el dormitorio universitario que es el negocio de la familia de [mc], e Ichigo quería demostrar que podía atacarnos por ahí."
    ama "A garota está hospedada no dormitório universitário que é de responsabilidade da família de [mc], e Ichigo queria provar que podia nos atacar de lá."

# game/scripts/c25/c25.rpy:1260
translate brazilian c25s002_KimSaved_e9ff619d:

    # aga "Ichigo siempre me ha parecido un tipo muy zafio, pero usar a una chica así es demasiado incluso para él."
    aga "Sempre achei que o Ichigo fosse um cara muito grosseiro, mas usar uma garota desse jeito é demais até para ele."

# game/scripts/c25/c25.rpy:1261
translate brazilian c25s002_KimSaved_b0480fff:

    # aga "Ha tenido que aceptar la derrota temporalmente pero, si puedes, indícale a [mc] que no salga del camarote hasta que no acabe la fiesta."
    aga "Ele teve que aceitar a derrota temporariamente, mas se puder, diga a [mc] para não sair da cabine até que a festa termine."

# game/scripts/c25/c25.rpy:1263
translate brazilian c25s002_KimSaved_fb9e295d:

    # ama "Gracias, Alejandra. Lo haré."
    ama "Obrigada, Alejandra. Eu irei."

# game/scripts/c25/c25.rpy:1264
translate brazilian c25s002_KimSaved_19ede4b3:

    # ama "Y gracias también por apoyarnos antes."
    ama "E agradecemos também pelo apoio que nos deram anteriormente."

# game/scripts/c25/c25.rpy:1266
translate brazilian c25s002_KimSaved_3f754ca1:

    # aga "Como te he dicho, Ichigo me parece zafio y despreciable. No me gusta cómo trata a las mujeres en estas fiestas."
    aga "Como eu disse, acho o Ichigo grosseiro e desprezível. Não gosto de como ele trata as mulheres nessas festas."

# game/scripts/c25/c25.rpy:1267
translate brazilian c25s002_KimSaved_16cffa4d:

    # aga "No es que me haya puesto de vuestro lado, pero me ha gustado verle mordiendo el polvo por una vez."
    aga "Não é que eu tenha ficado do seu lado, mas gostei de vê-lo se dar mal pela primeira vez."

# game/scripts/c25/c25.rpy:1269
translate brazilian c25s002_KimSaved_06d54048:

    # ama "De todas formas, gracias."
    ama "De qualquer forma, obrigado."

# game/scripts/c25/c25.rpy:1271
translate brazilian c25s002_KimSaved_ec881d9d:

    # aga "Ahora te tengo que dejar. Tengo que seguir la conversación con nuestro amigo italiano."
    aga "Preciso ir agora. Preciso continuar minha conversa com nosso amigo italiano."

# game/scripts/c25/c25.rpy:1273
translate brazilian c25s002_KimSaved_39bd0ac4:

    # ama "Me gustaría llamarte algún día. Estamos reorientando el negocio y quizás México sería un buen sitio por el que comenzar."
    ama "Gostaria de ligar para você qualquer dia desses. Estamos reformulando os negócios e talvez o México seja um bom lugar para começar."

# game/scripts/c25/c25.rpy:1275
translate brazilian c25s002_KimSaved_91231aa9:

    # aga "Perfecto. Siempre es bueno tener otras opciones para según qué trabajos."
    aga "Perfeito. É sempre bom ter outras opções para certos trabalhos."

# game/scripts/c25/c25.rpy:1278
translate brazilian c25s002_KimSaved_953f8ab3:

    # "Mientras tanto..."
    "Enquanto isso..."

# game/scripts/c25/c25.rpy:1280
translate brazilian c25s002_KimSaved_ce95e0af:

    # "Cuando estás llegando a los camarotes, te cruzas con el general, que sale de una habitación con una de las chicas que había en la piscina."
    "Ao se aproximar das cabanas, você cruza com o general, que está saindo de um quarto com uma das garotas que estavam na piscina."

# game/scripts/c25/c25.rpy:1281
translate brazilian c25s002_KimSaved_42e729fb:

    # "Os ignoráis mutuamente más allá de una mirada. Tú sabes lo que él ha venido a hacer y el cree que tú vienes a lo mismo."
    "Vocês se ignoram, trocando apenas um olhar. Você sabe o que ele veio fazer, e ele pensa que você veio pelo mesmo motivo."

# game/scripts/c25/c25.rpy:1283
translate brazilian c25s002_KimSaved_d9241808:

    # "Entras en un camarote vacío y cierras la puerta con pestillo."
    "Você entra em uma cabine vazia e tranca a porta."

# game/scripts/c25/c25.rpy:1284
translate brazilian c25s002_KimSaved_ac57285e:

    # "La cama está hecha, con lo que parece que nadie lo ha usado."
    "A cama está feita, então parece que ninguém a usou."

# game/scripts/c25/c25.rpy:1286
translate brazilian c25s002_KimSaved_a0668ca1:

    # kim "¿Qué ha pasado ahí? ¿Por qué quería el Sr. Ichigo que me desnudara?"
    kim "O que aconteceu ali? Por que o Sr. Ichigo queria que eu me despisse?"

# game/scripts/c25/c25.rpy:1287
translate brazilian c25s002_KimSaved_6af850ee:

    # kim "¿Qué hacéis aquí [ama] y tú? ¿Iron Fist es la compañía rival de la que hablabais?"
    kim "O que você está fazendo aqui, [ama]? Punho de Ferro é a empresa rival da qual você estava falando?"

# game/scripts/c25/c25.rpy:1288
translate brazilian c25s002_KimSaved_edea03ab:

    # mc "Sí, [kim]. Iron Fist es la empresa que quería comprar NTR. Y cuando nos hemos negado, han intentado usarte para castigarnos."
    mc "Sim, [kim]. A Iron Fist é a empresa que queria comprar a NTR. E quando recusamos, eles tentaram usar você para nos punir."

# game/scripts/c25/c25.rpy:1289
translate brazilian c25s002_KimSaved_b414de14:

    # mc "¿Es el mismo yate donde estuviste el miércoles?"
    mc "É este o mesmo iate em que você estava na quarta-feira?"

# game/scripts/c25/c25.rpy:1291
translate brazilian c25s002_KimSaved_37c6da68:

    # kim "Sí, pero entonces era diferente. Sólo había militares de uniforme, y no vi nada como lo de las chicas sirviendo como bandejas de sushi."
    kim "Sim, mas era diferente naquela época. Só havia militares uniformizados, e eu não vi nada parecido com as garotas servindo de bandejas de sushi."

# game/scripts/c25/c25.rpy:1292
translate brazilian c25s002_KimSaved_c649fab0:

    # kim "Pero no me moví del helipuerto, con lo que tampoco puedo asegurar que no pasara."
    kim "Mas eu não me movi do heliponto, então não posso afirmar com certeza que isso não aconteceu."

# game/scripts/c25/c25.rpy:1293
translate brazilian c25s002_KimSaved_5bee00e6:

    # mc "¿Y las ametralladoras en la cubierta no te hicieron pensar nada raro?"
    mc "E as metralhadoras no convés não lhe fizeram pensar em nada estranho?"

# game/scripts/c25/c25.rpy:1295
translate brazilian c25s002_KimSaved_528f1ee9:

    # kim "No soy estúpida, [mc]. Si hubiera visto las ametralladoras se lo hubiera comentado a [eva] y a [ama]. Me hubiera parecido sospechoso."
    kim "Eu não sou estúpido, [mc]. Se eu tivesse visto as metralhadoras, teria mencionado isso a [eva] e [ama]. Eu teria achado suspeito."

# game/scripts/c25/c25.rpy:1296
translate brazilian c25s002_KimSaved_e911ec7b:

    # kim "Pero estaban tapadas con unas lonas grises. Hasta que no he llegado hoy no las he visto."
    kim "Mas estavam cobertos com lonas cinzentas. Só os vi quando cheguei hoje."

# game/scripts/c25/c25.rpy:1297
translate brazilian c25s002_KimSaved_faff3186:

    # mc "Supongo que no había prostitutas tampoco, ¿no?"
    mc "Imagino que também não havia prostitutas, não é?"

# game/scripts/c25/c25.rpy:1299
translate brazilian c25s002_KimSaved_55b0a9b9:

    # kim "No, ni tampoco mafiosos serbios, italianos, o chinos. Adeline ha estado conmigo casi toda la tarde, y era ella la que acompañaba a los invitados."
    kim "Não, nem mafiosos sérvios, italianos ou chineses. Adeline esteve comigo quase a tarde toda e foi ela quem acompanhou os convidados."

# game/scripts/c25/c25.rpy:1300
translate brazilian c25s002_KimSaved_3fb319c0:

    # kim "Lo mismo pasó el otro día, pero hacia el final del evento me hicieron ir a la cubierta de la piscina para ayudar a recoger."
    kim "A mesma coisa aconteceu outro dia, mas perto do final do evento me mandaram ir até a área da piscina para ajudar na limpeza."

# game/scripts/c25/c25.rpy:1302
translate brazilian c25s002_KimSaved_238d5632:

    # "Suena tu teléfono. Es un mensaje de [ama] indicándote que te quedes en el camarote hasta que ella te lo diga. No le dices nada a [kim]."
    "Seu telefone toca. É uma mensagem de [ama] dizendo para você ficar na cabine até que ela diga o contrário. Você não diz nada para [kim]."

# game/scripts/c25/c25.rpy:1304
translate brazilian c25s002_KimSaved_62d537a1:

    # kim "Hoy ha sido un poco diferente. Yo tenía órdenes de quedarme en el helipuerto hasta que llegara el último helicóptero."
    kim "Hoje foi um pouco diferente. Recebi ordens para ficar no heliporto até a chegada do último helicóptero."

# game/scripts/c25/c25.rpy:1305
translate brazilian c25s002_KimSaved_d87c0a2d:

    # kim "Era el vuestro. No me habían dicho el nombre de la empresa."
    kim "Era seu. Eles não me disseram o nome da empresa."

# game/scripts/c25/c25.rpy:1306
translate brazilian c25s002_KimSaved_4693061c:

    # mc "Lo han hecho de tal forma que te mantenían apartada y segura hasta que fuera necesario utilizarte para intentar hacernos daño."
    mc "Eles fizeram isso de tal forma que te mantiveram afastado e em segurança até que fosse necessário usá-lo para tentar nos ferir."

# game/scripts/c25/c25.rpy:1307
translate brazilian c25s002_KimSaved_8504494e:

    # mc "Siento que te hayas visto involucrada en esto."
    mc "Sinto muito que você tenha se envolvido nisso."

# game/scripts/c25/c25.rpy:1309
translate brazilian c25s002_KimSaved_6e363e6a:

    # kim "Gracias por salvarme. Tú no tienes la culpa, pero has evitado que tuviera que hacer... eso."
    kim "Obrigado por me salvar. Não é sua culpa, mas você me impediu de ter que fazer... aquilo."

# game/scripts/c25/c25.rpy:1310
translate brazilian c25s002_KimSaved_88a1d046:

    # mc "No podía aceptar que te usaran para atacar a NTR. No por NTR, sino por ti."
    mc "Eu não conseguia aceitar que eles estivessem usando você para atacar o NTR. Não por causa do NTR, mas por sua causa."

# game/scripts/c25/c25.rpy:1311
translate brazilian c25s002_KimSaved_5558385b:

    # mc "Nunca he compartido lo de que los daños colaterales son necesarios, y a Ichigo parece que no le importaba usarte a ti para darnos una lección."
    mc "Eu nunca concordei que danos colaterais sejam necessários, e Ichigo não pareceu se importar em usar você para nos dar uma lição."

# game/scripts/c25/c25.rpy:1313
translate brazilian c25s002_KimSaved_e3964144:

    # kim "Pero la lección se la has dado tú. Espero que no tenga consecuencias para vosotros. Para mí..."
    kim "Mas você lhes deu uma lição. Espero que isso não tenha consequências para você. Para mim..."

# game/scripts/c25/c25.rpy:1314
translate brazilian c25s002_KimSaved_8f21a839:

    # mc "¿Qué puede hacer? No te contrató directamente. Tus jefes son la agencia, ¿no?"
    mc "O que você pode fazer? Ele não te contratou diretamente. Seus chefes são a agência, certo?"

# game/scripts/c25/c25.rpy:1316
translate brazilian c25s002_KimSaved_36f0b49e:

    # kim "Sí, pero si pone alguna queja en la agencia sobre mí, posiblemente no me vuelvan a contratar."
    kim "Sim, mas se você registrar alguma reclamação sobre mim na agência, provavelmente eles não me contratarão novamente."

# game/scripts/c25/c25.rpy:1317
translate brazilian c25s002_KimSaved_6e2ccdc5:

    # mc "No lo había pensado... En ese caso podríamos hablar con la agencia. Supongo que no les gustará que te hayan querido usar como bandeja de sushi."
    mc "Eu não tinha pensado nisso... Nesse caso, poderíamos falar com a agência. Imagino que eles não ficarão nada contentes por terem tentado te usar como um prato de sushi."

# game/scripts/c25/c25.rpy:1319
translate brazilian c25s002_KimSaved_f63a7ab0:

    # kim "Sería mi palabra contra la del cliente. No serviría de nada. Cuando casi me obliga a desnudarme no había nadie más de la agencia."
    kim "Seria a minha palavra contra a do cliente. Não adiantaria nada. Quando ele quase me obrigou a tirar a roupa, não havia mais ninguém da agência por perto."

# game/scripts/c25/c25.rpy:1320
translate brazilian c25s002_KimSaved_daba12f7:

    # kim "Las chicas del sushi no eran de mi agencia, y las prostitutas tampoco."
    kim "As garotas do sushi não eram da minha agência, e as prostitutas também não."

# game/scripts/c25/c25.rpy:1321
translate brazilian c25s002_KimSaved_69eaf061:

    # mc "¿La agencia abre mañana? Es domingo."
    mc "A agência estará aberta amanhã? É domingo."

# game/scripts/c25/c25.rpy:1323
translate brazilian c25s002_KimSaved_55cb149e:

    # kim "Creo que no. ¿Por qué lo preguntas?"
    kim "Acho que não. Por que você pergunta?"

# game/scripts/c25/c25.rpy:1324
translate brazilian c25s002_KimSaved_af574919:

    # mc "Porque se me está ocurriendo una idea. Tendré que hablar con [ama]."
    mc "Porque estou tendo uma ideia. Terei que falar com [ama]."

# game/scripts/c25/c25.rpy:1326
translate brazilian c25s002_KimSaved_d52bd857:

    # "[kim] se derrumba sobre la cama, con la cara ente las manos."
    "[kim] desaba na cama, com o rosto entre as mãos."

# game/scripts/c25/c25.rpy:1327
translate brazilian c25s002_KimSaved_48e69bb0:

    # mc "¿Estás bien, [kim]?"
    mc "Você está bem, [kim]?"

# game/scripts/c25/c25.rpy:1329
translate brazilian c25s002_KimSaved_0b1affd7:

    # kim "Ha empezado a temblarme todo. Me he puesto muy nerviosa con la situación del Sr. Ichigo, y supongo que..."
    kim "Meu corpo inteiro começou a tremer. Fiquei muito nervoso com a situação do Sr. Ichigo, e acho que..."

# game/scripts/c25/c25.rpy:1330
translate brazilian c25s002_KimSaved_46237382:

    # mc "La adrenalina del momento te está abandonando."
    mc "A adrenalina do momento está passando."

# game/scripts/c25/c25.rpy:1331
translate brazilian c25s002_KimSaved_0815777d:

    # kim "Sí, no sabía cómo reaccionar. Tenía ganas de salir corriendo, pero no había dónde huir."
    kim "Sim, eu não sabia como reagir. Senti vontade de fugir, mas não havia para onde correr."

# game/scripts/c25/c25.rpy:1332
translate brazilian c25s002_KimSaved_c36133f6:

    # mc "¿Quieres tumbarte un rato? Parece que vamos a estar un rato aquí..."
    mc "Você gostaria de se deitar um pouco? Parece que ficaremos aqui por um bom tempo..."

# game/scripts/c25/c25.rpy:1334
translate brazilian c25s002_KimSaved_02e334cc:

    # kim "No sé lo que quiero, [mc]. Quiero estar lejos de este barco..."
    kim "Não sei o que quero. Quero estar bem longe deste navio..."

# game/scripts/c25/c25.rpy:1335
translate brazilian c25s002_KimSaved_d56b9c53:

    # mc "Lo entiendo."
    mc "Eu entendo."

# game/scripts/c25/c25.rpy:1336
translate brazilian c25s002_KimSaved_a90b0a0c:

    # kim "Quiero que me abraces, sentirme segura..."
    kim "Quero que você me abrace, para me fazer sentir segura..."

# game/scripts/c25/c25.rpy:1337
translate brazilian c25s002_KimSaved_2b797475:

    # mc "Eso puedo hacerlo, al menos lo de abrazarte. Ven aquí."
    mc "Posso fazer isso, pelo menos a parte do abraço. Vem cá."

# game/scripts/c25/c25.rpy:1339
translate brazilian c25s002_KimSaved_2ad592c1:

    # kim "Se está bien aquí."
    kim "É um lugar agradável."

# game/scripts/c25/c25.rpy:1340
translate brazilian c25s002_KimSaved_bc59560f:

    # mc "Podemos estar así todo el tiempo que quieras."
    mc "Podemos ficar assim pelo tempo que você quiser."

# game/scripts/c25/c25.rpy:1346
translate brazilian c25s002_KimSaved_f501db08:

    # kim "Soy una cobarde, [mc]."
    kim "Eu sou um covarde, [mc]."

# game/scripts/c25/c25.rpy:1347
translate brazilian c25s002_KimSaved_6be98b58:

    # mc "No lo eres, [kim]. Creo que nadie habría sabido reaccionar en tu situación."
    mc "Você não está, [kim]. Acho que ninguém saberia como reagir na sua situação."

# game/scripts/c25/c25.rpy:1348
translate brazilian c25s002_KimSaved_674422e7:

    # mc "Estoy seguro de que, si hubiera tardado un par de segundos en decirle a Ichigo que te traía al camarote, lo hubiera hecho [ama]."
    mc "Tenho certeza que se tivesse levado alguns segundos para dizer ao Ichigo que eu estava te levando para a cabine, eu teria feito isso [ama]."

# game/scripts/c25/c25.rpy:1349
translate brazilian c25s002_KimSaved_09255eb3:

    # mc "Es la única que está entrenada para reaccionar rápido bajo presión."
    mc "Ela é a única treinada para reagir rapidamente sob pressão."

# game/scripts/c25/c25.rpy:1351
translate brazilian c25s002_KimSaved_ca03c492:

    # kim "Pero tú lo has hecho y no estás entrenado. Yo me he quedado ahí, sin saber que hacer, como un conejo deslumbrado por los faros de un coche."
    kim "Mas você conseguiu, e você não tem treinamento. Eu fiquei lá parado, sem saber o que fazer, como um coelho cego pelos faróis de um carro."

# game/scripts/c25/c25.rpy:1352
translate brazilian c25s002_KimSaved_302fb5f9:

    # mc "No le des más vueltas. Lo importante es que estás a salvo."
    mc "Não pense demais. O importante é que você esteja em segurança."

# game/scripts/c25/c25.rpy:1353
translate brazilian c25s002_KimSaved_ef0f3a70:

    # mc "Eso no te convierte en una cobarde."
    mc "Isso não faz de você um covarde."

# game/scripts/c25/c25.rpy:1355
translate brazilian c25s002_KimSaved_5709a08c:

    # kim "Si no fuese una cobarde te estaría besando ahora mismo."
    kim "Se eu não fosse covarde, estaria te beijando agora mesmo."

# game/scripts/c25/c25.rpy:1356
translate brazilian c25s002_KimSaved_f0ff79a3:

    # mc "No tienes por qué hacerlo por agradecimiento. [ama] hubiera hecho lo mismo si le hubiera dado tiempo."
    mc "Você não precisa fazer isso por gratidão. [ama] Eu teria feito o mesmo se tivesse tido tempo."

# game/scripts/c25/c25.rpy:1358
translate brazilian c25s002_KimSaved_c753e785:

    # kim "No sería... sólo... por agradecimiento..."
    kim "Não seria... apenas... por gratidão..."

# game/scripts/c25/c25.rpy:1360
translate brazilian c25s002_KimSaved_9730c504:

    # mc "Pero querías hablar con mi madre, ¿no?"
    mc "Mas você queria falar com a minha mãe, não é?"

# game/scripts/c25/c25.rpy:1362
translate brazilian c25s002_KimSaved_6a9a884c:

    # mc "Pero querías hablar con [mar], ¿no?"
    mc "Mas você queria falar com [mar], não é?"

# game/scripts/c25/c25.rpy:1364
translate brazilian c25s002_KimSaved_ebf4f5a8:

    # kim "Sí, y lo hice mientras estabais en Monterey."
    kim "Sim, e fiz isso enquanto você estava em Monterey."

# game/scripts/c25/c25.rpy:1365
translate brazilian c25s002_KimSaved_a8eeec1e:

    # kim "Otra muestra de cobardía. Me tuvo que obligar [kat]. Me hizo lo que [deb.nick] te hizo a ti con [lis]."
    kim "Outro exemplo de covardia. Ele teve que me forçar [kat]. Ele fez comigo o que [deb.nick] fez com você com [lis]."

# game/scripts/c25/c25.rpy:1384
translate brazilian c25s002_KimRoute_de7b367e:

    # kim "Me dijo que no le importaba que..."
    kim "Ele me disse que não se importava com isso..."

# game/scripts/c25/c25.rpy:1387
translate brazilian c25s002_KimRoute_3ad23dec:

    # kim "¿QUÉ? ¿Has dicho que vas a besarme?"
    kim "O QUÊ? Você disse que vai me beijar?"

# game/scripts/c25/c25.rpy:1390
translate brazilian c25s002_KimRoute_5e958d49:

    # "Vale más una imagen, o en este caso un beso, que mil palabras. Acallas sus preguntas poniendo tus labios sobre los suyos."
    "Uma imagem, ou neste caso um beijo, vale mais que mil palavras. Você silencia as perguntas dele colocando seus lábios nos dele."

# game/scripts/c25/c25.rpy:1391
translate brazilian c25s002_KimRoute_17df26f5:

    # "Se queda paralizada como un conejo deslumbrado por los faros de un coche."
    "Ela congela como um coelho cegado pelos faróis de um carro."

# game/scripts/c25/c25.rpy:1392
translate brazilian c25s002_KimRoute_70763c3a:

    # "Es como besar una estatua. Una estatua que respira en tu boca, y cuyos labios son deliciosamente suaves."
    "É como beijar uma estátua. Uma estátua que respira na sua boca e cujos lábios são deliciosamente macios."

# game/scripts/c25/c25.rpy:1394
translate brazilian c25s002_KimRoute_4dfbacf4:

    # "La parálisis tan solo dura unos segundos, hasta que su cerebro procesa lo que está pasando."
    "A paralisia dura apenas alguns segundos, até que seu cérebro processe o que está acontecendo."

# game/scripts/c25/c25.rpy:1395
translate brazilian c25s002_KimRoute_ab3af1fa:

    # "Entonces la estatua cobra vida y empieza a devolverte el beso torpemente, casi inconscientemente, dejándose llevar por sus instintos."
    "Então a estátua ganha vida e começa a retribuir o beijo de forma desajeitada, quase inconscientemente, cedendo aos seus instintos."

# game/scripts/c25/c25.rpy:1397
translate brazilian c25s002_KimRoute_4eeeefb6:

    # "Por un momento se tensa antes de separarse de ti y darte la espalda."
    "Por um instante, ele fica tenso antes de se afastar de você e lhe virar as costas."

# game/scripts/c25/c25.rpy:1398
translate brazilian c25s002_KimRoute_6b7d9638:

    # kim "¡No!"
    kim "Não!"

# game/scripts/c25/c25.rpy:1399
translate brazilian c25s002_KimRoute_b31a7ac8:

    # mc "¿No? ¿A qué te refieres?"
    mc "Não? Como assim?"

# game/scripts/c25/c25.rpy:1401
translate brazilian c25s002_KimRoute_60c08b65:

    # kim "No soy estúpida, [mc]."
    kim "Eu não sou estúpido, [mc]."

# game/scripts/c25/c25.rpy:1402
translate brazilian c25s002_KimRoute_783432b5:

    # mc "Lo sé, pero sigo sin saber a qué te refieres."
    mc "Eu sei, mas ainda não entendi o que você quer dizer."

# game/scripts/c25/c25.rpy:1404
translate brazilian c25s002_KimRoute_923f5d13:

    # kim "Sé para qué se usan estos camarotes..."
    kim "Eu sei para que essas cabines são usadas..."

# game/scripts/c25/c25.rpy:1405
translate brazilian c25s002_KimRoute_03a5515f:

    # mc "¿Crees que Ichigo y yo nos hemos puesto de acuerdo para que montase el espectáculo en la cubierta y tuviera la oportunidad de traerte aquí y tener sexo contigo?"
    mc "Você acha que eu e o Ichigo conspiramos para que ele desse um show no convés só para ter a chance de te trazer aqui e transar com você?"

# game/scripts/c25/c25.rpy:1406
translate brazilian c25s002_KimRoute_c6196eec:

    # kim "No... Dicho en voz alta... Parece que sí. Soy estúpida."
    kim "Não... Falando em voz alta... Parece que sim. Sou estúpido."

# game/scripts/c25/c25.rpy:1407
translate brazilian c25s002_KimRoute_98cffde8:

    # mc "No lo eres. Hoy te han pasado cosas raras y tu mente aún las está procesando."
    mc "Você não está. Coisas estranhas aconteceram com você hoje, e sua mente ainda está processando-as."

# game/scripts/c25/c25.rpy:1409
translate brazilian c25s002_KimRoute_a7dd6f21:

    # kim "¿Como que me beses?"
    kim "O que você quer dizer com \"me beije\"?"

# game/scripts/c25/c25.rpy:1410
translate brazilian c25s002_KimRoute_4d41733f:

    # mc "Bueno, eso no lo consideraría raro. He estado esperando mucho tiempo para hacerlo."
    mc "Bem, eu não consideraria isso estranho. Já faz muito tempo que estou esperando para fazer isso."

# game/scripts/c25/c25.rpy:1412
translate brazilian c25s002_KimRoute_3529c579:

    # kim "Sabes que podrías haberlo hecho hace varios días, ¿verdad?"
    kim "Você sabe que poderia ter feito isso há vários dias, não é?"

# game/scripts/c25/c25.rpy:1414
translate brazilian c25s002_KimRoute_0a28e4c0:

    # mc "No. No hasta que no hubieras tenido la conversación con mi madre."
    mc "Não. Só depois de você conversar com a minha mãe."

# game/scripts/c25/c25.rpy:1416
translate brazilian c25s002_KimRoute_bd6e224c:

    # mc "No. No hasta que no hubieras tenido la conversación con [mar]."
    mc "Não. Não até que você tenha conversado com [mar]."

# game/scripts/c25/c25.rpy:1417
translate brazilian c25s002_KimRoute_cd09315c:

    # mc "No te hubieras sentido a gusto si lo hubiera hecho antes de esa conversación."
    mc "Você não teria se sentido à vontade se eu tivesse feito isso antes daquela conversa."

# game/scripts/c25/c25.rpy:1419
translate brazilian c25s002_KimRoute_bb564976:

    # kim "Pero ahora... me sentiría a gusto si lo repitieras... Lo sabes, ¿verdad?"
    kim "Mas agora... eu me sentiria confortável se você fizesse isso de novo... Você sabe disso, não é?"

# game/scripts/c25/c25.rpy:1420
translate brazilian c25s002_KimRoute_d642f603:

    # mc "*Risa* Lo sé."
    mc "*Risos* Eu sei."

# game/scripts/c25/c25.rpy:1422
translate brazilian c25s002_KimRoute_32249ab8:

    # "Vuestros labios vuelven a unirse. Esta vez está preparada y el beso devuelto es mucho menos torpe."
    "Seus lábios se encontram novamente. Desta vez, ela está pronta, e o beijo de volta é muito menos constrangedor."

# game/scripts/c25/c25.rpy:1423
translate brazilian c25s002_KimRoute_d8f636f5:

    # "Y mucho más largo."
    "E por muito mais tempo."

# game/scripts/c25/c25.rpy:1424
translate brazilian c25s002_KimRoute_99e27d59:

    # "La tensión de todo lo que ha pasado en la última hora desaparece por completo, sustituida por pasión."
    "A tensão de tudo o que aconteceu na última hora desaparece completamente, substituída pela paixão."

# game/scripts/c25/c25.rpy:1425
translate brazilian c25s002_KimRoute_0c1f6b62:

    # "El beso dura hasta que [kim] empieza a respirar entrecortadamente en tu boca."
    "O beijo dura até que [kim] comece a respirar pesadamente em sua boca."

# game/scripts/c25/c25.rpy:1427
translate brazilian c25s002_KimRoute_2fb47448:

    # kim "*Jadeo* Deberías dejarme respirar. Tengo el corazón que parece que me va a explotar en el pecho."
    kim "*Suspiro* Deixe-me respirar. Meu coração parece que vai explodir no meu peito."

# game/scripts/c25/c25.rpy:1428
translate brazilian c25s002_KimRoute_8113615d:

    # mc "*Risa* Eso no tiene que ver con la falta de aire, preciosa. El mío también está latiendo deprisa."
    mc "*Risos* Isso não tem nada a ver com falta de ar, querida. O meu também está acelerado."

# game/scripts/c25/c25.rpy:1430
translate brazilian c25s002_KimRoute_27e3476b:

    # kim "¡No te rías de mí!"
    kim "Não ria de mim!"

# game/scripts/c25/c25.rpy:1431
translate brazilian c25s002_KimRoute_dee052a6:

    # mc "Nunca lo haría."
    mc "Eu jamais faria isso."

# game/scripts/c25/c25.rpy:1434
translate brazilian c25s002_KimRoute_251628e3:

    # kim "¿Ni siquiera cuando me dijiste que debería usar el maquillaje corporal?"
    kim "Nem mesmo quando você me disse que eu deveria usar maquiagem corporal?"

# game/scripts/c25/c25.rpy:1435
translate brazilian c25s002_KimRoute_b09b2ec0:

    # mc "Ni siquiera entonces. Te lo dije porque parecías más segura de ti misma y porque te importaba lo que tus compañeras pensaran."
    mc "Nem mesmo naquela época. Eu te disse isso porque você parecia mais confiante e porque se importava com o que seus colegas pensavam."

# game/scripts/c25/c25.rpy:1436
translate brazilian c25s002_KimRoute_df03c4cf:

    # mc "No porque a mí no me guste tu piel."
    mc "Não é porque eu não goste da sua pele."

# game/scripts/c25/c25.rpy:1438
translate brazilian c25s002_KimRoute_71c081be:

    # kim "¿De verdad te gusta?"
    kim "Você realmente gosta disso?"

# game/scripts/c25/c25.rpy:1439
translate brazilian c25s002_KimRoute_63d47a1c:

    # mc "Es como un mapa que me encantaría pasarme una noche recorriendo."
    mc "É como um mapa que eu adoraria explorar durante uma noite inteira."

# game/scripts/c25/c25.rpy:1441
translate brazilian c25s002_KimRoute_fbc7097e:

    # kim "Puedes hacerlo ahora..."
    kim "Você pode fazer isso agora..."

# game/scripts/c25/c25.rpy:1444
translate brazilian c25s002_KimRoute_123f70fa:

    # kim "Lo sé. Lo descubrí el día que me dijiste que no necesitaba usar el maquillaje corporal."
    kim "Eu sei. Descobri isso no dia em que você me disse que eu não precisava usar maquiagem corporal."

# game/scripts/c25/c25.rpy:1445
translate brazilian c25s002_KimRoute_b8ee195b:

    # kim "Visto ahora que han pasado dos semanas... podías haberte reído de mí, y no lo hiciste."
    kim "Olhando para trás agora, depois de duas semanas... você poderia ter rido de mim, mas não riu."

# game/scripts/c25/c25.rpy:1446
translate brazilian c25s002_KimRoute_0514034b:

    # mc "Nunca me reiría de ti. Y menos por algo que para ti es tan importante."
    mc "Eu jamais riria de você. Principalmente não por algo tão importante para você."

# game/scripts/c25/c25.rpy:1447
translate brazilian c25s002_KimRoute_0f402e6c:

    # mc "Me gusta tu piel y..."
    mc "Gosto da sua pele e..."

# game/scripts/c25/c25.rpy:1449
translate brazilian c25s002_KimRoute_269585ef:

    # kim "Y es como un mapa que te pasarías la noche recorriendo con los dedos..."
    kim "E é como um mapa que você poderia passar a noite inteira traçando com os dedos..."

# game/scripts/c25/c25.rpy:1450
translate brazilian c25s002_KimRoute_c13c0904:

    # mc "¿Te acuerdas?"
    mc "Você se lembra?"

# game/scripts/c25/c25.rpy:1452
translate brazilian c25s002_KimRoute_14366cd2:

    # kim "No podría olvidarlo. En ese momento empecé a sentir algo por ti. Aún no lo sabía, pero... me di cuenta de que no me mirabas como me mira todo el mundo."
    kim "Eu jamais conseguiria esquecer. Foi aí que comecei a sentir algo por você. Eu ainda não sabia, mas... percebi que você não me olhava como todo mundo."

# game/scripts/c25/c25.rpy:1453
translate brazilian c25s002_KimRoute_ac18ac78:

    # mc "[kim], eres especial. Eres preciosa. No eres como las demás chicas, cierto. Pero no por ello eres menos hermosa."
    mc "[kim], você é especial. Você é linda. Você não é como as outras garotas, isso é verdade. Mas isso não a torna menos linda."

# game/scripts/c25/c25.rpy:1455
translate brazilian c25s002_KimRoute_c043af28:

    # kim "Sabes que podrías empezar a recorrer ese mapa ahora, ¿no?"
    kim "Você sabe que poderia começar a explorar esse mapa agora, não é?"

# game/scripts/c25/c25.rpy:1456
translate brazilian c25s002_KimRoute_47c8b1d7:

    # mc "No creo que sea el lugar más adecuado para nuestra primera vez."
    mc "Não acho que seja o lugar mais adequado para nossa primeira vez."

# game/scripts/c25/c25.rpy:1458
translate brazilian c25s002_KimRoute_c85dbdd9:

    # kim "¿Qué? ¡No! ¡No me refería a eso!"
    kim "O quê? Não! Não foi isso que eu quis dizer!"

# game/scripts/c25/c25.rpy:1459
translate brazilian c25s002_KimRoute_7123177f:

    # kim "No me gustaría que nuestra primera vez fuera en este barco, ni en un camarote donde... ya sabes..."
    kim "Eu não gostaria que nossa primeira vez fosse neste navio, ou em uma cabine onde... você sabe..."

# game/scripts/c25/c25.rpy:1460
translate brazilian c25s002_KimRoute_04b4d579:

    # mc "Exacto. ¿A qué te referías, entonces?"
    mc "Exatamente. O que você quis dizer, então?"

# game/scripts/c25/c25.rpy:1462
translate brazilian c25s002_KimRoute_326bcf4a:

    # kim "A que puedes recorrer el mapa... en las zonas visibles..."
    kim "Aposto que você consegue explorar o mapa... nas áreas visíveis..."

# game/scripts/c25/c25.rpy:1463
translate brazilian c25s002_KimRoute_b3777a72:

    # kim "Me encantaría sentir tus dedos sobre la piel, pero no me gustaría quitarme la ropa... aquí."
    kim "Adoraria sentir seus dedos na minha pele, mas não gostaria de tirar a roupa... aqui."

# game/scripts/c25/c25.rpy:1464
translate brazilian c25s002_KimRoute_5f0d1ce8:

    # mc "Me parece una idea genial. Túmbate mientras me quito la chaqueta."
    mc "Parece uma ótima ideia. Deite-se enquanto eu tiro o casaco."

# game/scripts/c25/c25.rpy:1466
translate brazilian c25s002_KimRoute_844c5ddf:

    # kim "¿Así?"
    kim "Então?"

# game/scripts/c25/c25.rpy:1467
translate brazilian c25s002_KimRoute_fd671cf1:

    # mc "Así estás perfecta. Siempre estás perfecta."
    mc "Você está perfeita assim. Você sempre está perfeita."

# game/scripts/c25/c25.rpy:1468
translate brazilian c25s002_KimRoute_7ee801e9:

    # mc "¿Puedo empezar a recorrer el mapa con los dedos?"
    mc "Posso começar a traçar o mapa com os dedos?"

# game/scripts/c25/c25.rpy:1469
translate brazilian c25s002_KimRoute_19047ffe:

    # kim "Cuando quieras..."
    kim "Sempre que você quiser..."

# game/scripts/c25/c25.rpy:1471
translate brazilian c25s002_KimRoute_525f2efb:

    # kim "¿Qué estás haciendo, [mc]?"
    kim "O que você está fazendo, [mc]?"

# game/scripts/c25/c25.rpy:1472
translate brazilian c25s002_KimRoute_8d43e436:

    # mc "*Risa* Ya te lo he dicho, recorrer el mapa con los dedos."
    mc "*Risos* Eu já te disse, trace o mapa com os dedos."

# game/scripts/c25/c25.rpy:1473
translate brazilian c25s002_KimRoute_7ee4012b:

    # kim "[mc], ¿puedes mirarme un momento?"
    kim "[mc], você pode olhar para mim por um instante?"

# game/scripts/c25/c25.rpy:1475
translate brazilian c25s002_KimRoute_add7085a:

    # "Una almohada salta inesperadamente de la mano de [kim] a tu cara."
    "Um travesseiro salta inesperadamente da mão de [kim] para o seu rosto."

# game/scripts/c25/c25.rpy:1476
translate brazilian c25s002_KimRoute_68fe5918:

    # kim "*Risa* Eso te pasa por reírte de mí. ¡Has dicho que nunca lo harías!"
    kim "*Risos* Bem feito para você, por rir de mim. Você disse que nunca faria isso!"

# game/scripts/c25/c25.rpy:1477
translate brazilian c25s002_KimRoute_29f541ee:

    # mc "*Risa* Al menos has quitado la chocolatina que había encima de la almohada antes de tirármela."
    mc "*Risos* Pelo menos você tirou a barra de chocolate que estava em cima do travesseiro antes de jogá-la em mim."

# game/scripts/c25/c25.rpy:1479
translate brazilian c25s002_KimRoute_567c60e0:

    # kim "*Risa* Me la he comido antes, cuando has empezado a hacer el tonto con el mapa de la pared."
    kim "*Risos* Eu comi mais cedo, quando você começou a mexer no mapa na parede."

# game/scripts/c25/c25.rpy:1480
translate brazilian c25s002_KimRoute_1f5fafdf:

    # mc "*Risa* He tenido suerte. No querría ser el protagonista del titular 'Pierde un ojo por culpa de una chocolatina'."
    mc "*Risos* Eu tive sorte. Não gostaria de ser o tema da manchete \"Perde um olho por causa de uma barra de chocolate\"."

# game/scripts/c25/c25.rpy:1481
translate brazilian c25s002_KimRoute_17de5028:

    # mc "¿Preparada?"
    mc "Preparar?"

# game/scripts/c25/c25.rpy:1483
translate brazilian c25s002_KimRoute_e4e2f81c:

    # kim "Cuando quieras."
    kim "Quando você quiser."

# game/scripts/c25/c25.rpy:1484
translate brazilian c25s002_KimRoute_40aecd78:

    # mc "¿Por dónde quieres que empiece?"
    mc "Por onde você quer que eu comece?"

# game/scripts/c25/c25.rpy:1485
translate brazilian c25s002_KimRoute_0f359ed0:

    # kim "Por donde quieras. Espero que en los próximos días encuentres el camino al tesoro en el mapa."
    kim "Como você preferir. Espero que encontre o caminho para o tesouro no mapa nos próximos dias."

# game/scripts/c25/c25.rpy:1486
translate brazilian c25s002_KimRoute_6cd87abd:

    # kim "Cuando estemos en algún otro sitio."
    kim "Quando estivermos em outro lugar."

# game/scripts/c25/c25.rpy:1488
translate brazilian c25s002_KimRoute_87c0778a:

    # "Empiezas a recorrer la suave mano de la modelo, recorriendo con la yema de tu dedo la frontera en su piel donde cambia de color."
    "Você começa a traçar o contorno da mão macia da modelo, passando a ponta do dedo ao longo da linha divisória da pele, onde a cor muda."

# game/scripts/c25/c25.rpy:1489
translate brazilian c25s002_KimRoute_fe816c23:

    # mc "¿Ves? Si usaras maquillaje corporal, no podría hacer esto. Los exploradores se perderían sin un mapa que seguir."
    mc "Viu? Se eu usasse pintura corporal, não conseguiria fazer isso. Os exploradores se perderiam sem um mapa para seguir."

# game/scripts/c25/c25.rpy:1490
translate brazilian c25s002_KimRoute_9c89e44b:

    # kim "*Risa* ¿Siempre le ves el lado bueno a las cosas?"
    kim "*Risos* Você sempre vê o lado bom das coisas?"

# game/scripts/c25/c25.rpy:1492
translate brazilian c25s002_KimRoute_e4ce436d:

    # mc "Si sólo tuviera que mirar el lado bueno de las cosas, nunca más podría apartar la mirada de donde la tengo puesta ahora mismo."
    mc "Se eu tivesse que ver apenas o lado bom das coisas, jamais conseguiria desviar o olhar de onde eles estão agora."

# game/scripts/c25/c25.rpy:1493
translate brazilian c25s002_KimRoute_59d67c2c:

    # kim "Es lo más bonito que me han dicho nunca, [mc]."
    kim "É a coisa mais gentil que alguém já me disse, [mc]."

# game/scripts/c25/c25.rpy:1495
translate brazilian c25s002_KimRoute_71648375:

    # mc "Este trozo en tu muslo me recuerda a un mapa medieval de Irlanda que vi una vez."
    mc "Essa tatuagem na sua coxa me lembra um mapa medieval da Irlanda que eu vi uma vez."

# game/scripts/c25/c25.rpy:1496
translate brazilian c25s002_KimRoute_9c61816a:

    # mc "Me podría pasar horas recorriendo las costas de nuestra Irlanda particular."
    mc "Eu poderia passar horas explorando o litoral da nossa própria Irlanda."

# game/scripts/c25/c25.rpy:1497
translate brazilian c25s002_KimRoute_65e64d28:

    # kim "Tus dedos me están dando escalofríos..."
    kim "Seus dedos estão me dando arrepios..."

# game/scripts/c25/c25.rpy:1499
translate brazilian c25s002_KimRoute_e651fd6a:

    # mc "¿Quieres que pare?"
    mc "Você quer que eu pare?"

# game/scripts/c25/c25.rpy:1500
translate brazilian c25s002_KimRoute_82cf176d:

    # kim "Quiero que sigas recorriéndome, pero ya lo sabes... sólo las zonas visibles..."
    kim "Quero que você continue me explorando, mas você já sabe... apenas as áreas visíveis..."

# game/scripts/c25/c25.rpy:1501
translate brazilian c25s002_KimRoute_4dd2773f:

    # kim "Solo de pensar en quitarme la ropa aquí... "
    kim "Estou pensando em tirar a roupa aqui mesmo..."

# game/scripts/c25/c25.rpy:1503
translate brazilian c25s002_KimRoute_6eaa78b0:

    # mc "Lo sé, preciosa. Le quitaría toda la magia."
    mc "Eu sei, querida. Isso acabaria com toda a magia."

# game/scripts/c25/c25.rpy:1504
translate brazilian c25s002_KimRoute_3d8f184c:

    # mc "Pero no te preocupes, hay suficientes zonas visibles que quiero recorrer."
    mc "Mas não se preocupe, há áreas visíveis suficientes que eu quero explorar."

# game/scripts/c25/c25.rpy:1505
translate brazilian c25s002_KimRoute_0ebc6125:

    # mc "Siempre me ha parecido espectacular esta forma, como si estuvieras en un baile de máscaras..."
    mc "Sempre achei esse estilo espetacular, como estar em um baile de máscaras..."

# game/scripts/c25/c25.rpy:1506
translate brazilian c25s002_KimRoute_bf728b61:

    # kim "Pero eso no es un mapa, entonces..."
    kim "Mas isso não é um mapa, então..."

# game/scripts/c25/c25.rpy:1507
translate brazilian c25s002_KimRoute_d6bb04a7:

    # mc "Si me dejas decir la cursilada del día, te diré que es el mapa que lleva a tus ojos. Es una de las partes que más me gustan de ti."
    mc "Se me permite dizer algo piegas hoje, direi que é o mapa que leva aos seus olhos. É uma das coisas que mais amo em você."

# game/scripts/c25/c25.rpy:1509
translate brazilian c25s002_KimRoute_1811c1ca:

    # kim "*Risa* Sí. Ha sonado muy cursi. Pero me ha encantado."
    kim "*Risos* Sim. Isso soou muito brega. Mas eu adorei."

# game/scripts/c25/c25.rpy:1510
translate brazilian c25s002_KimRoute_1dea0ec7:

    # kim "Normalmente me dicen que parezco un mapache..."
    kim "As pessoas geralmente me dizem que eu pareço um guaxinim..."

# game/scripts/c25/c25.rpy:1511
translate brazilian c25s002_KimRoute_d2f6e034:

    # mc "¡Pues te nombro Miss Mapache California 2023! *Risa*"
    mc "Bem, por meio deste, eu te nomeio Miss Guaxinim da Califórnia 2023! *Risos*"

# game/scripts/c25/c25.rpy:1512
translate brazilian c25s002_KimRoute_f45ae86e:

    # kim "*Risa* ¡Eres increíble!"
    kim "*Risos* Você é incrível!"

# game/scripts/c25/c25.rpy:1514
translate brazilian c25s002_KimRoute_d23d7163:

    # mc "¿Sabes lo que le falta a este mapa?"
    mc "Você sabe o que está faltando neste mapa?"

# game/scripts/c25/c25.rpy:1515
translate brazilian c25s002_KimRoute_5ea9857f:

    # kim "¿Qué?"
    kim "Que?"

# game/scripts/c25/c25.rpy:1516
translate brazilian c25s002_KimRoute_bf19f9f2:

    # mc "Besos. Le faltan muchos besos."
    mc "Beijos. Ela precisa de muitos beijos."

# game/scripts/c25/c25.rpy:1518
translate brazilian c25s002_KimRoute_2699c0f4:

    # "Vuelves a la mano, donde has empezado el recorrido por el mapa, repartiendo besos en sus nudillos, donde la piel cambia entre dos maravillosos colores."
    "Você retorna à mão, onde começou a jornada pelo mapa, distribuindo beijos em suas juntas, onde a pele alterna entre duas cores maravilhosas."

# game/scripts/c25/c25.rpy:1519
translate brazilian c25s002_KimRoute_8ca6c868:

    # kim "Aquí arriba hay un lugar que no has explorado aún."
    kim "Aqui em cima existe um lugar que você ainda não explorou."

# game/scripts/c25/c25.rpy:1521
translate brazilian c25s002_KimRoute_d4c5a57a:

    # kim "Creo que también necesita besos."
    kim "Acho que ela também precisa de beijos."

# game/scripts/c25/c25.rpy:1522
translate brazilian c25s002_KimRoute_2f3d7147:

    # mc "Pero eso sería hacer trampas. ¿Te he visto alguna vez sin pintalabios? Ni siquiera en la piscina puedo recordarte sin pintalabios."
    mc "Mas isso seria trapaça. Alguma vez eu já te vi sem batom? Nem me lembro de te ver sem batom na piscina."

# game/scripts/c25/c25.rpy:1524
translate brazilian c25s002_KimRoute_fd0a466b:

    # kim "Creo que la primera vez que subimos al lago no llevaba. Se me había acabado."
    kim "Acho que não tinha nenhum na primeira vez que fomos ao lago. Tinha acabado."

# game/scripts/c25/c25.rpy:1525
translate brazilian c25s002_KimRoute_e11dbaca:

    # kim "Siempre llevo. Tengo unos labios muy feos..."
    kim "Eu sempre uso. Meus lábios são muito feios..."

# game/scripts/c25/c25.rpy:1526
translate brazilian c25s002_KimRoute_9e860ef4:

    # mc "Creo que eso debería decidirlo yo. Al menos decidir si me gustan."
    mc "Acho que essa deveria ser uma decisão minha. Pelo menos, decidir se gosto deles."

# game/scripts/c25/c25.rpy:1528
translate brazilian c25s002_KimRoute_4aff812e:

    # kim "Puedes empezar por explorarlos con los tuyos. A lo mejor consigues borrarlo..."
    kim "Você pode começar explorando-os por conta própria. Talvez você consiga excluí-lo..."

# game/scripts/c25/c25.rpy:1529
translate brazilian c25s002_KimRoute_a59fc07d:

    # mc "Suena como un buen plan."
    mc "Parece um bom plano."

# game/scripts/c25/c25.rpy:1530
translate brazilian c25s002_KimRoute_5188245c:

    # mc "Pero... es pintalabios de ese que no se quita ni con disolvente industrial, ¿verdad?"
    mc "Mas... é aquele tipo de batom que não sai nem com solvente industrial, né?"

# game/scripts/c25/c25.rpy:1532
translate brazilian c25s002_KimRoute_5a33ffe1:

    # kim "*Risa* Sí."
    kim "*Risos* Sim."

# game/scripts/c25/c25.rpy:1534
translate brazilian c25s002_KimRoute_3ab1f227:

    # "A ninguno de los dos os importa."
    "Nenhum de vocês se importa."

# game/scripts/c25/c25.rpy:1535
translate brazilian c25s002_KimRoute_21e845d9:

    # "Os besáis durante un largo rato. No sabéis si dos minutos o dos horas."
    "Vocês se beijam por um longo tempo. Você não sabe se foram dois minutos ou duas horas."

# game/scripts/c25/c25.rpy:1537
translate brazilian c25s002_KimRoute_0be07545:

    # "Tampoco os importa."
    "Você também não se importa."

# game/scripts/c25/c25.rpy:1539
translate brazilian c25s002_KimRoute_627f745d:

    # "Podrían haber sido dos años y, pese a todo, cuando suena tu móvil os hubiera costado igual separaros."
    "Poderiam ter sido dois anos e, apesar de tudo, quando seu telefone tocasse, seria igualmente difícil se separar."

# game/scripts/c25/c25.rpy:1541
translate brazilian c25s002_KimRoute_7cbbdce6:

    # mc "Es [ama]. El helicóptero nos está esperando."
    mc "É [ama]. O helicóptero está nos esperando."

# game/scripts/c25/c25.rpy:1542
translate brazilian c25s002_KimRoute_323ce83d:

    # kim "¿Nos vamos ya?"
    kim "Vamos agora?"

# game/scripts/c25/c25.rpy:1543
translate brazilian c25s002_KimRoute_95c1cc56:

    # mc "Sí. Ha hablado con Sound sobre ti."
    mc "Sim. Ele falou com a Sound sobre você."

# game/scripts/c25/c25.rpy:1544
translate brazilian c25s002_KimRoute_751c8964:

    # kim "El Sr. Sound parece un buen tipo."
    kim "O Sr. Sound parece ser um cara legal."

# game/scripts/c25/c25.rpy:1545
translate brazilian c25s002_KimRoute_3fa3fca9:

    # "Ni un átomo de pintalabios ha desaparecido de los labios de la azafata."
    "Nem um único átomo de batom desapareceu dos lábios da aeromoça."

# game/scripts/c25/c25.rpy:1551
translate brazilian c25s002_KimHome_e8ddb21c:

    # "El helicóptero os deja en el parking de la galería de tiro y [ama] os lleva a casa."
    "O helicóptero te deixa no estacionamento do estande de tiro e te leva para casa."

# game/scripts/c25/c25.rpy:1552
translate brazilian c25s002_KimHome_f47c7b0e:

    # "Estáis demasiado cansados para hablar sobre lo que ha pasado."
    "Você está muito cansado para falar sobre o que aconteceu."

# game/scripts/c25/c25.rpy:1555
translate brazilian c25s002_KimHome_d6744449:

    # "Al llegar a casa..."
    "Quando cheguei em casa..."

# game/scripts/c25/c25.rpy:1556
translate brazilian c25s002_KimHome_cf7b87b5:

    # kim "Gracias por todo, [ama]."
    kim "Obrigado por tudo, [ama]."

# game/scripts/c25/c25.rpy:1557
translate brazilian c25s002_KimHome_32108638:

    # ama "Yo no he hecho casi nada. Le tienes que dar las gracias al héroe de la noche."
    ama "Eu praticamente não fiz nada. Você tem que agradecer ao herói da noite."

# game/scripts/c25/c25.rpy:1558
translate brazilian c25s002_KimHome_cf685f34:

    # kim "Ahora lo haré, no te preocupes."
    kim "Farei isso agora, não se preocupe."

# game/scripts/c25/c25.rpy:1561
translate brazilian c25s002_KimHome_a14ad160:

    # kim "Te veo mañana, cielo. Estoy cansadísima."
    kim "Te vejo amanhã, querida. Estou exausta."

# game/scripts/c25/c25.rpy:1564
translate brazilian c25s002_KimHome_10b54872:

    # kim "Te veo mañana, [mc]. Estoy cansadísima."
    kim "Te vejo amanhã, [mc]. Estou exausto."

# game/scripts/c25/c25.rpy:1565
translate brazilian c25s002_KimHome_6a5181fc:

    # mc "Hasta mañana, guapísima. Descansa. Te lo mereces."
    mc "Te vejo amanhã, linda. Descanse bastante. Você merece."

# game/scripts/c25/c25.rpy:1567
translate brazilian c25s002_KimHome_a84efca4:

    # "[kim] se mete en casa sin decir una palabra más y sin mirar atrás."
    "[kim] entra na casa sem dizer mais uma palavra e sem olhar para trás."

# game/scripts/c25/c25.rpy:1570
translate brazilian c25s002_KimHome_b7a86c32:

    # ama "*Risita* Parece que habéis aprovechado el tiempo en el camarote."
    ama "*Risos* Parece que você aproveitou bem o tempo na cabine."

# game/scripts/c25/c25.rpy:1571
translate brazilian c25s002_KimHome_5ca885ad:

    # mc "Bueno, hemos hablado, una cosa ha llevado a la otra y... supongo que mañana os lo explicará en el grupo de WhatsUp."
    mc "Bem, nós conversamos, uma coisa levou à outra e... suponho que ele explicará isso para você amanhã no grupo do WhatsApp."

# game/scripts/c25/c25.rpy:1572
translate brazilian c25s002_KimHome_10fb1518:

    # mc "Por si tienes curiosidad, no nos hemos quitado la ropa. No era el mejor sitio para hacerlo."
    mc "Caso você esteja curioso, nós não tiramos a roupa. Não era o melhor lugar para isso."

# game/scripts/c25/c25.rpy:1574
translate brazilian c25s002_KimHome_300fa51b:

    # ama "No, [mc]. No tengo curiosidad. Tan solo me alegro por vosotros."
    ama "Não, [mc]. Não estou curioso. Estou apenas feliz por você."

# game/scripts/c25/c25.rpy:1575
translate brazilian c25s002_KimHome_8427c55c:

    # mc "Gracias, [ama]."
    mc "Obrigado, [ama]."

# game/scripts/c25/c25.rpy:1580
translate brazilian c25s002_KimHome_9b6c7699:

    # ama "Te veo mañana."
    ama "Vejo você amanhã."

# game/scripts/c25/c25.rpy:1581
translate brazilian c25s002_KimHome_0b433688:

    # mc "Hasta mañana, [ama]."
    mc "Até amanhã, [ama]."

# game/scripts/c25/c25.rpy:1583
translate brazilian c25s002_KimHome_fd824944:

    # mc "Espera, [ama]. Se me acaba de ocurrir una idea. ¿Tienes un momento?"
    mc "Espere, [ama]. Acabei de ter uma ideia. Você tem um minuto?"

# game/scripts/c25/c25.rpy:1585
translate brazilian c25s002_KimHome_9adc0781:

    # "Unos minutos después subes a tu habitación, pensando que, quizás, con la idea que se te ha ocurrido a última hora, quizás puedas proteger un poco a [kim]."
    "Alguns minutos depois você sobe para o seu quarto, pensando que, talvez, com a ideia que lhe ocorreu no último minuto, você possa proteger [kim] um pouco."

# game/scripts/c25/c25.rpy:1586
translate brazilian c25s002_KimHome_93ddaae3:

    # "Te desnudas y te metes en la cama. Compruebas el móvil un rato, esperando el correo electrónico que le has pedido a [ama]."
    "Você se despe e vai para a cama. Você checa seu celular por um tempo, esperando o e-mail que solicitou de [ama]."

# game/scripts/c25/c25.rpy:1587
translate brazilian c25s002_KimHome_eb780aab:

    # "Te duermes antes de que llegue."
    "Você adormece antes que chegue."

# game/scripts/c25/c25.rpy:1589
translate brazilian c25s002_KimHome_05d11916:

    # "Te despiertas en algún momento de la noche con una sensación extraña. Como de tener algo peludo en la boca."
    "Você acorda em algum momento da noite com uma sensação estranha. Como se tivesse algo peludo na boca."

# game/scripts/c25/c25.rpy:1591
translate brazilian c25s002_KimHome_d698d57f:

    # "Hay un precioso mapa con piernas acurrucado contra tu pecho, durmiendo profundamente."
    "Há um mapa lindo com as pernas encolhidas contra o seu peito, em sono profundo."

# game/scripts/c25/c25.rpy:1592
translate brazilian c25s002_KimHome_d593171b:

    # "Su respiración es relajada, como si estuviera en el lugar en el que se supone que debe estar."
    "Sua respiração é tranquila, como se ela estivesse no lugar certo."

# game/scripts/c25/c25.rpy:1593
translate brazilian c25s002_KimHome_927c40a6:

    # "Te duermes inmediatamente, sin ni siquiera pensar en que estás desnudo."
    "Você adormece imediatamente, sem nem pensar no fato de estar nu(a)."

# game/scripts/c25/c25.rpy:1601
translate brazilian c25s002_NoKimRoute_d820b3b1:

    # kim "Lo entiendo. Y también entiendo por qué no me quisiste dar una respuesta antes de que hablara con ella."
    kim "Entendo. E também entendo por que você não quis me dar uma resposta antes de eu falar com ela."

# game/scripts/c25/c25.rpy:1602
translate brazilian c25s002_NoKimRoute_aff10a86:

    # mc "¿Sí?"
    mc "Sim?"

# game/scripts/c25/c25.rpy:1604
translate brazilian c25s002_NoKimRoute_c504efb8:

    # kim "Te lo acabo de decir. Soy una cobarde. Y, al no darme una pista antes de que hablara con ella me has obligado a hacer algo que tenía miedo de hacer."
    kim "Eu acabei de te dizer. Sou um covarde. E ao não me dar nenhuma pista antes de eu falar com ela, você me forçou a fazer algo que eu tinha medo de fazer."

# game/scripts/c25/c25.rpy:1605
translate brazilian c25s002_NoKimRoute_79545ceb:

    # kim "Aunque [kat] tuviera que encerrarme con ella en la cocina."
    kim "Mesmo que [kat] eu tivesse que me trancar na cozinha com ela."

# game/scripts/c25/c25.rpy:1607
translate brazilian c25s002_NoKimRoute_091a3c8e:

    # kim "De alguna forma siempre nos diriges a hacer lo que necesitamos hacer. Y además haces que parezca idea nuestra."
    kim "De alguma forma, você sempre nos guia para fazer o que precisamos fazer. E você até faz parecer que a ideia foi nossa."

# game/scripts/c25/c25.rpy:1608
translate brazilian c25s002_NoKimRoute_d30da599:

    # kim "Gracias a haberlo hecho, [mar] y yo ahora estamos más unidas. Si me hubieras dicho que no querías salir conmigo, no hubiera pasado."
    kim "Graças a você, [mar] e eu estamos mais próximos agora. Se você tivesse me dito que não queria namorar comigo, isso não teria acontecido."

# game/scripts/c25/c25.rpy:1609
translate brazilian c25s002_NoKimRoute_afd7582e:

    # kim "No hubiéramos tenido la conversación y no nos sentiríamos como..."
    kim "Não teríamos tido essa conversa e não nos sentiríamos assim..."

# game/scripts/c25/c25.rpy:1610
translate brazilian c25s002_NoKimRoute_66a145a5:

    # mc "¿Como si fuera una segunda madre?"
    mc "Como uma segunda mãe?"

# game/scripts/c25/c25.rpy:1612
translate brazilian c25s002_NoKimRoute_243f3149:

    # kim "¿Qué? ¿Cómo lo sabes?"
    kim "O quê? Como você sabe?"

# game/scripts/c25/c25.rpy:1613
translate brazilian c25s002_NoKimRoute_801d1a94:

    # mc "Porque yo pasé por algo parecido con [sam]. Conozco la sensación de sentirte unido a alguien como si fuera una segunda madre."
    mc "Porque passei por algo semelhante com [sam]. Sei o que é sentir-se apegado a alguém como se fosse uma segunda mãe."

# game/scripts/c25/c25.rpy:1615
translate brazilian c25s002_NoKimRoute_76d80de5:

    # mc "O una tercera, en mi caso."
    mc "Ou uma terceira, no meu caso."

# game/scripts/c25/c25.rpy:1616
translate brazilian c25s002_NoKimRoute_5f1dacb3:

    # mc "Pero ¿puedo serte sincero?"
    mc "Mas posso ser sincero com você?"

# game/scripts/c25/c25.rpy:1618
translate brazilian c25s002_NoKimRoute_f5b70ec1:

    # kim "Por supuesto."
    kim "Claro."

# game/scripts/c25/c25.rpy:1619
translate brazilian c25s002_NoKimRoute_ef20ad7b:

    # mc "No lo hice para forzarte a una conversación con [mar] que te daba miedo, pero me alegro de que haya acabado así."
    mc "Eu não fiz isso para te forçar a ter uma conversa com [mar] que te assustasse, mas fico feliz que tenha terminado assim."

# game/scripts/c25/c25.rpy:1621
translate brazilian c25s002_NoKimRoute_0f777387:

    # kim "Entonces no quiero saber por qué lo hiciste. Prefiero seguir creyendo mi teoría."
    kim "Então não quero saber por que você fez isso. Prefiro continuar acreditando na minha teoria."

# game/scripts/c25/c25.rpy:1622
translate brazilian c25s002_NoKimRoute_9b6814d2:

    # kim "¿Podemos quedarnos abrazados un rato?"
    kim "Podemos ficar abraçados por mais um tempo?"

# game/scripts/c25/c25.rpy:1623
translate brazilian c25s002_NoKimRoute_94f57313:

    # mc "Tanto tiempo como quieras."
    mc "Pelo tempo que você quiser."

# game/scripts/c25/c25.rpy:1633
translate brazilian c25s002_NoKimSaved_5b3b09ef:

    # "Vuelves a dar la espalda a la escena que se está desarrollando en la cubierta."
    "Você vira as costas novamente para a cena que se desenrola no convés."

# game/scripts/c25/c25.rpy:1634
translate brazilian c25s002_NoKimSaved_81cd69b1:

    # "No tienes ninguna intención de participar."
    "Você não tem intenção de participar."

# game/scripts/c25/c25.rpy:1636
translate brazilian c25s002_NoKimSaved_172f8095:

    # "Un par de minutos después..."
    "Alguns minutos depois..."

# game/scripts/c25/c25.rpy:1637
translate brazilian c25s002_NoKimSaved_e62085b0:

    # aga "¿Qué tiene Ichigo contra vosotros? Lo de esa chica parecía algo personal."
    aga "O que Ichigo tem contra você? O que aquela garota fez pareceu pessoal."

# game/scripts/c25/c25.rpy:1638
translate brazilian c25s002_NoKimSaved_9ad86061:

    # mc "No es un tema personal, sino de negocios. Estaba haciendo una competición a ver quién tenía la polla más grande."
    mc "Não é nada pessoal, são negócios. Eu estava fazendo uma competição para ver quem tinha o maior pênis."

# game/scripts/c25/c25.rpy:1639
translate brazilian c25s002_NoKimSaved_b64e7c26:

    # mc "La chica se aloja en el dormitorio universitario que es el negocio familiar e Ichigo quería demostrar que podía atacarnos por ahí."
    mc "A garota está hospedada no dormitório universitário que é um negócio de família, e Ichigo queria provar que podia nos atacar de lá."

# game/scripts/c25/c25.rpy:1641
translate brazilian c25s002_NoKimSaved_e9ff619d:

    # aga "Ichigo siempre me ha parecido un tipo muy zafio, pero usar a una chica así es demasiado incluso para él."
    aga "Sempre achei que o Ichigo fosse um cara muito grosseiro, mas usar uma garota desse jeito é demais até para ele."

# game/scripts/c25/c25.rpy:1642
translate brazilian c25s002_NoKimSaved_fe0f85c7:

    # aga "Ha tenido que aceptar la derrota temporalmente pero, si puedes, indícale a tu amiga que no salga del camarote hasta que no acabe la fiesta."
    aga "Ela teve que aceitar a derrota temporariamente, mas se puder, diga à sua amiga para não sair da cabana até o fim da festa."

# game/scripts/c25/c25.rpy:1643
translate brazilian c25s002_NoKimSaved_ac4074df:

    # mc "Gracias, Alejandra. Lo haré."
    mc "Obrigada, Alejandra. Eu irei."

# game/scripts/c25/c25.rpy:1644
translate brazilian c25s002_NoKimSaved_bc20b7fe:

    # mc "Y gracias también por apoyarnos antes."
    mc "E agradecemos também pelo apoio que nos deram anteriormente."

# game/scripts/c25/c25.rpy:1646
translate brazilian c25s002_NoKimSaved_3f754ca1:

    # aga "Como te he dicho, Ichigo me parece zafio y despreciable. No me gusta cómo trata a las mujeres en estas fiestas."
    aga "Como eu disse, acho o Ichigo grosseiro e desprezível. Não gosto de como ele trata as mulheres nessas festas."

# game/scripts/c25/c25.rpy:1647
translate brazilian c25s002_NoKimSaved_16cffa4d:

    # aga "No es que me haya puesto de vuestro lado, pero me ha gustado verle mordiendo el polvo por una vez."
    aga "Não é que eu tenha ficado do seu lado, mas gostei de vê-lo se dar mal pela primeira vez."

# game/scripts/c25/c25.rpy:1648
translate brazilian c25s002_NoKimSaved_395b1468:

    # mc "De todas formas, gracias."
    mc "De qualquer forma, obrigado."

# game/scripts/c25/c25.rpy:1650
translate brazilian c25s002_NoKimSaved_ec881d9d:

    # aga "Ahora te tengo que dejar. Tengo que seguir la conversación con nuestro amigo italiano."
    aga "Preciso ir agora. Preciso continuar minha conversa com nosso amigo italiano."

# game/scripts/c25/c25.rpy:1651
translate brazilian c25s002_NoKimSaved_fd1b3c82:

    # mc "Me gustaría llamarte algún día. Estamos reorientando el negocio y quizás México sería un buen sitio por el que comenzar."
    mc "Gostaria de ligar para você qualquer dia desses. Estamos reformulando os negócios e talvez o México seja um bom lugar para começar."

# game/scripts/c25/c25.rpy:1652
translate brazilian c25s002_NoKimSaved_91231aa9:

    # aga "Perfecto. Siempre es bueno tener otras opciones para según qué trabajos."
    aga "Perfeito. É sempre bom ter outras opções para certos trabalhos."

# game/scripts/c25/c25.rpy:1654
translate brazilian c25s002_NoKimSaved_178a7f20:

    # "Alejandra desaparece y vuelves a mirar al mar."
    "Alejandra desaparece e você olha para trás, para o mar."

# game/scripts/c25/c25.rpy:1655
translate brazilian c25s002_NoKimSaved_ebc5f5b1:

    # "Mandas un mensaje a [ama] diciéndole que no abandonen el camarote hasta que las avises."
    "Você envia uma mensagem para [ama] dizendo para eles não saírem da cabine até que você os avise."

# game/scripts/c25/c25.rpy:1657
translate brazilian c25s002_NoKimSaved_103a5873:

    # "Al cabo de poco más de una hora..."
    "Após pouco mais de uma hora..."

# game/scripts/c25/c25.rpy:1659
translate brazilian c25s002_NoKimSaved_4591ce80:

    # jef "Sr. Marks, la velada está a punto de acabar. La mayoría de los invitados van a pasar la noche en el barco. ¿Qué desean hacer usted y su acompañante?"
    jef "Senhor Marks, a noite está chegando ao fim. A maioria dos convidados passará a noite no barco. O que o senhor e seus convidados gostariam de fazer?"

# game/scripts/c25/c25.rpy:1660
translate brazilian c25s002_NoKimSaved_31a0a98a:

    # mc "Volveremos a tierra, si es posible. Y nos llevaremos a la chica del helipuerto."
    mc "Se possível, voltaremos para terra firme. E levaremos a garota do heliporto conosco."

# game/scripts/c25/c25.rpy:1662
translate brazilian c25s002_NoKimSaved_77da7b24:

    # jef "No sé si lo de la chica va a ser posible..."
    jef "Não sei se o lance com a garota vai ser possível..."

# game/scripts/c25/c25.rpy:1663
translate brazilian c25s002_NoKimSaved_8452390a:

    # mc "Hágalo posible, Sr. Sound. Por lo que sé, su contrato no incluía pasar la noche aquí."
    mc "Faça acontecer, Sr. Sound. Que eu saiba, seu contrato não incluía passar a noite aqui."

# game/scripts/c25/c25.rpy:1664
translate brazilian c25s002_NoKimSaved_c5721464:

    # jef "Deme un minuto para comprobarlo."
    jef "Me dê um minuto para verificar."

# game/scripts/c25/c25.rpy:1666
translate brazilian c25s002_NoKimSaved_a7cff355:

    # "Tras comprobar algo en el móvil..."
    "Depois de verificar algo no meu celular..."

# game/scripts/c25/c25.rpy:1667
translate brazilian c25s002_NoKimSaved_f1a9141e:

    # jef "Tiene razón. Las azafatas y las camareras vuelven a tierra en la lancha en una hora más o menos."
    jef "Você tem razão. Os comissários de bordo e as garçonetes retornam à costa de barco em cerca de uma hora."

# game/scripts/c25/c25.rpy:1668
translate brazilian c25s002_NoKimSaved_c17d7769:

    # mc "Pues a esa azafata nos la llevaremos nosotros en el helicóptero."
    mc "Bom, vamos levar aquela aeromoça conosco no helicóptero."

# game/scripts/c25/c25.rpy:1669
translate brazilian c25s002_NoKimSaved_b6955f63:

    # jef "Como desee. Avíseme cuando estén listos."
    jef "Como desejar. Avise-me quando estiverem prontos."

# game/scripts/c25/c25.rpy:1671
translate brazilian c25s002_NoKimSaved_05c3ce64:

    # "Avisas a [ama] de que puede salir del camarote y subís al helicóptero. Ichigo no está disponible para poder despediros de él."
    "Você diz a [ama] que ele pode sair da cabine e você embarca no helicóptero. Ichigo não está disponível para se despedir dele."

# game/scripts/c25/c25.rpy:1675
translate brazilian c25s002_NoKimSaved_20e5aa69:

    # "Al llegar al aparcamiento, [ama] va a por la furgoneta, dejándoos a [kim] y a ti a solas."
    "Ao chegar ao estacionamento, [ama] vai buscar a van, deixando [kim] e você sozinhos."

# game/scripts/c25/c25.rpy:1677
translate brazilian c25s002_NoKimSaved_35fd8f7a:

    # kim "Antes de que lo preguntes, no, no sabía quiénes eran Iron Fist o que eran una empresa rival de NTR."
    kim "Antes que perguntem, não, eu não sabia quem era o Punho de Ferro nem que era uma empresa rival da NTR."

# game/scripts/c25/c25.rpy:1678
translate brazilian c25s002_NoKimSaved_de11a839:

    # "Está visiblemente molesta. Supones que esperaba que fueras tú quien intercediera por ella."
    "Ela está visivelmente chateada. Você presume que ela esperava que você interviesse em seu favor."

# game/scripts/c25/c25.rpy:1679
translate brazilian c25s002_NoKimSaved_a24eea82:

    # kim "No, no había visto las ametralladoras la última vez. Estaban tapadas con lonas."
    kim "Não, eu não tinha visto as metralhadoras da última vez. Elas estavam cobertas com lonas."

# game/scripts/c25/c25.rpy:1680
translate brazilian c25s002_NoKimSaved_03e927cc:

    # kim "No, no había mafiosos tampoco la última vez. Tan solo militares de uniforme. Tampoco había mujeres desnudas que yo viera."
    kim "Não, da última vez também não havia nenhum mafioso. Só soldados uniformizados. E eu não vi nenhuma mulher nua."

# game/scripts/c25/c25.rpy:1681
translate brazilian c25s002_NoKimSaved_90ae5620:

    # mc "[kim], cálmate. Nadie te está acusando de nada."
    mc "[kim], acalme-se. Ninguém está te acusando de nada."

# game/scripts/c25/c25.rpy:1683
translate brazilian c25s002_NoKimSaved_c59e65c4:

    # kim "Lo sé, pero son preguntas que [ama] me ha hecho, y es lógico que tú también quieras saber la respuesta."
    kim "Eu sei, mas essas são perguntas que [ama] me fez, e é natural que você também queira saber a resposta."

# game/scripts/c25/c25.rpy:1684
translate brazilian c25s002_NoKimSaved_75df8a95:

    # kim "No soy estúpida, ¿sabes? Si hubiera sospechado algo, os lo hubiera dicho."
    kim "Eu não sou boba, sabia? Se eu tivesse suspeitado de alguma coisa, teria te dito."

# game/scripts/c25/c25.rpy:1685
translate brazilian c25s002_NoKimSaved_0b2f8296:

    # mc "Lo sé. Deberías..."
    mc "Eu sei. Você deveria..."

# game/scripts/c25/c25.rpy:1687
translate brazilian c25s002_NoKimSaved_d02329f5:

    # kim "¿Qué? ¿Preguntar a la agencia cómo se llama cada cliente? ¿Informaros de quienes son esos clientes por si tienen algo que ver con vuestra empresa?"
    kim "O quê? Perguntar à agência o nome de cada cliente? Descobrir quem são esses clientes, caso tenham alguma ligação com a sua empresa?"

# game/scripts/c25/c25.rpy:1688
translate brazilian c25s002_NoKimSaved_ec65a0ac:

    # kim "No te preocupes, después de lo de hoy, lo más probable es que el Sr. Ichigo ponga alguna queja sobre mí y me despidan."
    kim "Não se preocupe, depois do que aconteceu hoje, o Sr. Ichigo provavelmente apresentará uma queixa contra mim e eu serei demitido."

# game/scripts/c25/c25.rpy:1689
translate brazilian c25s002_NoKimSaved_2a8029f7:

    # mc "Si necesitas que hablemos con la agencia..."
    mc "Se você precisar que falemos com a agência..."

# game/scripts/c25/c25.rpy:1691
translate brazilian c25s002_NoKimSaved_73245fad:

    # kim "¿Para qué? Vosotros no sois el cliente. Vuestra palabra no tiene ningún peso."
    kim "Por quê? Você não é o cliente. Sua palavra não tem valor algum."

# game/scripts/c25/c25.rpy:1692
translate brazilian c25s002_NoKimSaved_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c25/c25.rpy:1693
translate brazilian c25s002_NoKimSaved_55151d95:

    # kim "Pero nada, [mc]. Lo hecho, hecho está. Por suerte, [ama] ha evitado que pasara algo peor."
    kim "Mas enfim. O que está feito, está feito. Felizmente, algo pior aconteceu."

# game/scripts/c25/c25.rpy:1695
translate brazilian c25s002_NoKimSaved_cf694178:

    # "En ese momento, llega [ama] con la furgoneta, interrumpiendo la conversación."
    "Nesse momento, [ama] chega na van, interrompendo a conversa."

# game/scripts/c25/c25.rpy:1697
translate brazilian c25s002_NoKimSaved_9594b755:

    # "El viaje a casa se produce en silencio, ninguna de las dos chicas tiene ganas de hablar."
    "A viagem de volta para casa acontece em silêncio; nenhuma das duas meninas está com vontade de conversar."

# game/scripts/c25/c25.rpy:1699
translate brazilian c25s002_NoKimSaved_d6744449:

    # "Al llegar a casa..."
    "Quando cheguei em casa..."

# game/scripts/c25/c25.rpy:1700
translate brazilian c25s002_NoKimSaved_3a8e380f:

    # kim "Gracias por lo que has hecho en el barco, [ama]."
    kim "Obrigado pelo que você fez no navio, [ama]."

# game/scripts/c25/c25.rpy:1701
translate brazilian c25s002_NoKimSaved_595a33f1:

    # ama "No tienes por qué agradecérmelo, [kim]. La familia nos tenemos que cuidar."
    ama "Você não precisa me agradecer, [kim]. Temos que cuidar uns dos outros como uma família."

# game/scripts/c25/c25.rpy:1702
translate brazilian c25s002_NoKimSaved_434018f0:

    # kim "Sí, la familia..."
    kim "Sim, a família..."

# game/scripts/c25/c25.rpy:1703
translate brazilian c25s002_NoKimSaved_cc17993b:

    # ama "Sube a dormir y cálmate. Mañana lo verás todo con otros ojos."
    ama "Vá dormir e se acalme. Amanhã você verá tudo com outros olhos."

# game/scripts/c25/c25.rpy:1705
translate brazilian c25s002_NoKimSaved_4fe3dae7:

    # kim "Hasta mañana, [mc]."
    kim "Até amanhã, [mc]."

# game/scripts/c25/c25.rpy:1706
translate brazilian c25s002_NoKimSaved_a004f610:

    # mc "Hasta mañana, [kim]. Duerme bien."
    mc "Até amanhã, [kim]. Durma bem."

# game/scripts/c25/c25.rpy:1708
translate brazilian c25s002_NoKimSaved_41a4f5ec:

    # "[kim] se mete en casa sin mirar atrás o decir nada más."
    "[kim] entra na casa sem olhar para trás ou dizer mais nada."

# game/scripts/c25/c25.rpy:1710
translate brazilian c25s002_NoKimSaved_dec77af6:

    # ama "No se lo tengas en cuenta. Está nerviosa y asustada por lo que ha estado a punto de pasarle."
    ama "Não a culpe. Ela está nervosa e assustada com o que quase lhe aconteceu."

# game/scripts/c25/c25.rpy:1711
translate brazilian c25s002_NoKimSaved_33bb8981:

    # mc "Y decepcionada porque no he sido yo quién ha intervenido, ¿no?"
    mc "E fiquei desapontado porque não fui eu quem interveio, certo?"

# game/scripts/c25/c25.rpy:1714
translate brazilian c25s002_NoKimSaved_4fe67dcd:

    # ama "Creo que sí. Has actuado como el caballero de brillante armadura con varias de las chicas y, cuando ella lo ha necesitado, he tenido que hacerlo yo."
    ama "Acho que sim. Você agiu como um príncipe encantado com várias das garotas, e quando ela precisou, eu tive que intervir."

# game/scripts/c25/c25.rpy:1716
translate brazilian c25s002_NoKimSaved_758b0092:

    # ama "Hasta cierto punto. Creo que no esperaba que hicieras lo que he hecho yo, pero tampoco que te quedaras impasible."
    ama "Até certo ponto. Acho que não esperava que você fizesse o que eu fiz, mas também não esperava que você permanecesse impassível."

# game/scripts/c25/c25.rpy:1717
translate brazilian c25s002_NoKimSaved_c7df31f0:

    # mc "Tienes razón. No he sabido reaccionar, y cuando he podido hacerlo, tú ya lo habías resuelto."
    mc "Você tem razão. Eu não sabia como reagir, e quando finalmente pude, você já tinha resolvido o problema."

# game/scripts/c25/c25.rpy:1718
translate brazilian c25s002_NoKimSaved_d2a26170:

    # ama "Al menos has soltado el discurso sobre la forma de hacer negocios de Iron Fist. Eso y lo que ha dicho Alejandra me han permitido sacarla de ahí."
    ama "Ao menos você conseguiu fazer aquele discurso sobre as práticas comerciais do Punho de Ferro. Isso, e o que a Alejandra disse, me permitiu tirá-la de lá."

# game/scripts/c25/c25.rpy:1719
translate brazilian c25s002_NoKimSaved_914868ee:

    # mc "Es poco consuelo, pero al menos todo ha acabado bien... o no tan mal como podía haberlo hecho."
    mc "É um consolo pequeno, mas pelo menos tudo acabou bem... ou não tão mal quanto poderia ter sido."

# game/scripts/c25/c25.rpy:1724
translate brazilian c25s002_NoKimSaved_add4614b:

    # ama "No le des más vueltas. En cuanto tenga tiempo de pensar, se le pasará la decepción que tiene contigo ahora mismo. No siempre puedes hacerlo todo bien."
    ama "Não pense demais nisso. Assim que ela tiver tempo para pensar, ela vai superar a decepção que sente por você agora. Você não pode fazer tudo certo o tempo todo."

# game/scripts/c25/c25.rpy:1725
translate brazilian c25s002_NoKimSaved_1c354712:

    # ama "Hasta mañana, [mc]."
    ama "Até amanhã, [mc]."

# game/scripts/c25/c25.rpy:1726
translate brazilian c25s002_NoKimSaved_0b433688:

    # mc "Hasta mañana, [ama]."
    mc "Até amanhã, [ama]."

# game/scripts/c25/c25.rpy:1728
translate brazilian c25s002_NoKimSaved_fd824944:

    # mc "Espera, [ama]. Se me acaba de ocurrir una idea. ¿Tienes un momento?"
    mc "Espere, [ama]. Acabei de ter uma ideia. Você tem um minuto?"

# game/scripts/c25/c25.rpy:1730
translate brazilian c25s002_NoKimSaved_a7a75903:

    # "Unos minutos después subes a tu habitación, pensando que, quizás, podrías haber hecho las cosas de otra forma en el barco."
    "Poucos minutos depois, você sobe para o seu quarto, pensando que, talvez, pudesse ter feito as coisas de maneira diferente no navio."

# game/scripts/c25/c25.rpy:1732
translate brazilian c25s002_NoKimSaved_52e6c759:

    # "Al menos con la idea que se te ha ocurrido a última hora, quizás puedas proteger un poco a [kim]."
    "Pelo menos com a ideia que você teve no último minuto, talvez você consiga proteger um pouco o [kim]."

# game/scripts/c25/c25.rpy:1737
translate brazilian c25s003_HeloTrip_d0ea0e8a:

    # "Sin que os deis cuenta, pasa el tiempo, hasta que suena tu móvil de nuevo. [ama] te indica que ya podéis salir de vuestro refugio."
    "Sem que você perceba, o tempo passa, até que seu telefone toca novamente. [ama] avisa que você já pode sair do abrigo."

# game/scripts/c25/c25.rpy:1740
translate brazilian c25s003_HeloTrip_70487c49:

    # "Subís a cubierta y al helicóptero. Ichigo no está disponible para poder despediros de él."
    "Você sobe até o convés e entra no helicóptero. Ichigo não está disponível para você se despedir dele."

# game/scripts/c25/c25.rpy:1741
translate brazilian c25s003_HeloTrip_ae60eadf:

    # "Crees que es lo mejor."
    "Você acha que é o melhor a fazer."

# game/scripts/c25/c25.rpy:1742
translate brazilian c25s003_HeloTrip_ca7fff4d:

    # "El viaje en helicóptero pasa sin nada reseñable y os vuelve a dejar en el aparcamiento de la galería de tiro."
    "O passeio de helicóptero transcorre sem incidentes e te deixa de volta no estacionamento do estande de tiro."

# game/scripts/c25/c25.rpy:1749
translate brazilian c25s003_MyResidence_2f324e16:

    # centered "{size=+20}{b}DÍA 27 – DOMINGO{/b}{/size}"
    centered "{size=+20}{b}DIA 27 – DOMINGO{/b}{/size}"

# game/scripts/c25/c25.rpy:1751
translate brazilian c25s003_MyResidence_f42af20d:

    # "Te despiertas antes de lo habitual y bajas a desayunar. [kim] ha desaparecido."
    "Você acorda mais cedo do que o normal e desce para tomar café da manhã. [kim] desapareceu."

# game/scripts/c25/c25.rpy:1753
translate brazilian c25s003_MyResidence_ed803360:

    # "Te despiertas antes de lo habitual y bajas a desayunar."
    "Você acorda mais cedo do que o habitual e desce para tomar o café da manhã."

# game/scripts/c25/c25.rpy:1754
translate brazilian c25s003_MyResidence_9b6c0794:

    # "Te estás muriendo de hambre. No cenaste en el barco y no tenías hambre al llegar a casa."
    "Você está morrendo de fome. Você não jantou no barco e não estava com fome quando chegou em casa."

# game/scripts/c25/c25.rpy:1757
translate brazilian c25s003_MyResidence_afc87665:

    # "Al pasar por la planta de las estudiantes, ves a [deb.nick] con su portátil."
    "Ao passar pelo andar dos estudantes, você vê [deb.nick] com seu laptop."

# game/scripts/c25/c25.rpy:1758
translate brazilian c25s003_MyResidence_766a1ec7:

    # mc "Buenos días, [deb.nick]. ¿Esperando a las chicas para hacer yoga? ¿O vas a salir a correr?"
    mc "Bom dia, [deb.nick]. Você está esperando as meninas fazerem ioga? Ou vai correr?"

# game/scripts/c25/c25.rpy:1759
translate brazilian c25s003_MyResidence_cd593736:

    # deb "Buenos días, [mc]. Iba a hacer yoga, pero me he entretenido con un juego. Lo dejaré para otro día."
    deb "Bom dia, [mc]. Eu ia fazer ioga, mas me distraí com um jogo. Farei outro dia."

# game/scripts/c25/c25.rpy:1761
translate brazilian c25s003_MyResidence_c0eddb25:

    # mc "¿Alguna novela visual nueva?"
    mc "Algum jogo novo de visual novel?"

# game/scripts/c25/c25.rpy:1763
translate brazilian c25s003_MyResidence_014d448b:

    # deb "No, no he tenido tiempo de mirar ninguna más aparte de My Residence. Un día me tienes que recomendar alguna que no haya jugado."
    deb "Não, não tive tempo de analisar nenhum outro além de My Residence. Você terá que me recomendar um que eu ainda não tenha jogado."

# game/scripts/c25/c25.rpy:1764
translate brazilian c25s003_MyResidence_5974e48e:

    # mc "He jugado a varias muy buenas. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner... y óbviamente My Residence."
    mc "Joguei vários jogos muito bons. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner... e, obviamente, My Residence."

# game/scripts/c25/c25.rpy:1767
translate brazilian c25s003_MyResidence_be8269ab:

    # deb "Es una novela visual que estoy jugando..."
    deb "É um romance visual que estou jogando..."

# game/scripts/c25/c25.rpy:1768
translate brazilian c25s003_MyResidence_372ed14c:

    # mc "¿Una novela visual japonesa u occidental?"
    mc "Uma visual novel japonesa ou ocidental?"

# game/scripts/c25/c25.rpy:1770
translate brazilian c25s003_MyResidence_c5619880:

    # deb "Occidental, para adultos..."
    deb "Faroeste, para adultos..."

# game/scripts/c25/c25.rpy:1771
translate brazilian c25s003_MyResidence_8b0b7420:

    # mc "¡[deb.nick]! ¡Me sorprendes!"
    mc "Uau! Você me surpreendeu!"

# game/scripts/c25/c25.rpy:1773
translate brazilian c25s003_MyResidence_be0d43fe:

    # deb "¿Qué pasa? ¡No hay nada de lo que avergonzarse!"
    deb "Qual o problema? Não há nada de que se envergonhar!"

# game/scripts/c25/c25.rpy:1774
translate brazilian c25s003_MyResidence_40adb682:

    # mc "*Risa* Estoy de acuerdo. Yo también juego a novelas visuales."
    mc "*Risos* Concordo. Eu também jogo visual novels."

# game/scripts/c25/c25.rpy:1776
translate brazilian c25s003_MyResidence_73abaeb1:

    # deb "¿De verdad? ¿A cuáles juegas?"
    deb "Sério? Quais você joga?"

# game/scripts/c25/c25.rpy:1777
translate brazilian c25s003_MyResidence_179551d1:

    # mc "He jugado a varias. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner, My Residence..."
    mc "Já joguei vários. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner, My Residence..."

# game/scripts/c25/c25.rpy:1779
translate brazilian c25s003_MyResidence_8979c922:

    # deb "¿My Residence? Es precisamente la que estoy jugando ahora."
    deb "Minha Residência? É exatamente aquela em que estou jogando agora."

# game/scripts/c25/c25.rpy:1781
translate brazilian c25s003_MyResidence_7a0e404f:

    # deb "¿Te enteraste de que algún hijo de puta filtró la última actualización de My Residence?"
    deb "Você soube que algum filho da puta vazou a última atualização do My Residence?"

# game/scripts/c25/c25.rpy:1782
translate brazilian c25s003_MyResidence_00920cd5:

    # mc "Sí. ¿Ha hecho Clichecita algún otro post mandando a tomar por culo al filtrador? No me importa si me haces algún spoiler."
    mc "Sim. A Clichecita fez mais alguma postagem mandando o informante para o inferno? Não me importo se você me der um spoiler."

# game/scripts/c25/c25.rpy:1783
translate brazilian c25s003_MyResidence_8bb6a13b:

    # mc "Me gustó que casi toda la comunidad le apoyásemos. Tanto los que somos suscriptores como los que no lo son. Menos el hijo de puta, claro."
    mc "Gostei que quase toda a comunidade o apoiasse. Tanto nós, assinantes, quanto os não assinantes. Exceto aquele filho da puta, é claro."

# game/scripts/c25/c25.rpy:1785
translate brazilian c25s003_MyResidence_cada3249:

    # deb "¡Ha hecho algo mucho mejor! *Risa* Ha mandado a Vee y a Mandy, las espías, en una misión para acabar con filtradores de juegos y moderadores fascistas de foros."
    deb "Ele fez algo muito melhor! *Risos* Ele enviou Vee e Mandy, as espiãs, em uma missão para derrubar quem vaza informações do jogo e moderadores fascistas de fóruns."

# game/scripts/c25/c25.rpy:1786
translate brazilian c25s003_MyResidence_bff44c1f:

    # mc "*Risa* Ese tío se va a meter en problemas algún día, lo van a banear de todos los foros. Pero es gracioso que haga cosas así. ¿Tienes alguna imagen?"
    mc "*Risos* Esse cara vai se meter em encrenca um dia, vai ser banido de todos os fóruns. Mas é engraçado ele fazer essas coisas. Você tem alguma foto?"

# game/scripts/c25/c25.rpy:1788
translate brazilian c25s003_MyResidence_3c8d18db:

    # deb "Sí, déjame mirar en la galería un momento."
    deb "Sim, deixe-me dar uma olhada na galeria por um instante."

# game/scripts/c25/c25.rpy:1790
translate brazilian c25s003_MyResidence_60877694:

    # deb "Mira, aquí es cuando ya han acabado con él."
    deb "Olha, isso aconteceu quando eles já tinham acabado com ele."

# game/scripts/c25/c25.rpy:1791
translate brazilian c25s003_MyResidence_fc1c22b9:

    # mc "*Risa* ¡Qué graciosa es Mandy diciendo 'Un criminal menos en el mundo.' después de matar al filtrador!"
    mc "*Risos* Que engraçado a Mandy dizer \"Um criminoso a menos no mundo\" depois de matar o delator!"

# game/scripts/c25/c25.rpy:1792
translate brazilian c25s003_MyResidence_6ff25640:

    # mc "Y Vee diciendo 'Ahora, a por los moderadores fascistas'. Dan miedo."
    mc "E Vee dizendo: 'Agora, vamos atrás dos moderadores fascistas.' Eles são assustadores."

# game/scripts/c25/c25.rpy:1793
translate brazilian c25s003_MyResidence_ad1e5397:

    # deb "*Risa* A mí me han hecho reír las pantallas y el cartel: 'El sótano de mi madre es mi castillo' y '¿Por qué no puedo encontrar mi culo con dos manos y una linterna'"
    deb "*Risos* Encontrei as telas e a placa que me fizeram rir: \"O porão da minha mãe é o meu castelo\" e \"Por que não consigo encontrar meu traseiro com as duas mãos e uma lanterna?\""

# game/scripts/c25/c25.rpy:1794
translate brazilian c25s003_MyResidence_082d43cd:

    # mc "*Risa* Libro 1. Supongo que los filtradores necesitan instrucciones para eso."
    mc "*Risos* Livro 1. Acho que os filtros precisam de instruções para isso."

# game/scripts/c25/c25.rpy:1795
translate brazilian c25s003_MyResidence_9e65cbbd:

    # mc "*Risa* ¡Espera! ¿Eso es un consolador?"
    mc "*Risos* Espera aí! Isso é um vibrador?"

# game/scripts/c25/c25.rpy:1797
translate brazilian c25s003_MyResidence_81deed43:

    # deb "Sí, y el papel higiénico al lado. Supongo que ha tirado de... clichés sobre perdedores. O tropes. *Risa*"
    deb "Sim, e o papel higiênico ao lado. Acho que ele recorreu a... clichês sobre perdedores. Ou tropos. *Risos*"

# game/scripts/c25/c25.rpy:1798
translate brazilian c25s003_MyResidence_2ddc50f3:

    # mc "Lo que me gusta es que ninguna de las dos parece contenta. Como diciendo 'Es algo que había que hacer, no por ello nos gusta.'"
    mc "O que me agrada é que nenhum dos dois parece feliz. Como se dissessem: \"Era algo que precisava ser feito, mas isso não significa que gostamos\"."

# game/scripts/c25/c25.rpy:1800
translate brazilian c25s003_MyResidence_bc8c2e8a:

    # deb "Exactamente eso. Te va a parecer gracioso, pero Vee y Mandy me recuerdan en cierta forma a [eva] y [ama]."
    deb "Exatamente. Você vai achar isso engraçado, mas Vee e Mandy me lembram um pouco de [eva] e [ama]."

# game/scripts/c25/c25.rpy:1801
translate brazilian c25s003_MyResidence_be2df33f:

    # mc "¡Qué va! [ama] y [eva] son mucho más tiernas. Vee y Mandy son mucho más despiadadas."
    mc "De jeito nenhum! [ama] e [eva] são muito mais fofas. Vee e Mandy são muito mais implacáveis."

# game/scripts/c25/c25.rpy:1802
translate brazilian c25s003_MyResidence_d9a3b146:

    # mc "¿Has desayunado ya?"
    mc "Você já tomou café da manhã?"

# game/scripts/c25/c25.rpy:1804
translate brazilian c25s003_MyResidence_461b7954:

    # deb "Sí, hace un rato. No quería hacer yoga con el estómago vacío, y al final me he quedado jugando."
    deb "Sim, faz um tempinho. Eu não queria fazer ioga de estômago vazio, e no fim acabei ficando para brincar."

# game/scripts/c25/c25.rpy:1805
translate brazilian c25s003_MyResidence_acd05f45:

    # mc "Pues te dejo jugando y voy a desayunar."
    mc "Bem, vou deixar vocês brincando enquanto eu vou tomar o café da manhã."

# game/scripts/c25/c25.rpy:1808
translate brazilian c25s003_MyResidence_77e0e675:

    # "Das un beso a la hermosa sirena, intentando no tirar el portátil."
    "Você dá um beijo na bela sereia, tentando não deixar o laptop cair."

# game/scripts/c25/c25.rpy:1810
translate brazilian c25s003_MyResidence_bc8b5b8c:

    # mc "Te veo luego. Me muero de hambre."
    mc "Até logo. Estou morrendo de fome."

# game/scripts/c25/c25.rpy:1812
translate brazilian c25s003_MyResidence_1f1f5279:

    # deb "Hasta luego, [mc]."
    deb "Até logo, [mc]."

# game/scripts/c25/c25.rpy:1832
translate brazilian c25s003_Yoga_482a03e9:

    # "Al entrar en la cocina te invade el olor de croissants recién hechos."
    "Ao entrar na cozinha, você é envolvido pelo aroma de croissants recém-assados."

# game/scripts/c25/c25.rpy:1834
translate brazilian c25s003_Yoga_f080aca5:

    # "No puedes resistirte y, después de preparar un café, comes un par."
    "Você não consegue resistir e, depois de fazer um café, come alguns."

# game/scripts/c25/c25.rpy:1836
translate brazilian c25s003_Yoga_6a39a92d:

    # "Mientras te tomas el café, te asomas a la ventana."
    "Enquanto toma seu café, você olha pela janela."

# game/scripts/c25/c25.rpy:1837
translate brazilian c25s003_Yoga_aca5b583:

    # "Recuerdas que [kia] dijo que un montón de chicas se apuntarían a la sesión de yoga de hoy."
    "Você se lembra que [kia] disse que muitas garotas se inscreveriam para a sessão de ioga de hoje?"

# game/scripts/c25/c25.rpy:1838
translate brazilian c25s003_Yoga_92d27e8d:

    # "A este paso vais a tener que ampliar la piscina."
    "Nesse ritmo, você vai ter que aumentar o tamanho da piscina."

# game/scripts/c25/c25.rpy:1839
translate brazilian c25s003_Yoga_795f6dcc:

    # "Decides bajar a saludar y acabarte el café en la piscina. Estando todas juntas, va a ser más eficiente."
    "Você decide descer para cumprimentar e terminar seu café à beira da piscina. Estar todos juntos tornará as coisas mais eficientes."

# game/scripts/c25/c25.rpy:1841
translate brazilian c25s003_Yoga_0f266157:

    # mc "Buenos días, chicas. Hace un día genial para veros hacer yoga sin unirme. *Risa*"
    mc "Bom dia, meninas. É um ótimo dia para ver vocês todas praticando ioga sem participar. *Risos*"

# game/scripts/c25/c25.rpy:1842
translate brazilian c25s003_Yoga_08dc160d:

    # mcp "(No tengo intención de volver a ponerme las mallas de Tío Mike en mi vida.)"
    mcp "(Não tenho a menor intenção de usar as meias-calças do Tio Mike novamente na minha vida.)"

# game/scripts/c25/c25.rpy:1844
translate brazilian c25s003_Yoga_0b288a70:

    # "Sin interrumpir sus ejercicios ni decir nada, todas te dedican una sonrisa."
    "Sem interromper os exercícios ou dizer nada, todos eles lhe dão um sorriso."

# game/scripts/c25/c25.rpy:1845
translate brazilian c25s003_Yoga_6cb7a019:

    # "Una preciosa imagen para empezar el día. Como has pensado, mucho más eficiente."
    "Uma bela imagem para começar o dia. Como você imaginou, muito mais eficiente."

# game/scripts/c25/c25.rpy:1846
translate brazilian c25s003_Yoga_5d07fb2b:

    # kat "Me estás tapando las vistas, [mc]."
    kat "Você está bloqueando minha visão, [mc]."

# game/scripts/c25/c25.rpy:1848
translate brazilian c25s003_Yoga_84a3d87d:

    # mc "¡Oh, [kat]! Perdona, no te había visto."
    mc "Oh, [kat]! Desculpe, eu não te vi."

# game/scripts/c25/c25.rpy:1849
translate brazilian c25s003_Yoga_019b7d21:

    # kat "*Risa* Lo difícil es no verme con lo que abulto, pero te entiendo. Es difícil apartar los ojos de esas trece mujeres."
    kat "*Risos* A parte difícil é não ver o quão volumoso eu sou, mas eu entendo. É difícil tirar os olhos daquelas treze mulheres."

# game/scripts/c25/c25.rpy:1850
translate brazilian c25s003_Yoga_ce27227c:

    # mc "*Risa* No las había contado."
    mc "*Risos* Eu não os tinha contado."

# game/scripts/c25/c25.rpy:1852
translate brazilian c25s003_Yoga_c7194c7b:

    # kat "*Risa* Bueno, aparte de mirar, no he tenido mucho que hacer en los últimos 10 minutos."
    kat "*Risos* Bem, além de assistir, não tive muito o que fazer nos últimos 10 minutos."

# game/scripts/c25/c25.rpy:1853
translate brazilian c25s003_Yoga_6d4db9af:

    # kat "Y si no sales de en medio, no voy a poder seguir mirando."
    kat "E se você não sair da frente, não vou conseguir continuar assistindo."

# game/scripts/c25/c25.rpy:1855
translate brazilian c25s003_Yoga_70d56761:

    # kat "{i}(¡Deja de mirar, [kat]! ¡Céntrate! Ni te va a mirar con el espectáculo que hay detrás suyo.){/i}"
    kat "{i}(Pare de encarar, [kat]! Concentre-se! Ele não vai olhar para você com esse óculos atrás dele.){/i}"

# game/scripts/c25/c25.rpy:1857
translate brazilian c25s003_Yoga_e8b4c525:

    # mc "¿Estoy bien aquí? ¿No te tapo las vistas ahora?"
    mc "Estou bem aqui? Estou bloqueando sua visão agora?"

# game/scripts/c25/c25.rpy:1858
translate brazilian c25s003_Yoga_538eee44:

    # kat "Sí, ahí estás bien."
    kat "Sim, você tem toda a razão."

# game/scripts/c25/c25.rpy:1859
translate brazilian c25s003_Yoga_7c72c85d:

    # kat "Además, justo a tiempo para el cambio de postura."
    kat "Além disso, chegou bem a tempo da mudança de posição."

# game/scripts/c25/c25.rpy:1861
translate brazilian c25s003_Yoga_416ed5b5:

    # mc "Casi parece que estén haciendo una coreografía, ¿no?"
    mc "Parece até que estão fazendo uma coreografia, não é?"

# game/scripts/c25/c25.rpy:1862
translate brazilian c25s003_Yoga_0de4beb4:

    # kat "Todas siguen lo que hace [nor]. Y quien no puede, sigue a [sai], que también conoce todos los movimientos."
    kat "Todos seguem o que [nor] faz. E aqueles que não conseguem, seguem [sai], que também conhece todos os lances."

# game/scripts/c25/c25.rpy:1863
translate brazilian c25s003_Yoga_36157d72:

    # mc "*Risa* Veo que lo tienes todo estudiado."
    mc "*Risos* Vejo que você já tem tudo planejado."

# game/scripts/c25/c25.rpy:1865
translate brazilian c25s003_Yoga_1a6e8f52:

    # kat "*Risa* Bajar a desayunar aquí es una de las mejores vistas de la casa."
    kat "*Risos* Descer aqui para tomar o café da manhã proporciona uma das vistas mais bonitas da casa."

# game/scripts/c25/c25.rpy:1866
translate brazilian c25s003_Yoga_29ca9c16:

    # mc "*Risa* No voy a decir lo contrario. ¿Bajas muy a menudo?"
    mc "*Risos* Não vou negar. Você costuma ir lá com frequência?"

# game/scripts/c25/c25.rpy:1867
translate brazilian c25s003_Yoga_24988b39:

    # kat "No bajo todos los días. Cuando tengo clase a primera hora es complicado."
    kat "Eu não desço todos os dias. Quando tenho aula logo de manhã, é difícil."

# game/scripts/c25/c25.rpy:1868
translate brazilian c25s003_Yoga_29c85ce7:

    # mc "Entiendo. ¿Tienes algún plan para hoy?"
    mc "Entendo. Você tem algum plano para hoje?"

# game/scripts/c25/c25.rpy:1870
translate brazilian c25s003_Yoga_f122de9b:

    # kat "*Risa* NO ir a correr al lago es el primer plan. Hoy es mi día de descanso sin ejercicio."
    kat "*Risos* Não ir correr no lago é o primeiro plano. Hoje é meu dia de descanso, sem exercícios."

# game/scripts/c25/c25.rpy:1871
translate brazilian c25s003_Yoga_fe06ee76:

    # kat "El segundo era bajar aquí a ver a las chicas haciendo yoga. [eil], [oma], y [kia] no se apuntan nunca, y [sam] solo es la segunda vez que viene."
    kat "O segundo motivo era vir aqui para ver as meninas fazendo ioga. [eil], [oma] e [kia] nunca se inscrevem, e [sam] está vindo apenas pela segunda vez."

# game/scripts/c25/c25.rpy:1872
translate brazilian c25s003_Yoga_58f7fbd7:

    # kat "No podía perdérmelo."
    kat "Eu não podia perder isso de jeito nenhum."

# game/scripts/c25/c25.rpy:1873
translate brazilian c25s003_Yoga_87bf4a62:

    # mc "¿Y más allá de ver chicas en leggins?"
    mc "E além de simplesmente ver garotas de legging?"

# game/scripts/c25/c25.rpy:1875
translate brazilian c25s003_Yoga_0652bea0:

    # kat "*Risa* Más allá no he pensado nada."
    kat "*Risos* Não pensei em nada além disso."

# game/scripts/c25/c25.rpy:1876
translate brazilian c25s003_Yoga_38dfc874:

    # kat "Supongo que estudiar un rato, leer, y hacer el vago hasta la hora de comer."
    kat "Acho que vou estudar um pouco, ler e relaxar até a hora do almoço."

# game/scripts/c25/c25.rpy:1877
translate brazilian c25s003_Yoga_ca3709f4:

    # mc "*Risa* Es un plan perfecto para un domingo."
    mc "*Risos* É o plano perfeito para um domingo."

# game/scripts/c25/c25.rpy:1879
translate brazilian c25s003_Yoga_cbcfa4c4:

    # kat "¡Oh, por el amor de Dios! Adoro esa postura. No sería capaz de hacerla aunque me pagaran por ello."
    kat "Ah, pelo amor de Deus! Adoro essa pose. Eu não conseguiria fazê-la nem se me pagassem."

# game/scripts/c25/c25.rpy:1880
translate brazilian c25s003_Yoga_89a73eb7:

    # mc "*Risa* Yo tampoco. ¿Entiendes ahora por qué no me apunto a las sesiones de yoga?"
    mc "*Risos* Nem eu. Entende agora por que eu não me inscrevo em aulas de ioga?"

# game/scripts/c25/c25.rpy:1882
translate brazilian c25s003_Yoga_a49cb0dd:

    # kat "Visto que compartimos gustos por las vistas... ¿por qué no quedamos para desayunar juntos alguna mañana?"
    kat "Já que ambos gostamos de apreciar belas paisagens... que tal nos encontrarmos para tomar café da manhã juntos qualquer dia desses?"

# game/scripts/c25/c25.rpy:1884
translate brazilian c25s003_Yoga_8cfc6c8d:

    # kat "{i}(¡Mierda, [kat]! ¡Eso ha sonado como si le pidieras una cita! ¿Dónde has dejado tu cerebro hoy?){/i}"
    kat "{i}(Caramba, [kat]! Parecia que você estava convidando ela para sair! Onde você deixou seu cérebro hoje?){/i}"

# game/scripts/c25/c25.rpy:1885
translate brazilian c25s003_Yoga_dd0bb5a2:

    # mc "No te puedo asegurar nada, pero me parece una idea genial."
    mc "Não posso garantir nada, mas acho que é uma ótima ideia."

# game/scripts/c25/c25.rpy:1887
translate brazilian c25s003_Yoga_ce86d6b6:

    # kat "{i}(¿Ha dicho que sí? ¿No podría haberse negado y así dejarme las cosas claras?){/i}"
    kat "{i}(Ele disse sim? Não poderia ter recusado e esclarecido as coisas para mim?){/i}"

# game/scripts/c25/c25.rpy:1888
translate brazilian c25s003_Yoga_6901a23b:

    # mcp "(¿De qué se sorprende? ¿No quiere que desayunemos juntos? ¿Por qué lo ha propuesto?)"
    mcp "(O que há de tão surpreendente nisso? Ele não quer que tomemos café da manhã juntos? Por que ele sugeriu isso?)"

# game/scripts/c25/c25.rpy:1890
translate brazilian c25s003_Yoga_5ca9b544:

    # "Suena tu móvil. Es el correo de [ama] con la información que le pediste anoche."
    "Seu celular toca. É um e-mail de [ama] com as informações que você solicitou ontem à noite."

# game/scripts/c25/c25.rpy:1891
translate brazilian c25s003_Yoga_1b980033:

    # mc "Dame un momento, tengo que leer un correo."
    mc "Só um momento, preciso ler um e-mail."

# game/scripts/c25/c25.rpy:1893
translate brazilian c25s003_Yoga_336253eb:

    # kat "{i}(¡Joder, [mc]! ¿Lo puedes poner más difícil?){/i}"
    kat "{i}(Droga, [mc]! Você pode dificultar um pouco?){/i}"

# game/scripts/c25/c25.rpy:1895
translate brazilian c25s003_Yoga_81b1d609:

    # mc "[kat], te tengo que dejar. Tengo que hacer una llamada."
    mc "[kat], Eu tenho que ir. Tenho que fazer uma ligação."

# game/scripts/c25/c25.rpy:1896
translate brazilian c25s003_Yoga_b00c8c74:

    # kat "No te preocupes, aunque te vas a perder las últimas posturas."
    kat "Não se preocupe, mesmo que você perca as últimas posições."

# game/scripts/c25/c25.rpy:1897
translate brazilian c25s003_Yoga_1eb34e55:

    # mc "*Risa* Las veré el día que desayunemos juntos. Cuento contigo como comentarista."
    mc "*Risos* Vou vê-los no dia em que tomarmos café da manhã juntos. Conto com você como comentarista."

# game/scripts/c25/c25.rpy:1899
translate brazilian c25s003_Yoga_8443039f:

    # mc "¿Puedes dejar mi taza en tu bandeja, por favor?"
    mc "Você pode colocar minha xícara na sua bandeja, por favor?"

# game/scripts/c25/c25.rpy:1902
translate brazilian c25s003_Yoga_53041b4b:

    # "Te mueves a la puerta del garaje para llamar a Sound. Intentas mantener un tono amigable."
    "Você se dirige à porta da garagem para chamar a equipe de som. Você tenta manter um tom amigável."

# game/scripts/c25/c25.rpy:1903
translate brazilian c25s003_Yoga_28e9ff02:

    # mc "Buenos días, Jeff. Soy [mc] Marks. Espero no molestarte tan temprano."
    mc "Bom dia, Jeff. É o Marks. Espero não estar te incomodando tão cedo."

# game/scripts/c25/c25.rpy:1904
translate brazilian c25s003_Yoga_d7153acc:

    # jef "Buenos días, Sr. Marks. No se preocupe. ¿En qué puedo ayudarle?"
    jef "Bom dia, Sr. Marks. Não se preocupe. Como posso ajudá-lo?"

# game/scripts/c25/c25.rpy:1906
translate brazilian c25s003_Yoga_3a6c962e:

    # mc "Te llamaba por lo que pasó ayer en el barco. Con la chica..."
    mc "Eu estava ligando para saber o que aconteceu ontem no barco. Com a garota..."

# game/scripts/c25/c25.rpy:1907
translate brazilian c25s003_Yoga_13de4800:

    # jef "¿De qué quería hablar sobre ese tema?"
    jef "Sobre o que eu queria falar em relação a esse assunto?"

# game/scripts/c25/c25.rpy:1908
translate brazilian c25s003_Yoga_a7fb9abd:

    # mc "No sé lo que Ichigo tiene planeado con ella, pero no la vais a volver a contratar."
    mc "Não sei o que Ichigo planejou para ela, mas você não vai contratá-la novamente."

# game/scripts/c25/c25.rpy:1909
translate brazilian c25s003_Yoga_ab9b3eec:

    # jef "Perdone, Sr. Marks, pero no está en posición de decir quién puede o no puede contratar Iron Fist."
    jef "Com licença, Sr. Marks, mas o senhor não está em posição de dizer quem pode ou não contratar o Punho de Ferro."

# game/scripts/c25/c25.rpy:1911
translate brazilian c25s003_Yoga_4603a574:

    # "El tono amigable desaparece de tu voz."
    "O tom amigável desaparece da sua voz."

# game/scripts/c25/c25.rpy:1912
translate brazilian c25s003_Yoga_52a371b3:

    # mc "Tiene razón. No puedo decirles a quién tienen que contratar."
    mc "Você tem razão. Eu não posso dizer a eles quem contratar."

# game/scripts/c25/c25.rpy:1913
translate brazilian c25s003_Yoga_ec357799:

    # mc "Pero puedo revisar todos los contratos que nuestra división de Apoyo tiene con Iron Fist. Mis antecesores pusieron una cláusula que nos eximía en caso de fuerza mayor."
    mc "Mas posso rever todos os contratos que nossa divisão de Suporte tem com a Iron Fist. Meus antecessores incluíram uma cláusula que nos isentava de responsabilidade em caso de força maior."

# game/scripts/c25/c25.rpy:1914
translate brazilian c25s003_Yoga_a79b60c2:

    # jef "No puede hacer eso. La reputación de NTR..."
    jef "Ele não pode fazer isso. A reputação do NTR..."

# game/scripts/c25/c25.rpy:1916
translate brazilian c25s003_Yoga_912af936:

    # mc "La reputación de NTR quedará intacta. Estaremos cumpliendo el contrato. Los contratos."
    mc "A reputação da NTR permanecerá intacta. Honraremos o contrato. Os contratos."

# game/scripts/c25/c25.rpy:1917
translate brazilian c25s003_Yoga_808169d6:

    # mc "El martes hay un despliegue de operativos de Iron Fist en Venezuela usando un avión de NTR como transporte. Es posible que ese avión tenga algún problema con los motores."
    mc "Na terça-feira, agentes do Punho de Ferro foram enviados para a Venezuela utilizando uma aeronave da NTR para transporte. É possível que a aeronave esteja apresentando problemas no motor."

# game/scripts/c25/c25.rpy:1918
translate brazilian c25s003_Yoga_d02ea4ac:

    # mc "Tres días después, extracción de esos operativos en la costa. Mmmm... creo que el barco que íbamos a enviar tiene un problema y hace aguas."
    mc "Três dias depois, a extração dessas operações na costa. Hum... Acho que o navio que íamos enviar está com um problema e está entrando água."

# game/scripts/c25/c25.rpy:1919
translate brazilian c25s003_Yoga_b2b81e8c:

    # mc "¿Sigo? Hay once contratos para los próximos tres meses."
    mc "Devo continuar? Há onze contratos para os próximos três meses."

# game/scripts/c25/c25.rpy:1920
translate brazilian c25s003_Yoga_94fbceff:

    # jef "No, Sr. Marks. No hace falta que continúe."
    jef "Não, Sr. Marks. Não há necessidade de continuar."

# game/scripts/c25/c25.rpy:1922
translate brazilian c25s003_Yoga_02f8e7ca:

    # mc "Ustedes nos necesitan a nosotros. Nosotros no les necesitamos a ustedes."
    mc "Vocês precisam de nós. Nós não precisamos de vocês."

# game/scripts/c25/c25.rpy:1923
translate brazilian c25s003_Yoga_b8546b5b:

    # mc "Ya sabe. No volverán a contratar a la Srta. Brown, ni harán ningún informe negativo sobre ninguno de sus dos contratos con ustedes."
    mc "Sabe, eles não vão recontratar a Sra. Brown, nem vão escrever nenhum relatório negativo sobre os contratos dela com você."

# game/scripts/c25/c25.rpy:1924
translate brazilian c25s003_Yoga_e7cb3e0f:

    # jef "Lo entiendo. Se lo comunicaré al Sr. Ichigo. Se pondrá en contacto con usted."
    jef "Entendo. Vou avisar o Sr. Ichigo. Ele entrará em contato com você."

# game/scripts/c25/c25.rpy:1926
translate brazilian c25s003_Yoga_05d8d838:

    # mc "No hace falta que Ichigo pierda su tiempo llamándome. Que envíe un 'OK' junto a la oferta que me tiene que enviar para la absorción o fusión."
    mc "Ichigo não precisa perder tempo me ligando. Ele deveria simplesmente enviar um \"OK\" junto com a oferta que deveria me enviar para a absorção ou fusão."

# game/scripts/c25/c25.rpy:1927
translate brazilian c25s003_Yoga_fe35dedf:

    # mc "El mismo tipo de suspensión de contratos se aplicará si alguien de Iron Fist se acerca a alguien de mi familia, o si ponen alguna queja ante la agencia de la Srta. Brown."
    mc "O mesmo tipo de suspensão contratual será aplicado se alguém da Iron Fist entrar em contato com qualquer membro da minha família ou se apresentarem qualquer queixa à agência da Sra. Brown."

# game/scripts/c25/c25.rpy:1928
translate brazilian c25s003_Yoga_d3fe41ce:

    # mc "¿Entendido?"
    mc "Entendido?"

# game/scripts/c25/c25.rpy:1929
translate brazilian c25s003_Yoga_cb47e656:

    # jef "Entendido, Sr. Marks."
    jef "Entendido, Sr. Marks."

# game/scripts/c25/c25.rpy:1930
translate brazilian c25s003_Yoga_f7467f31:

    # mc "Que tenga un buen día, Sr. Sound."
    mc "Tenha um bom dia, Sr. Sound."

# game/scripts/c25/c25.rpy:1932
translate brazilian c25s003_Yoga_798928a5:

    # mcp "(Sound parece un buen tipo, pero tiene que defender su empresa. Supongo que es difícil trabajar para alguien como Ichigo.)"
    mcp "(Sound parece ser um cara legal, mas ele precisa defender a empresa dele. Acho que deve ser difícil trabalhar para alguém como o Ichigo.)"

# game/scripts/c25/c25.rpy:1933
translate brazilian c25s003_Yoga_d45b95c1:

    # "Cuando estás a punto de girarte volver con [kat]..."
    "Quando você está prestes a se virar e voltar com [kat]..."

# game/scripts/c25/c25.rpy:1935
translate brazilian c25s003_Yoga_4ccac790:

    # kim "*Jadeo de sorpresa*"
    kim "*Suspiro de surpresa*"

# game/scripts/c25/c25.rpy:1938
translate brazilian c25s003_Yoga_3af9bd6a:

    # kim "¿Qué has hecho, [mc]?"
    kim "O que você fez, [mc]?"

# game/scripts/c25/c25.rpy:1939
translate brazilian c25s003_Yoga_f06892bd:

    # mc "¿Cuánto llevas ahí, [kim]?"
    mc "Há quanto tempo você está aí, [kim]?"

# game/scripts/c25/c25.rpy:1940
translate brazilian c25s003_Yoga_d638db65:

    # kim "Desde que has dicho algo de Venezuela..."
    kim "Já que você mencionou a Venezuela..."

# game/scripts/c25/c25.rpy:1942
translate brazilian c25s003_Yoga_3394374b:

    # kim "Y después has dicho lo de mi contrato y los informes a la agencia..."
    kim "E então você mencionou meu contrato e os relatórios para a agência..."

# game/scripts/c25/c25.rpy:1943
translate brazilian c25s003_Yoga_ee048b03:

    # mc "No puedo dejar que seas una víctima en una guerra que no va contigo, [kim]. No sería justo."
    mc "Não posso deixar que você seja uma vítima em uma guerra que não tem nada a ver com você, [kim]. Não seria justo."

# game/scripts/c25/c25.rpy:1950
translate brazilian c25s003_Yoga_f703d36b:

    # "Miss Mapache California 2023 se lanza a darte un beso en el que hay tanto agradecimiento como pasión."
    "A Miss Mapache Califórnia 2023 ousa te dar um beijo repleto de gratidão e paixão."

# game/scripts/c25/c25.rpy:1953
translate brazilian c25s003_Yoga_c6d4cb33:

    # "[kim] se lanza a darte un abrazo en el que hay tanto agradecimiento como alivio."
    "[kim] se atira em você para lhe dar um abraço repleto de gratidão e alívio."

# game/scripts/c25/c25.rpy:1955
translate brazilian c25s003_Yoga_f97594fc:

    # kim "Gracias, [mc]. No sé cómo darte las gracias por algo así..."
    kim "Obrigado, [mc]. Não sei como te agradecer por algo assim..."

# game/scripts/c25/c25.rpy:1956
translate brazilian c25s003_Yoga_c39f7a0e:

    # mc "No hace falta darlas pero, de todas formas, lo acabas de hacer."
    mc "Você não precisa dar a eles, mas, de qualquer forma, você acabou de dar."

# game/scripts/c25/c25.rpy:1958
translate brazilian c25s003_Yoga_3cfa9aac:

    # mc "Y no estoy para nada de acuerdo con que tengas los labios feos."
    mc "Discordo completamente que você tenha lábios feios."

# game/scripts/c25/c25.rpy:1960
translate brazilian c25s003_Yoga_f0cdb5dc:

    # kim "*Risa* Gracias. Pero no te acostumbres. Me encanta mi pintalabios."
    kim "*Risos* Obrigada. Mas não se acostume. Eu adoro meu batom."

# game/scripts/c25/c25.rpy:1963
translate brazilian c25s003_Yoga_4c564d64:

    # kim "¡Me voy a dar una ducha o, si no, se me van a adelantar!"
    kim "Vou tomar um banho, senão eles vão chegar lá antes de mim!"

# game/scripts/c25/c25.rpy:1965
translate brazilian c25s003_Yoga_9da71f01:

    # kim "Y no estás invitado, antes de que preguntes."
    kim "E você não está convidado, antes mesmo de perguntar."

# game/scripts/c25/c25.rpy:1966
translate brazilian c25s003_Yoga_fe2c55b0:

    # mc "*Risa* Parece que las invitaciones no son necesarias entre nosotros, ¿no?"
    mc "*Risos* Parece que convites não são necessários entre nós, né?"

# game/scripts/c25/c25.rpy:1967
translate brazilian c25s003_Yoga_eefa4139:

    # mc "Anoche me desperté con una preciosidad entre mis brazos."
    mc "Ontem à noite acordei com uma linda criança nos braços."

# game/scripts/c25/c25.rpy:1969
translate brazilian c25s003_Yoga_f1ff02c7:

    # kim "¿Te molestó? Cada vez que cerraba los ojos... veía al Sr. Ichigo ordenándome que me desnudara..."
    kim "Isso te incomodou? Toda vez que eu fechava os olhos... eu via o Sr. Ichigo me ordenando que me despisse..."

# game/scripts/c25/c25.rpy:1970
translate brazilian c25s003_Yoga_04975c8b:

    # kim "Pensé que dormir contigo me calmaría, y así fue."
    kim "Pensei que dormir com você me acalmaria, e acalmou."

# game/scripts/c25/c25.rpy:1971
translate brazilian c25s003_Yoga_bfe1e78f:

    # mc "No me ha molestado, [kim]. Pero despiértame la próxima vez. Al menos para darme un beso de buenas noches."
    mc "Não me incomodou, [kim]. Mas me acorde da próxima vez. Pelo menos para me dar um beijo de boa noite."

# game/scripts/c25/c25.rpy:1973
translate brazilian c25s003_Yoga_7904dd8f:

    # "La hermosa modelo te da un beso de buenos días. La compensación no es algo por lo que vayas a quejarte."
    "A linda modelo manda um beijo de bom dia. A recompensa é mais do que suficiente."

# game/scripts/c25/c25.rpy:1975
translate brazilian c25s003_Yoga_6ee8f5fd:

    # kim "Lo tendré en cuenta para la próxima vez. Voy a darme esa ducha."
    kim "Vou me lembrar disso para a próxima vez. Vou tomar esse banho."

# game/scripts/c25/c25.rpy:1976
translate brazilian c25s003_Yoga_ea6e0675:

    # mc "Te veo luego, [kim]."
    mc "Até logo, [kim]."

# game/scripts/c25/c25.rpy:1978
translate brazilian c25s003_Yoga_c1fb1bcb:

    # "Te asomas para despedirte de [kat] y las chicas del yoga."
    "Você dá uma espiada para se despedir de [kat] e das garotas do yoga."

# game/scripts/c25/c25.rpy:1981
translate brazilian c25s003_Yoga_e58b0ead:

    # "La reacción al verte de [kia] especialmente, y de [mar], [nor], y [sam] es sospechosa."
    "A reação ao ver você de [kia] especialmente, e de [mar], [nor] e [sam] é suspeita."

# game/scripts/c25/c25.rpy:1982
translate brazilian c25s003_Yoga_9b6c9a20:

    # "Quizás solo creían que ya te habías ido y se han sorprendido al verte de nuevo."
    "Talvez eles simplesmente pensassem que você já tinha ido embora e ficaram surpresos ao vê-lo(a) novamente."

# game/scripts/c25/c25.rpy:1983
translate brazilian c25s003_Yoga_4266ee6f:

    # "O eso hubieras pensado hace tan solo unas semanas."
    "Ou pelo menos era o que você pensaria há algumas semanas."

# game/scripts/c25/c25.rpy:1985
translate brazilian c25s003_Yoga_bca053f3:

    # "Están demasiado ocupadas para notar que has vuelto."
    "Eles estão muito ocupados para perceber que você voltou."

# game/scripts/c25/c25.rpy:1987
translate brazilian c25s003_Yoga_4af25a40:

    # mc "Te veo luego, [kat]."
    mc "Até logo, [kat]."

# game/scripts/c25/c25.rpy:1988
translate brazilian c25s003_Yoga_91e627bf:

    # kat "Hasta luego, [mc]. Recuerda que tenemos una... {i}(¡No digas cita, no digas cita!){/i}... cita para desayunar."
    kat "Até logo, [mc]. Lembre-se que temos um... {i}(Não diga encontro, não diga encontro!){/i}... encontro para o café da manhã."

# game/scripts/c25/c25.rpy:1989
translate brazilian c25s003_Yoga_723dcc36:

    # mc "No te preocupes, no la olvidaré."
    mc "Não se preocupe, eu não vou me esquecer dela."

# game/scripts/c25/c25.rpy:1990
translate brazilian c25s003_Yoga_808e530b:

    # kat "{i}(¡Mierda, [kat]! ¡Lo has dicho!){/i}"
    kat "{i}(Droga, [kat]! Você disse tudo!){/i}"

# game/scripts/c25/c25.rpy:1992
translate brazilian c25s003_Yoga_e459e51c:

    # "Subes a la habitación, contento por cómo ha ido la conversación con Sound."
    "Você sobe até a sala, satisfeito com o rumo da conversa com Sound."

# game/scripts/c25/c25.rpy:1994
translate brazilian c25s003_Yoga_c1a26487:

    # "Estás contento de que la relación con [kim] se haya arreglado. Anoche estaba muy enfadada contigo."
    "Você está feliz que as coisas melhoraram com [kim]. Ela estava muito brava com você ontem à noite."

# game/scripts/c25/c25.rpy:1996
translate brazilian c25s003_Yoga_1b9c32e4:

    # "También estás confuso con la reacción de [mar], [nor], [sam], y [kia]. Ha sido solo un momento, pero era como si estuvieran planeando algo en lo que estabas involucrado."
    "Você também fica confuso com a reação de [mar], [nor], [sam] e [kia]. Foi apenas um instante, mas foi como se eles estivessem planejando algo em que você estaria envolvido."

# game/scripts/c25/c25.rpy:1997
translate brazilian c25s003_Yoga_a0cf6f8e:

    # "Y has quedado para desayunar con [kat]..."
    "E você combinou de tomar café da manhã com [kat]..."

# game/scripts/c25/c25.rpy:2000
translate brazilian c25s003_Yoga_8e326afb:

    # mcp "(¡Un momento! ¿Ha dicho cita? No puede ser, ¿no?)"
    mcp "(Espere um minuto! Ele disse encontro? Isso não pode estar certo, pode?)"

# game/scripts/c25/c25.rpy:2005
translate brazilian c25s003_NoMeg_a3890ba2:

    # "Al llegar a tu habitación empiezas a jugar a My Residence. La conversación con [deb.nick] te ha hecho recordar que llevas varias actualizaciones de retraso."
    "Ao chegar ao seu quarto, você começa a jogar My Residence. A conversa com [deb.nick] te lembrou que você está várias atualizações atrasado."

# game/scripts/c25/c25.rpy:2006
translate brazilian c25s003_NoMeg_e428453f:

    # "Tienes una tórrida escena con Kimberly, la bailarina, que está en la habitación del MC cuando vuelve de desayunar."
    "Você tem uma cena picante com Kimberly, a dançarina, que está no quarto do protagonista quando ele volta do café da manhã."

# game/scripts/c25/c25.rpy:2007
translate brazilian c25s003_NoMeg_70d4e350:

    # "[deb.nick] tenía parte de razón. Si Mandy y Vee tienen algo de [ama] y [eva], Kimberly tiene algo que te recuerda a [meg]."
    "[deb.nick] tinha razão. Se Mandy e Vee têm algo de [ama] e [eva], Kimberly tem algo que lembra [meg]."

# game/scripts/c25/c25.rpy:2008
translate brazilian c25s003_NoMeg_dbe4278f:

    # "Sin el comentario de [deb.nick] no crees que hubieras descubierto el parecido nunca."
    "Sem o comentário de [deb.nick], você provavelmente nunca teria notado a semelhança."

# game/scripts/c25/c25.rpy:2022
translate brazilian c25s003_Meg_1d2445d4:

    # "Al llegar a tu habitación, te encuentras una sorpresa en el sofá."
    "Ao chegar ao seu quarto, você encontra uma surpresa no sofá."

# game/scripts/c25/c25.rpy:2023
translate brazilian c25s003_Meg_49f2b733:

    # mc "¡Hola, [meg]! ¿Puedo ayudarte en algo?"
    mc "Olá, [meg]! Posso te ajudar em alguma coisa?"

# game/scripts/c25/c25.rpy:2025
translate brazilian c25s003_Meg_fe3a4bfa:

    # meg "Un momento que acabo la página, por favor."
    meg "Só um momento, vou terminar a página, por favor."

# game/scripts/c25/c25.rpy:2026
translate brazilian c25s003_Meg_f63377ab:

    # "Esperas."
    "Você espera."

# game/scripts/c25/c25.rpy:2027
translate brazilian c25s003_Meg_0981270f:

    # mc "¿Qué estás leyendo?"
    mc "O que você está lendo?"

# game/scripts/c25/c25.rpy:2029
translate brazilian c25s003_Meg_c927252f:

    # meg "Un libro sobre unos compositores que me gustan mucho."
    meg "Um livro sobre alguns compositores de que gosto muito."

# game/scripts/c25/c25.rpy:2030
translate brazilian c25s003_Meg_a0e16017:

    # mc "Lo que a mí me gusta mucho es el conjunto que llevas."
    mc "O que eu realmente gostei foi da roupa que você está usando."

# game/scripts/c25/c25.rpy:2037
translate brazilian c25s003_Meg_f4b6e8a0:

    # meg "¿Esto? Es algo que he pensado que te podría gustar..."
    meg "Isto? É algo que achei que você poderia gostar..."

# game/scripts/c25/c25.rpy:2038
translate brazilian c25s003_Meg_f99c883a:

    # mc "Y has acertado completamente."
    mc "E você tem toda a razão."

# game/scripts/c25/c25.rpy:2039
translate brazilian c25s003_Meg_eba83385:

    # mc "Pero... ¿quién eres y qué has hecho con [meg]?"
    mc "Mas... quem é você e o que fez com [meg]?"

# game/scripts/c25/c25.rpy:2041
translate brazilian c25s003_Meg_c029dfe6:

    # meg "¿A qué te refieres?"
    meg "O que você está falando?"

# game/scripts/c25/c25.rpy:2042
translate brazilian c25s003_Meg_e561c481:

    # mc "Mi [meg] nunca diría algo así. Estaría quejándose de que el modelo es precioso pero de que no le queda igual que le quedaría a [ama], o a [nor]."
    mc "Minha [meg] jamais diria algo assim. Ela estaria reclamando que a modelo é linda, mas que não fica tão bem nela quanto ficaria em [ama] ou [nor]."

# game/scripts/c25/c25.rpy:2043
translate brazilian c25s003_Meg_2d340316:

    # mc "¡Alien, sal del cuerpo de [meg]! *Risa* ¡Has poseído su cuerpo, pero no sabes cómo piensa!"
    mc "Alienígena, saia do corpo do <e4! *Risos* Você possuiu o corpo dele, mas não sabe como ele pensa!"

# game/scripts/c25/c25.rpy:2045
translate brazilian c25s003_Meg_e55d802d:

    # meg "*Risa* A lo mejor tu [meg] ha descubierto que no necesita los abdominales de [ama] o las tetas de [nor] para gustarte."
    meg "*Risos* Talvez seu [meg] tenha descoberto que não precisa dos abdominais de [ama] ou dos seios de [nor] para te agradar."

# game/scripts/c25/c25.rpy:2046
translate brazilian c25s003_Meg_8d957bf4:

    # meg "A lo mejor, gracias a todo lo que le has dicho, se ha vuelto un poco más segura de sí misma."
    meg "Talvez, graças a tudo o que você lhe disse, ela tenha se tornado um pouco mais confiante."

# game/scripts/c25/c25.rpy:2047
translate brazilian c25s003_Meg_59c19b2d:

    # mc "*Risa* ¡Mierda! Ahora no sé si realmente eres tú. Los aliens pueden ser muy astutos... y un alien poseyendo el cuerpo de [meg] seguramente diría eso."
    mc "*Risos* Droga! Agora não sei se é você mesmo. Alienígenas podem ser muito astutos... e um alienígena possuindo o corpo de [meg] certamente diria isso."

# game/scripts/c25/c25.rpy:2049
translate brazilian c25s003_Meg_fa8b621a:

    # meg "*Risa* ¿Crees que un alien sabría cómo besa tu [meg]?"
    meg "*Risos* Você acha que um alienígena saberia como seus [meg] beijos?"

# game/scripts/c25/c25.rpy:2050
translate brazilian c25s003_Meg_d3c34414:

    # mc "*Risa* No lo creo, si no han sido capaces de acceder a sus recuerdos."
    mc "*Risos* Acho que não, se eles não conseguiram acessar suas memórias."

# game/scripts/c25/c25.rpy:2052
translate brazilian c25s003_Meg_ea974352:

    # meg "Entonces, déjame demostrarte que soy yo. Aunque para poseer mi cuerpo se necesitaría una civilización completa de aliens. Hay mucho cuerpo que poseer."
    meg "Então deixe-me provar que sou eu. Embora possuir meu corpo exigisse uma civilização alienígena inteira. Há muitos corpos para possuir."

