    mcp "(Eu conheço esse sorriso. Ela sabe que eu sei que ela está escondendo alguma coisa.)"

# game/scripts/c25/c25.rpy:2773
translate brazilian c25s004_KimDebLisaSai_eac49f44:

    # mc "Okay. Decídmelo si necesitáis que os lleve. Estaré en mi habitación trabajando un poco hasta la hora de comer."
    mc "Certo. Me avise se precisar de carona. Estarei no meu quarto trabalhando até a hora do almoço."

# game/scripts/c25/c25.rpy:2775
translate brazilian c25s004_KimDebLisaSai_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "Até logo, meninas."

# game/scripts/c25/c25.rpy:2776
translate brazilian c25s004_KimDebLisaSai_6ad62d0c:

    # kat "Hasta luego, [mc]." (multiple=2)
    kat "Até logo, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2777
translate brazilian c25s004_KimDebLisaSai_a9c1d0ed:

    # eil "Hasta luego, [mc]." (multiple=2)
    eil "Até logo, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2779
translate brazilian c25s004_KimDebLisaSai_2fdb8487:

    # "Abres la puerta de tu habitación para dejar el móvil antes de ir al lavabo."
    "Você abre a porta do seu quarto para guardar o celular antes de ir ao banheiro."

# game/scripts/c25/c25.rpy:2780
translate brazilian c25s004_KimDebLisaSai_8fbaa740:

    # "En el momento en que cierras tu puerta, oyes cómo se abre la de [sai]."
    "No momento em que você fecha a sua porta, você ouve a porta de [sai] abrir."

# game/scripts/c25/c25.rpy:2781
translate brazilian c25s004_KimDebLisaSai_5a4dd715:

    # sai "[kat], te tenías que ocupar de vigilar que no viniera nadie. Y menos aún [mc]."
    sai "[kat], você tinha que garantir que ninguém viesse. E ainda menos [mc]."

# game/scripts/c25/c25.rpy:2782
translate brazilian c25s004_KimDebLisaSai_767591b8:

    # kat "Lo siento. La conversación estaba interesante y no lo he oído llegar."
    kat "Sinto muito. A conversa estava interessante e eu não ouvi você chegar."

# game/scripts/c25/c25.rpy:2783
translate brazilian c25s004_KimDebLisaSai_359ef0e4:

    # deb "A mí me ha pasado lo mismo. Estaba tan atenta a lo que decíais que no lo he oído llegar."
    deb "A mesma coisa aconteceu comigo. Eu estava tão concentrado no que você estava dizendo que não ouvi o que ia dizer."

# game/scripts/c25/c25.rpy:2785
translate brazilian c25s004_KimDebLisaSai_143d600b:

    # deb "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    deb "E isso partindo do princípio de que duvido que algum dia terei um jantar a sós com ele."

# game/scripts/c25/c25.rpy:2786
translate brazilian c25s004_KimDebLisaSai_5a72e6b1:

    # lis "Estoy en la misma situación que [deb.nick]."
    lis "Estou na mesma situação que [deb.nick]."

# game/scripts/c25/c25.rpy:2788
translate brazilian c25s004_KimDebLisaSai_3882306f:

    # lis "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    lis "E isso partindo do princípio de que duvido que algum dia terei um jantar a sós com ele."

# game/scripts/c25/c25.rpy:2789
translate brazilian c25s004_KimDebLisaSai_3fce954d:

    # kim "Es que lo explicáis de tal forma que es casi como estar ahí, en vuestras citas."
    kim "Você explica de uma forma que é quase como estar lá, nos seus encontros."

# game/scripts/c25/c25.rpy:2791
translate brazilian c25s004_KimDebLisaSai_256bcef7:

    # kim "Aunque dudo que me vayan a servir de mucho esos conocimientos."
    kim "Embora eu duvide que esse conhecimento me seja de muita utilidade."

# game/scripts/c25/c25.rpy:2792
translate brazilian c25s004_KimDebLisaSai_f3e4baaa:

    # eil "Chicas, no sé si nos ha oído, pero sabe que estaba pasando algo. Se lo he leído en la cara."
    eil "Meninas, não sei se ela nos ouviu, mas ela sabe que algo estava acontecendo. Eu pude ver pela expressão no rosto dela."

# game/scripts/c25/c25.rpy:2794
translate brazilian c25s004_KimDebLisaSai_daa8d239:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si no las he querido escuchar antes, mejor será no hacerlo ahora.)"
    mcp "(É melhor eu continuar com o que estava fazendo. Se eu não queria ouvi-los antes, é melhor não ouvir agora."

# game/scripts/c25/c25.rpy:2796
translate brazilian c25s004_KimDebLisaSai_a446b3de:

    # kat "Bueno, ya se ha ido. Ibas a hablar del columpio, [eil]."
    kat "Bem, ele já foi embora. Você ia falar sobre o swing, [eil]."

# game/scripts/c25/c25.rpy:2797
translate brazilian c25s004_KimDebLisaSai_a1fc8034:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si van a empezar a hablar de [eil] y de mí en el columpio...)"
    mcp "(É melhor eu continuar com o que estava fazendo. Se eles vão começar a falar sobre [eil] e eu no balanço...)"

# game/scripts/c25/c25.rpy:2800
translate brazilian c25s004_KimDebLisaSai_9bf43002:

    # "Vas al lavabo y trabajas durante una hora, hasta que empieza a entrarte sed. Sigues sin acordarte de coger una botella de agua."
    "Você vai ao banheiro e trabalha por uma hora, até começar a sentir sede. Mesmo assim, você não se lembra de pegar uma garrafa de água."

# game/scripts/c25/c25.rpy:2801
translate brazilian c25s004_KimDebLisaSai_0e4aee02:

    # "Bajas a la cocina a beber algo."
    "Você desce até a cozinha para pegar uma bebida."

# game/scripts/c25/c25.rpy:2805
translate brazilian c25s004_Listen_e330979f:

    # "Por sus voces las puedes imaginar sentadas en el suelo, alrededor de las dos maestras."
    "Pelas vozes deles, dá para imaginá-los sentados no chão, em volta dos dois professores."

# game/scripts/c25/c25.rpy:2806
translate brazilian c25s004_Listen_3d3682ee:

    # "Casi se te escapa la risa y delatas tu presencia."
    "Você quase cai na gargalhada e entrega sua presença."

# game/scripts/c25/c25.rpy:2808
translate brazilian c25s004_Listen_4ebdddd8:

    # kim "¿Dónde lo llevaste a cenar en tu primera cita, [sai]?"
    kim "Onde você o levou para jantar no primeiro encontro, [sai]?"

# game/scripts/c25/c25.rpy:2810
translate brazilian c25s004_Listen_1e00e275:

    # sai "Bueno, fue él quien me llevó a comer a mí, no a cenar. Fue en un restaurante escandinavo. Pero no fue la primera cita. Esa había sido en la cafetería de la que os he hablado."
    sai "Bem, foi ele quem me levou para almoçar, não para jantar. Foi em um restaurante escandinavo. Mas não foi nosso primeiro encontro. Esse foi na cafeteria que eu te contei."

# game/scripts/c25/c25.rpy:2811
translate brazilian c25s004_Listen_41f2ece9:

    # sai "Por si os interesa, pidió albóndigas suecas y smorrebrod, o como se diga."
    sai "Caso você tenha curiosidade, ele pediu almôndegas suecas e smørrebrød, ou algo parecido."

# game/scripts/c25/c25.rpy:2813
translate brazilian c25s004_Listen_1ec9791d:

    # eil "*Risa* Me lo imaginaba. Lo que me hubiera sorprendido es que hubiese pedido arenque."
    eil "*Risos* Eu já imaginava. O que me surpreenderia seria se ele tivesse pedido arenque."

# game/scripts/c25/c25.rpy:2815
translate brazilian c25s004_Listen_26125ae6:

    # deb "¿Y tú, [eil]? ¿Cómo fue vuestra primera cita?"
    deb "E você, [eil]? Como foi seu primeiro encontro?"

# game/scripts/c25/c25.rpy:2817
translate brazilian c25s004_Listen_da3bec1c:

    # eil "Te va a parecer gracioso, pero nunca tuvimos una 'primera cita'. Nos veíamos todos los días en el instituto, la cosa entre nosotros surgió poco a poco."
    eil "Você vai achar isso engraçado, mas nós nunca tivemos um \"primeiro encontro\". Nos víamos todos os dias na escola, e as coisas entre nós foram se desenvolvendo aos poucos."

# game/scripts/c25/c25.rpy:2818
translate brazilian c25s004_Listen_bc26e0c0:

    # eil "Para cuando nos dimos cuenta, estábamos saliendo y no habíamos tenido una cita. La mayoría de las veces comíamos con Jamaal. Imaginaos qué romántico era todo. *Risa*"
    eil "Antes que percebêssemos, já estávamos nos vendo sem nem mesmo termos tido um encontro. Na maioria das vezes, apenas almoçávamos com o Jamaal. Imagine o quão romântico isso era! *Risos*"

# game/scripts/c25/c25.rpy:2821
translate brazilian c25s004_Listen_92ed8ad3:

    # lis "A mí me gustaría tener una primera cita. Sería algo que recordar siempre y... no sé... como una fecha para nuestro aniversario de salir juntos."
    lis "Eu adoraria ter um primeiro encontro. Seria algo para sempre lembrar e... sei lá... tipo um encontro para comemorar nosso aniversário de namoro."

# game/scripts/c25/c25.rpy:2823
translate brazilian c25s004_Listen_ce44d423:

    # lis "Cuando salga con alguien, me gustaría tener una primera cita. Sería algo que recordar siempre y como una fecha para nuestro aniversario de salir juntos."
    lis "Quando começo a namorar alguém, gostaria de ter um primeiro encontro. Seria algo para sempre lembrar, como um encontro para comemorar nosso aniversário."

# game/scripts/c25/c25.rpy:2824
translate brazilian c25s004_Listen_283ad907:

    # lis "*Risita* Al menos hasta que pueda sustituírlo por el aniversario de boda."
    lis "*Risos* Pelo menos até eu poder substituir isso pelo aniversário de casamento."

# game/scripts/c25/c25.rpy:2827
translate brazilian c25s004_Listen_8aa32af2:

    # deb "No digas tonterías, [lis]. Tienes marcado en tu diario el día que te besó por primera vez, cuando os encerré en nuestra habitación."
    deb "Não fale bobagens, [lis]. Você marcou no seu diário o dia em que ele te beijou pela primeira vez, quando eu te tranquei no nosso quarto."

# game/scripts/c25/c25.rpy:2828
translate brazilian c25s004_Listen_afa4cd12:

    # deb "Creo que, cuando se cumpla un año de ese beso, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Acho que quando chegar o aniversário daquele beijo, você vai comemorá-lo mais do que quando chegar o aniversário do seu futuro primeiro encontro."

# game/scripts/c25/c25.rpy:2830
translate brazilian c25s004_Listen_64db342a:

    # deb "No digas tonterías, [lis]. Si te hubiera besado cuando os encerré en nuestra habitación, tendrías ese día marcado en tu diario."
    deb "Não fale bobagens, [lis]. Se eu tivesse te beijado quando te tranquei no nosso quarto, você teria esse dia marcado no seu diário."

# game/scripts/c25/c25.rpy:2831
translate brazilian c25s004_Listen_7eb04199:

    # deb "Creo que, cuando se cumpla un año de tu primer beso cuando salgas con alguien, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Acho que quando chegar o aniversário do seu primeiro beijo com alguém, você vai comemorar mais do que quando chegar o aniversário do seu primeiro encontro futuro."

# game/scripts/c25/c25.rpy:2833
translate brazilian c25s004_Listen_77282ea8:

    # deb "A mí me gustaría celebrar como nuestro aniversario el día que nos besamos en el lago por primera vez."
    deb "Gostaria de comemorar o dia em que nos beijamos pela primeira vez no lago como nosso aniversário de namoro."

# game/scripts/c25/c25.rpy:2835
translate brazilian c25s004_Listen_7d823dbe:

    # kat "Pero eso es porque tú y [kim] sois unas románticas. *Risa* La mayoría de la gente celebra la boda."
    kat "Mas isso porque você e [kim] são muito românticos. *Risos* A maioria das pessoas comemora o casamento."

# game/scripts/c25/c25.rpy:2836
translate brazilian c25s004_Listen_261a1a24:

    # kat "Pero la pregunta importante es... ¿Lees el diario de tu hermana, [deb.nick]?"
    kat "Mas a pergunta importante é... Você lê o diário da sua irmã, [deb.nick]?"

# game/scripts/c25/c25.rpy:2838
translate brazilian c25s004_Listen_60629825:

    # sai "Chicas, guardad vuestros diarios bajo llave. *Risa* Tenemos una espía."
    sai "Meninas, tranque seus diários. *Risos* Temos uma espiã."

# game/scripts/c25/c25.rpy:2839
translate brazilian c25s004_Listen_2f6e62de:

    # mcp "(*Risa mental* Sí, pero no tiene que ver con los diarios.)"
    mcp "(*Risos internos* Sim, mas não tem nada a ver com diários.)"

# game/scripts/c25/c25.rpy:2841
translate brazilian c25s004_Listen_9f506759:

    # lis "*Risa* Siempre se lo he dejado leer. Es un diario online y tiene permiso para leerlo... al menos tiene permisos para ver algunas entradas."
    lis "*Risos* Sempre deixei ele ler. É um diário online e ele tem permissão para ler... pelo menos tem permissão para ver algumas entradas."

# game/scripts/c25/c25.rpy:2842
translate brazilian c25s004_Listen_a958c3d2:

    # lis "Nos ha ido muy bien algunas veces. Ya sabéis que a veces me pongo muy estúpida sin venir a cuento."
    lis "Às vezes nos saímos muito bem. Você sabe como eu posso ficar muito estúpido sem motivo aparente."

# game/scripts/c25/c25.rpy:2843
translate brazilian c25s004_Listen_0e536994:

    # todas "*Risa* Sí."
    todas "*Risos* Sim."

# game/scripts/c25/c25.rpy:2845
translate brazilian c25s004_Listen_7dcc2caf:

    # kim "*Risa* Somos unas malas amigas... Tendríamos que haberle dicho, 'No, [lis], siempre que te pones estúpida es por una razón justificada.'"
    kim "*Risos* Somos péssimas amigas... Deveríamos ter dito a ela: 'Não, [lis], sempre que você age de forma estúpida, é por um motivo justificado.'"

# game/scripts/c25/c25.rpy:2846
translate brazilian c25s004_Listen_3e51f1da:

    # kim "*Risa* Pero mentir también es de malas amigas... Estoy en una encrucijada."
    kim "*Risos* Mas mentir também é uma má companhia... Estou numa encruzilhada."

# game/scripts/c25/c25.rpy:2847
translate brazilian c25s004_Listen_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c25/c25.rpy:2849
translate brazilian c25s004_Listen_23de23e2:

    # lis "*Risa* Te robaré el pintalabios como venganza por lo que acabas de decir."
    lis "*Risos* Vou roubar seu batom como vingança pelo que você acabou de dizer."

# game/scripts/c25/c25.rpy:2850
translate brazilian c25s004_Listen_63251888:

    # lis "Es broma. Me encanta que me digáis lo que hago mal. Hasta ahora sólo se atrevía [deb.nick]."
    lis "Brincadeirinha. Adoro quando você me diz o que estou fazendo de errado. Até agora, só [deb.nick] se atreveu."

# game/scripts/c25/c25.rpy:2852
translate brazilian c25s004_Listen_f25147f6:

    # kat "Chicas, nos estamos desviando del tema. Estábamos hablando de [mc]."
    kat "Meninas, estamos nos desviando do assunto. Estávamos falando sobre [mc]."

# game/scripts/c25/c25.rpy:2853
translate brazilian c25s004_Listen_972239aa:

    # kat "[eil], la última vez estabas diciendo algo de un columpio."
    kat "[eil], da última vez você estava falando sobre um balanço."

# game/scripts/c25/c25.rpy:2855
translate brazilian c25s004_Listen_6c13d4f7:

    # eil "Bueno, ha habido varias veces en un columpio, pero..."
    eil "Bem, isso já aconteceu várias vezes em um balanço, mas..."

# game/scripts/c25/c25.rpy:2856
translate brazilian c25s004_Listen_1e77ac63:

    # mcp "(Creo que es el momento de hacerme notar. Si empiezan a hablar de sexo y me descubren escuchando se van a enfadar.)"
    mcp "(Acho que está na hora de me apresentar. Se eles começarem a falar de sexo e me pegarem ouvindo, vão ficar bravos.)"

# game/scripts/c25/c25.rpy:2857
translate brazilian c25s004_Listen_1fa64ca7:

    # mcp "(Especialmente si hablan de sexo conmigo.)"
    mcp "(Principalmente se falarem de sexo comigo.)"

# game/scripts/c25/c25.rpy:2918
translate brazilian c25s004_MarPickles_edd270a7:

    # "Llegas a la cocina y ves a [mar] con la cabeza metida en la nevera."
    "Você chega à cozinha e vê [mar] com a cabeça presa na geladeira."

# game/scripts/c25/c25.rpy:2919
translate brazilian c25s004_MarPickles_956ec74f:

    # mc "¿Estás preparando la comida?"
    mc "Você está preparando a comida?"

# game/scripts/c25/c25.rpy:2922
translate brazilian c25s004_MarPickles_71094ac0:

    # mom "No, aún no. Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    mom "Não, ainda não. Estou com muita vontade de comer picles com sorvete de chocolate, mas não temos picles."

# game/scripts/c25/c25.rpy:2923
translate brazilian c25s004_MarPickles_84f35fa2:

    # mc "¡Aargh! *Risa* ¡Eso tiene que tener un gusto horrendo! No te he visto nunca comer algo así."
    mc "Argh! *Risos* Deve ter um gosto horrível! Nunca te vi comer nada parecido."

# game/scripts/c25/c25.rpy:2924
translate brazilian c25s004_MarPickles_7613b351:

    # mc "¿Es posible que sea un antojo del embarazo?"
    mc "Será possível que seja um desejo de grávida?"

# game/scripts/c25/c25.rpy:2927
translate brazilian c25s004_MarPickles_7c51ff83:

    # mom "No lo creo. No tuve antojos cuando estuve embarazada de ti ni de [emm]. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Acho que não. Não tive nenhum desejo específico quando estava grávida de você ou do [emm]. Sempre achei que desejos são uma forma boba de se aproveitar de pais indefesos."

# game/scripts/c25/c25.rpy:2929
translate brazilian c25s004_MarPickles_28435bd9:

    # mom "No lo creo. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Acho que não. Sempre achei que os desejos incontroláveis são uma forma boba de se aproveitar de pais pobres."

# game/scripts/c25/c25.rpy:2930
translate brazilian c25s004_MarPickles_14bc9b06:

    # mom "Pero es posible... ahora que lo dices, suena asqueroso."
    mom "Mas é possível... agora que você mencionou, parece nojento."

# game/scripts/c25/c25.rpy:2931
translate brazilian c25s004_MarPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Você quer que eu vá comprar picles?"

# game/scripts/c25/c25.rpy:2933
translate brazilian c25s004_MarPickles_59520599:

    # mom "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    mom "Se não se importar... Mesmo que pareça nojento, eu ainda os quero."

# game/scripts/c25/c25.rpy:2934
translate brazilian c25s004_MarPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Não se preocupe, vou comprá-los agora."

# game/scripts/c25/c25.rpy:2936
translate brazilian c25s004_MarPickles_f88ea23f:

    # mom "Estaba empezando a prepararla, pero no hay suficiente pollo."
    mom "Eu estava começando a preparar, mas não tem frango suficiente."

# game/scripts/c25/c25.rpy:2937
translate brazilian c25s004_MarPickles_ee07af24:

    # mc "¿Quieres que vaya a comprar?"
    mc "Você quer que eu vá às compras?"

# game/scripts/c25/c25.rpy:2939
translate brazilian c25s004_MarPickles_2dfd3d61:

    # mom "Si no te importa... Iba a hacer paella, aunque seguramente algún español me mataría si probase mi receta de paella."
    mom "Se não se importar... eu ia fazer paella, embora eu tenha certeza de que algum espanhol me mataria se experimentasse minha receita de paella."

# game/scripts/c25/c25.rpy:2940
translate brazilian c25s004_MarPickles_2efe82ef:

    # mc "*Risa* Ningún problema. Y seguramente ese español cambiaría la receta tradicional por la tuya en cuanto la probara. Tu paella está buenísima."
    mc "*Risos* Sem problema. E tenho certeza de que aquele espanhol trocaria a receita tradicional pela sua assim que a provasse. Sua paella é deliciosa."

# game/scripts/c25/c25.rpy:2943
translate brazilian c25s004_MarPickles_70958b08:

    # mom "Gracias, mi amor."
    mom "Obrigado, meu amor."

# game/scripts/c25/c25.rpy:2945
translate brazilian c25s004_MarPickles_4724458f:

    # mom "¿Puedes pasar a buscar a [mad.nick] también? Así le ahorras tener que coger un Under para venir a comer."
    mom "Você pode pegar [mad.nick] também? Assim você evita que ele tenha que fazer um Under para vir comer."

# game/scripts/c25/c25.rpy:2946
translate brazilian c25s004_MarPickles_693d082e:

    # mc "Ningún problema. ¿La avisas tú de que voy a por ella?"
    mc "Sem problema. Você pode avisá-la que estou indo buscá-la?"

# game/scripts/c25/c25.rpy:2951
translate brazilian c25s004_EmmPickles_abdb365d:

    # "Llegas a la cocina y ves a [emm] con la cabeza metida en la nevera."
    "Você chega à cozinha e vê [emm] com a cabeça presa na geladeira."

# game/scripts/c25/c25.rpy:2952
translate brazilian c25s004_EmmPickles_ae30622e:

    # mc "¿Estás buscando algo para comer antes de la hora de la comida?"
    mc "Está procurando algo para comer antes do almoço?"

# game/scripts/c25/c25.rpy:2954
translate brazilian c25s004_EmmPickles_91fd84af:

    # emm "Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    emm "Eu gostaria de picles com sorvete de chocolate, mas não temos picles."

# game/scripts/c25/c25.rpy:2955
translate brazilian c25s004_EmmPickles_84f35fa2:

