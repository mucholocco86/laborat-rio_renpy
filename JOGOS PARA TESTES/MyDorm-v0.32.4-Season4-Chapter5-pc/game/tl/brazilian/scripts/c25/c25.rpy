

# game/scripts/c25/c25.rpy:32
translate brazilian c25s001_Eva_879c1fb9:

    # "Al llegar a la galería de tiro, [eva] guarda la moto dentro de lo que parece un almacén vacío."
    "Ao chegar ao campo de tiro, [eva] guarda a motocicleta dentro do que parece ser um armazém vazio."

# game/scripts/c25/c25.rpy:33
translate brazilian c25s001_Eva_60361cd5:

    # eva "Ya estamos aquí. ¿Preparado para la clase de tiro? Hoy no será con munición de práctica."
    eva "Chegamos. Prontos para a aula de tiro? Hoje não usaremos munição de treino."

# game/scripts/c25/c25.rpy:34
translate brazilian c25s001_Eva_07ece46c:

    # mc "Sí, hace días que no hemos practicado y..."
    mc "Sim, já faz alguns dias desde o nosso último treino e..."

# game/scripts/c25/c25.rpy:36
translate brazilian c25s001_Eva_fb88a8bd:

    # eva "*Risa* ¡No has practicado tú! Yo practico todos los días."
    eva "*Risos* Você não praticou! Eu pratico todos os dias."

# game/scripts/c25/c25.rpy:39
translate brazilian c25s001_Eva_1e8d7864:

    # eva "Pero entiendo que has estado muy ocupado últimamente para practicar."
    eva "Mas entendo que você tem estado muito ocupado ultimamente para praticar."

# game/scripts/c25/c25.rpy:40
translate brazilian c25s001_Eva_671f92cf:

    # mc "No he tenido tiempo ni de tumbarme a no hacer nada. Era uno de mis pasatiempos favoritos. *Risa*"
    mc "Nem tive tempo de ficar deitado sem fazer nada. Era um dos meus passatempos favoritos. *Risos*"

# game/scripts/c25/c25.rpy:42
translate brazilian c25s001_Eva_01d76747:

    # eva "Pero entiendo que has estado muy ocupado últimamente para pasar tiempo conmigo y practicar."
    eva "Mas entendo que você tem estado muito ocupado ultimamente para passar um tempo comigo e praticar."

# game/scripts/c25/c25.rpy:43
translate brazilian c25s001_Eva_f3695eec:

    # mc "[eva], siempre tendré tiempo para pasar tiempo contigo. Sea para disparar o para tumbarnos a tomar el sol sin hacer nada."
    mc "[eva], Sempre terei tempo para passar tempo com você. Seja fotografando ou apenas deitado ao sol sem fazer nada."

# game/scripts/c25/c25.rpy:45
translate brazilian c25s001_Eva_ca9b99e3:

    # eva "*Risa* Nunca entenderé cómo podéis desperdiciar el tiempo sin hacer nada. Aparte de aburrido... es un desperdicio enorme."
    eva "*Risos* Nunca vou entender como alguém consegue perder tempo sem fazer nada. Além de ser chato... é um desperdício enorme."

# game/scripts/c25/c25.rpy:46
translate brazilian c25s001_Eva_53705c25:

    # eva "¡Hay un montón de cosas que hacer, que ver, que leer! Yo no tengo horas suficientes para hacer todo lo que me gustaría..."
    eva "Há tantas coisas para fazer, ver e ler! Não tenho horas suficientes no dia para fazer tudo o que gostaria..."

# game/scripts/c25/c25.rpy:47
translate brazilian c25s001_Eva_b037bcf5:

    # mc "Nadie las tiene, [eva]. ¿Qué te gustaría hacer?"
    mc "Ninguém os tem, [eva]. O que você gostaria de fazer?"

# game/scripts/c25/c25.rpy:49
translate brazilian c25s001_Eva_487c0bf9:

    # eva "Hay mil cosas que me gustaría hacer, pero no hay tiempo para todo. Y menos aún para tumbarme a no hacer nada."
    eva "Há mil coisas que eu gostaria de fazer, mas não há tempo para tudo. E menos ainda para ficar deitado sem fazer nada."

# game/scripts/c25/c25.rpy:50
translate brazilian c25s001_Eva_9e49941c:

    # eva "El otro día estaba viendo una película... la he empezado tres o cuatro veces... pero cuando matan a la madre del cervatillo... tengo que dejarlo."
    eva "Outro dia eu estava assistindo a um filme... Comecei a assistir umas três ou quatro vezes... mas quando matam a mãe do filhote de cervo... tive que parar."

# game/scripts/c25/c25.rpy:51
translate brazilian c25s001_Eva_3ed6b865:

    # eva "Lo mismo que con la película en que muere el padre del leoncito. Me gustaría tener tiempo para acabar las dos."
    eva "O mesmo vale para o filme em que o pai do filhote de leão morre. Gostaria de ter tempo para terminar de assistir aos dois."

# game/scripts/c25/c25.rpy:52
translate brazilian c25s001_Eva_735cd2da:

    # mc "Son muy buenas. Si quieres un día las acabamos de ver juntos. Te queda la mitad de cada película más o menos."
    mc "Eles são muito bons. Se você quiser, podemos terminar de assisti-los juntos algum dia. Você está mais ou menos na metade de cada filme."

# game/scripts/c25/c25.rpy:54
translate brazilian c25s001_Eva_18ac9d9e:

    # eva "¿Te gustan esas películas? [ama] dice que son para niños... pero a mí me encantan."
    eva "Você gosta desses filmes? [ama] Diz que são para crianças... mas eu adoro."

# game/scripts/c25/c25.rpy:55
translate brazilian c25s001_Eva_02f9af6d:

    # eva "Y a ella también. No le digas que te lo he dicho... La vi llorando después de lo del león."
    eva "E ela também. Não conte a ela que eu te disse... Eu a vi chorando depois do incidente com o leão."

# game/scripts/c25/c25.rpy:56
translate brazilian c25s001_Eva_dc2f137d:

    # mc "*Risa* No te preocupes. Tu secreto está a salvo conmigo."
    mc "*Risos* Não se preocupe. Seu segredo está a salvo comigo."

# game/scripts/c25/c25.rpy:58
translate brazilian c25s001_Eva_f97d75b3:

    # eva "Vamos dentro. Ya llevamos dos minutos aquí, hablando sin hacer nada. Se te va a pasar el tiempo para entrenar."
    eva "Vamos entrar. Já estamos aqui há dois minutos, conversando e sem fazer nada. Você vai perder seu horário de treino."

# game/scripts/c25/c25.rpy:59
translate brazilian c25s001_Eva_078381f9:

    # mc "*Risa* Estamos hablando. Eso es hacer algo."
    mc "*Risos* Estamos conversando. Isso já é alguma coisa."

# game/scripts/c25/c25.rpy:61
translate brazilian c25s001_Eva_fb7bd1e4:

    # mc "Y acabamos de planificar una cita para acabar de ver dos películas de dibujos animados."
    mc "E acabamos de marcar um encontro para terminar de assistir a dois filmes de animação."

# game/scripts/c25/c25.rpy:63
translate brazilian c25s001_Eva_dcadb36a:

    # mc "Y acabamos de planificar ver dos películas de dibujos animados."
    mc "E nós tínhamos planejado assistir a dois filmes de animação."

# game/scripts/c25/c25.rpy:65
translate brazilian c25s001_Eva_5ca67a1d:

    # eva "Vale, pero hemos venido a que entrenes con una pistola de verdad. Y es lo que vamos a hacer."
    eva "Certo, mas estamos aqui para que você possa treinar com uma arma de verdade. E é isso que vamos fazer."

# game/scripts/c25/c25.rpy:66
translate brazilian c25s001_Eva_abb97725:

    # mc "*Risa* También tienes que aprender a relajarte y a que los planes pueden cambiar sobre la marcha."
    mc "*Risos* Você também precisa aprender a relaxar, já que os planos podem mudar de repente."

# game/scripts/c25/c25.rpy:67
translate brazilian c25s001_Eva_2ad03cc3:

    # mc "Por cierto, ¿por qué has guardado la moto en el almacén? El aparcamiento está vacío."
    mc "A propósito, por que você guardou a motocicleta no depósito? O estacionamento está vazio."

# game/scripts/c25/c25.rpy:69
translate brazilian c25s001_Eva_4db698b7:

    # eva "La primera razón es porque no quiero que cuando venga el helicóptero vea la moto y la matrícula. No sabemos qué intenciones tienen y no queremos darles pistas."
    eva "O primeiro motivo é que não quero que o helicóptero veja a motocicleta e a placa quando chegar. Não sabemos quais são as intenções deles e não queremos dar nenhuma pista."

# game/scripts/c25/c25.rpy:70
translate brazilian c25s001_Eva_7baeba08:

    # mc "Me parece una buena razón, pero intuyo que hay una segunda razón más importante."
    mc "Parece ser um bom motivo, mas suspeito que haja um segundo motivo, mais importante."

# game/scripts/c25/c25.rpy:72
translate brazilian c25s001_Eva_1416c684:

    # eva "No más importante, pero casi. Si el piloto es torpe, no quiero que tire a mi niña al suelo."
    eva "Não é o mais importante, mas quase. Se o piloto for desastrado, não quero que ele jogue minha filha no chão."

# game/scripts/c25/c25.rpy:73
translate brazilian c25s001_Eva_d816f5b6:

    # mc "*Risa* ¿Tu niña?"
    mc "*Risos* Sua filhinha?"

# game/scripts/c25/c25.rpy:75
translate brazilian c25s001_Eva_24fa4d16:

    # eva "*Risa* Mi niña, mi novia... llámala como quieras. Adoro esa moto."
    eva "*Risos* Minha garota, minha namorada... chame-a do que quiser. Eu adoro aquela moto."

# game/scripts/c25/c25.rpy:76
translate brazilian c25s001_Eva_893c668a:

    # eva "Y, por cierto, felicidades. No has llorado viniendo hacia aquí."
    eva "Aliás, parabéns. Você não chorou no caminho até aqui."

# game/scripts/c25/c25.rpy:77
translate brazilian c25s001_Eva_e7f0c5b9:

    # mc "*Risa* Ha sido intenso, pero menos de lo que esperaba."
    mc "*Risos* Foi intenso, mas menos do que eu esperava."

# game/scripts/c25/c25.rpy:79
translate brazilian c25s001_Eva_ccf45a17:

    # eva "*Risa* Entonces la próxima vez no me contendré."
    eva "*Risos* Então da próxima vez não vou me conter."

# game/scripts/c25/c25.rpy:80
translate brazilian c25s001_Eva_b04f7cd8:

    # mc "*Risa* Te puedes seguir conteniendo. Por mí no lo hagas."
    mc "*Risos* Pode continuar segurando. Não faça isso por mim."

# game/scripts/c25/c25.rpy:82
translate brazilian c25s001_Eva_fcbcbddf:

    # eva "Bueno, aquí estamos. Disculpa el desorden, les dije que barrieran los cartuchos vacíos antes de cerrar ayer."
    eva "Bem, aqui estamos. Desculpe pela bagunça, eu pedi para você varrer os cartuchos vazios antes de fechar ontem."

# game/scripts/c25/c25.rpy:83
translate brazilian c25s001_Eva_ec5caaa9:

    # eva "He dejado esas cajas de munición ahí. Espero que no la gastes toda."
    eva "Deixei aquelas caixas de munição lá. Espero que você não use tudo."

# game/scripts/c25/c25.rpy:84
translate brazilian c25s001_Eva_38ab1845:

    # mc "¿Tanto voy a tener que disparar?"
    mc "Será que vou mesmo ter que fotografar tanto assim?"

# game/scripts/c25/c25.rpy:86
translate brazilian c25s001_Eva_8dbeaacc:

    # eva "Hoy vamos a entrenar el Taladro de Mozambique. Lo tienes que hacer seis veces."
    eva "Hoje vamos treinar o exercício Moçambique. Vocês têm que fazê-lo seis vezes."

# game/scripts/c25/c25.rpy:87
translate brazilian c25s001_Eva_d4288bdd:

    # mc "¿El Taladro de Mozambique?"
    mc "O exercício de Moçambique?"

# game/scripts/c25/c25.rpy:89
translate brazilian c25s001_Eva_2728605b:

    # eva "Dos tiros en el pecho y uno en la cabeza. Rápidamente."
    eva "Dois tiros no peito e um na cabeça. Rápido."

# game/scripts/c25/c25.rpy:90
translate brazilian c25s001_Eva_5c628167:

    # eva "¿Has visto las pelis de Jack Wick? Lo suele hacer bastante. Es una técnica muy buena para acabar con gente con chalecos antibalas."
    eva "Você já viu os filmes do Jack Wick? Ele faz isso com bastante frequência. É uma técnica muito boa para neutralizar pessoas que usam colete à prova de balas."

# game/scripts/c25/c25.rpy:91
translate brazilian c25s001_Eva_2ff1ce86:

    # mc "Sí, las he visto. No parece demasiado complicado... ¿verdad?"
    mc "Sim, eu já vi. Não parece muito complicado... parece?"

# game/scripts/c25/c25.rpy:93
translate brazilian c25s001_Eva_0603a7c7:

    # eva "Hacerlo bien es más complicado de lo que parece. Porque además iré alejando el objetivo un metro cada vez que lo consigas."
    eva "Fazer isso direito é mais complicado do que parece. Porque eu também vou mover o alvo um metro mais para longe a cada vez que você acertar."

# game/scripts/c25/c25.rpy:94
translate brazilian c25s001_Eva_3b89bbf4:

    # mc "OK. ¿Empezamos?"
    mc "Certo. Podemos começar?"

# game/scripts/c25/c25.rpy:96
translate brazilian c25s001_Eva_ad621afe:

    # eva "OK. Te he traído la misma pistola con la que practicaste en el bosque."
    eva "Certo. Trouxe a mesma arma com a qual você treinou na floresta."

# game/scripts/c25/c25.rpy:97
translate brazilian c25s001_Eva_85306643:

    # eva "Quería traerte una Desert Stork, pero [ama] ha dicho que sería mucho para ti. Ponte las gafas y los auriculares de protección."
    eva "Eu queria te dar um Desert Stork, mas [ama] disse que seria demais para você. Coloque seus óculos de proteção e protetores auriculares."

# game/scripts/c25/c25.rpy:98
translate brazilian c25s001_Eva_3ea6388d:

    # mc "Sabes que no entiendo de armas y no sé lo que es una Desert Stork, ¿verdad?"
    mc "Você sabe que eu não entendo nada de armas e não sei o que é uma cegonha do deserto, né?"

# game/scripts/c25/c25.rpy:99
translate brazilian c25s001_Eva_439c0f24:

    # eva "Lo sé. Recuerda que el entrenamiento es para disparar con una sola mano. Si lo consigues hacer bien, el día que tengas que disparar con dos manos será más fácil."
    eva "Eu sei. Lembre-se, o treinamento é para atirar com uma mão. Se você conseguir fazer bem, o dia em que tiver que atirar com as duas mãos será mais fácil."

# game/scripts/c25/c25.rpy:103
translate brazilian c25s001_Eva_d4bea65b:

    # "Practicas durante bastante tiempo. Al principio, cuando los objetivos están cerca, es relativamente fácil."
    "Você pratica por um bom tempo. No início, quando os objetivos estão próximos, é relativamente fácil."

# game/scripts/c25/c25.rpy:106
translate brazilian c25s001_Eva_aa9f35ca:

    # "Tal como [eva] los va alejando, se hace mucho más difícil. No sólo hacer el Taladro de Mozambique, sino acertar al objetivo."
    "À medida que [eva] os afasta, torna-se muito mais difícil. Não só executar o exercício Moçambique, mas também acertar o alvo."

# game/scripts/c25/c25.rpy:107
translate brazilian c25s001_Eva_12edc81e:

    # "Tienes que aguantar algunas miradas de desaprobación de [eva]."
    "Você terá que aguentar alguns olhares de desaprovação de [eva]."

# game/scripts/c25/c25.rpy:108
translate brazilian c25s001_Eva_cb28b39c:

    # "Finalizas el entrenamiento habiendo conseguido el objetivo cuando la diana estaba a siete metros."
    "Você conclui o treinamento tendo atingido o objetivo quando o alvo estava a sete metros de distância."

# game/scripts/c25/c25.rpy:110
translate brazilian c25s001_Eva_abefe31e:

    # "Más allá has acertado algunos disparos, pero no suficiente para los estándares de [eva]."
    "Além disso, você acertou alguns tiros, mas não o suficiente para os padrões de [eva]."

# game/scripts/c25/c25.rpy:111
translate brazilian c25s001_Eva_2fc54b12:

    # eva "No ha estado mal, pero tienes que mejorar. Le diré a [ama] que te entrene en Aruba. Pon el seguro del arma y déjala en la estantería."
    eva "Não foi ruim, mas você precisa melhorar. Vou pedir para o [ama] te treinar em Aruba. Coloque a arma na trava de segurança e deixe-a na prateleira."

# game/scripts/c25/c25.rpy:112
translate brazilian c25s001_Eva_17bfd97c:

    # mc "No sé si alguna vez me voy a enfrentar con alguien a tiros a esa distancia... o a alguna en realidad."
    mc "Não sei se algum dia enfrentarei alguém atirando a essa distância... ou a qualquer distância, aliás."

# game/scripts/c25/c25.rpy:114
translate brazilian c25s001_Eva_a7c14f44:

    # eva "Es mejor que estés preparado por si lo tienes que hacer. Pero no hay tiempo para más."
    eva "É melhor estar preparado caso seja necessário. Mas não há tempo para mais nada."

# game/scripts/c25/c25.rpy:115
translate brazilian c25s001_Eva_959d43ad:

    # eva "Estoy escuchando la furgoneta de [ama] en el aparcamiento."
    eva "Estou ouvindo a van do [ama] no estacionamento."

# game/scripts/c25/c25.rpy:116
translate brazilian c25s001_Eva_1f4f2240:

    # mc "¿Hemos acabado entonces?"
    mc "Então, terminamos por aqui?"

# game/scripts/c25/c25.rpy:118
translate brazilian c25s001_Eva_97851d56:

    # eva "Sí. No creo que tengamos muchas más oportunidades de entrenar antes de que os vayáis a Aruba."
    eva "Sim. Acho que não teremos muitas outras oportunidades de treinar antes de você ir para Aruba."

# game/scripts/c25/c25.rpy:119
translate brazilian c25s001_Eva_6ea1fe2d:

    # eva "Yo sí que te entrenaré allí. Me dará lo mismo que estés ocupado."
    eva "Eu te treinarei lá. Não me importo se você estiver ocupado."

# game/scripts/c25/c25.rpy:120
translate brazilian c25s001_Eva_a8f5e398:

    # mc "[eva]..."
    mc "[eva]..."

# game/scripts/c25/c25.rpy:122
translate brazilian c25s001_Eva_c0579bb2:

    # eva "Dime."
    eva "Diga-me."

# game/scripts/c25/c25.rpy:123
translate brazilian c25s001_Eva_7ed3cce9:

    # mc "Gracias. Por el entrenamiento y por todo."
    mc "Obrigado. Pelo treinamento e por tudo."

# game/scripts/c25/c25.rpy:125
translate brazilian c25s001_Eva_0717bc69:

    # eva "No hay de qué. Aunque me hayas hecho perder una apuesta."
    eva "De nada. Mesmo que você tenha me feito perder uma aposta."

# game/scripts/c25/c25.rpy:126
translate brazilian c25s001_Eva_d9cb9e70:

    # mc "¿Qué apuesta?"
    mc "Qual é a aposta?"

# game/scripts/c25/c25.rpy:127
translate brazilian c25s001_Eva_5ca0b702:

    # eva "Le había dicho a [ama] que no lo conseguirías pasados los seis metros."
    eva "Eu tinha dito [ama] que você não conseguiria passar dos seis metros."

# game/scripts/c25/c25.rpy:128
translate brazilian c25s001_Eva_69166cb4:

    # eva "Estoy orgullosa de ti."
    eva "Tenho orgulho de você."

# game/scripts/c25/c25.rpy:130
translate brazilian c25s001_Eva_987fe4d4:

    # eva "Espera a que [ama] te traiga el traje. Puedes ducharte si quieres. Hay una ducha en la oficina."
    eva "Aguarde que [ama] traga o terno. Você pode tomar banho se quiser. Há um chuveiro no escritório."

# game/scripts/c25/c25.rpy:131
translate brazilian c25s001_Eva_67b2f681:

    # eva "Voy al lavabo mientras tanto. Deja el arma ahí y lo recogeré todo yo cuando os vayáis."
    eva "Vou ao banheiro enquanto isso. Deixe a arma aí e eu limpo tudo quando você sair."

# game/scripts/c25/c25.rpy:133
translate brazilian c25s001_Eva_73566961:

    # "Y tras eso, tu entrenadora personal desaparece."
    "E depois disso, seu personal trainer desaparece."

# game/scripts/c25/c25.rpy:137
translate brazilian c25s001_Eva_088cc437:

    # eva "Bueno, puedes ir practicando mientras me cambio de ropa."
    eva "Ok, você pode praticar enquanto eu troco de roupa."

# game/scripts/c25/c25.rpy:138
translate brazilian c25s001_Eva_004b3196:

    # mc "¿Te vas a cambiar?"
    mc "Você vai mudar?"

# game/scripts/c25/c25.rpy:140
translate brazilian c25s001_Eva_225a7bc6:

    # eva "Sí. Para hacer el entrenamiento más interesante, vamos a jugar a un juego."
    eva "Sim. Para tornar o treinamento mais interessante, vamos jogar um jogo."

# game/scripts/c25/c25.rpy:141
translate brazilian c25s001_Eva_fcda545b:

    # mc "¿Qué juego?"
    mc "Que jogo?"

# game/scripts/c25/c25.rpy:142
translate brazilian c25s001_Eva_b08541e5:

    # eva "Ya lo verás. No seas impaciente."
    eva "Você vai ver. Não tenha pressa."

# game/scripts/c25/c25.rpy:144
translate brazilian c25s001_Eva_d50e5cd9:

    # "Tras eso, desaparece."
    "Depois disso, ele desaparece."

# game/scripts/c25/c25.rpy:145
translate brazilian c25s001_Eva_68c41f89:

    # "Aprovechas los minutos en los que [eva] no está para recordar el tacto del arma. No quieres hacer ningún disparo antes de que ella vuelva."
    "Você usa os minutos em que [eva] está ausente para se lembrar da sensação da arma. Você não quer disparar um tiro antes que ela retorne."

# game/scripts/c25/c25.rpy:148
translate brazilian c25s001_Eva_bb4edac2:

    # eva "Ya estoy aquí de nuevo. Podemos empezar."
    eva "Estou de volta. Podemos começar."

# game/scripts/c25/c25.rpy:150
translate brazilian c25s001_Eva_7077719e:

    # mc "¿Y ese cambio de ropa? A mí me parecía que estabas bien vestida para disparar."
    mc "E essa troca de roupa? Achei que você estivesse vestida adequadamente para a sessão de fotos."

# game/scripts/c25/c25.rpy:152
translate brazilian c25s001_Eva_1c9c6472:

    # eva "*Risa* El que disparará eres tú, no yo. Pero voy a darte un incentivo."
    eva "*Risos* Você é quem vai atirar, não eu. Mas vou te dar um incentivo."

# game/scripts/c25/c25.rpy:153
translate brazilian c25s001_Eva_b474b579:

    # eva "Jugaremos a strip shooting. Cada vez que lo consigas, me quitaré una prenda de ropa. Con el otro traje duraría muy poco."
    eva "Vamos brincar de strip-tease. Cada vez que você acertar, eu tiro uma peça de roupa. Eu não duraria muito tempo com a outra roupa."

# game/scripts/c25/c25.rpy:154
translate brazilian c25s001_Eva_eba7f701:

    # mc "*Risa* Me parece muy interesante..."
    mc "*Risos* Acho isso muito interessante..."

# game/scripts/c25/c25.rpy:156
translate brazilian c25s001_Eva_0834f8ac:

    # eva "Si lo consigues a la primera en cada distancia, además te llevarás un beso."
    eva "Se você acertar na primeira tentativa em cada distância, também ganhará um beijo."

# game/scripts/c25/c25.rpy:157
translate brazilian c25s001_Eva_2b0b9525:

    # mc "*Risa* Eso me parece más interesante todavía. ¿Empezamos?"
    mc "*Risos* Isso me parece ainda mais interessante. Vamos começar?"

# game/scripts/c25/c25.rpy:160
translate brazilian c25s001_Eva_4e261d7f:

    # eva "*Risita* Y si aciertas en el centro, ya sea en el pecho o en la cabeza, a lo mejor te hago un baile..."
    eva "*Risos* E se você acertar o centro, seja no peito ou na cabeça, talvez eu dance para você..."

# game/scripts/c25/c25.rpy:161
translate brazilian c25s001_Eva_c1213e80:

    # mc "*Risa* Sin presión, ¿verdad?"
    mc "*Risos* Sem pressão, né?"

# game/scripts/c25/c25.rpy:162
translate brazilian c25s001_Eva_3619c14a:

    # eva "*Risa* Si alguna vez estás en un tiroteo de verdad, vas a tener mucha presión. *Risa* Te tengo que entrenar para que aciertes bajo presión o no serviría de nada."
    eva "*Risos* Se você algum dia se encontrar em um tiroteio de verdade, vai estar sob muita pressão. *Risos* Vou ter que te treinar para acertar o alvo sob pressão, senão vai ser inútil."

# game/scripts/c25/c25.rpy:165
translate brazilian c25s001_Eva_c9cd1628:

    # "La primera ronda, a cinco metros de distancia, es fácil. Lo consigues al segundo intento."
    "A primeira rodada, a uma distância de cinco metros, é fácil. Você consegue na segunda tentativa."

# game/scripts/c25/c25.rpy:166
translate brazilian c25s001_Eva_cc223ab3:

    # "Pierdes el beso, pero te has ganado el baile. Has acertado en el centro en el cuarto y el sexto disparo."
    "Você perde o beijo, mas ganha a dança. Você acerta o alvo no quarto e no sexto tiros."

# game/scripts/c25/c25.rpy:167
translate brazilian c25s001_Eva_9e1bd096:

    # "Pones el seguro del arma antes de dejarla en la estantería, tal como [eva] te ha indicado."
    "Você aciona a trava de segurança da arma antes de colocá-la na prateleira, exatamente como [eva] instruiu você."

# game/scripts/c25/c25.rpy:169
translate brazilian c25s001_Eva_6f7890a8:

    # eva "Bien hecho. Te has ganado que me quite una prenda."
    eva "Muito bem. Você me fez tirar uma peça de roupa."

# game/scripts/c25/c25.rpy:170
translate brazilian c25s001_Eva_2a326ff4:

    # mc "¡Las zapatillas no! *Risa* ¡Es injusto!"
    mc "Não os tênis! *Risos* Isso é injusto!"

# game/scripts/c25/c25.rpy:172
translate brazilian c25s001_Eva_6941c6f9:

    # eva "*Risa* Si no las contamos como prenda, creo que el entrenamiento duraría muy poco. Y la diana estaba muy cerca. Creo que es premio suficiente."
    eva "*Risos* Se não considerarmos isso como uma desistência, acho que o treinamento seria bem curto. E o alvo estava bem próximo. Acho que já é recompensa suficiente."

# game/scripts/c25/c25.rpy:173
translate brazilian c25s001_Eva_da8c5d3e:

    # mc "Pero el baile sí que lo voy a tener, ¿verdad?"
    mc "Mas eu ainda vou ter o baile, né?"

# game/scripts/c25/c25.rpy:177
translate brazilian c25s001_Eva_47c2ab4e:

    # eva "Por supuesto. Has tenido dos aciertos."
    eva "Claro. Você acertou duas."

# game/scripts/c25/c25.rpy:178
translate brazilian c25s001_Eva_84972d6f:

    # mc "Mi imaginación me está poniendo más presión aún. Te estoy imaginando haciendo eso sin ropa."
    mc "Minha imaginação está me pressionando ainda mais. Estou imaginando você fazendo isso sem roupa."

# game/scripts/c25/c25.rpy:179
translate brazilian c25s001_Eva_0ffb2b4d:

    # eva "*Risita* Tan solo tienes que seguir acertando en el centro... "
    eva "*Risos* É só continuar acertando o centro..."

# game/scripts/c25/c25.rpy:182
translate brazilian c25s001_Eva_09a9fdad:

    # "[eva] aleja la diana a seis metros y vuelves a disparar."
    "[eva] Mova o alvo seis metros para longe e atire novamente."

# game/scripts/c25/c25.rpy:183
translate brazilian c25s001_Eva_22ec0ebb:

    # "Lo consigues a la primera y un acierto en el centro de la cabeza."
    "Você acerta de primeira, com um chute perfeito bem no centro da cabeça."

# game/scripts/c25/c25.rpy:185
translate brazilian c25s001_Eva_7678b869:

    # eva "¡Bien hecho!"
    eva "Bom trabalho!"

# game/scripts/c25/c25.rpy:186
translate brazilian c25s001_Eva_6cdf7c03:

    # mc "¡Quiero mi beso!"
    mc "Quero meu beijo!"

# game/scripts/c25/c25.rpy:187
translate brazilian c25s001_Eva_9f5e4c6d:

    # eva "*Risa* Te lo has ganado esta vez."
    eva "*Risos* Dessa vez você mereceu."

# game/scripts/c25/c25.rpy:189
translate brazilian c25s001_Eva_d9ab773d:

    # "[eva] se acerca a darte tu recompensa. Como ha dicho, es un gran incentivo."
    "[eva] virá lhe entregar sua recompensa. Como ele disse, é um grande incentivo."

# game/scripts/c25/c25.rpy:191
translate brazilian c25s001_Eva_60c22897:

    # mc "Y ahora quiero mi prenda y mi baile."
    mc "E agora eu quero minha roupa e minha dança."

# game/scripts/c25/c25.rpy:192
translate brazilian c25s001_Eva_8e9c396a:

    # eva "*Risa* Sobre el baile te he dicho a lo mejor..."
    eva "*Risos* Sobre a dança, talvez eu já tenha te contado..."

# game/scripts/c25/c25.rpy:193
translate brazilian c25s001_Eva_44185f3e:

    # mc "Pero estás deseando hacerlo, ¿verdad?"
    mc "Mas você está ansioso para fazer isso, não está?"

# game/scripts/c25/c25.rpy:194
translate brazilian c25s001_Eva_54269a30:

    # eva "*Risa* Creo que me conoces demasiado..."
    eva "*Risos* Acho que você me conhece muito bem..."

# game/scripts/c25/c25.rpy:196
translate brazilian c25s001_Eva_e56991c7:

    # eva "Pero vamos a empezar pagando con esta camiseta..."
    eva "Mas vamos começar pagando com esta camiseta..."

# game/scripts/c25/c25.rpy:197
translate brazilian c25s001_Eva_c6175cd8:

    # mc "Me gusta la idea..."
    mc "Gostei da ideia..."

# game/scripts/c25/c25.rpy:202
translate brazilian c25s001_Eva_f4d05ec4:

    # eva "*Risa* ¿Contento con el baile?"
    eva "*Risos* Gostou da dança?"

# game/scripts/c25/c25.rpy:203
translate brazilian c25s001_Eva_c6402620:

    # "Ponerse un sujetador con volantes y hacer eso casi se podría considerar trampa. Hace parecer que sus tetas se mueven más de lo que lo hacen en realidad."
    "Usar um sutiã cheio de babados e fazer isso quase pode ser considerado trapaça. Dá a impressão de que os seios dela estão se movendo mais do que realmente estão."

# game/scripts/c25/c25.rpy:204
translate brazilian c25s001_Eva_f0f2048b:

    # mc "*Risa* Sí, aunque eso añade más presión todavía a los siete metros."
    mc "*Risos* Sim, embora isso aumente ainda mais a pressão sobre os sete metros."

# game/scripts/c25/c25.rpy:205
translate brazilian c25s001_Eva_0630471f:

    # eva "*Risa* Eso sólo quiere decir que el entrenamiento será mejor."
    eva "*Risos* Isso só significa que o treinamento será melhor."

# game/scripts/c25/c25.rpy:206
translate brazilian c25s001_Eva_f4566a28:

    # mc "*Risa* Dudo que pueda ser mejor que esto."
    mc "*Risos* Duvido que possa ficar melhor do que isso."

# game/scripts/c25/c25.rpy:209
translate brazilian c25s001_Eva_944858b7:

    # "[eva] aleja la diana a siete metros y vuelves a disparar."
    "[eva] Mova o alvo sete metros para longe e atire novamente."

# game/scripts/c25/c25.rpy:210
translate brazilian c25s001_Eva_c12cf223:

    # "Consigues hacer el Taladro de Mozambique al tercer intento y un acierto en el centro del pecho."
    "Você consegue executar o Golpe de Moçambique na terceira tentativa e acerta o alvo no centro do peito."

# game/scripts/c25/c25.rpy:211
translate brazilian c25s001_Eva_db0b090c:

    # "No va a haber beso esta vez."
    "Desta vez não haverá beijo."

# game/scripts/c25/c25.rpy:213
translate brazilian c25s001_Eva_f500f5e5:

    # mc "Prenda y baile..."
    mc "Vestuário e dança..."

# game/scripts/c25/c25.rpy:214
translate brazilian c25s001_Eva_28cf3fbf:

    # eva "No hay beso esta vez."
    eva "Desta vez não haverá beijo."

# game/scripts/c25/c25.rpy:215
translate brazilian c25s001_Eva_9d40879e:

    # mc "Lo sé..."
    mc "Eu sei..."

# game/scripts/c25/c25.rpy:217
translate brazilian c25s001_Eva_62e758fe:

    # eva "Suenas decepcionado."
    eva "Você parece desapontado(a)."

# game/scripts/c25/c25.rpy:218
translate brazilian c25s001_Eva_15a6150a:

    # mc "Me gusta besarte..."
    mc "Eu gosto de te beijar..."

# game/scripts/c25/c25.rpy:220
translate brazilian c25s001_Eva_4f0f7e3b:

    # eva "¿Te alegraría un poco si esta vez te dejo que seas tú quien me quite la prenda? Van a ser los shorts..."
    eva "Você ficaria um pouco mais feliz se desta vez eu deixasse você tirar minhas roupas? Seriam meus shorts..."

# game/scripts/c25/c25.rpy:221
translate brazilian c25s001_Eva_29709d1e:

    # mc "*Risa* Sabes cómo alegrar a un hombre."
    mc "*Risos* Você sabe como animar um homem."

# game/scripts/c25/c25.rpy:223
translate brazilian c25s001_Eva_89a7865b:

    # eva "Sólo hay un hombre al que quiera alegrar."
    eva "Só existe um homem que eu quero fazer feliz."

# game/scripts/c25/c25.rpy:224
translate brazilian c25s001_Eva_b1381979:

    # mc "*Risa* No me refería a eso, pero me alegra ser ese hombre."
    mc "*Risos* Não era minha intenção, mas fico feliz por ser esse homem."

# game/scripts/c25/c25.rpy:226
translate brazilian c25s001_Eva_632ca161:

    # eva "*Risa* ¿De dónde has sacado que me refiera a ti? Me refería a... Jamaal..."
    eva "*Risos* De onde você tirou a ideia de que eu estava me referindo a você? Eu quis dizer... Jamaal..."

# game/scripts/c25/c25.rpy:227
translate brazilian c25s001_Eva_588d1652:

    # mc "*Risa* Vale, me lo he ganado."
    mc "*Risos* Ok, eu mereci."

# game/scripts/c25/c25.rpy:228
translate brazilian c25s001_Eva_031aaf89:

    # eva "Y ahora vuelve a tu posición, déjame espacio para mi baile."
    eva "Agora, volte à sua posição e me dê espaço para dançar."

# game/scripts/c25/c25.rpy:232
translate brazilian c25s001_Eva_3e758b29:

    # "La preciosa mercenaria empieza a mover su culo sensualmente. Sigues pensando lo mismo sobre los volantes que hace unos minutos."
    "A mercenária deslumbrante começa a mexer o quadril sensualmente. Você ainda está pensando a mesma coisa sobre babados que pensava há alguns minutos."

# game/scripts/c25/c25.rpy:233
translate brazilian c25s001_Eva_229fde86:

    # eva "¿Te gusta lo que ves?"
    eva "Você gosta do que vê?"

# game/scripts/c25/c25.rpy:234
translate brazilian c25s001_Eva_3c74e715:

    # mc "Mucho."
    mc "Bastante."

# game/scripts/c25/c25.rpy:235
translate brazilian c25s001_Eva_f6089df7:

    # eva "Si sigues acertando me lo tendré que quitar..."
    eva "Se você continuar acertando, vou ter que tirar..."

# game/scripts/c25/c25.rpy:236
translate brazilian c25s001_Eva_2141d235:

    # mc "*Risa* Ahora tengo la duda de si seguir disparando o seguir mirando."
    mc "*Risos* Agora estou em dúvida se continuo filmando ou se continuo assistindo."

# game/scripts/c25/c25.rpy:239
translate brazilian c25s001_Eva_7dfe4a08:

    # eva "Seguir disparando. Esto sigue siendo un entrenamiento."
    eva "Continue filmando. Isso ainda é treinamento."

# game/scripts/c25/c25.rpy:240
translate brazilian c25s001_Eva_a01617fb:

    # mc "¡Ohhh! ¿Si pongo ojos de cachorrito me dejarás mirar un rato más?"
    mc "Ohhh! Se eu fizer cara de cachorrinho pidão, você me deixa olhar mais um pouquinho?"

# game/scripts/c25/c25.rpy:242
translate brazilian c25s001_Eva_39cbe7ab:

    # eva "No."
    eva "Não."

# game/scripts/c25/c25.rpy:243
translate brazilian c25s001_Eva_af327336:

    # mc "Eres una maestra demasiado estricta. *Risa*"
    mc "Você é um professor muito rigoroso. *Risos*"

# game/scripts/c25/c25.rpy:244
translate brazilian c25s001_Eva_ae619087:

    # eva "Si perdemos tiempo en esto, no te va a dar tiempo a acabar. Ahora vienen los ocho metros."
    eva "Se perdermos tempo com isso, você não terá tempo de terminar. Agora vem a prova dos oito metros."

# game/scripts/c25/c25.rpy:245
translate brazilian c25s001_Eva_da042db1:

    # "Cambias la distancia a ocho metros sin esperar que lo haga [eva]."
    "Você altera a distância para oito metros sem esperar que isso aconteça."

# game/scripts/c25/c25.rpy:248
translate brazilian c25s001_Eva_ade60c53:

    # "La distancia parece que es demasiado para tus habilidades. En cada ronda de tres disparos aciertas uno o dos, pero nunca los tres."
    "A distância parece ser excessiva para a sua habilidade. Em cada rodada de três tiros, você acerta um ou dois, mas nunca os três."

# game/scripts/c25/c25.rpy:250
translate brazilian c25s001_Eva_3fa92260:

    # eva "¿Está muy lejos para ti? ¿O no quieres seguir con el striptease?"
    eva "É longe demais para você? Ou você não quer continuar com o striptease?"

# game/scripts/c25/c25.rpy:251
translate brazilian c25s001_Eva_9b07e5a3:

    # mc "*Risa* Creo que es la primera opción. Ocho metros es demasiado, aunque he acertado al menos un disparo en cada ronda."
    mc "*Risos* Acho que é a primeira opção. Oito metros é demais, embora eu tenha acertado pelo menos um tiro em cada rodada."

# game/scripts/c25/c25.rpy:253
translate brazilian c25s001_Eva_3275bdde:

    # eva "¿Qué tal si te doy un incentivo, aunque no te lo hayas ganado?"
    eva "E se eu lhe desse um incentivo, mesmo que você não o tenha merecido?"

# game/scripts/c25/c25.rpy:254
translate brazilian c25s001_Eva_8dc37940:

    # mc "¿Otra prenda?"
    mc "Outra peça de roupa?"

# game/scripts/c25/c25.rpy:255
translate brazilian c25s001_Eva_39cbe7ab_1:

    # eva "No."
    eva "Não."

# game/scripts/c25/c25.rpy:257
translate brazilian c25s001_Eva_fe6b4312:

    # eva "Me refiero a esto."
    eva "Estou me referindo a isto."

# game/scripts/c25/c25.rpy:262
translate brazilian c25s001_Eva_694afb1b:

    # "[eva] se lanza a tus labios con una ansiedad que no ha demostrado en ninguna de las veces que os habéis besado anteriormente."
    "[eva] se atira em seus lábios com uma avidez que não demonstrou em nenhuma das vezes em que vocês se beijaram antes."

# game/scripts/c25/c25.rpy:263
translate brazilian c25s001_Eva_74fb1f5c:

    # "Parece que el juego de bailes y striptease ha hecho que tenga ganas de más. Igual que tú."
    "Parece que o jogo de dança e striptease me deixou querendo mais. Assim como você."

# game/scripts/c25/c25.rpy:264
translate brazilian c25s001_Eva_269613c3:

    # "Sus labios aprisionan los tuyos en una batalla que los dos ganáis. Su lengua lucha con la tuya. Vuestros alientos se entremezclan."
    "Os lábios dele capturam os seus numa batalha que ambos vencem. A língua dele luta com a sua. As suas respirações se misturam."

# game/scripts/c25/c25.rpy:266
translate brazilian c25s001_Eva_afc6301a:

    # "Sin dejar de besarte, la preciosa pelirroja alarga la mano para coger la pistola."
    "Sem parar de te beijar, a linda ruiva estende a mão para pegar a arma."

# game/scripts/c25/c25.rpy:269
translate brazilian c25s001_Eva_ee71ee81:

    # "*Bang*"
    "*Bang*"

# game/scripts/c25/c25.rpy:272
translate brazilian c25s001_Eva_ee71ee81_1:

    # "*Bang*"
    "*Bang*"

# game/scripts/c25/c25.rpy:275
translate brazilian c25s001_Eva_ee71ee81_2:

    # "*Bang*"
    "*Bang*"

# game/scripts/c25/c25.rpy:276
translate brazilian c25s001_Eva_1449d702:

    # "Dispara tres veces en rápida sucesión sin ni siquiera mirar a la diana."
    "Ele dispara três vezes em rápida sucessão, sem sequer olhar para o alvo."

# game/scripts/c25/c25.rpy:277
translate brazilian c25s001_Eva_10500c1f:

    # "No necesitas mirar para saber que ha acertado todos los disparos. Ni siquiera te importa si lo ha hecho."
    "Você não precisa olhar para saber que ele acertou todos os arremessos. Você nem se importa se ele acertou ou não."

# game/scripts/c25/c25.rpy:279
translate brazilian c25s001_Eva_f3130e66:

    # "La hermosa pelirroja interrumpe el beso y te mira con una pícara sonrisa."
    "A bela ruiva interrompe o beijo e olha para você com um sorriso travesso."

# game/scripts/c25/c25.rpy:280
translate brazilian c25s001_Eva_82e99a82:

    # eva "Creo que me he ganado una prenda."
    eva "Acho que mereci uma peça de roupa."

# game/scripts/c25/c25.rpy:281
translate brazilian c25s001_Eva_fc77edc8:

    # mc "Creía que era yo el que se las había ganado."
    mc "Eu pensava que era eu quem as tinha merecido."

# game/scripts/c25/c25.rpy:282
translate brazilian c25s001_Eva_c83afe6f:

    # eva "*Risa* He disparado yo."
    eva "*Risos* Eu filmei."

# game/scripts/c25/c25.rpy:283
translate brazilian c25s001_Eva_ccfc52f7:

    # mc "*Risa* Demuéstralo."
    mc "*Risos* Prove isso."

# game/scripts/c25/c25.rpy:285
translate brazilian c25s001_Eva_adc187a6:

    # eva "*Risa* Te propongo un trato. Todas tus prendas por todas las mías."
    eva "*Risos* Proponho um acordo. Todas as suas roupas por todas as minhas."

# game/scripts/c25/c25.rpy:286
translate brazilian c25s001_Eva_8d117477:

    # mc "*Risa* Me parece un trato justo. Aunque eso acabará los incentivos para el entrenamiento."
    mc "*Risos* Parece um bom negócio. Embora isso acabe com os incentivos para o treinamento."

# game/scripts/c25/c25.rpy:288
translate brazilian c25s001_Eva_687e0cce:

    # eva "*Risa* Que le jodan al entrenamiento. La ropa me quema sobre la piel. Y seguro que empezabas a pagar prenda con las putas botas."
    eva "*Risos* Que se dane o treino. As roupas queimam minha pele. E aposto que você já estava começando a pagar o preço com essas botas malditas."

# game/scripts/c25/c25.rpy:289
translate brazilian c25s001_Eva_bdaafdef:

    # mc "*Risa* ¡Ese lenguaje! ¡No estamos en un cuartel!"
    mc "*Risos* Que linguagem! Não estamos num quartel!"

# game/scripts/c25/c25.rpy:291
translate brazilian c25s001_Eva_0d2e69b7:

    # eva "*Risa* Tienes suerte de que no estemos en un cuartel o ahora mismo estarías haciendo flexiones."
    eva "*Risos* Você tem sorte de não estarmos em um quartel, senão você estaria fazendo flexões agora mesmo."

# game/scripts/c25/c25.rpy:292
translate brazilian c25s001_Eva_0d340a6d:

    # eva "Desnúdate. ¡Ya!"
    eva "Tire a roupa. Agora!"

# game/scripts/c25/c25.rpy:294
translate brazilian c25s001_Eva_08d5442d:

    # eva "Y no mires."
    eva "E não olhe."

# game/scripts/c25/c25.rpy:296
translate brazilian c25s001_Eva_6db9118f:

    # "Te sorprende que ahora se vuelva tímida después de como se ha estado comportando, pero puedes esperar un poco para verla desnuda."
    "Você está surpreso que ela tenha ficado repentinamente tímida depois de como vinha se comportando, mas pode esperar um pouco para vê-la nua."

# game/scripts/c25/c25.rpy:297
translate brazilian c25s001_Eva_3cbfd07a:

    # "Conociendo el fuego que la recorre, esperabas que os estuvierais arrancando la ropa mutuamente."
    "Conhecendo o fogo que arde dentro dela, você esperava que vocês acabassem arrancando as roupas um do outro."

# game/scripts/c25/c25.rpy:298
translate brazilian c25s001_Eva_b9483fd3:

    # "Acabas de desnudarte y te quedas mirando en dirección opuesta a ella."
    "Você acabou de se despir e está olhando na direção oposta à dela."

# game/scripts/c25/c25.rpy:299
translate brazilian c25s001_Eva_6cd40a10:

    # "Unos eternos segundos."
    "Alguns segundos eternos."

# game/scripts/c25/c25.rpy:300
translate brazilian c25s001_Eva_73abbc1f:

    # eva "Ya puedes girarte."
    eva "Você pode se virar agora."

# game/scripts/c25/c25.rpy:306
translate brazilian c25s001_Eva_e60234c7:

    # mc "¡Wow!"
    mc "Uau!"

# game/scripts/c25/c25.rpy:308
translate brazilian c25s001_Eva_229fde86_1:

    # eva "¿Te gusta lo que ves?"
