# game/scripts/c25/c25.rpy:3859
translate brazilian c25s006_AmaCuddle_26549643:

    # lis "No mataría un animal si no fuera para defender a un ser humano. *Risa* Soy ecologista, pero no idiota."
    lis "Eu não mataria um animal a menos que fosse para defender um ser humano. *Risos* Sou ambientalista, mas não sou idiota."

# game/scripts/c25/c25.rpy:3860
translate brazilian c25s006_AmaCuddle_66f71547:

    # lis "Y ahora nos vamos antes de que a [eri] y a [eil] se les haga tarde para ir a trabajar."
    lis "E agora vamos embora antes que [eri] e [eil] se atrasem para o trabalho."

# game/scripts/c25/c25.rpy:3862
translate brazilian c25s006_AmaCuddle_c9a7983f:

    # "Después de que todas se pongan de nuevo sus zapatos..."
    "Depois que todos calçarem os sapatos novamente..."

# game/scripts/c25/c25.rpy:3863
translate brazilian c25s006_AmaCuddle_d6430870:

    # todas "Hasta luego, [mc]."
    todas "Até logo, [mc]."

# game/scripts/c25/c25.rpy:3864
translate brazilian c25s006_AmaCuddle_29132585:

    # mc "Hasta luego, chicas. Pasadlo bien."
    mc "Até mais, meninas. Divirtam-se."

# game/scripts/c25/c25.rpy:3866
translate brazilian c25s006_AmaCuddle_8070afad:

    # zeu "*¿Miau?* (Ahora que se han ido, ¿me das atún?)"
    zeu "*Miau?* (Agora que eles foram embora, posso comer um pouco de atum?)"

# game/scripts/c25/c25.rpy:3867
translate brazilian c25s006_AmaCuddle_2e343e3c:

    # mc "¿Qué te parece si vamos a la cocina y miramos si ha quedado algo de pollo para darte?"
    mc "Que tal irmos até a cozinha ver se sobrou algum frango para você?"

# game/scripts/c25/c25.rpy:3868
translate brazilian c25s006_AmaCuddle_e2c05dd6:

    # zeu "*Miau* (Pollo me sirve. Veo que empiezas a entenderme.)"
    zeu "*Miau* (Frango serve. Vejo que você está começando a me entender.)"

# game/scripts/c25/c25.rpy:3870
translate brazilian c25s006_AmaCuddle_c1417f2b:

    # "Pasas un rato en la cocina dando de comer al puto gato que te ha roto la cama."
    "Você passa um tempo na cozinha alimentando o maldito gato que quebrou sua cama."

# game/scripts/c25/c25.rpy:3871
translate brazilian c25s006_AmaCuddle_4ac0586c:

    # "A este paso, va a engordar hasta parecer un tigre."
    "Nesse ritmo, ele vai ficar tão gordo que vai parecer um tigre."

# game/scripts/c25/c25.rpy:3872
translate brazilian c25s006_AmaCuddle_c265d90f:

    # "Después de darle de comer al gato, compras una cama por internet. No hay camas de titanio anti-gatos."
    "Depois de alimentar o gato, você compra uma cama online. Não existem camas de titânio à prova de gatos."

# game/scripts/c25/c25.rpy:3874
translate brazilian c25s006_AmaCuddle_bd58b940:

    # "Pero hay camas grandes. Muy grandes."
    "Mas há camas grandes. Muito grandes."

# game/scripts/c25/c25.rpy:3880
translate brazilian c25s007_iceCream_d8ce753e:

    # "Después de ducharte, pasas por la cocina de [nor]. Hay un helado de leche materna esperándote."
    "Depois do banho, você vai até a cozinha de [nor]. Lá tem um sorvete de leite materno te esperando."

# game/scripts/c25/c25.rpy:3882
translate brazilian c25s007_iceCream_b97a050f:

    # "Coges una porción pequeña del cuenco de helado que [mee] te había indicado."
    "Você pega uma pequena porção da tigela de sorvete que [mee] havia lhe indicado."

# game/scripts/c25/c25.rpy:3884
translate brazilian c25s007_iceCream_72369e53:

    # mcp "(¡Está bueno! No hay mucha diferencia con el helado normal.)"
    mcp "(É bom! Não tem muita diferença para um sorvete normal.)"

# game/scripts/c25/c25.rpy:3885
translate brazilian c25s007_iceCream_4afedb0d:

    # mcp "(Ni siquiera el toque de Meemaw ha podido estropearlo.)"
    mcp "(Nem mesmo o toque da vovó conseguiu estragar.)"

# game/scripts/c25/c25.rpy:3887
translate brazilian c25s007_iceCream_81658836:

    # mcp "(No sé por qué esperaba algo diferente. Es leche al fin y al cabo.)"
    mcp "(Não sei por que esperava algo diferente. Afinal, é leite.)"

# game/scripts/c25/c25.rpy:3889
translate brazilian c25s007_iceCream_1aa0f13c:

    # mcp "(Estoy acostumbrado a beber su leche y, si dejamos de lado el morbo del fetiche, no deja de ser leche.)"
    mcp "(Estou acostumado a beber o leite dela e, se ignorarmos o aspecto mórbido do fetiche, ainda é só leite.)"

# game/scripts/c25/c25.rpy:3891
translate brazilian c25s007_iceCream_391c5558:

    # mcp "(Creo que es hora de ir a buscar a Meemaw para nuestra cena.)"
    mcp "(Acho que está na hora de ir procurar a vovó para o nosso jantar.)"

# game/scripts/c25/c25.rpy:3894
translate brazilian c25s007_iceCream_f76426e3:

    # "Decides volver a tu habitación. Después de todo el día trabajando en la contabilidad, tienes ganas de jugar un rato."
    "Você decide voltar para o seu quarto. Depois de trabalhar o dia todo na contabilidade, você sente vontade de se divertir um pouco."

# game/scripts/c25/c25.rpy:3899
translate brazilian c25s007_MeeDate_1340357e:

    # "Llegas a la puerta de la habitación de [mee]. Por alguna razón estás nervioso por la cita que no es una cita... aún."
    "Você chega à porta do quarto de [mee]. Por algum motivo, você está nervoso(a) com o encontro que ainda não é um encontro... ainda."

# game/scripts/c25/c25.rpy:3901
translate brazilian c25s007_MeeDate_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c25/c25.rpy:3902
translate brazilian c25s007_MeeDate_b9d45fd7:

    # mc "Meemaw, soy yo. ¿Puedo pasar?"
    mc "Vovó, sou eu. Posso entrar?"

# game/scripts/c25/c25.rpy:3903
translate brazilian c25s007_MeeDate_d91056fe:

    # mee "*A través de la puerta* Sí, pasa."
    mee "*Pela porta* Sim, entre."

# game/scripts/c25/c25.rpy:3905
translate brazilian c25s007_MeeDate_d2b04026:

    # mee "Estoy al fondo..."
    mee "Estou lá atrás..."

# game/scripts/c25/c25.rpy:3906
translate brazilian c25s007_MeeDate_37f2f65d:

    # mc "¿Estás preparada para nuestra cena?"
    mc "Estão prontos para o nosso jantar?"

# game/scripts/c25/c25.rpy:3912
translate brazilian c25s007_MeeDate_d2a0fceb:

    # mee "No he estado más preparada para una cena en mi vida."
    mee "Nunca estive tão preparado para um jantar em toda a minha vida."

# game/scripts/c25/c25.rpy:3914
translate brazilian c25s007_MeeDate_b06a25ba:

    # mc "¡Wow, Meemaw!"
    mc "Uau, vovó!"

