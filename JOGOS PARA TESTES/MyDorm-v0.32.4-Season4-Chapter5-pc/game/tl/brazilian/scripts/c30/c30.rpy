translate brazilian c30s003_MarShopping_a6cc2eb5:

    # dap "Better than we all expected. She hasn't broken anything. *Laugh*"
    dap "Melhor do que todas nós esperávamos. Ela não quebrou nada. *Risos*"

# game/scripts/c30/c30.rpy:1366
translate brazilian c30s003_MarShopping_786d3bf5:

    # mom "I'm going to order a coffee. I want to try the coffee [sca] makes so I can compare it to the ones [eil] and [eri] make."
