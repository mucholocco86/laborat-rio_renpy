# game/scripts/c30/c30.rpy:2486
translate brazilian c30s006_wedding_953f2014:

    # jam "Do you think you can leave for Aruba without your girlfriends wanting to do something special before you go?"
    jam "Você acha que pode ir pra Aruba sem que as suas namoradas queiram fazer algo especial antes de você partir?"

# game/scripts/c30/c30.rpy:2488
translate brazilian c30s006_wedding_f652d3f6:

    # jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"
    jam "Você acha que pode ir pra Aruba e deixar sua namorada aqui sem que ela queira fazer algo especial antes de você partir?"

# game/scripts/c30/c30.rpy:2493
translate brazilian c30s006_wedding_f652d3f6_1:

    # jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"
    jam "Você acha que pode ir pra Aruba e deixar sua namorada aqui sem que ela queira fazer algo especial antes de você partir?"

# game/scripts/c30/c30.rpy:2495
translate brazilian c30s006_wedding_fc06d66f:

    # jam "Do you think you can go to Aruba without the girlfriends you're leaving behind wanting to do something special before you leave?"
    jam "Você acha que pode ir pra Aruba sem que as namoradas que você tá deixando pra trás queiram fazer algo especial antes de você partir?"

# game/scripts/c30/c30.rpy:2497
translate brazilian c30s006_wedding_fc06d66f_1:

    # jam "Do you think you can go to Aruba without the girlfriends you're leaving behind wanting to do something special before you leave?"
