# game/scripts/c30/c30.rpy:1374
translate brazilian c30s003_MarShopping_7aaff76c:

    # mc "So, everything's good with the first day at work, right?"
    mc "Então, tudo certo com o primeiro dia de trabalho, né?"

# game/scripts/c30/c30.rpy:1376
translate brazilian c30s003_MarShopping_f69e5224:

    # dap "Yeah, she seems really excited. All these days she's spent here have given her a lot of confidence."
