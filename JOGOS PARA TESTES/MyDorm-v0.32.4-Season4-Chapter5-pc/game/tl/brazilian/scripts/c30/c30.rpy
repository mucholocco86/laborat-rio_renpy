# game/scripts/c30/c30.rpy:1381
translate brazilian c30s003_MarShopping_f8ec25b3:

    # dap "Being surrounded by girls she didn't know well has been good for her also. And dating you too."
    dap "Estar cercada de garotas que ela não conhecia bem também fez bem pra ela. E namorar com você também."

# game/scripts/c30/c30.rpy:1383
translate brazilian c30s003_MarShopping_7acc6f89:

    # dap "Being surrounded by girls she didn't know well has been good for her also. It forced her to open up."
    dap "Estar cercada de garotas que ela não conhecia bem também fez bem pra ela. Isso forçou ela a se abrir."

