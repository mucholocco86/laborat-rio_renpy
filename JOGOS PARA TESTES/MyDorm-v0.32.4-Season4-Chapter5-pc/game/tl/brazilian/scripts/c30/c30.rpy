# game/scripts/c30/c30.rpy:2699
translate brazilian c30s006_mad_19664287:

    # mad "A little..."
    mad "Um pouco..."

# game/scripts/c30/c30.rpy:2700
translate brazilian c30s006_mad_bceaa42d:

    # mc "Well, you wanted to talk to me, right?"
    mc "Bom, você queria falar comigo, né?"

# game/scripts/c30/c30.rpy:2703
translate brazilian c30s006_mad_106f455a:

    # mad "Well, it all started when you proposed to [kia] and then you proposed to me with that post-it..."
    mad "Bom, tudo começou quando você pediu a [kia] em casamento e depois me pediu em casamento com aquele post-it..."

# game/scripts/c30/c30.rpy:2705
translate brazilian c30s006_mad_b4259883:

    # mad "Well, it all started when you proposed to me with that post-it."
    mad "Bom, tudo começou quando você me pediu em casamento com aquele post-it."

# game/scripts/c30/c30.rpy:2706
translate brazilian c30s006_mad_f4770c25:

    # mc "And we discovered you have a marriage fetish. *Laugh*"
    mc "E a gente descobriu que você tem um fetiche por casamento. *Risos*"

# game/scripts/c30/c30.rpy:2707
translate brazilian c30s006_mad_eeaae653:

    # mad "Yeah..."
    mad "É..."

# game/scripts/c30/c30.rpy:2709
translate brazilian c30s006_mad_1a7bb245:

    # mad "I don't know if you've noticed, but I hardly ever wear rings."
    mad "Não sei se você notou, mas eu quase nunca uso anéis."

# game/scripts/c30/c30.rpy:2710
translate brazilian c30s006_mad_e5db7433:

    # mc "I noticed. I don't wear them either, but for a wedding ring I'd be willing to change that habit."
    mc "Eu notei. Eu também não uso, mas por uma aliança de casamento eu estaria disposto a mudar esse hábito."

# game/scripts/c30/c30.rpy:2713
translate brazilian c30s006_mad_b916222b:

    # mad "A ring for each girl? Which girl's ring goes on the ring finger?"
    mad "Um anel para cada garota? Qual anel vai no dedo anelar?"

# game/scripts/c30/c30.rpy:2714
translate brazilian c30s006_mad_c22d41c7:

    # mad "We'd never be able to agree on a ring design, so you'd only have to wear one."
    mad "Nós nunca conseguiríamos concordar em um design de anel, então você só teria que usar um."

# game/scripts/c30/c30.rpy:2715
translate brazilian c30s006_mad_a29dd635:

    # mc "That would be complicated. Each of you would want something to fit your own taste."
    mc "Isso seria complicado. Cada uma de vocês iria querer algo que combinasse com o próprio gosto."

# game/scripts/c30/c30.rpy:2717
translate brazilian c30s006_mad_16bcbbaf:

    # mad "But your post-it solved that problem. It gave me an idea."
    mad "Mas o seu post-it resolveu esse problema. Me deu uma ideia."

# game/scripts/c30/c30.rpy:2719
translate brazilian c30s006_mad_2ad34fa0:

    # mad "Each of us would have our own personalized ring to our liking. With something that meant something to her."
    mad "Cada uma de nós teria seu próprio anel personalizado do nosso jeito. Com algo que significasse algo para ela."

# game/scripts/c30/c30.rpy:2720
translate brazilian c30s006_mad_7c19a090:

    # mad "We don't need a physical ring to show that we're together."
    mad "Nós não precisamos de um anel físico para mostrar que estamos juntos."

# game/scripts/c30/c30.rpy:2721
translate brazilian c30s006_mad_f418ae84:

    # mc "I don't understand what you mean."
    mc "Não entendi o que você quer dizer."

# game/scripts/c30/c30.rpy:2723
translate brazilian c30s006_mad_8f78ca83:

    # mad "[mc] Marks, with this ring I declare myself your wife. If you want, of course."
    mad "[mc] Marks, com este anel eu me declaro sua esposa. Se você quiser, é claro."

# game/scripts/c30/c30.rpy:2724
translate brazilian c30s006_mad_0acbaeac:

    # mc "Of course I want to!"
    mc "É claro que eu quero!"

# game/scripts/c30/c30.rpy:2726
translate brazilian c30s006_mad_31428ada:

    # "Your new wife turns around and kisses you even more passionately than before."
    "Sua nova esposa se vira e te beija ainda mais apaixonadamente do que antes."

# game/scripts/c30/c30.rpy:2727
translate brazilian c30s006_mad_c0c1886a:

    # "There are no more nerves. Only joy. Now you understand why no one told you what this was about."
    "Não há mais nervosismo. Apenas alegria. Agora você entende por que ninguém te contou sobre o que era isso."

# game/scripts/c30/c30.rpy:2728
translate brazilian c30s006_mad_54f636a8:

    # "The kiss is even longer than the last one. Despite everything, it feels short to you."
    "O beijo é ainda mais longo que o último. Apesar de tudo, parece curto para você."

# game/scripts/c30/c30.rpy:2731
translate brazilian c30s006_mad_ca04a8d2:

    # mc "Did you get a tattoo of the drawing I made on the post-it?"
    mc "Você tatuou o desenho que eu fiz no post-it?"

# game/scripts/c30/c30.rpy:2733
translate brazilian c30s006_mad_25d1fa23:

    # mad "By drawing the ring, you solved the issue of the custom ring."
    mad "Ao desenhar o anel, você resolveu o problema do anel personalizado."

# game/scripts/c30/c30.rpy:2734
translate brazilian c30s006_mad_313deb7c:

    # mad "It meant so much to me that I don't want any other ring."
    mad "Significou tanto para mim que eu não quero nenhum outro anel."

# game/scripts/c30/c30.rpy:2735
translate brazilian c30s006_mad_cd43271f:

    # mc "Did each of you get a ring tattooed?"
    mc "Cada uma de vocês tatuou um anel?"

# game/scripts/c30/c30.rpy:2737
translate brazilian c30s006_mad_7e142eda:

    # mad "You'll have to find that out for yourself. The bad part about the harem is that we can't enjoy this moment for very long."
    mad "Você vai ter que descobrir isso sozinho. A parte ruim do harém é que não podemos aproveitar esse momento por muito tempo."

# game/scripts/c30/c30.rpy:2739
translate brazilian c30s006_mad_d4c19048:

    # mad "There's another girl waiting for you, and Jamaal must be getting impatient."
    mad "Tem outra garota esperando por você, e o Jamaal já deve estar ficando impaciente."

# game/scripts/c30/c30.rpy:2741
translate brazilian c30s006_mad_eb4b80b1:

    # mad "There are other girls waiting for you, and Jamaal must be getting impatient."
    mad "Tem outras garotas esperando por você, e o Jamaal já deve estar ficando impaciente."

# game/scripts/c30/c30.rpy:2742
translate brazilian c30s006_mad_7f255f25:

    # mc "*Laugh* I hate that scavenging vulture."
    mc "*Risos* Eu odeio aquele abutre carniceiro."

# game/scripts/c30/c30.rpy:2744
translate brazilian c30s006_mad_706ade4b:

    # mad "By drawing the ring, you solved the issue of not wearing rings that I could lose."
    mad "Ao desenhar o anel, você resolveu o problema de eu não usar anéis que eu poderia perder."

# game/scripts/c30/c30.rpy:2745
translate brazilian c30s006_mad_313deb7c_1:

    # mad "It meant so much to me that I don't want any other ring."
    mad "Significou tanto para mim que não quero nenhum outro anel."

# game/scripts/c30/c30.rpy:2746
translate brazilian c30s006_mad_9156efd3:

    # mc "Rings are uncomfortable and you definitely can't lose this one. This is more... permanent."
    mc "Anéis são desconfortáveis e você definitivamente não pode perder esse. Esse é mais... permanente."

# game/scripts/c30/c30.rpy:2748
translate brazilian c30s006_mad_a0bc7a8e:

    # mad "But now we should go see [mee] and Aunt [bet]. I'm sure they want to congratulate us."
    mad "Mas agora devemos ir ver a [mee] e a Tia [bet]. Tenho certeza de que elas querem nos dar os parabéns."

# game/scripts/c30/c30.rpy:2749
translate brazilian c30s006_mad_172e56c7:

    # mc "We're not going to get a moment to ourselves, are we?"
    mc "Nós não vamos ter um momento só para nós, vamos?"

# game/scripts/c30/c30.rpy:2751
translate brazilian c30s006_mad_a8321211:

    # mad "Unfortunately, no. But I hope we get one before you leave for Aruba."
    mad "Infelizmente, não. Mas espero que a gente consiga um antes de você ir para Aruba."

# game/scripts/c30/c30.rpy:2752
translate brazilian c30s006_mad_b1472e3a:

    # mc "By the way, am I going to have to get a ring tattooed also?"
    mc "A propósito, eu também vou ter que tatuar um anel?"

# game/scripts/c30/c30.rpy:2754
translate brazilian c30s006_mad_ac913fac:

    # mad "*Laugh* No, honey. I like your body the way it is, without tattoos."
    mad "*Risos* Não, querido. Eu gosto do seu corpo do jeito que é, sem tatuagens."

# game/scripts/c30/c30.rpy:2757
translate brazilian c30s006_mad_99a57d1d:

    # "You kiss each other again, just as passionately as the previous two times, but calmer at the same time."
    "Vocês se beijam novamente, tão apaixonadamente quanto nas duas vezes anteriores, mas mais calmos ao mesmo tempo."

# game/scripts/c30/c30.rpy:2758
translate brazilian c30s006_mad_e962a17f:

    # "Kissing your new wife produces a warmth inside you that runs through your entire body."
    "Beijar sua nova esposa produz um calor dentro de você que percorre todo o seu corpo."

# game/scripts/c30/c30.rpy:2760
translate brazilian c30s006_mad_66a58f13:

    # "You pull away reluctantly."
    "Você se afasta com relutância."

# game/scripts/c30/c30.rpy:2762
translate brazilian c30s006_mad_b51dfd2c:

    # "There's a scavenging vulture waiting for you."
    "Tem um abutre carniceiro esperando por você."

# game/scripts/c30/c30.rpy:2764
translate brazilian c30s006_mad_81b6f66c:

    # "[mee] and Aunt [bet] are waiting for you."
    "[mee] e a Tia [bet] estão esperando por você."

# game/scripts/c30/c30.rpy:2770
translate brazilian c30s006_kia_f6ff2923:

    # "The next stop is [kia], after Jamaal forces you to walk one lap around the house."
    "A próxima parada é a [kia], depois que o Jamaal te obriga a dar uma volta ao redor da casa."

# game/scripts/c30/c30.rpy:2772
translate brazilian c30s006_kia_9f712fad:

    # "Jamaal accompanies you to where [kia] is."
    "Jamaal te acompanha até onde a [kia] está."

# game/scripts/c30/c30.rpy:2784
translate brazilian c30s006_kia_2ac128a1:

    # "You approach [kia] imagining what awaits you. Did they all get a ring tattooed?"
    "Você se aproxima da [kia] imaginando o que te aguarda. Será que todas tatuaram um anel?"

# game/scripts/c30/c30.rpy:2785
translate brazilian c30s006_kia_dfcaa03d:

    # mc "Hey, [kia]. You look gorgeous. I guess there's a tattoo I need to see."
    mc "Ei, [kia]. Você está linda. Acho que tem uma tatuagem que eu preciso ver."

# game/scripts/c30/c30.rpy:2786
translate brazilian c30s006_kia_50fe39a3:

    # kia "*Laugh* I guess being the second woman has the disadvantage of not surprising you anymore."
    kia "*Risos* Acho que ser a segunda mulher tem a desvantagem de não te surpreender mais."

# game/scripts/c30/c30.rpy:2788
translate brazilian c30s006_kia_29efb65e:

    # kia "And I guess that, when you get to number [relaciones], it'll all feel repetitive."
    kia "E eu imagino que, quando você chegar na número [relaciones], tudo vai parecer repetitivo."

# game/scripts/c30/c30.rpy:2790
translate brazilian c30s006_kia_f9ce47ad:

    # kia "Although being the last one has some advantages."
    kia "Embora ser a última tenha algumas vantagens."

# game/scripts/c30/c30.rpy:2792
translate brazilian c30s006_kia_365373a3:

    # kia "As weird as it might seem to you, I don't want to wear your ring on my finger."
    kia "Por mais estranho que possa parecer pra você, eu não quero usar o seu anel no meu dedo."

translate brazilian c30s006_kia_2b59368c:

    # kia "The one you made has a bad habit of falling apart and I don't want to lose it."
    kia "O que você fez tem o péssimo hábito de se desfazer e eu não quero perdê-lo."

# game/scripts/c30/c30.rpy:2794
translate brazilian c30s006_kia_a710453d:

    # mc "I already told you we'd buy a new ring, but I guess the tattoo solves that."
    mc "Eu já te disse que a gente ia comprar um anel novo, mas acho que a tatuagem resolve isso."

# game/scripts/c30/c30.rpy:2796
translate brazilian c30s006_kia_7589cbb1:

    # kia "I know, but besides... I'd have to wear it on the same finger I've worn Solomon's on all these years."
    kia "Eu sei, mas além disso... eu teria que usar no mesmo dedo que usei o do Solomon todos esses anos."

# game/scripts/c30/c30.rpy:2797
translate brazilian c30s006_kia_7ca22c53:

    # kia "And I don't want what we have, to have anything to do with him."
    kia "E eu não quero que o que a gente tem tenha qualquer coisa a ver com ele."

# game/scripts/c30/c30.rpy:2798
translate brazilian c30s006_kia_72dc2ae8:

    # mc "And [mad.nick] solved the problem when she came up with the idea, right?"
    mc "E a [mad.nick] resolveu o problema quando teve essa ideia, né?"

# game/scripts/c30/c30.rpy:2800
translate brazilian c30s006_kia_cd5dc508:

    # kia "Exactly..."
    kia "Exatamente..."

# game/scripts/c30/c30.rpy:2804
translate brazilian c30s006_kia_c6b20659:

    # kia "Well, you started all this at that beach, while we were watching the sunset."
    kia "Bom, você começou tudo isso naquela praia, enquanto a gente assistia ao pôr do sol."

# game/scripts/c30/c30.rpy:2805
translate brazilian c30s006_kia_18958369:

    # mc "You mean the ring? Don't tell me you bought one."
    mc "Você quer dizer o anel? Não me diga que você comprou um."

# game/scripts/c30/c30.rpy:2807
translate brazilian c30s006_kia_365373a3_1:

    # kia "As weird as it might seem, I don't want to wear your ring on my finger."
    kia "Por mais estranho que pareça, eu não quero usar o seu anel no meu dedo."

# game/scripts/c30/c30.rpy:2808
translate brazilian c30s006_kia_2b59368c_1:

    # kia "The one you made has a bad habit of falling apart, and I don't want to lose it."
    kia "O que você fez tem o péssimo hábito de se desfazer, e eu não quero perdê-lo."

# game/scripts/c30/c30.rpy:2809
translate brazilian c30s006_kia_00da53b6:

    # mc "I already told you we'd buy a new ring."
    mc "Eu já te disse que a gente ia comprar um anel novo."

# game/scripts/c30/c30.rpy:2811
translate brazilian c30s006_kia_938e7e4a:

    # kia "I know, but... I'd have to wear it on the same finger I've worn Solomon's on all these years."
    kia "Eu sei, mas... Eu teria que usar no mesmo dedo em que usei a do Solomon todos esses anos."

# game/scripts/c30/c30.rpy:2812
translate brazilian c30s006_kia_7ca22c53_1:

    # kia "And I don't want what we have, to have anything to do with him."
    kia "E eu não quero que o que nós temos tenha qualquer coisa a ver com ele."

# game/scripts/c30/c30.rpy:2813
translate brazilian c30s006_kia_ef4cd70d:

    # mc "I get it. What do you propose, then?"
    mc "Eu entendo. O que você propõe, então?"

# game/scripts/c30/c30.rpy:2815
translate brazilian c30s006_kia_16b43e66:

    # kia "Something more permanent. Something I can never lose."
    kia "Algo mais permanente. Algo que eu nunca possa perder."

# game/scripts/c30/c30.rpy:2817
translate brazilian c30s006_kia_91f25e48:

    # kia "With this ring, I declare that I am your wife. Now and forever."
    kia "Com este anel, eu declaro que sou sua esposa. Agora e para sempre."

# game/scripts/c30/c30.rpy:2819
translate brazilian c30s006_kia_b2b46501:

    # mc "What? You got a tattoo of the ring I made for you?"
    mc "O quê? Você fez uma tatuagem do anel que eu fiz pra você?"

# game/scripts/c30/c30.rpy:2821
translate brazilian c30s006_kia_d8c2f3f3:

    # mc "I love that you got a tattoo of the ring I made for you."
    mc "Eu amei que você fez uma tatuagem do anel que eu fiz pra você."

# game/scripts/c30/c30.rpy:2823
translate brazilian c30s006_kia_61a555ca:

    # kia "*Laugh* It was either that or getting a cork tattooed. I preferred the ring."
    kia "*Risos* Era isso ou tatuar uma rolha. Eu preferi o anel."

# game/scripts/c30/c30.rpy:2825
translate brazilian c30s006_kia_27efe88d:

    # "Neither of you needs to say anything else. Your lips meet in an incredibly tender kiss."
    "Nenhum de vocês precisa dizer mais nada. Seus lábios se encontram em um beijo incrivelmente carinhoso."

# game/scripts/c30/c30.rpy:2826
translate brazilian c30s006_kia_a8069392:

    # "During the birthday party, she told you her story right here and you were left wanting to kiss her..."
    "Durante a festa de aniversário, ela te contou a história dela bem aqui e você ficou com vontade de beijá-la..."

# game/scripts/c30/c30.rpy:2827
translate brazilian c30s006_kia_932216c6:

    # "Today, you share your first kiss as husband and wife."
    "Hoje, vocês compartilham seu primeiro beijo como marido e mulher."

# game/scripts/c30/c30.rpy:2833
translate brazilian c30s006_kia_dc138ab8:

    # kia "I wish you could stay with me all afternoon and all night, but..."
    kia "Eu queria que você pudesse ficar comigo a tarde toda e a noite toda, mas..."

# game/scripts/c30/c30.rpy:2835
translate brazilian c30s006_kia_e0fdee65:

    # mc "I know, Jamaal is waiting to take me to the next tattoo, right?"
    mc "Eu sei, o Jamaal tá esperando pra me levar pra próxima tatuagem, né?"

# game/scripts/c30/c30.rpy:2837
translate brazilian c30s006_kia_958a4665:

    # mc "I know, I'd like that too, but this was theoretically a party for Aunt [bet] and Meemaw, right?"
    mc "Eu sei, eu também adoraria, mas teoricamente essa era uma festa pra Tia [bet] e pra Meemaw, né?"

# game/scripts/c30/c30.rpy:2838
translate brazilian c30s006_kia_61bf2e18:

    # kia "Yeah. We'll have time for ourselves later. Even if I have to share you with the rest of the girls."
    kia "É. A gente vai ter tempo pra nós depois. Mesmo que eu tenha que te dividir com o resto das garotas."

# game/scripts/c30/c30.rpy:2839
translate brazilian c30s006_kia_8edda7aa:

    # kia "Save a dance for me."
    kia "Guarda uma dança pra mim."

# game/scripts/c30/c30.rpy:2841
translate brazilian c30s006_kia_2a6778d6:

    # mc "See you later, gorgeous."
    mc "Até mais tarde, linda."

# game/scripts/c30/c30.rpy:2843
translate brazilian c30s006_kia_c6ec59ab:

    # mc "Shall we?"
    mc "Vamos?"

# game/scripts/c30/c30.rpy:2848
translate brazilian c30s006_sim_7ab13492:

    # "The next stop is [sim], after the mandatory walk around the house so the next girl can get into the position she chose."
    "A próxima parada é a [sim], depois da caminhada obrigatória pela casa pra que a próxima garota possa ficar na posição que escolheu."

# game/scripts/c30/c30.rpy:2849
translate brazilian c30s006_sim_82895414:

    # "Obviously, her chosen place is by the pool."
    "Obviamente, o lugar que ela escolheu é perto da piscina."

# game/scripts/c30/c30.rpy:2851
translate brazilian c30s006_sim_fc52c4fd:

    # "Jamaal walks you over to where [sim] is."
    "Jamaal te leva até onde a [sim] está."

# game/scripts/c30/c30.rpy:2854
translate brazilian c30s006_sim_341a986a:

    # jam "She's my sister. Treat her well, please."
    jam "Ela é minha irmã. Trata ela bem, por favor."

# game/scripts/c30/c30.rpy:2855
translate brazilian c30s006_sim_7878f5b2:

    # mc "Have I ever treated her badly?... Well, better not answer that. But that was many years ago."
    mc "Eu já a tratei mal alguma vez?... Bom, melhor não responder isso. Mas isso foi há muitos anos."

# game/scripts/c30/c30.rpy:2856
translate brazilian c30s006_sim_56c88dcf:

    # mc "Besides, it seems being with Anthony is softening you up. *Laugh* You care about [sim] now?"
    mc "Além disso, parece que estar com o Anthony tá te amolecendo. *Risos* Você se importa com a [sim] agora?"

# game/scripts/c30/c30.rpy:2858
translate brazilian c30s006_sim_3c3cdce9:

    # "You turn towards [sim] without giving him time to answer."
    "Você se vira para [sim] sem dar tempo para ele responder."

# game/scripts/c30/c30.rpy:2859
translate brazilian c30s006_sim_320c7b2f:

    # jam "*Laugh* I still don't know why I'm your friend. Asshole!"
    jam "*Risos* Eu ainda não sei por que sou seu amigo. Cuzão!"

# game/scripts/c30/c30.rpy:2869
translate brazilian c30s006_sim_29de4d14:

    # mc "Hey, [sim]. I don't know how you manage to look more beautiful every day."
    mc "Ei, [sim]. Eu não sei como você consegue ficar mais linda a cada dia."

# game/scripts/c30/c30.rpy:2870
translate brazilian c30s006_sim_6effa933:

    # sim "Thank you. You look really handsome in that suit too."
    sim "Obrigada. Você também está muito bonito nesse terno."

# game/scripts/c30/c30.rpy:2871
translate brazilian c30s006_sim_6fcce14b:

    # mc "I guess there's a tattoo I need to see, right?"
    mc "Acho que tem uma tatuagem que eu preciso ver, né?"

# game/scripts/c30/c30.rpy:2872
translate brazilian c30s006_sim_0c8346e6:

    # mc "Although in our case there was no ring, so it's going to be a surprise."
    mc "Embora no nosso caso não tenha tido anel, então vai ser uma surpresa."

# game/scripts/c30/c30.rpy:2874
translate brazilian c30s006_sim_c2832089:

    # sim "When the idea of tattoos came up, I wanted something that represented us, something that was just ours."
    sim "Quando surgiu a ideia das tatuagens, eu queria algo que nos representasse, algo que fosse só nosso."

# game/scripts/c30/c30.rpy:2875
translate brazilian c30s006_sim_ed88d02a:

    # sim "But we've spent so many years together that there isn't just one thing that stands out above the rest, so I went with something classic."
    sim "Mas passamos tantos anos juntos que não tem apenas uma coisa que se destaque acima do resto, então escolhi algo clássico."

# game/scripts/c30/c30.rpy:2876
translate brazilian c30s006_sim_433fc9d7:

    # mc "Classic is always a good choice."
    mc "O clássico é sempre uma boa escolha."

# game/scripts/c30/c30.rpy:2878
translate brazilian c30s006_sim_3bee01b9:

    # sim "I also wanted something that would last forever. *Laugh* You're not getting away from me that easily. So, the tattoo was a great option."
    sim "Eu também queria algo que durasse para sempre. *Risos* Você não vai escapar de mim tão fácil. Então, a tatuagem foi uma ótima opção."

# game/scripts/c30/c30.rpy:2882
translate brazilian c30s006_sim_3d43ab95:

    # sim "The other day, in your room, I asked you to marry me. And you said yes."
    sim "Outro dia, no seu quarto, eu te pedi em casamento. E você disse sim."

# game/scripts/c30/c30.rpy:2883
translate brazilian c30s006_sim_0e974e64:

    # mc "I could never have turned down a proposal like that, [sim]."
    mc "Eu nunca poderia ter recusado um pedido desses, [sim]."

# game/scripts/c30/c30.rpy:2884
translate brazilian c30s006_sim_7f65a358:

    # sim "But I didn't have a ring to give you."
    sim "Mas eu não tinha um anel para te dar."

# game/scripts/c30/c30.rpy:2885
translate brazilian c30s006_sim_cb4b13bf:

    # mc "We don't need a ring between us, [sim]."
    mc "Nós não precisamos de um anel entre nós, [sim]."

# game/scripts/c30/c30.rpy:2887
translate brazilian c30s006_sim_41dfaa5e:

    # sim "I wanted something that would last forever. *Laugh* You're not getting away from me that easily."
    sim "Eu queria algo que durasse para sempre. *Risos* Você não vai escapar de mim tão fácil."

# game/scripts/c30/c30.rpy:2888
translate brazilian c30s006_sim_8e7553af:

    # mc "*Laugh* I have no intention of running away."
    mc "*Risos* Eu não tenho a menor intenção de fugir."

# game/scripts/c30/c30.rpy:2890
translate brazilian c30s006_sim_9930679e:

    # sim "[mc], with this ring I declare myself your wife."
    sim "[mc], com este anel eu me declaro sua esposa."

# game/scripts/c30/c30.rpy:2892
translate brazilian c30s006_sim_4f02c3fe:

    # mc "What? You got a wedding ring tattooed?"
    mc "O quê? Você tatuou uma aliança de casamento?"

# game/scripts/c30/c30.rpy:2893
translate brazilian c30s006_sim_7cf64a1f:

    # mc "It's a beautiful tattoo. Very classic, just like us. The guy who dates his best friend's sister and..."
    mc "É uma tatuagem linda. Bem clássica, assim como nós. O cara que namora a irmã do melhor amigo e..."

# game/scripts/c30/c30.rpy:2894
translate brazilian c30s006_sim_8fe612e9:

    # sim "And she ends up getting a ring tattooed. *Laugh* Instead of a classic ring, I got a chain; each link is a step that brought us here."
    sim "E ela acaba tatuando um anel. *Risos* Em vez de um anel clássico, eu fiz uma corrente; cada elo é um passo que nos trouxe até aqui."

# game/scripts/c30/c30.rpy:2896
translate brazilian c30s006_sim_2510998a:

    # mc "I see a lot of links... Have we taken that many steps?"
    mc "Estou vendo muitos elos... Demos tantos passos assim?"

# game/scripts/c30/c30.rpy:2897
translate brazilian c30s006_sim_588a79b1:

    # sim "This way it's sure to last forever. We have to give a meaning to each link."
    sim "Assim é certeza que vai durar para sempre. Temos que dar um significado para cada elo."

# game/scripts/c30/c30.rpy:2899
translate brazilian c30s006_sim_c3441bd8:

    # "You kiss your new wife for the first time. In just a few days she has gone from friend to girlfriend, to fiancée, and to wife."
    "Você beija sua nova esposa pela primeira vez. Em apenas alguns dias ela passou de amiga para namorada, para noiva e para esposa."

# game/scripts/c30/c30.rpy:2900
translate brazilian c30s006_sim_086ac068:

    # "A natural and classic evolution, albeit a fast one."
    "Uma evolução natural e clássica, embora rápida."

# game/scripts/c30/c30.rpy:2901
translate brazilian c30s006_sim_075913c6:

    # "Just as fast, too fast, your kiss ends."
    "Tão rápido quanto, rápido demais, o beijo de vocês termina."

# game/scripts/c30/c30.rpy:2911
translate brazilian c30s006_sim_e70f6d9a:

    # sim "You know I hate my brother right now, right?"
    sim "Você sabe que eu tô odiando meu irmão agora, né?"

# game/scripts/c30/c30.rpy:2912
translate brazilian c30s006_sim_1ef099e0:

    # mc "*Laugh* Right now? I think you've always hated him."
    mc "*Risos* Agora? Acho que você sempre odiou ele."

# game/scripts/c30/c30.rpy:2914
translate brazilian c30s006_sim_21716e15:

    # sim "*Laugh* Well, yes. But right now I hate him even more. He's over there signaling me to send you to him."
    sim "*Risos* Bom, sim. Mas agora eu odeio ele ainda mais. Ele tá ali fazendo sinal pra eu mandar você pra ele."

# game/scripts/c30/c30.rpy:2915
translate brazilian c30s006_sim_6fd89827:

    # sim "I think he has to take you somewhere else right now."
    sim "Acho que ele tem que te levar pra outro lugar agora."

# game/scripts/c30/c30.rpy:2916
translate brazilian c30s006_sim_e4d641f1:

    # mc "*Laugh* We all hate Jamaal."
    mc "*Risos* Todos nós odiamos o Jamaal."

# game/scripts/c30/c30.rpy:2921
translate brazilian c30s006_sim_9433cf80:

    # "You kiss your wife again, this time as a brief farewell before returning to Jamaal."
    "Você beija sua esposa de novo, dessa vez como uma breve despedida antes de voltar para o Jamaal."

# game/scripts/c30/c30.rpy:2923
translate brazilian c30s006_sim_91dd84e7:

    # "You kiss your wife again, this time as a brief farewell before heading to the party."
    "Você beija sua esposa de novo, desta vez como uma breve despedida antes de ir para a festa."

# game/scripts/c30/c30.rpy:2928
translate brazilian c30s006_kat_5bca0224:

    # "The next girl is [kat]. She is waiting for you where you had the non-date."
    "A próxima garota é a [kat]. Ela está te esperando onde vocês tiveram o não-encontro."

# game/scripts/c30/c30.rpy:2930
translate brazilian c30s006_kat_8e27dc46:

    # "Jamaal guides you to where [kat] is waiting for you, where you had your non-date."
    "Jamaal te guia até onde a [kat] está te esperando, onde vocês tiveram o não-encontro."

# game/scripts/c30/c30.rpy:2941
translate brazilian c30s006_kat_d8ea17bd:

    # mc "You look gorgeous, [kat]. I can't wait to see what you got tattooed."
    mc "Você está linda, [kat]. Mal posso esperar pra ver o que você tatuou."

# game/scripts/c30/c30.rpy:2942
translate brazilian c30s006_kat_4bfa0b14:

    # kat "Who told you I got a tattoo?"
    kat "Quem te disse que eu fiz uma tatuagem?"

# game/scripts/c30/c30.rpy:2943
translate brazilian c30s006_kat_a0e03345:

    # mc "You didn't? You surprise me, Little Beluga."
    mc "Você não fez? Você me surpreende, Pequena Beluga."

# game/scripts/c30/c30.rpy:2945
translate brazilian c30s006_kat_20c9ff1e:

    # kat "*Laugh* I did get one. But I assure you I didn't want to. It seems ridiculous to declare myself your wife after just a few kisses."
    kat "*Risos* Eu fiz uma. Mas te garanto que eu não queria. Parece ridículo me declarar sua esposa depois de apenas alguns beijos."

# game/scripts/c30/c30.rpy:2946
translate brazilian c30s006_kat_f18493d0:

    # mc "You don't have to do it if you don't want to."
    mc "Você não precisa fazer isso se não quiser."

# game/scripts/c30/c30.rpy:2948
translate brazilian c30s006_kat_91ac0fe1:

    # kat "I said it seems ridiculous, not that I don't want to do it. What I didn't want was to get a tattoo."
    kat "Eu disse que parece ridículo, não que eu não queira fazer. O que eu não queria era fazer uma tatuagem."

# game/scripts/c30/c30.rpy:2949
translate brazilian c30s006_kat_10cfab11:

    # kat "You said it yourself. You don't know what I got tattooed. We don't have anything that defines us, that is just ours. It's too soon."
    kat "Você mesmo disse. Você não sabe o que eu tatuei. Não temos nada que nos defina, que seja só nosso. É muito cedo."

# game/scripts/c30/c30.rpy:2951
translate brazilian c30s006_kat_6ebec553:

    # mc "If I had to choose, I would have tattooed a waffle, you looked so cute when I gave you a piece of mine."
    mc "Se eu tivesse que escolher, eu teria tatuado um waffle, você ficou tão fofa quando te dei um pedaço do meu."

# game/scripts/c30/c30.rpy:2953
translate brazilian c30s006_kat_8d32c36f:

    # mc "If I had to choose, I would have tattooed a waffle, you know, because of the non-date... You threatened to steal a piece from me."
    mc "Se eu tivesse que escolher, eu teria tatuado um waffle, sabe, por causa do não-encontro... Você ameaçou roubar um pedaço meu."

# game/scripts/c30/c30.rpy:2954
translate brazilian c30s006_kat_8e6575bf:

    # mc "That would be just ours."
    mc "Isso seria só nosso."

# game/scripts/c30/c30.rpy:2958
translate brazilian c30s006_kat_ab7588ba:

    # kat "I want to start by saying that I didn't want to do this. It seems ridiculous after just a few kisses."
    kat "Quero começar dizendo que eu não queria fazer isso. Parece ridículo depois de apenas alguns beijos."

# game/scripts/c30/c30.rpy:2960
translate brazilian c30s006_kat_32806ade:

    # kat "But they forced me to do it..."
    kat "Mas me forçaram a fazer isso..."

# game/scripts/c30/c30.rpy:2962
translate brazilian c30s006_kat_25e9d74e:

    # kat "But I didn't want you to leave for Aruba without doing it..."
    kat "Mas eu não queria que você fosse para Aruba sem fazer isso..."

# game/scripts/c30/c30.rpy:2963
translate brazilian c30s006_kat_b0b0ec3d:

    # mc "Whatever you're going to do, you don't have to do it if you don't want to."
    mc "O que quer que você vá fazer, não precisa fazer se não quiser."

# game/scripts/c30/c30.rpy:2965
translate brazilian c30s006_kat_2492b700:

    # kat "I don't mean the act of doing it, but that we still don't have anything that defines us... Nothing that you look at and think of us as a couple."
    kat "Não me refiro ao ato de fazer, mas que ainda não temos nada que nos defina... Nada que você olhe e pense na gente como um casal."

# game/scripts/c30/c30.rpy:2967
translate brazilian c30s006_kat_8ba9850f:

    # mc "If I had to choose, I'd think of a waffle, you looked so cute when I gave you a piece of mine. Or a beluga..."
    mc "Se eu tivesse que escolher, pensaria num waffle, você ficou tão fofa quando te dei um pedaço do meu. Ou uma beluga..."

# game/scripts/c30/c30.rpy:2969
translate brazilian c30s006_kat_d004c2ba:

    # mc "If I had to choose, I'd think of a waffle, you know, because of the non-date... You looked so cute when you threatened to steal a piece of mine. Or a beluga..."
    mc "Se eu tivesse que escolher, pensaria num waffle, sabe, por causa do não-encontro... Você ficou tão fofa quando ameaçou roubar um pedaço do meu. Ou uma beluga..."

# game/scripts/c30/c30.rpy:2970
translate brazilian c30s006_kat_8e6575bf_1:

    # mc "That would be just ours."
    mc "Isso seria só nosso."

# game/scripts/c30/c30.rpy:2972
translate brazilian c30s006_kat_6cd5389d:

    # kat "*Laugh* You're an asshole! But I like that you're starting to get to know me."
    kat "*Risos* Você é um cuzão! Mas gosto que você está começando a me conhecer."

# game/scripts/c30/c30.rpy:2973
translate brazilian c30s006_kat_2bb99d7b:

    # kat "And now you're my asshole."
    kat "E agora você é o meu cuzão."

# game/scripts/c30/c30.rpy:2975
translate brazilian c30s006_kat_98ed6bfe:

    # kat "With this waffle, I declare myself your wife."
    kat "Com este waffle, eu me declaro sua esposa."

# game/scripts/c30/c30.rpy:2976
translate brazilian c30s006_kat_f719922c:

    # mc "*Laugh* Are you proposing to me with a waffle?"
    mc "*Risos* Você tá me pedindo em casamento com um waffle?"

# game/scripts/c30/c30.rpy:2978
translate brazilian c30s006_kat_ed2901cd:

    # kat "No. I'm telling you that, whether you like it or not, you're married to me. Instead of a wedding cake, we can have a wedding waffle."
    kat "Não. Tô te dizendo que, quer você queira ou não, você tá casado comigo. Em vez de um bolo de casamento, podemos ter um waffle de casamento."

# game/scripts/c30/c30.rpy:2979
translate brazilian c30s006_kat_01709959:

    # kat "You may kiss the bride."
    kat "Pode beijar a noiva."

# game/scripts/c30/c30.rpy:2981
translate brazilian c30s006_kat_0368d6c1:

    # kat "If you accept... of course..."
    kat "Se você aceitar... claro..."

# game/scripts/c30/c30.rpy:2983
translate brazilian c30s006_kat_6fac804f:

    # "It would never cross your mind to reject such a proposal from a woman as wonderful as [kat]."
    "Nunca passaria pela sua cabeça rejeitar um pedido desses de uma mulher tão maravilhosa quanto a [kat]."

# game/scripts/c30/c30.rpy:2984
translate brazilian c30s006_kat_eeefc345:

    # "You seal your future with a kiss as tender as it is passionate."
    "Você sela o seu futuro com um beijo tão terno quanto apaixonado."

# game/scripts/c30/c30.rpy:2985
translate brazilian c30s006_kat_bee7b5f0:

    # "You could never have imagined it would end up like this when that girl with purple-dyed hair showed up at the airport."
    "Você nunca imaginaria que acabaria assim quando aquela garota de cabelo tingido de roxo apareceu no aeroporto."

# game/scripts/c30/c30.rpy:2987
translate brazilian c30s006_kat_3b333f01:

    # mc "Of course I accept. Proposing to me... or declaring yourself my wife... with a waffle is... too sweet."
    mc "Claro que eu aceito. Me pedir em casamento... ou se declarar minha esposa... com um waffle é... fofo demais."

# game/scripts/c30/c30.rpy:2988
translate brazilian c30s006_kat_5d49cda6:

    # kat "*Laugh* My God! I'm getting hungry just thinking about it. Remember that I eat when I get nervous..."
    kat "*Risos* Meu Deus! Tô ficando com fome só de pensar nisso. Lembra que eu como quando fico nervosa..."

# game/scripts/c30/c30.rpy:2989
translate brazilian c30s006_kat_81d388b2:

    # mc "You don't have to be nervous about anything, honey. You're my wife now and that's never going to change."
    mc "Você não precisa ficar nervosa com nada, querida. Você é minha esposa agora e isso nunca vai mudar."

# game/scripts/c30/c30.rpy:2991
translate brazilian c30s006_kat_9a64b041:

    # kat "I guess it would be a bit hard to find a judge to divorce us considering how the wedding went, right?"
    kat "Acho que seria um pouco difícil encontrar um juiz para nos divorciar considerando como foi o casamento, né?"

# game/scripts/c30/c30.rpy:2992
translate brazilian c30s006_kat_5be526a0:

    # mc "I have no interest in looking for that judge, so we'll never know."
    mc "Eu não tenho nenhum interesse em procurar esse juiz, então nunca saberemos."

# game/scripts/c30/c30.rpy:3000
translate brazilian c30s006_kat_3d9abbf4:

    # mc "Now all we need is to have our wedding night, right?"
    mc "Agora tudo que precisamos é ter a nossa noite de núpcias, certo?"

# game/scripts/c30/c30.rpy:3001
translate brazilian c30s006_kat_ef4072c2:

    # kat "There will be time for that, though I won't deny I'm nervous about it."
    kat "Haverá tempo para isso, embora eu não negue que estou nervosa com isso."

# game/scripts/c30/c30.rpy:3002
translate brazilian c30s006_kat_25973b5a:

    # mc "*Laugh* Don't worry, I'll make sure there are waffles next to the bed."
    mc "*Risos* Não se preocupe, vou garantir que tenha waffles do lado da cama."

# game/scripts/c30/c30.rpy:3004
translate brazilian c30s006_kat_5926bcb6:

    # kat "*Laugh* You're an asshole."
    kat "*Risos* Você é um cuzão."

# game/scripts/c30/c30.rpy:3005
translate brazilian c30s006_kat_6fa4c0db:

    # mc "*Laugh* I don't know if that says anything good about you. You just married me."
    mc "*Risos* Não sei se isso diz algo de bom sobre você. Você acabou de se casar comigo."

# game/scripts/c30/c30.rpy:3009
translate brazilian c30s006_kat_eb3948e7:

    # kat "But I'm not the last girl you have to visit today, so the waffle next to the bed will have to wait."
    kat "Mas eu não sou a última garota que você tem que visitar hoje, então o waffle do lado da cama vai ter que esperar."

# game/scripts/c30/c30.rpy:3010
translate brazilian c30s006_kat_05ebc871:

    # mc "That means I have to go with Jamaal again, right?"
    mc "Isso significa que eu tenho que ir com o Jamaal de novo, né?"

# game/scripts/c30/c30.rpy:3011
translate brazilian c30s006_kat_dc1dc22f:

    # kat "Unless you want the next girl to come and kill me, yes."
    kat "A menos que você queira que a próxima garota venha e me mate, sim."

# game/scripts/c30/c30.rpy:3013
translate brazilian c30s006_kat_2dbccd69:

    # "You kiss [kat] again before heading to where Jamaal is waiting for you."
    "Você beija a [kat] de novo antes de ir para onde o Jamaal está te esperando."

# game/scripts/c30/c30.rpy:3015
translate brazilian c30s006_kat_e7501f51:

    # kat "But we have to go see Aunt [bet] and [mee], so the waffle next to the bed will have to wait."
    kat "Mas a gente tem que ir ver a tia [bet] e a [mee], então o waffle do lado da cama vai ter que esperar."

# game/scripts/c30/c30.rpy:3016
translate brazilian c30s006_kat_5d9f46bf:

    # mc "That means this ends here for now, right?"
    mc "Isso significa que a gente para por aqui por enquanto, né?"

# game/scripts/c30/c30.rpy:3017
translate brazilian c30s006_kat_36a8567e:

    # kat "Unless you want two old ladies to come and kill me, yeah."
    kat "A menos que você queira que duas velhas venham me matar, sim."

# game/scripts/c30/c30.rpy:3021
translate brazilian c30s006_kat_57bf7dac:

    # "You kiss [kat] again before heading to where the party is."
    "Você beija a [kat] de novo antes de ir para onde a festa está."

# game/scripts/c30/c30.rpy:3022
translate brazilian c30s006_kat_641410ce:

    # "Knowing that [kat] is already thinking about the wedding night is almost a surprise."
    "Saber que a [kat] já está pensando na noite de núpcias é quase uma surpresa."

# game/scripts/c30/c30.rpy:3023
translate brazilian c30s006_kat_66390b64:

    # "Although having discovered the effect your kisses on her neck have, the surprise is less than it would have been a few days ago."
    "Embora, tendo descoberto o efeito que seus beijos no pescoço dela têm, a surpresa seja menor do que seria há alguns dias."

# game/scripts/c30/c30.rpy:3028
translate brazilian c30s006_sam_ed654bf6:

    # "Jamaal accompanies you to where [sam] is."
    "Jamaal te acompanha até onde a [sam] está."

# game/scripts/c30/c30.rpy:3030
translate brazilian c30s006_sam_a144cab5:

    # jam "She's my mother, so I'll run you over if you do anything stupid."
    jam "Ela é minha mãe, então eu passo por cima de você se fizer alguma merda."

# game/scripts/c30/c30.rpy:3032
translate brazilian c30s006_sam_c804c698:

    # mc "Don't worry. I won't."
    mc "Não se preocupa. Eu não vou."

# game/scripts/c30/c30.rpy:3033
translate brazilian c30s006_sam_ede396d7:

    # mc "But I have a question, is there any order to the girls you're taking me to?"
    mc "Mas eu tenho uma pergunta, tem alguma ordem para as garotas que você tá me levando?"

# game/scripts/c30/c30.rpy:3035
translate brazilian c30s006_sam_7351a00f:

    # jam "I decide the order based on which of them are ready when you come back to me."
    jam "Eu decido a ordem com base em qual delas está pronta quando você volta pra mim."

# game/scripts/c30/c30.rpy:3036
translate brazilian c30s006_sam_d0c0c656:

    # jam "Though some of them have asked for a specific position on the list."
    jam "Embora algumas delas tenham pedido uma posição específica na lista."

# game/scripts/c30/c30.rpy:3039
translate brazilian c30s006_sam_87e8a84c:

    # jam "*Laugh* After my mom, maybe I'll let you pick the next one. Maybe."
    jam "*Risos* Depois da minha mãe, talvez eu deixe você escolher a próxima. Talvez."

# game/scripts/c30/c30.rpy:3040
translate brazilian c30s006_sam_d868b8b4:

    # jam "I promise. If there's more than one girl ready, of course."
    jam "Eu prometo. Se tiver mais de uma garota pronta, é claro."

# game/scripts/c30/c30.rpy:3041
translate brazilian c30s006_sam_75a96f00:

    # jam "*Laugh* I swear I couldn't make my mom wait any longer."
    jam "*Risos* Eu juro que não podia fazer minha mãe esperar mais."

# game/scripts/c30/c30.rpy:3042
translate brazilian c30s006_sam_a99e4942:

    # mc "I get it. She'd ground you and not let you have any pastries for a couple of weeks."
    mc "Eu entendo. Ela te deixaria de castigo e não te daria nenhum doce por algumas semanas."

# game/scripts/c30/c30.rpy:3044
translate brazilian c30s006_sam_866fe3e7:

    # mc "Don't worry. I won't make her wait, even though I don't know what this is all about."
    mc "Não se preocupe. Eu não vou fazê-la esperar, mesmo não sabendo do que se trata tudo isso."

# game/scripts/c30/c30.rpy:3055
translate brazilian c30s006_sam_b637596d:

    # mc "You look gorgeous, [sam.nick]."
    mc "Você está linda, [sam.nick]."

# game/scripts/c30/c30.rpy:3056
translate brazilian c30s006_sam_88596a41:

    # sam "Thanks, [mc]. The occasion called for it."
    sam "Obrigada, [mc]. A ocasião pedia."

# game/scripts/c30/c30.rpy:3058
translate brazilian c30s006_sam_5ae625dc:

    # mc "I'm guessing I'm supposed to see a tattoo, right?"
    mc "Eu imagino que eu deva ver uma tatuagem, certo?"

# game/scripts/c30/c30.rpy:3060
translate brazilian c30s006_sam_61922772:

    # sam "You guess right. It was tough to decide what to get tattooed, though. I feel like I've known you forever."
    sam "Imaginou certo. Mas foi difícil decidir o que tatuar. Sinto como se te conhecesse desde sempre."

# game/scripts/c30/c30.rpy:3061
translate brazilian c30s006_sam_226b0425:

    # mc "I wouldn't know what to pick either. We've been through so much together that..."
    mc "Eu também não saberia o que escolher. Nós passamos por tanta coisa juntos que..."

# game/scripts/c30/c30.rpy:3063
translate brazilian c30s006_sam_73c7a7d6:

    # sam "Exactly. *Laugh* And getting a tattoo of a tub of ointment for your bruises didn't seem right."
    sam "Exatamente. *Risos* E fazer uma tatuagem de um pote de pomada para os seus hematomas não parecia certo."

# game/scripts/c30/c30.rpy:3064
translate brazilian c30s006_sam_ffb0d457:

    # sam "Even though it all started then, your bruises aren't something I want to remember."
    sam "Mesmo que tudo tenha começado lá, seus hematomas não são algo que eu queira lembrar."

# game/scripts/c30/c30.rpy:3065
translate brazilian c30s006_sam_c77936f6:

    # mc "*Laugh* Totally understandable. Surprise me."
    mc "*Risos* Totalmente compreensível. Me surpreenda."

# game/scripts/c30/c30.rpy:3068
translate brazilian c30s006_sam_c79ab70b:

    # mc "What's this about, [sam.nick]? What do you want to talk to me about?"
    mc "Sobre o que é isso, [sam.nick]? Sobre o que você quer falar comigo?"

# game/scripts/c30/c30.rpy:3070
translate brazilian c30s006_sam_d2794059:

    # sam "You know I've known you for what seems like forever..."
    sam "Você sabe que eu te conheço há o que parece ser uma eternidade..."

# game/scripts/c30/c30.rpy:3071
translate brazilian c30s006_sam_9d40879e:

    # mc "I know..."
    mc "Eu sei..."

# game/scripts/c30/c30.rpy:3073
translate brazilian c30s006_sam_1e07a5a5:

    # sam "*Laugh* Okay, that wasn't the right way to start."
    sam "*Risos* Ok, esse não foi o jeito certo de começar."

# game/scripts/c30/c30.rpy:3074
translate brazilian c30s006_sam_dfdae274:

    # sam "I mean we've known each other for many years, but in the last few weeks our relationship has changed a lot."
    sam "Quero dizer, nos conhecemos há muitos anos, mas nas últimas semanas nossa relação mudou muito."

# game/scripts/c30/c30.rpy:3075
translate brazilian c30s006_sam_d699e29d:

    # mc "It's changed for the better, I'd say."
    mc "Mudou para melhor, eu diria."

# game/scripts/c30/c30.rpy:3077
translate brazilian c30s006_sam_144d13e1:

    # sam "Yeah. It's something I couldn't have imagined, but you've brought a new... spark... to my life."
    sam "É. É algo que eu não poderia ter imaginado, mas você trouxe uma nova... faísca... para a minha vida."

# game/scripts/c30/c30.rpy:3079
translate brazilian c30s006_sam_cf4c3dba:

    # sam "I wanted to do something before you left for Aruba."
    sam "Eu queria fazer algo antes de você ir para Aruba."

# game/scripts/c30/c30.rpy:3081
translate brazilian c30s006_sam_47a785e2:

    # sam "The girls in the harem wanted to do something before you left for Aruba."
    sam "As garotas do harém queriam fazer algo antes de você ir para Aruba."

# game/scripts/c30/c30.rpy:3082
translate brazilian c30s006_sam_607dddd4:

    # mc "Do you realize you're beating around the bush without telling me anything?"
    mc "Você percebe que está enrolando sem me dizer nada?"

# game/scripts/c30/c30.rpy:3084
translate brazilian c30s006_sam_92cf1fe1:

    # sam "*Laugh* You're so impatient!"
    sam "*Risos* Você é tão impaciente!"

# game/scripts/c30/c30.rpy:3085
translate brazilian c30s006_sam_206eb73f:

    # mc "*Laugh* No, I'm just curious. You've got me on edge with all this beating around the bush."
    mc "*Risos* Não, eu só estou curioso. Você me deixou ansioso com toda essa enrolação."

# game/scripts/c30/c30.rpy:3087
translate brazilian c30s006_sam_cb939cdd:

    # sam "With these rings, I declare myself your fiancée and your wife."
    sam "Com estes anéis, eu me declaro sua noiva e sua esposa."

# game/scripts/c30/c30.rpy:3089
translate brazilian c30s006_sam_6800f0ac:

    # mc "What? I love it! Though I would've liked to be the one to propose."
    mc "O quê? Eu adorei! Embora eu gostasse de ter sido quem fez o pedido."

# game/scripts/c30/c30.rpy:3091
translate brazilian c30s006_sam_b8126e29:

    # mc "Two rings instead of one? I love it! Though I would've liked to be the one to propose."
    mc "Dois anéis em vez de um? Eu adorei! Embora eu gostasse de ter sido quem fez o pedido."

# game/scripts/c30/c30.rpy:3093
translate brazilian c30s006_sam_8804adcf:

    # sam "Since you weren't asking me to be your fiancée, I had to take the step myself."
    sam "Já que você não estava me pedindo para ser sua noiva, eu mesma tive que dar o primeiro passo."

# game/scripts/c30/c30.rpy:3095
translate brazilian c30s006_sam_13f306ac:

    # sam "And once you told [mar] that she was your wife, the next step was clear."
    sam "E depois que você disse à [mar] que ela era sua esposa, o próximo passo ficou claro."

# game/scripts/c30/c30.rpy:3096
translate brazilian c30s006_sam_39f74a24:

    # mc "I'm glad you took the step. Can I kiss my wife?"
    mc "Fico feliz que você tenha dado esse passo. Posso beijar minha esposa?"

# game/scripts/c30/c30.rpy:3098
translate brazilian c30s006_sam_b85eb229:

    # "You both know that's a rhetorical question. You sealed your fate a long time ago."
    "Vocês dois sabem que é uma pergunta retórica. Você selou seu destino há muito tempo."

# game/scripts/c30/c30.rpy:3099
translate brazilian c30s006_sam_ffda13c6:

    # "The kiss with [sam] tastes slightly different this time. It's the first time you're kissing her as your wife."
    "O beijo com [sam] tem um gosto um pouco diferente dessa vez. É a primeira vez que você a beija como sua esposa."

# game/scripts/c30/c30.rpy:3100
translate brazilian c30s006_sam_3c2af9a5:

    # "Not only does it taste different. It also feels too short when your lips start to part. But that's normal whenever you kiss [sam]."
    "Não só tem um gosto diferente. Também parece curto demais quando seus lábios começam a se separar. Mas isso é normal sempre que você beija [sam]."

# game/scripts/c30/c30.rpy:3110
translate brazilian c30s006_sam_8bbfd658:

    # sam "You know I'll never say I hate my son, and as a rule I don't, but right now..."
    sam "Você sabe que eu nunca diria que odeio meu filho, e como regra eu não odeio, mas agora..."

# game/scripts/c30/c30.rpy:3111
translate brazilian c30s006_sam_d9da0db4:

    # mc "*Laugh* In this case he's just the messenger."
    mc "*Risos* Neste caso, ele é só o mensageiro."

# game/scripts/c30/c30.rpy:3113
translate brazilian c30s006_sam_05dcd112:

    # sam "*Laugh* I know. And it wasn't even his idea, so I won't punish him with no pastries."
    sam "*Risos* Eu sei. E nem foi ideia dele, então não vou puni-lo deixando ele sem doces."

# game/scripts/c30/c30.rpy:3114
translate brazilian c30s006_sam_5695adb9:

    # mc "Your revenge could be really harsh when he brings Anthony home and you only make pastries for him."
    mc "Sua vingança poderia ser bem cruel quando ele trouxer o Anthony pra casa e você fizer doces só pra ele."

# game/scripts/c30/c30.rpy:3115
translate brazilian c30s006_sam_7e5a1b71:

    # sam "*Laugh* You're cruel to my son! But I like the idea..."
    sam "*Risos* Você é cruel com o meu filho! Mas eu gostei da ideia..."

# game/scripts/c30/c30.rpy:3116
translate brazilian c30s006_sam_8f902589:

    # mc "Well, as hard as it is to tear myself away from you, I think it's time for me to go."
    mc "Bom, por mais difícil que seja me desgrudar de você, acho que é hora de ir."

# game/scripts/c30/c30.rpy:3120
translate brazilian c30s006_sam_625c9207:

    # "You share one last kiss... for now."
    "Vocês dão um último beijo... por enquanto."

# game/scripts/c30/c30.rpy:3122
translate brazilian c30s006_sam_5ca2a104:

    # "It's shorter than either of you would like. Neither of you wants to see Jamaal impatient."
    "É mais curto do que qualquer um de vocês gostaria. Nenhum de vocês quer ver o Jamaal impaciente."

# game/scripts/c30/c30.rpy:3124
translate brazilian c30s006_sam_e81c45ad:

    # "It's shorter than either of you would like. You both know they're waiting for you to start the party."
    "É mais curto do que qualquer um de vocês gostaria. Vocês dois sabem que eles estão esperando vocês para começar a festa."

# game/scripts/c30/c30.rpy:3129
translate brazilian c30s006_eri_7ff68955:

    # jam "Well, the next girl is your favorite goth."
    jam "Bom, a próxima garota é a sua gótica favorita."

# game/scripts/c30/c30.rpy:3131
translate brazilian c30s006_eri_97ce6f11:

    # "Jamaal walks you over to where [eri] is."
    "Jamaal te leva até onde a [eri] está."

# game/scripts/c30/c30.rpy:3142
translate brazilian c30s006_eri_348e7084:

    # mc "You look gorgeous, [eri]. And I suppose I have a tattoo to see, right?"
    mc "Você está maravilhosa, [eri]. E eu imagino que tenho uma tatuagem pra ver, né?"

# game/scripts/c30/c30.rpy:3143
translate brazilian c30s006_eri_9814907f:

    # eri "I would have liked to be the first to see your surprised face. It loses a bit of fun this way."
    eri "Eu gostaria de ter sido a primeira a ver sua cara de surpresa. Perde um pouco da graça desse jeito."

# game/scripts/c30/c30.rpy:3144
translate brazilian c30s006_eri_fecc4def:

    # mc "Can I say something before you show me the tattoo?"
    mc "Posso dizer uma coisa antes de você me mostrar a tatuagem?"

# game/scripts/c30/c30.rpy:3147
translate brazilian c30s006_eri_3710895c:

    # mc "Can I say something before whatever you have to tell me?"
    mc "Posso dizer uma coisa antes do que quer que você tenha pra me contar?"

# game/scripts/c30/c30.rpy:3148
translate brazilian c30s006_eri_12700803:

    # eri "Of course."
    eri "Claro."

# game/scripts/c30/c30.rpy:3150
translate brazilian c30s006_eri_276ac219:

    # mc "[eri] Marks, will you marry me?"
    mc "[eri] Marks, você quer casar comigo?"

# game/scripts/c30/c30.rpy:3151
translate brazilian c30s006_eri_39447b64:

    # eri "What? Where did you get that ring from?"
    eri "O quê? De onde você tirou esse anel?"

# game/scripts/c30/c30.rpy:3152
translate brazilian c30s006_eri_40628261:

    # mc "*Laugh* From my pocket. But are you going to answer?"
    mc "*Risos* Do meu bolso. Mas você vai responder?"

# game/scripts/c30/c30.rpy:3153
translate brazilian c30s006_eri_d1610f3e:

    # eri "Of course I will!"
    eri "Claro que sim!"

# game/scripts/c30/c30.rpy:3155
translate brazilian c30s006_eri_4acff324:

    # "You stand up and melt into a kiss that conveys everything needed in a moment like this."
    "Você se levanta e se derrete em um beijo que transmite tudo o que é necessário num momento como este."

# game/scripts/c30/c30.rpy:3156
translate brazilian c30s006_eri_287611f5:

    # "It's not one of those kisses that start on the lips of the mouth and end on other lips. It's not a sexual kiss."
    "Não é um daqueles beijos que começam nos lábios da boca e terminam em outros lábios. Não é um beijo sexual."

# game/scripts/c30/c30.rpy:3157
translate brazilian c30s006_eri_41303dfa:

    # "It's a kiss that conveys all the love you have for each other."
    "É um beijo que transmite todo o amor que vocês sentem um pelo outro."

# game/scripts/c30/c30.rpy:3159
translate brazilian c30s006_eri_c1271ea3:

    # eri "How long have you had this ring?"
    eri "Há quanto tempo você tem esse anel?"

# game/scripts/c30/c30.rpy:3160
translate brazilian c30s006_eri_4ee4a6be:

    # mc "A little over a week. But I haven't found the chance to give it to you."
    mc "Um pouco mais de uma semana. Mas não tinha encontrado a chance de te dar."

# game/scripts/c30/c30.rpy:3161
translate brazilian c30s006_eri_82338b72:

    # mc "I would have given it to you when I went to fix the outlet, but I didn't have it on me that day."
    mc "Eu teria te dado quando fui consertar a tomada, mas não estava com ele naquele dia."

# game/scripts/c30/c30.rpy:3162
translate brazilian c30s006_eri_debe06c5:

    # mc "It hasn't left my pocket since, at least when I have pockets."
    mc "Ele não saiu do meu bolso desde então, pelo menos quando eu tenho bolsos."

# game/scripts/c30/c30.rpy:3164
translate brazilian c30s006_eri_c108c3d2:

    # eri "It's beautiful. It matches the earrings and..."
    eri "É lindo. Combina com os brincos e..."

# game/scripts/c30/c30.rpy:3166
translate brazilian c30s006_eri_bce4a262:

    # eri "*Laugh*"
    eri "*Risos*"

# game/scripts/c30/c30.rpy:3167
translate brazilian c30s006_eri_d4e260c9:

    # mc "What are you laughing at?"
    mc "Do que você está rindo?"

# game/scripts/c30/c30.rpy:3169
translate brazilian c30s006_eri_bd98b8fb:

    # mc "Did you get the earrings tattooed?"
    mc "Você tatuou os brincos?"

# game/scripts/c30/c30.rpy:3171
translate brazilian c30s006_eri_3bada43b:

    # eri "With this triskelion, I declare myself your wife."
    eri "Com este triskelion, eu me declaro sua esposa."

# game/scripts/c30/c30.rpy:3172
translate brazilian c30s006_eri_b7e025d2:

    # eri "I was going to say your fiancée and your wife, but you made me your fiancée with the ring."
    eri "Eu ia dizer sua noiva e sua esposa, mas você me fez sua noiva com o anel."

# game/scripts/c30/c30.rpy:3174
translate brazilian c30s006_eri_16485396:

    # mc "I think you're almost the only one whose tattoo I could've guessed."
    mc "Acho que você é quase a única cuja tatuagem eu poderia ter adivinhado."

# game/scripts/c30/c30.rpy:3175
translate brazilian c30s006_eri_2c81c059:

    # mc "Though I don't know how you knew I was going to give you that ring."
    mc "Embora eu não saiba como você sabia que eu ia te dar aquele anel."

# game/scripts/c30/c30.rpy:3177
translate brazilian c30s006_eri_ca8405a1:

    # mc "What? Had you seen the ring before today? I love it!"
    mc "O quê? Você tinha visto o anel antes de hoje? Eu adorei!"

# game/scripts/c30/c30.rpy:3179
translate brazilian c30s006_eri_7625aac1:

    # eri "It's not exactly the same. The triskelion is smaller on the tattoo than on the ring."
    eri "Não é exatamente igual. O triskelion é menor na tatuagem do que no anel."

# game/scripts/c30/c30.rpy:3180
translate brazilian c30s006_eri_1959a8b0:

    # eri "But when I had to choose a design for the tattoo, I knew exactly what I wanted. The triskelion represents evolution and change."
    eri "Mas quando tive que escolher um desenho para a tatuagem, eu sabia exatamente o que queria. O triskelion representa evolução e mudança."

# game/scripts/c30/c30.rpy:3181
translate brazilian c30s006_eri_84f950af:

    # eri "You've changed me. And I hope that, from now on, we evolve together."
    eri "Você me mudou. E espero que, a partir de agora, nós evoluamos juntos."

# game/scripts/c30/c30.rpy:3182
translate brazilian c30s006_eri_61aeb00b:

    # mc "It's a tattoo that makes a lot of sense. Something with meaning, like all your tattoos."
    mc "É uma tatuagem que faz muito sentido. Algo com significado, como todas as suas tatuagens."

# game/scripts/c30/c30.rpy:3184
translate brazilian c30s006_eri_59bc3fd1:

    # eri "That tattoo is the only one I know I'll never get removed. I wanted it to mean something that's special to us."
    eri "Essa tatuagem é a única que eu sei que nunca vou remover. Eu queria que significasse algo que é especial para nós."

# game/scripts/c30/c30.rpy:3185
translate brazilian c30s006_eri_87d13489:

    # eri "It's not just that it matches the earrings. It's that it represents us."
    eri "Não é só que combina com os brincos. É que isso nos representa."

# game/scripts/c30/c30.rpy:3186
translate brazilian c30s006_eri_954cd86e:

    # mc "Can I kiss my wife? I've kissed my fiancée, but not my wife."
    mc "Posso beijar minha esposa? Já beijei minha noiva, mas não minha esposa."

# game/scripts/c30/c30.rpy:3188
translate brazilian c30s006_eri_5374ecdc:

    # "The girl realizes she's rambling about the tattoo and decides to shut her mouth by pressing her lips against yours."
    "A garota percebe que está tagarelando sobre a tatuagem e decide fechar a boca pressionando os lábios contra os seus."

# game/scripts/c30/c30.rpy:3189
translate brazilian c30s006_eri_ded55c2b:

    # "You both knew you were destined for this since that first kiss that seems so long ago."
    "Vocês dois sabiam que estavam destinados a isso desde aquele primeiro beijo que parece ter sido há tanto tempo."

# game/scripts/c30/c30.rpy:3190
translate brazilian c30s006_eri_bb5e0d25:

    # "This is your first kiss as husband and wife. Obviously, it won't be the last."
    "Este é o primeiro beijo de vocês como marido e mulher. Obviamente, não será o último."

# game/scripts/c30/c30.rpy:3192
translate brazilian c30s006_eri_746022c3:

    # eri "I don't know about you, but to me this kiss tasted... different."
    eri "Não sei você, mas para mim esse beijo teve um gosto... diferente."

# game/scripts/c30/c30.rpy:3193
translate brazilian c30s006_eri_fb6a6b99:

    # mc "I didn't notice any difference. You know that 'girlfriend', 'fiancée', or 'wife' are just labels."
    mc "Não notei nenhuma diferença. Você sabe que 'namorada', 'noiva' ou 'esposa' são apenas rótulos."

# game/scripts/c30/c30.rpy:3194
translate brazilian c30s006_eri_91585782:

    # mc "It hasn't changed how I feel about you at all. I doubt it ever will, except for loving you more every day."
    mc "Isso não mudou em nada o que sinto por você. Duvido que algum dia mude, exceto por te amar mais a cada dia."

# game/scripts/c30/c30.rpy:3196
translate brazilian c30s006_eri_4a8a836f:

    # mc "By the way..."
    mc "A propósito..."

# game/scripts/c30/c30.rpy:3199
translate brazilian c30s006_eri_c2113220:

    # mc "I have no complaints about you getting the tattoo, but... what would have happened if I hadn't wanted you to get any more?"
    mc "Não tenho nenhuma reclamação sobre você ter feito a tatuagem, mas... o que teria acontecido se eu não quisesse que você fizesse mais nenhuma?"

# game/scripts/c30/c30.rpy:3200
translate brazilian c30s006_eri_13f079c0:

    # eri "My skin, my choice. You accepted me with tattoos and one more wasn't going to change anything."
    eri "Minha pele, minha escolha. Você me aceitou com tatuagens e mais uma não ia mudar nada."

# game/scripts/c30/c30.rpy:3201
translate brazilian c30s006_eri_6e5a167b:

    # eri "As long as I didn't tattoo my entire body, I didn't think you'd mind."
    eri "Contanto que eu não tatuasse meu corpo inteiro, achei que você não se importaria."

# game/scripts/c30/c30.rpy:3202
translate brazilian c30s006_eri_cae86b26:

    # mc "I don't mind. At least that one is ours. It has nothing to do with a past where you needed tattoos to support you."
    mc "Eu não me importo. Pelo menos essa é nossa. Não tem nada a ver com um passado onde você precisava de tatuagens para te apoiar."

# game/scripts/c30/c30.rpy:3203
translate brazilian c30s006_eri_d07838cf:

    # mc "Now I'm here to support you with whatever you need."
    mc "Agora eu estou aqui para te apoiar com o que você precisar."

# game/scripts/c30/c30.rpy:3209
translate brazilian c30s006_eri_bf3975b8:

    # eri "And now you're going to have to leave. The next girl is waiting for you, and you don't want to keep her waiting, do you?"
    eri "E agora você vai ter que ir. A próxima garota está esperando por você, e você não quer deixá-la esperando, quer?"

# game/scripts/c30/c30.rpy:3210
translate brazilian c30s006_eri_316092bf:

    # mc "As eager as I am to see her, it sucks that our time ends here."
    mc "Por mais ansioso que eu esteja para vê-la, é uma merda que o nosso tempo acabe aqui."

# game/scripts/c30/c30.rpy:3211
translate brazilian c30s006_eri_3cfa4dd7:

    # eri "Only for now, honey. Come on, go before I have to kiss you again and Jamaal has to come looking for you."
    eri "Só por agora, querido. Vamos, vá antes que eu tenha que te beijar de novo e o Jamaal tenha que vir te procurar."

# game/scripts/c30/c30.rpy:3218
translate brazilian c30s006_emmText_377a1788:

    # emm "We know we'll never be able to get officially married."
    emm "Nós sabemos que nunca poderemos nos casar oficialmente."

# game/scripts/c30/c30.rpy:3220
translate brazilian c30s006_emmText_781ac321:

    # emm "Even if they legalized polygamy, I don't think they'll ever legalize incest..."
    emm "Mesmo que legalizassem a poligamia, não acho que eles algum dia legalizariam o incesto..."

# game/scripts/c30/c30.rpy:3222
translate brazilian c30s006_emmText_0d903297:

    # emm "I don't think they'll ever legalize incest..."
    emm "Não acho que eles algum dia legalizariam o incesto..."

# game/scripts/c30/c30.rpy:3225
translate brazilian c30s006_emmText_32797891:

    # emm "We know we'll never be able to get officially married. I doubt they'll ever legalize polygamy."
    emm "Nós sabemos que nunca poderemos nos casar oficialmente. Duvido que eles algum dia legalizem a poligamia."

# game/scripts/c30/c30.rpy:3227
translate brazilian c30s006_emmText_71ceec68:

    # emm "I wanted to do this before you left for Aruba..."
    emm "Eu queria fazer isso antes de você ir para Aruba..."

# game/scripts/c30/c30.rpy:3232
translate brazilian c30s006_emmMenu_5601e40c:

    # mc "I guess that would be fitting for the situation..."
    mc "Acho que isso seria apropriado para a situação..."

# game/scripts/c30/c30.rpy:3234
translate brazilian c30s006_emmMenu_5f61cbc4:

    # mc "It's the flower that defines you, and since you're so original, it's possible you didn't get a ring tattooed."
    mc "É a flor que te define, e como você é tão original, é possível que não tenha tatuado um anel."

# game/scripts/c30/c30.rpy:3236
translate brazilian c30s006_emmMenu_08192691:

    # mc "It would be a reminder of our night in the woods and the Ferrarini."
    mc "Seria uma lembrança da nossa noite na floresta e da Ferrarini."

