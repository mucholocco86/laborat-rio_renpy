# game/scripts/c17/c17.rpy:3338
translate brazilian c17s003_AmandaLunch_adbc9adf:

    # bet "¡Hush! Esa mujer es muy cariñosa con todo el mundo, tú incluido. Te besa y te abraza a la mínima oportunidad."
    bet "Silêncio! Aquela mulher é muito carinhosa com todos, inclusive com você. Ela te beija e te abraça na menor oportunidade."

# game/scripts/c17/c17.rpy:3339
translate brazilian c17s003_AmandaLunch_1a6b87ff:

    # bet "Te defiende cuando te atacan. Incluso llegando a pelearse con otras mujeres por defenderte."
    bet "Ela te defende quando você é atacado. Chegando ao ponto de brigar com outras mulheres para te defender."

# game/scripts/c17/c17.rpy:3340
