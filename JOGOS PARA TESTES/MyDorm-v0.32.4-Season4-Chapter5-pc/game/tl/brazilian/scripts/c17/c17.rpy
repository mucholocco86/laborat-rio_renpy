# game/scripts/c17/c17.rpy:3895
translate brazilian c17s004_MeganLewd_6133d632:

    # meg "*Risa* ¡Tenemos 23 y 21! No es que me vaya a entrar la menopausia mañana o tú vayas a necesitar viagra."
    meg "*Risos* Temos 23 e 21 anos! Não é como se eu fosse entrar na menopausa amanhã ou que você fosse precisar de Viagra."

# game/scripts/c17/c17.rpy:3896
translate brazilian c17s004_MeganLewd_21dc56fa:

    # mc "*Risa* Espero que no."
    mc "*Risos* Espero que não."

# game/scripts/c17/c17.rpy:3898
translate brazilian c17s004_MeganLewd_5ec5493b:

    # meg "Ahora me debería ir. Me tengo que duchar y vestirme antes de la cena. Entro a trabajar a las 9:00."
    meg "Eu preciso ir agora. Preciso tomar banho e me vestir antes do jantar. Começo a trabalhar às 9h."

# game/scripts/c17/c17.rpy:3899
translate brazilian c17s004_MeganLewd_f8937bfb:

    # mc "¿Quieres que te lleve?"
