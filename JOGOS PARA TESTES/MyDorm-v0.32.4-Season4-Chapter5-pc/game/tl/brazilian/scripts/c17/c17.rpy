# game/scripts/c17/c17.rpy:3254
translate brazilian c17s003_AmandaLunch_def038df:

    # mc "¿Sinceramente? No tengo ni idea de lo que está pasando ni de a qué te refieres."
    mc "Sinceramente? Não faço ideia do que está acontecendo ou do que você está falando."

# game/scripts/c17/c17.rpy:3256
translate brazilian c17s003_AmandaLunch_982f271f:

    # bet "¿Quieres que te dibuje un plano o prefieres ir a ciegas?"
    bet "Você quer que eu faça um plano para você ou prefere ir sem saber nada?"

# game/scripts/c17/c17.rpy:3257
translate brazilian c17s003_AmandaLunch_5e22a342:

    # mc "Una cosa es ir a ciegas, pero ahora voy sin plano, sin linterna, de noche, con los ojos vendados y las manos atadas."
    mc "Ficar cego já é ruim, mas agora estou indo sem mapa, sem lanterna, à noite, com os olhos vendados e as mãos amarradas."

# game/scripts/c17/c17.rpy:3258
translate brazilian c17s003_AmandaLunch_f594e452:

    # bet "Ven conmigo detrás de la isla. Podremos hablar más tranquilos allí."
    bet "Venha comigo para trás da ilha. Lá podemos conversar mais tranquilamente."

# game/scripts/c17/c17.rpy:3260
translate brazilian c17s003_AmandaLunch_2e2d7e07:

    # bet "¿Qué crees que le pasa a Kiara?"
    bet "O que você acha que há de errado com a Kiara?"

# game/scripts/c17/c17.rpy:3261
translate brazilian c17s003_AmandaLunch_0c1070b9:

    # mc "No tengo ni idea. Todo iba genial hasta el día que fuimos a su casa. Con lo que lo único que se me ocurre es que fuera por lo que pasó con Solomon."
    mc "Não faço ideia. Estava tudo indo muito bem até o dia em que fomos à casa dela. Então, a única coisa que consigo imaginar é que tenha sido por causa do que aconteceu com Solomon."

# game/scripts/c17/c17.rpy:3262
translate brazilian c17s003_AmandaLunch_2f111123:

    # bet "Estamos hablando del mismo día en que empezamos los saludos con besos otra vez, ¿no? Culpa mía."
    bet "Estamos falando do mesmo dia em que voltamos a nos cumprimentar com beijos, certo? Foi mal."

# game/scripts/c17/c17.rpy:3263
translate brazilian c17s003_AmandaLunch_00e8602f:

    # mc "Sí, claro. Fue el mismo día."
    mc "Sim, claro. Foi no mesmo dia."

# game/scripts/c17/c17.rpy:3265
translate brazilian c17s003_AmandaLunch_3898f5d9:

    # bet "Después de lo que pasó en la cocina."
