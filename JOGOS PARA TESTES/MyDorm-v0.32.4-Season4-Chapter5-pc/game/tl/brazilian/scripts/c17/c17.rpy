# game/scripts/c17/c17.rpy:3294
translate brazilian c17s003_AmandaLunch_74ec8853:

    # mc "¿Todas? ¿Tú también? *Risa*"
    mc "Todos eles? Você também? *Risos*"

# game/scripts/c17/c17.rpy:3295
translate brazilian c17s003_AmandaLunch_2e83fd20:

