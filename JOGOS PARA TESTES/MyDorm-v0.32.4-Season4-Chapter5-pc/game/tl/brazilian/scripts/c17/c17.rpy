    bet "O que você acha que ele deveria pensar sobre o relacionamento de vocês?"

# game/scripts/c17/c17.rpy:3287
translate brazilian c17s003_AmandaLunch_0fd388f1:

    # bet "¿Y de que, además, estés con su hija?"
    bet "E quanto ao fato de você também estar com a filha dele?"

# game/scripts/c17/c17.rpy:3288
translate brazilian c17s003_AmandaLunch_7758f356:

