# game/scripts/c17/c17.rpy:3347
translate brazilian c17s003_AmandaLunch_be9e9726:

    # bet "Y eres el tipo fuerte, guapo, sexy y adorable que la rescata, la defiende, la abraza y la besa. A quien no le importa la edad de una mujer."
    bet "E você é o cara forte, bonito, sexy e adorável que a resgata, a defende, a abraça e a beija. Aquele que não se importa com a idade da mulher."

# game/scripts/c17/c17.rpy:3348
translate brazilian c17s003_AmandaLunch_9252f8f6:

    # mc "¿Qué? Creo que te equivocas, Betty. Kiara nunca me vería así. Fue ella la que me besó en la cocina. Si se sintiera así no lo habría hecho."
    mc "O quê? Acho que você está enganada, Betty. A Kiara jamais me veria dessa forma. Foi ela quem me beijou na cozinha. Se ela se sentisse assim, não teria feito isso."

# game/scripts/c17/c17.rpy:3350
translate brazilian c17s003_AmandaLunch_a03ce963:

    # bet "Mmmm... tienes razón... a menos que cambiase de opinión cuando te peleaste con su marido. Que se diera cuenta entonces."
    bet "Hum... você tem razão... a menos que ela tenha mudado de ideia quando você discutiu com o marido dela. Ela deve ter percebido isso então."

# game/scripts/c17/c17.rpy:3351
translate brazilian c17s003_AmandaLunch_79ab0ad9:

    # mc "Mmmm... Bueno... ha sido desde entonces que está distante..."
    mc "Hum... Bem... ele tem estado distante desde então..."

# game/scripts/c17/c17.rpy:3353
translate brazilian c17s003_AmandaLunch_6cb9022f:

    # bet "¡Sí! ¡Lo sabía! ¡Soy buenísima en esto!"
    bet "Sim! Eu sabia! Sou muito bom nisso!"

# game/scripts/c17/c17.rpy:3354
translate brazilian c17s003_AmandaLunch_da4fc251:

    # mc "Tengo que hablar con ella."
    mc "Preciso falar com ela."

# game/scripts/c17/c17.rpy:3356
translate brazilian c17s003_AmandaLunch_280c3ff7:

    # bet "Mejor no lo hagas. Dale tiempo para que se aclare las ideas. Para que ella llegue a sus propias conclusiones."
