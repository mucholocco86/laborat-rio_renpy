translate brazilian c17s001_AmandaDinner_22a6892d:

    # kat "Es difícil decir que no lo son cuando podrían pasar por hermanas de [dap], [eri], y [emm]."
    kat "É difícil dizer que não são quando poderiam passar por irmãs de [dap], [eri] e [emm]."

# game/scripts/c17/c17.rpy:806
