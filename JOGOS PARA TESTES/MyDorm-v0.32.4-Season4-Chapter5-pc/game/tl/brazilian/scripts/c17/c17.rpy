# game/scripts/c17/c17.rpy:878
translate brazilian c17s001_AmandaDinner_0aa3b3f1:

    # mc "¿Entiendes ahora por qué me siento orgulloso de esta familia?"
    mc "Agora você entende por que tenho tanto orgulho desta família?"

# game/scripts/c17/c17.rpy:880
translate brazilian c17s001_AmandaDinner_c08287e4:

    # ama "*Sollozo* Tienes razones para estarlo... sois increíbles..."
    ama "*Soluço* Vocês têm todos os motivos para estarem... vocês são todos incríveis..."

# game/scripts/c17/c17.rpy:881
