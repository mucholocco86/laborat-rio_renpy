    mc "Até logo, linda."

# game/scripts/c17/c17.rpy:3910
translate brazilian c17s004_MeganLewd_d09b8796:

    # "Tú también pasas por la ducha y te vistes. Elegante pero informal, tal como han pedido las chicas."
    "Você também toma um banho e se veste. Um estilo casual elegante, exatamente como as meninas pediram."

# game/scripts/c17/c17.rpy:3915
translate brazilian c17s005_EvaDinner_cfceb449:

    # "Justo cuando acabas de vestirte para la cena, suena el teléfono."
    "Assim que você termina de se arrumar para o jantar, o telefone toca."

# game/scripts/c17/c17.rpy:3919
translate brazilian c17s005_EvaDinner_ff21814d:

    # eva "Buenas tardes, [mc]. ¿Ya estás vestido?"
    eva "Boa tarde, [mc]. Você já se vestiu?"

# game/scripts/c17/c17.rpy:3920
translate brazilian c17s005_EvaDinner_57b3dd5c:

    # mc "Hola, Eva. Sí, ¿por qué lo dices?"
    mc "Oi Eva. Sim, por que você diz isso?"

# game/scripts/c17/c17.rpy:3922
translate brazilian c17s005_EvaDinner_60df7410:

    # eva "Te he visto volver del baño y te he dado un tiempo prudencial para vestirte."
    eva "Eu vi você voltando do banheiro e te dei um tempo razoável para se vestir."

# game/scripts/c17/c17.rpy:3923
translate brazilian c17s005_EvaDinner_ac8cef43:

    # eva "No me gusta eso de no saber lo que pasa en las habitaciones y solo poder intuirlo."
    eva "Não gosto de não saber o que está acontecendo nos cômodos e só poder supor."

# game/scripts/c17/c17.rpy:3924
translate brazilian c17s005_EvaDinner_e81afaa5:

    # mc "*Risa* Bienvenida al mundo normal, Eva."
    mc "*Risos* Bem-vinda de volta ao mundo normal, Eva."

# game/scripts/c17/c17.rpy:3925
translate brazilian c17s005_EvaDinner_ba68e24d:

    # mc "¿Puedo ayudarte en algo?"
    mc "Posso te ajudar em alguma coisa?"

# game/scripts/c17/c17.rpy:3927
translate brazilian c17s005_EvaDinner_4a48e36a:

    # eva "Tu no vas a beber alcohol esta noche, ¿verdad?"
    eva "Você não vai beber álcool hoje à noite, vai?"

# game/scripts/c17/c17.rpy:3928
translate brazilian c17s005_EvaDinner_f9806161:

    # eva "En el plan de las chicas, me refiero..."
    eva "Quer dizer, nos planos das garotas..."

# game/scripts/c17/c17.rpy:3929
translate brazilian c17s005_EvaDinner_9bffdd4c:

    # mc "Nadie me ha explicado el plan. Por tu pregunta, supongo que me tocará ser el conductor responsable y no beberé."
    mc "Ninguém me explicou o plano. Pela sua pergunta, presumo que terei que ser o motorista responsável e não beberei."

# game/scripts/c17/c17.rpy:3931
translate brazilian c17s005_EvaDinner_cdef31cc:

    # eva "Contaba con que te tocara conducir."
    eva "Eu contava com você para dirigir."

# game/scripts/c17/c17.rpy:3932
translate brazilian c17s005_EvaDinner_0ff9484a:

    # eva "Yo quiero poder beber, con lo que no quiero coger la furgoneta de Amanda."
    eva "Quero poder beber, então não quero pegar a van da Amanda."

# game/scripts/c17/c17.rpy:3933
translate brazilian c17s005_EvaDinner_b6967b68:

    # mc "Lo entiendo..."
    mc "Eu entendo..."

# game/scripts/c17/c17.rpy:3935
translate brazilian c17s005_EvaDinner_6d0ba27e:

    # eva "¿Podrías venir a buscarme como hiciste ayer con Amanda?"
    eva "Você poderia vir me buscar, assim como fez ontem com a Amanda?"

# game/scripts/c17/c17.rpy:3936
translate brazilian c17s005_EvaDinner_dba2a35a:

    # mc "Por supuesto. ¿Cuándo quieres que vaya a buscarte?"
    mc "Claro. Quando você quer que eu vá te buscar?"

# game/scripts/c17/c17.rpy:3937
translate brazilian c17s005_EvaDinner_0dceb9b1:

    # mc "La cena empieza en media hora y eres la invitada de honor de hoy."
    mc "O jantar começa em meia hora e você é o convidado de honra desta noite."

# game/scripts/c17/c17.rpy:3939
translate brazilian c17s005_EvaDinner_3dcaa388:

    # eva "¡Yay! Sal dentro de diez minutos de tu casa."
    eva "Eba! Saia de casa em dez minutos."

# game/scripts/c17/c17.rpy:3940
translate brazilian c17s005_EvaDinner_6e777d20:

    # eva "Aún me tengo que secar el pelo y vestirme. Pero soy mucho más rápida que [emm]."
    eva "Ainda preciso secar o cabelo e me vestir. Mas sou muito mais rápida que [emm]."

# game/scripts/c17/c17.rpy:3941
translate brazilian c17s005_EvaDinner_7da0ed9e:

    # eva "En veinte minutos estaré lista. Cuando llegues entra en mi habitación, la puerta por la que me fui anoche."
