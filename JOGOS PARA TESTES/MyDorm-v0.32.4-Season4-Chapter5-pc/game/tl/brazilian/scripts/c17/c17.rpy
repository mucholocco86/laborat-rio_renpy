    # cat "¡Miau! (¡Vamos! ¡Entrad! ¡Que me vea en toda mi gloria!)"
    cat "Miau! (Vamos lá! Entre! Deixe-o me ver em toda a minha glória!)"

# game/scripts/c17/c17.rpy:2579
translate brazilian c17s002_ZeusArrival_bc8da879:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Eu não esperava que fôssemos para o quarto tão cedo, mas... Zeus insiste."

# game/scripts/c17/c17.rpy:2581
translate brazilian c17s002_ZeusArrival_e74ede7b:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Eu não imaginava que você quisesse que fôssemos para o quarto tão cedo, mas se Zeus insiste..."

# game/scripts/c17/c17.rpy:2583
translate brazilian c17s002_ZeusArrival_a7b673c1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Eu não pretendia te levar para o quarto tão cedo, mas Zeus insiste. E eu também."

# game/scripts/c17/c17.rpy:2586
translate brazilian c17s002_ZeusArrival_bc8da879_1:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Eu não esperava que fôssemos para o quarto tão cedo, mas... Zeus insiste."

# game/scripts/c17/c17.rpy:2588
translate brazilian c17s002_ZeusArrival_e74ede7b_1:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Eu não imaginava que você quisesse que fôssemos para o quarto tão cedo, mas se Zeus insiste..."

# game/scripts/c17/c17.rpy:2590
translate brazilian c17s002_ZeusArrival_a7b673c1_1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Eu não pretendia te levar para o quarto tão cedo, mas Zeus insiste. E eu também."

# game/scripts/c17/c17.rpy:2591
translate brazilian c17s002_ZeusArrival_27c93be3:

    # mc "Mejor no llevarle la contraria, entonces."
    mc "É melhor não contradizê-lo, então."

# game/scripts/c17/c17.rpy:2593
translate brazilian c17s002_ZeusArrival_dbc10c1d:

    # mc "¡Wow, Maddie! ¡No sabía que pintabas! Parece un templo dedicado a Zeus."
    mc "Nossa, Maddie! Eu não sabia que você pintava! Parece um templo dedicado a Zeus."

# game/scripts/c17/c17.rpy:2595
translate brazilian c17s002_ZeusArrival_8a744446:

    # zeu "¡Miau! (¿Sólo lo parece? Maddie, vas a tener que esforzarte más.)"
    zeu "Miau! (Parece só que sim? Maddie, você vai ter que se esforçar mais.)"

# game/scripts/c17/c17.rpy:2596
translate brazilian c17s002_ZeusArrival_a0536e0b:

    # mad "Solo pinto como hobby. Esa es la pared de la fantasía. Gírate."
    mad "Pinto apenas como hobby. Essa é a parede da fantasia. Vire-se."

# game/scripts/c17/c17.rpy:2598
translate brazilian c17s002_ZeusArrival_f26c6b98:

    # mc "*Risa* Me encantan todas, pero especialmente la del rockero."
    mc "*Risos* Eu adoro todos, mas especialmente o do roqueiro."

# game/scripts/c17/c17.rpy:2599
translate brazilian c17s002_ZeusArrival_22c4f4c3:

    # mad "Me divertí mucho pintando esa. Y la que está como un tigre, la pinté el día que lo adopté."
    mad "Me diverti muito pintando aquele. E aquele que parece um tigre, eu pintei no dia em que o adotei."

# game/scripts/c17/c17.rpy:2601
translate brazilian c17s002_ZeusArrival_0fd1a789:

    # zeu "¡Miau! (Ahí estaba yo, apuntando maneras y siendo fiero.)"
    zeu "Miau! (Lá estava eu, mostrando minhas verdadeiras cores e sendo feroz.)"

# game/scripts/c17/c17.rpy:2616
translate brazilian c17s002_ZeusArrival_4ec8d291:

    # mc "¿Y ese cuadro? ¿Es en lo que estás trabajando ahora?"
    mc "E aquela pintura? É nela que você está trabalhando agora?"

# game/scripts/c17/c17.rpy:2618
translate brazilian c17s002_ZeusArrival_7344a38d:

    # zeu "¡Miau! (¡Super-michi!)"
    zeu "Miau! (Supergatinho!)"

# game/scripts/c17/c17.rpy:2619
translate brazilian c17s002_ZeusArrival_2ebbe23f:

    # mad "[dap] me dijo que el domingo es su cumpleaños, el de [eri], y el de [emm]."
    mad "[dap] me disse que domingo é o aniversário dele, o aniversário de [eri] e o aniversário de [emm]."

# game/scripts/c17/c17.rpy:2620
translate brazilian c17s002_ZeusArrival_d4b8601b:

    # mad "Le pregunté si le gustaría un cuadro y me dijo que sí. Este es para ella. Decidí hacerles un cuadro para cada una."
    mad "Perguntei a ela se gostaria de uma pintura e ela disse que sim. Esta é para ela. Decidi fazer uma pintura para cada um deles."

# game/scripts/c17/c17.rpy:2622
translate brazilian c17s002_ZeusArrival_36aeb1de:

    # zeu "*Grrr* ¡Miau! (Y con el de [emm] me dieron ganas de cagarme en tu almohada.)"
    zeu "*Grrr* Miau! (E aquele com [emm] me deu vontade de fazer cocô no seu travesseiro.)"

# game/scripts/c17/c17.rpy:2623
translate brazilian c17s002_ZeusArrival_b4a6ec6f:

    # mc "Supongo que te ha invitado a la comida del domingo, ¿no?"
    mc "Imagino que ele tenha te convidado para almoçar no domingo, não é?"

# game/scripts/c17/c17.rpy:2638
translate brazilian c17s002_ZeusArrival_8991d72d:

    # mad "Sí, me dijo que fuera a comer y me quedara para la partida de DnD. ¿Por qué?"
    mad "Sim, ele me disse para ir comer e ficar para o jogo de D&D. Por quê?"

# game/scripts/c17/c17.rpy:2639
translate brazilian c17s002_ZeusArrival_040470f4:

    # mc "Entonces tengo que contarte una cosa. Siéntate, por favor."
    mc "Então preciso lhe dizer algo. Por favor, sente-se."

# game/scripts/c17/c17.rpy:2654
translate brazilian c17s002_ZeusArrival_5f74a1af:

    # "Después de La Clonversación..."
    "Após a conversa sobre a clonagem..."

# game/scripts/c17/c17.rpy:2655
translate brazilian c17s002_ZeusArrival_7863e2a8:

    # mad "Es increíble. Pero me parece que tomáis demasiados riesgos explicándoselo a tanta gente. Yo incluida."
    mad "É incrível. Mas acho que você está correndo muitos riscos ao explicar isso para tanta gente. Inclusive para mim."

# game/scripts/c17/c17.rpy:2672
translate brazilian c17s002_Rom1_4be7d4ea:

    # mc "Bueno... tú y yo aún no hemos hablado de lo que somos, pero creo que vamos hacia algún sitio donde la confianza es indispensable."
    mc "Bem... você e eu ainda não conversamos sobre o que somos, mas acho que estamos caminhando para um lugar onde a confiança é essencial."

# game/scripts/c17/c17.rpy:2674
translate brazilian c17s002_Rom1_df81dc24:

    # mad "Gracias, [mc]. Creo que tenemos muchas cosas de las que hablar... después de que retrasaras la cita..."
    mad "Obrigado, [mc]. Acho que temos muito o que conversar... depois que você adiou a consulta..."

# game/scripts/c17/c17.rpy:2676
translate brazilian c17s002_Rom1_a337f597:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. He pensado que... que era porque intenté chantajearte."
    mad "Por um momento pensei que você quisesse cancelar, em vez de adiar. Pensei... que fosse porque eu tentei te chantagear."

# game/scripts/c17/c17.rpy:2677
translate brazilian c17s002_Rom1_535d5ef9:

    # mad "He empezado a montarme películas en mi mente diciéndome que la había cagado por intentarlo... que quizás lo habías pensado mejor y no querías estar conmigo..."
    mad "Comecei a imaginar coisas na minha cabeça, dizendo a mim mesma que estraguei tudo ao tentar... que talvez você tivesse mudado de ideia e não quisesse mais ficar comigo..."

# game/scripts/c17/c17.rpy:2678
translate brazilian c17s002_Rom1_0e471ac5:

    # mc "No, Maddie. Empezamos esto de una forma que no me gustó, pero me está gustando a dónde va."
    mc "Não, Maddie. Começamos isso de um jeito que eu não gostei, mas estou gostando de como está ficando."

# game/scripts/c17/c17.rpy:2680
translate brazilian c17s002_Rom1_e27df326:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. Que no querías que nos viéramos."
    mad "Por um momento pensei que você queria cancelar, em vez de adiar. Que você não queria que nos víssemos."

# game/scripts/c17/c17.rpy:2681
translate brazilian c17s002_Rom1_425bf1d8:

    # mc "No, Maddie. Cuando fui a comprarte el disfraz, no tenía intención de empezar nada contigo, pero ahora me está gustando a dónde va esto."
    mc "Não, Maddie. Quando fui comprar a fantasia para você, não tinha a intenção de começar nada com você, mas agora estou gostando para onde isso está indo."

# game/scripts/c17/c17.rpy:2682
translate brazilian c17s002_Rom1_1af405b2:

    # mc "Y creo que es el momento de comprobarlo, ¿no?"
    mc "E eu acho que está na hora de descobrir, não acha?"

# game/scripts/c17/c17.rpy:2685
translate brazilian c17s002_Sub1_f1949ecd:

    # mc "Bueno, no creo que mi gatita vaya a hacer nada que me perjudique. A mí o a mi familia."
    mc "Bem, não acho que meu gatinho vá fazer nada para me prejudicar ou à minha família."

# game/scripts/c17/c17.rpy:2686
translate brazilian c17s002_Sub1_76b2116f:

    # mc "Sabes que espié a [mar] en el probador y has guardado el secreto. No por voluntad propia, pero lo has hecho."
    mc "Você sabe que eu espionei [mar] no provador e você manteve segredo. Não de propósito, mas manteve."

# game/scripts/c17/c17.rpy:2687
translate brazilian c17s002_Sub1_94622999:

    # mc "Y no creo que lo revelaras aunque te liberase de sea lo que sea lo que es esto."
    mc "E eu não acho que você revelaria isso, mesmo que te libertasse disso, seja lá o que for."

# game/scripts/c17/c17.rpy:2689
translate brazilian c17s002_Sub1_b864f71d:

    # mad "Nunca haría algo que os perjudique. Cuando has llamado para retrasar la cita... por un momento he pensado que querías cancelarla."
    mad "Eu jamais faria algo para te prejudicar. Quando você ligou para adiar a consulta... por um instante pensei que você quisesse cancelá-la."

# game/scripts/c17/c17.rpy:2690
translate brazilian c17s002_Sub1_95b557c6:

    # mad "El corazón me ha dado un vuelco y he descubierto que me gusta lo que tenemos. Que quiero más."
    mad "Meu coração deu um salto, e percebi que gosto do que temos. Que quero mais."

# game/scripts/c17/c17.rpy:2691
translate brazilian c17s002_Sub1_b4c822bc:

    # mad "Me acabas de llamar gatita y he notado mariposas en el estómago. Quiero ser tu gatita, [mc]. Me gusta sentirme indefensa en tus brazos."
    mad "Você me chamou de gatinha e eu senti um frio na barriga. Quero ser sua gatinha, [mc]. Gosto de me sentir indefesa em seus braços."

# game/scripts/c17/c17.rpy:2692
translate brazilian c17s002_Sub1_d82d413c:

    # mc "Eres mi gatita, pero no consiste en que estés indefensa. Consiste en que nos lo pasemos bien los dos, no sólo yo."
    mc "Você é meu gatinho, mas isso não significa que você seja indefeso. Significa que nós dois nos divertimos, não só eu."

# game/scripts/c17/c17.rpy:2693
translate brazilian c17s002_Sub1_efdb86d5:

    # mc "Y creo que es el momento de empezar a hacerlo."
    mc "E acho que está na hora de começar a fazer isso."

# game/scripts/c17/c17.rpy:2696
translate brazilian c17s002_Dom1_28ef5b11:

    # mc "Creo que es algo que debes saber. Sabes que espié a [mar] en el probador y has guardado el secreto."
    mc "Acho que é algo que você deveria saber. Você sabe que eu espionei [mar] no provador e você manteve segredo."

# game/scripts/c17/c17.rpy:2697
translate brazilian c17s002_Dom1_4258d6c5:

    # mc "Forzándome a esta relación, pero lo has hecho."
    mc "Você me obrigou a entrar nesse relacionamento, mas você conseguiu."

# game/scripts/c17/c17.rpy:2698
translate brazilian c17s002_Dom1_4c56a055:

    # mc "Y estoy seguro de que, si dejásemos esta relación, seguirías guardándolo."
    mc "E tenho certeza de que, mesmo se terminássemos esse relacionamento, você ainda o manteria."

# game/scripts/c17/c17.rpy:2700
translate brazilian c17s002_Dom1_eb23b7db:

    # mad "No tengo intención de hacer nada que te perjudique. Si acabarais todos en prisión me quedaría sin mi juguete."
    mad "Não tenho intenção nenhuma de fazer mal a vocês. Se todos vocês acabassem na prisão, eu ficaria sem meu brinquedo."

# game/scripts/c17/c17.rpy:2701
translate brazilian c17s002_Dom1_b7b1e079:

    # mad "Y sí, puedo guardar los secretos que sean necesarios. Me gusta tenerte. Poseerte. ¿Quién sabe si algún día algo más?"
    mad "E sim, posso guardar todos os segredos necessários. Gosto de ter você. De possuir você. Quem sabe, talvez um dia algo mais?"

# game/scripts/c17/c17.rpy:2702
translate brazilian c17s002_Dom1_939762a1:

    # mad "Cuándo has llamado para retrasar la cita por un momento he pensado en qué haría si, en vez de retrasarla, la quisieras cancelar."
    mad "Quando você ligou para adiar a consulta, por um instante me perguntei o que eu faria se, em vez de adiá-la, você quisesse cancelá-la."

# game/scripts/c17/c17.rpy:2703
translate brazilian c17s002_Dom1_a9161cd3:

    # mad "¿Contarle el secreto a [mar] o no? He decidido que no lo haría. Quiero que seas mi juguete, pero quiero que lo seas por voluntad propia, no porque te sientas obligado."
    mad "Devo contar o segredo para [mar] ou não? Decidi que não. Quero que você seja meu brinquedo, mas quero que você esteja disposto, não porque se sinta obrigado."

# game/scripts/c17/c17.rpy:2704
translate brazilian c17s002_Dom1_eb3149a8:

    # mc "Un día, cuando esté autorizado para hacerlo, te contaré otro secreto. Uno que te demostrará que, si estoy aquí, es porque quiero."
    mc "Um dia, quando eu tiver autorização para isso, contarei outro segredo. Um que provará que, se estou aqui, é porque quero estar."

# game/scripts/c17/c17.rpy:2706
translate brazilian c17s002_Dom1_c018a585:

    # mad "Pues, como premio por ello y por la confianza, y sabiendo que te gusta, te voy a permitir de nuevo que me comas. Lo hiciste muy bien el otro día."
    mad "Bem, como recompensa por isso e pela sua confiança, e sabendo que você gosta, vou deixar você me comer de novo. Você se saiu muito bem outro dia."

# game/scripts/c17/c17.rpy:2707
translate brazilian c17s002_Dom1_d0ff99b0:

    # mc "Como mi ama desee. Déjame que te libere de ese mono."
    mc "Como minha senhora deseja. Deixe-me libertá-lo desse macaco."

# game/scripts/c17/c17.rpy:2730
translate brazilian c17s003_DapScaTests_4a7fcb5a:

    # centered "{size=+20}{b}DÍA 19 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}DIA 19 – SÁBADO{/b}{/size}"

# game/scripts/c17/c17.rpy:2734
translate brazilian c17s003_DapScaTests_2d236d61:

    # "Después de desayunar coges un par de tests de embarazo y vas a la habitación de [dap] y Scarlett."
    "Após o café da manhã, você pega alguns testes de gravidez e vai para o quarto de Scarlett."

# game/scripts/c17/c17.rpy:2736
translate brazilian c17s003_DapScaTests_786f9ea0:

    # "Después de desayunar coges un test de embarazo y vas a la habitación de [dap] y Scarlett."
    "Após o café da manhã, você faz um teste de gravidez e vai para o quarto de Scarlett."

# game/scripts/c17/c17.rpy:2738
translate brazilian c17s003_DapScaTests_a1f6b6b6:

    # "También llevas el test de ADN que Amanda te dio ayer. No sabes cuál de los tests tienes más ganas de que salga positivo."
    "Você também tem o teste de DNA que a Amanda te aplicou ontem. Você não sabe qual dos dois te deixa mais ansioso para ver dar positivo."

# game/scripts/c17/c17.rpy:2741
translate brazilian c17s003_DapScaTests_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c17/c17.rpy:2742
translate brazilian c17s003_DapScaTests_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "Sou eu. Posso entrar?"

# game/scripts/c17/c17.rpy:2743
translate brazilian c17s003_DapScaTests_7cc88e14:

    # dap "*A través de la puerta* Sí, entra."
    dap "*Pela porta* Sim, entre."

# game/scripts/c17/c17.rpy:2745
translate brazilian c17s003_DapScaTests_8defc866:

    # mc "Buenos días. Ha llegado el vampiro. Saaaangreeee. *Risa*"
    mc "Bom dia. O vampiro chegou. Sangrento! *Risos*"

# game/scripts/c17/c17.rpy:2748
translate brazilian c17s003_DapScaTests_0b787fe4:

    # dap "Buenos días, mi amor."
    dap "Bom dia, meu amor."

# game/scripts/c17/c17.rpy:2749
translate brazilian c17s003_DapScaTests_53d46762:

    # dap "No va a doler, ¿verdad?"
    dap "Não vai doer, vai?"

# game/scripts/c17/c17.rpy:2750
translate brazilian c17s003_DapScaTests_b0f06ca1:

    # mc "Es sólo un pinchazo."
    mc "É apenas um furo."

# game/scripts/c17/c17.rpy:2752
translate brazilian c17s003_DapScaTests_e4fd25d6:

    # dap "Buenos días, [mc]."
    dap "Bom dia, [mc]."

# game/scripts/c17/c17.rpy:2755
translate brazilian c17s003_DapScaTests_4ac57d7f:

    # sca "Buenos días, guapísimo."
    sca "Bom dia, lindo."

# game/scripts/c17/c17.rpy:2756
translate brazilian c17s003_DapScaTests_9a653b5a:

    # sca "Tendremos el resultado mañana a estas horas, ¿no?"
    sca "Teremos o resultado amanhã a esta hora, certo?"

# game/scripts/c17/c17.rpy:2757
translate brazilian c17s003_DapScaTests_402ea49e:

    # mc "Sí. 24 horas para tenerlo."
    mc "Sim. 24 horas para recebê-lo."

# game/scripts/c17/c17.rpy:2760
translate brazilian c17s003_DapScaTests_0dd349a4:

    # dap "Si los dos salieran positivos sería un regalo de cumpleaños perfecto."
    dap "Se ambos os testes derem positivo, será o presente de aniversário perfeito."

# game/scripts/c17/c17.rpy:2761
translate brazilian c17s003_DapScaTests_ea37cb2d:

    # dap "Confirmaríamos que voy a ser madre y tía el día de mi cumpleaños."
    dap "Confirmaremos que serei mãe e tia no meu aniversário."

# game/scripts/c17/c17.rpy:2764
translate brazilian c17s003_DapScaTests_7b1ca3d6:

    # dap "Si os saliera positivo sería un regalo de cumpleaños perfecto. Confirmaríais que voy a ser tía el día de mi cumpleaños."
    dap "Se o seu teste desse positivo, seria o presente de aniversário perfeito. Você confirmaria que vou ser tia no meu aniversário."

# game/scripts/c17/c17.rpy:2767
translate brazilian c17s003_DapScaTests_39666345:

    # sca "Tengo ganas de convertirme en la Tía Scarlett."
    sca "Quero me tornar a Tia Scarlett."

# game/scripts/c17/c17.rpy:2769
translate brazilian c17s003_DapScaTests_ffba44e4:

    # mc "¿Ya os tratáis como hermanas?"
    mc "Vocês já se tratam como irmãs?"

# game/scripts/c17/c17.rpy:2771
translate brazilian c17s003_DapScaTests_049a02bb:

    # dap "¡Por supuesto!" (multiple=2)
    dap "Claro!" (multiple=2)

# game/scripts/c17/c17.rpy:2772
translate brazilian c17s003_DapScaTests_e835f5f0:

    # sca "¿Esperabas algo diferente?" (multiple=2)
    sca "Você esperava algo diferente?" (multiple=2)

# game/scripts/c17/c17.rpy:2773
translate brazilian c17s003_DapScaTests_c3b58748:

    # mc "*Risa* No."
    mc "*Risos* Não."

# game/scripts/c17/c17.rpy:2776
translate brazilian c17s003_DapScaTests_63455027:

    # "Tomas las muestras de sangre y cada una etiqueta su prueba con una pegatina de colores. Las guardáis en un armario, detrás de la ropa de invierno donde nadie lo va a encontrar"
    "Você coleta as amostras de sangue e etiqueta cada uma com um adesivo colorido. Você as guarda em um armário, atrás das roupas de inverno, onde ninguém as encontrará."

# game/scripts/c17/c17.rpy:2778
translate brazilian c17s003_DapScaTests_2fabfc4c:

    # "Tomas las muestras de sangre y guardáis la prueba en un armario, detrás de la ropa de invierno donde nadie lo va a encontrar."
    "Você coleta as amostras de sangue e guarda as evidências em um armário, atrás das roupas de inverno, onde ninguém as encontrará."

# game/scripts/c17/c17.rpy:2781
translate brazilian c17s003_DapScaTests_4b8aa236:

    # sca "Y ahora viene mi prueba de ADN, ¿no? ¿Más sangre?"
    sca "E agora vem o meu teste de DNA, certo? Mais sangue?"

# game/scripts/c17/c17.rpy:2782
translate brazilian c17s003_DapScaTests_a69a9b84:

    # mc "No, en este caso es sólo frotar con un hisopo en la parte interior de la mejilla."
    mc "Não, neste caso é apenas esfregar com um cotonete na parte interna da bochecha."

# game/scripts/c17/c17.rpy:2784
translate brazilian c17s003_DapScaTests_0db9aefc:

    # dap "Tienes que estar super emocionada. Después de haberte dado por vencida, encontrar esa nueva pista tiene que haber sido increíble."
