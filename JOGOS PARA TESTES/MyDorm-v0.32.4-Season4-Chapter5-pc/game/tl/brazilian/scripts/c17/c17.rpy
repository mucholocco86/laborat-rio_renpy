    lis "Anthony e eu... exatamente como eu te disse... eu não me imaginava com alguém como ele... eu não sentia nada quando estava com ele."

# game/scripts/c17/c17.rpy:638
translate brazilian c17s001_AmandaDinner_e151f395:

    # lis "Ayer estuvimos hablando y... a él le pasa lo mismo... hemos decidido romper nuestra \"no relación\"."
    lis "Estávamos conversando ontem e... ele sente o mesmo... decidimos terminar nosso \"não-relacionamento\"."

# game/scripts/c17/c17.rpy:640
translate brazilian c17s001_AmandaDinner_8050236d:

    # lis "Creo que ninguno de los dos quería hablar de ello para no hacerle daño al otro... pero los dos queríamos dejar de hacer lo que estábamos haciendo."
    lis "Acho que nenhum de nós queria falar sobre isso para não magoar o outro... mas ambos queríamos parar de fazer o que estávamos fazendo."

# game/scripts/c17/c17.rpy:641
translate brazilian c17s001_AmandaDinner_adcf19fa:

    # lis "Hemos decidido seguir siendo amigos, pero no vamos a intentar ser algo más."
    lis "Decidimos continuar amigos, mas não vamos tentar ser nada além disso."

# game/scripts/c17/c17.rpy:642
translate brazilian c17s001_AmandaDinner_a6572655:

    # mc "¿Te das cuenta como sí era importante? Nunca dudes en contarme algo que te preocupe, Lisa."
    mc "Você tem noção da importância disso? Não hesite em me contar qualquer coisa que esteja te incomodando, Lisa."

# game/scripts/c17/c17.rpy:645
translate brazilian c17s001_AmandaDinner_761952b8:

    # lis "De todas formas... a los dos... nos gustan otras personas, con lo que creo que es lo mejor, de todas formas."
    lis "Enfim... nós dois... gostamos de outras pessoas, então acho que é o melhor a se fazer, de qualquer forma."

# game/scripts/c17/c17.rpy:646
translate brazilian c17s001_AmandaDinner_3c46c38b:

    # mc "¿Alguien que has conocido desde que has llegado?"
    mc "Você conheceu alguém desde que chegou?"

# game/scripts/c17/c17.rpy:647
translate brazilian c17s001_AmandaDinner_424a2793:

    # lis "Sí..."
    lis "Sim..."

# game/scripts/c17/c17.rpy:648
translate brazilian c17s001_AmandaDinner_c6f9a0e0:

    # mc "¡Eso es fantástico, Lisa! ¡Nos lo tienes que presentar!"
    mc "Que fantástico, Lisa! Você tem que nos apresentar a ele!"

# game/scripts/c17/c17.rpy:650
translate brazilian c17s001_AmandaDinner_ab24fcb8:

    # lis "Sí, un día te diré quién es..."
    lis "Sim, um dia eu te direi quem é..."

# game/scripts/c17/c17.rpy:651
translate brazilian c17s001_AmandaDinner_c4ea5ac7:

    # deb "Sobre eso..."
    deb "Sobre isso..."

# game/scripts/c17/c17.rpy:654
translate brazilian c17s001_AmandaDinner_b6ff0358:

    # lis "De todas formas... a él... le gusta otra persona, con lo que creo que es lo mejor, de todas formas."
    lis "Enfim... ele... gosta de outra pessoa, então acho que é melhor assim."

# game/scripts/c17/c17.rpy:657
translate brazilian c17s001_AmandaDinner_c4ea5ac7_1:

    # deb "Sobre eso..."
    deb "Sobre isso..."

# game/scripts/c17/c17.rpy:659
translate brazilian c17s001_AmandaDinner_1a01d9d4:

    # deb "Ahora que estamos aquí los tres... podríamos... ya sabes..."
    deb "Agora que nós três estamos aqui... nós poderíamos... você sabe..."

# game/scripts/c17/c17.rpy:660
translate brazilian c17s001_AmandaDinner_0afb7e3a:

    # mc "Si quieres, sí. Es tu decisión a quién y cuándo decírselo."
    mc "Se você quiser, sim. A decisão de para quem contar e quando é sua."

# game/scripts/c17/c17.rpy:662
translate brazilian c17s001_AmandaDinner_4f85dc05:

    # deb "Lisa, tengo... tenemos algo que contarte..."
    deb "Lisa, eu... nós temos algo para te contar..."

# game/scripts/c17/c17.rpy:663
translate brazilian c17s001_AmandaDinner_7bb6c65d:

    # deb "[mc] y yo estamos... más o menos... saliendo juntos..."
    deb "[mc] e eu estamos... meio que... namorando..."

# game/scripts/c17/c17.rpy:665
translate brazilian c17s001_AmandaDinner_680cc806:

    # lis "¿Qué? ¿Desde cuándo? ¿Qué es eso de más o menos?"
    lis "O quê? Desde quando? Do que se trata isso, mais ou menos?"

# game/scripts/c17/c17.rpy:666
translate brazilian c17s001_AmandaDinner_7b8b768a:

    # mc "Aún no hemos hablado de como llamarlo, pero podríamos decir que esta mañana hemos decidido empezar algo y ver a donde nos lleva."
    mc "Ainda não discutimos o nome, mas podemos dizer que esta manhã decidimos começar algo e ver aonde isso nos leva."

# game/scripts/c17/c17.rpy:668
translate brazilian c17s001_AmandaDinner_5bf69428:

    # lis "¡Es fantástico, Debbie! Nunca hubiera pensado que tendrías novio antes que yo, pero... ¡me alegro muchísimo!"
    lis "Que fantástico, Debbie! Eu jamais imaginaria que você teria um namorado antes de mim, mas... estou muito feliz por você!"

# game/scripts/c17/c17.rpy:669
translate brazilian c17s001_AmandaDinner_306d345f:

    # deb "Gracias, Lisa... no ha empezado como me había imaginado, pero el resultado ha sido mejor aún."
    deb "Obrigada, Lisa... não começou como eu tinha imaginado, mas o resultado foi ainda melhor."

# game/scripts/c17/c17.rpy:670
translate brazilian c17s001_AmandaDinner_705d0f7a:

    # mc "Te debo una cita de verdad. *Risa*"
    mc "Te devo um encontro de verdade. *Risos*"

# game/scripts/c17/c17.rpy:672
translate brazilian c17s001_AmandaDinner_c697845d:

    # lis "Y tú... más vale que la cuides y no le hagas daño o te las tendrás que ver conmigo."
    lis "E você... é melhor cuidar dela e não machucá-la, ou terá que se ver comigo."

# game/scripts/c17/c17.rpy:673
translate brazilian c17s001_AmandaDinner_0b5289d3:

    # mc "No tengo intención de hacerle daño, Lisa. No soy así."
    mc "Não quero te magoar, Lisa. Não sou assim."

# game/scripts/c17/c17.rpy:675
translate brazilian c17s001_AmandaDinner_332f72ad:

    # lis "Me lo tenéis que contar todo. Lo estáis rodeando de misterio."
    lis "Você tem que me contar tudo. Você está envolvendo tudo em mistério."

# game/scripts/c17/c17.rpy:676
translate brazilian c17s001_AmandaDinner_a647d546:

    # mc "No sé si aquí y ahora es el mejor momento para hacerlo."
    mc "Não sei se agora é o melhor momento para fazer isso."

# game/scripts/c17/c17.rpy:677
translate brazilian c17s001_AmandaDinner_1e767339:

    # deb "Creo que no, pero deberíamos volver con Amanda, estar un ratito... y, si quieres, volvemos pronto a la habitación y te lo cuento todo... si a [mc] no le importa."
    deb "Acho que não, mas devemos voltar para a casa da Amanda, passar um tempo juntos... e, se você quiser, podemos voltar para o quarto daqui a pouco e eu te conto tudo... se [mc] não se importar."

# game/scripts/c17/c17.rpy:678
translate brazilian c17s001_AmandaDinner_1b330c2e:

    # mc "Adelante, Debbie. Creo que es una conversación entre hermanas en la que no debo estar. Además, yo voy a tenerlo más complicado para desaparecer."
    mc "Pode falar, Debbie. Acho que é uma conversa entre irmãs da qual eu não deveria participar. Além disso, vai dificultar meu desaparecimento."

# game/scripts/c17/c17.rpy:679
translate brazilian c17s001_AmandaDinner_ba0f8eb1:

    # mc "Tengo que llevar de nuevo a Amanda a su base cuando acabe la cena."
    mc "Preciso levar Amanda de volta à base dela quando o jantar terminar."

# game/scripts/c17/c17.rpy:681
translate brazilian c17s001_AmandaDinner_79214577:

    # lis "Genial, volvamos dentro. Tengo ganas de que me lo expliques todo."
    lis "Ótimo, vamos voltar para dentro. Estou ansioso para que você me explique tudo."

# game/scripts/c17/c17.rpy:682
translate brazilian c17s001_AmandaDinner_71c1f7d2:

    # deb "Deberás tener un poco de paciencia. No nos vamos a ir inmediatamente."
    deb "Você precisará ter paciência. Não partiremos imediatamente."

# game/scripts/c17/c17.rpy:683
translate brazilian c17s001_AmandaDinner_9c641d1e:

    # lis "Pero cuánto antes volvamos, antes nos podremos ir a nuestra habitación, ¿no?"
    lis "Mas quanto mais cedo voltarmos, mais cedo poderemos ir para o nosso quarto, certo?"

# game/scripts/c17/c17.rpy:684
translate brazilian c17s001_AmandaDinner_44d08f66:

    # deb "Vaaale, vamos."
    deb "Certo, vamos lá."

# game/scripts/c17/c17.rpy:686
translate brazilian c17s001_AmandaDinner_77b0ad79:

    # deb "Hasta luego, [mc]. Te buscaré para mi beso de buenas noches antes de irnos."
    deb "Até logo, [mc]. Vou te encontrar para um beijo de boa noite antes de irmos."

# game/scripts/c17/c17.rpy:687
translate brazilian c17s001_AmandaDinner_3a65cc3e:

    # mc "Lo estaré esperando."
    mc "Estarei aguardando."

# game/scripts/c17/c17.rpy:689
translate brazilian c17s001_AmandaDinner_007d0f29:

    # lis "Yo también vendré a buscar el mío... si Debbie me deja hacerlo, claro."
    lis "Eu também irei buscar o meu... se a Debbie deixar, é claro."

# game/scripts/c17/c17.rpy:690
translate brazilian c17s001_AmandaDinner_c2caae19:

    # deb "No hay ningún problema en que te bese, ¿verdad?"
    deb "Não tem problema nenhum em eu te beijar, tem?"

# game/scripts/c17/c17.rpy:691
translate brazilian c17s001_AmandaDinner_91c9ce2b:

    # mc "No, Debbie. Que tú y yo hayamos empezado algo, no significa que tengamos que eliminar las buenas costumbres."
    mc "Não, Debbie. Só porque você e eu começamos algo não significa que precisamos nos livrar de bons hábitos."

# game/scripts/c17/c17.rpy:694
translate brazilian c17s001_AmandaDinner_e1992981:

    # deb "[emm] tenía razón, te cuesta pillar algunas cosas. *Risita*"
    deb "[emm] Eu estava certo, você tem dificuldade para entender algumas coisas. *Risos*"

# game/scripts/c17/c17.rpy:695
translate brazilian c17s001_AmandaDinner_2dba3c8c:

    # deb "Lisa, deberíamos entrar y seguir charlando con Amanda un rato. Hoy quiero acostarme pronto."
    deb "Lisa, devemos entrar e conversar mais um pouco com a Amanda. Quero ir para a cama cedo hoje."

# game/scripts/c17/c17.rpy:697
translate brazilian c17s001_AmandaDinner_1f1f5279:

    # deb "Hasta luego, [mc]."
    deb "Até logo, [mc]."

# game/scripts/c17/c17.rpy:698
translate brazilian c17s001_AmandaDinner_322b093a:

    # lis "Nos vemos dentro."
    lis "Te vejo lá dentro."

# game/scripts/c17/c17.rpy:699
translate brazilian c17s001_AmandaDinner_eb026555:

    # mc "Hasta ahora, chicas."
    mc "Até agora, meninas."

# game/scripts/c17/c17.rpy:708
translate brazilian c17s001_AmandaDinner_5b9cba8d:

    # "Al volver a la cocina ves como Amanda te hace señas para que vayas a una zona sin gente."
    "Ao retornar para a cozinha, você vê Amanda fazendo sinal para que você vá para uma área sem pessoas."

# game/scripts/c17/c17.rpy:710
translate brazilian c17s001_AmandaDinner_792c3b3e:

    # mc "¿Qué tal te lo estás pasando?"
    mc "Como você está se divertindo?"

# game/scripts/c17/c17.rpy:711
translate brazilian c17s001_AmandaDinner_c78f6326:

    # ama "¡Ufff! Es mejor de lo que me había dicho Eva. Es como sentirse parte de algo."
    ama "Uau! É ainda melhor do que a Eva me disse. É como sentir que pertenço a algum lugar."

# game/scripts/c17/c17.rpy:712
translate brazilian c17s001_AmandaDinner_a1731fc8:

    # mc "Y sólo es el primer día que vienes. Espera a que vayan cogiendo confianza."
    mc "E este é apenas o seu primeiro dia aqui. Espere só até que eles comecem a se sentir à vontade."

# game/scripts/c17/c17.rpy:714
translate brazilian c17s001_AmandaDinner_e7d6eaab:

    # ama "Eva ya me había advertido. Hay un componente de sentirse un animal exhibido. Todo el mundo quiere saber cosas de nosotras."
    ama "Eva já tinha me avisado. Existe um certo sentimento de estar em exibição como um animal. Todo mundo quer saber coisas sobre nós."

# game/scripts/c17/c17.rpy:715
translate brazilian c17s001_AmandaDinner_0cd3e20a:

    # ama "Pero supongo que en un par de días se les pasará. Pese a todo es un momento increíble."
    ama "Mas imagino que eles vão superar isso em alguns dias. Mesmo assim, é um momento incrível."

# game/scripts/c17/c17.rpy:716
translate brazilian c17s001_AmandaDinner_76951022:

    # mc "Olvídalo. Siempre querremos saber más cosas de vosotras."
    mc "Esqueça. Sempre vamos querer saber mais sobre você."

# game/scripts/c17/c17.rpy:717
translate brazilian c17s001_AmandaDinner_b822f1af:

    # mc "Por cierto, saluda a Eva. Supongo que nos está oyendo por el auricular."
    mc "Aliás, mande um abraço para a Eva. Imagino que ela esteja nos ouvindo pelo fone de ouvido."

# game/scripts/c17/c17.rpy:719
translate brazilian c17s001_AmandaDinner_9fbd07d6:

    # ama "No... si nos está oyendo, será a través de los micrófonos de la cocina, pero no llevo auricular hoy."
    ama "Não... se ele estiver ouvindo, será pelos microfones da cozinha, mas hoje não estou usando fones de ouvido."

# game/scripts/c17/c17.rpy:720
translate brazilian c17s001_AmandaDinner_b3961c59:

    # mc "¿Por qué?"
    mc "Porque?"

# game/scripts/c17/c17.rpy:722
translate brazilian c17s001_AmandaDinner_8cfdf610:

    # ama "Quería... quería que esta experiencia fuera solo mía."
    ama "Eu queria... eu queria que essa experiência fosse só para mim."

# game/scripts/c17/c17.rpy:723
translate brazilian c17s001_AmandaDinner_14aeb48f:

    # ama "Sé que puede sonar ridículo, pero Eva y yo hemos vivido toda nuestra vida juntas. Todas nuestras experiencias han sido compartidas."
    ama "Sei que pode parecer ridículo, mas Eva e eu vivemos nossas vidas inteiras juntas. Compartilhamos todas as nossas experiências."

# game/scripts/c17/c17.rpy:724
translate brazilian c17s001_AmandaDinner_63276cde:

    # ama "La quiero con locura, no me malinterpretes, pero a veces librarse de tu hermana siamesa... es bueno. Raro, pero bueno."
    ama "Eu a amo demais, não me entenda mal, mas às vezes se livrar de uma irmã gêmea siamesa... é uma coisa boa. Estranho, mas bom."

# game/scripts/c17/c17.rpy:725
translate brazilian c17s001_AmandaDinner_b5e78b15:

    # mc "¿Todas vuestras experiencias?"
    mc "Todas as suas experiências?"

# game/scripts/c17/c17.rpy:727
translate brazilian c17s001_AmandaDinner_b73b3ebe:

    # ama "¡[mc]! Hay cosas que no se le preguntan a una dama. *Risa*"
    ama "[mc]! Há certas coisas que simplesmente não se perguntam a uma dama. *Risos*"

# game/scripts/c17/c17.rpy:728
translate brazilian c17s001_AmandaDinner_b5c30716:

    # mc "¿Qué? ¡No! No me refería a eso... sea lo que sea a lo que te refieras tú."
    mc "O quê? Não! Eu não quis dizer isso... seja lá o que você esteja se referindo."

# game/scripts/c17/c17.rpy:730
translate brazilian c17s001_AmandaDinner_6cc01880:

    # ama "No te preocupes. *Risita* Hoy me han preguntado cosas muy raras, y no me hubiera sorprendido si alguna de ellas me hubiera preguntado si Eva y yo éramos pareja."
    ama "Não se preocupe. *Risos* Me fizeram umas perguntas bem estranhas hoje, e eu não teria ficado surpresa se uma delas tivesse perguntado se eu e a Eva éramos um casal."

# game/scripts/c17/c17.rpy:731
translate brazilian c17s001_AmandaDinner_a3db9a7f:

    # mc "¿Qué?"
    mc "Que?"

# game/scripts/c17/c17.rpy:733
translate brazilian c17s001_AmandaDinner_d46a3163:

    # ama "¿Qué? ¡No! ¡No me refería a que lo fuéramos! ¡No lo somos! ¡A mí me gustan los hombres! Y ya sabes que a Eva también."
    ama "O quê? Não! Eu não quis dizer que éramos! Nós não somos! Eu gosto de homens! E você sabe que a Eva também gosta."

# game/scripts/c17/c17.rpy:734
translate brazilian c17s001_AmandaDinner_5c22c4b3:

    # mc "*Risa* Sí, lo sé. Lo de esta mañana ha sido un poco alucinante. \"Me caías mal, pero estás bueno y te iba a echar un polvo aunque eso jodiera tu relación con [eri]\"."
    mc "*Risos* É, eu sei. O que aconteceu hoje de manhã foi meio louco. \"Eu não gostava de você, mas você é gostosa e eu ia transar com você mesmo que isso atrapalhasse seu relacionamento com [eri].\""

# game/scripts/c17/c17.rpy:736
translate brazilian c17s001_AmandaDinner_f7a2d5c7:

    # ama "Mi hermana puede ser tan impulsiva como la tuya. Y puede pensar lo mismo en las consecuencias de sus actos. Es decir, nada."
    ama "Minha irmã pode ser tão impulsiva quanto a sua. E ela pode pensar o mesmo sobre as consequências de seus atos. Ou seja, que não pensa de forma alguma."

# game/scripts/c17/c17.rpy:737
translate brazilian c17s001_AmandaDinner_e40f181d:

    # mc "Lo estoy descubriendo... hablando de la Princesa Rosa..."
    mc "Estou descobrindo... falando sobre a Princesa Rosa..."

# game/scripts/c17/c17.rpy:739
translate brazilian c17s001_AmandaDinner_e9557bbb:

    # emm "¿Hablabais de mí? He oído la palabra \"hermana\"... Y estando aquí mis dos hermanos, sólo podía ser yo."
    emm "Você estava falando de mim? Eu ouvi a palavra \"irmã\"... E com meus dois irmãos aqui, só poderia ser eu."

# game/scripts/c17/c17.rpy:740
translate brazilian c17s001_AmandaDinner_f4b864c5:

    # mcp "(Dos hermanos... me encanta cómo en un par de horas todo el mundo considera a Amanda familia. Lo mismo que ha pasado con Eva.)"
    mcp "(Dois irmãos... Adoro como em poucas horas todos consideram Amanda como da família. A mesma coisa aconteceu com Eva.)"

# game/scripts/c17/c17.rpy:741
translate brazilian c17s001_AmandaDinner_2f56586e:

    # mc "Sí, hablábamos de lo mucho que os parecéis..."
    mc "Sim, estávamos falando sobre o quanto vocês dois se parecem..."

# game/scripts/c17/c17.rpy:743
translate brazilian c17s001_AmandaDinner_3a19ad23:

    # emm "Es normal, ¿no? Al fin y al cabo llevamos los mismos genes."
    emm "É normal, não é? Afinal, temos os mesmos genes."

# game/scripts/c17/c17.rpy:744
translate brazilian c17s001_AmandaDinner_cb95c762:

    # ama "... de lo mucho que os parecéis Eva y tú."
    ama "...porque você e a Eva se parecem muito."

# game/scripts/c17/c17.rpy:746
translate brazilian c17s001_AmandaDinner_70e95e06:

    # emm "¡Es verdad! ¡Le he dicho a [mc] que Eva me recordaba a alguien! ¡A mí!"
    emm "É verdade! Eu disse para [mc] que a Eva me lembrava alguém! Eu mesma!"

# game/scripts/c17/c17.rpy:748
translate brazilian c17s001_AmandaDinner_8234382e:

    # emm "También le he dicho que es fantástica... lo cual me convierte a mí también en fantástica, ¿no?"
    emm "Eu também já disse a ela que ela é fantástica... o que me torna fantástico também, não é?"

# game/scripts/c17/c17.rpy:749
translate brazilian c17s001_AmandaDinner_53383284:

    # mc "Sí, [emm], eres fantástica. *Risa*"
    mc "Sim, [emm], você é fantástico. *Risos*"

# game/scripts/c17/c17.rpy:751
translate brazilian c17s001_AmandaDinner_23d0b31b:

    # emm "¡Y el resto de las chicas también lo han dicho! No sólo fantástica, pero otras cosas bonitas también. ¡Eso significa que también piensan lo mismo de mí!"
    emm "E as outras meninas disseram a mesma coisa! Não só \"fantástico\", mas também outras coisas boas. Isso significa que elas pensam o mesmo de mim!"

# game/scripts/c17/c17.rpy:752
translate brazilian c17s001_AmandaDinner_74f00f8f:

    # mc "*Risa* Bueno... quizás..."
    mc "*Risos* Bem... talvez..."

# game/scripts/c17/c17.rpy:753
translate brazilian c17s001_AmandaDinner_34a1f259:

    # ama "Sí, estoy segura de que piensan eso de ti."
    ama "Sim, tenho certeza que eles pensam isso de você."

# game/scripts/c17/c17.rpy:755
translate brazilian c17s001_AmandaDinner_86ec97d1:

    # emm "¡Claro! ¡Tú has oído todas nuestras conversaciones! Me tienes que contar todo lo que han dicho de mí."
    emm "Claro! Você ouviu todas as nossas conversas! Você tem que me contar tudo o que eles disseram sobre mim."

# game/scripts/c17/c17.rpy:756
translate brazilian c17s001_AmandaDinner_c95ab1c9:

    # ama "Pero eso significaría que también les debería contar al resto lo que han dicho de ellas. Sería lo justo, ¿no?"
    ama "Mas isso significaria que eu também deveria contar aos outros o que disseram sobre eles. Seria justo, não seria?"

# game/scripts/c17/c17.rpy:758
translate brazilian c17s001_AmandaDinner_0ec6e7c6:

    # emm "Mmmm... entonces mejor no... Esta mañana he dicho cosas muy feas de mi madre..."
    emm "Hum... então provavelmente é melhor não... Eu disse coisas muito desagradáveis sobre minha mãe esta manhã..."

# game/scripts/c17/c17.rpy:760
translate brazilian c17s001_AmandaDinner_2abc6e1b:

    # emm "Pero bueno, os dejo un rato. ¡Voy a decirle a las chicas que me han estado alabando cuando alababan a Eva!"
    emm "Bem, vou deixar vocês por um instante. Vou contar para as meninas que andaram me elogiando que, na verdade, estavam elogiando a Eva!"

# game/scripts/c17/c17.rpy:761
translate brazilian c17s001_AmandaDinner_99af6d99:

    # mc "¡[emm]!"
    mc "[emm]!"

# game/scripts/c17/c17.rpy:763
