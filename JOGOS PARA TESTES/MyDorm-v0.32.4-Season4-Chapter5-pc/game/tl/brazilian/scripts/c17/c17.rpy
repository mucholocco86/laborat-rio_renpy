# game/scripts/c17/c17.rpy:1165
translate brazilian c17s001_EileenPregnancyResult_f4f5be91:

    # mc "Tu test está en ese cajón, Eileen. Ve a por él. ¿Nerviosa?"
    mc "Sua prova está naquela gaveta, Eileen. Vá buscá-la. Nervosa?"

# game/scripts/c17/c17.rpy:1166
translate brazilian c17s001_EileenPregnancyResult_3fd9b16e:

    # eil "Un poco. Llevo días pensando y tengo ganas de que salga positivo."
    eil "Um pouco. Venho pensando nisso há dias e espero que o resultado seja positivo."

# game/scripts/c17/c17.rpy:1167
translate brazilian c17s001_EileenPregnancyResult_f41f1e7a:

    # mc "Yo también. Pero solo hay una forma de saberlo. Ve a por él."
    mc "Eu também. Mas só há uma maneira de descobrir. Vá em frente."

# game/scripts/c17/c17.rpy:1169
translate brazilian c17s001_EileenPregnancyResult_a20cefa7:

    # "..."
    "..."

# game/scripts/c17/c17.rpy:1173
translate brazilian c17s001_EileenPregnancyResult_3b9e7786:

    # eil "¡Dos verdes! ¡Positivo! ¡Vamos a ser padres!"
    eil "Dois verdes! Positivo! Vamos ser pais!"

# game/scripts/c17/c17.rpy:1174
translate brazilian c17s001_EileenPregnancyResult_d79bac75:

    # mc "¡Ven aquí, Mami!"
    mc "Vem cá, mamãe!"

# game/scripts/c17/c17.rpy:1176
translate brazilian c17s001_EileenPregnancyResult_3fb99fd3:

    # "Os fundís en un abrazo lleno de alegría y de esperanza en que todo vaya bien durante el embarazo."
    "Você se entrega a um abraço repleto de alegria e esperança de que tudo corra bem durante a gravidez."

# game/scripts/c17/c17.rpy:1179
translate brazilian c17s001_EileenPregnancyResult_06d6d71c:

    # eil "Verde y rojo... negativo..."
    eil "Verde e vermelho... negativo..."

# game/scripts/c17/c17.rpy:1180
translate brazilian c17s001_EileenPregnancyResult_227230f0:

    # mc "Lo siento, Eile."
    mc "Sinto muito, Eile."

# game/scripts/c17/c17.rpy:1181
translate brazilian c17s001_EileenPregnancyResult_19545459:

    # eil "No pasa nada, cielo. No suele ser el sueño de todas las chicas quedarse embarazada con 21. Y a lo mejor en el columpio lo logramos. Tenemos mucho tiempo."
    eil "Tudo bem, querida. Engravidar aos 21 anos geralmente não é o sonho de toda garota. E talvez a gente consiga no balanço. Temos bastante tempo."

# game/scripts/c17/c17.rpy:1182
translate brazilian c17s001_EileenPregnancyResult_474ffb65:

    # mc "Todo el tiempo del mundo. Ven aquí."
    mc "Todo o tempo do mundo. Venha cá."

# game/scripts/c17/c17.rpy:1184
translate brazilian c17s001_EileenPregnancyResult_10b7d5ca:

    # "Os fundís en un abrazo lleno de esperanza en que el columpio cambie el resultado del siguiente test."
    "Você se entrega a um abraço cheio de esperança de que o balanço mude o resultado do próximo teste."

# game/scripts/c17/c17.rpy:1185
translate brazilian c17s001_EileenPregnancyResult_a77c5a71:

    # "Es un abrazo lleno de caricias y besos. Es bueno saber que estáis juntos en esto."
    "É um abraço cheio de carícias e beijos. É bom saber que vocês estão juntos nessa."

# game/scripts/c17/c17.rpy:1188
translate brazilian c17s001_EileenPregnancyResult_c5b34fc4:

    # mc "¿Vas a poder seguir trabajando ahora que estás embarazada? No sé si va a ser bueno para el bebé que estés tantas horas de pie."
    mc "Você vai conseguir continuar trabalhando agora que está grávida? Não sei se será bom para o bebê você ficar em pé por tantas horas."

# game/scripts/c17/c17.rpy:1189
translate brazilian c17s001_EileenPregnancyResult_9dc4a2e6:

    # eil "No hay ningún problema, [mc]. Hay una camarera en el Triangle Dinner que está embarazada de seis meses y dice que no hay ningún problema."
    eil "Não há problema nenhum. Tem uma garçonete no Triangle Dinner que está grávida de seis meses e diz que não há problema nenhum."

# game/scripts/c17/c17.rpy:1190
translate brazilian c17s001_EileenPregnancyResult_ce8c8e99:

    # mc "¿Has hablado con otras camareras?"
    mc "Você já conversou com outras garçonetes?"

# game/scripts/c17/c17.rpy:1192
translate brazilian c17s001_EileenPregnancyResult_69d24d7b:

    # eil "Claro, tenía que estar preparada, ¿no? Después de tantos días con síntomas, he hablado con todo el mundo que he podido... menos con mi madre"
    eil "É claro que eu tinha que estar preparada, né? Depois de tantos dias com sintomas, falei com todo mundo que eu podia... menos com a minha mãe."

# game/scripts/c17/c17.rpy:1193
translate brazilian c17s001_EileenPregnancyResult_cbb4b3a7:

    # mc "Bueno, quizás con todo lo que está pasando no sea lo mejor, pero es algo que tú sabes mejor que nadie."
    mc "Bem, talvez com tudo o que está acontecendo, não seja a melhor coisa, mas é algo que você conhece melhor do que ninguém."

# game/scripts/c17/c17.rpy:1195
translate brazilian c17s001_EileenPregnancyResult_9bd904a5:

    # eil "Me gustaría decírselo lo antes posible, si no te importa. Y me gustaría que se lo dijéramos juntos."
    eil "Gostaria de lhe contar o mais breve possível, se não se importar. E gostaria que contássemos juntos."

# game/scripts/c17/c17.rpy:1196
translate brazilian c17s001_EileenPregnancyResult_5c4eabf8:

    # mc "¿Mañana por la mañana te va bien que se lo digamos? Hoy va a ser un poco complicado. Al acabar la cena tengo que llevar a Amanda de nuevo a su base."
    mc "Amanhã de manhã seria um bom momento para contar a ela? Hoje vai ser um pouco complicado. Depois do jantar, tenho que levar Amanda de volta à base dela."

# game/scripts/c17/c17.rpy:1197
translate brazilian c17s001_EileenPregnancyResult_6ecaed01:

    # eil "Genial. Mañana se lo contamos. Tengo ganas de ver qué cara pone. ¡Va a ser abuela!"
    eil "Ótimo! Contaremos a ela amanhã. Mal posso esperar para ver o rosto dela. Ela vai ser avó!"

# game/scripts/c17/c17.rpy:1198
translate brazilian c17s001_EileenPregnancyResult_9279e00a:

    # mc "Sobre todo hay que decirle que, esta vez, guarde el secreto. Prefiero que no se le vuelva a escapar como en la cocina el otro día."
    mc "Acima de tudo, preciso dizer a ele para guardar segredo desta vez. Prefiro que ele não deixe escapar de novo como fez na cozinha outro dia."

# game/scripts/c17/c17.rpy:1199
translate brazilian c17s001_EileenPregnancyResult_b330b8ee:

    # eil "Es mala guardando secretos. *Risa* Pero me aseguraré de que este lo guarde."
    eil "Ela é péssima em guardar segredos. *Risos* Mas vou garantir que ela guarde este."

# game/scripts/c17/c17.rpy:1200
translate brazilian c17s001_EileenPregnancyResult_8205f953:

    # eil "Vamos. Tengo ganas de seguir conociendo a Amanda. Es tan diferente a [emm]..."
    eil "Vamos lá. Estou ansiosa para conhecer melhor a Amanda. Ela é tão diferente da [emm]..."

# game/scripts/c17/c17.rpy:1218
translate brazilian c17s001_EileenAlexiaPregnancyResult_02cc94ce:

    # "Al volver a la cocina, Alexia y Eileen, que han llegado mientras estabas con las hermanas, se acercan a ti."
    "Ao retornar para a cozinha, Alexia e Eileen, que chegaram enquanto você estava com as irmãs, se aproximam de você."

# game/scripts/c17/c17.rpy:1220
translate brazilian c17s001_EileenAlexiaPregnancyResult_7626a3bb:

    # oma "Hola, [mc]. Quedas arrestado." (multiple=2)
    oma "Olá, [mc]. Você está preso." (multiple=2)

# game/scripts/c17/c17.rpy:1221
translate brazilian c17s001_EileenAlexiaPregnancyResult_4d594dec:

    # eil "Hay unas... máquinas... que deben haber acabado su proceso." (multiple=2)
    eil "Existem algumas... máquinas... que devem ter terminado seu processo." (multiple=2)

# game/scripts/c17/c17.rpy:1222
translate brazilian c17s001_EileenAlexiaPregnancyResult_03c6eeca:

    # mc "¿Queréis ir ahora? La cena..."
    mc "Você quer ir agora? Jantar..."

# game/scripts/c17/c17.rpy:1224
translate brazilian c17s001_EileenAlexiaPregnancyResult_ae8c83f4:

    # oma "No te preocupes, hemos saludado a todo el mundo y están ocupadas con Amanda."
    oma "Não se preocupe, já cumprimentamos todos e eles estão ocupados com a Amanda."

# game/scripts/c17/c17.rpy:1225
translate brazilian c17s001_EileenAlexiaPregnancyResult_7e3ee87e:

    # eil "Si nos vamos ahora nadie se dará cuenta."
    eil "Se formos embora agora, ninguém vai notar."

# game/scripts/c17/c17.rpy:1226
translate brazilian c17s001_EileenAlexiaPregnancyResult_418d76b4:

    # mc "Vamos entonces."
    mc "Vamos então."

# game/scripts/c17/c17.rpy:1228
translate brazilian c17s001_EileenAlexiaPregnancyResult_e507ed3f:

    # "En tu habitación..."
    "No seu quarto..."

# game/scripts/c17/c17.rpy:1229
translate brazilian c17s001_EileenAlexiaPregnancyResult_885aa4e8:

    # mc "El tuyo está en ese cajón, Alexia. Y el tuyo en el del otro lado de la cama, Eileen."
    mc "O seu está naquela gaveta, Alexia. E o seu está na que está do outro lado da cama, Eileen."

# game/scripts/c17/c17.rpy:1230
translate brazilian c17s001_EileenAlexiaPregnancyResult_f09c18dc:

    # oma "¿Nerviosos?"
    oma "Nervoso?"

# game/scripts/c17/c17.rpy:1231
translate brazilian c17s001_EileenAlexiaPregnancyResult_3fd9b16e:

    # eil "Un poco. Llevo días pensando y tengo ganas de que salga positivo."
    eil "Um pouco. Venho pensando nisso há dias e espero que o resultado seja positivo."

# game/scripts/c17/c17.rpy:1232
translate brazilian c17s001_EileenAlexiaPregnancyResult_04217b12:

    # mc "Yo también. Los dos."
    mc "Eu também. Nós dois."

# game/scripts/c17/c17.rpy:1233
translate brazilian c17s001_EileenAlexiaPregnancyResult_93307345:

    # oma "Yo aún no estoy segura de lo que quiero. Siempre me imaginé teniendo a mi primer hijo a los 30 o así."
    oma "Ainda não tenho certeza do que quero. Sempre imaginei ter meu primeiro filho por volta dos 30 anos."

# game/scripts/c17/c17.rpy:1234
translate brazilian c17s001_EileenAlexiaPregnancyResult_3a96b1e5:

    # mc "Venga, chicas. Solo hay una forma de saberlo."
    mc "Vamos lá, meninas. Só tem um jeito de descobrir."

# game/scripts/c17/c17.rpy:1236
translate brazilian c17s001_EileenAlexiaPregnancyResult_a20cefa7:

    # "..."
    "..."

# game/scripts/c17/c17.rpy:1240
translate brazilian c17s001_EileenAlexiaPregnancyResult_fdb17f59:

    # oma "¡Positivo!"
    oma "Positivo!"

# game/scripts/c17/c17.rpy:1241
translate brazilian c17s001_EileenAlexiaPregnancyResult_f75dde5b:

    # mc "¡Bien! Parece que has descubierto lo que quieres. Ven aquí."
    mc "Ótimo! Parece que você já descobriu o que quer. Venha aqui."

# game/scripts/c17/c17.rpy:1242
translate brazilian c17s001_EileenAlexiaPregnancyResult_e3df2b1e:

    # oma "Lo he descubierto en el momento en que he puesto la mano en el cajón. He descubierto que quería que saliera verde."
    oma "Eu entendi no momento em que coloquei a mão na gaveta. Percebi que queria que saísse verde."

# game/scripts/c17/c17.rpy:1243
translate brazilian c17s001_EileenAlexiaPregnancyResult_8a8db6a9:

    # mc "Ven aquí. Quiero un abrazo de la futura madre."
    mc "Vem cá. Quero um abraço da futura mamãe."

# game/scripts/c17/c17.rpy:1246
translate brazilian c17s001_EileenAlexiaPregnancyResult_c82831ca:

    # oma "Negativo..."
    oma "Negativo..."

# game/scripts/c17/c17.rpy:1247
translate brazilian c17s001_EileenAlexiaPregnancyResult_9df83427:

    # mc "Oh, Alexia, lo siento..."
    mc "Oh, Alexia, me desculpe..."

# game/scripts/c17/c17.rpy:1248
translate brazilian c17s001_EileenAlexiaPregnancyResult_df158eee:

    # oma "No te preocupes, he descubierto que quería que saliera verde en el momento en que he puesto la mano en el cajón. Pero tendremos más oportunidades."
    oma "Não se preocupe, eu já sabia que queria que saísse verde assim que abri a gaveta. Mas teremos outras chances."

# game/scripts/c17/c17.rpy:1249
translate brazilian c17s001_EileenAlexiaPregnancyResult_7aca4657:

    # mc "Ven aquí. Quiero un abrazo de la futura madre, aunque tardes un poco más."
    mc "Venha cá. Quero um abraço da futura mamãe, mesmo que demore um pouco mais."

# game/scripts/c17/c17.rpy:1250
translate brazilian c17s001_EileenAlexiaPregnancyResult_29ac8c91:

    # mc "Eileen, ¿qué ha salido en el tuyo?"
    mc "Eileen, o que apareceu no seu?"

# game/scripts/c17/c17.rpy:1252
translate brazilian c17s001_EileenAlexiaPregnancyResult_a20cefa7_1:

    # "..."
    "..."

# game/scripts/c17/c17.rpy:1256
translate brazilian c17s001_EileenAlexiaPregnancyResult_3b9e7786:

    # eil "¡Dos verdes! ¡Positivo! ¡Vamos a ser padres!"
    eil "Dois verdes! Positivo! Vamos ser pais!"

# game/scripts/c17/c17.rpy:1257
translate brazilian c17s001_EileenAlexiaPregnancyResult_d79bac75:

    # mc "¡Ven aquí, Mami!"
    mc "Vem cá, mamãe!"

# game/scripts/c17/c17.rpy:1260
translate brazilian c17s001_EileenAlexiaPregnancyResult_06d6d71c:

    # eil "Verde y rojo... negativo..."
    eil "Verde e vermelho... negativo..."

# game/scripts/c17/c17.rpy:1261
translate brazilian c17s001_EileenAlexiaPregnancyResult_227230f0:

    # mc "Lo siento, Eile."
    mc "Sinto muito, Eile."

# game/scripts/c17/c17.rpy:1262
translate brazilian c17s001_EileenAlexiaPregnancyResult_19545459:

    # eil "No pasa nada, cielo. No suele ser el sueño de todas las chicas quedarse embarazada con 21. Y a lo mejor en el columpio lo logramos. Tenemos mucho tiempo."
    eil "Tudo bem, querida. Engravidar aos 21 anos geralmente não é o sonho de toda garota. E talvez a gente consiga no balanço. Temos bastante tempo."

# game/scripts/c17/c17.rpy:1263
translate brazilian c17s001_EileenAlexiaPregnancyResult_474ffb65:

    # mc "Todo el tiempo del mundo. Ven aquí."
    mc "Todo o tempo do mundo. Venha cá."

# game/scripts/c17/c17.rpy:1265
translate brazilian c17s001_EileenAlexiaPregnancyResult_42683e07:

    # "Los tres os fundís en un abrazo lleno de esperanza por lo que está por llegar."
    "Vocês três se abraçam, cheios de esperança pelo que está por vir."

# game/scripts/c17/c17.rpy:1267
translate brazilian c17s001_EileenAlexiaPregnancyResult_2677047f:

    # "Os felicitáis mutuamente en un extraño baile de besos y abrazos. Parece ser que esos críos acaban de ganar una tía inesperada."
    "Vocês se cumprimentam numa estranha dança de beijos e abraços. Parece que aquelas crianças acabaram de ganhar uma tia inesperada."

# game/scripts/c17/c17.rpy:1268
translate brazilian c17s001_EileenAlexiaPregnancyResult_6c749d40:

    # "Puedes notar que les ha hecho ilusión quedarse embarazadas a la vez."
    "Dá para perceber que ambas estavam animadas para engravidar ao mesmo tempo."

# game/scripts/c17/c17.rpy:1270
translate brazilian c17s001_EileenAlexiaPregnancyResult_4d4140cb:

    # "Os felicitáis y consoláis mutuamente en un extraño baile de besos y abrazos. Un positivo y un negativo te dejan un sabor agridulce."
    "Vocês se felicitam e se consolam numa estranha dança de beijos e abraços. Um resultado positivo e um negativo deixam um gosto agridoce."

# game/scripts/c17/c17.rpy:1271
translate brazilian c17s001_EileenAlexiaPregnancyResult_251206e5:

    # "Pero parece ser que este crío acaba de ganar una tía inesperada. También hay esperanza en que en breve el segundo test salga positivo."
    "Mas parece que essa criança ganhou uma tia inesperada. Há também esperança de que o segundo teste dê positivo em breve."

# game/scripts/c17/c17.rpy:1272
translate brazilian c17s001_EileenAlexiaPregnancyResult_dab1d7e1:

    # "Puedes notar que les hubiera hecho ilusión quedarse embarazadas a la vez."
    "Dá para perceber que elas adorariam ter engravidado ao mesmo tempo."

# game/scripts/c17/c17.rpy:1274
translate brazilian c17s001_EileenAlexiaPregnancyResult_76dc3fb8:

    # "Os consoláis mutuamente en un extraño baile de besos y abrazos. Dos negativos simultáneos te dejan un sabor amargo en la boca."
    "Vocês se consolam mutuamente numa estranha dança de beijos e abraços. Duas negatividades simultâneas deixam um gosto amargo na boca."

# game/scripts/c17/c17.rpy:1275
translate brazilian c17s001_EileenAlexiaPregnancyResult_ba09fb30:

    # "Pero también ayuda a que ellas se consuelen mutuamente. Hay esperanza en que en breve una nueva ronda de tests cambien los resultados."
    "Mas isso também os ajuda a se confortarem mutuamente. Há esperança de que uma nova rodada de testes em breve altere os resultados."

# game/scripts/c17/c17.rpy:1276
translate brazilian c17s001_EileenAlexiaPregnancyResult_f007088a:

    # "Puedes notar que les hubiera hecho ilusión quedarse embarazadas a la vez. Es casi mejor que ninguna lo esté a que solo lo estuviera una."
    "Dá para perceber que elas adorariam ter engravidado ao mesmo tempo. É quase melhor que nenhuma delas esteja grávida do que apenas uma."

# game/scripts/c17/c17.rpy:1277
translate brazilian c17s001_EileenAlexiaPregnancyResult_141e6d9c:

    # "La relación entre Eileen y Alexia se ha ido haciendo más fuerte desde aquel día en el lago. Hay que repetirlo."
    "A relação entre Eileen e Alexia se fortaleceu desde aquele dia no lago. Precisamos repetir a experiência."

# game/scripts/c17/c17.rpy:1279
translate brazilian c17s001_EileenAlexiaPregnancyResult_c8dd4d61:

    # oma "Deberíamos volver a la cena antes de que alguien sospeche de nuestra ausencia."
    oma "Devemos voltar para o jantar antes que alguém suspeite da nossa ausência."

# game/scripts/c17/c17.rpy:1281
translate brazilian c17s001_EileenAlexiaPregnancyResult_3db44a99:

    # oma "¿Cuándo quieres decírselo a la familia? Porque quieres decírselo, ¿verdad?"
    oma "Quando você quer contar para sua família? Porque você quer contar para eles, não é?"

# game/scripts/c17/c17.rpy:1282
translate brazilian c17s001_EileenAlexiaPregnancyResult_c46eb4fa:

    # mc "Por supuesto que quiero decírselo. Pero este fin de semana siempre ha sido especial para [emm], [dap], y [eri]."
    mc "Claro que quero contar para ele. Mas este fim de semana sempre foi especial para [emm], [dap] e [eri]."

# game/scripts/c17/c17.rpy:1283
translate brazilian c17s001_EileenAlexiaPregnancyResult_8713b3b9:

    # mc "La presencia de Eva y Amanda ya les ha robado suficiente protagonismo."
    mc "A presença de Eva e Amanda já roubou a cena o suficiente."

# game/scripts/c17/c17.rpy:1284
translate brazilian c17s001_EileenAlexiaPregnancyResult_99c3ccbb:

    # mc "¿Te importa si dejamos pasar unos días?"
    mc "Você se importaria se esperássemos alguns dias?"

# game/scripts/c17/c17.rpy:1286
translate brazilian c17s001_EileenAlexiaPregnancyResult_dab15a46:

    # mc "A lo mejor podemos hacer el test de Eileen y sale positivo tras el columpio. Lo podemos hacer mañana por la tarde y lo sabríamos el lunes."
    mc "Talvez possamos testar a Eileen, e o resultado pode ser positivo após o balanço. Podemos fazer isso amanhã à tarde e saberemos na segunda-feira."

# game/scripts/c17/c17.rpy:1287
translate brazilian c17s001_EileenAlexiaPregnancyResult_70a743fd:

    # oma "No tengo ningún problema en esperar. No tengo de qué esconderme, pero entiendo lo que dices."
    oma "Não tenho problema nenhum em esperar. Não tenho nada a esconder, mas entendo o que você está dizendo."

# game/scripts/c17/c17.rpy:1289
translate brazilian c17s001_EileenAlexiaPregnancyResult_29f5aed1:

    # mc "Y sobre lo de seguir trabajando..."
    mc "E sobre continuar trabalhando..."

# game/scripts/c17/c17.rpy:1290
translate brazilian c17s001_EileenAlexiaPregnancyResult_ec3fd0d7:

    # oma "No voy a dejar de trabajar, [mc]. Estoy embarazada, no inválida. Y esto es Newport, no Los Angeles. Aquí no hay peligro de meterme en un tiroteo."
    oma "Não vou parar de trabalhar. Estou grávida, não incapacitada. E isto é Newport, não Los Angeles. Não corro o risco de me envolver em um tiroteio aqui."

# game/scripts/c17/c17.rpy:1291
translate brazilian c17s001_EileenAlexiaPregnancyResult_5a9ddc43:

    # oma "Cuando el embarazo esté un poco avanzado, quizás pida hacer trabajo de oficina, pero hasta entonces quiero seguir haciendo vida normal."
    oma "Quando a gravidez estiver um pouco mais avançada, talvez eu peça para trabalhar em um escritório, mas até lá quero continuar levando uma vida normal."

# game/scripts/c17/c17.rpy:1292
translate brazilian c17s001_EileenAlexiaPregnancyResult_edfb7fb5:

    # mc "Okay, si es lo que te parece bien, no voy a llevarte la contraria."
    mc "Certo, se você acha que está tudo bem, não vou contradizê-lo."

# game/scripts/c17/c17.rpy:1295
translate brazilian c17s001_EileenAlexiaPregnancyResult_c5b34fc4:

    # mc "¿Vas a poder seguir trabajando ahora que estás embarazada? No sé si va a ser bueno para el bebé que estés tantas horas de pie."
    mc "Você vai conseguir continuar trabalhando agora que está grávida? Não sei se será bom para o bebê você ficar em pé por tantas horas."

# game/scripts/c17/c17.rpy:1296
