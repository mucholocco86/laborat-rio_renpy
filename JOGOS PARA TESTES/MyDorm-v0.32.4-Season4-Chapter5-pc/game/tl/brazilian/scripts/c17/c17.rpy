    # kia "¡No puede ser! ¿Estás embarazada?"
    kia "Não acredito! Você está grávida?"

# game/scripts/c17/c17.rpy:3070
translate brazilian c17s003_TellKiara_28947d76:

    # eil "Sí, Mamá. Estamos embarazados."
    eil "Sim, mãe. Estamos grávidos."

# game/scripts/c17/c17.rpy:3072
translate brazilian c17s003_TellKiara_a026f41b:

    # kia "¡Felicidades, cielo!"
    kia "Parabéns, querida!"

# game/scripts/c17/c17.rpy:3073
translate brazilian c17s003_TellKiara_9b348af2:

    # eil "Gracias, Mamá. Estamos muy ilusionados."
    eil "Obrigada, mãe. Estamos muito animados."

# game/scripts/c17/c17.rpy:3075
translate brazilian c17s003_TellKiara_608976be:

    # kia "Felicidades a ti también, Papá."
    kia "Parabéns para você também, pai."

# game/scripts/c17/c17.rpy:3076
translate brazilian c17s003_TellKiara_b2a43c7a:

    # mcp "(Ahora entiendo lo de \"más frío que el abrazo de una suegra\".)"
    mcp "(Agora entendi o que significava \"mais frio que um abraço de sogra\".)"

# game/scripts/c17/c17.rpy:3077
translate brazilian c17s003_TellKiara_887f84c9:

    # mc "Gracias, Kiara."
    mc "Obrigada, Kiara."

# game/scripts/c17/c17.rpy:3079
translate brazilian c17s003_TellKiara_c0dccabd:

    # kia "¿Ya habéis pensado en nombres?"
    kia "Você já pensou em nomes?"

# game/scripts/c17/c17.rpy:3081
translate brazilian c17s003_TellKiara_f2bbe5f0:

    # eil "No, aún no pero..."
    eil "Não, ainda não, mas..."

# game/scripts/c17/c17.rpy:3082
translate brazilian c17s003_TellKiara_b9a0ee5e:

    # "A partir de ese momento empieza una larga conversación sobre nombres de bebé, consejos sobre cómo llevar el embarazo, qué hacer y qué no hacer, el trabajo de Eileen..."
    "A partir desse momento, inicia-se uma longa conversa sobre nomes de bebês, conselhos sobre como lidar com a gravidez, o que fazer e o que não fazer, o trabalho de Eileen..."

# game/scripts/c17/c17.rpy:3083
translate brazilian c17s003_TellKiara_cdd77395:

    # "Kiara dice un montón de cosas en las que no habías pensado y otras que con un poco de sentido común cualquiera podría deducir."
    "Kiara diz muitas coisas que você não tinha imaginado, e outras que qualquer um poderia deduzir com um pouco de bom senso."

# game/scripts/c17/c17.rpy:3084
translate brazilian c17s003_TellKiara_5afbf202:

    # "Crees que vas a comprarte un libro de esos sobre bebés."
    "Você acha que vai comprar um daqueles livros sobre bebês."

# game/scripts/c17/c17.rpy:3086
translate brazilian c17s003_TellKiara_8e5da9c6:

    # eil "Deberíamos ir bajando para ayudar con la comida. Amanda tiene que estar a punto de llegar."
    eil "Devemos descer para ajudar com a comida. Amanda deve chegar a qualquer minuto."

# game/scripts/c17/c17.rpy:3087
translate brazilian c17s003_TellKiara_6527cbbe:

    # mc "Podéis quedaros aquí un rato más hablando de esas cosas que no se habla delante del padre. Ya voy yo a ver si necesitan ayuda."
    mc "Você pode ficar aqui mais um pouco conversando sobre aquelas coisas que você não conversa na frente do seu pai. Vou ver se você precisa de alguma ajuda."

# game/scripts/c17/c17.rpy:3089
translate brazilian c17s003_TellKiara_f79ec32b:

    # eil "Vale, mi amor. Te veo abajo en un rato."
    eil "Certo, meu amor. Te vejo lá embaixo daqui a pouco."

# game/scripts/c17/c17.rpy:3090
translate brazilian c17s003_TellKiara_fb559340:

    # mc "Hasta ahora, mi vida. Te quiero."
    mc "Até agora, meu amor. Eu te amo."

# game/scripts/c17/c17.rpy:3091
translate brazilian c17s003_TellKiara_9c439131:

    # eil "Yo también."
    eil "Eu também."

# game/scripts/c17/c17.rpy:3093
translate brazilian c17s003_TellKiara_b0624b53:

    # kia "Si necesitáis ayuda, avisadnos."
    kia "Se precisar de ajuda, avise-nos."

# game/scripts/c17/c17.rpy:3094
translate brazilian c17s003_TellKiara_006e759d:

    # mc "Tranquila, bajad en 20 minutos más o menos."
    mc "Não se preocupe, você estará lá embaixo em cerca de 20 minutos."

# game/scripts/c17/c17.rpy:3137
translate brazilian c17s003_AmandaLunch_a30e4a01:

    # "Cuando llegas a la cocina, ya está casi todo hecho. Ayudas haciendo el all i oli y preparas las bebidas."
    "Ao chegar à cozinha, quase tudo já está pronto. Você ajuda preparando o aioli e as bebidas."

# game/scripts/c17/c17.rpy:3144
translate brazilian c17s003_AmandaLunch_4d213cf7:

    # "Al poco rato llega Amanda. Esta vez ha venido en la moto de Eva."
    "Amanda chega logo depois. Desta vez, ela veio na moto de Eva."

# game/scripts/c17/c17.rpy:3149
translate brazilian c17s003_AmandaLunch_ce547223:

    # ama "No sé si llego demasiado pronto..."
    ama "Não sei se estou chegando cedo demais..."

# game/scripts/c17/c17.rpy:3150
translate brazilian c17s003_AmandaLunch_3c5d873e:

    # mc "No te preocupes. Llegas justo a tiempo."
    mc "Não se preocupe. Você chegou na hora certa."

# game/scripts/c17/c17.rpy:3152
translate brazilian c17s003_AmandaLunch_9e70d621:

    # ama "Buenos días, [mc]."
    ama "Bom dia, [mc]."

# game/scripts/c17/c17.rpy:3153
translate brazilian c17s003_AmandaLunch_194f0505:

    # mc "Buenos días, Amanda. Pasa, te están esperando."
    mc "Bom dia, Amanda. Entre, eles estão esperando por você."

# game/scripts/c17/c17.rpy:3155
translate brazilian c17s003_AmandaLunch_c030015f:

    # "La comida sigue la misma dinámica que la cena, aunque esta vez nadie hace llorar a Amanda."
    "O almoço segue o mesmo padrão do jantar, embora desta vez ninguém faça Amanda chorar."

# game/scripts/c17/c17.rpy:3156
translate brazilian c17s003_AmandaLunch_317792d2:

    # "Echas de menos aquellos días en los que comíais sentados, pero le estás cogiendo el gusto a estas comidas de pie."
    "Você sente falta dos tempos em que comia sentado, mas está se acostumando com essas refeições em pé."

# game/scripts/c17/c17.rpy:3158
translate brazilian c17s003_AmandaLunch_962d0e9f:

    # "Puedes ver que Megan y [mar] tienen una larga conversación entre ellas, apartadas de todo el mundo."
    "É possível ver Megan e [mar] tendo uma longa conversa entre si, longe de todos os outros."

# game/scripts/c17/c17.rpy:3160
translate brazilian c17s003_AmandaLunch_06b98e14:

    # "Amanda pasa más tiempo con las mujeres esta vez. Ayer se retuvieron un poco, pero hoy quieren su ración de la nueva incorporación a la familia."
    "Desta vez, Amanda está passando mais tempo com as mulheres. Ontem elas se mantiveram um pouco mais reservadas, mas hoje querem sua parte da atenção com o novo membro da família."

# game/scripts/c17/c17.rpy:3161
translate brazilian c17s003_AmandaLunch_6a455a9d:

    # "Amanda tardará un poco en dejar de sentirse como un animal exhibido."
    "Vai levar algum tempo para Amanda parar de se sentir como um animal em exibição."

# game/scripts/c17/c17.rpy:3163
translate brazilian c17s003_AmandaLunch_a3ab48a9:

    # "Esta vez las chicas tienen una nueva presa. Megan."
    "Dessa vez, as garotas têm uma nova presa. Megan."

# game/scripts/c17/c17.rpy:3165
translate brazilian c17s003_AmandaLunch_5afeb14d:

    # nor "Amanda nos ha contado las noticias. Ya no corremos peligro."
    nor "Amanda nos deu a notícia. Não estamos mais em perigo."

# game/scripts/c17/c17.rpy:3166
translate brazilian c17s003_AmandaLunch_1ad31beb:

    # mc "Son grandes noticias. Aaron parece estar haciendo un trabajo fantástico."
    mc "Ótima notícia! Parece que Aaron está fazendo um trabalho fantástico."

# game/scripts/c17/c17.rpy:3167
translate brazilian c17s003_AmandaLunch_1709dc65:

    # mc "Aún estoy dudando de si debería aceptar el trabajo en Aruba... eso si no vendemos, claro. No sé si estaré a la altura."
    mc "Ainda estou pensando se devo aceitar o emprego em Aruba... isso se não conseguirmos vender, é claro. Não sei se estarei à altura da tarefa."

# game/scripts/c17/c17.rpy:3169
translate brazilian c17s003_AmandaLunch_9e14d892:

    # nor "[mar] y yo no queremos vender la empresa."
    nor "[mar] e eu não quero vender a empresa."

# game/scripts/c17/c17.rpy:3170
translate brazilian c17s003_AmandaLunch_6a6a997a:

    # nor "Hacerlo significaría que habrá más chicas como Eva y Amanda. Mas niñas como Fiona."
    nor "Fazendo isso, haveria mais garotas como Eva e Amanda. Mais garotas como Fiona."

# game/scripts/c17/c17.rpy:3171
translate brazilian c17s003_AmandaLunch_d1cc2333:

    # mc "Yo también creo que deberíamos mantenerla en manos de la familia."
    mc "Acredito também que devemos manter isso nas mãos da família."

# game/scripts/c17/c17.rpy:3173
translate brazilian c17s003_AmandaLunch_7c22c332:

    # nor "Y cuando te refieres a familia, también te refieres a Eva y a Amanda, ¿no?"
    nor "E quando você se refere à família, você também quer dizer Eva e Amanda, certo?"

# game/scripts/c17/c17.rpy:3174
translate brazilian c17s003_AmandaLunch_6f883578:

    # mc "Para mí, ellas son las principales víctimas de NTR. No sólo ellas. También Aaron y el resto de los clones masculinos. Incluidos los que entraron en casa."
    mc "Na minha opinião, eles são as principais vítimas de NTR. Não só eles, mas também Aaron e o resto dos clones masculinos, incluindo aqueles que invadiram a casa."

# game/scripts/c17/c17.rpy:3175
translate brazilian c17s003_AmandaLunch_9dc882bc:

    # mc "Y, obviamente, ellas son familia. Ya viste cómo se puso Amanda ayer cuando se sintió aceptada. No quiero que nadie les robe eso. Ya le han robado su infancia."
    mc "E, obviamente, eles são família. Você viu como a Amanda reagiu ontem quando se sentiu aceita. Eu não quero que ninguém roube isso deles. Já roubaram a infância deles."

# game/scripts/c17/c17.rpy:3177
translate brazilian c17s003_AmandaLunch_7c4baacf:

    # nor "[dap] y [eri] tampoco quieren vender. Estoy muy orgullosa de ellas."
    nor "[dap] e [eri] também não querem ser vendidos. Estou muito orgulhoso deles."

# game/scripts/c17/c17.rpy:3178
translate brazilian c17s003_AmandaLunch_c934662b:

    # nor "[emm] dice que tiene dudas, pero no ha dicho sobre qué."
    nor "[emm] diz que tem dúvidas, mas não disse sobre quais."

# game/scripts/c17/c17.rpy:3179
translate brazilian c17s003_AmandaLunch_a97a789f:

    # mc "Hablaré con [emm] sobre ello. Ayer ya quería gastarse el dinero en un coche deportivo... rosa."
    mc "Vou falar com [emm] sobre isso. Ontem ele já queria gastar o dinheiro num carro esportivo rosa."

# game/scripts/c17/c17.rpy:3180
translate brazilian c17s003_AmandaLunch_2f1c36fd:

    # mc "Ya sabes que a veces necesita un empujón en la dirección correcta."
    mc "Você sabe que às vezes ele precisa de um empurrãozinho na direção certa."

# game/scripts/c17/c17.rpy:3181
translate brazilian c17s003_AmandaLunch_190da926:

    # mc "Ahora te voy a dejar un momento. Tengo que hablar con Kiara y quiero aprovechar ahora que se ha quedado sola."
    mc "Vou me ausentar por um instante. Preciso falar com a Kiara e quero aproveitar que ela está sozinha agora."

# game/scripts/c17/c17.rpy:3183
translate brazilian c17s003_AmandaLunch_b028b239:

    # nor "Ve. Es casi tan popular como Amanda y Eva. Es difícil que esté sola más de unos minutos. También es novedad, parece mentira que sólo sea su cuarto día en casa."
    nor "Olha só. Ela é quase tão popular quanto Amanda e Eva. É raro vê-la sozinha por mais de alguns minutos. É uma novidade também; é difícil acreditar que este seja apenas o quarto dia dela em casa."

# game/scripts/c17/c17.rpy:3187
translate brazilian c17s003_AmandaLunch_e6e912ec:

    # mc "¿Qué tal, Kiara?"
    mc "Como você está, Kiara?"

# game/scripts/c17/c17.rpy:3189
translate brazilian c17s003_AmandaLunch_1b271947:

    # kia "Muy contenta con las noticias de antes. *Susurrando* Aunque ser abuela me haga sentir vieja."
    kia "Fiquei tão feliz com as notícias de antes. *Sussurrando* Mesmo que ser avó me faça sentir velha."

# game/scripts/c17/c17.rpy:3190
translate brazilian c17s003_AmandaLunch_62e5c781:

    # kia "Y alucinando con lo rápido que se está integrando todo el mundo."
    kia "E estou impressionado com a rapidez com que todos estão se integrando."

# game/scripts/c17/c17.rpy:3192
translate brazilian c17s003_AmandaLunch_933ac119:

    # kia "Alucinando con lo rápido que se está integrando todo el mundo."
    kia "Estou impressionado com a rapidez com que todos estão se integrando."

# game/scripts/c17/c17.rpy:3193
translate brazilian c17s003_AmandaLunch_3737e771:

    # mc "¿Y tú? ¿Qué tal llevas la integración?"
    mc "E você? Como está sendo o processo de integração?"

# game/scripts/c17/c17.rpy:3195
translate brazilian c17s003_AmandaLunch_802b957c:

    # kia "Genial. Me siento muy a gusto aquí, con vosotros."
    kia "Ótimo. Me sinto muito à vontade aqui com todos vocês."

# game/scripts/c17/c17.rpy:3196
translate brazilian c17s003_AmandaLunch_eb881cfe:

    # kia "Te tengo que dejar. Tenía que comentarle algo a Betty."
    kia "Preciso ir. Tinha que contar uma coisa para a Betty."

# game/scripts/c17/c17.rpy:3197
translate brazilian c17s003_AmandaLunch_ec12d61d:

    # mc "¿He hecho algo malo, Kiara?"
    mc "Eu fiz alguma coisa errada, Kiara?"

# game/scripts/c17/c17.rpy:3199
translate brazilian c17s003_AmandaLunch_36159e09:

    # kia "¿Por qué dices eso?"
    kia "Por que você diz isso?"

# game/scripts/c17/c17.rpy:3200
translate brazilian c17s003_AmandaLunch_4c4ce05e:

    # mc "Me da la impresión de que me estás evitando desde hace un par de días."
    mc "Tenho a impressão de que você tem me evitado nos últimos dias."

# game/scripts/c17/c17.rpy:3201
translate brazilian c17s003_AmandaLunch_30fd5f10:

    # kia "No... no te estoy evitando."
    kia "Não... eu não estou te evitando."

# game/scripts/c17/c17.rpy:3202
translate brazilian c17s003_AmandaLunch_d4d39668:

    # mc "¿Entonces qué pasa? Desde que fuimos a tu casa parece que no estás cómoda cuando yo estoy alrededor."
    mc "Então, o que está acontecendo? Desde que fomos à sua casa, você parece desconfortável na minha presença."

# game/scripts/c17/c17.rpy:3204
translate brazilian c17s003_AmandaLunch_e01c898b:

    # mc "¿Es por lo que pasó en la cocina? ¿Por mis relaciones? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Será por causa do que aconteceu na cozinha? Por causa dos meus relacionamentos? Por causa dos beijos? Por causa do que aconteceu na sua casa com o Solomon?"

# game/scripts/c17/c17.rpy:3206
translate brazilian c17s003_AmandaLunch_810f89d7:

    # mc "¿Es porque estoy con Eileen? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Será porque estou com a Eileen? Por causa dos beijos? Por causa do que aconteceu na sua casa com o Solomon?"

# game/scripts/c17/c17.rpy:3208
translate brazilian c17s003_AmandaLunch_5db4f1fd:

    # mc "¿Es por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Será por causa dos beijos? Por causa do que aconteceu na sua casa com Solomon?"

# game/scripts/c17/c17.rpy:3210
translate brazilian c17s003_AmandaLunch_85f5d6ea:

    # kia "No es que esté incómoda a tu alrededor..."
    kia "Não é que eu me sinta desconfortável perto de você..."

# game/scripts/c17/c17.rpy:3211
translate brazilian c17s003_AmandaLunch_e6e4d5d1:

    # kia "No estoy acostumbrada a que nadie, excepto Eileen, me defienda como hiciste tú en casa."
    kia "Não estou acostumada a que alguém, exceto Eileen, me defenda como você fazia em casa."

# game/scripts/c17/c17.rpy:3213
translate brazilian c17s003_AmandaLunch_adcd819b:

    # kia "Por un momento me sentí como se deben sentir las princesas en los cuentos de hadas. Protegida. Segura."
    kia "Por um instante, senti como as princesas dos contos de fadas devem se sentir. Protegidas. Seguras."

# game/scripts/c17/c17.rpy:3219
translate brazilian c17s003_AmandaLunch_4fc78872:

    # kia "Después... cuando nos abrazamos los tres en el parque... me sentí rara."
    kia "Depois... quando nós três nos abraçamos no parque... eu me senti estranho."

# game/scripts/c17/c17.rpy:3220
translate brazilian c17s003_AmandaLunch_d18e63c2:

    # mc "¿Rara? ¿Por qué? Sólo fue un abrazo. Siempre te han gustado mis abrazos."
    mc "Estranho? Por quê? Foi só um abraço. Você sempre gostou dos meus abraços."

# game/scripts/c17/c17.rpy:3222
translate brazilian c17s003_AmandaLunch_963696e9:

    # kia "Si te lo explicara no lo entenderías. Y además me sentiría estúpida explicándotelo."
    kia "Se eu te explicasse, você não entenderia. E além disso, eu me sentiria um idiota explicando isso para você."

# game/scripts/c17/c17.rpy:3223
translate brazilian c17s003_AmandaLunch_bd357dbf:

    # mc "Puedes probar a hacerlo. Hay gente que dice que no soy tan tonto como parezco."
    mc "Você pode tentar. Algumas pessoas dizem que eu não sou tão burro quanto pareço."

# game/scripts/c17/c17.rpy:3224
translate brazilian c17s003_AmandaLunch_ffbec445:

    # kia "No es eso. Pero no te preocupes. No es que hayas hecho nada... malo."
    kia "Não é isso. Mas não se preocupe. Não é como se você tivesse feito algo... errado."

# game/scripts/c17/c17.rpy:3226
translate brazilian c17s003_AmandaLunch_820442c5:

    # "Kiara empieza a comprobar la cocina, claramente buscando a alguien con quien hablar para librarse de ti."
    "Kiara começa a vasculhar a cozinha, claramente procurando alguém com quem possa conversar para se livrar de você."

# game/scripts/c17/c17.rpy:3228
translate brazilian c17s003_AmandaLunch_c1437193:

    # kia "Debería ir a hablar con..."
    kia "Eu deveria ir conversar com..."

# game/scripts/c17/c17.rpy:3230
translate brazilian c17s003_AmandaLunch_a636911b:

    # mc "Ve con Betty si tienes que ir, pero no huyas de mí, por favor. No huyas de nosotros."
    mc "Vá com a Betty se precisar, mas não fuja de mim, por favor. Não fuja de nós."

# game/scripts/c17/c17.rpy:3232
translate brazilian c17s003_AmandaLunch_8f0de41c:

    # kia "No quiero huir, [mc]."
    kia "Eu não quero fugir, [mc]."

# game/scripts/c17/c17.rpy:3233
translate brazilian c17s003_AmandaLunch_67d1140b:

    # kia "Es... es... complicado..."
    kia "É... é... complicado..."

# game/scripts/c17/c17.rpy:3237
translate brazilian c17s003_AmandaLunch_b68a7078:

    # kia "¡No! ¡No es complicado!"
    kia "Não! Não é complicado!"

# game/scripts/c17/c17.rpy:3239
translate brazilian c17s003_AmandaLunch_9f178ca7:

    # kia "*Susurrando* ¡Vas a ser el padre de mis nietos!"
    kia "*Sussurrando* Você vai ser o pai dos meus netos!"

# game/scripts/c17/c17.rpy:3241
translate brazilian c17s003_AmandaLunch_be9da35d:

    # kia "*Susurrando* ¡Estás con mi hija!"
    kia "*Sussurrando* Você está com a minha filha!"

# game/scripts/c17/c17.rpy:3242
translate brazilian c17s003_AmandaLunch_979136c5:

    # kia "¡Soy una mujer casada!"
    kia "Sou uma mulher casada!"

# game/scripts/c17/c17.rpy:3243
translate brazilian c17s003_AmandaLunch_ae009029:

    # mc "¿Qué? ¿Qué tiene que ver eso?"
    mc "O quê? Que tem isso a ver com alguma coisa?"

# game/scripts/c17/c17.rpy:3245
translate brazilian c17s003_AmandaLunch_d5ea279d:

    # kia "Ya te he dicho que no lo entenderías si te lo explicaba."
    kia "Eu já te disse que você não entenderia se eu explicasse."

# game/scripts/c17/c17.rpy:3246
translate brazilian c17s003_AmandaLunch_8064e907:

    # mc "Pero no me has explicado nada..."
    mc "Mas você não me explicou nada..."

# game/scripts/c17/c17.rpy:3248
translate brazilian c17s003_AmandaLunch_4431a7d9:

    # mc "¿Qué me he perdido?"
    mc "O que me escapou?"

# game/scripts/c17/c17.rpy:3250
translate brazilian c17s003_AmandaLunch_3a905abb:

    # bet "Al final resultará que no eres tan listo como yo pensaba."
    bet "No final, você vai descobrir que não é tão inteligente quanto eu pensava."

# game/scripts/c17/c17.rpy:3252
translate brazilian c17s003_AmandaLunch_7e715a92:

    # mc "Hola, Tía Betty. ¿Qué quieres decir?"
    mc "Olá, tia Betty. O que você quer dizer?"

# game/scripts/c17/c17.rpy:3253
translate brazilian c17s003_AmandaLunch_a58eca9e:

    # bet "No eres capaz de descubrir lo que le pasa a Kiara por ti mismo, ¿verdad?"
