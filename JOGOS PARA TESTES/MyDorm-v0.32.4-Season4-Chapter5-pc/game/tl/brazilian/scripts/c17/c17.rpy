# game/scripts/c17/c17.rpy:3901
translate brazilian c17s004_MeganLewd_6be41c7f:

    # meg "No hace falta, pediré un Under."
    meg "Não precisa, vou pedir um Under."

# game/scripts/c17/c17.rpy:3902
translate brazilian c17s004_MeganLewd_05444d84:

    # meg "Voy a recoger la ropa, vestirme y a irme."
    meg "Vou pegar minhas roupas, me vestir e ir embora."

# game/scripts/c17/c17.rpy:3903
translate brazilian c17s004_MeganLewd_eb6aa5f3:

    # mc "Una lástima tapar con ropa tanta belleza."
    mc "É uma pena esconder tanta beleza com roupas."

# game/scripts/c17/c17.rpy:3905
translate brazilian c17s004_MeganLewd_2832ae51:

    # "Una vez vestidos... o vestida ella, para ser más exactos, tú tan solo necesitas tu albornoz."
    "Depois que você estiver vestido... ou melhor, ela estiver vestida, tudo o que você precisa é do seu roupão."

# game/scripts/c17/c17.rpy:3906
translate brazilian c17s004_MeganLewd_54a68d2f:

