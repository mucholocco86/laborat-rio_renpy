translate brazilian c17s003_AmandaLunch_933d2e89:

    # mc "*Risa* Hasta luego, Tía Be... Hasta luego, Betty. *Risa*"
    mc "*Risos* Até logo, Tia Be... Até logo, Betty. *Risos*"

# game/scripts/c17/c17.rpy:3369
