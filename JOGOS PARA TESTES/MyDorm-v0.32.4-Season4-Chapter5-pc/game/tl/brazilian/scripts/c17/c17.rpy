# game/scripts/c17/c17.rpy:3365
translate brazilian c17s003_AmandaLunch_7296d1a0:

    # bet "Creo... creo... que hace mucho rato que nadie se mete con Olivia... voy a dejarte que hables con el resto de las chicas..."
