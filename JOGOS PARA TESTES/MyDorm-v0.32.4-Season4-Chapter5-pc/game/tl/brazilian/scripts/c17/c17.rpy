# game/scripts/c17/c17.rpy:3267
translate brazilian c17s003_AmandaLunch_df1b9f4a:

    # bet "Y de que descubriera que estás con Samantha."
    bet "E que ele descobriu que você está com a Samantha."

# game/scripts/c17/c17.rpy:3268
translate brazilian c17s003_AmandaLunch_4a80ff50:

    # mc "Sí, pero sigo sin ver que tiene que ver eso. Hasta que llegamos a su casa todo iba bien. Cuando nos fuimos también."
    mc "Sim, mas ainda não entendo o que isso tem a ver com alguma coisa. Estava tudo bem até chegarmos à casa dela. E estava tudo bem quando saímos também."

# game/scripts/c17/c17.rpy:3269
translate brazilian c17s003_AmandaLunch_c0a91882:

    # mc "Pero desde que volvimos a casa está distante conmigo. No entiendo ese cambio en los diez minutos que hay de su casa a aquí."
    mc "Mas desde que voltamos para casa, ele está distante comigo. Não entendo essa mudança repentina em apenas dez minutos, que é o tempo que levo para ir da casa dele até aqui."

# game/scripts/c17/c17.rpy:3271
translate brazilian c17s003_AmandaLunch_9f95f68a:

    # bet "¿Te apetece jugar a un juego?"
    bet "Você gostaria de jogar um jogo?"

# game/scripts/c17/c17.rpy:3272
translate brazilian c17s003_AmandaLunch_02614fa0:

    # mc "Preferiría que me dijeras que crees que le pasa."
    mc "Eu preferiria que você me dissesse o que você acha que está errado com ele."

# game/scripts/c17/c17.rpy:3274
translate brazilian c17s003_AmandaLunch_546dfd31:

    # bet "No te lo voy a decir. Podría haber sacado conclusiones equivocadas. Este juego lo inventó Olivia para [emm], pero también puede servir para ti."
    bet "Não vou te contar. Posso ter tirado conclusões precipitadas. Olivia inventou este jogo para [emm], mas pode funcionar para você também."

# game/scripts/c17/c17.rpy:3275
translate brazilian c17s003_AmandaLunch_598ca576:

