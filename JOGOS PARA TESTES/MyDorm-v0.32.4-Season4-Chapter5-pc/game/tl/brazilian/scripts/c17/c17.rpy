    mc "Não pensei nisso. Você não precisa pensar em nada."

# game/scripts/c17/c17.rpy:3290
translate brazilian c17s003_AmandaLunch_ad5c65c9:

    # bet "Yo en su lugar pensaría que no te importa la edad que tengan las mujeres con las que sales."
    bet "Se eu fosse você, pensaria que você não se importa com a idade das mulheres com quem namora."

# game/scripts/c17/c17.rpy:3291
translate brazilian c17s003_AmandaLunch_8cb31597:

    # mc "Y acertarías. La edad es sólo un número y no le presto atención en absoluto."
    mc "E você teria razão. Idade é só um número, e eu não dou a mínima importância para isso."

# game/scripts/c17/c17.rpy:3293
translate brazilian c17s003_AmandaLunch_fe4a498a:

