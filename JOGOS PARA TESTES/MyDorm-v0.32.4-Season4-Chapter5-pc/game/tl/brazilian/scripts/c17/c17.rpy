

# game/scripts/c17/c17.rpy:365
translate brazilian c17s001_AmandaDinner_d0af28a5:

    # mc "¡Amanda! ¡Estás preciosa!"
    mc "Amanda! Você está linda!"

# game/scripts/c17/c17.rpy:367
translate brazilian c17s001_AmandaDinner_afb86a32:

    # ama "Gracias, [mc]. Has dicho que para la cena sería mejor un vestido y..."
    ama "Obrigada, [mc]. Você disse que um vestido seria mais apropriado para o jantar e..."

# game/scripts/c17/c17.rpy:368
translate brazilian c17s001_AmandaDinner_8f743db4:

    # mc "Y has elegido uno que te queda perfecto. ¿Vamos?"
    mc "E você escolheu uma que combina perfeitamente com você. Vamos?"

# game/scripts/c17/c17.rpy:371
translate brazilian c17s001_AmandaDinner_24f1a87e:

    # ama "Sí, por favor, no quiero llegar tarde y que se lleven una mala primera impresión."
    ama "Sim, por favor, não quero me atrasar e causar uma má primeira impressão."

# game/scripts/c17/c17.rpy:372
translate brazilian c17s001_AmandaDinner_5defb41a:

    # mc "Amanda, ¿realmente crees que alguien va a mirar el reloj cuando te vean?"
    mc "Amanda, você realmente acha que alguém vai olhar para o relógio quando te vir?"

# game/scripts/c17/c17.rpy:373
translate brazilian c17s001_AmandaDinner_93251535:

    # mc "Todo el mundo está deseando conocerte, y más aún después del éxito de Eva durante la comida."
    mc "Todos estão ansiosos para te conhecer, especialmente depois do sucesso da Eva durante o almoço."

# game/scripts/c17/c17.rpy:375
translate brazilian c17s001_AmandaDinner_483c8d97:

    # ama "Gracias, [mc]. No sé qué has hecho, pero ha vuelto entusiasmada."
    ama "Obrigada, [mc]. Não sei o que você fez, mas ela voltou radiante."

# game/scripts/c17/c17.rpy:376
translate brazilian c17s001_AmandaDinner_74a7e7da:

    # mc "¿No tenéis cámaras en la cocina de [nor]?"
    mc "Vocês não têm câmeras na cozinha do [nor]?"

# game/scripts/c17/c17.rpy:378
translate brazilian c17s001_AmandaDinner_80c2d0a9:

    # ama "Sí, pero he dejado de mirarlas cuando le has presentado a [emm]."
    ama "Sim, mas parei de olhar para eles quando você o apresentou a [emm]."

# game/scripts/c17/c17.rpy:379
translate brazilian c17s001_AmandaDinner_68787dac:

    # ama "Me estaba entrando envidia cuando [mar] y [nor] han abrazado a Eva. Más envidia todavía con [eri]."
    ama "Eu fiquei com inveja quando [mar] e [nor] abraçaram Eva. Ainda mais inveja quando [eri]."

# game/scripts/c17/c17.rpy:381
translate brazilian c17s001_AmandaDinner_2db2420f:

    # ama "Pero con [emm] me ha entrado frustración. Ya estaba frustrada por cómo había tratado a [mar] esta mañana, pero..."
    ama "Mas eu fiquei frustrado com [emm]. Eu já estava frustrado com a forma como tratei [mar] esta manhã, mas..."

# game/scripts/c17/c17.rpy:382
translate brazilian c17s001_AmandaDinner_a5f2d08d:

    # mc "No le des más vueltas. Es [emm], y muchas veces solo necesita que alguien le haga pensar antes de darse cuenta de que su reacción ha sido... excesiva."
    mc "Não pense demais nisso. É [emm], e muitas vezes ele só precisa que alguém o faça pensar antes de perceber que sua reação foi... exagerada."

# game/scripts/c17/c17.rpy:384
translate brazilian c17s001_AmandaDinner_5bd12c5f:

    # ama "Lo sé. Después de estos meses viendo a alguien con mi cara actuando como yo no lo haría nunca... te aseguro que lo sé."
    ama "Eu sei. Depois de meses vendo alguém com o meu rosto agindo de maneiras que eu jamais agiria... Garanto que sei."

# game/scripts/c17/c17.rpy:385
translate brazilian c17s001_AmandaDinner_235c1e4d:

    # mc "¿Por eso te teñiste de rubio?"
    mc "Foi por isso que você pintou o cabelo de loiro?"

# game/scripts/c17/c17.rpy:388
translate brazilian c17s001_AmandaDinner_780b076e:

    # ama "¿Q-qué? ¡N-no! Lo hice por si acaso... había que seguiros a distancia. Un color diferente de pelo puede... cambiar la percepción del observador."
    ama "O quê? N-não! Eu fiz isso por precaução... precisávamos ficar de olho em você. Uma cor de cabelo diferente pode... alterar a percepção de quem observa."

# game/scripts/c17/c17.rpy:389
translate brazilian c17s001_AmandaDinner_07e61db0:

    # mc "Ah, OK. Como en las películas cuando los espías se ponen una peluca."
    mc "Ah, entendi. Como nos filmes, quando os espiões colocam uma peruca."

# game/scripts/c17/c17.rpy:390
translate brazilian c17s001_AmandaDinner_c5b80ac4:

    # ama "Sí... más o menos... ¿nos vamos?"
    ama "Sim... mais ou menos... vamos?"

# game/scripts/c17/c17.rpy:392
translate brazilian c17s001_AmandaDinner_5f7d4099:

    # "Tenéis una conversación tensa en el coche. Casi tienes que sacarle las palabras una a una."
    "Vocês estão tendo uma conversa tensa no carro. Você praticamente tem que arrancar as palavras dela uma a uma."

# game/scripts/c17/c17.rpy:393
translate brazilian c17s001_AmandaDinner_be1ffe17:

    # "Por fin llegáis a casa."
    "Você finalmente chegou em casa."

# game/scripts/c17/c17.rpy:395
translate brazilian c17s001_AmandaDinner_c697453e:

    # mc "¿Nerviosa?"
    mc "Nervoso?"

# game/scripts/c17/c17.rpy:396
translate brazilian c17s001_AmandaDinner_6ad6f704:

    # ama "Sí, mucho. Lo de ayer fue... inesperado."
    ama "Sim, com certeza. O que aconteceu ontem foi... inesperado."

# game/scripts/c17/c17.rpy:397
translate brazilian c17s001_AmandaDinner_b81ae450:

    # ama "Lo que me ha contado hoy Eva de lo bien que se lo ha pasado... no sé... me da miedo."
    ama "O que a Eva me contou hoje sobre o quanto ela se divertiu... não sei... isso me assusta."

# game/scripts/c17/c17.rpy:399
translate brazilian c17s001_AmandaDinner_35099ae7:

    # ama "¿Qué pasa si después vendéis la empresa? ¿Qué pasa si, una vez pase la novedad, no queréis que formemos parte de la familia?"
    ama "O que acontece se você vender a empresa mais tarde? O que acontece se, quando a novidade passar, você não quiser que façamos parte da família?"

# game/scripts/c17/c17.rpy:400
translate brazilian c17s001_AmandaDinner_b17e72d0:

    # mc "Eso no va a pasar, Amanda. Al menos lo último."
    mc "Isso não vai acontecer, Amanda. Pelo menos não a segunda opção."

# game/scripts/c17/c17.rpy:401
translate brazilian c17s001_AmandaDinner_3096ee28:

    # mc "No sé si venderemos la empresa o no. Será una decisión familiar, y aunque yo vote una cosa, ellas cinco pueden votar lo contrario."
    mc "Não sei se vamos vender a empresa ou não. Será uma decisão familiar, e mesmo que eu vote de um jeito, os cinco podem votar de outro."

# game/scripts/c17/c17.rpy:403
translate brazilian c17s001_AmandaDinner_a97ffd9f:

    # ama "*Gruñido* Lo sé. Y no saber lo que van a hacer... me tiene nerviosa. Para mí, esta cena no es solo para conocerlas, aunque sea lo más importante..."
    ama "*Resmungo* Eu sei. E não saber o que eles vão fazer... me deixa nervosa. Para mim, este jantar não é só sobre conhecê-los, embora isso seja o mais importante..."

# game/scripts/c17/c17.rpy:404
translate brazilian c17s001_AmandaDinner_45dc4b83:

    # mc "Es también para que te conozcan, para que les pongan cara a las verdaderas víctimas de NTR. Vosotras, Aaron, y el resto, ¿no?"
    mc "É também para que as pessoas possam conhecer vocês, para que possam associar um rosto às verdadeiras vítimas de NTR. Você, Aaron, e todos os outros, certo?"

# game/scripts/c17/c17.rpy:406
translate brazilian c17s001_AmandaDinner_7181eaea:

    # ama "Eva estaba equivocada. Pillas las cosas más rápido de lo que parece."
    ama "Eva estava enganada. A gente aprende as coisas mais rápido do que pensa."

# game/scripts/c17/c17.rpy:407
translate brazilian c17s001_AmandaDinner_88dd2c30:

    # ama "Depende a quién le vendáis la empresa, si no os podemos pagar lo que pidáis, habrá más Aarons y más Erics. Más Fionas."
    ama "Depende de para quem você vender a empresa. Se não pudermos pagar o que você está pedindo, haverá mais Aarons e mais Erics. Mais Fionas."

# game/scripts/c17/c17.rpy:408
translate brazilian c17s001_AmandaDinner_41f1e3d6:

    # mc "Si mi voto decanta la balanza, no venderemos. Pero dudo que mi voto sirva de mucho."
    mc "Se meu voto for decisivo, não venderemos. Mas duvido que meu voto faça muita diferença."

# game/scripts/c17/c17.rpy:410
translate brazilian c17s001_AmandaDinner_6a923f5c:

    # ama "¿Crees que van a querer vender? Entiendo que es mucho dinero..."
    ama "Você acha que eles vão querer vender? Eu entendo que é muito dinheiro..."

# game/scripts/c17/c17.rpy:411
translate brazilian c17s001_AmandaDinner_b23d8247:

    # mc "[nor] y [mar] no van a querer que otras chicas o chicos pasen por lo que habéis pasado vosotras. Y estoy seguro de que no sabemos ni la mitad de lo que habéis pasado."
    mc "[nor] e [mar] não querem que outras meninas ou meninos passem pelo que você passou. E tenho certeza de que nem sabemos metade do que você passou."

# game/scripts/c17/c17.rpy:412
translate brazilian c17s001_AmandaDinner_93e5b0ff:

    # mc "[dap] ya está haciendo planes para trabajar en NTR. Mejor hacerlo como accionista, ¿no?"
    mc "[dap] já está planejando trabalhar na NTR. Melhor fazer isso como acionista, não é?"

# game/scripts/c17/c17.rpy:413
translate brazilian c17s001_AmandaDinner_5e892a1c:

    # mc "Y [eri] es tan empática que, en cuanto entienda por lo que habéis pasado, estará en la misma posición que [mar] y [nor]."
    mc "E [eri] é tão empática que, assim que ela entender o que você passou, ela estará na mesma posição que [mar] e [nor]."

# game/scripts/c17/c17.rpy:414
translate brazilian c17s001_AmandaDinner_59511ffd:

    # mc "Mi voto y el de [emm] no servirían de nada."
    mc "Meu voto e o de [emm] seriam inúteis."

# game/scripts/c17/c17.rpy:416
translate brazilian c17s001_AmandaDinner_737bd48b:

    # ama "¿Votarías por venderla?"
    ama "Você votaria a favor da venda?"

# game/scripts/c17/c17.rpy:417
translate brazilian c17s001_AmandaDinner_edffed05:

    # mc "No. Si votase por venderla sería para vendérosla a vosotros, pero creo que es mejor no hacerlo. Creo que me gusta la idea de hacer que el viejo NTR desaparezca."
    mc "Não. Se eu votasse para vender, seria para vender para você, mas acho melhor não vender. Acho que gosto da ideia de fazer o antigo NTR desaparecer."

# game/scripts/c17/c17.rpy:418
translate brazilian c17s001_AmandaDinner_943e0d4f:

    # mc "Crear algo nuevo con lo que tenemos entre manos. Aunque no sé dónde encajaríais vosotras, Aaron, o el resto de los clones en esa visión."
    mc "Criar algo novo com o que temos à mão. Embora eu não saiba onde você, Aaron, ou o resto dos clones se encaixariam nessa visão."

# game/scripts/c17/c17.rpy:420
translate brazilian c17s001_AmandaDinner_472929fa:

    # ama "Sobre eso... tengo varias ideas. ¿Te parece bien que tomemos un café un día y lo hablamos?"
    ama "Sobre isso... tenho algumas ideias. Gostaria de tomar um café comigo um dia desses para conversarmos?"

# game/scripts/c17/c17.rpy:421
translate brazilian c17s001_AmandaDinner_1842c921:

    # mc "Me parece genial. Ahora deberíamos entrar."
    mc "Isso parece ótimo. Devemos entrar agora."

# game/scripts/c17/c17.rpy:425
translate brazilian c17s001_AmandaDinner_edb24cc0:

    # mc "Bueno, parece que toda la familia está aquí. *Risa* Vas a sufrir más que Eva."
    mc "Bom, parece que a família toda está aqui. *Risos* Você vai sofrer mais do que a Eva."

# game/scripts/c17/c17.rpy:426
translate brazilian c17s001_AmandaDinner_863fdac8:

    # ama "*Susurrando* Yo soporto... disfruto más de los abrazos que ella."
    ama "*Sussurrando* Eu consigo lidar com isso... Eu gosto mais de abraços do que ela."

# game/scripts/c17/c17.rpy:428
translate brazilian c17s001_AmandaDinner_b2013db9:

    # "[mar] corre hacia Amanda y la envuelve en un abrazo."
    "[mar] corre em direção a Amanda e a envolve em um abraço."

# game/scripts/c17/c17.rpy:429
translate brazilian c17s001_AmandaDinner_4b7ba78a:

    # mom "Bienvenida de nuevo a casa, Amanda."
    mom "Bem-vinda de volta para casa, Amanda."

# game/scripts/c17/c17.rpy:430
translate brazilian c17s001_AmandaDinner_481f2225:

    # ama "Gracias, [mar]."
    ama "Obrigado, [mar]."

# game/scripts/c17/c17.rpy:433
translate brazilian c17s001_AmandaDinner_e3d25341:

    # "Se repiten las presentaciones y los abrazos de la comida y la misma dinámica. Las chicas, esta vez también con las estudiantes, acaparan a Amanda mientras las mujeres se mantienen apartadas."
    "As apresentações e os abraços durante a refeição se repetem, assim como a mesma dinâmica. As meninas, desta vez também acompanhadas pelas estudantes, monopolizam Amanda, enquanto as mulheres mantêm distância."

# game/scripts/c17/c17.rpy:434
translate brazilian c17s001_AmandaDinner_31b4962b:

    # "Decides mantenerte a distancia del grupo de chicas. Sabes que, si te acercas a ellas, vas a ser objeto de bromas y hoy el centro de atención tiene que ser Amanda."
    "Você decide manter distância do grupo de garotas. Sabe que, se se aproximar delas, será alvo de piadas, e hoje o foco precisa ser Amanda."

# game/scripts/c17/c17.rpy:437
translate brazilian c17s001_AmandaDinner_e43fd160:

    # bet "Parece increíble, ¿no? Esta mañana teníamos a una versión de [emm] que se parecía a [dap] y ahora una versión de [eri] con la cara de [emm]."
    bet "Parece incrível, não é? Esta manhã tínhamos uma versão de [emm] que parecia com [dap] e agora uma versão de [eri] com a mesma aparência de [emm]."

# game/scripts/c17/c17.rpy:438
translate brazilian c17s001_AmandaDinner_34e0814c:

    # mc "Son más complejas que todo eso, Tía Betty. Aparte del obvio parecido físico, en cuanto a personalidad no puedes buscar una correlación total."
    mc "Eles são mais complexos do que isso, tia Betty. Além da óbvia semelhança física, não se pode esperar uma correlação perfeita em termos de personalidade."

# game/scripts/c17/c17.rpy:439
translate brazilian c17s001_AmandaDinner_4ebc751c:

    # mc "Es cierto que Eva se parece mucho a [emm], pero hay muchos matices. También tiene mucho de ti, como el sentido del humor."
    mc "É verdade que Eva se parece muito com [emm], mas há muitas nuances. Ela também tem muito de você nela, como o senso de humor."

# game/scripts/c17/c17.rpy:440
translate brazilian c17s001_AmandaDinner_d65da405:

    # mc "Y Amanda, pese a que es emocional como [eri], también es inteligente como [dap] o Scarlett."
    mc "E Amanda, apesar de ser emotiva como [eri], também é inteligente como [dap] ou Scarlett."

# game/scripts/c17/c17.rpy:442
translate brazilian c17s001_AmandaDinner_a6222657:

    # bet "Tienes razón. La mente juega malas pasadas y, sabiendo que son clones, busca más parecidos de los obvios."
    bet "Você tem razão. A mente nos prega peças e, sabendo que são clones, busca semelhanças além das óbvias."

# game/scripts/c17/c17.rpy:443
translate brazilian c17s001_AmandaDinner_be2b6864:

    # mc "Sí, a mí también me pasa. Espero que Eva actúe como [emm]. La mayoría de las veces lo hace, pero a veces me sorprende."
    mc "Sim, acontece comigo também. Espero que a Eva aja como a [emm]. Na maioria das vezes ela age, mas às vezes me surpreende."

# game/scripts/c17/c17.rpy:444
translate brazilian c17s001_AmandaDinner_8127a81d:

    # mc "Hoy en la clase de tiro podría haber avergonzado a Meemaw con lo estricta que era al principio."
    mc "Hoje, na aula de tiro, eu poderia ter envergonhado a vovó de tão rigoroso que fui no começo."

# game/scripts/c17/c17.rpy:446
translate brazilian c17s001_AmandaDinner_0789b0fa:

    # bet "Hablando de Olivia, ¿cómo ha ido la visita al médico?"
    bet "Por falar em Olivia, como foi a consulta médica?"

# game/scripts/c17/c17.rpy:448
translate brazilian c17s001_AmandaDinner_3504c7ce:

    # bet "Ha vuelto más contenta de lo que esperaba sabiendo que no va a poder empezar el tratamiento todavía."
    bet "Ela voltou mais feliz do que esperava, mesmo sabendo que ainda não poderá iniciar o tratamento."

# game/scripts/c17/c17.rpy:449
translate brazilian c17s001_AmandaDinner_bec6fc3a:

    # mc "Bueno, estaba un poco decepcionada sobre lo de no poder empezar el tratamiento inmediatamente, pero después se le ha pasado un poco."
    mc "Bem, fiquei um pouco desapontado por não poder começar o tratamento imediatamente, mas já superei isso um pouco desde então."

# game/scripts/c17/c17.rpy:451
translate brazilian c17s001_AmandaDinner_8ac98141:

    # bet "Me ha dicho que me tienes que enseñar algo sobre los masajes, que yo no los estaba haciendo bien."
    bet "Ela me disse que eu precisava ensinar-lhe algo sobre massagens, porque eu não as estava fazendo direito."

# game/scripts/c17/c17.rpy:452
translate brazilian c17s001_AmandaDinner_8e2ea9e9:

    # mc "Es lo que ha dicho la Dra. Milk. Hay una zona que no estás masajeando correctamente."
    mc "Foi isso que o Dr. Milk disse. Há uma área que você não está massageando corretamente."

# game/scripts/c17/c17.rpy:454
translate brazilian c17s001_AmandaDinner_c1966eb3:

    # bet "Mañana, cuando toque darle el masaje, puedes enseñarme, si te va bien."
    bet "Amanhã, quando chegar a hora de massageá-lo, você pode me mostrar, se isso for bom para você."

# game/scripts/c17/c17.rpy:455
translate brazilian c17s001_AmandaDinner_5ac7d1fb:

    # mc "Perfecto. No es difícil."
    mc "Perfeito. Não é difícil."

# game/scripts/c17/c17.rpy:457
translate brazilian c17s001_AmandaDinner_ea3052e4:

    # mc "Aunque puede acabar siendo un poco pegajoso. *Risita*"
    mc "Embora possa acabar ficando um pouco pegajoso. *Risos*"

# game/scripts/c17/c17.rpy:459
translate brazilian c17s001_AmandaDinner_cc5707b4:

    # bet "¿Pegajoso? ¿Por qué? ¿La médico no le sacó la leche antes de los masajes?"
    bet "Está pegajoso? Por quê? O médico não extraiu o leite antes das massagens?"

# game/scripts/c17/c17.rpy:460
translate brazilian c17s001_AmandaDinner_d882d1bc:

    # mc "Sí, pero... por lo que dijo, es posible que no lo sacara todo."
    mc "Sim, mas... pelo que ele disse, é possível que não tenha conseguido explicar tudo."

# game/scripts/c17/c17.rpy:461
translate brazilian c17s001_AmandaDinner_417c029b:

    # bet "Mmmmm... Okaaay."
    bet "Hummm... Ok."

# game/scripts/c17/c17.rpy:463
translate brazilian c17s001_AmandaDinner_42315518:

    # mee "¿Qué estáis planeando vosotros dos? *Risita*"
    mee "O que vocês dois estão planejando? *Risos*"

# game/scripts/c17/c17.rpy:464
translate brazilian c17s001_AmandaDinner_6b64de23:

    # mc "Nada especial, Meemaw. Tía Betty me estaba pidiendo que le enseñara mañana lo que hemos hecho hoy."
    mc "Nada de especial, vovó. A tia Betty pediu para eu mostrar a ela amanhã o que fizemos hoje."

# game/scripts/c17/c17.rpy:465
translate brazilian c17s001_AmandaDinner_7475059d:

    # mc "Podemos repetir lo de esta mañana si quieres."
    mc "Podemos repetir o que fizemos esta manhã, se você quiser."

# game/scripts/c17/c17.rpy:468
translate brazilian c17s001_AmandaDinner_813a9c52:

    # mee "¿Qué? {b}¿Todo?{/b}"
    mee "O quê? {b}Tudo?{/b}"

# game/scripts/c17/c17.rpy:469
translate brazilian c17s001_AmandaDinner_1711c5b0:

    # mc "Lo que tú quieras, Meemaw."
    mc "O que você quiser, vovó."

# game/scripts/c17/c17.rpy:471
translate brazilian c17s001_AmandaDinner_ac9197b6:

    # bet "Mmmmm... ¿A qué te refieres con \"todo\", Olivia?"
    bet "Hum... O que você quer dizer com \"tudo\", Olivia?"

# game/scripts/c17/c17.rpy:472
translate brazilian c17s001_AmandaDinner_44f8d873:

    # mc "La doctora nos ha enseñado dos formas de hacer el masaje. Una por delante, como lo haces tú, y otra desde atrás."
    mc "O médico nos mostrou duas maneiras de fazer a massagem. Uma pela frente, como se faz normalmente, e outra por trás."

# game/scripts/c17/c17.rpy:473
translate brazilian c17s001_AmandaDinner_c5c8eac6:

    # mc "Ha sido más cómodo hacerlo desde atrás, y con mejor resultado."
    mc "Tem sido mais confortável fazer por trás, e com melhores resultados."

# game/scripts/c17/c17.rpy:475
translate brazilian c17s001_AmandaDinner_e10117ec:

    # mee "¡[mc]!"
    mee "[mc]!"

# game/scripts/c17/c17.rpy:476
translate brazilian c17s001_AmandaDinner_09abbe64:

    # mc "¿Qué? Es cierto..."
    mc "O quê? Isso mesmo..."

# game/scripts/c17/c17.rpy:478
translate brazilian c17s001_AmandaDinner_bf1923c1:

    # bet "Mmmm... ¿Ha pasado algo?"
    bet "Hum... Aconteceu alguma coisa?"

# game/scripts/c17/c17.rpy:479
translate brazilian c17s001_AmandaDinner_8bba0c69:

    # mc "¿Qué quieres que pase? Estábamos en la consulta del médico. *Risa*"
    mc "O que você quer que aconteça? Estávamos no consultório médico. *Risos*"

# game/scripts/c17/c17.rpy:482
