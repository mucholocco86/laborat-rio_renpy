    bet "Eles são uma dádiva divina. Como poderiam não fazer parte desta família?"

# game/scripts/c17/c17.rpy:809
translate brazilian c17s001_AmandaDinner_9482eec0:

    # mcp "(¿Divino? Ciencia, Tía Betty, ciencia.)"
    mcp "(Divina? Ciência, tia Betty, ciência.)"

