# game/scripts/c17/c17.rpy:3357
translate brazilian c17s003_AmandaLunch_9adcbc03:

    # bet "De todas formas, ¿qué le ibas a decir? ¿Que hemos estado analizando su comportamiento y que pensamos que puede ser que se sienta atraída por ti?"
    bet "Enfim, o que você ia dizer para ela? Que estávamos analisando o comportamento dela e que achávamos que ela poderia estar atraída por você?"

# game/scripts/c17/c17.rpy:3358
translate brazilian c17s003_AmandaLunch_4816671f:

    # mc "Tienes razón... mejor dejar pasar unos días."
    mc "Você tem razão... é melhor esperar alguns dias."

# game/scripts/c17/c17.rpy:3359
translate brazilian c17s003_AmandaLunch_518092d6:

    # mc "Pero cambiando de tema... El tipo ese fuerte, guapo, sexy y adorable... Teniendo en cuenta que Kiara nunca ha dicho nada de eso... ¿Es cómo me ves tú?"
    mc "Mas mudando de assunto... Aquele cara forte, bonito, sexy e adorável... Considerando que a Kiara nunca disse nada parecido... É assim que você me vê?"

# game/scripts/c17/c17.rpy:3361
translate brazilian c17s003_AmandaLunch_5e4c3634:

    # bet "¿Qué? ¿Yo? ¡Tengo edad para ser tu abuela!"
    bet "O quê? Eu? Tenho idade para ser sua avó!"

# game/scripts/c17/c17.rpy:3362
translate brazilian c17s003_AmandaLunch_c873c513:

    # mc "Ya sabes que para mí la edad solo es un número. *Risa* Pero tu rubor ha contestado mi pregunta."
    mc "Você sabe que para mim, idade é só um número. *Risos* Mas seu rubor respondeu à minha pergunta."

# game/scripts/c17/c17.rpy:3363
