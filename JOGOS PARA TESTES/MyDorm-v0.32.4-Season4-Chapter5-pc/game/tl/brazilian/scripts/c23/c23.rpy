    "Certo. Você acordou. E levou um susto."

# game/scripts/c23/c23.rpy:2485
translate brazilian c23s005_Emm_731dbbe0:

    # mom "¿Qué hora es, [emm]? No he oído el despertador."
    mom "Que horas são, [emm]? Não ouvi o despertador."

# game/scripts/c23/c23.rpy:2486
translate brazilian c23s005_Emm_01b992b8:

    # "En algún momento, durante la noche, [mar] se ha tapado con el edredón."
    "Em algum momento da noite, [mar] se cobriu com o edredom."

# game/scripts/c23/c23.rpy:2488
translate brazilian c23s005_Emm_1b146ec7:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a la habitación de [mc]. Y resulta que estaba aquí."
    emm "6h da manhã. Estou acordado há mais de uma hora, me segurando para não subir até o quarto de [mc]. E descobri que ele estava aqui."

# game/scripts/c23/c23.rpy:2491
translate brazilian c23s005_Emm_18ac9830:

    # emm "¡Y no me habéis invitado! Pero os lo perdono porque hoy estoy emocionada con el viaje."
    emm "E você não me convidou! Mas eu te perdoo porque estou muito animada com a viagem de hoje."

# game/scripts/c23/c23.rpy:2492
translate brazilian c23s005_Emm_8f31b5b2:

    # emm "Pero si no os levantáis ya, se va a hacer tarde."
    emm "Mas se você não se levantar agora, vai ficar tarde."

# game/scripts/c23/c23.rpy:2493
translate brazilian c23s005_Emm_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], dissemos que sairíamos daqui às 8:00. Eu tinha programado meu alarme para 7:15."

# game/scripts/c23/c23.rpy:2495
translate brazilian c23s005_Emm_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "E em 45 minutos você ia tomar banho..."

# game/scripts/c23/c23.rpy:2496
translate brazilian c23s005_Emm_f4b84d41:

    # mc "Me duché anoche..."
    mc "Tomei um banho ontem à noite..."

# game/scripts/c23/c23.rpy:2497
translate brazilian c23s005_Emm_d664759d:

    # emm "A vestirte..."
    emm "Vista-se..."

# game/scripts/c23/c23.rpy:2498
translate brazilian c23s005_Emm_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Sou homem. Preciso de menos de cinco minutos. Cinco minutos de verdade..."

# game/scripts/c23/c23.rpy:2499
translate brazilian c23s005_Emm_d6f2a180:

    # emm "Y a desayunar..."
    emm "E chegou a hora do café da manhã..."

# game/scripts/c23/c23.rpy:2500
translate brazilian c23s005_Emm_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Foi para isso que serviram 30 dos 45 minutos. *Risos*"

# game/scripts/c23/c23.rpy:2501
translate brazilian c23s005_Emm_711c7675:

    # mc "Puedes ir preparando el café, si quieres ir avanzando."
    mc "Você pode começar a fazer o café, se quiser se adiantar."

# game/scripts/c23/c23.rpy:2503
translate brazilian c23s005_Emm_54e1c1b6:

    # mom "No os preocupéis por el desayuno. Ya lo preparo yo mientras te vistes."
    mom "Não se preocupe com o café da manhã. Eu o prepararei enquanto você se veste."

# game/scripts/c23/c23.rpy:2504
translate brazilian c23s005_Emm_e3ab73bc:

    # mom "De todas formas mi despertador iba a sonar en 15 minutos para prepararlo."
    mom "De qualquer forma, meu alarme ia tocar em 15 minutos, então eu poderia me arrumar."

# game/scripts/c23/c23.rpy:2506
translate brazilian c23s005_Emm_15b05d64:

    # emm "Mamá, eres la mejor. Sabía que no ibas a dejar que nos fuéramos con sólo un trozo de tarta de ayer en el estómago."
    emm "Mãe, você é a melhor. Eu sabia que você não nos deixaria ir embora só com um pedaço do bolo de ontem na barriga."

# game/scripts/c23/c23.rpy:2507
translate brazilian c23s005_Emm_e096a202:

    # mc "Vale, [emm]... ¿Tía [bet] ya está despierta?"
    mc "Certo, [emm]... A tia [bet] já acordou?"

# game/scripts/c23/c23.rpy:2509
translate brazilian c23s005_Emm_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Não sei! Ainda não fui vê-la!"

# game/scripts/c23/c23.rpy:2510
translate brazilian c23s005_Emm_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "O que você está esperando? Ela é uma mulher e vai demorar mais para se vestir do que eu."

# game/scripts/c23/c23.rpy:2511
translate brazilian c23s005_Emm_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Você tem razão! Estou indo embora!"

# game/scripts/c23/c23.rpy:2514
translate brazilian c23s005_Emm_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:2516
translate brazilian c23s005_Emm_80ab0291:

    # emm "*A través de la puerta* ¡Lo tengo que hacer todo yo!"
    emm "*Através da porta* Tenho que fazer tudo sozinho!"

# game/scripts/c23/c23.rpy:2518
translate brazilian c23s005_Emm_f7f4d563:

    # mc "Y se fue. Voy a vestirme y a ayudarte a preparar el desayuno."
    mc "E ela saiu. Vou me vestir e te ajudar a preparar o café da manhã."

# game/scripts/c23/c23.rpy:2520
translate brazilian c23s005_Emm_232a26e2:

    # mom "No es necesario, puedes dormir un rato más, si quieres. ¿Te levanto dentro de 30 minutos?"
    mom "Não precisa, você pode dormir mais um pouco se quiser. Devo te acordar em 30 minutos?"

# game/scripts/c23/c23.rpy:2521
translate brazilian c23s005_Emm_beeb27c0:

    # mc "No voy a poder dormirme otra vez si no estás aquí."
    mc "Não conseguirei mais dormir se você não estiver aqui."

# game/scripts/c23/c23.rpy:2522
translate brazilian c23s005_Emm_f104feef:

    # mc "Me va a faltar tu peso sobre mi pecho."
    mc "Vou sentir falta do seu peso no meu peito."

# game/scripts/c23/c23.rpy:2524
translate brazilian c23s005_Emm_7b679049:

    # "[mar] te besa apasionadamente por sorpresa. Te podrías acostumbrar a despertarte así todos los días."
    "[mar] Ele te beija apaixonadamente e de forma inesperada. Você poderia se acostumar a acordar assim todos os dias."

# game/scripts/c23/c23.rpy:2526
translate brazilian c23s005_Emm_e4df2143:

    # mom "Entonces sube a vestirte y ven a la cocina."
    mom "Então suba, vista-se e venha para a cozinha."

# game/scripts/c23/c23.rpy:2542
translate brazilian c23s006_AfterBreakfastBetConfession_6b8dfbb6:

    # "Después de desayunar bajas las {b}tres{/b} maletas de [emm] a la camioneta."
    "Após o café da manhã, leve as três malas do ponto C2 para a van."

# game/scripts/c23/c23.rpy:2543
translate brazilian c23s006_AfterBreakfastBetConfession_79e3a8e3:

    # "[bet] solo lleva una maleta pequeña, donde lleva el hábito y otras cosas más normales."
    "[bet] Ela carrega apenas uma pequena mala, onde guarda seu vício e outras coisas mais normais."

# game/scripts/c23/c23.rpy:2544
translate brazilian c23s006_AfterBreakfastBetConfession_a6fd427d:

    # "Tú sólo llevas tu mochila."
    "Você só precisa carregar sua mochila."

# game/scripts/c23/c23.rpy:2547
translate brazilian c23s006_AfterBreakfastBetConfession_22f01abd:

    # mom "No corras. Conduce con cuidado. Haz un par de paradas a medio camino para descansar..."
    mom "Não exceda a velocidade permitida. Dirija com cuidado. Faça algumas paradas ao longo do caminho para descansar..."

# game/scripts/c23/c23.rpy:2548
translate brazilian c23s006_AfterBreakfastBetConfession_32ff118e:

    # mc "No te preocupes, en cuanto lleguemos te llamo para decirte que hemos llegado bien. Espera la llamada alrededor de la hora de comer."
    mc "Não se preocupe, eu ligo assim que chegarmos para avisar que estamos bem. A ligação deve acontecer por volta da hora do almoço."

# game/scripts/c23/c23.rpy:2550
translate brazilian c23s006_AfterBreakfastBetConfession_a2652fb6:

    # mom "¿Tan tarde?"
    mom "Tão tarde?"

# game/scripts/c23/c23.rpy:2551
translate brazilian c23s006_AfterBreakfastBetConfession_c2eaf91d:

    # mc "Cuando lleguemos tenemos que ir a alquilar el coche y después tengo que llevar a Tía [bet]."
    mc "Quando chegarmos, temos que ir alugar o carro e depois eu tenho que levar a tia [bet]."

# game/scripts/c23/c23.rpy:2552
translate brazilian c23s006_AfterBreakfastBetConfession_fa66d2bd:

    # mc "Mejor que la esperes tarde y te llame antes, a que la esperes pronto y me retrase."
    mc "É melhor que você a espere atrasada e ela ligue mais cedo, do que você a espere cedo e eu me atrase."

# game/scripts/c23/c23.rpy:2555
translate brazilian c23s006_AfterBreakfastBetConfession_e0795c02:

    # mom "Hasta mañana, mi amor."
    mom "Até amanhã, meu amor."

# game/scripts/c23/c23.rpy:2558
translate brazilian c23s006_AfterBreakfastBetConfession_58ac1d50:

    # mom "Hasta mañana, [mc]."
    mom "Até amanhã, [mc]."

# game/scripts/c23/c23.rpy:2559
translate brazilian c23s006_AfterBreakfastBetConfession_6bb4321b:

    # mc "No te preocupes por nada. Vamos dos adultos... y [emm]. Hasta mañana."
    mc "Não se preocupe com nada. Há dois adultos... e [emm]. Até amanhã."

# game/scripts/c23/c23.rpy:2562
translate brazilian c23s006_AfterBreakfastBetConfession_b53a8c44:

    # "Al cabo de unos minutos, sospechosamente cuando todas las maletas ya están cargadas, aparece [emm]."
    "Após alguns minutos, de forma suspeita, quando todas as malas já estão carregadas, [emm] aparece."

# game/scripts/c23/c23.rpy:2564
translate brazilian c23s006_AfterBreakfastBetConfession_98dad1eb:

    # emm "¡Me pido el asiento de atrás! Así podré echar una cabezada por el camino."
    emm "Eu vou no banco de trás! Assim posso tirar um cochilo no caminho."

# game/scripts/c23/c23.rpy:2565
translate brazilian c23s006_AfterBreakfastBetConfession_ad278a8e:

    # mc "No esperarás ir tumbada, ¿verdad?"
    mc "Você não espera se entregar de bandeja, espera?"

# game/scripts/c23/c23.rpy:2567
translate brazilian c23s006_AfterBreakfastBetConfession_2f1b87bd:

    # emm "Claro que sí. He dormido muy poco..."
    emm "Claro. Tenho dormido muito pouco..."

# game/scripts/c23/c23.rpy:2568
translate brazilian c23s006_AfterBreakfastBetConfession_1baf40e6:

    # mcp "(Y has dejado dormir poco a los demás.)"
    mcp "(E você deixou os outros dormirem muito pouco.)"

# game/scripts/c23/c23.rpy:2569
translate brazilian c23s006_AfterBreakfastBetConfession_f7a399a1:

    # emm "Y no me vengas con que si frenas de golpe me voy a caer del asiento. Conduces como una abuelita."
    emm "E não me venha dizer que se você frear bruscamente eu vou cair do banco. Você dirige como uma vovó."

# game/scripts/c23/c23.rpy:2570
translate brazilian c23s006_AfterBreakfastBetConfession_5ddd15d0:

    # mc "Era precisamente lo que te iba a decir. *Risa* Bueno, excepto lo de la abuelita."
    mc "Era exatamente isso que eu ia te dizer. *Risos* Bem, exceto pela parte da vovó."

# game/scripts/c23/c23.rpy:2572
translate brazilian c23s006_AfterBreakfastBetConfession_8e89c4e6:

    # emm "¡Pero no puedo dormir sentada! ¡Siempre acabo con dolor de cuello y de mal humor!"
    emm "Mas eu não consigo dormir sentada! Sempre acabo com dor no pescoço e de mau humor!"

# game/scripts/c23/c23.rpy:2573
translate brazilian c23s006_AfterBreakfastBetConfession_a041378f:

    # emm "Y eso me va a estropear el día."
    emm "E isso vai arruinar o meu dia."

# game/scripts/c23/c23.rpy:2574
translate brazilian c23s006_AfterBreakfastBetConfession_191006ce:

    # mc "Lo que me extraña es que no estés de mal humor por haber tenido que levantarte temprano. *Risa*"
    mc "O que me surpreende é que você não esteja de mau humor por ter que acordar cedo. *Risos*"

# game/scripts/c23/c23.rpy:2576
translate brazilian c23s006_AfterBreakfastBetConfession_e6d83b0e:

    # emm "¡Hoy había una buena razón para hacerlo!"
    emm "Hoje havia um bom motivo para fazer isso!"

# game/scripts/c23/c23.rpy:2577
translate brazilian c23s006_AfterBreakfastBetConfession_6a65be27:

    # mc "Bueno, por ahí viene Tía [bet]. Ya nos podemos ir."
    mc "Ok, lá vem a tia [bet]. Podemos ir agora."

# game/scripts/c23/c23.rpy:2579
translate brazilian c23s006_AfterBreakfastBetConfession_60cd69d7:

    # "Tras unas cuantas despedidas más, por fin os ponéis en camino."
    "Após mais algumas despedidas, você finalmente partiu."

# game/scripts/c23/c23.rpy:2580
translate brazilian c23s006_AfterBreakfastBetConfession_acd46f2a:

    # "Por suerte habéis salido con tiempo. Había unas obras en la carretera antes de llegar a Atascadero que os han retrasado un poco."
    "Por sorte, você saiu com bastante tempo. Havia obras na estrada antes de chegar a Atascadero, o que atrasou um pouco a sua viagem."

# game/scripts/c23/c23.rpy:2582
translate brazilian c23s006_AfterBreakfastBetConfession_a38307b1:

    # "Aún vais bien de tiempo."
    "Você ainda tem bastante tempo."

# game/scripts/c23/c23.rpy:2585
translate brazilian c23s006_AfterBreakfastBetConfession_75d8b8da:

    # emm "¿Cómo estás, Tía [bet]? ¿Nerviosa?"
    emm "Como vai, tia [bet]? Nervosa?"

# game/scripts/c23/c23.rpy:2587
translate brazilian c23s006_AfterBreakfastBetConfession_f3201952:

    # mcp "(Extrañamente [emm] se preocupa por otras personas en un día importante para ella. ¿Habrá entendido lo que significa la empatía?)"
    mcp "(Curiosamente, [emm] se preocupa com outras pessoas em um dia importante para ela. Será que ela finalmente compreendeu o significado de empatia?)"

# game/scripts/c23/c23.rpy:2589
translate brazilian c23s006_AfterBreakfastBetConfession_9823ca60:

    # bet "Sí, estoy nerviosa. No tengo ni idea de qué va a pasar en esa reunión, pero no soy capaz de encontrar ningún escenario bueno para mí."
    bet "Sim, estou nervoso. Não faço ideia do que vai acontecer nessa reunião, mas não consigo imaginar nenhum cenário que seja bom para mim."

# game/scripts/c23/c23.rpy:2590
translate brazilian c23s006_AfterBreakfastBetConfession_6d5eb0ec:

    # mc "El mejor escenario para ti sería que te destinasen a otro hospital en África, en otro país, ¿no?"
    mc "O melhor cenário para você seria ser designado para outro hospital na África, em outro país, não é?"

# game/scripts/c23/c23.rpy:2592
translate brazilian c23s006_AfterBreakfastBetConfession_5d599fd4:

    # emm "Eso no, Tía. Nadie quiere que te vayas ahora que te conocemos mejor y que la abuela se va a mudar aquí."
    emm "Não, tia. Ninguém quer que você vá embora agora que a conhecemos melhor e a vovó está se mudando para cá."

# game/scripts/c23/c23.rpy:2593
translate brazilian c23s006_AfterBreakfastBetConfession_65730c64:

    # mc "Pero no tenemos que ser egoístas, [emm]. Yo tampoco quiero que se vaya, pero si es lo que quiere ella..."
    mc "Mas não precisamos ser egoístas. Eu também não quero que ela vá embora, mas se é isso que ela quer..."

# game/scripts/c23/c23.rpy:2595
translate brazilian c23s006_AfterBreakfastBetConfession_17d2fc40:

    # bet "Gracias, chicos. Realmente aún no sé lo que quiero. Me gustaría volver a África."
    bet "Obrigado, pessoal. Eu realmente ainda não sei o que quero. Gostaria de voltar para a África."

# game/scripts/c23/c23.rpy:2596
translate brazilian c23s006_AfterBreakfastBetConfession_9408a313:

    # bet "Pero también me gustaría quedarme por aquí y trabajar en algún hospital que me permita veros más a menudo."
    bet "Mas eu também gostaria de ficar aqui e trabalhar em um hospital que me permitisse vê-los com mais frequência."

# game/scripts/c23/c23.rpy:2597
translate brazilian c23s006_AfterBreakfastBetConfession_a8285983:

    # bet "Incluso hay un par de hospitales católicos cerca de casa donde podría trabajar sin mudarme de Newport."
    bet "Existem até alguns hospitais católicos perto de casa onde eu poderia trabalhar sem precisar me mudar de Newport."

# game/scripts/c23/c23.rpy:2598
translate brazilian c23s006_AfterBreakfastBetConfession_7409e022:

    # mc "Eso sería fantástico. Nadie quiere que te vayas de casa, pero todos lo entenderíamos si decidieras volver a África."
    mc "Isso seria fantástico. Ninguém quer que você saia de casa, mas todos nós entenderíamos se você decidisse voltar para a África."

# game/scripts/c23/c23.rpy:2599
translate brazilian c23s006_AfterBreakfastBetConfession_927f1ed8:

    # mc "Bueno, quizás todos menos [emm]. *Risa*"
    mc "Bem, talvez todos, exceto [emm]. *Risos*"

# game/scripts/c23/c23.rpy:2601
translate brazilian c23s006_AfterBreakfastBetConfession_219cca74:

    # emm "*Risa* Ni siquiera que gastes bromas sobre mí va a poder estropearme el día."
    emm "*Risos* Nem mesmo suas piadas sobre mim vão estragar meu dia."

# game/scripts/c23/c23.rpy:2602
translate brazilian c23s006_AfterBreakfastBetConfession_6b3f5e74:

    # mc "Nunca querría estropearte el día, hermanita. Además, tengo una sorpresa para ti, para cuando lleguemos a Monterey."
    mc "Eu jamais gostaria de estragar o seu dia, irmãzinha. Além disso, tenho uma surpresa para você quando chegarmos a Monterey."

# game/scripts/c23/c23.rpy:2604
translate brazilian c23s006_AfterBreakfastBetConfession_5ffbefca:

    # emm "¿Qué es?"
    emm "O que é?"

# game/scripts/c23/c23.rpy:2605
translate brazilian c23s006_AfterBreakfastBetConfession_67e6de57:

    # mc "No te lo voy a decir. Si te lo dijera, ya no sería una sorpresa."
    mc "Não vou te contar. Se eu contasse, não seria mais surpresa."

# game/scripts/c23/c23.rpy:2607
translate brazilian c23s006_AfterBreakfastBetConfession_44cef866:

    # emm "Decirme que tienes una sorpresa para mí y no decirme qué es... Eso sí que podría estropearme el día..."
    emm "Dizer que você tem uma surpresa para mim e não me contar o que é... Isso poderia realmente arruinar meu dia..."

# game/scripts/c23/c23.rpy:2608
translate brazilian c23s006_AfterBreakfastBetConfession_d51f57a2:

    # mc "Los chantajes emocionales no sirven conmigo, [emm]."
    mc "Chantagem emocional não funciona comigo, [emm]."

# game/scripts/c23/c23.rpy:2610
translate brazilian c23s006_AfterBreakfastBetConfession_b8004bc0:

    # bet "Pero la chica lo tenía que intentar. *Risa*"
    bet "Mas a garota tinha que tentar. *Risos*"

# game/scripts/c23/c23.rpy:2613
translate brazilian c23s006_AfterBreakfastBetConfession_ddf38903:

    # bet "Si eso no funciona, siempre puedes amenazarle con castigarle sin sexo. *Risa* A otras mujeres les funciona."
    bet "Se isso não funcionar, você sempre pode ameaçar puni-lo negando-lhe sexo. *Risos* Funciona com outras mulheres."

# game/scripts/c23/c23.rpy:2615
translate brazilian c23s006_AfterBreakfastBetConfession_7a2d7a04:

    # emm "¡Eso no! ¡Eso sería más castigo para mí que para él!"
    emm "Não! Isso seria um castigo maior para mim do que para ele!"

# game/scripts/c23/c23.rpy:2616
translate brazilian c23s006_AfterBreakfastBetConfession_f92c1d53:

    # mc "*Risa* Además, tampoco funcionaría."
    mc "*Risos* Além disso, também não funcionaria."

# game/scripts/c23/c23.rpy:2618
translate brazilian c23s006_AfterBreakfastBetConfession_69504a21:

    # bet "¿Y tú que quieres hacer con el coche? ¿Quieres ir a algún sitio en particular o sólo conducir donde la carretera te lleve?"
    bet "E o que você pretende fazer com o carro? Quer ir a algum lugar específico ou apenas dirigir para onde a estrada o levar?"

# game/scripts/c23/c23.rpy:2620
translate brazilian c23s006_AfterBreakfastBetConfession_5f56d875:

    # emm "Había pensado en ir a ver Carmel, he leído que es bonito, y me gustaría hacer unas fotos."
    emm "Eu tinha pensado em ir visitar Carmel; li que é linda e gostaria de tirar algumas fotos."

# game/scripts/c23/c23.rpy:2621
translate brazilian c23s006_AfterBreakfastBetConfession_990a559a:

    # mc "Creo que hoy no tendremos mucho tiempo para hacer turismo."
    mc "Acho que não teremos muito tempo para passear hoje."

# game/scripts/c23/c23.rpy:2623
translate brazilian c23s006_AfterBreakfastBetConfession_37ddc11a:

    # emm "Lo sé. Y mañana tampoco si tenemos que devolver el coche a mediodía."
    emm "Eu sei. E nem amanhã, se tivermos que devolver o carro ao meio-dia."

# game/scripts/c23/c23.rpy:2624
translate brazilian c23s006_AfterBreakfastBetConfession_1f4d80be:

    # mc "Bueno, si no podemos ir a Carmel, te prometo que te llevaré un día cuando vuelva de Aruba."
    mc "Bem, se não pudermos ir a Carmel, prometo que te levarei lá um dia, quando voltar de Aruba."

# game/scripts/c23/c23.rpy:2625
translate brazilian c23s006_AfterBreakfastBetConfession_62ca9199:

    # emm "Me parece bien. Y ahora voy a dormir un poco."
    emm "Parece ótimo para mim. Agora vou dormir um pouco."

# game/scripts/c23/c23.rpy:2626
translate brazilian c23s006_AfterBreakfastBetConfession_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c23/c23.rpy:2628
translate brazilian c23s006_AfterBreakfastBetConfession_0740b24c:

    # bet "No la pongas de mal humor discutiendo con ella por una causa perdida, [mc]."
    bet "Não a perturbe discutindo com ela sobre uma causa perdida, [mc]."

# game/scripts/c23/c23.rpy:2629
translate brazilian c23s006_AfterBreakfastBetConfession_6c170086:

    # mc "Tienes razón. Va a hacer lo que quiera..."
    mc "Você tem razão. Ele vai fazer o que bem entender..."

# game/scripts/c23/c23.rpy:2631
translate brazilian c23s006_AfterBreakfastBetConfession_ae119aa5:

    # emm "Exacto. *Risita* Pero te haré caso y no me tumbaré. Si das un frenazo, voy a acabar con mi cara en el culo de Tía [bet]."
    emm "Exatamente. *Risos* Mas eu vou te ouvir e não vou me deitar. Se você frear bruscamente, eu vou acabar com a minha cara na bunda da tia [bet]."

# game/scripts/c23/c23.rpy:2632
translate brazilian c23s006_AfterBreakfastBetConfession_423c7e85:

    # emm "Despertadme antes de llegar, o si paramos para tomar un café."
    emm "Me acorde antes de chegarmos, ou se pararmos para tomar um café."

# game/scripts/c23/c23.rpy:2633
translate brazilian c23s006_AfterBreakfastBetConfession_7bf3a265:

    # mc "¿No vas a tener que parar para hacer pis? Siempre teníamos que parar por ti cada pocos kilómetros."
    mc "Você não vai precisar parar para fazer xixi? Nós sempre tínhamos que parar para você a cada poucos quilômetros."

# game/scripts/c23/c23.rpy:2635
translate brazilian c23s006_AfterBreakfastBetConfession_c77f999d:

    # emm "Si estoy durmiendo, no sabré si me estoy meando. *Risa* Con lo que os hago un favor echándome una siesta."
    emm "Se eu estiver dormindo, não vou saber se estou fazendo xixi. *Risos* Então, estou fazendo um favor a todos vocês tirando um cochilo."

# game/scripts/c23/c23.rpy:2636
translate brazilian c23s006_AfterBreakfastBetConfession_75a9a3a3:

    # mc "Estás aprendiendo a tener respuestas para todo."
    mc "Você está aprendendo a ter respostas para tudo."

# game/scripts/c23/c23.rpy:2638
translate brazilian c23s006_AfterBreakfastBetConfession_18ce4a7a:

    # "[bet] y tú charláis durante unos minutos hasta que os dais cuenta de que [emm] ya no hace ningún comentario."
    "[bet] e você conversa por alguns minutos até perceber que [emm] não está mais fazendo nenhum comentário."

# game/scripts/c23/c23.rpy:2639
translate brazilian c23s006_AfterBreakfastBetConfession_c09ba386:

    # mc "Ya se ha dormido, ¿no? ¡[emm.nick] mira, un tractor rosa!"
    mc "Ele já está dormindo, não é? Olha, um trator rosa!"

# game/scripts/c23/c23.rpy:2640
translate brazilian c23s006_AfterBreakfastBetConfession_26d40720:

    # bet "No reacciona. Está durmiendo como un tronco."
    bet "Ele não está reagindo. Está dormindo como uma pedra."

# game/scripts/c23/c23.rpy:2641
translate brazilian c23s006_AfterBreakfastBetConfession_6548d336:

    # mc "Entonces ahora podemos hablar tú y yo. No puedes huir de mí como has hecho los últimos dos días"
    mc "Então agora podemos conversar, você e eu. Você não pode fugir de mim como fez nesses últimos dois dias."

# game/scripts/c23/c23.rpy:2643
translate brazilian c23s006_AfterBreakfastBetConfession_37b36e4d:

    # bet "No he huido de ti. Tenía muchas cosas que hacer..."
    bet "Eu não fugi de você. Eu tinha muitas coisas para fazer..."

# game/scripts/c23/c23.rpy:2644
translate brazilian c23s006_AfterBreakfastBetConfession_e2fb14cc:

    # mc "Y una de ellas era esquivarme. Es culpa tuya que me haya dado cuenta."
    mc "E um deles estava me evitando. A culpa é sua por eu ter percebido."

# game/scripts/c23/c23.rpy:2646
translate brazilian c23s006_AfterBreakfastBetConfession_d05d7981:

    # bet "¿Mía? ¿Por qué? ¿Qué he hecho yo?"
    bet "Meu? Por quê? O que eu fiz?"

# game/scripts/c23/c23.rpy:2647
translate brazilian c23s006_AfterBreakfastBetConfession_acf5c598:

    # mc "Me enseñaste a reconocer los síntomas cuando alguien me esquiva. Como pasó con [kia]. Como está pasando contigo."
    mc "Você me ensinou a reconhecer os sinais de quando alguém está me evitando. Como aconteceu com [kia]. Como está acontecendo com você."

# game/scripts/c23/c23.rpy:2648
translate brazilian c23s006_AfterBreakfastBetConfession_5f814bcd:

    # mc "Desde el incidente con Meemaw me estás evitando."
    mc "Desde o incidente com a vovó, você tem me evitado."

# game/scripts/c23/c23.rpy:2651
translate brazilian c23s006_AfterBreakfastBetConfession_bbca009a:

    # bet "Bueno... fue un malentendido... "
    bet "Bem... foi um mal-entendido..."

# game/scripts/c23/c23.rpy:2654
translate brazilian c23s006_AfterBreakfastBetConfession_fec0dede:

    # bet "Veros como os vi... me sorprendió mucho..."
    bet "Ver você como eu te vi... me surpreendeu muito..."

# game/scripts/c23/c23.rpy:2655
translate brazilian c23s006_AfterBreakfastBetConfession_ab7f2a20:

    # mc "Me di cuenta."
    mc "Eu percebi isso."

# game/scripts/c23/c23.rpy:2657
translate brazilian c23s006_AfterBreakfastBetConfession_d704a074:

    # bet "Pero no creo que sea el mejor momento para hablar de esto, con [emm] ahí atrás."
    bet "Mas não acho que este seja o melhor momento para falar sobre isso, com [emm] ali atrás."

# game/scripts/c23/c23.rpy:2658
translate brazilian c23s006_AfterBreakfastBetConfession_0cab0d04:

    # mc "Está dormida como un tronco. Lo acabas de decir."
    mc "Ela está dormindo como uma pedra. Você acabou de dizer isso."

# game/scripts/c23/c23.rpy:2659
translate brazilian c23s006_AfterBreakfastBetConfession_914f0da8:

    # mc "Y si me sigues evitando, nunca podemos hablarlo. Creo que en estos dos días nuestra relación ha dado un paso atrás, como si hubieras perdido confianza en mí."
    mc "E se você continuar me evitando, nunca conseguiremos conversar sobre isso. Acho que nosso relacionamento deu um passo para trás nesses últimos dois dias, como se você tivesse perdido a confiança em mim."

# game/scripts/c23/c23.rpy:2661
translate brazilian c23s006_AfterBreakfastBetConfession_55e4dd28:

    # bet "No es eso, cariño. No puedo perder la confianza en ti, no has hecho nada merecedor de ello."
    bet "Não é isso, querida. Não posso perder a fé em você; você não fez nada para merecer isso."

# game/scripts/c23/c23.rpy:2662
translate brazilian c23s006_AfterBreakfastBetConfession_561f604b:

    # mc "Entonces explícamelo. No entiendo tu actitud de los últimos días, ni qué fue aquello de \"otra vez\" que dijiste en el baño."
    mc "Então me explique. Não entendo sua atitude nos últimos dias, nem o que você quis dizer com \"de novo\" no banheiro."

# game/scripts/c23/c23.rpy:2664
translate brazilian c23s006_AfterBreakfastBetConfession_894b0d96:

    # bet "¿Qué sabes de tu abuelo?"
    bet "O que você sabe sobre seu avô?"

# game/scripts/c23/c23.rpy:2666
translate brazilian c23s006_AfterBreakfastBetConfession_5fe65bdf:

    # bet "¿Qué sabes de John, el marido de [mee]?"
    bet "O que você sabe sobre John, marido de [mee]?"

# game/scripts/c23/c23.rpy:2667
translate brazilian c23s006_AfterBreakfastBetConfession_6992db62:

    # mc "¿Qué tiene que ver él en esto? Ahora estoy confundido."
    mc "O que ele tem a ver com isso? Agora estou confuso."

# game/scripts/c23/c23.rpy:2668
translate brazilian c23s006_AfterBreakfastBetConfession_9bd43ffa:

    # bet "¿Qué sabes de él?"
    bet "O que você sabe sobre ele?"

# game/scripts/c23/c23.rpy:2670
translate brazilian c23s006_AfterBreakfastBetConfession_5ea31eda:

    # mc "Lo que me han explicado Meemaw, mi madre, y [nor]. Se conocieron en la universidad, amor a primera vista, y un matrimonio feliz que acabó demasiado pronto."
    mc "O que a vovó, minha mãe, e [nor] me explicaram. Eles se conheceram na universidade, foi amor à primeira vista, e um casamento feliz terminou cedo demais."

# game/scripts/c23/c23.rpy:2672
translate brazilian c23s006_AfterBreakfastBetConfession_c5149e5a:

    # mc "Lo que me han explicado Meemaw y [nor]. Se conocieron en la universidad, amor a primera vista, y un matrimonio feliz que acabó demasiado pronto."
    mc "O que a vovó e o [nor] me explicaram. Eles se conheceram na universidade, foi amor à primeira vista, e um casamento feliz terminou cedo demais."

# game/scripts/c23/c23.rpy:2673
translate brazilian c23s006_AfterBreakfastBetConfession_f856635d:

    # mc "Y que parece que todo lo hacía bien y nunca se equivocaba en nada. Pero eso supongo que se debe a que ya no está entre nosotros."
    mc "E parece que ele fez tudo certo e nunca cometeu um erro. Mas suponho que isso se deva ao fato de ele não estar mais entre nós."

# game/scripts/c23/c23.rpy:2675
translate brazilian c23s006_AfterBreakfastBetConfession_e62be100:

    # bet "Sí y no. Hacía muchas cosas bien, pero también se equivocaba en muchas otras."
    bet "Sim e não. Ele fez muitas coisas bem, mas também cometeu muitos erros."

# game/scripts/c23/c23.rpy:2676
translate brazilian c23s006_AfterBreakfastBetConfession_a6bdd1ff:

    # bet "No, no era perfecto."
    bet "Não, não foi perfeito."

# game/scripts/c23/c23.rpy:2677
translate brazilian c23s006_AfterBreakfastBetConfession_1b377091:

    # mc "Bueno, nadie lo es. Pero una vez alguien se muere, normalmente se olvidan las cosas malas que hizo. A menos que fuera un hijo de puta."
    mc "Bem, ninguém é. Mas quando alguém morre, as coisas ruins que fez geralmente são esquecidas. A menos que fosse um filho da puta."

# game/scripts/c23/c23.rpy:2678
translate brazilian c23s006_AfterBreakfastBetConfession_526ca8a7:

    # mc "Entonces se olvidan las buenas, si es que hizo alguna."
    mc "Então, as coisas boas são esquecidas, se é que ele fez alguma."

# game/scripts/c23/c23.rpy:2680
translate brazilian c23s006_AfterBreakfastBetConfession_7f0c7e18:

    # bet "No, con John no era así. De sus equivocaciones te olvidabas a los cinco minutos."
    bet "Não, com o John não era assim. Você esquecia dos erros dele em cinco minutos."

# game/scripts/c23/c23.rpy:2681
translate brazilian c23s006_AfterBreakfastBetConfession_edf7a302:

    # bet "Tenía un don para que sus aciertos y éxitos pesaran mucho más que sus fallos y sus fracasos."
    bet "Ele tinha um talento especial para fazer com que seus sucessos e conquistas superassem em muito seus fracassos e erros."

# game/scripts/c23/c23.rpy:2683
translate brazilian c23s006_AfterBreakfastBetConfession_2b3e9541:

    # bet "Tenía un carisma especial para hacer que ni te fijaras en sus carencias o en lo que hacía mal."
    bet "Ele possuía um carisma especial que fazia com que você nem percebesse suas falhas ou seus erros."

# game/scripts/c23/c23.rpy:2684
translate brazilian c23s006_AfterBreakfastBetConfession_4fd6f76e:

    # bet "Como siempre estaba haciendo cosas por los demás, todo el mundo pensaba que él no tenía problemas propios."
    bet "Como ele estava sempre fazendo coisas pelos outros, todos pensavam que ele não tinha problemas próprios."

# game/scripts/c23/c23.rpy:2685
translate brazilian c23s006_AfterBreakfastBetConfession_477e8157:

    # bet "Tú te pareces mucho a él. Más de lo que incluso [mee] ha descubierto."
    bet "Você se parece muito com ele. Mais do que até mesmo [mee] percebeu."

# game/scripts/c23/c23.rpy:2686
translate brazilian c23s006_AfterBreakfastBetConfession_45f202a6:

    # mc "Gracias, supongo. A veces lo describís como si meara whisky y sus pedos fueran arcoíris."
    mc "Obrigado, eu acho. Às vezes você o descreve como se ele urinasse uísque e seus peidos fossem arco-íris."

# game/scripts/c23/c23.rpy:2688
translate brazilian c23s006_AfterBreakfastBetConfession_c5817933:

    # bet "*Risa* Te puedo asegurar que sus pedos NO eran arcoíris. Sabías que había estado en una habitación horas después de que se fuera."
    bet "*Risos* Posso garantir que os peidos dele NÃO eram arco-íris. Você sabia que ele tinha ficado no quarto horas depois de sair."

# game/scripts/c23/c23.rpy:2689
translate brazilian c23s006_AfterBreakfastBetConfession_49aba72c:

    # bet "Bromeábamos con que no fue a Vietnam porque se le consideraba un arma química con piernas. *Risa*"
    bet "Brincamos que ele não foi para o Vietnã porque era considerado uma arma química ambulante. *Risos*"

# game/scripts/c23/c23.rpy:2690
translate brazilian c23s006_AfterBreakfastBetConfession_44f9ad22:

    # mc "*Risa* Bueno, al menos en eso no me parezco a él... creo."
    mc "*Risos* Bom, pelo menos nisso eu não sou como ele... eu acho."

# game/scripts/c23/c23.rpy:2692
translate brazilian c23s006_AfterBreakfastBetConfession_331c1e76:

    # bet "Sobre el resto, como resumen está bien. Se conocieron cuando [mee] iba a la universidad. John ya había acabado."
    bet "Quanto ao resto, é um bom resumo. Eles se conheceram quando [mee] estava na universidade. John já havia se formado."

# game/scripts/c23/c23.rpy:2693
translate brazilian c23s006_AfterBreakfastBetConfession_b8677642:

    # bet "[mee] estaba en su tercer año en San Luis Obispo y yo acababa de empezar en Stanford."
    bet "[mee] estava no terceiro ano em San Luis Obispo e eu tinha acabado de começar em Stanford."

# game/scripts/c23/c23.rpy:2694
translate brazilian c23s006_AfterBreakfastBetConfession_396c3c56:

    # bet "John estaba trabajando en un pequeño estudio de arquitectura en San Francisco."
    bet "John trabalhava em um pequeno escritório de arquitetura em São Francisco."

# game/scripts/c23/c23.rpy:2696
translate brazilian c23s006_AfterBreakfastBetConfession_39888221:

    # mc "Sigo sin entender qué tiene que ver el abuelo en todo esto."
    mc "Ainda não entendo o que o avô tem a ver com tudo isso."

# game/scripts/c23/c23.rpy:2698
translate brazilian c23s006_AfterBreakfastBetConfession_c44ca57b:

    # mc "Sigo sin entender qué tiene que ver John en todo esto."
    mc "Ainda não entendo o que John tem a ver com tudo isso."

# game/scripts/c23/c23.rpy:2700
translate brazilian c23s006_AfterBreakfastBetConfession_68f149a5:

    # bet "Déjame continuar y lo entenderás."
    bet "Deixe-me continuar e você entenderá."

# game/scripts/c23/c23.rpy:2701
translate brazilian c23s006_AfterBreakfastBetConfession_67102796:

    # bet "Yo conocí a John antes que [mee]. Me lo presentó un amigo común."
    bet "Eu conheci John antes [mee]. Um amigo em comum nos apresentou."

# game/scripts/c23/c23.rpy:2702
translate brazilian c23s006_AfterBreakfastBetConfession_9f83902b:

    # mc "¿Os llevabais bien?"
    mc "Vocês se davam bem?"

# game/scripts/c23/c23.rpy:2704
translate brazilian c23s006_AfterBreakfastBetConfession_325bf1ea:

    # bet "Nos hicimos amigos en seguida."
    bet "Nos tornamos amigos imediatamente."

# game/scripts/c23/c23.rpy:2705
translate brazilian c23s006_AfterBreakfastBetConfession_baea9b98:

    # bet "Teníamos un sentido del humor muy parecido, a los dos nos gustaba pasear, y salía con mi grupo de amigos los fines de semana."
    bet "Tínhamos um senso de humor muito parecido, ambos gostávamos de passear e eu saía com meu grupo de amigos nos fins de semana."

# game/scripts/c23/c23.rpy:2706
translate brazilian c23s006_AfterBreakfastBetConfession_8516836a:

    # bet "Era el mayor de todos nosotros, pero eso era bueno. Arnold no había sido gobernador y la edad para beber eran 21 todavía."
    bet "Ele era o mais velho de todos nós, mas isso era uma coisa boa. Arnold ainda não tinha sido governador, e a idade legal para beber ainda era 21 anos."

# game/scripts/c23/c23.rpy:2707
translate brazilian c23s006_AfterBreakfastBetConfession_9494eba4:

    # mc "¿Lo llevabais para que os comprara alcohol? *Risa*"
    mc "Você o trouxe para que ele comprasse bebida alcoólica para você? *Risos*"

# game/scripts/c23/c23.rpy:2709
translate brazilian c23s006_AfterBreakfastBetConfession_ad5fa407:

    # bet "Eran los setenta... conseguir alcohol... y otras cosas... era fácil. *Risa* Pero sí, él nos compraba las bebidas."
    bet "Eram os anos setenta... conseguir álcool... e outras coisas... era fácil. *Risos* Mas sim, ele comprava bebidas para nós."

# game/scripts/c23/c23.rpy:2710
translate brazilian c23s006_AfterBreakfastBetConfession_20ab19b8:

    # mc "*Risa* Tía [bet] en plan malota, bebiendo... y haciendo otras cosas... ilegalmente. Me hubiera gustado conocerte en aquella época."
    mc "*Risos* Tia [bet] bancando a durona, bebendo... e fazendo outras coisas... ilegais. Eu queria ter te conhecido naquela época."

# game/scripts/c23/c23.rpy:2712
translate brazilian c23s006_AfterBreakfastBetConfession_60943014:

    # bet "*Risa* Yo era una chiquilla divertida en aquella época. Creo que nos hubiéramos llevado bien."
    bet "*Risos* Eu era uma criança muito divertida naquela época. Acho que teríamos nos dado bem."

# game/scripts/c23/c23.rpy:2713
translate brazilian c23s006_AfterBreakfastBetConfession_f51ac469:

    # mc "Sigues siendo divertida y nos llevamos bien. No ha cambiado nada."
    mc "Você continua sendo uma pessoa divertida e nos damos muito bem. Nada mudou."

# game/scripts/c23/c23.rpy:2715
translate brazilian c23s006_AfterBreakfastBetConfession_55459c89:

    # bet "Excepto que tengo 46 años más que entonces..."
    bet "Só que agora estou 46 anos mais velho do que naquela época..."

# game/scripts/c23/c23.rpy:2716
translate brazilian c23s006_AfterBreakfastBetConfession_395d9e0e:

    # mc "Bueno, la edad sólo es un número. Si te sientes joven eres joven."
    mc "Bem, a idade é apenas um número. Se você se sente jovem, você é jovem."

# game/scripts/c23/c23.rpy:2718
translate brazilian c23s006_AfterBreakfastBetConfession_1bb5e936:

    # bet "¡Qué fácil parece todo a tu edad!"
    bet "Tudo parece tão fácil na sua idade!"

# game/scripts/c23/c23.rpy:2719
translate brazilian c23s006_AfterBreakfastBetConfession_6e1125b6:

    # bet "Pero volviendo a John..."
    bet "Mas voltando a John..."

# game/scripts/c23/c23.rpy:2720
translate brazilian c23s006_AfterBreakfastBetConfession_720e0757:

    # bet "Nos llevábamos tan bien que empecé a ver cosas dónde no las había."
    bet "Nós nos dávamos tão bem que comecei a ver coisas onde não existiam."

# game/scripts/c23/c23.rpy:2721
translate brazilian c23s006_AfterBreakfastBetConfession_e3c28eeb:

    # bet "Me hacía la encontradiza con él para verlo, paseaba cerca de su trabajo, de su casa..."
    bet "Eu tentaria encontrá-lo por acaso, caminharia perto do seu trabalho, perto da sua casa..."

# game/scripts/c23/c23.rpy:2722
translate brazilian c23s006_AfterBreakfastBetConfession_83728b01:

    # mc "Vaya, que te enamoraste como una adolescente."
    mc "Nossa, você se apaixonou como um adolescente."

# game/scripts/c23/c23.rpy:2724
translate brazilian c23s006_AfterBreakfastBetConfession_de131cf3:

    # bet "*Risa triste* ¡Era una adolescente!"
    bet "*Risada triste* Ela era uma adolescente!"

# game/scripts/c23/c23.rpy:2725
translate brazilian c23s006_AfterBreakfastBetConfession_c9cdb920:

    # bet "Pero sí, enamorada hasta las trancas. Y un poco acosadora."
    bet "Mas sim, completamente apaixonada. E um pouco stalker."

# game/scripts/c23/c23.rpy:2726
translate brazilian c23s006_AfterBreakfastBetConfession_bfcfc81c:

    # mc "Esas cosas pasan cuando eres joven."
    mc "Essas coisas acontecem quando você é jovem."

# game/scripts/c23/c23.rpy:2728
translate brazilian c23s006_AfterBreakfastBetConfession_90cc7385:

    # bet "Ya te dije que yo vivía en una caravana cerca del campus, ¿no?"
    bet "Eu já te disse que morava em um trailer perto do campus, né?"

# game/scripts/c23/c23.rpy:2729
translate brazilian c23s006_AfterBreakfastBetConfession_0e7ce500:

    # mc "Sí, la caravana rosa de la que [emm] estaría orgullosa."
    mc "Sim, a caravana rosa da qual [emm] se orgulharia."

# game/scripts/c23/c23.rpy:2731
translate brazilian c23s006_AfterBreakfastBetConfession_5e564651:

    # bet "Pues [mee] vino a visitarme un fin de semana, se iba a quedar a dormir en la caravana el viernes y el sábado."
    bet "Bem, [mee] veio me visitar durante um fim de semana, ele ia passar a noite no trailer na sexta e no sábado."

# game/scripts/c23/c23.rpy:2733
translate brazilian c23s006_AfterBreakfastBetConfession_83578eae:

    # mc "Y conoció al abuelo."
    mc "E ele conheceu seu avô."

# game/scripts/c23/c23.rpy:2735
translate brazilian c23s006_AfterBreakfastBetConfession_f0d2d10b:

    # mc "Y conoció a John."
    mc "E ela conheceu John."

# game/scripts/c23/c23.rpy:2737
translate brazilian c23s006_AfterBreakfastBetConfession_9c437df7:

    # bet "Exacto. La llevé a una bar, donde había quedado con mi grupo de amigos y se la presenté a todo el mundo."
    bet "Exatamente. Levei-a a um bar, onde ia encontrar meu grupo de amigos, e a apresentei a todos."

# game/scripts/c23/c23.rpy:2738
translate brazilian c23s006_AfterBreakfastBetConfession_aff28618:

    # bet "Y ahí entra lo que tú conoces. Amor a primera vista."
    bet "E é aí que entra o seu conhecimento. Amor à primeira vista."

# game/scripts/c23/c23.rpy:2739
translate brazilian c23s006_AfterBreakfastBetConfession_907e6dd5:

    # bet "Él arquitecto. Ella estudiando arquitectura. Empezaron a charlar y encajaron."
    bet "Ele era arquiteto. Ela estudava arquitetura. Começaram a conversar e se deram muito bem."

# game/scripts/c23/c23.rpy:2741
translate brazilian c23s006_AfterBreakfastBetConfession_ea724bd7:

    # bet "Parecía que el resto del mundo no existía para ellos, como si fuéramos estatuas decorativas del bar."
    bet "Parecia que o resto do mundo não existia para eles, como se fôssemos estátuas decorativas no bar."

# game/scripts/c23/c23.rpy:2742
translate brazilian c23s006_AfterBreakfastBetConfession_fabb8ff0:

    # bet "Se pasaron toda la noche juntos, charlando y riendo. Conociéndose."
    bet "Eles passaram a noite toda juntos, conversando e rindo. Conhecendo-se melhor."

# game/scripts/c23/c23.rpy:2743
translate brazilian c23s006_AfterBreakfastBetConfession_a5680026:

    # mc "Y tú te sentiste fatal."
    mc "E você se sentiu péssimo."

# game/scripts/c23/c23.rpy:2745
translate brazilian c23s006_AfterBreakfastBetConfession_2d672509:

    # bet "Sí. No quiero endulzarlo. *Risa* Me comporté como una niña celosa de mi propia hermana."
    bet "Sim. Não quero dourar a pílula. *Risos* Eu me comportei como uma menininha ciumenta com a minha própria irmã."

# game/scripts/c23/c23.rpy:2746
translate brazilian c23s006_AfterBreakfastBetConfession_8afc0df8:

    # bet "*Risa* Me pasé toda la noche pensando en mil formas de asesinar a [mee] cuando fuéramos a la caravana a dormir."
    bet "*Risos* Passei a noite toda pensando em mil maneiras de assassinar [mee] quando fomos dormir no trailer."

# game/scripts/c23/c23.rpy:2747
translate brazilian c23s006_AfterBreakfastBetConfession_8411fb7d:

    # mc "Pero no lo hiciste. *Risa* Si todos los asesinatos mentales sucedieran, no quedaría nadie en el mundo."
    mc "Mas você não fez isso. *Risos* Se todos os assassinatos por perturbação mental acontecessem, não sobraria ninguém no mundo."

# game/scripts/c23/c23.rpy:2749
translate brazilian c23s006_AfterBreakfastBetConfession_ba3e7d41:

    # bet "No lo hice porque [mee] no vino a dormir a la caravana ninguna de las dos noches."
    bet "Eu não fiz isso porque [mee] não veio dormir na caravana em nenhuma das duas noites."

# game/scripts/c23/c23.rpy:2750
translate brazilian c23s006_AfterBreakfastBetConfession_e04a5c20:

    # mc "Eso es sorprendente, viniendo de Meemaw."
    mc "Isso é surpreendente, vindo da vovó."

# game/scripts/c23/c23.rpy:2752
translate brazilian c23s006_AfterBreakfastBetConfession_bb687e89:

    # bet "Ella también era joven entonces. *Risa* Y recuerda lo del amor a primera vista."
    bet "Ela também era jovem naquela época. *Risos* E lembre-se daquela coisa de amor à primeira vista."

# game/scripts/c23/c23.rpy:2753
translate brazilian c23s006_AfterBreakfastBetConfession_7c5b2432:

    # mc "Amor a primera vista y sexo a primer parpadeo. *Risa* Pero sigo sin entender qué tiene que ver eso con lo que pasó el otro día."
    mc "Amor à primeira vista e sexo à primeira piscada. *Risos* Mas ainda não entendi o que isso tem a ver com o que aconteceu outro dia."

# game/scripts/c23/c23.rpy:2755
translate brazilian c23s006_AfterBreakfastBetConfession_77c5b7ce:

    # bet "Ni [mee] ni John sabían lo que yo sentía por él. Con lo que di un paso a un lado y empecé mi descenso a los infiernos."
    bet "Nem [mee] nem John sabiam o que eu sentia por ele. Então, dei um passo para o lado e comecei minha descida ao inferno."

# game/scripts/c23/c23.rpy:2756
translate brazilian c23s006_AfterBreakfastBetConfession_ba4ae07c:

    # mc "Así que John es quien, sin saberlo, te empujó a frecuentar esas compañías inadecuadas de las que hablaste."
    mc "Então foi o John quem, sem saber, te incentivou a frequentar aquelas empresas inadequadas que você mencionou."

# game/scripts/c23/c23.rpy:2757
translate brazilian c23s006_AfterBreakfastBetConfession_2b019f8b:

    # mc "Y finalmente hacerte monja..."
    mc "E, por fim, torne-se freira..."

# game/scripts/c23/c23.rpy:2759
translate brazilian c23s006_AfterBreakfastBetConfession_433c9882:

    # bet "No, no me empujó él. Me empujó el no saber gestionar mis emociones."
    bet "Não, ele não me empurrou. Foi a minha incapacidade de controlar as minhas emoções que me empurrou."

# game/scripts/c23/c23.rpy:2760
translate brazilian c23s006_AfterBreakfastBetConfession_ab94bc8b:

    # bet "Era una niña imbécil que no podía soportar ver al hombre del que me había enamorado con otra."
    bet "Eu era uma garota boba que não suportava ver o homem por quem me apaixonei com outra mulher."

# game/scripts/c23/c23.rpy:2761
translate brazilian c23s006_AfterBreakfastBetConfession_dd5d1635:

    # bet "Y menos aún con mi hermana."
    bet "E muito menos com a minha irmã."

# game/scripts/c23/c23.rpy:2763
translate brazilian c23s006_AfterBreakfastBetConfession_e194d768:

    # bet "Sentía como si [mee] me lo hubiera robado. *Risa triste* No me podía robar algo que nunca fue mío, pero era como me sentía."
    bet "Senti como se [mee] tivesse roubado de mim. *Risada triste* Eu não podia roubar algo que nunca foi meu, mas era assim que eu me sentia."

# game/scripts/c23/c23.rpy:2764
translate brazilian c23s006_AfterBreakfastBetConfession_55a20160:

    # mc "Te entiendo. Las comidas familiares tuvieron que ser una pesadilla para ti."
    mc "Entendo. As refeições em família deviam ser um pesadelo para você."

# game/scripts/c23/c23.rpy:2766
translate brazilian c23s006_AfterBreakfastBetConfession_d4ba9580:

    # bet "Lo fueron durante un tiempo, la boda de [mee] incluida. Después ya no."
    bet "Eles estiveram juntos por um tempo, inclusive no casamento de [mee]. Depois, deixaram de estar."

# game/scripts/c23/c23.rpy:2767
translate brazilian c23s006_AfterBreakfastBetConfession_636b4824:

    # bet "Me alegré mucho por ellos, pero dejé de ir a esas comidas. Siempre buscaba una excusa para quedarme en Stanford."
    bet "Fiquei muito feliz por eles, mas parei de ir a essas refeições. Eu estava sempre procurando uma desculpa para ficar em Stanford."

# game/scripts/c23/c23.rpy:2769
translate brazilian c23s006_AfterBreakfastBetConfession_e4232a8c:

    # bet "Eso me distanció de [mee] y de tus bisabuelos. Me sentí muy sola durante años."
    bet "Isso me afastou de [mee] e de seus bisavós. Me senti muito sozinho por anos."

# game/scripts/c23/c23.rpy:2771
translate brazilian c23s006_AfterBreakfastBetConfession_a13fabc5:

    # bet "Eso me distanció de [mee] y de mis padres. Me sentí muy sola durante años"
    bet "Isso me afastou de [mee] e dos meus pais. Me senti muito sozinho por anos."

# game/scripts/c23/c23.rpy:2772
translate brazilian c23s006_AfterBreakfastBetConfession_5e2cf973:

    # mc "Y encontraste a la iglesia que llenó ese vacío."
    mc "E você encontrou a igreja que preencheu esse vazio."

# game/scripts/c23/c23.rpy:2774
translate brazilian c23s006_AfterBreakfastBetConfession_23b458a9:

    # bet "Sí, pero fue mucho más tarde. Me volqué en estudiar primero y en trabajar después."
    bet "Sim, mas foi bem mais tarde. Primeiro me concentrei nos estudos e depois deixei para trabalhar."

# game/scripts/c23/c23.rpy:2775
translate brazilian c23s006_AfterBreakfastBetConfession_2fb56829:

    # bet "Cuando acabé la carrera, mientras hacía la residencia en San José descubrí que la religión ayudaba a muchas personas a superar sus pérdidas."
    bet "Ao concluir minha graduação, durante minha residência em San Jose, descobri que a religião ajudava muitas pessoas a superar suas perdas."

# game/scripts/c23/c23.rpy:2777
translate brazilian c23s006_AfterBreakfastBetConfession_3f08b0e8:

    # bet "Empecé a ir a la iglesia y poco tiempo después lo dejé todo atrás y me hice monja. El resto ya lo sabes."
    bet "Comecei a frequentar a igreja, e pouco tempo depois deixei tudo para trás e me tornei freira. Você sabe o resto."

# game/scripts/c23/c23.rpy:2779
translate brazilian c23s006_AfterBreakfastBetConfession_f8cafc43:

    # mc "Y todo ese tiempo estuviste enamorada del abuelo, ¿no? ¿Hasta que murió?"
    mc "E durante todo esse tempo você esteve apaixonada pelo seu avô, não é? Até ele morrer?"

# game/scripts/c23/c23.rpy:2781
translate brazilian c23s006_AfterBreakfastBetConfession_14e82712:

    # mc "Y todo ese tiempo estuviste enamorada de John, ¿no? ¿Hasta que murió?"
    mc "E durante todo esse tempo você esteve apaixonada por John, não é? Até ele morrer?"

# game/scripts/c23/c23.rpy:2783
translate brazilian c23s006_AfterBreakfastBetConfession_979cf0f8:

    # bet "No tanto, pero lo estuve durante mucho tiempo."
    bet "Não muito, mas estive lá por um longo tempo."

# game/scripts/c23/c23.rpy:2784
translate brazilian c23s006_AfterBreakfastBetConfession_0f4baa8f:

    # bet "Hasta que, a principios de los 90, me fui a África y descubrí que mis problemas eran nimiedades comparados con los del resto del mundo."
    bet "Até que, no início dos anos 90, fui para a África e descobri que meus problemas eram insignificantes em comparação com os do resto do mundo."

# game/scripts/c23/c23.rpy:2785
translate brazilian c23s006_AfterBreakfastBetConfession_e649715c:

    # bet "Una historia de amor no correspondido que duró más de 10 años, y en la que no hay culpables aparte de mí."
    bet "Uma história de amor não correspondido que durou mais de 10 anos, e na qual não há culpados além de mim."

# game/scripts/c23/c23.rpy:2786
translate brazilian c23s006_AfterBreakfastBetConfession_d12f1b69:

    # mc "No creo que haya culpables, ni siquiera tú. Te enamoraste y lo guardaste en silencio. Otra mujer se llevó al chico."
    mc "Não acho que haja culpa de ninguém, nem mesmo sua. Você se apaixonou e guardou isso para si. Outra mulher levou o rapaz embora."

# game/scripts/c23/c23.rpy:2788
translate brazilian c23s006_AfterBreakfastBetConfession_d68451be:

    # bet "Por eso es por lo que más culpable me sentí todos esos años. Mi cabeza estaba llena de escenarios que no pasaron."
    bet "Por isso, durante todos esses anos, me senti extremamente culpada. Minha cabeça estava cheia de cenários que não aconteceram."

# game/scripts/c23/c23.rpy:2789
translate brazilian c23s006_AfterBreakfastBetConfession_b10aa4ec:

    # bet "¿Qué hubiera pasado si le hubiera dicho a John lo que sentía por él antes de presentarle a [mee]?"
    bet "O que teria acontecido se eu tivesse contado a John como me sentia em relação a ele antes de apresentá-lo a [mee]?"

# game/scripts/c23/c23.rpy:2790
translate brazilian c23s006_AfterBreakfastBetConfession_360a42cb:

    # bet "¿Hubiera sido correspondida? ¿Hubiéramos durado? ¿Hubiera sido un matrimonio tan bonito como el que tuvo [mee]?"
    bet "Meus sentimentos teriam sido correspondidos? Teríamos durado? Teria sido um casamento tão bonito quanto o que [mee] teve?"

# game/scripts/c23/c23.rpy:2791
translate brazilian c23s006_AfterBreakfastBetConfession_3d127226:

    # mc "Son cosas que no puedes saber, con lo que no tienes que pensar en eso. Solo te harás daño."
    mc "São coisas que você não pode saber, então não deve ficar remoendo-as. Você só vai se machucar."

# game/scripts/c23/c23.rpy:2793
translate brazilian c23s006_AfterBreakfastBetConfession_c05bd513:

    # bet "Hacía años que no pensaba en eso. Hasta que pasó lo del otro día."
    bet "Eu não pensava nisso há anos. Até o que aconteceu outro dia."

# game/scripts/c23/c23.rpy:2794
translate brazilian c23s006_AfterBreakfastBetConfession_e266889c:

    # mc "Y ahí vino el \"Otra vez\". Estabas viviendo otra vez lo mismo, con la misma persona."
    mc "E então veio o \"De novo\". Você estava passando pela mesma coisa de novo, com a mesma pessoa."

# game/scripts/c23/c23.rpy:2796
translate brazilian c23s006_AfterBreakfastBetConfession_e608e602:

    # mc "Pero esta vez era yo en vez del abuelo."
    mc "Mas desta vez fui eu, em vez do vovô."

# game/scripts/c23/c23.rpy:2798
translate brazilian c23s006_AfterBreakfastBetConfession_5ac837c0:

    # mc "Pero esta vez era yo en vez de John."
    mc "Mas desta vez fui eu, em vez de John."

# game/scripts/c23/c23.rpy:2800
translate brazilian c23s006_AfterBreakfastBetConfession_5d2be7a8:

    # bet "No pareces sorprendido."
    bet "Você não parece surpreso."

# game/scripts/c23/c23.rpy:2801
translate brazilian c23s006_AfterBreakfastBetConfession_22eb8a58:

    # mc "No lo estoy. Empecé a sospecharlo aquel día en el que hablamos de por qué [kia] me estaba evitando."
    mc "Não sou. Comecei a suspeitar disso naquele dia em que conversamos sobre por que [kia] estava me evitando."

# game/scripts/c23/c23.rpy:2802
translate brazilian c23s006_AfterBreakfastBetConfession_4a03f641:

    # mc "Después de lo que pasó en el baño, has sido tú la que me evitabas."
    mc "Depois do que aconteceu no banheiro, você foi quem me evitou."

# game/scripts/c23/c23.rpy:2803
translate brazilian c23s006_AfterBreakfastBetConfession_dc27d420:

    # mc "Y tu historia me ha dado el contexto para entender el \"Otra vez\", que era la única pieza que me faltaba."
    mc "E sua história me deu o contexto para entender o \"De novo\", que era a única peça que me faltava."

# game/scripts/c23/c23.rpy:2805
translate brazilian c23s006_AfterBreakfastBetConfession_eaa2602f:

    # bet "Pues ahora lo entiendes todo. Me siento estúpida."
    bet "Agora você entendeu tudo. Eu me sinto um idiota."

# game/scripts/c23/c23.rpy:2806
translate brazilian c23s006_AfterBreakfastBetConfession_b3961c59:

    # mc "¿Por qué?"
    mc "Porque?"

# game/scripts/c23/c23.rpy:2808
translate brazilian c23s006_AfterBreakfastBetConfession_dc1ef5d1:

    # bet "Por mil razones. Porque me he vuelto a enamorar de una persona que no debo."
    bet "Por mil razões. Porque me apaixonei novamente por alguém por quem não deveria."

# game/scripts/c23/c23.rpy:2810
translate brazilian c23s006_AfterBreakfastBetConfession_92d4465f:

    # bet "Porque esa persona es mi sobrino nieto."
    bet "Porque essa pessoa é meu sobrinho-neto."

# game/scripts/c23/c23.rpy:2811
translate brazilian c23s006_AfterBreakfastBetConfession_0e60839f:

    # bet "Porque soy 1,000 años mayor que él."
    bet "Porque eu sou 1.000 anos mais velho que ele."

# game/scripts/c23/c23.rpy:2812
translate brazilian c23s006_AfterBreakfastBetConfession_03e19a9b:

    # bet "Porque, aunque existiera la remota posibilidad de que quisieras estar conmigo, yo no podría porque soy monja."
    bet "Porque, mesmo que houvesse uma remota possibilidade de você querer ficar comigo, eu não poderia, pois sou freira."

# game/scripts/c23/c23.rpy:2813
translate brazilian c23s006_AfterBreakfastBetConfession_8949cccb:

    # bet "Porque soy una vieja estúpida..."
    bet "Porque sou uma velha estúpida..."

# game/scripts/c23/c23.rpy:2814
translate brazilian c23s006_AfterBreakfastBetConfession_ad386c7e:

    # mc "Te voy a hacer dos preguntas, que es lo único que no he entendido."
    mc "Vou te fazer duas perguntas, que são as únicas coisas que eu não entendi."

# game/scripts/c23/c23.rpy:2815
translate brazilian c23s006_AfterBreakfastBetConfession_269ca14d:

    # bet "Dime..."
    bet "Diga-me..."

# game/scripts/c23/c23.rpy:2817
translate brazilian c23s006_AfterBreakfastBetConfession_93174448:

    # mc "¿Te has enamorado de mí o del reflejo que ves del abuelo en mí?"
    mc "Você se apaixonou por mim ou pelo reflexo que vê em mim do seu avô?"

# game/scripts/c23/c23.rpy:2819
translate brazilian c23s006_AfterBreakfastBetConfession_025c7aa9:

    # mc "¿Te has enamorado de mí o del reflejo que ves de John en mí?"
    mc "Você se apaixonou por mim ou pelo reflexo de John que vê em mim?"

# game/scripts/c23/c23.rpy:2821
translate brazilian c23s006_AfterBreakfastBetConfession_0d0dbd6c:

    # bet "¿Cuándo te has vuelto así?"
    bet "Quando você ficou assim?"

# game/scripts/c23/c23.rpy:2822
translate brazilian c23s006_AfterBreakfastBetConfession_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "O que você está falando?"

# game/scripts/c23/c23.rpy:2823
translate brazilian c23s006_AfterBreakfastBetConfession_3551d6e0:

    # bet "Hace dos semanas no hubieras preguntado eso. No te hubieras ni siquiera dado cuenta. Ni te lo hubieras planteado."
    bet "Duas semanas atrás você não teria perguntado isso. Você nem teria notado. Você nem teria considerado a possibilidade."

# game/scripts/c23/c23.rpy:2824
translate brazilian c23s006_AfterBreakfastBetConfession_e6c9391d:

    # mc "He tenido una buena maestra a la hora de observar cosas. No he pasado tanto tiempo contigo como me gustaría, pero el suficiente para aprender algunos trucos."
    mc "Tive um bom professor no que diz respeito à observação. Não passei tanto tempo com você quanto gostaria, mas o suficiente para aprender alguns truques."

# game/scripts/c23/c23.rpy:2826
translate brazilian c23s006_AfterBreakfastBetConfession_1c7cf176:

    # bet "Empecé en pensar en ti de una forma inapropiada porque me recordabas a John."
    bet "Comecei a pensar em você de uma forma inadequada porque você me lembrava o John."

# game/scripts/c23/c23.rpy:2827
translate brazilian c23s006_AfterBreakfastBetConfession_0df00951:

    # bet "Pero me he dado cuenta de que lo que me gusta de ti son las cosas que te hacen diferente a él."
    bet "Mas percebi que o que eu gosto em você são as coisas que te diferenciam dele."

# game/scripts/c23/c23.rpy:2828
translate brazilian c23s006_AfterBreakfastBetConfession_f47f1290:

    # mc "Lo que significa que no era tan perfecto... pedos aparte."
    mc "O que significa que não foi tão perfeito assim... peidos à parte."

# game/scripts/c23/c23.rpy:2830
translate brazilian c23s006_AfterBreakfastBetConfession_f0e80352:

    # bet "*Risa* No era perfecto. Y tú tampoco lo eres, no empieces a buscar un pedestal al que subirte."
    bet "*Risos* Ele não era perfeito. E você também não é, não comece a procurar um pedestal para subir."

# game/scripts/c23/c23.rpy:2831
translate brazilian c23s006_AfterBreakfastBetConfession_83479e7a:

    # bet "Pero tú tienes virtudes que él no tenía, y algunas que él tenía son más grandes en ti. Pero lo mismo pasa con los defectos."
    bet "Mas você possui virtudes que ele não tinha, e algumas das virtudes que ele possuía são ainda maiores em você. O mesmo se aplica aos seus defeitos."

# game/scripts/c23/c23.rpy:2833
translate brazilian c23s006_AfterBreakfastBetConfession_ccd78334:

    # bet "Tan solo es que... tu combinación de virtudes y defectos es diferente..."
    bet "É que... a sua combinação de pontos fortes e fracos é diferente..."

# game/scripts/c23/c23.rpy:2834
translate brazilian c23s006_AfterBreakfastBetConfession_e0946371:

    # bet "Me recuerdas mucho a él. También a [mee] se lo recuerdas. Pero no sois la misma persona."
    bet "Você me lembra muito dele. Você também me lembra dele. Mas vocês não são a mesma pessoa."

# game/scripts/c23/c23.rpy:2835
translate brazilian c23s006_AfterBreakfastBetConfession_d89a9f1a:

    # bet "Pero hay una segunda pregunta..."
    bet "Mas há uma segunda questão..."

# game/scripts/c23/c23.rpy:2836
translate brazilian c23s006_AfterBreakfastBetConfession_a896bf5b:

    # mc "Y esa va a ser la más complicada."
    mc "E essa vai ser a mais complicada."

# game/scripts/c23/c23.rpy:2837
translate brazilian c23s006_AfterBreakfastBetConfession_116a5016:

    # mc "¿Cómo querrías que acabara esto? Como has dicho, eres monja."
    mc "Como você gostaria que isso terminasse? Como você disse, você é uma freira."

# game/scripts/c23/c23.rpy:2839
translate brazilian c23s006_AfterBreakfastBetConfession_81fa4560:

    # bet "No tengo una respuesta para esa pregunta. Y no es la pregunta que me esperaba."
    bet "Não tenho resposta para essa pergunta. E não era a pergunta que eu esperava."

# game/scripts/c23/c23.rpy:2840
translate brazilian c23s006_AfterBreakfastBetConfession_abc02a0b:

    # mc "¿Qué pregunta esperabas?"
    mc "Que tipo de pergunta você esperava?"

# game/scripts/c23/c23.rpy:2842
translate brazilian c23s006_AfterBreakfastBetConfession_9d736f53:

    # bet "No sé, algo en plan \"¿Te has vuelto loca, Tía [bet]?\" *Risa*"
    bet "Não sei, algo como: \"Você ficou louca, tia [bet]?\" *Risos*"

# game/scripts/c23/c23.rpy:2843
translate brazilian c23s006_AfterBreakfastBetConfession_48662069:

    # mc "¿Por qué iba a preguntarte algo así?"
    mc "Por que eu te perguntaria uma coisa dessas?"

# game/scripts/c23/c23.rpy:2846
translate brazilian c23s006_AfterBreakfastBetConfession_69825cdc:

    # bet "Porque es una locura."
    bet "Porque é uma loucura."

# game/scripts/c23/c23.rpy:2847
translate brazilian c23s006_AfterBreakfastBetConfession_2acee1f5:

    # bet "Que yo sienta esto y que tengamos esta conversación precisamente hoy."
    bet "Que eu me sinto assim e que estamos tendo essa conversa hoje."

# game/scripts/c23/c23.rpy:2863
translate brazilian c23s006_AfterBreakfastBetConfession_e87268ed:

    # bet "Lo sé. Entre la edad, ser monja, y ni siquiera saber lo que quiero..."
    bet "Eu sei. Entre a minha idade, o fato de ser freira e nem sequer saber o que quero..."

# game/scripts/c23/c23.rpy:2864
translate brazilian c23s006_AfterBreakfastBetConfession_52142a7a:

    # mc "Principalmente la última razón. Creo que tienes la cabeza hecha un lío ahora mismo."
    mc "Principalmente por esse último motivo. Acho que você está com a cabeça uma bagunça agora."

# game/scripts/c23/c23.rpy:2865
translate brazilian c23s006_AfterBreakfastBetConfession_98030007:

    # mc "Estás muy presionada con esta visita y me parece que estás buscando experiencias que viviste antes de ser monja por si tienes que dejar de serlo."
    mc "Você está sob muita pressão com essa visita, e me parece que você está buscando experiências que teve antes de se tornar freira, caso precise deixar de sê-lo."

# game/scripts/c23/c23.rpy:2867
translate brazilian c23s006_AfterBreakfastBetConfession_19d38509:

    # bet "Empecé a sentir algo por ti antes de saber nada de esta visita..."
    bet "Comecei a sentir algo por você antes mesmo de saber qualquer coisa sobre essa visita..."

# game/scripts/c23/c23.rpy:2868
translate brazilian c23s006_AfterBreakfastBetConfession_b986d233:

    # mc "Pero esos sentimientos han crecido desde que lo sabes, ¿verdad?"
    mc "Mas esses sentimentos aumentaram desde que você descobriu, não é?"

# game/scripts/c23/c23.rpy:2869
translate brazilian c23s006_AfterBreakfastBetConfession_726b97aa:

    # bet "Sí..."
    bet "Sim..."

# game/scripts/c23/c23.rpy:2870
translate brazilian c23s006_AfterBreakfastBetConfession_8955be1d:

    # mc "Hagamos un trato. Resolvamos lo de la visita al obispado y después volvemos a hablar sobre cómo te sientes. ¿Te parece bien?"
    mc "Vamos fazer um acordo. Vamos resolver essa questão da visita ao escritório do bispo, e depois conversamos novamente sobre como você está se sentindo. Parece bom para você?"

# game/scripts/c23/c23.rpy:2871
translate brazilian c23s006_AfterBreakfastBetConfession_de7d5078:

    # mc "De esa forma sabrás hacia dónde va tu vida y qué quieres hacer con ella."
    mc "Assim você saberá para onde sua vida está indo e o que deseja fazer com ela."

# game/scripts/c23/c23.rpy:2873
translate brazilian c23s006_AfterBreakfastBetConfession_df3e1714:

    # bet "Me parece un buen plan. Creo que tienes razón y que la incertidumbre de este viaje me está afectando más de lo que debería."
    bet "Parece um bom plano. Acho que você tem razão, e a incerteza dessa viagem está me afetando mais do que deveria."

# game/scripts/c23/c23.rpy:2876
translate brazilian c23s006_AfterBreakfastBetConfession_90897d00:

    # bet "¿Qué? Ahora el que estás loco eres tú."
    bet "O quê? Agora você é que está louco."

# game/scripts/c23/c23.rpy:2877
translate brazilian c23s006_AfterBreakfastBetConfession_3ce076c4:

    # mc "No quiero influir en tu decisión sobre qué hacer hoy pero, de todos los impedimentos que has puesto, es el único que veo insalvable."
    mc "Não quero influenciar sua decisão sobre o que fazer hoje, mas de todos os obstáculos que você criou, este é o único que considero intransponível."

# game/scripts/c23/c23.rpy:2878
translate brazilian c23s006_AfterBreakfastBetConfession_1910dd40:

    # mc "Quiero que la decisión que tomes, la tomes por ti, no por mí. No tengo ningún derecho a pedirte que dejes de ser monja y no lo voy a hacer."
    mc "Quero que você tome essa decisão por si mesma, não por mim. Não tenho o direito de lhe pedir para deixar de ser freira, e não o farei."

# game/scripts/c23/c23.rpy:2880
translate brazilian c23s006_AfterBreakfastBetConfession_55466a06:

    # bet "¿Me estás diciendo que, si no fuera monja, estarías conmigo?"
    bet "Você está me dizendo que se eu não fosse freira, você estaria comigo?"

# game/scripts/c23/c23.rpy:2881
translate brazilian c23s006_AfterBreakfastBetConfession_4cecda61:

    # mc "Te estoy diciendo que, si no fueras monja, tendríamos una posibilidad de estar juntos."
    mc "Estou lhe dizendo que, se você não fosse freira, teríamos uma chance de ficar juntos."

# game/scripts/c23/c23.rpy:2882
translate brazilian c23s006_AfterBreakfastBetConfession_2e5cde8c:

    # mc "Sé que no estarías a gusto si pasara mientras aún lo eres. Y no quiero que esto pese en tu decisión de qué hacer hoy."
    mc "Sei que você não se sentiria confortável se isso acontecesse enquanto você ainda é jovem. E não quero que isso influencie sua decisão sobre o que fazer hoje."

# game/scripts/c23/c23.rpy:2884
translate brazilian c23s006_AfterBreakfastBetConfession_844e3a3d:

    # bet "Pero no me puedes pedir eso..."
    bet "Mas você não pode me perguntar isso..."

# game/scripts/c23/c23.rpy:2885
translate brazilian c23s006_AfterBreakfastBetConfession_8354474c:

    # mc "Exacto. NO te lo estoy pidiendo."
    mc "Exatamente. Eu não estou te pedindo isso."

# game/scripts/c23/c23.rpy:2886
translate brazilian c23s006_AfterBreakfastBetConfession_a57d3d10:

    # mc "Cuando ese secretario te diga qué opciones tienes, deberás decidir qué quieres hacer con tu vida."
    mc "Quando a secretária lhe disser quais opções você tem, você terá que decidir o que quer fazer da sua vida."

# game/scripts/c23/c23.rpy:2887
translate brazilian c23s006_AfterBreakfastBetConfession_1440bb4c:

    # mc "Decidas lo que decidas, yo voy a apoyarte."
    mc "Qualquer que seja sua decisão, eu te apoiarei."

# game/scripts/c23/c23.rpy:2888
translate brazilian c23s006_AfterBreakfastBetConfession_158f2936:

    # mc "Y no quiero que esa decisión tenga nada que ver con esta conversación. Lo tienes que decidir por lo que quieres tú."
    mc "E eu não quero que essa decisão tenha nada a ver com esta conversa. Você tem que decidir com base no que você quer."

# game/scripts/c23/c23.rpy:2890
translate brazilian c23s006_AfterBreakfastBetConfession_24a83dd2:

    # bet "Estás pidiendo un imposible. ¿Cómo no voy a tener en cuenta lo que has dicho?"
    bet "Você está pedindo o impossível. Como posso ignorar o que você disse?"

# game/scripts/c23/c23.rpy:2891
translate brazilian c23s006_AfterBreakfastBetConfession_b6788258:

    # mc "Porque primero tienes que saber lo que te dicen. Después tienes que decidir qué quieres."
    mc "Porque primeiro você precisa saber o que eles estão lhe dizendo. Depois, você precisa decidir o que quer."

# game/scripts/c23/c23.rpy:2892
translate brazilian c23s006_AfterBreakfastBetConfession_30cf15e2:

    # mc "Si te dicen que puedes volver a África, ¿lo dejarías correr y dejarías de ser monja?"
    mc "Se lhe dissessem que poderia voltar para África, aceitaria e deixaria de ser freira?"

# game/scripts/c23/c23.rpy:2894
translate brazilian c23s006_AfterBreakfastBetConfession_690d08fe:

    # bet "Seguramente me arrepentiría si lo hiciera..."
    bet "Provavelmente me arrependeria se o fizesse..."

# game/scripts/c23/c23.rpy:2895
translate brazilian c23s006_AfterBreakfastBetConfession_36abd58f:

    # mc "Por eso tienes que decidir una vez sepas que opciones tienes. No en base a esta conversación, sino en base a lo que tú quieres hacer."
    mc "Por isso, você precisa decidir assim que souber quais opções tem. Não com base nesta conversa, mas sim com base no que você quer fazer."

# game/scripts/c23/c23.rpy:2896
translate brazilian c23s006_AfterBreakfastBetConfession_c27ce51f:

    # mc "Pero si decides dejar de ser monja, porque tú quieres dejar de serlo, me gustaría que tuviéramos una oportunidad."
    mc "Mas se você decidir deixar de ser freira, porque quer deixar de ser freira, eu gostaria que tivéssemos uma chance."

# game/scripts/c23/c23.rpy:2898
translate brazilian c23s006_AfterBreakfastBetConfession_4293882f:

    # mc "¿Y sabes una cosa, Tía [bet]? Pase lo que pase hoy, decidas lo que decidas, te voy a seguir queriendo. Todos lo vamos a hacer."
    mc "E sabe de uma coisa, tia? Aconteça o que acontecer hoje, seja qual for a sua decisão, eu continuarei te amando. Todos nós continuaremos."

# game/scripts/c23/c23.rpy:2900
translate brazilian c23s006_AfterBreakfastBetConfession_c7e0f64c:

    # bet "Gracias, [mc]. Nadie podría pedir una familia mejor."
    bet "Obrigado, [mc]. Ninguém poderia pedir uma família melhor."

# game/scripts/c23/c23.rpy:2901
translate brazilian c23s006_AfterBreakfastBetConfession_c8acdb43:

    # bet "Y sobre la familia..."
    bet "E sobre a família..."

# game/scripts/c23/c23.rpy:2903
translate brazilian c23s006_AfterBreakfastBetConfession_f63b975f:

    # "Pasáis los siguientes 40 minutos charlando de cómo ha cambiado la familia en los días que hace que llegaron las estudiantes, [bet] y [mee]."
    "Vocês passam os próximos 40 minutos conversando sobre como a família mudou nos dias desde a chegada dos estudantes, [bet] e [mee]."

# game/scripts/c23/c23.rpy:2904
translate brazilian c23s006_AfterBreakfastBetConfession_53deecef:

    # "Ninguno de vosotros podría imaginar cómo iba a evolucionar. Los dos estáis contentos de cómo lo ha hecho."
    "Nenhum de vocês poderia imaginar como tudo terminaria. Ambos estão felizes com o resultado."

# game/scripts/c23/c23.rpy:2906
translate brazilian c23s006_AfterBreakfastBetConfession_9abf102f:

    # "Dejáis la conversación aparcada para más adelante."
    "Você deixa a conversa de lado para mais tarde."

# game/scripts/c23/c23.rpy:2908
translate brazilian c23s006_AfterBreakfastBetConfession_098d5e8b:

    # "Cuando estáis a mitad de la ruta..."
    "Quando você estiver na metade do percurso..."

# game/scripts/c23/c23.rpy:2910
translate brazilian c23s006_AfterBreakfastBetConfession_5e1f901f:

    # emm "*Bostezo* ¿Falta mucho? ¡Me estoy meando!"
    emm "*Bocejo* Já estamos quase chegando? Preciso fazer xixi!"

# game/scripts/c23/c23.rpy:2911
translate brazilian c23s006_AfterBreakfastBetConfession_905c0ea0:

    # mc "*Risa* La Bella Durmiente se ha despertado y se ha convertido en La Bella Meona."
    mc "*Risos* A Bela Adormecida acordou e se tornou a Bela que faz xixi."

# game/scripts/c23/c23.rpy:2912
translate brazilian c23s006_AfterBreakfastBetConfession_adb3d7ff:

    # mc "Queda poco más de una hora."
    mc "Falta pouco mais de uma hora."

# game/scripts/c23/c23.rpy:2914
translate brazilian c23s006_AfterBreakfastBetConfession_5ce2ed8e:

    # emm "¿Podemos parar en algún bar de carretera? Os invito a desayunar de nuevo y así voy al lavabo."
    emm "Podemos parar em um bar de beira de estrada? Eu te pago o café da manhã de novo, e depois posso usar o banheiro."

# game/scripts/c23/c23.rpy:2915
translate brazilian c23s006_AfterBreakfastBetConfession_47b16007:

    # mc "*Risa* ¿Segundo desayuno? ¿Has comprobado si tienes los pies peludos?"
    mc "*Risos* Segundo café da manhã? Já checou se tem pelos nos pés?"

# game/scripts/c23/c23.rpy:2917
translate brazilian c23s006_AfterBreakfastBetConfession_98d377a6:

    # bet "Creo que [emm] no va a pillar la referencia."
    bet "Não creio que [emm] vá captar a referência."

# game/scripts/c23/c23.rpy:2918
translate brazilian c23s006_AfterBreakfastBetConfession_835c8bda:

    # mc "Yo creo que sí. Le gustan las películas de fantasía."
    mc "Acho que sim. Ele gosta de filmes de fantasia."

# game/scripts/c23/c23.rpy:2920
translate brazilian c23s006_AfterBreakfastBetConfession_2c8220af:

    # emm "¡Claro que lo he pillado! Es de El Señor de los Pendientes. No es tan buena como La Novia Princesa, pero no está mal."
    emm "Claro que entendi! É de O Senhor dos Brincos. Não é tão bom quanto A Princesa Prometida, mas não é ruim."

# game/scripts/c23/c23.rpy:2921
translate brazilian c23s006_AfterBreakfastBetConfession_e116c8b7:

    # emm "Y me estoy meando."
    emm "E eu estou quase a fazer xixi."

# game/scripts/c23/c23.rpy:2922
translate brazilian c23s006_AfterBreakfastBetConfession_4bdcfd18:

    # mc "*Risa* En cinco minutos pasaremos por King City. Hay varios sitios para comer allí."
    mc "*Risos* Passaremos por King City em cinco minutos. Há vários lugares para comer por lá."

# game/scripts/c23/c23.rpy:2925
translate brazilian c23s006_AfterBreakfastBetConfession_456d7e0d:

    # "Paráis a desayunar de nuevo en King City. [emm] apenas llega al lavabo."
    "Você para para tomar café da manhã novamente em King City. [emm] Ele mal consegue chegar ao banheiro."

# game/scripts/c23/c23.rpy:2926
translate brazilian c23s006_AfterBreakfastBetConfession_7777aded:

    # "La única que pide un desayuno completo es [bet]. Ni siquiera la preocupación por la reunión le quita el hambre."
    "A única que pede um café da manhã completo é [bet]. Nem mesmo a preocupação com a reunião tira a fome dela."

# game/scripts/c23/c23.rpy:2933
translate brazilian c23s006_Rent_0c456281:

    # "Finalmente llegáis a la agencia de alquiler de coches..."
    "Finalmente você chega à locadora de veículos..."

# game/scripts/c23/c23.rpy:2935
translate brazilian c23s006_Rent_665081d0:

    # emm "¡Es precioso! ¡Pink Dreams! ¡Es un sueño hecho realidad!"
    emm "É lindo! Sonhos cor-de-rosa! É um sonho que se tornou realidade!"

# game/scripts/c23/c23.rpy:2936
translate brazilian c23s006_Rent_2000b3ce:

    # mc "Vamos antes de que me empiecen a sangrar los ojos con tanto rosa."
    mc "Vamos embora antes que meus olhos comecem a sangrar de tanto rosa."

# game/scripts/c23/c23.rpy:2937
translate brazilian c23s006_Rent_adfcaa2c:

    # emm "¡Qué poco gusto!"
    emm "Que falta de bom gosto!"

# game/scripts/c23/c23.rpy:2939
translate brazilian c23s006_Rent_48260182:

    # "Amber" "Hola, buenos días, soy Amber. ¿En qué puedo ayudarles?"
    "Amber" "Olá, bom dia, meu nome é Amber. Como posso ajudar?"

# game/scripts/c23/c23.rpy:2940
translate brazilian c23s006_Rent_6f08a874:

    # mc "Teníamos una reserva para un Ferrarini rosa. A nombre de [mc] Marks."
    mc "Tínhamos uma reserva para um Ferrarini rosa. Em nome de [mc] Marks."

# game/scripts/c23/c23.rpy:2941
translate brazilian c23s006_Rent_91e507dd:

    # mcp "(¡Qué forma de destrozar esos coches pintándolos de rosa!)"
    mcp "(Que maneira de estragar esses carros, pintando-os de rosa!)"

# game/scripts/c23/c23.rpy:2943
translate brazilian c23s006_Rent_c455070a:

    # "Amber mira directamente a [bet]."
    "Amber olha diretamente para [bet]."

# game/scripts/c23/c23.rpy:2944
translate brazilian c23s006_Rent_a2e96bfc:

    # "Amber" "He mirado el expediente y he visto que también ha contratado las clases de conducción segura para deportivos con nuestro instructor Chad."
    "Amber" "Analisei o arquivo e vi que ele também agendou aulas de direção segura para carros esportivos com o nosso instrutor Chad."

# game/scripts/c23/c23.rpy:2945
translate brazilian c23s006_Rent_9c578732:

    # "Amber" "En breve estará aquí. Justo a tiempo para que, cuando acabemos el papeleo, la pueda llevar a comer. La comida está incluida en el curso."
    "Amber" "Ela chegará em breve. Bem a tempo para que, assim que terminarmos a papelada, eu possa levá-la para almoçar. O almoço está incluído no valor do curso."

# game/scripts/c23/c23.rpy:2947
translate brazilian c23s006_Rent_75933c3b:

    # emm "¿Unas clases de conducción de deportivos? ¿Esa era la sorpresa? ¡Eres el mejor hermano del mundo!"
    emm "Aulas de direção de carros esportivos? Essa era a surpresa? Você é o melhor irmão do mundo!"

# game/scripts/c23/c23.rpy:2948
translate brazilian c23s006_Rent_fb5e1891:

    # mc "Conducción {b}segura{/b} de deportivos."
    mc "Condução segura de carros esportivos."

# game/scripts/c23/c23.rpy:2950
translate brazilian c23s006_Rent_92805b84:

    # "Amber mira alternativamente a [emm] y a [bet] como si no entendiera nada."
    "Amber olha alternadamente para [emm] e [bet] como se não entendesse nada."

# game/scripts/c23/c23.rpy:2951
translate brazilian c23s006_Rent_8755467d:

    # "Amber" "Perdón por la confusión. Esas clases las suelen contratar señoras... más maduras. Muchas de ellas repiten el curso."
    "Amber" "Desculpe pela confusão. Essas aulas geralmente são frequentadas por mulheres mais velhas. Muitas delas repetem o curso."

# game/scripts/c23/c23.rpy:2952
translate brazilian c23s006_Rent_faabfd68:

    # mc "En este caso, las lecciones son un regalo para mi hermana."
    mc "Neste caso, as aulas são um presente para minha irmã."

# game/scripts/c23/c23.rpy:2954
translate brazilian c23s006_Rent_e818b96a:

    # emm "No veo el Ferrarini aquí. ¿Dónde está? ¿Qué modelo es? ¿Podemos ir a verlo?"
    emm "Não vejo a Ferrarini aqui. Onde está? Qual é o modelo? Podemos ir vê-la?"

# game/scripts/c23/c23.rpy:2955
translate brazilian c23s006_Rent_d8ef348f:

    # mc "Veo que estás impaciente."
    mc "Vejo que você está impaciente."

# game/scripts/c23/c23.rpy:2957
translate brazilian c23s006_Rent_6805dc70:

    # "Amber" "Sí, podemos ir a verlo antes de hacer el papeleo. Sígame por aquí."
    "Amber" "Sim, podemos ir ver antes de preenchermos a papelada. Me siga aqui."

# game/scripts/c23/c23.rpy:2958
translate brazilian c23s006_Rent_b26d677c:

    # "Amber" "Es nuestro modelo más valioso y lo tenemos apartado del resto."
    "Amber" "É o nosso modelo mais valioso e mantemos ele separado dos demais."

# game/scripts/c23/c23.rpy:2960
translate brazilian c23s006_Rent_26fcca02:

    # "Amber abre una puerta con un mando a distancia y allí está el peor atentado contra el buen gusto de la historia de la automoción."
    "Amber abre uma porta com um controle remoto e lá está, a pior afronta ao bom gosto na história automotiva."

# game/scripts/c23/c23.rpy:2962
translate brazilian c23s006_Rent_023fcdde:

    # emm "¡Oh! ¡Es el Ferrarini F69 de 2018! ¡Tiene 660 CV y puede llegar a 355 Km/h! ¡Me encanta este coche!"
    emm "Ah! É a Ferrari F69 de 2018! Ela tem 660 cv e atinge 355 km/h! Eu adoro esse carro!"

# game/scripts/c23/c23.rpy:2964
translate brazilian c23s006_Rent_d882cbb8:

    # emm "Pero este no se comercializó en ese color... Solo en rojo o en negro."
    emm "Mas este não era vendido nessa cor... Apenas em vermelho ou preto."

# game/scripts/c23/c23.rpy:2966
translate brazilian c23s006_Rent_e89101dd:

    # "Amber" "Todos nuestros coches son pintados localmente para que proporcionen una experiencia más exclusiva."
    "Amber" "Todos os nossos carros são pintados localmente para proporcionar uma experiência mais exclusiva."

# game/scripts/c23/c23.rpy:2967
translate brazilian c23s006_Rent_df9a0882:

    # "Amber" "Tenemos tres tonos de rosa dependiendo del tipo de coche."
    "Amber" "Temos três tons de rosa, dependendo do tipo de carro."

# game/scripts/c23/c23.rpy:2969
translate brazilian c23s006_Rent_f4a0d06c:

    # emm "¡Han hecho un trabajo exquisito! ¡Sácame una foto con el logo, [mc]!"
    emm "Eles fizeram um trabalho primoroso! Tira uma foto minha com o logo, [mc]!"

# game/scripts/c23/c23.rpy:2971
translate brazilian c23s006_Rent_9ff5d38a:

    # emm "Que salga bien el Jaballino. Da lo mismo que no me encuadres bien a mí."
    emm "Espero que o javali fique bom. Não importa se você não me enquadrar direito."

# game/scripts/c23/c23.rpy:2972
translate brazilian c23s006_Rent_2a0cfc61:

    # emm "Sí, ya sé que es Cinghialetto. Pero me gusta más como lo digo yo. Más fotos."
    emm "Sim, eu sei que é Cinghialetto. Mas eu gosto mais do jeito que eu digo. Mais fotos."

# game/scripts/c23/c23.rpy:2973
translate brazilian c23s006_Rent_a2af1c25:

    # mc "Creo que sería mejor fuera que en un garaje."
    mc "Acho que seria melhor ao ar livre do que em uma garagem."

# game/scripts/c23/c23.rpy:2974
translate brazilian c23s006_Rent_34c9d6a6:

    # emm "¡Ya habrá tiempo para eso! ¡Hazme un par de fotos ahora!"
    emm "Haverá tempo para isso mais tarde! Tire algumas fotos minhas agora!"

# game/scripts/c23/c23.rpy:2976
translate brazilian c23s006_Rent_f8177bba:

    # "Tomas varias fotos de [emm] posando con el coche. Apenas se atreve a tocarlo."
    "Você tira várias fotos de [emm] posando com o carro. Ela mal se atreve a tocá-lo."

# game/scripts/c23/c23.rpy:2978
translate brazilian c23s006_Rent_d7fbe99b:

    # "Amber" "Miren, por allí llega nuestro instructor Chad. Se ha adelantado."
    "Amber" "Olha, lá vem o nosso instrutor Chad. Ele foi na frente."

# game/scripts/c23/c23.rpy:2979
translate brazilian c23s006_Rent_229f631e:

    # "Amber" "Buenos días, Chad."
    "Amber" "Bom dia, Chad."

# game/scripts/c23/c23.rpy:2981
translate brazilian c23s006_Rent_f5ba0928:

    # "Puedes entender por qué las señoras maduras contratan el curso de conducción."
    "Dá para entender por que mulheres maduras se inscrevem em cursos de direção."

# game/scripts/c23/c23.rpy:2982
translate brazilian c23s006_Rent_b2741f27:

    # "Chad se dirige directamente a [bet]."
    "Chad vai direto para [bet]."

# game/scripts/c23/c23.rpy:2983
translate brazilian c23s006_Rent_db84fff6:

    # "Chad" "Buenos días, señora. ¿Preparada para la mejor experiencia automovilística de su vida con Chad?"
    "Chad" "Bom dia, senhora. Pronta para a melhor experiência automobilística da sua vida com Chad?"

# game/scripts/c23/c23.rpy:2985
translate brazilian c23s006_Rent_aff2351e:

    # bet "*Risa* Creo que te equivocas, Chad."
    bet "*Risos* Acho que você está enganado, Chad."

# game/scripts/c23/c23.rpy:2987
translate brazilian c23s006_Rent_9409452e:

    # bet "Amber, ¿me puedes decir dónde está el lavabo? Voy a ir a cambiarme mientras le presenta a Chad a su clienta."
    bet "Amber, você pode me dizer onde fica o banheiro? Vou me trocar enquanto ela apresenta o Chad ao cliente dela."

# game/scripts/c23/c23.rpy:2989
translate brazilian c23s006_Rent_479bdf44:

    # "Unos minutos después, una vez acabadas las presentaciones y el papeleo..."
    "Poucos minutos depois, assim que as apresentações e a papelada foram concluídas..."

# game/scripts/c23/c23.rpy:2990
translate brazilian c23s006_Rent_c060a39f:

    # emm "Entonces nos vemos aquí en tres horas, ¿no?"
    emm "Então nos vemos aqui em três horas, certo?"

# game/scripts/c23/c23.rpy:2991
translate brazilian c23s006_Rent_41170b53:

    # mc "Bueno, la reunión es en una hora y media. No sé cuánto durará."
    mc "Bem, a reunião é daqui a uma hora e meia. Não sei quanto tempo vai durar."

# game/scripts/c23/c23.rpy:2992
translate brazilian c23s006_Rent_847e04d9:

    # mc "El curso de conducción segura acaba en tres horas, con lo que seguramente nosotros acabaremos antes."
    mc "O curso de direção segura termina em três horas, então provavelmente terminaremos antes disso."

# game/scripts/c23/c23.rpy:2994
translate brazilian c23s006_Rent_2a10c184:

    # emm "Conducción segura {b}de deportivos{/b}. *Risa*"
    emm "Condução segura de carros esportivos. *Risos*"

# game/scripts/c23/c23.rpy:2995
translate brazilian c23s006_Rent_a0fc9c2e:

    # mc "Sí, vale. Te he mandado la dirección del motel en el que nos alojaremos, por si nos retrasamos y quieres ir a descansar."
    mc "Sim, tudo bem. Enviei o endereço do motel onde ficaremos hospedados, caso haja algum atraso e você queira descansar."

# game/scripts/c23/c23.rpy:2996
translate brazilian c23s006_Rent_a0644686:

    # mc "En cuanto acabemos te llamo y quedamos en algún sitio."
    mc "Assim que terminarmos, eu te ligo e a gente se encontra em algum lugar."

# game/scripts/c23/c23.rpy:2997
translate brazilian c23s006_Rent_339f1f96:

    # emm "Perfecto."
    emm "Perfeito."

# game/scripts/c23/c23.rpy:3000
translate brazilian c23s006_Rent_bd67ed74:

    # emm "*Susurrando* Te daría un beso, pero seguro que Amber se escandaliza después de decirle que eras mi hermano."
    emm "*Sussurrando* Eu te beijaria, mas tenho certeza de que Amber ficaria escandalizada depois que eu contasse a ela que você é meu irmão."

# game/scripts/c23/c23.rpy:3001
translate brazilian c23s006_Rent_6b4f6085:

    # mc "*Susurrando* No creo que se escandalice demasiado, teniendo en cuenta las señoras maduras que contratan a Chad. *Risa*"
    mc "*Sussurrando* Acho que ela não vai ficar muito chocada, considerando as mulheres maduras que contratam o Chad. *Risos*"

# game/scripts/c23/c23.rpy:3003
translate brazilian c23s006_Rent_33a146cb:

    # emm "*Susurrando* Creo que el curso para señoras maduras con Chad debe incluir alguna cosa más que conducir, viendo su aspecto."
    emm "*Sussurrando* Acho que o curso do Chad para senhoras maduras deve incluir mais do que apenas direção, a julgar pela aparência dele."

# game/scripts/c23/c23.rpy:3004
translate brazilian c23s006_Rent_74a6046c:

    # mc "*Susurrando* Estoy seguro de ello."
    mc "*Sussurrando* Tenho certeza disso."

# game/scripts/c23/c23.rpy:3006
translate brazilian c23s006_Rent_9fdb4cfa:

    # emm "*Susurrando* Pues que no espere nada conmigo. No es para nada mi tipo."
    emm "*Sussurrando* Bem, ela não deveria esperar nada de mim. Ela não faz meu tipo."

# game/scripts/c23/c23.rpy:3008
translate brazilian c23s006_Rent_aa8ef0d9:

    # emm "*Susurrando* Me gustan más como tú."
    emm "*Sussurrando* Eu gosto mais deles assim como você."

# game/scripts/c23/c23.rpy:3009
translate brazilian c23s006_Rent_a2cc8b2a:

    # mc "*Risa* Te veo luego. [bet] ya está saliendo del lavabo."
    mc "*Risos* Até mais. [bet] Ela já está saindo do banheiro."

# game/scripts/c23/c23.rpy:3011
translate brazilian c23s006_Rent_e7b71ffd:

    # bet "Disfruta del coche y no dejes que Chad haga nada que no debe, [emm]."
    bet "Aproveite o carro e não deixe Chad fazer nada que ele não deva, [emm]."

# game/scripts/c23/c23.rpy:3012
translate brazilian c23s006_Rent_a312c07f:

    # mc "*Risa* Precisamente estábamos hablando de eso."
    mc "*Risos* Estávamos falando exatamente disso."

# game/scripts/c23/c23.rpy:3014
translate brazilian c23s006_Rent_3a64c416:

    # bet "¿Nos vamos, entonces?"
    bet "Vamos então?"

# game/scripts/c23/c23.rpy:3015
translate brazilian c23s006_Rent_ded19230:

    # mcp "(Claramente no tiene ganas de ir a esa reunión. Yo tampoco las tendría.)"
    mcp "(É evidente que ela não quer ir a essa reunião. Eu também não.)"

# game/scripts/c23/c23.rpy:3016
translate brazilian c23s006_Rent_8fbff358:

    # mc "Sí, vámonos."
    mc "Sim, vamos lá."

# game/scripts/c23/c23.rpy:3018
translate brazilian c23s006_Rent_53d871ed:

    # emm "Suerte, Tía [bet]."
    emm "Boa sorte, tia [bet]."

# game/scripts/c23/c23.rpy:3019
translate brazilian c23s006_Rent_6a4fac72:

    # mcp "(A veces [emm] es sorprendentemente maravillosa.)"
    mcp "(Às vezes, [emm] é surpreendentemente maravilhoso.)"

# game/scripts/c23/c23.rpy:3021
translate brazilian c23s006_Rent_303d6258:

    # bet "Gracias, cielo."
    bet "Obrigado, querido."

# game/scripts/c23/c23.rpy:3026
translate brazilian c23s006_RideBetChurch_f874252a:

    # "Después de una comida en la que intentas levantarle los ánimos sin éxito, llevas a [bet] a la catedral de Monterey."
    "Após uma refeição em que você tenta, sem sucesso, animá-lo, você leva [bet] à Catedral de Monterey."

# game/scripts/c23/c23.rpy:3027
translate brazilian c23s006_RideBetChurch_7b15b09b:

    # "La reunión tendrá lugar en un edificio cercano a la catedral."
    "A reunião acontecerá em um prédio próximo à catedral."

# game/scripts/c23/c23.rpy:3028
translate brazilian c23s006_RideBetChurch_b5b10e17:

    # bet "Aquí estamos..."
    bet "Aqui estamos..."

# game/scripts/c23/c23.rpy:3029
translate brazilian c23s006_RideBetChurch_dd568640:

    # mc "No tienes ganas de entrar, ¿verdad?"
    mc "Você não está com vontade de entrar, está?"

# game/scripts/c23/c23.rpy:3031
translate brazilian c23s006_RideBetChurch_2beddb44:

    # bet "Ahora mismo me apetecería más pegarme un martillazo en el pie que entrar ahí."
    bet "Neste momento, prefiro bater com um martelo no pé do que entrar lá."

# game/scripts/c23/c23.rpy:3032
translate brazilian c23s006_RideBetChurch_cdb4a5bb:

    # mc "Te entiendo. Pero ¿sabes qué me decía [nor] cuando no quería hacer algo de niño?"
    mc "Entendo. Mas você sabe o que [nor] costumava me dizer quando eu não queria fazer algo infantil?"

# game/scripts/c23/c23.rpy:3034
translate brazilian c23s006_RideBetChurch_46d10b95:

    # bet "Que cuanto antes lo hicieras, antes podrías dedicarte a otras cosas que te gustan más."
    bet "Quanto mais cedo você fizer isso, mais cedo poderá se dedicar a outras coisas que você gosta mais."

# game/scripts/c23/c23.rpy:3035
translate brazilian c23s006_RideBetChurch_9ef0b9a7:

    # mc "Veo que la frase tiene raíces profundas en la familia. Son exactamente las mismas palabras."
    mc "Vejo que a expressão tem raízes profundas na família. São exatamente as mesmas palavras."

# game/scripts/c23/c23.rpy:3037
translate brazilian c23s006_RideBetChurch_86fa3e95:

    # bet "*Risa triste* Es una frase que nos decía mi abuela cuando íbamos a visitarla a Missouri."
    bet "*Risada triste* É uma frase que minha avó costumava dizer quando íamos visitá-la no Missouri."

# game/scripts/c23/c23.rpy:3039
translate brazilian c23s006_RideBetChurch_791a2692:

    # bet "Tu bisabuela se la decía a [nor] y a [mar]. Es una frase que suelen decir las abuelas de la familia."
    bet "Sua bisavó costumava dizer isso para [nor] e [mar]. É uma frase que as avós da família costumam dizer."

# game/scripts/c23/c23.rpy:3041
translate brazilian c23s006_RideBetChurch_78a73330:

    # bet "Mi madre se la decía a [nor]. Es una frase que suelen decir las abuelas de la familia."
    bet "Minha mãe costumava dizer isso para [nor]. É uma frase que as avós da família costumam dizer."

# game/scripts/c23/c23.rpy:3042
translate brazilian c23s006_RideBetChurch_5435b956:

    # mc "Y ahora invertimos el proceso y te la digo yo, igual que [nor] me la dijo a mí."
    mc "E agora vamos inverter o processo e eu vou te contar, exatamente como [nor] me disse."

# game/scripts/c23/c23.rpy:3043
translate brazilian c23s006_RideBetChurch_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Você quer que eu te acompanhe?"

# game/scripts/c23/c23.rpy:3045
translate brazilian c23s006_RideBetChurch_83e3f56b:

    # bet "Gracias, pero será mejor que entre sola. De todas formas, a la reunión no puedes asistir."
    bet "Obrigada, mas seria melhor se ela fosse sozinha. De qualquer forma, você não poderá comparecer à reunião."

# game/scripts/c23/c23.rpy:3046
translate brazilian c23s006_RideBetChurch_b6b048eb:

    # mc "Entonces iré al motel a dejar las maletas y vuelvo a buscarte. He visto un café en el que puedo esperarte."
    mc "Então irei ao motel deixar minhas malas e voltarei para te buscar. Vi um café onde posso te esperar."

# game/scripts/c23/c23.rpy:3047
translate brazilian c23s006_RideBetChurch_ef862ae9:

    # mc "Llámame cuando salgas y vengo en dos minutos."
    mc "Me ligue quando você sair e eu chego em dois minutos."

# game/scripts/c23/c23.rpy:3049
translate brazilian c23s006_RideBetChurch_854f9db8:

    # bet "Me parece perfecto. No sé cuánto voy a tardar y no quiero que te quedes en el coche todo este rato."
    bet "Isso parece perfeito. Não sei quanto tempo vou demorar e não quero que você fique no carro todo esse tempo."

# game/scripts/c23/c23.rpy:3050
translate brazilian c23s006_RideBetChurch_5155cd4f:

    # mc "¿Quieres un abrazo antes de ir?"
    mc "Você quer um abraço antes de ir?"

# game/scripts/c23/c23.rpy:3052
translate brazilian c23s006_RideBetChurch_7dc9295c:

    # bet "Me encantaría, pero mejor no. *Risa triste* Si me abrazas ahora no voy a querer ir."
    bet "Eu adoraria, mas talvez não. *Risada triste* Se você me abraçar agora, eu não vou querer ir."

# game/scripts/c23/c23.rpy:3053
translate brazilian c23s006_RideBetChurch_6bc1a3fa:

    # mc "Entonces sin abrazos."
    mc "Então, nada de abraços."

# game/scripts/c23/c23.rpy:3054
translate brazilian c23s006_RideBetChurch_7a2874a6:

    # mc "Suerte, Tía [bet]."
    mc "Boa sorte, tia [bet]."

# game/scripts/c23/c23.rpy:3056
translate brazilian c23s006_RideBetChurch_303d6258:

    # bet "Gracias, cielo."
    bet "Obrigado, querido."

# game/scripts/c23/c23.rpy:3058
translate brazilian c23s006_RideBetChurch_59dfcd2a:

    # "Puedes ver como Tía [bet] se dirige al edificio de oficinas de la diócesis con los hombros hundidos, como un fantasma azul."
    "Você pode ver a tia [bet] indo em direção ao prédio do escritório da diocese com os ombros caídos, como um fantasma azul."

# game/scripts/c23/c23.rpy:3059
translate brazilian c23s006_RideBetChurch_9d3303d5:

    # "La batalla que tenga que librar ahí dentro está perdida antes de empezar."
    "A batalha que ele precisa travar lá dentro está perdida antes mesmo de começar."

# game/scripts/c23/c23.rpy:3061
translate brazilian c23s006_RideBetChurch_1635f2b6:

    # "Vas al motel a dejar las maletas de [bet] y [emm] en una habitación y tu mochila en otra."
    "Você vai ao motel para deixar as malas de [bet] e [emm] em um quarto e sua mochila em outro."

# game/scripts/c23/c23.rpy:3062
translate brazilian c23s006_RideBetChurch_ceec7348:

    # "[bet] ha dejado la ropa que llevaba puesta para el viaje en la camioneta. La dejas allí por si se quiere cambiar después."
    "[bet] Ela deixou as roupas que ia usar na viagem dentro da van. Você as deixa lá caso ela queira trocar de roupa mais tarde."

# game/scripts/c23/c23.rpy:3063
translate brazilian c23s006_RideBetChurch_76d4436f:

    # "Vuelves al barrio de la catedral y te tomas un café en una heladería a tres minutos del edificio donde [bet] está teniendo la reunión."
    "Você retorna ao bairro da catedral e toma um café em uma sorveteria a três minutos do prédio onde [bet] está realizando a reunião."

# game/scripts/c23/c23.rpy:3064
translate brazilian c23s006_RideBetChurch_8b918e17:

    # "No disfrutas del café. Estás casi tan nervioso por el resultado como lo estaba [bet] al entrar."
    "Você não está gostando do café. Você está quase tão nervoso com o resultado quanto eu estava quando entrei."

# game/scripts/c23/c23.rpy:3070
translate brazilian c23s006_FerrariniGirl_df34c2a7:

    # "La reunión se alarga tanto que [emm] te llama para decirte que ya ha acabado el curso."
    "A reunião se prolonga tanto que [emm] liga para você para avisar que o curso terminou."

# game/scripts/c23/c23.rpy:3072
translate brazilian c23s006_FerrariniGirl_185cb950:

    # emm "Hey, [mc]. ¿Aún no habéis acabado la reunión?"
    emm "Ei, [mc]. Você ainda não terminou a reunião?"

# game/scripts/c23/c23.rpy:3074
translate brazilian c23s006_FerrariniGirl_41cb7534:

    # mc "No, estoy esperando a que Tía [bet] me llame para recogerla e ir a buscarte."
    mc "Não, estou esperando a tia [bet] me ligar para que eu possa buscá-la e ir te buscar."

# game/scripts/c23/c23.rpy:3076
translate brazilian c23s006_FerrariniGirl_e6d88fd1:

    # emm "No te preocupes por mí. Ya he acabado el curso y voy a conducir un rato. ¡Este coche es increíble!"
    emm "Não se preocupe comigo. Terminei o curso e vou dar uma volta. Este carro é incrível!"

# game/scripts/c23/c23.rpy:3077
translate brazilian c23s006_FerrariniGirl_b5b66e29:

    # mc "¿Qué tal el curso?"
    mc "Como foi o curso?"

# game/scripts/c23/c23.rpy:3079
translate brazilian c23s006_FerrariniGirl_67eda2dc:

    # emm "¡Genial! Aunque estoy casi segura de que Chad se saca un extra como gigoló con las maduras, realmente es un profesional."
    emm "Incrível! Embora eu tenha quase certeza de que Chad ganha um dinheiro extra como gigolô com mulheres mais velhas, ele é realmente um profissional."

# game/scripts/c23/c23.rpy:3080
translate brazilian c23s006_FerrariniGirl_80d5d336:

    # emm "Fue piloto de pruebas en un equipo de la WEC durante varios años."
    emm "Ele foi piloto de testes de uma equipe do WEC por vários anos."

# game/scripts/c23/c23.rpy:3081
translate brazilian c23s006_FerrariniGirl_f4eba33d:

    # mc "¿WEC?"
    mc "WEC?"

# game/scripts/c23/c23.rpy:3083
translate brazilian c23s006_FerrariniGirl_4977e205:

    # emm "El World Endurance Championship, el mundial de resistencia... 24 horas de Le Mans y ese tipo de carreras."
    emm "O Campeonato Mundial de Endurance, o campeonato mundial de endurance... as 24 Horas de Le Mans e esse tipo de corrida."

# game/scripts/c23/c23.rpy:3085
translate brazilian c23s006_FerrariniGirl_6c6bc686:

    # emm "A veces parece que el hombre en esta relación sea yo. No sabes nada de coches."
    emm "Às vezes parece que eu sou o homem nessa relação. Você não entende nada de carros."

# game/scripts/c23/c23.rpy:3087
translate brazilian c23s006_FerrariniGirl_38254f85:

    # emm "A veces parece que yo sea el hermano y tú la hermana. No sabes nada de coches."
    emm "Às vezes parece que eu sou o irmão e você é a irmã. Você não entende nada de carros."

# game/scripts/c23/c23.rpy:3089
translate brazilian c23s006_FerrariniGirl_49730f47:

    # emm "¡Pero alquilas unos coches de puta madre!"
    emm "Mas você aluga uns carros muito bons!"

# game/scripts/c23/c23.rpy:3090
translate brazilian c23s006_FerrariniGirl_ac6e7f7f:

    # mc "Me alegra que lo estés disfrutando. Me hubiera gustado estar contigo y que lo disfrutáramos juntos."
    mc "Que bom que você está gostando. Eu adoraria estar com você e aproveitar junto com você."

# game/scripts/c23/c23.rpy:3092
translate brazilian c23s006_FerrariniGirl_ea46b0f5:

    # emm "A mí también me hubiera gustado, pero entiendo que no podemos dejar a Tía [bet] sola."
    emm "Eu também teria gostado, mas entendo que não podemos deixar a tia [bet] sozinha."

# game/scripts/c23/c23.rpy:3093
translate brazilian c23s006_FerrariniGirl_b635a88c:

    # mc "*Risa* Tu concepto de \"podemos\" es un poco especial. Yo estoy aquí y tú estás conduciendo un coche hortera."
    mc "*Risos* Seu conceito de \"nós podemos\" é um tanto peculiar. Eu estou aqui e você está dirigindo um carro brega."

# game/scripts/c23/c23.rpy:3095
translate brazilian c23s006_FerrariniGirl_a9df7e34:

    # emm "*Risa* ¡Qué poco gusto tienes para los coches!"
    emm "*Risos* Você tem um gosto péssimo para carros!"

# game/scripts/c23/c23.rpy:3096
translate brazilian c23s006_FerrariniGirl_fe44a410:

    # mc "Eso es discutible. *Risa* Si no se comercializaba en rosa, por algo será..."
    mc "Isso é discutível. *Risos* Se não foi vendido em rosa, deve haver um motivo..."

# game/scripts/c23/c23.rpy:3097
translate brazilian c23s006_FerrariniGirl_1f2f1237:

    # mc "Por cierto, sabes que si te ponen una multa de velocidad me tocará pagarla a mí, ¿verdad?"
    mc "Aliás, você sabe que se você levar uma multa por excesso de velocidade, eu vou ter que pagar, né?"

# game/scripts/c23/c23.rpy:3099
translate brazilian c23s006_FerrariniGirl_7304d0d2:

    # mc "Aunque sea un coche de alquiler, las multas llegan igualmente. Y te las pienso pasar a ti para que las pagues."
    mc "Mesmo sendo um carro alugado, as multas ainda serão cobradas. E eu vou repassá-las para você para que possa pagá-las."

# game/scripts/c23/c23.rpy:3102
translate brazilian c23s006_FerrariniGirl_507c29bd:

    # emm "¡Oops! No lo sabía. Pero no te preocupes... no estoy corriendo... {b}demasiado{/b}."
    emm "Ops! Eu não sabia disso. Mas não se preocupe... eu não estou correndo... muito."

# game/scripts/c23/c23.rpy:3103
translate brazilian c23s006_FerrariniGirl_6f48d758:

    # mc "*Risa* Ese \"demasiado\" me da mucho miedo."
    mc "*Risos* Esse \"demais\" me assusta muito."

# game/scripts/c23/c23.rpy:3105
translate brazilian c23s006_FerrariniGirl_ff2af8d1:

    # emm "Una pregunta, ¿mi nombre está en algún sitio en el motel? Es decir... ¿puedo ir y pedir una llave de la habitación?"
    emm "Uma pergunta: meu nome está listado em algum lugar no motel? Quero dizer... posso ir lá e pedir a chave do quarto?"

# game/scripts/c23/c23.rpy:3106
translate brazilian c23s006_FerrariniGirl_9188fde9:

    # mc "Sí, ya he avisado en la recepción que era posible que fueras y les pidieras una llave. Estás en la habitación número 6."
    mc "Sim, já avisei a recepção que talvez você queira ir lá pedir a chave. Seu quarto é o número 6."

# game/scripts/c23/c23.rpy:3107
translate brazilian c23s006_FerrariniGirl_9165b904:

    # mc "¿Por qué? ¿Estás cansada?"
    mc "Por quê? Você está cansado?"

# game/scripts/c23/c23.rpy:3109
translate brazilian c23s006_FerrariniGirl_bbed22e2:

    # emm "No, es que es posible que compre algunas cosas para las chicas y me gustaría dejarlas en la habitación en vez de llevarlas en el coche todo el día."
    emm "Não, é só que talvez eu compre algumas coisas para as meninas e gostaria de deixá-las no quarto em vez de carregá-las no carro o dia todo."

# game/scripts/c23/c23.rpy:3110
translate brazilian c23s006_FerrariniGirl_2dd5ec5c:

    # mc "¿Has visto algún souvenir? *Risa* Solo espero que no necesites comprar una cuarta maleta para llevar los regalos."
    mc "Você viu alguma lembrancinha? *Risos* Só espero que você não precise comprar uma quarta mala para levar os presentes."

# game/scripts/c23/c23.rpy:3112
translate brazilian c23s006_FerrariniGirl_0a8e6cd1:

    # emm "Más o menos. *Risita* Te veo luego. Avísame cuando Tía [bet] acabe, a ver dónde estoy."
    emm "Mais ou menos. *Risos* Até mais. Me avise quando a tia [bet] terminar, para eu saber onde estou."

# game/scripts/c23/c23.rpy:3113
translate brazilian c23s006_FerrariniGirl_031b37f6:

    # mc "Si conduces demasiado, es posible que acabes en San Francisco... *Risa* con un montón de multas de velocidad."
    mc "Se você dirigir demais, pode acabar em São Francisco... *Risos* com um monte de multas por excesso de velocidade."

# game/scripts/c23/c23.rpy:3114
translate brazilian c23s006_FerrariniGirl_9c47d0e7:

    # emm "No te preocupes. *Risa* No voy a llegar tan lejos. Hasta luego."
    emm "Não se preocupe. *Risos* Não vou tão longe. Até mais."

# game/scripts/c23/c23.rpy:3119
translate brazilian c23s006_AfterTheMeeting_44117e4a:

    # "Media hora y dos cafés después, [bet] te avisa de que ya ha salido. Le propones ir a buscarla, pero cuando le dices dónde estás, decide unirse a ti en el café."
    "Meia hora e dois cafés depois, [bet] avisa que já foi embora. Você sugere ir procurá-la, mas quando você diz onde está, ela decide ir com você ao café."

# game/scripts/c23/c23.rpy:3120
translate brazilian c23s006_AfterTheMeeting_7529841f:

    # "Avisas a [emm] de que [bet] ya está llegando y le mandas tu ubicación. Está en el motel y llegará en 15 minutos."
    "Você avisa [emm] que [bet] está a caminho e envia sua localização. Eles estão no motel e chegarão em 15 minutos."

# game/scripts/c23/c23.rpy:3121
translate brazilian c23s006_AfterTheMeeting_54937a4c:

    # "La monja llega cinco minutos después y se va inmediatamente a poner la ropa que llevaba durante el viaje mientras llega la chica del Ferrarini."
    "A freira chega cinco minutos depois e imediatamente vai vestir as roupas que usou durante a viagem, enquanto a garota do Ferrarini chega."

# game/scripts/c23/c23.rpy:3122
translate brazilian c23s006_AfterTheMeeting_2f523696:

    # "[bet] no quiere empezar a explicarte cómo ha ido la reunión para tener que volver a hacerlo cuando llegue [emm]."
    "[bet] não quer começar a explicar como foi a reunião apenas para ter que fazer isso novamente quando [emm] chegar."

# game/scripts/c23/c23.rpy:3124
translate brazilian c23s006_AfterTheMeeting_89a31f19:

    # "Cuando estáis los tres por fin sentados a la mesa..."
    "Quando vocês três finalmente estiverem sentados à mesa..."

# game/scripts/c23/c23.rpy:3126
translate brazilian c23s006_AfterTheMeeting_76548f66:

    # emm "Me muero de impaciencia, Tía [bet]. ¿Qué te han dicho?"
    emm "Estou morrendo de impaciência, tia [bet]. O que eles te disseram?"

# game/scripts/c23/c23.rpy:3128
translate brazilian c23s006_AfterTheMeeting_140ce337:

    # bet "El secretario me ha dicho que hice bien en negarme a operar a aquel muchacho."
    bet "A secretária me disse que eu fiz a coisa certa ao me recusar a operar aquele menino."

# game/scripts/c23/c23.rpy:3129
translate brazilian c23s006_AfterTheMeeting_1fd1471c:

    # mc "Eso es bueno, ¿no?"
    mc "Isso é bom, não é?"

# game/scripts/c23/c23.rpy:3130
translate brazilian c23s006_AfterTheMeeting_fce9380f:

    # bet "Pero que hice mal en informar a su padre, el jefe tribal, de que el obispo Bakari le había engañado diciéndole que la homosexualidad se podía curar."
    bet "Mas eu errei ao informar ao pai dele, o chefe tribal, que o bispo Bakari o havia enganado ao dizer que a homossexualidade tinha cura."

# game/scripts/c23/c23.rpy:3131
translate brazilian c23s006_AfterTheMeeting_96743008:

    # bet "El obispo es una figura muy importante en la iglesia de Tanzania y... ha pedido mi cabeza."
    bet "O bispo é uma figura muito importante na igreja na Tanzânia e... ele pediu a minha cabeça."

# game/scripts/c23/c23.rpy:3133
translate brazilian c23s006_AfterTheMeeting_63794710:

    # emm "¡Que hijo de puta! Supongo que se refiere a que no vuelvas a Tanzania, ¿no?"
    emm "Que filho da puta! Imagino que ele esteja querendo dizer para não voltar para a Tanzânia, certo?"

# game/scripts/c23/c23.rpy:3135
translate brazilian c23s006_AfterTheMeeting_5d2c44a7:

    # bet "Ni a Tanzania ni a ningún otro lugar de África."
    bet "Nem para a Tanzânia, nem para qualquer outro lugar na África."

# game/scripts/c23/c23.rpy:3136
translate brazilian c23s006_AfterTheMeeting_34cb8151:

    # mc "Entonces solo te queda lo de trabajar en hospitales en California..."
    mc "Então, sua única opção restante é trabalhar em hospitais na Califórnia..."

# game/scripts/c23/c23.rpy:3138
translate brazilian c23s006_AfterTheMeeting_078df519:

    # bet "Eso tampoco."
    bet "Nem isso."

# game/scripts/c23/c23.rpy:3139
translate brazilian c23s006_AfterTheMeeting_ae35ad01:

    # bet "La iglesia me da dos opciones. Entrar en un convento de clausura en los Estados Unidos o jubilación en otro convento de mi elección en Latinoamérica."
    bet "A Igreja me dá duas opções: entrar para um convento de clausura nos Estados Unidos ou me aposentar em outro convento de minha escolha na América Latina."

# game/scripts/c23/c23.rpy:3141
translate brazilian c23s006_AfterTheMeeting_86c23442:

    # emm "¿Por qué? No lo entiendo. ¿Tú lo entiendes?"
    emm "Por quê? Não entendo. Você entende?"

# game/scripts/c23/c23.rpy:3142
translate brazilian c23s006_AfterTheMeeting_2b63b98c:

    # mc "Si está aquí en un convento en el que pueda hablar con la prensa, podría liarla parda. Por eso aquí el convento es de clausura."
    mc "Se ela estivesse aqui em um convento onde pudesse falar com a imprensa, poderia causar um grande escândalo. É por isso que este convento é de clausura."

# game/scripts/c23/c23.rpy:3143
translate brazilian c23s006_AfterTheMeeting_0c2b8817:

    # mc "Si está jubilada en un convento en... yo qué sé... Nicaragua o Bolivia... La prensa de allí no le prestará atención."
    mc "Se ela estiver aposentada em um convento em... sei lá... Nicarágua ou Bolívia... a imprensa de lá não vai dar atenção a ela."

# game/scripts/c23/c23.rpy:3144
translate brazilian c23s006_AfterTheMeeting_f27c25a1:

    # mc "Y si habla con la prensa, la iglesia puede decir que la jubilaron con antelación porque ya no pensaba con claridad."
    mc "E se ela falar com a imprensa, a igreja poderá dizer que ela foi aposentada precocemente porque já não estava pensando com clareza."

# game/scripts/c23/c23.rpy:3146
translate brazilian c23s006_AfterTheMeeting_1c2fa445:

    # mc "¿Me equivoco?"
    mc "Estou errado?"

# game/scripts/c23/c23.rpy:3147
translate brazilian c23s006_AfterTheMeeting_28a3741f:

    # bet "No lo ha dicho así, pero tienes razón sobre sus motivos."
    bet "Ele não disse exatamente assim, mas você tem razão quanto às suas motivações."

# game/scripts/c23/c23.rpy:3148
translate brazilian c23s006_AfterTheMeeting_e064dfa2:

    # bet "Sea como sea no volveré a ejercer en ningún hospital."
    bet "Seja como for, nunca mais trabalharei em nenhum hospital."

# game/scripts/c23/c23.rpy:3150
translate brazilian c23s006_AfterTheMeeting_94f0859e:

    # emm "No volverás a ejercer si sigues siendo monja, ¿no?"
    emm "Você não poderá mais exercer sua profissão se continuar freira, não é?"

# game/scripts/c23/c23.rpy:3151
translate brazilian c23s006_AfterTheMeeting_6e09d1d7:

    # emm "Podrías dejar la iglesia y seguir trabajando. Problema resuelto."
    emm "Você poderia sair da igreja e continuar trabalhando. Problema resolvido."

# game/scripts/c23/c23.rpy:3153
translate brazilian c23s006_AfterTheMeeting_94c7a5e2:

    # bet "Me tendría que volver a certificar para poder ejercer de cirujana en los Estados Unidos."
    bet "Eu precisaria obter uma nova certificação para poder exercer a profissão de cirurgião nos Estados Unidos."

# game/scripts/c23/c23.rpy:3154
translate brazilian c23s006_AfterTheMeeting_d0b6a0d2:

    # bet "Y eso vale dinero, no tengo ni idea de cuánto. En mi plan de trabajar en hospitales católicos, esa certificación la pagaba la iglesia..."
    bet "E isso custa dinheiro, não tenho ideia de quanto. No meu plano de trabalhar em hospitais católicos, a igreja iria pagar por essa certificação..."

# game/scripts/c23/c23.rpy:3155
translate brazilian c23s006_AfterTheMeeting_e6940cd5:

    # mc "Por el dinero no te preocupes."
    mc "Não se preocupe com o dinheiro."

# game/scripts/c23/c23.rpy:3157
translate brazilian c23s006_AfterTheMeeting_050d8cb9:

    # emm "Tenemos una empresa millonaria. Podemos pagar tu certificación sin problemas."
    emm "Somos uma empresa multimilionária. Podemos pagar pela sua certificação sem problemas."

# game/scripts/c23/c23.rpy:3158
translate brazilian c23s006_AfterTheMeeting_0b57ea3e:

    # mc "Bueno, no con dinero de NTR. Sería un gasto injustificable."
    mc "Bem, não com o dinheiro do NTR. Isso seria um gasto injustificável."

# game/scripts/c23/c23.rpy:3159
translate brazilian c23s006_AfterTheMeeting_6009a7e8:

    # mc "Pero yo puedo pedir un adelanto de mi sueldo para pagar por tu certificación. Y dudo que el CEO de NTR lo rechace."
    mc "Mas posso pedir um adiantamento do meu salário para pagar pela sua certificação. E duvido que o CEO da NTR se recuse."

# game/scripts/c23/c23.rpy:3161
translate brazilian c23s006_AfterTheMeeting_55389b78:

    # bet "No os puedo pedir eso..."
    bet "Não posso pedir isso de você..."

# game/scripts/c23/c23.rpy:3162
translate brazilian c23s006_AfterTheMeeting_99751757:

    # mc "No lo estás pidiendo. Lo estamos ofreciendo nosotros."
    mc "Você não está pedindo. Nós estamos oferecendo."

# game/scripts/c23/c23.rpy:3163
translate brazilian c23s006_AfterTheMeeting_f0ef9c25:

    # mc "El sábado voy a actuar como CEO por primera vez, y pienso cobrar por ello. Ese dinero es tuyo para la certificación."
    mc "No sábado, estarei atuando como CEO pela primeira vez e pretendo ser remunerado por isso. Esse dinheiro é seu pela certificação."

# game/scripts/c23/c23.rpy:3165
translate brazilian c23s006_AfterTheMeeting_82ed1e9d:

    # bet "..."
    bet "..."

# game/scripts/c23/c23.rpy:3166
translate brazilian c23s006_AfterTheMeeting_f878632a:

    # mc "Tía [bet]... ¿Estás bien?"
    mc "Tia [bet]... Você está bem?"

# game/scripts/c23/c23.rpy:3168
translate brazilian c23s006_AfterTheMeeting_b5b31101:

    # emm "¿Qué pasa, Tía?"
    emm "O que houve, tia?"

# game/scripts/c23/c23.rpy:3170
translate brazilian c23s006_AfterTheMeeting_6423ffeb:

    # bet "No me merezco esta familia..."
    bet "Eu não mereço esta família..."

# game/scripts/c23/c23.rpy:3171
translate brazilian c23s006_AfterTheMeeting_3c3e34d0:

    # mc "Te mereces esto y más."
    mc "Você merece isso e muito mais."

# game/scripts/c23/c23.rpy:3173
translate brazilian c23s006_AfterTheMeeting_0db44c4a:

    # emm "Estoy de acuerdo con [mc]. Todos querríamos ayudarte, y todo el mundo estaba muy preocupado por tu situación."
    emm "Concordo com [mc]. Todos nós queríamos te ajudar e estávamos muito preocupados com a sua situação."

# game/scripts/c23/c23.rpy:3174
translate brazilian c23s006_AfterTheMeeting_54b45c27:

    # emm "Si [mc] se negara a sí mismo el adelanto de sueldo, estoy segura de que entre todas conseguiríamos el dinero para tu certificación."
    emm "Se [mc] recusar o adiantamento salarial, tenho certeza de que juntos poderíamos arrecadar o dinheiro para sua certificação."

# game/scripts/c23/c23.rpy:3176
translate brazilian c23s006_AfterTheMeeting_93f90172:

    # emm "Seguro que para alguien como [lis] y [deb.nick], lo que cuesta la certificación es calderilla, y dijeron que podíamos contar con ellas para lo que necesitáramos."
    emm "Tenho certeza de que para alguém como [lis] e [deb.nick], o custo da certificação é insignificante, e eles disseram que poderíamos contar com eles para o que precisássemos."

# game/scripts/c23/c23.rpy:3177
translate brazilian c23s006_AfterTheMeeting_e9157e62:

    # emm "Aunque no hablamos de dinero, claro, porque no sabíamos que eso podría ser el problema."
    emm "Embora não tenhamos falado sobre dinheiro, é claro, porque não sabíamos que esse poderia ser o problema."

# game/scripts/c23/c23.rpy:3179
translate brazilian c23s006_AfterTheMeeting_55001268:

    # mc "Todo el mundo va a querer ayudarte. No te preocupes por eso."
    mc "Todos vão querer te ajudar. Não se preocupe com isso."

# game/scripts/c23/c23.rpy:3180
translate brazilian c23s006_AfterTheMeeting_761152f7:

    # bet "Pero..."
    bet "Mas..."

# game/scripts/c23/c23.rpy:3182
translate brazilian c23s006_AfterTheMeeting_6819fc88:

    # emm "Y [dap] y [sca] te ayudarán a estudiar si es necesario... Hay que estudiar para la certificación, ¿no?"
    emm "E [dap] e [sca] vão te ajudar a estudar, se necessário... Você precisa estudar para a certificação, certo?"

# game/scripts/c23/c23.rpy:3183
translate brazilian c23s006_AfterTheMeeting_f6ee4e4b:

    # emm "Yo también te ayudaría, pero no tengo ni idea de medicina."
    emm "Eu também te ajudaria, mas não entendo nada de medicina."

# game/scripts/c23/c23.rpy:3185
translate brazilian c23s006_AfterTheMeeting_597e2389:

    # bet "Chicos... me estáis emocionando..."
    bet "Gente... vocês estão me emocionando..."

# game/scripts/c23/c23.rpy:3186
translate brazilian c23s006_AfterTheMeeting_a7073025:

    # mc "La familia está para eso, Tía [bet]. No sólo para cuando todo va bien, sino para apoyarnos cuando hay algún problema."
    mc "É para isso que serve a família, tia [bet]. Não apenas quando tudo está bem, mas também para nos apoiar quando há um problema."

# game/scripts/c23/c23.rpy:3187
translate brazilian c23s006_AfterTheMeeting_9da09452:

    # mc "¿Cuándo les tienes que dar una respuesta?"
    mc "Quando você precisa dar uma resposta a eles?"

# game/scripts/c23/c23.rpy:3189
translate brazilian c23s006_AfterTheMeeting_cd37e247:

    # bet "Me han dado dos meses para pensármelo. Mañana tengo que pasar a recoger una documentación sobre los diferentes conventos que proponen."
    bet "Eles me deram dois meses para pensar sobre isso. Amanhã tenho que ir buscar alguns documentos sobre os diferentes conventos que estão sugerindo."

# game/scripts/c23/c23.rpy:3190
translate brazilian c23s006_AfterTheMeeting_21bc1964:

    # bet "Todo eso, obviamente, bajo la condición de que no hable con la prensa nunca."
    bet "Tudo isso, obviamente, sob a condição de que eu nunca fale com a imprensa."

# game/scripts/c23/c23.rpy:3191
translate brazilian c23s006_AfterTheMeeting_a57063ee:

    # mc "¿Qué te pueden hacer si hablas con la prensa?"
    mc "O que eles podem fazer com você se você falar com a imprensa?"

# game/scripts/c23/c23.rpy:3193
translate brazilian c23s006_AfterTheMeeting_79da8654:

    # bet "Podrían eliminar la opción del convento en Latinoamérica, que era la menos mala."
    bet "Eles poderiam eliminar a opção dos conventos na América Latina, que era a menos ruim."

# game/scripts/c23/c23.rpy:3194
translate brazilian c23s006_AfterTheMeeting_c2fe0315:

    # bet "De todas formas, no pensaba hablar con la prensa. No serviría de nada. El obispo Bakari no se vería afectado."
    bet "De qualquer forma, eu não planejava falar com a imprensa. Não adiantaria nada. O bispo Bakari não seria afetado."

# game/scripts/c23/c23.rpy:3196
translate brazilian c23s006_AfterTheMeeting_2dc9513a:

    # emm "Bueno, como no vas a hablar con la prensa ni vas a coger esa opción, no tenemos que hablar de eso ahora."
    emm "Bem, já que você não vai falar com a imprensa nem optar por essa alternativa, não precisamos discutir isso agora."

# game/scripts/c23/c23.rpy:3197
translate brazilian c23s006_AfterTheMeeting_df7a30d6:

    # mc "Tienes razón, [emm]. Ahora hay dos meses para sopesar opciones y pensar en qué podemos hacer y cómo hacerlo."
    mc "Você tem razão, [emm]. Agora temos dois meses para avaliar as opções e pensar no que podemos fazer e como fazê-lo."

# game/scripts/c23/c23.rpy:3199
translate brazilian c23s006_AfterTheMeeting_aa316288:

    # bet "No hay mucho que pensar. Si me prestáis el dinero..."
    bet "Não há muito em que pensar. Se você me emprestar o dinheiro..."

# game/scripts/c23/c23.rpy:3200
translate brazilian c23s006_AfterTheMeeting_33e8120e:

    # mc "No es un préstamo, es un regalo."
    mc "Não é um empréstimo, é uma doação."

# game/scripts/c23/c23.rpy:3202
translate brazilian c23s006_AfterTheMeeting_ae5cced6:

    # bet "{b}Si me prestáis el dinero{/b} para certificarme, creo que mi mejor opción sería abandonar la iglesia..."
    bet "Se você me emprestar o dinheiro para obter a certificação, acho que a melhor opção seria deixar a igreja..."

# game/scripts/c23/c23.rpy:3203
translate brazilian c23s006_AfterTheMeeting_8f7740d3:

    # bet "Y empezar a buscar trabajo como cirujana... a mi edad... Ufff..."
    bet "E começar a procurar emprego como cirurgião... na minha idade... Aff..."

# game/scripts/c23/c23.rpy:3204
translate brazilian c23s006_AfterTheMeeting_b233d797:

    # mc "Bueno, si piensas que es la mejor opción no vamos a intentar convencerte de lo contrario. Tienes dos meses para pensártelo."
    mc "Bem, se você acha que é a melhor opção, não vamos tentar convencê-lo do contrário. Você tem dois meses para pensar sobre isso."

# game/scripts/c23/c23.rpy:3206
translate brazilian c23s006_AfterTheMeeting_c2e00819:

    # emm "Y para alegrarte un poco el día, hoy invito yo a pizza."
    emm "E para alegrar um pouco o seu dia, hoje vou te oferecer uma pizza."

# game/scripts/c23/c23.rpy:3207
translate brazilian c23s006_AfterTheMeeting_462726fc:

    # emm "Por si estabas triste había buscado pizzerías con buenas reseñas."
    emm "Caso você estivesse se sentindo para baixo, eu procurei pizzarias com boas avaliações."

# game/scripts/c23/c23.rpy:3208
translate brazilian c23s006_AfterTheMeeting_c25289da:

    # mc "A veces eres sorprendente, [emm]. Cada vez más."
    mc "Às vezes você é incrível, [emm]. Cada vez mais."

# game/scripts/c23/c23.rpy:3210
translate brazilian c23s006_AfterTheMeeting_64416a28:

    # bet "¿Crees que me puedes comprar con comida, [emm]?"
    bet "Você acha que pode me comprar com comida, [emm]?"

# game/scripts/c23/c23.rpy:3212
translate brazilian c23s006_AfterTheMeeting_6010d2ad:

    # emm "No quería que sonara así, Tía... perdona..."
    emm "Não era minha intenção que soasse assim, tia... Me desculpe..."

# game/scripts/c23/c23.rpy:3214
translate brazilian c23s006_AfterTheMeeting_40b9e80e:

    # bet "Porque si lo crees, tienes toda la razón. *Risa*"
    bet "Porque se você acredita nisso, você está absolutamente certo. *Risos*"

# game/scripts/c23/c23.rpy:3215
translate brazilian c23s006_AfterTheMeeting_db62733e:

    # mc "*Risa* Vamos al motel a ducharnos y vamos a ver qué pizzería ha encontrado [emm]."
    mc "*Risos* Vamos ao motel tomar banho e ver o que a pizzaria [emm] encontrou."

# game/scripts/c23/c23.rpy:3218
translate brazilian c23s006_AfterTheMeeting_afab1693:

    # "Ver que se han abierto más opciones de las que había planteado la iglesia ayuda a mejorar los ánimos."
    "Ver que surgiram mais opções além das propostas pela igreja ajuda a melhorar o ânimo."

# game/scripts/c23/c23.rpy:3219
translate brazilian c23s006_AfterTheMeeting_8401a92d:

    # "Vais al motel a ducharos y cambiaros de ropa. Te pones la camisa azul."
    "Você vai ao motel para tomar banho e trocar de roupa. Você veste a camisa azul."

# game/scripts/c23/c23.rpy:3228
translate brazilian c23s007_AmaCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c23/c23.rpy:3229
translate brazilian c23s007_AmaCalls_26e5f8ba:

    # "Suena tu teléfono, es [ama]."
    "Seu telefone toca, é [ama]."

# game/scripts/c23/c23.rpy:3233
translate brazilian c23s007_AmaCalls_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Olá, [ama]. Posso te ajudar em alguma coisa?"

# game/scripts/c23/c23.rpy:3235
translate brazilian c23s007_AmaCalls_921677e6:

    # ama "Sólo llamábamos para saber cómo había ido la reunión de Tía [bet]. No queremos molestarla a ella."
    ama "Ligamos apenas para saber como foi a reunião da tia. Não queremos incomodá-la."

# game/scripts/c23/c23.rpy:3236
translate brazilian c23s007_AmaCalls_d1e46081:

    # eva "Hubiéramos llamado antes, pero no sabíamos a qué hora iba a terminar la reunión."
    eva "Teríamos ligado mais cedo, mas não sabíamos a que horas a reunião terminaria."

# game/scripts/c23/c23.rpy:3237
translate brazilian c23s007_AmaCalls_8279e80c:

    # mc "Bueno, ha ido como uno de los peores escenarios que habíamos pensado."
    mc "Bem, acabou sendo um dos piores cenários que havíamos imaginado."

# game/scripts/c23/c23.rpy:3238
translate brazilian c23s007_AmaCalls_8e598236:

    # mc "La propuesta de la iglesia es que se retire a un convento."
    mc "A proposta da igreja é que ela se retire para um convento."

# game/scripts/c23/c23.rpy:3240
translate brazilian c23s007_AmaCalls_d1718586:

    # eva "¡Putos cabrones! ¿Necesitas que hagamos una visita a ese obispo para convencerle... sutilmente?"
    eva "Seus filhos da puta! Vocês precisam que a gente faça uma visita àquele bispo para convencê-lo... sutilmente?"

# game/scripts/c23/c23.rpy:3241
translate brazilian c23s007_AmaCalls_ba40ba01:

    # mc "No, [eva]. Tía [bet] tiene que darles una respuesta en dos meses, con lo que hay tiempo para pensar qué quiere hacer."
    mc "Não, [eva]. A tia [bet] tem que dar uma resposta a eles em dois meses, então há tempo para pensar sobre o que ela quer fazer."

# game/scripts/c23/c23.rpy:3243
translate brazilian c23s007_AmaCalls_99d6c0b8:

    # ama "Si quieres... podemos buscar cosas sobre ese obispo, o sobre el de Tanzania, para poder hacer más presión y que cambien de opinión."
    ama "Se quiserem... podemos investigar esse bispo, ou o da Tanzânia, para podermos pressioná-los mais e fazê-los mudar de ideia."

# game/scripts/c23/c23.rpy:3244
translate brazilian c23s007_AmaCalls_b04b3be0:

    # mc "Creo que Tía [bet] no querría eso. Ahora mismo se siente como que no pertenece a la Iglesia. Se siente traicionada."
    mc "Acho que a tia [bet] não gostaria disso. No momento, ela sente que não pertence à Igreja. Ela se sente traída."

# game/scripts/c23/c23.rpy:3245
translate brazilian c23s007_AmaCalls_b86234e6:

    # mc "Por eso se tomará estos meses para sopesar dejar de ser monja. Casi lo ha decidido ya."
    mc "É por isso que ela está aproveitando esses meses para pensar em deixar o convento. Ela já está quase decidida."

# game/scripts/c23/c23.rpy:3247
translate brazilian c23s007_AmaCalls_2dbe68e6:

    # ama "Es lógico. La quieren esconder después de lo de Tanzania, y eso es cruel."
    ama "Faz sentido. Eles querem escondê-la depois do que aconteceu na Tanzânia, e isso é cruel."

# game/scripts/c23/c23.rpy:3248
translate brazilian c23s007_AmaCalls_7cad4306:

    # mc "Por lo que me ha explicado, esa es exactamente su intención, que acabe sus días en un sitio donde no moleste."
    mc "Pelo que ele me explicou, essa é exatamente a sua intenção: terminar seus dias em um lugar onde não seja um incômodo."

# game/scripts/c23/c23.rpy:3249
translate brazilian c23s007_AmaCalls_5d374c27:

    # mc "Y donde no pueda hablar con la prensa."
    mc "E onde eu não posso falar com a imprensa."

# game/scripts/c23/c23.rpy:3251
translate brazilian c23s007_AmaCalls_5f6a0907:

    # eva "¡Putos cabrones! Necesito dispararle a algo. Dale un abrazo de mi parte a Tía [bet]."
    eva "Seus filhos da puta! Preciso filmar alguma coisa. Mande um abraço para a tia [bet] por mim."

# game/scripts/c23/c23.rpy:3252
translate brazilian c23s007_AmaCalls_9fa74b4e:

    # mc "¡[eva]!"
    mc "[eva]!"

# game/scripts/c23/c23.rpy:3254
translate brazilian c23s007_AmaCalls_7a9a2ae8:

    # ama "Ya se ha ido. Cuando se le desatan sentimientos que no puede controlar hace prácticas de tiro. Ya lo viste ayer."
    ama "Ele já se foi. Quando sente algo que não consegue controlar, vai treinar tiro. Você o viu ontem."

# game/scripts/c23/c23.rpy:3255
translate brazilian c23s007_AmaCalls_6991613d:

    # mc "Espero no enfadarla nunca..."
    mc "Espero nunca a magoar..."

# game/scripts/c23/c23.rpy:3258
translate brazilian c23s007_AmaCalls_26a478e8:

    # ama "Hasta vuestra primera cita, como mínimo, estás seguro. *Risa*"
    ama "Pelo menos até o primeiro encontro, você está segura. *Risos*"

# game/scripts/c23/c23.rpy:3259
translate brazilian c23s007_AmaCalls_60db5d70:

    # mc "Entonces tendremos la primera cita dentro de muchos años. *Risa*"
    mc "Então teremos nosso primeiro encontro em muitos anos. *Risos*"

# game/scripts/c23/c23.rpy:3260
translate brazilian c23s007_AmaCalls_a787076b:

    # ama "Si la retrasas mucho dejarás de estar seguro también. *Risa*"
    ama "Se você demorar muito, também vai deixar de ter certeza. *Risos*"

# game/scripts/c23/c23.rpy:3262
translate brazilian c23s007_AmaCalls_06c6a38d:

    # ama "Si no te disparó ayer después de rechazarla, supongo que puedes considerarte seguro."
    ama "Se ela não atirou em você ontem depois que você a rejeitou, acho que você pode se considerar a salvo."

# game/scripts/c23/c23.rpy:3263
translate brazilian c23s007_AmaCalls_826e85ca:

    # mc "¿Necesitas algo más? Iba a llevar a las chicas a cenar..."
    mc "Precisa de mais alguma coisa? Eu ia levar as meninas para jantar fora..."

# game/scripts/c23/c23.rpy:3265
translate brazilian c23s007_AmaCalls_4edac293:

    # ama "Solo una cosa más. Es una idea que se les ha ocurrido a Jamaal y a [nor], pero puede esperar si tienes prisa."
    ama "Só mais uma coisa. É uma ideia que Jamaal já teve [nor], mas pode esperar se você estiver com pressa."

# game/scripts/c23/c23.rpy:3266
translate brazilian c23s007_AmaCalls_a9665a34:

    # mc "No, tranquila, [emm] aún se está acabando de vestir. Dime."
    mc "Não, não se preocupe, ela ainda está se vestindo. Me diga."

# game/scripts/c23/c23.rpy:3268
translate brazilian c23s007_AmaCalls_7762f7d9:

    # ama "Jamaal y yo estábamos hablando de lo de los asistentes a la fiesta del barco de Iron Fist cuando ha aparecido [nor]."
    ama "Eu e Jamaal estávamos conversando sobre os participantes da festa de barco do Punho de Ferro quando [nor] apareceu."

# game/scripts/c23/c23.rpy:3269
translate brazilian c23s007_AmaCalls_61d4ff67:

    # ama "[nor] es muy inteligente y ha estado pensando en que, si reconvertimos NTR en una empresa médica, el nombre puede ser un lastre."
    ama "[nor] é muito inteligente e tem pensado que, se mudarmos a marca da NTR para uma empresa médica, o nome poderá ser um problema."

# game/scripts/c23/c23.rpy:3270
translate brazilian c23s007_AmaCalls_e7d42cd0:

    # mc "*Risa* Ese nombre sería un lastre fuera como fuera."
    mc "*Risos* Esse nome seria um fardo, não importa o quê."

# game/scripts/c23/c23.rpy:3272
translate brazilian c23s007_AmaCalls_187a4d9b:

    # ama "Algo parecido ha dicho Jamaal, pero no entiendo por qué."
    ama "Jamaal disse algo semelhante, mas não entendo porquê."

# game/scripts/c23/c23.rpy:3273
translate brazilian c23s007_AmaCalls_02086512:

    # ama "[nor] lo decía porque NTR tiene un pasado militar y, en este país, puede ser un problema."
    ama "[nor] Eu disse isso porque NTR tem um passado militar e, neste país, isso pode ser um problema."

# game/scripts/c23/c23.rpy:3274
translate brazilian c23s007_AmaCalls_f594ed77:

    # mc "Tiene razón, pero no por el pasado militar, sino por las operaciones encubiertas. La gente desconfía de lo que se le oculta."
    mc "Ele tem razão, mas não por causa de seu passado militar, e sim por causa das operações secretas. As pessoas desconfiam daquilo que lhes é ocultado."

# game/scripts/c23/c23.rpy:3275
translate brazilian c23s007_AmaCalls_c2426e12:

    # mc "¿Ha propuesto cambiarle el nombre a la empresa?"
    mc "Você já propôs mudar o nome da empresa?"

# game/scripts/c23/c23.rpy:3277
translate brazilian c23s007_AmaCalls_06b509fe:

    # ama "Más que cambiarle el nombre, crear una empresa filial y traspasar toda la actividad médica allí. Al menos a nivel comercial."
    ama "Em vez de mudar o nome, seria melhor criar uma subsidiária e transferir toda a atividade médica para lá. Pelo menos em nível comercial."

# game/scripts/c23/c23.rpy:3278
translate brazilian c23s007_AmaCalls_ac8b2401:

    # mc "Me parece bien. Así NTR quedará para soporte a otras empresas de operaciones encubiertas y la nueva empresa se ocupará de todo el tema médico."
    mc "Isso me parece ótimo. Dessa forma, a NTR estará disponível para apoiar outras empresas de operações secretas, e a nova empresa cuidará de todos os aspectos médicos."

# game/scripts/c23/c23.rpy:3280
translate brazilian c23s007_AmaCalls_a9164267:

    # ama "A Jamaal también le ha parecido una buena idea. Incluso se le ha ocurrido un nombre. Harnessing Advanced Research for Enhancing Medicine."
    ama "Jamaal também achou que era uma boa ideia. Ele até sugeriu um nome: Aproveitando a Pesquisa Avançada para Aprimorar a Medicina."

# game/scripts/c23/c23.rpy:3281
translate brazilian c23s007_AmaCalls_0a88ead0:

    # ama "Aprovechar la investigación avanzada para mejorar la medicina. Aunque me parece un poco largo"
    ama "Aproveitando pesquisas avançadas para aprimorar a medicina. Embora me pareça um pouco extenso."

# game/scripts/c23/c23.rpy:3282
translate brazilian c23s007_AmaCalls_72c20cb4:

    # mc "A mí me parece un buen nombre, podemos usar siglas como NTR..."
    mc "Acho que é um bom nome; podemos usar acrônimos como NTR..."

# game/scripts/c23/c23.rpy:3283
translate brazilian c23s007_AmaCalls_5367af7b:

    # mc "Espera..."
    mc "Espere..."

# game/scripts/c23/c23.rpy:3284
translate brazilian c23s007_AmaCalls_91f9fbdb:

    # mc "*Risa* Jamaal es un capullo."
    mc "*Risos* Jamaal é um idiota."

# game/scripts/c23/c23.rpy:3286
translate brazilian c23s007_AmaCalls_5dc56569:

    # ama "¿Qué pasa?"
    ama "O que está acontecendo?"

# game/scripts/c23/c23.rpy:3287
translate brazilian c23s007_AmaCalls_5ceedf9e:

    # mc "¿No te has dado cuenta de cuáles serían las siglas? H.A.R.E.M."
    mc "Você ainda não percebeu o que a sigla significa? HARÉM"

# game/scripts/c23/c23.rpy:3289
translate brazilian c23s007_AmaCalls_18aedd9b:

    # ama "¡Me ha tomado el pelo! *Risa* Voy a decirle a [eva] que practique tiro contra sus ruedas."
    ama "Ele estava me zoando! *Risos* Vou dizer para o [eva] praticar tiro nos próprios pneus."

# game/scripts/c23/c23.rpy:3290
translate brazilian c23s007_AmaCalls_2459552a:

    # mc "*Risa* Si Jamaal empieza a gastarte bromas, significa que está dejando de teneros miedo. Es su forma de daros la bienvenida a la familia."
    mc "*Risos* Se o Jamaal começar a te provocar, significa que ele está superando o medo que tinha de você. É o jeito dele de te dar as boas-vindas à família."

# game/scripts/c23/c23.rpy:3291
translate brazilian c23s007_AmaCalls_4dfc6171:

    # mc "*Risa* Pero sigue pareciéndome un buen nombre. Sigue la línea de NTR y GILF."
    mc "*Risos* Mas ainda acho que é um bom nome. Segue a tendência NTR e GILF."

# game/scripts/c23/c23.rpy:3293
translate brazilian c23s007_AmaCalls_f5d9ea6d:

    # ama "Continúo sin entender qué tiene de malo NTR."
    ama "Ainda não entendo o que há de errado com NTR."

# game/scripts/c23/c23.rpy:3294
translate brazilian c23s007_AmaCalls_290dcc15:

    # mc "Mucho, [ama]. Mucho."
    mc "Muito, [ama]. Muito."

# game/scripts/c23/c23.rpy:3296
translate brazilian c23s007_AmaCalls_f3cd91b4:

    # mc "Puedes preguntárselo a [deb.nick] cuando la veas. *Risa*"
    mc "Você pode perguntar [deb.nick] quando a vir. *Risos*"

# game/scripts/c23/c23.rpy:3299
translate brazilian c23s007_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c23/c23.rpy:3300
translate brazilian c23s007_AmaCalls_6aeda812:

    # emm "*A través de la puerta* [mc], ya estamos listas. Te esperamos en el coche."
    emm "*Pela porta* [mc], estamos prontos. Estaremos esperando por você no carro."

# game/scripts/c23/c23.rpy:3301
translate brazilian c23s007_AmaCalls_c02ac796:

    # mc "Ahora voy. Un segundo."
    mc "Já vou. Só um segundo."

# game/scripts/c23/c23.rpy:3303
translate brazilian c23s007_AmaCalls_7bd50a56:

    # ama "Ve antes de que [emm] se impaciente. *Risa* No sé si ese hotel tiene tienda de regalos, pero podría empezar a comprar cosas rosas."
    ama "Vá antes que [emm] fique impaciente. *Risos* Não sei se esse hotel tem uma loja de presentes, mas eu poderia começar a comprar coisas cor-de-rosa."

# game/scripts/c23/c23.rpy:3304
translate brazilian c23s007_AmaCalls_a54e5e50:

    # mc "*Risa* No te preocupes, no hay tienda de regalos."
    mc "*Risos* Não se preocupe, não há loja de presentes."

# game/scripts/c23/c23.rpy:3305
translate brazilian c23s007_AmaCalls_cdc39172:

    # mc "Os mantengo informadas de cómo va lo de Tía [bet] mañana."
    mc "Amanhã eu te informo sobre como as coisas estão indo com a tia [bet]."

# game/scripts/c23/c23.rpy:3307
translate brazilian c23s007_AmaCalls_a6bb3df2:

    # mc "Y has dicho que estaré seguro hasta la primera cita con [eva]. Tú y yo tenemos que planificar la nuestra también."
    mc "E você disse que eu estarei segura até o primeiro encontro com [eva]. Nós duas precisamos planejar o nosso também."

# game/scripts/c23/c23.rpy:3309
translate brazilian c23s007_AmaCalls_ac110be9:

    # mc "Y tú y yo tenemos una cita que planificar."
    mc "E você e eu temos um encontro para marcar."

# game/scripts/c23/c23.rpy:3312
translate brazilian c23s007_AmaCalls_13fd4da7:

    # ama "No te preocupes por eso. El otro día en el café cuenta como nuestra primera cita. Hubo besos. Suficiente para mí, al menos por ahora."
    ama "Não se preocupe com isso. O que aconteceu outro dia no café conta como nosso primeiro encontro. Houve beijos. Para mim, já basta, pelo menos por enquanto."

# game/scripts/c23/c23.rpy:3313
translate brazilian c23s007_AmaCalls_1c86b48c:

    # ama "Y vete antes de que Tía [bet] empiece a tener hambre. *Risa* Hasta mañana, [mc]."
    ama "E vá embora antes que a tia [bet] comece a ficar com fome. *Risos* Até amanhã, [mc]."

# game/scripts/c23/c23.rpy:3314
translate brazilian c23s007_AmaCalls_69ad4751:

    # mc "Hablamos mañana, [ama]."
    mc "Falaremos amanhã, [ama]."

# game/scripts/c23/c23.rpy:3322
translate brazilian c23s007_SleepingArrangements_452e6387:

    # "Pasáis una noche agradable, cenando y riendo, sin nombrar ni una sola vez el dilema de [bet]."
    "Você passa uma noite agradável, jantando e rindo, sem mencionar o dilema de [bet] uma única vez."

# game/scripts/c23/c23.rpy:3323
translate brazilian c23s007_SleepingArrangements_eb458632:

    # "[emm] os explica emocionada todo lo que ha aprendido en el curso de conducción y por dónde ha conducido mientras os esperaba."
    "[emm] Ela explica com entusiasmo tudo o que aprendeu no curso de direção e por onde dirigiu enquanto esperava por você."

# game/scripts/c23/c23.rpy:3324
translate brazilian c23s007_SleepingArrangements_8a3270a9:

    # "Cuando le preguntas, se niega a decir qué ha comprado para las chicas en casa."
    "Quando você pergunta a ela, ela se recusa a dizer o que comprou para as meninas em casa."

# game/scripts/c23/c23.rpy:3326
translate brazilian c23s007_SleepingArrangements_96c1d5b6:

    # "Al llegar al hotel os dirigís a vuestras respectivas habitaciones."
    "Ao chegar ao hotel, você se dirigirá ao seu respectivo quarto."

# game/scripts/c23/c23.rpy:3327
translate brazilian c23s007_SleepingArrangements_e2dd6b3a:

    # "Pasas una buena noche de descanso."
    "Tenha uma boa noite de sono."

# game/scripts/c23/c23.rpy:3331
translate brazilian c23s007_SleepingArrangements_9c10f707:

    # "Al llegar al hotel..."
    "Ao chegar ao hotel..."

# game/scripts/c23/c23.rpy:3332
translate brazilian c23s007_SleepingArrangements_bf7af1cf:

    # emm "¡Ay! ¡Uff!"
    emm "Ufa!"

# game/scripts/c23/c23.rpy:3333
translate brazilian c23s007_SleepingArrangements_05b11d12:

    # mc "¿Qué te pasa, [emm]?"
    mc "O que há de errado, [emm]?"

# game/scripts/c23/c23.rpy:3335
translate brazilian c23s007_SleepingArrangements_d6407639:

    # emm "Te he dicho antes de salir que si tenía que dormir sentada me acabaría doliendo el cuello."
    emm "Eu te disse antes de sairmos que, se eu tivesse que dormir sentada, meu pescoço acabaria doendo."

# game/scripts/c23/c23.rpy:3336
translate brazilian c23s007_SleepingArrangements_2fe6ac9f:

    # emm "Entre eso y después el curso de conducción, lo tengo hecho polvo. Ahora entiendo por qué los pilotos tienen cuellos como troncos."
    emm "Entre isso e o curso de direção, estou completamente exausto. Agora entendo por que os pilotos têm pescoços tão grossos quanto troncos de árvores."

# game/scripts/c23/c23.rpy:3338
translate brazilian c23s007_SleepingArrangements_34e6e135:

    # bet "¿Quieres que te dé un masaje o algo?"
    bet "Você quer que eu te faça uma massagem ou algo assim?"

# game/scripts/c23/c23.rpy:3339
translate brazilian c23s007_SleepingArrangements_dd323ab7:

    # mc "O tomarte un analgésico."
    mc "Ou tome um analgésico."

# game/scripts/c23/c23.rpy:3341
translate brazilian c23s007_SleepingArrangements_75440d8e:

    # emm "No hace falta. Con una buena noche de descanso..."
    emm "Não precisa. Com uma boa noite de sono..."

# game/scripts/c23/c23.rpy:3343
translate brazilian c23s007_SleepingArrangements_71b9ad2d:

    # emm "¡Oh!"
    emm "Oh!"

# game/scripts/c23/c23.rpy:3344
translate brazilian c23s007_SleepingArrangements_3b916da8:

    # mc "¿Qué pasa?"
    mc "O que está acontecendo?"

# game/scripts/c23/c23.rpy:3346
translate brazilian c23s007_SleepingArrangements_4f341d25:

    # emm "No has cogido camas individuales, y cuando tengo este dolor de cuello me muevo mucho durmiendo."
    emm "Vocês não reservaram camas de solteiro, e quando eu tenho essa dor no pescoço, eu me mexo muito enquanto durmo."

# game/scripts/c23/c23.rpy:3347
translate brazilian c23s007_SleepingArrangements_964584cf:

    # emm "Voy a molestar a Tía [bet] y no le voy a dejar dormir."
    emm "Vou incomodar a tia [bet] e não deixá-la dormir."

# game/scripts/c23/c23.rpy:3349
translate brazilian c23s007_SleepingArrangements_7dc2697f:

    # bet "No te preocupes, yo duermo como un tronco..."
    bet "Não se preocupe, eu durmo como uma pedra..."

# game/scripts/c23/c23.rpy:3351
translate brazilian c23s007_SleepingArrangements_6912d95d:

    # mc "Puedes dormir en mi cama y yo duermo en el sofá. No parece incómodo."
    mc "Você pode dormir na minha cama e eu durmo no sofá. Não parece estranho."

# game/scripts/c23/c23.rpy:3353
translate brazilian c23s007_SleepingArrangements_d20312a3:

    # emm "No podría hacerte eso. Es tu cama..."
    emm "Eu não poderia fazer isso com você. É a sua cama..."

# game/scripts/c23/c23.rpy:3354
translate brazilian c23s007_SleepingArrangements_97a9ca7c:

    # emm "Pero has tenido una buena idea. ¿Por qué no nos cambiamos de habitación? Yo duermo en la tuya y tú en la mía."
    emm "Mas você teve uma ótima ideia. Que tal trocarmos de quarto? Eu durmo no seu e você no meu."

# game/scripts/c23/c23.rpy:3355
translate brazilian c23s007_SleepingArrangements_808af671:

    # mc "Porque acabas de decir que es una cama doble. No sé si Tía [bet] querrá compartirla conmigo."
    mc "Porque você acabou de dizer que é uma cama de casal. Não sei se a tia [bet] vai querer dividi-la comigo."

# game/scripts/c23/c23.rpy:3357
translate brazilian c23s007_SleepingArrangements_6910781a:

    # bet "No voy a permitir que duermas en un sofá."
    bet "Não vou permitir que você durma no sofá."

# game/scripts/c23/c23.rpy:3359
translate brazilian c23s007_SleepingArrangements_344a8f78:

    # emm "¿Ves? Además, Tía [bet] seguro que ha traído un pijama nada sexy de esos de franela."
    emm "Viu? Além disso, a tia [bet] provavelmente trouxe um daqueles pijamas de flanela não tão sexy."

# game/scripts/c23/c23.rpy:3361
translate brazilian c23s007_SleepingArrangements_17664d9e:

    # bet "*Risa* ¿Has estado revolviendo en mi maleta? No es de franela, pero no creo que nadie pueda considerarlo sexy."
    bet "*Risos* Você andou revirando minha mala? Não é flanela, mas acho que ninguém consideraria isso sexy."

# game/scripts/c23/c23.rpy:3362
translate brazilian c23s007_SleepingArrangements_079ee38a:

    # mc "¿Estás segura, Tía [bet]?"
    mc "Tem certeza, tia [bet]?"

# game/scripts/c23/c23.rpy:3364
translate brazilian c23s007_SleepingArrangements_da3bdc54:

    # bet "¿De que el pijama no es sexy o de que no voy a dejarte dormir en el sofá?"
    bet "Você está dizendo que pijamas não são sensuais, ou que eu não vou deixar você dormir no sofá?"

# game/scripts/c23/c23.rpy:3365
translate brazilian c23s007_SleepingArrangements_eeb87e89:

    # bet "Porque estoy muy segura de las dos cosas."
    bet "Porque tenho muita certeza de ambas as coisas."

# game/scripts/c23/c23.rpy:3367
translate brazilian c23s007_SleepingArrangements_6dfe85cb:

    # emm "Entonces todo arreglado. Ayúdame a mover mis tres maletas a tu habitación, [mc]."
    emm "Então tudo estará resolvido. Ajude-me a levar minhas três malas para o seu quarto, [mc]."

# game/scripts/c23/c23.rpy:3368
translate brazilian c23s007_SleepingArrangements_048f453e:

    # mc "Vamos, se está haciendo tarde y tú has dormido poco esta noche."
    mc "Vamos lá, está ficando tarde e você não dormiu muito bem ontem à noite."

# game/scripts/c23/c23.rpy:3370
translate brazilian c23s007_SleepingArrangements_c43baea5:

    # "Una vez movidas las maletas..."
    "Assim que as malas foram movidas..."

# game/scripts/c23/c23.rpy:3371
translate brazilian c23s007_SleepingArrangements_b7167afb:

    # emm "Descansa, que mañana quiero hacer turismo. Podemos dejar el Ferrarini aquí e ir con tu coche. O incluso devolverlo antes."
    emm "Descanse, quero fazer turismo amanhã. Podemos deixar a Ferrarini aqui e ir no seu carro. Ou até devolvê-la mais cedo."

# game/scripts/c23/c23.rpy:3372
translate brazilian c23s007_SleepingArrangements_bae81fae:

    # mcp "(¿No era el otro lado del cuello el que le dolía? Es posible que le duelan los dos, ¿no?)"
    mcp "(Não era o outro lado do pescoço dele que doía? É possível que ambos os lados doam, não é?)"

# game/scripts/c23/c23.rpy:3373
