    mc "Tem algum problema para você que eu tenha saído e dormido com [sai] enquanto você e eu não estávamos juntos?"

# game/scripts/c23/c23.rpy:1465
translate brazilian c23s003_Eil_bed78a97:

    # eil "No. Y no. Pero con las mujeres es diferente..."
    eil "Não. E não. Mas com as mulheres é diferente..."

# game/scripts/c23/c23.rpy:1466
translate brazilian c23s003_Eil_d5fb6099:

    # eil "Si un hombre se acuesta con diez mujeres diferentes es un macho."
    eil "Se um homem dorme com dez mulheres diferentes, ele é um garanhão."

# game/scripts/c23/c23.rpy:1467
translate brazilian c23s003_Eil_69d7a2f3:

    # eil "Si una mujer se acuesta con tres hombres, es una puta para muchos hombres."
    eil "Se uma mulher dorme com três homens, ela é uma prostituta para muitos homens."

# game/scripts/c23/c23.rpy:1468
translate brazilian c23s003_Eil_e8be8f2f:

    # mc "Son esos hombres los que tienen un problema, no la mujer. Sabes que yo no pienso así."
    mc "São os homens que têm um problema, não a mulher. Sabe, eu não penso dessa forma."

# game/scripts/c23/c23.rpy:1469
translate brazilian c23s003_Eil_c9d46b3a:

    # mc "Además, no lo hiciste, con lo que no hay más de que hablar."
    mc "Além disso, você não fez isso, então não há mais nada a discutir."

# game/scripts/c23/c23.rpy:1471
translate brazilian c23s003_Eil_36321820:

    # eil "Son por estas cosas por las que te quiero. Lo sabes, ¿verdad?"
    eil "É por essas razões que eu te amo. Você sabe disso, não é?"

# game/scripts/c23/c23.rpy:1472
translate brazilian c23s003_Eil_656b4a49:

    # mc "Yo creía que sólo me querías porque soy el mejor amante que nadie pueda imaginar. *Risa*"
    mc "Pensei que você só me amava porque sou o melhor amante que alguém poderia imaginar. *Risos*"

# game/scripts/c23/c23.rpy:1474
translate brazilian c23s003_Eil_f6938275:

    # eil "A veces eres idiota. Estoy hablando en serio, [mc]."
    eil "Às vezes você é um idiota. Estou falando sério, [mc]."

# game/scripts/c23/c23.rpy:1475
translate brazilian c23s003_Eil_daa9aca1:

    # eil "Si fueras diferente no me atrevería a hablarte de todo."
    eil "Se você fosse diferente, eu não ousaria falar com você sobre tudo."

# game/scripts/c23/c23.rpy:1476
translate brazilian c23s003_Eil_b8dd6aac:

    # mc "Lo sé. Yo también te quiero, [eil.nick]. Eres una mujer maravillosa."
    mc "Eu sei. Eu também te amo, [eil.nick]. Você é uma mulher maravilhosa."

# game/scripts/c23/c23.rpy:1478
translate brazilian c23s003_Eil_efa06021:

    # eil "Pues ahora esta mujer maravillosa se va a tener que ir. Me quiero dar una ducha rápida antes de ir a trabajar."
    eil "Bom, agora essa mulher maravilhosa vai ter que ir embora. Quero tomar um banho rápido antes de ir trabalhar."

# game/scripts/c23/c23.rpy:1479
translate brazilian c23s003_Eil_74edfffa:

    # mc "Puedes coger mi albornoz si quieres y ducharte aquí."
    mc "Você pode pegar meu roupão se quiser e tomar banho aqui."

# game/scripts/c23/c23.rpy:1481
translate brazilian c23s003_Eil_ed09d202:

    # eil "No hace falta. Me vuelvo a poner el uniforme y voy a casa. Tengo tiempo."
    eil "Não precisa. Vou vestir meu uniforme de novo e ir para casa. Tenho tempo."

# game/scripts/c23/c23.rpy:1482
translate brazilian c23s003_Eil_8a4b213f:

    # mc "Como desees."
    mc "Como desejar."

# game/scripts/c23/c23.rpy:1484
translate brazilian c23s003_Eil_a882f7fe:

    # "Una vez los dos os habéis vestido..."
    "Assim que ambos estiverem vestidos..."

# game/scripts/c23/c23.rpy:1485
translate brazilian c23s003_Eil_7b478453:

    # eil "Me voy a ir ya. Gracias por ser como eres."
    eil "Vou indo agora. Obrigada por ser você."

# game/scripts/c23/c23.rpy:1486
translate brazilian c23s003_Eil_2a5242a9:

    # mc "Gracias a ti por hacerme como soy."
    mc "Obrigado por me fazer quem eu sou."

# game/scripts/c23/c23.rpy:1488
translate brazilian c23s003_Eil_4092f2d3:

    # eil "¡Oh! ¡Eso es muy bonito! No me lo habías dicho nunca."
    eil "Oh! Que legal! Você nunca tinha me dito isso antes."

# game/scripts/c23/c23.rpy:1490
translate brazilian c23s003_Eil_460ad180:

    # mc "Pero te lo he demostrado muchas veces."
    mc "Mas eu já provei isso para você muitas vezes."

# game/scripts/c23/c23.rpy:1498
translate brazilian c23s004_Kia_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c23/c23.rpy:1499
translate brazilian c23s004_Kia_999e0f29:

    # kia "*A través de la puerta* [mc], ¿estás ahí? ¿Puedo pasar?"
    kia "*Pela porta* [mc], você está aí? Posso entrar?"

# game/scripts/c23/c23.rpy:1500
translate brazilian c23s004_Kia_4d601f0e:

    # mc "Sí, pasa."
    mc "Sim, acontece."

# game/scripts/c23/c23.rpy:1503
translate brazilian c23s004_Kia_dd2620e4:

    # kia "¡Oh! No sabía que estabas aquí, [eil.nick]. Precisamente venía a preguntarle a [mc] si te había visto."
    kia "Oh! Eu não sabia que você estava aqui, [eil.nick]. Eu só vim perguntar a [mc] se ela tinha te visto."

# game/scripts/c23/c23.rpy:1505
translate brazilian c23s004_Kia_f92d1814:

    # eil "Llevo un rato aquí, hemos estado... charlando."
    eil "Estou aqui há algum tempo, e nós temos estado... conversando."

# game/scripts/c23/c23.rpy:1506
translate brazilian c23s004_Kia_fd36aada:

    # mc "¿No estabas trabajando?"
    mc "Você não estava trabalhando?"

# game/scripts/c23/c23.rpy:1508
translate brazilian c23s004_Kia_59b23038:

    # kia "Hoy empiezo a mediodía. Por eso estaba buscando a [eil]."
    kia "Começo ao meio-dia hoje. É por isso que eu estava procurando por [eil]."

# game/scripts/c23/c23.rpy:1509
translate brazilian c23s004_Kia_8fe2bb9b:

    # kia "Me ha llamado [oma]. Va a venir a recogerme para llevarme al trabajo, por si querías venir tú también y te dejamos en el café."
    kia "[oma] me ligou. Ele vai me buscar para me levar ao trabalho, caso você queira vir também e a gente te deixa no café."

# game/scripts/c23/c23.rpy:1511
translate brazilian c23s004_Kia_62fd67d7:

    # eil "¡Oh, eso sería fantástico! ¡Voy a cambiarme!"
    eil "Ah, isso seria fantástico! Vou mudar!"

# game/scripts/c23/c23.rpy:1514
translate brazilian c23s004_Kia_84ff7fc5:

    # eil "Por cierto, Mamá, sabes que puedes besar a [mc] aunque yo esté delante, ¿verdad?"
    eil "Aliás, mãe, você sabe que pode beijar [mc] mesmo que eu esteja aí, né?"

# game/scripts/c23/c23.rpy:1515
translate brazilian c23s004_Kia_945c30b7:

    # mc "[eil], no tienes que presionarla."
    mc "[eil], você não precisa pressioná-lo."

# game/scripts/c23/c23.rpy:1517
translate brazilian c23s004_Kia_6b45fe62:

    # kia "*Risa* No me siento presionada, pero prefiero hacerlo cuando te hayas ido."
    kia "*Risos* Não me sinto pressionada, mas prefiro fazer isso quando você for embora."

# game/scripts/c23/c23.rpy:1519
translate brazilian c23s004_Kia_c2a7821f:

    # eil "Pues me voy y os dejo que os beséis con tranquilidad."
    eil "Bem, vou deixar vocês dois a sós para se beijarem em paz."

# game/scripts/c23/c23.rpy:1522
translate brazilian c23s004_Kia_59fe7813:

    # kia "Esta chica..."
    kia "Essa garota..."

# game/scripts/c23/c23.rpy:1523
translate brazilian c23s004_Kia_9fcd8d5a:

    # mc "Creo que tenías un beso para mí..."
    mc "Acho que você me deu um beijo..."

# game/scripts/c23/c23.rpy:1525
translate brazilian c23s004_Kia_d243bc2f:

    # "Sin decir una palabra, sus dulces labios buscan los tuyos."
    "Sem dizer uma palavra, seus doces lábios buscam os seus."

# game/scripts/c23/c23.rpy:1526
translate brazilian c23s004_Kia_c1e0c57d:

    # "Hoy no saben a aguacate, pero no por ello son menos deliciosos."
    "Hoje elas não têm gosto de abacate, mas nem por isso são menos deliciosas."

# game/scripts/c23/c23.rpy:1527
translate brazilian c23s004_Kia_5c482df3:

    # "Como siempre, os separáis para recuperar el aliento. Demasiado pronto."
    "Como sempre, vocês se separam para recuperar o fôlego. Cedo demais."

# game/scripts/c23/c23.rpy:1530
translate brazilian c23s004_Kia_e1381dbf:

    # kia "*Respiración entrecortada* ¡Phew! Y por esto prefiero besarte en privado. *Risa*"
    kia "*Ofegante* Ufa! E é por isso que prefiro te beijar em particular. *Risos*"

# game/scripts/c23/c23.rpy:1531
translate brazilian c23s004_Kia_b9a14b7b:

    # mc "Llamaremos a estos besos Darth Bader. *Risa* Cada vez que nos separamos respiramos como él."
    mc "Vamos chamar esses beijos de Darth Babble. *Risos* Toda vez que nos separamos, respiramos como ele."

# game/scripts/c23/c23.rpy:1533
translate brazilian c23s004_Kia_9b46c866:

    # kia "*Risa* A veces me extraña que algo tan de mi época lo hayáis adoptado los jóvenes."
    kia "*Risos* Às vezes me surpreende que algo tão da minha época tenha sido adotado pelos jovens."

# game/scripts/c23/c23.rpy:1534
translate brazilian c23s004_Kia_248258de:

    # mc "*Risa* Con la cantidad de spin offs que han hecho, creo que es de todas las épocas."
    mc "*Risos* Com a quantidade de spin-offs que eles fizeram, acho que são de todas as épocas."

# game/scripts/c23/c23.rpy:1536
translate brazilian c23s004_Kia_c37a601b:

    # kia "*Risa* Tienes razón, han encontrado la gallina de los huevos de oro y no pararán hasta que la maten."
    kia "*Risos* Você tem razão, eles encontraram a galinha dos ovos de ouro e não vão parar até matá-la."

# game/scripts/c23/c23.rpy:1537
translate brazilian c23s004_Kia_1d1af333:

    # mc "Cambiando de tema, ¿hoy no hay vestido morado?"
    mc "Mudando de assunto, não há nenhum vestido roxo hoje?"

# game/scripts/c23/c23.rpy:1539
translate brazilian c23s004_Kia_60fbe70c:

    # kia "Hoy no he quedado para comer con ningún chico guapo, con lo que no hay nadie a quien impresionar."
    kia "Não vou encontrar nenhum rapaz bonito para almoçar hoje, então não tenho ninguém para impressionar."

# game/scripts/c23/c23.rpy:1540
translate brazilian c23s004_Kia_c5e92548:

    # mc "Tú impresionarías a ese chico afortunado llevaras lo que llevaras, o aunque no llevaras nada..."
    mc "Você impressionaria aquele sortudo não importa o que vestisse, ou mesmo se não vestisse nada..."

# game/scripts/c23/c23.rpy:1541
translate brazilian c23s004_Kia_d5096617:

    # mc "Eso ha sonado mejor en mi cabeza..."
    mc "Isso soava melhor na minha cabeça..."

# game/scripts/c23/c23.rpy:1543
translate brazilian c23s004_Kia_f6aedbdd:

    # kia "Bueno, espero, si no impresionarte, al menos no decepcionarte cuando no lleve nada."
    kia "Bem, espero, se não impressioná-lo, pelo menos não decepcioná-lo quando eu não estiver usando nada."

# game/scripts/c23/c23.rpy:1544
translate brazilian c23s004_Kia_2321c125:

    # mc "No me podrías decepcionar nunca, [kia]. Estoy deseando poder demostrártelo."
    mc "Você nunca poderia me decepcionar, [kia]. Mal posso esperar para provar isso a você."

# game/scripts/c23/c23.rpy:1546
translate brazilian c23s004_Kia_d6ca2621:

    # kia "Si no fuera porque mañana tienes que levantarte temprano... Tenemos una cena pendiente."
    kia "Se não fosse pelo fato de você ter que acordar cedo amanhã... Temos um jantar marcado."

# game/scripts/c23/c23.rpy:1547
translate brazilian c23s004_Kia_a377bd3d:

    # kia "¿Cuándo vuelves? ¿El viernes?"
    kia "Quando você volta? Na sexta-feira?"

# game/scripts/c23/c23.rpy:1548
translate brazilian c23s004_Kia_1da55bc6:

    # mc "Sí, el viernes por la tarde espero estar de vuelta."
    mc "Sim, espero estar de volta na sexta-feira à tarde."

# game/scripts/c23/c23.rpy:1550
translate brazilian c23s004_Kia_94beec8a:

    # kia "¿Te apetece que vayamos a cenar? Si no estás muy cansado cuando vuelvas, claro."
    kia "Você gostaria de sair para jantar? Se você não estiver muito cansado quando voltar, é claro."

# game/scripts/c23/c23.rpy:1551
translate brazilian c23s004_Kia_8d395c57:

    # mc "Apúntalo en la agenda. *Risa* Son poco más de dos horas conduciendo, no voy a estar cansado."
    mc "Anote na sua agenda. *Risos* São pouco mais de duas horas de viagem, não vou ficar cansada."

# game/scripts/c23/c23.rpy:1553
translate brazilian c23s004_Kia_acfffe06:

    # kia "Entonces el viernes. Me apetece mucho tener nuestra tercera cita."
    kia "Então, na sexta-feira. Estou realmente ansiosa pelo nosso terceiro encontro."

# game/scripts/c23/c23.rpy:1554
translate brazilian c23s004_Kia_5daa83ad:

    # mc "A mí también. Me encanta pasar tiempo contigo."
    mc "Eu também. Adoro passar tempo com você."

# game/scripts/c23/c23.rpy:1556
translate brazilian c23s004_Kia_6dc9d2f6:

    # kia "Eres tan dulce... Pero debería bajar antes de que llegue [oma]."
    kia "Você é tão doce... Mas eu deveria descer antes que [oma] chegue."

# game/scripts/c23/c23.rpy:1560
translate brazilian c23s004_Kia_dd9d5367:

    # kia "Debería bajar por si [oma] llega pronto."
    kia "Devo descer caso [oma] chegue em breve."

# game/scripts/c23/c23.rpy:1561
translate brazilian c23s004_Kia_615ebbcf:

    # mc "Vamos. Te acompaño. No he visto a [oma] desde la fiesta de la piscina."
    mc "Vamos lá. Eu vou com você. Não vejo [oma] desde a festa na piscina."

# game/scripts/c23/c23.rpy:1563
translate brazilian c23s004_Kia_590abfbf:

    # mc "Por cierto, sólo te había visto con las gafas en el restaurante."
    mc "Aliás, eu só te vi de óculos no restaurante."

# game/scripts/c23/c23.rpy:1565
translate brazilian c23s004_Kia_bcd2c2af:

    # mc "Por cierto, hacía mucho tiempo que no te veía con gafas."
    mc "Aliás, já faz muito tempo que não te vejo usando óculos."

# game/scripts/c23/c23.rpy:1567
translate brazilian c23s004_Kia_0f258b53:

    # kia "Me las pongo para leer y trabajar. Estas son las de reserva y no tienen funda, con lo que no las quiero llevar sueltas en el bolso para evitar rayarlas."
    kia "Uso-os para ler e trabalhar. Estes são os meus óculos de reserva e não têm estojo, por isso não quero carregá-los soltos na minha mala para evitar arranhá-los."

# game/scripts/c23/c23.rpy:1568
translate brazilian c23s004_Kia_fe9e1f12:

    # kia "No sé dónde he dejado las otras gafas. A lo mejor las dejé en la biblioteca."
    kia "Não sei onde deixei meus outros óculos. Talvez os tenha deixado na biblioteca."

# game/scripts/c23/c23.rpy:1569
translate brazilian c23s004_Kia_7992e3ae:

    # mc "Si quieres le puedo pedir una funda a [mar] o a [kim]. Seguro que tienen de sobras."
    mc "Se quiser, posso pedir um caso para [mar] ou [kim]. Tenho certeza de que eles têm muitos."

# game/scripts/c23/c23.rpy:1571
translate brazilian c23s004_Kia_7557bf5a:

    # kia "No hace falta, son progresivas, puedo ver bien con ellas en cualquier circunstancia. Ya encontraré la funda."
    kia "Não precisa, são lentes progressivas, enxergo bem com elas em qualquer situação. Vou encontrar um estojo."

# game/scripts/c23/c23.rpy:1572
translate brazilian c23s004_Kia_e67890ae:

    # mc "Como quieras. Vamos entonces."
    mc "O que você quiser. Então vamos lá."

# game/scripts/c23/c23.rpy:1575
translate brazilian c23s004_Kia_8ef4ccaf:

    # mc "De todas formas, estás guapísima con ellas."
    mc "De qualquer forma, você fica deslumbrante com eles."

# game/scripts/c23/c23.rpy:1577
translate brazilian c23s004_Kia_5a3d2aba:

    # kia "Vamos antes de que te tenga que besar otra vez. *Risa*"
    kia "Vamos embora antes que eu tenha que te beijar de novo. *Risos*"

# game/scripts/c23/c23.rpy:1582
translate brazilian c23s004_EilKiss_d5eece30:

    # eil "Hasta luego, cielo."
    eil "Até logo, meu bem."

# game/scripts/c23/c23.rpy:1585
translate brazilian c23s004_EilKiss_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:1586
translate brazilian c23s004_EilKiss_c8213c6a:

    # eil "*A través de la puerta* Date prisa, Mamá. En menos de diez minutos estaré lista."
    eil "*Através da porta* Anda logo, mãe. Já estou pronta em menos de dez minutos."

# game/scripts/c23/c23.rpy:1600
translate brazilian c23s004_Oma_79acbd77:

    # "Cuando llegáis abajo, [oma] ya está esperando a [kia]."
    "Quando você chega ao fundo, [oma] já está esperando por [kia]."

# game/scripts/c23/c23.rpy:1603
translate brazilian c23s004_Oma_14a2700e:

    # oma "Hola, cielo."
    oma "Olá querido."

# game/scripts/c23/c23.rpy:1604
translate brazilian c23s004_Oma_86b43a6a:

    # mc "Hola, preciosa. ¿No trabajas hoy?"
    mc "Oi, linda. Você não está trabalhando hoje?"

# game/scripts/c23/c23.rpy:1607
translate brazilian c23s004_Oma_c63c3e9c:

    # oma "Hola, [kia] y [mc]."
    oma "Olá, [kia] e [mc]."

# game/scripts/c23/c23.rpy:1608
translate brazilian c23s004_Oma_45b32b95:

    # mc "Hola, [oma]. ¿No trabajas hoy?"
    mc "Olá, [oma]. Você não está trabalhando hoje?"

# game/scripts/c23/c23.rpy:1610
translate brazilian c23s004_Oma_025afa94:

    # oma "Acabo de salir. Llevo toda la semana cubriendo el primer turno. Schrute está enfermo y estoy en el mostrador de la comisaría."
    oma "Acabei de sair do trabalho. Estive cobrindo o primeiro turno a semana toda. O Schrute está doente e eu estou no balcão da delegacia."

# game/scripts/c23/c23.rpy:1611
translate brazilian c23s004_Oma_4e4ad102:

    # mc "Ufff. Yo odiaría tener que madrugar tanto."
    mc "Aff. Eu detestaria ter que acordar tão cedo."

# game/scripts/c23/c23.rpy:1613
translate brazilian c23s004_Oma_e6ca9f9a:

    # kia "*Risa* Todo el mundo sabe que te gusta dormir hasta tarde."
    kia "*Risos* Todo mundo sabe que você gosta de dormir até mais tarde."

# game/scripts/c23/c23.rpy:1614
translate brazilian c23s004_Oma_50206f78:

    # mc "¡Hey! ¡A primera hora de la mañana no tengo nada que hacer!"
    mc "Ei! Não tenho nada para fazer logo de manhã!"

# game/scripts/c23/c23.rpy:1616
translate brazilian c23s004_Oma_5dd58847:

    # oma "Podrías venir a correr conmigo, al menos cuando tengo turno normal."
    oma "Você poderia vir correr comigo, pelo menos quando eu estiver em um turno normal."

# game/scripts/c23/c23.rpy:1618
translate brazilian c23s004_Oma_15d6cb33:

    # kia "O hacer yoga con las chicas. Me han dicho que lo probaste una vez y no has vuelto."
    kia "Ou faça ioga com as amigas. Ouvi dizer que você experimentou uma vez e não voltou mais."

# game/scripts/c23/c23.rpy:1619
translate brazilian c23s004_Oma_1cfafede:

    # mc "*Risa* ¿Os dais cuenta de que lo único que proponéis es que haga más ejercicio?"
    mc "*Risos* Você percebe que tudo o que está sugerindo é que eu me exercite mais?"

# game/scripts/c23/c23.rpy:1620
translate brazilian c23s004_Oma_36ca33fd:

    # mc "*Risa* ¿Me estáis soltando indirectas de que me estoy engordando?"
    mc "*Risos* Vocês estão insinuando que eu estou engordando?"

# game/scripts/c23/c23.rpy:1623
translate brazilian c23s004_Oma_1640c236:

    # oma "No, sabemos que vas a correr al lago a menudo. *Risita* No necesitas más ejercicio."
    oma "Não, sabemos que você corre para o lago com frequência. *Risos* Você não precisa de mais exercícios."

# game/scripts/c23/c23.rpy:1625
translate brazilian c23s004_Oma_11b1b1a1:

    # oma "No, sabemos que vas a correr al lago a menudo. No necesitas más ejercicio."
    oma "Não, sabemos que você corre para o lago com frequência. Você não precisa de mais exercícios."

# game/scripts/c23/c23.rpy:1626
translate brazilian c23s004_Oma_7b373f76:

    # oma "Pero has dicho que no tienes nada que hacer por las mañanas. *Risa* Sólo te estamos dando opciones."
    oma "Mas você disse que não tem nada para fazer de manhã. *Risos* Estamos apenas lhe dando opções."

# game/scripts/c23/c23.rpy:1627
translate brazilian c23s004_Oma_5dedd215:

    # mc "Ya, pero lo del yoga... Ufff..."
    mc "Sim, mas ioga... Credo..."

# game/scripts/c23/c23.rpy:1629
translate brazilian c23s004_Oma_cd68c1c0:

    # kia "Yo quiero apuntarme algún día. Quizás el domingo. ¿Por qué no vienes, [oma]?"
    kia "Quero me inscrever qualquer dia desses. Talvez no domingo. Por que você não vem, [oma]?"

# game/scripts/c23/c23.rpy:1631
translate brazilian c23s004_Oma_ee8a7892:

    # oma "El domingo lo tengo libre. A lo mejor me apunto también. Solo lo he probado una vez, hace años, pero me gustó."
    oma "Estou livre no domingo. Talvez eu participe também. Só experimentei uma vez, há anos, mas gostei."

# game/scripts/c23/c23.rpy:1633
translate brazilian c23s004_Oma_d512827e:

    # eil "¿Qué pasa el domingo?"
    eil "O que acontece no domingo?"

# game/scripts/c23/c23.rpy:1635
translate brazilian c23s004_Oma_0fe0c027:

    # kia "Estábamos diciendo de apuntarnos a una sesión de yoga con las chicas."
    kia "Estávamos conversando sobre nos inscrevermos em uma aula de ioga com as meninas."

# game/scripts/c23/c23.rpy:1636
translate brazilian c23s004_Oma_e83a65fa:

    # kia "A ver si así convencemos a [mc] de que se apunte también."
    kia "Vamos ver se conseguimos convencer [mc] a se inscrever também."

# game/scripts/c23/c23.rpy:1638
translate brazilian c23s004_Oma_3a16bc45:

    # eil "¡Contad conmigo! Creo que estoy perdiendo algo de flexibilidad."
    eil "Contem comigo! Acho que estou perdendo um pouco da minha flexibilidade."

# game/scripts/c23/c23.rpy:1639
translate brazilian c23s004_Oma_c2d9c488:

    # mc "Sabéis que no me vais a convencer, ¿verdad?"
    mc "Você sabe que não vai me convencer, né?"

# game/scripts/c23/c23.rpy:1641
translate brazilian c23s004_Oma_d0553f4e:

    # oma "No estés tan seguro. Con todas las chicas haciéndote bullying para que te apuntes, dudo que puedas resistirte."
    oma "Não tenha tanta certeza. Com todas essas garotas pressionando você para se inscrever, duvido que você consiga resistir."

# game/scripts/c23/c23.rpy:1642
translate brazilian c23s004_Oma_483a9cb6:

    # mc "Ya veremos, pero no estéis tan seguras."
    mc "Veremos, mas não tenha tanta certeza."

# game/scripts/c23/c23.rpy:1647
translate brazilian c23s004_Oma_e5c65855:

    # oma "Bueno, ya veremos. Me llevo a estas dos chicas antes de que se haga más tarde. Espero verte el domingo con mallas."
    oma "Bem, veremos. Vou levar essas duas meninas antes que fique muito tarde. Espero te ver de collant no domingo."

# game/scripts/c23/c23.rpy:1648
translate brazilian c23s004_Oma_6546857c:

    # mc "No me vuelvo a poner las mallas de Tío Mike en mi vida. *Risa*"
    mc "Nunca mais vou usar as meias-calças do tio Mike na minha vida. *Risos*"

# game/scripts/c23/c23.rpy:1653
translate brazilian c23s004_Oma_06f8ca53:

    # kia "*Risa* Nos hablaron de lo anticuadas que se veían."
    kia "*Risos* Eles nos disseram o quão antiquados pareciam."

# game/scripts/c23/c23.rpy:1654
translate brazilian c23s004_Oma_9ca7d97f:

    # mc "*Risa* Deben tener 20 años por lo menos."
    mc "*Risos* Eles devem ter pelo menos 20 anos de idade."

# game/scripts/c23/c23.rpy:1659
translate brazilian c23s004_Oma_38329130:

    # eil "Le preguntaremos a [mad.nick] si tiene unas más modernas para regalártelas. Así no podrás negarte. *Risa* No vas a despreciar nuestro regalo."
    eil "Vamos perguntar à [mad.nick] se ela tem algum modelo mais novo para te dar. Assim você não poderá recusar. *Risos* Você não vai recusar nosso presente."

# game/scripts/c23/c23.rpy:1660
translate brazilian c23s004_Oma_85eddbf0:

    # mc "*Risa* Sois malvadas..."
    mc "*Risos* Você é malvado..."

# game/scripts/c23/c23.rpy:1661
translate brazilian c23s004_Oma_df14b767:

    # mc "Iros antes de que me convenzáis de irme a Aruba antes de que llegue el domingo."
    mc "Vá embora antes que você me convença a ir para Aruba antes de domingo."

# game/scripts/c23/c23.rpy:1663
translate brazilian c23s004_Oma_d6430870:

    # todas "Hasta luego, [mc]."
    todas "Até logo, [mc]."

# game/scripts/c23/c23.rpy:1665
translate brazilian c23s004_Oma_ddf0c1b3:

    # oma "Por cierto, os tengo que contar algo que pasó el lunes."
    oma "Aliás, preciso te contar uma coisa que aconteceu na segunda-feira."

# game/scripts/c23/c23.rpy:1667
translate brazilian c23s004_Oma_b6374b4b:

    # oma "Ahora os lo explico en el coche."
    oma "Eu explico para você no carro."

# game/scripts/c23/c23.rpy:1671
translate brazilian c23s004_Kim_2754a701:

    # "Pasas un rato después de comer leyendo los expedientes que [ama] y [jam] te han enviado sobre Iron Fist."
    "Você passa algum tempo depois do almoço lendo os arquivos que [ama] e [jam] lhe enviaram sobre Punho de Ferro."

# game/scripts/c23/c23.rpy:1673
translate brazilian c23s004_Kim_1ab19608:

    # "Bajas a media tarde a la cocina a por un vaso de agua. Tienes que comprarte una nevera para tu habitación."
    "Você desce até a cozinha no meio da tarde para pegar um copo d'água. Você precisa comprar uma geladeira para o seu quarto."

# game/scripts/c23/c23.rpy:1674
translate brazilian c23s004_Kim_91d604d7:

    # "[oma] y [kia] no contaban con la cantidad de escaleras que subes y bajas al cabo del día cuando hablaban del ejercicio que haces."
    "[oma] e [kia] não levaram em consideração o número de escadas que você sobe e desce durante o dia quando falaram sobre o exercício que você faz."

# game/scripts/c23/c23.rpy:1680
translate brazilian c23s004_Kim_3bce768b:

    # "Al pasar por la planta de las estudiantes te encuentras con [kim], que baja de tu planta."
    "Ao passar pelo andar dos estudantes, você encontra [kim], que está descendo do seu andar."

# game/scripts/c23/c23.rpy:1682
translate brazilian c23s004_Kim_d4f784dc:

    # kim "Hola, [mc]. He pasado a verte por tu habitación."
    kim "Olá, [mc]. Vim te ver no seu quarto."

# game/scripts/c23/c23.rpy:1683
translate brazilian c23s004_Kim_8b63b330:

    # mc "¡Wow! ¿Dónde vas así vestida? Pareces una cazavampiros."
    mc "Nossa! Aonde você vai vestida assim? Parece uma caçadora de vampiros."

# game/scripts/c23/c23.rpy:1685
translate brazilian c23s004_Kim_742bca56:

    # kim "¿Te has olvidado?"
    kim "Você se esqueceu?"

# game/scripts/c23/c23.rpy:1695
translate brazilian c23s004_Kim_81b0bcd4:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Mas eu não sabia que você tinha que se vestir assim. Você me disse que era um trabalho de comissária de bordo e que você poderia se passar por uma espiã como [eva] e [ama]."

# game/scripts/c23/c23.rpy:1697
translate brazilian c23s004_Kim_8475a636:

    # kim "¡Sabía que no te olvidarías!"
    kim "Eu sabia que você não ia esquecer!"

# game/scripts/c23/c23.rpy:1700
translate brazilian c23s004_Kim_b94cca21:

    # mc "¿Tenía que hacer algo? No soy capaz de acordarme."
    mc "Eu tinha que fazer alguma coisa? Não me lembro."

# game/scripts/c23/c23.rpy:1702
translate brazilian c23s004_Kim_7883c373:

    # kim "Te pedí que me llevaras al puerto para el trabajo que tengo esta tarde..."
    kim "Eu pedi que você me levasse ao porto para o trabalho que tenho esta tarde..."

# game/scripts/c23/c23.rpy:1703
translate brazilian c23s004_Kim_39884136:

    # mc "¡Es verdad! ¡No me acordaba!"
    mc "É verdade! Eu tinha esquecido!"

# game/scripts/c23/c23.rpy:1704
translate brazilian c23s004_Kim_81b0bcd4_1:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Mas eu não sabia que você tinha que se vestir assim. Você me disse que era um trabalho de comissária de bordo e que você poderia se passar por uma espiã como [eva] e [ama]."

# game/scripts/c23/c23.rpy:1707
translate brazilian c23s004_Kim_3898579d:

    # kim "Me han enviado el uniforme con una nota de que tengo que llegar vestida."
    kim "Eles me enviaram o uniforme com um bilhete dizendo que eu deveria chegar vestido para a ocasião."

# game/scripts/c23/c23.rpy:1708
translate brazilian c23s004_Kim_afd55317:

    # kim "Por lo visto no hay espacio suficiente para cambiarse en el evento."
    kim "Aparentemente não há espaço suficiente para se trocar no evento."

# game/scripts/c23/c23.rpy:1709
translate brazilian c23s004_Kim_1e4949d6:

    # mc "Ah, OK. ¿Cuándo quieres que vayamos?"
    mc "Ah, certo. Quando você quer que a gente vá?"

# game/scripts/c23/c23.rpy:1711
translate brazilian c23s004_Kim_3833d28d:

    # kim "Debería estar allí en una hora, pero, si te va bien, me gustaría salir antes. No me gusta llegar con el tiempo justo a los sitios."
    kim "Devo chegar em uma hora, mas se não for problema para você, gostaria de sair mais cedo. Não gosto de chegar em cima da hora."

# game/scripts/c23/c23.rpy:1712
translate brazilian c23s004_Kim_ce457f98:

    # mc "*Risa* Ningún problema. Pero deberías dar clases de puntualidad al resto de las chicas. Lo de llegar con tiempo no se les suele dar bien."
    mc "*Risos* Sem problema. Mas você deveria dar aulas de pontualidade para as outras meninas. Chegar na hora geralmente não é o forte delas."

# game/scripts/c23/c23.rpy:1713
translate brazilian c23s004_Kim_f18b0b21:

    # mc "Déjame coger las llaves y la cartera, y nos podemos ir."
    mc "Deixe-me pegar as chaves e a carteira, e já podemos ir."

# game/scripts/c23/c23.rpy:1715
translate brazilian c23s004_Kim_473af28b:

    # "Unos minutos después, en el coche..."
    "Poucos minutos depois, no carro..."

# game/scripts/c23/c23.rpy:1716
translate brazilian c23s004_Kim_22885cfa:

    # mc "Ese evento, ¿es algo de ciencia ficción o de espías? Podrías salir en una peli de ciencia ficción con ese atuendo."
    mc "Esse evento parece algo saído de um filme de ficção científica ou de um filme de espionagem? Você poderia estar em um filme de ficção científica usando essa roupa."

# game/scripts/c23/c23.rpy:1717
translate brazilian c23s004_Kim_64bf16da:

    # kim "No tengo ni idea. No me ha contratado el cliente final, sino la agencia de la que te hablé."
    kim "Não faço ideia. Não fui contratado pelo cliente final, mas sim pela agência que mencionei."

# game/scripts/c23/c23.rpy:1718
translate brazilian c23s004_Kim_c94679bc:

    # mc "Pero ¿no deberías saber qué tienes que hacer?"
    mc "Mas você não deveria saber o que precisa fazer?"

# game/scripts/c23/c23.rpy:1720
translate brazilian c23s004_Kim_00dde143:

    # kim "Bueno, es un trabajo de azafata. Recibir a los asistentes al evento, estar por allí en caso de que alguien necesite ayuda."
    kim "Bem, é um trabalho de anfitriã. Receber os participantes do evento e estar por perto caso alguém precise de ajuda."

# game/scripts/c23/c23.rpy:1721
translate brazilian c23s004_Kim_f172c3df:

    # kim "En algunos de esos eventos, incluso nos toca pasear con bandejas de comida. Odio esa parte."
    kim "Em alguns desses eventos, temos até que andar por aí carregando bandejas de comida. Detesto essa parte."

# game/scripts/c23/c23.rpy:1722
translate brazilian c23s004_Kim_27cd09c9:

    # mc "¿Por qué? Tiene que ser más divertido que quedarse en la puerta esperando que lleguen asistentes con retraso."
    mc "Por quê? Deve ser muito mais divertido do que ficar parado na porta esperando os atrasados chegarem."

# game/scripts/c23/c23.rpy:1724
translate brazilian c23s004_Kim_041f33bd:

    # kim "*Risa* ¿No me conoces aún? Aeropuerto, bosque... Tengo cierta tendencia a tropezar."
    kim "*Risos* Você ainda não me conhece? Aeroporto, floresta... Eu tenho tendência a tropeçar."

# game/scripts/c23/c23.rpy:1725
translate brazilian c23s004_Kim_34ecb851:

    # kim "Imagina esos tropiezos con una bandeja llena de canapés. *Risa* Canapés voladores..."
    kim "Imagine tropeçar numa bandeja cheia de canapés. *Risos* Canapés voadores..."

# game/scripts/c23/c23.rpy:1726
translate brazilian c23s004_Kim_2974ddbd:

    # mc "Y el CEO de una compañía acaba con caviar en la corbata."
    mc "E o CEO de uma empresa acaba com caviar na gravata."

# game/scripts/c23/c23.rpy:1728
translate brazilian c23s004_Kim_97a08e5a:

    # kim "Más o menos. *Risa* O Dwayne Johnston con un canapé de salmón y dos de queso en la calva."
    kim "Mais ou menos. *Risos* Ou Dwayne Johnston com um canapé de salmão e dois de queijo na cabeça careca."

# game/scripts/c23/c23.rpy:1729
translate brazilian c23s004_Kim_578f7d1d:

    # mc "*Risa* ¿Te pasó eso?"
    mc "*Risos* Isso já aconteceu com você?"

# game/scripts/c23/c23.rpy:1731
translate brazilian c23s004_Kim_03094166:

    # kim "*Risa* Sí. No sabía dónde meterme. Era el primer evento que hacía con gente famosa."
    kim "*Risos* Sim. Eu não sabia onde me esconder. Foi o primeiro evento que participei com pessoas famosas."

# game/scripts/c23/c23.rpy:1732
translate brazilian c23s004_Kim_655c0f4d:

    # mc "¿Qué pasó?"
    mc "O que aconteceu?"

# game/scripts/c23/c23.rpy:1734
translate brazilian c23s004_Kim_8ece0b8c:

    # kim "El Sr. Johnston fue muy amable... después de lanzarme una mirada asesina. Me ayudó a levantarme y me preguntó si me había hecho daño."
    kim "O Sr. Johnston foi muito gentil... depois de me lançar um olhar mortal. Ele me ajudou a levantar e perguntou se eu estava machucado."

# game/scripts/c23/c23.rpy:1735
translate brazilian c23s004_Kim_fd2a107a:

    # kim "Después se rio mucho cuando me ruboricé mientras le pedía disculpas. Por suerte solo le manché la cabeza y no el traje."
    kim "Ele riu muito quando eu corei enquanto pedia desculpas. Por sorte, só atingi a cabeça dele e não o terno."

# game/scripts/c23/c23.rpy:1736
translate brazilian c23s004_Kim_3d98e978:

    # mc "Con un tipo tan enorme mirándome con ganas de asesinarme, seguramente me hubiera escondido debajo de una mesa. *Risa*"
    mc "Com um cara daquele tamanho me encarando como se quisesse me matar, eu provavelmente teria me escondido debaixo de uma mesa. *Risos*"

# game/scripts/c23/c23.rpy:1738
translate brazilian c23s004_Kim_9a184fb3:

    # kim "*Risa* Te aseguro que es lo primero que se me pasó por la cabeza. Hacer como el actor ese pequeñito que hace pelis con él y salir de allí gateando."
    kim "*Risos* Garanto que foi a primeira coisa que me veio à cabeça. Fazer como aquele atorzinho que faz filmes com isso e sair rastejando dali."

# game/scripts/c23/c23.rpy:1739
translate brazilian c23s004_Kim_f81bda84:

    # mc "¿Kevin Heart?"
    mc "Kevin Heart?"

# game/scripts/c23/c23.rpy:1740
translate brazilian c23s004_Kim_3a463a4e:

    # kim "Sí, ese. ¡Me encanta ese tío! ¡Es super gracioso!"
    kim "Sim, esse mesmo. Eu adoro esse cara! Ele é hilário!"

# game/scripts/c23/c23.rpy:1741
translate brazilian c23s004_Kim_8c1dc6b4:

    # mc "Y sobre el evento, ¿conoces a alguna de las otra chicas? Si os ha contratado la misma agencia..."
    mc "E sobre o evento, você conhece alguma das outras garotas? Se você foi contratada pela mesma agência..."

# game/scripts/c23/c23.rpy:1743
translate brazilian c23s004_Kim_aef6db14:

    # kim "A una de ellas, Adeline. Hemos coincidido en la agencia, pero no he trabajado nunca con ella. Va a ser la jefa esta noche."
    kim "Uma delas é a Adeline. Nos conhecemos na agência, mas nunca trabalhei com ela. Ela vai ser a chefe hoje à noite."

# game/scripts/c23/c23.rpy:1744
translate brazilian c23s004_Kim_8dd56270:

    # mc "Bueno, al menos tendrás una cara conocida. Supongo que siempre es bueno."
    mc "Bom, pelo menos você terá um rosto familiar. Acho que isso é sempre bom."

# game/scripts/c23/c23.rpy:1746
translate brazilian c23s004_Kim_4ae755b4:

    # kim "Depende a quién pertenezca esa cara. *Risa* En este mundillo hay muchas perras."
    kim "Depende de quem é o rosto. *Risos* Tem muita gente maldosa nesse ramo."

# game/scripts/c23/c23.rpy:1747
translate brazilian c23s004_Kim_ba1a071a:

    # kim "Y en el mundo de las modelos es peor todavía."
    kim "E no mundo das modelos é ainda pior."

# game/scripts/c23/c23.rpy:1748
translate brazilian c23s004_Kim_4ca7ba1b:

    # mc "Me tienes que contar cómo empezaste en lo de trabajar de modelo."
    mc "Você precisa me contar como começou na carreira de modelo."

# game/scripts/c23/c23.rpy:1750
translate brazilian c23s004_Kim_ffce8934:

    # kim "Todo empezó cuando Winnie Carlow saltó a la fama. Los cazatalentos empezaron a visitar escuelas y..."
    kim "Tudo começou quando Winnie Carlow alcançou a fama. Olheiros começaram a visitar escolas e..."

# game/scripts/c23/c23.rpy:1752
translate brazilian c23s004_Kim_beddfb92:

    # "[kim] te explica todo lo que tuvo que aprender en las escuelas de modelos, sus primeros trabajos, sus primeros éxitos y fracasos..."
    "[kim] explica tudo o que ela teve que aprender em escolas de modelos, seus primeiros trabalhos, seus primeiros sucessos e fracassos..."

# game/scripts/c23/c23.rpy:1753
translate brazilian c23s004_Kim_ab5d1645:

    # "Se nota que adora su trabajo por la ilusión con la que habla de ello."
    "Dá para perceber que ela ama o trabalho pelo entusiasmo com que fala sobre ele."

# game/scripts/c23/c23.rpy:1754
translate brazilian c23s004_Kim_a076c416:

    # "La conversación es tan amena que casi no te das cuenta de que ya habéis llegado al puerto, donde hay otras chicas vestidas como [kim]."
    "A conversa é tão agradável que você mal percebe que já chegou ao porto, onde há outras garotas vestidas como [kim]."

# game/scripts/c23/c23.rpy:1756
translate brazilian c23s004_Kim_b0dea2ba:

    # mc "Pues ya hemos llegado. ¿Quieres que te acompañe?"
    mc "Chegamos. Gostaria que eu a acompanhasse?"

# game/scripts/c23/c23.rpy:1757
translate brazilian c23s004_Kim_7d98cdb5:

    # kim "Gracias, pero no hace falta."
    kim "Obrigado, mas não é necessário."

# game/scripts/c23/c23.rpy:1759
translate brazilian c23s004_Kim_d4ea101b:

    # kim "Aquella rubia es Adeline. De la que te he hablado antes. Mi jefa por esta noche."
    kim "Aquela loira é a Adeline. Aquela de quem te falei antes. Minha chefe esta noite."

# game/scripts/c23/c23.rpy:1760
translate brazilian c23s004_Kim_68afdd7b:

    # kim "Iré a presentarme al resto de chicas, y si me acompañas sería como mostrar inseguridad."
    kim "Vou me apresentar às outras garotas, e se você vier comigo, será como demonstrar insegurança."

# game/scripts/c23/c23.rpy:1761
translate brazilian c23s004_Kim_1a6ba295:

    # mc "Como desees. ¿Los dos tipos que parecen guardaespaldas también pertenecen al evento?"
    mc "Como desejar. Os dois rapazes que parecem seguranças também deveriam estar no evento?"

# game/scripts/c23/c23.rpy:1763
translate brazilian c23s004_Kim_bbeda5a9:

    # kim "No lo sé. Por lo que sé, somos cinco azafatas y otras dos chicas para otros servicios. No me han dicho nada de chicos."
    kim "Não sei. Pelo que sei, somos cinco comissárias de bordo e duas outras moças que trabalham em outros serviços. Não mencionaram nada sobre rapazes."

# game/scripts/c23/c23.rpy:1764
translate brazilian c23s004_Kim_81f6d6f7:

    # kim "A lo mejor son los porteros y los han contratado en otra agencia. No tengo ni idea."
    kim "Talvez sejam os goleiros e tenham sido contratados por meio de outra agência. Não faço ideia."

# game/scripts/c23/c23.rpy:1765
translate brazilian c23s004_Kim_7cd995a2:

    # mc "Pues eres la cuarta en llegar. Falta una cazavampiros y las dos chicas de los otros... servicios."
    mc "Bem, você é o quarto a chegar. Ainda estamos esperando um caçador de vampiros e as duas garotas dos outros... serviços."

# game/scripts/c23/c23.rpy:1767
translate brazilian c23s004_Kim_051f4639:

    # kim "*Risa* Has dicho lo de servicios como si te sonara sospechoso."
    kim "*Risos* Você disse \"serviços\" como se soasse suspeito para você."

# game/scripts/c23/c23.rpy:1768
translate brazilian c23s004_Kim_1f1e79c0:

    # kim "Se suele llamar así a la gente del cátering, de la limpieza, etc."
    kim "Geralmente, é assim que são chamadas as pessoas que trabalham em serviços de alimentação, limpeza, etc."

# game/scripts/c23/c23.rpy:1769
translate brazilian c23s004_Kim_76125965:

    # mc "Ah, OK. Al decirlo así ha sonado... *Risa* sospechoso."
    mc "Ah, entendi. Dizer assim soou... *Risos* suspeito."

# game/scripts/c23/c23.rpy:1770
translate brazilian c23s004_Kim_73a9eea1:

    # mc "¿Quieres que te venga a buscar cuando acabes?"
    mc "Você quer que eu vá te buscar quando terminar?"

# game/scripts/c23/c23.rpy:1772
translate brazilian c23s004_Kim_c4904bff:

    # kim "No hace falta. Acabará tarde y no quiero molestarte."
    kim "Não precisa. Vai ficar tarde e não quero te incomodar."

# game/scripts/c23/c23.rpy:1773
translate brazilian c23s004_Kim_5ad080fa:

    # mc "No es molestia. ¿Cómo volverás a casa si nadie viene a buscarte?"
    mc "Não tem problema nenhum. Como você vai voltar para casa se ninguém vier te buscar?"

# game/scripts/c23/c23.rpy:1775
translate brazilian c23s004_Kim_f82ff79f:

    # kim "Pediré un Under o a lo mejor alguna de las chicas puede llevarme."
    kim "Vou pedir um Under ou talvez uma das meninas possa me levar."

# game/scripts/c23/c23.rpy:1776
translate brazilian c23s004_Kim_c31e85f0:

    # mc "Si tienes algún problema, no dudes en llamarme. Sea la hora que sea."
    mc "Se tiver algum problema, não hesite em me ligar. Não importa a hora."

# game/scripts/c23/c23.rpy:1778
translate brazilian c23s004_Kim_3225c954:

    # kim "Gracias de nuevo, [mc]. Pero no te preocupes. Si tengo algún problema, te llamaré."
    kim "Obrigado novamente, [mc]. Mas não se preocupe. Se eu tiver algum problema, eu ligo para você."

# game/scripts/c23/c23.rpy:1780
translate brazilian c23s004_Kim_81b83644:

    # kim "Ahora tengo que irme, antes de que llegue la última cazavampiros."
    kim "Agora preciso ir, antes que o último caçador de vampiros chegue."

# game/scripts/c23/c23.rpy:1781
translate brazilian c23s004_Kim_5d67085f:

    # mc "Suerte con el trabajo y, si te hacen pasear bandejas, que sean de canapés y no de copas de champán. *Risa*"
    mc "Boa sorte no trabalho, e se te pedirem para carregar bandejas, certifique-se de que sejam bandejas de canapés e não taças de champanhe. *Risos*"

# game/scripts/c23/c23.rpy:1783
translate brazilian c23s004_Kim_cb4717cc:

    # kim "Muy gracioso... *Risa*"
    kim "Muito engraçado... *Risos*"

# game/scripts/c23/c23.rpy:1784
translate brazilian c23s004_Kim_98cbe997:

    # kim "Te veo mañana en casa."
    kim "Te vejo em casa amanhã."

# game/scripts/c23/c23.rpy:1785
translate brazilian c23s004_Kim_1171553f:

    # mc "Hasta mañana, [kim]."
    mc "Até amanhã, [kim]."

# game/scripts/c23/c23.rpy:1790
translate brazilian c23s004_Kim_022da978:

    # "[kim] se aleja del coche con paso seguro, pasando de largo de los porteros y dirigiéndose a las cazavampiros."
    "[kim] se afasta do carro com passos firmes, passando pelos porteiros e caminhando em direção aos caçadores de vampiros."

# game/scripts/c23/c23.rpy:1791
translate brazilian c23s004_Kim_39b267af:

    # "Por primera vez, te la puedes imaginar caminando por una pasarela. Los porteros parecen tener otros pensamientos."
    "Pela primeira vez, você consegue imaginá-la desfilando em uma passarela. Os porteiros parecem ter outros planos."

# game/scripts/c23/c23.rpy:1795
translate brazilian c23s004_Kim_cd871e42:

    # "Vuelves a casa y cenas con las chicas. El tema de conversación se centra en el viaje de [bet] a Monterey."
    "Você vai para casa e janta com as meninas. A conversa gira em torno da viagem de [bet] para Monterey."

# game/scripts/c23/c23.rpy:1796
translate brazilian c23s004_Kim_bb870621:

    # "Que seas tú quien conduce o que [emm] vaya a cumplir su sueño de conducir un Ferrarini rosa casi no se comenta."
    "Quase não se comenta se é você quem está dirigindo ou se [emm] vai realizar seu sonho de dirigir uma Ferrari rosa."

# game/scripts/c23/c23.rpy:1797
translate brazilian c23s004_Kim_0bae2113:

    # "Todo el mundo está preocupado con lo que pueda pasar en la reunión de [bet]."
    "Todos estão preocupados com o que pode acontecer na reunião [bet]."

# game/scripts/c23/c23.rpy:1811
translate brazilian c23s005_MarVisit_d348568e:

    # "Después de cenar te das una ducha y bajas a la habitación de [mar]."
    "Após o jantar, você toma um banho e desce para o quarto [mar]."

# game/scripts/c23/c23.rpy:1815
translate brazilian c23s005_MarVisit_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c23/c23.rpy:1816
translate brazilian c23s005_MarVisit_70439077:

    # mc "Soy yo, ¿puedo entrar?"
    mc "Sou eu, posso entrar?"

# game/scripts/c23/c23.rpy:1817
translate brazilian c23s005_MarVisit_3e92d953:

    # mar "*A través de la puerta* Sí, entra."
    mar "*Pela porta* Sim, entre."

# game/scripts/c23/c23.rpy:1819
translate brazilian c23s005_MarVisit_564f71da:

    # mc "Quería preguntarte por la camisa azul. ¿La has encontrado?"
    mc "Queria te perguntar sobre a camisa azul. Você já a encontrou?"

# game/scripts/c23/c23.rpy:1820
translate brazilian c23s005_MarVisit_fd0098b2:

    # mom "Sí, la he metido en la maleta de [emm]. En una de las maletas."
    mom "Sim, eu coloquei na mala de [emm]. Em uma das malas."

# game/scripts/c23/c23.rpy:1821
translate brazilian c23s005_MarVisit_d2a50ced:

    # mc "*Risa* ¿Cuántas se lleva al final?"
    mc "*Risos* Quantas ela toma no final?"

# game/scripts/c23/c23.rpy:1822
translate brazilian c23s005_MarVisit_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Você se importa se eu me sentar?"

# game/scripts/c23/c23.rpy:1824
translate brazilian c23s005_MarVisit_731a1635:

    # mom "*Risa* Eso es algo que tendrás que descubrir mañana."
    mom "*Risos* Isso é algo que você terá que descobrir amanhã."

# game/scripts/c23/c23.rpy:1825
translate brazilian c23s005_MarVisit_d8845d26:

    # mc "Dame sólo una pista. Si fuéramos en tu coche en vez de con la pick up, ¿cabrían?"
    mc "Só me dê uma dica. Se fôssemos no seu carro em vez da caminhonete, eles caberiam?"

# game/scripts/c23/c23.rpy:1827
translate brazilian c23s005_MarVisit_70ce664e:

    # mom "No. *Risa* Seguramente deberíais dejar a Tía [bet] aquí."
    mom "Não. *Risos* É melhor você deixar a tia [bet] aqui."

# game/scripts/c23/c23.rpy:1828
translate brazilian c23s005_MarVisit_943171d1:

    # mc "Vale, me hago una idea."
    mc "Ok, entendi a ideia."

# game/scripts/c23/c23.rpy:1829
translate brazilian c23s005_MarVisit_9ad77aff:

    # mc "Por cierto, ¿qué estás leyendo? No sabía que te gustaban los cómics."
    mc "A propósito, o que você está lendo? Eu não sabia que você gostava de quadrinhos."

# game/scripts/c23/c23.rpy:1831
translate brazilian c23s005_MarVisit_852f836e:

    # mom "Creía que era una revista. Se llama Días de Dormitorio."
    mom "Pensei que fosse uma revista. Chama-se \"Dormitório dos Dias\"."

# game/scripts/c23/c23.rpy:1832
translate brazilian c23s005_MarVisit_c76428d1:

    # mom "Pero creo que es de [kat]."
    mom "Mas acho que é de [kat]."

# game/scripts/c23/c23.rpy:1834
translate brazilian c23s005_MarVisit_7af44f31:

    # mom "Un grupo de chicas en un dormitorio femenino. Ellas no tienen la suerte de tenerte a ti para ayudarlas, aunque tampoco parecen necesitarlo."
    mom "Um grupo de garotas em um dormitório feminino. Elas não têm a sorte de contar com a sua ajuda, embora também não pareçam precisar dela."

# game/scripts/c23/c23.rpy:1835
translate brazilian c23s005_MarVisit_195caa06:

    # mom "Y... ya sabes..."
    mom "E... você sabe..."

# game/scripts/c23/c23.rpy:1836
translate brazilian c23s005_MarVisit_044bf7d6:

    # mc "Vale, un cómic lésbico."
    mc "Ok, uma história em quadrinhos lésbica."

# game/scripts/c23/c23.rpy:1838
translate brazilian c23s005_MarVisit_c8aea4db:

    # mc "Quizás se lo pida para echarle un vistazo."
    mc "Talvez eu peça para ele dar uma olhada."

# game/scripts/c23/c23.rpy:1840
translate brazilian c23s005_MarVisit_1f11f99c:

    # mom "Aparte de hablar de mis gustos literarios... *Risa* ¿Querías algo más?"
    mom "Além de falar sobre meus gostos literários... *Risos* Você queria algo mais?"

# game/scripts/c23/c23.rpy:1841
translate brazilian c23s005_MarVisit_b3f442bd:

    # mc "No, sólo venía por lo de la camisa. No es que tenga intención de ponérmela, pero..."
    mc "Não, eu só vim por causa da camisa. Não é como se eu pretendesse usá-la, mas..."

# game/scripts/c23/c23.rpy:1844
translate brazilian c23s005_MarVisit_0e04b775:

    # mom "Pero hoy ya has perdido una camisa y no quieres perder más. *Risa*"
    mom "Mas você já perdeu uma camisa hoje e não quer perder mais nenhuma. *Risos*"

# game/scripts/c23/c23.rpy:1845
translate brazilian c23s005_MarVisit_0151713c:

    # mc "*Risa* Exacto."
    mc "*Risos* Exatamente."

# game/scripts/c23/c23.rpy:1846
translate brazilian c23s005_MarVisit_f67bb261:

    # mom "No te preocupes, está en la maleta de [emm]. En una de sus maletas."
    mom "Não se preocupe, está na mala do [emm]. Em uma das malas dele."

# game/scripts/c23/c23.rpy:1853
translate brazilian c23s005_NoMar_3ee1513b:

    # mc "Bueno, entonces me voy a dormir ya. Mañana nos levantamos temprano."
    mc "Certo, então vou dormir agora. Temos que acordar cedo amanhã."

# game/scripts/c23/c23.rpy:1854
translate brazilian c23s005_NoMar_3d6e8676:

    # mc "Te veo el viernes."
    mc "Te vejo na sexta-feira."

# game/scripts/c23/c23.rpy:1856
translate brazilian c23s005_NoMar_45dc9a44:

    # mom "No, me levantaré para haceros el desayuno antes de que salgáis."
    mom "Não, eu vou me levantar para preparar o café da manhã para você antes de você sair."

# game/scripts/c23/c23.rpy:1857
translate brazilian c23s005_NoMar_2c3b5aa8:

    # mc "No te tienes que preocupar por eso."
    mc "Você não precisa se preocupar com isso."

# game/scripts/c23/c23.rpy:1859
translate brazilian c23s005_NoMar_e70b3cce:

    # mom "He dicho que me levantaré y lo pienso hacer. No voy a dejar que conduzcas tres horas con el estómago vacío."
    mom "Eu disse que vou me levantar, e pretendo fazer isso. Não vou deixar você dirigir por três horas de estômago vazio."

# game/scripts/c23/c23.rpy:1860
translate brazilian c23s005_NoMar_e4aa384c:

    # mc "Sabes que soy capaz de prepararme un café y cortarme un trozo de tarta, ¿verdad?"
    mc "Você sabe que sou capaz de fazer um café para mim e cortar uma fatia de bolo, não é?"

# game/scripts/c23/c23.rpy:1861
translate brazilian c23s005_NoMar_ac66e14c:

    # mc "Pero bueno, no te voy a convencer de que no lo hagas. Te veo mañana."
    mc "Mas enfim, não vou tentar te convencer a não fazer isso. Até amanhã."

# game/scripts/c23/c23.rpy:1862
translate brazilian c23s005_NoMar_f617ec24:

    # mom "Hasta mañana."
    mom "Vejo você amanhã."

# game/scripts/c23/c23.rpy:1865
translate brazilian c23s005_NoMar_554a793f:

    # "Subes a tu habitación y duermes toda la noche sin soñar..."
    "Você sobe para o seu quarto e dorme a noite toda sem sonhar..."

# game/scripts/c23/c23.rpy:1866
translate brazilian c23s005_NoMar_b3f31ca1:

    # centered "{size=+20}{b}DÍA 24 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}DIA 24 – QUINTA-FEIRA{/b}{/size}"

# game/scripts/c23/c23.rpy:1869
translate brazilian c23s005_NoMar_ec286efa:

    # "... Hasta que la puerta se abre de golpe y alguien enciende la luz."
    "...Até que a porta se abra de repente e alguém acenda a luz."

# game/scripts/c23/c23.rpy:1870
translate brazilian c23s005_NoMar_35ad285c:

    # emm "¡Despierta! ¡Nos tenemos que ir!"
    emm "Acorde! Temos que ir!"

# game/scripts/c23/c23.rpy:1871
translate brazilian c23s005_NoMar_4102bb2b:

    # "OK. Ya estás despierto. Y sobresaltado."
    "Certo. Você acordou. E se assustou."

# game/scripts/c23/c23.rpy:1872
translate brazilian c23s005_NoMar_d525fe1d:

    # mc "¿Qué hora es, [emm]? No he oído el despertador."
    mc "Que horas são, [emm]? Não ouvi o despertador."

# game/scripts/c23/c23.rpy:1874
translate brazilian c23s005_NoMar_2060c21e:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a buscarte."
    emm "São 6h da manhã. Estou acordado há mais de uma hora, me segurando para não subir e te procurar."

# game/scripts/c23/c23.rpy:1875
translate brazilian c23s005_NoMar_e6da23ea:

    # emm "Pero si no te levantas ya, se va a hacer tarde."
    emm "Mas se você não se levantar agora, vai ficar tarde."

# game/scripts/c23/c23.rpy:1876
translate brazilian c23s005_NoMar_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], dissemos que sairíamos daqui às 8:00. Eu tinha programado meu alarme para 7:15."

# game/scripts/c23/c23.rpy:1878
translate brazilian c23s005_NoMar_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "E em 45 minutos você ia tomar banho..."

# game/scripts/c23/c23.rpy:1879
translate brazilian c23s005_NoMar_f4b84d41:

    # mc "Me duché anoche..."
    mc "Tomei um banho ontem à noite..."

# game/scripts/c23/c23.rpy:1880
translate brazilian c23s005_NoMar_d664759d:

    # emm "A vestirte..."
    emm "Vista-se..."

# game/scripts/c23/c23.rpy:1881
translate brazilian c23s005_NoMar_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Sou homem. Preciso de menos de cinco minutos. Cinco minutos de verdade..."

# game/scripts/c23/c23.rpy:1882
translate brazilian c23s005_NoMar_d6f2a180:

    # emm "Y a desayunar..."
    emm "E chegou a hora do café da manhã..."

# game/scripts/c23/c23.rpy:1883
translate brazilian c23s005_NoMar_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Foi para isso que serviram 30 dos 45 minutos. *Risos*"

# game/scripts/c23/c23.rpy:1884
translate brazilian c23s005_NoMar_d48c1dce:

    # mc "Puedes ir preparando el café, si quieres ir avanzando. Mamá dijo que se levantaría para hacer el desayuno."
    mc "Você pode começar a fazer o café se quiser adiantar o processo. Mamãe disse que ia se levantar para preparar o café da manhã."

# game/scripts/c23/c23.rpy:1886
translate brazilian c23s005_NoMar_ea722677:

    # emm "Mamá ya está en la cocina horneando algo. El olor es lo que me ha convencido de que ya era hora de despertarte."
    emm "Mamãe já está na cozinha preparando alguma coisa. O cheiro foi o que me convenceu de que era hora de te acordar."

# game/scripts/c23/c23.rpy:1887
translate brazilian c23s005_NoMar_37ec136f:

    # mc "Vale... ¿Tía [bet] ya está despierta?"
    mc "Ok... A tia [bet] já acordou?"

# game/scripts/c23/c23.rpy:1889
translate brazilian c23s005_NoMar_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Não sei! Ainda não fui vê-la!"

# game/scripts/c23/c23.rpy:1890
translate brazilian c23s005_NoMar_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "O que você está esperando? Ela é uma mulher e vai demorar mais para se vestir do que eu."

# game/scripts/c23/c23.rpy:1891
translate brazilian c23s005_NoMar_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Você tem razão! Estou indo embora!"

# game/scripts/c23/c23.rpy:1894
translate brazilian c23s005_NoMar_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:1895
translate brazilian c23s005_NoMar_6713e858:

    # emm "*A través de la puerta* Todo lo tengo que hacer yo en esta casa..."
    emm "*Pela porta* Tenho que fazer tudo nesta casa..."

# game/scripts/c23/c23.rpy:1897
translate brazilian c23s005_NoMar_efe2aa2c:

    # mcp "(Y se fue. Bajaré a la cocina a ayudar a [mar] a preparar el desayuno.)"
    mcp "(E ela saiu. Vou descer para a cozinha para ajudar a preparar o café da manhã.)"

# game/scripts/c23/c23.rpy:1901
translate brazilian c23s005_Mar_82ff8c0e:

    # mom "¿Quieres quedarte a dormir?"
    mom "Você quer passar a noite aqui?"

# game/scripts/c23/c23.rpy:1902
translate brazilian c23s005_Mar_ec063b6b:

    # mc "*Risa* Creía que no me lo ibas a pedir."
    mc "*Risos* Pensei que você não fosse me perguntar."

# game/scripts/c23/c23.rpy:1904
translate brazilian c23s005_Mar_e4a23ead:

    # mom "¿De verdad lo creías? Venir a preguntar por la camisa, cuando no tienes interés en ella, es la peor excusa que se te podía haber ocurrido."
    mom "Você realmente acreditou nisso? Vir aqui perguntar sobre a camisa quando você não tem interesse nela é a pior desculpa que você poderia ter inventado."

# game/scripts/c23/c23.rpy:1905
translate brazilian c23s005_Mar_0374b3a7:

    # mom "Y saber que vas a estar dos días fuera cuando apenas acabas de volver de la universidad..."
    mom "E saber que você vai ficar fora por dois dias logo depois de ter voltado da universidade..."

# game/scripts/c23/c23.rpy:1906
translate brazilian c23s005_Mar_2125c473:

    # mc "Hace más de tres semanas que volví. Y no son dos días. Sólo es una noche."
    mc "Já faz mais de três semanas que voltei. E não foram dois dias. Foi apenas uma noite."

# game/scripts/c23/c23.rpy:1908
translate brazilian c23s005_Mar_9c8bbee0:

    # mom "Bueno, lo que sea. A una madre no le gusta perder de vista a sus polluelos aunque sea sólo por una noche."
    mom "Bom, tanto faz. Uma mãe não gosta de perder seus filhotes de vista, mesmo que seja só por uma noite."

# game/scripts/c23/c23.rpy:1909
translate brazilian c23s005_Mar_8bfb55eb:

    # mc "*Risa* Y estoy seguro de que me dirás que conduzca con cuidado y que no corra por la autopista."
    mc "*Risos* E tenho certeza que você vai me dizer para dirigir com cuidado e não exceder a velocidade na estrada."

# game/scripts/c23/c23.rpy:1911
translate brazilian c23s005_Mar_65ccc2dd:

    # mom "¡Por supuesto! *Risa* ¡Y me levantaré temprano para prepararos el desayuno!"
    mom "Claro! *Risos* E vou acordar cedo para preparar o seu café da manhã!"

# game/scripts/c23/c23.rpy:1912
translate brazilian c23s005_Mar_bdcf4cd9:

    # mc "No hace falta, sé preparar café y coger un trozo de tarta."
    mc "Não precisa, eu sei fazer café e comer uma fatia de bolo."

# game/scripts/c23/c23.rpy:1914
translate brazilian c23s005_Mar_86e6ca78:

    # mom "Me da lo mismo. Mis dos niños se van a pasar la noche fuera y no pienso dejar que os vayáis con el estómago vacío."
    mom "Não me importo. Meus dois filhos vão sair hoje à noite, e não vou deixar você sair de estômago vazio."

# game/scripts/c23/c23.rpy:1915
translate brazilian c23s005_Mar_281c7abb:

    # mc "Lo haces para sentirte mejor, ¿no?"
    mc "Você faz isso para se sentir melhor, não é?"

# game/scripts/c23/c23.rpy:1917
translate brazilian c23s005_Mar_e77b74f5:

    # mom "Entre otras cosas..."
    mom "Entre outras coisas..."

# game/scripts/c23/c23.rpy:1918
translate brazilian c23s005_Mar_d961e82b:

    # mc "Entonces estaré encantado de que nos prepares el desayuno."
    mc "Então, ficaria muito feliz se você preparasse o café da manhã para nós."

# game/scripts/c23/c23.rpy:1920
translate brazilian c23s005_Mar_81e58346:

    # mom "¿Por qué no te pones cómodo mientras yo guardo el cómic?"
    mom "Por que você não se acomoda enquanto eu guardo a revista em quadrinhos?"

# game/scripts/c23/c23.rpy:1921
translate brazilian c23s005_Mar_bc03d346:

    # mc "¿Guardarlo? ¿Por qué no lo dejas en la mesilla de noche?"
    mc "Guardar? Por que não deixar na mesa de cabeceira?"

# game/scripts/c23/c23.rpy:1923
translate brazilian c23s005_Mar_f95c1578:

    # mom "Estoy casi segura de que [emm] vendrá aquí si se despierta antes que yo, y no quiero que tenga ninguna idea rara."
    mom "Tenho quase certeza de que [emm] virá para cá se acordar antes de mim, e não quero que ele tenha ideias estranhas."

# game/scripts/c23/c23.rpy:1925
translate brazilian c23s005_Mar_83323914:

    # mom "Últimamente la he visto queriendo probar cosas nuevas..."
    mom "Ultimamente, tenho notado que ela quer experimentar coisas novas..."

# game/scripts/c23/c23.rpy:1926
translate brazilian c23s005_Mar_d2d9d612:

    # mc "Si me encuentra durmiendo aquí, en lo que menos se va a fijar será en un cómic lésbico encima de tu mesilla."
    mc "Se ele me encontrar dormindo aqui, a última coisa que ele vai notar é uma história em quadrinhos lésbica na sua mesa de cabeceira."

# game/scripts/c23/c23.rpy:1927
translate brazilian c23s005_Mar_09f08358:

    # mc "Además, con lo excitada que estará, no creo que se fije ni siquiera en si estoy yo. *Risa*"
    mc "Além disso, com a empolgação dela, acho que ela nem vai notar se eu estiver lá. *Risos*"

# game/scripts/c23/c23.rpy:1929
translate brazilian c23s005_Mar_540fe0fa:

    # mom "Bueno, de todas formas voy a guardarlo. No voy a leer nada más esta noche..."
    mom "Bom, vou guardar mesmo assim. Não vou ler mais nada esta noite..."

# game/scripts/c23/c23.rpy:1930
translate brazilian c23s005_Mar_0ea7bcf6:

    # mom "Hay cosas que me apetecen más hacer que leer."
    mom "Existem coisas que eu prefiro fazer do que ler."

# game/scripts/c23/c23.rpy:1931
translate brazilian c23s005_Mar_f9788a14:

    # mc "Me parece una idea prometedora... Voy a hacerte caso y a ponerme cómodo."
    mc "Parece uma ideia promissora... Vou seguir seu conselho e me acomodar."

# game/scripts/c23/c23.rpy:1933
translate brazilian c23s005_Mar_c350f7d3:

    # mom "Yo también voy a ponerme cómoda."
    mom "Eu também vou me acomodar."

# game/scripts/c23/c23.rpy:1934
translate brazilian c23s005_Mar_41efa3af:

    # mc "Déjate puesto el collar, si no te importa. Me encanta cómo te queda."
    mc "Pode deixar o colar, se não se importar. Adoro como fica em você."

# game/scripts/c23/c23.rpy:1936
translate brazilian c23s005_Mar_2fd6017d:

    # mom "¿Sólo el collar?"
    mom "Apenas o colar?"

# game/scripts/c23/c23.rpy:1938
translate brazilian c23s005_Mar_55410cb7:

    # mc "Solo el collar."
    mc "Apenas a coleira."

# game/scripts/c23/c23.rpy:1941
translate brazilian c23s005_Mar_172f8095:

    # "Un par de minutos después..."
    "Alguns minutos depois..."

# game/scripts/c23/c23.rpy:1942
translate brazilian c23s005_Mar_1ecafe17:

    # mom "Aquí estamos... Solo con el collar..."
    mom "Aqui estamos... Só com a coleira..."

# game/scripts/c23/c23.rpy:1943
translate brazilian c23s005_Mar_e9a384b1:

    # mc "Es un collar precioso, pero me gusta mucho más el resto de ti."
    mc "É um colar lindo, mas eu gosto muito mais do resto de você."

# game/scripts/c23/c23.rpy:1945
translate brazilian c23s005_Mar_e7446202:

    # mom "Te va a parecer una tontería..."
    mom "Você vai achar isso bobagem..."

# game/scripts/c23/c23.rpy:1946
translate brazilian c23s005_Mar_ff0f72cd:

    # mc "¿El qué?"
    mc "O fato de que?"

# game/scripts/c23/c23.rpy:1948
translate brazilian c23s005_Mar_c37b1656:

    # mom "Quiero hacer el amor contigo esta noche..."
    mom "Quero fazer amor com você esta noite..."

# game/scripts/c23/c23.rpy:1949
translate brazilian c23s005_Mar_3d47e4df:

    # mc "*Risa* No, no me parece una tontería."
    mc "*Risos* Não, não acho que seja bobagem."

# game/scripts/c23/c23.rpy:1951
translate brazilian c23s005_Mar_e8a84b31:

    # mom "*Risa* Calla y escucha..."
    mom "*Risos* Fiquem quietos e escutem..."

# game/scripts/c23/c23.rpy:1953
translate brazilian c23s005_Mar_6415efb1:

    # mom "Cuando lo hicimos la primera vez, era como la culminación de una noche perfecta y fue mágico..."
    mom "Quando fizemos isso pela primeira vez, foi como o ápice de uma noite perfeita, foi mágico..."

# game/scripts/c23/c23.rpy:1954
translate brazilian c23s005_Mar_dc9bf552:

    # mom "Hoy somos como una pareja normal... no sé cómo hacerlo sin que se pierda la magia."
    mom "Hoje somos como um casal normal... Não sei como fazer isso sem perder a magia."

# game/scripts/c23/c23.rpy:1955
translate brazilian c23s005_Mar_4ce30d57:

    # mom "Sin que parezca algo programado..."
    mom "Sem que parecesse que algo havia sido planejado..."

# game/scripts/c23/c23.rpy:1956
translate brazilian c23s005_Mar_fb980dbe:

    # mc "Bueno, creo que lo de pareja normal no se nos aplica demasiado."
    mc "Bem, acho que o termo \"casal normal\" não se aplica realmente a nós."

# game/scripts/c23/c23.rpy:1959
translate brazilian c23s005_Mar_712254c7:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con mi hijo, pero me da lo mismo."
    mom "*Risos* Você tem razão. Ninguém aprovaria que eu dormisse com meu filho, mas não me importo."

# game/scripts/c23/c23.rpy:1961
translate brazilian c23s005_Mar_fd1ecd9f:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con el chico a quién he criado, pero me da lo mismo."
    mom "*Risos* Você tem razão. Ninguém aprovaria que eu dormisse com o menino que criei, mas não me importo."

# game/scripts/c23/c23.rpy:1962
translate brazilian c23s005_Mar_609eeb6e:

    # mc "No me refiero sólo a eso. ¿Crees que las parejas normales se plantean estas cosas tan pronto?"
    mc "Não me refiro apenas a isso. Você acha que casais normais consideram essas coisas tão cedo assim?"

# game/scripts/c23/c23.rpy:1963
translate brazilian c23s005_Mar_54d66051:

    # mc "¿Que hablan en su segunda vez sobre no perder la magia?"
    mc "Sobre o que eles conversam na segunda vez, sobre não perder a magia?"

# game/scripts/c23/c23.rpy:1965
translate brazilian c23s005_Mar_470249da:

    # mom "Me preocupo demasiado, ¿verdad?"
    mom "Eu me preocupo demais, não é?"

# game/scripts/c23/c23.rpy:1966
translate brazilian c23s005_Mar_54eef042:

    # mc "Un poco..."
    mc "Um pouco..."

# game/scripts/c23/c23.rpy:1967
translate brazilian c23s005_Mar_92da2253:

    # mom "Es que no quiero que se convierta en algo rutinario, en plan \"Es sábado y toca sexo\"."
    mom "Eu só não quero que isso se torne rotina, tipo \"É sábado e está na hora do sexo\"."

# game/scripts/c23/c23.rpy:1968
translate brazilian c23s005_Mar_6637b5c0:

    # mc "Si no lleváramos una vida tan ajetreada, seguramente sería \"Es una noche cualquiera y toca sexo\"."
    mc "Se não tivéssemos vidas tão agitadas, provavelmente diríamos: \"É só mais uma noite e está na hora do sexo.\""

# game/scripts/c23/c23.rpy:1969
translate brazilian c23s005_Mar_07e123ca:

    # mc "Llevo días queriendo bajar a dormir contigo, pero cuando no pasa una cosa, pasa otra."
    mc "Já faz dias que quero descer para dormir com você, mas quando uma coisa não acontece, outra acontece."

# game/scripts/c23/c23.rpy:1971
translate brazilian c23s005_Mar_f9164bb5:

    # mc "O te veo cansada durante el día y quiero que tengas una buena noche de descanso."
    mc "Ou então, percebo que você está cansado durante o dia e quero que você tenha uma boa noite de sono."

# game/scripts/c23/c23.rpy:1972
translate brazilian c23s005_Mar_862a3f45:

    # mom "Lo sé. Yo también he estado a punto de pedirte varias veces que vengas."
    mom "Eu sei. Também já estive perto de te convidar várias vezes."

# game/scripts/c23/c23.rpy:1973
translate brazilian c23s005_Mar_46a99c1c:

    # mom "Ayer iba a subir a tu habitación pero..."
    mom "Eu ia subir ao seu quarto ontem, mas..."

# game/scripts/c23/c23.rpy:1975
translate brazilian c23s005_Mar_9189a531:

    # mom "Me crucé con [sca] que iba a tu habitación en pijama."
    mom "Eu encontrei [sca] que estava indo para o seu quarto de pijama."

# game/scripts/c23/c23.rpy:1977
translate brazilian c23s005_Mar_694b034f:

    # mom "No podía hacer el esfuerzo de subir las escaleras."
    mom "Não consegui me esforçar para subir as escadas."

# game/scripts/c23/c23.rpy:1978
translate brazilian c23s005_Mar_5718e506:

    # mc "Bueno, hoy estamos aquí y nadie nos va a molestar."
    mc "Bom, estamos aqui hoje e ninguém vai nos incomodar."

# game/scripts/c23/c23.rpy:1981
translate brazilian c23s005_Mar_ba39104e:

    # mc "Y hay mucha piel pidiendo ser acariciada..."
    mc "E há tanta pele implorando para ser acariciada..."

# game/scripts/c23/c23.rpy:1982
translate brazilian c23s005_Mar_a96da54c:

    # "En cuanto empiezas a recorrer su costado, apenas rozándola, puedes notar en la yema de tus dedos cómo a [mar] se le pone la piel de gallina."
    "Assim que você começa a passar os dedos pela lateral do corpo dela, quase sem tocá-la, você sente a pele de [mar] se arrepiar."

# game/scripts/c23/c23.rpy:1983
translate brazilian c23s005_Mar_774e7cb8:

    # mom "Me encanta eso..."
    mom "Adoro isso..."

# game/scripts/c23/c23.rpy:1985
translate brazilian c23s005_Mar_6d7f7dc8:

    # "Tu madre se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "Sua mãe estremece toda vez que você passa os dedos pela curva do quadril dela ou quando traça o contorno da barriga dela subindo até as costas."

# game/scripts/c23/c23.rpy:1987
translate brazilian c23s005_Mar_3a9a845d:

    # "[mar] se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "[mar] Ela estremece toda vez que você passa os dedos pela curva do quadril dela ou quando você traça o contorno do estômago dela subindo até as costas."

# game/scripts/c23/c23.rpy:1988
translate brazilian c23s005_Mar_ef24df22:

    # mc "Lo estoy notando. Aquella noche no tuve mucho tiempo para explorar, quiero conocer cada rincón de tu piel."
    mc "Estou percebendo. Naquela noite eu não tive muito tempo para explorar; quero conhecer cada centímetro da sua pele."

# game/scripts/c23/c23.rpy:1989
translate brazilian c23s005_Mar_e4ba915d:

    # "Un estremecimiento vuelve a recorrer el cuerpo de la hermosa mujer, esta vez provocado por tus palabras en vez de por tus dedos."
    "Um arrepio percorre o corpo da bela mulher novamente, desta vez causado por suas palavras em vez de seus dedos."

# game/scripts/c23/c23.rpy:1993
translate brazilian c23s005_Mar_e236bd13:

    # mom "Me encanta que seas tan delicado siempre... Bueno, siempre que tienes que serlo."
    mom "Adoro que você seja sempre tão gentil... Bem, sempre que você precisa ser."

# game/scripts/c23/c23.rpy:1994
translate brazilian c23s005_Mar_c5991eda:

    # "Su mirada se vuelve felina por momentos, empiezas a sentirte como se debe sentir la presa de un puma. Una presa voluntaria."
    "Seu olhar se torna felino às vezes; você começa a sentir o que deve ser a sensação de ser presa de uma puma. Presa voluntária."

# game/scripts/c23/c23.rpy:1995
translate brazilian c23s005_Mar_82eabf47:

    # mc "Tan solo soy tan delicado como mereces en cada momento. Ni un poco más ni un poco menos."
    mc "Sou simplesmente tão gentil quanto você merece em qualquer momento. Nem um pouco mais, nem um pouco menos."

# game/scripts/c23/c23.rpy:1996
translate brazilian c23s005_Mar_31801a03:

    # "Otro estremecimiento recorre su cuerpo, deseoso de caricias. Deseoso de delicadeza."
    "Outro arrepio percorre seu corpo, ansiando por carícias. Ansiando por ternura."

# game/scripts/c23/c23.rpy:1997
translate brazilian c23s005_Mar_35bc0097:

    # mom "*Gemido* Pero todavía tienes mucha piel que conocer, no solo ese costado."
    mom "*Gemido* Mas você ainda tem muita pele para explorar, não só desse lado."

# game/scripts/c23/c23.rpy:1998
translate brazilian c23s005_Mar_8f53ac06:

    # mc "¿Ya te has cansado de mis caricias?"
    mc "Você já se cansou dos meus carinhos?"

# game/scripts/c23/c23.rpy:2001
translate brazilian c23s005_Mar_71571ec5:

    # mom "No, hijo mío, pero yo también quiero que acaricies toda mi piel."
    mom "Não, meu filho, mas também quero que você acaricie toda a minha pele."

# game/scripts/c23/c23.rpy:2003
translate brazilian c23s005_Mar_df3b1392:

    # mom "No, mi amor, pero yo también quiero que acaricies toda mi piel."
    mom "Não, meu amor, mas também quero que você acaricie toda a minha pele."

# game/scripts/c23/c23.rpy:2004
translate brazilian c23s005_Mar_e07511f8:

    # mom "*Gemido* Si no lo haces tú, tendré que empezar yo a descubrir cada rincón de la tuya."
    mom "*Gemido* Se você não fizer isso, terei que começar a explorar cada canto seu."

# game/scripts/c23/c23.rpy:2005
translate brazilian c23s005_Mar_90d70d9d:

    # mc "*Risa* Hoy estás teniendo unas ideas excelentes, pero me parece que voy a seguir yo con mi exploración."
    mc "*Risos* Você está tendo ótimas ideias hoje, mas acho que vou continuar com a minha exploração."

# game/scripts/c23/c23.rpy:2006
translate brazilian c23s005_Mar_79488545:

    # "Otro estremecimiento más. Esta vez producido por la anticipación."
    "Outro tremor. Desta vez causado pela expectativa."

# game/scripts/c23/c23.rpy:2008
translate brazilian c23s005_Mar_7f85be74:

    # "Tumbándola de espaldas, empiezas a recorrer su cuerpo con tu boca, tal como has prometido que harías."
    "Deitando-a de costas, você começa a explorar o corpo dela com a boca, exatamente como havia prometido."

# game/scripts/c23/c23.rpy:2009
translate brazilian c23s005_Mar_0d3a73f5:

    # mom "*Gemido* Me encanta sentir tus labios sobre mi piel. *Jadeo*"
    mom "*Gemido* Adoro sentir seus lábios na minha pele. *Suspiro*"

# game/scripts/c23/c23.rpy:2010
translate brazilian c23s005_Mar_048a3dcc:

    # "Y tú disfrutas explorando cada rincón de su cuerpo. Cada lugar es un nuevo descubrimiento que atesoras para más tarde."
    "E você se deleita explorando cada centímetro do corpo dela. Cada lugar é uma nova descoberta que você guarda com carinho para mais tarde."

# game/scripts/c23/c23.rpy:2011
translate brazilian c23s005_Mar_8d6c0127:

    # mc "*Smooch* Una piel fantástica que no me voy a cansar de recorrer."
    mc "*Beijinho* Uma skin fantástica que eu nunca me cansarei de explorar."

# game/scripts/c23/c23.rpy:2012
translate brazilian c23s005_Mar_ae01bd62:

    # "Tomas notas mentales sobre qué zonas son más sensitivas para ella, es un conocimiento al que sacarás partido durante años."
    "Você anota mentalmente quais áreas são mais sensíveis para ela; é um conhecimento do qual você se beneficiará por muitos anos."

# game/scripts/c23/c23.rpy:2014
translate brazilian c23s005_Mar_5c66f73f:

    # "No sólo tus labios recorren su cuerpo, sino que tus manos también lo hacen al mismo tiempo."
    "Seus lábios não apenas percorrem o corpo dela, mas suas mãos fazem o mesmo ao mesmo tempo."

# game/scripts/c23/c23.rpy:2015
translate brazilian c23s005_Mar_efca7294:

    # mom "*Jadeo* Me estás volviendo loca... *Gemido* Y aún no has tocado lo más sensible. *Jadeo*"
    mom "*Suspiro* Você está me deixando louca... *Gemido* E você nem tocou no meu ponto mais sensível ainda. *Suspiro*"

# game/scripts/c23/c23.rpy:2016
translate brazilian c23s005_Mar_a444c619:

    # "Miente. Cada trozo de su piel es más sensible que el anterior. Cada estremecimiento es mayor que el que la ha recorrido un segundo antes."
    "Ela está mentindo. Cada pedaço de sua pele é mais sensível que o anterior. Cada tremor é mais forte que aquele que a percorreu um segundo antes."

# game/scripts/c23/c23.rpy:2017
translate brazilian c23s005_Mar_7d703def:

    # mom "*Gemido* Voy a necesitarte dentro... *Jadeo* No puedo aguantar más. *Gemido*"
    mom "*Gemido* Vou precisar de você lá dentro... *Suspiro* Não consigo me conter por mais tempo. *Gemido*"

# game/scripts/c23/c23.rpy:2018
translate brazilian c23s005_Mar_d65c5420:

    # "Todo lo bueno se acaba. Lo mejor está por llegar."
    "Tudo que é bom chega ao fim. O melhor ainda está por vir."

# game/scripts/c23/c23.rpy:2020
translate brazilian c23s005_Mar_ae412d67:

    # "[mar] te da la vuelta sin saber muy bien cómo lo ha hecho. Te tumba de espaldas y se sienta encima tuyo."
    "[mar] Ele te vira sem saber bem como fez isso. Ele te deita de costas e senta em cima de você."

# game/scripts/c23/c23.rpy:2021
translate brazilian c23s005_Mar_f6f48287:

    # mom "*Risita* Estar cachonda me da fuerzas. No creía que pudiera tumbarte así."
    mom "*Risos* Estar excitada me dá forças. Não pensei que conseguiria te derrubar assim."

# game/scripts/c23/c23.rpy:2022
translate brazilian c23s005_Mar_c3157580:

    # "No tienes por qué decirle que no has opuesto ninguna resistencia. Escuchar su risa es suficiente premio por dejarte vencer."
    "Você não precisa dizer a ela que não ofereceu resistência. Ouvir a risada dela já é recompensa suficiente por ter se deixado vencer."

# game/scripts/c23/c23.rpy:2023
translate brazilian c23s005_Mar_d880f54b:

    # mc "Ahora me tienes a tu merced. ¿Qué piensas hacer con este pobre muchacho?"
    mc "Agora você me tem à sua mercê. O que pretende fazer com este pobre menino?"

# game/scripts/c23/c23.rpy:2026
translate brazilian c23s005_Mar_9c3a06fe:

    # "Mjolnir ha encontrado la perfecta posición entre los cachetes de tu madre, pareciendo indicar dónde quiere entrar hoy."
    "Mjolnir encontrou a posição perfeita entre as bochechas de sua mãe, aparentemente indicando para onde quer ir hoje."

# game/scripts/c23/c23.rpy:2028
translate brazilian c23s005_Mar_a823d02c:

    # "Mjolnir ha encontrado la perfecta posición entre los cachetes de [mar], pareciendo indicar dónde quiere entrar hoy."
    "Mjolnir encontrou a posição perfeita entre as nádegas de [mar], aparentemente indicando onde quer entrar hoje."

# game/scripts/c23/c23.rpy:2029
translate brazilian c23s005_Mar_dd2409d2:

    # mom "Por muy tentador que sea donde estás apuntando, te quiero en el otro agujero."
    mom "Por mais tentador que seja o lugar para onde você está mirando, eu quero você no outro buraco."

# game/scripts/c23/c23.rpy:2048
translate brazilian c23s005_Mar_cd64d767:

    # mc "Con lo que puedes hacer lo que quieras."
    mc "Com isso, você pode fazer o que quiser."

# game/scripts/c23/c23.rpy:2050
translate brazilian c23s005_Mar_533df833:

    # mom "*GEMIDO* ¡Ooof! *JADEO*"
    mom "*GEMINADO* Ufa! *ARFADO*"

# game/scripts/c23/c23.rpy:2053
translate brazilian c23s005_Mar_8bec1e9d:

    # mom "*Gemido* Pues si es lo que quiera, quiero volver a tener a mi hijo dentro de mí. *Jadeo*"
    mom "*Gemido* Bem, se é isso que ele quer, eu quero meu filho de volta dentro de mim. *Suspiro*"

# game/scripts/c23/c23.rpy:2055
translate brazilian c23s005_Mar_de1f3dee:

    # mom "*Gemido* Pues volver a tener a Mjolnir dentro de mí me parece la mejor idea."
    mom "*Gemido* Bem, ter o Mjolnir dentro de mim de novo parece a melhor ideia."

# game/scripts/c23/c23.rpy:2056
translate brazilian c23s005_Mar_079e6d72:

    # mc "*Risa* Una de las mejores ideas que has tenido."
    mc "*Risos* Uma das melhores ideias que você já teve."

# game/scripts/c23/c23.rpy:2058
translate brazilian c23s005_Mar_86466ccb:

    # mom "¿Quieres que empiece a moverme?"
    mom "Você quer que eu comece a me mexer?"

# game/scripts/c23/c23.rpy:2059
translate brazilian c23s005_Mar_4de11488:

    # mc "Cuando estés lista. ¿Necesitas un poco de tiempo para acostumbrarte?"
    mc "Quando você estiver pronto. Precisa de um tempinho para se acostumar?"

# game/scripts/c23/c23.rpy:2062
translate brazilian c23s005_Mar_505ac815:

    # mom "No, te llevé dentro nueve meses. No necesito volver a acostumbrarme."
    mom "Não, eu te carreguei dentro de mim por nove meses. Não preciso me acostumar com isso de novo."

# game/scripts/c23/c23.rpy:2064
translate brazilian c23s005_Mar_d0048a79:

    # mom "No hace falta. Quiero notarte antes de que me abras de par en par."
    mom "Não precisa. Quero te notar antes que você me abra completamente."

# game/scripts/c23/c23.rpy:2065
translate brazilian c23s005_Mar_1c90e143:

    # mom "Casi me corro cuando has entrado..."
    mom "Eu quase gozei quando você entrou..."

# game/scripts/c23/c23.rpy:2066
translate brazilian c23s005_Mar_93c5dda2:

    # mc "¿Tan rápido?"
    mc "Tão rápido?"

# game/scripts/c23/c23.rpy:2067
translate brazilian c23s005_Mar_b0ecbddb:

    # mom "Tus caricias y tus besos me han dejado muy cerca..."
    mom "Seus carinhos e beijos me deixaram muito perto..."

# game/scripts/c23/c23.rpy:2071
translate brazilian c23s005_Mar_7ea17ecd:

    # "[mar] empieza un movimiento rítmico, dejando que Mjolnir solo entre y salga unos centímetros, concentrando sus músculos en aprisionar tu glande."
    "[mar] inicia um movimento rítmico, permitindo que Mjolnir entre e saia apenas alguns centímetros, concentrando seus músculos em aprisionar sua glande."

# game/scripts/c23/c23.rpy:2073
