translate brazilian c23s002_SaiPregnancy_8dfe7662:

    # mc "Creo que todo el mundo está haciendo yoga ahora mismo o preparándose para ir a clase."
    mc "Acho que todo mundo está praticando ioga agora ou se preparando para ir à aula."

# game/scripts/c23/c23.rpy:597
translate brazilian c23s002_SaiPregnancy_7844caef:

    # sai "Tienes razón. Hoy es más tarde que ayer. No tengo clase esta mañana."
    sai "Você tem razão. Hoje já é mais tarde do que ontem. Não tenho aula esta manhã."

# game/scripts/c23/c23.rpy:598
translate brazilian c23s002_SaiPregnancy_48f80515:

    # sai "Tan solo tengo que acabar un estudio sobre Maria Montessori."
    sai "Só preciso terminar um estudo sobre Maria Montessori."

# game/scripts/c23/c23.rpy:599
translate brazilian c23s002_SaiPregnancy_9319a8a3:

    # mc "No tengo ni idea de quién es."
    mc "Não faço ideia de quem ela seja."

# game/scripts/c23/c23.rpy:602
translate brazilian c23s002_SaiPregnancy_502d27d9:

    # "Para cuando acaba, tú has terminado tu trozo de pastel, quizás demasiado pequeño, y subes a tu habitación."
    "Quando tudo termina, você já comeu seu pedaço de bolo, talvez pequeno demais, e sobe para o seu quarto."

# game/scripts/c23/c23.rpy:606
translate brazilian c23s002_SaiPregnancy_b6c6519b:

    # sai "Era una profesora italiana que..."
    sai "Ela era uma professora italiana que..."

# game/scripts/c23/c23.rpy:609
translate brazilian c23s002_SaiPregnancy_5e9d0ebe:

    # mc "Parece interesante."
    mc "Parece interessante."

# game/scripts/c23/c23.rpy:610
translate brazilian c23s002_SaiPregnancy_d1b6da3b:

    # sai "Lo es. Pero ¿sabes qué sería interesante también?"
    sai "É verdade. Mas sabe o que mais seria interessante?"

# game/scripts/c23/c23.rpy:611
translate brazilian c23s002_SaiPregnancy_a02421db:

    # mc "*Risa* Muchas cosas. Es una pregunta imposible de acertar."
    mc "*Risos* Muitas coisas. É uma pergunta impossível de responder corretamente."

# game/scripts/c23/c23.rpy:613
translate brazilian c23s002_SaiPregnancy_ed23f690:

    # sai "Tienes razón. *Risa* Sin saber en lo que estoy pensando es imposible que lo aciertes."
    sai "Você tem razão. *Risos* Sem saber o que estou pensando, é impossível você adivinhar."

# game/scripts/c23/c23.rpy:614
translate brazilian c23s002_SaiPregnancy_1b6c05eb:

    # mc "Dame alguna pista..."
    mc "Me dê uma dica..."

# game/scripts/c23/c23.rpy:616
translate brazilian c23s002_SaiPregnancy_3ceb6b04:

    # sai "Hablando de Montessori he empezado a pensar en niños..."
    sai "Falar sobre Montessori me fez começar a pensar nas crianças..."

# game/scripts/c23/c23.rpy:617
translate brazilian c23s002_SaiPregnancy_669007dc:

    # mc "Y quieres saber el resultado de la prueba de embarazo."
    mc "E você quer saber o resultado do teste de gravidez."

# game/scripts/c23/c23.rpy:619
translate brazilian c23s002_SaiPregnancy_933d228c:

    # sai "Me conoces demasiado. ¿Te importa si subimos ya? Puedo desayunar más tarde."
    sai "Você me conhece muito bem. Se importa se subirmos agora? Posso tomar o café da manhã mais tarde."

# game/scripts/c23/c23.rpy:620
translate brazilian c23s002_SaiPregnancy_ed63e57f:

    # mc "Si, por mí perfecto. Cuanto antes lo sepamos, mejor. Vamos."
    mc "Sim, isso é perfeito para mim. Quanto antes soubermos, melhor. Vamos lá."

# game/scripts/c23/c23.rpy:623
translate brazilian c23s002_SaiPregnancy_f3a408c1:

    # sai "*Risa* Pobre [sca]. Con lo poco que le gusta el deporte, y ha tenido que subir hasta la azotea para nada."
    sai "*Risos* Coitadinha [sca]. Ela não gosta muito de esportes e teve que subir até o telhado à toa."

# game/scripts/c23/c23.rpy:624
translate brazilian c23s002_SaiPregnancy_07355acc:

    # mc "*Risa* Y ahora bajar corriendo a la piscina. Va a llegar agotada."
    mc "*Risos* E agora ela tem que correr até a piscina. Ela vai estar exausta até lá."

# game/scripts/c23/c23.rpy:626
translate brazilian c23s002_SaiPregnancy_28c4ed1c:

    # sai "¿Continuamos a tu habitación?"
    sai "Vamos prosseguir para o seu quarto?"

# game/scripts/c23/c23.rpy:627
translate brazilian c23s002_SaiPregnancy_63cd8ebd:

    # mc "Vamos."
    mc "Vamos."

# game/scripts/c23/c23.rpy:629
translate brazilian c23s002_SaiPregnancy_b95a4741:

    # mc "Lo puedes coger tú misma si quieres. Está en el armario."
    mc "Você pode pegar você mesmo, se quiser. Está no armário."

# game/scripts/c23/c23.rpy:630
translate brazilian c23s002_SaiPregnancy_b8617989:

    # sai "Mejor míralo tú primero. Estoy un poco nerviosa."
    sai "Você deveria dar uma olhada primeiro. Estou um pouco nervoso."

# game/scripts/c23/c23.rpy:631
translate brazilian c23s002_SaiPregnancy_0e4115b6:

    # mc "¿Te da miedo estar embarazada?"
    mc "Você tem medo de engravidar?"

# game/scripts/c23/c23.rpy:633
translate brazilian c23s002_SaiPregnancy_5c972d3b:

    # sai "Por un lado no. Quiero tener un par de críos correteando por casa lo antes posible. Me da lo mismo si son niños o niñas."
    sai "Por um lado, não. Quero ter um casal de crianças correndo pela casa o mais rápido possível. Não me importo se são meninos ou meninas."

# game/scripts/c23/c23.rpy:634
translate brazilian c23s002_SaiPregnancy_7ff3a75e:

    # sai "Por otro lado... creo que es demasiado pronto... aún no he acabado la carrera y nunca me había planteado tener hijos tan joven..."
    sai "Por outro lado... acho que é muito cedo... ainda não terminei minha graduação e nunca pensei em ter filhos tão jovem..."

# game/scripts/c23/c23.rpy:635
translate brazilian c23s002_SaiPregnancy_88c6d337:

    # mc "Bueno, si estás embarazada, no hay mucho que podamos hacer, pero si no lo estás, si quieres puedes volver a tomar anticonceptivos."
    mc "Bem, se você estiver grávida, não há muito que possamos fazer, mas se não estiver, você pode voltar a tomar anticoncepcionais se quiser."

# game/scripts/c23/c23.rpy:636
translate brazilian c23s002_SaiPregnancy_7c8ba9d4:

    # mc "Tenemos mucho tiempo para tener ese par de niños."
    mc "Temos bastante tempo para ter esses dois filhos."

# game/scripts/c23/c23.rpy:638
translate brazilian c23s002_SaiPregnancy_e13264a4:

    # sai "No pienso tomar anticonceptivos. Cuando el destino decida que tienen que llegar, llegarán."
    sai "Não pretendo tomar anticoncepcionais. Quando o destino decidir que eles devem ficar juntos, ficarão."

# game/scripts/c23/c23.rpy:639
translate brazilian c23s002_SaiPregnancy_6a559599:

    # sai "Y míralo ya antes de que me ponga más nerviosa."
    sai "E assista agora antes que eu fique ainda mais nervoso."

# game/scripts/c23/c23.rpy:655
translate brazilian c23s002_ScaYoga_6b530c5d:

    # "Al salir al comedor te encuentras con [sca] con pinta de estar perdida."
    "Ao entrar na sala de jantar, você encontra [sca] que parece estar perdido."

# game/scripts/c23/c23.rpy:656
translate brazilian c23s002_ScaYoga_c8e9c7f8:

    # mc "¿Buscas algo, [sca]?"
    mc "Você está procurando por alguma coisa, [sca]?"

# game/scripts/c23/c23.rpy:657
translate brazilian c23s002_ScaYoga_4fd9952d:

    # sca "Creo que he llegado tarde a la sesión de yoga."
    sca "Acho que estou atrasado(a) para a aula de ioga."

# game/scripts/c23/c23.rpy:659
translate brazilian c23s002_ScaYoga_212eb0dc:

    # mc "¿Has decidido apuntarte? Eso es nuevo."
    mc "Você decidiu se cadastrar? Isso é novidade."

# game/scripts/c23/c23.rpy:660
translate brazilian c23s002_ScaYoga_bc90664b:

    # sca "Bueno, después de lo de ayer, quiero hacer aún más cosas con las chicas."
    sca "Bem, depois do que aconteceu ontem, quero fazer ainda mais coisas com as meninas."

# game/scripts/c23/c23.rpy:661
translate brazilian c23s002_ScaYoga_cc3dd443:

    # sca "Pero acabo de ir a la terraza y parece que ya han acabado."
    sca "Mas acabei de sair para o terraço e parece que eles já terminaram."

# game/scripts/c23/c23.rpy:662
translate brazilian c23s002_ScaYoga_709d1211:

    # mc "Oh, ¿nadie te ha dicho que han movido las sesiones de yoga a la piscina?"
    mc "Ah, ninguém te avisou que as aulas de ioga foram transferidas para a piscina?"

# game/scripts/c23/c23.rpy:664
translate brazilian c23s002_ScaYoga_9c5d3a71:

    # sca "¿Qué? ¡No! Nadie me lo había dicho."
    sca "O quê? Não! Ninguém me disse nada."

# game/scripts/c23/c23.rpy:665
translate brazilian c23s002_ScaYoga_7763df00:

    # sca "¡Me voy antes de que acaben!"
    sca "Vou embora antes que eles terminem!"

# game/scripts/c23/c23.rpy:667
translate brazilian c23s002_ScaYoga_e4aaf8ac:

    # mc "Hasta luego, [sca]."
    mc "Até logo, [sca]."

# game/scripts/c23/c23.rpy:669
translate brazilian c23s002_ScaYoga_12242b08:

    # sai "Adiós, [sca]."
    sai "Adeus, [sca]."

# game/scripts/c23/c23.rpy:670
translate brazilian c23s002_ScaYoga_06da67ce:

    # sca "Hasta luego..."
    sca "Até mais..."

# game/scripts/c23/c23.rpy:673
translate brazilian c23s002_ScaYoga_3cbfaa21:

    # sca "Ahora sí. Hasta luego."
    sca "Certo, então. Até mais."

# game/scripts/c23/c23.rpy:677
translate brazilian c23s002_Montessori_b75a7dd9:

    # "[sai] pasa los siguientes minutos explicándote la biografía de la pedagoga. Por lo visto hizo cosas revolucionarias para su época."
    "[sai] passa os próximos minutos explicando a biografia da educadora. Aparentemente, ela fez coisas revolucionárias para a sua época."

# game/scripts/c23/c23.rpy:678
translate brazilian c23s002_Montessori_01d25fc0:

    # "Pero es una historia en la que se entrevén muchos grises."
    "Mas é uma história onde se podem ver muitos tons de cinza."

# game/scripts/c23/c23.rpy:682
translate brazilian c23s002_SaiPregnant_a5389849:

    # mc "¡Verde. Vamos a tener un bebé!"
    mc "Verde. Vamos ter um bebê!"

# game/scripts/c23/c23.rpy:684
translate brazilian c23s002_SaiPregnant_b0eb6df2:

    # sai "Felicidades, cielo. Sé que te hacía ilusión."
    sai "Parabéns, querida. Sei que você estava animada com isso."

# game/scripts/c23/c23.rpy:685
translate brazilian c23s002_SaiPregnant_0b584a5b:

    # mc "No suenas muy contenta."
    mc "Você não parece muito feliz."

# game/scripts/c23/c23.rpy:687
translate brazilian c23s002_SaiPregnant_2d6f41fa:

    # sai "Estoy contenta, pero preocupada."
    sai "Estou feliz, mas preocupado."

# game/scripts/c23/c23.rpy:688
translate brazilian c23s002_SaiPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Para a corrida? Nós te ajudaremos no que for possível."

# game/scripts/c23/c23.rpy:690
translate brazilian c23s002_SaiPregnant_f2f8f8f9:

    # sai "No, la carrera no me preocupa demasiado. Me parece raro tener un bebé antes de acabarla, pero ya está."
    sai "Não, meu curso não me preocupa muito. É estranho ter um bebê antes de terminar, mas só isso."

# game/scripts/c23/c23.rpy:691
translate brazilian c23s002_SaiPregnant_7ddf9ba8:

    # sai "Me preocupa decírselo a mis padres."
    sai "Estou com medo de contar para meus pais."

# game/scripts/c23/c23.rpy:692
translate brazilian c23s002_SaiPregnant_0cabfb10:

    # mc "¿Cómo se lo van a tomar?"
    mc "Como eles vão reagir?"

# game/scripts/c23/c23.rpy:694
translate brazilian c23s002_SaiPregnant_2c5430c4:

    # mc "Bueno, si quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Bom, se você quer que eu esteja lá para lhe dizer isso, conte comigo..."

# game/scripts/c23/c23.rpy:696
translate brazilian c23s002_SaiPregnant_1219b8ff:

    # sai "No te preocupes. No se lo voy a decir todavía."
    sai "Não se preocupe. Eu não vou contar para ele ainda."

# game/scripts/c23/c23.rpy:697
translate brazilian c23s002_SaiPregnant_038560de:

    # mc "¿Por qué? ¿Cuánto quieres esperar?"
    mc "Por quê? Quanto tempo você quer esperar?"

# game/scripts/c23/c23.rpy:699
translate brazilian c23s002_SaiPregnant_c5240d56:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les digo que me he quedado embarazada del dueño de la residencia, no le van a dejar venir."
    sai "Pelo menos até a Kaly chegar. Se eu disser que estou grávida do dono da casa, eles não vão deixar ela vir."

# game/scripts/c23/c23.rpy:700
translate brazilian c23s002_SaiPregnant_4244b12a:

    # sai "Van a pensar que la vas a dejar embarazada en cuanto llegue..."
    sai "Eles vão achar que você vai engravidá-la assim que ela chegar..."

# game/scripts/c23/c23.rpy:702
translate brazilian c23s002_SaiPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "E isso sem nem mesmo ter alcançado a reputação de pai de filhos na Índia."

# game/scripts/c23/c23.rpy:703
translate brazilian c23s002_SaiPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Não tenho nenhuma intenção de ter nada com Kalyani, [sai]."

# game/scripts/c23/c23.rpy:705
translate brazilian c23s002_SaiPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Risos* Assim que você vir aqueles olhinhos piscando no seu rosto, você vai confirmar para mim."

# game/scripts/c23/c23.rpy:706
translate brazilian c23s002_SaiPregnant_5aacd3bb:

    # mc "Bueno, pero aparte de lo de tus padres, ¿cómo estás tú?"
    mc "Certo, mas além dos seus pais, como você está?"

# game/scripts/c23/c23.rpy:708
translate brazilian c23s002_SaiPregnant_a7bc00ad:

    # sai "Ya te digo que estoy contenta, aunque..."
    sai "Estou te dizendo, estou feliz, embora..."

# game/scripts/c23/c23.rpy:709
translate brazilian c23s002_SaiPregnant_3b916da8:

    # mc "¿Qué pasa?"
    mc "O que está acontecendo?"

# game/scripts/c23/c23.rpy:711
translate brazilian c23s002_SaiPregnant_ed7721cb:

    # sai "No voy a poder volverme a poner este top en cuanto éstas empiecen a crecer. Voy a tener que cambiar el vestuario."
    sai "Não poderei usar essa blusa novamente quando meus seios começarem a crescer. Terei que renovar meu guarda-roupa."

# game/scripts/c23/c23.rpy:712
translate brazilian c23s002_SaiPregnant_29681486:

    # mc "*Risa* Vas a estar guapísima lleves lo que lleves."
    mc "*Risos* Você vai ficar linda não importa o que vista."

# game/scripts/c23/c23.rpy:714
translate brazilian c23s002_SaiPregnant_5b606ea9:

    # sai "No es cómo esperaba que pasara, pero estoy más contenta de lo que parezco. Tan solo me siento rara de tener que ocultárselo a mis padres."
    sai "Não foi como eu esperava que acontecesse, mas estou mais feliz do que aparento. Só me sinto estranha por ter que esconder isso dos meus pais."

# game/scripts/c23/c23.rpy:715
translate brazilian c23s002_SaiPregnant_490a5817:

    # mc "No se lo ocultas, retrasas la noticia tan solo."
    mc "Você não está escondendo nada dele, apenas está adiando a notícia."

# game/scripts/c23/c23.rpy:717
translate brazilian c23s002_SaiPregnant_50ec1616:

    # sai "¡Vamos a la piscina! Quiero darles la noticia al resto de las chicas. Después lo publicaré en el grupo de WhatsUp."
    sai "Vamos para a piscina! Quero contar para as outras meninas. Postarei no grupo do WhatsApp mais tarde."

# game/scripts/c23/c23.rpy:718
translate brazilian c23s002_SaiPregnant_c884d001:

    # mc "¿En el que estoy yo o en el que no estoy?"
    mc "Aquele em que estou ou aquele em que não estou?"

# game/scripts/c23/c23.rpy:720
translate brazilian c23s002_SaiPregnant_f50b3bac:

    # sai "En los dos. En el tuyo no contestará casi nadie, pero lo publicaré por si alguien quiere felicitarte a ti."
    sai "Em ambos os casos. Quase ninguém responderá ao seu, mas vou publicá-lo caso alguém queira te parabenizar."

# game/scripts/c23/c23.rpy:721
translate brazilian c23s002_SaiPregnant_831b697a:

    # mc "*Risa* A veces os odio. Vamos."
    mc "*Risos* Às vezes eu odeio vocês. Fala sério."

# game/scripts/c23/c23.rpy:725
translate brazilian c23s002_parents_7589d59f:

    # sai "Imagínate enviar a tu hija al extranjero a estudiar y que antes de que acabe la carrera se quede embarazada."
    sai "Imagine mandar sua filha estudar no exterior e ela engravidar antes de terminar o curso."

# game/scripts/c23/c23.rpy:726
translate brazilian c23s002_parents_f5a86a18:

    # sai "Y del dueño de la residencia de estudiantes nada menos... Y sin estar casados..."
    sai "E da dona da residência estudantil, nada menos... E sem ser casada..."

# game/scripts/c23/c23.rpy:727
translate brazilian c23s002_parents_3c948955:

    # mc "Me lo puedo imaginar. Ya me dijiste que eran muy tradicionales."
    mc "Imagino. Você já me disse que eles eram muito tradicionais."

# game/scripts/c23/c23.rpy:729
translate brazilian c23s002_parents_0da23dec:

    # sai "*Risa triste* ¿Tradicionales? Une a eso retrógrados y te acercarás a una versión modernizada de mis padres."
    sai "*Risada triste* Tradicional? Acrescente retrógrado a isso e você terá algo próximo a uma versão modernizada dos meus pais."

# game/scripts/c23/c23.rpy:730
translate brazilian c23s002_parents_1b3c77e8:

    # sai "A veces parece que vivan en el Siglo XIX o el XX."
    sai "Às vezes parece que eles vivem no século XIX ou XX."

# game/scripts/c23/c23.rpy:734
translate brazilian c23s002_SaiNotPregnant_26eea004:

    # mc "Rojo. No vamos a tener un bebé aún."
    mc "Vermelho. Ainda não vamos ter um bebê."

# game/scripts/c23/c23.rpy:736
translate brazilian c23s002_SaiNotPregnant_d975b988:

    # sai "Bueno, otra vez será. No tenemos prisa."
    sai "Ah, bem, talvez da próxima vez. Não temos pressa."

# game/scripts/c23/c23.rpy:737
translate brazilian c23s002_SaiNotPregnant_2537456b:

    # mc "No suenas muy decepcionada. Eso es bueno."
    mc "Você não parece muito decepcionado. Isso é bom."

# game/scripts/c23/c23.rpy:739
translate brazilian c23s002_SaiNotPregnant_e6495c22:

    # sai "Estoy decepcionada, pero, por otro lado, estoy aliviada."
    sai "Estou desapontado, mas, por outro lado, estou aliviado."

# game/scripts/c23/c23.rpy:740
translate brazilian c23s002_SaiNotPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Para a corrida? Nós te ajudaremos no que for possível."

# game/scripts/c23/c23.rpy:742
translate brazilian c23s002_SaiNotPregnant_b6444778:

    # sai "No, la carrera no me preocupa demasiado. Me hubiera parecido raro tener un bebé antes de acabarla, pero ya está."
    sai "Não, meu curso não me preocupa muito. Teria sido estranho ter um bebê antes de terminá-lo, mas fazer o quê?"

# game/scripts/c23/c23.rpy:743
translate brazilian c23s002_SaiNotPregnant_4b9b2f05:

    # sai "Me preocupaba decírselo a mis padres."
    sai "Eu estava com medo de contar para meus pais."

# game/scripts/c23/c23.rpy:744
translate brazilian c23s002_SaiNotPregnant_0beea497:

    # mc "¿Cómo se lo iban a tomar?"
    mc "Como eles iriam reagir?"

# game/scripts/c23/c23.rpy:746
translate brazilian c23s002_SaiNotPregnant_7eec1ef5:

    # mc "Bueno, si, cuando te quedes embarazada, quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Bom, se você quer que eu esteja lá para contar para ele quando você engravidar, pode contar comigo..."

# game/scripts/c23/c23.rpy:748
translate brazilian c23s002_SaiNotPregnant_e4455855:

    # sai "No te preocupes. No se lo pensaba decir aunque me hubiera quedado embarazada ahora."
    sai "Não se preocupe. Eu não pretendia contar para ele, mesmo se estivesse grávida agora."

# game/scripts/c23/c23.rpy:749
translate brazilian c23s002_SaiNotPregnant_d9f65540:

    # mc "¿Por qué? ¿Cuánto hubieras querido esperar?"
    mc "Por quê? Quanto tempo você gostaria de ter esperado?"

# game/scripts/c23/c23.rpy:751
translate brazilian c23s002_SaiNotPregnant_6016f36c:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les hubiera dicho que me he quedado embarazada del dueño de la residencia, no le iban a dejar venir."
    sai "Pelo menos até a Kaly chegar. Se eu tivesse contado que estava grávida do dono da casa, eles não teriam deixado ela vir."

# game/scripts/c23/c23.rpy:752
translate brazilian c23s002_SaiNotPregnant_e27513d6:

    # sai "Iban a pensar que la ibas a dejar embarazada en cuanto llegara..."
    sai "Eles iam pensar que você ia engravidá-la assim que ela chegasse..."

# game/scripts/c23/c23.rpy:754
translate brazilian c23s002_SaiNotPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "E isso sem nem mesmo ter alcançado a reputação de pai de filhos na Índia."

# game/scripts/c23/c23.rpy:755
translate brazilian c23s002_SaiNotPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Não tenho nenhuma intenção de ter nada com Kalyani, [sai]."

# game/scripts/c23/c23.rpy:757
translate brazilian c23s002_SaiNotPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Risos* Assim que você vir aqueles olhinhos piscando no seu rosto, você vai confirmar para mim."

# game/scripts/c23/c23.rpy:758
translate brazilian c23s002_SaiNotPregnant_79b68995:

    # mc "*Risa* No me tientes, sabes que unos ojos bonitos son mi perdición."
    mc "*Risos* Não me tente, você sabe que olhos bonitos são minha perdição."

# game/scripts/c23/c23.rpy:759
translate brazilian c23s002_SaiNotPregnant_b22bd2d7:

    # mc "Pero volviendo a tus padres, la parte buena es que no tienes que ocultarles nada."
    mc "Mas, voltando aos seus pais, a vantagem é que você não precisa esconder nada deles."

# game/scripts/c23/c23.rpy:761
translate brazilian c23s002_SaiNotPregnant_7bc4da83:

    # sai "Sí, y al menos no tendré que cambiar de vestuario."
    sai "Sim, e pelo menos não terei que trocar de roupa."

# game/scripts/c23/c23.rpy:762
translate brazilian c23s002_SaiNotPregnant_b3961c59:

    # mc "¿Por qué?"
    mc "Porque?"

# game/scripts/c23/c23.rpy:764
translate brazilian c23s002_SaiNotPregnant_f3513bd4:

    # sai "Si me hubiera quedado embarazada no hubiera podido volver a ponerme este top en cuanto éstas empezaran a crecer."
    sai "Se eu tivesse engravidado, não teria conseguido usar essa blusa novamente quando meus seios começassem a crescer."

# game/scripts/c23/c23.rpy:765
translate brazilian c23s002_SaiNotPregnant_5f5a76d1:

    # mc "*Risa* Ibas a estar guapísima llevaras lo que llevaras."
    mc "*Risos* Você ficaria deslumbrante não importa o que vestisse."

# game/scripts/c23/c23.rpy:767
translate brazilian c23s002_SaiNotPregnant_15a7439e:

    # sai "Voy a ir a la piscina a decirle a [mar] y a [emm] que el test ha salido negativo."
    sai "Vou à piscina para contar a [mar] e [emm] que o teste deu negativo."

# game/scripts/c23/c23.rpy:768
translate brazilian c23s002_SaiNotPregnant_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Você quer que eu te acompanhe?"

# game/scripts/c23/c23.rpy:770
translate brazilian c23s002_SaiNotPregnant_f0467d0d:

    # sai "No hace falta. Me van a querer dar abrazos para consolarme, aunque no sean necesarios. *Risa* Quiero esos abrazos solo para mí."
    sai "Não é necessário. Eles vão querer me abraçar para me consolar, mesmo que não precisem. *Risos* Quero todos esses abraços só para mim."

# game/scripts/c23/c23.rpy:771
translate brazilian c23s002_SaiNotPregnant_91dba7af:

    # mc "*Risa* A veces os odio. Te veo luego."
    mc "*Risos* Às vezes eu odeio vocês. Até mais."

# game/scripts/c23/c23.rpy:781
translate brazilian c23s002_Lugagge_75bb8a0c:

    # "Vas al lavabo y vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Você vai ao banheiro e volta para o seu quarto para colocar uma muda de roupa na mochila para a viagem de amanhã."

# game/scripts/c23/c23.rpy:783
translate brazilian c23s002_Lugagge_ecee5073:

    # "Después de pasar por la piscina, vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Após ir à piscina, você retorna ao seu quarto para arrumar uma muda de roupa em uma mochila para o passeio de amanhã."

# game/scripts/c23/c23.rpy:785
translate brazilian c23s002_Lugagge_c1485301:

    # "Vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Você volta para o seu quarto para arrumar uma muda de roupa em uma mochila para a viagem de amanhã."

# game/scripts/c23/c23.rpy:786
translate brazilian c23s002_Lugagge_12d1537c:

    # "Cuando casi has acabado..."
    "Quando você estiver quase terminando..."

# game/scripts/c23/c23.rpy:789
translate brazilian c23s002_Lugagge_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c23/c23.rpy:791
translate brazilian c23s002_Lugagge_bb9c1f60:

    # mom "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mom "*Pela porta* Sou eu. Posso entrar?"

# game/scripts/c23/c23.rpy:792
translate brazilian c23s002_Lugagge_4d601f0e:

    # mc "Sí, pasa."
    mc "Sim, acontece."

# game/scripts/c23/c23.rpy:797
translate brazilian c23s002_Lugagge_9bbf8b8f:

    # mom "Venía a ver si querías que te ayudara a hacer la maleta para mañana."
    mom "Vim ver se você queria que eu te ajudasse a arrumar sua mala para amanhã."

# game/scripts/c23/c23.rpy:798
translate brazilian c23s002_Lugagge_88471209:

    # mc "*Risa* ¿Maleta? Con una mochila tengo suficiente. Una muda de ropa y artículos de higiene."
    mc "*Risos* Mala? Uma mochila basta. Uma muda de roupa e artigos de higiene pessoal."

# game/scripts/c23/c23.rpy:800
translate brazilian c23s002_Lugagge_7a59eeaa:

    # mom "¿Sólo eso?"
    mom "Isso é tudo?"

# game/scripts/c23/c23.rpy:801
translate brazilian c23s002_Lugagge_d157fcf1:

    # mc "No necesito más. Es solo una noche."
    mc "Não preciso de mais nada. É só uma noite."

# game/scripts/c23/c23.rpy:802
translate brazilian c23s002_Lugagge_0299b411:

    # mom "¿Y si llueve? ¿O si hace frío? Deberías coger una chaqueta."
    mom "E se chover? Ou se estiver frio? Você deve levar um casaco."

# game/scripts/c23/c23.rpy:807
translate brazilian c23s002_Lugagge_54eacab5:

    # mc "[Mom], he mirado las temperaturas en el móvil, y se espera que haga buen día."
    mc "[Mom], verifiquei as temperaturas no meu celular e a previsão é de um dia agradável."

# game/scripts/c23/c23.rpy:809
translate brazilian c23s002_Lugagge_c95214f0:

    # mom "Nunca te puedes fiar de esas aplicaciones, cielo. Acuérdate de cuando fuimos a Fresno. La app decía que iba a hacer sol y llovió."
    mom "Você nunca pode confiar nesses aplicativos, querida. Lembra quando fomos para Fresno? O aplicativo disse que ia fazer sol, e choveu."

# game/scripts/c23/c23.rpy:810
translate brazilian c23s002_Lugagge_623d3f2f:

    # mc "De eso hace casi diez años, [Mom]. Las aplicaciones son mucho más fiables ahora."
    mc "Isso foi há quase dez anos, [Mom]. Os aplicativos são muito mais confiáveis agora."

# game/scripts/c23/c23.rpy:812
translate brazilian c23s002_Lugagge_56eefaa0:

    # mom "Bueno, pero llévate una chaqueta por lo que pueda ser. ¿Qué camisas te vas a llevar?"
    mom "Certo, mas leve um casaco por precaução. Que camisas você vai levar?"

# game/scripts/c23/c23.rpy:813
translate brazilian c23s002_Lugagge_6690c782:

    # mc "Una camiseta. Nada de camisas. Van a llegar arrugadas."
    mc "Uma camiseta. Nada de camisas sociais. Elas chegarão amassadas."

# game/scripts/c23/c23.rpy:815
translate brazilian c23s002_Lugagge_9939e1dd:

    # mom "Deberías llevarte la camisa azul. Tienes que ir bien vestido si vas a reunirte con el obispo, y esa camisa te queda muy bien."
    mom "Você deve levar a camisa azul. É preciso estar bem vestido para se encontrar com o bispo, e essa camisa fica muito bem em você."

# game/scripts/c23/c23.rpy:816
translate brazilian c23s002_Lugagge_4eddcb7c:

    # mc "*Risa* No soy yo quien se reúne con el obispo, es Tía [bet]. Por una vez sólo hago de chófer, no tengo que resolver nada."
    mc "*Risos* Não sou eu que vou me encontrar com o bispo, é a tia [bet]. Desta vez, sou apenas o motorista, não preciso resolver nada."

# game/scripts/c23/c23.rpy:817
translate brazilian c23s002_Lugagge_f5adc8f7:

    # mc "Y la reunión ni siquiera es con el obispo, es con un secretario."
    mc "E a reunião nem sequer é com o bispo, é com uma secretária."

# game/scripts/c23/c23.rpy:819
translate brazilian c23s002_Lugagge_0cff2902:

    # mom "Pero la acompañarás, ¿verdad? Está muy nerviosa."
    mom "Mas você vai com ela, não é? Ela está muito nervosa."

# game/scripts/c23/c23.rpy:820
translate brazilian c23s002_Lugagge_5f6d22fc:

    # mc "No creo que quiera que la acompañe a la reunión. La llevaré a las oficinas de la diócesis, pero no creo que entrar con ella sea lo mejor."
    mc "Acho que ela não quer que eu a acompanhe à reunião. Eu a levarei aos escritórios da diocese, mas não acho que entrar com ela seja uma boa ideia."

# game/scripts/c23/c23.rpy:821
translate brazilian c23s002_Lugagge_d91007c6:

    # mc "De todas formas, le preguntaré, pero dudo que quiera que esté en esa reunión."
    mc "De qualquer forma, vou perguntar a ele, mas duvido que ele me queira nessa reunião."

# game/scripts/c23/c23.rpy:823
translate brazilian c23s002_Lugagge_98e60a1c:

    # mom "Bueno, pues mete la camisa azul por si acaso la tienes que acompañar."
    mom "Bem, leve a camisa azul caso precise usá-la junto."

# game/scripts/c23/c23.rpy:824
translate brazilian c23s002_Lugagge_4d2532ae:

    # mom "Siempre tienes que llevar algo de ropa correcta por si surge un imprevisto."
    mom "Você deve sempre levar consigo roupas adequadas para o caso de um imprevisto."

# game/scripts/c23/c23.rpy:825
translate brazilian c23s002_Lugagge_fa56d19b:

    # mc "La eché a lavar ayer o anteayer. No la he visto en el armario."
    mc "Coloquei para lavar ontem ou anteontem. Não a vi no armário."

# game/scripts/c23/c23.rpy:827
translate brazilian c23s002_Lugagge_8fff1679:

    # mom "Tienes razón, creo que la lavé ayer. Tengo que plancharla."
    mom "Você tem razão, acho que lavei ontem. Preciso passar a ferro."

# game/scripts/c23/c23.rpy:828
translate brazilian c23s002_Lugagge_213e7078:

    # mc "No te molestes, [Mom], con una camiseta también voy bien. Además, se va a arrugar en la mochila."
    mc "Não se preocupe, [Mom], uma camiseta também serve. Além disso, ela vai amassar na minha mochila."

# game/scripts/c23/c23.rpy:830
translate brazilian c23s002_Lugagge_8d3d8ca3:

    # mom "No te preocupes. La meteré en una de las maletas de [emm]. Luego le tengo que ayudar a hacerlas."
    mom "Não se preocupe. Vou colocar em uma das malas da [emm]. Depois, preciso ajudá-la a arrumar as malas."

# game/scripts/c23/c23.rpy:831
translate brazilian c23s002_Lugagge_8c11638b:

    # mc "Espera. ¿Has dicho una de las maletas? ¿Cuántas lleva?"
    mc "Espere. Você disse uma das malas? Quantas ela tem?"

# game/scripts/c23/c23.rpy:833
translate brazilian c23s002_Lugagge_275536a9:

    # mom "La he visto subir con dos maletas del sótano."
    mom "Eu a vi subir do porão com duas malas."

# game/scripts/c23/c23.rpy:834
translate brazilian c23s002_Lugagge_2b7ff2c2:

    # mc "¿Para una noche?"
    mc "Por uma noite?"

# game/scripts/c23/c23.rpy:836
translate brazilian c23s002_Lugagge_7c82fa6b:

    # mom "Es [emm]..."
    mom "É [emm]..."

# game/scripts/c23/c23.rpy:840
translate brazilian c23s002_Lugagge_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c23/c23.rpy:841
translate brazilian c23s002_Lugagge_fda8aa56:

    # emm "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    emm "*Pela porta* Sou eu. Posso entrar?"

# game/scripts/c23/c23.rpy:843
translate brazilian c23s002_Lugagge_4d601f0e_1:

    # mc "Sí, pasa."
    mc "Sim, acontece."

# game/scripts/c23/c23.rpy:845
translate brazilian c23s002_Lugagge_09daa09b:

    # emm "Mamá, ¿crees que esto será suficiente para mañana?"
    emm "Mãe, você acha que isso será suficiente para amanhã?"

# game/scripts/c23/c23.rpy:846
translate brazilian c23s002_Lugagge_50a76aac:

    # mc "¿Dónde crees que vas con eso, [emm]?"
    mc "Onde você pensa que quer chegar com isso, [emm]?"

# game/scripts/c23/c23.rpy:848
translate brazilian c23s002_Lugagge_bc6e01fa:

    # emm "Vamos al norte. Hará más frío que aquí, y ya sabes que yo tengo frío en seguida..."
    emm "Vamos para o norte. Vai estar mais frio do que aqui, e você sabe como eu sinto frio facilmente..."

# game/scripts/c23/c23.rpy:849
translate brazilian c23s002_Lugagge_9e86e008:

    # mc "Vamos 200 Km al norte. No nos vamos a Alaska..."
    mc "Vamos 200 km para o norte. Não vamos para o Alasca..."

# game/scripts/c23/c23.rpy:851
translate brazilian c23s002_Lugagge_b6d431b2:

    # mom "Te he dicho una chaqueta, [emm], no que te vistas de invierno."
    mom "Eu disse para você pegar uma jaqueta, [emm], não para se vestir para o inverno."

# game/scripts/c23/c23.rpy:853
translate brazilian c23s002_Lugagge_75c72859:

    # emm "Pero el Ferrarini será descapotable y hará frío..."
    emm "Mas o Ferrarini será conversível e estará frio..."

# game/scripts/c23/c23.rpy:854
translate brazilian c23s002_Lugagge_de0cbafe:

    # mc "No, [emm], el coche no es descapotable. Además, ¿crees que vas a poder conducir con eso puesto?"
    mc "Não, [emm], o carro não é conversível. Além disso, você acha que vai conseguir dirigir com isso?"

# game/scripts/c23/c23.rpy:856
translate brazilian c23s002_Lugagge_44c92de4:

    # emm "Tienes razón. Sería muy incómodo."
    emm "Você tem razão. Seria muito constrangedor."

# game/scripts/c23/c23.rpy:857
translate brazilian c23s002_Lugagge_e9df9ef7:

    # emm "Mamá, ¿me ayudas a escoger una chaqueta adecuada?"
    emm "Mãe, você pode me ajudar a escolher uma jaqueta adequada?"

# game/scripts/c23/c23.rpy:859
translate brazilian c23s002_Lugagge_a67edac7:

    # mom "Sí, te acompaño. Después tengo que ir a planchar. Deja un hueco en una de tus maletas para una camisa de [mc]."
    mom "Sim, eu vou com você. Depois eu tenho que passar a roupa. Deixe um espaço em uma das suas malas para uma camisa [mc]."

# game/scripts/c23/c23.rpy:864
translate brazilian c23s002_Lugagge_1cdac493:

    # mom "Hasta luego, [mc]."
    mom "Até logo, [mc]."

# game/scripts/c23/c23.rpy:869
translate brazilian c23s002_Lugagge_1f4e85f3:

    # emm "Te vemos luego. Voy a tener que añadir otra maleta por lo de tu camisa."
    emm "Até logo. Vou ter que levar mais uma mala por causa da sua camisa."

# game/scripts/c23/c23.rpy:871
translate brazilian c23s002_Lugagge_41c98829:

    # mcp "(¿Otra maleta por una camisa? Creo que es una excusa para poder llevarse más ropa.)"
    mcp "(Outra mala só para uma camisa? Acho que é uma desculpa para poder levar mais roupas.)"

# game/scripts/c23/c23.rpy:873
translate brazilian c23s002_Lugagge_884ef907:

    # mcp "(No me extrañaría que se llevara un traje de buzo por si hay una inundación. Mujeres...)"
    mcp "(Não me surpreenderia se ela tivesse trazido uma roupa de mergulho para o caso de uma enchente. Mulheres..."

# game/scripts/c23/c23.rpy:883
translate brazilian c23s002_NoPatty_21994c80:

    # "Cuando acabas de preparar la mochila, trabajas un rato en la contabilidad del dormitorio y después bajas a la cocina a comer algo."
    "Depois de terminar de arrumar sua mochila, você trabalha um pouco na contabilidade do dormitório e depois desce até a cozinha para comer alguma coisa."

# game/scripts/c23/c23.rpy:885
translate brazilian c23s002_NoPatty_1bf6c7ed:

    # "El trozo de pastel era demasiado pequeño."
    "O pedaço de bolo era pequeno demais."

# game/scripts/c23/c23.rpy:887
translate brazilian c23s002_NoPatty_3df9d16d:

    # "[nor] aparece al cabo de unos minutos."
    "[nor] aparece após alguns minutos."

# game/scripts/c23/c23.rpy:888
translate brazilian c23s002_NoPatty_77ad9ccc:

    # nor "Hola, [mc]. ¿No está [mar]?"
    nor "Olá, [mc]. Não está [mar] aí?"

# game/scripts/c23/c23.rpy:895
translate brazilian c23s002_NoPatty_b7d10e84:

    # mc "Hola, cielo."
    mc "Olá querido."

# game/scripts/c23/c23.rpy:897
translate brazilian c23s002_NoPatty_2f11503d:

    # mc "Hola, [Aunt!t][nor]."
    mc "Olá, [Aunt!t][nor]."

# game/scripts/c23/c23.rpy:898
translate brazilian c23s002_NoPatty_25f01a6b:

    # mc "Si no está en la habitación de [emm], está en el sótano, planchando. Se ha empeñado en que me lleve la camisa azul mañana a Monterey."
    mc "Se ela não estiver no quarto [emm], estará no porão, passando roupa. Ela insistiu que eu levasse a camisa azul para Monterey amanhã."

# game/scripts/c23/c23.rpy:899
translate brazilian c23s002_NoPatty_8c75a300:

    # mc "Ni que me fuera una semana. Si por ella fuera, me tendría que llevar tres maletas para pasar una noche fuera."
    mc "Não é como se eu fosse viajar por uma semana. Se dependesse dela, eu teria que levar três malas só para passar uma noite fora."

# game/scripts/c23/c23.rpy:901
translate brazilian c23s002_NoPatty_f4b434c3:

    # nor "Es que esa camisa te queda muy bien. Y nunca lo entenderás."
    nor "Essa camisa fica ótima em você. E você nunca vai entender."

# game/scripts/c23/c23.rpy:902
translate brazilian c23s002_NoPatty_80f3e399:

    # nor "Las mujeres nos solemos llevar mucha ropa a cualquier sitio. *Risa* Casi puedo apostar a que [emm] va a llevar tres maletas."
    nor "As mulheres costumam levar muita roupa para onde quer que vão. *Risos* Eu quase apostaria que [emm] vai levar três malas."

# game/scripts/c23/c23.rpy:903
translate brazilian c23s002_NoPatty_3d0d59aa:

    # mc "*Risa* ¿Sólo tres? Ha dicho que iba a añadir otra maleta porque tenía que meter mi camisa."
    mc "*Risos* Só três? Ele disse que ia adicionar mais uma mala porque precisava colocar minha camisa na mala."

# game/scripts/c23/c23.rpy:904
translate brazilian c23s002_NoPatty_01cf69eb:

    # mc "No me extrañaría que cogiera una cuarta maleta para meter el secador y los artículos de higiene."
    mc "Não me surpreenderia se ele levasse uma quarta mala para levar o secador de cabelo e os artigos de higiene pessoal."

# game/scripts/c23/c23.rpy:905
translate brazilian c23s002_NoPatty_b1a3975c:

    # mc "Pero, ¿necesitabas algo? ¿Te puedo ayudar yo?"
    mc "Mas você precisava de alguma coisa? Posso ajudar?"

# game/scripts/c23/c23.rpy:907
translate brazilian c23s002_NoPatty_2fe2ba7a:

    # nor "No, no es nada importante. Me han escrito de la universidad diciendo que hay un cambio en las chicas que tenían que alojarse en mi casa."
    nor "Não, não é nada importante. Recebi um e-mail da universidade informando sobre uma mudança em relação às meninas que deveriam ficar na minha casa."

# game/scripts/c23/c23.rpy:908
translate brazilian c23s002_NoPatty_45117d09:

    # nor "Por lo visto, una de las chicas ha sido aceptada en otra universidad y no vendrá. Me han mandado la información de la chica que la sustituye."
    nor "Aparentemente, uma das meninas foi aceita em outra universidade e não virá. Recebi informações sobre a menina que a substituirá."

# game/scripts/c23/c23.rpy:910
translate brazilian c23s002_NoPatty_4f66f1fa:

    # nor "[mar] se ocupa de enviarles la documentación a las chicas nuevas. Era sólo para darle los datos."
    nor "[mar] Ela é responsável por enviar a documentação para as novas funcionárias. Era apenas para dar a ela os detalhes."

# game/scripts/c23/c23.rpy:911
translate brazilian c23s002_NoPatty_54c781da:

    # mc "Dámelos y se lo dejo en su habitación, si quieres."
