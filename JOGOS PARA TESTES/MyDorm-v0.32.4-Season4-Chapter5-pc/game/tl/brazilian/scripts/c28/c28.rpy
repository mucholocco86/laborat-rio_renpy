# game/scripts/c28/c28.rpy:1872
translate brazilian c28s004_MarRing_a9dd8262:

    # mom "Y ahora quiero un beso de mi marido."
    mom "E agora eu quero um beijo do meu marido."

# game/scripts/c28/c28.rpy:1874
translate brazilian c28s004_MarRing_6a440781:

    # "Vuestras bocas se vuelven a juntar, firmando con vuestros labios un inexistente papel que sella vuestro matrimonio."
