# game/scripts/c28/c28.rpy:2579
translate brazilian c28s004_LisaDress_92fcba97:

    # emm "Yo también. Es moderno, es sexy, y te queda genial. Los tíos van a tener problemas para apartar la mirada de ti."
    emm "Eu também. É moderno, é sexy e fica ótimo em você. Os caras vão ter dificuldade em tirar os olhos de você."

# game/scripts/c28/c28.rpy:2582
translate brazilian c28s004_LisaDress_836b36b5:

    # lis "El único tío que quiero que me mire es tu hermano."
    lis "O único cara que eu quero que olhe para mim é o seu irmão."

# game/scripts/c28/c28.rpy:2584
translate brazilian c28s004_LisaDress_5b7d5e0e:

