# game/scripts/c28/c28.rpy:2591
translate brazilian c28s004_LisaDress_950cc61d:

    # lis "Esperaba que le encontrarais pegas a todos los vestidos que me he probado."
    lis "Eu esperava que você encontrasse defeitos em todos os vestidos que experimentei."

# game/scripts/c28/c28.rpy:2593
translate brazilian c28s004_LisaDress_23d7c73e:

