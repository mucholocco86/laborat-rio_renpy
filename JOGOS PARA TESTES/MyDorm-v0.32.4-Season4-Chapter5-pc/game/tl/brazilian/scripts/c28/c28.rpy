    # "Al volver a casa, [eil] te dice que la entrevista de [sca] ha ido bien. Mañana le dirán algo sobre el trabajo."
    "Ao voltar para casa, [eil] lhe diz que a entrevista de [sca] correu bem. Eles receberão notícias sobre o emprego amanhã."

# game/scripts/c28/c28.rpy:1009
translate brazilian c28s001_noFoursome_21f6375b:

    # "Subes a tu habitación y juegas un rato a My Residence antes de cenar."
    "Você sobe para o seu quarto e joga My Residence por um tempo antes do jantar."

# game/scripts/c28/c28.rpy:1010
translate brazilian c28s001_noFoursome_b909fe44:

    # "Tienes una tórrida escena de sexo en grupo con Aishwarya, Alejandra, y Laoise."
    "Você tem uma cena de sexo em grupo bem quente com Aishwarya, Alejandra e Laoise."

# game/scripts/c28/c28.rpy:1011
translate brazilian c28s001_noFoursome_4aae1ba2:

    # "Aishwarya y Laoise no intentan sacarse los ojos la una a la otra."
    "Aishwarya e Laoise não estão tentando arrancar os olhos uma da outra."

# game/scripts/c28/c28.rpy:1012
translate brazilian c28s001_noFoursome_b52c336b:

    # "Laoise incluso acaba descubriendo que tiene cierta curiosidad por cómo sabe el coño de su amiga."
    "Laoise acaba descobrindo que tem certa curiosidade em saber qual é o gosto da vagina da amiga."

# game/scripts/c28/c28.rpy:1021
translate brazilian c28s002_Kim_0b13330a:

    # "Después de cenar, tras ayudar a [nor] a recoger la cocina, mientras vuelves hacia tu habitación..."
    "Depois do jantar, depois de ajudar a limpar a cozinha, enquanto você volta para o seu quarto..."

# game/scripts/c28/c28.rpy:1022
translate brazilian c28s002_Kim_a601a6ca:

    # mc "Hey, [kim]. ¿Qué haces aquí?"
    mc "Olá, [kim]. O que você está fazendo aqui?"

# game/scripts/c28/c28.rpy:1023
translate brazilian c28s002_Kim_2369d178:

    # kim "Estoy esperando a las chicas. Vamos a dar un paseo por la carretera para bajar la cena."
    kim "Estou esperando as meninas. Vamos dar uma caminhada pela estrada para ajudar na digestão do jantar."

# game/scripts/c28/c28.rpy:1024
translate brazilian c28s002_Kim_baebb2a0:

    # kim "Han ido a ponerse calzado cómodo."
    kim "Eles foram calçar sapatos confortáveis."

# game/scripts/c28/c28.rpy:1025
translate brazilian c28s002_Kim_28a0b0ab:

    # mc "¿Una nueva costumbre?"
    mc "Um novo costume?"

# game/scripts/c28/c28.rpy:1027
translate brazilian c28s002_Kim_d265cee6:

    # kim "*Risa* Todas nos hemos engordado un par de libras como mínimo desde que llegamos."
    kim "*Risos* Todos nós engordamos pelo menos um quilo desde que chegamos."

# game/scripts/c28/c28.rpy:1029
translate brazilian c28s002_Kim_8600849f:

    # kim "Todas menos [kat], claro."
    kim "Todos, exceto [kat], é claro."

# game/scripts/c28/c28.rpy:1030
translate brazilian c28s002_Kim_8149f8bb:

    # kim "Hoy hemos decidido que daremos un paseo cada noche. [kat] es la única que ha decidido no apuntarse."
    kim "Hoje decidimos que vamos dar um passeio todas as noites. [kat] é o único que decidiu não participar."

# game/scripts/c28/c28.rpy:1031
translate brazilian c28s002_Kim_5458bceb:

    # mc "*Risa* Comer todos los días la comida de [mar] y [nor] tiene efectos secundarios."
    mc "*Risos* Comer a comida de [mar] e [nor] todos os dias tem efeitos colaterais."

# game/scripts/c28/c28.rpy:1032
translate brazilian c28s002_Kim_95d5c3d9:

    # mc "Hablando de [kat], ¿sabes si está enfadada conmigo? Lleva evitándome desde la no-cita."
    mc "Por falar em [kat], você sabe se ela está brava comigo? Ela tem me evitado desde o encontro cancelado."

# game/scripts/c28/c28.rpy:1034
translate brazilian c28s002_Kim_c4248889:

    # kim "*Susurrando* Ahora no es un buen momento para hablar de eso, [mc]. Podría estar detrás de la puerta esperando al resto de las chicas."
    kim "*Sussurrando* Agora não é uma boa hora para falar sobre isso, [mc]. Ela pode estar atrás da porta esperando pelas outras garotas."

# game/scripts/c28/c28.rpy:1035
translate brazilian c28s002_Kim_7522274c:

    # mc "Eso que estás diciendo significa que algo pasa, ¿no?"
    mc "O que você está dizendo significa que algo está errado, certo?"

# game/scripts/c28/c28.rpy:1036
translate brazilian c28s002_Kim_20e20485:

    # kim "*Susurrando* Sí, pero será mejor que lo hablemos mañana."
    kim "*Sussurrando* Sim, mas é melhor conversarmos sobre isso amanhã."

# game/scripts/c28/c28.rpy:1037
translate brazilian c28s002_Kim_f5271567:

    # mc "Me parece una buena idea."
    mc "Acho que é uma boa ideia."

# game/scripts/c28/c28.rpy:1041
translate brazilian c28s002_Kim_99ac3d3d:

    # kim "Cambiando de tema, te invito a comer el viernes. Acabo las clases a mediodía y podríamos hacer algo."
    kim "Mudando de assunto, gostaria de te convidar para almoçar na sexta-feira. Minhas aulas terminam ao meio-dia, e poderíamos fazer algo juntos."

# game/scripts/c28/c28.rpy:1042
translate brazilian c28s002_Kim_2b1b6541:

    # mc "¿Algo en plan cita?"
    mc "Algo como um encontro?"

# game/scripts/c28/c28.rpy:1044
translate brazilian c28s002_Kim_1f428758:

    # kim "Yo había pensado en algo más informal que una cita."
    kim "Eu tinha pensado em algo mais informal do que um encontro romântico."

# game/scripts/c28/c28.rpy:1045
translate brazilian c28s002_Kim_02857be4:

    # kim "Después de lo que pasó en el barco de Iron Fist, creo que invertir parte de mi sueldo de esa noche en invitarte a comer estaría bien."
    kim "Depois do que aconteceu na nave Punho de Ferro, acho que investir parte do meu salário naquela noite para te levar para jantar seria uma boa ideia."

# game/scripts/c28/c28.rpy:1046
translate brazilian c28s002_Kim_0ccde321:

    # mc "Sabes que no hace falta, ¿verdad?"
    mc "Você sabe que não é necessário, né?"

# game/scripts/c28/c28.rpy:1048
translate brazilian c28s002_Kim_5ea97489:

    # kim "Lo sé, pero quiero hacerlo. Cuesta tanto tener tiempo a solas contigo..."
    kim "Eu sei, mas eu quero. É tão difícil encontrar um tempo a sós com você..."

# game/scripts/c28/c28.rpy:1049
translate brazilian c28s002_Kim_a2c86fb5:

    # mc "Lo siento, [kim]. Últimamente he estado muy ocupado preparando el viaje a Aruba."
    mc "Desculpe, [kim]. Tenho estado muito ocupado ultimamente preparando a viagem para Aruba."

# game/scripts/c28/c28.rpy:1050
translate brazilian c28s002_Kim_9fafd7cd:

    # mc "Me da la impresión de que me paso el día leyendo informes."
    mc "Tenho a impressão de que passo o dia todo lendo relatórios."

# game/scripts/c28/c28.rpy:1052
translate brazilian c28s002_Kim_a1ae8809:

    # kim "Entonces, ¿eso es un sí?"
    kim "Então, isso é um sim?"

# game/scripts/c28/c28.rpy:1053
translate brazilian c28s002_Kim_7eb31e98:

    # mc "Sí, claro que es un sí. ¿Quieres que busque algún sitio para ir a comer?"
    mc "Sim, claro que sim. Quer que eu encontre um lugar para comermos?"

# game/scripts/c28/c28.rpy:1055
translate brazilian c28s002_Kim_a57b7044:

    # "La preciosa modelo te besa con alegría. Aquella noche en el barco de Iron Fist cambió muchas cosas en ella."
    "A bela modelo te beija alegremente. Aquela noite no barco do Punho de Ferro mudou muita coisa para ela."

# game/scripts/c28/c28.rpy:1056
translate brazilian c28s002_Kim_f3f74e1c:

    # "Le dio una seguridad en sí misma que no tenía anteriormente. La [kim] de antes no hubiera tomado la iniciativa para invitarte a comer."
    "Isso lhe deu uma autoconfiança que ela não tinha antes. A antiga ela não teria tomado a iniciativa de te convidar para almoçar."

# game/scripts/c28/c28.rpy:1057
translate brazilian c28s002_Kim_4fb211f3:

    # "Si no odiaras tanto a Ichigo, casi le tendrías que estar agradecido."
    "Se você não odiasse tanto o Ichigo, quase teria que ser grato a ele."

# game/scripts/c28/c28.rpy:1059
translate brazilian c28s002_Kim_34de37af:

    # kim "Invito yo, con lo que buscaré algún sitio. No es una cita, no va a ser ningún sitio romántico ni nada por el estilo."
    kim "Eu pago, então vou encontrar um lugar. Não é um encontro, não vai ser nada romântico nem nada do tipo."

# game/scripts/c28/c28.rpy:1060
translate brazilian c28s002_Kim_9e8ff537:

    # kim "Sólo quiero pasar un rato a solas con mi novio."
    kim "Só quero passar um tempo a sós com meu namorado."

# game/scripts/c28/c28.rpy:1061
translate brazilian c28s002_Kim_1c55f897:

    # mc "Me parece una idea estupenda."
    mc "Acho que é uma ótima ideia."

# game/scripts/c28/c28.rpy:1063
translate brazilian c28s002_Kim_6486bfca:

    # kim "Cuando lo tenga decidido te aviso, no sea que no te guste el sitio..."
    kim "Eu te aviso quando me decidir, caso você não goste do lugar..."

# game/scripts/c28/c28.rpy:1064
translate brazilian c28s002_Kim_1e31a2ef:

    # mc "No te preocupes, mientras tengan un plato sin brócoli no va a haber ningún problema."
    mc "Não se preocupe, desde que haja um prato sem brócolis, não haverá problema algum."

# game/scripts/c28/c28.rpy:1066
translate brazilian c28s002_Kim_2d7d5ca4:

    # kim "*Risa* ¿Incluso si el único plato sin brócoli es una pizza con piña?"
    kim "*Risos* Mesmo que o único prato sem brócolis seja uma pizza de abacaxi?"

# game/scripts/c28/c28.rpy:1067
translate brazilian c28s002_Kim_2e988f6a:

    # mc "No voy a responder a esa pregunta. *Risa* Ese tema podría ser motivo de ruptura para algunas parejas."
    mc "Não vou responder a essa pergunta. *Risos* Esse assunto poderia ser motivo para alguns casais terminarem seus relacionamentos."

# game/scripts/c28/c28.rpy:1069
translate brazilian c28s002_Kim_44a29aed:

    # kim "Si sirve de algo, nunca la pediría, pero no tengo ningún problema en comerla si es una pizza para compartir."
    kim "Se isso ajudar, eu jamais pediria, mas não teria problema nenhum em comer se fosse uma pizza para dividir."

# game/scripts/c28/c28.rpy:1070
translate brazilian c28s002_Kim_51d374a2:

    # kim "No es mi favorita ni mucho menos, pero no me resulta desagradable."
    kim "Não é o meu favorito, de forma alguma, mas não o acho desagradável."

# game/scripts/c28/c28.rpy:1071
translate brazilian c28s002_Kim_d605a170:

    # kim "La que no soporto es la pizza con kiwi."
    kim "A única que eu não suporto é pizza com kiwi."

# game/scripts/c28/c28.rpy:1072
translate brazilian c28s002_Kim_2262a25d:

    # mc "*Risa* Creo que el tipo que inventó la pizza con kiwi quería convertirse en el más odiado de la humanidad. Por suerte, no se ha hecho popular."
    mc "*Risos* Acho que o cara que inventou a pizza de kiwi queria se tornar a pessoa mais odiada da Terra. Felizmente, a ideia não pegou."

# game/scripts/c28/c28.rpy:1074
translate brazilian c28s002_Kim_a58eff80:

    # kim "¿Cuánto se puede tardar en cambiarse de zapatos?"
    kim "Quanto tempo leva para trocar de sapatos?"

# game/scripts/c28/c28.rpy:1076
translate brazilian c28s002_Kim_868fb842:

    # mc "*Risa* Para querer pasar tiempo a solas conmigo, tienes muchas ganas de irte con las chicas ahora que estamos a solas..."
    mc "*Risos* Para alguém que quer passar um tempo a sós comigo, você está bem ansioso para sair com as amigas agora que estamos sozinhos..."

# game/scripts/c28/c28.rpy:1078
translate brazilian c28s002_Kim_e9cd26e9:

    # mc "*Risa* Pareces un chico esperando a su cita."
    mc "*Risos* Você parece um cara esperando o encontro."

# game/scripts/c28/c28.rpy:1080
translate brazilian c28s002_Kim_519db893:

    # kim "¡Oh! *Risa* ¡No lo decía por eso! Es que a veces entiendo cuando los chicos os quejáis de lo que tardamos las mujeres en estar listas."
    kim "Ah! *Risos* Não quis dizer isso! É só que às vezes eu entendo quando os caras reclamam de quanto tempo nós, mulheres, demoramos para nos arrumar."

# game/scripts/c28/c28.rpy:1081
translate brazilian c28s002_Kim_698a2f68:

    # kim "¡Es sólo cambiarse unos zapatos! ¡No tienen que maquillarse ni probarse ropa nueva!"
    kim "É só uma questão de trocar de sapatos! Elas não precisam se maquiar nem experimentar roupas novas!"

# game/scripts/c28/c28.rpy:1082
translate brazilian c28s002_Kim_1dc34f98:

    # mc "*Risa* Bienvenida al mundo de los hombres."
    mc "*Risos* Bem-vindo ao mundo dos homens."

# game/scripts/c28/c28.rpy:1085
translate brazilian c28s002_Kim_63bcf9a3:

    # "En ese momento se abre la puerta."
    "Nesse instante a porta se abre."

# game/scripts/c28/c28.rpy:1087
translate brazilian c28s002_Kim_a363811b:

    # deb "¿De qué os estáis riendo?"
    deb "Do que você está rindo?"

# game/scripts/c28/c28.rpy:1088
translate brazilian c28s002_Kim_31a04b39:

    # mc "Mejor no lo quieras saber. *Risa*"
    mc "É melhor você não saber. *Risos*"

# game/scripts/c28/c28.rpy:1089
translate brazilian c28s002_Kim_bc69fc2c:

    # lis "No hemos tardado mucho, ¿verdad?"
    lis "Não demoramos muito, não é?"

# game/scripts/c28/c28.rpy:1090
translate brazilian c28s002_Kim_c93c4533:

    # kim "Precisamente de eso nos estábamos riendo."
    kim "Era exatamente disso que estávamos rindo."

# game/scripts/c28/c28.rpy:1091
translate brazilian c28s002_Kim_f3d65716:

    # sai "[lis] ha tenido que ir al lavabo."
    sai "[lis] teve que ir ao banheiro."

# game/scripts/c28/c28.rpy:1093
translate brazilian c28s002_Kim_5c6e4704:

    # lis "¡[sai]!"
    lis "[sai]!"

# game/scripts/c28/c28.rpy:1094
translate brazilian c28s002_Kim_dbc76063:

    # sai "¿Qué? Podías haber ido a lavarte los dientes. Yo lo he hecho mientras te esperábamos."
    sai "O quê? Você podia ter ido escovar os dentes. Eu escovei enquanto esperávamos por você."

# game/scripts/c28/c28.rpy:1095
translate brazilian c28s002_Kim_b0ef1f77:

    # sai "*Risa* Ahora todo el mundo sabe a lo que has ido."
    sai "*Risos* Agora todos sabem o que você veio fazer."

# game/scripts/c28/c28.rpy:1096
translate brazilian c28s002_Kim_a329b8df:

    # deb "[lis] cree que el resto de los mortales pensamos que las princesas no cagan. *Risa*"
    deb "[lis] acha que nós, meros mortais, acreditamos que princesas não fazem cocô. *Risos*"

# game/scripts/c28/c28.rpy:1097
translate brazilian c28s002_Kim_0feba2ca:

    # lis "¡[deb.nick]!"
    lis "[deb.nick]!"

# game/scripts/c28/c28.rpy:1098
translate brazilian c28s002_Kim_b44f5814:

    # kim "Chicas, vámonos antes de que acabemos de hacer la digestión... *Risa* Aunque [lis] parece que ya la ha hecho."
    kim "Meninas, vamos embora antes que a digestão termine... *Risos* Embora [lis] pareça já ter sido digerida."

# game/scripts/c28/c28.rpy:1100
translate brazilian c28s002_Kim_0e50168c:

    # lis "*Risa* ¡Os odio!"
    lis "*Risos* Eu odeio todos vocês!"

# game/scripts/c28/c28.rpy:1101
translate brazilian c28s002_Kim_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c28/c28.rpy:1102
translate brazilian c28s002_Kim_8489236f:

    # mc "Que vaya bien el paseo, chicas."
    mc "Tenham uma boa caminhada, meninas."

# game/scripts/c28/c28.rpy:1104
translate brazilian c28s002_Kim_383cd8ec:

    # todas "Hasta mañana, [mc]."
    todas "Até amanhã, [mc]."

# game/scripts/c28/c28.rpy:1106
translate brazilian c28s002_Kim_d9a16ac4:

    # "Te sientes tentado de llamar a la puerta de la habitación que [kim] y [kat] comparten aprovechando que estará sola."
    "Você sente vontade de bater na porta do quarto que [kim] e [kat] compartilham, aproveitando-se do fato de que estará vazio."

# game/scripts/c28/c28.rpy:1108
translate brazilian c28s002_Kim_30fa4e80:

    # "Lo piensas mejor y decides esperar a tener toda la información después de hablar con [kim] mañana."
    "Você pensa sobre isso e decide esperar até ter todas as informações depois de falar com [kim] amanhã."

# game/scripts/c28/c28.rpy:1115
translate brazilian c28s002_SimGrateful_f1bce70a:

    # "Al llegar a tu habitación..."
    "Ao chegar ao seu quarto..."

# game/scripts/c28/c28.rpy:1117
translate brazilian c28s002_SimGrateful_a23925e4:

    # mc "Hola, [sim]. ¿Puedo ayudarte en algo?"
    mc "Olá, [sim]. Posso te ajudar em alguma coisa?"

# game/scripts/c28/c28.rpy:1118
translate brazilian c28s002_SimGrateful_ee2bcfe1:

    # sim "Venía tan solo a darte las gracias por lo que hicisteis [ama] y tú."
    sim "Eu só vim agradecer pelo que você e eu fizemos."

# game/scripts/c28/c28.rpy:1119
translate brazilian c28s002_SimGrateful_d0655e4f:

    # mc "Yo no tuve nada que ver, [sim]. Fue idea de [ama]. Yo solo firmé el papeleo."
    mc "Eu não tive nada a ver com isso, [sim]. Foi ideia de [ama]. Eu apenas assinei a papelada."

# game/scripts/c28/c28.rpy:1121
translate brazilian c28s002_SimGrateful_99b3a6e2:

    # sim "Bueno, si no lo hubieras firmado, [ama] no podría haberlo hecho."
    sim "Bem, se você não tivesse assinado, eu não teria conseguido fazer isso."

# game/scripts/c28/c28.rpy:1122
translate brazilian c28s002_SimGrateful_5a69f4be:

    # mc "Estoy seguro de que hubiera encontrado la manera de hacerlo. Se preocupa mucho por todas vosotras."
    mc "Tenho certeza de que ela teria encontrado um jeito de fazer isso. Ela se importa muito com todos vocês."

# game/scripts/c28/c28.rpy:1124
translate brazilian c28s002_SimGrateful_8d200725:

    # sim "¿Puedo decirte una cosa? Llevo desde el cumpleaños de las chicas queriéndome quitar el peso de encima..."
    sim "Posso te contar uma coisa? Desde o aniversário das meninas, tenho desejado me livrar desse peso..."

# game/scripts/c28/c28.rpy:1125
translate brazilian c28s002_SimGrateful_57496572:

    # mc "Lo que quieras. ¿Es tan grave?"
    mc "O que você quiser. É tão sério assim?"

# game/scripts/c28/c28.rpy:1127
translate brazilian c28s002_SimGrateful_7b7ac8ea:

    # sim "No sé si es grave. Y decírtelo ahora puede parecer que es por las razones equivocadas, pero me siento súper culpable..."
    sim "Não sei se é sério. E contar isso agora pode parecer que é pelos motivos errados, mas me sinto extremamente culpado..."

# game/scripts/c28/c28.rpy:1128
translate brazilian c28s002_SimGrateful_4bfa24fc:

    # mc "¿Qué has hecho para sentirte culpable, [sim]?"
    mc "O que você fez para se sentir culpado, [sim]?"

# game/scripts/c28/c28.rpy:1129
translate brazilian c28s002_SimGrateful_270232c0:

    # mc "¿Tiene algo que ver con la beca?"
    mc "Isso tem alguma relação com a bolsa de estudos?"

# game/scripts/c28/c28.rpy:1131
translate brazilian c28s002_SimGrateful_89f00b40:

    # sim "No, no. No tiene nada que ver con la beca... Tiene que ver con [ama] y [eva]..."
    sim "Não, não. Não tem nada a ver com a bolsa de estudos... Tem a ver com [ama] e [eva]..."

# game/scripts/c28/c28.rpy:1132
translate brazilian c28s002_SimGrateful_80a5b1ff:

    # mc "¿Qué pasa con ellas? ¿Han hecho algo? Me estás empezando a preocupar."
    mc "O que há de errado com eles? Será que fizeram alguma coisa? Você está começando a me preocupar."

# game/scripts/c28/c28.rpy:1134
translate brazilian c28s002_SimGrateful_e047aac5:

    # sim "No han sido ellas. Fui yo..."
    sim "Não foram eles. Fui eu..."

# game/scripts/c28/c28.rpy:1135
translate brazilian c28s002_SimGrateful_9157256e:

    # mc "¿Qué hiciste?"
    mc "O que você fez?"

# game/scripts/c28/c28.rpy:1136
translate brazilian c28s002_SimGrateful_ea60ddee:

    # sim "Las prejuzgue. Cuando mi madre me habló de ellas por primera vez... No me parecía normal. Ni siquiera bien."
    sim "Eu os julguei. Quando minha mãe me contou sobre eles pela primeira vez... Não me pareceu normal. Nem mesmo bom."

# game/scripts/c28/c28.rpy:1138
translate brazilian c28s002_SimGrateful_2a226678:

    # sim "Clones de mis amigas, unas asesinas, se iban a unir a la familia..."
    sim "Clones dos meus amigos, alguns deles assassinos, iriam se juntar à família..."

# game/scripts/c28/c28.rpy:1140
translate brazilian c28s002_SimGrateful_7d71f376:

    # sim "Mis amigas eran clones y ahora las chicas de las que eran clones, unas asesinas, se iban a unir a la familia..."
    sim "Meus amigos eram clones, e agora as garotas que eram clones deles — assassinas — iriam se juntar à família..."

# game/scripts/c28/c28.rpy:1141
translate brazilian c28s002_SimGrateful_abe41cd3:

    # sim "No era natural... No quería ni tan solo conocerlas..."
    sim "Não foi natural... Eu nem queria conhecê-los..."

# game/scripts/c28/c28.rpy:1142
translate brazilian c28s002_SimGrateful_2a819095:

