    mc "Mãe, você quer casar comigo?"

# game/scripts/c28/c28.rpy:1815
translate brazilian c28s004_MarRing_dc36e98d:

    # mc "[mar], ¿quieres casarte conmigo?"
    mc "[mar], você quer casar comigo?"

# game/scripts/c28/c28.rpy:1816
translate brazilian c28s004_MarRing_ae28c731:

    # mom "*Risa* ¿Con un dónut?"
    mom "*Risos* Com um donut?"

# game/scripts/c28/c28.rpy:1817
translate brazilian c28s004_MarRing_d0b2d4b6:

    # mc "Es lo más parecido a un anillo que hay por aquí."
    mc "É o mais próximo que temos de um anel por aqui."

# game/scripts/c28/c28.rpy:1819
translate brazilian c28s004_MarRing_d475fd83:

    # mc "Y sabes que lo del anillo de pedida estándar no es lo mío."
    mc "E você sabe que o anel de noivado tradicional não faz meu estilo."

# game/scripts/c28/c28.rpy:1821
translate brazilian c28s004_MarRing_83e67ee9:

    # mom "¿Lo estás diciendo en serio?"
    mom "Você está falando sério?"

# game/scripts/c28/c28.rpy:1822
translate brazilian c28s004_MarRing_6df32d16:

    # mc "Claro que sí. *Risa* Y espero una respuesta antes de que me empiece a doler la rodilla."
    mc "Claro. *Risos* E estou esperando uma resposta antes que meu joelho comece a doer."

# game/scripts/c28/c28.rpy:1824
translate brazilian c28s004_MarRing_3cd6e880:

    # mom "¡Por supuesto que sí!"
    mom "Claro!"

# game/scripts/c28/c28.rpy:1826
translate brazilian c28s004_MarRing_20bf0c63:

    # "Os lanzáis a los brazos del otro, vuestros labios buscándose para decirse cosas que las palabras no pueden expresar."
    "Vocês se atiram nos braços um do outro, seus lábios buscando um ao outro para dizer coisas que as palavras não conseguem expressar."

# game/scripts/c28/c28.rpy:1827
translate brazilian c28s004_MarRing_255cbd0e:

    # "Hay alegría en el beso. Hay esperanza. Hay ilusión."
    "Há alegria no beijo. Há esperança. Há entusiasmo."

# game/scripts/c28/c28.rpy:1828
translate brazilian c28s004_MarRing_6a01473b:

    # "Hay falta de aire."
    "Há falta de ar."

# game/scripts/c28/c28.rpy:1830
translate brazilian c28s004_MarRing_b756b8bf:

    # "Todo lo bueno acaba, y os separáis reluctantemente."
    "Tudo que é bom chega ao fim, e vocês se separam com relutância."

# game/scripts/c28/c28.rpy:1831
translate brazilian c28s004_MarRing_ef2ec1fb:

    # mom "¡Estás loco!"
    mom "Você está louco!"

# game/scripts/c28/c28.rpy:1832
translate brazilian c28s004_MarRing_13774f81:

    # mc "Si yo estoy loco por proponerlo, tu debes estar loca por aceptarlo."
    mc "Se eu sou louco por sugerir isso, você deve ser louco por aceitar."

# game/scripts/c28/c28.rpy:1833
translate brazilian c28s004_MarRing_8695eeb7:

    # mom "Estaría loca si no lo hubiera hecho."
    mom "Eu seria louco se não o tivesse feito."

# game/scripts/c28/c28.rpy:1835
translate brazilian c28s004_MarRing_d8cc5272:

    # mom "*Risa* Pero la mayoría de gente hace esto durante una cita o algo por el estilo."
    mom "*Risos* Mas a maioria das pessoas faz isso durante um encontro ou algo do tipo."

# game/scripts/c28/c28.rpy:1836
translate brazilian c28s004_MarRing_701f34e6:

    # mc "*Risa* Y la mayoría de gente hace esto sin un dónut. No saben lo que se pierden."
    mc "*Risos* E a maioria das pessoas faz isso sem um donut. Elas não sabem o que estão perdendo."

# game/scripts/c28/c28.rpy:1837
translate brazilian c28s004_MarRing_6f370b72:

    # mc "Además, aunque me encantan las citas contigo, no creo que necesitemos seguir los protocolos. Me parecía natural pedírtelo ahora."
    mc "Além disso, mesmo adorando sair com você, não acho que precisamos seguir nenhum protocolo. Simplesmente me pareceu natural te perguntar agora."

# game/scripts/c28/c28.rpy:1839
translate brazilian c28s004_MarRing_2d9ac8e8:

    # mom "Natural e inesperado. Pero tienes razón, prefiero esto aquí que en un restaurante rodeados de gente que se pongan a grabar con los móviles." id c28s004_MarRing_2d9ac8e8
    mom "Natural e inesperado. Mas você tem razão, prefiro isso aqui do que estar em um restaurante cercado de pessoas filmando com seus celulares." id c28s004_MarRing_2d9ac8e8

# game/scripts/c28/c28.rpy:1840
translate brazilian c28s004_MarRing_222a6658:

    # mom "Es más natural. Más... nuestro."
    mom "É mais natural. Mais... nosso."

# game/scripts/c28/c28.rpy:1842
translate brazilian c28s004_MarRing_cdc1e113:

    # mom "¡[mc]! ¡Ni se te ocurra comerte mi anillo de compromiso!"
    mom "[mc]! Nem pense em comer meu anel de noivado!"

# game/scripts/c28/c28.rpy:1844
translate brazilian c28s004_MarRing_16f794c4:

    # mc "Perdón, es la costumbre. *Risa* ¿Te lo vas a poner?"
    mc "Desculpe, é só um hábito. *Risos* Você vai usar?"

# game/scripts/c28/c28.rpy:1845
translate brazilian c28s004_MarRing_52819b83:

    # mom "No me cabría en el dedo y se acabaría rompiendo, pero voy a conservar ese dónut para siempre."
    mom "Não caberia no meu dedo e acabaria quebrando, mas vou guardar esse donut para sempre."

# game/scripts/c28/c28.rpy:1846
translate brazilian c28s004_MarRing_48a3ca86:

    # mc "¿Lo vas a congelar?"
    mc "Você vai congelá-lo?"

# game/scripts/c28/c28.rpy:1847
translate brazilian c28s004_MarRing_f3889dec:

    # mom "Algo se me ocurrirá."
    mom "Vou pensar em algo."

# game/scripts/c28/c28.rpy:1850
translate brazilian c28s004_MarRing_60d80fb4:

    # mom "Pero sabes que no nos vamos a poder casar nunca, ¿verdad?"
