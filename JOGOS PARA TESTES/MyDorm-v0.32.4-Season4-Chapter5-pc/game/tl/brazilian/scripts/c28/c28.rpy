# game/scripts/c28/c28.rpy:3629
translate brazilian c28s002_Kat_25560176:

    # kat "He descubierto que lo que estaba sintiendo es que puedo confiar en ti y estar confortable a tu lado..."
    kat "Descobri que o que eu estava sentindo era que posso confiar em você e me sentir confortável ao seu lado..."

# game/scripts/c28/c28.rpy:3630
translate brazilian c28s002_Kat_69752053:

    # kat "No estoy acostumbrada a sentirme así cerca de un tío, y... No sé... Creía que lo estaba confundiendo con otra cosa."
    kat "Não estou acostumada a me sentir assim perto de um cara, e... sei lá... achei que estava confundindo ele com outra coisa."

# game/scripts/c28/c28.rpy:3631
translate brazilian c28s002_Kat_5648fd32_1:

    # mc "Y por eso me estabas esquivando. Necesitabas aclarar tus ideas."
    mc "E foi por isso que você estava me evitando. Você precisava espairecer."

# game/scripts/c28/c28.rpy:3632
translate brazilian c28s002_Kat_3e2a17ba:

    # mc "Pero podíamos haberlo hablado..."
    mc "Mas poderíamos ter conversado sobre isso..."

# game/scripts/c28/c28.rpy:3634
translate brazilian c28s002_Kat_900b1acb_1:

    # kat "*Risa* Eres un jodido caballero de la brillante armadura siempre buscando damiselas que salvar."
    kat "*Risos* Você é um verdadeiro cavaleiro de armadura brilhante, sempre à procura de donzelas para salvar."

# game/scripts/c28/c28.rpy:3635
translate brazilian c28s002_Kat_82e50f83:

    # mc "*Risa* Me lo han dicho alguna vez."
    mc "*Risos* Já me disseram isso antes."

# game/scripts/c28/c28.rpy:3637
translate brazilian c28s002_Kat_d52a721e:

    # kat "No necesitaba que me salvaran. Necesitaba aclararme."
    kat "Eu não precisava ser salvo. Eu precisava clarear a mente."

# game/scripts/c28/c28.rpy:3638
translate brazilian c28s002_Kat_a8b660ce_1:

    # kat "Si no te hubiera estado esquivando estos últimos dos días, seguro que hubieras venido en plan caballero salvador."
    kat "Se eu não tivesse te evitado nesses últimos dois dias, tenho certeza de que você teria aparecido como um cavaleiro de armadura brilhante."

# game/scripts/c28/c28.rpy:3639
translate brazilian c28s002_Kat_1c273892_1:

    # kat "Yo, estando confundida como estaba, seguramente hubiera caído en tus brazos sin remedio y..."
    kat "Em meu estado de confusão, certamente teria me jogado em seus braços sem falta e..."

# game/scripts/c28/c28.rpy:3640
translate brazilian c28s002_Kat_5b8669da:

    # mc "Y después te hubieras arrepentido..."
    mc "E então você teria se arrependido..."

# game/scripts/c28/c28.rpy:3642
translate brazilian c28s002_Kat_2f796d27:

    # kat "¿Has oído hablar del multiverso y los universos paralelos?"
    kat "Você já ouviu falar em multiverso e universos paralelos?"

# game/scripts/c28/c28.rpy:3643
translate brazilian c28s002_Kat_652a0f09:

    # kat "¿Sabes que, si esa teoría es cierta, hay un universo en el que tenemos esta conversación, pero estamos en un árbol en vez de en una piscina?"
    kat "Você sabia que, se essa teoria for verdadeira, existe um universo no qual teríamos essa conversa, mas estaríamos em uma árvore em vez de em uma piscina?"

# game/scripts/c28/c28.rpy:3644
translate brazilian c28s002_Kat_cd9c9111:

    # kat "En uno de esos universos, yo soy una ardilla y tú un loro."
    kat "Em um desses universos, eu sou um esquilo e você é um papagaio."

# game/scripts/c28/c28.rpy:3645
translate brazilian c28s002_Kat_4e37e471:

    # "El cambio de tema te pilla un poco a traspiés. Sabes que a [kat] no le gusta hablar de sus sentimientos, pero..."
    "A mudança de assunto te pega um pouco de surpresa. Você sabe que [kat] não gosta de falar sobre seus sentimentos, mas..."

# game/scripts/c28/c28.rpy:3646
translate brazilian c28s002_Kat_dfb67a9d:

    # mc "Sí, claro que he oído hablar de ello. He leído un montón de cómics sobre eso. Pero ¿a qué viene eso?"
    mc "Sim, claro que já ouvi falar. Li muitas histórias em quadrinhos sobre isso. Mas qual é o objetivo disso?"

# game/scripts/c28/c28.rpy:3648
translate brazilian c28s002_Kat_da923084:

    # kat "Pues que, en algunos de esos universos paralelos, no soy una ardilla, pero tampoco soy una lesbiana idiota que no sabe lo que quiere."
    kat "Bem, em alguns desses universos paralelos, eu não sou um esquilo, mas também não sou uma lésbica idiota que não sabe o que quer."

# game/scripts/c28/c28.rpy:3649
translate brazilian c28s002_Kat_bf5909b5:

    # kat "Y, en al menos uno de esos universos, tú me estas besando en este mismo momento."
    kat "E, em pelo menos um desses universos, você está me beijando agora mesmo."

# game/scripts/c28/c28.rpy:3663
translate brazilian c28s002_Kat_6ccbac6e_1:

    # "*Splash*"
    "*Splash*"

# game/scripts/c28/c28.rpy:3666
translate brazilian c28s002_Kat_0c1b889f_1:

    # kat "¿Qué haces? ¿Por qué te has metido en el agua ahora?"
    kat "O que você está fazendo? Por que entrou na água agora?"

# game/scripts/c28/c28.rpy:3667
translate brazilian c28s002_Kat_d53b75e3:

    # mc "Siento mucho que este no sea ese universo, [kat]."
    mc "Sinto muito que este não seja aquele universo, [kat]."

# game/scripts/c28/c28.rpy:3669
translate brazilian c28s002_Kat_d36a0aee:

    # kat "¿Ves? No debería haber hablado de esto contigo. Ahora me siento idiota."
    kat "Viu? Eu não devia ter falado disso com você. Agora me sinto um idiota."

# game/scripts/c28/c28.rpy:3675
translate brazilian c28s002_Kat_4138c944:

    # kat "*Risa* Capullo. Abrázame fuerte y calla."
    kat "*Risos* Idiota. Me abrace forte e cale a boca."

# game/scripts/c28/c28.rpy:3677
translate brazilian c28s002_Kat_d8fd6742:

    # kat "Al menos hasta que te tengas que ir a cambiar para la cita con [lis]."
    kat "Pelo menos até você ter que se trocar para o seu encontro com [lis]."

# game/scripts/c28/c28.rpy:3680
translate brazilian c28s002_Kat_0da6717f:

    # "Alternáis besos y abrazos hasta que [sam], [nor], y [mar] hacen su aparición en la piscina."
    "Vocês alternam beijos e abraços até que [sam], [nor] e [mar] apareçam na piscina."

# game/scripts/c28/c28.rpy:3682
translate brazilian c28s002_Kat_49b771b1:

    # "Continuáis con los abrazos hasta que [sam], [nor], y [mar] hacen su aparición en la piscina."
    "Vocês continuam se abraçando até que [sam], [nor] e [mar] apareçam na piscina."

# game/scripts/c28/c28.rpy:3683
translate brazilian c28s002_Kat_5018881f:

    # "Os han dejado privacidad para arreglar las cosas, pero ellas también quieren su ración de sol y relax."
    "Eles te deram privacidade para resolver as coisas, mas também querem a sua parte de sol e relaxamento."

# game/scripts/c28/c28.rpy:3684
translate brazilian c28s002_Kat_d7138312:

    # "Su llegada marca el momento de dejarlas solas para que [kat] les explique cómo ha ido." id c28s002_Kat_d7138312
    "A chegada deles marca o momento de deixá-los sozinhos para que [kat] possa explicar como foi." id c28s002_Kat_d7138312

# game/scripts/c28/c28.rpy:3686
translate brazilian c28s002_Kat_f325572f:

    # "Vuelves a tu habitación para ducharte y prepararte para ir a buscar a [lis]."
    "Você volta para o seu quarto para tomar banho e se arrumar para ir encontrar [lis]."

# game/scripts/c28/c28.rpy:3688
translate brazilian c28s002_Kat_9ae976fc:

    # "Vuelves a tu habitación y te das una ducha antes de la cena."
    "Você volta para o seu quarto e toma um banho antes do jantar."

# game/scripts/c28/c28.rpy:3694
translate brazilian c28s002_noKatRoute_f8eea7ed:

    # mc "No debes sentirte idiota. Creo que los dos hemos malinterpretado lo que está pasando."
    mc "Você não deveria se sentir um idiota. Acho que nós dois interpretamos mal o que está acontecendo."

# game/scripts/c28/c28.rpy:3696
translate brazilian c28s002_noKatRoute_ecc5805c:

    # mc "Dices que crees que puedes confiar en mí y estar confortable a mi lado, y que no estás acostumbrada a eso con un tío."
    mc "Você diz que acha que pode confiar em mim e se sentir confortável perto de mim, e que não está acostumada a isso com um cara."

# game/scripts/c28/c28.rpy:3698
translate brazilian c28s002_noKatRoute_53a0381d:

    # kat "Es exactamente lo que he dicho..."
    kat "Foi exatamente isso que eu disse..."

# game/scripts/c28/c28.rpy:3699
translate brazilian c28s002_noKatRoute_493b7130:

    # mc "Pero fíjate que en ningún momento has hablado de que te sientas atraída por mí, o que sientas algo por mí aparte de sentirte a gusto a mi lado."
    mc "Mas repare que em nenhum momento você mencionou sentir-se atraído por mim, ou sentir qualquer coisa por mim além de se sentir confortável na minha presença."

# game/scripts/c28/c28.rpy:3700
translate brazilian c28s002_noKatRoute_ee1d92f6:

    # mc "Esa no es una base para empezar una relación, [kat]. Yo me siento a gusto al lado de Jamaal y confío en él, pero no empezaría una relación con él."
    mc "Isso não é base para começar um relacionamento, [kat]. Eu me sinto confortável com Jamaal e confio nele, mas eu não começaria um relacionamento com ele."

# game/scripts/c28/c28.rpy:3702
translate brazilian c28s002_noKatRoute_c9f88420:

    # kat "¿Quieres decir que estoy confundiendo descubrir que eres un buen tío con sentir algo por ti?"
    kat "Você quer dizer que estou confundindo descobrir que você é um cara legal com ter sentimentos por você?"

# game/scripts/c28/c28.rpy:3703
translate brazilian c28s002_noKatRoute_a6510c01:

    # mc "No soy yo quien tiene que ponerles nombre a tus sentimientos, [kat], pero sé que el tipo aquel en el instituto te hizo daño."
    mc "Não cabe a mim dar nome aos seus sentimentos, [kat], mas sei que aquele rapaz do ensino médio te magoou."

# game/scripts/c28/c28.rpy:3704
translate brazilian c28s002_noKatRoute_2816b3d2:

    # mc "Y que has evitado a los tíos como a la peste desde entonces."
    mc "E que, desde então, você evita homens como a peste."

# game/scripts/c28/c28.rpy:3705
translate brazilian c28s002_noKatRoute_42992cb5:

    # mc "Supongo que descubrir que hay un tío que no te va a hacer daño por nada del mundo puede ser confuso."
    mc "Imagino que descobrir que existe um cara que não te machucaria por nada neste mundo possa ser confuso."

# game/scripts/c28/c28.rpy:3707
translate brazilian c28s002_noKatRoute_d8ffb4b9:

    # kat "Es posible que tengas razón... Ahora que lo dices... nunca me he imaginado formando una familia contigo..."
    kat "Você pode ter razão... Agora que você mencionou... Nunca imaginei formar uma família com você..."

# game/scripts/c28/c28.rpy:3708
translate brazilian c28s002_noKatRoute_19019062:

    # mc "Ya hemos formado una familia juntos, [kat]. No es una familia tradicional, pero es una familia."
    mc "Nós já formamos uma família juntos, [kat]. Não é uma família tradicional, mas é uma família."

# game/scripts/c28/c28.rpy:3709
translate brazilian c28s002_noKatRoute_126d27c6:

    # kat "Quizás necesito más tiempo para analizar lo que siento desde esa nueva perspectiva..."
    kat "Talvez eu precise de mais tempo para analisar o que sinto a partir dessa nova perspectiva..."

# game/scripts/c28/c28.rpy:3710
translate brazilian c28s002_noKatRoute_25b97585:

    # kat "¿Me puedes dar un abrazo?"
    kat "Você pode me dar um abraço?"

# game/scripts/c28/c28.rpy:3712
translate brazilian c28s002_noKatRoute_c8d48a77:

    # mc "¿Amigos? Tómate el tiempo que quieras, pero no sigas evitándome. Eso no es lo que hacen los amigos."
    mc "Amigos? Podem levar todo o tempo que precisarem, mas parem de me evitar. Isso não é coisa de amigo."

# game/scripts/c28/c28.rpy:3713
translate brazilian c28s002_noKatRoute_9da8bdff:

    # kat "Siempre va bien tener un amigo que abraza de puta madre."
    kat "É sempre bom ter um amigo que dá abraços incríveis."

# game/scripts/c28/c28.rpy:3714
translate brazilian c28s002_noKatRoute_3a86be98:

    # kat "El día que una chica me deje, puedo venir a por un abrazo como este."
    kat "No dia em que uma garota terminar comigo, posso vir aqui e receber um abraço como este."

# game/scripts/c28/c28.rpy:3715
translate brazilian c28s002_noKatRoute_4277a1dc:

    # mc "*Risa* O el día que una beluga te llame prima."
    mc "*Risos* Ou o dia em que uma baleia beluga te chamar de primo(a)."

# game/scripts/c28/c28.rpy:3718
translate brazilian c28s002_KatRoute_a25d7a48:

    # mc "No debes sentirte idiota. El que debe sentirse idiota es nuestro universo, porque va con retraso."
    mc "Você não deveria se sentir um idiota. É o nosso universo que deveria se sentir um idiota, porque está atrasado."

# game/scripts/c28/c28.rpy:3721
translate brazilian c28s002_KatRoute_852b9800:

    # kat "¿Qué quieres decir?"
    kat "O que você quer dizer?"

# game/scripts/c28/c28.rpy:3722
translate brazilian c28s002_KatRoute_512f622f:

    # mc "Has dicho que en algún universo te estaba besando hace un minuto."
    mc "Você disse que em algum universo eu estava te beijando um minuto atrás."

# game/scripts/c28/c28.rpy:3724
translate brazilian c28s002_KatRoute_dafc7e8e:

    # "Sin dejarla responder, la coges entre tus brazos y le das un suave beso en los labios."
    "Sem deixar que ela responda, você a toma em seus braços e lhe dá um beijo suave nos lábios."

# game/scripts/c28/c28.rpy:3725
translate brazilian c28s002_KatRoute_28b23a47:

    # "La sorpresa se muestra en sus ojos. Tú no cierras los tuyos. No quieres perderte nada de vuestro primer beso."
    "A surpresa é evidente nos olhos dela. Você não fecha os seus. Não quer perder nenhum detalhe do seu primeiro beijo."

# game/scripts/c28/c28.rpy:3726
translate brazilian c28s002_KatRoute_a23e3bbd:

    # "Besarla es como besar a una estatua. Petrificada, sin mover un músculo. Por un momento piensas que incluso su corazón ha dejado de latir."
    "Beijá-la é como beijar uma estátua. Petrificada, sem mover um músculo. Por um instante, você pensa que até o coração dela parou de bater."

# game/scripts/c28/c28.rpy:3728
translate brazilian c28s002_KatRoute_8abebfe3:

    # "Pero [kat] no es una mujer que se deje sobrepasar por los acontecimientos y recupera el control de su cuerpo unos segundos después."
    "Mas [kat] não é uma mulher que se deixa dominar pelos acontecimentos e recupera o controle do seu corpo alguns segundos depois."

# game/scripts/c28/c28.rpy:3729
translate brazilian c28s002_KatRoute_a93a60a7:

    # "Cierra sus ojos y entreabre su boca, invitándote a entrar en ella por primera vez. No será la última."
    "Ela fecha os olhos e entreabre a boca, convidando você a entrar nela pela primeira vez. Não será a última."

# game/scripts/c28/c28.rpy:3730
translate brazilian c28s002_KatRoute_f25fd3ee:

    # "No te sorprende que sea una gran besadora. En un solo movimiento, mientras vuestras lenguas se entrelazan, hay tanta ternura como pasión y alivio."
    "Não é surpresa que ela seja uma ótima beijadora. Num único movimento, quando suas línguas se entrelaçam, há tanta ternura quanto paixão e alívio."

# game/scripts/c28/c28.rpy:3732
translate brazilian c28s002_KatRoute_fa5d6964:

    # "Al cabo de un segundo o de una hora, vuestros labios se separan mientras vuestras miradas se unen."
    "Depois de um segundo ou uma hora, seus lábios se separam quando seus olhares se encontram."

# game/scripts/c28/c28.rpy:3733
translate brazilian c28s002_KatRoute_a0f05d92:

    # kat "*Jadeo* ¿Qué ha sido eso, [mc]?"
    kat "*Gasp* O que foi isso, [mc]?"

# game/scripts/c28/c28.rpy:3734
translate brazilian c28s002_KatRoute_cf5a9bfc:

    # mc "La demostración de que nuestro universo no es idiota del todo y le gusta recuperar el tiempo perdido."
    mc "A prova de que o nosso universo não é totalmente idiota e gosta de recuperar o tempo perdido."

# game/scripts/c28/c28.rpy:3735
translate brazilian c28s002_KatRoute_2dd904ed:

    # kat "*Jadeo* ¿Significa eso que tú y yo...?"
    kat "*Gasp* Isso significa que você e eu...?"

# game/scripts/c28/c28.rpy:3736
translate brazilian c28s002_KatRoute_c1710d60:

    # mc "Significa que tú y yo nos hemos besado, sí."
    mc "Significa que você e eu nos beijamos, sim."

# game/scripts/c28/c28.rpy:3738
translate brazilian c28s002_KatRoute_0f6d8571:

    # kat "*Jadeo* Pero... ¿significa que tú y yo somos algo?"
    kat "*Suspiro* Mas... isso significa que você e eu somos algo?"

# game/scripts/c28/c28.rpy:3739
translate brazilian c28s002_KatRoute_562d7fd7:

    # mc "A mí me gusta pensar que soy algo. Una persona o algo así... Sobre ti... no estoy tan seguro. *Risa* Dudo entre persona y beluga."
    mc "Gosto de pensar que sou algo. Uma pessoa ou algo assim... Sobre você... Não tenho tanta certeza. *Risos* Estou dividido entre pessoa e baleia beluga."

# game/scripts/c28/c28.rpy:3741
translate brazilian c28s002_KatRoute_5926bcb6:

    # kat "*Risa* Eres un capullo."
    kat "*Risos* Você é um idiota."

# game/scripts/c28/c28.rpy:3742
translate brazilian c28s002_KatRoute_4263b3ab:

    # mc "*Risa* ¿Ves? Eso también es ser algo."
    mc "*Risos* Viu? Isso também é alguma coisa."

# game/scripts/c28/c28.rpy:3743
translate brazilian c28s002_KatRoute_4604e106:

    # mc "Pero si a lo que te refieres es a si estamos saliendo o algo así, la respuesta es no."
    mc "Mas se você está perguntando se estamos namorando ou algo do tipo, a resposta é não."

# game/scripts/c28/c28.rpy:3745
translate brazilian c28s002_KatRoute_45028e6c:

    # kat "¿Qué? Entonces ¿a qué ha venido ese beso?"
    kat "O quê? Então, o que foi aquele beijo?"

# game/scripts/c28/c28.rpy:3746
translate brazilian c28s002_KatRoute_79d2bde7:

    # mc "Ese beso ha venido a que me apetecía besarte. Y había un universo en el que ya te había besado."
    mc "Aquele beijo aconteceu porque eu queria te beijar. E existia um universo no qual eu já havia te beijado."

# game/scripts/c28/c28.rpy:3747
translate brazilian c28s002_KatRoute_0aef4e26:

    # mc "Pero has dicho que en otro universo no serías una lesbiana idiota. *Risa* Lo de idiota lo puedo aceptar, es parte de tu encanto."
    mc "Mas você disse que em outro universo você não seria uma lésbica burra. *Risos* Posso aceitar a parte da burrice, faz parte do seu charme."

# game/scripts/c28/c28.rpy:3748
translate brazilian c28s002_KatRoute_35efc722:

    # mc "Pero, hasta que no cambies 'lesbiana' por 'bisexual' o por 'hetero', no vamos a empezar a salir juntos."
    mc "Mas, enquanto não mudarmos 'lésbica' para 'bissexual' ou 'hetero', não vamos começar a namorar."

# game/scripts/c28/c28.rpy:3750
translate brazilian c28s002_KatRoute_70f5f845:

    # kat "*Risa* ¡Voy a salir con un idiota!"
    kat "*Risos* Estou saindo com um idiota!"

# game/scripts/c28/c28.rpy:3751
translate brazilian c28s002_KatRoute_da904e78:

    # mc "Sólo si lo cambias."
    mc "Só se você o alterar."

# game/scripts/c28/c28.rpy:3752
translate brazilian c28s002_KatRoute_08e3b223:

    # kat "*Risa* Dalo por cambiado, idiota mío."
    kat "*Risos* Considere-se mudado, seu idiota."

# game/scripts/c28/c28.rpy:3754
translate brazilian c28s002_KatRoute_ba5e0182:

    # kat "Al menos ya sé a qué sabe un beso de verdad de un chico..."
    kat "Pelo menos agora eu sei qual é o gosto de um beijo de verdade de um garoto..."

# game/scripts/c28/c28.rpy:3755
translate brazilian c28s002_KatRoute_a314b263:

    # mc "*Risa* Espero que nunca te canses nunca del sabor."
    mc "*Risos* Espero que você nunca se canse do sabor."

# game/scripts/c28/c28.rpy:3756
translate brazilian c28s002_KatRoute_44bc63c3:

    # kat "Te aseguro que nunca vas a tener que preocuparte por eso. "
    kat "Garanto-lhe que nunca terá de se preocupar com isso."

# game/scripts/c28/c28.rpy:3758
translate brazilian c28s002_KatRoute_da10bd47:

    # "Esta vez es ella quien te besa, sellando el inicio de lo que va a ser una preciosa relación."
    "Dessa vez é ela quem te beija, selando o início do que será um belo relacionamento."

# game/scripts/c28/c28.rpy:3759
translate brazilian c28s002_KatRoute_ec74dad7:

    # "Nunca os cansaréis de meteros el uno con el otro, haciendo que vuestra relación sea única. Tampoco se cansará del sabor de tus besos."
    "Vocês nunca se cansarão de provocar um ao outro, tornando o relacionamento de vocês único. Ele também nunca se cansará do sabor dos seus beijos."

# game/scripts/c28/c28.rpy:3760
translate brazilian c28s002_KatRoute_140f3a91:

    # "La seguridad que tus brazos y tus labios le van a dar a [kat] van a hacer de ella una mujer inmensamente feliz."
    "A segurança que seus braços e lábios lhe darão [kat] a fará uma mulher imensamente feliz."

# game/scripts/c28/c28.rpy:3761
translate brazilian c28s002_KatRoute_14f9ab56:

    # "Y tú vas a reescribir el significado de la palabra 'felicidad' cada vez que vuestros labios se rocen."
    "E você vai reescrever o significado da palavra 'felicidade' toda vez que seus lábios se tocarem."

# game/scripts/c28/c28.rpy:3762
translate brazilian c28s002_KatRoute_d0c1826d:

