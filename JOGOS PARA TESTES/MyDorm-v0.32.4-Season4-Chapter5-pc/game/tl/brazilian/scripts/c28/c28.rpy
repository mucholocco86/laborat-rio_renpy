# game/scripts/c28/c28.rpy:2586
translate brazilian c28s004_LisaDress_85b1c382:

    # lis "Entonces este es el que debería competir con el que había elegido yo."
    lis "Então, esta é a que deve competir com a que eu havia escolhido."

# game/scripts/c28/c28.rpy:2588
translate brazilian c28s004_LisaDress_603b169a:

    # eva "¿Te hemos hecho dudar con los comentarios? ¿Este ha desbancado al que tú querías?"
    eva "Nossos comentários fizeram você duvidar de si mesmo? Este substituiu o que você queria?"

# game/scripts/c28/c28.rpy:2590
translate brazilian c28s004_LisaDress_82572576:

