translate brazilian c28s004_MarRing_5f1921e8:

    # mom "No creo que nunca dejen que una madre se case con su hijo."
    mom "Acho que eles nunca vão deixar uma mãe casar com o próprio filho."

# game/scripts/c28/c28.rpy:1855
translate brazilian c28s004_MarRing_efae6aaf:

    # mom "Tu otra novia me mataría si te casas conmigo y no con ella."
    mom "Sua outra namorada me mataria se você casasse comigo em vez dela."

# game/scripts/c28/c28.rpy:1857
translate brazilian c28s004_MarRing_7b0e9d52:

    # mom "El resto me mataría si te casas conmigo y no con ellas."
    mom "Os outros me matariam se você se casasse comigo e não com eles."

# game/scripts/c28/c28.rpy:1858
translate brazilian c28s004_MarRing_97d33085:

    # mc "No necesito que ningún gobierno me diga con quién puedo casarme."
    mc "Não preciso que nenhum governo me diga com quem posso me casar."

# game/scripts/c28/c28.rpy:1859
translate brazilian c28s004_MarRing_243af757:

    # mc "Desde este momento me considero casado contigo."
    mc "A partir deste momento, considero-me casado(a) com você."

# game/scripts/c28/c28.rpy:1862
translate brazilian c28s004_MarRing_3f0017b7:

    # mom "No me casé con tu padre y ahora me voy a casar contigo..."
    mom "Eu não me casei com seu pai, e agora vou me casar com você..."

# game/scripts/c28/c28.rpy:1863
translate brazilian c28s004_MarRing_25ec27b5:

    # mc "No lo digas en futuro. Desde este momento me considero casado contigo."
    mc "Não diga isso no futuro. A partir deste momento, considero-me casado(a) com você."

# game/scripts/c28/c28.rpy:1865
translate brazilian c28s004_MarRing_bd6803fa:

    # mom "*Risa* ¿Un dónut como anillo de pedida y también como anillo de bodas? Te salgo barata..."
