

# game/scripts/c28/c28.rpy:44
translate brazilian c28s001_foursome_337cb758:

    # mc "No dudéis ni por un momento que esos regalos se vayan a quedar sin abrir."
    mc "Não duvide nem por um instante que esses presentes permanecerão sem ser abertos."

# game/scripts/c28/c28.rpy:46
translate brazilian c28s001_foursome_33108e94:

    # "Te acercas a [sai] y la besas apasionadamente. Su cuerpo vibra bajo tus manos."
    "Você se aproxima de [sai] e a beija apaixonadamente. O corpo dela estremece sob suas mãos."

# game/scripts/c28/c28.rpy:47
translate brazilian c28s001_foursome_4d2b9ef6:

    # "Sabes que está excitada por lo que está a punto de pasar. Hablasteis varias veces de hacer un trío mientras estabais en Portland."
    "Você sabe que ela está animada com o que está prestes a acontecer. Vocês conversaram várias vezes sobre fazer um ménage à trois enquanto estavam em Portland."

# game/scripts/c28/c28.rpy:48
translate brazilian c28s001_foursome_d1741da1:

    # "Nunca surgió la oportunidad o nunca encontrasteis a la chica adecuada. Nunca se planteó hacer un trío con un chico."
    "A oportunidade nunca surgiu, ou você nunca encontrou a garota certa. A ideia de fazer um ménage à trois com um cara nunca foi sequer considerada."

# game/scripts/c28/c28.rpy:49
translate brazilian c28s001_foursome_cf3c7d87:

    # "Ahora, su primera experiencia de sexo en grupo va a ser con dos mujeres a las que ha empezado a considerar más que amigas."
    "Agora, sua primeira experiência de sexo em grupo será com duas mulheres que ele começou a considerar mais do que amigas."

# game/scripts/c28/c28.rpy:51
translate brazilian c28s001_foursome_12a1ca43:

    # sai "Creo que hay una perra pelirroja esperando su beso. *Risa*"
    sai "Acho que tem uma ruiva safada esperando pelo seu beijo. *Risos*"

# game/scripts/c28/c28.rpy:52
translate brazilian c28s001_foursome_18cfed98:

    # sai "*Risa* Después de las bromas que hemos hecho sobre sacarle los ojos, no quiero que use mis ideas contra mí."
    sai "*Risos* Depois das piadas que fizemos sobre arrancar os olhos dele, não quero que ele use minhas ideias contra mim."

# game/scripts/c28/c28.rpy:53
translate brazilian c28s001_foursome_0dede26d:

    # mc "No queremos que esos preciosos ojos oscuros acaben en un tarro, ¿no?"
    mc "Não queremos que esses preciosos olhos escuros acabem num frasco, não é?"

# game/scripts/c28/c28.rpy:55
translate brazilian c28s001_foursome_036484d0:

    # eil "No se los sacaría a ella. *Risa* Recuerda que soy la Primera Concubina del harén."
    eil "Eu não as tiraria dela. *Risos* Lembre-se, eu sou a Primeira Concubina do harém."

# game/scripts/c28/c28.rpy:56
translate brazilian c28s001_foursome_f79a4b9d:

    # eil "*Risa* Si no soy importante para el sultán, quizás sean sus ojos los que acaben en un tarro."
    eil "*Risos* Se eu não for importante para o sultão, talvez sejam os olhos dele que acabem num frasco."

# game/scripts/c28/c28.rpy:57
translate brazilian c28s001_foursome_5422e68e:

    # mc "¡Vamos, [eil]! Te juro que, en este momento, lo significas todo."
    mc "Vamos lá, [eil]! Eu juro, neste momento, você significa tudo para mim."

# game/scripts/c28/c28.rpy:58
translate brazilian c28s001_foursome_93048d5f:

    # mc "Las tres lo significáis todo."
    mc "Vocês três significam tudo."

# game/scripts/c28/c28.rpy:60
translate brazilian c28s001_foursome_0fef0510:

    # oma "*Risa* ¿Y tus pensamientos se vuelven impuros al verla vestida así?"
    oma "*Risos* E seus pensamentos ficam impuros quando você a vê vestida assim?"

# game/scripts/c28/c28.rpy:61
translate brazilian c28s001_foursome_433125eb:

    # mc "*Risa* Al veros a las tres. Pero dame un momento antes de que la Primera Concubina me saque los ojos."
    mc "*Risos* Ver vocês três. Mas me deem um momento antes que a Primeira Concubina arranque meus olhos."

# game/scripts/c28/c28.rpy:63
translate brazilian c28s001_foursome_35737497:

    # "Coges a la hermosa pelirroja entre tus brazos y tus labios encuentran los suyos, entreabiertos para recibir tu lengua."
    "Você abraça a bela ruiva e seus lábios encontram os dela, entreabertos para receber sua língua."

# game/scripts/c28/c28.rpy:64
translate brazilian c28s001_foursome_f82359bd:

    # "Su respiración transmite tanta excitación como los temblores de [sai]. No eres el único que está excitado por lo que va a pasar."
    "Sua respiração transmite tanta excitação quanto os tremores de [sai]. Você não é o único animado com o que está prestes a acontecer."

# game/scripts/c28/c28.rpy:65
translate brazilian c28s001_foursome_fec024e6:

    # "Va a ser su segundo sexo en grupo después de estar con [oma] en el bosque. Se pasó días hablando de aquel trío." id c28s001_foursome_fec024e6
    "Vai ser a segunda vez que ela participa de sexo em grupo, depois de ter estado com [oma] na floresta. Ela passou dias falando sobre aquele ménage à trois." id c28s001_foursome_fec024e6

# game/scripts/c28/c28.rpy:66
translate brazilian c28s001_foursome_2899cfe0:

    # "Aquello lo propició ella, y esto parece que también. Adoras a [eil]."
    "Ela causou isso, e parece que ela fez isso também. Você adora [eil]."

# game/scripts/c28/c28.rpy:68
translate brazilian c28s001_foursome_b13c298f:

    # eil "Creo que es el momento de que beses a nuestra policía o es capaz de arrestarnos a todos."
    eil "Acho que já está na hora de você beijar a nossa polícia, ou eles são capazes de prender todos nós."

# game/scripts/c28/c28.rpy:69
translate brazilian c28s001_foursome_cdc0b5f4:

    # mc "Yo no lo recomiendo. Las esposas son bastante incómodas."
    mc "Não recomendo. As algemas são bastante desconfortáveis."

# game/scripts/c28/c28.rpy:71
translate brazilian c28s001_foursome_7e9b4743:

    # oma "*Risa* Sabes que te las puedes quitar cuando quieras, ¿verdad?"
    oma "*Risos* Você sabe que pode tirá-los quando quiser, né?"

# game/scripts/c28/c28.rpy:72
translate brazilian c28s001_foursome_3054f9de:

    # mc "*Risa* Esperaba a que me dieras permiso para hacerlo. Decidimos probar y no es lo mío."
    mc "*Risos* Eu estava esperando sua permissão para fazer isso. Nós resolvemos tentar, mas não é a minha praia."

# game/scripts/c28/c28.rpy:73
translate brazilian c28s001_foursome_d8eac6ef:

    # oma "Tampoco lo mío. Prefiero sentir tus manos recorriendo mi piel."
    oma "Para mim também não. Prefiro sentir suas mãos percorrendo minha pele."

# game/scripts/c28/c28.rpy:75
translate brazilian c28s001_foursome_2c5be866:

    # "Después de quitarte las esposas, abrazas fuertemente a [oma] mientras vuestros labios se unen otra vez."
    "Após remover suas algemas, você abraça [oma] com força enquanto seus lábios se encontram novamente."

# game/scripts/c28/c28.rpy:76
translate brazilian c28s001_foursome_11c8dab9:

    # "Hace diez minutos que la tenías entre tus brazos y hace nueve que la echabas de menos."
    "Você a tinha em seus braços há dez minutos e já sente falta dela há nove minutos."

# game/scripts/c28/c28.rpy:77
translate brazilian c28s001_foursome_18befd20:

    # "Su cuerpo reacciona diferente a las otras dos mujeres, más tranquila después de haberte tenido para ella sola hace un rato."
    "O corpo dela reage de forma diferente das outras duas mulheres, mais calmo depois de ter tido você só para ela por um tempo."

# game/scripts/c28/c28.rpy:79
translate brazilian c28s001_foursome_6958b37c:

    # sai "¿Vamos a caber todos en esa cama? Me parece un poco pequeña, ¿no?"
    sai "Será que todos nós caberemos nessa cama? Parece um pouco pequena, não é?"

# game/scripts/c28/c28.rpy:80
translate brazilian c28s001_foursome_c447616a:

    # mc "No te preocupes, encontraremos la forma de hacerlo."
    mc "Não se preocupe, daremos um jeito de fazer isso."

# game/scripts/c28/c28.rpy:82
translate brazilian c28s001_foursome_c4df37b5:

    # oma "Creo que [sai] tiene razón. Id ocupándoos de nuestro invitado mientras yo hago algo."
    oma "Acho que [sai] está certo. Vocês todos cuidam do nosso convidado enquanto eu faço alguma coisa."

# game/scripts/c28/c28.rpy:83
translate brazilian c28s001_foursome_e13094b8:

    # mc "¿Qué vas a hacer?"
    mc "O que você vai fazer?"

# game/scripts/c28/c28.rpy:84
translate brazilian c28s001_foursome_3e896faf:

    # oma "Voy a probar algo. Intenta no correrte antes de que vuelva."
    oma "Vou tentar uma coisa. Tente não vir antes de eu voltar."

# game/scripts/c28/c28.rpy:85
translate brazilian c28s001_foursome_22294bf2:

    # mc "Creo que va a ser complicado con las dos fierecillas."
    mc "Acho que vai ser complicado com esses dois pestinhas."

# game/scripts/c28/c28.rpy:87
translate brazilian c28s001_foursome_14a0ac8a:

    # eil "No prometemos nada, pero, de momento, túmbate. Mjolnir ya está preparado para nosotras."
    eil "Não estamos prometendo nada, mas por agora, deite-se. Mjolnir está pronto para nós."

# game/scripts/c28/c28.rpy:88
translate brazilian c28s001_foursome_70b1251d:

    # mc "*Risa* ¿No puedo desenvolver mis regalos?"
    mc "*Risos* Não posso desembrulhar meus presentes?"

# game/scripts/c28/c28.rpy:90
translate brazilian c28s001_foursome_44bec75e:

    # sai "Habrá tiempo para eso. Pero nuestro regalo ya está desenvuelto y no queremos desaprovecharlo."
    sai "Haverá tempo para isso. Mas nosso presente já foi desembrulhado e não queremos desperdiçá-lo."

# game/scripts/c28/c28.rpy:91
translate brazilian c28s001_foursome_f8da55b5:

    # sai "Por una vez, te toca obedecer órdenes y estar calladito."
    sai "Desta vez, é a sua vez de obedecer às ordens e ficar quieto."

# game/scripts/c28/c28.rpy:92
translate brazilian c28s001_foursome_84d5be27:

    # mc "Entonces me tendré que tumbar. ¿De verdad tengo que estar callado?"
    mc "Então terei que me deitar. Será que preciso mesmo ficar em silêncio?"

# game/scripts/c28/c28.rpy:95
translate brazilian c28s001_foursome_31502197:

    # sai "Y no empieces a discutir." (multiple=2)
    sai "E não comece a discutir." (multiple=2)

# game/scripts/c28/c28.rpy:96
translate brazilian c28s001_foursome_d7dcc00f:

    # eil "Puedes hablar, pero poco." (multiple=2)
    eil "Você pode conversar, mas não muito." (multiple=2)

# game/scripts/c28/c28.rpy:98
translate brazilian c28s001_foursome_51368258:

    # mc "Vale. Hablar poco y no discutir. Creo que puedo hacerlo."
    mc "Certo. Fale pouco e não discuta. Acho que consigo fazer isso."

# game/scripts/c28/c28.rpy:101
translate brazilian c28s001_foursome_bb5392c0:

    # sai "¿Qué le hacemos?"
    sai "O que podemos fazer a respeito?"

# game/scripts/c28/c28.rpy:102
translate brazilian c28s001_foursome_4beb54ea:

    # eil "Creo que lo que hablamos anoche estaría bien para empezar. Aunque falte [oma.nick]..."
    eil "Acho que o que conversamos ontem à noite seria um bom ponto de partida. Mesmo que [oma.nick] esteja faltando..."

# game/scripts/c28/c28.rpy:103
translate brazilian c28s001_foursome_c46edd51:

    # mc "¿Habláis de lo que me vais a hacer cuando compartís habitación?"
    mc "Você está falando sobre o que vai fazer comigo quando dividirmos o quarto?"

# game/scripts/c28/c28.rpy:105
translate brazilian c28s001_foursome_6f0a3e5c:

    # sai "¡Por supuesto! Entre otras muchas cosas." (multiple=2)
    sai "Claro! Entre muitas outras coisas." (multiple=2)

# game/scripts/c28/c28.rpy:106
translate brazilian c28s001_foursome_0d0ccedb:

    # eil "¿Qué te hemos dicho de estar callado?" (multiple=2)
    eil "O que já lhe dissemos sobre ficar em silêncio?" (multiple=2)

# game/scripts/c28/c28.rpy:107
translate brazilian c28s001_foursome_e2011828:

    # mc "Pero me parece un tema muy interesante... Mis chicas hablando de mí..."
    mc "Mas acho um assunto muito interessante... Minhas filhas falando de mim..."

# game/scripts/c28/c28.rpy:109
translate brazilian c28s001_foursome_53460904:

    # sai "No hablamos sólo de ti, pero cuando [eil] propuso hacer esto, empezamos a fantasear..."
    sai "Não estávamos falando apenas de você, mas quando [eil] sugeriu fazer isso, começamos a fantasiar..."

# game/scripts/c28/c28.rpy:110
translate brazilian c28s001_foursome_724d119b:

    # eil "No esperábamos que la oportunidad llegara tan pronto, con lo que los planes son un poco... vagos."
    eil "Não esperávamos que a oportunidade surgisse tão cedo, então os planos estão um pouco... vagos."

# game/scripts/c28/c28.rpy:111
translate brazilian c28s001_foursome_ea009b6c:

    # mc "*Risa* Estoy seguro de que no me voy a quejar por ello."
    mc "*Risos* Tenho certeza de que não vou reclamar disso."

# game/scripts/c28/c28.rpy:114
translate brazilian c28s001_foursome_74467882:

    # eil "Eso espero. Esto siempre te encantó, pero me faltaban manos."
    eil "Espero que sim. Você sempre adorou isso, mas eu não tinha mãos suficientes."

# game/scripts/c28/c28.rpy:115
translate brazilian c28s001_foursome_02775026:

    # "Mientras [sai] te masturba y te acaricia los huevos, [eil] se dedica a acariciarte y a excitar tu glande con sus dedos."
    "Enquanto [sai] te masturba e acaricia seus testículos, [eil] está ocupado acariciando e excitando sua glande com os dedos."

# game/scripts/c28/c28.rpy:116
translate brazilian c28s001_foursome_493e96c9:

    # sai "A mí me pasaba lo mismo. Soy India, pero no soy Kali."
    sai "A mesma coisa aconteceu comigo. Sou indiana, mas não sou Kali."

# game/scripts/c28/c28.rpy:117
translate brazilian c28s001_foursome_19d1a60f:

    # "Notar las cuatro manos de las dos mujeres recorriendo tu cuerpo a la vez es una sensación increíble."
    "Sentir as quatro mãos das duas mulheres percorrendo seu corpo ao mesmo tempo é uma sensação incrível."

# game/scripts/c28/c28.rpy:118
translate brazilian c28s001_foursome_db1dbd6d:

    # mc "¿Qué tiene que ver tu prima en esto?"
    mc "O que seu primo tem a ver com isso?"

# game/scripts/c28/c28.rpy:119
translate brazilian c28s001_foursome_18c65b38:

    # sai "He dicho Kali, no [kal.nick]."
    sai "Eu disse Kali, não [kal.nick]."

# game/scripts/c28/c28.rpy:120
translate brazilian c28s001_foursome_350ff9b9:

    # "No notas la diferencia en la pronunciación. Pero en ese momento te da lo mismo."
    "Você não percebe a diferença na pronúncia. Mas naquele momento, isso não importa."

# game/scripts/c28/c28.rpy:125
translate brazilian c28s001_foursome_4229e796:

    # "En ese momento lo que echas de menos es un espejo en el techo y poder observar los cuerpos de las dos mujeres."
    "Nesse momento, o que você sente falta é de um espelho no teto para poder observar os corpos das duas mulheres."

# game/scripts/c28/c28.rpy:126
translate brazilian c28s001_foursome_91c5f63a:

    # "Cuerpos muy diferentes, pero los dos preciosos. Los conoces a la perfección, pero nunca te cansarás de ellos."
    "Corpos muito diferentes, mas ambos deslumbrantes. Você os conhece perfeitamente, mas nunca se cansará deles."

# game/scripts/c28/c28.rpy:127
translate brazilian c28s001_foursome_053be75c:

    # eil "¿Qué tal? ¿Cómo te sientes manoseado por dos mujeres a la vez?"
    eil "Como vai? Como é ser apalpada por duas mulheres ao mesmo tempo?"

# game/scripts/c28/c28.rpy:128
translate brazilian c28s001_foursome_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c28/c28.rpy:129
translate brazilian c28s001_foursome_cfaeb64e:

    # sai "*Risa* Le hemos dicho que esté callado y creo que nos va a hacer caso. Puedes contestar."
    sai "*Risos* Pedimos para ele ficar quieto e acho que ele vai obedecer. Você pode responder."

# game/scripts/c28/c28.rpy:130
translate brazilian c28s001_foursome_7f5b67a9:

    # mc "¿Mi ex-novia del instituto y mi ex-no-novia de la universidad jugando con Mjolnir? Creo que hay pocas cosas mejores. Al menos hasta que se una [oma]."
    mc "Minha ex-namorada do ensino médio e minha ex-namorada da faculdade brincando com o Mjolnir? Acho que poucas coisas são melhores. Pelo menos até um [oma]."

# game/scripts/c28/c28.rpy:131
translate brazilian c28s001_foursome_14362538:

    # sai "¡No me recuerdes lo tonta que fui! Y menos ahora que yo tengo el poder."
    sai "Não me lembre o quão tolo eu fui! Principalmente agora que tenho o poder."

# game/scripts/c28/c28.rpy:132
translate brazilian c28s001_foursome_32a534d6:

    # "[sai] aprieta tus huevos entre sus dedos en un gesto juguetón. Lejos de ser doloroso, es sólo un pequeño aviso de que no te metas con ella."
    "[sai] Ela aperta seus testículos entre os dedos de forma brincalhona. Longe de ser doloroso, é apenas um aviso gentil para não mexer com ela."

# game/scripts/c28/c28.rpy:133
translate brazilian c28s001_foursome_3b4e2eca:

    # "Siempre le ha gustado tener el poder. O al menos una ilusión de poder que nunca ha utilizado."
    "Ele sempre gostou de ter poder. Ou pelo menos uma ilusão de poder que nunca usou."

# game/scripts/c28/c28.rpy:137
translate brazilian c28s001_foursome_d9ae582f:

    # eil "Bueno, ahora las dos somos tus novias y no vamos a cometer los mismos errores que cometimos, ni siquiera cuando te marches."
    eil "Bom, agora nós duas somos suas namoradas e não vamos cometer os mesmos erros que cometemos, nem mesmo quando você for embora."

# game/scripts/c28/c28.rpy:138
translate brazilian c28s001_foursome_ffb2f160:

    # "Tienen más en común de lo que les hubiera gustado aceptar hace unas semanas. Tu relación a distancia con [eil] no funcionó."
    "Eles têm mais em comum do que gostariam de admitir algumas semanas atrás. Seu relacionamento à distância com [eil] não deu certo."

# game/scripts/c28/c28.rpy:139
translate brazilian c28s001_foursome_80c693c2:

    # "La de [sai] no llegó a existir por su miedo a una relación a distancia. Ahora pasaréis meses separados, pero esta vez no habrá rupturas."
    "O relacionamento com [sai] nunca se concretizou devido ao medo dela de um relacionamento à distância. Agora vocês passarão meses separados, mas desta vez não haverá términos."

# game/scripts/c28/c28.rpy:140
translate brazilian c28s001_foursome_319131b9:

    # sai "¡Céntrate, [eil]! ¡No hables de cosas tristes! Y tú no contestes. Relájate y disfruta."
    sai "Concentre-se, [eil]! Não fale sobre coisas tristes! E não responda. Relaxe e aproveite."

# game/scripts/c28/c28.rpy:141
translate brazilian c28s001_foursome_7b55e9fd:

    # "No pensabas contestar. Tener a las dos mujeres produciendo sensaciones increíbles en tu polla no te deja mucho espacio para pensar en una respuesta ingeniosa."
    "Você não tinha intenção de responder. Ter as duas mulheres proporcionando sensações incríveis no seu pau não lhe deixava muito espaço para pensar em uma resposta espirituosa."

# game/scripts/c28/c28.rpy:142
translate brazilian c28s001_foursome_dc34ba8e:

    # "Prefieres disfrutar de cada roce de sus dedos y mantenerte callado."
    "Você prefere apreciar cada toque dos dedos dela e permanecer em silêncio."

# game/scripts/c28/c28.rpy:145
translate brazilian c28s001_foursome_06a8f39d:

    # oma "Ya está. Ya podéis venir."
    oma "Pronto. Pode vir agora."

# game/scripts/c28/c28.rpy:146
translate brazilian c28s001_foursome_8a7b9a6f:

    # mc "¿A dónde? ¿Qué has hecho?"
    mc "Para onde? O que você fez?"

# game/scripts/c28/c28.rpy:147
translate brazilian c28s001_foursome_4922e44b:

    # oma "Ya lo verás. Chicas, dejad a Mjolnir un rato."
    oma "Vocês vão ver. Meninas, deixem o Mjolnir em paz por um tempo."

# game/scripts/c28/c28.rpy:149
translate brazilian c28s001_foursome_468046f0:

    # eil "Has aguantado como un campeón sin correrte."
    eil "Você aguentou firme como um campeão sem chegar ao clímax."

# game/scripts/c28/c28.rpy:150
translate brazilian c28s001_foursome_7043cf46:

    # sai "*Risita* Me ha costado mantener el ritmo lento. Hubiera sido egoísta por nuestra parte hacer que te corrieras antes de que volviera [oma]."
    sai "*Risos* Foi difícil manter o ritmo lento. Teria sido egoísmo da nossa parte fazer você gozar antes de eu voltar [oma]."

# game/scripts/c28/c28.rpy:151
translate brazilian c28s001_foursome_9b2a6dbd:

    # mc "*Risa* Sabéis que sois unas perras malas, ¿verdad?"
    mc "*Risos* Vocês sabem que são umas gatas, né?"

# game/scripts/c28/c28.rpy:153
translate brazilian c28s001_foursome_a1dfcffe:

    # eil "*Risa* Yo sí. [sai] me lo recuerda cada día."
    eil "*Risos* Eu também. [sai] Ele me lembra disso todos os dias."

# game/scripts/c28/c28.rpy:154
translate brazilian c28s001_foursome_37739c7f:

    # sai "*Risa* Pero pese a todo la quiero."
    sai "*Risos* Mas, apesar de tudo, eu a amo."

