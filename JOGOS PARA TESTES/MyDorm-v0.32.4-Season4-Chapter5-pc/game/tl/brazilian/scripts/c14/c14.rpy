    # mc "[sam.nick], no os he engañado a ninguna..."
    mc "[sam.nick], Eu não enganei nenhum de vocês..."

# game/scripts/c14/c14.rpy:277
translate brazilian c14s001_ContinuationSam_a3428e24:

    # sam "No sabes lo que estás diciendo, [sim]. ¡Nos ha engañado a las dos! ¡Lo quiero fuera de aquí! {b}¡Ya!{/b}"
    sam "Você não sabe o que está dizendo, [sim]. Ele nos enganou! Quero ele fora daqui! {b}Agora!{/b}"

# game/scripts/c14/c14.rpy:299
translate brazilian c14s001_ContinuationSam_2670a701:

    # mc "No, [sam]. Tú me dijiste que habías hablado con [mar] y que no te importaba compartir..."
    mc "Não, [sam]. Você me disse que havia falado com [mar] e que não se importava de compartilhar..."

# game/scripts/c14/c14.rpy:309
translate brazilian c14s001_ContinuationSam_62113d8e:

    # mc "[sam.nick], no te dije que estaba con otras mujeres por que tú me dijiste eso... lo tomé como que no te importaba..."
    mc "[sam.nick], Eu não te contei que estava com outras mulheres porque você me disse isso... Entendi que você não se importava..."

# game/scripts/c14/c14.rpy:316
translate brazilian c14s001_ContinuationSam_9a239aed:

    # mc "Y no las prefiero jóvenes, [sam.nick]. ¿Todo esto es por el tema de la edad otra vez?"
    mc "E eu não os prefiro jovens, [sam.nick]. Será que tudo isso tem a ver com a idade de novo?"

# game/scripts/c14/c14.rpy:317
translate brazilian c14s001_ContinuationSam_a0a2fa2f:

    # mc "Me gusta [sim] y estoy con ella, no por la edad que tiene, sino por quién es. Por cómo es. Y tú me gustas por cómo eres. Me da lo mismo la edad que tengas. Sólo parece importarte a ti."
    mc "Gosto dela e estou com ela, não por causa da idade dela, mas por quem ela é. Por causa de como ela é. E gosto de você por quem você é. Não me importo com a sua idade. Parece que só importa para você."

# game/scripts/c14/c14.rpy:343
translate brazilian c14s001_ContinuationSam_f0c3bd6f:

    # mc "No es nada que no hayáis visto antes las dos, no quiero interrumpir a [sim] antes de saber el resto de los puntos por lo que la situación le parece ridícula."
    mc "Não é nada que vocês dois já não tenham visto antes, não quero interromper [sim] antes que ela saiba o resto dos pontos, é por isso que a situação parece ridícula para ela."

# game/scripts/c14/c14.rpy:375
translate brazilian c14s001_ContinuationSam_e0a3a9eb:

    # sim "Y si hubiera vuelto con [eil] tampoco, ¿verdad?"
    sim "E se eu tivesse voltado com [eil], então não, certo?"

# game/scripts/c14/c14.rpy:382
translate brazilian c14s001_ContinuationSam_609a6459:

    # sim "Entonces si saliera con [mar] no te enfadarías, con [eil] un poco, y porque sale conmigo te pones hecha una furia."
    sim "Então, se ele saísse com [mar] você não ficaria brava, com [eil] um pouco, e como ele está saindo comigo você fica furiosa."

# game/scripts/c14/c14.rpy:388
translate brazilian c14s001_ContinuationSam_621e84b2:

    # sam "{b}¡No es eso!{/b} Con [mar] lo habíamos hablado, aunque solo fuera en broma. Si volviera con [eil]... todos lo esperábamos..."
    sam "{b}Não é isso!{/b} Eu tinha conversado sobre isso com [mar], mesmo que fosse só brincadeira. Se ele voltasse com [eil]... todos nós esperávamos por isso..."

# game/scripts/c14/c14.rpy:431
translate brazilian c14s001_ContinuationSam_e9c4c4f6:

    # sam "¡[sim]!"
    sam "[sim]!"

# game/scripts/c14/c14.rpy:471
translate brazilian c14s001_ContinuationSam_4d8bcdb4:

    # mc "No puedo saber si va a haber más, [sim]. No puedo saber si al salir al rellano voy a encontrar otra chica que me guste tanto como vosotras."
