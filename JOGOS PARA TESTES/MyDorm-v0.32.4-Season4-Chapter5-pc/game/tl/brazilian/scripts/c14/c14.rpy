    # eri "Nos vemos ahora, mi amor."
    eri "Até logo, meu amor."

# game/scripts/c14/c14.rpy:3695
translate brazilian c14s006_Christmas_2a7eb574:

    # mc "Os espero en las sombrillas, mi vida."
    mc "Estarei te esperando debaixo dos guarda-chuvas, meu amor."

# game/scripts/c14/c14.rpy:3698
translate brazilian c14s006_Christmas_ef35767a:

    # eil "Recuerda a quien le diste el título de primera concubina. Te quiero."
    eil "Lembra daquela a quem você deu o título de primeira concubina? Eu te amo."

# game/scripts/c14/c14.rpy:3699
translate brazilian c14s006_Christmas_2945552b:

    # mc "Yo más. Y no lo olvidaré nunca."
    mc "Eu também. E nunca vou esquecer isso."

# game/scripts/c14/c14.rpy:3701
translate brazilian c14s006_Christmas_bde675c5:

    # emm "¿Qué es eso del título de primera concubina?"
    emm "O que é isso sobre o título de primeira concubina?"

# game/scripts/c14/c14.rpy:3702
translate brazilian c14s006_Christmas_829b0f58:

    # eil "Nada, una tontería. Sabes qué es una concubina, ¿no?"
    eil "Nada disso, é um absurdo. Você sabe o que é uma concubina, certo?"

# game/scripts/c14/c14.rpy:3703
translate brazilian c14s006_Christmas_e41cb5d3:

    # eri "Y sabes que cuando un hombre tiene varias mujeres se llama harén, ¿verdad?"
    eri "E você sabe que quando um homem tem várias mulheres, isso se chama harém, certo?"

# game/scripts/c14/c14.rpy:3704
translate brazilian c14s006_Christmas_9fdba566:

    # emm "Emmm... claro que lo sé... no soy tonta..."
    emm "Hum... claro que sei... não sou estúpido..."

# game/scripts/c14/c14.rpy:3707
translate brazilian c14s006_Christmas_6a82562e:

    # "Vuelves hacia las sombrillas y te das cuenta de que ha llegado más gente en el rato que has estado fuera."
    "Você volta em direção aos guarda-chuvas e percebe que mais pessoas chegaram enquanto você estava lá fora."

# game/scripts/c14/c14.rpy:3715
translate brazilian c14s006_Christmas_223514c4:

    # mc "Hola, Simone, que bien que hayáis llegado."
    mc "Olá Simone, que bom que você chegou."

# game/scripts/c14/c14.rpy:3716
translate brazilian c14s006_Christmas_c0496660:

    # sim "[mc]..."
    sim "[mc]..."

# game/scripts/c14/c14.rpy:3723
translate brazilian c14s006_Christmas_223514c4_1:

    # mc "Hola, Simone, que bien que hayáis llegado."
    mc "Olá Simone, que bom que você chegou."

# game/scripts/c14/c14.rpy:3724
translate brazilian c14s006_Christmas_51f8c4d6:

    # sim "[mc], sí, hemos tardado más porque mi madre no encontraba el pareo. Hace siglos que no venimos a la playa."
    sim "[mc], sim, demoramos mais porque minha mãe não conseguia encontrar o pareô. Faz muito tempo que não vamos à praia."

# game/scripts/c14/c14.rpy:3738
translate brazilian c14s006_Christmas_1d50a73d:

    # mc "Sam, estás preciosa de rojo."
    mc "Sam, você fica linda de vermelho."

# game/scripts/c14/c14.rpy:3739
translate brazilian c14s006_Christmas_31e4efe9:

    # sam "Gracias. Ha sido una buena idea. Al menos hacemos algo diferente."
    sam "Obrigado. Foi uma boa ideia. Pelo menos estamos fazendo algo diferente."

# game/scripts/c14/c14.rpy:3744
translate brazilian c14s006_Christmas_d2f17514:

    # sim "Por cierto, hay algo que quiero hacer."
    sim "Aliás, tem algo que eu quero fazer."

# game/scripts/c14/c14.rpy:3745
translate brazilian c14s006_Christmas_73203639:

    # mc "Si quieres, por mí ningún problema."
    mc "Se você quiser, por mim tudo bem."

# game/scripts/c14/c14.rpy:3747
translate brazilian c14s006_Christmas_1b069038:

    # "La seguridad que le da a Simone que su madre ya sepa lo vuestro se nota en sus labios."
    "A tranquilidade que Simone sente ao saber que sua mãe já sabe sobre vocês dois é evidente em seus lábios."

# game/scripts/c14/c14.rpy:3749
translate brazilian c14s006_Christmas_1ffc9153:

    # sim "*Susurrando* ¡Mielda! He cerrado los ojos y no he mirado si alguna se ha enfadado."
    sim "*Sussurrando* Droga! Fechei os olhos e não olhei para ver se alguém estava com raiva."

# game/scripts/c14/c14.rpy:3750
translate brazilian c14s006_Christmas_c318ef06:

    # mc "*Susurrando* Más que enfadadas, sorprendidas."
    mc "*Sussurrando* Mais do que irritada, surpresa."

# game/scripts/c14/c14.rpy:3754
translate brazilian c14s006_Christmas_3fc0b2e9:

    # sam "*Susurrando* Creo que es mi turno. Si a alguien le da un infarto, tengo el desfibrilador en el coche."
    sam "*Sussurrando* Acho que é minha vez. Se alguém tiver um ataque cardíaco, eu tenho o desfibrilador no carro."

# game/scripts/c14/c14.rpy:3756
translate brazilian c14s006_Christmas_464b8318:

    # sam "*Susurrando* Voy a hacer algo. Si a alguien le da un infarto, tengo el desfibrilador en el coche."
    sam "*Sussurrando* Vou fazer alguma coisa. Se alguém tiver um ataque cardíaco, eu tenho o desfibrilador no carro."

# game/scripts/c14/c14.rpy:3757
translate brazilian c14s006_Christmas_f8a3399c:

    # mc "*Susurrando* Adelante. Soy tuyo para hacer lo que quieras."
    mc "*Sussurrando* Vá em frente. Sou sua para fazer o que quiser comigo."

# game/scripts/c14/c14.rpy:3758
translate brazilian c14s006_Christmas_54e2e1ed:

    # sam "*Susurrando* Lo que quiera no, pero esto sí."
    sam "*Sussurrando* Não é o que eu quero, mas isso, sim."

# game/scripts/c14/c14.rpy:3760
translate brazilian c14s006_Christmas_030379f5:

    # "Besar a Samantha delante de todo el mundo tiene algo especial."
    "Beijar Samantha na frente de todos tem algo de especial."

# game/scripts/c14/c14.rpy:3762
translate brazilian c14s006_Christmas_d706fdf9:

    # sam "*Susurrando* ¿Ha pasado algo? Me da miedo mirar..."
    sam "*Sussurrando* Aconteceu alguma coisa? Estou com medo de olhar..."

# game/scripts/c14/c14.rpy:3763
translate brazilian c14s006_Christmas_c325831a:

    # mc "*Susurrando* Ningún infarto de momento."
    mc "*Sussurrando* Nenhum ataque cardíaco até agora."

# game/scripts/c14/c14.rpy:3766
translate brazilian c14s006_Christmas_70289f71:

    # mee "No sabía que lo de saludar con un beso también lo hacías fuera de la familia, [mc]."
    mee "Eu não sabia que você também cumprimentava pessoas com um beijo fora da família, [mc]."

# game/scripts/c14/c14.rpy:3768
translate brazilian c14s006_Christmas_ce786000:

    # nor "No, Mamá, creo que no lo estás pillando..."
    nor "Não, mãe, acho que você não está entendendo..."

# game/scripts/c14/c14.rpy:3771
translate brazilian c14s006_Christmas_b07d62c4:

    # nor "Es tan buen momento como cualquier otro, ¿no?"
    nor "É uma ótima altura, não é?"

# game/scripts/c14/c14.rpy:3772
translate brazilian c14s006_Christmas_5ba0bd3b:

    # mc "Siempre es buen momento para lo que vas a hacer, cielo."
    mc "Sempre é um bom momento para o que você vai fazer, querida."

# game/scripts/c14/c14.rpy:3774
translate brazilian c14s006_Christmas_94a9ae04:

    # "El mundo desaparece a vuestro alrededor. Da lo mismo quién esté ahí, qué caras pongan, o qué piensen de vuestro beso."
    "O mundo desaparece ao seu redor. Não importa quem esteja lá, que expressões façam ou o que pensem do seu beijo."

# game/scripts/c14/c14.rpy:3776
translate brazilian c14s006_Christmas_0fb52211:

    # nor "*Susurrando* Si me desheredan será culpa tuya. *Risa*"
    nor "*Sussurrando* Se eu for deserdado, a culpa será sua. *Risos*"

# game/scripts/c14/c14.rpy:3777
translate brazilian c14s006_Christmas_2c6b27b4:

    # mc "*Susurrando* Pero ¿ha valido la pena?"
    mc "*Sussurrando* Mas valeu a pena?"

# game/scripts/c14/c14.rpy:3778
translate brazilian c14s006_Christmas_1c92cd0a:

    # nor "*Susurrando* Por supuesto. Solo espero que a mi madre no le de un infarto. *Risa*"
    nor "*Sussurrando* Claro. Só espero que minha mãe não tenha um ataque cardíaco. *Risos*"

# game/scripts/c14/c14.rpy:3779
translate brazilian c14s006_Christmas_4b85b44c:

    # mc "*Susurrando* No te preocupes. Samantha siempre lleva un desfibrilador en el coche. *Risa*"
    mc "*Sussurrando* Não se preocupe. Samantha sempre tem um desfibrilador no carro. *Risos*"

# game/scripts/c14/c14.rpy:3780
translate brazilian c14s006_Christmas_dd975be8:

    # "En ese momento os dáis cuenta de que se escuchan voces airadas a vuestro alrededor."
    "Nesse momento você percebe que consegue ouvir vozes raivosas ao seu redor."

# game/scripts/c14/c14.rpy:3782
translate brazilian c14s006_Christmas_60a9057f:

    # mee "... es tu sobrino! ¿Cómo puedes hacer algo así? Además le doblas la edad..."
    mee "...ele é seu sobrinho! Como você pôde fazer uma coisa dessas? Além disso, você tem o dobro da idade dele..."

# game/scripts/c14/c14.rpy:3784
translate brazilian c14s006_Christmas_f3e73158:

    # nor "Mamá, tú siempre has dicho una frase que me ha gustado. No eliges de quién te enamoras. Yo no elegí a [mc], pero me enamoré de él."
    nor "Mãe, você sempre disse algo que eu gostei. A gente não escolhe por quem se apaixona. Eu não escolhi [mc], mas me apaixonei por ele."

# game/scripts/c14/c14.rpy:3786
translate brazilian c14s006_Christmas_7b5af4d3:

    # mc "Meemaw, nos queremos. Igual que quiero a Samantha y a Simone..."
    mc "Vovó, nós nos amamos. Assim como eu amo Samantha e Simone..."

