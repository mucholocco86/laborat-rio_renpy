    # eri "¿Tu quieres que continúe hasta que se corra y no te deje probarlo? *Risa*"
    eri "Você quer que eu continue até ele gozar e não deixar você provar? *Risos*"

# game/scripts/c14/c14.rpy:1081
translate brazilian c14s002_NorEri_602a86a4:

    # nor "No, cielo. Pero puedes continuar si quieres."
    nor "Não, querida. Mas você pode continuar se quiser."

# game/scripts/c14/c14.rpy:1082
translate brazilian c14s002_NorEri_a76ce5ef:

    # mc "Chicas, no discutáis ahora... me estaba poniendo muy cachondo"
    mc "Meninas, não discutam agora... Eu estava ficando muito excitado."

# game/scripts/c14/c14.rpy:1084
translate brazilian c14s002_NorEri_4af49d37:

    # eri "No estabamos discutiendo, cielo. Solo bromeábamos."
    eri "Não estávamos discutindo, querida. Estávamos apenas brincando."

# game/scripts/c14/c14.rpy:1085
translate brazilian c14s002_NorEri_c24b3467:

    # eri "Pero quiero ver esos labios rojos alrededor de tu polla. A lo mejor puedo aprender algo..."
    eri "Mas eu quero ver esses lábios vermelhos em volta do seu pau. Talvez eu possa aprender alguma coisa..."

# game/scripts/c14/c14.rpy:1086
translate brazilian c14s002_NorEri_4fa26376:

    # nor "Lo estabas haciendo muy bien, cariño, ¿verdad, [mc]?."
    nor "Você estava indo muito bem, querida, não estava, [mc]?"

# game/scripts/c14/c14.rpy:1087
translate brazilian c14s002_NorEri_87d6318d:

    # mc "Genial, pero si [eri] ha pedido que continúes tú, ¿se lo vas a negar?"
    mc "Ótimo, mas se [eri] pediu para você continuar, você vai recusar?"

# game/scripts/c14/c14.rpy:1091
translate brazilian c14s002_NorEri_73a934c0:

    # "[nor] no responde y se apodera de tu polla, introduciéndosela profundamente en la boca."
    "[nor] não responde e agarra seu pênis, colocando-o fundo em sua boca."

# game/scripts/c14/c14.rpy:1092
translate brazilian c14s002_NorEri_2c4b49e0:

    # eri "¡Wow! Yo no soy capaz de metérmela tanto... ¿te gusta más así?"
    eri "Uau! Não consigo colocar tão fundo... você prefere assim?"

# game/scripts/c14/c14.rpy:1093
translate brazilian c14s002_NorEri_e26c2dc7:

    # mc "Lo que tú hacías con la lengua era perfecto. Lo que hace tu madre con toda la boca es increíble. Son dos sensaciones diferentes."
    mc "O que você fazia com a língua era perfeito. O que sua mãe faz com a boca toda é incrível. São duas sensações diferentes."

# game/scripts/c14/c14.rpy:1094
translate brazilian c14s002_NorEri_f56eda3e:

    # nor "*Gemido ahogado*"
    nor "*Gemido abafado*"

# game/scripts/c14/c14.rpy:1095
translate brazilian c14s002_NorEri_a6ef2eef:

    # eri "Creo que mi madre quiere decir algo, pero no la acabo de entender. No recuerda que no se debe hablar con la boca llena. *Risa*"
    eri "Acho que minha mãe quer dizer alguma coisa, mas não consigo entendê-la direito. Parece que ela se esqueceu de que não se deve falar de boca cheia. *Risos*"

# game/scripts/c14/c14.rpy:1096
translate brazilian c14s002_NorEri_556e0e7e:

    # mc "Chicas, estoy a punto de llegar..."
    mc "Meninas, estou quase chegando..."

# game/scripts/c14/c14.rpy:1097
translate brazilian c14s002_NorEri_fb1e4508:

    # eri "¿Donde quieres acabar?"
    eri "Onde você quer chegar?"

# game/scripts/c14/c14.rpy:1119
translate brazilian c14s002_NorEri_e7b00c68:

    # mc "¿Ya estáis pensando en la próxima? Yo puedo estar listo en cinco minutos..."
    mc "Você já está pensando no próximo? Posso estar pronto em cinco minutos..."

# game/scripts/c14/c14.rpy:1126
translate brazilian c14s002_NorEri_92302daa:

    # "Justo cuando se vuelven de poner de rodillas delante tuyo oís el motor de un coche y la verja abriéndose. Os han dado el tiempo justo para acabar, aunque no para un segundo round."
    "Assim que eles se afastam, deixando de se ajoelhar diante de você, você ouve o motor de um carro e o portão se abrindo. Você teve tempo suficiente para terminar, mas não o bastante para uma segunda rodada."

# game/scripts/c14/c14.rpy:1128
translate brazilian c14s002_NorEri_063e4613:

    # "Justo en ese momento oís el motor de un coche y la verja abriéndose. Os han dado el tiempo justo para acabar, aunque no para un segundo round."
    "Nesse instante, você ouve o motor de um carro e o portão se abrindo. Você teve tempo suficiente para terminar, mas não o bastante para uma segunda rodada."

# game/scripts/c14/c14.rpy:1129
translate brazilian c14s002_NorEri_5cfaa514:

    # eri "¡Oh, mierda! Un poco más y nos pillan. Vamos a meternos en la piscina..."
    eri "Puxa! Quase fomos pegos. Vamos entrar na piscina..."

# game/scripts/c14/c14.rpy:1131
translate brazilian c14s002_NorEri_8e69189d:

    # mc "Espera... [nor]"
    mc "Aguarde... [nor]"

# game/scripts/c14/c14.rpy:1134
translate brazilian c14s002_NorEri_bcaec58a:

    # mcp "(Espero que lo coja antes de que la vea alguien.)"
    mcp "(Espero que ela veja antes que outra pessoa veja.)"

# game/scripts/c14/c14.rpy:1136
translate brazilian c14s002_NorEri_94cac7dd:

    # "Te terminas de subir el bañador justo cuando aparece [mar]."
    "Você termina de vestir seu maiô exatamente quando [mar] aparece."

# game/scripts/c14/c14.rpy:1138
translate brazilian c14s002_NorEri_94a8561e:

    # mom "Hola, [mc]. ¿Estás solo?"
    mom "Olá, [mc]. Você está sozinho?"

# game/scripts/c14/c14.rpy:1139
translate brazilian c14s002_NorEri_a4a59e92:

    # mc "No, [eri] y [nor] están buceando."
    mc "Não, [eri] e [nor] estão mergulhando."

# game/scripts/c14/c14.rpy:1142
translate brazilian c14s002_NorEri_3f89381e:

    # mc "Mira, por ahí vuelven de su buceo."
    mc "Olha, eles estão voltando do mergulho."

# game/scripts/c14/c14.rpy:1144
translate brazilian c14s002_NorEri_cc9f95d1:

    # nor "Hola, [mar]. Qué pronto habéis vuelto."
    nor "Olá, [mar]. Você voltou tão cedo."

# game/scripts/c14/c14.rpy:1145
translate brazilian c14s002_NorEri_8d8b4a43:

    # eri "Hola, Tía [mar]. ¿Lo habéis comprado todo?"
    eri "Olá, tia [mar]. Você comprou tudo?"

# game/scripts/c14/c14.rpy:1147
translate brazilian c14s002_NorEri_c171d896:

    # mom "Sí, nos ha costado encontrar un gorro para ti, pero lo tenemos todo."
    mom "Sim, foi difícil encontrar um chapéu para você, mas temos de tudo."

# game/scripts/c14/c14.rpy:1149
translate brazilian c14s002_NorEri_52304a51:

    # mom "¡Oops! *Susurrando* [nor], tu bikini no está... donde debería."
    mom "Ops! *Sussurrando* [nor], seu biquíni não está... onde deveria estar."

# game/scripts/c14/c14.rpy:1151
translate brazilian c14s002_NorEri_300412a8:

    # nor "¡Oops! Nada que no hayaís visto ninguno, ¿no? Somos todo chicas... y [mc], que ha visto a las chicas mil veces."
    nor "Ops! Nada que vocês já não tenham visto antes, né? Somos todas garotas... e [mc], que já viu as garotas mil vezes."

# game/scripts/c14/c14.rpy:1153
translate brazilian c14s002_NorEri_847c3402:

    # mom "Vale, pero no hace falta que te exhibas..."
    mom "Tudo bem, mas você não precisa se exibir..."

# game/scripts/c14/c14.rpy:1154
translate brazilian c14s002_NorEri_b81c5011:

    # mc "¿Un gorro para [eri]? No tiene la cabeza grande. *Risa*"
    mc "Um chapéu para [eri]? Ele não tem uma cabeça grande. *Risos*"

# game/scripts/c14/c14.rpy:1156
translate brazilian c14s002_NorEri_e65c66c5:

    # mom "Si es difícil encontrar gorros navideños en Julio, imagínate encontrarlos negros. Tu prima tiene alergia al rojo."
    mom "Se já é difícil encontrar gorros de Natal em julho, imagine encontrar gorros pretos. Seu primo tem alergia à cor vermelha."

# game/scripts/c14/c14.rpy:1158
translate brazilian c14s002_NorEri_3b63eff1:

    # eri "Y al rosa. *Risa*"
    eri "E rosa. *Risos*"

# game/scripts/c14/c14.rpy:1160
translate brazilian c14s002_NorEri_b17220b2:

    # mom "Calla, calla, que [emm] ha encontrado un gorro rosa."
    mom "Silêncio, silêncio, [emm] encontrou um chapéu rosa."

# game/scripts/c14/c14.rpy:1162
translate brazilian c14s002_NorEri_42ff8788:

    # nor "Lo de [emm] con el rosa..."
    nor "A questão do [emm] com rosa..."

# game/scripts/c14/c14.rpy:1163
translate brazilian c14s002_NorEri_3688b5d7:

    # eri "¡Eso tengo que verlo!"
    eri "Preciso ver isso!"

# game/scripts/c14/c14.rpy:1164
translate brazilian c14s002_NorEri_1c8ff853:

    # mc "Id vosotras. Yo prefiero la sorpresa mañana. Iré a ducharme."
    mc "Pode ir em frente. Prefiro a surpresa amanhã. Vou tomar um banho."

# game/scripts/c14/c14.rpy:1166
translate brazilian c14s002_NorEri_0264b280:

    # nor "Hasta luego, [mc]."
    nor "Até logo, [mc]."

# game/scripts/c14/c14.rpy:1167
translate brazilian c14s002_NorEri_e4fd4856:

    # eri "¡Vale! Nos vemos luego."
    eri "Ok! Até mais."

# game/scripts/c14/c14.rpy:1169
translate brazilian c14s002_NorEri_1cdac493:

    # mom "Hasta luego, [mc]."
    mom "Até logo, [mc]."

# game/scripts/c14/c14.rpy:1172
translate brazilian c14s002_NorEri_c0425391:

    # "Las tres se van, riéndose de algo que no puedes escuchar. Tan parecidas y diferentes a la vez."
    "Os três saem, rindo de algo que você não consegue ouvir. Tão semelhantes e, no entanto, tão diferentes."

# game/scripts/c14/c14.rpy:1177
translate brazilian c14s002_CumInNor_37c393c6:

    # "Explotas en la boca de [nor] mientras [eri] le sujeta la cabeza."
    "Você explode na boca de [nor] enquanto [eri] segura a cabeça dele."

# game/scripts/c14/c14.rpy:1178
translate brazilian c14s002_CumInNor_6082d9cb:

    # mc "¡Mpfft!"
    mc "Mpfft!"

# game/scripts/c14/c14.rpy:1179
translate brazilian c14s002_CumInNor_77c69cba:

    # eri "¡Déjame algo para mí!"
    eri "Deixe um pouco para mim!"

# game/scripts/c14/c14.rpy:1181
translate brazilian c14s002_CumInNor_b0b312d4:

    # "Después de limpiar tu polla, [nor] te mira inquisitivamente."
    "Depois de limpar seu pênis, [nor] olha para você com uma expressão interrogativa."

# game/scripts/c14/c14.rpy:1182
translate brazilian c14s002_CumInNor_3bb18810:

    # mc "¿Me estás preguntando que hacer con la corrida?"
    mc "Você está me perguntando o que fazer em relação à tourada?"

# game/scripts/c14/c14.rpy:1184
translate brazilian c14s002_CumInNor_cbe5a83f:

    # "[nor] asiente."
    "[nor] acena com a cabeça."

# game/scripts/c14/c14.rpy:1194
translate brazilian c14s002_CumInNor_1f17efd2:

    # "Las dos te miran con sorpresa inicial, pasando después a una sonrisa de pillería tras mirarse."
    "Os dois olham para você com surpresa inicial, que depois se transforma em um sorriso travesso após se entreolharem."

# game/scripts/c14/c14.rpy:1196
translate brazilian c14s002_CumInNor_a2d18649:

    # "[nor] se incorpora un poco antes de dejar caer tu corrida en la boca abierta de [eri]."
    "[nor] se senta um pouco antes de ejacular na boca aberta de [eri]."

# game/scripts/c14/c14.rpy:1197
translate brazilian c14s002_CumInNor_9da58a1a:

    # mc "¡Wow! Eso ha sido muy tórrido..."
    mc "Uau! Isso foi realmente sensual..."

# game/scripts/c14/c14.rpy:1201
translate brazilian c14s002_CumInNor_4f21fd3f:

    # "[nor] deja caer su cabeza hasta que sus labios rozan los de su hija, para sorpesa de ésta."
    "[nor] ela baixa a cabeça até que seus lábios toquem os da filha, para surpresa desta."

# game/scripts/c14/c14.rpy:1203
translate brazilian c14s002_CumInNor_34ee1e7e:

    # "[nor] deja caer su cabeza hasta que sus labios rozan los de la que pasa por su hija, para sorpesa de ésta."
    "[nor] Ela baixa a cabeça até que seus lábios roçam nos da mulher que se passa por sua filha, para grande surpresa desta última."

# game/scripts/c14/c14.rpy:1205
translate brazilian c14s002_CumInNor_e153f049:

    # "[eri] tarda un segundo en devolverle el beso a su madre. Si antes era tórrido, ahora casi podrías arder solo con ver esa imagen."
    "[eri] Ele leva um segundo para retribuir o beijo da mãe. Se antes já era intenso, agora só de olhar para essa imagem já dá vontade de pegar fogo."

# game/scripts/c14/c14.rpy:1206
translate brazilian c14s002_CumInNor_c4265770:

    # mc "¡Wow! Eso es mejor todavía..."
    mc "Uau! Isso é ainda melhor..."

# game/scripts/c14/c14.rpy:1208
translate brazilian c14s002_CumInNor_522e5fe5:

    # nor "¿Qué te ha parecido?"
    nor "O que você achou?"

# game/scripts/c14/c14.rpy:1209
translate brazilian c14s002_CumInNor_c725c79d:

    # mc "¡Increíble! Que dos mujeres como vosotras me coman así... sin palabras..."
    mc "Incrível! Que duas mulheres como vocês me devorem assim... sem palavras..."

# game/scripts/c14/c14.rpy:1211
translate brazilian c14s002_CumInNor_c5b75135:

    # mc "Y el beso final... ¡Ufff!"
    mc "E o beijo final... Ufa!"

# game/scripts/c14/c14.rpy:1212
translate brazilian c14s002_CumInNor_c203cee2:

    # eri "Después de la sorpresa inicial ha sido una experiencia impresionante..."
