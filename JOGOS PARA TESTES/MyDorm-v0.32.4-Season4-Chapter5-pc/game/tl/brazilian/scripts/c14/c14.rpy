# game/scripts/c14/c14.rpy:3890
translate brazilian c14s006_Christmas_16d0abd3:

    # mee "¡Pero eso es porque eran unos clasistas y John estaba sin blanca! ¿Tú ves esto normal?"
    mee "Mas isso porque eles eram elitistas e o John estava falido! Você acha isso normal?"

# game/scripts/c14/c14.rpy:3892
translate brazilian c14s006_Christmas_85a1caa0:

    # mee "¡Son familia, por el amor de Dios!"
    mee "Eles são família, pelo amor de Deus!"

# game/scripts/c14/c14.rpy:3894
translate brazilian c14s006_Christmas_d5e2b20e:

    # mee "¡La diferencia de edad es enorme!"
    mee "A diferença de idade é enorme!"

# game/scripts/c14/c14.rpy:3896
translate brazilian c14s006_Christmas_c507a76b:

    # bet "Y cuantos más impedimentos pongas, más fuerte se va a hacer su relación. ¿No lo puedes ver?"
    bet "E quanto mais obstáculos você colocar no caminho deles, mais forte o relacionamento deles se tornará. Você não percebe isso?"

# game/scripts/c14/c14.rpy:3897
translate brazilian c14s006_Christmas_ad5eff57:

    # bet "En África he visto relaciones de todo tipo. Las que tú consideras normales y las que no. De los dos tipos han funcionado y de los dos tipos se han roto."
    bet "Na África, vi todos os tipos de relacionamentos. Os que você considera normais e os que não considera. Ambos os tipos deram certo, e ambos os tipos fracassaram."

# game/scripts/c14/c14.rpy:3898
translate brazilian c14s006_Christmas_176835aa:

    # bet "Esto parece especial, ¿no?"
    bet "Parece especial, não é?"

# game/scripts/c14/c14.rpy:3900
translate brazilian c14s006_Christmas_aaf505d1:

    # mee "*Gruñido* Especial es una forma suave de llamarlo."
    mee "*Grunhido* \"Especial\" é uma forma suave de dizer isso."

# game/scripts/c14/c14.rpy:3902
translate brazilian c14s006_Christmas_aa190cb1:

    # bet "Y nuestro [mc] también es especial, ¿no?"
    bet "E o nosso [mc] também é especial, não é?"

# game/scripts/c14/c14.rpy:3904
translate brazilian c14s006_Christmas_d2a724d6:

    # mee "*Gruñido* Sí, ya se ve que es especial."
    mee "*Grunhido* É, dá para perceber que ele é especial."

# game/scripts/c14/c14.rpy:3906
translate brazilian c14s006_Christmas_60017145:

    # bet "¿Por qué no le das un voto de confianza a ver que sale de esta relación?"
    bet "Por que você não dá uma chance e vê o que acontece com esse relacionamento?"

# game/scripts/c14/c14.rpy:3908
translate brazilian c14s006_Christmas_7391561a:

    # mee "*Gruñido* ¡Qué fácil es para ti decirlo!"
    mee "*Grunhido* Como é fácil para você dizer isso!"

# game/scripts/c14/c14.rpy:3910
translate brazilian c14s006_Christmas_e646a744:

    # kia "Sé que me voy a meter en un asunto familiar en el que no pinto nada, pero escuchadme un momento, por favor."
    kia "Sei que estou me intrometendo em um assunto familiar que não me diz respeito, mas, por favor, me escutem por um instante."

# game/scripts/c14/c14.rpy:3911
translate brazilian c14s006_Christmas_46fff3ea:

    # kia "Cuando [mc] empezó a salir con mi Eileen, no veía ningún futuro a esa relación. Me parecía que [mc] no era lo suficientemente bueno para mi hija."
    kia "Quando ele começou a namorar minha filha Eileen, eu não via futuro algum naquele relacionamento. Sentia que ele não era bom o suficiente para minha filha."

# game/scripts/c14/c14.rpy:3913
translate brazilian c14s006_Christmas_fc9b7e22:

    # mee "¿Qué? ¿Estás diciendo que mi nieto no era lo suficientemente bueno?"
    mee "O quê? Você está dizendo que meu neto não era bom o suficiente?"

# game/scripts/c14/c14.rpy:3915
translate brazilian c14s006_Christmas_ab6f5705:

    # bet "Déjala acabar, por Dios, Olivia."
    bet "Deixe-a terminar, pelo amor de Deus, Olivia."

# game/scripts/c14/c14.rpy:3917
translate brazilian c14s006_Christmas_684fb2d6:

    # kia "Gracias, Betty."
    kia "Obrigada, Betty."

# game/scripts/c14/c14.rpy:3918
translate brazilian c14s006_Christmas_7d17a230:

    # kia "Si me hubiera opuesto a su relación, la hubiera hecho más fuerte artificialmente. Y el tiempo me demostró que estaba equivocada."
    kia "Se eu tivesse me oposto ao relacionamento deles, eu o teria fortalecido artificialmente. E o tempo provou que eu estava errado."

# game/scripts/c14/c14.rpy:3919
translate brazilian c14s006_Christmas_715381ec:

    # kia "Si hay alguien capaz de sacar adelante esta relación, por diferente que sea, es [mc]."
    kia "Se existe alguém capaz de fazer este relacionamento funcionar, por mais diferente que seja, é [mc]."

# game/scripts/c14/c14.rpy:3920
translate brazilian c14s006_Christmas_887f84c9:

    # mc "Gracias, Kiara."
    mc "Obrigada, Kiara."

# game/scripts/c14/c14.rpy:3921
translate brazilian c14s006_Christmas_76045841:

    # mc "Por cierto, las chicas no saben nada y solo es decisión nuestra cuándo y dónde decírselo, con lo que cuento con vuestra discrección."
    mc "Aliás, as meninas não sabem de nada e a decisão de quando e onde contar a elas é exclusivamente nossa, então conto com a sua discrição."

# game/scripts/c14/c14.rpy:3923
translate brazilian c14s006_Christmas_afc07c9b:

    # kia "Ningún problema. Estoy totalmente de acuerdo y es un asunto vuestro."
    kia "Sem problema. Concordo plenamente, e isso é problema seu."

# game/scripts/c14/c14.rpy:3924
translate brazilian c14s006_Christmas_6869a41f:

    # mee "*Gruñido* Vale."
    mee "*Grunhido* Ok."

# game/scripts/c14/c14.rpy:3925
translate brazilian c14s006_Christmas_94723c11:

    # bet "Es lo lógico. La noticia puede caer como una bomba."
    bet "Isso é lógico. A notícia pode ser bombástica."

# game/scripts/c14/c14.rpy:3927
translate brazilian c14s006_Christmas_67f94806:

    # mc "Perfecto, porque por allí vienen con el hielo. Espero que tengamos la fiesta en paz y no le amargues la Navidad a nadie, Meemaw."
    mc "Perfeito, porque eles vêm com o gelo. Espero que possamos ter uma celebração tranquila e que você não estrague o Natal de ninguém, vovó."

# game/scripts/c14/c14.rpy:3929
translate brazilian c14s006_Christmas_e3a2a239:

    # mee "*Gruñido* Vale. Pero tú y yo vamos a tener que hablar cuando lleguemos a casa."
    mee "*Resmungo* Tudo bem. Mas você e eu vamos ter que conversar quando chegarmos em casa."

# game/scripts/c14/c14.rpy:3932
translate brazilian c14s006_Christmas_83f290af:

    # mee "No estoy protestando. Tan solo creía que era una cosa que hacía dentro de la familia."
    mee "Não estou protestando. Apenas pensei que fosse algo que eu fazia em família."

# game/scripts/c14/c14.rpy:3934
translate brazilian c14s006_Christmas_e6315368:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Eis que chegam as garotas com o gelo."

# game/scripts/c14/c14.rpy:3938
translate brazilian c14s006_Christmas_e6315368_1:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Eis que chegam as garotas com o gelo."

# game/scripts/c14/c14.rpy:3940
translate brazilian c14s006_Christmas_e91e0cfe:

    # mc "Ya solo faltan por llegar Alexia y Saira, y podremos ir a comer."
    mc "Alexia e Saira são as únicas que ainda não chegaram, e aí podemos ir comer."

# game/scripts/c14/c14.rpy:3942
translate brazilian c14s006_Christmas_12de1401:

    # "Mientras esperáis a Alexia y Saira, se van formando grupitos de conversación."
    "Enquanto você espera por Alexia e Saira, pequenos grupos de pessoas começam a se formar."

# game/scripts/c14/c14.rpy:3945
translate brazilian c14s006_Christmas_978b03ad:

    # "[mar] y [nor] se apartan para discutir lo que acaba de pasar tras lanzarte una mirada indicándote que no te acerques."
    "[mar] e [nor] se afastam para discutir o que acabou de acontecer, depois de lhe lançarem um olhar indicando que você não deveria se aproximar mais."

# game/scripts/c14/c14.rpy:3947
translate brazilian c14s006_Christmas_1ba577de:

    # "[mar] y [nor] se apartan para charlar después de indicarte con una mirada que no te acerques."
    "[mar] e [nor] se afastam para conversar depois de indicarem com um olhar que você não deve se aproximar."

# game/scripts/c14/c14.rpy:3950
translate brazilian c14s006_Christmas_f7e19f40:

    # "Samantha y Kiara empiezan a charlar. Supones por los gestos que la conversación va tanto sobre el brazo como sobre el beso."
    "Samantha e Kiara começam a conversar. Pelos gestos delas, dá para perceber que a conversa gira em torno do braço e do beijo."

# game/scripts/c14/c14.rpy:3951
translate brazilian c14s006_Christmas_e1fc02fa:

    # "Tienes que darle las gracias a Kiara en algún momento, pero prefieres no acercarte."
    "Você terá que agradecer à Kiara em algum momento, mas prefere não abordá-la."

# game/scripts/c14/c14.rpy:3953
translate brazilian c14s006_Christmas_86266bc7:

    # "Samantha y Kiara empiezan a charlar sobre el brazo."
    "Samantha e Kiara começam a conversar sobre o braço."

# game/scripts/c14/c14.rpy:3955
translate brazilian c14s006_Christmas_0888e985:

    # "[dap] y Scarlett han secuestrado a Simone y ha empezado a presentarles a las chicas. Hasta ahora solo conocía a Debbie."
    "[dap] e Scarlett sequestraram Simone e começaram a apresentá-la às meninas. Até agora, ela só conhecia Debbie."

# game/scripts/c14/c14.rpy:3957
translate brazilian c14s006_Christmas_7f47eb10:

    # "[emm] y Eileen se quedan apartadas. Parece que tienen cosas que decirse."
    "[emm] e Eileen estão afastadas. Parece que têm algo a dizer uma à outra."

# game/scripts/c14/c14.rpy:3959
translate brazilian c14s006_Christmas_f7f18243:

    # "Tan solo esperas que a [emm] no se le escapen más secretos de los necesarios."
    "Você só espera que [emm] não deixe escapar mais segredos do que o necessário."

# game/scripts/c14/c14.rpy:3962
translate brazilian c14s006_Christmas_35ac3e9e:

    # "[eri] acude a hacer compañía a Meemaw y Betty, que parecían a punto de tener una discusión."
    "[eri] vai fazer companhia a Meemaw e Betty, que pareciam prestes a discutir."

# game/scripts/c14/c14.rpy:3973
translate brazilian c14s006_Christmas_102ac85a:

    # "A lo lejos ves aparecer a Saira. Parece que se ha cambiado nada más bajar del taxi que la ha traído de la universidad."
    "Ao longe, você vê Saira aparecer. Parece que ela mudou assim que saiu do táxi que a trouxe da universidade."

# game/scripts/c14/c14.rpy:3975
translate brazilian c14s006_Christmas_9457da45:

    # "[emm] te hace señas para que te acerques mientras llama a Saira."
    "[emm] sinaliza para você se aproximar enquanto chama Saira."

# game/scripts/c14/c14.rpy:3976
translate brazilian c14s006_Christmas_d276daf7:

    # emm "¡Saira! Ven aquí, quiero presentarte a alguien."
    emm "Saira! Venha cá, quero te apresentar a alguém."

# game/scripts/c14/c14.rpy:3978
translate brazilian c14s006_Christmas_135d3b44:

    # sai "Hola, [emm]. Gracias por mandarme la ubicación. Como Lisa se ha ido antes, no sabía donde era."
    sai "Olá, [emm]. Obrigada por me enviar a localização. Como a Lisa saiu mais cedo, eu não sabia onde era."

# game/scripts/c14/c14.rpy:3981
translate brazilian c14s006_Christmas_0a337b23:

    # emm "No pasa nada, lo mejor para nuestras clientas, ¿no?"
    emm "Não tem problema, é o melhor para os nossos clientes, certo?"

# game/scripts/c14/c14.rpy:3984
translate brazilian c14s006_Christmas_f77bdc26:

    # emm "No pasa nada, para eso estamos las amigas, ¿no?"
    emm "Tudo bem, é para isso que servem os amigos, não é?"

# game/scripts/c14/c14.rpy:3985
translate brazilian c14s006_Christmas_c3f90b4c:

    # emm "Por cierto, te presento a Eileen. Eileen, esta es Saira."
    emm "A propósito, deixe-me apresentar-lhe Eileen. Eileen, esta é Saira."

# game/scripts/c14/c14.rpy:3988
translate brazilian c14s006_Christmas_156b44f1:

    # sai "Así que tú eres la famosa Eileen, con la que {b}rompió{/b} antes de estar conmigo, ¿no? Encantada. de. conocerte."
    sai "Então você é a famosa Eileen, aquela com quem ele terminou antes de ficar comigo, certo? Prazer em conhecê-la."

# game/scripts/c14/c14.rpy:3990
translate brazilian c14s006_Christmas_e64a05aa:

    # sai "Así que tú eres la famosa Eileen, la {b}ex-novia{/b} del instituto, ¿no? Encantada. de. conocerte."
    sai "Então você é a famosa Eileen, a ex-namorada do ensino médio, certo? Prazer em conhecê-la."

# game/scripts/c14/c14.rpy:3992
translate brazilian c14s006_Christmas_92867534:

    # eil "Y tú eres la ex-novia de Portland... Ah, no, perdona... la {b}follamiga{/b} de Portland. No sé si puedo decir lo mismo sobre conocerte."
    eil "E você é a ex-namorada do Portland... Ah, não, desculpe... a ficante do Portland. Não sei se posso dizer o mesmo sobre te conhecer."

# game/scripts/c14/c14.rpy:3994
translate brazilian c14s006_Christmas_9c321a78:

    # emm "Bueno, os dejo aquí a los tres para que os pongáis al día. Voy a hablar con la abuela antes de que muerda a Tía Betty."
    emm "Certo, vou deixar vocês três aqui para conversarem. Vou falar com a vovó antes que ela dê uma bronca na tia Betty."

# game/scripts/c14/c14.rpy:3995
translate brazilian c14s006_Christmas_b45e6e58:

    # mc "*Susurrando* Sabes que la puedes haber liado, ¿no?"
    mc "*Sussurrando* Você sabe que pode ter feito besteira, né?"

# game/scripts/c14/c14.rpy:3996
translate brazilian c14s006_Christmas_617af5c0:

    # emm "Tarde o temprano se tenían que conocer. Las dos viven en casa... Suerte con las fieras. *Risa*"
    emm "Eles estavam fadados a se encontrar mais cedo ou mais tarde. Ambos moram em casa... Boa sorte com os animais selvagens. *Risos*"

# game/scripts/c14/c14.rpy:3998
translate brazilian c14s006_Christmas_12cb9bdf:

    # sai "Me alegra conocerte por fin. Solo había visto fotos tuyas. Estabas mejor en las fotos."
    sai "Que bom finalmente te conhecer. Eu só tinha visto fotos suas. Você parecia mais bonita nas fotos."

# game/scripts/c14/c14.rpy:3999
translate brazilian c14s006_Christmas_caa48aef:

    # eil "Bueno, al menos de mí estaba lo suficientemente orgulloso como para enseñar fotos. Yo no sabía el aspecto que tenías. No me sorprende."
    eil "Bom, pelo menos tive orgulho suficiente de mim mesma para mostrar fotos. Eu não sabia como você era. Não me surpreende."

# game/scripts/c14/c14.rpy:4000
translate brazilian c14s006_Christmas_dda9ef10:

    # mc "Chicas..."
    mc "Garotas..."

# game/scripts/c14/c14.rpy:4002
translate brazilian c14s006_Christmas_cfa05590:

    # sai "Bueno, a lo mejor no quería enseñarte fotos mías para que no te sintieras mal."
    sai "Bem, talvez eu não quisesse te mostrar fotos minhas para que você não se sentisse mal."

# game/scripts/c14/c14.rpy:4003
translate brazilian c14s006_Christmas_694d9386:

    # eil "O es posible que sea por que se avergonzaba de haber salido... perdón, haberse acostado contigo."
    eil "Ou talvez seja porque ele estava envergonhado de ter saído... quer dizer, de ter dormido com você."

# game/scripts/c14/c14.rpy:4004
translate brazilian c14s006_Christmas_09a87050:

    # mc "Chicas, dejadlo ya, por favor."
    mc "Meninas, por favor, parem com isso."

# game/scripts/c14/c14.rpy:4006
translate brazilian c14s006_Christmas_a9e4b562:

    # sai "Al menos yo no me lié con nadie una vez lo dejamos, putón."
    sai "Pelo menos eu não fiquei com ninguém depois que terminamos, sua vadia."

# game/scripts/c14/c14.rpy:4007
translate brazilian c14s006_Christmas_19030c30:

    # eil "¿Quién coño querría liarse contigo? Si le tuviste que dejar la puerta abierta a que se liara con otras... Fea."
    eil "Quem em sã consciência ia querer ficar com você? Você deixou a porta aberta para ele ficar com outras mulheres... Que coisa feia."

# game/scripts/c14/c14.rpy:4009
translate brazilian c14s006_Christmas_8f27b491:

    # sai "¿Ya se ha ido?" (multiple=2)
    sai "Ele já foi embora?" (multiple=2)

# game/scripts/c14/c14.rpy:4010
translate brazilian c14s006_Christmas_146f3b81:

    # eil "¿No nos ve?" (multiple=2)
    eil "Você não consegue nos ver?" (multiple=2)

# game/scripts/c14/c14.rpy:4011
translate brazilian c14s006_Christmas_3b396030:

    # mc "¿Qué? ¿Quién?"
    mc "O quê? Quem?"

# game/scripts/c14/c14.rpy:4013
translate brazilian c14s006_Christmas_bd8cfe57:

    # sai "Tu hermana." (multiple=2)
    sai "Sua irmã." (multiple=2)

# game/scripts/c14/c14.rpy:4014
translate brazilian c14s006_Christmas_4392ef66:

    # eil "[emm]." (multiple=2)
    eil "[emm]." (multiple=2)

# game/scripts/c14/c14.rpy:4015
translate brazilian c14s006_Christmas_3f59ed2d:

    # mc "Sí... ya se ha ido. ¿Por qué?"
    mc "Sim... ele já foi embora. Por quê?"

# game/scripts/c14/c14.rpy:4018
translate brazilian c14s006_Christmas_0d78fc0a:

    # eil "¿Qué tal el primer día de clase?"
    eil "Como foi seu primeiro dia de aula?"

# game/scripts/c14/c14.rpy:4019
translate brazilian c14s006_Christmas_3e91fc64:

    # sai "Muy pesado, pero por fin ha acabado y me puedo relajar con vosotras."
    sai "Foi muito difícil, mas finalmente acabou e posso relaxar com todos vocês."

# game/scripts/c14/c14.rpy:4020
translate brazilian c14s006_Christmas_db98c677:

    # mc "¿Qué? ¿Qué está pasando aquí? No entiendo nada."
    mc "O quê? O que está acontecendo aqui? Não entendo nada."

# game/scripts/c14/c14.rpy:4022
translate brazilian c14s006_Christmas_3602adb2:

    # eil "Saira y yo nos conocimos anoche, nos presentó [eri]."
    eil "Saira e eu nos conhecemos ontem à noite, ela nos apresentou [eri]."

# game/scripts/c14/c14.rpy:4023
translate brazilian c14s006_Christmas_a02bac1e:

    # sai "Estaba en la piscina tomando el aire después de cenar. Tenía que digerir la conversación contigo. Entonces llegaron las dos."
    sai "Eu estava à beira da piscina tomando um ar fresco depois do jantar. Precisava processar nossa conversa. Então, os dois chegaram."

# game/scripts/c14/c14.rpy:4025
translate brazilian c14s006_Christmas_63d8eaa0:

    # eil "Digamos que la conversación empezó más o menos como la de ahora, pero [eri] puso paz."
    eil "Digamos que a conversa começou mais ou menos como está agora, mas [eri] fez as pazes."

# game/scripts/c14/c14.rpy:4026
translate brazilian c14s006_Christmas_13bf4b37:

    # sai "Bueno, fue un poco más suave..."
    sai "Bem, foi um pouco mais ameno..."

# game/scripts/c14/c14.rpy:4028
translate brazilian c14s006_Christmas_c0dbabff:

    # eil "Sí, te has pasado con lo de putón. Además tú eso no lo debías saber... y solo fueron un par de citas, no me acosté con nadie."
    eil "Sim, você foi longe demais me chamando de vadia. Além disso, você não deveria saber disso... e foram só alguns encontros, eu não transei com ninguém."

# game/scripts/c14/c14.rpy:4029
translate brazilian c14s006_Christmas_102e2bcb:

    # sai "¿Y lo de llamarme fea? ¿Tenemos 10 años, Eileen? *Risa*"
    sai "E quanto a me chamar de feia? Temos 10 anos, Eileen? *Risos*"

# game/scripts/c14/c14.rpy:4030
translate brazilian c14s006_Christmas_311c06b0:

    # mc "Estoy flipando..."
    mc "Estou surtando..."

# game/scripts/c14/c14.rpy:4032
translate brazilian c14s006_Christmas_164be0b6:

    # eil "[eri] nos dijo que no nos sorprendiéramos si [emm] intentaba enfrentarnos hoy de alguna forma."
    eil "[eri] nos disse para não nos surpreendermos se [emm] tentasse nos confrontar hoje de alguma forma."

# game/scripts/c14/c14.rpy:4034
translate brazilian c14s006_Christmas_3824816c:

    # eil "{i}(Y ahora que sé que está contigo, la entiendo perfectamente. Si peleábamos delante tuyo nos ridiculizaríamos a nosotras mismas.){/i}"
    eil "{i}(E agora que sei que ela está com você, eu a entendo perfeitamente. Se tivéssemos brigado na sua frente, teríamos passado vergonha.){/i}"

# game/scripts/c14/c14.rpy:4035
translate brazilian c14s006_Christmas_726c3f15:

    # eil "Supongo que tener a dos ex-novias en la misma comida navideña podía ser un riesgo."
    eil "Imagino que ter duas ex-namoradas no mesmo jantar de Natal possa ser um risco."

# game/scripts/c14/c14.rpy:4037
translate brazilian c14s006_Christmas_076eb4a7:

    # sai "¿Ya no soy la follamiga? *Risa* ¿He ascendido a ex-novia?"
    sai "Eu deixei de ser apenas sua ficante? *Risos* Fui promovida a ex-namorada?"

# game/scripts/c14/c14.rpy:4039
translate brazilian c14s006_Christmas_b8cfd6a9:

    # sai "Después de lo que dijo [eri], Eileen y yo estuvimos hablando largo y tendido."
    sai "Depois do que [eri] disse, Eileen e eu tivemos uma longa conversa."

# game/scripts/c14/c14.rpy:4041
translate brazilian c14s006_Christmas_aa265f5d:

    # sai "Tú me habías dicho que estabas con Eileen. Era raro estar hablando con ella en la piscina, después de un mes comiéndome la cabeza."
    sai "Você me disse que estava com a Eileen. Foi estranho conversar com ela na piscina depois de um mês obcecado por ela."

# game/scripts/c14/c14.rpy:4043
translate brazilian c14s006_Christmas_d4423745:

    # sai "Tú me habías dicho que no habías vuelto con Eileen, pero era raro estar hablando con ella en la piscina después de un mes comiéndome la cabeza."
    sai "Você tinha me dito que não tinha voltado com a Eileen, mas era estranho estar conversando com ela na piscina depois de um mês dela me enlouquecendo."

# game/scripts/c14/c14.rpy:4045
translate brazilian c14s006_Christmas_234e5c34:

    # eil "Empezamos como dos perras celosas, especialmente Saira, y acabamos contándonos los mejores momentos que hemos pasado contigo."
    eil "Começamos como duas loucas ciumentas, principalmente a Saira, e terminamos contando uma à outra os melhores momentos que tivemos com você."

# game/scripts/c14/c14.rpy:4047
translate brazilian c14s006_Christmas_340c7610:

    # eil "Parece que vuelves a estar con las dos... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "Parece que você voltou com as duas... sim, a Saira deixou escapar. Que bom para você, a Saira será uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:4049
translate brazilian c14s006_Christmas_96103bf0:

    # eil "Parece que vuestro reencuentro fue más frío que el nuestro, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Parece que o reencontro de vocês foi mais frio que o nosso, mas você deveria reconsiderar. Saira seria uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:4051
translate brazilian c14s006_Christmas_8147fbdd:

    # eil "Parece que vuestro reencuentro no fue tan frío como el nuestro... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "Parece que o reencontro de vocês não foi tão frio quanto o nosso... sim, a Saira deixou escapar. Que bom para você, a Saira será uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:4053
translate brazilian c14s006_Christmas_16813b17:

    # eil "Parece que nuestros reencuentros contigo fueron igual de frío, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Parece que nossos reencontros foram tão frios quanto antes, mas você deveria reconsiderar. Saira seria uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:4054
translate brazilian c14s006_Christmas_583e6a89:

    # mc "¿Qué? ¿Le has dicho lo del harén?"
    mc "O quê? Você contou para ele sobre o harém?"

# game/scripts/c14/c14.rpy:4056
translate brazilian c14s006_Christmas_ef0f64a8:

    # mc "No hay harén, solo estoy saliendo con Saira."
    mc "Não existe harém, eu só estou namorando a Saira."

# game/scripts/c14/c14.rpy:4059
translate brazilian c14s006_Christmas_0a11ba44:

    # mc "No hay harén, solo estoy saliendo contigo."
    mc "Não existe harém, eu só estou namorando você."

# game/scripts/c14/c14.rpy:4061
translate brazilian c14s006_Christmas_a8320589:

    # mc "No hay harén, solo estoy saliendo con una chica."
    mc "Não existe harém, eu só estou namorando uma garota."

# game/scripts/c14/c14.rpy:4063
translate brazilian c14s006_Christmas_e1841300:

    # sai "Después de hablar bastante rato..."
    sai "Depois de conversarmos por um bom tempo..."

# game/scripts/c14/c14.rpy:4065
translate brazilian c14s006_Christmas_1e128303:

    # sai "Nos dimos cuenta de que si estás con las dos es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Percebemos que, se você está com as duas, é porque colocamos a ideia de um relacionamento aberto e de um harém na sua cabeça."

# game/scripts/c14/c14.rpy:4067
translate brazilian c14s006_Christmas_62551a4f:

    # sai "Nos dimos cuenta de que si estás con Eileen y yo puedo tener una oportunidad, es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Percebemos que, se você está com a Eileen e eu temos uma chance, é porque colocamos a ideia de um relacionamento aberto e de um harém na sua cabeça."

# game/scripts/c14/c14.rpy:4070
translate brazilian c14s006_Christmas_d23144e1:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me haya dado la oportunidad que necesitaba para volver contigo."
    sai "Percebi que a proposta de Eileen de formar um harém com você pode ter me dado a oportunidade que eu precisava para voltar para você."

# game/scripts/c14/c14.rpy:4072
translate brazilian c14s006_Christmas_6fd24c25:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me de la oportunidad que necesitaba para volver contigo en el futuro."
    sai "Percebi que a proposta de Eileen de formar um harém com você poderia me dar a oportunidade que eu precisava para reatarmos o relacionamento no futuro."

# game/scripts/c14/c14.rpy:4074
translate brazilian c14s006_Christmas_56102810:

    # sai "Después nos pasamos un rato riendo." (multiple=2)
    sai "Depois disso, passamos algum tempo rindo." (multiple=2)

# game/scripts/c14/c14.rpy:4075
translate brazilian c14s006_Christmas_bf25048c:

    # eil "Y comparando notas. *Risa*" (multiple=2)
    eil "E comparando anotações. *Risos*" (multiple=2)

# game/scripts/c14/c14.rpy:4076
translate brazilian c14s006_Christmas_3c1a15a5:

    # sai "Descubrimos que no somos rivales." (multiple=2)
    sai "Descobrimos que não somos rivais." (multiple=2)

# game/scripts/c14/c14.rpy:4077
translate brazilian c14s006_Christmas_12db876d:

    # eil "Y decidimos hacernos amigas." (multiple=2)
    eil "E decidimos nos tornar amigos." (multiple=2)

# game/scripts/c14/c14.rpy:4079
translate brazilian c14s006_Christmas_f9ce5a32:

    # eil "Saira no podía creerse que [emm] fuera a intentar algo como lo que ha hecho, pero yo la conozco mejor."
    eil "Saira não conseguia acreditar que [emm] tentaria algo como o que ela fez, mas eu a conheço melhor."

# game/scripts/c14/c14.rpy:4081
translate brazilian c14s006_Christmas_7dad870f:

    # sai "Traté poco con ella ayer, parecía enfadada, pero creía que tenía que ver con la situación de Scarlett."
    sai "Não falei muito com ela ontem; ela parecia irritada, mas achei que tinha algo a ver com a situação da Scarlett."

# game/scripts/c14/c14.rpy:4083
translate brazilian c14s006_Christmas_e55bb51d:

    # sai "Traté poco con ella ayer, parecía una chica muy agradable."
    sai "Não conversei muito com ela ontem, mas ela parecia ser uma garota muito simpática."

# game/scripts/c14/c14.rpy:4084
translate brazilian c14s006_Christmas_e29c8e39:

    # mc "Es muy agradable... cuando quiere. Supongo que querrá después de que le de unos azotes. *Risa*"
    mc "Ele é muito legal... quando quer. Acho que vai querer depois que eu lhe der umas palmadas. *Risos*"

# game/scripts/c14/c14.rpy:4086
translate brazilian c14s006_Christmas_2a35a010:

    # eil "Déjale creer que nos hemos peleado. Será una pequeña victoria en su cabeza."
    eil "Deixe-o acreditar que tivemos uma briga. Será uma pequena vitória na cabeça dele."

# game/scripts/c14/c14.rpy:4087
translate brazilian c14s006_Christmas_11c00290:

    # sai "Y nos dará tiempo de planear nuestra venganza. *Risa*"
    sai "E isso nos dará tempo para planejar nossa vingança. *Risos*"

# game/scripts/c14/c14.rpy:4089
translate brazilian c14s006_Christmas_2891af26:

    # mc "Haced que parezca un accidente. Por allí viene la última invitada y sospecharía enseguida de vosotras."
    mc "Faça parecer um acidente. A última hóspede está vindo por aqui e suspeitaria de você imediatamente."

# game/scripts/c14/c14.rpy:4100
translate brazilian c14s006_Christmas_00d216ac:

    # mc "Alexia, ven. Quiero presentarte a alguien."
    mc "Alexia, venha cá. Quero te apresentar a alguém."

# game/scripts/c14/c14.rpy:4101
translate brazilian c14s006_Christmas_14e3d577:

    # mc "Alexia, Saira. Saira, Alexia."
    mc "Alexia, Saira. Saira, Alexia."

# game/scripts/c14/c14.rpy:4103
translate brazilian c14s006_Christmas_8777e192:

    # oma "Encantada de conocerte, Saira. ¿Eres la última estudiante?"
    oma "Prazer em conhecê-la, Saira. Você é a última aluna?"

# game/scripts/c14/c14.rpy:4104
translate brazilian c14s006_Christmas_042239fa:

    # sai "Sí, llegué ayer. ¿Eres amiga de la familia?"
    sai "Sim, cheguei ontem. Você é amigo da família?"

# game/scripts/c14/c14.rpy:4105
translate brazilian c14s006_Christmas_fe99e360:

    # oma "Más o menos. He tenido que ayudar a [mc] en algunas cosas."
    oma "Mais ou menos. Tive que ajudar [mc] com algumas coisas."

# game/scripts/c14/c14.rpy:4106
translate brazilian c14s006_Christmas_874d55fb:

    # oma "Hola, Eileen. Tenemos que hablar."
    oma "Olá, Eileen. Precisamos conversar."

# game/scripts/c14/c14.rpy:4108
translate brazilian c14s006_Christmas_a68d3962:

    # mc "¿Qué tal el viaje, Alexia?"
    mc "Como foi sua viagem, Alexia?"

# game/scripts/c14/c14.rpy:4109
translate brazilian c14s006_Christmas_f915a04a:

    # oma "Muy pesado, pero al menos ya estoy aquí."
    oma "Foi uma longa jornada, mas pelo menos estou aqui agora."

# game/scripts/c14/c14.rpy:4110
translate brazilian c14s006_Christmas_716d306f:

    # oma "Me tienes que contar qué querías el lunes cuando me llamaste."
    oma "Você precisa me dizer o que queria na segunda-feira, quando me ligou."

# game/scripts/c14/c14.rpy:4111
translate brazilian c14s006_Christmas_325f881f:

    # mc "Te tengo que contar muchas cosas, Alexia, pero habrá tiempo."
    mc "Tenho muita coisa para te contar, Alexia, mas haverá tempo."

# game/scripts/c14/c14.rpy:4112
translate brazilian c14s006_Christmas_caa9a5c2:

    # mc "Creo que te estaban esperando para comer. A estas alturas Tía Betty se tiene que estar muriendo de hambre."
    mc "Acho que estavam esperando você comer. Tia Betty deve estar morrendo de fome agora."

# game/scripts/c14/c14.rpy:4115
translate brazilian c14s006_Christmas_3f8bae97:

    # "Recogéis las sombrillas y las sillas y os dirigís al merendero."
    "Você recolhe os guarda-chuvas e as cadeiras e se dirige para a área de piquenique."

# game/scripts/c14/c14.rpy:4117
translate brazilian c14s006_Christmas_171f3852:

    # "Emma y Scarlett reparten gorros navideños para todos."
    "Emma e Scarlett distribuem gorros de Natal para todos."

# game/scripts/c14/c14.rpy:4119
translate brazilian c14s006_Christmas_6d2bc954:

    # "Después de lo que ha pasado durante la mañana, no te extraña que los grupos se entremezclen."
    "Depois do que aconteceu esta manhã, não é de admirar que os grupos estejam se misturando."

# game/scripts/c14/c14.rpy:4121
translate brazilian c14s006_Christmas_007c3147:

    # "No parece haber diferencia entre familia, estudiantes, y las chicas de la ciudad."
    "Não parece haver diferença entre famílias, estudantes e garotas da cidade."

# game/scripts/c14/c14.rpy:4123
translate brazilian c14s006_Christmas_06c9ac7f:

    # "Todo el mundo parece dispuesto a pasárselo bien y disfrutar de la comida."
    "Todos parecem prontos para se divertir e aproveitar a comida."

# game/scripts/c14/c14.rpy:4125
translate brazilian c14s006_Christmas_1d87fb41:

    # "Algunos gorros duran poco en las cabezas y acaban encima de la mesa. Hace demasiado calor para llevarlos en pleno verano."
    "Alguns chapéus não ficam muito tempo na cabeça e acabam em cima da mesa. Faz muito calor para usá-los no meio do verão."

# game/scripts/c14/c14.rpy:4127
translate brazilian c14s006_Christmas_a9208bfb:

    # "Es vuestra primera Navidad juntos. ¿Quién sabe cómo será la próxima, la de verdad?"
    "Este é o primeiro Natal de vocês juntos. Quem sabe como será o próximo, o verdadeiro?"

# game/scripts/c14/c14.rpy:4136
translate brazilian c14s006_Christmas_b2b9fa2b:

    # "Hay más gente que te gustaría que estuviera aquí. Y todavía faltan por llegar las últimas estudiantes. En la Navidad de verdad estarán."
    "Há mais pessoas que você gostaria de ver aqui. E os últimos alunos ainda estão para chegar. Eles ficarão aqui para o Natal."

# game/scripts/c14/c14.rpy:4137
translate brazilian c14s006_Christmas_2031e2a1:

    # "¿Pero habrá vuelto Meemaw a Florida por entonces? ¿Tía Betty estará en algún hospital de África?"
    "Mas será que a vovó já terá voltado para a Flórida até lá? Será que a tia Betty estará em algum hospital na África?"

# game/scripts/c14/c14.rpy:4139
translate brazilian c14s006_Christmas_b3eee4f3:

    # "La sonrisa de Scarlett te saca de tus ensoñaciones."
    "O sorriso de Scarlett te desperta dos seus devaneios."

# game/scripts/c14/c14.rpy:4140
translate brazilian c14s006_Christmas_4b9e4cd6:

    # sca "¿Pasa algo, [mc]? Te veo ausente..."
    sca "Aconteceu alguma coisa, [mc]? Você parece distante..."

# game/scripts/c14/c14.rpy:4141
translate brazilian c14s006_Christmas_85f4e9f8:

    # mc "No, cielo, no pasa nada. Solo estaba pensando en la próxima Navidad, la de verdad."
    mc "Não, querida, está tudo bem. Eu só estava pensando no próximo Natal, o de verdade."

# game/scripts/c14/c14.rpy:4143
translate brazilian c14s006_Christmas_0a62ee21:

    # sca "La verdad es que ésta ha salido un poco sosa, ¿cierto? Al final es un día de playa comiendo con ridículos gorros navideños."
    sca "Sinceramente, este acabou sendo um pouco sem graça, não é? No fim das contas, é só um dia na praia comendo e usando chapéus de Natal ridículos."

# game/scripts/c14/c14.rpy:4144
translate brazilian c14s006_Christmas_007ebe11:

    # mc "¡Hey! No es nada sosa. No había visto nunca a 19 personas pasándoselo bien juntos sin malos rollos. Y menos habiendo familia en la mezcla."
    mc "Ei! Não tem nada de chato nisso. Nunca vi 19 pessoas se divertindo tanto juntas, sem nenhum drama. Principalmente com a família envolvida."

# game/scripts/c14/c14.rpy:4146
translate brazilian c14s006_Christmas_bcfa7996:

    # sca "La verdad es que tienes una familia increíble. Gracias por acogerme, [mc]. A [nor], a [mar] y a las chicas las he inundado de gracias, pero si no hubiera sido por ti..."
    sca "A verdade é que você tem uma família incrível. Obrigada por me receber, [mc]. Já agradeci muito às meninas [nor] e [mar], mas se não fosse por você..."

# game/scripts/c14/c14.rpy:4147
translate brazilian c14s006_Christmas_12abece5:

    # mc "No hace falta que des las gracias. Y te equivocas en una cosa, no tengo una familia increíble. La tenemos. Tú, yo, las chicas..."
    mc "Você não precisa me agradecer. E você está enganada em uma coisa: eu não tenho uma família incrível. Nós temos sim. Você, eu, as meninas..."

# game/scripts/c14/c14.rpy:4148
translate brazilian c14s006_Christmas_a9087ca8:

    # mc "Mira lo que has conseguido que hagamos y dime que no parecemos una gran familia."
    mc "Olha só o que você nos fez fazer e me diga se não parecemos uma grande família."

# game/scripts/c14/c14.rpy:4149
translate brazilian c14s006_Christmas_f015529a:

    # sca "*Risa* Nada que ver con mi concepto de familia. No hay nadie discutiendo. Me podría acostumbrar a esto."
    sca "*Risos* Isso não tem nada a ver com o meu conceito de família. Ninguém está discutindo. Eu poderia me acostumar com isso."

# game/scripts/c14/c14.rpy:4150
translate brazilian c14s006_Christmas_6d4d214a:

    # mc "Lo harás. No pensamos dejarte escapar. *Risa*"
    mc "Você vai. Não vamos deixar você escapar. *Risos*"

# game/scripts/c14/c14.rpy:4152
translate brazilian c14s006_Christmas_b110a990:

    # sca "¡Vamos a hacernos una foto juntos!"
    sca "Vamos tirar uma foto juntos!"

# game/scripts/c14/c14.rpy:4153
translate brazilian c14s006_Christmas_7e57e035:

    # mc "¿Una selfie?"
    mc "Uma selfie?"

# game/scripts/c14/c14.rpy:4154
translate brazilian c14s006_Christmas_f81b7379:

    # sca "No, tonto, una foto de toda la familia junta."
    sca "Não, bobinho, uma foto de toda a família reunida."

# game/scripts/c14/c14.rpy:4155
translate brazilian c14s006_Christmas_57d4b6c8:

    # mc "¡Vamos!"
    mc "Vamos!"

# game/scripts/c14/c14.rpy:4157
translate brazilian c14s006_Christmas_d54ed7b9:

    # "Scarlett propone la foto y todo el mundo responde entusiasmado."
    "Scarlett sugere a foto e todos respondem com entusiasmo."

# game/scripts/c14/c14.rpy:4159
translate brazilian c14s006_Christmas_2117895e:

    # todas "¡Feliz Navidad!"
    todas "Feliz Natal!"

# game/scripts/c14/c14.rpy:4160
translate brazilian c14s006_Christmas_71f0ba30:

    # "Con el paso del tiempo, los que salís en la foto consideraréis ese momento como el pistoletazo de salida para vuestra familia."
    "Com o passar do tempo, aqueles de vocês que estão na foto considerarão aquele momento como o ponto de partida para a sua família."

# game/scripts/c14/c14.rpy:4161
translate brazilian c14s006_Christmas_1eb8fe7c:

    # "Las chicas que se unirán a la familia en los próximos meses mirarán la foto deseando haber estado allí, haber formado parte de la familia desde el primer día."
    "As meninas que se juntarão à família nos próximos meses olharão para a foto desejando ter estado lá, desejando ter feito parte da família desde o primeiro dia."

# game/scripts/c14/c14.rpy:4162
translate brazilian c14s006_Christmas_6299b99f:

    # "Nadie lo sabe en ese momento, pero esa foto acabará en el despacho de la primera Gobernadora de California muchos años después."
    "Ninguém sabia disso na época, mas aquela foto acabaria no gabinete da primeira governadora da Califórnia muitos anos depois."

# game/scripts/c14/c14.rpy:4163
translate brazilian c14s006_Christmas_0b08f94d:

    # "Y más años después todavía, estará encima del escritorio Resolute, en el despacho Oval. Pero esa es otra historia."
    "E, anos mais tarde, estará na mesa Resolute, no Salão Oval. Mas essa é outra história."

# game/scripts/c14/c14.rpy:4165
translate brazilian c14s006_Christmas_d79c5293:

    # "Después de la foto todo el mundo sigue con sus conversaciones. Si la conversación era animada antes, ahora lo es incluso más."
    "Depois da foto, todos voltam às suas conversas. Se a conversa já era animada antes, agora está ainda mais animada."

# game/scripts/c14/c14.rpy:4167
translate brazilian c14s006_Christmas_7dbeec67:

    # dap "Nos deberiamos ir yendo, [mc]."
    dap "Devemos começar a sair, [mc]."

# game/scripts/c14/c14.rpy:4168
translate brazilian c14s006_Christmas_1384af00:

    # mc "¿A dónde?"
    mc "Para onde?"

# game/scripts/c14/c14.rpy:4170
translate brazilian c14s006_Christmas_845213ff:

    # dap "No te acuerdas, ¿verdad? Tenemos que ir a la tienda de Maddie para hacer vuestros personajes de DnD."
    dap "Você não se lembra, né? Precisamos ir à loja da Maddie para criar seus personagens de D&D."

# game/scripts/c14/c14.rpy:4171
translate brazilian c14s006_Christmas_feeb53b3:

    # mc "Pues no, no me acordaba para nada."
    mc "Não, eu não me lembrava de nada."

# game/scripts/c14/c14.rpy:4172
translate brazilian c14s006_Christmas_d0ab2d02:

    # mc "Vamos a despedirnos de todo el mundo, cogemos unos gorros, y vamos para allí. Voy a ver si queda alguna botella de cava."
    mc "Vamos nos despedir de todos, pegar uns chapéus e ir até lá. Vou ver se ainda tem alguma garrafa de cava."

# game/scripts/c14/c14.rpy:4174
translate brazilian c14s006_Christmas_b05ff61a:

    # dap "¿Cava? ¿Gorros?"
    dap "Cava? Chapéus?"

# game/scripts/c14/c14.rpy:4175
translate brazilian c14s006_Christmas_1c1f91b1:

    # mc "No querrás dejar a Maddie sin celebrar la Navidad, ¿verdad? *Risa*"
    mc "Você não gostaria de deixar a Maddie sem comemorar o Natal, gostaria? *Risos*"

# game/scripts/c14/c14.rpy:4181
translate brazilian c14s006_KissMartha_774bc444:

    # mom "¿Te importa?"
    mom "Isso importa para você?"

# game/scripts/c14/c14.rpy:4182
translate brazilian c14s006_KissMartha_98a2015f:

    # mc "No, hace tiempo que lo estaba deseando."
    mc "Não, eu já queria fazer isso há muito tempo."

# game/scripts/c14/c14.rpy:4185
translate brazilian c14s006_KissMartha_142cd168:

    # "Tal como ha pasado con [nor], el mundo vuelve a desaparecer. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "Assim como em [nor], o mundo desaparece novamente. Você sabe que a voz da vovó está ficando mais alta, mas escolhe não ouvir."

# game/scripts/c14/c14.rpy:4187
translate brazilian c14s006_KissMartha_7eb6706a:

    # "El mundo desaparece a vuestro alrededor. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "O mundo desaparece ao seu redor. Você sabe que a voz da vovó está ficando mais alta, mas escolhe não ouvir."

# game/scripts/c14/c14.rpy:4189
translate brazilian c14s006_KissMartha_fc4dea53:

    # mom "No sabes que peso de encima me he quitado."
    mom "Você não faz ideia do alívio que senti."

# game/scripts/c14/c14.rpy:4190
translate brazilian c14s006_KissMartha_6b85ac1c:

    # mc "Lo sé. Salir a la luz es una sensación increíble."
    mc "Eu sei. Vir à tona é uma sensação incrível."

# game/scripts/c14/c14.rpy:4191
translate brazilian c14s006_KissMartha_f7ae8057:

    # mom "Ahora viene el problema. ¿Nos giramos y las escuchamos?"
    mom "E agora surge o problema. Será que vamos nos virar e ouvi-los?"

# game/scripts/c14/c14.rpy:4193
translate brazilian c14s006_KissMartha_0e30a3fb:

    # mee "¿Estáis todos locos? ¿Sabéis lo que estáis haciendo?"
    mee "Vocês estão todos loucos? Sabem o que estão fazendo?"

# game/scripts/c14/c14.rpy:4225
translate brazilian c14s007_MaddieDnD_4c84d95a:

    # "Llegáis a la tienda de ropa y Maddie está sola, no hay ningún cliente."
    "Você chega à loja de roupas e Maddie está sozinha, não há clientes."

# game/scripts/c14/c14.rpy:4228
translate brazilian c14s007_MaddieDnD_061e2002:

    # mad "Buenas tardes, [dap]. [mc]."
    mad "Boa tarde, [dap]. [mc]."

# game/scripts/c14/c14.rpy:4229
translate brazilian c14s007_MaddieDnD_7b78d6ee:

    # mc "Hola, Maddie. ¿No tienes clientes hoy?"
    mc "Oi Maddie. Você não tem nenhum cliente hoje?"

# game/scripts/c14/c14.rpy:4230
translate brazilian c14s007_MaddieDnD_ad0568c2:

    # mad "No suele haber clientes a esta hora en los días laborables. Un poco más tarde quizás."
    mad "Normalmente não há clientes neste horário durante a semana. Talvez um pouco mais tarde."

# game/scripts/c14/c14.rpy:4232
translate brazilian c14s007_MaddieDnD_f23f573a:

    # dap "Entonces genial. Podemos hacer vuestros personajes sin interrupción."
    dap "Ótimo! Podemos trabalhar nos seus personagens sem interrupções."

# game/scripts/c14/c14.rpy:4233
translate brazilian c14s007_MaddieDnD_42961c19:

    # mc "Pero antes vamos a brindar, ¿no?"
    mc "Mas primeiro, vamos fazer um brinde, que tal?"

# game/scripts/c14/c14.rpy:4235
translate brazilian c14s007_MaddieDnD_f5d43592:

    # mad "¿Brindar? ¿Por qué?"
    mad "Um brinde? Por quê?"

# game/scripts/c14/c14.rpy:4236
translate brazilian c14s007_MaddieDnD_4901a442:

    # mc "Hemos celebrado una fiesta navideña en la playa y te hemos traído un poco de cava... sin alcohol, que tú estás trabajando y yo tengo que conducir luego."
    mc "Fizemos uma festa de Natal na praia e trouxemos um pouco de cava para você... sem álcool, porque você está trabalhando e eu tenho que dirigir depois."

# game/scripts/c14/c14.rpy:4237
translate brazilian c14s007_MaddieDnD_fbc35e0b:

    # mad "¿Navidad? ¿En Julio? ¿Para eso queríais los gorros de Santa ayer?"
    mad "Natal? Em julho? Era para isso que você queria gorros de Papai Noel ontem?"

# game/scripts/c14/c14.rpy:4239
translate brazilian c14s007_MaddieDnD_3bc0af21:

    # dap "Sí, por lo visto es una costumbre italiana y Scarlett, mi amiga, leyo sobre ella. Lo propuso y lo hemos hecho. *Risa*"
    dap "Sim, aparentemente é um costume italiano, e minha amiga Scarlett leu sobre isso. Ela sugeriu, e nós fizemos. *Risos*"

# game/scripts/c14/c14.rpy:4240
translate brazilian c14s007_MaddieDnD_fe055228:

    # mc "Ha sido divertido. Un dia de playa normal y comida con los gorros. Mucho espíritu navideño sin que nadie discutiera."
    mc "Foi divertido. Um dia normal na praia e um almoço com chapéus de aba larga. Muito espírito natalino e ninguém discutindo."

# game/scripts/c14/c14.rpy:4242
translate brazilian c14s007_MaddieDnD_995e76bd:

    # dap "Y sin regalos..."
    dap "E sem presentes..."

# game/scripts/c14/c14.rpy:4243
translate brazilian c14s007_MaddieDnD_a11e50be:

    # mc "¿Quieres un regalo? Estás en una tienda de ropa... corre de mi cuenta. *Risa*"
    mc "Quer um presente? Você está numa loja de roupas... é por minha conta. *Risos*"

# game/scripts/c14/c14.rpy:4245
translate brazilian c14s007_MaddieDnD_cfb16629:

    # mad "Estáis locos, pero trae ese champagne. *Risa*"
    mad "Vocês são todos malucos, mas tragam o champanhe. *Risos*"

# game/scripts/c14/c14.rpy:4246
translate brazilian c14s007_MaddieDnD_06553e8d:

    # mc "Es cava..."
    mc "É vinho espumante..."

# game/scripts/c14/c14.rpy:4247
translate brazilian c14s007_MaddieDnD_2dca0aea:

    # mad "Bueno, lo que sea. *Risa*"
    mad "Tá bom, tanto faz. *Risos*"

# game/scripts/c14/c14.rpy:4249
translate brazilian c14s007_MaddieDnD_003746c6:

    # mc "Feliz Navidad, Maddie."
    mc "Feliz Natal, Maddie."

# game/scripts/c14/c14.rpy:4250
translate brazilian c14s007_MaddieDnD_04b7c815:

    # dap "¡Feliz Navidad!" (multiple=2)
    dap "Feliz Natal!" (multiple=2)

# game/scripts/c14/c14.rpy:4251
translate brazilian c14s007_MaddieDnD_0c9ede57:

    # mad "¡Feliz Navidad, chicos!" (multiple=2)
    mad "Feliz Natal, pessoal!" (multiple=2)

# game/scripts/c14/c14.rpy:4253
translate brazilian c14s007_MaddieDnD_482f9740:

    # dap "¿Podemos hacer los personajes ya? He traído la tablet para apuntar los datos. En casa, [emm] hará una ilustración de vuestros personajes y tendréis la hoja de personaje en papel."
    dap "Podemos começar a criar os personagens agora? Trouxe o tablet para anotar as informações. Em casa, [emm] fará uma ilustração dos seus personagens e você receberá a ficha de personagem impressa."

# game/scripts/c14/c14.rpy:4254
translate brazilian c14s007_MaddieDnD_074455aa:

    # mc "Me vas a tener que explicar como funciona todo."
    mc "Você vai ter que me explicar como tudo funciona."

# game/scripts/c14/c14.rpy:4255
translate brazilian c14s007_MaddieDnD_1241d032:

    # dap "Ningún problema. Ya te expliqué el mundo. Ahora te enseñaré las reglas."
    dap "Sem problema. Eu já expliquei o mundo para você. Agora vou te ensinar as regras."

# game/scripts/c14/c14.rpy:4257
translate brazilian c14s007_MaddieDnD_1511a305:

    # mad "Deberías explicarme el mundo a mí también."
    mad "Você também deveria me explicar o mundo."

# game/scripts/c14/c14.rpy:4258
translate brazilian c14s007_MaddieDnD_2029f14a:

    # mc "Es super original, al menos para alguien que nunca ha jugado a esto."
    mc "É super original, pelo menos para quem nunca jogou esse jogo antes."

# game/scripts/c14/c14.rpy:4266
translate brazilian c14s007_MaddieDnD_6f7a6ac9:

    # dap "Imagínate nuestro mundo a finales del Siglo II. El Imperio Romano está en su auge. Entonces se abren una serie de portales a otros mundos y entran los diferentes seres de fantasía."
    dap "Imagine nosso mundo no final do século II. O Império Romano está em seu auge. Então, uma série de portais para outros mundos se abrem, e diferentes seres fantásticos entram."

# game/scripts/c14/c14.rpy:4267
translate brazilian c14s007_MaddieDnD_7e12dd88:

    # dap "Elfos, orcos, enanos, dragones... Pero no solo entran ellos, sino que además sus Dioses les acompañan. Y también la magia."
    dap "Elfos, orcs, anões, dragões... Mas eles não são os únicos que entram; seus deuses os acompanham. E a magia também."

# game/scripts/c14/c14.rpy:4269
translate brazilian c14s007_MaddieDnD_9bc0bac6:

    # mad "Pobres romanos. Les va a caer la del pulpo."
    mad "Pobres romanos. Eles vão receber o que merecem."

# game/scripts/c14/c14.rpy:4270
translate brazilian c14s007_MaddieDnD_c1d3dfb0:

    # mc "Yo pensé lo mismo, pero espera..."
    mc "Eu pensei a mesma coisa, mas espere..."

# game/scripts/c14/c14.rpy:4272
translate brazilian c14s007_MaddieDnD_be5d83ef:

    # dap "Esos pueblos aparecen muy al norte y muy al sur. Elfos, Enanos y Medianos en Escandinavia, los pueblos faericos en las Islas Británicas, y los Orcos y Goblins en Siberia."
    dap "Esses povos aparecem muito ao norte e muito ao sul. Elfos, anões e halflings na Escandinávia, os povos feéricos nas Ilhas Britânicas e orcs e goblins na Sibéria."

# game/scripts/c14/c14.rpy:4273
translate brazilian c14s007_MaddieDnD_7e3d5ef7:

    # dap "Hay otras razas en otras partes del planeta de las que vuestros personajes no han oído hablar, con lo que no entraré en ello."
    dap "Existem outras raças em outras partes do planeta das quais seus personagens nunca ouviram falar, então não vou entrar em detalhes."

# game/scripts/c14/c14.rpy:4274
translate brazilian c14s007_MaddieDnD_333a7a0c:

    # dap "La parte que nos interesa es Europa. La partida se desarrolla en lo que hoy en día es Austria."
    dap "A parte que nos interessa é a Europa. O jogo se passa no que hoje é a Áustria."

# game/scripts/c14/c14.rpy:4276
translate brazilian c14s007_MaddieDnD_99bcbc7b:

    # mad "Déjame adivinar, los pueblos que llegan se pelan a los Germanos y los Alpes se convierten en la frontera."
    mad "Deixe-me adivinhar, os povos que chegam lutam contra os alemães e os Alpes se tornam a fronteira."

# game/scripts/c14/c14.rpy:4278
translate brazilian c14s007_MaddieDnD_48023f27:

    # dap "Más o menos. Los Germanos desaparecen, son absorbidos, o se refugian en el Imperio, y los Enanos fundan sus reinos en la cara norte de los Alpes."
    dap "Mais ou menos. Os alemães desaparecem, são absorvidos ou refugiam-se no Império, e os anões fundam seus reinos no lado norte dos Alpes."

# game/scripts/c14/c14.rpy:4279
translate brazilian c14s007_MaddieDnD_fda8cec8:

    # dap "Los elfos atraviesan la Galia y se establecen en lo que sería España, Portugal y el sur de Francia."
    dap "Os elfos atravessam a Gália e se estabelecem no que viria a ser a Espanha, Portugal e o sul da França."

# game/scripts/c14/c14.rpy:4280
translate brazilian c14s007_MaddieDnD_5218815c:

    # dap "Los romanos no tienen nada que hacer sin magia en ese momento y reciben hostias en todos lados. En menos de un siglo han perdido toda Europa Occidental."
    dap "Os romanos estavam indefesos sem magia naquele momento e estavam sendo derrotados por todos os lados. Em menos de um século, eles perderam toda a Europa Ocidental."

# game/scripts/c14/c14.rpy:4281
translate brazilian c14s007_MaddieDnD_4d42de70:

    # dap "Pero junto con las razas invasoras también han llegado Dioses que no son adorados por ninguna raza. Esos Dioses se identifican con el Panteón Romano y empiezan a dar poderes a sus sacerdotes."
    dap "Mas, juntamente com as raças invasoras, vieram também deuses que não são adorados por nenhuma raça. Esses deuses se identificam com o panteão romano e começam a conceder poder aos seus sacerdotes."

# game/scripts/c14/c14.rpy:4283
translate brazilian c14s007_MaddieDnD_a5917141:

    # mad "Y eso equilibra la balanza. Las legiones con clérigos curándolas pueden ser un espectáculo."
    mad "E isso equilibra as coisas. Legiões com clérigos curando seus membros podem ser um espetáculo e tanto."

# game/scripts/c14/c14.rpy:4284
translate brazilian c14s007_MaddieDnD_aef893fb:

    # mad "¿Qué hay del Cristianismo?"
    mad "E quanto ao cristianismo?"

# game/scripts/c14/c14.rpy:4286
translate brazilian c14s007_MaddieDnD_84736935:

    # dap "Prácticamente desaparece, igual que el judaísmo. En un mundo con múltiples Dioses dando poderes a sus clérigos, el precepto del único Dios verdadero no se sustenta."
    dap "Isso praticamente desaparece, assim como o judaísmo. Num mundo com múltiplos deuses que concedem poder ao seu clero, o preceito do único Deus verdadeiro não pode ser sustentado."

# game/scripts/c14/c14.rpy:4287
translate brazilian c14s007_MaddieDnD_37ed1056:

    # dap "Y ningún Dios quiere dar poderes a los sacerdotes de esos Dioses. Si lo hacen, estarían negando la existencia de otros Dioses que está muy clara."
    dap "E nenhum deus quer dar poder aos sacerdotes desses deuses. Se o fizessem, estariam negando a existência de outros deuses, o que é perfeitamente óbvio."

# game/scripts/c14/c14.rpy:4289
translate brazilian c14s007_MaddieDnD_b5d4dd59:

    # mad "Me gusta, tiene lógica. Pero aún queda la magia de los magos... Los elfos tienen y los romanos no."
    mad "Eu gosto, faz sentido. Mas ainda existe a magia dos feiticeiros... Os elfos a têm, e os romanos não."

# game/scripts/c14/c14.rpy:4291
translate brazilian c14s007_MaddieDnD_6c90460d:

    # dap "Los humanos no somos tontos del todo y en el primer siglo de luchas la gente aprende cómo funciona la magia. Los nuevos Dioses les ayudan a entenderlo."
    dap "Os humanos não são totalmente estúpidos, e no primeiro século de lutas, as pessoas aprendem como a magia funciona. Os novos deuses os ajudam a compreendê-la."

# game/scripts/c14/c14.rpy:4293
translate brazilian c14s007_MaddieDnD_c1eab4a3:

    # dap "Total que la paz se establece al cabo de un siglo y medio. El norte de los Alpes y de los Cárpatos son los Reinos Enanos."
    dap "Assim, a paz foi finalmente estabelecida após um século e meio. As terras ao norte dos Alpes e dos Cárpatos tornaram-se os Reinos Anões."

# game/scripts/c14/c14.rpy:4294
translate brazilian c14s007_MaddieDnD_a89899b3:

    # dap "España, Portugal y el sur de Francia es territorio elfo. Italia, los Balcanes, Turquía, y toda la costa del Mediterraneo menos lo que tienen los elfos es Romano."
    dap "Espanha, Portugal e o sul da França são território élfico. Itália, os Balcãs, a Turquia e toda a costa do Mediterrâneo, com exceção das áreas élficas, são romanas."

# game/scripts/c14/c14.rpy:4296
translate brazilian c14s007_MaddieDnD_25678638:

    # dap "Pasan los siglos y los Enanos empiezan a expandirse echando a los Elfos de sus territorios. El Macizo Central de Francia, los Pirineos, y al final toda España."
    dap "Passam-se séculos e os Anões começam a expandir-se, expulsando os Elfos dos seus territórios: o Maciço Central da França, os Pirenéus e, eventualmente, toda a Espanha."

# game/scripts/c14/c14.rpy:4297
translate brazilian c14s007_MaddieDnD_52fceac4:

    # dap "En este mundo la enemistad de Elfos y Enanos nace ahí. Los Elfos que quedan tienen que pedir asilo en el Imperio Romano, que se parece más al final de la Edad Media."
    dap "Neste mundo, a inimizade entre elfos e anões tem origem aí. Os elfos restantes precisam buscar asilo no Império Romano, que se assemelha mais ao final da Idade Média."

# game/scripts/c14/c14.rpy:4298
translate brazilian c14s007_MaddieDnD_e61e64b8:

    # dap "Ahí empieza el equivalente del Renacimiento en este mundo. Algunos siglos antes. En lo que sería nuestro Siglo X, pero sin Cristianismo nadie le llama así."
    dap "É aí que começa o equivalente ao Renascimento neste mundo. Alguns séculos antes. No que seria o nosso século X, mas sem o cristianismo, ninguém o chamaria assim."

# game/scripts/c14/c14.rpy:4300
translate brazilian c14s007_MaddieDnD_52dd91f2:

    # mad "Me gusta. ¿Y qué pasa en Asia? Querría hacerme un personaje que viniera de allí, si es posible."
    mad "Gostei. E quanto à Ásia? Gostaria de criar um personagem que fosse de lá, se possível."

# game/scripts/c14/c14.rpy:4302
translate brazilian c14s007_MaddieDnD_2ca7a2ec:

    # dap "Ningún problema. Los Orcos le han dado de hostias a los Chinos. No hay ningún Dios que les quiera ayudar porque ponen a su Emperador al mismo nivel que los Dioses."
    dap "Sem problema. Os Orcs massacraram os chineses. Nenhum deus quer ajudá-los porque eles colocam seu Imperador no mesmo nível dos deuses."

# game/scripts/c14/c14.rpy:4303
translate brazilian c14s007_MaddieDnD_8894c41e:

    # mc "Creo que yo eso no lo tengo que saber, ¿no? Mientras se lo explicas voy al lavabo. ¿Dónde está, Maddie?"
    mc "Acho que não preciso saber disso, né? Enquanto você explica para ela, vou ao banheiro. Onde está a Maddie?"

# game/scripts/c14/c14.rpy:4305
translate brazilian c14s007_MaddieDnD_dc7a102f:

    # mad "La puerta de la izquierda de los probadores da a un pasillo. Ahí está el lavabo."
    mad "A porta à esquerda dos provadores dá para um corredor. A pia fica lá."

# game/scripts/c14/c14.rpy:4306
translate brazilian c14s007_MaddieDnD_0d2bbdb7:

    # mc "OK, Ahora vuelvo."
    mc "Ok, já volto."

# game/scripts/c14/c14.rpy:4308
translate brazilian c14s007_MaddieDnD_be862ec1:

    # "Acabas de lavarte las manos después de hacer eso que solo puedes hacer sentado, cuando..."
    "Você acabou de lavar as mãos depois de fazer aquela coisa que só dá para fazer sentado, quando..."

# game/scripts/c14/c14.rpy:4310
translate brazilian c14s007_MaddieDnD_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c14/c14.rpy:4311
translate brazilian c14s007_MaddieDnD_75924a45:

    # mad "*A través de la puerta* ¿Te encuentras bien? Ya hemos acabado mi personaje."
    mad "*Através da porta* Você está bem? Terminamos com meu personagem."

# game/scripts/c14/c14.rpy:4312
translate brazilian c14s007_MaddieDnD_e617c3f5:

    # mc "Si, ahora salgo. Habéis sido muy rápidas."
    mc "Sim, estou saindo agora. Você foi muito rápido."

# game/scripts/c14/c14.rpy:4313
translate brazilian c14s007_MaddieDnD_474d4131:

    # mad "*A través de la puerta* Con la aplicación que tiene [dap] en la tablet el personaje se hace muy rápido."
    mad "*Pela porta* Com o aplicativo que [dap] tem no tablet, o personagem é criado muito rapidamente."

# game/scripts/c14/c14.rpy:4315
translate brazilian c14s007_MaddieDnD_f3c3dd4b:

    # mc "¿Qué te has hecho?"
    mc "O que você fez consigo mesmo?"

# game/scripts/c14/c14.rpy:4316
translate brazilian c14s007_MaddieDnD_d0c83c5b:

    # mad "*Risa* Tendrás que esperar a la partida para descubrirlo. Puede ser muy divertido."
    mad "*Risos* Você terá que esperar até o jogo para descobrir. Pode ser muito divertido."

# game/scripts/c14/c14.rpy:4319
translate brazilian c14s007_MaddieDnD_fe3a1791:

    # mad "Tenía ganas de estar a solas contigo. Feliz Navidad."
    mad "Eu estava ansiosa para ficar a sós com você. Feliz Natal."

# game/scripts/c14/c14.rpy:4320
translate brazilian c14s007_MaddieDnD_87b0ef7f:

    # mc "Feliz Navidad, preciosa."
    mc "Feliz Natal, linda."

# game/scripts/c14/c14.rpy:4322
translate brazilian c14s007_MaddieDnD_ab09920f:

    # mad "¿Quieres que volvamos a quedar el viernes en mi casa?"
    mad "Você quer se encontrar de novo na sexta-feira na minha casa?"

# game/scripts/c14/c14.rpy:4323
translate brazilian c14s007_MaddieDnD_f6b4a967:

    # mc "Por mí genial. ¿Otra película?"
    mc "Isso me parece ótimo. Outro filme?"

# game/scripts/c14/c14.rpy:4325
translate brazilian c14s007_MaddieDnD_ffb66364:

    # mad "Para no acabar de verla, mejor no empezarla, ¿no?"
    mad "Se você não vai terminar de assistir, é melhor nem começar, certo?"

# game/scripts/c14/c14.rpy:4326
translate brazilian c14s007_MaddieDnD_34a4903f:

    # mc "Tienes razón. ¿Te recojo a las 6 como la semana pasada?"
    mc "Você tem razão. Devo te buscar às 6 como na semana passada?"

# game/scripts/c14/c14.rpy:4328
translate brazilian c14s007_MaddieDnD_6bebe949:

    # mad "Perfecto. A ver si esta vez no te tienes que ir con prisas."
    mad "Perfeito. Espero que você não precise se apressar desta vez."

# game/scripts/c14/c14.rpy:4329
translate brazilian c14s007_MaddieDnD_d272b675:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Puxa! Acabei de me lembrar que talvez precise buscar uma amiga em Westport na sexta-feira. Mas não sei a que horas, ou mesmo se precisarei buscá-la."

# game/scripts/c14/c14.rpy:4331
translate brazilian c14s007_MaddieDnD_b7d653e7:

    # mad "Lástima. Si no puedes venir a recogerme, podemos quedar directamente en mi casa."
    mad "Que pena. Se você não puder vir me buscar, podemos nos encontrar diretamente na minha casa."

# game/scripts/c14/c14.rpy:4332
translate brazilian c14s007_MaddieDnD_c7ee817a:

    # mc "En cuanto sepa algo te lo digo. Espero poder venir."
    mc "Avisarei assim que souber de algo. Espero poder ir."

# game/scripts/c14/c14.rpy:4335
translate brazilian c14s007_MaddieDnD_eeb50fb2:

    # mad "Quería hacer esto, pero no quería dejarte en evidencia delante de tu prima. Feliz Navidad, [mc]."
    mad "Eu queria fazer isso, mas não queria te envergonhar na frente do seu primo. Feliz Natal, [mc]."

# game/scripts/c14/c14.rpy:4336
translate brazilian c14s007_MaddieDnD_6e590a76:

    # mc "Feliz Navidad, Ama."
    mc "Feliz Natal, Ama."

# game/scripts/c14/c14.rpy:4338
translate brazilian c14s007_MaddieDnD_b13729ad:

    # mad "Pásame a buscar el viernes a las 6 como la semana pasada e iremos a mi casa."
    mad "Me busque na sexta-feira às 6, como na semana passada, e iremos para minha casa."

# game/scripts/c14/c14.rpy:4339
translate brazilian c14s007_MaddieDnD_6f38d93e:

    # mc "Como quieras. ¿Otra película?"
    mc "O que você quiser. Outro filme?"

# game/scripts/c14/c14.rpy:4341
translate brazilian c14s007_MaddieDnD_40be0102:

    # mad "Para no acabar de verla, mejor no empezarla. Tengo otros planes para ti."
    mad "Se você não pretende terminar de assistir, é melhor nem começar. Tenho outros planos para você."

# game/scripts/c14/c14.rpy:4342
translate brazilian c14s007_MaddieDnD_e69ff576:

    # mc "Espero que esos planes incluyan hablar de lo nuestro... si quieres."
    mc "Espero que esses planos incluam falar sobre nós... se você quiser."

# game/scripts/c14/c14.rpy:4344
translate brazilian c14s007_MaddieDnD_99c2d079:

    # mad "Si te portas bien, sí, podremos hablar. Quedamos a las 6 entonces."
    mad "Se você se comportar, sim, podemos conversar. Vamos nos encontrar às 6 então."

# game/scripts/c14/c14.rpy:4345
translate brazilian c14s007_MaddieDnD_d272b675_1:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Puxa! Acabei de me lembrar que talvez precise buscar uma amiga em Westport na sexta-feira. Mas não sei a que horas, ou mesmo se precisarei buscá-la."

# game/scripts/c14/c14.rpy:4346
translate brazilian c14s007_MaddieDnD_8012d214:

    # mc "En cuanto sepa algo te lo digo."
    mc "Avisarei assim que souber de algo."

# game/scripts/c14/c14.rpy:4348
translate brazilian c14s007_MaddieDnD_0a3fe072:

    # mad "¿Antepones a una amiga antes que a mí?"
    mad "Você coloca um amigo acima de mim?"

# game/scripts/c14/c14.rpy:4349
translate brazilian c14s007_MaddieDnD_21c2f1d4:

    # mc "Antepongo a cualquiera que me necesite antes que cualquier otra cosa. Espero que no te moleste."
    mc "Coloco quem precisa de mim acima de tudo. Espero que não se importe."

# game/scripts/c14/c14.rpy:4351
translate brazilian c14s007_MaddieDnD_cd1f66c5:

    # mad "¿Y si yo te necesitara en ese mismo momento?"
    mad "E se eu precisasse de você naquele exato momento?"

# game/scripts/c14/c14.rpy:4352
translate brazilian c14s007_MaddieDnD_475476e3:

    # mc "Si fuera algo que no puede esperar, tendrías preferencia... Ama."
    mc "Se fosse algo que não pudesse esperar, você teria prioridade... Amor."

# game/scripts/c14/c14.rpy:4354
translate brazilian c14s007_MaddieDnD_82a65c03:

    # mad "Respuesta adecuada."
    mad "Resposta apropriada."

# game/scripts/c14/c14.rpy:4357
translate brazilian c14s007_MaddieDnD_4d7e8205:

    # mc "Tenía ganas de hacer esto desde que he entrado. Feliz Navidad, Maddie"
    mc "Eu queria fazer isso desde que cheguei aqui. Feliz Natal, Maddie!"

# game/scripts/c14/c14.rpy:4358
translate brazilian c14s007_MaddieDnD_97b3ea06:

    # mad "Gracias. Feliz Navidad, [mc]."
    mad "Obrigado. Feliz Natal, [mc]."

# game/scripts/c14/c14.rpy:4359
translate brazilian c14s007_MaddieDnD_b444f459:

    # mcp "(¿Gracias? ¿Por el beso o por celebrar la Navidad con ella?)"
    mcp "(Obrigado? Pelo beijo ou por comemorar o Natal com ela?)"

# game/scripts/c14/c14.rpy:4361
translate brazilian c14s007_MaddieDnD_55d59c4e:

    # mad "¿Querrías que volvamos a quedar el viernes en mi casa?"
    mad "Você gostaria de se encontrar novamente na sexta-feira na minha casa?"

# game/scripts/c14/c14.rpy:4362
translate brazilian c14s007_MaddieDnD_c49a89f2:

    # mc "Sí, podemos ver otra película o continuar donde lo dejamos."
    mc "Sim, podemos assistir a outro filme ou continuar de onde paramos."

# game/scripts/c14/c14.rpy:4364
translate brazilian c14s007_MaddieDnD_3bae63de:

    # mad "Como quieras. Aún tenemos mas de media película por ver. Y mucho que continuar si quieres hacerlo."
    mad "O que você quiser. Ainda temos mais da metade do filme para assistir. E muito mais para ver se você quiser continuar."

# game/scripts/c14/c14.rpy:4365
translate brazilian c14s007_MaddieDnD_e440230d:

    # mc "Ya veremos. Te recojeré a las 6 como la semana pasada."
    mc "Veremos. Vou te buscar às 6, como na semana passada."

# game/scripts/c14/c14.rpy:4367
translate brazilian c14s007_MaddieDnD_5f2ea2a1:

    # mad "Como queras. A ver si esta vez tenemos suerte y no te tienes que ir con prisas."
    mad "O que você quiser. Vamos torcer para que tenhamos sorte desta vez e você não precise ir embora às pressas."

# game/scripts/c14/c14.rpy:4368
translate brazilian c14s007_MaddieDnD_d272b675_2:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Puxa! Acabei de me lembrar que talvez precise buscar uma amiga em Westport na sexta-feira. Mas não sei a que horas, ou mesmo se precisarei buscá-la."

# game/scripts/c14/c14.rpy:4370
translate brazilian c14s007_MaddieDnD_b7d653e7_1:

    # mad "Lástima. Si no puedes venir a recogerme, podemos quedar directamente en mi casa."
    mad "Que pena. Se você não puder vir me buscar, podemos nos encontrar diretamente na minha casa."

# game/scripts/c14/c14.rpy:4371
translate brazilian c14s007_MaddieDnD_00e7cef4:

    # mcp "(¿Lástima? ¿Tiene ganas de que vaya? ¿De ser dominada?)"
    mcp "(Piedade? Ela quer que eu vá? Que eu seja dominado?)"

# game/scripts/c14/c14.rpy:4372
translate brazilian c14s007_MaddieDnD_8012d214_1:

    # mc "En cuanto sepa algo te lo digo."
    mc "Avisarei assim que souber de algo."

# game/scripts/c14/c14.rpy:4374
translate brazilian c14s007_MaddieDnD_46335a4a:

    # mad "Si no volvemos ya, [dap] empezará a sospechar."
    mad "Se não retornarmos em breve, [dap] começará a suspeitar."

# game/scripts/c14/c14.rpy:4376
translate brazilian c14s007_MaddieDnD_1e0ca9ac:

    # mad "Si has acabado, [dap] te está esperando."
    mad "Se você terminou, [dap] está esperando por você."

# game/scripts/c14/c14.rpy:4377
translate brazilian c14s007_MaddieDnD_9e86395f:

    # mc "Entonces vamos, aún tengo que hacer mi personaje."
    mc "Então, ainda preciso criar meu personagem."

# game/scripts/c14/c14.rpy:4379
translate brazilian c14s007_MaddieDnD_673d7782:

    # "Ciertamente, con la aplicación diseñáis a Vilfredo il Bisteccone muy rápido."
    "Certamente, com o aplicativo você cria o Vilfredo il Bisteccone muito rapidamente."

# game/scripts/c14/c14.rpy:4380
translate brazilian c14s007_MaddieDnD_618305e2:

    # "Teniendo en cuenta que te tiene que explicar las normas, tardáis bastante más de lo que ha tardado Maddie, pero menos de lo que hubieras pensado."
    "Levando em conta que ele precisa explicar as regras para você, leva consideravelmente mais tempo do que levou para a Maddie, mas menos do que você imaginava."

# game/scripts/c14/c14.rpy:4382
translate brazilian c14s007_MaddieDnD_fbc99e4a:

    # dap "Bueno, pues ya hemos acabado. El domingo jugaremos la partida. ¡Qué ganas tengo!"
    dap "Bom, é isso, terminamos. Jogaremos no domingo. Mal posso esperar!"

# game/scripts/c14/c14.rpy:4383
translate brazilian c14s007_MaddieDnD_a645ca67:

    # mad "¿Me mandáis un mensaje con vuestra dirección? No sé dónde vivís."
    mad "Você pode me enviar uma mensagem com seu endereço? Eu não sei onde você mora."

# game/scripts/c14/c14.rpy:4384
translate brazilian c14s007_MaddieDnD_14063c9a:

    # mc "No te preocupes, ya te pasaré a buscar."
    mc "Não se preocupe, eu irei te buscar."

# game/scripts/c14/c14.rpy:4386
translate brazilian c14s007_MaddieDnD_bb7de64f:

    # dap "Hasta el domingo, Maddie."
    dap "Te vejo domingo, Maddie."

# game/scripts/c14/c14.rpy:4387
translate brazilian c14s007_MaddieDnD_fde3f076:

    # mad "Nos vemos, [dap]."
    mad "Até logo, [dap]."

# game/scripts/c14/c14.rpy:4389
translate brazilian c14s007_MaddieDnD_88500629:

    # mad "Avísame cuando vengas a buscarme. Te veo el domingo, [mc]."
    mad "Me avise quando você vier me buscar. Te vejo no domingo, [mc]."

# game/scripts/c14/c14.rpy:4390
translate brazilian c14s007_MaddieDnD_c5897877:

    # mc "Te llamo cuando esté llegando a tu casa... mándame un mensaje con la dirección."
    mc "Eu te ligo quando estiver quase chegando na sua casa... me mande uma mensagem com o endereço."

# game/scripts/c14/c14.rpy:4393
translate brazilian c14s007_MaddieDnD_a32623b7:

    # "De nuevo en la camioneta..."
    "De volta ao caminhão..."

# game/scripts/c14/c14.rpy:4394
translate brazilian c14s007_MaddieDnD_904416c3:

    # dap "¿Preparado para empezar nuestra cita?"
    dap "Prontos para começar nosso encontro?"

# game/scripts/c14/c14.rpy:4395
translate brazilian c14s007_MaddieDnD_fb26c3ee:

    # mc "¿Sin pasar por casa a ducharnos o cambiarnos?"
    mc "Sem poder ir para casa tomar banho ou trocar de roupa?"

# game/scripts/c14/c14.rpy:4397
translate brazilian c14s007_MaddieDnD_6b656016:

    # dap "No te preocupes. Te podrás duchar y cambiarte donde vamos."
    dap "Não se preocupe. Você poderá tomar banho e se trocar no local para onde formos."

# game/scripts/c14/c14.rpy:4398
translate brazilian c14s007_MaddieDnD_a669ee8d:

    # mc "¿Cambiarme? No he traído ropa..."
    mc "Trocar de roupa? Eu não trouxe nenhuma..."

# game/scripts/c14/c14.rpy:4400
translate brazilian c14s007_MaddieDnD_8517d94b:

    # dap "No sabes nada, [mc] Marks. Todo está planeado."
    dap "Você não sabe de nada, Marks. Está tudo planejado."

# game/scripts/c14/c14.rpy:4403
translate brazilian c14s007_MaddieDnD_e5c78f6d:

    # "Volvéis a casa y las chicas aún no han llegado. La playa siempre te ha agotado, por mucho que te guste disfrutarla en familia."
    "Você volta para casa e as meninas ainda não chegaram. A praia sempre te deixa exausto, por mais que você goste de ir com a sua família."

# game/scripts/c14/c14.rpy:4404
translate brazilian c14s007_MaddieDnD_498183ac:

    # "Después de darte una ducha, el cansancio se apodera de ti y te quedas dormido."
