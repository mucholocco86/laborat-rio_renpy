# game/scripts/c14/c14.rpy:490
translate brazilian c14s001_ContinuationSam_29f0f833:

    # mc "Mientras nos haga felices a los tres y a quien sea que esté también en esta relación, la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Enquanto isso fizer nós três felizes, e qualquer outra pessoa que esteja envolvida nesse relacionamento, podemos continuar. A última coisa que eu quero é que alguém se machuque."

# game/scripts/c14/c14.rpy:492
translate brazilian c14s001_ContinuationSam_7260d9ce:

    # mc "Mientras nos haga felices a los tres la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Contanto que isso faça nós três felizes, podemos continuar. A última coisa que eu quero é que alguém se machuque."

# game/scripts/c14/c14.rpy:494
translate brazilian c14s001_ContinuationSam_3f90d1fe:

    # sim "Lo dices como si los tres estuviéramos en una relación poliamorosa. Espero que no quieras hacer un trío conmigo y con mi madre."
    sim "Você fala como se nós três estivéssemos em um relacionamento poliamoroso. Espero que você não queira fazer um ménage à trois comigo e com a minha mãe."

# game/scripts/c14/c14.rpy:495
translate brazilian c14s001_ContinuationSam_15410ddb:

    # mc "Si pensara que eso os iba a hacer felices, os lo propondría. Pero creo que hay líneas rojas que no deberíamos cruzar, creo que solo con proponerlo te incomodaría a ti."
    mc "Se eu achasse que isso te faria feliz, eu sugeriria. Mas acho que existem limites que não devemos ultrapassar; acho que só a sugestão já te deixaria desconfortável."

# game/scripts/c14/c14.rpy:497
translate brazilian c14s001_ContinuationSam_3ada1db0:

    # sim "¿A mí? ¿No a mi madre?"
