    kat "Não tenho motivos para negar. Seria cego se não achasse ninguém nesse círculo atraente. Vocês já se viram?"

# game/scripts/c14/c14.rpy:2727
translate brazilian c14s005_BallGame_24bf709e:

    # todas "*Risa incómoda*"
    todas "*Risos constrangidos*"

# game/scripts/c14/c14.rpy:2728
translate brazilian c14s005_BallGame_f3de4a4e:

    # kat "[dap], te toca."
    kat "[dap], é a sua vez."

# game/scripts/c14/c14.rpy:2730
translate brazilian c14s005_BallGame_07faeb67:

    # dap "Sí..."
    dap "Sim..."

# game/scripts/c14/c14.rpy:2732
translate brazilian c14s005_BallGame_2896853f:

    # dap "Sacas tú, Kate."
    dap "Pode levar, Kate."

# game/scripts/c14/c14.rpy:2734
translate brazilian c14s005_BallGame_42065b6b:

    # "La revelación de [dap] hace que ninguna de las chicas esté concentrada en el juego. Obviamente Kim no caza la pelota."
    "A revelação de [dap] significa que nenhuma das meninas está concentrada no jogo. Obviamente, Kim não consegue pegar a bola."

# game/scripts/c14/c14.rpy:2736
translate brazilian c14s005_BallGame_f9630ea5:

    # kat "Kim, ¿Verdad o Reto?"
    kat "Kim, verdade ou desafio?"

# game/scripts/c14/c14.rpy:2739
translate brazilian c14s005_BallGame_b2e47be6:

    # kim "*Risa* Os estáis poniendo muy chungas con las confidencias. ¡Reto! Así puedes pedirle a [mc] que nos saque a bailar a todas. *Risa*"
    kim "*Risos* Você está ficando muito intenso com os segredos. Desafio! Aqui está como você pode pedir para [mc] nos convidar para dançar. *Risos*"

# game/scripts/c14/c14.rpy:2741
translate brazilian c14s005_BallGame_5c5cc5d3:

    # kim "*Risa* Os estáis poniendo muy chungas con las confidencias. ¡Reto! *Risa*"
    kim "*Risos* Você está ficando muito intenso com as confidências. Desafio! *Risos*"

# game/scripts/c14/c14.rpy:2744
translate brazilian c14s005_BallGame_6040b873:

    # kat "Había pensado en un reto-confidencia..."
    kat "Eu havia pensado em um desafio de confiança..."

# game/scripts/c14/c14.rpy:2746
translate brazilian c14s005_BallGame_1613d3e3:

    # kim "*Risa* Qué miedo me das... Recuerda que duermo en la misma habitación que tú y me puedo vengar por la noche. *Risa*"
    kim "*Risos* Você me assusta... Lembre-se, eu durmo no mesmo quarto que você, e posso me vingar hoje à noite. *Risos*"

# game/scripts/c14/c14.rpy:2749
translate brazilian c14s005_BallGame_751c21e0:

    # kat "*Risa. No me das miedo. Si te sientes atraída por alguien del círculo, bésalo."
    kat "*Risos. Você não me assusta. Se você se sentir atraído por alguém no círculo, beije essa pessoa."

# game/scripts/c14/c14.rpy:2750
translate brazilian c14s005_BallGame_562f7551:

    # mc "¡Kate! ¡Eso es pasarse!"
    mc "Kate! Isso já é demais!"

# game/scripts/c14/c14.rpy:2752
translate brazilian c14s005_BallGame_ada85268:

    # kim "No pasa nada, [mc]. Me apetece saber quién besa a quién."
    kim "Tudo bem, [mc]. Estou curioso para saber quem está beijando quem."

# game/scripts/c14/c14.rpy:2753
translate brazilian c14s005_BallGame_16fda365:

    # kim "¿Y si alguien se siente atraído por más de una persona? ¿Y si la persona a la que fuera a besar no quiere que la bese?"
    kim "E se alguém se sentir atraído por mais de uma pessoa? E se a pessoa que está prestes a ser beijada não quiser ser beijada?"

# game/scripts/c14/c14.rpy:2755
translate brazilian c14s005_BallGame_c5d1a20b:

    # kat "Si te sientes atraída por más de una persona, las besas a todas. Si alguien se siente incómodo con que lo besen, puede rechazar el beso."
    kat "Se você se sente atraído por mais de uma pessoa, beije todas. Se alguém se sentir desconfortável com o beijo, pode recusar."

# game/scripts/c14/c14.rpy:2757
translate brazilian c14s005_BallGame_66dc6c24:

    # kim "OK..."
    kim "OK..."

# game/scripts/c14/c14.rpy:2760
translate brazilian c14s005_BallGame_751dcfe1:

    # "Kim se dirige a Kate y le planta un beso en los lábios."
    "Kim se aproxima de Kate e lhe dá um beijo nos lábios."

# game/scripts/c14/c14.rpy:2762
translate brazilian c14s005_BallGame_d0ae71ff:

    # kat "¿Qué?"
    kat "Que?"

# game/scripts/c14/c14.rpy:2764
translate brazilian c14s005_BallGame_87e1edd1:

    # kim "Eso es otra pregunta. *Risa*"
    kim "Essa é outra questão. *Risos*"

# game/scripts/c14/c14.rpy:2765
translate brazilian c14s005_BallGame_bc2ddcb9:

    # kim "Me acabo de dar cuenta de que no te he pedido permiso... espero que no te haya importado. *Risa*"
    kim "Acabei de perceber que não pedi sua permissão... Espero que não se importe. *Risos*"

# game/scripts/c14/c14.rpy:2767
translate brazilian c14s005_BallGame_7479e905:

    # kat "No... no..."
    kat "Não, não..."

# game/scripts/c14/c14.rpy:2770
translate brazilian c14s005_BallGame_8064a70b:

    # kim "¿Puedo?"
    kim "Pode?"

# game/scripts/c14/c14.rpy:2771
translate brazilian c14s005_BallGame_890c041b:

    # mc "Por supuesto."
    mc "Claro."

# game/scripts/c14/c14.rpy:2773
translate brazilian c14s005_BallGame_2517a8b1:

    # "Vuestros labios se juntan en un beso tierno y suave."
    "Seus lábios se encontram em um beijo terno e suave."

# game/scripts/c14/c14.rpy:2775
translate brazilian c14s005_BallGame_392184f2:

    # "Durante del baile ha habido una preciosa conexión entre vosotros que ahora hace que salten chispas."
    "Durante a dança, houve uma linda conexão entre vocês que agora faz faíscas voarem."

# game/scripts/c14/c14.rpy:2777
translate brazilian c14s005_BallGame_d741ae4b:

    # kim "Gracias."
    kim "Obrigado."

# game/scripts/c14/c14.rpy:2778
translate brazilian c14s005_BallGame_39ca9b19:

    # mc "¿Gracias? ¿Por qué? Soy yo quien debería dártelas."
    mc "Obrigado? Por quê? Eu é que deveria estar te agradecendo."

# game/scripts/c14/c14.rpy:2779
translate brazilian c14s005_BallGame_3da3d9ce:

    # kim "Si me hubieras rechazado me hubiera sentido fatal ahora mismo..."
    kim "Se você tivesse me rejeitado, eu me sentiria péssimo agora..."

# game/scripts/c14/c14.rpy:2782
translate brazilian c14s005_BallGame_6cbf3d30:

    # kim "Nadie más. Lo siento, chicas."
    kim "Ninguém mais. Desculpem, meninas."

# game/scripts/c14/c14.rpy:2784
translate brazilian c14s005_BallGame_1ac484f3:

    # kim "No, no hay nadie. ¿[mc]?"
    kim "Não, não há ninguém aqui."

# game/scripts/c14/c14.rpy:2788
translate brazilian c14s005_BallGame_3b87edfc:

    # mcp "(Besar a [dap] no estaría bien después de lo que pasó con las lecciones.)"
    mcp "(Beijar [dap] não seria uma boa ideia depois do que aconteceu com as aulas.)"

# game/scripts/c14/c14.rpy:2792
translate brazilian c14s005_BallGame_6ebd554f:

    # mcp "(Sabiendo lo que siente por mí, no estaría bien besar a Scarlett.)"
    mcp "(Sabendo o que ela sente por mim, não seria certo beijar Scarlett.)"

# game/scripts/c14/c14.rpy:2828
translate brazilian c14s005_BallGame_43403ec0:

    # mc "Ya está. Nadie más."
    mc "É isso. Ninguém mais."

# game/scripts/c14/c14.rpy:2830
translate brazilian c14s005_BallGame_304bccd0:

    # mc "No voy a besar a nadie. Sois maravillosas, pero..."
    mc "Não vou beijar ninguém. Vocês são todos maravilhosos, mas..."

# game/scripts/c14/c14.rpy:2831
translate brazilian c14s005_BallGame_ad9317a0:

    # mc "¿Debbie?"
    mc "Débbie?"

# game/scripts/c14/c14.rpy:2837
translate brazilian c14s005_BallGame_4027a1ff:

    # "No te sorprende que Debbie se plante delante tuyo después del beso que habéis compartido hace un momento."
    "Não te surpreende que Debbie esteja parada na tua frente depois do beijo que trocaram há pouco."

# game/scripts/c14/c14.rpy:2838
translate brazilian c14s005_BallGame_d39bbd08:

    # deb "¿Puedo devolverte el beso que me has dado?... No es que no me haya gustado... no me refiero a eso..."
    deb "Posso retribuir o beijo que você me deu?... Não é que eu não tenha gostado... Não é isso que eu quis dizer..."

# game/scripts/c14/c14.rpy:2839
translate brazilian c14s005_BallGame_cd169ff0:

    # mc "Lo sé, Debbie. Me siento muy halagado de que quieras hacerlo."
    mc "Eu sei, Debbie. Fico muito lisonjeada que você queira fazer isso."

# game/scripts/c14/c14.rpy:2840
translate brazilian c14s005_BallGame_a65cddf1:

    # mcp "(Si la rechazara se moriría de vergüenza. Si ha sido lo suficientemente valiente como para dar el paso, se merece que no la humillen.)"
    mcp "(Se ele a rejeitasse, ela morreria de vergonha. Se ela teve coragem suficiente para dar esse passo, não merece ser humilhada.)"

# game/scripts/c14/c14.rpy:2842
translate brazilian c14s005_BallGame_f0260644:

    # "El segundo beso es infinitamente mejor que el primero. La ternura sigue siendo la misma, pero la inseguridad {b}casi{/b} ha desaparecido."
    "O segundo beijo é infinitamente melhor que o primeiro. A ternura permanece a mesma, mas a insegurança quase desapareceu."

# game/scripts/c14/c14.rpy:2843
translate brazilian c14s005_BallGame_61a5fff3:

    # "Debbie se siente aceptada, se siente diferente. Por primera vez en su vida, se siente atractiva."
    "Debbie sente-se aceita, sente-se diferente. Pela primeira vez na vida, sente-se atraente."

# game/scripts/c14/c14.rpy:2845
translate brazilian c14s005_BallGame_ccc3b972:

    # deb "¡Phew! *Susurrando* El segundo ha parecido diferente que el primero."
    deb "Ufa! *Sussurrando* O segundo pareceu diferente do primeiro."

# game/scripts/c14/c14.rpy:2846
translate brazilian c14s005_BallGame_5c62bb5d:

    # mc "*Susurrando* En el primero te he besado yo, en este nos hemos besado. La diferencia es enorme."
    mc "*Sussurrando* No primeiro eu te beijei, neste nós nos beijamos. A diferença é enorme."

# game/scripts/c14/c14.rpy:2849
translate brazilian c14s005_BallGame_c46c5dd7:

    # "Te sorprende que Debbie se plante delante tuyo. Nunca hubieras dicho que se sintiera atraído por ti... A ver si al final va a resultar que eres tonto para estas cosas..."
    "Você está surpreso por Debbie estar parada na sua frente. Você jamais imaginaria que ela se sentisse atraída por você... Talvez você seja mesmo ingênuo nessas coisas..."

# game/scripts/c14/c14.rpy:2850
translate brazilian c14s005_BallGame_ba21b15f:

    # deb "¿Te importaría si...?"
    deb "Você se importaria se...?"

# game/scripts/c14/c14.rpy:2851
translate brazilian c14s005_BallGame_e63ab7ac:

    # mc "No, Debbie. Para nada. Solo es un juego."
    mc "Não, Debbie. De jeito nenhum. É só uma brincadeira."

# game/scripts/c14/c14.rpy:2852
translate brazilian c14s005_BallGame_a65cddf1_1:

    # mcp "(Si la rechazara se moriría de vergüenza. Si ha sido lo suficientemente valiente como para dar el paso, se merece que no la humillen.)"
    mcp "(Se ele a rejeitasse, ela morreria de vergonha. Se ela teve coragem suficiente para dar esse passo, não merece ser humilhada.)"

# game/scripts/c14/c14.rpy:2854
translate brazilian c14s005_BallGame_defe5344:

    # deb "*Susurrando* Hay un problema... Yo... *ininteligible*"
    deb "*Sussurrando* Há um problema... Eu... *ininteligível*"

# game/scripts/c14/c14.rpy:2855
translate brazilian c14s005_BallGame_8d1b59f6:

    # mc "*Susurrando* No te entiendo, Debbie"
    mc "*Sussurrando* Eu não te entendo, Debbie."

# game/scripts/c14/c14.rpy:2856
translate brazilian c14s005_BallGame_4c09b6d6:

    # deb "*Susurrando* Déjame decírtelo al oído..."
    deb "*Sussurrando* Deixe-me te contar no seu ouvido..."

# game/scripts/c14/c14.rpy:2858
translate brazilian c14s005_BallGame_ef9c4904:

    # deb "*Susurrando* Quiero hacerlo, pero... no sé... nunca he besado a nadie..."
    deb "*Sussurrando* Eu quero, mas... não sei... nunca beijei ninguém..."

# game/scripts/c14/c14.rpy:2859
translate brazilian c14s005_BallGame_2ac40d2e:

    # mc "*Susurrando* Entonces corrijamos esa injusticia."
    mc "*Sussurrando* Então vamos corrigir essa injustiça."

# game/scripts/c14/c14.rpy:2861
translate brazilian c14s005_BallGame_ea17a622:

    # "La mayoría de hombres se sorprenderían de que una mujer tan grande, tan musculosa, tan dura externamente, fuera capaz de semejeante ternura en su primer beso."
    "A maioria dos homens ficaria surpresa ao saber que uma mulher tão grande, musculosa e aparentemente durona pudesse ser capaz de tanta ternura em seu primeiro beijo."

# game/scripts/c14/c14.rpy:2862
translate brazilian c14s005_BallGame_ce1609c9:

    # "La mayoría de hombres no tienen la suerte de conocer a Debbie."
    "A maioria dos homens não tem a sorte de conhecer Debbie."

# game/scripts/c14/c14.rpy:2863
translate brazilian c14s005_BallGame_61a5fff3_1:

    # "Debbie se siente aceptada, se siente diferente. Por primera vez en su vida, se siente atractiva."
    "Debbie sente-se aceita, sente-se diferente. Pela primeira vez na vida, sente-se atraente."

# game/scripts/c14/c14.rpy:2865
translate brazilian c14s005_BallGame_3ae2a8c3:

    # deb "¡Phew!"
    deb "Ufa!"

# game/scripts/c14/c14.rpy:2866
translate brazilian c14s005_BallGame_57cd6c62:

    # mc "¿Bien?"
    mc "Bom?"

# game/scripts/c14/c14.rpy:2867
translate brazilian c14s005_BallGame_3ac3bca6:

    # deb "Mucho mejor de lo que podría haber esperado... Gracias."
    deb "Muito melhor do que eu poderia esperar... Obrigada."

# game/scripts/c14/c14.rpy:2868
translate brazilian c14s005_BallGame_e76ec727:

    # mc "Gracias a ti, por dejarme ser el primero."
    mc "Obrigado por me deixarem ser o primeiro."

# game/scripts/c14/c14.rpy:2870
translate brazilian c14s005_BallGame_5a2d4948:

    # deb "Por mi parte ya está."
    deb "É tudo da minha parte."

# game/scripts/c14/c14.rpy:2873
translate brazilian c14s005_BallGame_95e03832:

    # deb "Nadie por mi parte."
    deb "Ninguém da minha parte."

# game/scripts/c14/c14.rpy:2875
translate brazilian c14s005_BallGame_ffbc4c17:

    # mc "¿Seguimos jugando?"
    mc "Vamos continuar jogando?"

# game/scripts/c14/c14.rpy:2878
translate brazilian c14s005_BallGame_6792687e:

    # dap "Creo que ya sería hora de acercarnos a donde estan las madres... por si necesitan ayuda..."
    dap "Acho que está na hora de irmos até onde as mães estão... caso elas precisem de ajuda..."

# game/scripts/c14/c14.rpy:2880
translate brazilian c14s005_BallGame_ea2ed94e:

    # dap "{i}(La que se puede liar aquí ahora podría ser complicada. Mejor dejar el juego mientras siga siéndolo.){/i}"
    dap "{i}(As coisas podem ficar complicadas agora. É melhor sair do jogo enquanto ainda estão acontecendo.){/i}"

# game/scripts/c14/c14.rpy:2881
translate brazilian c14s005_BallGame_dc2ab17a:

    # mc "Como queráis... ha sido un juego interesante... Me lo he pasado muy bien."
    mc "O que você quiser... foi um jogo interessante... eu me diverti muito."

# game/scripts/c14/c14.rpy:2885
translate brazilian c14s005_BallGame_78469031:

    # kat "{i}(Tú sí... pero ¿tenías que hacerme dudar de si hay algún hombre que merece la pena?){/i}"
    kat "{i}(Você fez isso... mas precisava me fazer duvidar se existe algum homem que valha a pena?){/i}"

# game/scripts/c14/c14.rpy:2886
translate brazilian c14s005_BallGame_25ba098f:

    # kat "{i}(¿Mereces la pena, [mc] Marks? ¿Me harás daño si me abro a ti?){/i}"
    kat "{i}(Você vale a pena, [mc] Marks? Você vai me machucar se eu me abrir para você?){/i}"

# game/scripts/c14/c14.rpy:2888
translate brazilian c14s005_BallGame_b61df388:

    # kat "{i}(Tú sí... pero ¿tenías que hacerme dudar de si hay algún hombre que merece la pena? ¿Estabas jugando conmigo? ¿Realmente querías besarme?){/i}"
    kat "{i}(Você fez isso... mas precisava me fazer duvidar se existe algum homem que valha a pena? Você estava brincando comigo? Você realmente queria me beijar?){/i}"

# game/scripts/c14/c14.rpy:2889
translate brazilian c14s005_BallGame_25ba098f_1:

    # kat "{i}(¿Mereces la pena, [mc] Marks? ¿Me harás daño si me abro a ti?){/i}"
    kat "{i}(Você vale a pena, [mc] Marks? Você vai me machucar se eu me abrir para você?){/i}"

# game/scripts/c14/c14.rpy:2891
translate brazilian c14s005_BallGame_75f06f44:

    # kat "{i}(¿Y Kim? Si lo de [mc] ha sido una sorpresa... lo de Kim... Realmente lo esperaba de Debbie, me debe fallar el radar...)"
    kat "{i}(E a Kim? Se a coisa da [mc] foi uma surpresa... a coisa da Kim... eu realmente esperava isso da Debbie, meu radar deve estar me falhando...)"

# game/scripts/c14/c14.rpy:2893
translate brazilian c14s005_BallGame_3e966769:

    # kat "{i}(Sobretodo interesante... ¿Kim? Nunca lo hubiera dicho... Realmente lo esperaba de Debbie, me debe fallar el radar...)"
    kat "{i}(Muito interessante... Kim? Eu jamais teria imaginado... Eu realmente esperava isso da Debbie, meu radar deve estar me falhando...)"

# game/scripts/c14/c14.rpy:2896
translate brazilian c14s005_BallGame_eda7dd45:

    # kim "{i}(Vale, nos hemos besado dos veces, pero tan solo son besos... y era un juego... No te montes películas en la cabeza, Kim.){/i}"
    kim "{i}(Ok, nos beijamos duas vezes, mas foram só beijos... e era só uma brincadeira... Não se empolgue demais, Kim.){/i}"

# game/scripts/c14/c14.rpy:2899
translate brazilian c14s005_BallGame_4c09ef95:

    # kim "{i}(Vale, nos hemos besado, pero tan solo ha sido un beso... y era un juego... No te montes películas en la cabeza, Kim.){/i}"
    kim "{i}(Ok, nós nos beijamos, mas foi só um beijo... e era uma brincadeira... Não se empolgue demais, Kim.){/i}"

# game/scripts/c14/c14.rpy:2902
translate brazilian c14s005_BallGame_12f36b94:

    # kim "{i}(Y el baile... que forma de bailar... si todo lo hace con la misma pasión como besar y bailar...){/i}"
    kim "{i}(E a dança... que jeito de dançar... ela faz tudo com a mesma paixão com que beija e dança...){/i}"

# game/scripts/c14/c14.rpy:2905
translate brazilian c14s005_BallGame_a514d5d0:

    # kim "{i}(Ha sido muy divertido... que forma de bailar... si todo lo hace con la misma pasión como bailar...){/i}"
    kim "{i}(Tem sido muito divertido... que jeito de dançar... ela faz tudo com a mesma paixão que dança...){/i}"

# game/scripts/c14/c14.rpy:2909
translate brazilian c14s005_BallGame_160e72a4:

    # lis "{i}(¡Me ha besado! Al menos me ha pedido permiso... y era solo un juego... no he engañado a nadie...){/i}"
    lis "{i}(Ele me beijou! Pelo menos pediu permissão... e era só uma brincadeira... eu não enganei ninguém...){/i}"

# game/scripts/c14/c14.rpy:2910
translate brazilian c14s005_BallGame_cd16bd13:

    # lis "{i}(Deja de engañarte a ti misma, Lisa, no sales con Anthony, no ha dado ningún paso para que salgáis, pero... ¿realmente quieres que lo haga?){/i}"
    lis "{i}(Pare de se enganar, Lisa, você não está namorando com o Anthony, ele não fez nenhum movimento para começar a namorar com você, mas... você realmente quer que ele faça isso?){/i}"

# game/scripts/c14/c14.rpy:2912
translate brazilian c14s005_BallGame_07266ca9:

    # lis "{i}(¡Ha intentado besarme! Al menos me ha pedido permiso... y era solo un juego... pero no puedo engañar a Anthony...){/i}"
    lis "{i}(Ele tentou me beijar! Pelo menos pediu permissão... e era só uma brincadeira... mas não consigo enganar o Anthony...){/i}"

# game/scripts/c14/c14.rpy:2913
translate brazilian c14s005_BallGame_cd16bd13_1:

    # lis "{i}(Deja de engañarte a ti misma, Lisa, no sales con Anthony, no ha dado ningún paso para que salgáis, pero... ¿realmente quieres que lo haga?){/i}"
    lis "{i}(Pare de se enganar, Lisa, você não está namorando com o Anthony, ele não fez nenhum movimento para começar a namorar com você, mas... você realmente quer que ele faça isso?){/i}"

# game/scripts/c14/c14.rpy:2916
translate brazilian c14s005_BallGame_57ecc9f2:

    # lis "{i}(¡Ha besado a Debbie! ¡Y después no ha rechazado su beso!){/i}"
    lis "{i}(Ele beijou a Debbie! E depois não rejeitou o beijo dela!){/i}"

# game/scripts/c14/c14.rpy:2917
translate brazilian c14s005_BallGame_fa2e335d:

    # lis "{i}(Solo por lo bien que la ha hecho sentir, ya me tiene que caer bien... tengo que tratarlo mejor. Solo hay que verla.){/i}"
    lis "{i}(Só por causa do bem que ele a fez sentir, eu tenho que gostar dele... Tenho que tratá-lo melhor. Basta olhar para ela.){/i}"

# game/scripts/c14/c14.rpy:2918
