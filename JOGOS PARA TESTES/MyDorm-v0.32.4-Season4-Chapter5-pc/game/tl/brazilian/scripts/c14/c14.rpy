    sim "E de onde você tirou a ideia de que eu não estaria disposto? Com a pessoa certa..."

# game/scripts/c14/c14.rpy:503
translate brazilian c14s001_ContinuationSam_1c8e0ffd:

    # mc "¿Y quién sería esa persona adecuada, Simone? Y no digas ninguna actriz famosa a quien no conocemos."
    mc "E quem seria essa pessoa adequada, Simone? E não mencione nenhuma atriz famosa que não conhecemos."

# game/scripts/c14/c14.rpy:505
