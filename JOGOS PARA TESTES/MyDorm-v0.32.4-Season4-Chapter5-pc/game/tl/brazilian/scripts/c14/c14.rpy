# game/scripts/c14/c14.rpy:498
translate brazilian c14s001_ContinuationSam_5faaf4a7:

    # mc "Creo que tu madre podría estar más abierta a la idea de un trío que tú, aunque no si tú estás involucrada. Pero con la persona correcta..."
    mc "Acho que sua mãe talvez seja mais aberta à ideia de um ménage à trois do que você, embora não se você estiver envolvido. Mas com a pessoa certa..."

# game/scripts/c14/c14.rpy:500
translate brazilian c14s001_ContinuationSam_87ec4d53:

    # sim "{b}¿Qué?{/b} ¿Mi madre en un trío? Estás loco..."
