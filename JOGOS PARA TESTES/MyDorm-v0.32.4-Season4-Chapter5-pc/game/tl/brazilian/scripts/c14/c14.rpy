    # sim "No, claro. Estar desnuda sentada encima de la polla de mi novio en el sofá no es lo que parece."
    sim "Não, claro que não. Sentar nua no pau do meu namorado no sofá não é o que parece."

# game/scripts/c14/c14.rpy:228
translate brazilian c14s001_ContinuationSam_82aaae6f:

    # sim "No, claro. Estar desnuda sentada encima de la polla de [mc] en el sofá no es lo que parece."
    sim "Não, claro que não. Sentar-se nu no pau do <c4 no sofá não é o que parece."

# game/scripts/c14/c14.rpy:231
translate brazilian c14s001_ContinuationSam_86bdc33a:

    # sim "Si hasta te has depilado..."
    sim "Você até já fez depilação..."

# game/scripts/c14/c14.rpy:236
translate brazilian c14s001_ContinuationSam_94976363:

    # sam "Simone, puedo explicarlo..."
    sam "Simone, eu posso explicar..."

# game/scripts/c14/c14.rpy:238
translate brazilian c14s001_ContinuationSam_00b0e3ae:

    # sim "Por supuesto, que puedes. [mc] ha venido a tomar té y pastitas, os habéis tirado el té por encima y os habéis tenido que desnudar, ¿verdad?"
    sim "Claro que pode. [mc] veio tomar chá e comer biscoitos, vocês derramaram chá um no outro e tiveram que se despir, certo?"

# game/scripts/c14/c14.rpy:239
translate brazilian c14s001_ContinuationSam_e22da03f:

    # sim "Estoy en shock... tu sabías lo que [mc] significaba para mí..."
    sim "Estou em choque... você sabia o que [mc] significava para mim..."

# game/scripts/c14/c14.rpy:241
translate brazilian c14s001_ContinuationSam_201f5dd5:

    # mc "Simone, ya te dije que..."
    mc "Simone, eu já te disse isso..."

# game/scripts/c14/c14.rpy:243
translate brazilian c14s001_ContinuationSam_5f487485:

    # sim "¿Y tú? ¿Tú lo sabías...?"
    sim "E você? Sabia...?"

# game/scripts/c14/c14.rpy:244
translate brazilian c14s001_ContinuationSam_7d2c4615:

    # sim "Claro que lo sabías, que tonterías estoy diciendo... tienes que pasártelo de puta madre follándonos a las dos..."
    sim "É claro que você sabia, que besteira eu estou falando... você deve se divertir muito transando com nós dois..."

# game/scripts/c14/c14.rpy:245
translate brazilian c14s001_ContinuationSam_48378cc2:

    # mc "Simone, te dije que podía haber otras chicas..."
    mc "Simone, eu te disse que poderiam haver outras garotas..."

# game/scripts/c14/c14.rpy:247
translate brazilian c14s001_ContinuationSam_7f9c9723:

    # sim "Sí, pero no me dijiste que una de ellas era mi madre..."
    sim "Sim, mas você não me disse que uma delas era minha mãe..."

# game/scripts/c14/c14.rpy:252
translate brazilian c14s001_ContinuationSam_a2c28566:

    # sam "Espera... espera... ¿Tu novio? ¿Estáis saliendo?"
    sam "Espera... espera... Seu namorado? Vocês dois estão namorando?"

# game/scripts/c14/c14.rpy:254
translate brazilian c14s001_ContinuationSam_e0235614:

    # sim "Sí, Mamá, o lo estábamos hasta hace dos minutos..."
    sim "Sim, mãe, ou melhor, éramos até dois minutos atrás..."

# game/scripts/c14/c14.rpy:256
translate brazilian c14s001_ContinuationSam_b52a0e3d:

    # sam "¿Y qué es eso de que te estás follando a las dos?"
    sam "E o que é isso de você dormir com as duas?"

# game/scripts/c14/c14.rpy:261
translate brazilian c14s001_ContinuationSam_c7f51d82:

    # sam "{b}¿Te estás follando a mi niña?{/b}"
    sam "{b}Você está transando com a minha garota?{/b}"

# game/scripts/c14/c14.rpy:262
translate brazilian c14s001_ContinuationSam_84c97c36:

    # mc "Sam..."
    mc "Sam..."

# game/scripts/c14/c14.rpy:267
translate brazilian c14s001_ContinuationSam_d54af1d1:

    # sam "{b}¡Fuera de mi casa!{/b}"
    sam "{b}Saia da minha casa!{/b}"

# game/scripts/c14/c14.rpy:268
translate brazilian c14s001_ContinuationSam_8c90346f:

    # mc "Sam, déjame hablar..."
    mc "Sam, deixe-me falar..."

# game/scripts/c14/c14.rpy:273
translate brazilian c14s001_ContinuationSam_189750c7:

    # sam "¡No quiero oírte! Nos has engañado a las dos, a la una con la otra... no quiero volver a verte aquí..."
    sam "Não quero mais ouvir falar de você! Você nos enganou, um com o outro... Não quero te ver aqui de novo..."

# game/scripts/c14/c14.rpy:274
translate brazilian c14s001_ContinuationSam_c47ae3eb:

    # sam "¡Y además te has aprovechado de mi niña!"
    sam "E você se aproveitou da minha filhinha!"

# game/scripts/c14/c14.rpy:275
translate brazilian c14s001_ContinuationSam_7f896c98:

    # mc "Sam, no os he engañado a ninguna..."
    mc "Sam, eu não enganei nenhum de vocês..."

# game/scripts/c14/c14.rpy:280
translate brazilian c14s001_ContinuationSam_e7d3f9ba:

    # sam "{b}¡Fuera... de... mi... puta... casa!{/b}"
    sam "{b}Saiam... daqui... da... minha... porra... de... casa!{/b}"

# game/scripts/c14/c14.rpy:282
translate brazilian c14s001_ContinuationSam_4d72310e:

    # sim "No. También es mi casa y quiero que se quede."
    sim "Não. Esta casa também é minha, e eu quero que ela fique."

# game/scripts/c14/c14.rpy:287
translate brazilian c14s001_ContinuationSam_c32b4214:

    # sam "No sabes lo que estás diciendo, Simone. ¡Nos ha engañado a las dos! ¡Lo quiero fuera de aquí! {b}¡Ya!{/b}"
    sam "Você não sabe o que está dizendo, Simone. Ele nos enganou! Quero ele fora daqui! Agora!"

# game/scripts/c14/c14.rpy:289
translate brazilian c14s001_ContinuationSam_9976b665:

    # sim "A mí no. A mí me dijo que podía ser que saliera con otras mujeres."
    sim "Eu não. Ele me disse que talvez estivesse saindo com outras mulheres."

# game/scripts/c14/c14.rpy:294
translate brazilian c14s001_ContinuationSam_e3b3cfb3:

    # sam "¿Y tú lo aceptaste?"
    sam "E você aceitou?"

# game/scripts/c14/c14.rpy:296
translate brazilian c14s001_ContinuationSam_e6e21b58:

    # sim "¡Sí, lo acepté! Y hasta que no hablemos de lo que acabo de ver, sigue siendo mi novio. No tienes derecho a echarlo."
    sim "Sim, eu aceitei! E até conversarmos sobre o que acabei de ver, ele continua sendo meu namorado. Você não tem o direito de expulsá-lo."

# game/scripts/c14/c14.rpy:301
translate brazilian c14s001_ContinuationSam_3c8fc4f0:

    # sam "Pero..."
    sam "Mas..."

# game/scripts/c14/c14.rpy:303
translate brazilian c14s001_ContinuationSam_d02a3030:

    # sim "Mamá, siempre me has dicho que si tenía novio podría traerlo a casa sin problemas. Pues aquí está, aunque lo hayas traído tú para follártelo. No voy a dejar que lo eches."
    sim "Mãe, você sempre me disse que se eu tivesse um namorado, poderia trazê-lo para casa sem problemas. Bem, aqui está ele, mesmo que você o tenha trazido para dormir comigo. Não vou deixar você expulsá-lo."

# game/scripts/c14/c14.rpy:308
translate brazilian c14s001_ContinuationSam_ddfb43c6:

    # sam "Pero... a mí sí que me ha engañado..."
    sam "Mas... ele me enganou..."

# game/scripts/c14/c14.rpy:309
translate brazilian c14s001_ContinuationSam_2d56d47b:

    # mc "No, Samantha. Tú me dijiste que habías hablado con [mar] y que no te importaba compartir..."
    mc "Não, Samantha. Você me disse que tinha falado com [mar] e que não se importava de compartilhar..."

# game/scripts/c14/c14.rpy:311
translate brazilian c14s001_ContinuationSam_50ed2fc1:

    # sim "¿Qué? ¿Estás saliendo también con tu madre?"
    sim "O quê? Você também está namorando sua mãe?"

# game/scripts/c14/c14.rpy:316
translate brazilian c14s001_ContinuationSam_7dccb779:

    # sam "No, fue una conversación hipotética. En aquel momento yo no pensaba que acabaría así... aquí... delante de mi hija..."
    sam "Não, era uma conversa hipotética. Naquele momento, eu não imaginava que terminaria assim... aqui... na frente da minha filha..."

# game/scripts/c14/c14.rpy:318
translate brazilian c14s001_ContinuationSam_98f66496:

    # sim "¡Ufff! Me había asustado..."
    sim "Ufa! Isso me assustou..."

# game/scripts/c14/c14.rpy:319
translate brazilian c14s001_ContinuationSam_4bc9d2f5:

    # mc "Sam, no te dije que estaba con otras mujeres por que tú me dijiste eso... lo tomé como que no te importaba..."
    mc "Sam, eu não te contei que estava com outras mulheres porque você me disse isso... Entendi que você não se importava..."

# game/scripts/c14/c14.rpy:324
translate brazilian c14s001_ContinuationSam_8788c55c:

    # sam "¿Cómo no me va a importar? ¿Cómo crees que me puedo sentir sabiendo que sales con mi hija?"
    sam "Como eu poderia não me importar? Como você acha que eu deveria me sentir sabendo que você está namorando a minha filha?"

# game/scripts/c14/c14.rpy:325
translate brazilian c14s001_ContinuationSam_b4b10eb3:

    # sam "Hace un momento decías que no las preferías jóvenes..."
    sam "Há pouco você disse que não os preferia jovens..."

# game/scripts/c14/c14.rpy:326
translate brazilian c14s001_ContinuationSam_7281e1d0:

    # mc "Y no las prefiero jóvenes, Sam. ¿Todo esto es por el tema de la edad otra vez?"
    mc "E eu não prefiro jovens, Sam. Será que tudo isso tem a ver com a idade de novo?"

# game/scripts/c14/c14.rpy:327
translate brazilian c14s001_ContinuationSam_1fccad41:

    # mc "Me gusta Simone y estoy con ella, no por la edad que tiene, sino por quién es. Por cómo es. Y tú me gustas por cómo eres. Me da lo mismo la edad que tengas. Sólo parece importarte a ti."
    mc "Gosto da Simone e estou com ela, não por causa da idade dela, mas por quem ela é. Por causa de como ela é. E gosto de você por quem você é. Não me importo com a sua idade. Parece que só importa para você."

# game/scripts/c14/c14.rpy:330
translate brazilian c14s001_ContinuationSam_8de1d9b7:

    # sim "*Risa*"
    sim "*Risada*"

# game/scripts/c14/c14.rpy:335
translate brazilian c14s001_ContinuationSam_73e751ed:

    # mc "¿Qué pasa?" (multiple=2)
    mc "O que está acontecendo?" (multiple=2)

# game/scripts/c14/c14.rpy:336
translate brazilian c14s001_ContinuationSam_99d3d593:

    # sam "¿De qué te ríes?" (multiple=2)
    sam "Do que você está rindo?" (multiple=2)

# game/scripts/c14/c14.rpy:338
translate brazilian c14s001_ContinuationSam_87930fcc:

    # sim "Me acabo de dar cuenta de lo ridículo de la situación..."
    sim "Acabei de perceber o quão ridícula é a situação..."

# game/scripts/c14/c14.rpy:344
translate brazilian c14s001_ContinuationSam_6278532a:

    # mc "No te entiendo" (multiple=2)
    mc "Não entendo você" (multiple=2)

# game/scripts/c14/c14.rpy:345
translate brazilian c14s001_ContinuationSam_a2b96805:

    # sam "¿Qué te parece ridículo de todo esto?" (multiple=2)
    sam "O que você acha ridículo em tudo isso?" (multiple=2)

# game/scripts/c14/c14.rpy:347
translate brazilian c14s001_ContinuationSam_26fc2ba9:

    # sim "Primero que los dos estáis en pelotas en medio del salón."
    sim "Em primeiro lugar, vocês dois estão nus no meio da sala de estar."

# game/scripts/c14/c14.rpy:352
translate brazilian c14s001_ContinuationSam_cd99faad:

    # sam "¡Oops! ¡[mc], tápate!"
    sam "Ops! Cubra-se!"

# game/scripts/c14/c14.rpy:353
translate brazilian c14s001_ContinuationSam_60170bca:

    # mc "No es nada que no hayáis visto antes las dos, no quiero interrumpir a Simone antes de saber el resto de los puntos por lo que la situación le parece ridícula."
    mc "Não é nada que vocês duas já não tenham visto antes. Não quero interromper a Simone antes que ela saiba o resto dos pontos, por isso a situação parece ridícula para ela."

# game/scripts/c14/c14.rpy:355
translate brazilian c14s001_ContinuationSam_b11b492d:

    # sim "Os dais cuenta de que soy yo quien os ha pillado, ¿verdad?"
    sim "Você percebe que fui eu quem te pegou, não é?"

# game/scripts/c14/c14.rpy:360
translate brazilian c14s001_ContinuationSam_db5df92a:

    # sam "Sí, claro, pero no veo qué tiene que ver con que sea ridículo."
    sam "Sim, claro, mas não vejo o que isso tem a ver com ser ridículo."

# game/scripts/c14/c14.rpy:361
translate brazilian c14s001_ContinuationSam_3ba08259:

    # mc "Yo creo que sé por dónde va."
    mc "Acho que sei onde isso vai dar."

# game/scripts/c14/c14.rpy:363
translate brazilian c14s001_ContinuationSam_2075b658:

    # sim "Os he pillado yo y me he enfadado, pero parece que la más ofendida seas tú, Mamá. Y estás aquí en pelotas, gesticulando y enfadada..."
    sim "Eu te peguei e estou brava, mas parece que você é a mais ofendida, mãe. E aqui está você, completamente nua, gesticulando descontroladamente e furiosa..."

# game/scripts/c14/c14.rpy:364
translate brazilian c14s001_ContinuationSam_45019296:

    # sim "Es gracioso. Quieres echar de {b}nuestra{/b} casa a {b}nuestro{/b} novio, sin tener en cuenta mi opinión. Tan solo porque las dos salimos con él."
    sim "É engraçado. Você quer expulsar nosso namorado de casa, sem nem considerar minha opinião. Só porque nós duas namoramos com ele."

# game/scripts/c14/c14.rpy:369
translate brazilian c14s001_ContinuationSam_fa3dff8a:

    # sam "Y porque nos ha engañado..."
    sam "E porque ele nos enganou..."

# game/scripts/c14/c14.rpy:371
translate brazilian c14s001_ContinuationSam_47ccd05f:

    # sim "A mí no, Mamá. Me lo dijo antes de aceptar salir conmigo, o de que yo aceptara salir con él. Y si lo he entendido bien, tú también le diste autorización."
    sim "Não fui eu, mãe. Ele me contou antes de concordar em sair comigo, ou antes de eu concordar em sair com ele. E se eu entendi direito, você também deu permissão a ele."

# game/scripts/c14/c14.rpy:376
translate brazilian c14s001_ContinuationSam_698d45b5:

    # sam "Pero era en un caso hipotético..."
    sam "Mas isso foi em um caso hipotético..."

# game/scripts/c14/c14.rpy:378
translate brazilian c14s001_ContinuationSam_81f0c9d0:

    # sim "Y la hipótesis se convirtió en realidad. ¿Estarías igual si en vez de conmigo se estuviera acostando con [mar]? Dejemos de lado lo raro que sería. ¿Te enfadaría igual?"
    sim "E a hipótese tornou-se realidade. Você se sentiria da mesma forma se, em vez de mim, ele estivesse dormindo com [mar]? Deixemos de lado o quão estranho isso seria. Você ficaria com a mesma raiva?"

# game/scripts/c14/c14.rpy:383
translate brazilian c14s001_ContinuationSam_1df0ebb0:

    # sam "Supongo que no..."
    sam "Acho que não..."

# game/scripts/c14/c14.rpy:385
translate brazilian c14s001_ContinuationSam_66b3d6ee:

    # sim "Y si hubiera vuelto con Eileen tampoco, ¿verdad?"
    sim "E se eu tivesse voltado para Eileen, isso também não teria acontecido, não é?"

# game/scripts/c14/c14.rpy:390
translate brazilian c14s001_ContinuationSam_b7361115:

    # sam "No sé... quizás un poco más..."
    sam "Não sei... talvez um pouco mais..."

# game/scripts/c14/c14.rpy:392
translate brazilian c14s001_ContinuationSam_e6f009fc:

    # sim "Entonces si saliera con [mar] no te enfadarías, con Eileen un poco, y porque sale conmigo te pones hecha una furia."
    sim "Então, se eu estivesse namorando [mar] você não ficaria bravo, com a Eileen um pouco, e porque ela está namorando comigo você está furioso."

# game/scripts/c14/c14.rpy:393
translate brazilian c14s001_ContinuationSam_c34e9336:

    # sim "¿Puedes ver el patrón? Cuanto más joven sea la chica más te enfadas. Creo que el problema está en que te sientes amenazada por chicas más jóvenes."
    sim "Você consegue perceber o padrão? Quanto mais jovem a garota, mais irritado você fica. Acho que o problema é que você se sente ameaçado por garotas mais jovens."

# game/scripts/c14/c14.rpy:398
translate brazilian c14s001_ContinuationSam_0a979f5e:

    # sam "{b}¡No es eso!{/b} Con [mar] lo habíamos hablado, aunque solo fuera en broma. Si volviera con Eileen... todos lo esperábamos..."
    sam "{b}Não é isso!{/b} Eu tinha conversado sobre isso com [mar], mesmo que fosse só brincadeira. Se ele voltasse com a Eileen... todos nós esperávamos por isso..."

# game/scripts/c14/c14.rpy:399
translate brazilian c14s001_ContinuationSam_9a83ba9b:

    # sam "¿Pero tú? ¡Tú eres mi niña! No puedo dejar que nadie se aproveche de ti..."
    sam "Mas você? Você é minha filhinha! Não posso deixar ninguém se aproveitar de você..."

# game/scripts/c14/c14.rpy:401
translate brazilian c14s001_ContinuationSam_9d1e9d37:

    # sim "Nadie se está aprovechando, Mamá. Yo estuve de acuerdo. No me imaginaba que también estuviera contigo, pero estuve de acuerdo."
    sim "Ninguém está se aproveitando, mãe. Eu concordei. Não imaginei que concordaria com você também, mas concordei."

# game/scripts/c14/c14.rpy:402
translate brazilian c14s001_ContinuationSam_ab0868b9:

    # sim "Y posiblemente siga estándolo una vez acabemos esta conversación y tenga un momento para hablar con mi novio."
    sim "E provavelmente continuará assim quando terminarmos esta conversa e eu tiver um momento para falar com meu namorado."

# game/scripts/c14/c14.rpy:407
translate brazilian c14s001_ContinuationSam_b6699f85:

    # sam "{b}Nuestro{/b}."
    sam "{b}Nosso{/b}."

# game/scripts/c14/c14.rpy:409
translate brazilian c14s001_ContinuationSam_7b66c460:

    # sim "Hace un momento lo querías echar de casa. ¿Ahora vuelve a ser nuestro novio?"
    sim "Você só queria expulsá-lo de casa. E agora ele é nosso namorado de novo?"

# game/scripts/c14/c14.rpy:414
translate brazilian c14s001_ContinuationSam_cd9adbf4:

    # sam "Tu novio. Mi hombre. Yo también voy a tener que hablar con él, pero aún no he roto con él... ni le he roto la cara a hostias."
    sam "Seu namorado. Meu homem. Eu também vou ter que falar com ele, mas ainda não terminei com ele... nem dei um soco na cara dele."

# game/scripts/c14/c14.rpy:415
translate brazilian c14s001_ContinuationSam_4b63743d:

    # sam "Supongo que tiene mucho que ver con que... haya mantenido la boca cerrada este rato..."
    sam "Imagino que isso tenha muito a ver com o fato de... eu ter ficado de boca fechada esse tempo todo..."

# game/scripts/c14/c14.rpy:417
translate brazilian c14s001_ContinuationSam_1da127aa:

    # sim "Es que es un tipo listo... sale con las dos..."
    sim "Ele é um cara esperto... está namorando as duas..."

# game/scripts/c14/c14.rpy:422
translate brazilian c14s001_ContinuationSam_1f1deb53:

    # sam "Sí... "
    sam "Sim..."

# game/scripts/c14/c14.rpy:424
translate brazilian c14s001_ContinuationSam_05f53ef6:

    # sim "Y ahora que está arreglado..."
    sim "E agora que está consertado..."

# game/scripts/c14/c14.rpy:429
translate brazilian c14s001_ContinuationSam_de214aa7:

    # sam "¡No hay nada arreglado! ¡Tú y yo tenemos que hablar de muchas cosas!"
    sam "Nada está resolvido! Você e eu temos muito o que conversar!"

# game/scripts/c14/c14.rpy:431
translate brazilian c14s001_ContinuationSam_1e0487b3:

    # sim "Sí, pero preferiría no hacerlo delante de [mc]. ¿Por qué no vas a ponerte algo mientras yo hablo con él un momento?"
    sim "Sim, mas prefiro não fazer isso na frente do [mc]. Por que você não vai se vestir enquanto eu converso com ele por um instante?"

# game/scripts/c14/c14.rpy:436
translate brazilian c14s001_ContinuationSam_30459373:

    # sim "Ver esto botando cada vez que te alteras me está desconcentrando."
    sim "Ver isso balançando toda vez que você fica chateado(a) está me distraindo."

# game/scripts/c14/c14.rpy:441
translate brazilian c14s001_ContinuationSam_1af4d505:

    # sam "¡Simone!"
    sam "Simone!"

# game/scripts/c14/c14.rpy:442
translate brazilian c14s001_ContinuationSam_fbad18a5:

    # mc "¿Puedo ir yo también a ponerme algo?"
    mc "Posso ir também e resolver alguma coisa?"

# game/scripts/c14/c14.rpy:444
translate brazilian c14s001_ContinuationSam_58a05077:

    # sim "No, tu quédate aquí."
    sim "Não, você fica aqui."

# game/scripts/c14/c14.rpy:449
translate brazilian c14s001_ContinuationSam_8f26ab3a:

    # sam "Cuidado con lo que hacéis. No me gustaría pillaros haciendo algo inapropiado... *Risa*"
    sam "Tenha cuidado com o que você faz. Eu não gostaria de te pegar fazendo nada inapropriado... *Risos*"

# game/scripts/c14/c14.rpy:451
translate brazilian c14s001_ContinuationSam_79a4ad17:

    # mc "Tú dirás, pero quiero que quede claro que no te he engañado en ningún momento."
    mc "Você pode dizer o que quiser, mas quero deixar claro que nunca te enganei."

# game/scripts/c14/c14.rpy:452
translate brazilian c14s001_ContinuationSam_472edd16:

    # sim "Lo sé."
    sim "Eu sei."

# game/scripts/c14/c14.rpy:454
translate brazilian c14s001_ContinuationSam_be678842:

    # sim "¿Cuánto tiempo llevas con mi madre?"
    sim "Há quanto tempo você está com a minha mãe?"

# game/scripts/c14/c14.rpy:455
translate brazilian c14s001_ContinuationSam_554ee6dc:

    # mc "Desde el día que fui a la comisaría."
    mc "Desde o dia em que fui à delegacia."

# game/scripts/c14/c14.rpy:457
