# game/scripts/c14/c14.rpy:2100
translate brazilian c14s004_ToTheBeach_025b2a00:

    # "Por fin llegáis a la playa. [sam] y [sim] se unirán más tarde. Jamaal no va a poder venir. Algo sobre una indigestión por comer demasiadas empanadas."
    "Você finalmente chegou à praia. [sam] e [sim] se juntarão a você mais tarde. Jamaal não poderá vir. Algo sobre indigestão por ter comido muitas empanadas."

# game/scripts/c14/c14.rpy:2225
translate brazilian c14s004_ToTheBeach_658591db:

    # kia "Duele menos, pero aún duele un poco. El ungüento que me dió [sam] es fantástico."
    kia "Dói menos, mas ainda dói um pouco. A pomada que me deram é fantástica."

# game/scripts/c14/c14.rpy:2253
translate brazilian c14s004_ToTheBeach_8365ec48:

    # dap "Lo sé, pero ahora es un poco diferente. Nos va a servir para conocernos más. [sca] casi no ha tratado con Kim, Debbie, y Kate, y ahora viviendo en casa..."
    dap "Eu sei, mas agora é um pouco diferente. Isso vai nos ajudar a nos conhecermos melhor. [sca] Ele quase não teve contato com Kim, Debbie e Kate, e agora está morando em casa..."

# game/scripts/c14/c14.rpy:2256
translate brazilian c14s004_ToTheBeach_8ed68db2:

    # dap "No te preocupes. Los malos rollos en los juegos siempre los crea [emm] cuando se pica, y se ha ido a dar un paseo por la playa con [eri] y [eil]."
    dap "Não se preocupe. As más vibrações nos jogos são sempre causadas por [emm] quando as coisas esquentam, e ele foi dar um passeio na praia com [eri] e [eil]."

# game/scripts/c14/c14.rpy:2257
translate brazilian c14s004_ToTheBeach_f5006120:

    # mc "Entonces... Kate, Kim, Debbie, [sca], tú, y yo, ¿no?"
    mc "Então... Kate, Kim, Debbie, [sca], você e eu, certo?"

# game/scripts/c14/c14.rpy:2320
translate brazilian c14s004_ToTheBeach_0a18b113:

    # kat "¿Quieres saber las reglas del juego? Hablando con [sca] hemos mezclado las suyas y las mías."
    kat "Quer saber as regras do jogo? Conversando com [sca], nós misturamos as dele com as minhas."

# game/scripts/c14/c14.rpy:2427
translate brazilian c14s005_BallGame_09cd12d9:

    # dap "No pasa nada, [mc]. Sí, lo soy. ¿[sca]?"
    dap "Está tudo bem, [mc]. Sim, estou. [sca]?"

# game/scripts/c14/c14.rpy:2439
translate brazilian c14s005_BallGame_16210d81:

    # "Los lanzamientos aumentan de velocidad y dificultad. Debbie y Kate siguen haciéndolo sin esfuerzo, [dap] y [sca] empiezan a sufrir. Para Kim es casi una pesadilla."
    "Os lançamentos aumentam em velocidade e dificuldade. Debbie e Kate continuam a fazê-los sem esforço, enquanto Kim e Kate começam a ter dificuldades. Para Kim, é quase um pesadelo."

# game/scripts/c14/c14.rpy:2553
translate brazilian c14s005_BallGame_c7a5a834:

    # "Esta vez [dap] consigue que [sca] falle."
    "Desta vez, [dap] consegue fazer com que [sca] falhe."

# game/scripts/c14/c14.rpy:2555
translate brazilian c14s005_BallGame_072304de:

    # dap "¿Verdad o reto, [sca]?"
    dap "Verdade ou desafio?"

# game/scripts/c14/c14.rpy:2573
translate brazilian c14s005_BallGame_87688ea7:

    # dap "¡Oh! ¡Lo siento, [sca]! No había pensado en ello..."
    dap "Oh! Desculpe! Eu não tinha pensado nisso..."

# game/scripts/c14/c14.rpy:2605
translate brazilian c14s005_BallGame_dc4afb9c:

    # mc "Por supuesto. Es una versión de Verdad o Reto que han diseñado Kate y [sca]."
    mc "Claro. É uma versão de Verdade ou Desafio que Kate e [sca] criaram."

# game/scripts/c14/c14.rpy:2608
translate brazilian c14s005_BallGame_5825f54b:

    # "Después de explicarle las normas, saca [sca], se la pasa a Kate, y esta falla. Parece que su mirada no estaba siguiendo la pelota."
    "Após explicar as regras, ele saca, passa para Kate, e ela erra. Parece que seus olhos não estavam acompanhando a bola."

# game/scripts/c14/c14.rpy:2615
translate brazilian c14s005_BallGame_7f5a2b40:

    # mc "[sca]..."
    mc "[sca]..."

# game/scripts/c14/c14.rpy:2683
translate brazilian c14s005_BallGame_47280547:

    # mcp "(Sabiendo lo que siente por mí, no estaría bien besar a [sca].)"
    mcp "(Sabendo o que ela sente por mim, não seria certo beijá-la.)"

# game/scripts/c14/c14.rpy:2843
translate brazilian c14s005_BallGame_255a1e09:

    # dap "No te preocupes, [mc]. Ya vamos nosotras, a ver si encontramos a [eri], [emm], y [eil] por el camino. Es un paseo corto a la gasolinera."
    dap "Não se preocupe, [mc]. Vamos lá, vamos ver se encontramos [eri], [emm] e [eil] pelo caminho. É uma curta caminhada até o posto de gasolina."

# game/scripts/c14/c14.rpy:2870
translate brazilian c14s005_KissScarlett_5ddd918b:

    # "Te acercas a [sca], que te mira nerviosa. Los dos sabéis que no es vuestro primer beso, pero es la primera vez que os besáis delante de alguien diferente de [dap]."
    "Você se aproxima de [sca], que olha para você nervosamente. Ambos sabem que não é o primeiro beijo de vocês, mas é a primeira vez que se beijam na frente de alguém que não seja [dap]."

# game/scripts/c14/c14.rpy:3069
translate brazilian c14s006_Christmas_87965064:

    # nor "No, en cuanto vuelvan las chicas y lleguen [sam] y [sim], iremos a comer."
    nor "Não, assim que as meninas voltarem e [sam] e [sim] chegarem, iremos comer."

# game/scripts/c14/c14.rpy:3072
translate brazilian c14s006_Christmas_cf2bbc6e:

    # mee "Eres consciente de que no es Navidad, ¿verdad? Solo hacemos esto porque a [sca] le pareció divertido hacer una excursión familiar a la playa."
    mee "Você percebe que não é Natal, né? Só estamos fazendo isso porque [sca] achou que seria divertido fazer uma viagem em família para a praia."

# game/scripts/c14/c14.rpy:3093
translate brazilian c14s006_Christmas_d15c14d8:

    # mc "Sí, lo sé. Ha sido idea de [sca], una amiga... ¡Uff! Te tengo que contar muchas cosas que han pasado desde que te fuiste."
    mc "Sim, eu sei. Foi ideia do [sca], um amigo... Ufa! Tenho tanta coisa para te contar que aconteceu desde que você foi embora."

# game/scripts/c14/c14.rpy:3117
translate brazilian c14s006_Christmas_46ea6a17:

    # mc "Buenos días, [meg]. ¿Estás en la playa?"
    mc "Bom dia, [meg]. Você está na praia?"

# game/scripts/c14/c14.rpy:3165
translate brazilian c14s006_Christmas_29b09760:

    # mc "¡Feliz Navidad, [meg]!"
    mc "Feliz Natal!"

# game/scripts/c14/c14.rpy:3300
translate brazilian c14s006_Christmas_4b45876b:

    # ama "[mc], deberías irte ya. [emm], [eri], y [eil] se acercan a vuestra posición y si te ven descubrirán a Eva."
    ama "[mc], você deve sair agora. [emm], [eri] e [eil] estão se aproximando de sua posição e, se eles te virem, descobrirão Eva."

# game/scripts/c14/c14.rpy:3464
translate brazilian c14s006_Christmas_22ac1813:

    # "[eil] capta el sentido de tus palabras y te mira inquisitivamente. Asientes con la cabeza."
    "[eil] Ele entende o significado das suas palavras e olha para você com um olhar interrogativo. Você acena com a cabeça."

# game/scripts/c14/c14.rpy:3522
translate brazilian c14s006_Christmas_a6ca6f2a:

    # mc "Hola, [sim], que bien que hayáis llegado."
    mc "Olá, [sim], que bom que você chegou."

# game/scripts/c14/c14.rpy:3530
translate brazilian c14s006_Christmas_a6ca6f2a_1:

    # mc "Hola, [sim], que bien que hayáis llegado."
    mc "Olá, [sim], que bom que você chegou."

# game/scripts/c14/c14.rpy:3545
translate brazilian c14s006_Christmas_322d504a:

    # mc "[sam.nick], estás preciosa de rojo."
    mc "[sam.nick], você fica linda de vermelho."

# game/scripts/c14/c14.rpy:3554
translate brazilian c14s006_Christmas_9ebed667:

    # "La seguridad que le da a [sim] que su madre ya sepa lo vuestro se nota en sus labios."
    "A tranquilidade que [sim] sente ao saber que sua mãe já sabe sobre vocês dois é evidente em seus lábios."

# game/scripts/c14/c14.rpy:3567
translate brazilian c14s006_Christmas_6fc1dea3:

    # "Besar a [sam] delante de todo el mundo tiene algo especial."
    "Beijar [sam] na frente de todos tem algo de especial."

# game/scripts/c14/c14.rpy:3586
translate brazilian c14s006_Christmas_215fd62d:

    # mc "*Susurrando* No te preocupes. [sam] siempre lleva un desfibrilador en el coche. *Risa*"
    mc "*Sussurrando* Não se preocupe. [sam] sempre tem um desfibrilador no carro. *Risos*"

# game/scripts/c14/c14.rpy:3593
translate brazilian c14s006_Christmas_a5d99197:

    # mc "Meemaw, nos queremos. Igual que quiero a [sam] y a [sim]..."
    mc "Vovó, nós nos amamos. Assim como eu amo [sam] e [sim]..."

# game/scripts/c14/c14.rpy:3595
translate brazilian c14s006_Christmas_b18c4e83:

    # mc "Meemaw, nos queremos. Igual que quiero a [sam]..."
    mc "Vovó, nós nos amamos. Assim como eu amo [sam]..."

# game/scripts/c14/c14.rpy:3597
translate brazilian c14s006_Christmas_795f4399:

    # mc "Meemaw, nos queremos. Igual que quiero a [sim]..."
    mc "Vovó, nós nos amamos. Assim como eu amo [sim]..."

# game/scripts/c14/c14.rpy:3718
translate brazilian c14s006_Christmas_826813f0:

    # kia "Cuando [mc] empezó a salir con mi [eil], no veía ningún futuro a esa relación. Me parecía que [mc] no era lo suficientemente bueno para mi hija."
    kia "Quando [mc] começou a namorar minha [eil], eu não via futuro naquele relacionamento. Eu sentia que [mc] não era bom o suficiente para minha filha."

# game/scripts/c14/c14.rpy:3747
translate brazilian c14s006_Christmas_14df5954:

    # mc "Ya solo faltan por llegar Alexia y [sai], y podremos ir a comer."
    mc "Agora só precisamos que Alexia e [sai] cheguem, e aí podemos ir comer."

# game/scripts/c14/c14.rpy:3749
translate brazilian c14s006_Christmas_555b8dc5:

    # "Mientras esperáis a Alexia y [sai], se van formando grupitos de conversación."
    "Enquanto você espera por Alexia e [sai], pequenos grupos de pessoas começam a se formar."

# game/scripts/c14/c14.rpy:3757
translate brazilian c14s006_Christmas_6d153ac8:

    # "[sam] y Kiara empiezan a charlar. Supones por los gestos que la conversación va tanto sobre el brazo como sobre el beso."
    "[sam] e Kiara começam a conversar. Pelos gestos deles, você presume que a conversa seja sobre o braço e o beijo."

# game/scripts/c14/c14.rpy:3760
translate brazilian c14s006_Christmas_5555f696:

    # "[sam] y Kiara empiezan a charlar sobre el brazo."
    "[sam] e Kiara começam a conversar sobre o braço."

# game/scripts/c14/c14.rpy:3762
translate brazilian c14s006_Christmas_829e1f58:

    # "[dap] y [sca] han secuestrado a [sim] y ha empezado a presentarles a las chicas. Hasta ahora solo conocía a Debbie."
    "[dap] e [sca] sequestraram [sim] e começaram a apresentá-los às meninas. Até agora, ele só conhecia Debbie."

# game/scripts/c14/c14.rpy:3764
translate brazilian c14s006_Christmas_efc03414:

    # "[emm] y [eil] se quedan apartadas. Parece que tienen cosas que decirse."
    "[emm] e [eil] estão separados. Parece que eles têm algo a dizer um ao outro."

# game/scripts/c14/c14.rpy:3780
translate brazilian c14s006_Christmas_f4837a4b:

    # "A lo lejos ves aparecer a [sai]. Parece que se ha cambiado nada más bajar del taxi que la ha traído de la universidad."
    "Ao longe, você vê [sai] aparecer. Parece que ela mudou assim que saiu do táxi que a trouxe da universidade."

# game/scripts/c14/c14.rpy:3782
translate brazilian c14s006_Christmas_1ba95bae:

    # "[emm] te hace señas para que te acerques mientras llama a [sai]."
    "[emm] sinaliza para você se aproximar enquanto chama [sai]."

# game/scripts/c14/c14.rpy:3783
translate brazilian c14s006_Christmas_17b90e24:

    # emm "¡[sai]! Ven aquí, quiero presentarte a alguien."
    emm "Venha cá, quero lhe apresentar alguém."

# game/scripts/c14/c14.rpy:3792
translate brazilian c14s006_Christmas_5e083649:

    # emm "Por cierto, te presento a [eil]. [eil], esta es [sai]."
    emm "A propósito, deixe-me apresentar-lhe [eil]. [eil], isto é [sai]."

# game/scripts/c14/c14.rpy:3795
translate brazilian c14s006_Christmas_18686c6a:

    # sai "Así que tú eres la famosa [eil], con la que {b}rompió{/b} antes de estar conmigo, ¿no? Encantada. de. conocerte."
    sai "Então você é o famoso [eil], aquele com quem {b}terminou{/b} antes de ficar comigo, certo? Prazer em conhecê-lo."

# game/scripts/c14/c14.rpy:3797
translate brazilian c14s006_Christmas_d72abfe5:

    # sai "Así que tú eres la famosa [eil], la {b}ex-novia{/b} del instituto, ¿no? Encantada. de. conocerte."
    sai "Então você é a famosa [eil], a {b}ex-namorada{/b} do ensino médio, certo? Prazer em conhecê-la."

# game/scripts/c14/c14.rpy:3829
translate brazilian c14s006_Christmas_9854d290:

    # eil "[sai] y yo nos conocimos anoche, nos presentó [eri]."
    eil "[sai] e eu nos conhecemos ontem à noite, [eri] nos apresentou."

# game/scripts/c14/c14.rpy:3836
translate brazilian c14s006_Christmas_bcfbacbe:

    # sai "¿Y lo de llamarme fea? ¿Tenemos 10 años, [eil]? *Risa*"
    sai "E quanto a me chamar de feia? Temos 10 anos, né? *Risos*"

# game/scripts/c14/c14.rpy:3846
translate brazilian c14s006_Christmas_ac516474:

    # sai "Después de lo que dijo [eri], [eil] y yo estuvimos hablando largo y tendido."
    sai "Depois do que [eri] disse, [eil] e eu tivemos uma longa conversa."

# game/scripts/c14/c14.rpy:3848
translate brazilian c14s006_Christmas_9c2cd8f6:

    # sai "Tú me habías dicho que estabas con [eil]. Era raro estar hablando con ella en la piscina, después de un mes comiéndome la cabeza."
    sai "Você me disse que estava com [eil]. Foi estranho conversar com ela na piscina, depois de um mês obcecado por ela."

# game/scripts/c14/c14.rpy:3850
translate brazilian c14s006_Christmas_bbd30c66:

    # sai "Tú me habías dicho que no habías vuelto con [eil], pero era raro estar hablando con ella en la piscina después de un mes comiéndome la cabeza."
    sai "Você me disse que não tinha voltado com a [eil], mas foi estranho conversar com ela na piscina depois de um mês dela me enlouquecendo."

# game/scripts/c14/c14.rpy:3852
translate brazilian c14s006_Christmas_b6b62270:

    # eil "Empezamos como dos perras celosas, especialmente [sai], y acabamos contándonos los mejores momentos que hemos pasado contigo."
    eil "Começamos como duas vadias ciumentas, especialmente [sai], e terminamos contando uma à outra sobre os melhores momentos que tivemos com você."

# game/scripts/c14/c14.rpy:3854
translate brazilian c14s006_Christmas_1f0e1888:

    # eil "Parece que vuelves a estar con las dos... sí, a [sai] se le escapó. Haces bien, [sai] será una buena incorporación al harén."
    eil "Parece que você voltou com as duas... sim, [sai] deixou escapar. Que bom para você, [sai] será uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:3856
translate brazilian c14s006_Christmas_13493239:

    # eil "Parece que vuestro reencuentro fue más frío que el nuestro, pero deberías pensártelo. [sai] sería una buena incorporación al harén."
    eil "Parece que o reencontro de vocês foi mais frio que o nosso, mas você deveria pensar nisso. [sai] Ela seria uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:3858
translate brazilian c14s006_Christmas_de4c13dd:

    # eil "Parece que vuestro reencuentro no fue tan frío como el nuestro... sí, a [sai] se le escapó. Haces bien, [sai] será una buena incorporación al harén."
    eil "Parece que seu reencontro não foi tão frio quanto o nosso... sim, [sai] deixou escapar. Que bom para você, [sai] será uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:3860
translate brazilian c14s006_Christmas_c82ea138:

    # eil "Parece que nuestros reencuentros contigo fueron igual de frío, pero deberías pensártelo. [sai] sería una buena incorporación al harén."
    eil "Parece que nossos reencontros com você foram tão frios quanto antes, mas você deveria reconsiderar. [sai] Ela seria uma ótima adição ao harém."

# game/scripts/c14/c14.rpy:3863
translate brazilian c14s006_Christmas_6deaeca0:

    # mc "No hay harén, solo estoy saliendo con [sai]."
    mc "Não há harém, estou apenas namorando [sai]."

# game/scripts/c14/c14.rpy:3874
translate brazilian c14s006_Christmas_a3463b5f:

    # sai "Nos dimos cuenta de que si estás con [eil] y yo puedo tener una oportunidad, es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Percebemos que se você está com [eil] e eu tenho uma chance, é porque colocamos a ideia de um relacionamento aberto e um harém na sua cabeça."

# game/scripts/c14/c14.rpy:3877
translate brazilian c14s006_Christmas_df7e27e3:

    # sai "Me dí cuenta que [eil] proponiendote el harén, quizá me haya dado la oportunidad que necesitaba para volver contigo."
    sai "Percebi que, ao propor o harém a você, talvez tenha me dado a oportunidade que precisava para voltar para você."

# game/scripts/c14/c14.rpy:3879
translate brazilian c14s006_Christmas_0ceb9bcd:

    # sai "Me dí cuenta que [eil] proponiendote el harén, quizá me de la oportunidad que necesitaba para volver contigo en el futuro."
    sai "Percebi que, ao propor o harém a você, eu poderia ter a oportunidade que precisava para voltar para você no futuro."

# game/scripts/c14/c14.rpy:3886
translate brazilian c14s006_Christmas_3c8f78f8:

    # eil "[sai] no podía creerse que [emm] fuera a intentar algo como lo que ha hecho, pero yo la conozco mejor."
    eil "[sai] Eu não conseguia acreditar que [emm] ela tentaria algo como o que fez, mas eu a conheço melhor."

# game/scripts/c14/c14.rpy:3888
translate brazilian c14s006_Christmas_19b1abc5:

    # sai "Traté poco con ella ayer, parecía enfadada, pero creía que tenía que ver con la situación de [sca]."
    sai "Não falei muito com ela ontem, ela parecia zangada, mas pensei que tinha algo a ver com a situação de [sca]."

# game/scripts/c14/c14.rpy:3908
translate brazilian c14s006_Christmas_322d98a3:

    # mc "Alexia, [sai]. [sai], Alexia."
    mc "Alexia, [sai]. [sai], Alexia."

# game/scripts/c14/c14.rpy:3910
translate brazilian c14s006_Christmas_69c78472:

    # oma "Encantada de conocerte, [sai]. ¿Eres la última estudiante?"
    oma "Prazer em conhecê-lo(a), [sai]. Você é o(a) último(a) aluno(a)?"

# game/scripts/c14/c14.rpy:3913
translate brazilian c14s006_Christmas_24eb8871:

    # oma "Hola, [eil]. Tenemos que hablar."
    oma "Olá, [eil]. Precisamos conversar."

# game/scripts/c14/c14.rpy:3924
translate brazilian c14s006_Christmas_7e17d382:

    # "[emm] y [sca] reparten gorros navideños para todos."
    "[emm] e [sca] estão distribuindo gorros de Natal para todos."

# game/scripts/c14/c14.rpy:3946
translate brazilian c14s006_Christmas_57476693:

    # "La sonrisa de [sca] te saca de tus ensoñaciones."
    "O sorriso de [sca] te tira dos seus devaneios."

# game/scripts/c14/c14.rpy:3964
translate brazilian c14s006_Christmas_67537140:

    # "[sca] propone la foto y todo el mundo responde entusiasmado."
    "[sca] propõe a foto e todos respondem com entusiasmo."

# game/scripts/c14/c14.rpy:4022
translate brazilian c14s007_MaddieDnD_7f5e5625:

    # dap "Sí, por lo visto es una costumbre italiana y [sca], mi amiga, leyo sobre ella. Lo propuso y lo hemos hecho. *Risa*"
    dap "Sim, aparentemente é um costume italiano, e minha amiga leu sobre isso. Ela sugeriu, e nós fizemos. *Risos*"

translate brazilian strings:

    # game/scripts/c14/c14.rpy:181
    old "2, sólo [sam] y [sim]"
    new "2, apenas [sam] e [sim]"
