# game/scripts/c14/c14.rpy:481
translate brazilian c14s001_ContinuationSam_d2b4e4bb:

    # mc "No puedo saber si va a haber más, Simone. No puedo saber si al salir al rellano voy a encontrar otra chica que me guste tanto como vosotras."
    mc "Não sei se haverá mais, Simone. Não sei se, quando eu sair para o patamar, encontrarei outra garota de quem eu goste tanto quanto de vocês duas."

# game/scripts/c14/c14.rpy:482
translate brazilian c14s001_ContinuationSam_9c300746:

