# game/scripts/c14/c14.rpy:2021
translate brazilian c14s003_SairaChat_67b300bf:

    # sai "Entonces... ¿A qué a venido el beso en el aeropuerto? No lo entiendo... ¿un beso en la mejilla?"
    sai "Então... qual era o objetivo do beijo no aeroporto? Não entendi... um beijo na bochecha?"

# game/scripts/c14/c14.rpy:2022
translate brazilian c14s003_SairaChat_b5b1f26d_1:

    # mc "Saira, mi vida se ha complicado desde que volví a Newport. No pensaba que volvería a verte..."
    mc "Saira, minha vida se complicou desde que voltei para Newport. Nunca pensei que te veria novamente..."

# game/scripts/c14/c14.rpy:2024
translate brazilian c14s003_SairaChat_3de56139_1:

    # sai "¡Te dije que vendría a visitarte!"
    sai "Eu disse que viria te visitar!"

# game/scripts/c14/c14.rpy:2025
translate brazilian c14s003_SairaChat_bbc10f7c_1:

    # mc "Sí, pero no a vivir en casa."
    mc "Sim, mas não para morar em casa."

# game/scripts/c14/c14.rpy:2026
translate brazilian c14s003_SairaChat_950b8af9_1:

    # mc "Y a lo que me refería era que no sabía si volvería a verte a corto plazo. Deseaba volver a verte, que cuando acabaras el año que te queda me llamases..."
    mc "O que eu quis dizer é que não sabia se te veria de novo tão cedo. Eu queria te ver de novo, que quando você terminasse o ano que lhe restava, você me ligasse..."

# game/scripts/c14/c14.rpy:2027
translate brazilian c14s003_SairaChat_af967366_1:

    # mc "Pero no sabía si sucedería. No me dijiste que pensabas mudarte aquí."
    mc "Mas eu não sabia se isso iria acontecer. Você não me disse que estava pensando em se mudar para cá."

# game/scripts/c14/c14.rpy:2029
translate brazilian c14s003_SairaChat_4830b8b8_1:

    # sai "Lo sé. Y sé que debería haberlo hecho."
    sai "Eu sei. E sei que deveria ter feito isso."

# game/scripts/c14/c14.rpy:2030
translate brazilian c14s003_SairaChat_413d2c48_1:

    # mc "Sí, deberías."
    mc "Sim, você deveria."

# game/scripts/c14/c14.rpy:2032
translate brazilian c14s003_SairaChat_59208d93_1:

    # sai "Entonces... ¿Quieres que dejemos lo nuestro?"
    sai "Então... você quer que a gente termine?"

# game/scripts/c14/c14.rpy:2033
translate brazilian c14s003_SairaChat_1be28cd7_1:

    # sai "Sólo he venido para el curso de verano. El transfer de Portland a Newport todavía está en proceso..."
    sai "Vim apenas para o curso de verão. A transferência de Portland para Newport ainda está em andamento..."

# game/scripts/c14/c14.rpy:2034
translate brazilian c14s003_SairaChat_e4babfbe_1:

    # sai "Si no quieres estar conmigo... lo paralizaría y volvería a Portland a acabar la carrera."
    sai "Se você não quiser ficar comigo... eu congelaria isso e voltaria para Portland para terminar a corrida."

# game/scripts/c14/c14.rpy:2035
translate brazilian c14s003_SairaChat_ddb44c64:

    # mc "Saira, en ningún momento he dicho que no quiera estar contigo... pero necesito tiempo."
    mc "Saira, eu nunca disse que não queria estar com você... mas preciso de tempo."

# game/scripts/c14/c14.rpy:2037
translate brazilian c14s003_SairaChat_51a93fb4:

    # sai "¿Entonces...?"
    sai "Então...?"

# game/scripts/c14/c14.rpy:2039
translate brazilian c14s003_SairaChat_7f4c1b9c_1:

    # mc "Pero no puedo estar contigo como estábamos en Portland. O para ser más exactos, sí, precisamente como estábamos en Portland."
    mc "Mas não posso estar com você como estávamos em Portland. Ou, para ser mais preciso, sim, exatamente como estávamos em Portland."

# game/scripts/c14/c14.rpy:2040
translate brazilian c14s003_SairaChat_f9bb63a0_2:

    # mc "Allí teníamos una relación abierta. Ninguno de los dos hizo nada fuera de la relación, pero los dos aceptamos que el otro pudiera hacerlo."
    mc "Tínhamos um relacionamento aberto. Nenhum de nós fazia nada fora do relacionamento, mas ambos aceitávamos que o outro pudesse fazer."

# game/scripts/c14/c14.rpy:2041
translate brazilian c14s003_SairaChat_54bc11c1_1:

    # mc "¿Serías capaz de volver a aceptar una relación así?"
    mc "Você seria capaz de aceitar um relacionamento assim novamente?"

# game/scripts/c14/c14.rpy:2043
translate brazilian c14s003_SairaChat_6c391479_1:

    # mc "Pero no quiero estar contigo como estábamos en Portland."
    mc "Mas eu não quero estar com você como estávamos em Portland."

# game/scripts/c14/c14.rpy:2044
translate brazilian c14s003_SairaChat_f9bb63a0_3:

    # mc "Allí teníamos una relación abierta. Ninguno de los dos hizo nada fuera de la relación, pero los dos aceptamos que el otro pudiera hacerlo."
    mc "Tínhamos um relacionamento aberto. Nenhum de nós fazia nada fora do relacionamento, mas ambos aceitávamos que o outro pudesse fazer."

# game/scripts/c14/c14.rpy:2045
translate brazilian c14s003_SairaChat_cf70031f_1:

    # mc "¿Serías capaz de volver a aceptar una relación así? Yo no."
    mc "Você seria capaz de aceitar um relacionamento assim novamente? Eu não."

# game/scripts/c14/c14.rpy:2047
translate brazilian c14s003_SairaChat_eaa5a76a_1:

    # sai "Sabes por qué teniamos esa relación, ¿verdad?"
    sai "Você sabe por que tínhamos esse relacionamento, não é?"

# game/scripts/c14/c14.rpy:2048
translate brazilian c14s003_SairaChat_912763a7_1:

    # mc "Me gustaría escuchárlo de tus labios. En Portland diste unas razones, en la videoconferencia parecían otras."
    mc "Gostaria de ouvir sua opinião. Em Portland, você deu um motivo, mas na videoconferência os motivos pareceram diferentes."

# game/scripts/c14/c14.rpy:2050
translate brazilian c14s003_SairaChat_1dc6138c_1:

    # sai "No me quería enamorar de ti."
    sai "Eu não queria me apaixonar por você."

# game/scripts/c14/c14.rpy:2051
translate brazilian c14s003_SairaChat_ab7574cb_1:

    # mc "Eso es una tontería, Saira..."
    mc "Isso é um absurdo, Saira..."

# game/scripts/c14/c14.rpy:2052
translate brazilian c14s003_SairaChat_2b075ccb_1:

    # sai "No lo es. Si teníamos una relación así, no podía darte por seguro nunca. Si un día no venías a mi casa, podía pensar que estabas con otra..."
    sai "Não, não é. Se tivéssemos um relacionamento assim, eu jamais poderia te dar como garantida. Se você não viesse à minha casa um dia, eu poderia pensar que você estava com outra pessoa..."

# game/scripts/c14/c14.rpy:2053
translate brazilian c14s003_SairaChat_1cfa49b9_1:

    # mc "Nunca estuve con nadie más..."
    mc "Eu nunca estive com mais ninguém..."

# game/scripts/c14/c14.rpy:2054
translate brazilian c14s003_SairaChat_5536a8f9_1:

    # sai "Lo sé. Si lo hubieras hecho me lo hubieras dicho."
    sai "Eu sei. Se você tivesse feito isso, teria me contado."

# game/scripts/c14/c14.rpy:2056
translate brazilian c14s003_SairaChat_4cc16176_1:

    # sai "Pero no funcionó."
    sai "Mas não funcionou."

# game/scripts/c14/c14.rpy:2057
translate brazilian c14s003_SairaChat_0e5ca576_1:

    # sai "Me enamoré hasta las trancas."
    sai "Eu me apaixonei perdidamente."

# game/scripts/c14/c14.rpy:2058
translate brazilian c14s003_SairaChat_fbef191f_1:

    # sai "Y sólo me di cuenta cuando me dijiste que volvías aquí. Me di cuenta de que te perdía..."
    sai "E eu só me dei conta disso quando você me disse que ia voltar. Percebi que estava te perdendo..."

# game/scripts/c14/c14.rpy:2059
translate brazilian c14s003_SairaChat_d13e3041_1:

    # mc "Y por alguna razón no quisiste formalizar la relación entonces."
    mc "E por algum motivo você não quis formalizar o relacionamento naquele momento."

# game/scripts/c14/c14.rpy:2061
translate brazilian c14s003_SairaChat_636bcd9d_1:

    # sai "¡Porque hubiera sido injusto para ti, cabeza de chorlito!"
    sai "Porque teria sido injusto para você, seu cabeça-dura!"

# game/scripts/c14/c14.rpy:2062
translate brazilian c14s003_SairaChat_692ea280_1:

    # mc "¿Para mí? ¿Por qué?"
    mc "Para mim? Por quê?"

# game/scripts/c14/c14.rpy:2064
translate brazilian c14s003_SairaChat_c3683731_1:

    # sai "En ese momento no pensaba en transferirme. Solo pensaba en que te podía perder para siempre."
    sai "Naquele momento eu não estava pensando em transferência. Eu só estava pensando na possibilidade de te perder para sempre."

# game/scripts/c14/c14.rpy:2065
translate brazilian c14s003_SairaChat_5f0ccf6d_1:

    # sai "No quería tenerte esperando un año a que acabara la carrera."
    sai "Eu não queria te fazer esperar um ano para que eu terminasse minha graduação."

# game/scripts/c14/c14.rpy:2066
translate brazilian c14s003_SairaChat_b59f3fdf_1:

    # sai "No sabía que había un curso de verano aquí que me podía ir bien. Que podríamos pasar el verano juntos."
    sai "Eu não sabia que havia um curso de verão aqui que pudesse me interessar. Que poderíamos passar o verão juntos."

# game/scripts/c14/c14.rpy:2067
translate brazilian c14s003_SairaChat_77cc1467_1:

    # mc "Y decidiste apuntarte sin decirme nada."
    mc "E você decidiu se inscrever sem me dizer nada."

# game/scripts/c14/c14.rpy:2069
translate brazilian c14s003_SairaChat_d8949939_1:

    # sai "Tenía que volver a India. Tenía que convencer a mis padres de que me dejasen cambiar de Universidad..."
    sai "Tive que voltar para a Índia. Tive que convencer meus pais a me deixarem mudar de universidade..."

# game/scripts/c14/c14.rpy:2070
translate brazilian c14s003_SairaChat_d506710b_1:

    # sai "Cuando llegué a Goa... todo fue más fácil de lo que esperaba. Kalyani, mi prima, también empieza la Universidad este año, fue una aliada increíble."
    sai "Quando cheguei em Goa... tudo foi mais fácil do que eu esperava. Kalyani, minha prima, que também vai começar a universidade este ano, foi uma aliada incrível."

# game/scripts/c14/c14.rpy:2071
translate brazilian c14s003_SairaChat_ab224c65_1:

    # sai "Y creí que al menos mirarías los expedientes de las chicas que iban a vivir contigo... y que me llamarías."
    sai "E eu pensei que você ao menos daria uma olhada nos arquivos das meninas que iriam morar com você... e que você me ligaria."

# game/scripts/c14/c14.rpy:2072
translate brazilian c14s003_SairaChat_80920f3e_1:

    # mc "Sé que no es excusa, pero he estado muy ocupado, y de eso se ocupan [nor] y [mar]."
    mc "Sei que não é desculpa, mas tenho estado muito ocupado, e é disso que [nor] e [mar] estão a tratar."

# game/scripts/c14/c14.rpy:2074
translate brazilian c14s003_SairaChat_ace52d5d_1:

    # sai "Por eso te llamé desde Barcelona. No sabía si te habías enfadado o si no te habías enterado."
    sai "Por isso te liguei de Barcelona. Eu não sabia se você estava bravo ou se nem tinha percebido."

# game/scripts/c14/c14.rpy:2075
translate brazilian c14s003_SairaChat_cd6534e8_1:

    # mc "Y te dejaste la videoconferencia abierta..."
    mc "E você deixou a videoconferência aberta..."

# game/scripts/c14/c14.rpy:2077
translate brazilian c14s003_SairaChat_8565ad04_1:

    # sai "Y dije cosas que no debería haber dicho... sobre Eileen..."
    sai "E eu disse coisas que não deveria ter dito... sobre Eileen..."

# game/scripts/c14/c14.rpy:2079
translate brazilian c14s003_SairaChat_3f631bb6_1:

    # mc "Lo sé. Por eso te pregunto ¿Serías capaz de volver a aceptar una relación abierta? Esta vez yo sí que estoy con alguien más..."
    mc "Eu sei. É por isso que estou te perguntando, você aceitaria um relacionamento aberto novamente? Desta vez, estou com outra pessoa..."

# game/scripts/c14/c14.rpy:2081
translate brazilian c14s003_SairaChat_3383f6ba_1:

    # mc "Lo sé. Por eso te pregunto ¿Realmente quieres una relación abierta?"
    mc "Eu sei. É por isso que estou te perguntando: você realmente quer um relacionamento aberto?"

# game/scripts/c14/c14.rpy:2083
translate brazilian c14s003_SairaChat_4dc809e9_1:

    # sai "No lo sé."
    sai "Não sei."

# game/scripts/c14/c14.rpy:2084
translate brazilian c14s003_SairaChat_ef128114:

    # sai "Cuando me has besado en la mejilla en el aeropuerto todo ha parecido que... no sé... que se derrumbaba..."
    sai "Quando você me beijou na bochecha no aeroporto, tudo pareceu... não sei... como se estivesse desmoronando..."

# game/scripts/c14/c14.rpy:2086
translate brazilian c14s003_SairaChat_1e2c5f92:

    # sai "Cuando me he enterado que estás con alguien... todo se ha roto... no sé como explicarlo..."
    sai "Quando descobri que você estava com outra pessoa... tudo desmoronou... Não sei como explicar..."

# game/scripts/c14/c14.rpy:2087
translate brazilian c14s003_SairaChat_731785bc:

    # mc "Si volvieramos a estar juntos, sería la misma relación que tú quisiste tener en Portland."
    mc "Se voltássemos a ficar juntos, seria o mesmo tipo de relacionamento que você queria ter em Portland."

# game/scripts/c14/c14.rpy:2089
translate brazilian c14s003_SairaChat_e27ec76d_1:

    # sai "Por supuesto que te quiero para mí sola, pero llevo un mes pensando en si estarías con Eileen o no..."
    sai "É claro que eu quero você só para mim, mas faz um mês que estou me perguntando se você está com a Eileen ou não..."

# game/scripts/c14/c14.rpy:2090
translate brazilian c14s003_SairaChat_0a7f8572_1:

    # mc "No lo estoy. Ni con nadie."
    mc "Não. Não com ninguém."

# game/scripts/c14/c14.rpy:2092
translate brazilian c14s003_SairaChat_3ec6fcaa:

    # sai "Lo sé. Pero en Portland sabía... creía... que no ibas a estar con nadie. No eres de los que se acuestan con la primera que pasa si no sientes nada por ella..."
    sai "Eu sei. Mas em Portland eu sabia... eu pensava... que você não ia ficar com ninguém. Você não é do tipo que transa com a primeira pessoa que aparece se não sente nada por ela..."

# game/scripts/c14/c14.rpy:2094
translate brazilian c14s003_SairaChat_fdeb9d69:

    # mc "Saira, si estoy con alguien más, es porque estoy tan enamorado de ella como lo estaba de ti."
    mc "Saira, se estou com outra pessoa, é porque a amo tanto quanto amei você."

# game/scripts/c14/c14.rpy:2096
translate brazilian c14s003_SairaChat_a0409f27:

    # mc "Saira, si estuviera con alguien más, sería porque estaría tan enamorado de ella como lo estaba de ti."
    mc "Saira, se eu estivesse com outra pessoa, seria porque eu a amava tanto quanto a amava."

# game/scripts/c14/c14.rpy:2097
translate brazilian c14s003_SairaChat_d979491f_1:

    # mc "Pero no lo estoy. Eso es lo importante."
    mc "Mas eu não sou. Isso é o que importa."

# game/scripts/c14/c14.rpy:2099
translate brazilian c14s003_SairaChat_20073a44:

    # sai "{b}¿Qué?{/b} ¿Estabas?"
    sai "{b}O quê?{/b} Você estava lá?"

# game/scripts/c14/c14.rpy:2100
translate brazilian c14s003_SairaChat_374f7d97:

    # mc "Mi vida se ha complicado mucho... tengo muchos frentes abiertos ahora mismo, y no solo a nivel amoroso."
    mc "Minha vida ficou muito complicada... Tenho muitas frentes abertas agora, e não apenas no âmbito romântico."

# game/scripts/c14/c14.rpy:2101
translate brazilian c14s003_SairaChat_15fb09dd:

    # mc "Verte, pese a que lo esperaba después de la video conferencia, no ha dejado de ser una sorpresa."
    mc "Ver você, mesmo que eu já esperasse por isso depois da videoconferência, ainda foi uma surpresa."

# game/scripts/c14/c14.rpy:2103
translate brazilian c14s003_SairaChat_bafdea0d:

    # sai "¿Puedo al menos abrazarte ahora?"
    sai "Posso pelo menos te dar um abraço agora?"

# game/scripts/c14/c14.rpy:2104
translate brazilian c14s003_SairaChat_801d760a:

    # mc "No necesitas pedir permiso para eso..."
    mc "Você não precisa pedir permissão para isso..."

# game/scripts/c14/c14.rpy:2106
translate brazilian c14s003_SairaChat_58697b7b:

    # sai "Te he echado de menos..."
    sai "Senti sua falta..."

# game/scripts/c14/c14.rpy:2107
translate brazilian c14s003_SairaChat_30c6515a:

    # mc "Y yo a ti..."
    mc "E eu te..."

# game/scripts/c14/c14.rpy:2108
translate brazilian c14s003_SairaChat_15b67a9e:

    # mc "Pero tenemos que hablar de muchas cosas, analizar cómo nos sentimos. ¿Te importa si nos tomamos un tiempo antes de tomar alguna decisión?"
    mc "Mas precisamos conversar sobre muitas coisas, analisar como nos sentimos. Você se importaria se disséssemos algo antes de tomar qualquer decisão?"

# game/scripts/c14/c14.rpy:2110
translate brazilian c14s003_SairaChat_eac236a2:

    # sai "Creo que será lo mejor. Hoy ha sido una montaña rusa de emociones. No me esperaba del todo esta recepción..."
    sai "Acho que será o melhor. Hoje foi uma montanha-russa de emoções. Eu não esperava essa recepção de jeito nenhum..."

# game/scripts/c14/c14.rpy:2111
translate brazilian c14s003_SairaChat_6798e84f:

    # sai "Realmente no sé lo que me esperaba..."
    sai "Eu realmente não sei o que esperar..."

# game/scripts/c14/c14.rpy:2112
translate brazilian c14s003_SairaChat_f0ee1de0:

    # mc "¿Te han dicho lo de mañana en la playa? Podemos volver a hablar si quieres..."
    mc "Eles te falaram sobre o passeio de amanhã na praia? Podemos conversar de novo se você quiser..."

# game/scripts/c14/c14.rpy:2114
translate brazilian c14s003_SairaChat_1e1f9647:

    # sai "Sí, me lo han dicho. Pero de hoy a mañana no creo que cambie mucho. Hay muchas cosas que tenemos que hablar y..."
    sai "Sim, já me disseram. Mas não acho que muita coisa vá mudar até amanhã. Há muitas coisas que precisamos discutir e..."

# game/scripts/c14/c14.rpy:2117
translate brazilian c14s003_SairaChat_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c14/c14.rpy:2118
translate brazilian c14s003_SairaChat_5333b42a:

    # emm "Soy yo."
    emm "Sou eu."

# game/scripts/c14/c14.rpy:2119
translate brazilian c14s003_SairaChat_800fe78d:

    # mc "Pasa, [emm]."
    mc "Passe, [emm]."

# game/scripts/c14/c14.rpy:2122
translate brazilian c14s003_SairaChat_d9028d82:

    # emm "¡Oops! No sabía que {b}ésta{/b} estaba aquí..."
    emm "Ops! Eu não sabia que isso estava aqui..."

# game/scripts/c14/c14.rpy:2125
translate brazilian c14s003_SairaChat_b1e27bb6:

    # emm "¡Oops! No sabía que estabas acompañado..."
    emm "Ops! Eu não sabia que você estava com alguém..."

# game/scripts/c14/c14.rpy:2126
translate brazilian c14s003_SairaChat_697763a5:

    # mc "¿Querías algo?"
    mc "Você queria alguma coisa?"

# game/scripts/c14/c14.rpy:2127
translate brazilian c14s003_SairaChat_6f551207:

    # emm "Sí, la cena está casi lista. Mamá me ha dicho que te avise."
    emm "Sim, o jantar está quase pronto. Mamãe pediu para eu te avisar."

# game/scripts/c14/c14.rpy:2129
translate brazilian c14s003_SairaChat_7823a63e:

    # mc "Ya seguiremos hablando mañana, Saira."
    mc "Continuaremos conversando amanhã, Saira."

# game/scripts/c14/c14.rpy:2130
translate brazilian c14s003_SairaChat_37aac704:

    # sai "Genial. ¿Hablamos en la playa?"
    sai "Ótimo. Vamos conversar na praia?"

# game/scripts/c14/c14.rpy:2131
translate brazilian c14s003_SairaChat_de4d03e5:

    # mc "Perfecto."
    mc "Perfeito."

# game/scripts/c14/c14.rpy:2135
translate brazilian c14s003_SairaChat_9d9029ba:

    # emm "*Gruñido*"
    emm "*Rosnar*"

# game/scripts/c14/c14.rpy:2137
translate brazilian c14s003_SairaChat_f8abbbc5:

    # "Pasáis una agradable noche en familia, una familia a la que se ha añadido Scarlett. Kiara y Eileen se unen a vosotros en la cena. A este paso tendréis que comprar una mesa más grande."
    "Você está tendo uma noite adorável com sua família, uma família que agora inclui Scarlett. Kiara e Eileen se juntarão a vocês para o jantar. Nesse ritmo, vocês precisarão comprar uma mesa maior."

# game/scripts/c14/c14.rpy:2138
translate brazilian c14s003_SairaChat_d7153543:

    # "Eileen está en su salsa, hablando con toda la familia, a la que conoce desde hace años y poniéndose al día con todo el mundo."
    "Eileen está em seu elemento, conversando com toda a família, que ela conhece há anos, e colocando o papo em dia com todos."

# game/scripts/c14/c14.rpy:2139
translate brazilian c14s003_SairaChat_cafcc8ce:

    # "Scarlett, [mar], y [nor] intentan integrar a Kiara en la conversación. Se la ve un poco desubicada. No está acostumbrada a una familia así, ni a cenas llenas de risas."
    "Scarlett, [mar] e [nor] tentam incluir Kiara na conversa. Ela parece um pouco deslocada. Não está acostumada a uma família assim, nem a jantares cheios de risadas."

# game/scripts/c14/c14.rpy:2140
translate brazilian c14s003_SairaChat_b5ea1e09:

    # "No se habla de ninguno de los temas escabrosos del día. Es el momento de dejarlos atrás."
    "Nenhum dos assuntos delicados do dia será discutido. É hora de deixá-los para trás."

# game/scripts/c14/c14.rpy:2169
translate brazilian c14s004_ToTheBeach_0bd072a9:

    # centered "{size=+20}{b}DÍA 16 – MIÉRCOLES{/b}{/size}"
    centered "{size=+20}{b}DIA 16 – QUARTA-FEIRA{/b}{/size}"

# game/scripts/c14/c14.rpy:2171
translate brazilian c14s004_ToTheBeach_8e894ef2:

    # "El día siguiente es un torbellino de actividad."
    "O dia seguinte é uma correria frenética."

# game/scripts/c14/c14.rpy:2173
translate brazilian c14s004_ToTheBeach_d1affad6:

    # "Acabar de preparar la comida... aunque unas colaboran más que otras..."
    "Termine de preparar a comida... embora alguns ajudem mais do que outros..."

# game/scripts/c14/c14.rpy:2174
translate brazilian c14s004_ToTheBeach_6c87b493:

    # "Kate y Betty se dedican a aligerar la carga. Después dirán que así había menos cosas que bajar a los coches."
    "Kate e Betty aliviam a carga. Mais tarde, elas dirão que assim havia menos coisas para carregar até os carros."

# game/scripts/c14/c14.rpy:2176
translate brazilian c14s004_ToTheBeach_8c67420c:

    # "Coger todos los artilugios de playa... Habiendo una piscina, ¿quién quiere ir a la playa? Lleváis años sin pisar la playa, al menos en familia."
    "Preparem todos os equipamentos de praia... Com uma piscina, quem quer ir à praia? Vocês não vão à praia há anos, pelo menos não em família."

# game/scripts/c14/c14.rpy:2177
translate brazilian c14s004_ToTheBeach_9c8b13ca:

    # "Casi todo el mundo tiene buena parte del día libre hoy, con lo que es el día perfecto."
    "Quase todos têm boa parte do dia de folga hoje, o que torna este dia perfeito."

# game/scripts/c14/c14.rpy:2178
translate brazilian c14s004_ToTheBeach_c6b7c512:

    # "Subirlo todo a los coches... Todo el mundo colabora con lo que puede."
    "Carreguem tudo nos carros... Todos ajudam com o que podem."

# game/scripts/c14/c14.rpy:2179
translate brazilian c14s004_ToTheBeach_250f2cca:

    # "Si ayer parecíais una familia subiendo las cosas de Scarlett a su habitación, hoy lo sois."
    "Se ontem você parecia uma família carregando as coisas da Scarlett para o quarto dela, hoje você é."

# game/scripts/c14/c14.rpy:2181
translate brazilian c14s004_ToTheBeach_db3ce6bd:

    # "Incluso Lisa y Saira colaboran antes de ir a la universidad. Esperan llegar para comer a la playa y unirse a la celebración navideña."
    "Até Lisa e Saira estão ajudando antes de irem para a universidade. Elas estão ansiosas para chegar a tempo do almoço na praia e participar da celebração de Natal."

# game/scripts/c14/c14.rpy:2182
translate brazilian c14s004_ToTheBeach_37795a13:

    # "Kim y Debbie tienen clase por la tarde. Kate se va a saltar sus clases, demasiado cercanas a la hora de comer, y prefiere pasar el día con la familia. La Familia."
    "Kim e Debbie têm aulas à tarde. Kate vai faltar às aulas, que são muito perto da hora do almoço, e prefere passar o dia com a família. A Família."

# game/scripts/c14/c14.rpy:2184
translate brazilian c14s004_ToTheBeach_3331e286:

    # "Llevas a Lisa y Saira a la universidad antes de ir a volver a casa a recoger un nuevo cargamento de chicas. 16 personas viviendo en casa y solo tres coches..."
    "Você leva Lisa e Saira para a universidade antes de voltar para casa para buscar um novo grupo de garotas. Dezesseis pessoas morando na casa e apenas três carros..."

# game/scripts/c14/c14.rpy:2186
translate brazilian c14s004_ToTheBeach_f36417c1:

    # "Por fin llegáis a la playa. Samantha y Simone se unirán más tarde. Jamaal no va a poder venir. Algo sobre una indigestión por comer demasiadas empanadas."
    "Você finalmente chegou à praia. Samantha e Simone se juntarão a você mais tarde. Jamaal não poderá vir. Algo relacionado à indigestão por ter comido muitas empanadas."

# game/scripts/c14/c14.rpy:2189
translate brazilian c14s004_ToTheBeach_556f62c9:

    # "Vas al chiringuito a mear antes de descargar las cosas."
    "Você vai ao bar da praia para urinar antes de descarregar suas coisas."

# game/scripts/c14/c14.rpy:2196
translate brazilian c14s004_ToTheBeach_2f9ef6e7:

    # mc "¿Os ayudo a algo con la comida?"
    mc "Posso te ajudar com algo relacionado à comida?"

# game/scripts/c14/c14.rpy:2197
translate brazilian c14s004_ToTheBeach_265dec31:

    # mom "No hace falta. Estos son los últimos túpers y comeremos en el merendero. Las mujeres vamos a quedarnos poniéndonos morenas mientras las chicas juegan en el agua."
    mom "Não precisa. Estes são os últimos recipientes Tupperware, e vamos comer na área de piquenique. As mulheres ficarão aqui para tomar sol enquanto as meninas brincam na água."

# game/scripts/c14/c14.rpy:2198
translate brazilian c14s004_ToTheBeach_6f7e40ce:

    # mc "Déjame al menos llevarlos hasta las sombrillas."
    mc "Ao menos vou levá-los até os guarda-chuvas."

# game/scripts/c14/c14.rpy:2200
translate brazilian c14s004_ToTheBeach_d2410ecc:

    # mom "Supongo que no te apetece tumbarte con nosotras a tomar el sol..."
    mom "Imagino que você não esteja com vontade de se deitar conosco para tomar sol..."

# game/scripts/c14/c14.rpy:2201
translate brazilian c14s004_ToTheBeach_13d6ddcb:

    # mc "Yo me quedaría, pero sabes que me aburro muchísimo estando tirado en la toalla estilo lagarto sin hacer nada."
    mc "Eu ficaria, mas você sabe que eu fico incrivelmente entediado deitado na toalha como um lagarto sem fazer nada."

# game/scripts/c14/c14.rpy:2203
translate brazilian c14s004_ToTheBeach_ec8e90a6:

    # mom "Lo sé, cariño. ¿Por qué no ayudas a Betty con las sillas?"
    mom "Eu sei, querida. Por que você não ajuda a Betty com as cadeiras?"

# game/scripts/c14/c14.rpy:2204
translate brazilian c14s004_ToTheBeach_c5a461a2:

    # mc "¡Dejo los túpers en las toallas y voy! Te quiero."
    mc "Vou deixar os potes de Tupperware em cima das toalhas e já vou! Te amo."

# game/scripts/c14/c14.rpy:2214
translate brazilian c14s004_ToTheBeach_e3a28ce2:

    # mc "Tía Betty, vengo a ayudarte con las sillas."
    mc "Tia Betty, vim te ajudar com as cadeiras."

# game/scripts/c14/c14.rpy:2215
translate brazilian c14s004_ToTheBeach_a11984a4:

    # bet "No hace falta, cielo. Ya casi las he llevado todas con la ayuda de las chicas."
    bet "Não precisa, querida. Eu já peguei quase todas com a ajuda das meninas."

# game/scripts/c14/c14.rpy:2216
translate brazilian c14s004_ToTheBeach_259650b3:

    # mc "Por cierto, ¿ese es el modelo de bikini oficial del Vaticano? Lo veo... demasiado sexy, ¿no?"
    mc "Aliás, esse é o modelo oficial de biquíni do Vaticano? Eu o acho... um pouco sexy demais, não acha?"

# game/scripts/c14/c14.rpy:2218
translate brazilian c14s004_ToTheBeach_0b68c78b:

    # bet "*Risa* ¿Sexy yo? Hay que llevarte a que te revisen la vista."
    bet "*Risos* Eu, gostosa? Precisamos te levar para fazer um exame de vista."

# game/scripts/c14/c14.rpy:2219
translate brazilian c14s004_ToTheBeach_ef0aa9bc:

    # bet "Es un antiguo bañador de [nor], de cuando se estaba adelgazando. Es en el único bañador que cabía yo."
    bet "É um maiô antigo da [nor], da época em que ela estava emagrecendo. É o único maiô em que eu conseguia caber."

# game/scripts/c14/c14.rpy:2220
translate brazilian c14s004_ToTheBeach_ae2004ef:

    # mc "Tenemos que renovarte el vestuario. No puedes ir con el hábito a todas partes"
    mc "Precisamos atualizar seu guarda-roupa. Você não pode ir a todos os lugares com esse hábito."

# game/scripts/c14/c14.rpy:2222
translate brazilian c14s004_ToTheBeach_4798ee20:

    # bet "Tienes razón... debería comprarme más ropa... el hábito..."
    bet "Você tem razão... eu deveria comprar mais roupas... é um hábito..."

# game/scripts/c14/c14.rpy:2223
translate brazilian c14s004_ToTheBeach_fef0f016:

    # bet "El hábito no lo puedo usar para todo..."
    bet "Não posso usar hábitos para tudo..."

# game/scripts/c14/c14.rpy:2224
translate brazilian c14s004_ToTheBeach_184a4ec8:

    # mc "Betty, ¿ha pasado algo?"
    mc "Betty, aconteceu alguma coisa?"

# game/scripts/c14/c14.rpy:2226
translate brazilian c14s004_ToTheBeach_d10afe80:

    # bet "No, nada... ¿puedes ir a ayudar a Olivia con la sombrilla? Ya me ocupo yo de llevar el resto de las sillas."
    bet "Não, nada... você pode ir ajudar a Olivia com o guarda-sol? Eu me encarrego de carregar o resto das cadeiras."

# game/scripts/c14/c14.rpy:2227
translate brazilian c14s004_ToTheBeach_9e97d52f:

    # mc "¡Voy! Te quiero."
    mc "Estou chegando! Eu te amo."

# game/scripts/c14/c14.rpy:2235
translate brazilian c14s004_ToTheBeach_dd3acbb4:

    # mee "¿Quieres algo, cariño?"
    mee "Você quer alguma coisa, querida?"

# game/scripts/c14/c14.rpy:2236
translate brazilian c14s004_ToTheBeach_c27ed1f7:

    # mc "Tía Betty me ha enviado a que te ayude con la sombrilla."
    mc "A tia Betty me mandou para te ajudar com o guarda-chuva."

# game/scripts/c14/c14.rpy:2238
translate brazilian c14s004_ToTheBeach_0bfa1458:

    # mee "Gracias, cielo, pero la acabo de derrotar una vez ha parado el viento."
    mee "Obrigada, querida, mas eu a derrotei assim que o vento parou."

# game/scripts/c14/c14.rpy:2239
translate brazilian c14s004_ToTheBeach_e539c887:

    # mc "Casi parecías una stripper cogida a esa barra. *Risa*"
    mc "Você quase parecia uma stripper se agarrando naquele poste. *Risos*"

# game/scripts/c14/c14.rpy:2241
translate brazilian c14s004_ToTheBeach_e10117ec:

    # mee "¡[mc]!"
    mee "[mc]!"

# game/scripts/c14/c14.rpy:2242
translate brazilian c14s004_ToTheBeach_e81ee9a0:

    # mc "Perdona, me estoy empezando a sentir un poco inútil y eso me frustra. Parece que no me necesitáis para nada."
    mc "Sinto muito, estou começando a me sentir um pouco inútil e isso é frustrante. Parece que você não precisa de mim."

# game/scripts/c14/c14.rpy:2244
translate brazilian c14s004_ToTheBeach_c6302da7:

    # mee "Cariño, estás rodeado de mujeres que no te han visto en años. No voy a decir que no te necesitemos, siempre te necesitaremos, pero sabemos apañarnos solas."
    mee "Querida, você está cercada por mulheres que não te veem há anos. Não vou dizer que não precisamos de você, sempre precisaremos, mas sabemos nos virar sozinhas."

# game/scripts/c14/c14.rpy:2245
translate brazilian c14s004_ToTheBeach_4d554932:

    # mc "No es que me ayudes mucho. *Risa*"
    mc "Você não está me ajudando muito. *Risos*"

# game/scripts/c14/c14.rpy:2247
translate brazilian c14s004_ToTheBeach_2f73b4e3:

    # mee "Ven que te de un abrazo. Esto seguro que ayuda."
    mee "Vem cá, deixa eu te dar um abraço. Isso com certeza vai ajudar."

# game/scripts/c14/c14.rpy:2248
translate brazilian c14s004_ToTheBeach_8736c3dc:

    # mc "Por supuesto que sí, Meemaw."
    mc "Claro, vovó."

# game/scripts/c14/c14.rpy:2250
translate brazilian c14s004_ToTheBeach_53993a4a:

    # mee "Deberías ir a ayudar a [nor]. Está trayendo las neveras."
    mee "Você deveria ir ajudar [nor]. Ele está trazendo os refrigeradores."

# game/scripts/c14/c14.rpy:2251
translate brazilian c14s004_ToTheBeach_ff6d8cc3:

    # mc "¿Las? ¿En plural? ¡Voy! Te quiero."
    mc "Eles? No plural? Estou chegando! Amo vocês."

# game/scripts/c14/c14.rpy:2257
translate brazilian c14s004_ToTheBeach_0d183e14:

    # mc "¿Qué haces llevando eso?"
    mc "O que você está fazendo vestindo isso?"

# game/scripts/c14/c14.rpy:2258
translate brazilian c14s004_ToTheBeach_901b11db:

    # nor "Solo son un par de neveras, cielo."
    nor "São só duas geladeiras, querida."

# game/scripts/c14/c14.rpy:2260
translate brazilian c14s004_ToTheBeach_7589425b:

    # mc "En tu estado no deberías llevar ni una. Ya las llevo yo."
    mc "Na sua condição, você não precisa usar nenhum. Eu já tenho os meus."

# game/scripts/c14/c14.rpy:2262
translate brazilian c14s004_ToTheBeach_0d3062b0:

    # nor "Aún no sabemos nada. Todavía faltan días para que sea fiable, y no me voy a quedar parada por si acaso..."
    nor "Ainda não sabemos de nada. Vai demorar alguns dias até que seja confiável, e eu não vou ficar sentado esperando..."

# game/scripts/c14/c14.rpy:2263
translate brazilian c14s004_ToTheBeach_6c000576:

    # mc "¿Prefieres arriesgarte? Ahora me vas a decir que también vas a beber vino en la comida..."
    mc "Você prefere correr o risco? Agora você vai me dizer que também vai beber vinho com a refeição..."

# game/scripts/c14/c14.rpy:2265
translate brazilian c14s004_ToTheBeach_4b5863fb:

    # nor "No pensaba hacerlo. Ya viste en la cena de anoche que sólo bebí agua. Pese a las miradas raras de [mar]."
    nor "Eu não estava planejando. Você viu no jantar ontem à noite que eu só bebi água. Apesar dos olhares estranhos de [mar]."

# game/scripts/c14/c14.rpy:2266
translate brazilian c14s004_ToTheBeach_ea865f30:

    # mc "Lo ví..."
    mc "Eu o vi..."

# game/scripts/c14/c14.rpy:2268
translate brazilian c14s004_ToTheBeach_c2e72cf2:

    # nor "Aunque para hoy le pedí a [mar] que comprara cava sin alcohol, con la excusa de que era para que las chicas también puedan brindar."
    nor "Embora hoje eu tenha pedido [mar] para comprar cava sem álcool, com a desculpa de que era para que as meninas também pudessem brindar."

# game/scripts/c14/c14.rpy:2270
translate brazilian c14s004_ToTheBeach_08960e01:

    # mc "¿Sólo? ¿Te parecen pocas? ¿Qué llevas ahí? Ya las llevo yo."
    mc "Só isso? Acha que não é suficiente? O que você está carregando aí? Eu já estou carregando tudo isso."

# game/scripts/c14/c14.rpy:2272
translate brazilian c14s004_ToTheBeach_af9900ac:

    # nor "¡No soy una floja! Solo son las bebidas. Las neveras con la comida se las han llevado las chicas."
    nor "Eu não sou preguiçosa! São só as bebidas. As meninas levaram os coolers com a comida."

# game/scripts/c14/c14.rpy:2273
translate brazilian c14s004_ToTheBeach_5974f1ca:

    # mc "Y ¿necesitamos dos neveras para la bebida?"
    mc "E precisamos mesmo de duas geladeiras para bebidas?"

# game/scripts/c14/c14.rpy:2275
translate brazilian c14s004_ToTheBeach_a5536b1e:

    # nor "Todo el mundo bebe cosas diferentes. Esta vez incluso tenemos cava sin alcohol para que las chicas también puedan brindar."
    nor "Cada um bebe algo diferente. Desta vez, temos até cava sem álcool para que as mulheres também possam brindar."

# game/scripts/c14/c14.rpy:2276
translate brazilian c14s004_ToTheBeach_dc142a17:

    # mc "[nor], las chicas ya tienen 18, pueden beber alcohol si quieren. Y lo hacen..."
    mc "[nor], as meninas já têm 18 anos, podem beber álcool se quiserem. E bebem..."

# game/scripts/c14/c14.rpy:2278
translate brazilian c14s004_ToTheBeach_8d810fe4:

    # nor "Lo sé, pero hoy no van a controlar cuanto beben, entre la comida y los brindis... Es Navidad. *Risa*"
    nor "Eu sei, mas eles não vão controlar o quanto vão beber hoje, entre a comida e os brindes... É Natal. *Risos*"

# game/scripts/c14/c14.rpy:2279
translate brazilian c14s004_ToTheBeach_83fcaf3d:

    # mc "Me parece una buena excusa para tener cava sin alcohol. Bien pensado."
    mc "Acho que é uma boa desculpa para tomar cava sem álcool. Muito bem pensado."

# game/scripts/c14/c14.rpy:2281
translate brazilian c14s004_ToTheBeach_7e8b81ce:

    # nor "Puedes dejar las neveras bajo la sombrilla. Yo iré a por la crema al coche."
    nor "Pode deixar as caixas térmicas debaixo do guarda-sol. Vou buscar o protetor solar no carro."

# game/scripts/c14/c14.rpy:2282
translate brazilian c14s004_ToTheBeach_21611b89:

    # mc "¿Algo más en lo que pueda ayudar?"
    mc "Há mais alguma coisa em que eu possa ajudar?"

# game/scripts/c14/c14.rpy:2284
translate brazilian c14s004_ToTheBeach_993fa1c4:

    # nor "No, creo que ya está todo... a menos que quieras ponernos crema solar a todas las que nos quedamos en las toallas."
    nor "Não, acho que é só isso... a menos que você queira passar protetor solar em todos nós que estamos deitados nas toalhas."

# game/scripts/c14/c14.rpy:2287
translate brazilian c14s004_ToTheBeach_692cf86c:

    # nor "Aunque ya sabemos como acaba eso cuando tú estás cerca..."
    nor "Embora já saibamos como isso termina quando você está por perto..."

# game/scripts/c14/c14.rpy:2288
translate brazilian c14s004_ToTheBeach_90d27dbf:

    # mc "Mejor voy a pasar, por lo que pueda ser."
    mc "É melhor eu passar, por precaução."

# game/scripts/c14/c14.rpy:2290
translate brazilian c14s004_ToTheBeach_da704a7d:

    # mc "Si queréis, por mí ningún problema."
    mc "Se você quiser, por mim tudo bem."

# game/scripts/c14/c14.rpy:2292
translate brazilian c14s004_ToTheBeach_21a8ed60:

    # nor "Lo estaba diciendo en broma, cielo. Estando cinco mujeres aquí, sería raro que nos pusieras la crema tú, ¿no?"
    nor "Eu estava só brincando, querida. Com cinco mulheres aqui, seria estranho se fosse você a passar o hidratante em nós, não seria?"

# game/scripts/c14/c14.rpy:2293
translate brazilian c14s004_ToTheBeach_961acb0b:

    # nor "Puedes ir con las chicas. Iban a jugar a algo en el agua."
    nor "Você pode ir com as meninas. Elas iam brincar na água."

# game/scripts/c14/c14.rpy:2294
translate brazilian c14s004_ToTheBeach_9e97d52f_1:

    # mc "¡Voy! Te quiero."
    mc "Estou chegando! Eu te amo."

# game/scripts/c14/c14.rpy:2304
translate brazilian c14s004_ToTheBeach_91d1ec52:

    # mc "¡Oh, Kiara! No te había visto desde que hemos llegado. Te sienta bien ese bañador."
    mc "Oh, Kiara! Não te vejo desde que chegamos. Esse maiô ficou ótimo em você."

# game/scripts/c14/c14.rpy:2305
translate brazilian c14s004_ToTheBeach_e2f5f514:

    # kia "Gracias, [mc]. Estaba ayudando a Betty con las sillas. Te he visto irte en dirección a Olivia."
    kia "Obrigada, [mc]. Eu estava ajudando a Betty com as cadeiras. Eu vi você indo em direção à Olivia."

# game/scripts/c14/c14.rpy:2306
translate brazilian c14s004_ToTheBeach_f1423be7:

    # mc "Ahora me siento más inutil todavía. Me ha dicho que no necesitaba mi ayuda..."
    mc "Agora me sinto ainda mais inútil. Ele me disse que não precisava da minha ajuda..."

# game/scripts/c14/c14.rpy:2308
translate brazilian c14s004_ToTheBeach_0b1690b6:

    # kia "La mía tampoco, pero como me tratan entre algodones, no ha podido negarse a que la ayudara. *Risa*"
    kia "A minha também não, mas como me tratam como realeza, ela não pôde recusar minha ajuda. *Risos*"

# game/scripts/c14/c14.rpy:2309
translate brazilian c14s004_ToTheBeach_926f1d6e:

    # mc "¿Cómo está el brazo?"
    mc "Como está seu braço?"

# game/scripts/c14/c14.rpy:2311
translate brazilian c14s004_ToTheBeach_bebf42ef:

    # kia "Duele menos, pero aún duele un poco. El ungüento que me dió Samantha es fantástico."
    kia "Dói menos, mas ainda dói um pouco. A pomada que a Samantha me deu é fantástica."

# game/scripts/c14/c14.rpy:2312
translate brazilian c14s004_ToTheBeach_57a3ab27:

    # mc "Eso está genial."
    mc "Isso é ótimo."

# game/scripts/c14/c14.rpy:2313
translate brazilian c14s004_ToTheBeach_8cd57a4a:

    # mc "¿Estáis a gusto en casa de [nor]? Si no, podéis volver a mi cama."
    mc "Você se sente confortável na casa de [nor]? Se não, você pode voltar para a minha cama."

# game/scripts/c14/c14.rpy:2315
translate brazilian c14s004_ToTheBeach_51e9bce6:

    # kia "No te preocupes, la casa es fantástica y [nor] nos está tratando increíblemente bien."
    kia "Não se preocupe, a casa é fantástica e [nor] está nos tratando incrivelmente bem."

# game/scripts/c14/c14.rpy:2316
translate brazilian c14s004_ToTheBeach_71778941:

    # kia "De lo que tengo ganas es de que llegue mañana para poder ir a casa a por más ropa. El bikini me lo ha dejado [emm], era la talla más parecida a la mía, aunque sea mucho más alta."
    kia "Estou ansiosa para amanhã, para poder ir para casa e comprar mais roupas. [emm] me emprestou o biquíni; era o tamanho mais próximo do meu, mesmo eu sendo bem mais alta."

# game/scripts/c14/c14.rpy:2317
translate brazilian c14s004_ToTheBeach_7f758d2f:

    # mc "No tengas prisa. Hoy vuelve Alexia a Newport. A ver si puede acompañarnos mañana. De uniforme a ser posible."
    mc "Não tenha pressa. Alexia está voltando para Newport hoje. Vamos ver se ela consegue se juntar a nós amanhã. De uniforme, se possível."

# game/scripts/c14/c14.rpy:2319
translate brazilian c14s004_ToTheBeach_ce0c5779:

    # kia "No creo que sea necesario. Solomon no estará."
    kia "Não acho necessário. Salomão não estará lá."

# game/scripts/c14/c14.rpy:2320
translate brazilian c14s004_ToTheBeach_f3f60e1e:

    # mc "De todas formas se lo pediré. Yo si que os acompañaré, deberéis cargar las cosas en la camioneta."
    mc "Vou perguntar a ele de qualquer maneira. Eu vou com você; você terá que carregar as coisas no caminhão."

# game/scripts/c14/c14.rpy:2322
translate brazilian c14s004_ToTheBeach_379072c5:

    # kia "¿Te importa si lo hablamos mañana? Prefiero no pensar en eso hasta que llegue el momento... Volver a mi propia casa como si fuera una ladrona..."
    kia "Você se importa se conversarmos sobre isso amanhã? Prefiro não pensar nisso até que chegue a hora... Voltar para minha própria casa como se eu fosse um ladrão..."

# game/scripts/c14/c14.rpy:2323
translate brazilian c14s004_ToTheBeach_19016501:

    # mc "No te preocupes. Lo hablamos mañana. Ven aquí."
    mc "Não se preocupe. Falaremos sobre isso amanhã. Venha aqui."

# game/scripts/c14/c14.rpy:2325
translate brazilian c14s004_ToTheBeach_766b6a11:

    # kia "Gracias, [mc]. Por todo. Por acogernos en tu familia y por ayudarnos."
    kia "Obrigado, [mc]. Por tudo. Por nos acolher em sua família e por nos ajudar."

# game/scripts/c14/c14.rpy:2326
translate brazilian c14s004_ToTheBeach_37d11dea:

    # mc "No le des más vueltas. Es Navidad. *Risa*"
    mc "Não pense demais nisso. É Natal. *Risos*"

# game/scripts/c14/c14.rpy:2328
translate brazilian c14s004_ToTheBeach_19de8534:

    # kia "Bueno, voy a sentarme bajo la sombrilla. Pelirroja y blanca de piel es receta para quemarme."
    kia "Ok, vou sentar embaixo do guarda-sol. Cabelo ruivo e pele clara são a receita perfeita para queimaduras solares."

# game/scripts/c14/c14.rpy:2329
translate brazilian c14s004_ToTheBeach_3699eb23:

    # mc "Perfecto, nos vemos luego."
    mc "Perfeito, até mais tarde."

# game/scripts/c14/c14.rpy:2335
translate brazilian c14s004_ToTheBeach_4a9931ba:

    # mc "Hey, [dap]. ¿Donde vas con esa pelota?"
    mc "Ei, [dap]. Para onde você está indo com essa bola?"

# game/scripts/c14/c14.rpy:2336
translate brazilian c14s004_ToTheBeach_479536e4:

    # dap "Kate nos ha convencido a para jugar al juego aquel que explicó en la piscina el otro día. El parecido a Verdad o Reto con la pelota"
    dap "Kate nos convenceu a jogar aquele jogo que ela explicou na piscina outro dia. É parecido com Verdade ou Desafio, só que com uma bola."

# game/scripts/c14/c14.rpy:2337
translate brazilian c14s004_ToTheBeach_e0f67ad6:

    # mc "Recuerda cómo acabó la última vez que jugamos... no demasiado bien."
    mc "Lembra como terminou da última vez que jogamos... não muito bem."

# game/scripts/c14/c14.rpy:2339
translate brazilian c14s004_ToTheBeach_59b46b68:

    # dap "Lo sé, pero ahora es un poco diferente. Nos va a servir para conocernos más. Scarlett casi no ha tratado con Kim, Debbie, y Kate, y ahora viviendo en casa..."
    dap "Eu sei, mas agora é um pouco diferente. Isso vai nos ajudar a nos conhecermos melhor. Scarlett quase não teve contato com Kim, Debbie e Kate, e agora está morando em casa..."

# game/scripts/c14/c14.rpy:2340
translate brazilian c14s004_ToTheBeach_32aa2675:

    # mc "Como queráis, pero quizás hoy no sería el mejor día para crear malos rollos. Es Navidad."
    mc "Faça o que quiser, mas talvez hoje não seja o melhor dia para causar problemas. É Natal."

# game/scripts/c14/c14.rpy:2342
translate brazilian c14s004_ToTheBeach_f30f6062:

    # dap "No te preocupes. Los malos rollos en los juegos siempre los crea [emm] cuando se pica, y se ha ido a dar un paseo por la playa con [eri] y Eileen."
    dap "Não se preocupe. As más vibrações nos jogos são sempre causadas por [emm] quando ele fica zangado, e ele foi dar um passeio na praia com [eri] e Eileen."

# game/scripts/c14/c14.rpy:2343
translate brazilian c14s004_ToTheBeach_e08e4a8f:

    # mc "Entonces... Kate, Kim, Debbie, Scarlett, tú, y yo, ¿no?"
    mc "Então... Kate, Kim, Debbie, Scarlett, você e eu, certo?"

# game/scripts/c14/c14.rpy:2345
translate brazilian c14s004_ToTheBeach_806c68a5:

    # dap "¿Tú también te apuntas? ¿No crees que les vas a cortar el rollo a las chicas?"
    dap "Você também topa? Não acha que vai estragar o clima para as meninas?"

# game/scripts/c14/c14.rpy:2346
translate brazilian c14s004_ToTheBeach_c4c02c84:

    # mc "O les corto el rollo o evito que os desmadréis todas. Tenéis mucho peligro."
    mc "Ou eu dou um basta nisso, ou impeço que vocês todos enlouqueçam de vez. Vocês são perigosos."

# game/scripts/c14/c14.rpy:2348
translate brazilian c14s004_ToTheBeach_91c83337:

    # dap "¡Nuestro salvador ha llegado! *Risa*"
    dap "Nosso salvador chegou! *Risos*"

# game/scripts/c14/c14.rpy:2349
translate brazilian c14s004_ToTheBeach_049e8d05:

    # mc "Siempre dispuesto a ayudar. *Risa*"
    mc "Sempre disposto a ajudar. *Risos*"

# game/scripts/c14/c14.rpy:2352
translate brazilian c14s004_ToTheBeach_e105975f:

    # dap "Hablando de ayudar... ¿Pudiste reservar mesa en el sitio que te mandé para esta noche?"
    dap "Por falar em ajudar... Você conseguiu reservar uma mesa no restaurante que te indiquei para hoje à noite?"

# game/scripts/c14/c14.rpy:2353
translate brazilian c14s004_ToTheBeach_eefefae5:

    # mc "Sí. Les llamé por teléfono. El tío que me atendió hablaba raro, pero al final hice la reserva."
    mc "Sim. Liguei para eles. O rapaz que atendeu falou de um jeito estranho, mas acabei fazendo a reserva."

# game/scripts/c14/c14.rpy:2354
translate brazilian c14s004_ToTheBeach_0b0c77a2:

    # mc "Por un momento parecía que había un error, había otra reserva a nombre de otros Marks, pero al final el error fue del tío raro."
    mc "Por um momento pareceu que havia um engano, que havia outra reserva em nome de outros Marks, mas no final o erro foi do tio esquisito."

# game/scripts/c14/c14.rpy:2356
translate brazilian c14s004_ToTheBeach_bc519079:

    # dap "¿Hablaba raro? ¿A qué te refieres?"
    dap "Ele falou de um jeito estranho? O que você quer dizer?"

# game/scripts/c14/c14.rpy:2357
translate brazilian c14s004_ToTheBeach_22106d49:

    # mc "Tenía un acento que no localicé. Europeo seguro, pero no sé de donde."
    mc "Ele tinha um sotaque que eu não consegui identificar. Definitivamente europeu, mas não sei de onde."

# game/scripts/c14/c14.rpy:2358
translate brazilian c14s004_ToTheBeach_28d705df:

    # dap "No entraste en la web del restaurante, ¿verdad?"
    dap "Você não acessou o site do restaurante, acessou?"

# game/scripts/c14/c14.rpy:2359
translate brazilian c14s004_ToTheBeach_918a030a:

    # mc "No, ¿tenía que haberlo hecho? Sólo les llamé por teléfono."
    mc "Não, será que eu deveria ter feito isso? Eu só liguei para eles por telefone."

# game/scripts/c14/c14.rpy:2361
translate brazilian c14s004_ToTheBeach_f10c8185:

    # dap "Ahora que lo pienso, no, mejor que no lo hayas hecho. Así será una sorpresa."
    dap "Pensando bem, não, é melhor que você não tenha feito isso. Assim será uma surpresa."

# game/scripts/c14/c14.rpy:2362
translate brazilian c14s004_ToTheBeach_fdce4815:

    # mc "Ahora me has picado la curiosidad."
    mc "Agora você despertou minha curiosidade."

# game/scripts/c14/c14.rpy:2364
translate brazilian c14s004_ToTheBeach_792af854:

    # dap "Prométeme que no lo vas a mirar."
    dap "Prometa-me que você não vai olhar para isso."

# game/scripts/c14/c14.rpy:2365
translate brazilian c14s004_ToTheBeach_5591d8d5:

    # mc "*Risa* Prometido. Si es tan importante para ti, deseo concedido."
    mc "*Risos* Prometo. Se é tão importante para você, seu desejo será atendido."

# game/scripts/c14/c14.rpy:2367
translate brazilian c14s004_ToTheBeach_ec8c75a4:

    # dap "No solo es un caballero sino que también es un genio que concede deseos."
    dap "Ele não é apenas um cavalheiro, mas também um gênio que realiza desejos."

# game/scripts/c14/c14.rpy:2369
translate brazilian c14s004_ToTheBeach_8594335b:

    # dap "¿Vamos?"
    dap "Vamos?"

# game/scripts/c14/c14.rpy:2370
translate brazilian c14s004_ToTheBeach_c898a30c:

    # mc "Después de ti."
    mc "Depois de você."

# game/scripts/c14/c14.rpy:2379
translate brazilian c14s004_ToTheBeach_5d80c863:

    # kat "¿Te unes al juego, [mc]?"
    kat "Você vai entrar no jogo, [mc]?"

# game/scripts/c14/c14.rpy:2380
translate brazilian c14s004_ToTheBeach_07eff936:

    # mc "Si no os molesta..."
    mc "Se você não se importa..."

# game/scripts/c14/c14.rpy:2386
translate brazilian c14s004_ToTheBeach_df20d1ef:

    # deb "No nos puede molestar. Si estás tú a lo mejor se cortan un poco con las preguntas."
    deb "Isso não deveria nos incomodar. Se você estiver lá, eles podem ser um pouco mais cautelosos com as perguntas."

# game/scripts/c14/c14.rpy:2387
translate brazilian c14s004_ToTheBeach_c7928188:

    # mc "Se lo estaba comentando a [dap]. Estos juegos pueden crear malos rollos si la cosa se desmadra."
    mc "Eu estava conversando com [dap] sobre isso agora mesmo. Esses jogos podem criar um clima ruim se as coisas saírem do controle."

# game/scripts/c14/c14.rpy:2393
translate brazilian c14s004_ToTheBeach_8abaea6c:

    # kim "Somos todos adultos, no nos vamos a enfadar por un juego. Puede ser divertido."
    kim "Somos todos adultos, não vamos ficar bravos por causa de um jogo. Pode ser divertido."

# game/scripts/c14/c14.rpy:2394
translate brazilian c14s004_ToTheBeach_72d9123c:

    # mc "La última vez que jugamos a Verdad o Reto hubo enfados. No me fío demasiado. *Risa*"
    mc "Da última vez que jogamos Verdade ou Desafio, a coisa esquentou. Não confio muito nesse jogo. *Risos*"

# game/scripts/c14/c14.rpy:2400
translate brazilian c14s004_ToTheBeach_bff61338:

    # sca "Pero hoy solo está [dap]. [dap] sin [emm] cerca es como un gatito. *Risa*"
    sca "Mas hoje é só [dap]. [dap] sem [emm] por perto é como um gatinho. *Risos*"

# game/scripts/c14/c14.rpy:2401
translate brazilian c14s004_ToTheBeach_01ce7be8:

    # mc "¿Dulce y achuchable?"
    mc "Doce e carinhoso?"

# game/scripts/c14/c14.rpy:2403
translate brazilian c14s004_ToTheBeach_3e322ddb:

    # sca "Eso también, *Gruñido* pero me refería a que mantenía las uñas guardadas. *Risa*"
    sca "Isso também, *resmunga*, mas eu quis dizer que ela mantinha as unhas escondidas. *Risos*"

# game/scripts/c14/c14.rpy:2404
translate brazilian c14s004_ToTheBeach_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c14/c14.rpy:2406
translate brazilian c14s004_ToTheBeach_ef526017:

    # kat "¿Quieres saber las reglas del juego? Hablando con Scarlett hemos mezclado las suyas y las mías."
    kat "Quer saber as regras do jogo? Conversando com a Scarlett, misturamos as dela com as minhas."

# game/scripts/c14/c14.rpy:2409
translate brazilian c14s004_ToTheBeach_415551c4:

    # kat "Jugamos en el agua y nos ponemos en círculo. Quien falle en recoger la pelota escoge Verdad o Reto que es propuesto por quien se la lanzó."
    kat "Brincamos na água em círculo. Quem não conseguir pegar a bola escolhe Verdade ou Desafio, que é proposto por quem jogou a bola."

# game/scripts/c14/c14.rpy:2410
translate brazilian c14s004_ToTheBeach_8e3e40da:

    # kat "La pregunta o el reto van girando en el sentido de las agujas del reloj hasta llegar a quien lo propuso."
    kat "A pergunta ou o desafio gira no sentido horário até chegar à pessoa que o propôs."

# game/scripts/c14/c14.rpy:2411
translate brazilian c14s004_ToTheBeach_f3792e1f:

    # mc "¿Nos podemos negar a responder de alguna forma?"
    mc "Existe alguma forma de nos recusarmos a responder?"

# game/scripts/c14/c14.rpy:2413
translate brazilian c14s004_ToTheBeach_3606776d:

    # kat "Normalmente sí, pagando prenda. Pero tú solo podrías negarte una vez. *Risa*"
    kat "Normalmente, sim, pagando uma multa. Mas você só pode recusar uma vez. *Risos*"

# game/scripts/c14/c14.rpy:2414
translate brazilian c14s004_ToTheBeach_b532f633:

    # kat "Y es posible que después de eso las chicas perdieran interés en el juego. *Risa*"
    kat "E é possível que depois disso as meninas tenham perdido o interesse no jogo. *Risos*"

# game/scripts/c14/c14.rpy:2415
translate brazilian c14s004_ToTheBeach_56a78b1a:

    # mc "OK, entonces vamos obligados a lo que elija la persona de nuestra derecha, o tres personas más allá."
    mc "Certo, então somos obrigados a fazer o que a pessoa à nossa direita escolher, ou três pessoas mais abaixo na fila."

# game/scripts/c14/c14.rpy:2417
translate brazilian c14s004_ToTheBeach_31e5a3b7:

    # sca "Exacto. Como hicimos jugando a la botella hace unos días."
    sca "Exatamente. Igualzinho a quando brincamos de girar a garrafa alguns dias atrás."

# game/scripts/c14/c14.rpy:2418
translate brazilian c14s004_ToTheBeach_3e4aca97:

    # mc "Vale, parece divertido."
    mc "Ok, isso parece divertido."

# game/scripts/c14/c14.rpy:2421
translate brazilian c14s004_ToTheBeach_cb8c317d:

    # kat "Despues no te llames a engaño cuando te caigan retos chungos. *Risa*"
    kat "Não se iluda mais tarde quando os desafios difíceis surgirem. *Risos*"

# game/scripts/c14/c14.rpy:2422
translate brazilian c14s004_ToTheBeach_b9ed52c8:

    # mc "Me arriesgaré. *Risa*"
    mc "Eu assumo o risco. *Risos*"

# game/scripts/c14/c14.rpy:2493
translate brazilian c14s005_BallGame_7cdaeed6:

    # "Os situáis aproximadamente en un círculo y empezáis a pasaros la pelota."
    "Vocês se posicionam mais ou menos em círculo e começam a passar a bola uns para os outros."

# game/scripts/c14/c14.rpy:2494
translate brazilian c14s005_BallGame_e26460f2:

    # "Poco a poco, es cada vez más aparente que a Kim es a quién más le cuesta cazar la pelota. Recuerdas la caída en el aeropuerto y la casi caída en el bosque."
    "Aos poucos, fica cada vez mais claro que Kim é quem está tendo mais dificuldade para pegar a bola. Lembra da queda no aeroporto e da quase queda na floresta?"

# game/scripts/c14/c14.rpy:2495
translate brazilian c14s005_BallGame_59864e6c:

    # "Debbie pilla todas las pelotas sin esfuerzo, al igual que, sorprendentemente, Kate."
    "Debbie apanha todas as bolas sem esforço, assim como, surpreendentemente, Kate."

# game/scripts/c14/c14.rpy:2496
translate brazilian c14s005_BallGame_6aceb54a:

    # "Después de unas cuantas preguntas y retos inocentes la cosa se va caldeando poco a poco."
    "Após algumas perguntas e desafios inocentes, a situação vai esquentando aos poucos."

# game/scripts/c14/c14.rpy:2497
translate brazilian c14s005_BallGame_b490320c:

    # "Las chicas son cruéles y le pasan la pelota cada vez más a Kim."
    "As meninas são cruéis e ficam passando a bola para a Kim."

# game/scripts/c14/c14.rpy:2499
translate brazilian c14s005_BallGame_d9567729:

    # "No tarda mucho en que a Kim se le escape una pelota que le pasa [dap]."
    "Não demora muito para Kim deixar cair uma bola que lhe é passada [dap]."

# game/scripts/c14/c14.rpy:2501
translate brazilian c14s005_BallGame_18bfc607:

    # dap "¿Verdad o reto, Kim?"
    dap "Verdade ou desafio, Kim?"

# game/scripts/c14/c14.rpy:2503
translate brazilian c14s005_BallGame_534e446c:

    # kim "¡Verdad!"
    kim "VERDADEIRO!"

# game/scripts/c14/c14.rpy:2505
translate brazilian c14s005_BallGame_ab42b5be:

    # dap "¿Tienes novio?"
    dap "Você tem namorado?"

# game/scripts/c14/c14.rpy:2507
translate brazilian c14s005_BallGame_e158fa0d:

    # dap "Y si tienes más de uno, ¿cuantos?"
    dap "E se você tiver mais de um, quantos?"

# game/scripts/c14/c14.rpy:2509
translate brazilian c14s005_BallGame_19cda5e5:

    # kim "No... Pasa la pregunta a [mc], ¿no?"
    kim "Não... Mova a pergunta para [mc], certo?"

# game/scripts/c14/c14.rpy:2510
translate brazilian c14s005_BallGame_068d7771:

    # mc "Yo tampoco tengo novio. Pasa la pregunta a Debbie"
    mc "Eu também não tenho namorado. Passe a pergunta para a Debbie."

# game/scripts/c14/c14.rpy:2514
translate brazilian c14s005_BallGame_5ec06b69:

    # dap "¡Hey! En tu caso deberías decir si tienes novia... o novias... y cuantas si hay más de una..."
    dap "Ei! No seu caso, você deveria dizer se tem namorada... ou namoradas... e quantas, se for mais de uma..."

# game/scripts/c14/c14.rpy:2516
translate brazilian c14s005_BallGame_75e40b51:

    # dap "Me refería a si tenías novia."
    dap "Eu quis dizer, você tinha namorada?"

# game/scripts/c14/c14.rpy:2517
translate brazilian c14s005_BallGame_4f09cf95:

    # mc "No es lo que has preguntado, [dap]. Para la siguiente, si quieres desperdiciar una pregunta en eso, sabes que la tienes que formular de otra forma. *Risa*"
    mc "Não foi isso que você perguntou, [dap]. Da próxima vez, se quiser desperdiçar uma pergunta com isso, saiba que precisa reformulá-la. *Risos*"

# game/scripts/c14/c14.rpy:2519
translate brazilian c14s005_BallGame_400d6116:

    # dap "*Gruñido* Vale... ¿Debbie?"
    dap "*Grunhido* Ok... Debbie?"

# game/scripts/c14/c14.rpy:2521
translate brazilian c14s005_BallGame_d91c927c:

    # deb "No, yo tampoco tengo novio. ¿Kate?"
    deb "Não, eu também não tenho namorado. Kate?"

# game/scripts/c14/c14.rpy:2523
translate brazilian c14s005_BallGame_c8485bcc:

    # kat "No, y antes de que lo preguntéis, nunca he tenido. Tampoco novia ahora mismo. Saca Kim."
    kat "Não, e antes que você pergunte, eu nunca tive uma. Nem namorada no momento. Mencione a Kim."

# game/scripts/c14/c14.rpy:2525
translate brazilian c14s005_BallGame_e3b93b3a:

    # "Saca Kim y vuelve a hacerse la ronda de pases."
    "Kim pega a bola e a sequência de passes se repete."

# game/scripts/c14/c14.rpy:2527
translate brazilian c14s005_BallGame_631049be:

    # "Pese a la insistencia de las chicas en pasárle la pelota a Kim, esta vez Kate consigue que [dap] falle."
    "Apesar da insistência das meninas em passar a bola para Kim, desta vez Kate consegue fazer com que ela erre o alvo."

# game/scripts/c14/c14.rpy:2529
translate brazilian c14s005_BallGame_41dc3d94:

    # kat "¿Verdad o reto, [dap]?"
    kat "Verdade ou desafio, [dap]?"

# game/scripts/c14/c14.rpy:2531
translate brazilian c14s005_BallGame_605c9de4:

    # dap "¡Verdad!"
    dap "VERDADEIRO!"

# game/scripts/c14/c14.rpy:2533
translate brazilian c14s005_BallGame_c93e5c5f:

    # kat "¿Eres virgen?"
    kat "Você é virgem?"

# game/scripts/c14/c14.rpy:2534
translate brazilian c14s005_BallGame_9f1ce8de:

    # mc "Kate..."
    mc "Kate..."

# game/scripts/c14/c14.rpy:2536
translate brazilian c14s005_BallGame_c0d2ec43:

    # dap "No pasa nada, [mc]. Sí, lo soy. ¿Scarlett?"
    dap "Está tudo bem, [mc]. Sim, estou. Scarlett?"

# game/scripts/c14/c14.rpy:2539
translate brazilian c14s005_BallGame_2ecc6eb1:

    # sca "Nope. ¿Kim?"
    sca "Não. Kim?"

# game/scripts/c14/c14.rpy:2541
translate brazilian c14s005_BallGame_6fc8e629:

    # sca "Yo también. ¿Kim?"
    sca "Eu também. Kim?"

# game/scripts/c14/c14.rpy:2543
translate brazilian c14s005_BallGame_73032189:

    # kim "Más que la Virgen María. ¿[mc]?"
    kim "Mais do que a Virgem Maria. [mc]?"

# game/scripts/c14/c14.rpy:2544
translate brazilian c14s005_BallGame_d8cc5389:

    # mc "Yo no. ¿Debbie?"
    mc "Eu não. Debbie?"

# game/scripts/c14/c14.rpy:2546
translate brazilian c14s005_BallGame_fd003e36:

    # deb "Yo también lo soy. Saca [dap]."
    deb "Eu também. Retire [dap]."

# game/scripts/c14/c14.rpy:2548
translate brazilian c14s005_BallGame_07caf196:

