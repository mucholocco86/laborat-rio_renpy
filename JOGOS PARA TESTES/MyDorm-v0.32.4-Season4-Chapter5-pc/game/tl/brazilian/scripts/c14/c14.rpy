# game/scripts/c14/c14.rpy:493
translate brazilian c14s001_ContinuationSam_c324880f:

    # mc "¿Y quién sería esa persona adecuada, [sim]? Y no digas ninguna actriz famosa a quien no conocemos."
    mc "E quem seria essa pessoa adequada, [sim]? E não mencione nenhuma atriz famosa que não conhecemos."

# game/scripts/c14/c14.rpy:495
translate brazilian c14s001_ContinuationSam_aeb4f14e:

    # sim "{i}(¡Mielda! ¡Piensa, [sim]! Alguien con quién él nunca tendría sexo...){/i}"
