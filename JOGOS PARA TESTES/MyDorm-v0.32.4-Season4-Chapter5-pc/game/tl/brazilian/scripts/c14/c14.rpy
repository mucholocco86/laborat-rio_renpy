# game/scripts/c14/c14.rpy:533
translate brazilian c14s001_ContinuationSam_06833430:

    # sim "Lleva una semana cantando mientras cocina. Canta fatal, pero canta. Y haciendo cuentas, empezó a hacerlo cuando... empezasteis lo vuestro..."
    sim "Ela está cantando enquanto cozinha há uma semana. Ela canta muito mal, mas canta. E, fazendo as contas, ela começou a fazer isso quando... vocês dois começaram a namorar..."

# game/scripts/c14/c14.rpy:534
translate brazilian c14s001_ContinuationSam_faa4a11d:

