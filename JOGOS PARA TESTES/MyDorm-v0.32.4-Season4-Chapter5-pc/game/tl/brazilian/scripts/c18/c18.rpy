# game/scripts/c18/c18.rpy:1296
translate brazilian c18s001_Amanda_360abff9:

    # mc "*Risa* Voy a empezar a recortar el tiempo que pasas con ellas, si empezáis a tener secretos."
    mc "*Risos* Vou começar a diminuir o tempo que você passa com eles se você começar a guardar segredos."

# game/scripts/c18/c18.rpy:1298
translate brazilian c18s001_Amanda_1acf09ab:

    # ama "Atrévete si no valoras tu vida. Y no es que vayamos a matarte ni Eva ni yo, sino ellas. *Risa*"
    ama "Se você não dá valor à sua vida, vá em frente. E não é como se eu ou a Eva fôssemos te matar, são eles. *Risos*"

# game/scripts/c18/c18.rpy:1299
translate brazilian c18s001_Amanda_684f7eb4:

    # mc "Me lo creo. Ahora que os habéis encontrado os vais a hacer inseparables."
    mc "Eu acredito nisso. Agora que vocês se encontraram, serão inseparáveis."

# game/scripts/c18/c18.rpy:1300
translate brazilian c18s001_Amanda_d7a83adb:

