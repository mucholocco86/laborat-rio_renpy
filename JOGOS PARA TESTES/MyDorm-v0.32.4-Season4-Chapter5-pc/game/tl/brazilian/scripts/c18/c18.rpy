    # lis "No te preocupes, me apetece."
    lis "Não se preocupe, eu estou com vontade."

# game/scripts/c18/c18.rpy:1424
translate brazilian c18s001_Lisa_91b5562f:

    # lis "{i}(Además estás con Debbie. Quizás sea buen momento para conocerte mejor.){/i}"
    lis "(Além disso, você está com a Debbie. Talvez seja uma boa hora para vocês se conhecerem melhor.)"

# game/scripts/c18/c18.rpy:1426
translate brazilian c18s001_Lisa_583254e8:

    # lis "No soy muy buena bailarina. Me vas a tener que llevar tú."
    lis "Eu não sou uma dançarina muito boa. Você vai ter que me levar."

# game/scripts/c18/c18.rpy:1427
translate brazilian c18s001_Lisa_a7aa7709:

    # mc "*Risa* Si le preguntas a [emm], descubrirás que yo tampoco lo soy."
    mc "*Risos* Se você perguntar para [emm], vai descobrir que eu também não sou."

# game/scripts/c18/c18.rpy:1428
translate brazilian c18s001_Lisa_cdc622c7:

    # mc "Pero me extraña tanto que chicas de clase alta no hayáis tomado clases de baile. Es lo que se ve en las películas. Danza, piano, y cosas por el estilo."
    mc "Mas fico surpresa que as moças da alta sociedade não façam aulas de dança. É isso que a gente vê nos filmes: dança, piano e coisas do tipo."

# game/scripts/c18/c18.rpy:1430
translate brazilian c18s001_Lisa_b5221f89:

    # mc "Debbie también me ha dicho que era mala bailarina, aunque no me ha pisado ni una vez. *Risa*"
    mc "Debbie também me disse que eu dançava mal, embora ela nunca tenha pisado no meu pé. *Risos*"

# game/scripts/c18/c18.rpy:1432
translate brazilian c18s001_Lisa_7b5b9ebe:

    # lis "¿Eh? No os he visto bailar... Me extraña tanto que mi hermana baile con un chico... Me hubiera gustado verlo."
    lis "Hã? Eu não vi você dançando... Fiquei tão surpresa que minha irmã dançou com um rapaz... Eu gostaria de ter visto."

# game/scripts/c18/c18.rpy:1433
translate brazilian c18s001_Lisa_909eac03:

    # mc "Nos hemos cruzado en el guardarropía y hemos bailado allí."
    mc "Nos encontramos no vestiário e dançamos lá."

# game/scripts/c18/c18.rpy:1434
translate brazilian c18s001_Lisa_7ad9dbc1:

    # lis "Ah, OK. Un baile privado. Que romántico..."
    lis "Ah, ok. Uma dança particular. Que romântico..."

# game/scripts/c18/c18.rpy:1436
translate brazilian c18s001_Lisa_214b9b1b:

    # lis "Sobre las clases de baile... Ni Debbie ni yo estábamos interesadas. Mis padres lo intentaron, pero nosotras nos negamos."
    lis "Em relação às aulas de dança... Nem eu nem a Debbie estávamos interessadas. Meus pais tentaram, mas nós recusamos."

# game/scripts/c18/c18.rpy:1437
translate brazilian c18s001_Lisa_ddafb0d3:

    # lis "Yo por rebeldía tonta y Debbie porque nunca estuvo interesada. Siempre le interesaron más otras actividades."
    lis "Eu saí por rebeldia boba, e Debbie saiu porque nunca teve interesse. Ela sempre se interessou mais por outras atividades."

# game/scripts/c18/c18.rpy:1438
translate brazilian c18s001_Lisa_557bdbe7:

    # mc "Lo de la rebeldía te pega. *Risa* Y a Debbie lo de estar interesada en los deportes en vez de en la danza."
    mc "Esse seu lado rebelde combina com você. *Risos* E o interesse da Debbie por esportes em vez de dança."

# game/scripts/c18/c18.rpy:1440
translate brazilian c18s001_Lisa_7b1be3a0:

    # lis "*Risa* Sí, la verdad es que no quería ser un cliché de chica de clase alta y acabé siéndolo."
    lis "*Risos* Sim, a verdade é que eu não queria ser uma patricinha clichê, mas acabei sendo uma."

# game/scripts/c18/c18.rpy:1441
translate brazilian c18s001_Lisa_49779e7e:

    # lis "La chica blanca rica que va a manifestaciones de pro veganas y a protestas climáticas."
    lis "A garota branca rica que frequenta manifestações pró-veganismo e protestos climáticos."

# game/scripts/c18/c18.rpy:1442
translate brazilian c18s001_Lisa_6a0756a0:

    # mc "Bueno, me parecen buenas causas."
    mc "Bem, eu acho que são boas causas."

# game/scripts/c18/c18.rpy:1444
translate brazilian c18s001_Lisa_5459d6e9:

    # lis "Lo son. Pero, en la mayoría de los casos, sirven de muy poco y sólo a nivel local. Alguien debería hacer algo en las esferas políticas."
    lis "Sim, existem. Mas, na maioria dos casos, são de pouca utilidade e só eficazes em nível local. Alguém deveria fazer algo na esfera política."

# game/scripts/c18/c18.rpy:1445
translate brazilian c18s001_Lisa_9c56984a:

    # mc "El problema es encontrar a ese alguien, ¿no? La clase política suele tener demasiados intereses cruzados y estar atada a demasiados lobbies."
    mc "O problema é encontrar essa pessoa, não é? A classe política geralmente tem muitos interesses conflitantes e está ligada a muitos grupos de pressão."

# game/scripts/c18/c18.rpy:1447
translate brazilian c18s001_Lisa_06944f43:

    # lis "Sí, y la mayoría de gente concienciada también está muy politizada. El establishment los tacha de comunistas, con lo que es difícil que alguna vez tengan poder."
    lis "Sim, e a maioria das pessoas politicamente conscientes também são muito politizadas. O establishment as rotula de comunistas, então é improvável que elas cheguem ao poder algum dia."

# game/scripts/c18/c18.rpy:1448
translate brazilian c18s001_Lisa_4f27d2d4:

    # mc "Y los que no estáis politizados, la base de esos movimientos, no estáis interesados en entrar en política. Tú estudias Arte, por ejemplo."
    mc "E aqueles de vocês que não são politicamente ativos, a base desses movimentos, não estão interessados em entrar na política. Vocês estudam arte, por exemplo."

# game/scripts/c18/c18.rpy:1450
translate brazilian c18s001_Lisa_f800ee59:

    # lis "*Risa* ¿Me ves como alcaldesa de un pueblo? No es algo para mí."
    lis "*Risos* Você me vê como prefeito de uma cidade? Isso não é para mim."

# game/scripts/c18/c18.rpy:1451
translate brazilian c18s001_Lisa_213b30da:

    # mc "¿Por qué no? ¿Demasiadas responsabilidades? Al menos nadie te podría tachar de comunista."
    mc "Por que não? Muitas responsabilidades? Pelo menos ninguém poderia te acusar de ser comunista."

# game/scripts/c18/c18.rpy:1461
translate brazilian c18s001_Lisa_0692a1e1:

    # mc "Dependiendo de tu programa, obviamente. Sé que, al menos, serías honesta."
    mc "Dependendo do seu programa, obviamente. Sei que, pelo menos, você seria honesto."

# game/scripts/c18/c18.rpy:1463
translate brazilian c18s001_Lisa_260b12e0:

    # lis "¡Wow! Eso no me lo esperaba."
    lis "Uau! Eu não esperava por isso."

# game/scripts/c18/c18.rpy:1464
translate brazilian c18s001_Lisa_ae28686e:

    # mc "¿Por qué no? Ahora que te conozco mejor, creo que podrías hacer un buen trabajo como alcaldesa de donde sea."
    mc "Por que não? Agora que te conheço melhor, acho que você faria um ótimo trabalho como prefeito(a) de qualquer lugar."

# game/scripts/c18/c18.rpy:1466
translate brazilian c18s001_Lisa_21301555:

    # lis "No es eso. No me veo ejerciendo la política. ¿Crees que alguien me votaría?"
    lis "Não é isso. Não me vejo entrando para a política. Você acha que alguém votaria em mim?"

# game/scripts/c18/c18.rpy:1468
translate brazilian c18s001_Lisa_754ea9de:

    # mc "No hubiera votado por la Lisa que conocí en el aeropuerto. Pero sí por la que está bailando conmigo ahora mismo."
    mc "Eu não teria votado na Lisa que conheci no aeroporto. Mas teria votado na Lisa que está dançando comigo agora."

# game/scripts/c18/c18.rpy:1470
translate brazilian c18s001_Lisa_763c6fa5:

    # lis "Me comporté como una imbécil, ¿verdad?"
    lis "Eu me comportei como um idiota, não é?"

# game/scripts/c18/c18.rpy:1471
translate brazilian c18s001_Lisa_2854b7e8:

    # mc "Yo no diría eso, pero no fue demasiado agradable conocerte aquel día."
    mc "Eu não diria isso, mas não foi muito agradável te conhecer naquele dia."

# game/scripts/c18/c18.rpy:1472
translate brazilian c18s001_Lisa_e92b2438:

    # lis "Lo siento..."
    lis "Desculpe..."

# game/scripts/c18/c18.rpy:1473
translate brazilian c18s001_Lisa_18193b19:

    # mc "Un mal día lo tiene cualquiera. Nos has demostrado a todos que aquella Lisa no eras tú."
    mc "Todo mundo tem um dia ruim de vez em quando. Você nos mostrou que aquela Lisa não era você."

# game/scripts/c18/c18.rpy:1474
translate brazilian c18s001_Lisa_be61b8d6:

    # mc "Si dejas que la gente te conozca, ¿por qué no te van a votar?"
    mc "Se você deixar as pessoas te conhecerem, por que elas não votariam em você?"

# game/scripts/c18/c18.rpy:1476
translate brazilian c18s001_Lisa_16a151df:

    # lis "Se necesitan muchas cosas que no tengo. Carisma, contactos, pertenecer a un partido... Además, como has dicho, estudio Arte. No una carrera que tenga que ver con la política."
    lis "Há muitas coisas de que você precisa e que eu não tenho. Carisma, contatos, filiação a um partido político... Além disso, como você disse, eu estudo Arte. Não uma graduação relacionada à política."

# game/scripts/c18/c18.rpy:1477
translate brazilian c18s001_Lisa_eeedd398:

    # mc "Tuvimos a Arnold como gobernador aquí. *Risa* No estoy seguro de que estudiara algo relacionado con la política."
    mc "Tivemos Arnold como governador aqui. *Risos* Não tenho certeza se ele estudou alguma coisa relacionada à política."

# game/scripts/c18/c18.rpy:1479
translate brazilian c18s001_Lisa_949c3047:

    # lis "*Risa* Es verdad, los californianos sois raros. Elegís a un actor como gobernador."
    lis "*Risos* É verdade, vocês californianos são estranhos. Elegem um ator como governador."

# game/scripts/c18/c18.rpy:1480
translate brazilian c18s001_Lisa_1e9b5f62:

    # mc "*Risa* Los americanos somos raros. Elegimos a un actor como presidente... *Risa* Un actor que antes fue gobernador de California."
    mc "*Risos* Nós, americanos, somos estranhos. Elegemos um ator como presidente... *Risos* Um ator que já foi governador da Califórnia."

# game/scripts/c18/c18.rpy:1481
translate brazilian c18s001_Lisa_918bef6f:

    # lis "*Risa* Es verdad. Al menos él ganó la Guerra Fría. ¿Qué hizo Arnold?"
    lis "*Risos* É verdade. Pelo menos ele venceu a Guerra Fria. O que Arnold fez?"

# game/scripts/c18/c18.rpy:1482
translate brazilian c18s001_Lisa_dc7175bc:

    # mc "Permitirte beber alcohol esta noche. *Risa*"
    mc "Permita-se beber álcool esta noite. *Risos*"

# game/scripts/c18/c18.rpy:1483
translate brazilian c18s001_Lisa_3382fe0e:

    # lis "*Risa* Punto para Arnold."
    lis "*Risos* Ponto para Arnold."

# game/scripts/c18/c18.rpy:1486
translate brazilian c18s001_Lisa_236c7e34:

    # lis "Sé que esto va a sonarte raro, pero ¿podemos hablar de Debbie?"
    lis "Eu sei que isso vai soar estranho, mas podemos falar sobre a Debbie?"

# game/scripts/c18/c18.rpy:1487
translate brazilian c18s001_Lisa_81e2e7ad:

    # mc "Lo que quieras. Es tu hermana y tienes todo el derecho a hablar de ella."
    mc "Faça o que quiser. Ela é sua irmã e você tem todo o direito de falar sobre ela."

# game/scripts/c18/c18.rpy:1489
translate brazilian c18s001_Lisa_6b37feed:

    # lis "Me preocupa cómo se siente. Cómo la haces sentir."
    lis "Estou preocupado com o que ela sente. Com o que você a faz sentir."

# game/scripts/c18/c18.rpy:1490
translate brazilian c18s001_Lisa_d13e97a4:

    # mc "Ya te dije que no tengo intención de hacerle daño."
    mc "Eu já lhe disse que não tenho intenção alguma de magoá-lo."

# game/scripts/c18/c18.rpy:1492
translate brazilian c18s001_Lisa_61450eff:

    # lis "Lo sé. Pero ayer, mientras me explicaba lo del lago... Nunca la había visto... la palabra que me viene a la cabeza es \"brillar\"... tanto como anoche."
    lis "Eu sei. Mas ontem, enquanto ela me explicava sobre o lago... eu nunca o tinha visto antes... a palavra que me vem à mente é \"brilho\"... tanto quanto ontem à noite."

# game/scripts/c18/c18.rpy:1493
translate brazilian c18s001_Lisa_e5462fe1:

    # lis "Está muy ilusionada. Yo estoy muy contenta por ella, pero..."
    lis "Ela está muito animada. Estou muito feliz por ela, mas..."

# game/scripts/c18/c18.rpy:1494
translate brazilian c18s001_Lisa_3a0ccfb7:

    # mc "Y te preocupa que acabe desilusionándola."
    mc "E você tem medo de que isso acabe decepcionando-a."

# game/scripts/c18/c18.rpy:1497
translate brazilian c18s001_Lisa_1138990b:

    # lis "Me ha dicho que estás saliendo con más chicas aparte de ella. Eso de por sí me desconcertó. Que lo hagas y que ella lo acepte me desconcierta aún más."
    lis "Ela me disse que você está saindo com outras garotas além dela. Só isso já me deixou confusa. O fato de você estar fazendo isso e ela estar de acordo me deixa ainda mais confusa."

# game/scripts/c18/c18.rpy:1498
translate brazilian c18s001_Lisa_b04b9f66:

    # mc "Sí, estoy saliendo con más chicas. Pero no engaño a nadie. Para mí, cada una de ellas es igual de importante."
    mc "Sim, estou saindo com mais garotas. Mas não estou traindo ninguém. Para mim, todas são igualmente importantes."

# game/scripts/c18/c18.rpy:1500
translate brazilian c18s001_Lisa_04b2decd:

    # lis "Me preocupa que puedas acabar haciéndole daño sin querer. Sé que no vas a hacerlo a propósito."
    lis "Tenho receio de que você possa machucá-lo sem querer. Sei que você não faria isso de propósito."

# game/scripts/c18/c18.rpy:1501
translate brazilian c18s001_Lisa_493919a2:

    # mc "Te prometo que voy a ir con todo el cuidado posible para evitar que eso pase."
    mc "Prometo que serei o mais cuidadoso possível para evitar que isso aconteça."

# game/scripts/c18/c18.rpy:1502
translate brazilian c18s001_Lisa_3e206ce6:

    # mc "Debbie es muy especial y la voy a tratar como se merece."
    mc "Debbie é muito especial e vou tratá-la como ela merece."

# game/scripts/c18/c18.rpy:1505
translate brazilian c18s001_Lisa_fe0ef7cc:

    # lis "¿Puedo preguntar cómo funciona eso de salir con más de una chica?"
    lis "Posso perguntar como funciona namorar mais de uma garota?"

# game/scripts/c18/c18.rpy:1506
translate brazilian c18s001_Lisa_4ecac2b6:

    # mc "Es muy fácil. Yo soy capaz de amar a diversas chicas a la vez. Pero cuando estoy con cualquiera de ellas, el resto no existe."
    mc "É muito simples. Sou capaz de amar várias garotas ao mesmo tempo. Mas quando estou com uma delas, as outras deixam de existir."

# game/scripts/c18/c18.rpy:1507
translate brazilian c18s001_Lisa_ae0e301e:

    # mc "Cuando estaba con tu hermana en guardarropía, no importaba si salía con alguna de las chicas que había aquí fuera, en casa, o en cualquier otro lado."
    mc "Quando eu estava com sua irmã no vestiário, não importava se eu estava namorando alguma das garotas daqui, de casa ou de qualquer outro lugar."

# game/scripts/c18/c18.rpy:1509
translate brazilian c18s001_Lisa_ec3019a0:

    # lis "*Risa* Lo has dicho de una forma en que es imposible saber con quién más sales."
    lis "*Risos* Você disse isso de um jeito que torna impossível saber com quem mais você está saindo."

# game/scripts/c18/c18.rpy:1510
translate brazilian c18s001_Lisa_e9242c3f:

    # mc "Cumplir con sus deseos es una forma de cuidarlas, Lisa."
    mc "Satisfazer os desejos deles é uma forma de cuidar deles, Lisa."

# game/scripts/c18/c18.rpy:1511
translate brazilian c18s001_Lisa_4f04432e:

    # mc "Y ahora mismo, ninguna, incluyendo a Debbie, quiere hacer público lo nuestro."
    mc "E neste momento, nenhum deles, incluindo Debbie, quer tornar nosso relacionamento público."

# game/scripts/c18/c18.rpy:1512
translate brazilian c18s001_Lisa_df133572:

    # mc "Pero, sin querer molestarte, creo que tu pregunta va más allá... como si hubiera una cuestión personal tuya."
    mc "Mas, sem querer ofender, acho que sua pergunta vai além... como se houvesse um problema pessoal seu."

# game/scripts/c18/c18.rpy:1515
translate brazilian c18s001_Lisa_cf614b5d:

    # lis "¿Puedo preguntar si eres totalmente monógamo? Después de haber oído sobre tu relación con Saira..."
    lis "Posso perguntar se você é completamente monogâmico? Depois de ouvir sobre seu relacionamento com Saira..."

# game/scripts/c18/c18.rpy:1516
translate brazilian c18s001_Lisa_5125e112:

    # mc "Por el momento lo soy. Estoy con Debbie y con nadie más. Pero no le hemos puesto ninguna etiqueta todavía."
    mc "Por enquanto, sim. Estou com a Debbie e mais ninguém. Mas ainda não definimos nada em nosso relacionamento."

# game/scripts/c18/c18.rpy:1517
translate brazilian c18s001_Lisa_503485a3:

    # mc "Si me enamorara de otra persona, y esa persona quisiera estar conmigo, tendría que hablarlo con Debbie a ver cómo lo resolvemos."
    mc "Se eu me apaixonasse por outra pessoa, e essa pessoa quisesse ficar comigo, eu teria que conversar com a Debbie sobre isso e ver como poderíamos resolver a situação."

# game/scripts/c18/c18.rpy:1519
translate brazilian c18s001_Lisa_dc57d66c:

    # lis "*Risa* Las famosas charlas de [mc], quien todo lo resuelve hablando."
    lis "*Risos* As famosas conversas de [mc], que resolve tudo conversando."

# game/scripts/c18/c18.rpy:1520
translate brazilian c18s001_Lisa_9f980c2f:

    # mc "Creo que hablar las cosas es la mejor forma de no hacer daño a nadie."
    mc "Acredito que conversar sobre as coisas é a melhor maneira de evitar magoar alguém."

# game/scripts/c18/c18.rpy:1521
translate brazilian c18s001_Lisa_bd7be2d1:

    # mc "Pero, sin querer molestarte, lo preguntas como si quisieras que no fuera monógamo... por una cuestión tuya personal."
    mc "Mas, sem querer te chatear, você pergunta como se desejasse que ele não fosse monogâmico... por um motivo pessoal seu."

# game/scripts/c18/c18.rpy:1522
translate brazilian c18s001_Lisa_0fde96b3:

    # mcp "(La conversación con Betty me está haciendo ver fantasmas donde quizás no los haya.)"
    mcp "(A conversa com Betty está me fazendo ver fantasmas onde talvez não existam.)"

# game/scripts/c18/c18.rpy:1524
translate brazilian c18s001_Lisa_c10d232a:

    # lis "¿Qué? ¡No! Sales con mi hermana... No podría salir contigo."
    lis "O quê? Não! Você está namorando a minha irmã... Eu não poderia namorar você."

# game/scripts/c18/c18.rpy:1525
translate brazilian c18s001_Lisa_1a14bbca:

    # mc "Nadie ha dicho nada de salir juntos tú y yo, pero..."
    mc "Ninguém comentou nada sobre nós dois sairmos juntos, mas..."

# game/scripts/c18/c18.rpy:1526
translate brazilian c18s001_Lisa_3ae0e593:

    # mc "¿Me estás diciendo que si no saliera con Debbie te lo plantearías?"
    mc "Você está me dizendo que se eu não estivesse namorando a Debbie, você reconsideraria?"

# game/scripts/c18/c18.rpy:1528
translate brazilian c18s001_Lisa_9efbf727:

    # lis "Eso es algo que nunca sabremos, ¿no?"
    lis "Isso é algo que nunca saberemos, certo?"

# game/scripts/c18/c18.rpy:1531
translate brazilian c18s001_Lisa_83575dba:

    # kim "Lisa, tu móvil está sonando. Es Anthony."
    kim "Lisa, seu telefone está tocando. É o Anthony."

# game/scripts/c18/c18.rpy:1533
translate brazilian c18s001_Lisa_56122fef:

    # lis "Tengo que cogerlo, [mc]. Seguimos hablando luego."
    lis "Preciso pegar, [mc]. Falamos mais tarde."

# game/scripts/c18/c18.rpy:1534
translate brazilian c18s001_Lisa_c7ee6dc6:

    # mc "OK. ¿Podéis decirle a quién le toque ahora que voy a por un zumo a la barra? Vuelvo en un momento."
    mc "Certo. Pode avisar a quem for atender agora que vou pegar um suco no bar? Já volto."

# game/scripts/c18/c18.rpy:1535
translate brazilian c18s001_Lisa_f2589d54:

    # lis "Le toca a [dap], pero no la veo por aquí. Estará en el lavabo. Pero ve, nosotras la avisamos."
    lis "É a vez da [dap], mas não a vejo por perto. Ela provavelmente está no banheiro. Mas pode falar, nós avisaremos a ela."

# game/scripts/c18/c18.rpy:1579
translate brazilian c18s001_Daphne_b010d53c:

    # "Al volver con el zumo descubres que Anthony se ha unido a la fiesta y Lisa se lo está presentando al resto de chicas."
    "Ao retornar com o suco, você descobre que Anthony se juntou à festa e Lisa está apresentando-o às outras garotas."

# game/scripts/c18/c18.rpy:1585
translate brazilian c18s001_Daphne_cd12b144:

    # dap "Me han dicho que has desaparecido en el turno de Lisa. Voy a avisarla."
    dap "Me disseram que você desapareceu durante o turno da Lisa. Vou avisá-la."

# game/scripts/c18/c18.rpy:1586
translate brazilian c18s001_Daphne_7e8e3321:

    # mc "Mejor no. Está presentando a Anthony al resto de chicas. ¿A quién le toca ahora?"
    mc "É melhor não. Ela está apresentando o Anthony às outras garotas. De quem é a vez agora?"

# game/scripts/c18/c18.rpy:1587
translate brazilian c18s001_Daphne_a258ee24:

    # dap "A mí."
    dap "Meu."

# game/scripts/c18/c18.rpy:1589
translate brazilian c18s001_Daphne_3e3645fd:

    # dap "Es mi turno ahora, si no estás demasiado cansado."
    dap "Agora é a minha vez, se você não estiver muito cansado."

# game/scripts/c18/c18.rpy:1590
translate brazilian c18s001_Daphne_4f29a179:

    # mc "Para ti nunca lo estoy."
    mc "Eu nunca estou lá para você."

# game/scripts/c18/c18.rpy:1592
translate brazilian c18s001_Daphne_38877ed9:

    # mc "¿Qué tal te lo estás pasando en tu fiesta de cumpleaños?"
    mc "Como você está aproveitando sua festa de aniversário?"

# game/scripts/c18/c18.rpy:1593
translate brazilian c18s001_Daphne_49bb4323:

    # dap "Genial, pero la fiesta es mañana. Falta demasiada gente hoy y no me parece una fiesta de verdad."
    dap "Ótimo, mas a festa é amanhã. Muita gente está faltando hoje, e não parece uma festa de verdade."

# game/scripts/c18/c18.rpy:1594
translate brazilian c18s001_Daphne_6e1a4b42:

    # mc "*Risa* Somos trece. Si cuentas a Anthony, catorce. La última vez que salimos éramos cinco."
    mc "*Risos* Somos treze. Se contarmos com o Anthony, quatorze. Da última vez que saímos, éramos cinco."

# game/scripts/c18/c18.rpy:1596
translate brazilian c18s001_Daphne_27d5fb13:

    # dap "¡Las cosas han cambiado mucho en dos semanas! Y después de mañana... creo que nunca más sentiremos que una fiesta está completa a menos que estemos todas las chicas."
    dap "Muita coisa mudou em duas semanas! E depois de amanhã... acho que nunca mais vamos sentir que uma festa está completa a menos que todas as meninas estejam lá."

# game/scripts/c18/c18.rpy:1597
translate brazilian c18s001_Daphne_023d41a0:

    # mc "¿Las chicas? ¿Eso me deja fuera? *Risa*"
    mc "As garotas? Isso me exclui? *Risos*"

# game/scripts/c18/c18.rpy:1599
translate brazilian c18s001_Daphne_60dfb32c:

    # dap "Nunca te dejaría fuera. *Risa* Pero tú siempre estás para nosotras. No sé cómo puedes con todo."
    dap "Eu jamais te deixaria de fora. *Risos* Mas você está sempre presente para nós. Não sei como você consegue dar conta de tudo."

# game/scripts/c18/c18.rpy:1600
translate brazilian c18s001_Daphne_6fb03db4:

    # mc "Dividiendo el tiempo en pequeñas porciones. *Risa*"
    mc "Dividir o tempo em pequenas porções. *Risos*"

# game/scripts/c18/c18.rpy:1601
translate brazilian c18s001_Daphne_89353138:

    # mc "Con esa app que habéis hecho Scarlett y tú puede ser más fácil."
    mc "Com esse aplicativo que você e a Scarlett criaram, pode ficar mais fácil."

# game/scripts/c18/c18.rpy:1604
translate brazilian c18s001_Daphne_d2e70ab9:

    # dap "La hicimos para dividirnos tu tiempo entre nosotras de tal forma que nunca discutiéramos. Solo ha habido que adaptarla."
    dap "Fizemos um acordo para dividir nosso tempo de forma que nunca discutíssemos. Só tivemos que nos adaptar."

# game/scripts/c18/c18.rpy:1608
translate brazilian c18s001_Daphne_c06f43b1:

    # dap "La hicimos para que pudieras dividir tu tiempo entre el harén sin que nadie discutiera. Solo ha habido que adaptarla."
    dap "Nós o projetamos para que você pudesse dividir seu tempo entre o harém sem que ninguém discutisse. Só precisava de alguns ajustes."

# game/scripts/c18/c18.rpy:1614
translate brazilian c18s001_Daphne_0a1ebcec:

    # mc "Ha sido una buena idea."
    mc "Foi uma boa ideia."

# game/scripts/c18/c18.rpy:1616
translate brazilian c18s001_Daphne_47281d94:

    # mc "Sobre el elefante en la habitación..."
    mc "Sobre o elefante na sala..."

# game/scripts/c18/c18.rpy:1618
translate brazilian c18s001_Daphne_798aa071:

    # dap "¿Debbie? No pasa nada. Me alegro mucho por vosotros. Es una chica genial."
    dap "Debbie? Está tudo bem. Estou muito feliz por vocês duas. Ela é uma ótima garota."

# game/scripts/c18/c18.rpy:1620
translate brazilian c18s001_Daphne_d18826bf:

    # dap "Hemos estado hablando en el lavabo. Ahora las dos sabemos que estás con la otra y a ninguna nos importa."
    dap "Estávamos conversando no banheiro. Agora nós dois sabemos que você está com a outra mulher, e nenhum de nós importa mais."

# game/scripts/c18/c18.rpy:1622
translate brazilian c18s001_Daphne_cb97d2cf:

    # dap "Se me hace extraño saber de otra chica aparte de Scarlett, pero me alegra poder hablar de ello con Debbie."
    dap "É estranho ouvir falar de outra garota além da Scarlett, mas fico feliz por poder conversar sobre isso com a Debbie."

# game/scripts/c18/c18.rpy:1624
translate brazilian c18s001_Daphne_37a1cab8:

    # dap "Se me hace extraño saber de otra chica del harén, pero me alegra poder hablar de ello con Debbie."
    dap "É estranho ouvir falar de outra garota no harém, mas fico feliz por poder conversar sobre isso com a Debbie."

# game/scripts/c18/c18.rpy:1626
translate brazilian c18s001_Daphne_f348fc9d:

    # dap "Hemos estado hablando en el lavabo. Me ha pedido que guarde el secreto, que solo lo sabemos Lisa y yo."
    dap "Estávamos conversando no banheiro. Ela me pediu para guardar segredo, que só eu e a Lisa soubéssemos."

# game/scripts/c18/c18.rpy:1628
translate brazilian c18s001_Daphne_8219e201:

    # dap "Se me hace extraño saber que estás con otra chica aparte de Scarlett, pero me alegra que sea Debbie."
    dap "É estranho saber que você está com outra garota além da Scarlett, mas fico feliz que seja a Debbie."

# game/scripts/c18/c18.rpy:1629
translate brazilian c18s001_Daphne_299f601d:

    # mc "Gracias por entenderlo. Se ha puesto muy nerviosa por un momento."
    mc "Obrigada pela compreensão. Ela ficou muito nervosa por um instante."

# game/scripts/c18/c18.rpy:1631
translate brazilian c18s001_Daphne_98a1e6e5:

    # dap "¿Alguna chica más de la que tenga que saber? *Risa*"
    dap "Tem mais alguma garota que eu deva conhecer? *Risos*"

# game/scripts/c18/c18.rpy:1632
translate brazilian c18s001_Daphne_5e8a0a54:

    # mc "Todas las chicas tenéis vuestros secretos, y no soy nadie para desvelarlos. *Risa*"
    mc "Todas as garotas têm seus segredos, e eu não sou ninguém para revelá-los. *Risos*"

# game/scripts/c18/c18.rpy:1633
translate brazilian c18s001_Daphne_4d648f2d:

    # dap "Tienes razón. *Risa* Seguramente te mataríamos entre todas si empiezas a hacerlo."
    dap "Você tem razão. *Risos* Provavelmente todos nós te mataríamos se você começasse a fazer isso."

# game/scripts/c18/c18.rpy:1636
translate brazilian c18s001_Daphne_3d4521da:

    # dap "¿Sabes que estoy nerviosa por lo de mañana?"
    dap "Você sabe que estou nervoso(a) em relação a amanhã?"

# game/scripts/c18/c18.rpy:1637
translate brazilian c18s001_Daphne_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "O que você está falando?"

# game/scripts/c18/c18.rpy:1639
translate brazilian c18s001_Daphne_700474e4:

    # dap "A la prueba de embarazo. Si sale positivo, me moriría de ganas por hacerlo público mañana mismo."
    dap "Vou fazer um teste de gravidez. Se der positivo, vou morrer de vontade de contar amanhã."

# game/scripts/c18/c18.rpy:1640
translate brazilian c18s001_Daphne_28244d0a:

    # dap "Y sería injusto para [eri] y [emm]. Voy a tener que guardar el secreto un par de días."
    dap "E seria injusto com [eri] e [emm]. Terei que manter segredo por alguns dias."

# game/scripts/c18/c18.rpy:1641
translate brazilian c18s001_Daphne_80c47845:

    # mc "¿Y si sale negativo? ¿Te fastidiaría el cumpleaños?"
    mc "E se o resultado for negativo? Isso arruinaria seu aniversário?"

# game/scripts/c18/c18.rpy:1643
translate brazilian c18s001_Daphne_6670c182:

    # dap "No, si sale negativo no pasa nada. Nunca pensé que me quedaría embarazada a los 18. Ni siquiera antes de los 25."
    dap "Não, se der negativo, não é nada demais. Nunca pensei que engravidaria aos 18 anos. Nem antes dos 25."

# game/scripts/c18/c18.rpy:1644
translate brazilian c18s001_Daphne_24d10ac0:

    # dap "Quiero tener a Maeve, pero no tengo demasiada prisa. No todas las chicas sueñan con quedarse embarazadas en su primera vez."
    dap "Quero ter a Maeve, mas não tenho muita pressa. Nem toda garota sonha em engravidar na primeira vez."

# game/scripts/c18/c18.rpy:1645
translate brazilian c18s001_Daphne_991bcf0c:

    # mc "Esa debe ser la actitud."
    mc "Essa deveria ser a atitude."

# game/scripts/c18/c18.rpy:1647
translate brazilian c18s001_Daphne_56861b01:

    # dap "¿Quién crees que va a hacer topless mañana?"
    dap "Quem você acha que vai ficar de topless amanhã?"

# game/scripts/c18/c18.rpy:1648
translate brazilian c18s001_Daphne_b73bb878:

    # mc "Estoy casi seguro de que tu madre, [emm], y [eri]. Del resto no tengo ni idea. Quizás Sam y Eileen."
    mc "Tenho quase certeza de que é sua mãe, [emm], e [eri]. Não faço ideia sobre o resto. Talvez Sam e Eileen."

# game/scripts/c18/c18.rpy:1650
translate brazilian c18s001_Daphne_fd7b762c:

    # dap "¿[eri]? Estás loco."
    dap "[eri]? Você está louco."

# game/scripts/c18/c18.rpy:1651
translate brazilian c18s001_Daphne_1d300b52:

    # mc "Ella lo ha pedido para tu madre y va a querer apoyarla. Pero creía que ya se lo habrías preguntado a las chicas. Al menos a las que están aquí."
    mc "Ela pediu isso para sua mãe e vai querer apoiá-la. Mas eu pensei que você já teria perguntado às meninas. Pelo menos às que estão aqui."

# game/scripts/c18/c18.rpy:1653
translate brazilian c18s001_Daphne_fa6af6d1:

    # dap "Nadie se ha atrevido a sacar el tema. Incluso Scarlett ha cambiado de tema cuando he intentado dirigir la conversación hacia mañana."
    dap "Ninguém se atreveu a tocar no assunto. Até a Scarlett mudou de assunto quando tentei direcionar a conversa para amanhã."

# game/scripts/c18/c18.rpy:1654
translate brazilian c18s001_Daphne_6c3f12bb:

    # dap "Creo que la presencia de Jamaal las cohíbe un poco a todas. No lo conocen tanto como nosotros."
    dap "Acho que a presença de Jamaal os deixa um pouco constrangidos. Eles não o conhecem tão bem quanto nós."

# game/scripts/c18/c18.rpy:1655
translate brazilian c18s001_Daphne_80d95190:

    # mc "¿Jamaal? Creo que los únicos pezones que le podrían interesar de los que hay aquí serían los de Anthony y no sé si Anthony estaría interesado. *Risa*"
    mc "Jamaal? Acho que os únicos mamilos que interessariam a ele aqui seriam os do Anthony, e não sei se o Anthony se interessaria. *Risos*"

# game/scripts/c18/c18.rpy:1657
translate brazilian c18s001_Daphne_33a41986:

    # dap "¿Los tuyos no? *Risa*"
    dap "Não é seu? *Risos*"

# game/scripts/c18/c18.rpy:1658
translate brazilian c18s001_Daphne_b26929b6:

    # mc "Jamaal sabe que no me van los tíos igual que yo sé que no le van las chicas. Nunca me vería así. Es como mi hermano."
    mc "Jamaal sabe que eu não gosto de rapazes, assim como eu sei que ele não gosta de garotas. Ele jamais me veria dessa forma. Ele é como um irmão para mim."

# game/scripts/c18/c18.rpy:1661
translate brazilian c18s001_Daphne_b4454935:

    # dap "*Risa* Y yo soy tu prima. Y eso no nos ha importado."
    dap "*Risos* E eu sou seu primo. E nunca nos importamos com isso."

# game/scripts/c18/c18.rpy:1663
translate brazilian c18s001_Daphne_82a3cad3:

    # dap "*Risa* ¿Estás seguro? Piensa que nadie elige de quién se enamora."
    dap "*Risos* Tem certeza? Lembre-se, ninguém escolhe por quem se apaixona."

# game/scripts/c18/c18.rpy:1664
translate brazilian c18s001_Daphne_116fee64:

    # mc "No me refiero a eso, sino a que SOLO me ve como a su hermano, no como un objetivo."
    mc "Não me refiro a isso, mas sim ao fato de que ele me vê APENAS como seu irmão, não como um alvo."

# game/scripts/c18/c18.rpy:1666
translate brazilian c18s001_Daphne_5c637db6:

    # dap "¿Y tú? ¿Estás interesado en algunos pezones?"
    dap "E você? Está interessado em alguns mamilos?"

# game/scripts/c18/c18.rpy:1668
translate brazilian c18s001_Daphne_dff57b21:

    # mc "Principalmente en volver a ver los tuyos. Pero preferentemente en privado."
    mc "Principalmente para rever seus entes queridos. Mas, de preferência, em particular."

# game/scripts/c18/c18.rpy:1670
translate brazilian c18s001_Daphne_0d6962ed:

    # mc "Soy un hombre de 21 años. *Risa* En todos. Es broma."
    mc "Sou um homem de 21 anos. *Risos* Em todas elas. Brincadeira."

# game/scripts/c18/c18.rpy:1671
translate brazilian c18s001_Daphne_b55546d0:

    # dap "*Tsk* Sí, sí. Pero ¿alguna chica en particular mañana? Siempre has tenido un crush con Samantha."
    dap "*Tsk* É, é. Mas alguma garota em particular amanhã? Você sempre teve uma queda pela Samantha."

# game/scripts/c18/c18.rpy:1672
translate brazilian c18s001_Daphne_571d1add:

    # mc "Nadie en particular. Creo que no hay que sexualizar algo así. Es algo que [eri] pidió por [nor], para ir acostumbrando a la abuela."
    mc "Ninguém em particular. Não acho que devamos sexualizar algo assim. É algo que [eri] pediu por causa de [nor], para que a vovó se acostumasse com isso."

# game/scripts/c18/c18.rpy:1674
translate brazilian c18s001_Daphne_57f3a4ca:

    # dap "Me extraña tanto que la abuela no haya protestado. No me la imagino enseñando las tetas delante tuyo, pero tampoco aceptando que otras chicas lo hagan."
    dap "Fiquei tão surpresa que a vovó não protestou. Não consigo imaginá-la mostrando os seios na sua frente, mas também não consigo imaginá-la aceitando isso quando outras garotas fazem."

# game/scripts/c18/c18.rpy:1675
translate brazilian c18s001_Daphne_6d5e1919:

    # dap "Por no hablar de Tía Betty. Es más cool de lo que recordaba, pero..."
    dap "Sem falar da tia Betty. Ela é mais legal do que eu me lembrava, mas..."

# game/scripts/c18/c18.rpy:1676
translate brazilian c18s001_Daphne_f1d7d53c:

    # mc "Tía Betty se apuntaría a cualquier cosa que incomodara a Meemaw. *Risa* Si cree que la va a sacar de sus casillas, es capaz de hacer topless mañana."
    mc "Tia Betty faria qualquer coisa para irritar a vovó. *Risos* Se ela acha que vai conseguir irritá-la, é capaz de ficar de topless amanhã."

# game/scripts/c18/c18.rpy:1678
translate brazilian c18s001_Daphne_3917d012:

    # dap "En eso tienes razón. Parece que siempre están discutiendo."
    dap "Você tem razão. Eles parecem estar sempre discutindo."

# game/scripts/c18/c18.rpy:1679
translate brazilian c18s001_Daphne_215f54e1:

    # mc "Tienen formas diferentes de ver las cosas, aunque Meemaw cada vez ladra menos."
    mc "Eles têm maneiras diferentes de ver as coisas, embora a vovó lata cada vez menos."

# game/scripts/c18/c18.rpy:1681
translate brazilian c18s001_Daphne_90d788b9:

    # "Un móvil suena en alguna parte."
    "Um celular toca em algum lugar."

# game/scripts/c18/c18.rpy:1683
translate brazilian c18s001_Daphne_4aa6c206:

    # dap "Creo que con esto acaba mi tiempo. Te veo en la segunda ronda. Te toca con Megan. La habíamos programado para su descanso."
    dap "Acho que é tudo por hoje. Nos vemos na segunda rodada. Você vai enfrentar a Megan. Tínhamos agendado o jogo dela para o dia de descanso."

# game/scripts/c18/c18.rpy:1685
translate brazilian c18s001_Daphne_48afae88:

    # mc "Te veo luego."
    mc "Até mais."

# game/scripts/c18/c18.rpy:1688
translate brazilian c18s001_app1_da1193af:

    # dap "La teníamos hecha para distribuirnos el tiempo de laboratorio en el instituto. Solo ha habido que adaptarla."
    dap "Já tínhamos o sistema pronto para usar na distribuição do tempo de laboratório no instituto. Só precisávamos adaptá-lo."

# game/scripts/c18/c18.rpy:1691
translate brazilian c18s001_app2_cc152883:

    # dap "Queríamos enseñártela cuando estuviera acabada, aún le quedan unos retoques, pero para esta noche ya nos servía."
    dap "Queríamos mostrar para vocês quando estivesse pronto; ainda precisa de alguns retoques, mas estava bom o suficiente para hoje à noite."

# game/scripts/c18/c18.rpy:1714
translate brazilian c18s001_Kim_238a3a31:

    # "Buscas a Megan por la sala y no está en ningún sitio."
    "Você procura por Megan na sala e ela não está em lugar nenhum."

# game/scripts/c18/c18.rpy:1716
translate brazilian c18s001_Kim_f2cabb37:

    # kim "Megan se ha tenido que ir, con lo que ahora es mi turno, si aún te quedan ganas de bailar."
    kim "Megan teve que ir embora, então agora é minha vez, se você ainda estiver com vontade de dançar."

# game/scripts/c18/c18.rpy:1718
translate brazilian c18s001_Kim_f05c8ea4:

    # mc "Perfecto. Tenemos que continuar la conversación de anoche."
    mc "Perfeito. Precisamos continuar a conversa de ontem à noite."

# game/scripts/c18/c18.rpy:1732
translate brazilian c18s001_Kim_35a36254:

    # mc "Creo que voy a ir a sentarme un rato."
    mc "Acho que vou me sentar um pouco."

# game/scripts/c18/c18.rpy:1733
translate brazilian c18s001_Kim_0482234a:

    # kim "Es normal. Llevas toda la noche de chica en chica."
    kim "É normal. Você passou a noite toda pulando de garota em garota."

# game/scripts/c18/c18.rpy:1739
translate brazilian c18s001_Kim_88e51aa7:

    # kim "Ya te dije que no había nada de lo que hablar."
    kim "Eu já te disse que não havia nada para conversar."

# game/scripts/c18/c18.rpy:1740
translate brazilian c18s001_Kim_cf573686:

    # mc "Y dijiste que esto de estar formando una familia podría evitar que tú y yo... y ahí lo dejaste."
    mc "E você disse que toda essa história de formar uma família poderia nos impedir de... e parou por aí."

# game/scripts/c18/c18.rpy:1742
translate brazilian c18s001_Kim_e397ee2f:

    # kim "No debería haberlo dicho."
    kim "Eu não deveria ter dito isso."

# game/scripts/c18/c18.rpy:1743
translate brazilian c18s001_Kim_d2970102:

    # mc "Sabes que, aunque estemos formando una familia, los típicos tabús familiares no se nos aplican, ¿verdad? A ti y a mí."
    mc "Você sabe que, mesmo começando uma família, os tabus familiares típicos não se aplicam a nós, certo? A você e a mim."

# game/scripts/c18/c18.rpy:1745
translate brazilian c18s001_Kim_92cf4f70:

    # mc "Con el beso de la playa dijiste que te sentías atraída por mí."
    mc "Com aquele beijo na praia, você disse que se sentia atraído por mim."

# game/scripts/c18/c18.rpy:1747
translate brazilian c18s001_Kim_b7e481bc:

    # mc "Y con mi beso te dije que yo me sentía atraído por ti."
    mc "E com meu beijo eu te disse que me sentia atraído por você."

# game/scripts/c18/c18.rpy:1748
translate brazilian c18s001_Kim_62e3685a:

    # mc "¿Dónde ves el problema?"
    mc "Onde você vê o problema?"

# game/scripts/c18/c18.rpy:1750
translate brazilian c18s001_Kim_19acc9d3:

    # kim "El problema lo veo en que estamos formando una familia. No voy a decir que te vea como a un hermano ni nada por el estilo."
    kim "O problema, como eu vejo, é que estamos começando uma família. Não vou dizer que te vejo como um irmão ou algo do tipo."

# game/scripts/c18/c18.rpy:1751
translate brazilian c18s001_Kim_b6abdbc2:

    # kim "Eres... un miembro más de la familia. Pero también lo es [mar], y no sé cómo vería que me liara con su hijo."
    kim "Você é... mais um membro da família. Mas [mar] também é, e eu não sei como ele se sentiria se eu me envolvesse com o filho dele."

# game/scripts/c18/c18.rpy:1752
translate brazilian c18s001_Kim_24cf8761:

    # mc "No creo que la opinión de mi madre tenga que influir en lo que hagamos tú y yo."
    mc "Não acho que a opinião da minha mãe deva influenciar o que você e eu fazemos."

# game/scripts/c18/c18.rpy:1754
translate brazilian c18s001_Kim_92949965:

    # kim "No lo entiendes. Pero influye."
    kim "Você não entende. Mas isso tem um impacto."

# game/scripts/c18/c18.rpy:1756
translate brazilian c18s001_Kim_d2c28201:

    # kim "Me gustas, pero tengo que pensar si debo actuar sobre esos sentimientos."
    kim "Eu gosto de você, mas preciso pensar se devo agir de acordo com esses sentimentos."

# game/scripts/c18/c18.rpy:1758
translate brazilian c18s001_Kim_825a6cec:

    # kim "Aún no sé si me gustas o me caes mal. Depende del día... pero tengo que pensar si debo actuar sobre esos sentimientos, si es que los tengo."
    kim "Ainda não sei se gosto ou não de você. Depende do dia... mas preciso pensar se devo agir de acordo com esses sentimentos, se é que os tenho."

# game/scripts/c18/c18.rpy:1759
translate brazilian c18s001_Kim_24be633e:

    # mc "Lo entiendo. Una cosa es lo que crea yo y otra diferente lo que creas tú."
    mc "Entendo. O que eu acredito é uma coisa, e o que você acredita é outra."

# game/scripts/c18/c18.rpy:1760
translate brazilian c18s001_Kim_f20f6b5e:

    # kim "¿Podemos cambiar de tema?"
    kim "Podemos mudar de assunto?"

# game/scripts/c18/c18.rpy:1761
translate brazilian c18s001_Kim_890c041b:

    # mc "Por supuesto."
    mc "Claro."

# game/scripts/c18/c18.rpy:1763
translate brazilian c18s001_Kim_e99bebcc:

    # mc "Mañana es el fin de la locura. No me malinterpretes, adoro los cumpleaños de las chicas, especialmente después de haberme perdido los últimos tres..."
    mc "Amanhã acaba a loucura. Não me interpretem mal, eu adoro aniversários de meninas, especialmente depois de ter perdido os últimos três..."

# game/scripts/c18/c18.rpy:1764
translate brazilian c18s001_Kim_458fe098:

    # kim "*Risa* Pero es agotador. Los últimos dos días parece que la vida en casa ha girado en torno a [emm], [eri], [dap] y sus cumpleaños."
    kim "*Risos* Mas é exaustivo. Nos últimos dois dias, parece que a vida em casa girou em torno de [emm], [eri], [dap] e seus aniversários."

# game/scripts/c18/c18.rpy:1765
translate brazilian c18s001_Kim_99ce5ea2:

    # kim "Incluso la llegada de Eva y Amanda parecía un regalo anticipado para ellas."
    kim "Até mesmo a chegada de Eva e Amanda pareceu um presente antecipado para eles."

# game/scripts/c18/c18.rpy:1766
translate brazilian c18s001_Kim_cb38f586:

    # mc "Siempre ha sido un fin de semana especial. Pero este año todo parece sobredimensionado."
    mc "Sempre foi um fim de semana especial. Mas este ano tudo parece exagerado."

# game/scripts/c18/c18.rpy:1768
translate brazilian c18s001_Kim_6c3ad41b:

    # kim "Yo las entiendo. Este año estás tú. Están Amanda y Eva. Están Olivia y Betty. Estamos nosotras. Y son el centro de atención de todas."
    kim "Eu as entendo. Este ano tem você. Tem a Amanda e a Eva. Tem a Olivia e a Betty. Tem nós. E elas são o centro das atenções de todos."

# game/scripts/c18/c18.rpy:1769
translate brazilian c18s001_Kim_075a4b95:

    # kim "Es como sus cumpleaños de siempre pero hasta las cejas de esteroides."
    kim "É como os aniversários normais deles, só que turbinados com esteroides."

# game/scripts/c18/c18.rpy:1770
translate brazilian c18s001_Kim_cbd9ac9f:

    # mc "*Risa* Creo que no lo habría podido expresar mejor."
    mc "*Risos* Acho que não poderia ter me expressado melhor."

# game/scripts/c18/c18.rpy:1772
translate brazilian c18s001_Kim_0cdbb488:

    # kim "Espero haber acertado con los regalos. Es complicado acertar... y no podía gastar mucho hasta que no me paguen por el trabajo de la semana que viene."
    kim "Espero ter escolhido os presentes certos. É difícil acertar... e não pude gastar muito até receber meu pagamento na semana que vem."

# game/scripts/c18/c18.rpy:1773
translate brazilian c18s001_Kim_bfa186e6:

    # mc "No creo que miren el valor sino la intención."
    mc "Acho que eles não se concentram no valor, mas sim na intenção."

# game/scripts/c18/c18.rpy:1774
translate brazilian c18s001_Kim_f6767f19:

    # kim "Eso espero..."
    kim "Espero que sim..."

# game/scripts/c18/c18.rpy:1776
translate brazilian c18s001_Kim_30fbdc48:

    # kim "¡Oh! Acabo de darme cuenta... ¿También son los cumpleaños de Eva y Amanda?"
    kim "Ah! Acabei de perceber... São os aniversários da Eva e da Amanda também?"

# game/scripts/c18/c18.rpy:1777
translate brazilian c18s001_Kim_143cc74d:

    # mc "No, fueron hace un mes más o menos."
    mc "Não, foi há cerca de um mês."

# game/scripts/c18/c18.rpy:1779
translate brazilian c18s001_Kim_ec50ffca:

    # kim "Menos mal... no les había comprado nada."
    kim "Ainda bem... eu não tinha comprado nada deles."

# game/scripts/c18/c18.rpy:1780
translate brazilian c18s001_Kim_ab87e77f:

    # mc "Aunque fueran sus cumpleaños, lo entenderían. Las conociste ayer. Pero no te preocupes. Solo son tres cumpleaños. Solo."
    mc "Mesmo que fossem os aniversários deles, eles entenderiam. Você os conheceu ontem. Mas não se preocupe. São apenas três aniversários. Só três."

# game/scripts/c18/c18.rpy:1782
translate brazilian c18s001_Kim_502b2abc:

    # kim "Ayer... parece que ha pasado una vida entera, pero ayer hizo una semana que llegamos."
    kim "Ontem... parece que foi há uma eternidade, mas ontem completou uma semana desde que chegamos."

# game/scripts/c18/c18.rpy:1783
translate brazilian c18s001_Kim_f43ae440:

    # kim "Mudarme a Newport es la mejor decisión que he tomado en mucho tiempo."
    kim "Mudar-me para Newport foi a melhor decisão que tomei em muito tempo."

# game/scripts/c18/c18.rpy:1784
translate brazilian c18s001_Kim_18670915:

    # kim "Vine por el calor y he encontrado el calor de una familia."
    kim "Vim em busca de calor humano e encontrei o calor de uma família."

# game/scripts/c18/c18.rpy:1785
translate brazilian c18s001_Kim_9f4e825f:

    # mc "Eso te ha quedado... casi poético. Me alegra que te sientas así."
    mc "Isso soou... quase poético. Fico feliz que você se sinta assim."

# game/scripts/c18/c18.rpy:1786
translate brazilian c18s001_Kim_5eeaf5f0:

    # mc "Tu familia de Cleveland... ¿has hablado con ellos?"
    mc "Sua família em Cleveland... você já falou com eles?"

# game/scripts/c18/c18.rpy:1788
translate brazilian c18s001_Kim_8092e0f5:

    # kim "Hablo todos los días y se lo he explicado todo... bueno, menos La Clonversación... y alguna cosa más."
    kim "Falo com ele todos os dias e expliquei tudo... bem, exceto a conversa sobre o clone... e algumas outras coisas."

# game/scripts/c18/c18.rpy:1789
translate brazilian c18s001_Kim_b5ad180f:

    # kim "Alucinan cuando les hablo de la familia. Dicen que nunca me habían visto adaptándome tan rápido a un sitio."
    kim "Eles ficam impressionados quando falo sobre minha família. Dizem que nunca me viram me adaptar a um lugar tão rapidamente."

# game/scripts/c18/c18.rpy:1790
translate brazilian c18s001_Kim_27b9cbcf:

    # mc "¿Te costaba adaptarte? No lo entiendo, eres muy sociable."
    mc "Você achou difícil se adaptar? Não entendo, você é muito sociável."

# game/scripts/c18/c18.rpy:1792
translate brazilian c18s001_Kim_90e3b17d:

    # kim "Soy muy sociable porque lo ponéis muy fácil. Nadie juzga a nadie... bueno, quizás Olivia un poco."
    kim "Sou muito sociável porque você torna tudo muito fácil. Ninguém julga ninguém... bem, talvez a Olivia um pouquinho."

# game/scripts/c18/c18.rpy:1793
translate brazilian c18s001_Kim_e9496f0f:

    # kim "Nadie hace comentarios para hacer daño a nadie. Todo el mundo ayuda a todo el mundo en lo que puede."
    kim "Ninguém faz comentários para magoar ninguém. Todos ajudam uns aos outros da maneira que podem."

# game/scripts/c18/c18.rpy:1794
translate brazilian c18s001_Kim_087f7674:

    # kim "Y después estás tú. Parece que estás en todos sitios cuando alguna de nosotras te necesitamos."
    kim "E aí tem você. Parece que você está em todo lugar quando qualquer um de nós precisa de você."

# game/scripts/c18/c18.rpy:1795
translate brazilian c18s001_Kim_a13ee82f:

    # mc "Era una de mis funciones cuando erais solo clientas... eso ha sonado muy mal. *Risa*"
    mc "Essa era uma das minhas funções quando vocês ainda eram apenas clientes... isso soou muito mal. *Risos*"

# game/scripts/c18/c18.rpy:1796
translate brazilian c18s001_Kim_143dc688:

    # mc "Ahora, además, lo hago por pasar tiempo con vosotras."
    mc "Agora, também faço isso para passar tempo com todos vocês."

# game/scripts/c18/c18.rpy:1798
translate brazilian c18s001_Kim_fd10106e:

    # kim "Y nosotras te lo agradecemos. Mucho."
    kim "E nós agradecemos muito por isso."

# game/scripts/c18/c18.rpy:1799
translate brazilian c18s001_Kim_271c2c3d:

    # kim "Es difícil tener una conversación con cualquiera de las chicas en la que no se hable de ti tarde o temprano."
    kim "É difícil ter uma conversa com qualquer uma das garotas sem que seu nome seja mencionado mais cedo ou mais tarde."

# game/scripts/c18/c18.rpy:1800
translate brazilian c18s001_Kim_10832dd0:

    # kim "No es que seas el centro de cada conversación, aún estamos en ese momento en que nos quedan planes y sueños que compartir, pero sueles aparecer en muchas de ellas."
    kim "Não é que você seja o centro de todas as conversas; ainda estamos naquela fase em que temos planos e sonhos para compartilhar, mas você tende a aparecer em muitos deles."

# game/scripts/c18/c18.rpy:1801
translate brazilian c18s001_Kim_c436991a:

    # mc "*Risa* No sé si sentirme halagado o estudiado."
    mc "*Risos* Não sei se me sinto lisonjeado ou se estou sendo observado."

# game/scripts/c18/c18.rpy:1803
translate brazilian c18s001_Kim_6e76ae0b:

    # kim "*Risa* Halagado, por supuesto. Eres el único chico en una familia de mujeres."
    kim "*Risos* Lisonjeado, claro. Você é o único menino em uma família de mulheres."

# game/scripts/c18/c18.rpy:1804
translate brazilian c18s001_Kim_e0a38ae3:

    # kim "Tengo ganas de conocer al tal Jamaal mañana, aunque puede cohibir a alguna de las chicas para ir en topless... o desnudas en el jacuzzi. Más incluso de lo que las cohíbes tú."
    kim "Estou ansiosa para conhecer Jamaal amanhã, embora ele possa deixar algumas das meninas constrangidas em ficar de topless... ou nuas na jacuzzi. Ainda mais do que você as deixa constrangidas."

# game/scripts/c18/c18.rpy:1805
translate brazilian c18s001_Kim_01fba5e8:

    # mc "Jamaal es muy buen tío, pero no va a estar interesado en vosotras. Se pasará el día comiendo y metiéndose conmigo. Además, no puede subir las escaleras del jacuzzi. *Risa*"
    mc "O Jamaal é um cara muito legal, mas ele não vai se interessar por vocês, meninas. Ele vai passar o dia todo comendo e me provocando. Além disso, ele não consegue subir as escadas da jacuzzi. *Risos*"

# game/scripts/c18/c18.rpy:1806
translate brazilian c18s001_Kim_0e10ac56:

    # mc "¿Y yo os cohíbo? No lo había pensado."
    mc "E eu estou te atrapalhando? Não tinha pensado nisso."

# game/scripts/c18/c18.rpy:1808
translate brazilian c18s001_Kim_71cb6066:

    # kim "Algunas de nosotras somos conscientes de nuestro aspecto. No te voy a decir quiénes."
    kim "Algumas pessoas se sentem inseguras com a própria aparência. Não vou dizer quem."

# game/scripts/c18/c18.rpy:1809
translate brazilian c18s001_Kim_a919805d:

    # kim "Desnudarse, aunque sea parcialmente delante de un chico, siempre es un paso importante. Especialmente si ese chico te gusta."
    kim "Ficar nua, mesmo que parcialmente na frente de um cara, é sempre um grande passo. Principalmente se você gosta dele."

# game/scripts/c18/c18.rpy:1810
translate brazilian c18s001_Kim_07a2818b:

    # mc "Bueno, si ese chico le gusta a alguien, todo el mundo sabe que a ese chico le gusta hablar las cosas. Especialmente si eso supone un problema."
    mc "Bom, se alguém gosta daquele cara, todo mundo sabe que ele gosta de resolver as coisas na conversa. Principalmente se isso causar problemas."

# game/scripts/c18/c18.rpy:1812
translate brazilian c18s001_Kim_e15856aa:

    # kim "Quizás demasiado. A veces muy poco."
    kim "Talvez demais. Às vezes, de menos."

# game/scripts/c18/c18.rpy:1813
translate brazilian c18s001_Kim_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "O que você está falando?"

# game/scripts/c18/c18.rpy:1815
translate brazilian c18s001_Kim_fe9f7327:

    # "Un móvil suena en algún sitio."
    "Um celular toca em algum lugar."

# game/scripts/c18/c18.rpy:1823
translate brazilian c18s001_Kim_91f374f0:

    # kim "Te he dicho que me gustas y me has dejado cambiar de tema."
    kim "Eu te disse que gosto de você e você me deixou mudar de assunto."

# game/scripts/c18/c18.rpy:1824
translate brazilian c18s001_Kim_69706e4b:

    # mc "Me lo has pedido tú."
    mc "Você me pediu para fazer isso."

# game/scripts/c18/c18.rpy:1826
translate brazilian c18s001_Kim_1f0fd4d5:

    # kim "Lo sé. Pero casi esperaba que siguieras hablando... que me intentaras convencer para que tomara una decisión..."
    kim "Eu sei. Mas quase esperava que você continuasse falando... tentando me convencer a tomar uma decisão..."

# game/scripts/c18/c18.rpy:1827
translate brazilian c18s001_Kim_ce2d76a2:

    # kim "Ahora ha pasado el momento, pero en ese momento lo esperaba."
    kim "O tempo já passou, mas naquela época eu estava esperando por isso."

# game/scripts/c18/c18.rpy:1828
translate brazilian c18s001_Kim_992a26ad:

    # mc "No voy a forzarte a tomar una decisión, Kim. Es algo que tienes que pensar tú y llegar a tus propias conclusiones."
    mc "Não vou te forçar a tomar uma decisão, Kim. É algo sobre o qual você precisa pensar e chegar às suas próprias conclusões."

# game/scripts/c18/c18.rpy:1830
translate brazilian c18s001_Kim_5bf97fc7:

    # kim "Ni siquiera me has dicho que yo también te gusto..."
    kim "Você nem sequer me disse que também gosta de mim..."

# game/scripts/c18/c18.rpy:1832
translate brazilian c18s001_Kim_6978ba63:

    # mc "Creo que ya te lo demostré en la playa."
    mc "Acho que já provei isso para você na praia."

# game/scripts/c18/c18.rpy:1834
translate brazilian c18s001_Kim_6d41a4ae:

    # mc "Eres preciosa, Kim."
    mc "Você é linda, Kim."

# game/scripts/c18/c18.rpy:1835
translate brazilian c18s001_Kim_029a6582:

    # mc "Pero yo tampoco he decidido si siento algo por ti más allá de... eso. Tan solo pensaba que debíamos hablarlo."
    mc "Mas eu ainda não decidi se sinto algo por você além disso... também. Só achei que deveríamos conversar sobre isso."

# game/scripts/c18/c18.rpy:1838
translate brazilian c18s001_Kim_1df2fe9f:

    # kim "A nada... "
    kim "Nada..."

# game/scripts/c18/c18.rpy:1839
translate brazilian c18s001_Kim_dd5b7480:

    # mc "A algo te tienes que estar refiriendo..."
    mc "Você deve estar se referindo a alguma coisa..."

# game/scripts/c18/c18.rpy:1841
translate brazilian c18s001_Kim_3623b69b:

    # kat "Creo que es mi turno, Kim."
    kat "Acho que agora é a minha vez, Kim."

# game/scripts/c18/c18.rpy:1843
translate brazilian c18s001_Kim_ac397e61:

    # kim "Todo para ti, Kate."
    kim "Tudo por você, Kate."

# game/scripts/c18/c18.rpy:1844
translate brazilian c18s001_Kim_a06f15b8:

    # kim "Te veo en mi siguiente turno, [mc]."
    kim "Te vejo no meu próximo turno, [mc]."

# game/scripts/c18/c18.rpy:1845
