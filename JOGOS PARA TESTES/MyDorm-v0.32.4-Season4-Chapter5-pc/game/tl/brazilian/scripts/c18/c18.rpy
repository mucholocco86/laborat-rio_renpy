translate brazilian c18s003_Daphne_6f53ba35:

    # mc "Scarlett, te nombro cambiadora de pañales oficial de Maeve. *Risa*"
    mc "Scarlett, por meio deste, nomeio você a trocadora de fraldas oficial da Maeve. *Risos*"

# game/scripts/c18/c18.rpy:2532
translate brazilian c18s003_Daphne_c0aa63d4:

    # sca "¡Puagh! Yo haré la app, pero para instalarla en el móvil de Olivia y que los cambie ella. *Risa*"
    sca "Ah! Vou criar o aplicativo, mas vou instalá-lo no celular da Olivia para que ela mesma possa alterar as configurações. *Risos*"

# game/scripts/c18/c18.rpy:2533
translate brazilian c18s003_Daphne_cad21f54:

    # sca "Me quedo con el título de Gestora de Cambios de Pañal. *Risa*"
    sca "Vou continuar com o título de Gerente de Troca de Fraldas. *Risos*"

# game/scripts/c18/c18.rpy:2534
translate brazilian c18s003_Daphne_791949b7:

    # mc "Nos sirve, ¿verdad, [dap]?"
    mc "Funciona para nós, certo, [dap]?"

# game/scripts/c18/c18.rpy:2536
translate brazilian c18s003_Daphne_809dd707:

    # dap "¡Por supuesto! Ven aquí, Scarlett. Únete al abrazo. Sin tu idea de las lecciones esto no hubiera pasado."
    dap "Claro! Vem cá, Scarlett. Entra no abraço. Sem a sua ideia para as aulas, isso não teria acontecido."

# game/scripts/c18/c18.rpy:2537
translate brazilian c18s003_Daphne_5b454c6a:

    # mc "Sí, Tía Scarlett, ven aquí."
    mc "Sim, tia Scarlett, venha cá."

# game/scripts/c18/c18.rpy:2539
translate brazilian c18s003_Daphne_d9344989:

    # "Scarlett se une al abrazo. Contenta por su nueva sobrina."
    "Scarlett se junta ao abraço. Feliz pela sua nova sobrinha."

# game/scripts/c18/c18.rpy:2540
translate brazilian c18s003_Daphne_2fbca90c:

    # sca "Ahora hay que planificar el viaje a Aruba."
    sca "Agora precisamos planejar a viagem para Aruba."

# game/scripts/c18/c18.rpy:2541
translate brazilian c18s003_Daphne_deea06af:

    # mc "¿Aruba? ¿Por qué?"
    mc "Aruba? Por quê?"

# game/scripts/c18/c18.rpy:2544
translate brazilian c18s003_Daphne_34bf169a:

    # dap "Somos primos y en Aruba hay una empresa de ingeniería genética que clona bebés. Creo que es el mejor sitio para comprobar que no hay ningún problema."
    dap "Somos primos, e existe uma empresa de engenharia genética em Aruba que clona bebês. Acho que é o melhor lugar para verificar se não há nenhum problema."

# game/scripts/c18/c18.rpy:2545
translate brazilian c18s003_Daphne_a7ed2bb8:

    # dap "Aunque la endogamia entre primos tiene un riesgo negligible, prefiero estar segura."
    dap "Embora o cruzamento consanguíneo entre primos apresente um risco insignificante, prefiro ser cauteloso."

# game/scripts/c18/c18.rpy:2547
translate brazilian c18s003_Daphne_51ead11d_1:

    # dap "Soy un clon de Eva. No sé cómo eso puede afectar a nuestro bebé."
    dap "Sou um clone de Eva. Não sei como isso pode afetar nosso bebê."

# game/scripts/c18/c18.rpy:2548
translate brazilian c18s003_Daphne_1cf30409:

    # dap "En Aruba hay una empresa de ingeniería genética que clona bebés. Creo que es el mejor sitio para comprobar que no hay ningún problema."
    dap "Existe uma empresa de engenharia genética em Aruba que clona bebês. Acho que é o melhor lugar para verificar se não há nenhum problema."

# game/scripts/c18/c18.rpy:2550
translate brazilian c18s003_Daphne_92487e72:

    # dap "Además, no creerás que te vas a librar de mis antojos, ¿verdad? *Risa*"
    dap "Além disso, você não acha que vai escapar dos meus desejos, acha? *Risos*"

# game/scripts/c18/c18.rpy:2551
translate brazilian c18s003_Daphne_f24b12c9:

    # mc "No tengo intención de hacerlo. *Risa*"
    mc "Não tenho nenhuma intenção de fazer isso. *Risos*"

# game/scripts/c18/c18.rpy:2553
translate brazilian c18s003_Daphne_9c02d355:

    # sca "Si no os molesta, yo os acompañaré. Mientras la ballena se hace las pruebas, yo podre lucir tipito en una playa caribeña. *Risa*"
    sca "Se não se importar, eu vou com você. Enquanto a baleia faz os exames, posso exibir minha silhueta em uma praia caribenha. *Risos*"

# game/scripts/c18/c18.rpy:2554
translate brazilian c18s003_Daphne_07f0ea1c:

    # mc "Eres bienvenida, pero no te recomiendo llamar ballena a una mujer embarazada. *Risa*"
    mc "De nada, mas eu não recomendaria chamar uma mulher grávida de baleia. *Risos*"

# game/scripts/c18/c18.rpy:2556
translate brazilian c18s003_Daphne_e07eddda_1:

    # "Os volvéis a abrazar los tres. El día ha empezado bien para [dap]."
    "Vocês três se abraçam novamente. O dia começou bem para [dap]."

# game/scripts/c18/c18.rpy:2559
translate brazilian c18s003_Daphne_18850f16_1:

    # dap "Negativo."
    dap "Negativo."

# game/scripts/c18/c18.rpy:2560
translate brazilian c18s003_Daphne_7cf3844e:

    # mc "¿Decepcionada?"
    mc "Decepcionado?"

# game/scripts/c18/c18.rpy:2562
translate brazilian c18s003_Daphne_46e31e90:

    # dap "Para nada. Ya te dije ayer que nunca había pensado en quedarme embarazada a los 18."
    dap "De jeito nenhum. Eu já te disse ontem que nunca pensei em engravidar aos 18 anos."

# game/scripts/c18/c18.rpy:2563
translate brazilian c18s003_Daphne_7ab3155e:

    # dap "Mañana es otra cosa, ya tendré 19. *Risa* Y si llega a los 20 o a los 23 da lo mismo. Lo divertido son los intentos."
    dap "Amanhã é outra história, aí terei 19 anos. *Risos* E se eu chegar aos 20 ou aos 23, não importa. A parte divertida é tentar."

# game/scripts/c18/c18.rpy:2564
translate brazilian c18s003_Daphne_5a2bb053:

    # mc "Esa es la actitud."
    mc "Essa é a atitude."

# game/scripts/c18/c18.rpy:2566
translate brazilian c18s003_Daphne_116c78a0:

    # sca "Al menos no serás una ballena cuando vayamos a Aruba."
    sca "Pelo menos você não vai virar uma baleia quando formos para Aruba."

# game/scripts/c18/c18.rpy:2567
translate brazilian c18s003_Daphne_a3b677a8:

    # mc "¿Aruba?"
    mc "Aruba?"

# game/scripts/c18/c18.rpy:2569
translate brazilian c18s003_Daphne_f03fc7c0:

    # dap "Ya te dijimos que queríamos trabajar allí. Es muy pronto aún, tenemos que acabar las carreras... empezarlas para ser más exactos."
    dap "Já dissemos que queríamos trabalhar lá. Ainda é muito cedo; temos que terminar nossos cursos... ou melhor, começar."

# game/scripts/c18/c18.rpy:2570
translate brazilian c18s003_Daphne_f7efe4f0:

    # dap "Pero queremos acompañarte cuando vayas, para ver las instalaciones, empezar a aprender cómo funciona todo y aprovechar el verano."
    dap "Mas queremos acompanhá-lo quando for, para ver as instalações, começar a aprender como tudo funciona e aproveitar ao máximo o verão."

# game/scripts/c18/c18.rpy:2572
translate brazilian c18s003_Daphne_3f0d013b:

    # sca "No tenemos mucho que hacer hasta que no empiece el curso, con lo que nos ha parecido una buena idea."
    sca "Não temos muito o que fazer até o início do curso, então pensamos que seria uma boa ideia."

# game/scripts/c18/c18.rpy:2573
translate brazilian c18s003_Daphne_272eb721:

    # sca "Al menos pasar unos días allí hasta que te asientes. No te sentirás tan solo."
    sca "Passe pelo menos alguns dias lá até se ambientar. Você não se sentirá tão sozinho."

# game/scripts/c18/c18.rpy:2574
translate brazilian c18s003_Daphne_caa7b151:

    # mc "Me parece genial. Habría que hablarlo con Amanda y Eva, pero no creo que haya ningún problema. Pero ahora quiero un abrazo."
    mc "Isso parece ótimo. Teríamos que conversar com Amanda e Eva sobre isso, mas não acho que haverá nenhum problema. Mas agora eu quero um abraço."

# game/scripts/c18/c18.rpy:2576
translate brazilian c18s003_Daphne_46c2079e:

    # "Los tres os fundís en un abrazo que inicia [dap] y al que se une Scarlett."
    "Vocês três se abraçam num abraço que começa [dap] e ao qual Scarlett se junta."

# game/scripts/c18/c18.rpy:2580
translate brazilian c18s003_Scarlett_96aa7fa7:

    # sca "¿Ha sido el mío? Me da miedo mirar..."
    sca "Era meu? Tenho medo de olhar..."

# game/scripts/c18/c18.rpy:2581
translate brazilian c18s003_Scarlett_87d401ed:

    # mc "Sabes que no hay una sola oportunidad, ¿verdad? Si no sale positivo a la primera..."
    mc "Você sabe que só temos uma chance, né? Se não der certo na primeira vez..."

# game/scripts/c18/c18.rpy:2585
translate brazilian c18s003_Scarlett_98a5fb30:

    # sca "¡Positivo!"
    sca "Positivo!"

# game/scripts/c18/c18.rpy:2586
translate brazilian c18s003_Scarlett_a60fd8f1:

    # mc "¡Ven aquí, Mamá!"
    mc "Vem cá, mãe!"

# game/scripts/c18/c18.rpy:2590
translate brazilian c18s003_Scarlett_d2ac3aee:

    # mc "¿Pasa algo, mi amor? ¿No estás contenta?"
    mc "Há algo errado, meu amor? Você não está feliz?"

# game/scripts/c18/c18.rpy:2591
translate brazilian c18s003_Scarlett_38e664b6:

    # sca "No es eso..."
    sca "Não é isso..."

# game/scripts/c18/c18.rpy:2594
translate brazilian c18s003_Scarlett_bed9a5e7:

    # sca "No me malinterpretes... estoy contenta de llevar a nuestro hijo dentro..."
    sca "Não me interpretem mal... Estou feliz por estar carregando nosso filho..."

# game/scripts/c18/c18.rpy:2595
translate brazilian c18s003_Scarlett_4c103678:

    # mc "Nadie lo podría adivinar, Scarlett. Parece que la noticia no te ha gustado."
    mc "Ninguém poderia ter adivinhado, Scarlett. Parece que você não gostou da notícia."

# game/scripts/c18/c18.rpy:2598
translate brazilian c18s003_Scarlett_5ab2cc5d:

    # sca "Es posible que seamos hermanos y que este hijo sea endogámico. Me preocupa..."
    sca "É possível que sejamos irmãos e que essa criança seja fruto de incesto. Estou preocupado..."

# game/scripts/c18/c18.rpy:2602
translate brazilian c18s003_Scarlett_63768574:

    # sca "Sé que [mar] va a estar ahí para nuestro bebé, y que [nor] va a actuar también de abuela. Y que va a tener muchas tías."
    sca "Sei que [mar] estará lá para o nosso bebê, e que [nor] também atuará como avó. E que ela terá muitas tias."

# game/scripts/c18/c18.rpy:2603
translate brazilian c18s003_Scarlett_a0938342:

    # mc "Y no te olvides de Meemaw y Tía Betty. Van a ser unas bisabuelas fantásticas."
    mc "E não se esqueçam da vovó e da tia Betty. Elas serão bisavós fantásticas."

# game/scripts/c18/c18.rpy:2604
translate brazilian c18s003_Scarlett_00cc1e5f:

    # mc "Al menos cuando no estén en Florida."
    mc "Pelo menos quando não estão na Flórida."

# game/scripts/c18/c18.rpy:2606
translate brazilian c18s003_Scarlett_ffad69a8:

    # sca "Pero... me gustaría que... en algún momento se lo pudiéramos decir a mi madre."
    sca "Mas... eu gostaria... que em algum momento pudéssemos contar para minha mãe."

# game/scripts/c18/c18.rpy:2607
translate brazilian c18s003_Scarlett_6418d1c9:

    # mc "¿Qué? ¿Tal como te ha tratado?"
    mc "O quê? O jeito que ele te tratou?"

# game/scripts/c18/c18.rpy:2609
translate brazilian c18s003_Scarlett_82a96e43:

    # dap "[mc], es su madre. ¿No se lo vas a contar a Tío Edmund, por muy mal que se haya portado?"
    dap "[mc], ela é a mãe dele. Você não vai contar para o tio Edmund, não importa o quão mal ele tenha se comportado?"

# game/scripts/c18/c18.rpy:2612
translate brazilian c18s003_Scarlett_3a161190:

    # mc "Si por mí fuera, esperaría como mínimo a tener los resultados del test de ADN."
    mc "Se dependesse de mim, eu esperaria pelo menos até ter os resultados do teste de DNA."

# game/scripts/c18/c18.rpy:2614
translate brazilian c18s003_Scarlett_865718ea:

    # mc "Si por mí fuera, esperaría un tiempo antes de decírselo, a que se calmen las aguas."
    mc "Se dependesse de mim, eu esperaria um pouco antes de contar para ele, até as coisas se acalmarem."

# game/scripts/c18/c18.rpy:2617
translate brazilian c18s003_Scarlett_736e64cc:

    # sca "Me parece una buena idea. Si somos medio hermanos... creo que podría decir cosas muy feas. Al menos iremos preparados. Y no es que tenga ganas de verla ahora mismo."
    sca "Parece uma boa ideia. Se formos meio-irmãos... acho que ela pode dizer coisas muito desagradáveis. Pelo menos estaremos preparados. E não é como se eu estivesse ansioso para vê-la agora."

# game/scripts/c18/c18.rpy:2619
translate brazilian c18s003_Scarlett_2574a128:

    # sca "Me parece una buena idea. No tengo ganas de verla ahora mismo."
    sca "Parece uma boa ideia. Não estou com vontade de assistir agora."

# game/scripts/c18/c18.rpy:2620
translate brazilian c18s003_Scarlett_f24e11ee:

    # sca "De todas formas, no tenía intención de contárselo enseguida. Primero se lo quiero contar a nuestra familia."
    sca "De qualquer forma, eu não pretendia contar para ele imediatamente. Quero contar primeiro para a nossa família."

# game/scripts/c18/c18.rpy:2622
translate brazilian c18s003_Scarlett_87c40627:

    # mc "Ya te lo he dicho. Si quieres contárselo, no voy a poner ningún impedimento."
    mc "Eu já te disse. Se você quiser contar para ele, eu não vou impedi-lo."

# game/scripts/c18/c18.rpy:2625
translate brazilian c18s003_Scarlett_7324dc5d:

    # dap "¿Puede Tía [dap] pedir un abrazo de los futuros padres?"
    dap "A tia [dap] pode pedir um abraço aos futuros pais?"

# game/scripts/c18/c18.rpy:2628
translate brazilian c18s003_Scarlett_53e40ed6:

    # sca "Ahora solo falta ver el de [dap]. Yo también quiero ser tía."
    sca "Agora só falta ver os [dap]. Eu também quero ser tia."

# game/scripts/c18/c18.rpy:2629
translate brazilian c18s003_Scarlett_31214d4f:

    # dap "No tengo prisa en que pite. Se está muy bien aquí. Ese test de embarazo va a ser el mejor regalo de cumpleaños que voy a recibir hoy."
    dap "Não tenho pressa para que apite. Está muito agradável aqui. Esse teste de gravidez vai ser o melhor presente de aniversário que vou ganhar hoje."

# game/scripts/c18/c18.rpy:2631
translate brazilian c18s003_Scarlett_35f100d5:

    # dap "A veces me dais mucha envidia. Después pienso en que voy a poder jugar con el bebé y se me pasa."
    dap "Às vezes, sinto muita inveja de vocês. Mas aí penso em como vou poder brincar com o bebê e essa inveja passa."

# game/scripts/c18/c18.rpy:2632
translate brazilian c18s003_Scarlett_da69abcb:

    # dap "Ese test de embarazo va a ser el mejor regalo de cumpleaños que voy a recibir hoy."
    dap "Esse teste de gravidez vai ser o melhor presente de aniversário que vou receber hoje."

# game/scripts/c18/c18.rpy:2633
translate brazilian c18s003_Scarlett_974421d2:

    # mc "*Risa* Espero que no, pero ya tenemos una voluntaria para cambiar pañales, Scarlett."
    mc "*Risos* Espero que não, mas já temos uma voluntária para trocar fraldas, a Scarlett."

# game/scripts/c18/c18.rpy:2634
translate brazilian c18s003_Scarlett_3f97664c:

    # sca "*Risa* Creo que [dap] será la primera persona del mundo que se lea en profundidad el manual de los pañales y lo modifique para hacerlo más eficiente."
    sca "*Risos* Acho que [dap] será a primeira pessoa no mundo a ler o manual de fraldas em detalhes e modificá-lo para torná-lo mais eficiente."

# game/scripts/c18/c18.rpy:2635
translate brazilian c18s003_Scarlett_8843c9a6:

    # dap "¡Puagh! Quiero jugar con el bebé. *Risa* Los pañales son cosa vuestra. Pero sí que me leeré el manual."
    dap "Eca! Quero brincar com o bebê. *Risos* As fraldas são sua responsabilidade. Mas vou ler o manual."

# game/scripts/c18/c18.rpy:2638
translate brazilian c18s003_Scarlett_2ed5da58:

    # sca "¡Negativo!"
    sca "Negativo!"

# game/scripts/c18/c18.rpy:2639
translate brazilian c18s003_Scarlett_ce105bff:

    # mc "Ven aquí. Dame un abrazo y un beso."
    mc "Vem cá. Me dá um abraço e um beijo."

# game/scripts/c18/c18.rpy:2643
translate brazilian c18s003_Scarlett_db1134ff:

    # mc "No te pongas triste, habrá más oportunidades."
    mc "Não fique triste, haverá mais oportunidades."

# game/scripts/c18/c18.rpy:2644
translate brazilian c18s003_Scarlett_38e664b6_1:

    # sca "No es eso..."
    sca "Não é isso..."

# game/scripts/c18/c18.rpy:2647
translate brazilian c18s003_Scarlett_aeda7f1c:

    # sca "No me malinterpretes, me hubiera gustado quedarme embarazada... pero casi prefiero que no haya pasado."
    sca "Não me interpretem mal, eu gostaria de ter engravidado... mas quase prefiro que isso não tenha acontecido."

# game/scripts/c18/c18.rpy:2648
translate brazilian c18s003_Scarlett_ba5aaef9:

    # mc "¿Por qué? ¿Hay algo que deba saber?"
    mc "Por quê? Há algo que eu deva saber?"

# game/scripts/c18/c18.rpy:2651
translate brazilian c18s003_Scarlett_0a15ad94:

    # sca "Aún no sabemos los resultados del test de ADN. Es posible que este bebé hubiera sido endogámico."
    sca "Ainda não sabemos os resultados do teste de DNA. É possível que este bebê tenha nascido fora do casamento."

# game/scripts/c18/c18.rpy:2655
translate brazilian c18s003_Scarlett_2d41f174:

    # sca "Sé que [mar] estaría ahí para nuestro bebé, y que [nor] actuaría también de abuela. Y que tendría muchas tías."
    sca "Sei que [mar] estaria lá para o nosso bebê, e que [nor] também agiria como uma avó. E que eu teria muitas tias."

# game/scripts/c18/c18.rpy:2656
translate brazilian c18s003_Scarlett_e99a63f0:

    # mc "Y no te olvides de Meemaw y Tía Betty. Serían unas bisabuelas fantásticas."
    mc "E não se esqueçam da vovó e da tia Betty. Elas seriam bisavós fantásticas."

# game/scripts/c18/c18.rpy:2657
translate brazilian c18s003_Scarlett_00cc1e5f_1:

    # mc "Al menos cuando no estén en Florida."
    mc "Pelo menos quando não estão na Flórida."

# game/scripts/c18/c18.rpy:2659
translate brazilian c18s003_Scarlett_15a556d7:

    # sca "Pero... me gustaría que... si en algún momento pasa, se lo pudiéramos decir a mi madre."
    sca "Mas... eu gostaria... que se isso algum dia acontecer, pudéssemos contar para minha mãe."

# game/scripts/c18/c18.rpy:2660
translate brazilian c18s003_Scarlett_6418d1c9_1:

    # mc "¿Qué? ¿Tal como te ha tratado?"
    mc "O quê? O jeito que ele te tratou?"

# game/scripts/c18/c18.rpy:2662
translate brazilian c18s003_Scarlett_7cf92379:

    # dap "[mc], es su madre. ¿No se lo contarías a Tío Edmund, por muy mal que se haya portado?"
    dap "[mc], ela é a mãe dele. Você não contaria para o tio Edmund, não importa o quão mal ele tenha se comportado?"

# game/scripts/c18/c18.rpy:2665
translate brazilian c18s003_Scarlett_0d19a8e7:

    # mc "Pero si hubiera salido positivo hoy, esperaría como mínimo a tener los resultados del test de ADN."
    mc "Mas se o resultado fosse positivo hoje, eu pelo menos esperaria pelos resultados do teste de DNA."

# game/scripts/c18/c18.rpy:2667
translate brazilian c18s003_Scarlett_de601e4a:

    # mc "Pero si hubiera salido positivo hoy, esperaría un tiempo antes de decírselo, a que se calmen las aguas."
    mc "Mas se o meu teste tivesse dado positivo hoje, eu esperaria um pouco antes de contar para ele, até as coisas se acalmarem."

# game/scripts/c18/c18.rpy:2670
translate brazilian c18s003_Scarlett_7f007538:

    # sca "Me parece una buena idea. Si somos medio hermanos... creo que podría decir cosas muy feas. Al menos iríamos preparados."
    sca "Parece uma boa ideia. Se formos meio-irmãos... acho que eu diria coisas bem desagradáveis. Pelo menos estaríamos preparados."

# game/scripts/c18/c18.rpy:2672
translate brazilian c18s003_Scarlett_2574a128_1:

    # sca "Me parece una buena idea. No tengo ganas de verla ahora mismo."
    sca "Parece uma boa ideia. Não estou com vontade de assistir agora."

# game/scripts/c18/c18.rpy:2673
translate brazilian c18s003_Scarlett_6c0c04ea:

    # sca "De todas formas, no tenía intención de contárselo enseguida. Primero se lo hubiera querido contar a nuestra familia."
    sca "De qualquer forma, eu não pretendia contar para ele imediatamente. Eu teria preferido contar primeiro para a nossa família."

# game/scripts/c18/c18.rpy:2675
translate brazilian c18s003_Scarlett_1a6a26a4:

    # mc "Ya te lo he dicho. Si, cuando pase, quieres contárselo, no voy a poner ningún impedimento."
    mc "Eu já te disse. Se, quando acontecer, você quiser contar para ele, eu não vou impedi-lo."

# game/scripts/c18/c18.rpy:2678
translate brazilian c18s003_Scarlett_70a401d3:

    # dap "¿Puede la futura Tía [dap] pedir un abrazo de los futuros padres?"
    dap "Será que a futura tia [dap] pode pedir um abraço aos futuros pais?"

# game/scripts/c18/c18.rpy:2681
translate brazilian c18s003_Scarlett_94124824:

    # sca "Ahora solo falta ver el de [dap]. A mí me gustaría saber hoy que voy a ser tía."
    sca "Agora só falta ver o resultado do teste de gravidez. Adoraria saber hoje que vou ser tia."

# game/scripts/c18/c18.rpy:2682
translate brazilian c18s003_Scarlett_118ef7b0:

    # dap "No tengo prisa en que pite. Se está muy bien aquí. Ese test de embarazo podría haber sido el mejor regalo de cumpleaños que iba a recibir hoy."
    dap "Não tenho pressa para que apite. Está muito agradável aqui. Esse teste de gravidez poderia ter sido o melhor presente de aniversário que eu poderia ter recebido hoje."

# game/scripts/c18/c18.rpy:2683
translate brazilian c18s003_Scarlett_0096e533:

    # dap "Veros superar las dudas han superado a cualquier posible positivo. Y ese bebé llegará tarde o temprano."
    dap "Ver você superar suas dúvidas foi mais gratificante do que qualquer resultado positivo possível. E esse bebê vai chegar, mais cedo ou mais tarde."

# game/scripts/c18/c18.rpy:2685
translate brazilian c18s003_Scarlett_12f7b571:

    # dap "A veces me dais mucha envidia. Después pienso en que voy a poder jugar con el bebé cuando [mc] apunte bien con sus soldaditos y se me pasa."
    dap "Às vezes vocês me deixam com muita inveja. Mas aí eu penso em como vou poder brincar com o bebê quando ele estiver acertando a mira com os soldadinhos de brinquedo, e a inveja passa."

# game/scripts/c18/c18.rpy:2686
translate brazilian c18s003_Scarlett_73953127:

    # dap "Ese test de embarazo podría haber sido el mejor regalo de cumpleaños que iba a recibir hoy."
    dap "Aquele teste de gravidez poderia ter sido o melhor presente de aniversário que eu ia receber hoje."

# game/scripts/c18/c18.rpy:2687
translate brazilian c18s003_Scarlett_fdd4419b:

    # mc "*Risa* Espero que no, pero ya tenemos una voluntaria para cambiar pañales cuando llegue el bebé, Scarlett."
    mc "*Risos* Espero que não, mas já temos uma voluntária para trocar as fraldas quando o bebê chegar, a Scarlett."

# game/scripts/c18/c18.rpy:2688
translate brazilian c18s003_Scarlett_3f97664c_1:

    # sca "*Risa* Creo que [dap] será la primera persona del mundo que se lea en profundidad el manual de los pañales y lo modifique para hacerlo más eficiente."
    sca "*Risos* Acho que [dap] será a primeira pessoa no mundo a ler o manual de fraldas em detalhes e modificá-lo para torná-lo mais eficiente."

# game/scripts/c18/c18.rpy:2689
translate brazilian c18s003_Scarlett_d0714078:

    # dap "¡Puagh! He dicho jugar con el bebé. *Risa* Los pañales son cosa vuestra. Pero sí que me leeré el manual."
    dap "Eca! Eu disse para brincar com o bebê. *Risos* As fraldas são sua responsabilidade. Mas eu vou ler o manual."

# game/scripts/c18/c18.rpy:2693
translate brazilian c18s003_convScar1_b2dbd1ed:

    # "Os fundís en un abrazo y un beso..."
    "Você se entrega a um abraço e um beijo..."

# game/scripts/c18/c18.rpy:2695
translate brazilian c18s003_convScar1_3527cb31:

    # "Pero es un beso dubitativo. Algo le pasa a Scarlett."
    "Mas é um beijo hesitante. Algo está errado com Scarlett."

# game/scripts/c18/c18.rpy:2699
translate brazilian c18s003_convScar2_744507d3:

    # dap "Díselo. Lo va a entender."
    dap "Diga a ele. Ele vai entender."

# game/scripts/c18/c18.rpy:2700
translate brazilian c18s003_convScar2_eb04d957:

    # mc "¿Qué me estáis ocultando? Habíamos quedado en hablarlo todo, ¿no?"
    mc "O que você está escondendo de mim? Nós combinamos de conversar sobre tudo, não é?"

# game/scripts/c18/c18.rpy:2704
translate brazilian c18s003_convScar3_9ed741bb:

    # sca "[dap] y yo hemos estado hablando sobre qué pasaría si salía positivo..."
    sca "[dap] e eu estávamos conversando sobre o que aconteceria se meu teste desse positivo..."

# game/scripts/c18/c18.rpy:2708
translate brazilian c18s003_convScar4_6c7fc95b:

    # dap "Yo le he dicho que la endogamia en primera generación no tiene prácticamente riesgos."
    dap "Eu lhe disse que a endogamia na primeira geração praticamente não apresenta riscos."

# game/scripts/c18/c18.rpy:2709
translate brazilian c18s003_convScar4_cefa98c1:

    # mc "¿De qué riesgos estamos hablando?"
    mc "De que riscos estamos falando?"

# game/scripts/c18/c18.rpy:2711
translate brazilian c18s003_convScar4_046926f6:

    # dap "Negligibles. Los riesgos aumentan a partir de la tercera generación endogámica."
    dap "Negligenciável. Os riscos aumentam a partir da terceira geração consanguínea."

# game/scripts/c18/c18.rpy:2712
translate brazilian c18s003_convScar4_ec7530ee:

    # dap "Cuarta en vuestro caso ya que solo seríais medio hermanos. Si es que lo sois."
    dap "Quarto, no seu caso, já que vocês seriam apenas meio-irmãos. Se de fato forem."

# game/scripts/c18/c18.rpy:2714
translate brazilian c18s003_convScar4_4299d6b8:

    # sca "Lo sé, pero eso no hace que me vaya a preocupar menos..."
    sca "Eu sei, mas isso não diminui em nada minha preocupação..."

# game/scripts/c18/c18.rpy:2715
translate brazilian c18s003_convScar4_03de3da7:

    # mc "¿No crees que vas un poco rápido con las preocupaciones?"
    mc "Você não acha que está se deixando levar um pouco pelas suas preocupações?"

# game/scripts/c18/c18.rpy:2717
translate brazilian c18s003_convScar4_aad0753a:

    # sca "¿A qué te refieres?"
    sca "O que você está falando?"

# game/scripts/c18/c18.rpy:2718
translate brazilian c18s003_convScar4_de74ba43:

    # mc "A que aún no sabemos si somos medio hermanos. Creo que no vale la pena preocuparse por los \"qué pasaría si...?\" hasta que no tengamos los resultados."
    mc "Acho que ainda não sabemos se somos meio-irmãos. Não acho que valha a pena se preocupar com as hipóteses até termos os resultados."

# game/scripts/c18/c18.rpy:2720
translate brazilian c18s003_convScar4_597f5b22:

    # sca "Tienes razón... pero hay otro tema."
    sca "Você tem razão... mas há outra questão."

# game/scripts/c18/c18.rpy:2721
translate brazilian c18s003_convScar4_3b916da8:

    # mc "¿Qué pasa?"
    mc "O que está acontecendo?"

# game/scripts/c18/c18.rpy:2725
translate brazilian c18s003_convScar5_d66f3c0c:

    # dap "No te enfades. Ponte en su situación e intenta entenderlo."
    dap "Não fique com raiva. Coloque-se no lugar deles e tente compreendê-los."

# game/scripts/c18/c18.rpy:2726
translate brazilian c18s003_convScar5_8f035388:

    # mc "Me estáis preocupando."
    mc "Você está me preocupando."

# game/scripts/c18/c18.rpy:2728
translate brazilian c18s003_convScar5_bd72010a:

    # sca "Yo he crecido sin padre. Sé que tú no vas a ser un padre ausente."
    sca "Cresci sem pai. Sei que você não será um pai ausente."

# game/scripts/c18/c18.rpy:2729
translate brazilian c18s003_convScar5_f5e0ccce:

    # mc "No tengo intención de serlo."
    mc "Não tenho nenhuma intenção de ser um deles."

# game/scripts/c18/c18.rpy:2731
translate brazilian c18s003_convScar5_6d33c75d:

    # sca "También he crecido prácticamente sin mis abuelos. Vosotros teníais a Olivia."
    sca "Eu também cresci praticamente sem meus avós. Você tinha a Olivia."

# game/scripts/c18/c18.rpy:2732
translate brazilian c18s003_convScar5_65f9676b:

    # mc "Sí..."
    mc "Sim..."

# game/scripts/c18/c18.rpy:2736
translate brazilian c18s003_convScar6_7ee326ec:

    # mc "¿Te das cuenta de lo complicado que sería eso si somos medio hermanos?"
    mc "Você tem noção de quão complicado isso seria se fôssemos meio-irmãos?"

# game/scripts/c18/c18.rpy:2737
translate brazilian c18s003_convScar6_585decf3:

    # mc "Papá, tu hija y yo vamos a tener un hijo juntos. Cuando nos acostamos no sabíamos que éramos hermanos porque eres un pedazo de mierda que guardó el secreto."
    mc "Pai, eu e sua filha vamos ter um filho juntos. Quando dormimos juntos, não sabíamos que éramos irmãos porque você, seu filho da puta, manteve isso em segredo."

# game/scripts/c18/c18.rpy:2739
translate brazilian c18s003_convScar6_36bbd1de:

    # mc "Para eso debería saber cómo contactar con él."
    mc "Para isso, eu precisaria saber como contatá-lo."

# game/scripts/c18/c18.rpy:2740
translate brazilian c18s003_convScar6_46f8fa92:

    # mc "Pero sí. Lo entiendo."
    mc "Mas sim. Eu entendo."

# game/scripts/c18/c18.rpy:2742
translate brazilian c18s003_convScar6_a73a3968:

    # sca "Entonces... ¿no te importaría decírselo a mi madre?"
    sca "Então... você se importaria de contar para minha mãe?"

# game/scripts/c18/c18.rpy:2743
translate brazilian c18s003_convScar6_b849e252:

    # mc "Es tu madre. Haremos con ella lo que creas conveniente."
    mc "Ela é sua mãe. Faremos com ela o que você achar melhor."

# game/scripts/c18/c18.rpy:2746
translate brazilian c18s003_convScar7_8b5854e6:

    # mc "Creo que después de la interpretación de Amanda en tu antigua casa, deberíamos esperar un tiempo antes de ver a tu madre y a Kevin."
    mc "Acho que, depois da apresentação da Amanda na sua antiga casa, devemos esperar um pouco antes de visitar sua mãe e o Kevin."

# game/scripts/c18/c18.rpy:2747
translate brazilian c18s003_convScar7_31debc5f:

    # mc "Ellos creen que se me llevó detenido."
    mc "Eles acreditam que eu fui detido."

# game/scripts/c18/c18.rpy:2749
translate brazilian c18s003_convScar7_11ab8539:

    # "Scarlett se lanza a tus brazos de nuevo. Esta vez, las dudas han desaparecido."
    "Scarlett se atira em seus braços novamente. Desta vez, as dúvidas desapareceram."

# game/scripts/c18/c18.rpy:2751
translate brazilian c18s003_convScar7_12572bd7:

    # sca "Gracias por ser comprensivo, mi amor. Sé que no se lo merece, pero es mi madre al fin y al cabo."
    sca "Obrigada por ser compreensiva, meu amor. Eu sei que ela não merece isso, mas afinal, ela é minha mãe."

# game/scripts/c18/c18.rpy:2755
translate brazilian c18s003_convScar8_1515fd35:

    # mc "Pero si aparece Kevin no puedo asegurar que no le vaya a volver a pegar."
    mc "Mas se o Kevin aparecer, não posso garantir que ele não o agrida novamente."

# game/scripts/c18/c18.rpy:2758
translate brazilian c18s003_convScar8_2579666c:

    # sca "*Risa* Siempre podemos mandar a Amanda para que lo detenga antes de reunirnos con mi madre."
    sca "*Risos* Sempre podemos mandar a Amanda para impedi-lo antes de nos encontrarmos com a minha mãe."

# game/scripts/c18/c18.rpy:2759
translate brazilian c18s003_convScar8_53608814:

    # mc "*Risa* No estaría mal. Nada mal."
    mc "*Risos* Isso não seria ruim. Nada ruim mesmo."

# game/scripts/c18/c18.rpy:2761
translate brazilian c18s003_convScar8_d898854b:

    # dap "Ahora que todo está resuelto y os volvéis a reír... ¿puedo decir algo?"
    dap "Agora que tudo está resolvido e vocês estão todos rindo de novo... posso dizer uma coisa?"

# game/scripts/c18/c18.rpy:2762
translate brazilian c18s003_convScar8_bafc5879:

    # mc "Claro que sí, [dap]."
    mc "Claro, [dap]."

# game/scripts/c18/c18.rpy:2765
translate brazilian c18s003_convScar9_b3b94564:

    # todas "*Risa*"
    todas "*Risada*"

# game/scripts/c18/c18.rpy:2766
translate brazilian c18s003_convScar9_35b894b1:

    # mc "Ven aquí, Tía [dap]."
    mc "Venha cá, tia [dap]."

# game/scripts/c18/c18.rpy:2768
translate brazilian c18s003_convScar9_1ecfcb46:

    # "Los tres os fundís en un abrazo de alegría compartida."
    "Vocês três se abraçam em um gesto de alegria compartilhada."

# game/scripts/c18/c18.rpy:2811
translate brazilian c18s004_Meemaw_9e8c0dca:

    # "Al volver a tu habitación te encuentras con Olivia esperándote."
    "Ao retornar ao seu quarto, você encontra Olivia esperando por você."

# game/scripts/c18/c18.rpy:2812
translate brazilian c18s004_Meemaw_b94bea67:

    # "Tiene mejor aspecto que estos últimos días. Supones que los efectos de la quimio están desapareciendo, aún le queda un poco para volver a ser ella misma."
    "Ela parece melhor do que nos últimos dias. Imagino que os efeitos da quimioterapia estejam passando, mas ainda falta um pouco para ela voltar a ser como era antes."

# game/scripts/c18/c18.rpy:2813
translate brazilian c18s004_Meemaw_d43a9ef9:

    # mc "Buenos días, Meemaw."
    mc "Bom dia, vovó."

# game/scripts/c18/c18.rpy:2814
translate brazilian c18s004_Meemaw_b864994b:

    # mee "¿No tengo beso de buenos días hoy?"
    mee "Não ganho um beijo de bom dia hoje?"

# game/scripts/c18/c18.rpy:2815
translate brazilian c18s004_Meemaw_2ffe26d0:

    # mc "No hace falta que lo pidas, puedes darlo tú si quieres."
    mc "Você não precisa pedir, pode dar se quiser."

# game/scripts/c18/c18.rpy:2817
translate brazilian c18s004_Meemaw_1d9369de:

    # mee "Buenos días, [mc]."
    mee "Bom dia, [mc]."

# game/scripts/c18/c18.rpy:2818
translate brazilian c18s004_Meemaw_47d83ec6:

    # mc "Buenos días, Meemaw. ¿Puedo ayudarte en algo?"
    mc "Bom dia, vovó. Posso te ajudar em alguma coisa?"

# game/scripts/c18/c18.rpy:2820
translate brazilian c18s004_Meemaw_497799c5:

    # mee "Si tienes un rato libre..."
    mee "Se você tiver algum tempo livre..."

# game/scripts/c18/c18.rpy:2821
translate brazilian c18s004_Meemaw_a1d53a70:

    # mc "Siempre tengo tiempo libre para ti."
    mc "Eu sempre tenho tempo livre para você."

# game/scripts/c18/c18.rpy:2823
translate brazilian c18s004_Meemaw_dcfc3356:

    # mee "¿Puedes ayudarme con el masaje hoy?"
    mee "Você pode me ajudar com a massagem hoje?"

# game/scripts/c18/c18.rpy:2824
translate brazilian c18s004_Meemaw_e67314ce:

    # mc "¿No te gustó cómo lo hizo Tía Betty ayer?"
    mc "Você não gostou do que a tia Betty fez ontem?"

# game/scripts/c18/c18.rpy:2826
translate brazilian c18s004_Meemaw_214d3a01:

    # mee "No es por eso. Hoy es domingo y ha ido a misa. Además tenía que hablar con el cura de algo, la llamó ayer."
    mee "Não é isso. Hoje é domingo e ela foi à missa. Além disso, ela precisava conversar com o padre sobre algo; ele ligou para ela ontem."

# game/scripts/c18/c18.rpy:2827
translate brazilian c18s004_Meemaw_a6010a83:

    # mc "Ah, OK. Perfecto. ¿Dónde lo quieres hacer? ¿Aquí?"
    mc "Ah, ok. Perfeito. Onde você quer fazer isso? Aqui?"

# game/scripts/c18/c18.rpy:2830
translate brazilian c18s004_Meemaw_c83f66de:

    # mee "Sí, aquí mismo va bien. Me he extraído la leche en casa de [nor] hace un momento."
    mee "Sim, funciona perfeitamente aqui. Acabei de dar uma passada na casa do [nor]."

# game/scripts/c18/c18.rpy:2832
translate brazilian c18s004_Meemaw_b911d7d9:

    # "Haces el masaje a Olivia tal y como te enseñó la Doctora Milk y vuelve a su habitación. Cada vez está más cómoda a tu alrededor con poca ropa."
    "Você massageia Olivia exatamente como o Dr. Milk lhe ensinou, e ela retorna ao seu quarto. Ela está ficando cada vez mais à vontade perto de você, usando pouca roupa."

# game/scripts/c18/c18.rpy:2835
translate brazilian c18s004_Meemaw_034a5c81:

    # mee "Creo que el mejor sitio sería un baño. Por si... ya sabes."
    mee "Acho que o melhor lugar seria um banheiro. Só por precaução... sabe como é."

# game/scripts/c18/c18.rpy:2836
translate brazilian c18s004_Meemaw_2d1f65ab:

    # mc "Bueno, parece que sólo pasó en la consulta de la Doctora Milk. Ayer, mientras le enseñaba a Tía Betty, no pasó nada."
    mc "Bem, parece que isso só aconteceu no consultório do Dr. Milk. Ontem, enquanto eu dava aula para a tia Betty, nada aconteceu."

# game/scripts/c18/c18.rpy:2837
translate brazilian c18s004_Meemaw_fc673ed5:

    # mc "¿Te volvió a pasar cuando me fui y la dejé haciéndote el masaje?"
    mc "Aconteceu de novo quando eu saí e ela estava te fazendo a massagem?"

# game/scripts/c18/c18.rpy:2839
translate brazilian c18s004_Meemaw_8479a78d:

    # mee "No, no... no pasó nada. Estoy empezando a pensar que quizás la Doctora no extrajo toda la leche."
    mee "Não, não... não aconteceu nada. Estou começando a achar que talvez o médico não tenha extraído todo o leite."

# game/scripts/c18/c18.rpy:2840
translate brazilian c18s004_Meemaw_cf2d905d:

    # mc "Meemaw... yo creo que sí que lo hizo bien. Una de las razones que dio para que pasara lo que pasó es que hubiera excitación sexual."
    mc "Vovó... Acho que ele fez a coisa certa. Uma das razões que ele deu para o que aconteceu foi que houve excitação sexual."

# game/scripts/c18/c18.rpy:2841
translate brazilian c18s004_Meemaw_acc44f73:

    # mc "Y los dos sabemos que la hubo."
    mc "E nós dois sabemos que houve um."

# game/scripts/c18/c18.rpy:2843
translate brazilian c18s004_Meemaw_80bc16e1:

    # mee "No me lo recuerdes... ¡Qué vergüenza! Tener un orgasmo mientras mi nieto me masajeaba los pechos..."
    mee "Nem me lembre... Que vergonha! Ter um orgasmo enquanto meu neto massageava meus seios..."

# game/scripts/c18/c18.rpy:2844
translate brazilian c18s004_Meemaw_d8e0a824:

    # mc "No le des más importancia de la que tiene. Pasó y ya está. Ayer no pasó, con lo que lo podemos dejar como un incidente aislado."
    mc "Não faça disso um problema maior do que realmente é. Aconteceu, só isso. Não aconteceu ontem, então podemos considerar um incidente isolado."

# game/scripts/c18/c18.rpy:2845
translate brazilian c18s004_Meemaw_27208654:

    # mc "Supongo que no volverá a pasar lo mismo, con lo que no hay peligro para el parqué."
    mc "Suponho que a mesma coisa não voltará a acontecer, portanto não há perigo para o mercado."

# game/scripts/c18/c18.rpy:2847
translate brazilian c18s004_Meemaw_35ee814b:

    # mee "Cómo quieras, pero no te quejes si después tienes que fregar tu habitación. *Risa*"
    mee "Faça o que quiser, mas não reclame se tiver que limpar o quarto depois. *Risos*"

# game/scripts/c18/c18.rpy:2848
translate brazilian c18s004_Meemaw_f8254cc8:

    # mc "*Risa* Si tengo que fregar la habitación significará que lo has disfrutado, con lo que no me quejaré."
    mc "*Risos* Se eu tiver que limpar o quarto, significa que você gostou, então não vou reclamar."

# game/scripts/c18/c18.rpy:2850
translate brazilian c18s004_Meemaw_e10117ec:

    # mee "¡[mc]!"
    mee "[mc]!"

# game/scripts/c18/c18.rpy:2851
translate brazilian c18s004_Meemaw_827bfdfa:

    # mc "¿Qué? Si vuelve a pasar lo mismo..."
    mc "O quê? Se a mesma coisa acontecer de novo..."

# game/scripts/c18/c18.rpy:2853
translate brazilian c18s004_Meemaw_e8829b92:

    # mee "No va a pasar. Punto."
    mee "Isso não vai acontecer. Ponto final."

# game/scripts/c18/c18.rpy:2854
translate brazilian c18s004_Meemaw_4aa3eb3f:

    # mc "OK. Déjame quitarme la ropa... tan solo para prevenir. Puedes dejar el albornoz en la silla."
    mc "Certo. Deixe-me tirar a roupa... só por precaução. Pode deixar seu roupão na cadeira."

# game/scripts/c18/c18.rpy:2856
translate brazilian c18s004_Meemaw_7e971260:

    # mee "{b}¿Qué?{/b} ¿Vas a desnudarte?"
    mee "{b}O quê?{/b} Você vai ficar nu?"

# game/scripts/c18/c18.rpy:2857
translate brazilian c18s004_Meemaw_e9694807:

    # mc "No, Meemaw, sólo voy a quitarme los pantalones y la camiseta. Ya te digo que es solo para prevenir."
    mc "Não, vovó, eu só estou tirando a calça e a camisa. Como eu disse, é só por precaução."

# game/scripts/c18/c18.rpy:2858
translate brazilian c18s004_Meemaw_3ef8b6a8:

    # mc "Tengo que ir a buscar a Maddie cuando acabemos con esto, y no quiero ir con manchas lácteas. *Risa*"
    mc "Tenho que ir buscar a Maddie quando terminarmos, e não quero ir com manchas de leite. *Risos*"

# game/scripts/c18/c18.rpy:2860
translate brazilian c18s004_Meemaw_add0794e:

    # mee "Vale... Has dicho que lo deje en la silla, ¿no?"
    mee "Certo... Você disse para deixar na cadeira, não é?"

# game/scripts/c18/c18.rpy:2861
