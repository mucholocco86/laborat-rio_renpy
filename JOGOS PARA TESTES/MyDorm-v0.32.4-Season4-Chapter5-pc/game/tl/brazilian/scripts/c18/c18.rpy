# game/scripts/c18/c18.rpy:1147
translate brazilian c18s001_Debbie_adac0119:

    # deb "Sí, pero no va a pasar..."
    deb "Sim, mas isso não vai acontecer..."

# game/scripts/c18/c18.rpy:1149
translate brazilian c18s001_Debbie_8c443165:

    # deb "[mc]... ¿Me estás tocando el culo? *Risa*"
    deb "[mc]... Você está tocando na minha bunda? *Risos*"

# game/scripts/c18/c18.rpy:1150
translate brazilian c18s001_Debbie_d6b5d353:

