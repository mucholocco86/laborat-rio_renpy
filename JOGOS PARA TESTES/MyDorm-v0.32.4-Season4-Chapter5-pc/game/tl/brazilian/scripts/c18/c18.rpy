# game/scripts/c18/c18.rpy:1287
translate brazilian c18s001_Amanda_2beedcb0:

    # ama "Yo las conozco. Ellas aún no saben cómo soy. Al menos ya se están acabando las preguntas... raras."
    ama "Eu os conheço. Eles ainda não sabem como eu sou. Pelo menos as perguntas estranhas estão começando a diminuir."

# game/scripts/c18/c18.rpy:1288
translate brazilian c18s001_Amanda_44b08d8e:

    # mc "¿Os han hecho muchas? ¿Me puedes poner un ejemplo de una de esas preguntas raras?"
    mc "Você já recebeu muitas dessas perguntas? Pode me dar um exemplo de uma dessas perguntas estranhas?"

# game/scripts/c18/c18.rpy:1290
translate brazilian c18s001_Amanda_2945c2c8:

    # ama "La más rara hasta ahora ha sido sobre si teníamos sexo con los clones XY."
    ama "A mais estranha até agora foi sobre se tivemos relações sexuais com os clones XY."

# game/scripts/c18/c18.rpy:1291
translate brazilian c18s001_Amanda_49a8fb26:

    # mc "*Risa* Esa ha sido [emm], seguro. No sé si quiero saber la respuesta."
    mc "*Risos* Isso foi [emm], com certeza. Não sei se quero saber a resposta."

# game/scripts/c18/c18.rpy:1293
translate brazilian c18s001_Amanda_bf4cd3cc:

    # ama "¿No saber la respuesta a si ha sido [emm] o a la pregunta? *Risa*"
    ama "Não saber a resposta para a pergunta se era [emm] ou para a própria pergunta? *Risos*"

# game/scripts/c18/c18.rpy:1294
translate brazilian c18s001_Amanda_2068deef:

    # mc "A la pregunta."
    mc "Respondendo à pergunta."

# game/scripts/c18/c18.rpy:1295
translate brazilian c18s001_Amanda_af5c850c:

    # ama "Entonces te alegrará saber que no ha sido [emm]. Y la respuesta ha sido No. Pero no me preguntes quién ha sido. Era una conversación de chicas."
