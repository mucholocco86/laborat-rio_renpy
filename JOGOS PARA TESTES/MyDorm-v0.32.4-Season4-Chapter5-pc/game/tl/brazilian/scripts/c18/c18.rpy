# game/scripts/c18/c18.rpy:1143
translate brazilian c18s001_Debbie_c106c256:

    # mc "*Risa* Bien visto. Yo tampoco soy un gran bailarín, pero... ¿bailarías conmigo si te puedo asegurar que no me vas a pisar?"
