# game/scripts/c18/c18.rpy:1314
translate brazilian c18s001_Amanda_65481d7a:

    # mc "NTR os estaba deshumanizando..."
    mc "NTR estava te desumanizando..."

# game/scripts/c18/c18.rpy:1316
translate brazilian c18s001_Amanda_0c2b58ea:

    # mc "Supongo que era más fácil para ellos hacerlo así que veros como personas. Como clones de su propia familia."
    mc "Suponho que para eles era mais fácil fazer assim do que enxergar vocês como pessoas. Como clones da própria família."

# game/scripts/c18/c18.rpy:1319
translate brazilian c18s001_Amanda_b5da0eb9:

    # mc "Sin embargo, les pusieron nombres a [emm], [dap], y [eri]."
    mc "No entanto, eles deram nomes a [emm], [dap] e [eri]."

# game/scripts/c18/c18.rpy:1321
translate brazilian c18s001_Amanda_435f2653:

    # ama "Los nombres se los pusieron cuando las sacaron del laboratorio. No podían presentarle a [mar] una niña y decirle que se llamaba Experimento XX-0-A. Prefirieron llamarla [emm]."
    ama "Eles deram nomes a elas quando as tiraram do laboratório. Não podiam apresentar [mar] a uma garota e dizer que seu nome era Experimento XX-0-A. Preferiram chamá-la de [emm]."

# game/scripts/c18/c18.rpy:1322
translate brazilian c18s001_Amanda_f588893a:

    # ama "Querían estudiar cómo ellas y nosotras nos desarrollábamos diferente al estar en la base o el mundo exterior, con una familia normal."
    ama "Eles queriam estudar como eles e nós nos desenvolvíamos de forma diferente quando estávamos na base militar ou no mundo exterior, com uma família normal."

# game/scripts/c18/c18.rpy:1323
translate brazilian c18s001_Amanda_a7ea8669:

