    ama "Eu. O Grupo A saiu do tanque antes do Grupo B. Tecnicamente, eu \"nasci\" dois dias antes de Eva."

# game/scripts/c18/c18.rpy:1305
translate brazilian c18s001_Amanda_63ded428:

    # ama "Yo. Por dos días."
    ama "Eu. Por dois dias."

# game/scripts/c18/c18.rpy:1306
translate brazilian c18s001_Amanda_6a5cc27f:

