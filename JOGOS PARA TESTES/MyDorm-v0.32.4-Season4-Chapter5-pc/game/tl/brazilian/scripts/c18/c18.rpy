

# game/scripts/c18/c18.rpy:278
translate brazilian c18s001_Dinner_1a5439ac:

    # "El beso continúa unos segundos más antes de que Eva se separe."
    "O beijo continua por mais alguns segundos antes de Eva se afastar."

# game/scripts/c18/c18.rpy:280
translate brazilian c18s001_Dinner_2014e024:

    # mc "¿Sigues comprobando si voy a cortar el beso por ser demasiado largo? *Risa*"
    mc "Você ainda está checando se eu vou interromper o beijo porque está demorando demais? *Risos*"

# game/scripts/c18/c18.rpy:281
translate brazilian c18s001_Dinner_7bbe8b15:

    # eva "¿Yoooo? ¿Cómo puedes pensar eso de mí? *Risita*"
    eva "Eu? Como você pôde pensar isso de mim? *Risos*"

# game/scripts/c18/c18.rpy:282
translate brazilian c18s001_Dinner_acd60833:

    # mc "Porque es lo que haría [emm] *Risa*"
    mc "Porque é isso que eu faria [emm] *Risos*"

# game/scripts/c18/c18.rpy:284
translate brazilian c18s001_Dinner_6d83f316:

    # eva "Bueno... si Amanda puede darte besos largos, ¿por qué no voy a poder yo? ¿O para mí sí que hay una duración de besos marcada?"
    eva "Bem... se a Amanda pode te dar beijos demorados, por que eu não posso? Ou será que existe uma duração limite para os meus beijos?"

# game/scripts/c18/c18.rpy:285
translate brazilian c18s001_Dinner_0b553d63:

    # eva "¿Ya es tu favorita?"
    eva "Já é o seu favorito?"

# game/scripts/c18/c18.rpy:286
translate brazilian c18s001_Dinner_b78de7ae:

    # mcp "(¿Estoy detectando una corriente de celos soterrada?)"
    mcp "(Será que estou percebendo uma corrente subterrânea de ciúme?)"

# game/scripts/c18/c18.rpy:287
translate brazilian c18s001_Dinner_d62e71aa:

    # mc "Eva, no hay ninguna duración de los besos, pero ese no es el espíritu. Es un saludo, no una competición."
    mc "Eva, não há limite de tempo definido para os beijos, mas esse não é o ponto. É uma saudação, não uma competição."

# game/scripts/c18/c18.rpy:289
translate brazilian c18s001_Dinner_b8db1b05:

    # eva "Todo en este mundo es una competición, [mc]."
    eva "Tudo neste mundo é uma competição, [mc]."

# game/scripts/c18/c18.rpy:290
translate brazilian c18s001_Dinner_179b2f81:

    # eva "¿Nos vamos? No quiero llegar tarde en mi primera cena."
    eva "Vamos? Não quero me atrasar para o meu primeiro jantar."

# game/scripts/c18/c18.rpy:291
translate brazilian c18s001_Dinner_e7f6c90f:

    # mc "Vamos. Llegamos con el tiempo un poco justo."
    mc "Vamos lá. Estamos um pouco atrasados."

# game/scripts/c18/c18.rpy:293
translate brazilian c18s001_Dinner_5680550e:

    # eva "Si me dejas conducir a mí, llegaremos a tiempo. Yo no conduzco como una abuela."
    eva "Se você me deixar dirigir, chegaremos na hora. Eu não dirijo como uma vovó."

# game/scripts/c18/c18.rpy:294
translate brazilian c18s001_Dinner_c459c8a2:

    # mc "Ni en broma. *Risa*"
    mc "Nem mesmo em tom de brincadeira. *Risos*"

# game/scripts/c18/c18.rpy:297
translate brazilian c18s001_Dinner_332998d7:

    # "Llegáis justo a tiempo. No conduces tan lento como Eva ha insinuado."
    "Você chegou na hora certa. Você não dirige tão devagar quanto Eva deu a entender."

# game/scripts/c18/c18.rpy:300
translate brazilian c18s001_Dinner_9758c43c:

    # "Las reacciones al ver entrar a Eva son de sorpresa absoluta."
    "As reações ao verem Eva entrar são de absoluta surpresa."

# game/scripts/c18/c18.rpy:301
translate brazilian c18s001_Dinner_1d672dcc:

    # "Todas las chicas se han arreglado, pero ninguna ha llegado al nivel de Eva."
    "Todas as meninas se arrumaram, mas nenhuma chegou ao nível de Eva."

# game/scripts/c18/c18.rpy:303
translate brazilian c18s001_Dinner_014cb3c8:

    # kat "¡Joder! Ahora sí que parezco una zarrapastrosa. Creo que me voy a ir a llorar a mi habitación. *Risa*"
    kat "Puxa! Agora eu realmente pareço um trapo. Acho que vou chorar no meu quarto. *Risos*"

# game/scripts/c18/c18.rpy:304
translate brazilian c18s001_Dinner_f514d41e:

    # sai "Todas lo parecemos. Eva, estás fantástica."
    sai "Todos nós estamos assim. Eva, você está fantástica."

# game/scripts/c18/c18.rpy:305
translate brazilian c18s001_Dinner_80e195bb:

    # emm "No está fantástica. {b}Es fantástica{/b}."
    emm "Não é fantástico. {b}É fantástico{/b}."

# game/scripts/c18/c18.rpy:306
translate brazilian c18s001_Dinner_e6fbda22:

    # mcp "(Lo cual te convierte en fantástica a ti, ¿no? *Risa mental*)"
    mcp "(O que te torna fantástico, não é? *Risos mentais*)"

# game/scripts/c18/c18.rpy:308
translate brazilian c18s001_Dinner_6859f5bd:

    # kim "Estás guapísima, Eva."
    kim "Você está deslumbrante, Eva."

# game/scripts/c18/c18.rpy:309
translate brazilian c18s001_Dinner_797fbd0d:

    # ama "Te he dicho un vestido bonito, ¡no ESE vestido! Vamos a ir a bailar, no a una cena en una embajada."
    ama "Eu te falei de um vestido bonito, não daquele vestido! Vamos dançar, não jantar numa embaixada."

# game/scripts/c18/c18.rpy:310
translate brazilian c18s001_Dinner_d92aef96:

    # dap "No hagas caso, Eva. Vas a ser la sensación del... del sitio al que vamos a ir."
    dap "Não dê ouvidos a eles, Eva. Você vai ser o assunto da cidade... do lugar para onde vamos."

# game/scripts/c18/c18.rpy:311
translate brazilian c18s001_Dinner_9eb841d6:

    # kim "Desde luego que sí. Lo serías incluso en la embajada de la que habla Amanda. *Risa*"
    kim "Com certeza. Você seria uma até mesmo na embaixada que a Amanda mencionou. *Risos*"

# game/scripts/c18/c18.rpy:313
translate brazilian c18s001_Dinner_371afd3d:

    # eri "Pues ya estamos casi todas."
    eri "Bem, quase todos nós estamos aqui agora."

# game/scripts/c18/c18.rpy:314
translate brazilian c18s001_Dinner_51ac705b:

    # mom "Sí, en cuanto lleguen el resto podemos empezar a cenar."
    mom "Sim, assim que os outros chegarem podemos começar o jantar."

# game/scripts/c18/c18.rpy:315
translate brazilian c18s001_Dinner_90e3203d:

    # nor "¡Qué envidia me dais las jóvenes!"
    nor "Tenho inveja de vocês, jovens mulheres!"

# game/scripts/c18/c18.rpy:316
translate brazilian c18s001_Dinner_9b26eadb:

    # mc "¿Vosotras no os habéis arreglado?"
    mc "Você ainda não se preparou?"

# game/scripts/c18/c18.rpy:318
translate brazilian c18s001_Dinner_1b2f3b3c:

    # nor "No, hoy es un día para las chicas y para ti. Nosotras nos quedaremos en casa después de un par de días ajetreados."
    nor "Não, hoje é um dia para as meninas e para você. Vamos ficar em casa depois de alguns dias agitados."

# game/scripts/c18/c18.rpy:320
translate brazilian c18s001_Dinner_c2bc9d65:

    # mom "Yo aún tengo que acabar algunas cosas que quiero que reposen para la comida de mañana."
    mom "Ainda tenho algumas coisas para terminar e quero que estejam prontas para o almoço de amanhã."

# game/scripts/c18/c18.rpy:322
translate brazilian c18s001_Dinner_24e9c147:

    # dap "Yo he intentado convencerlas, pero todas han puesto alguna excusa."
    dap "Tentei convencê-los, mas todos deram alguma desculpa."

# game/scripts/c18/c18.rpy:324
translate brazilian c18s001_Dinner_09375bce:

    # emm "Ya sabéis cómo es esto. Llegas a los 25 y ya no quieres salir a bailar."
    emm "Você sabe como é. Você chega aos 25 anos e não quer mais sair para dançar."

# game/scripts/c18/c18.rpy:325
translate brazilian c18s001_Dinner_ea0646d3:

    # emm "Aunque quizás la edad no tiene que ver. Ni siquiera Alexia o Simone han querido venir. Mañana tienen que madrugar las dos."
    emm "Embora talvez a idade não seja o problema. Nem Alexia nem Simone quiseram vir. Ambas têm que acordar cedo amanhã."

# game/scripts/c18/c18.rpy:327
translate brazilian c18s001_Dinner_b0e5cf42:

    # dap "No es que no hayan querido. Lexi se ha pasado patrullando todo el día."
    dap "Não é que eles não quisessem. Lexi passou o dia inteiro patrulhando."

# game/scripts/c18/c18.rpy:328
translate brazilian c18s001_Dinner_68f8c0d3:

    # mcp "(¿Lexi? Eso es nuevo.)"
    mcp "(Lexi? Essa é nova.)"

# game/scripts/c18/c18.rpy:329
translate brazilian c18s001_Dinner_dbf3a83b:

    # mc "Entonces, ¿quiénes vamos a ir a lo que sea que vayamos a ir?"
    mc "Então, quem vai participar daquele evento para o qual vamos?"

# game/scripts/c18/c18.rpy:331
translate brazilian c18s001_Dinner_d685d370:

    # kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, yo y... y yo. A mí me cuento doble porque abulto por dos. *Risa*"
    kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, eu, e... e eu. Eu me conto duas vezes porque tenho o dobro do tamanho. *Risos*"

# game/scripts/c18/c18.rpy:332
translate brazilian c18s001_Dinner_94068f58:

    # kat "Eileen decidirá cuando acabe de trabajar, por si está muy cansada."
    kat "Eileen decidirá quando terminar o trabalho, caso esteja muito cansada."

# game/scripts/c18/c18.rpy:333
translate brazilian c18s001_Dinner_cbbde96e:

    # mc "Somos doce o trece entonces. Necesitaremos los tres coches."
    mc "Então seremos doze ou treze. Precisaremos dos três carros."

# game/scripts/c18/c18.rpy:335
translate brazilian c18s001_Dinner_e276d1ad:

    # ama "Yo puedo conducir uno de los coches, si queréis."
    ama "Posso dirigir um dos carros, se você quiser."

# game/scripts/c18/c18.rpy:337
translate brazilian c18s001_Dinner_de32ddfe:

    # eri "Yo conduciré el otro. Después de la última vez que salimos, hoy no pienso beber. *Risa*"
    eri "Eu dirijo o outro. Depois do nosso último passeio, não vou beber hoje à noite. *Risos*"

# game/scripts/c18/c18.rpy:339
translate brazilian c18s001_Dinner_15310c14:

    # eva "A veces me alegra que viváis en California. En cualquier otro estado solo [mc] y Eileen podrían beber."
    eva "Às vezes fico feliz que vocês morem na Califórnia. Em qualquer outro estado, só o C4 e a Eileen poderiam beber."

# game/scripts/c18/c18.rpy:340
translate brazilian c18s001_Dinner_5068d387:

    # eva "Suerte que Arnold cambió esa ley absurda. Os podéis alistar en el ejército y matar gente en nombre de vuestro país con 18 pero no beber hasta los 21."
    eva "Graças a Deus que Arnold mudou essa lei absurda. Você pode se alistar no exército e matar pessoas em nome do seu país aos 18 anos, mas não pode beber até os 21."

# game/scripts/c18/c18.rpy:342
translate brazilian c18s001_Dinner_2c6c3e94:

    # ama "O conducir a los 16..."
    ama "Ou dirigir aos 16 anos..."

# game/scripts/c18/c18.rpy:344
translate brazilian c18s001_Dinner_7e3da0f9:

    # kim "Hay muchas razones para eso, chicas..."
    kim "Existem muitas razões para isso, meninas..."

# game/scripts/c18/c18.rpy:346
translate brazilian c18s001_Dinner_f93664d8:

    # "Empieza una conversación sobre las implicaciones de beber alcohol a diversas edades que se alarga durante la cena."
    "Inicia-se uma conversa sobre as implicações do consumo de álcool em diferentes faixas etárias e ela se estende por todo o jantar."

# game/scripts/c18/c18.rpy:347
translate brazilian c18s001_Dinner_34df7fe0:

    # "[emm] ve bien que dejen beber a los 18. Si eres responsable para votar, también lo debes ser para beber. Ella nunca votaría a un gobernador que quisiera quitarle ese derecho."
    "[emm] Ela acha ótimo que permitam que jovens de 18 anos bebam. Se você é responsável o suficiente para votar, também deveria ser responsável o suficiente para beber. Ela jamais votaria em um governador que quisesse tirar esse direito dela."

# game/scripts/c18/c18.rpy:348
translate brazilian c18s001_Dinner_6b9a024e:

    # "[eri] es un poco más ambivalente. Su última experiencia con el alcohol le hace ser más prudente."
    "[eri] é um pouco mais ambivalente. Sua última experiência com álcool o torna mais cauteloso."

# game/scripts/c18/c18.rpy:349
translate brazilian c18s001_Dinner_22e59bec:

    # "[mar] y [nor], y más tarde Meemaw y Kiara, creen que devolver la edad para beber a los 21 sería lo correcto."
    "[mar] e [nor], e mais tarde Meemaw e Kiara, acreditam que retornar a idade mínima para consumo de bebidas alcoólicas para 21 anos seria a coisa certa a fazer."

# game/scripts/c18/c18.rpy:350
translate brazilian c18s001_Dinner_51783b5f:

    # "Ninguna de ellas pudo beber legalmente hasta los 21 y no creen que les haya perjudicado."
    "Nenhum deles podia beber legalmente até completar 21 anos e não acreditam que isso lhes tenha prejudicado."

# game/scripts/c18/c18.rpy:351
translate brazilian c18s001_Dinner_1cb834ff:

    # "Eva y Amanda hablan de cuando estuvieron en una misión en Burkina Faso con 14 años y pudieron beber alcohol con normalidad."
    "Eva e Amanda contam sobre a época em que estavam em missão em Burkina Faso, aos 14 anos, e podiam consumir bebidas alcoólicas normalmente."

# game/scripts/c18/c18.rpy:352
translate brazilian c18s001_Dinner_19bda271:

    # "Eva se emborrachó."
    "Eva ficou bêbada."

# game/scripts/c18/c18.rpy:353
translate brazilian c18s001_Dinner_58751903:

    # "Pero lo consideran una buena experiencia que les permitió empezar a conocer sus límites."
    "Mas eles consideram isso uma boa experiência que lhes permitiu começar a aprender sobre seus limites."

# game/scripts/c18/c18.rpy:354
translate brazilian c18s001_Dinner_8ddf32b1:

    # "Betty considera que 16 debería ser suficiente para empezar a beber cerveza y vino, y 18 para licores. Sus experiencias en África han moldeado sus opiniones."
    "Betty acredita que 16 anos já é idade suficiente para começar a beber cerveja e vinho, e 18 para bebidas destiladas. Suas experiências na África moldaram suas opiniões."

# game/scripts/c18/c18.rpy:355
translate brazilian c18s001_Dinner_117dd69b:

    # "El resto de las chicas no tienen una opinión muy estricta en esto. Ven ventajas y desventajas en las diferentes edades."
    "As outras meninas não têm uma opinião muito rígida sobre isso. Elas veem vantagens e desvantagens nas diferentes faixas etárias."

# game/scripts/c18/c18.rpy:356
translate brazilian c18s001_Dinner_bd0bd8c0:

    # "Cuando ya no queda comida en los platos, el Under de Megan llega para llevarla al trabajo."
    "Quando não há mais comida nos pratos, o motorista da van de Megan chega para levá-la ao trabalho."

# game/scripts/c18/c18.rpy:357
translate brazilian c18s001_Dinner_df7018af:

    # "Las diferentes conversaciones continúan durante poco menos de una hora más, hasta que llega Eileen, que dice estar muy cansada para ir a bailar."
    "As diversas conversas continuam por pouco menos de uma hora, até que Eileen chega, dizendo que está muito cansada para ir dançar."

# game/scripts/c18/c18.rpy:359
translate brazilian c18s001_Dinner_c3fc4b3d:

    # sai "Nos deberíamos ir yendo o se hará muy tarde, ¿no?"
    sai "É melhor irmos embora ou vai ficar muito tarde, não é?"

# game/scripts/c18/c18.rpy:360
translate brazilian c18s001_Dinner_d45706dd:

    # mc "Cuando queráis. Pero me tendréis que decir dónde vamos, si tengo que conducir yo."
    mc "Quando você quiser. Mas você terá que me dizer para onde vamos se eu tiver que dirigir."

# game/scripts/c18/c18.rpy:362
translate brazilian c18s001_Dinner_f2d7f480:

    # lis "Bueno, vamos a ir al Jazz Corner, donde trabaja Megan."
    lis "Ok, vamos para o Jazz Corner, onde a Megan trabalha."

# game/scripts/c18/c18.rpy:363
translate brazilian c18s001_Dinner_16829b31:

    # mc "Ah, OK. Sé dónde está. ¿Y ese era todo el secretismo?"
    mc "Ah, entendi. Já sei onde fica. E era só isso de segredo?"

# game/scripts/c18/c18.rpy:365
translate brazilian c18s001_Dinner_1623422f:

    # dap "No es que fuera secretismo, es que queríamos atar un par de cosas antes de ir."
    dap "Não se tratava de segredo, apenas queríamos resolver algumas pendências antes de irmos."

# game/scripts/c18/c18.rpy:366
translate brazilian c18s001_Dinner_3824888d:

    # dap "Nadie había reservado la sala anexa hoy, y Megan ha conseguido que nos la dejen para nosotros."
    dap "Ninguém havia reservado o quarto ao lado hoje, e Megan conseguiu reservá-lo para nós."

# game/scripts/c18/c18.rpy:367
translate brazilian c18s001_Dinner_e0900dec:

    # dap "Si no hubiéramos podido cogerla, una mesa para doce o trece hubiera sido difícil de conseguir y hubiéramos ido al Twins."
    dap "Se não tivéssemos conseguido, uma mesa para doze ou treze pessoas teria sido difícil de arranjar e teríamos ido ao Twins."

# game/scripts/c18/c18.rpy:368
translate brazilian c18s001_Dinner_aa6fe3a4:

    # mc "Pero una sala para nosotros en un local así tiene que salir carísima, ¿no?"
    mc "Mas um quarto para nós num lugar desses deve ser incrivelmente caro, não é?"

# game/scripts/c18/c18.rpy:370
translate brazilian c18s001_Dinner_9d8ff7a1:

    # emm "Son las ventajas de conocer a la cantante titular. *Risa* Nos la ha conseguido gratis, pero tendremos que ir a la barra de la sala principal a por las copas."
    emm "Essa é uma das vantagens de conhecer a vocalista. *Risos* Ela conseguiu o ingresso de graça, mas vamos ter que ir ao bar no salão principal para tomar uns drinques."

# game/scripts/c18/c18.rpy:371
translate brazilian c18s001_Dinner_84323f0a:

    # mc "Traducción: [mc], te va a tocar ir a por las copas."
    mc "Tradução: [mc], você terá que ir buscar os copos."

# game/scripts/c18/c18.rpy:373
translate brazilian c18s001_Dinner_1f921612:

    # sca "¡Como siempre! *Risa* Pero ya te acompañaré yo, como la última vez."
    sca "Como sempre! *Risos* Mas eu vou te acompanhar, como da última vez."

# game/scripts/c18/c18.rpy:374
translate brazilian c18s001_Dinner_fd746a20:

    # mc "Bueno, pues podemos irnos cuando queráis."
    mc "Bem, podemos ir embora quando você quiser."

# game/scripts/c18/c18.rpy:376
translate brazilian c18s001_Dinner_c131f3f1:

    # "Os despedís de las mujeres que se quedan en casa y unos minutos después estáis en el Jazz Corner. Megan os acompaña a la sala anexa."
    "Você se despede das mulheres que ficarão em casa e, alguns minutos depois, já está no Jazz Corner. Megan te acompanha até a sala ao lado."

# game/scripts/c18/c18.rpy:377
translate brazilian c18s001_Dinner_02a98b0b:

    # "La sala es un poco más grande que la mitad de la sala principal y cuenta con su propio escenario y barra, aunque hoy no están en uso."
    "A sala é um pouco maior que a metade do tamanho do salão principal e possui palco e bar próprios, embora estes não estejam em uso atualmente."

# game/scripts/c18/c18.rpy:378
translate brazilian c18s001_Dinner_2e0c3ba5:

    # "En el escenario hay una pantalla dónde proyectarán las actuaciones de Megan en la sala principal."
    "No palco há uma tela onde as apresentações de Megan no salão principal serão projetadas."

# game/scripts/c18/c18.rpy:385
translate brazilian c18s001_Dinner_63f66d91:

    # "Amanda, con un vestido que le ha prestado [emm]. Ella había venido en shorts a casa."
    "Amanda, usando um vestido que [emm] lhe emprestou. Ela tinha chegado em casa de shorts."

# game/scripts/c18/c18.rpy:389
translate brazilian c18s001_Dinner_81ea5029:

    # "[dap], otra vez con el pelo suelto, como la noche del Twins."
    "[dap], novamente com os cabelos soltos, como na noite dos Gêmeos."

# game/scripts/c18/c18.rpy:393
translate brazilian c18s001_Dinner_c99372e2:

    # "Debbie. Parece que les ha cogido el gusto a los tops."
    "Debbie. Parece que ela desenvolveu um gosto por blusas curtas."

# game/scripts/c18/c18.rpy:397
translate brazilian c18s001_Dinner_953e654f:

    # "[emm] con un vestido un poco osado que le ha prestado Kim."
    "[emm] usando um vestido um pouco ousado que Kim lhe emprestou."

# game/scripts/c18/c18.rpy:401
translate brazilian c18s001_Dinner_f204cdfa:

    # "[eri]. fiel a su estilo."
    "[eri]. Fiel ao estilo."

# game/scripts/c18/c18.rpy:405
translate brazilian c18s001_Dinner_fe85c8ee:

    # "Eva. Simplemente alucinante."
    "Eva. Simplesmente incrível."

# game/scripts/c18/c18.rpy:409
translate brazilian c18s001_Dinner_6547b59d:

    # "Kate, un vestido cómodo y sencillo, en su línea."
    "Kate, com um vestido confortável e simples, em seu estilo habitual."

# game/scripts/c18/c18.rpy:413
translate brazilian c18s001_Dinner_1df18a38:

    # "Kim. Hablando de vestidos osados."
    "Kim. Falando em vestidos ousados."

# game/scripts/c18/c18.rpy:417
translate brazilian c18s001_Dinner_e92781d9:

    # "Lisa, también manteniendo su estilo. Si el vestido fuera más largo podría ir a la ópera con él."
    "Lisa, mantendo também seu estilo. Se o vestido fosse mais comprido, ela poderia ir à ópera com ele."

# game/scripts/c18/c18.rpy:421
translate brazilian c18s001_Dinner_6283af77:

    # "Megan. El vestuario que le eligen es espectacular."
