

# game/scripts/c13/startS3.rpy:5
translate brazilian startS3_8b60ce73:

    # "Jamaal" "Veo que quieres empezar una partida nueva. Pero esto es la Temporada 4 de My Dorm." id startS3_8b60ce73
    "Jamaal" "Vejo que você quer começar um novo jogo. Mas esta é a 4ª temporada de My Dorm." id startS3_8b60ce73

# game/scripts/c13/startS3.rpy:7
translate brazilian startS3_7f917222:

    # "Jamaal" "Hay un cuestionario que vas a tener que rellenar, pero no es la mejor opción."
    "Jamaal" "Existe um questionário que você terá que preencher, mas não é a melhor opção."

# game/scripts/c13/startS3.rpy:8
translate brazilian startS3_fd712d46:

    # "Jamaal" "Tropecita y yo creemos que no vas a disfrutar el juego si no has jugado las temporadas previas, ya que no vas a conocer a los personajes."
    "Jamaal" "Tropecita e eu acreditamos que você não vai gostar do jogo se não tiver jogado as temporadas anteriores, pois não conhecerá os personagens."

# game/scripts/c13/startS3.rpy:10
translate brazilian startS3_2738f278:

    # "Jamaal" "Si quieres jugar la Temporada 4, lo ideal es haber jugado previamente, como mínimo, la Temporada 3 hasta el final." id startS3_2738f278
    "Jamaal" "Se você quiser jogar a 4ª temporada, o ideal é que você já tenha jogado pelo menos a 3ª temporada até o final." id startS3_2738f278

# game/scripts/c13/startS3.rpy:11
translate brazilian startS3_017758e4:

    # "Jamaal" "Aunque yo recomiendo que empieces desde el principio. Verás mi bonita cara mucho en las temporadas previas."
    "Jamaal" "Embora eu recomende que você comece do início. Você verá meu lindo rosto muitas vezes nas primeiras temporadas."

# game/scripts/c13/startS3.rpy:13
translate brazilian startS3_534d9fa7:

    # "Jamaal" "Puedes bajar las Temporadas 1 y 2 en los sitios habituales (Patreon, Subscribestar, y Discord)."
    "Jamaal" "Você pode baixar as temporadas 1 e 2 nos sites habituais (Patreon, Subscribestar e Discord)."

# game/scripts/c13/startS3.rpy:14
translate brazilian startS3_fbcd1a72:

    # "Jamaal" "Encontrarás los enlaces en el menú principal, en la parte inferior izquierda."
    "Jamaal" "Você encontrará os links no menu principal, no canto inferior esquerdo."

# game/scripts/c13/startS3.rpy:16
translate brazilian startS3_e2947f50:

    # "Jamaal" "¡Nos vemos en alguna de las temporadas anteriores! O en esta si no sigues mi consejo."
    "Jamaal" "Nos vemos em uma das temporadas anteriores! Ou nesta, se você não seguir meu conselho."

# game/scripts/c13/startS3.rpy:18
translate brazilian startS3_5120be79:

    # "Jamaal" "¡Oh! Y no te preocupes. No soy el personaje principal de este juego. No es tan guapo como yo, pero no es mal tipo."
    "Jamaal" "Ah! E não se preocupe. Eu não sou o personagem principal deste jogo. Ele não é tão bonito quanto eu, mas não é um cara mau."

