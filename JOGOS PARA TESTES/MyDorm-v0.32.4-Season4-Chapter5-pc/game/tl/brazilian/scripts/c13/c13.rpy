translate brazilian c13s002_TheHospital_bba228a4:

    # mc "No exagero, tan solo soy precavido. Y ya has escuchado a [eil], [nor] y [mar]."
    mc "Não estou exagerando, estou apenas sendo cauteloso. E você já ouviu falar de [eil], [nor] e [mar]."

# game/scripts/c13/c13.rpy:690
translate brazilian c13s002_TheHospital_c434728b:

    # mc "Una vez más, no es necesario. Si me tengo que ir mientras estás con [sam], te escribo o te llamo."
    mc "Mais uma vez, não é necessário. Se eu tiver que sair enquanto você estiver com [sam], eu te mando uma mensagem ou te ligo."

# game/scripts/c13/c13.rpy:701
translate brazilian c13s002_TheHospital_6daab285:

    # mc "Gracias, [sam.nick]. Trátala bien, por favor. Lo ha pasado mal"
    mc "Obrigada. Por favor, trate-a bem. Ela passou por momentos difíceis."

# game/scripts/c13/c13.rpy:704
translate brazilian c13s002_TheHospital_3ed01c19:

    # mc "Y por cierto, [sam.nick], perdón por el plantón de ayer."
    mc "E aliás, [sam.nick], desculpe por ter me deixado esperando ontem."

# game/scripts/c13/c13.rpy:711
translate brazilian c13s002_TheHospital_b6efaa5c:

    # mc "Hasta dentro de un rato, [sam.nick]."
    mc "Até daqui a pouco, [sam.nick]."

# game/scripts/c13/c13.rpy:718
translate brazilian c13s003_ScarlettHouse_2bcf312e:

    # "Aparcas delante de casa de [sca] y le mandas un mensaje. Has pasado el video a una tablet para que sea más cómodo enseñárselo a su madre."
    "Você estaciona em frente à casa de [sca] e envia uma mensagem para ela. Você transferiu o vídeo para um tablet para que seja mais fácil mostrá-lo à mãe dela."

# game/scripts/c13/c13.rpy:719
translate brazilian c13s003_ScarlettHouse_06b3a08e:

    # "[sca] sale de su casa y entra en la camioneta."
    "[sca] sai de casa e entra no caminhão."

# game/scripts/c13/c13.rpy:735
translate brazilian c13s003_ScarlettHouse_5c1882b4:

    # "[sca] permanece en silencio durante todo el video. Tan solo con la boca abierta en una expresión de sorpresa."
    "[sca] Ele permanece em silêncio durante todo o vídeo. Sua boca está aberta em uma expressão de surpresa."

# game/scripts/c13/c13.rpy:751
translate brazilian c13s003_ScarlettHouse_2aa47b5f:

    # "Al bajar de la camioneta [sca] saca el móvil mientras os dirigís a la puerta. Te mira con nerviosismo."
    "Ao sair da van, ele pega o celular enquanto você caminha em direção à porta. Ele olha para você, nervoso."

# game/scripts/c13/c13.rpy:759
translate brazilian c13s003_ScarlettHouse_268c67a7:

    # "Entraís en casa y [sca] hace las presentaciones. Te presenta como un amigo."
    "Você entra na casa e ele faz as apresentações. Ele te apresenta como um amigo."

# game/scripts/c13/c13.rpy:761
translate brazilian c13s003_ScarlettHouse_e731d352:

    # "[sca] explica la excusa que habéis inventado para tener el video, sin contarle el contenido."
    "[sca] Explique a desculpa que você inventou para conseguir o vídeo, sem revelar o conteúdo para ele."

# game/scripts/c13/c13.rpy:780
translate brazilian c13s003_ScarlettHouse_5fa9a7b2:

    # mc "Además, si nadie hace nada inapropiado en la habitación de [sca], no pasa nada, ¿no?"
    mc "Além disso, se ninguém fizer nada inapropriado no quarto de [sca], nada acontece, certo?"

# game/scripts/c13/c13.rpy:786
translate brazilian c13s003_ScarlettHouse_a588a634:

    # "El video comienza con [sca] en su habitación."
    "O vídeo começa com [sca] em seu quarto."

# game/scripts/c13/c13.rpy:788
translate brazilian c13s003_ScarlettHouse_559466c2:

    # kev "Hola [sca], ¿Me has echado de menos?"
    kev "Olá [sca], você sentiu minha falta?"

# game/scripts/c13/c13.rpy:811
translate brazilian c13s003_ScarlettHouse_8d18d4ff:

    # mj "¡[sca]!"
    mj "[sca]!"

# game/scripts/c13/c13.rpy:827
translate brazilian c13s003_ScarlettHouse_8d18d4ff_1:

    # mj "¡[sca]!"
    mj "[sca]!"

# game/scripts/c13/c13.rpy:834
translate brazilian c13s003_ScarlettHouse_ee4b38af:

    # mj "Esto no puede ser real. Sé que lo que decía [sca] coincidía con los subtítulos, puedo leerle los labios en la mayoría del video, pero no me puedo creer que Kevin dijera eso."
    mj "Isso não pode ser real. Eu sei que o que ele estava dizendo correspondia às legendas, consigo ler seus lábios na maior parte do vídeo, mas não acredito que Kevin tenha dito isso."

# game/scripts/c13/c13.rpy:846
translate brazilian c13s003_ScarlettHouse_ee11ecc8:

    # "[sca] no traduce."
    "[sca] não se traduz."

# game/scripts/c13/c13.rpy:852
translate brazilian c13s003_ScarlettHouse_785091ea:

    # "Solo conoces una frase en lenguaje de signos. Esa frase aparece varias veces. Siempre en manos de [sca], nunca de su madre."
    "Você só conhece uma frase em língua de sinais. Essa frase aparece várias vezes. Sempre nas mãos de [sca], nunca nas de sua mãe."

# game/scripts/c13/c13.rpy:922
translate brazilian c13s003_ScarlettHouse_0c745853:

    # "[sca] y la Señora Rusell paran la discusión y os miran mientras Kevin cae al suelo."
    "[sca] e a Sra. Russell interrompem a discussão e olham para você enquanto Kevin cai no chão."

# game/scripts/c13/c13.rpy:923
translate brazilian c13s003_ScarlettHouse_1f5e353d:

    # mc "[sca], haz las maletas si quieres puedes venir a casa. No voy a dejarte con este cerdo."
    mc "Faça as malas, se quiser pode voltar para casa. Não vou te deixar com esse porco."

# game/scripts/c13/c13.rpy:927
translate brazilian c13s003_ScarlettHouse_f2ba9233:

    # mj "¡Haz tus maletas y vete de mi casa, [sca]!"
    mj "Faça as malas e saia da minha casa!"

# game/scripts/c13/c13.rpy:975
translate brazilian c13s003_ScarlettHouse_c7a3ae4c:

    # ama "[sca], ve a hacer las maletas. Tienes un par de horas. No creo que pueda entretenerlos mucho más antes de que empiecen a sospechar."
    ama "[sca]Vá arrumar suas malas. Você tem algumas horas. Acho que não consigo segurá-los por muito mais tempo antes que comecem a suspeitar."

# game/scripts/c13/c13.rpy:976
translate brazilian c13s003_ScarlettHouse_2e79ac08:

    # "Su voz transpira autoridad. Pero [sca] ya no es la niña tímida de hace dos semanas. Algo ha cambiado en ella."
    "Sua voz exala autoridade. Mas ela não é mais a garota tímida de duas semanas atrás. Algo mudou nela."

# game/scripts/c13/c13.rpy:979
translate brazilian c13s003_ScarlettHouse_824f885f:

    # mc "[sca], ya te he dicho que no te lo podía explicar ahora..."
    mc "[sca], Eu já te disse que não conseguiria te explicar agora..."

# game/scripts/c13/c13.rpy:982
translate brazilian c13s003_ScarlettHouse_32787d33:

    # ama "Será mejor que hagas caso a tu novio, [sca]."
    ama "É melhor você ouvir seu namorado, [sca]."

# game/scripts/c13/c13.rpy:984
translate brazilian c13s003_ScarlettHouse_73e760fb:

    # ama "Será mejor que hagas caso a [mc], [sca]."
    ama "É melhor você prestar atenção em [mc], [sca]."

# game/scripts/c13/c13.rpy:994
translate brazilian c13s003_ScarlettHouse_5b01eec3:

    # mc "¿Desde cuándo tenéis cámaras en casa de [sca]? ¿Hay otros videos donde se vea la cara de Kevin y la Señora Russell pueda leer sus labios?"
    mc "Desde quando vocês têm câmeras na casa de [sca]? Existem outros vídeos onde o rosto de Kevin aparece e a Sra. Russell consegue ler seus lábios?"

# game/scripts/c13/c13.rpy:996
translate brazilian c13s003_ScarlettHouse_be8aa04d:

    # ama "No, lo siento. Las pusimos el domingo, cuando [sca] fue a comprar al supermercado..."
    ama "Não, desculpe. Nós as colocamos no domingo, quando [sca] foi fazer compras no supermercado..."

# game/scripts/c13/c13.rpy:1001
translate brazilian c13s003_ScarlettHouse_7e87e61d:

    # mc "Lástima... pero ¿por qué vigilar la casa de [sca]?"
    mc "Que pena... mas por que vigiar a casa de [sca]?"

# game/scripts/c13/c13.rpy:1012
translate brazilian c13s003_ScarlettHouse_bc2737b7:

    # mc "Sólo una pregunta más. ¿Por qué me habéis enviado el video? [sca] no tiene nada que ver con NTR o con GILF."
    mc "Só mais uma pergunta. Por que você me enviou o vídeo? [sca] Não tem nada a ver com NTR ou GILF."

# game/scripts/c13/c13.rpy:1017
translate brazilian c13s003_ScarlettHouse_b2714cf9:

    # ama "No tienes que darlas. Saca a [sca] de aquí en cuanto puedas."
    ama "Você não precisa dar nada a eles. Saia daqui o mais rápido possível."

# game/scripts/c13/c13.rpy:1022
translate brazilian c13s003_ScarlettHouse_105717d0:

    # "Haces una llamada a [nor] y, después de confirmar la que pensabas que sería su respuesta, vas a la habitación de [sca]."
    "Você faz uma ligação para [nor] e, após confirmar o que você achava que seria a resposta deles, você vai para o quarto de [sca]."

# game/scripts/c13/c13.rpy:1034
translate brazilian c13s003_ScarlettHouse_98043fc5:

    # mc "Sí, [sca]. No tienes que preocuparte de dónde vas a vivir. Casi eres parte de la familia..."
    mc "Sim, [sca]. Você não precisa se preocupar com onde vai morar. Você é praticamente parte da família..."

# game/scripts/c13/c13.rpy:1058
translate brazilian c13s003_ScarlettHouse_50e10f30:

    # mc "Despídete de esta casa, [sca]. ¿Lo llevamos todo?"
    mc "Diga adeus a esta casa. Vamos levar tudo?"

# game/scripts/c13/c13.rpy:1101
translate brazilian c13s004_KiaraAndScarlett_e61df4df:

    # mc "Es la madre de [eil]. Va a vivir unos días con vosotras, en casa de [nor]."
    mc "Ela é a mãe de [eil]. Ela vai ficar com você por alguns dias, na casa de [nor]."

# game/scripts/c13/c13.rpy:1103
translate brazilian c13s004_KiaraAndScarlett_ced88982:

    # sca "¿[eil] también?"
    sca "[eil] também?"

# game/scripts/c13/c13.rpy:1107
translate brazilian c13s004_KiaraAndScarlett_5c8371f1:

    # sca "Tan solo por curiosidad. Hace un tiempo me hubiera puesto celosa por saber que [eil] iba a vivir en tu casa... más o menos..."
    sca "Só por curiosidade. Há algum tempo atrás, eu teria ficado com inveja se soubesse que [eil] ia morar na sua casa... mais ou menos..."

# game/scripts/c13/c13.rpy:1109
translate brazilian c13s004_KiaraAndScarlett_ee6a26ca:

    # sca "Ahora que sé que estás saliendo con otras chicas, casi me alegraría que [eil] fuera una de ellas... y no, no estoy preguntando si lo es."
    sca "Agora que sei que você está saindo com outras garotas, eu quase ficaria feliz se [eil] fosse uma delas... e não, eu não estou perguntando se ela está."

# game/scripts/c13/c13.rpy:1113
translate brazilian c13s004_KiaraAndScarlett_c20cecd9:

    # mc "[sca], ahora mismo solo me importas tú. No me importa quién viva en casa."
    mc "[sca], neste momento você é tudo o que importa para mim. Não me importo com quem mora em casa."

# game/scripts/c13/c13.rpy:1117
translate brazilian c13s004_KiaraAndScarlett_8e0373cb:

    # mc "[sca], ya lo hemos hablado. No sería justo para ninguno de los dos, lo único que harías es hacerte daño."
    mc "[sca], já conversamos sobre isso. Não seria justo para nenhum de nós; você só se machucaria."

# game/scripts/c13/c13.rpy:1137
translate brazilian c13s004_KiaraAndScarlett_9e8e60d3:

    # mc "¿Cómo ha ido? ¿Qué tal te ha tratado [sam.nick]?"
    mc "Como foi? Como eles te trataram?"

# game/scripts/c13/c13.rpy:1138
translate brazilian c13s004_KiaraAndScarlett_1eba2f5c:

    # kia "Mal y bien. El hematoma es señal de un pequeño desgarro muscular. [sam] ha sido un cielo, me ha dado un ungüento."
    kia "Bom e ruim. O hematoma é sinal de uma pequena ruptura muscular. [sam] Ela foi um anjo, me deu uma pomada."

# game/scripts/c13/c13.rpy:1139
translate brazilian c13s004_KiaraAndScarlett_4fd70212:

    # mc "Por cierto, [sca] - Kiara, Kiara - [sca]."
    mc "A propósito, [sca] - Kiara, Kiara - [sca]."

# game/scripts/c13/c13.rpy:1140
translate brazilian c13s004_KiaraAndScarlett_25da60d8:

    # kia "Encantada, [sca]."
    kia "Muito feliz, [sca]."

# game/scripts/c13/c13.rpy:1145
translate brazilian c13s004_KiaraAndScarlett_303cb22f:

    # mc "No, [sca] es una amiga de la familia. Se va a mudar a la habitación de [dap]. A la estudiante la irémos a buscar después de dejarte en el trabajo."
    mc "Não, [sca] ela é uma amiga da família. Ela vai se mudar para o quarto de [dap]. Buscaremos a estudante depois que a deixarmos no trabalho."

# game/scripts/c13/c13.rpy:1153
translate brazilian c13s004_KiaraAndScarlett_a428001e:

    # mc "[sca], ¿te gustan los perritos?"
    mc "[sca], você gosta de cachorrinhos?"

# game/scripts/c13/c13.rpy:1164
translate brazilian c13s004_KiaraAndScarlett_36c2f526:

    # kia "Lo siento mucho, [sca]. Yo creía que lo mío era malo, pero lo tuyo es horrible."
    kia "Sinto muito, [sca]. Eu achava que o que eu tinha era ruim, mas o que você tem é horrível."

# game/scripts/c13/c13.rpy:1180
translate brazilian c13s004_KiaraAndScarlett_ad4cd2e4:

    # sca "Pero quien pega a una mujer por norma es un cobarde. Kiara y [eil] lo han abandonado, aunque sea temporalmente, y eso le hará recapacitar."
    sca "Mas qualquer um que bata numa mulher rotineiramente é um covarde. Kiara e [eil] o deixaram, mesmo que apenas temporariamente, e isso o fará repensar."

# game/scripts/c13/c13.rpy:1188
translate brazilian c13s004_KiaraAndScarlett_24b98590:

    # kia "Nos vemos en casa de [nor], [sca]. Hasta luego, [mc]."
    kia "Te vejo na casa de [nor], [sca]. Até mais, [mc]."

# game/scripts/c13/c13.rpy:1192
translate brazilian c13s004_KiaraAndScarlett_f4b22c1f:

    # mcp "{i}(Enorme diferencia en la misma frase. Para [sca] ya es su casa. Kiara lógicamente se siente como una invitada. No me importaría que se quedaran. Estarían más seguras.){/i}"
    mcp "{i}(Grande diferença na mesma frase. Para [sca], já é a casa dela. Kiara, logicamente, se sente como uma convidada. Eu não me importaria se eles ficassem. Eles estariam mais seguros.){/i}"

# game/scripts/c13/c13.rpy:1193
translate brazilian c13s004_KiaraAndScarlett_b35f0308:

    # mc "Siguiente parada, el aeropuerto para recoger a [sai]"
    mc "Próxima parada: o aeroporto para buscar [sai]"

# game/scripts/c13/c13.rpy:1195
translate brazilian c13s004_KiaraAndScarlett_5aaa006f:

    # sca "¿[sai]? ¿No se llamaba así tu novia de Portland? Bueno... novia... la chica con la que tenías una relación abierta..."
    sca "[sai]? Não era esse o nome da sua namorada de Portland? Bem... namorada... a garota com quem você tinha um relacionamento aberto..."

# game/scripts/c13/c13.rpy:1216
translate brazilian c13s004_KiaraAndScarlett_bdc59024:

    # mc "Ya que estamos hablando de [sai], ¿cómo quieres que te presente? ¿Amiga? ¿Novia?"
    mc "Já que estamos falando de [sai], como você gostaria que eu a apresentasse? Amiga? Namorada?"

# game/scripts/c13/c13.rpy:1237
translate brazilian c13s004_GetSaira_2284b039:

    # mc "Vamos a quedarnos sentados aquí un momento, [sca]. Hay un tema que quiero hablar contigo."
    mc "Vamos sentar aqui um instante. Há algo que eu gostaria de conversar com você."

# game/scripts/c13/c13.rpy:1269
translate brazilian c13s004_GetSaira_7fbe2b62:

    # "Explicas a [sca] la conversación de ayer con tu padre, sin decirle que es tu padre, y las pistas que dejó caer sobre la identidad de tu medio hermana."
    "Você explica a [sca] a conversa de ontem com seu pai, sem lhe dizer que ele é seu pai, e as pistas que ele deu sobre a identidade de sua meia-irmã."

# game/scripts/c13/c13.rpy:1285
translate brazilian c13s004_GetSaira_26dbc394:

    # mc "[sca], no. No lo sabemos todavía. Podría ser una chica de Westport que estudie medicina en la NWU. Tenemos que confirmarlo antes..."
    mc "Não. Ainda não sabemos. Pode ser uma garota de Westport estudando medicina na NWU. Precisamos confirmar isso primeiro..."

# game/scripts/c13/c13.rpy:1319
translate brazilian c13s004_GetSaira_65cc15fa:

    # mc "Es normal, [sca]. Ayer yo estaba igual que tú ahora mismo."
    mc "É normal. Ontem eu estava igual a você agora."

# game/scripts/c13/c13.rpy:1320
translate brazilian c13s004_GetSaira_d69a2d64:

    # mc "Escucha, creo que deberías tomarte un tiempo para pensar. El vuelo de [sai] llega en un rato y deberíamos ir al aeropuerto."
    mc "Escute, acho que você deveria pensar um pouco. O voo chega daqui a pouco e devemos ir para o aeroporto."

# game/scripts/c13/c13.rpy:1323
translate brazilian c13s004_GetSaira_50a8f484:

    # mc "Solo una cosa más, [sca]. De momento no se lo digas a nadie. Nadie sabe que he estado hablando con mi padre ni lo que me ha dicho. Me gustaría explicarlo cuando sea el momento."
    mc "Só mais uma coisa. Não conte a ninguém por enquanto. Ninguém sabe que tenho falado com meu pai, nem o que ele me disse. Gostaria de explicar quando chegar a hora certa."

# game/scripts/c13/c13.rpy:1329
translate brazilian c13s004_GetSaira_7e9b4e59:

    # "Llegáis al aeropuerto justo a tiempo después de pillar un pequeño atasco. Los carteles indican que el vuelo de [sai] ha aterrizado hace unos minutos."
    "Você chega ao aeroporto bem a tempo, depois de ficar preso em um pequeno engarrafamento. As placas indicam que o voo [sai] pousou há alguns minutos."

# game/scripts/c13/c13.rpy:1336
translate brazilian c13s004_GetSaira_e0c84fdd:

    # "Unos minutos después aparece [sai] y te levantas a recibirla."
    "Alguns minutos depois, [sai] aparece e você se levanta para cumprimentá-la."

# game/scripts/c13/c13.rpy:1370
translate brazilian qKissSairaArrival_78265093:

    # "No es el beso que [sai] espera y su cuerpo se tensa por un momento. Tienes que hablar con ella antes de pensar en retomar lo vuestro."
    "Não é o beijo que [sai] esperava, e seu corpo se enrijece por um momento. Você precisa conversar com ela antes mesmo de pensar em voltar a ficar juntos."

# game/scripts/c13/c13.rpy:1376
translate brazilian qKissSairaArrival_471c8ef6:

    # mc "Ven, [sai], voy a presentarte a..."
    mc "Venha cá, [sai], vou lhe apresentar..."

# game/scripts/c13/c13.rpy:1378
translate brazilian qKissSairaArrival_448fd43a:

    # sai "¿Esa es [eil]? Creía que era pelirroja..."
    sai "É [eil]? Eu pensei que ela fosse ruiva..."

# game/scripts/c13/c13.rpy:1379
translate brazilian qKissSairaArrival_2c5ce4b6:

    # mc "No, no es [eil]. A [eil] la conocerás hoy. Está viviendo en casa."
    mc "Não, não é [eil]. Você vai conhecer [eil] hoje. Ela mora em casa."

# game/scripts/c13/c13.rpy:1389
translate brazilian qKissSairaArrival_aa274306:

    # mc "[sai], esta es [sca], una de las chicas con las que salgo."
    mc "[sai], esta é [sca], uma das garotas com quem estou saindo."

# game/scripts/c13/c13.rpy:1391
translate brazilian qKissSairaArrival_c04d3978:

    # mc "[sai], esta es [sca]. Mi otra novia, aparte de ti, si es que quieres volver conmigo, claro."
    mc "[sai], esta é [sca]. Minha outra namorada, além de você, se você quiser voltar comigo, é claro."

# game/scripts/c13/c13.rpy:1393
translate brazilian qKissSairaArrival_389f424b:

    # mc "[sai], esta es [sca]. Mi novia."
    mc "[sai], esta é [sca]. Minha namorada."

# game/scripts/c13/c13.rpy:1395
translate brazilian qKissSairaArrival_7d397448:

    # sca "Encantada, [sai]."
    sca "Muito feliz, [sai]."

# game/scripts/c13/c13.rpy:1398
translate brazilian qKissSairaArrival_f7d7b341:

    # sai "¿Y [eil]?"
    sai "E [eil]?"

# game/scripts/c13/c13.rpy:1400
translate brazilian qKissSairaArrival_5b467579:

    # mc "Sí, con [eil] también."
    mc "Sim, com [eil] também."

# game/scripts/c13/c13.rpy:1402
translate brazilian qKissSairaArrival_b75f5ef5:

    # sca "¿Qué? ¿Sales con [eil]?" (multiple=2)
    sca "O quê? Você está namorando [eil]?" (multiple=2)

# game/scripts/c13/c13.rpy:1404
translate brazilian qKissSairaArrival_6e4af929:

    # mc "Sí. No te sorprendas tanto, [sca]. Tengo su autorización para hacerlo público."
    mc "Sim. Não fique tão surpreso, [sca]. Eu tenho a permissão dele para tornar isso público."

# game/scripts/c13/c13.rpy:1405
translate brazilian qKissSairaArrival_ec126028:

    # mc "[sai], tú y yo teníamos una relación abierta que no lo era en la práctica. Ahora tengo una que lo es."
    mc "[sai], você e eu tínhamos um relacionamento aberto que na prática não era realmente aberto. Agora eu tenho um que é."

