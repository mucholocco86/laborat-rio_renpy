

# game/scripts/c13/c13.rpy:47
translate brazilian c13s001_KiaraEileen_c6c4326a:

    # mc "¿Qué ha pasado, Eileen?"
    mc "O que aconteceu, Eileen?"

# game/scripts/c13/c13.rpy:48
translate brazilian c13s001_KiaraEileen_c274c946:

    # eil "Lo de siempre. Mi padre bebió demasiado y empezó a gritarle a mi madre por alguna tontería."
    eil "O de sempre. Meu pai bebeu demais e começou a gritar com minha mãe por uma bobagem qualquer."

# game/scripts/c13/c13.rpy:49
translate brazilian c13s001_KiaraEileen_9fb18d51:

    # eil "Esta vez la agarró del brazo y empezó a arrastrarla por la casa. En ese momento llegué yo."
    eil "Dessa vez, ele agarrou o braço dela e começou a arrastá-la pela casa. Foi aí que eu cheguei."

# game/scripts/c13/c13.rpy:51
translate brazilian c13s001_KiaraEileen_21bb27f9:

    # mc "¿Estás bien, Kiara?"
    mc "Você está bem, Kiara?"

# game/scripts/c13/c13.rpy:52
translate brazilian c13s001_KiaraEileen_c906d645:

    # kia "Sí, no ha sido tanto como Eileen dice. Me ha hecho un poco de daño y..."
    kia "Sim, não foi tão ruim quanto a Eileen diz. Doeu um pouco e..."

# game/scripts/c13/c13.rpy:53
translate brazilian c13s001_KiaraEileen_6c0ef233:

    # kia "¿Podemos esperar a llegar a tu casa para seguir hablando de esto? Es raro hablar con dos cogotes..."
    kia "Podemos esperar até chegarmos à sua casa para continuarmos a conversar sobre isso? É estranho conversar com dois caras..."

# game/scripts/c13/c13.rpy:54
translate brazilian c13s001_KiaraEileen_f52820f5:

    # mc "Ningún problema, Kiara."
    mc "Sem problema, Kiara."

# game/scripts/c13/c13.rpy:56
translate brazilian c13s001_KiaraEileen_719b4668:

    # mc "Hoy dormiréis en mi habitación. Todo el mundo está durmiendo ahora mismo y sería complicado habilitaros otra habitación."
    mc "Você vai dormir no meu quarto hoje à noite. Todos estão dormindo agora, e seria difícil encontrar outro quarto para você."

# game/scripts/c13/c13.rpy:57
translate brazilian c13s001_KiaraEileen_72f9361b:

    # eil "¿Dónde vas a dormir tú?"
    eil "Onde você vai dormir?"

# game/scripts/c13/c13.rpy:58
translate brazilian c13s001_KiaraEileen_3cf765c4:

    # mc "Con vosotras, por supuesto. Es mi habitación."
    mc "Com você, é claro. É o meu quarto."

# game/scripts/c13/c13.rpy:60
translate brazilian c13s001_KiaraEileen_6e57607b:

    # eil "¡[mc]! No puedo dejar que duermas con mi madre..."
    eil "[mc]! Não posso deixar você dormir com a minha mãe..."

# game/scripts/c13/c13.rpy:61
translate brazilian c13s001_KiaraEileen_329a3c4e:

    # mc "Eile, es broma. Buscaré algún sitio donde dormir sin molestar a nadie."
    mc "Eile, estou só brincando. Vou encontrar um lugar para dormir sem incomodar ninguém."

# game/scripts/c13/c13.rpy:63
translate brazilian c13s001_KiaraEileen_05d083a2:

    # eil "Lo siento, no tengo el ánimo para bromas ahora mismo."
    eil "Desculpe, não estou com vontade de fazer piadas agora."

# game/scripts/c13/c13.rpy:64
translate brazilian c13s001_KiaraEileen_1519018b:

    # mc "No te preocupes. Quizás no era el momento más adecuado para bromas."
    mc "Não se preocupe. Talvez não fosse o melhor momento para piadas."

# game/scripts/c13/c13.rpy:66
translate brazilian c13s001_KiaraEileen_e5d14762:

    # "Continúas conduciendo hacia casa. Ahora en silencio. El camino parece eterno una vez la adrenalina que te ha traído aquí volando desaparece."
    "Você continua dirigindo para casa. Agora em silêncio. A estrada parece interminável depois que a adrenalina que o trouxe até aqui passa."

# game/scripts/c13/c13.rpy:69
translate brazilian c13s001_KiaraEileen_e220be2f:

    # mc "Pues esta es mi habitación, Kiara. Hay un baño con ducha justo pasar el gimnasio. Eileen conoce la casa, con lo que cualquier duda se la puedes preguntar."
    mc "Este é o meu quarto, Kiara. Tem um banheiro com chuveiro logo depois da academia. A Eileen conhece a casa, então você pode perguntar a ela se tiver alguma dúvida."

# game/scripts/c13/c13.rpy:71
translate brazilian c13s001_KiaraEileen_03e86018:

    # mc "Si necesitáis cualquier cosa, estaré durmiendo en los sofás que acabamos de pasar en la planta debajo de esta."
    mc "Se precisar de alguma coisa, estarei dormindo nos sofás que acabamos de passar, no andar de baixo."

# game/scripts/c13/c13.rpy:72
translate brazilian c13s001_KiaraEileen_3f24f32d:

    # kia "Gracias, [mc], me sabe mal que tengas que dormir en un sofá por nuestra culpa."
    kia "Obrigado, [mc], sinto muito que você tenha que dormir em um sofá por nossa causa."

# game/scripts/c13/c13.rpy:73
translate brazilian c13s001_KiaraEileen_c2022b3a:

    # eil "Podrías dormir en este sofá si quieres. No queremos echarte de tu habitación."
    eil "Você pode dormir neste sofá se quiser. Não queremos te expulsar do seu quarto."

# game/scripts/c13/c13.rpy:75
translate brazilian c13s001_KiaraEileen_769a90f0:

    # kia "O mejor aún, dormimos nosotras en esos sofás y tu duermes en tu cama como debería ser."
    kia "Ou melhor ainda, nós dormimos nesses sofás e você dorme na sua cama, como deve ser."

# game/scripts/c13/c13.rpy:76
translate brazilian c13s001_KiaraEileen_7395a30e:

    # mc "Eso no puedo permitirlo. Sois mis invitadas y vais a dormir en una cama."
    mc "Não posso permitir isso. Vocês são meus convidados e dormirão em uma cama."

# game/scripts/c13/c13.rpy:78
translate brazilian c13s001_KiaraEileen_87bd263e:

    # eil "Mamá... ¿no has metido pijamas en la bolsa?"
    eil "Mãe... você não colocou pijama na mala?"

# game/scripts/c13/c13.rpy:80
translate brazilian c13s001_KiaraEileen_444f4618:

    # kia "¡Oops! No. Me he despistado. Con las prisas he pensado en ropa, artículos de higiene... pero no en los pijamas."
    kia "Ops! Não. Me distraí. Na pressa, pensei em roupas, produtos de higiene pessoal... mas não em pijamas."

# game/scripts/c13/c13.rpy:81
translate brazilian c13s001_KiaraEileen_c1783558:

    # mc "No os preocupéis. Podéis coger camisetas o pijamas míos para dormir. Eileen sabe donde están."
    mc "Não se preocupe. Você pode pegar qualquer uma das minhas camisetas ou pijamas para dormir. A Eileen sabe onde eles estão."

# game/scripts/c13/c13.rpy:83
translate brazilian c13s001_KiaraEileen_9a4121a2:

    # kia "Se me hace raro que Eileen sepa más de una casa que yo. *Risa* Pero después de tantos años juntos es normal."
    kia "É estranho que a Eileen saiba mais sobre uma casa do que eu. *Risos* Mas depois de tantos anos juntos, é normal."

# game/scripts/c13/c13.rpy:84
translate brazilian c13s001_KiaraEileen_be191e95:

    # kia "Es una lástima que lo dejáseis cuando estabas en Portland. Pensaba que volveriais a estar juntos cuando volvieras de la universidad."
    kia "Que pena que vocês terminaram quando você estava em Portland. Achei que vocês voltariam quando você retornasse da faculdade."

# game/scripts/c13/c13.rpy:85
translate brazilian c13s001_KiaraEileen_4d6b542d:

    # mc "Bueno, no funcionaba a distancia."
    mc "Bem, não funcionou remotamente."

# game/scripts/c13/c13.rpy:88
translate brazilian c13s001_KiaraEileen_1d7f0a08:

    # "Eileen te mira interrogativamente, como si te pidiera permiso para desvelar la noticia a su madre."
    "Eileen olha para você com um olhar interrogativo, como se estivesse pedindo sua permissão para revelar a novidade à mãe dela."

# game/scripts/c13/c13.rpy:89
translate brazilian c13s001_KiaraEileen_c95b64af:

    # "Asientes."
    "Você acena com a cabeça."

# game/scripts/c13/c13.rpy:91
translate brazilian c13s001_KiaraEileen_f98ceeb9:

    # eil "Mamá, volvemos a estar juntos."
    eil "Mãe, estamos juntos de novo."

# game/scripts/c13/c13.rpy:93
translate brazilian c13s001_KiaraEileen_e045b18f:

    # eil "No de la misma forma que antes, pero volvemos a estarlo."
    eil "Não da mesma forma que antes, mas estamos de volta."

# game/scripts/c13/c13.rpy:95
translate brazilian c13s001_KiaraEileen_6901d4af:

    # kia "¡Eso es fantástico! Me alegro mucho por vosotros."
    kia "Que fantástico! Estou muito feliz por você."

# game/scripts/c13/c13.rpy:96
translate brazilian c13s001_KiaraEileen_887f84c9:

    # mc "Gracias, Kiara."
    mc "Obrigada, Kiara."

# game/scripts/c13/c13.rpy:99
translate brazilian c13s001_KiaraEileen_bd6a288c:

    # eil "Además, ahora somos buenos amigos. Lo importante es que no hemos perdido la relación."
    eil "Além disso, agora somos bons amigos. O importante é que não perdemos o contato."

# game/scripts/c13/c13.rpy:101
translate brazilian c13s001_KiaraEileen_18f876c1:

    # mc "Voy a dejar que os cambiéis y os acostéis. Mañana hablaremos de cómo nos organizamos y de lo que ha pasado esta noche."
    mc "Vou deixar você se trocar e ir para a cama. Amanhã conversaremos sobre como estamos organizando as coisas e o que aconteceu esta noite."

# game/scripts/c13/c13.rpy:102
translate brazilian c13s001_KiaraEileen_cb206701:

    # kia "Gracias, [mc]."
    kia "Obrigado, [mc]."

# game/scripts/c13/c13.rpy:103
translate brazilian c13s001_KiaraEileen_565a3cb6:

    # eil "Gracias. Por todo."
    eil "Obrigado por tudo."

# game/scripts/c13/c13.rpy:105
translate brazilian c13s001_KiaraEileen_a17f0e80:

    # "Bajas a la planta de las estudiantes. Parece mentira que Kim te despertara en este mismo sofá hace menos de 24 horas."
    "Você desce até o andar dos estudantes. É difícil acreditar que Kim te acordou neste mesmo sofá há menos de 24 horas."

# game/scripts/c13/c13.rpy:106
translate brazilian c13s001_KiaraEileen_dcce7ba5:

    # mcp "{i}(Soy idiota. Les he dicho que cogieran mis pijamas y no he cogido uno para mí. Ni siquiera unos shorts.){/i}"
    mcp "{i}(Sou um idiota. Pedi para levarem meu pijama e não levei nenhum para mim. Nem mesmo shorts.){/i}"

# game/scripts/c13/c13.rpy:107
translate brazilian c13s001_KiaraEileen_6ff3efb4:

    # mcp "{i}(*Risa mental* Dormir en pelotas en el sofá no sería muy adecuado si alguna de las estudiantes se despierta antes que yo.){/i}"
    mcp "{i}(*Risos mentais* Dormir nu no sofá não seria muito apropriado se algum dos alunos acordasse antes de mim.){/i}"

# game/scripts/c13/c13.rpy:108
translate brazilian c13s001_KiaraEileen_2f20ab6f:

    # "Vuelves a tu habitación."
    "Você volta para o seu quarto."

# game/scripts/c13/c13.rpy:111
translate brazilian c13s001_KiaraEileen_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c13/c13.rpy:112
translate brazilian c13s001_KiaraEileen_ff300ecf:

    # mc "¿Puedo entrar? No he cogido nada para mí, para dormir."
    mc "Posso entrar? Não peguei nada para mim, para dormir."

# game/scripts/c13/c13.rpy:113
translate brazilian c13s001_KiaraEileen_f2e14fc9:

    # eil "*A través de la puerta* Espera un segundo, por favor."
    eil "*Através da porta* Espere um segundo, por favor."

# game/scripts/c13/c13.rpy:114
translate brazilian c13s001_KiaraEileen_124fea52:

    # "Al cabo de unos segundos..."
    "Após alguns segundos..."

# game/scripts/c13/c13.rpy:115
translate brazilian c13s001_KiaraEileen_87c5147b:

    # kia "*A través de la puerta* Puedes pasar."
    kia "Você pode passar pela porta."

# game/scripts/c13/c13.rpy:117
translate brazilian c13s001_KiaraEileen_d6dbf9c6:

    # mc "Disculpad, pero es que no he cogido mi propio pijama."
    mc "Com licença, mas eu não trouxe meu pijama."

# game/scripts/c13/c13.rpy:118
translate brazilian c13s001_KiaraEileen_6a638103:

    # mc "Aunque viendo que a vosotras os queda mejor mi ropa que a mí..."
    mc "Embora, considerando que minhas roupas ficam melhor em você do que em mim..."

# game/scripts/c13/c13.rpy:120
translate brazilian c13s001_KiaraEileen_2aff138e:

    # eil "*Risa* ¿Ya estás diciendo payasadas? ¿Tú no ibas a dormir?"
    eil "*Risos* Já está falando besteira? Não ia dormir?"

# game/scripts/c13/c13.rpy:121
translate brazilian c13s001_KiaraEileen_2164d99f:

    # mc "¿Payasadas? {b}¿Yo?{/b} ¡Qué va! Tenéis un espejo en ese armario si queréis, en el interior de la puerta."
    mc "Piadas bobas? {b}Eu?{/b} De jeito nenhum! Tem um espelho naquele armário, do lado de dentro da porta, se você quiser."

# game/scripts/c13/c13.rpy:122
translate brazilian c13s001_KiaraEileen_f013a839:

    # mc "Y sobre lo de dormir... demasiados nervios para dormir ahora mismo."
    mc "E sobre dormir... Estou muito nervoso para dormir agora."

# game/scripts/c13/c13.rpy:124
translate brazilian c13s001_KiaraEileen_cad26fba:

    # mc "¿Eso es lo que te ha hecho Solomon? Parece un hematoma importante, deberíamos ir al hospital a mirarlo."
    mc "Foi isso que Salomão fez com você? Parece um hematoma considerável; devemos ir ao hospital para que ele examine."

# game/scripts/c13/c13.rpy:126
translate brazilian c13s001_KiaraEileen_5b6d23f3:

    # kia "No hace falta, tan solo es un morado. No es la primera vez..."
    kia "Não é necessário, é só roxo. Não é a primeira vez..."

# game/scripts/c13/c13.rpy:127
translate brazilian c13s001_KiaraEileen_0c3d2244:

    # mc "Espero que sea la última."
    mc "Espero que seja a última."

# game/scripts/c13/c13.rpy:128
translate brazilian c13s001_KiaraEileen_03d83403:

    # mc "Pero de todas formas, habría que mirarlo. Sin dejar pasar muchos días."
    mc "Mas devemos investigar isso de qualquer forma. Sem deixar passar muitos dias."

# game/scripts/c13/c13.rpy:129
translate brazilian c13s001_KiaraEileen_6b4a4f4c:

    # mc "¿Quieres hablar sobre lo que ha pasado?"
    mc "Você quer conversar sobre o que aconteceu?"

# game/scripts/c13/c13.rpy:131
translate brazilian c13s001_KiaraEileen_a5db2430:

    # kia "Nosotras tampoco vamos a poder dormir, si quieres te lo explico ahora antes de que se nos olviden los detalles."
    kia "Nós também não vamos conseguir dormir, se você quiser posso te explicar agora antes que a gente se esqueça dos detalhes."

# game/scripts/c13/c13.rpy:132
translate brazilian c13s001_KiaraEileen_a1ae72c2:

    # kia "Es lo menos que te debo..."
    kia "É o mínimo que te devo..."

# game/scripts/c13/c13.rpy:133
translate brazilian c13s001_KiaraEileen_59a61feb:

    # mc "Kiara, no me debes nada. Es más, no tienes que explicarme nada de lo que ha pasado."
    mc "Kiara, você não me deve nada. Além disso, você não precisa explicar nada sobre o que aconteceu."

# game/scripts/c13/c13.rpy:134
translate brazilian c13s001_KiaraEileen_60f198fe:

    # mc "Lo decía porque en mi familia acostumbramos a hablarlo todo para quitarnos el peso de encima."
    mc "Eu disse isso porque na minha família costumamos conversar sobre tudo para aliviar o fardo."

# game/scripts/c13/c13.rpy:136
translate brazilian c13s001_KiaraEileen_3910ebcb:

    # eil "Es una buena costumbre, Mamá. Deberíamos aplicarla en casa."
    eil "É um bom hábito, mãe. Devemos adotá-lo em casa."

# game/scripts/c13/c13.rpy:137
translate brazilian c13s001_KiaraEileen_25f21628:

    # eil "¿Nos sentamos?"
    eil "Vamos nos sentar?"

# game/scripts/c13/c13.rpy:138
translate brazilian c13s001_KiaraEileen_bf5931c4:

    # mc "Sólo si tu madre quiere."
    mc "Só se sua mãe quiser."

# game/scripts/c13/c13.rpy:140
translate brazilian c13s001_KiaraEileen_34940787:

    # kia "Sí, probemos esa costumbre familiar vuestra. Está claro que las costumbres de mi familia no son las mejores."
    kia "Sim, vamos tentar essa tradição familiar de vocês. É evidente que as tradições da minha família não são as melhores."

# game/scripts/c13/c13.rpy:141
translate brazilian c13s001_KiaraEileen_db4aa0ed:

    # mc "No te machaques ahora. Eileen ha salido muy bien. Y tú también."
    mc "Não se culpe agora. Eileen se saiu muito bem. E você também."

# game/scripts/c13/c13.rpy:143
translate brazilian c13s001_KiaraEileen_bbb21deb:

    # mc "¿Por dónde quieres empezar, Kiara?"
    mc "Por onde você quer começar, Kiara?"

# game/scripts/c13/c13.rpy:144
translate brazilian c13s001_KiaraEileen_820962d4:

    # kia "Es difícil decidirlo. ¿Cuánto sabes? ¿Te pongo en antecedentes?"
    kia "É uma decisão difícil. Quanto você sabe? Devo lhe dar algumas informações básicas?"

# game/scripts/c13/c13.rpy:145
translate brazilian c13s001_KiaraEileen_20801f23:

    # eil "Mamá, [mc] sabe lo que pasaba cuando Papá bebía... cuando aún estábamos en el instituto."
    eil "Mamãe sabe o que acontecia quando papai bebia... na época em que ainda estávamos no ensino médio."

# game/scripts/c13/c13.rpy:147
translate brazilian c13s001_KiaraEileen_2bc0a856:

    # kia "Entonces... esta noche..."
    kia "Então... esta noite..."

# game/scripts/c13/c13.rpy:148
translate brazilian c13s001_KiaraEileen_a3b26a54:

    # kia "Desde que Solomon ha vuelto a beber, no se había puesto violento ninguna vez, esta es la primera."
    kia "Desde que Salomão voltou a beber, ele não havia sido violento em nenhum momento; esta é a primeira vez."

# game/scripts/c13/c13.rpy:149
translate brazilian c13s001_KiaraEileen_b6173fef:

    # mc "Eso es una vez más de las necesarias."
    mc "Essa é, mais uma vez, uma das necessárias."

# game/scripts/c13/c13.rpy:151
translate brazilian c13s001_KiaraEileen_e6a3af03:

    # kia "Lo sé. Cuando dejó de beber lo hizo, entre otras razones, por que le amenacé con dejarle si me volvía a poner la mano encima."
    kia "Eu sei. Quando ele parou de beber, foi, entre outros motivos, porque eu o ameacei de deixá-lo se ele voltasse a encostar em mim."

# game/scripts/c13/c13.rpy:152
translate brazilian c13s001_KiaraEileen_3c1001c8:

    # kia "Todo fue bien durante dos años, y después volvió a beber."
    kia "Durante dois anos, tudo correu bem, e depois ele voltou a beber."

# game/scripts/c13/c13.rpy:153
translate brazilian c13s001_KiaraEileen_a262e0ac:

    # mc "Lo sé, Eileen me lo explicó. ¿Sabéis por qué volvió?"
    mc "Eu sei, a Eileen me explicou. Você sabe por que ela voltou?"

# game/scripts/c13/c13.rpy:155
translate brazilian c13s001_KiaraEileen_f19c05de:

    # eil "No. Ya te dije que empezó a beber una cerveza al salir del trabajo, con los compañeros. Le dijimos que no lo hiciera, pero no nos hizo caso."
    eil "Não. Eu já te disse que ele começou a beber cerveja depois do trabalho, com os colegas. Nós dissemos para ele parar, mas ele não nos ouviu."

# game/scripts/c13/c13.rpy:156
translate brazilian c13s001_KiaraEileen_b5fe506f:

    # eil "\"Sólo es una cerveza un día a la semana\" decía. Como te dije, de ahí pasó varias cervezas, a un whisky, a varios whiskys..."
    eil "\"É só uma cerveja por semana\", disse ele. Como eu te disse, daí passou para várias cervejas, depois um uísque, depois vários uísques..."

# game/scripts/c13/c13.rpy:157
translate brazilian c13s001_KiaraEileen_aefac422:

    # mc "Pero no estaba violento hasta hoy, ¿qué ha pasado hoy?"
    mc "Mas ele não era violento até hoje, o que aconteceu hoje?"

# game/scripts/c13/c13.rpy:159
translate brazilian c13s001_KiaraEileen_4b05b630:

    # kia "Cuando he llegado de trabajar estaba muy borracho."
    kia "Quando cheguei em casa do trabalho, estava muito bêbado."

# game/scripts/c13/c13.rpy:160
translate brazilian c13s001_KiaraEileen_6715e9d6:

    # kia "Se enfadó mucho cuando le dije que tardaría 30 minutos en preparar la cena."
    kia "Ela ficou muito zangada quando eu disse que levaria 30 minutos para preparar o jantar."

# game/scripts/c13/c13.rpy:161
translate brazilian c13s001_KiaraEileen_8af27441:

    # mc "Acababas de llegar, ¿cuando quería que la preparases?"
    mc "Você tinha acabado de chegar, quando queria que eu preparasse isso?"

# game/scripts/c13/c13.rpy:163
translate brazilian c13s001_KiaraEileen_642ec6d5:

    # eil "Cuando está borracho el alcohol sustituye a la lógica."
    eil "Quando você está bêbado, o álcool substitui a lógica."

# game/scripts/c13/c13.rpy:164
translate brazilian c13s001_KiaraEileen_5b86879b:

    # eil "Puede quejarse de cualquier cosa, tenga razón o no. Y si le llevas la contraria se enfada más todavía. No se puede razonar con él."
    eil "Ele reclama de tudo, esteja certo ou errado. E se você discordar dele, ele fica ainda mais irritado. Não dá para argumentar com ele."

# game/scripts/c13/c13.rpy:165
translate brazilian c13s001_KiaraEileen_a78c46ec:

    # mc "Tú aún estabas en el trabajo, ¿no?"
    mc "Você ainda estava no trabalho, não é?"

# game/scripts/c13/c13.rpy:167
translate brazilian c13s001_KiaraEileen_453f64ce:

    # eil "Sí, ayer... hoy... tenía que cerrar el café y hacer la caja. A los temporales como [eri] no les dejan hacerla."
    eil "Sim, ontem... hoje... tive que fechar o café e operar o caixa. Funcionários temporários como [eri] não têm permissão para fazer isso."

# game/scripts/c13/c13.rpy:168
translate brazilian c13s001_KiaraEileen_d05e3112:

    # eil "Si hubiera estado ahí..."
    eil "Se eu estivesse lá..."

# game/scripts/c13/c13.rpy:169
translate brazilian c13s001_KiaraEileen_019b6db4:

    # mc "No es culpa tuya. Estabas trabajando. Dejaste la universidad para ayudar económicamente en casa porque tu padre perdió el trabajo. No se te puede exigir más."
    mc "Não é sua culpa. Você estava trabalhando. Você abandonou a universidade para ajudar em casa porque seu pai perdeu o emprego. Não se pode esperar que você faça mais do que isso."

# game/scripts/c13/c13.rpy:170
translate brazilian c13s001_KiaraEileen_b4bd6d48:

    # eil "Lo sé, pero..."
    eil "Eu sei, mas..."

# game/scripts/c13/c13.rpy:172
translate brazilian c13s001_KiaraEileen_a2860f19:

    # kia "[mc] tiene razón. No es culpa tuya. Ya haces demasiado. Pero mejor que siga..."
    kia "[mc] tem razão. Não é sua culpa. Você já faz demais. Mas é melhor eu continuar..."

# game/scripts/c13/c13.rpy:173
translate brazilian c13s001_KiaraEileen_34d9eddc:

    # kia "Durante la cena estuvo gruñón, quejándose de la limpieza, de cenar tarde, y de... de otras cosas..."
    kia "Durante o jantar, ele estava mal-humorado, reclamando da limpeza, do fato de terem comido tarde e... de outras coisas..."

# game/scripts/c13/c13.rpy:174
translate brazilian c13s001_KiaraEileen_da1a67d5:

    # mc "No hace falta que me expliques todo si no quieres..."
    mc "Você não precisa me explicar tudo se não quiser..."

# game/scripts/c13/c13.rpy:176
translate brazilian c13s001_KiaraEileen_8d3c8ff4:

    # kia "No es eso... es que son temas de pareja..."
    kia "Não é isso... são apenas problemas de relacionamento..."

# game/scripts/c13/c13.rpy:177
translate brazilian c13s001_KiaraEileen_c2d6cb37:

    # mc "Entonces no me hace falta saberlo."
    mc "Então eu não preciso saber."

# game/scripts/c13/c13.rpy:178
translate brazilian c13s001_KiaraEileen_b059fe3d:

    # kia "Es que... si no te lo explico... no vas a poder entender el resto..."
    kia "É que... se eu não te explicar... você não vai conseguir entender o resto..."

# game/scripts/c13/c13.rpy:179
translate brazilian c13s001_KiaraEileen_18cb3e2c:

    # mc "Como quieras, pero te puedo asegurar que lo que me digas no va a salir de esta habitación."
    mc "Faça o que quiser, mas posso garantir que o que você me disser não sairá desta sala."

# game/scripts/c13/c13.rpy:181
translate brazilian c13s001_KiaraEileen_eaf933e8:

    # kia "Se quejaba de que ya no tenemos sexo nunca. ¡Hale, ya lo he dicho! ¡Ufff! Realmente va bien esto de hablar las cosas..."
    kia "Ela estava reclamando que a gente nunca mais transa. Pronto, falei! Ufa! Conversar realmente ajuda..."

# game/scripts/c13/c13.rpy:182
translate brazilian c13s001_KiaraEileen_1a94dda9:

    # kia "Desde que empezó a beber, el no... no funciona bien... no le funciona bien su..."
    kia "Desde que ele começou a beber, ele... ele não trabalha bem... o..."

# game/scripts/c13/c13.rpy:183
translate brazilian c13s001_KiaraEileen_2abb1f51:

    # mc "Vale, lo entiendo. No tiene erecciones."
    mc "Certo, entendi. Ele não tem ereções."

# game/scripts/c13/c13.rpy:185
translate brazilian c13s001_KiaraEileen_3da85f71:

    # kia "Sí que las tiene. Pero duran segundos. Y no vuelven a subir. Hace meses que no... que no tenemos relaciones."
    kia "Sim, eu tenho. Mas duram apenas alguns segundos. E não voltam. Já faz meses desde... desde que fizemos sexo."

# game/scripts/c13/c13.rpy:186
translate brazilian c13s001_KiaraEileen_051ea5fd:

    # mc "El alcohol puede tener ese efecto."
    mc "O álcool pode ter esse efeito."

# game/scripts/c13/c13.rpy:188
translate brazilian c13s001_KiaraEileen_d0ea90e7:

    # kia "Pues después de cenar dijo que quería sexo. Había estado bebiendo cerveza durante la cena, y mientras esperaba a que la hiciera, añadiendo aún más alcohol al que llevaba cuando llegué."
    kia "Bem, depois do jantar ela disse que queria sexo. Ela tinha bebido cerveja durante o jantar e, enquanto eu esperava que ela preparasse o pênis, ela continuou adicionando ainda mais álcool ao que já tinha bebido quando cheguei."

# game/scripts/c13/c13.rpy:189
translate brazilian c13s001_KiaraEileen_731cbece:

    # kia "No me apetecía nada. En ese momento estaba frustrada y enfadada. Se lo dije."
    kia "Eu não estava com vontade nenhuma. Naquele momento, eu estava frustrada e irritada. Eu disse isso a ele."

# game/scripts/c13/c13.rpy:190
translate brazilian c13s001_KiaraEileen_c32c4117:

    # mc "Y se puso violento."
    mc "E ele se tornou violento."

# game/scripts/c13/c13.rpy:192
translate brazilian c13s001_KiaraEileen_546b4da9:

    # kia "Levantó la mano para darme una bofetada, pero se paró a tiempo."
    kia "Ele levantou a mão para me dar um tapa, mas se conteve a tempo."

# game/scripts/c13/c13.rpy:193
translate brazilian c13s001_KiaraEileen_4dc08df1:

    # kia "Me entró miedo."
    kia "Eu fiquei com medo."

# game/scripts/c13/c13.rpy:194
translate brazilian c13s001_KiaraEileen_7d291a03:

    # kia "Le seguí a la habitación."
    kia "Eu o segui até o quarto."

# game/scripts/c13/c13.rpy:196
translate brazilian c13s001_KiaraEileen_bad62e5e:

    # kia "Se desnudó y aquello estaba fláccido. No iba a subir..."
    kia "Ele se despiu e estava mole. Não ia ficar duro..."

# game/scripts/c13/c13.rpy:197
translate brazilian c13s001_KiaraEileen_4c73c4a8:

    # kia "Y se enfadó aún más."
    kia "E ele ficou ainda mais irritado."

# game/scripts/c13/c13.rpy:198
translate brazilian c13s001_KiaraEileen_1403f12b:

    # kia "Empezó a culparme a mí. Dijo que ya no me vestía sexy para él nunca. Que ya no le excitaba. Que se iba a buscar una más joven que yo."
    kia "Ele começou a me culpar. Disse que eu nunca mais me vestia de forma sensual para ele. Que eu não o excitava mais. Que ele ia encontrar alguém mais jovem do que eu."

# game/scripts/c13/c13.rpy:199
translate brazilian c13s001_KiaraEileen_38f84272:

    # mc "*Entre dientes* ¡Capullo!"
    mc "*Com os dentes cerrados* Idiota!"

# game/scripts/c13/c13.rpy:201
translate brazilian c13s001_KiaraEileen_27afa0b2:

    # kia "Me cogió por el brazo y empezó a llevarme de habitación en habitación. Enseñándome todo lo que según él estaba mal."
    kia "Ele agarrou meu braço e começou a me levar de um cômodo para o outro, mostrando-me tudo o que ele achava que estava errado."

# game/scripts/c13/c13.rpy:202
translate brazilian c13s001_KiaraEileen_2ec72b42:

    # kia "Platos por fregar... los de {b}SU{/b} comida y los de la cena..."
    kia "Louça para lavar... a do almoço DELE e a do jantar..."

# game/scripts/c13/c13.rpy:203
translate brazilian c13s001_KiaraEileen_0f44a1cc:

    # kia "Alguna ventana no estaba del todo limpia... la compra que habían entregado ese día estaba por guardar... había ropa por poner en la lavadora..."
    kia "Algumas janelas não estavam completamente limpas... as compras entregues naquele dia ainda precisavam ser guardadas... havia roupas para lavar na máquina..."

# game/scripts/c13/c13.rpy:205
translate brazilian c13s001_KiaraEileen_f627363a:

    # eil "Ahí es donde llegué yo... el espectáculo era dantesco. Mi padre en pelotas arrastrando a mi madre, vestida, del brazo por el suelo en la sala de la lavadora..."
    eil "Foi aí que eu entrei... a cena era horrível. Meu pai, completamente nu, arrastando minha mãe, totalmente vestida, pelo braço no chão da lavanderia..."

# game/scripts/c13/c13.rpy:206
translate brazilian c13s001_KiaraEileen_5ce2593c:

    # eil "Había ropa para poner una lavadora a lo sumo. Mi ropa de correr de la mañana, una muda de mi madre y ropa de mi padre. Olía a vómito."
    eil "Havia roupa suficiente para, no máximo, uma lavagem. Minha roupa de corrida matinal, uma muda de roupa da minha mãe e algumas roupas do meu pai. Cheirava a vômito."

# game/scripts/c13/c13.rpy:207
translate brazilian c13s001_KiaraEileen_9e333d94:

    # mc "¿Él no tiene manos? ¿No puede poner la lavadora mientras las dos estáis trabajando?"
    mc "Ele não tem mãos? Ele não pode lavar a roupa enquanto vocês dois trabalham?"

# game/scripts/c13/c13.rpy:209
translate brazilian c13s001_KiaraEileen_037532b9:

    # eil "Eso sería muy degradante para él. ¿Cómo quieres que limpie o ponga a lavar la ropa si tiene a dos mujeres en casa?"
    eil "Isso seria muito humilhante para ele. Como você espera que ele limpe ou lave roupa com duas mulheres em casa?"

# game/scripts/c13/c13.rpy:210
translate brazilian c13s001_KiaraEileen_a94fa32a:

    # eil "Es mejor estar todo el día en el sofá, viendo la tele y bebiendo, y después quejarse de que no hay nada hecho en casa."
    eil "É melhor passar o dia todo no sofá, assistindo TV e bebendo, e depois reclamar que nada é feito em casa."

# game/scripts/c13/c13.rpy:211
translate brazilian c13s001_KiaraEileen_42e46ebe:

    # mc "¿Entonces fue cuando os fuisteis?"
    mc "Então foi aí que você foi embora?"

# game/scripts/c13/c13.rpy:213
translate brazilian c13s001_KiaraEileen_466c8b2b:

    # eil "Entonces es cuando a él le entraron las arcadas. No solo es un borracho. Es un mal bebedor con poco aguante."
    eil "Foi aí que ele começou a engasgar. Ele não é apenas um bêbado. Ele bebe muito mal e tem uma tolerância muito baixa."

# game/scripts/c13/c13.rpy:214
translate brazilian c13s001_KiaraEileen_1bfe4335:

    # eil "Salió corriendo hacia el baño para vomitar."
    eil "Ela correu para o banheiro para vomitar."

# game/scripts/c13/c13.rpy:216
translate brazilian c13s001_KiaraEileen_a0b345bb:

    # kia "Y se quedó dormido encima de la taza del wáter después de hacerlo."
    kia "E depois de fazer isso, ele adormeceu na privada."

# game/scripts/c13/c13.rpy:217
translate brazilian c13s001_KiaraEileen_5a8eb6b5:

    # kia "En ese momento Eileen me convenció para irnos. Cuando se despertara, iba a ser peor."
    kia "Naquele momento, Eileen me convenceu a ir embora. Quando ela acordasse, a situação ia piorar."

# game/scripts/c13/c13.rpy:219
translate brazilian c13s001_KiaraEileen_499d7503:

    # kia "Metí algo de ropa en la bolsa de viaje, los cepillos de dientes y nos fuimos."
    kia "Coloquei algumas roupas na mala de viagem, as escovas de dente, e partimos."

# game/scripts/c13/c13.rpy:220
translate brazilian c13s001_KiaraEileen_25565407:

    # kia "Eileen llamó a su amiga, la policía..."
    kia "Eileen ligou para sua amiga, a polícia..."

# game/scripts/c13/c13.rpy:222
translate brazilian c13s001_KiaraEileen_09f97d02:

    # kia "Aunque le dije que no quería poner una denuncia..."
    kia "Mesmo tendo dito a ele que não queria apresentar queixa..."

# game/scripts/c13/c13.rpy:224
translate brazilian c13s001_KiaraEileen_1b2ac818:

    # eil "La llamaba para saber si podíamos quedarnos en su casa, no para poner una denuncia. Su abuelo se iba hoy y sabía que tendría una habitación libre."
    eil "Liguei para saber se poderíamos ficar na casa dela, não para registrar uma queixa. O avô dela estava de partida hoje, e ela sabia que teria um quarto vago."

# game/scripts/c13/c13.rpy:225
translate brazilian c13s001_KiaraEileen_47d710b1:

    # eil "Pero está en San Diego con sus padres. No le he dicho por qué la llamaba, no quería preocuparla."
    eil "Mas ela está em San Diego com os pais. Não contei a ela por que liguei; não queria preocupá-la."

# game/scripts/c13/c13.rpy:226
translate brazilian c13s001_KiaraEileen_0506f6c5:

    # eil "Y entonces te he llamado a ti. No es que fueras la segunda opción, pero creía que..."
    eil "E então eu te liguei. Não que você fosse minha segunda opção, mas eu pensei..."

# game/scripts/c13/c13.rpy:227
translate brazilian c13s001_KiaraEileen_cfde5b02:

    # mc "Que si tu madre hablaba con una policía, Alexia la convencería para poner la denuncia."
    mc "Se sua mãe falasse com um policial, Alexia a convenceria a registrar uma queixa."

# game/scripts/c13/c13.rpy:229
translate brazilian c13s001_KiaraEileen_7cb453b2:

    # eil "Al menos la haría entrar en razón. En ese momento mi madre estaba diciendo que buscásemos algún sitio donde pasar esta noche."
    eil "Ao menos isso a faria enxergar a razão. Naquele momento, minha mãe estava dizendo que deveríamos encontrar algum lugar para passar a noite."

# game/scripts/c13/c13.rpy:230
translate brazilian c13s001_KiaraEileen_0dce7da8:

    # eil "Sólo esta noche..."
    eil "Somente esta noite..."

# game/scripts/c13/c13.rpy:232
translate brazilian c13s001_KiaraEileen_5863b783:

    # kia "¿Qué querías que hiciera? ¿Que abandonase a mi marido y mi casa? Todos los matrimonios tienen problemas..."
    kia "O que você queria que eu fizesse? Abandonar meu marido e minha casa? Todos os casamentos têm problemas..."

# game/scripts/c13/c13.rpy:233
translate brazilian c13s001_KiaraEileen_ab6bae3b:

    # mc "Creo que es lo mejor, al menos por unos días. Que le vea las orejas al lobo."
    mc "Acho que é o melhor a fazer, pelo menos por alguns dias. Que ele veja o lobo à porta."

# game/scripts/c13/c13.rpy:234
translate brazilian c13s001_KiaraEileen_72b0ae97:

    # mc "A lo mejor reacciona y vuelve a dejar la bebida..."
    mc "Talvez ele caia em si e pare de beber de novo..."

# game/scripts/c13/c13.rpy:236
translate brazilian c13s001_KiaraEileen_11435d8b:

    # eil "Es lo que le he dicho. Una semana como mínimo. Al final ha aceptado. Mañana buscaremos un hotel."
    eil "Foi isso que eu disse a ele. Pelo menos uma semana. Ele finalmente concordou. Procuraremos um hotel amanhã."

# game/scripts/c13/c13.rpy:237
translate brazilian c13s001_KiaraEileen_f27e6e78:

    # mc "No hace falta. Tenéis esta habitación para vosotras todo el tiempo que queráis."
    mc "Não precisa. Vocês têm este quarto só para vocês pelo tempo que quiserem."

# game/scripts/c13/c13.rpy:239
translate brazilian c13s001_KiaraEileen_405969b9:

    # kia "No podemos hacerte eso. No podemos echarte de tu habitación durante una semana. Mañana buscamos un hotel o algo donde quedarnos unos días."
    kia "Não podemos fazer isso com você. Não podemos expulsá-lo do seu quarto por uma semana. Amanhã encontraremos um hotel ou algum lugar para ficarmos por alguns dias."

# game/scripts/c13/c13.rpy:240
translate brazilian c13s001_KiaraEileen_278fe9f3:

    # mc "Entonces, en casa de [nor] hay una habitación vacía. Es para las estudiantes que llegan en otoño. Al menos hasta entonces la podéis usar."
    mc "Então, há um quarto vago na casa de [nor]. É para os estudantes que chegam no outono. Você pode usá-lo pelo menos até lá."

# game/scripts/c13/c13.rpy:241
translate brazilian c13s001_KiaraEileen_f61f3aa7:

    # mc "A [nor] no le va a importar en el momento en que sepa vuestra situación, os lo aseguro. Al menos la situación que queráis explicarle."
    mc "[nor] não se importará quando souber da sua situação, garanto. Pelo menos não da situação que você quer explicar a ele."

# game/scripts/c13/c13.rpy:243
translate brazilian c13s001_KiaraEileen_668d609e:

    # eil "¿De verdad crees que nos va a dejar dormir en su casa?"
    eil "Você acha mesmo que ele vai deixar a gente dormir na casa dele?"

# game/scripts/c13/c13.rpy:244
translate brazilian c13s001_KiaraEileen_ff59411a:

    # mc "Eile, a [nor] siempre le has gustado. No va a tener ningún problema con ello. ¿Cuánto hace que no la ves?"
    mc "Eile, [nor] sempre gostou de você. Ela não terá nenhum problema com isso. Há quanto tempo você não a vê?"

# game/scripts/c13/c13.rpy:246
translate brazilian c13s001_KiaraEileen_85f495a6:

    # eil "Mucho. No tengo ni idea de cuanto... ¿un año? ¿dos? Al contrario que tú, cuando ella lleva a [eri] al trabajo, no entra a tomarse ni siquiera un café."
    eil "Muito tempo. Não faço ideia de quanto tempo... um ano? Dois? Ao contrário de você, quando ela leva [eri] para o trabalho, ela nem entra para tomar um café."

# game/scripts/c13/c13.rpy:247
translate brazilian c13s001_KiaraEileen_d46540c0:

    # mc "Entonces no te diré nada. Por la mañana te llevarás una pequeña sorpresa."
    mc "Então não vou te contar nada. Você terá uma pequena surpresa pela manhã."

# game/scripts/c13/c13.rpy:248
translate brazilian c13s001_KiaraEileen_b94084a4:

    # mc "Creo que con esto está todo arreglado, al menos el alojamiento. ¿Necesitáis algo más?"
    mc "Acho que isso cobre tudo, pelo menos a acomodação. Precisa de mais alguma coisa?"

# game/scripts/c13/c13.rpy:250
translate brazilian c13s001_KiaraEileen_80032951:

    # kia "Si nos vamos a quedar una semana, deberíamos pasar por casa a buscar más ropa. Metí ropa para un par de días en la bolsa. Y ni siquiera los pijamas..."
    kia "Se vamos ficar uma semana, devemos passar em casa para pegar mais roupas. Só coloquei na mala o suficiente para uns dois dias. E nem pijama..."

# game/scripts/c13/c13.rpy:251
translate brazilian c13s001_KiaraEileen_d2d77d32:

    # mc "Yo de vosotras no iría mientras Solomon esté allí, o al menos no solas. Si queréis os acompaño."
    mc "Eu não iria se fosse você enquanto Solomon estiver lá, ou pelo menos não sozinho. Se você quiser, posso ir com você."

# game/scripts/c13/c13.rpy:253
translate brazilian c13s001_KiaraEileen_d58ee944:

    # eil "Yo puedo aguantar dos o tres días perfectamente. Los jueves por la noche mi padre se va de copas con sus amigos y podríamos ir a casa."
    eil "Consigo facilmente ficar dois ou três dias. Nas noites de quinta-feira, meu pai sai para beber com os amigos, e nós poderíamos ir à casa dele."

# game/scripts/c13/c13.rpy:254
translate brazilian c13s001_KiaraEileen_4e4e6a42:

    # mc "Kiara, ¿tú tienes ropa para aguantar hasta el jueves? Si no, habiendo 11 mujeres en casa, seguro que alguna os puede dejar ropa. O podéis coger mis camisetas; os quedan geniales."
    mc "Kiara, você tem roupa suficiente até quinta-feira? Se não, com 11 mulheres em casa, tenho certeza de que alguma delas pode te emprestar. Ou você pode pegar minhas camisetas; elas ficam ótimas em você."

# game/scripts/c13/c13.rpy:255
translate brazilian c13s001_KiaraEileen_ad312c1d:

    # mc "Además, aunque vivamos en medio de la nada, también tenemos lavadoras. *Risa*"
    mc "Além disso, mesmo morando no meio do nada, também temos máquinas de lavar. *Risos*"

# game/scripts/c13/c13.rpy:257
translate brazilian c13s001_KiaraEileen_814c0592:

    # kia "No te preocupes, cogí mi ropa de trabajo y dos uniformes para Eileen, eso es lo más importante. El resto se puede comprar o lavar hasta que el jueves podamos volver."
    kia "Não se preocupe, eu arrumei minhas roupas de trabalho e dois uniformes para a Eileen; isso é o mais importante. O resto podemos comprar ou lavar até voltarmos na quinta-feira."

# game/scripts/c13/c13.rpy:258
translate brazilian c13s001_KiaraEileen_9445b609:

    # mc "Ahora que pienso, el miércoles vuelve Alexia, con lo que también nos podría acompañar el jueves si fuera necesario. Tener una policía cerca impone."
    mc "Pensando bem, a Alexia volta na quarta-feira, então ela também poderia se juntar a nós na quinta, se necessário. Ter um policial por perto é intimidante."

# game/scripts/c13/c13.rpy:259
translate brazilian c13s001_KiaraEileen_8ea7b98f:

    # mc "Y, una vez aclarado todo esto, os voy a dejar dormir."
    mc "E, assim que tudo isso estiver esclarecido, vou deixar você dormir."

# game/scripts/c13/c13.rpy:261
translate brazilian c13s001_KiaraEileen_416c371b:

    # mc "¿Puedo hablar un momento en privado contigo, Eileen?"
    mc "Posso falar com você em particular por um instante, Eileen?"

# game/scripts/c13/c13.rpy:263
translate brazilian c13s001_KiaraEileen_7afdc227:

    # eil "Sí, vamos fuera. Ahora vuelvo, Mamá."
    eil "Sim, vamos lá fora. Já volto, mãe."

# game/scripts/c13/c13.rpy:265
translate brazilian c13s001_KiaraEileen_05097a2b:

    # kia "No es necesario. Voy al lavabo y os dejo un poco de privacidad. ¿Cuánto tiempo necesitáis?"
    kia "Não precisa. Vou ao banheiro e te darei privacidade. De quanto tempo você precisa?"

# game/scripts/c13/c13.rpy:266
translate brazilian c13s001_KiaraEileen_8572b191:

    # mc "*Risa* No es eso, Kiara. No vamos a enrollarnos aquí... al menos no hoy. *Risa*"
    mc "*Risos* Não é isso, Kiara. Não vamos nos envolver nisso... pelo menos não hoje. *Risos*"

# game/scripts/c13/c13.rpy:267
translate brazilian c13s001_KiaraEileen_1f6f2478:

    # kia "*Risa* Vale, pues vuelvo en cinco minutos. ¿Tendrás suficiente?"
    kia "*Risos* Ok, volto em cinco minutos. Será tempo suficiente?"

# game/scripts/c13/c13.rpy:268
translate brazilian c13s001_KiaraEileen_53c320af:

    # mc "Sí, por supuesto. La primera puerta a la izquierda una vez pases el gimnasio."
    mc "Sim, claro. A primeira porta à esquerda depois de passar o ginásio."

# game/scripts/c13/c13.rpy:270
translate brazilian c13s001_KiaraEileen_3c732c7a:

    # eil "¿De qué querías hablar que no pudieras hablar delante de mi madre?"
    eil "Sobre o que você queria conversar que não pôde conversar na frente da minha mãe?"

# game/scripts/c13/c13.rpy:273
translate brazilian c13s001_KiaraEileen_e87a4a31:

    # mc "Ya sabes que estoy con [eri]. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Você sabe que estou com [eri]. Só quero que a Kiara saiba que ela pode ver coisas que a surpreendam, e não quero que ela pense que estou te enganando."

# game/scripts/c13/c13.rpy:275
translate brazilian c13s001_KiaraEileen_4cf7ce64:

    # mc "Ya sabes que estoy con Alexia. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Você sabe que estou com a Alexia. Só quero que a Kiara saiba que ela pode ver coisas que a surpreendam, e não quero que ela pense que estou te traindo."

# game/scripts/c13/c13.rpy:277
translate brazilian c13s001_KiaraEileen_9b77594e:

    # mc "Ya sabes que estoy con alguien más. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Você sabe que estou saindo com outra pessoa. Só quero que a Kiara saiba que ela pode ver coisas que a surpreendam, e não quero que ela pense que estou te traindo."

# game/scripts/c13/c13.rpy:279
translate brazilian c13s001_KiaraEileen_e8ce2c07:

    # eil "Tienes razón, no había caído en eso. Le diré lo especial de nuestra relación para que no te saque los ojos si te ve en los brazos de otra."
    eil "Você tem razão, eu não tinha pensado nisso. Vou contar para ele o quão especial é o nosso relacionamento para que ele não arranque seus olhos se te vir nos braços de outro."

# game/scripts/c13/c13.rpy:280
translate brazilian c13s001_KiaraEileen_85ef00a7:

    # mc "Además..."
    mc "Além do mais..."

# game/scripts/c13/c13.rpy:282
translate brazilian c13s001_KiaraEileen_7435106d:

    # mc "Me moría por besarte antes de ir a dormir."
    mc "Eu estava louca para te dar um beijo antes de dormir."

# game/scripts/c13/c13.rpy:285
translate brazilian c13s001_KiaraEileen_ab44b008:

    # mc "Tan solo me moría por besarte antes de ir a dormir."
    mc "Eu estava louca para te dar um beijo antes de dormir."

# game/scripts/c13/c13.rpy:286
translate brazilian c13s001_KiaraEileen_b919e696:

    # eil "No te tienes que esconder de mi madre para besarme. Ni de mi madre ni de nadie. Soy una adulta y puedo besar a quien quiera. Y al único que quiero besar es a ti."
    eil "Você não precisa se esconder da minha mãe para me beijar. Nem da minha mãe, nem de ninguém. Sou adulta e posso beijar quem eu quiser. E a única pessoa que eu quero beijar é você."

# game/scripts/c13/c13.rpy:287
translate brazilian c13s001_KiaraEileen_a4eab181:

    # eil "Si necesitas decirle a alguien que salimos juntos, puedes hacerlo. Yo tampoco me tengo que esconder."
    eil "Se você precisar contar para alguém que estamos namorando, pode contar. Eu também não preciso esconder isso."

# game/scripts/c13/c13.rpy:288
translate brazilian c13s001_KiaraEileen_1c7cd109:

    # mc "Entonces no me esconderé. Me voy a ir a mi sofá y os voy a dejar descansar... Un poco más y me olvido de coger la ropa."
    mc "Então não vou me esconder. Vou para o meu sofá e deixo vocês descansarem... Quase me esqueci de me vestir."

# game/scripts/c13/c13.rpy:290
translate brazilian c13s001_KiaraEileen_50dfb39e:

    # mc "Hasta mañana, mi amor."
    mc "Até amanhã, meu amor."

# game/scripts/c13/c13.rpy:291
translate brazilian c13s001_KiaraEileen_73d51b30:

    # eil "Hasta mañana, mi vida. Te quiero."
    eil "Até amanhã, meu amor. Eu te amo."

# game/scripts/c13/c13.rpy:292
translate brazilian c13s001_KiaraEileen_90083b80:

    # mc "Y yo a ti."
    mc "E eu você."

# game/scripts/c13/c13.rpy:295
translate brazilian c13s001_KiaraEileen_b47b16b6:

    # kia "¿Dónde has dicho que estaba el lavabo?"
    kia "Onde você disse que ficava a pia?"

# game/scripts/c13/c13.rpy:296
translate brazilian c13s001_KiaraEileen_f445e6ec:

    # mc "La primera puerta a la izquierda una vez pases el gimnasio."
    mc "A primeira porta à esquerda depois de passar pelo ginásio."

# game/scripts/c13/c13.rpy:298
translate brazilian c13s001_KiaraEileen_f364d0f9:

    # eil "Gracias por todo, [mc]. No sé qué hubiéramos hecho sin ti hoy."
    eil "Obrigado por tudo, [mc]. Não sei o que teríamos feito sem você hoje."

# game/scripts/c13/c13.rpy:299
translate brazilian c13s001_KiaraEileen_e53ba6e2:

    # mc "Para eso estamos los amigos. Ya sabes que puedes contar conmigo para lo que necesites."
    mc "É para isso que servem os amigos. Você sabe que pode contar comigo para tudo o que precisar."

# game/scripts/c13/c13.rpy:301
translate brazilian c13s001_KiaraEileen_c4cd41ac:

    # eil "Cuánto te he echado de menos estos tres años. No hay hombres como tú."
    eil "Como senti sua falta nesses últimos três anos. Não existem homens como você."

# game/scripts/c13/c13.rpy:302
translate brazilian c13s001_KiaraEileen_8193145e:

    # mc "¿Como yo? Espera... ¿cómo me llamabas cuando salíamos juntos? ¿Cabeza hueca?"
    mc "Gosta de mim? Espera... como você me chamava quando a gente namorava? Cabeça de vento?"

# game/scripts/c13/c13.rpy:304
translate brazilian c13s001_KiaraEileen_8f3c4879:

    # eil "No, eso era lo que tú llamabas me llamabas a mí cuando empezamos a salir. *Risa*"
    eil "Não, era assim que você me chamava quando começamos a namorar. *Risos*"

# game/scripts/c13/c13.rpy:305
translate brazilian c13s001_KiaraEileen_cdd0ac73:

    # mc "Bueno, te voy a dejar descansar. Tienes que estar agotada después de trabajar y todo el problema que te has encontrado al llegar a casa."
    mc "Certo, vou deixar você descansar. Você deve estar exausto depois do trabalho e de todos os problemas que enfrentou ao chegar em casa."

# game/scripts/c13/c13.rpy:306
translate brazilian c13s001_KiaraEileen_41ad32af:

    # mc "Hasta mañana, Eile."
    mc "Até amanhã, Eile."

# game/scripts/c13/c13.rpy:307
translate brazilian c13s001_KiaraEileen_3fd283cd:

    # eil "Hasta mañana, [mc]."
    eil "Até amanhã, [mc]."

# game/scripts/c13/c13.rpy:309
translate brazilian c13s001_KiaraEileen_3523084d:

    # kia "¿Ya te marchas?"
    kia "Você já vai embora?"

# game/scripts/c13/c13.rpy:310
translate brazilian c13s001_KiaraEileen_2821dae0:

    # mc "Sí, es tarde y tenéis que descansar. Mañana tengo que ir a un par de sitios, pero si te despiertas pronto puedo llevarte al hospital."
    mc "Sim, já é tarde e você precisa descansar. Tenho que ir a alguns lugares amanhã, mas se você acordar cedo, posso te levar ao hospital."

# game/scripts/c13/c13.rpy:312
translate brazilian c13s001_KiaraEileen_4630e054:

    # kia "[mc], ya te he dicho que no quería poner una denuncia..."
    kia "[mc], eu já disse que não queria apresentar queixa..."

# game/scripts/c13/c13.rpy:313
translate brazilian c13s001_KiaraEileen_59f239a8:

    # mc "Te dejaré en manos de una enfermera que es buena amiga también. Si no quieres poner denuncia, no te va a obligar, pero al menos verá como está ese hematoma."
    mc "Vou deixar você com uma enfermeira que também é uma boa amiga. Se você não quiser prestar queixa, ela não vai te obrigar, mas pelo menos vai dar uma olhada nesse hematoma."

# game/scripts/c13/c13.rpy:315
translate brazilian c13s001_KiaraEileen_2066e28b:

    # "Kiara te abraza con fuerza. Es un abrazo que dice a gritos que está herida, más allá de las heridas físicas, que es vulnerable, y que necesita esa curación que dice que tus abrazos ofrecen."
    "Kiara te abraça com força. É um abraço que grita que ela está sofrendo, além das feridas físicas, que ela está vulnerável e que precisa da cura que, segundo ela, seus abraços oferecem."

# game/scripts/c13/c13.rpy:316
translate brazilian c13s001_KiaraEileen_cd4373aa:

    # kia "Gracias, [mc]. Por darnos un techo y por entender mi decisión sobre la denuncia."
    kia "Obrigado, [mc]. Por nos dar um teto sobre nossas cabeças e por entender minha decisão de apresentar a queixa."

# game/scripts/c13/c13.rpy:317
translate brazilian c13s001_KiaraEileen_c06cd2f2:

    # mc "No la comparto ni la comprendo, pero tengo que respetarla. No puedo obligarte a presentar una denuncia si no quieres."
    mc "Não concordo com isso nem entendo, mas tenho que respeitar. Não posso obrigá-lo(a) a apresentar uma queixa se não quiser."

# game/scripts/c13/c13.rpy:318
translate brazilian c13s001_KiaraEileen_d4dbd92c:

    # "Pasáis unos minutos en silencio, disfrutando del abrazo. Kiara se separa de ti reluctantemente."
    "Vocês passam alguns minutos em silêncio, aproveitando o abraço. Kiara, relutantemente, se afasta de você."

# game/scripts/c13/c13.rpy:320
translate brazilian c13s001_KiaraEileen_fa9f4ae1:

    # kia "Buenas noches, [mc]. Que descanses bien."
    kia "Boa noite, [mc]. Durma bem."

# game/scripts/c13/c13.rpy:321
translate brazilian c13s001_KiaraEileen_556ca554:

    # mc "Buenas noches, Kiara. Duerme todo lo que puedas."
    mc "Boa noite, Kiara. Durma o máximo que puder."

# game/scripts/c13/c13.rpy:348
translate brazilian c13s001_SleepingInTheCouch_c4d9422a:

    # "Vuelves a la tercera planta después de cambiarte a algo más cómodo para dormir."
    "Você retorna ao terceiro andar depois de trocar de roupa e vestir algo mais confortável para dormir."

# game/scripts/c13/c13.rpy:349
translate brazilian c13s001_SleepingInTheCouch_e2a8a1db:

    # "Nunca pensaste que echarías de menos a Lisa en ese sofá."
    "Você nunca imaginou que sentiria falta da Lisa naquele sofá."

# game/scripts/c13/c13.rpy:351
translate brazilian c13s001_SleepingInTheCouch_4f7bd40e:

    # "Te tumbas mirando al techo. Sabes que te va a costar dormirte después de los eventos de la noc...zzzz"
    "Você se deita encarando o teto. Sabe que vai ser difícil pegar no sono depois dos acontecimentos da noite... zzzz"

# game/scripts/c13/c13.rpy:353
translate brazilian c13s001_SleepingInTheCouch_83246def:

    # centered "{size=+20}{b}DIA 15 - MARTES \n 6:13{/b}{/size}"
    centered "{size=+20}{b}DIA 15 - TERÇA-FEIRA \n 6:13{/b}{/size}"

# game/scripts/c13/c13.rpy:354
translate brazilian c13s001_SleepingInTheCouch_bc02ef79:

    # "Te despiertan unos pasos y la puerta del baño que se cierra."
    "Você é acordado por passos e pelo som da porta do banheiro se fechando."

# game/scripts/c13/c13.rpy:356
translate brazilian c13s001_SleepingInTheCouch_22bfb38d:

    # "Miras el reloj del móvil. Las 6:13. Difícilmente vas a poder volver a dormirte. Ya ha amanecido."
    "Você olha para o relógio do seu celular. 6h13. É improvável que você consiga voltar a dormir. Já é amanhecer."

# game/scripts/c13/c13.rpy:359
translate brazilian c13s001_SleepingInTheCouch_a44d8959:

    # kat "Buenos días, [mc]. ¿Qué haces aquí? ¿Esperando a Lisa?"
    kat "Bom dia, [mc]. O que você está fazendo aqui? Esperando a Lisa?"

# game/scripts/c13/c13.rpy:360
translate brazilian c13s001_SleepingInTheCouch_c20e358c:

    # mc "No, hay dos chicas en mi habitación y quería dejarlas dormir tranquilamente."
    mc "Não, há duas meninas no meu quarto e eu queria deixá-las dormir em paz."

# game/scripts/c13/c13.rpy:362
translate brazilian c13s001_SleepingInTheCouch_688fa6ff:

    # kat "¿Dos chicas en tu habitación? ¡Tenemos un macho en la casa!"
    kat "Duas garotas no seu quarto? Tem um homem na casa!"

# game/scripts/c13/c13.rpy:363
translate brazilian c13s001_SleepingInTheCouch_a34a775e:

    # mc "*Risa* No, no va por ahí. Son dos amigas que necesitaban un sitio donde pasar la noche. Les he prestado mi cama."
    mc "*Risos* Não, não é isso. São dois amigos que precisavam de um lugar para passar a noite. Eu emprestei minha cama para eles."

# game/scripts/c13/c13.rpy:365
translate brazilian c13s001_SleepingInTheCouch_620057e0:

    # kat "Entonces no es un macho, es un caballero. Podemos hacer un intercambio. Subo yo a tu habitación y tu duermes en mi cama. *Risa*"
    kat "Então ele não é machão, ele é um cavalheiro. Podemos fazer uma troca. Eu subo para o seu quarto e você dorme na minha cama. *Risos*"

# game/scripts/c13/c13.rpy:366
translate brazilian c13s001_SleepingInTheCouch_0ed05e30:

    # mc "*Risa* Creo que os lo podríais pasar muy bien juntas, pero creo que no como tú esperarías."
    mc "*Risos* Acho que vocês dois poderiam se divertir muito juntos, mas não da maneira que vocês imaginam."

# game/scripts/c13/c13.rpy:367
translate brazilian c13s001_SleepingInTheCouch_07a63ac4:

    # mc "Una era mi novia en el instituto y la otra es su madre. Casada. Con un hombre."
    mc "Uma era minha namorada do ensino médio, e a outra é a mãe dela. Casada. Com um homem."

# game/scripts/c13/c13.rpy:369
translate brazilian c13s001_SleepingInTheCouch_5ade8e4a:

    # kat "*Risa* Entonces no te cambio la cama. Además, Kim se podría asustar si se despierta y te ve a ti en vez de a mí."
    kat "*Risos* Então não vou trocar sua cama. Além disso, a Kim pode ficar assustada se acordar e te ver em vez de mim."

# game/scripts/c13/c13.rpy:371
translate brazilian c13s001_SleepingInTheCouch_0f251b26:

    # kat "Después de lo que le dijiste ayer del mapa de su piel... creo que la hiciste feliz por todo el día."
    kat "Depois do que você contou a ela ontem sobre o mapa da pele dela... acho que você a deixou feliz o dia todo."

# game/scripts/c13/c13.rpy:372
translate brazilian c13s001_SleepingInTheCouch_bb4228c0:

    # mc "*Risa* Lo más divertido de todo es que no lo dije sobre ella en concreto, sino que lo dije en un hipotético caso. Además sonó muy cursi."
    mc "*Risos* O mais engraçado é que eu não disse isso sobre ela especificamente, mas sim em um cenário hipotético. Também soou muito brega."

# game/scripts/c13/c13.rpy:374
translate brazilian c13s001_SleepingInTheCouch_3b9a9045:

    # kat "Después de lo que le dijiste ayer sobre su piel... creo que aún está enfadada contigo."
    kat "Depois do que você disse a ela ontem sobre a pele dela... acho que ela ainda está chateada com você."

# game/scripts/c13/c13.rpy:375
translate brazilian c13s001_SleepingInTheCouch_0c54b117:

    # mc "Bueno, no era mi intención enfadarla, tan solo es que... creo que tenía razón si tanto le molesta llamar la atención."
    mc "Bem, eu não queria chateá-la, é só que... acho que ela tinha razão se se incomoda tanto em ser o centro das atenções."

# game/scripts/c13/c13.rpy:377
translate brazilian c13s001_SleepingInTheCouch_eaf840b2:

    # kat "¿Te importa que me siente?"
    kat "Você se importa se eu me sentar?"

# game/scripts/c13/c13.rpy:378
translate brazilian c13s001_SleepingInTheCouch_c87da1de:

    # mc "Por supuesto que no. Soy yo quien ha invadido vuestra planta."
    mc "Claro que não. Fui eu quem invadiu sua planta."

# game/scripts/c13/c13.rpy:379
translate brazilian c13s001_SleepingInTheCouch_8cd07e23:

    # kat "Y nosotras hemos invadido tu casa. Lo podríamos llamar un empate."
    kat "E nós invadimos sua casa. Podemos considerar um empate."

# game/scripts/c13/c13.rpy:380
translate brazilian c13s001_SleepingInTheCouch_31ab9b11:

    # mc "¿Qué tal la adaptación a la nueva casa y a la nueva universidad?"
    mc "Como está sendo a adaptação à nova casa e à nova universidade?"

# game/scripts/c13/c13.rpy:382
translate brazilian c13s001_SleepingInTheCouch_a9cde451:

    # kat "La universidad está genial. Tiene un muy buen programa de oceanografía y está cerca del mar. Estudiar en Phoenix sobre acuarios no tiene el mismo valor."
    kat "A universidade é ótima. Tem um programa de oceanografia muito bom e fica perto do mar. Estudar aquários em Phoenix não tem o mesmo valor."

# game/scripts/c13/c13.rpy:383
translate brazilian c13s001_SleepingInTheCouch_5aa8514f:

    # mc "Está bien, es una universidad relativamente pequeña, pero de muy buen nivel."
    mc "É uma universidade relativamente pequena, mas de altíssimo nível."

# game/scripts/c13/c13.rpy:384
translate brazilian c13s001_SleepingInTheCouch_f4b5c5b2:

    # mc "¿Y la casa? ¿Algún problema hasta ahora?"
    mc "E a casa? Algum problema até agora?"

# game/scripts/c13/c13.rpy:386
translate brazilian c13s001_SleepingInTheCouch_138040f8:

    # kat "La casa es impresionante. Creía que siendo tan pocas podía haber problemas entre nosotras. Ya sabes... ser la primera gallina del corral y esas cosas."
    kat "A casa é incrível. Pensei que, com tão poucos de nós, poderiam surgir problemas entre nós. Sabe... ser a primeira galinha no galinheiro e tudo mais."

# game/scripts/c13/c13.rpy:387
translate brazilian c13s001_SleepingInTheCouch_f34c0968:

    # kat "Además, ya conocía a Lisa y me imaginaba que iba a luchar por esa posición. Pero me está sorprendiendo mucho. Parece una mujer diferente de la de Phoenix."
    kat "Além disso, eu já conhecia a Lisa e imaginava que ela lutaria por essa posição. Mas ela está me surpreendendo muito. Ela parece uma mulher completamente diferente daquela de Phoenix."

# game/scripts/c13/c13.rpy:388
translate brazilian c13s001_SleepingInTheCouch_a3db4774:

    # mc "Parece incluso una mujer diferente de la que llegó el viernes al aeropuerto."
    mc "Ela parece até uma mulher completamente diferente daquela que chegou ao aeroporto na sexta-feira."

# game/scripts/c13/c13.rpy:390
translate brazilian c13s001_SleepingInTheCouch_4cc0eb54:

    # kat "No sé que le dais de comer, pero seguid haciéndolo. Me gusta más esta Lisa."
    kat "Não sei o que você dá para ela comer, mas continue. Eu gosto mais dessa Lisa."

# game/scripts/c13/c13.rpy:391
translate brazilian c13s001_SleepingInTheCouch_3bf2b707:

    # mc "A mí también. Hoy llega la última chica. Saira, de India."
    mc "Eu também. Hoje chega a última garota. Saira, da Índia."

# game/scripts/c13/c13.rpy:393
translate brazilian c13s001_SleepingInTheCouch_62533d58:

    # kat "¡Oh! ¿Una belleza exótica?"
    kat "Oh! Uma beleza exótica?"

# game/scripts/c13/c13.rpy:394
translate brazilian c13s001_SleepingInTheCouch_7e936e1f:

    # mc "Sí, lo es. Es una preciosidad. Nos conocemos de Portland."
    mc "Sim, é verdade. É lindo. Nos conhecemos de Portland."

# game/scripts/c13/c13.rpy:395
translate brazilian c13s001_SleepingInTheCouch_f08cc311:

    # kat "¿Otra ex-novia?"
    kat "Outra ex-namorada?"

# game/scripts/c13/c13.rpy:396
translate brazilian c13s001_SleepingInTheCouch_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Sim, por que você pergunta?"

# game/scripts/c13/c13.rpy:398
translate brazilian c13s001_SleepingInTheCouch_1bfae0f9:

    # kat "Tienes a tu ex-novia del instituto durmiendo en tu habitación y vas a tener a tu ex-novia de la universidad durmiendo justo debajo."
    kat "Você tem sua ex-namorada do ensino médio dormindo no seu quarto e sua ex-namorada da faculdade vai dormir logo abaixo."

# game/scripts/c13/c13.rpy:399
translate brazilian c13s001_SleepingInTheCouch_d3afcc31:

    # kat "¿Tú has oido la expresión \"Pelea de Gatas\"?"
    kat "Você já ouviu a expressão \"briga de gatas\"?"

# game/scripts/c13/c13.rpy:400
translate brazilian c13s001_SleepingInTheCouch_57a8f307:

    # mc "Ni Eileen ni Saira son así."
    mc "Nem Eileen nem Saira são assim."

# game/scripts/c13/c13.rpy:402
translate brazilian c13s001_SleepingInTheCouch_58666c43:

    # kat "¿Eileen? ¿Pelirroja? ¿Guapísima? ¿Ojos azules? ¿Compañera de trabajo de [eri]?"
    kat "Eileen? Ruiva? Linda? Olhos azuis? Colega de trabalho de [eri]?"

# game/scripts/c13/c13.rpy:403
translate brazilian c13s001_SleepingInTheCouch_3f08eb51:

    # mc "Sí, ¿por qué?"
    mc "Sim, por quê?"

# game/scripts/c13/c13.rpy:405
translate brazilian c13s001_SleepingInTheCouch_39339162:

    # kat "¡Eres mi héroe! Si estando tan gordo como estabas en el instituto conseguiste que esa belleza se fijara en ti, hay esperanzas para el resto de nosotras."
    kat "Você é meu herói! Se você conseguiu chamar a atenção daquela gata quando você era tão gordinho quanto era no ensino médio, ainda há esperança para o resto de nós."

# game/scripts/c13/c13.rpy:412
translate brazilian c13s001_SleepingInTheCouch_6bb56f62:

    # mc "Y no solo a cualquier chica. A cualquier persona. Eres divertida, inteligente, guapa..."
    mc "E não para qualquer garota. Para qualquer uma. Você é engraçada, inteligente, linda..."

# game/scripts/c13/c13.rpy:414
translate brazilian c13s001_SleepingInTheCouch_f8619787:

    # kat "[mc], ¿me estás tirando los trastos? *Risa* Por si no lo recuerdas, no me interesan los hombres... desde hace mucho."
    kat "[mc], você está dando em cima de mim? *Risos* Caso você tenha esquecido, eu não tenho interesse em homens... há muito tempo."

# game/scripts/c13/c13.rpy:415
translate brazilian c13s001_SleepingInTheCouch_0c9edb7a:

    # mc "{b}¿Qué? ¡No!{/b} * Risa* Eres de las pocas mujeres a quien le puedo decir que es guapa y que no se lo tomen como que quiero algo con ellas. No te estoy tirando los trastos, pero podría hacerlo."
    mc "{b}O quê? Não!{/b} *Risos* Você é uma das poucas mulheres que eu posso dizer que é bonita sem que elas interpretem como se eu quisesse algo com elas. Eu não estou dando em cima de você, mas eu poderia."

# game/scripts/c13/c13.rpy:417
translate brazilian c13s001_SleepingInTheCouch_216fab8c:

    # kat "¿A qué te refieres exactamente?"
    kat "O que exatamente você quer dizer?"

# game/scripts/c13/c13.rpy:418
translate brazilian c13s001_SleepingInTheCouch_d5332a23:

    # mc "Me caes muy bien. Ya te he dicho que eres divertida, inteligente, guapa... podría seguir con que tienes un gran sentido del humor, que no te dejas avasallar, que no tienes complejos..."
    mc "Eu gosto muito de você. Já te disse que você é engraçada, inteligente, linda... Eu poderia continuar falando sobre como você tem um ótimo senso de humor, como você não se deixa intimidar, como você não tem traumas..."

# game/scripts/c13/c13.rpy:420
translate brazilian c13s001_SleepingInTheCouch_87ddd219:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, eu provavelmente tomaria a iniciativa. Acho que você também gosta de mim."

# game/scripts/c13/c13.rpy:422
translate brazilian c13s001_SleepingInTheCouch_7b43f6fb:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, eu poderia tomar a iniciativa. Ainda não tenho certeza se você gostaria de mim."

# game/scripts/c13/c13.rpy:424
translate brazilian c13s001_SleepingInTheCouch_92bb93f5:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, talvez eu tentasse algo com você. Mas duvido que daria certo. Acho que você não gostaria de mim."

# game/scripts/c13/c13.rpy:427
translate brazilian c13s001_SleepingInTheCouch_ac349b40:

    # mc "Estuve en el lugar correcto en el momento correcto. Dudo que alguien como yo era entonces pudiera conseguir a alguien como Eileen en circunstancias normales."
    mc "Eu estava no lugar certo na hora certa. Duvido que alguém como eu naquela época pudesse ter conquistado alguém como a Eileen em circunstâncias normais."

# game/scripts/c13/c13.rpy:429
translate brazilian c13s001_SleepingInTheCouch_f66b080e:

    # kat "Eso quiere decir que, según tú yo no podría conseguir estar con alguien como Kim o a alguien como tú si me interesaran los hombres, ¿no? Suerte que no me interesan... desde hace mucho."
    kat "Então, segundo você, eu não poderia ficar com alguém como a Kim ou alguém como você se eu tivesse interesse em homens, certo? Felizmente, não tenho interesse neles... há muito tempo."

# game/scripts/c13/c13.rpy:430
translate brazilian c13s001_SleepingInTheCouch_39c6d0f0:

    # mc "Dependería mucho de la otra persona."
    mc "Isso dependeria muito da outra pessoa."

# game/scripts/c13/c13.rpy:432
translate brazilian c13s001_SleepingInTheCouch_216fab8c_1:

    # kat "¿A qué te refieres exactamente?"
    kat "O que exatamente você quer dizer?"

# game/scripts/c13/c13.rpy:433
translate brazilian c13s001_SleepingInTheCouch_6beb8512:

    # mc "A mí me caes muy bien. Eres divertida, inteligente, guapa, tienes un gran sentido del humor, no te dejas avasallar, no tienes complejos..."
    mc "Gosto muito de você. Você é engraçada, inteligente, linda, tem um ótimo senso de humor, não se deixa intimidar, não tem traumas..."

# game/scripts/c13/c13.rpy:435
translate brazilian c13s001_SleepingInTheCouch_87ddd219_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, eu provavelmente tomaria a iniciativa. Acho que você também gosta de mim."

# game/scripts/c13/c13.rpy:437
translate brazilian c13s001_SleepingInTheCouch_7b43f6fb_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, eu poderia tomar a iniciativa. Ainda não tenho certeza se você gostaria de mim."

# game/scripts/c13/c13.rpy:439
translate brazilian c13s001_SleepingInTheCouch_92bb93f5_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Você tem uma personalidade cativante e, se você se interessasse por homens, talvez eu tentasse algo com você. Mas duvido que daria certo. Acho que você não gostaria de mim."

# game/scripts/c13/c13.rpy:440
translate brazilian c13s001_SleepingInTheCouch_88e95bfb:

    # mc "Pero lo tendrías más difícil con personas a las que le interesara más el físico perfecto que la personalidad."
    mc "Mas você teria mais dificuldade com pessoas que estivessem mais interessadas em um físico perfeito do que em uma personalidade."

# game/scripts/c13/c13.rpy:443
translate brazilian c13s001_SleepingInTheCouch_0f60830f:

    # kat "¡Wow! Eso me pasa por preguntar."
    kat "Nossa! É o que dá perguntar."

# game/scripts/c13/c13.rpy:444
translate brazilian c13s001_SleepingInTheCouch_62a18f55:

    # mc "Y ya que yo he respondido, ¿puedo hacer una pregunta?"
    mc "Já que respondi, posso fazer uma pergunta?"

# game/scripts/c13/c13.rpy:446
translate brazilian c13s001_SleepingInTheCouch_73c1b90a:

    # kat "Sería justo que te dejara hacerla. No puedo asegurar que responda."
    kat "Seria justo se eu deixasse você fazer isso. Não posso garantir que responderei."

# game/scripts/c13/c13.rpy:447
translate brazilian c13s001_SleepingInTheCouch_501de8c1:

    # mc "¿Has dicho que no te interesan los hombres desde hace mucho?"
    mc "Você já disse que não se interessa por homens há muito tempo?"

# game/scripts/c13/c13.rpy:449
translate brazilian c13s001_SleepingInTheCouch_84745afb:

    # kat "*Risa* Uff, creía que sería una pregunta más complicada o comprometedora. Sí, lo he dicho."
    kat "*Risos* Ufa, pensei que seria uma pergunta mais complicada ou que exigisse mais empatia. Sim, eu disse."

# game/scripts/c13/c13.rpy:450
translate brazilian c13s001_SleepingInTheCouch_3133bb2f:

    # mc "No me refería a eso, la pregunta sería ¿qué pasó para que dejaran de interesarte?"
    mc "Não era isso que eu queria dizer; a pergunta deveria ser: o que aconteceu para você perder o interesse?"

# game/scripts/c13/c13.rpy:452
translate brazilian c13s001_SleepingInTheCouch_2d87f6a7:

    # kat "*Risa* Eso sería una segunda pregunta."
    kat "*Risos* Essa seria uma segunda pergunta."

# game/scripts/c13/c13.rpy:453
translate brazilian c13s001_SleepingInTheCouch_8aa83788:

    # mc "Pero..."
    mc "Mas..."

# game/scripts/c13/c13.rpy:454
translate brazilian c13s001_SleepingInTheCouch_f937556d:

    # kat "*Risa* No tengo la culpa de que no prestases atención a lo que decía y hayas gastado tu primera pregunta."
    kat "*Risos* A culpa não é minha se você não estava prestando atenção no que eu estava dizendo e desperdiçou sua primeira pergunta."

# game/scripts/c13/c13.rpy:455
translate brazilian c13s001_SleepingInTheCouch_f52554b8:

    # mc "*Risa* Vale, me estás tomando el pelo, ya lo pillo."
    mc "*Risos* Tá bom, você tá me zoando, agora eu entendi."

# game/scripts/c13/c13.rpy:458
translate brazilian c13s001_SleepingInTheCouch_4ec76d27:

    # kat "Por supuesto que te estoy tomando el pelo. Eres divertido y sabes encajarlo. *Risa*"
    kat "É claro que estou só brincando. Você é engraçado e sabe levar na esportiva. *Risos*"

# game/scripts/c13/c13.rpy:459
translate brazilian c13s001_SleepingInTheCouch_e2aeb02c:

    # mc "Entonces... ¿contestas la pregunta?"
    mc "Então... você está respondendo à pergunta?"

# game/scripts/c13/c13.rpy:462
translate brazilian c13s001_SleepingInTheCouch_35b64111:

    # kat "Es fácil. Solo he tenido una cita con un chico. Yo tenía 15 años y Isaac, el chico más popular de mi curso, me invitó a ir a cenar."
    kat "É fácil. Eu só tive um encontro com um garoto. Eu tinha 15 anos e o Isaac, o garoto mais popular da minha turma, me convidou para jantar."

# game/scripts/c13/c13.rpy:463
translate brazilian c13s001_SleepingInTheCouch_1d54b66e:

    # mc "Y algo salió mal."
    mc "E algo deu errado."

# game/scripts/c13/c13.rpy:465
translate brazilian c13s001_SleepingInTheCouch_d17eafc6:

    # kat "Sí, que había una voz en off que no me dejaba explicarme. *Risa*"
    kat "Sim, havia uma narração que não me deixava explicar. *Risos*"

# game/scripts/c13/c13.rpy:466
translate brazilian c13s001_SleepingInTheCouch_a9f7b463:

    # mc "Vale, ya me callo. *Risa*"
    mc "Ok, vou me calar agora. *Risos*"

# game/scripts/c13/c13.rpy:468
translate brazilian c13s001_SleepingInTheCouch_46204cb0:

    # kat "Imagínate, la ballena del instituto saliendo con el chico más popular de mi clase. Era un sueño hecho realidad."
    kat "Imagine, a garota mais popular do colégio namorando o cara mais popular da minha turma. Era um sonho realizado."

# game/scripts/c13/c13.rpy:470
translate brazilian c13s001_SleepingInTheCouch_52fe00cd:

    # kat "Y como te puedes imaginar, yo me emperifollé toda, pedí a mis padres que me compraran un vestido nuevo, llegué al lugar de la cita y allí estaba él, guapísimo."
    kat "E como podem imaginar, eu me arrumei toda, pedi aos meus pais que comprassem um vestido novo para mim, cheguei ao local do encontro e lá estava ele, deslumbrante."

# game/scripts/c13/c13.rpy:472
translate brazilian c13s001_SleepingInTheCouch_324cce21:

    # kat "Rodeado de todos sus amigos y amigas... riéndose de mí. Algo sacado de una película mala de instituto donde todos los populares son gilipollas y se ríen de la perdedora."
    kat "Rodeado por todos os seus amigos... rindo de mim. Algo saído diretamente de um filme ruim de colegial, onde todos os populares são uns idiotas e riem do perdedor."

# game/scripts/c13/c13.rpy:473
translate brazilian c13s001_SleepingInTheCouch_5672dac6:

    # mc "Lo siento, Kate."
    mc "Sinto muito, Kate."

# game/scripts/c13/c13.rpy:475
translate brazilian c13s001_SleepingInTheCouch_5297c865:

    # kat "Besó a una de las animadoras, tan solo para demostrar que podía besar a quien quisiera y que no lo iba a hacer conmigo."
    kat "Ele beijou uma das líderes de torcida, só para mostrar que podia beijar quem quisesse e que não ia fazer isso comigo."

# game/scripts/c13/c13.rpy:476
translate brazilian c13s001_SleepingInTheCouch_bc67a668:

    # mc "Ese crío era un capullo. Los hay en todos los institutos."
    mc "Aquele garoto era um idiota. Você encontra deles em todas as escolas."

# game/scripts/c13/c13.rpy:478
translate brazilian c13s001_SleepingInTheCouch_36762656:

    # kat "Pero como en todas las películas malas, la perdedora acabó ganando. Dos meses después estaba saliendo con esa misma animadora. Jennifer. Fue mi primera novia."
    kat "Mas, como em todos os filmes ruins, o azarão acabou vencendo. Dois meses depois, eu estava namorando aquela mesma líder de torcida. Jennifer. Ela foi minha primeira namorada."

# game/scripts/c13/c13.rpy:479
translate brazilian c13s001_SleepingInTheCouch_6605351c:

    # kat "Ella me enseñó que no necesitaba a un chico para ser feliz, para sentirme querida y especial."
    kat "Ela me ensinou que eu não precisava de um namorado para ser feliz, para me sentir amada e especial."

# game/scripts/c13/c13.rpy:480
translate brazilian c13s001_SleepingInTheCouch_46a729b1:

    # mc "¿Cómo se lo tomó aquel chico?"
    mc "Como aquele menino reagiu?"

# game/scripts/c13/c13.rpy:482
translate brazilian c13s001_SleepingInTheCouch_318df991:

    # kat "No le dió importancia hasta que Jennifer colgó una foto en InstaPic de nosotras dos besándonos."
    kat "Não dei muita importância até que Jennifer postou uma foto nossa nos beijando no InstaPic."

# game/scripts/c13/c13.rpy:483
translate brazilian c13s001_SleepingInTheCouch_1158143d:

    # kat "El texto decía \"Me ha costado dos meses quitarme el mal sabor de boca de un beso horrible de Isaac. Besa tan mal que me ha vuelto lesbiana.\" Como te puedes imaginar, ella siempre lo había sido."
    kat "O texto dizia: \"Levei dois meses para me livrar do gosto ruim na boca depois de um beijo horrível com o Isaac. Ele beija tão mal que me transformou em lésbica.\" Como você pode imaginar, ela sempre foi."

# game/scripts/c13/c13.rpy:484
translate brazilian c13s001_SleepingInTheCouch_7aad78cf:

    # mc "¡Bien por Jennifer!"
    mc "Que bom para Jennifer!"

# game/scripts/c13/c13.rpy:486
translate brazilian c13s001_SleepingInTheCouch_4800ba71:

    # kat "Y esa es la historia de por qué solo salgo con chicas. Sigo apreciando el aspecto de un chico guapo, pero no voy a dejar que me hagan daño otra vez."
    kat "E essa é a história de por que eu só namoro garotas. Eu ainda aprecio a aparência de um cara bonito, mas não vou me deixar machucar de novo."

# game/scripts/c13/c13.rpy:487
translate brazilian c13s001_SleepingInTheCouch_e3841a2a:

    # kat "Pero que un chico como tú se planteara tirarme los trastos... me sorprende."
    kat "Mas para um cara como você sequer cogitar dar em cima de mim... estou surpresa."

# game/scripts/c13/c13.rpy:488
translate brazilian c13s001_SleepingInTheCouch_f28d45d9:

    # mc "¿Un chico como yo? Kate, ¿me estás tirando los trastos? *Risa*"
    mc "Um cara como eu? Kate, você está dando em cima de mim? *Risos*"

# game/scripts/c13/c13.rpy:490
translate brazilian c13s001_SleepingInTheCouch_a31dfe94:

    # kat "*Risa* No solo es guapo y sabe encajar las bromas, también sabe devolverlas."
    kat "*Risos* Ele não é apenas bonito e sabe levar na esportiva, como também sabe retribuir na mesma moeda."

# game/scripts/c13/c13.rpy:491
translate brazilian c13s001_SleepingInTheCouch_e5f90eb8:

    # mc "¿Dónde estaría lo divertido si sólo recibiera uno?"
    mc "Onde estaria a graça se eu recebesse apenas um?"

# game/scripts/c13/c13.rpy:493
translate brazilian c13s001_SleepingInTheCouch_4ae2fa75:

    # "Justo en ese momento escuchas pasos en la escalera."
    "Nesse instante, você ouve passos na escada."

# game/scripts/c13/c13.rpy:495
translate brazilian c13s001_SleepingInTheCouch_ad0c015f:

    # mom "¿Qué hacéis aquí tan temprano? ¿Le has pillado el gusto a dormir en el sofá, [mc]? *Risa* ¿Hoy has cambiado a Lisa por Kate?"
    mom "O que você está fazendo aqui tão cedo? Já pegou gosto por dormir no sofá, [mc]? *Risos* Você trocou a Lisa pela Kate hoje?"

# game/scripts/c13/c13.rpy:496
translate brazilian c13s001_SleepingInTheCouch_57eee0fd:

    # mc "¿Cómo sabes tú eso?"
    mc "Como você sabe disso?"

# game/scripts/c13/c13.rpy:498
translate brazilian c13s001_SleepingInTheCouch_22add2b2:

    # kat "Ayer Lisa lo comentó varias veces. Por lo visto hablar contigo le ayudó mucho... en algo."
    kat "Lisa mencionou isso várias vezes ontem. Aparentemente, conversar com você a ajudou bastante... de alguma forma."

# game/scripts/c13/c13.rpy:499
translate brazilian c13s001_SleepingInTheCouch_790fd913:

    # mc "Ah, vale."
    mc "Ah, ok."

# game/scripts/c13/c13.rpy:501
translate brazilian c13s001_SleepingInTheCouch_e6a7f6fd:

    # kat "Pero no te preocupes, [mar]. Esta vez lo he encontrado yo durmiendo en el sofá."
    kat "Mas não se preocupe, [mar]. Desta vez eu o encontrei dormindo no sofá."

# game/scripts/c13/c13.rpy:503
translate brazilian c13s001_SleepingInTheCouch_c770cb25:

    # mom "¿Ha pasado algo en tu habitación?"
    mom "Aconteceu alguma coisa no seu quarto?"

# game/scripts/c13/c13.rpy:504
translate brazilian c13s001_SleepingInTheCouch_710fb6f5:

    # mc "Algo. Tenemos que hablar."
    mc "Algo. Precisamos conversar."

# game/scripts/c13/c13.rpy:506
translate brazilian c13s001_SleepingInTheCouch_09809368:

    # kat "Yo voy a darme una ducha. Os dejo hablar tranquilos."
    kat "Vou tomar um banho. Vou deixar vocês dois a sós para conversarem."

# game/scripts/c13/c13.rpy:507
translate brazilian c13s001_SleepingInTheCouch_f090d085:

    # mc "Nosotros vamos a bajar a la sala de abajo, es el sitio más alejado de cualquier habitación."
    mc "Vamos descer para o cômodo de baixo; é o lugar mais distante de todos os outros cômodos."

# game/scripts/c13/c13.rpy:540
translate brazilian c13s002_TalkToTheFamily_5d815bcc:

    # mom "¿Qué ha pasado?"
    mom "O que aconteceu?"

# game/scripts/c13/c13.rpy:543
translate brazilian c13s002_TalkToTheFamily_7e70543d:

    # mc "Ahora te lo explico, pero antes quiero un beso."
    mc "Vou te explicar agora, mas primeiro quero um beijo."

# game/scripts/c13/c13.rpy:545
translate brazilian c13s002_TalkToTheFamily_ef8d8600:

    # mom "Mmmmm... subía a ver si estabas despierto para besarte antes de que todo el mundo se despertara. Verte con Kate ha hecho que me despiste."
    mom "Hum... Subi para ver se você estava acordada para poder te dar um beijo antes que todos acordassem. Ver você com a Kate me fez perder a noção do tempo."

# game/scripts/c13/c13.rpy:546
translate brazilian c13s002_TalkToTheFamily_e45119d0:

    # mc "Problema resuelto. *Risa* Sobre lo que ha pasado..."
    mc "Problema resolvido. *Risos* Sobre o que aconteceu..."

# game/scripts/c13/c13.rpy:547
translate brazilian c13s002_TalkToTheFamily_f3c32356:

    # mc "Eileen y su madre están durmiendo en mi habitación"
    mc "Eileen e a mãe dela estão dormindo no meu quarto."

# game/scripts/c13/c13.rpy:549
translate brazilian c13s002_TalkToTheFamily_efa5675d:

    # mom "{b}¿Qué?{/b} ¿Por qué?"
    mom "{b}O quê?{/b}Por quê?"

# game/scripts/c13/c13.rpy:551
translate brazilian c13s002_TalkToTheFamily_587cf335:

    # mom "Tu y ellas..."
    mom "Você e eles..."

# game/scripts/c13/c13.rpy:552
translate brazilian c13s002_TalkToTheFamily_45958c14:

    # mc "No, no es eso, no te preocupes."
    mc "Não, não é isso, não se preocupe."

# game/scripts/c13/c13.rpy:553
translate brazilian c13s002_TalkToTheFamily_8b27aefd:

    # mc "Solomon se puso violento ayer con Kiara."
    mc "Ontem, Solomon se tornou violento com Kiara."

# game/scripts/c13/c13.rpy:555
translate brazilian c13s002_TalkToTheFamily_fa919086:

    # mom "{b}¿Qué?{/b} ¿Kiara está bien?"
    mom "{b}O quê?{/b} A Kiara está bem?"

# game/scripts/c13/c13.rpy:556
translate brazilian c13s002_TalkToTheFamily_f36f5c8c:

    # mc "Tiene un hematoma gigante en el antebrazo. Por el resto parece estar bien... físicamente."
    mc "Ele tem um hematoma enorme no antebraço. Tirando isso, parece estar bem... fisicamente."

# game/scripts/c13/c13.rpy:557
translate brazilian c13s002_TalkToTheFamily_ee742ba8:

    # mc "Cuando se despierte quiero llevarla al hospital a que vea a Samantha."
    mc "Quando ela acordar, quero levá-la ao hospital para ver Samantha."

# game/scripts/c13/c13.rpy:559
translate brazilian c13s002_TalkToTheFamily_d4314175:

    # mom "Sí, es lo mejor. Así tendrá un informe para presentar a la policía."
    mom "Sim, essa é a melhor coisa a fazer. Assim, você terá um relatório para entregar à polícia."

# game/scripts/c13/c13.rpy:560
translate brazilian c13s002_TalkToTheFamily_71334393:

    # mc "No quiere presentar denuncia. Ni siquiera quiere ir al hospital."
    mc "Ela não quer prestar queixa. Ela nem sequer quer ir ao hospital."

# game/scripts/c13/c13.rpy:561
translate brazilian c13s002_TalkToTheFamily_66e101df:

    # mc "Quería volver a casa mañana... la he convencido para que pase unos días en casa. Todavía hay una habitación libre en casa de [nor]. No sé si me he tomado muchas libertades..."
    mc "Ela queria ir para casa amanhã... Eu a convenci a ficar mais alguns dias. Ainda tem um quarto vago na casa do [nor]. Não sei se abusei da boa vontade dele..."

# game/scripts/c13/c13.rpy:563
translate brazilian c13s002_TalkToTheFamily_6e36c916:

    # mom "No, para nada. Si alguien tiene problemas, debemos que ayudarlo. Tenemos una habitación libre hasta que lleguen las otras estudiantes, no creo que haya mejor forma de usarla."
    mom "Não, de forma alguma. Se alguém estiver com problemas, devemos ajudá-lo. Temos um quarto vago até a chegada dos outros alunos; não acho que haja maneira melhor de utilizá-lo."

# game/scripts/c13/c13.rpy:564
translate brazilian c13s002_TalkToTheFamily_34e25155:

    # mc "De todas formas creo que debería haberlo consultado con [nor], pero era pasada la medianoche cuando hemos llegado a casa."
    mc "De qualquer forma, acho que deveria ter verificado com [nor], mas já passava da meia-noite quando chegamos em casa."

# game/scripts/c13/c13.rpy:566
translate brazilian c13s002_TalkToTheFamily_a871a070:

    # mom "Llámala y dile que venga. Ya debe estar despierta. Yo no he bajado el móvil."
    mom "Ligue para ela e diga para ela vir aqui. Ela já deve estar acordada. Eu não desliguei meu celular."

# game/scripts/c13/c13.rpy:567
translate brazilian c13s002_TalkToTheFamily_62d7ae47:

    # mc "OK, dáme un segundo."
    mc "Certo, só um segundo."

# game/scripts/c13/c13.rpy:569
translate brazilian c13s002_TalkToTheFamily_33abc69f:

    # "Unos minutos después, una vez habéis puesto a [nor] al corriente..."
    "Alguns minutos depois, assim que você preencher [nor]..."

# game/scripts/c13/c13.rpy:571
translate brazilian c13s002_TalkToTheFamily_b86cc6bb:

    # mc "Espero no haberme extralimitado diciéndoles que se pueden quedar una semana en tu casa."
    mc "Espero não ter ultrapassado os limites ao dizer que eles podem ficar na sua casa por uma semana."

# game/scripts/c13/c13.rpy:572
translate brazilian c13s002_TalkToTheFamily_7069f4cf:

    # nor "¿Una semana? ¡Se pueden quedar todo el tiempo que quieran! Mientras no lleguen las estudiantes en otoño, esa habitación es suya si la quieren."
    nor "Uma semana? Eles podem ficar o tempo que quiserem! Contanto que os alunos não cheguem no outono, aquele quarto é deles, se quiserem."

# game/scripts/c13/c13.rpy:573
translate brazilian c13s002_TalkToTheFamily_cbf508e3:

    # mc "Gracias, [nor]. Entre Meemaw, Tía Betty, y ahora Kiara y Eileen, casi es como si tuvieras a las estudiantes."
    mc "Obrigada, [nor]. Entre a vovó, a tia Betty e agora a Kiara e a Eileen, é quase como se você tivesse os alunos."

# game/scripts/c13/c13.rpy:575
translate brazilian c13s002_TalkToTheFamily_98dcd74f:

    # nor "Me servirá de entrenamiento. *Risa* Scarlett se queda a dormir la mitad de los días. Cuando coincidan todas tendré cinco huespedes."
    nor "Isso vai ser um bom treino. *Risos* A Scarlett fica mais da metade do tempo. Quando todas estiverem aqui, terei cinco hóspedes."

# game/scripts/c13/c13.rpy:577
translate brazilian c13s002_TalkToTheFamily_14d1dee3:

    # mom "A mí me llega hoy la quinta. Por cierto, [mc], tienes que ir a buscarla al aeropuerto. Llega a las 2 PM."
    mom "Meu quinto chega hoje. Aliás, [mc], você tem que buscá-lo no aeroporto. Ele chega às 14h."

# game/scripts/c13/c13.rpy:578
translate brazilian c13s002_TalkToTheFamily_f443373a:

    # mc "Sí, lo sé. Me lo dijo [nor] ayer. Parece que iba a ser una sorpresa para mí..."
    mc "Sim, eu sei. Ele me contou ontem. Parece que seria uma surpresa para mim..."

# game/scripts/c13/c13.rpy:580
translate brazilian c13s002_TalkToTheFamily_60d7c644:

    # mom "¿Sorpresa? ¿Qué sorpresa?"
    mom "Surpresa? Que surpresa?"

# game/scripts/c13/c13.rpy:581
translate brazilian c13s002_TalkToTheFamily_970f2e18:

    # mc "¿Te acuerdas de la chica India con la que salía en Portland? Estoy 99%% seguro de que es ella."
    mc "Você se lembra da garota indiana com quem eu estava saindo em Portland? Tenho 99%% de certeza de que é ela."

# game/scripts/c13/c13.rpy:596
translate brazilian c13s002_TalkToTheFamily_0dcdc47b:

    # mom "¿Te ha seguido desde Portland? ¿Sin decírtelo?"
    mom "Ele está te seguindo desde Portland? Sem te contar?"

# game/scripts/c13/c13.rpy:597
translate brazilian c13s002_TalkToTheFamily_8a456377:

    # nor "Super romántico, ¿verdad? Estoy segura de que quiere volver con él."
    nor "Que romântico, né? Tenho certeza de que ela quer voltar com ele."

# game/scripts/c13/c13.rpy:598
translate brazilian c13s002_TalkToTheFamily_75baeb1e:

    # mc "No estoy seguro, pero si no fuera así ¿por qué el secretismo? ¿Por qué se ha transferido a Newport?"
    mc "Não tenho certeza, mas se não fosse esse o caso, por que tanto segredo? Por que foi transferido para Newport?"

# game/scripts/c13/c13.rpy:600
translate brazilian c13s002_TalkToTheFamily_f215b9b6:

    # mom "¿Tú quieres volver con ella?"
    mom "Você quer voltar com ela?"

# game/scripts/c13/c13.rpy:602
translate brazilian c13s002_TalkToTheFamily_61e910c3:

    # mc "Mi situación es diferente de cuando estaba en Portland. Tengo que hablar con ella."
    mc "Minha situação é diferente de quando eu estava em Portland. Preciso falar com ela."

# game/scripts/c13/c13.rpy:604
translate brazilian c13s002_TalkToTheFamily_bb05ad6e:

    # mc "Hay muchas cosas que hacer en casa y no tengo demasiado tiempo para empezar o reanudar una relación. Tengo que hablar con ella."
    mc "Tenho muita coisa para fazer em casa e não tenho muito tempo para começar ou reatar um relacionamento. Preciso falar com ela."

# game/scripts/c13/c13.rpy:605
translate brazilian c13s002_TalkToTheFamily_24b973a2:

    # mc "Pero volviendo al tema del día. Deberiais hablar con Eileen y Kiara. Les dije que os comentaría lo de la habitación y..."
    mc "Mas voltando ao assunto de hoje. Você deveria falar com a Eileen e a Kiara. Eu disse a elas que te avisaria sobre o quarto e..."

# game/scripts/c13/c13.rpy:607
translate brazilian c13s002_TalkToTheFamily_e020d34a:

    # nor "No hay nada que comentar. La habitación es suya por el tiempo que quieran."
    nor "Não há nada a acrescentar. O quarto é seu pelo tempo que desejar."

# game/scripts/c13/c13.rpy:608
translate brazilian c13s002_TalkToTheFamily_495fef7c:

    # mc "Pero eso se les debería decir a ellas, no a mí. Yo ya sabía que no las íbamos a dejar en la estacada."
    mc "Mas isso é algo que você deveria dizer a eles, não a mim. Eu já sabia que não íamos deixá-los na mão."

# game/scripts/c13/c13.rpy:610
translate brazilian c13s002_TalkToTheFamily_cc8a4499:

    # nor "¿Están despiertas?"
    nor "Eles estão acordados?"

# game/scripts/c13/c13.rpy:611
translate brazilian c13s002_TalkToTheFamily_d74bb287:

    # mc "No lo sé, se acostaron tarde... Yo debería entrar para coger ropa y vestirme."
    mc "Não sei, eles foram dormir tarde... Eu deveria entrar para pegar algumas roupas e me vestir."

# game/scripts/c13/c13.rpy:612
translate brazilian c13s002_TalkToTheFamily_942c2998:

    # nor "Probemos entonces..."
    nor "Vamos tentar então..."

# game/scripts/c13/c13.rpy:615
translate brazilian c13s002_TalkToTheFamily_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c13/c13.rpy:616
translate brazilian c13s002_TalkToTheFamily_25c2df4d:

    # mc "Soy yo."
    mc "Sou eu."

# game/scripts/c13/c13.rpy:617
translate brazilian c13s002_TalkToTheFamily_27e3a2b0:

    # kia "Entra, [mc]."
    kia "Digite [mc]."

# game/scripts/c13/c13.rpy:619
translate brazilian c13s002_TalkToTheFamily_699dfc7a:

    # mc "Buenos días, Kiara. ¿Habéis dormido bien?"
    mc "Bom dia, Kiara. Você dormiu bem?"

# game/scripts/c13/c13.rpy:620
translate brazilian c13s002_TalkToTheFamily_aaa33533:

    # kia "Sí, hemos dormido genial. Hacía tiempo que Eile y yo no compartíamos cama. Gracias por dejarnos tu habitación."
    kia "Sim, dormimos muito bem. Já fazia um tempo que eu e a Eile não dividíamos a cama. Obrigada por nos deixar usar o seu quarto."

# game/scripts/c13/c13.rpy:622
translate brazilian c13s002_TalkToTheFamily_03e1bae3:

    # mc "No se si recuerdas a mi madre y a mi tía."
    mc "Não sei se você se lembra da minha mãe e da minha tia."

# game/scripts/c13/c13.rpy:623
translate brazilian c13s002_TalkToTheFamily_38d0cbc6:

    # mom "Bienvenida a casa, Kiara. ¿Donde está Eileen? Hace siglos que no la veo. Siento mucho lo que te ha pasado. Lo que os ha pasado a las dos."
    mom "Bem-vinda de volta, Kiara. Onde está a Eileen? Faz tempo que não a vejo. Sinto muito pelo que aconteceu com você. Pelo que aconteceu com vocês duas."

# game/scripts/c13/c13.rpy:624
translate brazilian c13s002_TalkToTheFamily_84aeac3b:

    # nor "Hoy moveremos vuestras cosas a una habitación en mi casa, así [mc] puede recuperar la suya. Estaréis más cómodas allí, hay dos camas. Sentimos no poderos ofrecer más."
    nor "Hoje vamos transferir suas coisas para um quarto na minha casa para que [mc] possa pegar as dela de volta. Você ficará mais confortável lá; há duas camas. Lamentamos não poder oferecer mais."

# game/scripts/c13/c13.rpy:626
translate brazilian c13s002_TalkToTheFamily_6265f88a:

    # kia "Gracias por acogernos, [mar] y [nor]. O lo que queda de ti, [nor]. Creo que si te viera por la calle no te reconocería. Nos conformamos con poco, solo serán unos días. No queremos molestar."
    kia "Obrigado por nos receberem, [mar] e [nor]. Ou o que sobrou de você, [nor]. Acho que não te reconheceria se te visse na rua. Não precisamos de muita coisa; serão só alguns dias. Não queremos te incomodar."

# game/scripts/c13/c13.rpy:627
translate brazilian c13s002_TalkToTheFamily_add25c43:

    # kia "Eileen está en la ducha. Hoy empieza pronto en el trabajo y no cogió su bici. Tendrá que coger el autobús."
    kia "Eileen está no chuveiro. Ela começa a trabalhar cedo hoje e não trouxe a bicicleta. Ela terá que pegar o ônibus."

# game/scripts/c13/c13.rpy:628
translate brazilian c13s002_TalkToTheFamily_063f51fb:

    # mc "No te preocupes por eso. El café está de camino al hospital y la puedo llevar yo."
    mc "Não se preocupe com isso. O café já está a caminho do hospital e eu posso levá-lo pessoalmente."

# game/scripts/c13/c13.rpy:630
translate brazilian c13s002_TalkToTheFamily_0033c727:

    # kia "[mc], ya hablamos de eso anoche. No es necesario ir al hospital."
    kia "[mc], já conversamos sobre isso ontem à noite. Não há necessidade de ir ao hospital."

# game/scripts/c13/c13.rpy:631
translate brazilian c13s002_TalkToTheFamily_603a3173:

    # mc "No es necesario, pero sí recomendable. ¿Tienes algo mejor que hacer esta mañana? ¿A qué hora entras a trabajar?"
    mc "Não é necessário, mas é recomendável. Você tem algo melhor para fazer esta manhã? A que horas você começa a trabalhar?"

# game/scripts/c13/c13.rpy:633
translate brazilian c13s002_TalkToTheFamily_8db5c596:

    # kia "A la 1 PM. Voy a tener que mover nuestras cosas a la nueva habitación..."
    kia "Às 13h. Vou ter que mudar nossas coisas para o quarto novo..."

# game/scripts/c13/c13.rpy:634
translate brazilian c13s002_TalkToTheFamily_44c676ad:

    # mc "Las cosas son una bolsa de viaje tan solo, Kiara. La puedo llevar yo en cuanto Eileen salga de la ducha."
    mc "É só uma mala de viagem, Kiara. Posso levá-la assim que a Eileen sair do banho."

# game/scripts/c13/c13.rpy:635
translate brazilian c13s002_TalkToTheFamily_dcf18cd2:

    # mc "A las 10 AM tengo que estar en un sitio, a las 2 PM tengo que estar en el aeropuerto, tu trabajo me pilla de camino entre el hospital y el aeropuerto."
    mc "Às 10h da manhã tenho que estar em algum lugar, às 14h tenho que estar no aeroporto, e seu trabalho fica no meu caminho entre o hospital e o aeroporto."

# game/scripts/c13/c13.rpy:636
translate brazilian c13s002_TalkToTheFamily_5d6577a8:

    # mc "Dejamos a Eileen en el café, vamos al hospital, me acompañas a lo que tengo que hacer a las 10, y te llevo al trabajo. Si tenemos tiempo, te invito a comer."
    mc "Deixaremos a Eileen no café, iremos ao hospital, você pode me acompanhar à minha consulta às 10h e depois eu a levarei ao trabalho. Se tivermos tempo, eu a convido para almoçar."

# game/scripts/c13/c13.rpy:638
translate brazilian c13s002_TalkToTheFamily_1778adbb:

    # mom "[mc] me ha dicho lo que ha pasado. Samantha Washington es una amiga, no va a hacer nada que tu no quieras hacer."
    mom "[mc] Ela me contou o que aconteceu. Samantha Washington é uma amiga; ela não fará nada que você não queira fazer."

# game/scripts/c13/c13.rpy:639
translate brazilian c13s002_TalkToTheFamily_e75bcff9:

    # mom "Si no quieres presentar la denuncia, no te va a obligar."
    mom "Se você não quiser registrar a queixa, eles não vão te obrigar."

# game/scripts/c13/c13.rpy:641
translate brazilian c13s002_TalkToTheFamily_ca34ffb5:

    # kia "¿Samantha Washington? ¿La madre del chico en... del chico que estudiaba en el mismo curso que Eileen y [mc]?"
    kia "Samantha Washington? A mãe do menino em... o menino que estava na mesma classe que Eileen e [mc]?"

# game/scripts/c13/c13.rpy:642
translate brazilian c13s002_TalkToTheFamily_5ce8450e:

    # mc "Sí, la madre de Jamaal."
    mc "Sim, a mãe de Jamaal."

# game/scripts/c13/c13.rpy:643
translate brazilian c13s002_TalkToTheFamily_034bdae1:

    # kia "Sí, eso, Jamaal. No he hablado más que un par de veces con ella..."
    kia "Sim, é isso mesmo, Jamaal. Só falei com ela algumas vezes..."

# game/scripts/c13/c13.rpy:645
translate brazilian c13s002_TalkToTheFamily_e364c13f:

    # nor "Pero es amiga de la familia. Y tú también. Si [mc] le pide algo..."
    nor "Mas ela é amiga da família. E você também. Se [mc] pedir algo a ela..."

# game/scripts/c13/c13.rpy:646
translate brazilian c13s002_TalkToTheFamily_8ba27ce0:

    # mc "Entonces decidido, voy a ducharme y nos vamos cuando queráis."
    mc "Então está decidido, vou tomar um banho e saímos quando você quiser."

# game/scripts/c13/c13.rpy:648
translate brazilian c13s002_TalkToTheFamily_4c813a90:

    # eil "¿[nor]? ¡Estás fantástica!"
    eil "[nor]? Você está fantástica!"

# game/scripts/c13/c13.rpy:649
translate brazilian c13s002_TalkToTheFamily_ba74b1db:

    # eil "Tu también, [mar]."
    eil "Você também, [mar]."

# game/scripts/c13/c13.rpy:651
translate brazilian c13s002_TalkToTheFamily_6423aeba:

    # mom "Bienvenida a casa, Eileen. Sabía que tarde o temprano te mudarías aquí, pero esperaba que fuera en otras circunstancias."
    mom "Bem-vinda de volta, Eileen. Eu sabia que você se mudaria para cá mais cedo ou mais tarde, mas esperava que fosse em circunstâncias diferentes."

# game/scripts/c13/c13.rpy:652
translate brazilian c13s002_TalkToTheFamily_5b7e94be:

    # eil "Gracias, [mar]. Yo también lo esperaba."
    eil "Obrigado, [mar]. Eu também estava esperando por isso."

# game/scripts/c13/c13.rpy:654
translate brazilian c13s002_TalkToTheFamily_b68411ed:

    # eil "Me parece increíble que haya pasado tanto tiempo sin veros. Tienes que entrar en el café cuando traigas a [eri] y lucir ese tipito."
    eil "Não acredito que já faz tanto tempo que não te vejo. Você tem que vir ao café quando trouxer [eri] e exibir essa figura."

# game/scripts/c13/c13.rpy:655
translate brazilian c13s002_TalkToTheFamily_ba290689:

    # eil "¡Estás increíble! Me tienes que decir como has perdido tanto peso. No me iría mal a mí también."
    eil "Você está incrível! Preciso te contar como você conseguiu emagrecer tanto. Eu também preciso de ajuda."

# game/scripts/c13/c13.rpy:656
translate brazilian c13s002_TalkToTheFamily_e4c672a7:

    # nor "Gracias, Eileen, pero tú no lo necesitas, a menos que quieras disfrazarte de esqueleto en Halloween. *Risa*"
    nor "Obrigada, Eileen, mas você não precisa disso, a menos que queira se fantasiar de esqueleto para o Halloween. *Risos*"

# game/scripts/c13/c13.rpy:658
translate brazilian c13s002_TalkToTheFamily_556e6162:

    # mom "Entonces, ¿vamos a desayunar mientras [mc] se ducha? Parece que va a tener un día ocupado"
    mom "Então, vamos tomar o café da manhã enquanto a [mc] toma banho? Parece que ela vai ter um dia cheio."

# game/scripts/c13/c13.rpy:659
translate brazilian c13s002_TalkToTheFamily_dcc24a9d:

    # mc "A mí también me gustaría desayunar..."
    mc "Eu também gostaria de tomar café da manhã..."

# game/scripts/c13/c13.rpy:661
translate brazilian c13s002_TalkToTheFamily_ca074c8d:

    # nor "No te preocupes, te dejaremos algo para que desayunes. Ve a ducharte, ya llevaré yo la bolsa de Kiara y Eileen a casa."
    nor "Não se preocupe, vamos deixar algo para o seu café da manhã. Vá tomar um banho; eu levo a mala da Kiara e da Eileen para casa."

# game/scripts/c13/c13.rpy:663
translate brazilian c13s002_TalkToTheFamily_b2a78d67:

    # nor "Si necesitáis algo de ropa, no dudéis en pedírnoslo a nosotras o a cualquiera de las chicas."
    nor "Se precisar de alguma roupa, não hesite em pedir para nós ou para qualquer uma das meninas."

# game/scripts/c13/c13.rpy:665
translate brazilian c13s002_TalkToTheFamily_9687e0a2:

    # kia "No te preocupes, podemos aguantar dos o tres días con lo que hemos traído. El jueves mi hija quiere ir a casa a coger más ropa."
    kia "Não se preocupe, podemos nos virar por dois ou três dias com o que trouxemos. Minha filha quer voltar para casa na quinta-feira para pegar mais roupas."

# game/scripts/c13/c13.rpy:666
translate brazilian c13s002_TalkToTheFamily_1f1380fa:

    # mc "El jueves por la noche no estará Solomon. Y esperamos poder llevar a Alexia... a la Agente Martínez por si se tuercen los planes."
    mc "Solomon não estará lá na quinta-feira à noite. E esperamos levar Alexia... até o Agente Martinez, caso as coisas deem errado."

# game/scripts/c13/c13.rpy:668
translate brazilian c13s002_TalkToTheFamily_00d473fe:

    # mom "Ve a ducharte o llegaréis tarde. Nosotras vamos a seguir charlando en la cocina mientras preparamos el desayuno."
    mom "Vá tomar um banho ou você vai se atrasar. Vamos continuar conversando na cozinha enquanto preparamos o café da manhã."

# game/scripts/c13/c13.rpy:670
translate brazilian c13s002_TalkToTheFamily_98b2ba8e:

    # mc "OK, os veo en la cocina."
    mc "Certo, te vejo na cozinha."

# game/scripts/c13/c13.rpy:681
translate brazilian c13s002_TheHospital_342c3ec7:

    # "Después de desayunar, llevas a Eileen al café y vas al hospital. Aparcas en la zona de visitantes."
    "Após o café da manhã, você leva Eileen ao café e depois vai para o hospital. Você estaciona na área de visitantes."

# game/scripts/c13/c13.rpy:684
translate brazilian c13s002_TheHospital_d3f5ff6a:

    # kia "[mc], de verdad que esto no es necesario. Tan solo es un hematoma."
    kia "[mc], isso realmente não é necessário. É apenas uma contusão."

# game/scripts/c13/c13.rpy:685
translate brazilian c13s002_TheHospital_f29c0ae1:

    # mc "No hace mucho que yo tuve unos hematomas y me dijeron que podían ser peligrosos si no se trataban correctamente."
    mc "Recentemente tive alguns hematomas e me disseram que eles poderiam ser perigosos se não fossem tratados adequadamente."

# game/scripts/c13/c13.rpy:686
translate brazilian c13s002_TheHospital_02ce349c:

    # mc "No nos podemos arriesgar a que te pase nada, ¿verdad?"
    mc "Não podemos arriscar que algo lhe aconteça, podemos?"

# game/scripts/c13/c13.rpy:688
translate brazilian c13s002_TheHospital_184d888d:

    # kia "Te conozco desde que tenías 15 años. Casi no reconozco a aquel chico tímido en este hombre que tengo ahora delante."
    kia "Conheço você desde que tinha 15 anos. Mal consigo reconhecer aquele menino tímido no homem que está diante de mim agora."

# game/scripts/c13/c13.rpy:689
translate brazilian c13s002_TheHospital_8d3cff4b:

    # mc "Kiara, sigo siendo yo. Tan solo he crecido y he adelgazado."
    mc "Kiara, continuo sendo eu mesma. Só cresci e emagreci."

# game/scripts/c13/c13.rpy:691
translate brazilian c13s002_TheHospital_0c59923f:

    # kia "No me refiero a eso, [mc]. No quiero que te ofendas, pero al principio de salir con mi Eile me parecías un pusilánime."
    kia "Não estou falando disso, [mc]. Não quero te ofender, mas quando comecei a namorar a Eile, achei que você era um banana."

# game/scripts/c13/c13.rpy:692
translate brazilian c13s002_TheHospital_34cf5b5c:

    # kia "No sé dónde tenías escondido a este hombre que toma las riendas de las situaciones."
    kia "Não sei onde você escondeu esse homem que assume o controle das situações."

# game/scripts/c13/c13.rpy:693
translate brazilian c13s002_TheHospital_176ea40b:

    # mc "Creo que me lo había comido. *Risa*"
    mc "Acho que comi. *Risos*"

# game/scripts/c13/c13.rpy:695
translate brazilian c13s002_TheHospital_fe4e84d0:

    # kia "*Risa* Eso no lo has perdido. Me sigues haciendo reír."
    kia "*Risos* Você não perdeu isso. Você ainda me faz rir."

# game/scripts/c13/c13.rpy:696
translate brazilian c13s002_TheHospital_7682a1e6:

    # mc "¿Te parecía tan malo como dices?"
    mc "Você achou que foi tão ruim quanto diz?"

# game/scripts/c13/c13.rpy:698
translate brazilian c13s002_TheHospital_61516d06:

    # kia "Al principio sí. No me gustabas, pero la hacías feliz y por eso nunca me opuse a vuestra relación. Nunca le dije nada a ella."
    kia "No começo, sim. Eu não gostava de você, mas você a fazia feliz, e por isso nunca me opus ao seu relacionamento. Nunca disse nada a ela."

# game/scripts/c13/c13.rpy:699
translate brazilian c13s002_TheHospital_47c4bba0:

    # mc "Gracias. ¿Y después?"
    mc "Obrigado. E depois?"

# game/scripts/c13/c13.rpy:701
translate brazilian c13s002_TheHospital_67377fac:

    # kia "Después evolucionasteis los dos. Ella dejó de querer ser el centro de atención. Maduró gracias a ti."
    kia "Então vocês dois evoluíram. Ela parou de querer ser o centro das atenções. Ela amadureceu graças a você."

# game/scripts/c13/c13.rpy:702
translate brazilian c13s002_TheHospital_32efa1d7:

    # kia "Tu dejaste de ser tan pusilánime, no encuentro una palabra mejor, pero sin perder tu esencia. Sacábais lo mejor del otro y hacíais que el otro enterrase lo peor de sí mismo."
    kia "Vocês deixaram de ser tão tímidos — não encontro palavra melhor — mas sem perder a essência. Vocês fizeram aflorar o melhor um no outro e se ajudaram a esconder o pior de si."

# game/scripts/c13/c13.rpy:703
translate brazilian c13s002_TheHospital_21480074:

    # mc "No éramos una pareja para ser los reyes del baile, pero no nos iba mal. Nadie hubiera votado por mí como rey del baile entonces."
    mc "Não éramos um casal destinado a ser rei e rainha do baile, mas não estávamos indo tão mal. Ninguém teria votado em mim para rei do baile naquela época."

# game/scripts/c13/c13.rpy:705
translate brazilian c13s002_TheHospital_387b6b7f:

    # kia "No necesitabais serlo. Solomon y yo lo fuimos, y ya ves..."
    kia "Você não precisava ser. Salomão e eu éramos, e veja só onde estamos agora..."

# game/scripts/c13/c13.rpy:706
translate brazilian c13s002_TheHospital_c48f9602:

    # mc "No te preocupes, Kiara. Si no quieres, no tienes que volver a verlo, y si quieres..."
    mc "Não se preocupe, Kiara. Se você não quiser, não precisa vê-lo novamente, e se quiser..."

# game/scripts/c13/c13.rpy:708
translate brazilian c13s002_TheHospital_e8bbc76e:

    # kia "¡No! No voy a denunciarlo. Si no fuera por todo lo que me habéis dicho, no estaría aquí ni siquiera."
    kia "Não! Não vou denunciar. Se não fosse por tudo o que você me contou, eu nem estaria aqui."

# game/scripts/c13/c13.rpy:709
translate brazilian c13s002_TheHospital_5f32c172:

    # mc "No te iba a decir eso. Es tu decisión y, aunque no la comparta, tengo que respetarlo. Es tu familia."
    mc "Eu não ia dizer isso. É sua decisão, e mesmo que eu não concorde, tenho que respeitá-la. Eles são sua família."

# game/scripts/c13/c13.rpy:710
translate brazilian c13s002_TheHospital_bfacd2fd:

    # mc "Iba a decirte que si querías podías quedarte en casa todo el tiempo que necesitaras."
    mc "Eu ia te dizer que, se você quisesse, poderia ficar em casa pelo tempo que precisasse."

# game/scripts/c13/c13.rpy:711
translate brazilian c13s002_TheHospital_108d37e9:

    # mc "Hasta otoño tenéis disponible la habitación que ocuparéis. Y después podéis volver a dormir en mi cama."
    mc "Você ficará com o quarto até o outono. Depois, poderá voltar e dormir na minha cama."

# game/scripts/c13/c13.rpy:713
translate brazilian c13s002_TheHospital_cda822c9:

    # kia "*Risa* Cualquiera que te oyera pensaría que hoy hemos dormido en tu cama contigo dentro. *Risa*"
    kia "*Risos* Quem te ouvisse pensaria que dormimos na sua cama com você dentro. *Risos*"

# game/scripts/c13/c13.rpy:714
translate brazilian c13s002_TheHospital_f0c2fba7:

    # mc "Bueno, en esa cama hemos dormido tres personas confortablemente. *Risa*"
    mc "Bom, três pessoas já dormiram confortavelmente nessa cama. *Risos*"

# game/scripts/c13/c13.rpy:715
translate brazilian c13s002_TheHospital_059e8b1f:

    # mc "La entrada está ahí mismo. ¿Preparada?"
    mc "A entrada é ali mesmo. Preparado(a)?"

# game/scripts/c13/c13.rpy:717
translate brazilian c13s002_TheHospital_405b7f9b:

    # kia "Sí. ¿Me aseguras que esa enfermera es de confianza? ¿No va a dar parte a la policía?"
    kia "Sim. Você pode me garantir que a enfermeira é confiável? Ela não vai denunciar à polícia?"

# game/scripts/c13/c13.rpy:718
translate brazilian c13s002_TheHospital_d2670ae0:

    # mc "Kiara, Samantha es como una segunda madre para mí. No va a hacer nada que tu no quieras, pero me gustaría que comprobara como está ese brazo."
    mc "Kiara, Samantha é como uma segunda mãe para mim. Ela não fará nada que você não queira, mas eu gostaria que ela desse uma olhada nesse seu braço."

# game/scripts/c13/c13.rpy:719
translate brazilian c13s002_TheHospital_1e67f23d:

    # mc "Y si hace un informe que puedas usar si cambias de opinión, mejor."
    mc "E se você fizer um relatório que possa usar caso mude de ideia, melhor ainda."

# game/scripts/c13/c13.rpy:721
translate brazilian c13s002_TheHospital_94d3a0e5:

    # kia "Vamos allá, entonces."
    kia "Vamos então."

# game/scripts/c13/c13.rpy:724
translate brazilian c13s002_TheHospital_84bf76e9:

    # mc "Buenos días, Sam. Esta es Kiara, la madre de Eileen, no sé si la recuerdas."
    mc "Bom dia, Sam. Aqui é a Kiara, mãe da Eileen. Não sei se você se lembra dela."

# game/scripts/c13/c13.rpy:725
translate brazilian c13s002_TheHospital_01349ba5:

    # sam "Hola, [mc]. Encantada de volver a verte, Kiara. Hacía años que no coincidíamos. Voy a ser tu enfermera hoy."
    sam "Olá, [mc]. É tão bom te ver de novo, Kiara. Faz tanto tempo desde a última vez que nos vimos. Eu serei sua enfermeira hoje."

# game/scripts/c13/c13.rpy:727
translate brazilian c13s002_TheHospital_0f9fa27a:

    # kia "Hola, Samantha. No es nada grave, de verdad. [mc] está exagerando."
    kia "Oi, Samantha. Não é nada sério, de verdade. [mc] Ela está exagerando."

# game/scripts/c13/c13.rpy:728
translate brazilian c13s002_TheHospital_5e3ef571:

    # mc "No exagero, tan solo soy precavido. Y ya has escuchado a Eileen, [nor] y [mar]."
    mc "Não estou exagerando, estou apenas sendo cauteloso. E você já ouviu Eileen, [nor] e [mar]."

# game/scripts/c13/c13.rpy:730
translate brazilian c13s002_TheHospital_9c807472:

    # sam "Un hematoma puede ser algo importante, más de lo que se piensa, no está de más echarle un ojo."
    sam "Uma contusão pode ser algo importante, mais do que você imagina; sempre vale a pena dar uma olhada."

# game/scripts/c13/c13.rpy:731
translate brazilian c13s002_TheHospital_58787efe:

    # sam "Acompáñame, Kiara. Tú quédate aquí, [mc]. No eres familia y no puedes pasar. Normas del hospital."
    sam "Venha comigo, Kiara. Você fica aqui, [mc]. Você não é da família e não pode entrar. Regras do hospital."

# game/scripts/c13/c13.rpy:732
translate brazilian c13s002_TheHospital_98debacd:

    # mc "¿Para cuanto rato tenéis? Tengo que estar en otro sitio a las 10."
    mc "Quanto tempo você tem? Preciso estar em outro lugar às 10."

# game/scripts/c13/c13.rpy:734
translate brazilian c13s002_TheHospital_e773f8c7:

    # sam "Déjame echarle una ojeada y salgo a decírtelo."
    sam "Deixe-me dar uma olhada e já volto para te contar."

# game/scripts/c13/c13.rpy:735
translate brazilian c13s002_TheHospital_22274886:

    # mc "Perfecto. Os espero aquí."
    mc "Perfeito. Vou esperar você aqui."

# game/scripts/c13/c13.rpy:737
translate brazilian c13s002_TheHospital_f02d5296:

    # kia "Una vez más, gracias, [mc]."
    kia "Mais uma vez, obrigado, [mc]."

# game/scripts/c13/c13.rpy:738
translate brazilian c13s002_TheHospital_e7dbd164:

    # mc "Una vez más, no es necesario. Si me tengo que ir mientras estás con Samantha, te escribo o te llamo."
    mc "Repito, não é necessário. Se eu precisar sair enquanto você estiver com a Samantha, eu te mando uma mensagem ou te ligo."

# game/scripts/c13/c13.rpy:740
translate brazilian c13s002_TheHospital_820a6af0:

    # "Unos interminables minutos después..."
    "Alguns intermináveis minutos depois..."

# game/scripts/c13/c13.rpy:741
translate brazilian c13s002_TheHospital_38b199fb:

    # sam "El brazo tiene mala pinta y quiero que la vea un doctor y que ordene una radiografía, pero ahora mismo están muy ocupados. Se va a quedar un rato. Calcula un par de horas."
    sam "O braço dela parece estar em mau estado, e eu quero que um médico o examine e peça um raio-x, mas eles estão muito ocupados agora. Ela ficará aqui por um tempo. Espere algumas horas."

# game/scripts/c13/c13.rpy:742
translate brazilian c13s002_TheHospital_60c5fa7b:

    # mc "Vale, entonces voy a ir hacer unas cosas y vuelvo luego a buscarla."
    mc "Certo, então vou fazer algumas coisas e volto mais tarde para procurá-la."

# game/scripts/c13/c13.rpy:744
translate brazilian c13s002_TheHospital_ba851d07:

    # sam "Perfecto. Le diré que la has abandonado en un hospital y que no volverás a buscarla. *Risa*"
    sam "Perfeito. Vou dizer a ela que você a abandonou no hospital e que não vai voltar para buscá-la. *Risos*"

# game/scripts/c13/c13.rpy:746
translate brazilian c13s002_TheHospital_74ed76d7:

    # mc "*Risa* Supongo que no me vas a dejar besarte aquí, ¿verdad?"
    mc "*Risos* Imagino que você não vai me deixar te beijar aqui, né?"

# game/scripts/c13/c13.rpy:748
translate brazilian c13s002_TheHospital_1f2507c5:

    # sam "Supones bien. Aún no estoy preparada para que nadie del trabajo sepa lo nuestro."
    sam "Você tem razão. Ainda não estou pronta para que alguém no trabalho saiba sobre nós."

# game/scripts/c13/c13.rpy:749
translate brazilian c13s002_TheHospital_6d255a72:

    # mc "Gracias, Sam. Trátala bien, por favor. Lo ha pasado mal"
    mc "Obrigado, Sam. Por favor, trate-a bem. Ela já passou por muita coisa."

# game/scripts/c13/c13.rpy:751
translate brazilian c13s002_TheHospital_5463b54e:

    # sam "Yo siempre trato bien a mis pacientes, [mc]. *Risa* Ya lo sabes."
    sam "Eu sempre trato bem meus pacientes, [mc]. *Risos* Você sabe disso."

# game/scripts/c13/c13.rpy:752
translate brazilian c13s002_TheHospital_e2248a1c:

    # mc "Y por cierto, Sam, perdón por el plantón de ayer."
    mc "Aliás, Sam, desculpa por ter me dado o bolo ontem."

# game/scripts/c13/c13.rpy:754
translate brazilian c13s002_TheHospital_6d8a5bae:

    # sam "No te preocupes. Jamaal lo agradeció, pero aún quedaron pastas si quieres venir esta tarde. Salgo a las 13:00, puedes venir a comer si quieres."
    sam "Não se preocupe. Jamaal agradeceu, mas ainda tem massa se você quiser vir esta tarde. Eu saio às 13h, você pode vir almoçar se quiser."

# game/scripts/c13/c13.rpy:755
translate brazilian c13s002_TheHospital_4bf1bc5c:

    # mc "Imposible, tengo que recoger a la última estudiante en el aeropuerto. Pero intentaré pasar por la tarde."
    mc "Impossível, tenho que buscar o último aluno no aeroporto. Mas tentarei passar aí esta tarde."

# game/scripts/c13/c13.rpy:757
translate brazilian c13s002_TheHospital_219452a4:

    # sam "Genial, te esperaré."
    sam "Ótimo, vou esperar por você."

# game/scripts/c13/c13.rpy:759
translate brazilian c13s002_TheHospital_b956b59d:

    # mc "Hasta dentro de un rato, Sam."
    mc "Até daqui a pouco, Sam."

# game/scripts/c13/c13.rpy:776
translate brazilian c13s003_ScarlettHouse_d5785649:

    # "Aparcas delante de casa de Scarlett y le mandas un mensaje. Has pasado el video a una tablet para que sea más cómodo enseñárselo a su madre."
    "Você estaciona em frente à casa de Scarlett e envia uma mensagem para ela. Você transferiu o vídeo para um tablet para que seja mais fácil mostrá-lo à mãe dela."

# game/scripts/c13/c13.rpy:777
translate brazilian c13s003_ScarlettHouse_76d06bb6:

    # "Scarlett sale de su casa y entra en la camioneta."
    "Scarlett sai de casa e entra na caminhonete."

# game/scripts/c13/c13.rpy:781
translate brazilian c13s003_ScarlettHouse_c084bbf6:

    # sca "Hola, cariño, me muero por besarte, pero no puedo aquí. Si mi madre nos ve..."
    sca "Oi, querida, estou louca para te beijar, mas não posso aqui. Se minha mãe nos vir..."

# game/scripts/c13/c13.rpy:782
translate brazilian c13s003_ScarlettHouse_712d4745:

    # mc "Lo entiendo. Te avergüenzas de mí."
    mc "Eu entendo. Você tem vergonha de mim."

# game/scripts/c13/c13.rpy:784
translate brazilian c13s003_ScarlettHouse_23f27e3b:

    # sca "Estoy castigada un día sin salir por quemar una olla haciendo{b}me{/b} espaguetis. Si mi madre se entera de que los hice para mi novio, estaré una semana."
    sca "Fiquei de castigo por um dia por ter queimado uma panela enquanto fazia espaguete. Se minha mãe descobrir que fiz para o meu namorado, ficarei de castigo por uma semana."

# game/scripts/c13/c13.rpy:785
translate brazilian c13s003_ScarlettHouse_ea248428:

    # sca "Y si descubre que acabamos pidiendo pizza, seguramente me castigue un mes. ¿Has traído el video?"
    sca "E se ele descobrir que acabamos pedindo pizza, provavelmente vai me deixar de castigo por um mês. Você trouxe o vídeo?"

# game/scripts/c13/c13.rpy:787
translate brazilian c13s003_ScarlettHouse_d1162091:

    # sca "Hola, [mc]. ¿Has traído el video ese?"
    sca "Olá, [mc]. Você trouxe aquele vídeo?"

# game/scripts/c13/c13.rpy:788
translate brazilian c13s003_ScarlettHouse_5e05c1e2:

    # mc "Sí, lo he pasado a una tablet para que le sea más cómodo leer los subtítulos que en el móvil."
    mc "Sim, mudei para um tablet para que seja mais fácil para ele ler as legendas do que no celular."

# game/scripts/c13/c13.rpy:790
translate brazilian c13s003_ScarlettHouse_868701f2:

    # sca "¿Puedo verlo?"
    sca "Posso ver?"

# game/scripts/c13/c13.rpy:791
translate brazilian c13s003_ScarlettHouse_6d74797e:

    # mc "Por supuesto. Aquí tienes la tablet."
    mc "Claro. Aqui está o tablet."

# game/scripts/c13/c13.rpy:793
translate brazilian c13s003_ScarlettHouse_119cd6aa:

    # "Scarlett permanece en silencio durante todo el video. Tan solo con la boca abierta en una expresión de sorpresa."
    "Scarlett permanece em silêncio durante todo o vídeo, com a boca simplesmente aberta em surpresa."

# game/scripts/c13/c13.rpy:795
translate brazilian c13s003_ScarlettHouse_222c5534:

    # sca "Hay que enseñárselo a mi madre. Con esto tendrá que creer que todas las veces que le he dicho que Kevin me acosaba era cierto."
    sca "Preciso mostrar isso para minha mãe. Isso vai fazê-la acreditar que todas as vezes que eu disse que o Kevin estava me assediando, era verdade."

# game/scripts/c13/c13.rpy:796
translate brazilian c13s003_ScarlettHouse_ef1ef17d:

    # mc "Sí, no hay forma de negarlo. Está claro cuales son sus intenciones."
    mc "Sim, não há como negar. As intenções deles são claras."

# game/scripts/c13/c13.rpy:797
translate brazilian c13s003_ScarlettHouse_7086eea4:

    # sca "Vamos dentro a enseñárselo..."
    sca "Vamos entrar e mostrar para ele..."

# game/scripts/c13/c13.rpy:799
translate brazilian c13s003_ScarlettHouse_e49a2d90:

    # sca "¡Mierda! Hay un problema."
    sca "Droga! Temos um problema."

# game/scripts/c13/c13.rpy:800
translate brazilian c13s003_ScarlettHouse_3b916da8:

    # mc "¿Qué pasa?"
    mc "O que está acontecendo?"

# game/scripts/c13/c13.rpy:801
translate brazilian c13s003_ScarlettHouse_9adecb95:

    # sca "¿De dónde le decimos que lo hemos sacado?"
    sca "Onde vamos dizer a ele que conseguimos isso?"

# game/scripts/c13/c13.rpy:802
translate brazilian c13s003_ScarlettHouse_7885187f:

    # mc "No había pensado en eso... ¿Siempre te ha acosado en tu habitación?"
    mc "Eu não tinha pensado nisso... Ele sempre esteve te perseguindo no seu quarto?"

# game/scripts/c13/c13.rpy:804
translate brazilian c13s003_ScarlettHouse_20c3efd6:

    # sca "No, en cualquier sitio de casa, pero la mayoría de veces ha sido en mi habitación."
    sca "Não, em qualquer lugar da casa, mas na maioria das vezes tem sido no meu quarto."

# game/scripts/c13/c13.rpy:805
translate brazilian c13s003_ScarlettHouse_4b4421fe:

    # mc "Puedes decir que me pediste que instalara esa cámara ya que ella no te creía. Así también tienes una razón para que lo haya traído yo en vez de enseñárselo tú ayer."
    mc "Você pode dizer que me pediu para instalar aquela câmera porque ela não acreditou em você. Isso também justifica eu tê-la trazido em vez de mostrá-la a ela ontem."

# game/scripts/c13/c13.rpy:807
translate brazilian c13s003_ScarlettHouse_c8d6a682:

    # sca "Puede ser una buena idea. Eso le da más plausibilidad. Vamos"
    sca "Essa pode ser uma boa ideia. Isso torna tudo mais plausível. Vamos lá."

# game/scripts/c13/c13.rpy:809
translate brazilian c13s003_ScarlettHouse_ebd70d04:

    # "Al bajar de la camioneta Scarlett saca el móvil mientras os dirigís a la puerta. Te mira con nerviosismo."
    "Ao sair da caminhonete, Scarlett pega o celular enquanto você caminha em direção à porta. Ela olha para você nervosamente."

# game/scripts/c13/c13.rpy:810
translate brazilian c13s003_ScarlettHouse_74b5d1dd:

    # sca "Truco de sordos. Le mando un mensaje a mi madre por la aplicación del timbre, diciéndole que voy a entrar."
    sca "Truque para surdos. Eu mando uma mensagem para minha mãe pelo aplicativo da campainha, avisando que estou entrando."

# game/scripts/c13/c13.rpy:811
translate brazilian c13s003_ScarlettHouse_c28919a2:

    # sca "No puede oír ni el timbre ni la puerta, así está sobreaviso de que hay alguien más en casa."
    sca "Ele não consegue ouvir a campainha nem a porta, então está sempre ciente de que há alguém em casa."

# game/scripts/c13/c13.rpy:813
translate brazilian c13s003_ScarlettHouse_ef708947:

    # mc "Compraremos una cosa así si algún día es necesaria."
    mc "Compraremos algo assim se algum dia precisarmos."

# game/scripts/c13/c13.rpy:815
translate brazilian c13s003_ScarlettHouse_0e0d595e:

    # sca "No puedes saber lo que llego a quererte por cosas como estas."
    sca "Você não tem como saber o quanto eu te amo por causa de coisas assim."

# game/scripts/c13/c13.rpy:817
translate brazilian c13s003_ScarlettHouse_33b096ee:

    # "Entraís en casa y Scarlett hace las presentaciones. Te presenta como un amigo."
    "Você entra na casa e Scarlett faz as apresentações. Ela te apresenta como um amigo."

# game/scripts/c13/c13.rpy:818
translate brazilian c13s003_ScarlettHouse_1091cbb7:

    # "Te imaginabas que iba a ser una conversación a través de lengua de signos, pero la Señora Russell habla perfectamente, con ese deje especial que tienen las personas que no pueden escucharse."
    "Você imaginou que seria uma conversa por meio da linguagem de sinais, mas a Sra. Russell fala perfeitamente, com aquela entonação especial que as pessoas que não conseguem se ouvir têm."

# game/scripts/c13/c13.rpy:819
translate brazilian c13s003_ScarlettHouse_070426e2:

    # "Scarlett explica la excusa que habéis inventado para tener el video, sin contarle el contenido."
    "Scarlett explica a desculpa que você inventou para conseguir o vídeo, sem revelar o conteúdo para ela."

# game/scripts/c13/c13.rpy:820
translate brazilian c13s003_ScarlettHouse_a60b0594:

    # "A la Señora Russell no le gusta mucho la idea."
    "A Sra. Russell não gosta muito da ideia."

# game/scripts/c13/c13.rpy:823
translate brazilian c13s003_ScarlettHouse_452cd8c9:

    # mj "¿Has puesto cámaras en mi casa? ¿Por qué no me has pedido autorización?"
    mj "Você instalou câmeras na minha casa? Por que não pediu minha permissão?"

# game/scripts/c13/c13.rpy:826
translate brazilian c13s003_ScarlettHouse_0af5e0d8:

    # sca "Mamá, no estabas. No te podía mandar un mensaje por si lo leía Kevin. Tomé la decisión, es mi habitación al fin y al cabo."
    sca "Mãe, você não estava em casa. Não pude te mandar mensagem com medo do Kevin ver. Tomei minha decisão; afinal, este é o meu quarto."

# game/scripts/c13/c13.rpy:828
translate brazilian c13s003_ScarlettHouse_88202063:

    # mj "Pero está en mi casa. Tendrías que habérmelo dicho."
    mj "Mas está na minha casa. Você deveria ter me avisado."

# game/scripts/c13/c13.rpy:830
translate brazilian c13s003_ScarlettHouse_cb2497de:

    # sca "Si te lo hubiera dicho me las hubieras hecho quitar y seguiríamos estando igual."
    sca "Se eu tivesse te contado, você teria me obrigado a tirá-las e ainda estaríamos na mesma situação."

# game/scripts/c13/c13.rpy:831
translate brazilian c13s003_ScarlettHouse_33640c56:

    # mc "Cuanta menos gente sepa estas cosas, suele ser mejor, Señora Russell."
    mc "Quanto menos pessoas souberem dessas coisas, melhor, Sra. Russell."

# game/scripts/c13/c13.rpy:833
translate brazilian c13s003_ScarlettHouse_60acdc76:

    # mj "¿Qué has dicho?"
    mj "O que você disse?"

# game/scripts/c13/c13.rpy:835
translate brazilian c13s003_ScarlettHouse_ea711448:

    # sca "Mírala de frente cuando hables con ella, [mc]. De esa forma puede leerte los labios."
    sca "Olhe-a diretamente nos olhos quando falar com ela, [mc]. Assim ela poderá ler seus lábios."

# game/scripts/c13/c13.rpy:837
translate brazilian c13s003_ScarlettHouse_9d4b4d76:

    # mc "Perdón, Señora Russell, decía que cuanta menos gente sepa estas cosas, suele ser mejor."
    mc "Com licença, Sra. Russell, eu estava dizendo que quanto menos pessoas souberem dessas coisas, melhor."

# game/scripts/c13/c13.rpy:838
translate brazilian c13s003_ScarlettHouse_451365d1:

    # mc "Además, si nadie hace nada inapropiado en la habitación de Scarlett, no pasa nada, ¿no?"
    mc "Além disso, se ninguém fizer nada de inapropriado no quarto da Scarlett, nada acontece, certo?"

# game/scripts/c13/c13.rpy:839
translate brazilian c13s003_ScarlettHouse_76cff8e4:

    # mj "Si tú tienes acceso a ese video, podrías ver a mi hija desnuda."
    mj "Se você tiver acesso a esse vídeo, poderá ver minha filha nua."

# game/scripts/c13/c13.rpy:841
translate brazilian c13s003_ScarlettHouse_9067efd5:

    # sca "Mamá, hay ángulos muertos, yo sé dónde están y la cama no es visible en el video. Nadie va a verme desnuda."
    sca "Mãe, existem pontos cegos, eu sei onde eles estão, e a cama não aparece no vídeo. Ninguém vai me ver nua."

# game/scripts/c13/c13.rpy:842
translate brazilian c13s003_ScarlettHouse_f4b5029f:

    # sca "Compruébalo tu misma mirando el video."
    sca "Veja você mesmo assistindo ao vídeo."

# game/scripts/c13/c13.rpy:844
translate brazilian c13s003_ScarlettHouse_067f0102:

    # "El video comienza con Scarlett en su habitación."
    "O vídeo começa com Scarlett em seu quarto."

# game/scripts/c13/c13.rpy:846
translate brazilian c13s003_ScarlettHouse_33e39d1a:

    # kev "Hola Scarlett, ¿Me has echado de menos?"
    kev "Oi Scarlett, você sentiu minha falta?"

# game/scripts/c13/c13.rpy:847
translate brazilian c13s003_ScarlettHouse_41bf2d96:

    # scav "¡Kevin! Te he dicho mil veces que no entres en mi habitación sin llamar. ¡Podría estar cambiándome!"
    scav "Kevin! Já te disse mil vezes para não entrar no meu quarto sem bater. Posso estar me trocando!"

# game/scripts/c13/c13.rpy:848
translate brazilian c13s003_ScarlettHouse_a0283cf6:

    # mj "¿Entró sin llamar?"
    mj "Ele entrou sem bater?"

# game/scripts/c13/c13.rpy:849
translate brazilian c13s003_ScarlettHouse_90c56edb:

    # sca "Sí, Mamá, lo hace siempre. Ya le he dicho mil veces que no lo haga."
    sca "Sim, mãe, ela faz isso o tempo todo. Eu já disse mil vezes para ela não fazer isso."

# game/scripts/c13/c13.rpy:851
translate brazilian c13s003_ScarlettHouse_bf4caf26:

    # kev "¿No he llamado? ¿Estás segura? Yo diría que sí. Deberías revisar si llevas bien ajustado tu audífono. *Risa*"
    kev "Eu não liguei? Tem certeza? Eu diria que sim. Você deveria verificar se seu aparelho auditivo está ajustado corretamente. *Risos*"

# game/scripts/c13/c13.rpy:852
translate brazilian c13s003_ScarlettHouse_057b77ad:

    # mj "A lo mejor estabas despistada, cariño, y no lo oíste."
    mj "Talvez você estivesse distraída, querida, e não tenha ouvido."

# game/scripts/c13/c13.rpy:853
translate brazilian c13s003_ScarlettHouse_cd766fbe:

    # scav "Idiota, era mi oído bueno el que estaba encarado a la puerta."
    scav "Idiota, era meu ouvido bom que estava virado para a porta."

# game/scripts/c13/c13.rpy:855
translate brazilian c13s003_ScarlettHouse_94f24f3d:

    # kev "Ya sabes que puedes perder el mundo de vista, cuando te pones a pensar en tus cosas y en ese chico que nunca te hará caso. *Risa cruel*"
    kev "Sabe como é, a gente perde a noção do mundo quando começa a pensar só nos nossos próprios problemas e naquele garoto que nunca vai dar bola pra gente. *Risada cruel*"

# game/scripts/c13/c13.rpy:857
translate brazilian c13s003_ScarlettHouse_cdf56ea0:

    # scav "Pues que sepas que estamos saliendo. Imbécil."
    scav "Só para você saber, estamos namorando. Idiota."

# game/scripts/c13/c13.rpy:859
translate brazilian c13s003_ScarlettHouse_d775c425:

    # scav "No es asunto tuyo si me hace caso o no. Imbécil."
    scav "Não é da sua conta se ele me ouve ou não. Idiota."

# game/scripts/c13/c13.rpy:860
translate brazilian c13s003_ScarlettHouse_d2e67295:

    # mj "Creo que te has pasado insultándole. Lo que ha dicho es verdad, cuando te pones a pensar en ese chico..."
    mj "Acho que você foi longe demais ao insultá-lo. O que ele disse é verdade, quando você pensa naquele cara..."

# game/scripts/c13/c13.rpy:861
translate brazilian c13s003_ScarlettHouse_e8bd6ad6:

    # sca "¡Mamá!"
    sca "Mãe!"

# game/scripts/c13/c13.rpy:862
translate brazilian c13s003_ScarlettHouse_e15bb926:

    # kev "Pero aún no me has contestado ¿Me has echado de menos?"
    kev "Mas você ainda não me respondeu. Sentiu minha falta?"

# game/scripts/c13/c13.rpy:864
translate brazilian c13s003_ScarlettHouse_eebb4602:

    # scav "Si crees que voy a echar de menos a alguien que entra en mi habitación sin autorización y sin llamar, estás muy equivocado."
    scav "Se você pensa que vou sentir falta de alguém que entra no meu quarto sem permissão e sem bater, está muito enganado."

# game/scripts/c13/c13.rpy:865
translate brazilian c13s003_ScarlettHouse_11f9ffa6:

    # kev "Ya te he dicho que he llamado. A ver si voy a tener que poner cámaras para grabar nuestras conversaciones y cada vez que entro en tu habitación. *Risa*"
    kev "Eu já te disse que liguei. Talvez eu tenha que instalar câmeras para gravar nossas conversas e todas as vezes que eu entrar no seu quarto. *Risos*"

# game/scripts/c13/c13.rpy:866
translate brazilian c13s003_ScarlettHouse_b1fa78e1:

    # mj "Alguien las puso..."
    mj "Alguém os colocou lá..."

# game/scripts/c13/c13.rpy:868
translate brazilian c13s003_ScarlettHouse_2a7ba7a6:

    # scav "¿Para qué? ¿Para pajearte mientras me cambio?"
    scav "Por quê? Para você se masturbar enquanto eu me troco?"

# game/scripts/c13/c13.rpy:869
translate brazilian c13s003_ScarlettHouse_33d2ab2a:

    # mj "¡Scarlett!"
    mj "Scarlett!"

# game/scripts/c13/c13.rpy:870
translate brazilian c13s003_ScarlettHouse_548965d0:

    # sca "Espera y lee lo que dice ahora..."
    sca "Espere e leia o que está escrito agora..."

# game/scripts/c13/c13.rpy:871
translate brazilian c13s003_ScarlettHouse_b6d075ee:

    # kev "Mira, niña, sería una buena paja. Y después pensaría en ello mientras tu madre me chupa la polla."
    kev "Olha, garota, isso seria uma boa punheta. E depois eu ficaria pensando nisso enquanto sua mãe chupa meu pau."

# game/scripts/c13/c13.rpy:873
translate brazilian c13s003_ScarlettHouse_fc3c8a8c:

    # mj "Es imposible que haya dicho eso... No habéis manipulado los subtítulos, ¿verdad?"
    mj "É impossível que ele tenha dito isso... Você não mexeu nas legendas, né?"

# game/scripts/c13/c13.rpy:874
translate brazilian c13s003_ScarlettHouse_8bce374d:

    # mc "No, Señora Russell. Lo que usted lee y lo que oímos nosotros es lo mismo."
    mc "Não, Sra. Russell. O que a senhora lê e o que nós ouvimos é a mesma coisa."

# game/scripts/c13/c13.rpy:875
translate brazilian c13s003_ScarlettHouse_0c531c95:

    # sca "Espera, que ahora viene lo peor..."
    sca "Espere, o pior ainda está por vir..."

# game/scripts/c13/c13.rpy:877
translate brazilian c13s003_ScarlettHouse_a3f22826:

    # kev "Y mañana tu madre tiene turno de noche y la he convencido para que te castigue por lo de la olla. No vas a poder fugarte a casa de tu amiguita."
    kev "E amanhã sua mãe estará no turno da noite, e eu a convenci a te castigar pelo incidente com a maconha. Você não poderá fugir para a casa do seu amigo."

# game/scripts/c13/c13.rpy:878
translate brazilian c13s003_ScarlettHouse_c5ef0d82:

    # kev "Eres una inútil que no sirve ni para cocinar unos putos espaguetis."
    kev "Você é uma pessoa inútil que nem consegue cozinhar um maldito espaguete."

# game/scripts/c13/c13.rpy:879
translate brazilian c13s003_ScarlettHouse_21b48917:

    # kev "Por primera vez en meses vamos a estar solos en casa. A lo mejor puedo darte unas lecciones de como chupar una polla, por si ese chico algún día se decide..."
    kev "Pela primeira vez em meses, estaremos sozinhos em casa. Talvez eu possa te dar algumas aulas de como chupar um pau, caso aquele cara resolva..."

# game/scripts/c13/c13.rpy:884
translate brazilian c13s003_ScarlettHouse_5c4ae1ac:

    # scav "Ni se te ocurra acercarte, cabrón."
    scav "Nem pense em chegar perto de mim, seu desgraçado."

# game/scripts/c13/c13.rpy:885
translate brazilian c13s003_ScarlettHouse_33d2ab2a_1:

    # mj "¡Scarlett!"
    mj "Scarlett!"

# game/scripts/c13/c13.rpy:887
translate brazilian c13s003_ScarlettHouse_79f1b411:

    # kev "Mejor que guardes esa furia para mañana. Me gustará más así."
    kev "É melhor você guardar essa raiva para amanhã. Eu prefiro assim."

# game/scripts/c13/c13.rpy:890
translate brazilian c13s003_ScarlettHouse_d35b8ffd:

    # "*Portazo*"
    "*Bang*"

# game/scripts/c13/c13.rpy:892
translate brazilian c13s003_ScarlettHouse_40b82663:

    # mj "Esto no puede ser real. Sé que lo que decía Scarlett coincidía con los subtítulos, puedo leerle los labios en la mayoría del video, pero no me puedo creer que Kevin dijera eso."
    mj "Isso não pode ser real. Eu sei que o que a Scarlett estava dizendo correspondia às legendas; consigo ler os lábios dela na maior parte do vídeo, mas simplesmente não consigo acreditar que o Kevin disse isso."

# game/scripts/c13/c13.rpy:893
translate brazilian c13s003_ScarlettHouse_ca7013a1:

    # mc "Señora Rusell, es lo que hay en el video, se lo aseguro."
    mc "Sra. Russell, é isso que está no vídeo, eu lhe asseguro."

# game/scripts/c13/c13.rpy:896
translate brazilian c13s003_ScarlettHouse_502c4e9a:

    # sca "Mamá, [mc] dice la verdad. Kevin me dijo esas cosas."
    sca "Mãe, [mc] está falando a verdade. Kevin me contou essas coisas."

# game/scripts/c13/c13.rpy:898
translate brazilian c13s003_ScarlettHouse_a1f7480b:

    # mj "¿Por qué no me lo dijiste ayer?"
    mj "Por que você não me contou ontem?"

# game/scripts/c13/c13.rpy:901
translate brazilian c13s003_ScarlettHouse_da739ef1:

    # sca "Te intenté decir hace unas semanas que se estaba propasando y no me creíste. Esperaba que [mc] viniera con pruebas para poder enseñártelas."
    sca "Tentei te dizer algumas semanas atrás que ele estava ultrapassando limites, mas você não acreditou em mim. Eu esperava que ele viesse com provas para que eu pudesse te mostrar."

# game/scripts/c13/c13.rpy:903
translate brazilian c13s003_ScarlettHouse_adbb64e3:

    # "En ese momento la Señora Russell deja de hablar con su voz y pasa a hacerlo con sus manos. Queda claro que quiere que sea una discusión entre madre e hija."
    "Nesse momento, a Sra. Russell para de falar e começa a gesticular com as mãos. Fica claro que ela quer que seja uma conversa entre mãe e filha."

# game/scripts/c13/c13.rpy:904
translate brazilian c13s003_ScarlettHouse_0b6bb391:

    # "Scarlett no traduce."
    "Scarlett não traduz."

# game/scripts/c13/c13.rpy:906
translate brazilian c13s003_ScarlettHouse_c9a30579:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si una de tus chicas acosara a tu hijo, si alguna vez lo tienes."
    "A expressão no rosto da mãe dele demonstra sua raiva; você também ficaria com raiva se uma de suas filhas importunasse seu filho, caso você tenha um."

# game/scripts/c13/c13.rpy:908
translate brazilian c13s003_ScarlettHouse_44a27d8d:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si tu pareja acosara a tu hijo, si alguna vez lo tienes."
    "A expressão no rosto da mãe demonstra sua raiva; você também ficaria com raiva se seu parceiro assediasse seu filho, caso você tenha um."

# game/scripts/c13/c13.rpy:910
translate brazilian c13s003_ScarlettHouse_e7673eea:

    # "Solo conoces una frase en lenguaje de signos. Esa frase aparece varias veces. Siempre en manos de Scarlett, nunca de su madre."
    "Você só conhece uma frase em língua de sinais. Essa frase aparece várias vezes. Sempre nas mãos de Scarlett, nunca nas de sua mãe."

# game/scripts/c13/c13.rpy:911
translate brazilian c13s003_ScarlettHouse_72ac1e36:

    # "La conversación acaba abruptamente. Las dos están claramente enfadadas. Supones que con Kevin, pero mejor no preguntar."
    "A conversa termina abruptamente. Ambos estão visivelmente irritados. Você presume que seja com Kevin, mas é melhor não perguntar."

# game/scripts/c13/c13.rpy:913
translate brazilian c13s003_ScarlettHouse_d67c0f6f:

    # sca "Ya está. Dice que Kevin va a tardar poco en volver a casa y le preguntará sobre el video."
    sca "É isso. Ela disse que Kevin chegará em casa em breve e perguntará sobre o vídeo."

# game/scripts/c13/c13.rpy:914
translate brazilian c13s003_ScarlettHouse_8be7e284:

    # mc "¿Le va a dar la oportunidad de negarlo?"
    mc "Você vai dar a ele a oportunidade de negar?"

# game/scripts/c13/c13.rpy:915
translate brazilian c13s003_ScarlettHouse_59f6b087:

    # sca "Sí. Vamos a sentarnos a esperarlo."
    sca "Sim. Vamos sentar e esperar por ele."

# game/scripts/c13/c13.rpy:918
translate brazilian c13s003_ScarlettHouse_9317aa29:

    # "Está claro que durante la conversación las cosas se han caldeado entre madre e hija y ha acabado en enfado. Está claro que ninguna de las dos va a decir una palabra más."
    "É evidente que a conversa entre mãe e filha se acirrou e terminou em discussão. É claro que nenhuma das duas vai dizer mais uma palavra sobre o assunto."

# game/scripts/c13/c13.rpy:919
translate brazilian c13s003_ScarlettHouse_d82fa969:

    # "Va a ser un silencio muy incómodo hasta que vuelva Kevin."
    "Vai haver um silêncio muito constrangedor até Kevin voltar."

# game/scripts/c13/c13.rpy:921
translate brazilian c13s003_ScarlettHouse_d87a05b3:

    # "Por suerte, al cabo de unos minutos el móvil de la Señora Russell vibra."
    "Por sorte, depois de alguns minutos, o celular da Sra. Russell vibra."

# game/scripts/c13/c13.rpy:922
translate brazilian c13s003_ScarlettHouse_f10289eb:

    # "Lo mira y su cara se ilumina con una sonrisa."
    "Ela olha para ele e seu rosto se ilumina com um sorriso."

# game/scripts/c13/c13.rpy:923
translate brazilian c13s003_ScarlettHouse_96d0411e:

    # "No es buena señal."
    "Isso não é um bom sinal."

# game/scripts/c13/c13.rpy:926
translate brazilian c13s003_ScarlettHouse_b5beb2e5:

    # kev "Hola, mi amor. Veo que tenemos visita."
    kev "Olá, meu amor. Vejo que temos uma visita."

# game/scripts/c13/c13.rpy:928
translate brazilian c13s003_ScarlettHouse_d65b6379:

    # kev "Hola, soy Kevin Cameron. La pareja de esta preciosidad. Y prácticamente el padrastro de la otra belleza."
    kev "Olá, eu sou Kevin Cameron. Parceiro desta beldade. E praticamente padrasto da outra beldade."

# game/scripts/c13/c13.rpy:929
translate brazilian c13s003_ScarlettHouse_0e1968fd:

    # "No te levantas. No piensas estrechar su mano."
    "Você não se levanta. Você não pretende apertar a mão dele."

# game/scripts/c13/c13.rpy:930
translate brazilian c13s003_ScarlettHouse_b80feb7a:

    # "Lo que te apetecería hacer sería meter esos dientes perfectos en su estómago de un puñetazo y dejar su cara hecha pulpa por tus puños."
    "O que você realmente gostaria de fazer é cravar esses dentes perfeitos no estômago dele com um único soco e deixar o rosto dele despedaçado pelos seus punhos."

# game/scripts/c13/c13.rpy:931
translate brazilian c13s003_ScarlettHouse_70c8ad0c:

    # "Te cuesta retenerte de empezar a hacer zumo con sus ojos. Calma."
    "Você está com dificuldade em se controlar para não espremer os olhos dela. Se acalme."

# game/scripts/c13/c13.rpy:932
translate brazilian c13s003_ScarlettHouse_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c13/c13.rpy:934
translate brazilian c13s003_ScarlettHouse_26927463:

    # kev "¿Ha pasado algo, cariño?"
    kev "Aconteceu alguma coisa, querida?"

# game/scripts/c13/c13.rpy:936
translate brazilian c13s003_ScarlettHouse_fab451ab:

    # mj "Mira este video, mi amor, por favor. Dime que no es cierto."
    mj "Assista a este vídeo, meu amor, por favor. Diga-me que não é verdade."

# game/scripts/c13/c13.rpy:938
translate brazilian c13s003_ScarlettHouse_cfbdaf44:

    # kev "¿De qué va esto, mi vida?"
    kev "Do que se trata tudo isso, meu amor?"

# game/scripts/c13/c13.rpy:939
translate brazilian c13s003_ScarlettHouse_207f5f72:

    # mj "Míralo, por favor."
    mj "Dê uma olhada, por favor."

# game/scripts/c13/c13.rpy:940
translate brazilian c13s003_ScarlettHouse_8ca34c39:

    # "Kevin empieza a mirar el video con una cara de perplejidad."
    "Kevin começa a assistir ao vídeo com uma expressão perplexa."

# game/scripts/c13/c13.rpy:942
translate brazilian c13s003_ScarlettHouse_9d2a21fc:

    # "Su expresión cambia a sorpresa absoluta tal como pasan los segundos."
    "Sua expressão muda para absoluta surpresa à medida que os segundos passam."

# game/scripts/c13/c13.rpy:944
translate brazilian c13s003_ScarlettHouse_d4774db5:

    # "Casi al final del video la sonrisa vuelve a su cara."
    "Perto do final do vídeo, o sorriso retorna ao rosto dela."

# game/scripts/c13/c13.rpy:945
translate brazilian c13s003_ScarlettHouse_96d0411e_1:

    # "No es buena señal."
    "Isso não é um bom sinal."

# game/scripts/c13/c13.rpy:947
translate brazilian c13s003_ScarlettHouse_fe059065:

    # kev "*Risa* Está muy bien hecho, pero como broma es un poco pesada."
    kev "*Risos* Ficou muito bom, mas como piada, foi um pouco exagerado."

# game/scripts/c13/c13.rpy:948
translate brazilian c13s003_ScarlettHouse_b3ba264f:

    # mcp "{i}(¿Que?){/i}"
    mcp "{i}(O quê?){/i}"

# game/scripts/c13/c13.rpy:949
translate brazilian c13s003_ScarlettHouse_898117f5:

    # kev "Además, este tipo tiene acento de Alabama, y ya sabes que yo soy de Tejas, cariño. No es mi voz."
    kev "Além disso, esse cara tem sotaque do Alabama, e você sabe que eu sou do Texas, querida. Essa não é a minha voz."

# game/scripts/c13/c13.rpy:950
translate brazilian c13s003_ScarlettHouse_26b6669f:

    # "Tu perplejidad no hace más que aumentar. Es cláramente su voz y su acento. Tus ganas de machacarle la cara aumentan. Una bestia empieza a despertarse en tu interior. Calma."
    "Sua perplexidade só aumenta. É claramente a voz dele, o sotaque. A vontade de esmagar a cara dele se intensifica. Uma fera começa a despertar dentro de você. Acalme-se."

# game/scripts/c13/c13.rpy:951
translate brazilian c13s003_ScarlettHouse_697275cf:

    # kev "*Risa* Lo que estos chicos son capaces de hacer con inteligencia artificial..."
    kev "*Risos* O que esses caras são capazes de fazer com inteligência artificial..."

# game/scripts/c13/c13.rpy:953
translate brazilian c13s003_ScarlettHouse_d14e9945:

    # mj "¿Entonces no es cierto? ¿Me lo juras?"
    mj "Então não é verdade? Você jura para mim?"

# game/scripts/c13/c13.rpy:954
translate brazilian c13s003_ScarlettHouse_0042774a:

    # kev "Por supuesto que te lo juro."
    kev "Claro que juro para você."

# game/scripts/c13/c13.rpy:956
translate brazilian c13s003_ScarlettHouse_b2a49335:

    # mj "¡Lo sabía! No serías capaz de decir esas cosas."
    mj "Eu sabia! Você não seria capaz de dizer essas coisas."

# game/scripts/c13/c13.rpy:957
translate brazilian c13s003_ScarlettHouse_278b8aca:

    # kev "Por supuesto que no, cielo. Ya sabes que yo solo tengo ojos para ti."
    kev "Claro que não, querida. Você sabe que só tenho olhos para você."

# game/scripts/c13/c13.rpy:959
translate brazilian c13s003_ScarlettHouse_dc0184ed:

    # mj "Señor Marks, no sé lo que esperaba conseguir con esta broma, pero no ha tenido ninguna gracia. Por favor, márchese de mi casa."
    mj "Sr. Marks, não sei o que o senhor esperava conseguir com essa piada, mas não teve graça nenhuma. Por favor, saia da minha casa."

# game/scripts/c13/c13.rpy:960
translate brazilian c13s003_ScarlettHouse_22450a82:

    # mc "Pero Señora Russell, le está mintiendo."
    mc "Mas, Sra. Russell, ele está mentindo para a senhora."

# game/scripts/c13/c13.rpy:961
translate brazilian c13s003_ScarlettHouse_7a8d87e1:

    # mj "Cállese y váyase, por favor."
    mj "Cale-se e vá embora, por favor."

# game/scripts/c13/c13.rpy:963
translate brazilian c13s003_ScarlettHouse_be008068:

    # mj "Tú y yo vamos a tener una larga conversación, niña."
    mj "Você e eu vamos ter uma longa conversa, garota."

# game/scripts/c13/c13.rpy:964
translate brazilian c13s003_ScarlettHouse_2d80d38b:

    # mc "*Susurrando* ¿Qué hago?"
    mc "*Sussurrando* O que eu faço?"

# game/scripts/c13/c13.rpy:966
translate brazilian c13s003_ScarlettHouse_7cd63c8c:

    # sca "Vete, [mc]. Ya lo intentaré arreglar... como sea."
    sca "Vai embora, [mc]. Vou tentar consertar... de alguma forma."

# game/scripts/c13/c13.rpy:968
translate brazilian c13s003_ScarlettHouse_0ba03c0e:

    # kev "Ya te acompaño yo a la puerta, muchacho."
    kev "Eu te acompanho até a porta, garoto."

# game/scripts/c13/c13.rpy:969
translate brazilian c13s003_ScarlettHouse_d99273bb:

    # "La palabra \"muchacho\" va cargada de ironía. Te está diciendo que eres un niño que se ha metido en un juego de adultos al que no pertenece."
    "A palavra \"garoto\" está carregada de ironia. Ela está lhe dizendo que você é uma criança que se meteu em um jogo de adultos no qual não deveria estar."

# game/scripts/c13/c13.rpy:970
translate brazilian c13s003_ScarlettHouse_973610e2:

    # "Te cuesta mucho no dejar salir la bestia que está creciendo dentro de ti. Calma."
    "Você está achando muito difícil suprimir a fera que cresce dentro de você. Acalme-se."

# game/scripts/c13/c13.rpy:972
translate brazilian c13s003_ScarlettHouse_0bf90338:

    # "Desde la puerta puedes ver cómo madre e hija discuten. Lo surrealista de la situación hace que casi sea gracioso ver a dos personas gritándose en silencio."
    "Da porta, é possível ver a mãe e a filha discutindo. O caráter surreal da situação torna quase cômico observar duas pessoas gritando silenciosamente uma com a outra."

# game/scripts/c13/c13.rpy:973
translate brazilian c13s003_ScarlettHouse_928dc63c:

    # kev "Mira, hijo, creía que solo iba a tener una noche a solas con esa putilla. Es demasiado perfecta para que la castiguen a menudo."
    kev "Olha, filho, eu pensei que só ia passar uma noite a sós com aquela vadiazinha. Ela é perfeita demais para ser punida com frequência."

# game/scripts/c13/c13.rpy:974
translate brazilian c13s003_ScarlettHouse_9ac9e45d:

    # kev "Ahora, gracias a ti, me parece que voy a tener muchas noches a solas con ella. La próxima vez que la veas será toda una mujer."
    kev "Agora, graças a você, acho que vou passar muitas noites a sós com ela. Da próxima vez que você a vir, ela já será uma mulher adulta."

# game/scripts/c13/c13.rpy:975
translate brazilian c13s003_ScarlettHouse_01a34171:

    # "Lisa estaría orgullosa de ti. Una bestia a la que has estado a punto de llevar a la extinción aparece con toda la furia de un animal aprisionado."
    "Lisa ficaria orgulhosa de você. Uma fera que você quase levou à extinção ressurgiu com toda a fúria de um animal enjaulado."

# game/scripts/c13/c13.rpy:978
translate brazilian c13s003_ScarlettHouse_56735bfc:

    # "Tu puño sale disparado hacia la boca de Kevin. No es un rodillo, pero hace el mismo efecto. No saltan dientes."
    "Seu punho voa em direção à boca de Kevin. Não é um rolo de massa, mas tem o mesmo efeito. Nenhum dente voa para fora."

# game/scripts/c13/c13.rpy:980
translate brazilian c13s003_ScarlettHouse_310a016f:

    # "Scarlett y la Señora Rusell paran la discusión y os miran mientras Kevin cae al suelo."
    "Scarlett e a Sra. Russell interrompem a discussão e olham para você enquanto Kevin cai no chão."

# game/scripts/c13/c13.rpy:981
translate brazilian c13s003_ScarlettHouse_f677d9f2:

    # mc "Scarlett, haz las maletas si quieres puedes venir a casa. No voy a dejarte con este cerdo."
    mc "Scarlett, faça as malas. Se quiser, pode voltar para casa. Não vou te deixar com esse porco."

# game/scripts/c13/c13.rpy:983
translate brazilian c13s003_ScarlettHouse_25247a8f:

    # kev "¡Te voy a denunciar, hijo de puta! ¡Sé tu nombre!"
    kev "Vou te denunciar, seu filho da puta! Eu sei seu nome!"

# game/scripts/c13/c13.rpy:985
translate brazilian c13s003_ScarlettHouse_cc6f8065:

    # mj "¡Haz tus maletas y vete de mi casa, Scarlett!"
    mj "Faça as malas e saia da minha casa, Scarlett!"

# game/scripts/c13/c13.rpy:986
translate brazilian c13s003_ScarlettHouse_e44811be:

    # mj "¡No te quiero volver a ver en esta casa!"
    mj "Nunca mais quero te ver nesta casa!"

# game/scripts/c13/c13.rpy:987
translate brazilian c13s003_ScarlettHouse_92dacd4e:

    # sca "¿Qué?"
    sca "Que?"

# game/scripts/c13/c13.rpy:988
translate brazilian c13s003_ScarlettHouse_36b09a89:

    # "Nada está saliendo como habías planeado..."
    "Nada está saindo como planejado..."

# game/scripts/c13/c13.rpy:990
translate brazilian c13s003_ScarlettHouse_04a98fcd:

    # mj "¡Lo que has oído! ¡Primero me destrozas la vida!"
    mj "Você ouviu direito! Primeiro você arruína a minha vida!"

# game/scripts/c13/c13.rpy:991
translate brazilian c13s003_ScarlettHouse_2a04d9fb:

    # mj "¡Después tu padre deja de mandarme dinero!"
    mj "Então seu pai para de me mandar dinheiro!"

# game/scripts/c13/c13.rpy:992
translate brazilian c13s003_ScarlettHouse_14f46e82:

    # mj "¡Ahora traes a tu amigo para que apalice a Kevin, con lo bueno que ha sido con nosotras! ¡Fuera de aquí!"
    mj "Agora você traz seu amigo aqui para bater no Kevin, depois de ele ter sido tão bom para nós! Some daqui!"

# game/scripts/c13/c13.rpy:993
translate brazilian c13s003_ScarlettHouse_23c9d6e2:

    # sca "¿Qué estás diciendo? ¿Has estado recibiendo dinero de mi padre todos estos años?"
    sca "O que você está dizendo? Você vem recebendo dinheiro do meu pai todos esses anos?"

# game/scripts/c13/c13.rpy:994
translate brazilian c13s003_ScarlettHouse_4fec626a:

    # "El tiempo parece haberse detenido para Kevin y para ti. Seguir la pelea hubiera sido lógico. Observar a las dos mujeres gritarse es más interesante."
    "O tempo parece ter parado para você e para o Kevin. Seguir a briga teria sido lógico. Mas assistir às duas mulheres gritando uma com a outra é mais interessante."

# game/scripts/c13/c13.rpy:996
translate brazilian c13s003_ScarlettHouse_65aed982:

    # mj "¡Sí! ¡Y me alegra habértelo ocultado! No te mereces nada."
    mj "Sim! E ainda bem que escondi isso de você! Você não merece nada."

# game/scripts/c13/c13.rpy:997
translate brazilian c13s003_ScarlettHouse_a7e99f3c:

    # sca "¡Pues lo buscaré e iré con él! Seguro que estaré mejor con él que contigo. Siempre pensando solo en el dinero y creyendo antes a Kevin que a tu hija."
    sca "Bom, eu vou encontrá-lo e ir com ele! Tenho certeza de que estarei melhor com ele do que com você. Sempre pensando apenas em dinheiro e acreditando mais no Kevin do que na sua filha."

# game/scripts/c13/c13.rpy:999
translate brazilian c13s003_ScarlettHouse_3c731fe7:

    # mj "Suerte con eso. Me escribió hace unos días. Como ya tienes 18, no va a mandar más dinero."
    mj "Boa sorte com isso. Ele me escreveu há alguns dias. Como você já tem 18 anos, ele não vai mandar mais dinheiro."

# game/scripts/c13/c13.rpy:1000
translate brazilian c13s003_ScarlettHouse_e11e2a40:

    # mj "Eso es lo que te quiere y se preocupa por ti, mientras yo he sacrificado mi vida por tenerte."
    mj "É isso que ele quer e com o que se importa, enquanto eu sacrifiquei minha vida para ter você."

# game/scripts/c13/c13.rpy:1002
translate brazilian c13s003_ScarlettHouse_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1004
translate brazilian c13s003_ScarlettHouse_3ce3d494:

    # "El móvil de la Señora Russell vuelve a vibrar. El timbre os paraliza a todos durante unos segundos."
    "O telefone da Sra. Russell vibra novamente. O toque paralisa todos vocês por alguns segundos."

# game/scripts/c13/c13.rpy:1006
translate brazilian c13s003_ScarlettHouse_6092ea65_1:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1008
translate brazilian c13s003_ScarlettHouse_6092ea65_2:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1010
translate brazilian c13s003_ScarlettHouse_f326ad6a:

    # "La Señora Russell va a abrir la puerta. Esquiva el cuerpo de Kevin en el suelo. Si no fuera por eso, parecería que no ha pasado nada para ella. "
    "A Sra. Russell vai abrir a porta. Ela se esquiva para evitar o corpo de Kevin no chão. Se não fosse por isso, pareceria que nada lhe aconteceu."

# game/scripts/c13/c13.rpy:1011
translate brazilian c13s003_ScarlettHouse_1795085c:

    # "La persona más inesperada está fuera."
    "A pessoa mais inesperada está lá fora."

# game/scripts/c13/c13.rpy:1013
translate brazilian c13s003_ScarlettHouse_475ffd53:

    # ama "FBI. Apártese, Señora Russell."
    ama "FBI. Sai da frente, Sra. Russell."

# game/scripts/c13/c13.rpy:1014
translate brazilian c13s003_ScarlettHouse_388905bb:

    # ama "¡[mc] Marks, queda detenido por infracciones contra la Ley de Pivacidad en el Hogar!"
    ama "[mc] Marks, você está preso por violações da Lei de Privacidade Doméstica!"

# game/scripts/c13/c13.rpy:1015
translate brazilian c13s003_ScarlettHouse_bb4742bf:

    # mcp "{i}(No puede ser. Es igualita que [emm]... si no fuera por el pelo... y por que se la ve mucho más adulta que a [emm]...){/i}"
    mcp "{i}(Não pode ser. Ela é exatamente igual à [emm]... se não fosse pelo cabelo... e porque ela parece muito mais velha que a [emm]...){/i}"

# game/scripts/c13/c13.rpy:1016
translate brazilian c13s003_ScarlettHouse_8920c9e4:

    # mc "Ama..."
    mc "Amor..."

# game/scripts/c13/c13.rpy:1017
translate brazilian c13s003_ScarlettHouse_e24ee8e5:

    # ama "¡Silencio! De rodillas. ¡Las manos detras de la espalda!"
    ama "Silêncio! De joelhos. Mãos para trás!"

# game/scripts/c13/c13.rpy:1018
translate brazilian c13s003_ScarlettHouse_8a825d46:

    # "Sigues sus instrucciones. No sabes de qué va esto."
    "Você segue as instruções dele. Você não tem ideia do que se trata."

# game/scripts/c13/c13.rpy:1020
translate brazilian c13s003_ScarlettHouse_6cbf7c7c:

    # "Mientras Amanda te esposa..."
    "Enquanto Amanda te algema..."

# game/scripts/c13/c13.rpy:1021
translate brazilian c13s003_ScarlettHouse_7a1b5cd4:

    # ama "*Susurrando* No te preocupes..."
    ama "*Sussurrando* Não se preocupe..."

# game/scripts/c13/c13.rpy:1022
translate brazilian c13s003_ScarlettHouse_65204ccf:

    # kev "También me ha agredido..."
    kev "Ele também me agrediu..."

# game/scripts/c13/c13.rpy:1024
translate brazilian c13s003_ScarlettHouse_50dcfcc7:

    # ama "Eso se sumará a la lista de cargos. Acompáñeme junto con la Señora Russell, por favor. Tengo que tomarles declaración."
    ama "Isso será adicionado à lista de acusações. Por favor, venham comigo e com a Sra. Russell. Preciso colher seus depoimentos."

# game/scripts/c13/c13.rpy:1026
translate brazilian c13s003_ScarlettHouse_47a4ca7e:

    # "Amanda desaparece con la Señora Russell y Kevin. Ambos están en shock."
    "Amanda desaparece com a Sra. Russell e Kevin. Ambos estão em estado de choque."

# game/scripts/c13/c13.rpy:1027
translate brazilian c13s003_ScarlettHouse_6b90c0b1:

    # sca "¿Esa era... [emm]?"
    sca "Era isso... [emm]?"

# game/scripts/c13/c13.rpy:1028
translate brazilian c13s003_ScarlettHouse_a00cff2a:

    # mc "No, pero ahora no te lo puedo explicar. Ayúdame con las esposas."
    mc "Não, mas não posso te explicar agora. Me ajude com as algemas."

# game/scripts/c13/c13.rpy:1030
translate brazilian c13s003_ScarlettHouse_cc394469:

    # sca "No tengo ni idea de como abrirlas... "
    sca "Não faço ideia de como abri-los..."

# game/scripts/c13/c13.rpy:1031
translate brazilian c13s003_ScarlettHouse_4277e4fe:

    # mc "No te preocupes, Ama... la falsa [emm] va a volver ahora... está de nuestra... de mi parte. Ayúdame a levantarme."
    mc "Não se preocupe, Ama... a impostora está voltando... ela está do nosso lado... do meu lado. Me ajude a levantar."

# game/scripts/c13/c13.rpy:1033
translate brazilian c13s003_ScarlettHouse_78d87fc9:

    # ama "Scarlett, ve a hacer las maletas. Tienes un par de horas. No creo que pueda entretenerlos mucho más antes de que empiecen a sospechar."
    ama "Scarlett, vá arrumar suas malas. Você tem algumas horas. Acho que não consigo segurá-los por muito mais tempo antes que comecem a suspeitar."

# game/scripts/c13/c13.rpy:1034
translate brazilian c13s003_ScarlettHouse_cfe0f18d:

    # "Su voz transpira autoridad. Pero Scarlett ya no es la niña tímida de hace dos semanas. Algo ha cambiado en ella."
    "Sua voz exala autoridade. Mas Scarlett não é mais a garota tímida de duas semanas atrás. Algo mudou nela."

# game/scripts/c13/c13.rpy:1036
translate brazilian c13s003_ScarlettHouse_9037a408:

    # sca "¿Por qué? ¿Y quién eres? Tienes la cara de [emm], pero ahí acaba el parecido."
    sca "Por quê? E quem é você? Você tem o rosto de [emm], mas é aí que a semelhança termina."

# game/scripts/c13/c13.rpy:1037
translate brazilian c13s003_ScarlettHouse_ad5f40e7:

    # mc "Scarlett, ya te he dicho que no te lo podía explicar ahora..."
    mc "Scarlett, eu já te disse que não conseguiria te explicar agora..."

# game/scripts/c13/c13.rpy:1040
translate brazilian c13s003_ScarlettHouse_82bd4e59:

    # ama "Será mejor que hagas caso a tu novio, Scarlett."
    ama "É melhor você ouvir o seu namorado, Scarlett."

# game/scripts/c13/c13.rpy:1042
translate brazilian c13s003_ScarlettHouse_529e2605:

    # ama "Será mejor que hagas caso a [mc], Scarlett."
    ama "É melhor você ouvir [mc], Scarlett."

# game/scripts/c13/c13.rpy:1043
translate brazilian c13s003_ScarlettHouse_e520b6e2:

    # ama "Si dejo a tu madre y a Kevin mucho rato solos saldrán del estado de shock y empezarán a notar que hay cosas que no cuadran."
    ama "Se eu deixar sua mãe e Kevin sozinhos por muito tempo, eles sairão do choque e começarão a perceber que algumas coisas não fazem sentido."

# game/scripts/c13/c13.rpy:1045
translate brazilian c13s003_ScarlettHouse_27bcf464:

    # sca "Tienes razón. Los agentes del FBI siempre van por parejas en las películas, y has dejado a un sospechoso sin vigilancia. Mi madre no es tonta y lo notará."
    sca "Você tem razão. Nos filmes, os agentes do FBI sempre trabalham em duplas, e você deixou um suspeito desprotegido. Minha mãe não é boba e vai perceber."

# game/scripts/c13/c13.rpy:1046
translate brazilian c13s003_ScarlettHouse_2f91c156:

    # sca "Voy a hacer las maletas y ahora vuelvo."
    sca "Vou arrumar minhas malas e já volto."

# game/scripts/c13/c13.rpy:1048
translate brazilian c13s003_ScarlettHouse_2e295c3e:

    # "Un minuto después, una vez retiradas las esposas..."
    "Um minuto depois, assim que as algemas foram retiradas..."

# game/scripts/c13/c13.rpy:1049
translate brazilian c13s003_ScarlettHouse_7049495e:

    # ama "¡Joder! Cuando te mandamos el video creíamos que ibas a usar a Jamaal para hacerlo viral en MeTube o llevárselo a Alexia. No esto."
    ama "Puxa! Quando enviamos o vídeo para você, pensamos que você usaria o Jamaal para viralizá-lo no MeTube ou o levaria para a Alexia. Mas não foi isso."

# game/scripts/c13/c13.rpy:1050
translate brazilian c13s003_ScarlettHouse_947cf5cd:

    # ama "He venido en cuanto he deducido que tu plan no iba a funcionar."
    ama "Cheguei assim que percebi que seu plano não ia funcionar."

# game/scripts/c13/c13.rpy:1051
translate brazilian c13s003_ScarlettHouse_805f55e4:

    # mc "Creía que esto podía solucionarlo todo... Al menos hoy te ha dado tiempo de quitarte el mono de mecánico..."
    mc "Pensei que isso pudesse resolver tudo... Pelo menos hoje você teve tempo de tirar o macacão de mecânico..."

# game/scripts/c13/c13.rpy:1052
translate brazilian c13s003_ScarlettHouse_36417800:

    # mc "¿Desde cuándo tenéis cámaras en casa de Scarlett? ¿Hay otros videos donde se vea la cara de Kevin y la Señora Russell pueda leer sus labios?"
    mc "Desde quando vocês têm câmeras na casa da Scarlett? Existem outros vídeos onde o rosto do Kevin aparece e a Sra. Russell consegue ler seus lábios?"

# game/scripts/c13/c13.rpy:1054
translate brazilian c13s003_ScarlettHouse_24b0910e:

    # ama "No, lo siento. Las pusimos el domingo, cuando Scarlett fue a comprar al supermercado..."
    ama "Não, desculpe. Nós as colocamos no domingo, quando Scarlett foi ao supermercado..."

# game/scripts/c13/c13.rpy:1056
translate brazilian c13s003_ScarlettHouse_b609be58:

    # mc "Entonces tenéis grabado..."
    mc "Então você tem isso gravado..."

# game/scripts/c13/c13.rpy:1057
translate brazilian c13s003_ScarlettHouse_a62755ee:

    # ama "Sí, pero destruímos todo lo que no es importante para la misión..."
    ama "Sim, mas destruímos tudo o que não é importante para a missão..."

# game/scripts/c13/c13.rpy:1059
translate brazilian c13s003_ScarlettHouse_424ad18e:

    # mc "Lástima... pero ¿por qué vigilar la casa de Scarlett?"
    mc "Que pena... mas por que vigiar a casa da Scarlett?"

# game/scripts/c13/c13.rpy:1060
translate brazilian c13s003_ScarlettHouse_f2975f2e:

    # ama "Podía ser importante para la misión... y destruimos lo que no es importante."
    ama "Isso pode ser importante para a missão... e destruímos o que não é importante."

# game/scripts/c13/c13.rpy:1061
translate brazilian c13s003_ScarlettHouse_ae4af940:

    # ama "{i}(O lo copiamos a discos privados.){/i}"
    ama "{i}(Ou copiamos para discos privados.){/i}"

# game/scripts/c13/c13.rpy:1062
translate brazilian c13s003_ScarlettHouse_3fddcc67:

    # mc "Y no me vas a decir cual es esa misión, ¿verdad? ¿Tiene algo que ver con la cláusula NG?"
    mc "E você não vai me dizer qual é essa missão, vai? Tem algo a ver com a cláusula NG?"

# game/scripts/c13/c13.rpy:1064
translate brazilian c13s003_ScarlettHouse_76e960e9:

    # ama "{b}¿Qué?{/b} ¿Dónde has oído eso? "
    ama "{b}O quê?{/b} Onde você ouviu isso?"

# game/scripts/c13/c13.rpy:1065
translate brazilian c13s003_ScarlettHouse_d881f221:

    # mc "Vosotras tenéis vuestros secretos y yo los míos. Cuando quieras intercambiamos información."
    mc "Você tem seus segredos e eu tenho os meus. Podemos trocar informações quando você quiser."

# game/scripts/c13/c13.rpy:1066
translate brazilian c13s003_ScarlettHouse_39cc3e0d:

    # mc "{i}(OK. No tienen acceso a mi ordenador o no son capaces de romper el cifrado de Jamaal.){/i}"
    mc "{i}(OK. Ou eles não têm acesso ao meu computador ou não conseguem quebrar a criptografia de Jamaal.){/i}"

# game/scripts/c13/c13.rpy:1068
translate brazilian c13s003_ScarlettHouse_01ede65e:

    # ama "Me parece justo. Mañana o pasado nos pondremos en contacto con vosotros para hablar."
    ama "Parece-me justo. Entraremos em contato amanhã ou depois de amanhã para discutirmos o assunto."

# game/scripts/c13/c13.rpy:1069
translate brazilian c13s003_ScarlettHouse_65abb11e:

    # ama "Voy a llevarme a la Señora Russell y a Kevin o van a empezar a sospechar. Les voy a decir que estás detenido, con lo que mejor que no pases por este barrio en unos días."
    ama "Vou levar a Sra. Russell e o Kevin comigo, senão eles vão começar a suspeitar. Vou dizer a eles que você está preso, então é melhor não aparecer por aqui nos próximos dias."

# game/scripts/c13/c13.rpy:1070
translate brazilian c13s003_ScarlettHouse_776dbc69:

    # mc "Sólo una pregunta más. ¿Por qué me habéis enviado el video? Scarlett no tiene nada que ver con NTR o con GILF."
    mc "Só mais uma pergunta. Por que você me enviou o vídeo? Scarlett não tem nada a ver com NTR ou GILF."

# game/scripts/c13/c13.rpy:1072
translate brazilian c13s003_ScarlettHouse_1a22ac27:

    # ama "Porque pensamos que podía ser importante. Especialmente para ti... y para [dap]... aunque no tenga nada que ver con la misión. Y porque Kevin es un cerdo."
    ama "Porque achamos que poderia ser importante. Especialmente para você... e para [dap]... mesmo que não tenha nada a ver com a missão. E porque o Kevin é um porco."

# game/scripts/c13/c13.rpy:1073
translate brazilian c13s003_ScarlettHouse_b2516466:

    # mc "Gracias."
    mc "Obrigado."

# game/scripts/c13/c13.rpy:1075
translate brazilian c13s003_ScarlettHouse_514c8615:

    # ama "No tienes que darlas. Saca a Scarlett de aquí en cuanto puedas."
    ama "Você não precisa desistir deles. Tire Scarlett daqui o mais rápido possível."

# game/scripts/c13/c13.rpy:1076
translate brazilian c13s003_ScarlettHouse_b69bbafa:

    # ama "No sabía lo del dinero de su padre, pero parece que era una de las razones por la que la Señora Russell no la ha echado antes."
    ama "Eu não sabia sobre o dinheiro do pai dela, mas parece que esse foi um dos motivos pelos quais a Sra. Russell não a demitiu antes."

# game/scripts/c13/c13.rpy:1077
translate brazilian c13s003_ScarlettHouse_318d4368:

    # ama "Nos veremos pronto. Buen puñetazo, por cierto."
    ama "Até breve. Aliás, o ponche estava ótimo."

# game/scripts/c13/c13.rpy:1080
translate brazilian c13s003_ScarlettHouse_0f479e29:

    # "Haces una llamada a [nor] y, después de confirmar la que pensabas que sería su respuesta, vas a la habitación de Scarlett."
    "Você faz uma ligação para [nor] e, após confirmar o que você achava que seria a resposta dela, você vai para o quarto de Scarlett."

# game/scripts/c13/c13.rpy:1083
translate brazilian c13s003_ScarlettHouse_6d700f97:

    # mc "¿Necesitas ayuda?"
    mc "Você precisa de ajuda?"

# game/scripts/c13/c13.rpy:1084
translate brazilian c13s003_ScarlettHouse_ac751ecc:

    # sca "No sé por donde empezar. He cogido la ropa... y... y..."
    sca "Não sei por onde começar. Peguei as roupas... e... e..."

# game/scripts/c13/c13.rpy:1085
translate brazilian c13s003_ScarlettHouse_b3df5efd:

    # mc "Ven aquí."
    mc "Venha aqui."

# game/scripts/c13/c13.rpy:1087
translate brazilian c13s003_ScarlettHouse_e808086f:

    # sca "No tengo ni idea de qué voy a hacer... de dónde voy a vivir... estoy sin blanca..."
    sca "Não tenho ideia do que vou fazer... onde vou morar... Estou sem dinheiro..."

# game/scripts/c13/c13.rpy:1088
translate brazilian c13s003_ScarlettHouse_1d01af04:

    # mc "No te preocupes por eso. Acabo de hablar con [nor] y con [dap]. Les he explicado lo que ha pasado... al menos parte. He obviado lo del video."
    mc "Não se preocupe com isso. Acabei de falar com [nor] e [dap]. Expliquei o que aconteceu... pelo menos parte disso. Deixei de fora a parte sobre o vídeo."

# game/scripts/c13/c13.rpy:1089
translate brazilian c13s003_ScarlettHouse_8b4e277b:

    # mc "Puedes vivir en casa de [nor], si no te importa compartir habitacion con [dap]."
    mc "Você pode morar na casa de [nor], se não se importar de dividir o quarto com [dap]."

# game/scripts/c13/c13.rpy:1091
translate brazilian c13s003_ScarlettHouse_de3bf20f:

    # sca "¿Que has hecho {b}qué{/b}?"
    sca "O que é que você fez?"

# game/scripts/c13/c13.rpy:1092
translate brazilian c13s003_ScarlettHouse_226564a3:

    # mc "Sí, Scarlett. No tienes que preocuparte de dónde vas a vivir. Casi eres parte de la familia..."
    mc "Sim, Scarlett. Você não precisa se preocupar com onde vai morar. Você já é praticamente da família..."

# game/scripts/c13/c13.rpy:1095
translate brazilian c13s003_ScarlettHouse_9f2f97ad:

    # sca "Te quiero. Gracias."
    sca "Eu te amo. Obrigada."

# game/scripts/c13/c13.rpy:1096
translate brazilian c13s003_ScarlettHouse_95625d17:

    # mc "Y yo a ti. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "E eu também te amo. Você costumava passar metade das suas noites lá. Agora será todas as noites."

# game/scripts/c13/c13.rpy:1099
translate brazilian c13s003_ScarlettHouse_2a24d1ed:

    # sca "Gracias, [mc]."
    sca "Obrigado, [mc]."

# game/scripts/c13/c13.rpy:1100
translate brazilian c13s003_ScarlettHouse_9b5f1825:

    # mc "No tienes por que darlas. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "Você não precisa desistir deles. Antes você passava metade das noites lá. Agora será todas as noites."

# game/scripts/c13/c13.rpy:1101
translate brazilian c13s003_ScarlettHouse_04554e14:

    # mc "Vamos a acabar de recoger tus cosas y las llevamos a la camioneta."
    mc "Vamos terminar de recolher seus pertences e levá-los para a van."

# game/scripts/c13/c13.rpy:1103
translate brazilian c13s003_ScarlettHouse_f65fe139:

    # sca "Pero ¿qué me llevo? Toda mi vida está en esta habitación..."
    sca "Mas o que estou levando comigo? Toda a minha vida está neste quarto..."

# game/scripts/c13/c13.rpy:1104
translate brazilian c13s003_ScarlettHouse_7db5c2cf:

    # mc "Todo lo que quieras conservar."
    mc "Tudo o que você quiser guardar."

# game/scripts/c13/c13.rpy:1106
translate brazilian c13s003_ScarlettHouse_e16aa35c:

    # mc "Todo lo que quieras llevarte de esta vida a la que vas a empezar en casa."
    mc "Tudo o que você deseja levar consigo desta vida que está prestes a começar em casa."

# game/scripts/c13/c13.rpy:1108
translate brazilian c13s003_ScarlettHouse_a1efddeb:

    # mc "Tus fotos y pósters..."
    mc "Suas fotos e pôsteres..."

# game/scripts/c13/c13.rpy:1110
translate brazilian c13s003_ScarlettHouse_bd3a184f:

    # mc "Discos, libros..."
    mc "Registros, livros..."

# game/scripts/c13/c13.rpy:1111
translate brazilian c13s003_ScarlettHouse_200e44b7:

    # mc "Cualquier cosa que quieras conservar. La parte de atrás de la camioneta está vacía. Voy a ir llevando el tocadiscos mientras decides que llevar."
    mc "Fique com o que quiser. A carroceria da caminhonete está vazia. Eu levo o toca-discos enquanto você decide o que levar."

# game/scripts/c13/c13.rpy:1114
translate brazilian c13s003_ScarlettHouse_6aba73a2:

    # "Una hora después, tras varios viajes a la camioneta y una llamada de teléfono..."
    "Uma hora depois, após várias viagens até o caminhão e um telefonema..."

# game/scripts/c13/c13.rpy:1115
translate brazilian c13s003_ScarlettHouse_3201de0e:

    # sca "Ya está todo. Nos podemos ir."
    sca "Pronto. Podemos ir."

# game/scripts/c13/c13.rpy:1116
translate brazilian c13s003_ScarlettHouse_4dab87e9:

    # mc "Despídete de esta casa, Scarlett. ¿Lo llevamos todo?"
    mc "Diga adeus a esta casa, Scarlett. Vamos levar tudo?"

# game/scripts/c13/c13.rpy:1119
translate brazilian c13s003_ScarlettHouse_74dca989:

    # sca "Sí, no queda nada ahí que quiera conservar. Una parte de mí la va a echar de menos. Otra parte mayor... no."
    sca "Sim, não sobrou nada lá que eu queira guardar. Uma parte de mim sentirá falta. Uma parte maior... não."

# game/scripts/c13/c13.rpy:1120
translate brazilian c13s003_ScarlettHouse_7aa1096f:

    # sca "Saber que mi madre me ha estado ocultando cosas, que ha estado en contacto con mi padre todo este tiempo... que ha creído a Kevin antes que a mí..."
    sca "Saber que minha mãe estava escondendo coisas de mim, que ela esteve em contato com meu pai o tempo todo... que ela acreditou em Kevin antes de acreditar em mim..."

# game/scripts/c13/c13.rpy:1121
translate brazilian c13s003_ScarlettHouse_bdab500e:

    # mc "Sé que es difícil de digerir, pero vas a vivir con nosotros. Te vamos a ayudar entre todos."
    mc "Eu sei que é difícil de aceitar, mas você vai morar conosco. Todos nós vamos te ajudar."

# game/scripts/c13/c13.rpy:1123
translate brazilian c13s003_ScarlettHouse_000e092e:

    # sca "Gracias, [mc], una vez más."
    sca "Obrigado, [mc], mais uma vez."

# game/scripts/c13/c13.rpy:1124
translate brazilian c13s003_ScarlettHouse_978ec110:

    # mc "No tienes por qué darlas. Pero nos tenemos que ir. Las nuevas inquilinas nos estarán esperando."
    mc "Você não precisa entregá-los. Mas nós precisamos ir. Os novos inquilinos estarão nos esperando."

# game/scripts/c13/c13.rpy:1126
translate brazilian c13s003_ScarlettHouse_89ac21b9:

    # sca "Es verdad, hoy llegaba la última estudiante del verano."
    sca "Isso mesmo, hoje chegou o último estudante do verão."

# game/scripts/c13/c13.rpy:1127
translate brazilian c13s003_ScarlettHouse_e944ed7a:

    # mc "Sí, pasamos por el hospital a recoger a Kiara y vamos al aeropuerto a buscarla. Su vuelo llega en una hora."
    mc "Sim, vamos ao hospital buscar a Kiara e depois vamos ao aeroporto para buscá-la. O voo dela chega em uma hora."

# game/scripts/c13/c13.rpy:1129
translate brazilian c13s003_ScarlettHouse_ad060bf5:

    # sca "¿Kiara?"
    sca "Kiara?"

# game/scripts/c13/c13.rpy:1130
translate brazilian c13s003_ScarlettHouse_b1268ea3:

    # mc "Ahora la conocerás. Creo que te va a gustar."
    mc "Você vai conhecê-la agora. Acho que você vai gostar dela."

# game/scripts/c13/c13.rpy:1163
translate brazilian c13s004_KiaraAndScarlett_5ef2e59f:

    # sca "¿Quién es? ¿La conozco? No me suena el nombre."
    sca "Quem é ela? Eu a conheço? O nome não me é familiar."

# game/scripts/c13/c13.rpy:1164
translate brazilian c13s004_KiaraAndScarlett_b6297da9:

    # mc "Es la madre de Eileen. Va a vivir unos días con vosotras, en casa de [nor]."
    mc "Ela é a mãe da Eileen. Ela vai ficar com você por alguns dias, na casa de [nor]."

# game/scripts/c13/c13.rpy:1166
translate brazilian c13s004_KiaraAndScarlett_e8600231:

    # sca "¿Eileen también?"
    sca "Eileen também?"

# game/scripts/c13/c13.rpy:1167
translate brazilian c13s004_KiaraAndScarlett_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Sim, por que você pergunta?"

# game/scripts/c13/c13.rpy:1170
translate brazilian c13s004_KiaraAndScarlett_a7826cfb:

    # sca "Tan solo por curiosidad. Hace un tiempo me hubiera puesto celosa por saber que Eileen iba a vivir en tu casa... más o menos..."
    sca "Só por curiosidade. Há algum tempo atrás, eu teria ficado com inveja se soubesse que a Eileen ia morar na sua casa... mais ou menos..."

# game/scripts/c13/c13.rpy:1172
translate brazilian c13s004_KiaraAndScarlett_b0adc982:

    # sca "Ahora que sé que estás saliendo con otras chicas, casi me alegraría que Eileen fuera una de ellas... y no, no estoy preguntando si lo es."
    sca "Agora que sei que você está saindo com outras garotas, eu quase ficaria feliz se a Eileen fosse uma delas... e não, eu não estou perguntando se ela é."

# game/scripts/c13/c13.rpy:1173
translate brazilian c13s004_KiaraAndScarlett_51746308:

    # mc "Eso se lo tendrás que preguntar a ella. A ser posible conmigo delante. *Risa* Su cara puede ser muy divertida {b}si{/b} no estoy con ella."
    mc "Você vai ter que perguntar isso a ela. Idealmente, comigo por perto. *Risos* A cara dela pode ser hilária {b}se{/b} eu não estiver com ela."

# game/scripts/c13/c13.rpy:1175
translate brazilian c13s004_KiaraAndScarlett_c76f8262:

    # sca "Ahora que estás saliendo conmigo, me da lo mismo quien viva contigo... con nosotros..."
    sca "Agora que você está namorando comigo, não me importo com quem mora com você... conosco..."

# game/scripts/c13/c13.rpy:1176
translate brazilian c13s004_KiaraAndScarlett_32afb495:

    # mc "Scarlett, ahora mismo solo me importas tú. No me importa quién viva en casa."
    mc "Scarlett, neste momento você é tudo o que me importa. Não me importo com quem mora em casa."

# game/scripts/c13/c13.rpy:1179
translate brazilian c13s004_KiaraAndScarlett_44fd8b13:

    # sca "Tan solo por curiosidad. Tú y yo no vamos a estar juntos nunca, con lo que no debo ponerme celosa por que tu ex viva en tu casa... más o menos..."
    sca "Só por curiosidade. Nós nunca vamos ficar juntos, então eu não deveria sentir ciúmes de que seu ex more na sua casa... mais ou menos..."

# game/scripts/c13/c13.rpy:1180
translate brazilian c13s004_KiaraAndScarlett_efc8d372:

    # mc "Scarlett, ya lo hemos hablado. No sería justo para ninguno de los dos, lo único que harías es hacerte daño."
    mc "Scarlett, já conversamos sobre isso. Não seria justo para nenhuma de nós; você só ia se machucar."

# game/scripts/c13/c13.rpy:1181
translate brazilian c13s004_KiaraAndScarlett_476b8ad5:

    # sca "Lo sé, pero no por ello es más fácil."
    sca "Eu sei, mas isso não torna as coisas mais fáceis."

# game/scripts/c13/c13.rpy:1183
translate brazilian c13s004_KiaraAndScarlett_d2307d68:

    # sca "Si puedo preguntar, ¿por qué se han mudado a casa de [nor]?"
    sca "Se me permite perguntar, por que você se mudou para a casa de [nor]?"

# game/scripts/c13/c13.rpy:1184
translate brazilian c13s004_KiaraAndScarlett_e3304c3c:

    # mc "Por la misma razón que tú. Han tenido problemas en casa, y les hemos ofrecido un sitio donde quedarse. De momento se quedarán una semana."
    mc "Pelo mesmo motivo que você. Eles tiveram problemas em casa e oferecemos a eles um lugar para ficar. Por enquanto, eles ficarão por uma semana."

# game/scripts/c13/c13.rpy:1185
translate brazilian c13s004_KiaraAndScarlett_643a6609:

    # sca "Supongo que no vas a entrar en detalles igual que no entrarías si alguien te preguntará por qué me he mudado yo."
    sca "Imagino que você não entrará em detalhes, assim como não entraria se alguém lhe perguntasse por que me mudei."

# game/scripts/c13/c13.rpy:1186
translate brazilian c13s004_KiaraAndScarlett_a4c22620:

    # mc "Exacto. Creo que cada una de vosotras tiene derecho a explicar lo que quiera a quién quiera."
    mc "Exatamente. Acredito que cada um de vocês tem o direito de explicar o que quiser para quem quiser."

# game/scripts/c13/c13.rpy:1188
translate brazilian c13s004_KiaraAndScarlett_a843553c:

    # sca "Y cambiando de tema... ¿quién es la falsa [emm]?"
    sca "E mudando de assunto... quem é o falso [emm]?"

# game/scripts/c13/c13.rpy:1189
translate brazilian c13s004_KiaraAndScarlett_85a9d95c:

    # mc "Aún no estoy muy seguro. De momento te puedo decir que las dos veces que la he visto ha aparecido para ayudar. Fue ella la que mandó el video."
    mc "Ainda não tenho certeza absoluta. Por enquanto, posso dizer que nas duas vezes em que a vi, ela estava lá para ajudar. Foi ela quem enviou o vídeo."

# game/scripts/c13/c13.rpy:1190
translate brazilian c13s004_KiaraAndScarlett_036ff51c:

    # mc "Me ha dicho que en uno o dos días se pondrá en contacto con la familia para aclarar las cosas... supongo..."
    mc "Ele me disse que entraria em contato com a família em um ou dois dias para esclarecer as coisas... suponho..."

# game/scripts/c13/c13.rpy:1192
translate brazilian c13s004_KiaraAndScarlett_de8df744:

    # sca "¿Cómo sabía lo que estaba pasando? ¿También hay cámaras en el salón?"
    sca "Como ele sabia o que estava acontecendo? Será que também há câmeras na sala de estar?"

# game/scripts/c13/c13.rpy:1193
translate brazilian c13s004_KiaraAndScarlett_af4565c7:

    # mc "Creo que la casa de tu madre tiene cámaras por todos lados..."
    mc "Acho que a casa da sua mãe tem câmeras por toda parte..."

# game/scripts/c13/c13.rpy:1195
translate brazilian c13s004_KiaraAndScarlett_cfc8099c:

    # mcp "{i}(Mejor no decirle que nos grabaron el domingo. Si han destruído el video, no hay de qué preocuparse.){/i}"
    mcp "{i}(É melhor não contar a eles que fomos gravados no domingo. Se eles destruíram o vídeo, não há com o que se preocupar.){/i}"

# game/scripts/c13/c13.rpy:1196
translate brazilian c13s004_KiaraAndScarlett_ce92fc45:

    # mc "Ya estamos llegando al hospital. Ahora te presento a Kiara y vamos a comer."
    mc "Estamos quase chegando ao hospital. Agora vou te apresentar a Kiara e depois vamos almoçar."

# game/scripts/c13/c13.rpy:1198
translate brazilian c13s004_KiaraAndScarlett_b831fce0:

    # mc "Hola, Kiara. Sube."
    mc "Oi, Kiara. Pode subir."

# game/scripts/c13/c13.rpy:1200
translate brazilian c13s004_KiaraAndScarlett_58b194a6:

    # mc "¿Cómo ha ido? ¿Qué tal te ha tratado Sam?"
    mc "Como foi? Como Sam te tratou?"

# game/scripts/c13/c13.rpy:1201
translate brazilian c13s004_KiaraAndScarlett_358f76fc:

    # kia "Mal y bien. El hematoma es señal de un pequeño desgarro muscular. Samantha ha sido un cielo, me ha dado un ungüento."
    kia "O lado bom e o lado ruim. O hematoma é sinal de uma pequena ruptura muscular. Samantha foi maravilhosa; ela me deu uma pomada."

# game/scripts/c13/c13.rpy:1202
translate brazilian c13s004_KiaraAndScarlett_2893d567:

    # mc "Por cierto, Scarlett - Kiara, Kiara - Scarlett."
    mc "A propósito, Scarlett - Kiara, Kiara - Scarlett."

# game/scripts/c13/c13.rpy:1203
translate brazilian c13s004_KiaraAndScarlett_32eb5c67:

    # kia "Encantada, Scarlett."
    kia "Prazer em conhecê-la, Scarlett."

# game/scripts/c13/c13.rpy:1205
translate brazilian c13s004_KiaraAndScarlett_a1ed0ab0:

    # sca "Igualmente, Kiara. Me ha dicho [mc] que somos las nuevas inquilinas. Yo también me mudo hoy."
    sca "Igualmente, Kiara. Ela me disse que somos os novos inquilinos. Eu também estou me mudando hoje."

# game/scripts/c13/c13.rpy:1207
translate brazilian c13s004_KiaraAndScarlett_5287ccd9:

    # kia "¡Oh! ¿Eres la nueva estudiante? Creía que tu vuelo llegaba más tarde..."
    kia "Ah! Você é o aluno novo? Pensei que seu voo chegasse mais tarde..."

# game/scripts/c13/c13.rpy:1208
translate brazilian c13s004_KiaraAndScarlett_7bd44854:

    # mc "No, Scarlett es una amiga de la familia. Se va a mudar a la habitación de [dap]. A la estudiante la irémos a buscar después de dejarte en el trabajo."
    mc "Não, Scarlett é uma amiga da família. Ela vai se mudar para o quarto [dap]. Nós a buscaremos depois que deixarmos você no trabalho."

# game/scripts/c13/c13.rpy:1210
translate brazilian c13s004_KiaraAndScarlett_20e889df:

    # kia "Genial, me extrañaba que hubiera volado con tantas cajas."
    kia "Ótimo, fiquei surpreso que tenha voado com tantas caixas."

# game/scripts/c13/c13.rpy:1211
translate brazilian c13s004_KiaraAndScarlett_0d285e83:

    # kia "No me va a dar tiempo de comer con vosotros. Voy a llegar un poco justa."
    kia "Não terei tempo para comer com você. Estarei com um pouco de pressa."

# game/scripts/c13/c13.rpy:1212
translate brazilian c13s004_KiaraAndScarlett_7f73e754:

    # mc "Aún nos queda un rato. Conozco un sitio al lado de tu trabajo. O conocía antes de ir a la universidad... no sé si el puesto de perritos seguirá ahí."
    mc "Ainda temos um tempo. Conheço um lugar perto do seu trabalho. Ou melhor, eu o conhecia antes de ir para a universidade... Não sei se a barraquinha de cachorro-quente ainda está lá."

# game/scripts/c13/c13.rpy:1214
translate brazilian c13s004_KiaraAndScarlett_7e424464:

    # kia "Sí, sigue ahí. Dejadme invitaros a comer."
    kia "Sim, ainda está lá. Gostaria de convidá-lo(a) para almoçar."

# game/scripts/c13/c13.rpy:1215
translate brazilian c13s004_KiaraAndScarlett_0e6f0b92:

    # mc "He sido yo quién te ha dicho que te invitaría a comer, con lo que no voy a aceptar que pagues tú."
    mc "Fui eu quem disse que te pagaria o almoço, então não vou aceitar que você pague."

# game/scripts/c13/c13.rpy:1216
translate brazilian c13s004_KiaraAndScarlett_db027e54:

    # mc "Scarlett, ¿te gustan los perritos?"
    mc "Scarlett, você gosta de cachorrinhos?"

# game/scripts/c13/c13.rpy:1218
translate brazilian c13s004_KiaraAndScarlett_5233075e:

    # sca "¡Me encantan!"
    sca "Eu os adoro!"

# game/scripts/c13/c13.rpy:1219
translate brazilian c13s004_KiaraAndScarlett_8758fbc0:

    # mc "Entonces no se hable más. Perritos para todos."
    mc "Então está decidido. Filhotes para todos."

# game/scripts/c13/c13.rpy:1222
translate brazilian c13s004_KiaraAndScarlett_a94a922f:

    # "Unos perritos después..."
    "Depois de alguns filhotes..."

# game/scripts/c13/c13.rpy:1224
translate brazilian c13s004_KiaraAndScarlett_e4c4cefc:

    # sca "Y esa es mi historia y por qué de me estoy mudando..."
    sca "E essa é a minha história e o motivo da minha mudança..."

# game/scripts/c13/c13.rpy:1225
translate brazilian c13s004_KiaraAndScarlett_06996d74:

    # mcp "{i}(Has hecho bien en omitir lo del video. Habría que dar muchas explicaciones a Kiara y querría hablar con Amanda antes. O con Eva.){/i}"
    mcp "{i}(Você fez bem em omitir o vídeo. Eu teria que dar muitas explicações para a Kiara, e gostaria de falar primeiro com a Amanda. Ou com a Eva.){/i}"

# game/scripts/c13/c13.rpy:1227
translate brazilian c13s004_KiaraAndScarlett_8453653e:

    # kia "Lo siento mucho, Scarlett. Yo creía que lo mío era malo, pero lo tuyo es horrible."
    kia "Sinto muito, Scarlett. Eu achava que o que eu tinha era ruim, mas o que você tem é horrível."

# game/scripts/c13/c13.rpy:1228
translate brazilian c13s004_KiaraAndScarlett_360b7833:

    # kia "No sé si es peor lo de Kevin o que te haya ocultado que ha estado en contacto con tu padre."
    kia "Não sei se o que aconteceu com o Kevin é pior, ou o fato de ele ter escondido de você que estava em contato com seu pai."

# game/scripts/c13/c13.rpy:1229
translate brazilian c13s004_KiaraAndScarlett_2cf9c70c:

    # mcp "(Es sorprendente lo rápido que han encajado estas dos. Las dos lo han pasado mal y a Kiara le ha salido la vena maternal y protectora en cuanto se han explicado sus historias.)"
    mcp "(É surpreendente a rapidez com que essas duas se conectaram. Ambas passaram por momentos difíceis, mas o lado maternal e protetor de Kiara aflorou assim que compartilharam suas histórias.)"

# game/scripts/c13/c13.rpy:1231
translate brazilian c13s004_KiaraAndScarlett_14d8115c:

    # sca "Lo más peligroso ha sido lo de Kevin. Lo que más me ha dolido ha sido lo de mi padre."
    sca "O mais perigoso foi o que aconteceu com Kevin. O que mais me magoou foi o que aconteceu com meu pai."

# game/scripts/c13/c13.rpy:1232
translate brazilian c13s004_KiaraAndScarlett_a1e52128:

    # sca "Ella sabe lo importante que ha sido para mí saber quién es durante todos estos años. Ocultarmelo ha sido... doloroso."
    sca "Ela sabe o quanto foi importante para mim saber quem ela é durante todos esses anos. Esconder isso de mim foi... doloroso."

# game/scripts/c13/c13.rpy:1234
translate brazilian c13s004_KiaraAndScarlett_354746d2:

    # mcp "{i}(Si mis sospechas son ciertas, no tendrás que esperar mucho para saberlo, aunque sea un saco de mierda.){/i}"
    mcp "{i}(Se minhas suspeitas estiverem corretas, você não terá que esperar muito para descobrir, mesmo que seja um monte de besteira.){/i}"

# game/scripts/c13/c13.rpy:1236
translate brazilian c13s004_KiaraAndScarlett_dd9e5fa2:

    # kia "Yo podría hacer algo al respecto si la cosa se pusiera fea, pero tú lo tienes más complicado con lo de Kevin. Sin pruebas..."
    kia "Eu poderia fazer algo a respeito se a situação ficasse feia, mas você está numa situação mais complicada com o Kevin. Sem provas..."

# game/scripts/c13/c13.rpy:1237
translate brazilian c13s004_KiaraAndScarlett_3222cbfa:

    # mc "Ahora solo hace falta que quieras hacerlo antes de que se ponga demasiado fea."
    mc "Agora, tudo o que você precisa fazer é querer fazer isso antes que a situação piore muito."

# game/scripts/c13/c13.rpy:1239
translate brazilian c13s004_KiaraAndScarlett_fb4a8f13:

    # kia "No insistas, [mc]. No quiero poner la denuncia. Ha sido la primera vez en 3 años, creo que se va a asustar lo suficiente con que nos hayamos marchado como para repetirlo."
    kia "Não insista, [mc]. Não quero apresentar queixa. Foi a primeira vez em três anos; acho que ele ficará suficientemente assustado com a nossa partida para não fazer isso de novo."

# game/scripts/c13/c13.rpy:1240
translate brazilian c13s004_KiaraAndScarlett_ff89f607:

    # mc "No estoy insistiendo, Kiara. Al menos ahora tienes un informe médico por si cambias de opinión. Espero que no lo hagas demasiado tarde."
    mc "Não estou te pressionando, Kiara. Pelo menos agora você tem um laudo médico caso mude de ideia. Espero que você não demore muito para fazer isso."

# game/scripts/c13/c13.rpy:1242
translate brazilian c13s004_KiaraAndScarlett_c023c137:

    # sca "Creo que te equivocas, [mc]. Si fuera yo, presentaría la denuncia, pero Kiara tiene razón."
    sca "Acho que você está enganado, [mc]. Se fosse eu, registraria a queixa, mas Kiara está certa."

# game/scripts/c13/c13.rpy:1243
translate brazilian c13s004_KiaraAndScarlett_3c49f85a:

    # sca "Pero quien pega a una mujer por norma es un cobarde. Kiara y Eileen lo han abandonado, aunque sea temporalmente, y eso le hará recapacitar."
    sca "Mas um homem que bate rotineiramente em uma mulher é um covarde. Kiara e Eileen o deixaram, mesmo que apenas temporariamente, e isso o fará repensar suas atitudes."

# game/scripts/c13/c13.rpy:1244
translate brazilian c13s004_KiaraAndScarlett_def014f3:

    # mc "Espero que tengas razón. Que la tengáis las dos."
    mc "Espero que você esteja certo. Espero que ambos estejam certos."

# game/scripts/c13/c13.rpy:1246
translate brazilian c13s004_KiaraAndScarlett_f1d8bdfe:

    # kia "Yo sé que la tenemos, y lo verás la semana que viene cuando volvamos a casa."
    kia "Eu sei que temos isso, e você verá na próxima semana quando voltarmos para casa."

# game/scripts/c13/c13.rpy:1247
translate brazilian c13s004_KiaraAndScarlett_5e10232b:

    # kia "Ahora debería ir a trabajar si no quiero llegar tarde. Muchas gracias por todo, [mc]."
    kia "Devo ir trabalhar agora se não quiser me atrasar. Muito obrigada por tudo, [mc]."

# game/scripts/c13/c13.rpy:1248
translate brazilian c13s004_KiaraAndScarlett_b94a64b5:

    # mc "¿Quieres que pase a buscarte cuando salgas del trabajo?"
    mc "Você quer que eu te busque quando você sair do trabalho?"

# game/scripts/c13/c13.rpy:1250
translate brazilian c13s004_KiaraAndScarlett_60042da8:

    # kia "No hace falta, cogeré el autobús. Saldré tarde hoy."
    kia "Não precisa, eu pego o ônibus. Vou sair tarde hoje."

# game/scripts/c13/c13.rpy:1251
translate brazilian c13s004_KiaraAndScarlett_b3a301a0:

    # kia "Nos vemos en casa de [nor], Scarlett. Hasta luego, [mc]."
    kia "Te vejo na casa de [nor], Scarlett. Até mais, [mc]."

# game/scripts/c13/c13.rpy:1252
translate brazilian c13s004_KiaraAndScarlett_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Adeus, Kiara."

# game/scripts/c13/c13.rpy:1254
translate brazilian c13s004_KiaraAndScarlett_3218746c:

    # sca "Nos vemos en casa, Kiara."
    sca "Te vejo em casa, Kiara."

# game/scripts/c13/c13.rpy:1255
translate brazilian c13s004_KiaraAndScarlett_3a775a62:

    # mcp "{i}(Enorme diferencia en la misma frase. Para Scarlett ya es su casa. Kiara lógicamente se siente como una invitada. No me importaría que se quedaran. Estarían más seguras.){/i}"
    mcp "{i}(Uma grande diferença na mesma frase. Para Scarlett, já é a casa dela. Kiara, compreensivelmente, se sente como uma convidada. Eu não me importaria se elas ficassem. Elas estariam mais seguras.){/i}"

# game/scripts/c13/c13.rpy:1256
translate brazilian c13s004_KiaraAndScarlett_54150ef5:

    # mc "Siguiente parada, el aeropuerto para recoger a Saira"
    mc "Próxima parada: o aeroporto para buscar Saira."

# game/scripts/c13/c13.rpy:1258
translate brazilian c13s004_KiaraAndScarlett_b9d51006:

    # sca "¿Saira? ¿No se llamaba así tu novia de Portland? Bueno... novia... la chica con la que tenías una relación abierta..."
    sca "Saira? Não era esse o nome da sua namorada de Portland? Bem... namorada... a garota com quem você tinha um relacionamento aberto..."

# game/scripts/c13/c13.rpy:1259
translate brazilian c13s004_KiaraAndScarlett_06eb7682:

    # mc "Sí, estoy seguro de que es ella. Solo me falta confirmarlo."
    mc "Sim, tenho certeza de que é ela. Só preciso confirmar."

# game/scripts/c13/c13.rpy:1261
translate brazilian c13s004_KiaraAndScarlett_cb35737c:

    # sca "¿Querrías que fuera ella?"
    sca "Você gostaria que fosse ela?"

# game/scripts/c13/c13.rpy:1262
translate brazilian c13s004_KiaraAndScarlett_a84177cf:

    # mc "Por una parte no estoy seguro. Por otra, sí, lo querría. Si no fuera ella no la reconocería y me he dejado el cartel con su nombre en casa. *Risa*"
    mc "Por um lado, não tenho certeza. Por outro, sim, eu reconheceria. Se não fosse ela, eu não a reconheceria, e deixei a placa com o nome dela em casa. *Risos*"

# game/scripts/c13/c13.rpy:1264
translate brazilian c13s004_KiaraAndScarlett_7e338ccc:

    # mc "¿Te molestaría que fuera ella?"
    mc "Você se importaria se fosse ela?"

# game/scripts/c13/c13.rpy:1266
translate brazilian c13s004_KiaraAndScarlett_abb3b810:

    # sca "Por una parte sí. No saber si viene a recuperarte o no... me pondría nerviosa."
    sca "De certa forma, sim. Não saber se ele virá te buscar ou não... me deixaria nervosa."

# game/scripts/c13/c13.rpy:1267
translate brazilian c13s004_KiaraAndScarlett_1b73f7b4:

    # sca "Por otra parte, le debo estar agradecida."
    sca "Por outro lado, devo-lhe a minha gratidão."

# game/scripts/c13/c13.rpy:1268
translate brazilian c13s004_KiaraAndScarlett_ce705018:

    # mc "¿Qué? ¿Por qué?"
    mc "O quê? Por quê?"

# game/scripts/c13/c13.rpy:1271
translate brazilian c13s004_KiaraAndScarlett_82bd8710:

    # sca "Por meterte en esa cabezota tuya la idea de las relaciones abiertas o con más de una chica."
    sca "Por ter colocado a ideia de relacionamentos abertos ou relacionamentos com mais de uma garota nessa sua cabecinha."

# game/scripts/c13/c13.rpy:1273
translate brazilian c13s004_KiaraAndScarlett_17f694d7:

    # sca "No me gustaría tener que competir con [dap] por la exclusividad."
    sca "Eu não gostaria de ter que competir com [dap] pela exclusividade."

# game/scripts/c13/c13.rpy:1275
translate brazilian c13s004_KiaraAndScarlett_75d06d6d:

    # sca "Si solo quisieras estar con una chica yo tendría menos oportunidades de ser la elegida."
    sca "Se você só quisesse ficar com uma garota, eu teria menos chances de ser a escolhida."

# game/scripts/c13/c13.rpy:1277
translate brazilian c13s004_KiaraAndScarlett_69fa4c89:

    # sca "Por dejarte marchar sin asegurar la relación. Si no fuera por eso, difícilmente estaríamos juntos ahora."
    sca "Por ter te deixado ir sem consolidar o relacionamento. Se não fosse por isso, dificilmente estaríamos juntos agora."

# game/scripts/c13/c13.rpy:1278
translate brazilian c13s004_KiaraAndScarlett_deb508bd:

    # mc "Tienes razón. La situación sería muy diferente si no fuera por ella."
    mc "Você tem razão. A situação seria muito diferente se não fosse por ela."

# game/scripts/c13/c13.rpy:1279
translate brazilian c13s004_KiaraAndScarlett_425e57ba:

    # mc "Ya que estamos hablando de Saira, ¿cómo quieres que te presente? ¿Amiga? ¿Novia?"
    mc "Já que estamos falando da Saira, como você gostaria que eu a apresentasse? Amiga? Namorada?"

# game/scripts/c13/c13.rpy:1281
translate brazilian c13s004_KiaraAndScarlett_739cb058:

    # sca "¡Novia, por supuesto! Si quieres hacerlo público claro..."
    sca "Namorada, claro! Se você quiser tornar isso público, sem problemas..."

# game/scripts/c13/c13.rpy:1282
translate brazilian c13s004_KiaraAndScarlett_c38fe74d:

    # mc "Entonces será novia."
    mc "Então ela será minha namorada."

# game/scripts/c13/c13.rpy:1285
translate brazilian c13s004_KiaraAndScarlett_b5aa0bb2:

    # sca "¿Vamos? Tengo ganas de conocerla."
    sca "Vamos? Eu adoraria conhecê-la."

# game/scripts/c13/c13.rpy:1327
translate brazilian c13s004_GetSaira_581ae97d:

    # mc "Vamos a quedarnos sentados aquí un momento, Scarlett. Hay un tema que quiero hablar contigo."
    mc "Vamos sentar aqui um instante, Scarlett. Há algo que eu gostaria de conversar com você."

# game/scripts/c13/c13.rpy:1328
translate brazilian c13s004_GetSaira_5cc848a0:

    # sca "De golpe estás sonando muy serio, [mc]. ¿Pasa algo?"
    sca "De repente você parece muito sério, [mc]. Aconteceu alguma coisa?"

# game/scripts/c13/c13.rpy:1329
translate brazilian c13s004_GetSaira_c84d738d:

    # mc "Bueno, hay algo que quiero comentarte."
    mc "Bem, tem algo que eu quero te contar."

# game/scripts/c13/c13.rpy:1331
translate brazilian c13s004_GetSaira_1729258b:

    # sca "Me estás preocupando. ¿He hecho algo malo?"
    sca "Você está me preocupando. Será que fiz algo errado?"

# game/scripts/c13/c13.rpy:1332
translate brazilian c13s004_GetSaira_354b54b1:

    # mc "¿Tú? ¡No! Quiero hacerte unas preguntas sobre el tema de tu padre."
    mc "Você? Não! Quero lhe fazer algumas perguntas sobre seu pai."

# game/scripts/c13/c13.rpy:1334
translate brazilian c13s004_GetSaira_b56d3f60:

    # sca "Bueno, después de lo que me ha dicho mi madre esta mañana, dudo que nunca le saque la verdad sobre quién es."
    sca "Bem, depois do que minha mãe me disse esta manhã, duvido que algum dia eu consiga arrancar dela a verdade sobre quem ela é."

# game/scripts/c13/c13.rpy:1335
translate brazilian c13s004_GetSaira_8dd63e25:

    # sca "¿Puedes creerte que ha estado en contacto con él todo este tiempo? ¿Recibiendo dinero de él? ¿Y ocultándomelo?"
    sca "Você acredita que ela esteve em contato com ele esse tempo todo? Recebendo dinheiro dele? E escondendo isso de mim?"

# game/scripts/c13/c13.rpy:1336
translate brazilian c13s004_GetSaira_bd5ea149:

    # mc "Tu madre me ha parecido un poco... no quiero ser ofensivo ni molestarte, al fin y al cabo es tu madre."
    mc "Sua mãe parecia um pouco... Não quero ser ofensivo ou chateá-lo, afinal, ela é sua mãe."

# game/scripts/c13/c13.rpy:1338
translate brazilian c13s004_GetSaira_a383464e:

    # sca "Puedes decir lo que quieras. No me voy a ofender aunque la llames despreciable. Ahora mismo es la palabra que me viene a la mente. Estoy muy enfadada con ella."
    sca "Você pode dizer o que quiser. Não me ofenderei mesmo que a chame de desprezível. Essa é a palavra que me vem à mente agora. Estou muito zangada com ela."

# game/scripts/c13/c13.rpy:1339
translate brazilian c13s004_GetSaira_5e488d70:

    # mc "Me ha parecido muy fuerte que dijera que le habías destrozado la vida, y que lo siguiente de lo que hablara fuera del dinero de tu padre..."
    mc "Achei muito perturbador que ela tenha dito que você arruinou a vida dela, e logo em seguida ela tenha falado sobre o dinheiro do seu pai..."

# game/scripts/c13/c13.rpy:1341
translate brazilian c13s004_GetSaira_725ec96e:

    # sca "Aunque no tiene disculpa, casi la entiendo. Para ella el dinero es muy importante. Mis abuelos no quisieron ayudarla cuando se quedó embarazada de mí."
    sca "Embora ela não tenha desculpa, quase a compreendo. O dinheiro é muito importante para ela. Meus avós se recusaram a ajudá-la quando ela engravidou de mim."

# game/scripts/c13/c13.rpy:1342
translate brazilian c13s004_GetSaira_edc402e2:

    # sca "Pasó de estar a punto de ir a Yale con una beca a tener que irse de casa y buscarse la vida trabajando de camarera en un bar cutre, viviendo de las propinas..."
    sca "Ela passou de estar prestes a entrar em Yale com uma bolsa de estudos a ter que sair de casa e ganhar a vida trabalhando como garçonete em um bar decadente, vivendo de gorjetas..."

# game/scripts/c13/c13.rpy:1343
translate brazilian c13s004_GetSaira_9836f015:

    # sca "Mis abuelos cambiaron de opinión cuando nací, pero ella no quiso volver. La relación ya estaba muy dañada entre ellos. Solo veía a mis abuelos en los cumpleaños, Acción de Gracias, Navidad..."
    sca "Meus avós mudaram de ideia quando eu nasci, mas ela não quis voltar. O relacionamento deles já estava muito abalado. Eu só via meus avós nos aniversários, no Dia de Ação de Graças, no Natal..."

# game/scripts/c13/c13.rpy:1344
translate brazilian c13s004_GetSaira_829877c6:

    # mc "Pero parece que no vivía solo de las propinas, sino también del dinero que tu padre le enviaba."
    mc "Mas parece que ele não vivia apenas de gorjetas, mas também do dinheiro que seu pai lhe enviava."

# game/scripts/c13/c13.rpy:1346
translate brazilian c13s004_GetSaira_e0feaea1:

    # sca "Sí, eso parece. Una mentira más que sumar a la larga lista de mentiras que ha contado sobre él. Si al menos supiera quién es..."
    sca "Sim, parece que sim. Mais uma mentira para somar à longa lista de mentiras que ela contou sobre ele. Se eu ao menos soubesse quem ele realmente é..."

# game/scripts/c13/c13.rpy:1347
translate brazilian c13s004_GetSaira_b524c179:

    # mc "Me parece que ha dicho alguna mentira más sobre el tema, como que ha dejado de mandar dinero por que ya tenías 18."
    mc "Acho que ele contou outras mentiras sobre o assunto, como dizer que parou de mandar dinheiro porque você já tinha 18 anos."

# game/scripts/c13/c13.rpy:1349
translate brazilian c13s004_GetSaira_6be23cd0:

    # sca "¿Por qué dices eso?"
    sca "Por que você diz isso?"

# game/scripts/c13/c13.rpy:1350
translate brazilian c13s004_GetSaira_8ab0fcb9:

    # mc "Si te dijera que es posible que tenga una pista, que podrías encontrar a tu otra familia... ¿querrías seguirla?"
    mc "Se eu lhe dissesse que talvez tivesse uma pista, que você poderia encontrar sua outra família... você gostaria de segui-la?"

# game/scripts/c13/c13.rpy:1352
translate brazilian c13s004_GetSaira_8060518a:

    # sca "{b}¿Qué?{/b} ¡Por supuesto que querría!"
    sca "{b}O quê?{/b} Claro que sim!"

# game/scripts/c13/c13.rpy:1353
translate brazilian c13s004_GetSaira_07bd5463:

    # sca "¿De dónde has sacado la información?"
    sca "Onde você obteve essa informação?"

# game/scripts/c13/c13.rpy:1354
translate brazilian c13s004_GetSaira_b5ca3c26:

    # mc "Antes de responderte, déjame darte algunos datos. No es tan sencillo."
    mc "Antes de responder, deixe-me dar algumas informações. Não é tão simples assim."

# game/scripts/c13/c13.rpy:1356
translate brazilian c13s004_GetSaira_51d8a628:

    # sca "¿Que puede haber de complicado? Una prueba de ADN resolvería las dudas..."
    sca "O que poderia ser tão complicado? Um teste de DNA esclareceria todas as dúvidas..."

# game/scripts/c13/c13.rpy:1357
translate brazilian c13s004_GetSaira_bbde9e61:

    # mc "Lo complicado es que tu posible padre no está disponible para hacer una prueba de ADN. Pero déjame explicarte lo que sé."
    mc "O problema é que seu possível pai não está disponível para um teste de DNA. Mas deixe-me explicar o que eu sei."

# game/scripts/c13/c13.rpy:1359
translate brazilian c13s004_GetSaira_d376aa84:

    # "Explicas a Scarlett la conversación de ayer con tu padre, sin decirle que es tu padre, y las pistas que dejó caer sobre la identidad de tu medio hermana."
    "Você explica para Scarlett a conversa de ontem com seu pai, sem revelar que ele é seu pai, e as pistas que ele deu sobre a identidade de sua meia-irmã."

# game/scripts/c13/c13.rpy:1360
translate brazilian c13s004_GetSaira_e1e23ff8:

    # mc "Y eso es todo lo que sé."
    mc "E isso é tudo que eu sei."

# game/scripts/c13/c13.rpy:1361
translate brazilian c13s004_GetSaira_1b7cc215:

    # sca "Tengo que ser yo. 18 años, segunda de mi clase, empiezo medicina en la NWU, la matrícula está pagada, y ha enviado dinero a mi madre."
    sca "Tem que ser eu. 18 anos, segundo lugar na minha turma, começando medicina na NWU, a mensalidade está paga e já mandei dinheiro para minha mãe."

# game/scripts/c13/c13.rpy:1362
translate brazilian c13s004_GetSaira_7c813b7c:

    # mc "Ese último dato es el que me ha hecho atar cabos. Estaba bastante seguro de que podías ser tú, pero al decir tu madre lo del dinero casi ha confirmado mis sospechas."
    mc "Essa última informação foi o que me fez juntar as peças. Eu já tinha quase certeza de que poderia ser você, mas quando sua mãe mencionou o dinheiro, isso praticamente confirmou minhas suspeitas."

# game/scripts/c13/c13.rpy:1364
translate brazilian c13s004_GetSaira_99b10dd5:

    # sca "Pero hay una cosa que no entiendo. ¿Por qué ese hombre, mi posible padre, te lo contó a ti?"
    sca "Mas há uma coisa que eu não entendo. Por que aquele homem, meu possível pai, te contou isso?"

# game/scripts/c13/c13.rpy:1366
translate brazilian c13s004_GetSaira_081cc96b:

    # sca "A menos que..."
    sca "A menos que..."

# game/scripts/c13/c13.rpy:1369
translate brazilian c13s004_GetSaira_5a3e2bb4:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano... no ahora..."
    sca "Isso não pode ser, pode? Você não é meu meio-irmão... não agora..."

# game/scripts/c13/c13.rpy:1371
translate brazilian c13s004_GetSaira_fa962ca9:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano..."
    sca "Isso não pode ser, né? Você não é meu meio-irmão..."

# game/scripts/c13/c13.rpy:1372
translate brazilian c13s004_GetSaira_7caf724b:

    # mc "Podría ser. Engañó a mi madre y las fechas coinciden, pero deberíamos confirmarlo antes de..."
    mc "Pode ser. Ele enganou minha mãe e as datas coincidem, mas devemos confirmar antes..."

