# game/scripts/c21/c21.rpy:1521
translate brazilian c21s002_AaronCall_bce8a29d:

    # aar "Tus tíos le sacaron células madre a [mar] durante su embarazo, con la excusa de hacer pruebas sobre enfermedades genéticas."
    aar "Seus tios extraíram células-tronco de [mar] durante a gravidez dela, sob o pretexto de realizar testes para doenças genéticas."

# game/scripts/c21/c21.rpy:1523
translate brazilian c21s002_AaronCall_1e40d8c8:

    # aar "Ana se extrajo células madre durante su embarazo. Fuiste el primer sujeto al que lograron clonar."
    aar "Ana teve células-tronco extraídas durante a gravidez. Você foi a primeira pessoa que eles conseguiram clonar."

# game/scripts/c21/c21.rpy:1525
translate brazilian c21s002_AaronCall_f3053091:

    # aar "No pareces sorprendido."
    aar "Você não parece surpreso."

