    # "De camino a casa intentas sonsacarle el porqué de la timidez de los besos en casa. No obtienes respuestas."
    "No caminho para casa, você tenta fazê-la explicar por que ela tem vergonha de beijar em casa. Você não obtém respostas."

# game/scripts/c21/c21.rpy:3288
translate brazilian c21s005_DebLake_61dbc307:

    # "Llegáis con tiempo suficiente para ducharos antes de cenar."
    "Você chega com tempo suficiente para tomar banho antes do jantar."

# game/scripts/c21/c21.rpy:3292
translate brazilian c21s006_Nor_85a5dca5:

    # "La cena pasa sin ningún evento reseñable, muchas risas, muchas anécdotas sobre la fiesta del día anterior que te perdiste por no estar en el sitio adecuado."
    "O jantar transcorre sem nenhum acontecimento memorável, muitas risadas e várias anedotas sobre a festa do dia anterior que você perdeu por não estar no lugar certo."

# game/scripts/c21/c21.rpy:3293
translate brazilian c21s006_Nor_72be6aaf:

    # "Era imposible estar en todos sitios, y las chicas tienen muchas cosas que contarse unas a otras."
    "Era impossível estar em todos os lugares ao mesmo tempo, e as meninas tinham muito o que contar umas às outras."

# game/scripts/c21/c21.rpy:3294
translate brazilian c21s006_Nor_88570f07:

    # "Todas guardan silencio sobre lo que pasó en el jacuzzi."
    "Todos permanecem em silêncio sobre o que aconteceu na jacuzzi."

# game/scripts/c21/c21.rpy:3295
translate brazilian c21s006_Nor_da5560f9:

    # "[eva] y [ama] no vienen a cenar. [ama] llama para decir que no se encuentran bien. Nada de lo que preocuparse, pero prefieren quedarse en la base."
    "[eva] e [ama] não virão jantar. [ama] ligou para dizer que não está se sentindo bem. Nada com que se preocupar, mas prefere ficar na base."

# game/scripts/c21/c21.rpy:3302
translate brazilian c21s006_Teaser_a7a419ea:

    # "Al final de la noche, cuando estás ayudando a [nor] a recoger los platos..."
    "No final da noite, quando você está ajudando a recolher a louça..."

# game/scripts/c21/c21.rpy:3303
translate brazilian c21s006_Teaser_3642816b:

    # nor "¿Te apetece subir a mi habitación cuando acabemos? Parece que hace siglos que no estamos a solas."
    nor "Você gostaria de subir ao meu quarto quando terminarmos? Parece que faz uma eternidade que não ficamos sozinhos."

# game/scripts/c21/c21.rpy:3304
translate brazilian c21s006_Teaser_df96d4a7:

    # mc "Me apetece siempre. Tú también podrías venir a mi habitación."
    mc "Estou sempre disposta. Você também pode vir ao meu quarto."

# game/scripts/c21/c21.rpy:3306
translate brazilian c21s006_Teaser_101752c9:

    # nor "Podría, pero hay menos posibilidades de que alguien nos interrumpa en la mía."
    nor "Eu poderia, mas na minha situação há menos chances de alguém nos interromper."

# game/scripts/c21/c21.rpy:3307
translate brazilian c21s006_Teaser_85785e06:

    # mc "*Risa* Tienes razón. Mi habitación parece un aeropuerto últimamente, con tantas entradas y salidas."
    mc "*Risos* Você tem razão. Meu quarto parece um aeroporto ultimamente, com tanta gente entrando e saindo."

# game/scripts/c21/c21.rpy:3309
translate brazilian c21s006_Teaser_80d73381:

    # nor "*Susurrando* ¿Acabas tú de recoger mientras yo subo y me voy poniendo guapa para ti?"
    nor "*Sussurrando* Você acabou de arrumar tudo enquanto eu subo para me preparar para você?"

# game/scripts/c21/c21.rpy:3310
translate brazilian c21s006_Teaser_c17bfb64:

    # mc "Ya estás guapa para mí, mi amor. Pero ve subiendo si quieres. En cinco minutos estoy allí."
    mc "Você está linda agora, meu amor. Mas fique à vontade para subir, se quiser. Chego aí em cinco minutos."

# game/scripts/c21/c21.rpy:3311
translate brazilian c21s006_Teaser_3a494236:

    # nor "Que sean diez."
    nor "Que sejam dez."

# game/scripts/c21/c21.rpy:3313
translate brazilian c21s006_Teaser_20acc60e:

    # "Diez minutos después..."
    "Dez minutos depois..."

# game/scripts/c21/c21.rpy:3314
translate brazilian c21s006_Teaser_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c21/c21.rpy:3315
translate brazilian c21s006_Teaser_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "Sou eu. Posso entrar?"

# game/scripts/c21/c21.rpy:3316
translate brazilian c21s006_Teaser_846dc0f1:

    # nor "*A través de la puerta* Pasa, mi amor."
    nor "*Pela porta* Entre, meu amor."

# game/scripts/c21/c21.rpy:3322
translate brazilian c21s006_Teaser_80385b21:

    # nor "Espero que te guste esto. Lo he comprado hoy en la tienda de [mad.nick]."
    nor "Espero que gostem. Comprei hoje na loja [mad.nick]."

