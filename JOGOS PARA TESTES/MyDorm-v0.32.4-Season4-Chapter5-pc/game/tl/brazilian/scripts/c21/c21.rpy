    # bet "*Risa* ¿Eso es lo que querrías? ¡Creía que eras un buen chico!"
    bet "*Risos* Era isso que você queria? Eu pensei que você fosse um bom garoto!"

# game/scripts/c21/c21.rpy:1399
translate brazilian c21s002_BettyMassageAndDrivingLicense_c3c47659:

    # mc "En serio, si te incomoda no hay ningún problema por dejar de hacerlo."
    mc "Sinceramente, se isso te incomoda, não há problema nenhum em parar."

# game/scripts/c21/c21.rpy:1401
translate brazilian c21s002_BettyMassageAndDrivingLicense_c87bee9f:

    # bet "¿Recuerdas por qué lo propuse?"
    bet "Você se lembra por que eu sugeri isso?"

# game/scripts/c21/c21.rpy:1402
translate brazilian c21s002_BettyMassageAndDrivingLicense_c5fbcc46:

    # mc "Para fastidiar a Meemaw."
    mc "Para irritar a vovó."

# game/scripts/c21/c21.rpy:1403
translate brazilian c21s002_BettyMassageAndDrivingLicense_7afaff1c:

    # bet "Ahora que parece que ya no le importa, no hay razón para seguir haciéndolo."
    bet "Agora que parece que ele não se importa mais, não há motivo para continuar fazendo isso."

# game/scripts/c21/c21.rpy:1405
translate brazilian c21s002_BettyMassageAndDrivingLicense_a8a6c874:

    # bet "No está bien que una monja haga eso. No creo que el Obispo lo aprobara, y menos aún en mi situación."
    bet "Não é correto uma freira fazer isso. Acho que o bispo não aprovaria, especialmente na minha situação."

# game/scripts/c21/c21.rpy:1406
translate brazilian c21s002_BettyMassageAndDrivingLicense_16ea5513:

    # mc "Te entiendo. No te preocupes. No hay ningún problema en dejar de hacerlo, pero si alguna de las chicas pregunta, serás tú quien se lo explique."
    mc "Entendo. Não se preocupe. Não há problema nenhum em parar, mas se alguma das garotas perguntar, você terá que explicar para elas."

# game/scripts/c21/c21.rpy:1408
translate brazilian c21s002_BettyMassageAndDrivingLicense_9cbb42fe:

    # bet "Me parece un trato justo. Te veo luego si no estás muy ocupado. Voy a darle ese masaje a Olivia antes de que se impaciente."
    bet "Parece um bom negócio. Te vejo mais tarde, se você não estiver muito ocupado. Vou fazer aquela massagem na Olivia antes que ela fique impaciente."

# game/scripts/c21/c21.rpy:1409
translate brazilian c21s002_BettyMassageAndDrivingLicense_05812d8f:

    # mc "Espera, Tía [bet]."
    mc "Espere, tia [bet]."

# game/scripts/c21/c21.rpy:1411
translate brazilian c21s002_BettyMassageAndDrivingLicense_f947d43b:

    # mc "Estoy dispuesto a dejar los besos de lado, pero no los abrazos."
    mc "Estou disposta a abrir mão de beijos, mas não de abraços."

# game/scripts/c21/c21.rpy:1413
translate brazilian c21s002_BettyMassageAndDrivingLicense_1577c66c:

    # bet "Nunca voy a permitirte que dejes de dármelos."
    bet "Eu nunca permitirei que você pare de me dar isso."

# game/scripts/c21/c21.rpy:1414
translate brazilian c21s002_BettyMassageAndDrivingLicense_1738c3ad:

    # mc "Ahora ya puedes ir a masajear esas tetas."
    mc "Agora você pode ir massagear esses peitos."

# game/scripts/c21/c21.rpy:1416
translate brazilian c21s002_BettyMassageAndDrivingLicense_31fc745e:

    # bet "Olivia puede esperar un par de minutos más... se está muy bien aquí."
    bet "Olivia pode esperar mais alguns minutos... é muito agradável aqui."

# game/scripts/c21/c21.rpy:1417
translate brazilian c21s002_BettyMassageAndDrivingLicense_dd201e21:

    # mc "Tantos minutos como necesites."
    mc "Quantos minutos você precisar."

# game/scripts/c21/c21.rpy:1420
translate brazilian c21s002_BettyMassageAndDrivingLicense_6f8bfe7a:

    # "Casi diez minutos después, [bet] abandona tu habitación."
    "Quase dez minutos depois, [bet] saia do seu quarto."

# game/scripts/c21/c21.rpy:1426
translate brazilian c21s002_AaronCall_4141d7ac:

    # "Bajas a desayunar, y al volver a tu habitación..."
    "Você desce para tomar o café da manhã e, quando retorna ao seu quarto..."

# game/scripts/c21/c21.rpy:1428
translate brazilian c21s002_AaronCall_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1429
translate brazilian c21s002_AaronCall_9987422b:

    # mcp "(Videoconferencia de un número desconocido, pero el prefijo es de Aruba.)"
    mcp "(Videoconferência de um número desconhecido, mas o código de área é de Aruba.)"

# game/scripts/c21/c21.rpy:1433
translate brazilian c21s002_AaronCall_1c7111b2:

    # mc "Buenos días, [aar]"
    mc "Bom dia, [aar]"

# game/scripts/c21/c21.rpy:1434
translate brazilian c21s002_AaronCall_c1e7a21d:

    # aar "Hola, [mc]. Te debía una llamada desde hace unos días. ¿Puedes hablar? ¿Estás solo?"
    aar "Olá, [mc]. Eu te devia uma ligação há alguns dias. Podemos conversar? Você está sozinho?"

# game/scripts/c21/c21.rpy:1435
translate brazilian c21s002_AaronCall_37be49c1:

    # mc "Sí, llevo varios días esperándola."
    mc "Sim, estou esperando por isso há vários dias."

# game/scripts/c21/c21.rpy:1437
translate brazilian c21s002_AaronCall_20b8d4d3:

    # aar "¿Cómo se están portando mis dos chicas? Anoche hablé con ellas y estaban entusiasmadas con... unas muñecas..."
    aar "Como estão se comportando minhas duas filhas? Conversei com elas ontem à noite e elas estavam animadas com... algumas bonecas..."

# game/scripts/c21/c21.rpy:1438
translate brazilian c21s002_AaronCall_e11ef6ad:

    # aar "No quisieron decirme a qué se referían. ¿Le han puesto un mote a alguna de tus chicas?"
    aar "Eles não me disseram o que queriam dizer. Deram algum apelido para alguma das suas filhas?"

# game/scripts/c21/c21.rpy:1439
translate brazilian c21s002_AaronCall_87f7cf83:

    # mc "No, [aar], pero si no quisieron decirte de que iba el tema, no voy a ser yo quien lo haga."
    mc "Não, [aar], mas se eles não quiseram te contar do que se tratava, eu não serei o único a fazê-lo."

# game/scripts/c21/c21.rpy:1441
translate brazilian c21s002_AaronCall_c819bfc5:

    # aar "Me parece bien. Pero, ¿cómo se están portando? No me has contestado."
    aar "Parece-me ótimo. Mas como eles estão se comportando? Você ainda não me respondeu."

# game/scripts/c21/c21.rpy:1442
translate brazilian c21s002_AaronCall_d8ceffa6:

    # mc "Muy bien. Se están integrando genial en la familia y todo el mundo las adora."
    mc "Muito bem. Eles estão se adaptando maravilhosamente à família e todos os adoram."

# game/scripts/c21/c21.rpy:1444
translate brazilian c21s002_AaronCall_0cf727f2:

    # aar "Por todo el mundo... te refieres a ti, a [mar] y a [nor], ¿verdad?"
    aar "Em todo o mundo... você quer dizer você, [mar] e [nor], certo?"

# game/scripts/c21/c21.rpy:1445
translate brazilian c21s002_AaronCall_62e249b3:

    # mc "No, [aar], a toda la familia. ¿Qué crees que querían decir [mar] y [nor] cuando las invitaron a comer y a cenar a casa?"
    mc "Não, [aar], toda a família. O que você acha que [mar] e [nor] queriam dizer quando os convidaram para almoçar e jantar em casa?"

# game/scripts/c21/c21.rpy:1447
translate brazilian c21s002_AaronCall_778fce69:

    # aar "Realmente no lo había pensado. Creía que iba a ser... no sé... para conocerse mejor. Algo privado de ellas cuatro."
    aar "Eu realmente não tinha pensado nisso. Achei que seria... sei lá... para se conhecerem melhor. Algo privado entre os quatro."

# game/scripts/c21/c21.rpy:1448
translate brazilian c21s002_AaronCall_81e38309:

    # mc "[aar], creo que no entiendes a mi familia. Intentamos no guardar secretos, y en este estaban implicadas [eri], [dap], y [emm]."
    mc "[aar], acho que você não entende minha família. Tentamos não guardar segredos, e [eri], [dap] e [emm] estavam envolvidos neste."

# game/scripts/c21/c21.rpy:1450
translate brazilian c21s002_AaronCall_a3a825e3:

    # aar "Bueno, si es así, supongo que no hay ningún problema porque lo sepan. Ellas también son accionistas de La Compañía."
    aar "Bem, se for esse o caso, suponho que não haja problema algum em eles saberem. Eles também são acionistas da empresa."

# game/scripts/c21/c21.rpy:1451
translate brazilian c21s002_AaronCall_ee28dc16:

    # mc "Sigues sin entenderlo. Lo sabe toda la familia. Ayer estuvieron en la fiesta de cumpleaños de las chicas. 25 personas."
    mc "Você ainda não entendeu. Toda a família sabe. Eles estavam na festa de aniversário das meninas ontem. 25 pessoas."

# game/scripts/c21/c21.rpy:1453
translate brazilian c21s002_AaronCall_681e2a3c:

    # aar "¿Qué? No me parece bien, [mc]. No están preparadas para eso y, si el secreto sale a la luz, pueden tener problemas."
    aar "O quê? Acho que não está certo. Eles não estão preparados para isso, e se o segredo for revelado, podem se meter em problemas."

# game/scripts/c21/c21.rpy:1454
translate brazilian c21s002_AaronCall_2c6f98cc:

    # aar "Tus chicas y las mías."
    aar "Suas filhas e as minhas."

# game/scripts/c21/c21.rpy:1455
translate brazilian c21s002_AaronCall_e9d1a1ef:

    # mc "Sigues sin entenderlo. Tus chicas son mis chicas también. Nuestras chicas. De la familia."
    mc "Você ainda não entendeu. Suas filhas também são minhas filhas. Nossas filhas. Família."

# game/scripts/c21/c21.rpy:1456
translate brazilian c21s002_AaronCall_ea0668be:

    # mc "Nadie va a hacer nada para perjudicarlas. Apostaría mi vida en ello."
    mc "Ninguém vai fazer nada para prejudicá-los. Apostaria minha vida nisso."

# game/scripts/c21/c21.rpy:1458
translate brazilian c21s002_AaronCall_95c9301c:

    # aar "Pero no están preparadas para ese tipo de interacciones sociales... no tienen entrenamiento para eso."
    aar "Mas eles não estão preparados para esse tipo de interação social... eles não têm treinamento para isso."

# game/scripts/c21/c21.rpy:1459
translate brazilian c21s002_AaronCall_b3d3453b:

    # mc "Pues, al no tener entrenamiento, usaron su instinto. Y se les dio bien. No debes sobreprotegerlas."
    mc "Bem, como não tinham treinamento, usaram seus instintos. E se saíram bem. Você não deve superprotegê-los."

# game/scripts/c21/c21.rpy:1460
translate brazilian c21s002_AaronCall_60636dc3:

    # mcp "(De eso ya me ocuparé yo.)"
    mcp "(Eu cuidarei disso.)"

# game/scripts/c21/c21.rpy:1462
translate brazilian c21s002_AaronCall_1967bdf8:

    # aar "No me queda más remedio que confiar en ti, ¿no?"
    aar "Não tenho outra escolha senão confiar em você, não é?"

# game/scripts/c21/c21.rpy:1463
translate brazilian c21s002_AaronCall_3e5bfe1e:

    # mc "Esto es un camino en dos direcciones. Yo he confiado en ti, ahora te toca confiar en mí. Y en ellas. En todos nosotros."
    mc "É uma via de mão dupla. Eu confiei em você, agora é a sua vez de confiar em mim. E neles. Em todos nós."

# game/scripts/c21/c21.rpy:1464
translate brazilian c21s002_AaronCall_593d6733:

    # mc "Pero supongo que no me llamabas solo por eso, ¿no?"
    mc "Mas suponho que você não estava me ligando apenas por esse motivo, estava?"

# game/scripts/c21/c21.rpy:1466
translate brazilian c21s002_AaronCall_0ba84e38:

    # aar "No. Te llamaba porque ha habido una filtración durante el proceso de toma de poder."
    aar "Não. Liguei porque houve um vazamento de informações durante o processo de tomada de poder."

# game/scripts/c21/c21.rpy:1467
translate brazilian c21s002_AaronCall_29714f61:

    # mc "¿Qué ha pasado?"
    mc "O que aconteceu?"

# game/scripts/c21/c21.rpy:1468
translate brazilian c21s002_AaronCall_32fa659b:

    # aar "Una de las competidoras de NTR en el mundo de las... operaciones de seguridad... ha recibido información sobre el cambio de propietarios."
    aar "Um dos concorrentes da NTR no mundo das operações de segurança recebeu informações sobre a mudança de propriedade."

# game/scripts/c21/c21.rpy:1469
translate brazilian c21s002_AaronCall_1e8a5b88:

    # mc "Eso es malo, ¿no? ¿Estamos en peligro otra vez? ¿También tienen clones?"
    mc "Isso é ruim, não é? Estamos em perigo de novo? Eles também têm clones?"

# game/scripts/c21/c21.rpy:1471
translate brazilian c21s002_AaronCall_fab57a01:

    # aar "No, no es especialmente malo. No van a tomar ninguna acción violenta o ilegal. Y no, no tienen clones, actúan con personal exmilitar."
    aar "Não, não é particularmente ruim. Eles não vão tomar nenhuma medida violenta ou ilegal. E não, eles não têm clones; operam com ex-militares."

# game/scripts/c21/c21.rpy:1472
translate brazilian c21s002_AaronCall_6ba3a832:

    # aar "Quieren comprar NTR aprovechando lo que consideran una posición de debilidad. ¿Habéis hablado ya sobre si vais a vender vuestras acciones?"
    aar "Eles querem comprar NTR, aproveitando-se do que consideram uma posição fraca. Você já discutiu a possibilidade de vender suas ações?"

# game/scripts/c21/c21.rpy:1473
translate brazilian c21s002_AaronCall_116344af:

    # mc "Yo no voy a venderlas y [dap] tampoco. Supongo que tú, [ama] y [eva] tampoco."
    mc "Eu não vou vendê-las, e nem [dap]. Suponho que você, [ama], e [eva] também não."

# game/scripts/c21/c21.rpy:1475
translate brazilian c21s002_AaronCall_2223e756:

    # aar "No, no vamos a vender, con lo que podrían hacerse con un 50%% de la compañía como máximo. No es malo del todo, pero tampoco bueno."
    aar "Não, não vamos vender, então eles poderiam ficar com no máximo 50%% da empresa. Não é de todo ruim, mas também não é ótimo."

# game/scripts/c21/c21.rpy:1476
translate brazilian c21s002_AaronCall_ea8b9317:

    # mc "No creo que [mar], [nor], [emm], o [eri] vayan a querer vender tampoco."
    mc "Não acho que [mar], [nor], [emm] ou [eri] queiram vender também."

# game/scripts/c21/c21.rpy:1477
translate brazilian c21s002_AaronCall_19f7739d:

    # aar "Eso es mejor todavía, pero deberíais concretarlo. Hoy."
    aar "Isso é ainda melhor, mas você deve finalizar. Hoje."

# game/scripts/c21/c21.rpy:1478
translate brazilian c21s002_AaronCall_22910fb8:

    # mc "¿Hoy? ¿Por qué tanta prisa?"
    mc "Hoje? Por que tanta pressa?"

# game/scripts/c21/c21.rpy:1480
translate brazilian c21s002_AaronCall_b6f53ead:

    # aar "Uno de sus directivos está en San Diego reunido con vuestra Armada. No me extrañaría que se pusiera en contacto contigo para tener una reunión."
    aar "Um dos diretores deles está em San Diego reunindo-se com a sua Marinha. Não me surpreenderia se ele entrasse em contato com você para agendar uma reunião."

# game/scripts/c21/c21.rpy:1481
translate brazilian c21s002_AaronCall_5c70738c:

    # mc "¿Conmigo? ¿Por qué? ¿Por qué no con [mar] o [nor]?"
    mc "Comigo? Por quê? Por que não com [mar] ou [nor]?"

# game/scripts/c21/c21.rpy:1482
translate brazilian c21s002_AaronCall_f6925132:

    # aar "La información filtrada llevaba tu nombre como futuro CEO de la compañía representando al grupo mayoritario de accionistas."
    aar "As informações vazadas incluíam seu nome como futuro CEO da empresa, representando o grupo de acionistas majoritários."

# game/scripts/c21/c21.rpy:1483
translate brazilian c21s002_AaronCall_f795a7f0:

    # mc "Vale, pues si se ponen en contacto, con decirle que no estamos interesados en vender hay suficiente, ¿no?"
    mc "Certo, então se eles entrarem em contato, basta dizer que não estamos interessados em vender, certo?"

# game/scripts/c21/c21.rpy:1485
translate brazilian c21s002_AaronCall_f3896c95:

    # aar "Debería haber suficiente, pero tienes que hablarlo antes con tu familia. No puedes tomar una decisión por ellos."
    aar "Deve haver o suficiente, mas você precisa conversar com sua família primeiro. Você não pode tomar essa decisão por eles."

# game/scripts/c21/c21.rpy:1486
translate brazilian c21s002_AaronCall_89f7514c:

    # aar "Incluso sería bueno que te reunieras con él, llevando a [ama] como guardaespaldas. Para saber qué intenciones tienen."
    aar "Seria até uma boa ideia você se encontrar com ele, levando [ama] como seu guarda-costas. Para descobrir quais são as intenções dele."

# game/scripts/c21/c21.rpy:1487
translate brazilian c21s002_AaronCall_023dbd88:

    # mc "Si no vamos a vender, ¿qué más da las intenciones que tengan?"
    mc "Se não vamos vender, que diferença faz quais são as intenções deles?"

# game/scripts/c21/c21.rpy:1489
translate brazilian c21s002_AaronCall_4d83f4ea:

    # aar "[mc], la información es poder en este mundo. No creo que seas capaz de sacarle nada, pero [ama] sí que puede conseguir algo de información."
    aar "[mc], informação é poder neste mundo. Não acho que você conseguirá extrair nada dele, mas [ama] ele pode obter alguma informação."

# game/scripts/c21/c21.rpy:1490
translate brazilian c21s002_AaronCall_e00384c4:

    # mc "No me hace ninguna gracia ir a una reunión con un tipo que seguramente sea peligroso sin tener ni idea de nada."
    mc "Não estou nada a fim de ir a uma reunião com um cara que provavelmente é perigoso sem ter a mínima ideia do que está falando."

# game/scripts/c21/c21.rpy:1492
translate brazilian c21s002_AaronCall_56cd97e0:

    # aar "¿Crees que ese directivo va a ser más peligroso que [ama]? *Risa*"
    aar "Você acha que esse executivo vai ser mais perigoso que [ama]? *Risos*"

# game/scripts/c21/c21.rpy:1493
translate brazilian c21s002_AaronCall_261ccb82:

    # mc "*Risa* En eso tienes razón. No voy a estar más protegido con nadie mejor que con ella."
    mc "*Risos* Você tem razão. Não me sentirei mais seguro com mais ninguém do que com ela."

# game/scripts/c21/c21.rpy:1495
translate brazilian c21s002_AaronCall_1d102f4f:

    # aar "*Risa* Que no te oiga [eva] decir eso."
    aar "*Risos* Não quero ouvir você dizer isso."

# game/scripts/c21/c21.rpy:1496
translate brazilian c21s002_AaronCall_b9e32a8d:

    # aar "Te la has terminado de ganar con el regalo de las muñecas. Un buen detalle. No la pierdas ahora."
    aar "Você realmente a conquistou com o presente da boneca. Foi um gesto muito gentil. Não a perca agora."

# game/scripts/c21/c21.rpy:1497
translate brazilian c21s002_AaronCall_69ecb324:

    # mc "Espera. Habías dicho que no sabías de qué hablaban con lo de las muñecas."
    mc "Espere. Você disse que não sabia do que eles estavam falando sobre as bonecas."

# game/scripts/c21/c21.rpy:1499
translate brazilian c21s002_AaronCall_3a98564c:

    # aar "Quería comprobar lo leal que eras hacia ellas. Lo de las muñecas era algo simple sobre lo que quizás quisieras fanfarronear."
    aar "Eu queria testar o quão leal você era a eles. A coisa da boneca era só uma coisinha simples da qual você talvez quisesse se gabar."

# game/scripts/c21/c21.rpy:1500
translate brazilian c21s002_AaronCall_acb236f1:

    # aar "Pero siendo algo que puede que para ti no sea importante has guardado lo que creías que era su secreto. Bien hecho."
    aar "Mas, mesmo que não lhe pareça importante, você guardou o que pensava ser o segredo deles. Muito bem."

# game/scripts/c21/c21.rpy:1501
translate brazilian c21s002_AaronCall_6f76af63:

    # mc "No me gustan estos juegos, [aar]."
    mc "Eu não gosto desses jogos, [aar]."

# game/scripts/c21/c21.rpy:1503
translate brazilian c21s002_AaronCall_3da1a804:

    # aar "A mí tampoco, te lo aseguro. Pero no sé cuánto tiempo voy a poder seguir protegiéndolas. Necesito saber que tú y tu familia lo vais a hacer cuando yo no esté."
    aar "Nem eu, garanto. Mas não sei por quanto tempo mais conseguirei continuar protegendo-os. Preciso ter certeza de que você e sua família continuarão a fazê-lo quando eu partir."

# game/scripts/c21/c21.rpy:1504
translate brazilian c21s002_AaronCall_d31034f7:

    # mc "Lo haremos, no te preocupes. ¿No hay nada que pueda frenar el envejecimiento acelerado?"
    mc "Nós faremos isso, não se preocupe. Não existe nada que possa retardar o envelhecimento acelerado?"

# game/scripts/c21/c21.rpy:1506
translate brazilian c21s002_AaronCall_c3c0825a:

    # aar "No, no hay nada. No voy a durar diez años más. Quizás ni siquiera cinco."
    aar "Não, não tem nada. Não vou durar mais dez anos. Talvez nem cinco."

# game/scripts/c21/c21.rpy:1507
translate brazilian c21s002_AaronCall_84ab57b7:

    # mc "Lo siento. No tengo palabras..."
    mc "Sinto muito. Estou sem palavras..."

# game/scripts/c21/c21.rpy:1508
translate brazilian c21s002_AaronCall_fd33cf36:

    # aar "No te preocupes. Hace años que lo tengo asumido."
    aar "Não se preocupe. Eu aceitei isso há anos."

# game/scripts/c21/c21.rpy:1510
translate brazilian c21s002_AaronCall_d08c7506:

    # aar "Volviendo al tema que nos ocupaba. Si se ponen en contacto contigo desde Iron Fist, la otra compañía, intenta tener una reunión en persona e informa a [ama]."
    aar "Voltando ao assunto em questão. Se a Iron Fist, a outra empresa, entrar em contato com você, tente agendar uma reunião presencial e informe [ama]."

# game/scripts/c21/c21.rpy:1511
translate brazilian c21s002_AaronCall_10b09256:

    # mc "De acuerdo. ¿Alguna cosa más?"
    mc "Certo. Mais alguma coisa?"

# game/scripts/c21/c21.rpy:1513
translate brazilian c21s002_AaronCall_34537b06:

    # aar "No, eso es todo. ¿Tienes alguna pregunta?"
