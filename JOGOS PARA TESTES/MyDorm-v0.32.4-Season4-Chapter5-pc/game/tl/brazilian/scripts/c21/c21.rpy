# game/scripts/c21/c21.rpy:2498
translate brazilian c21s005_DebRun_44db888a:

    # deb "Y como [mar] se ocupa de que coma sano, acabará perdiendo mucho peso en los próximos meses."
    deb "E como [mar] garante que se alimenta de forma saudável, ele acabará perdendo muito peso nos próximos meses."

# game/scripts/c21/c21.rpy:2499
