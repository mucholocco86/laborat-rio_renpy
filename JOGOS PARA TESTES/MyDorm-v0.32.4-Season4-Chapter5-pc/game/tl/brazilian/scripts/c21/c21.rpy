

# game/scripts/c21/c21.rpy:24
translate brazilian c21s001_FoursomeWhatIf_d6b32481:

    # "Hay una escena con [eri], [dap], y [emm], pero no estás en ruta con las tres simultáneamente."
    "Existe uma cena com [eri], [dap] e [emm], mas você não está na rota com os três simultaneamente."

# game/scripts/c21/c21.rpy:127
translate brazilian c21s001_Foursome_ffbf891b:

    # "Al volver a tu habitación..."
    "Ao retornar ao seu quarto..."

# game/scripts/c21/c21.rpy:129
translate brazilian c21s001_Foursome_d72364f0:

    # emm "¡Has tardado muchísimo en volver!"
    emm "Você demorou uma eternidade para voltar!"

# game/scripts/c21/c21.rpy:130
translate brazilian c21s001_Foursome_433f4a0f:

    # dap "Estábamos a punto de irnos. Menos mal que has llegado ahora."
    dap "Estávamos quase a ir embora. Ainda bem que você chegou agora."

# game/scripts/c21/c21.rpy:132
translate brazilian c21s001_Foursome_54f0ebc1:

    # eri "Creíamos que te ibas a quedar a dormir en casa de [mad.nick]."
    eri "Pensávamos que você ia passar a noite na casa de [mad.nick]."

# game/scripts/c21/c21.rpy:134
translate brazilian c21s001_Foursome_37fa3aff:

    # eri "O de llamarte para saber si te había pasado algo."
    eri "Ou para ligar para você e saber se algo lhe aconteceu."

# game/scripts/c21/c21.rpy:137
translate brazilian c21s001_Foursome_b90d68d2:

    # emm "Veníamos a por nuestros regalos de cumpleaños, pero has tardado tanto que se nos han pasado las ganas."
    emm "Viemos buscar nossos presentes de aniversário, mas vocês demoraram tanto que perdemos o interesse."

# game/scripts/c21/c21.rpy:139
translate brazilian c21s001_Foursome_b8113d19:

    # eri "Las tres nos habíamos comprado esta lencería tan bonita para darte una sorpresa..."
    eri "Nós três compramos essa linda lingerie para te fazer uma surpresa..."

# game/scripts/c21/c21.rpy:141
translate brazilian c21s001_Foursome_c5491be0:

    # dap "Pero después de una hora esperándote... mejor nos vamos..."
    dap "Mas depois de esperar por você durante uma hora... é melhor irmos..."

# game/scripts/c21/c21.rpy:142
translate brazilian c21s001_Foursome_d9f214b9:

    # mc "Chicas, tenía que llevar a [mad.nick]..."
    mc "Meninas, eu tive que tirar [mad.nick]..."

# game/scripts/c21/c21.rpy:144
translate brazilian c21s001_Foursome_309e5c9d:

    # mc "Y al volver me he encontrado con [kia] abajo..."
    mc "E quando voltei, encontrei [kia] lá embaixo..."

# game/scripts/c21/c21.rpy:147
translate brazilian c21s001_Foursome_d04b2885:

    # emm "Es decir, tus otras novias antes que nosotras, ¿no?"
    emm "Então, suas outras namoradas antes de nós, certo?"

# game/scripts/c21/c21.rpy:149
translate brazilian c21s001_Foursome_609962f8:

    # emm "Es decir, el resto de las chicas antes que nosotras, ¿no?"
    emm "Então, as outras garotas que vieram antes de nós, certo?"

# game/scripts/c21/c21.rpy:150
translate brazilian c21s001_Foursome_398bcaed:

    # eri "Esperábamos más de ti, [mc]."
    eri "Esperávamos mais de você, [mc]."

# game/scripts/c21/c21.rpy:151
translate brazilian c21s001_Foursome_e3a61a1a:

    # dap "Nos has decepcionado."
    dap "Você nos decepcionou."

# game/scripts/c21/c21.rpy:152
translate brazilian c21s001_Foursome_deff457d:

    # mc "¡Pero si ni siquiera sabía que estabais aquí!"
    mc "Mas eu nem sabia que você estava aqui!"

# game/scripts/c21/c21.rpy:155
translate brazilian c21s001_Foursome_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c21/c21.rpy:156
translate brazilian c21s001_Foursome_d1199fbd:

    # mcp "(¡Son casi las 2:00 AM! Cuidado con la puerta o vais a despertar a alguien.)"
    mcp "(São quase 2h da manhã! Cuidado com a porta ou você vai acordar alguém.)"

# game/scripts/c21/c21.rpy:157
translate brazilian c21s001_Foursome_c5efcdc6:

    # eri "*A través de la puerta* *Susurrando* ¡[emm]! ¡Vas a despertar a [sai] y a [meg]!"
    eri "*Pela porta* *Sussurrando* [emm]! Você vai acordar [sai] [meg]!"

# game/scripts/c21/c21.rpy:158
translate brazilian c21s001_Foursome_9bc4801a:

    # emm "*A través de la puerta* *Susurrando* Lo siento... me he metido demasiado en mi papel. *Risita*"
    emm "*Através da porta* *Sussurrando* Desculpe... Me empolguei um pouco demais com o papel. *Risos*"

# game/scripts/c21/c21.rpy:159
translate brazilian c21s001_Foursome_3dd07e34:

    # dap "*A través de la puerta* *Susurrando* Chicas, ¿creéis que se lo ha creído?"
    dap "*Através da porta* *Sussurrando* Meninas, vocês acham que ele acreditou nisso?"

# game/scripts/c21/c21.rpy:160
translate brazilian c21s001_Foursome_b9031dcc:

    # mcp "(En cinco minutos están de vuelta... como mucho cinco minutos. Voy a ir desnudándome.)"
    mcp "(Eles voltam em cinco minutos... cinco minutos no máximo. Vou começar a me despir.)"

# game/scripts/c21/c21.rpy:161
translate brazilian c21s001_Foursome_bdf9f113:

    # emm "*A través de la puerta* *Susurrando* ¡Por supuesto! En diez segundos abrirá la puerta para venir a buscarnos."
    emm "*Pela porta* *Sussurrando* Claro! Em dez segundos ele abrirá a porta para vir nos buscar."

# game/scripts/c21/c21.rpy:162
translate brazilian c21s001_Foursome_62228065:

    # eri "*A través de la puerta* *Susurrando* No estoy segura. Ya han pasado diez segundos. Creo que sabe que estábamos de broma."
    eri "*Através da porta* *Sussurrando* Não tenho certeza. Já se passaram dez segundos. Acho que ele percebeu que estávamos brincando."

# game/scripts/c21/c21.rpy:163
translate brazilian c21s001_Foursome_28ac3415:

    # dap "*A través de la puerta* *Susurrando* Eso nos pasa por hacer caso a los planes de [emm]. Ya os he dicho que era un plan de mierda. Debe estar muy cansado."
    dap "*Através da porta* *Sussurrando* É o que acontece quando damos ouvidos aos planos do [emm]. Eu já te disse que era um plano péssimo. Ele deve estar muito cansado."

# game/scripts/c21/c21.rpy:164
translate brazilian c21s001_Foursome_9502c5d8:

    # emm "*A través de la puerta* *Susurrando* ¡Hey! El plan era bueno... ¿Habéis visto la cara que ha puesto?"
    emm "*Através da porta* *Sussurrando* Ei! O plano era bom... Você viu a cara dele?"

# game/scripts/c21/c21.rpy:165
translate brazilian c21s001_Foursome_7d7341c2:

    # dap "*A través de la puerta* *Susurrando* Imaginaos que decide darnos tiempo para que se nos pase el \"enfado\". Sería muy típico de él."
    dap "*Através da porta* *Sussurrando* Imagine se ele decidisse nos dar um tempo para nos acalmarmos. Isso seria bem típico dele."

# game/scripts/c21/c21.rpy:166
translate brazilian c21s001_Foursome_60605bc9:

    # emm "*A través de la puerta* *Susurrando* ¿Volvemos?"
    emm "*Através da porta* *Sussurrando* Vamos voltar?"

# game/scripts/c21/c21.rpy:167
translate brazilian c21s001_Foursome_39f3b792:

    # eri "*A través de la puerta* *Susurrando* Vamos antes de que se duerma."
    eri "*Pela porta* *Sussurrando* Vamos antes que ela adormeça."

# game/scripts/c21/c21.rpy:169
translate brazilian c21s001_Foursome_cc59538f:

    # mc "Hola de nuevo, chicas. *Risa*"
    mc "Olá de novo, meninas. *Risos*"

# game/scripts/c21/c21.rpy:171
translate brazilian c21s001_Foursome_5095615f:

    # emm "¿Sabías que íbamos a volver?"
    emm "Você sabia que nós voltaríamos?"

# game/scripts/c21/c21.rpy:172
translate brazilian c21s001_Foursome_54eb101d:

    # mc "¡Por supuesto! Dudo que hayáis venido vestidas así todo el camino atravesando la planta de las estudiantes."
    mc "Claro! Duvido que você tenha percorrido todo o prédio estudantil vestida assim."

# game/scripts/c21/c21.rpy:173
translate brazilian c21s001_Foursome_1ba58714:

    # mc "Y dudo que fuerais a volver a vuestras habitaciones así."
    mc "E duvido que vocês fossem voltar para os seus quartos desse jeito."

# game/scripts/c21/c21.rpy:175
translate brazilian c21s001_Foursome_1ed30e3d:

    # eri "Es cierto, no habíamos contado con eso. Las batas están en el armario."
    eri "É verdade, não tínhamos previsto isso. Os roupões estão no armário."

# game/scripts/c21/c21.rpy:176
translate brazilian c21s001_Foursome_6f14276a:

    # mc "Además, creo que han escuchado vuestros susurros desde San Francisco. *Risa*"
    mc "Além disso, acho que eles ouviram seus sussurros lá de São Francisco. *Risos*"

# game/scripts/c21/c21.rpy:178
translate brazilian c21s001_Foursome_deef0111:

    # dap "¡No hablábamos tan alto! Y si nos escuchabas, ¿por qué no has salido a buscarnos?"
    dap "Não estávamos falando tão alto assim! E se você conseguia nos ouvir, por que não saiu para nos procurar?"

# game/scripts/c21/c21.rpy:179
translate brazilian c21s001_Foursome_60d8fbac:

    # mc "Me estaba preparando para cuando volvierais. *Risa*"
    mc "Eu estava me preparando para quando você voltasse. *Risos*"

# game/scripts/c21/c21.rpy:181
translate brazilian c21s001_Foursome_fb5a2e67:

    # eri "Y no nos has dejado abrir nuestro regalo como castigo, ¿no? *Risa*"
    eri "E você não nos deixou abrir o presente como castigo, né? *Risos*"

# game/scripts/c21/c21.rpy:182
translate brazilian c21s001_Foursome_8c28168a:

    # mc "Nunca os castigaría por intentar hacer una broma. Ni por ninguna otra cosa, para ser sincero. Tan solo os he ahorrado tiempo. *Risa*"
    mc "Eu jamais te puniria por tentar fazer uma pegadinha. Ou por qualquer outra coisa, para ser sincera. Só te poupei o tempo. *Risos*"

# game/scripts/c21/c21.rpy:184
translate brazilian c21s001_Foursome_a2f3101f:

    # dap "Sobre el papel, lo de plantarnos las tres en tu habitación parecía una buena idea, pero ahora no sé por dónde empezar..."
    dap "Em teoria, a ideia de nós três aparecermos no seu quarto parecia boa, mas agora não sei por onde começar..."

# game/scripts/c21/c21.rpy:185
translate brazilian c21s001_Foursome_8c649f98:

    # mc "¿Qué tal si venís aquí y vamos descubriéndolo?"
    mc "Que tal você vir aqui e a gente descobre?"

# game/scripts/c21/c21.rpy:186
translate brazilian c21s001_Foursome_70e29f35:

    # mc "Me ha sorprendido un poco veros aquí, pero es casi un sueño hecho realidad."
    mc "Fiquei um pouco surpreso(a) em te ver aqui, mas é quase um sonho que se torna realidade."

# game/scripts/c21/c21.rpy:189
translate brazilian c21s001_Foursome_259c23ba:

    # dap "Después de lo que ha pasado en la partida de DnD... tú ponías caras, pero nosotras nos podíamos imaginar..."
    dap "Depois do que aconteceu no jogo de D&D... você estava fazendo caretas, mas a gente consegue imaginar..."

# game/scripts/c21/c21.rpy:191
translate brazilian c21s001_Foursome_c453c2b1:

    # dap "Al menos en mi cabeza, el trío con Aelia, Vilfredo, y Paula ha sido super caliente."
    dap "Pelo menos na minha cabeça, o ménage à trois com Aelia, Vilfredo e Paula foi super quente."

# game/scripts/c21/c21.rpy:192
translate brazilian c21s001_Foursome_d00e1eab:

    # mc "Os entiendo. A mí me ha pasado lo mismo."
    mc "Entendo. A mesma coisa aconteceu comigo."

# game/scripts/c21/c21.rpy:195
translate brazilian c21s001_Foursome_c353d4c9:

    # dap "Después de lo que ha pasado en la partida de DnD... de haber rechazado a Beagan..."
    dap "Depois do que aconteceu no jogo de D&D... depois de rejeitar Beagan..."

# game/scripts/c21/c21.rpy:196
translate brazilian c21s001_Foursome_083d2918:

    # dap "Hemos pensado que si no lo hubieras hecho, quizás hubiera acabado con las cuatro en la cama de Vilfredo."
    dap "Pensamos que, se você não tivesse feito isso, talvez nós quatro tivéssemos acabado na cama do Vilfredo."

# game/scripts/c21/c21.rpy:198
translate brazilian c21s001_Foursome_43f2fa1c:

    # emm "Para que después digan que DnD no sirve de nada. *Risa*"
    emm "E depois dizem que D&D é inútil. *Risos*"

# game/scripts/c21/c21.rpy:199
translate brazilian c21s001_Foursome_af076395:

    # emm "Cuando te has ido a llevar a [mad.nick], casi nos hemos peleado por quién venía a verte. *Risita*"
    emm "Quando você foi buscar [mad.nick], quase brigamos para ver quem ia te ver. *Risos*"

# game/scripts/c21/c21.rpy:201
translate brazilian c21s001_Foursome_fcace866:

    # eri "Si no hubiera sido por la partida, lo hubiéramos echado a suertes, pero después de jugar... hemos decidido venir las tres."
    eri "Se não fosse pelo jogo, teríamos tirado a sorte, mas depois de jogar... decidimos que nós três viríamos."

# game/scripts/c21/c21.rpy:203
translate brazilian c21s001_Foursome_7bcff052:

    # mc "No quiero sonar desagradecido o avaricioso, pero ¿[sca] no se ha querido unir?"
    mc "Não quero parecer ingrato ou ganancioso, mas você não queria participar?"

# game/scripts/c21/c21.rpy:205
translate brazilian c21s001_Foursome_558c177b:

    # dap "Se lo hemos propuesto, pero ha dicho que era nuestro cumpleaños..."
    dap "Nós sugerimos isso a ele, mas ele disse que era nosso aniversário..."

# game/scripts/c21/c21.rpy:207
translate brazilian c21s001_Foursome_c59c26f9:

    # dap "Y que quiere mantener las distancias hasta el martes."
    dap "E que ele deseja manter o distanciamento social até terça-feira."

# game/scripts/c21/c21.rpy:209
translate brazilian c21s001_Foursome_dd893afc:

    # emm "No lo he entendido. ¿Qué pasa el martes?"
    emm "Não entendi. O que acontece na terça-feira?"

# game/scripts/c21/c21.rpy:210
translate brazilian c21s001_Foursome_fc1578f6:

    # mcp "(Que llegan los resultados del test de ADN.)"
    mcp "(Chegam os resultados do teste de DNA.)"

# game/scripts/c21/c21.rpy:213
translate brazilian c21s001_Foursome_c79b9725:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Mas a meia-noite já passou, a festa de aniversário acabou."

# game/scripts/c21/c21.rpy:216
translate brazilian c21s001_Foursome_9f91f5c6:

    # dap "Sexo de cumpleaños, y esas cosas. *Risita*"
    dap "Sexo de aniversário e coisas do tipo. *Risos*"

# game/scripts/c21/c21.rpy:218
translate brazilian c21s001_Foursome_c79b9725_1:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Mas a meia-noite já passou, a festa de aniversário acabou."

# game/scripts/c21/c21.rpy:220
translate brazilian c21s001_Foursome_c82eb9fb:

    # eri "Hoy, aunque sea lunes, todavía es nuestro cumpleaños, al menos el de [dap] y el mío."
    eri "Hoje, mesmo sendo segunda-feira, ainda é nosso aniversário, pelo menos o meu e o de [dap]."

# game/scripts/c21/c21.rpy:222
translate brazilian c21s001_Foursome_4b42ed68:

    # emm "Lo siento, chicas, a veces me olvido... especialmente cuando vuestro cumpleaños es después del domingo de la fiesta."
    emm "Desculpem, meninas, às vezes eu esqueço... principalmente quando o aniversário de vocês é depois da festa de domingo."

# game/scripts/c21/c21.rpy:223
translate brazilian c21s001_Foursome_e5270572:

    # mc "No le des más vueltas, [emm]. Son cosas que pasan. Le dais tanta importancia a la fiesta del domingo que olvidáis cuándo son los cumpleaños oficiales."
    mc "Não se preocupe demais. Essas coisas acontecem. Você está dando tanta importância à festa de domingo que está se esquecendo das datas oficiais dos aniversários."

# game/scripts/c21/c21.rpy:226
translate brazilian c21s001_Foursome_1033a870:

    # eri "Sobre eso... sabes que me han encantado los pendientes, pero quiero mi regalo de cumpleaños de verdad."
    eri "Sobre isso... sabe, eu adorei os brincos, mas quero meu presente de aniversário de verdade."

# game/scripts/c21/c21.rpy:228
translate brazilian c21s001_Foursome_273c7378:

    # mc "*Risa* No sé a lo que te refieres... pero veo que no llevas los pendientes."
    mc "*Risos* Não sei o que você quer dizer... mas vejo que você não está usando brincos."

# game/scripts/c21/c21.rpy:233
translate brazilian c21s001_Foursome_b9731cb0:

    # eri "No estoy acostumbrada a llevarlos aún. Después de cambiarme me los he quitado."
    eri "Ainda não me acostumei a usá-las. Tirei-as depois de me trocar."

# game/scripts/c21/c21.rpy:234
translate brazilian c21s001_Foursome_fcc40a71:

    # emm "¡Ve a por él, [eri]!"
    emm "Vai em frente, [eri]!"

# game/scripts/c21/c21.rpy:235
translate brazilian c21s001_Foursome_b36f1535:

    # "Después de un largo día, los ojos te pican un poco y las luces te molestan. Esperas que no vaya a ser un problema para disfrutar de la noche."
    "Após um longo dia, seus olhos estão um pouco irritados e as luzes estão incomodando. Você espera que isso não atrapalhe seu passeio à noite."

# game/scripts/c21/c21.rpy:238
translate brazilian c21s001_Foursome_06999336:

    # eri "Y en cuanto a mi regalo, me refiero a esto..."
    eri "E quanto ao meu presente, quero dizer isto..."

# game/scripts/c21/c21.rpy:241
translate brazilian c21s001_Foursome_c734993d:

    # "[eri] se sienta a horcajadas en tu regazo y empieza un maravilloso beso."
    "[eri] senta-se no seu colo e começa um beijo maravilhoso."

# game/scripts/c21/c21.rpy:242
translate brazilian c21s001_Foursome_9dbf5877:

    # "El tiempo de los besos a escondidas ha pasado después de la Gran Revelación y los dos os sentís liberados de la presión de mantener el secreto."
    "O tempo dos beijos secretos passou após a Grande Revelação e vocês dois se sentem livres da pressão de guardar o segredo."

# game/scripts/c21/c21.rpy:243
translate brazilian c21s001_Foursome_96bcc3e2:

    # "Vuestros labios se rozan, vuestras lenguas se entrelazan, vuestros alientos se entremezclan."
    "Seus lábios se roçam, suas línguas se entrelaçam, suas respirações se misturam."

# game/scripts/c21/c21.rpy:246
translate brazilian c21s001_Foursome_58c5e4a6:

    # emm "Nosotras también queremos nuestra ración de [mc]."
    emm "Nós também queremos a nossa parte do [mc]."

# game/scripts/c21/c21.rpy:248
translate brazilian c21s001_Foursome_2761fc71:

    # dap "No seas impaciente, [emm]. Tenemos toda la noche para compartir a [mc]."
    dap "Não tenha pressa, [emm]. Temos a noite toda para compartilhar [mc]."

# game/scripts/c21/c21.rpy:250
translate brazilian c21s001_Foursome_93d797d6:

    # eri "Todo vuestro, al menos durante un rato. *Risa* Voy a querer más."
    eri "Tudo seu, pelo menos por um tempo. *Risos* Vou querer mais."

# game/scripts/c21/c21.rpy:252
translate brazilian c21s001_Foursome_11a6afa6:

    # "[emm] te tumba en la cama y empieza un delicioso beso"
    "[emm] Ele te deita na cama e começa um beijo delicioso."

# game/scripts/c21/c21.rpy:254
translate brazilian c21s001_Foursome_79ef90b6:

    # "Al que no tarda en unirse [dap]."
    "Quem em breve será acompanhado por [dap]."

# game/scripts/c21/c21.rpy:256
translate brazilian c21s001_Foursome_77b9c9b2:

    # "Ambas se van turnando, en un baile casi sincronizado, por una vez sin discutir entre ellas."
    "Eles se revezam, numa dança quase sincronizada, pela primeira vez sem discutir um com o outro."

# game/scripts/c21/c21.rpy:257
translate brazilian c21s001_Foursome_6b92b5b5:

    # "Un baile complicado donde sus cabezas están a punto de chocar más de una vez entre ellas."
    "Uma dança complexa onde suas cabeças estão prestes a colidir mais de uma vez."

# game/scripts/c21/c21.rpy:260
translate brazilian c21s001_Foursome_c0ad023a:

    # "Puedes notar cómo [eri] no se queda inactiva mientras su hermana y su prima te besan."
    "Você pode notar como [eri] não permanece inativo enquanto sua irmã e prima te beijam."

# game/scripts/c21/c21.rpy:262
translate brazilian c21s001_Foursome_f156274e:

    # "Puedes notar cómo [eri] no se queda inactiva mientras las otras dos mujeres te besan."
    "Você pode notar como [eri] não permanece inativo enquanto as outras duas mulheres te beijam."

# game/scripts/c21/c21.rpy:263
translate brazilian c21s001_Foursome_0d9b1752:

    # eri "Tu pierna me molesta, [emm]. Creo que vuestros besos lo han dejado preparado para nosotras."
    eri "Sua perna está me incomodando, [emm]. Acho que seus beijos a prepararam para nós."

# game/scripts/c21/c21.rpy:264
translate brazilian c21s001_Foursome_38d826de:

    # emm "Ya estaba así cuando te has levantado de su regazo. *Risita*"
    emm "Ela já estava assim quando você se levantou do colo dela. *Risos*"

# game/scripts/c21/c21.rpy:265
