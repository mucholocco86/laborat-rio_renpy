translate brazilian c21s002_PoliceStation_003228b3:

    # pol "Buenos días, Sr. Lamb. ¿En qué puedo ayudarle?"
    pol "Bom dia, Sr. Lamb. Como posso ajudá-lo?"

# game/scripts/c21/c21.rpy:1120
translate brazilian c21s002_PoliceStation_65709269:

    # sol "¿No deberíamos pasar a su despacho o algo así?"
    sol "Não deveríamos ir ao escritório dele ou algo assim?"

# game/scripts/c21/c21.rpy:1121
translate brazilian c21s002_PoliceStation_a74eee28:

    # pol "Indíqueme primero de qué se trata. La mayoría de las denuncias se toman en este mostrador, para eso está."
    pol "Por favor, explique-me primeiro do que se trata. A maioria das reclamações são registradas neste balcão; é para isso que ele serve."

# game/scripts/c21/c21.rpy:1122
translate brazilian c21s002_PoliceStation_28bf9788:

    # pol "Esto no es Los Angeles ni una película. Nunca se fíe de las películas en cuanto a cómo funciona la Policía de verdad."
    pol "Isto não é Los Angeles nem um filme. Nunca confie em filmes quando se trata de como a polícia realmente opera."

# game/scripts/c21/c21.rpy:1123
translate brazilian c21s002_PoliceStation_d4b6bb91:

    # sol "Ah, vale, perdón, es la primera vez que tengo que denunciar a alguien."
    sol "Ah, ok, desculpe, é a primeira vez que preciso denunciar alguém."

# game/scripts/c21/c21.rpy:1125
translate brazilian c21s002_PoliceStation_89157959:

    # sol "Quiero denunciar a [mc] Marks."
    sol "Quero denunciar [mc] Marks."

# game/scripts/c21/c21.rpy:1126
translate brazilian c21s002_PoliceStation_285ae94a:

    # pol "Un segundo, voy a tomar nota... ¿Por qué quiere denunciarlo?"
    pol "Só um segundo, deixe-me anotar isso... Por que você quer denunciar?"

# game/scripts/c21/c21.rpy:1128
translate brazilian c21s002_PoliceStation_05f288d2:

    # sol "Ayer me disparó."
    sol "Ele atirou em mim ontem."

# game/scripts/c21/c21.rpy:1130
translate brazilian c21s002_PoliceStation_15b3b448:

    # pol "¿Qué? ¿Está usted herido?"
    pol "O quê? Você se machucou?"

# game/scripts/c21/c21.rpy:1132
translate brazilian c21s002_PoliceStation_b703678c:

    # sol "No, falló el disparo y no me dio."
    sol "Não, ele errou o chute e não me acertou."

# game/scripts/c21/c21.rpy:1133
translate brazilian c21s002_PoliceStation_8d9c9ee4:

    # pol "Eso es muy grave. ¿Dónde ocurrió el intento de asesinato?"
    pol "Isso é muito sério. Onde ocorreu a tentativa de homicídio?"

# game/scripts/c21/c21.rpy:1135
translate brazilian c21s002_PoliceStation_0424410b:

    # sol "Mmmm... Intento de asesinato... Sí..."
    sol "Hum... Tentativa de homicídio... Sim..."

# game/scripts/c21/c21.rpy:1137
translate brazilian c21s002_PoliceStation_057f9cae:

    # sol "En su casa... bueno, no en su casa... fuera de su casa, en la calle..."
    sol "Em casa... bem, não exatamente em casa... fora de casa, na rua..."

# game/scripts/c21/c21.rpy:1138
translate brazilian c21s002_PoliceStation_5f8c04af:

    # pol "Déjeme apuntarlo. El Sr. [mc] Marks disparó al Sr. Solomon Lamb en la vía pública."
    pol "Deixe-me esclarecer isto. O Sr. Marks atirou no Sr. Solomon Lamb na rua."

# game/scripts/c21/c21.rpy:1139
translate brazilian c21s002_PoliceStation_384fd0d1:

    # sol "Exacto... "
    sol "Exato..."

# game/scripts/c21/c21.rpy:1140
translate brazilian c21s002_PoliceStation_26b542f2:

    # pol "Los moretones que tiene en la cara, ¿también se los hizo el Sr. Marks? ¿O son de un incidente separado?"
    pol "O Sr. Marks também causou os hematomas no rosto dele? Ou eles são resultado de um incidente separado?"

# game/scripts/c21/c21.rpy:1142
translate brazilian c21s002_PoliceStation_92d5df28:

    # sol "Sí, también. Fue antes de dispararme. En la puerta de su propiedad. Apúntelo."
    sol "Sim, isso também. Foi antes de ele atirar em mim. No portão da propriedade dele. Anote isso."

# game/scripts/c21/c21.rpy:1143
translate brazilian c21s002_PoliceStation_c6d94bf7:

    # pol "Es decir, estaba usted en su propiedad, ¿no?"
    pol "Em outras palavras, você estava em sua propriedade, certo?"

# game/scripts/c21/c21.rpy:1145
translate brazilian c21s002_PoliceStation_a841a495:

    # sol "No, no llegué a entrar. Estaba allí... por un tema personal... y me agredió sin venir a cuento ni entrar en su propiedad. Es un tipo muy agresivo."
    sol "Não, eu nem entrei. Eu estava lá... por um assunto pessoal... e ele me atacou sem motivo algum, sem nem mesmo entrar na propriedade dele. Ele é um cara muito agressivo."

# game/scripts/c21/c21.rpy:1146
translate brazilian c21s002_PoliceStation_c3039974:

    # pol "Perfecto, me hago una idea de lo que pasó. El Sr. Marks se ha visto envuelto en un par de incidentes violentos previamente."
    pol "Perfeito, tenho uma ideia do que aconteceu. O Sr. Marks já esteve envolvido em alguns incidentes violentos anteriormente."

# game/scripts/c21/c21.rpy:1148
translate brazilian c21s002_PoliceStation_97b140b7:

    # sol "¿De verdad? ¡No lo sabía! Teniendo antecedentes, lo detendrán en seguida, ¿verdad?"
    sol "Sério? Eu não sabia disso! Com a ficha criminal dele, vão prendê-lo imediatamente, não é?"

# game/scripts/c21/c21.rpy:1149
translate brazilian c21s002_PoliceStation_03a91296:

    # pol "Bueno, primero tenemos que aclarar algunas cosas que no acaban de encajarme."
    pol "Bem, primeiro precisamos esclarecer algumas coisas que não me parecem fazer muito sentido."

# game/scripts/c21/c21.rpy:1150
translate brazilian c21s002_PoliceStation_d81967ce:

    # pol "¿En qué momento el Sr. Marks sacó el arma? ¿Antes o después de apalizarle a usted?"
    pol "Em que momento o Sr. Marks sacou a arma? Antes ou depois de te agredir?"

# game/scripts/c21/c21.rpy:1152
translate brazilian c21s002_PoliceStation_c0edd10c:

    # sol "¡No me apalizó! ¡Él recibió tanto o más que yo!"
    sol "Ele não me bateu! Ele apanhou tanto ou mais do que eu!"

# game/scripts/c21/c21.rpy:1153
translate brazilian c21s002_PoliceStation_81e01352:

    # pol "Ah, entonces fue una pelea... justa... en la que usted iba ganando. ¿En qué momento sacó el arma?"
    pol "Ah, então foi uma luta justa... na qual você estava ganhando. Em que momento você sacou a arma?"

# game/scripts/c21/c21.rpy:1155
translate brazilian c21s002_PoliceStation_f1c315ad:

    # sol "Bueno... no estoy seguro... supongo que fue cuando... lo dejé tirado en el suelo... yo ya me iba hacia mi camioneta cuando oí el disparo."
    sol "Bem... não tenho certeza... acho que foi quando... o deixei caído no chão... eu já estava indo em direção ao meu caminhão quando ouvi o tiro."

# game/scripts/c21/c21.rpy:1156
translate brazilian c21s002_PoliceStation_81b4bc1b:

    # pol "Entonces, ¿usted le dio la espalda al Sr. Marks y éste sacó un arma y le disparó?"
    pol "Então, você virou as costas para o Sr. Marks e ele sacou uma arma e atirou em você?"

# game/scripts/c21/c21.rpy:1158
translate brazilian c21s002_PoliceStation_d9048d94:

    # sol "Exacto... supongo que fue entonces cuando sacó el arma. Hasta entonces fue una pelea justa entre hombres... o entre un hombre y un niñato."
    sol "Exatamente... Acho que foi aí que ele sacou a arma. Até então, era uma luta justa entre homens... ou entre um homem e um garoto."

# game/scripts/c21/c21.rpy:1159
translate brazilian c21s002_PoliceStation_2972f70c:

    # sol "Por eso no venía a denunciarlo por la agresión... sino por el intento de asesinato."
    sol "Por isso não vim denunciá-lo pela agressão... mas sim pela tentativa de homicídio."

# game/scripts/c21/c21.rpy:1161
translate brazilian c21s002_PoliceStation_75123305:

    # sol "¡Pelea que, obviamente, no empecé yo! Nunca hubiera empezado una pelea con alguien como ese tipo, por mucho que se lo merezca. No hubiera sido justo para él."
    sol "Uma briga que, obviamente, eu não comecei! Eu jamais teria começado uma briga com alguém como aquele cara, por mais que ele merecesse. Não seria justo com ele."

# game/scripts/c21/c21.rpy:1162
translate brazilian c21s002_PoliceStation_d14e611f:

    # pol "Perfecto. ¿Hay algún testigo de los hechos?"
    pol "Perfeito. Há alguma testemunha dos acontecimentos?"

# game/scripts/c21/c21.rpy:1164
translate brazilian c21s002_PoliceStation_59c0f692:

    # sol "En su casa había varias mujeres... creo que está formando algún tipo de secta... unas zorras que iban semidesnudas, con las tetas al aire."
    sol "Havia várias mulheres na casa dele... Acho que ele está formando algum tipo de seita... umas vadias que andavam por aí seminuas, com os peitos de fora."

# game/scripts/c21/c21.rpy:1165
translate brazilian c21s002_PoliceStation_037dd5ed:

    # sol "Pero supongo que mentirán para encubrirle."
    sol "Mas suponho que eles mentirão para acobertá-lo."

# game/scripts/c21/c21.rpy:1167
translate brazilian c21s002_PoliceStation_a321be9b:

    # sol "Incluso había una puta rubia que intentó pegarme después del disparo. Por suerte, fui rápido, me metí en mi camioneta y me fui."
    sol "Teve até uma prostituta loira que tentou me bater depois do tiroteio. Por sorte, fui rápido, entrei na minha caminhonete e fui embora."

# game/scripts/c21/c21.rpy:1168
translate brazilian c21s002_PoliceStation_084f4b16:

    # sol "Soy un caballero que nunca ha pegado a una mujer, pero si mi integridad física se viera amenazada..."
    sol "Sou um cavalheiro que nunca bateu em uma mulher, mas se minha segurança física estivesse ameaçada..."

# game/scripts/c21/c21.rpy:1169
translate brazilian c21s002_PoliceStation_cb8227f3:

    # pol "Perfecto. ¿De cuantas pulgadas era la llave Stilson?"
    pol "Perfeito. Qual era o tamanho da chave Stilson?"

# game/scripts/c21/c21.rpy:1171
translate brazilian c21s002_PoliceStation_f485a842:

    # sol "De 24 pulgadas."
    sol "24 polegadas."

# game/scripts/c21/c21.rpy:1173
translate brazilian c21s002_PoliceStation_3de72a3d:

    # sol "¿Qué? ¿Qué llave?"
    sol "O quê? Que tecla?"

# game/scripts/c21/c21.rpy:1174
translate brazilian c21s002_PoliceStation_16fb09f8:

    # pol "Con la que usted intentó abrirle el cráneo al Sr. Marks por la espalda, a traición."
    pol "Com a qual você tentou abrir o crânio do Sr. Marks por trás, traiçoeiramente."

# game/scripts/c21/c21.rpy:1175
translate brazilian c21s002_PoliceStation_c309855b:

    # sol "¿Qué? ¡No! ¿Me ha denunciado con esa mentira para cubrirse?"
    sol "O quê? Não! Ele me denunciou com essa mentira para se proteger?"

# game/scripts/c21/c21.rpy:1177
translate brazilian c21s002_PoliceStation_e68892a6:

    # oma "No hacía falta que le denunciara. Yo estaba allí, no sé si me recuerda. Era una de las zorras con las tetas al aire."
    oma "Não havia necessidade de denunciá-la. Eu estava lá, não sei se ela se lembra de mim. Ela era uma daquelas vadias que ficavam com os peitos de fora."

# game/scripts/c21/c21.rpy:1178
translate brazilian c21s002_PoliceStation_60a7a513:

    # oma "Con esto y las grabaciones de seguridad, tengo suficiente para arrestarlo por intentar poner una denuncia falsa."
    oma "Com isso e com as imagens de segurança, tenho provas suficientes para prendê-lo por tentativa de prestar falso testemunho."

# game/scripts/c21/c21.rpy:1179
translate brazilian c21s002_PoliceStation_a111eaa3:

    # oma "Al menos de esta forma, si le meten en prisión, estará a salvo de mi hermana, la rubia que le atizó. Recuerde lo que le dijo sobre el bosque y sobre esconder cadáveres."
    oma "Pelo menos assim, se o colocarem na prisão, ele estará a salvo da minha irmã, a loira que o espancou. Lembra do que ela lhe disse sobre a floresta e esconder corpos?"

# game/scripts/c21/c21.rpy:1181
translate brazilian c21s002_PoliceStation_23f3db45:

    # sol "¡No, por favor! ¡No le diga nada!"
    sol "Não, por favor! Não conte nada a ele!"

# game/scripts/c21/c21.rpy:1182
translate brazilian c21s002_PoliceStation_b5035175:

    # sol "Le juro que no intentaré poner una denuncia sobre ese... ese... sobre ese hombre nunca más."
    sol "Juro que nunca mais tentarei apresentar queixa sobre isso... sobre isso... sobre aquele homem."

# game/scripts/c21/c21.rpy:1184
translate brazilian c21s002_PoliceStation_54567218:

    # oma "Sé que, aparte de un mentiroso, es usted un cobarde."
    oma "Eu sei que, além de mentiroso, você é um covarde."

# game/scripts/c21/c21.rpy:1185
translate brazilian c21s002_PoliceStation_25c30343:

    # oma "Con lo que creo que es lo que más le conviene. Pero quiero algo a cambio."
    oma "Acredito que isso seja o melhor para ele. Mas quero algo em troca."

# game/scripts/c21/c21.rpy:1187
translate brazilian c21s002_PoliceStation_2f897f89:

    # sol "¡No tengo dinero! La zorra de mi mujer..."
    sol "Não tenho dinheiro! Minha esposa é uma megera..."

# game/scripts/c21/c21.rpy:1189
translate brazilian c21s002_PoliceStation_ec663ce8:

    # oma "Como vuelva a insultar a alguien de mi familia, mi hermana, la rubia, se enterará de esto."
    oma "Se eu insultar alguém da minha família de novo, minha irmã loira vai descobrir."

# game/scripts/c21/c21.rpy:1190
translate brazilian c21s002_PoliceStation_673120a3:

    # oma "Y también [mc]. Ya vio lo que le pasó ayer por no parar de insultarlas."
    oma "E também [mc]. Você viu o que aconteceu com ele ontem por não parar de insultá-los."

# game/scripts/c21/c21.rpy:1192
translate brazilian c21s002_PoliceStation_0a4499e8:

    # sol "¡Perdón! Dígame cuánto dinero quiere... haré lo que pueda por conseguirlo..."
    sol "Com licença! Diga-me quanto dinheiro você quer... Farei o que puder para conseguir..."

# game/scripts/c21/c21.rpy:1195
translate brazilian c21s002_PoliceStation_253a0e78:

    # oma "No quiero su dinero, pero quiero otras cosas de usted. Va a empezar por...."
    oma "Eu não quero seu dinheiro, mas quero outras coisas de você. Vai começar com..."

# game/scripts/c21/c21.rpy:1236
translate brazilian c21s002_BettyMassageAndDrivingLicense_7228b7b0:

    # "Mientras tanto, en tu habitación..."
    "Enquanto isso, no seu quarto..."

# game/scripts/c21/c21.rpy:1240
translate brazilian c21s002_BettyMassageAndDrivingLicense_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c21/c21.rpy:1242
translate brazilian c21s002_BettyMassageAndDrivingLicense_a56b75d9:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Pela porta* Sou eu. Posso entrar?"

# game/scripts/c21/c21.rpy:1243
translate brazilian c21s002_BettyMassageAndDrivingLicense_f9c18ad4:

    # mc "Un momento, Tía [bet]."
    mc "Só um momento, tia [bet]."

# game/scripts/c21/c21.rpy:1245
translate brazilian c21s002_BettyMassageAndDrivingLicense_cf8cd174:

    # dap "*Susurrando* ¡Nos hemos quedado dormidas!"
    dap "*Sussurrando* Nós adormecemos!"

# game/scripts/c21/c21.rpy:1247
translate brazilian c21s002_BettyMassageAndDrivingLicense_3fc27f7b:

    # eri "*Susurrando* Danos un momento para vestirnos."
    eri "*Sussurrando* Nos dê um momento para nos vestirmos."

# game/scripts/c21/c21.rpy:1249
translate brazilian c21s002_BettyMassageAndDrivingLicense_8208b241:

    # emm "Pasa, Tía [bet]."
    emm "Entre, tia [bet]."

# game/scripts/c21/c21.rpy:1250
translate brazilian c21s002_BettyMassageAndDrivingLicense_586a8abe:

    # emm "*Susurrando* ¿Creéis que aunque nos vistamos no va a saber lo que ha pasado?"
    emm "*Sussurrando* Você acha que mesmo se nos vestirmos, ele não vai saber o que aconteceu?"

# game/scripts/c21/c21.rpy:1252
translate brazilian c21s002_BettyMassageAndDrivingLicense_2f8f0326:

    # bet "*Suspiro de sorpresa* ¡Oh!"
    bet "*Suspiro de surpresa* Oh!"

# game/scripts/c21/c21.rpy:1253
translate brazilian c21s002_BettyMassageAndDrivingLicense_a089bd75:

    # mc "Buenos días, Tía [bet]. ¿Te puedo... te podemos ayudar en algo?"
    mc "Bom dia, tia [bet]. Posso... podemos te ajudar em alguma coisa?"

# game/scripts/c21/c21.rpy:1255
translate brazilian c21s002_BettyMassageAndDrivingLicense_34482b3e:

    # bet "No... venía por lo del carnet de conducir, pero si estás... estáis ocupados... ya volveré más tarde."
    bet "Não... Vim para tratar da carteira de motorista, mas se você estiver ocupado... Volto mais tarde."

# game/scripts/c21/c21.rpy:1257
translate brazilian c21s002_BettyMassageAndDrivingLicense_57c35b93:

    # eri "No te preocupes, Tía [bet]. Nosotras ya nos íbamos."
    eri "Não se preocupe, tia [bet]. Estávamos de saída."

# game/scripts/c21/c21.rpy:1258
translate brazilian c21s002_BettyMassageAndDrivingLicense_54c2425e:

    # mcp "(No se atreve a mirarla directamente. Pese a lo que ha dicho [emm] se tienen que sentir un poco avergonzadas.)"
    mcp "(Ela não se atreve a olhar diretamente para ela. Apesar do que disse, elas devem estar se sentindo um pouco constrangidas.)"

# game/scripts/c21/c21.rpy:1259
translate brazilian c21s002_BettyMassageAndDrivingLicense_8c898c2f:

    # mc "Siéntate un momento, Tía [bet]."
    mc "Sente-se um momento, tia [bet]."

# game/scripts/c21/c21.rpy:1261
translate brazilian c21s002_BettyMassageAndDrivingLicense_21057d78:

    # dap "Sí, quiero darme una ducha..."
    dap "Sim, eu quero tomar um banho..."

# game/scripts/c21/c21.rpy:1263
translate brazilian c21s002_BettyMassageAndDrivingLicense_9f93c98b:

    # emm "*Risa* ¿Quieres quitarte todo el sudor de anoche?"
    emm "*Risos* Você quer lavar todo o suor da noite passada?"

# game/scripts/c21/c21.rpy:1265
translate brazilian c21s002_BettyMassageAndDrivingLicense_088efb80:

    # eri "Ya os dejamos solos, Tía [bet]."
    eri "Vamos deixá-la sozinha agora, tia [bet]."

# game/scripts/c21/c21.rpy:1266
translate brazilian c21s002_BettyMassageAndDrivingLicense_f83f9f91:

    # dap "Si puedes... no se lo cuentes a nadie."
    dap "Se puder... não conte a ninguém."

# game/scripts/c21/c21.rpy:1267
translate brazilian c21s002_BettyMassageAndDrivingLicense_9d188053:

    # mc "¿Vamos a volver a los secretos después de lo de ayer?"
    mc "Vamos voltar a usar segredos depois do que aconteceu ontem?"

# game/scripts/c21/c21.rpy:1268
translate brazilian c21s002_BettyMassageAndDrivingLicense_af6c42bd:

    # emm "Por lo que a mí respecta, se lo puedes contar a quien quieras. Estoy orgullosa de que mi novio haya podido complacer a tres mujeres a la vez."
    emm "Por mim, você pode contar para quem quiser. Tenho orgulho de que meu namorado tenha conseguido agradar três mulheres ao mesmo tempo."

# game/scripts/c21/c21.rpy:1270
translate brazilian c21s002_BettyMassageAndDrivingLicense_c409a293:

    # emm "No sabes lo que te pierdes siendo monja. *Risa*"
    emm "Você não sabe o que está perdendo por ser freira. *Risos*"

# game/scripts/c21/c21.rpy:1272
translate brazilian c21s002_BettyMassageAndDrivingLicense_6ae4d506:

    # bet "No era lo que esperaba encontrarme... Pero no os preocupéis. No es algo que salga en una conversación normal."
    bet "Não era o que eu esperava encontrar... Mas não se preocupe. Não é algo que surge numa conversa normal."

# game/scripts/c21/c21.rpy:1274
translate brazilian c21s002_BettyMassageAndDrivingLicense_5c9f488e:

    # "Las chicas abandonan la habitación. Ninguna de ellas te da un beso de buenos días."
    "As garotas saem do quarto. Nenhuma delas te dá um beijo de bom dia."

# game/scripts/c21/c21.rpy:1275
translate brazilian c21s002_BettyMassageAndDrivingLicense_9be5cfb5:

    # bet "¿Te va bien que miremos lo del carnet de conducir ahora?"
    bet "Podemos analisar a carteira de habilitação agora?"

# game/scripts/c21/c21.rpy:1277
translate brazilian c21s002_BettyMassageAndDrivingLicense_5066a30e:

    # mcp "(Es mejor que nos pongamos a hacer lo que ha venido a hacer antes de que quiera meter la nariz en lo que acaba de ver.)"
    mcp "(É melhor continuarmos com o que ela veio fazer antes que ela tente se intrometer no que acabou de ver.)"

# game/scripts/c21/c21.rpy:1281
translate brazilian c21s002_BettyMassageAndDrivingLicense_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-toc*"

# game/scripts/c21/c21.rpy:1282
translate brazilian c21s002_BettyMassageAndDrivingLicense_a56b75d9_1:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Pela porta* Sou eu. Posso entrar?"

# game/scripts/c21/c21.rpy:1283
translate brazilian c21s002_BettyMassageAndDrivingLicense_6b5f1a00:

    # mc "Pasa, Tía [bet]."
    mc "Entre, tia [bet]."

# game/scripts/c21/c21.rpy:1285
translate brazilian c21s002_BettyMassageAndDrivingLicense_e24dad1b:

    # bet "Venía a ver si te iba bien que mirásemos lo del carnet de conducir."
    bet "Vim para saber se você se importaria se desse uma olhada na carteira de habilitação."

# game/scripts/c21/c21.rpy:1286
translate brazilian c21s002_BettyMassageAndDrivingLicense_b39b71f0:

    # mc "Siéntate, voy a coger el portátil."
    mc "Sente-se, vou pegar meu laptop."

# game/scripts/c21/c21.rpy:1288
translate brazilian c21s002_BettyMassageAndDrivingLicense_ba0312a1:

    # bet "Aunque supongo que no has desayunado aún."
