# game/scripts/c21/c21.rpy:1516
translate brazilian c21s002_AaronCall_62cf7be6:

    # aar "Supongo que ya lo has pensado, pero... ¿alguna vez te han dicho que pareces mayor de tu edad?"
    aar "Imagino que você já tenha pensado nisso, mas... alguma vez já lhe disseram que você aparenta ser mais velho(a) do que realmente é?"

# game/scripts/c21/c21.rpy:1517
translate brazilian c21s002_AaronCall_75c3e23a:

    # mc "Sí. No me digas que yo también soy un clon que envejece más rápido."
