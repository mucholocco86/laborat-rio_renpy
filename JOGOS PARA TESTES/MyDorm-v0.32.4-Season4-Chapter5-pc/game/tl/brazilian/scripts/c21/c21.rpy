# game/scripts/c21/c21.rpy:1678
translate brazilian c21s002_Megan_3c65a76f:

    # mc "¿Qué tal lo has pasado el fin de semana?"
    mc "Como foi seu fim de semana?"

# game/scripts/c21/c21.rpy:1679
translate brazilian c21s002_Megan_d15af0eb:

    # meg "Ha sido genial. Me lo he pasado muy bien y ha sido fantástico conocer a todo el mundo."
    meg "Foi ótimo. Me diverti muito e foi fantástico conhecer todo mundo."

# game/scripts/c21/c21.rpy:1680
translate brazilian c21s002_Megan_c24435be:

    # mc "¿Te sientes más a gusto ahora, después de la fiesta de cumpleaños?"
    mc "Você se sente mais à vontade agora, depois da festa de aniversário?"

# game/scripts/c21/c21.rpy:1682
translate brazilian c21s002_Megan_bd07e85a:

    # meg "No me la imaginaba así. Con lo locos que estáis todos, esperaba algo más salvaje. Fue bastante tranquila."
    meg "Eu não imaginava que seria assim. Com o quão loucos vocês são, eu esperava algo mais agitado. Foi bem tranquilo."

# game/scripts/c21/c21.rpy:1683
translate brazilian c21s002_Megan_3567414e:

    # mc "Creo que la parte más salvaje estuvo en el jacuzzi. Las chicas se lo pasaron muy bien."
    mc "Acho que a parte mais animada foi na jacuzzi. As meninas se divertiram muito."

# game/scripts/c21/c21.rpy:1685
translate brazilian c21s002_Megan_6fcafd80:

    # meg "Bueno, Jamaal también se puso muy salvaje cuando tú te fuiste. *Risa* Y no me refiero solo a su capacidad para comer."
    meg "Bom, o Jamaal também ficou bem agitado quando você saiu. *Risos* E não estou falando só da capacidade dele de comer."

# game/scripts/c21/c21.rpy:1686
translate brazilian c21s002_Megan_03b871f3:

    # meg "Empezó a contar chistes sobre todo el mundo, menos [mad.nick] y las estudiantes. Supongo que aún no tiene suficiente material."
    meg "Ele começou a contar piadas sobre todos, exceto [mad.nick] e os alunos. Acho que ele ainda não tem material suficiente."

# game/scripts/c21/c21.rpy:1687
translate brazilian c21s002_Megan_1fee9104:

    # mc "Es un monologuista frustrado. *Risa* Por eso le dejo hablar solo muchas veces."
    mc "Ele é um comediante de stand-up frustrado. *Risos* É por isso que muitas vezes o deixo falar sozinho."

# game/scripts/c21/c21.rpy:1689
translate brazilian c21s002_Megan_388d91bd:

    # meg "*Risa* Sois tal para cual. Me encanta cómo os metéis el uno con el otro. Se nota que os queréis."
    meg "*Risos* Vocês dois são perfeitos um para o outro. Adoro como vocês se provocam. Dá para ver que se importam um com o outro."

# game/scripts/c21/c21.rpy:1690
translate brazilian c21s002_Megan_08b7f981:

    # mc "Ya sabes que es el deber de cualquier amo querer a su mascota. *Risa*"
    mc "Você sabe que é dever de todo dono amar seu animal de estimação. *Risos*"

# game/scripts/c21/c21.rpy:1692
translate brazilian c21s002_Megan_a92ae0ce:

    # meg "¿Ves? A eso me refiero. *Risa*"
    meg "Viu? É isso que eu quero dizer. *Risos*"

# game/scripts/c21/c21.rpy:1693
translate brazilian c21s002_Megan_cfc7a130:

    # mc "Hablando de cosas más serias. ¿Cuándo vuelves? ¿Vendrás el próximo fin de semana también?"
    mc "Falando mais sério agora, quando você volta? Você estará aqui no próximo fim de semana também?"

# game/scripts/c21/c21.rpy:1695
translate brazilian c21s002_Megan_d5787976:

    # meg "Trabajo hasta el miércoles en Westport y empiezo el viernes aquí de nuevo."
    meg "Eu trabalho até quarta-feira em Westport e volto para cá na sexta-feira."

# game/scripts/c21/c21.rpy:1696
translate brazilian c21s002_Megan_481ae79b:

    # meg "[mar] me ha dicho que venga el jueves, pero no estoy segura. Normalmente los jueves los aprovecho para hacer la limpieza en casa."
    meg "[mar] Ela me disse para vir na quinta-feira, mas não tenho certeza. Normalmente uso as quintas-feiras para limpar a casa."

# game/scripts/c21/c21.rpy:1697
translate brazilian c21s002_Megan_052760bc:

    # mc "*Risa* Si no estás en casa no verás si está sucia, y se ensuciará menos."
    mc "*Risos* Se você não estiver em casa, não vai ver se está sujo, e vai ficar menos sujo."

# game/scripts/c21/c21.rpy:1699
translate brazilian c21s002_Megan_5a02c626:

    # meg "*Risa* ¡Hombres!"
    meg "*Risos* Homens!"

# game/scripts/c21/c21.rpy:1701
translate brazilian c21s002_Megan_71dc5177:

    # meg "Ya veremos. El jueves o el viernes estaré de nuevo aquí. Además ya tendré el coche arreglado."
    meg "Veremos. Estarei de volta aqui na quinta ou sexta-feira. Além disso, meu carro estará consertado até lá."

# game/scripts/c21/c21.rpy:1702
translate brazilian c21s002_Megan_e1b0ccdd:

    # mc "Entonces espero verte el jueves."
    mc "Então espero te ver na quinta-feira."

# game/scripts/c21/c21.rpy:1705
translate brazilian c21s002_Megan_486a9a17:

    # meg "Tú también puedes venir a mi casa, si quieres. Sólo está a 35 minutos."
    meg "Você também pode vir à minha casa, se quiser. Fica a apenas 35 minutos daqui."

# game/scripts/c21/c21.rpy:1706
translate brazilian c21s002_Megan_34c0c949:

    # mc "Si puedo lo haré."
    mc "Se eu puder, farei."

# game/scripts/c21/c21.rpy:1707
translate brazilian c21s002_Megan_a08a7190:

    # mc "Esta semana va a ser complicada."
    mc "Esta semana vai ser complicada."

# game/scripts/c21/c21.rpy:1709
translate brazilian c21s002_Megan_bbdca4c9:

    # meg "Lo sé. Tienes lo de [emm] entre las otras miles de cosas que tienes que hacer."
    meg "Eu sei. Você tem o [emm] entre as milhares de outras coisas que você tem que fazer."

# game/scripts/c21/c21.rpy:1711
translate brazilian c21s002_Megan_051cbb70:

    # meg "Por allí llega mi autobús."
    meg "Meu ônibus chega por ali."

# game/scripts/c21/c21.rpy:1716
translate brazilian c21s002_Megan_ab1de559:

    # meg "Te veo el jueves o el viernes. Seguramente el jueves por la noche."
    meg "Te vejo na quinta ou na sexta. Provavelmente na quinta à noite."

# game/scripts/c21/c21.rpy:1717
translate brazilian c21s002_Megan_afd5ac81:

    # mc "Hasta el jueves, [meg]."
    mc "Até quinta-feira, [meg]."

# game/scripts/c21/c21.rpy:1719
translate brazilian c21s002_Megan_00700b65:

    # "[meg] desaparece en el interior del autobús."
    "[meg] desaparece dentro do ônibus."

# game/scripts/c21/c21.rpy:1721
translate brazilian c21s002_Megan_51ef8b47:

    # "Te acabas de dar cuenta de que no lleva la maleta que trajo. ¿Ha dejado ropa en casa?"
    "Você acabou de perceber que ela não está carregando a mala que trouxe. Será que ela esqueceu alguma roupa em casa?"

# game/scripts/c21/c21.rpy:1725
translate brazilian c21s003_NoKiaraDate_79f93db8:

    # "Justo al irse el autobús..."
    "Assim que o ônibus estava partindo..."

# game/scripts/c21/c21.rpy:1727
translate brazilian c21s003_NoKiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1731
translate brazilian c21s003_NoKiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Olá, [ama]. Posso te ajudar em alguma coisa?"

# game/scripts/c21/c21.rpy:1733
translate brazilian c21s003_NoKiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Só queria te lembrar que tínhamos combinado de tomar um café hoje para discutir minhas ideias sobre NTR. Que horário seria bom para você?"

# game/scripts/c21/c21.rpy:1734
translate brazilian c21s003_NoKiaraDate_2e084d07:

    # mc "Estoy en la estación de autobuses ahora mismo. Como algo rápido y podemos quedar. ¿En 30 minutos te va bien?"
    mc "Estou na rodoviária agora. Coma alguma coisa rapidinho e a gente se encontra. 30 minutos está bom para você?"

# game/scripts/c21/c21.rpy:1736
translate brazilian c21s003_NoKiaraDate_ed11e94d:

    # ama "Perfecto. Te mando la dirección de un café que tienes cerca y podemos quedar allí."
    ama "Perfeito. Vou te enviar o endereço de um café perto de você e podemos nos encontrar lá."

# game/scripts/c21/c21.rpy:1737
translate brazilian c21s003_NoKiaraDate_2a5423d0:

    # mc "Genial. Te veo en 30 minutos. Hasta ahora."
    mc "Ótimo. Te vejo em 30 minutos. Até lá."

# game/scripts/c21/c21.rpy:1738
translate brazilian c21s003_NoKiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Até agora, [mc]."

# game/scripts/c21/c21.rpy:1766
translate brazilian c21s003_KiaraDate_7386f7a4:

    # "Llegas a la biblioteca unos minutos antes de la hora a la que has quedado con [kia]."
    "Você chega à biblioteca alguns minutos antes do horário combinado para se encontrar [kia]."

# game/scripts/c21/c21.rpy:1767
translate brazilian c21s003_KiaraDate_9ae42375:

    # "Pasaste mucho tiempo en tu época del instituto en este edificio."
    "Você passou muito tempo neste prédio durante seus anos de ensino médio."

# game/scripts/c21/c21.rpy:1768
translate brazilian c21s003_KiaraDate_b594cfce:

    # "Por un momento dudas si debes entrar o no a buscarla. Decides hacerlo."
    "Por um instante, você hesita em entrar para procurá-la. Você decide fazê-lo."

# game/scripts/c21/c21.rpy:1770
translate brazilian c21s003_KiaraDate_11283da7:

    # mcp "(Allí está. Se ha cambiado el peinado y se ha puesto un vestido precioso. Creo que el premio a la elegancia de hoy ya tiene dueño.)"
    mcp "(Ali está ela. Mudou o penteado e vestiu um vestido deslumbrante. Acho que o prêmio de elegância de hoje já tem dona.)"

# game/scripts/c21/c21.rpy:1771
translate brazilian c21s003_KiaraDate_6c3c6634:

    # mcp "(Y no soy yo.)"
    mcp "(E não sou eu.)"

# game/scripts/c21/c21.rpy:1773
translate brazilian c21s003_KiaraDate_898d49a2:

    # "Te acercas tímidamente al mostrador donde está hablando con la Srta. Walker, la bibliotecaria canadiense de tu época de instituto. De Montreal, crees recordar."
    "Você se aproxima timidamente do balcão onde ele está conversando com a Sra. Walker, a bibliotecária canadense dos seus tempos de colégio. De Montreal, você acha que se lembra."

# game/scripts/c21/c21.rpy:1774
translate brazilian c21s003_KiaraDate_634d1076:

    # "No sabes cuánto sabe sobre vuestra relación, si es que sabe algo. O de la situación con Solomon."
    "Você não sabe o quanto ele sabe sobre o seu relacionamento, se é que sabe alguma coisa. Ou sobre a situação com Solomon."

# game/scripts/c21/c21.rpy:1775
translate brazilian c21s003_KiaraDate_68ffd690:

    # mc "Hola, [kia]. Hola..."
    mc "Olá, [kia]. Olá..."

# game/scripts/c21/c21.rpy:1776
translate brazilian c21s003_KiaraDate_e8747f1d:

    # kia "Hola, [mc]. Te presento a Geneviève, mi jefa. Gen, este es [mc], el sobrino de [nor], de quien te he hablado."
    kia "Olá, [mc]. Aqui é Geneviève, minha chefe. Gen, este é [mc], sobrinho de [nor], de quem te falei."

# game/scripts/c21/c21.rpy:1778
translate brazilian c21s003_KiaraDate_934429e1:

    # gen "Encantada de conocerte, [mc]."
    gen "Prazer em conhecê-lo(a), [mc]."

# game/scripts/c21/c21.rpy:1779
translate brazilian c21s003_KiaraDate_2c25e289:

    # mc "Igualmente, Geneviève."
    mc "Igualmente, Geneviève."

# game/scripts/c21/c21.rpy:1780
translate brazilian c21s003_KiaraDate_29d3b3f0:

    # gen "Puedes llamarme Gen."
    gen "Pode me chamar de General."

# game/scripts/c21/c21.rpy:1782
translate brazilian c21s003_KiaraDate_a6907f6d:

    # mc "¿Estás lista para irnos?"
    mc "Você está pronto para ir?"

# game/scripts/c21/c21.rpy:1783
translate brazilian c21s003_KiaraDate_53dcdf3b:

    # kia "Sí, dame un momento que vaya a por el bolso."
    kia "Sim, só um momento enquanto vou buscar minha bolsa."

# game/scripts/c21/c21.rpy:1784
translate brazilian c21s003_KiaraDate_8b397a73:

    # mc "Perfecto, te espero aquí."
    mc "Perfeito, vou esperar você aqui."

# game/scripts/c21/c21.rpy:1785
translate brazilian c21s003_KiaraDate_b4418a13:

    # kia "Será solo un segundo."
    kia "Vai ser só um segundo."

# game/scripts/c21/c21.rpy:1787
translate brazilian c21s003_KiaraDate_7cae2efd:

    # gen "Así que [kia] y [eil] se están alojando en tu casa mientras acaban con el problema de termitas, ¿no?"
    gen "Então, [kia] e [eil] estão ficando na sua casa enquanto resolvem o problema dos cupins, certo?"

# game/scripts/c21/c21.rpy:1788
translate brazilian c21s003_KiaraDate_3a42f87c:

    # gen "Les estáis haciendo un favor muy grande."
    gen "Você está fazendo um enorme favor a eles."

# game/scripts/c21/c21.rpy:1789
translate brazilian c21s003_KiaraDate_7a642010:

    # mcp "(¿Termitas? Está claro que no le ha contado lo de Solomon.)"
    mcp "(Cupins? Claramente ele não lhe contou sobre Salomão.)"

# game/scripts/c21/c21.rpy:1790
translate brazilian c21s003_KiaraDate_cfd7f90b:

    # mc "Bueno, no se aloja en mi casa, sino en la de mi tía, [nor]."
    mc "Bem, ele não está hospedado na minha casa, mas na casa da minha tia, [nor]."

# game/scripts/c21/c21.rpy:1792
translate brazilian c21s003_KiaraDate_12ae6060:

    # gen "Tú y yo nos conocemos, ¿verdad?"
    gen "Você e eu nos conhecemos, certo?"

# game/scripts/c21/c21.rpy:1793
translate brazilian c21s003_KiaraDate_e8944aa2:

    # mc "Pasaba mucho tiempo aquí cuando iba al instituto."
    mc "Eu costumava passar muito tempo aqui quando estava no ensino médio."

# game/scripts/c21/c21.rpy:1795
translate brazilian c21s003_KiaraDate_74fc50ac:

    # gen "*Risa* ¡No llevo tanto tiempo trabajando aquí! Sólo llevo ocho años."
    gen "*Risos* Não trabalho aqui há tanto tempo assim! Estou aqui há apenas oito anos."

# game/scripts/c21/c21.rpy:1796
translate brazilian c21s003_KiaraDate_1752be01:

    # mc "Y hace cuatro yo estudiaba en el instituto de Newport, Srta. Walker. Es posible que no me reconozca."
    mc "E há quatro anos eu era aluna da professora Walker, da Newport High School. Talvez você não me reconheça."

# game/scripts/c21/c21.rpy:1797
translate brazilian c21s003_KiaraDate_7b7a8bca:

    # mc "Pasado de peso, con la nariz metida en un libro, con un amigo en silla de ruedas..."
    mc "Acima do peso, com o nariz enfiado num livro, com um amigo numa cadeira de rodas..."

# game/scripts/c21/c21.rpy:1799
translate brazilian c21s003_KiaraDate_aa0f87b2:

    # gen "¿Marks? ¿[mc] Marks? ¡No puede ser!"
    gen "Notas? [mc] Notas? De jeito nenhum!"

# game/scripts/c21/c21.rpy:1800
translate brazilian c21s003_KiaraDate_72f95f2a:

    # mc "Puede ser. Supongo que no me dejé ningún libro por devolver cuando me fui a la universidad. *Risa*"
    mc "Talvez. Acho que não deixei nenhum livro sem devolver quando fui para a universidade. *Risos*"

# game/scripts/c21/c21.rpy:1802
translate brazilian c21s003_KiaraDate_35b065bd:

    # gen "Estoy sorprendida... Un gran cambio..."
    gen "Estou surpreso... Uma grande mudança..."

# game/scripts/c21/c21.rpy:1803
translate brazilian c21s003_KiaraDate_817b71b9:

    # gen "Y ya no soy la Srta. Walker. Ahora soy la Sra. Sky."
    gen "E eu não sou mais a Srta. Walker. Agora sou a Sra. Sky."

# game/scripts/c21/c21.rpy:1804
translate brazilian c21s003_KiaraDate_3e97c86b:

    # mc "Felicidades, Sra. Sky."
    mc "Parabéns, Sra. Sky."

# game/scripts/c21/c21.rpy:1806
translate brazilian c21s003_KiaraDate_76b619e2:

    # gen "Puedes seguir llamándome Gen. Ya no eres un adolescente."
    gen "Você ainda pode me chamar de Gen. Você não é mais adolescente."

# game/scripts/c21/c21.rpy:1807
translate brazilian c21s003_KiaraDate_4003899d:

    # mc "Felicidades, Gen, entonces."
    mc "Parabéns, Gen, então."

# game/scripts/c21/c21.rpy:1809
translate brazilian c21s003_KiaraDate_efa2a30a:

    # kia "Ya nos podemos ir, [mc]. No lo entretengas, Gen, o tendré que tomarme más tiempo para comer."
    kia "Podemos ir agora, [mc]. Não o retenha, Gen, ou terei que demorar mais para comer."

# game/scripts/c21/c21.rpy:1810
translate brazilian c21s003_KiaraDate_f9fc42cb:

    # mc "Nos estábamos poniendo al día. Gen y yo nos conocíamos de mi época de rata de biblioteca."
    mc "Estávamos colocando o papo em dia. Gen e eu nos conhecíamos da época em que eu era uma leitora voraz."

# game/scripts/c21/c21.rpy:1812
translate brazilian c21s003_KiaraDate_e60a6b7c:

    # mc "Hasta otra, Gen."
    mc "Até a próxima, General."

# game/scripts/c21/c21.rpy:1813
translate brazilian c21s003_KiaraDate_3357fab1:

    # gen "Hasta otra, [mc]."
    gen "Até a próxima, [mc]."

# game/scripts/c21/c21.rpy:1815
translate brazilian c21s003_KiaraDate_9af56f4c:

    # kia "Vuelvo en una hora... más o menos."
    kia "Volto em uma hora... mais ou menos."

# game/scripts/c21/c21.rpy:1817
translate brazilian c21s003_KiaraDate_ff564463:

    # kia "¿Dónde has decidido que vayamos a comer?"
    kia "Onde você decidiu que devemos ir jantar?"

# game/scripts/c21/c21.rpy:1818
translate brazilian c21s003_KiaraDate_b2e3f62c:

    # mc "Un restaurante que me ha recomendado Tía [bet]. Es sorprendente que en una semana conozca tantos restaurantes."
    mc "Um restaurante que a tia [bet] me recomendou. É incrível que eu tenha visitado tantos restaurantes em apenas uma semana."

# game/scripts/c21/c21.rpy:1819
translate brazilian c21s003_KiaraDate_a85a021e:

    # mc "Pero... ¿no hay beso para mí?"
    mc "Mas... não há um beijo para mim?"

# game/scripts/c21/c21.rpy:1821
translate brazilian c21s003_KiaraDate_2b7a744e:

    # kia "¿Delante de la biblioteca? Es mi puesto de trabajo... Y Gen conoce a Solomon... y..."
    kia "Em frente à biblioteca? É meu local de trabalho... E Gen conhece Solomon... e..."

# game/scripts/c21/c21.rpy:1822
translate brazilian c21s003_KiaraDate_24a6a742:

    # mc "No te preocupes. Será duro, pero lo entiendo y puedo esperar a cuando llegues a casa."
    mc "Não se preocupe. Vai ser difícil, mas eu entendo e posso esperar até você chegar em casa."

# game/scripts/c21/c21.rpy:1823
translate brazilian c21s003_KiaraDate_ab0752d3:

    # mc "No me gustan los secretos, pero entiendo que no quieras hacer público lo nuestro aún, hasta que se resuelva lo de Solomon."
    mc "Eu não gosto de segredos, mas entendo que você não queira tornar nosso relacionamento público ainda, até que a situação com Solomon esteja resolvida."

# game/scripts/c21/c21.rpy:1825
translate brazilian c21s003_KiaraDate_f0fc850c:

    # kia "No es que no quiera hacerlo público. Me da lo mismo que la gente sepa que Solomon y yo hemos roto. No voy a volver con él nunca."
    kia "Não é que eu não queira tornar isso público. Não me importo se as pessoas souberem que Solomon e eu terminamos. Nunca mais voltarei com ele."

# game/scripts/c21/c21.rpy:1826
translate brazilian c21s003_KiaraDate_cce4706b:

    # kia "Pero hace una semana estaba con él y ahora estoy contigo... todo el mundo va a pensar que soy... una zorra que se ha ido con un hombre más joven."
    kia "Mas há uma semana eu estava com ele e agora estou com você... todo mundo vai pensar que eu sou... uma vadia que fugiu com um homem mais novo."

# game/scripts/c21/c21.rpy:1828
translate brazilian c21s003_KiaraDate_0efd211a:

    # mc "[kia], escúchame. En casa podremos repetir lo de anoche si quieres. Te dije que no teníamos que hacer nada que no quisieras hacer"
    mc "[kia], escute-me. Podemos repetir o que fizemos ontem à noite em casa, se você quiser. Eu disse que não precisávamos fazer nada que você não quisesse."

# game/scripts/c21/c21.rpy:1829
translate brazilian c21s003_KiaraDate_d1a401c8:

    # mc "Y si una de las cosas que no quieres hacer es que te bese delante de la biblioteca, no hay ningún problema."
    mc "E se uma das coisas que você não quer é que ele te beije em frente à biblioteca, tudo bem."

# game/scripts/c21/c21.rpy:1831
translate brazilian c21s003_KiaraDate_63650acf:

    # mc "No quiero estropear nuestra primera... o segunda cita... por una nimiedad como esta."
    mc "Não quero estragar nosso primeiro... ou segundo encontro... por algo tão trivial."

# game/scripts/c21/c21.rpy:1832
translate brazilian c21s003_KiaraDate_e36381cf:

    # mc "Estás preciosa, me encanta lo que te has hecho en el pelo y ese color de pintalabios te favorece mucho."
    mc "Você está linda, adorei o que você fez com o cabelo e essa cor de batom combina muito com você."

# game/scripts/c21/c21.rpy:1833
translate brazilian c21s003_KiaraDate_eabac296:

    # mc "Voy a tener muchas ocasiones de comerme ese pintalabios, pero sólo si no lo estropeamos hoy."
    mc "Terei muitas oportunidades de comer esse batom, mas só se não o estragarmos hoje."

# game/scripts/c21/c21.rpy:1835
translate brazilian c21s003_KiaraDate_60bfadf0:

    # mc "¿Te parece bien si vamos a comer? Mi idea de una cita no es discutir con una preciosa mujer en la calle ni hacerla sentir mal."
    mc "Você gostaria de ir jantar? Minha ideia de um encontro não é discutir com uma mulher bonita na rua ou fazê-la se sentir mal."

# game/scripts/c21/c21.rpy:1836
translate brazilian c21s003_KiaraDate_7e6a20e0:

    # kia "Vamos... pero no creas que te va a ser fácil estropear hoy. Y menos si, como {b}casi{/b} siempre, aciertas en lo que tienes que decir."
    kia "Vamos lá... mas não pense que vai ser fácil estragar tudo hoje. Principalmente se, como {b}quase{/b}sempre, você acertar no que tem a dizer."

# game/scripts/c21/c21.rpy:1837
translate brazilian c21s003_KiaraDate_f4d8ef39:

    # mc "*Risa* Es un defecto con el que tendrás que lidiar. No acierto siempre, pero sí las suficientes veces."
    mc "*Risos* É uma falha com a qual você terá que lidar. Eu nem sempre acerto, mas acerto com frequência suficiente."

# game/scripts/c21/c21.rpy:1839
translate brazilian c21s003_KiaraDate_44d2b74e:

    # mc "Vamos antes de que se haga más tarde."
    mc "Vamos embora antes que fique muito tarde."

# game/scripts/c21/c21.rpy:1842
translate brazilian c21s003_KiaraDate_040b5c5b:

    # mc "No sé por qué no me imaginé que sería una pizzería, habiéndolo recomendado Tía [bet]."
    mc "Não sei por que não imaginei que seria uma pizzaria, já que foi recomendado pela tia [bet]."

# game/scripts/c21/c21.rpy:1843
translate brazilian c21s003_KiaraDate_86dbd28c:

    # kia "*Risa* ¿De verdad es tan adicta a la pizza?"
    kia "*Risos* Ela é mesmo tão viciada em pizza?"

# game/scripts/c21/c21.rpy:1844
translate brazilian c21s003_KiaraDate_fb71eec9:

    # mc "*Risa* Supongo que la gula es el único pecado que se permite. ¿Y qué mejor que cometerlo con pizza?"
    mc "*Risos* Acho que a gula é o único pecado permitido. E que melhor maneira de se deliciar do que com pizza?"

# game/scripts/c21/c21.rpy:1846
translate brazilian c21s003_KiaraDate_b424f89a:

    # "Después de que el camarero os siente en una mesa no tan apartada como te hubiera gustado..."
    "Depois que o garçom te acomoda em uma mesa que não é tão reservada quanto você gostaria..."

# game/scripts/c21/c21.rpy:1847
translate brazilian c21s003_KiaraDate_2095de9e:

    # mc "¿Qué te apetece comer?"
    mc "O que você está com vontade de comer?"

# game/scripts/c21/c21.rpy:1848
translate brazilian c21s003_KiaraDate_2061c43f:

    # kia "Si por mí fuera, haría como [bet] y pediría una pizza, pero entre el tiempo que van a tardar y lo lenta que soy comiendo, la cita no daría para nada más."
    kia "Se dependesse de mim, eu faria o que [bet] fez e pediria uma pizza, mas entre o tempo que levaria e a minha lentidão para comer, o encontro não permitiria outra opção."

# game/scripts/c21/c21.rpy:1849
translate brazilian c21s003_KiaraDate_c5db446e:

    # kia "Con lo que creo que pediré esta ensalada. Tiene buena pinta."
    kia "Então acho que vou pedir essa salada. Parece boa."

# game/scripts/c21/c21.rpy:1850
translate brazilian c21s003_KiaraDate_977aa4a9:

    # mc "¿Tienes algún plan para después de comer?"
    mc "Você tem algum plano para depois do almoço?"

# game/scripts/c21/c21.rpy:1854
translate brazilian c21s003_KiaraDate_c279c58a:

    # kia "Había pensado en dar un paseo antes de volver a la biblioteca... si te apetece."
    kia "Estava pensando em dar uma caminhada antes de voltar para a biblioteca... se você quiser."

# game/scripts/c21/c21.rpy:1855
translate brazilian c21s003_KiaraDate_9d638618:

    # mc "Me encantan los paseos contigo. *Risa* Pero no podremos hacer tantas pausas como anoche."
    mc "Adoro passear com você. *Risos* Mas não vamos poder fazer tantas pausas como ontem à noite."

# game/scripts/c21/c21.rpy:1857
translate brazilian c21s003_KiaraDate_4cb0af9f:

    # kia "*Risa* No me refería a ese tipo de paseo."
    kia "*Risos* Eu não estava me referindo a esse tipo de caminhada."

# game/scripts/c21/c21.rpy:1858
translate brazilian c21s003_KiaraDate_4db7ab3b:

    # mc "Lo sé. *Risa* Que sean dos ensaladas, pero no le digas a [mar] que he pedido una ensalada en un restaurante."
    mc "Eu sei. *Risos* Que sejam duas saladas, mas não conte para [mar] que eu pedi uma salada em um restaurante."

# game/scripts/c21/c21.rpy:1860
translate brazilian c21s003_KiaraDate_974b0be7:

    # kia "*Risa* ¿Por qué?"
    kia "*Risos* Por quê?"

# game/scripts/c21/c21.rpy:1861
translate brazilian c21s003_KiaraDate_46df123c:

    # mc "No te creería. *Risa* ¿Pagar por algo verde? Orégano o albahaca, sí. Lechuga, quizás, dentro de una hamburguesa. Broccoli, nunca."
    mc "Eu não acreditaria em você. *Risos* Pagar por algo verde? Orégano ou manjericão, sim. Alface, talvez, dentro de um hambúrguer. Brócolis, jamais."

# game/scripts/c21/c21.rpy:1863
translate brazilian c21s003_KiaraDate_75b5078a:

    # kia "*Risa* Si fueras hijo mío comerías de todo."
    kia "*Risos* Se você fosse meu filho, comeria tudo."

# game/scripts/c21/c21.rpy:1864
translate brazilian c21s003_KiaraDate_9bf7c2c9:

    # mc "*Risa* Prefiero ser tu novio y olvidarme del broccoli."
    mc "*Risos* Prefiro ser seu namorado e esquecer o brócolis."

# game/scripts/c21/c21.rpy:1866
translate brazilian c21s003_KiaraDate_890574b6:

    # kia "Yo también... A lo del novio. No tengo ningún problema con el broccoli."
    kia "Eu também... Sobre o namorado. Não tenho problema nenhum com brócolis."

# game/scripts/c21/c21.rpy:1868
translate brazilian c21s003_KiaraDate_bae6e3a4:

    # mc "Te cedo mi parte de la producción mundial de broccoli. *Risa* Para que veas que tienes un novio generoso."
    mc "Estou te dando a minha parte da produção mundial de brócolis. *Risos* Então você pode ver que tem um namorado generoso."

# game/scripts/c21/c21.rpy:1870
translate brazilian c21s003_KiaraDate_6c944c47:

    # kia "*Risa* Es super generoso de tu parte."
    kia "*Risos* Isso é muito generoso da sua parte."

# game/scripts/c21/c21.rpy:1871
translate brazilian c21s003_KiaraDate_13c4ada8:

    # mc "¿Sabes que me encanta verte reír?"
    mc "Você sabe que eu adoro te ver rir?"

# game/scripts/c21/c21.rpy:1873
translate brazilian c21s003_KiaraDate_1fa740fc:

    # kia "Gracias, pero ¿sabes que [eil] me habló de tu costumbre de intentar ruborizarla?"
    kia "Obrigado, mas você sabia que [eil] me contou sobre seu hábito de tentar fazê-la corar?"

# game/scripts/c21/c21.rpy:1874
translate brazilian c21s003_KiaraDate_ed8042b5:

    # mc "*Risa* ¡Maldita chivata!"
    mc "*Risos* Maldito dedo-duro!"

# game/scripts/c21/c21.rpy:1876
translate brazilian c21s003_KiaraDate_31f7727d:

    # kia "¡Devuelve esa mano ahí ahora mismo!"
    kia "Devolva essa mão agora mesmo!"

# game/scripts/c21/c21.rpy:1877
translate brazilian c21s003_KiaraDate_66e26340:

    # mc "*Risa* ¡A tus órdenes!"
    mc "*Risos* Às suas ordens!"

# game/scripts/c21/c21.rpy:1880
translate brazilian c21s003_KiaraDate_82e507c2:

    # kia "*Risa* Ahora que las dos salimos contigo, me ha dado algunos consejos. Y me ha explicado algunos de tus trucos para hacerla sentir bien."
    kia "*Risos* Agora que nós duas estamos namorando com você, ela me deu alguns conselhos. E me explicou alguns dos seus truques para fazê-la se sentir bem."

# game/scripts/c21/c21.rpy:1882
translate brazilian c21s003_KiaraDate_04b2472b:

    # kia "*Risa* Me ha explicado muchas cosas de cuando salíais juntos. Supongo que quería ponerme en sobre aviso sobre tus viejos trucos para hacerla sentir bien."
    kia "*Risos* Ela me contou muitas coisas sobre a época em que vocês dois namoravam. Acho que ela queria me alertar sobre seus antigos truques para fazê-la se sentir bem."

# game/scripts/c21/c21.rpy:1883
translate brazilian c21s003_KiaraDate_44dc4434:

    # mc "*Risa* Tendré que encontrar trucos nuevos, entonces. La compañía los merece."
    mc "*Risos* Vou ter que descobrir alguns truques novos, então. A empresa merece."

# game/scripts/c21/c21.rpy:1885
translate brazilian c21s003_KiaraDate_1432e0f3:

    # kia "¿Puedo serte sincera?"
    kia "Posso ser sincero com você?"

# game/scripts/c21/c21.rpy:1886
translate brazilian c21s003_KiaraDate_28927394:

    # mc "Siempre."
    mc "Sempre."

# game/scripts/c21/c21.rpy:1888
translate brazilian c21s003_KiaraDate_0578fcb0:

    # kia "Si lo que dices es sincero, no me importa que se lo hayas dicho con anterioridad a mi hija. O a otras mujeres."
    kia "Se o que você está dizendo é sincero, não me importo que já tenha dito isso à minha filha antes. Ou a outras mulheres."

# game/scripts/c21/c21.rpy:1889
translate brazilian c21s003_KiaraDate_4ab6eb4e:

    # kia "No quiero que digas cosas que no sientes sólo para hacerme sentir bien, pero tampoco necesito que inventes frases bonitas cada día."
    kia "Não quero que você diga coisas que não quer dizer só para me fazer sentir bem, mas também não preciso que você invente frases bonitas todos os dias."

# game/scripts/c21/c21.rpy:1890
translate brazilian c21s003_KiaraDate_abe63749:

    # kia "Si sientes realmente lo que dices, me va a gustar igualmente."
    kia "Se você realmente estiver falando sério, eu vou gostar de qualquer maneira."

# game/scripts/c21/c21.rpy:1891
translate brazilian c21s003_KiaraDate_95e51857:

    # mc "Entendido. Entonces... ¿Sabes que me encanta verte reír? *Risa*"
    mc "Entendi. Então... você sabe que eu adoro te ver rir? *Risos*"

# game/scripts/c21/c21.rpy:1893
translate brazilian c21s003_KiaraDate_1e2e1528:

    # kia "*Risa* ¡Idiota!"
    kia "*Risos* Idiota!"

# game/scripts/c21/c21.rpy:1894
translate brazilian c21s003_KiaraDate_a77e5548:

    # mc "*Risa* ¡Hey! Has dicho que podía repetir cosas si era sincero. Y lo he sido. Me encanta verte reír."
    mc "*Risos* Ei! Você disse que eu podia repetir as coisas se fosse sincera. E eu tenho sido. Adoro te ver rir."

# game/scripts/c21/c21.rpy:1896
translate brazilian c21s003_KiaraDate_12adb927:

    # kia "Y a mí me encanta que me hagas reír..."
    kia "E eu adoro quando você me faz rir..."

# game/scripts/c21/c21.rpy:1898
translate brazilian c21s003_KiaraDate_b85e53b2:

    # kia "Es tan diferente a cuando iba a comer con Solomon..."
    kia "É tão diferente de quando eu costumava sair para jantar com Solomon..."

# game/scripts/c21/c21.rpy:1899
translate brazilian c21s003_KiaraDate_04f1bee2:

    # mc "¿Solomon? ¿Quién es Solomon? El nombre me suena. Algo de partir un bebé por la mitad, ¿no?"
    mc "Salomão? Quem é Salomão? O nome me soa familiar. Tem algo a ver com cortar um bebê ao meio, não é?"

# game/scripts/c21/c21.rpy:1900
translate brazilian c21s003_KiaraDate_0e916f4b:

    # mc "Pero no eres tan mayor como para haber ido a comer con él... *Risa*"
    mc "Mas você não tem idade suficiente para ter almoçado com ele... *Risos*"

# game/scripts/c21/c21.rpy:1902
translate brazilian c21s003_KiaraDate_0c1f5e70:

    # kia "*Risa* Realmente eres idiota. Me acabas de llamar vieja en nuestra segunda cita."
    kia "*Risos* Você é mesmo um idiota. Me chamou de velha logo no nosso segundo encontro."

# game/scripts/c21/c21.rpy:1903
translate brazilian c21s003_KiaraDate_0f5ad404:

    # mc "¡Oops! El chiste se me ha ido de las manos."
    mc "Ops! Essa piada saiu do controle."

# game/scripts/c21/c21.rpy:1905
translate brazilian c21s003_KiaraDate_c96dfcd9:

    # kia "Sé que no está bien que hable de él en una cita contigo y prometo que será la última vez que lo haga."
    kia "Eu sei que não é certo falar dele num encontro com você, e prometo que será a última vez que farei isso."

# game/scripts/c21/c21.rpy:1906
translate brazilian c21s003_KiaraDate_04e443a7:

    # kia "Con él siempre tenía que estar alerta para no decir algo que le molestara."
    kia "Com ele, eu sempre tinha que ficar em alerta para não dizer nada que o chateasse."

# game/scripts/c21/c21.rpy:1907
translate brazilian c21s003_KiaraDate_98d3c2c0:

    # kia "Para que no bebiera demasiado."
    kia "Para que ele não bebesse demais."

# game/scripts/c21/c21.rpy:1908
translate brazilian c21s003_KiaraDate_f8e57f27:

    # kia "Para que no montara un espectáculo si algún hombre me miraba..."
    kia "Para que eu não causasse escândalo se algum homem olhasse para mim..."

# game/scripts/c21/c21.rpy:1909
translate brazilian c21s003_KiaraDate_ed80e219:

    # mc "Lo entiendo, no tenía que ser cómodo."
    mc "Entendo, não precisava ser confortável."

# game/scripts/c21/c21.rpy:1911
translate brazilian c21s003_KiaraDate_3bb71433:

    # kia "No, no lo era. Y a eso me refiero con que esto es diferente."
    kia "Não, não foi. E é isso que quero dizer quando afirmo que isto é diferente."

# game/scripts/c21/c21.rpy:1912
translate brazilian c21s003_KiaraDate_655cfbf9:

    # kia "Contigo, lo único que tengo que temer es no poder resistir las ganas de besarte en medio del restaurante."
    kia "Com você, a única coisa que tenho a temer é não conseguir resistir à vontade de te beijar no meio do restaurante."

# game/scripts/c21/c21.rpy:1913
translate brazilian c21s003_KiaraDate_4613651e:

    # kia "Me haces sentir... relajada."
    kia "Você me faz sentir... relaxado(a)."

# game/scripts/c21/c21.rpy:1914
translate brazilian c21s003_KiaraDate_15014567:

    # mc "Solomon es una de las personas a las que no me gustaría parecerme. Si alguna vez empiezo a comportarme como él, avísame para dejar de hacerlo."
    mc "Salomão é uma daquelas pessoas com quem eu não gostaria de me parecer. Se algum dia eu começar a me comportar como ele, me avise para que eu possa parar."

# game/scripts/c21/c21.rpy:1916
translate brazilian c21s003_KiaraDate_dcfcb449:

    # kia "Los dos respiráis. *Risa* Creo que ahí acaban las similitudes."
    kia "Vocês dois respiram. *Risos* Acho que as semelhanças param por aí."

# game/scripts/c21/c21.rpy:1917
translate brazilian c21s003_KiaraDate_726e8e80:

    # mc "*Risa* Y, en mi caso, no lo considero un desperdicio de oxígeno."
    mc "*Risos* E, no meu caso, não considero isso um desperdício de oxigênio."

# game/scripts/c21/c21.rpy:1918
translate brazilian c21s003_KiaraDate_5b0f932d:

    # kia "*Risa* No, no lo es."
    kia "*Risos* Não, não é."

# game/scripts/c21/c21.rpy:1920
translate brazilian c21s003_KiaraDate_d84d6fa3:

    # mc "¿Puedes pedir la ensalada de pasta y un agua con gas para mí? Tengo que ir al lavabo."
    mc "Pode pedir a salada de massa e uma água com gás para mim? Preciso ir ao banheiro."

# game/scripts/c21/c21.rpy:1921
translate brazilian c21s003_KiaraDate_fae66d88:

    # kia "¿Ensalada de pasta? Habías dicho algo verde..."
    kia "Salada de massa? Você disse algo verde..."

# game/scripts/c21/c21.rpy:1922
translate brazilian c21s003_KiaraDate_9ae059ac:

    # mc "La pasta en la ensalada es verde, roja, y blanca. *Risa* No esperabas que pidiera lechuga o endivias, ¿verdad?"
    mc "A massa da salada é verde, vermelha e branca. *Risos* Você não esperava que eu pedisse alface ou endívias, né?"

# game/scripts/c21/c21.rpy:1923
translate brazilian c21s003_KiaraDate_d93fd5d3:

    # mc "Paso a paso..."
    mc "Passo a passo..."

# game/scripts/c21/c21.rpy:1925
translate brazilian c21s003_KiaraDate_4bb7ff47:

    # kia "*Risa* Vale, aceptaré pasta verde como ensalada. Creo que lleva una ínfima porción de espinacas."
    kia "*Risos* Ok, eu aceito macarrão verde como salada. Acho que tem um pouquinho de espinafre."

# game/scripts/c21/c21.rpy:1926
translate brazilian c21s003_KiaraDate_802c91c8:

    # mc "Suficiente para mí."
    mc "Isso me basta."

# game/scripts/c21/c21.rpy:1928
translate brazilian c21s003_KiaraDate_c65d2a7d:

    # "Sorprendes a [kia] con un beso antes de ir al lavabo. La sorpresa inicial pasa en seguida."
    "Você surpreende [kia] com um beijo antes de ir ao banheiro. A surpresa inicial desaparece rapidamente."

# game/scripts/c21/c21.rpy:1930
translate brazilian c21s003_KiaraDate_f74dc452:

    # kia "Pero..."
    kia "Mas..."

# game/scripts/c21/c21.rpy:1931
translate brazilian c21s003_KiaraDate_423d8675:

    # mc "Luego, cielo. *Risa* Tengo que ir al lavabo."
    mc "Então, querida. *Risos* Preciso ir ao banheiro."

# game/scripts/c21/c21.rpy:1932
translate brazilian c21s003_KiaraDate_debea350:

    # mc "Y esto no es la puerta de la biblioteca."
    mc "E esta não é a porta da biblioteca."

# game/scripts/c21/c21.rpy:1934
translate brazilian c21s003_KiaraDate_8365c687:

    # mc "Ya estoy de vuelta. ¿Han tomado nota?"
    mc "Voltei. Notaram?"

# game/scripts/c21/c21.rpy:1935
translate brazilian c21s003_KiaraDate_45d0364b:

    # kia "Sí. No tenían la ensalada de pasta y te he pedido un combo de lechugas y espinacas."
    kia "Sim. Eles não tinham salada de macarrão, então eu pedi uma mistura de alface e espinafre."

# game/scripts/c21/c21.rpy:1936
translate brazilian c21s003_KiaraDate_27c68bcf:

    # mc "*Risa* Un restaurante italiano sin pasta. ¿Se está acabando el mundo?"
    mc "*Risos* Um restaurante italiano sem massa. O mundo está acabando?"

# game/scripts/c21/c21.rpy:1938
translate brazilian c21s003_KiaraDate_9acb8625:

    # kia "*Risa* Estoy bromeando. He pedido tu ensalada rebosante de calorías."
    kia "*Risos* Estou brincando. Eu pedi a sua salada cheia de calorias."

# game/scripts/c21/c21.rpy:1939
translate brazilian c21s003_KiaraDate_7cb16a11:

    # kia "Pero te hubieras merecido la lechuga por ese beso a traición. *Risa*"
    kia "Mas você mereceu a alface por aquele beijo furtivo. *Risos*"

# game/scripts/c21/c21.rpy:1940
translate brazilian c21s003_KiaraDate_e24315f5:

    # mc "Era para que pudieras soportar mejor las ganas de besarme en medio del restaurante. Ahora te puedes relajar aún más."
    mc "Foi para que você resistisse melhor à tentação de me beijar no meio do restaurante. Agora você pode relaxar ainda mais."

# game/scripts/c21/c21.rpy:1942
translate brazilian c21s003_KiaraDate_a982092f:

    # kia "A ti nadie te ha dicho nunca que besas muy bien, ¿verdad?"
    kia "Ninguém nunca te disse que você beija muito bem, né?"

# game/scripts/c21/c21.rpy:1943
translate brazilian c21s003_KiaraDate_640090e0:

    # mc "Si te soy sincero, me lo han dicho alguna vez. No preguntes quién."
    mc "Para ser sincero, já me disseram isso antes. Não pergunte quem."

# game/scripts/c21/c21.rpy:1945
translate brazilian c21s003_KiaraDate_3718abcf:

    # kia "*Risa* Era una pregunta retórica, idiota. Sé que [eil] te lo ha dicho muchas veces. Alguna vez incluso la oí decírtelo."
    kia "*Risos* Era uma pergunta retórica, seu idiota. Eu sei que a [eil] já te disse isso várias vezes. Eu até ouvi ela te dizer isso uma vez."

# game/scripts/c21/c21.rpy:1947
translate brazilian c21s003_KiaraDate_7bf62b15:

    # kia "¿Tú crees que un beso como ese va a quitarme las ganas de darte más?"
    kia "Você acha que um beijo desses vai tirar meu desejo de te dar mais?"

# game/scripts/c21/c21.rpy:1948
translate brazilian c21s003_KiaraDate_99ca66d3:

    # mc "Espero que no. Me gusta el sabor de ese pintalabios."
    mc "Espero que não. Eu gosto do gosto desse batom."

# game/scripts/c21/c21.rpy:1950
translate brazilian c21s003_KiaraDate_5b59703b:

    # kia "¡Dios mío! ¿Qué he hecho yo para merecer un idiota como este?"
    kia "Meu Deus! O que eu fiz para merecer um idiota desses?"

# game/scripts/c21/c21.rpy:1951
translate brazilian c21s003_KiaraDate_c1c083cd:

    # mc "Soy el premio por ser una mujer maravillosa. *Risa* Y no se aceptan devoluciones."
    mc "Eu sou o prêmio por ser uma mulher maravilhosa. *Risos* E sem reembolso."

# game/scripts/c21/c21.rpy:1953
translate brazilian c21s003_KiaraDate_4feb9baa:

    # kia "*Risa* No pensaba devolverte a fábrica. No eres {b}tan{/b} defectuoso."
    kia "*Risos* Eu não estava planejando te mandar de volta para a fábrica. Você não é tão defeituoso assim."

# game/scripts/c21/c21.rpy:1954
translate brazilian c21s003_KiaraDate_ca2064ab:

    # mc "*Risa* No sé si ofenderme o tomármelo como un cumplido..."
    mc "*Risos* Não sei se devo me sentir ofendido ou levar como um elogio..."

# game/scripts/c21/c21.rpy:1956
translate brazilian c21s003_KiaraDate_37786e99:

    # "Cuando traen vuestras dos ensaladas (y sí, una ensalada de pasta {b}es{/b} una ensalada) empieza una comida llena de risas."
    "Quando trazem suas duas saladas (e sim, uma salada de macarrão {b}é{/b} uma salada), começa uma refeição repleta de risadas."

# game/scripts/c21/c21.rpy:1957
translate brazilian c21s003_KiaraDate_5eb6f5b9:

    # "[kia] está relajada y os lo pasáis bien. Habláis de todo y de nada."
    "[kia] está relaxado e você está se divertindo. Vocês conversam sobre tudo e sobre nada."

# game/scripts/c21/c21.rpy:1958
translate brazilian c21s003_KiaraDate_6638e4f2:

    # "Habláis de su trabajo, del dormitorio, y de NTR."
    "Você fala sobre o trabalho dele, o quarto e NTR."

# game/scripts/c21/c21.rpy:1959
translate brazilian c21s003_KiaraDate_38379001:

    # "Charláis sobre [eil] y del resto de las mujeres de la familia."
    "Você conversa sobre [eil] e o resto das mulheres da família."

# game/scripts/c21/c21.rpy:1960
translate brazilian c21s003_KiaraDate_3bff8f4a:

    # "Habláis de vosotros."
    "Vocês falam sobre si mesmos."

# game/scripts/c21/c21.rpy:1961
translate brazilian c21s003_KiaraDate_f44433f0:

    # "Pero, sobre todo, os reís mucho. Os reís de todo. De ti y de ella. Del mundo."
    "Mas acima de tudo, você ri muito. Você ri de tudo. De você e dela. Do mundo."

# game/scripts/c21/c21.rpy:1963
translate brazilian c21s003_KiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1964
translate brazilian c21s003_KiaraDate_7a14f67a:

    # mc "Tengo que cogerlo, [kia]. Es [ama]. Dame un segundo."
    mc "Preciso pegar, [kia]. É [ama]. Só um segundo."

# game/scripts/c21/c21.rpy:1965
translate brazilian c21s003_KiaraDate_5b2bdc80:

    # kia "Todo el tiempo que necesites."
    kia "Todo o tempo que você precisar."

# game/scripts/c21/c21.rpy:1966
translate brazilian c21s003_KiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Olá, [ama]. Posso te ajudar em alguma coisa?"

# game/scripts/c21/c21.rpy:1968
translate brazilian c21s003_KiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Só queria te lembrar que tínhamos combinado de tomar um café hoje para discutir minhas ideias sobre NTR. Que horário seria bom para você?"

# game/scripts/c21/c21.rpy:1969
translate brazilian c21s003_KiaraDate_dabe8d4e:

    # mc "Estoy comiendo con [kia]. ¿En una hora y media te va bien?"
    mc "Vou almoçar com [kia]. Uma hora e meia está bom para você?"

# game/scripts/c21/c21.rpy:1970
translate brazilian c21s003_KiaraDate_7df02780:

    # kia "Puedes quedar antes. En 30 minutos tengo que estar de vuelta en la biblioteca."
    kia "Podemos nos encontrar mais cedo. Preciso estar de volta à biblioteca em 30 minutos."

# game/scripts/c21/c21.rpy:1972
translate brazilian c21s003_KiaraDate_aa011d24:

    # ama "La he escuchado. Te mando la dirección de un café que tienes cerca y podemos quedar allí. ¿En una hora?"
    ama "Eu a ouvi. Vou te mandar o endereço de um café perto de você e podemos nos encontrar lá. Daqui a uma hora?"

# game/scripts/c21/c21.rpy:1973
translate brazilian c21s003_KiaraDate_4890fe3f:

    # mc "Genial. Te veo en una hora. Hasta dentro de un rato."
    mc "Ótimo. Te vejo daqui a uma hora. Até mais."

# game/scripts/c21/c21.rpy:1974
translate brazilian c21s003_KiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Até agora, [mc]."

# game/scripts/c21/c21.rpy:1976
translate brazilian c21s003_KiaraDate_f8b86bf9:

    # mc "¿Por dónde íbamos?"
    mc "Onde estávamos?"

# game/scripts/c21/c21.rpy:1977
translate brazilian c21s003_KiaraDate_e9290c40:

    # kia "Íbamos por el momento en que pido la cuenta y nos vamos a dar ese paseo antes de que se haga más tarde."
    kia "Chegamos ao ponto em que pedi a conta e fomos dar aquela caminhada antes que ficasse muito tarde."

# game/scripts/c21/c21.rpy:1978
translate brazilian c21s003_KiaraDate_dfdeb562:

    # mc "De acuerdo, pero la cuenta la pido yo. Fui yo quien te invitó a comer. Pago yo."
    mc "Tudo bem, mas vou pedir a conta. Fui eu quem te convidou para almoçar. Eu pago."

# game/scripts/c21/c21.rpy:1980
translate brazilian c21s003_KiaraDate_f74dc452_1:

    # kia "Pero..."
    kia "Mas..."

# game/scripts/c21/c21.rpy:1981
translate brazilian c21s003_KiaraDate_41aa0cb0:

    # mc "Si quieres pagar tú, vas a tener que invitarme tú a comer. Un trato es un trato."
    mc "Se você quiser pagar, terá que me convidar para almoçar. Combinado é combinado."

# game/scripts/c21/c21.rpy:1982
translate brazilian c21s003_KiaraDate_23f26bfb:

    # mc "Y así es como se consigue una tercera cita. *Risa*"
    mc "E é assim que se consegue um terceiro encontro. *Risos*"

# game/scripts/c21/c21.rpy:1984
translate brazilian c21s003_KiaraDate_9a370fb8:

    # kia "Vale, pero la próxima vez será para cenar. Tener que volver al trabajo con prisa no es lo mejor... para una tercera cita."
    kia "Tudo bem, mas da próxima vez será para jantar. Ter que voltar correndo para o trabalho não é o ideal... para um terceiro encontro."

# game/scripts/c21/c21.rpy:1985
translate brazilian c21s003_KiaraDate_ce722ab8:

    # mc "Aún tenemos tiempo para ese paseo. Has dicho que tienes que volver en 30 minutos. Que ya deben ser 28."
    mc "Ainda temos tempo para aquela caminhada. Você disse que precisa voltar em 30 minutos. Já devem ser 28 agora."

# game/scripts/c21/c21.rpy:1986
translate brazilian c21s003_KiaraDate_15e51949:

    # mc "Déjame ir al mostrador a pagar, así ganaremos un par de minutos."
    mc "Deixe-me ir ao caixa para pagar, assim economizaremos alguns minutos."

# game/scripts/c21/c21.rpy:1988
translate brazilian c21s003_KiaraDate_6bc7f6ee:

    # "Menos de diez minutos después, en un parque cercano..."
    "Menos de dez minutos depois, em um parque próximo..."

# game/scripts/c21/c21.rpy:1989
translate brazilian c21s003_KiaraDate_15fe2d35:

    # kia "Y aquí es dónde vengo a comerme los perritos calientes cuando tengo que comer sola. Un libro y mi perrito."
    kia "E é aqui que venho comer cachorro-quente quando tenho que comer sozinha. Um livro e meu cachorrinho."

# game/scripts/c21/c21.rpy:1990
translate brazilian c21s003_KiaraDate_893e09f7:

    # mc "Lo sé. Vinimos con [sca], en vuestro primer día en casa."
    mc "Eu sei. Viemos com [sca], no seu primeiro dia em casa."

# game/scripts/c21/c21.rpy:1992
translate brazilian c21s003_KiaraDate_6ca23feb:

    # kia "¡Es verdad! ¡Parece que hace un mes!"
    kia "É verdade! Parece que foi ontem!"

# game/scripts/c21/c21.rpy:1993
translate brazilian c21s003_KiaraDate_a5e89514:

    # mc "Mañana hace una semana, [kia]."
    mc "Amanhã faz uma semana, [kia]."

# game/scripts/c21/c21.rpy:1995
translate brazilian c21s003_KiaraDate_f4962993:

    # kia "Lo sé. Parece increíble que en una semana mi vida haya dado este vuelco."
    kia "Eu sei. Parece incrível que em apenas uma semana minha vida tenha dado uma guinada tão grande."

# game/scripts/c21/c21.rpy:1996
translate brazilian c21s003_KiaraDate_073db8a4:

    # mc "Pero ¿estás contenta de que lo haya dado?"
    mc "Mas você está feliz por ele ter desistido?"

# game/scripts/c21/c21.rpy:1998
translate brazilian c21s003_KiaraDate_a9728b22:

    # kia "No te puedes imaginar cuánto. Y no me refiero sólo a estar contigo. Es todo. Me siento libre por primera vez en años."
    kia "Você não imagina o quanto. E não me refiro apenas a estar com você. É tudo. Me sinto livre pela primeira vez em anos."

# game/scripts/c21/c21.rpy:1999
translate brazilian c21s003_KiaraDate_30454c6e:

    # kia "¿Te acuerdas hace unos días, cuando te dije que teníais un castillo precioso como hogar y todas esas tonterías?"
    kia "Você se lembra de alguns dias atrás, quando eu lhe disse que você tinha um lindo castelo como lar e todas aquelas bobagens?"

# game/scripts/c21/c21.rpy:2000
translate brazilian c21s003_KiaraDate_924e117b:

    # mc "Fue ayer, [kia]. Estábamos en la piscina, durante la fiesta de cumpleaños."
    mc "Foi ontem, [kia]. Estávamos na piscina, durante a festa de aniversário."

# game/scripts/c21/c21.rpy:2002
translate brazilian c21s003_KiaraDate_fb9a12a4:

    # kia "¿Ayer? ¿No te lo dije durante la comida con [ama]? Se me mezclan los días... todo ha sido tan intenso..."
    kia "Ontem? Eu não te contei durante o almoço com [ama]? Minha cabeça está toda confusa... tudo tem sido tão intenso..."

# game/scripts/c21/c21.rpy:2003
translate brazilian c21s003_KiaraDate_4c34fbdb:

    # mc "*Risa* Durante la comida con [ama] es cuando saliste corriendo. Eso fue anteayer."
    mc "*Risos* Foi durante o almoço com [ama] que você fugiu. Isso foi anteontem."

# game/scripts/c21/c21.rpy:2004
translate brazilian c21s003_KiaraDate_5de9aba8:

    # kia "Me estoy volviendo loca. Todo parece que haya pasado hace muchísimo..."
    kia "Estou ficando louco. Parece que tudo aconteceu há uma eternidade..."

# game/scripts/c21/c21.rpy:2006
translate brazilian c21s003_KiaraDate_c4f7488d:

    # kia "Sentirme aceptada por la familia, besarte ayer... por la tarde... hablar con todas las chicas después de eso... y lo que pasó por la noche..."
    kia "Me sentir aceita pela família, te beijar ontem... à tarde... conversar com todas as meninas depois disso... e o que aconteceu ontem à noite..."

# game/scripts/c21/c21.rpy:2007
translate brazilian c21s003_KiaraDate_392d8bed:

    # kia "Yo llevaba una vida aburrida donde todos los días eran iguales..."
    kia "Eu levava uma vida monótona, onde todos os dias eram iguais..."

# game/scripts/c21/c21.rpy:2008
translate brazilian c21s003_KiaraDate_bf02bf81:

    # mc "En casa nunca hay tiempo para aburrirse. Te adaptaste a la familia. También te adaptarás a esto."
    mc "Em casa, nunca há tempo para ficar entediado. Você se adaptou à família. Você se adaptará a isso também."

# game/scripts/c21/c21.rpy:2010
translate brazilian c21s003_KiaraDate_50f0c08d:

    # kia "Lo sé, pero ahora mismo, la última semana es un torbellino de recuerdos."
    kia "Eu sei, mas neste momento, a última semana é um turbilhão de lembranças."

# game/scripts/c21/c21.rpy:2011
translate brazilian c21s003_KiaraDate_b1e79ea5:

    # kia "Llegar a casa, la fiesta en la playa, cuando fuimos a mi antigua casa, intentar evitarte, la fiesta de cumpleaños... el beso... y lo de anoche."
    kia "A volta para casa, a festa na praia, quando fomos à minha antiga casa, tentando te evitar, a festa de aniversário... o beijo... e ontem à noite."

# game/scripts/c21/c21.rpy:2013
translate brazilian c21s003_KiaraDate_5c0849e7:

    # kia "Que voy a ser abuela..."
    kia "Vou ser avó..."

# game/scripts/c21/c21.rpy:2014
translate brazilian c21s003_KiaraDate_3f92739f:

    # kia "Casi no puedo poner los recuerdos en el orden correcto."
    kia "Mal consigo colocar as lembranças na ordem correta."

# game/scripts/c21/c21.rpy:2016
translate brazilian c21s003_KiaraDate_3a5e5d9b:

    # kia "Y ni siquiera hace una semana..."
    kia "E nem sequer passou uma semana..."

# game/scripts/c21/c21.rpy:2017
translate brazilian c21s003_KiaraDate_d584132f:

    # mc "Te han pasado muchas cosas importantes en esta semana. Es normal. A veces a mí también me cuesta."
    mc "Muitas coisas importantes aconteceram com você esta semana. Isso é normal. Às vezes, eu também tenho dificuldade com isso."

# game/scripts/c21/c21.rpy:2018
translate brazilian c21s003_KiaraDate_afe9bcb6:

    # mc "Pero tengo una pregunta... Después del beso de ayer por la tarde, las chicas te secuestraron durante un buen rato. ¿Qué te dijeron?"
    mc "Mas eu tenho uma pergunta... Depois do beijo de ontem à tarde, as meninas te sequestraram por um bom tempo. O que elas te disseram?"

# game/scripts/c21/c21.rpy:2020
translate brazilian c21s003_KiaraDate_eb884940:

    # kia "*Risa* ¡Es una cosa entre chicas! Te puedo decir que todas me felicitaron por haber dejado atrás el pasado."
    kia "*Risos* É coisa de menina! Posso dizer que todas me parabenizaram por deixar o passado para trás."

# game/scripts/c21/c21.rpy:2021
translate brazilian c21s003_KiaraDate_86d4bac7:

    # kia "Algunas, aunque no te voy a decir quienes, me dieron consejos sobre ti."
    kia "Algumas pessoas, embora eu não vá dizer quem, me deram conselhos a seu respeito."

# game/scripts/c21/c21.rpy:2022
translate brazilian c21s003_KiaraDate_944522a8:

    # mc "*Risa* ¡Eso es injusto! ¿Habláis de mi a mis espaldas?"
    mc "*Risos* Isso é injusto! Você está falando de mim pelas costas?"

# game/scripts/c21/c21.rpy:2024
translate brazilian c21s003_KiaraDate_aafa9a2f:

    # kia "*Risa* Obviamente. Y duermo con [eil], que es quien más tiempo ha salido contigo."
    kia "*Risos* Obviamente. E eu durmo com [eil], que é quem namora com você há mais tempo."

# game/scripts/c21/c21.rpy:2025
translate brazilian c21s003_KiaraDate_2505296a:

    # kia "Ya te dije que se pasó buena parte de la noche hablándome de ti e intentando convencerme para..."
    kia "Eu já te disse que ele passou boa parte da noite falando comigo sobre você e tentando me convencer a..."

# game/scripts/c21/c21.rpy:2026
translate brazilian c21s003_KiaraDate_03f9afb6:

    # mc "Tengo que hablar con ella. No es lo que quería decir cuando le pedía ayuda."
    mc "Preciso falar com ela. Não era isso que eu queria dizer quando pedi ajuda a ela."

# game/scripts/c21/c21.rpy:2028
translate brazilian c21s003_KiaraDate_14d72b5c:

    # kia "Sin su insistencia, no hubiéramos hablado anoche en el pasillo ni en la piscina, ni hubiéramos paseado después. Ni estaríamos aquí hoy."
    kia "Sem a insistência dele, não teríamos conversado ontem à noite no corredor ou perto da piscina, nem teríamos saído para caminhar depois. Nem estaríamos aqui hoje."

# game/scripts/c21/c21.rpy:2029
translate brazilian c21s003_KiaraDate_333bdd8e:

    # kia "Ni podría hacer esto."
    kia "Eu também não conseguiria fazer isso."

# game/scripts/c21/c21.rpy:2031
translate brazilian c21s003_KiaraDate_791a31f8:

    # "[kia] te sorprende con un beso en los labios. Tierno y pasional a partes iguales."
    "[kia] te surpreende com um beijo nos lábios. Terno e apaixonado na mesma medida."

# game/scripts/c21/c21.rpy:2032
translate brazilian c21s003_KiaraDate_21d044b8:

    # "No es muy largo, pero puedes leer muchas cosas en él. Alivio, felicidad, esperanza..."
    "Não é muito longo, mas dá para ler muita coisa nele. Alívio, felicidade, esperança..."

# game/scripts/c21/c21.rpy:2034
translate brazilian c21s003_KiaraDate_c8dc03e3:

    # kia "Ya no aguantaba más."
    kia "Eu não aguentava mais."

# game/scripts/c21/c21.rpy:2035
translate brazilian c21s003_KiaraDate_e60234c7:

    # mc "¡Wow!"
    mc "Uau!"

# game/scripts/c21/c21.rpy:2037
translate brazilian c21s003_KiaraDate_a888af23:

    # kia "¿Quieres quitar esa sonrisa de tu cara? ¡La gente va a empezar a mirarnos!"
    kia "Você quer apagar esse sorriso do seu rosto? As pessoas vão começar a ficar olhando para nós!"

# game/scripts/c21/c21.rpy:2038
translate brazilian c21s003_KiaraDate_e60234c7_1:

    # mc "¡Wow!"
    mc "Uau!"

# game/scripts/c21/c21.rpy:2040
translate brazilian c21s003_KiaraDate_8a485d4c:

    # kia "¡[mc], por favor! ¡Deja de hacer el tonto!"
    kia "[mc], por favor! Pare de agir como um bobo!"

# game/scripts/c21/c21.rpy:2041
translate brazilian c21s003_KiaraDate_42931d20:

    # mc "¡Wow! *Risa* Me acabo de enamorar del sabor de aguacate mezclado con tu pintalabios."
    mc "Uau! *Risos* Eu simplesmente me apaixonei pelo sabor do abacate misturado com o seu batom."

# game/scripts/c21/c21.rpy:2043
translate brazilian c21s003_KiaraDate_d98ac0e5:

    # kia "*Risa* ¿Todavía tengo sabor a aguacate?"
    kia "*Risos* Será que ainda tenho gosto de abacate?"

# game/scripts/c21/c21.rpy:2044
translate brazilian c21s003_KiaraDate_b1b8b40a:

    # mc "Muy ligero, pero todavía se nota. *Risa* Creo que puedo añadir otra cosa verde al menú. Pero lo tendré que comer de tus labios."
    mc "Muito sutil, mas ainda perceptível. *Risos* Acho que posso adicionar mais uma coisa verde ao cardápio. Mas terei que comê-la dos seus lábios."

# game/scripts/c21/c21.rpy:2046
translate brazilian c21s003_KiaraDate_6c92bb1c:

    # "La bibliotecaria pelirroja atrae tu cabeza hasta su altura y vuelve a besarte de una forma que las bibliotecarias deberían tener prohibida."
    "A bibliotecária ruiva levanta seu rosto até a altura dos seus ombros e te beija novamente de um jeito que bibliotecárias deveriam ser proibidas de fazer."

# game/scripts/c21/c21.rpy:2047
translate brazilian c21s003_KiaraDate_24e1f98a:

    # "Esta vez es todo pasión, sin rastro de ternura. Pasea su lengua por tus encías, la entrelaza con la tuya, recorre toda tu boca... Te deja sin aliento."
    "Dessa vez é pura paixão, sem um pingo de ternura. Ele passa a língua sobre suas gengivas, entrelaça-a com a sua, explora toda a sua boca... Ele te deixa sem fôlego."

# game/scripts/c21/c21.rpy:2048
translate brazilian c21s003_KiaraDate_37461727:

    # "Bendito aguacate."
    "Abacate abençoado."

# game/scripts/c21/c21.rpy:2050
translate brazilian c21s003_KiaraDate_e60234c7_2:

    # mc "¡Wow!"
    mc "Uau!"

# game/scripts/c21/c21.rpy:2051
translate brazilian c21s003_KiaraDate_d5771a00:

    # kia "*Respiración entrecortada* ¡Wow! *Risa* Tenía que colaborar con que lleves una dieta saludable."
    kia "*Suspiro de alívio* Uau! *Risos* Tive que te ajudar a ter uma alimentação saudável."

# game/scripts/c21/c21.rpy:2052
translate brazilian c21s003_KiaraDate_0655365d:

    # kia "Me podría pasar horas aquí haciendo esto y diciendo Wow. Pero, desafortunadamente, tengo que volver al trabajo."
    kia "Eu poderia passar horas aqui fazendo isso e dizendo \"Uau!\". Mas, infelizmente, preciso voltar ao trabalho."

# game/scripts/c21/c21.rpy:2053
translate brazilian c21s003_KiaraDate_298eab58:

    # mc "Entonces vamos. No quiero que llegues tarde."
    mc "Vamos então. Não quero que você se atrase."

# game/scripts/c21/c21.rpy:2055
translate brazilian c21s003_KiaraDate_a05e80ee:

    # kia "Y tú has quedado con [ama]..."
    kia "E você combinou de se encontrar [ama]..."

# game/scripts/c21/c21.rpy:2056
translate brazilian c21s003_KiaraDate_8fdac1cc:

    # mc "Sí, me quiere comentar sus ideas sobre la empresa."
    mc "Sim, ele quer compartilhar suas ideias sobre a empresa comigo."

# game/scripts/c21/c21.rpy:2058
translate brazilian c21s003_KiaraDate_ef05061a:

    # kia "*Risa* No estaba interrogándote. Sé que no estás con ella. Al menos aún..."
    kia "*Risos* Eu não estava te questionando. Eu sei que você não está com ela. Pelo menos não ainda..."

# game/scripts/c21/c21.rpy:2059
translate brazilian c21s003_KiaraDate_d66fabe3:

    # mc "*Risa* Lo sé. Después de lo de ayer, no tengo secretos y no quiero tenerlos."
    mc "*Risos* Eu sei. Depois do que aconteceu ontem, não tenho segredos e não quero ter nenhum."

# game/scripts/c21/c21.rpy:2061
translate brazilian c21s003_KiaraDate_c6ec59ab:

    # mc "¿Vamos?"
    mc "Vamos?"

# game/scripts/c21/c21.rpy:2064
translate brazilian c21s003_KiaraDate_b60c23b3:

    # "Unos minutos después, en la biblioteca, justo a la hora en que [kia] tenía que volver..."
    "Poucos minutos depois, na biblioteca, exatamente na hora em que [kia] deveria ser devolvido..."

# game/scripts/c21/c21.rpy:2065
translate brazilian c21s003_KiaraDate_8b2f8fdb:

    # kia "Ya estoy aquí, Gen. Puedes hacer tu pausa para la comida cuando quieras."
    kia "Estou aqui, General. Pode fazer sua pausa para o almoço quando quiser."

# game/scripts/c21/c21.rpy:2066
translate brazilian c21s003_KiaraDate_1edb4e6e:

    # mc "Hola de nuevo, Gen."
    mc "Olá novamente, General."

# game/scripts/c21/c21.rpy:2067
translate brazilian c21s003_KiaraDate_29a64304:

    # gen "Justo a tiempo, me estaba muriendo de hambre. La biblioteca está vacía, no queda nada pendiente."
    gen "Por pouco, eu estava morrendo de fome. A biblioteca está vazia, não há mais nada para fazer."

# game/scripts/c21/c21.rpy:2069
translate brazilian c21s003_KiaraDate_a31f8e02:

    # kia "Pues el puesto de perritos calientes tiene bastante cola ahora. Si necesitas más tiempo no hay ningún problema."
    kia "A fila na barraca de cachorro-quente está bem grande agora. Se precisar de mais tempo, não tem problema."

# game/scripts/c21/c21.rpy:2070
translate brazilian c21s003_KiaraDate_0ed3ff23:

    # gen "[kia]... ¿dónde está tu bolso?"
    gen "[kia]... onde está sua bolsa?"

# game/scripts/c21/c21.rpy:2072
translate brazilian c21s003_KiaraDate_21ee7fe8:

    # kia "¡Mierda! Me lo he dejado en el restaurante."
    kia "Droga! Deixei no restaurante."

# game/scripts/c21/c21.rpy:2074
translate brazilian c21s003_KiaraDate_ee87a7da:

    # kia "¿Puedes cubrirme diez minutos mientras voy a buscarlo?"
    kia "Você pode me substituir por dez minutos enquanto eu vou buscar?"

# game/scripts/c21/c21.rpy:2075
translate brazilian c21s003_KiaraDate_40554669:

    # gen "Ningún problema. Ve a ver si lo han encontrado antes de que desaparezca."
    gen "Sem problema. Vá ver se eles encontraram antes que desapareça."

# game/scripts/c21/c21.rpy:2076
translate brazilian c21s003_KiaraDate_962e9524:

    # mc "No os preocupéis, voy a llamarles y voy a buscarlo, voy a llegar más rápido que tú con los tacones. Ahora lo traigo."
    mc "Não se preocupe, eu ligo para eles e vou buscar. Chego lá mais rápido do que você de salto alto. Trago agora mesmo."

# game/scripts/c21/c21.rpy:2077
translate brazilian c21s003_KiaraDate_7d70251d:

    # mcp "(Espero que siga allí o que lo haya encontrado el camarero cuando nos hemos ido.)"
    mcp "(Espero que ainda esteja lá, ou que o garçom o tenha encontrado depois que saímos.)"

# game/scripts/c21/c21.rpy:2079
translate brazilian c21s003_KiaraDate_2a1b37fd:

    # kia "Gracias, [mc]. ¿Aviso a [ama] de que vas a llegar tarde?"
    kia "Obrigado, [mc]. Devo avisar [ama] que você vai se atrasar?"

# game/scripts/c21/c21.rpy:2080
translate brazilian c21s003_KiaraDate_8b13deee:

    # mc "Sí, por favor."
    mc "Sim, por favor."

# game/scripts/c21/c21.rpy:2082
translate brazilian c21s003_KiaraDate_82c139e0:

    # "Sales de la biblioteca y empiezas a correr hacia el restaurante mientras les llamas. No cogen el teléfono."
    "Você sai da biblioteca e começa a correr em direção ao restaurante enquanto liga para eles. Eles não atendem o telefone."

# game/scripts/c21/c21.rpy:2083
translate brazilian c21s003_KiaraDate_28f6b659:

    # "Llegas un par de minutos después. Nunca habías corrido tan rápido en tu vida."
    "Você chega alguns minutos depois. Você nunca correu tão rápido na sua vida."

# game/scripts/c21/c21.rpy:2085
translate brazilian c21s003_KiaraDate_ddd4ef24:

    # "El camarero saca el bolso de la barra antes de que puedas recuperar el aliento para pedírselo."
    "O garçom retira a sacola do balcão antes que você consiga respirar fundo para pedi-la."

# game/scripts/c21/c21.rpy:2086
translate brazilian c21s003_KiaraDate_61bec498:

    # "Hubiera sido una forma horrible de acabar la segunda cita si [kia] hubiera perdido el bolso."
    "Teria sido uma maneira horrível de terminar o segundo encontro se [kia] tivesse perdido a bolsa."

# game/scripts/c21/c21.rpy:2088
translate brazilian c21s003_KiaraDate_f8948cde:

    # "Vuelves corriendo a la biblioteca. No quieres que [kia] se preocupe por su bolso más de lo necesario. Corres un poco más lento."
    "Você corre de volta para a biblioteca. Você não quer que [kia] se preocupe com a bolsa dela mais do que o necessário. Você corre um pouco mais devagar."

# game/scripts/c21/c21.rpy:2089
translate brazilian c21s003_KiaraDate_7ec444f4:

    # "Quieres mantener un poco de dignidad cuando llegues, y fregar la biblioteca con la lengua no es la mejor forma de hacerlo."
    "Ao chegar, você quer manter um mínimo de dignidade, e esfregar a biblioteca com a língua não é a melhor maneira de fazer isso."

# game/scripts/c21/c21.rpy:2092
translate brazilian c21s003_KiaraDate_41e727be:

    # "Cuando estás a punto de entrar, oyes voces..."
    "Quando você está prestes a entrar, ouve vozes..."

# game/scripts/c21/c21.rpy:2094
translate brazilian c21s003_KiaraDate_12932815:

    # kia "...¡Me da lo mismo que tenga edad para ser mi hijo!"
    kia "Não me importa a idade que ele tenha para ser meu filho!"

# game/scripts/c21/c21.rpy:2095
translate brazilian c21s003_KiaraDate_a9cc36f2:

    # gen "[kia], lo digo por tu bien. Los chavales como él sólo quieren una cosa en una mujer de tu edad..."
    gen "[kia], Estou dizendo isso para o seu próprio bem. Homens como ele só querem uma coisa de uma mulher da sua idade..."

# game/scripts/c21/c21.rpy:2096
translate brazilian c21s003_KiaraDate_5751ce07:

    # kia "Él es diferente..."
    kia "Ele é diferente..."

# game/scripts/c21/c21.rpy:2097
translate brazilian c21s003_KiaraDate_31d65093:

    # gen "Si supieras las veces que he oído eso..."
    gen "Se você soubesse quantas vezes eu já ouvi isso..."

# game/scripts/c21/c21.rpy:2098
translate brazilian c21s003_KiaraDate_f46409ae:

    # mcp "(Es el momento de intervenir.)"
    mcp "(É hora de intervir.)"

# game/scripts/c21/c21.rpy:2100
translate brazilian c21s003_KiaraDate_a641d824:

    # mc "Hola, [kia], Sra. Sky. Vengo con el bolso. Lo había recogido el camarero en cuanto nos hemos ido."
    mc "Olá, Sra. Sky. Trouxe sua bolsa. O garçom a recolheu assim que saímos."

# game/scripts/c21/c21.rpy:2101
translate brazilian c21s003_KiaraDate_0d7b308b:

    # kia "¡Gracias a Dios!"
    kia "Graças a Deus!"

# game/scripts/c21/c21.rpy:2102
translate brazilian c21s003_KiaraDate_5e5e2a04:

    # gen "Gracias, [mc]. [kia] estaba muy preocupada. Y puedes seguir llamándome Gen..."
    gen "Obrigada, [mc]. [kia] Eu estava realmente preocupada. E você ainda pode me chamar de Gen..."

# game/scripts/c21/c21.rpy:2104
translate brazilian c21s003_KiaraDate_ef1dcc07:

    # "Ignoras a Geneviève y te arrodillas a los pies de [kia], poniendo el bolso en el suelo."
    "Você ignora Geneviève e se ajoelha aos pés de [kia], colocando sua bolsa no chão."

# game/scripts/c21/c21.rpy:2106
translate brazilian c21s003_KiaraDate_3c0703f5:

    # kia "¿Qué haces, [mc]?"
    kia "O que você está fazendo, [mc]?"

# game/scripts/c21/c21.rpy:2107
translate brazilian c21s003_KiaraDate_51b3fcab:

    # mc "He oído como la Sra. Sky decía que los chavales como yo sólo queremos una cosa con mujeres como tú."
    mc "Ouvi a Sra. Sky dizer que caras como eu só querem uma coisa com mulheres como você."

# game/scripts/c21/c21.rpy:2109
translate brazilian c21s003_KiaraDate_2d0d83f0:

    # mc "No sé lo que quieren otros chavales como yo."
    mc "Não sei o que outras crianças como eu querem."

# game/scripts/c21/c21.rpy:2111
translate brazilian c21s003_KiaraDate_6e1b5cf3:

    # mc "Yo lo único que quiero es poner el mundo a tus pies, [kia]. Empiezo con un bolso."
    mc "Tudo que eu quero é colocar o mundo aos seus pés, [kia]. Vou começar com uma bolsa."

# game/scripts/c21/c21.rpy:2112
translate brazilian c21s003_KiaraDate_6b53cf56:

    # mc "Y también quiero callar a quien opina sobre nosotros sin saber nada sobre lo que hemos pasado."
    mc "E também quero silenciar aqueles que comentam sobre nós sem saber nada sobre o que passamos."

# game/scripts/c21/c21.rpy:2113
translate brazilian c21s003_KiaraDate_c3f1b5be:

    # kia "Gracias, [mc], pero... ¿puedes levantarte?"
    kia "Obrigado, [mc], mas... você consegue se levantar?"

# game/scripts/c21/c21.rpy:2116
translate brazilian c21s003_KiaraDate_8ee06496:

    # "Estás enfadado. Mucho. Sabes que tus relaciones pueden hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Você está com raiva. Muita raiva. Você sabe que seus relacionamentos podem causar estranheza a muita gente. Mas você não estava preparado para isso."

# game/scripts/c21/c21.rpy:2118
translate brazilian c21s003_KiaraDate_5c20a138:

    # "Estás enfadado. Mucho. Sabes que tu relación con [kia] puede hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Você está com raiva. Muita raiva. Você sabe que seu relacionamento com [kia] pode levantar algumas sobrancelhas. Mas você não estava preparado para isso."

# game/scripts/c21/c21.rpy:2119
translate brazilian c21s003_KiaraDate_83eb79b0:

    # mc "¿Has podido llamar a [ama]?"
    mc "Você conseguiu ligar para [ama]?"

# game/scripts/c21/c21.rpy:2120
translate brazilian c21s003_KiaraDate_ecb11950:

    # kia "Mi móvil estaba en el bolso... ni siquiera he pensado en ello, y no me he aprendido su número."
    kia "Meu celular estava na minha bolsa... Eu nem pensei nisso e não anotei o número dela."

# game/scripts/c21/c21.rpy:2121
translate brazilian c21s003_KiaraDate_7d61ae16:

    # mc "Entonces no te preocupes. Aún llego a tiempo."
    mc "Então não se preocupe. Eu ainda estarei lá a tempo."

# game/scripts/c21/c21.rpy:2123
translate brazilian c21s003_KiaraDate_45d03ede:

    # gen "Siento si te he ofendido, [mc]. Sólo intentaba proteger a [kia]."
    gen "Sinto muito se te ofendi, [mc]. Eu só estava tentando proteger [kia]."

# game/scripts/c21/c21.rpy:2124
translate brazilian c21s003_KiaraDate_4ab0c2c3:

    # "Está nerviosa. Sabe que ha metido la pata. Se le nota más aún el acento francés."
    "Ela está nervosa. Ela sabe que fez besteira. Seu sotaque francês está ainda mais evidente."

# game/scripts/c21/c21.rpy:2125
translate brazilian c21s003_KiaraDate_4bed652a:

    # mc "Me parece loable, pero debería informarse sobre lo que habla antes de decir algo de lo que pueda arrepentirse, Sra. Sky."
    mc "Acho louvável, mas você deveria se informar sobre o assunto antes de dizer algo de que possa se arrepender, Sra. Sky."

# game/scripts/c21/c21.rpy:2126
translate brazilian c21s003_KiaraDate_6547ca29:

    # "Tu tono es cortante. Ahora mismo no quieres dar explicaciones ni hablar con esta mujer."
    "Seu tom é seco. No momento, você não quer dar explicações nem conversar com essa mulher."

# game/scripts/c21/c21.rpy:2127
translate brazilian c21s003_KiaraDate_9e5bf2a2:

    # gen "Gen..."
    gen "Gen..."

# game/scripts/c21/c21.rpy:2128
translate brazilian c21s003_KiaraDate_557ac246:

    # mc "Sólo acorto los nombres de mis amigos, Geneviève."
    mc "Eu simplesmente abrevio o nome das minhas amigas, Geneviève."

# game/scripts/c21/c21.rpy:2130
translate brazilian c21s003_KiaraDate_56a4311f:

    # "Dulcificas tu tono cuando te diriges a [kia]."
    "Você suaviza seu tom quando se dirige a [kia]."

# game/scripts/c21/c21.rpy:2131
translate brazilian c21s003_KiaraDate_47c19fca:

    # mc "Voy a ir a lo de [ama] antes de que se haga tarde."
    mc "Vou para a casa do [ama] antes que fique muito tarde."

# game/scripts/c21/c21.rpy:2132
translate brazilian c21s003_KiaraDate_1ac8e5cc:

    # kia "Gracias de nuevo, [mc]."
    kia "Obrigado novamente, [mc]."

# game/scripts/c21/c21.rpy:2133
translate brazilian c21s003_KiaraDate_8b0e91b1:

    # mc "Te veo en casa, cielo."
    mc "Te vejo em casa, querida."

# game/scripts/c21/c21.rpy:2135
translate brazilian c21s003_KiaraDate_da634e8e:

    # kia "Espera un momento..."
    kia "Espere um minuto..."

# game/scripts/c21/c21.rpy:2136
translate brazilian c21s003_KiaraDate_5c6b8bd7:

    # mc "¿Falta algo en el bolso?"
    mc "Está faltando alguma coisa na sacola?"

# game/scripts/c21/c21.rpy:2137
translate brazilian c21s003_KiaraDate_da7da0b6:

    # kia "Ni lo sé ni me importa."
    kia "Não sei nem me interessa."

# game/scripts/c21/c21.rpy:2138
translate brazilian c21s003_KiaraDate_9493c8fc:

    # "El bolso continúa en el suelo, donde los has dejado."
    "A sacola ainda está no chão, onde você a deixou."

# game/scripts/c21/c21.rpy:2140
translate brazilian c21s003_KiaraDate_6a149303:

    # "[kia] se lanza a tus labios para sorpresa tuya y de Geneviève. Tú has defendido vuestra relación a tu manera."
    "[kia] se lança em direção aos seus lábios, para sua surpresa e a de Geneviève. Você defendeu seu relacionamento à sua maneira."

# game/scripts/c21/c21.rpy:2141
translate brazilian c21s003_KiaraDate_5781450e:

    # "Ella la defiende a la suya."
    "Ela defende os seus."

# game/scripts/c21/c21.rpy:2142
translate brazilian c21s003_KiaraDate_f42e6c2d:

    # "Demostrándole a Geneviève que sus palabras no han conseguido sembrar ninguna duda."
    "Demonstrando a Geneviève que suas palavras não conseguiram semear qualquer dúvida."

# game/scripts/c21/c21.rpy:2143
translate brazilian c21s003_KiaraDate_8800b7ec:

    # "También te lo quiere demostrar a ti."
    "Ele também quer provar isso para você."

# game/scripts/c21/c21.rpy:2144
translate brazilian c21s003_KiaraDate_319ad8f0:

    # "Todavía sabe a aguacate."
    "Ainda tem gosto de abacate."

# game/scripts/c21/c21.rpy:2146
translate brazilian c21s003_KiaraDate_e03f835c:

    # kia "¡Wow! *Risa*"
    kia "Uau! *Risos*"

# game/scripts/c21/c21.rpy:2147
translate brazilian c21s003_KiaraDate_9a736d83:

    # mc "¡Wow! *Risa*"
    mc "Uau! *Risos*"

# game/scripts/c21/c21.rpy:2149
translate brazilian c21s003_KiaraDate_a7d06318:

    # kia "Gracias por todo, cielo."
    kia "Obrigada por tudo, querida."

# game/scripts/c21/c21.rpy:2150
translate brazilian c21s003_KiaraDate_01b1a236:

    # "Ese \"por todo\" incluye dar la cara por ella. Quizás por primera vez en su vida alguien lo ha hecho."
    "Esse \"por tudo\" inclui defendê-la. Talvez pela primeira vez na vida dela, alguém tenha feito isso."

# game/scripts/c21/c21.rpy:2151
translate brazilian c21s003_KiaraDate_e2d67541:

    # mc "Te veo en casa, preciosa."
    mc "Te vejo em casa, linda."

# game/scripts/c21/c21.rpy:2153
translate brazilian c21s003_KiaraDate_54905dfa:

    # mc "Adiós, Geneviève."
    mc "Adeus, Geneviève."

# game/scripts/c21/c21.rpy:2155
translate brazilian c21s003_KiaraDate_e5568ef5:

    # "Te marchas mientras escuchas la despedida murmurada de Geneviève."
    "Você sai enquanto ouve o adeus murmurado de Geneviève."

# game/scripts/c21/c21.rpy:2168
translate brazilian c21s004_AmandaCoffee_73df7f5a:

    # "Llegas al café donde has quedado con [ama]. Era un sitio que no habías visitado nunca anteriormente, pero has venido varias veces en las últimas semanas."
    "Você chega ao café onde vai se encontrar com [ama]. É um lugar que você nunca visitou antes, mas esteve lá várias vezes nas últimas semanas."

# game/scripts/c21/c21.rpy:2170
translate brazilian c21s004_AmandaCoffee_142dc0f7:

    # "[ama] ya está allí, con un café y un portátil sobre la mesa."
    "[ama] já está lá, com um café e um laptop sobre a mesa."

# game/scripts/c21/c21.rpy:2172
translate brazilian c21s004_AmandaCoffee_db15f581:

    # mc "Hola, [ama]. No te levantes. ¿Llevas mucho esperando? No llego tarde, ¿verdad?"
    mc "Olá, [ama]. Não se levante. Você está esperando há muito tempo? Eu não estou atrasado, estou?"

# game/scripts/c21/c21.rpy:2173
translate brazilian c21s004_AmandaCoffee_5e28640c:

    # ama "No te preocupes, llevo diez minutos aquí tan solo. He llegado antes de la hora. Y tú llegas super puntual."
    ama "Não se preocupe, só estou aqui há dez minutos. Cheguei cedo. E você é super pontual."

# game/scripts/c21/c21.rpy:2174
translate brazilian c21s004_AmandaCoffee_ed741d2f:

    # mc "Nunca me ha parecido bien hacer esperar a nadie. Lo considero una falta de respeto hacia el tiempo de los demás."
    mc "Nunca achei certo fazer alguém esperar. Considero isso uma falta de respeito pelo tempo alheio."

# game/scripts/c21/c21.rpy:2176
translate brazilian c21s004_AmandaCoffee_4a9e8483:

    # ama "No sé cómo lo consigues. Los civiles tenéis unas vidas muy complicadas con un montón de cosas por hacer que se solapan."
    ama "Não sei como vocês conseguem. Vocês, civis, têm vidas muito complicadas, com muitas coisas para fazer ao mesmo tempo."

# game/scripts/c21/c21.rpy:2178
translate brazilian c21s004_AmandaCoffee_30339c94:

    # ama "Casi echo de menos la vida organizada de la base en la que siempre sabes qué tienes que hacer a qué hora. Solo casi."
    ama "Quase sinto falta da vida organizada da base, onde você sempre sabe o que tem que fazer e a que horas. Só quase."

# game/scripts/c21/c21.rpy:2179
translate brazilian c21s004_AmandaCoffee_1043c8a0:

    # mc "Yo estoy pensando en fichar una secretaria. *Risa*"
    mc "Estou pensando em contratar uma secretária. *Risos*"

# game/scripts/c21/c21.rpy:2181
translate brazilian c21s004_AmandaCoffee_6f095e24:

    # ama "¿Más mujeres a tu alrededor? *Risa* ¿No tienes suficientes?"
    ama "Mais mulheres ao seu redor? *Risos* Você já não tem o suficiente?"

# game/scripts/c21/c21.rpy:2182
translate brazilian c21s004_AmandaCoffee_1759b4a8:

    # mc "*Risa* Estaba pensando en fichar a Meemaw para eso. *Risa* Al menos se mantendría activa y se sentiría útil."
    mc "*Risos* Eu estava pensando em recrutar a vovó para isso. *Risos* Pelo menos ela se manteria ativa e se sentiria útil."

# game/scripts/c21/c21.rpy:2183
translate brazilian c21s004_AmandaCoffee_8c8428b9:

    # mc "Además, evitaría tener que informar a más personas de los secretos familiares."
    mc "Além disso, evitaria ter que informar mais pessoas sobre segredos de família."

# game/scripts/c21/c21.rpy:2185
translate brazilian c21s004_AmandaCoffee_a0fef5fc:

    # ama "Los secretos parece que van a dejar de serlos. He hablado con [aar] esta mañana. ¿Ha conseguido contactar contigo?"
    ama "Parece que os segredos estão prestes a ser revelados. Falei com [aar] esta manhã. Ele conseguiu entrar em contato com você?"

# game/scripts/c21/c21.rpy:2186
translate brazilian c21s004_AmandaCoffee_7ff06615:

    # mc "Sí, hemos estado hablando sobre la compañía que quiere comprar NTR... ¿Iron Fist se llamaban?"
    mc "Sim, estávamos falando da empresa que quer comprar a NTR... Será que se chamava Punho de Ferro?"

# game/scripts/c21/c21.rpy:2188
translate brazilian c21s004_AmandaCoffee_f7182efb:

    # ama "Sí, son unos capullos, aunque efectivos."
    ama "Sim, eles são uns idiotas, mas são eficazes."

# game/scripts/c21/c21.rpy:2189
translate brazilian c21s004_AmandaCoffee_8b2a1015:

    # ama "Su concepto de operaciones encubiertas es que si no hay supervivientes nadie puede informar. Tienen la sutileza de un ariete... o de [emm]."
    ama "O conceito deles de operações secretas é que, se não houver sobreviventes, ninguém pode denunciar. Eles têm a sutileza de um aríete... ou de um detonador C2."

# game/scripts/c21/c21.rpy:2190
translate brazilian c21s004_AmandaCoffee_a53a432a:

    # mc "*Risa* No es la primera vez que comparan la sutileza de [emm] con un ariete."
    mc "*Risos* Não é a primeira vez que comparam a sutileza de [emm] a um aríete."

# game/scripts/c21/c21.rpy:2191
translate brazilian c21s004_AmandaCoffee_82069f6e:

    # mc "Pero hablando de Iron Fist, tienen que ser enormes si pueden pagar los nueve o diez dígitos que [aar] dijo que valía NTR."
    mc "Mas falando em Punho de Ferro, eles devem ser enormes se podem pagar os nove ou dez dígitos que [aar] disse que NTR valia."

# game/scripts/c21/c21.rpy:2193
translate brazilian c21s004_AmandaCoffee_136c728f:

    # ama "No, no lo son. Son grandes, pero más pequeños que nosotros. Quieren aprovechar el vacío de poder para comprar NTR por una fracción de su valor."
    ama "Não, não são. Eles são grandes, mas menores que nós. Eles querem explorar o vácuo de poder para comprar a NTR por uma fração do seu valor."

# game/scripts/c21/c21.rpy:2194
translate brazilian c21s004_AmandaCoffee_ae964a75:

    # ama "Comprarnos casi triplicaría su cifra de negocio y les proporcionaría contratos a los que no tienen acceso ahora mismo."
    ama "A compra da nossa empresa quase triplicaria o faturamento deles e lhes proporcionaria contratos aos quais não têm acesso atualmente."

# game/scripts/c21/c21.rpy:2195
translate brazilian c21s004_AmandaCoffee_4929bee7:

    # ama "Su negocio de operaciones especiales es algo menos de la mitad del nuestro. Y estamos hablando de cientos de millones."
    ama "O negócio de operações especiais deles é um pouco menor que a metade do nosso. E estamos falando de centenas de milhões."

# game/scripts/c21/c21.rpy:2196
translate brazilian c21s004_AmandaCoffee_2e7db18d:

    # mc "Eso es un montón de dinero. ¿Tantas operaciones especiales se hacen?"
    mc "É muito dinheiro. São realizadas tantas operações especiais assim?"

# game/scripts/c21/c21.rpy:2198
translate brazilian c21s004_AmandaCoffee_a148b45a:

    # ama "Se hacen muchas. Y son caras. Iron Fist trabaja mucho con los gobiernos de países que Estados Unidos no considera amigables."
    ama "Muitos são fabricados. E são caros. O Punho de Ferro trabalha extensivamente com governos de países que os Estados Unidos não consideram aliados."

# game/scripts/c21/c21.rpy:2199
translate brazilian c21s004_AmandaCoffee_19c56fe5:

    # ama "Por eso no tienen acceso a algunos contratos."
    ama "É por isso que eles não têm acesso a alguns contratos."

# game/scripts/c21/c21.rpy:2201
translate brazilian c21s004_AmandaCoffee_54f98cb9:

    # ama "Los clientes principales de NTR son precisamente Estados Unidos y otros países occidentales que no se quieren manchar las manos haciendo algunas cosas."
    ama "Os principais clientes da NTR são precisamente os Estados Unidos e outros países ocidentais que não querem se envolver diretamente em certas questões."

# game/scripts/c21/c21.rpy:2202
translate brazilian c21s004_AmandaCoffee_0c7e8fb7:

    # ama "Pagan MUY bien por evitar salir en la prensa si algo sale mal."
    ama "Eles pagam MUITO bem para evitar aparecer na imprensa caso algo dê errado."

# game/scripts/c21/c21.rpy:2203
translate brazilian c21s004_AmandaCoffee_01b2a114:

    # mc "Lo entiendo. Como una misión en Burkina Faso donde envían a dos niñas de 14 años. Quedaría mal en la prensa si se emborrachan."
    mc "Entendo. Tipo uma missão no Burkina Faso, onde mandam duas meninas de 14 anos. Ficaria feio na imprensa se elas se embriagassem."

# game/scripts/c21/c21.rpy:2205
translate brazilian c21s004_AmandaCoffee_6298a0d4:

    # ama "Sí, a eso me refiero. Esa misión no la podían hacer los Navy SEAL. *Risa* Y no solo porque Burkina no tenga mar."
    ama "Sim, é isso que eu quero dizer. Aquela missão não poderia ter sido realizada pelos SEALs da Marinha. *Risos* E não apenas porque Burkina Faso não tem mar."

# game/scripts/c21/c21.rpy:2206
translate brazilian c21s004_AmandaCoffee_2534901f:

    # ama "Y por eso quería hablar contigo sobre el futuro de NTR. He hecho algunos números con la información que me ha enviado [aar]..."
    ama "E é por isso que eu queria conversar com você sobre o futuro do NTR. Fiz alguns cálculos com as informações que você me enviou [aar]..."

# game/scripts/c21/c21.rpy:2207
translate brazilian c21s004_AmandaCoffee_98fe2261:

    # mc "Déjame pedir un café y me lo explicas."
    mc "Deixe-me pedir um café e você pode me explicar."

# game/scripts/c21/c21.rpy:2209
translate brazilian c21s004_AmandaCoffee_86475cc1:

    # "[ama] pasa unos 20 minutos explicándote la situación del negocio, hasta que llega a la parte más interesante. El dinero."
    "[ama] passa cerca de 20 minutos explicando a situação comercial, até chegar à parte mais interessante: o dinheiro."

# game/scripts/c21/c21.rpy:2211
translate brazilian c21s004_AmandaCoffee_472a8405:

    # ama "La parte médica de la compañía es el 12%% de la facturación global de NTR. El 71%% de la facturación proviene de operaciones de Seguridad."
    ama "A divisão médica da empresa representa 12%% da receita global da NTR. 71%% da receita provém de operações de segurança."

# game/scripts/c21/c21.rpy:2212
translate brazilian c21s004_AmandaCoffee_6b6de5d5:

    # ama "Puedes ver aquí la mala noticia. La parte médica es la que menos dinero da. Es imposible basar la compañía sólo en eso ahora mismo."
    ama "Aqui estão as más notícias. A divisão médica é a menos lucrativa. É impossível basear a empresa apenas nesse setor neste momento."

# game/scripts/c21/c21.rpy:2213
translate brazilian c21s004_AmandaCoffee_1ada89a7:

    # mc "¿Qué es ese concepto? ¿Servicios de Apoyo?"
    mc "Que conceito é esse? Serviços de suporte?"

# game/scripts/c21/c21.rpy:2215
translate brazilian c21s004_AmandaCoffee_4f41ba3a:

    # ama "Alquiler de Equipos y Soporte Logístico, básicamente. A otras compañías como NTR, pero más pequeñas. Transporte de operativos, alquiler de equipos, etc."
    ama "Basicamente, oferecemos serviços de aluguel de equipamentos e suporte logístico. Também prestamos suporte a outras empresas, como a NTR, mas em menor escala. Isso inclui transporte de pessoal, aluguel de equipamentos, etc."

# game/scripts/c21/c21.rpy:2216
translate brazilian c21s004_AmandaCoffee_c15671a1:

    # mc "¿Podríamos mantener esa parte de la Compañía? No nos involucraríamos en Operaciones Especiales con eso, ¿no?"
    mc "Poderíamos manter essa parte da Companhia? Não nos envolveríamos em Operações Especiais com ela, não é?"

# game/scripts/c21/c21.rpy:2218
translate brazilian c21s004_AmandaCoffee_0e46556c:

    # ama "Déjame mirar una cosa..."
    ama "Deixe-me analisar uma coisa..."

# game/scripts/c21/c21.rpy:2219
translate brazilian c21s004_AmandaCoffee_467f4d49:

    # ama "No sería difícil de hacer. Tenemos los contactos y, si dejamos de ser su competencia, otras compañías podrían requerir nuestros servicios."
    ama "Não seria difícil. Temos os contatos, e se deixarmos de ser concorrentes, outras empresas poderão precisar dos nossos serviços."

# game/scripts/c21/c21.rpy:2221
translate brazilian c21s004_AmandaCoffee_e03e8c16:

    # ama "Bien pensado, pero habría que estudiarlo bien. Y no, no nos involucramos en las operaciones de otras compañías. Solo les damos apoyo."
    ama "Essa é uma boa ideia, mas precisaria ser estudada a fundo. E não, nós não nos envolvemos nas operações de outras empresas. Nós apenas oferecemos suporte."

# game/scripts/c21/c21.rpy:2222
translate brazilian c21s004_AmandaCoffee_992f61f5:

    # mc "Dale trabajo a [aar]. *Risa* Creo que, de momento, sería bueno mantener esa fuente de ingresos."
    mc "Dê um emprego para [aar]. *Risos* Acho que, por enquanto, seria bom manter essa fonte de renda."

# game/scripts/c21/c21.rpy:2223
translate brazilian c21s004_AmandaCoffee_bc05e904:

    # mc "Has dicho que es la mala noticia. ¿Hay una buena?"
    mc "Você disse que essa é a má notícia. Há alguma boa notícia?"

# game/scripts/c21/c21.rpy:2225
translate brazilian c21s004_AmandaCoffee_5d5c4dac:

    # ama "Sí, esta. Y con lo que acabas de decir de mantener los Servicios de Apoyo, es incluso mejor."
    ama "Sim, essa mesma. E com o que você acabou de dizer sobre a manutenção dos Serviços de Suporte, fica ainda melhor."

# game/scripts/c21/c21.rpy:2226
translate brazilian c21s004_AmandaCoffee_b76726e1:

    # ama "La facturación crece en las tres áreas cada año, pero el crecimiento en el área de Seguridad es casi residual, entre un 2%% y un 5%%."
    ama "A rotatividade de pessoal aumenta anualmente nas três áreas, mas o crescimento na área de Segurança é quase insignificante, entre 2%% e 5%% por cento."

# game/scripts/c21/c21.rpy:2227
translate brazilian c21s004_AmandaCoffee_c9bfcae3:

    # ama "El crecimiento en los Servicios de Apoyo es de entre un 15%% y un 18%% anual."
    ama "O crescimento nos serviços de apoio situa-se entre 15%% e 18%% ao ano."

# game/scripts/c21/c21.rpy:2228
translate brazilian c21s004_AmandaCoffee_5ac46d50:

    # mc "Eso es una barbaridad de crecimiento."
    mc "Isso representa um crescimento incrível."

# game/scripts/c21/c21.rpy:2230
translate brazilian c21s004_AmandaCoffee_f4f742b4:

    # ama "La facturación de la parte médica crece entre el 50%% y el 60%%. Y acelerando. Hemos empezado muy abajo y es fácil crecer."
    ama "A receita da divisão médica está crescendo entre 50%% e 60%%. E está acelerando. Começamos de uma base muito pequena e é fácil crescer."

# game/scripts/c21/c21.rpy:2231
translate brazilian c21s004_AmandaCoffee_b400262a:

    # ama "Es la partida más pequeña, pero el año que viene seguramente superará a los Servicios de Apoyo."
    ama "É o item mais pequeno, mas no próximo ano certamente ultrapassará os Serviços de Suporte."

# game/scripts/c21/c21.rpy:2232
translate brazilian c21s004_AmandaCoffee_0bbcecef:

    # mc "Déjame hacer unos cálculos..."
    mc "Deixe-me fazer alguns cálculos..."

# game/scripts/c21/c21.rpy:2234
translate brazilian c21s004_AmandaCoffee_72a4dfa7:

    # mc "En cinco años, con ese ritmo de crecimiento, podría ser la principal área de negocio."
    mc "Em cinco anos, nesse ritmo de crescimento, poderá se tornar a principal área de negócios."

# game/scripts/c21/c21.rpy:2235
translate brazilian c21s004_AmandaCoffee_6a6d173c:

    # ama "Y en dos años, combinada con los Servicios de Apoyo, superarían al área de Seguridad. Yo también he hecho los cálculos."
    ama "E em dois anos, somados aos Serviços de Suporte, eles ultrapassariam a área de Segurança. Eu também já fiz os cálculos."

# game/scripts/c21/c21.rpy:2237
translate brazilian c21s004_AmandaCoffee_e0adb9a3:

    # "[ama] pasa los siguientes minutos explicándote todos los cálculos que ha hecho y cómo su plan puede ser realizable."
    "[ama] passa os próximos minutos explicando todos os cálculos que fez e como seu plano pode ser executado."

# game/scripts/c21/c21.rpy:2238
translate brazilian c21s004_AmandaCoffee_27e2028b:

    # "A veces tiene que parar para hacer algún cálculo nuevo debido a la posibilidad de mantener los Servicios de Apoyo."
    "Às vezes, o sistema precisa parar para realizar novos cálculos devido à possibilidade de manutenção dos Serviços de Suporte."

# game/scripts/c21/c21.rpy:2239
translate brazilian c21s004_AmandaCoffee_cf440c51:

    # "Son cálculos que aburrirían a cualquiera que no fuera un empollón. Por suerte ambos lo sois."
    "São cálculos que entediariam qualquer pessoa que não fosse nerd. Felizmente, vocês dois são."

# game/scripts/c21/c21.rpy:2241
translate brazilian c21s004_AmandaCoffee_36ef2119:

    # ama "Y eso sería todo. Creo que, económicamente, el plan es realizable."
    ama "E isso seria tudo. Acredito que o plano seja economicamente viável."

# game/scripts/c21/c21.rpy:2242
translate brazilian c21s004_AmandaCoffee_44943cd0:

    # mc "Le veo un problema. ¿Qué hacemos con vosotras? ¿Y con los XY?"
    mc "Vejo um problema. O que faremos com você? E com os XY?"

# game/scripts/c21/c21.rpy:2244
translate brazilian c21s004_AmandaCoffee_a5795415:

    # ama "También he pensado en eso, pero necesito modificarlo."
    ama "Eu também já pensei nisso, mas preciso modificar."

# game/scripts/c21/c21.rpy:2245
translate brazilian c21s004_AmandaCoffee_e53d4110:

    # ama "No estoy segura de que todos los XY quieran abandonar la vida que llevan. Las misiones dan mucha adrenalina, son como una droga."
    ama "Não tenho certeza se todos os XYs querem abandonar suas vidas atuais. As missões são uma enorme descarga de adrenalina, como uma droga."

# game/scripts/c21/c21.rpy:2246
translate brazilian c21s004_AmandaCoffee_e342d899:

    # mc "Pero vosotras sí que queréis dejar esas misiones."
    mc "Mas você quer sim abandonar essas missões."

# game/scripts/c21/c21.rpy:2248
translate brazilian c21s004_AmandaCoffee_10dcc7de:

    # ama "Nosotras somos diferentes. Envejecemos a un ritmo normal. Ellos saben que tienen una juventud limitada y querrán sacarle el máximo partido."
    ama "Somos diferentes. Envelhecemos em um ritmo normal. Eles sabem que têm uma juventude limitada e querem aproveitá-la ao máximo."

# game/scripts/c21/c21.rpy:2249
translate brazilian c21s004_AmandaCoffee_55c23b04:

    # ama "[eva] y yo nos conformaríamos con un trabajo normal."
    ama "[eva] e eu ficaria feliz com um emprego normal."

# game/scripts/c21/c21.rpy:2250
translate brazilian c21s004_AmandaCoffee_dda27f5f:

    # mc "¿Como jefas de seguridad de la base, por ejemplo? Había pensado en eso como opción. En el fondo, la empresa también es vuestra."
    mc "Como chefe de segurança da base, por exemplo? Eu havia considerado essa opção. No fim das contas, a empresa também é sua."

# game/scripts/c21/c21.rpy:2252
translate brazilian c21s004_AmandaCoffee_99e64c93:

    # ama "¿Qué? ¡No! ¿Por qué quieres hacernos esto?"
    ama "O quê? Não! Por que você quer fazer isso conosco?"

# game/scripts/c21/c21.rpy:2253
translate brazilian c21s004_AmandaCoffee_44b2bddf:

    # mc "¿Qué? ¿Haceros qué?"
    mc "O quê? Fazer o quê?"

# game/scripts/c21/c21.rpy:2255
translate brazilian c21s004_AmandaCoffee_4254531d:

    # ama "¡Mandarnos lejos!"
    ama "Mandem-nos embora!"

# game/scripts/c21/c21.rpy:2256
translate brazilian c21s004_AmandaCoffee_7e3a8c72:

    # ama "¡Os acabamos de encontrar!"
    ama "Acabamos de te encontrar!"

# game/scripts/c21/c21.rpy:2258
translate brazilian c21s004_AmandaCoffee_3a65f1d9:

    # ama "¡[eva] y yo incluso hemos resuelto nuestras diferencias respecto a ti!"
    ama "[eva] e até já resolvemos nossas diferenças a seu respeito!"

# game/scripts/c21/c21.rpy:2259
translate brazilian c21s004_AmandaCoffee_1024c403:

    # mc "No os quiero mandar lejos, [ama]. Yo también voy a ir a Aruba."
    mc "Não quero te mandar para longe, [ama]. Eu também vou para Aruba."

# game/scripts/c21/c21.rpy:2261
translate brazilian c21s004_AmandaCoffee_44557789:

    # ama "Pero tu volverás... y nosotras, si somos las jefas de seguridad, nos tendremos que quedar allí..."
    ama "Mas você voltará... e nós, se formos os chefes de segurança, teremos que ficar lá..."

# game/scripts/c21/c21.rpy:2274
translate brazilian c21s004_AmandaCoffee_532effae:

    # mc "También necesitaremos a alguien que proteja a los accionistas, ¿no?"
    mc "Também precisaremos de alguém para proteger os acionistas, não é?"

# game/scripts/c21/c21.rpy:2275
translate brazilian c21s004_AmandaCoffee_87cbbccf:

    # mc "Y no se me ocurre nadie mejor que vosotras. Podéis turnaros, no sé... ¿Una semana cada una en Aruba mientras la otra está aquí con la familia?"
    mc "E não consigo pensar em ninguém melhor do que vocês dois. Vocês poderiam se revezar, sei lá... Uma semana cada um em Aruba enquanto o outro fica aqui com a família?"

# game/scripts/c21/c21.rpy:2278
translate brazilian c21s004_AmandaCoffee_fb44ec1f:

    # ama "Espera... has dicho que me quieres cerca de ti... ¿Significa eso que...?"
    ama "Espere... você disse que me quer perto de você... Isso significa...?"

# game/scripts/c21/c21.rpy:2279
translate brazilian c21s004_AmandaCoffee_c1ad7533:

    # mc "Sí, [ama]. Significa que, si quieres, me encantaría salir contigo."
    mc "Sim, [ama]. Significa que, se você quiser, eu adoraria sair com você."

# game/scripts/c21/c21.rpy:2280
translate brazilian c21s004_AmandaCoffee_ffd67f7e:

    # mc "Sólo estaba esperando a que [eva] y tú aclararais las cosas para decírtelo."
    mc "Eu estava apenas esperando que você e [eva] esclarecessem as coisas para que eu pudesse te contar."

# game/scripts/c21/c21.rpy:2282
translate brazilian c21s004_AmandaCoffee_79933eac:

    # ama "¿Decírmelo? ¿Sólo a mí? ¿No quieres estar con [eva]?"
    ama "Diga-me? Só eu? Você não quer ficar com [eva]?"

# game/scripts/c21/c21.rpy:2283
translate brazilian c21s004_AmandaCoffee_f87257ab:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "Isso é algo que eu e [eva] precisamos conversar. A sós. Só nós dois. Independentemente de eu querer estar com ela ou não."

# game/scripts/c21/c21.rpy:2284
translate brazilian c21s004_AmandaCoffee_0d111a06:

    # ama "Lo entiendo..."
    ama "Eu entendo..."

# game/scripts/c21/c21.rpy:2286
translate brazilian c21s004_AmandaCoffee_bb3a07dc:

    # ama "¿Significa eso que... puedo besarte?"
    ama "Isso significa que... eu posso te beijar?"

# game/scripts/c21/c21.rpy:2287
translate brazilian c21s004_AmandaCoffee_4b26efe4:

    # mc "No, significa que ahora vamos a tirar las tazas al suelo y vamos a follar encima de la mesa. *Risa*"
    mc "Não, significa que vamos jogar os copos no chão e transar na mesa. *Risos*"

# game/scripts/c21/c21.rpy:2289
translate brazilian c21s004_AmandaCoffee_08e8d48b:

    # ama "¿Qué? ¿Ahora? ¿Aquí?"
    ama "O quê? Agora? Aqui?"

# game/scripts/c21/c21.rpy:2290
translate brazilian c21s004_AmandaCoffee_f67c14de:

    # mc "*Risa* Tenemos que trabajar en tu detección del sarcasmo."
    mc "*Risos* Precisamos melhorar sua capacidade de detectar sarcasmo."

# game/scripts/c21/c21.rpy:2292
translate brazilian c21s004_AmandaCoffee_e0b1a77f:

    # mc "Claro que vamos a besarnos. ¿Me permites?"
    mc "É claro que vamos nos beijar. Posso?"

# game/scripts/c21/c21.rpy:2295
translate brazilian c21s004_AmandaCoffee_a122784e:

    # "[ama] se levanta como impulsada por un muelle y ataca tus labios con furia."
    "[ama] surge como se impulsionado por uma mola e ataca seus lábios com fúria."

# game/scripts/c21/c21.rpy:2296
translate brazilian c21s004_AmandaCoffee_97e8eb5a:

    # "\"Atacar\" es la palabra adecuada."
    "\"Ataque\" é a palavra certa."

# game/scripts/c21/c21.rpy:2297
translate brazilian c21s004_AmandaCoffee_36b607be:

    # "Hay furia y pasión en su beso. Creías que iba a ser un beso tímido, pero no podías estar más equivocado."
    "Há fúria e paixão no beijo deles. Você pensou que seria um beijo tímido, mas estava completamente enganado."

# game/scripts/c21/c21.rpy:2298
translate brazilian c21s004_AmandaCoffee_e5708729:

    # "Sólo se separa de tus labios cuando le falta el aire."
    "Ela só se afasta dos seus lábios quando fica sem ar."

# game/scripts/c21/c21.rpy:2301
translate brazilian c21s004_AmandaCoffee_e8e43958:

    # ama "¡Wow!"
    ama "Uau!"

# game/scripts/c21/c21.rpy:2302
translate brazilian c21s004_AmandaCoffee_08f7d3ff:

    # mc "*Risa* Estoy de acuerdo. ¡Wow!"
    mc "*Risos* Concordo. Uau!"

# game/scripts/c21/c21.rpy:2304
translate brazilian c21s004_AmandaCoffee_c89321d1:

    # ama "*Risa* No te rías de mí. Llevo días queriendo hacer esto..."
    ama "*Risos* Não riam de mim. Eu queria fazer isso há dias..."

# game/scripts/c21/c21.rpy:2306
translate brazilian c21s004_AmandaCoffee_21ef5df9:

    # ama "¿Sabes cuando quieres algo durante mucho tiempo y lo consigues...? ¿Ese sentimiento de decepción? ¿De vacío al cumplir el objetivo?"
    ama "Sabe aquela sensação de quando você deseja algo por muito tempo e finalmente consegue...? Aquela sensação de decepção? De vazio após alcançar seu objetivo?"

# game/scripts/c21/c21.rpy:2307
translate brazilian c21s004_AmandaCoffee_d5415aec:

    # mc "Sí, conozco ese sentimiento. ¿Decepcionada?"
    mc "Sim, eu sei como é essa sensação. Decepcionado?"

# game/scripts/c21/c21.rpy:2309
translate brazilian c21s004_AmandaCoffee_f6769de9:

    # ama "*Risa* Tenemos que trabajar en tu costumbre de interrumpir a la gente cuando habla."
    ama "*Risos* Precisamos trabalhar no seu hábito de interromper as pessoas quando elas estão falando."

# game/scripts/c21/c21.rpy:2310
translate brazilian c21s004_AmandaCoffee_6eb8b13a:

    # ama "Quería decir que esperaba ese sentimiento, pero no se ha dado. *Risa* Al revés. Tengo ganas de ignorar tu sarcasmo y tirar las tazas al suelo."
    ama "Eu queria dizer que esperava sentir isso, mas não aconteceu. *Risos* Muito pelo contrário. Estou com vontade de ignorar seu sarcasmo e jogar as xícaras no chão."

# game/scripts/c21/c21.rpy:2311
translate brazilian c21s004_AmandaCoffee_2612622a:

    # mc "*Risa* Tengo que ser una bestia besando."
    mc "*Risos* Tenho que ser uma fera em beijar."

# game/scripts/c21/c21.rpy:2313
translate brazilian c21s004_AmandaCoffee_a565ca82:

    # ama "*Risa* No voy a decir ni que sí ni que no. No quiero alimentar tu ego más de lo que ya lo está."
    ama "*Risos* Não vou dizer sim nem não. Não quero alimentar seu ego mais do que ele já está."

# game/scripts/c21/c21.rpy:2315
translate brazilian c21s004_AmandaCoffee_6c486a00:

    # "Te da un rápido beso."
    "Ele te dá um beijo rápido."

# game/scripts/c21/c21.rpy:2316
translate brazilian c21s004_AmandaCoffee_69881554:

    # ama "Siéntate donde estabas, voy al lavabo un momento y seguimos con la reunión."
    ama "Volte para onde estava, vou ao banheiro por um instante e depois continuamos a reunião."

# game/scripts/c21/c21.rpy:2317
translate brazilian c21s004_AmandaCoffee_3e89e8ed:

    # mc "¿No quieres que me siente a tu lado?"
    mc "Você não quer que eu me sente ao seu lado?"

# game/scripts/c21/c21.rpy:2318
translate brazilian c21s004_AmandaCoffee_3d50c3d3:

    # ama "Sí, pero si lo haces no vamos a poder acabar con lo que hemos venido a hacer. Si hay una mesa entre los dos puedo mantener la cabeza centrada en la reunión."
    ama "Sim, mas se você fizer isso, não conseguiremos terminar o que viemos fazer aqui. Se houver uma mesa entre nós, consigo manter o foco na reunião."

# game/scripts/c21/c21.rpy:2320
translate brazilian c21s004_AmandaCoffee_412cc044:

    # ama "Más o menos."
    ama "Mais ou menos."

# game/scripts/c21/c21.rpy:2323
translate brazilian c21s004_AmandaCoffee_23c48176:

    # ama "Espera... Has dicho que quieres que forme parte de la familia, pero no has dicho nada de nosotros."
    ama "Espere... Você disse que quer que eu faça parte da família, mas não disse nada sobre nós."

# game/scripts/c21/c21.rpy:2324
translate brazilian c21s004_AmandaCoffee_3289a10b:

    # ama "¿Significa eso que tú y yo...?"
    ama "Isso significa que você e eu...?"

# game/scripts/c21/c21.rpy:2325
translate brazilian c21s004_AmandaCoffee_d27eeaf8:

    # mc "Significa que quiero que formes parte de nuestras vidas. Me caes muy bien, [ama], pero a diferencia de ti, te conozco tan solo desde hace unos días."
    mc "Significa que quero que você faça parte das nossas vidas. Gosto muito de você, [ama], mas, ao contrário de você, só te conheço há alguns dias."

# game/scripts/c21/c21.rpy:2327
translate brazilian c21s004_AmandaCoffee_eb151802:

    # mc "No he tenido tiempo de desarrollar sentimientos por ti, y... no creo que lo haga en el futuro. Al menos no como tú quieres."
    mc "Não tive tempo de desenvolver sentimentos por você e... acho que não terei no futuro. Pelo menos não da maneira que você deseja."

# game/scripts/c21/c21.rpy:2328
translate brazilian c21s004_AmandaCoffee_c6d41377:

    # mc "Despiertas en mí un sentimiento de protección, pero no uno romántico."
    mc "Você desperta em mim um sentimento de proteção, mas não um sentimento romântico."

# game/scripts/c21/c21.rpy:2329
translate brazilian c21s004_AmandaCoffee_59e887db:

    # mc "No quiero darte falsas esperanzas. Creo que tengo que ser sincero sobre eso."
    mc "Não quero criar falsas esperanças. Acho que preciso ser honesto quanto a isso."

# game/scripts/c21/c21.rpy:2330
translate brazilian c21s004_AmandaCoffee_a242232e:

    # mc "Que [eva] y tú hayáis tardado tanto en resolver vuestras diferencias, me ha dado tiempo a mí para examinar lo que siento hacia vosotras."
    mc "O fato de [eva] e você terem demorado tanto para resolver suas diferenças me deu tempo para examinar meus sentimentos em relação a você."

# game/scripts/c21/c21.rpy:2332
translate brazilian c21s004_AmandaCoffee_f63e1d87:

    # ama "Lo entiendo y te agradezco la sinceridad..."
    ama "Compreendo e agradeço a sua honestidade..."

# game/scripts/c21/c21.rpy:2333
translate brazilian c21s004_AmandaCoffee_6c772ee3:

    # ama "¿Te pasa lo mismo con [eva]? No sé si te va a arrancar la cabeza si le dices algo así."
    ama "Você tem o mesmo problema com [eva]? Não sei se ele arrancaria sua cabeça se você dissesse algo assim para ele."

# game/scripts/c21/c21.rpy:2334
translate brazilian c21s004_AmandaCoffee_f87257ab_1:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "Isso é algo que eu e [eva] precisamos conversar. A sós. Só nós dois. Independentemente de eu querer estar com ela ou não."

# game/scripts/c21/c21.rpy:2336
translate brazilian c21s004_AmandaCoffee_5d7ed353:

    # ama "Tienes razón, no debería inmiscuirme."
    ama "Você tem razão, eu não deveria me envolver."

# game/scripts/c21/c21.rpy:2337
translate brazilian c21s004_AmandaCoffee_4a3807a0:

    # ama "Dame un segundo, voy al lavabo."
    ama "Só um segundo, vou ao banheiro."

# game/scripts/c21/c21.rpy:2338
translate brazilian c21s004_AmandaCoffee_3c72afc8:

    # mc "El tiempo que necesites."
    mc "Todo o tempo que você precisar."

# game/scripts/c21/c21.rpy:2340
translate brazilian c21s004_AmandaCoffee_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c21/c21.rpy:2341
translate brazilian c21s004_AmandaCoffee_11e8caa8:

    # ama "Volviendo al tema de los XY..."
    ama "Voltando ao assunto do XY..."

# game/scripts/c21/c21.rpy:2342
translate brazilian c21s004_AmandaCoffee_2bc208ce:

    # mc "¿No quieres hablar de lo que acaba de pasar?"
    mc "Você não quer conversar sobre o que acabou de acontecer?"

# game/scripts/c21/c21.rpy:2344
translate brazilian c21s004_AmandaCoffee_2e791067:

    # ama "Prefiero no hacerlo ahora. Tenemos que acabar esto y tengo que relevar a [eva]."
    ama "Prefiro não fazer isso agora. Precisamos terminar isto, e eu tenho que aliviar [eva]."

# game/scripts/c21/c21.rpy:2346
translate brazilian c21s004_AmandaCoffee_434b87cf:

    # ama "Si empiezo a hablar de lo que ha pasado, no vamos a parar y voy a pasarme horas besándote."
    ama "Se eu começar a falar sobre o que aconteceu, não vamos parar e eu vou passar horas te beijando."

# game/scripts/c21/c21.rpy:2347
translate brazilian c21s004_AmandaCoffee_38c8e290:

    # ama "Tendremos mucho tiempo para hablar cuando llegue el momento. Ahora tenemos una reunión que terminar."
    ama "Teremos bastante tempo para conversar quando chegar a hora. Agora, temos uma reunião para terminar."

# game/scripts/c21/c21.rpy:2349
translate brazilian c21s004_AmandaCoffee_13d3336d:

    # ama "No tiene sentido hablarlo. Sentimos cosas diferentes por el otro, pero ni quiero ni puedo forzarte a sentir lo que siento yo."
    ama "Não adianta falar sobre isso. Sentimos coisas diferentes um pelo outro, mas eu não quero nem posso te obrigar a sentir o que eu sinto."

# game/scripts/c21/c21.rpy:2350
translate brazilian c21s004_AmandaCoffee_815b5864:

    # ama "No me debes ninguna explicación ni yo la quiero, pero tenemos una reunión que terminar."
    ama "Você não me deve nenhuma explicação, nem eu quero uma, mas temos uma reunião para terminar."

# game/scripts/c21/c21.rpy:2351
translate brazilian c21s004_AmandaCoffee_3aff1176:

    # mc "De acuerdo, sigamos entonces."
    mc "Certo, vamos continuar então."

# game/scripts/c21/c21.rpy:2353
translate brazilian c21s004_AmandaCoffee_87d6d455:

    # ama "Contamos con 109 efectivos XY operativos ahora mismo. Aparte de eso hay 19 inoperativos."
    ama "Atualmente, contamos com 109 funcionários operacionais da XY. Além disso, há 19 funcionários inativos."

# game/scripts/c21/c21.rpy:2354
translate brazilian c21s004_AmandaCoffee_b23bbd8c:

    # ama "En los próximos diez años, 461 más completarán su crecimiento y formación."
    ama "Nos próximos dez anos, mais 461 pessoas concluirão sua formação e treinamento."

# game/scripts/c21/c21.rpy:2355
translate brazilian c21s004_AmandaCoffee_29bf8ed0:

    # mcp "(Acaba de aparecer la [ama] fría y profesional para separarse emocionalmente de lo que acaba de pasar.)"
    mcp "(A postura fria e profissional pareceu se distanciar emocionalmente do que acabara de acontecer.)"

# game/scripts/c21/c21.rpy:2357
translate brazilian c21s004_AmandaCoffee_aa1e9894:

    # ama "Como ya te he dicho, si les damos opciones, no todos van a querer abandonar las Operaciones Especiales."
    ama "Como já lhes disse, se lhes dermos opções, nem todos vão querer sair das Operações Especiais."

# game/scripts/c21/c21.rpy:2358
translate brazilian c21s004_AmandaCoffee_b86fa212:

    # ama "Pero podremos reubicar a la mayoría en operaciones de Apoyo o en seguridad de la base, especialmente a los nuevos."
    ama "Mas conseguiremos realocar a maioria deles para operações de apoio ou segurança da base, especialmente os mais novos."

# game/scripts/c21/c21.rpy:2359
translate brazilian c21s004_AmandaCoffee_e578e9b6:

    # mc "Creo que tenemos que darles la opción de decidir. Tienen tanto derecho como tú o como yo."
    mc "Acho que temos que dar a eles a opção de decidir. Eles têm tanto direito quanto você ou eu."

# game/scripts/c21/c21.rpy:2360
translate brazilian c21s004_AmandaCoffee_a917d171:

    # mc "Incluso si quieren desvincularse totalmente de NTR deberíamos aceptarlo."
    mc "Mesmo que queiram se dissociar completamente do NTR, devemos aceitar."

# game/scripts/c21/c21.rpy:2361
translate brazilian c21s004_AmandaCoffee_843a0f18:

    # mc "¿Cuánta seguridad necesitamos en la base?"
    mc "Quanta segurança precisamos na base?"

# game/scripts/c21/c21.rpy:2363
translate brazilian c21s004_AmandaCoffee_7824fc7a:

    # ama "Ahora mismo hay 36 en tres turnos. Casi todos de las Series J y K, la última y la próxima en ser considerada operativa. Les sirve como entrenamiento."
    ama "No momento, são 36 pessoas em três turnos. Quase todas são das séries J e K, as mais recentes e as próximas a serem consideradas operacionais. Isso serve como treinamento para elas."

# game/scripts/c21/c21.rpy:2365
translate brazilian c21s004_AmandaCoffee_c2659771:

    # ama "Aquí puedes ver las estadísticas por series. De la K a la T todavía están en crecimiento y formación."
    ama "Aqui você pode ver as estatísticas por série. As séries de K a T ainda estão em desenvolvimento e crescimento."

# game/scripts/c21/c21.rpy:2366
translate brazilian c21s004_AmandaCoffee_42975966:

    # mc "Hay mucho rojo, incluso entre las series que no han entrado en servicio. Demasiado rojo."
    mc "Há muito vermelho, mesmo entre as séries que ainda não entraram em serviço. Vermelho demais."

# game/scripts/c21/c21.rpy:2367
translate brazilian c21s004_AmandaCoffee_deb35d10:

    # ama "Alrededor del 7%% son bajas durante el entrenamiento, como Fiona. El resto son bajas operativas. Sumadas al entrenamiento, alrededor del 32%% son bajas."
    ama "Cerca de 7%% são baixas durante treinamento, como Fiona. O restante são baixas operacionais. Incluindo as baixas de treinamento, o total de baixas chega a cerca de 32%%."

# game/scripts/c21/c21.rpy:2368
translate brazilian c21s004_AmandaCoffee_d26ea785:

    # mc "Si seguimos con el entrenamiento, hay que cambiar los métodos. No quiero que niños pequeños mueran jugando con explosivos."
    mc "Se continuarmos com esse treinamento, teremos que mudar os métodos. Não quero que crianças pequenas morram brincando com explosivos."

# game/scripts/c21/c21.rpy:2369
translate brazilian c21s004_AmandaCoffee_5f5b1891:

    # mc "Y me da lo mismo que tengan cuerpos de adultos. No quiero. Punto."
    mc "E não me importa se elas têm corpos de adultas. Eu não as quero. Ponto final."

# game/scripts/c21/c21.rpy:2371
translate brazilian c21s004_AmandaCoffee_a5965deb:

    # ama "Me sorprende la empatía que tienes hacia gente que no conoces."
    ama "Fico surpreso com a empatia que você demonstra por pessoas que não conhece."

# game/scripts/c21/c21.rpy:2372
translate brazilian c21s004_AmandaCoffee_dede75a0:

    # mc "Os conozco a [eva] y a ti. Y a [aar], aunque sea poco. Tengo suficiente."
    mc "Eu conheço você e [eva]. E [aar], mesmo que só um pouco. Eu tenho o suficiente."

# game/scripts/c21/c21.rpy:2373
translate brazilian c21s004_AmandaCoffee_d91b722c:

    # mc "¿Quién se encarga del entrenamiento ahora mismo?"
    mc "Quem está responsável pelo treinamento neste momento?"

# game/scripts/c21/c21.rpy:2375
translate brazilian c21s004_AmandaCoffee_949531d5:

    # ama "Los C y los D, principalmente. Los entrenan como fueron entrenados ellos. Como fuimos entrenadas nosotras."
    ama "Principalmente os grupos C e D. Eles os treinam da mesma forma que foram treinados. Da mesma forma que nós fomos treinados."

# game/scripts/c21/c21.rpy:2376
translate brazilian c21s004_AmandaCoffee_a4bf90de:

    # mc "Lo primero que quiero hacer cuando llegue a Aruba, entonces, es reunirme con los C y los D. Y quiero sus nombres. No quiero pensar en ellos como letras."
    mc "A primeira coisa que quero fazer quando chegar a Aruba, então, é conhecer os C's e os D's. E quero saber os nomes deles. Não quero pensar neles apenas como letras."

# game/scripts/c21/c21.rpy:2378
translate brazilian c21s004_AmandaCoffee_c07cbb22:

    # "Pasáis los siguientes minutos haciendo planes y números, modificando las ideas de [ama], ampliando la información que tienes sobre la empresa. Tomando más cafés."
    "Você passa os próximos minutos fazendo planos e analisando números, revisando as ideias de [ama] e expandindo seu conhecimento sobre a empresa. E tomando mais café."

# game/scripts/c21/c21.rpy:2379
translate brazilian c21s004_AmandaCoffee_337e57f0:

    # "Al cabo casi una hora, suena una alarma en el móvil de [ama]."
    "Após quase uma hora, um alarme soa no celular de [ama]."

# game/scripts/c21/c21.rpy:2381
translate brazilian c21s004_AmandaCoffee_c36b8809:

    # ama "Voy a tener que irme. Me toca relevar a [eva]. Lleva casi 30 horas sin dormir."
    ama "Preciso ir. É minha vez de dar um descanso ao [eva]. Ele está acordado há quase 30 horas."

# game/scripts/c21/c21.rpy:2382
translate brazilian c21s004_AmandaCoffee_7a628fb8:

    # ama "Recopilaré todos los datos y te los mando. Supongo que en un par de días los tendré hechos."
    ama "Vou reunir todos os dados e enviar para você. Espero concluir isso em alguns dias."

# game/scripts/c21/c21.rpy:2383
translate brazilian c21s004_AmandaCoffee_7b2c571d:

    # mc "Genial. ¿Vais a venir a casa a cenar esta noche?"
    mc "Ótimo. Você vem jantar aqui hoje à noite?"

# game/scripts/c21/c21.rpy:2385
translate brazilian c21s004_AmandaCoffee_45b1f444:

    # ama "Sí, hemos ido a comer, pero no estabas."
    ama "Sim, nós saímos para jantar, mas você não estava lá."

# game/scripts/c21/c21.rpy:2387
translate brazilian c21s004_AmandaCoffee_250366b8:

    # mc "Ya sabes que había quedado para comer con [kia]."
    mc "Você sabe que eu tinha combinado de almoçar com [kia]."

# game/scripts/c21/c21.rpy:2389
translate brazilian c21s004_AmandaCoffee_debde37a:

    # mc "Ya sabes que tenía que llevar a [meg] a la estación de autobuses."
    mc "Você sabe que eu tive que pegar [meg] para ir até a rodoviária."

# game/scripts/c21/c21.rpy:2390
translate brazilian c21s004_AmandaCoffee_a7810a76:

    # ama "Lo sé..."
    ama "Eu sei..."

# game/scripts/c21/c21.rpy:2392
translate brazilian c21s004_AmandaCoffee_97d1780f:

    # ama "Entonces te veo esta noche."
    ama "Então te vejo hoje à noite."

# game/scripts/c21/c21.rpy:2395
translate brazilian c21s004_AmandaCoffee_f80d270f:

    # "[ama] se vuelve a lanzar a tus labios, esta vez sin el ansia del beso anterior. Sabe que vendrán más."
    "[ama] Ele se lança em direção aos seus lábios novamente, desta vez sem o fervor do beijo anterior. Ele sabe que haverá mais."

# game/scripts/c21/c21.rpy:2398
translate brazilian c21s004_AmandaCoffee_b7bb21ab:

    # "Os dais un abrazo de despedida. Tácitamente, sin necesidad de palabras, habéis decidido que los besos de despedida están de más ahora que habéis aclarado que no estaréis juntos."
    "Vocês se abraçam em despedida. Tacitamente, sem precisar de palavras, decidiram que beijos de despedida são desnecessários agora que deixaram claro que não ficarão mais juntos."

# game/scripts/c21/c21.rpy:2400
translate brazilian c21s004_AmandaCoffee_705a5ed1:

    # ama "Hasta la noche, [mc]."
    ama "Até esta noite, [mc]."

# game/scripts/c21/c21.rpy:2402
translate brazilian c21s004_AmandaCoffee_70d3a368:

    # mc "Hasta la noche, [ama]."
    mc "Até esta noite, [ama]."

# game/scripts/c21/c21.rpy:2445
translate brazilian c21s005_DebRun_f640654f:

    # "Al llegar a casa te encuentras con [deb.nick] en la puerta."
    "Ao chegar em casa, você encontra [deb.nick] na porta."

# game/scripts/c21/c21.rpy:2447
translate brazilian c21s005_DebRun_d207482f:

    # deb "Buenas tardes, [mc]."
    deb "Boa tarde, [mc]."

# game/scripts/c21/c21.rpy:2450
translate brazilian c21s005_DebRun_b822a602:

    # mc "Buenas tardes, cielo."
    mc "Boa tarde, querida."

# game/scripts/c21/c21.rpy:2452
translate brazilian c21s005_DebRun_52bcb279:

    # mc "Buenas tardes, [deb.nick]."
    mc "Boa tarde, [deb.nick]."

# game/scripts/c21/c21.rpy:2453
translate brazilian c21s005_DebRun_b6945ea0:

    # mc "¿Sales a correr o vuelves ahora?"
    mc "Você vai correr ou já volta?"

# game/scripts/c21/c21.rpy:2455
translate brazilian c21s005_DebRun_d567ddad:

    # deb "Salgo ahora. Iba a ir al lago. [kim] y [kat] han salido hace un rato."
    deb "Estou indo embora agora. Eu ia para o lago. [kim] e [kat] saíram há pouco tempo."

# game/scripts/c21/c21.rpy:2456
translate brazilian c21s005_DebRun_54fd321b:

    # mc "Si me das cinco minutos para cambiarme, te acompaño."
    mc "Se você me der cinco minutos para me trocar, eu vou com você."

# game/scripts/c21/c21.rpy:2457
translate brazilian c21s005_DebRun_289bde06:

    # deb "¡Genial! Te espero en la piscina. [lis] está allí."
    deb "Ótimo! Estarei te esperando na piscina. [lis] está lá."

# game/scripts/c21/c21.rpy:2460
translate brazilian c21s005_DebRun_bbcbf13f:

    # mc "Hasta ahora."
    mc "Até agora."

# game/scripts/c21/c21.rpy:2462
translate brazilian c21s005_DebRun_41d397cb:

    # "Unos minutos después..."
    "Alguns minutos depois..."

# game/scripts/c21/c21.rpy:2463
translate brazilian c21s005_DebRun_c68b29c7:

    # mc "Hola, [lis]."
    mc "Olá, [lis]."

# game/scripts/c21/c21.rpy:2464
translate brazilian c21s005_DebRun_1e28d7f9:

    # lis "Hola, [mc]. No contéis conmigo para ir a correr. [deb.nick] estaba intentando convencerme."
    lis "Olá, [mc]. Não conte comigo para uma corrida. [deb.nick] estava tentando me convencer."

# game/scripts/c21/c21.rpy:2474
translate brazilian c21s005_DebRun_19916109:

    # deb "[lis] prefiere quedarse leyendo y tomando el sol. *Risa*"
    deb "[lis] prefere ficar em casa lendo e tomando sol. *Risos*"

# game/scripts/c21/c21.rpy:2475
translate brazilian c21s005_DebRun_0981270f:

    # mc "¿Qué estás leyendo?"
    mc "O que você está lendo?"

# game/scripts/c21/c21.rpy:2477
translate brazilian c21s005_DebRun_be0e08a0:

    # lis "Teoría política. Alguien me hizo pensar el otro día en el Jazz Corner y lo he cogido de la biblioteca de la universidad."
    lis "Teoria política. Alguém me fez lembrar do Jazz Corner outro dia, e eu peguei o livro emprestado da biblioteca da universidade."

# game/scripts/c21/c21.rpy:2478
translate brazilian c21s005_DebRun_ba8ee9ad:

    # mc "Siempre es bueno ampliar horizontes."
    mc "É sempre bom ampliar seus horizontes."

# game/scripts/c21/c21.rpy:2479
translate brazilian c21s005_DebRun_53c92852:

    # lis "No sé si me llevará a algo, pero al menos estoy leyendo información de la que no sabía nada."
    lis "Não sei se isso vai me levar a algum lugar, mas pelo menos estou lendo informações sobre as quais eu não sabia nada."

# game/scripts/c21/c21.rpy:2481
translate brazilian c21s005_DebRun_4d359ce3:

    # deb "[lis] for President! *Risa* Nuestro ejército sería el mejor vestido del mundo. ¡Giovanni Armani para todos!"
    deb "Para presidente! *Risos* Nosso exército seria o mais bem vestido do mundo. Giovanni Armani para todos!"

# game/scripts/c21/c21.rpy:2482
translate brazilian c21s005_DebRun_9cfe95ac:

    # mc "*Risa* Puede sonar a broma, pero posiblemente la votara dependiendo de su programa."
    mc "*Risos* Pode parecer piada, mas dependendo do programa dela, eu poderia votar nela."

# game/scripts/c21/c21.rpy:2484
translate brazilian c21s005_DebRun_0cf4a507:

    # lis "*Risa* Mi hermana no confiaría en mí ni como delegada de clase."
    lis "*Risos* Minha irmã não confiaria em mim nem para representante de turma."

# game/scripts/c21/c21.rpy:2485
translate brazilian c21s005_DebRun_e5c6e98f:

    # lis "Iros a correr antes de que se os haga más tarde. [kim] y [kat] ya deben estar allí."
    lis "Faça uma corrida antes que fique muito tarde. [kim] e [kat] já devem estar lá."

# game/scripts/c21/c21.rpy:2486
translate brazilian c21s005_DebRun_59f6c03a:

    # mc "Hasta luego, [lis]."
    mc "Até logo, [lis]."

# game/scripts/c21/c21.rpy:2488
translate brazilian c21s005_DebRun_f597b9c6:

    # mc "Me acabo de dar cuenta de que no llevas mochila hoy. ¿No llevas toalla para bañarte en el lago después de subir corriendo?"
    mc "Acabei de perceber que você não está carregando mochila hoje. Você não vai levar uma toalha para nadar no lago depois da corrida?"

# game/scripts/c21/c21.rpy:2489
translate brazilian c21s005_DebRun_772928e7:

    # mc "Yo la he cogido, y también el bañador."
    mc "Eu peguei, e o maiô também."

# game/scripts/c21/c21.rpy:2490
translate brazilian c21s005_DebRun_3057bb86:

    # deb "Mi toalla y el bikini van camino del lago. Lo hemos metido todo en la mochila de [kat] para que suba hasta allí con más peso."
