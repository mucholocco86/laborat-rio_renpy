translate french c17s002_ZeusArrival_972232bc:

    # mc "¿Me lo parece a mí o estás más cariñoso que el otro día?"
    mc "C'est moi, ou tu es plus affectueux que l'autre jour ?"

# game/scripts/c17/c17.rpy:2552
translate french c17s002_ZeusArrival_ec175848:

    # mad "Nunca lo he visto pedir caricias como te las pide a ti. Cuando vienen mis amigas se mete en mi habitación para no verlas. *Risa*"
    mad "Je ne l'ai jamais vu réclamer de l'affection comme il le fait avec toi. Quand mes amis viennent, il va dans ma chambre pour ne pas les voir. *Rires*"

# game/scripts/c17/c17.rpy:2554
translate french c17s002_ZeusArrival_97a8ac23:

    # zeu "¡Miau! (Tus amigas son como gallinas cuando se ríen. Este tipo te hace sonreír a ti. Hay que cuidarlo aunque no me traiga comida.)"
    zeu "Miaou ! (Vos amis sont comme des poulets quand ils rient. Lui, il vous fait sourire. On doit prendre soin de lui même s'il ne m'apporte pas à manger.)"

# game/scripts/c17/c17.rpy:2569
translate french c17s002_ZeusArrival_022da4c5:

    # mad "¿Qué quieres, Zeus? ¿Quieres que le enseñe la habitación? ¿Quieres ser la estrella?"
    mad "Que veux-tu, Zeus ? Veux-tu que je lui montre la chambre ? Veux-tu être la vedette ?"

# game/scripts/c17/c17.rpy:2571
translate french c17s002_ZeusArrival_8d53909c:

    # zeu "¡Miau! (¡Ya soy la estrella! Y lo verá en cuanto entre en la habitación.)"
    zeu "Miaou ! (C'est moi la star maintenant ! Et vous le verrez dès que vous entrerez dans la pièce.)"

# game/scripts/c17/c17.rpy:2572
translate french c17s002_ZeusArrival_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c17/c17.rpy:2573
translate french c17s002_ZeusArrival_aee85687:

    # mad "Mejor que te lo enseñe. No te rías de mí."
    mad "Je ferais mieux de te le montrer. Ne te moque pas de moi."

# game/scripts/c17/c17.rpy:2576
translate french c17s002_ZeusArrival_2acd21c9:

    # cat "¡Miau! (¡Vamos! ¡Entrad! ¡Que me vea en toda mi gloria!)"
    cat "Miaou ! (Allez ! Entrez ! Laissez-le me voir dans toute ma splendeur !)"

# game/scripts/c17/c17.rpy:2579
translate french c17s002_ZeusArrival_bc8da879:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Je ne m'attendais pas à ce que nous allions dans la chambre si tôt, mais... Zeus insiste."

# game/scripts/c17/c17.rpy:2581
translate french c17s002_ZeusArrival_e74ede7b:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Je ne pensais pas que tu voulais qu'on aille dans la chambre si tôt, mais si Zeus insiste..."

# game/scripts/c17/c17.rpy:2583
translate french c17s002_ZeusArrival_a7b673c1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Je n'avais pas prévu de vous emmener dans la chambre si tôt, mais Zeus insiste. Et moi aussi."

# game/scripts/c17/c17.rpy:2586
translate french c17s002_ZeusArrival_bc8da879_1:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Je ne m'attendais pas à ce que nous allions dans la chambre si tôt, mais... Zeus insiste."

# game/scripts/c17/c17.rpy:2588
translate french c17s002_ZeusArrival_e74ede7b_1:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Je ne pensais pas que tu voulais qu'on aille dans la chambre si tôt, mais si Zeus insiste..."

# game/scripts/c17/c17.rpy:2590
translate french c17s002_ZeusArrival_a7b673c1_1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Je n'avais pas prévu de vous emmener dans la chambre si tôt, mais Zeus insiste. Et moi aussi."

# game/scripts/c17/c17.rpy:2591
translate french c17s002_ZeusArrival_27c93be3:

    # mc "Mejor no llevarle la contraria, entonces."
    mc "Il vaut donc mieux ne pas le contredire."

# game/scripts/c17/c17.rpy:2593
translate french c17s002_ZeusArrival_dbc10c1d:

    # mc "¡Wow, Maddie! ¡No sabía que pintabas! Parece un templo dedicado a Zeus."
    mc "Waouh, Maddie ! Je ne savais pas que tu peignais ! On dirait un temple dédié à Zeus."

# game/scripts/c17/c17.rpy:2595
translate french c17s002_ZeusArrival_8a744446:

    # zeu "¡Miau! (¿Sólo lo parece? Maddie, vas a tener que esforzarte más.)"
    zeu "Miaou ! (Est-ce que ça en a l'air ? Maddie, il va falloir faire mieux.)"

# game/scripts/c17/c17.rpy:2596
translate french c17s002_ZeusArrival_a0536e0b:

    # mad "Solo pinto como hobby. Esa es la pared de la fantasía. Gírate."
    mad "Je ne peins que par loisir. Voilà le mur des rêves. Retourne-toi."

# game/scripts/c17/c17.rpy:2598
translate french c17s002_ZeusArrival_f26c6b98:

    # mc "*Risa* Me encantan todas, pero especialmente la del rockero."
    mc "*Rires* Je les aime tous, mais surtout celui du rockeur."

# game/scripts/c17/c17.rpy:2599
translate french c17s002_ZeusArrival_22c4f4c3:

    # mad "Me divertí mucho pintando esa. Y la que está como un tigre, la pinté el día que lo adopté."
    mad "J'ai pris beaucoup de plaisir à peindre celui-là. Et celui qui ressemble à un tigre, je l'ai peint le jour où je l'ai adopté."

# game/scripts/c17/c17.rpy:2601
translate french c17s002_ZeusArrival_0fd1a789:

    # zeu "¡Miau! (Ahí estaba yo, apuntando maneras y siendo fiero.)"
    zeu "Miaou ! (Me voilà, en train de montrer ma vraie nature et d'être féroce.)"

# game/scripts/c17/c17.rpy:2616
translate french c17s002_ZeusArrival_4ec8d291:

    # mc "¿Y ese cuadro? ¿Es en lo que estás trabajando ahora?"
    mc "Et ce tableau ? C'est sur ça que vous travaillez en ce moment ?"

# game/scripts/c17/c17.rpy:2618
translate french c17s002_ZeusArrival_7344a38d:

    # zeu "¡Miau! (¡Super-michi!)"
    zeu "Miaou ! (Super-chat !)"

# game/scripts/c17/c17.rpy:2619
translate french c17s002_ZeusArrival_2ebbe23f:

    # mad "[dap] me dijo que el domingo es su cumpleaños, el de [eri], y el de [emm]."
    mad "[dap] m'a dit que dimanche c'est son anniversaire, l'anniversaire de [eri] et l'anniversaire de [emm]."

# game/scripts/c17/c17.rpy:2620
translate french c17s002_ZeusArrival_d4b8601b:

    # mad "Le pregunté si le gustaría un cuadro y me dijo que sí. Este es para ella. Decidí hacerles un cuadro para cada una."
    mad "Je lui ai demandé si elle voulait un tableau et elle a dit oui. Celui-ci est pour elle. J'ai décidé de faire un tableau pour chacune d'elles."

# game/scripts/c17/c17.rpy:2622
translate french c17s002_ZeusArrival_36aeb1de:

    # zeu "*Grrr* ¡Miau! (Y con el de [emm] me dieron ganas de cagarme en tu almohada.)"
    zeu "*Grrr* Miaou ! (Et celui de [emm] m'a donné envie de faire caca sur ton oreiller.)"

# game/scripts/c17/c17.rpy:2623
translate french c17s002_ZeusArrival_b4a6ec6f:

    # mc "Supongo que te ha invitado a la comida del domingo, ¿no?"
    mc "Je suppose qu'il vous a invité à déjeuner dimanche, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:2638
translate french c17s002_ZeusArrival_8991d72d:

    # mad "Sí, me dijo que fuera a comer y me quedara para la partida de DnD. ¿Por qué?"
    mad "Oui, il m'a dit d'aller manger et de rester pour la partie de D&D. Pourquoi ?"

# game/scripts/c17/c17.rpy:2639
translate french c17s002_ZeusArrival_040470f4:

    # mc "Entonces tengo que contarte una cosa. Siéntate, por favor."
    mc "Alors, je dois vous dire quelque chose. Veuillez vous asseoir."

# game/scripts/c17/c17.rpy:2654
translate french c17s002_ZeusArrival_5f74a1af:

    # "Después de La Clonversación..."
    "Après la conversation sur les clones..."

# game/scripts/c17/c17.rpy:2655
translate french c17s002_ZeusArrival_7863e2a8:

    # mad "Es increíble. Pero me parece que tomáis demasiados riesgos explicándoselo a tanta gente. Yo incluida."
    mad "C'est incroyable. Mais je pense que tu prends trop de risques en l'expliquant à autant de gens. Moi y compris."

# game/scripts/c17/c17.rpy:2672
translate french c17s002_Rom1_4be7d4ea:

    # mc "Bueno... tú y yo aún no hemos hablado de lo que somos, pero creo que vamos hacia algún sitio donde la confianza es indispensable."
    mc "Bon... nous n'avons pas encore parlé de ce que nous sommes, mais je pense que nous nous dirigeons vers quelque chose où la confiance est essentielle."

# game/scripts/c17/c17.rpy:2674
translate french c17s002_Rom1_df81dc24:

    # mad "Gracias, [mc]. Creo que tenemos muchas cosas de las que hablar... después de que retrasaras la cita..."
    mad "Merci, [mc]. Je pense que nous avons beaucoup de choses à nous dire... après le report du rendez-vous..."

# game/scripts/c17/c17.rpy:2676
translate french c17s002_Rom1_a337f597:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. He pensado que... que era porque intenté chantajearte."
    mad "Un instant, j'ai cru que tu voulais annuler au lieu de reporter. J'ai pensé… que c'était parce que j'avais essayé de te faire chanter."

# game/scripts/c17/c17.rpy:2677
translate french c17s002_Rom1_535d5ef9:

    # mad "He empezado a montarme películas en mi mente diciéndome que la había cagado por intentarlo... que quizás lo habías pensado mejor y no querías estar conmigo..."
    mad "J'ai commencé à imaginer des choses, à me dire que j'avais tout gâché en essayant… que peut-être tu avais changé d'avis et que tu ne voulais plus être avec moi…"

# game/scripts/c17/c17.rpy:2678
translate french c17s002_Rom1_0e471ac5:

    # mc "No, Maddie. Empezamos esto de una forma que no me gustó, pero me está gustando a dónde va."
    mc "Non, Maddie. On a commencé d'une manière qui ne me plaisait pas, mais j'aime bien où ça nous mène."

# game/scripts/c17/c17.rpy:2680
translate french c17s002_Rom1_e27df326:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. Que no querías que nos viéramos."
    mad "Un instant, j'ai cru que tu voulais annuler plutôt que reporter. Que tu ne voulais pas qu'on se voie."

# game/scripts/c17/c17.rpy:2681
translate french c17s002_Rom1_425bf1d8:

    # mc "No, Maddie. Cuando fui a comprarte el disfraz, no tenía intención de empezar nada contigo, pero ahora me está gustando a dónde va esto."
    mc "Non, Maddie. Quand je suis allée t'acheter le costume, je n'avais pas l'intention de créer de problèmes avec toi, mais maintenant, j'aime bien où ça nous mène."

# game/scripts/c17/c17.rpy:2682
translate french c17s002_Rom1_1af405b2:

    # mc "Y creo que es el momento de comprobarlo, ¿no?"
    mc "Et je pense qu'il est temps de le découvrir, vous ne croyez pas ?"

# game/scripts/c17/c17.rpy:2685
translate french c17s002_Sub1_f1949ecd:

    # mc "Bueno, no creo que mi gatita vaya a hacer nada que me perjudique. A mí o a mi familia."
    mc "Eh bien, je ne pense pas que mon chaton puisse faire quoi que ce soit de mal à moi ou à ma famille."

# game/scripts/c17/c17.rpy:2686
translate french c17s002_Sub1_76b2116f:

    # mc "Sabes que espié a [mar] en el probador y has guardado el secreto. No por voluntad propia, pero lo has hecho."
    mc "Tu sais que j'ai espionné [mar] dans la cabine d'essayage et tu as gardé le secret. Pas volontairement, mais tu l'as fait."

# game/scripts/c17/c17.rpy:2687
translate french c17s002_Sub1_94622999:

    # mc "Y no creo que lo revelaras aunque te liberase de sea lo que sea lo que es esto."
    mc "Et je ne pense pas que tu le révélerais même si cela te libérait de quoi que ce soit."

# game/scripts/c17/c17.rpy:2689
translate french c17s002_Sub1_b864f71d:

    # mad "Nunca haría algo que os perjudique. Cuando has llamado para retrasar la cita... por un momento he pensado que querías cancelarla."
    mad "Je ne ferais jamais rien pour te faire du mal. Quand tu as appelé pour reporter le rendez-vous… j’ai cru un instant que tu voulais l’annuler."

# game/scripts/c17/c17.rpy:2690
translate french c17s002_Sub1_95b557c6:

    # mad "El corazón me ha dado un vuelco y he descubierto que me gusta lo que tenemos. Que quiero más."
    mad "Mon cœur a fait un bond, et j'ai réalisé que j'aimais ce que nous avions. Que j'en voulais plus."

# game/scripts/c17/c17.rpy:2691
translate french c17s002_Sub1_b4c822bc:

    # mad "Me acabas de llamar gatita y he notado mariposas en el estómago. Quiero ser tu gatita, [mc]. Me gusta sentirme indefensa en tus brazos."
    mad "Tu viens de m'appeler chaton et j'ai des papillons dans le ventre. Je veux être ton chaton, [mc]. J'aime me sentir vulnérable dans tes bras."

# game/scripts/c17/c17.rpy:2692
translate french c17s002_Sub1_d82d413c:

    # mc "Eres mi gatita, pero no consiste en que estés indefensa. Consiste en que nos lo pasemos bien los dos, no sólo yo."
    mc "Tu es mon chaton, mais ça ne veut pas dire que tu es sans défense. Ça veut dire qu'on passe tous les deux un bon moment, pas seulement moi."

# game/scripts/c17/c17.rpy:2693
translate french c17s002_Sub1_efdb86d5:

    # mc "Y creo que es el momento de empezar a hacerlo."
    mc "Et je pense qu'il est temps de commencer à le faire."

# game/scripts/c17/c17.rpy:2696
translate french c17s002_Dom1_28ef5b11:

    # mc "Creo que es algo que debes saber. Sabes que espié a [mar] en el probador y has guardado el secreto."
    mc "Je pense que tu devrais le savoir. Tu sais que j'ai espionné [mar] dans la cabine d'essayage et tu as gardé le secret."

# game/scripts/c17/c17.rpy:2697
translate french c17s002_Dom1_4258d6c5:

    # mc "Forzándome a esta relación, pero lo has hecho."
    mc "Tu m'as forcée à entrer dans cette relation, mais tu l'as fait."

# game/scripts/c17/c17.rpy:2698
translate french c17s002_Dom1_4c56a055:

    # mc "Y estoy seguro de que, si dejásemos esta relación, seguirías guardándolo."
    mc "Et je suis sûre que même si nous mettions fin à cette relation, tu la maintiendrais."

# game/scripts/c17/c17.rpy:2700
translate french c17s002_Dom1_eb23b7db:

    # mad "No tengo intención de hacer nada que te perjudique. Si acabarais todos en prisión me quedaría sin mi juguete."
    mad "Je n'ai aucune intention de vous faire du mal. Si vous finissiez tous en prison, je serais privé de mon jouet."

# game/scripts/c17/c17.rpy:2701
translate french c17s002_Dom1_b7b1e079:

    # mad "Y sí, puedo guardar los secretos que sean necesarios. Me gusta tenerte. Poseerte. ¿Quién sabe si algún día algo más?"
    mad "Et oui, je peux garder tous les secrets nécessaires. J'aime t'avoir. Te posséder. Qui sait, peut-être un jour quelque chose de plus ?"

# game/scripts/c17/c17.rpy:2702
translate french c17s002_Dom1_939762a1:

    # mad "Cuándo has llamado para retrasar la cita por un momento he pensado en qué haría si, en vez de retrasarla, la quisieras cancelar."
    mad "Lorsque vous avez appelé pour reporter le rendez-vous, je me suis brièvement demandé ce que je ferais si, au lieu de le reporter, vous vouliez l'annuler."

# game/scripts/c17/c17.rpy:2703
translate french c17s002_Dom1_a9161cd3:

    # mad "¿Contarle el secreto a [mar] o no? He decidido que no lo haría. Quiero que seas mi juguete, pero quiero que lo seas por voluntad propia, no porque te sientas obligado."
    mad "Dois-je révéler le secret à [mar] ou non ? J’ai décidé de ne pas le faire. Je veux que tu sois mon jouet, mais je veux que tu sois consentant, pas obligé."

# game/scripts/c17/c17.rpy:2704
translate french c17s002_Dom1_eb3149a8:

    # mc "Un día, cuando esté autorizado para hacerlo, te contaré otro secreto. Uno que te demostrará que, si estoy aquí, es porque quiero."
    mc "Un jour, quand j'en aurai l'autorisation, je vous confierai un autre secret. Un secret qui vous prouvera que si je suis là, c'est parce que je le veux."

# game/scripts/c17/c17.rpy:2706
translate french c17s002_Dom1_c018a585:

    # mad "Pues, como premio por ello y por la confianza, y sabiendo que te gusta, te voy a permitir de nuevo que me comas. Lo hiciste muy bien el otro día."
    mad "Eh bien, en récompense de cela et de votre confiance, et sachant que cela vous plaît, je vais vous laisser me manger à nouveau. Vous avez été très sage l'autre jour."

# game/scripts/c17/c17.rpy:2707
translate french c17s002_Dom1_d0ff99b0:

    # mc "Como mi ama desee. Déjame que te libere de ese mono."
    mc "Comme le souhaite ma maîtresse. Laissez-moi vous libérer de ce singe."

# game/scripts/c17/c17.rpy:2730
translate french c17s003_DapScaTests_4a7fcb5a:

    # centered "{size=+20}{b}DÍA 19 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}JOUR 19 – SAMEDI{/b}{/size}"

# game/scripts/c17/c17.rpy:2734
translate french c17s003_DapScaTests_2d236d61:

    # "Después de desayunar coges un par de tests de embarazo y vas a la habitación de [dap] y Scarlett."
    "Après le petit-déjeuner, tu prends deux tests de grossesse et tu vas dans la chambre de [dap] et Scarlett."

# game/scripts/c17/c17.rpy:2736
translate french c17s003_DapScaTests_786f9ea0:

    # "Después de desayunar coges un test de embarazo y vas a la habitación de [dap] y Scarlett."
    "Après le petit-déjeuner, tu fais un test de grossesse et tu vas dans la chambre de Scarlett."

# game/scripts/c17/c17.rpy:2738
translate french c17s003_DapScaTests_a1f6b6b6:

    # "También llevas el test de ADN que Amanda te dio ayer. No sabes cuál de los tests tienes más ganas de que salga positivo."
    "Tu as aussi le test ADN qu'Amanda t'a donné hier. Tu ne sais pas quel test tu as le plus hâte de voir se révéler positif."

# game/scripts/c17/c17.rpy:2741
translate french c17s003_DapScaTests_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c17/c17.rpy:2742
translate french c17s003_DapScaTests_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "C'est moi. Puis-je entrer ?"

# game/scripts/c17/c17.rpy:2743
translate french c17s003_DapScaTests_7cc88e14:

    # dap "*A través de la puerta* Sí, entra."
    dap "*Par la porte* Oui, entrez."

# game/scripts/c17/c17.rpy:2745
translate french c17s003_DapScaTests_8defc866:

    # mc "Buenos días. Ha llegado el vampiro. Saaaangreeee. *Risa*"
    mc "Bonjour. Le vampire est arrivé. Sanglant ! *Rires*"

# game/scripts/c17/c17.rpy:2748
translate french c17s003_DapScaTests_0b787fe4:

    # dap "Buenos días, mi amor."
    dap "Bonjour mon amour."

# game/scripts/c17/c17.rpy:2749
translate french c17s003_DapScaTests_53d46762:

    # dap "No va a doler, ¿verdad?"
    dap "Ça ne va pas faire de mal, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:2750
translate french c17s003_DapScaTests_b0f06ca1:

    # mc "Es sólo un pinchazo."
    mc "Ce n'est qu'une crevaison."

# game/scripts/c17/c17.rpy:2752
translate french c17s003_DapScaTests_e4fd25d6:

    # dap "Buenos días, [mc]."
    dap "Bonjour, [mc]."

# game/scripts/c17/c17.rpy:2755
translate french c17s003_DapScaTests_4ac57d7f:

    # sca "Buenos días, guapísimo."
    sca "Bonjour, beau gosse."

# game/scripts/c17/c17.rpy:2756
translate french c17s003_DapScaTests_9a653b5a:

    # sca "Tendremos el resultado mañana a estas horas, ¿no?"
    sca "Nous aurons le résultat demain à cette heure-ci, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:2757
translate french c17s003_DapScaTests_402ea49e:

    # mc "Sí. 24 horas para tenerlo."
    mc "Oui. Vous l'aurez en 24 heures."

# game/scripts/c17/c17.rpy:2760
translate french c17s003_DapScaTests_0dd349a4:

    # dap "Si los dos salieran positivos sería un regalo de cumpleaños perfecto."
    dap "Si les deux tests sont positifs, ce serait le cadeau d'anniversaire parfait."

# game/scripts/c17/c17.rpy:2761
translate french c17s003_DapScaTests_ea37cb2d:

    # dap "Confirmaríamos que voy a ser madre y tía el día de mi cumpleaños."
    dap "Nous confirmons que je vais être maman et tante le jour de mon anniversaire."

# game/scripts/c17/c17.rpy:2764
translate french c17s003_DapScaTests_7b1ca3d6:

    # dap "Si os saliera positivo sería un regalo de cumpleaños perfecto. Confirmaríais que voy a ser tía el día de mi cumpleaños."
    dap "Si tu étais testé positif, ce serait le cadeau d'anniversaire idéal. Tu me confirmerais que je vais être tata le jour de mon anniversaire."

# game/scripts/c17/c17.rpy:2767
translate french c17s003_DapScaTests_39666345:

    # sca "Tengo ganas de convertirme en la Tía Scarlett."
    sca "Je veux devenir tante Scarlett."

# game/scripts/c17/c17.rpy:2769
