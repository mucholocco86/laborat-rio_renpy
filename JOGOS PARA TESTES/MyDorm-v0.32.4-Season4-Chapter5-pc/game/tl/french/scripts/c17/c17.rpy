translate french c17s003_TellKiara_a85e276c:

    # eil "¿Crees que [mc] sería un buen padre, Mamá?"
    eil "Tu penses que [mc] ferait un bon père, maman ?"

# game/scripts/c17/c17.rpy:3046
translate french c17s003_TellKiara_9ad11d18:

    # kia "Claro. Ya sabes que lo quiero mucho. Y no lo querría si no pensara que es bueno."
    kia "Bien sûr. Tu sais que je l'aime beaucoup. Et je ne l'aimerais pas si je ne le trouvais pas bon."

# game/scripts/c17/c17.rpy:3047
translate french c17s003_TellKiara_9b89d860:

    # mcp "(Aunque llevas un par de días distante conmigo.)"
    mcp "(Bien que tu aies été distant(e) avec moi ces derniers jours.)"

# game/scripts/c17/c17.rpy:3049
translate french c17s003_TellKiara_057728d8:

    # eil "¿Crees que alguna vez me haría un morado como el que llevas en el brazo?"
    eil "Tu crois que je pourrais un jour avoir un bleu comme celui que tu as sur le bras ?"

# game/scripts/c17/c17.rpy:3051
translate french c17s003_TellKiara_267d1553:

    # kia "No..."
    kia "Non..."

# game/scripts/c17/c17.rpy:3053
translate french c17s003_TellKiara_7697d4c3:

    # eil "¿Crees que alguna vez me haría desear irme de casa? ¿Con mi hija?"
    eil "Crois-tu que j'aurais un jour envie de quitter la maison ? Avec ma fille ?"

# game/scripts/c17/c17.rpy:3055
translate french c17s003_TellKiara_267d1553_1:

    # kia "No..."
    kia "Non..."

# game/scripts/c17/c17.rpy:3057
translate french c17s003_TellKiara_de91c1a8:

    # eil "Y ¿crees que nuestra hija tendrá miedo de verlo cuando esté embarazada?"
    eil "Et pensez-vous que notre fille aura peur de le voir lorsqu'elle sera enceinte ?"

# game/scripts/c17/c17.rpy:3058
translate french c17s003_TellKiara_bf236e97:

    # eil "¿Que ella tendrá miedo de que le dé una paliza que le haga perder el bebé?"
    eil "Aura-t-elle peur qu'il la batte si violemment qu'elle perde le bébé ?"

# game/scripts/c17/c17.rpy:3060
translate french c17s003_TellKiara_1311138e:

    # kia "¡Por supuesto que no! Ya te he dicho..."
    kia "Bien sûr que non ! Je vous l'ai déjà dit..."

# game/scripts/c17/c17.rpy:3063
translate french c17s003_TellKiara_af04ff79:

    # kia "... que es..."
    kia "... qu'est-ce que c'est..."

# game/scripts/c17/c17.rpy:3065
translate french c17s003_TellKiara_996415d1:

    # kia "... un buen hombre."
    kia "...un homme bien."

# game/scripts/c17/c17.rpy:3068
translate french c17s003_TellKiara_81602856:

    # kia "¡No puede ser! ¿Estás embarazada?"
    kia "Impossible ! Tu es enceinte ?"

# game/scripts/c17/c17.rpy:3070
translate french c17s003_TellKiara_28947d76:

    # eil "Sí, Mamá. Estamos embarazados."
    eil "Oui, maman. Nous attendons un enfant."

# game/scripts/c17/c17.rpy:3072
translate french c17s003_TellKiara_a026f41b:

    # kia "¡Felicidades, cielo!"
    kia "Félicitations, chérie !"

# game/scripts/c17/c17.rpy:3073
translate french c17s003_TellKiara_9b348af2:

    # eil "Gracias, Mamá. Estamos muy ilusionados."
    eil "Merci maman. Nous sommes tellement contents."

# game/scripts/c17/c17.rpy:3075
translate french c17s003_TellKiara_608976be:

    # kia "Felicidades a ti también, Papá."
    kia "Félicitations à toi aussi, papa."

# game/scripts/c17/c17.rpy:3076
translate french c17s003_TellKiara_b2a43c7a:

    # mcp "(Ahora entiendo lo de \"más frío que el abrazo de una suegra\".)"
    mcp "(Maintenant je comprends l'expression « plus froid qu'une étreinte de belle-mère ».)"

# game/scripts/c17/c17.rpy:3077
translate french c17s003_TellKiara_887f84c9:

    # mc "Gracias, Kiara."
    mc "Merci, Kiara."

# game/scripts/c17/c17.rpy:3079
translate french c17s003_TellKiara_c0dccabd:

    # kia "¿Ya habéis pensado en nombres?"
    kia "Avez-vous déjà pensé à des noms ?"

# game/scripts/c17/c17.rpy:3081
translate french c17s003_TellKiara_f2bbe5f0:

    # eil "No, aún no pero..."
    eil "Non, pas encore, mais..."

# game/scripts/c17/c17.rpy:3082
translate french c17s003_TellKiara_b9a0ee5e:

    # "A partir de ese momento empieza una larga conversación sobre nombres de bebé, consejos sobre cómo llevar el embarazo, qué hacer y qué no hacer, el trabajo de Eileen..."
    "À partir de ce moment, une longue conversation s'engage sur les prénoms de bébé, les conseils pour gérer la grossesse, les choses à faire et à ne pas faire, le travail d'Eileen..."

# game/scripts/c17/c17.rpy:3083
translate french c17s003_TellKiara_cdd77395:

    # "Kiara dice un montón de cosas en las que no habías pensado y otras que con un poco de sentido común cualquiera podría deducir."
    "Kiara dit beaucoup de choses auxquelles vous n'aviez pas pensé, et d'autres que n'importe qui pourrait déduire avec un peu de bon sens."

# game/scripts/c17/c17.rpy:3084
translate french c17s003_TellKiara_5afbf202:

    # "Crees que vas a comprarte un libro de esos sobre bebés."
    "Tu penses acheter un de ces livres sur les bébés."

# game/scripts/c17/c17.rpy:3086
translate french c17s003_TellKiara_8e5da9c6:

    # eil "Deberíamos ir bajando para ayudar con la comida. Amanda tiene que estar a punto de llegar."
    eil "Nous devrions descendre aider à préparer le repas. Amanda devrait arriver d'une minute à l'autre."

# game/scripts/c17/c17.rpy:3087
translate french c17s003_TellKiara_6527cbbe:

    # mc "Podéis quedaros aquí un rato más hablando de esas cosas que no se habla delante del padre. Ya voy yo a ver si necesitan ayuda."
    mc "Tu peux rester ici encore un peu pour parler de ces choses dont tu ne parles pas devant ton père. Je vais voir si tu as besoin d'aide."

# game/scripts/c17/c17.rpy:3089
translate french c17s003_TellKiara_f79ec32b:

    # eil "Vale, mi amor. Te veo abajo en un rato."
    eil "D'accord, mon amour. Je te rejoins en bas dans quelques minutes."

# game/scripts/c17/c17.rpy:3090
translate french c17s003_TellKiara_fb559340:

    # mc "Hasta ahora, mi vida. Te quiero."
    mc "Jusqu'à présent, mon amour. Je t'aime."

# game/scripts/c17/c17.rpy:3091
translate french c17s003_TellKiara_9c439131:

    # eil "Yo también."
    eil "Moi aussi."

# game/scripts/c17/c17.rpy:3093
translate french c17s003_TellKiara_b0624b53:

    # kia "Si necesitáis ayuda, avisadnos."
    kia "Si vous avez besoin d'aide, faites-le nous savoir."

# game/scripts/c17/c17.rpy:3094
translate french c17s003_TellKiara_006e759d:

    # mc "Tranquila, bajad en 20 minutos más o menos."
    mc "Ne vous inquiétez pas, vous serez en bas dans une vingtaine de minutes."

# game/scripts/c17/c17.rpy:3137
translate french c17s003_AmandaLunch_a30e4a01:

    # "Cuando llegas a la cocina, ya está casi todo hecho. Ayudas haciendo el all i oli y preparas las bebidas."
    "Quand vous arrivez en cuisine, presque tout est déjà prêt. Vous donnez un coup de main en préparant l'aïoli et les boissons."

# game/scripts/c17/c17.rpy:3144
translate french c17s003_AmandaLunch_4d213cf7:

    # "Al poco rato llega Amanda. Esta vez ha venido en la moto de Eva."
    "Amanda arrive peu après. Cette fois, elle est venue sur la moto d'Eva."

# game/scripts/c17/c17.rpy:3149
translate french c17s003_AmandaLunch_ce547223:

    # ama "No sé si llego demasiado pronto..."
    ama "Je ne sais pas si j'arrive trop tôt..."

# game/scripts/c17/c17.rpy:3150
translate french c17s003_AmandaLunch_3c5d873e:

    # mc "No te preocupes. Llegas justo a tiempo."
    mc "Ne vous inquiétez pas. Vous êtes parfaitement à l'heure."

# game/scripts/c17/c17.rpy:3152
translate french c17s003_AmandaLunch_9e70d621:

    # ama "Buenos días, [mc]."
    ama "Bonjour, [mc]."

# game/scripts/c17/c17.rpy:3153
translate french c17s003_AmandaLunch_194f0505:

    # mc "Buenos días, Amanda. Pasa, te están esperando."
    mc "Bonjour Amanda. Entrez, ils vous attendent."

# game/scripts/c17/c17.rpy:3155
translate french c17s003_AmandaLunch_c030015f:

    # "La comida sigue la misma dinámica que la cena, aunque esta vez nadie hace llorar a Amanda."
    "Le déjeuner se déroule de la même manière que le dîner, mais cette fois-ci, personne ne fait pleurer Amanda."

# game/scripts/c17/c17.rpy:3156
translate french c17s003_AmandaLunch_317792d2:

    # "Echas de menos aquellos días en los que comíais sentados, pero le estás cogiendo el gusto a estas comidas de pie."
    "Vous regrettez l'époque où vous mangiez assis, mais vous vous habituez à ces repas pris debout."

# game/scripts/c17/c17.rpy:3158
translate french c17s003_AmandaLunch_962d0e9f:

    # "Puedes ver que Megan y [mar] tienen una larga conversación entre ellas, apartadas de todo el mundo."
    "On peut voir Megan et [mar] avoir une longue conversation entre elles, à l'écart de tout le monde."

# game/scripts/c17/c17.rpy:3160
translate french c17s003_AmandaLunch_06b98e14:

    # "Amanda pasa más tiempo con las mujeres esta vez. Ayer se retuvieron un poco, pero hoy quieren su ración de la nueva incorporación a la familia."
    "Amanda passe plus de temps avec les femmes cette fois-ci. Hier, elles étaient un peu réservées, mais aujourd'hui, elles veulent profiter du nouveau membre de la famille."

# game/scripts/c17/c17.rpy:3161
translate french c17s003_AmandaLunch_6a455a9d:

    # "Amanda tardará un poco en dejar de sentirse como un animal exhibido."
    "Il faudra du temps à Amanda pour cesser de se sentir comme un animal exposé."

# game/scripts/c17/c17.rpy:3163
translate french c17s003_AmandaLunch_a3ab48a9:

    # "Esta vez las chicas tienen una nueva presa. Megan."
    "Cette fois, les filles ont une nouvelle proie : Megan."

# game/scripts/c17/c17.rpy:3165
translate french c17s003_AmandaLunch_5afeb14d:

    # nor "Amanda nos ha contado las noticias. Ya no corremos peligro."
    nor "Amanda nous a annoncé la nouvelle. Nous ne sommes plus en danger."

# game/scripts/c17/c17.rpy:3166
translate french c17s003_AmandaLunch_1ad31beb:

    # mc "Son grandes noticias. Aaron parece estar haciendo un trabajo fantástico."
    mc "C'est une excellente nouvelle. Aaron semble faire un travail formidable."

# game/scripts/c17/c17.rpy:3167
translate french c17s003_AmandaLunch_1709dc65:

    # mc "Aún estoy dudando de si debería aceptar el trabajo en Aruba... eso si no vendemos, claro. No sé si estaré a la altura."
    mc "J'hésite encore à accepter le poste à Aruba… enfin, si la vente ne se concrétise pas, bien sûr. Je ne sais pas si j'en serai capable."

# game/scripts/c17/c17.rpy:3169
translate french c17s003_AmandaLunch_9e14d892:

    # nor "[mar] y yo no queremos vender la empresa."
    nor "[mar] et je ne souhaite pas vendre l'entreprise."

# game/scripts/c17/c17.rpy:3170
translate french c17s003_AmandaLunch_6a6a997a:

    # nor "Hacerlo significaría que habrá más chicas como Eva y Amanda. Mas niñas como Fiona."
    nor "Cela signifierait qu'il y aurait plus de filles comme Eva et Amanda. Plus de filles comme Fiona."

# game/scripts/c17/c17.rpy:3171
translate french c17s003_AmandaLunch_d1cc2333:

    # mc "Yo también creo que deberíamos mantenerla en manos de la familia."
    mc "Je crois également que nous devrions laisser cela entre les mains de la famille."

# game/scripts/c17/c17.rpy:3173
translate french c17s003_AmandaLunch_7c22c332:

    # nor "Y cuando te refieres a familia, también te refieres a Eva y a Amanda, ¿no?"
    nor "Et quand vous parlez de famille, vous parlez aussi d'Eva et d'Amanda, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:3174
translate french c17s003_AmandaLunch_6f883578:

    # mc "Para mí, ellas son las principales víctimas de NTR. No sólo ellas. También Aaron y el resto de los clones masculinos. Incluidos los que entraron en casa."
    mc "À mon avis, ce sont eux les principales victimes de NTR. Non seulement eux, mais aussi Aaron et les autres clones masculins, y compris ceux qui se sont introduits par effraction dans la maison."

# game/scripts/c17/c17.rpy:3175
translate french c17s003_AmandaLunch_9dc882bc:

    # mc "Y, obviamente, ellas son familia. Ya viste cómo se puso Amanda ayer cuando se sintió aceptada. No quiero que nadie les robe eso. Ya le han robado su infancia."
    mc "Et, évidemment, c'est leur famille. Vous avez vu la réaction d'Amanda hier, quand elle s'est sentie acceptée. Je ne veux pas qu'on leur vole ça. On leur a déjà volé leur enfance."

# game/scripts/c17/c17.rpy:3177
translate french c17s003_AmandaLunch_7c4baacf:

    # nor "[dap] y [eri] tampoco quieren vender. Estoy muy orgullosa de ellas."
    nor "[dap] et [eri] ne veulent pas vendre non plus. J'en suis très fier."

# game/scripts/c17/c17.rpy:3178
translate french c17s003_AmandaLunch_c934662b:

    # nor "[emm] dice que tiene dudas, pero no ha dicho sobre qué."
    nor "[emm] dit qu'il a des doutes, mais n'a pas dit à propos de quoi."

# game/scripts/c17/c17.rpy:3179
translate french c17s003_AmandaLunch_a97a789f:

    # mc "Hablaré con [emm] sobre ello. Ayer ya quería gastarse el dinero en un coche deportivo... rosa."
    mc "Je vais en parler à [emm]. Hier, il voulait déjà dépenser l'argent pour une voiture de sport rose."

# game/scripts/c17/c17.rpy:3180
translate french c17s003_AmandaLunch_2f1c36fd:

    # mc "Ya sabes que a veces necesita un empujón en la dirección correcta."
    mc "Vous savez qu'il a parfois besoin d'un petit coup de pouce pour aller dans la bonne direction."

# game/scripts/c17/c17.rpy:3181
translate french c17s003_AmandaLunch_190da926:

    # mc "Ahora te voy a dejar un momento. Tengo que hablar con Kiara y quiero aprovechar ahora que se ha quedado sola."
    mc "Je vais vous laisser un instant. J'ai besoin de parler à Kiara et je veux profiter du fait qu'elle est seule maintenant."

# game/scripts/c17/c17.rpy:3183
translate french c17s003_AmandaLunch_b028b239:

    # nor "Ve. Es casi tan popular como Amanda y Eva. Es difícil que esté sola más de unos minutos. También es novedad, parece mentira que sólo sea su cuarto día en casa."
    nor "Regardez. Elle est presque aussi populaire qu'Amanda et Eva. On la voit rarement seule plus de quelques minutes. C'est aussi assez inhabituel ; on a du mal à croire que ça ne fait que quatre jours qu'elle est rentrée."

# game/scripts/c17/c17.rpy:3187
translate french c17s003_AmandaLunch_e6e912ec:

    # mc "¿Qué tal, Kiara?"
    mc "Comment vas-tu, Kiara ?"

# game/scripts/c17/c17.rpy:3189
translate french c17s003_AmandaLunch_1b271947:

    # kia "Muy contenta con las noticias de antes. *Susurrando* Aunque ser abuela me haga sentir vieja."
    kia "Je suis tellement contente des nouvelles d'avant. *Chuchotement* Même si être grand-mère me fait me sentir vieille."

# game/scripts/c17/c17.rpy:3190
translate french c17s003_AmandaLunch_62e5c781:

    # kia "Y alucinando con lo rápido que se está integrando todo el mundo."
    kia "Et je suis étonné de la rapidité avec laquelle tout le monde s'intègre."

# game/scripts/c17/c17.rpy:3192
translate french c17s003_AmandaLunch_933ac119:

    # kia "Alucinando con lo rápido que se está integrando todo el mundo."
    kia "Je suis impressionné par la rapidité avec laquelle tout le monde s'intègre."

# game/scripts/c17/c17.rpy:3193
translate french c17s003_AmandaLunch_3737e771:

    # mc "¿Y tú? ¿Qué tal llevas la integración?"
    mc "Et vous ? Comment se passe le processus d’intégration ?"

# game/scripts/c17/c17.rpy:3195
translate french c17s003_AmandaLunch_802b957c:

    # kia "Genial. Me siento muy a gusto aquí, con vosotros."
    kia "Super. Je me sens très à l'aise ici avec vous tous."

# game/scripts/c17/c17.rpy:3196
translate french c17s003_AmandaLunch_eb881cfe:

    # kia "Te tengo que dejar. Tenía que comentarle algo a Betty."
    kia "Je dois y aller. Je devais dire quelque chose à Betty."

# game/scripts/c17/c17.rpy:3197
translate french c17s003_AmandaLunch_ec12d61d:

    # mc "¿He hecho algo malo, Kiara?"
    mc "Ai-je fait quelque chose de mal, Kiara ?"

# game/scripts/c17/c17.rpy:3199
translate french c17s003_AmandaLunch_36159e09:

    # kia "¿Por qué dices eso?"
    kia "Pourquoi dites-vous cela ?"

# game/scripts/c17/c17.rpy:3200
translate french c17s003_AmandaLunch_4c4ce05e:

    # mc "Me da la impresión de que me estás evitando desde hace un par de días."
    mc "J'ai l'impression que vous m'évitez depuis quelques jours."

# game/scripts/c17/c17.rpy:3201
translate french c17s003_AmandaLunch_30fd5f10:

    # kia "No... no te estoy evitando."
    kia "Non… je ne vous évite pas."

# game/scripts/c17/c17.rpy:3202
translate french c17s003_AmandaLunch_d4d39668:

    # mc "¿Entonces qué pasa? Desde que fuimos a tu casa parece que no estás cómoda cuando yo estoy alrededor."
    mc "Alors, que se passe-t-il ? Depuis que nous sommes allés chez toi, tu n'as pas l'air à l'aise en ma présence."

# game/scripts/c17/c17.rpy:3204
translate french c17s003_AmandaLunch_e01c898b:

    # mc "¿Es por lo que pasó en la cocina? ¿Por mis relaciones? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Est-ce à cause de ce qui s'est passé dans la cuisine ? À cause de mes relations ? À cause des baisers ? À cause de ce qui s'est passé chez toi avec Solomon ?"

# game/scripts/c17/c17.rpy:3206
translate french c17s003_AmandaLunch_810f89d7:

    # mc "¿Es porque estoy con Eileen? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Est-ce parce que je suis avec Eileen ? À cause des baisers ? À cause de ce qui s'est passé chez toi avec Solomon ?"

# game/scripts/c17/c17.rpy:3208
translate french c17s003_AmandaLunch_5db4f1fd:

    # mc "¿Es por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Est-ce à cause des baisers ? À cause de ce qui s'est passé chez toi avec Solomon ?"

# game/scripts/c17/c17.rpy:3210
translate french c17s003_AmandaLunch_85f5d6ea:

    # kia "No es que esté incómoda a tu alrededor..."
    kia "Ce n'est pas que je sois mal à l'aise en ta présence..."

# game/scripts/c17/c17.rpy:3211
translate french c17s003_AmandaLunch_e6e4d5d1:

    # kia "No estoy acostumbrada a que nadie, excepto Eileen, me defienda como hiciste tú en casa."
    kia "Je n'ai pas l'habitude que quelqu'un, à part Eileen, me défende comme tu le faisais à la maison."

# game/scripts/c17/c17.rpy:3213
translate french c17s003_AmandaLunch_adcd819b:

    # kia "Por un momento me sentí como se deben sentir las princesas en los cuentos de hadas. Protegida. Segura."
    kia "Pendant un instant, j'ai ressenti ce que doivent ressentir les princesses des contes de fées. Protégées. En sécurité."

# game/scripts/c17/c17.rpy:3219
translate french c17s003_AmandaLunch_4fc78872:

    # kia "Después... cuando nos abrazamos los tres en el parque... me sentí rara."
    kia "Après... quand nous nous sommes enlacés tous les trois dans le parc... je me suis sentie bizarre."

# game/scripts/c17/c17.rpy:3220
translate french c17s003_AmandaLunch_d18e63c2:

    # mc "¿Rara? ¿Por qué? Sólo fue un abrazo. Siempre te han gustado mis abrazos."
    mc "Bizarre ? Pourquoi ? Ce n'était qu'un câlin. Tu as toujours aimé mes câlins."

# game/scripts/c17/c17.rpy:3222
translate french c17s003_AmandaLunch_963696e9:

    # kia "Si te lo explicara no lo entenderías. Y además me sentiría estúpida explicándotelo."
    kia "Si je te l'expliquais, tu ne comprendrais pas. Et puis, j'aurais l'impression d'être bête de te l'expliquer."

# game/scripts/c17/c17.rpy:3223
translate french c17s003_AmandaLunch_bd357dbf:

    # mc "Puedes probar a hacerlo. Hay gente que dice que no soy tan tonto como parezco."
    mc "Vous pouvez essayer. Certains disent que je ne suis pas aussi bête que j'en ai l'air."

# game/scripts/c17/c17.rpy:3224
translate french c17s003_AmandaLunch_ffbec445:

    # kia "No es eso. Pero no te preocupes. No es que hayas hecho nada... malo."
    kia "Ce n'est pas ça. Mais ne t'inquiète pas. Tu n'as rien fait de mal."

# game/scripts/c17/c17.rpy:3226
translate french c17s003_AmandaLunch_820442c5:

    # "Kiara empieza a comprobar la cocina, claramente buscando a alguien con quien hablar para librarse de ti."
    "Kiara commence à fouiller la cuisine, cherchant visiblement quelqu'un à qui parler pour se débarrasser de vous."

# game/scripts/c17/c17.rpy:3228
translate french c17s003_AmandaLunch_c1437193:

    # kia "Debería ir a hablar con..."
    kia "Je devrais aller parler à..."

# game/scripts/c17/c17.rpy:3230
translate french c17s003_AmandaLunch_a636911b:

    # mc "Ve con Betty si tienes que ir, pero no huyas de mí, por favor. No huyas de nosotros."
    mc "Va avec Betty s'il le faut, mais ne m'abandonne pas, je t'en prie. Ne nous abandonne pas."

# game/scripts/c17/c17.rpy:3232
translate french c17s003_AmandaLunch_8f0de41c:

    # kia "No quiero huir, [mc]."
    kia "Je ne veux pas m'enfuir, [mc]."

# game/scripts/c17/c17.rpy:3233
translate french c17s003_AmandaLunch_67d1140b:

    # kia "Es... es... complicado..."
    kia "C'est... c'est... compliqué..."

# game/scripts/c17/c17.rpy:3237
translate french c17s003_AmandaLunch_b68a7078:

    # kia "¡No! ¡No es complicado!"
    kia "Non ! Ce n'est pas compliqué !"

# game/scripts/c17/c17.rpy:3239
translate french c17s003_AmandaLunch_9f178ca7:

    # kia "*Susurrando* ¡Vas a ser el padre de mis nietos!"
    kia "*Chuchotant* Tu vas être le père de mes petits-enfants !"

# game/scripts/c17/c17.rpy:3241
translate french c17s003_AmandaLunch_be9da35d:

    # kia "*Susurrando* ¡Estás con mi hija!"
    kia "*Chuchotant* Tu es avec ma fille !"

# game/scripts/c17/c17.rpy:3242
translate french c17s003_AmandaLunch_979136c5:

    # kia "¡Soy una mujer casada!"
    kia "Je suis une femme mariée !"

# game/scripts/c17/c17.rpy:3243
translate french c17s003_AmandaLunch_ae009029:

    # mc "¿Qué? ¿Qué tiene que ver eso?"
    mc "Quoi ? Quel rapport avec quoi que ce soit ?"

# game/scripts/c17/c17.rpy:3245
translate french c17s003_AmandaLunch_d5ea279d:

    # kia "Ya te he dicho que no lo entenderías si te lo explicaba."
    kia "Je t'ai déjà dit que tu ne comprendrais pas si je te l'expliquais."

# game/scripts/c17/c17.rpy:3246
translate french c17s003_AmandaLunch_8064e907:

    # mc "Pero no me has explicado nada..."
    mc "Mais vous ne m'avez rien expliqué..."

# game/scripts/c17/c17.rpy:3248
translate french c17s003_AmandaLunch_4431a7d9:

    # mc "¿Qué me he perdido?"
    mc "Qu'est-ce que j'ai manqué ?"

# game/scripts/c17/c17.rpy:3250
translate french c17s003_AmandaLunch_3a905abb:

    # bet "Al final resultará que no eres tan listo como yo pensaba."
    bet "Au final, il s'avérera que tu n'es pas aussi intelligent que je le pensais."

# game/scripts/c17/c17.rpy:3252
translate french c17s003_AmandaLunch_7e715a92:

    # mc "Hola, Tía Betty. ¿Qué quieres decir?"
    mc "Bonjour, tante Betty. Que voulez-vous dire ?"

# game/scripts/c17/c17.rpy:3253
translate french c17s003_AmandaLunch_a58eca9e:

    # bet "No eres capaz de descubrir lo que le pasa a Kiara por ti mismo, ¿verdad?"
    bet "Tu ne peux pas deviner tout seul ce qui ne va pas chez Kiara, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:3254
translate french c17s003_AmandaLunch_def038df:

    # mc "¿Sinceramente? No tengo ni idea de lo que está pasando ni de a qué te refieres."
    mc "Honnêtement ? Je n'ai aucune idée de ce qui se passe ni de quoi vous parlez."

# game/scripts/c17/c17.rpy:3256
translate french c17s003_AmandaLunch_982f271f:

    # bet "¿Quieres que te dibuje un plano o prefieres ir a ciegas?"
    bet "Voulez-vous que je vous fasse un plan ou préférez-vous y aller à l'aveuglette ?"

# game/scripts/c17/c17.rpy:3257
translate french c17s003_AmandaLunch_5e22a342:

    # mc "Una cosa es ir a ciegas, pero ahora voy sin plano, sin linterna, de noche, con los ojos vendados y las manos atadas."
    mc "Être aveugle, c'est une chose, mais là, je me retrouve sans carte, sans lampe torche, de nuit, les yeux bandés et les mains liées."

# game/scripts/c17/c17.rpy:3258
translate french c17s003_AmandaLunch_f594e452:

    # bet "Ven conmigo detrás de la isla. Podremos hablar más tranquilos allí."
    bet "Viens avec moi derrière l'île. On pourra parler plus tranquillement là-bas."

# game/scripts/c17/c17.rpy:3260
translate french c17s003_AmandaLunch_2e2d7e07:

    # bet "¿Qué crees que le pasa a Kiara?"
    bet "À votre avis, quel est le problème avec Kiara ?"

# game/scripts/c17/c17.rpy:3261
translate french c17s003_AmandaLunch_0c1070b9:

    # mc "No tengo ni idea. Todo iba genial hasta el día que fuimos a su casa. Con lo que lo único que se me ocurre es que fuera por lo que pasó con Solomon."
    mc "Je n'en ai aucune idée. Tout se passait bien jusqu'au jour où nous sommes allés chez elle. La seule explication qui me vienne à l'esprit, c'est que c'est à cause de ce qui s'est passé avec Solomon."

# game/scripts/c17/c17.rpy:3262
translate french c17s003_AmandaLunch_2f111123:

    # bet "Estamos hablando del mismo día en que empezamos los saludos con besos otra vez, ¿no? Culpa mía."
    bet "On parle bien du jour où on a recommencé à s'embrasser, n'est-ce pas ? Autant pour moi."

# game/scripts/c17/c17.rpy:3263
translate french c17s003_AmandaLunch_00e8602f:

    # mc "Sí, claro. Fue el mismo día."
    mc "Oui, bien sûr. C'était le même jour."

# game/scripts/c17/c17.rpy:3265
translate french c17s003_AmandaLunch_3898f5d9:

    # bet "Después de lo que pasó en la cocina."
    bet "Après ce qui s'est passé dans la cuisine."

# game/scripts/c17/c17.rpy:3267
translate french c17s003_AmandaLunch_df1b9f4a:

    # bet "Y de que descubriera que estás con Samantha."
    bet "Et qu'il a découvert que tu es avec Samantha."

# game/scripts/c17/c17.rpy:3268
translate french c17s003_AmandaLunch_4a80ff50:

    # mc "Sí, pero sigo sin ver que tiene que ver eso. Hasta que llegamos a su casa todo iba bien. Cuando nos fuimos también."
    mc "Oui, mais je ne vois toujours pas le rapport. Tout allait bien jusqu'à notre arrivée chez elle. Et tout allait bien aussi à notre départ."

# game/scripts/c17/c17.rpy:3269
translate french c17s003_AmandaLunch_c0a91882:

    # mc "Pero desde que volvimos a casa está distante conmigo. No entiendo ese cambio en los diez minutos que hay de su casa a aquí."
    mc "Mais depuis notre retour à la maison, il est distant avec moi. Je ne comprends pas ce changement survenu en seulement dix minutes entre chez lui et ici."

# game/scripts/c17/c17.rpy:3271
translate french c17s003_AmandaLunch_9f95f68a:

    # bet "¿Te apetece jugar a un juego?"
    bet "Aimeriez-vous jouer à un jeu ?"

# game/scripts/c17/c17.rpy:3272
translate french c17s003_AmandaLunch_02614fa0:

    # mc "Preferiría que me dijeras que crees que le pasa."
    mc "Je préférerais que vous me disiez ce qui, selon vous, ne va pas chez lui."

# game/scripts/c17/c17.rpy:3274
translate french c17s003_AmandaLunch_546dfd31:

    # bet "No te lo voy a decir. Podría haber sacado conclusiones equivocadas. Este juego lo inventó Olivia para [emm], pero también puede servir para ti."
    bet "Je ne vais pas te le dire. J'ai peut-être tiré des conclusions hâtives. Olivia a inventé ce jeu pour [emm], mais il pourrait aussi te convenir."

# game/scripts/c17/c17.rpy:3275
translate french c17s003_AmandaLunch_598ca576:

    # mc "Adelante. Juguemos. Explícame las normas."
    mc "Vas-y. Jouons. Explique-moi les règles."

# game/scripts/c17/c17.rpy:3276
translate french c17s003_AmandaLunch_2e734c76:

    # bet "Las normas son fáciles. Yo hago preguntas y tú respondes tras pensar cinco segundos."
    bet "Les règles sont simples. Je pose des questions et vous répondez après avoir réfléchi pendant cinq secondes."

# game/scripts/c17/c17.rpy:3277
translate french c17s003_AmandaLunch_1efa927c:

    # mc "*Risa* Ahora entiendo por qué Meemaw lo inventó para [emm]. Adelante."
    mc "*Rires* Maintenant je comprends pourquoi Mémé l'a inventé pour [emm]. Vas-y."

# game/scripts/c17/c17.rpy:3279
translate french c17s003_AmandaLunch_54e5419f:

    # bet "Fuiste al rescate de Kiara y Eileen el día que abandonaron su casa, ¿verdad?"
    bet "Vous êtes allé secourir Kiara et Eileen le jour où elles ont quitté leur maison, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:3280
translate french c17s003_AmandaLunch_809797bc:

    # mc "Sí. Para eso no necesito pensar cinco segundos."
    mc "Oui. Je n'ai pas besoin de réfléchir cinq secondes pour ça."

# game/scripts/c17/c17.rpy:3281
translate french c17s003_AmandaLunch_64969848:

    # bet "Cierto. La defendiste cuando apareció Solomon. ¿Cómo crees que se debe sentir después de que la rescataras y la defendieras?"
    bet "C'est exact. Vous l'avez défendue lorsque Salomon est apparu. Imaginez ce qu'elle a dû ressentir après que vous l'ayez secourue et défendue ?"

# game/scripts/c17/c17.rpy:3282
translate french c17s003_AmandaLunch_7fe66ad7:

    # mc "Para esta tampoco tengo que pensar. Me lo ha dicho ella. Protegida y segura."
    mc "Je n'ai pas à y penser non plus, m'a-t-elle dit. Protégée et en sécurité."

# game/scripts/c17/c17.rpy:3285
translate french c17s003_AmandaLunch_2db649db:

    # bet "¿Qué crees que debe pensar de tus relaciones?"
    bet "Que pensez-vous qu'il devrait penser de vos relations ?"

# game/scripts/c17/c17.rpy:3287
translate french c17s003_AmandaLunch_0fd388f1:

    # bet "¿Y de que, además, estés con su hija?"
    bet "Et que dire du fait que vous êtes aussi avec sa fille ?"

# game/scripts/c17/c17.rpy:3288
translate french c17s003_AmandaLunch_7758f356:

    # mc "No me lo he planteado. No tiene por qué pensar nada."
    mc "Je n'y ai pas pensé. Tu n'as pas à penser à quoi que ce soit."

# game/scripts/c17/c17.rpy:3290
translate french c17s003_AmandaLunch_ad5c65c9:

    # bet "Yo en su lugar pensaría que no te importa la edad que tengan las mujeres con las que sales."
    bet "Si j'étais vous, je penserais que l'âge des femmes que vous fréquentez ne vous importe pas."

# game/scripts/c17/c17.rpy:3291
translate french c17s003_AmandaLunch_8cb31597:

    # mc "Y acertarías. La edad es sólo un número y no le presto atención en absoluto."
    mc "Et vous auriez raison. L'âge n'est qu'un chiffre, et je n'y prête aucune attention."

# game/scripts/c17/c17.rpy:3293
translate french c17s003_AmandaLunch_fe4a498a:

    # bet "No hagas público eso o todas las abuelas de California empezarán a perseguirte. *Risa*"
    bet "Ne le dis à personne, sinon toutes les grands-mères de Californie vont te tomber dessus ! *Rires*"

# game/scripts/c17/c17.rpy:3294
translate french c17s003_AmandaLunch_74ec8853:

    # mc "¿Todas? ¿Tú también? *Risa*"
    mc "Tous ? Toi aussi ? *Rires*"

# game/scripts/c17/c17.rpy:3295
translate french c17s003_AmandaLunch_2e83fd20:

    # bet "*Risa* Yo no soy abuela. Solo vieja."
    bet "*Rires* Je ne suis pas grand-mère. Juste vieille."

# game/scripts/c17/c17.rpy:3297
translate french c17s003_AmandaLunch_09676202:

    # bet "Pero volvamos a Kiara antes de que digas algo inapropiado."
    bet "Mais revenons à Kiara avant que vous ne disiez quelque chose d'inapproprié."

# game/scripts/c17/c17.rpy:3298
translate french c17s003_AmandaLunch_1dbb2843:

    # bet "Un muchacho la rescata dos veces de su marido y la hace sentir protegida y segura. Un muchacho a quien le da lo mismo la edad de su pareja."
    bet "Un jeune homme la sauve à deux reprises de son mari et lui procure un sentiment de protection et de sécurité. Un jeune homme qui ne se soucie pas de l'âge de sa compagne."

# game/scripts/c17/c17.rpy:3301
translate french c17s003_AmandaLunch_6a3f24fc:

    # bet "Entonces tenemos a un muchacho que la ha rescatado dos veces de su marido y que la hace sentir protegida y segura."
    bet "Nous avons donc un garçon qui l'a sauvée deux fois de son mari et qui lui procure un sentiment de protection et de sécurité."

# game/scripts/c17/c17.rpy:3303
translate french c17s003_AmandaLunch_3f3d0a2c:

    # bet "Y que, para ella, es lo suficientemente bueno como para estar con su hija. Eso es importante y lo tienes que ver con mentalidad de madre."
    bet "Et pour elle, il est assez bien pour être avec sa fille. C'est important, et il faut le voir du point de vue d'une mère."

# game/scripts/c17/c17.rpy:3317
translate french c17s003_AmandaLunch_bb31baa0:

    # bet "Ese muchacho sale con varias mujeres a la vez por lo que ella sabe."
    bet "D'après elle, ce type sort avec plusieurs femmes en même temps."

# game/scripts/c17/c17.rpy:3319
translate french c17s003_AmandaLunch_623275ee:

    # bet "Ese muchacho está libre como un pájaro."
    bet "Ce garçon est libre comme l'air."

# game/scripts/c17/c17.rpy:3321
translate french c17s003_AmandaLunch_4a91fc4f:

    # bet "Pero la novia de ese muchacho es su hija."
    bet "Mais la petite amie de ce garçon est sa fille."

# game/scripts/c17/c17.rpy:3323
translate french c17s003_AmandaLunch_11e3bbf0:

    # bet "Suma a todo eso que te encanta dar abrazos y a ella le encanta que se los des."
    bet "Ajoutez à cela le fait que vous adorez faire des câlins et qu'elle adore quand vous lui en faites."

# game/scripts/c17/c17.rpy:3324
translate french c17s003_AmandaLunch_e2a743f5:

    # bet "Añade los saludos con besos y... ¡Boom!"
    bet "Ajoutez des salutations avec des baisers et... Boum !"

# game/scripts/c17/c17.rpy:3325
translate french c17s003_AmandaLunch_9cdd2fe5:

    # mc "¿A qué te refieres con \"Boom\"?"
    mc "Que voulez-vous dire par « Boum » ?"

# game/scripts/c17/c17.rpy:3327
translate french c17s003_AmandaLunch_85f307e2:

    # bet "Me estás tomando el pelo, ¿no? No puede ser que no lo estés pillando."
    bet "Vous vous moquez de moi, n'est-ce pas ? Impossible que vous n'ayez pas compris."

# game/scripts/c17/c17.rpy:3328
translate french c17s003_AmandaLunch_95b302bf:

    # mc "No, en serio."
    mc "Non, sérieusement."

# game/scripts/c17/c17.rpy:3330
translate french c17s003_AmandaLunch_edd2c8f1:

    # bet "Vamos a ver si cambiando la perspectiva lo pillas."
    bet "Voyons si changer de perspective vous aide à comprendre."

# game/scripts/c17/c17.rpy:3331
translate french c17s003_AmandaLunch_6297f023:

    # bet "Imagínate que conoces a una mujer más mayor que tú, fuerte, guapa, sexy y adorable. Pongamos que tiene el físico de Kiara. Además, te hace sentir apreciado."
    bet "Imaginez rencontrer une femme plus âgée que vous, forte, belle, sexy et adorable. Disons qu'elle a le physique de Kiara. Et qu'elle vous fait vous sentir apprécié."

# game/scripts/c17/c17.rpy:3332
translate french c17s003_AmandaLunch_e01423d2:

    # mc "OK."
    mc "D'ACCORD."

# game/scripts/c17/c17.rpy:3334
translate french c17s003_AmandaLunch_52e1a46b:

    # bet "Ahora imagínate que [emm] es un chico y que sale con ella. Tú consideras que esa mujer es buena para [emm]-chico. Que hace que sea mejor persona saliendo con ella."
    bet "Imaginez maintenant que [emm] soit un homme et qu'il sorte avec elle. Vous pensez que cette femme est bonne pour [emm]. Que sortir avec elle le rend meilleur."

# game/scripts/c17/c17.rpy:3335
translate french c17s003_AmandaLunch_a5699cb3:

    # bet "Si es lo suficientemente para tu hermano pequeño, también lo sería para ti."
    bet "Si c'est suffisant pour ton petit frère, ce sera suffisant pour toi aussi."

# game/scripts/c17/c17.rpy:3336
translate french c17s003_AmandaLunch_01b2cb94:

    # mc "OK. Espero que a [emm]-chico no le guste demasiado el rosa. Además nunca intentaría nada con nadie que saliera con [emm]-chico."
    mc "OK. J'espère que le garçon [emm] n'aime pas trop le rose. Et puis, je ne tenterais jamais rien avec quelqu'un qui sort avec le garçon [emm]."

# game/scripts/c17/c17.rpy:3338
translate french c17s003_AmandaLunch_adbc9adf:

    # bet "¡Hush! Esa mujer es muy cariñosa con todo el mundo, tú incluido. Te besa y te abraza a la mínima oportunidad."
    bet "Chut ! Cette femme est très affectueuse avec tout le monde, y compris toi. Elle t'embrasse et te serre dans ses bras à la moindre occasion."

# game/scripts/c17/c17.rpy:3339
translate french c17s003_AmandaLunch_1a6b87ff:

    # bet "Te defiende cuando te atacan. Incluso llegando a pelearse con otras mujeres por defenderte."
    bet "Elle te défend quand tu es agressé. Elle va même jusqu'à se battre avec d'autres femmes pour te protéger."

# game/scripts/c17/c17.rpy:3340
translate french c17s003_AmandaLunch_a60430eb:

    # bet "¿Puedes asegurarme de que no te sentirías atraído por ella?"
    bet "Pouvez-vous me garantir que vous ne seriez pas attiré par elle ?"

# game/scripts/c17/c17.rpy:3341
translate french c17s003_AmandaLunch_af624d75:

    # mc "En mi fuero interno seguro que sí, pero si está saliendo con [emm]-chico me mantendría alejado... Código de hombres."
    mc "Au fond de moi, j'en suis sûr, mais si elle sort avec un mec, je resterais à l'écart... Code d'honneur masculin."

# game/scripts/c17/c17.rpy:3344
translate french c17s003_AmandaLunch_c3698f84:

    # bet "Pues creo que lo mismo le está pasando a Kiara. Sales con su hija. Y eres lo suficientemente bueno para ella."
    bet "Je crois que la même chose arrive à Kiara. Tu sors avec sa fille. Et tu es assez bien pour elle."

# game/scripts/c17/c17.rpy:3346
translate french c17s003_AmandaLunch_76b502d7:

    # bet "Pues creo que lo mismo le está pasando a Kiara. Saliste con su hija. Y eras lo suficientemente bueno para ella."
    bet "Je crois que la même chose arrive à Kiara. Tu es sorti avec sa fille. Et tu étais assez bien pour elle."

# game/scripts/c17/c17.rpy:3347
translate french c17s003_AmandaLunch_be9e9726:

    # bet "Y eres el tipo fuerte, guapo, sexy y adorable que la rescata, la defiende, la abraza y la besa. A quien no le importa la edad de una mujer."
    bet "Et toi, tu es cet homme fort, beau, sexy et adorable qui la sauve, la défend, la serre dans ses bras et l'embrasse. Celui qui se fiche de l'âge d'une femme."

# game/scripts/c17/c17.rpy:3348
translate french c17s003_AmandaLunch_9252f8f6:

    # mc "¿Qué? Creo que te equivocas, Betty. Kiara nunca me vería así. Fue ella la que me besó en la cocina. Si se sintiera así no lo habría hecho."
    mc "Quoi ? Je crois que tu te trompes, Betty. Kiara ne me verrait jamais comme ça. C'est elle qui m'a embrassée dans la cuisine. Si elle avait ressenti ça, elle ne l'aurait pas fait."

# game/scripts/c17/c17.rpy:3350
translate french c17s003_AmandaLunch_a03ce963:

    # bet "Mmmm... tienes razón... a menos que cambiase de opinión cuando te peleaste con su marido. Que se diera cuenta entonces."
    bet "Mmm... tu as raison... à moins qu'elle n'ait changé d'avis après ta dispute avec son mari. Elle a dû s'en rendre compte à ce moment-là."

# game/scripts/c17/c17.rpy:3351
translate french c17s003_AmandaLunch_79ab0ad9:

    # mc "Mmmm... Bueno... ha sido desde entonces que está distante..."
    mc "Mmm... Eh bien... il est devenu distant depuis..."

# game/scripts/c17/c17.rpy:3353
translate french c17s003_AmandaLunch_6cb9022f:

    # bet "¡Sí! ¡Lo sabía! ¡Soy buenísima en esto!"
    bet "Oui ! Je le savais ! Je suis vraiment douée pour ça !"

# game/scripts/c17/c17.rpy:3354
translate french c17s003_AmandaLunch_da4fc251:

    # mc "Tengo que hablar con ella."
    mc "Je dois lui parler."

# game/scripts/c17/c17.rpy:3356
translate french c17s003_AmandaLunch_280c3ff7:

    # bet "Mejor no lo hagas. Dale tiempo para que se aclare las ideas. Para que ella llegue a sus propias conclusiones."
    bet "Il vaut mieux ne rien faire. Laissons-lui le temps de se recentrer et de tirer ses propres conclusions."

# game/scripts/c17/c17.rpy:3357
translate french c17s003_AmandaLunch_9adcbc03:

    # bet "De todas formas, ¿qué le ibas a decir? ¿Que hemos estado analizando su comportamiento y que pensamos que puede ser que se sienta atraída por ti?"
    bet "Bref, qu'est-ce que tu comptais lui dire ? Que nous avons analysé son comportement et que nous pensons qu'elle pourrait être attirée par toi ?"

# game/scripts/c17/c17.rpy:3358
translate french c17s003_AmandaLunch_4816671f:

    # mc "Tienes razón... mejor dejar pasar unos días."
    mc "Vous avez raison... il vaut mieux attendre quelques jours."

# game/scripts/c17/c17.rpy:3359
translate french c17s003_AmandaLunch_518092d6:

    # mc "Pero cambiando de tema... El tipo ese fuerte, guapo, sexy y adorable... Teniendo en cuenta que Kiara nunca ha dicho nada de eso... ¿Es cómo me ves tú?"
    mc "Mais changeons de sujet… Ce type fort, beau, sexy et adorable… Sachant que Kiara n’a jamais rien dit de tel… C’est comme ça que tu me vois ?"

# game/scripts/c17/c17.rpy:3361
translate french c17s003_AmandaLunch_5e4c3634:

    # bet "¿Qué? ¿Yo? ¡Tengo edad para ser tu abuela!"
    bet "Quoi ? Moi ? Je suis assez vieille pour être ta grand-mère !"

# game/scripts/c17/c17.rpy:3362
translate french c17s003_AmandaLunch_c873c513:

    # mc "Ya sabes que para mí la edad solo es un número. *Risa* Pero tu rubor ha contestado mi pregunta."
    mc "Tu sais que pour moi, l'âge n'est qu'un chiffre. *Rires* Mais ton rougissement a répondu à ma question."

