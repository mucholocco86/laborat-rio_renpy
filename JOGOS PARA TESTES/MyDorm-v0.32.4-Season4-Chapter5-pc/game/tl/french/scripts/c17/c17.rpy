    eil "J'aimerais lui dire au plus vite, si cela ne vous dérange pas. Et j'aimerais qu'on le lui dise ensemble."

# game/scripts/c17/c17.rpy:1196
translate french c17s001_EileenPregnancyResult_5c4eabf8:

