

# game/scripts/c17/c17.rpy:365
translate french c17s001_AmandaDinner_d0af28a5:

    # mc "¡Amanda! ¡Estás preciosa!"
    mc "Amanda ! Tu es magnifique !"

# game/scripts/c17/c17.rpy:367
translate french c17s001_AmandaDinner_afb86a32:

    # ama "Gracias, [mc]. Has dicho que para la cena sería mejor un vestido y..."
    ama "Merci, [mc]. Vous avez dit qu'une robe serait plus appropriée pour le dîner et..."

# game/scripts/c17/c17.rpy:368
translate french c17s001_AmandaDinner_8f743db4:

    # mc "Y has elegido uno que te queda perfecto. ¿Vamos?"
    mc "Et vous en avez choisi un qui vous convient parfaitement. On y va ?"

# game/scripts/c17/c17.rpy:371
translate french c17s001_AmandaDinner_24f1a87e:

    # ama "Sí, por favor, no quiero llegar tarde y que se lleven una mala primera impresión."
    ama "Oui, s'il vous plaît, je ne veux pas être en retard et qu'ils aient une mauvaise première impression."

# game/scripts/c17/c17.rpy:372
translate french c17s001_AmandaDinner_5defb41a:

    # mc "Amanda, ¿realmente crees que alguien va a mirar el reloj cuando te vean?"
    mc "Amanda, tu crois vraiment que quelqu'un va regarder sa montre en te voyant ?"

# game/scripts/c17/c17.rpy:373
translate french c17s001_AmandaDinner_93251535:

    # mc "Todo el mundo está deseando conocerte, y más aún después del éxito de Eva durante la comida."
    mc "Tout le monde a hâte de vous rencontrer, surtout après le succès d'Eva lors du déjeuner."

# game/scripts/c17/c17.rpy:375
translate french c17s001_AmandaDinner_483c8d97:

    # ama "Gracias, [mc]. No sé qué has hecho, pero ha vuelto entusiasmada."
    ama "Merci, [mc]. Je ne sais pas ce que vous avez fait, mais elle est revenue ravie."

# game/scripts/c17/c17.rpy:376
translate french c17s001_AmandaDinner_74a7e7da:

    # mc "¿No tenéis cámaras en la cocina de [nor]?"
    mc "Vous n'avez pas de caméras dans la cuisine de [nor] ?"

# game/scripts/c17/c17.rpy:378
translate french c17s001_AmandaDinner_80c2d0a9:

    # ama "Sí, pero he dejado de mirarlas cuando le has presentado a [emm]."
    ama "Oui, mais j'ai arrêté de les regarder quand tu lui as présenté [emm]."

# game/scripts/c17/c17.rpy:379
translate french c17s001_AmandaDinner_68787dac:

    # ama "Me estaba entrando envidia cuando [mar] y [nor] han abrazado a Eva. Más envidia todavía con [eri]."
    ama "J'étais jaloux quand [mar] et [nor] ont pris Eva dans leurs bras. Encore plus jaloux quand [eri]."

# game/scripts/c17/c17.rpy:381
translate french c17s001_AmandaDinner_2db2420f:

    # ama "Pero con [emm] me ha entrado frustración. Ya estaba frustrada por cómo había tratado a [mar] esta mañana, pero..."
    ama "Mais je suis de plus en plus frustré par [emm]. J'étais déjà frustré par la façon dont j'ai traité [mar] ce matin, mais…"

# game/scripts/c17/c17.rpy:382
translate french c17s001_AmandaDinner_a5f2d08d:

    # mc "No le des más vueltas. Es [emm], y muchas veces solo necesita que alguien le haga pensar antes de darse cuenta de que su reacción ha sido... excesiva."
    mc "N'y réfléchis pas trop. C'est [emm], et souvent il a juste besoin que quelqu'un le fasse réfléchir avant de réaliser que sa réaction était... excessive."

# game/scripts/c17/c17.rpy:384
translate french c17s001_AmandaDinner_5bd12c5f:

    # ama "Lo sé. Después de estos meses viendo a alguien con mi cara actuando como yo no lo haría nunca... te aseguro que lo sé."
    ama "Je sais. Après tous ces mois passés à voir quelqu'un qui me ressemble se comporter d'une manière que je ne ferais jamais… je vous assure, je sais."

# game/scripts/c17/c17.rpy:385
translate french c17s001_AmandaDinner_235c1e4d:

    # mc "¿Por eso te teñiste de rubio?"
    mc "C'est pour ça que tu as teint tes cheveux en blond ?"

# game/scripts/c17/c17.rpy:388
translate french c17s001_AmandaDinner_780b076e:

    # ama "¿Q-qué? ¡N-no! Lo hice por si acaso... había que seguiros a distancia. Un color diferente de pelo puede... cambiar la percepción del observador."
    ama "Quoi ? Non ! Je l’ai fait au cas où… on devait te surveiller. Une couleur de cheveux différente peut… changer la perception de celui qui observe."

# game/scripts/c17/c17.rpy:389
translate french c17s001_AmandaDinner_07e61db0:

    # mc "Ah, OK. Como en las películas cuando los espías se ponen una peluca."
    mc "Ah, d'accord. Comme dans les films, quand les espions mettent une perruque."

# game/scripts/c17/c17.rpy:390
translate french c17s001_AmandaDinner_c5b80ac4:

    # ama "Sí... más o menos... ¿nos vamos?"
    ama "Oui... plus ou moins... on y va ?"

# game/scripts/c17/c17.rpy:392
translate french c17s001_AmandaDinner_5f7d4099:

    # "Tenéis una conversación tensa en el coche. Casi tienes que sacarle las palabras una a una."
    "Vous avez une conversation tendue dans la voiture. Vous devez pratiquement lui arracher les mots un par un."

# game/scripts/c17/c17.rpy:393
translate french c17s001_AmandaDinner_be1ffe17:

    # "Por fin llegáis a casa."
    "Vous êtes enfin arrivé chez vous."

# game/scripts/c17/c17.rpy:395
translate french c17s001_AmandaDinner_c697453e:

    # mc "¿Nerviosa?"
    mc "Nerveux?"

# game/scripts/c17/c17.rpy:396
translate french c17s001_AmandaDinner_6ad6f704:

    # ama "Sí, mucho. Lo de ayer fue... inesperado."
    ama "Oui, tout à fait. Ce qui s'est passé hier était… inattendu."

# game/scripts/c17/c17.rpy:397
translate french c17s001_AmandaDinner_b81ae450:

    # ama "Lo que me ha contado hoy Eva de lo bien que se lo ha pasado... no sé... me da miedo."
    ama "Ce qu'Eva m'a raconté aujourd'hui, à quel point elle s'est amusée... je ne sais pas... ça me fait peur."

# game/scripts/c17/c17.rpy:399
translate french c17s001_AmandaDinner_35099ae7:

    # ama "¿Qué pasa si después vendéis la empresa? ¿Qué pasa si, una vez pase la novedad, no queréis que formemos parte de la familia?"
    ama "Que se passera-t-il si vous vendez l'entreprise plus tard ? Que se passera-t-il si, une fois l'effet de nouveauté passé, vous ne souhaitez plus que nous fassions partie de la famille ?"

# game/scripts/c17/c17.rpy:400
translate french c17s001_AmandaDinner_b17e72d0:

    # mc "Eso no va a pasar, Amanda. Al menos lo último."
    mc "Ça n'arrivera pas, Amanda. Du moins, pas la deuxième option."

# game/scripts/c17/c17.rpy:401
translate french c17s001_AmandaDinner_3096ee28:

    # mc "No sé si venderemos la empresa o no. Será una decisión familiar, y aunque yo vote una cosa, ellas cinco pueden votar lo contrario."
    mc "Je ne sais pas si nous vendrons l'entreprise ou non. Ce sera une décision familiale, et même si je vote d'une certaine manière, les cinq autres pourraient voter différemment."

# game/scripts/c17/c17.rpy:403
translate french c17s001_AmandaDinner_a97ffd9f:

    # ama "*Gruñido* Lo sé. Y no saber lo que van a hacer... me tiene nerviosa. Para mí, esta cena no es solo para conocerlas, aunque sea lo más importante..."
    ama "*Grogne* Je sais. Et ne pas savoir ce qu'ils vont faire… ça me stresse. Pour moi, ce dîner ne se résume pas à faire leur connaissance, même si c'est le plus important…"

# game/scripts/c17/c17.rpy:404
translate french c17s001_AmandaDinner_45dc4b83:

    # mc "Es también para que te conozcan, para que les pongan cara a las verdaderas víctimas de NTR. Vosotras, Aaron, y el resto, ¿no?"
    mc "C'est aussi pour que les gens apprennent à vous connaître, pour qu'ils puissent mettre un visage sur les véritables victimes de NTR. Toi, Aaron, et vous tous, n'est-ce pas ?"

# game/scripts/c17/c17.rpy:406
translate french c17s001_AmandaDinner_7181eaea:

    # ama "Eva estaba equivocada. Pillas las cosas más rápido de lo que parece."
    ama "Eva avait tort. Tu apprends plus vite que tu ne le crois."

# game/scripts/c17/c17.rpy:407
translate french c17s001_AmandaDinner_88dd2c30:

    # ama "Depende a quién le vendáis la empresa, si no os podemos pagar lo que pidáis, habrá más Aarons y más Erics. Más Fionas."
    ama "Tout dépend à qui vous vendez l'entreprise. Si nous ne pouvons pas payer le prix demandé, il y aura d'autres Aaron, d'autres Eric, d'autres Fiona."

# game/scripts/c17/c17.rpy:408
translate french c17s001_AmandaDinner_41f1e3d6:

    # mc "Si mi voto decanta la balanza, no venderemos. Pero dudo que mi voto sirva de mucho."
    mc "Si mon vote fait pencher la balance, nous ne vendrons pas. Mais je doute que mon vote change grand-chose."

# game/scripts/c17/c17.rpy:410
translate french c17s001_AmandaDinner_6a923f5c:

    # ama "¿Crees que van a querer vender? Entiendo que es mucho dinero..."
    ama "Pensez-vous qu'ils voudront vendre ? Je comprends que c'est une somme importante…"

# game/scripts/c17/c17.rpy:411
translate french c17s001_AmandaDinner_b23d8247:

    # mc "[nor] y [mar] no van a querer que otras chicas o chicos pasen por lo que habéis pasado vosotras. Y estoy seguro de que no sabemos ni la mitad de lo que habéis pasado."
    mc "[nor] et [mar] ne veulent pas que d'autres filles ou garçons vivent ce que tu as vécu. Et je suis sûr que nous ne connaissons même pas la moitié de ce que tu as enduré."

# game/scripts/c17/c17.rpy:412
translate french c17s001_AmandaDinner_93e5b0ff:

    # mc "[dap] ya está haciendo planes para trabajar en NTR. Mejor hacerlo como accionista, ¿no?"
    mc "[dap] prévoit déjà de travailler chez NTR. Autant le faire en tant qu'actionnaire, non ?"

# game/scripts/c17/c17.rpy:413
translate french c17s001_AmandaDinner_5e892a1c:

    # mc "Y [eri] es tan empática que, en cuanto entienda por lo que habéis pasado, estará en la misma posición que [mar] y [nor]."
    mc "Et [eri] est tellement empathique que, dès qu'elle comprendra ce que vous avez vécu, elle sera dans la même position que [mar] et [nor]."

# game/scripts/c17/c17.rpy:414
translate french c17s001_AmandaDinner_59511ffd:

    # mc "Mi voto y el de [emm] no servirían de nada."
    mc "Mon vote et celui de [emm] seraient inutiles."

# game/scripts/c17/c17.rpy:416
translate french c17s001_AmandaDinner_737bd48b:

    # ama "¿Votarías por venderla?"
    ama "Voteriez-vous pour la vendre ?"

# game/scripts/c17/c17.rpy:417
translate french c17s001_AmandaDinner_edffed05:

    # mc "No. Si votase por venderla sería para vendérosla a vosotros, pero creo que es mejor no hacerlo. Creo que me gusta la idea de hacer que el viejo NTR desaparezca."
    mc "Non. Si j'avais voté pour la vente, ce serait pour vous la vendre, mais je pense qu'il vaut mieux ne pas le faire. J'aime bien l'idée de faire disparaître l'ancien NTR."

# game/scripts/c17/c17.rpy:418
translate french c17s001_AmandaDinner_943e0d4f:

    # mc "Crear algo nuevo con lo que tenemos entre manos. Aunque no sé dónde encajaríais vosotras, Aaron, o el resto de los clones en esa visión."
    mc "Créer quelque chose de nouveau avec ce que nous avons sous la main. Même si j'ignore quelle place vous, Aaron, ou les autres clones, occuperiez dans cette vision."

# game/scripts/c17/c17.rpy:420
translate french c17s001_AmandaDinner_472929fa:

    # ama "Sobre eso... tengo varias ideas. ¿Te parece bien que tomemos un café un día y lo hablamos?"
    ama "À ce propos… J’ai plusieurs idées. Seriez-vous intéressé(e) par un café un de ces jours pour en discuter ?"

# game/scripts/c17/c17.rpy:421
translate french c17s001_AmandaDinner_1842c921:

    # mc "Me parece genial. Ahora deberíamos entrar."
    mc "Ça a l'air super. On devrait y aller maintenant."

# game/scripts/c17/c17.rpy:425
translate french c17s001_AmandaDinner_edb24cc0:

    # mc "Bueno, parece que toda la familia está aquí. *Risa* Vas a sufrir más que Eva."
    mc "Eh bien, on dirait que toute la famille est là. *Rires* Tu vas souffrir plus qu'Eva."

# game/scripts/c17/c17.rpy:426
translate french c17s001_AmandaDinner_863fdac8:

    # ama "*Susurrando* Yo soporto... disfruto más de los abrazos que ella."
    ama "*Chuchotant* Je peux gérer ça... J'aime les câlins plus qu'elle."

# game/scripts/c17/c17.rpy:428
translate french c17s001_AmandaDinner_b2013db9:

    # "[mar] corre hacia Amanda y la envuelve en un abrazo."
    "[mar] court vers Amanda et l'enlace."

# game/scripts/c17/c17.rpy:429
translate french c17s001_AmandaDinner_4b7ba78a:

    # mom "Bienvenida de nuevo a casa, Amanda."
    mom "Bienvenue à la maison, Amanda."

# game/scripts/c17/c17.rpy:430
translate french c17s001_AmandaDinner_481f2225:

    # ama "Gracias, [mar]."
    ama "Merci, [mar]."

# game/scripts/c17/c17.rpy:433
translate french c17s001_AmandaDinner_e3d25341:

    # "Se repiten las presentaciones y los abrazos de la comida y la misma dinámica. Las chicas, esta vez también con las estudiantes, acaparan a Amanda mientras las mujeres se mantienen apartadas."
    "Les présentations et les accolades lors du repas se répètent, de même que la dynamique habituelle. Les filles, accompagnées cette fois des étudiantes, monopolisent Amanda tandis que les femmes gardent leurs distances."

# game/scripts/c17/c17.rpy:434
translate french c17s001_AmandaDinner_31b4962b:

    # "Decides mantenerte a distancia del grupo de chicas. Sabes que, si te acercas a ellas, vas a ser objeto de bromas y hoy el centro de atención tiene que ser Amanda."
    "Vous décidez de garder vos distances avec le groupe de filles. Vous savez que si vous les approchez, vous deviendrez la risée de tous, et aujourd'hui, l'attention doit se porter sur Amanda."

# game/scripts/c17/c17.rpy:437
translate french c17s001_AmandaDinner_e43fd160:

    # bet "Parece increíble, ¿no? Esta mañana teníamos a una versión de [emm] que se parecía a [dap] y ahora una versión de [eri] con la cara de [emm]."
    bet "C'est incroyable, n'est-ce pas ? Ce matin, nous avions une version de [emm] qui ressemblait à [dap] et maintenant une version de [eri] avec le visage de [emm]."

# game/scripts/c17/c17.rpy:438
translate french c17s001_AmandaDinner_34e0814c:

    # mc "Son más complejas que todo eso, Tía Betty. Aparte del obvio parecido físico, en cuanto a personalidad no puedes buscar una correlación total."
    mc "C'est plus complexe que ça, tante Betty. Mis à part la ressemblance physique évidente, on ne peut pas s'attendre à une correspondance parfaite en termes de personnalité."

# game/scripts/c17/c17.rpy:439
translate french c17s001_AmandaDinner_4ebc751c:

    # mc "Es cierto que Eva se parece mucho a [emm], pero hay muchos matices. También tiene mucho de ti, como el sentido del humor."
    mc "Il est vrai qu'Eva ressemble beaucoup à [emm], mais il y a de nombreuses nuances. Elle a aussi beaucoup de toi en elle, notamment son sens de l'humour."

# game/scripts/c17/c17.rpy:440
translate french c17s001_AmandaDinner_d65da405:

    # mc "Y Amanda, pese a que es emocional como [eri], también es inteligente como [dap] o Scarlett."
    mc "Et Amanda, bien qu'émotive comme [eri], est aussi intelligente comme [dap] ou Scarlett."

# game/scripts/c17/c17.rpy:442
translate french c17s001_AmandaDinner_a6222657:

    # bet "Tienes razón. La mente juega malas pasadas y, sabiendo que son clones, busca más parecidos de los obvios."
    bet "Vous avez raison. Notre esprit nous joue des tours, et sachant qu'il s'agit de clones, il recherche des similitudes au-delà des plus évidentes."

# game/scripts/c17/c17.rpy:443
translate french c17s001_AmandaDinner_be2b6864:

    # mc "Sí, a mí también me pasa. Espero que Eva actúe como [emm]. La mayoría de las veces lo hace, pero a veces me sorprende."
    mc "Oui, ça m'arrive aussi. J'espère qu'Eva se comporte comme [emm]. La plupart du temps, c'est le cas, mais parfois elle me surprend."

# game/scripts/c17/c17.rpy:444
translate french c17s001_AmandaDinner_8127a81d:

    # mc "Hoy en la clase de tiro podría haber avergonzado a Meemaw con lo estricta que era al principio."
    mc "Aujourd'hui, au cours de tir, j'aurais pu embarrasser Mémé tellement j'étais stricte au début."

# game/scripts/c17/c17.rpy:446
translate french c17s001_AmandaDinner_0789b0fa:

    # bet "Hablando de Olivia, ¿cómo ha ido la visita al médico?"
    bet "À propos d'Olivia, comment s'est passée la visite chez le médecin ?"

# game/scripts/c17/c17.rpy:448
translate french c17s001_AmandaDinner_3504c7ce:

    # bet "Ha vuelto más contenta de lo que esperaba sabiendo que no va a poder empezar el tratamiento todavía."
    bet "Elle est revenue plus heureuse qu'elle ne l'aurait imaginé, sachant qu'elle ne pourra pas encore commencer son traitement."

# game/scripts/c17/c17.rpy:449
translate french c17s001_AmandaDinner_bec6fc3a:

    # mc "Bueno, estaba un poco decepcionada sobre lo de no poder empezar el tratamiento inmediatamente, pero después se le ha pasado un poco."
    mc "J'étais un peu déçue de ne pas pouvoir commencer le traitement immédiatement, mais ça m'est passé depuis."

# game/scripts/c17/c17.rpy:451
translate french c17s001_AmandaDinner_8ac98141:

    # bet "Me ha dicho que me tienes que enseñar algo sobre los masajes, que yo no los estaba haciendo bien."
    bet "Elle m'a dit que je devais t'apprendre quelque chose sur les massages, car je ne les faisais pas correctement."

# game/scripts/c17/c17.rpy:452
translate french c17s001_AmandaDinner_8e2ea9e9:

    # mc "Es lo que ha dicho la Dra. Milk. Hay una zona que no estás masajeando correctamente."
    mc "C'est ce qu'a dit le Dr Milk. Il y a une zone que vous ne massez pas correctement."

# game/scripts/c17/c17.rpy:454
translate french c17s001_AmandaDinner_c1966eb3:

    # bet "Mañana, cuando toque darle el masaje, puedes enseñarme, si te va bien."
    bet "Demain, au moment de lui faire le massage, vous pourrez me montrer, si cela vous convient."

# game/scripts/c17/c17.rpy:455
translate french c17s001_AmandaDinner_5ac7d1fb:

    # mc "Perfecto. No es difícil."
    mc "Parfait. Ce n'est pas difficile."

# game/scripts/c17/c17.rpy:457
translate french c17s001_AmandaDinner_ea3052e4:

    # mc "Aunque puede acabar siendo un poco pegajoso. *Risita*"
    mc "Ça risque d'être un peu collant. *Rires*"

# game/scripts/c17/c17.rpy:459
translate french c17s001_AmandaDinner_cc5707b4:

    # bet "¿Pegajoso? ¿Por qué? ¿La médico no le sacó la leche antes de los masajes?"
    bet "Collant ? Pourquoi ? Le médecin n'a-t-il pas exprimé le lait avant les massages ?"

# game/scripts/c17/c17.rpy:460
translate french c17s001_AmandaDinner_d882d1bc:

    # mc "Sí, pero... por lo que dijo, es posible que no lo sacara todo."
    mc "Oui, mais... d'après ce qu'il a dit, il est possible qu'il n'ait pas tout dit."

# game/scripts/c17/c17.rpy:461
translate french c17s001_AmandaDinner_417c029b:

    # bet "Mmmmm... Okaaay."
    bet "Mmm... D'accord."

# game/scripts/c17/c17.rpy:463
translate french c17s001_AmandaDinner_42315518:

    # mee "¿Qué estáis planeando vosotros dos? *Risita*"
    mee "Que préparez-vous tous les deux ? *Rires*"

# game/scripts/c17/c17.rpy:464
translate french c17s001_AmandaDinner_6b64de23:

    # mc "Nada especial, Meemaw. Tía Betty me estaba pidiendo que le enseñara mañana lo que hemos hecho hoy."
    mc "Rien de spécial, grand-mère. Tante Betty me demandait de lui montrer demain ce que nous avons fait aujourd'hui."

# game/scripts/c17/c17.rpy:465
translate french c17s001_AmandaDinner_7475059d:

    # mc "Podemos repetir lo de esta mañana si quieres."
    mc "Nous pouvons répéter ce que nous avons fait ce matin si vous le souhaitez."

# game/scripts/c17/c17.rpy:468
translate french c17s001_AmandaDinner_813a9c52:

    # mee "¿Qué? {b}¿Todo?{/b}"
    mee "Quoi ? {b}Tout ?{/b}"

# game/scripts/c17/c17.rpy:469
translate french c17s001_AmandaDinner_1711c5b0:

    # mc "Lo que tú quieras, Meemaw."
    mc "Tout ce que tu veux, Meemaw."

# game/scripts/c17/c17.rpy:471
translate french c17s001_AmandaDinner_ac9197b6:

    # bet "Mmmmm... ¿A qué te refieres con \"todo\", Olivia?"
    bet "Mmm... Que veux-tu dire par « tout », Olivia ?"

# game/scripts/c17/c17.rpy:472
translate french c17s001_AmandaDinner_44f8d873:

    # mc "La doctora nos ha enseñado dos formas de hacer el masaje. Una por delante, como lo haces tú, y otra desde atrás."
    mc "Le médecin nous a montré deux façons de faire le massage. L'une par l'avant, comme vous le faites, et l'autre par l'arrière."

# game/scripts/c17/c17.rpy:473
translate french c17s001_AmandaDinner_c5c8eac6:

    # mc "Ha sido más cómodo hacerlo desde atrás, y con mejor resultado."
    mc "Il s'est avéré plus confortable de le faire par derrière, et avec de meilleurs résultats."

# game/scripts/c17/c17.rpy:475
translate french c17s001_AmandaDinner_e10117ec:

    # mee "¡[mc]!"
    mee "[mc]!"

# game/scripts/c17/c17.rpy:476
translate french c17s001_AmandaDinner_09abbe64:

    # mc "¿Qué? Es cierto..."
    mc "Quoi ? C'est exact..."

# game/scripts/c17/c17.rpy:478
translate french c17s001_AmandaDinner_bf1923c1:

    # bet "Mmmm... ¿Ha pasado algo?"
    bet "Mmm... Il s'est passé quelque chose ?"

# game/scripts/c17/c17.rpy:479
