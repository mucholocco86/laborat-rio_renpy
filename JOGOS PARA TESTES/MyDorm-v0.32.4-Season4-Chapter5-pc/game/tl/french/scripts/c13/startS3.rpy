

# game/scripts/c13/startS3.rpy:5
translate french startS3_8b60ce73:

    # "Jamaal" "Veo que quieres empezar una partida nueva. Pero esto es la Temporada 4 de My Dorm." id startS3_8b60ce73
    "Jamaal" "Je vois que tu veux commencer une nouvelle partie. Mais il s'agit de la saison 4 de My Dorm." id startS3_8b60ce73

# game/scripts/c13/startS3.rpy:7
translate french startS3_7f917222:

    # "Jamaal" "Hay un cuestionario que vas a tener que rellenar, pero no es la mejor opción."
    "Jamaal" "Vous devrez remplir un questionnaire, mais ce n'est pas la meilleure option."

# game/scripts/c13/startS3.rpy:8
translate french startS3_fd712d46:

    # "Jamaal" "Tropecita y yo creemos que no vas a disfrutar el juego si no has jugado las temporadas previas, ya que no vas a conocer a los personajes."
    "Jamaal" "Tropecita et moi pensons que vous n'apprécierez pas le jeu si vous n'avez pas joué aux saisons précédentes, car vous ne connaîtrez pas les personnages."

# game/scripts/c13/startS3.rpy:10
translate french startS3_2738f278:

    # "Jamaal" "Si quieres jugar la Temporada 4, lo ideal es haber jugado previamente, como mínimo, la Temporada 3 hasta el final." id startS3_2738f278
    "Jamaal" "Si vous souhaitez jouer à la saison 4, l'idéal serait d'avoir préalablement terminé au moins la saison 3." id startS3_2738f278

# game/scripts/c13/startS3.rpy:11
translate french startS3_017758e4:

    # "Jamaal" "Aunque yo recomiendo que empieces desde el principio. Verás mi bonita cara mucho en las temporadas previas."
    "Jamaal" "Je vous recommande toutefois de commencer par le début. Vous verrez souvent mon joli minois dans les premières saisons."

# game/scripts/c13/startS3.rpy:13
translate french startS3_534d9fa7:

    # "Jamaal" "Puedes bajar las Temporadas 1 y 2 en los sitios habituales (Patreon, Subscribestar, y Discord)."
    "Jamaal" "Vous pouvez télécharger les saisons 1 et 2 sur les sites habituels (Patreon, Subscribestar et Discord)."

# game/scripts/c13/startS3.rpy:14
translate french startS3_fbcd1a72:

    # "Jamaal" "Encontrarás los enlaces en el menú principal, en la parte inferior izquierda."
    "Jamaal" "Vous trouverez les liens dans le menu principal, en bas à gauche."

# game/scripts/c13/startS3.rpy:16
translate french startS3_e2947f50:

    # "Jamaal" "¡Nos vemos en alguna de las temporadas anteriores! O en esta si no sigues mi consejo."
    "Jamaal" "On se retrouve dans une des saisons précédentes ! Ou dans celle-ci si vous n'écoutez pas mon conseil."

# game/scripts/c13/startS3.rpy:18
translate french startS3_5120be79:

    # "Jamaal" "¡Oh! Y no te preocupes. No soy el personaje principal de este juego. No es tan guapo como yo, pero no es mal tipo."
    "Jamaal" "Oh ! Et ne t'inquiète pas. Je ne suis pas le personnage principal de ce jeu. Il n'est pas aussi beau que moi, mais ce n'est pas un méchant."

