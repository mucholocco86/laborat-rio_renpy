    # sam "O podríamos ir toda la familia a la playa. Hace siglos que no vamos. Llamaré a [mar] para atar cabos."
    sam "Ou alors, toute la famille pourrait aller à la plage. Ça fait une éternité qu'on n'y est pas allés. Je vais appeler [mar] pour organiser ça."

# game/scripts/c13/c13.rpy:1901
translate french c13s005_SamanthaNoSex_adf8d441:

    # mc "Me parece genial. A mí también me apetece."
    mc "Ça a l'air super. J'aimerais bien essayer aussi."

# game/scripts/c13/c13.rpy:1903
translate french c13s005_SamanthaNoSex_7146097a:

    # sam "Cuídate, [mc]."
    sam "Prends soin de toi, [mc]."

# game/scripts/c13/c13.rpy:1904
