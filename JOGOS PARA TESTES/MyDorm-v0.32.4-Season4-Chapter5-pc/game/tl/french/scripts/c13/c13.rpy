    # sim "¡Hush! Si nos oye mi madre no voy a poder hacer esto..."
    sim "Chut ! Si ma mère nous entend, je ne pourrai pas faire ça…"

# game/scripts/c13/c13.rpy:1911
translate french c13s005_SamanthaNoSex_ef42e495:

    # "Vuestros labios se juntan en un beso que dice a gritos que se han echado de menos en los días que hace que no os habéis visto."
    "Vos lèvres se rencontrent dans un baiser qui crie à quel point vous vous êtes manqués depuis votre dernière rencontre."

# game/scripts/c13/c13.rpy:1912
translate french c13s005_SamanthaNoSex_95dbab93:

    # sim "No quiero pasar tantos días sin verte. Ya sé que has estado muy ocupado pero..."
    sim "Je ne veux pas passer autant de jours sans te voir. Je sais que tu as été très occupé(e), mais…"

