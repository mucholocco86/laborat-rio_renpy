

# game/scripts/c13/c13.rpy:47
translate french c13s001_KiaraEileen_c6c4326a:

    # mc "¿Qué ha pasado, Eileen?"
    mc "Que s'est-il passé, Eileen ?"

# game/scripts/c13/c13.rpy:48
translate french c13s001_KiaraEileen_c274c946:

    # eil "Lo de siempre. Mi padre bebió demasiado y empezó a gritarle a mi madre por alguna tontería."
    eil "Comme d'habitude. Mon père avait trop bu et s'est mis à crier sur ma mère pour une broutille."

# game/scripts/c13/c13.rpy:49
translate french c13s001_KiaraEileen_9fb18d51:

    # eil "Esta vez la agarró del brazo y empezó a arrastrarla por la casa. En ese momento llegué yo."
    eil "Cette fois, il lui a attrapé le bras et a commencé à la traîner dans la maison. C'est à ce moment-là que je suis arrivé."

# game/scripts/c13/c13.rpy:51
translate french c13s001_KiaraEileen_21bb27f9:

    # mc "¿Estás bien, Kiara?"
    mc "Ça va, Kiara ?"

# game/scripts/c13/c13.rpy:52
translate french c13s001_KiaraEileen_c906d645:

    # kia "Sí, no ha sido tanto como Eileen dice. Me ha hecho un poco de daño y..."
    kia "Oui, ce n'était pas aussi grave qu'Eileen le dit. Ça m'a un peu fait mal et..."

# game/scripts/c13/c13.rpy:53
translate french c13s001_KiaraEileen_6c0ef233:

    # kia "¿Podemos esperar a llegar a tu casa para seguir hablando de esto? Es raro hablar con dos cogotes..."
    kia "On peut attendre d'être chez toi pour continuer à en parler ? C'est bizarre de parler à deux mecs..."

# game/scripts/c13/c13.rpy:54
translate french c13s001_KiaraEileen_f52820f5:

    # mc "Ningún problema, Kiara."
    mc "Pas de problème, Kiara."

# game/scripts/c13/c13.rpy:56
translate french c13s001_KiaraEileen_719b4668:

    # mc "Hoy dormiréis en mi habitación. Todo el mundo está durmiendo ahora mismo y sería complicado habilitaros otra habitación."
    mc "Tu dormiras dans ma chambre ce soir. Tout le monde dort déjà, et il serait difficile de te trouver une autre chambre."

# game/scripts/c13/c13.rpy:57
translate french c13s001_KiaraEileen_72f9361b:

    # eil "¿Dónde vas a dormir tú?"
    eil "Où vas-tu dormir ?"

# game/scripts/c13/c13.rpy:58
translate french c13s001_KiaraEileen_3cf765c4:

    # mc "Con vosotras, por supuesto. Es mi habitación."
    mc "Avec toi, bien sûr. C'est ma chambre."

# game/scripts/c13/c13.rpy:60
translate french c13s001_KiaraEileen_6e57607b:

    # eil "¡[mc]! No puedo dejar que duermas con mi madre..."
    eil "[mc]! Je ne peux pas te laisser coucher avec ma mère..."

# game/scripts/c13/c13.rpy:61
translate french c13s001_KiaraEileen_329a3c4e:

    # mc "Eile, es broma. Buscaré algún sitio donde dormir sin molestar a nadie."
    mc "Eile, je plaisante. Je trouverai un endroit où dormir sans déranger personne."

# game/scripts/c13/c13.rpy:63
translate french c13s001_KiaraEileen_05d083a2:

    # eil "Lo siento, no tengo el ánimo para bromas ahora mismo."
    eil "Désolé, je n'ai pas envie de plaisanter maintenant."

# game/scripts/c13/c13.rpy:64
translate french c13s001_KiaraEileen_1519018b:

    # mc "No te preocupes. Quizás no era el momento más adecuado para bromas."
    mc "Ne t'inquiète pas. Ce n'était peut-être pas le meilleur moment pour faire des blagues."

# game/scripts/c13/c13.rpy:66
translate french c13s001_KiaraEileen_e5d14762:

    # "Continúas conduciendo hacia casa. Ahora en silencio. El camino parece eterno una vez la adrenalina que te ha traído aquí volando desaparece."
    "Vous reprenez la route du retour. Désormais en silence. La route semble interminable une fois que l'adrénaline qui vous a amené jusqu'ici s'est dissipée."

# game/scripts/c13/c13.rpy:69
translate french c13s001_KiaraEileen_e220be2f:

    # mc "Pues esta es mi habitación, Kiara. Hay un baño con ducha justo pasar el gimnasio. Eileen conoce la casa, con lo que cualquier duda se la puedes preguntar."
    mc "Voici ma chambre, Kiara. Il y a une salle de bain avec douche juste après la salle de sport. Eileen connaît bien la maison, tu peux donc lui demander si tu as des questions."

# game/scripts/c13/c13.rpy:71
translate french c13s001_KiaraEileen_03e86018:

    # mc "Si necesitáis cualquier cosa, estaré durmiendo en los sofás que acabamos de pasar en la planta debajo de esta."
    mc "Si vous avez besoin de quoi que ce soit, je dormirai sur les canapés que nous venons de croiser à l'étage inférieur."

# game/scripts/c13/c13.rpy:72
translate french c13s001_KiaraEileen_3f24f32d:

    # kia "Gracias, [mc], me sabe mal que tengas que dormir en un sofá por nuestra culpa."
    kia "Merci, [mc], je suis désolé que tu doives dormir sur un canapé à cause de nous."

# game/scripts/c13/c13.rpy:73
translate french c13s001_KiaraEileen_c2022b3a:

    # eil "Podrías dormir en este sofá si quieres. No queremos echarte de tu habitación."
    eil "Tu peux dormir sur ce canapé si tu veux. On ne veut pas te mettre à la porte de ta chambre."

# game/scripts/c13/c13.rpy:75
translate french c13s001_KiaraEileen_769a90f0:

    # kia "O mejor aún, dormimos nosotras en esos sofás y tu duermes en tu cama como debería ser."
    kia "Ou mieux encore, nous dormons sur ces canapés et vous dormez dans votre lit, comme il se doit."

# game/scripts/c13/c13.rpy:76
translate french c13s001_KiaraEileen_7395a30e:

    # mc "Eso no puedo permitirlo. Sois mis invitadas y vais a dormir en una cama."
    mc "Je ne peux pas l'autoriser. Vous êtes mes invités et vous dormirez dans un lit."

# game/scripts/c13/c13.rpy:78
translate french c13s001_KiaraEileen_87bd263e:

    # eil "Mamá... ¿no has metido pijamas en la bolsa?"
    eil "Maman... tu n'as pas mis de pyjama dans le sac ?"

# game/scripts/c13/c13.rpy:80
translate french c13s001_KiaraEileen_444f4618:

    # kia "¡Oops! No. Me he despistado. Con las prisas he pensado en ropa, artículos de higiene... pero no en los pijamas."
    kia "Oups ! Non. J'ai eu un moment d'inattention. Dans ma précipitation, j'ai pensé aux vêtements, aux produits de toilette… mais pas au pyjama."

# game/scripts/c13/c13.rpy:81
translate french c13s001_KiaraEileen_c1783558:

    # mc "No os preocupéis. Podéis coger camisetas o pijamas míos para dormir. Eileen sabe donde están."
    mc "Ne t'inquiète pas. Tu peux prendre n'importe lequel de mes t-shirts ou pyjamas pour dormir. Eileen sait où ils sont."

# game/scripts/c13/c13.rpy:83
translate french c13s001_KiaraEileen_9a4121a2:

    # kia "Se me hace raro que Eileen sepa más de una casa que yo. *Risa* Pero después de tantos años juntos es normal."
    kia "C'est étrange qu'Eileen en sache plus sur une maison que moi. *Rires* Mais après tant d'années ensemble, c'est normal."

# game/scripts/c13/c13.rpy:84
translate french c13s001_KiaraEileen_be191e95:

    # kia "Es una lástima que lo dejáseis cuando estabas en Portland. Pensaba que volveriais a estar juntos cuando volvieras de la universidad."
    kia "C'est dommage que vous ayez rompu pendant votre séjour à Portland. Je pensais que vous vous remettriez ensemble à votre retour de la fac."

# game/scripts/c13/c13.rpy:85
translate french c13s001_KiaraEileen_4d6b542d:

    # mc "Bueno, no funcionaba a distancia."
    mc "Eh bien, ça n'a pas fonctionné à distance."

# game/scripts/c13/c13.rpy:88
translate french c13s001_KiaraEileen_1d7f0a08:

    # "Eileen te mira interrogativamente, como si te pidiera permiso para desvelar la noticia a su madre."
    "Eileen vous regarde d'un air interrogateur, comme si elle vous demandait la permission de révéler la nouvelle à sa mère."

# game/scripts/c13/c13.rpy:89
translate french c13s001_KiaraEileen_c95b64af:

    # "Asientes."
    "Vous hochez la tête."

# game/scripts/c13/c13.rpy:91
translate french c13s001_KiaraEileen_f98ceeb9:

    # eil "Mamá, volvemos a estar juntos."
    eil "Maman, nous sommes de nouveau ensemble."

# game/scripts/c13/c13.rpy:93
translate french c13s001_KiaraEileen_e045b18f:

    # eil "No de la misma forma que antes, pero volvemos a estarlo."
    eil "Pas de la même manière qu'avant, mais nous sommes de retour."

# game/scripts/c13/c13.rpy:95
translate french c13s001_KiaraEileen_6901d4af:

    # kia "¡Eso es fantástico! Me alegro mucho por vosotros."
    kia "C'est fantastique ! Je suis tellement content pour toi."

# game/scripts/c13/c13.rpy:96
translate french c13s001_KiaraEileen_887f84c9:

    # mc "Gracias, Kiara."
    mc "Merci, Kiara."

# game/scripts/c13/c13.rpy:99
translate french c13s001_KiaraEileen_bd6a288c:

    # eil "Además, ahora somos buenos amigos. Lo importante es que no hemos perdido la relación."
    eil "D'ailleurs, nous sommes de bons amis maintenant. L'important, c'est que nous n'ayons pas perdu le contact."

# game/scripts/c13/c13.rpy:101
translate french c13s001_KiaraEileen_18f876c1:

    # mc "Voy a dejar que os cambiéis y os acostéis. Mañana hablaremos de cómo nos organizamos y de lo que ha pasado esta noche."
    mc "Je te laisse te changer et aller te coucher. Demain, on parlera de l'organisation et de ce qui s'est passé ce soir."

# game/scripts/c13/c13.rpy:102
translate french c13s001_KiaraEileen_cb206701:

    # kia "Gracias, [mc]."
    kia "Merci, [mc]."

# game/scripts/c13/c13.rpy:103
translate french c13s001_KiaraEileen_565a3cb6:

    # eil "Gracias. Por todo."
    eil "Merci pour tout."

# game/scripts/c13/c13.rpy:105
translate french c13s001_KiaraEileen_a17f0e80:

    # "Bajas a la planta de las estudiantes. Parece mentira que Kim te despertara en este mismo sofá hace menos de 24 horas."
    "Tu descends à l'étage des étudiants. Difficile de croire que Kim t'a réveillé sur ce même canapé il y a moins de 24 heures."

# game/scripts/c13/c13.rpy:106
translate french c13s001_KiaraEileen_dcce7ba5:

    # mcp "{i}(Soy idiota. Les he dicho que cogieran mis pijamas y no he cogido uno para mí. Ni siquiera unos shorts.){/i}"
    mcp "{i}(Je suis bête. Je leur ai dit de prendre mon pyjama et je n'en ai pas pris pour moi. Même pas un short.){/i}"

# game/scripts/c13/c13.rpy:107
translate french c13s001_KiaraEileen_6ff3efb4:

    # mcp "{i}(*Risa mental* Dormir en pelotas en el sofá no sería muy adecuado si alguna de las estudiantes se despierta antes que yo.){/i}"
    mcp "{i}(*Rires intérieurs* Dormir nu sur le canapé ne serait pas très approprié si l'un des élèves se réveillait avant moi.){/i}"

# game/scripts/c13/c13.rpy:108
translate french c13s001_KiaraEileen_2f20ab6f:

    # "Vuelves a tu habitación."
    "Vous retournez dans votre chambre."

# game/scripts/c13/c13.rpy:111
translate french c13s001_KiaraEileen_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c13/c13.rpy:112
translate french c13s001_KiaraEileen_ff300ecf:

    # mc "¿Puedo entrar? No he cogido nada para mí, para dormir."
    mc "Puis-je entrer ? Je n'ai rien pris pour moi, pour dormir."

# game/scripts/c13/c13.rpy:113
translate french c13s001_KiaraEileen_f2e14fc9:

    # eil "*A través de la puerta* Espera un segundo, por favor."
    eil "*À travers la porte* Attendez une seconde, s'il vous plaît."

# game/scripts/c13/c13.rpy:114
translate french c13s001_KiaraEileen_124fea52:

    # "Al cabo de unos segundos..."
    "Après quelques secondes..."

# game/scripts/c13/c13.rpy:115
translate french c13s001_KiaraEileen_87c5147b:

    # kia "*A través de la puerta* Puedes pasar."
    kia "Vous pouvez passer la porte."

# game/scripts/c13/c13.rpy:117
translate french c13s001_KiaraEileen_d6dbf9c6:

    # mc "Disculpad, pero es que no he cogido mi propio pijama."
    mc "Excusez-moi, mais je n'ai pas apporté mon pyjama."

# game/scripts/c13/c13.rpy:118
translate french c13s001_KiaraEileen_6a638103:

    # mc "Aunque viendo que a vosotras os queda mejor mi ropa que a mí..."
    mc "Cependant, vu que mes vêtements te vont mieux qu'à moi..."

# game/scripts/c13/c13.rpy:120
translate french c13s001_KiaraEileen_2aff138e:

    # eil "*Risa* ¿Ya estás diciendo payasadas? ¿Tú no ibas a dormir?"
    eil "*Rires* Tu dis déjà n'importe quoi ? Tu n'allais pas dormir ?"

# game/scripts/c13/c13.rpy:121
translate french c13s001_KiaraEileen_2164d99f:

    # mc "¿Payasadas? {b}¿Yo?{/b} ¡Qué va! Tenéis un espejo en ese armario si queréis, en el interior de la puerta."
    mc "Des blagues idiotes ? Moi ? Jamais de la vie ! Il y a un miroir dans ce placard si tu veux, à l’intérieur de la porte."

# game/scripts/c13/c13.rpy:122
translate french c13s001_KiaraEileen_f013a839:

    # mc "Y sobre lo de dormir... demasiados nervios para dormir ahora mismo."
    mc "Et pour ce qui est du sommeil… je suis trop nerveuse pour dormir maintenant."

# game/scripts/c13/c13.rpy:124
translate french c13s001_KiaraEileen_cad26fba:

    # mc "¿Eso es lo que te ha hecho Solomon? Parece un hematoma importante, deberíamos ir al hospital a mirarlo."
    mc "C'est ce que Salomon t'a fait ? On dirait un gros bleu ; on devrait aller à l'hôpital pour le faire examiner."

# game/scripts/c13/c13.rpy:126
translate french c13s001_KiaraEileen_5b6d23f3:

    # kia "No hace falta, tan solo es un morado. No es la primera vez..."
    kia "Ce n'est pas nécessaire, c'est juste violet. Ce n'est pas la première fois..."

# game/scripts/c13/c13.rpy:127
translate french c13s001_KiaraEileen_0c3d2244:

    # mc "Espero que sea la última."
    mc "J'espère que c'est le dernier."

# game/scripts/c13/c13.rpy:128
translate french c13s001_KiaraEileen_03d83403:

    # mc "Pero de todas formas, habría que mirarlo. Sin dejar pasar muchos días."
    mc "Mais nous devrions tout de même nous pencher sur la question. Sans trop tarder."

# game/scripts/c13/c13.rpy:129
translate french c13s001_KiaraEileen_6b4a4f4c:

    # mc "¿Quieres hablar sobre lo que ha pasado?"
    mc "Voulez-vous parler de ce qui s'est passé ?"

# game/scripts/c13/c13.rpy:131
translate french c13s001_KiaraEileen_a5db2430:

    # kia "Nosotras tampoco vamos a poder dormir, si quieres te lo explico ahora antes de que se nos olviden los detalles."
    kia "Nous ne pourrons pas dormir non plus, si vous voulez, je peux vous l'expliquer maintenant avant que nous n'oubliions les détails."

# game/scripts/c13/c13.rpy:132
translate french c13s001_KiaraEileen_a1ae72c2:

    # kia "Es lo menos que te debo..."
    kia "C'est le moins que je vous doive..."

# game/scripts/c13/c13.rpy:133
translate french c13s001_KiaraEileen_59a61feb:

    # mc "Kiara, no me debes nada. Es más, no tienes que explicarme nada de lo que ha pasado."
    mc "Kiara, tu ne me dois rien. De plus, tu n'as aucune explication à donner sur ce qui s'est passé."

# game/scripts/c13/c13.rpy:134
translate french c13s001_KiaraEileen_60f198fe:

    # mc "Lo decía porque en mi familia acostumbramos a hablarlo todo para quitarnos el peso de encima."
    mc "J'ai dit ça parce que dans ma famille, on parle généralement de tout pour se libérer de ce poids."

# game/scripts/c13/c13.rpy:136
translate french c13s001_KiaraEileen_3910ebcb:

    # eil "Es una buena costumbre, Mamá. Deberíamos aplicarla en casa."
    eil "C'est une bonne habitude, maman. On devrait l'adopter à la maison."

# game/scripts/c13/c13.rpy:137
translate french c13s001_KiaraEileen_25f21628:

    # eil "¿Nos sentamos?"
    eil "On s'assoit ?"

# game/scripts/c13/c13.rpy:138
translate french c13s001_KiaraEileen_bf5931c4:

    # mc "Sólo si tu madre quiere."
    mc "Seulement si votre mère le souhaite."

# game/scripts/c13/c13.rpy:140
translate french c13s001_KiaraEileen_34940787:

    # kia "Sí, probemos esa costumbre familiar vuestra. Está claro que las costumbres de mi familia no son las mejores."
    kia "Oui, essayons votre tradition familiale. Il est clair que les traditions de ma famille ne sont pas les meilleures."

# game/scripts/c13/c13.rpy:141
translate french c13s001_KiaraEileen_db4aa0ed:

    # mc "No te machaques ahora. Eileen ha salido muy bien. Y tú también."
    mc "Ne t'en fais pas. Eileen a été formidable. Et toi aussi."

# game/scripts/c13/c13.rpy:143
translate french c13s001_KiaraEileen_bbb21deb:

    # mc "¿Por dónde quieres empezar, Kiara?"
    mc "Par où veux-tu commencer, Kiara ?"

# game/scripts/c13/c13.rpy:144
translate french c13s001_KiaraEileen_820962d4:

    # kia "Es difícil decidirlo. ¿Cuánto sabes? ¿Te pongo en antecedentes?"
    kia "C'est une décision difficile. Que savez-vous ? Dois-je vous donner quelques informations de base ?"

# game/scripts/c13/c13.rpy:145
translate french c13s001_KiaraEileen_20801f23:

    # eil "Mamá, [mc] sabe lo que pasaba cuando Papá bebía... cuando aún estábamos en el instituto."
    eil "Maman sait ce qui se passait quand papa buvait… à l’époque où nous étions encore au lycée."

# game/scripts/c13/c13.rpy:147
translate french c13s001_KiaraEileen_2bc0a856:

    # kia "Entonces... esta noche..."
    kia "Alors... ce soir..."

# game/scripts/c13/c13.rpy:148
translate french c13s001_KiaraEileen_a3b26a54:

    # kia "Desde que Solomon ha vuelto a beber, no se había puesto violento ninguna vez, esta es la primera."
    kia "Depuis que Solomon avait recommencé à boire, il n'avait pas été violent du tout ; c'est la première fois."

# game/scripts/c13/c13.rpy:149
translate french c13s001_KiaraEileen_b6173fef:

    # mc "Eso es una vez más de las necesarias."
    mc "C'est encore une fois l'une des mesures nécessaires."

# game/scripts/c13/c13.rpy:151
translate french c13s001_KiaraEileen_e6a3af03:

    # kia "Lo sé. Cuando dejó de beber lo hizo, entre otras razones, por que le amenacé con dejarle si me volvía a poner la mano encima."
    kia "Je sais. S'il a arrêté de boire, c'était, entre autres raisons, parce que je l'ai menacé de le quitter s'il levait encore la main sur moi."

# game/scripts/c13/c13.rpy:152
translate french c13s001_KiaraEileen_3c1001c8:

    # kia "Todo fue bien durante dos años, y después volvió a beber."
    kia "Tout s'est bien passé pendant deux ans, puis il a recommencé à boire."

# game/scripts/c13/c13.rpy:153
translate french c13s001_KiaraEileen_a262e0ac:

    # mc "Lo sé, Eileen me lo explicó. ¿Sabéis por qué volvió?"
    mc "Je sais, Eileen me l'a expliqué. Sais-tu pourquoi elle est revenue ?"

# game/scripts/c13/c13.rpy:155
translate french c13s001_KiaraEileen_f19c05de:

    # eil "No. Ya te dije que empezó a beber una cerveza al salir del trabajo, con los compañeros. Le dijimos que no lo hiciera, pero no nos hizo caso."
    eil "Non. Je vous ai déjà dit qu'il a commencé à boire une bière après le travail, avec ses collègues. On lui avait dit d'arrêter, mais il n'a pas voulu nous écouter."

# game/scripts/c13/c13.rpy:156
translate french c13s001_KiaraEileen_b5fe506f:

    # eil "\"Sólo es una cerveza un día a la semana\" decía. Como te dije, de ahí pasó varias cervezas, a un whisky, a varios whiskys..."
    eil "« C'est juste une bière par semaine », a-t-il dit. Comme je vous l'ai dit, de là, c'est passé à plusieurs bières, puis à un whisky, puis à plusieurs whiskies…"

# game/scripts/c13/c13.rpy:157
translate french c13s001_KiaraEileen_aefac422:

    # mc "Pero no estaba violento hasta hoy, ¿qué ha pasado hoy?"
    mc "Mais il n'était pas violent jusqu'à aujourd'hui, que s'est-il passé aujourd'hui ?"

# game/scripts/c13/c13.rpy:159
translate french c13s001_KiaraEileen_4b05b630:

    # kia "Cuando he llegado de trabajar estaba muy borracho."
    kia "Quand je suis rentré du travail, j'étais complètement ivre."

# game/scripts/c13/c13.rpy:160
translate french c13s001_KiaraEileen_6715e9d6:

    # kia "Se enfadó mucho cuando le dije que tardaría 30 minutos en preparar la cena."
    kia "Elle s'est mise en colère quand je lui ai dit qu'il me faudrait 30 minutes pour préparer le dîner."

# game/scripts/c13/c13.rpy:161
translate french c13s001_KiaraEileen_8af27441:

    # mc "Acababas de llegar, ¿cuando quería que la preparases?"
    mc "Vous veniez d'arriver, quand vouliez-vous que je le prépare ?"

# game/scripts/c13/c13.rpy:163
translate french c13s001_KiaraEileen_642ec6d5:

    # eil "Cuando está borracho el alcohol sustituye a la lógica."
    eil "Quand on est ivre, l'alcool remplace la logique."

# game/scripts/c13/c13.rpy:164
translate french c13s001_KiaraEileen_5b86879b:

    # eil "Puede quejarse de cualquier cosa, tenga razón o no. Y si le llevas la contraria se enfada más todavía. No se puede razonar con él."
    eil "Il se plaint de tout, qu'il ait raison ou tort. Et si vous n'êtes pas d'accord avec lui, il se met encore plus en colère. Impossible de le raisonner."

# game/scripts/c13/c13.rpy:165
translate french c13s001_KiaraEileen_a78c46ec:

    # mc "Tú aún estabas en el trabajo, ¿no?"
    mc "Tu étais encore au travail, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:167
translate french c13s001_KiaraEileen_453f64ce:

    # eil "Sí, ayer... hoy... tenía que cerrar el café y hacer la caja. A los temporales como [eri] no les dejan hacerla."
    eil "Oui, hier… aujourd’hui… j’ai dû fermer le café et tenir la caisse. Les travailleurs temporaires comme [eri] n’ont pas le droit de le faire."

# game/scripts/c13/c13.rpy:168
translate french c13s001_KiaraEileen_d05e3112:

    # eil "Si hubiera estado ahí..."
    eil "Si j'avais été là..."

# game/scripts/c13/c13.rpy:169
translate french c13s001_KiaraEileen_019b6db4:

    # mc "No es culpa tuya. Estabas trabajando. Dejaste la universidad para ayudar económicamente en casa porque tu padre perdió el trabajo. No se te puede exigir más."
    mc "Ce n'est pas de ta faute. Tu travaillais. Tu as quitté l'université pour aider ta famille parce que ton père a perdu son emploi. On ne peut pas t'en demander plus."

# game/scripts/c13/c13.rpy:170
translate french c13s001_KiaraEileen_b4bd6d48:

    # eil "Lo sé, pero..."
    eil "Je sais, mais..."

# game/scripts/c13/c13.rpy:172
translate french c13s001_KiaraEileen_a2860f19:

    # kia "[mc] tiene razón. No es culpa tuya. Ya haces demasiado. Pero mejor que siga..."
    kia "[mc] a raison. Ce n'est pas de ta faute. Tu en fais déjà trop. Mais je ferais mieux de continuer…"

# game/scripts/c13/c13.rpy:173
translate french c13s001_KiaraEileen_34d9eddc:

    # kia "Durante la cena estuvo gruñón, quejándose de la limpieza, de cenar tarde, y de... de otras cosas..."
    kia "Pendant le dîner, il était grognon, se plaignant de la propreté, du fait de manger tard, et de... d'autres choses..."

# game/scripts/c13/c13.rpy:174
translate french c13s001_KiaraEileen_da1a67d5:

    # mc "No hace falta que me expliques todo si no quieres..."
    mc "Tu n'es pas obligé de tout m'expliquer si tu ne le souhaites pas..."

# game/scripts/c13/c13.rpy:176
translate french c13s001_KiaraEileen_8d3c8ff4:

    # kia "No es eso... es que son temas de pareja..."
    kia "Ce n'est pas ça... ce sont juste des problèmes relationnels..."

# game/scripts/c13/c13.rpy:177
translate french c13s001_KiaraEileen_c2d6cb37:

    # mc "Entonces no me hace falta saberlo."
    mc "Alors je n'ai pas besoin de le savoir."

# game/scripts/c13/c13.rpy:178
translate french c13s001_KiaraEileen_b059fe3d:

    # kia "Es que... si no te lo explico... no vas a poder entender el resto..."
    kia "C'est juste que... si je ne vous l'explique pas... vous ne pourrez pas comprendre le reste..."

# game/scripts/c13/c13.rpy:179
translate french c13s001_KiaraEileen_18cb3e2c:

    # mc "Como quieras, pero te puedo asegurar que lo que me digas no va a salir de esta habitación."
    mc "Faites ce que vous voulez, mais je vous assure que ce que vous me direz ne quittera pas cette pièce."

# game/scripts/c13/c13.rpy:181
translate french c13s001_KiaraEileen_eaf933e8:

    # kia "Se quejaba de que ya no tenemos sexo nunca. ¡Hale, ya lo he dicho! ¡Ufff! Realmente va bien esto de hablar las cosas..."
    kia "Elle se plaignait qu'on ne fasse plus jamais l'amour. Voilà, c'est dit ! Ouf ! En parler, ça aide vraiment…"

# game/scripts/c13/c13.rpy:182
translate french c13s001_KiaraEileen_1a94dda9:

    # kia "Desde que empezó a beber, el no... no funciona bien... no le funciona bien su..."
    kia "Depuis qu'il a commencé à boire, il... il ne travaille plus bien... son..."

# game/scripts/c13/c13.rpy:183
translate french c13s001_KiaraEileen_2abb1f51:

    # mc "Vale, lo entiendo. No tiene erecciones."
    mc "D'accord, je comprends. Il n'a pas d'érection."

# game/scripts/c13/c13.rpy:185
translate french c13s001_KiaraEileen_3da85f71:

    # kia "Sí que las tiene. Pero duran segundos. Y no vuelven a subir. Hace meses que no... que no tenemos relaciones."
    kia "Oui, j'en ai. Mais ça ne dure que quelques secondes. Et ça ne revient pas. Ça fait des mois qu'on n'a pas fait l'amour."

# game/scripts/c13/c13.rpy:186
translate french c13s001_KiaraEileen_051ea5fd:

    # mc "El alcohol puede tener ese efecto."
    mc "L'alcool peut avoir cet effet."

# game/scripts/c13/c13.rpy:188
translate french c13s001_KiaraEileen_d0ea90e7:

    # kia "Pues después de cenar dijo que quería sexo. Había estado bebiendo cerveza durante la cena, y mientras esperaba a que la hiciera, añadiendo aún más alcohol al que llevaba cuando llegué."
    kia "Après le dîner, elle a dit qu'elle voulait faire l'amour. Elle avait bu de la bière pendant le repas, et pendant que j'attendais qu'elle se prépare, elle n'arrêtait pas d'en rajouter à ce qu'elle avait déjà bu quand je suis arrivé."

# game/scripts/c13/c13.rpy:189
translate french c13s001_KiaraEileen_731cbece:

    # kia "No me apetecía nada. En ese momento estaba frustrada y enfadada. Se lo dije."
    kia "Je n'en avais pas du tout envie. J'étais frustrée et en colère à ce moment-là. Je le lui ai dit."

# game/scripts/c13/c13.rpy:190
translate french c13s001_KiaraEileen_c32c4117:

    # mc "Y se puso violento."
    mc "Et il est devenu violent."

# game/scripts/c13/c13.rpy:192
translate french c13s001_KiaraEileen_546b4da9:

    # kia "Levantó la mano para darme una bofetada, pero se paró a tiempo."
    kia "Il leva la main pour me gifler, mais se retint à temps."

# game/scripts/c13/c13.rpy:193
translate french c13s001_KiaraEileen_4dc08df1:

    # kia "Me entró miedo."
    kia "J'ai eu peur."

# game/scripts/c13/c13.rpy:194
translate french c13s001_KiaraEileen_7d291a03:

    # kia "Le seguí a la habitación."
    kia "Je l'ai suivi jusqu'à la chambre."

# game/scripts/c13/c13.rpy:196
translate french c13s001_KiaraEileen_bad62e5e:

    # kia "Se desnudó y aquello estaba fláccido. No iba a subir..."
    kia "Il se déshabilla et il était mou. Il n'allait pas bander..."

# game/scripts/c13/c13.rpy:197
translate french c13s001_KiaraEileen_4c73c4a8:

    # kia "Y se enfadó aún más."
    kia "Et il s'est encore plus énervé."

# game/scripts/c13/c13.rpy:198
translate french c13s001_KiaraEileen_1403f12b:

    # kia "Empezó a culparme a mí. Dijo que ya no me vestía sexy para él nunca. Que ya no le excitaba. Que se iba a buscar una más joven que yo."
    kia "Il a commencé à me reprocher des choses. Il disait que je ne m'habillais plus sexy pour lui, que je ne l'excitais plus, et qu'il allait trouver quelqu'un de plus jeune."

# game/scripts/c13/c13.rpy:199
translate french c13s001_KiaraEileen_38f84272:

    # mc "*Entre dientes* ¡Capullo!"
    mc "*Entre les dents serrées* Espèce d'idiot !"

# game/scripts/c13/c13.rpy:201
translate french c13s001_KiaraEileen_27afa0b2:

    # kia "Me cogió por el brazo y empezó a llevarme de habitación en habitación. Enseñándome todo lo que según él estaba mal."
    kia "Il m'a attrapé le bras et a commencé à me conduire de pièce en pièce, me montrant tout ce qui, selon lui, n'allait pas."

# game/scripts/c13/c13.rpy:202
translate french c13s001_KiaraEileen_2ec72b42:

    # kia "Platos por fregar... los de {b}SU{/b} comida y los de la cena..."
    kia "De la vaisselle à faire... celle de son déjeuner et celle du dîner..."

# game/scripts/c13/c13.rpy:203
translate french c13s001_KiaraEileen_0f44a1cc:

    # kia "Alguna ventana no estaba del todo limpia... la compra que habían entregado ese día estaba por guardar... había ropa por poner en la lavadora..."
    kia "Certaines fenêtres n'étaient pas tout à fait propres… les courses livrées ce jour-là devaient encore être rangées… il y avait du linge à mettre dans la machine à laver…"

# game/scripts/c13/c13.rpy:205
translate french c13s001_KiaraEileen_f627363a:

    # eil "Ahí es donde llegué yo... el espectáculo era dantesco. Mi padre en pelotas arrastrando a mi madre, vestida, del brazo por el suelo en la sala de la lavadora..."
    eil "C’est là que je suis intervenu… la scène était horrible. Mon père, complètement nu, traînait ma mère, toute habillée, par le bras à travers la buanderie…"

# game/scripts/c13/c13.rpy:206
translate french c13s001_KiaraEileen_5ce2593c:

    # eil "Había ropa para poner una lavadora a lo sumo. Mi ropa de correr de la mañana, una muda de mi madre y ropa de mi padre. Olía a vómito."
    eil "Il y avait assez de linge pour une machine tout au plus. Mes vêtements de course du matin, des vêtements de rechange pour ma mère et quelques vêtements de mon père. Ça sentait le vomi."

# game/scripts/c13/c13.rpy:207
translate french c13s001_KiaraEileen_9e333d94:

    # mc "¿Él no tiene manos? ¿No puede poner la lavadora mientras las dos estáis trabajando?"
    mc "Il n'a pas de mains ? Il ne peut pas faire la lessive pendant que vous travaillez tous les deux ?"

# game/scripts/c13/c13.rpy:209
translate french c13s001_KiaraEileen_037532b9:

    # eil "Eso sería muy degradante para él. ¿Cómo quieres que limpie o ponga a lavar la ropa si tiene a dos mujeres en casa?"
    eil "Ce serait très humiliant pour lui. Comment voulez-vous qu'il fasse le ménage ou la lessive alors qu'il y a deux femmes à la maison ?"

# game/scripts/c13/c13.rpy:210
translate french c13s001_KiaraEileen_a94fa32a:

    # eil "Es mejor estar todo el día en el sofá, viendo la tele y bebiendo, y después quejarse de que no hay nada hecho en casa."
    eil "Il vaut mieux passer toute la journée sur le canapé, à regarder la télé et à boire, et ensuite se plaindre que rien n'est fait à la maison."

# game/scripts/c13/c13.rpy:211
translate french c13s001_KiaraEileen_42e46ebe:

    # mc "¿Entonces fue cuando os fuisteis?"
    mc "C'est donc à ce moment-là que vous êtes parti ?"

# game/scripts/c13/c13.rpy:213
translate french c13s001_KiaraEileen_466c8b2b:

    # eil "Entonces es cuando a él le entraron las arcadas. No solo es un borracho. Es un mal bebedor con poco aguante."
    eil "C'est à ce moment-là qu'il a commencé à avoir des haut-le-cœur. Ce n'est pas juste un ivrogne. C'est un mauvais buveur qui supporte très mal l'alcool."

# game/scripts/c13/c13.rpy:214
translate french c13s001_KiaraEileen_1bfe4335:

    # eil "Salió corriendo hacia el baño para vomitar."
    eil "Elle a couru aux toilettes pour vomir."

# game/scripts/c13/c13.rpy:216
translate french c13s001_KiaraEileen_a0b345bb:

    # kia "Y se quedó dormido encima de la taza del wáter después de hacerlo."
    kia "Et il s'est endormi sur la cuvette des toilettes après avoir fait ça."

# game/scripts/c13/c13.rpy:217
translate french c13s001_KiaraEileen_5a8eb6b5:

    # kia "En ese momento Eileen me convenció para irnos. Cuando se despertara, iba a ser peor."
    kia "À ce moment-là, Eileen m'a convaincue de partir. À son réveil, la situation allait empirer."

# game/scripts/c13/c13.rpy:219
translate french c13s001_KiaraEileen_499d7503:

    # kia "Metí algo de ropa en la bolsa de viaje, los cepillos de dientes y nos fuimos."
    kia "J'ai mis quelques vêtements dans le sac de voyage, les brosses à dents, et nous sommes partis."

# game/scripts/c13/c13.rpy:220
translate french c13s001_KiaraEileen_25565407:

    # kia "Eileen llamó a su amiga, la policía..."
    kia "Eileen a appelé son amie, la police..."

# game/scripts/c13/c13.rpy:222
translate french c13s001_KiaraEileen_09f97d02:

    # kia "Aunque le dije que no quería poner una denuncia..."
    kia "Même si je lui ai dit que je ne voulais pas porter plainte..."

# game/scripts/c13/c13.rpy:224
translate french c13s001_KiaraEileen_1b2ac818:

    # eil "La llamaba para saber si podíamos quedarnos en su casa, no para poner una denuncia. Su abuelo se iba hoy y sabía que tendría una habitación libre."
    eil "J'appelais pour savoir si nous pouvions loger chez elle, pas pour porter plainte. Son grand-père partait aujourd'hui et elle savait qu'elle aurait une chambre libre."

# game/scripts/c13/c13.rpy:225
translate french c13s001_KiaraEileen_47d710b1:

    # eil "Pero está en San Diego con sus padres. No le he dicho por qué la llamaba, no quería preocuparla."
    eil "Mais elle est à San Diego chez ses parents. Je ne lui ai pas dit pourquoi j'appelais ; je ne voulais pas l'inquiéter."

# game/scripts/c13/c13.rpy:226
translate french c13s001_KiaraEileen_0506f6c5:

    # eil "Y entonces te he llamado a ti. No es que fueras la segunda opción, pero creía que..."
    eil "Et puis je t'ai appelé. Non pas que tu étais mon second choix, mais je pensais…"

# game/scripts/c13/c13.rpy:227
translate french c13s001_KiaraEileen_cfde5b02:

    # mc "Que si tu madre hablaba con una policía, Alexia la convencería para poner la denuncia."
    mc "Si votre mère parlait à un policier, Alexia la convaincrait de porter plainte."

# game/scripts/c13/c13.rpy:229
translate french c13s001_KiaraEileen_7cb453b2:

    # eil "Al menos la haría entrar en razón. En ese momento mi madre estaba diciendo que buscásemos algún sitio donde pasar esta noche."
    eil "Au moins, ça la ferait entendre raison. À ce moment-là, ma mère disait qu'il fallait trouver un endroit où passer la nuit."

# game/scripts/c13/c13.rpy:230
translate french c13s001_KiaraEileen_0dce7da8:

    # eil "Sólo esta noche..."
    eil "Ce soir seulement..."

# game/scripts/c13/c13.rpy:232
translate french c13s001_KiaraEileen_5863b783:

    # kia "¿Qué querías que hiciera? ¿Que abandonase a mi marido y mi casa? Todos los matrimonios tienen problemas..."
    kia "Que vouliez-vous que je fasse ? Que je quitte mon mari et ma maison ? Tous les mariages connaissent des problèmes…"

# game/scripts/c13/c13.rpy:233
translate french c13s001_KiaraEileen_ab6bae3b:

    # mc "Creo que es lo mejor, al menos por unos días. Que le vea las orejas al lobo."
    mc "Je pense que c'est mieux ainsi, au moins pour quelques jours. Qu'il voie le danger qui le guette."

# game/scripts/c13/c13.rpy:234
translate french c13s001_KiaraEileen_72b0ae97:

    # mc "A lo mejor reacciona y vuelve a dejar la bebida..."
    mc "Peut-être qu'il reprendra ses esprits et arrêtera de boire à nouveau..."

# game/scripts/c13/c13.rpy:236
translate french c13s001_KiaraEileen_11435d8b:

    # eil "Es lo que le he dicho. Una semana como mínimo. Al final ha aceptado. Mañana buscaremos un hotel."
    eil "C'est ce que je lui ai dit. Au moins une semaine. Il a fini par accepter. On cherchera un hôtel demain."

# game/scripts/c13/c13.rpy:237
translate french c13s001_KiaraEileen_f27e6e78:

    # mc "No hace falta. Tenéis esta habitación para vosotras todo el tiempo que queráis."
    mc "Ce n'est pas nécessaire. Vous avez cette chambre pour vous seuls aussi longtemps que vous le souhaitez."

# game/scripts/c13/c13.rpy:239
translate french c13s001_KiaraEileen_405969b9:

    # kia "No podemos hacerte eso. No podemos echarte de tu habitación durante una semana. Mañana buscamos un hotel o algo donde quedarnos unos días."
    kia "Nous ne pouvons pas vous faire ça. Nous ne pouvons pas vous mettre à la porte de votre chambre pendant une semaine. Demain, nous trouverons un hôtel ou un autre endroit où loger quelques jours."

# game/scripts/c13/c13.rpy:240
translate french c13s001_KiaraEileen_278fe9f3:

    # mc "Entonces, en casa de [nor] hay una habitación vacía. Es para las estudiantes que llegan en otoño. Al menos hasta entonces la podéis usar."
    mc "Il y a donc une chambre libre chez [nor]. Elle est réservée aux étudiants qui arriveront à la rentrée. Tu peux l'utiliser au moins jusque-là."

# game/scripts/c13/c13.rpy:241
translate french c13s001_KiaraEileen_f61f3aa7:

    # mc "A [nor] no le va a importar en el momento en que sepa vuestra situación, os lo aseguro. Al menos la situación que queráis explicarle."
    mc "[nor] s'en moquera une fois qu'il connaîtra votre situation, je vous l'assure. Du moins, pas celle que vous voulez lui expliquer."

# game/scripts/c13/c13.rpy:243
translate french c13s001_KiaraEileen_668d609e:

    # eil "¿De verdad crees que nos va a dejar dormir en su casa?"
    eil "Tu crois vraiment qu'il va nous laisser dormir chez lui ?"

# game/scripts/c13/c13.rpy:244
translate french c13s001_KiaraEileen_ff59411a:

    # mc "Eile, a [nor] siempre le has gustado. No va a tener ningún problema con ello. ¿Cuánto hace que no la ves?"
    mc "Eile, [nor] t'a toujours bien aimé. Ça ne la dérangera pas. Ça fait combien de temps que tu ne l'as pas vue ?"

# game/scripts/c13/c13.rpy:246
translate french c13s001_KiaraEileen_85f495a6:

    # eil "Mucho. No tengo ni idea de cuanto... ¿un año? ¿dos? Al contrario que tú, cuando ella lleva a [eri] al trabajo, no entra a tomarse ni siquiera un café."
    eil "Beaucoup. Je n'ai aucune idée de combien de temps… un an ? Deux ? Contrairement à toi, quand elle emmène [eri] au travail, elle ne s'arrête même pas prendre un café."

# game/scripts/c13/c13.rpy:247
translate french c13s001_KiaraEileen_d46540c0:

    # mc "Entonces no te diré nada. Por la mañana te llevarás una pequeña sorpresa."
    mc "Alors je ne te dirai rien. Tu auras une petite surprise demain matin."

# game/scripts/c13/c13.rpy:248
translate french c13s001_KiaraEileen_b94084a4:

    # mc "Creo que con esto está todo arreglado, al menos el alojamiento. ¿Necesitáis algo más?"
    mc "Je crois que c'est tout, du moins pour l'hébergement. Avez-vous besoin de quelque chose d'autre ?"

# game/scripts/c13/c13.rpy:250
translate french c13s001_KiaraEileen_80032951:

    # kia "Si nos vamos a quedar una semana, deberíamos pasar por casa a buscar más ropa. Metí ropa para un par de días en la bolsa. Y ni siquiera los pijamas..."
    kia "Si on reste une semaine, il faudrait qu'on rentre chercher des vêtements. J'ai mis juste de quoi tenir deux jours. Même pas de pyjama…"

# game/scripts/c13/c13.rpy:251
translate french c13s001_KiaraEileen_d2d77d32:

    # mc "Yo de vosotras no iría mientras Solomon esté allí, o al menos no solas. Si queréis os acompaño."
    mc "Je n'irais pas à ta place tant que Solomon est là-bas, ou du moins pas seul. Si tu veux, je peux t'accompagner."

# game/scripts/c13/c13.rpy:253
translate french c13s001_KiaraEileen_d58ee944:

    # eil "Yo puedo aguantar dos o tres días perfectamente. Los jueves por la noche mi padre se va de copas con sus amigos y podríamos ir a casa."
    eil "Je peux facilement tenir deux ou trois jours. Le jeudi soir, mon père sort boire un verre avec ses amis, et nous pourrions aller chez lui."

# game/scripts/c13/c13.rpy:254
translate french c13s001_KiaraEileen_4e4e6a42:

    # mc "Kiara, ¿tú tienes ropa para aguantar hasta el jueves? Si no, habiendo 11 mujeres en casa, seguro que alguna os puede dejar ropa. O podéis coger mis camisetas; os quedan geniales."
    mc "Kiara, as-tu assez de vêtements pour tenir jusqu'à jeudi ? Sinon, avec onze femmes à la maison, je suis sûre que l'une d'elles pourra t'en prêter. Ou alors, tu peux prendre mes t-shirts ; ils te vont très bien."

# game/scripts/c13/c13.rpy:255
translate french c13s001_KiaraEileen_ad312c1d:

    # mc "Además, aunque vivamos en medio de la nada, también tenemos lavadoras. *Risa*"
    mc "En plus, même si on vit en plein milieu de nulle part, on a aussi des machines à laver. *Rires*"

# game/scripts/c13/c13.rpy:257
translate french c13s001_KiaraEileen_814c0592:

    # kia "No te preocupes, cogí mi ropa de trabajo y dos uniformes para Eileen, eso es lo más importante. El resto se puede comprar o lavar hasta que el jueves podamos volver."
    kia "Ne t'inquiète pas, j'ai préparé mes vêtements de travail et deux uniformes pour Eileen ; c'est le plus important. Le reste peut être acheté ou lavé d'ici jeudi, notre retour."

# game/scripts/c13/c13.rpy:258
translate french c13s001_KiaraEileen_9445b609:

    # mc "Ahora que pienso, el miércoles vuelve Alexia, con lo que también nos podría acompañar el jueves si fuera necesario. Tener una policía cerca impone."
    mc "Maintenant que j'y pense, Alexia revient mercredi, donc elle pourrait aussi se joindre à nous jeudi si besoin. La présence d'un policier à proximité est intimidante."

# game/scripts/c13/c13.rpy:259
translate french c13s001_KiaraEileen_8ea7b98f:

    # mc "Y, una vez aclarado todo esto, os voy a dejar dormir."
    mc "Et, une fois que tout cela sera éclairci, je vous laisserai dormir."

# game/scripts/c13/c13.rpy:261
translate french c13s001_KiaraEileen_416c371b:

    # mc "¿Puedo hablar un momento en privado contigo, Eileen?"
    mc "Puis-je vous parler en privé un instant, Eileen ?"

# game/scripts/c13/c13.rpy:263
translate french c13s001_KiaraEileen_7afdc227:

    # eil "Sí, vamos fuera. Ahora vuelvo, Mamá."
    eil "Oui, allons dehors. Je reviens tout de suite, maman."

# game/scripts/c13/c13.rpy:265
translate french c13s001_KiaraEileen_05097a2b:

    # kia "No es necesario. Voy al lavabo y os dejo un poco de privacidad. ¿Cuánto tiempo necesitáis?"
    kia "Ce n'est pas nécessaire. Je vais aux toilettes et je vous laisserai tranquille. De combien de temps avez-vous besoin ?"

# game/scripts/c13/c13.rpy:266
translate french c13s001_KiaraEileen_8572b191:

    # mc "*Risa* No es eso, Kiara. No vamos a enrollarnos aquí... al menos no hoy. *Risa*"
    mc "*Rires* Ce n'est pas ça, Kiara. On ne va pas s'en mêler... du moins pas aujourd'hui. *Rires*"

# game/scripts/c13/c13.rpy:267
translate french c13s001_KiaraEileen_1f6f2478:

    # kia "*Risa* Vale, pues vuelvo en cinco minutos. ¿Tendrás suficiente?"
    kia "*Rires* D'accord, je reviens dans cinq minutes. Ça vous suffira ?"

# game/scripts/c13/c13.rpy:268
translate french c13s001_KiaraEileen_53c320af:

    # mc "Sí, por supuesto. La primera puerta a la izquierda una vez pases el gimnasio."
    mc "Oui, bien sûr. La première porte à gauche après la salle de sport."

# game/scripts/c13/c13.rpy:270
translate french c13s001_KiaraEileen_3c732c7a:

    # eil "¿De qué querías hablar que no pudieras hablar delante de mi madre?"
    eil "De quoi voulais-tu parler que tu ne pouvais pas aborder devant ma mère ?"

# game/scripts/c13/c13.rpy:273
translate french c13s001_KiaraEileen_e87a4a31:

    # mc "Ya sabes que estoy con [eri]. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Tu sais que je suis avec [eri]. Je veux juste que Kiara sache qu'elle pourrait voir des choses surprenantes, et je ne veux pas qu'elle pense que je te trompe."

# game/scripts/c13/c13.rpy:275
translate french c13s001_KiaraEileen_4cf7ce64:

    # mc "Ya sabes que estoy con Alexia. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Tu sais que je suis avec Alexia. Je veux juste que Kiara sache qu'elle pourrait voir des choses surprenantes, et je ne veux pas qu'elle pense que je te trompe."

# game/scripts/c13/c13.rpy:277
translate french c13s001_KiaraEileen_9b77594e:

    # mc "Ya sabes que estoy con alguien más. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Tu sais que je vois quelqu'un d'autre. Je veux juste que Kiara sache qu'elle pourrait voir des choses surprenantes, et je ne veux pas qu'elle pense que je te trompe."

# game/scripts/c13/c13.rpy:279
translate french c13s001_KiaraEileen_e8ce2c07:

    # eil "Tienes razón, no había caído en eso. Le diré lo especial de nuestra relación para que no te saque los ojos si te ve en los brazos de otra."
    eil "Tu as raison, je n'y avais pas pensé. Je lui dirai à quel point notre relation est spéciale pour qu'il ne te crève pas les yeux s'il te voit dans les bras d'un autre."

# game/scripts/c13/c13.rpy:280
translate french c13s001_KiaraEileen_85ef00a7:

    # mc "Además..."
    mc "En plus..."

# game/scripts/c13/c13.rpy:282
translate french c13s001_KiaraEileen_7435106d:

    # mc "Me moría por besarte antes de ir a dormir."
    mc "J'avais tellement envie de t'embrasser avant de m'endormir."

# game/scripts/c13/c13.rpy:285
translate french c13s001_KiaraEileen_ab44b008:

    # mc "Tan solo me moría por besarte antes de ir a dormir."
    mc "J'avais tellement envie de t'embrasser avant de m'endormir."

# game/scripts/c13/c13.rpy:286
translate french c13s001_KiaraEileen_b919e696:

    # eil "No te tienes que esconder de mi madre para besarme. Ni de mi madre ni de nadie. Soy una adulta y puedo besar a quien quiera. Y al único que quiero besar es a ti."
    eil "Tu n'as pas besoin de te cacher de ma mère pour m'embrasser. Ni de ma mère, ni de personne. Je suis majeure et je peux embrasser qui je veux. Et la seule personne que j'ai envie d'embrasser, c'est toi."

# game/scripts/c13/c13.rpy:287
translate french c13s001_KiaraEileen_a4eab181:

    # eil "Si necesitas decirle a alguien que salimos juntos, puedes hacerlo. Yo tampoco me tengo que esconder."
    eil "Si tu as besoin de dire à quelqu'un que nous sommes ensemble, tu peux. Je n'ai pas à le cacher non plus."

# game/scripts/c13/c13.rpy:288
translate french c13s001_KiaraEileen_1c7cd109:

    # mc "Entonces no me esconderé. Me voy a ir a mi sofá y os voy a dejar descansar... Un poco más y me olvido de coger la ropa."
    mc "Alors je ne me cacherai pas. Je vais aller sur mon canapé et vous laisser vous reposer… J’ai failli oublier de m’habiller."

# game/scripts/c13/c13.rpy:290
translate french c13s001_KiaraEileen_50dfb39e:

    # mc "Hasta mañana, mi amor."
    mc "À demain, mon amour."

# game/scripts/c13/c13.rpy:291
translate french c13s001_KiaraEileen_73d51b30:

    # eil "Hasta mañana, mi vida. Te quiero."
    eil "À demain, mon amour. Je t'aime."

# game/scripts/c13/c13.rpy:292
translate french c13s001_KiaraEileen_90083b80:

    # mc "Y yo a ti."
    mc "Et moi, toi."

# game/scripts/c13/c13.rpy:295
translate french c13s001_KiaraEileen_b47b16b6:

    # kia "¿Dónde has dicho que estaba el lavabo?"
    kia "Où avez-vous dit que se trouvait l'évier ?"

# game/scripts/c13/c13.rpy:296
translate french c13s001_KiaraEileen_f445e6ec:

    # mc "La primera puerta a la izquierda una vez pases el gimnasio."
    mc "La première porte à gauche après avoir passé la salle de sport."

# game/scripts/c13/c13.rpy:298
translate french c13s001_KiaraEileen_f364d0f9:

    # eil "Gracias por todo, [mc]. No sé qué hubiéramos hecho sin ti hoy."
    eil "Merci pour tout, [mc]. Je ne sais pas ce que nous aurions fait sans toi aujourd'hui."

# game/scripts/c13/c13.rpy:299
translate french c13s001_KiaraEileen_e53ba6e2:

    # mc "Para eso estamos los amigos. Ya sabes que puedes contar conmigo para lo que necesites."
    mc "C'est à ça que servent les amis. Tu sais que tu peux compter sur moi pour tout ce dont tu as besoin."

# game/scripts/c13/c13.rpy:301
translate french c13s001_KiaraEileen_c4cd41ac:

    # eil "Cuánto te he echado de menos estos tres años. No hay hombres como tú."
    eil "Tu m'as tellement manqué ces trois dernières années. Il n'y a pas d'hommes comme toi."

# game/scripts/c13/c13.rpy:302
translate french c13s001_KiaraEileen_8193145e:

    # mc "¿Como yo? Espera... ¿cómo me llamabas cuando salíamos juntos? ¿Cabeza hueca?"
    mc "M'aimer ? Attends… comment m'appelais-tu quand on sortait ensemble ? Tête en l'air ?"

# game/scripts/c13/c13.rpy:304
translate french c13s001_KiaraEileen_8f3c4879:

    # eil "No, eso era lo que tú llamabas me llamabas a mí cuando empezamos a salir. *Risa*"
    eil "Non, c'est comme ça que tu m'appelais quand on a commencé à sortir ensemble. *Rires*"

# game/scripts/c13/c13.rpy:305
translate french c13s001_KiaraEileen_cdd0ac73:

    # mc "Bueno, te voy a dejar descansar. Tienes que estar agotada después de trabajar y todo el problema que te has encontrado al llegar a casa."
    mc "D'accord, je te laisse te reposer. Tu dois être épuisée après le travail et tous les problèmes que tu as rencontrés en rentrant."

# game/scripts/c13/c13.rpy:306
translate french c13s001_KiaraEileen_41ad32af:

    # mc "Hasta mañana, Eile."
    mc "À demain, Eile."

# game/scripts/c13/c13.rpy:307
translate french c13s001_KiaraEileen_3fd283cd:

    # eil "Hasta mañana, [mc]."
    eil "À demain, [mc]."

# game/scripts/c13/c13.rpy:309
translate french c13s001_KiaraEileen_3523084d:

    # kia "¿Ya te marchas?"
    kia "Tu pars déjà ?"

# game/scripts/c13/c13.rpy:310
translate french c13s001_KiaraEileen_2821dae0:

    # mc "Sí, es tarde y tenéis que descansar. Mañana tengo que ir a un par de sitios, pero si te despiertas pronto puedo llevarte al hospital."
    mc "Oui, il est tard et tu as besoin de te reposer. Je dois aller à deux ou trois endroits demain, mais si tu te réveilles tôt, je peux t'emmener à l'hôpital."

# game/scripts/c13/c13.rpy:312
translate french c13s001_KiaraEileen_4630e054:

    # kia "[mc], ya te he dicho que no quería poner una denuncia..."
    kia "[mc], je vous ai déjà dit que je ne voulais pas porter plainte..."

# game/scripts/c13/c13.rpy:313
translate french c13s001_KiaraEileen_59f239a8:

    # mc "Te dejaré en manos de una enfermera que es buena amiga también. Si no quieres poner denuncia, no te va a obligar, pero al menos verá como está ese hematoma."
    mc "Je vous confie à une infirmière qui est aussi une bonne amie. Si vous ne souhaitez pas porter plainte, elle ne vous y obligera pas, mais au moins elle pourra examiner votre ecchymose."

# game/scripts/c13/c13.rpy:315
translate french c13s001_KiaraEileen_2066e28b:

    # "Kiara te abraza con fuerza. Es un abrazo que dice a gritos que está herida, más allá de las heridas físicas, que es vulnerable, y que necesita esa curación que dice que tus abrazos ofrecen."
    "Kiara vous serre fort dans ses bras. C'est une étreinte qui crie sa souffrance, au-delà des blessures physiques, sa vulnérabilité, et son besoin de la guérison que, selon elle, vos câlins lui apportent."

# game/scripts/c13/c13.rpy:316
translate french c13s001_KiaraEileen_cd4373aa:

    # kia "Gracias, [mc]. Por darnos un techo y por entender mi decisión sobre la denuncia."
    kia "Merci, [mc]. De nous avoir donné un toit au-dessus de nos têtes et d'avoir compris ma décision de porter plainte."

# game/scripts/c13/c13.rpy:317
translate french c13s001_KiaraEileen_c06cd2f2:

    # mc "No la comparto ni la comprendo, pero tengo que respetarla. No puedo obligarte a presentar una denuncia si no quieres."
    mc "Je ne suis ni d'accord ni ne comprends cela, mais je dois le respecter. Je ne peux pas vous forcer à porter plainte si vous ne le souhaitez pas."

# game/scripts/c13/c13.rpy:318
translate french c13s001_KiaraEileen_d4dbd92c:

    # "Pasáis unos minutos en silencio, disfrutando del abrazo. Kiara se separa de ti reluctantemente."
    "Vous restez quelques minutes en silence, savourant l'étreinte. Kiara se détache de vous à contrecœur."

# game/scripts/c13/c13.rpy:320
translate french c13s001_KiaraEileen_fa9f4ae1:

    # kia "Buenas noches, [mc]. Que descanses bien."
    kia "Bonne nuit, [mc]. Dors bien."

# game/scripts/c13/c13.rpy:321
translate french c13s001_KiaraEileen_556ca554:

    # mc "Buenas noches, Kiara. Duerme todo lo que puedas."
    mc "Bonne nuit, Kiara. Dors autant que tu le peux."

# game/scripts/c13/c13.rpy:348
translate french c13s001_SleepingInTheCouch_c4d9422a:

    # "Vuelves a la tercera planta después de cambiarte a algo más cómodo para dormir."
    "Vous retournez au troisième étage après vous être changé(e) et avoir enfilé des vêtements plus confortables pour dormir."

# game/scripts/c13/c13.rpy:349
translate french c13s001_SleepingInTheCouch_e2a8a1db:

    # "Nunca pensaste que echarías de menos a Lisa en ese sofá."
    "Tu n'aurais jamais cru que Lisa te manquerait sur ce canapé."

# game/scripts/c13/c13.rpy:351
translate french c13s001_SleepingInTheCouch_4f7bd40e:

    # "Te tumbas mirando al techo. Sabes que te va a costar dormirte después de los eventos de la noc...zzzz"
    "Vous vous allongez et fixez le plafond. Vous savez qu'il sera difficile de vous endormir après les événements de la nuit… zzzz"

# game/scripts/c13/c13.rpy:353
translate french c13s001_SleepingInTheCouch_83246def:

    # centered "{size=+20}{b}DIA 15 - MARTES \n 6:13{/b}{/size}"
    centered "{size=+20}{b}JOUR 15 - MARDI \n 6:13{/b}{/size}"

# game/scripts/c13/c13.rpy:354
translate french c13s001_SleepingInTheCouch_bc02ef79:

    # "Te despiertan unos pasos y la puerta del baño que se cierra."
    "Vous êtes réveillé par des bruits de pas et le bruit de la porte de la salle de bain qui se ferme."

# game/scripts/c13/c13.rpy:356
translate french c13s001_SleepingInTheCouch_22bfb38d:

    # "Miras el reloj del móvil. Las 6:13. Difícilmente vas a poder volver a dormirte. Ya ha amanecido."
    "Vous regardez l'heure sur votre téléphone. 6h13. Il est peu probable que vous parveniez à vous rendormir. Le jour se lève déjà."

# game/scripts/c13/c13.rpy:359
translate french c13s001_SleepingInTheCouch_a44d8959:

    # kat "Buenos días, [mc]. ¿Qué haces aquí? ¿Esperando a Lisa?"
    kat "Bonjour, [mc]. Que fais-tu ici ? Tu attends Lisa ?"

# game/scripts/c13/c13.rpy:360
translate french c13s001_SleepingInTheCouch_c20e358c:

    # mc "No, hay dos chicas en mi habitación y quería dejarlas dormir tranquilamente."
    mc "Non, il y a deux filles dans ma chambre et je voulais les laisser dormir tranquilles."

# game/scripts/c13/c13.rpy:362
translate french c13s001_SleepingInTheCouch_688fa6ff:

    # kat "¿Dos chicas en tu habitación? ¡Tenemos un macho en la casa!"
    kat "Deux filles dans ta chambre ? Il y a un homme dans la maison !"

# game/scripts/c13/c13.rpy:363
translate french c13s001_SleepingInTheCouch_a34a775e:

    # mc "*Risa* No, no va por ahí. Son dos amigas que necesitaban un sitio donde pasar la noche. Les he prestado mi cama."
    mc "*Rires* Non, ce n'est pas ça. Ce sont deux amis qui avaient besoin d'un endroit où passer la nuit. Je leur ai prêté mon lit."

# game/scripts/c13/c13.rpy:365
translate french c13s001_SleepingInTheCouch_620057e0:

    # kat "Entonces no es un macho, es un caballero. Podemos hacer un intercambio. Subo yo a tu habitación y tu duermes en mi cama. *Risa*"
    kat "Ce n'est donc pas un macho, c'est un gentleman. On peut faire un échange. Je monte dans ta chambre et tu dors dans mon lit. *Rires*"

# game/scripts/c13/c13.rpy:366
translate french c13s001_SleepingInTheCouch_0ed05e30:

    # mc "*Risa* Creo que os lo podríais pasar muy bien juntas, pero creo que no como tú esperarías."
    mc "*Rires* Je pense que vous pourriez passer un bon moment ensemble, mais je ne pense pas que ce serait de la manière dont vous l'imaginez."

# game/scripts/c13/c13.rpy:367
translate french c13s001_SleepingInTheCouch_07a63ac4:

    # mc "Una era mi novia en el instituto y la otra es su madre. Casada. Con un hombre."
    mc "L'une était ma petite amie au lycée, l'autre est sa mère. Mariée. À un homme."

# game/scripts/c13/c13.rpy:369
translate french c13s001_SleepingInTheCouch_5ade8e4a:

    # kat "*Risa* Entonces no te cambio la cama. Además, Kim se podría asustar si se despierta y te ve a ti en vez de a mí."
    kat "*Rires* Alors je ne changerai pas ton lit. En plus, Kim pourrait avoir peur si elle se réveille et te voit à ma place."

# game/scripts/c13/c13.rpy:371
translate french c13s001_SleepingInTheCouch_0f251b26:

    # kat "Después de lo que le dijiste ayer del mapa de su piel... creo que la hiciste feliz por todo el día."
    kat "Après ce que tu lui as dit hier à propos de la carte de sa peau… je pense que tu l’as rendue heureuse pour toute la journée."

# game/scripts/c13/c13.rpy:372
translate french c13s001_SleepingInTheCouch_bb4228c0:

    # mc "*Risa* Lo más divertido de todo es que no lo dije sobre ella en concreto, sino que lo dije en un hipotético caso. Además sonó muy cursi."
    mc "*Rires* Le plus drôle, c'est que je ne l'ai pas dit à son sujet précisément, mais plutôt dans un scénario hypothétique. Et puis, ça sonnait vraiment ringard."

# game/scripts/c13/c13.rpy:374
translate french c13s001_SleepingInTheCouch_3b9a9045:

    # kat "Después de lo que le dijiste ayer sobre su piel... creo que aún está enfadada contigo."
    kat "Après ce que tu lui as dit hier à propos de sa peau… je pense qu’elle t’en veut encore."

# game/scripts/c13/c13.rpy:375
translate french c13s001_SleepingInTheCouch_0c54b117:

    # mc "Bueno, no era mi intención enfadarla, tan solo es que... creo que tenía razón si tanto le molesta llamar la atención."
    mc "Eh bien, je ne voulais pas la contrarier, c'est juste que... je pense qu'elle a raison si elle est si dérangée d'être le centre de l'attention."

# game/scripts/c13/c13.rpy:377
translate french c13s001_SleepingInTheCouch_eaf840b2:

    # kat "¿Te importa que me siente?"
    kat "Ça vous dérange si je m'assieds ?"

# game/scripts/c13/c13.rpy:378
translate french c13s001_SleepingInTheCouch_c87da1de:

    # mc "Por supuesto que no. Soy yo quien ha invadido vuestra planta."
    mc "Bien sûr que non. C'est moi qui ai envahi votre usine."

# game/scripts/c13/c13.rpy:379
translate french c13s001_SleepingInTheCouch_8cd07e23:

    # kat "Y nosotras hemos invadido tu casa. Lo podríamos llamar un empate."
    kat "Et nous avons envahi votre maison. On pourrait dire match nul."

# game/scripts/c13/c13.rpy:380
translate french c13s001_SleepingInTheCouch_31ab9b11:

    # mc "¿Qué tal la adaptación a la nueva casa y a la nueva universidad?"
    mc "Comment se passe l'adaptation à la nouvelle maison et à la nouvelle université ?"

# game/scripts/c13/c13.rpy:382
translate french c13s001_SleepingInTheCouch_a9cde451:

    # kat "La universidad está genial. Tiene un muy buen programa de oceanografía y está cerca del mar. Estudiar en Phoenix sobre acuarios no tiene el mismo valor."
    kat "L'université est formidable. Son programme d'océanographie est excellent et elle est située près de la mer. Étudier les aquariums à Phoenix n'a pas le même intérêt."

# game/scripts/c13/c13.rpy:383
translate french c13s001_SleepingInTheCouch_5aa8514f:

    # mc "Está bien, es una universidad relativamente pequeña, pero de muy buen nivel."
    mc "C'est très bien, c'est une université relativement petite, mais d'un très bon niveau."

# game/scripts/c13/c13.rpy:384
translate french c13s001_SleepingInTheCouch_f4b5c5b2:

    # mc "¿Y la casa? ¿Algún problema hasta ahora?"
    mc "Et la maison ? Des problèmes jusqu'à présent ?"

# game/scripts/c13/c13.rpy:386
translate french c13s001_SleepingInTheCouch_138040f8:

    # kat "La casa es impresionante. Creía que siendo tan pocas podía haber problemas entre nosotras. Ya sabes... ser la primera gallina del corral y esas cosas."
    kat "La maison est magnifique. Je craignais qu'avec si peu de monde, il y ait des tensions. Vous savez… être la première poule dans le poulailler, et tout ça."

# game/scripts/c13/c13.rpy:387
translate french c13s001_SleepingInTheCouch_f34c0968:

    # kat "Además, ya conocía a Lisa y me imaginaba que iba a luchar por esa posición. Pero me está sorprendiendo mucho. Parece una mujer diferente de la de Phoenix."
    kat "De plus, je connaissais déjà Lisa et j'imaginais qu'elle se battrait pour ce poste. Mais elle me surprend vraiment. Elle semble être une personne différente de celle de Phoenix."

# game/scripts/c13/c13.rpy:388
translate french c13s001_SleepingInTheCouch_a3db4774:

    # mc "Parece incluso una mujer diferente de la que llegó el viernes al aeropuerto."
    mc "Elle ressemble même à une autre femme que celle qui est arrivée à l'aéroport vendredi."

# game/scripts/c13/c13.rpy:390
translate french c13s001_SleepingInTheCouch_4cc0eb54:

    # kat "No sé que le dais de comer, pero seguid haciéndolo. Me gusta más esta Lisa."
    kat "Je ne sais pas ce que vous lui donnez à manger, mais continuez. Je préfère cette Lisa-là."

# game/scripts/c13/c13.rpy:391
translate french c13s001_SleepingInTheCouch_3bf2b707:

    # mc "A mí también. Hoy llega la última chica. Saira, de India."
    mc "Moi aussi. Aujourd'hui arrive la dernière fille. Saira, d'Inde."

# game/scripts/c13/c13.rpy:393
translate french c13s001_SleepingInTheCouch_62533d58:

    # kat "¡Oh! ¿Una belleza exótica?"
    kat "Oh ! Une beauté exotique ?"

# game/scripts/c13/c13.rpy:394
translate french c13s001_SleepingInTheCouch_7e936e1f:

    # mc "Sí, lo es. Es una preciosidad. Nos conocemos de Portland."
    mc "Oui, c'est magnifique. Nous nous connaissons de Portland."

# game/scripts/c13/c13.rpy:395
translate french c13s001_SleepingInTheCouch_f08cc311:

    # kat "¿Otra ex-novia?"
    kat "Une autre ex-petite amie ?"

# game/scripts/c13/c13.rpy:396
translate french c13s001_SleepingInTheCouch_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Oui, pourquoi me posez-vous cette question ?"

# game/scripts/c13/c13.rpy:398
translate french c13s001_SleepingInTheCouch_1bfae0f9:

    # kat "Tienes a tu ex-novia del instituto durmiendo en tu habitación y vas a tener a tu ex-novia de la universidad durmiendo justo debajo."
    kat "Votre ex-petite amie du lycée dort dans votre chambre et votre ex-petite amie de la fac va dormir juste en dessous."

# game/scripts/c13/c13.rpy:399
translate french c13s001_SleepingInTheCouch_d3afcc31:

    # kat "¿Tú has oido la expresión \"Pelea de Gatas\"?"
    kat "Avez-vous déjà entendu l'expression « bagarre de filles » ?"

# game/scripts/c13/c13.rpy:400
translate french c13s001_SleepingInTheCouch_57a8f307:

    # mc "Ni Eileen ni Saira son así."
    mc "Ni Eileen ni Saira ne sont comme ça."

# game/scripts/c13/c13.rpy:402
translate french c13s001_SleepingInTheCouch_58666c43:

    # kat "¿Eileen? ¿Pelirroja? ¿Guapísima? ¿Ojos azules? ¿Compañera de trabajo de [eri]?"
    kat "Eileen ? Rousse ? Magnifique ? Yeux bleus ? La collègue de [eri] ?"

# game/scripts/c13/c13.rpy:403
translate french c13s001_SleepingInTheCouch_3f08eb51:

    # mc "Sí, ¿por qué?"
    mc "Oui, pourquoi ?"

# game/scripts/c13/c13.rpy:405
translate french c13s001_SleepingInTheCouch_39339162:

    # kat "¡Eres mi héroe! Si estando tan gordo como estabas en el instituto conseguiste que esa belleza se fijara en ti, hay esperanzas para el resto de nosotras."
    kat "Tu es mon héros ! Si tu as réussi à te faire remarquer par cette beauté alors que tu étais aussi gros que tu l'étais au lycée, il y a de l'espoir pour nous autres."

# game/scripts/c13/c13.rpy:412
translate french c13s001_SleepingInTheCouch_6bb56f62:

    # mc "Y no solo a cualquier chica. A cualquier persona. Eres divertida, inteligente, guapa..."
    mc "Et pas seulement à n'importe quelle fille. À tout le monde. Tu es drôle, intelligente, belle..."

# game/scripts/c13/c13.rpy:414
translate french c13s001_SleepingInTheCouch_f8619787:

    # kat "[mc], ¿me estás tirando los trastos? *Risa* Por si no lo recuerdas, no me interesan los hombres... desde hace mucho."
    kat "[mc], tu me dragues ? *Rires* Au cas où tu l'aurais oublié, je ne m'intéresse plus aux hommes... depuis longtemps."

# game/scripts/c13/c13.rpy:415
translate french c13s001_SleepingInTheCouch_0c9edb7a:

    # mc "{b}¿Qué? ¡No!{/b} * Risa* Eres de las pocas mujeres a quien le puedo decir que es guapa y que no se lo tomen como que quiero algo con ellas. No te estoy tirando los trastos, pero podría hacerlo."
    mc "{b}Quoi ? Non !{/b} *Rires* Tu es l'une des rares femmes que je trouve belles sans qu'elles pensent que je veux quelque chose avec elles. Je ne te drague pas, mais je pourrais."

# game/scripts/c13/c13.rpy:417
translate french c13s001_SleepingInTheCouch_216fab8c:

    # kat "¿A qué te refieres exactamente?"
    kat "Que voulez-vous dire exactement ?"

# game/scripts/c13/c13.rpy:418
translate french c13s001_SleepingInTheCouch_d5332a23:

    # mc "Me caes muy bien. Ya te he dicho que eres divertida, inteligente, guapa... podría seguir con que tienes un gran sentido del humor, que no te dejas avasallar, que no tienes complejos..."
    mc "Je t'aime beaucoup. Je t'ai déjà dit que tu es drôle, intelligente, belle… Je pourrais continuer à parler de ton humour, de ta force de caractère, de ton naturel…"

# game/scripts/c13/c13.rpy:420
translate french c13s001_SleepingInTheCouch_87ddd219:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je tenterais probablement ma chance. Je crois que je te plais aussi."

# game/scripts/c13/c13.rpy:422
translate french c13s001_SleepingInTheCouch_7b43f6fb:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je pourrais tenter ma chance. Je ne suis toujours pas sûr que je te plaise."

# game/scripts/c13/c13.rpy:424
translate french c13s001_SleepingInTheCouch_92bb93f5:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je pourrais peut-être tenter ma chance. Mais j'en doute fort. Je ne pense pas que je te plairais."

# game/scripts/c13/c13.rpy:427
translate french c13s001_SleepingInTheCouch_ac349b40:

    # mc "Estuve en el lugar correcto en el momento correcto. Dudo que alguien como yo era entonces pudiera conseguir a alguien como Eileen en circunstancias normales."
    mc "J'étais au bon endroit au bon moment. Je doute qu'à l'époque, quelqu'un comme moi aurait pu séduire une femme comme Eileen dans des circonstances normales."

# game/scripts/c13/c13.rpy:429
translate french c13s001_SleepingInTheCouch_f66b080e:

    # kat "Eso quiere decir que, según tú yo no podría conseguir estar con alguien como Kim o a alguien como tú si me interesaran los hombres, ¿no? Suerte que no me interesan... desde hace mucho."
    kat "Donc, si je comprends bien, je ne pourrais pas être avec quelqu'un comme Kim ou quelqu'un comme toi si j'étais attirée par les hommes, c'est bien ça ? Heureusement, ça fait longtemps que je ne le suis pas."

# game/scripts/c13/c13.rpy:430
translate french c13s001_SleepingInTheCouch_39c6d0f0:

    # mc "Dependería mucho de la otra persona."
    mc "Cela dépendrait beaucoup de l'autre personne."

# game/scripts/c13/c13.rpy:432
translate french c13s001_SleepingInTheCouch_216fab8c_1:

    # kat "¿A qué te refieres exactamente?"
    kat "Que voulez-vous dire exactement ?"

# game/scripts/c13/c13.rpy:433
translate french c13s001_SleepingInTheCouch_6beb8512:

    # mc "A mí me caes muy bien. Eres divertida, inteligente, guapa, tienes un gran sentido del humor, no te dejas avasallar, no tienes complejos..."
    mc "Je t'aime beaucoup. Tu es drôle, intelligente, belle, tu as un super sens de l'humour, tu ne te laisses pas intimider, tu n'as aucun complexe..."

# game/scripts/c13/c13.rpy:435
translate french c13s001_SleepingInTheCouch_87ddd219_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je tenterais probablement ma chance. Je crois que je te plais aussi."

# game/scripts/c13/c13.rpy:437
translate french c13s001_SleepingInTheCouch_7b43f6fb_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je pourrais tenter ma chance. Je ne suis toujours pas sûr que je te plaise."

# game/scripts/c13/c13.rpy:439
translate french c13s001_SleepingInTheCouch_92bb93f5_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Tu as une personnalité captivante, et si tu étais intéressée par les hommes, je pourrais peut-être tenter ma chance. Mais j'en doute fort. Je ne pense pas que je te plairais."

# game/scripts/c13/c13.rpy:440
translate french c13s001_SleepingInTheCouch_88e95bfb:

    # mc "Pero lo tendrías más difícil con personas a las que le interesara más el físico perfecto que la personalidad."
    mc "Mais vous auriez plus de mal avec les personnes qui s'intéressent davantage à un physique parfait qu'à la personnalité."

# game/scripts/c13/c13.rpy:443
translate french c13s001_SleepingInTheCouch_0f60830f:

    # kat "¡Wow! Eso me pasa por preguntar."
    kat "Eh bien ! Voilà ce qui arrive quand on demande ça."

# game/scripts/c13/c13.rpy:444
translate french c13s001_SleepingInTheCouch_62a18f55:

    # mc "Y ya que yo he respondido, ¿puedo hacer una pregunta?"
    mc "Et puisque j'ai répondu, puis-je poser une question ?"

# game/scripts/c13/c13.rpy:446
translate french c13s001_SleepingInTheCouch_73c1b90a:

    # kat "Sería justo que te dejara hacerla. No puedo asegurar que responda."
    kat "Il serait juste que je vous laisse faire. Je ne peux pas garantir que je répondrai."

# game/scripts/c13/c13.rpy:447
translate french c13s001_SleepingInTheCouch_501de8c1:

    # mc "¿Has dicho que no te interesan los hombres desde hace mucho?"
    mc "Avez-vous dit que vous ne vous intéressiez plus aux hommes depuis longtemps ?"

# game/scripts/c13/c13.rpy:449
translate french c13s001_SleepingInTheCouch_84745afb:

    # kat "*Risa* Uff, creía que sería una pregunta más complicada o comprometedora. Sí, lo he dicho."
    kat "*Rires* Ouf, je pensais que ce serait une question plus compliquée ou plus embarrassante. Oui, je l'ai dit."

# game/scripts/c13/c13.rpy:450
translate french c13s001_SleepingInTheCouch_3133bb2f:

    # mc "No me refería a eso, la pregunta sería ¿qué pasó para que dejaran de interesarte?"
    mc "Ce n'est pas ce que je voulais dire ; la question serait plutôt : que s'est-il passé qui vous a fait perdre tout intérêt ?"

# game/scripts/c13/c13.rpy:452
translate french c13s001_SleepingInTheCouch_2d87f6a7:

    # kat "*Risa* Eso sería una segunda pregunta."
    kat "*Rires* Ce serait une deuxième question."

# game/scripts/c13/c13.rpy:453
translate french c13s001_SleepingInTheCouch_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c13/c13.rpy:454
translate french c13s001_SleepingInTheCouch_f937556d:

    # kat "*Risa* No tengo la culpa de que no prestases atención a lo que decía y hayas gastado tu primera pregunta."
    kat "*Rires* Ce n'est pas ma faute si vous n'écoutiez pas ce que je disais et que vous avez gâché votre première question."

# game/scripts/c13/c13.rpy:455
translate french c13s001_SleepingInTheCouch_f52554b8:

    # mc "*Risa* Vale, me estás tomando el pelo, ya lo pillo."
    mc "*Rires* Bon, vous vous moquez de moi, j'ai compris maintenant."

# game/scripts/c13/c13.rpy:458
translate french c13s001_SleepingInTheCouch_4ec76d27:

    # kat "Por supuesto que te estoy tomando el pelo. Eres divertido y sabes encajarlo. *Risa*"
    kat "Bien sûr, je plaisante. Tu es drôle et tu sais en rire. *Rires*"

# game/scripts/c13/c13.rpy:459
translate french c13s001_SleepingInTheCouch_e2aeb02c:

    # mc "Entonces... ¿contestas la pregunta?"
    mc "Alors… vous répondez à la question ?"

# game/scripts/c13/c13.rpy:462
translate french c13s001_SleepingInTheCouch_35b64111:

    # kat "Es fácil. Solo he tenido una cita con un chico. Yo tenía 15 años y Isaac, el chico más popular de mi curso, me invitó a ir a cenar."
    kat "C'est simple. Je n'ai eu qu'un seul rendez-vous avec un garçon. J'avais 15 ans et Isaac, le garçon le plus populaire de ma classe, m'a invitée à dîner."

# game/scripts/c13/c13.rpy:463
translate french c13s001_SleepingInTheCouch_1d54b66e:

    # mc "Y algo salió mal."
    mc "Et quelque chose a mal tourné."

# game/scripts/c13/c13.rpy:465
translate french c13s001_SleepingInTheCouch_d17eafc6:

    # kat "Sí, que había una voz en off que no me dejaba explicarme. *Risa*"
    kat "Oui, il y avait une voix off qui m'empêchait d'expliquer. *Rires*"

# game/scripts/c13/c13.rpy:466
translate french c13s001_SleepingInTheCouch_a9f7b463:

    # mc "Vale, ya me callo. *Risa*"
    mc "Bon, je me tais maintenant. *Rires*"

# game/scripts/c13/c13.rpy:468
translate french c13s001_SleepingInTheCouch_46204cb0:

    # kat "Imagínate, la ballena del instituto saliendo con el chico más popular de mi clase. Era un sueño hecho realidad."
    kat "Imaginez, la baleine du lycée qui sort avec le garçon le plus populaire de ma classe. C'était un rêve devenu réalité."

# game/scripts/c13/c13.rpy:470
translate french c13s001_SleepingInTheCouch_52fe00cd:

    # kat "Y como te puedes imaginar, yo me emperifollé toda, pedí a mis padres que me compraran un vestido nuevo, llegué al lugar de la cita y allí estaba él, guapísimo."
    kat "Et comme vous pouvez l'imaginer, je me suis mise sur mon trente-et-un, j'ai demandé à mes parents de m'acheter une nouvelle robe, je suis arrivée au lieu de rendez-vous et il était là, magnifique."

# game/scripts/c13/c13.rpy:472
translate french c13s001_SleepingInTheCouch_324cce21:

    # kat "Rodeado de todos sus amigos y amigas... riéndose de mí. Algo sacado de una película mala de instituto donde todos los populares son gilipollas y se ríen de la perdedora."
    kat "Entouré de tous ses amis… qui se moquaient de moi. Une scène tout droit sortie d’un mauvais film pour ados où tous les populaires sont des crétins et se moquent du loser."

# game/scripts/c13/c13.rpy:473
translate french c13s001_SleepingInTheCouch_5672dac6:

    # mc "Lo siento, Kate."
    mc "Je suis désolée, Kate."

# game/scripts/c13/c13.rpy:475
translate french c13s001_SleepingInTheCouch_5297c865:

    # kat "Besó a una de las animadoras, tan solo para demostrar que podía besar a quien quisiera y que no lo iba a hacer conmigo."
    kat "Il a embrassé une des pom-pom girls, juste pour montrer qu'il pouvait embrasser qui il voulait et qu'il ne le ferait pas avec moi."

# game/scripts/c13/c13.rpy:476
translate french c13s001_SleepingInTheCouch_bc67a668:

    # mc "Ese crío era un capullo. Los hay en todos los institutos."
    mc "Ce gamin était un crétin. On en trouve dans toutes les écoles."

# game/scripts/c13/c13.rpy:478
translate french c13s001_SleepingInTheCouch_36762656:

    # kat "Pero como en todas las películas malas, la perdedora acabó ganando. Dos meses después estaba saliendo con esa misma animadora. Jennifer. Fue mi primera novia."
    kat "Mais comme dans tous les mauvais films, le plus faible a fini par gagner. Deux mois plus tard, je sortais avec cette même pom-pom girl. Jennifer. C'était ma première petite amie."

# game/scripts/c13/c13.rpy:479
translate french c13s001_SleepingInTheCouch_6605351c:

    # kat "Ella me enseñó que no necesitaba a un chico para ser feliz, para sentirme querida y especial."
    kat "Elle m'a appris que je n'avais pas besoin d'un garçon pour être heureuse, pour me sentir aimée et spéciale."

# game/scripts/c13/c13.rpy:480
translate french c13s001_SleepingInTheCouch_46a729b1:

    # mc "¿Cómo se lo tomó aquel chico?"
    mc "Comment ce garçon a-t-il réagi ?"

# game/scripts/c13/c13.rpy:482
translate french c13s001_SleepingInTheCouch_318df991:

    # kat "No le dió importancia hasta que Jennifer colgó una foto en InstaPic de nosotras dos besándonos."
    kat "Je n'y ai pas prêté beaucoup d'attention jusqu'à ce que Jennifer poste une photo sur InstaPic où l'on nous voit nous embrasser."

# game/scripts/c13/c13.rpy:483
translate french c13s001_SleepingInTheCouch_1158143d:

    # kat "El texto decía \"Me ha costado dos meses quitarme el mal sabor de boca de un beso horrible de Isaac. Besa tan mal que me ha vuelto lesbiana.\" Como te puedes imaginar, ella siempre lo había sido."
    kat "Le texte disait : « Il m’a fallu deux mois pour me débarrasser du mauvais goût que j’avais dans la bouche après un horrible baiser avec Isaac. Il embrasse si mal qu’il m’a transformée en lesbienne. » Comme vous pouvez l’imaginer, elle l’avait toujours été."

# game/scripts/c13/c13.rpy:484
translate french c13s001_SleepingInTheCouch_7aad78cf:

    # mc "¡Bien por Jennifer!"
    mc "Bravo à Jennifer !"

# game/scripts/c13/c13.rpy:486
translate french c13s001_SleepingInTheCouch_4800ba71:

    # kat "Y esa es la historia de por qué solo salgo con chicas. Sigo apreciando el aspecto de un chico guapo, pero no voy a dejar que me hagan daño otra vez."
    kat "Voilà pourquoi je ne sors qu'avec des filles. J'apprécie toujours le charme des beaux garçons, mais je ne veux plus souffrir."

# game/scripts/c13/c13.rpy:487
translate french c13s001_SleepingInTheCouch_e3841a2a:

    # kat "Pero que un chico como tú se planteara tirarme los trastos... me sorprende."
    kat "Mais qu'un type comme toi envisage même de me draguer... je suis surprise."

# game/scripts/c13/c13.rpy:488
translate french c13s001_SleepingInTheCouch_f28d45d9:

    # mc "¿Un chico como yo? Kate, ¿me estás tirando los trastos? *Risa*"
    mc "Un type comme moi ? Kate, tu me dragues ? *Rires*"

# game/scripts/c13/c13.rpy:490
translate french c13s001_SleepingInTheCouch_a31dfe94:

    # kat "*Risa* No solo es guapo y sabe encajar las bromas, también sabe devolverlas."
    kat "*Rires* Non seulement il est beau et sait prendre les blagues avec humour, mais il sait aussi en rendre."

# game/scripts/c13/c13.rpy:491
translate french c13s001_SleepingInTheCouch_e5f90eb8:

    # mc "¿Dónde estaría lo divertido si sólo recibiera uno?"
    mc "Où serait le plaisir si je n'en recevais qu'un seul ?"

# game/scripts/c13/c13.rpy:493
translate french c13s001_SleepingInTheCouch_4ae2fa75:

    # "Justo en ese momento escuchas pasos en la escalera."
    "C’est alors que vous entendez des pas dans l’escalier."

# game/scripts/c13/c13.rpy:495
translate french c13s001_SleepingInTheCouch_ad0c015f:

    # mom "¿Qué hacéis aquí tan temprano? ¿Le has pillado el gusto a dormir en el sofá, [mc]? *Risa* ¿Hoy has cambiado a Lisa por Kate?"
    mom "Que fais-tu ici si tôt ? Tu as pris goût à dormir sur le canapé, [mc] ? *Rires* Tu as échangé Lisa contre Kate aujourd'hui ?"

# game/scripts/c13/c13.rpy:496
translate french c13s001_SleepingInTheCouch_57eee0fd:

    # mc "¿Cómo sabes tú eso?"
    mc "Comment le sais-tu ?"

# game/scripts/c13/c13.rpy:498
translate french c13s001_SleepingInTheCouch_22add2b2:

    # kat "Ayer Lisa lo comentó varias veces. Por lo visto hablar contigo le ayudó mucho... en algo."
    kat "Lisa l'a mentionné plusieurs fois hier. Apparemment, parler avec toi l'a beaucoup aidée... d'une certaine manière."

# game/scripts/c13/c13.rpy:499
translate french c13s001_SleepingInTheCouch_790fd913:

    # mc "Ah, vale."
    mc "Ah, d'accord."

# game/scripts/c13/c13.rpy:501
translate french c13s001_SleepingInTheCouch_e6a7f6fd:

    # kat "Pero no te preocupes, [mar]. Esta vez lo he encontrado yo durmiendo en el sofá."
    kat "Mais ne t'inquiète pas, [mar]. Cette fois, je l'ai trouvé endormi sur le canapé."

# game/scripts/c13/c13.rpy:503
translate french c13s001_SleepingInTheCouch_c770cb25:

    # mom "¿Ha pasado algo en tu habitación?"
    mom "Il s'est passé quelque chose dans votre chambre ?"

# game/scripts/c13/c13.rpy:504
translate french c13s001_SleepingInTheCouch_710fb6f5:

    # mc "Algo. Tenemos que hablar."
    mc "Quelque chose. Il faut qu'on parle."

# game/scripts/c13/c13.rpy:506
translate french c13s001_SleepingInTheCouch_09809368:

    # kat "Yo voy a darme una ducha. Os dejo hablar tranquilos."
    kat "Je vais prendre une douche. Je vous laisse discuter seuls."

# game/scripts/c13/c13.rpy:507
translate french c13s001_SleepingInTheCouch_f090d085:

    # mc "Nosotros vamos a bajar a la sala de abajo, es el sitio más alejado de cualquier habitación."
    mc "Nous allons descendre dans la pièce du dessous ; c'est l'endroit le plus éloigné de toutes les autres pièces."

# game/scripts/c13/c13.rpy:540
translate french c13s002_TalkToTheFamily_5d815bcc:

    # mom "¿Qué ha pasado?"
    mom "Ce qui s'est passé?"

# game/scripts/c13/c13.rpy:543
translate french c13s002_TalkToTheFamily_7e70543d:

    # mc "Ahora te lo explico, pero antes quiero un beso."
    mc "Je vais te l'expliquer maintenant, mais d'abord je veux un baiser."

# game/scripts/c13/c13.rpy:545
translate french c13s002_TalkToTheFamily_ef8d8600:

    # mom "Mmmmm... subía a ver si estabas despierto para besarte antes de que todo el mundo se despertara. Verte con Kate ha hecho que me despiste."
    mom "Mmm… Je suis monté voir si tu étais réveillé pour pouvoir t’embrasser avant que tout le monde ne se lève. Te voir avec Kate m’a fait perdre le fil."

# game/scripts/c13/c13.rpy:546
translate french c13s002_TalkToTheFamily_e45119d0:

    # mc "Problema resuelto. *Risa* Sobre lo que ha pasado..."
    mc "Problème résolu. *Rires* À propos de ce qui s'est passé..."

# game/scripts/c13/c13.rpy:547
translate french c13s002_TalkToTheFamily_f3c32356:

    # mc "Eileen y su madre están durmiendo en mi habitación"
    mc "Eileen et sa mère dorment dans ma chambre."

# game/scripts/c13/c13.rpy:549
translate french c13s002_TalkToTheFamily_efa5675d:

    # mom "{b}¿Qué?{/b} ¿Por qué?"
    mom "{b}Quoi ?{/b}Pourquoi ?"

# game/scripts/c13/c13.rpy:551
translate french c13s002_TalkToTheFamily_587cf335:

    # mom "Tu y ellas..."
    mom "Vous et eux..."

# game/scripts/c13/c13.rpy:552
translate french c13s002_TalkToTheFamily_45958c14:

    # mc "No, no es eso, no te preocupes."
    mc "Non, ce n'est pas ça, ne t'inquiète pas."

# game/scripts/c13/c13.rpy:553
translate french c13s002_TalkToTheFamily_8b27aefd:

    # mc "Solomon se puso violento ayer con Kiara."
    mc "Solomon s'est emporté contre Kiara hier."

# game/scripts/c13/c13.rpy:555
translate french c13s002_TalkToTheFamily_fa919086:

    # mom "{b}¿Qué?{/b} ¿Kiara está bien?"
    mom "{b}Quoi ?{/b} Kiara va bien ?"

# game/scripts/c13/c13.rpy:556
translate french c13s002_TalkToTheFamily_f36f5c8c:

    # mc "Tiene un hematoma gigante en el antebrazo. Por el resto parece estar bien... físicamente."
    mc "Il a un énorme bleu sur l'avant-bras. Sinon, il semble aller bien… physiquement."

# game/scripts/c13/c13.rpy:557
translate french c13s002_TalkToTheFamily_ee742ba8:

    # mc "Cuando se despierte quiero llevarla al hospital a que vea a Samantha."
    mc "Quand elle se réveillera, je veux l'emmener à l'hôpital voir Samantha."

# game/scripts/c13/c13.rpy:559
translate french c13s002_TalkToTheFamily_d4314175:

    # mom "Sí, es lo mejor. Así tendrá un informe para presentar a la policía."
    mom "Oui, c'est mieux ainsi. Vous aurez ainsi un rapport à remettre à la police."

# game/scripts/c13/c13.rpy:560
translate french c13s002_TalkToTheFamily_71334393:

    # mc "No quiere presentar denuncia. Ni siquiera quiere ir al hospital."
    mc "Elle ne veut pas porter plainte. Elle ne veut même pas aller à l'hôpital."

# game/scripts/c13/c13.rpy:561
translate french c13s002_TalkToTheFamily_66e101df:

    # mc "Quería volver a casa mañana... la he convencido para que pase unos días en casa. Todavía hay una habitación libre en casa de [nor]. No sé si me he tomado muchas libertades..."
    mc "Elle voulait rentrer demain… Je l’ai convaincue de rester quelques jours. Il reste une chambre chez [nor]. Je ne sais pas si j’ai abusé de ma gentillesse…"

# game/scripts/c13/c13.rpy:563
translate french c13s002_TalkToTheFamily_6e36c916:

    # mom "No, para nada. Si alguien tiene problemas, debemos que ayudarlo. Tenemos una habitación libre hasta que lleguen las otras estudiantes, no creo que haya mejor forma de usarla."
    mom "Non, pas du tout. Si quelqu'un a des problèmes, nous devons l'aider. Nous avons une chambre libre en attendant l'arrivée des autres étudiants ; je ne vois pas de meilleure façon de l'utiliser."

# game/scripts/c13/c13.rpy:564
translate french c13s002_TalkToTheFamily_34e25155:

    # mc "De todas formas creo que debería haberlo consultado con [nor], pero era pasada la medianoche cuando hemos llegado a casa."
    mc "Bref, je pense que j'aurais dû vérifier avec [nor], mais il était passé minuit quand nous sommes rentrés à la maison."

# game/scripts/c13/c13.rpy:566
translate french c13s002_TalkToTheFamily_a871a070:

    # mom "Llámala y dile que venga. Ya debe estar despierta. Yo no he bajado el móvil."
    mom "Appelle-la et dis-lui de venir. Elle doit être réveillée maintenant. Je n'ai pas rangé mon téléphone."

# game/scripts/c13/c13.rpy:567
translate french c13s002_TalkToTheFamily_62d7ae47:

    # mc "OK, dáme un segundo."
    mc "OK, donnez-moi une seconde."

# game/scripts/c13/c13.rpy:569
translate french c13s002_TalkToTheFamily_33abc69f:

    # "Unos minutos después, una vez habéis puesto a [nor] al corriente..."
    "Quelques minutes plus tard, une fois que vous aurez rempli [nor]..."

# game/scripts/c13/c13.rpy:571
translate french c13s002_TalkToTheFamily_b86cc6bb:

    # mc "Espero no haberme extralimitado diciéndoles que se pueden quedar una semana en tu casa."
    mc "J'espère ne pas avoir dépassé les bornes en leur proposant de rester chez vous une semaine."

# game/scripts/c13/c13.rpy:572
translate french c13s002_TalkToTheFamily_7069f4cf:

    # nor "¿Una semana? ¡Se pueden quedar todo el tiempo que quieran! Mientras no lleguen las estudiantes en otoño, esa habitación es suya si la quieren."
    nor "Une semaine ? Ils peuvent rester aussi longtemps qu'ils le souhaitent ! Tant que les étudiants n'arrivent pas à l'automne, cette chambre leur est réservée s'ils la désirent."

# game/scripts/c13/c13.rpy:573
translate french c13s002_TalkToTheFamily_cbf508e3:

    # mc "Gracias, [nor]. Entre Meemaw, Tía Betty, y ahora Kiara y Eileen, casi es como si tuvieras a las estudiantes."
    mc "Merci, [nor]. Entre Meemaw, tante Betty, et maintenant Kiara et Eileen, c'est presque comme si vous aviez les élèves."

# game/scripts/c13/c13.rpy:575
translate french c13s002_TalkToTheFamily_98dcd74f:

    # nor "Me servirá de entrenamiento. *Risa* Scarlett se queda a dormir la mitad de los días. Cuando coincidan todas tendré cinco huespedes."
    nor "Ce sera un bon entraînement. *Rires* Scarlett reste plus de la moitié du temps. Quand ils seront tous là, j'aurai cinq invités."

# game/scripts/c13/c13.rpy:577
translate french c13s002_TalkToTheFamily_14d1dee3:

    # mom "A mí me llega hoy la quinta. Por cierto, [mc], tienes que ir a buscarla al aeropuerto. Llega a las 2 PM."
    mom "Mon cinquième colis arrive aujourd'hui. Au fait, [mc], tu dois le récupérer à l'aéroport. Il arrive à 14h."

# game/scripts/c13/c13.rpy:578
translate french c13s002_TalkToTheFamily_f443373a:

    # mc "Sí, lo sé. Me lo dijo [nor] ayer. Parece que iba a ser una sorpresa para mí..."
    mc "Oui, je sais. Il me l'a dit hier. Apparemment, ça devait être une surprise pour moi…"

# game/scripts/c13/c13.rpy:580
translate french c13s002_TalkToTheFamily_60d7c644:

    # mom "¿Sorpresa? ¿Qué sorpresa?"
    mom "Surprise ? Quelle surprise ?"

# game/scripts/c13/c13.rpy:581
translate french c13s002_TalkToTheFamily_970f2e18:

    # mc "¿Te acuerdas de la chica India con la que salía en Portland? Estoy 99%% seguro de que es ella."
    mc "Tu te souviens de la fille indienne avec qui je sortais à Portland ? Je suis sûr à 99%% que c’est elle."

# game/scripts/c13/c13.rpy:596
translate french c13s002_TalkToTheFamily_0dcdc47b:

    # mom "¿Te ha seguido desde Portland? ¿Sin decírtelo?"
    mom "Vous suivait-il depuis Portland ? Sans vous le dire ?"

# game/scripts/c13/c13.rpy:597
translate french c13s002_TalkToTheFamily_8a456377:

    # nor "Super romántico, ¿verdad? Estoy segura de que quiere volver con él."
    nor "C'est tellement romantique, n'est-ce pas ? Je suis sûre qu'elle veut se remettre avec lui."

# game/scripts/c13/c13.rpy:598
translate french c13s002_TalkToTheFamily_75baeb1e:

    # mc "No estoy seguro, pero si no fuera así ¿por qué el secretismo? ¿Por qué se ha transferido a Newport?"
    mc "Je ne suis pas sûr, mais si ce n'était pas le cas, pourquoi ce secret ? Pourquoi a-t-il été transféré à Newport ?"

# game/scripts/c13/c13.rpy:600
translate french c13s002_TalkToTheFamily_f215b9b6:

    # mom "¿Tú quieres volver con ella?"
    mom "Tu veux te remettre avec elle ?"

# game/scripts/c13/c13.rpy:602
translate french c13s002_TalkToTheFamily_61e910c3:

    # mc "Mi situación es diferente de cuando estaba en Portland. Tengo que hablar con ella."
    mc "Ma situation est différente de celle que j'avais à Portland. Il faut que je lui parle."

# game/scripts/c13/c13.rpy:604
translate french c13s002_TalkToTheFamily_bb05ad6e:

    # mc "Hay muchas cosas que hacer en casa y no tengo demasiado tiempo para empezar o reanudar una relación. Tengo que hablar con ella."
    mc "J'ai beaucoup à faire à la maison et je n'ai pas beaucoup de temps pour entamer ou raviver une relation. Il faut que je lui parle."

# game/scripts/c13/c13.rpy:605
translate french c13s002_TalkToTheFamily_24b973a2:

    # mc "Pero volviendo al tema del día. Deberiais hablar con Eileen y Kiara. Les dije que os comentaría lo de la habitación y..."
    mc "Pour en revenir au sujet du jour, tu devrais parler à Eileen et Kiara. Je leur ai dit que je te tiendrais au courant pour la chambre et…"

# game/scripts/c13/c13.rpy:607
translate french c13s002_TalkToTheFamily_e020d34a:

    # nor "No hay nada que comentar. La habitación es suya por el tiempo que quieran."
    nor "Il n'y a rien à ajouter. La chambre est à vous aussi longtemps que vous le souhaitez."

# game/scripts/c13/c13.rpy:608
translate french c13s002_TalkToTheFamily_495fef7c:

    # mc "Pero eso se les debería decir a ellas, no a mí. Yo ya sabía que no las íbamos a dejar en la estacada."
    mc "Mais c'est à vous de leur dire, pas à moi. Je savais déjà qu'on ne les laisserait pas tomber."

# game/scripts/c13/c13.rpy:610
translate french c13s002_TalkToTheFamily_cc8a4499:

    # nor "¿Están despiertas?"
    nor "Sont-ils réveillés ?"

# game/scripts/c13/c13.rpy:611
translate french c13s002_TalkToTheFamily_d74bb287:

    # mc "No lo sé, se acostaron tarde... Yo debería entrar para coger ropa y vestirme."
    mc "Je ne sais pas, ils se sont couchés tard… Je devrais rentrer prendre des vêtements et m’habiller."

# game/scripts/c13/c13.rpy:612
translate french c13s002_TalkToTheFamily_942c2998:

    # nor "Probemos entonces..."
    nor "Essayons alors..."

# game/scripts/c13/c13.rpy:615
translate french c13s002_TalkToTheFamily_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c13/c13.rpy:616
translate french c13s002_TalkToTheFamily_25c2df4d:

    # mc "Soy yo."
    mc "C'est moi."

# game/scripts/c13/c13.rpy:617
translate french c13s002_TalkToTheFamily_27e3a2b0:

    # kia "Entra, [mc]."
    kia "Entrez, [mc]."

# game/scripts/c13/c13.rpy:619
translate french c13s002_TalkToTheFamily_699dfc7a:

    # mc "Buenos días, Kiara. ¿Habéis dormido bien?"
    mc "Bonjour Kiara. As-tu bien dormi ?"

# game/scripts/c13/c13.rpy:620
translate french c13s002_TalkToTheFamily_aaa33533:

    # kia "Sí, hemos dormido genial. Hacía tiempo que Eile y yo no compartíamos cama. Gracias por dejarnos tu habitación."
    kia "Oui, nous avons très bien dormi. Cela faisait longtemps qu'Eile et moi n'avions pas partagé un lit. Merci de nous avoir prêté votre chambre."

# game/scripts/c13/c13.rpy:622
translate french c13s002_TalkToTheFamily_03e1bae3:

    # mc "No se si recuerdas a mi madre y a mi tía."
    mc "Je ne sais pas si vous vous souvenez de ma mère et de ma tante."

# game/scripts/c13/c13.rpy:623
translate french c13s002_TalkToTheFamily_38d0cbc6:

    # mom "Bienvenida a casa, Kiara. ¿Donde está Eileen? Hace siglos que no la veo. Siento mucho lo que te ha pasado. Lo que os ha pasado a las dos."
    mom "Bienvenue à la maison, Kiara. Où est Eileen ? Je ne l'ai pas vue depuis une éternité. Je suis vraiment désolée pour ce qui vous est arrivé. Ce qui vous est arrivé à toutes les deux."

# game/scripts/c13/c13.rpy:624
translate french c13s002_TalkToTheFamily_84aeac3b:

    # nor "Hoy moveremos vuestras cosas a una habitación en mi casa, así [mc] puede recuperar la suya. Estaréis más cómodas allí, hay dos camas. Sentimos no poderos ofrecer más."
    nor "Aujourd'hui, nous allons déplacer tes affaires dans une chambre de ma maison pour que [mc] puisse récupérer les siennes. Tu y seras plus à l'aise ; il y a deux lits. Nous sommes désolés de ne pouvoir t'offrir plus."

# game/scripts/c13/c13.rpy:626
translate french c13s002_TalkToTheFamily_6265f88a:

    # kia "Gracias por acogernos, [mar] y [nor]. O lo que queda de ti, [nor]. Creo que si te viera por la calle no te reconocería. Nos conformamos con poco, solo serán unos días. No queremos molestar."
    kia "Merci de nous accueillir, [mar] et [nor]. Enfin, ce qu'il en reste, [nor]. Je ne crois pas que je vous reconnaîtrais dans la rue. Nous n'avons pas besoin de grand-chose ; ce ne sera que quelques jours. Nous ne voulons pas vous déranger."

# game/scripts/c13/c13.rpy:627
translate french c13s002_TalkToTheFamily_add25c43:

    # kia "Eileen está en la ducha. Hoy empieza pronto en el trabajo y no cogió su bici. Tendrá que coger el autobús."
    kia "Eileen est sous la douche. Elle commence à travailler tôt aujourd'hui et n'a pas pris son vélo. Elle devra prendre le bus."

# game/scripts/c13/c13.rpy:628
translate french c13s002_TalkToTheFamily_063f51fb:

    # mc "No te preocupes por eso. El café está de camino al hospital y la puedo llevar yo."
    mc "Ne vous en faites pas. Le café est en route pour l'hôpital, et je peux l'apporter moi-même."

# game/scripts/c13/c13.rpy:630
translate french c13s002_TalkToTheFamily_0033c727:

    # kia "[mc], ya hablamos de eso anoche. No es necesario ir al hospital."
    kia "[mc], on en a déjà parlé hier soir. Pas besoin d'aller à l'hôpital."

# game/scripts/c13/c13.rpy:631
translate french c13s002_TalkToTheFamily_603a3173:

    # mc "No es necesario, pero sí recomendable. ¿Tienes algo mejor que hacer esta mañana? ¿A qué hora entras a trabajar?"
    mc "Ce n'est pas indispensable, mais c'est conseillé. Avez-vous quelque chose de mieux à faire ce matin ? À quelle heure commencez-vous à travailler ?"

# game/scripts/c13/c13.rpy:633
translate french c13s002_TalkToTheFamily_8db5c596:

    # kia "A la 1 PM. Voy a tener que mover nuestras cosas a la nueva habitación..."
    kia "À 13h, je vais devoir déménager nos affaires dans la nouvelle chambre..."

# game/scripts/c13/c13.rpy:634
translate french c13s002_TalkToTheFamily_44c676ad:

    # mc "Las cosas son una bolsa de viaje tan solo, Kiara. La puedo llevar yo en cuanto Eileen salga de la ducha."
    mc "Ce n'est qu'un sac de voyage, Kiara. Je peux le prendre dès qu'Eileen aura fini avec la douche."

# game/scripts/c13/c13.rpy:635
translate french c13s002_TalkToTheFamily_dcf18cd2:

    # mc "A las 10 AM tengo que estar en un sitio, a las 2 PM tengo que estar en el aeropuerto, tu trabajo me pilla de camino entre el hospital y el aeropuerto."
    mc "À 10 h, je dois être quelque part ; à 14 h, je dois être à l'aéroport ; votre poste se situe sur mon trajet entre l'hôpital et l'aéroport."

# game/scripts/c13/c13.rpy:636
translate french c13s002_TalkToTheFamily_5d6577a8:

    # mc "Dejamos a Eileen en el café, vamos al hospital, me acompañas a lo que tengo que hacer a las 10, y te llevo al trabajo. Si tenemos tiempo, te invito a comer."
    mc "On déposera Eileen au café, puis on ira à l'hôpital. Tu pourras m'accompagner à mon rendez-vous à 10 h, et ensuite je t'emmènerai au travail. Si on a le temps, je t'inviterai à déjeuner."

# game/scripts/c13/c13.rpy:638
translate french c13s002_TalkToTheFamily_1778adbb:

    # mom "[mc] me ha dicho lo que ha pasado. Samantha Washington es una amiga, no va a hacer nada que tu no quieras hacer."
    mom "Elle m'a raconté ce qui s'est passé. Samantha Washington est une amie ; elle ne fera rien contre votre gré."

# game/scripts/c13/c13.rpy:639
translate french c13s002_TalkToTheFamily_e75bcff9:

    # mom "Si no quieres presentar la denuncia, no te va a obligar."
    mom "Si vous ne souhaitez pas porter plainte, ils ne vont pas vous y obliger."

# game/scripts/c13/c13.rpy:641
translate french c13s002_TalkToTheFamily_ca34ffb5:

    # kia "¿Samantha Washington? ¿La madre del chico en... del chico que estudiaba en el mismo curso que Eileen y [mc]?"
    kia "Samantha Washington ? La mère du garçon… du garçon qui était dans la même classe qu’Eileen et [mc] ?"

# game/scripts/c13/c13.rpy:642
translate french c13s002_TalkToTheFamily_5ce8450e:

    # mc "Sí, la madre de Jamaal."
    mc "Oui, la mère de Jamaal."

# game/scripts/c13/c13.rpy:643
translate french c13s002_TalkToTheFamily_034bdae1:

    # kia "Sí, eso, Jamaal. No he hablado más que un par de veces con ella..."
    kia "Oui, c'est ça, Jamaal. Je ne lui ai parlé que deux ou trois fois..."

# game/scripts/c13/c13.rpy:645
translate french c13s002_TalkToTheFamily_e364c13f:

    # nor "Pero es amiga de la familia. Y tú también. Si [mc] le pide algo..."
    nor "Mais c'est une amie de la famille. Et vous aussi. Si [mc] lui demande quelque chose..."

# game/scripts/c13/c13.rpy:646
translate french c13s002_TalkToTheFamily_8ba27ce0:

    # mc "Entonces decidido, voy a ducharme y nos vamos cuando queráis."
    mc "C'est donc décidé, je vais prendre une douche et nous partirons quand vous voudrez."

# game/scripts/c13/c13.rpy:648
translate french c13s002_TalkToTheFamily_4c813a90:

    # eil "¿[nor]? ¡Estás fantástica!"
    eil "[nor]? Tu es magnifique !"

# game/scripts/c13/c13.rpy:649
translate french c13s002_TalkToTheFamily_ba74b1db:

    # eil "Tu también, [mar]."
    eil "Toi aussi, [mar]."

# game/scripts/c13/c13.rpy:651
translate french c13s002_TalkToTheFamily_6423aeba:

    # mom "Bienvenida a casa, Eileen. Sabía que tarde o temprano te mudarías aquí, pero esperaba que fuera en otras circunstancias."
    mom "Bienvenue chez toi, Eileen. Je savais que tu finirais par déménager ici, mais j'espérais que ce serait dans des circonstances différentes."

# game/scripts/c13/c13.rpy:652
translate french c13s002_TalkToTheFamily_5b7e94be:

    # eil "Gracias, [mar]. Yo también lo esperaba."
    eil "Merci, [mar]. Je m'y attendais aussi."

# game/scripts/c13/c13.rpy:654
translate french c13s002_TalkToTheFamily_b68411ed:

    # eil "Me parece increíble que haya pasado tanto tiempo sin veros. Tienes que entrar en el café cuando traigas a [eri] y lucir ese tipito."
    eil "Je n'arrive pas à croire que ça fait si longtemps que je ne t'ai pas vu. Il faut absolument que tu viennes au café quand tu amènes [eri] et que tu nous montres ta silhouette."

# game/scripts/c13/c13.rpy:655
translate french c13s002_TalkToTheFamily_ba290689:

    # eil "¡Estás increíble! Me tienes que decir como has perdido tanto peso. No me iría mal a mí también."
    eil "Tu es magnifique ! Il faut absolument que tu me dises comment tu as fait pour perdre autant de poids. J'aurais bien besoin d'un petit coup de pouce aussi."

# game/scripts/c13/c13.rpy:656
translate french c13s002_TalkToTheFamily_e4c672a7:

    # nor "Gracias, Eileen, pero tú no lo necesitas, a menos que quieras disfrazarte de esqueleto en Halloween. *Risa*"
    nor "Merci Eileen, mais tu n'en as pas besoin, à moins que tu veuilles te déguiser en squelette pour Halloween. *Rires*"

# game/scripts/c13/c13.rpy:658
translate french c13s002_TalkToTheFamily_556e6162:

    # mom "Entonces, ¿vamos a desayunar mientras [mc] se ducha? Parece que va a tener un día ocupado"
    mom "Alors, on déjeune pendant que [mc] prend sa douche ? On dirait qu'elle va avoir une journée chargée."

# game/scripts/c13/c13.rpy:659
translate french c13s002_TalkToTheFamily_dcc24a9d:

    # mc "A mí también me gustaría desayunar..."
    mc "Je voudrais aussi prendre le petit-déjeuner..."

# game/scripts/c13/c13.rpy:661
translate french c13s002_TalkToTheFamily_ca074c8d:

    # nor "No te preocupes, te dejaremos algo para que desayunes. Ve a ducharte, ya llevaré yo la bolsa de Kiara y Eileen a casa."
    nor "Ne t'inquiète pas, on te laisse de quoi déjeuner. Va prendre une douche ; je ramène le sac de Kiara et Eileen."

# game/scripts/c13/c13.rpy:663
translate french c13s002_TalkToTheFamily_b2a78d67:

    # nor "Si necesitáis algo de ropa, no dudéis en pedírnoslo a nosotras o a cualquiera de las chicas."
    nor "Si vous avez besoin de vêtements, n'hésitez pas à nous demander ou à demander à l'une des filles."

# game/scripts/c13/c13.rpy:665
translate french c13s002_TalkToTheFamily_9687e0a2:

    # kia "No te preocupes, podemos aguantar dos o tres días con lo que hemos traído. El jueves mi hija quiere ir a casa a coger más ropa."
    kia "Ne t'inquiète pas, on peut se débrouiller deux ou trois jours avec ce qu'on a apporté. Ma fille veut rentrer jeudi pour prendre d'autres vêtements."

# game/scripts/c13/c13.rpy:666
translate french c13s002_TalkToTheFamily_1f1380fa:

    # mc "El jueves por la noche no estará Solomon. Y esperamos poder llevar a Alexia... a la Agente Martínez por si se tuercen los planes."
    mc "Solomon ne sera pas là jeudi soir. Et nous espérons amener Alexia… à l’agent Martinez au cas où les choses tourneraient mal."

# game/scripts/c13/c13.rpy:668
translate french c13s002_TalkToTheFamily_00d473fe:

    # mom "Ve a ducharte o llegaréis tarde. Nosotras vamos a seguir charlando en la cocina mientras preparamos el desayuno."
    mom "Va prendre une douche, sinon tu vas être en retard. On va continuer à papoter dans la cuisine pendant qu'on prépare le petit-déjeuner."

# game/scripts/c13/c13.rpy:670
translate french c13s002_TalkToTheFamily_98b2ba8e:

    # mc "OK, os veo en la cocina."
    mc "OK, on se voit dans la cuisine."

# game/scripts/c13/c13.rpy:681
translate french c13s002_TheHospital_342c3ec7:

    # "Después de desayunar, llevas a Eileen al café y vas al hospital. Aparcas en la zona de visitantes."
    "Après le petit-déjeuner, vous emmenez Eileen au café puis vous vous rendez à l'hôpital. Vous vous garez sur le parking visiteurs."

# game/scripts/c13/c13.rpy:684
translate french c13s002_TheHospital_d3f5ff6a:

    # kia "[mc], de verdad que esto no es necesario. Tan solo es un hematoma."
    kia "[mc], ce n'est vraiment pas nécessaire. Ce n'est qu'un bleu."

# game/scripts/c13/c13.rpy:685
translate french c13s002_TheHospital_f29c0ae1:

    # mc "No hace mucho que yo tuve unos hematomas y me dijeron que podían ser peligrosos si no se trataban correctamente."
    mc "J'ai récemment eu des contusions et on m'a dit qu'elles pouvaient être dangereuses si elles n'étaient pas soignées correctement."

# game/scripts/c13/c13.rpy:686
translate french c13s002_TheHospital_02ce349c:

    # mc "No nos podemos arriesgar a que te pase nada, ¿verdad?"
    mc "Nous ne pouvons pas prendre le risque qu'il vous arrive quoi que ce soit, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:688
translate french c13s002_TheHospital_184d888d:

    # kia "Te conozco desde que tenías 15 años. Casi no reconozco a aquel chico tímido en este hombre que tengo ahora delante."
    kia "Je te connais depuis que tu as 15 ans. J'ai du mal à reconnaître ce garçon timide dans l'homme qui se tient devant moi maintenant."

# game/scripts/c13/c13.rpy:689
translate french c13s002_TheHospital_8d3cff4b:

    # mc "Kiara, sigo siendo yo. Tan solo he crecido y he adelgazado."
    mc "Kiara, je suis toujours moi. J'ai juste grandi et perdu du poids."

# game/scripts/c13/c13.rpy:691
translate french c13s002_TheHospital_0c59923f:

    # kia "No me refiero a eso, [mc]. No quiero que te ofendas, pero al principio de salir con mi Eile me parecías un pusilánime."
    kia "Je ne fais pas référence à cela, [mc]. Je ne veux pas vous offenser, mais au début de ma relation avec Eile, je pensais que vous étiez un lâche."

# game/scripts/c13/c13.rpy:692
translate french c13s002_TheHospital_34cf5b5c:

    # kia "No sé dónde tenías escondido a este hombre que toma las riendas de las situaciones."
    kia "Je ne sais pas où vous aviez caché cet homme capable de prendre les choses en main."

# game/scripts/c13/c13.rpy:693
translate french c13s002_TheHospital_176ea40b:

    # mc "Creo que me lo había comido. *Risa*"
    mc "Je crois que je l'ai mangé. *Rires*"

# game/scripts/c13/c13.rpy:695
translate french c13s002_TheHospital_fe4e84d0:

    # kia "*Risa* Eso no lo has perdido. Me sigues haciendo reír."
    kia "*Rires* Tu n'as rien perdu de ça. Tu me fais toujours rire."

# game/scripts/c13/c13.rpy:696
translate french c13s002_TheHospital_7682a1e6:

    # mc "¿Te parecía tan malo como dices?"
    mc "Vous pensiez que c'était aussi grave que vous le dites ?"

# game/scripts/c13/c13.rpy:698
translate french c13s002_TheHospital_61516d06:

    # kia "Al principio sí. No me gustabas, pero la hacías feliz y por eso nunca me opuse a vuestra relación. Nunca le dije nada a ella."
    kia "Au début, oui. Je ne t'aimais pas, mais tu la rendais heureuse, et c'est pour ça que je n'ai jamais objecté à votre relation. Je ne lui ai jamais rien dit."

# game/scripts/c13/c13.rpy:699
translate french c13s002_TheHospital_47c4bba0:

    # mc "Gracias. ¿Y después?"
    mc "Merci. Et ensuite ?"

# game/scripts/c13/c13.rpy:701
translate french c13s002_TheHospital_67377fac:

    # kia "Después evolucionasteis los dos. Ella dejó de querer ser el centro de atención. Maduró gracias a ti."
    kia "Puis vous avez tous les deux évolué. Elle a cessé de vouloir être le centre de l'attention. Elle a mûri grâce à toi."

# game/scripts/c13/c13.rpy:702
translate french c13s002_TheHospital_32efa1d7:

    # kia "Tu dejaste de ser tan pusilánime, no encuentro una palabra mejor, pero sin perder tu esencia. Sacábais lo mejor del otro y hacíais que el otro enterrase lo peor de sí mismo."
    kia "Tu as cessé d'être si timide — je ne trouve pas de meilleur mot — sans pour autant perdre ton essence. Vous avez fait ressortir le meilleur de chacun et vous vous êtes aidés mutuellement à enfouir le pire en vous."

# game/scripts/c13/c13.rpy:703
translate french c13s002_TheHospital_21480074:

    # mc "No éramos una pareja para ser los reyes del baile, pero no nos iba mal. Nadie hubiera votado por mí como rey del baile entonces."
    mc "Nous n'étions pas destinés à être élus roi et reine du bal de promo, mais nous nous en sortions plutôt bien. Personne n'aurait voté pour moi comme roi du bal à l'époque."

# game/scripts/c13/c13.rpy:705
translate french c13s002_TheHospital_387b6b7f:

    # kia "No necesitabais serlo. Solomon y yo lo fuimos, y ya ves..."
    kia "Tu n'avais pas besoin de l'être. Salomon et moi, si, et regarde où nous en sommes maintenant…"

# game/scripts/c13/c13.rpy:706
translate french c13s002_TheHospital_c48f9602:

    # mc "No te preocupes, Kiara. Si no quieres, no tienes que volver a verlo, y si quieres..."
    mc "Ne t'inquiète pas, Kiara. Si tu ne veux pas, tu n'es pas obligée de le revoir, et si tu le revois..."

# game/scripts/c13/c13.rpy:708
translate french c13s002_TheHospital_e8bbc76e:

    # kia "¡No! No voy a denunciarlo. Si no fuera por todo lo que me habéis dicho, no estaría aquí ni siquiera."
    kia "Non ! Je ne vais pas le signaler. Sans tout ce que vous m'avez dit, je ne serais même pas là."

# game/scripts/c13/c13.rpy:709
translate french c13s002_TheHospital_5f32c172:

    # mc "No te iba a decir eso. Es tu decisión y, aunque no la comparta, tengo que respetarlo. Es tu familia."
    mc "Je n'allais pas dire ça. C'est ta décision, et même si je ne suis pas d'accord, je dois la respecter. C'est ta famille."

# game/scripts/c13/c13.rpy:710
translate french c13s002_TheHospital_bfacd2fd:

    # mc "Iba a decirte que si querías podías quedarte en casa todo el tiempo que necesitaras."
    mc "J'allais vous dire que si vous le vouliez, vous pouviez rester chez vous aussi longtemps que nécessaire."

# game/scripts/c13/c13.rpy:711
translate french c13s002_TheHospital_108d37e9:

    # mc "Hasta otoño tenéis disponible la habitación que ocuparéis. Y después podéis volver a dormir en mi cama."
    mc "Tu auras la chambre jusqu'à l'automne. Et après, tu pourras revenir dormir dans mon lit."

# game/scripts/c13/c13.rpy:713
translate french c13s002_TheHospital_cda822c9:

    # kia "*Risa* Cualquiera que te oyera pensaría que hoy hemos dormido en tu cama contigo dentro. *Risa*"
    kia "*Rires* Si on t'entendait, on croirait qu'on a dormi dans ton lit avec toi dedans. *Rires*"

# game/scripts/c13/c13.rpy:714
translate french c13s002_TheHospital_f0c2fba7:

    # mc "Bueno, en esa cama hemos dormido tres personas confortablemente. *Risa*"
    mc "Eh bien, trois personnes ont dormi confortablement dans ce lit. *Rires*"

# game/scripts/c13/c13.rpy:715
translate french c13s002_TheHospital_059e8b1f:

    # mc "La entrada está ahí mismo. ¿Preparada?"
    mc "L'entrée est juste là. Prêt ?"

# game/scripts/c13/c13.rpy:717
translate french c13s002_TheHospital_405b7f9b:

    # kia "Sí. ¿Me aseguras que esa enfermera es de confianza? ¿No va a dar parte a la policía?"
    kia "Oui. Pouvez-vous me garantir que l'infirmière est digne de confiance ? Qu'elle ne le signalera pas à la police ?"

# game/scripts/c13/c13.rpy:718
translate french c13s002_TheHospital_d2670ae0:

    # mc "Kiara, Samantha es como una segunda madre para mí. No va a hacer nada que tu no quieras, pero me gustaría que comprobara como está ese brazo."
    mc "Kiara, Samantha est comme une deuxième mère pour moi. Elle ne fera rien contre ton gré, mais j'aimerais qu'elle examine ce bras."

# game/scripts/c13/c13.rpy:719
translate french c13s002_TheHospital_1e67f23d:

    # mc "Y si hace un informe que puedas usar si cambias de opinión, mejor."
    mc "Et si vous rédigez un rapport que vous pourrez utiliser si vous changez d'avis, c'est encore mieux."

# game/scripts/c13/c13.rpy:721
translate french c13s002_TheHospital_94d3a0e5:

    # kia "Vamos allá, entonces."
    kia "Allons-y alors."

# game/scripts/c13/c13.rpy:724
translate french c13s002_TheHospital_84bf76e9:

    # mc "Buenos días, Sam. Esta es Kiara, la madre de Eileen, no sé si la recuerdas."
    mc "Bonjour Sam. C'est Kiara, la mère d'Eileen, je ne sais pas si vous vous souvenez d'elle."

# game/scripts/c13/c13.rpy:725
translate french c13s002_TheHospital_01349ba5:

    # sam "Hola, [mc]. Encantada de volver a verte, Kiara. Hacía años que no coincidíamos. Voy a ser tu enfermera hoy."
    sam "Salut Kiara, [mc]. Quel plaisir de te revoir ! Ça fait une éternité qu'on ne s'est pas vues. Je serai ton infirmière aujourd'hui."

# game/scripts/c13/c13.rpy:727
translate french c13s002_TheHospital_0f9fa27a:

    # kia "Hola, Samantha. No es nada grave, de verdad. [mc] está exagerando."
    kia "Salut Samantha. Ce n'est rien de grave, vraiment. [mc] Elle exagère."

# game/scripts/c13/c13.rpy:728
translate french c13s002_TheHospital_5e3ef571:

    # mc "No exagero, tan solo soy precavido. Y ya has escuchado a Eileen, [nor] y [mar]."
    mc "Je n'exagère pas, je suis juste prudente. Et vous avez déjà entendu Eileen, [nor] et [mar]."

# game/scripts/c13/c13.rpy:730
translate french c13s002_TheHospital_9c807472:

    # sam "Un hematoma puede ser algo importante, más de lo que se piensa, no está de más echarle un ojo."
    sam "Un bleu peut être plus important qu'on ne le pense ; il est toujours bon d'y jeter un œil."

# game/scripts/c13/c13.rpy:731
translate french c13s002_TheHospital_58787efe:

    # sam "Acompáñame, Kiara. Tú quédate aquí, [mc]. No eres familia y no puedes pasar. Normas del hospital."
    sam "Viens avec moi, Kiara. Reste ici, [mc]. Tu n'es pas de la famille et tu ne peux pas entrer. Règlement de l'hôpital."

# game/scripts/c13/c13.rpy:732
translate french c13s002_TheHospital_98debacd:

    # mc "¿Para cuanto rato tenéis? Tengo que estar en otro sitio a las 10."
    mc "Vous avez combien de temps ? Je dois être ailleurs à 10 heures."

# game/scripts/c13/c13.rpy:734
translate french c13s002_TheHospital_e773f8c7:

    # sam "Déjame echarle una ojeada y salgo a decírtelo."
    sam "Laissez-moi jeter un coup d'œil et je vous dirai tout."

# game/scripts/c13/c13.rpy:735
translate french c13s002_TheHospital_22274886:

    # mc "Perfecto. Os espero aquí."
    mc "Parfait. Je t'attendrai ici."

# game/scripts/c13/c13.rpy:737
translate french c13s002_TheHospital_f02d5296:

    # kia "Una vez más, gracias, [mc]."
    kia "Encore une fois, merci, [mc]."

# game/scripts/c13/c13.rpy:738
translate french c13s002_TheHospital_e7dbd164:

    # mc "Una vez más, no es necesario. Si me tengo que ir mientras estás con Samantha, te escribo o te llamo."
    mc "Ce n'est pas nécessaire. Si je dois partir pendant que tu es avec Samantha, je t'enverrai un SMS ou je t'appellerai."

# game/scripts/c13/c13.rpy:740
translate french c13s002_TheHospital_820a6af0:

    # "Unos interminables minutos después..."
    "Quelques interminables minutes plus tard..."

# game/scripts/c13/c13.rpy:741
translate french c13s002_TheHospital_38b199fb:

    # sam "El brazo tiene mala pinta y quiero que la vea un doctor y que ordene una radiografía, pero ahora mismo están muy ocupados. Se va a quedar un rato. Calcula un par de horas."
    sam "Son bras a l'air abîmé, et je voudrais qu'un médecin l'examine et prescrive une radiographie, mais ils sont très occupés en ce moment. Elle va rester ici un moment. Prévoyez d'attendre quelques heures."

# game/scripts/c13/c13.rpy:742
translate french c13s002_TheHospital_60c5fa7b:

    # mc "Vale, entonces voy a ir hacer unas cosas y vuelvo luego a buscarla."
    mc "Très bien, alors je vais faire quelques petites choses et je reviendrai plus tard la chercher."

# game/scripts/c13/c13.rpy:744
translate french c13s002_TheHospital_ba851d07:

    # sam "Perfecto. Le diré que la has abandonado en un hospital y que no volverás a buscarla. *Risa*"
    sam "Parfait. Je lui dirai que tu l'as abandonnée à l'hôpital et que tu ne reviendras pas la chercher. *Rires*"

# game/scripts/c13/c13.rpy:746
translate french c13s002_TheHospital_74ed76d7:

    # mc "*Risa* Supongo que no me vas a dejar besarte aquí, ¿verdad?"
    mc "*Rires* J'imagine que tu ne vas pas me laisser t'embrasser ici, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:748
translate french c13s002_TheHospital_1f2507c5:

    # sam "Supones bien. Aún no estoy preparada para que nadie del trabajo sepa lo nuestro."
    sam "Tu as raison. Je ne suis pas encore prête à ce que mes collègues soient au courant."

# game/scripts/c13/c13.rpy:749
translate french c13s002_TheHospital_6d255a72:

    # mc "Gracias, Sam. Trátala bien, por favor. Lo ha pasado mal"
    mc "Merci, Sam. Prends bien soin d'elle. Elle a beaucoup souffert."

# game/scripts/c13/c13.rpy:751
translate french c13s002_TheHospital_5463b54e:

    # sam "Yo siempre trato bien a mis pacientes, [mc]. *Risa* Ya lo sabes."
    sam "Je traite toujours bien mes patients, [mc]. *Rires* Tu le sais."

# game/scripts/c13/c13.rpy:752
translate french c13s002_TheHospital_e2248a1c:

    # mc "Y por cierto, Sam, perdón por el plantón de ayer."
    mc "Et au fait, Sam, désolé de m'avoir posé un lapin hier."

# game/scripts/c13/c13.rpy:754
translate french c13s002_TheHospital_6d8a5bae:

    # sam "No te preocupes. Jamaal lo agradeció, pero aún quedaron pastas si quieres venir esta tarde. Salgo a las 13:00, puedes venir a comer si quieres."
    sam "Ne t'inquiète pas. Jamaal a beaucoup apprécié, mais il reste des pâtes si tu veux venir cet après-midi. Je pars à 13h, tu peux venir déjeuner si tu veux."

# game/scripts/c13/c13.rpy:755
translate french c13s002_TheHospital_4bf1bc5c:

    # mc "Imposible, tengo que recoger a la última estudiante en el aeropuerto. Pero intentaré pasar por la tarde."
    mc "Impossible, je dois aller chercher le dernier étudiant à l'aéroport. Mais j'essaierai de passer cet après-midi."

# game/scripts/c13/c13.rpy:757
translate french c13s002_TheHospital_219452a4:

    # sam "Genial, te esperaré."
    sam "Parfait, je t'attendrai."

# game/scripts/c13/c13.rpy:759
translate french c13s002_TheHospital_b956b59d:

    # mc "Hasta dentro de un rato, Sam."
    mc "À tout à l'heure, Sam."

# game/scripts/c13/c13.rpy:776
translate french c13s003_ScarlettHouse_d5785649:

    # "Aparcas delante de casa de Scarlett y le mandas un mensaje. Has pasado el video a una tablet para que sea más cómodo enseñárselo a su madre."
    "Vous vous garez devant chez Scarlett et lui envoyez un message. Vous avez transféré la vidéo sur une tablette pour pouvoir la montrer plus facilement à sa mère."

# game/scripts/c13/c13.rpy:777
translate french c13s003_ScarlettHouse_76d06bb6:

    # "Scarlett sale de su casa y entra en la camioneta."
    "Scarlett quitte sa maison et monte dans le camion."

# game/scripts/c13/c13.rpy:781
translate french c13s003_ScarlettHouse_c084bbf6:

    # sca "Hola, cariño, me muero por besarte, pero no puedo aquí. Si mi madre nos ve..."
    sca "Salut chéri(e), j'ai tellement envie de t'embrasser, mais je ne peux pas ici. Si ma mère nous voit…"

# game/scripts/c13/c13.rpy:782
translate french c13s003_ScarlettHouse_712d4745:

    # mc "Lo entiendo. Te avergüenzas de mí."
    mc "Je comprends. Tu as honte de moi."

# game/scripts/c13/c13.rpy:784
translate french c13s003_ScarlettHouse_23f27e3b:

    # sca "Estoy castigada un día sin salir por quemar una olla haciendo{b}me{/b} espaguetis. Si mi madre se entera de que los hice para mi novio, estaré una semana."
    sca "Je suis privée de sortie pour la journée parce que j'ai fait brûler une casserole en cuisinant des spaghettis. Si ma mère découvre que je les ai faits pour mon copain, je serai privée de sortie pendant une semaine."

# game/scripts/c13/c13.rpy:785
translate french c13s003_ScarlettHouse_ea248428:

    # sca "Y si descubre que acabamos pidiendo pizza, seguramente me castigue un mes. ¿Has traído el video?"
    sca "Et s'il découvre qu'on a fini par commander des pizzas, il va sûrement me priver de sortie pendant un mois. Tu as apporté la vidéo ?"

# game/scripts/c13/c13.rpy:787
translate french c13s003_ScarlettHouse_d1162091:

    # sca "Hola, [mc]. ¿Has traído el video ese?"
    sca "Salut, [mc]. As-tu apporté cette vidéo ?"

# game/scripts/c13/c13.rpy:788
translate french c13s003_ScarlettHouse_5e05c1e2:

    # mc "Sí, lo he pasado a una tablet para que le sea más cómodo leer los subtítulos que en el móvil."
    mc "Oui, je suis passée à une tablette pour qu'il puisse lire plus facilement les sous-titres que sur son téléphone."

# game/scripts/c13/c13.rpy:790
translate french c13s003_ScarlettHouse_868701f2:

    # sca "¿Puedo verlo?"
    sca "Puis-je le voir ?"

# game/scripts/c13/c13.rpy:791
translate french c13s003_ScarlettHouse_6d74797e:

    # mc "Por supuesto. Aquí tienes la tablet."
    mc "Bien sûr. Voici la tablette."

# game/scripts/c13/c13.rpy:793
translate french c13s003_ScarlettHouse_119cd6aa:

    # "Scarlett permanece en silencio durante todo el video. Tan solo con la boca abierta en una expresión de sorpresa."
    "Scarlett reste silencieuse tout au long de la vidéo, la bouche grande ouverte de surprise."

# game/scripts/c13/c13.rpy:795
translate french c13s003_ScarlettHouse_222c5534:

    # sca "Hay que enseñárselo a mi madre. Con esto tendrá que creer que todas las veces que le he dicho que Kevin me acosaba era cierto."
    sca "Je dois montrer ça à ma mère. Ça la convaincra que toutes les fois où je lui ai dit que Kevin me harcelait, c'était vrai."

# game/scripts/c13/c13.rpy:796
translate french c13s003_ScarlettHouse_ef1ef17d:

    # mc "Sí, no hay forma de negarlo. Está claro cuales son sus intenciones."
    mc "Oui, c'est indéniable. Leurs intentions sont claires."

# game/scripts/c13/c13.rpy:797
translate french c13s003_ScarlettHouse_7086eea4:

    # sca "Vamos dentro a enseñárselo..."
    sca "Entrons et montrons-le-lui..."

# game/scripts/c13/c13.rpy:799
translate french c13s003_ScarlettHouse_e49a2d90:

    # sca "¡Mierda! Hay un problema."
    sca "Mince ! Il y a un problème."

# game/scripts/c13/c13.rpy:800
translate french c13s003_ScarlettHouse_3b916da8:

    # mc "¿Qué pasa?"
    mc "Ce qui se passe?"

# game/scripts/c13/c13.rpy:801
translate french c13s003_ScarlettHouse_9adecb95:

    # sca "¿De dónde le decimos que lo hemos sacado?"
    sca "Où est-ce qu'on lui dit qu'on l'a trouvé ?"

# game/scripts/c13/c13.rpy:802
translate french c13s003_ScarlettHouse_7885187f:

    # mc "No había pensado en eso... ¿Siempre te ha acosado en tu habitación?"
    mc "Je n'y avais pas pensé… Est-ce qu'il t'a toujours suivie dans ta chambre ?"

# game/scripts/c13/c13.rpy:804
translate french c13s003_ScarlettHouse_20c3efd6:

    # sca "No, en cualquier sitio de casa, pero la mayoría de veces ha sido en mi habitación."
    sca "Non, nulle part dans la maison, mais le plus souvent c'était dans ma chambre."

# game/scripts/c13/c13.rpy:805
translate french c13s003_ScarlettHouse_4b4421fe:

    # mc "Puedes decir que me pediste que instalara esa cámara ya que ella no te creía. Así también tienes una razón para que lo haya traído yo en vez de enseñárselo tú ayer."
    mc "Vous pouvez dire que vous m'avez demandé d'installer cette caméra parce qu'elle ne vous croyait pas. Cela explique aussi pourquoi je l'ai apportée au lieu de la lui montrer vous-même hier."

# game/scripts/c13/c13.rpy:807
translate french c13s003_ScarlettHouse_c8d6a682:

    # sca "Puede ser una buena idea. Eso le da más plausibilidad. Vamos"
    sca "Ce serait une bonne idée. Cela la rend plus plausible. Allons-y."

# game/scripts/c13/c13.rpy:809
translate french c13s003_ScarlettHouse_ebd70d04:

    # "Al bajar de la camioneta Scarlett saca el móvil mientras os dirigís a la puerta. Te mira con nerviosismo."
    "Alors que vous descendez du camion, Scarlett sort son téléphone tandis que vous vous dirigez vers la porte. Elle vous regarde nerveusement."

# game/scripts/c13/c13.rpy:810
translate french c13s003_ScarlettHouse_74b5d1dd:

    # sca "Truco de sordos. Le mando un mensaje a mi madre por la aplicación del timbre, diciéndole que voy a entrar."
    sca "Astuce pour les sourds. J'envoie un message à ma mère via l'application de sonnette pour lui dire que j'arrive."

# game/scripts/c13/c13.rpy:811
translate french c13s003_ScarlettHouse_c28919a2:

    # sca "No puede oír ni el timbre ni la puerta, así está sobreaviso de que hay alguien más en casa."
    sca "Il n'entend ni la sonnette ni la porte, il est donc toujours conscient qu'il y a quelqu'un d'autre à la maison."

# game/scripts/c13/c13.rpy:813
translate french c13s003_ScarlettHouse_ef708947:

    # mc "Compraremos una cosa así si algún día es necesaria."
    mc "Nous achèterons quelque chose comme ça si jamais nous en avons besoin."

# game/scripts/c13/c13.rpy:815
translate french c13s003_ScarlettHouse_0e0d595e:

    # sca "No puedes saber lo que llego a quererte por cosas como estas."
    sca "Tu ne peux pas savoir à quel point je t'aime à cause de choses comme ça."

# game/scripts/c13/c13.rpy:817
translate french c13s003_ScarlettHouse_33b096ee:

    # "Entraís en casa y Scarlett hace las presentaciones. Te presenta como un amigo."
    "Vous entrez dans la maison et Scarlett fait les présentations. Elle vous présente comme une amie."

# game/scripts/c13/c13.rpy:818
translate french c13s003_ScarlettHouse_1091cbb7:

    # "Te imaginabas que iba a ser una conversación a través de lengua de signos, pero la Señora Russell habla perfectamente, con ese deje especial que tienen las personas que no pueden escucharse."
    "Vous imaginiez une conversation en langue des signes, mais Mme Russell parle parfaitement, avec cette intonation particulière propre aux personnes qui ne peuvent pas s'entendre."

# game/scripts/c13/c13.rpy:819
translate french c13s003_ScarlettHouse_070426e2:

    # "Scarlett explica la excusa que habéis inventado para tener el video, sin contarle el contenido."
    "Scarlett explique l'excuse que vous avez inventée pour obtenir la vidéo, sans lui en révéler le contenu."

# game/scripts/c13/c13.rpy:820
translate french c13s003_ScarlettHouse_a60b0594:

    # "A la Señora Russell no le gusta mucho la idea."
    "Mme Russell n'apprécie pas beaucoup cette idée."

# game/scripts/c13/c13.rpy:823
translate french c13s003_ScarlettHouse_452cd8c9:

    # mj "¿Has puesto cámaras en mi casa? ¿Por qué no me has pedido autorización?"
    mj "Avez-vous installé des caméras chez moi ? Pourquoi ne m'avez-vous pas demandé la permission ?"

# game/scripts/c13/c13.rpy:826
translate french c13s003_ScarlettHouse_0af5e0d8:

    # sca "Mamá, no estabas. No te podía mandar un mensaje por si lo leía Kevin. Tomé la decisión, es mi habitación al fin y al cabo."
    sca "Maman, tu n'étais pas là. Je ne pouvais pas t'envoyer de texto de peur que Kevin ne le voie. J'ai pris ma décision ; après tout, c'est ma chambre."

# game/scripts/c13/c13.rpy:828
translate french c13s003_ScarlettHouse_88202063:

    # mj "Pero está en mi casa. Tendrías que habérmelo dicho."
    mj "Mais c'est chez moi. Tu aurais dû me le dire."

# game/scripts/c13/c13.rpy:830
translate french c13s003_ScarlettHouse_cb2497de:

    # sca "Si te lo hubiera dicho me las hubieras hecho quitar y seguiríamos estando igual."
    sca "Si je te l'avais dit, tu m'aurais obligée à les enlever et nous serions toujours dans la même situation."

# game/scripts/c13/c13.rpy:831
translate french c13s003_ScarlettHouse_33640c56:

    # mc "Cuanta menos gente sepa estas cosas, suele ser mejor, Señora Russell."
    mc "Moins il y a de gens qui savent ces choses, mieux c'est, Madame Russell."

# game/scripts/c13/c13.rpy:833
translate french c13s003_ScarlettHouse_60acdc76:

    # mj "¿Qué has dicho?"
    mj "Qu'est-ce que vous avez dit?"

# game/scripts/c13/c13.rpy:835
translate french c13s003_ScarlettHouse_ea711448:

    # sca "Mírala de frente cuando hables con ella, [mc]. De esa forma puede leerte los labios."
    sca "Regarde-la droit dans les yeux quand tu lui parles, [mc]. Comme ça, elle pourra lire sur tes lèvres."

# game/scripts/c13/c13.rpy:837
translate french c13s003_ScarlettHouse_9d4b4d76:

    # mc "Perdón, Señora Russell, decía que cuanta menos gente sepa estas cosas, suele ser mejor."
    mc "Excusez-moi, Mme Russell, je disais simplement que moins il y a de gens qui connaissent ces choses, mieux c'est."

# game/scripts/c13/c13.rpy:838
translate french c13s003_ScarlettHouse_451365d1:

    # mc "Además, si nadie hace nada inapropiado en la habitación de Scarlett, no pasa nada, ¿no?"
    mc "D'ailleurs, si personne ne fait rien d'inapproprié dans la chambre de Scarlett, il ne se passe rien, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:839
translate french c13s003_ScarlettHouse_76cff8e4:

    # mj "Si tú tienes acceso a ese video, podrías ver a mi hija desnuda."
    mj "Si vous avez accès à cette vidéo, vous pourriez voir ma fille nue."

# game/scripts/c13/c13.rpy:841
translate french c13s003_ScarlettHouse_9067efd5:

    # sca "Mamá, hay ángulos muertos, yo sé dónde están y la cama no es visible en el video. Nadie va a verme desnuda."
    sca "Maman, il y a des angles morts, je sais où ils sont, et le lit n'est pas visible sur la vidéo. Personne ne me verra nue."

# game/scripts/c13/c13.rpy:842
translate french c13s003_ScarlettHouse_f4b5029f:

    # sca "Compruébalo tu misma mirando el video."
    sca "Voyez par vous-même en regardant la vidéo."

# game/scripts/c13/c13.rpy:844
translate french c13s003_ScarlettHouse_067f0102:

    # "El video comienza con Scarlett en su habitación."
    "La vidéo commence avec Scarlett dans sa chambre."

# game/scripts/c13/c13.rpy:846
translate french c13s003_ScarlettHouse_33e39d1a:

    # kev "Hola Scarlett, ¿Me has echado de menos?"
    kev "Salut Scarlett, tu m'as manqué ?"

# game/scripts/c13/c13.rpy:847
translate french c13s003_ScarlettHouse_41bf2d96:

    # scav "¡Kevin! Te he dicho mil veces que no entres en mi habitación sin llamar. ¡Podría estar cambiándome!"
    scav "Kevin ! Je t'ai dit mille fois de ne pas entrer dans ma chambre sans frapper. Je pourrais être en train de me changer !"

# game/scripts/c13/c13.rpy:848
translate french c13s003_ScarlettHouse_a0283cf6:

    # mj "¿Entró sin llamar?"
    mj "Est-il entré sans frapper ?"

# game/scripts/c13/c13.rpy:849
translate french c13s003_ScarlettHouse_90c56edb:

    # sca "Sí, Mamá, lo hace siempre. Ya le he dicho mil veces que no lo haga."
    sca "Oui maman, elle le fait tout le temps. Je lui ai dit mille fois d'arrêter."

# game/scripts/c13/c13.rpy:851
translate french c13s003_ScarlettHouse_bf4caf26:

    # kev "¿No he llamado? ¿Estás segura? Yo diría que sí. Deberías revisar si llevas bien ajustado tu audífono. *Risa*"
    kev "Je n'ai pas appelé ? Vous êtes sûr ? Je dirais que oui. Vous devriez vérifier si votre appareil auditif est bien réglé. *Rires*"

# game/scripts/c13/c13.rpy:852
translate french c13s003_ScarlettHouse_057b77ad:

    # mj "A lo mejor estabas despistada, cariño, y no lo oíste."
    mj "Tu étais peut-être distraite, chérie, et tu ne l'as pas entendu."

# game/scripts/c13/c13.rpy:853
translate french c13s003_ScarlettHouse_cd766fbe:

    # scav "Idiota, era mi oído bueno el que estaba encarado a la puerta."
    scav "Idiot, c'était ma bonne oreille qui était tournée vers la porte."

# game/scripts/c13/c13.rpy:855
translate french c13s003_ScarlettHouse_94f24f3d:

    # kev "Ya sabes que puedes perder el mundo de vista, cuando te pones a pensar en tus cosas y en ese chico que nunca te hará caso. *Risa cruel*"
    kev "Tu sais comment c'est, on peut perdre de vue le monde quand on commence à penser à ses propres affaires et à ce garçon qui ne te prêtera jamais attention. *Rire cruel*"

# game/scripts/c13/c13.rpy:857
translate french c13s003_ScarlettHouse_cdf56ea0:

    # scav "Pues que sepas que estamos saliendo. Imbécil."
    scav "Pour que tu le saches, on sort ensemble. Crétin."

# game/scripts/c13/c13.rpy:859
translate french c13s003_ScarlettHouse_d775c425:

    # scav "No es asunto tuyo si me hace caso o no. Imbécil."
    scav "Ça ne te regarde pas s'il m'écoute ou non. Crétin."

# game/scripts/c13/c13.rpy:860
translate french c13s003_ScarlettHouse_d2e67295:

    # mj "Creo que te has pasado insultándole. Lo que ha dicho es verdad, cuando te pones a pensar en ese chico..."
    mj "Je pense que tu es allé trop loin en l'insultant. Ce qu'il a dit est vrai, quand on pense à ce type..."

# game/scripts/c13/c13.rpy:861
translate french c13s003_ScarlettHouse_e8bd6ad6:

    # sca "¡Mamá!"
    sca "Mère!"

# game/scripts/c13/c13.rpy:862
translate french c13s003_ScarlettHouse_e15bb926:

    # kev "Pero aún no me has contestado ¿Me has echado de menos?"
    kev "Mais tu ne m'as toujours pas répondu. Tu m'as manqué ?"

# game/scripts/c13/c13.rpy:864
translate french c13s003_ScarlettHouse_eebb4602:

    # scav "Si crees que voy a echar de menos a alguien que entra en mi habitación sin autorización y sin llamar, estás muy equivocado."
    scav "Si vous pensez que je vais remarquer quelqu'un qui entre dans ma chambre sans permission et sans frapper, vous vous trompez lourdement."

# game/scripts/c13/c13.rpy:865
translate french c13s003_ScarlettHouse_11f9ffa6:

    # kev "Ya te he dicho que he llamado. A ver si voy a tener que poner cámaras para grabar nuestras conversaciones y cada vez que entro en tu habitación. *Risa*"
    kev "Je t'ai déjà dit que j'avais appelé. Je vais peut-être devoir installer des caméras pour enregistrer nos conversations et chaque fois que j'entre dans ta chambre. *Rires*"

# game/scripts/c13/c13.rpy:866
translate french c13s003_ScarlettHouse_b1fa78e1:

    # mj "Alguien las puso..."
    mj "Quelqu'un les a mis là..."

# game/scripts/c13/c13.rpy:868
translate french c13s003_ScarlettHouse_2a7ba7a6:

    # scav "¿Para qué? ¿Para pajearte mientras me cambio?"
    scav "Pourquoi ? Pour que tu puisses te masturber pendant que je me change ?"

# game/scripts/c13/c13.rpy:869
translate french c13s003_ScarlettHouse_33d2ab2a:

    # mj "¡Scarlett!"
    mj "Scarlett !"

# game/scripts/c13/c13.rpy:870
translate french c13s003_ScarlettHouse_548965d0:

    # sca "Espera y lee lo que dice ahora..."
    sca "Attendez et lisez ce qui est écrit maintenant..."

# game/scripts/c13/c13.rpy:871
translate french c13s003_ScarlettHouse_b6d075ee:

    # kev "Mira, niña, sería una buena paja. Y después pensaría en ello mientras tu madre me chupa la polla."
    kev "Écoute, ma belle, ça me ferait bien me branler. Et après, j'y penserais pendant que ta mère me sucerait la bite."

# game/scripts/c13/c13.rpy:873
translate french c13s003_ScarlettHouse_fc3c8a8c:

    # mj "Es imposible que haya dicho eso... No habéis manipulado los subtítulos, ¿verdad?"
    mj "Il est impossible qu'il ait dit ça... Vous n'avez pas trafiqué les sous-titres, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:874
translate french c13s003_ScarlettHouse_8bce374d:

    # mc "No, Señora Russell. Lo que usted lee y lo que oímos nosotros es lo mismo."
    mc "Non, Mme Russell. Ce que vous lisez et ce que nous entendons, c'est la même chose."

# game/scripts/c13/c13.rpy:875
translate french c13s003_ScarlettHouse_0c531c95:

    # sca "Espera, que ahora viene lo peor..."
    sca "Attendez, le pire est à venir..."

# game/scripts/c13/c13.rpy:877
translate french c13s003_ScarlettHouse_a3f22826:

    # kev "Y mañana tu madre tiene turno de noche y la he convencido para que te castigue por lo de la olla. No vas a poder fugarte a casa de tu amiguita."
    kev "Et demain, ta mère est de nuit, et je l'ai convaincue de te punir pour l'histoire du cannabis. Tu ne pourras pas t'enfuir chez ton ami."

# game/scripts/c13/c13.rpy:878
translate french c13s003_ScarlettHouse_c5ef0d82:

    # kev "Eres una inútil que no sirve ni para cocinar unos putos espaguetis."
    kev "Tu es une personne inutile qui ne sait même pas faire cuire de simples spaghettis."

# game/scripts/c13/c13.rpy:879
translate french c13s003_ScarlettHouse_21b48917:

    # kev "Por primera vez en meses vamos a estar solos en casa. A lo mejor puedo darte unas lecciones de como chupar una polla, por si ese chico algún día se decide..."
    kev "Pour la première fois depuis des mois, nous serons seuls à la maison. Je pourrais peut-être te donner quelques leçons de fellation, au cas où ce type déciderait un jour de…"

# game/scripts/c13/c13.rpy:884
translate french c13s003_ScarlettHouse_5c4ae1ac:

    # scav "Ni se te ocurra acercarte, cabrón."
    scav "N'essaie même pas de t'approcher de moi, espèce d'enfoiré."

# game/scripts/c13/c13.rpy:885
translate french c13s003_ScarlettHouse_33d2ab2a_1:

    # mj "¡Scarlett!"
    mj "Scarlett !"

# game/scripts/c13/c13.rpy:887
translate french c13s003_ScarlettHouse_79f1b411:

    # kev "Mejor que guardes esa furia para mañana. Me gustará más así."
    kev "Tu ferais mieux de garder ta colère pour demain. Je préfère ça."

# game/scripts/c13/c13.rpy:890
translate french c13s003_ScarlettHouse_d35b8ffd:

    # "*Portazo*"
    "*Claquer*"

# game/scripts/c13/c13.rpy:892
translate french c13s003_ScarlettHouse_40b82663:

    # mj "Esto no puede ser real. Sé que lo que decía Scarlett coincidía con los subtítulos, puedo leerle los labios en la mayoría del video, pero no me puedo creer que Kevin dijera eso."
    mj "C'est impossible. Je sais que ce que disait Scarlett correspondait aux sous-titres ; je peux lire sur ses lèvres pendant la majeure partie de la vidéo, mais je n'arrive pas à croire que Kevin ait dit ça."

# game/scripts/c13/c13.rpy:893
translate french c13s003_ScarlettHouse_ca7013a1:

    # mc "Señora Rusell, es lo que hay en el video, se lo aseguro."
    mc "Madame Russell, c'est bien ce qui est dans la vidéo, je vous l'assure."

# game/scripts/c13/c13.rpy:896
translate french c13s003_ScarlettHouse_502c4e9a:

    # sca "Mamá, [mc] dice la verdad. Kevin me dijo esas cosas."
    sca "Maman, [mc] dit la vérité. Kevin me l'a dit."

# game/scripts/c13/c13.rpy:898
translate french c13s003_ScarlettHouse_a1f7480b:

    # mj "¿Por qué no me lo dijiste ayer?"
    mj "Pourquoi ne me l'as-tu pas dit hier ?"

# game/scripts/c13/c13.rpy:901
translate french c13s003_ScarlettHouse_da739ef1:

    # sca "Te intenté decir hace unas semanas que se estaba propasando y no me creíste. Esperaba que [mc] viniera con pruebas para poder enseñártelas."
    sca "J'ai essayé de te prévenir il y a quelques semaines qu'il dépassait les bornes, mais tu ne m'as pas crue. J'espérais qu'il viendrait avec des preuves pour que je puisse te les montrer."

# game/scripts/c13/c13.rpy:903
translate french c13s003_ScarlettHouse_adbb64e3:

    # "En ese momento la Señora Russell deja de hablar con su voz y pasa a hacerlo con sus manos. Queda claro que quiere que sea una discusión entre madre e hija."
    "À ce moment-là, Mme Russell cesse de parler et commence à gesticuler. Il est clair qu'elle souhaite que ce soit une discussion entre mère et fille."

# game/scripts/c13/c13.rpy:904
translate french c13s003_ScarlettHouse_0b6bb391:

    # "Scarlett no traduce."
    "Scarlett ne traduit pas."

# game/scripts/c13/c13.rpy:906
translate french c13s003_ScarlettHouse_c9a30579:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si una de tus chicas acosara a tu hijo, si alguna vez lo tienes."
    "L'expression sur le visage de sa mère montre sa colère ; vous seriez en colère vous aussi si l'une de vos filles harcelait votre fils, si jamais vous en avez un."

# game/scripts/c13/c13.rpy:908
translate french c13s003_ScarlettHouse_44a27d8d:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si tu pareja acosara a tu hijo, si alguna vez lo tienes."
    "L'expression sur le visage de sa mère montre sa colère ; vous seriez en colère vous aussi si votre partenaire harcelait votre enfant, si jamais vous en aviez un."

# game/scripts/c13/c13.rpy:910
translate french c13s003_ScarlettHouse_e7673eea:

    # "Solo conoces una frase en lenguaje de signos. Esa frase aparece varias veces. Siempre en manos de Scarlett, nunca de su madre."
    "Tu ne connais qu'une seule phrase en langue des signes. Cette phrase apparaît plusieurs fois. Toujours dans les mains de Scarlett, jamais dans celles de sa mère."

# game/scripts/c13/c13.rpy:911
translate french c13s003_ScarlettHouse_72ac1e36:

    # "La conversación acaba abruptamente. Las dos están claramente enfadadas. Supones que con Kevin, pero mejor no preguntar."
    "La conversation s'interrompt brusquement. Ils sont tous deux visiblement en colère. On suppose que c'est à cause de Kevin, mais il vaut mieux ne pas poser la question."

# game/scripts/c13/c13.rpy:913
translate french c13s003_ScarlettHouse_d67c0f6f:

    # sca "Ya está. Dice que Kevin va a tardar poco en volver a casa y le preguntará sobre el video."
    sca "Voilà. Elle dit que Kevin rentrera bientôt et lui posera des questions sur la vidéo."

# game/scripts/c13/c13.rpy:914
translate french c13s003_ScarlettHouse_8be7e284:

    # mc "¿Le va a dar la oportunidad de negarlo?"
    mc "Allez-vous lui donner l'occasion de le nier ?"

# game/scripts/c13/c13.rpy:915
translate french c13s003_ScarlettHouse_59f6b087:

    # sca "Sí. Vamos a sentarnos a esperarlo."
    sca "Oui. Asseyons-nous et attendons-le."

# game/scripts/c13/c13.rpy:918
translate french c13s003_ScarlettHouse_9317aa29:

    # "Está claro que durante la conversación las cosas se han caldeado entre madre e hija y ha acabado en enfado. Está claro que ninguna de las dos va a decir una palabra más."
    "Il est clair que la conversation entre la mère et la fille s'est envenimée et s'est terminée dans la colère. Il est clair qu'aucune des deux ne dira un mot de plus."

# game/scripts/c13/c13.rpy:919
translate french c13s003_ScarlettHouse_d82fa969:

    # "Va a ser un silencio muy incómodo hasta que vuelva Kevin."
    "Le silence va être très gênant jusqu'au retour de Kevin."

# game/scripts/c13/c13.rpy:921
translate french c13s003_ScarlettHouse_d87a05b3:

    # "Por suerte, al cabo de unos minutos el móvil de la Señora Russell vibra."
    "Heureusement, au bout de quelques minutes, le téléphone portable de Mme Russell vibre."

# game/scripts/c13/c13.rpy:922
translate french c13s003_ScarlettHouse_f10289eb:

    # "Lo mira y su cara se ilumina con una sonrisa."
    "Elle le regarde et son visage s'illumine d'un sourire."

# game/scripts/c13/c13.rpy:923
translate french c13s003_ScarlettHouse_96d0411e:

    # "No es buena señal."
    "Ce n'est pas bon signe."

# game/scripts/c13/c13.rpy:926
translate french c13s003_ScarlettHouse_b5beb2e5:

    # kev "Hola, mi amor. Veo que tenemos visita."
    kev "Bonjour mon amour. Je vois que nous avons un visiteur."

# game/scripts/c13/c13.rpy:928
translate french c13s003_ScarlettHouse_d65b6379:

    # kev "Hola, soy Kevin Cameron. La pareja de esta preciosidad. Y prácticamente el padrastro de la otra belleza."
    kev "Salut, je suis Kevin Cameron. Le compagnon de cette beauté. Et pratiquement le beau-père de l'autre beauté."

# game/scripts/c13/c13.rpy:929
translate french c13s003_ScarlettHouse_0e1968fd:

    # "No te levantas. No piensas estrechar su mano."
    "Vous ne vous levez pas. Vous n'avez pas l'intention de lui serrer la main."

# game/scripts/c13/c13.rpy:930
translate french c13s003_ScarlettHouse_b80feb7a:

    # "Lo que te apetecería hacer sería meter esos dientes perfectos en su estómago de un puñetazo y dejar su cara hecha pulpa por tus puños."
    "Ce que vous aimeriez vraiment faire, c'est lui enfoncer ces dents parfaites dans le ventre d'un seul coup de poing et lui laisser le visage réduit en bouillie par vos poings."

# game/scripts/c13/c13.rpy:931
translate french c13s003_ScarlettHouse_70c8ad0c:

    # "Te cuesta retenerte de empezar a hacer zumo con sus ojos. Calma."
    "Tu as du mal à te retenir de lui crever les yeux. Calme-toi."

# game/scripts/c13/c13.rpy:932
translate french c13s003_ScarlettHouse_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c13/c13.rpy:934
translate french c13s003_ScarlettHouse_26927463:

    # kev "¿Ha pasado algo, cariño?"
    kev "Quelque chose s'est-il passé, chérie ?"

# game/scripts/c13/c13.rpy:936
translate french c13s003_ScarlettHouse_fab451ab:

    # mj "Mira este video, mi amor, por favor. Dime que no es cierto."
    mj "Regarde cette vidéo, mon amour, je t'en prie. Dis-moi que ce n'est pas vrai."

# game/scripts/c13/c13.rpy:938
translate french c13s003_ScarlettHouse_cfbdaf44:

    # kev "¿De qué va esto, mi vida?"
    kev "De quoi s'agit-il, mon amour ?"

# game/scripts/c13/c13.rpy:939
translate french c13s003_ScarlettHouse_207f5f72:

    # mj "Míralo, por favor."
    mj "Regardez-le, s'il vous plaît."

# game/scripts/c13/c13.rpy:940
translate french c13s003_ScarlettHouse_8ca34c39:

    # "Kevin empieza a mirar el video con una cara de perplejidad."
    "Kevin commence à regarder la vidéo avec une expression perplexe."

# game/scripts/c13/c13.rpy:942
translate french c13s003_ScarlettHouse_9d2a21fc:

    # "Su expresión cambia a sorpresa absoluta tal como pasan los segundos."
    "Son expression se transforme en une surprise absolue à mesure que les secondes s'égrènent."

# game/scripts/c13/c13.rpy:944
translate french c13s003_ScarlettHouse_d4774db5:

    # "Casi al final del video la sonrisa vuelve a su cara."
    "Vers la fin de la vidéo, le sourire réapparaît sur son visage."

# game/scripts/c13/c13.rpy:945
translate french c13s003_ScarlettHouse_96d0411e_1:

    # "No es buena señal."
    "Ce n'est pas bon signe."

# game/scripts/c13/c13.rpy:947
translate french c13s003_ScarlettHouse_fe059065:

    # kev "*Risa* Está muy bien hecho, pero como broma es un poco pesada."
    kev "*Rires* C'est très bien fait, mais en tant que blague, c'est un peu lourd."

# game/scripts/c13/c13.rpy:948
translate french c13s003_ScarlettHouse_b3ba264f:

    # mcp "{i}(¿Que?){/i}"
    mcp "{i}(Quoi ?){/i}"

# game/scripts/c13/c13.rpy:949
translate french c13s003_ScarlettHouse_898117f5:

    # kev "Además, este tipo tiene acento de Alabama, y ya sabes que yo soy de Tejas, cariño. No es mi voz."
    kev "En plus, ce type a un accent de l'Alabama, et tu sais que je suis du Texas, chérie. Ce n'est pas ma voix."

# game/scripts/c13/c13.rpy:950
translate french c13s003_ScarlettHouse_26b6669f:

    # "Tu perplejidad no hace más que aumentar. Es cláramente su voz y su acento. Tus ganas de machacarle la cara aumentan. Una bestia empieza a despertarse en tu interior. Calma."
    "Votre perplexité ne fait que croître. C'est clairement sa voix et son accent. Votre envie de lui casser la figure s'intensifie. Une bête commence à se réveiller en vous. Calmez-vous."

# game/scripts/c13/c13.rpy:951
translate french c13s003_ScarlettHouse_697275cf:

    # kev "*Risa* Lo que estos chicos son capaces de hacer con inteligencia artificial..."
    kev "*Rires* Ce dont ces types sont capables avec l'intelligence artificielle..."

# game/scripts/c13/c13.rpy:953
translate french c13s003_ScarlettHouse_d14e9945:

    # mj "¿Entonces no es cierto? ¿Me lo juras?"
    mj "Donc ce n'est pas vrai ? Vous me le jurez ?"

# game/scripts/c13/c13.rpy:954
translate french c13s003_ScarlettHouse_0042774a:

    # kev "Por supuesto que te lo juro."
    kev "Bien sûr que je vous le jure."

# game/scripts/c13/c13.rpy:956
translate french c13s003_ScarlettHouse_b2a49335:

    # mj "¡Lo sabía! No serías capaz de decir esas cosas."
    mj "Je le savais ! Tu ne pourrais pas dire de telles choses."

# game/scripts/c13/c13.rpy:957
translate french c13s003_ScarlettHouse_278b8aca:

    # kev "Por supuesto que no, cielo. Ya sabes que yo solo tengo ojos para ti."
    kev "Bien sûr que non, chérie. Tu sais que je n'ai d'yeux que pour toi."

# game/scripts/c13/c13.rpy:959
translate french c13s003_ScarlettHouse_dc0184ed:

    # mj "Señor Marks, no sé lo que esperaba conseguir con esta broma, pero no ha tenido ninguna gracia. Por favor, márchese de mi casa."
    mj "Monsieur Marks, je ne sais pas ce que vous espériez obtenir avec cette blague, mais elle n'était pas drôle du tout. Veuillez quitter ma maison."

# game/scripts/c13/c13.rpy:960
translate french c13s003_ScarlettHouse_22450a82:

    # mc "Pero Señora Russell, le está mintiendo."
    mc "Mais Mme Russell, il vous ment."

# game/scripts/c13/c13.rpy:961
translate french c13s003_ScarlettHouse_7a8d87e1:

    # mj "Cállese y váyase, por favor."
    mj "Taisez-vous et partez, s'il vous plaît."

# game/scripts/c13/c13.rpy:963
translate french c13s003_ScarlettHouse_be008068:

    # mj "Tú y yo vamos a tener una larga conversación, niña."
    mj "Toi et moi allons avoir une longue conversation, ma belle."

# game/scripts/c13/c13.rpy:964
translate french c13s003_ScarlettHouse_2d80d38b:

    # mc "*Susurrando* ¿Qué hago?"
    mc "*Chuchotant* Que dois-je faire ?"

# game/scripts/c13/c13.rpy:966
translate french c13s003_ScarlettHouse_7cd63c8c:

    # sca "Vete, [mc]. Ya lo intentaré arreglar... como sea."
    sca "Va-t'en, [mc]. Je vais essayer de réparer ça... d'une manière ou d'une autre."

# game/scripts/c13/c13.rpy:968
translate french c13s003_ScarlettHouse_0ba03c0e:

    # kev "Ya te acompaño yo a la puerta, muchacho."
    kev "Je vais te raccompagner jusqu'à la porte, gamin."

# game/scripts/c13/c13.rpy:969
translate french c13s003_ScarlettHouse_d99273bb:

    # "La palabra \"muchacho\" va cargada de ironía. Te está diciendo que eres un niño que se ha metido en un juego de adultos al que no pertenece."
    "Le mot « garçon » est chargé d'ironie. Il sous-entend que vous êtes un enfant mêlé à un jeu d'adultes qui n'est pas le vôtre."

# game/scripts/c13/c13.rpy:970
translate french c13s003_ScarlettHouse_973610e2:

    # "Te cuesta mucho no dejar salir la bestia que está creciendo dentro de ti. Calma."
    "Tu as beaucoup de mal à réprimer la bête qui grandit en toi. Calme-toi."

# game/scripts/c13/c13.rpy:972
translate french c13s003_ScarlettHouse_0bf90338:

    # "Desde la puerta puedes ver cómo madre e hija discuten. Lo surrealista de la situación hace que casi sea gracioso ver a dos personas gritándose en silencio."
    "Depuis l'embrasure de la porte, on aperçoit la mère et la fille qui se disputent. Le caractère surréaliste de la situation rend presque comique le spectacle de deux personnes se criant dessus en silence."

# game/scripts/c13/c13.rpy:973
translate french c13s003_ScarlettHouse_928dc63c:

    # kev "Mira, hijo, creía que solo iba a tener una noche a solas con esa putilla. Es demasiado perfecta para que la castiguen a menudo."
    kev "Écoute, fiston, je croyais ne passer qu'une seule nuit seul avec cette petite salope. Elle est trop parfaite pour être punie souvent."

# game/scripts/c13/c13.rpy:974
translate french c13s003_ScarlettHouse_9ac9e45d:

    # kev "Ahora, gracias a ti, me parece que voy a tener muchas noches a solas con ella. La próxima vez que la veas será toda una mujer."
    kev "Maintenant, grâce à toi, je crois que je vais passer de nombreuses nuits seul avec elle. La prochaine fois que tu la verras, elle sera devenue une femme."

# game/scripts/c13/c13.rpy:975
translate french c13s003_ScarlettHouse_01a34171:

    # "Lisa estaría orgullosa de ti. Una bestia a la que has estado a punto de llevar a la extinción aparece con toda la furia de un animal aprisionado."
    "Lisa serait fière de toi. Une bête que tu as presque menée à l'extinction a ressurgi avec toute la fureur d'un animal en cage."

# game/scripts/c13/c13.rpy:978
translate french c13s003_ScarlettHouse_56735bfc:

    # "Tu puño sale disparado hacia la boca de Kevin. No es un rodillo, pero hace el mismo efecto. No saltan dientes."
    "Ton poing fonce vers la bouche de Kevin. Ce n'est pas un rouleau à pâtisserie, mais l'effet est le même. Aucune dent ne vole."

# game/scripts/c13/c13.rpy:980
translate french c13s003_ScarlettHouse_310a016f:

    # "Scarlett y la Señora Rusell paran la discusión y os miran mientras Kevin cae al suelo."
    "Scarlett et Mme Russell interrompent leur dispute et vous regardent tandis que Kevin s'effondre au sol."

# game/scripts/c13/c13.rpy:981
translate french c13s003_ScarlettHouse_f677d9f2:

    # mc "Scarlett, haz las maletas si quieres puedes venir a casa. No voy a dejarte con este cerdo."
    mc "Scarlett, fais tes valises. Si tu veux, tu peux rentrer. Je ne vais pas te laisser avec ce cochon."

# game/scripts/c13/c13.rpy:983
translate french c13s003_ScarlettHouse_25247a8f:

    # kev "¡Te voy a denunciar, hijo de puta! ¡Sé tu nombre!"
    kev "Je vais te dénoncer, espèce d'enfoiré ! Je connais ton nom !"

# game/scripts/c13/c13.rpy:985
translate french c13s003_ScarlettHouse_cc6f8065:

    # mj "¡Haz tus maletas y vete de mi casa, Scarlett!"
    mj "Fais tes valises et quitte ma maison, Scarlett !"

# game/scripts/c13/c13.rpy:986
translate french c13s003_ScarlettHouse_e44811be:

    # mj "¡No te quiero volver a ver en esta casa!"
    mj "Je ne veux plus jamais te revoir dans cette maison !"

# game/scripts/c13/c13.rpy:987
translate french c13s003_ScarlettHouse_92dacd4e:

    # sca "¿Qué?"
    sca "Que?"

# game/scripts/c13/c13.rpy:988
translate french c13s003_ScarlettHouse_36b09a89:

    # "Nada está saliendo como habías planeado..."
    "Rien ne se passe comme prévu..."

# game/scripts/c13/c13.rpy:990
translate french c13s003_ScarlettHouse_04a98fcd:

    # mj "¡Lo que has oído! ¡Primero me destrozas la vida!"
    mj "Vous m'avez bien entendu ! D'abord, vous me gâchez la vie !"

# game/scripts/c13/c13.rpy:991
translate french c13s003_ScarlettHouse_2a04d9fb:

    # mj "¡Después tu padre deja de mandarme dinero!"
    mj "Alors ton père arrête de m'envoyer de l'argent !"

# game/scripts/c13/c13.rpy:992
translate french c13s003_ScarlettHouse_14f46e82:

    # mj "¡Ahora traes a tu amigo para que apalice a Kevin, con lo bueno que ha sido con nosotras! ¡Fuera de aquí!"
    mj "Maintenant, tu amènes ton ami ici pour tabasser Kevin, après tout ce qu'il a fait pour nous ! Fiche le camp !"

# game/scripts/c13/c13.rpy:993
translate french c13s003_ScarlettHouse_23c9d6e2:

    # sca "¿Qué estás diciendo? ¿Has estado recibiendo dinero de mi padre todos estos años?"
    sca "Que dites-vous ? Avez-vous reçu de l'argent de mon père pendant toutes ces années ?"

# game/scripts/c13/c13.rpy:994
translate french c13s003_ScarlettHouse_4fec626a:

    # "El tiempo parece haberse detenido para Kevin y para ti. Seguir la pelea hubiera sido lógico. Observar a las dos mujeres gritarse es más interesante."
    "Le temps semble s'être arrêté pour Kevin et pour vous. Suivre la dispute aurait été logique. Mais observer les deux femmes se crier dessus est bien plus intéressant."

# game/scripts/c13/c13.rpy:996
translate french c13s003_ScarlettHouse_65aed982:

    # mj "¡Sí! ¡Y me alegra habértelo ocultado! No te mereces nada."
    mj "Oui ! Et je suis content de te l'avoir caché ! Tu ne mérites rien."

# game/scripts/c13/c13.rpy:997
translate french c13s003_ScarlettHouse_a7e99f3c:

    # sca "¡Pues lo buscaré e iré con él! Seguro que estaré mejor con él que contigo. Siempre pensando solo en el dinero y creyendo antes a Kevin que a tu hija."
    sca "Eh bien, je le retrouverai et j'irai avec lui ! Je suis sûre que je serai mieux avec lui qu'avec toi. Tu ne penses qu'à l'argent et tu fais plus confiance à Kevin qu'à ta fille."

# game/scripts/c13/c13.rpy:999
translate french c13s003_ScarlettHouse_3c731fe7:

    # mj "Suerte con eso. Me escribió hace unos días. Como ya tienes 18, no va a mandar más dinero."
    mj "Bon courage. Il m'a écrit il y a quelques jours. Comme tu as 18 ans maintenant, il ne t'enverra plus d'argent."

# game/scripts/c13/c13.rpy:1000
translate french c13s003_ScarlettHouse_e11e2a40:

    # mj "Eso es lo que te quiere y se preocupa por ti, mientras yo he sacrificado mi vida por tenerte."
    mj "C'est ce qu'il veut et ce qui lui importe, tandis que j'ai sacrifié ma vie pour t'avoir."

# game/scripts/c13/c13.rpy:1002
translate french c13s003_ScarlettHouse_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1004
translate french c13s003_ScarlettHouse_3ce3d494:

    # "El móvil de la Señora Russell vuelve a vibrar. El timbre os paraliza a todos durante unos segundos."
    "Le téléphone de Mme Russell vibre à nouveau. La sonnerie vous fige tous pendant quelques secondes."

# game/scripts/c13/c13.rpy:1006
translate french c13s003_ScarlettHouse_6092ea65_1:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1008
translate french c13s003_ScarlettHouse_6092ea65_2:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1010
translate french c13s003_ScarlettHouse_f326ad6a:

    # "La Señora Russell va a abrir la puerta. Esquiva el cuerpo de Kevin en el suelo. Si no fuera por eso, parecería que no ha pasado nada para ella. "
    "Mme Russell s'apprête à ouvrir la porte. Elle s'écarte pour éviter le corps de Kevin, étendu sur le sol. Sans cela, on croirait qu'il ne lui est rien arrivé."

# game/scripts/c13/c13.rpy:1011
translate french c13s003_ScarlettHouse_1795085c:

    # "La persona más inesperada está fuera."
    "La personne la plus inattendue est dehors."

# game/scripts/c13/c13.rpy:1013
translate french c13s003_ScarlettHouse_475ffd53:

    # ama "FBI. Apártese, Señora Russell."
    ama "FBI. Écartez-vous, Mme Russell."

# game/scripts/c13/c13.rpy:1014
translate french c13s003_ScarlettHouse_388905bb:

    # ama "¡[mc] Marks, queda detenido por infracciones contra la Ley de Pivacidad en el Hogar!"
    ama "[mc] Marks, vous êtes en état d'arrestation pour violation de la loi sur la protection de la vie privée à domicile !"

# game/scripts/c13/c13.rpy:1015
translate french c13s003_ScarlettHouse_bb4742bf:

    # mcp "{i}(No puede ser. Es igualita que [emm]... si no fuera por el pelo... y por que se la ve mucho más adulta que a [emm]...){/i}"
    mcp "{i}(Impossible. Elle ressemble trait pour trait à [emm]... si ce n'était pour les cheveux... et parce qu'elle paraît beaucoup plus âgée que [emm]...){/i}"

# game/scripts/c13/c13.rpy:1016
translate french c13s003_ScarlettHouse_8920c9e4:

    # mc "Ama..."
    mc "Amour..."

# game/scripts/c13/c13.rpy:1017
translate french c13s003_ScarlettHouse_e24ee8e5:

    # ama "¡Silencio! De rodillas. ¡Las manos detras de la espalda!"
    ama "Silence ! À genoux ! Mains derrière le dos !"

# game/scripts/c13/c13.rpy:1018
translate french c13s003_ScarlettHouse_8a825d46:

    # "Sigues sus instrucciones. No sabes de qué va esto."
    "Vous suivez ses instructions. Vous n'avez aucune idée de ce dont il s'agit."

# game/scripts/c13/c13.rpy:1020
translate french c13s003_ScarlettHouse_6cbf7c7c:

    # "Mientras Amanda te esposa..."
    "Pendant qu'Amanda vous menotte..."

# game/scripts/c13/c13.rpy:1021
translate french c13s003_ScarlettHouse_7a1b5cd4:

    # ama "*Susurrando* No te preocupes..."
    ama "*Chuchotant* Ne t'inquiète pas..."

# game/scripts/c13/c13.rpy:1022
translate french c13s003_ScarlettHouse_65204ccf:

    # kev "También me ha agredido..."
    kev "Il m'a aussi agressé..."

# game/scripts/c13/c13.rpy:1024
translate french c13s003_ScarlettHouse_50dcfcc7:

    # ama "Eso se sumará a la lista de cargos. Acompáñeme junto con la Señora Russell, por favor. Tengo que tomarles declaración."
    ama "Cela sera ajouté à la liste des charges. Veuillez me suivre, ainsi que Mme Russell. Je dois recueillir vos déclarations."

# game/scripts/c13/c13.rpy:1026
translate french c13s003_ScarlettHouse_47a4ca7e:

    # "Amanda desaparece con la Señora Russell y Kevin. Ambos están en shock."
    "Amanda disparaît avec Mme Russell et Kevin. Ils sont tous deux sous le choc."

# game/scripts/c13/c13.rpy:1027
translate french c13s003_ScarlettHouse_6b90c0b1:

    # sca "¿Esa era... [emm]?"
    sca "Était-ce... [emm] ?"

# game/scripts/c13/c13.rpy:1028
translate french c13s003_ScarlettHouse_a00cff2a:

    # mc "No, pero ahora no te lo puedo explicar. Ayúdame con las esposas."
    mc "Non, mais je ne peux pas vous l'expliquer maintenant. Aidez-moi avec les menottes."

# game/scripts/c13/c13.rpy:1030
translate french c13s003_ScarlettHouse_cc394469:

    # sca "No tengo ni idea de como abrirlas... "
    sca "Je n'ai aucune idée de comment les ouvrir..."

# game/scripts/c13/c13.rpy:1031
translate french c13s003_ScarlettHouse_4277e4fe:

    # mc "No te preocupes, Ama... la falsa [emm] va a volver ahora... está de nuestra... de mi parte. Ayúdame a levantarme."
    mc "Ne t'inquiète pas, Ama... la fausse revient... elle est de notre côté... de mon côté. Aide-moi à me relever."

# game/scripts/c13/c13.rpy:1033
translate french c13s003_ScarlettHouse_78d87fc9:

    # ama "Scarlett, ve a hacer las maletas. Tienes un par de horas. No creo que pueda entretenerlos mucho más antes de que empiecen a sospechar."
    ama "Scarlett, va faire tes valises. Tu as quelques heures. Je ne pense pas pouvoir les retenir beaucoup plus longtemps avant qu'ils ne commencent à se douter de quelque chose."

# game/scripts/c13/c13.rpy:1034
translate french c13s003_ScarlettHouse_cfe0f18d:

    # "Su voz transpira autoridad. Pero Scarlett ya no es la niña tímida de hace dos semanas. Algo ha cambiado en ella."
    "Sa voix respire l'autorité. Mais Scarlett n'est plus la jeune fille timide qu'elle était il y a deux semaines. Quelque chose a changé en elle."

# game/scripts/c13/c13.rpy:1036
translate french c13s003_ScarlettHouse_9037a408:

    # sca "¿Por qué? ¿Y quién eres? Tienes la cara de [emm], pero ahí acaba el parecido."
    sca "Pourquoi ? Et qui êtes-vous ? Vous avez le visage de [emm], mais la ressemblance s'arrête là."

# game/scripts/c13/c13.rpy:1037
translate french c13s003_ScarlettHouse_ad5f40e7:

    # mc "Scarlett, ya te he dicho que no te lo podía explicar ahora..."
    mc "Scarlett, je t'ai déjà dit que je ne pouvais pas te l'expliquer maintenant..."

# game/scripts/c13/c13.rpy:1040
translate french c13s003_ScarlettHouse_82bd4e59:

    # ama "Será mejor que hagas caso a tu novio, Scarlett."
    ama "Tu ferais mieux d'écouter ton petit ami, Scarlett."

# game/scripts/c13/c13.rpy:1042
translate french c13s003_ScarlettHouse_529e2605:

    # ama "Será mejor que hagas caso a [mc], Scarlett."
    ama "Tu ferais mieux d'écouter [mc], Scarlett."

# game/scripts/c13/c13.rpy:1043
translate french c13s003_ScarlettHouse_e520b6e2:

    # ama "Si dejo a tu madre y a Kevin mucho rato solos saldrán del estado de shock y empezarán a notar que hay cosas que no cuadran."
    ama "Si je laisse votre mère et Kevin seuls pendant longtemps, ils sortiront de leur choc et commenceront à remarquer que certaines choses ne collent pas."

# game/scripts/c13/c13.rpy:1045
translate french c13s003_ScarlettHouse_27bcf464:

    # sca "Tienes razón. Los agentes del FBI siempre van por parejas en las películas, y has dejado a un sospechoso sin vigilancia. Mi madre no es tonta y lo notará."
    sca "Vous avez raison. Dans les films, les agents du FBI travaillent toujours en binôme, et vous avez laissé un suspect sans surveillance. Ma mère n'est pas idiote et elle s'en apercevra."

# game/scripts/c13/c13.rpy:1046
translate french c13s003_ScarlettHouse_2f91c156:

    # sca "Voy a hacer las maletas y ahora vuelvo."
    sca "Je vais faire mes valises et je reviens tout de suite."

# game/scripts/c13/c13.rpy:1048
translate french c13s003_ScarlettHouse_2e295c3e:

    # "Un minuto después, una vez retiradas las esposas..."
    "Une minute plus tard, une fois les menottes retirées..."

# game/scripts/c13/c13.rpy:1049
translate french c13s003_ScarlettHouse_7049495e:

    # ama "¡Joder! Cuando te mandamos el video creíamos que ibas a usar a Jamaal para hacerlo viral en MeTube o llevárselo a Alexia. No esto."
    ama "Mince alors ! Quand on t'a envoyé la vidéo, on pensait que tu allais utiliser Jamaal pour la rendre virale sur MeTube ou la montrer à Alexia. Pas ça."

# game/scripts/c13/c13.rpy:1050
translate french c13s003_ScarlettHouse_947cf5cd:

    # ama "He venido en cuanto he deducido que tu plan no iba a funcionar."
    ama "Je suis venu dès que j'ai compris que votre plan n'allait pas fonctionner."

# game/scripts/c13/c13.rpy:1051
translate french c13s003_ScarlettHouse_805f55e4:

    # mc "Creía que esto podía solucionarlo todo... Al menos hoy te ha dado tiempo de quitarte el mono de mecánico..."
    mc "Je pensais que ça pourrait tout résoudre… Au moins aujourd’hui, tu as eu le temps d’enlever ta salopette de mécanicien…"

# game/scripts/c13/c13.rpy:1052
translate french c13s003_ScarlettHouse_36417800:

    # mc "¿Desde cuándo tenéis cámaras en casa de Scarlett? ¿Hay otros videos donde se vea la cara de Kevin y la Señora Russell pueda leer sus labios?"
    mc "Depuis quand y a-t-il des caméras chez Scarlett ? Existe-t-il d'autres vidéos où l'on voit le visage de Kevin et où Mme Russell peut lire sur ses lèvres ?"

# game/scripts/c13/c13.rpy:1054
translate french c13s003_ScarlettHouse_24b0910e:

    # ama "No, lo siento. Las pusimos el domingo, cuando Scarlett fue a comprar al supermercado..."
    ama "Non, désolé. Nous les avons installés dimanche, pendant que Scarlett faisait ses courses au supermarché..."

# game/scripts/c13/c13.rpy:1056
translate french c13s003_ScarlettHouse_b609be58:

    # mc "Entonces tenéis grabado..."
    mc "Vous l'avez donc enregistré..."

# game/scripts/c13/c13.rpy:1057
translate french c13s003_ScarlettHouse_a62755ee:

    # ama "Sí, pero destruímos todo lo que no es importante para la misión..."
    ama "Oui, mais nous détruisons tout ce qui n'est pas important pour la mission..."

# game/scripts/c13/c13.rpy:1059
translate french c13s003_ScarlettHouse_424ad18e:

    # mc "Lástima... pero ¿por qué vigilar la casa de Scarlett?"
    mc "Dommage… mais pourquoi regarder la maison de Scarlett ?"

# game/scripts/c13/c13.rpy:1060
translate french c13s003_ScarlettHouse_f2975f2e:

    # ama "Podía ser importante para la misión... y destruimos lo que no es importante."
    ama "Cela pourrait être important pour la mission... et nous détruisons ce qui n'est pas important."

# game/scripts/c13/c13.rpy:1061
translate french c13s003_ScarlettHouse_ae4af940:

    # ama "{i}(O lo copiamos a discos privados.){/i}"
    ama "{i}(Ou nous le copions sur des disques privés.){/i}"

# game/scripts/c13/c13.rpy:1062
translate french c13s003_ScarlettHouse_3fddcc67:

    # mc "Y no me vas a decir cual es esa misión, ¿verdad? ¿Tiene algo que ver con la cláusula NG?"
    mc "Et vous n'allez pas me dire en quoi consiste cette mission, n'est-ce pas ? Est-ce que cela a quelque chose à voir avec la clause NG ?"

# game/scripts/c13/c13.rpy:1064
translate french c13s003_ScarlettHouse_76e960e9:

    # ama "{b}¿Qué?{/b} ¿Dónde has oído eso? "
    ama "{b}Quoi ?{/b} Où as-tu entendu ça ?"

# game/scripts/c13/c13.rpy:1065
translate french c13s003_ScarlettHouse_d881f221:

    # mc "Vosotras tenéis vuestros secretos y yo los míos. Cuando quieras intercambiamos información."
    mc "Tu as tes secrets et j'ai les miens. Nous pouvons échanger des informations quand tu le souhaites."

# game/scripts/c13/c13.rpy:1066
translate french c13s003_ScarlettHouse_39cc3e0d:

    # mc "{i}(OK. No tienen acceso a mi ordenador o no son capaces de romper el cifrado de Jamaal.){/i}"
    mc "{i}(OK. Soit ils n'ont pas accès à mon ordinateur, soit ils sont incapables de déchiffrer le cryptage de Jamaal.){/i}"

# game/scripts/c13/c13.rpy:1068
translate french c13s003_ScarlettHouse_01ede65e:

    # ama "Me parece justo. Mañana o pasado nos pondremos en contacto con vosotros para hablar."
    ama "Cela me semble juste. Nous vous contacterons demain ou après-demain pour en discuter."

# game/scripts/c13/c13.rpy:1069
translate french c13s003_ScarlettHouse_65abb11e:

    # ama "Voy a llevarme a la Señora Russell y a Kevin o van a empezar a sospechar. Les voy a decir que estás detenido, con lo que mejor que no pases por este barrio en unos días."
    ama "Je vais emmener Mme Russell et Kevin avec moi, sinon ils vont se douter de quelque chose. Je vais leur dire que vous êtes en état d'arrestation, alors évitez de vous aventurer dans le quartier pendant quelques jours."

# game/scripts/c13/c13.rpy:1070
translate french c13s003_ScarlettHouse_776dbc69:

    # mc "Sólo una pregunta más. ¿Por qué me habéis enviado el video? Scarlett no tiene nada que ver con NTR o con GILF."
    mc "Une dernière question. Pourquoi m'as-tu envoyé cette vidéo ? Scarlett n'a rien à voir avec le NTR ou les MILF."

# game/scripts/c13/c13.rpy:1072
translate french c13s003_ScarlettHouse_1a22ac27:

    # ama "Porque pensamos que podía ser importante. Especialmente para ti... y para [dap]... aunque no tenga nada que ver con la misión. Y porque Kevin es un cerdo."
    ama "Parce que nous pensions que cela pourrait être important. Surtout pour vous… et pour [dap]… même si cela n'a rien à voir avec la mission. Et parce que Kevin est un porc."

# game/scripts/c13/c13.rpy:1073
translate french c13s003_ScarlettHouse_b2516466:

    # mc "Gracias."
    mc "Merci."

# game/scripts/c13/c13.rpy:1075
translate french c13s003_ScarlettHouse_514c8615:

    # ama "No tienes que darlas. Saca a Scarlett de aquí en cuanto puedas."
    ama "Vous n'êtes pas obligé de les abandonner. Faites sortir Scarlett d'ici au plus vite."

# game/scripts/c13/c13.rpy:1076
translate french c13s003_ScarlettHouse_b69bbafa:

    # ama "No sabía lo del dinero de su padre, pero parece que era una de las razones por la que la Señora Russell no la ha echado antes."
    ama "J'ignorais tout de la fortune de son père, mais il semble que ce soit l'une des raisons pour lesquelles Mme Russell ne l'avait pas renvoyée plus tôt."

# game/scripts/c13/c13.rpy:1077
translate french c13s003_ScarlettHouse_318d4368:

    # ama "Nos veremos pronto. Buen puñetazo, por cierto."
    ama "À bientôt. Au fait, super punch !"

# game/scripts/c13/c13.rpy:1080
translate french c13s003_ScarlettHouse_0f479e29:

    # "Haces una llamada a [nor] y, después de confirmar la que pensabas que sería su respuesta, vas a la habitación de Scarlett."
    "Vous appelez [nor] et, après avoir confirmé ce que vous pensiez être sa réponse, vous vous rendez dans la chambre de Scarlett."

# game/scripts/c13/c13.rpy:1083
translate french c13s003_ScarlettHouse_6d700f97:

    # mc "¿Necesitas ayuda?"
    mc "Avez-vous besoin d'aide ?"

# game/scripts/c13/c13.rpy:1084
translate french c13s003_ScarlettHouse_ac751ecc:

    # sca "No sé por donde empezar. He cogido la ropa... y... y..."
    sca "Je ne sais pas par où commencer. J'ai ramassé les vêtements… et… et…"

# game/scripts/c13/c13.rpy:1085
translate french c13s003_ScarlettHouse_b3df5efd:

    # mc "Ven aquí."
    mc "Venez ici."

# game/scripts/c13/c13.rpy:1087
translate french c13s003_ScarlettHouse_e808086f:

    # sca "No tengo ni idea de qué voy a hacer... de dónde voy a vivir... estoy sin blanca..."
    sca "Je n'ai aucune idée de ce que je vais faire... où je vais vivre... Je suis fauché..."

# game/scripts/c13/c13.rpy:1088
translate french c13s003_ScarlettHouse_1d01af04:

    # mc "No te preocupes por eso. Acabo de hablar con [nor] y con [dap]. Les he explicado lo que ha pasado... al menos parte. He obviado lo del video."
    mc "Ne t'en fais pas. Je viens de parler avec [nor] et [dap]. Je leur ai expliqué ce qui s'est passé… enfin, une partie. J'ai omis de parler de la vidéo."

# game/scripts/c13/c13.rpy:1089
translate french c13s003_ScarlettHouse_8b4e277b:

    # mc "Puedes vivir en casa de [nor], si no te importa compartir habitacion con [dap]."
    mc "Tu peux vivre chez [nor], si cela ne te dérange pas de partager une chambre avec [dap]."

# game/scripts/c13/c13.rpy:1091
translate french c13s003_ScarlettHouse_de3bf20f:

    # sca "¿Que has hecho {b}qué{/b}?"
    sca "Qu'avez-vous fait?"

# game/scripts/c13/c13.rpy:1092
translate french c13s003_ScarlettHouse_226564a3:

    # mc "Sí, Scarlett. No tienes que preocuparte de dónde vas a vivir. Casi eres parte de la familia..."
    mc "Oui, Scarlett. Tu n'as pas à t'inquiéter pour ton logement. Tu fais pratiquement partie de la famille..."

# game/scripts/c13/c13.rpy:1095
translate french c13s003_ScarlettHouse_9f2f97ad:

    # sca "Te quiero. Gracias."
    sca "Je t'aime. Merci."

# game/scripts/c13/c13.rpy:1096
translate french c13s003_ScarlettHouse_95625d17:

    # mc "Y yo a ti. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "Et je t'aime aussi. Avant, tu y passais la moitié de tes nuits. Maintenant, ce sera toutes les nuits."

# game/scripts/c13/c13.rpy:1099
translate french c13s003_ScarlettHouse_2a24d1ed:

    # sca "Gracias, [mc]."
    sca "Merci, [mc]."

# game/scripts/c13/c13.rpy:1100
translate french c13s003_ScarlettHouse_9b5f1825:

    # mc "No tienes por que darlas. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "Tu n'es pas obligé d'y renoncer. Avant, tu y passais la moitié de tes nuits. Maintenant, ce sera toutes les nuits."

# game/scripts/c13/c13.rpy:1101
translate french c13s003_ScarlettHouse_04554e14:

    # mc "Vamos a acabar de recoger tus cosas y las llevamos a la camioneta."
    mc "Nous allons finir de rassembler vos affaires et les charger dans la camionnette."

# game/scripts/c13/c13.rpy:1103
translate french c13s003_ScarlettHouse_f65fe139:

    # sca "Pero ¿qué me llevo? Toda mi vida está en esta habitación..."
    sca "Mais qu'est-ce que j'emporte avec moi ? Toute ma vie est dans cette pièce..."

# game/scripts/c13/c13.rpy:1104
translate french c13s003_ScarlettHouse_7db5c2cf:

    # mc "Todo lo que quieras conservar."
    mc "Tout ce que vous voulez conserver."

# game/scripts/c13/c13.rpy:1106
translate french c13s003_ScarlettHouse_e16aa35c:

    # mc "Todo lo que quieras llevarte de esta vida a la que vas a empezar en casa."
    mc "Tout ce que vous souhaitez emporter avec vous de cette vie que vous vous apprêtez à commencer chez vous."

# game/scripts/c13/c13.rpy:1108
translate french c13s003_ScarlettHouse_a1efddeb:

    # mc "Tus fotos y pósters..."
    mc "Vos photos et affiches..."

# game/scripts/c13/c13.rpy:1110
translate french c13s003_ScarlettHouse_bd3a184f:

    # mc "Discos, libros..."
    mc "Disques, livres..."

# game/scripts/c13/c13.rpy:1111
translate french c13s003_ScarlettHouse_200e44b7:

    # mc "Cualquier cosa que quieras conservar. La parte de atrás de la camioneta está vacía. Voy a ir llevando el tocadiscos mientras decides que llevar."
    mc "Garde ce que tu veux. L'arrière du camion est vide. Je prends le tourne-disque pendant que tu choisis ce que tu emportes."

# game/scripts/c13/c13.rpy:1114
translate french c13s003_ScarlettHouse_6aba73a2:

    # "Una hora después, tras varios viajes a la camioneta y una llamada de teléfono..."
    "Une heure plus tard, après plusieurs allers-retours au camion et un coup de téléphone..."

# game/scripts/c13/c13.rpy:1115
translate french c13s003_ScarlettHouse_3201de0e:

    # sca "Ya está todo. Nos podemos ir."
    sca "Voilà. On peut y aller."

# game/scripts/c13/c13.rpy:1116
translate french c13s003_ScarlettHouse_4dab87e9:

    # mc "Despídete de esta casa, Scarlett. ¿Lo llevamos todo?"
    mc "Dis adieu à cette maison, Scarlett. On prend tout ?"

# game/scripts/c13/c13.rpy:1119
translate french c13s003_ScarlettHouse_74dca989:

    # sca "Sí, no queda nada ahí que quiera conservar. Una parte de mí la va a echar de menos. Otra parte mayor... no."
    sca "Oui, il ne reste plus rien là-bas que je veuille garder. Une partie de moi le regrettera. Une plus grande partie… non."

# game/scripts/c13/c13.rpy:1120
translate french c13s003_ScarlettHouse_7aa1096f:

    # sca "Saber que mi madre me ha estado ocultando cosas, que ha estado en contacto con mi padre todo este tiempo... que ha creído a Kevin antes que a mí..."
    sca "Sachant que ma mère m'a caché des choses, qu'elle a été en contact avec mon père tout ce temps… qu'elle a cru Kevin avant moi…"

# game/scripts/c13/c13.rpy:1121
translate french c13s003_ScarlettHouse_bdab500e:

    # mc "Sé que es difícil de digerir, pero vas a vivir con nosotros. Te vamos a ayudar entre todos."
    mc "Je sais que c'est difficile à accepter, mais tu vas vivre avec nous. Nous allons tous t'aider."

# game/scripts/c13/c13.rpy:1123
translate french c13s003_ScarlettHouse_000e092e:

    # sca "Gracias, [mc], una vez más."
    sca "Merci encore, [mc]."

# game/scripts/c13/c13.rpy:1124
translate french c13s003_ScarlettHouse_978ec110:

    # mc "No tienes por qué darlas. Pero nos tenemos que ir. Las nuevas inquilinas nos estarán esperando."
    mc "Vous n'êtes pas obligé de leur donner. Mais nous devons partir. Les nouveaux locataires nous attendront."

# game/scripts/c13/c13.rpy:1126
translate french c13s003_ScarlettHouse_89ac21b9:

    # sca "Es verdad, hoy llegaba la última estudiante del verano."
    sca "C'est exact, aujourd'hui est arrivé le dernier étudiant de l'été."

# game/scripts/c13/c13.rpy:1127
translate french c13s003_ScarlettHouse_e944ed7a:

    # mc "Sí, pasamos por el hospital a recoger a Kiara y vamos al aeropuerto a buscarla. Su vuelo llega en una hora."
    mc "Oui, nous allons à l'hôpital chercher Kiara, puis nous irons à l'aéroport la chercher. Son vol arrive dans une heure."

# game/scripts/c13/c13.rpy:1129
translate french c13s003_ScarlettHouse_ad060bf5:

    # sca "¿Kiara?"
    sca "Kiara ?"

# game/scripts/c13/c13.rpy:1130
translate french c13s003_ScarlettHouse_b1268ea3:

    # mc "Ahora la conocerás. Creo que te va a gustar."
    mc "Vous allez la rencontrer maintenant. Je pense qu'elle vous plaira."

# game/scripts/c13/c13.rpy:1163
translate french c13s004_KiaraAndScarlett_5ef2e59f:

    # sca "¿Quién es? ¿La conozco? No me suena el nombre."
    sca "Qui est-elle ? Est-ce que je la connais ? Ce nom ne me dit rien."

# game/scripts/c13/c13.rpy:1164
translate french c13s004_KiaraAndScarlett_b6297da9:

    # mc "Es la madre de Eileen. Va a vivir unos días con vosotras, en casa de [nor]."
    mc "C'est la mère d'Eileen. Elle va rester chez toi quelques jours, chez [nor]."

# game/scripts/c13/c13.rpy:1166
translate french c13s004_KiaraAndScarlett_e8600231:

    # sca "¿Eileen también?"
    sca "Eileen aussi ?"

# game/scripts/c13/c13.rpy:1167
translate french c13s004_KiaraAndScarlett_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Oui, pourquoi me posez-vous cette question ?"

# game/scripts/c13/c13.rpy:1170
translate french c13s004_KiaraAndScarlett_a7826cfb:

    # sca "Tan solo por curiosidad. Hace un tiempo me hubiera puesto celosa por saber que Eileen iba a vivir en tu casa... más o menos..."
    sca "Par simple curiosité. Il y a quelque temps, j'aurais été jalouse de savoir qu'Eileen allait vivre chez toi… enfin, presque…"

# game/scripts/c13/c13.rpy:1172
translate french c13s004_KiaraAndScarlett_b0adc982:

    # sca "Ahora que sé que estás saliendo con otras chicas, casi me alegraría que Eileen fuera una de ellas... y no, no estoy preguntando si lo es."
    sca "Maintenant que je sais que tu sors avec d'autres filles, je serais presque contente si Eileen en faisait partie... et non, je ne te demande pas si c'est le cas."

# game/scripts/c13/c13.rpy:1173
translate french c13s004_KiaraAndScarlett_51746308:

    # mc "Eso se lo tendrás que preguntar a ella. A ser posible conmigo delante. *Risa* Su cara puede ser muy divertida {b}si{/b} no estoy con ella."
    mc "Il faudra lui demander. Idéalement, en ma présence. *Rires* Sa tête est à mourir de rire {b}si{/b} je ne suis pas là."

# game/scripts/c13/c13.rpy:1175
translate french c13s004_KiaraAndScarlett_c76f8262:

    # sca "Ahora que estás saliendo conmigo, me da lo mismo quien viva contigo... con nosotros..."
    sca "Maintenant que tu sors avec moi, je me fiche de qui vit avec toi... avec nous..."

# game/scripts/c13/c13.rpy:1176
translate french c13s004_KiaraAndScarlett_32afb495:

    # mc "Scarlett, ahora mismo solo me importas tú. No me importa quién viva en casa."
    mc "Scarlett, en ce moment tu es la seule chose qui m'importe. Je me fiche de savoir qui vit à la maison."

# game/scripts/c13/c13.rpy:1179
translate french c13s004_KiaraAndScarlett_44fd8b13:

    # sca "Tan solo por curiosidad. Tú y yo no vamos a estar juntos nunca, con lo que no debo ponerme celosa por que tu ex viva en tu casa... más o menos..."
    sca "Par simple curiosité. Nous ne serons jamais ensemble, alors je ne devrais pas être jaloux que ton ex vive chez toi… enfin, presque…"

# game/scripts/c13/c13.rpy:1180
translate french c13s004_KiaraAndScarlett_efc8d372:

    # mc "Scarlett, ya lo hemos hablado. No sería justo para ninguno de los dos, lo único que harías es hacerte daño."
    mc "Scarlett, on en a déjà parlé. Ce ne serait juste ni pour toi ni pour moi ; tu ne ferais que te faire du mal."

# game/scripts/c13/c13.rpy:1181
translate french c13s004_KiaraAndScarlett_476b8ad5:

    # sca "Lo sé, pero no por ello es más fácil."
    sca "Je sais, mais ça ne rend pas les choses plus faciles."

# game/scripts/c13/c13.rpy:1183
translate french c13s004_KiaraAndScarlett_d2307d68:

    # sca "Si puedo preguntar, ¿por qué se han mudado a casa de [nor]?"
    sca "Si je peux me permettre, pourquoi avez-vous déménagé chez [nor] ?"

# game/scripts/c13/c13.rpy:1184
translate french c13s004_KiaraAndScarlett_e3304c3c:

    # mc "Por la misma razón que tú. Han tenido problemas en casa, y les hemos ofrecido un sitio donde quedarse. De momento se quedarán una semana."
    mc "Pour la même raison que vous. Ils ont des problèmes familiaux et nous leur avons proposé de les héberger. Pour l'instant, ils resteront une semaine."

# game/scripts/c13/c13.rpy:1185
translate french c13s004_KiaraAndScarlett_643a6609:

    # sca "Supongo que no vas a entrar en detalles igual que no entrarías si alguien te preguntará por qué me he mudado yo."
    sca "J'imagine que vous n'entrerez pas dans les détails, tout comme vous ne le feriez pas si quelqu'un vous demandait pourquoi j'ai déménagé."

# game/scripts/c13/c13.rpy:1186
translate french c13s004_KiaraAndScarlett_a4c22620:

    # mc "Exacto. Creo que cada una de vosotras tiene derecho a explicar lo que quiera a quién quiera."
    mc "Exactement. Je crois que chacun d'entre vous a le droit d'expliquer ce qu'il veut à qui il veut."

# game/scripts/c13/c13.rpy:1188
translate french c13s004_KiaraAndScarlett_a843553c:

    # sca "Y cambiando de tema... ¿quién es la falsa [emm]?"
    sca "Et pour changer de sujet... qui est le faux [emm] ?"

# game/scripts/c13/c13.rpy:1189
translate french c13s004_KiaraAndScarlett_85a9d95c:

    # mc "Aún no estoy muy seguro. De momento te puedo decir que las dos veces que la he visto ha aparecido para ayudar. Fue ella la que mandó el video."
    mc "Je n'en suis toujours pas tout à fait sûre. Pour l'instant, je peux vous dire que les deux fois où je l'ai vue, elle était là pour m'aider. C'est elle qui a envoyé la vidéo."

# game/scripts/c13/c13.rpy:1190
translate french c13s004_KiaraAndScarlett_036ff51c:

    # mc "Me ha dicho que en uno o dos días se pondrá en contacto con la familia para aclarar las cosas... supongo..."
    mc "Il m'a dit qu'il prendrait contact avec la famille dans un jour ou deux pour clarifier la situation... je suppose..."

# game/scripts/c13/c13.rpy:1192
translate french c13s004_KiaraAndScarlett_de8df744:

    # sca "¿Cómo sabía lo que estaba pasando? ¿También hay cámaras en el salón?"
    sca "Comment savait-il ce qui se passait ? Y a-t-il aussi des caméras dans le salon ?"

# game/scripts/c13/c13.rpy:1193
translate french c13s004_KiaraAndScarlett_af4565c7:

    # mc "Creo que la casa de tu madre tiene cámaras por todos lados..."
    mc "Je crois que la maison de ta mère est truffée de caméras..."

# game/scripts/c13/c13.rpy:1195
translate french c13s004_KiaraAndScarlett_cfc8099c:

    # mcp "{i}(Mejor no decirle que nos grabaron el domingo. Si han destruído el video, no hay de qué preocuparse.){/i}"
    mcp "{i}(Il vaut mieux ne pas leur dire que nous avons été enregistrés dimanche. S'ils ont détruit la vidéo, il n'y a pas lieu de s'inquiéter.){/i}"

# game/scripts/c13/c13.rpy:1196
translate french c13s004_KiaraAndScarlett_ce92fc45:

    # mc "Ya estamos llegando al hospital. Ahora te presento a Kiara y vamos a comer."
    mc "Nous sommes presque arrivés à l'hôpital. Je vais maintenant vous présenter Kiara, puis nous déjeunerons."

# game/scripts/c13/c13.rpy:1198
translate french c13s004_KiaraAndScarlett_b831fce0:

    # mc "Hola, Kiara. Sube."
    mc "Salut Kiara. Monte."

# game/scripts/c13/c13.rpy:1200
translate french c13s004_KiaraAndScarlett_58b194a6:

    # mc "¿Cómo ha ido? ¿Qué tal te ha tratado Sam?"
    mc "Comment ça s'est passé ? Comment Sam t'a-t-il traité ?"

# game/scripts/c13/c13.rpy:1201
translate french c13s004_KiaraAndScarlett_358f76fc:

    # kia "Mal y bien. El hematoma es señal de un pequeño desgarro muscular. Samantha ha sido un cielo, me ha dado un ungüento."
    kia "Du bon et du mauvais. L'ecchymose est le signe d'une petite déchirure musculaire. Samantha a été formidable ; elle m'a donné de la pommade."

# game/scripts/c13/c13.rpy:1202
translate french c13s004_KiaraAndScarlett_2893d567:

    # mc "Por cierto, Scarlett - Kiara, Kiara - Scarlett."
    mc "Au fait, Scarlett - Kiara, Kiara - Scarlett."

# game/scripts/c13/c13.rpy:1203
translate french c13s004_KiaraAndScarlett_32eb5c67:

    # kia "Encantada, Scarlett."
    kia "Enchantée de faire votre connaissance, Scarlett."

# game/scripts/c13/c13.rpy:1205
translate french c13s004_KiaraAndScarlett_a1ed0ab0:

    # sca "Igualmente, Kiara. Me ha dicho [mc] que somos las nuevas inquilinas. Yo también me mudo hoy."
    sca "Pareil pour moi, Kiara. Elle m'a dit qu'on était les nouvelles locataires. J'emménage aujourd'hui aussi."

# game/scripts/c13/c13.rpy:1207
translate french c13s004_KiaraAndScarlett_5287ccd9:

    # kia "¡Oh! ¿Eres la nueva estudiante? Creía que tu vuelo llegaba más tarde..."
    kia "Ah ! Tu es le nouvel étudiant ? Je croyais que ton vol était arrivé plus tard…"

# game/scripts/c13/c13.rpy:1208
translate french c13s004_KiaraAndScarlett_7bd44854:

    # mc "No, Scarlett es una amiga de la familia. Se va a mudar a la habitación de [dap]. A la estudiante la irémos a buscar después de dejarte en el trabajo."
    mc "Non, Scarlett est une amie de la famille. Elle emménage dans la chambre [dap]. Nous passerons la prendre après vous avoir déposé au travail."

# game/scripts/c13/c13.rpy:1210
translate french c13s004_KiaraAndScarlett_20e889df:

    # kia "Genial, me extrañaba que hubiera volado con tantas cajas."
    kia "Super, j'étais surpris que ça ait pu voler avec autant de cartons."

# game/scripts/c13/c13.rpy:1211
translate french c13s004_KiaraAndScarlett_0d285e83:

    # kia "No me va a dar tiempo de comer con vosotros. Voy a llegar un poco justa."
    kia "Je n'aurai pas le temps de manger avec vous. Je serai un peu pressée."

# game/scripts/c13/c13.rpy:1212
translate french c13s004_KiaraAndScarlett_7f73e754:

    # mc "Aún nos queda un rato. Conozco un sitio al lado de tu trabajo. O conocía antes de ir a la universidad... no sé si el puesto de perritos seguirá ahí."
    mc "On a encore le temps. Je connais un endroit près de ton travail. Enfin, je le connaissais avant d'aller à la fac… Je ne sais pas si le stand de hot-dogs existe toujours."

# game/scripts/c13/c13.rpy:1214
translate french c13s004_KiaraAndScarlett_7e424464:

    # kia "Sí, sigue ahí. Dejadme invitaros a comer."
    kia "Oui, il est toujours là. Je vous invite à déjeuner."

# game/scripts/c13/c13.rpy:1215
translate french c13s004_KiaraAndScarlett_0e6f0b92:

    # mc "He sido yo quién te ha dicho que te invitaría a comer, con lo que no voy a aceptar que pagues tú."
    mc "C'est moi qui t'ai proposé de t'inviter à déjeuner, donc je n'accepterai pas que tu payes."

# game/scripts/c13/c13.rpy:1216
translate french c13s004_KiaraAndScarlett_db027e54:

    # mc "Scarlett, ¿te gustan los perritos?"
    mc "Scarlett, aimes-tu les chiots ?"

# game/scripts/c13/c13.rpy:1218
translate french c13s004_KiaraAndScarlett_5233075e:

    # sca "¡Me encantan!"
    sca "Je les adore !"

# game/scripts/c13/c13.rpy:1219
translate french c13s004_KiaraAndScarlett_8758fbc0:

    # mc "Entonces no se hable más. Perritos para todos."
    mc "Voilà qui est décidé. Des chiots pour tout le monde."

# game/scripts/c13/c13.rpy:1222
translate french c13s004_KiaraAndScarlett_a94a922f:

    # "Unos perritos después..."
    "Quelques chiots plus tard..."

# game/scripts/c13/c13.rpy:1224
translate french c13s004_KiaraAndScarlett_e4c4cefc:

    # sca "Y esa es mi historia y por qué de me estoy mudando..."
    sca "Voilà mon histoire et la raison de mon déménagement..."

# game/scripts/c13/c13.rpy:1225
translate french c13s004_KiaraAndScarlett_06996d74:

    # mcp "{i}(Has hecho bien en omitir lo del video. Habría que dar muchas explicaciones a Kiara y querría hablar con Amanda antes. O con Eva.){/i}"
    mcp "{i}(Tu as bien fait de ne pas inclure la vidéo. Il y aurait beaucoup d'explications à donner à Kiara, et je préférerais d'abord parler à Amanda. Ou à Eva.){/i}"

# game/scripts/c13/c13.rpy:1227
translate french c13s004_KiaraAndScarlett_8453653e:

    # kia "Lo siento mucho, Scarlett. Yo creía que lo mío era malo, pero lo tuyo es horrible."
    kia "Je suis vraiment désolée, Scarlett. Je pensais que ce que j'avais était grave, mais ce que tu as est terrible."

# game/scripts/c13/c13.rpy:1228
translate french c13s004_KiaraAndScarlett_360b7833:

    # kia "No sé si es peor lo de Kevin o que te haya ocultado que ha estado en contacto con tu padre."
    kia "Je ne sais pas si ce qui s'est passé avec Kevin est pire, ou le fait qu'il vous ait caché avoir été en contact avec votre père."

# game/scripts/c13/c13.rpy:1229
translate french c13s004_KiaraAndScarlett_2cf9c70c:

    # mcp "(Es sorprendente lo rápido que han encajado estas dos. Las dos lo han pasado mal y a Kiara le ha salido la vena maternal y protectora en cuanto se han explicado sus historias.)"
    mcp "(C’est surprenant de voir à quelle vitesse ces deux-là se sont liées d’amitié. Elles ont toutes les deux traversé des moments difficiles, mais le côté maternel et protecteur de Kiara s’est révélé dès qu’elles ont partagé leurs histoires.)"

# game/scripts/c13/c13.rpy:1231
translate french c13s004_KiaraAndScarlett_14d8115c:

    # sca "Lo más peligroso ha sido lo de Kevin. Lo que más me ha dolido ha sido lo de mi padre."
    sca "Le plus grave, c'est ce qui est arrivé à Kevin. Ce qui m'a le plus blessé, c'est ce qui est arrivé à mon père."

# game/scripts/c13/c13.rpy:1232
translate french c13s004_KiaraAndScarlett_a1e52128:

    # sca "Ella sabe lo importante que ha sido para mí saber quién es durante todos estos años. Ocultarmelo ha sido... doloroso."
    sca "Elle sait combien il était important pour moi de savoir qui elle est toutes ces années. Me le cacher a été… douloureux."

# game/scripts/c13/c13.rpy:1234
translate french c13s004_KiaraAndScarlett_354746d2:

    # mcp "{i}(Si mis sospechas son ciertas, no tendrás que esperar mucho para saberlo, aunque sea un saco de mierda.){/i}"
    mcp "{i}(Si mes soupçons sont fondés, vous n'aurez pas à attendre longtemps pour le découvrir, même si c'est n'importe quoi.){/i}"

# game/scripts/c13/c13.rpy:1236
translate french c13s004_KiaraAndScarlett_dd9e5fa2:

    # kia "Yo podría hacer algo al respecto si la cosa se pusiera fea, pero tú lo tienes más complicado con lo de Kevin. Sin pruebas..."
    kia "Je pourrais intervenir si la situation dégénérait, mais avec Kevin, c'est plus compliqué. Sans preuves…"

# game/scripts/c13/c13.rpy:1237
translate french c13s004_KiaraAndScarlett_3222cbfa:

    # mc "Ahora solo hace falta que quieras hacerlo antes de que se ponga demasiado fea."
    mc "Il ne vous reste plus qu'à avoir envie de le faire avant que la situation ne s'aggrave."

# game/scripts/c13/c13.rpy:1239
translate french c13s004_KiaraAndScarlett_fb4a8f13:

    # kia "No insistas, [mc]. No quiero poner la denuncia. Ha sido la primera vez en 3 años, creo que se va a asustar lo suficiente con que nos hayamos marchado como para repetirlo."
    kia "N'insiste pas, [mc]. Je ne veux pas porter plainte. C'était la première fois en trois ans ; je pense que notre départ l'effrayera suffisamment pour qu'il ne recommence pas."

# game/scripts/c13/c13.rpy:1240
translate french c13s004_KiaraAndScarlett_ff89f607:

    # mc "No estoy insistiendo, Kiara. Al menos ahora tienes un informe médico por si cambias de opinión. Espero que no lo hagas demasiado tarde."
    mc "Je ne te mets pas la pression, Kiara. Au moins, tu as maintenant un rapport médical au cas où tu changerais d'avis. J'espère que tu ne le feras pas trop tard."

# game/scripts/c13/c13.rpy:1242
translate french c13s004_KiaraAndScarlett_c023c137:

    # sca "Creo que te equivocas, [mc]. Si fuera yo, presentaría la denuncia, pero Kiara tiene razón."
    sca "Je pense que tu te trompes, [mc]. Si c'était moi, je porterais plainte, mais Kiara a raison."

# game/scripts/c13/c13.rpy:1243
translate french c13s004_KiaraAndScarlett_3c49f85a:

    # sca "Pero quien pega a una mujer por norma es un cobarde. Kiara y Eileen lo han abandonado, aunque sea temporalmente, y eso le hará recapacitar."
    sca "Mais un homme qui frappe régulièrement une femme est un lâche. Kiara et Eileen l'ont quitté, même si ce n'est que temporairement, et cela le fera réfléchir."

# game/scripts/c13/c13.rpy:1244
translate french c13s004_KiaraAndScarlett_def014f3:

    # mc "Espero que tengas razón. Que la tengáis las dos."
    mc "J'espère que vous avez raison. J'espère que vous avez tous les deux raison."

# game/scripts/c13/c13.rpy:1246
translate french c13s004_KiaraAndScarlett_f1d8bdfe:

    # kia "Yo sé que la tenemos, y lo verás la semana que viene cuando volvamos a casa."
    kia "Je sais que nous l'avons, et vous le verrez la semaine prochaine à notre retour à la maison."

# game/scripts/c13/c13.rpy:1247
translate french c13s004_KiaraAndScarlett_5e10232b:

    # kia "Ahora debería ir a trabajar si no quiero llegar tarde. Muchas gracias por todo, [mc]."
    kia "Je devrais aller travailler maintenant si je ne veux pas être en retard. Merci beaucoup pour tout, [mc]."

# game/scripts/c13/c13.rpy:1248
translate french c13s004_KiaraAndScarlett_b94a64b5:

    # mc "¿Quieres que pase a buscarte cuando salgas del trabajo?"
    mc "Tu veux que je vienne te chercher quand tu sortiras du travail ?"

# game/scripts/c13/c13.rpy:1250
translate french c13s004_KiaraAndScarlett_60042da8:

    # kia "No hace falta, cogeré el autobús. Saldré tarde hoy."
    kia "Pas besoin, je prendrai le bus. Je partirai tard aujourd'hui."

# game/scripts/c13/c13.rpy:1251
translate french c13s004_KiaraAndScarlett_b3a301a0:

    # kia "Nos vemos en casa de [nor], Scarlett. Hasta luego, [mc]."
    kia "On se voit chez [nor], Scarlett. À plus tard, [mc]."

# game/scripts/c13/c13.rpy:1252
translate french c13s004_KiaraAndScarlett_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Au revoir, Kiara."

# game/scripts/c13/c13.rpy:1254
translate french c13s004_KiaraAndScarlett_3218746c:

    # sca "Nos vemos en casa, Kiara."
    sca "À bientôt à la maison, Kiara."

# game/scripts/c13/c13.rpy:1255
translate french c13s004_KiaraAndScarlett_3a775a62:

    # mcp "{i}(Enorme diferencia en la misma frase. Para Scarlett ya es su casa. Kiara lógicamente se siente como una invitada. No me importaría que se quedaran. Estarían más seguras.){/i}"
    mcp "{i}(Énorme différence dans la même phrase. Pour Scarlett, c'est déjà chez elle. Kiara se sent, à juste titre, comme une invitée. Je ne serais pas contre leur présence. Elles seraient plus en sécurité.){/i}"

# game/scripts/c13/c13.rpy:1256
translate french c13s004_KiaraAndScarlett_54150ef5:

    # mc "Siguiente parada, el aeropuerto para recoger a Saira"
    mc "Prochaine étape : l'aéroport pour récupérer Saira."

# game/scripts/c13/c13.rpy:1258
translate french c13s004_KiaraAndScarlett_b9d51006:

    # sca "¿Saira? ¿No se llamaba así tu novia de Portland? Bueno... novia... la chica con la que tenías una relación abierta..."
    sca "Saira ? C'était pas le nom de ta copine de Portland ? Enfin… copine… la fille avec qui tu avais une relation libre…"

# game/scripts/c13/c13.rpy:1259
translate french c13s004_KiaraAndScarlett_06eb7682:

    # mc "Sí, estoy seguro de que es ella. Solo me falta confirmarlo."
    mc "Oui, j'en suis sûre. Je dois juste le confirmer."

# game/scripts/c13/c13.rpy:1261
translate french c13s004_KiaraAndScarlett_cb35737c:

    # sca "¿Querrías que fuera ella?"
    sca "Souhaiteriez-vous que ce soit elle ?"

# game/scripts/c13/c13.rpy:1262
translate french c13s004_KiaraAndScarlett_a84177cf:

    # mc "Por una parte no estoy seguro. Por otra, sí, lo querría. Si no fuera ella no la reconocería y me he dejado el cartel con su nombre en casa. *Risa*"
    mc "D'un côté, je ne suis pas sûre. De l'autre, oui, je le ferais. Si ce n'était pas elle, je ne la reconnaîtrais pas, et j'ai laissé le panneau avec son nom dessus à la maison. *Rires*"

# game/scripts/c13/c13.rpy:1264
translate french c13s004_KiaraAndScarlett_7e338ccc:

    # mc "¿Te molestaría que fuera ella?"
    mc "Cela vous dérangerait-il si c'était elle ?"

# game/scripts/c13/c13.rpy:1266
translate french c13s004_KiaraAndScarlett_abb3b810:

    # sca "Por una parte sí. No saber si viene a recuperarte o no... me pondría nerviosa."
    sca "D'une certaine manière, oui. Ne pas savoir s'il va venir te chercher ou non... ça me rendrait nerveuse."

# game/scripts/c13/c13.rpy:1267
translate french c13s004_KiaraAndScarlett_1b73f7b4:

    # sca "Por otra parte, le debo estar agradecida."
    sca "D'un autre côté, je lui dois ma gratitude."

# game/scripts/c13/c13.rpy:1268
translate french c13s004_KiaraAndScarlett_ce705018:

    # mc "¿Qué? ¿Por qué?"
    mc "Quoi ? Pourquoi ?"

# game/scripts/c13/c13.rpy:1271
translate french c13s004_KiaraAndScarlett_82bd8710:

    # sca "Por meterte en esa cabezota tuya la idea de las relaciones abiertas o con más de una chica."
    sca "Pour t'être mis en tête l'idée de relations libres ou de relations avec plus d'une fille."

# game/scripts/c13/c13.rpy:1273
translate french c13s004_KiaraAndScarlett_17f694d7:

    # sca "No me gustaría tener que competir con [dap] por la exclusividad."
    sca "Je ne voudrais pas avoir à rivaliser avec [dap] pour l'exclusivité."

# game/scripts/c13/c13.rpy:1275
translate french c13s004_KiaraAndScarlett_75d06d6d:

    # sca "Si solo quisieras estar con una chica yo tendría menos oportunidades de ser la elegida."
    sca "Si tu ne voulais être qu'avec une seule fille, j'aurais moins de chances d'être choisie."

# game/scripts/c13/c13.rpy:1277
translate french c13s004_KiaraAndScarlett_69fa4c89:

    # sca "Por dejarte marchar sin asegurar la relación. Si no fuera por eso, difícilmente estaríamos juntos ahora."
    sca "Pour t'avoir laissé partir sans consolider notre relation. Sans ça, nous ne serions probablement plus ensemble aujourd'hui."

# game/scripts/c13/c13.rpy:1278
translate french c13s004_KiaraAndScarlett_deb508bd:

    # mc "Tienes razón. La situación sería muy diferente si no fuera por ella."
    mc "Vous avez raison. La situation serait très différente sans elle."

# game/scripts/c13/c13.rpy:1279
translate french c13s004_KiaraAndScarlett_425e57ba:

    # mc "Ya que estamos hablando de Saira, ¿cómo quieres que te presente? ¿Amiga? ¿Novia?"
    mc "Puisqu'on parle de Saira, comment veux-tu que je te la présente ? Amie ? Petite amie ?"

# game/scripts/c13/c13.rpy:1281
translate french c13s004_KiaraAndScarlett_739cb058:

    # sca "¡Novia, por supuesto! Si quieres hacerlo público claro..."
    sca "Ma copine, bien sûr ! Si tu veux le rendre public, pas de problème..."

# game/scripts/c13/c13.rpy:1282
translate french c13s004_KiaraAndScarlett_c38fe74d:

    # mc "Entonces será novia."
    mc "Alors elle sera ma petite amie."

# game/scripts/c13/c13.rpy:1285
translate french c13s004_KiaraAndScarlett_b5aa0bb2:

    # sca "¿Vamos? Tengo ganas de conocerla."
    sca "On y va ? J'adorerais la rencontrer."

# game/scripts/c13/c13.rpy:1327
translate french c13s004_GetSaira_581ae97d:

    # mc "Vamos a quedarnos sentados aquí un momento, Scarlett. Hay un tema que quiero hablar contigo."
    mc "Asseyons-nous un instant, Scarlett. Il y a quelque chose dont je veux te parler."

# game/scripts/c13/c13.rpy:1328
translate french c13s004_GetSaira_5cc848a0:

    # sca "De golpe estás sonando muy serio, [mc]. ¿Pasa algo?"
    sca "Tu as soudain l'air très sérieux, [mc]. Y a-t-il un problème ?"

# game/scripts/c13/c13.rpy:1329
translate french c13s004_GetSaira_c84d738d:

    # mc "Bueno, hay algo que quiero comentarte."
    mc "Eh bien, il y a quelque chose que je veux vous dire."

# game/scripts/c13/c13.rpy:1331
translate french c13s004_GetSaira_1729258b:

    # sca "Me estás preocupando. ¿He hecho algo malo?"
    sca "Tu m'inquiètes. Ai-je fait quelque chose de mal ?"

# game/scripts/c13/c13.rpy:1332
translate french c13s004_GetSaira_354b54b1:

    # mc "¿Tú? ¡No! Quiero hacerte unas preguntas sobre el tema de tu padre."
    mc "Vous ? Non ! Je veux vous poser quelques questions sur votre père."

# game/scripts/c13/c13.rpy:1334
translate french c13s004_GetSaira_b56d3f60:

    # sca "Bueno, después de lo que me ha dicho mi madre esta mañana, dudo que nunca le saque la verdad sobre quién es."
    sca "Après ce que ma mère m'a dit ce matin, je doute que je parvienne un jour à lui soutirer la vérité sur sa véritable identité."

# game/scripts/c13/c13.rpy:1335
translate french c13s004_GetSaira_8dd63e25:

    # sca "¿Puedes creerte que ha estado en contacto con él todo este tiempo? ¿Recibiendo dinero de él? ¿Y ocultándomelo?"
    sca "Tu te rends compte qu'elle a été en contact avec lui tout ce temps ? Qu'elle a reçu de l'argent de sa part ? Et qu'elle me l'a caché ?"

# game/scripts/c13/c13.rpy:1336
translate french c13s004_GetSaira_bd5ea149:

    # mc "Tu madre me ha parecido un poco... no quiero ser ofensivo ni molestarte, al fin y al cabo es tu madre."
    mc "Votre mère semblait un peu... Je ne veux pas vous offenser ni vous contrarier, après tout, c'est votre mère."

# game/scripts/c13/c13.rpy:1338
translate french c13s004_GetSaira_a383464e:

    # sca "Puedes decir lo que quieras. No me voy a ofender aunque la llames despreciable. Ahora mismo es la palabra que me viene a la mente. Estoy muy enfadada con ella."
    sca "Tu peux dire ce que tu veux. Je ne m'offenserai pas, même si tu la traites d'odieuse. C'est le premier mot qui me vient à l'esprit. Je suis furieuse contre elle."

# game/scripts/c13/c13.rpy:1339
translate french c13s004_GetSaira_5e488d70:

    # mc "Me ha parecido muy fuerte que dijera que le habías destrozado la vida, y que lo siguiente de lo que hablara fuera del dinero de tu padre..."
    mc "J'ai trouvé très perturbant qu'elle dise que vous aviez gâché sa vie, et qu'ensuite elle parle de l'argent de votre père..."

# game/scripts/c13/c13.rpy:1341
translate french c13s004_GetSaira_725ec96e:

    # sca "Aunque no tiene disculpa, casi la entiendo. Para ella el dinero es muy importante. Mis abuelos no quisieron ayudarla cuando se quedó embarazada de mí."
    sca "Bien qu'elle n'ait aucune excuse, je la comprends presque. L'argent est très important pour elle. Mes grands-parents ont refusé de l'aider lorsqu'elle est tombée enceinte de moi."

# game/scripts/c13/c13.rpy:1342
translate french c13s004_GetSaira_edc402e2:

    # sca "Pasó de estar a punto de ir a Yale con una beca a tener que irse de casa y buscarse la vida trabajando de camarera en un bar cutre, viviendo de las propinas..."
    sca "Elle est passée de l'obtention d'une bourse pour intégrer Yale à l'obligation de quitter son domicile et de gagner sa vie comme serveuse dans un bar miteux, vivant des pourboires..."

# game/scripts/c13/c13.rpy:1343
translate french c13s004_GetSaira_9836f015:

    # sca "Mis abuelos cambiaron de opinión cuando nací, pero ella no quiso volver. La relación ya estaba muy dañada entre ellos. Solo veía a mis abuelos en los cumpleaños, Acción de Gracias, Navidad..."
    sca "Mes grands-parents ont changé d'avis à ma naissance, mais ma grand-mère ne voulait pas revenir. Leur relation était déjà très tendue. Je ne voyais mes grands-parents que pour les anniversaires, Thanksgiving, Noël…"

# game/scripts/c13/c13.rpy:1344
translate french c13s004_GetSaira_829877c6:

    # mc "Pero parece que no vivía solo de las propinas, sino también del dinero que tu padre le enviaba."
    mc "Mais il semble qu'il ne vivait pas uniquement de pourboires, mais aussi de l'argent que votre père lui envoyait."

# game/scripts/c13/c13.rpy:1346
translate french c13s004_GetSaira_e0feaea1:

    # sca "Sí, eso parece. Una mentira más que sumar a la larga lista de mentiras que ha contado sobre él. Si al menos supiera quién es..."
    sca "Oui, il semblerait bien. Encore un mensonge de plus à ajouter à la longue liste de ceux qu'elle a racontés à son sujet. Si seulement je savais qui il était vraiment…"

# game/scripts/c13/c13.rpy:1347
translate french c13s004_GetSaira_b524c179:

    # mc "Me parece que ha dicho alguna mentira más sobre el tema, como que ha dejado de mandar dinero por que ya tenías 18."
    mc "Je pense qu'il a menti à d'autres reprises à ce sujet, notamment en disant qu'il avait arrêté d'envoyer de l'argent parce que tu avais déjà 18 ans."

# game/scripts/c13/c13.rpy:1349
translate french c13s004_GetSaira_6be23cd0:

    # sca "¿Por qué dices eso?"
    sca "Pourquoi dites-vous cela ?"

# game/scripts/c13/c13.rpy:1350
translate french c13s004_GetSaira_8ab0fcb9:

    # mc "Si te dijera que es posible que tenga una pista, que podrías encontrar a tu otra familia... ¿querrías seguirla?"
    mc "Si je vous disais que j'ai peut-être une piste, que vous pourriez retrouver votre autre famille… auriez-vous envie de la suivre ?"

# game/scripts/c13/c13.rpy:1352
translate french c13s004_GetSaira_8060518a:

    # sca "{b}¿Qué?{/b} ¡Por supuesto que querría!"
    sca "{b}Quoi ?{/b} Bien sûr que oui !"

# game/scripts/c13/c13.rpy:1353
translate french c13s004_GetSaira_07bd5463:

    # sca "¿De dónde has sacado la información?"
    sca "Où avez-vous trouvé ces informations ?"

# game/scripts/c13/c13.rpy:1354
translate french c13s004_GetSaira_b5ca3c26:

    # mc "Antes de responderte, déjame darte algunos datos. No es tan sencillo."
    mc "Avant de vous répondre, permettez-moi de vous donner quelques informations. Ce n'est pas si simple."

# game/scripts/c13/c13.rpy:1356
translate french c13s004_GetSaira_51d8a628:

    # sca "¿Que puede haber de complicado? Una prueba de ADN resolvería las dudas..."
    sca "Qu'est-ce qui pourrait être si compliqué ? Un test ADN lèverait tous les doutes…"

# game/scripts/c13/c13.rpy:1357
translate french c13s004_GetSaira_bbde9e61:

    # mc "Lo complicado es que tu posible padre no está disponible para hacer una prueba de ADN. Pero déjame explicarte lo que sé."
    mc "Le problème, c'est que votre père potentiel n'est pas disponible pour un test ADN. Mais laissez-moi vous expliquer ce que je sais."

# game/scripts/c13/c13.rpy:1359
translate french c13s004_GetSaira_d376aa84:

    # "Explicas a Scarlett la conversación de ayer con tu padre, sin decirle que es tu padre, y las pistas que dejó caer sobre la identidad de tu medio hermana."
    "Vous expliquez à Scarlett la conversation d'hier avec votre père, sans lui dire qu'il est votre père, et les indices qu'il a laissés concernant l'identité de votre demi-sœur."

# game/scripts/c13/c13.rpy:1360
translate french c13s004_GetSaira_e1e23ff8:

    # mc "Y eso es todo lo que sé."
    mc "Et c'est tout ce que je sais."

# game/scripts/c13/c13.rpy:1361
translate french c13s004_GetSaira_1b7cc215:

    # sca "Tengo que ser yo. 18 años, segunda de mi clase, empiezo medicina en la NWU, la matrícula está pagada, y ha enviado dinero a mi madre."
    sca "Ça doit être moi. 18 ans, deuxième de ma promotion, je commence mes études de médecine à NWU, mes frais de scolarité sont payés et j'ai envoyé de l'argent à ma mère."

# game/scripts/c13/c13.rpy:1362
translate french c13s004_GetSaira_7c813b7c:

    # mc "Ese último dato es el que me ha hecho atar cabos. Estaba bastante seguro de que podías ser tú, pero al decir tu madre lo del dinero casi ha confirmado mis sospechas."
    mc "C'est ce dernier détail qui m'a permis de faire le lien. J'étais presque sûre que ça pouvait être toi, mais quand ta mère a mentionné l'argent, ça a quasiment confirmé mes soupçons."

# game/scripts/c13/c13.rpy:1364
translate french c13s004_GetSaira_99b10dd5:

    # sca "Pero hay una cosa que no entiendo. ¿Por qué ese hombre, mi posible padre, te lo contó a ti?"
    sca "Mais il y a une chose que je ne comprends pas. Pourquoi cet homme, mon père potentiel, vous l'a-t-il dit ?"

# game/scripts/c13/c13.rpy:1366
translate french c13s004_GetSaira_081cc96b:

    # sca "A menos que..."
    sca "Sauf si..."

# game/scripts/c13/c13.rpy:1369
translate french c13s004_GetSaira_5a3e2bb4:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano... no ahora..."
    sca "Ce n'est pas possible, n'est-ce pas ? Tu n'es pas mon demi-frère… pas maintenant…"

# game/scripts/c13/c13.rpy:1371
translate french c13s004_GetSaira_fa962ca9:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano..."
    sca "Ce n'est pas possible, n'est-ce pas ? Tu n'es pas mon demi-frère..."

# game/scripts/c13/c13.rpy:1372
translate french c13s004_GetSaira_7caf724b:

    # mc "Podría ser. Engañó a mi madre y las fechas coinciden, pero deberíamos confirmarlo antes de..."
    mc "C'est possible. Il a trompé ma mère et les dates correspondent, mais il vaut mieux le vérifier avant..."

# game/scripts/c13/c13.rpy:1374
translate french c13s004_GetSaira_d697b07d:

    # sca "¡Eres mi hermano!"
    sca "Tu es mon frère !"

# game/scripts/c13/c13.rpy:1375
translate french c13s004_GetSaira_83726347:

    # mc "Scarlett, no. No lo sabemos todavía. Podría ser una chica de Westport que estudie medicina en la NWU. Tenemos que confirmarlo antes..."
    mc "Scarlett, non. On ne sait pas encore. Il pourrait s'agir d'une fille de Westport qui étudie la médecine à NWU. Il faut d'abord le vérifier…"

# game/scripts/c13/c13.rpy:1377
translate french c13s004_GetSaira_923be1b9:

    # sca "Tienes razón. Siempre pensé que quería encontrar a mi padre. Mi madre me dijo que estaba casado, pero ha mentido tanto que nunca pensé en si tendría hermanos."
    sca "Tu as raison. J'ai toujours pensé vouloir retrouver mon père. Ma mère m'a dit qu'il était marié, mais elle a tellement menti que je ne me suis jamais demandé si j'avais des frères et sœurs."

# game/scripts/c13/c13.rpy:1378
translate french c13s004_GetSaira_376156d1:

    # mc "O primas... si mis sospechas son ciertas puede que tengas una gran familia."
    mc "Oh, mes cousins… si mes soupçons sont fondés, vous avez peut-être une famille nombreuse."

# game/scripts/c13/c13.rpy:1381
translate french c13s004_GetSaira_fce75663:

    # sca "Y esto... ¿cómo nos deja a nosotros?"
    sca "Et ceci… où cela nous mène-t-il ?"

# game/scripts/c13/c13.rpy:1382
translate french c13s004_GetSaira_c8070494:

    # mc "Hasta que no tengamos confirmación, igual que estamos. No quiero actuar en base a suposiciones."
    mc "En attendant confirmation, nous maintenons la situation en l'état. Je ne souhaite pas agir sur la base de suppositions."

# game/scripts/c13/c13.rpy:1384
translate french c13s004_GetSaira_17ac4da4:

    # sca "Pero... ¿Y si somos...?"
    sca "Mais... et si nous l'étions...?"

# game/scripts/c13/c13.rpy:1385
translate french c13s004_GetSaira_0a02d0f5:

    # mc "¿Y si no somos...?"
    mc "Et si nous ne l'étions pas...?"

# game/scripts/c13/c13.rpy:1386
translate french c13s004_GetSaira_98e2c246:

    # mc "Acabamos de empezar a salir. No pienso romper contigo porque tengamos sospechas de que eres mi hermana."
    mc "On vient de commencer à sortir ensemble. Je ne vais pas te quitter juste parce qu'on soupçonne que tu es ma sœur."

# game/scripts/c13/c13.rpy:1388
translate french c13s004_GetSaira_c2d875b1:

    # mc "Y aunque lo seas, tampoco pienso hacerlo."
    mc "Et même si vous l'êtes, je n'ai toujours pas l'intention de le faire."

# game/scripts/c13/c13.rpy:1390
translate french c13s004_GetSaira_435afb91:

    # mc "Y si lo eres, ya hablaremos de ello."
    mc "Et si c'est le cas, nous en reparlerons plus tard."

# game/scripts/c13/c13.rpy:1393
translate french c13s004_GetSaira_bb4b8800:

    # sca "Suponía que esas cosas no te importaban... también sales con [dap]."
    sca "Je supposais que ces choses-là n'avaient pas d'importance pour toi... tu sors aussi avec [dap]."

# game/scripts/c13/c13.rpy:1394
translate french c13s004_GetSaira_fc6ab40b:

    # mc "Bueno, sobre eso es algo que deberemos hablar [dap] y yo. A ella parece no importarle y..."
    mc "Eh bien, c'est quelque chose dont [dap] et moi devrons parler. Ça ne semble pas la déranger et..."

# game/scripts/c13/c13.rpy:1396
translate french c13s004_GetSaira_bd91776e:

    # sca "A mí tampoco me importaría..."
    sca "Ça ne me dérangerait pas non plus..."

# game/scripts/c13/c13.rpy:1399
translate french c13s004_GetSaira_d264df90:

    # sca "A mí no me importaría..."
    sca "Ça ne me dérangerait pas..."

# game/scripts/c13/c13.rpy:1400
translate french c13s004_GetSaira_cf7e0ea3:

    # mc "Entonces ya lo hablaremos si tenemos confirmación positiva. Y si es negativa, no habrá nada de lo que hablar. Primero habrá que confirmar si somos familia."
    mc "Nous en reparlerons si nous obtenons une confirmation positive. Si elle est négative, il n'y a rien à dire. Il nous faut d'abord confirmer si nous sommes apparentés."

# game/scripts/c13/c13.rpy:1403
translate french c13s004_GetSaira_72180089:

    # sca "¿Te imaginas que [dap] y yo fueramos primas? Ya casi es como una hermana para mí y..."
    sca "Tu imagines si [dap] et moi étions cousines ? Elle est presque comme une sœur pour moi maintenant et..."

# game/scripts/c13/c13.rpy:1405
translate french c13s004_GetSaira_8077d522:

    # sca "¡[emm] sería mi hermana también!"
    sca "Elle serait aussi ma sœur !"

# game/scripts/c13/c13.rpy:1406
translate french c13s004_GetSaira_b39954e4:

    # mc "Supongo que debes estar en shock ahora mismo. *Risa* No es típico de ti tardar tanto en darte cuenta de algo."
    mc "J'imagine que vous devez être sous le choc. *Rires* Ce n'est pas votre genre de mettre autant de temps à comprendre quelque chose."

# game/scripts/c13/c13.rpy:1408
translate french c13s004_GetSaira_46981cf6:

    # sca "Son muchas cosas que asimilar..."
    sca "Il y a beaucoup de choses à assimiler..."

# game/scripts/c13/c13.rpy:1409
translate french c13s004_GetSaira_a8a85577:

    # mc "Es normal, Scarlett. Ayer yo estaba igual que tú ahora mismo."
    mc "C'est normal, Scarlett. Hier, j'étais exactement comme toi en ce moment."

# game/scripts/c13/c13.rpy:1410
translate french c13s004_GetSaira_ebdb400b:

    # mc "Escucha, creo que deberías tomarte un tiempo para pensar. El vuelo de Saira llega en un rato y deberíamos ir al aeropuerto."
    mc "Écoute, je pense que tu devrais prendre le temps de réfléchir. L'avion de Saira arrive dans quelques minutes, et nous devrions aller à l'aéroport."

# game/scripts/c13/c13.rpy:1412
translate french c13s004_GetSaira_6ac64992:

    # sca "Entonces vamos a por ella. Creo que tenemos que hablar de esto sin interrupciones cuando haya tenido tiempo de asimilarlo y..."
    sca "Alors, passons aux choses sérieuses. Je pense qu'il nous faut en parler sans interruption, une fois que j'aurai eu le temps de digérer tout ça et…"

# game/scripts/c13/c13.rpy:1413
translate french c13s004_GetSaira_dee69572:

    # mc "Solo una cosa más, Scarlett. De momento no se lo digas a nadie. Nadie sabe que he estado hablando con mi padre ni lo que me ha dicho. Me gustaría explicarlo cuando sea el momento."
    mc "Une dernière chose, Scarlett. N'en parle à personne pour l'instant. Personne ne sait que j'ai parlé à mon père ni ce qu'il a dit. Je t'expliquerai tout au moment opportun."

# game/scripts/c13/c13.rpy:1414
translate french c13s004_GetSaira_b581a03d:

    # sca "Lo entiendo, aunque me moriré de ganas de decírselo a [dap]."
    sca "Je comprends, même si j'ai très envie de le dire à [dap]."

# game/scripts/c13/c13.rpy:1417
translate french c13s004_GetSaira_63cd8ebd:

    # mc "Vamos."
    mc "Allez."

# game/scripts/c13/c13.rpy:1419
translate french c13s004_GetSaira_f645e946:

    # "Llegáis al aeropuerto justo a tiempo después de pillar un pequeño atasco. Los carteles indican que el vuelo de Saira ha aterrizado hace unos minutos."
    "Vous arrivez à l'aéroport juste à temps après avoir été coincé dans un léger embouteillage. Les panneaux indiquent que l'avion de Saira a atterri il y a quelques minutes."

# game/scripts/c13/c13.rpy:1426
translate french c13s004_GetSaira_dc468c0e:

    # "Unos minutos después aparece Saira y te levantas a recibirla."
    "Quelques minutes plus tard, Saira apparaît et vous vous levez pour la saluer."

# game/scripts/c13/c13.rpy:1427
translate french c13s004_GetSaira_70587128:

    # sai "¡Sorpresa! *Risa*"
    sai "Surprise ! *Rires*"

# game/scripts/c13/c13.rpy:1428
translate french c13s004_GetSaira_1b2b8d9e:

    # mc "*Risa* Casi... la estropeaste al no colgar la video conferencia."
    mc "*Rires* Tu as failli... tout gâcher en ne raccrochant pas la visioconférence."

# game/scripts/c13/c13.rpy:1430
translate french c13s004_GetSaira_7e60ab7b:

    # sai "Maldición... ¿cuanto oíste?"
    sai "Mince alors… tu as entendu quoi ?"

# game/scripts/c13/c13.rpy:1431
translate french c13s004_GetSaira_7d42c0a8:

    # mc "Todo hasta que colgaste."
    mc "Tout s'est passé jusqu'à ce que tu raccroches."

# game/scripts/c13/c13.rpy:1433
translate french c13s004_GetSaira_6226e373:

    # sai "No pienses mal, no pienso todo lo que dije..."
    sai "Ne vous méprenez pas, je ne pense pas tout ce que j'ai dit..."

# game/scripts/c13/c13.rpy:1434
translate french c13s004_GetSaira_4319860b:

    # mc "No te preocupes, sé que puedes ser más ladradora que mordedora."
    mc "Ne t'inquiète pas, je sais que tu fais plus de bruit que de mal."

# game/scripts/c13/c13.rpy:1436
translate french c13s004_GetSaira_6e42d010:

    # sai "¿No me vas a dar un beso de bienvenida?"
    sai "Tu ne vas pas me donner un baiser de bienvenue ?"

# game/scripts/c13/c13.rpy:1450
translate french qKissSairaArrival_06face9f:

    # "Vuestros labios se juntan en un beso que tiene mucha inseguridad detrás. Ninguno de los dos sabe cómo va a reaccionar el otro."
    "Vos lèvres se rencontrent dans un baiser empreint d'incertitude. Aucun de vous deux ne sait comment l'autre va réagir."

# game/scripts/c13/c13.rpy:1452
translate french qKissSairaArrival_16332bdc:

    # "El beso dura un segundo, es tiempo más que suficiente para borrar el mes y medio que habéis estado separados y dejaros donde estábais... casi."
    "Le baiser dure une seconde, c'est largement suffisant pour effacer le mois et demi que vous avez passé séparés et vous laisser là où vous en étiez... ou presque."

# game/scripts/c13/c13.rpy:1454
translate french qKissSairaArrival_b4b72dc3:

    # "El beso dura un segundo, es tiempo más que suficiente para borrar el mes y medio que habéis estado separados y dejaros donde estábais."
    "Le baiser dure une seconde, c'est largement suffisant pour effacer le mois et demi que vous avez passé séparés et vous laisser là où vous en étiez."

# game/scripts/c13/c13.rpy:1457
translate french qKissSairaArrival_14f7cf78:

    # sca "¡Ejem!"
    sca "Ahem !"

# game/scripts/c13/c13.rpy:1460
translate french qKissSairaArrival_c7def988:

    # "No es el beso que Saira espera y su cuerpo se tensa por un momento. Tienes que hablar con ella antes de pensar en retomar lo vuestro."
    "Ce n'est pas le baiser que Saira attendait, et son corps se tend un instant. Tu dois lui parler avant même d'envisager de vous remettre ensemble."

# game/scripts/c13/c13.rpy:1462
translate french qKissSairaArrival_58642bce:

    # "Vuestra relación abierta sería mucho más abierta ahora. Tiene que saberlo antes de que piense que vuelves a ser suyo en exclusiva."
    "Votre relation libre serait bien plus transparente maintenant. Il a besoin de le savoir avant de te considérer à nouveau comme sa seule et unique partenaire."

# game/scripts/c13/c13.rpy:1465
translate french qKissSairaArrival_14f7cf78_1:

    # sca "¡Ejem!"
    sca "Ahem !"

# game/scripts/c13/c13.rpy:1466
translate french qKissSairaArrival_9e1cfa9a:

    # mc "Ven, Saira, voy a presentarte a..."
    mc "Viens, Saira, je vais te présenter à..."

# game/scripts/c13/c13.rpy:1468
translate french qKissSairaArrival_af2a5db8:

    # sai "¿Esa es Eileen? Creía que era pelirroja..."
    sai "C'est Eileen ? Je croyais qu'elle était rousse..."

# game/scripts/c13/c13.rpy:1469
translate french qKissSairaArrival_044428f8:

    # mc "No, no es Eileen. A Eileen la conocerás hoy. Está viviendo en casa."
    mc "Non, ce n'est pas Eileen. Vous rencontrerez Eileen aujourd'hui. Elle habite chez ses parents."

# game/scripts/c13/c13.rpy:1471
translate french qKissSairaArrival_7ec8ff1d:

    # sai "{b}¿QUÉ?{/b}"
    sai "{b}QUOI ?{/b}"

# game/scripts/c13/c13.rpy:1472
translate french qKissSairaArrival_5f7bfb38:

    # mc "Es largo de contar, ven."
    mc "C'est une longue histoire, allez."

# game/scripts/c13/c13.rpy:1479
translate french qKissSairaArrival_316bd3d0:

    # mc "Saira, esta es Scarlett, una de las chicas con las que salgo."
    mc "Saira, voici Scarlett, une des filles avec qui je sors."

# game/scripts/c13/c13.rpy:1481
translate french qKissSairaArrival_199e2902:

    # mc "Saira, esta es Scarlett. Mi otra novia, aparte de ti, si es que quieres volver conmigo, claro."
    mc "Saira, voici Scarlett. Mon autre petite amie, à part toi, si tu veux bien sûr qu'on se remette ensemble."

# game/scripts/c13/c13.rpy:1483
translate french qKissSairaArrival_a7ade38d:

    # mc "Saira, esta es Scarlett. Mi novia."
    mc "Saira, voici Scarlett. Ma copine."

# game/scripts/c13/c13.rpy:1484
translate french qKissSairaArrival_54656e74:

    # mc "Hoy se muda a casa también."
    mc "Aujourd'hui, elle aussi rentre chez elle."

# game/scripts/c13/c13.rpy:1485
translate french qKissSairaArrival_5052557b:

    # sca "Encantada, Saira."
    sca "Enchantée de faire votre connaissance, Saira."

# game/scripts/c13/c13.rpy:1487
translate french qKissSairaArrival_53597df5:

    # sai "¿Qué? ¿Estás saliendo con... con... ella?"
    sai "Quoi ? Tu sors avec... elle ?"

# game/scripts/c13/c13.rpy:1488
translate french qKissSairaArrival_379a2e0c:

    # sai "¿Y Eileen?"
    sai "Et Eileen ?"

# game/scripts/c13/c13.rpy:1490
translate french qKissSairaArrival_03867090:

    # mc "Sí, con Eileen también."
    mc "Oui, avec Eileen aussi."

# game/scripts/c13/c13.rpy:1492
translate french qKissSairaArrival_2879c609:

    # sca "¿Qué? ¿Sales con Eileen?" (multiple=2)
    sca "Quoi ? Tu sors avec Eileen ?" (multiple=2)

# game/scripts/c13/c13.rpy:1493
translate french qKissSairaArrival_cf5bc89f:

    # sai "¿Qué? ¿Ya has vuelto con ella?" (multiple=2)
    sai "Quoi ? Tu es déjà de nouveau avec elle ?" (multiple=2)

# game/scripts/c13/c13.rpy:1494
translate french qKissSairaArrival_401e46a3:

    # mc "Sí. No te sorprendas tanto, Scarlett. Tengo su autorización para hacerlo público."
    mc "Oui. Ne sois pas si surprise, Scarlett. J'ai son autorisation pour le rendre public."

# game/scripts/c13/c13.rpy:1495
translate french qKissSairaArrival_201ed9a3:

    # mc "Saira, tú y yo teníamos una relación abierta que no lo era en la práctica. Ahora tengo una que lo es."
    mc "Saira, nous avions une relation libre qui, en réalité, ne l'était pas vraiment. Maintenant, j'en ai une qui l'est."

# game/scripts/c13/c13.rpy:1497
translate french qKissSairaArrival_5eb913b8:

    # sai "Pero... pero... yo me he transferido por ti..."
    sai "Mais... mais... j'ai changé de poste à cause de toi..."

# game/scripts/c13/c13.rpy:1498
translate french qKissSairaArrival_bf5788bd:

    # mc "No creo que sea el mejor momento para hablarlo, Saira. Creo que te lo tengo que explicar en privado."
    mc "Je ne pense pas que ce soit le meilleur moment pour en parler, Saira. Je crois que je dois te l'expliquer en privé."

# game/scripts/c13/c13.rpy:1499
translate french qKissSairaArrival_f80cfb49:

    # mc "No te ofendas, Scarlett."
    mc "Ne te vexe pas, Scarlett."

# game/scripts/c13/c13.rpy:1501
translate french qKissSairaArrival_694f0dbc:

    # sca "No, no me ofendo. Ahora mismo estoy demasiado flipada..."
    sca "Non, je ne suis pas offensé. Je suis juste trop excité en ce moment..."

# game/scripts/c13/c13.rpy:1503
translate french qKissSairaArrival_f470a308:

    # mc "No, Eileen y yo solo somos buenos amigos."
    mc "Non, Eileen et moi sommes juste de bonnes amies."

# game/scripts/c13/c13.rpy:1505
translate french qKissSairaArrival_cb2c5f5f:

    # mc "Saira, esta es Scarlett, una amiga. También va a vivir en casa."
    mc "Saira, voici Scarlett, une amie. Elle va aussi habiter chez nous."

# game/scripts/c13/c13.rpy:1506
translate french qKissSairaArrival_a1f01b1d:

    # sca "Un placer conocerte, Saira."
    sca "Enchantée de faire votre connaissance, Saira."

# game/scripts/c13/c13.rpy:1508
translate french qKissSairaArrival_c1265b7a:

    # sai "Igualmente, Scarlett. Por un momento he pensado que eras Eileen."
    sai "Moi aussi, Scarlett. Un instant, j'ai cru que tu étais Eileen."

# game/scripts/c13/c13.rpy:1509
translate french qKissSairaArrival_f69671ca:

    # sai "Por suerte, [mc] tiene el suficiente tacto como para no venir con su {b}ex{/b}-novia del instituto a buscar a su novia de la universidad."
    sai "Heureusement, [mc] a assez de tact pour ne pas venir avec son {b}ex{/b}-petite amie du lycée à la recherche de sa petite amie de l'université."

# game/scripts/c13/c13.rpy:1511
translate french qKissSairaArrival_73039573:

    # mc "Bueno, Eileen ya no es una ex-novia."
    mc "Eh bien, Eileen n'est plus une ex-petite amie."

# game/scripts/c13/c13.rpy:1513
translate french qKissSairaArrival_2879c609_1:

    # sca "¿Qué? ¿Sales con Eileen?" (multiple=2)
    sca "Quoi ? Tu sors avec Eileen ?" (multiple=2)

# game/scripts/c13/c13.rpy:1514
translate french qKissSairaArrival_cf5bc89f_1:

    # sai "¿Qué? ¿Ya has vuelto con ella?" (multiple=2)
    sai "Quoi ? Tu es déjà de nouveau avec elle ?" (multiple=2)

# game/scripts/c13/c13.rpy:1515
translate french qKissSairaArrival_401e46a3_1:

    # mc "Sí. No te sorprendas tanto, Scarlett. Tengo su autorización para hacerlo público."
    mc "Oui. Ne sois pas si surprise, Scarlett. J'ai son autorisation pour le rendre public."

# game/scripts/c13/c13.rpy:1516
translate french qKissSairaArrival_67c1ae2d:

    # mc "Saira, tú y yo teníamos una relación abierta. Nunca quisiste ser mi novia..."
    mc "Saira, nous avions une relation libre. Tu n'as jamais voulu être ma petite amie..."

# game/scripts/c13/c13.rpy:1518
translate french qKissSairaArrival_5eb913b8_1:

    # sai "Pero... pero... yo me he transferido por ti..."
    sai "Mais... mais... j'ai changé de poste à cause de toi..."

# game/scripts/c13/c13.rpy:1519
translate french qKissSairaArrival_72245ce0:

    # mc "No creo que sea el mejor momento para hablarlo, Saira. Creo que deberíamos hablarlo en privado."
    mc "Je ne pense pas que ce soit le bon moment pour en parler, Saira. Je pense que nous devrions en discuter en privé."

# game/scripts/c13/c13.rpy:1520
translate french qKissSairaArrival_f80cfb49_1:

    # mc "No te ofendas, Scarlett."
    mc "Ne te vexe pas, Scarlett."

# game/scripts/c13/c13.rpy:1522
translate french qKissSairaArrival_694f0dbc_1:

    # sca "No, no me ofendo. Ahora mismo estoy demasiado flipada..."
    sca "Non, je ne suis pas offensé. Je suis juste trop excité en ce moment..."

# game/scripts/c13/c13.rpy:1524
translate french qKissSairaArrival_76e776ff:

    # mc "No, Eileen está trabajando ahora mismo, pero tiene ganas de conocerte."
    mc "Non, Eileen travaille en ce moment, mais elle se réjouit de vous rencontrer."

# game/scripts/c13/c13.rpy:1525
translate french qKissSairaArrival_7c1a38a3:

    # mc "¿Tienes que recoger maletas, Saira?"
    mc "Tu dois faire tes valises, Saira ?"

# game/scripts/c13/c13.rpy:1527
translate french qKissSairaArrival_737749c5:

    # sai "No, va todo en el camión con los muebles y el resto de cosas. Debería haber llegado durante la mañana, salió ayer de Portland."
    sai "Non, tout est dans le camion avec les meubles et le reste des affaires. Il aurait dû arriver ce matin ; il est parti de Portland hier."

# game/scripts/c13/c13.rpy:1528
translate french qKissSairaArrival_514fa989:

    # mc "Entonces vamos a casa, he salido pronto y no sé si ha llegado."
    mc "Rentrons donc à la maison, je suis partie tôt et je ne sais pas s'il est arrivé."

# game/scripts/c13/c13.rpy:1529
translate french qKissSairaArrival_b5707087:

    # mc "Además, tengo que descargar las cosas de Scarlett antes de ir a ver a la enfermera."
    mc "De plus, je dois télécharger les affaires de Scarlett avant d'aller voir l'infirmière."

# game/scripts/c13/c13.rpy:1531
translate french qKissSairaArrival_ada8f6b1:

    # sca "¿La que ha atendido a Kiara?"
    sca "Celui qui a soigné Kiara ?"

# game/scripts/c13/c13.rpy:1533
translate french qKissSairaArrival_fc5b29c2:

    # mc "Sí, Samantha, la madre de Jamaal. Tengo que pasar a verla esta tarde. ¿Vamos?"
    mc "Oui, Samantha, la mère de Jamaal. Je dois passer la voir cet après-midi. On y va ?"

# game/scripts/c13/c13.rpy:1539
translate french qKissSairaArrival_45b59a25:

    # "El camino a casa es incómodo, quizás no ha sido una buena idea besar a Saira delante de Scarlett y después presentarla como tu novia."
    "Le retour à la maison est gênant ; peut-être que ce n'était pas une si bonne idée d'embrasser Saira devant Scarlett et de la présenter ensuite comme ta petite amie."

# game/scripts/c13/c13.rpy:1542
translate french qKissSairaArrival_a70929f9:

    # "De camino a casa Scarlett está dicharachera mientras Saira está silenciosa, quizás esperaba algo más que un beso en la mejilla."
    "Sur le chemin du retour, Scarlett est bavarde tandis que Saira reste silencieuse, s'attendant peut-être à plus qu'un simple baiser sur la joue."

# game/scripts/c13/c13.rpy:1546
translate french qKissSairaArrival_fc03d1b9:

    # "De camino a casa, Scarlett y Saira charlan animadamente. Besar a Saira ha hecho que sus dudas sobre vuestra relación se disipen."
    "Sur le chemin du retour, Scarlett et Saira discutent avec animation. Embrasser Saira a dissipé ses doutes quant à votre relation."

# game/scripts/c13/c13.rpy:1549
translate french qKissSairaArrival_a70929f9_1:

    # "De camino a casa Scarlett está dicharachera mientras Saira está silenciosa, quizás esperaba algo más que un beso en la mejilla."
    "Sur le chemin du retour, Scarlett est bavarde tandis que Saira reste silencieuse, s'attendant peut-être à plus qu'un simple baiser sur la joue."

# game/scripts/c13/c13.rpy:1554
translate french qKissSairaArrival_7ef27bcd:

    # "El camino a casa es incómodo, quizás no ha sido una buena idea besar a Saira delante de Scarlett y después presentarla como tu novia. Y para colmo decirles que también estás con Eileen."
    "Le retour à la maison est gênant ; embrasser Saira devant Scarlett et la présenter comme ta copine n'était peut-être pas une si bonne idée. Et pour couronner le tout, leur dire que tu vois aussi Eileen."

# game/scripts/c13/c13.rpy:1557
translate french qKissSairaArrival_05f49f85:

    # "El camino a casa es incómodo, quizás no ha sido una buena idea decirles que estás con Eileen. Y seguramente Saira esperaba más que un beso en la mejilla."
    "Le retour à la maison est gênant ; peut-être que ce n'était pas une si bonne idée de leur dire que tu étais avec Eileen. Et Saira s'attendait sans doute à plus qu'un simple baiser sur la joue."

# game/scripts/c13/c13.rpy:1561
translate french qKissSairaArrival_c3203a91:

    # "De camino a casa Scarlett está dicharachera mientras Saira parece enfadada, quizás decirle que estás con Eileen justo después de besarla no ha sido buena idea."
    "Sur le chemin du retour, Scarlett est bavarde tandis que Saira semble en colère ; peut-être que lui dire que tu es avec Eileen juste après l'avoir embrassée n'était pas une si bonne idée."

# game/scripts/c13/c13.rpy:1564
translate french qKissSairaArrival_a70929f9_2:

    # "De camino a casa Scarlett está dicharachera mientras Saira está silenciosa, quizás esperaba algo más que un beso en la mejilla."
    "Sur le chemin du retour, Scarlett est bavarde tandis que Saira reste silencieuse, s'attendant peut-être à plus qu'un simple baiser sur la joue."

# game/scripts/c13/c13.rpy:1566
translate french qKissSairaArrival_d7933132:

    # "Llegas a casa y entras a presentar a Saira. Scarlett se queda fuera mientras empieza a bajar cajas y maletas."
    "Vous rentrez à la maison et entrez pour présenter Saira. Scarlett reste dehors pendant qu'elle descend des cartons et des valises."

# game/scripts/c13/c13.rpy:1570
translate french qKissSairaArrival_0bb86a38:

    # mc "Saira, esta es [mar], mi madre. Es una de las administradoras del dormitorio."
    mc "Saira, voici [mar], ma mère. Elle est l'une des responsables de la résidence universitaire."

# game/scripts/c13/c13.rpy:1572
translate french qKissSairaArrival_4b10f43e:

    # mc "Saira, esta es [mar], ya te he hablado de ella. Es una de las administradoras del dormitorio."
    mc "Saira, voici [mar], je t'ai déjà parlé d'elle. C'est une des responsables du dortoir."

# game/scripts/c13/c13.rpy:1573
translate french qKissSairaArrival_e0704aeb:

    # mom "Encantada de conocerte, Saira. [mc] nos ha hablado de ti."
    mom "Enchantée de faire votre connaissance, Saira. [mc] nous a parlé de vous."

# game/scripts/c13/c13.rpy:1578
translate french qKissSairaArrival_67cd24c1:

    # mc "Y esta es [emm], mi hermana. Seguro que os vais a llevar bien."
    mc "Et voici [emm], ma sœur. Je suis sûre que vous vous entendrez bien."

# game/scripts/c13/c13.rpy:1579
translate french qKissSairaArrival_517372d7:

    # emm "Seguro. Bienvenida a casa, Saira."
    emm "Bien sûr. Bienvenue chez toi, Saira."

# game/scripts/c13/c13.rpy:1581
translate french qKissSairaArrival_16706699:

    # sai "Encantada de conoceros a las dos. [mc] también me habló mucho de vosotras durante el tiempo que estuvimos juntos en Portland."
    sai "Ravie de faire votre connaissance à tous les deux. [mc] Elle m'a aussi beaucoup parlé de vous pendant notre séjour à Portland."

# game/scripts/c13/c13.rpy:1583
translate french qKissSairaArrival_31109ebc:

    # mom "Voy a acompañarte a tu habitación. Hace 20 minutos que se han ido los de las mudanzas que han traído tus cosas."
    mom "Je vais vous montrer votre chambre. Les déménageurs qui ont apporté vos affaires sont partis il y a 20 minutes."

# game/scripts/c13/c13.rpy:1584
translate french qKissSairaArrival_9260c785:

    # mom "Así también te presento a dos de las chicas que viven en tu misma planta. Las otras dos están en clase."
    mom "J'aimerais aussi vous présenter deux des filles qui habitent à votre étage. Les deux autres sont en cours."

# game/scripts/c13/c13.rpy:1586
translate french qKissSairaArrival_c3facc94:

    # sai "Gracias, [mar]."
    sai "Merci, [mar]."

# game/scripts/c13/c13.rpy:1587
translate french qKissSairaArrival_04f9ebfb:

    # mc "Yo voy a salir a llevar las cosas de Scarlett a la habitación de [dap]."
    mc "Je vais porter les affaires de Scarlett dans la chambre de [dap]."

# game/scripts/c13/c13.rpy:1589
translate french qKissSairaArrival_97d40d01:

    # mom "¿Cómo está? [nor] me ha explicado lo que ha pasado."
    mom "Comment allez-vous ? [nor] m'a expliqué ce qui s'est passé."

# game/scripts/c13/c13.rpy:1590
translate french qKissSairaArrival_95d352f7:

    # mc "Ahora está mejor, pero ha sido duro para ella."
    mc "Elle va mieux maintenant, mais ça a été difficile pour elle."

# game/scripts/c13/c13.rpy:1591
translate french qKissSairaArrival_d207d47c:

    # mom "Cuando acabe de enseñarle la casa a Saira iré a verla. Creo que va a necesitar el cariño de todas."
    mom "Quand j'aurai fini de faire visiter la maison à Saira, j'irai la voir. Je pense qu'elle aura besoin de tout l'amour du monde."

# game/scripts/c13/c13.rpy:1593
translate french qKissSairaArrival_f7e4136f:

    # mcp "(Antes de hacer nada con las pruebas de ADN, debería hablar con [mar.mc!t] y explicarle lo que sé.)" id qKissSairaArrival_f7e4136f
    mcp "(Avant de faire quoi que ce soit avec les tests ADN, je devrais parler à [mar.mc!t] et lui expliquer ce que je sais.)" id qKissSairaArrival_f7e4136f

# game/scripts/c13/c13.rpy:1595
translate french qKissSairaArrival_14bc4659:

    # emm "Yo te acompaño, [mc]. Tengo ganas de darle un abrazo, y así os ayudo a subir cosas."
    emm "Je t'accompagne, [mc]. Je veux lui faire un câlin, et comme ça je pourrai t'aider à télécharger des choses."

# game/scripts/c13/c13.rpy:1596
translate french qKissSairaArrival_fea41c93:

    # mc "Perfecto, vamos. Ahora mismo está descargando ella sola la camioneta."
    mc "Parfait, allons-y. Elle est en train de décharger le camion toute seule."

# game/scripts/c13/c13.rpy:1598
translate french qKissSairaArrival_4ac13e91:

    # mc "Saira, te veo luego, cuando estés instalada. [mar.mc!t], cuando acabes, estamos en casa de [nor]."
    mc "Saira, on se voit plus tard, quand tu seras installée. Quand tu auras fini, on sera chez [c5]."

# game/scripts/c13/c13.rpy:1601
translate french qKissSairaArrival_1d9d3b55:

    # "Sales a la calle y te encuentras una tierna imagen con [nor] abrazando a Scarlett, mientras [dap] se dirige casi volando hacia ellas."
    "Vous sortez et découvrez une image touchante de [nor] serrant Scarlett dans ses bras, tandis que [dap] vole presque vers eux."

# game/scripts/c13/c13.rpy:1603
translate french qKissSairaArrival_9ce8349b:

    # dap "Vas a estar bien aquí, Scarlett. Será como cuando vienes a pasar una noche, pero será para siempre."
    dap "Tu seras bien ici, Scarlett. Ce sera comme quand tu viendras pour une seule nuit, mais ce sera pour toujours."

# game/scripts/c13/c13.rpy:1605
translate french qKissSairaArrival_4b60ca71:

    # nor "Solo tienes que pedir lo que necesites. Considéranos tu nueva familia."
    nor "N'hésitez pas à demander ce dont vous avez besoin. Considérez-nous comme votre nouvelle famille."

# game/scripts/c13/c13.rpy:1607
translate french qKissSairaArrival_d9310a72:

    # mcp "(No sabes lo cerca que podrías estar de la verdad, [nor].)"
    mcp "(Tu ne sais pas à quel point tu pourrais être proche de la vérité, [nor].)"

# game/scripts/c13/c13.rpy:1609
translate french qKissSairaArrival_00cbb795:

    # eri "Si te vuelves a teñir de pelirroja y yo vuelvo a mi color, podremos pasar por tres hermanas. O puedes volver tú a tu color y que [dap] se tiña de morena."
    eri "Si tu te teins les cheveux en roux et que je reprends ma couleur naturelle, on pourrait passer pour trois sœurs. Ou alors tu peux reprendre ta couleur naturelle et [dap] peut se teindre les cheveux en brun."

# game/scripts/c13/c13.rpy:1611
translate french qKissSairaArrival_8277e542:

    # dap "¡Ni en broma!" (multiple=2)
    dap "Pas question !" (multiple=2)

# game/scripts/c13/c13.rpy:1612
translate french qKissSairaArrival_de78fd2a:

    # sca "¡Ni por todo el oro del mundo!" (multiple=2)
    sca "Même pas pour tout l'or du monde !" (multiple=2)

# game/scripts/c13/c13.rpy:1613
translate french qKissSairaArrival_6e02fda0:

    # mc "*Risa* Parece que el color del pelo no se toca. Seréis una rubia, una pelirroja y una morena."
    mc "*Rires* Il semblerait que la couleur des cheveux ne soit pas quelque chose qu'on puisse changer. On sera blonde, rousse et brune."

# game/scripts/c13/c13.rpy:1615
translate french qKissSairaArrival_94718762:

    # emm "¿Puedo abrazar a mi nueva prima?"
    emm "Puis-je faire un câlin à mon nouveau cousin ?"

# game/scripts/c13/c13.rpy:1617
translate french qKissSairaArrival_c28f33d0:

    # mcp "(O incluso a tu nueva medio hermana, si mis sospechas son correctas.)"
    mcp "(Ou même votre nouvelle demi-sœur, si mes soupçons sont fondés.)"

# game/scripts/c13/c13.rpy:1619
translate french qKissSairaArrival_db68648a:

    # mcp "(O incluso a mi medio hermana, si mis sospechas son correctas.)"
    mcp "(Ou même ma demi-sœur, si mes soupçons sont fondés.)"

# game/scripts/c13/c13.rpy:1621
translate french qKissSairaArrival_6ecadac4:

    # sca "Al final me vais a hacer llorar. No esperaba esta recepción..."
    sca "Vous allez me faire pleurer. Je ne m'attendais pas à un tel accueil..."

# game/scripts/c13/c13.rpy:1622
translate french qKissSairaArrival_1180c57e:

    # emm "*Susurrando* Si quieres hacerlo, no te cortes, estás en familia."
    emm "*Chuchotant* Si tu veux le faire, ne te retiens pas, tu es en famille."

# game/scripts/c13/c13.rpy:1624
translate french qKissSairaArrival_de3d4712:

    # nor "Scarlett, llevas años viniendo a nuestra casa. Ahora también es la tuya."
    nor "Scarlett, tu viens chez nous depuis des années. Maintenant, c'est aussi chez toi."

# game/scripts/c13/c13.rpy:1625
translate french qKissSairaArrival_a9271edf:

    # mc "Ahora que ha acabado la ronda de abrazos. ¿Subimos las cosas de Scarlett entre todos?"
    mc "Maintenant que les câlins sont terminés, on aide tous Scarlett à télécharger ses affaires ?"

# game/scripts/c13/c13.rpy:1627
translate french qKissSairaArrival_9890eac7:

    # todas "¡Vamos!"
    todas "Allez!"

# game/scripts/c13/c13.rpy:1629
translate french qKissSairaArrival_71763a6c:

    # "Entre todos subís las cosas de Scarlett en pocos viajes. Meemaw y Betty han ido al centro y no están en casa para ayudar."
    "Vous avez réussi à monter les affaires de Scarlett en quelques voyages seulement. Meemaw et Betty sont sorties en ville et ne peuvent pas vous aider."

# game/scripts/c13/c13.rpy:1630
translate french qKissSairaArrival_629e73f5:

    # "Kate y Debbie se unen a la mudanza en cuanto [mar] les dice las novedades al presentarles a Saira. Poco después también se unen [mar] y Saira."
    "Kate et Debbie se joignent au déménagement dès que [mar] leur annonce la nouvelle en leur présentant Saira. Peu après, [mar] et Saira les rejoignent également."

# game/scripts/c13/c13.rpy:1631
translate french qKissSairaArrival_4bdf5fa1:

    # "Hacéis el trabajo como si de una verdadera familia se tratara. Quizás algún día..."
    "Vous travaillez comme une vraie famille. Peut-être un jour…"

# game/scripts/c13/c13.rpy:1656
translate french c13s005_SamanthaHouse_20102cea:

    # "Después de subir las cosas de Scarlett a la habitacón de [dap] te despides de todo el mundo y vas a casa de Samantha."
    "Après avoir monté les affaires de Scarlett dans la chambre de [dap], vous dites au revoir à tout le monde et vous allez chez Samantha."

# game/scripts/c13/c13.rpy:1657
translate french c13s005_SamanthaHouse_8479baca:

    # "Tienes que compensar el plantón de ayer y quieres pasar el máximo de rato con ella y Jamaal."
    "Tu dois te faire pardonner de lui avoir posé un lapin hier et tu veux passer le plus de temps possible avec elle et Jamaal."

# game/scripts/c13/c13.rpy:1659
translate french c13s005_SamanthaHouse_1896a1ee:

    # "Bueno, con Jamaal no tanto como con ella."
    "Enfin, pas tellement avec Jamaal qu'avec elle."

# game/scripts/c13/c13.rpy:1662
translate french c13s005_SamanthaHouse_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1663
translate french c13s005_SamanthaHouse_c1b60df2:

    # jam "*Gritando a través de la puerta* Ya voy yo, Mamá."
    jam "*Criant à travers la porte* Je vais le chercher, maman."

# game/scripts/c13/c13.rpy:1666
translate french c13s005_SamanthaHouse_55b9b40a:

    # jam "¡Hermano! Me ha dicho mi madre que ibas a venir. Esperaba que no nos dieras plantón como ayer."
    jam "Frère ! Ma mère m'a dit que tu venais. J'espérais que tu ne nous poserais pas un lapin comme hier."

# game/scripts/c13/c13.rpy:1667
translate french c13s005_SamanthaHouse_ff39ab6d:

    # mc "Lo siento, Jam. Surgió algo importante."
    mc "Je suis désolé, Jam. Un imprévu important est survenu."

# game/scripts/c13/c13.rpy:1669
translate french c13s005_SamanthaHouse_7ea85a57:

    # jam "*Gritando* Me dolió mucho en el corazón que nos abandonaras por esa cosa que tenías que hacer."
    jam "*Criant* Ça m'a tellement fait mal que tu nous aies abandonnés pour cette chose que tu devais faire."

# game/scripts/c13/c13.rpy:1670
translate french c13s005_SamanthaHouse_f1c09c2f:

    # jam "*Gritando* Tuve que hacer un esfuerzo y comer más pastitas de las que debía..."
    jam "*Criant* J'ai dû me forcer et manger plus de pâtisseries que je n'aurais dû..."

# game/scripts/c13/c13.rpy:1672
translate french c13s005_SamanthaHouse_4210a6dd:

    # jam "*Susurrando* Pero yo te agradecí que no vinieras. Me puse hasta el culo de pastitas."
    jam "*Chuchotant* Mais j'étais contente que tu ne sois pas venu. J'ai mangé des tonnes de pâtisseries."

# game/scripts/c13/c13.rpy:1673
translate french c13s005_SamanthaHouse_669c29df:

    # mc "*Susurrando* Eres un capullo. *Risa*"
    mc "*Chuchotant* T'es vraiment un crétin. *Rires*"

# game/scripts/c13/c13.rpy:1674
translate french c13s005_SamanthaHouse_dc036ff8:

    # mc "*Gritando* Si no me hubieras dicho que hacía tres días que no te duchabas, a lo mejor me hubiera atrevido a venir."
    mc "*Criant* Si tu ne m'avais pas dit que tu ne t'étais pas douché depuis trois jours, peut-être que j'aurais osé venir."

# game/scripts/c13/c13.rpy:1675
translate french c13s005_SamanthaHouse_0359678e:

    # sam "*Desde la cocina* Sabéis que no susurraís demasiado flojo, ¿verdad?"
    sam "*Depuis la cuisine* Vous savez qu'il ne faut pas chuchoter trop bas, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:1677
translate french c13s005_SamanthaHouse_d8b54348:

    # jam "Tío, no sabes ni susurrar. Anda, pasa."
    jam "Mec, tu peux même pas chuchoter. Allez, monte."

# game/scripts/c13/c13.rpy:1678
translate french c13s005_SamanthaHouse_c0d6cb94:

    # mc "Apártate primero de en medio. No pienso saltar por encima tuyo. Ya sabes que las carreras de vallas no se me daban bien."
    mc "Écarte-toi d'abord. Je ne vais pas te sauter par-dessus. Tu sais bien que je n'étais pas douée pour les haies."

# game/scripts/c13/c13.rpy:1680
translate french c13s005_SamanthaHouse_8869c9cb:

    # sam "Al final has podido venir."
    sam "Tu as enfin pu venir."

# game/scripts/c13/c13.rpy:1681
translate french c13s005_SamanthaHouse_5546a9fe:

    # mc "No podía darte plantón dos días seguidos."
    mc "Je ne pouvais pas te poser un lapin deux jours de suite."

# game/scripts/c13/c13.rpy:1682
translate french c13s005_SamanthaHouse_8fcb857c:

    # mc "Por Jamaal no me importa, pero a ti no osaría dejarte plantada por segunda vez."
    mc "Je me fiche de Jamaal, mais je n'oserais pas te poser un lapin une deuxième fois."

# game/scripts/c13/c13.rpy:1684
translate french c13s005_SamanthaHouse_3a623aad:

    # jam "Claro, como el pobre Jamaal ya está plantado en su silla... ¿qué más da dejarlo plantado también cuando se queda con él?"
    jam "Bien sûr, puisque le pauvre Jamaal est déjà assis sur sa chaise… quelle différence cela fait-il de le laisser debout là aussi, puisqu’il reste avec lui ?"

# game/scripts/c13/c13.rpy:1685
translate french c13s005_SamanthaHouse_be72dc6b:

    # mc "Calla y déjame saludar a tu madre como es debido."
    mc "Silence, et laissez-moi saluer votre mère comme il se doit."

# game/scripts/c13/c13.rpy:1687
translate french c13s005_SamanthaHouse_178e8182:

    # mc "Estás guapísima, como siempre."
    mc "Tu es magnifique, comme toujours."

# game/scripts/c13/c13.rpy:1688
translate french c13s005_SamanthaHouse_703e5917:

    # sam "Y tú eres un adulador, como siempre. Pero puedes seguir haciéndolo, me encanta."
    sam "Et vous êtes un flatteur, comme toujours. Mais continuez, j'adore ça."

# game/scripts/c13/c13.rpy:1690
translate french c13s005_SamanthaHouse_6c28c601:

    # sam "Podéis ir a hacer lo que queráis, lo tendré todo preparado en unos minutos."
    sam "Tu peux faire ce que tu veux, je préparerai tout dans quelques minutes."

# game/scripts/c13/c13.rpy:1691
translate french c13s005_SamanthaHouse_6d700f97:

    # mc "¿Necesitas ayuda?"
    mc "Avez-vous besoin d'aide ?"

# game/scripts/c13/c13.rpy:1692
translate french c13s005_SamanthaHouse_31dc2b07:

    # sam "No, qué va. Solo me estorbaríais en la cocina."
    sam "Pas question. Tu me gênerais dans la cuisine."

# game/scripts/c13/c13.rpy:1693
translate french c13s005_SamanthaHouse_55f98a7e:

    # mc "Te esperamos aquí sentados. Bueno, Jamaal siempre espera sentado. Es un vago."
    mc "On t'attend ici. Enfin, Jamaal attend toujours assis. Il est paresseux."

# game/scripts/c13/c13.rpy:1695
translate french c13s005_SamanthaHouse_4565074d:

    # sam "¡[mc]! Ya sabes que no me gusta que hagas esas bromas."
    sam "[mc]! Tu sais que je n'aime pas quand tu fais ce genre de blagues."

# game/scripts/c13/c13.rpy:1696
translate french c13s005_SamanthaHouse_caee36db:

    # mc "Perdón, Sam. Es la costumbre."
    mc "Désolé, Sam. C'est juste une habitude."

# game/scripts/c13/c13.rpy:1698
translate french c13s005_SamanthaHouse_c504b1d6:

    # jam "¡Hey, a mí me gustan esas bromas! Para una vez que usa el cerebro, déjalo antes de que lo confundan con una endivia."
    jam "Hé, j'aime bien ces blagues ! Pour une fois qu'il réfléchit, laissons-le faire avant qu'on le prenne pour une endive."

# game/scripts/c13/c13.rpy:1699
translate french c13s005_SamanthaHouse_fd06acd4:

    # mc "Tú te callas, si Sam no quiere que haga esas bromas, te las haré en privado. Y no, no es una proposición."
    mc "Tais-toi. Si Sam ne veut pas que je fasse ces blagues, je les ferai en privé. Et non, ce n'est pas une proposition."

# game/scripts/c13/c13.rpy:1701
translate french c13s005_SamanthaHouse_896219b0:

    # jam "Tampoco eres mi tipo. *Risa* Y no me puedo desgravar de los impuestos hacer obras de caridad de ese tipo."
    jam "Vous n'êtes pas mon genre non plus. *Rires* Et je ne peux pas bénéficier d'une réduction d'impôt pour ce genre de bénévolat."

# game/scripts/c13/c13.rpy:1703
translate french c13s005_SamanthaHouse_393f2823:

    # jam "Estaremos en mi habitación, Mamá. Avísanos cuando esté todo listo."
    jam "Nous serons dans ma chambre, maman. Préviens-nous quand tout sera prêt."

# game/scripts/c13/c13.rpy:1706
translate french c13s005_SamanthaHouse_b9951adf:

    # jam "¿Te llegó mi correo? ¿Recordabas las contraseñas?"
    jam "Avez-vous reçu mon courriel ? Vous souvenez-vous des mots de passe ?"

# game/scripts/c13/c13.rpy:1707
translate french c13s005_SamanthaHouse_e485850f:

    # mc "Sí, son contraseñas que no olvidaré nunca. *Risa*"
    mc "Oui, ce sont des mots de passe que je n'oublierai jamais. *Rires*"

# game/scripts/c13/c13.rpy:1708
translate french c13s005_SamanthaHouse_ff23f4ff:

    # mc "Gracias por la información, pero recuerda esas dos preguntas estúpidas que acabas de hacer."
    mc "Merci pour l'information, mais n'oubliez pas ces deux questions stupides que vous venez de poser."

# game/scripts/c13/c13.rpy:1710
translate french c13s005_SamanthaHouse_e0776d40:

    # jam "¿Estúpidas? ¿Por qué?"
    jam "Stupide ? Pourquoi ?"

# game/scripts/c13/c13.rpy:1711
translate french c13s005_SamanthaHouse_c3a39331:

    # mc "Luego te lo explico. ¿Has conseguido encontrar los nombres de las cinco chicas que te pedí?"
    mc "Je vous l'expliquerai plus tard. Avez-vous réussi à trouver les noms des cinq filles que je vous ai demandés ?"

# game/scripts/c13/c13.rpy:1713
translate french c13s005_SamanthaHouse_4a874792:

    # jam "Sí, es gracioso. Amanda, Beatrice, aunque a veces aparece como Beatrix, Claire, Diana, y Eva. ABCDE. Todas se apellidan Gilford. GILF-ord."
    jam "Oui, c'est drôle. Amanda, Béatrice (même si parfois elle apparaît sous le nom de Beatrix), Claire, Diana et Eva. ABCDE. Elles portent toutes le nom de famille Gilford. GILF-ord."

# game/scripts/c13/c13.rpy:1714
translate french c13s005_SamanthaHouse_4b5e73b9:

    # mc "Gracias, Jam. ¿Ya has descubierto por qué tus preguntas son estúpidas?"
    mc "Merci, Jam. As-tu enfin compris pourquoi tes questions sont stupides ?"

# game/scripts/c13/c13.rpy:1716
translate french c13s005_SamanthaHouse_331f1ff9:

    # jam "No, sigo sin verlo."
    jam "Non, je ne le vois toujours pas."

# game/scripts/c13/c13.rpy:1717
translate french c13s005_SamanthaHouse_6f754df5:

    # mc "Has buscado el nombre de cinco chicas que te pedí ayer, ¿verdad?"
    mc "Tu as bien cherché les noms des cinq filles que je t'ai demandés hier, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:1718
translate french c13s005_SamanthaHouse_7ddf4456:

    # jam "Sí, claro. Me puse a ello en el momento en que recibí tu correo..."
    jam "Oui, bien sûr. J'ai commencé à y travailler dès que j'ai reçu votre courriel..."

# game/scripts/c13/c13.rpy:1720
translate french c13s005_SamanthaHouse_9fb4b99a:

    # jam "Correo que no me hubieras enviado si no hubieras recibido el mío... vale, colega, tu hermano es tonto."
    jam "Tu ne m'aurais pas envoyé d'e-mail si tu n'avais pas reçu le mien... bon, mon pote, ton frère est un imbécile."

# game/scripts/c13/c13.rpy:1721
translate french c13s005_SamanthaHouse_76dc6aa0:

    # mc "No, no lo eres."
    mc "Non, tu ne l'es pas."

# game/scripts/c13/c13.rpy:1722
translate french c13s005_SamanthaHouse_1b28c348:

    # jam "Gracias..."
    jam "Merci..."

# game/scripts/c13/c13.rpy:1723
translate french c13s005_SamanthaHouse_4a4b70b4:

    # mc "Me refiero a que no eres mi hermano. Tu tontedad me avergüenza y te repudio. *Risa*"
    mc "Je veux dire, tu n'es pas mon frère. Ta bêtise me fait honte, et je te méprise. *Rires*"

# game/scripts/c13/c13.rpy:1725
translate french c13s005_SamanthaHouse_372a747b:

    # jam "¡Eres un capullo! ¿Dónde ibas a encontrar un hermano tan guapo como yo?"
    jam "Espèce d'idiot ! Où trouverais-tu un frère aussi beau que moi ?"

# game/scripts/c13/c13.rpy:1726
translate french c13s005_SamanthaHouse_95caa390:

    # mc "En el zoo seguramente. Si me tengo que retener toda la tarde de meterme contigo por lo que ha dicho Sam, tengo que quitarme el mono ahora."
    mc "Sans doute au zoo. Si je dois me retenir tout l'après-midi de te taquiner sur ce que Sam a dit, il faut que j'en finisse maintenant."

# game/scripts/c13/c13.rpy:1729
translate french c13s005_SamanthaHouse_9dfba07e:

    # jam "¿Toda la tarde? ¡Ni lo pienses! No pienso estar con los dos tortolitos fastidiándoos el plan."
    jam "Tout l'après-midi ? N'y pense même pas ! Je ne vais pas traîner avec ces deux tourtereaux qui vont gâcher tes plans."

# game/scripts/c13/c13.rpy:1730
translate french c13s005_SamanthaHouse_ab44cd1a:

    # mc "Jam, no hay plan. He venido a veros como he venido toda mi vida. Recuerda que todas esas paranoias tuyas eran hipotéticas."
    mc "Jam, il n'y a pas de plan. Je suis venu te voir, j'ai fait tout le chemin de ma vie. Souviens-toi, toutes ces pensées paranoïaques n'étaient que des hypothèses."

# game/scripts/c13/c13.rpy:1732
translate french c13s005_SamanthaHouse_435f8687:

    # jam "Sí, sí. Una de las razones por las que venías es porque siempre te gustó mi madre. La otra eran los pastelillos. Ahora tienes las dos cosas. *Risa*"
    jam "Oui, oui. L'une des raisons pour lesquelles tu es venu, c'est que tu as toujours bien aimé ma mère. L'autre, c'était pour les pâtisseries. Maintenant, tu as les deux. *Rires*"

# game/scripts/c13/c13.rpy:1733
translate french c13s005_SamanthaHouse_4f8b8e2f:

    # mc "Bueno, hoy me conformo con los pastelillos."
    mc "Bon, aujourd'hui, je me contenterai des pâtisseries."

# game/scripts/c13/c13.rpy:1735
translate french c13s005_SamanthaHouse_d62cfea5:

    # jam "¿Toda la tarde? ¿No te ha dicho mi madre que tenía que irme hoy?"
    jam "Tout l'après-midi ? Ma mère ne t'a pas dit que je devais partir aujourd'hui ?"

# game/scripts/c13/c13.rpy:1736
translate french c13s005_SamanthaHouse_61a919b2:

    # mc "No, no me lo ha dicho. Pero bueno, más pastelillos para mí."
    mc "Non, elle ne me l'a pas dit. Tant pis, plus de pâtisseries pour moi !"

# game/scripts/c13/c13.rpy:1738
translate french c13s005_SamanthaHouse_edb44e28:

    # jam "La próxima vez que me llames glotón, te recordaré esta conversación. *Risa*"
    jam "La prochaine fois que tu me traiteras de glouton, je te rappellerai cette conversation. *Rires*"

# game/scripts/c13/c13.rpy:1740
translate french c13s005_SamanthaHouse_54393d31:

    # jam "Cambiando de tema. ¿Hay algo que me puedas contar sobre la investigación? ¿O tengo que seguir investigando a ciegas?"
    jam "Pour changer de sujet, pouvez-vous me donner des informations sur l'enquête ? Ou dois-je continuer à enquêter à l'aveuglette ?"

# game/scripts/c13/c13.rpy:1741
translate french c13s005_SamanthaHouse_0528f3a0:

    # mc "Hoy me he encontrado con alguien. Me ha dicho que en uno o dos días me va a dar más información."
    mc "J'ai croisé quelqu'un aujourd'hui. Cette personne m'a dit qu'elle me donnerait plus d'informations d'ici un jour ou deux."

# game/scripts/c13/c13.rpy:1743
translate french c13s005_SamanthaHouse_dc20080f:

    # jam "¿Nada que puedas contarme ahora?"
    jam "Vous ne pouvez rien me dire maintenant ?"

# game/scripts/c13/c13.rpy:1744
translate french c13s005_SamanthaHouse_a850a26a:

    # mc "He aprendido más con tu correo de lo que sabía por mí mismo. Sabes lo mismo que yo."
    mc "J'ai appris plus de choses grâce à votre courriel que par moi-même. Vous en savez autant que moi."

# game/scripts/c13/c13.rpy:1746
translate french c13s005_SamanthaHouse_e5b1fd53:

    # jam "No. Yo sé mucho más ahora que ayer. He descubierto de dónde sacan el dinero."
    jam "Non. J'en sais beaucoup plus maintenant qu'hier. J'ai découvert d'où ils tirent leur argent."

# game/scripts/c13/c13.rpy:1747
translate french c13s005_SamanthaHouse_1479c7c8:

    # mc "¿De dónde?"
    mc "D'où vient-il ?"

# game/scripts/c13/c13.rpy:1749
translate french c13s005_SamanthaHouse_15b20c9e:

    # jam "Vas a flipar. NTR se dedica a hacer Operaciones Especiales en las que nuestro gobierno no quiere involucrarse directamente."
    jam "Vous allez être époustouflé. NTR se consacre à la réalisation d'opérations spéciales dans lesquelles notre gouvernement ne souhaite pas s'impliquer directement."

# game/scripts/c13/c13.rpy:1750
translate french c13s005_SamanthaHouse_813b460f:

    # mc "¿Son mercenarios?"
    mc "Sont-ce des mercenaires ?"

# game/scripts/c13/c13.rpy:1751
translate french c13s005_SamanthaHouse_69cfab07:

    # jam "Más o menos. Pero unos mercenarios especiales. Utilizan niños para las misiones."
    jam "Plus ou moins. Mais ce sont des mercenaires d'un genre particulier. Ils utilisent des enfants pour leurs missions."

# game/scripts/c13/c13.rpy:1752
translate french c13s005_SamanthaHouse_a3db9a7f:

    # mc "¿Qué?"
    mc "Que?"

# game/scripts/c13/c13.rpy:1754
translate french c13s005_SamanthaHouse_10176a3c:

    # jam "Sí, yo también he flipado. Te pongo un ejemplo. He encontrado un par de expedientes de misiones en las que han participado clones de la Serie G. Casi todo censurado."
    jam "Oui, j'étais moi aussi sidéré. Permettez-moi de vous donner un exemple. J'ai trouvé quelques fichiers de mission concernant des clones de la série G. Presque tout était censuré."

# game/scripts/c13/c13.rpy:1755
translate french c13s005_SamanthaHouse_9338b2ba:

    # mcp "(La serie G son los que se colaron ayer en casa. Eric era Serie E y el resto Serie G.)"
    mcp "(Ce sont les membres de la série G qui se sont introduits clandestinement dans la maison hier. Eric était de la série E et les autres de la série G.)"

# game/scripts/c13/c13.rpy:1756
translate french c13s005_SamanthaHouse_b7d42ea5:

    # jam "Lo más curioso es que la Serie G se creó hace 13 años. ¡Son pre-adolescentes!"
    jam "Le plus étonnant, c'est que la série G ait été créée il y a 13 ans. Ce sont des préadolescents !"

# game/scripts/c13/c13.rpy:1757
translate french c13s005_SamanthaHouse_5f4fce49:

    # mc "¿Qué? ¡Es imposible! Yo..."
    mc "Quoi ? C'est impossible ! Je..."

# game/scripts/c13/c13.rpy:1758
translate french c13s005_SamanthaHouse_7dd6db3e:

    # mcp "(Yo los he visto y diría que tienen alrededor de 20 años.)"
    mcp "(Je les ai vus et je dirais qu'ils ont environ 20 ans.)"

# game/scripts/c13/c13.rpy:1760
translate french c13s005_SamanthaHouse_b962afc7:

    # jam "Tú... ¿qué?"
    jam "Vous... quoi ?"

# game/scripts/c13/c13.rpy:1761
translate french c13s005_SamanthaHouse_2d01692a:

    # mc "Yo lo veo muy raro... ¿sabes cuando se creó la Serie E?"
    mc "Je trouve ça très étrange… savez-vous quand la série E a été créée ?"

# game/scripts/c13/c13.rpy:1762
translate french c13s005_SamanthaHouse_f93cab63:

    # jam "E-F-G... Dos años antes. Hace unos 15. ¿Por qué?"
    jam "EFG… Deux ans plus tôt. Il y a environ 15 ans. Pourquoi ?"

# game/scripts/c13/c13.rpy:1763
translate french c13s005_SamanthaHouse_b7d1bd08:

    # mc "Creía haber conocido a un tipo de la Serie E, pero es imposible. Debía estar en la mitad de sus 30."
    mc "Je croyais avoir rencontré un acteur de la série E, mais c'est impossible. Il devait avoir une trentaine d'années."

# game/scripts/c13/c13.rpy:1764
translate french c13s005_SamanthaHouse_d8939e57:

    # mcp "(¿Hay otra empresa haciendo lo mismo que NTR pero con años de ventaja? Las fechas no cuadran con las edades que vi.)"
    mcp "(Existe-t-il une autre société qui fait la même chose que NTR, mais avec une longueur d'avance ? Les dates ne correspondent pas aux âges que j'ai vus.)"

# game/scripts/c13/c13.rpy:1766
translate french c13s005_SamanthaHouse_5153b1f4:

    # jam "¿Has conocido a un clon?"
    jam "Avez-vous déjà rencontré un clone ?"

# game/scripts/c13/c13.rpy:1768
translate french c13s005_SamanthaHouse_bf226bd2:

    # mcp "(He estado hablando con una hace unas horas. Fliparías.)"
    mcp "(J'en parlais justement à l'un d'eux il y a quelques heures. Vous n'allez pas le croire.)"

# game/scripts/c13/c13.rpy:1770
translate french c13s005_SamanthaHouse_1b1e0659:

    # mcp "(Sí, y tú también. Pero no puedo traicionar las identidades de [emm], [dap], y [eri]. Al menos no sin que ellas lo sepan.)"
    mcp "(Oui, vous aussi. Mais je ne peux pas révéler l'identité de [emm], [dap] et [eri]. Du moins pas sans qu'ils le sachent.)"

# game/scripts/c13/c13.rpy:1771
translate french c13s005_SamanthaHouse_677db572:

    # mc "Lo que he dicho es que me había parecido conocerlo, pero las edades no cuadran."
    mc "J'ai dit que je pensais le connaître, mais que les âges ne correspondent pas."

# game/scripts/c13/c13.rpy:1773
translate french c13s005_SamanthaHouse_84b59426:

    # jam "Aparte de eso tienen actividades médicas. Nada que esté aprobado en los Estados Unidos. Supongo que una cosa es que los usemos para operaciones encubiertas..."
    jam "Par ailleurs, ils ont des activités médicales. Rien d'approuvé aux États-Unis. Je suppose que les utiliser pour des opérations secrètes, c'est une chose…"

# game/scripts/c13/c13.rpy:1774
translate french c13s005_SamanthaHouse_84aa2153:

    # mc "Y otra diferente que les dejemos vender medicamentos aquí..."
    mc "Et puis, il y a une toute autre question : devrions-nous les autoriser à vendre des médicaments ici…"

# game/scripts/c13/c13.rpy:1776
translate french c13s005_SamanthaHouse_3674c85c:

    # jam "Oh, no, no son medicamentos. Son más bien articulos avanzados de farmacia. Maquinaria, tests para enfermedades..."
    jam "Oh non, ce ne sont pas des médicaments. Ce sont plutôt des produits pharmaceutiques de pointe. Des machines, des tests de dépistage de maladies…"

# game/scripts/c13/c13.rpy:1777
translate french c13s005_SamanthaHouse_cdb1991d:

    # sam "*Desde el salón* Ya está todo listo. Dejad los videojuegos antes de que se enfríe el té."
    sam "*Depuis le salon* Tout est prêt. Rangez les jeux vidéo avant que le thé ne refroidisse."

# game/scripts/c13/c13.rpy:1779
translate french c13s005_SamanthaHouse_02d3bb09:

    # mc "Seguimos luego, y mándame todo lo que tengas por correo. No podemos hacer esperar a tu madre."
    mc "Nous reprendrons plus tard, et envoyez-moi tout ce que vous avez par la poste. Nous ne pouvons pas faire attendre votre mère."

# game/scripts/c13/c13.rpy:1782
translate french c13s005_SamanthaHouse_1fff2716:

    # sam "Hacía días que no te veía, [mc], excepto esta mañana, claro."
    sam "Je ne t'avais pas vu depuis des jours, [mc], sauf ce matin, bien sûr."

# game/scripts/c13/c13.rpy:1783
translate french c13s005_SamanthaHouse_b7b8dc8e:

    # sam "¿Alguna novedad en casa?"
    sam "Des nouvelles de la maison ?"

# game/scripts/c13/c13.rpy:1784
translate french c13s005_SamanthaHouse_4c23ed94:

    # mc "Bueno, hoy ha llegado la última de las estudiantes. Ya sabes que Eileen y Kiara están viviendo en casa también."
    mc "Eh bien, les derniers élèves sont arrivés aujourd'hui. Tu sais qu'Eileen et Kiara vivent aussi chez leurs parents."

# game/scripts/c13/c13.rpy:1785
translate french c13s005_SamanthaHouse_82523d1b:

    # mc "Y hoy se ha mudado Scarlett, la amiga de [dap]. Problemas en casa."
    mc "Et aujourd'hui, Scarlett, l'amie de [dap], a emménagé. Il y a des problèmes à la maison."

# game/scripts/c13/c13.rpy:1787
translate french c13s005_SamanthaHouse_f115703e:

    # sam "Es decir, que estás viviendo con... 13 mujeres, ¿no? No me extraña que quieras fugarte y visitarnos. *Risa*"
    sam "Alors, tu vis avec… 13 femmes, c'est ça ? Pas étonnant que tu aies envie de t'enfuir et de venir nous voir. *Rires*"

# game/scripts/c13/c13.rpy:1788
translate french c13s005_SamanthaHouse_779d4975:

    # mc "No es malo, de verdad. Y son 15. No has contado a mi Meemaw y a Tía Betty. Llegaron el sábado."
    mc "Ce n'est pas si mal, en fait. Et il y en a quinze. Tu n'as pas encore compté ma grand-mère, tante Betty. Elles sont arrivées samedi."

# game/scripts/c13/c13.rpy:1790
translate french c13s005_SamanthaHouse_d80eb7d1:

    # jam "*Risa* No es malo ahora. Espera a que se les sincronicen los periodos a las 15... aunque tu abuela y Betty no serán un problema en eso, ¿verdad?"
    jam "*Rires* Ça va encore. Attends de voir quand leurs règles se synchroniseront à 15 h… mais ta grand-mère et Betty ne devraient pas s'y opposer, n'est-ce pas ?"

# game/scripts/c13/c13.rpy:1791
translate french c13s005_SamanthaHouse_633e1d0c:

    # mc "*Risa* ¡Qué bruto eres!... ¿Me acogeriais una semana en casa si se diera el caso? *Risa*"
    mc "*Rires* Vous êtes vraiment impoli !... Pourriez-vous m'héberger une semaine si besoin était ? *Rires*"

# game/scripts/c13/c13.rpy:1793
translate french c13s005_SamanthaHouse_f5f7d6ec:

    # sam "Si se diera el caso, con lo mal que lo pinta Jamaal, creo que tendrías que huir del país un par de semanas. A alguna isla del Caribe. *Risa*"
    sam "Si c'était le cas, vu la façon dont Jamaal dépeint les choses, je pense que tu devrais fuir le pays pendant deux semaines. Sur une île des Caraïbes, par exemple. *Rires*"

# game/scripts/c13/c13.rpy:1794
translate french c13s005_SamanthaHouse_019bb16a:

    # sam "Aunque él no tiene queja cuando se nos sincroniza a Simone y a mí... {b}Verdad{/b}, ¿hijo?"
    sam "Même s'il ne se plaint pas quand Simone et moi sommes synchronisés... {b}N'est-ce pas, fiston ?"

# game/scripts/c13/c13.rpy:1796
translate french c13s005_SamanthaHouse_2d949aaa:

    # jam "No hagas caso, [mc]. Cuando se les sincroniza me encierro en mi habitación una semana. Esa semana soy super productivo en el trabajo."
    jam "Ne t'en fais pas, [mc]. Quand ils sont synchronisés, je m'enferme dans ma chambre pendant une semaine. Cette semaine-là, je suis super productive au travail."

# game/scripts/c13/c13.rpy:1797
translate french c13s005_SamanthaHouse_0b268a67:

    # mc "Jamaal, no sabes donde te estás metiendo..."
    mc "Jamaal, tu ne sais pas dans quoi tu t'embarques..."

# game/scripts/c13/c13.rpy:1799
translate french c13s005_SamanthaHouse_5a821ce0:

    # sam "No pasa nada, ya lo conocemos y sabemos cómo son sus bromas. No nos afectan demasiado."
    sam "Ça ne nous dérange pas, on le connaît et on sait à quoi s'attendre avec ses blagues. Elles ne nous dérangent pas plus que ça."

# game/scripts/c13/c13.rpy:1800
translate french c13s005_SamanthaHouse_3c29d55c:

    # mc "¿Y tú qué me cuentas, Sam? ¿Alguna novedad desde que fuimos a cenar?"
    mc "Alors, quoi de neuf, Sam ? Des nouvelles depuis notre dîner ?"

# game/scripts/c13/c13.rpy:1802
translate french c13s005_SamanthaHouse_64e9b365:

    # sam "Que llevo una vida aburrida. Trabajo y casa. Eso hace que los días parezcan todos iguales y se hagan eternos. Cuando miras atrás a una cosa especial, como nuestra cena, parece que fue ayer."
    sam "Ma vie est monotone. Entre le travail et la maison, les journées se ressemblent toutes et semblent interminables. Quand je repense à un moment spécial, comme notre dîner, j'ai l'impression que c'était hier."

# game/scripts/c13/c13.rpy:1803
translate french c13s005_SamanthaHouse_ed8148ce:

    # mc "Pues habrá que repetirlo..."
    mc "Bon, il va falloir recommencer..."

# game/scripts/c13/c13.rpy:1805
translate french c13s005_SamanthaHouse_9db7566c:

    # jam "Vosotros planead vuestra próxima cita, que a mí me está entrando hambre y esas pastitas me están llamando."
    jam "Organisez votre prochain rendez-vous, parce que j'ai faim et ces pâtisseries me font de l'œil."

# game/scripts/c13/c13.rpy:1808
translate french c13s005_SamanthaHouse_0b73b421:

    # sam "Solo hay un problema... tu ya comiste ayer más de las que te tocaban. Estas son para [mc]."
    sam "Il y a juste un problème… tu as déjà mangé plus que ta portion hier. Celles-ci sont pour [mc]."

# game/scripts/c13/c13.rpy:1809
translate french c13s005_SamanthaHouse_5c1d1cc0:

    # jam "¡Mamaaaaa!"
    jam "Maman!"

# game/scripts/c13/c13.rpy:1811
translate french c13s005_SamanthaHouse_a877c334:

    # sam "¿Qué quieres que te diga? Creo que me está empezando a bajar el periodo... *Risa*"
    sam "Que voulez-vous que je dise ? Je crois que j'ai mes règles... *Rires*"

# game/scripts/c13/c13.rpy:1812
translate french c13s005_SamanthaHouse_cbc7b203:

    # mc "*Risa* Nunca te metas con el periodo de la mujer que te prepara la comida, Jam. Yo si que voy a comer alguna pastita, si no te importa, Sam."
    mc "*Rires* Jamais de la vie ne s'en prend à la femme qui cuisine pour toi pendant ses règles. Je vais prendre des pâtes, si ça ne te dérange pas, Sam."

# game/scripts/c13/c13.rpy:1814
translate french c13s005_SamanthaHouse_48913338:

    # sam "Por supuesto que no, cariño. Tú puedes comer."
    sam "Bien sûr que non, chérie. Tu peux manger."

# game/scripts/c13/c13.rpy:1815
translate french c13s005_SamanthaHouse_277ec0bf:

    # mc "Mmmmm... que buenas están estas pastitas, Jamaal. Lástima que tú no puedas comer... están deliciosas..."
    mc "Mmm... ces pâtisseries sont tellement bonnes, Jamaal. C'est dommage que tu ne puisses pas en manger... elles sont délicieuses..."

# game/scripts/c13/c13.rpy:1817
translate french c13s005_SamanthaHouse_f1394835:

    # jam "Eres... eres... eres un capullo glotón."
    jam "Tu es... tu es... tu es un gros glouton."

# game/scripts/c13/c13.rpy:1818
translate french c13s005_SamanthaHouse_b4141e1a:

    # mc "No te enfurruñes, Jam, tú te comiste las tuyas ayer. *Risa*"
    mc "Ne boude pas, Jam, tu as mangé le tien hier. *Rires*"

# game/scripts/c13/c13.rpy:1820
translate french c13s005_SamanthaHouse_74b00986:

    # sam "No te preocupes, el enfurruñamiento le durará hasta que le diga que hoy voy a hacer empanadas argentinas para cenar. ¿Quieres quedarte a cenar?"
    sam "Ne t'inquiète pas, sa bouderie ne durera que jusqu'à ce que je lui dise que je prépare des empanadas argentines pour le dîner ce soir. Tu veux rester dîner ?"

# game/scripts/c13/c13.rpy:1821
translate french c13s005_SamanthaHouse_e31b8a2b:

    # mc "Me encantaría, pero con cuatro inquilinas nuevas... creo que debería estar en casa, por si [mar.mc!t] y [nor] me necesitan."
    mc "J'adorerais, mais avec quatre nouveaux locataires... je pense que je devrais être à la maison, au cas où [mar.mc!t] et [nor] auraient besoin de moi."

# game/scripts/c13/c13.rpy:1823
translate french c13s005_SamanthaHouse_e36627c0:

    # jam "Sólo faltaría eso, que también te comieras las empanadas..."
    jam "Ce serait la goutte d'eau qui fait déborder le vase, si en plus vous mangiez les empanadas..."

# game/scripts/c13/c13.rpy:1824
translate french c13s005_SamanthaHouse_7ee9ae06:

    # jam "Sabes que puedes pedirme lo que quieras, pero con mi comida no puedes jugar..."
    jam "Tu sais que tu peux me demander tout ce que tu veux, mais tu ne peux pas toucher à ma nourriture..."

# game/scripts/c13/c13.rpy:1825
translate french c13s005_SamanthaHouse_9f3fc5f6:

    # mc "Seguro que tu madre haría más empanadas de las necesarias si me quedase yo, no es que fuese a quitarte comida del plato para ponérmela a mí. *Risa*"
    mc "Je suis sûre que ta mère ferait plus d'empanadas que nécessaire si je restais ; ce n'est pas comme si je te piquerais de la nourriture pour la mettre dans la mienne. *Rires*"

# game/scripts/c13/c13.rpy:1827
translate french c13s005_SamanthaHouse_0fbdef56:

    # sam "No me des ideas, que se está poniendo un poco fondón... *Risa*"
    sam "Ne me donnez pas d'idées, il commence à prendre un peu de poids... *Rires*"

# game/scripts/c13/c13.rpy:1828
translate french c13s005_SamanthaHouse_89b0a258:

    # mc "Echará de menos tener un gordo en la familia, y querrá coger él ese rol. *Risa*"
    mc "Il regrettera de ne plus avoir de gros dans la famille et voudra endosser ce rôle lui-même. *Rires*"

# game/scripts/c13/c13.rpy:1830
translate french c13s005_SamanthaHouse_62a1032a:

    # jam "¡No tengo por qué aguantar esto! Voy a irme a la calle a tomarme un café y un dónut antes de irme a ese sitio que tengo que ir..."
    jam "Je n'ai pas à supporter ça ! Je vais prendre un café et un beignet dehors avant d'aller à l'endroit où je dois aller..."

# game/scripts/c13/c13.rpy:1831
translate french c13s005_SamanthaHouse_f19e94a6:

    # mc "No hace falta, Jam, puedes comerte mis pastitas si quieres..."
    mc "Pas besoin, Jam, tu peux manger mes biscuits si tu veux..."

# game/scripts/c13/c13.rpy:1833
translate french c13s005_SamanthaHouse_13bd31f0:

    # sam "Pues ya que vas a la calle, bája la caja de la pizza que pediste anoche. Ahora te la traigo."
    sam "Puisque tu es déjà sorti(e), descends la boîte à pizza que tu as commandée hier soir. Je vais te la chercher tout de suite."

# game/scripts/c13/c13.rpy:1834
translate french c13s005_SamanthaHouse_7f7b0be2:

    # mc "Sam, de verdad que no es necesario que se vaya, yo no me voy a comer todas las pastas..."
    mc "Sam, tu n'as vraiment pas besoin de partir, je ne vais pas manger toutes les pâtes..."

# game/scripts/c13/c13.rpy:1837
translate french c13s005_SamanthaHouse_a80d684c:

    # jam "*Susurrando* Ya te he dicho que no me quedaría haciendo de aguantavelas toda la tarde. Soy un actor de puta madre."
    jam "*À voix basse* Je t'ai déjà dit que je n'allais pas rester là à faire l'idiot tout l'après-midi. Je suis un sacré bon acteur."

# game/scripts/c13/c13.rpy:1838
translate french c13s005_SamanthaHouse_85738d73:

    # mc "No vamos a hacer nada, Jam. Aunque te fueras, Simone puede llegar en cualquier momento... ¿no?"
    mc "On ne va rien faire, Jam. Même si tu partais, Simone pourrait arriver à tout moment… pas vrai ?"

# game/scripts/c13/c13.rpy:1840
translate french c13s005_SamanthaHouse_bed7c764:

    # jam "Simone se ha ido a trabajar hace un par de horas. Hasta las 7 o las 8 no volverá. Tenéis la casa para vosotros solos."
    jam "Simone est partie travailler il y a deux heures. Elle ne sera pas de retour avant 19h ou 20h. Vous avez la maison pour vous seuls."

# game/scripts/c13/c13.rpy:1841
translate french c13s005_SamanthaHouse_4195b243:

    # mc "Aún así, tu madre no va a querer hacer nada, tú podrías volver en 30 minutos por lo que a ella concierne."
    mc "Malgré tout, votre mère ne voudra rien faire ; pour elle, vous pourriez revenir dans 30 minutes."

# game/scripts/c13/c13.rpy:1842
translate french c13s005_SamanthaHouse_4426de4f:

    # jam "Veo que ya has dejado de esconderte detrás de la palabra \"hipotéticamente\". *Risa*"
    jam "Je vois que tu as enfin arrêté de te cacher derrière le mot « hypothétiquement ». *Rires*"

# game/scripts/c13/c13.rpy:1845
translate french c13s005_SamanthaHouse_1a1d801c:

    # jam "Me hubiera gustado quedarme más, pero tengo que hacer un par de cosas en la calle. De verdad que no me voy por las pastas. *Risa*"
    jam "J'aurais bien aimé rester plus longtemps, mais j'ai deux ou trois choses à faire dehors. Je ne pars vraiment pas pour les pâtisseries ! *Rires*"

# game/scripts/c13/c13.rpy:1846
translate french c13s005_SamanthaHouse_34bd4d78:

    # mc "Últimamente te veo poquísimo. Un día que no estés tan ocupado deberíamos quedar a comer."
    mc "Je ne t'ai pas beaucoup vu ces derniers temps. On devrait déjeuner ensemble un de ces jours où tu as un peu plus de temps."

# game/scripts/c13/c13.rpy:1849
translate french c13s005_SamanthaHouse_fe81937a:

    # jam "Y así me cuentas como te va con mi hermana. *Risa*"
    jam "Et ensuite, tu pourras me dire comment ça se passe avec ma sœur. *Rires*"

# game/scripts/c13/c13.rpy:1850
translate french c13s005_SamanthaHouse_467ffe54:

    # mc "Solo si, hipotéticamente, estuviera con ella..."
    mc "Seulement si, hypothétiquement, j'étais avec elle..."

# game/scripts/c13/c13.rpy:1853
translate french c13s005_SamanthaHouse_f4627438:

    # jam "Cuando quieras. Creo que estaré un poco más libre... en un mes apróximadamente."
    jam "Quand tu veux. Je pense que je serai un peu plus libre… dans un mois environ."

# game/scripts/c13/c13.rpy:1854
translate french c13s005_SamanthaHouse_50e9b140:

    # mc "Trabajas demasiado..."
