    sim "Ce sera presque pire que de ne pas te voir du tout. T'avoir près de moi et ne pas pouvoir t'embrasser…"

# game/scripts/c13/c13.rpy:1916
translate french c13s005_SamanthaNoSex_91e9be35:

    # mc "Eso tiene fácil arreglo si se lo decimos a tu madre..."
    mc "Ça se règle facilement si on le dit à ta mère..."

# game/scripts/c13/c13.rpy:1918
