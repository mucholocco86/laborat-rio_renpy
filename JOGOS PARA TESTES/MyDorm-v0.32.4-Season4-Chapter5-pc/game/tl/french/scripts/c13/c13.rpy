    # "Al salir al rellano te encuentras una sorpresa."
    "En arrivant sur le palier, une surprise vous attend."

# game/scripts/c13/c13.rpy:1908
translate french c13s005_SamanthaNoSex_d5669af1:

    # mc "¡Simone! Creía que estabas trabajando..."
    mc "Simone ! Je croyais que tu travaillais..."

