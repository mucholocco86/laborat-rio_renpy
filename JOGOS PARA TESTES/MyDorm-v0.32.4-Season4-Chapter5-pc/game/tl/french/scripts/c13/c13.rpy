# game/scripts/c13/c13.rpy:1879
translate french c13s005_SamanthaNoSex_c19933e8:

    # mc "No, por supuesto. Que tu hijo sea un adicto al trabajo no tiene nada que ver con que tú tampoco lo seas. *Risa*"
    mc "Non, bien sûr que non. Le fait que votre fils soit un accro au travail n'a rien à voir avec le fait que vous le soyez aussi. *Rires*"

# game/scripts/c13/c13.rpy:1880
translate french c13s005_SamanthaNoSex_370f0ec8:

    # sam "Seguramente no. Dáme un segundo. Tengo que comprobar si tengo de todo para hacer las empanadas para mandarle un mensaje a Jamaal y decirle que lo compre cuando vuelva."
    sam "Probablement pas. Attends une seconde. Je dois vérifier si j'ai tout ce qu'il faut pour faire les empanadas, comme ça je pourrai envoyer un texto à Jamaal pour lui dire de les acheter à son retour."

# game/scripts/c13/c13.rpy:1881
translate french c13s005_SamanthaNoSex_125cd9d9:

    # mc "Tómate todo el tiempo que quieras. Voy a inspeccionar la casa."
    mc "Prenez tout le temps qu'il vous faut. Je vais inspecter la maison."

# game/scripts/c13/c13.rpy:1883
translate french c13s005_SamanthaNoSex_dac21e5f:

    # mc "*Gritando* Siempre me ha encantado esta foto."
    mc "*Criant* J'ai toujours adoré cette photo."

# game/scripts/c13/c13.rpy:1884
translate french c13s005_SamanthaNoSex_5e49fd70:

    # sam "*Desde la cocina* ¿Qué foto?"
    sam "*Depuis la cuisine* Quelle photo ?"

# game/scripts/c13/c13.rpy:1885
translate french c13s005_SamanthaNoSex_ca5c7018:

    # mc "*Gritando* La foto en la que estás patinando."
    mc "*Criant* La photo où tu fais du patin à roulettes."

# game/scripts/c13/c13.rpy:1886
translate french c13s005_SamanthaNoSex_3a69f5df:

    # sam "*Desde la cocina* ¡Ufff! Te gustan jovencitas. *Risa* En esa foto tenía la edad de Simone. Aún no sabía que estaba embarazada de Jamaal."
    sam "*Depuis la cuisine* Pff ! Tu aimes les jeunes filles. *Rires* Sur cette photo, j'avais l'âge de Simone. Je ne savais pas encore que j'étais enceinte de Jamaal."

# game/scripts/c13/c13.rpy:1887
translate french c13s005_SamanthaNoSex_d7c31b0b:

    # mc "*Gritando* Sam, me gustas en esta foto, me gustabas cuando te conocí diez años después, y me pareces preciosa ahora..."
    mc "*Criant* Sam, je t'aime bien sur cette photo, je t'aimais bien quand je t'ai rencontré dix ans plus tard, et je te trouve magnifique maintenant..."

# game/scripts/c13/c13.rpy:1889
translate french c13s005_SamanthaNoSex_eab9d449:

    # sam "Ya estoy aquí. He escrito a Jamaal. Me falta tomate."
    sam "Me voici. J'ai écrit à Jamaal. Il me manque des tomates."

# game/scripts/c13/c13.rpy:1890
translate french c13s005_SamanthaNoSex_a2537d72:

    # mc "Me estás poniendo muy difícil irme. Suenan tentadoras esas empanadas."
    mc "Tu me rends la tâche vraiment difficile pour partir. Ces empanadas ont l'air tentantes."

# game/scripts/c13/c13.rpy:1892
translate french c13s005_SamanthaNoSex_3e2fb054:

    # sam "Pero entiendo que te tengas que ir. Además, no te dejaría acercarte a mi cocina ni aunque me pagaras por ello."
    sam "Mais je comprends que vous deviez partir. D'ailleurs, je ne vous laisserais pas approcher de ma cuisine même si vous me payiez."

# game/scripts/c13/c13.rpy:1893
translate french c13s005_SamanthaNoSex_4d1cedb6:

    # mc "No soy tan desastre en la cocina... algo he aprendido de [mar.mc!t] y de [nor]."
    mc "Je ne suis pas si mauvaise en cuisine... J'ai appris quelque chose grâce à [mar.mc!t] et [nor]."

# game/scripts/c13/c13.rpy:1895
translate french c13s005_SamanthaNoSex_47ac36e3:

    # sam "No lo suficiente para que me fíe de ti. Voy a tener que empezar a hacer la masa para que fermente bien. Si quieres sientate aquí y seguimos charlando."
    sam "Pas assez pour que je te fasse confiance. Je vais devoir commencer à préparer la pâte pour qu'elle fermente correctement. Si tu veux, assieds-toi ici et on peut continuer à discuter."

# game/scripts/c13/c13.rpy:1896
translate french c13s005_SamanthaNoSex_9f408512:

    # mc "Te conozco cuando cocinas. Vas a dejar de escucharme en cuanto empieces a amasar, con lo que te voy a dejar que cocines tranquila."
    mc "Je te connais quand tu cuisines. Tu cesseras de m'écouter dès que tu commenceras à pétrir, alors je vais te laisser cuisiner en paix."

# game/scripts/c13/c13.rpy:1897
translate french c13s005_SamanthaNoSex_c4bd30bc:

    # mc "¿Por qué no venís un día los tres a casa a comer?"
    mc "Pourquoi ne viendriez-vous pas tous les trois déjeuner chez moi un de ces jours ?"

