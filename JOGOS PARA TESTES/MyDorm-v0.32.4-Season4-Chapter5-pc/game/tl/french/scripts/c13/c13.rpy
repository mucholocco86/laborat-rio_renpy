# game/scripts/c13/c13.rpy:1859
translate french c13s005_SamanthaHouse_3493ad8d:

    # jam "Bueno, os dejo solos... volveré en tres o cuatro horas, Mamá. Más o menos a la misma hora que Simone."
    jam "Bon, je vous laisse toutes les deux… Je reviens dans trois ou quatre heures, maman. À peu près en même temps que Simone."

# game/scripts/c13/c13.rpy:1863
translate french c13s005_SamanthaHouse_d2832625:

    # jam "Bueno, voy a tirar esto y a acercarme a la papelería. Vuelvo en un rato."
    jam "Bon, je vais jeter ça et aller à la papeterie. Je reviens dans quelques minutes."

# game/scripts/c13/c13.rpy:1875
translate french c13s005_SamanthaNoSex_ed0744ca:

    # sam "Últimamente trabaja mucho y siempre está yendo y viniendo..."
