

# game/scripts/c15/c15.rpy:209
translate french c15s001_DapDate_9988d3d9:

    # "[dap] introduce en el GPS la dirección del restaurante y conduces hasta allí. Está a poco menos de 20 minutos de la tienda de Maddie."
    "Entrez l'adresse du restaurant dans votre GPS et rendez-vous sur place. C'est à un peu moins de 20 minutes de la boutique de Maddie."

# game/scripts/c15/c15.rpy:212
translate french c15s001_DapDate_ffd0c998:

    # dap "Ya hemos llegado. No te sorprendas por lo que veas ahí dentro..."
    dap "Nous sommes arrivés. Ne soyez pas surpris par ce que vous verrez à l'intérieur..."

# game/scripts/c15/c15.rpy:213
translate french c15s001_DapDate_2eb99d0b:

    # dap "O mejor aún, sorpréndete."
    dap "Ou mieux encore, soyez surpris."

# game/scripts/c15/c15.rpy:214
translate french c15s001_DapDate_34550ae0:

    # mc "Ya estoy sorprendido. Esto antes era un gimnasio, ¿no? ¿Ahora es un restaurante?"
    mc "Je suis déjà surpris. C'était une salle de sport, non ? Et maintenant, c'est un restaurant ?"

# game/scripts/c15/c15.rpy:216
translate french c15s001_DapDate_f0a216c1:

    # dap "Son unos cuantos restaurantes... y algo más. Lo abrieron hace unos meses. Tenía ganas de venir, pero no tenía nadie con quién venir hasta que... tú y yo... ya sabes..."
    dap "Il y a quelques restaurants… et autre chose. Ils ont ouvert il y a quelques mois. J'avais envie de venir, mais je n'avais personne avec qui venir jusqu'à ce que… toi et moi… tu vois…"

# game/scripts/c15/c15.rpy:217
translate french c15s001_DapDate_267e2c14:

    # mc "[dap], puedes decir hasta que empezamos a salir."
    mc "[dap], vous pouvez dire jusqu'à ce que nous commencions à sortir ensemble."

# game/scripts/c15/c15.rpy:218
translate french c15s001_DapDate_6df6d6d0:

    # dap "Lo sé, pero se me hace raro decirlo."
    dap "Je sais, mais ça me paraît bizarre de le dire."

# game/scripts/c15/c15.rpy:220
translate french c15s001_DapDate_5c7d5522:

    # dap "Pues ya estamos aquí."
    dap "Eh bien, nous y voilà."

# game/scripts/c15/c15.rpy:221
translate french c15s001_DapDate_b14bd407:

    # mc "¿Black Crow? Suena bien, debería haber mirado la página web. Pero es un poco pronto para ir a cenar, ¿no?"
    mc "Black Crow ? Ça a l'air bon, j'aurais dû aller voir leur site. Mais il est un peu tôt pour dîner, non ?"

# game/scripts/c15/c15.rpy:222
translate french c15s001_DapDate_09756934:

    # dap "No creas. Tenemos que ducharnos y pasar por la peluquería. Al menos yo. Contigo no van a poder hacer gran cosa."
    dap "Ne t'inquiète pas. On doit prendre une douche et aller chez le coiffeur. Enfin, moi, oui. Ils ne pourront pas faire grand-chose avec toi."

# game/scripts/c15/c15.rpy:223
translate french c15s001_DapDate_b69e38e4:

    # mc "¿Peluquería? *Risa* ¿Dónde me has traído?"
    mc "Coiffeur ? *Rires* Où m'avez-vous emmené ?"

# game/scripts/c15/c15.rpy:224
translate french c15s001_DapDate_99c55155:

    # dap "Entremos y lo verás."
    dap "Entrons et vous verrez."

# game/scripts/c15/c15.rpy:226
translate french c15s001_DapDate_117275b9:

    # _("Recepcionista") "Buenas tardes, ¿tienen reserva?"
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:227
translate french c15s001_DapDate_0eaa88ba:

    # mc "Sí, a nombre de Marks."
    mc "Oui, au nom de Marks."

# game/scripts/c15/c15.rpy:229
translate french c15s001_DapDate_420fa7af:

    # dap "¡[mc] Marks!"
    dap "Marques !"

# game/scripts/c15/c15.rpy:231
translate french c15s001_DapDate_bf0b72ec:

    # _("Recepcionista") "Ah, vale, perfecto. Tienen reserva en el restaurante Black Crow."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:232
translate french c15s001_DapDate_1ce75b02:

    # mc "Exacto."
    mc "Exact."

# game/scripts/c15/c15.rpy:233
translate french c15s001_DapDate_6a4c1705:

    # _("Recepcionista") "Entonces, subiendo por estas escaleras encontrarán el vestuario donde les atenderán mis compañeros."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:234
translate french c15s001_DapDate_b2516466:

    # mc "Gracias."
    mc "Merci."

# game/scripts/c15/c15.rpy:236
translate french c15s001_DapDate_8bec7690:

    # mc "¿Vestuario? Ahí es donde nos podremos duchar, supongo."
    mc "Vestiaire ? C'est là qu'on peut prendre une douche, je suppose."

# game/scripts/c15/c15.rpy:237
translate french c15s001_DapDate_a768d130:

    # dap "Y cambiarnos. Vas a poder elegir a tu gusto. Tan solo recuerda esto. 14. Para ir a juego."
    dap "Et changez. Vous pourrez choisir ce que vous voulez. Souvenez-vous simplement de ceci : 14. À assortir."

# game/scripts/c15/c15.rpy:238
translate french c15s001_DapDate_0f97df03:

    # mc "Estás siendo muy misteriosa."
    mc "Vous êtes très mystérieux."

# game/scripts/c15/c15.rpy:240
translate french c15s001_DapDate_a11aa689:

    # dap "¿Quieres que te lo cuente todo y estropee la sorpresa?"
    dap "Tu veux que je te raconte tout et que je gâche la surprise ?"

# game/scripts/c15/c15.rpy:241
translate french c15s001_DapDate_4a5ebed8:

    # mc "No, prefiero que me sorprendas, pero sigo pensando que es un poco pronto para cenar."
    mc "Non, je préférerais que tu me fasses la surprise, mais je trouve qu'il est encore un peu tôt pour dîner."

# game/scripts/c15/c15.rpy:242
translate french c15s001_DapDate_90d35b9d:

    # dap "No te preocupes, entre ducha, cambiarme, y peluquería yo voy a tardar cerca de una hora."
    dap "Ne t'inquiète pas, entre la douche, le changement de tenue et le passage chez le coiffeur, ça me prendra environ une heure."

# game/scripts/c15/c15.rpy:243
translate french c15s001_DapDate_c476ef12:

    # mc "¿Qué? ¿Una hora?"
    mc "Quoi ? Une heure ?"

# game/scripts/c15/c15.rpy:245
translate french c15s001_DapDate_faf803d9:

    # dap "Querrás que tu novia esté guapa en nuestra primera cita, ¿verdad?"
    dap "Tu voudras que ta copine soit belle pour notre premier rendez-vous, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:246
translate french c15s001_DapDate_742b9e83:

    # mc "[dap], tú estás guapa siempre, pero esperaré. Cada vez siento más curiosidad."
    mc "[dap], tu es toujours magnifique, mais j'attendrai. Ma curiosité grandit."

# game/scripts/c15/c15.rpy:247
translate french c15s001_DapDate_89e81213:

    # dap "Bueno, la curiosidad se acabará en cuanto entres por esa puerta. Nos vemos en una hora."
    dap "Eh bien, votre curiosité sera satisfaite dès que vous franchirez cette porte. À dans une heure."

# game/scripts/c15/c15.rpy:249
translate french c15s001_DapDate_bcb25274:

    # "Es el momento de saber a qué viene tanto secretismo."
    "Il est temps de découvrir ce qui se cache derrière tout ce secret."

# game/scripts/c15/c15.rpy:251
translate french c15s001_DapDate_02f50975:

    # "Entras en el vestuario y te está esperando alguien de la plantilla vestido como la recepcionista."
    "Vous entrez dans les vestiaires et un membre du personnel vous attend, déguisé en réceptionniste."

# game/scripts/c15/c15.rpy:252
translate french c15s001_DapDate_1c1c93b1:

    # "Elliot" "Buenas tardes, Sr. Marks. Soy Elliot y seré su Ayudante de Vestuario."
    "Elliot" "Bonjour Monsieur Marks. Je suis Elliot et je serai votre assistant costumier."

# game/scripts/c15/c15.rpy:253
translate french c15s001_DapDate_14dedc8d:

    # "Elliot" "Tiene las duchas al fondo. Recomendamos su uso antes de cambiarse."
    "Elliot" "Les douches se trouvent au fond. Nous vous recommandons de les utiliser avant de vous changer."

# game/scripts/c15/c15.rpy:254
translate french c15s001_DapDate_4a8bf992:

    # mc "Perfecto. Venimos de la playa y necesito una ducha. Pero no he traído ropa."
    mc "Parfait. On revient de la plage et j'ai besoin d'une douche. Mais je n'ai pas emporté de vêtements."

# game/scripts/c15/c15.rpy:255
translate french c15s001_DapDate_b8a43021:

    # "Elliot" "Veo que es su primera vez en nuestras instalaciones. ¿Quiere que le explique cómo funciona?"
    "Elliot" "Je vois que c'est votre première visite dans nos locaux. Souhaiteriez-vous que je vous explique comment cela fonctionne ?"

# game/scripts/c15/c15.rpy:256
translate french c15s001_DapDate_890c041b:

    # mc "Por supuesto."
    mc "Bien sûr."

# game/scripts/c15/c15.rpy:258
translate french c15s001_DapDate_4f648d8a:

    # "Elliot" "Lo primero que me tiene que decir es de qué siglo se quiere vestir. Puede ser XIV, XVI, o XVIII. Eso nos ayuda a que las salas sean más homogéneas y a la inmersión de los clientes."
    "Elliot" "La première chose à préciser est le siècle dans lequel vous souhaitez vous habiller : XIVe, XVIe ou XVIIIe siècle. Cela nous permettra de créer des espaces plus harmonieux et d’enrichir l’expérience des visiteurs."

# game/scripts/c15/c15.rpy:259
translate french c15s001_DapDate_58e3f529:

    # mc "Mi novia me ha dicho que recuerde el número 14. Supongo que se refería a esto. No sabía que era un restaurante temático."
    mc "Ma copine m'a dit de me souvenir du chiffre 14. Je suppose qu'elle voulait dire ça. Je ne savais pas que c'était un restaurant à thème."

# game/scripts/c15/c15.rpy:260
translate french c15s001_DapDate_72269408:

    # "Elliot" "Perfecto. Siendo el Siglo XIV puede escoger entre vestirse de caballero, cortesano, o pícaro. Teníamos un disfraz de campesino, pero no triunfó demasiado."
    "Elliot" "Parfait. Puisque l'histoire se déroule au XIVe siècle, vous pouvez choisir de vous déguiser en chevalier, en courtisan ou en brigand. Nous avions prévu un costume de paysan, mais il n'a pas eu beaucoup de succès."

# game/scripts/c15/c15.rpy:261
translate french c15s001_DapDate_4a851eec:

    # mc "¿Caballero con armadura, espada y esas cosas?"
    mc "Un chevalier en armure, avec une épée et tout le tralala ?"

# game/scripts/c15/c15.rpy:263
translate french c15s001_DapDate_52998d60:

    # "Elliot" "Sí a la armadura, no a la espada. No proporcionamos armas, lo siento. Pese a que es uno de los más populares, le tengo que avisar que no es el más cómodo."
    "Elliot" "Oui pour l'armure, non pour l'épée. Nous ne fournissons pas d'armes, désolé. Bien que ce soit l'une des options les plus populaires, je dois vous prévenir que ce n'est pas la plus confortable."

# game/scripts/c15/c15.rpy:264
translate french c15s001_DapDate_2d013c95:

    # "Elliot" "Estar cenando con armadura, aunque sea falsa, puede resultar un poco incómodo si no está acostumbrado."
    "Elliot" "Dîner en armure, même factice, peut être un peu inconfortable si on n'y est pas habitué."

# game/scripts/c15/c15.rpy:265
translate french c15s001_DapDate_d4e39871:

    # mc "¿Podría probarme los tres y decidir?"
    mc "Pourrais-je essayer les trois et choisir ensuite ?"

# game/scripts/c15/c15.rpy:266
translate french c15s001_DapDate_aa2be2e3:

    # "Elliot" "No lo podemos permitir por un tema de higiene. Todos nuestros disfraces se envían a la lavandería después de cada uso."
    "Elliot" "Pour des raisons d'hygiène, nous ne pouvons pas l'autoriser. Tous nos costumes sont envoyés au pressing après chaque utilisation."

# game/scripts/c15/c15.rpy:267
translate french c15s001_DapDate_605879ae:

    # mc "Entonces me disfrazaré de..."
    mc "Alors je me déguiserai en..."

# game/scripts/c15/c15.rpy:276
translate french c15s001_DapDate_12d962b0:

    # "Elliot" "Perfecto. Pues si quiere pasar a la ducha y le preparo su ropa. Se la dejaré en la taquilla. Aquí tiene la llave. Número 93. La combinación es 23129. Supongo que no quiere servicio de peluquería."
    "Elliot" "Parfait. Si vous souhaitez prendre une douche, je vais préparer vos vêtements et les laisser dans votre casier. Voici la clé : numéro 93. La combinaison est 23129. Je suppose que vous ne souhaitez pas aller chez le coiffeur."

# game/scripts/c15/c15.rpy:277
translate french c15s001_DapDate_447ba67f:

    # mc "No, no es necesario. ¿Por qué lo dice?"
    mc "Non, ce n'est pas nécessaire. Pourquoi dites-vous cela ?"

# game/scripts/c15/c15.rpy:278
translate french c15s001_DapDate_9cc3265b:

    # "Elliot" "Normalmente los clientes masculinos suelen rechazarlo a menos que lleven el pelo largo."
    "Elliot" "Les clients masculins la refusent généralement, sauf s'ils ont les cheveux longs."

# game/scripts/c15/c15.rpy:279
translate french c15s001_DapDate_6464cdcf:

    # mc "Entonces seré como el resto. *Risa* Rechazaré el servicio de peluquería."
    mc "Alors je ferai comme tout le monde. *Rires* Je refuserai le service de coiffure."

# game/scripts/c15/c15.rpy:280
translate french c15s001_DapDate_99dbf3ae:

    # "Elliot" "Perfecto. Cuando esté listo, o si necesita ayuda para vestirse, llame a aquel timbre y volveré para acompañarle a la sala de espera."
    "Elliot" "Parfait. Lorsque vous serez prêt(e), ou si vous avez besoin d'aide pour vous habiller, sonnez et je reviendrai vous accompagner jusqu'à la salle d'attente."

# game/scripts/c15/c15.rpy:282
translate french c15s001_DapDate_12356f46:

    # "Después de darle tu talla, pasas a la ducha. Está claro que han mantenido las instalaciones del antiguo gimnasio."
    "Une fois votre taille choisie, vous allez prendre une douche. Il est clair qu'ils ont conservé les installations de l'ancienne salle de sport."

# game/scripts/c15/c15.rpy:283
translate french c15s001_DapDate_fb07d82b:

    # "Al volver tienes tu disfraz en la taquilla. Tienes curiosidad por saber cómo te va a quedar. Y especialmente tienes curiosidad sobre cómo se va a vestir [dap]. Esperas haber acertado."
    "À ton retour, ton costume est dans ton casier. Tu as hâte de voir ce que ça donnera sur toi. Et tu es surtout impatient(e) de savoir ce que portera [dap]. Tu espères avoir fait le bon choix."

# game/scripts/c15/c15.rpy:286
translate french c15s001_DapDate_1b8f0299:

    # mc "No quedo mal de caballero. Aunque el escudero tenía razón. No es muy cómodo. *Risa* Escudero... ya me estoy metiendo en el papel."
    mc "Je ne suis pas si mal en chevalier. Même si l'écuyer avait raison. Ce n'est pas très confortable. *Rires* Écuyer… Je commence à me mettre dans la peau du personnage."

# game/scripts/c15/c15.rpy:289
translate french c15s001_DapDate_c35f0399:

    # mc "El disfraz de cortesano es chulo. El tacto es suave. Me alegra haber hecho caso al sirviente y no haber cogido el de caballero. *Risa* Sirviente... ya me estoy metiendo en el papel."
    mc "Le costume du courtisan est super. Il est tout doux. Je suis content d'avoir écouté le serviteur et de ne pas avoir pris celui du chevalier. *Rires* Serviteur… Je suis déjà dans la peau du personnage."

# game/scripts/c15/c15.rpy:292
translate french c15s001_DapDate_2a2c73a7:

    # mc "Creo que Vilfredo vestirá así en la partida de DnD. Me alegra haber hecho caso al tabernero y no haber cogido el de caballero. *Risa* Tabernero... ya me estoy metiendo en el papel."
    mc "Je pense que Vilfredo s'habillera comme ça dans la partie de D&D. Heureusement que j'ai écouté l'aubergiste et que je n'ai pas choisi la tenue de chevalier ! *Rires* L'aubergiste… Je suis déjà dans la peau du personnage."

# game/scripts/c15/c15.rpy:294
translate french c15s001_DapDate_ee7db50a:

    # "Justo cuando vas a pulsar el timbre para llamar a Elliot, te das cuenta de que no estás solo en el vestuario."
    "Au moment où vous vous apprêtez à appuyer sur le bouton d'appel pour appeler Elliot, vous réalisez que vous n'êtes pas seul dans les vestiaires."

# game/scripts/c15/c15.rpy:295
translate french c15s001_DapDate_e6341375:

    # _("Hombre") "Buenas tardes. ¿Siglo XIV?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:296
translate french c15s001_DapDate_fa27330b:

    # mc "Hola, buenas tardes. Sí."
    mc "Bonjour, bon après-midi. Oui."

# game/scripts/c15/c15.rpy:297
translate french c15s001_DapDate_30081bbe:

    # _("Hombre") "Nosotros estuvimos la semana pasada. Hoy toca cenar en el Siglo XXXII. Lo han abierto esta semana. Supongo que mi mujer se disfrazará de Princesa Laia. ¿De qué se disfrazará su esposa?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:298
translate french c15s001_DapDate_9ccdfc53:

    # mc "Mi novia. No lo sé, es la primera vez que venimos y yo ni siquiera sabía qué tipo de restaurante era."
    mc "Ma copine. Je ne sais pas, c'est la première fois qu'on vient ici et je ne savais même pas quel genre de restaurant c'était."

# game/scripts/c15/c15.rpy:300
translate french c15s001_DapDate_20d0961c:

    # _("Hombre") "Si es la primera vez, prepárate para esperar. A nosotros nos dan tres o cuatro opciones, dependiendo del restaurante. A ellas les dan seis o siete."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:301
translate french c15s001_DapDate_9353de80:

    # mc "Pero no pudiéndoselos probar, no tardarán tanto, ¿no?"
    mc "Mais comme ils ne peuvent pas les essayer, ça ne prendra pas si longtemps, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:303
translate french c15s001_DapDate_a3241e0f:

    # _("Hombre") "No se los pueden probar, pero pueden verlos en la percha. Mi mujer se pasó 20 minutos intentando decidir entre siete vestidos la semana pasada."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:304
translate french c15s001_DapDate_2ef2849b:

    # _("Hombre") "Y obviamente, una vez deciden el vestido, tienen que decidir qué peinado le pega mejor a ese estilo. Media hora más. Espero que tengas batería en el móvil. *Risa*"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:305
translate french c15s001_DapDate_0b486eb8:

    # mc "*Risa* Sí, por suerte voy servido de batería."
    mc "*Rires* Oui, heureusement que j'ai beaucoup de batterie."

# game/scripts/c15/c15.rpy:307
translate french c15s001_DapDate_3659900c:

    # _("Hombre") "Bueno, te dejo con tu espera. Ahí viene mi copiloto."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:308
translate french c15s001_DapDate_021a7a94:

    # mc "Que pase una buena noche."
    mc "Passe une bonne nuit."

# game/scripts/c15/c15.rpy:309
translate french c15s001_DapDate_00c9df17:

    # _("Hombre") "Igualmente, hijo."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:311
translate french c15s001_DapDate_6397acfa:

    # "Elliot os lleva a diferentes salas de espera y te sientas a hacer tiempo hasta que [dap] esté preparada. Por lo que ha dicho el hombre en el vestuario, te tocará esperar un rato."
    "Elliot vous emmène dans différentes salles d'attente, et vous patientez jusqu'à ce que [dap] soit prêt. D'après ce que l'homme dans les vestiaires a dit, il va falloir attendre un moment."

# game/scripts/c15/c15.rpy:313
translate french c15s001_DapDate_82ffc13f:

    # "Cuando ya has leído todas las noticias locales, internacionales, sobre videojuegos, e incluso sobre la vida de los famosos..."
    "Quand on a déjà lu toutes les actualités locales et internationales, sur les jeux vidéo, et même sur la vie des célébrités..."

# game/scripts/c15/c15.rpy:315
translate french c15s001_DapDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:316
translate french c15s001_DapDate_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Nombre caché ?)"

# game/scripts/c15/c15.rpy:330
translate french c15s001_DapDate_27e07c02:

    # "Justo al colgar, oyes pasos en las escaleras por las que has bajado."
    "Au moment même où vous raccrochez, vous entendez des pas dans l'escalier que vous avez descendu."

# game/scripts/c15/c15.rpy:332
translate french c15s001_DapDate_4c40f33f:

    # dap "¿Llevas mucho tiempo esperándome?"
    dap "M'attends-tu depuis longtemps ?"

# game/scripts/c15/c15.rpy:342
translate french c15s001_DapDate_f4004887:

    # mc "¡Wow, [dap]! ¡Pareces salida de un cuento de hadas! Estás preciosa."
    mc "Waouh, [dap] ! Tu sembles sortir tout droit d'un conte de fées ! Tu es magnifique."

# game/scripts/c15/c15.rpy:343
translate french c15s001_DapDate_4d29251f:

    # dap "¡Gracias, [mc]! Me preocupaba quedar ridícula."
    dap "Merci, [mc] ! J'avais peur d'avoir l'air ridicule."

# game/scripts/c15/c15.rpy:345
translate french c15s001_DapDate_76a5d3f6:

    # dap "Tú también estás muy guapo, pero no sé si va a ser cómodo cenar con la armadura."
    dap "Vous êtes très beau vous aussi, mais je ne sais pas si ce sera confortable de dîner en armure."

# game/scripts/c15/c15.rpy:346
translate french c15s001_DapDate_8d6b7b9b:

    # mc "Me lo ha comentado el ayudante del vestuario, pero no podía dejarlo pasar."
    mc "L'assistant dans les vestiaires m'en a parlé, mais je n'ai pas pu laisser tomber."

# game/scripts/c15/c15.rpy:348
translate french c15s001_DapDate_343db1df:

    # dap "Lástima que no hayas hecho a Vilfredo un guerrero o un paladín. Me hubiera gustado imaginarte así en la partida."
    dap "C'est dommage que tu n'aies pas fait de Vilfredo un guerrier ou un paladin. J'aurais bien aimé t'imaginer le jouer ainsi dans le jeu."

# game/scripts/c15/c15.rpy:350
translate french c15s001_DapDate_48b8e592:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿príncipe?"
    dap "Vous êtes très beau vous aussi, le look princier vous va à merveille..."

# game/scripts/c15/c15.rpy:351
translate french c15s001_DapDate_d6612785:

    # mc "Oficialmente cortesano, pero si quieres que sea tu príncipe solo tienes que pedirlo."
    mc "Officiellement courtisan, mais si vous voulez qu'il soit votre prince, il suffit de le demander."

# game/scripts/c15/c15.rpy:353
translate french c15s001_DapDate_9cc03b0f:

    # dap "Lástima que no hayas hecho a Vilfredo noble. Me hubiera gustado imaginarte así en la partida."
    dap "C'est dommage que vous n'ayez pas fait de Vilfredo un noble. J'aurais aimé l'imaginer ainsi dans le jeu."

# game/scripts/c15/c15.rpy:355
translate french c15s001_DapDate_ea236d73:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿espadachín?"
    dap "Vous êtes très beau vous aussi, le look d'épéiste vous va à merveille...?"

# game/scripts/c15/c15.rpy:356
translate french c15s001_DapDate_994e2502:

    # mc "Me lo han ofrecido como pícaro y, después de generar el personaje de Vilfredo, no podía dejarlo pasar. Quiero que vista parecido a esto, si es posible."
    mc "On me l'a proposé comme rôle de voyou, et après avoir créé le personnage de Vilfredo, je n'ai pas pu refuser. J'aimerais qu'il s'habille de façon similaire, si possible."

# game/scripts/c15/c15.rpy:358
translate french c15s001_DapDate_93c0bc47:

    # dap "Ningún problema. No me perdería un pícaro tan guapo por nada del mundo."
    dap "Pas de problème. Je ne laisserais passer un si beau voyou pour rien au monde."

# game/scripts/c15/c15.rpy:359
translate french c15s001_DapDate_e5242538:

    # mc "Vas a hacer que este pobre pícaro se ruborice. *Risa*"
    mc "Tu vas faire rougir ce pauvre coquin. *Rires*"

# game/scripts/c15/c15.rpy:361
translate french c15s001_DapDate_ec28650e:

    # dap "¿Pasamos a cenar? Tengo ganas de ver el restaurante."
    dap "On va dîner ? J'aimerais bien voir le restaurant."

# game/scripts/c15/c15.rpy:362
translate french c15s001_DapDate_c996350e:

    # mc "Cuando quieras. A mí me ha entrado hambre mientras esperaba. Pero la espera ha valido la pena."
    mc "Quand tu veux. J'ai eu faim en attendant. Mais ça valait le coup."

# game/scripts/c15/c15.rpy:365
translate french c15s001_DapDate_08921eec:

    # dap "Gracias, mi amable caballero."
    dap "Merci, monsieur."

# game/scripts/c15/c15.rpy:368
translate french c15s001_DapDate_6cada05b:

    # dap "Gracias, mi apuesto príncipe."
    dap "Merci, mon beau prince."

# game/scripts/c15/c15.rpy:371
translate french c15s001_DapDate_dbf1df63:

    # dap "Gracias, mi pícaro seductor."
    dap "Merci, mon séducteur rusé."

# game/scripts/c15/c15.rpy:373
translate french c15s001_DapDate_607ded3e:

    # "Llamáis al timbre y aparece alguien nuevo del personal."
    "Vous sonnez à la porte et un nouveau membre du personnel apparaît."

# game/scripts/c15/c15.rpy:374
translate french c15s001_DapDate_d17bca35:

    # "Mathilda" "Buenas tardes les de Dios a vuesas mercedes. Mi nombre es Mathilda. Si tienen el placer de acompañarme, les guiaré a su mesa para que puedan disfrutar del yantar."
    "Mathilda" "Bonjour, que Dieu vous bénisse. Je m'appelle Mathilda. Si vous souhaitez vous joindre à moi, je vous accompagnerai à votre table pour que vous puissiez prendre votre repas."

# game/scripts/c15/c15.rpy:376
translate french c15s001_DapDate_e3023a37:

    # dap "Cuando quiera. Estamos listos."
    dap "Quand vous serez prêts. Nous serons prêts."

# game/scripts/c15/c15.rpy:377
translate french c15s001_DapDate_23a0c42a:

    # mc "*Susurrando* Ahora pillo lo del acento raro del tipo que me cogió el teléfono. Era este falso acento medieval."
    mc "*Chuchotant* Maintenant, je comprends l'accent bizarre du type qui a répondu au téléphone. C'était un faux accent médiéval."

# game/scripts/c15/c15.rpy:379
translate french c15s001_DapDate_f92c238c:

    # dap "De momento me está gustando, y eso que aún no hemos visto el restaurante."
    dap "Pour l'instant, ça me plaît, même si nous n'avons pas encore vu le restaurant."

# game/scripts/c15/c15.rpy:380
translate french c15s001_DapDate_35cd64fb:

    # mc "El vestido te queda increíble, y el peinado te hace preciosa... más preciosa de lo habitual."
    mc "Cette robe te va à merveille, et ta coiffure te rend magnifique… encore plus magnifique que d’habitude."

# game/scripts/c15/c15.rpy:382
translate french c15s001_DapDate_08e27722:

    # dap "Gracias, pero debería haberme quedado con mi trenza. También pega con el vestido y hubiera estado más cómoda. No me siento demasiado confortable con esto."
    dap "Merci, mais j'aurais dû garder ma tresse. Elle allait bien avec la robe et j'aurais été plus à l'aise. Je ne me sens pas très à l'aise comme ça."

# game/scripts/c15/c15.rpy:383
translate french c15s001_DapDate_b7322079:

    # mc "Bueno, cuando volvamos al vestuario tendrás que devolver todo, incluidos los anillos del pelo. Solo será una hora o dos, ¿no?"
    mc "D'accord, quand on retournera aux vestiaires, tu devras tout rendre, y compris les élastiques à cheveux. Ça ne prendra qu'une heure ou deux, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:385
translate french c15s001_DapDate_b001bca2:

    # "Atravesáis todo el restaurante y Mathilda os lleva a una zona que parece tranquila. El restaurante parece salido de una película. Al menos es una de aquellas películas donde todo está limpio."
    "Vous traversez tout le restaurant et Mathilda vous conduit dans un coin tranquille. Le restaurant semble tout droit sorti d'un film. Du moins, c'est un de ces films où tout est impeccable."

# game/scripts/c15/c15.rpy:387
translate french c15s001_DapDate_f87f2ef8:

    # "Mathilda" "Hoy está bastante vacío, y esta es la zona más resguardada de miradas ajenas. ¿Les va bien sentarse aquí?"
    "Mathilda" "C'est presque vide aujourd'hui, et c'est l'endroit le plus isolé. Pourriez-vous vous asseoir ici ?"

# game/scripts/c15/c15.rpy:388
translate french c15s001_DapDate_39d84591:

    # mc "Gracias, Mathilda, es perfecto."
    mc "Merci Mathilda, c'est parfait."

# game/scripts/c15/c15.rpy:389
translate french c15s001_DapDate_a8caf72d:

    # "Mathilda" "¿Saben cómo funciona el menú? Si quieren se lo explico."
    "Mathilda" "Savez-vous comment fonctionne le menu ? Si vous le souhaitez, je peux vous l'expliquer."

# game/scripts/c15/c15.rpy:390
translate french c15s001_DapDate_8b13deee:

    # mc "Sí, por favor."
    mc "Oui s'il vous plait."

# game/scripts/c15/c15.rpy:391
translate french c15s001_DapDate_a1ac9ffa:

    # "Mathilda" "Nuestros platos son típicos de la Europa medieval, pero con un toque moderno, con lo que pueden encontrar ingredientes como patata o maíz, que no estaban disponibles en la época."
    "Mathilda" "Nos plats sont typiques de l'Europe médiévale, mais avec une touche de modernité ; vous y trouverez donc peut-être des ingrédients comme des pommes de terre ou du maïs, qui n'étaient pas disponibles à l'époque."

# game/scripts/c15/c15.rpy:392
translate french c15s001_DapDate_72902248:

    # "Mathilda" "Nosotros recomendamos el menú degustación mixto, de carne, o de pescado, donde podrán disfrutar de algunas de nuestras especialidades. También pueden pedir platos individuales."
    "Mathilda" "Nous vous recommandons le menu dégustation mixte, avec viande ou poisson, qui vous permettra de savourer quelques-unes de nos spécialités. Vous pouvez également commander des plats individuels."

# game/scripts/c15/c15.rpy:394
translate french c15s001_DapDate_9603f8f9:

    # dap "Yo querré el menú degustación mixto. Y cerveza tostada para beber."
    dap "Je prendrai le menu dégustation mixte. Et une bière brune pour accompagner."

# game/scripts/c15/c15.rpy:395
translate french c15s001_DapDate_33d9f672:

    # mc "¿Qué platos individuales tienen? Cosas con carne, por favor."
    mc "Quels plats individuels proposez-vous ? Des plats à base de viande, s'il vous plaît."

# game/scripts/c15/c15.rpy:397
translate french c15s001_DapDate_8f5494fa:

    # "Mathilda" "Tenemos asado del pastor, que lleva patata sustituyendo al nabo, cazuela del granjero, que lleva maíz para sustituir a la avena, chuletas con salsa de calabaza, o albóndigas de ternera."
    "Mathilda" "Nous proposons du rôti de berger, préparé avec des pommes de terre à la place des navets, du ragoût fermier, préparé avec du maïs à la place de l'avoine, des côtelettes à la sauce au potiron ou des boulettes de bœuf."

# game/scripts/c15/c15.rpy:398
translate french c15s001_DapDate_a9336dad:

    # "Mathilda" "El menú degustación de carne consiste en asado del pastor, cazuela del granjero y las albóndigas de ternera. Normalmente lo recomendamos para compartir entre dos personas."
    "Mathilda" "Le menu dégustation de viandes comprend un rôti de berger, un ragoût fermier et des boulettes de bœuf. Nous le recommandons généralement pour deux personnes."

# game/scripts/c15/c15.rpy:399
translate french c15s001_DapDate_841d565c:

    # "Mathilda" "Con una ensalada o unas verduras para compartir como complemento."
    "Mathilda" "Servi avec une salade ou des légumes à partager."

# game/scripts/c15/c15.rpy:400
translate french c15s001_DapDate_044c02a7:

    # mc "¿Ensalada? ¿Verduras? *Risa* Esa es la comida de mi comida... Siempre he querido decir esa frase."
    mc "Salade ? Légumes ? *Rires* C'est ma nourriture... J'ai toujours rêvé de dire ça."

# game/scripts/c15/c15.rpy:412
translate french c15s001_DapDate_d26cabd8:

    # mc "Pero si algún plato lleva brócoli, no lo ponga, por favor. Soy alérgico."
    mc "Mais si un plat contient du brocoli, merci de ne pas en mettre. J'y suis allergique."

# game/scripts/c15/c15.rpy:413
translate french c15s001_DapDate_0b9b511f:

    # "Mathilda" "Como vuesa merced desee. ¿Para beber, señor?"
    "Mathilda" "Comme vous le souhaitez. À boire, monsieur ?"

# game/scripts/c15/c15.rpy:414
translate french c15s001_DapDate_40c4e7c6:

    # mc "Agua. Tengo que conducir luego."
    mc "De l'eau. Je dois conduire plus tard."

# game/scripts/c15/c15.rpy:416
translate french c15s001_DapDate_f4abf09d:

    # dap "Tráigale una cerveza tostada también a él. Vamos a tardar mucho en coger el coche."
    dap "Apporte-lui aussi une bière brune. On va mettre du temps à arriver à la voiture."

# game/scripts/c15/c15.rpy:418
translate french c15s001_DapDate_5663e49e:

    # "Mathilda" "Perfecto. Voy a cursar su pedido y ahora mismo les traigo la bebida."
    "Mathilda" "Parfait. Je vais traiter votre commande et vous apporter les boissons immédiatement."

# game/scripts/c15/c15.rpy:420
translate french c15s001_DapDate_ec98a50b:

    # dap "¿Desde cuándo eres alérgico al brócoli? No lo sabía."
    dap "Depuis quand es-tu allergique au brocoli ? Je ne le savais pas."

# game/scripts/c15/c15.rpy:421
translate french c15s001_DapDate_f6a5786d:

    # mc "*Risa* No soy alérgico, pero para mí estropea cualquier comida. Siempre digo \"si lleva brócoli no lo pongan\" y la mitad de las veces se olvidan."
    mc "*Rires* Je ne suis pas allergique, mais pour moi, ça gâche tout. Je dis toujours : « S'il y a du brocoli, n'en mettez pas », et la moitié du temps, ils oublient."

# game/scripts/c15/c15.rpy:422
translate french c15s001_DapDate_4db266ee:

    # mc "Diciendo que soy alérgico, van con cuidado de no ponerlo. No se han olvidado ni una sola vez."
    mc "Comme je dis que je suis allergique, ils font attention à ne pas l'appliquer. Ils ne l'ont jamais oublié."

# game/scripts/c15/c15.rpy:423
translate french c15s001_DapDate_de7990a8:

    # dap "Es una buena idea. Poco honesta, pero buena idea. Aunque si pidiéndolo correctamente no te hacen caso, es la única forma que te queda de hacerlo."
    dap "C'est une bonne idée. Un peu malhonnête, certes, mais une bonne idée. Ceci dit, s'ils ne vous écoutent pas quand vous leur demandez correctement, c'est la seule solution."

# game/scripts/c15/c15.rpy:425
translate french c15s001_DapDate_0799ddb5:

    # dap "Cambiando de tema, ¿qué te parece el sitio? Es original, ¿verdad?"
    dap "Pour changer de sujet, que pensez-vous du site ? Il est original, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:426
translate french c15s001_DapDate_71dbec9b:

    # mc "Es muy original, e ir así vestidos le da un giro interesante, es como si tuvieras una inmersión total."
    mc "C'est très original, et s'habiller comme ça donne une touche intéressante ; c'est comme une immersion totale."

# game/scripts/c15/c15.rpy:427
translate french c15s001_DapDate_6ef36d5e:

    # dap "Yo siempre he querido probar algo así, sentirte dentro de una partida de DnD, aunque solo sea durante la cena."
    dap "J'ai toujours voulu essayer quelque chose comme ça, avoir l'impression d'être plongé dans une partie de Donjons et Dragons, même si ce n'est que pendant le dîner."

# game/scripts/c15/c15.rpy:428
translate french c15s001_DapDate_4951d89e:

    # mc "Si en la partida visitamos una taberna o una posada, será difícil imaginársela diferente a esto."
    mc "Si, dans le jeu, nous visitons une taverne ou une auberge, il sera difficile de l'imaginer autrement."

# game/scripts/c15/c15.rpy:430
translate french c15s001_DapDate_4bc16d01:

    # dap "Esa era una de las razones para traerte aquí. *Risa* Quiero que sepas qué cosas me gustan. No hemos tenido mucho tiempo de hablar de hobbies y nimiedades."
    dap "C'est une des raisons pour lesquelles je t'ai amené ici. *Rires* Je veux que tu saches ce que j'aime. On n'a pas eu beaucoup de temps pour parler de loisirs et de choses futiles."

# game/scripts/c15/c15.rpy:431
translate french c15s001_DapDate_40e70b21:

    # mc "Bueno, sé que te gusta estudiar, leer y aprender, los videojuegos, los juegos de rol... ¿la música pop?"
    mc "Eh bien, je sais que tu aimes étudier, lire et apprendre, les jeux vidéo, les jeux de rôle... la musique pop ?"

# game/scripts/c15/c15.rpy:432
translate french c15s001_DapDate_f77f275c:

    # dap "*Risa* Sí, la música pop. Si llegas a fallar en eso... Te hubiera torturado con los peores discos de Taylor Shift. *Risa*"
    dap "*Rires* Ouais, la pop. Si tu avais raté ça… je t'aurais torturé avec les pires albums de Taylor Shift. *Rires*"

# game/scripts/c15/c15.rpy:434
translate french c15s001_DapDate_0ae8448f:

    # dap "Pero a lo que me refiero es a que me encanta este ambiente. Hacer cosas diferentes. No soy tan aventurera como [emm], pero en un sitio así me siento... especial."
    dap "Mais ce que je veux dire, c'est que j'adore cette ambiance. Faire des choses différentes. Je ne suis pas aussi aventurière que [emm], mais dans un endroit comme celui-ci, je me sens… spéciale."

# game/scripts/c15/c15.rpy:435
translate french c15s001_DapDate_70fffa0f:

    # mc "[dap], tú eres especial. Nunca se me hubiera ocurrido venir a un restaurante así, con lo que la noche ya es diferente."
    mc "[dap], tu es exceptionnel(le). Je n'aurais jamais pensé venir dans un restaurant comme celui-ci, alors la soirée est déjà différente."

# game/scripts/c15/c15.rpy:436
translate french c15s001_DapDate_251aa2ff:

    # mc "Pasarla contigo, vestida así, la hace verdaderamente especial."
    mc "Passer ce moment avec toi, habillée comme ça, le rend vraiment spécial."

# game/scripts/c15/c15.rpy:438
translate french c15s001_DapDate_7937683b:

    # dap "No creía que vestirme de molinera para una cita fuera lo mejor, lo mismo que de tabernera. Imagínate que las otras mesas empiezan a pedirme cosas. *Risa*"
    dap "Je ne pensais pas que me déguiser en femme de meunier pour un rendez-vous était une bonne idée, ni en serveuse de taverne. Imaginez si les autres tables commençaient à me demander des choses ! *Rires*"

# game/scripts/c15/c15.rpy:439
translate french c15s001_DapDate_5e2c75b5:

    # mc "Vestida de tabernera seguro que estabas monísima, pero no puedo imaginarme a una molinera sexy. *Risa* Ni siquiera a ti."
    mc "Déguisée en serveuse de taverne, tu devais être adorable, mais je n'arrive pas à t'imaginer en femme de meunier sexy. *Rires* Même pas toi."

# game/scripts/c15/c15.rpy:440
translate french c15s001_DapDate_51b8bcd3:

    # dap "Había un disfraz de guerrera, pero seguía la norma de Hollywood para las armaduras femeninas de que cuanto menos cubra más protege. *Risa*"
    dap "Il y avait bien un costume de guerrière, mais il suivait la règle hollywoodienne des armures féminines : moins il couvre, plus il protège. *Rires*"

# game/scripts/c15/c15.rpy:441
translate french c15s001_DapDate_f95f3509:

    # mc "Interesante. No me hubiera importado verte así. *Risa*"
    mc "Intéressant. Ça ne m'aurait pas dérangé de te voir comme ça. *Rires*"

# game/scripts/c15/c15.rpy:442
translate french c15s001_DapDate_0c601860:

    # dap "No seas impaciente. *Risa* Me verás con menos cobertura hoy... si quieres..."
    dap "Soyez patient. *Rires* Vous me verrez moins couvert aujourd'hui... si vous le souhaitez..."

# game/scripts/c15/c15.rpy:443
translate french c15s001_DapDate_a49f5d57:

    # mc "Por supuesto que quiero, si es lo que quieres tú."
    mc "Bien sûr que je veux bien, si c'est ce que vous voulez."

# game/scripts/c15/c15.rpy:445
translate french c15s001_DapDate_8433b02a:

    # dap "Llevo deseándolo desde nuestra segunda lección. Con lo que sí. Es lo que quiero."
    dap "Je le souhaite depuis notre deuxième leçon. Alors oui, c'est ce que je veux."

# game/scripts/c15/c15.rpy:446
translate french c15s001_DapDate_7e494062:

    # mc "Yo también llevo tiempo deseándolo."
    mc "Moi aussi, j'en ai envie depuis un moment."

# game/scripts/c15/c15.rpy:447
translate french c15s001_DapDate_9a30c032:

    # "Justo en ese momento, Mathilda trae las cervezas."
    "C’est alors que Mathilda apporte les bières."

# game/scripts/c15/c15.rpy:449
translate french c15s001_DapDate_849e9eb6:

    # dap "Por una noche especial con mi novio. Mi primer novio."
    dap "Pour une soirée spéciale avec mon petit ami. Mon premier petit ami."

# game/scripts/c15/c15.rpy:450
translate french c15s001_DapDate_4fab5f29:

    # mc "Por la chica más especial de la noche."
    mc "Pour la fille la plus spéciale de la soirée."

# game/scripts/c15/c15.rpy:452
translate french c15s001_DapDate_f9c75c73:

    # dap "¡Está buenísima!"
    dap "C'est délicieux !"

# game/scripts/c15/c15.rpy:453
translate french c15s001_DapDate_f057ccd6:

    # mc "*Risa*"
    mc "*Rire*"

# game/scripts/c15/c15.rpy:455
translate french c15s001_DapDate_a147bdfe:

    # dap "¿Qué pasa?"
    dap "Ce qui se passe?"

# game/scripts/c15/c15.rpy:456
translate french c15s001_DapDate_adaea1c1:

    # mc "Que estás super graciosa con el bigote de espuma, aunque no te pega con el vestido. *Risa* Te pegaría más con un uniforme de fontanero y una gorra roja."
    mc "Tu as l'air tellement drôle avec cette moustache en mousse, même si elle ne va pas vraiment avec la robe. *Rires* Tu serais plus à ton avantage en uniforme de plombier et avec une casquette rouge."

# game/scripts/c15/c15.rpy:458
translate french c15s001_DapDate_55ee868d:

    # dap "¡Oops, perdón! *Risa* Tendré que beber como una princesita."
    dap "Oups, pardon ! *Rires* Je vais devoir boire comme une princesse."

# game/scripts/c15/c15.rpy:459
translate french c15s001_DapDate_536b041f:

    # mc "*Risa*. Ya te he dicho que estabas muy graciosa."
    mc "*Rires*. Je t'avais déjà dit que tu étais très drôle."

# game/scripts/c15/c15.rpy:461
translate french c15s001_DapDate_2be763cd:

    # dap "Pero no quiero estar graciosa. Quiero estar guapa y sexy para ti en nuestra primera cita."
    dap "Mais je ne veux pas avoir l'air mignonne. Je veux être belle et sexy pour toi lors de notre premier rendez-vous."

# game/scripts/c15/c15.rpy:462
translate french c15s001_DapDate_9b23af18:

    # mc "[dap], ya te he dicho que estabas preciosa. Y lo de estar sexy lo llevas dentro, no tienes que hacer nada especial para estarlo."
    mc "[dap], je t'ai déjà dit que tu étais magnifique. Et tu es naturellement sexy, tu n'as rien de spécial à faire pour l'être."

# game/scripts/c15/c15.rpy:464
translate french c15s001_DapDate_7a902e65:

    # dap "Entonces, ¿me harías el amor esta noche, aunque no llevase este vestido?"
    dap "Alors, me ferais-tu l'amour ce soir, même si je ne portais pas cette robe ?"

# game/scripts/c15/c15.rpy:465
translate french c15s001_DapDate_87bc4363:

    # mc "Espero que cuando hagamos el amor no lo lleves. *Risa* Pero sí, te haría el amor aunque fueras con un saco de patatas en vez de con ese vestido."
    mc "J'espère que tu ne la porteras pas quand on fera l'amour. *Rires* Mais oui, je te ferais l'amour même si tu portais un sac à patates à la place de cette robe."

# game/scripts/c15/c15.rpy:467
translate french c15s001_DapDate_b4286511:

    # dap "Perfecto, porque no pienso dejarte escapar esta noche."
    dap "Parfait, car je n'ai pas l'intention de te laisser t'échapper ce soir."

# game/scripts/c15/c15.rpy:468
translate french c15s001_DapDate_c00e8be0:

    # mc "No tengo intención de escaparme. Esta noche soy todo para ti."
    mc "Je n'ai aucune intention de m'enfuir. Ce soir, je suis toute à toi."

# game/scripts/c15/c15.rpy:470
translate french c15s001_DapDate_5661754e:

    # dap "Sabes que, si seguimos hablando de esto, voy a estar pensando en lo que pasará después toda la cena, ¿verdad?"
    dap "Tu sais bien que si on continue à parler de ça, je vais penser à ce qui va se passer ensuite pendant tout le dîner, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:471
translate french c15s001_DapDate_1c835586:

    # mc "¿Quieres cambiar de tema?"
    mc "Voulez-vous changer de sujet ?"

# game/scripts/c15/c15.rpy:473
translate french c15s001_DapDate_402ecb75:

    # dap "El problema es que ahora mismo solo me apetece hablar sobre nosotros y de nuestra relación."
    dap "Le problème, c'est que là tout de suite, j'ai juste envie de parler de nous et de notre relation."

# game/scripts/c15/c15.rpy:474
translate french c15s001_DapDate_f01e22f5:

    # dap "Sobre qué piensas que va a pasar con nosotros... somos primos..."
    dap "À votre avis, que va-t-il nous arriver… nous sommes cousins…"

# game/scripts/c15/c15.rpy:475
translate french c15s001_DapDate_8e9f18ea:

    # mc "Me da lo mismo que lo seamos, [dap]."
    mc "Je m'en fiche si nous le sommes, [dap]."

# game/scripts/c15/c15.rpy:477
translate french c15s001_DapDate_81e21e06:

    # mc "Y más teniendo en cuenta que los dos sabemos que no lo somos."
    mc "Et d'autant plus que nous savons tous les deux que nous ne le sommes pas."

# game/scripts/c15/c15.rpy:479
translate french c15s001_DapDate_15000879:

    # dap "Lo sé, pero todo el mundo piensa que sí. Bueno, todo el mundo no. Mi madre lo sabe y lógicamente la tuya también... y la abuela... y Tía Betty, supongo... Y a Scarlett se lo dije yo."
    dap "Je sais, mais tout le monde le croit. Enfin, pas tout le monde. Ma mère le sait, et la vôtre aussi, logiquement… et grand-mère… et tante Betty, j’imagine… Et je l’ai dit à Scarlett."

# game/scripts/c15/c15.rpy:482
translate french c15s001_DapDate_cbdc2f5d:

    # dap "Pero ¿qué pensará la gente si lo hacemos público? ¿Mi hermana o la tuya? ¿Eileen o Jamaal? Ya viste las caras de las estudiantes cuando me besaste durante el juego."
    dap "Mais que penseront les gens si nous rendons cela public ? Ma sœur ou la tienne ? Eileen ou Jamaal ? Tu as vu la tête des élèves quand tu m’as embrassée pendant le match."

# game/scripts/c15/c15.rpy:483
translate french c15s001_DapDate_ec193f05:

    # mc "¿Te soy sincero? No me importa lo que piensen. Lo único que deben pensar es que estoy con una chica maravillosa que me hace feliz."
    mc "Franchement, je me fiche de ce qu'ils pensent. La seule chose qu'ils devraient penser, c'est que je suis avec une fille merveilleuse qui me rend heureux."

# game/scripts/c15/c15.rpy:484
translate french c15s001_DapDate_4b28ab0d:

    # mc "Quiero pasar el resto de mi vida contigo, [dap]. Quiero que envejezcamos juntos. Quiero que sepas lo importante que eres para mí. Y quiero que todo el mundo lo sepa también."
    mc "Je veux passer le reste de ma vie avec toi. Je veux qu'on vieillisse ensemble. Je veux que tu saches à quel point tu comptes pour moi. Et je veux que tout le monde le sache aussi."

# game/scripts/c15/c15.rpy:485
translate french c15s001_DapDate_6e91adb8:

    # mc "¿Y a ti? ¿Te importa lo que piensen los demás?"
    mc "Et vous ? Vous vous souciez de ce que pensent les autres ?"

# game/scripts/c15/c15.rpy:487
translate french c15s001_DapDate_b25e09cd:

    # dap "Después de lo que acabas de decir... no debería decir que me importe... pero me importa. No sé cómo decírselo a mi hermana. O al resto de la familia."
    dap "Après ce que tu viens de dire… je ne devrais pas dire que ça me touche… mais c’est le cas. Je ne sais pas comment l’annoncer à ma sœur. Ni au reste de la famille."

# game/scripts/c15/c15.rpy:488
translate french c15s001_DapDate_da0cbb2a:

    # dap "Quiero hacerlo, pero no sé cómo... cualquier escenario que en el que puedo pensar acaba en discusión... con mi madre, con la tuya, con la abuela..."
    dap "J'aimerais bien le faire, mais je ne sais pas comment… tous les scénarios auxquels je pense finissent par une dispute… avec ma mère, avec la tienne, avec ta grand-mère…"

# game/scripts/c15/c15.rpy:489
translate french c15s001_DapDate_0962fc03:

    # mc "Se lo puedes decir con un beso..."
    mc "Tu peux le lui dire avec un baiser..."

# game/scripts/c15/c15.rpy:491
translate french c15s001_DapDate_5d11e3dd:

    # dap "¡[mc]! ¡Ya te dije que no beso a chicas! ¡Lo de Scarlett fue solo para aprender!"
    dap "[mc]! Je t'ai déjà dit que je n'embrasse pas les filles ! Ce que j'ai fait avec Scarlett, c'était juste pour apprendre !"

# game/scripts/c15/c15.rpy:492
translate french c15s001_DapDate_56c18a7f:

    # mc "*Risa* No me refería a que las besaras a ellas, sino a que me besaras a mí delante de ellas."
    mc "*Rires* Je ne voulais pas que tu les embrasses, mais que tu m'embrasses devant eux."

# game/scripts/c15/c15.rpy:494
translate french c15s001_DapDate_7d70a208:

    # "La conversación es interrumpida por Mathilda, que llega con la comida."
    "La conversation est interrompue par Mathilda, qui arrive avec la nourriture."

# game/scripts/c15/c15.rpy:495
translate french c15s001_DapDate_c957812e:

    # "Mathilda" "Aquí traigo su yantar. Disfruten de nuestros manjares. ¿Puedo ofrecerles algo más a vuesas mercedes?"
    "Mathilda" "Voici votre repas. Savourez nos mets délicieux. Puis-je vous proposer autre chose ?"

# game/scripts/c15/c15.rpy:497
translate french c15s001_DapDate_370648d3:

    # dap "Por mí no, gracias. Esto tiene una pinta deliciosa."
    dap "Non merci, ça ne me convient pas. Ça a l'air délicieux."

# game/scripts/c15/c15.rpy:498
translate french c15s001_DapDate_7abb4579:

    # mc "Por mí tampoco, gracias."
    mc "Moi non plus, merci."

# game/scripts/c15/c15.rpy:500
translate french c15s001_DapDate_0871ec30:

    # dap "Esto tiene una pinta excelente. ¿Qué tal lo tuyo?"
    dap "Ça a l'air super. Comment ça va de ton côté ?"

# game/scripts/c15/c15.rpy:511
translate french c15s001_DapDate_3d866d0f:

    # mc "Tiene muy buena pinta. Cuidan hasta el mínimo detalle, fíjate en los platos."
    mc "C'est vraiment magnifique. Ils font attention au moindre détail, il suffit de regarder la vaisselle."

# game/scripts/c15/c15.rpy:513
translate french c15s001_DapDate_e06be625:

    # dap "Ya te he dicho que tenía ganas de venir. Los comentarios en ThreeSquare eran muy buenos para un sitio que lleva tan poco tiempo abierto. ¿Empezamos?"
    dap "Je vous ai déjà dit que j'avais hâte de venir. Les avis sur Threesquare étaient vraiment excellents pour un endroit qui vient d'ouvrir. On commence ?"

# game/scripts/c15/c15.rpy:514
translate french c15s001_DapDate_e8380814:

    # mc "Sí, pero estábamos hablando de hacer público lo nuestro."
    mc "Oui, mais nous parlions de rendre notre relation publique."

# game/scripts/c15/c15.rpy:516
translate french c15s001_DapDate_8dc912e1:

    # dap "Sí, y tú has dicho que te bese delante de mi madre o de [eri]. *Risa* Estás loco. ¿O crees que soy tonta?"
    dap "Oui, et tu as dit que je devais t'embrasser devant ma mère ou [eri]. *Rires* Tu es fou. Ou tu me prends pour un imbécile ?"

# game/scripts/c15/c15.rpy:518
translate french c15s001_DapDate_ac41c310:

    # mc "No es tan mala idea. Ha funcionado con anterioridad."
    mc "Ce n'est pas une si mauvaise idée. Ça a déjà fonctionné."

# game/scripts/c15/c15.rpy:520
translate french c15s001_DapDate_1faf8f84:

    # dap "{b}¿Qué? ¿Quién? ¿Cuándo?{/b} ¿Cómo se lo tomaron?"
    dap "{b}Quoi ? Qui ? Quand ?{/b} Comment l'ont-ils pris ?"

# game/scripts/c15/c15.rpy:521
translate french c15s001_DapDate_6f4149b0:

    # mc "Sigo vivo, con lo que la cosa no acabó mal. *Risa*"
    mc "Je suis encore en vie, donc ça ne s'est pas trop mal terminé. *Rires*"

# game/scripts/c15/c15.rpy:523
translate french c15s001_DapDate_9273e56e:

    # mc "No me parece una mala idea. Eres tú quien tiene que decidir si quieres que lo sepan y cuando quieres que lo sepan."
    mc "Je ne pense pas que ce soit une mauvaise idée. C'est à vous de décider si et quand vous voulez qu'ils le sachent."

# game/scripts/c15/c15.rpy:525
translate french c15s001_DapDate_f6f171e5:

    # dap "Yo no podría hacerlo. Sabes que soy más de hablar que de actuar."
    dap "Je n'ai pas pu le faire. Tu sais que je suis plus bavard qu'actif."

# game/scripts/c15/c15.rpy:526
translate french c15s001_DapDate_8adad7a1:

    # mc "Entonces tendremos que buscar el momento correcto para explicarlo. O puedo besarte yo."
    mc "Il faudra alors trouver le bon moment pour t'expliquer. Ou alors, je peux t'embrasser."

# game/scripts/c15/c15.rpy:527
translate french c15s001_DapDate_f1a13d58:

    # dap "Prefiero hablarlo, a ser posible de una en una. Primero [eri], después mi madre. Con un poco de suerte cuando le toque a la abuela ya estará de nuevo en Florida."
    dap "Je préfère en parler, si possible une personne à la fois. D'abord ma mère, puis ma grand-mère. Avec un peu de chance, quand ce sera au tour de ma grand-mère, elle sera de retour en Floride."

# game/scripts/c15/c15.rpy:528
translate french c15s001_DapDate_2ee09558:

    # mc "¡Cuánto miedo le tenéis todas a Meemaw!"
    mc "Comme vous avez tous peur de Mémé !"

# game/scripts/c15/c15.rpy:530
translate french c15s001_DapDate_fcd16a07:

    # dap "¿Le tenemos? ¿Todas? ¿Quién más?"
    dap "L'avons-nous ? Tous ? Qui d'autre ?"

# game/scripts/c15/c15.rpy:531
translate french c15s001_DapDate_9eeedcfb:

    # mc "Ermmm... tu madre, por ejemplo. Desde que sabemos que venía, ha estado preocupada sobre lo que diría sobre la casa... y esas cosas..."
    mc "Euh… ta mère, par exemple. Depuis qu’on a su qu’elle venait, elle s’inquiète de ce qu’elle dirait de la maison… et de choses comme ça…"

# game/scripts/c15/c15.rpy:533
translate french c15s001_DapDate_743b8e3d:

    # dap "Ah, vale, te refieres a eso. ¡Qué susto! Creía que te referías a que estabas con alguien más de la familia... y no estoy preguntando porque sé que no vas a contestar."
    dap "Ah, d'accord, c'est donc ça que tu voulais dire. Quelle frayeur ! Je croyais que tu étais avec quelqu'un d'autre de la famille… et je ne te pose pas la question parce que je sais que tu ne répondras pas."

# game/scripts/c15/c15.rpy:535
translate french c15s001_DapDate_6b4a6a87:

    # dap "Pero volviendo al tema encima de la mesa. Tú querrías hacerlo público y yo no estoy preparada. ¿Te importa que nos lo tomemos con calma?"
    dap "Pour en revenir à nos moutons, vous aimeriez le rendre public, et je ne suis pas prêt(e). Serait-il possible d'y aller doucement ?"

# game/scripts/c15/c15.rpy:536
translate french c15s001_DapDate_a38cc4aa:

    # mc "Mientras me sigas dejando disfrutar de tu compañía, mientras me dejes seguir besándote y acariciándote, no me importa quién lo sepa."
    mc "Tant que tu me laisses profiter de ta compagnie, tant que tu me laisses continuer à t'embrasser et à te caresser, je me fiche de qui le sait."

# game/scripts/c15/c15.rpy:537
translate french c15s001_DapDate_f8bd74f2:

    # mc "¿Preferiría poder llegar a casa y decírselo a todo el mundo? Por supuesto, pero no te voy a forzar a ello."
    mc "Tu préférerais rentrer chez toi et le raconter à tout le monde ? Bien sûr, mais je ne vais pas t’y obliger."

# game/scripts/c15/c15.rpy:539
translate french c15s001_DapDate_4816d419:

    # dap "Gracias, [mc]."
    dap "Merci, [mc]."

# game/scripts/c15/c15.rpy:540
translate french c15s001_DapDate_6811d74a:

    # dap "Cambiando de tema, ¿cómo nos ves en cinco años?"
    dap "Pour changer de sujet, comment nous voyez-vous dans cinq ans ?"

# game/scripts/c15/c15.rpy:541
translate french c15s001_DapDate_66e93671:

    # mc "Eso es más una pregunta para una entrevista de trabajo que para una cita. *Risa* Pero es fácil de contestar."
    mc "C'est plutôt une question d'entretien d'embauche qu'une question pour un rendez-vous amoureux. *Rires* Mais la réponse est facile."

# game/scripts/c15/c15.rpy:544
translate french c15s001_DapDate_58ea6be9:

    # mc "Me gustaría tener, como mínimo, una pequeña [dap] correteando por casa."
    mc "J'aimerais avoir, à tout le moins, un petit [dap] qui court partout dans la maison."

# game/scripts/c15/c15.rpy:545
translate french c15s001_DapDate_8513a3d6:

    # mc "Me gustaría que hubieras acabado tus estudios y encontrases algún trabajo que te llenara en un sitio donde pudiéramos estar juntos."
    mc "J'aurais aimé que tu aies terminé tes études et trouvé un travail épanouissant dans un endroit où nous pourrions être ensemble."

# game/scripts/c15/c15.rpy:547
translate french c15s001_DapDate_a91faff1:

    # mc "Me gustaría que mirásemos hacia atrás, a esta noche, y pensáramos \"¿Ya han pasado cinco años?\" y nos sorprendiéramos."
    mc "J'aimerais que nous nous souvenions de cette soirée et que nous nous demandions : « Cinq ans déjà ? » et que nous soyons surpris."

# game/scripts/c15/c15.rpy:549
translate french c15s001_DapDate_664e0fa8:

    # mc "Me gustaría que de lo único que nos arrepintiéramos fuera de no haber empezado antes, de haber desperdiciado unos preciosos días juntos."
    mc "Je voudrais que notre seul regret soit de ne pas avoir commencé plus tôt, d'avoir gâché de précieux jours ensemble."

# game/scripts/c15/c15.rpy:551
translate french c15s001_DapDate_7928fb23:

    # dap "¡Joder, [mc]! ¡No podías haber dicho algo más bonito!"
    dap "Putain, [mc] ! Tu n'aurais pas pu dire quelque chose de plus gentil !"

# game/scripts/c15/c15.rpy:552
translate french c15s001_DapDate_00a4148f:

    # mc "No se lo podía haber dicho a alguien más bonita."
    mc "Je n'aurais pas pu le dire à une plus jolie personne."

# game/scripts/c15/c15.rpy:554
translate french c15s001_DapDate_ff938204:

    # dap "¡Un brindis porque todo lo que has dicho se cumpla!"
    dap "Je vous souhaite que tout ce que vous avez prédit se réalise !"

# game/scripts/c15/c15.rpy:555
translate french c15s001_DapDate_299c3501:

    # mc "¡Brindo por ello!"
    mc "À votre santé !"

# game/scripts/c15/c15.rpy:557
translate french c15s001_DapDate_4f20587c:

    # dap "Veo que lo de beber como una princesa no se me da bien. A lo mejor puedo trabajar aquí de tabernera. *Risa*"
    dap "Je suppose que boire comme une princesse n'est pas mon fort. Je pourrais peut-être travailler ici comme serveuse. *Rires*"

# game/scripts/c15/c15.rpy:558
translate french c15s001_DapDate_c5a66d6b:

    # mc "Es posible. *Risa* Pero siempre serás mi princesa. Tengo una duda."
    mc "C'est possible. *Rires* Mais tu seras toujours ma princesse. J'ai une question."

# game/scripts/c15/c15.rpy:559
translate french c15s001_DapDate_031bfa8a:

    # dap "Dime."
    dap "Dites-moi."

# game/scripts/c15/c15.rpy:561
translate french c15s001_DapDate_3b5ddfbc:

    # mc "Has brindado por que se cumpla todo. ¿Todo? ¿Incluida la pequeña [dap]?"
    mc "Vous avez porté un toast à la réalisation de tous vos souhaits. De tous vos souhaits ? Y compris celui du petit bout de chou ?"

# game/scripts/c15/c15.rpy:563
translate french c15s001_DapDate_80f8b652:

    # dap "*Susurrando* ¿Tú has traído condones? Porque yo no estoy con la pastilla, nunca la he necesitado, y no voy a empezar ahora."
    dap "*Chuchotant* Tu as apporté des préservatifs ? Parce que je ne prends pas la pilule, je n’en ai jamais eu besoin et je ne vais pas commencer maintenant."

# game/scripts/c15/c15.rpy:564
translate french c15s001_DapDate_d1122d1c:

    # mc "No, no he traído."
    mc "Non, je n'en ai pas apporté."

# game/scripts/c15/c15.rpy:566
translate french c15s001_DapDate_31abef77:

    # dap "Entonces podemos ir a comprarlos cuando acabemos de cenar, o podemos hacer el primer intento de hacer a la pequeña [dap]."
    dap "Ensuite, nous pourrons aller les acheter une fois le dîner terminé, ou bien nous pourrons faire une première tentative pour fabriquer le petit [dap]."

# game/scripts/c15/c15.rpy:567
translate french c15s001_DapDate_d61cf959:

    # dap "Hoy quiero hacer el amor contigo, si quieres con condón, si quieres sin. No me da miedo quedarme embarazada. Sé que voy a pasar el resto de mi vida contigo."
    dap "Aujourd'hui, j'ai envie de faire l'amour avec toi, avec un préservatif si tu veux, ou sans si tu préfères. Je n'ai pas peur de tomber enceinte. Je sais que je vais passer le reste de ma vie avec toi."

# game/scripts/c15/c15.rpy:568
translate french c15s001_DapDate_774417e9:

    # dap "Y no quiero que, dentro de cinco años, cuando miremos hacia atrás, a esta noche, nos arrepintamos de no haberlo hecho."
    dap "Et je ne veux pas que, dans cinq ans, nous repensions à cette soirée et regrettions de ne pas l'avoir fait."

# game/scripts/c15/c15.rpy:569
translate french c15s001_DapDate_81d9ec17:

    # dap "La pequeña [dap] va a tener una gran familia. Quiero que la disfrute el máximo de tiempo posible."
    dap "La petite [dap] va avoir une grande famille. Je veux qu'elle en profite le plus longtemps possible."

# game/scripts/c15/c15.rpy:570
translate french c15s001_DapDate_cb2a79b5:

    # mc "Sabes que ahora mismo me podría levantar y besarte, ¿verdad?"
    mc "Tu sais que je pourrais me lever et t'embrasser maintenant, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:572
translate french c15s001_DapDate_9f80b391:

    # dap "Después del discurso que acabo de soltar, me están temblando las piernas. Pero si te levantas y me besas, nos vamos a tener que ir sin acabar de cenar. Dudo que pudiera parar."
    dap "Après ce discours, j'ai les jambes qui tremblent. Mais si tu te lèves et m'embrasses, on devra partir sans finir de dîner. Je doute que je puisse m'en empêcher."

# game/scripts/c15/c15.rpy:573
translate french c15s001_DapDate_14cf106f:

    # dap "Mejor guarda esos besos para cuando estemos solos. Los vas a necesitar."
    dap "Garde ces baisers pour quand on sera seuls. Tu vas en avoir besoin."

# game/scripts/c15/c15.rpy:574
translate french c15s001_DapDate_f393e816:

    # mc "No te preocupes, no se agotan."
    mc "Ne vous inquiétez pas, ils ne sont pas en rupture de stock."

# game/scripts/c15/c15.rpy:575
translate french c15s001_DapDate_02d88677:

    # mc "¿Tienes pensado algún nombre para la pequeña [dap]?"
    mc "Avez-vous déjà pensé à un prénom pour le petit ?"

# game/scripts/c15/c15.rpy:577
translate french c15s001_DapDate_a53f9b89:

    # dap "Sí. Me gustan Maeve y Claire. También me gusta Hope, pero es un nombre que [eri] siempre ha querido ponerle a nuestra hermana, si mi madre encontraba a alguien."
    dap "Oui. J'aime bien Maeve et Claire. J'aime aussi Hope, mais c'est un prénom que [eri] a toujours voulu donner à notre sœur, si jamais ma mère trouvait quelqu'un."

# game/scripts/c15/c15.rpy:578
translate french c15s001_DapDate_995bee38:

    # dap "Supongo que con la edad que tiene mi madre, ese nombre pasará a la hija de [eri] cuando ella encuentre un chico que valga la mitad de lo que vales tú."
    dap "Je suppose qu'avec l'âge de ma mère, ce nom sera transmis à la fille de [eri] lorsqu'elle trouvera un garçon qui vaut la moitié de ce que tu vaux."

# game/scripts/c15/c15.rpy:579
translate french c15s001_DapDate_5c01de9c:

    # mc "Me gustan los dos nombres. *Risa* Podemos seguir tu tradición familiar y tener gemelas."
    mc "J'aime bien les deux prénoms. *Rires* On pourrait suivre la tradition familiale et avoir des jumeaux."

# game/scripts/c15/c15.rpy:581
translate french c15s001_DapDate_f9bc189f:

    # dap "Si pudiera elegirlo, las tendría. *Risa* Pero no es algo que se elija."
    dap "Si je pouvais choisir, je les prendrais. *Rires* Mais ce n'est pas un choix."

# game/scripts/c15/c15.rpy:582
translate french c15s001_DapDate_33851ada:

    # mc "Lo sé, pero sería bonito tener dos pequeñas [dap] correteando por casa en vez de solo una."
    mc "Je sais, mais ce serait agréable d'avoir deux petits qui courent partout dans la maison au lieu d'un seul."

# game/scripts/c15/c15.rpy:583
translate french c15s001_DapDate_d208f71f:

    # dap "Sí, sería bonito... pero todo se andará."
    dap "Oui, ce serait bien... mais tout finira par s'arranger."

# game/scripts/c15/c15.rpy:584
translate french c15s001_DapDate_cb7cbdfc:

    # mc "Sobre lo del trabajo, sé que vas a estudiar Química. ¿De qué quieres trabajar? ¿Qué posibilidades laborales tienes en Newport?"
    mc "Concernant le travail, je sais que tu vas étudier la chimie. Quel genre de travail t'intéresse ? Quelles sont les perspectives d'emploi à Newport ?"

# game/scripts/c15/c15.rpy:586
translate french c15s001_DapDate_3e2a869e:

    # dap "Enseñar en la NWU o en algún instituto. O investigación, que es lo que me gustaría, en la NWU o en la Cal Poly."
    dap "Enseigner à NWU ou dans un autre institut. Ou faire de la recherche, ce que je préférerais, à NWU ou à Cal Poly."

# game/scripts/c15/c15.rpy:587
translate french c15s001_DapDate_0d6cc6bb:

    # dap "En San Luís, en Paso Robles, o en Atascadero hay algunas empresas donde también podría trabajar. Pero vete a saber cómo estará el tema laboral en cuatro años."
    dap "À San Luis, Paso Robles ou Atascadero, il y a des entreprises où je pourrais aussi travailler. Mais qui sait comment sera le marché du travail dans quatre ans ?"

# game/scripts/c15/c15.rpy:588
translate french c15s001_DapDate_b1336de6:

    # mc "Con lo que podrías seguir viviendo en Newport, ¿no?"
    mc "Vous pourriez donc continuer à vivre à Newport, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:590
translate french c15s001_DapDate_96e39944:

    # dap "No lo sé. Me tendrían que contratar en alguno de esos sitios. Pero nunca había pensado en mudarme. Me gustaría vivir en Newport siempre. ¿Qué opinas?"
    dap "Je ne sais pas. Il faudrait que je trouve un emploi dans l'un de ces endroits. Mais je n'ai jamais pensé à déménager. J'aimerais vivre à Newport pour toujours. Qu'en penses-tu ?"

# game/scripts/c15/c15.rpy:591
translate french c15s001_DapDate_09dc82f3:

    # mc "Que me da lo mismo donde vivamos. Pero a mí también me gustaría quedarme en Newport."
    mc "L'endroit où nous vivons m'importe peu. Mais j'aimerais aussi rester à Newport."

# game/scripts/c15/c15.rpy:592
translate french c15s001_DapDate_d5379c54:

    # dap "¿Y tú? ¿Qué planes tienes para el futuro? Una vez el Dormitorio esté totalmente en marcha, vas a tener muy poco trabajo."
    dap "Et vous ? Quels sont vos projets d’avenir ? Une fois que le dortoir sera pleinement opérationnel, vous n’aurez presque plus rien à faire."

# game/scripts/c15/c15.rpy:593
translate french c15s001_DapDate_5bfdc0cd:

    # mc "He estado haciendo números, y no pintan bien. Con lo que pagan 12 chicas, y una vez se acabe la subvención extra que nos da la NWU, los números salen muy justos."
    mc "J'ai fait les calculs, et le constat est alarmant. Avec les frais de scolarité de 12 filles, et une fois la bourse supplémentaire de la NWU épuisée, la situation financière sera très tendue."

# game/scripts/c15/c15.rpy:595
translate french c15s001_DapDate_e871c428:

    # dap "¿Tan mal estamos?"
    dap "La situation est-elle vraiment si grave ?"

# game/scripts/c15/c15.rpy:596
translate french c15s001_DapDate_263a5054:

    # mc "Entre impuestos y los costes operativos estimados, quedarán un par de sueldos medianos. Somos tres personas trabajando, con lo que seguramente tendré que buscar algo. En Newport o alrededores."
    mc "Entre les impôts et les frais de fonctionnement estimés, il ne restera que l'équivalent de deux salaires moyens. Nous sommes trois à travailler, donc je devrai probablement chercher autre chose. À Newport ou dans les environs."

# game/scripts/c15/c15.rpy:597
translate french c15s001_DapDate_f9099e9b:

    # mc "La NWU nos subvenciona este año y el que viene, con lo que tengo tiempo para buscar algo."
    mc "L'université NWU nous subventionne cette année et l'année prochaine, j'ai donc le temps de chercher quelque chose."

# game/scripts/c15/c15.rpy:599
translate french c15s001_DapDate_62428f0a:

    # dap "Mierda. Si fueran cuatro años, yo podría aportar mis ingresos en vez de generar gastos, pero en dos años..."
    dap "Mince alors. Si c'était sur quatre ans, je pourrais contribuer avec mes revenus au lieu de générer des dépenses, mais en deux ans…"

# game/scripts/c15/c15.rpy:600
translate french c15s001_DapDate_a790315f:

    # mc "No es una noche para que te preocupes, cielo. Los dos primeros años estaremos bien, y después ya se verá. Pero no tendré problemas en encontrar trabajo en Newport o los alrededores."
    mc "Ne t'inquiète pas, chérie. On s'en sortira bien pendant les deux premières années, et après on verra. Mais je n'aurai aucun mal à trouver du travail à Newport ou dans les environs."

# game/scripts/c15/c15.rpy:602
translate french c15s001_DapDate_36bb7a11:

    # "En ese momento llega Mathilda..."
    "À ce moment-là, Mathilde arrive..."

# game/scripts/c15/c15.rpy:603
translate french c15s001_DapDate_2918b3d8:

    # "Mathilda" "¿Han disfrutado de la comida? ¿Puedo ofrecerles algún dulce?"
    "Mathilda" "Le repas vous a plu ? Puis-je vous offrir une douceur ?"

# game/scripts/c15/c15.rpy:604
translate french c15s001_DapDate_d2efded5:

    # mc "Estaba todo muy bueno, pero yo voy a tener que renunciar al postre."
    mc "Tout était très bon, mais je vais devoir renoncer au dessert."

# game/scripts/c15/c15.rpy:606
translate french c15s001_DapDate_46f7365e:

    # dap "Todo estaba exquisito, pero yo también voy a pasar. ¿Nos puede cargar la cuenta a la habitación?"
    dap "Tout était délicieux, mais je vais m'en passer aussi. Pouvez-vous facturer la note sur notre chambre ?"

# game/scripts/c15/c15.rpy:607
translate french c15s001_DapDate_26666239:

    # mc "¿Qué habitación?"
    mc "Quelle chambre ?"

# game/scripts/c15/c15.rpy:609
translate french c15s001_DapDate_2419419d:

    # dap "¡Hush, [mc]!"
    dap "Chut, [mc] !"

# game/scripts/c15/c15.rpy:610
translate french c15s001_DapDate_3bb8e5d7:

    # dap "La habitación está a nombre de Marks, [dap] Marks."
    dap "La chambre est au nom de Marks, [dap] Marks."

# game/scripts/c15/c15.rpy:612
translate french c15s001_DapDate_d994c62a:

    # "Mathilda" "Sin ningún problema. No olviden recoger sus cosas de los vestuarios, por la mañana estarán cerrados. Los disfraces los pueden dejar en la habitación."
    "Mathilda" "Pas de souci. N'oubliez pas de récupérer vos affaires dans les vestiaires ; ils seront fermés demain matin. Vous pouvez laisser vos costumes dans votre chambre."

# game/scripts/c15/c15.rpy:613
translate french c15s001_DapDate_eb5b17f9:

    # "Mathilda" "Esperamos verles de nuevo en nuestras instalaciones."
    "Mathilda" "Nous espérons vous revoir bientôt dans nos locaux."

# game/scripts/c15/c15.rpy:614
translate french c15s001_DapDate_ef11e901:

    # mc "Gracias, Mathilda. Creo que volveremos."
    mc "Merci, Mathilda. Je pense que nous reviendrons."

# game/scripts/c15/c15.rpy:616
translate french c15s001_DapDate_381c9caa:

    # dap "Es probable que volvamos. Ha sido una experiencia muy buena. Gracias, Mathilda."
    dap "Nous reviendrons probablement. C'était une expérience formidable. Merci, Mathilda."

# game/scripts/c15/c15.rpy:618
translate french c15s001_DapDate_8594335b:

    # dap "¿Vamos?"
    dap "Allez?"

# game/scripts/c15/c15.rpy:619
translate french c15s001_DapDate_81d08733:

    # mc "¿Qué es eso de la habitación?"
    mc "Qu'est-ce que c'est que cette histoire de chambre ?"

# game/scripts/c15/c15.rpy:620
translate french c15s001_DapDate_4fa2926c:

    # dap "Ya te he dicho que había varios restaurantes. El Black Crow es éste, el Pitch Raven es el de ciencia ficción, y el Nigrum Corvus es el de la era clásica, romanos, griegos, y esas cosas."
    dap "Je vous ai déjà dit qu'il y avait plusieurs restaurants. Voici le Black Crow, le Pitch Raven est celui sur le thème de la science-fiction, et le Nigrum Corvus est celui sur le thème de l'Antiquité, avec les Romains, les Grecs, etc."

# game/scripts/c15/c15.rpy:621
translate french c15s001_DapDate_e7b6e193:

    # dap "Y después tienen la Red Crow Inn, con habitaciones temáticas. Tenemos una habitación medieval, aunque seguramente no se parezca en nada a como dormían entonces."
    dap "Et puis il y a l'auberge Red Crow, avec ses chambres à thème. Nous avons une chambre médiévale, même si elle ne ressemble probablement en rien à ce que l'on vivait à l'époque."

# game/scripts/c15/c15.rpy:622
translate french c15s001_DapDate_dd6716bd:

    # mc "Así que la otra reserva a nombre de \"otros\" Marks era tuya, ¿no?"
    mc "Donc l'autre réservation au nom d'« autres » marques était la vôtre, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:624
translate french c15s001_DapDate_d9aef484:

    # dap "Sí. Te hice reservar el restaurante por si querías meterte en la web y cambiar la época. La habitación la tenía elegida yo. Me parece más romántica la medieval que la de ciencia ficción."
    dap "Oui. Je vous ai fait réserver le restaurant au cas où vous voudriez modifier l'horaire en ligne. J'avais déjà choisi la chambre. Je trouve la chambre médiévale plus romantique que celle de science-fiction."

# game/scripts/c15/c15.rpy:625
translate french c15s001_DapDate_82d9a650:

    # mc "Me ha encantado el Black Crow, con lo que me alegro de no haberlo hecho. La próxima vez, podemos probar uno de los otros."
    mc "J'ai adoré le Black Crow, alors je suis content de ne pas l'avoir commandé. La prochaine fois, on pourra en essayer un autre."

# game/scripts/c15/c15.rpy:627
translate french c15s001_DapDate_42533991:

    # dap "Mejor no..."
    dap "Mieux vaut éviter..."

# game/scripts/c15/c15.rpy:628
translate french c15s001_DapDate_90696e73:

    # mc "¿Pasa algo, [dap]?"
    mc "Y a-t-il un problème, [dap] ?"

# game/scripts/c15/c15.rpy:629
translate french c15s001_DapDate_d46383ba:

    # dap "Si estamos mal de dinero, me conformo con que la próxima vez sea en un Burger Prince y durmamos en un motel. Si es contigo, me da lo mismo el sitio."
    dap "Si on est à court d'argent, ça me va si la prochaine fois on va chez Burger Prince et qu'on dort dans un motel. Si c'est avec toi, peu importe où."

# game/scripts/c15/c15.rpy:630
translate french c15s001_DapDate_66412d2f:

    # mc "Es caro, ¿verdad?"
    mc "C'est cher, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:631
translate french c15s001_DapDate_32ccc251:

    # dap "Un poco, pero no te preocupes. La habitación ya está pagada. Solo me falta pagar la cena."
    dap "Un peu, mais ne vous inquiétez pas. La chambre est déjà payée. Je n'ai plus qu'à régler le dîner."

# game/scripts/c15/c15.rpy:632
translate french c15s001_DapDate_818816ed:

    # mc "¿De dónde has sacado el dinero, [dap]?"
    mc "Où as-tu trouvé l'argent, [dap] ?"

# game/scripts/c15/c15.rpy:634
translate french c15s001_DapDate_36039b3d:

    # dap "Había estado ahorrando la paga para comprarme un nuevo portátil gaming. He invertido parte de ese dinero en la habitación y en la cena."
    dap "J'économisais mon argent de poche pour m'acheter un nouvel ordinateur portable de jeu. J'en ai déjà dépensé une partie pour la chambre et le dîner."

# game/scripts/c15/c15.rpy:635
translate french c15s001_DapDate_03ebce68:

    # mc "De eso nada, cielo. No puedo hacer nada con la habitación, pero no voy a permitirte pagar la cena. Igual que tú no vas a permitirme devolverte el dinero de la habitación, ¿verdad?"
    mc "Absolument pas, chérie. Je ne peux rien faire pour la chambre, mais tu ne vas pas payer le dîner. De même que tu ne vas pas me laisser te rembourser la chambre, n'est-ce pas ?"

# game/scripts/c15/c15.rpy:637
translate french c15s001_DapDate_aa71adc3:

    # dap "¡Ni de coña! Ha sido elección mía y lo pago yo todo."
    dap "Pas question ! C'était mon choix et je paie tout."

# game/scripts/c15/c15.rpy:638
translate french c15s001_DapDate_51cd79e3:

    # mc "Eso no va a pasar. La cena corre de mi cuenta. Tú has ahorrado para ese portátil y te lo mereces."
    mc "Ça n'arrivera pas. Je t'invite à dîner. Tu as économisé pour cet ordinateur portable et tu le mérites."

# game/scripts/c15/c15.rpy:640
translate french c15s001_DapDate_767f581f:

    # dap "Bueno, ya lo hablaremos mañana. Es el momento de ver la habitación."
    dap "D'accord, on en reparlera demain. Il est temps de voir la chambre."

# game/scripts/c15/c15.rpy:641
translate french c15s001_DapDate_57d4b6c8:

    # mc "¡Vamos!"
    mc "Allez!"

# game/scripts/c15/c15.rpy:663
translate french c15s001_AmandaCall_76586480:

    # mc "¿Hola? ¿Quién es?"
    mc "Allô ? Qui est-ce ?"

# game/scripts/c15/c15.rpy:667
translate french c15s001_AmandaCall_09b3092f:

    # ama "Hola, [mc]. No quiero molestarte demasiado."
    ama "Salut, [mc]. Je ne veux pas trop te déranger."

# game/scripts/c15/c15.rpy:668
translate french c15s001_AmandaCall_25bb6224:

    # mc "No molestas, Amanda. ¿Puedo ayudarte en algo?"
    mc "Tu ne me déranges pas, Amanda. Puis-je t'aider en quoi que ce soit ?"

# game/scripts/c15/c15.rpy:671
translate french c15s001_AmandaCall_2d2c711f:

    # ama "Me iba a acostar cuando he recibido una llamada y te tenía que avisar."
    ama "J'étais sur le point d'aller me coucher quand j'ai reçu un appel et je devais vous le dire."

# game/scripts/c15/c15.rpy:672
translate french c15s001_AmandaCall_1b04504d:

    # ama "Aaron, nuestro supervisor, llega mañana por la mañana y él querría reunirse con vosotros por la tarde para explicaros la situación."
    ama "Aaron, notre superviseur, arrive demain matin et il souhaiterait vous rencontrer dans l'après-midi pour vous expliquer la situation."

# game/scripts/c15/c15.rpy:674
translate french c15s001_AmandaCall_88603816:

    # ama "Me acaban de despertar con una llamada y te tenía que avisar."
    ama "Je viens d'être réveillé par un appel et je tenais à vous le signaler."

# game/scripts/c15/c15.rpy:675
translate french c15s001_AmandaCall_e6912b06:

    # ama "Aaron, nuestro supervisor, acaba de aterrizar y él querría reunirse con vosotros esta tarde para explicaros la situación."
    ama "Aaron, notre superviseur, vient d'atterrir et il souhaiterait vous rencontrer cet après-midi pour vous expliquer la situation."

# game/scripts/c15/c15.rpy:676
translate french c15s001_AmandaCall_1cb46252:

    # mc "¿Nosotros? ¿[mar], [nor], [emm], [eri], [dap] y yo?"
    mc "Nous ? [mar], [nor], [emm], [eri], [dap] et moi ?"

# game/scripts/c15/c15.rpy:678
translate french c15s001_AmandaCall_3e162582:

    # ama "De momento solo con [mar], [nor] y contigo. Eva y yo también vamos a estar ahí, y las chicas podrían flipar un poco."
    ama "Pour l'instant, il n'y a que [mar], [nor] et toi. Eva et moi serons là aussi, et les filles risquent de paniquer un peu."

# game/scripts/c15/c15.rpy:679
translate french c15s001_AmandaCall_12d46e7b:

    # ama "Además, no es cosa nuestra decirles la verdad, sino de sus madres."
    ama "De plus, ce n'est pas à nous de leur dire la vérité, mais plutôt à leurs mères."

# game/scripts/c15/c15.rpy:681
translate french c15s001_AmandaCall_8f92426d:

    # ama "Y tuya."
    ama "Et le vôtre."

# game/scripts/c15/c15.rpy:682
translate french c15s001_AmandaCall_c431475a:

    # mc "Lo entiendo. No me gusta ocultarles la verdad, pero hablaré con [mar] y con [nor]. ¿A qué hora os esperamos?"
    mc "Je comprends. Je n'aime pas vous cacher la vérité, mais je vais en parler à [mar] et [nor]. À quelle heure pouvons-nous vous attendre ?"

# game/scripts/c15/c15.rpy:684
translate french c15s001_AmandaCall_095f53d4:

    # ama "A las 1700. Aaron volará fuera del país por la noche."
    ama "À 17h00, Aaron quittera le pays ce soir."

# game/scripts/c15/c15.rpy:685
translate french c15s001_AmandaCall_a022ff35:

    # mc "Intentaré que las chicas no estén en casa a esa hora. ¿Cuánto tiempo necesitáis que estén fuera?"
    mc "Je ferai en sorte que les filles ne soient pas à la maison à ce moment-là. Combien de temps devez-vous les laisser absentes ?"

# game/scripts/c15/c15.rpy:687
translate french c15s001_AmandaCall_90a0d55c:

    # ama "No más de una hora, supongo. Depende de las preguntas que tengáis. Por eso es mejor que sólo estéis [nor], [mar], y tú. Nada de Olivia o Betty."
    ama "Pas plus d'une heure, je suppose. Cela dépend des questions que vous avez. C'est pourquoi il est préférable que vous soyez seulement tous les trois : [nor] et [mar]. Ni Olivia ni Betty."

# game/scripts/c15/c15.rpy:688
translate french c15s001_AmandaCall_3fbaf73d:

    # mc "Van a querer estar. También sufrieron el... *Susurro* secuestro."
    mc "Ils voudront y être. Ils ont aussi subi… *Chuchotement* un enlèvement."

# game/scripts/c15/c15.rpy:690
translate french c15s001_AmandaCall_aa3f445e:

    # ama "Es posible que sea la última vez que nos veamos. Nuestra misión con vosotros ya está acabando."
    ama "Il se pourrait que ce soit la dernière fois que nous nous voyons. Notre mission avec vous touche à sa fin."

# game/scripts/c15/c15.rpy:691
translate french c15s001_AmandaCall_14a8e762:

    # mc "¿Aaron se os va a llevar? ¿A alguna base de NTR?"
    mc "Aaron va t'emmener ? Dans une base NTR ?"

# game/scripts/c15/c15.rpy:693
translate french c15s001_AmandaCall_4b11cc55:

    # ama "Aaron solo quiere hablar con vosotros de momento. El resto ya se verá."
    ama "Aaron souhaite simplement te parler pour le moment. On verra pour le reste."

# game/scripts/c15/c15.rpy:694
translate french c15s001_AmandaCall_5493f95e:

    # ama "Por cierto, deberíais informar a [mar] de lo que pasó el lunes con Eric y los demás. Nos ahorraremos preguntas incómodas."
    ama "Au fait, tu devrais raconter à [mar] ce qui s'est passé lundi avec Eric et les autres. Ça nous évitera des questions embarrassantes."

# game/scripts/c15/c15.rpy:695
translate french c15s001_AmandaCall_f53c18eb:

    # mc "No te preocupes, hablaré con ella antes de que lleguéis."
    mc "Ne t'inquiète pas, je lui parlerai avant ton arrivée."

# game/scripts/c15/c15.rpy:698
translate french c15s001_AmandaCall_9fe47f69:

    # ama "Perfecto. Entonces nos vemos mañana por la tarde. Feliz Navidad de nuevo, [mc]."
    ama "Parfait. Alors à demain après-midi. Joyeux Noël encore une fois, [mc]."

# game/scripts/c15/c15.rpy:699
translate french c15s001_AmandaCall_4bb39419:

    # mc "Hasta mañana. No sé si es un poco tarde para seguir celebrando la Navidad, pero Feliz Navidad de nuevo, Amanda."
    mc "À demain ! Je ne sais pas s'il est un peu tard pour fêter Noël, mais encore une fois, joyeux Noël, Amanda !"

# game/scripts/c15/c15.rpy:701
translate french c15s001_AmandaCall_a8d9df18:

    # ama "Perfecto. Entonces nos vemos esta tarde. A las 1700."
    ama "Parfait. Alors on se voit cet après-midi. À 17h."

# game/scripts/c15/c15.rpy:702
translate french c15s001_AmandaCall_f2240889:

    # mc "Hasta luego, Amanda."
    mc "Au revoir, Amanda."

# game/scripts/c15/c15.rpy:706
translate french c15s001_WakeUp_7ea49a16:

    # centered "{size=+20}{b}DÍA 17 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}JOUR 17 – JEUDI{/b}{/size}"

# game/scripts/c15/c15.rpy:708
translate french c15s001_WakeUp_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:709
translate french c15s001_WakeUp_0e03d86c:

    # "Suena el teléfono y te saca de tus sueños, si es que los has tenido. Despertarse tan de golpe ha hecho que olvides lo que estabas soñando."
    "Le téléphone sonne et vous arrache à vos rêves, si tant est que vous rêviez. Ce réveil brutal vous fait oublier de quoi vous rêviez."

# game/scripts/c15/c15.rpy:710
translate french c15s001_WakeUp_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Nombre caché ?)"

# game/scripts/c15/c15.rpy:714
translate french c15s001_WakeUp_032240cf:

    # "Cuando cuelgas te das cuenta de que has dormido hasta tarde. Casi no vale la pena bajar a desayunar."
    "Quand on raccroche, on se rend compte qu'on a fait la grasse matinée. Ça ne vaut pas vraiment la peine de descendre prendre le petit-déjeuner."

# game/scripts/c15/c15.rpy:716
translate french c15s001_WakeUp_ff52f651:

    # "Decides jugar un rato a My Residence, El MC por fin lleva a Laura a una cita, aunque es ella la que elige restaurante."
    "Vous décidez de jouer à My Residence pendant un certain temps. Le personnage principal emmène finalement Laura en rendez-vous, bien que ce soit elle qui choisisse le restaurant."

# game/scripts/c15/c15.rpy:717
translate french c15s001_WakeUp_e049b78d:

    # "Como ella es fan de las novelas de fantasía, elige un restaurante temático medieval en el que pueden disfrazarse. Laura cada vez te recuerda más a [dap]."
    "Étant donné qu'elle est fan de romans fantastiques, elle choisit un restaurant à thème médiéval où ils peuvent se déguiser. Laura vous rappelle de plus en plus [dap]."

# game/scripts/c15/c15.rpy:746
