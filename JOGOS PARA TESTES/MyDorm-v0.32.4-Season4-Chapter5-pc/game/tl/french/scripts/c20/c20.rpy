translate french c20s004_Farewell_d6ecf2aa:

    # mcd "Marzia nos ha preparado unas provisiones para el viaje. Acuérdate de agradecérselo."
    mcd "Marzia a préparé des provisions pour notre voyage. N'oubliez pas de la remercier."

# game/scripts/c20/c20.rpy:2173
translate french c20s004_Farewell_28f876f8:

    # madd "No lo dudes. Deberíamos acabar esto e irnos si no queremos que nos pille la lluvia en el camino. Lloverá hacia mediodía."
    madd "N'hésite pas. Finissons-en et partons si nous ne voulons pas nous faire surprendre par la pluie en chemin. Il pleuvra vers midi."

# game/scripts/c20/c20.rpy:2174
translate french c20s004_Farewell_9bc9c65b:

    # mcd "Perfecto. ¿Tienes que coger algo de tu habitación? Yo lo he bajado todo ya."
    mcd "Parfait. Tu as besoin de quelque chose dans ta chambre ? J’ai déjà tout descendu."

# game/scripts/c20/c20.rpy:2176
translate french c20s004_Farewell_0184d086:

    # madd "Yo también. Júpiter está fuera guardando mis alforjas."
    madd "Moi aussi. Jupiter est dehors, il garde mes sacoches."

# game/scripts/c20/c20.rpy:2177
translate french c20s004_Farewell_59d20dac:

    # mcdd "Pues cuando quieras, nos podemos ir."
    mcdd "Eh bien, quand vous voulez, on peut y aller."

# game/scripts/c20/c20.rpy:2179
translate french c20s004_Farewell_18598a42:

    # dap "*En el mundo real* Os despedís de Marzia..."
    dap "*Dans la vraie vie*, vous dites adieu à Marzia..."

# game/scripts/c20/c20.rpy:2180
translate french c20s004_Farewell_3e35ca29:

    # mad "*En el mundo real* Nos aseguramos de darle las gracias por las provisiones."
    mad "*Dans la réalité*, nous avons tenu à vous remercier pour les fournitures."

# game/scripts/c20/c20.rpy:2182
translate french c20s004_Farewell_b032d0ca:

    # mad "*En el mundo real* También nos despedimos de Alba, la chica a la que gritó que se ocupara de los clientes cuando llegaron los BDSM. Supongo que debe ser su ayudante."
    mad "Dans la vraie vie, nous avons aussi dit au revoir à Alba, la fille à qui il avait crié de s'occuper des clients quand les adeptes du BDSM sont arrivés. Je suppose qu'elle devait être son assistante."

# game/scripts/c20/c20.rpy:2183
translate french c20s004_Farewell_d673b801:

    # mc "*En el mundo real* Ni siquiera me acordaba de ella... no hemos interactuado con ella para nada."
    mc "*Dans la vraie vie*, je ne me souvenais même pas d'elle... nous n'avons eu aucun contact avec elle."

# game/scripts/c20/c20.rpy:2184
translate french c20s004_Farewell_c8543d85:

    # mad "*En el mundo real* Bueno, se supone que si es la camarera de la taberna, nos habrá traído comida o bebida."
    mad "*Dans la vraie vie* Eh bien, si c'est la serveuse de la taverne, elle aurait dû nous apporter à manger ou à boire."

# game/scripts/c20/c20.rpy:2185
translate french c20s004_Farewell_b2ad90a0:

    # dap "*En el mundo real* Bien visto, Maddie. Scarlett, [eri], y [emm] casi siempre se olvidan de ella."
    dap "*Dans la vraie vie* Bien vu, Maddie. Scarlett, [eri] et [emm] l'oublient presque toujours."

# game/scripts/c20/c20.rpy:2186
translate french c20s004_Farewell_785efda1:

    # dap "*En el mundo real* No hay rastro de Beagan, Aelia, Paula, o Pia."
    dap "*Dans la réalité*, il ne reste aucune trace de Beagan, Aelia, Paula ou Pia."

# game/scripts/c20/c20.rpy:2187
translate french c20s004_Farewell_11698653:

    # mc "*En el mundo real* Le pedimos a Marzia que nos despida de ellas y nos vamos a los establos. No olvido las provisiones."
    mc "Dans la réalité, nous demandons à Marzia de nous dire au revoir et nous nous dirigeons vers les écuries. Je n'ai pas oublié les provisions."

# game/scripts/c20/c20.rpy:2189
translate french c20s004_Farewell_a38145c0:

    # dap "*En el mundo real* De camino a los establos veis a Thiel y el chico de la alabarda charlando, sentados en un banco."
    dap "*Dans la réalité* En chemin vers les écuries, vous apercevez Thiel et le garçon à la hallebarde qui discutent, assis sur un banc."

# game/scripts/c20/c20.rpy:2191
translate french c20s004_Farewell_60a85db1:

    # dap "*En el mundo real* ¡Están cogidos de la mano! *Risa* Parece que tu fallo crítico ha creado una pareja en el pueblo."
    dap "*Dans la vraie vie* Ils se tiennent la main ! *Rires* On dirait que ton échec cuisant a fait naître un couple en ville."

# game/scripts/c20/c20.rpy:2193
translate french c20s004_Farewell_885f9659:

    # mc "*En el mundo real* Me acerco a ellos para despedirnos... pero solo si no parece que vaya a interrumpir algo."
    mc "*Dans la vraie vie*, je les aborde pour leur dire au revoir... mais seulement si je ne donne pas l'impression de les déranger."

# game/scripts/c20/c20.rpy:2194
translate french c20s004_Farewell_166b13f1:

    # mad "*En el mundo real* Yo también me acerco. Quiero despedirme de los tortolitos."
    mad "*Dans la vraie vie*, je viens aussi. Je veux dire au revoir aux tourtereaux."

# game/scripts/c20/c20.rpy:2196
translate french c20s004_Farewell_87c418f9:

    # mcd "Thiel, [wil], nos vamos ya. Un placer haberos conocido."
    mcd "Thiel, [wil], nous partons maintenant. Ce fut un plaisir de vous rencontrer."

# game/scripts/c20/c20.rpy:2197
translate french c20s004_Farewell_f149b226:

    # madd "Lo mismo digo, chicos."
    madd "Pareil pour moi, les gars."

# game/scripts/c20/c20.rpy:2199
translate french c20s004_Farewell_360e7491:

    # thi "Muchas gracias por lo de ayer. Es una lástima que no se puedan quedar ustedes en el pueblo. La Señora Paula ya nos ha dicho que se tienen que marchar."
    thi "Merci beaucoup pour hier. C'est dommage que vous ne puissiez pas rester au village. Mme Paula nous a déjà dit que vous deviez partir."

# game/scripts/c20/c20.rpy:2201
translate french c20s004_Farewell_c34ebee4:

    # madd "Sí, muchacha. Vamos a buscar trabajo a Vindobona."
    madd "Oui, ma belle. Nous allons chercher du travail à Vindobona."

# game/scripts/c20/c20.rpy:2202
translate french c20s004_Farewell_fb4cbe08:

    # mcd "Nos han dicho que aquí no vamos a encontrar trabajo escoltando caravanas."
    mcd "On nous a dit que nous ne trouverions pas de travail ici pour escorter des caravanes."

# game/scripts/c20/c20.rpy:2204
translate french c20s004_Farewell_27f53f3c:

    # wil "Pero aquí hay mucho trabajo si lo quieren, hay muchas granjas sin manos que las trabajen. O podrían trabajar para las Protectoras."
    wil "Mais il y a beaucoup de travail ici si vous en cherchez ; de nombreuses fermes manquent de main-d’œuvre. Vous pourriez aussi travailler dans des refuges pour animaux."

# game/scripts/c20/c20.rpy:2205
translate french c20s004_Farewell_3dcff2aa:

    # mcd "Suena tentador, pero no es el tipo de trabajo que buscamos ahora mismo."
    mcd "Cela semble tentant, mais ce n'est pas le type de travail que nous recherchons actuellement."

# game/scripts/c20/c20.rpy:2207
translate french c20s004_Farewell_af9de7cd:

    # thi "Es una lástima. Echaré de menos a Júpiter, Señora. Me cae muy bien. Me ha pedido que le dé las gracias por lo de Capua. No me ha dicho de qué se trata."
    thi "C'est dommage. Jupiter va me manquer, Madame. Je l'apprécie beaucoup. Il m'a demandé de vous remercier pour Capoue. Il ne m'a pas dit de quoi il s'agissait."

# game/scripts/c20/c20.rpy:2209
translate french c20s004_Farewell_724d248b:

    # madd "¿Qué? ¿Puedes hablar con Júpiter?"
    madd "Quoi ? Tu peux parler à Jupiter ?"

# game/scripts/c20/c20.rpy:2211
translate french c20s004_Farewell_cdd8f6cd:

    # thi "Claro... Soy una chica gato, al fin y al cabo. Habla con un acento raro, pero nos entendemos."
    thi "Bien sûr… je suis une fille-chat, après tout. Elle a un drôle d’accent, mais on se comprend."

# game/scripts/c20/c20.rpy:2212
translate french c20s004_Farewell_5e9087b4:

    # mcd "*Risa* Me parece la mejor explicación que he oído nunca."
    mcd "*Rires* C'est la meilleure explication que j'aie jamais entendue."

# game/scripts/c20/c20.rpy:2213
translate french c20s004_Farewell_8a10a3d2:

    # thi "Él le entiende casi todo lo que dice, al menos cuando habla Latín, pero no puede contestarle."
    thi "Il comprend presque tout ce qu'elle dit, du moins lorsqu'elle parle latin, mais il ne peut pas lui répondre."

# game/scripts/c20/c20.rpy:2215
translate french c20s004_Farewell_d58e1c0c:

    # mad "*En el mundo real* Abrazo a Júpiter."
    mad "*Dans la vraie vie*, j'enlace Jupiter."

# game/scripts/c20/c20.rpy:2216
translate french c20s004_Farewell_6f8bb913:

    # madd "Sabes que eres mi compañero, gatito."
    madd "Tu sais que tu es mon partenaire, minou."

# game/scripts/c20/c20.rpy:2217
translate french c20s004_Farewell_3fb43df7:

    # jup "*Ronroneo*"
    jup "*Ronronner*"

# game/scripts/c20/c20.rpy:2218
translate french c20s004_Farewell_2d298b27:

    # thi "Dice que no podría tener una compañera mejor."
    thi "Il affirme qu'il ne pourrait pas avoir de meilleur partenaire."

# game/scripts/c20/c20.rpy:2220
translate french c20s004_Farewell_f5fac812:

    # mcd "Sólo queríamos despedirnos, chicos. Ha sido un placer conoceros."
    mcd "On voulait juste vous dire au revoir. Ce fut un plaisir de vous rencontrer."

# game/scripts/c20/c20.rpy:2222
translate french c20s004_Farewell_fd570581:

    # wil "Guardaré su moneda siempre, Señor. Muchas gracias."
    wil "Je garderai votre pièce pour toujours, monsieur. Merci beaucoup."

# game/scripts/c20/c20.rpy:2223
translate french c20s004_Farewell_8d9f58ec:

    # mcd "*Susurrando* Si puedo darte un consejo, ponte un nombre más fácil de recordar, [wil]."
    mcd "*Chuchotant* Si je peux te donner un conseil, choisis un nom plus facile à retenir, [wil]."

# game/scripts/c20/c20.rpy:2224
translate french c20s004_Farewell_e0e0f25c:

    # mc "*En el mundo real* *Risa*"
    mc "*Dans la vraie vie* *Rires*"

# game/scripts/c20/c20.rpy:2226
translate french c20s004_Farewell_6cb39545:

    # wil "¡Oh, lo haré! Cuando tenga mi propia AVN."
    wil "Oh oui, je le ferai ! Quand j'aurai mon propre AVN."

# game/scripts/c20/c20.rpy:2228
translate french c20s004_Farewell_ae66b4fc:

    # mc "*En el mundo real* ¿Qué? ¿AVN?" (multiple=2)
    mc "*Dans la vraie vie* Quoi ? AVN ?" (multiple=2)

# game/scripts/c20/c20.rpy:2229
translate french c20s004_Farewell_d1c1869d:

    # mcd "¿Qué quieres decir con AVN?" (multiple=2)
    mcd "Que signifie AVN pour vous ?" (multiple=2)

# game/scripts/c20/c20.rpy:2231
translate french c20s004_Farewell_2f8db68f:

    # wil "Oh, sí, Señor. Agrum Vaccis Nostrum. Nuestro propio campo con vacas, para alimentar a mi familia."
    wil "Oh oui, monsieur. Agrum Vaccis Nostrum. Notre propre champ avec des vaches, pour nourrir ma famille."

# game/scripts/c20/c20.rpy:2232
translate french c20s004_Farewell_11ebef1d:

    # mcd "Me habías asustado, creía que te referías a otra cosa..."
    mcd "Tu m'as fait peur, j'ai cru que tu voulais dire autre chose..."

# game/scripts/c20/c20.rpy:2233
translate french c20s004_Farewell_27c39f60:

    # dap "*En el mundo real* *Risa* Eso es porque tienes una mente traviesa."
    dap "*Dans la vraie vie* *Rires* C'est parce que tu as l'esprit malicieux."

# game/scripts/c20/c20.rpy:2235
translate french c20s004_Farewell_b64267a5:

    # thi "No queremos entretenerles más, o si no van a llegar cuando las puertas de Vindobona ya estén cerradas."
    thi "Nous ne voulons pas vous retenir plus longtemps, sinon vous arriverez quand les portes de Vindobona seront déjà fermées."

# game/scripts/c20/c20.rpy:2236
translate french c20s004_Farewell_8da3180b:

    # mcd "Gracias, Thiel. Si volvemos a hacer esta ruta pararemos a saludaros."
    mcd "Merci, Thiel. Si nous refaisons ce trajet, nous nous arrêterons pour vous saluer."

# game/scripts/c20/c20.rpy:2237
translate french c20s004_Farewell_7e1b4108:

    # madd "Cuidaos, chicos."
    madd "Prenez soin de vous, les gars."

# game/scripts/c20/c20.rpy:2238
translate french c20s004_Farewell_93865483:

    # wil "Tengan cuidado ustedes en el camino. A veces... pasan cosas... y los viajeros desaparecen."
    wil "Soyez prudents sur la route. Parfois… il arrive des choses… et des voyageurs disparaissent."

# game/scripts/c20/c20.rpy:2240
translate french c20s004_Farewell_e7e1a826:

    # dap "*En el mundo real* Cuando llegáis a los establos, veis que Paula, Aelia, Beagan y Pia están allí. Esta vez sin armaduras."
    dap "*Dans la réalité* Lorsque vous arrivez aux écuries, vous voyez que Paula, Aelia, Beagan et Pia sont là. Cette fois-ci sans leurs armures."

# game/scripts/c20/c20.rpy:2242
translate french c20s004_Farewell_247c5474:

    # centered "{size=+20}{b}DÍA 21 – LUNES{/b}{/size}"
    centered "{size=+20}{b}JOUR 21 – LUNDI{/b}{/size}"

# game/scripts/c20/c20.rpy:2244
translate french c20s004_Farewell_b7f824e7:

    # dapd "Creía que habíais decidido quedaros."
    dapd "Je croyais que tu avais décidé de rester."

# game/scripts/c20/c20.rpy:2246
translate french c20s004_Farewell_3868638f:

    # erid "Si nosotras tuviéramos que ir a Vindobona, Pia nos hubiera hecho salir al amanecer."
    erid "Si nous avions dû aller à Vindobona, Pia nous aurait fait partir à l'aube."

# game/scripts/c20/c20.rpy:2248
translate french c20s004_Farewell_8a2eb5dd:

    # scad "Y se hubiera pasado el camino quejándose de que no había dormido suficiente."
    scad "Et il aurait passé tout le voyage à se plaindre de ne pas avoir assez dormi."

# game/scripts/c20/c20.rpy:2250
translate french c20s004_Farewell_2991cdd8:

    # emmd "No os metáis con Pia. Al menos nos evita tener que hacer todos los cálculos de las provisiones que necesitamos."
    emmd "Ne vous frottez pas à Pia. Au moins, elle nous évite de faire tous les calculs pour les fournitures dont nous avons besoin."

# game/scripts/c20/c20.rpy:2252
translate french c20s004_Farewell_ef93e412:

    # mad "Muchas gracias por las cervezas de anoche, chicas."
    mad "Merci beaucoup pour les bières hier soir, les filles."

# game/scripts/c20/c20.rpy:2253
translate french c20s004_Farewell_24aa2dc7:

    # mcd "Y por lo de después... la cena... me refiero..."
    mcd "Et ce qui s'est passé ensuite... le dîner... enfin..."

# game/scripts/c20/c20.rpy:2255
translate french c20s004_Farewell_5c3bfa02:

    # emmd "Hemos ensillado vuestros caballos..."
    emmd "Nous avons sellé vos chevaux..."

# game/scripts/c20/c20.rpy:2256
translate french c20s004_Farewell_fca62baf:

    # erid "Y os hemos puesto un par de mantas extra, en caso de que encontréis una caravana que vaya más al norte de Vindobona. Hace frío allí."
    erid "Et nous avons emporté quelques couvertures supplémentaires, au cas où vous croiseriez une caravane plus au nord de Vindobona. Il y fait froid."

# game/scripts/c20/c20.rpy:2257
translate french c20s004_Farewell_9555181e:

    # dapd "Si volvéis a pasar por Novum Templum, no os olvidéis de parar a saludar."
    dapd "Si vous repassez par Novum Templum, n'oubliez pas de vous arrêter pour dire bonjour."

# game/scripts/c20/c20.rpy:2258
translate french c20s004_Farewell_91d0d3fe:

    # scad "Y a traernos noticias de lo que pasa en el resto del Imperio. Casi no nos enteramos de nada aquí."
    scad "Et donnez-nous des nouvelles de ce qui se passe dans le reste de l'Empire. Ici, on n'entend presque rien."

# game/scripts/c20/c20.rpy:2262
translate french c20s004_Farewell_5b196794:

    # mad "¿Queda mucho, [dap]? Mañana me tengo que levantar pronto para abrir la tienda."
    mad "C'est encore long, [dap] ? Je dois me lever tôt demain pour ouvrir la boutique."

# game/scripts/c20/c20.rpy:2263
translate french c20s004_Farewell_2c223719:

    # mad "No quiero estropear la partida, pero si va a durar mucho más, ¿podríamos dejarlo para otro día?"
    mad "Je ne veux pas gâcher la surprise, mais si ça doit prendre beaucoup plus de temps, pourrait-on reporter ça à un autre jour ?"

# game/scripts/c20/c20.rpy:2265
translate french c20s004_Farewell_7e0c9c16:

    # dap "Solo quedan diez minutos a lo sumo. Vamos a acelerar un poco."
    dap "Il ne reste que dix minutes maximum. Accélérons un peu les choses."

# game/scripts/c20/c20.rpy:2266
translate french c20s004_Farewell_04496536:

    # dap "Acabáis las despedidas y emprendéis camino. Es un día soleado. Parece que la amenaza de lluvia va desapareciendo tal como vais hacia el norte."
    dap "Vous terminez vos adieux et prenez la route. Il fait beau. La menace de pluie semble s'éloigner à mesure que vous vous dirigez vers le nord."

# game/scripts/c20/c20.rpy:2269
translate french c20s004_Farewell_03ac580c:

    # emm "Vaya, yo quería despedirme de Vilfredo como es debido."
    emm "Eh bien, je voulais dire au revoir à Vilfredo comme il se doit."

# game/scripts/c20/c20.rpy:2271
translate french c20s004_Farewell_6f17ff93:

    # eri "[emm], Maddie es la única aquí que tiene que madrugar. Tenemos que adaptar la partida a ella."
    eri "Maddie est la seule ici à devoir se lever tôt. Il faut adapter le jeu à ses besoins."

# game/scripts/c20/c20.rpy:2272
translate french c20s004_Farewell_00b68d56:

    # eri "Y ni se te ocurra sentirte mal, Maddie. Lo hacemos encantadas."
    eri "Et ne t'inquiète surtout pas, Maddie. On est ravis de le faire."

# game/scripts/c20/c20.rpy:2274
translate french c20s004_Farewell_9780c57c:

    # mad "Gracias, [eri]."
    mad "Merci, [eri]."

# game/scripts/c20/c20.rpy:2276
translate french c20s004_Farewell_7109b629:

    # dap "Bueno, vamos a acelerar un poco."
    dap "Bon, accélérons un peu les choses."

# game/scripts/c20/c20.rpy:2277
translate french c20s004_Farewell_d1e6de3e:

    # dap "Cuando lleváis un par de horas cabalgando oís un ruido. Tirad por Percepción."
    dap "Après avoir roulé pendant quelques heures, vous entendez un bruit. Lancez les dés pour obtenir votre Perception."

# game/scripts/c20/c20.rpy:2279
translate french c20s004_Farewell_b3015543:

    # mad "15. Con los bonos sumados, 18."
    mad "15. Avec les bonus ajoutés, 18."

# game/scripts/c20/c20.rpy:2280
translate french c20s004_Farewell_2012bbd5:

    # mc "12... ¿qué bonos había que sumar?... Ah, sí, Sabiduría. No tengo bono. 12."
    mc "12… quels bonus ai-je dû ajouter ?… Ah oui, la Sagesse. Je n’ai pas de bonus. 12."

# game/scripts/c20/c20.rpy:2283
translate french c20s004_Farewell_32adb331:

    # dap "*En el mundo real* Miráis al cielo, hacia el Norte, y veis un dragón, rojo infernal, volando hacia el Oeste."
    dap "*Dans le monde réel*, vous levez les yeux au ciel, vers le nord, et vous voyez un dragon, d'un rouge infernal, voler vers l'ouest."

# game/scripts/c20/c20.rpy:2284
translate french c20s004_Farewell_767472c8:

    # dap "*En el mundo real* Maddie, tu dirías que es un ejemplar muy viejo, y que llevaba algo en las garras, pero no puedes percibir qué es."
    dap "*Dans la vraie vie*, Maddie, tu dirais que c'est un spécimen très ancien, et qu'il portait quelque chose dans ses griffes, mais tu ne peux pas percevoir quoi."

# game/scripts/c20/c20.rpy:2285
translate french c20s004_Farewell_52e72fa8:

    # dap "*En el mundo real* Además, ves al Noreste una pequeña columna de humo."
    dap "*Dans la réalité*, on aperçoit également une petite colonne de fumée au nord-est."

# game/scripts/c20/c20.rpy:2287
translate french c20s004_Farewell_b69bc0a5:

    # madd "¿Has visto el dragón?"
    madd "Avez-vous vu le dragon ?"

# game/scripts/c20/c20.rpy:2288
translate french c20s004_Farewell_d8710b26:

    # mcd "Nunca había visto uno. Creo que será difícil olvidarlo..."
    mcd "Je n'en avais jamais vu auparavant. Je pense que ce sera difficile à oublier..."

# game/scripts/c20/c20.rpy:2290
translate french c20s004_Farewell_919b1d43:

    # madd "Hay humo allí. Deberíamos acercarnos."
    madd "Il y a de la fumée. On devrait s'approcher."

# game/scripts/c20/c20.rpy:2291
translate french c20s004_Farewell_bfd38439:

    # mcd "Te sigo. A lo mejor alguien necesita ayuda."
    mcd "Je vous suis. Peut-être que quelqu'un a besoin d'aide."

# game/scripts/c20/c20.rpy:2293
translate french c20s004_Farewell_3dc7746f:

    # madd "Por aquí. Este camino parece llevar hacia el humo."
    madd "Par ici. Ce chemin semble mener vers la fumée."

# game/scripts/c20/c20.rpy:2295
translate french c20s004_Farewell_7007417b:

    # dap "*En el mundo real* Llegáis a un claro al lado del camino, donde alguien ha acampado para comer."
    dap "*Dans la réalité*, vous arrivez à une clairière en bord de route, où quelqu'un a campé pour manger."

# game/scripts/c20/c20.rpy:2296
translate french c20s004_Farewell_d3047ce0:

    # dap "*En el mundo real* No hay nadie, pero el fuego está encendido aún con carne en el espeto. Obiamente, la columna de humo salía de aquí."
    dap "Dans la réalité, il n'y a personne, mais le feu brûle toujours et de la viande rôtit à la broche. De toute évidence, la colonne de fumée provenait de là."

# game/scripts/c20/c20.rpy:2297
translate french c20s004_Farewell_9bec8cf5:

    # mad "*En el mundo real* Busco huellas. 8+3. 11. No creo que encuentre nada demasiado interesante."
    mad "Dans la réalité, je cherche des empreintes de pas. 8 + 3. 11. Je ne pense pas trouver grand-chose d'intéressant."

# game/scripts/c20/c20.rpy:2298
translate french c20s004_Farewell_8d374f57:

    # dap "*En el mundo real* Ves huellas que van en varias direcciones. El grupo más numeroso va al Norte."
    dap "Dans la réalité, on observe des empreintes de pas allant dans différentes directions. Le groupe le plus important se dirige vers le nord."

# game/scripts/c20/c20.rpy:2300
translate french c20s004_Farewell_24c78b59:

    # madd "El grupo que había acampado aquí se ha separado. Vamos a seguir las huellas que van al Norte."
    madd "Le groupe qui avait campé ici s'est dispersé. Nous allons suivre les traces qui mènent vers le nord."

# game/scripts/c20/c20.rpy:2301
translate french c20s004_Farewell_550def09:

    # mcd "Como quieras. Tu te mueves por los bosques mejor que yo."
    mcd "Comme tu veux. Tu te déplaces mieux que moi dans les bois."

# game/scripts/c20/c20.rpy:2303
translate french c20s004_Farewell_56891888:

    # dap "*En el mundo real* Llegáis a un claro en el que encontráis una escena dantesca. Hay un par de cadáveres quemados. Uno boca arriba y el otro boca abajo."
    dap "*Dans la réalité*, vous arrivez dans une clairière où vous découvrez une scène d'horreur. Deux cadavres calcinés gisent là. L'un est tourné vers le ciel, l'autre vers le sol."

# game/scripts/c20/c20.rpy:2304
translate french c20s004_Farewell_b1bfdb6e:

    # dap "*En el mundo real* No parecen haber sido atacados aquí, sino un poco antes, donde habéis visto hierba quemada. Parece que han corrido hasta aquí antes de morir."
    dap "Dans la réalité, ils ne semblent pas avoir été attaqués ici, mais un peu plus tôt, là où vous avez vu l'herbe brûlée. Il semblerait qu'ils aient couru jusqu'ici avant de mourir."

# game/scripts/c20/c20.rpy:2305
translate french c20s004_Farewell_4a2eb8a8:

    # dap "*En el mundo real* Reconocéis la armadura que llevaban los alabarderos en uno de los cadáveres. No lleva la capa."
    dap "Dans la réalité, vous reconnaissez l'armure des hallebardiers sur l'un des cadavres. Il ne porte pas la cape."

# game/scripts/c20/c20.rpy:2306
translate french c20s004_Farewell_5820e84c:

    # mc "*En el mundo real* Le doy la vuelta al otro."
    mc "*Dans la réalité*, je retourne l'autre."

# game/scripts/c20/c20.rpy:2308
translate french c20s004_Farewell_a9dc35cc:

    # dap "*En el mundo real* Incluso antes de darle la vuelta, reconoces la armadura. Es la misma que llevaba Euricus, aunque le faltan algunas piezas."
    dap "*Dans la réalité* Avant même de la retourner, vous reconnaissez l'armure. C'est la même que celle qu'Euricus portait, bien qu'il lui manque quelques pièces."

# game/scripts/c20/c20.rpy:2309
translate french c20s004_Farewell_48cc2da4:

    # dap "*En el mundo real* En el momento en que le das la vuelta, lo reconoces pese a que está bastante churruscado."
    dap "*Dans la réalité* Dès qu'on le retourne, on le reconnaît même s'il est bien brûlé."

# game/scripts/c20/c20.rpy:2310
translate french c20s004_Farewell_cd7b56ba:

    # mad "*En el mundo real* ¿Está el cadáver de Solomon por algún lado?"
    mad "*Dans la réalité*, le corps de Salomon est-il quelque part ?"

# game/scripts/c20/c20.rpy:2311
translate french c20s004_Farewell_71b45c17:

    # dap "*En el mundo real* Tira por Inteligencia."
    dap "*Dans la vraie vie* Lancez les dés pour l'Intelligence."

# game/scripts/c20/c20.rpy:2312
translate french c20s004_Farewell_172177b2:

    # mad "*En el mundo real* ¡Sí! 20 natural. Pero le resto 1. Fang no es muy inteligente."
    mad "*Dans la réalité* Oui ! 20 naturels. Mais j'enlève 1. Fang n'est pas très intelligent."

# game/scripts/c20/c20.rpy:2313
translate french c20s004_Farewell_169eaa96:

    # dap "*En el mundo real* Para nosotras, un 20 natural siempre es un éxito crítico. Así simplificamos las normas."
    dap "Dans la réalité, pour nous, un score de 20 naturel est toujours une réussite majeure. C'est ainsi que nous simplifions les règles."

# game/scripts/c20/c20.rpy:2315
translate french c20s004_Farewell_6553f9a6:

    # dap "*En el mundo real* Recuerdas la cosa negra que llevaba el dragón entre las garras. Crees que podría ser Solomon."
    dap "*Dans la réalité*, vous vous souvenez de la chose noire que le dragon portait dans ses griffes. Vous pensez que c'était peut-être Salomon."

# game/scripts/c20/c20.rpy:2316
translate french c20s004_Farewell_051216b6:

    # mad "*En el mundo real* ¡Sí! !Acabar como el almuerzo de un dragón! ¡Ahí tienes tu criatura roja infernal chupadora de almas! ¡Jódete, cabrón! ¡Uy, perdón!"
    mad "*Dans la vraie vie* Oui ! Finir en repas pour un dragon ! Voilà ta créature rouge infernale qui te suce les âmes ! Va te faire foutre, espèce d'enfoiré ! Oups, pardon !"

# game/scripts/c20/c20.rpy:2317
translate french c20s004_Farewell_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c20/c20.rpy:2319
translate french c20s004_Farewell_a1798ea5:

    # madd "Creo que deberíamos volver a Novum Templum, Vilfredo. Deberíamos avisarles de que hay un dragón en las inmediaciones."
    madd "Je pense que nous devrions retourner à Novum Templum, Vilfredo. Nous devrions les prévenir qu'un dragon rôde dans les parages."

# game/scripts/c20/c20.rpy:2320
translate french c20s004_Farewell_6fa26c98:

    # mcd "Me parece que no deben saberlo, o nos lo hubieran dicho. ¡Volvamos!"
    mcd "Je ne pense pas qu'ils le sachent, sinon ils nous l'auraient dit. Retournons-y !"

# game/scripts/c20/c20.rpy:2321
translate french c20s004_Farewell_4a222b01:

    # madd "Vamos. Vindobona tendrá que esperar."
    madd "Allez. Vindobona devra attendre."

# game/scripts/c20/c20.rpy:2323
translate french c20s004_Farewell_449382bd:

    # mcd "Fang, presiento que este es el comienzo de una hermosa amistad."
    mcd "Fang, j'ai le sentiment que c'est le début d'une belle amitié."

# game/scripts/c20/c20.rpy:2327
translate french c20s004_Farewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "La séance d'aujourd'hui est maintenant terminée. J'espère qu'elle vous a plu."

# game/scripts/c20/c20.rpy:2353
translate french c20s005_EndGameFarewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "La séance d'aujourd'hui est maintenant terminée. J'espère qu'elle vous a plu."

# game/scripts/c20/c20.rpy:2356
translate french c20s005_EndGameFarewell_1a297f42:

    # mad "Como introducción al mundo y al grupo ha sido fantástico."
    mad "Pour une première découverte du monde et du groupe, ça a été fantastique."

# game/scripts/c20/c20.rpy:2357
translate french c20s005_EndGameFarewell_4ae9fcaa:

    # mad "No es la típica forma de introducir nuevos miembros en plan \"Os encontráis en una taberna y parecéis amigos de toda la vida\"."
    mad "Ce n'est pas la façon habituelle de présenter de nouveaux membres, du genre « Vous vous rencontrez dans une taverne et vous avez l'impression d'être amis depuis toujours. »"

# game/scripts/c20/c20.rpy:2360
translate french c20s005_EndGameFarewell_5625d6c4:

    # sca "Es más un \"Os encontráis en el foro y os folláis al Semielfo\". *Risa*"
    sca "C'est plutôt du genre : « Tu te rencontres sur le forum et tu couches avec le demi-elfe. » *Rires*"

# game/scripts/c20/c20.rpy:2361
translate french c20s005_EndGameFarewell_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c20/c20.rpy:2364
translate french c20s005_EndGameFarewell_7b8058c9:

    # emm "*Risa* Había que darle razones para volver, ¿no?"
    emm "*Rires* Il fallait bien lui donner des raisons de revenir, non ?"

# game/scripts/c20/c20.rpy:2365
translate french c20s005_EndGameFarewell_3eba9f66:

    # mc "*Risa* Creo que [dap] nos hubiera dado razones suficientes igualmente."
    mc "*Rires* Je pense que [dap] nous aurait donné suffisamment de raisons de toute façon."

# game/scripts/c20/c20.rpy:2367
translate french c20s005_EndGameFarewell_c15b942d:

    # eri "Ahora hay que darle razones a [madd] para que se quede."
    eri "Maintenant, nous devons donner [madd] des raisons de rester."

# game/scripts/c20/c20.rpy:2369
translate french c20s005_EndGameFarewell_6e4fee88:

    # dap "Por eso habéis conocido a unos enemigos comunes. Además, Vilfredo y Fang volverán para dar la noticia del dragón."
    dap "C'est pourquoi vous avez rencontré des ennemis communs. De plus, Vilfredo et Fang reviendront vous annoncer la nouvelle concernant le dragon."

# game/scripts/c20/c20.rpy:2370
translate french c20s005_EndGameFarewell_9c2b3da1:

    # dap "Suma a eso que ahora Fang tiene una razón para quedarse. Tiene un intérprete para hablar con Júpiter."
    dap "Ajoutons à cela que Fang a désormais une raison de rester : il dispose d'un interprète pour parler à Jupiter."

# game/scripts/c20/c20.rpy:2373
translate french c20s005_EndGameFarewell_f359061e:

    # mad "Y visto lo que pasó anoche, quizás se plantee probar a Vilfredo. Aunque también podría haberlo hecho en Vindobona."
    mad "Vu ce qui s'est passé hier soir, ils envisageront peut-être de tenter leur chance à Vilfredo. Ils auraient tout aussi bien pu le faire à Vindobona."

# game/scripts/c20/c20.rpy:2376
translate french c20s005_EndGameFarewell_f8a96c09:

    # mad "*Risa* Es la única idiota que se fue a dormir y se quedó sin diversión."
    mad "*Rires* C'est la seule idiote qui s'est endormie et a raté tout le plaisir."

# game/scripts/c20/c20.rpy:2378
translate french c20s005_EndGameFarewell_849e73e9:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas."
    bet "J'ai trouvé très intéressant de découvrir ces facettes de mes quatre nièces."

# game/scripts/c20/c20.rpy:2381
translate french c20s005_EndGameFarewell_4b8e0ca6:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas, aunque [mc] las rechazara."
    bet "J'ai trouvé très intéressant de découvrir ces facettes de mes quatre nièces, même si je les avais rejetées."

# game/scripts/c20/c20.rpy:2383
translate french c20s005_EndGameFarewell_240e4faf:

    # dap "¿Por qué no te unes, Tía Betty? Siempre hay espacio para más Clérigos en el grupo. Los hechizos de curación de Pia no son eternos y ahora somos más."
    dap "Pourquoi ne pas vous joindre à nous, tante Betty ? Il y a toujours de la place pour des clercs de plus dans le groupe. Les sorts de guérison de Pia ne sont pas éternels, et maintenant nous sommes plus nombreux."

# game/scripts/c20/c20.rpy:2385
translate french c20s005_EndGameFarewell_7fccd2cc:

    # bet "*Risa* ¿Me estás diciendo que me una al grupo y me haga una monja curandera en vez de follarme al Semielfo?"
    bet "*Rires* Tu veux dire que je devrais rejoindre le groupe et devenir une nonne guérisseuse au lieu de coucher avec le demi-elfe ?"

# game/scripts/c20/c20.rpy:2386
translate french c20s005_EndGameFarewell_c501fb12:

    # bet "¿Tú te das cuenta de la ironía de eso? *Risa* Me he pasado casi toda mi vida siendo precisamente una monja curandera."
    bet "Vous vous rendez compte de l'ironie de la situation ? *Rires* J'ai passé presque toute ma vie à être précisément une nonne guérisseuse."

# game/scripts/c20/c20.rpy:2388
translate french c20s005_EndGameFarewell_2ac73579:

    # sca "*Risa* Creo que [dap] no lo había pensado. Si quieres puedes jugar con un guerrero o un mago..."
    sca "*Rires* Je ne pense pas que [dap] y ait pensé. Si tu veux, tu peux jouer un guerrier ou un mage..."

# game/scripts/c20/c20.rpy:2389
translate french c20s005_EndGameFarewell_1a93d918:

    # sca "Aunque te hagas una monja, te puedes follar a [mc] igualmente. *Risa*"
    sca "Même si tu deviens nonne, tu peux toujours baiser [mc]. *Rires*"

# game/scripts/c20/c20.rpy:2391
translate french c20s005_EndGameFarewell_1525074d:

    # sca "Sólo tienes que ver a [dap], la Semielfa putilla. *Risa*"
    sca "Il suffit de regarder [dap], cette petite demi-elfe salope. *Rires*"

# game/scripts/c20/c20.rpy:2393
translate french c20s005_EndGameFarewell_01267f8c:

    # bet "Me ha parecido que os lo pasabais muy bien. Podría ser divertido unirme, ahora que parece que no voy a volver a Florida."
    bet "Vous aviez l'air de bien vous amuser. Ce serait peut-être sympa de me joindre à vous, maintenant que je ne pense pas retourner en Floride."

# game/scripts/c20/c20.rpy:2395
translate french c20s005_EndGameFarewell_d500f517:

    # bet "Pero dejadme pensarlo unos días..."
    bet "Mais laissez-moi y réfléchir quelques jours..."

# game/scripts/c20/c20.rpy:2396
translate french c20s005_EndGameFarewell_aac421b9:

    # mcp "(Al menos hasta la visita a Monterey, ¿no?)"
    mcp "(Du moins jusqu'à la visite de Monterey, n'est-ce pas ?)"

# game/scripts/c20/c20.rpy:2398
translate french c20s005_EndGameFarewell_491b2c1b:

    # emm "No es que te quiera echar, Mads, pero ¿tú no tenías que madrugar?"
    emm "Je ne veux pas te mettre à la porte, Mads, mais tu n'étais pas censé te lever tôt ?"

# game/scripts/c20/c20.rpy:2400
translate french c20s005_EndGameFarewell_eb79b050:

    # mad "Sí, pero una de las cosas más divertidas de las partidas es comentarlas luego... Estoy dispuesta a sacrificar una hora de sueño."
    mad "Oui, mais l'un des aspects les plus amusants des jeux, c'est d'en discuter après... Je suis prêt à sacrifier une heure de sommeil."

# game/scripts/c20/c20.rpy:2402
translate french c20s005_EndGameFarewell_6649c9db:

    # eri "No es necesario, Maddie. Mañana iremos todas a la tienda y comentaremos la partida si quieres. Así puedes dormir tranquilamente hoy."
    eri "Ce n'est pas nécessaire, Maddie. On ira tous au magasin demain et on parlera du match si tu veux. Comme ça, tu pourras dormir tranquille cette nuit."

# game/scripts/c20/c20.rpy:2404
translate french c20s005_EndGameFarewell_8c0b47f6:

    # sca "Prometemos no comentar nada antes de ir, para que no te pierdas nada de la conversación."
    sca "Nous vous promettons de ne rien dire avant de partir, pour que vous ne manquiez rien de la conversation."

# game/scripts/c20/c20.rpy:2406
translate french c20s005_EndGameFarewell_56648120:

    # mad "Chicas, os lo agradezco. Ha sido un día largo y empiezo a estar cansada."
    mad "Les filles, merci beaucoup. La journée a été longue et je commence à être fatiguée."

# game/scripts/c20/c20.rpy:2409
translate french c20s005_EndGameFarewell_9abc610e:

    # mad "Casi tanto como Vilfredo. *Risa*"
    mad "Presque autant que Vilfredo. *Rires*"

# game/scripts/c20/c20.rpy:2410
translate french c20s005_EndGameFarewell_f7fd3149:

    # mc "¡Hey! El Semielfo ya ha recargado las baterías. Está listo para más rounds. *Risa*"
    mc "Hé ! Le demi-elfe a rechargé ses batteries. Il est prêt pour de nouveaux rounds. *Rires*"

# game/scripts/c20/c20.rpy:2412
translate french c20s005_EndGameFarewell_5d2e6c01:

    # dap "Entonces quedamos así. Mañana en la tienda. No te queremos entretener más y sentirnos culpables si te quedas dormida en un probador. *Risa*"
    dap "Voilà, c'est décidé. Demain au magasin. On ne veut pas vous retenir plus longtemps et se sentir coupables si vous vous endormez dans une cabine d'essayage. *Rires*"

# game/scripts/c20/c20.rpy:2413
translate french c20s005_EndGameFarewell_b3b94564_1:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c20/c20.rpy:2415
translate french c20s005_EndGameFarewell_f5dbebe2:

    # mad "Gracias, chicas."
    mad "Merci les filles."

# game/scripts/c20/c20.rpy:2416
translate french c20s005_EndGameFarewell_6598ab25:

    # mc "Te llevo. ¿Tienes que coger alguna cosa?"
    mc "Je te dépose. Tu as besoin de récupérer quelque chose ?"

# game/scripts/c20/c20.rpy:2418
translate french c20s005_EndGameFarewell_9002c104:

    # mad "Tengo la mochila en la habitación de [eri]. Ahora bajo con ella. Las cajas de los cuadros ya están en la camioneta."
    mad "Mon sac à dos est dans la chambre de [eri]. Je vais descendre avec. Les cartons de tableaux sont déjà dans la camionnette."

# game/scripts/c20/c20.rpy:2419
translate french c20s005_EndGameFarewell_e5a907d7:

    # mc "Perfecto entonces. Voy al lavabo y te veo en el garaje."
    mc "Parfait alors. Je vais aux toilettes et je te rejoins au garage."

# game/scripts/c20/c20.rpy:2420
translate french c20s005_EndGameFarewell_df5c0f2c:

    # eri "Te acompaño, Maddie."
    eri "Je t'accompagnerai, Maddie."

# game/scripts/c20/c20.rpy:2423
translate french c20s005_EndGameFarewell_ae82c249:

    # "Te despides de las chicas y de Tía Betty y vas al lavabo."
    "Vous dites au revoir aux filles et à tante Betty et vous allez aux toilettes."

# game/scripts/c20/c20.rpy:2437
translate french c20s005_Kia_e56161b3:

    # "Al salir del lavabo, te encuentras con Kiara en el pasillo."
    "En sortant de la salle de bain, vous croisez Kiara dans le couloir."

# game/scripts/c20/c20.rpy:2438
translate french c20s005_Kia_15498345:

    # mc "¡Hola, Kiara! Perdón si te he despertado."
    mc "Salut Kiara ! Désolée si je t'ai réveillée."

# game/scripts/c20/c20.rpy:2444
translate french c20s005_Kia_c2279c91:

    # kia "No te preocupes. No podía dormir y te he escuchado subir las escaleras. He venido a ver si tenías un momento para hablar."
    kia "Ne t'inquiète pas. Je n'arrivais pas à dormir et je t'ai entendu monter. Je suis venu voir si tu avais un moment pour parler."

# game/scripts/c20/c20.rpy:2445
translate french c20s005_Kia_b8414fd1:

    # mc "Ahora no es buen momento, Kiara. Tengo que llevar a Maddie a casa."
    mc "Ce n'est pas le bon moment, Kiara. Je dois ramener Maddie à la maison."

# game/scripts/c20/c20.rpy:2448
translate french c20s005_Kia_a4065204:

    # kia "¿Vas a volver a casa o te vas a quedar a dormir?"
    kia "Vous rentrez chez vous ou vous restez dormir sur place ?"

# game/scripts/c20/c20.rpy:2450
translate french c20s005_Kia_7716d653:

    # kia "No te estoy fiscalizando... Es que me gustaría hablar contigo..."
    kia "Je ne vous juge pas... Je voudrais juste vous parler..."

# game/scripts/c20/c20.rpy:2453
translate french c20s005_Kia_5a1fc550:

    # kia "¿Vas a tardar mucho? Me gustaría hablar contigo..."
    kia "Vous allez être long ? J'aimerais vous parler..."

# game/scripts/c20/c20.rpy:2454
translate french c20s005_Kia_a4795cec:

    # mc "La llevo a casa y vuelvo en seguida. ¿Quieres que hablemos cuando vuelva?"
    mc "Je la ramène chez elle et je reviens tout de suite. Tu veux qu'on parle à mon retour ?"

# game/scripts/c20/c20.rpy:2456
translate french c20s005_Kia_4e0d1f0f:

    # kia "Me parece fantástico. Te veo en un rato, entonces."
    kia "Ça a l'air super. À tout à l'heure alors."

# game/scripts/c20/c20.rpy:2457
translate french c20s005_Kia_e4695014:

    # mc "¿No vas a darme un beso antes de irme?"
    mc "Tu ne vas pas m'embrasser avant que je parte ?"

# game/scripts/c20/c20.rpy:2459
translate french c20s005_Kia_d4e8547d:

    # kia "Creía que era solamente en los buenos días y buenas noches..."
    kia "Je croyais que c'était seulement pour dire bonjour et bonsoir..."

# game/scripts/c20/c20.rpy:2460
translate french c20s005_Kia_15557826:

    # mc "Así era antes de que tú y yo estuviéramos juntos."
    mc "C'était comme ça avant que nous soyons ensemble."

# game/scripts/c20/c20.rpy:2461
translate french c20s005_Kia_8da7fb88:

    # mc "Porque estamos juntos, ¿verdad?"
    mc "Parce que nous sommes ensemble, n'est-ce pas ?"

# game/scripts/c20/c20.rpy:2463
translate french c20s005_Kia_d82d5c59:

    # kia "De eso es de lo que quiero hablar contigo... Pero mejor luego, cuando vuelvas."
    kia "C'est de cela que je voulais te parler... Mais il vaut mieux le faire plus tard, à ton retour."

# game/scripts/c20/c20.rpy:2464
translate french c20s005_Kia_8a4b213f:

    # mc "Como desees."
    mc "Comme vous le souhaitez."

# game/scripts/c20/c20.rpy:2466
translate french c20s005_Kia_96c2af65:

    # kia "Hasta dentro de un rato, [mc]."
    kia "À tout à l'heure, [mc]."

# game/scripts/c20/c20.rpy:2468
translate french c20s005_Kia_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Au revoir, Kiara."

# game/scripts/c20/c20.rpy:2529
translate french c20s005_GivingMaddieARide_36ef4791:

    # "Unos minutos después, después de haber sacado la camioneta del garaje..."
    "Quelques minutes plus tard, après avoir sorti le camion du garage..."

# game/scripts/c20/c20.rpy:2530
translate french c20s005_GivingMaddieARide_16efac19:

    # mad "Ya nos podemos ir. Ya me he despedido de las chicas y de Betty."
    mad "Nous pouvons y aller maintenant. J'ai déjà dit au revoir aux filles et à Betty."

# game/scripts/c20/c20.rpy:2531
translate french c20s005_GivingMaddieARide_bbc35977:

    # mc "Cuando quieras podemos irnos, entonces."
    mc "On peut partir quand vous voulez."

# game/scripts/c20/c20.rpy:2533
translate french c20s005_GivingMaddieARide_da70b486:

    # "Al llegar al edificio de Maddie le ayudas a subir las cajas de los cuadros y te despides de ella."
    "Lorsque vous arrivez à l'immeuble de Maddie, vous l'aidez à monter les cartons de tableaux à l'étage et vous lui dites au revoir."

# game/scripts/c20/c20.rpy:2534
translate french c20s005_GivingMaddieARide_a678922f:

    # mad "Muchas gracias por todo, [mc]. Ha sido un día fantástico."
    mad "Merci beaucoup pour tout, [mc]. C'était une journée fantastique."

# game/scripts/c20/c20.rpy:2535
translate french c20s005_GivingMaddieARide_d8cf74d5:

    # mc "Bienvenida a la familia. Bienvenida a los Locos Marks. *Risa* Espero que, a partir de ahora vengas a casa más a menudo."
    mc "Bienvenue dans la famille. Bienvenue chez les Crazy Marks. *Rires* J'espère que tu viendras plus souvent nous voir désormais."

# game/scripts/c20/c20.rpy:2538
translate french c20s005_GivingMaddieARide_c14779c4:

    # mad "Lo haré, no lo dudes. Ahora, si no te importa, debería irme a dormir."
    mad "Je le ferai, ne vous inquiétez pas. Maintenant, si cela ne vous dérange pas, je devrais aller dormir."

# game/scripts/c20/c20.rpy:2539
translate french c20s005_GivingMaddieARide_eba3cfdd:

    # mc "Ningún problema. ¿Zeus está durmiendo? Me gustaría conocerlo."
    mc "Pas de problème. Zeus dort-il ? J'aimerais le rencontrer."

# game/scripts/c20/c20.rpy:2545
translate french c20s005_GivingMaddieARide_eb2c2306:

    # "Parece que el gato ha oído su nombre y aparece para saludar."
    "Il semblerait que le chat ait entendu son nom et qu'il vienne lui dire bonjour."

# game/scripts/c20/c20.rpy:2546
translate french c20s005_GivingMaddieARide_fabc3ed0:

    # zeu "*Ronroneo* (¿Quién eres tú? ¿Vienes a acariciarme? ¡Bien hecho, humano!)"
    zeu "*Ronronnement* (Qui êtes-vous ? Êtes-vous venu me caresser ? Bravo, humain !)"

# game/scripts/c20/c20.rpy:2547
translate french c20s005_GivingMaddieARide_7228dac7:

    # mc "*Risa* Parece que me ha oído."
    mc "*Rires* Il semblerait qu'il m'ait entendu."

# game/scripts/c20/c20.rpy:2548
translate french c20s005_GivingMaddieARide_ade7fb2e:

    # mad "*Risa* En cuanto oye su nombre aparece como salido de la nada. Si son mis amigas se vuelve a esconder."
    mad "*Rires* Dès qu'elle entend son nom, elle surgit de nulle part. Si ce sont mes amis, elle se cache à nouveau."

# game/scripts/c20/c20.rpy:2549
translate french c20s005_GivingMaddieARide_f5e03bef:

    # mad "Parece que contigo tiene curiosidad."
    mad "Il semble qu'il soit curieux à votre sujet."

# game/scripts/c20/c20.rpy:2551
translate french c20s005_GivingMaddieARide_4e4279df:

    # zeu "*Ronroneo* (Sus amigas son idiotas y se ríen como gallinas. Eres un humano que acaricia bien, me gustas.)"
    zeu "*Ronronnement* (Ses amis sont idiots et rient comme des poules. Toi, tu es un humain qui caresse bien, je t'aime bien.)"

# game/scripts/c20/c20.rpy:2552
translate french c20s005_GivingMaddieARide_65826775:

    # mc "Encantado de conocerte por fin, Zeus. He visto unos cuadros fantásticos tuyos."
    mc "Enchanté de faire enfin votre connaissance, Zeus. J'ai vu de magnifiques tableaux de votre part."

# game/scripts/c20/c20.rpy:2553
translate french c20s005_GivingMaddieARide_da4f0765:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronnement* (Je suis très polyvalente. Gothique et scientifique à la fois. On ne parlera pas de la robe rose. Ça n'a jamais existé. Il faut que j'en parle à mon psy.)"

# game/scripts/c20/c20.rpy:2555
translate french c20s005_GivingMaddieARide_b2b41e5c:

    # mc "Bueno, Maddie, te dejo ir a acostarte. A ver si mañana puedo pasarme por la tienda con las chicas para comentar la partida."
    mc "Bon, Maddie, je te laisse aller te coucher. J'essaierai de passer à la boutique avec les filles demain pour parler du match."

# game/scripts/c20/c20.rpy:2556
translate french c20s005_GivingMaddieARide_7f43c3b1:

    # mad "OK. Hasta mañana, [mc]."
    mad "OK. À demain, [mc]."

# game/scripts/c20/c20.rpy:2559
translate french c20s005_GivingMaddieARide_a6cf6482:

    # "Te subes a la camioneta y emprendes el camino a casa."
    "Vous montez dans le camion et commencez le voyage de retour à la maison."

# game/scripts/c20/c20.rpy:2562
translate french c20s005_GivingMaddieARide_78d12f4c:

    # mad "Lo haré. No puedo dejar a Vilfredo solo en el bosque, habiendo un dragón rondando por ahí. *Risa*"
    mad "Je le ferai. Je ne peux pas laisser Vilfredo seul dans la forêt avec un dragon qui rôde. *Rires*"

# game/scripts/c20/c20.rpy:2563
translate french c20s005_GivingMaddieARide_f166ab00:

    # mc "No me refiero solo a las partidas de DnD. Me refiero a las actividades familiares."
    mc "Je ne parle pas seulement des jeux de rôle Donjons et Dragons. Je parle d'activités familiales."

# game/scripts/c20/c20.rpy:2564
translate french c20s005_GivingMaddieARide_4dd3c1b8:

    # mc "Le has caído genial a todo el mundo que no te conocía, y ya les gustabas a las que te conocían."
    mc "Tous ceux qui ne vous connaissaient pas vous appréciaient beaucoup, et ceux qui vous connaissaient déjà vous aimaient bien."

# game/scripts/c20/c20.rpy:2567
translate french c20s005_GivingMaddieARide_8baf9429:

    # mad "Sobre eso..."
    mad "À ce propos..."

# game/scripts/c20/c20.rpy:2568
translate french c20s005_GivingMaddieARide_4f14a2cb:

    # mc "¿Qué pasa Maddie?"
    mc "Qu'est-ce qui ne va pas, Maddie ?"

# game/scripts/c20/c20.rpy:2571
translate french c20s005_GivingMaddieARide_d6037b75:

    # mad "Me mentiste..."
    mad "Tu m'as menti..."

# game/scripts/c20/c20.rpy:2572
translate french c20s005_GivingMaddieARide_e73f25b2:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "De quelle manière ? Je ne comprends pas. Je ne vous ai jamais menti."

# game/scripts/c20/c20.rpy:2574
translate french c20s005_GivingMaddieARide_75ada0a2:

    # mad "Estás saliendo con [mar]..."
    mad "Tu sors avec [mar]..."

# game/scripts/c20/c20.rpy:2576
translate french c20s005_GivingMaddieARide_fbe6db5e:

    # mad "Incluso está embarazada..."
    mad "Elle est même enceinte..."

# game/scripts/c20/c20.rpy:2577
translate french c20s005_GivingMaddieARide_e3bab36f:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Je ne t'ai jamais dit que je ne le faisais pas..."

# game/scripts/c20/c20.rpy:2579
translate french c20s005_GivingMaddieARide_84ecc7e4:

    # mad "Pero aceptaste mi chantaje."
    mad "Mais vous avez accepté mon chantage."

# game/scripts/c20/c20.rpy:2580
translate french c20s005_GivingMaddieARide_6da9e9f8:

    # mc "Porque quería ver dónde iba. Quería probar como era sentirse dominado."
    mc "Parce qu'il voulait voir où cela le mènerait. Il voulait savoir ce que c'était que d'être dominé."

# game/scripts/c20/c20.rpy:2582
translate french c20s005_GivingMaddieARide_027922b0:

    # mad "Me estás diciendo que nunca tuve poder sobre ti, ¿no?"
    mad "Vous êtes en train de me dire que je n'ai jamais eu le moindre pouvoir sur vous, n'est-ce pas ?"

# game/scripts/c20/c20.rpy:2583
translate french c20s005_GivingMaddieARide_32b8280f:

    # mc "No es eso. Tenías poder sobre mí porque yo te lo dejaba tener. No porque el secreto que guardabas fuera a hacerme daño si lo revelabas."
    mc "Ce n'est pas ça. Tu avais du pouvoir sur moi parce que je te l'ai permis, pas parce que le secret que tu gardais m'aurait blessé si tu l'avais révélé."

# game/scripts/c20/c20.rpy:2584
translate french c20s005_GivingMaddieARide_ed69ab30:

    # mc "Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Elle en serait certainement flattée."

# game/scripts/c20/c20.rpy:2586
translate french c20s005_GivingMaddieARide_1b34f9ba:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Je suis content que tu l'aies fait. Même si je me suis senti un peu bête en découvrant la vérité."

# game/scripts/c20/c20.rpy:2587
translate french c20s005_GivingMaddieARide_d5002491:

    # mad "Y eso me lleva a otra pregunta..."
    mad "Et cela m'amène à une autre question..."

# game/scripts/c20/c20.rpy:2588
translate french c20s005_GivingMaddieARide_185a3c0f:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Dis-moi, Maddie. Tu sais que tu peux tout me dire."

# game/scripts/c20/c20.rpy:2590
translate french c20s005_GivingMaddieARide_17c8bf13:

    # mad "¿Quiere decir eso que estabas conmigo porque querías? ¿No porque yo te obligara?"
    mad "Cela signifie-t-il que tu étais avec moi parce que tu le voulais ? Et non parce que je t'y ai forcé ?"

# game/scripts/c20/c20.rpy:2591
translate french c20s005_GivingMaddieARide_20004a1b:

    # mc "Sí. Estaba contigo porque quería. No podías obligarme, Maddie. El secreto no tenía ningún poder sobre mí."
    mc "Oui. J'étais avec toi parce que je le voulais. Tu ne pouvais pas me forcer, Maddie. Le secret n'avait aucun pouvoir sur moi."

# game/scripts/c20/c20.rpy:2593
translate french c20s005_GivingMaddieARide_c524525a:

    # mad "Entonces te libero. No quiero estar contigo así."
    mad "Alors je te libère. Je ne veux plus être avec toi comme ça."

# game/scripts/c20/c20.rpy:2596
translate french c20s005_GivingMaddieARide_d6037b75_1:

    # mad "Me mentiste..."
    mad "Tu m'as menti..."

# game/scripts/c20/c20.rpy:2597
translate french c20s005_GivingMaddieARide_e73f25b2_1:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "De quelle manière ? Je ne comprends pas. Je ne vous ai jamais menti."

# game/scripts/c20/c20.rpy:2599
translate french c20s005_GivingMaddieARide_75ada0a2_1:

    # mad "Estás saliendo con [mar]..."
    mad "Tu sors avec [mar]..."

# game/scripts/c20/c20.rpy:2601
translate french c20s005_GivingMaddieARide_fbe6db5e_1:

    # mad "Incluso está embarazada..."
    mad "Elle est même enceinte..."

# game/scripts/c20/c20.rpy:2602
translate french c20s005_GivingMaddieARide_e3bab36f_1:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Je ne t'ai jamais dit que je ne le faisais pas..."

# game/scripts/c20/c20.rpy:2604
translate french c20s005_GivingMaddieARide_6dd08023:

    # mad "Pero mi intento de chantaje..."
    mad "Mais ma tentative de chantage..."

# game/scripts/c20/c20.rpy:2605
translate french c20s005_GivingMaddieARide_753a680c:

    # mc "Tú intentaste chantajearme antes de que estuviéramos juntos. Nada cambia."
    mc "Tu as essayé de me faire chanter avant même qu'on soit ensemble. Rien ne change."

# game/scripts/c20/c20.rpy:2607
translate french c20s005_GivingMaddieARide_f837d6fe:

    # mad "Me estás diciendo que, aunque hubiera salido bien nunca hubiera tenido poder sobre ti, ¿no?"
    mad "Vous êtes en train de me dire que même si tout s'était bien passé, je n'aurais jamais eu le moindre pouvoir sur vous, c'est bien ça ?"

# game/scripts/c20/c20.rpy:2608
translate french c20s005_GivingMaddieARide_e2e209c3:

    # mc "Más o menos. A menos que yo te lo hubiera dejado tener. Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Plus ou moins. À moins que je ne vous l'aie dit. Je suis sûr que [mar] serait flatté si vous le faisiez."

# game/scripts/c20/c20.rpy:2609
translate french c20s005_GivingMaddieARide_5519561f:

    # mc "Pero le dimos la vuelta y ahora soy yo el que tiene poder sobre ti, ¿no?"
    mc "Mais on a inversé la situation et maintenant c'est moi qui ai le pouvoir sur toi, pas vrai ?"

# game/scripts/c20/c20.rpy:2611
translate french c20s005_GivingMaddieARide_1b34f9ba_1:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Je suis content que tu l'aies fait. Même si je me suis senti un peu bête en découvrant la vérité."

# game/scripts/c20/c20.rpy:2612
translate french c20s005_GivingMaddieARide_d5002491_1:

    # mad "Y eso me lleva a otra pregunta..."
    mad "Et cela m'amène à une autre question..."

# game/scripts/c20/c20.rpy:2613
translate french c20s005_GivingMaddieARide_185a3c0f_1:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Dis-moi, Maddie. Tu sais que tu peux tout me dire."

# game/scripts/c20/c20.rpy:2615
translate french c20s005_GivingMaddieARide_d3d03417:

    # mad "¿Quiere decir eso que estás conmigo sólo porque tienes poder sobre mí?"
    mad "Cela signifie-t-il que tu es avec moi uniquement parce que tu as du pouvoir sur moi ?"

# game/scripts/c20/c20.rpy:2616
translate french c20s005_GivingMaddieARide_48639672:

    # mc "No. Estoy contigo porque quiero estarlo. No esperaba estarlo en estas circunstancias, pero me gusta estar contigo."
    mc "Non. Je suis avec toi parce que je le veux. Je ne m'attendais pas à être dans ces circonstances, mais j'aime être avec toi."

# game/scripts/c20/c20.rpy:2618
translate french c20s005_GivingMaddieARide_38efc1b3:

    # mad "Entonces, si quieres, puedes denunciarme a mi jefe."
    mad "Donc, si vous voulez, vous pouvez me dénoncer à mon supérieur."

# game/scripts/c20/c20.rpy:2619
translate french c20s005_GivingMaddieARide_65b1fd2a:

    # mad "No quiero estar contigo así."
    mad "Je ne veux pas être avec toi comme ça."

# game/scripts/c20/c20.rpy:2621
translate french c20s005_GivingMaddieARide_c05ecd45:

    # mc "{b}¿Qué?{/b} ¿Estás rompiendo conmigo?"
    mc "{b}Quoi ?{/b} Tu me quittes ?"

# game/scripts/c20/c20.rpy:2623
translate french c20s005_GivingMaddieARide_e25417f1:

    # mad "Sí. Espérame aquí un momento. Ahora vuelvo."
    mad "Oui. Attendez un instant. Je reviens tout de suite."

# game/scripts/c20/c20.rpy:2624
translate french c20s005_GivingMaddieARide_704e54a3:

    # mc "¿Me he perdido algo? No te entiendo."
    mc "Ai-je raté quelque chose ? Je ne vous comprends pas."

# game/scripts/c20/c20.rpy:2626
translate french c20s005_GivingMaddieARide_db54acf2:

    # zeu "¡Miau! (¿Qué le has hecho ahora? ¡Me caías bien!)"
    zeu "Miaou ! (Qu'est-ce que tu lui as encore fait ? Je t'aimais bien !)"

# game/scripts/c20/c20.rpy:2627
translate french c20s005_GivingMaddieARide_1dee14f4:

    # mc "Hola, pequeñín. ¿Sabes que le ha pasado a Maddie? ¿Me has echado de menos?"
    mc "Salut, ma petite. Sais-tu ce qui est arrivé à Maddie ? Tu m’as manqué ?"

# game/scripts/c20/c20.rpy:2628
translate french c20s005_GivingMaddieARide_c3aae098:

    # zeu "¡Miau! (No tengo ni idea de qué le has hecho. Y sobre echarte de menos, depende. ¿Me has traído atún para una cena tardía?)"
    zeu "Miaou ! (Je n'ai aucune idée de ce que tu lui as fait. Et quant à savoir si tu me manques, ça dépend. M'as-tu apporté du thon pour un dîner tardif ?)"

# game/scripts/c20/c20.rpy:2630
translate french c20s005_GivingMaddieARide_9ee1b869:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Ronronnement* (D'accord, je te pardonne... Mais que cela ne se reproduise plus.)"

# game/scripts/c20/c20.rpy:2631
translate french c20s005_GivingMaddieARide_f20a31cc:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Tu m'as manqué aussi. Tes tableaux ont connu un grand succès."

# game/scripts/c20/c20.rpy:2632
translate french c20s005_GivingMaddieARide_da4f0765_1:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronnement* (Je suis très polyvalente. Gothique et scientifique à la fois. On ne parlera pas de la robe rose. Ça n'a jamais existé. Il faut que j'en parle à mon psy.)"

# game/scripts/c20/c20.rpy:2634
translate french c20s005_GivingMaddieARide_5708e270:

    # mad "Hola, [mc]. ¿Puedo ayudarte en algo?"
    mad "Salut, [mc]. Puis-je vous aider ?"

# game/scripts/c20/c20.rpy:2635
translate french c20s005_GivingMaddieARide_60c7fe73:

    # mc "Hola de nuevo, Maddie. ¿Esas gafas?"
    mc "Salut Maddie. Ces lunettes ?"

# game/scripts/c20/c20.rpy:2637
translate french c20s005_GivingMaddieARide_9bc8c161:

    # mad "Creo que te equivocas. Maddie vive aquí, pero no lleva gafas. Yo soy Madison... No... Claire... Kent."
    mad "Je crois que vous vous trompez. Maddie habite ici, mais elle ne porte pas de lunettes. Je suis Madison… Non… Claire… Kent."

# game/scripts/c20/c20.rpy:2638
translate french c20s005_GivingMaddieARide_9c84e9bf:

    # mcp "(OK. Sigamos el juego. Solo te falta una cabina de teléfono para cambiarte de vestimenta.)"
    mcp "(D'accord. Jouons le jeu. Il ne vous manque plus qu'une cabine téléphonique pour vous changer.)"

# game/scripts/c20/c20.rpy:2639
translate french c20s005_GivingMaddieARide_2890b878:

    # mc "Perdón por la confusión. Mi amiga me ha dicho algo que no entiendo y se ha ido."
    mc "Excusez-moi pour la confusion. Mon ami a dit quelque chose que je n'ai pas compris, puis il est parti."

# game/scripts/c20/c20.rpy:2641
translate french c20s005_GivingMaddieARide_59b0dbd7:

    # mad "Sí, ha roto contigo. No quiere seguir teniendo la relación que ha tenido hasta ahora."
    mad "Oui, elle a rompu avec toi. Elle ne souhaite pas poursuivre la relation que vous aviez jusqu'à présent."

# game/scripts/c20/c20.rpy:2642
translate french c20s005_GivingMaddieARide_b67fb6f4:

    # mad "Es una lástima... hacíais tan buena pareja..."
    mad "C'est dommage... vous formiez un si beau couple..."

# game/scripts/c20/c20.rpy:2643
translate french c20s005_GivingMaddieARide_6b6a3698:

    # mc "Pero no lo entiendo..."
    mc "Mais je ne comprends pas..."

# game/scripts/c20/c20.rpy:2645
translate french c20s005_GivingMaddieARide_adff9d34:

    # mad "Es muy fácil de entender. Después de ver lo que puede ser tener una relación completa... romántica... contigo. No quiere tener un sucedáneo."
    mad "C'est très facile à comprendre. Après avoir vu à quoi peut ressembler une relation amoureuse épanouissante avec toi, elle ne veut pas de substitut."

# game/scripts/c20/c20.rpy:2647
translate french c20s005_GivingMaddieARide_60be8291:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su trabajo a perder la oportunidad de tener algo más sincero contigo."
    mad "Elle dit que c'était amusant, mais que ce n'est pas pour elle. Elle préférerait perdre son travail plutôt que de rater l'occasion de vivre une relation plus authentique avec toi."

# game/scripts/c20/c20.rpy:2649
translate french c20s005_GivingMaddieARide_7a79c608:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su poder, si es que lo tenía, a perder la oportunidad de tener algo más sincero contigo."
    mad "Elle dit que c'était amusant, mais que ce n'est pas son truc. Elle préférerait perdre son pouvoir, si elle en a jamais eu, plutôt que de rater l'occasion de vivre une relation plus authentique avec toi."

# game/scripts/c20/c20.rpy:2650
translate french c20s005_GivingMaddieARide_49c884ea:

    # mc "Yo pienso lo mismo. Tú no estabas hoy en mi casa, pero con todo el mundo tengo una relación basada en el respeto, no en guardar secretos."
    mc "Je pense la même chose. Tu n'étais pas chez moi aujourd'hui, mais j'entretiens des relations avec chacun basées sur le respect, et non sur le secret."

# game/scripts/c20/c20.rpy:2651
translate french c20s005_GivingMaddieARide_5db10965:

    # mc "Yo esperaba que nuestra relación evolucionara hacia algo más romántico. Pero si ha roto conmigo, creo que debería irme..."
    mc "J'espérais que notre relation évoluerait vers quelque chose de plus romantique. Mais s'il a rompu avec moi, je pense que je devrais partir..."

# game/scripts/c20/c20.rpy:2653
translate french c20s005_GivingMaddieARide_748c3ccd:

    # mad "¿Qué? ¡No!"
    mad "Non!"

# game/scripts/c20/c20.rpy:2655
translate french c20s005_GivingMaddieARide_d8b39b3d:

    # mad "Digo..."
    mad "Dire..."

# game/scripts/c20/c20.rpy:2656
translate french c20s005_GivingMaddieARide_31d5dd14:

    # mad "Puedo hacer que Maddie vuelva, si quieres. Estoy segura de que le gustaría oir lo que has dicho."
    mad "Je peux faire revenir Maddie, si tu veux. Je suis sûre qu'elle aimerait entendre ce que tu as dit."

# game/scripts/c20/c20.rpy:2657
translate french c20s005_GivingMaddieARide_74bfce3d:

    # mc "Sí, por favor. Hazla volver."
    mc "Oui, je vous en prie. Ramenez-la."

# game/scripts/c20/c20.rpy:2659
translate french c20s005_GivingMaddieARide_26028f2c:

    # mad "Un momento, por favor."
    mad "Un instant s'il vous plaît."

# game/scripts/c20/c20.rpy:2661
translate french c20s005_GivingMaddieARide_9c1cced8:

    # mad "Me ha dicho Claire que quieres hablar conmigo. Sobre por qué he roto contigo."
    mad "Claire m'a dit que tu voulais me parler. À propos de pourquoi j'ai rompu avec toi."

# game/scripts/c20/c20.rpy:2662
translate french c20s005_GivingMaddieARide_ae0a59dd:

    # mc "¿A qué viene esto, Maddie?"
    mc "De quoi s'agit-il, Maddie ?"

# game/scripts/c20/c20.rpy:2664
translate french c20s005_GivingMaddieARide_189eaa31:

    # mad "No sabía cómo decirte que quiero estar contigo... "
    mad "Je ne savais pas comment te dire que je veux être avec toi..."

# game/scripts/c20/c20.rpy:2666
translate french c20s005_GivingMaddieARide_2701d7a4:

    # mad "... como estás con [mar]..."
    mad "...comment allez-vous avec [mar]..."

# game/scripts/c20/c20.rpy:2668
translate french c20s005_GivingMaddieARide_715ea0d0:

    # mad "... como estás con el resto de las chicas..."
    mad "...comme tu l'es avec les autres filles..."

# game/scripts/c20/c20.rpy:2669
translate french c20s005_GivingMaddieARide_7fecd2e0:

    # mad "Quiero una relación de verdad. Me gusta mucho lo que tenemos, pero... después de ver lo que podría tener... quiero más."
    mad "Je veux une vraie relation. J'aime beaucoup ce que nous avons, mais… après avoir vu ce que j'aurais pu avoir… je veux plus."

# game/scripts/c20/c20.rpy:2670
translate french c20s005_GivingMaddieARide_05dbb4cf:

    # mc "Y se te ha ocurrido este juego."
    mc "Et vous avez inventé ce jeu."

# game/scripts/c20/c20.rpy:2672
translate french c20s005_GivingMaddieARide_61508003:

    # mad "Llevo desde la Gran Revelación pensando cómo hacerlo. Y al final no he usado ninguna de las ideas que tenía."
    mad "Depuis la Révélation, je réfléchis à la manière de procéder. Et finalement, je n'ai utilisé aucune des idées que j'avais."

# game/scripts/c20/c20.rpy:2673
translate french c20s005_GivingMaddieARide_574339e8:

    # mad "Quería hablarlo en la piscina, pero justo en ese momento ha llegado Debbie..."
    mad "Je voulais en parler au bord de la piscine, mais c'est à ce moment-là que Debbie est arrivée..."

# game/scripts/c20/c20.rpy:2674
translate french c20s005_GivingMaddieARide_c2ba7b18:

    # mad "Quiero olvidar lo que hemos hecho hasta ahora y empezar desde cero. ¿Crees que podríamos probarlo?"
    mad "Je veux oublier tout ce qu'on a fait jusqu'ici et repartir de zéro. Tu crois qu'on pourrait essayer ?"

# game/scripts/c20/c20.rpy:2675
translate french c20s005_GivingMaddieARide_add99a6a:

    # mc "No. Lo siento, Maddie."
    mc "Non. Je suis désolée, Maddie."

# game/scripts/c20/c20.rpy:2677
translate french c20s005_GivingMaddieARide_2215400f:

    # mad "Pero..."
    mad "Mais..."

# game/scripts/c20/c20.rpy:2678
translate french c20s005_GivingMaddieARide_8755a89a:

    # mc "Déjame hablar un momento."
    mc "Permettez-moi de parler un instant."

# game/scripts/c20/c20.rpy:2679
translate french c20s005_GivingMaddieARide_b09238b8:

    # mc "No quiero olvidar lo que hemos hecho hasta ahora. Creo que la evolución natural de lo que estábamos haciendo es lo que vamos a hacer ahora."
    mc "Je ne veux pas oublier ce que nous avons accompli jusqu'à présent. Je crois que la suite logique de ce que nous avons fait est ce que nous allons faire maintenant."

# game/scripts/c20/c20.rpy:2680
translate french c20s005_GivingMaddieARide_5d3aacf1:

    # mc "Pero eso no significa que no nos lo hayamos pasado bien."
    mc "Mais cela ne veut pas dire que nous ne nous sommes pas amusés."

# game/scripts/c20/c20.rpy:2681
translate french c20s005_GivingMaddieARide_c3916d55:

    # mc "Podemos tener una relación de verdad, pero sin dejar de hacer las cosas divertidas que hemos hecho hasta ahora."
    mc "Nous pouvons avoir une vraie relation, sans pour autant cesser de faire les choses amusantes que nous avons faites jusqu'à présent."

# game/scripts/c20/c20.rpy:2683
translate french c20s005_GivingMaddieARide_82109074:

    # mad "Me parece bien... ¿Significa que ahora soy una más de tus novias?"
    mad "Ça me va… Ça veut dire que je suis maintenant une de tes copines ?"

# game/scripts/c20/c20.rpy:2684
translate french c20s005_GivingMaddieARide_d124f304:

    # mc "No me gustan las etiquetas, pero si a ti te gustan, sí, eres una más."
    mc "Je n'aime pas les étiquettes, mais si vous les aimez, alors oui, vous en faites partie."

# game/scripts/c20/c20.rpy:2686
translate french c20s005_GivingMaddieARide_8d834bb4:

    # "Maddie se lanza a tus brazos buscando tus labios en un beso lleno de alivio."
    "Maddie se jette dans vos bras, cherchant vos lèvres dans un baiser empli de soulagement."

# game/scripts/c20/c20.rpy:2687
translate french c20s005_GivingMaddieARide_7c7f289f:

    # "El beso dura unos segundos antes de que se separe de ti."
    "Le baiser dure quelques secondes avant qu'il ne se retire."

# game/scripts/c20/c20.rpy:2689
translate french c20s005_GivingMaddieARide_9ca2ff4a:

    # mad "¡Gracias, [mc]! Estaba aterrorizada de planteártelo."
    mad "Merci, [mc] ! J'avais une peur bleue d'en parler avec toi."

# game/scripts/c20/c20.rpy:2690
translate french c20s005_GivingMaddieARide_7217336c:

    # mc "No me des las gracias. Los dos ganamos con este cambio. Es lo que los dos queremos."
    mc "Ne me remerciez pas. Ce changement nous est bénéfique à tous les deux. C'est ce que nous voulons tous les deux."

# game/scripts/c20/c20.rpy:2692
translate french c20s005_GivingMaddieARide_bad70e44:

    # mc "Y nunca me pareció que estuvieras muy a gusto en el papel de dominatrix."
    mc "Et je n'ai jamais eu l'impression que vous étiez très à l'aise dans le rôle de dominatrice."

# game/scripts/c20/c20.rpy:2694
translate french c20s005_GivingMaddieARide_7e73f8d0:

    # mad "No, no lo estaba. Me gustó probarlo y tener el control... pensar que tenía el control..."
    mad "Non, pas du tout. J'aimais bien essayer et avoir le contrôle… enfin, je croyais avoir le contrôle…"

# game/scripts/c20/c20.rpy:2696
translate french c20s005_GivingMaddieARide_7412199c:

    # mc "Aunque me pareció que estabas muy a gusto en el papel de gatita sumisa."
    mc "Bien qu'il me semblât que vous étiez très à l'aise dans le rôle de chaton soumis."

# game/scripts/c20/c20.rpy:2698
translate french c20s005_GivingMaddieARide_046425b4:

    # mad "Si, lo estaba. Me gustó probarlo y saber que no tenía el control..."
    mad "Oui, je l'étais. J'ai aimé essayer et savoir que je n'avais pas le contrôle..."

# game/scripts/c20/c20.rpy:2699
translate french c20s005_GivingMaddieARide_22dd7e9a:

    # mad "Pero no estoy hecha para eso. Soy demasiado... normal..."
    mad "Mais je ne suis pas faite pour ça. Je suis trop... normale..."

# game/scripts/c20/c20.rpy:2701
translate french c20s005_GivingMaddieARide_ccb07a8b:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con otras mujeres."
    mc "*Rires* Non, Maddie. Tu n'es pas normale. Je ne pense pas que « normal » implique de partager son petit ami avec d'autres femmes."

# game/scripts/c20/c20.rpy:2703
translate french c20s005_GivingMaddieARide_57756bba:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con su suegra."
    mc "*Rires* Non, Maddie. Tu n'es pas normale. Je ne pense pas que « normal » implique de partager son petit ami avec sa belle-mère."

# game/scripts/c20/c20.rpy:2704
translate french c20s005_GivingMaddieARide_30a2cede:

    # mc "Pero me encanta que no seamos normales en esto. Además, ¿quién define qué es normal y qué no?"
    mc "Mais j'adore le fait que nous ne soyons pas normaux à cet égard. D'ailleurs, qui décide de ce qui est normal et de ce qui ne l'est pas ?"

# game/scripts/c20/c20.rpy:2705
translate french c20s005_GivingMaddieARide_338ebfc4:

    # mc "Y la gente a la que le gusta la dominación también son normales. Con otros gustos, pero normales."
    mc "Et les personnes qui aiment dominer sont tout à fait normales. Avec des goûts différents, certes, mais normales."

# game/scripts/c20/c20.rpy:2707
translate french c20s005_GivingMaddieARide_3f0c4ec5:

    # mad "¿Quieres quedarte a dormir? Nuestra primera vez como pareja..."
    mad "Tu veux rester dormir ? C'est notre première fois en couple..."

# game/scripts/c20/c20.rpy:2708
translate french c20s005_GivingMaddieARide_656167a3:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Non, Maddie. Il est tard… il est tard depuis deux heures… et tu dois te reposer. Tu dois te lever tôt demain."

# game/scripts/c20/c20.rpy:2710
translate french c20s005_GivingMaddieARide_b70c6047:

    # mad "Tienes razón, es tardísimo. Nuestra primera vez tendrá que esperar."
    mad "Tu as raison, c'est bien trop tard. Notre première fois devra attendre."

# game/scripts/c20/c20.rpy:2711
translate french c20s005_GivingMaddieARide_7a0a6a47:

    # mc "Sólo te pido una cosa. Pídele a Claire las gafas para lo próxima vez. *Risa* Estaba super sexy."
    mc "Je ne demande qu'une chose : la prochaine fois, demande à Claire ses lunettes. *Rires* Elle était super sexy."

# game/scripts/c20/c20.rpy:2713
translate french c20s005_GivingMaddieARide_18d5ae23:

    # mad "*Risa* Sólo las uso cuando estoy en el ordenador muchas horas y me quito las lentillas. Normalmente no las necesito."
    mad "*Rires* Je ne les utilise que lorsque je suis sur l'ordinateur pendant de longues heures et que j'enlève mes lentilles de contact. En général, je n'en ai pas besoin."

# game/scripts/c20/c20.rpy:2714
translate french c20s005_GivingMaddieARide_f0928b95:

    # mc "Pues creo que las vamos a usar lejos del ordenador también. Estás monísima con ellas."
    mc "Eh bien, je pense qu'on les portera aussi loin de l'ordinateur. Tu es adorable avec."

# game/scripts/c20/c20.rpy:2716
translate french c20s005_GivingMaddieARide_0371334c:

    # mad "*Risa* Eso tiene fácil arreglo."
    mad "*Rires* Ça se répare facilement."

# game/scripts/c20/c20.rpy:2719
translate french c20s005_GivingMaddieARide_f5267c98:

    # mad "Dame un segundo que me quite las lentillas. Los ojos me pican muchísimo."
    mad "Donnez-moi une seconde, le temps que j'enlève mes lentilles de contact. J'ai les yeux qui me démangent vraiment."

# game/scripts/c20/c20.rpy:2720
translate french c20s005_GivingMaddieARide_5b2e4889:

    # mc "No sabía que llevaras lentillas... pero ve, no te preocupes."
    mc "Je ne savais pas que tu portais des lentilles de contact... mais vas-y, ne t'inquiète pas."

# game/scripts/c20/c20.rpy:2722
translate french c20s005_GivingMaddieARide_ab55b4b0:

    # zeu "¡Miau! (¡Has vuelto! ¡Espero que vengas dispuesto a acariciarme!)"
    zeu "Miaou ! (Tu es de retour ! J'espère que tu es prêt à me caresser !)"

# game/scripts/c20/c20.rpy:2723
translate french c20s005_GivingMaddieARide_b7d29416:

    # mc "Hola, pequeñín. ¿Me has echado de menos?"
    mc "Bonjour, mon petit. Tu m'as manqué ?"

# game/scripts/c20/c20.rpy:2724
translate french c20s005_GivingMaddieARide_85d29c04:

    # zeu "¡Miau! (¿Me has traído atún para una cena tardía esta vez?)"
    zeu "Miaou ! (Tu m'as apporté du thon pour un dîner tardif cette fois-ci ?)"

# game/scripts/c20/c20.rpy:2726
translate french c20s005_GivingMaddieARide_9ee1b869_1:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Ronronnement* (D'accord, je te pardonne... Mais que cela ne se reproduise plus.)"

# game/scripts/c20/c20.rpy:2727
translate french c20s005_GivingMaddieARide_f20a31cc_1:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Tu m'as manqué aussi. Tes tableaux ont connu un grand succès."

# game/scripts/c20/c20.rpy:2728
translate french c20s005_GivingMaddieARide_da4f0765_2:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Ronronnement* (Je suis très polyvalente. Gothique et scientifique à la fois. On ne parlera pas de la robe rose. Ça n'a jamais existé. Il faut que j'en parle à mon psy.)"

# game/scripts/c20/c20.rpy:2730
translate french c20s005_GivingMaddieARide_8e201dc2:

    # mad "Ya estoy."
    mad "Je suis là."

# game/scripts/c20/c20.rpy:2731
translate french c20s005_GivingMaddieARide_e5a0c6fa:

    # mc "¡Wow! Te quedan genial. Deberías llevarlas más a menudo."
    mc "Waouh ! Elles te vont super bien. Tu devrais les porter plus souvent."

# game/scripts/c20/c20.rpy:2733
translate french c20s005_GivingMaddieARide_c3f43795:

    # mad "Gracias. ¿Quieres quedarte a dormir?"
    mad "Merci. Souhaiteriez-vous passer la nuit sur place ?"

# game/scripts/c20/c20.rpy:2734
translate french c20s005_GivingMaddieARide_656167a3_1:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Non, Maddie. Il est tard… il est tard depuis deux heures… et tu dois te reposer. Tu dois te lever tôt demain."

# game/scripts/c20/c20.rpy:2736
translate french c20s005_GivingMaddieARide_07711480:

    # mad "Tienes razón, es tardísimo. Espero que el día que te quedes llegue pronto."
    mad "Tu as raison, il est très tard. J'espère que le jour où tu resteras viendra bientôt."

# game/scripts/c20/c20.rpy:2737
translate french c20s005_GivingMaddieARide_aa3251b4:

    # mc "No tardará, te lo prometo."
    mc "Ça ne sera pas long, je vous le promets."

# game/scripts/c20/c20.rpy:2739
translate french c20s005_GivingMaddieARide_fe5338d9:

    # "Os dais un beso de buenas noches, sabiendo que el día siguiente os volveréis a ver en la tienda."
    "Vous vous donnez un baiser de bonne nuit, sachant que vous vous reverrez au magasin le lendemain."

# game/scripts/c20/c20.rpy:2741
translate french c20s005_GivingMaddieARide_98198ac8:

    # mad "¡Oh, mierda!"
    mad "Oh merde!"

# game/scripts/c20/c20.rpy:2742
translate french c20s005_GivingMaddieARide_b85e5ed2:

    # mc "¿Qué pasa, Maddie?"
    mc "Qu'est-ce qui ne va pas, Maddie ?"

# game/scripts/c20/c20.rpy:2744
translate french c20s005_GivingMaddieARide_b7486548:

    # mad "Habíamos dicho de hacer el test de embarazo al acabar la partida de DnD y nos hemos olvidado los dos."
    mad "Nous avions convenu de faire un test de grossesse après notre partie de Donjons et Dragons, et nous avons toutes les deux oublié."

# game/scripts/c20/c20.rpy:2745
translate french c20s005_GivingMaddieARide_31b35a13:

    # mc "¡Es verdad! No he pensado en el test en todo el día, lo siento. Mañana te lo llevo a la tienda. Aún estaremos dentro del plazo de las 120 horas para la píldora."
    mc "C'est exact ! Je n'y ai pas pensé de la journée, je suis désolée. Je l'apporterai au magasin demain. Nous serons encore dans les 120 heures pour la pilule."

# game/scripts/c20/c20.rpy:2747
translate french c20s005_GivingMaddieARide_bbfef618:

    # mad "Sobre eso... Si no te importa... Preferiría no tomarla."
    mad "À ce propos... Si cela ne vous dérange pas... je préférerais ne pas le prendre."

# game/scripts/c20/c20.rpy:2749
translate french c20s005_GivingMaddieARide_aea65c3d:

    # mad "Nuestra relación ha cambiado y..."
    mad "Notre relation a changé et..."

# game/scripts/c20/c20.rpy:2751
translate french c20s005_GivingMaddieARide_889469d9:

    # mad "Después de todo lo que ha pasado hoy..."
    mad "Après tout ce qui s'est passé aujourd'hui..."

# game/scripts/c20/c20.rpy:2752
translate french c20s005_GivingMaddieARide_a58a0df2:

    # mc "Te entiendo. Pero ¿quieres saber igualmente si estás embarazada?"
    mc "Je comprends. Mais voulez-vous toujours savoir si vous êtes enceinte ?"

# game/scripts/c20/c20.rpy:2754
translate french c20s005_GivingMaddieARide_5f0f935a:

    # mad "No. Quiero tener la experiencia de novia normal. Quiero enterarme cuando tenga un retraso y poder llamarte emocionada sin saber si estoy embarazada o no."
    mad "Non. Je veux vivre une relation amoureuse normale. Je veux savoir quand je suis en retard et pouvoir t'appeler toute excitée sans savoir si je suis enceinte ou non."

# game/scripts/c20/c20.rpy:2755
translate french c20s005_GivingMaddieARide_83770045:

    # mad "Si a ti te parece bien, claro."
    mad "Si cela vous convient, bien sûr."

# game/scripts/c20/c20.rpy:2756
translate french c20s005_GivingMaddieARide_670e0d91:

    # mc "Me parece perfecto, Maddie. Los tests rápidos son fantásticos, pero le quitan un poco de esa emoción de la que hablas."
    mc "Ça me paraît parfait, Maddie. Les tests rapides sont fantastiques, mais ils enlèvent un peu de l'excitation dont tu parlais."

# game/scripts/c20/c20.rpy:2758
translate french c20s005_GivingMaddieARide_c180beb8:

    # mad "Y ahora te voy a echar de mi casa antes de que empiece a bostezar. No sería muy glamouroso que me vieras hasta la campanilla cuando bostece."
    mad "Et maintenant, je vais te mettre à la porte avant même d'avoir commencé à bâiller. Ce ne serait pas très glamour si tu me voyais bâiller jusqu'à la luette."

# game/scripts/c20/c20.rpy:2759
translate french c20s005_GivingMaddieARide_1f99d993:

    # mc "*Risa* No te preocupes. Descansa y nos vemos mañana."
    mc "*Rires* Ne t'inquiète pas. Repose-toi bien et on se voit demain."

# game/scripts/c20/c20.rpy:2761
translate french c20s005_GivingMaddieARide_ef8997c2:

    # "Os volvéis a dar otro beso de buenas noches y te marchas a casa antes de volver a enzarzaros en otro tema de conversación."
    "Vous vous donnez un dernier baiser de bonne nuit et rentrez chez vous avant d'aborder un autre sujet de conversation."

# game/scripts/c20/c20.rpy:2766
translate french c20s006_ReturningHome_accc05d2:

    # "Cuando llegas a casa, ves a Kiara de pie, al lado del garaje. Se ha cambiado de ropa."
    "En rentrant à la maison, tu vois Kiara près du garage. Elle a changé de vêtements."

# game/scripts/c20/c20.rpy:2769
translate french c20s006_ReturningHome_a09a1c32:

    # mc "Hola de nuevo, Kiara. Iba a ir a buscarte a tu habitación."
    mc "Salut Kiara. J'allais te trouver dans ta chambre."

# game/scripts/c20/c20.rpy:2770
translate french c20s006_ReturningHome_0dc1d7eb:

    # kia "Eileen está durmiendo. Es muy tarde y mañana trabaja por la mañana."
    kia "Eileen dort. Il est très tard et elle doit travailler demain matin."

# game/scripts/c20/c20.rpy:2771
translate french c20s006_ReturningHome_fc68535a:

    # mc "Tú también. Quizás deberías estar durmiendo."
    mc "Toi aussi. Tu devrais peut-être dormir."

# game/scripts/c20/c20.rpy:2773
translate french c20s006_ReturningHome_7059ec6f:

    # kia "Lo he intentado, pero no puedo pegar ojo. Por eso necesito hablar."
    kia "J'ai essayé, mais je n'arrive pas à fermer l'œil. C'est pourquoi j'ai besoin de parler."

# game/scripts/c20/c20.rpy:2774
translate french c20s006_ReturningHome_9fcd01ba:

    # mc "¿Quieres que pasemos dentro y hablemos?"
    mc "Tu veux entrer et discuter ?"

# game/scripts/c20/c20.rpy:2776
translate french c20s006_ReturningHome_9305a04d:

    # kia "Mejor vayamos a sentarnos en la piscina. Así no molestaremos a nadie."
    kia "Allons nous asseoir au bord de la piscine. Comme ça, on ne dérangera personne."

# game/scripts/c20/c20.rpy:2777
translate french c20s006_ReturningHome_7f866e75:

    # mc "Y nadie nos oirá."
    mc "Et personne ne nous entendra."

# game/scripts/c20/c20.rpy:2778
translate french c20s006_ReturningHome_c4ae781b:

    # kia "Exacto."
    kia "Exact."

# game/scripts/c20/c20.rpy:2780
translate french c20s006_ReturningHome_8b317a75:

    # "Kiara anda el camino hacia las tumbonas en silencio, delante tuyo. Parece que está ordenando sus ideas, como si estuviera preparando un discurso."
    "Kiara vous précède silencieusement en direction des transats. Elle semble rassembler ses idées, comme si elle préparait un discours."

# game/scripts/c20/c20.rpy:2782
translate french c20s006_ReturningHome_5deaa470:

    # "Solo hay un problema. No hay tumbonas al llegar. Las han recogido después de la fiesta."
    "Il y a juste un petit problème : il n’y a pas de transats à votre arrivée. Ils ont été enlevés après la fête."

# game/scripts/c20/c20.rpy:2783
translate french c20s006_ReturningHome_b0967ddd:

    # "Ninguno de los dos os habéis dado cuenta mientras andabais hacia donde suelen estar."
    "Aucun de vous deux ne les a remarqués en vous dirigeant vers l'endroit où ils se trouvent habituellement."

# game/scripts/c20/c20.rpy:2785
translate french c20s006_ReturningHome_74650567:

    # kia "Vaya, han recogido las tumbonas. Tendremos que ir dentro."
    kia "Zut ! Ils ont rangé les transats. Il va falloir rentrer."

# game/scripts/c20/c20.rpy:2786
translate french c20s006_ReturningHome_bd191e3f:

    # mc "Podemos sentarnos en el borde de la piscina, como hemos hecho antes."
    mc "Nous pouvons nous asseoir au bord de la piscine, comme nous l'avons déjà fait."

# game/scripts/c20/c20.rpy:2787
translate french c20s006_ReturningHome_b8e83a6c:

    # kia "Como quieras..."
    kia "Tout ce que vous voulez..."

# game/scripts/c20/c20.rpy:2789
translate french c20s006_ReturningHome_089feeb3:

    # "Una vez descalzos y sentados, con los pies en el agua, Kiara se mantiene en silencio."
    "Une fois pieds nus et assise, les pieds dans l'eau, Kiara reste silencieuse."

# game/scripts/c20/c20.rpy:2791
translate french c20s006_ReturningHome_a5e044c3:

    # mc "Kiara, ¿de qué quieres hablar? Me estás preocupando."
    mc "Kiara, de quoi veux-tu parler ? Tu m'inquiètes."

# game/scripts/c20/c20.rpy:2792
translate french c20s006_ReturningHome_c7523d18:

    # kia "De nosotros..."
    kia "De notre part..."

# game/scripts/c20/c20.rpy:2794
translate french c20s006_ReturningHome_e370d625:

    # kia "No estoy segura de que lo que he hecho esta tarde haya sido lo mejor que podría haber hecho."
    kia "Je ne suis pas sûr que ce que j'ai fait cet après-midi ait été la meilleure chose que j'aurais pu faire."

# game/scripts/c20/c20.rpy:2795
translate french c20s006_ReturningHome_a5df840b:

    # mc "¿Qué has hecho? ¿Besarme?"
    mc "Qu'as-tu fait ? Tu m'as embrassé ?"

# game/scripts/c20/c20.rpy:2797
translate french c20s006_ReturningHome_2b5a2645:

    # kia "Sí. Delante de todas las chicas..."
    kia "Oui. Devant toutes les filles..."

# game/scripts/c20/c20.rpy:2798
translate french c20s006_ReturningHome_0469b98b:

    # mc "Y, por lo que me ha parecido, todas te han felicitado por dar el paso de dejar tu pasado atrás, ¿no?"
    mc "Et, d'après ce que j'ai vu, ils vous ont tous félicité d'avoir franchi le pas et d'avoir laissé votre passé derrière vous, n'est-ce pas ?"

# game/scripts/c20/c20.rpy:2799
translate french c20s006_ReturningHome_54747eb3:

    # mc "Precisamente el día en que han visto cómo era tu pasado..."
    mc "Précisément le jour où ils ont découvert votre passé..."

# game/scripts/c20/c20.rpy:2801
translate french c20s006_ReturningHome_4ae66f04:

    # kia "Sí... pero es mi vida, no la suya..."
    kia "Oui… mais c’est ma vie, pas la vôtre…"

# game/scripts/c20/c20.rpy:2802
translate french c20s006_ReturningHome_7c906f37:

    # mc "Y ninguna de ellas te va a forzar a dar ningún paso que no quieras dar, Kiara."
    mc "Et aucun d'eux ne te forcera à prendre des mesures que tu ne souhaites pas prendre, Kiara."

# game/scripts/c20/c20.rpy:2804
translate french c20s006_ReturningHome_738b57de:

    # kia "A eso me refiero... ahora que he recuperado un poco el control de mi vida..."
    kia "C'est ce que je veux dire... maintenant que j'ai repris un peu le contrôle de ma vie..."

# game/scripts/c20/c20.rpy:2805
translate french c20s006_ReturningHome_e0765801:

    # kia "No sé que se espera de mí..."
    kia "Je ne sais pas ce qu'on attend de moi..."

# game/scripts/c20/c20.rpy:2806
translate french c20s006_ReturningHome_9226b533:

    # mc "Nadie espera nada de ti. Lo que esperamos todos, yo incluído, es que consigas ser feliz en esta familia como no lo fuiste en tu familia anterior."
    mc "Personne n'attend rien de toi. Ce que nous espérons tous, moi y compris, c'est que tu trouves le bonheur dans cette famille, contrairement à la précédente."

# game/scripts/c20/c20.rpy:2808
translate french c20s006_ReturningHome_0023fec3:

    # kia "No me digas que nadie espera que nos acostemos juntos hoy."
    kia "Ne me dites pas que personne ne s'attend à ce que nous dormions ensemble ce soir."

# game/scripts/c20/c20.rpy:2809
translate french c20s006_ReturningHome_f04255d3:

    # mc "¿Qué? ¡No! ¡Eso no lo espero ni siquiera yo!"
    mc "Quoi ? Non ! Même moi, je ne m'y attendais pas !"

# game/scripts/c20/c20.rpy:2813
translate french c20s006_ReturningHome_49695eab:

    # kia "Me acabas de mirar las tetas..."
    kia "Tu viens de regarder mes seins..."

# game/scripts/c20/c20.rpy:2814
translate french c20s006_ReturningHome_ef78b8c0:

    # mc "No me malinterpretes. Si me lo propusieras, no diría que no ni por todo el oro del mundo. Pero no creo que sea el momento correcto."
    mc "Ne vous méprenez pas. Si vous me le demandiez, je ne dirais pas non même pour tout l'or du monde. Mais je ne pense pas que ce soit le bon moment."

# game/scripts/c20/c20.rpy:2816
translate french c20s006_ReturningHome_de0bcae3:

    # kia "Pues dile eso a mi hija... "
    kia "Eh bien, dites ça à ma fille..."

# game/scripts/c20/c20.rpy:2817
translate french c20s006_ReturningHome_da03b963:

    # mc "¿Eileen? ¿Qué te ha dicho?"
    mc "Eileen ? Que t'a-t-elle dit ?"

# game/scripts/c20/c20.rpy:2819
translate french c20s006_ReturningHome_9615fb6d:

    # kia "Me ha intentado convencer de que fuera a tu habitación esta noche. Cuando le he dicho que no, me ha preguntado que cuánto voy a esperar para tener sexo contigo."
    kia "Il a essayé de me convaincre de venir dans ta chambre ce soir. Quand j'ai dit non, il m'a demandé combien de temps j'allais attendre avant de coucher avec toi."

# game/scripts/c20/c20.rpy:2820
translate french c20s006_ReturningHome_272c4fa5:

    # mc "Kiara, ha sido un día muy largo y todo el mundo tiene mucho que procesar. Tú, Eileen, y yo."
    mc "Kiara, la journée a été très longue et nous avons tous beaucoup de choses à digérer. Toi, Eileen et moi."

# game/scripts/c20/c20.rpy:2822
translate french c20s006_ReturningHome_da9a66ac:

    # kia "Lo sé, pero no lo entiendes... Soy una mujer que... no sé... Siempre han tomado decisiones por mí. Me las han impuesto."
    kia "Je sais, mais vous ne comprenez pas… Je suis une femme qui… Je ne sais pas… On a toujours pris les décisions pour moi. On me les a imposées."

# game/scripts/c20/c20.rpy:2823
translate french c20s006_ReturningHome_f2c76260:

    # kia "Y Eileen lo sabe. Ahora es ella la que intenta hacerlo."
    kia "Et Eileen le sait. C'est maintenant à son tour d'essayer."

# game/scripts/c20/c20.rpy:2824
translate french c20s006_ReturningHome_77e80691:

    # mc "Eileen es una persona muy sexual. Demuestra su amor con sexo, entre otras cosas."
    mc "Eileen est une personne très sensuelle. Elle exprime son amour notamment par le sexe."

# game/scripts/c20/c20.rpy:2826
translate french c20s006_ReturningHome_bcba7e8d:

    # kia "Lo sé..."
    kia "Je sais..."

# game/scripts/c20/c20.rpy:2827
translate french c20s006_ReturningHome_f823a140:

    # mc "Pero si le das un momento para pensar se dará cuenta de que tú no eres igual. O al menos no pareces serlo."
    mc "Mais si vous lui laissez un moment pour réfléchir, il se rendra compte que vous n'êtes plus la même. Ou du moins, c'est l'impression que vous donnez."

# game/scripts/c20/c20.rpy:2829
translate french c20s006_ReturningHome_3621ae77:

    # kia "No, no lo soy... para mí el sexo... Siempre he oído que debería ser... no sé... especial. Y nunca lo ha sido..."
    kia "Non, je ne le suis pas… pour moi, le sexe… J’ai toujours entendu dire que ça devait être… je ne sais pas… spécial. Et ça ne l’a jamais été…"

# game/scripts/c20/c20.rpy:2831
translate french c20s006_ReturningHome_48105419:

    # kia "El beso de esta tarde me ha erizado el pelo de sitios donde no sabía que tenía pelo."
    kia "Le baiser de cet après-midi m'a fait dresser les cheveux sur la tête à des endroits où je ne savais même pas que j'en avais."

# game/scripts/c20/c20.rpy:2832
translate french c20s006_ReturningHome_5beff731:

    # kia "Pero no quiero pensar en nada más allá de ese beso... por ahora..."
    kia "Mais je ne veux penser à rien d'autre qu'à ce baiser... pour l'instant..."

# game/scripts/c20/c20.rpy:2833
translate french c20s006_ReturningHome_62396cdf:

    # mc "No hay ningún problema con eso. No lo hay conmigo ni lo hay con nadie más. Porque nadie más que tú y yo decidiremos cuándo va a pasar."
    mc "Il n'y a aucun problème avec ça. Il n'y a aucun problème avec moi, et il n'y a aucun problème avec qui que ce soit d'autre. Car il n'y a que vous et moi qui déciderons du moment où cela se produira."

# game/scripts/c20/c20.rpy:2835
translate french c20s006_ReturningHome_6bc1b511:

    # kia "Entonces... ¿no te importa ir paso a paso?"
    kia "Donc... cela ne vous dérange pas de procéder étape par étape ?"

# game/scripts/c20/c20.rpy:2836
translate french c20s006_ReturningHome_d7cc3734:

    # mc "No, no me importa. Es más, mañana te voy a invitar a cenar, si quieres."
    mc "Non, ça ne me dérange pas. D'ailleurs, je t'invite à dîner demain, si tu veux."

# game/scripts/c20/c20.rpy:2837
translate french c20s006_ReturningHome_d759bfe7:

    # mc "Quizás, si empezamos a salir como una pareja tradicional te sientas más cómoda. Pero sólamente si quieres ir a cenar conmigo. Nadie te puede forzar a ello."
    mc "Tu te sentirais peut-être plus à l'aise si on se comportait comme un couple classique. Mais seulement si tu as envie de dîner avec moi. Personne ne peut t'y obliger."

# game/scripts/c20/c20.rpy:2839
translate french c20s006_ReturningHome_62832fad:

    # kia "Sí, quiero. Pero mejor a comer. Si salimos de noche, Eileen me va a interrogar cuando volvamos."
    kia "Oui, j'en ai envie. Mais on devrait d'abord aller manger. Si on sort le soir, Eileen va me poser des questions à notre retour."

# game/scripts/c20/c20.rpy:2840
translate french c20s006_ReturningHome_8b671804:

    # mc "Perfecto. Tenemos una cita para comer."
    mc "Parfait. Nous avons rendez-vous pour déjeuner."

# game/scripts/c20/c20.rpy:2841
translate french c20s006_ReturningHome_0139acbd:

    # mc "Y recuerda que, aunque Eileen te interrogue, no tienes porqué contarle nada que no quieras contarle."
    mc "Et n'oubliez pas que, même si Eileen vous pose des questions, vous n'êtes pas obligé de lui dire quoi que ce soit que vous ne voulez pas lui dire."

# game/scripts/c20/c20.rpy:2843
translate french c20s006_ReturningHome_1e9ad038:

    # kia "Lo sé. Ni sentirme forzada a hacer lo que ella quiera que haga."
    kia "Je sais. Et je ne me sens pas obligée de faire ce qu'elle veut que je fasse."

# game/scripts/c20/c20.rpy:2844
translate french c20s006_ReturningHome_1ce75b02:

    # mc "Exacto."
    mc "Exact."

# game/scripts/c20/c20.rpy:2846
translate french c20s006_ReturningHome_54968c6f:

    # kia "Aunque {b}tú{/b} la mandes a que me de la charla y me convenza de cosas, como has hecho esta tarde."
    kia "Même si vous l'envoyez me faire la leçon et me convaincre de choses, comme vous l'avez fait cet après-midi."

# game/scripts/c20/c20.rpy:2847
translate french c20s006_ReturningHome_c582738d:

    # mc "No, Kiara. No la he mandado a que te convenciera de nada. Estabas preocupada por cómo se sentiría si tú y yo empezábamos algo."
    mc "Non, Kiara. Je ne l'ai pas envoyée pour te convaincre de quoi que ce soit. Tu t'inquiétais de sa réaction si on commençait quelque chose ensemble."

# game/scripts/c20/c20.rpy:2848
translate french c20s006_ReturningHome_3979befc:

    # mc "Sólo le he dicho que te dijera cómo se sentiría. No tenía que ir más allá."
    mc "Je lui ai simplement dit de vous faire part de ses sentiments. Il n'avait pas besoin d'en dire plus."

# game/scripts/c20/c20.rpy:2850
translate french c20s006_ReturningHome_8fe26f31:

    # kia "*Risa* ¿No conoces a mi hija? ¿Creías que iba a parar después de decírmelo?"
    kia "*Rires* Vous ne connaissez pas ma fille ? Vous pensiez que j’allais m’arrêter là après me l’avoir dit ?"

# game/scripts/c20/c20.rpy:2851
translate french c20s006_ReturningHome_ba48a9df:

    # mc "En un principio, sí, era lo que esperaba."
    mc "Au départ, oui, c'est ce à quoi je m'attendais."

# game/scripts/c20/c20.rpy:2852
translate french c20s006_ReturningHome_feac233e:

    # mc "Cuando he visto cómo ha reaccionado cuando... durante el incidente... Creo que estaba muy ansiosa de librarse de su padre."
    mc "Quand j'ai vu sa réaction pendant l'incident... je pense qu'elle était très pressée de se débarrasser de son père."

# game/scripts/c20/c20.rpy:2854
translate french c20s006_ReturningHome_01979e1c:

    # kia "Es gracioso que digas \"su padre\" en vez de \"Solomon\" o \"tu marido\"."
    kia "C'est amusant que vous disiez « son père » au lieu de « Salomon » ou « votre mari »."

# game/scripts/c20/c20.rpy:2855
translate french c20s006_ReturningHome_b63ee2e1:

    # kia "Es como si no quisieras recordarme que estoy casada con el padre de Eileen."
    kia "C'est comme si vous ne vouliez pas me rappeler que je suis mariée au père d'Eileen."

# game/scripts/c20/c20.rpy:2856
translate french c20s006_ReturningHome_aad7fbb8:

    # mc "Es que no quiero recordártelo. Estais casados sobre el papel, pero has dicho que no volverás con él nunca."
    mc "Je ne veux pas te le rappeler. Vous êtes mariés légalement, mais tu as dit que tu ne te remettrais jamais avec lui."

# game/scripts/c20/c20.rpy:2857
translate french c20s006_ReturningHome_190f1f31:

    # mc "En este caso, vuestro matrimonio es únicamente una formalidad hasta que te divorcies."
    mc "Dans ce cas, votre mariage n'est qu'une formalité jusqu'à votre divorce."

# game/scripts/c20/c20.rpy:2859
translate french c20s006_ReturningHome_20889386:

    # kia "Sabes que somos católicos, ¿verdad? Solomon nunca me concederá el divorcio."
    kia "Tu sais que nous sommes catholiques, n'est-ce pas ? Salomon ne m'accordera jamais le divorce."

# game/scripts/c20/c20.rpy:2860
translate french c20s006_ReturningHome_38c27be6:

    # mc "Pues tendremos que buscar alguna forma de adecuar nuestra relación a tus creencias religiosas."
    mc "Eh bien, nous devrons trouver un moyen d'adapter notre relation à vos croyances religieuses."

# game/scripts/c20/c20.rpy:2861
translate french c20s006_ReturningHome_b20eb053:

    # mc "No tengo ni idea de como puede afectarte esto."
    mc "Je n'ai aucune idée de l'impact que cela pourrait avoir sur vous."

# game/scripts/c20/c20.rpy:2863
translate french c20s006_ReturningHome_bae4722e:

    # kia "Entonces todo arreglado. Mañana comemos juntos y ya veremos... A ver como evoluciona esto... ¿Nos vamos a dormir?"
    kia "Voilà, c'est réglé. On déjeune ensemble demain et on verra comment ça se passe… On verra bien… Et si on allait se coucher ?"

# game/scripts/c20/c20.rpy:2864
translate french c20s006_ReturningHome_dbeedd01:

    # mc "Sólo tengo una pregunta antes de irnos."
    mc "J'ai juste une question avant de partir."

# game/scripts/c20/c20.rpy:2865
translate french c20s006_ReturningHome_7e031e08:

    # mc "El salto de cama que llevabas antes... ¿Ibas a ir a mi habitación? ¿Te había convencido Eileen?"
    mc "La chemise de nuit que tu portais tout à l'heure… Tu allais dans ma chambre ? Eileen t'avait convaincue ?"

# game/scripts/c20/c20.rpy:2867
translate french c20s006_ReturningHome_31cf8c7e:

    # kia "Casi. Me había vestido así por si reunía el valor para hacerlo."
    kia "Presque. Je m'étais habillée comme ça au cas où j'aurais le courage de le faire."

# game/scripts/c20/c20.rpy:2868
translate french c20s006_ReturningHome_e643b0b5:

    # kia "Cuando te he oído subir las escaleras, he pensado que sería un buen momento para hablarlo en vez de plantarme en tu habitación como una buscona."
    kia "Quand je t'ai entendu monter les escaliers, j'ai pensé que ce serait le bon moment pour en parler plutôt que de débarquer dans ta chambre comme une salope."

# game/scripts/c20/c20.rpy:2870
translate french c20s006_ReturningHome_76a469d6:

    # kia "Por lo que estaba diciendo Eile, tenías que estar ansioso por que lo hiciera."
    kia "D'après ce que disait Eile, il fallait vraiment avoir envie qu'il le fasse."

# game/scripts/c20/c20.rpy:2871
translate french c20s006_ReturningHome_c3f188e0:

    # kia "Por suerte, tenías que llevar a Maddie a casa y eso me ha salvado de hacer algo de lo que después seguramente me hubiera arrepentido."
    kia "Heureusement, tu as dû ramener Maddie à la maison, et cela m'a évité de faire quelque chose que j'aurais probablement regretté plus tard."

# game/scripts/c20/c20.rpy:2873
translate french c20s006_ReturningHome_2fb66a60:

    # kia "*Risa* No se lo tengas en cuenta a la chica."
    kia "*Rires* Ne lui en tenez pas rigueur."

# game/scripts/c20/c20.rpy:2874
translate french c20s006_ReturningHome_6a7e8bf5:

    # mc "Creo que es al revés. Creo que le tenemos que agradecer a Maddie que nos podamos tomar nuestro tiempo y hacer las cosas a nuestro ritmo."
    mc "Je pense que c'est plutôt l'inverse. Je pense que nous devrions remercier Maddie de nous avoir permis de prendre notre temps et de faire les choses à notre rythme."

# game/scripts/c20/c20.rpy:2876
translate french c20s006_ReturningHome_07cf9117:

    # kia "Visto así... tienes razón."
    kia "Vu sous cet angle... vous avez raison."

# game/scripts/c20/c20.rpy:2878
translate french c20s006_ReturningHome_1f0aa400:

    # "Kiara se calza y se levanta para irse. Haces lo mismo."
    "Kiara enfile ses chaussures et se lève pour partir. Vous faites de même."

# game/scripts/c20/c20.rpy:2879
translate french c20s006_ReturningHome_fecf056e:

    # kia "¿Me acompañas a casa de [nor]?"
    kia "Veux-tu venir avec moi chez [nor] ?"

# game/scripts/c20/c20.rpy:2880
translate french c20s006_ReturningHome_48d5f2ce:

    # mc "Sólo si me prometes que esta vez habrá beso de despedida y que dejarás de llamarla casa de [nor]. También es tu casa ahora."
    mc "Seulement si tu me promets que cette fois il y aura un baiser d'adieu et que tu arrêteras d'appeler ça la maison de [nor]. C'est aussi ta maison maintenant."

# game/scripts/c20/c20.rpy:2882
translate french c20s006_ReturningHome_272ebc82:

    # kia "*Risa* Me parece bien. ¿Me acompañas a casa?"
    kia "*Rires* Ça me va. Tu veux bien me raccompagner ?"

# game/scripts/c20/c20.rpy:2884
translate french c20s006_ReturningHome_997a1865:

    # mc "No has dicho nada del beso..."
    mc "Tu n'as rien dit à propos du baiser..."

# game/scripts/c20/c20.rpy:2887
translate french c20s006_ReturningHome_012de196:

    # "Kiara se lanza a por tus labios, con la misma dulzura y avidez que ha hecho por la tarde, sorprendiéndote con ambas."
    "Kiara se jette sur vos lèvres, avec la même douceur et la même ardeur que l'après-midi même, vous surprenant par les deux."

# game/scripts/c20/c20.rpy:2889
translate french c20s006_ReturningHome_6bf383c5:

    # kia "¿Te parece suficiente promesa?"
    kia "Cela vous semble-t-il une promesse suffisante ?"

# game/scripts/c20/c20.rpy:2890
translate french c20s006_ReturningHome_b32ecd82:

    # mc "Me parece perfecta."
    mc "Je trouve ça parfait."

# game/scripts/c20/c20.rpy:2892
translate french c20s006_ReturningHome_cf33bef7:

    # "El camino de la piscina hasta la casa de [nor], la casa de Kiara, no os debería llevar más de dos o tres minutos. Os lleva más de quince."
    "Le trajet à pied de la piscine à la maison de Kiara (celle de [nor]) ne devrait pas prendre plus de deux ou trois minutes. Il en faut plus de quinze."

# game/scripts/c20/c20.rpy:2894
translate french c20s006_ReturningHome_79a713f1:

    # "Os paráis cada pocos metros para volver a besaros."
    "Vous vous arrêtez tous les quelques mètres pour vous embrasser à nouveau."

# game/scripts/c20/c20.rpy:2896
translate french c20s006_ReturningHome_f6f158a0:

    # "Y esos pocos metros los recorréis, a paso lento, cogidos de la mano, intentando alargar la experiencia lo máximo posible."
    "Et vous parcourez ces quelques mètres lentement, main dans la main, en essayant de prolonger l'expérience autant que possible."

# game/scripts/c20/c20.rpy:2898
translate french c20s006_ReturningHome_5fdefe13:

    # "Pero al final llegáis a la puerta principal. Un último beso antes de separaros."
    "Mais enfin, vous arrivez à la porte d'entrée. Un dernier baiser avant de vous séparer."

# game/scripts/c20/c20.rpy:2900
translate french c20s006_ReturningHome_0dba28f7:

    # kia "Pues hasta aquí ha llegado nuestro paseo..."
    kia "Eh bien, notre promenade s'achève ici..."

# game/scripts/c20/c20.rpy:2901
translate french c20s006_ReturningHome_ab22a5bd:

    # mc "Si por mí fuera, lo podríamos repetir todas las noches."
    mc "Si cela ne tenait qu'à moi, on pourrait le répéter tous les soirs."

# game/scripts/c20/c20.rpy:2903
translate french c20s006_ReturningHome_63be4610:

    # kia "No creo que me sentara bien una ducha fría todas las noches a la 1:00 AM... o la hora que sea ya."
    kia "Je ne crois pas que je serais contente de prendre une douche froide tous les soirs à 1h du matin… ou à l’heure qu’il est maintenant."

# game/scripts/c20/c20.rpy:2904
translate french c20s006_ReturningHome_5a9f0d9e:

    # mc "¿Vas a darte una ducha ahora?"
    mc "Tu vas prendre une douche maintenant ?"

# game/scripts/c20/c20.rpy:2906
translate french c20s006_ReturningHome_245e31b5:

    # kia "No preguntes lo que no quieras saber. Y no te ofrezcas a enjabonarme la espalda. *Risa*"
    kia "Ne posez pas de questions que vous ne voulez pas savoir. Et ne proposez pas de me laver le dos. *Rires*"

# game/scripts/c20/c20.rpy:2907
translate french c20s006_ReturningHome_dde5cc42:

    # mc "*Risa* No lo voy a hacer. Seguramente no me conformaría con la espalda."
    mc "*Rires* Je ne le ferai pas. Je ne me contenterais certainement pas de mon dos."

# game/scripts/c20/c20.rpy:2909
translate french c20s006_ReturningHome_0268ab97:

    # kia "Entonces, hasta mañana a la hora de comer, ¿no?"
    kia "Alors, à demain midi, d'accord ?"

# game/scripts/c20/c20.rpy:2910
translate french c20s006_ReturningHome_f7213923:

    # mc "Sí, no creo que esté levantado cuando vayas a trabajar. ¿Quieres que te pase a buscar sobre la 1:00 PM?"
    mc "Oui, je ne pense pas être levé(e) quand tu partiras travailler. Veux-tu que je vienne te chercher vers 13h ?"

# game/scripts/c20/c20.rpy:2911
translate french c20s006_ReturningHome_375bdc59:

    # kia "Es una buena hora. Normalmente salgo entre la 1:00 y la 1:30 a comer. Tengo una hora de tiempo."
    kia "Ça tombe bien. D'habitude, je pars déjeuner entre 13h et 13h30. J'ai une heure de libre."

# game/scripts/c20/c20.rpy:2912
translate french c20s006_ReturningHome_4b85b8a1:

    # mc "Buscaré algún sitio cerca de la biblioteca para ir a comer. Y no, no vamos a ir al puesto de los perritos calientes en nuestra primera cita."
    mc "Je chercherai un endroit où manger près de la bibliothèque. Et non, on n'ira pas au stand de hot-dogs pour notre premier rendez-vous."

# game/scripts/c20/c20.rpy:2914
translate french c20s006_ReturningHome_949e2cf6:

    # kia "*Risita* Me parece bien, aunque casi consideraría este paseo como nuestra primera cita."
    kia "*Rires* Ça me paraît bien, même si je considérerais presque cette promenade comme notre premier rendez-vous."

# game/scripts/c20/c20.rpy:2915
translate french c20s006_ReturningHome_270bcedd:

    # mc "Lo será si acaba en beso."
    mc "Ce sera le cas si cela se termine par un baiser."

# game/scripts/c20/c20.rpy:2917
translate french c20s006_ReturningHome_08df730a:

    # "Acaba en beso. Un beso que dice que mañana habrá más. Un beso que sabe a despedida, aunque solo sea por doce horas."
    "Cela se termine par un baiser. Un baiser qui promet d'autres baisers demain. Un baiser qui a le goût des adieux, même si ce n'est que pour douze heures."

# game/scripts/c20/c20.rpy:2918
translate french c20s006_ReturningHome_be90d0b8:

    # "Un beso en el que no hay dudas, que empieza a un ritmo suave y que acelera poco a poco. Como esperas que pase con vuestra relación."
    "Un baiser sans équivoque, qui commence doucement et s'intensifie progressivement. Exactement comme vous l'espérez pour votre relation."

# game/scripts/c20/c20.rpy:2920
translate french c20s006_ReturningHome_d2b8a5a5:

    # kia "Hasta mañana, [mc]. Esperaré ansiosa que vengas a buscarme."
    kia "À demain, [mc]. J'attendrai avec impatience que tu viennes me chercher."

# game/scripts/c20/c20.rpy:2921
translate french c20s006_ReturningHome_de54c180:

    # mc "Hasta mañana, Kiara. Yo estaré ansioso por ir."
    mc "À demain, Kiara. J'ai hâte d'y aller."

# game/scripts/c20/c20.rpy:2922
translate french c20s006_ReturningHome_39c53149:

    # mc "*Risa* Y tampoco vamos a ir al puesto de los perritos calientes en nuestra segunda cita, ahora que ésta cuenta como la primera."
    mc "*Rires* Et on n'ira pas non plus au stand de hot-dogs pour notre deuxième rendez-vous, maintenant que celui-ci compte comme le premier."

# game/scripts/c20/c20.rpy:2928
translate french c20s007_Teaser_ffbf891b:

    # "Al volver a tu habitación..."
    "Lorsque vous retournerez dans votre chambre..."

# game/scripts/c20/c20.rpy:2930
translate french c20s007_Teaser_d72364f0:

    # emm "¡Has tardado muchísimo en volver!"
    emm "Tu as mis une éternité à revenir !"

# game/scripts/c20/c20.rpy:2931
translate french c20s007_Teaser_433f4a0f:

    # dap "Estábamos a punto de irnos. Menos mal que has llegado ahora."
    dap "Nous étions sur le point de partir. Heureusement que vous êtes arrivés maintenant."

# game/scripts/c20/c20.rpy:2933
translate french c20s007_Teaser_5dab658f:

    # eri "Creíamos que te ibas a quedar a dormir en casa de Maddie."
    eri "Nous pensions que tu allais passer la nuit chez Maddie."

# game/scripts/c20/c20.rpy:2935
translate french c20s007_Teaser_37fa3aff:

    # eri "O de llamarte para saber si te había pasado algo."
    eri "Ou pour vous appeler afin de savoir si quelque chose vous est arrivé."

