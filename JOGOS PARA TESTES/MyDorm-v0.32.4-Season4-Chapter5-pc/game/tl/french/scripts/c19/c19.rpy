    mad "[mc] et moi aussi... avons quelque chose."

# game/scripts/c19/c19.rpy:1801
translate french c19s004_PhoneMessage_247e500a:

    # mc "No hacía falta que lo hicieras, Tía Betty. No estoy con nadie ahora mismo."
    mc "Tu n'étais pas obligée de faire ça, tante Betty. Je ne suis avec personne en ce moment."

# game/scripts/c19/c19.rpy:1803
translate french c19s004_PhoneMessage_d8c0f9c5:

    # mee "Aparte de Betty mintiendo para proteger secretos ajenos..."
    mee "Sans compter que Betty ment pour protéger les secrets des autres..."

# game/scripts/c19/c19.rpy:1811
translate french c19s004_Meemaw_0c5ef227:

    # mee "¿Alguna sorpresa más?"
    mee "D'autres surprises ?"

# game/scripts/c19/c19.rpy:1813
translate french c19s004_Meemaw_dd8fb446:

    # mcp "(Está extrañamente tranquila. ¿La calma que precede a la tormenta?)"
    mcp "(Elle est étrangement calme. Est-ce le calme avant la tempête ?)"

# game/scripts/c19/c19.rpy:1815
translate french c19s004_Meemaw_e8dc96a9:

    # mcp "(¿Va a confesar el millón de orgasmos de esta mañana? O mejor aún... ¿va a confesar que me ha dado la razón dos veces?)"
    mcp "(Va-t-elle avouer avoir eu un million d'orgasmes ce matin ? Ou mieux encore… va-t-elle avouer qu'elle était d'accord avec moi deux fois ?)"

# game/scripts/c19/c19.rpy:1816
translate french c19s004_Meemaw_089d82b2:

    # todas "No..."
    todas "Non..."

# game/scripts/c19/c19.rpy:1817
translate french c19s004_Meemaw_dff7e644:

    # mee "A mí ya no me sorprende nada de esta familia... Pero ahora dejadme hablar, por favor. SIN INTERRUPCIONES."
    mee "Plus rien ne me surprend de la part de cette famille… Mais laissez-moi parler, s’il vous plaît. SANS M’INTERROMPRE."

# game/scripts/c19/c19.rpy:1819
translate french c19s004_Meemaw_f6b8678d:

    # mee "Yo también tengo algo que deciros."
    mee "J'ai aussi quelque chose à vous dire."

# game/scripts/c19/c19.rpy:1821
translate french c19s004_Meemaw_0c4f8a85:

    # mee "Sé que algunas os vais a enfadar porque no os lo he dicho antes, pero no podía."
    mee "Je sais que certains d'entre vous vont être en colère parce que je ne vous l'ai pas dit avant, mais je ne pouvais pas."

# game/scripts/c19/c19.rpy:1823
translate french c19s004_Meemaw_27023618:

    # mee "He tenido cáncer. Ya estoy limpia. Una semana antes de venir aquí acabé la quimio. Si salen los secretos a la luz, no soy quién para mantener ocultos los míos."
    mee "J'ai eu un cancer. Je suis guérie maintenant. J'ai terminé ma chimiothérapie une semaine avant de venir ici. Si les secrets sont désormais publics, je ne vais pas cacher le mien."

# game/scripts/c19/c19.rpy:1824
translate french c19s004_Meemaw_44ce7ded:

    # mcp "(Alguno sí que te estás guardando... aunque no esperaba que te sincerases con todo el mundo hoy.)"
    mcp "(Tu me caches certaines choses… même si je ne m’attendais pas à ce que tu sois aussi honnête avec tout le monde aujourd’hui.)"

# game/scripts/c19/c19.rpy:1826
translate french c19s004_Meemaw_12622da5:

    # mee "Como efecto secundario... tengo galactorrea. Para quién no sepa qué es, mi pecho produce leche aunque no esté embarazada."
    mee "En guise d'effet secondaire… je souffre de galactorrhée. Pour celles et ceux qui ne le savent pas, cela signifie que mes seins produisent du lait même lorsque je ne suis pas enceinte."

# game/scripts/c19/c19.rpy:1828
translate french c19s004_Meemaw_3a26477c:

    # mcp "(Un secreto menos... queda lo de los masajes y el millón de orgasmos.)"
    mcp "(Un secret de moins… il ne reste plus que les massages et les millions d’orgasmes.)"

# game/scripts/c19/c19.rpy:1830
translate french c19s004_Meemaw_df25df33:

    # mcp "(Tiene que ser muy difícil confesar que ha estado guardando secretos todo este tiempo. No está diciendo durante cuánto tiempo los ha guardado, pero se lo preguntarán en breve.)"
    mcp "(Il doit être très difficile pour lui d'avouer qu'il a gardé des secrets tout ce temps. Il ne dit pas depuis combien de temps il les garde, mais on lui posera bientôt la question.)"

# game/scripts/c19/c19.rpy:1833
translate french c19s004_Meemaw_87f17c95:

    # emm "Estoy enfadada porque no nos lo has contado antes, pero la alegría porque estás limpia es mayor que el enfado."
    emm "Je suis en colère parce que tu ne nous l'as pas dit plus tôt, mais la joie de savoir que tu es sobre est plus forte que la colère."

# game/scripts/c19/c19.rpy:1834
translate french c19s004_Meemaw_7495ba6b:

    # emm "Se ha convertido en el mejor regalo que hemos podido recibir cualquiera de nosotras hoy. Y no me refiero sólo a las que celebramos el cumpleaños."
    emm "C'est devenu le plus beau cadeau que nous pouvions recevoir aujourd'hui. Et je ne parle pas seulement de ceux qui fêtent leur anniversaire."

# game/scripts/c19/c19.rpy:1835
translate french c19s004_Meemaw_6c2b2dcb:

    # mcp "([emm], por extraño que parezca, resume el sentimiento general en la piscina.)"
    mcp "([emm], aussi étrange que cela puisse paraître, résume bien le sentiment général dans la piscine.)"

# game/scripts/c19/c19.rpy:1838
translate french c19s004_Meemaw_484af2e3:

    # emm "Creía que nos ibas a decir que tú también salías con [mc]. *Risa*"
    emm "Je croyais que tu allais nous dire que tu sortais aussi avec [mc]. *Rires*"

# game/scripts/c19/c19.rpy:1840
translate french c19s004_Meemaw_aab7d40f:

    # emm "Ven aquí, dale un abrazo a tu nieta favorita. Pero no nos vuelvas a ocultar algo así."
    emm "Viens ici, fais un gros câlin à ta petite-fille préférée. Mais ne nous cache plus jamais une chose pareille."

# game/scripts/c19/c19.rpy:1842
translate french c19s004_Meemaw_12eec84f:

    # mee "Ven tú. Yo estoy vieja y no me voy a meter en la piscina tan pronto después de comer. *Risa* Y ¿de dónde has sacado que seas la favorita?"
    mee "Viens ici. Je suis vieux et je ne vais pas me baigner si tôt après avoir mangé. *Rires* Et d'où te vient l'idée que tu es le préféré ?"

# game/scripts/c19/c19.rpy:1844
translate french c19s004_Meemaw_3757001f:

    # emm "¿A quién puedes querer más que a mí?"
    emm "Qui pourrais-tu aimer plus que moi ?"

# game/scripts/c19/c19.rpy:1846
translate french c19s004_Meemaw_3831357d:

    # "Todas las chicas se unen al abrazo que ha iniciado [emm]."
    "Toutes les filles se joignent à l'étreinte initiée par [emm]."

# game/scripts/c19/c19.rpy:1847
translate french c19s004_Meemaw_106fed42:

    # "Algunas con los ojos húmedos."
    "Certains avaient les yeux humides."

# game/scripts/c19/c19.rpy:1848
translate french c19s004_Meemaw_1477280c:

    # "Otras con enormes sonrisas."
    "D'autres avec de larges sourires."

# game/scripts/c19/c19.rpy:1849
translate french c19s004_Meemaw_6ecd4733:

    # "Maddie da su apoyo mientras mantiene las distancias."
    "Maddie affiche son soutien tout en gardant ses distances."

# game/scripts/c19/c19.rpy:1850
translate french c19s004_Meemaw_dc2feb00:

    # "Tú eres el último en unirte. 22 personas sustituyéndose unas a otras para abrazar a Olivia es todo un reto logístico de brazos, tetas y cuerpos."
    "Tu es le dernier à nous rejoindre. Faire enlacer Olivia à 22 reprises représente un véritable défi logistique impliquant bras, poitrines et corps."

# game/scripts/c19/c19.rpy:1852
translate french c19s004_Meemaw_fbca37b8:

    # mc "¿No te unes, Jamaal?"
    mc "Tu ne te joins pas à nous, Jamaal ?"

# game/scripts/c19/c19.rpy:1853
translate french c19s004_Meemaw_38a0718d:

    # jam "El único hueco que queda para llegar a Olivia y unirme comportaría pasar mi cara peligrosamente cerca de tu culo. No, no es una propuesta. *Risa*"
    jam "Le seul moyen pour moi de rejoindre Olivia serait de me rapprocher dangereusement de tes fesses. Non, ce n'est pas une demande en mariage. *Rires*"

# game/scripts/c19/c19.rpy:1855
translate french c19s004_Meemaw_6e5d381c:

    # jam "No quiero entrar en tu harén."
    jam "Je ne veux pas entrer dans votre harem."

# game/scripts/c19/c19.rpy:1856
translate french c19s004_Meemaw_63015e91:

    # jam "Pero tampoco quiero oler tus pedos. *Risa* Cuando dejéis a Olivia tranquila, ya vendrá a darle un abrazo a su nieto favorito."
    jam "Mais je ne veux pas sentir tes pets non plus. *Rires* Quand tu laisseras Olivia seule, elle viendra faire un câlin à son petit-fils préféré."

# game/scripts/c19/c19.rpy:1858
translate french c19s004_Meemaw_0b071cda:

    # mee "Iré en cuanto me dejen respirar un poco, Jamaal."
    mee "J'irai dès qu'ils me laisseront souffler un peu, Jamaal."

# game/scripts/c19/c19.rpy:1860
translate french c19s004_Meemaw_9d276f22:

    # emm "¿A él no le preguntas de dónde ha sacado que sea tu nieto favorito?"
    emm "Ne lui demandez-vous pas d'où lui vient l'idée qu'il est votre petit-fils préféré ?"

# game/scripts/c19/c19.rpy:1862
translate french c19s004_Meemaw_0f0c8df3:

    # mee "No hace falta. Él ya lo sabe. *Risa*"
    mee "Inutile. Il le sait déjà. *Rires*"

# game/scripts/c19/c19.rpy:1864
translate french c19s004_Meemaw_afd96770:

    # jam "Por supuesto que lo sé. Y tú eres mi abuela favorita. Y más ahora que puedes darme leche para mis pastitas. *Risa* ¿En este cumpleaños no hay merienda?"
    jam "Bien sûr que je sais. Et tu es ma grand-mère préférée. Surtout maintenant que tu peux me donner du lait pour mes biscuits. *Rires* Il n'y a pas un goûter pour cet anniversaire ?"

# game/scripts/c19/c19.rpy:1866
translate french c19s004_Meemaw_3b664e93:

    # mc "¡Jam! Soy prácticamente tu padrastro. No sigas por ahí o te tendré que castigar sin pastitas. *Risa*"
    mc "Jam ! Je suis presque ton beau-père. Arrête ça, sinon je te punirai en te privant de tes biscuits. *Rires*"

# game/scripts/c19/c19.rpy:1868
translate french c19s004_Meemaw_ff45bac5:

    # mc "¡Jam! Soy prácticamente tu cuñado. No sigas por ahí o tendré que hablar con mi suegra para que te castigue sin pastitas. *Risa*"
    mc "Confiture ! Je suis presque ton beau-frère. N'en fais pas trop, sinon je vais devoir parler à ma belle-mère et te priver de pâtisseries. *Rires*"

# game/scripts/c19/c19.rpy:1870
translate french c19s004_Meemaw_572f763e:

    # mc "¡Jam! No sigas por ahí o tendré que hablar con [sam] para que te castigue sin pastitas. *Risa*"
    mc "Jam ! N'emprunte pas cette voie, sinon je devrai parler à [sam] pour qu'il te punisse en te privant de tes cookies. *Rires*"

# game/scripts/c19/c19.rpy:1872
translate french c19s004_Meemaw_0165e1b3:

    # jam "¡Hey! No es culpa mía. Es de [eri]."
    jam "Hé ! Ce n'est pas ma faute. C'est celle de [eri]."

# game/scripts/c19/c19.rpy:1873
translate french c19s004_Meemaw_e8ea4b9a:

    # jam "Después de todo el día viendo tetas, mi cerebro gay está confuso."
    jam "Après avoir passé la journée à regarder des seins, mon cerveau gay est tout embrouillé."

# game/scripts/c19/c19.rpy:1875
translate french c19s004_Meemaw_19fbd737:

    # jam "No me extraña que no puedas elegir sólo a una. *Risa*"
    jam "Ça ne m'étonne pas que tu n'arrives pas à n'en choisir qu'un. *Rires*"

# game/scripts/c19/c19.rpy:1877
translate french c19s004_Meemaw_13fe6982:

    # jam "Casi podría envidiarte. *Risa*"
    jam "Je pourrais presque t'envier. *Rires*"

# game/scripts/c19/c19.rpy:1879
translate french c19s004_Meemaw_b9928aba:

    # jam "Y tú sin poder probar ninguna. *Risa*"
    jam "Et vous ne pouvez même pas en essayer un seul. *Rires*"

# game/scripts/c19/c19.rpy:1881
translate french c19s004_Meemaw_84256a1b:

    # mee "No te preocupes, Jamaal, no me ofendo por tu broma de la leche. Cuando me la extraiga te la dejaré en el estante de arriba de la nevera."
    mee "Ne t'inquiète pas, Jamaal, ta blague sur le lait ne m'offense pas. Quand je tirerai mon lait, je te le laisserai sur l'étagère du haut du frigo."

# game/scripts/c19/c19.rpy:1882
translate french c19s004_Meemaw_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c19/c19.rpy:1883
translate french c19s004_Meemaw_4ce035c0:

    # mee "Tan solo espero que para mi cumpleaños no vengas con esa cosa verde que llevas puesta."
    mee "J'espère juste que tu ne viendras pas à mon anniversaire avec ce truc vert que tu portes."

# game/scripts/c19/c19.rpy:1884
translate french c19s004_Meemaw_cf62f9fc:

    # mc "Meemaw, pero tu cumpleaños es en octubre... ¿Volverás de Florida para el cumpleaños?"
    mc "Meemaw, mais ton anniversaire est en octobre… Tu reviendras de Floride pour ton anniversaire ?"

# game/scripts/c19/c19.rpy:1886
translate french c19s004_Meemaw_e33ed5d8:

    # mee "Es otra cosa que quería deciros... Todavía estoy atando cabos y por eso no había dicho nada..."
    mee "Il y a autre chose que je voulais te dire… Je suis encore en train de comprendre, c’est pourquoi je n’ai rien dit…"

# game/scripts/c19/c19.rpy:1887
translate french c19s004_Meemaw_4a9332d3:

    # mee "Voy a vender la casa de Florida y me voy a mudar a Newport. Entre lo que saque por ella, mi pensión, y el sueldo de Betty, podremos comprar algo confortable."
    mee "Je vais vendre la maison en Floride et déménager à Newport. Avec l'argent de la vente, ma pension et le salaire de Betty, nous pourrons acheter une maison confortable."

# game/scripts/c19/c19.rpy:1888
translate french c19s004_Meemaw_8609ee31:

    # mee "Betty, aún no te había comentado nada... espero que no te importe mudarte aquí."
    mee "Betty, je ne t'ai encore rien dit... J'espère que ça ne te dérange pas de déménager ici."

# game/scripts/c19/c19.rpy:1890
translate french c19s004_Meemaw_0e126795:

    # bet "Ningún problema..."
    bet "Aucun problème..."

# game/scripts/c19/c19.rpy:1891
translate french c19s004_Meemaw_ec093842:

    # mcp "(¡Qué poca efusividad! Parece que le ha molestado...)"
    mcp "(Quel manque d'enthousiasme ! On dirait que ça le dérange...)"

# game/scripts/c19/c19.rpy:1893
translate french c19s004_Meemaw_979d6856:

    # mee "No voy a poder estar lejos de todas estas chicas maravillosas... ni de Jamaal."
    mee "Je ne pourrai pas rester loin de toutes ces filles merveilleuses... ni de Jamaal."

# game/scripts/c19/c19.rpy:1894
translate french c19s004_Meemaw_ccd9a399:

    # mc "*Risa* Eso me deja fuera a mí. Si lo sé no te defiendo. *Risa*"
    mc "*Rires* Ça ne me concerne pas. Si j'avais su, je ne t'aurais pas défendu. *Rires*"

# game/scripts/c19/c19.rpy:1896
translate french c19s004_Meemaw_95728f56:

    # mee "Tu estarás en Aruba en mi cumpleaños, cariño."
    mee "Tu seras à Aruba pour mon anniversaire, chérie."

# game/scripts/c19/c19.rpy:1897
translate french c19s004_Meemaw_9775aa25:

    # mee "Solo espero que te puedas escapar y venir."
    mee "J'espère seulement que tu pourras t'échapper et venir."

# game/scripts/c19/c19.rpy:1899
translate french c19s004_Meemaw_910ebede:

    # "Se vuelve a repetir la escena de los abrazos a Meemaw, pero alguien se queda apartado."
    "La scène où l'on serre Meemaw dans ses bras se répète, mais quelqu'un est laissé de côté."

# game/scripts/c19/c19.rpy:1901
translate french c19s004_Meemaw_60e5cd02:

    # "Parece que nadie recuerda la revelación previa. La noticia del cáncer de Meemaw y de su mudanza ha dejado tu relación como una anécdota."
    "Il semble que personne ne se souvienne de la révélation précédente. L'annonce du cancer de Mémé et de son déménagement ont relégué votre relation au rang de simple anecdote."

# game/scripts/c19/c19.rpy:1903
translate french c19s004_Meemaw_5b7865ea:

    # "Parece que nadie recuerda las revelaciones previas. La noticia del cáncer de Meemaw y de su mudanza ha dejado a tus relaciones como una anécdota."
    "Il semble que personne ne se souvienne des révélations précédentes. L'annonce du cancer de Mémé et de son déménagement ont relégué vos relations au rang de simples anecdotes."

# game/scripts/c19/c19.rpy:1905
translate french c19s004_Meemaw_c717a9cb:

    # "Incluso que pueda haber nuevas incorporaciones a la familia parece que no va a recibir mucha atención."
    "Même l'éventualité d'un agrandissement de la famille ne semble pas susceptible de retenir beaucoup d'attention."

# game/scripts/c19/c19.rpy:1907
translate french c19s004_Meemaw_e0d42f6e:

    # "Es mejor así."
    "C'est mieux ainsi."

# game/scripts/c19/c19.rpy:1909
translate french c19s004_Meemaw_14b79fb5:

    # "Todo el mundo está contento de que Meemaw y Betty no vuelvan a Florida."
    "Tout le monde est content que Meemaw et Betty ne reviennent pas en Floride."

# game/scripts/c19/c19.rpy:1911
translate french c19s004_Meemaw_fb7020b1:

    # "Bueno... parece que todo el mundo no..."
    "Eh bien... il semblerait que ce ne soit pas le cas pour tout le monde..."

# game/scripts/c19/c19.rpy:1912
translate french c19s004_Meemaw_43d1e735:

    # "Decides acercarte a Betty. Quería hablar contigo. ¿Será de esto? Pero Meemaw no se lo había comentado aún..."
    "Vous décidez d'aller voir Betty. Elle voulait vous parler. Serait-ce à propos de ça ? Mais Meemaw ne lui en avait pas encore parlé…"

# game/scripts/c19/c19.rpy:1934
translate french c19s004_Betty_b47e88b5:

    # mc "Gracias por lo de antes, Tía Betty."
    mc "Merci pour tout à l'heure, tante Betty."

# game/scripts/c19/c19.rpy:1935
translate french c19s004_Betty_ac0dfc98:

    # bet "No sé a lo que te refieres... yo no he hecho nada."
    bet "Je ne comprends pas ce que vous voulez dire… Je n'ai rien fait."

# game/scripts/c19/c19.rpy:1936
translate french c19s004_Betty_b3d82627:

    # mc "Bueno, pues gracias por NO intentar cubrirme cuando ha pasado lo del mensaje."
    mc "Eh bien, merci de ne pas avoir essayé de me couvrir lorsque l'incident du message s'est produit."

# game/scripts/c19/c19.rpy:1938
translate french c19s004_Betty_8f36a777:

    # bet "Ya te digo que no he hecho nada que no hubiera hecho cualquier tía abuela por su sobrino nieto favorito."
    bet "Je vous le dis, je n'ai rien fait qu'une grand-tante n'aurait pas fait pour son petit-neveu préféré."

# game/scripts/c19/c19.rpy:1939
translate french c19s004_Betty_e359f8d2:

    # mc "¿Ha pasado algo, Tía Betty? Te veo... ¿triste?"
    mc "Quelque chose s'est-il passé, tante Betty ? Tu as l'air... triste ?"

# game/scripts/c19/c19.rpy:1942
translate french c19s004_Betty_41d79523:

    # bet "Felicidades por haber salido a la luz con tus chicas, aunque no hayas tenido mucho que ver."
    bet "Félicitations pour votre coming out avec vos filles, même si vous n'y étiez pas vraiment pour quelque chose."

# game/scripts/c19/c19.rpy:1944
translate french c19s004_Betty_c8e94463:

    # bet "Felicidades por haber salido a la luz, aunque no hayas tenido mucho que ver."
    bet "Félicitations pour avoir été mis en lumière, même si vous n'y êtes pas pour grand-chose."

# game/scripts/c19/c19.rpy:1946
translate french c19s004_Betty_cd4ae234:

    # bet "Excepto tu pequeño asentimiento antes de la revelación. Creo que le ha pasado desapercibido a la mayoría."
    bet "Hormis ton petit signe de tête avant la révélation, je crois que la plupart des gens ne l'ont pas remarqué."

# game/scripts/c19/c19.rpy:1948
translate french c19s004_Betty_113c75fb:

    # bet "Y felicidades por tu futura paternidad."
    bet "Et félicitations pour votre future paternité."

# game/scripts/c19/c19.rpy:1949
translate french c19s004_Betty_abe924e8:

    # mc "Gracias, pero..."
    mc "Merci, mais..."

# game/scripts/c19/c19.rpy:1950
translate french c19s004_Betty_a5f7e8c3:

    # mc "No parece que te alegres demasiado. Y no has respondido a mi pregunta."
    mc "Tu n'as pas l'air très content. Et tu n'as pas répondu à ma question."

# game/scripts/c19/c19.rpy:1952
translate french c19s004_Betty_5a2702bf:

    # bet "No es eso... es que la sobredosis de noticias me ha dejado un poco anonadada."
    bet "Ce n'est pas ça... c'est juste que le flot incessant d'informations m'a un peu abasourdi."

# game/scripts/c19/c19.rpy:1955
translate french c19s004_Betty_d7480c8d:

    # bet "Has tenido suerte que la revelación de Olivia haya desviado la atención sobre la tuya."
    bet "Vous avez de la chance que la révélation d'Olivia ait détourné l'attention de la vôtre."

# game/scripts/c19/c19.rpy:1957
translate french c19s004_Betty_00031a46:

    # bet "Podrías haberte encontrado con un problema con las noticias simultáneas y con las chicas a las que les gustaría poder dar una noticia similar y a las que no has hecho mucho caso."
    bet "Vous avez peut-être rencontré un problème avec la diffusion simultanée d'informations et avec les jeunes femmes qui souhaiteraient pouvoir donner des informations similaires, et celles auxquelles vous n'avez pas accordé beaucoup d'attention."

# game/scripts/c19/c19.rpy:1958
translate french c19s004_Betty_ba092666:

    # mc "Si te refieres a Kiara, aún no hemos tenido la oportunidad de hablar..."
    mc "Si vous parlez de Kiara, nous n'avons pas encore eu l'occasion de discuter..."

# game/scripts/c19/c19.rpy:1960
translate french c19s004_Betty_4357113e:

    # bet "No solo a Kiara, cielo... Ver a toda la familia aquí, y ver cómo te miraban las que no tenían noticias que dar sobre ti..."
    bet "Pas seulement Kiara, ma chérie… Voir toute la famille ici, et voir comment ceux qui n’avaient aucune nouvelle de toi te regardaient…"

# game/scripts/c19/c19.rpy:1961
translate french c19s004_Betty_86582942:

    # bet "Alguna parecía querer estar en posición de poder darla."
    bet "Certains semblaient vouloir être en mesure de le donner."

# game/scripts/c19/c19.rpy:1962
translate french c19s004_Betty_b3ca2984:

    # mc "Tú tampoco tenías ninguna noticia que dar sobre mí. *Risa* ¿También te hubiera gustado?"
    mc "Vous n'aviez pas de nouvelles de moi non plus. *Rires* Auriez-vous aimé ça aussi ?"

# game/scripts/c19/c19.rpy:1964
translate french c19s004_Betty_0cc2f8c2:

    # bet "No apliques mi psicología contra mí. *Risa triste*"
    bet "N'utilise pas ma psychologie contre moi. *Rire triste*"

# game/scripts/c19/c19.rpy:1965
translate french c19s004_Betty_27aff9ed:

    # bet "Hoy han salido a la luz noticias importantes que una vieja monja nunca podrá igualar."
    bet "Aujourd'hui, une information importante a été révélée : une vieille nonne ne pourra jamais égaler ce qu'elle avait accompli."

# game/scripts/c19/c19.rpy:1966
translate french c19s004_Betty_ef8b341d:

    # mc "No es una competición para ver quién da la noticia más grande."
    mc "Il ne s'agit pas d'une compétition pour savoir qui annoncera la plus grande nouvelle."

# game/scripts/c19/c19.rpy:1967
translate french c19s004_Betty_b811fab2:

    # mc "Por raro que parezca, me parece más importante la noticia de Meemaw. Que quiera confiar en todos nosotros y la mudanza. Creo que la mudanza te ha sorprendido incluso a ti."
    mc "Étrangement, je crois que les nouvelles de Mémé sont plus importantes. Le fait qu'elle veuille nous faire confiance à tous, et le déménagement. Je pense que ce déménagement vous a même surpris."

# game/scripts/c19/c19.rpy:1969
translate french c19s004_Betty_97daa0f6:

    # mc "La mudanza y el cáncer. Creo que la mudanza te ha sorprendido incluso a ti."
    mc "Le déménagement et le cancer. Je crois que le déménagement vous a surpris vous aussi."

# game/scripts/c19/c19.rpy:1971
translate french c19s004_Betty_9e0f4c0b:

    # bet "Un poco..."
    bet "Un peu..."

# game/scripts/c19/c19.rpy:1972
translate french c19s004_Betty_5c402a64:

    # mcp "(Obviamente le pasa algo de lo que no quiere hablar tan cerca del resto.)"
    mcp "(De toute évidence, quelque chose ne va pas chez elle et elle ne veut pas en parler devant tout le monde.)"

# game/scripts/c19/c19.rpy:1973
translate french c19s004_Betty_37998e47:

    # mc "Antes has dicho que querías hablar conmigo. ¿Te parece un buen momento?"
    mc "Vous avez dit tout à l'heure que vous vouliez me parler. Est-ce que ça vous semble un bon moment ?"

# game/scripts/c19/c19.rpy:1974
translate french c19s004_Betty_aa288525:

    # bet "Sí, pero... ¿podemos ir a sentarnos?"
    bet "Oui, mais... pouvons-nous aller nous asseoir ?"

# game/scripts/c19/c19.rpy:1975
translate french c19s004_Betty_890c041b:

    # mc "Por supuesto."
    mc "Bien sûr."

# game/scripts/c19/c19.rpy:1977
translate french c19s004_Betty_0fc7d311:

    # mc "Dime, ¿de qué querías hablar?"
    mc "Dites-moi, de quoi vouliez-vous parler ?"

# game/scripts/c19/c19.rpy:1978
translate french c19s004_Betty_8ecb9d01:

    # bet "Desde que te lo he dicho han cambiado tanto las cosas..."
    bet "Les choses ont tellement changé depuis que je vous l'ai dit..."

# game/scripts/c19/c19.rpy:1979
translate french c19s004_Betty_82a2fe7f:

    # bet "Esta mañana he ido a misa... con el coche de [nor]."
    bet "Ce matin, je suis allé à la messe... en voiture [nor]."

# game/scripts/c19/c19.rpy:1980
translate french c19s004_Betty_24821487:

    # mc "Muy valiente por tu parte. *Risa*"
    mc "C'est très courageux de votre part. *Rires*"

# game/scripts/c19/c19.rpy:1982
translate french c19s004_Betty_8cf0bafc:

    # bet "*Risa triste* Sí... es más viejo aún que yo... o al menos tiene más achaques..."
    bet "*Rire triste* Oui... il est même plus âgé que moi... ou du moins il a plus de problèmes de santé..."

# game/scripts/c19/c19.rpy:1983
translate french c19s004_Betty_8850bccf:

    # mc "No eres vieja, Tía Betty... digamos que eres vintage. *Risa* Pero aún estás muy bien... de salud, me refiero."
    mc "Vous n'êtes pas vieille, tante Betty… disons plutôt que vous êtes vintage ! *Rires* Mais vous vous portez encore très bien… côté santé, bien sûr."

# game/scripts/c19/c19.rpy:1985
translate french c19s004_Betty_18c81b3f:

    # bet "Bueno... hoy me he saltado un Stop al volver de misa. No ha pasado nada grave, excepto que me ha parado la policía."
    bet "Bon... aujourd'hui, j'ai grillé un stop en rentrant de la messe. Rien de grave ne s'est passé, à part que la police m'a arrêté."

# game/scripts/c19/c19.rpy:1986
translate french c19s004_Betty_91c7642d:

    # mc "¿Estás así por una multa? No pasa nada. A Mamá le ponen como mínimo una al mes."
    mc "Tu es contrarié(e) par une amende ? C'est normal. Maman en reçoit au moins une par mois."

# game/scripts/c19/c19.rpy:1988
translate french c19s004_Betty_a061466f:

    # bet "No es por la multa... cuando el agente me ha pedido la documentación... mi permiso de conducir está caducado desde hace más de un año."
    bet "Ce n'est pas une question d'amende… quand l'agent m'a demandé mes papiers… mon permis de conduire était périmé depuis plus d'un an."

# game/scripts/c19/c19.rpy:1989
translate french c19s004_Betty_ac67df24:

    # bet "Ni me había dado cuenta de cuándo caducaba."
    bet "Je n'avais même pas remarqué qu'il avait expiré."

# game/scripts/c19/c19.rpy:1990
translate french c19s004_Betty_c73045ad:

    # bet "El agente ha sido muy amable y me ha dejado volver a casa conduciendo, pero voy a tener que hacer unas gestiones en la DMV para renovar la licencia."
    bet "L'agent a été très gentil et m'a laissé rentrer chez moi en voiture, mais je vais devoir faire des démarches administratives à la préfecture pour renouveler mon permis."

# game/scripts/c19/c19.rpy:1991
translate french c19s004_Betty_2f2a790c:

    # mc "Y quieres que te lleve a renovarla, no hay ningún problema."
    mc "Et si vous voulez que je vous accompagne pour le renouveler, il n'y a pas de problème."

# game/scripts/c19/c19.rpy:1993
translate french c19s004_Betty_f5c29cf4:

    # bet "No hace falta. Me ha dicho que lo puedo hacer online, pero no voy a poder conducir hasta que llegue el nuevo permiso."
    bet "Ce n'est pas nécessaire. Il m'a dit que je pouvais le faire en ligne, mais que je ne pourrais pas conduire tant que je n'aurais pas reçu mon nouveau permis."

# game/scripts/c19/c19.rpy:1994
translate french c19s004_Betty_f8be02d5:

    # bet "Y aquí es donde se pone raro. Te iba a pedir que me llevases a Monterey antes de saber lo que le habías regalado a [emm]."
    bet "Et c'est là que ça devient bizarre. J'allais te demander de m'emmener à Monterey avant de découvrir ce que tu avais donné [emm]."

# game/scripts/c19/c19.rpy:1995
translate french c19s004_Betty_f561ecab:

    # mc "¿A Monterey? ¿Qué tienes que hacer allí? No hay ningún problema en llevarte. No lo habría aunque no le hubiera regalado el alquiler a [emm]."
    mc "À Monterey ? Qu'est-ce que vous devez y faire ? Je peux vous emmener sans problème. Il n'y aurait eu aucun problème même si je n'avais pas offert la location à [emm]."

# game/scripts/c19/c19.rpy:1997
translate french c19s004_Betty_32b311f3:

    # bet "¿Qué te han contado de por qué dejé África?"
    bet "Qu'est-ce qu'ils vous ont dit sur les raisons de mon départ d'Afrique ?"

# game/scripts/c19/c19.rpy:1998
translate french c19s004_Betty_a8fa27a0:

    # mc "Nada. Creía que volviste para unas vacaciones o algo así y te quedaste por lo de Meemaw."
    mc "Rien. Je croyais que tu étais revenu pour des vacances ou quelque chose comme ça et que tu étais resté à cause de Mémé."

# game/scripts/c19/c19.rpy:2000
translate french c19s004_Betty_80b5fd53:

    # bet "Volví porque me expulsaron de Tanzania..."
    bet "Je suis revenu parce que j'ai été expulsé de Tanzanie..."

# game/scripts/c19/c19.rpy:2001
translate french c19s004_Betty_7d703b8a:

    # bet "No del país, sino de la Iglesia de allí. Me abrieron expediente... por enfrentarme a un Obispo local."
    bet "Non pas du pays, mais de l'Église locale. Ils ont porté plainte contre moi… pour avoir tenu tête à un évêque local."

# game/scripts/c19/c19.rpy:2002
translate french c19s004_Betty_2d7a7ac6:

    # mc "¿Qué hiciste, Tía Betty?"
    mc "Qu'as-tu fait, tante Betty ?"

# game/scripts/c19/c19.rpy:2004
translate french c19s004_Betty_dc65b1f9:

    # bet "Negarme a operar el cerebro de alguien para curarle la homosexualidad. O lobotomizarlo si no era posible hacerlo."
    bet "Je refuserais d'opérer quelqu'un du cerveau pour le guérir de son homosexualité. Ou de le lobotomiser si cela s'avérait impossible."

# game/scripts/c19/c19.rpy:2005
translate french c19s004_Betty_f112c7ee:

    # mc "¿Qué? ¿Eso aún pasa?"
    mc "Quoi ? Ça arrive encore ?"

# game/scripts/c19/c19.rpy:2007
translate french c19s004_Betty_2b7fcdd0:

    # bet "No, no pasa. Pero el Obispo quería demostrar al jefe de uno de los kraal, aldeas Masái, que aún sigue religiones tradicionales, el poder de Cristo..."
    bet "Non, cela n'arrivera pas. Mais l'évêque voulait démontrer au chef d'un des kraals, ces villages masaï qui pratiquent encore les religions traditionnelles, la puissance du Christ…"

# game/scripts/c19/c19.rpy:2008
translate french c19s004_Betty_69646794:

    # bet "Aunque fuera de una forma rastrera y mintiéndole. Si el jefe se convertía, parte del kraal también lo haría... y el hijo gay de un jefe era una oportunidad."
    bet "Même si c'était par des moyens détournés et en lui mentant. Si le chef se convertissait, une partie du kraal suivrait… et le fils homosexuel du chef représentait une opportunité."

# game/scripts/c19/c19.rpy:2009
translate french c19s004_Betty_080b2c91:

    # bet "Mucha gente en Tanzania piensa que la homosexualidad no está bien y que los homosexuales no tienen lugar en la sociedad."
    bet "En Tanzanie, beaucoup de gens pensent que l'homosexualité est immorale et que les homosexuels n'ont pas leur place dans la société."

# game/scripts/c19/c19.rpy:2010
translate french c19s004_Betty_3b5202cf:

    # bet "Un jefe con un hijo gay, por muy integrado que esté en la sociedad tanzana, tiene un problema grave."
    bet "Un patron qui a un fils homosexuel, aussi bien intégré soit-il dans la société tanzanienne, a un sérieux problème."

# game/scripts/c19/c19.rpy:2011
translate french c19s004_Betty_98971d5c:

    # mc "¡Eso es terrible! ¿Qué pasó?"
    mc "C'est terrible ! Que s'est-il passé ?"

# game/scripts/c19/c19.rpy:2013
translate french c19s004_Betty_4bac6634:

    # bet "Que me negué a operar un cerebro completamente sano para buscar algo que no se puede extirpar."
    bet "J'ai refusé d'opérer un cerveau parfaitement sain pour chercher quelque chose qui ne peut pas être enlevé."

# game/scripts/c19/c19.rpy:2014
translate french c19s004_Betty_6601e231:

    # bet "Se lo dije al jefe y al chico, y eso llevó a problemas con el Obispo."
    bet "J'en ai parlé au patron et au garçon, et cela a entraîné des problèmes avec l'évêque."

# game/scripts/c19/c19.rpy:2015
translate french c19s004_Betty_aa30d813:

    # bet "Él sabe que estaba mintiendo, pero en vez de reconocerlo, me echó las culpas a mí y consiguió que la Iglesia me echara de allí. Había socavado su imagen."
    bet "Il savait qu'il mentait, mais au lieu de l'admettre, il m'a accusé et a obtenu mon exclusion de l'Église. Il avait terni sa réputation."

# game/scripts/c19/c19.rpy:2016
translate french c19s004_Betty_f01efb88:

    # mc "Pero podrías haberte quedado aunque no fuera trabajando para la Iglesia, ¿no?"
    mc "Mais vous auriez pu rester même si cela n'avait pas été bénéfique pour l'Église, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2018
translate french c19s004_Betty_5dbca6a5:

    # bet "No, [mc]. El permiso de residencia y trabajo lo tenía gracias a la Iglesia. Puedo visitar el país a nivel particular, pero no trabajar allí."
    bet "Non, [mc]. J'ai obtenu mon permis de séjour et de travail grâce à l'Église. Je peux me rendre dans le pays pour des raisons personnelles, mais je ne peux pas y travailler."

# game/scripts/c19/c19.rpy:2019
translate french c19s004_Betty_40a2ab04:

    # bet "Y adoro ese país."
    bet "Et j'adore ce pays."

# game/scripts/c19/c19.rpy:2020
translate french c19s004_Betty_b0c668cb:

    # mc "Lo que no entiendo es qué tiene esto que ver con la visita a Monterey."
    mc "Ce que je ne comprends pas, c'est le rapport avec la visite à Monterey."

# game/scripts/c19/c19.rpy:2022
translate french c19s004_Betty_e2234509:

    # bet "Hoy he estado hablando con el Padre Matthews en la iglesia. Me ha dicho que mis papeles han llegado ya desde Florida y que debería ir al Obispado de Monterey."
    bet "J'ai parlé aujourd'hui avec le père Matthews à l'église. Il m'a dit que mes papiers étaient arrivés de Floride et que je devais me rendre au diocèse de Monterey."

# game/scripts/c19/c19.rpy:2023
translate french c19s004_Betty_62b78b45:

    # bet "Como visita de cortesía y para informarme sobre cómo está mi expediente."
    bet "À titre de visite de courtoisie et pour m'informer de l'état d'avancement de mon dossier."

# game/scripts/c19/c19.rpy:2024
translate french c19s004_Betty_aa98d535:

    # mc "¿Tus papeles? No lo entiendo. ¿Tienes que informar a la Iglesia de dónde vives?"
    mc "Vos papiers ? Je ne comprends pas. Êtes-vous obligé de dire à l’Église où vous habitez ?"

# game/scripts/c19/c19.rpy:2026
translate french c19s004_Betty_28266ce5:

    # bet "Normalmente no. Pero con un expediente sancionador en curso... Es lo mejor. No quiero parecer una monja rebelde más de lo que ya lo parezco."
    bet "Normalement non. Mais avec une procédure disciplinaire en cours… c'est mieux ainsi. Je ne veux pas passer encore plus pour une nonne rebelle."

# game/scripts/c19/c19.rpy:2027
translate french c19s004_Betty_ad1e8093:

    # mc "Lo entiendo. No hay ningún problema. Puedo llevarte cuando vaya con [emm]. *Risa* Aunque no iremos al Obispado con el Ferrarini."
    mc "Je comprends. Pas de problème. Je peux te déposer quand j'irai avec [emm]. *Rires* Par contre, on n'ira pas à l'évêché avec les Ferrarini."

# game/scripts/c19/c19.rpy:2029
translate french c19s004_Betty_581b8f5e:

    # bet "*Risa* No, no quedaría muy profesional."
    bet "*Rires* Non, ça ne ferait pas très professionnel."

# game/scripts/c19/c19.rpy:2030
translate french c19s004_Betty_c31bd86d:

    # mc "¿Y por eso estás tan... triste? ¿Una multa y una visita al Obispado?"
    mc "Et c'est pour ça que tu es si... triste ? Une amende et une visite chez l'évêque ?"

# game/scripts/c19/c19.rpy:2032
translate french c19s004_Betty_1a32b7f8:

    # bet "No es eso. Me siento inútil. Hace un año que no piso un quirófano. Lo intenté en Florida. Hay buenos hospitales católicos allí."
    bet "Ce n'est pas ça. Je me sens inutile. Je n'ai pas mis les pieds dans un bloc opératoire depuis un an. J'ai essayé en Floride. Il y a de bons hôpitaux catholiques là-bas."

# game/scripts/c19/c19.rpy:2033
translate french c19s004_Betty_de9f8ba6:

    # bet "Y me dijeron que no podían darme ningún puesto hasta que no se resolviera mi expediente."
    bet "Et ils m'ont dit qu'ils ne pouvaient me proposer aucun poste tant que mon affaire ne serait pas réglée."

# game/scripts/c19/c19.rpy:2035
translate french c19s004_Betty_0ee07c20:

    # bet "Llevo un tiempo pensando que quizás acabe relegada en un convento. E ir a Monterey me tiene asustada."
    bet "Cela fait un moment que je me dis que je pourrais finir par être enfermée dans un couvent. Et aller à Monterey m'effraie."

# game/scripts/c19/c19.rpy:2036
translate french c19s004_Betty_72f3df68:

    # mc "¿Van a perder una cirujana porque te negaste a operar lo inoperable?"
    mc "Vont-ils perdre un chirurgien parce que vous avez refusé d'opérer un patient inopérable ?"

# game/scripts/c19/c19.rpy:2038
translate french c19s004_Betty_768c79bc:

    # bet "No, es posible que releguen a una monja rebelde que desobedeció una orden de un Obispo. Y, además, lo dejó en mal lugar."
    bet "Non, il est possible qu'ils rétrogradent une religieuse rebelle qui a désobéi à un ordre de l'évêque. De plus, elle lui a donné une mauvaise image."

# game/scripts/c19/c19.rpy:2039
translate french c19s004_Betty_ca878c65:

    # bet "Para ellos, puedo seguir sirviendo a Dios en un convento igual que lo hago en un quirófano."
    bet "Pour eux, je peux continuer à servir Dieu dans un couvent tout comme je le fais dans une salle d'opération."

# game/scripts/c19/c19.rpy:2040
translate french c19s004_Betty_09faa47d:

    # mc "¿Incluso si había razones médicas para hacerlo?"
    mc "Même s'il y avait des raisons médicales de le faire ?"

# game/scripts/c19/c19.rpy:2042
translate french c19s004_Betty_72fa1c9f:

    # bet "A los Obispos eso les da lo mismo. Piensa en ellos como políticos más que como sacerdotes."
    bet "Les évêques s'en moquent. Voyez-les plutôt comme des politiciens que comme des prêtres."

# game/scripts/c19/c19.rpy:2043
translate french c19s004_Betty_433100f4:

    # mc "Y que Meemaw diga que cuenta con tu sueldo para la mudanza es la gota que ha colmado el vaso, ¿no?"
    mc "Et que Meemaw dise qu'elle compte sur ton salaire pour le déménagement, c'est la goutte d'eau qui fait déborder le vase, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2045
translate french c19s004_Betty_4e1fed18:

    # bet "Más o menos. Desde que llegué a Florida estoy cobrando un sueldo reducido, hasta que se resuelva el expediente. Es suficiente para colaborar, pero no para lo que quiere Olivia."
    bet "Plus ou moins. Depuis mon arrivée en Floride, je perçois un salaire réduit en attendant la résolution de l'affaire. Cela suffit pour subvenir à mes besoins, mais pas pour satisfaire les exigences d'Olivia."

# game/scripts/c19/c19.rpy:2046
translate french c19s004_Betty_6f20622b:

    # bet "Si acabo en un convento será aún menos. Si depende de mi sueldo..."
    bet "Si je finis dans un couvent, ce sera encore moins. Si cela dépend de mon salaire…"

# game/scripts/c19/c19.rpy:2047
translate french c19s004_Betty_cd9714cc:

    # mc "Si depende de tu sueldo y éste desaparece o se reduce, el resto de la familia colaboraremos."
    mc "Si cela dépend de votre salaire et que celui-ci disparaît ou diminue, le reste de la famille vous aidera."

# game/scripts/c19/c19.rpy:2048
translate french c19s004_Betty_04e2e737:

    # mc "Tenemos una empresa millonaria. Supongo que como CEO tendré un sueldo... algo más alto que el de una monja."
    mc "Nous avons une entreprise qui pèse plusieurs millions de dollars. J'imagine qu'en tant que PDG, j'aurai un salaire… un peu plus élevé que celui d'une religieuse."

# game/scripts/c19/c19.rpy:2050
translate french c19s004_Betty_987feb0a:

    # bet "Es tan fácil olvidarse de eso..."
    bet "Il est si facile de l'oublier..."

# game/scripts/c19/c19.rpy:2051
translate french c19s004_Betty_1ac6fd98:

    # mc "Vale. Un problema resuelto. El permiso de conducir lo renovaremos mañana online. El transporte a Monterey también está resuelto. Hay que llevar a [emm] de todos modos."
    mc "D'accord. Problème résolu. On renouvellera le permis de conduire en ligne demain. Le transport jusqu'à Monterey est également réglé. Il nous faudra quand même prendre [emm]."

# game/scripts/c19/c19.rpy:2052
translate french c19s004_Betty_83ee38ab:

    # bet "Las casualidades que pasan en esta familia..."
    bet "Les coïncidences qui se produisent dans cette famille..."

# game/scripts/c19/c19.rpy:2053
translate french c19s004_Betty_ab7c5950:

    # mc "¿Algún problema más del que quieras hablar?"
    mc "Y a-t-il un autre problème dont vous aimeriez parler ?"

# game/scripts/c19/c19.rpy:2055
translate french c19s004_Betty_71b1082b:

    # bet "No, pero un abrazo sí que aceptaría..."
    bet "Non, mais j'accepterais bien un câlin..."

# game/scripts/c19/c19.rpy:2056
translate french c19s004_Betty_1fe2d1ce:

    # mc "De esos tengo muchos y no se van a agotar."
    mc "J'en ai beaucoup et je ne risque pas d'en manquer."

# game/scripts/c19/c19.rpy:2058
translate french c19s004_Betty_08928961:

    # bet "Gracias por ayudar a esta vieja, [mc]. Te has convertido en el hombre de la casa sin que nadie se diera cuenta. Sin que nadie te lo pidiera."
    bet "Merci d'avoir aidé cette vieille dame, [mc]. Vous êtes devenu l'homme de la maison sans que personne ne s'en aperçoive. Sans que personne ne vous l'ait demandé."

# game/scripts/c19/c19.rpy:2059
translate french c19s004_Betty_93101b7a:

    # bet "Cada día que pasa te pareces más a John..."
    bet "Chaque jour qui passe, tu ressembles de plus en plus à John..."

# game/scripts/c19/c19.rpy:2061
translate french c19s004_Betty_21981656:

    # bet "Y ahora además también vas a ser padre. No sé cuándo vas a tener tiempo para ti."
    bet "Et maintenant, tu vas être papa aussi. Je ne sais pas quand tu auras du temps pour toi."

# game/scripts/c19/c19.rpy:2062
translate french c19s004_Betty_4682b4ea:

    # bet "Tienes que guardar tiempo para hacer las cosas que te gustan o al final explotarás."
    bet "Vous devez vous ménager du temps pour les choses que vous aimez, sinon vous finirez par exploser."

# game/scripts/c19/c19.rpy:2063
translate french c19s004_Betty_396539c5:

    # mc "Ya lo hago, Tía Betty. Dar abrazos es uno de mis mayores hobbies."
    mc "Oui, tante Betty. Faire des câlins est l'un de mes passe-temps favoris."

# game/scripts/c19/c19.rpy:2065
translate french c19s004_Betty_440839a0:

    # bet "*Risa* Te conformas con poco."
    bet "*Rires* Tu te contentes de peu."

# game/scripts/c19/c19.rpy:2066
translate french c19s004_Betty_ebf89824:

    # mc "Si el dormitorio no me da más trabajo que hacer la contabilidad y la compra, me tengo que buscar entretenimientos, ¿no? *Risa*"
    mc "Si la chambre à coucher ne me donne pas plus de travail que la comptabilité et les courses, il faut bien que je trouve d'autres moyens de m'occuper, non ? *Rires*"

# game/scripts/c19/c19.rpy:2067
translate french c19s004_Betty_b9126f5e:

    # mc "Y estar con mis chicas es una de las mejores cosas que hay. Sois 22 aquí. No puedo pedir estar mejor acompañado."
    mc "Être avec mes filles est l'une des plus belles choses au monde. Vous êtes 22 ici. Je ne pourrais pas rêver d'une meilleure compagnie."

# game/scripts/c19/c19.rpy:2068
translate french c19s004_Betty_a3deeba9:

    # mc "Incluso Jamaal está bien para pasar un rato. *Risa* Pero a él no voy a darle abrazos."
    mc "Même Jamaal est sympa. *Rires* Mais je ne vais pas le prendre dans mes bras."

# game/scripts/c19/c19.rpy:2070
translate french c19s004_Betty_49ccb84e:

    # bet "Debería dejarte ir o el resto de las chicas me van a odiar por acapararte."
    bet "Je devrais te laisser partir, sinon les autres filles vont me détester parce que je t'accapare."

# game/scripts/c19/c19.rpy:2071
translate french c19s004_Betty_61151f95:

    # mc "Deberías disfrutar el abrazo y callar. Después puedes hablar con Scarlett sobre la app que usó anoche. Se acabarían los problemas de acaparamiento."
    mc "Profite de ce câlin et reste tranquille. Ensuite, tu pourras parler à Scarlett de l'application qu'elle a utilisée hier soir. Ça résoudra tous ses problèmes d'accumulation."

# game/scripts/c19/c19.rpy:2072
translate french c19s004_Betty_996f6a40:

    # bet "¿Qué app?"
    bet "Quelle application ?"

# game/scripts/c19/c19.rpy:2073
translate french c19s004_Betty_f9e38380:

    # "Le explicas la app de los turnos de baile. Alargas la explicación innecesariamente para estar más rato abrazado a ella."
    "Tu lui expliques le fonctionnement de l'application Dance Shift. Tu prolonges inutilement l'explication pour pouvoir la câliner plus longtemps."

# game/scripts/c19/c19.rpy:2074
translate french c19s004_Betty_797c1d45:

    # "La mujer que siempre da apoyo a los demás necesita apoyo hoy."
    "Cette femme qui soutient toujours les autres a besoin de soutien aujourd'hui."

# game/scripts/c19/c19.rpy:2076
translate french c19s004_Betty_71f2a5aa:

    # "Al cabo de un largo rato, se separa de ti reluctantemente."
    "Après une longue période, il se sépare de vous à contrecœur."

# game/scripts/c19/c19.rpy:2077
translate french c19s004_Betty_188003d1:

    # bet "Creo que ahora sí que debería dejarte... pero antes..."
    bet "Je crois que je devrais vraiment vous quitter maintenant... mais avant cela..."

# game/scripts/c19/c19.rpy:2079
translate french c19s004_Betty_ee227c78:

    # bet "Gracias por todo, [mc]. Deberías cobrar por esos abrazos."
    bet "Merci pour tout, [mc]. Tu devrais faire payer ces câlins."

# game/scripts/c19/c19.rpy:2080
translate french c19s004_Betty_fe864c02:

    # mc "Ese beso me parece un buen pago. *Risa*"
    mc "Ce baiser semble être une bonne récompense. *Rires*"

# game/scripts/c19/c19.rpy:2082
translate french c19s004_Betty_2ad3bbab:

    # bet "De esos tengo muchos y no se van a agotar."
    bet "J'en ai beaucoup et je ne risque pas d'en manquer."

# game/scripts/c19/c19.rpy:2084
translate french c19s004_Betty_b3890ebb:

    # mcp "(Espero que Eva y tú no habléis demasiado. Me acabas de recordar a lo que hizo anoche.)"
    mcp "(J'espère que toi et Eva ne vous parlez pas trop. Tu viens de me rappeler ce qu'elle a fait hier soir.)"

# game/scripts/c19/c19.rpy:2086
translate french c19s004_Betty_f1db23b1:

    # mcp "(¡Oh, mierda! Me había olvidado de que le había dicho que tenía que hablar con ella y con Amanda! Hora de hacerlo)"
    mcp "(Oh, mince ! J'avais oublié que je lui avais dit que je devais lui parler, ainsi qu'à Amanda ! Il est temps de le faire !)"

# game/scripts/c19/c19.rpy:2106
translate french c19s004_AmandaEva_40cc353b:

    # "Pillas a Amanda a solas, volviendo de la casa. El resto de las chicas siguen alrededor de Meemaw."
    "Tu surprends Amanda seule, à son retour de la maison. Les autres filles sont encore avec Meemaw."

# game/scripts/c19/c19.rpy:2108
translate french c19s004_AmandaEva_3b172093:

    # "Se han formado grupos, supones que comentando todas las revelaciones del día."
    "Des groupes se sont formés, vraisemblablement pour discuter de toutes les révélations du jour."

# game/scripts/c19/c19.rpy:2109
translate french c19s004_AmandaEva_29bbc125:

    # "Nadie se acuerda ya de la lucha de caballos a la que ibais a jugar."
    "Plus personne ne se souvient du combat de chevaux que vous alliez jouer."

# game/scripts/c19/c19.rpy:2110
translate french c19s004_AmandaEva_251ac38c:

    # mc "Amanda, ¿puedo veros a ti y a Eva en mi habitación en cinco minutos?"
    mc "Amanda, puis-je vous voir, toi et Eva, dans ma chambre dans cinq minutes ?"

# game/scripts/c19/c19.rpy:2111
translate french c19s004_AmandaEva_9a682629:

    # ama "¿Para qué? Aún no hemos acabado de concretar lo que hablamos anoche..."
    ama "Pourquoi ? Nous n'avons pas encore finalisé ce dont nous avons parlé hier soir..."

# game/scripts/c19/c19.rpy:2112
translate french c19s004_AmandaEva_ac645562:

    # mc "No tiene que ver con lo de anoche, no te preocupes."
    mc "Cela n'a rien à voir avec ce qui s'est passé hier soir, ne t'inquiète pas."

# game/scripts/c19/c19.rpy:2113
translate french c19s004_AmandaEva_dca2111d:

    # mc "¿Vas a buscarla y os veo arriba?"
    mc "Tu vas la chercher et on se retrouve en haut ?"

# game/scripts/c19/c19.rpy:2115
translate french c19s004_AmandaEva_2722a54e:

    # ama "De acuerdo, voy a avisarla."
    ama "D'accord, je la préviendrai."

# game/scripts/c19/c19.rpy:2117
translate french c19s004_AmandaEva_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c19/c19.rpy:2118
translate french c19s004_AmandaEva_2b4c2398:

    # ama "¿Qué necesitas, [mc]?"
    ama "De quoi as-tu besoin, [mc] ?"

# game/scripts/c19/c19.rpy:2119
translate french c19s004_AmandaEva_14ff3a77:

    # eva "¿Es urgente? Las chicas... la fiesta..."
    eva "C'est urgent ? Les filles... la fête..."

# game/scripts/c19/c19.rpy:2120
translate french c19s004_AmandaEva_83f07e4b:

    # mc "Van a ser dos minutos. Tengo algo para vosotras."
    mc "Cela ne prendra que deux minutes. J'ai quelque chose pour vous."

# game/scripts/c19/c19.rpy:2122
translate french c19s004_AmandaEva_e961bfce:

    # eva "¿Para nosotras?" (multiple=2)
    eva "Pour nous ?" (multiple=2)

# game/scripts/c19/c19.rpy:2123
translate french c19s004_AmandaEva_90c9b239:

    # ama "¿Qué es? ¿Algo sobre NTR?" (multiple=2)
    ama "Qu'est-ce que c'est ? Un truc avec du NTR ?" (multiple=2)

# game/scripts/c19/c19.rpy:2124
translate french c19s004_AmandaEva_c4198fb9:

    # mc "No os conocía en vuestro cumpleaños, con lo que he pensado que sería una buena idea dároslo hoy."
    mc "Je ne te connaissais pas le jour de ton anniversaire, alors j'ai pensé que ce serait une bonne idée de te l'offrir aujourd'hui."

# game/scripts/c19/c19.rpy:2125
translate french c19s004_AmandaEva_09866e1d:

    # mc "No es nada... importante... Tan solo algo que se me ocurrió."
    mc "Ce n'est rien... d'important... C'est juste une idée qui m'est venue."

# game/scripts/c19/c19.rpy:2127
translate french c19s004_AmandaEva_bcdae3e2:

    # mc "Son esas dos cajas que hay encima de la mesa."
    mc "Ce sont les deux boîtes sur la table."

# game/scripts/c19/c19.rpy:2128
translate french c19s004_AmandaEva_c71034f4:

    # mc "La caja púrpura es para Eva y la azul para Amanda."
    mc "La boîte violette est pour Eva et la bleue pour Amanda."

# game/scripts/c19/c19.rpy:2130
translate french c19s004_AmandaEva_e7073f13:

    # "Las chicas casi corren hacia las cajas. Las sopesan y escuchan en su interior."
    "Les filles se précipitent presque vers les boîtes. Elles les pèsent dans leurs mains et écoutent ce qu'elles contiennent."

# game/scripts/c19/c19.rpy:2132
translate french c19s004_AmandaEva_8a18531c:

    # "Las caras de sorpresa cuando las abren valen la pena. No sabes lo que esperaban, pero desde luego no lo que hay en las cajas."
    "Voir leur surprise lorsqu'ils les ouvrent, ça vaut le coup. On ne sait pas à quoi ils s'attendaient, mais on ignore encore plus ce que contiennent les boîtes."

# game/scripts/c19/c19.rpy:2133
translate french c19s004_AmandaEva_dff084ed:

    # ama "¿Le has dicho algo?"
    ama "Lui avez-vous dit quelque chose ?"

# game/scripts/c19/c19.rpy:2134
translate french c19s004_AmandaEva_8c2bc341:

    # eva "Salió la conversación el otro día..."
    eva "La conversation est revenue sur le tapis l'autre jour..."

# game/scripts/c19/c19.rpy:2136
translate french c19s004_AmandaEva_291fb3f1:

    # eva "Tengo que sentarme..."
    eva "J'ai besoin de m'asseoir..."

# game/scripts/c19/c19.rpy:2137
translate french c19s004_AmandaEva_458bec5d:

    # "No es el efecto que esperabas... A lo mejor la cara de sorpresa no era por una \"buena sorpresa\"."
    "Ce n'est pas l'effet escompté… Peut-être que cette expression surprise n'était pas due à une « agréable surprise »."

# game/scripts/c19/c19.rpy:2138
translate french c19s004_AmandaEva_7d9eb707:

    # mc "¿No os gustan? Creía que..."
    mc "Tu ne les aimes pas ? Je croyais…"

# game/scripts/c19/c19.rpy:2140
translate french c19s004_AmandaEva_6ca94c36:

    # eva "¿Una muñeca, [mc]? ¿Crees que somos niñas pequeñas?"
    eva "Une poupée, [mc] ? Tu nous prends pour des petites filles ?"

# game/scripts/c19/c19.rpy:2141
translate french c19s004_AmandaEva_7c9a1719:

    # mc "No. No es lo que quería decir con ese regalo... dijiste que nunca habíais tenido una. Encontré esas que eran personalizables y... No son pistolas... creía que os gustarían..."
    mc "Non. Ce n'est pas ce que je voulais dire par ce cadeau… tu as dit que tu n'en avais jamais eu. J'ai trouvé ceux-ci, personnalisables, et… ce ne sont pas des armes… Je pensais que ça te plairait…"

# game/scripts/c19/c19.rpy:2142
translate french c19s004_AmandaEva_eab1ef1c:

    # mc "No sé... quería regalaros vuestra primera muñeca... no quería ofenderos."
    mc "Je ne sais pas... Je voulais t'offrir ta première poupée... Je ne voulais pas t'offenser."

# game/scripts/c19/c19.rpy:2144
translate french c19s004_AmandaEva_51ebcfdf:

    # eva "No creía que te acordaras... o que hubieras prestado atención..."
    eva "Je ne pensais pas que tu te souvenais... ni même que tu avais fait attention..."

# game/scripts/c19/c19.rpy:2145
translate french c19s004_AmandaEva_ac971ab0:

    # mc "Siempre presto atención a lo que decís, Eva."
    mc "Je fais toujours attention à ce que tu dis, Eva."

# game/scripts/c19/c19.rpy:2147
translate french c19s004_AmandaEva_ddde49c2:

    # mc "¿A ti tampoco te gusta la tuya, Amanda?"
    mc "Tu n'aimes pas le tien non plus, Amanda ?"

# game/scripts/c19/c19.rpy:2148
translate french c19s004_AmandaEva_128915ea:

    # ama "¿Gustarme? ¿Tampoco?"
    ama "Ça vous plaît ? Même pas ?"

# game/scripts/c19/c19.rpy:2149
translate french c19s004_AmandaEva_e25c54c0:

    # ama "[mc], a veces pareces tan listo y a veces parece que no sabes de qué estás hablando... eres desconcertante."
    ama "[mc], parfois tu sembles si intelligent et parfois tu sembles ne pas savoir de quoi tu parles... tu es déroutant."

# game/scripts/c19/c19.rpy:2151
translate french c19s004_AmandaEva_6ed7a82f:

    # ama "Me encanta... La has vestido como el día que nos conocimos, durante el secuestro, pero sin el pasamontañas..."
    ama "J'adore... Tu l'as habillée comme le jour de notre rencontre, pendant l'enlèvement, mais sans la cagoule..."

# game/scripts/c19/c19.rpy:2153
translate french c19s004_AmandaEva_965b482b:

    # ama "Gracias, [mc]. Es increíble que te hayas tomado tantas molestias por nosotras."
    ama "Merci, [mc]. C'est incroyable que vous ayez fait autant d'efforts pour nous."

# game/scripts/c19/c19.rpy:2154
translate french c19s004_AmandaEva_17fd7601:

    # ama "Y a Eva también le gusta la suya. Pero no sabe expresar agradecimiento."
    ama "Et Eva aime la sienne aussi. Mais elle ne sait pas comment exprimer sa gratitude."

# game/scripts/c19/c19.rpy:2155
translate french c19s004_AmandaEva_cc761816:

    # mc "No..."
    mc "Non..."

# game/scripts/c19/c19.rpy:2157
translate french c19s004_AmandaEva_a99fdb2f:

    # mc "... pasa..."
    mc "... arrive..."

# game/scripts/c19/c19.rpy:2159
translate french c19s004_AmandaEva_68668214:

    # mc "... nada..."
    mc "... rien..."

# game/scripts/c19/c19.rpy:2160
translate french c19s004_AmandaEva_d908e823:

    # eva "¡Gracias, [mc]!"
    eva "Merci, [mc] !"

# game/scripts/c19/c19.rpy:2162
translate french c19s004_AmandaEva_720943b8:

    # eva "¡Gracias, gracias, gracias!"
    eva "Merci, merci, merci !"

# game/scripts/c19/c19.rpy:2163
translate french c19s004_AmandaEva_c37deefe:

    # mc "Me alegra que os gusten..."
    mc "Je suis content que vous les aimiez..."

# game/scripts/c19/c19.rpy:2165
translate french c19s004_AmandaEva_bc503d70:

    # eva "Tu turno, Amanda."
    eva "À ton tour, Amanda."

# game/scripts/c19/c19.rpy:2167
translate french c19s004_AmandaEva_dd958d13:

    # ama "Gracias, [mc]."
    ama "Merci, [mc]."

# game/scripts/c19/c19.rpy:2169
translate french c19s004_AmandaEva_9c56d7c9:

    # ama "No sabes lo que significa esto para nosotras."
    ama "Vous ne savez pas ce que cela représente pour nous."

# game/scripts/c19/c19.rpy:2170
translate french c19s004_AmandaEva_d18f7820:

    # mc "No lo puedo imaginar, pero me encantan vuestras reacciones. Aunque me habéis acojonado al principio."
    mc "Je n'arrive pas à l'imaginer, mais j'adore tes réactions. Même si tu m'as fait peur au début."

# game/scripts/c19/c19.rpy:2172
translate french c19s004_AmandaEva_3ed2cd9e:

    # ama "La próxima vez, añade un set de maquillaje. Últimamente, por tu culpa, parezco un mapache demasiado a menudo."
    ama "La prochaine fois, ajoute un kit de maquillage. Ces derniers temps, à cause de toi, j'ai bien trop souvent l'air d'un raton laveur."

# game/scripts/c19/c19.rpy:2173
translate french c19s004_AmandaEva_07490a72:

    # mc "*Risa* Y yo que creía que erais mercenarias duras..."
    mc "*Rires* Et dire que je vous croyais de durs mercenaires..."

# game/scripts/c19/c19.rpy:2175
translate french c19s004_AmandaEva_07200d65:

    # eva "Ponme a luchar con guerrillas africanas y te demostraré lo dura que soy..."
    eva "Mettez-moi face à des guérilleros africains et je vous montrerai de quoi je suis capable..."

# game/scripts/c19/c19.rpy:2176
translate french c19s004_AmandaEva_37bc5e40:

    # mc "Pero una muñeca te hace llorar..."
    mc "Mais une poupée vous fait pleurer..."

# game/scripts/c19/c19.rpy:2178
translate french c19s004_AmandaEva_68e44313:

    # ama "No es la muñeca en sí, [mc]. Es que hayas pensado que podrían gustarnos a nosotras."
    ama "Ce n'est pas la poupée en elle-même, [mc]. C'est que tu as pensé qu'elle pourrait nous plaire."

# game/scripts/c19/c19.rpy:2180
translate french c19s004_AmandaEva_6fbf7c40:

    # eva "Y que hayas pensado que nosotras también debíamos recibir regalos. El día del cumpleaños de las chicas."
    eva "Et que vous pensiez que nous devions aussi recevoir des cadeaux. Pour l'anniversaire des filles."

# game/scripts/c19/c19.rpy:2181
translate french c19s004_AmandaEva_16628867:

    # mc "Sois tan parte de esta familia como cualquiera de nosotros. Os debemos 18 regalos de cumpleaños."
    mc "Tu fais partie intégrante de cette famille, au même titre que chacun d'entre nous. Nous te devons 18 cadeaux d'anniversaire."

# game/scripts/c19/c19.rpy:2183
translate french c19s004_AmandaEva_098e99fa:

    # mc "¿Por qué no dejas la muñeca y vuelves aquí? Creo que un abrazo triple estaría bien, ¿no?"
    mc "Pourquoi ne pas poser la poupée et revenir ici ? Je pense qu'un triple câlin serait agréable, tu ne crois pas ?"

# game/scripts/c19/c19.rpy:2186
translate french c19s004_AmandaEva_8e1c8d0a:

    # eva "Sí. Se está bien aquí..."
    eva "Oui. C'est agréable ici..."

# game/scripts/c19/c19.rpy:2187
translate french c19s004_AmandaEva_553de1bd:

    # ama "Rechazo tu idea, Eva."
    ama "Je rejette ton idée, Eva."

# game/scripts/c19/c19.rpy:2188
translate french c19s004_AmandaEva_696e52fa:

    # eva "Creo que yo también la rechazo."
    eva "Je crois que je le rejette aussi."

# game/scripts/c19/c19.rpy:2189
translate french c19s004_AmandaEva_704e5ecf:

    # mc "¿De qué habláis?"
    mc "De quoi parles-tu?"

# game/scripts/c19/c19.rpy:2190
translate french c19s004_AmandaEva_a26e8fee:

    # eva "Te hemos dicho que no habíamos acabado de concretar lo que hablamos ayer..."
    eva "Nous vous avions dit que nous n'avions pas encore finalisé ce dont nous avons parlé hier..."

# game/scripts/c19/c19.rpy:2191
translate french c19s004_AmandaEva_6517a50c:

    # ama "Mi hermana tuvo la \"genial\" idea de decirte que, o nos elegías a las dos, o a ninguna."
    ama "Ma sœur a eu la « brillante » idée de te dire que tu devais choisir entre nous deux ou aucun de nous."

# game/scripts/c19/c19.rpy:2192
translate french c19s004_AmandaEva_e96689fc:

    # eva "No contestes qué elegirías... Ese plan se acaba de ir a la mierda. De todas formas, Amanda no estaba convencida."
    eva "Ne répondez pas à la question de votre choix… Ce plan est tombé à l'eau. De toute façon, Amanda n'était pas convaincue."

# game/scripts/c19/c19.rpy:2193
translate french c19s004_AmandaEva_54ad3bcb:

    # eva "Es lo que se me ocurrió para que no discutiéramos."
    eva "Voilà ce que j'ai trouvé pour éviter les disputes."

# game/scripts/c19/c19.rpy:2194
translate french c19s004_AmandaEva_c702702c:

    # mc "Y ¿por qué la rechazáis ahora?"
    mc "Et pourquoi la rejetez-vous maintenant ?"

# game/scripts/c19/c19.rpy:2196
translate french c19s004_AmandaEva_1638ef54:

    # ama "No podría aceptar que rechazaras a Eva por ese ultimátum si no quieres estar conmigo pero sí con ella."
    ama "Je ne pouvais pas accepter que tu rejettes Eva à cause de cet ultimatum si tu ne veux pas être avec moi mais que tu veux être avec elle."

# game/scripts/c19/c19.rpy:2197
translate french c19s004_AmandaEva_aa6aab58:

    # mcp "(Cada día te pareces más a [eri].)"
    mcp "(Chaque jour, tu ressembles de plus en plus à [eri].)"

# game/scripts/c19/c19.rpy:2198
translate french c19s004_AmandaEva_fa9a6811:

    # mc "¿Y tú, Eva? Si la idea fue tuya..."
    mc "Et toi, Eva ? Si c'était ton idée..."

# game/scripts/c19/c19.rpy:2200
translate french c19s004_AmandaEva_f584551c:

    # eva "Me he imaginado cómo reaccionaría yo si me pusieran entre la espada y la pared como pensaba hacerte."
    eva "J'ai imaginé comment je réagirais si je me retrouvais dos au mur, comme je comptais le faire avec toi."

# game/scripts/c19/c19.rpy:2201
translate french c19s004_AmandaEva_b6612b91:

    # eva "Mi reacción no hubiera sido... agradable. Ha hecho falta que me hagas llorar para que lo entienda."
    eva "Ma réaction n'aurait pas été... agréable. Il a fallu que tu me fasses pleurer pour que je comprenne."

# game/scripts/c19/c19.rpy:2202
translate french c19s004_AmandaEva_017af769:

    # mcp "(Y tú cada día te pareces más a [emm].)"
    mcp "(Et tu ressembles de plus en plus à [emm] chaque jour.)"

# game/scripts/c19/c19.rpy:2204
translate french c19s004_AmandaEva_54c92f55:

    # eva "No quiero que pases por eso porque nosotras nos estemos comportando como niñas pequeñas."
    eva "Je ne veux pas que tu vives ça parce qu'on se comporte comme des petites filles."

# game/scripts/c19/c19.rpy:2205
translate french c19s004_AmandaEva_72d03917:

    # mc "Gracias, Eva..."
    mc "Merci, Eva..."

# game/scripts/c19/c19.rpy:2207
translate french c19s004_AmandaEva_5cd7a77d:

    # ama "Al menos ahora seremos niñas pequeñas con muñecas. *Risa* Poco a poco iremos aprendiendo."
    ama "Au moins, maintenant, nous serons des petites filles avec des poupées. *Rires* Nous apprendrons petit à petit."

# game/scripts/c19/c19.rpy:2208
translate french c19s004_AmandaEva_4353756b:

    # mc "*Risa* Poco a poco. Os iremos dando un curso acelerado de \"normalidad\". O tanta \"normalidad\" como esta familia sea capaz."
    mc "*Rires* Petit à petit. On va vous donner un cours accéléré de « normalité ». Ou du moins, autant de « normalité » que cette famille en est capable."

# game/scripts/c19/c19.rpy:2210
translate french c19s004_AmandaEva_966d6274:

    # "El abrazo dura un rato, con conversaciones intrascendentes y risas."
    "L'étreinte dure un moment, ponctuée de conversations futiles et de rires."

# game/scripts/c19/c19.rpy:2212
translate french c19s004_AmandaEva_6fcceb24:

    # "La revelación de secretos se intercala entre las conversaciones."
    "La révélation de secrets s'entremêle tout au long des conversations."

# game/scripts/c19/c19.rpy:2213
translate french c19s004_AmandaEva_facc4e5a:

    # "Coinciden con lo que ha dicho Betty sobre el secreto de Meemaw dejando los tuyos en segundo plano."
    "Ils approuvent ce que Betty a dit à propos du secret de Meemaw, reléguant le vôtre au second plan."

# game/scripts/c19/c19.rpy:2215
translate french c19s004_AmandaEva_fca1cfd9:

    # "También te felicitan por tu futura paternidad. Has dado un buen uso a los tests."
    "Ils vous félicitent également pour votre future paternité. Vous avez su tirer profit des tests."

# game/scripts/c19/c19.rpy:2217
translate french c19s004_AmandaEva_0cd35f80:

    # ama "Creo que deberíamos ir bajando. Las chicas se van a preguntar dónde estamos."
    ama "Je pense qu'on devrait descendre. Les filles vont se demander où on est."

# game/scripts/c19/c19.rpy:2219
translate french c19s004_AmandaEva_5164513e:

    # ama "O si va a haber más secretos que revelar cuando bajemos. *Risa*"
    ama "Ou s'il y aura d'autres secrets à révéler une fois descendus. *Rires*"

# game/scripts/c19/c19.rpy:2220
translate french c19s004_AmandaEva_4693d2db:

    # mc "Sería buena idea bajar. No os olvidéis las muñecas."
    mc "Il serait judicieux de descendre. N'oubliez pas vos poignets."

# game/scripts/c19/c19.rpy:2221
translate french c19s004_AmandaEva_1e102db9:

    # ama "De camino a la piscina, las dejaremos en la habitación de [emm], con nuestra ropa."
    ama "En allant à la piscine, nous les laisserons dans la chambre [emm], avec nos vêtements."

# game/scripts/c19/c19.rpy:2223
translate french c19s004_AmandaEva_c4765bf0:

    # eva "Dadme un segundo..."
    eva "Donnez-moi une seconde..."

# game/scripts/c19/c19.rpy:2229
translate french c19s004_AmandaEva_59564e51:

    # eva "Ya. Podemos bajar. También dejaré esto en la habitación de [emm]."
    eva "D'accord. On peut descendre. Je laisserai aussi ceci dans la chambre [emm]."

# game/scripts/c19/c19.rpy:2230
translate french c19s004_AmandaEva_56a609cd:

    # mc "¿Por qué has cambiado de opinión?"
    mc "Pourquoi avez-vous changé d'avis ?"

# game/scripts/c19/c19.rpy:2232
translate french c19s004_AmandaEva_eb2836da:

    # eva "Alguien me dijo que tenía que dejar con ganas de más a los chicos que me interesaran y que contara las veces que lo hacía."
    eva "Quelqu'un m'a dit que je devrais laisser les garçons qui m'intéressaient en vouloir plus et compter combien de fois je le faisais."

# game/scripts/c19/c19.rpy:2233
translate french c19s004_AmandaEva_b1a421fc:

    # eva "Van dos."
    eva "Il y en a deux."

# game/scripts/c19/c19.rpy:2236
translate french c19s004_AmandaEva_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c19/c19.rpy:2238
translate french c19s004_AmandaEva_6e1fa55a:

    # mc "Creo que he creado un monstruo. *Risa*"
    mc "Je crois que j'ai créé un monstre. *Rires*"

# game/scripts/c19/c19.rpy:2239
translate french c19s004_AmandaEva_b1b109ab:

    # ama "Es culpa tuya. *Risa*"
    ama "C'est de ta faute. *Rires*"

# game/scripts/c19/c19.rpy:2242
translate french c19s004_AmandaEva_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c19/c19.rpy:2243
translate french c19s004_AmandaEva_05886884:

    # eva "*A través de la puerta* Soy yo..."
    eva "*À travers la porte* C'est moi..."

# game/scripts/c19/c19.rpy:2244
translate french c19s004_AmandaEva_cff3b865:

    # mc "Adelante..."
    mc "Avant..."

# game/scripts/c19/c19.rpy:2246
translate french c19s004_AmandaEva_a27de6a1:

    # eva "He querido hacer una salida tan dramática que me he olvidado a Fee."
    eva "Je voulais faire une sortie tellement spectaculaire que j'en ai oublié Fee."

# game/scripts/c19/c19.rpy:2247
translate french c19s004_AmandaEva_728e94ab:

    # mc "*Risa* Cógela y nos vemos abajo."
    mc "*Rires* Prends-le et on se retrouve en bas."

# game/scripts/c19/c19.rpy:2248
translate french c19s004_AmandaEva_edd753ce:

    # mcp "(¿Fee? ¿Ya le ha puesto nombre? ¿Es posible que sea por Fiona, la primera de las chicas que murió?)"
    mcp "(Des frais ? Lui a-t-elle déjà donné un nom ? Serait-ce en hommage à Fiona, la première des filles à mourir ?)"

# game/scripts/c19/c19.rpy:2250
translate french c19s004_AmandaEva_9ffd506a:

    # mcp "(La he diseñado para que se parezca a Eva, lo cual significa que también se parece a Fiona.)"
    mcp "(Je l'ai conçue pour qu'elle ressemble à Ève, ce qui signifie qu'elle ressemble aussi à Fiona.)"

# game/scripts/c19/c19.rpy:2252
translate french c19s004_AmandaEva_4250dff2:

    # eva "Hasta luego, [mc]." (multiple=2)
    eva "À plus tard, [mc]." (multiple=2)

# game/scripts/c19/c19.rpy:2253
translate french c19s004_AmandaEva_09450795:

    # ama "Te vemos en la piscina." (multiple=2)
    ama "On se voit à la piscine." (multiple=2)

# game/scripts/c19/c19.rpy:2254
translate french c19s004_AmandaEva_a7dace93:

    # mc "Hasta ahora, chicas. No os quedéis jugando con las muñecas en la habitación de [emm]. O al menos no os quedéis demasiado rato."
    mc "Ça suffit, les filles. Ne restez pas jouer avec les poupées dans la chambre [emm]. Ou du moins, n'y restez pas trop longtemps."

# game/scripts/c19/c19.rpy:2331
translate french c19s004_MaddieDebbie_e0e383bc:

    # "Al llegar a la piscina, te acercas a Maddie, que parece que se acaba de quedar sola."
    "En arrivant à la piscine, vous vous approchez de Maddie, qui semble avoir été laissée seule."

# game/scripts/c19/c19.rpy:2333
translate french c19s004_MaddieDebbie_a7d0ffb9:

    # mc "¿Qué tal te lo estás pasando, Maddie?"
    mc "Comment vas-tu, Maddie ?"

# game/scripts/c19/c19.rpy:2334
translate french c19s004_MaddieDebbie_92bcd6b6:

    # mad "Muy bien, había algunas chicas a las que solo conocía de pasada. Hacía mucho tiempo que no estaba en una fiesta con tanta gente y con tan buen rollo."
    mad "C'était génial ; il y avait des filles que je connaissais à peine. Ça faisait longtemps que je n'avais pas été à une fête avec autant de monde et une ambiance aussi sympa."

# game/scripts/c19/c19.rpy:2335
translate french c19s004_MaddieDebbie_9c828053:

    # mad "Incluso lo del mensaje se ha solucionado de una forma... diferente a como me imaginaba."
    mad "Même le problème des messages a été résolu d'une manière... différente de celle que j'avais imaginée."

# game/scripts/c19/c19.rpy:2336
translate french c19s004_MaddieDebbie_a427241e:

    # mc "Bueno... creo que somos diferentes a lo habitual."
    mc "Eh bien… je pense que nous sommes différents de la norme."

# game/scripts/c19/c19.rpy:2337
translate french c19s004_MaddieDebbie_65598d11:

    # mad "Siéntate conmigo un rato. Apenas hemos tenido tiempo de hablar."
    mad "Reste un moment avec moi. Nous avons à peine eu le temps de parler."

# game/scripts/c19/c19.rpy:2341
translate french c19s004_MaddieDebbie_6eeb2c71:

    # mad "No todas las chicas descubren todos los días que el chico con el que pensabas que tenías algo especial lo tiene también con más chicas."
    mad "Ce n'est pas tous les jours qu'une fille découvre que le garçon avec qui elle pensait avoir une relation spéciale a aussi une relation spéciale avec d'autres filles."

# game/scripts/c19/c19.rpy:2342
translate french c19s004_MaddieDebbie_1a8d88c3:

    # mc "Nunca me he escondido sobre eso."
    mc "Je ne l'ai jamais caché."

# game/scripts/c19/c19.rpy:2344
translate french c19s004_MaddieDebbie_34c91fae:

    # mc "Te dije que estaba con alguien más. No me puedes acusar de no ser sincero."
    mc "Je t'ai dit que j'étais avec quelqu'un d'autre. Tu ne peux pas m'accuser de malhonnêteté."

# game/scripts/c19/c19.rpy:2346
translate french c19s004_MaddieDebbie_2559aa01:

    # mc "Tu relación y la mía es diferente a cualquier otra que tenga."
    mc "Notre relation est unique en son genre."

# game/scripts/c19/c19.rpy:2348
translate french c19s004_MaddieDebbie_cadc6741:

    # mad "Pero que Betty haya querido cubrirte... ha sido alucinante."
    mad "Mais le fait que Betty ait voulu te couvrir… c’est formidable."

# game/scripts/c19/c19.rpy:2350
translate french c19s004_MaddieDebbie_b005c7f2:

    # mad "Ha sido alucinante que Betty haya intentado cubrirnos sin ni siquiera saber a quién cubría."
    mad "C'est incroyable que Betty ait essayé de nous couvrir sans même savoir qui elle couvrait."

# game/scripts/c19/c19.rpy:2352
translate french c19s004_MaddieDebbie_ad1b6620:

    # mad "Ha sido alucinante que Betty haya intentado cubriros sin ni siquiera saber a quién cubría."
    mad "C'est incroyable que Betty ait essayé de te couvrir sans même savoir qui elle couvrait."

# game/scripts/c19/c19.rpy:2354
translate french c19s004_MaddieDebbie_c35adc9f:

    # mc "Lo sabía, pero eso no le quita mérito a que haya querido cubrirnos."
    mc "Je le savais, mais cela ne diminue en rien le mérite de sa volonté de nous couvrir."

# game/scripts/c19/c19.rpy:2356
translate french c19s004_MaddieDebbie_86978398:

    # mc "No me extrañaría que lo hubiera sospechado en todo momento, conociendo a Tía Betty."
    mc "Je ne serais pas surprise qu'elle l'ait soupçonné depuis le début, connaissant tante Betty."

# game/scripts/c19/c19.rpy:2358
translate french c19s004_MaddieDebbie_3494d574:

    # mad "Has tenido que alucinar mucho cuando has recibido ese mensaje, no saliendo con nadie, y con Betty confesando algo que no es cierto para cubrirte."
    mad "Tu as dû être vraiment paniquée en recevant ce message, toi qui ne fréquentes personne, et Betty qui avoue quelque chose de faux pour te couvrir."

# game/scripts/c19/c19.rpy:2359
translate french c19s004_MaddieDebbie_482dcf08:

    # mc "Betty es así. La razón que ha dado es tan propia de ella... Ha preferido cargar con la culpa antes de que se descubriera el posible culpable."
    mc "C'est bien Betty ! L'explication qu'elle a donnée est tellement typique d'elle… Elle a préféré endosser la responsabilité plutôt que de voir le coupable démasqué."

# game/scripts/c19/c19.rpy:2361
translate french c19s004_MaddieDebbie_6995a6a6:

    # mad "Es bueno tener a alguien así cerca. Todos sois alucinantes... Betty, Olivia, [mar], [nor], las chicas... Obviamente Amanda y Eva..."
    mad "C'est génial d'avoir des gens comme ça dans les parages. Vous êtes tous formidables… Betty, Olivia, [mar], [nor], les filles… et bien sûr Amanda et Eva…"

# game/scripts/c19/c19.rpy:2362
translate french c19s004_MaddieDebbie_7376f5f2:

    # mc "¿Y el resto? Creo que no conocías a Kim, Lisa, o Kate. Te he visto hablando con ellas antes."
    mc "Et les autres ? Je ne pense pas que vous connaissiez Kim, Lisa ou Kate. Je vous ai déjà vus leur parler."

# game/scripts/c19/c19.rpy:2364
translate french c19s004_MaddieDebbie_b82b8fac:

    # mad "A Kate y a Lisa sí que las había visto. Vinieron con Debbie hace unos días a la tienda."
    mad "J'ai vu Kate et Lisa. Elles sont venues au magasin avec Debbie il y a quelques jours."

# game/scripts/c19/c19.rpy:2365
translate french c19s004_MaddieDebbie_7b51f5a0:

    # mad "A Kim no la había visto. Es espectacular. No me extraña que sea modelo."
    mad "Je n'avais jamais vu Kim auparavant. Elle est magnifique. Pas étonnant qu'elle soit mannequin."

# game/scripts/c19/c19.rpy:2366
translate french c19s004_MaddieDebbie_c083502f:

    # mc "Es una chica muy especial."
    mc "C'est une fille très spéciale."

# game/scripts/c19/c19.rpy:2368
translate french c19s004_MaddieDebbie_296e4b5f:

    # mad "Y muy amable. Después de los regalos, hablando con Lisa y Kim, hemos estado hablando de pintura."
    mad "Et très gentilles. Après les cadeaux, en discutant avec Lisa et Kim, nous avons parlé de peinture."

# game/scripts/c19/c19.rpy:2369
translate french c19s004_MaddieDebbie_4d9d0c2b:

    # mc "Lisa estudia arte, es lógico."
    mc "Lisa étudie l'art, c'est logique."

# game/scripts/c19/c19.rpy:2372
translate french c19s004_MaddieDebbie_b80e802c:

    # mad "Les ha hablado de los cuadros de Zeus, y de los diseños de vestidos."
    mad "Il leur parla des peintures de Zeus et des modèles de robes."

# game/scripts/c19/c19.rpy:2374
translate french c19s004_MaddieDebbie_86e63501:

    # mad "Les he hablado de unos cuadros de Zeus que tengo en mi habitación y... no sé si sabes que diseño ropa."
    mad "Je vous ai parlé de quelques tableaux de Zeus que j'ai dans ma chambre et... je ne sais pas si vous savez que je crée des vêtements."

# game/scripts/c19/c19.rpy:2375
translate french c19s004_MaddieDebbie_fadddf46:

    # mc "No, no lo sabía..."
    mc "Non, je ne savais pas ça..."

# game/scripts/c19/c19.rpy:2377
translate french c19s004_MaddieDebbie_672886fe:

    # mad "¡Pues Kim se ha ofrecido a servirme como maniquí para probar cómo quedan los vestidos en una persona real!"
    mad "Eh bien, Kim s'est proposée comme mannequin pour que je puisse tester l'apparence des robes sur une vraie personne !"

# game/scripts/c19/c19.rpy:2378
translate french c19s004_MaddieDebbie_cb38ff1b:

    # mc "¡Eso es fantástico!"
    mc "C'est fantastique !"

# game/scripts/c19/c19.rpy:2379
translate french c19s004_MaddieDebbie_2e60e84b:

    # mc "No tengo ni idea de si eso puede ayudarte, pero supongo que es mejor que verlos en papel o en un ordenador."
    mc "Je ne sais pas si cela vous aidera, mais j'imagine que c'est mieux que de les voir sur papier ou sur un ordinateur."

# game/scripts/c19/c19.rpy:2381
translate french c19s004_MaddieDebbie_38ffef5a:

    # mad "¡Es increíble! Muchas veces, cuando tengo el vestido cortado y pre-cosido, me lo pruebo y no se parece en nada a lo que tenía en mente."
    mad "C'est incroyable ! Bien souvent, quand ma robe est coupée et pré-cousue, je l'essaie et elle ne ressemble en rien à ce que j'avais imaginé."

# game/scripts/c19/c19.rpy:2382
translate french c19s004_MaddieDebbie_cd44ea46:

    # mad "Hacer modificaciones sobre mí misma es muy complicado, pero tener a Kim para ayudarme en eso... sería de una ayuda que no te puedes imaginar."
    mad "Modifier mes habitudes est très compliqué, mais avoir Kim pour m'aider dans ce processus... serait une aide inestimable."

# game/scripts/c19/c19.rpy:2383
translate french c19s004_MaddieDebbie_90e9b615:

    # mc "*Risa* Se te ve muy emocionada, con lo que empiezo a imaginármelo."
    mc "*Rires* Tu as l'air très enthousiaste, alors je commence à l'imaginer."

# game/scripts/c19/c19.rpy:2384
translate french c19s004_MaddieDebbie_09ae50f6:

    # mc "Y voy más allá. Ya me estoy imaginando a Kim desfilando en una pasarela con tus vestidos. *Risa*"
    mc "Et j'irai même plus loin. J'imagine déjà Kim défiler sur un podium dans vos robes. *Rires*"

# game/scripts/c19/c19.rpy:2386
translate french c19s004_MaddieDebbie_3d483a02:

    # mad "Mmmm... creo que me acabas de dar una idea muy interesante. Si encontráramos un fotógrafo... las dos podríamos sacar algo de esto..."
    mad "Mmm... Je crois que vous venez de me donner une idée très intéressante. Si on pouvait trouver un photographe... on pourrait tous les deux en faire quelque chose..."

# game/scripts/c19/c19.rpy:2387
translate french c19s004_MaddieDebbie_4ab91928:

    # mc "Habla con [emm]. No es profesional ni nada por el estilo, pero es buena con la cámara."
    mc "Parlez à [emm]. Elle n'est pas professionnelle, mais elle se débrouille bien avec un appareil photo."

# game/scripts/c19/c19.rpy:2389
translate french c19s004_MaddieDebbie_5465ec3b:

    # mad "¿Qué? ¡No lo sabía!"
    mad "Quoi ? Je ne savais pas ça !"

# game/scripts/c19/c19.rpy:2390
translate french c19s004_MaddieDebbie_b67c00ab:

    # mc "La fotografía es una de sus pasiones. Creo que las tres podríais sacar algo de esto."
    mc "La photographie est une de ses passions. Je pense que vous pourriez tous les trois en tirer des enseignements."

# game/scripts/c19/c19.rpy:2391
translate french c19s004_MaddieDebbie_bac1142b:

    # mc "[emm] aumentar su portfolio, Kim su book, y tú poder promocionar tus vestidos."
    mc "[emm] augmentez son portefeuille, Kim son livre, et vous pourrez promouvoir vos robes."

# game/scripts/c19/c19.rpy:2392
translate french c19s004_MaddieDebbie_54a87386:

    # mad "¡Tengo que hablar con ella!"
    mad "Il faut que je lui parle !"

# game/scripts/c19/c19.rpy:2393
translate french c19s004_MaddieDebbie_7e00dc7d:

    # mc "*Risa* La he visto entrar en casa hace un momento. Supongo que no tardará."
    mc "*Rires* Je l'ai vue entrer dans la maison il y a un instant. Je suppose qu'elle ne tardera pas."

# game/scripts/c19/c19.rpy:2395
translate french c19s004_MaddieDebbie_d2896817:

    # mad "Bueno, tampoco es el momento de hablar de negocios. Además es su cumpleaños."
    mad "Bon, ce n'est pas le moment de parler affaires non plus. En plus, c'est son anniversaire."

# game/scripts/c19/c19.rpy:2396
translate french c19s004_MaddieDebbie_d6a64fa2:

    # mc "Le harás un regalo increíble... otro regalo increíble, si le ofreces hacer fotos profesionales el día de su cumpleaños, o casi."
    mc "Vous lui ferez un cadeau extraordinaire… un autre cadeau extraordinaire encore, si vous lui proposez de prendre des photos professionnelles pour son anniversaire, ou presque."

# game/scripts/c19/c19.rpy:2399
translate french c19s004_MaddieDebbie_fc818920:

    # mc "Tengo una pregunta, hablando de regalos. ¿Qué ha sido del cuadro de Zeus disfrazado de superhéroe?"
    mc "J'ai une question, à propos de cadeaux. Qu'est-il advenu du tableau de Zeus déguisé en super-héros ?"

# game/scripts/c19/c19.rpy:2400
translate french c19s004_MaddieDebbie_6b57974e:

    # mad "No me gustaba. No estaba tan personalizado como me hubiera gustado. Sabiendo que [dap] quiere dedicarse a la química me pareció una mejor opción."
    mad "Je n'ai pas aimé. Ce n'était pas aussi personnalisé que je l'aurais souhaité. Sachant que [dap] souhaite faire carrière en chimie, cela me semblait un meilleur choix."

# game/scripts/c19/c19.rpy:2401
translate french c19s004_MaddieDebbie_3a40886a:

    # mc "Es una buena razón. Me ha gustado más el de químico que el de superhéroe."
    mc "C'est une bonne raison. J'ai préféré celui avec le chimiste à celui avec le super-héros."

# game/scripts/c19/c19.rpy:2402
translate french c19s004_MaddieDebbie_231faf9e:

    # mad "*Risa* El de superhéroe se quedará en mi pared cuando lo acabe. Lo dejé apartado mientras pintaba el de químico."
    mad "*Rires* Celui de super-héros restera accroché au mur une fois terminé. Je l'ai mis de côté pendant que je peignais celui de chimiste."

# game/scripts/c19/c19.rpy:2405
translate french c19s004_MaddieDebbie_c3a76666:

    # deb "¿Interrumpo algo?"
    deb "Est-ce que je dérange ?"

# game/scripts/c19/c19.rpy:2407
translate french c19s004_MaddieDebbie_5dfa73fe:

    # mc "No, Debbie, estábamos hablando de las fotos de [emm]."
    mc "Non, Debbie, nous parlions des photos de [emm]."

# game/scripts/c19/c19.rpy:2409
translate french c19s004_MaddieDebbie_715a205e:

    # deb "¡Oh! ¡Son fantásticas! Tiene muy buen ojo para la composición y la luz... al menos eso dice Lisa. Yo no entiendo de fotografía."
    deb "Oh ! Elles sont fantastiques ! Elle a un don pour la composition et la lumière… du moins, c'est ce que dit Lisa. Je n'y connais rien en photographie."

# game/scripts/c19/c19.rpy:2410
translate french c19s004_MaddieDebbie_be516646:

    # deb "Yo sólo sé si una foto me gusta o no. Y las de [emm] me gustan. Igual que tus cuadros, Maddie. Son super bonitos y muy graciosos."
    deb "Il n'y a que moi qui sache si j'aime une photo ou non. Et j'aime celles de [emm]. Tout comme tes peintures, Maddie. Elles sont superbes et vraiment drôles."

# game/scripts/c19/c19.rpy:2412
translate french c19s004_MaddieDebbie_3bc2500a:

    # mad "Gracias. Fue muy divertido pintarlos y disfrazar a Zeus."
    mad "Merci. C'était très amusant de les peindre et d'habiller Zeus."

# game/scripts/c19/c19.rpy:2414
translate french c19s004_MaddieDebbie_d403ee6e:

    # deb "¿Lo has traído también?"
    deb "Tu l'as apporté aussi ?"

# game/scripts/c19/c19.rpy:2416
translate french c19s004_MaddieDebbie_aceede83:

    # mad "¿A qué te refieres?"
    mad "De quoi parles-tu?"

# game/scripts/c19/c19.rpy:2418
translate french c19s004_MaddieDebbie_6abc1eb1:

    # deb "Has traído al otro gato, ¿no? Por eso preguntaba si habías traído a Zeus."
    deb "Vous avez amené l'autre chat, n'est-ce pas ? C'est pour ça que je vous demandais si vous aviez amené Zeus."

# game/scripts/c19/c19.rpy:2420
translate french c19s004_MaddieDebbie_4c5b75ff:

    # mad "No... solo tengo a Zeus... bueno \"tengo\"... Él seguramente pensaría diferente. ¿Por qué?"
    mad "Non… Je n’ai que Zeus… enfin, « j’ai »… Il penserait sûrement autrement. Pourquoi ?"

# game/scripts/c19/c19.rpy:2422
translate french c19s004_MaddieDebbie_f900d9ac:

    # deb "Cuando he subido a mi habitación, por la ventana se ve el jacuzzi de [nor]. Me ha parecido que Alexia tenía un gato en el regazo."
    deb "En montant dans ma chambre, j'ai aperçu le jacuzzi de [nor] par la fenêtre. J'ai cru qu'Alexia avait un chat sur les genoux."

# game/scripts/c19/c19.rpy:2423
translate french c19s004_MaddieDebbie_2aadbf07:

    # mc "¿El jacuzzi nudista? ¿Un gato negro?"
    mc "Un jacuzzi nudiste ? Un chat noir ?"

# game/scripts/c19/c19.rpy:2425
translate french c19s004_MaddieDebbie_24d0be7e:

    # deb "Sí, pero... ¿cómo... lo... sabes?"
    deb "Oui, mais... comment... le savez-vous ?"

# game/scripts/c19/c19.rpy:2427
translate french c19s004_MaddieDebbie_e6423ea6:

    # deb "¡Oh! ¡No! ¡Era otro tipo de animal peludo!"
    deb "Oh ! Non ! C'était un autre type d'animal à fourrure !"

# game/scripts/c19/c19.rpy:2429
translate french c19s004_MaddieDebbie_54ef0908:

    # mad "*Risa* ¡Un conejo!"
    mad "*Rires* Un lapin !"

# game/scripts/c19/c19.rpy:2430
translate french c19s004_MaddieDebbie_885c856a:

    # mc "*Risa* Puedes preguntarle a Alexia cómo se llama su mascota."
    mc "*Rires* Vous pouvez demander à Alexia comment s'appelle son animal de compagnie."

# game/scripts/c19/c19.rpy:2432
translate french c19s004_MaddieDebbie_a757e446:

    # deb "¡Por el amor de Dios! A veces soy tan pardilla..."
    deb "Bon sang ! Parfois, je suis tellement naïve..."

# game/scripts/c19/c19.rpy:2433
translate french c19s004_MaddieDebbie_9c32f411:

    # mc "No pasa nada, supongo que a esa distancia no podías tener una buena vista."
    mc "C'est bon, j'imagine que vous ne pouviez pas avoir une bonne vue à cette distance."

# game/scripts/c19/c19.rpy:2435
translate french c19s004_MaddieDebbie_dee9d07a:

    # mad "Creo que yo pasaré del jacuzzi nudista. A [eri] le ha costado convencerme para hacer topless..."
    mad "Je crois que je vais éviter le jacuzzi nudiste. Il a fallu me convaincre pour que j'y aille seins nus..."

# game/scripts/c19/c19.rpy:2436
translate french c19s004_MaddieDebbie_b9efa879:

    # mad "Creía que iba a ser la única que no lo hiciera. Si llego a saber que habría más mujeres tapadas... Aunque te acabas acostumbrando."
    mad "Je pensais être la seule à ne pas le faire. Si j'avais su que d'autres femmes se couvraient la tête… Mais on finit par s'y habituer."

# game/scripts/c19/c19.rpy:2438
translate french c19s004_MaddieDebbie_27ba0d3f:

    # deb "Dejaron claro que era opcional. A lo mejor no te lo han transmitido bien."
    deb "Ils ont bien précisé que c'était facultatif. Peut-être ne vous l'ont-ils pas expliqué correctement."

# game/scripts/c19/c19.rpy:2439
translate french c19s004_MaddieDebbie_0e722984:

    # mc "Debbie tiene razón. Ni en el jacuzzi ni en la piscina hay nada obligatorio. Todo es opcional."
    mc "Debbie a raison. Rien n'est obligatoire ni dans le jacuzzi ni dans la piscine. Tout est facultatif."

# game/scripts/c19/c19.rpy:2441
translate french c19s004_MaddieDebbie_99e87ec0:

    # mad "Entonces creo que sí que voy a ir. Me apetece un rato relajante. ¿Os apuntáis?"
    mad "Alors je pense que j'irai. J'ai envie de me détendre. Tu viens ?"

# game/scripts/c19/c19.rpy:2442
translate french c19s004_MaddieDebbie_f403ae00:

    # deb "Si a [mc] no le importa que le dejemos solo... si no se quiere apuntar, claro."
    deb "Si [mc] n'a pas d'objection à être laissé tranquille... s'il ne souhaite pas s'inscrire, bien sûr."

# game/scripts/c19/c19.rpy:2444
translate french c19s004_MaddieDebbie_cfdb49fc:

    # mc "No os preocupéis. Acabo de ver que Meemaw se ha quedado sola y quiero hablar con ella. Id y disfrutad."
    mc "Ne vous inquiétez pas. J'ai juste vu que Mémé est seule et je veux lui parler. Allez-y et amusez-vous bien."

# game/scripts/c19/c19.rpy:2513
translate french c19s005_Meemaw_efa0a712:

    # mc "¿Qué tal, Meemaw? ¿Ya te has cansado de los abrazos? *Risa* Te veo muy apartada."
    mc "Salut Meemaw, comment ça va ? Tu en as déjà marre des câlins ? *Rires* Tu as l'air bien distante."

# game/scripts/c19/c19.rpy:2514
translate french c19s005_Meemaw_3b7b48ed:

    # mee "No. *Risa* De eso nunca me canso. Pero necesitaba un momento a solas."
    mee "Non. *Rires* Je ne m'en lasse jamais. Mais j'avais besoin d'un moment seule."

# game/scripts/c19/c19.rpy:2516
translate french c19s005_Meemaw_990bf3c5:

    # mee "He entendido cómo se tuvieron que sentir Amanda y Eva."
    mee "Je comprends ce qu'Amanda et Eva ont dû ressentir."

# game/scripts/c19/c19.rpy:2517
translate french c19s005_Meemaw_253f8e22:

    # mee "Estoy... abrumada..."
    mee "Je suis... submergée..."

# game/scripts/c19/c19.rpy:2518
translate french c19s005_Meemaw_49d7607e:

    # mc "Con la bomba que has dejado caer... las bombas, si incluimos la mudanza... ¿Esperabas otra reacción?"
    mc "Avec la bombe que vous avez lâchée… les bombes, si l’on inclut le déménagement… Vous attendiez-vous à une réaction différente ?"

# game/scripts/c19/c19.rpy:2520
translate french c19s005_Meemaw_66c61ef7:

    # mee "No de las chicas..."
    mee "Aucune des filles..."

# game/scripts/c19/c19.rpy:2522
translate french c19s005_Meemaw_0f63f396:

    # mee "Y cuando hablo de las chicas incluyo a mis hijas."
    mee "Et quand je parle des filles, j'inclus mes filles."

# game/scripts/c19/c19.rpy:2524
translate french c19s005_Meemaw_8f566270:

    # mee "Y cuando hablo de las chicas incluyo a [nor] y [mar]."
    mee "Et quand je parle des filles, j'inclus [nor] et [mar]."

# game/scripts/c19/c19.rpy:2526
translate french c19s005_Meemaw_f13292ff:

    # mee "Pero me ha sorprendido mucho cómo se han comportado el resto de las chicas..."
    mee "Mais j'ai été très surprise par le comportement des autres filles..."

# game/scripts/c19/c19.rpy:2527
translate french c19s005_Meemaw_e95d6748:

    # mc "Te has ganado su cariño en los últimos días, Meemaw. Casi todas se sienten parte de la familia, y os ven a Tía Betty y a ti de una forma especial."
    mc "Tu as conquis leurs cœurs ces derniers jours, Meemaw. Presque tous se sentent comme faisant partie de la famille et ils te voient, toi et tante Betty, d'une manière particulière."

# game/scripts/c19/c19.rpy:2528
translate french c19s005_Meemaw_bfb08a0c:

    # mc "No te digo que alguien como Maddie, que es la primera vez que viene, sienta eso, ¿pero el resto? Seguro que sí."
    mc "Je ne dis pas que quelqu'un comme Maddie, qui est ici pour la première fois, ressent cela, mais qu'en est-il des autres ? J'en suis sûre."

# game/scripts/c19/c19.rpy:2530
translate french c19s005_Meemaw_d2bb86d3:

    # mee "El cariño es mutuo, [mc]. Pero... no sé... ha habido casi demasiados abrazos y ha sido muy emocionante."
    mee "L'affection est réciproque, [mc]. Mais... je ne sais pas... il y a eu presque trop de câlins et ça a été très émouvant."

# game/scripts/c19/c19.rpy:2531
translate french c19s005_Meemaw_1914d8e5:

    # mc "Entonces no te ofreceré el abrazo que venía a darte."
    mc "Alors je ne te donnerai pas l'accolade que je suis venu te faire."

# game/scripts/c19/c19.rpy:2532
translate french c19s005_Meemaw_f4eac813:

    # mc "Me voy a abrazar a otras chicas por ahí... seguro que ellas sí que lo necesitan. *Risa*"
    mc "Je vais faire des câlins à d'autres filles... Je suis sûre qu'elles en ont vraiment besoin. *Rires*"

# game/scripts/c19/c19.rpy:2534
translate french c19s005_Meemaw_f4c5a07d:

    # mee "¡Ni se te ocurra! Nunca le niegues un abrazo a una anciana. *Risa*"
    mee "N'y pense même pas ! Ne refuse jamais un câlin à une vieille dame. *Rires*"

# game/scripts/c19/c19.rpy:2535
translate french c19s005_Meemaw_e2e05749:

    # mc "*Risa* Sabía que ibas de farol..."
    mc "*Rires* Je savais que tu bluffais..."

# game/scripts/c19/c19.rpy:2537
translate french c19s005_Meemaw_43b45589:

    # mee "Cuando te suelte... dentro de un par de horas... ¿quieres sentarte un rato conmigo?"
    mee "Quand je te laisserai partir… dans quelques heures… aimerais-tu rester un moment avec moi ?"

# game/scripts/c19/c19.rpy:2538
translate french c19s005_Meemaw_f6156b94:

    # mc "Por supuesto. Pero solo queda un sillón. ¿Quién se ha llevado el otro?"
    mc "Bien sûr. Mais il ne reste qu'un seul fauteuil. Qui a pris l'autre ?"

# game/scripts/c19/c19.rpy:2540
translate french c19s005_Meemaw_c5cfc7cd:

    # mee "No lo sé... el único de quien no sospecho es de Jamaal... *Risa* Viene con asiento incorporado."
    mee "Je ne sais pas... le seul que je ne soupçonne pas, c'est Jamaal... *Rires* Il est livré avec un siège intégré."

# game/scripts/c19/c19.rpy:2541
translate french c19s005_Meemaw_b393a9b8:

    # mc "*Risa* Me encanta que te unas al grupo de Whack a Jamaal. Lo del estante de arriba de antes ha sido ingenioso."
    mc "*Rires* J'adore que tu rejoignes le groupe « Tape-taupe-toi ! ». La blague sur l'étagère du haut était vraiment bien trouvée."

# game/scripts/c19/c19.rpy:2542
translate french c19s005_Meemaw_beef2d1f:

    # mee "Si no me hubiera pedido leche para sus pastitas no lo habría hecho. *Risa*"
    mee "Si elle ne m'avait pas demandé du lait pour ses biscuits, je ne l'aurais pas fait. *Rires*"

# game/scripts/c19/c19.rpy:2543
translate french c19s005_Meemaw_fb5a2c3c:

    # mc "Pues te tendrás que sentar en mis rodillas. No creo que yo pueda sentarme en las tuyas después de tantos años. *Risa*"
    mc "Eh bien, tu devras t'asseoir sur mes genoux. Je ne pense pas pouvoir m'asseoir sur les tiens après toutes ces années. *Rires*"

# game/scripts/c19/c19.rpy:2546
translate french c19s005_Meemaw_3930f6de:

    # mee "Por cierto, felicidades por la paternidad. Me vas a hacer bisabuela... Cuando te pedí bisnietos en el aeropuerto no me imaginaba que sería tan pronto."
    mee "Au fait, félicitations pour la paternité ! Je vais être arrière-grand-mère… Quand je t’ai demandé d’avoir des arrière-petits-enfants à l’aéroport, je n’aurais jamais imaginé que ça arriverait si vite."

# game/scripts/c19/c19.rpy:2548
translate french c19s005_Meemaw_683c9096:

    # mc "Por partida doble en el caso de [dap]."
    mc "À double titre dans le cas de [dap]."

# game/scripts/c19/c19.rpy:2550
translate french c19s005_Meemaw_3347e1a0:

    # mee "Y aún podrían llegar más que me hicieran doblemente bisabuela."
    mee "Et il pourrait y en avoir encore d'autres qui feraient de moi une double arrière-grand-mère."

# game/scripts/c19/c19.rpy:2551
translate french c19s005_Meemaw_5a963f79:

    # mc "No estaba planeado, pero han llegado y estoy contento."
    mc "Ce n'était pas prévu, mais ils sont arrivés et j'en suis ravi."

# game/scripts/c19/c19.rpy:2552
translate french c19s005_Meemaw_8905cdcf:

    # mee "Yo también. Esta familia cada vez es más rara, pero cada vez me gusta más."
    mee "Moi aussi. Cette famille devient de plus en plus bizarre, mais je l'aime de plus en plus."

# game/scripts/c19/c19.rpy:2555
translate french c19s005_Meemaw_f97f9ee2:

    # mc "Al menos con la revelación de tu secreto, nadie ha prestado demasiada atención a mis relaciones."
    mc "Au moins, depuis que ton secret a été révélé, personne ne prête plus trop attention à mes relations."

# game/scripts/c19/c19.rpy:2556
translate french c19s005_Meemaw_83d9c8f0:

    # mee "En parte lo he hecho por eso. Era un buen momento antes de que nadie se escandalizara o se sorprendiera demasiado de que salieras con más de una mujer."
    mee "J'ai fait ça en partie pour cette raison. C'était le bon moment, avant que quiconque ne soit trop scandalisé ou surpris que tu fréquentes plusieurs femmes."

# game/scripts/c19/c19.rpy:2557
translate french c19s005_Meemaw_cb20e64a:

    # mee "Hay gente muy retrógrada en esta familia... y yo soy una de ellas. Quizás la que más."
    mee "Il y a des gens vraiment arriérés dans cette famille… et j’en fais partie. Peut-être même le plus arriéré."

# game/scripts/c19/c19.rpy:2558
translate french c19s005_Meemaw_7970aee0:

    # mee "Si yo lo tengo que aceptar... el resto también. Que se jodan."
    mee "Si je dois l'accepter... alors tout le monde doit l'accepter. Qu'ils aillent se faire voir."

# game/scripts/c19/c19.rpy:2559
translate french c19s005_Meemaw_06a3e9b9:

    # mc "*Risa* A veces eres maravillosa, Meemaw."
    mc "*Rires* Parfois, tu es merveilleuse, Mémé."

# game/scripts/c19/c19.rpy:2561
translate french c19s005_Meemaw_35e4ae37:

    # mee "*Risa* ¿Sólo a veces?"
    mee "*Rires* Seulement parfois ?"

# game/scripts/c19/c19.rpy:2562
translate french c19s005_Meemaw_6d9fd2ee:

    # mc "Sí, [emm]... digo... Meemaw. *Risa*"
    mc "Oui, [emm]... enfin... Mémé. *Rires*"

# game/scripts/c19/c19.rpy:2564
translate french c19s005_Meemaw_025d666b:

    # mc "¿Cómo sienta salir a la luz con tus secretos?"
    mc "Quel effet cela fait-il de révéler ses secrets ?"

# game/scripts/c19/c19.rpy:2565
translate french c19s005_Meemaw_0aa5eb83:

    # mee "Cuando he empezado a hablar estaba asustada. No sabía cómo se lo iban a tomar. Lo he ocultado durante demasiado tiempo y temía la reacción de [nor]."
    mee "Quand j'ai commencé à parler, j'ai eu peur. Je ne savais pas comment ils allaient réagir. Je l'avais caché trop longtemps et j'avais peur de la réaction de [nor]."

# game/scripts/c19/c19.rpy:2566
translate french c19s005_Meemaw_1c81faaa:

    # mee "Y la de [emm]. Nunca sabes por dónde puede explotar esa chica."
    mee "Et celle de [emm]. On ne sait jamais ce que cette fille pourrait faire ensuite."

# game/scripts/c19/c19.rpy:2568
translate french c19s005_Meemaw_f33f1e37:

    # mee "Y entonces [emm] ha hablado, sin dejar reaccionar a nadie."
    mee "Et puis [emm] prit la parole, sans laisser le temps à personne de réagir."

# game/scripts/c19/c19.rpy:2569
translate french c19s005_Meemaw_d236c436:

    # mee "Cuando ha venido a abrazarme, casi se me saltan las lágrimas. Después han venido el resto... ha sido increíble."
    mee "Quand il est venu me prendre dans ses bras, j'ai failli fondre en larmes. Puis le reste est venu… c'était incroyable."

# game/scripts/c19/c19.rpy:2570
translate french c19s005_Meemaw_82490061:

    # mc "No era el momento de echarte en cara que hubieras guardado el secreto. Todas estaban muy contentas con que lo hubieras superado."
    mc "Ce n'était pas le moment de te reprocher d'avoir gardé le secret. Tout le monde était très heureux que tu aies surmonté cette épreuve."

# game/scripts/c19/c19.rpy:2572
translate french c19s005_Meemaw_0127ebab:

    # mee "Cuando han pasado los abrazos, [nor] me lo ha echado en cara. Pero de una forma diferente a como esperaba..."
    mee "Une fois les câlins terminés, [nor] m'a confronté à ce sujet. Mais d'une manière différente de ce à quoi je m'attendais..."

# game/scripts/c19/c19.rpy:2573
translate french c19s005_Meemaw_ad85bbe2:

    # mee "Creo que... nos estamos haciendo amigas... nos ha costado 45 años, pero lo estamos logrando..."
    mee "Je crois... que nous sommes en train de devenir amis... il nous a fallu 45 ans, mais nous y arrivons..."

# game/scripts/c19/c19.rpy:2574
translate french c19s005_Meemaw_7dff0cac:

    # mc "Ayuda mucho que haya aprendido a plantarte cara. Cuando nos dijo que venías estaba tan asustada como tú antes de contar lo del cáncer."
    mc "Le fait qu'elle ait appris à te tenir tête est un grand soulagement. Quand elle nous a annoncé ta venue, elle était aussi effrayée que toi avant que tu ne nous parles de ton cancer."

# game/scripts/c19/c19.rpy:2576
translate french c19s005_Meemaw_05384915:

    # mee "¿De mí? Pero... pero..."
    mee "De ma part ? Mais… mais…"

# game/scripts/c19/c19.rpy:2578
translate french c19s005_Meemaw_c5545dcb:

    # mee "La critico mucho, ¿verdad?"
    mee "Je la critique beaucoup, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2579
translate french c19s005_Meemaw_962f36d8:

    # mc "Lo hacías. ¿Te imaginas qué hubiera pasado hace unos años si hubiera decidido ir en ropa interior por casa?"
    mc "Tu l'as fait. Imagine un peu ce qui se serait passé il y a quelques années si j'avais décidé de me promener dans la maison en sous-vêtements !"

# game/scripts/c19/c19.rpy:2581
translate french c19s005_Meemaw_4afcd482:

    # mee "Me hubiera puesto hecha una fiera. Bueno... prácticamente lo hice después del secuestro."
    mee "J'aurais pété les plombs. Enfin… c'est presque ce que j'ai fait après l'enlèvement."

# game/scripts/c19/c19.rpy:2582
translate french c19s005_Meemaw_bb5f9aad:

    # mc "Pero te plantó cara y te puso en tu sitio. Es su casa y son sus normas."
    mc "Mais elle t'a tenu tête et t'a remis à ta place. C'est sa maison, ce sont ses règles."

# game/scripts/c19/c19.rpy:2584
translate french c19s005_Meemaw_b483f4e3:

    # mee "Y tú te desnudaste. *Risa*"
    mee "Et tu t'es déshabillé(e). *Rires*"

# game/scripts/c19/c19.rpy:2585
translate french c19s005_Meemaw_2b918944:

    # mc "Bueno, la primera en desnudarse fuiste tú... *Risa*"
    mc "Eh bien, tu as été le premier à te déshabiller... *Rires*"

# game/scripts/c19/c19.rpy:2586
translate french c19s005_Meemaw_03e5d509:

    # mc "Pero sí. [nor] ha aprendido a tratarte y tú estás aprendiendo a respetarla."
    mc "Mais oui. [nor] Elle a appris comment te traiter et tu apprends à la respecter."

# game/scripts/c19/c19.rpy:2587
translate french c19s005_Meemaw_0d2b6bf9:

    # mc "Ahora tenéis una buena base para haceros amigas. Las dos lo necesitabais."
    mc "Vous avez maintenant une bonne base pour devenir amis. Vous en aviez tous les deux besoin."

# game/scripts/c19/c19.rpy:2589
translate french c19s005_Meemaw_33f0f002:

    # mee "Y la fiesta en topless ha sido una gran idea. Estoy segura de que [eri] lo pidió para que [nor] pudiese estar cómoda y yo no pudiera protestar."
    mee "Et la soirée topless était une excellente idée. Je suis sûr que [eri] l'a demandée pour que [nor] soit à l'aise et je ne pouvais pas me plaindre."

# game/scripts/c19/c19.rpy:2590
translate french c19s005_Meemaw_a98294d1:

    # mc "Conoces muy bien a tu nieta. *Risa*"
    mc "Vous connaissez très bien votre petite-fille. *Rires*"

# game/scripts/c19/c19.rpy:2591
translate french c19s005_Meemaw_b504c730:

    # mee "Pero se han apuntado más chicas de lo que esperaba. Y creo que les ha ido bien. Eva ha cambiado de opinión hace un rato..."
    mee "Mais il y a eu plus de filles inscrites que prévu. Et je trouve qu'elles ont bien réussi. Eva a changé d'avis il y a quelque temps…"

# game/scripts/c19/c19.rpy:2593
translate french c19s005_Meemaw_0cc37829:

    # mc "Y tú también deberías cambiar de opinión. Estás empezando a mojar tu top..."
    mc "Et toi aussi, tu devrais changer d'avis. Tu commences à avoir des ennuis..."

# game/scripts/c19/c19.rpy:2596
translate french c19s005_Meemaw_a2691aa4:

    # mee "¡Oh, mierda! No mires..."
    mee "Oh, merde ! Ne regarde pas..."

# game/scripts/c19/c19.rpy:2597
translate french c19s005_Meemaw_0899f357:

    # mc "Meemaw, te vi el otro día en la consulta del médico y te he dado un par de masajes desde entonces. No me voy a asustar por un poco de leche."
    mc "Meemaw, je t'ai vue l'autre jour chez le médecin et je t'ai massée deux ou trois fois depuis. Un peu de lait ne va pas me faire peur."

# game/scripts/c19/c19.rpy:2599
translate french c19s005_Meemaw_46de5d8c:

    # mee "Tienes razón..."
    mee "Tu as raison..."

# game/scripts/c19/c19.rpy:2601
translate french c19s005_Meemaw_a25b803a:

    # mee "Ya está... ya no mancho más. Creo que al final voy a disfrutar yo también la fiesta topless."
    mee "Ça y est… je ne me salis plus. Je crois que je vais enfin profiter de la soirée topless, moi aussi."

# game/scripts/c19/c19.rpy:2602
translate french c19s005_Meemaw_9ca29044:

    # mc "Bien dicho, Meemaw."
    mc "Bien dit, Mémé."

# game/scripts/c19/c19.rpy:2604
translate french c19s005_Meemaw_96525687:

    # mee "Ahora me voy a ir a lavar. Están... pegajosas"
    mee "Je vais me laver les mains maintenant. Elles sont... collantes."

# game/scripts/c19/c19.rpy:2605
translate french c19s005_Meemaw_717fff1c:

    # mc "Tranquila, ve a lavarte y después olvídate del problema y disfruta la tarde."
    mc "Détends-toi, va te laver, puis oublie ce problème et profite de l'après-midi."

# game/scripts/c19/c19.rpy:2607
translate french c19s005_Meemaw_5b128440:

    # mee "Hasta luego, cariño."
    mee "À plus tard, chérie."

# game/scripts/c19/c19.rpy:2608
translate french c19s005_Meemaw_43884720:

    # mc "Te veo luego, Meemaw."
    mc "À plus tard, Meemaw."

# game/scripts/c19/c19.rpy:2610
translate french c19s005_Meemaw_3a134494:

    # mee "¡Oh, mierda! Estar sentada encima tuyo me ha recordado a esta mañana..."
    mee "Oh, merde ! Être assise sur toi m'a rappelé ce matin..."

# game/scripts/c19/c19.rpy:2611
translate french c19s005_Meemaw_f0b85c4f:

    # mc "¿Te has puesto cachonda, Meemaw?"
    mc "Tu as envie de faire l'amour, Meemaw ?"

# game/scripts/c19/c19.rpy:2613
translate french c19s005_Meemaw_92aa663c:

    # mee "Un poco, pero puedo controlarlo..."
    mee "Un peu, mais je peux le contrôler..."

# game/scripts/c19/c19.rpy:2614
translate french c19s005_Meemaw_c6184ba0:

    # mc "Tu top dice lo contrario..."
    mc "Votre haut dit le contraire..."

# game/scripts/c19/c19.rpy:2616
translate french c19s005_Meemaw_eb7d423b:

    # mee "Ya está... ya no mancho más."
    mee "Ça y est... Je ne ferai plus de bêtises."

# game/scripts/c19/c19.rpy:2621
translate french c19s005_Meemaw_ebd5f0c1:

    # mc "Creo que es una buena idea, pero eso nos lleva a la pregunta del millón de dólares."
    mc "Je pense que c'est une bonne idée, mais cela nous amène à la question à un million de dollars."

# game/scripts/c19/c19.rpy:2622
translate french c19s005_Meemaw_8e8c7447:

    # mc "No has dicho nada de lo que hemos estado haciendo. Ya que estabas confesando secretos..."
    mc "Tu n'as pas dit un mot sur ce que nous avons fait. Depuis que tu confessais des secrets..."

# game/scripts/c19/c19.rpy:2624
translate french c19s005_Meemaw_3c877488:

    # mee "No sé qué podría haber dicho. No puedo decir que mi nieto me produce orgasmos cada vez que me masajea las tetas..."
    mee "Je ne sais pas ce que j'aurais pu dire. Je ne peux pas dire que mon petit-fils me donne des orgasmes à chaque fois qu'il me masse les seins…"

# game/scripts/c19/c19.rpy:2626
translate french c19s005_Meemaw_d26c261e:

    # mee "No es que estemos saliendo como estás haciendo con [mar]... ¿no?"
    mee "Ce n'est pas comme si on sortait ensemble comme toi avec [mar]... n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2628
translate french c19s005_Meemaw_fcc1aa5a:

    # mee "No es que estemos saliendo como estás haciendo con [nor]... ¿no?"
    mee "Ce n'est pas comme si on sortait ensemble comme toi avec [nor]... n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2630
translate french c19s005_Meemaw_49d6ca63:

    # mee "No es que estemos saliendo como estás haciendo con tu hermana... ¿no?"
    mee "Ce n'est pas comme si on sortait ensemble comme toi avec ta sœur... n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2632
translate french c19s005_Meemaw_3868858c:

    # mee "No es que estemos saliendo como estás haciendo con [eri]... ¿no?"
    mee "Ce n'est pas comme si on sortait ensemble comme toi avec [eri]... n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2634
translate french c19s005_Meemaw_610dc302:

    # mee "No es que estemos saliendo como estás haciendo con [dap]... ¿no?"
    mee "Ce n'est pas comme si on sortait ensemble comme tu le fais avec [dap]... n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2636
translate french c19s005_Meemaw_5ec2685f:

    # mee "No es que estemos saliendo... ¿no?"
    mee "Nous ne sommes pas en couple... si ?"

# game/scripts/c19/c19.rpy:2638
translate french c19s005_Meemaw_922563ae:

    # mee "Me sentiría ridícula si dijera que estoy saliendo con cualquiera... y más aún contigo."
    mee "Je me sentirais ridicule si je disais que je sortais avec n'importe qui... et encore plus avec toi."

# game/scripts/c19/c19.rpy:2639
translate french c19s005_Meemaw_2d3563d2:

    # mc "Entonces ¿qué estamos haciendo?"
    mc "Alors, que faisons-nous ?"

# game/scripts/c19/c19.rpy:2640
translate french c19s005_Meemaw_578b4bfa:

    # mee "No lo sé... No lo he pensado. Lo que ha pasado esta mañana ha sido increíble..."
    mee "Je ne sais pas… Je n’y ai pas réfléchi. Ce qui s’est passé ce matin était incroyable…"

# game/scripts/c19/c19.rpy:2642
translate french c19s005_Meemaw_c30a2a10:

    # mee "¿Pero realmente quieres tener una relación romántica conmigo? Salir sigue significando eso para los jóvenes, ¿no?"
    mee "Mais est-ce que tu veux vraiment une relation amoureuse avec moi ? Pour les jeunes, sortir ensemble, ça veut encore dire ça, non ?"

# game/scripts/c19/c19.rpy:2643
translate french c19s005_Meemaw_5c2d97dc:

    # mc "Sí, sigue significando eso..."
    mc "Oui, cela signifie toujours que..."

# game/scripts/c19/c19.rpy:2644
translate french c19s005_Meemaw_c6abd71d:

    # mc "No sé si quiero salir contigo ahora o más adelante, pero quiero hacerlo."
    mc "Je ne sais pas si j'ai envie de sortir avec toi maintenant ou plus tard, mais j'en ai envie."

# game/scripts/c19/c19.rpy:2646
translate french c19s005_Meemaw_82ed2ff4:

    # mee "¿Por qué? ¿Qué puedo aportarte yo?"
    mee "Pourquoi ? Que puis-je vous offrir ?"

# game/scripts/c19/c19.rpy:2648
translate french c19s005_Meemaw_89d8b93d:

    # mee "Sales con chicas mucho más jóvenes que yo..."
    mee "Tu sors avec des filles beaucoup plus jeunes que moi..."

# game/scripts/c19/c19.rpy:2650
translate french c19s005_Meemaw_e637fca2:

    # mee "Sales con una chica mucho más joven que yo..."
    mee "Tu sors avec une fille beaucoup plus jeune que moi..."

# game/scripts/c19/c19.rpy:2651
translate french c19s005_Meemaw_572cec9d:

    # mee "Yo tan solo soy una vieja que ha disfrutado mucho de lo que ha hecho con su nieto esta mañana..."
    mee "Je suis juste une vieille dame qui a vraiment apprécié ce qu'elle a fait avec son petit-fils ce matin..."

# game/scripts/c19/c19.rpy:2652
translate french c19s005_Meemaw_a541ce7a:

    # mc "No hace falta que contestes. Ni siquiera te lo estoy pidiendo. Sólo quiero que sepas que un día vamos a salir a cenar. Vamos a tener una cita."
    mc "Tu n'es pas obligé de répondre. Je ne te le demande même pas. Je veux juste que tu saches qu'on va dîner ensemble un de ces jours. On a un rendez-vous."

# game/scripts/c19/c19.rpy:2654
translate french c19s005_Meemaw_ab0927a2:

    # mee "Y eso lo has decidido tú sin consultármelo a mí, sin tener en cuenta mi opinión, ¿no?"
    mee "Et vous avez décidé cela sans me consulter, sans tenir compte de mon avis, c'est bien ça ?"

# game/scripts/c19/c19.rpy:2655
translate french c19s005_Meemaw_d3a8828e:

    # mc "Sí. Vamos a salir como un nieto que lleva a su abuela a cenar... A eso no te puedes negar, a una cena inocente."
    mc "Oui. On sort comme un petit-fils emmène sa grand-mère dîner… On ne peut pas refuser une telle invitation, un dîner innocent."

# game/scripts/c19/c19.rpy:2657
translate french c19s005_Meemaw_67b59459:

    # mee "Pero eso no es una cita..."
    mee "Mais ce n'est pas un rendez-vous..."

# game/scripts/c19/c19.rpy:2658
translate french c19s005_Meemaw_1feb67f0:

    # mc "Déjame hablar. Vamos a salir como un nieto que lleva a su abuela a cenar."
    mc "Permettez-moi de parler. Nous sortons comme un petit-fils emmène sa grand-mère dîner."

# game/scripts/c19/c19.rpy:2659
translate french c19s005_Meemaw_97ed052e:

    # mc "Antes de volver a casa decidiremos si volvemos como hemos salido o como algo más. Y ahí tendré en cuenta tu opinión y tú tendrás en cuenta la mía."
    mc "Avant de rentrer, nous déciderons si nous reviendrons tels que nous sommes partis ou transformés. Je tiendrai compte de ton avis, et tu tiendras compte du mien."

# game/scripts/c19/c19.rpy:2660
translate french c19s005_Meemaw_cdeee0df:

    # mc "¿Te parece bien? Solo pido ir a cenar un día. No es un chantaje ni nada por el estilo. Tan solo quiero cenar con mi Meemaw y tener una conversación adulta después."
    mc "Ça te convient ? Je veux juste aller dîner un de ces jours. Ce n'est pas du chantage, hein. Je veux juste dîner avec ma grand-mère et avoir une conversation d'adulte après."

# game/scripts/c19/c19.rpy:2662
translate french c19s005_Meemaw_31efc17c:

    # mee "Son unas condiciones que puedo aceptar..."
    mee "Ce sont des conditions que je peux accepter..."

# game/scripts/c19/c19.rpy:2663
translate french c19s005_Meemaw_cbcfcdc4:

    # mee "¿Pero qué pasará si volvemos como hemos salido?"
    mee "Mais que se passera-t-il si nous revenons comme nous sommes partis ?"

# game/scripts/c19/c19.rpy:2664
translate french c19s005_Meemaw_2c615964:

    # mc "No pasará nada. Seguiremos como hasta ahora y habremos disfrutado de la compañía del otro durante una cena."
    mc "Il ne se passera rien. Nous continuerons comme avant et nous aurons passé un agréable moment ensemble autour d'un dîner."

# game/scripts/c19/c19.rpy:2666
translate french c19s005_Meemaw_a7eafbcf:

    # mee "¿Y si volvemos siendo algo más?"
    mee "Et si nous revenions en étant quelque chose de plus ?"

# game/scripts/c19/c19.rpy:2668
translate french c19s005_Meemaw_0cefc3c8:

    # mc "Te tocará explicárselo a tus hijas, a tu hermana, y a tus nietas. Yo me ocuparé de explicárselo al resto de las chicas"
    mc "Tu devras l'expliquer à tes filles, à ta sœur et à tes petites-filles. Je me chargerai de l'expliquer aux autres filles."

# game/scripts/c19/c19.rpy:2670
translate french c19s005_Meemaw_d6c0b755:

    # mc "Te tocará explicárselo a tu hija, a tu hermana, y a tus nietas. Yo me ocuparé de explicárselo a [mar] y al resto de las chicas."
    mc "Tu devras l'expliquer à ta fille, ta sœur et tes petites-filles. Je m'occuperai de l'expliquer à [mar] et aux autres filles."

# game/scripts/c19/c19.rpy:2672
translate french c19s005_Meemaw_391704c4:

    # mee "Sabes que lo estás poniendo muy difícil, ¿verdad?"
    mee "Tu sais que tu compliques vraiment les choses, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2673
translate french c19s005_Meemaw_9e111155:

    # mc "¿Tanto te asusta decírselo?"
    mc "Tu as si peur de lui dire ?"

# game/scripts/c19/c19.rpy:2675
translate french c19s005_Meemaw_7618df6f:

    # mee "No lo entiendes, cariño... pones difícil decirte que no a esa cena."
    mee "Tu ne comprends pas, chérie... tu rends difficile de dire non à ce dîner."

# game/scripts/c19/c19.rpy:2677
translate french c19s005_Meemaw_c5504181:

    # mee "Yo sólo voy a tener que explicárselo a ocho personas y tú al resto. *Risita*"
    mee "Je n'aurai à l'expliquer qu'à huit personnes, et tu l'expliqueras aux autres. *Rires*"

# game/scripts/c19/c19.rpy:2678
translate french c19s005_Meemaw_cb52f099:

    # mcp "(Ya está contando a Amanda y a Eva en el número de nietas.)"
    mcp "(Elle compte déjà Amanda et Eva parmi ses petites-filles.)"

# game/scripts/c19/c19.rpy:2680
translate french c19s005_Meemaw_4aa115b8:

    # mee "Yo sólo voy a tener que explicárselo a siete personas y tú al resto. *Risita*"
    mee "Je n'aurai à l'expliquer qu'à sept personnes, et tu l'expliqueras aux autres. *Rires*"

# game/scripts/c19/c19.rpy:2681
translate french c19s005_Meemaw_f82274ee:

    # mcp "(Está contando a [emm] y ya ha incluido a Amanda y a Eva en el número de nietas.)"
    mcp "(Il compte [emm] et a déjà inclus Amanda et Eva dans le nombre de ses petites-filles.)"

# game/scripts/c19/c19.rpy:2683
translate french c19s005_Meemaw_c62b6c41:

    # mee "*Susurrando* Soy de otra época... a mí no me parecen bien esas cosas modernas de que no hay que tratar a una mujer como se nos debe tratar."
    mee "*Chuchotant* Je viens d'une autre époque… Je ne suis pas d'accord avec ces idées modernes selon lesquelles on ne traiterait pas les femmes comme elles le méritent."

# game/scripts/c19/c19.rpy:2684
translate french c19s005_Meemaw_ee7aa80f:

    # mee "*Susurrando* No sabes lo cachonda que me pone que un hombre tome las riendas como estás haciendo tú."
    mee "*Chuchotant* Tu n'imagines pas à quel point je suis excitée quand un homme prend les rênes comme tu le fais."

# game/scripts/c19/c19.rpy:2685
translate french c19s005_Meemaw_f1551ae2:

    # mc "¡Ese lenguaje, Señorita!"
    mc "Ce langage, Mademoiselle !"

# game/scripts/c19/c19.rpy:2687
translate french c19s005_Meemaw_8148164b:

    # mee "*Risa* ¿Te importa mi lenguaje después de haberme hecho correr esta mañana como si fuera una cascada?"
    mee "*Rires* Est-ce que tu te soucies de mon langage après m'avoir fait courir comme une cascade ce matin ?"

# game/scripts/c19/c19.rpy:2688
translate french c19s005_Meemaw_781d6a5f:

    # mc "*Risa* Para nada, pero siempre ha sido una frase que he querido decirte. Es mi pequeña venganza por las veces que me la dijiste tú."
    mc "*Rires* Pas du tout, mais c'est une phrase que j'ai toujours voulu te dire. C'est ma petite vengeance pour toutes les fois où tu me l'as dite."

# game/scripts/c19/c19.rpy:2689
translate french c19s005_Meemaw_df143f0c:

    # mee "¡Es verdad, tienes razón! *Risa* Eras muy malhablado de pequeño."
    mee "C'est vrai, tu as raison ! *Rires* Tu avais un langage vraiment grossier quand tu étais petit."

# game/scripts/c19/c19.rpy:2691
translate french c19s005_Meemaw_aa448dff:

    # mee "Voy a ir a lavarme... la leche se está poniendo pegajosa... y está a punto de empezar a salir más."
    mee "Je vais faire la vaisselle... le lait devient collant... et il va y en avoir encore plus qui coule."

# game/scripts/c19/c19.rpy:2692
translate french c19s005_Meemaw_df621ff2:

    # mc "Vale. Te veo luego."
    mc "D'accord. À plus tard."

# game/scripts/c19/c19.rpy:2694
translate french c19s005_Meemaw_636f08d7:

    # mc "Una cosa más, Meemaw."
    mc "Encore une chose, Meemaw."

# game/scripts/c19/c19.rpy:2696
translate french c19s005_Meemaw_2057f40e:

    # mee "Dime."
    mee "Dites-moi."

# game/scripts/c19/c19.rpy:2697
translate french c19s005_Meemaw_64d3f913:

    # mc "Cuando confieses que estamos saliendo..."
    mc "Quand tu avoues qu'on sort ensemble..."

# game/scripts/c19/c19.rpy:2698
translate french c19s005_Meemaw_f8fa70e0:

    # mee "Si. No cuando..."
    mee "Oui. Pas quand..."

# game/scripts/c19/c19.rpy:2699
translate french c19s005_Meemaw_2cccb597:

    # mc "Cuando confieses que estamos saliendo, también tendrás que confesar que me has dado la razón TRES veces el mismo día. Lo acabas de volver a hacer."
    mc "Quand tu avoueras qu'on sort ensemble, tu devras aussi avouer que tu as été d'accord avec moi TROIS fois aujourd'hui. Tu viens de le refaire."

# game/scripts/c19/c19.rpy:2701
translate french c19s005_Meemaw_e5642601:

    # mee "*Risa* Confesar que salgo contigo, si al final lo hago... vale."
    mee "*Rires* Avouer que je sors avec toi, si je finis par le faire... d'accord."

# game/scripts/c19/c19.rpy:2702
translate french c19s005_Meemaw_f90087f5:

    # mee "Confesar que te he dado la razón... NUNCA. *Risa*"
    mee "Avoue que j'ai déjà été d'accord avec toi... JAMAIS. *Rires*"

# game/scripts/c19/c19.rpy:2703
translate french c19s005_Meemaw_0ab74392:

    # mee "Te veo luego, cariño. Si no me voy ya, voy a tener que besarte, y no como un saludo."
    mee "À plus tard, chérie. Si je ne pars pas maintenant, je vais devoir t'embrasser, et pas seulement pour te saluer."

# game/scripts/c19/c19.rpy:2704
translate french c19s005_Meemaw_bc229371:

    # mc "Hasta luego, Meemaw."
    mc "Au revoir, grand-mère."

# game/scripts/c19/c19.rpy:2706
translate french c19s005_Meemaw_bc8fe434:

    # mcp "(Ha ido mejor de lo que esperaba cuando ha salido la conversación. Por un momento he pensado que se iba a negar en redondo.)"
    mcp "(La conversation s'est mieux passée que prévu. Pendant un instant, j'ai cru qu'elle allait refuser catégoriquement.)"

# game/scripts/c19/c19.rpy:2752
translate french c19s005_Kiara_07c96ce4:

    # "Ves que Kiara se ha quedado sola. Es tu momento de hablar con ella otra vez sobre sus razones para evitarte."
    "Vous constatez que Kiara est seule. C'est le moment idéal pour lui reparler et lui demander pourquoi elle vous évite."

# game/scripts/c19/c19.rpy:2754
translate french c19s005_Kiara_8d5528f4:

    # "Te lanzas a la piscina y buceas hasta donde está Kiara. Si no te ve llegar no podrá huir."
    "Tu sautes dans la piscine et plonges jusqu'à Kiara. Si elle ne te voit pas arriver, elle ne pourra pas s'échapper."

# game/scripts/c19/c19.rpy:2757
translate french c19s005_Kiara_caa910bc:

    # kia "¡[mc]!"
    kia "[mc]!"

# game/scripts/c19/c19.rpy:2758
translate french c19s005_Kiara_2c2d1726:

    # "Tu objetivo era que no tuviera la oportunidad de huir, pero consigues sobresaltarla sin pretenderlo."
    "Votre objectif était de l'empêcher de s'échapper, mais vous l'avez involontairement effrayée."

# game/scripts/c19/c19.rpy:2761
translate french c19s005_Kiara_41854e1e:

    # kia "Me has asustado. Estaba... ausente."
    kia "Tu m'as fait peur. J'étais... distrait(e)."

# game/scripts/c19/c19.rpy:2762
translate french c19s005_Kiara_273db28f:

    # mc "Lo siento, Kiara. No era mi intención."
    mc "Je suis désolée, Kiara. Je ne l'ai pas fait exprès."

# game/scripts/c19/c19.rpy:2763
translate french c19s005_Kiara_b6d81fd7:

    # mc "¿Qué tal lo estás pasando?"
    mc "Comment allez-vous?"

# game/scripts/c19/c19.rpy:2765
translate french c19s005_Kiara_391e6771:

    # kia "Ya te lo he dicho antes. Eileen me había hablado de vuestras fiestas, pero esto es más grande de lo que me imaginaba."
    kia "Je vous l'ai déjà dit. Eileen m'avait parlé de vos fêtes, mais c'est bien plus important que je ne l'imaginais."

# game/scripts/c19/c19.rpy:2766
translate french c19s005_Kiara_3b9fe803:

    # "Su tono intenta ser cortante pero educado. Tan solo consigue sonar triste."
    "Son ton se veut concis mais poli. Il a juste l'air triste."

# game/scripts/c19/c19.rpy:2767
translate french c19s005_Kiara_36b7c2b2:

    # mc "Bueno, este año somos más gente de lo que hemos sido nunca. Para nosotros también es más grande."
    mc "Eh bien, cette année, nous sommes plus nombreux que jamais. C'est plus important pour nous aussi."

# game/scripts/c19/c19.rpy:2768
translate french c19s005_Kiara_35ebcd10:

    # mc "Vosotras, las chicas nuevas, hacéis que este año sea diferente. Mejor. Mucho mejor."
    mc "Vous, les nouvelles, rendez cette année différente. Meilleure. Bien meilleure."

# game/scripts/c19/c19.rpy:2770
translate french c19s005_Kiara_03ccecb8:

    # kia "*Risa triste* Creo que hace 20 años que nadie me llamaba \"chica\"."
    kia "*Rire triste* Je crois que ça fait 20 ans que personne ne m'a appelée « fille »."

# game/scripts/c19/c19.rpy:2771
translate french c19s005_Kiara_b344e1ce:

    # mc "*Risa* Es difícil hablar de un grupo tan grande sin generalizar. Para Meemaw todas sois \"las chicas\". A veces incluso Tía Betty."
    mc "*Rires* C'est difficile de parler d'un groupe aussi important sans généraliser. Pour Mémé, vous êtes toutes « les filles ». Parfois même pour Tante Betty."

# game/scripts/c19/c19.rpy:2772
translate french c19s005_Kiara_b5b742fd:

    # mc "Para mí también."
    mc "Moi aussi."

# game/scripts/c19/c19.rpy:2774
translate french c19s005_Kiara_90048c1a:

    # kia "Te debes sentir como el gallo en un gallinero."
    kia "Vous devez vous sentir comme le coq dans le poulailler."

# game/scripts/c19/c19.rpy:2776
translate french c19s005_Kiara_102a91ba:

    # kia "Con varias gallinas para ti..."
    kia "Avec plusieurs poules pour vous..."

# game/scripts/c19/c19.rpy:2777
translate french c19s005_Kiara_ba2375ad:

    # mc "Para nada, Kiara. Me siento afortunado de estar aquí, de teneros a todas cerca."
    mc "Pas du tout, Kiara. Je me sens chanceuse d'être ici, de vous avoir toutes près de moi."

# game/scripts/c19/c19.rpy:2779
translate french c19s005_Kiara_3c494dd6:

    # kia "Creo que te voy a dejar, si no te importa. Están jugando a algo en el jacuzzi y quiero ir a ver a qué."
    kia "Je crois que je vais vous laisser, si ça ne vous dérange pas. Ils passent un truc dans le jacuzzi et j'aimerais bien aller voir ce que c'est."

# game/scripts/c19/c19.rpy:2780
translate french c19s005_Kiara_156630f4:

    # mc "Y sigues evitándome."
    mc "Et tu continues de m'éviter."

# game/scripts/c19/c19.rpy:2782
translate french c19s005_Kiara_a1f689e4:

    # kia "¿Qué? No..."
    kia "Non..."

# game/scripts/c19/c19.rpy:2783
translate french c19s005_Kiara_8f23f75d:

    # mc "Kiara, engáñate a ti misma si quieres, pero no niegues lo evidente."
    mc "Kiara, trompe-toi si tu veux, mais ne nie pas l'évidence."

# game/scripts/c19/c19.rpy:2784
translate french c19s005_Kiara_c1ed017b:

    # mc "Desde que estuvimos en tu casa, cada vez que he intentado hablar contigo a solas hemos intercambiado cinco o seis frases y has salido corriendo."
    mc "Depuis que nous étions chez toi, chaque fois que j'ai essayé de te parler seul, nous avons échangé cinq ou six phrases et tu t'es enfui."

# game/scripts/c19/c19.rpy:2786
translate french c19s005_Kiara_f44decf9:

    # kia "Nunca he salido corriendo..."
    kia "Je ne me suis jamais enfui..."

# game/scripts/c19/c19.rpy:2787
translate french c19s005_Kiara_207548e5:

    # mc "Lo hiciste en la cena de anteayer y lo estás volviendo a hacer ahora."
    mc "Tu l'as fait avant-hier soir au dîner et tu recommences maintenant."

# game/scripts/c19/c19.rpy:2789
translate french c19s005_Kiara_25f2ae9f:

    # kia "Es que... lo pones muy difícil..."
    kia "Vous me compliquez vraiment la tâche..."

# game/scripts/c19/c19.rpy:2790
translate french c19s005_Kiara_683715e2:

    # mc "No entiendo qué es lo que pongo difícil, Kiara."
    mc "Je ne comprends pas ce que je complique, Kiara."

# game/scripts/c19/c19.rpy:2793
translate french c19s005_Kiara_c0bbf255:

    # kia "Sales con mi hija..."
    kia "Tu sors avec ma fille..."

# game/scripts/c19/c19.rpy:2795
translate french c19s005_Kiara_14fe3b34:

    # kia "Y no sólo con ella..."
    kia "Et pas seulement avec elle..."

# game/scripts/c19/c19.rpy:2797
translate french c19s005_Kiara_2e22e1e2:

    # kia "Alguna cercana a mi edad..."
    kia "Quelqu'un de mon âge..."

# game/scripts/c19/c19.rpy:2799
translate french c19s005_Kiara_cd4bd1cb:

    # kia "Sales con más de una mujer..."
    kia "Tu sors avec plus d'une femme..."

# game/scripts/c19/c19.rpy:2801
translate french c19s005_Kiara_2e22e1e2_1:

    # kia "Alguna cercana a mi edad..."
    kia "Quelqu'un de mon âge..."

# game/scripts/c19/c19.rpy:2803
translate french c19s005_Kiara_67539b1b:

    # kia "Sales con una mujer cercana a mi edad..."
    kia "Tu sors avec une femme qui a à peu près mon âge..."

# game/scripts/c19/c19.rpy:2805
translate french c19s005_Kiara_4dfd91f7:

    # kia "Estás saliendo con alguien..."
    kia "Est-ce que tu sors avec quelqu'un..."

# game/scripts/c19/c19.rpy:2807
translate french c19s005_Kiara_9d8cf43c:

    # kia "Eres como el soltero de oro..."
    kia "Tu es le célibataire le plus convoité..."

# game/scripts/c19/c19.rpy:2808
translate french c19s005_Kiara_78c902a2:

    # mc "No entiendo qué tiene que ver eso con que me rehúyas."
    mc "Je ne comprends pas ce que cela a à voir avec le fait que tu m'évites."

# game/scripts/c19/c19.rpy:2809
translate french c19s005_Kiara_05c13bee:

    # mc "Me parece que, de alguna forma, te sientes atraída por mí. Pero, por alguna razón que no entiendo, no quieres hablarlo..."
    mc "Je crois que je vous attire d'une certaine façon. Mais pour une raison que j'ignore, vous ne voulez pas en parler…"

# game/scripts/c19/c19.rpy:2811
translate french c19s005_Kiara_d682e018:

    # kia "[mc], mi familia es como un castillo en ruinas."
    kia "[mc], ma famille est comme un château en ruines."

# game/scripts/c19/c19.rpy:2812
translate french c19s005_Kiara_600ddba0:

    # mcp "(No ha negado que se sienta atraída por mí. Tía Betty tenía razón.)"
    mcp "(Elle n'a pas nié être attirée par moi. Tante Betty avait raison.)"

# game/scripts/c19/c19.rpy:2813
translate french c19s005_Kiara_2b213eb0:

    # kia "Mi marido se ha pasado años socavando los cimientos. Mi hija tan solo quiere demolerlo."
    kia "Mon mari a passé des années à saper les fondations. Ma fille veut juste la démolir."

# game/scripts/c19/c19.rpy:2814
translate french c19s005_Kiara_c7a0a5b1:

    # kia "Soy la única que aún... hasta el otro día, cuando te enfrentaste a Solomon... estaba empeñada en hacer obras para evitar que se derrumbara del todo."
    kia "J'étais le seul qui, jusqu'à l'autre jour, lorsque vous avez confronté Salomon, était encore déterminé à œuvrer pour empêcher son effondrement total."

# game/scripts/c19/c19.rpy:2815
translate french c19s005_Kiara_52492523:

    # mc "¿Ya no?"
    mc "Pas plus?"

# game/scripts/c19/c19.rpy:2817
translate french c19s005_Kiara_ce1f7849:

    # kia "Reparar ese castillo... que ha dejado de servir para protegernos..."
    kia "Réparez ce château... qui ne nous protège plus..."

# game/scripts/c19/c19.rpy:2818
translate french c19s005_Kiara_094c58d5:

    # kia "Un castillo que se ha convertido tan solo en una prisión..."
    kia "Un château devenu une simple prison..."

# game/scripts/c19/c19.rpy:2820
translate french c19s005_Kiara_c761da29:

    # kia "No, ya no."
    kia "Non, plus maintenant."

# game/scripts/c19/c19.rpy:2821
translate french c19s005_Kiara_d22c428d:

    # kia "Que Solomon quisiera pegarte, cuando lo único que hacías era ayudarme, fue la gota que colmó el vaso."
    kia "Le fait que Salomon ait voulu te frapper, alors que tu ne faisais que m'aider, a été la goutte d'eau qui a fait déborder le vase."

# game/scripts/c19/c19.rpy:2822
translate french c19s005_Kiara_1646283b:

    # mc "Y me culpas por ello. Lo entiendo."
    mc "Et vous me le reprochez. Je comprends."

# game/scripts/c19/c19.rpy:2824
translate french c19s005_Kiara_32deec70:

    # kia "No, no te culpo por ello."
    kia "Non, je ne vous en tiens pas rigueur."

# game/scripts/c19/c19.rpy:2825
translate french c19s005_Kiara_f92c920a:

    # kia "Tú tan solo me has enseñado que un castillo no tiene por qué ser opresivo. Que puede guardar cosas hermosas en su interior."
    kia "Vous m'avez simplement appris qu'un château n'est pas forcément oppressant, qu'il peut abriter de belles choses."

# game/scripts/c19/c19.rpy:2826
translate french c19s005_Kiara_c1f7737f:

    # mc "¿Por eso me evitas? Ahora es cuando no entiendo nada."
    mc "C'est pour ça que tu m'évites ? Maintenant, je ne comprends plus rien."

# game/scripts/c19/c19.rpy:2828
translate french c19s005_Kiara_45638f5c:

    # kia "Aquí tenéis un castillo precioso. Pero también es un palacio. Nadie es prisionero en su propia casa."
    kia "Voici un magnifique château. Mais c'est aussi un palais. Nul n'est prisonnier chez soi."

# game/scripts/c19/c19.rpy:2829
translate french c19s005_Kiara_ddca5414:

    # mc "Sigo sin entender qué tiene que ver eso con que me evites."
    mc "Je ne comprends toujours pas ce que cela a à voir avec le fait que tu m'évites."

# game/scripts/c19/c19.rpy:2831
translate french c19s005_Kiara_47d2b49b:

    # kia "No sé si es agradecimiento o algo más, pero cada vez que hablo contigo pienso que la vida puede ser diferente de lo que he vivido con Solomon."
    kia "Je ne sais pas si c'est de la gratitude ou quelque chose de plus profond, mais chaque fois que je te parle, je me dis que la vie peut être différente de ce que j'ai vécu avec Solomon."

# game/scripts/c19/c19.rpy:2834
translate french c19s005_Kiara_ecdc1086:

    # kia "Pero ya estás con mi hija... "
    kia "Mais tu es déjà avec ma fille..."

# game/scripts/c19/c19.rpy:2836
translate french c19s005_Kiara_d4651e69:

    # kia "Pero ya estás con alguien. Una mujer a la que aprecio... Además saliste con mi hija y al volver de la universidad no habéis vuelto juntos."
    kia "Mais tu es déjà avec quelqu'un. Une femme qui compte pour moi… De plus, tu es sorti avec ma fille, et vous ne vous êtes pas remis ensemble à son retour de l'université."

# game/scripts/c19/c19.rpy:2839
translate french c19s005_Kiara_ff4d60c8:

    # kia "Pero estás con más de una mujer. Una de ellas mi hija..."
    kia "Mais tu es avec plusieurs femmes. L'une d'elles est ma fille..."

# game/scripts/c19/c19.rpy:2841
translate french c19s005_Kiara_9d5c9c27:

    # kia "Pero estás con más de una mujer. Y pese a todo no has vuelto con mi hija después de volver de la universidad."
    kia "Mais tu vois plus d'une femme. Et malgré tout ça, tu n'es pas revenu voir ma fille depuis ton retour de l'université."

# game/scripts/c19/c19.rpy:2843
translate french c19s005_Kiara_022dd757:

    # kia "Pero saliste con mi hija. Y cuando has vuelto de la universidad no has querido volver con ella."
    kia "Mais tu as fréquenté ma fille. Et quand tu es revenu de l'université, tu n'as pas voulu te remettre avec elle."

# game/scripts/c19/c19.rpy:2844
translate french c19s005_Kiara_2c060141:

    # kia "No puedo ni siquiera pensar en cómo se sentiría si tú y yo... No. No puedo hacerle eso. Ni siquiera planteármelo."
    kia "Je n'ose même pas imaginer ce qu'elle ressentirait si toi et moi… Non. Je ne peux pas lui faire ça. Je ne peux même pas y penser."

# game/scripts/c19/c19.rpy:2845
translate french c19s005_Kiara_85297243:

    # mc "Si tú y yo... ¿Qué, Kiara?"
    mc "Si toi et moi... Quoi, Kiara ?"

# game/scripts/c19/c19.rpy:2846
translate french c19s005_Kiara_52fc8bfa:

    # mcp "(Dilo, Kiara. Aclara las cosas y borra esta barrera que nos está separando.)"
    mcp "(Dis-le, Kiara. Mets les choses au clair et brise cette barrière qui nous sépare.)"

# game/scripts/c19/c19.rpy:2848
translate french c19s005_Kiara_6f6095b4:

    # kia "Nada... no es posible, con lo que no vale la pena ni siquiera hablarlo."
    kia "Rien… c’est impossible, donc ça ne vaut même pas la peine d’en parler."

# game/scripts/c19/c19.rpy:2849
translate french c19s005_Kiara_9ed7ad67:

    # kia "Mañana es el cumpleaños... el de verdad... de [eri] y [dap]. No quiero fastidiárselo. Pero mañana mismo empezaré a buscar algún sitio a donde mudarme."
    kia "Demain, c'est l'anniversaire de [eri] et [dap]... leur vrai anniversaire. Je ne veux pas leur gâcher la surprise. Mais je commencerai à chercher un logement demain."

# game/scripts/c19/c19.rpy:2850
translate french c19s005_Kiara_6d4a8883:

    # mc "¿Por qué? ¿Qué es tan importante como para querer irte de un sitio en el que estás a gusto y donde todo el mundo te quiere?"
    mc "Pourquoi ? Qu'est-ce qui pourrait être si important pour que vous vouliez quitter un endroit où vous vous sentez bien et où tout le monde vous aime ?"

# game/scripts/c19/c19.rpy:2852
translate french c19s005_Kiara_ca2e8356:

    # kia "No sé si es que no lo estás entendiendo, si tienes un ego tan enorme que me lo quieres oír decir, o si quieres que lo diga para evitar malentendidos."
    kia "Je ne sais pas si vous ne comprenez pas, si vous avez un ego tellement démesuré que vous voulez m'entendre le dire, ou si vous voulez que je le dise pour éviter tout malentendu."

# game/scripts/c19/c19.rpy:2853
translate french c19s005_Kiara_830d976e:

    # mc "Puede haber más razones para querer oírtelo decir."
    mc "Il y a peut-être d'autres raisons de vouloir vous entendre le dire."

# game/scripts/c19/c19.rpy:2854
translate french c19s005_Kiara_9a8dbc47:

    # mc "Quizás para poder rebatir tu idea de marcharte."
    mc "Peut-être pourrons-nous ainsi réfuter votre idée de départ."

# game/scripts/c19/c19.rpy:2856
translate french c19s005_Kiara_cc5662f9:

    # kia "No vas a lograr convencerme..."
    kia "Vous ne me convaincrez pas..."

# game/scripts/c19/c19.rpy:2857
translate french c19s005_Kiara_2ce614d9:

    # mc "Dime tus razones para irte y yo te expondré mis argumentos para que te quedes."
    mc "Dites-moi pourquoi vous partez et je vous expliquerai mes arguments pour que vous restiez."

# game/scripts/c19/c19.rpy:2858
translate french c19s005_Kiara_093b0f53:

    # mc "Si no te puedo hacer cambiar de opinión, no volveré a insistir."
    mc "Si je ne parviens pas à vous faire changer d'avis, je n'insisterai plus."

# game/scripts/c19/c19.rpy:2860
translate french c19s005_Kiara_f8804faf:

    # kia "¡Vale! Vas a conseguir que me avergüence a mí misma como una colegiala, pero si es lo que quieres..."
    kia "D'accord ! Tu vas me faire passer pour une gamine, mais si c'est ce que tu veux..."

# game/scripts/c19/c19.rpy:2862
translate french c19s005_Kiara_c9ea3afc:

    # kia "¿Sabes lo que sentí el otro día? ¿Cuándo me defendiste delante de Solomon?"
    kia "Sais-tu ce que j'ai ressenti l'autre jour ? Quand tu m'as défendu devant Salomon ?"

# game/scripts/c19/c19.rpy:2863
translate french c19s005_Kiara_f52b80de:

    # mc "Me lo puedo imaginar. Te sentiste protegida."
    mc "Je peux l'imaginer. Vous vous sentiez protégé(e)."

# game/scripts/c19/c19.rpy:2865
translate french c19s005_Kiara_42360f8c:

    # kia "Como no me había sentido nunca..."
    kia "Je n'avais jamais rien ressenti de tel auparavant..."

# game/scripts/c19/c19.rpy:2867
translate french c19s005_Kiara_06ad52c3:

    # kia "Esto no lo sabe nadie, pero hace unos años, fuimos a San Francisco para nuestro aniversario a pasar un fin de semana."
    kia "Personne ne le sait, mais il y a quelques années, nous sommes allés à San Francisco pour fêter notre anniversaire, pour y passer un week-end."

# game/scripts/c19/c19.rpy:2868
translate french c19s005_Kiara_ddc24f51:

    # kia "Nos perdimos y acabamos en un sitio sospechoso. Un tipo nos intentó atracar."
    kia "Nous nous sommes perdus et avons fini dans un endroit suspect. Un type a essayé de nous voler."

# game/scripts/c19/c19.rpy:2869
translate french c19s005_Kiara_656b5e8a:

    # kia "¿Sabes lo que hizo Solomon?"
    kia "Sais-tu ce qu'a fait Salomon ?"

# game/scripts/c19/c19.rpy:2870
translate french c19s005_Kiara_6107583b:

    # mc "Supongo que nada. Darle el dinero. Y entonces llegó la policía."
    mc "Je suppose que rien. Donnez-lui juste l'argent. Et puis la police est arrivée."

# game/scripts/c19/c19.rpy:2872
translate french c19s005_Kiara_18924225:

    # kia "¿Qué? ¿Cómo sabes lo de la policía? Nunca se lo contamos a Eileen..."
    kia "Quoi ? Comment connais-tu la police ? Nous ne l'avons jamais dit à Eileen…"

# game/scripts/c19/c19.rpy:2873
translate french c19s005_Kiara_433b7cee:

    # mc "Has dicho que el tipo intentó atracaros, no que os atracara. He supuesto que, después de que Solomon le diera el dinero, llegó la policía."
    mc "Vous avez dit que l'homme avait tenté de vous voler, pas qu'il vous avait volé. J'ai supposé que la police était arrivée après que Solomon lui eut donné l'argent."

# game/scripts/c19/c19.rpy:2875
translate french c19s005_Kiara_c11a7aaf:

    # kia "Casi has acertado. No le dio el dinero. Me dijo \"corre\" y empezó a correr él también."
    kia "Tu avais presque raison. Il ne lui a pas donné l'argent. Il m'a dit de « courir » et il s'est mis à courir lui aussi."

# game/scripts/c19/c19.rpy:2876
translate french c19s005_Kiara_ca58b031:

    # kia "Sin mirar atrás. Sin comprobar si le seguía."
    kia "Sans se retourner. Sans vérifier s'il la suivait."

# game/scripts/c19/c19.rpy:2878
translate french c19s005_Kiara_454935c8:

    # mc "¡Qué hijo de puta!"
    mc "Quel fils de pute !"

# game/scripts/c19/c19.rpy:2879
translate french c19s005_Kiara_3fae328f:

    # kia "Corrimos durante dos manzanas. Solomon cada vez más lejos. El atracador cada vez más cerca. Yo gritando, pidiendo ayuda."
    kia "Nous avons couru sur deux pâtés de maisons. Solomon s'éloignait de plus en plus. L'agresseur se rapprochait de plus en plus. Je criais, implorant de l'aide."

# game/scripts/c19/c19.rpy:2881
translate french c19s005_Kiara_3f6420e1:

    # kia "Y me topé de bruces con dos policías. Solomon había pasado corriendo por su lado sin pararse."
    kia "Et je me suis retrouvé nez à nez avec deux policiers. Solomon les avait dépassés en courant sans s'arrêter."

# game/scripts/c19/c19.rpy:2883
translate french c19s005_Kiara_3db11475:

    # mc "Y el atracador desapareció. Y el hijo de puta de tu marido también."
    mc "Et le voleur a disparu. Et ton fils de pute de mari a disparu lui aussi."

# game/scripts/c19/c19.rpy:2885
translate french c19s005_Kiara_e4c3f2f1:

    # kia "Exacto. Llegó corriendo al hotel. Estaba a cinco o seis manzanas de donde encontré a los policías."
    kia "Exactement. Il est arrivé en courant à l'hôtel. Il se trouvait à cinq ou six pâtés de maisons de l'endroit où j'ai trouvé les policiers."

# game/scripts/c19/c19.rpy:2886
translate french c19s005_Kiara_348a690d:

    # kia "Sólo entonces se le ocurrió mirar atrás y descubrió que no estaba. Me llamó al móvil... para ver si estaba bien."
    kia "C’est alors seulement qu’il a pensé à se retourner et s’est rendu compte que je n’étais plus là. Il m’a appelée sur mon portable… pour savoir si j’allais bien."

# game/scripts/c19/c19.rpy:2887
translate french c19s005_Kiara_ce1483e1:

    # mc "No sé cómo no le pediste el divorcio en ese mismo momento."
    mc "Je ne comprends pas pourquoi vous n'avez pas demandé le divorce sur-le-champ."

# game/scripts/c19/c19.rpy:2889
translate french c19s005_Kiara_757196fc:

    # kia "Eileen tenía siete años, [mc]. Yo no tenía trabajo y Solomon aún no bebía como hizo tiempo después."
    kia "Eileen avait sept ans, [mc]. Je n'avais pas de travail et Solomon ne buvait pas encore comme il le ferait plus tard."

# game/scripts/c19/c19.rpy:2890
translate french c19s005_Kiara_3ac895a6:

    # kia "Le hubieran concedido la custodia a él. Hubiera perdido a mi hija. Ya me había amenazado con eso..."
    kia "Ils lui auraient accordé la garde. J'aurais perdu ma fille. Il m'avait déjà menacée de cela…"

# game/scripts/c19/c19.rpy:2891
translate french c19s005_Kiara_111b30e7:

    # mc "¿Qué? ¿Cuándo?"
    mc "Quoi ? Quand ?"

# game/scripts/c19/c19.rpy:2893
translate french c19s005_Kiara_f1630e7f:

    # kia "Unos meses después de que naciera Eileen. Cuando empecé a ver a mis amigas de nuevo. Me dijo que ya era una mujer con una hija."
    kia "Quelques mois après la naissance d'Eileen, lorsque j'ai recommencé à revoir mes amis, elle m'a dit que j'étais désormais une femme avec une fille."

# game/scripts/c19/c19.rpy:2895
translate french c19s005_Kiara_924f253f:

    # kia "Que mi lugar estaba en casa con mi hija, no paseando a la niña y quedando con mis amigas. Si le tenía que dar el sol, teníamos un jardín."
    kia "Ma place était à la maison avec ma fille, pas en promenade avec elle ni en retrouvailles avec mes amis. Si elle avait besoin de soleil, nous avions un jardin."

# game/scripts/c19/c19.rpy:2896
translate french c19s005_Kiara_b6b9daed:

    # kia "Que si no quería comportarme como una mujer casada, pediría el divorcio y se quedaría con la niña porque yo no la podía mantener."
    kia "Il a dit que si je ne voulais pas me comporter comme une femme mariée, il demanderait le divorce et garderait la fille car je ne pourrais pas subvenir à ses besoins."

# game/scripts/c19/c19.rpy:2898
translate french c19s005_Kiara_3f529544:

    # mc "Me estoy arrepintiendo de no haberle pegado el jueves."
    mc "Je regrette de ne pas l'avoir frappé jeudi."

# game/scripts/c19/c19.rpy:2900
translate french c19s005_Kiara_7a917878:

    # kia "No tienes que rebajarte a su altura..."
    kia "Vous n'avez pas à vous abaisser à leur niveau..."

# game/scripts/c19/c19.rpy:2901
translate french c19s005_Kiara_a4c31c35:

    # kia "Pero volviendo a San Francisco... Volví al hotel con los policías. No había denuncia que presentar. Por mi vida no podría recordar el aspecto del atracador."
    kia "Mais revenons à San Francisco… Je suis retourné à l’hôtel avec la police. Il n’y avait pas de rapport à déposer. Je ne me souvenais plus à quoi ressemblait le voleur, si je l’avais vu."

# game/scripts/c19/c19.rpy:2902
translate french c19s005_Kiara_3af2f1b2:

    # kia "Y cuando llegué, ¿sabes qué pasó?"
    kia "Et quand je suis arrivé, savez-vous ce qui s'est passé ?"

# game/scripts/c19/c19.rpy:2903
translate french c19s005_Kiara_92519760:

    # mc "Me puedo llegar a imaginar cualquier cosa. Espero que no te pegara encima de haberte dejado sola."
    mc "Je peux tout imaginer. J'espère qu'il ne t'a pas frappée en plus de te laisser seule."

# game/scripts/c19/c19.rpy:2905
translate french c19s005_Kiara_1f44fd04:

    # kia "No, por entonces aún no se emborrachaba y no era violento. Pero estaba enfadado."
    kia "Non, à cette époque, il ne s'enivrait pas et il n'était pas violent. Mais il était en colère."

# game/scripts/c19/c19.rpy:2906
translate french c19s005_Kiara_e81d91e4:

    # kia "Se había puesto nervioso al ver que yo no llegaba al hotel. Estaba enfadado porque yo lo había dejado solo. Porque no había corrido lo suficiente."
    kia "Il s'est inquiété en voyant que je n'étais pas arrivée à l'hôtel. Il était en colère parce que je l'avais laissé seul. Parce que je n'avais pas couru assez vite."

# game/scripts/c19/c19.rpy:2908
translate french c19s005_Kiara_b1884c43:

    # kia "Empezó a gritarme... y se fue sin decirme a dónde."
    kia "Il s'est mis à me crier dessus... et il est parti sans me dire où il allait."

# game/scripts/c19/c19.rpy:2909
translate french c19s005_Kiara_3b3b52d4:

    # kia "En nuestro aniversario cenó él solo en el restaurante que había reservado para nosotros y después fue de bar en bar hasta que volvió al hotel."
    kia "Pour notre anniversaire, il a dîné seul au restaurant qu'il avait réservé pour nous, puis il est allé de bar en bar jusqu'à son retour à l'hôtel."

# game/scripts/c19/c19.rpy:2911
translate french c19s005_Kiara_ba1d6dc1:

    # kia "Mientras tanto, yo estaba en la habitación sin saber si volvería o cuándo lo haría."
    kia "Pendant ce temps, je restais dans la pièce sans savoir si je reviendrais, ni quand."

# game/scripts/c19/c19.rpy:2913
translate french c19s005_Kiara_61e563a9:

    # mc "¡Es increíble!"
    mc "C'est incroyable !"

# game/scripts/c19/c19.rpy:2915
translate french c19s005_Kiara_c41de8f0:

    # kia "Y catorce años después, por fin tuvo el valor de encararse con un hombre. Y fue el hombre equivocado."
    kia "Quatorze ans plus tard, elle a enfin eu le courage d'affronter un homme. Et c'était le mauvais homme."

# game/scripts/c19/c19.rpy:2916
translate french c19s005_Kiara_d8af1d8b:

    # kia "No estabas haciendo nada malo. Nos estabas ayudando a recoger nuestras cosas. Y quiso pegarte."
    kia "Tu n'avais rien fait de mal. Tu nous aidais à ramasser nos affaires. Et il a essayé de te frapper."

# game/scripts/c19/c19.rpy:2917
translate french c19s005_Kiara_9e3c4220:

    # mc "Estaba muy borracho."
    mc "Il était ivre mort."

# game/scripts/c19/c19.rpy:2919
translate french c19s005_Kiara_da697a61:

    # kia "Podrías haberte apartado. Decir que no era tu problema. Salir corriendo..."
    kia "Tu aurais pu partir. Dire que ce n'était pas ton problème. Fuir…"

# game/scripts/c19/c19.rpy:2920
translate french c19s005_Kiara_168be713:

    # kia "Pero no lo hiciste. Me defendiste como no lo hizo mi marido cuando tuvo la oportunidad."
    kia "Mais vous, vous ne l'avez pas fait. Vous m'avez défendue comme mon mari ne l'a pas fait quand il en a eu l'occasion."

# game/scripts/c19/c19.rpy:2922
translate french c19s005_Kiara_d818f7ba:

    # kia "Nos diste un techo cuando más lo necesitábamos. Cuando no teníamos a donde ir."
    kia "Vous nous avez offert un toit au-dessus de nos têtes quand nous en avions le plus besoin. Quand nous n'avions nulle part où aller."

# game/scripts/c19/c19.rpy:2923
translate french c19s005_Kiara_1048259e:

    # kia "Incluso nos dejaste tu cama el día que llegamos y fuiste a dormir a un sofá."
    kia "Tu as même cédé ta place dans ton lit le jour de notre arrivée et tu as dormi sur un canapé."

# game/scripts/c19/c19.rpy:2924
translate french c19s005_Kiara_8c75bb40:

    # mc "Es lo menos que podía hacer, ¿no?"
    mc "C'est bien le moins que je puisse faire, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:2926
translate french c19s005_Kiara_d6e12a48:

    # kia "No tenías que hacer nada. No tenías que cedernos tu cama. Ni pelearte con mi marido."
    kia "Tu n'avais rien à faire. Tu n'avais pas à céder ton lit. Ni à te disputer avec mon mari."

# game/scripts/c19/c19.rpy:2927
translate french c19s005_Kiara_20e185dc:

    # kia "No tenías ninguna obligación."
    kia "Vous n'aviez aucune obligation."

# game/scripts/c19/c19.rpy:2928
translate french c19s005_Kiara_bf0c59d8:

    # mc "Sí que la tenía, aunque sólo fuera por decencia humana."
    mc "Oui, je l'avais, ne serait-ce que par pure décence humaine."

# game/scripts/c19/c19.rpy:2929
translate french c19s005_Kiara_818942b0:

    # mc "Aunque hubiera hecho lo mismo sin esa obligación. Necesitabais mi ayuda y yo estaba ahí para prestárosla."
    mc "Même si j'aurais fait de même sans cette obligation, tu avais besoin de mon aide et j'étais là pour te l'apporter."

# game/scripts/c19/c19.rpy:2931
translate french c19s005_Kiara_35b1109c:

    # kia "A eso me refiero, [mc]. Mi marido salió corriendo en nuestro aniversario. Y un chico sin ninguna obligación lo dejó todo y se enfrentó a él por nosotras."
    kia "C'est exactement ce que je veux dire, [mc]. Mon mari est parti le jour de notre anniversaire. Et un homme libre de toute obligation a tout laissé tomber pour nous défendre."

# game/scripts/c19/c19.rpy:2932
translate french c19s005_Kiara_7a0746eb:

    # kia "Por mí."
    kia "Pour moi."

# game/scripts/c19/c19.rpy:2933
translate french c19s005_Kiara_59c00afe:

    # mc "No sé cómo lo estás viendo tú, pero yo cada vez lo veo peor como razón para querer irte."
    mc "Je ne sais pas ce que vous en pensez, mais pour moi, c'est une raison encore plus mauvaise de vouloir partir."

# game/scripts/c19/c19.rpy:2935
translate french c19s005_Kiara_ffcc8586:

    # kia "*Risa triste* No, esa es la razón que ha creado la razón para querer irme."
    kia "*Rire triste* Non, c'est justement cette raison qui a engendré l'envie de partir."

# game/scripts/c19/c19.rpy:2936
translate french c19s005_Kiara_73bd2b28:

    # kia "Después de sentirme tratada como un pedazo de mierda por mi marido durante años... llegas tú y me tratas como a una persona."
    kia "Après m'être sentie comme une merde par mon mari pendant des années... tu arrives et tu me traites comme une personne."

# game/scripts/c19/c19.rpy:2937
translate french c19s005_Kiara_347e7179:

    # kia "Me enseñas cómo funciona una familia. Me lo enseñáis entre todos."
    kia "Vous m'apprenez comment fonctionne une famille. Vous m'apprenez tous quelque chose."

# game/scripts/c19/c19.rpy:2938
translate french c19s005_Kiara_205ab6f1:

    # mc "Bueno, no se puede decir que seamos una familia ejemplar..."
    mc "Bon, on ne peut pas vraiment dire que nous sommes une famille modèle..."

# game/scripts/c19/c19.rpy:2940
translate french c19s005_Kiara_a46ab22c:

    # kia "No, pero todos os queréis y os protegéis. Todos os ayudáis. Y tú estás en todos sitios. Sólo había que verte durante la comida."
    kia "Non, mais vous vous aimez et vous vous protégez tous. Vous vous entraidez tous. Et vous êtes partout. Il suffisait de vous voir à midi."

# game/scripts/c19/c19.rpy:2941
translate french c19s005_Kiara_2f521a7e:

    # kia "¿Ha habido alguna chica con quién no hayas hablado hoy? ¿A alguien a quién hayas dejado de lado?"
    kia "Y a-t-il une fille à qui tu n'as pas parlé aujourd'hui ? Quelqu'un que tu as ignorée ?"

# game/scripts/c19/c19.rpy:2942
translate french c19s005_Kiara_88558e50:

    # mc "Creo que no... y si lo ha habido debería compensarla."
    mc "Je ne le crois pas... et si cela a été le cas, elle devrait être indemnisée."

# game/scripts/c19/c19.rpy:2944
translate french c19s005_Kiara_ab896e98:

    # kia "Pues todas esas cosas hacen que esté empezando a albergar sentimientos por ti que no deberían estar ahí."
    kia "Eh bien, tout ça me fait commencer à éprouver pour toi des sentiments qui ne devraient pas exister."

# game/scripts/c19/c19.rpy:2945
translate french c19s005_Kiara_caf7057f:

    # kia "Ya está. Ya lo he dicho."
    kia "Voilà. Je l'ai dit."

# game/scripts/c19/c19.rpy:2947
translate french c19s005_Kiara_e903a592:

    # kia "Por eso te he estado evitando. No quiero que esos sentimientos crezcan."
    kia "Voilà pourquoi je t'évite. Je ne veux pas que ces sentiments prennent de l'ampleur."

# game/scripts/c19/c19.rpy:2949
translate french c19s005_Kiara_db2f0b58:

    # kia "Con la relación que tienes con mi hija, no puedo permitirme enamorarme de ti y... Sencillamente, no puedo."
    kia "Vu la relation que vous avez avec ma fille, je ne peux pas me permettre de tomber amoureuse de vous et... je ne peux tout simplement pas."

# game/scripts/c19/c19.rpy:2951
translate french c19s005_Kiara_e977573d:

    # kia "Después de la relación que tuviste con mi hija... no puedo permitirme enamorarme de ti. ¿Cómo se sentiría después de que no hayas vuelto con ella?"
    kia "Après la relation que tu as eue avec ma fille… je ne peux pas me permettre de tomber amoureuse de toi. Comment se sentirait-elle si vous ne vous remettiez pas ensemble ?"

# game/scripts/c19/c19.rpy:2952
translate french c19s005_Kiara_8f240a7e:

    # mc "Y ¿cómo llevas lo de que los sentimientos no crezcan? Ya llevas tres días evitándome."
    mc "Et comment vis-tu le fait que tes sentiments ne se développent pas ? Tu m'évites depuis trois jours maintenant."

# game/scripts/c19/c19.rpy:2954
translate french c19s005_Kiara_82754d03:

    # kia "Fatal... Sólo espero que cuando me mude podamos seguir siendo amigos."
    kia "C'est terrible... J'espère juste que lorsque je déménagerai, nous pourrons encore être amis."

# game/scripts/c19/c19.rpy:2968
translate french c19s005_Kiara_d470a96f:

    # mc "Yo también estoy empezando a albergar sentimientos por ti. Pero en mi caso, no me avergüenzo de ellos."
    mc "Je commence aussi à éprouver des sentiments pour toi. Mais dans mon cas, je n'en ai pas honte."

# game/scripts/c19/c19.rpy:2970
translate french c19s005_Kiara_c517504e:

    # kia "¿Qué? ¿Desde cuándo?"
    kia "Quoi ? Depuis quand ?"

# game/scripts/c19/c19.rpy:2971
translate french c19s005_Kiara_1023e69c:

    # mc "Desde que he tenido la oportunidad de conocerte mejor. Conocerte como mujer, no como la madre de mi novia del instituto."
    mc "Depuis que j'ai eu l'occasion de mieux te connaître, de te connaître en tant que femme, et non plus comme la mère de mon ancienne petite amie du lycée."

# game/scripts/c19/c19.rpy:2972
translate french c19s005_Kiara_fa0d14d4:

    # mc "Desde que sé por lo que has pasado. Desde que pude ver a Solomon en el momento en que más asco daba."
    mc "Depuis que j'ai appris ce que tu as vécu. Depuis que j'ai vu Salomon sous son jour le plus répugnant."

# game/scripts/c19/c19.rpy:2973
translate french c19s005_Kiara_f6a5b899:

    # mc "Llámalo complejo del caballero de brillante armadura o como quieras. Pero aquel día algo hizo clic en mí."
    mc "Appelez ça le syndrome du chevalier servant ou comme vous voulez. Mais ce jour-là, j'ai eu un déclic."

# game/scripts/c19/c19.rpy:2975
translate french c19s005_Kiara_f695a937:

    # kia "Pero... ¿qué pasa con Eileen?"
    kia "Mais… et Eileen ?"

# game/scripts/c19/c19.rpy:2977
translate french c19s005_Kiara_3e500748:

    # mc "Podemos hablar con ella. Si a ninguna de las dos os importa que la otra esté conmigo, no veo dónde puede estar el problema."
    mc "On peut lui parler. Si ça ne vous dérange pas que l'autre soit avec moi, je ne vois pas où est le problème."

# game/scripts/c19/c19.rpy:2979
translate french c19s005_Kiara_a3e56306:

    # mc "Ella y yo tuvimos nuestro momento. Fuimos felices. ¿Crees que, si quieres estar conmigo, te va a negar la oportunidad de tener la felicidad que ella tuvo?"
    mc "Nous avons vécu notre moment. Nous étions heureux. Crois-tu que si tu veux être avec moi, je vais te priver du bonheur qu'elle a connu ?"

# game/scripts/c19/c19.rpy:2980
translate french c19s005_Kiara_2d097cac:

    # mc "Creo que es algo que podemos hablar los tres, si quieres."
    mc "Je pense que c'est quelque chose dont nous pouvons discuter tous les trois, si vous le souhaitez."

# game/scripts/c19/c19.rpy:2981
translate french c19s005_Kiara_777ceb0e:

    # mcp "(Sabiendo que Eileen quiere que estés lo más lejos posible de Solomon, va a superar cualquier reparo que tenga.)"
    mcp "(Sachant qu'Eileen souhaite que vous soyez aussi loin que possible de Solomon, elle surmontera toutes ses réticences.)"

# game/scripts/c19/c19.rpy:2984
translate french c19s005_Kiara_2c78da6b:

    # kia "¿Y con tu novia? No podría aceptar ser \"la otra\", ni hacerle daño o engañarla a sus espaldas."
    kia "Et ta copine ? Je ne pouvais pas accepter d'être « l'autre femme », de la blesser ou de la tromper dans son dos."

# game/scripts/c19/c19.rpy:2985
translate french c19s005_Kiara_f376de56:

    # mc "Podemos hablar con ella también. Si a ella no le importa, y a ti tampoco, no veo dónde puede estar el problema."
    mc "On peut lui parler aussi. Si ça ne la dérange pas, et si ça ne vous dérange pas non plus, je ne vois pas où est le problème."

# game/scripts/c19/c19.rpy:2987
translate french c19s005_Kiara_a1a393a8:

    # kia "¿Y con tu harén?"
    kia "Et votre harem, alors ?"

# game/scripts/c19/c19.rpy:2988
translate french c19s005_Kiara_e2468207:

    # mc "¿Crees que no te van a aceptar en el harén? ¿Has visto algún problema con las revelaciones de hoy?"
    mc "Penses-tu qu'ils ne t'accepteront pas dans le harem ? As-tu constaté des problèmes avec les révélations d'aujourd'hui ?"

# game/scripts/c19/c19.rpy:2990
translate french c19s005_Kiara_045e22dc:

    # kia "Haces que todo parezca tan fácil... pero no lo es."
    kia "Tu fais paraître tout ça si facile… mais ça ne l’est pas."

# game/scripts/c19/c19.rpy:2991
translate french c19s005_Kiara_eb6bb8e6:

    # mc "Hagamos una cosa... empecemos hablando con Eileen. Después puedes tomar una decisión. Pero que esa decisión no incluya mudarte, por favor."
    mc "Allons-y… commençons par parler à Eileen. Ensuite, vous pourrez prendre une décision. Mais s’il vous plaît, ne prenez pas cette décision en envisageant un déménagement."

# game/scripts/c19/c19.rpy:2993
translate french c19s005_Kiara_626625d7:

    # mc "Siempre vamos a ser amigos, Kiara. A mí siempre me has caído bien, pero no creo que debamos ir más allá de ser amigos."
    mc "Nous serons toujours amies, Kiara. Je t'ai toujours bien appréciée, mais je ne pense pas que nous devrions aller plus loin que l'amitié."

# game/scripts/c19/c19.rpy:2995
translate french c19s005_Kiara_087874d0:

    # kia "Eso ayuda..."
    kia "Ça aide..."

# game/scripts/c19/c19.rpy:2997
translate french c19s005_Kiara_d8d56bc4:

    # kia "Después de ver que sales con más de una mujer... casi había empezado a albergar esperanzas. Aunque me negara a aceptarlas."
    kia "Après t'avoir vu fréquenter plusieurs femmes… j'avais presque commencé à me faire des espoirs. Même si je refusais de les accepter."

# game/scripts/c19/c19.rpy:2998
translate french c19s005_Kiara_df5fd914:

    # mc "Te quiero, pero no así. Te quiero porque eres una mujer maravillosa y siempre me vas a tener a tu lado para lo que necesites."
    mc "Je t'aime, mais pas de cette façon-là. Je t'aime parce que tu es une femme merveilleuse et que je serai toujours là pour toi, quoi qu'il arrive."

# game/scripts/c19/c19.rpy:2999
translate french c19s005_Kiara_75ab4beb:

    # mc "Pero no puedo tener una relación contigo. Comparto varios de tus reparos."
    mc "Mais je ne peux pas avoir de relation avec vous. Je partage plusieurs de vos préoccupations."

# game/scripts/c19/c19.rpy:3001
translate french c19s005_Kiara_81a0ebac:

    # kia "Y hasta aquí ha llegado esta conversación, ¿no?"
    kia "Et c'est la fin de cette conversation, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3002
translate french c19s005_Kiara_9d640a05:

    # mc "Aún queda lo de irte de la casa. Yo me voy a ir a Aruba en unas semanas, con lo que no creo que debas hacerlo. Vas a estar mejor aquí que en cualquier otro sitio."
    mc "Vous pouvez toujours sortir. Je pars à Aruba dans quelques semaines, donc je ne pense pas que vous devriez. Vous serez mieux ici qu'ailleurs."

# game/scripts/c19/c19.rpy:3004
translate french c19s005_Kiara_98195484:

    # kia "Creo que debería irme igualmente. De todas formas, en septiembre deberemos dejar la habitación libre para las estudiantes nuevas..."
    kia "Je crois que je devrais partir de toute façon. Il faudra bien libérer la chambre pour les nouveaux élèves en septembre…"

# game/scripts/c19/c19.rpy:3005
translate french c19s005_Kiara_d85b58bd:

    # mc "Pero yo no estaré. Podéis usar mi habitación mientras esté en Aruba. No hay ninguna prisa en que os vayáis."
    mc "Mais je ne serai pas là. Tu peux utiliser ma chambre pendant mon séjour à Aruba. Tu n'es pas pressé de partir."

# game/scripts/c19/c19.rpy:3007
translate french c19s005_Kiara_d34be1e0:

    # kia "Pero volverás. No podemos pedirte que duermas en el sofá eternamente. Igualmente tendremos que irnos a algún sitio."
    kia "Mais tu reviendras. On ne peut pas s'attendre à ce que tu dormes sur le canapé indéfiniment. Il faudra bien qu'on parte un jour."

# game/scripts/c19/c19.rpy:3009
translate french c19s005_Kiara_fb061c9a:

    # mc "Lo entiendo, pero no tomes ninguna decisión precipitada. Creo que se me está ocurriendo una idea."
    mc "Je comprends, mais ne prenez pas de décisions hâtives. Je crois que je commence à comprendre."

# game/scripts/c19/c19.rpy:3012
translate french c19s005_Kiara_70cb7ff7:

    # mad "Hola, ¿interrumpo algo?"
    mad "Bonjour, est-ce que je dérange ?"

# game/scripts/c19/c19.rpy:3013
translate french c19s005_Kiara_5423af24:

    # mc "Hola de nuevo, Maddie. No, no te preocupes. ¿Necesitas algo?"
    mc "Salut Maddie ! Non, ne t'inquiète pas. Tu as besoin de quelque chose ?"

# game/scripts/c19/c19.rpy:3015
translate french c19s005_Kiara_0d69ec4c:

    # mad "Estamos haciendo un juego en el Jacuzzi y venía a preguntarle a Kiara si se quería apuntar."
    mad "Nous jouons à un jeu dans le jacuzzi et je suis venu demander à Kiara si elle voulait se joindre à nous."

# game/scripts/c19/c19.rpy:3016
translate french c19s005_Kiara_3643a8af:

    # mc "¿Sólo Kiara?"
    mc "Juste Kiara ?"

# game/scripts/c19/c19.rpy:3017
translate french c19s005_Kiara_ccd329d1:

    # mad "Es un juego solo de chicas, [mc]. Lo siento. Algo para crear más vínculos entre nosotras."
    mad "C'est un jeu réservé aux filles, [mc]. Désolée. Un moyen de renforcer nos liens."

# game/scripts/c19/c19.rpy:3019
translate french c19s005_Kiara_eddcc4ea:

    # kia "¡Me apunto! ¿De qué va el juego?"
    kia "J'en suis ! De quoi s'agit-il ?"

# game/scripts/c19/c19.rpy:3021
translate french c19s005_Kiara_71fc6a2a:

    # mad "Mejor te lo explico por el camino. Ya estamos unas cuantas allí."
    mad "Je vous l'expliquerai en chemin. Nous sommes déjà plusieurs sur place."

# game/scripts/c19/c19.rpy:3023
translate french c19s005_Kiara_a96c5624:

    # kia "Te veo luego, [mc]. Me tienes que explicar esa idea que has tenido."
    kia "Je te verrai plus tard, [mc]. Tu dois m'expliquer cette idée que tu as eue."

# game/scripts/c19/c19.rpy:3024
translate french c19s005_Kiara_de4d03e5:

    # mc "Perfecto."
    mc "Parfait."

# game/scripts/c19/c19.rpy:3026
translate french c19s005_Kiara_8aa8992c:

    # "Kiara cruza la piscina a nado y se va junto a Maddie hacia el Jacuzzi."
    "Kiara traverse la piscine à la nage et accompagne Maddie vers le jacuzzi."

# game/scripts/c19/c19.rpy:3027
translate french c19s005_Kiara_13a99306:

    # mcp "(Al menos ha quedado aclarado el tema de Kiara. A ver cómo evoluciona.)"
    mcp "(Au moins, la situation de Kiara est désormais claire. Voyons comment les choses évoluent.)"

# game/scripts/c19/c19.rpy:3061
translate french c19s005_KateNorah_e9d933f4:

    # "Buscas a Eileen con la mirada, pero no la ves por ningún lado. Supones que estará en el juego del jacuzzi."
    "Vous cherchez Eileen du regard, mais vous ne la voyez nulle part. Vous supposez qu'elle est dans le jacuzzi."

# game/scripts/c19/c19.rpy:3062
translate french c19s005_KateNorah_ef1f610a:

    # "Cada vez quedan menos chicas en la piscina. Te acercas a Kate y a [nor]."
    "Il reste de moins en moins de filles dans la piscine. Tu t'approches de Kate maintenant [nor]."

# game/scripts/c19/c19.rpy:3065
translate french c19s005_KateNorah_79127472:

    # kat "Aquí llega mi héroe. *Risa* Salir con una de las preciosidades de esta familia ya es un triunfo. Tú lo haces con más de una."
    kat "Voilà mon héros ! *Rires* Sortir avec une des beautés de cette famille, c'est déjà un exploit. Avec plusieurs, alors !"

# game/scripts/c19/c19.rpy:3066
translate french c19s005_KateNorah_734d98ae:

    # mc "No es heroísmo. *Risa* Es suerte."
    mc "Ce n'est pas de l'héroïsme. *Rires* C'est de la chance."

# game/scripts/c19/c19.rpy:3068
translate french c19s005_KateNorah_180c6917:

    # mc "Y me refiero a suerte por mi parte. Estar con alguien como [nor] es increíble."
    mc "Et je veux dire, j'ai de la chance. Être avec quelqu'un comme [nor], c'est incroyable."

# game/scripts/c19/c19.rpy:3069
translate french c19s005_KateNorah_979b2ad2:

    # nor "Gracias, mi amor."
    nor "Merci mon amour."

# game/scripts/c19/c19.rpy:3071
translate french c19s005_KateNorah_ee6e34cd:

    # mc "Y me refiero a suerte por mi parte."
    mc "Et je parle bien de chance de ma part."

# game/scripts/c19/c19.rpy:3072
translate french c19s005_KateNorah_7f7a7a24:

    # nor "Por tu parte y por la de ellas."
    nor "Pour votre part et pour la leur."

# game/scripts/c19/c19.rpy:3074
translate french c19s005_KateNorah_15f32294:

    # kat "Aquí llega el hombre del día. *Risa* Que hayas conseguido una relación en esta familia es para felicitarte."
    kat "Voici l'homme du jour ! *Rires* C'est tout à votre honneur d'avoir réussi à nouer des relations avec cette famille."

# game/scripts/c19/c19.rpy:3076
translate french c19s005_KateNorah_aa1ff343:

    # mc "Gracias. No podría estar con nadie mejor. *Risa* Y no lo digo porque esté delante."
    mc "Merci. Je ne pourrais pas être mieux. *Rires* Et je ne dis pas ça juste parce que je suis là, juste devant vous."

# game/scripts/c19/c19.rpy:3077
translate french c19s005_KateNorah_979b2ad2_1:

    # nor "Gracias, mi amor."
    nor "Merci mon amour."

# game/scripts/c19/c19.rpy:3079
translate french c19s005_KateNorah_d5bd004d:

    # mc "Gracias, Kate. Soy un hombre con suerte."
    mc "Merci, Kate. Je suis un homme chanceux."

# game/scripts/c19/c19.rpy:3080
translate french c19s005_KateNorah_196f9628:

    # nor "Y ella también, [mc]. No lo olvides."
    nor "Et elle aussi, [mc]. N'oublie pas ça."

# game/scripts/c19/c19.rpy:3082
translate french c19s005_KateNorah_84bdcf3b:

    # kat "Aquí llega el hombre más desafortunado del mundo. *Risa* La única mujer que le escribe y es un número equivocado."
    kat "Voici l'homme le plus malchanceux du monde. *Rires* La seule femme qui lui envoie des SMS est un mauvais numéro."

# game/scripts/c19/c19.rpy:3083
translate french c19s005_KateNorah_10c75dbb:

    # mc "No sabemos si escribía una mujer o un hombre. *Risa*"
    mc "On ne sait pas si c'est une femme ou un homme qui l'a écrit. *Rires*"

# game/scripts/c19/c19.rpy:3084
translate french c19s005_KateNorah_53ec85ae:

    # nor "En eso tienes razón, pero todas hemos pensado que era una chica."
    nor "Vous avez raison sur ce point, mais nous pensions tous que c'était une fille."

# game/scripts/c19/c19.rpy:3086
translate french c19s005_KateNorah_301b109c:

    # kat "Desde La Revelación te he visto hablar con Tía Betty, Amanda, Olivia, y Kiara."
    kat "Depuis la Révélation, je t'ai vu parler à tante Betty, Amanda, Olivia et Kiara."

# game/scripts/c19/c19.rpy:3088
translate french c19s005_KateNorah_716518ff:

    # kat "Ninguna está en tu harén..."
    kat "Aucune d'entre elles ne fait partie de votre harem..."

# game/scripts/c19/c19.rpy:3090
translate french c19s005_KateNorah_d0ffcda4:

    # kat "Supongo que te han ametrallado a preguntas, con lo que no lo voy a hacer yo."
    kat "Je suppose que vous avez été bombardés de questions, alors je ne vais pas y répondre."

# game/scripts/c19/c19.rpy:3092
translate french c19s005_KateNorah_1147508f:

    # kat "Supongo que lo de Meemaw se ha convertido en la comidilla del día."
    kat "J'imagine que l'histoire de Meemaw est devenue le sujet de conversation du moment."

# game/scripts/c19/c19.rpy:3093
translate french c19s005_KateNorah_50e84a49:

    # mc "El tema de conversación ha salido, pero hemos hablado de otros temas que teníamos pendientes. No todo gira alrededor de La Revelación."
    mc "Le sujet a été abordé, mais nous avons parlé d'autres choses en suspens. Tout ne tourne pas autour de l'Apocalypse."

# game/scripts/c19/c19.rpy:3095
translate french c19s005_KateNorah_89e5b452:

    # nor "Son estas cosas por las que no se deberían soltar noticias bomba en una fiesta familiar. Absorben las conversaciones."
    nor "Voilà le genre de choses qui rendent dommage de révéler une nouvelle fracassante lors d'une fête de famille. Elles monopolisent toute la conversation."

# game/scripts/c19/c19.rpy:3096
translate french c19s005_KateNorah_cc688986:

    # mc "Por otro lado, es el mejor momento. Ahora ya lo sabe todo el mundo."
    mc "D'un autre côté, c'est le moment idéal. Maintenant, tout le monde est au courant."

# game/scripts/c19/c19.rpy:3098
translate french c19s005_KateNorah_ccb9c144:

    # mc "Pero cambiemos de tema y volvamos a la fiesta. ¿Qué tal tu primera experiencia con una fiesta con toda la familia?"
    mc "Mais changeons de sujet et revenons à la fête. Comment s'est passée ta première expérience à une fête de famille ?"

# game/scripts/c19/c19.rpy:3099
translate french c19s005_KateNorah_70c9a0e6:

    # kat "Te recuerdo que estuve en la playa en Navidad. *Risa*"
    kat "Je vous rappelle que j'étais à la plage à Noël. *Rires*"

# game/scripts/c19/c19.rpy:3100
translate french c19s005_KateNorah_c98ca203:

    # mc "*Risa* Lo sé, pero ahora la familia ha crecido. Al menos hasta que lleguen las chichas nuevas, creo que no van a aparecer nuevos miembros."
    mc "*Rires* Je sais, mais la famille s'est agrandie. Du moins, pas avant l'arrivée des nouvelles filles ; je ne pense pas qu'il y aura de nouveaux membres."

# game/scripts/c19/c19.rpy:3102
translate french c19s005_KateNorah_201b9f35:

    # kat "En eso tienes razón. Megan, Amanda, Eva... No estuvieron en la playa, pero son parte de esto."
    kat "Tu as raison. Megan, Amanda, Eva… Elles n'étaient pas à la plage, mais elles sont impliquées."

# game/scripts/c19/c19.rpy:3104
translate french c19s005_KateNorah_7c8a4812:

    # kat "Y Maddie supongo que también, saliendo contigo... pero se la ve cohibida aún."
    kat "Et j'imagine que Maddie ressent la même chose en sortant avec toi... mais elle semble encore timide et réservée."

# game/scripts/c19/c19.rpy:3106
translate french c19s005_KateNorah_c404829b:

    # kat "Y creo que Maddie también podría unirse si le damos la oportunidad. Es muy buena chica."
    kat "Et je pense que Maddie pourrait se joindre à nous aussi si on lui en donnait l'occasion. C'est une fille vraiment adorable."

# game/scripts/c19/c19.rpy:3108
translate french c19s005_KateNorah_2ef2993a:

    # nor "No la conocía mucho, más allá de comprarle ropa, pero es una chica muy agradable."
    nor "Je ne la connaissais pas très bien, à part lui acheter des vêtements, mais c'est une fille très gentille."

# game/scripts/c19/c19.rpy:3109
translate french c19s005_KateNorah_69e25ce6:

    # mc "Lo es. Y creo que se está integrando bien hoy. Al menos para ser su primera vez."
    mc "Oui. Et je pense que ça se met en place plutôt bien aujourd'hui. Du moins pour une première fois."

# game/scripts/c19/c19.rpy:3111
translate french c19s005_KateNorah_14313d0e:

    # kat "Cambiando de tema, cuando te vayas a Aruba, ¿quién se ocupará de lo que haces tú en el Dormitorio?"
    kat "Pour changer de sujet, quand vous irez à Aruba, qui s'occupera de ce que vous ferez dans le dortoir ?"

# game/scripts/c19/c19.rpy:3112
translate french c19s005_KateNorah_7289dceb:

    # kat "Creo que entre todas podríamos ayudar para que [mar] y [nor] no tengan demasiado trabajo."
    kat "Je pense que nous pourrions tous contribuer pour que [mar] et [nor] n'aient pas trop de travail."

# game/scripts/c19/c19.rpy:3113
translate french c19s005_KateNorah_496d8c87:

    # mc "No te preocupes. Vosotras tenéis vuestros estudios. Y la contabilidad la puedo seguir haciendo desde allí. No lleva mucho tiempo."
    mc "Ne t'inquiète pas. Tu as tes études. Et je peux continuer la comptabilité à partir de là. Ça ne prend pas beaucoup de temps."

# game/scripts/c19/c19.rpy:3115
translate french c19s005_KateNorah_b5cc84c6:

    # mc "Ahora mismo es mi trabajo principal. Bueno, y hacer de taxista. *Risa*"
    mc "C'est mon activité principale en ce moment. Enfin, et je conduis un taxi. *Rires*"

# game/scripts/c19/c19.rpy:3117
translate french c19s005_KateNorah_7af261d5:

    # kat "¿Puedo preguntar cómo empezasteis a salir juntos vosotros dos? ¿Y cómo habéis conseguido ocultarlo?"
    kat "Puis-je vous demander comment vous avez commencé à sortir ensemble ? Et comment avez-vous réussi à garder votre relation secrète ?"

# game/scripts/c19/c19.rpy:3118
translate french c19s005_KateNorah_6794e850:

    # kat "Si me hubieran dicho que salías con una de las chicas Marks, seguramente [nor] hubiera sido mi última elección."
    kat "Si on m'avait dit que tu sortais avec une des filles Marks, j'aurais certainement été mon dernier choix."

# game/scripts/c19/c19.rpy:3119
translate french c19s005_KateNorah_1c1f2c26:

    # kat "Bueno, no la última... nunca hubiese pensado en Olivia o Betty tampoco."
    kat "Eh bien, pas la dernière… Je n’aurais jamais pensé à Olivia ou Betty non plus."

# game/scripts/c19/c19.rpy:3120
translate french c19s005_KateNorah_3d4aa2e4:

    # mc "Bueno, todo empezó mientras pintábamos la habitación de Saira."
    mc "Eh bien, tout a commencé pendant que nous peignions la chambre de Saira."

# game/scripts/c19/c19.rpy:3122
translate french c19s005_KateNorah_d7982167:

    # nor "Después yo me metí en el baño dónde se estaba duchando después de pintar."
    nor "Je suis ensuite entrée dans la salle de bain où il prenait sa douche après avoir peint."

# game/scripts/c19/c19.rpy:3124
translate french c19s005_KateNorah_fa4f6932:

    # nor "Y me metí en la ducha con él."
    nor "Et je suis allée prendre une douche avec lui."

# game/scripts/c19/c19.rpy:3126
translate french c19s005_KateNorah_2f9853a4:

    # nor "No pasó nada, pero nos dio pie a hablar."
    nor "Il ne s'est rien passé, mais cela nous a donné l'occasion de parler."

# game/scripts/c19/c19.rpy:3128
translate french c19s005_KateNorah_c4379c1f:

    # kat "¿Qué? ¡No puede ser! ¡Yo nunca me atrevería a algo así!"
    kat "Quoi ? Jamais de la vie ! Je n'oserais jamais faire une chose pareille !"

# game/scripts/c19/c19.rpy:3130
translate french c19s005_KateNorah_d822dae8:

    # kat "¿Y tú no sabes que existen los pestillos?"
    kat "Et vous ignorez l'existence des verrous ?"

# game/scripts/c19/c19.rpy:3131
translate french c19s005_KateNorah_db6800e4:

    # mc "*Risa* El de ese baño estaba roto. Me alegra que lo estuviera."
    mc "*Rires* Celui de cette salle de bain était cassé. Tant mieux !"

# game/scripts/c19/c19.rpy:3133
translate french c19s005_KateNorah_9d314019:

    # mc "Y para las pequeñas reparaciones pueden llamar a alguien para que las haga."
    mc "Et pour les petites réparations, ils peuvent faire appel à quelqu'un."

# game/scripts/c19/c19.rpy:3135
translate french c19s005_KateNorah_3207426c:

    # nor "Los pestillos de los baños están aguantando bien. Y eso que ahora hay mucho más tráfico en esos baños que antes."
    nor "Les verrous des toilettes résistent bien. Et ce, malgré une fréquentation bien plus importante qu'auparavant."

# game/scripts/c19/c19.rpy:3137
translate french c19s005_KateNorah_1919e27e:

    # kat "¿Teníais roto algún pestillo antes de que nosotras llegáramos?"
    kat "Aviez-vous des verrous cassés avant notre arrivée ?"

# game/scripts/c19/c19.rpy:3139
translate french c19s005_KateNorah_af7fcf4c:

    # nor "Sí, yo una vez pillé a [mc] duchándose. El día que pintamos la habitación de Saira."
    nor "Oui, j'ai surpris [mc] sous la douche une fois. Le jour où nous avons peint la chambre de Saira."

# game/scripts/c19/c19.rpy:3140
translate french c19s005_KateNorah_49f9aa49:

    # mc "¡Es verdad! ¡Casi ni me acordaba!"
    mc "C'est vrai ! J'avais presque oublié !"

# game/scripts/c19/c19.rpy:3142
translate french c19s005_KateNorah_cf4dbc66:

    # kat "Mmmm... ¿Qué baño es el que tiene el pestillo roto?"
    kat "Mmm... Quelle salle de bain a un loquet cassé ?"

# game/scripts/c19/c19.rpy:3143
translate french c19s005_KateNorah_78c5db4c:

    # mc "*Risa* Ahora ninguno. Arreglé el de la planta baja pocos días antes de que llegarais, y puse uno en vuestra planta."
    mc "*Rires* Maintenant, plus rien. J'ai réparé celui du bas quelques jours avant ton arrivée et j'en ai mis un sur ton étage."

# game/scripts/c19/c19.rpy:3144
translate french c19s005_KateNorah_d1207734:

    # mc "Los únicos que no tienen son los de las habitaciones de [mar] y Saira, y el del gimnasio."
    mc "Les seuls qui leur manquent sont ceux qui se trouvent dans les chambres de [mar] et de Saira, et celui de la salle de sport."

# game/scripts/c19/c19.rpy:3145
translate french c19s005_KateNorah_fdc763e7:

    # mc "No estás pensando en meterte en algún baño mientras alguna de las chicas se ducha, ¿verdad?"
    mc "Tu n'as pas l'intention de te faufiler dans une salle de bain pendant qu'une des filles prend sa douche, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3147
translate french c19s005_KateNorah_4093d35b:

    # kat "¿Qué? ¿Alguna de las chicas? ¡No!"
    kat "Quoi ? Une des filles ? Non !"

# game/scripts/c19/c19.rpy:3148
translate french c19s005_KateNorah_fd73ed68:

    # kat "Sólo lo decía en caso de... en caso de... en caso de tener que atrancar la puerta o algo."
    kat "Je le disais seulement au cas où... au cas où... au cas où je devrais fermer la porte à clé ou quelque chose comme ça."

# game/scripts/c19/c19.rpy:3149
translate french c19s005_KateNorah_58e96678:

    # mc "*Risa* Yo siempre llamo antes de entrar en un baño, no te preocupes. Crecí rodeado de chicas."
    mc "*Rires* Je frappe toujours avant d'entrer dans une salle de bain, ne t'inquiète pas. J'ai grandi entourée de filles."

# game/scripts/c19/c19.rpy:3151
translate french c19s005_KateNorah_0e095aba:

    # nor "Y si quieres pillar a [mc] duchándose, tu mejor opción es el baño del gimnasio."
    nor "Et si vous voulez surprendre [mc] sous la douche, le mieux est d'aller dans les toilettes de la salle de sport."

# game/scripts/c19/c19.rpy:3153
translate french c19s005_KateNorah_743e5f3d:

    # nor "Es el primero que probé yo, pero por entonces había menos gente en la casa. Se estaba duchando en otro."
    nor "C'était la première que j'ai essayée, mais il y avait moins de monde à la maison ce jour-là. Elle prenait sa douche dans une autre."

# game/scripts/c19/c19.rpy:3154
translate french c19s005_KateNorah_1774101e:

    # mc "No creo que Kate tenga ningún interés en pillarme en la ducha, mi vida."
    mc "Je ne pense pas que Kate ait envie de me surprendre sous la douche, mon amour."

# game/scripts/c19/c19.rpy:3156
translate french c19s005_KateNorah_4d9c45f3:

    # mc "No creo que Kate tenga ningún interés en pillarme en la ducha, [nor]."
    mc "Je ne pense pas que Kate ait envie de me surprendre sous la douche, [nor]."

# game/scripts/c19/c19.rpy:3159
translate french c19s005_KateNorah_835e08cc:

    # kat "¡Por supuesto que no! ¡Además, ya estás con [nor]!"
    kat "Bien sûr que non ! D'ailleurs, tu es déjà chez [nor] !"

# game/scripts/c19/c19.rpy:3161
translate french c19s005_KateNorah_42c54e48:

    # kat "¡Por supuesto que no! ¡Además, ya estás con alguien!"
    kat "Bien sûr que non ! En plus, tu es déjà en couple !"

# game/scripts/c19/c19.rpy:3163
translate french c19s005_KateNorah_8a5c59b3:

    # kat "¡Por supuesto que no! ¡Además, tú ya tienes tu harén!"
    kat "Bien sûr que non ! En plus, tu as déjà ton harem !"

# game/scripts/c19/c19.rpy:3165
translate french c19s005_KateNorah_76cc7daf:

    # kat "¡Por supuesto que no! ¡Además, saliste con Eileen y Saira!"
    kat "Bien sûr que non ! En plus, tu es sorti avec Eileen et Saira !"

# game/scripts/c19/c19.rpy:3167
translate french c19s005_KateNorah_bf87f68f:

    # nor "*Risa*"
    nor "*Rire*"

# game/scripts/c19/c19.rpy:3168
translate french c19s005_KateNorah_9e3dcc61:

    # mc "¿Qué pasa, [nor]?"
    mc "Quoi de neuf, [nor] ?"

# game/scripts/c19/c19.rpy:3171
translate french c19s005_KateNorah_6485e52e:

    # nor "Nada, mi amor. Pero creo que deberías ir a hablar con otras chicas antes de que piensen que te monopolizamos."
    nor "Rien, mon amour. Mais je pense que tu devrais aller parler à d'autres filles avant qu'elles ne croient qu'on t'a accaparé."

# game/scripts/c19/c19.rpy:3173
translate french c19s005_KateNorah_a68c14ce:

    # nor "Nada, cielo. Pero creo que deberías ir a hablar con otras chicas antes de que piensen que te monopolizamos."
    nor "Rien, chérie. Mais je pense que tu devrais aller parler à d'autres filles avant qu'elles ne pensent qu'on te monopolise."

# game/scripts/c19/c19.rpy:3174
translate french c19s005_KateNorah_e61c9ffd:

    # mcp "(No soy tan obtuso como para no darme cuenta de cuando quieren hablar a solas.)"
    mcp "(Je ne suis pas assez naïf pour ne pas comprendre quand ils veulent parler seuls.)"

# game/scripts/c19/c19.rpy:3176
translate french c19s005_KateNorah_2f90526d:

    # mc "De acuerdo. Además, tenía que hablar con Eileen, y veo que está ahí, hablando con Lisa."
    mc "D'accord. Par ailleurs, je devais parler à Eileen, et je vois qu'elle est là, en train de parler à Lisa."

# game/scripts/c19/c19.rpy:3177
translate french c19s005_KateNorah_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "À plus tard, les filles."

# game/scripts/c19/c19.rpy:3215
translate french c19s007_KateWithNor_de805308:

    # "Mientras tú hablabas con Eileen..."
    "Pendant que vous parliez à Eileen..."

# game/scripts/c19/c19.rpy:3218
translate french c19s007_KateWithNor_e9260096:

    # nor "Te gusta, ¿verdad?"
    nor "Ça vous plaît, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3220
translate french c19s007_KateWithNor_420624a2:

    # kat "¿Qué? ¡No! No sé si lo sabes, pero a mí me gustan las mujeres, no los hombres."
    kat "Quoi ? Non ! Je ne sais pas si vous le savez, mais j'aime les femmes, pas les hommes."

# game/scripts/c19/c19.rpy:3222
translate french c19s007_KateWithNor_f367d73b:

    # nor "Sabes que te pueden gustar las mujeres... y [mc], ¿verdad?"
    nor "Tu sais que tu peux aimer les femmes... et [mc], n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3223
translate french c19s007_KateWithNor_9f118cce:

    # nor "No es necesario que te gusten el resto de los hombres."
    nor "Tu n'es pas obligée d'aimer les autres hommes."

# game/scripts/c19/c19.rpy:3225
translate french c19s007_KateWithNor_bfc51426:

    # kat "No sé de dónde has sacado la ridícula idea de que me puede gustar [mc]."
    kat "Je ne sais pas d'où vous tenez cette idée ridicule que je pourrais aimer [mc]."

# game/scripts/c19/c19.rpy:3227
translate french c19s007_KateWithNor_3fc1dc89:

    # nor "De hace un momento. Cuando has dicho ese vehemente \"por supuesto que no\"."
    nor "À l'instant même. Quand vous avez dit avec autant de véhémence « bien sûr que non »."

# game/scripts/c19/c19.rpy:3229
translate french c19s007_KateWithNor_69ad2e01:

    # nor "Tu razón para ese \"por supuesto que no\" es que está conmigo."
    nor "Votre raison pour ce «bien sûr que non» est qu'il est avec moi."

# game/scripts/c19/c19.rpy:3231
translate french c19s007_KateWithNor_dbfe7880:

    # nor "Tu razón para ese \"por supuesto que no\" es con quién sale."
    nor "La raison de votre « bien sûr que non » est liée à la personne avec qui elle sort."

# game/scripts/c19/c19.rpy:3233
translate french c19s007_KateWithNor_cbb891e7:

    # nor "Tu razón para ese \"por supuesto que no\" es que tiene un harén."
    nor "Votre raison pour ce « bien sûr que non » est qu'il a un harem."

# game/scripts/c19/c19.rpy:3235
translate french c19s007_KateWithNor_f4154e92:

    # nor "Tu razón para ese \"por supuesto que no\" es con quién salió en el pasado."
    nor "Votre raison pour ce « bien sûr que non » est liée aux personnes avec qui elle est sortie par le passé."

# game/scripts/c19/c19.rpy:3236
translate french c19s007_KateWithNor_aa57dace:

    # nor "Sólo estábamos hablando de pillarlo desnudo, no de salir con él. No debería importar... a menos que te guste."
    nor "On parlait juste de le surprendre nu, pas de sortir avec lui. Ça ne devrait pas avoir d'importance… sauf si tu l'aimes bien."

# game/scripts/c19/c19.rpy:3238
translate french c19s007_KateWithNor_f08bb232:

    # kat "Supongo que lo consideraba algún tipo de traición... pillarlo desnudo a propósito, me refiero."
    kat "J'imagine qu'il a considéré ça comme une sorte de trahison… le surprendre nu exprès, je veux dire."

# game/scripts/c19/c19.rpy:3240
translate french c19s007_KateWithNor_11f61b1e:

    # nor "¿Sabes lo que realmente sería una traición? Que no aceptaras lo que sientes."
    nor "Sais-tu ce qu'est une véritable trahison ? Ne pas accepter ce que l'on ressent."

# game/scripts/c19/c19.rpy:3241
translate french c19s007_KateWithNor_5d309e37:

    # nor "Sería una traición a ti misma."
    nor "Ce serait vous trahir."

# game/scripts/c19/c19.rpy:3243
translate french c19s007_KateWithNor_0bd65c6a:

    # kat "Pero..."
    kat "Mais..."

# game/scripts/c19/c19.rpy:3245
translate french c19s007_KateWithNor_042b7c89:

    # nor "No hay peros, Kate. Si, sé que te gustan las mujeres. Todas lo sabemos."
    nor "Pas de « mais », Kate. Oui, je sais que tu aimes les femmes. On le sait tous."

# game/scripts/c19/c19.rpy:3246
translate french c19s007_KateWithNor_faac1dc3:

    # nor "Cuando [eri] pidió la fiesta topless, se te caía la baba mientras [mar] la autorizaba."
    nor "Quand [eri] a demandé la soirée seins nus, tu bavais pendant que [mar] l'autorisait."

# game/scripts/c19/c19.rpy:3247
translate french c19s007_KateWithNor_0b35142a:

    # nor "Te pasaste el resto de la cena imaginándonos a todas en topless."
    nor "Tu as passé le reste du dîner à nous imaginer toutes seins nus."

# game/scripts/c19/c19.rpy:3249
translate french c19s007_KateWithNor_04a4fdec:

    # kat "Lo siento... creía que había sido más discreta."
    kat "Je suis désolé... Je pensais avoir été plus discret."

# game/scripts/c19/c19.rpy:3251
translate french c19s007_KateWithNor_fb473e61:

    # nor "No pasa nada, cielo. La discreción no es lo tuyo, pero no pasa nada."
    nor "C'est bon, chérie. La discrétion n'est pas ton fort, mais ce n'est pas grave."

# game/scripts/c19/c19.rpy:3252
translate french c19s007_KateWithNor_07e92efc:

    # nor "Lo estoy diciendo porque hoy, con doce o trece chicas en topless, nos has dedicado menos miradas de las que todas esperábamos."
    nor "Je dis ça parce qu'aujourd'hui, avec douze ou treize filles seins nus, vous nous avez offert moins de regards que ce à quoi nous nous attendions."

# game/scripts/c19/c19.rpy:3253
translate french c19s007_KateWithNor_5edf6d55:

    # nor "Has pasado más tiempo mirando a [mc] que a nosotras."
    nor "Vous avez passé plus de temps à regarder [mc] qu'à nous regarder."

# game/scripts/c19/c19.rpy:3255
translate french c19s007_KateWithNor_ee886111:

    # kat "*Risa* Eso es porque hoy he sido más discreta mirando."
    kat "*Rires* C'est parce que j'ai été plus discrète aujourd'hui."

# game/scripts/c19/c19.rpy:3257
translate french c19s007_KateWithNor_be4d06de:

    # nor "*Risa* No, Kate, no lo has sido."
    nor "*Rires* Non, Kate, tu n'y es pas allée."

# game/scripts/c19/c19.rpy:3258
translate french c19s007_KateWithNor_d458055b:

    # nor "Creo que te he pillado mirándome los pechos unas seis veces. Y mis ojos están aquí arriba. *Risa* Siete."
    nor "Je crois t'avoir surpris à fixer ma poitrine environ six fois. Et mes yeux sont là-haut. *Rires* Sept."

# game/scripts/c19/c19.rpy:3260
translate french c19s007_KateWithNor_e069c8cf:

    # kat "Lo siento..."
    kat "Je suis désolé..."

# game/scripts/c19/c19.rpy:3261
translate french c19s007_KateWithNor_7dd50e9e:

    # kat "Como Jamaal ha dicho, mi cerebro lésbico está confundido."
    kat "Comme l'a dit Jamaal, mon cerveau de lesbienne est en plein désarroi."

# game/scripts/c19/c19.rpy:3263
translate french c19s007_KateWithNor_f1f5021b:

    # kat "No por un exceso de tetas. De esas nunca hay suficientes. Pero es que [mc] me confunde."
    kat "Non pas à cause d'un excès de seins. On n'en a jamais trop. Mais [mc] me perturbe."

# game/scripts/c19/c19.rpy:3265
translate french c19s007_KateWithNor_90d594f3:

    # kat "Me cae muy bien, se porta genial conmigo... no es el concepto de hombre que siempre he tenido."
    kat "Je l'aime beaucoup, il me traite très bien... il ne correspond pas à l'idée que j'avais toujours eue de l'homme idéal."

# game/scripts/c19/c19.rpy:3267
translate french c19s007_KateWithNor_27ec38d7:

    # kat "Aún no lo tengo calado. La mayoría de las veces no me cae bien, pero tengo que reconocer que no es el concepto de hombre que siempre he tenido."
    kat "Je ne le cerne pas encore vraiment. La plupart du temps, je ne l'apprécie pas, mais je dois admettre qu'il n'est pas du tout comme je l'avais imaginé."

# game/scripts/c19/c19.rpy:3269
translate french c19s007_KateWithNor_31a8b8f6:

    # nor "[mc] es cualquier cosa menos el hombre estándar. Creo que deberías hablar con él."
    nor "[mc] est loin d'être un type ordinaire. Je pense que tu devrais lui parler."

# game/scripts/c19/c19.rpy:3272
translate french c19s007_KateWithNor_310ac2ad:

    # kat "¿Para qué? Ya está contigo..."
    kat "Pourquoi s'en soucier ? C'est déjà en vous..."

# game/scripts/c19/c19.rpy:3274
translate french c19s007_KateWithNor_9a1afd46:

    # kat "Y estáis esperando un hijo..."
    kat "Et vous attendez un enfant..."

# game/scripts/c19/c19.rpy:3276
translate french c19s007_KateWithNor_6bd23a69:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Au moins pour clarifier les choses que vous avez en tête."

# game/scripts/c19/c19.rpy:3277
translate french c19s007_KateWithNor_0e819036:

    # nor "No tienes que preocuparte por mí. No soy la dueña de [mc]."
    nor "Ne vous inquiétez pas pour moi. Je ne possède pas [mc]."

# game/scripts/c19/c19.rpy:3278
translate french c19s007_KateWithNor_784caf1e:

    # nor "Lo amo con locura, pero cuando empezamos a salir no me prometió exclusividad. Ni yo se la exigí."
    nor "Je l'aime follement, mais quand nous avons commencé à sortir ensemble, il ne m'a pas promis l'exclusivité. Je ne l'ai pas exigée non plus."

# game/scripts/c19/c19.rpy:3280
translate french c19s007_KateWithNor_049737ee:

    # kat "¿Para qué? Ya está con alguien..."
    kat "Pourquoi s'embêter ? Elle est déjà avec quelqu'un..."

# game/scripts/c19/c19.rpy:3282
translate french c19s007_KateWithNor_4f89fb2b:

    # kat "Y están esperando un hijo..."
    kat "Et ils attendent un enfant..."

# game/scripts/c19/c19.rpy:3284
translate french c19s007_KateWithNor_6bd23a69_1:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Au moins pour clarifier les choses que vous avez en tête."

# game/scripts/c19/c19.rpy:3285
translate french c19s007_KateWithNor_fa3c4374:

    # nor "Si ves que puede haber alguna posibilidad para vosotros, deberías hablar con ella. Pero primero debes hablar con [mc]."
    nor "Si vous entrevoyez une possibilité pour vous, vous devriez lui parler. Mais vous devez d'abord parler à [mc]."

# game/scripts/c19/c19.rpy:3287
translate french c19s007_KateWithNor_831fb81a:

    # kat "¿Para qué? Ya tiene su harén... yo no pinto nada ahí."
    kat "Pourquoi faire ? Elle a déjà son harem… Je n'ai rien à faire là-bas."

# game/scripts/c19/c19.rpy:3289
translate french c19s007_KateWithNor_442ac76c:

    # kat "Y tiene un hijo en camino..."
    kat "Et elle attend un enfant..."

# game/scripts/c19/c19.rpy:3291
translate french c19s007_KateWithNor_c202d563:

    # kat "Y tiene varios hijos en camino..."
    kat "Et elle attend plusieurs enfants..."

# game/scripts/c19/c19.rpy:3293
translate french c19s007_KateWithNor_6bd23a69_2:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Au moins pour clarifier les choses que vous avez en tête."

# game/scripts/c19/c19.rpy:3294
translate french c19s007_KateWithNor_d662d106:

    # nor "Si ves que puede haber alguna posibilidad para vosotros, quizás deberías hablar con el resto de las chicas."
    nor "Si vous pensez qu'il y a une possibilité pour vous, vous devriez peut-être en parler aux autres filles."

# game/scripts/c19/c19.rpy:3296
translate french c19s007_KateWithNor_a1b63678:

    # nor "Yo no tendría ningún problema en que tú también estuvieras en el harén."
    nor "Je n'aurais aucun problème à ce que tu sois aussi dans le harem."

# game/scripts/c19/c19.rpy:3298
translate french c19s007_KateWithNor_7f8e060b:

    # kat "¿Para qué? Si no está con nadie... debe ser porque no quiere, ¿no?"
    kat "Pourquoi s'en soucier ? Si elle n'est avec personne... c'est forcément parce qu'elle ne le souhaite pas, non ?"

# game/scripts/c19/c19.rpy:3300
translate french c19s007_KateWithNor_6bd23a69_3:

    # nor "Como mínimo para aclarar las cosas que tienes en la cabeza."
    nor "Au moins pour clarifier les choses que vous avez en tête."

# game/scripts/c19/c19.rpy:3301
translate french c19s007_KateWithNor_92c9ac8e:

    # nor "No puedes saber si no está con nadie porque está esperando que alguien se decida a hablar."
    nor "On ne peut pas savoir si elle est seule parce qu'elle attend que quelqu'un se décide à lui parler."

# game/scripts/c19/c19.rpy:3303
translate french c19s007_KateWithNor_30dc9c53:

    # kat "Haces que todo suene tan lógico... pero es que, además, hay también una chica..."
    kat "Tu présentes tout ça comme si c'était logique... mais d'un autre côté, il y a aussi une fille..."

# game/scripts/c19/c19.rpy:3305
translate french c19s007_KateWithNor_e69c73b1:

    # "Kate y [nor] hablan largo y tendido sobre las dudas que acucian a Kate y cómo encararlas."
    "Kate et [nor] discutent longuement des doutes qui tourmentent Kate et de la façon de les gérer."

# game/scripts/c19/c19.rpy:3307
translate french c19s007_KateWithNor_ce50db7c:

    # "Se pasan el resto de la tarde hablando. Al menos hasta que un evento externo corte su conversación."
    "Ils passent le reste de l'après-midi à discuter. Du moins jusqu'à ce qu'un événement extérieur interrompe leur conversation."

# game/scripts/c19/c19.rpy:3394
translate french c19s007_EileenLisa_908cfe8b:

    # mc "Hola, chicas. ¿Interrumpo algo?"
    mc "Salut les filles. Je vous dérange ?"

# game/scripts/c19/c19.rpy:3395
translate french c19s007_EileenLisa_2a1730b0:

    # eil "No, que va. Lisa me estaba pidiendo que me uniera al juego en el jacuzzi."
    eil "Pas question. Lisa me proposait de la rejoindre pour jouer dans le jacuzzi."

# game/scripts/c19/c19.rpy:3396
translate french c19s007_EileenLisa_50790d46:

    # lis "Está siendo muy divertido."
    lis "C'était très amusant."

# game/scripts/c19/c19.rpy:3397
translate french c19s007_EileenLisa_d12ca1f4:

    # mc "¿A qué estáis jugando?"
    mc "À quel jeu joues-tu ?"

# game/scripts/c19/c19.rpy:3399
translate french c19s007_EileenLisa_993cb0db:

    # lis "Es una cosa que se le ha ocurrido a Simone. Como hoy la cosa parece que iba de secretos..."
    lis "C'est une idée de Simone. Puisque la journée semble placée sous le signe des secrets…"

# game/scripts/c19/c19.rpy:3400
translate french c19s007_EileenLisa_77a47938:

    # lis "Todas tenemos que contar un secreto y votamos por el más jugoso."
    lis "Nous devons tous raconter un secret et nous votons pour le plus croustillant."

# game/scripts/c19/c19.rpy:3401
translate french c19s007_EileenLisa_8df01667:

    # lis "La que ha contado el menos jugoso tiene que pagar prenda o se le encarga una tarea... y se pierde los secretos que se cuenten. Mi tarea es conseguir que Eileen se una a nosotras."
    lis "Celui ou celle qui révèle le secret le moins croustillant devra payer une amende ou se verra confier une tâche… et passera à côté de tous les secrets dévoilés. Ma mission : convaincre Eileen de se joindre à nous."

# game/scripts/c19/c19.rpy:3402
translate french c19s007_EileenLisa_0e1655ae:

    # mc "Ahora entiendo por qué yo no estaba invitado. *Risa* ¿No os vais a quedar sin secretos?"
    mc "Maintenant je comprends pourquoi je n'ai pas été invité. *Rires* Tu n'auras jamais assez de secrets ?"

# game/scripts/c19/c19.rpy:3404
translate french c19s007_EileenLisa_dc84da9d:

    # lis "Ahí está lo divertido del juego. En saber cuándo contar los secretos más jugosos y cuándo los menos."
    lis "C'est tout le plaisir du jeu : savoir quand révéler les secrets les plus croustillants et quand garder les moins croustillants pour soi."

# game/scripts/c19/c19.rpy:3405
translate french c19s007_EileenLisa_fc6145f9:

    # lis "Si has perdido tu top, puedes recuperarlo si tu secreto es el mejor."
    lis "Si vous avez perdu votre top, vous pouvez le récupérer si votre secret est le meilleur."

# game/scripts/c19/c19.rpy:3407
translate french c19s007_EileenLisa_02d0754b:

    # eil "Si hubiera sabido antes a qué estaban jugando, me hubiera apuntado sin que me vinieran a buscar. *Risa*"
    eil "Si j'avais su à quoi ils jouaient, je me serais inscrite sans qu'ils aient besoin de venir me chercher. *Rires*"

# game/scripts/c19/c19.rpy:3408
translate french c19s007_EileenLisa_f05287fa:

    # eil "Es una forma genial de conocernos más entre nosotras."
    eil "C'est un excellent moyen de mieux se connaître."

# game/scripts/c19/c19.rpy:3409
translate french c19s007_EileenLisa_1adb1d1b:

    # mc "Antes de que os vayáis, ¿puedo hablar un momento contigo, Eile?"
    mc "Avant de partir, puis-je te parler un instant, Eile ?"

# game/scripts/c19/c19.rpy:3411
translate french c19s007_EileenLisa_0875d8da:

    # lis "Os espero aquí sentada. No puedo volver con las manos vacías o volveré a perder mi top."
    lis "Je t'attendrai ici. Je ne peux pas repartir les mains vides, sinon je vais encore perdre mon chapeau."

# game/scripts/c19/c19.rpy:3413
translate french c19s007_EileenLisa_49f00a56:

    # mc "Solo serán dos minutos, no te preocupes."
    mc "Cela ne prendra que deux minutes, ne vous inquiétez pas."

# game/scripts/c19/c19.rpy:3416
translate french c19s007_EileenLisa_0c6631c5:

    # eil "Dime, supongo que es sobre mi madre."
    eil "Dites-moi, je suppose que ça parle de ma mère."

# game/scripts/c19/c19.rpy:3417
translate french c19s007_EileenLisa_2b70e735:

    # eil "Os he visto antes, hablando."
    eil "Je vous ai vus tous les deux tout à l'heure, en train de discuter."

# game/scripts/c19/c19.rpy:3418
translate french c19s007_EileenLisa_d2517362:

    # mc "Sí, sigue empeñada en mudarse. Al menos ya no quiere volver a vuestra casa."
    mc "Oui, elle est toujours déterminée à déménager. Au moins, elle ne veut pas revenir chez toi."

# game/scripts/c19/c19.rpy:3419
translate french c19s007_EileenLisa_3de2f27f:

    # mc "He conseguido que retrase la decisión. Al menos por unos días."
    mc "J'ai réussi à le convaincre de reporter sa décision. Au moins pour quelques jours."

# game/scripts/c19/c19.rpy:3421
translate french c19s007_EileenLisa_45024033:

    # eil "Gracias, [mc]. No sé cómo lo has conseguido, pero gracias."
    eil "Merci, [mc]. Je ne sais pas comment vous avez fait, mais merci."

# game/scripts/c19/c19.rpy:3422
translate french c19s007_EileenLisa_b1824f5d:

    # eil "Estar aquí le está haciendo mucho bien, e irnos ahora sería un error."
    eil "Sa présence ici lui fait beaucoup de bien, et partir maintenant serait une erreur."

# game/scripts/c19/c19.rpy:3423
translate french c19s007_EileenLisa_1dd81765:

    # mc "Tengo una idea que podría resolverlo todo, pero tengo que atar unos cabos sueltos antes."
    mc "J'ai une idée qui pourrait tout résoudre, mais je dois d'abord régler quelques détails."

# game/scripts/c19/c19.rpy:3425
translate french c19s007_EileenLisa_e3903992:

    # eil "¿Que nos mudemos con Tía Betty y Yaya Olivia?"
    eil "Devrions-nous aller vivre chez tante Betty et grand-mère Olivia ?"

# game/scripts/c19/c19.rpy:3426
translate french c19s007_EileenLisa_bb0db76e:

    # mc "¿Yaya Olivia? ¡Eso es nuevo!"
    mc "Grand-mère Olivia ? C'est nouveau !"

# game/scripts/c19/c19.rpy:3428
translate french c19s007_EileenLisa_c6640cbb:

    # eil "*Risa* Sí. Lexi ha empezado a llamarla así. Yaya es abuela en español, creo. Pienso que se le va a quedar el nombre."
    eil "*Rires* Oui. Lexi a commencé à l'appeler comme ça. Yaya signifie grand-mère en espagnol, je crois. Je pense que le surnom va lui rester."

# game/scripts/c19/c19.rpy:3429
translate french c19s007_EileenLisa_dfee4cac:

    # mc "¡Es genial! Eso muestra que el cariño en esta familia va en todos los sentidos."
    mc "C'est formidable ! Cela montre que l'amour dans cette famille est sans limites."

# game/scripts/c19/c19.rpy:3430
translate french c19s007_EileenLisa_c842883c:

    # mc "Meemaw se ha emocionado mucho con todos los abrazos."
    mc "Meemaw a été très touchée par tous ces câlins."

# game/scripts/c19/c19.rpy:3432
translate french c19s007_EileenLisa_11853e29:

    # eil "Claro que va en todos los sentidos. Todas nos hemos sentido aliviadas cuando ha unido las palabras cáncer y limpia."
    eil "Bien sûr, ça marche dans les deux sens. On a tous ressenti un soulagement quand elle a associé les mots cancer et purification."

# game/scripts/c19/c19.rpy:3433
translate french c19s007_EileenLisa_81bfafc9:

    # eil "Pero a lo que íbamos. ¿Esa ha sido tu idea? ¿Que nos mudemos con ellas?"
    eil "Mais revenons à nos moutons. C'était ton idée ? Qu'on aille vivre chez eux ?"

# game/scripts/c19/c19.rpy:3434
translate french c19s007_EileenLisa_10287fce:

    # mc "Sí, sería bueno que hablarais sobre ello."
    mc "Oui, ce serait bien que vous en parliez."

# game/scripts/c19/c19.rpy:3436
translate french c19s007_EileenLisa_ec47dea0:

    # eil "A mí también se me había ocurrido y quería hablar con ellas un día de estos. Pagarles un alquiler o algo por una habitación."
    eil "J'y avais pensé aussi, et je voulais leur parler un de ces jours. Leur payer un loyer ou quelque chose comme ça pour une chambre."

# game/scripts/c19/c19.rpy:3437
translate french c19s007_EileenLisa_7c3629ba:

    # eil "Por alguna razón mi madre no quiere seguir viviendo aquí. Posiblemente con Olivia y Tía Betty le parezca mejor."
    eil "Pour une raison que j'ignore, ma mère ne veut plus vivre ici. Elle serait peut-être mieux chez Olivia et tante Betty."

# game/scripts/c19/c19.rpy:3438
translate french c19s007_EileenLisa_df887235:

    # mc "Las grandes mentes piensan igual. *Risa* Y te has olvidado lo de Yaya..."
    mc "Les grands esprits se rencontrent. *Rires* Et tu as oublié Yaya..."

# game/scripts/c19/c19.rpy:3440
translate french c19s007_EileenLisa_db479b5b:

    # mc "Pero hay otra cosa..."
    mc "Mais il y a autre chose..."

# game/scripts/c19/c19.rpy:3442
translate french c19s007_EileenLisa_158d3825:

    # eil "Me das miedo cuando lo dices así. ¿Qué ha pasado?"
    eil "Tu me fais peur quand tu dis ça comme ça. Que s'est-il passé ?"

# game/scripts/c19/c19.rpy:3445
translate french c19s007_EileenLisa_ffc1d4b8:

    # mc "Ya has visto que sólo estoy contigo..."
    mc "Tu as déjà vu que je ne suis qu'avec toi..."

# game/scripts/c19/c19.rpy:3447
translate french c19s007_EileenLisa_4490f0cd:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3448
translate french c19s007_EileenLisa_5bbf18c6:

    # mc "Pero aquel día, en el bosque, hablaste de un harén, y de ser la Primera Concubina..."
    mc "Mais ce jour-là, dans la forêt, vous avez parlé d'un harem, et d'être la Première Concubine..."

# game/scripts/c19/c19.rpy:3449
translate french c19s007_EileenLisa_4490f0cd_1:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3451
translate french c19s007_EileenLisa_97804d23:

    # mc "Ahora ya sabes quién forma parte del harén..."
    mc "Maintenant vous savez qui fait partie du harem..."

# game/scripts/c19/c19.rpy:3453
translate french c19s007_EileenLisa_4490f0cd_2:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3454
translate french c19s007_EileenLisa_c3027cf4:

    # mc "Recuerdo aquel día, en el bosque, cuando hablaste de ser la Primera Concubina..."
    mc "Je me souviens de ce jour dans les bois où tu as parlé d'être la Première Concubine..."

# game/scripts/c19/c19.rpy:3455
translate french c19s007_EileenLisa_4490f0cd_3:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3457
translate french c19s007_EileenLisa_8b0c7515:

    # mc "Tú y yo fuimos felices en el instituto..."
    mc "Toi et moi étions heureux au lycée..."

# game/scripts/c19/c19.rpy:3459
translate french c19s007_EileenLisa_4490f0cd_4:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3460
translate french c19s007_EileenLisa_c8f95a2b:

    # mc "Y, cuando rompimos, prometimos no inmiscuirnos en las futuras relaciones del otro..."
    mc "Et lorsque nous nous sommes séparés, nous avons promis de ne pas nous immiscer dans les relations futures de l'autre..."

# game/scripts/c19/c19.rpy:3461
translate french c19s007_EileenLisa_4490f0cd_5:

    # eil "Sí..."
    eil "Ouais..."

# game/scripts/c19/c19.rpy:3462
translate french c19s007_EileenLisa_1c83c84a:

    # mc "Creo que deberías hablar con Kiara sobre ello."
    mc "Je pense que tu devrais en parler à Kiara."

# game/scripts/c19/c19.rpy:3464
translate french c19s007_EileenLisa_4f31b07d:

    # eil "¿Qué? ¿Tú y mi madre?"
    eil "Quoi ? Toi et ma mère ?"

# game/scripts/c19/c19.rpy:3465
translate french c19s007_EileenLisa_67858e4c:

    # mc "No, no estamos juntos, no te preocupes."
    mc "Non, nous ne sommes pas ensemble, ne t'inquiète pas."

# game/scripts/c19/c19.rpy:3467
translate french c19s007_EileenLisa_3ecc353d:

    # eil "No entiendo de qué quieres que hable con ella, entonces."
    eil "Je ne comprends donc pas de quoi vous voulez que je lui parle."

# game/scripts/c19/c19.rpy:3468
translate french c19s007_EileenLisa_a4aaae33:

    # mc "De cual sería tu posición si lo estuviéramos."
    mc "Quelle serait votre position si nous étions là ?"

# game/scripts/c19/c19.rpy:3470
translate french c19s007_EileenLisa_f5c04f5d:

    # eil "¿Me estás pidiendo permiso para salir con mi madre? *Risa* ¿No solía ser al revés?"
    eil "Tu me demandes la permission de sortir avec ma mère ? *Rires* D'habitude, c'est plutôt l'inverse, non ?"

# game/scripts/c19/c19.rpy:3471
translate french c19s007_EileenLisa_e6a598c7:

    # mc "En cierto modo, sí. También te estoy pidiendo que hables con ella para despejar sus dudas sobre cómo te sentirías si lo hiciéramos."
    mc "D'une certaine manière, oui. Je vous demande aussi de lui parler pour dissiper tout doute qu'elle pourrait avoir sur ce que vous ressentiriez si nous le faisions."

# game/scripts/c19/c19.rpy:3473
translate french c19s007_EileenLisa_db29dff9:

    # eil "Sabes que va a ser rarísimo tener esa conversación, ¿verdad?"
    eil "Tu sais que cette conversation va être vraiment bizarre, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3474
translate french c19s007_EileenLisa_19622137:

    # mc "Me lo imagino, pero a ella le preocupa."
    mc "Je peux l'imaginer, mais cela l'inquiète."

# game/scripts/c19/c19.rpy:3476
translate french c19s007_EileenLisa_466d2f0a:

    # mc "Le preocupa como te sentirías si ella y yo empezáramos algo teniendo en cuenta que tú y yo no hemos vuelto."
    mc "Elle s'inquiète de ce que tu ressentirais si elle et moi commencions quelque chose, étant donné que nous ne nous sommes pas remis ensemble."

# game/scripts/c19/c19.rpy:3478
translate french c19s007_EileenLisa_49d206e0:

    # mc "Le preocupa que la percibas como \"la otra\". Cómo te sentirías si saliera con las dos."
    mc "Elle craint que vous la voyiez comme « l'autre femme ». Comment réagiriez-vous si elle sortait avec vous deux ?"

# game/scripts/c19/c19.rpy:3480
translate french c19s007_EileenLisa_a6b63113:

    # mc "Le preocupa tener que compartir harén contigo."
    mc "Il s'inquiète à l'idée de devoir partager un harem avec vous."

# game/scripts/c19/c19.rpy:3483
translate french c19s007_EileenLisa_24380e09:

    # eil "¡Joder! ¡A mí también me preocuparía! ¡Compartir hombre con mi madre no es normal!"
    eil "Mince alors ! Je m'inquiéterais aussi ! Partager un homme avec ma mère, ce n'est pas normal !"

# game/scripts/c19/c19.rpy:3485
translate french c19s007_EileenLisa_2d8661b4:

    # eil "¡Joder! ¡A mí también me preocuparía! ¡Primero sales con la hija y después con la madre!"
    eil "Mince alors ! Je m'inquiéterais aussi ! Tu sors d'abord avec la fille, puis avec la mère !"

# game/scripts/c19/c19.rpy:3505
translate french c19s007_EileenLisa_cdba0774:

    # eil "Aunque no seamos la primera pareja madre e hija con la que estás."
    eil "Bien que nous ne soyons pas le premier duo mère-fille que vous ayez rencontré."

# game/scripts/c19/c19.rpy:3509
translate french c19s007_EileenLisa_904c6474:

    # eil "Sólo te quedarían Olivia y [nor], y Olivia y [mar]."
    eil "Il ne vous resterait plus qu'Olivia et [nor], et Olivia et [mar]."

# game/scripts/c19/c19.rpy:3511
translate french c19s007_EileenLisa_857de542:

    # eil "Y con las hijas ya estás... te faltaría añadir a Olivia al harén."
    eil "Et avec les filles, c'est parfait... il ne vous resterait plus qu'à ajouter Olivia au harem."

# game/scripts/c19/c19.rpy:3513
translate french c19s007_EileenLisa_d6210b7a:

    # eil "Sólo te quedarían Olivia y [nor]."
    eil "Il ne vous resterait plus qu'Olivia et [nor]."

# game/scripts/c19/c19.rpy:3515
translate french c19s007_EileenLisa_67eeb0bb:

    # eil "Y con [nor] ya estás... te faltaría añadir a Olivia al harén."
    eil "Et avec [nor], c'est tout bon... il ne vous reste plus qu'à ajouter Olivia au harem."

# game/scripts/c19/c19.rpy:3518
translate french c19s007_EileenLisa_b02930f2:

    # eil "Esto es muy raro, [mc]."
    eil "C'est très étrange, [mc]."

# game/scripts/c19/c19.rpy:3519
translate french c19s007_EileenLisa_d59729c7:

    # mc "Lo es. Pero hablarás con ella, ¿verdad?"
    mc "Oui. Mais tu lui parleras, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3521
translate french c19s007_EileenLisa_514b4fed:

    # eil "¡Claro que hablaré con ella! Es raro, pero también creo que puedes ser muy bueno para ella."
    eil "Bien sûr que je lui parlerai ! C'est étrange, mais je pense aussi que tu peux lui faire beaucoup de bien."

# game/scripts/c19/c19.rpy:3522
translate french c19s007_EileenLisa_d4843377:

    # eil "Y ella para ti. Por raro que parezca. Aunque no va a ser una conversación fácil. Me pones en una situación complicada."
    eil "Et elle est pour toi. Aussi étrange que cela puisse paraître. Même si la conversation ne sera pas facile. Tu me mets dans une situation délicate."

# game/scripts/c19/c19.rpy:3523
translate french c19s007_EileenLisa_f1898c0c:

    # mc "Gracias, Eileen. ¿Realmente no te importa? Lo último que querría es que te sientas incómoda."
    mc "Merci, Eileen. Ça ne vous dérange vraiment pas ? Je ne voudrais surtout pas que vous vous sentiez mal à l'aise."

# game/scripts/c19/c19.rpy:3525
translate french c19s007_EileenLisa_b0c40e9e:

    # eil "Después de todo lo que hemos pasado juntos, ¿aún dudas de si te voy a ayudar a salir con mi madre?"
    eil "Après tout ce qu'on a vécu ensemble, tu doutes encore que je t'aide à sortir avec ma mère ?"

# game/scripts/c19/c19.rpy:3526
translate french c19s007_EileenLisa_99ae5a34:

    # eil "Hace unos días me hubiera hecho sentir incómoda, como bien dices, pero ya no. Ahora entiendo muchas cosas sobre cómo se siente mi madre."
    eil "Il y a quelques jours, cela m'aurait mis mal à l'aise, comme vous le dites justement, mais plus maintenant. Je comprends mieux ce que ressent ma mère."

# game/scripts/c19/c19.rpy:3528
translate french c19s007_EileenLisa_9a85e76e:

    # eil "No sé si se dice así o no, pero tenéis mi bendición. *Risa*"
    eil "Je ne sais pas si c'est la meilleure façon de le dire, mais tu as ma bénédiction. *Rires*"

# game/scripts/c19/c19.rpy:3529
translate french c19s007_EileenLisa_43ce655b:

    # mc "*Risa* Creo que ya no se usa esa frase, pero gracias."
    mc "*Rires* Je ne pense pas que cette expression soit encore utilisée, mais merci."

# game/scripts/c19/c19.rpy:3531
translate french c19s007_EileenLisa_dcd90d58:

    # eil "¿Sabes dónde está?"
    eil "Sais-tu où c'est ?"

# game/scripts/c19/c19.rpy:3532
translate french c19s007_EileenLisa_6132fad6:

    # mc "En el jacuzzi. Maddie la ha venido a buscar para que se uniera al juego hace un rato."
    mc "Dans le jacuzzi. Maddie est venue la chercher il y a un petit moment pour qu'elle se joigne à la partie."

# game/scripts/c19/c19.rpy:3534
translate french c19s007_EileenLisa_32de6297:

    # eil "Entonces voy a ir al jacuzzi antes de que Lisa empiece a morderse las uñas."
    eil "Ensuite, j'irai prendre un bain dans le jacuzzi avant que Lisa ne commence à se ronger les ongles."

# game/scripts/c19/c19.rpy:3535
translate french c19s007_EileenLisa_523c95b6:

    # eil "A ver si tengo oportunidad de hablar con ella antes de que acabe la fiesta. Si no, hablaré con ella esta noche."
    eil "Je verrai si je peux lui parler avant la fin de la soirée. Sinon, je lui parlerai ce soir."

# game/scripts/c19/c19.rpy:3538
translate french c19s007_EileenLisa_927ad361:

    # eil "Si no hay nada más, voy a ir al jacuzzi antes de que Lisa empiece a morderse las uñas."
    eil "S'il ne se passe rien d'autre, j'irai prendre un bain dans le jacuzzi avant que Lisa ne commence à se ronger les ongles."

# game/scripts/c19/c19.rpy:3539
translate french c19s007_EileenLisa_108cf442:

    # mc "De acuerdo, Eileen. Hablamos luego."
    mc "D'accord, Eileen. On se reparle plus tard."

# game/scripts/c19/c19.rpy:3541
translate french c19s007_EileenLisa_da96b6bb:

    # "Las dos chicas se dirigen al jacuzzi, Lisa visiblemente con prisa."
    "Les deux jeunes filles se dirigent vers le jacuzzi, Lisa visiblement pressée."

# game/scripts/c19/c19.rpy:3542
translate french c19s007_EileenLisa_242c54f4:

    # mcp "(¿Tiene la tarea un tiempo establecido para cumplirla?)"
    mcp "(La tâche a-t-elle une limite de temps fixée pour son exécution ?)"

# game/scripts/c19/c19.rpy:3543
translate french c19s007_EileenLisa_7940a77b:

    # "Ves que Megan se acerca a ti. ¿Es un plato de galletas y un vaso de leche lo que lleva en las manos?"
    "Vous voyez Megan s'approcher. Est-ce une assiette de biscuits et un verre de lait qu'elle porte ?"

# game/scripts/c19/c19.rpy:3586
translate french c19s007_MeganJamaal_06a72514:

    # "Mientras tanto, al otro lado de la casa..."
    "Pendant ce temps, de l'autre côté de la maison..."

# game/scripts/c19/c19.rpy:3588
translate french c19s007_MeganJamaal_0b398993:

    # mc "¿Te has quedado con hambre, Megan? No podrás quejarte si no entras en el vestido esta noche."
    mc "Tu as encore faim, Megan ? Tu ne peux pas te plaindre si tu ne rentres pas dans la robe ce soir."

# game/scripts/c19/c19.rpy:3589
translate french c19s007_MeganJamaal_fd0c7fb7:

    # meg "*Risa* No es para mí, es para Jamaal. Me ha pedido que le trajera algo para merendar."
    meg "*Rires* Ce n'est pas pour moi, c'est pour Jamaal. Il m'a demandé de lui apporter quelque chose à grignoter."

# game/scripts/c19/c19.rpy:3590
translate french c19s007_MeganJamaal_03d26645:

    # mc "¡Maldito tragón! *Risa* ¿Dónde está? Déjame ayudarte."
    mc "Sacré glouton ! *Rires* Où est-il ? Laissez-moi vous aider."

# game/scripts/c19/c19.rpy:3592
translate french c19s007_MeganJamaal_86645f15:

    # meg "Ha aparcado detrás de casa. *Risa* Toma la leche, mi pulso no es el mejor"
    meg "Il s'est garé derrière la maison. *Rires* Bois un peu de lait, mon pouls n'est pas au mieux."

# game/scripts/c19/c19.rpy:3593
translate french c19s007_MeganJamaal_28ba74d4:

    # meg "No sé cómo he llegado hasta aquí sin derramar nada."
    meg "Je ne sais pas comment je suis arrivé ici sans rien renverser."

# game/scripts/c19/c19.rpy:3594
translate french c19s007_MeganJamaal_63cd8ebd:

    # mc "Vamos."
    mc "Allez."

# game/scripts/c19/c19.rpy:3596
translate french c19s007_MeganJamaal_19e4cdeb:

    # "Por fin descubres dónde está la silla que faltaba. Jamaal es más culpable de lo que Olivia pensaba."
    "Vous finissez par découvrir où se trouve la chaise disparue. Jamaal est plus coupable qu'Olivia ne le pensait."

# game/scripts/c19/c19.rpy:3597
translate french c19s007_MeganJamaal_9efdb09b:

    # mc "He oído que alguien insaciable había pedido comida por aquí. Tragón."
    mc "J'ai entendu dire que quelqu'un à l'appétit insatiable avait commandé à manger ici. Quel glouton !"

# game/scripts/c19/c19.rpy:3598
translate french c19s007_MeganJamaal_a96131b7:

    # jam "¡Hey! No he comido demasiado durante la comida. ¡No he repetido de ninguno de los tres pasteles!"
    jam "Salut ! Je n'ai pas beaucoup mangé à midi. Je n'ai pas repris une seule part des trois gâteaux !"

# game/scripts/c19/c19.rpy:3599
translate french c19s007_MeganJamaal_a4be2fb1:

    # mc "Creo que voy a dejar de meterme contigo por hoy. Aunque sólo sea para agradecerte lo que has intentado hacer con el mensaje."
    mc "Je crois que je vais vous laisser tranquille pour aujourd'hui. Ne serait-ce que pour vous remercier de ce que vous avez essayé de faire avec ce message."

# game/scripts/c19/c19.rpy:3601
translate french c19s007_MeganJamaal_3c3d3bb0:

    # jam "No lo he hecho por ti. *Risa* Creía que era de alguna de las chicas."
    jam "Je ne l'ai pas fait pour toi. *Rires* Je croyais que ça venait d'une des filles."

# game/scripts/c19/c19.rpy:3602
translate french c19s007_MeganJamaal_a3f6d506:

    # jam "No de mi madre o de mi hermana, las dos estuvieron en casa ayer."
    jam "Ni ma mère ni ma sœur, elles étaient toutes les deux à la maison hier."

# game/scripts/c19/c19.rpy:3605
translate french c19s007_MeganJamaal_6620eaab:

    # jam "Aunque sospechara que tenías algo con mi madre, ha sido una grata sorpresa confirmarlo, padrastro."
    jam "Bien que je me doutais que vous aviez une liaison avec ma mère, ce fut une agréable surprise de le confirmer, beau-père."

# game/scripts/c19/c19.rpy:3607
translate french c19s007_MeganJamaal_964befa8:

    # jam "Además nunca sospeché que estuvieras con mi madre."
    jam "D'ailleurs, je n'ai jamais soupçonné que vous étiez avec ma mère."

# game/scripts/c19/c19.rpy:3610
translate french c19s007_MeganJamaal_bfa91bda:

    # jam "Y lo de Simone no ha llegado ni a sorpresa. Desde aquel día en el café me olía algo."
    jam "Et ce que Simone a fait n'était même pas une surprise. Je me doutais bien qu'il se tramait quelque chose ce jour-là au café."

# game/scripts/c19/c19.rpy:3612
translate french c19s007_MeganJamaal_da426c82:

    # jam "Y Simone me ha dado un poquito de pena. Siempre le has gustado..."
    jam "Et j'ai eu un peu pitié de Simone. Elle t'a toujours bien aimé..."

# game/scripts/c19/c19.rpy:3614
translate french c19s007_MeganJamaal_45cbceeb:

    # jam "Y si estabas con alguna de las otras chicas, había que protegerlas, ¿no?"
    jam "Et si tu étais avec l'une des autres filles, tu devais la protéger, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3617
translate french c19s007_MeganJamaal_135d8630:

    # meg "Yo te lo agradezco. Si el mensaje lo hubiera enviado yo, me hubiera muerto de vergüenza mientras lo leía Samantha."
    meg "Merci. Si j'avais envoyé ce message, j'aurais été morte de honte pendant que Samantha le lisait."

# game/scripts/c19/c19.rpy:3618
translate french c19s007_MeganJamaal_d26ebeda:

    # meg "Aunque nunca hubiera mandado un mensaje como ese. Has actuado como un buen amigo."
    meg "Même si je n'aurais jamais envoyé un message comme celui-ci, tu as agi comme un bon ami."

# game/scripts/c19/c19.rpy:3620
translate french c19s007_MeganJamaal_974e0a19:

    # meg "Dudo que ninguna de las chicas de la familia enviara un mensaje como ese, pero has actuado como un buen amigo."
    meg "Je doute que l'une des filles de la famille enverrait un message comme celui-ci, mais tu as agi comme une bonne amie."

# game/scripts/c19/c19.rpy:3622
translate french c19s007_MeganJamaal_9f1d7bd0:

    # meg "Hubieras quedado mejor si Tía Betty no hubiera intentado lo mismo que tú, claro. *Risa*"
    meg "Tu aurais été mieux loti si tante Betty n'avait pas tenté la même chose que toi, évidemment. *Rires*"

# game/scripts/c19/c19.rpy:3623
translate french c19s007_MeganJamaal_37aedb8f:

    # mc "Lo de Betty ha sido alucinante. Si no hubieran hablado a la vez, todo hubiera sido distinto."
    mc "La réaction de Betty était incroyable. S'ils n'avaient pas parlé en même temps, tout aurait été différent."

# game/scripts/c19/c19.rpy:3625
translate french c19s007_MeganJamaal_79786450:

    # jam "Especialmente creo que Olivia no hubiera confesado sin lo de Tía Betty."
    jam "Je pense notamment qu'Olivia n'aurait pas avoué sans l'implication de sa tante Betty."

# game/scripts/c19/c19.rpy:3627
translate french c19s007_MeganJamaal_540c08c0:

    # mc "Ni el resto de las chicas, obviamente. Yo hacía tiempo que quería hacer algo así, aunque no de esta forma."
    mc "Les autres filles non plus, évidemment. J'avais envie de faire quelque chose comme ça depuis un moment, mais pas de cette façon."

# game/scripts/c19/c19.rpy:3630
translate french c19s007_MeganJamaal_787859a5:

    # meg "Yo, desde luego, no lo habría hecho sin una razón así. Y menos aún hoy."
    meg "Je ne l'aurais certainement pas fait sans une raison pareille. Et encore moins aujourd'hui."

# game/scripts/c19/c19.rpy:3632
translate french c19s007_MeganJamaal_2aad4950:

    # meg "Yo también dudo que ninguna de ellas lo hubiera hecho sin la intervención de Betty."
    meg "Je doute également que l'un d'eux l'aurait fait sans l'intervention de Betty."

# game/scripts/c19/c19.rpy:3633
translate french c19s007_MeganJamaal_5557efc0:

    # meg "Y Olivia tampoco lo hubiera hecho. Me alegro de que haya confesado. Es una mujer adorable."
    meg "Olivia ne l'aurait pas fait non plus. Je suis contente qu'elle ait avoué. C'est une femme charmante."

# game/scripts/c19/c19.rpy:3635
translate french c19s007_MeganJamaal_0f5a613e:

    # mc "No creo que Megan lo hubiera hecho sin el intento de Betty por cubrirnos."
    mc "Je ne pense pas que Megan l'aurait fait sans la tentative de Betty pour nous couvrir."

# game/scripts/c19/c19.rpy:3637
translate french c19s007_MeganJamaal_b42c11f4:

    # mc "¿Verdad, cielo?"
    mc "N'est-ce pas, chérie ?"

# game/scripts/c19/c19.rpy:3638
translate french c19s007_MeganJamaal_c0af4d33:

    # meg "Por supuesto que no. Tenía la intención de hacerlo más adelante, pero no hoy."
    meg "Bien sûr que non. Je comptais le faire plus tard, mais pas aujourd'hui."

# game/scripts/c19/c19.rpy:3639
translate french c19s007_MeganJamaal_5557efc0_1:

    # meg "Y Olivia tampoco lo hubiera hecho. Me alegro de que haya confesado. Es una mujer adorable."
    meg "Olivia ne l'aurait pas fait non plus. Je suis contente qu'elle ait avoué. C'est une femme charmante."

# game/scripts/c19/c19.rpy:3641
translate french c19s007_MeganJamaal_9712e8f6:

    # mc "No creo que hubiera habido ninguna confesión sin el intento de Betty por cubrirme."
    mc "Je ne pense pas qu'il y aurait eu d'aveux sans la tentative de Betty de me couvrir."

# game/scripts/c19/c19.rpy:3643
translate french c19s007_MeganJamaal_0570f8e8:

    # meg "Antes he estado hablando con ella, y no, no lo hubiera hecho. Y sin su revelación, Olivia tampoco hubiera confesado."
    meg "Je lui parlais tout à l'heure, et non, je ne l'aurais pas fait. Et sans ses révélations, Olivia n'aurait rien avoué non plus."

# game/scripts/c19/c19.rpy:3645
translate french c19s007_MeganJamaal_783b7796:

    # mc "Creo que Meemaw ha visto la valentía de Betty y se ha sentido mal por ocultar su enfermedad a la familia."
    mc "Je pense que Meemaw a été témoin du courage de Betty et s'est sentie mal d'avoir caché sa maladie à sa famille."

# game/scripts/c19/c19.rpy:3647
translate french c19s007_MeganJamaal_0a8a1261:

    # meg "Ha sido emocionante. Solo la conozco desde hace un par de días, pero es una mujer adorable."
    meg "C'est passionnant. Je ne la connais que depuis quelques jours, mais c'est une femme charmante."

# game/scripts/c19/c19.rpy:3649
translate french c19s007_MeganJamaal_6e10c789:

    # jam "Olivia antes era adorable. *Risa* Como un sargento de instrucción."
    jam "Olivia était adorable. *Rires* Comme un sergent instructeur."

# game/scripts/c19/c19.rpy:3650
translate french c19s007_MeganJamaal_26e3c2cf:

    # jam "¿Pero ahora? Ahora se está volviendo tan mala como su nieto."
    jam "Mais maintenant ? Maintenant, elle devient aussi mauvaise que son petit-fils."

# game/scripts/c19/c19.rpy:3651
translate french c19s007_MeganJamaal_00400057:

    # jam "Fíjate lo que ha dicho de la leche y el estante de arriba. *Risa* Esta leche podía ser de abuela."
    jam "Regarde ce qu'elle a dit à propos du lait et de l'étagère du dessus. *Rires* Ce lait aurait pu être celui de grand-mère."

# game/scripts/c19/c19.rpy:3652
translate french c19s007_MeganJamaal_c22f6ab8:

    # mc "Si no puedes cogerla, podemos usarla para hacer helado. *Risa*"
    mc "Si tu n'arrives pas à le ramasser, on pourra s'en servir pour faire de la glace. *Rires*"

# game/scripts/c19/c19.rpy:3654
translate french c19s007_MeganJamaal_a0fd05f1:

    # meg "¿En serio beberíais leche humana? ¿O haríais helado?"
    meg "Boireiez-vous sérieusement du lait maternel ? Ou en feriez-vous de la glace ?"

# game/scripts/c19/c19.rpy:3656
translate french c19s007_MeganJamaal_ed5d499e:

    # mc "Por supuesto. Es un fetiche muy común. Y dicen que es muy nutritiva."
    mc "Bien sûr. C'est un fétichisme très répandu. Et on dit que c'est très nutritif."

# game/scripts/c19/c19.rpy:3658
translate french c19s007_MeganJamaal_ee0466e2:

    # mc "Dicen que es muy nutritiva. Es un fetiche muy común, pero no es uno de los míos."
    mc "On dit que c'est très nutritif. C'est un fétiche très répandu, mais ce n'est pas le mien."

# game/scripts/c19/c19.rpy:3660
translate french c19s007_MeganJamaal_6c2db6d1:

    # jam "Yo soy un tipo abierto a nuevas experiencias. Y no recuerdo el sabor de la leche materna."
    jam "Je suis ouverte aux nouvelles expériences. Et je ne me souviens pas du goût du lait maternel."

# game/scripts/c19/c19.rpy:3661
translate french c19s007_MeganJamaal_92c52ffd:

    # jam "Aunque el envase no me ponga, estaría dispuesto a probarla si fuera embotellada."
    jam "Même si l'emballage ne me plaît pas, je serais prêt à l'essayer s'il était en bouteille."

# game/scripts/c19/c19.rpy:3662
translate french c19s007_MeganJamaal_f05d98ba:

    # jam "O en forma de helado, o de queso. No sé si se puede hacer queso con leche materna. Tengo que investigar."
    jam "En glace ou en fromage. Je ne sais pas si on peut faire du fromage avec du lait maternel. Il faudra que je me renseigne."

# game/scripts/c19/c19.rpy:3663
translate french c19s007_MeganJamaal_50601e03:

    # mc "Sí, se puede. Lo leí hace unos años. Aunque no sé si probaría el queso hecho con la leche de una desconocida."
    mc "Oui, c'est possible. J'en ai lu un article il y a quelques années. Par contre, je ne sais pas si je goûterais du fromage fabriqué avec le lait d'une inconnue."

# game/scripts/c19/c19.rpy:3665
translate french c19s007_MeganJamaal_930a1959:

    # mc "¿Tú no tendrías curiosidad por probar tu propia leche, Meg?"
    mc "Meg, ne serais-tu pas curieuse de goûter ton propre lait ?"

# game/scripts/c19/c19.rpy:3666
translate french c19s007_MeganJamaal_2511f22e:

    # meg "La mía sí. La de otra mujer... nunca lo he pensado. Supongo que me daría reparo."
    meg "Le mien, oui. Celui d'une autre femme… Je n'y ai jamais pensé. Je suppose que je me sentirais mal à l'aise."

# game/scripts/c19/c19.rpy:3667
translate french c19s007_MeganJamaal_53455539:

    # meg "Y no, no probaría helado o queso hecho con la leche de Olivia."
    meg "Et non, je ne goûterais pas de glace ou de fromage fabriqués avec le lait d'Olivia."

# game/scripts/c19/c19.rpy:3670
translate french c19s007_MeganJamaal_cfd711fe:

    # mc "Habrá que esperar unas 22 semanas para que puedas probar la tuya, entonces. *Risa*"
    mc "Il vous faudra donc attendre environ 22 semaines avant de pouvoir essayer le vôtre. *Rires*"

# game/scripts/c19/c19.rpy:3672
translate french c19s007_MeganJamaal_f56f452b:

    # mc "Habrá que hacer algo para que empieces a producir leche, entonces. *Risa*"
    mc "Il va falloir faire quelque chose pour que tu produises du lait, alors. *Rires*"

# game/scripts/c19/c19.rpy:3674
translate french c19s007_MeganJamaal_7b213762:

    # mc "Algún día encontrarás a alguien con quien tener críos y podrás probar la tuya."
    mc "Un jour, tu trouveras quelqu'un avec qui avoir des enfants et tu pourras essayer d'en avoir toi-même."

# game/scripts/c19/c19.rpy:3676
translate french c19s007_MeganJamaal_abb46807:

    # jam "Y cuando eso pase, quiero ser el sumiller de la leche. *Risa*"
    jam "Et quand ça arrivera, je veux être sommelier du lait. *Rires*"

# game/scripts/c19/c19.rpy:3677
translate french c19s007_MeganJamaal_4fbdb532:

    # jam "Eso sí, no quiero probarla del envase original. *Risa* Eso se lo dejo al padre de la criatura."
    jam "Cela dit, je ne veux pas y goûter directement dans son emballage d'origine. *Rires* Je laisse ça au père de l'enfant."

# game/scripts/c19/c19.rpy:3679
translate french c19s007_MeganJamaal_929d967c:

    # mc "No creo que la quiera compartir contigo. *Risa*"
    mc "Je ne pense pas qu'elle ait envie de te le dire. *Rires*"

# game/scripts/c19/c19.rpy:3681
translate french c19s007_MeganJamaal_757b9762:

    # jam "¡Mal amigo! *Risa*"
    jam "Mauvais ami ! *Rires*"

# game/scripts/c19/c19.rpy:3683
translate french c19s007_MeganJamaal_99942a7a:

    # mc "No sé si el padre estará muy contento de compartir la leche de la criatura contigo."
    mc "Je ne sais pas si le père sera très heureux de partager le lait du bébé avec vous."

# game/scripts/c19/c19.rpy:3685
translate french c19s007_MeganJamaal_7e2d711c:

    # jam "Tendré que investigar con qué hay que alimentar a Megan para que produzca mucha leche y haya para todos."
    jam "Je vais devoir me renseigner sur l'alimentation de Megan pour qu'elle produise suffisamment de lait pour tout le monde."

# game/scripts/c19/c19.rpy:3687
translate french c19s007_MeganJamaal_2ecdc653:

    # meg "Chicos, estáis hablando de mí como si fuera una vaca. *Risa* Estoy de acuerdo que no estoy tan delgada como Scarlett, pero eso es pasarse, ¿no?"
    meg "Vous me traitez comme une vache ! *Rires* Je reconnais que je ne suis pas aussi mince que Scarlett, mais là, c'est exagéré, non ?"

# game/scripts/c19/c19.rpy:3688
translate french c19s007_MeganJamaal_12a138f8:

    # mc "No era a lo que nos referíamos, Meg."
    mc "Ce n'est pas ce que nous voulions dire, Meg."

# game/scripts/c19/c19.rpy:3690
translate french c19s007_MeganJamaal_75e140a8:

    # meg "Lo sé, [mc]. No te preocupes. *Risa* Pero ver tu cara preocupándote por si me habías ofendido ha valido la pena."
    meg "Je sais, [mc]. Ne t'inquiète pas. *Rires* Mais voir ton visage inquiet de m'avoir peut-être offensé en valait la peine."

# game/scripts/c19/c19.rpy:3691
translate french c19s007_MeganJamaal_6d82eea4:

    # mc "*Risa* Creo que pasas demasiado tiempo con Jamaal."
    mc "*Rires* Je crois que tu passes trop de temps avec Jamaal."

# game/scripts/c19/c19.rpy:3693
translate french c19s007_MeganJamaal_b4acabdb:

    # jam "¡Hey! Mi alianza con Kate y con Tía Betty ha sido un fracaso. Tengo que buscar nuevos socios. *Risa*"
    jam "Salut ! Mon alliance avec Kate et tante Betty a échoué. Il me faut trouver de nouveaux partenaires. *Rires*"

# game/scripts/c19/c19.rpy:3694
translate french c19s007_MeganJamaal_513cff19:

    # mc "¿Desde cuándo necesitas aliados contra mí? ¿Ya no eres capaz de defenderte por ti mismo?"
    mc "Depuis quand avez-vous besoin d'alliés contre moi ? Êtes-vous encore incapable de vous défendre vous-même ?"

# game/scripts/c19/c19.rpy:3696
translate french c19s007_MeganJamaal_72733f61:

    # jam "Tú has conseguido que Olivia se meta conmigo, yo tengo que conseguir que el resto de las chicas se metan contigo."
    jam "Tu as réussi à convaincre Olivia de s'en prendre à moi, maintenant je dois convaincre les autres filles de s'en prendre à toi."

# game/scripts/c19/c19.rpy:3697
translate french c19s007_MeganJamaal_8e5c9e50:

    # mc "No, Jam. *Risa* Que Meemaw se meta contigo ha sido totalmente obra tuya."
    mc "Non, Jam. *Rires* C'est entièrement de ta faute si Meemaw t'a fait des siennes."

# game/scripts/c19/c19.rpy:3699
translate french c19s007_MeganJamaal_744f25fa:

    # meg "Habláis de vosotros como si fuera una guerra. *Risa* Lo siento, Jamaal, pero los objetivos con poca movilidad suelen ser los primeros en caer."
    meg "Vous parlez de vous comme si c'était la guerre. *Rires* Désolé, Jamaal, mais les cibles peu mobiles sont généralement les premières à tomber."

# game/scripts/c19/c19.rpy:3700
translate french c19s007_MeganJamaal_59b3c26d:

    # mc "*Risa* Esa ha sido muy ingeniosa, Meg."
    mc "*Rires* C'était très astucieux, Meg."

# game/scripts/c19/c19.rpy:3702
translate french c19s007_MeganJamaal_4c8f7969:

    # jam "¿Ves? Incluso la adorable Megan se mete conmigo ya. Y yo creía que era una buena chica."
    jam "Tu vois ? Même la gentille Megan s'en prend à moi maintenant. Et dire que je la croyais si gentille !"

# game/scripts/c19/c19.rpy:3704
translate french c19s007_MeganJamaal_3da0423a:

    # meg "Si no hubieras hablado de alimentarme para que produjera leche, quizás podría haber habido una alianza. *Risa* Tratarme como a una vaca no es una buena opción diplomática, Jam."
    meg "Si tu n'avais pas parlé de me donner du lait, une alliance aurait peut-être été possible. *Rires* Me traiter comme une vache, c'est pas très diplomatique, Jam."

# game/scripts/c19/c19.rpy:3705
translate french c19s007_MeganJamaal_da436d1c:

    # mc "No digas palabras complicadas como diplomacia. Jam no las va a entender."
    mc "N'utilisez pas de mots compliqués comme diplomatie. Jam ne les comprendra pas."

# game/scripts/c19/c19.rpy:3707
translate french c19s007_MeganJamaal_40546258:

    # jam "¡Hey! Tengo las piernas inútiles, no el cerebro."
    jam "Hé ! J'ai des jambes inutiles, pas un cerveau."

# game/scripts/c19/c19.rpy:3708
translate french c19s007_MeganJamaal_df4b5e92:

    # mc "¿Estás seguro de eso? *Risa*"
    mc "Tu en es sûr ? *Rires*"

# game/scripts/c19/c19.rpy:3710
translate french c19s007_MeganJamaal_75f75a3e:

    # "Pasáis un rato riéndoos los unos de los otros. Megan uniéndose a vuestro deporte favorito es una grata sorpresa."
    "Vous passez un moment à rire ensemble. L'arrivée de Megan dans votre sport préféré est une agréable surprise."

# game/scripts/c19/c19.rpy:3711
translate french c19s007_MeganJamaal_d6e8cd1e:

    # "Después de, como dice ella, tratarla como una vaca, está más o menos a salvo de vuestras pullas. Al menos por hoy. Ha sido una buena estrategia por su parte."
    "Après l'avoir, comme elle le dit, traitée comme une vache, elle est plus ou moins à l'abri de vos piques. Du moins pour aujourd'hui. C'était une bonne stratégie de sa part."

# game/scripts/c19/c19.rpy:3713
translate french c19s007_MeganJamaal_5e477e80:

    # mc "Os voy a abandonar un rato. Voy a comprobar si alguien necesita algo por ahí."
    mc "Je vous quitte un instant. Je vais vérifier si quelqu'un a besoin de quelque chose."

# game/scripts/c19/c19.rpy:3714
translate french c19s007_MeganJamaal_d7551cfe:

    # meg "Pásalo bien, y acuérdate de guardar un poco de tiempo para ti."
    meg "Amusez-vous bien et n'oubliez pas de vous réserver du temps pour vous."

# game/scripts/c19/c19.rpy:3715
translate french c19s007_MeganJamaal_880cbdd4:

    # jam "Si pasas por la cocina de [nor], tráeme un trozo de pastel. Del de [eri]."
    jam "Si jamais tu passes devant la cuisine de [nor], apporte-moi une part de gâteau. Celui de [eri]."

# game/scripts/c19/c19.rpy:3716
translate french c19s007_MeganJamaal_5ae61e06:

    # mc "¡Tragón!"
    mc "Glouton!"

# game/scripts/c19/c19.rpy:3771
translate french c19s006_Alexia_021299d1:

    # "Casi todo el mundo ha desaparecido de la piscina. Supones que deben estar en el jacuzzi de [nor]. Te diriges a la cocina a por el pastel de Jamaal."
    "Presque tout le monde a disparu de la piscine. Vous supposez qu'ils sont dans le jacuzzi à [nor]. Vous vous dirigez vers la cuisine pour prendre le gâteau de Jamaal."

# game/scripts/c19/c19.rpy:3772
translate french c19s006_Alexia_7a30956d:

    # "A medio camino te encuentras con una visión sorprendente."
    "À mi-chemin, vous découvrez un spectacle surprenant."

# game/scripts/c19/c19.rpy:3779
translate french c19s006_Alexia_aca76b56:

    # mc "¿Ya os habéis cansado del juego?"
    mc "Vous en avez déjà assez du jeu ?"

# game/scripts/c19/c19.rpy:3780
translate french c19s006_Alexia_e54cf16e:

    # bet "Ha sido muy divertido e instructivo. *Risa* Pero con Alexia, Amanda, y Eva ganando casi cada ronda, se estaba volviendo peligroso."
    bet "C'était très amusant et instructif. *Rires* Mais comme Alexia, Amanda et Eva gagnaient presque toutes les manches, ça devenait dangereux."

# game/scripts/c19/c19.rpy:3785
translate french c19s006_Alexia_43a80457:

    # kim "Van a poder hacer una colección de tops de bikinis. *Risa* Pero ha estado bien."
    kim "Elles pourront se faire une collection de hauts de bikini. *Rires* Mais c'était bien."

# game/scripts/c19/c19.rpy:3786
translate french c19s006_Alexia_cdbba342:

    # mom "Pero cuando casi no quedaban tops, hemos considerado que era mejor dejarlo."
    mom "Mais lorsqu'il ne restait presque plus de hauts, nous avons décidé qu'il valait mieux arrêter."

# game/scripts/c19/c19.rpy:3787
translate french c19s006_Alexia_7efa2fa8:

    # mc "Entonces, ¿ya puedo visitar el jacuzzi?"
    mc "Alors, je peux aller au jacuzzi maintenant ?"

# game/scripts/c19/c19.rpy:3789
translate french c19s006_Alexia_b37b5a07:

    # kim "Yo no te lo recomendaría. Han decidido que sea zona exclusivamente nudista por el resto de la fiesta. *Risa*"
