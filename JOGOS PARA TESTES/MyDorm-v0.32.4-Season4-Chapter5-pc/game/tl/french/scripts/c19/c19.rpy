# game/scripts/c19/c19.rpy:3902
translate french c19s006_Alexia_fd8e102a:

    # oma "Sólo se ha puesto un poco nerviosa cuando Betty estaba a punto de perder sus braguitas, y creo que es porque todas sabemos que no está preparada."
    oma "Elle n'a été qu'un peu nerveuse lorsque Betty était sur le point de perdre sa culotte, et je pense que c'est parce que nous savons tous qu'elle n'est pas prête."

# game/scripts/c19/c19.rpy:3903
translate french c19s006_Alexia_d82b99bb:

    # mc "Es una monja, al fin y al cabo."
    mc "Après tout, c'est une religieuse."

# game/scripts/c19/c19.rpy:3905
translate french c19s006_Alexia_776508b5:

    # eva "Creo que si se lo proponemos hoy, [mar] no aceptaría, pero quizás un poco más adelante... posiblemente como un hecho consumado..."
    eva "Je pense que si on le lui propose aujourd'hui, [mar] il n'accepterait pas, mais peut-être un peu plus tard... voire comme un fait accompli..."

# game/scripts/c19/c19.rpy:3906
translate french c19s006_Alexia_f24e48ef:

    # mc "No creo que eso funcione con ella. Pero podéis probarlo. Especialmente si sois más de tres."
    mc "Je ne pense pas que ça marchera avec elle. Mais vous pouvez toujours essayer. Surtout si vous êtes plus de trois."

# game/scripts/c19/c19.rpy:3908
translate french c19s006_Alexia_eb539b26:

    # ama "¿Con quién crees que podríamos contar?"
    ama "À votre avis, sur qui pourrions-nous compter ?"

# game/scripts/c19/c19.rpy:3909
translate french c19s006_Alexia_451aed3a:

    # mc "No tengo ni idea. Si me hubieran preguntado quién iba a hacer topless hoy, hubiera fallado en más de la mitad de vosotras."
    mc "Je n'en ai aucune idée. Si vous m'aviez demandé qui allait se dénuder aujourd'hui, je me serais trompée sur plus de la moitié d'entre vous."

# game/scripts/c19/c19.rpy:3910
translate french c19s006_Alexia_e57e38ba:

    # mc "Supongo que las que os habéis quedado desnudas en el jacuzzi. [eri] y [dap] quizás se apuntarían si lo hace [nor]. [emm] también podría hacerlo, para no ser menos."
    mc "J'imagine que ceux d'entre vous qui se sont retrouvés nus dans le jacuzzi pourraient se joindre à la fête si c'est le cas de c5. c2 pourrait aussi le faire, pour ne pas être en reste."

# game/scripts/c19/c19.rpy:3911
translate french c19s006_Alexia_dbda9c91:

    # mc "Lisa, Debbie, Megan, y Maddie lo dudo. [mar], Tía Betty y Meemaw descartadas. Kim y Kate es posible, si no estoy yo. Sam no tengo ni idea."
    mc "Lisa, Debbie, Megan et Maddie, j'en doute. Tante Betty et Mémé sont éliminées. Kim et Kate sont possibles, si je ne suis pas là. Je n'ai aucune idée pour Sam."

# game/scripts/c19/c19.rpy:3913
translate french c19s006_Alexia_0172889b:

    # eva "¡Vale! Es una buena cifra con la que empezar. Tenemos que hablar con las mejores candidatas y montar una fiesta sin [mc] en la piscina. ¿Vamos?"
    eva "D'accord ! C'est un bon chiffre pour commencer. Il faut qu'on parle aux meilleurs candidats et qu'on organise une fête sans alcool. On y va ?"

# game/scripts/c19/c19.rpy:3914
translate french c19s006_Alexia_18e00d4b:

    # mc "Yo me voy a quedar un rato más en el jacuzzi. No quiero estar implicado en esto para no asustar o cohibir a nadie."
    mc "Je vais rester encore un peu dans le jacuzzi. Je ne veux pas m'en mêler pour ne gêner ni effrayer personne."

# game/scripts/c19/c19.rpy:3916
translate french c19s006_Alexia_31550059:

    # oma "Yo también me voy a quedar un rato aquí contigo. La idea del Strip Secret ha sido mía, aunque el juego lo haya propuesto Simone, y no quiero que parezca que tengo ningún interés en esto."
    oma "Je vais rester ici avec vous encore un peu. L'idée de Strip Secret vient de moi, même si c'est Simone qui a suggéré le jeu, et je ne veux pas qu'on croie que j'y ai un quelconque intérêt."

# game/scripts/c19/c19.rpy:3918
translate french c19s006_Alexia_1837bcfc:

    # "Amanda y Eva se ponen sus bikinis dentro del agua."
    "Amanda et Eva ont enfilé leurs bikinis dans l'eau."

# game/scripts/c19/c19.rpy:3919
translate french c19s006_Alexia_a2d58135:

    # mcp "(Para querer avanzar hacia una piscina nudista, se han comportado más tímidamente de lo que habría esperado.)"
    mcp "(Pour quelqu'un qui voulait se rendre dans une piscine nudiste, leur comportement était plus timide que je ne l'aurais imaginé.)"

# game/scripts/c19/c19.rpy:3921
translate french c19s006_Alexia_711c1681:

    # eva "Bueno, vamos a ver si encontramos aliadas para la piscina nudista. *Risita*"
    eva "Bon, voyons si on peut trouver des alliés pour la piscine nudiste. *Rires*"

# game/scripts/c19/c19.rpy:3922
translate french c19s006_Alexia_f4d991f9:

    # ama "Os vemos luego. No te dejes a Fee, Eva."
    ama "À plus tard. N'oublie pas Fee, Eva."

# game/scripts/c19/c19.rpy:3924
translate french c19s006_Alexia_a257ceb8:

    # eva "Me la voy a tener que atar con una cadena a la muñeca. *Risita* Va a ser la única forma de no perderla."
    eva "Je vais devoir l'attacher à mon poignet. *Rires* C'est le seul moyen de ne pas le perdre."

# game/scripts/c19/c19.rpy:3925
translate french c19s006_Alexia_1f36bda7:

    # eva "Alexia, ¿tienes unas esposas de sobras? *Risa*"
    eva "Alexia, aurais-tu des menottes de rechange ? *Rires*"

# game/scripts/c19/c19.rpy:3927
translate french c19s006_Alexia_382377cc:

    # oma "Sí, pero no tamaño muñeca. *Risa*"
    oma "Oui, mais pas à l'échelle d'une poupée. *Rires*"

# game/scripts/c19/c19.rpy:3930
translate french c19s006_Alexia_3124ec16:

    # "Una vez Amanda y Eva se han ido..."
    "Une fois qu'Amanda et Eva seront parties..."

# game/scripts/c19/c19.rpy:3932
translate french c19s006_Alexia_0f8846e7:

    # oma "Lo que has hecho por esas chicas regalándoles las muñecas ha sido increíble."
    oma "Ce que vous avez fait pour ces filles en leur offrant ces poupées est incroyable."

# game/scripts/c19/c19.rpy:3933
translate french c19s006_Alexia_2a0ceed9:

    # oma "Eva no se separa de ella. Aunque se ve rara una chica de su edad paseando una muñeca."
    oma "Eva ne la quitte jamais. Même si cela paraît étrange pour une fille de son âge de se promener avec une poupée."

# game/scripts/c19/c19.rpy:3934
translate french c19s006_Alexia_da5b6556:

    # mc "Ha sido muy emotivo. Nunca han tenido ningún juguete. Ninguna muñeca."
    mc "C'était très émouvant. Ils n'ont jamais eu de jouets. Pas même une poupée."

# game/scripts/c19/c19.rpy:3936
translate french c19s006_Alexia_96a91a1c:

    # oma "Eso lo explica. Sigue siendo raro, pero es más comprensible."
    oma "Voilà qui explique tout. C'est toujours étrange, mais c'est plus compréhensible."

# game/scripts/c19/c19.rpy:3937
translate french c19s006_Alexia_596e0f50:

    # mc "Yo no lo considero raro. Es su primera muñeca. Y la diseñé para que se pareciera a ella lo máximo posible."
    mc "Je ne trouve pas ça étrange. C'est sa première poupée. Et je l'ai conçue pour qu'elle lui ressemble le plus possible."

# game/scripts/c19/c19.rpy:3939
translate french c19s006_Alexia_e4598f1b:

    # mc "Con lo que no conté es que también se parecería a Fiona y a Diana."
    mc "Ce que je n'avais pas prévu, c'est qu'elle ressemblerait aussi à Fiona et Diana."

# game/scripts/c19/c19.rpy:3941
translate french c19s006_Alexia_dc71d14d:

    # mc "No sé qué aspecto tenían las hermanas que perdieron por el camino, pero creo que..."
    mc "Je ne sais pas à quoi ressemblaient les sœurs qu'ils ont perdues en chemin, mais je pense..."

# game/scripts/c19/c19.rpy:3943
translate french c19s006_Alexia_a92a46be:

    # oma "¡Oh! No lo había pensado... La muñeca se llama Fee. De Fiona."
    oma "Oh ! Je n'y avais pas pensé… La poupée s'appelle Fee. De la part de Fiona."

# game/scripts/c19/c19.rpy:3944
translate french c19s006_Alexia_41d64624:

    # mc "Exacto. Creo que por eso le ha afectado más todavía. Le ha puesto el nombre dos minutos después de recibirla."
    mc "Exactement. Je pense que c'est pour ça que ça l'a encore plus touchée. Elle lui a donné un nom deux minutes après l'avoir reçu."

# game/scripts/c19/c19.rpy:3946
translate french c19s006_Alexia_33e5b143:

    # oma "No me imagino por lo que han tenido que pasar esas chicas."
    oma "Je n'arrive pas à imaginer ce que ces filles ont dû endurer."

# game/scripts/c19/c19.rpy:3947
translate french c19s006_Alexia_1720b1a9:

    # oma "Aún se me hace raro que estés hablando con ellas y parezcan super adultas y un minuto después se rían como niñas por una broma que lleva rondando diez años."
    oma "Je trouve toujours ça bizarre de leur parler et qu'elles aient l'air si adultes, et puis une minute plus tard, elles rient comme des gamines à une blague qui dure depuis dix ans."

# game/scripts/c19/c19.rpy:3948
translate french c19s006_Alexia_696d2f86:

    # mc "Esa broma seguramente sea nueva para ellas. Creo que en su vida han faltado muchas risas."
    mc "Cette blague est probablement nouvelle pour eux. Je pense qu'ils ont manqué de rires dans leur vie."

# game/scripts/c19/c19.rpy:3949
translate french c19s006_Alexia_c52806c2:

    # mc "Pero están cambiando muy rápido. Creo que las hemos pillado justo a tiempo para... ¿salvarlas? No se me ocurre ninguna palabra mejor."
    mc "Mais ils évoluent très vite. Je crois que nous les avons surpris juste à temps pour… les sauver ? Je ne trouve pas de meilleur mot."

# game/scripts/c19/c19.rpy:3950
translate french c19s006_Alexia_3e132922:

    # oma "Creo que es la palabra adecuada. Esta familia les puede hacer mucho bien, pero si las hubiéramos conocido dentro de unos años quizás hubiera sido tarde para ellas."
    oma "Je crois que c'est le mot juste. Cette famille peut leur faire beaucoup de bien, mais si nous les avions rencontrés quelques années plus tard, il aurait peut-être été trop tard pour eux."

# game/scripts/c19/c19.rpy:3954
translate french c19s006_Alexia_bad31d5f:

    # "Pasáis un rato charlando de Amanda y Eva, de la fiesta, de las revelaciones."
    "Vous passez un peu de temps à discuter d'Amanda et d'Eva, de la fête, des révélations."

# game/scripts/c19/c19.rpy:3958
translate french c19s006_Alexia_1eb5359c:

    # oma "Nuestros hijos no tendrán que pasar por eso, espero. Van a tener una familia enorme."
    oma "J'espère que nos enfants n'auront pas à vivre ça. Ils auront une famille nombreuse."

# game/scripts/c19/c19.rpy:3961
translate french c19s006_Alexia_a67e0cfc:

    # oma "Si alguna vez los tenemos claro..."
    oma "Si jamais on arrive à les mettre au clair..."

# game/scripts/c19/c19.rpy:3962
translate french c19s006_Alexia_5ca43802:

    # mc "Creo que van a tener tías y abuelas suficientes como para que nunca les falte cariño, cielo."
    mc "Je pense qu'elles auront suffisamment de tantes et de grands-mères pour ne jamais manquer d'amour, ma chérie."

# game/scripts/c19/c19.rpy:3963
translate french c19s006_Alexia_9285451f:

    # mc "También creo que vamos a tener que batallar para poder darles cariño nosotros. *Risa* Todo el mundo va a querer achucharlos."
    mc "Je pense aussi qu'on va devoir se battre pour pouvoir leur témoigner de l'affection. *Rires* Tout le monde va vouloir les câliner."

# game/scripts/c19/c19.rpy:3966
translate french c19s006_Alexia_21bf42e4:

    # oma "Eso dependerá de cuántas chicas más añadas al harén, y de cuántos hijos tengas con ellas."
    oma "Cela dépendra du nombre de filles supplémentaires que vous ajouterez au harem, et du nombre d'enfants que vous aurez avec elles."

# game/scripts/c19/c19.rpy:3967
translate french c19s006_Alexia_e18fafd8:

    # mc "Siempre se los tendremos que quitar a Meemaw. *Risa* No creo que suelte a sus bisnietos fácilmente."
    mc "Il faudra toujours les arracher à Mémé ! *Rires* Je ne pense pas qu'elle se séparera facilement de ses arrière-petits-enfants."

# game/scripts/c19/c19.rpy:3969
translate french c19s006_Alexia_9d3d33f6:

    # oma "Hablando de niños... y de cómo se hacen..."
    oma "En parlant d'enfants... et de la façon dont ils sont faits..."

# game/scripts/c19/c19.rpy:3970
translate french c19s006_Alexia_e9e95e86:

    # oma "Después de las revelaciones, he hablado con [nor] y [mar]..."
    oma "Après ces révélations, j'ai parlé avec [nor] et [mar]..."

# game/scripts/c19/c19.rpy:3972
translate french c19s006_Alexia_388a53b7:

    # mc "Me dais miedo. *Risa*"
    mc "Tu me fais peur. *Rires*"

# game/scripts/c19/c19.rpy:3975
translate french c19s006_Alexia_c7f7664b:

    # oma "Ahora que todo el mundo sabe que estamos juntos... ya no hace falta que nos escondamos para tener sexo."
    oma "Maintenant que tout le monde sait que nous sommes ensemble… nous n’avons plus besoin de nous cacher pour faire l’amour."

# game/scripts/c19/c19.rpy:3976
translate french c19s006_Alexia_88f4fe62:

    # mc "¡Alexia! ¿Aquí? ¿Ahora?"
    mc "Alexia ! Ici ? Maintenant ?"

# game/scripts/c19/c19.rpy:3978
translate french c19s006_Alexia_5e855704:

    # oma "Uno de los secretos con los que he ganado una ronda, creo que he ganado el top de Kiara, ha sido cuando he dicho que me muero por hacer el amor contigo en el jacuzzi."
    oma "Un des secrets qui m'a permis de gagner une manche, je crois que j'ai détrôné Kiara, c'est quand j'ai dit que j'avais très envie de faire l'amour avec toi dans le jacuzzi."

# game/scripts/c19/c19.rpy:3979
translate french c19s006_Alexia_fba373da:

    # mc "Me hubiera gustado ver sus caras. *Risa* ¿Cómo se lo han tomado?"
    mc "J'aurais adoré voir leurs têtes. *Rires* Comment ont-ils réagi ?"

# game/scripts/c19/c19.rpy:3981
translate french c19s006_Alexia_a6dc866c:

    # oma "Estamos solos, ¿no?"
    oma "Nous sommes seuls, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:3982
translate french c19s006_Alexia_49a87934:

    # oma "¿Crees que Amanda y Eva tenían prisa por montar una fiesta nudista en la piscina para convencer a [mar]?"
    oma "Pensez-vous qu'Amanda et Eva étaient pressées d'organiser une pool party nudiste pour convaincre [mar] ?"

# game/scripts/c19/c19.rpy:3983
translate french c19s006_Alexia_c8ef89b7:

    # mc "Es decir, nos han dejado solos a propósito."
    mc "Autrement dit, ils nous ont délibérément laissés tranquilles."

# game/scripts/c19/c19.rpy:3985
translate french c19s006_Alexia_0e364b63:

    # oma "Igual que Maddie, Debbie, y Lisa. Se han ido cuando te han visto dirigirte aquí, mientras hablabas con Betty, Kim, y [mar]."
    oma "Tout comme Maddie, Debbie et Lisa. Elles sont parties quand elles t'ont vu venir par ici, pendant que tu parlais à Betty, Kim et [mar]."

# game/scripts/c19/c19.rpy:3987
translate french c19s006_Alexia_09c9f742:

    # oma "Hemos decidido, sin tener que hablarlo, darnos privacidad las unas a las otras, ahora que todo el mundo sabe con quién sales."
    oma "Nous avons décidé, sans avoir à en parler, de nous accorder un peu d'intimité, maintenant que tout le monde sait avec qui tu sors."

# game/scripts/c19/c19.rpy:3989
translate french c19s006_Alexia_05f94fd1:

    # oma "Como puedes ver, incluso entre las chicas de tu harén."
    oma "Comme vous pouvez le constater, même parmi les filles de votre harem."

# game/scripts/c19/c19.rpy:3991
translate french c19s006_Alexia_0afde92b:

    # oma "Ahora que todo el mundo sabe que estamos juntos, nos van a dar privacidad. No ha hecho falta ni siquiera hablarlo."
    oma "Maintenant que tout le monde sait qu'on est ensemble, ils vont nous laisser tranquilles. On n'a même pas eu besoin d'en parler."

# game/scripts/c19/c19.rpy:3992
translate french c19s006_Alexia_efcc6d4c:

    # mc "¿Me estás diciendo que nadie se va a asomar desde una ventana de mi casa? Antes Debbie te ha visto desnuda aquí desde su habitación."
    mc "Vous voulez me faire croire que personne ne va regarder par la fenêtre de ma maison ? Debbie vous a vu nu ici, depuis sa chambre, tout à l’heure."

# game/scripts/c19/c19.rpy:3994
translate french c19s006_Alexia_b6cf54a9:

    # oma "Sí, lo del gato negro. *Risa* Me lo ha contado. Estaba sentada ahí arriba."
    oma "Oui, celle avec le chat noir. *Rires* C'est elle qui me l'a racontée. J'étais assise là-haut."

# game/scripts/c19/c19.rpy:3996
translate french c19s006_Alexia_c2adf9f4:

    # oma "Y no, nadie lo va a hacer, a menos que tengan un fetiche voyeur. Y la primera vez que tuvimos sexo fue en el prado, donde nos podía ver cualquiera."
    oma "Et non, personne ne le fera, à moins d'avoir un fétichisme voyeuriste. Et la première fois qu'on a fait l'amour, c'était dans la prairie, à la vue de tous."

# game/scripts/c19/c19.rpy:3997
translate french c19s006_Alexia_fed7923c:

    # oma "No me importa si alguien quiere mirarnos, si a ti no te importa. Incluso la posibilidad de que Yaya Olivia nos vea desde la escalera me está poniendo más cachonda aún."
    oma "Peu m'importe si quelqu'un veut nous observer, si ça ne vous dérange pas. Même la simple possibilité que grand-mère Olivia nous voie depuis l'escalier m'excite encore plus."

# game/scripts/c19/c19.rpy:3998
translate french c19s006_Alexia_60cb061e:

    # mc "*Risa* La pobre mujer se ha librado del cáncer y quieres matarla de un infarto..."
    mc "*Rires* La pauvre femme a échappé au cancer et vous voulez la tuer d'une crise cardiaque..."

# game/scripts/c19/c19.rpy:4000
translate french c19s006_Alexia_35d3de1c:

    # oma "*Risa* No, pero no me importaría que se le alegrara la vista."
    oma "*Rires* Non, mais ça ne me dérangerait pas si ça lui faisait plaisir d'égayer sa journée."

# game/scripts/c19/c19.rpy:4002
translate french c19s006_Alexia_5e60d80b:

    # oma "Y a ti también te está poniendo cachondo que nos vea Olivia por lo que veo. Mjolnir acaba de saltar en mi mano."
    oma "Et je vois bien qu'Olivia t'excite aussi en nous regardant. Mjolnir m'a sauté dans la main."

# game/scripts/c19/c19.rpy:4003
translate french c19s006_Alexia_3114b7c8:

    # mc "No, no es por Meemaw. Es que llevas un par de minutos con Mjolnir en la mano. Creo que está pidiendo que la muevas."
    mc "Non, ce n'est pas à cause de Mémé. C'est juste que tu tiens Mjolnir depuis quelques minutes. Je crois qu'il te supplie de le bouger."

# game/scripts/c19/c19.rpy:4005
translate french c19s006_Alexia_c56c96d8:

    # oma "Eso tiene fácil solución. Tengo muchas ganas de hacer esto."
    oma "C'est facile à régler. J'ai vraiment hâte de m'y mettre."

# game/scripts/c19/c19.rpy:4006
translate french c19s006_Alexia_41fb0d50:

    # "Alexia empieza a subir y bajar su mano a lo largo de tu astil, ya duro del todo."
    "Alexia commence à faire glisser sa main de haut en bas le long de votre verge, maintenant complètement dure."

# game/scripts/c19/c19.rpy:4007
translate french c19s006_Alexia_9c11f718:

    # oma "Desde que has llegado no podía esperar a que las chicas se marcharan para quedarnos solos."
    oma "Depuis ton arrivée, j'avais hâte que les filles partent pour qu'on puisse être seuls."

# game/scripts/c19/c19.rpy:4008
translate french c19s006_Alexia_e4cb0d29:

    # mc "Si lo hubieras dicho, hubiéramos podido subir a mi habitación."
    mc "Si tu l'avais dit, nous aurions pu monter dans ma chambre."

# game/scripts/c19/c19.rpy:4009
translate french c19s006_Alexia_c2654f9d:

    # "Su mano aprieta más por un segundo, casi un gesto involuntario de rechazo."
    "Sa main se crispe un instant, presque dans un geste involontaire de rejet."

# game/scripts/c19/c19.rpy:4010
translate french c19s006_Alexia_af3cb1b3:

    # oma "Hoy quería que fuera aquí."
    oma "Aujourd'hui, je voulais que ce soit ici."

# game/scripts/c19/c19.rpy:4012
translate french c19s006_Alexia_80a9c2d3:

    # oma "Nuestras dos veces juntos han sido al aire libre, en el prado y en el lago."
    oma "Nos deux sorties ensemble ont eu lieu en plein air, dans la prairie et au bord du lac."

# game/scripts/c19/c19.rpy:4014
translate french c19s006_Alexia_0d02f83f:

    # oma "Nuestra primera vez fue al aire libre, en el prado."
    oma "Notre première fois, c'était en extérieur, dans la prairie."

# game/scripts/c19/c19.rpy:4017
translate french c19s006_Alexia_ea31e48a:

    # oma "Hoy, el día de la revelación secretos, tenía que ser también en un sitio al aire libre. Y siempre he querido hacer el amor en un jacuzzi."
    oma "Aujourd'hui, jour de la révélation du secret, il fallait que ce soit dehors. Et j'ai toujours rêvé de faire l'amour dans un jacuzzi."

# game/scripts/c19/c19.rpy:4018
translate french c19s006_Alexia_9761958d:

    # oma "Lo que no me esperaba es tener que hacer todo el trabajo yo. *Risa*"
    oma "Ce à quoi je ne m'attendais pas, c'était de devoir tout faire moi-même. *Rires*"

# game/scripts/c19/c19.rpy:4019
translate french c19s006_Alexia_2cc2cc43:

    # mc "Eso es fácil de arreglar..."
    mc "C'est facile à réparer..."

# game/scripts/c19/c19.rpy:4022
