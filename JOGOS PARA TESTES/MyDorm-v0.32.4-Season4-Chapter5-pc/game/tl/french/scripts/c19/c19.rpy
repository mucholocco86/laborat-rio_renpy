    # mc "Bueno, yo os dejo discutiendo la logística. Voy a saludar por allí."
    mc "Très bien, je vous laisse vous occuper des détails logistiques. Je vais vous saluer là-bas."

# game/scripts/c19/c19.rpy:1076
translate french c19s003_Gifts_2b739f1b:

    # mcp "(Si no puedes con ellos, desvía la atención hacia uno de ellos.)"
    mcp "(Si vous ne parvenez pas à les gérer, concentrez-vous sur l'un d'eux.)"

# game/scripts/c19/c19.rpy:1078
translate french c19s003_Gifts_cc2c5edb:

    # bet "Luego tengo que hablar contigo, [mc]."
    bet "Alors j'ai besoin de te parler, [mc]."

# game/scripts/c19/c19.rpy:1079
translate french c19s003_Gifts_3d7fbf62:

    # mc "Cuando quieras, dime que necesitas."
    mc "N'hésitez pas à me dire ce dont vous avez besoin, quand vous le souhaitez."

# game/scripts/c19/c19.rpy:1080
translate french c19s003_Gifts_369e3228:

    # bet "Luego. En privado."
    bet "Plus tard. En privé."

# game/scripts/c19/c19.rpy:1081
translate french c19s003_Gifts_46249754:

    # mc "Perfecto. ¿Después de los regalos?"
    mc "Parfait. Après les cadeaux ?"

# game/scripts/c19/c19.rpy:1082
translate french c19s003_Gifts_5f64dbe0:

    # bet "Vale."
    bet "D'accord."

# game/scripts/c19/c19.rpy:1084
translate french c19s003_Gifts_452f0448:

    # mc "¿Cómo lo estáis pasando?"
    mc "Comment allez-vous tous ?"

# game/scripts/c19/c19.rpy:1085
translate french c19s003_Gifts_7823ff68:

    # kim "¡Es impresionante! Nunca había estado en una fiesta familiar tan grande."
    kim "C'est incroyable ! Je n'ai jamais assisté à une fête de famille aussi grande."

# game/scripts/c19/c19.rpy:1086
translate french c19s003_Gifts_77125091:

    # mom "Todo está saliendo bien, la comida no está demasiado fría, ni la bebida demasiado caliente, con lo que no me puedo quejar. Cocinar para 24 personas es complicado."
    mom "Tout se passe bien ; la nourriture n’est ni trop froide, ni les boissons trop chaudes, donc je n’ai pas à me plaindre. Cuisiner pour 24 personnes, c’est compliqué."

# game/scripts/c19/c19.rpy:1087
translate french c19s003_Gifts_ebf8d108:

    # mom "No había cocinado para tanta gente desde que dejé de trabajar."
    mom "Je n'avais pas cuisiné pour autant de personnes depuis que j'avais arrêté de travailler."

# game/scripts/c19/c19.rpy:1088
translate french c19s003_Gifts_8d59ca67:

    # sam "Y además teniendo que hacer opciones veganas para Lisa. [nor] y tu madre se han lucido."
    sam "Et en plus de ça, il faut préparer des options végétaliennes pour Lisa. [nor] et ta mère se sont vraiment surpassées."

# game/scripts/c19/c19.rpy:1090
translate french c19s003_Gifts_0e9d180a:

    # sam "Por no hablar del arroz hervido para Simone a última hora. ¡Pobre hija mía! Se está perdiendo esta comida deliciosa."
    sam "Sans parler du riz blanc cuit à la dernière minute pour Simone. Ma pauvre fille ! Elle rate ce délicieux repas."

# game/scripts/c19/c19.rpy:1091
translate french c19s003_Gifts_5c517b7b:

    # mc "Está todo genial, Mamá. ¿Cuántos sois en vuestras reuniones familiares, Kim?"
    mc "Tout va bien, maman. Kim, combien d'entre vous sont présents aux réunions de famille ?"

# game/scripts/c19/c19.rpy:1093
translate french c19s003_Gifts_cdf6c120:

    # kim "Mi padre, mi madrastra, mi abuelo, mi hermano y yo."
    kim "Mon père, ma belle-mère, mon grand-père, mon frère et moi."

# game/scripts/c19/c19.rpy:1094
translate french c19s003_Gifts_1c57be3a:

    # mcp "(No hay madre en esa frase...)"
    mcp "(Il n'y a pas de mère dans cette phrase...)"

# game/scripts/c19/c19.rpy:1095
translate french c19s003_Gifts_f92831f0:

    # "Kim parece leerte el pensamiento sin que tengas que pronunciar una palabra."
    "Kim semble lire dans vos pensées sans que vous ayez à dire un mot."

# game/scripts/c19/c19.rpy:1096
translate french c19s003_Gifts_6cafd409:

    # kim "Mi madre no está entre nosotros desde que nació mi hermano, cuando yo tenía dos años."
    kim "Ma mère n'a pas été avec nous depuis la naissance de mon frère, quand j'avais deux ans."

# game/scripts/c19/c19.rpy:1098
translate french c19s003_Gifts_5d140d85:

    # mom "¡Oh, mi niña! ¡No lo sabía! ¡Lo siento mucho!"
    mom "Oh, mon enfant ! Je ne savais pas ! Je suis vraiment désolée !"

# game/scripts/c19/c19.rpy:1099
translate french c19s003_Gifts_3be81e5f:

    # kim "No pasa nada, [mar]. No la recuerdo. Solo he visto fotos y videos suyos. Era guapísima."
    kim "C'est bon, [mar]. Je ne me souviens pas d'elle. Je n'ai vu que des photos et des vidéos. Elle était magnifique."

# game/scripts/c19/c19.rpy:1100
translate french c19s003_Gifts_e43896b5:

    # mom "Como tú, mi niña. Como tú."
    mom "Tout comme toi, ma chérie. Tout comme toi."

# game/scripts/c19/c19.rpy:1102
translate french c19s003_Gifts_62946987:

    # sam "Si algún día quieres hablar de ello, sabes que nos tienes aquí para lo que necesites."
    sam "Si jamais vous souhaitez en parler, vous savez que vous pouvez compter sur nous pour tout ce dont vous avez besoin."

# game/scripts/c19/c19.rpy:1103
translate french c19s003_Gifts_fee9f069:

    # kim "Gracias, Samantha, pero ya os digo que no os tenéis que preocupar. Hace mucho..."
    kim "Merci, Samantha, mais je te dis, ne t'inquiète pas. Ça fait longtemps…"

# game/scripts/c19/c19.rpy:1104
translate french c19s003_Gifts_8fdf2e6d:

    # mc "Puede que haga mucho, pero..."
    mc "Cela peut faire beaucoup de choses, mais..."

# game/scripts/c19/c19.rpy:1106
translate french c19s003_Gifts_fb16c012:

    # kim "*Risa* Sí, [mc]. Hay que hablarlo todo. Lo sé."
    kim "*Rires* Oui, [mc]. Il faut qu'on discute de tout ça. Je sais."

# game/scripts/c19/c19.rpy:1107
translate french c19s003_Gifts_22a79e71:

    # sam "Tu manía de hablarlo todo le ha devuelto la sonrisa. *Risa* Tenía que servir de algo."
    sam "Ton habitude de parler de tout lui a redonné le sourire. *Rires* Ça a forcément servi à quelque chose."

# game/scripts/c19/c19.rpy:1108
translate french c19s003_Gifts_d6f34000:

    # mom "¿Por qué no vas a ver cómo les va a Eva y Amanda? Creo que esta comida también puede ser un poco abrumadora para ellas siendo su primera fiesta... normal."
    mom "Pourquoi n'irais-tu pas voir comment vont Eva et Amanda ? Je pense que ce repas risque d'être un peu impressionnant pour elles aussi, vu que c'est leur première fête… ce qui est tout à fait normal."

# game/scripts/c19/c19.rpy:1109
translate french c19s003_Gifts_8d027de7:

    # mcp "(Eso es lo más parecido a ordenarme que las deje solas que voy a oír. No quiere que Kim se sienta mal, pero quiere hablar con ella sin que yo esté delante.)"
    mcp "(C'est ce qui ressemble le plus à un ordre de les laisser tranquilles que je vais entendre. Elle ne veut pas que Kim se sente mal, mais elle veut lui parler sans moi.)"

# game/scripts/c19/c19.rpy:1110
translate french c19s003_Gifts_8bda4aa7:

    # mc "Voy a ver cómo se lo están pasando. Hablamos luego."
    mc "Je vais voir comment ils vont. On en reparle plus tard."

# game/scripts/c19/c19.rpy:1112
translate french c19s003_Gifts_4b10166f:

    # mc "Están dos pelirrojas y una rubia en la puerta de un garaje... casi podría parecer el inicio de un chiste."
    mc "Il y a deux rousses et une blonde devant une porte de garage… on dirait presque le début d’une blague."

# game/scripts/c19/c19.rpy:1113
translate french c19s003_Gifts_29292411:

    # eva "Y una de las pelirrojas mata al humorista y se acaba el chiste. *Risa*"
    eva "Et une des rousses tue le comédien, et la blague est finie. *Rires*"

# game/scripts/c19/c19.rpy:1114
translate french c19s003_Gifts_3bd5ec2f:

    # sca "No me acaba de gustar ese final, Eva. Yo estaba pensando en tirar al humorista a la piscina. *Risa*"
    sca "Je n'aime pas vraiment cette fin, Eva. J'avais envie de jeter le comédien dans la piscine. *Rires*"

# game/scripts/c19/c19.rpy:1115
translate french c19s003_Gifts_c43d530c:

    # eil "Esperad un momento... ¿Vosotras le habéis dado el beso de buenos días?"
    eil "Attends une minute… Tu lui as donné un bisou pour lui dire bonjour ?"

# game/scripts/c19/c19.rpy:1117
translate french c19s003_Gifts_de2ded86:

    # eva "Cuando hemos llegado. Después de que [emm] nos presentara a Simone."
    eva "À notre arrivée. Après que [emm] nous ait présenté Simone."

# game/scripts/c19/c19.rpy:1118
translate french c19s003_Gifts_08e8802a:

    # sca "Yo esta mañana... cuando me lo he cruzado en la cocina."
    sca "Ce matin… quand je l’ai croisé dans la cuisine."

# game/scripts/c19/c19.rpy:1119
translate french c19s003_Gifts_5410d897:

    # eil "Pues no os dejo que lo matéis ni que lo tiréis a la piscina antes de mi beso. *Risa*"
    eil "Bon, je ne te laisserai pas le tuer ni le jeter dans la piscine avant de l'avoir embrassé. *Rires*"

# game/scripts/c19/c19.rpy:1121
translate french c19s003_Gifts_86ac7e6b:

    # eil "Buenos días, [mc]."
    eil "Bonjour, [mc]."

# game/scripts/c19/c19.rpy:1122
translate french c19s003_Gifts_36356f93:

    # mc "Buenos días, Eileen."
    mc "Bonjour Eileen."

# game/scripts/c19/c19.rpy:1124
translate french c19s003_Gifts_7af1ee95:

    # eil "Vale, todo vuestro. Merece una muerte horrible por empezar ese chiste. No puede definirnos por nuestro color de pelo. Yo soy algo más que una maravillosa pelirroja. *Risa*"
    eil "D'accord, c'est à toi. Elle mérite une mort horrible pour avoir lancé cette blague. Elle ne peut pas nous réduire à notre couleur de cheveux. Je suis bien plus qu'une simple rousse magnifique. *Rires*"

# game/scripts/c19/c19.rpy:1126
translate french c19s003_Gifts_164935f5:

    # eva "Creo que su sangre podría estropear el cumpleaños un poquito. Ya sabes, Alexia tendría que investigar en vez de seguir disfrutando de la comida. *Risa*"
    eva "Je pense que son sang risque de gâcher un peu l'anniversaire. Tu sais, Alexia devrait faire des recherches au lieu de simplement profiter du repas. *Rires*"

# game/scripts/c19/c19.rpy:1127
translate french c19s003_Gifts_842436bf:

    # eva "[mar] y [nor] se pondrían a limpiar. Es posible que alguna chica se pusiera triste... Mejor dejamos el asesinato para otro día. *Risa*"
    eva "[mar] et [nor] commenceraient à nettoyer. Une fille pourrait être triste… Laissons le meurtre pour un autre jour. *Rires*"

# game/scripts/c19/c19.rpy:1128
translate french c19s003_Gifts_69dd8f15:

    # mc "Muy graciosa..."
    mc "Très drôle..."

# game/scripts/c19/c19.rpy:1130
translate french c19s003_Gifts_7cf5470b:

    # sca "Y si lo tiramos a la piscina... ¿cuánto pesa? Seguro que salpica mucho y le moja la comida a alguien. *Risa*"
    sca "Et si on le jette dans la piscine… combien ça pèse ? Je suis sûr que ça va faire plein d’éclaboussures et mouiller la nourriture de quelqu’un. *Rires*"

# game/scripts/c19/c19.rpy:1131
translate french c19s003_Gifts_6e285c12:

    # mc "¡Por Dios! Creía que el grupo peligroso era el de Jamaal y Kate."
    mc "Oh mon Dieu ! Je croyais que le groupe dangereux était celui de Jamaal et Kate."

# game/scripts/c19/c19.rpy:1133
translate french c19s003_Gifts_0d28448b:

    # eil "Pobrecitos, suficiente tienen con aguantar el monokini de Jam. *Risa* Pero te lo tienes merecido por todos los años en los que te has metido con Jamaal."
    eil "Pauvres chéries, elles ont déjà bien assez à faire avec le monokini de Jam. *Rires* Mais vous l'avez bien cherché après toutes ces années à embêter Jamaal."

# game/scripts/c19/c19.rpy:1134
translate french c19s003_Gifts_9f42bcd6:

    # sca "Y Kate es un amor. Nunca se mete con nadie que no sea ella misma. *Risa*"
    sca "Et Kate est un amour. Elle ne dérange jamais personne d'autre qu'elle-même. *Rires*"

# game/scripts/c19/c19.rpy:1135
translate french c19s003_Gifts_e7b92bbc:

    # eva "Bueno, yo tengo algunas grabaciones de Kate metiéndose con [mc]. *Risa* Son relevantes para vuestra protección. O, al menos, la de [mc]."
    eva "Eh bien, j'ai des enregistrements de Kate en train de s'amuser avec [mc]. *Rires* Ils sont importants pour votre protection. Ou du moins pour celle de [mc]."

# game/scripts/c19/c19.rpy:1136
translate french c19s003_Gifts_b912b637:

    # eva "Esa chica puede ser una fiera. *Risa*"
    eva "Cette fille peut être assez exubérante. *Rires*"

# game/scripts/c19/c19.rpy:1137
translate french c19s003_Gifts_3825f6bb:

    # mc "*Risa* Me parece que voy a seguir mi ronda con el resto de las chicas. Algún sitio donde me dejen respirar."
    mc "*Rires* Je crois que je vais continuer ma tournée avec les autres filles. Au moins, elles me laisseront respirer un peu."

# game/scripts/c19/c19.rpy:1138
translate french c19s003_Gifts_c2076849:

    # mc "Os veo luego. Y... Eva, luego quiero hablar en privado con Amanda y contigo. Después de los regalos."
    mc "À plus tard. Et… Eva, je voudrais parler à Amanda et à toi en privé plus tard. Après les cadeaux."

# game/scripts/c19/c19.rpy:1140
translate french c19s003_Gifts_d994e5b8:

    # eva "¿Sobre qué? Amanda y yo aún no hemos acabado de aclarar lo que hablamos anoche..."
    eva "À propos de quoi ? Amanda et moi n'avons toujours pas fini de clarifier ce dont nous avons parlé hier soir..."

# game/scripts/c19/c19.rpy:1141
translate french c19s003_Gifts_063fe740:

    # mc "¿Sabes lo malo de amenazar con asesinarme? Que ahora puedo tenerte intrigada hasta que tengamos esa conversación. *Risa*"
    mc "Tu sais ce qu'il y a de mal à me menacer de mort ? Je peux te tenir en haleine jusqu'à ce qu'on ait enfin cette conversation. *Rires*"

# game/scripts/c19/c19.rpy:1142
translate french c19s003_Gifts_54279f0a:

    # mc "Y con ganas de más..."
    mc "Et j'en veux plus..."

# game/scripts/c19/c19.rpy:1143
translate french c19s003_Gifts_f3b5f675:

    # mc "Hasta luego chicas."
    mc "À plus tard, les filles."

# game/scripts/c19/c19.rpy:1145
translate french c19s003_Gifts_8b2f8c2f:

    # "Te giras sin darle tiempo a contestar (o a asesinarte) y te diriges al siguiente grupo."
    "Vous faites demi-tour sans leur laisser le temps de répondre (ou de vous tuer) et vous vous dirigez vers le groupe suivant."

# game/scripts/c19/c19.rpy:1146
translate french c19s003_Gifts_0744ac4c:

    # mc "Hola, chicas. Felicidades, [eri]. Antes te has llevado a Maddie tan rápido que no me ha dado tiempo de felicitarte."
    mc "Salut les filles. Félicitations, [eri]. Vous avez emmené Maddie si vite tout à l'heure que je n'ai pas eu le temps de vous féliciter."

# game/scripts/c19/c19.rpy:1147
translate french c19s003_Gifts_7c512e3c:

    # meg "¡Qué maleducado por tu parte, [mc]! *Risa* Y además llegas aquí y no nos das los buenos días a ninguna."
    meg "Quelle impolitesse de ta part, [mc] ! *Rires* Et tu viens ici et tu ne dis même pas bonjour à aucun d'entre nous."

# game/scripts/c19/c19.rpy:1148
translate french c19s003_Gifts_1c14653f:

    # lis "Dice que es el hombre de la casa y esas cosas. *Risa* Y tiene aquí a tres damiselas desatendidas."
    lis "Il se prend pour le chef de famille, et tout ça. *Rires* Et il a trois demoiselles délaissées ici."

# game/scripts/c19/c19.rpy:1149
translate french c19s003_Gifts_29c11cbb:

    # eri "Como es mi cumpleaños, reclamo el primer beso. *Risa* Después os lo presto un rato."
    eri "Puisque c'est mon anniversaire, je revendique le premier baiser. *Rires* Je vous le prêterai un petit moment plus tard."

# game/scripts/c19/c19.rpy:1151
translate french c19s003_Gifts_bb2d882b:

    # mc "Felicidades, [eri]."
    mc "Félicitations, [eri]."

# game/scripts/c19/c19.rpy:1152
translate french c19s003_Gifts_44152844:

    # eri "Gracias, [mc]. Más vale que las beses también a ellas si no quieres que no llegue a mañana a cumplir los 19."
    eri "Merci, [mc]. Tu ferais mieux de les embrasser aussi si tu ne veux pas que je rate mon 19e anniversaire demain."

# game/scripts/c19/c19.rpy:1154
translate french c19s003_Gifts_b9f68b48:

    # mc "Buenos días, Lisa. ¿Cuánto habéis bebido?"
    mc "Bonjour Lisa. Tu as beaucoup bu ?"

# game/scripts/c19/c19.rpy:1155
translate french c19s003_Gifts_41e50b3f:

    # lis "Buenos días. Megan y [eri] no quieren beber, con lo que yo tengo que beber por las tres, ¿no?"
    lis "Bonjour. Megan et [eri] ne veulent pas boire, donc je dois boire pour elles trois, c'est bien ça ?"

# game/scripts/c19/c19.rpy:1156
translate french c19s003_Gifts_0ecf28f9:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Vous savez que ce n'est pas nécessaire, n'est-ce pas ?"

# game/scripts/c19/c19.rpy:1157
translate french c19s003_Gifts_05aba25f:

    # lis "No te preocupes, tan solo he bebido tres copas de vino."
    lis "Ne t'inquiète pas, je n'ai bu que trois verres de vin."

# game/scripts/c19/c19.rpy:1159
translate french c19s003_Gifts_c81b117b:

    # mc "Buenos días, Megan. Gracias por lo de anoche en el Jazz Corner."
    mc "Bonjour Megan. Merci pour hier soir au Jazz Corner."

# game/scripts/c19/c19.rpy:1160
translate french c19s003_Gifts_58d15963:

    # meg "Buenos días, [mc]. Era el cumpleaños de tres de mis chicas favoritas, es lo menos que podía hacer."
    meg "Bonjour, [mc]. C'était l'anniversaire de trois de mes filles préférées, c'est le moins que je puisse faire."

# game/scripts/c19/c19.rpy:1162
translate french c19s003_Gifts_53439648:

    # mc "¿Estabais hablando de algo en lo que pueda participar? ¿O me vais a echar como han hecho el resto?"
    mc "Vous parliez de quelque chose auquel je pourrais participer ? Ou vous allez me mettre à la porte comme tout le monde ?"

# game/scripts/c19/c19.rpy:1163
translate french c19s003_Gifts_a8d5d0d3:

    # eri "Estábamos hablando del topless."
    eri "Nous parlions de seins nus."

# game/scripts/c19/c19.rpy:1164
translate french c19s003_Gifts_83d0c4f3:

    # meg "Se han apuntado muchas más chicas de lo que cualquiera de nosotras había pensado."
    meg "Beaucoup plus de filles se sont inscrites que nous ne l'avions imaginé."

# game/scripts/c19/c19.rpy:1165
translate french c19s003_Gifts_ba742736:

    # lis "Y alguna que las tres pensábamos que lo haría, como Eva, no lo ha hecho."
    lis "Et certaines personnes que nous pensions toutes les trois capables de le faire, comme Eva, ne l'ont pas fait."

# game/scripts/c19/c19.rpy:1166
translate french c19s003_Gifts_9b5969f4:

    # mc "¿Quién os ha sorprendido más de las que se han apuntado?"
    mc "Parmi les personnes inscrites, qui vous a le plus surpris ?"

# game/scripts/c19/c19.rpy:1168
translate french c19s003_Gifts_a6d298e5:

    # eri "Yo no pensaba que [dap] fuera a hacerlo. Demasiada atención sobre ella el día que tiene que abrir los regalos."
    eri "Je ne pensais pas que [dap] allait le faire. On va trop s'occuper d'elle le jour où elle devra ouvrir ses cadeaux."

# game/scripts/c19/c19.rpy:1169
translate french c19s003_Gifts_f5e8f977:

    # mc "Creo que era muy consciente de por qué lo pediste, con lo que creo que también quería apoyar a tu madre."
    mc "Je pense qu'il était parfaitement conscient de la raison pour laquelle vous l'aviez demandé, et je pense donc qu'il voulait aussi soutenir votre mère."

# game/scripts/c19/c19.rpy:1170
translate french c19s003_Gifts_c0c5a33a:

    # eri "Es posible..."
    eri "C'est possible..."

# game/scripts/c19/c19.rpy:1172
translate french c19s003_Gifts_406ae3fe:

    # lis "A mí me ha sorprendido mucho Alexia. Cuando la conocí parecía tan seria y profesional, que no me la imaginaba así."
    lis "Alexia m'a beaucoup surprise. Quand je l'ai rencontrée, elle paraissait si sérieuse et professionnelle ; je ne l'imaginais pas comme ça."

# game/scripts/c19/c19.rpy:1173
translate french c19s003_Gifts_538a8eab:

    # lis "Después hemos hablado mucho y sé que es muy abierta y simpática, pero esa primera impresión sigue contando para mí."
    lis "Nous avons beaucoup parlé depuis et je sais qu'elle est très ouverte et amicale, mais la première impression compte toujours pour moi."

# game/scripts/c19/c19.rpy:1174
translate french c19s003_Gifts_a238acdc:

    # mc "Alexia puede ser una caja de sorpresas. Después iré a hablar con ella."
    mc "Alexia peut être pleine de surprises. J'irai lui parler plus tard."

# game/scripts/c19/c19.rpy:1176
translate french c19s003_Gifts_497ec1ea:

    # meg "A mí me ha sorprendido Kim. Si yo tuviera un cuerpo tan perfecto como el suyo, no dudaría en enseñarlo."
    meg "Kim m'a surprise. Si j'avais un corps aussi parfait que le sien, je n'hésiterais pas à le montrer."

# game/scripts/c19/c19.rpy:1177
translate french c19s003_Gifts_341cd6f6:

    # mc "Estaba preocupada por ser la única en no hacerlo, y pese a todo no lo ha hecho, con lo que debe ser importante para ella."
    mc "Elle craignait d'être la seule à ne pas le faire, et pourtant elle ne l'a pas fait, donc cela doit être important pour elle."

# game/scripts/c19/c19.rpy:1178
translate french c19s003_Gifts_13280cd3:

    # meg "Tienes razón, no lo había pensado así. ¿Y a ti? ¿Quién te ha sorprendido más?"
    meg "Tu as raison, je n'y avais pas pensé. Et toi ? Qui t'a le plus surpris ?"

# game/scripts/c19/c19.rpy:1179
translate french c19s003_Gifts_e7898737:

    # mc "Samantha y Simone. Si me hubieran preguntado ayer, hubiera dicho que las dos habrían hecho justo lo contrario de lo que han hecho."
    mc "Samantha et Simone. Si vous m'aviez posé la question hier, j'aurais dit qu'elles auraient fait exactement le contraire."

# game/scripts/c19/c19.rpy:1181
translate french c19s003_Gifts_b41f859c:

    # lis "Ahora sólo falta que se acabe la comida y empezar a abrir regalos. Tengo ganas de saber si hemos acertado con lo que les hemos regalado a las chicas."
    lis "Il ne reste plus qu'à attendre la fin du repas pour pouvoir ouvrir les cadeaux. J'ai hâte de voir si nous avons fait les bons choix pour les filles."

# game/scripts/c19/c19.rpy:1182
translate french c19s003_Gifts_8865ba85:

    # eri "Los regalos son lo de menos. Yo cambiaría todos los regalos por poder repetir esto más a menudo."
    eri "Les cadeaux sont ce qui compte le moins. J'échangerais tous les cadeaux contre la possibilité de faire ça plus souvent."

# game/scripts/c19/c19.rpy:1183
translate french c19s003_Gifts_1f0e072c:

    # meg "Tú quieres que no entre en ninguno de mis vestidos del trabajo. *Risa* [nor] y [mar] cocinan demasiado bien para mí."
    meg "Tu veux que je ne rentre plus dans aucune de mes robes de travail ? *Rires* [nor] et [mar] cuisinent beaucoup trop bien pour moi."

# game/scripts/c19/c19.rpy:1184
translate french c19s003_Gifts_92b01289:

    # mc "Con los que somos aquí, habrá celebraciones de sobras solamente con los cumpleaños. Suma el 4 de julio, Acción de gracias, Navidad, Nochevieja..."
    mc "Vu le nombre de personnes présentes, les anniversaires ne manqueront pas de faire la fête. Sans compter le 4 juillet, Thanksgiving, Noël, le Nouvel An…"

# game/scripts/c19/c19.rpy:1185
translate french c19s003_Gifts_ffdbdeae:

    # mc "No vamos a ir cortos de celebraciones los próximos meses."
    mc "Les occasions de célébrer ne manqueront pas dans les mois à venir."

# game/scripts/c19/c19.rpy:1187
translate french c19s003_Gifts_bb54d10e:

    # meg "Es fantástico, aunque tenga que comprar vestuario nuevo. *Risa*"
    meg "C'est fantastique, même si je dois acheter de nouveaux vêtements. *Rires*"

# game/scripts/c19/c19.rpy:1188
translate french c19s003_Gifts_95f51cf3:

    # lis "Tengo ganas de pasar Nochevieja con vosotros. Me gustan más las fiestas con vestido formal que en bikini, aunque me podría acostumbrar."
    lis "J'ai hâte de passer le réveillon du Nouvel An avec vous tous. Je préfère les soirées en robe de soirée plutôt qu'en bikini, même si je pourrais m'y faire."

# game/scripts/c19/c19.rpy:1189
translate french c19s003_Gifts_0b82ebad:

    # eri "Pues te llevarás una sorpresa. Lo solemos celebrar en pijama. *Risa*"
    eri "Eh bien, tu vas avoir une surprise. D'habitude, on fête ça en pyjama. *Rires*"

# game/scripts/c19/c19.rpy:1190
translate french c19s003_Gifts_27059b6c:

    # mc "¿No vais a volver a Aurora para Navidad?"
    mc "Tu ne retournes pas à Aurora pour Noël ?"

# game/scripts/c19/c19.rpy:1192
translate french c19s003_Gifts_2d57d172:

    # lis "Debbie y yo hemos estado hablando sobre eso. Seguramente pasemos Acción de Gracias y Navidad con mis padres, pero querríamos estar aquí para Nochevieja."
    lis "Debbie et moi en avons parlé. Nous passerons probablement Thanksgiving et Noël chez mes parents, mais nous aimerions être ici pour le réveillon du Nouvel An."

# game/scripts/c19/c19.rpy:1193
translate french c19s003_Gifts_f50c83ed:

    # lis "Si no os importa, claro... no sé si el Dormitorio seguirá abierto durante las fiestas."
    lis "Si cela ne vous dérange pas, bien sûr… Je ne sais pas si le dortoir sera encore ouvert pendant les vacances."

# game/scripts/c19/c19.rpy:1194
translate french c19s003_Gifts_8fff7466:

    # mc "Creo que no habrá ningún problema con eso, Lisa."
    mc "Je ne pense pas qu'il y aura de problème avec ça, Lisa."

# game/scripts/c19/c19.rpy:1196
translate french c19s003_Gifts_8089f1ae:

    # meg "¿Os está apeteciendo tanto como a mí empezar a planear todas esas fiestas? *Risa*"
    meg "Vous êtes aussi impatients que moi de commencer à organiser toutes ces fêtes ? *Rires*"

# game/scripts/c19/c19.rpy:1197
translate french c19s003_Gifts_83900991:

    # eri "Es un poco pronto... pero ¡sí! *Risa*"
    eri "C'est un peu tôt... mais oui ! *Rires*"

# game/scripts/c19/c19.rpy:1198
translate french c19s003_Gifts_b0d76e05:

    # lis "Aún no ha acabado tu cumpleaños y ya estamos hablando de las siguientes fiestas. *Risa* El cumpleaños de Debbie es en octubre..."
    lis "Ton anniversaire n'est même pas encore passé et on parle déjà de la prochaine fête ! *Rires* L'anniversaire de Debbie est en octobre..."

# game/scripts/c19/c19.rpy:1199
translate french c19s003_Gifts_b10b012a:

    # mc "Antes van los de Simone y Scarlett. Ya os pasaré una lista, pero si os vais a poner a organizar más fiestas, os voy a dejar y seguir disfrutando de esta."
    mc "Après Simone et Scarlett, c'est au tour. Je t'enverrai la liste plus tard, mais si tu prévois d'autres fêtes, je te laisse t'en occuper et profite bien de celle-ci."

# game/scripts/c19/c19.rpy:1200
translate french c19s003_Gifts_83fb187a:

    # mc "Os veo luego chicas."
    mc "À plus tard, les filles."

# game/scripts/c19/c19.rpy:1202
translate french c19s003_Gifts_d6430870:

    # todas "Hasta luego, [mc]."
    todas "À plus tard, [mc]."

# game/scripts/c19/c19.rpy:1209
translate french c19s003_Gifts_c00541dc:

    # "Pasas a recargar el plato por la mesa de la comida y te acercas al siguiente grupo."
    "Vous faites le tour de la table pour remplir votre assiette et vous vous approchez du groupe suivant."

# game/scripts/c19/c19.rpy:1210
translate french c19s003_Gifts_e7abd37f:

    # mcp "(Me sorprende que Maddie se haya apuntado al topless siendo su primera vez en casa.)"
    mcp "(Je suis surprise que Maddie ait décidé de se mettre seins nus, vu que c'était la première fois qu'elle était à la maison.)"

# game/scripts/c19/c19.rpy:1211
translate french c19s003_Gifts_3e9d00d3:

    # mc "¿Qué tal lo estáis pasando?"
    mc "Comment allez-vous tous ?"

# game/scripts/c19/c19.rpy:1212
translate french c19s003_Gifts_1a1dc6dc:

    # nor "Genial, hay comida de sobras y todo el mundo está divirtiéndose. No se puede pedir más."
    nor "Super, il y a à manger en abondance et tout le monde passe un excellent moment. Que demander de plus ?"

# game/scripts/c19/c19.rpy:1213
translate french c19s003_Gifts_3e62b690:

    # kia "Me encantan estas celebraciones familiares. Eileen me había hablado de ellas hace años, pero no me las imaginaba así."
    kia "J'adore ces fêtes de famille. Eileen m'en avait parlé il y a des années, mais je ne les imaginais pas comme ça."

# game/scripts/c19/c19.rpy:1214
translate french c19s003_Gifts_44148589:

    # mad "Es una inmersión forzada en vuestra familia. *Risa* Aunque conocía a la mayoría de la tienda, no habíamos tenido la oportunidad de hablar mucho."
    mad "C'est une immersion forcée dans votre famille. *Rires* Bien que je connaisse la plupart des gens du magasin, nous n'avions pas vraiment eu l'occasion de discuter."

# game/scripts/c19/c19.rpy:1215
translate french c19s003_Gifts_d9c43713:

    # mc "Espero que no te parezcamos demasiado raros. *Risa*"
    mc "J'espère que nous ne vous paraissons pas trop bizarres. *Rires*"

# game/scripts/c19/c19.rpy:1217
translate french c19s003_Gifts_877f0b76:

    # mc "Veo que el hematoma de tu brazo ha mejorado mucho."
    mc "Je vois que l'ecchymose sur ton bras s'est beaucoup améliorée."

# game/scripts/c19/c19.rpy:1219
translate french c19s003_Gifts_30a60798:

    # kia "Sí, el ungüento de Samantha ha obrado maravillas. Me ha dicho que amarilleará durante unos días y desaparecerá antes del próximo fin de semana."
    kia "Oui, la pommade de Samantha a fait des merveilles. Elle m'a dit que ça jaunirait pendant quelques jours, puis que ça disparaîtrait avant la fin de la semaine prochaine."

# game/scripts/c19/c19.rpy:1220
translate french c19s003_Gifts_17f2ab3a:

    # mc "Eso es fantástico. En una semana ya no nos acordaremos del hematoma."
    mc "C'est fantastique ! Dans une semaine, on aura complètement oublié ce bleu."

# game/scripts/c19/c19.rpy:1222
translate french c19s003_Gifts_b60da254:

    # mad "¿Qué te pasó? ¿Te caíste? Tuvo que ser una caída muy fuerte..."
    mad "Que t'est-il arrivé ? Tu es tombé ? Ça a dû être une sacrée chute…"

# game/scripts/c19/c19.rpy:1223
translate french c19s003_Gifts_0f70d3c3:

    # "Le haces señas de que no continúe por ahí, pero llegas tarde."
    "Vous lui faites signe de ne pas aller par là, mais il est trop tard."

# game/scripts/c19/c19.rpy:1224
translate french c19s003_Gifts_bcdc6fdd:

    # kia "No... es un tema... de mi pasado..."
    kia "Non… c’est un sujet… de mon passé…"

# game/scripts/c19/c19.rpy:1225
translate french c19s003_Gifts_6abb8ee6:

    # mc "Lo tienes que ver así. Algo que pasó y no volverá a pasar. Me ocupare... nos ocuparemos... de que no pase de nuevo."
    mc "Il faut voir les choses ainsi : c’est un événement passé qui ne se reproduira plus. Je ferai en sorte… nous ferons en sorte que cela ne se reproduise plus."

# game/scripts/c19/c19.rpy:1226
translate french c19s003_Gifts_25ea25b9:

    # nor "Aquí estás segura y nadie te volverá a hacer daño. Todos te vamos a proteger"
    nor "Ici, tu es en sécurité, et personne ne te fera plus jamais de mal. Nous allons tous te protéger."

# game/scripts/c19/c19.rpy:1228
translate french c19s003_Gifts_cc8f0d0a:

    # mad "¡Oops! Lo siento, Kiara... no lo sabía..."
    mad "Oups ! Désolée, Kiara... Je ne savais pas..."

# game/scripts/c19/c19.rpy:1229
translate french c19s003_Gifts_de7961c8:

    # mc "Mejor hablar de cosas más alegres, ¿no? Luego traeré tus regalos. Supongo que son los más voluminosos."
    mc "Parlons de choses plus joyeuses, si vous le voulez bien. J'apporterai vos cadeaux plus tard. J'imagine que ce sont les plus encombrants."

# game/scripts/c19/c19.rpy:1231
translate french c19s003_Gifts_6b3579c4:

    # nor "Creo que casi todo el mundo ha comido lo que podía comer ya, con lo que en veinte o treinta minutos haremos la entrega de regalos. Si quieres llevarlos a la pérgola, puedes hacerlo."
    nor "Je pense que presque tout le monde a fini de manger, donc on commencera à distribuer les cadeaux dans une vingtaine ou une trentaine de minutes. Si vous voulez les apporter sous la pergola, n'hésitez pas."

# game/scripts/c19/c19.rpy:1232
translate french c19s003_Gifts_a0d0098b:

    # kia "Yo tengo los míos en mi habitación. También tendré que ir a buscarlos."
    kia "J'ai les miens dans ma chambre. Il faudra que j'aille les chercher aussi."

# game/scripts/c19/c19.rpy:1233
translate french c19s003_Gifts_1938185b:

    # mad "Si quieres te ayudo a traerlos. No pesan, pero son incómodos de llevar para una sola persona."
    mad "Si vous le souhaitez, je peux vous aider à les apporter. Ils ne sont pas lourds, mais il est difficile pour une seule personne de les porter."

# game/scripts/c19/c19.rpy:1234
translate french c19s003_Gifts_7b866421:

    # mc "Perfecto. ¿Vamos?"
    mc "Parfait. On y va ?"

# game/scripts/c19/c19.rpy:1236
translate french c19s003_Gifts_3783c213:

    # "Llevas los regalos de Maddie a la pérgola del fondo del jardín y vas a buscar los tuyos a tu habitación."
    "Tu apportes les cadeaux de Maddie à la pergola au fond du jardin et tu vas dans ta chambre chercher les tiens."

# game/scripts/c19/c19.rpy:1238
translate french c19s003_Gifts_6eced475:

    # "Después te acercas a algunas de las últimas chicas con las que no has hablado aún."
    "Ensuite, vous abordez les dernières filles à qui vous n'avez pas encore parlé."

# game/scripts/c19/c19.rpy:1239
translate french c19s003_Gifts_3a5656ef:

    # mc "¿Qué tal chicas? ¿Ya no coméis?"
    mc "Hé les filles, vous ne mangez plus ?"

# game/scripts/c19/c19.rpy:1240
translate french c19s003_Gifts_c8440b69:

    # sai "Estoy a punto de reventar. Y aún queda el pastel."
    sai "Je suis sur le point d'exploser. Et il reste encore du gâteau."

# game/scripts/c19/c19.rpy:1241
translate french c19s003_Gifts_6896fb67:

    # ama "Con lo que había aquí se podría alimentar a un país pequeño. *Risa*"
    ama "Ce qu'il y avait ici pourrait nourrir un petit pays. *Rires*"

# game/scripts/c19/c19.rpy:1242
translate french c19s003_Gifts_dc8ea16c:

    # mee "Estas chicas están descubriendo cómo nos organizamos cuando hay comida por en medio. *Risa*"
    mee "Ces filles découvrent comment on s'organise quand il s'agit de nourriture. *Rires*"

# game/scripts/c19/c19.rpy:1244
translate french c19s003_Gifts_419fe907:

    # sai "Pero es que es imposible no querer probarlo todo. Cada plato es más delicioso que el anterior."
    sai "Mais il est impossible de ne pas avoir envie de tout goûter. Chaque plat est plus délicieux que le précédent."

# game/scripts/c19/c19.rpy:1245
translate french c19s003_Gifts_91f54910:

    # mc "Hay que hacer sacrificios y renunciar a cosas. Yo era una bola hasta que no lo aprendí. *Risa*"
    mc "Il faut faire des sacrifices et renoncer à certaines choses. J'étais vraiment un vrai fainéant avant de comprendre ça. *Rires*"

# game/scripts/c19/c19.rpy:1246
translate french c19s003_Gifts_f3005491:

    # mc "Por ejemplo, va a haber tres pasteles. Solo hay que comer de uno de ellos. O una porción minúscula de cada una."
    mc "Par exemple, il y aura trois gâteaux. Vous n'aurez à en manger qu'un seul. Ou une toute petite part de chacun."

# game/scripts/c19/c19.rpy:1248
translate french c19s003_Gifts_15f43a02:

    # ama "Es lo que estaba diciéndole a Olivia. No sé cómo puede mantener una figura así, a su edad, si las comidas familiares son así."
    ama "C'est ce que je disais à Olivia. Je ne comprends pas comment elle fait pour garder la ligne à son âge, avec tous ces repas de famille."

# game/scripts/c19/c19.rpy:1249
translate french c19s003_Gifts_10f59ace:

    # ama "Creo que me he engordado un par de kilos desde que os conozco."
    ama "Je crois que j'ai pris quelques kilos depuis que je t'ai rencontré."

# game/scripts/c19/c19.rpy:1250
translate french c19s003_Gifts_462c42be:

    # mc "Bueno, Meemaw tiene un truco, cuando no está con nosotros adelgaza rápidamente. *Pretendiendo susurrar* Cocina fatal cualquier cosa más allá de una ensalada. *Risa*"
    mc "Eh bien, Mémé a un petit secret : quand elle n’est pas avec nous, elle maigrit à vue d’œil. *Fait semblant de chuchoter* Elle cuisine très mal tout ce qui n’est pas une salade. *Rires*"

# game/scripts/c19/c19.rpy:1252
translate french c19s003_Gifts_9aaa3c85:

    # mee "No es cierto del todo. No sabéis apreciar las cualidades del arroz duro o del filete carbonizado. *Risa*"
    mee "Ce n'est pas tout à fait vrai. Vous ne savez pas apprécier les qualités d'un riz dur ou d'un steak grillé. *Rires*"

# game/scripts/c19/c19.rpy:1253
translate french c19s003_Gifts_2080f8d0:

    # mc "Si que sabemos. Como materiales de construcción son geniales. Como alimento... no tanto. *Risa*"
    mc "On le sait. Comme matériaux de construction, ils sont excellents. Comme aliments… beaucoup moins. *Rires*"

# game/scripts/c19/c19.rpy:1255
translate french c19s003_Gifts_1ba13645:

    # sai "¿Y tú? ¿Cómo lo estás pasando? Te hemos visto ir como un pollo sin cabeza entre todas nosotras."
    sai "Et toi ? Comment vas-tu ? On t'a vu courir partout comme une poule sans tête au milieu de nous tous."

# game/scripts/c19/c19.rpy:1256
translate french c19s003_Gifts_d68c062a:

    # ama "Parece que quieras hablar con todas nosotras, pero no te quedas más de cinco o diez minutos con cada grupo."
    ama "Vous semblez vouloir parler à chacun d'entre nous, mais vous ne restez pas plus de cinq ou dix minutes avec chaque groupe."

# game/scripts/c19/c19.rpy:1257
translate french c19s003_Gifts_5e8507c3:

    # mee "Es que [mc] sería el perfecto anfitrión en cualquier fiesta. Quiere que todo el mundo se sienta a gusto y se lo pase bien."
    mee "[mc] serait l'hôte idéal pour n'importe quelle fête. Il souhaite que tout le monde se sente à l'aise et passe un bon moment."

# game/scripts/c19/c19.rpy:1258
translate french c19s003_Gifts_2374f6a3:

    # mc "¿Acaso me perdonaríais si me quedara todo el día charlando con el mismo grupo?"
    mc "Me pardonneriez-vous si je passais toute la journée à discuter avec le même groupe ?"

# game/scripts/c19/c19.rpy:1260
translate french c19s003_Gifts_6535f8f6:

    # ama "*Risa* No, tendríamos que secuestrarte."
    ama "*Rires* Non, il faudrait vous kidnapper."

# game/scripts/c19/c19.rpy:1261
translate french c19s003_Gifts_d267b4bf:

    # sai "Sólo te perdonaríamos si ese grupo fuese el nuestro. *Risa*"
    sai "On ne vous pardonnerait que si ce groupe était le nôtre. *Rires*"

# game/scripts/c19/c19.rpy:1262
translate french c19s003_Gifts_41256648:

    # mee "Y entonces el resto de las mujeres de la familia vendrían a este grupo a secuestrarte y sería lo mismo. *Risa*"
    mee "Et puis les autres femmes de la famille se joindraient à ce groupe pour t'enlever, et ce serait la même chose. *Rires*"

# game/scripts/c19/c19.rpy:1263
translate french c19s003_Gifts_9fc714f5:

    # mee "Por alguna razón, todas queremos nuestra ración de [mc]."
    mee "Pour une raison ou une autre, nous voulons tous notre part de [mc]."

# game/scripts/c19/c19.rpy:1264
translate french c19s003_Gifts_0d20ae82:

    # mc "Lo acabas de decir como si fuera el cuarto pastel de cumpleaños. *Risa*"
    mc "Tu viens de le dire comme si c'était ton gâteau d'anniversaire pour tes quatre ans ! *Rires*"

# game/scripts/c19/c19.rpy:1266
translate french c19s003_Gifts_a10b2e34:

    # "*Ding-Ding-Ding*"
    "*Ding-Ding-Ding*"

# game/scripts/c19/c19.rpy:1267
translate french c19s003_Gifts_01acbf16:

    # mar "¿Podéis prestarnos un momento de atención?"
    mar "Pourriez-vous nous accorder un instant de votre attention ?"

# game/scripts/c19/c19.rpy:1268
translate french c19s003_Gifts_2989b6d2:

    # nor "Nos hemos dado cuenta de que nadie está comiendo ya."
    nor "Nous avons remarqué que plus personne ne mange."

# game/scripts/c19/c19.rpy:1269
translate french c19s003_Gifts_5c4f3b50:

    # mar "Suponemos que os estáis reservando para los pasteles."
    mar "Nous supposons que vous vous gardez pour les gâteaux."

# game/scripts/c19/c19.rpy:1270
translate french c19s003_Gifts_d36f0935:

    # nor "Con lo que sería el momento para que las chicas soplaran las velas."
    nor "Ce serait le moment pour les filles de souffler les bougies."

# game/scripts/c19/c19.rpy:1271
translate french c19s003_Gifts_3b9f6dee:

    # mar "Y nos comamos el pastel antes de que este calor lo derrita."
    mar "Et mangeons le gâteau avant que cette chaleur ne le fasse fondre."

# game/scripts/c19/c19.rpy:1272
translate french c19s003_Gifts_e889d994:

    # mom "No os preocupéis. Hay más pasteles, no sólo estos tres."
    mom "Ne vous inquiétez pas. Il y a d'autres gâteaux, pas seulement ces trois-là."

# game/scripts/c19/c19.rpy:1273
translate french c19s003_Gifts_492dfc10:

    # nor "Después, cuando todos vosotros estéis hartos de pastel, haremos la entrega de regalos y no os molestaremos más."
    nor "Ensuite, quand vous aurez tous bien mangé de gâteau, nous distribuerons les cadeaux et nous ne vous dérangerons plus."

# game/scripts/c19/c19.rpy:1274
translate french c19s003_Gifts_fe38e22c:

    # todas "¡Sí!"
    todas "Ouais!"

# game/scripts/c19/c19.rpy:1276
translate french c19s003_Gifts_d5a6db69:

    # "Las chicas soplan las velas rodeadas por los regalos mientras todo el mundo aplaude."
    "Les filles soufflent les bougies entourées de cadeaux sous les applaudissements de tous."

# game/scripts/c19/c19.rpy:1277
translate french c19s003_Gifts_b56fcced:

    # "Se reparten las porciones de pastel y todo el mundo vuelve a sus conversaciones. Todas las chicas menos Betty piden una ración pequeña. Jamaal pide una ración grande de cada pastel."
    "Les parts de gâteau sont distribuées et chacun reprend sa conversation. Toutes les filles, sauf Betty, commandent une petite part. Jamaal commande une grande part de chaque gâteau."

# game/scripts/c19/c19.rpy:1278
translate french c19s003_Gifts_0da62fda:

    # "Pruebas un pedacito MUY pequeño de cada uno. Como siempre, están deliciosos, pero la experiencia te ha enseñado que tres trozos normales son demasiados."
    "Vous goûtez un tout petit morceau de chaque. Comme toujours, c'est délicieux, mais l'expérience vous a appris que trois morceaux normaux, c'est de trop."

# game/scripts/c19/c19.rpy:1279
translate french c19s003_Gifts_be4c42f1:

    # "El niño gordo de tu pasado grita angustiado en tu mente."
    "Le gros gamin de ton passé hurle de douleur dans ton esprit."

# game/scripts/c19/c19.rpy:1280
translate french c19s003_Gifts_1cc36a4f:

    # "Todo el mundo se vuelve a dividir en grupos para comer el pastel antes de abrir los regalos."
    "Chacun se sépare à nouveau en groupes pour manger le gâteau avant d'ouvrir les cadeaux."

# game/scripts/c19/c19.rpy:1282
translate french c19s003_Gifts_d3b54025:

    # "Te diriges al grupo de [dap]. Aún no has tenido oportunidad de charlar con ellas."
    "Vous vous dirigez vers le groupe [dap]. Vous n'avez pas encore eu l'occasion de discuter avec eux."

# game/scripts/c19/c19.rpy:1283
translate french c19s003_Gifts_304d2606:

    # mc "¿Qué tal, chicas? ¿Ya os habéis comido el pastel?"
    mc "Salut les filles ! Vous avez déjà mangé le gâteau ?"

# game/scripts/c19/c19.rpy:1284
translate french c19s003_Gifts_57b2d432:

    # deb "[dap] tiene prisa por que todo el mundo se lo acabe. Tiene ganas de abrir los regalos. *Risa* No nos ha prestado atención hasta que no nos hemos acabado el pastel."
    deb "Elle est pressée que tout le monde ait fini. Elle a hâte d'ouvrir les cadeaux. *Rires* Elle ne nous a pas prêté attention avant qu'on ait fini le gâteau."

# game/scripts/c19/c19.rpy:1285
translate french c19s003_Gifts_3a8e31b3:

    # dap "Es lógico. Solo se cumplen 19 una vez. Bueno, en mi caso dos. Hoy y mañana. *Risa*"
    dap "C'est logique. On n'a 19 ans qu'une fois. Enfin, dans mon cas, deux fois. Aujourd'hui et demain. *Rires*"

# game/scripts/c19/c19.rpy:1286
translate french c19s003_Gifts_394e26cf:

    # oma "Ahora solo falta que Jamaal y Betty se acaben los suyos. *Risa* Creo que la impaciencia está matando a [dap]."
    oma "Il ne reste plus qu'à Jamaal et Betty de finir les leurs. *Rires* Je crois que l'impatience est un fléau [dap]."

# game/scripts/c19/c19.rpy:1287
translate french c19s003_Gifts_f6f5f399:

    # mc "Bueno, no hemos tenido tanta gente en una fiesta nunca. La comida está siendo mucho más larga."
    mc "Eh bien, nous n'avons jamais eu autant de monde à une fête. Le repas dure beaucoup plus longtemps que prévu."

# game/scripts/c19/c19.rpy:1289
translate french c19s003_Gifts_71559710:

    # dap "Y más gente son más regalos para abrir. *Risa* Va a llevar un rato..."
    dap "Et plus de monde, ça veut dire plus de cadeaux à ouvrir. *Rires* Ça va prendre du temps…"

# game/scripts/c19/c19.rpy:1290
translate french c19s003_Gifts_842b4d8d:

    # mc "Y todavía quedará mucha tarde para seguir charlando."
    mc "Et il restera encore largement assez d'après-midi pour continuer à bavarder."

# game/scripts/c19/c19.rpy:1292
translate french c19s003_Gifts_3970537f:

    # deb "Y podríamos jugar a algo en la piscina. Estar tan cerca del agua y no meterme dentro me está matando."
    deb "Et on pourrait jouer à quelque chose dans la piscine. Être si près de l'eau et ne pas pouvoir y aller me tue."

# game/scripts/c19/c19.rpy:1293
translate french c19s003_Gifts_37d243e2:

    # mc "Habló la sirenita. *Risa* Supongo que después de abrir los regalos habrá pasado el tiempo prudencial para bañarse después de comer."
    mc "La petite sirène prit la parole. *Rires* J'imagine qu'après avoir ouvert les cadeaux, il se sera écoulé suffisamment de temps pour prendre un bain après le repas."

# game/scripts/c19/c19.rpy:1295
translate french c19s003_Gifts_46bf8553:

    # oma "Las madres latinas siempre dicen que son dos horas desde que acabas de comer hasta que te puedes bañar. Espero que [mar] y [nor] no tengan genes latinos o sean más razonables."
    oma "Les mères latines disent toujours qu'il faut attendre deux heures entre la fin du repas et le moment de prendre un bain. J'espère que [mar] et [nor] n'ont pas de gènes latinos ou qu'ils sont plus raisonnables."

# game/scripts/c19/c19.rpy:1296
translate french c19s003_Gifts_a8469e3a:

    # mc "Y que la apertura de regalos no dure tanto. *Risa*"
    mc "Et que l'ouverture des cadeaux ne dure pas trop longtemps. *Rires*"

# game/scripts/c19/c19.rpy:1298
translate french c19s003_Gifts_b7ffe0fb:

    # dap "Creo que todo el mundo ha acabado de comerse el pastel ya. Voy a preguntarle a mi madre si podemos abrir los regalos."
    dap "Je crois que tout le monde a fini de manger son gâteau. Je vais demander à ma mère si on peut ouvrir les cadeaux."

# game/scripts/c19/c19.rpy:1299
translate french c19s003_Gifts_332d4f92:

    # mc "No te preocupes, ya voy yo a hacerlo."
    mc "Ne t'inquiète pas, je le ferai."

# game/scripts/c19/c19.rpy:1300
translate french c19s003_Gifts_6301f5f1:

    # oma "¿Ya nos abandonas? Sólo has estado un par de minutos con nosotras."
    oma "Vous nous quittez déjà ? Vous n'êtes avec nous que depuis quelques minutes."

# game/scripts/c19/c19.rpy:1301
translate french c19s003_Gifts_f2f6bd0e:

    # mc "Tu no quieres que a [dap] le entre un ataque de ansiedad, ¿verdad? *Risa* Pero no te preocupes, después de los regalos tendré tiempo para todas vosotras también."
    mc "Tu ne voudrais pas que [dap] fasse une crise d'angoisse, n'est-ce pas ? *Rires* Mais ne t'inquiète pas, après les cadeaux, j'aurai du temps pour vous tous aussi."

# game/scripts/c19/c19.rpy:1302
translate french c19s003_Gifts_66ce6f9e:

    # deb "Mejor que no. *Risa* Ve a preguntarle a [nor]."
    deb "Mieux vaut éviter. *Rires* Va demander à [nor]."

# game/scripts/c19/c19.rpy:1303
translate french c19s003_Gifts_7bce90a4:

    # mc "Ahora vuelvo."
    mc "Je reviens tout de suite."

# game/scripts/c19/c19.rpy:1305
translate french c19s003_Gifts_2d2b2875:

    # "Preguntas a [mar] y [nor] sobre la apertura de regalos."
    "Questions à [mar] et [nor] concernant l'ouverture des cadeaux."

# game/scripts/c19/c19.rpy:1306
translate french c19s003_Gifts_f097e388:

    # "Como cada año se sorprenden de lo mucho que han aguantado las chicas antes de pedir permiso para abrirlos."
    "Comme chaque année, ils sont surpris de voir à quel point les filles ont enduré avant de demander la permission de les ouvrir."

# game/scripts/c19/c19.rpy:1307
translate french c19s003_Gifts_da1e9db6:

    # "Todo el mundo se reúne alrededor de la pérgola para ver cómo reaccionan las chicas a cada uno de los regalos."
    "Tout le monde se rassemble autour de la pergola pour voir comment les filles réagissent à chaque cadeau."

# game/scripts/c19/c19.rpy:1309
translate french c19s003_Gifts_00690be5:

    # "Todas las chicas reciben ropa. Mucha ropa. En la mayoría de los casos aciertan con sus gustos."
    "Toutes les filles reçoivent des vêtements. Beaucoup de vêtements. Dans la plupart des cas, leurs goûts correspondent."

# game/scripts/c19/c19.rpy:1310
translate french c19s003_Gifts_1bd082a1:

    # "También reciben vales para ir a un spa, colonias, complementos..."
    "Ils reçoivent également des bons pour des soins en spa, des parfums, des accessoires..."

# game/scripts/c19/c19.rpy:1311
translate french c19s003_Gifts_aad9effa:

    # "Todos los regalos son recibidos con sonrisas y abrazos de agradecimiento."
    "Tous les cadeaux sont reçus avec des sourires et des étreintes reconnaissantes."

# game/scripts/c19/c19.rpy:1314
translate french c19s003_Gifts_25e705e9:

    # "Los cuadros de Maddie son una sensación. Las chicas están contentísimas con ellos y todo el mundo se ríe con lo adorable que está Zeus."
    "Les peintures de Maddie font sensation. Les filles les adorent, et tout le monde rit en voyant à quel point Zeus est adorable."

# game/scripts/c19/c19.rpy:1315
translate french c19s003_Gifts_f52b2dd7:

    # "El cuadro de [dap] es diferente del que estaba pintando Maddie cuando estuviste en su casa. Le tienes que preguntar por qué."
    "Le tableau de [dap] est différent de celui que Maddie était en train de peindre quand tu étais chez elle. Tu dois lui demander pourquoi."

# game/scripts/c19/c19.rpy:1317
translate french c19s003_Gifts_e6d54ec6:

    # "Las cajas que ha traído Maddie son cuadros personalizados para las chicas. Les encantan y todo el mundo se ríe con lo adorable que está Zeus, el gato de Maddie."
    "Les boîtes que Maddie a apportées contiennent des dessins personnalisés pour les filles. Elles les adorent, et tout le monde rit en voyant à quel point Zeus, le chat de Maddie, est mignon."

# game/scripts/c19/c19.rpy:1319
translate french c19s003_Gifts_99b9f6d5:

    # "Las chicas dicen que los colgarán en sus habitaciones antes de acabar el día."
    "Les filles disent qu'elles les accrocheront dans leurs chambres avant la fin de la journée."

# game/scripts/c19/c19.rpy:1322
translate french c19s003_Gifts_478da912:

    # "[emm] es la primera en llegar a tu regalo para ella."
    "[emm] est le premier à arriver à votre cadeau pour elle."

# game/scripts/c19/c19.rpy:1323
translate french c19s003_Gifts_0750d1ad:

    # emm "¿Un sobre, [mc]? No has sido tan cutre como para regalarme dinero, ¿verdad?"
    emm "Une enveloppe, [mc] ? Tu n'étais pas assez radin pour me donner de l'argent, quand même ?"

# game/scripts/c19/c19.rpy:1324
translate french c19s003_Gifts_1c32212c:

    # mc "*Risa* Ábrelo y lo sabrás. Pero no, no es dinero."
    mc "*Rires* Ouvre-le et tu verras. Mais non, ce n'est pas de l'argent."

# game/scripts/c19/c19.rpy:1326
translate french c19s003_Gifts_e18aee28:

    # emm "¿QUÉ? ¿Un vale de alquiler por un Ferrarini rosa? ¿Dónde has encontrado esto?"
    emm "QUOI ? Un bon de location pour une Ferrarini rose ? Où as-tu trouvé ça ?"

# game/scripts/c19/c19.rpy:1327
translate french c19s003_Gifts_79e24cc9:

    # mc "En Monterey. Es el único en todo el estado fuera de LA."
    mc "À Monterey. C'est le seul de tout l'État en dehors de la Louisiane."

# game/scripts/c19/c19.rpy:1329
translate french c19s003_Gifts_52c65b1d:

    # emm "¡Me encanta! Cuando el otro día dije que quería uno no creía que existieran de alquiler."
    emm "J'adore ! Quand j'ai dit l'autre jour que j'en voulais un, je ne pensais pas qu'on pouvait en louer un."

# game/scripts/c19/c19.rpy:1330
translate french c19s003_Gifts_b460952f:

    # mc "*Risa* Hace una semana que lo reservé. Tienes que usar el vale durante los próximos siete días."
    mc "*Rires* Je l'ai réservé il y a une semaine. Vous devez utiliser le bon dans les sept prochains jours."

# game/scripts/c19/c19.rpy:1331
translate french c19s003_Gifts_50cede59:

    # emm "¡Pues hay que organizar un viaje a Monterey! ¡Estoy impaciente!"
    emm "Il faut absolument qu'on organise un voyage à Monterey ! J'ai tellement hâte !"

# game/scripts/c19/c19.rpy:1333
translate french c19s003_Gifts_8846acee:

    # "La siguiente en llegar a tu regalo es [dap]."
    "Le prochain colis à arriver pour votre cadeau est [dap]."

# game/scripts/c19/c19.rpy:1334
translate french c19s003_Gifts_466a6e26:

    # dap "¡Hey! Esto pesa... ¿Qué es?"
    dap "Hé ! C'est lourd... Qu'est-ce que c'est ?"

# game/scripts/c19/c19.rpy:1335
translate french c19s003_Gifts_1724be0a:

    # mc "Lo tendrás que abrir para saberlo. *Risa*"
    mc "Il faudra l'ouvrir pour le découvrir. *Rires*"

# game/scripts/c19/c19.rpy:1337
translate french c19s003_Gifts_72ceeaed:

    # dap "¡Es el Super Gamertron 4090! ¡Es mejor que el portátil que quería comprarme!"
    dap "C'est la Super Gamertron 4090 ! Elle est meilleure que l'ordinateur portable que je voulais acheter !"

# game/scripts/c19/c19.rpy:1338
translate french c19s003_Gifts_1a14174b:

    # mc "Pues ya no necesitas comprártelo. Ya puedes jubilar tu viejo portátil."
    mc "Eh bien, vous n'avez plus besoin d'en acheter un. Vous pouvez désormais mettre votre ancien ordinateur portable à la retraite."

# game/scripts/c19/c19.rpy:1339
translate french c19s003_Gifts_834fb5ec:

    # dap "Pero te has pasado mucho. ¡Es carísimo!"
    dap "Mais vous avez largement exagéré. C'est incroyablement cher !"

# game/scripts/c19/c19.rpy:1341
translate french c19s003_Gifts_3743811b:

    # dap "¡Gracias, [mc]! Es una auténtica pasada de portátil."
    dap "Merci, [mc] ! C'est un ordinateur portable absolument incroyable."

# game/scripts/c19/c19.rpy:1342
translate french c19s003_Gifts_628fd6f6:

    # mc "Disfrútalo, pero no te pases la vida encerrada en tu habitación jugando. *Risa*"
    mc "Amuse-toi, mais ne passe pas ta vie enfermé dans ta chambre à jouer aux jeux vidéo. *Rires*"

# game/scripts/c19/c19.rpy:1343
translate french c19s003_Gifts_72133550:

    # dap "Tranquilo, no lo haré. Hay cosas demasiado buenas aquí fuera."
    dap "Ne t'inquiète pas, je ne le ferai pas. Il y a trop de bonnes choses à voir."

# game/scripts/c19/c19.rpy:1345
translate french c19s003_Gifts_81e3e407:

    # "La última en llegar a tu regalo es [eri]."
    "Le dernier à arriver à votre cadeau est [eri]."

# game/scripts/c19/c19.rpy:1346
translate french c19s003_Gifts_7324a3c8:

    # eri "¡Qué cajita más mona! ¿Un anillo?"
    eri "Quelle jolie petite boîte ! Une bague ?"

# game/scripts/c19/c19.rpy:1347
translate french c19s003_Gifts_998bae65:

    # mc "Tú también vas a tener que abrirlo para descubrirlo."
    mc "Il faudra l'ouvrir pour le découvrir vous aussi."

# game/scripts/c19/c19.rpy:1349
translate french c19s003_Gifts_04d89bbe:

    # eri "¡Oh! ¡Son preciosos!"
    eri "Oh ! Elles sont magnifiques !"

# game/scripts/c19/c19.rpy:1351
translate french c19s003_Gifts_55acbb6c:

    # eri "¡Me encanta el triskelion!"
    eri "J'adore le triskèle !"

# game/scripts/c19/c19.rpy:1352
translate french c19s003_Gifts_91052178:

    # mc "Al representar la evolución de una persona, pasado, presente, y futuro, creo que te pegan. Los diseñé y los hice fabricar para ti."
    mc "En représentant l'évolution d'une personne — passée, présente et future —, je pense qu'elles vous parlent. Je les ai conçues et faites réaliser spécialement pour vous."

# game/scripts/c19/c19.rpy:1353
translate french c19s003_Gifts_44a5da68:

    # todas "¡Qué bonitos!"
    todas "Que c'est beau !"

# game/scripts/c19/c19.rpy:1355
translate french c19s003_Gifts_3eacd17c:

    # eri "Déjame ponérmelos un momento."
    eri "Laissez-moi les mettre un instant."

# game/scripts/c19/c19.rpy:1357
translate french c19s003_Gifts_9880e837:

    # eri "¡Muchas gracias, [mc]! ¡Se acaban de convertir en mis pendientes favoritos!"
    eri "Merci beaucoup, [mc] ! Ce sont devenues mes boucles d'oreilles préférées !"

# game/scripts/c19/c19.rpy:1358
translate french c19s003_Gifts_588a4e65:

    # mc "Te quedan muy bien. Obsidiana sobre plata. Son tus colores."
    mc "Elles te vont à merveille. Obsidienne sur argent. Ce sont tes couleurs."

# game/scripts/c19/c19.rpy:1360
translate french c19s003_Gifts_58b9e4fb:

    # "Después de eso siguen abriendo más regalos y dando más abrazos hasta que se acaban las cajas."
    "Ensuite, ils continuent d'ouvrir d'autres cadeaux et de s'échanger des câlins jusqu'à ce que les boîtes soient épuisées."

# game/scripts/c19/c19.rpy:1363
translate french c19s003_Gifts_48da537d:

    # "Mientras unos cuantos ayudáis a las chicas a subir sus regalos a sus habitaciones, otros recogéis toda la comida y los platos sucios."
    "Pendant que certains d'entre vous aident les filles à monter leurs cadeaux dans leurs chambres, d'autres ramassent toute la nourriture et la vaisselle sale."

# game/scripts/c19/c19.rpy:1365
translate french c19s003_Gifts_95c286b9:

    # "Vais a comer sobras durante unos días. [nor] y [mar] siempre cocinan demasiado."
    "Vous allez manger des restes pendant quelques jours. [nor] et [mar] les font toujours trop cuire."

# game/scripts/c19/c19.rpy:1366
translate french c19s003_Gifts_d6b2303e:

    # dap "Propongo una lucha de caballos en la piscina. Podemos hacer equipos..."
    dap "Je propose un combat de chevaux dans la piscine. On peut faire des équipes..."

# game/scripts/c19/c19.rpy:1367
translate french c19s003_Gifts_5789983e:

    # mc "Mucho ejercicio después de comer, ¿no? Aunque yo me apunto."
    mc "Beaucoup d'exercice après avoir mangé, n'est-ce pas ? J'en suis !"

# game/scripts/c19/c19.rpy:1368
translate french c19s003_Gifts_10d194be:

    # mcp "(Tan solo espero que no pase lo mismo que la última vez.)"
    mcp "(J'espère juste que la même chose ne se reproduira pas que la dernière fois.)"

# game/scripts/c19/c19.rpy:1369
translate french c19s003_Gifts_dbbd2da2:

    # emm "Yo montaré a [mc] como la última vez. ¡Somos invencibles! Lo siento, [eri]."
    emm "Je vais chevaucher [mc] comme la dernière fois. Nous sommes invincibles ! Désolé, [eri]."

# game/scripts/c19/c19.rpy:1370
translate french c19s003_Gifts_cc92d099:

    # eri "Podemos hacer equipos topless contra top. No sé si cuadran los números."
    eri "On pourrait former des équipes sans maillot contre des équipes de haut niveau. Je ne sais pas si les statistiques sont cohérentes."

# game/scripts/c19/c19.rpy:1372
translate french c19s003_Gifts_e886c995:

    # nor "Conmigo no contéis. Yo necesito reposar la comida un rato."
    nor "Je ne peux pas y aller. J'ai besoin de laisser digérer mon repas un moment."

# game/scripts/c19/c19.rpy:1373
translate french c19s003_Gifts_669179a0:

    # mee "Yo también... Como dice [mc], demasiado ejercicio después de comer. Necesito un poco de descanso a la sombra."
    mee "Moi aussi… Comme l’a dit [mc], trop d’exercice après avoir mangé. J’ai besoin de me reposer à l’ombre."

# game/scripts/c19/c19.rpy:1374
translate french c19s003_Gifts_8037e8ad:

    # kat "Yo me apunto, no he comido tanto como para perderme la diversión. Aunque es difícil decidir..."
    kat "J'en suis ! Je n'ai pas tellement mangé que je ne vais pas rater ça. Même si c'est une décision difficile…"

# game/scripts/c19/c19.rpy:1375
translate french c19s003_Gifts_88eadbbb:

    # jam "Conmigo tampoco contéis. *Risa*"
    jam "Ne comptez pas sur moi non plus. *Rires*"

# game/scripts/c19/c19.rpy:1376
translate french c19s003_Gifts_11f06190:

    # "Al final, tan solo doce decidís lanzaros a la piscina. Podréis hacer dos equipos de seis."
    "Au final, vous ne serez que douze à vous lancer. Vous pourrez former deux équipes de six."

# game/scripts/c19/c19.rpy:1541
translate french c19s004_PhoneMessage_d1504cf8:

    # "Mientras estáis discutiendo cómo distribuís los grupos, suena tu móvil"
    "Alors que vous discutez de la répartition des groupes, votre téléphone portable sonne."

# game/scripts/c19/c19.rpy:1543
translate french c19s004_PhoneMessage_b616f7c9:

    # sam "Te acaba de sonar el móvil, [mc]. Un mensaje de texto."
    sam "Votre téléphone portable vient de sonner, [mc]. Un SMS."

# game/scripts/c19/c19.rpy:1544
translate french c19s004_PhoneMessage_f6cb428b:

    # mc "Léemelo. La clave para desbloquearlo es el cumpleaños de Jamaal."
    mc "Lis-le-moi. La clé pour le déverrouiller est l'anniversaire de Jamaal."

# game/scripts/c19/c19.rpy:1546
translate french c19s004_PhoneMessage_c01cdb95:

    # sam "¿Estás seguro?"
    sam "Vous êtes sûr ?"

# game/scripts/c19/c19.rpy:1547
translate french c19s004_PhoneMessage_c0d76fae:

    # mc "No tengo ningún secreto que esconder. Puedes leerlo."
    mc "Je n'ai aucun secret à cacher. Vous pouvez le lire."

# game/scripts/c19/c19.rpy:1549
translate french c19s004_PhoneMessage_05633e0f:

    # sam "Un pedido de Amazonian, una mesa. Llega mañana."
    sam "Une table commandée sur Amazon. Elle arrive demain."

# game/scripts/c19/c19.rpy:1550
translate french c19s004_PhoneMessage_617b883f:

    # mc "¿Ves como no era ningún secreto? *Risa*"
    mc "Vous voyez, ce n'était pas un secret du tout ! *Rires*"

# game/scripts/c19/c19.rpy:1551
translate french c19s004_PhoneMessage_e80224bf:

    # mc "Lo que es raro es que solo llegue la mesa."
    mc "Ce qui est étrange, c'est que seule la table arrive."

# game/scripts/c19/c19.rpy:1553
translate french c19s004_PhoneMessage_ba794966:

    # "Suena el móvil de nuevo."
    "Le téléphone portable sonne à nouveau."

# game/scripts/c19/c19.rpy:1555
translate french c19s004_PhoneMessage_311b391a:

    # mc "Si antes lo digo... Ese debe ser el otro pedido. ¿Puedes mirar cuando llega?"
    mc "Si je le dis plus tôt… Ce doit être l'autre commande. Pouvez-vous vérifier à sa réception ?"

# game/scripts/c19/c19.rpy:1558
translate french c19s004_PhoneMessage_c7288ed0:

    # sam "No es de Amazonian... y no creo que quieras que lea este mensaje."
    sam "Ce n'est pas d'Amazonian... et je ne pense pas que vous vouliez que je lise ce message."

# game/scripts/c19/c19.rpy:1559
translate french c19s004_PhoneMessage_b1d1f4eb:

    # mc "Puedes leerlo. Ya te he dicho que no tengo ningún secreto."
    mc "Vous pouvez le lire. Je vous ai déjà dit que je n'avais aucun secret."

# game/scripts/c19/c19.rpy:1560
translate french c19s004_PhoneMessage_b5a0e928:

    # sam "Es... privado..."
    sam "C'est... privé..."

# game/scripts/c19/c19.rpy:1561
translate french c19s004_PhoneMessage_8eda67a6:

    # mc "Léelo, Sam. Tengo las manos mojadas y no hay ningún secreto mío que no quiera que la familia conozca."
    mc "Lis-le, Sam. J'ai les mains mouillées, et il n'y a aucun secret que je ne veuille pas que ma famille connaisse."

# game/scripts/c19/c19.rpy:1563
translate french c19s004_PhoneMessage_e982ddfe:

    # sam "A ver si hay suerte y hoy también te puedes librar de la zorra de tu novia y podemos volver a estar juntos. Lo de anoche fue alucinante."
    sam "J'espère que tu auras de la chance et que tu pourras te débarrasser de cette garce de copine aujourd'hui encore, pour qu'on puisse se remettre ensemble. Hier soir, c'était génial."

# game/scripts/c19/c19.rpy:1565
translate french c19s004_PhoneMessage_d37cecda:

    # "Todo el mundo te mira sorprendido."
    "Tout le monde vous regarde avec surprise."

# game/scripts/c19/c19.rpy:1567
translate french c19s004_PhoneMessage_7d1fa346:

    # mc "¿Qué? ¿Quién lo manda?"
    mc "Quoi ? Qui est responsable ?"

# game/scripts/c19/c19.rpy:1570
translate french c19s004_PhoneMessage_2580944a:

    # "Miras a Saira, quien niega con la cabeza, sorprendida."
    "Vous regardez Saira, qui secoue la tête, surprise."

# game/scripts/c19/c19.rpy:1572
translate french c19s004_PhoneMessage_e89af114:

    # sam "No la tienes entre los contactos. Sólo sale el número de teléfono."
    sam "Elle n'est pas enregistrée dans vos contacts. Seul son numéro de téléphone apparaît."

# game/scripts/c19/c19.rpy:1573
translate french c19s004_PhoneMessage_2a44cc6e:

    # mc "No tengo ni idea de quién puede ser..."
    mc "Je n'ai aucune idée de qui cela pourrait être..."

# game/scripts/c19/c19.rpy:1575
translate french c19s004_PhoneMessage_97a7ef9a:

    # jam "He sido yo, Mamá. Era una broma privada." (multiple=2)
    jam "C'était moi, maman. C'était une blague privée." (multiple=2)

# game/scripts/c19/c19.rpy:1576
translate french c19s004_PhoneMessage_66ef3270:

    # bet "He sido yo, Samantha. Lo de anoche..." (multiple=2)
    bet "C'était moi, Samantha. À propos d'hier soir..." (multiple=2)

# game/scripts/c19/c19.rpy:1577
translate french c19s004_PhoneMessage_63104045:

    # mcp "(¿Qué?)"
    mcp "(Que?)"

# game/scripts/c19/c19.rpy:1579
translate french c19s004_PhoneMessage_d53fe48b:

    # "Ahora es el momento en que todo el mundo mira a Betty y Jamaal con sorpresa e incredulidad en sus caras."
    "C’est maintenant que tous les regards se tournent vers Betty et Jamaal, affichant surprise et incrédulité."

# game/scripts/c19/c19.rpy:1580
translate french c19s004_PhoneMessage_2a5223bd:

    # mee "¡Betty!"
    mee "Betty !"

# game/scripts/c19/c19.rpy:1582
translate french c19s004_PhoneMessage_3f7323db:

    # jam "¡Tía Betty! No sabía que tú y [mc]..."
    jam "Tante Betty ! Je ne te connaissais pas et [mc]..."

# game/scripts/c19/c19.rpy:1583
translate french c19s004_PhoneMessage_6e3319ee:

    # bet "Lo llevamos en secreto... No tienes que mentir por mí, Jamaal..."
    bet "On garde ça secret… Tu n’as pas besoin de mentir pour moi, Jamaal…"

# game/scripts/c19/c19.rpy:1585
translate french c19s004_PhoneMessage_fd4eccaf:

    # "Suena el móvil una vez más."
    "Le téléphone portable sonne à nouveau."

# game/scripts/c19/c19.rpy:1587
translate french c19s004_PhoneMessage_37eacbda:

    # sam "Otro mensaje del mismo número. Y ni Jamaal ni Betty tienen sus móviles en la mano."
    sam "Encore un message du même numéro. Ni Jamaal ni Betty n'ont leur téléphone en main."

# game/scripts/c19/c19.rpy:1588
translate french c19s004_PhoneMessage_d39f80ca:

    # mc "Léelo, Sam."
    mc "Lis-le, Sam."

# game/scripts/c19/c19.rpy:1590
translate french c19s004_PhoneMessage_3b56fd1c:

    # sam "*Risa* No os lo vais a creer."
    sam "*Rires* Vous n'allez pas le croire."

# game/scripts/c19/c19.rpy:1591
translate french c19s004_PhoneMessage_c431ed80:

    # mc "¿Qué pasa? ¿Qué dice el mensaje?"
    mc "Qu'est-ce qui ne va pas ? Que dit le message ?"

# game/scripts/c19/c19.rpy:1592
translate french c19s004_PhoneMessage_10a76443:

    # sam "Lo siento. Número equivocado."
    sam "Désolé. Mauvais numéro."

# game/scripts/c19/c19.rpy:1594
translate french c19s004_PhoneMessage_800feb7a:

    # mee "Betty, ¿nos explicas a todas por qué nos has mentido?"
    mee "Betty, peux-tu nous expliquer pourquoi tu nous as menti ?"

# game/scripts/c19/c19.rpy:1595
translate french c19s004_PhoneMessage_47b83878:

    # mee "¿O realmente estás haciendo... cosas... con [mc]?"
    mee "Ou bien êtes-vous en train de faire... des choses... avec [mc] ?"

# game/scripts/c19/c19.rpy:1597
translate french c19s004_PhoneMessage_3a3abde3:

    # bet "No. No estamos haciendo \"cosas\"."
    bet "Non. Nous ne faisons pas de \"choses\"."

# game/scripts/c19/c19.rpy:1598
translate french c19s004_PhoneMessage_a6cc1eb6:

    # bet "Pero he pensado que si alguna de estas chicas las está haciendo y había mandado ese mensaje por error sin saber que lo leería Samantha..."
    bet "Mais je me suis dit que si l'une de ces filles les faisait et que j'avais envoyé ce message par erreur sans savoir que Samantha le lirait..."

# game/scripts/c19/c19.rpy:1600
translate french c19s004_PhoneMessage_cf5976d5:

    # bet "Era una forma de cubrirla. Si no quieren que lo sepamos, un mensaje que lee la persona equivocada no debería destapar sus secretos."
    bet "C'était une façon de dissimuler la vérité. S'ils ne veulent pas que nous le sachions, un message lu par la mauvaise personne ne devrait pas révéler leurs secrets."

# game/scripts/c19/c19.rpy:1607
translate french c19s004_PhoneMessage_1e90fcd5:

    # "[eri] te mira sonriendo un segundo antes de hablar. Asientes con la cabeza."
    "[eri] vous regarde en souriant pendant une seconde avant de parler. Vous hochez la tête."

# game/scripts/c19/c19.rpy:1608
translate french c19s004_PhoneMessage_ff20b367:

    # eri "Lo siento, [dap]... [mc] y yo sí que estamos haciendo... cosas. Estamos saliendo."
    eri "Je suis désolé, [dap]... [mc] et moi, on fait... des choses. On sort ensemble."

# game/scripts/c19/c19.rpy:1609
translate french c19s004_PhoneMessage_a3379cca:

    # eri "Si Tía Betty es lo suficientemente valiente como para cargar con la culpa de un mensaje que no es suyo, yo debo ser lo suficientemente valiente como para hacerlo público."
    eri "Si tante Betty a le courage d'endosser la responsabilité d'un message qui n'est pas le sien, alors je dois avoir le courage de le rendre public."

# game/scripts/c19/c19.rpy:1610
translate french c19s004_PhoneMessage_574b3e7c:

    # eri "No es como hubiera querido hacerlo público, pero creo que es el momento."
    eri "Ce n'est pas ainsi que j'aurais voulu l'annoncer publiquement, mais je pense que c'est le bon moment."

