# game/scripts/c32/c32.rpy:32
translate french c32s002_noAma_f0705f57:

    # "After dinner..."
    "Après le dîner..."

# game/scripts/c32/c32.rpy:33
translate french c32s002_noAma_3071531a:

    # mc "What are you doing, [ama]?"
    mc "Qu'est-ce que tu fais, [ama] ?"

# game/scripts/c32/c32.rpy:35
translate french c32s002_noAma_fa46e1a6:

    # ama "I was looking at this picture. I know it's a generic picture of a field with daisies, but..."
    ama "Je regardais cette photo. Je sais que c'est une image générique d'un champ de marguerites, mais..."

# game/scripts/c32/c32.rpy:36
translate french c32s002_noAma_a82490ef:

    # ama "If it weren't for that rock right in the middle, I'd think it was the old shooting range."
    ama "S'il n'y avait pas ce rocher en plein milieu, je penserais que c'est l'ancien stand de tir."

# game/scripts/c32/c32.rpy:37
translate french c32s002_noAma_f45c8fd6:

    # mc "The old shooting range?"
    mc "L'ancien stand de tir ?"

# game/scripts/c32/c32.rpy:39
translate french c32s002_noAma_8c4dde0d:

    # ama "I guess [eva] told you about when they used to aim a gun at our heads at the shooting range the moment they gave us a weapon."
    ama "Je suppose qu'[eva] t'a parlé de l'époque où ils pointaient une arme sur nos têtes au stand de tir dès qu'ils nous donnaient une arme."

# game/scripts/c32/c32.rpy:40
translate french c32s002_noAma_75b75cf1:

    # mc "Yes. It was inhumane."
    mc "Oui. C'était inhumain."

# game/scripts/c32/c32.rpy:42
translate french c32s002_noAma_26db4307:

    # ama "The older series went through that. The A's, B's, C's, D's, and us. I think even the E's."
    ama "Les anciennes séries sont passées par là. Les A, B, C, D, et nous. Je crois même les E."

# game/scripts/c32/c32.rpy:43
translate french c32s002_noAma_72451634:

    # ama "When the A's were old enough to train the rest of the series, the company fired those instructors."
    ama "Quand les A ont été assez âgées pour entraîner le reste des séries, l'entreprise a viré ces instructeurs."

# game/scripts/c32/c32.rpy:44
translate french c32s002_noAma_73af92e2:

    # ama "Then, the A's refused to use that shooting range to train us ever again."
    ama "Ensuite, les A ont refusé d'utiliser ce stand de tir pour nous entraîner à nouveau."

# game/scripts/c32/c32.rpy:46
translate french c32s002_noAma_69e2182f:

    # ama "The excuse is that it had gotten too small for the new series, which were larger. 20 F's couldn't fit on the shooting range at the same time."
    ama "L'excuse était qu'il était devenu trop petit pour les nouvelles séries, qui étaient plus nombreuses. 20 F ne pouvaient pas tenir sur le stand de tir en même temps."
# game/scripts/c32/c32.rpy:47
translate french c32s002_noAma_be0cdaf9:

    # ama "But the real reason is that nobody wanted to go back there."
    ama "Mais la vraie raison, c'est que personne ne voulait y retourner."

# game/scripts/c32/c32.rpy:48
translate french c32s002_noAma_751296a6:

    # mc "I understand. I guess you guys had a hard time."
    mc "Je comprends. J'imagine que vous en avez bavé."

# game/scripts/c32/c32.rpy:50
translate french c32s002_noAma_2040272f:

    # ama "Now, some of the guys use it when they want to compete with each other."
    ama "Maintenant, certains gars l'utilisent quand ils veulent se mesurer les uns aux autres."

# game/scripts/c32/c32.rpy:51
translate french c32s002_noAma_07b4435e:

    # ama "Usually, they're guys who didn't live through that era and who aren't allowed to compete on the range that's currently in use."
    ama "Généralement, ce sont des gars qui n'ont pas connu cette époque et qui ne sont pas autorisés à s'affronter sur le stand de tir actuellement utilisé."

# game/scripts/c32/c32.rpy:52
translate french c32s002_noAma_23ae9f31:

    # ama "The old shooting range has become an oasis of tranquility."
    ama "L'ancien stand de tir est devenu une oasis de tranquillité."

# game/scripts/c32/c32.rpy:53
translate french c32s002_noAma_f7421095:

    # mc "Except when they want to compete, right?"
    mc "Sauf quand ils veulent s'affronter, pas vrai ?"

# game/scripts/c32/c32.rpy:55
translate french c32s002_noAma_e1898150:

    # ama "They don't do it often. The instructors, from the C's to the F's, keep them busy."
    ama "Ils ne le font pas souvent. Les instructeurs, des C aux F, les gardent bien occupés."

# game/scripts/c32/c32.rpy:56
translate french c32s002_noAma_944beacd:

    # ama "But it's a beautiful place with ugly memories. I'll show it to you when we go to the training base... if you want."
    ama "Mais c'est un endroit magnifique avec de vilains souvenirs. Je te le montrerai quand on ira à la base d'entraînement... si tu veux."

# game/scripts/c32/c32.rpy:57
translate french c32s002_noAma_02848cdf:

    # mc "If you're going to have a hard time going back there, we don't have to."
    mc "Si ça doit être dur pour toi d'y retourner, on n'est pas obligés."

# game/scripts/c32/c32.rpy:59
translate french c32s002_noAma_7598dae1:

    # ama "I think going back there after so long might be good. To make new memories."
    ama "Je pense qu'y retourner après tout ce temps pourrait faire du bien. Pour se faire de nouveaux souvenirs."

# game/scripts/c32/c32.rpy:60
translate french c32s002_noAma_330ac222:

    # ama "Different memories for a different company."
    ama "Des souvenirs différents pour une compagnie différente."
# game/scripts/c32/c32.rpy:61
translate french c32s002_noAma_e803d73e:

    # mc "If that's what you think, alright. I'd be glad to go on a tour of the shooting range."
    mc "Si c'est ce que tu penses, d'accord. Je serais ravi de faire une visite du stand de tir."

# game/scripts/c32/c32.rpy:63
translate french c32s002_noAma_cfdb63b9:

    # ama "But we'll talk about that tomorrow. I'm dead tired."
    ama "Mais on en parlera demain. Je suis morte de fatigue."

# game/scripts/c32/c32.rpy:64
translate french c32s002_noAma_6d00f607:

    # mc "Then I won't keep you any longer. Go to sleep."
    mc "Alors je ne te retiens pas plus longtemps. Va dormir."

# game/scripts/c32/c32.rpy:66
translate french c32s002_noAma_b166bf00:

    # ama "Thanks for everything, [mc]."
    ama "Merci pour tout, [mc]."

# game/scripts/c32/c32.rpy:67
translate french c32s002_noAma_21a7515b:

    # mc "I'm here for whatever you need."
    mc "Je suis là pour tout ce dont tu as besoin."

# game/scripts/c32/c32.rpy:68
translate french c32s002_noAma_d5bbf685:

    # ama "I knew you were going to say that."
    ama "Je savais que tu allais dire ça."

# game/scripts/c32/c32.rpy:70
translate french c32s002_noAma_9f2c1078:

    # "While [ama] goes to the bathroom before bed, you check if there's any news on the My Residence forums."
    "Pendant qu'[ama] va à la salle de bain avant de se coucher, tu vérifies s'il y a des nouvelles sur les forums de My Residence."

# game/scripts/c32/c32.rpy:71
translate french c32s002_noAma_83aae2f9:

    # "It seems there's going to be a date with one of the humans infiltrated among the aliens."
    "Il semblerait qu'il y ait un rencard avec l'une des humaines infiltrées parmi les extraterrestres."

# game/scripts/c32/c32.rpy:72
translate french c32s002_noAma_b5a288d9:

    # "You're sure Clichecita must have done something interesting with her."
    "Tu es sûr que Clichecita a dû faire quelque chose d'intéressant avec elle."

# game/scripts/c32/c32.rpy:73
translate french c32s002_noAma_fcd27786:

    # "The highest tiers among his subscribers, who have already played the update, say the date is really cute."
    "Les abonnés des paliers les plus élevés, qui ont déjà joué à la mise à jour, disent que le rencard est vraiment mignon."

# game/scripts/c32/c32.rpy:74
translate french c32s002_noAma_ebd3af98:

    # "She's been the girl who took the longest to have an intimate moment with the MC, and there's a lot of hype on the forums."
    "C'est la fille qui a mis le plus de temps à avoir un moment intime avec le MC, et il y a beaucoup de hype sur les forums."
# game/scripts/c32/c32.rpy:82
translate french c32s001_AmaDate_da8c937e:

    # ama "Thanks, [mc]. And now we should leave."
    ama "Merci, [mc]. Et maintenant, on devrait y aller."

# game/scripts/c32/c32.rpy:83
translate french c32s001_AmaDate_f7212587:

    # mc "Already? In such a rush? Oranjestad will still be there if we take five more minutes."
    mc "Déjà ? Si pressée ? Oranjestad sera toujours là si on prend cinq minutes de plus."

# game/scripts/c32/c32.rpy:85
translate french c32s001_AmaDate_c93c439e:

    # ama "We're not going to Oranjestad after all. I asked [car] for help, and we have a reservation at a small restaurant."
    ama "On ne va pas à Oranjestad finalement. J'ai demandé de l'aide à [car], et on a une réservation dans un petit restaurant."

# game/scripts/c32/c32.rpy:86
translate french c32s001_AmaDate_b61dfb5b:

    # ama "She told me it's far from the tourist spots, so we'll be almost alone. But we have to leave now."
    ama "Elle m'a dit que c'est loin des coins touristiques, donc on sera presque seuls. Mais il faut qu'on parte maintenant."

# game/scripts/c32/c32.rpy:87
translate french c32s001_AmaDate_5af7be8b:

    # mc "Are you hungry?"
    mc "Tu as faim ?"

# game/scripts/c32/c32.rpy:89
translate french c32s001_AmaDate_1703a995:

    # ama "No, but I don't want to miss the sunset. You know what? I'd better drive or we'll be late."
    ama "Non, mais je ne veux pas rater le coucher de soleil. Tu sais quoi ? Je ferais mieux de conduire ou on sera en retard."

# game/scripts/c32/c32.rpy:90
translate french c32s001_AmaDate_7231029a:

    # mc "That sounds interesting. I wouldn't want to miss it either."
    mc "Ça a l'air intéressant. Je ne voudrais pas rater ça non plus."

# game/scripts/c32/c32.rpy:92
translate french c32s001_AmaDate_a99d229e:

    # "[ama] drives like a maniac through the narrow roads. Luckily, there isn't too much traffic."
    "[ama] conduit comme une folle sur les routes étroites. Heureusement, il n'y a pas trop de circulation."

# game/scripts/c32/c32.rpy:93
translate french c32s001_AmaDate_53627598:

    # "She's really in a hurry to get there in time to see the sun hide behind the horizon."
    "Elle est vraiment pressée d'arriver à temps pour voir le soleil se cacher derrière l'horizon."

# game/scripts/c32/c32.rpy:95
translate french c32s001_AmaDate_6a54722a:

    # "After a few minutes, she parks the car and you head down a pedestrian alley. She takes your hand as soon as you get out of the car."
    "Après quelques minutes, elle gare la voiture et vous vous dirigez vers une ruelle piétonne. Elle te prend la main dès que tu sors de la voiture."

# game/scripts/c32/c32.rpy:96
translate french c32s001_AmaDate_06a59e27:

    # "The street has the typical colors you've seen in all the online travel guides about Aruba, although the architecture is a bit different."
    "La rue a les couleurs typiques que tu as vues dans tous les guides de voyage en ligne sur Aruba, bien que l'architecture soit un peu différente."
# game/scripts/c32/c32.rpy:97
translate french c32s001_AmaDate_e9fcd934:

    # "There's a terrace with parasols in the middle of the street. You assume that's where you're going to have dinner."
    "Il y a une terrasse avec des parasols au milieu de la rue. Tu supposes que c'est là que vous allez dîner."

# game/scripts/c32/c32.rpy:99
translate french c32s001_AmaDate_76a93cba:

    # ama "Here we are."
    ama "Nous y voilà."

# game/scripts/c32/c32.rpy:100
translate french c32s001_AmaDate_90a91ac6:

    # mc "Are we going to that restaurant over there?"
    mc "On va à ce restaurant là-bas ?"

# game/scripts/c32/c32.rpy:101
translate french c32s001_AmaDate_eb2d6a0f:

    # ama "Yes, but not on the terrace, from what [car] told me. Follow me."
    ama "Oui, mais pas en terrasse, d'après ce que [car] m'a dit. Suis-moi."

# game/scripts/c32/c32.rpy:103
translate french c32s001_AmaDate_131172a3:

    # "When you reach the parasols..."
    "Quand tu atteins les parasols..."

# game/scripts/c32/c32.rpy:104
translate french c32s001_AmaDate_ce60889d:

    # ama "Wait here for a moment. I need to go inside."
    ama "Attends ici un moment. Je dois aller à l'intérieur."

# game/scripts/c32/c32.rpy:105
translate french c32s001_AmaDate_eac27608:

    # mc "Don't take too long. I miss you already."
    mc "Ne sois pas trop longue. Tu me manques déjà."

# game/scripts/c32/c32.rpy:108
translate french c32s001_AmaDate_3b7e8910:

    # ama "*Giggle* To make the wait a little shorter."
    ama "*Glousse* Pour rendre l'attente un peu plus courte."

# game/scripts/c32/c32.rpy:109
translate french c32s001_AmaDate_57fcd56b:

    # mc "*Laugh* That gives you a couple of extra seconds."
    mc "*Rire* Ça te donne quelques secondes de plus."

# game/scripts/c32/c32.rpy:111
translate french c32s001_AmaDate_ef36b3bd:

    # "You look around while you wait. The first thing that catches your eye is the restaurant's sign."
    "Tu regardes autour de toi en attendant. La première chose qui attire ton attention est l'enseigne du restaurant."

# game/scripts/c32/c32.rpy:112
translate french c32s001_AmaDate_b82312d2:

    # "In a country that lives off tourism, you would have expected the sign to be in English, but it looks like a mix of Dutch, Italian, and Spanish."
    "Dans un pays qui vit du tourisme, tu te serais attendu à ce que l'enseigne soit en anglais, mais ça ressemble à un mélange de néerlandais, d'italien et d'espagnol."
# game/scripts/c32/c32.rpy:113
translate french c32s001_AmaDate_58cde655:

    # "It must be in the local language. Papiamento or something like that."
    "Ça doit être dans la langue locale. Du papiamento ou un truc du genre."

# game/scripts/c32/c32.rpy:115
translate french c32s001_AmaDate_49b97d80:

    # "Only one of the four tables is occupied, so, unless people dine very late here, you're going to have some privacy."
    "Seule une des quatre tables est occupée, donc, à moins que les gens ne dînent très tard ici, vous allez avoir un peu d'intimité."

# game/scripts/c32/c32.rpy:116
translate french c32s001_AmaDate_e64a6722:

    # "You'll have to thank [car] for recommending this beautiful place."
    "Tu devras remercier [car] de t'avoir recommandé ce magnifique endroit."

# game/scripts/c32/c32.rpy:117
translate french c32s001_AmaDate_3b135ebd:

    # "If you had planned it yourself, you probably would have looked at the same travel guides as every other tourist on the island."
    "Si tu l'avais planifié toi-même, tu aurais probablement regardé les mêmes guides de voyage que tous les autres touristes de l'île."

# game/scripts/c32/c32.rpy:118
translate french c32s001_AmaDate_47cf6a77:

    # "And you would have ended up in a noisy restaurant surrounded by tourists looking for exactly the same tropical romantic experience."
    "Et tu aurais fini dans un restaurant bruyant entouré de touristes cherchant exactement la même expérience romantique tropicale."

# game/scripts/c32/c32.rpy:121
translate french c32s001_AmaDate_fb922154:

    # "After a few minutes, [ama] appears with the waitress."
    "Après quelques minutes, [ama] apparaît avec la serveuse."

# game/scripts/c32/c32.rpy:122
translate french c32s001_AmaDate_27992950:

    # ama "[mc], this is [saa], the owner of the restaurant."
    ama "[mc], voici [saa], la propriétaire du restaurant."

# game/scripts/c32/c32.rpy:123
translate french c32s001_AmaDate_86321bc6:

    # "Well, it looks like she isn't the waitress."
    "Eh bien, on dirait que ce n'est pas la serveuse."

# game/scripts/c32/c32.rpy:124
translate french c32s001_AmaDate_196abb99:

    # mc "Nice to meet you, [saa]."
    mc "Enchanté, [saa]."

# game/scripts/c32/c32.rpy:125
translate french c32s001_AmaDate_10bd9872:

    # saa "Likewise, [mc]. Follow me, I've prepared a table for you on the pier."
    saa "De même, [mc]. Suivez-moi, je vous ai préparé une table sur la jetée."

# game/scripts/c32/c32.rpy:126
translate french c32s001_AmaDate_490db2e5:

    # mc "On the pier?"
    mc "Sur la jetée ?"
# game/scripts/c32/c32.rpy:127
translate french c32s001_AmaDate_bef705b7:

    # "You haven't seen any pier nearby, but you looked like a clueless tourist focusing on unimportant things."
    "Tu n'as vu aucune jetée dans le coin, mais tu avais l'air d'un touriste paumé qui se focalise sur des trucs sans importance."

# game/scripts/c32/c32.rpy:129
translate french c32s001_AmaDate_53ee9166:

    # saa "Oma [car] told me to treat you guys like royalty."
    saa "Oma [car] m'a dit de vous traiter comme des rois."

# game/scripts/c32/c32.rpy:130
translate french c32s001_AmaDate_fa393c42:

    # saa "And the pier has the best views."
    saa "Et la jetée offre la plus belle vue."

# game/scripts/c32/c32.rpy:131
translate french c32s001_AmaDate_074cd552:

    # mc "We'll follow you."
    mc "On vous suit."

# game/scripts/c32/c32.rpy:134
translate french c32s001_AmaDate_6598394a:

    # "The pier is at the end of the street, behind some colonial arches. The parasols were blocking it from view."
    "La jetée est au bout de la rue, derrière des arches coloniales. Les parasols bloquaient la vue."

# game/scripts/c32/c32.rpy:135
translate french c32s001_AmaDate_b40f67b2:

    # "The views of the sunset over the Caribbean are mind-blowing."
    "La vue du coucher de soleil sur les Caraïbes est époustouflante."

# game/scripts/c32/c32.rpy:136
translate french c32s001_AmaDate_7abf5ea9:

    # saa "This is your table. I hope you like it."
    saa "Voici votre table. J'espère qu'elle vous plaît."

# game/scripts/c32/c32.rpy:137
translate french c32s001_AmaDate_22ff5d85:

    # mc "It's spectacular."
    mc "C'est spectaculaire."

# game/scripts/c32/c32.rpy:139
translate french c32s001_AmaDate_8c3b4fba:

    # ama "The place is gorgeous, [saa]. Masha danki."
    ama "L'endroit est magnifique, [saa]. Masha danki."

# game/scripts/c32/c32.rpy:140
translate french c32s001_AmaDate_0506264a:

    # saa "An! Mi no tabata sa ku bo ta papia papiamentu."
    saa "An! Mi no tabata sa ku bo ta papia papiamentu."

# game/scripts/c32/c32.rpy:141
translate french c32s001_AmaDate_bc3edc00:

    # ama "I speak a little Papiamento, but [mc] doesn't. *Laugh* From the look on his face, I think it sounded like Greek to him."
    ama "Je parle un peu papiamento, mais pas [mc]. *Rires* Vu la tête qu'il fait, je crois que c'était du chinois pour lui."
# game/scripts/c32/c32.rpy:143
translate french c32s001_AmaDate_09c9a6c1:

    # saa "Sorry, [mc]. It's rare to meet tourists who speak my language, and I switched languages instinctively."
    saa "Désolée, [mc]. C'est rare de rencontrer des touristes qui parlent ma langue, et j'ai changé de langue instinctivement."

# game/scripts/c32/c32.rpy:144
translate french c32s001_AmaDate_7a226f94:

    # mc "Don't worry, [saa]. *Laugh* This is my 'what's going on here?' face."
    mc "Ne vous inquiétez pas, [saa]. *Rires* C'est ma tête de 'qu'est-ce qui se passe ici ?'."

# game/scripts/c32/c32.rpy:145
translate french c32s001_AmaDate_38123692:

    # saa "Well, sit down or else you're going to miss the sunset."
    saa "Eh bien, asseyez-vous ou vous allez rater le coucher de soleil."

# game/scripts/c32/c32.rpy:147
translate french c32s001_AmaDate_b284de32:

    # saa "Do you want to see the menu, or would you prefer a typical Aruban dish?"
    saa "Voulez-vous voir le menu, ou préférez-vous un plat typique d'Aruba ?"

# game/scripts/c32/c32.rpy:148
translate french c32s001_AmaDate_04da265d:

    # mc "A typical dish is fine by me. If I look at the menu, I'll order something I know, so surprise me."
    mc "Un plat typique me va très bien. Si je regarde le menu, je vais commander quelque chose que je connais, alors surprenez-moi."

# game/scripts/c32/c32.rpy:149
translate french c32s001_AmaDate_5ae1ab75:

    # ama "I prefer something typical too."
    ama "Je préfère quelque chose de typique aussi."

# game/scripts/c32/c32.rpy:151
translate french c32s001_AmaDate_551cd1b4:

    # saa "Do you like cheese?"
    saa "Vous aimez le fromage ?"

# game/scripts/c32/c32.rpy:152
translate french c32s001_AmaDate_5d196d07:

    # mc "I love it."
    mc "J'adore ça."

# game/scripts/c32/c32.rpy:153
translate french c32s001_AmaDate_6d34ae6f:

    # ama "Keshi yená? Sounds perfect to me."
    ama "Keshi yená ? Ça me semble parfait."

# game/scripts/c32/c32.rpy:155
translate french c32s001_AmaDate_2515be4b:

    # saa "That's what I was going to suggest. It's stuffed Dutch cheese, [mc]. It's practically the national dish of Aruba."
    saa "C'est ce que j'allais suggérer. C'est du fromage hollandais farci, [mc]. C'est pratiquement le plat national d'Aruba."

# game/scripts/c32/c32.rpy:156
translate french c32s001_AmaDate_6fbc3ec4:

    # saa "And it's perfect for sharing."
    saa "Et c'est parfait pour partager."
# game/scripts/c32/c32.rpy:157
translate french c32s001_AmaDate_4b6ce816:

    # ama "I think you'll like it. Plus, it NEVER has broccoli in it."
    ama "Je pense que tu vas aimer. En plus, il n'y a JAMAIS de brocolis dedans."

# game/scripts/c32/c32.rpy:158
translate french c32s001_AmaDate_107095be:

    # mc "Then it sounds perfect to me."
    mc "Alors ça me semble parfait."

# game/scripts/c32/c32.rpy:161
translate french c32s001_AmaDate_1f3d13f5:

    # "After [saa] takes the rest of your dinner order..."
    "Après que [saa] ait pris le reste de votre commande..."

# game/scripts/c32/c32.rpy:162
translate french c32s001_AmaDate_7f672bcf:

    # ama "Even though [saa] is very nice, I couldn't wait for her to leave."
    ama "Même si [saa] est très gentille, j'avais hâte qu'elle parte."

# game/scripts/c32/c32.rpy:163
translate french c32s001_AmaDate_b3961c59:

    # mc "Why?"
    mc "Pourquoi ?"

# game/scripts/c32/c32.rpy:164
translate french c32s001_AmaDate_ed50e134:

    # ama "To ask you to stand up. I've been wanting to kiss you for a while."
    ama "Pour te demander de te lever. J'ai envie de t'embrasser depuis un moment."

# game/scripts/c32/c32.rpy:166
translate french c32s001_AmaDate_7ab86280:

    # "Neither of you needs to say anything. It's not a typical first date, and kisses are part of your relationship."
    "Aucun de vous n'a besoin de dire quoi que ce soit. Ce n'est pas un premier rendez-vous typique, et les baisers font partie de votre relation."

# game/scripts/c32/c32.rpy:167
translate french c32s001_AmaDate_ba679b52:

    # "But it's your first kiss during a sunset. It won't be the last one."
    "Mais c'est votre premier baiser pendant un coucher de soleil. Ce ne sera pas le dernier."

# game/scripts/c32/c32.rpy:170
translate french c32s001_AmaDate_1839c8d8:

    # "When you sit back down..."
    "Quand vous vous rasseyez..."

# game/scripts/c32/c32.rpy:171
translate french c32s001_AmaDate_6d08fe9f:

    # mc "I guess you've never been here, right? Your surprised face when you saw the pier looked a lot like the one I think I had."
    mc "Je suppose que tu n'es jamais venue ici, pas vrai ? Ton visage surpris quand tu as vu la jetée ressemblait beaucoup à celui que je pense avoir eu."

# game/scripts/c32/c32.rpy:172
translate french c32s001_AmaDate_a43c6547:

    # ama "This place is beautiful. You know we couldn't leave the base unless it was for a mission."
    ama "Cet endroit est magnifique. Tu sais qu'on ne pouvait pas quitter la base à moins que ce soit pour une mission."
# game/scripts/c32/c32.rpy:173
translate french c32s001_AmaDate_047d1d7e:

    # ama "Us girls were a bit different, a part of our training included blending in with... normal... people."
    ama "Nous, les filles, étions un peu différentes, une partie de notre entraînement consistait à nous fondre parmi les gens... normaux..."

# game/scripts/c32/c32.rpy:174
translate french c32s001_AmaDate_884c7a26:

    # ama "It wasn't all combat for us. But we were always supervised, and I've never been here."
    ama "Ce n'était pas que du combat pour nous. Mais nous étions toujours surveillées, et je ne suis jamais venue ici."

# game/scripts/c32/c32.rpy:175
translate french c32s001_AmaDate_912eef03:

    # mc "Then it seems like an even more ideal place. The first time for both of us."
    mc "Alors ça semble être un endroit encore plus idéal. La première fois pour nous deux."

# game/scripts/c32/c32.rpy:176
translate french c32s001_AmaDate_f8209983:

    # mc "And speaking Papiamento, that's another surprise in [ama]'s endless box of surprises, right?"
    mc "Et parler papiamento, c'est une autre surprise dans la boîte à surprises sans fin d'[ama], n'est-ce pas ?"

# game/scripts/c32/c32.rpy:178
translate french c32s001_AmaDate_208b125e:

    # ama "There are many languages in Aruba. We grew up with Dutch, English, and Spanish as our main languages."
    ama "Il y a beaucoup de langues à Aruba. Nous avons grandi avec le néerlandais, l'anglais et l'espagnol comme langues principales."

# game/scripts/c32/c32.rpy:179
translate french c32s001_AmaDate_0d17775d:

    # ama "But we also learned Papiamento and other Caribbean Creole languages. Aside from the typical ones: German, Chinese, French..."
    ama "Mais nous avons aussi appris le papiamento et d'autres langues créoles des Caraïbes. En plus des langues typiques : allemand, chinois, français..."

# game/scripts/c32/c32.rpy:180
translate french c32s001_AmaDate_9eba5728:

    # mc "How many languages do you speak?"
    mc "Combien de langues parles-tu ?"

# game/scripts/c32/c32.rpy:182
translate french c32s001_AmaDate_6c486d6f:

    # ama "I've never counted them. [eva] says it's 17, but she's been saying it's 17 for years, and we learned more languages after that."
    ama "Je ne les ai jamais comptées. [eva] dit que c'est 17, mais ça fait des années qu'elle dit ça, et nous avons appris d'autres langues depuis."

# game/scripts/c32/c32.rpy:183
translate french c32s001_AmaDate_92047158:

    # ama "I guess I must speak about 15 languages fluently, with different regionalisms, and around another 15 with a pretty heavy accent."
    ama "Je suppose que je dois parler couramment environ 15 langues, avec différents régionalismes, et environ 15 autres avec un accent assez prononcé."

# game/scripts/c32/c32.rpy:185
translate french c32s001_AmaDate_78ffd9e0:

    # ama "But I don't want to talk about that. How are you liking your first days on the island?"
    ama "Mais je ne veux pas parler de ça. Comment trouves-tu tes premiers jours sur l'île ?"

# game/scripts/c32/c32.rpy:186
translate french c32s001_AmaDate_54f0f36c:

    # mc "Most of it has been working on things I wasn't ready for. But, little by little, I'm adapting."
    mc "La plupart du temps, j'ai travaillé sur des choses pour lesquelles je n'étais pas prêt. Mais, petit à petit, je m'adapte."
# game/scripts/c32/c32.rpy:187
translate french c32s001_AmaDate_e9a81f5a:

    # mc "Tonight is going to be the best time since we arrived."
    mc "Ce soir sera la meilleure soirée depuis notre arrivée."

# game/scripts/c32/c32.rpy:188
translate french c32s001_AmaDate_58a5e581:

    # mc "And you? How are you handling being back in Aruba?"
    mc "Et toi ? Comment tu gères le fait d'être de retour à Aruba ?"

# game/scripts/c32/c32.rpy:190
translate french c32s001_AmaDate_9a46fb69:

    # ama "It's different from what I thought it would be. Switching from operations to security..."
    ama "C'est différent de ce que j'imaginais. Passer des opérations à la sécurité..."

# game/scripts/c32/c32.rpy:191
translate french c32s001_AmaDate_aecc9d35:

    # ama "Sometimes I miss training with the guys."
    ama "Parfois, ça me manque de m'entraîner avec les gars."

# game/scripts/c32/c32.rpy:192
translate french c32s001_AmaDate_401cbcd8:

    # mc "You know you can do that, right? Just because you're the head of security now doesn't mean you can't go shoot with non-tanks."
    mc "Tu sais que tu peux toujours le faire, pas vrai ? C'est pas parce que tu es chef de la sécurité maintenant que tu peux plus aller tirer avec autre chose que des tanks."

# game/scripts/c32/c32.rpy:194
translate french c32s001_AmaDate_f246318a:

    # ama "*Laugh* It's a...!"
    ama "*Rire* C'est un... !"

# game/scripts/c32/c32.rpy:195
translate french c32s001_AmaDate_03274b92:

    # mc "*Laugh* A Bradley, an IFV, I know. But you always laugh when I don't remember the name."
    mc "*Rire* Un Bradley, un VCI, je sais. Mais tu rigoles toujours quand je me souviens plus du nom."

# game/scripts/c32/c32.rpy:196
translate french c32s001_AmaDate_dc8d0f44:

    # mc "Well, almost always. Sometimes you look at me like you're wondering if I'll ever learn it."
    mc "Enfin, presque toujours. Parfois tu me regardes comme si tu te demandais si je l'apprendrai un jour."

# game/scripts/c32/c32.rpy:198
translate french c32s001_AmaDate_126dd5c5:

    # ama "And you already have. I guess it must be complicated for you too. Too many new things."
    ama "Et c'est déjà fait. J'imagine que ça doit être compliqué pour toi aussi. Trop de nouvelles choses."

# game/scripts/c32/c32.rpy:199
translate french c32s001_AmaDate_71959540:

    # mc "I grew up knowing how to distinguish between car models and gaming consoles. You grew up knowing how to distinguish between a Bradley and a T-72."
    mc "J'ai grandi en sachant faire la différence entre les modèles de voitures et les consoles de jeux. Tu as grandi en sachant faire la différence entre un Bradley et un T-72."

# game/scripts/c32/c32.rpy:200
translate french c32s001_AmaDate_24291fd2:

    # mc "I just have to learn in a few weeks what you've spent years learning."
    mc "Je dois juste apprendre en quelques semaines ce que tu as mis des années à apprendre."
# game/scripts/c32/c32.rpy:202
translate french c32s001_AmaDate_826405ad:

    # ama "You don't need to learn every weapon model in the world. That would be almost impossible in such a short time, besides everything else you have to do."
    ama "Tu n'as pas besoin d'apprendre tous les modèles d'armes du monde. Ce serait presque impossible en si peu de temps, sans compter tout ce que tu as d'autre à faire."

# game/scripts/c32/c32.rpy:203
translate french c32s001_AmaDate_22359eef:

    # ama "I think learning the categories and what each thing is for should be enough."
    ama "Je pense qu'apprendre les catégories et à quoi sert chaque chose devrait suffire."

# game/scripts/c32/c32.rpy:205
translate french c32s001_AmaDate_675aaff2:

    # ama "You have staff to design the operations, so you don't need to master it perfectly."
    ama "Tu as du personnel pour concevoir les opérations, donc tu n'as pas besoin de le maîtriser à la perfection."

# game/scripts/c32/c32.rpy:206
translate french c32s001_AmaDate_c6f8623e:

    # ama "But at least you wouldn't look like an idiot when they talk to you about rifles, shotguns, and carbines."
    ama "Mais au moins, tu n'aurais pas l'air d'un idiot quand ils te parlent de fusils, de fusils à pompe et de carabines."

# game/scripts/c32/c32.rpy:207
translate french c32s001_AmaDate_fff47989:

    # mc "*Laugh* Do I look like an idiot?"
    mc "*Rires* J'ai l'air d'un idiot ?"

# game/scripts/c32/c32.rpy:209
translate french c32s001_AmaDate_f645f345:

    # ama "*Laugh* I'd rather not answer that. It's our first date and I don't want you to feel bad."
    ama "*Rires* Je préfère ne pas répondre à ça. C'est notre premier rencard et je ne veux pas que tu te sentes mal."

# game/scripts/c32/c32.rpy:210
translate french c32s001_AmaDate_38a3de91:

    # ama "*Laugh* I want us to go on a second date someday."
    ama "*Rires* Je veux qu'on ait un deuxième rencard un de ces jours."

# game/scripts/c32/c32.rpy:211
translate french c32s001_AmaDate_88e70f89:

    # mc "*Laugh* Sounds good to me."
    mc "*Rires* Ça me va."

# game/scripts/c32/c32.rpy:212
translate french c32s001_AmaDate_f702d746:

    # mc "I just have one question. Why today?"
    mc "J'ai juste une question. Pourquoi aujourd'hui ?"

# game/scripts/c32/c32.rpy:214
translate french c32s001_AmaDate_9d4a1e5e:

    # ama "Because [bet] was staying at the base. I wouldn't have felt comfortable leaving her home alone."
    ama "Parce que [bet] restait à la base. Je ne me serais pas sentie à l'aise de la laisser seule à la maison."

# game/scripts/c32/c32.rpy:215
translate french c32s001_AmaDate_d2a254d7:

    # mc "If that's why, we could have had our first date in Newport."
    mc "Si c'est pour ça, on aurait pu avoir notre premier rencard à Newport."
# game/scripts/c32/c32.rpy:216
translate french c32s001_AmaDate_2f1368a5:

    # mc "There's something else, I'm sure."
    mc "Il y a autre chose, j'en suis sûr."

# game/scripts/c32/c32.rpy:218
translate french c32s001_AmaDate_d377b642:

    # ama "Yes. Yesterday, you didn't think I was a psycho for having... you know."
    ama "Oui. Hier, tu n'as pas pensé que j'étais une psychopathe pour avoir... tu sais."

# game/scripts/c32/c32.rpy:219
translate french c32s001_AmaDate_ee3425b3:

    # ama "I didn't want to have our first date until I had shown it to you."
    ama "Je ne voulais pas qu'on ait notre premier rencard avant de te l'avoir montré."

# game/scripts/c32/c32.rpy:220
translate french c32s001_AmaDate_4bebfb2f:

    # ama "I didn't want you to think you'd slept with a crazy woman when I showed it to you."
    ama "Je ne voulais pas que tu penses avoir couché avec une folle quand je te l'ai montré."

# game/scripts/c32/c32.rpy:221
translate french c32s001_AmaDate_4e2b5b5b:

    # mc "Sleep together? We only talked about going out for dinner."
    mc "Coucher ensemble ? On a seulement parlé d'aller dîner."

# game/scripts/c32/c32.rpy:224
translate french c32s001_AmaDate_64c38b5d:

    # ama "WHAT? You don't want to sleep with me?"
    ama "QUOI ? Tu ne veux pas coucher avec moi ?"

# game/scripts/c32/c32.rpy:225
translate french c32s001_AmaDate_ee19ac53:

    # mc "*Laugh* Of course I do. But I also wanted to see that surprised face."
    mc "*Rire* Bien sûr que si. Mais je voulais aussi voir ce visage surpris."

# game/scripts/c32/c32.rpy:226
translate french c32s001_AmaDate_58517f7e:

    # mc "*Laugh* I'm not the only one at this table who can make an idiot face."
    mc "*Rire* Je ne suis pas le seul à cette table qui peut faire une tête d'idiot."

# game/scripts/c32/c32.rpy:228
translate french c32s001_AmaDate_90ed2013:

    # ama "*Laugh* But you're the only one at this table who doesn't know how to break a hand in thirteen different places."
    ama "*Rire* Mais tu es le seul à cette table qui ne sait pas comment briser une main à treize endroits différents."

# game/scripts/c32/c32.rpy:229
translate french c32s001_AmaDate_7b3c64f8:

    # mc "*Laugh* Okay. No more jokes that make you look idiot. Or that put my hands in danger."
    mc "*Rire* D'accord. Plus de blagues qui te font passer pour une idiote. Ou qui mettent mes mains en danger."

# game/scripts/c32/c32.rpy:230
translate french c32s001_AmaDate_543f1f7a:

    # ama "*Laugh* We don't want to have to amputate your fingers and have you end up with smaller hands than [vin]."
    ama "*Rire* On ne voudrait pas devoir t'amputer les doigts et que tu te retrouves avec des mains plus petites que celles de [vin]."
# game/scripts/c32/c32.rpy:231
translate french c32s001_AmaDate_50d089ac:

    # mc "*Laugh* Nope."
    mc "*Rires* Non."

# game/scripts/c32/c32.rpy:232
translate french c32s001_AmaDate_53ae1b94:

    # mc "But seriously, I think you were worrying too much about my reaction."
    mc "Mais sérieusement, je pense que tu t'inquiétais trop de ma réaction."

# game/scripts/c32/c32.rpy:234
translate french c32s001_AmaDate_f81c8740:

    # ama "I also didn't know how coming back to this place would affect me."
    ama "Je ne savais pas non plus comment revenir à cet endroit m'affecterait."

# game/scripts/c32/c32.rpy:235
translate french c32s001_AmaDate_f1c86679:

    # ama "I mean the base..."
    ama "Je veux dire la base..."

# game/scripts/c32/c32.rpy:236
translate french c32s001_AmaDate_ac5bd3f4:

    # mc "I think you're handling it really well."
    mc "Je trouve que tu gères ça vraiment bien."

# game/scripts/c32/c32.rpy:237
translate french c32s001_AmaDate_8a5f4bc2:

    # mc "From what you guys explained to me, I thought you'd have some scores to settle with your old instructors."
    mc "D'après ce que vous m'avez expliqué, je pensais que tu aurais des comptes à régler avec tes anciens instructeurs."

# game/scripts/c32/c32.rpy:239
translate french c32s001_AmaDate_5d4674b4:

    # ama "The worst ones aren't with the company anymore. When the A's and C's were able to train the rest of the series, they got rid of the external ex-military guys."
    ama "Les pires ne sont plus dans l'entreprise. Quand les A et les C ont été capables d'entraîner le reste des séries, ils se sont débarrassés des ex-militaires externes."

# game/scripts/c32/c32.rpy:240
translate french c32s001_AmaDate_8c4dde0d:

    # ama "I guess [eva] told you about when they would aim a gun at our heads at the shooting range, the moment they gave us a weapon."
    ama "Je suppose qu'[eva] t'a raconté comment ils pointaient une arme sur nos têtes au stand de tir, à l'instant même où ils nous donnaient une arme."

# game/scripts/c32/c32.rpy:241
translate french c32s001_AmaDate_31abe2d0:

    # mc "Yes, that's exactly what I meant. It's inhumane."
    mc "Oui, c'est exactement ce que je voulais dire. C'est inhumain."

# game/scripts/c32/c32.rpy:243
translate french c32s001_AmaDate_26db4307:

    # ama "The older series went through that. The A's, B's, C's, D's, and us. I think even the E's."
    ama "Les anciennes séries sont passées par là. Les A, B, C, D, et nous. Je crois même les E."

# game/scripts/c32/c32.rpy:244
translate french c32s001_AmaDate_16dc8bb1:

    # ama "When those instructors were fired, the A's refused to ever use that shooting range to train us again."
    ama "Quand ces instructeurs ont été virés, les A ont refusé d'utiliser à nouveau ce stand de tir pour nous entraîner."
# game/scripts/c32/c32.rpy:246
translate french c32s001_AmaDate_69e2182f:

    # ama "The excuse was that it had become too small for the new series, which were larger. You couldn't fit 20 F's at the shooting range at the same time."
    ama "L'excuse était que c'était devenu trop petit pour les nouvelles séries, qui étaient plus grandes. On ne pouvait pas faire tenir 20 F au stand de tir en même temps."

# game/scripts/c32/c32.rpy:247
translate french c32s001_AmaDate_be0cdaf9:

    # ama "But the real reason is that nobody wanted to go back there."
    ama "Mais la vraie raison, c'est que personne ne voulait y retourner."

# game/scripts/c32/c32.rpy:248
translate french c32s001_AmaDate_751296a6:

    # mc "I get it. I guess you guys had a hard time."
    mc "Je comprends. J'imagine que ça a été dur pour vous."

# game/scripts/c32/c32.rpy:250
translate french c32s001_AmaDate_2040272f:

    # ama "Now some of the guys use it when they want to compete with each other."
    ama "Maintenant, certains gars l'utilisent quand ils veulent s'affronter."

# game/scripts/c32/c32.rpy:251
translate french c32s001_AmaDate_d0ce68a4:

    # ama "Usually, they're guys who weren't around back then, and who aren't allowed to compete in the active range."
    ama "En général, ce sont des gars qui n'étaient pas là à l'époque, et qui n'ont pas le droit de s'affronter dans le stand actif."

# game/scripts/c32/c32.rpy:252
translate french c32s001_AmaDate_23ae9f31:

    # ama "The old shooting range has become an oasis of tranquility."
    ama "L'ancien stand de tir est devenu une oasis de tranquillité."

# game/scripts/c32/c32.rpy:253
translate french c32s001_AmaDate_f7421095:

    # mc "Except when they want to compete, right?"
    mc "Sauf quand ils veulent s'affronter, pas vrai ?"

# game/scripts/c32/c32.rpy:255
translate french c32s001_AmaDate_e1898150:

    # ama "They don't do it often. The instructors, from the C's to the F's, keep them busy."
    ama "Ils ne le font pas souvent. Les instructeurs, des C aux F, les tiennent occupés."

# game/scripts/c32/c32.rpy:256
translate french c32s001_AmaDate_944beacd:

    # ama "But it's a beautiful place with ugly memories. I'll show it to you when we go to the training base... if you want."
    ama "Mais c'est un endroit magnifique avec de vilains souvenirs. Je te le montrerai quand on ira à la base d'entraînement... si tu veux."

# game/scripts/c32/c32.rpy:257
translate french c32s001_AmaDate_02848cdf:

    # mc "If going back there is going to be hard for you, it's not necessary."
    mc "Si y retourner est trop dur pour toi, ce n'est pas la peine."

# game/scripts/c32/c32.rpy:259
translate french c32s001_AmaDate_556a06dd:

    # ama "Like you said, I think I'm handling it... well."
    ama "Comme tu l'as dit, je crois que je le vis... bien."
# game/scripts/c32/c32.rpy:260
translate french c32s001_AmaDate_7d959a14:

    # ama "I think going back there after so long could be good. To create new memories with you."
    ama "Je pense qu'y retourner après tout ce temps pourrait être une bonne chose. Pour créer de nouveaux souvenirs avec toi."

# game/scripts/c32/c32.rpy:261
translate french c32s001_AmaDate_e803d73e:

    # mc "If that's what you think, alright. I'd be glad to take the sightseeing tour of the shooting range."
    mc "Si c'est ce que tu penses, d'accord. Je serais ravi de faire la visite touristique du stand de tir."

# game/scripts/c32/c32.rpy:263
translate french c32s001_AmaDate_a39ccc8c:

    # ama "The {b}old{/b} shooting range."
    ama "L'{b}ancien{/b} stand de tir."

# game/scripts/c32/c32.rpy:264
translate french c32s001_AmaDate_7f95a52d:

    # ama "And if we keep talking about things that aren't important anymore, we're going to miss the sunset."
    ama "Et si on continue à parler de choses qui n'ont plus d'importance, on va rater le coucher de soleil."

# game/scripts/c32/c32.rpy:265
translate french c32s001_AmaDate_1b203f69:

    # mc "I'm not going to decide what's important and what's not in this case."
    mc "Je ne vais pas décider de ce qui est important ou non dans ce cas."

# game/scripts/c32/c32.rpy:266
translate french c32s001_AmaDate_9070dfa5:

    # mc "I have to decide too much of that every day at the company."
    mc "Je dois déjà trop le faire tous les jours à l'entreprise."

# game/scripts/c32/c32.rpy:268
translate french c32s001_AmaDate_791227f7:

    # "You hold hands across the table while watching a giant ball of fire continue its inexorable journey towards the horizon."
    "Vous vous tenez la main par-dessus la table tout en regardant une boule de feu géante poursuivre son voyage inexorable vers l'horizon."

# game/scripts/c32/c32.rpy:269
translate french c32s001_AmaDate_577e0109:

    # "Sometimes you worry about [ama]'s sudden mood swings. Maybe this trip came too soon for her."
    "Parfois, tu t'inquiètes des sautes d'humeur soudaines de [ama]. Peut-être que ce voyage est arrivé trop tôt pour elle."

# game/scripts/c32/c32.rpy:272
translate french c32s001_AmaDate_bfc1334f:

    # saa "Guys, I brought your food just in time for the sunset. I added some krokechi for you to try."
    saa "Les amis, je vous ai apporté à manger juste à temps pour le coucher du soleil. J'ai ajouté des krokechi pour que vous goûtiez."

# game/scripts/c32/c32.rpy:273
translate french c32s001_AmaDate_5400cd44:

    # saa "I hope you like fish and seafood."
    saa "J'espère que vous aimez le poisson et les fruits de mer."

# game/scripts/c32/c32.rpy:274
translate french c32s001_AmaDate_235479d8:

    # mc "Sounds perfect to me."
    mc "Ça me semble parfait."
# game/scripts/c32/c32.rpy:275
translate french c32s001_AmaDate_0058a860:

    # ama "Thank you, [saa]."
    ama "Merci, [saa]."

# game/scripts/c32/c32.rpy:276
translate french c32s001_AmaDate_63e7db9a:

    # saa "Enjoy your meal. I'll come check on you in case you need anything else."
    saa "Bon appétit. Je repasserai vous voir au cas où vous auriez besoin d'autre chose."

# game/scripts/c32/c32.rpy:278
translate french c32s001_AmaDate_6ecffa80:

    # "You look at the appetizing food for a second before deciding it looks amazing."
    "Tu regardes la nourriture appétissante un instant avant de te dire qu'elle a l'air incroyable."

# game/scripts/c32/c32.rpy:279
translate french c32s001_AmaDate_e45fc385:

    # "You've always thought that many tourists miss out on local delicacies by playing it safe and eating at MacDonald's."
    "Tu as toujours pensé que beaucoup de touristes passent à côté des spécialités locales en jouant la carte de la sécurité et en mangeant au McDo."

# game/scripts/c32/c32.rpy:280
translate french c32s001_AmaDate_583d1f30:

    # "Maybe the glutton inside you is the one directing your thoughts right now."
    "C'est peut-être le glouton qui sommeille en toi qui dirige tes pensées en ce moment."

# game/scripts/c32/c32.rpy:282
translate french c32s001_AmaDate_75b4cdd2:

    # ama "*Laugh* I know what you're going to say."
    ama "*Rire* Je sais ce que tu vas dire."

# game/scripts/c32/c32.rpy:283
translate french c32s001_AmaDate_c40ec18b:

    # mc "What am I going to say?"
    mc "Qu'est-ce que je vais dire ?"

# game/scripts/c32/c32.rpy:285
translate french c32s001_AmaDate_d55d42e1:

    # ama "*Faking a manly voice* It looks good, but I'd be just as happy eating a burger."
    ama "*Prenant une voix d'homme* Ça a l'air bon, mais je serais tout aussi content de manger un burger."

# game/scripts/c32/c32.rpy:286
translate french c32s001_AmaDate_c506ce89:

    # ama "*Faking a manly voice* The important thing is that I'm going to share it with you."
    ama "*Prenant une voix d'homme* L'important, c'est que je vais le partager avec toi."

# game/scripts/c32/c32.rpy:287
translate french c32s001_AmaDate_1222260d:

    # mc "*Laugh* You almost got it. The second part would be 'The important thing is the company.'"
    mc "*Rire* Tu y étais presque. La deuxième partie serait 'L'important, c'est la compagnie.'"

# game/scripts/c32/c32.rpy:288
translate french c32s001_AmaDate_f5699506:

    # mc "But I was just thinking what a waste it would be to eat a burger right now."
    mc "Mais je me disais justement que ce serait un beau gâchis de manger un burger maintenant."
# game/scripts/c32/c32.rpy:289
translate french c32s001_AmaDate_11e13a2d:

    # mc "This looks excellent! And we can eat all the burgers we want when we get back home."
    mc "Ça a l'air excellent ! Et on pourra manger tous les burgers qu'on veut quand on rentrera à la maison."

# game/scripts/c32/c32.rpy:291
translate french c32s001_AmaDate_ebb631bc:

    # ama "The Keshi yená is really good. The krokechi are like fish croquettes, but round. It's not my favorite dish, but they're good too."
    ama "Le Keshi yená est vraiment bon. Les krokechi sont comme des croquettes de poisson, mais rondes. Ce n'est pas mon plat préféré, mais c'est bon aussi."

# game/scripts/c32/c32.rpy:292
translate french c32s001_AmaDate_d63c5db5:

    # mc "I've never asked you what your favorite dish is. And it's the typical first date question."
    mc "Je ne t'ai jamais demandé quel était ton plat préféré. Et c'est la question typique d'un premier rendez-vous."

# game/scripts/c32/c32.rpy:294
translate french c32s001_AmaDate_7ca4113a:

    # ama "*Laugh* Anything [mar] or [nor] cook. They are great cooks, but also... their food tastes like home."
    ama "*Rire* Tout ce que [mar] ou [nor] cuisinent. Ce sont de super cuisinières, mais aussi... leur cuisine a le goût de la maison."

# game/scripts/c32/c32.rpy:295
translate french c32s001_AmaDate_f90fff0d:

    # mc "Do you miss them already? I know the feeling."
    mc "Elles te manquent déjà ? Je connais ça."

# game/scripts/c32/c32.rpy:297
translate french c32s001_AmaDate_7f81a1de:

    # ama "I miss everyone, but especially those two and [eva]."
    ama "Tout le monde me manque, mais surtout ces deux-là et [eva]."

# game/scripts/c32/c32.rpy:298
translate french c32s001_AmaDate_59191d5b:

    # ama "Don't get me wrong. I love being here with you and Aunt [bet], being able to sleep with you every night..."
    ama "Ne te méprends pas. J'adore être ici avec toi et tante [bet], pouvoir dormir avec toi toutes les nuits..."

# game/scripts/c32/c32.rpy:299
translate french c32s001_AmaDate_8d44a29b:

    # mc "But there's nothing like being home."
    mc "Mais rien ne vaut son chez-soi."

# game/scripts/c32/c32.rpy:301
translate french c32s001_AmaDate_4d4e4d47:

    # ama "Exactly. Even though I've only been part of the family for a short time... Newport is more my home than Aruba ever was."
    ama "Exactement. Même si je ne fais partie de la famille que depuis peu de temps... Newport est plus ma maison qu'Aruba ne l'a jamais été."

# game/scripts/c32/c32.rpy:302
translate french c32s001_AmaDate_5fe77f18:

    # mc "I'm glad you feel that way about Newport. We have to change your perception of Aruba."
    mc "Je suis content que tu ressentes ça pour Newport. On doit changer ta perception d'Aruba."

# game/scripts/c32/c32.rpy:303
translate french c32s001_AmaDate_54396300:

    # mc "We need to make new memories, like what you said about the old shooting range."
    mc "On doit se créer de nouveaux souvenirs, comme ce que tu as dit sur l'ancien stand de tir."
# game/scripts/c32/c32.rpy:304
translate french c32s001_AmaDate_03377b16:

    # mc "And we're going to start doing that today."
    mc "Et on va commencer à le faire aujourd'hui."

# game/scripts/c32/c32.rpy:306
translate french c32s001_AmaDate_bea5db30:

    # "And you create new memories."
    "Et vous créez de nouveaux souvenirs."

# game/scripts/c32/c32.rpy:307
translate french c32s001_AmaDate_03babefe:

    # "It seems like the sunset pauses to give you the perfect moment to have dinner under its light."
    "On dirait que le coucher de soleil s'arrête pour vous offrir le moment parfait pour dîner sous sa lumière."

# game/scripts/c32/c32.rpy:308
translate french c32s001_AmaDate_465be367:

    # "To create a new memory."
    "Pour créer un nouveau souvenir."

# game/scripts/c32/c32.rpy:309
translate french c32s001_AmaDate_a82ac7a3:

    # "You enjoy the exquisite dinner that [saa] has prepared for you."
    "Vous profitez du dîner exquis que [saa] a préparé pour vous."

# game/scripts/c32/c32.rpy:310
translate french c32s001_AmaDate_4a43aaaf:

    # "You really wouldn't care if it were a burger. The important thing is the company."
    "Tu t'en ficherais complètement si c'était un burger. L'important, c'est la compagnie."

# game/scripts/c32/c32.rpy:312
translate french c32s001_AmaDate_cfa87aec:

    # "Not even the appearance of a tourist boat at the last minute can ruin the magic of the moment."
    "Même l'apparition d'un bateau de touristes à la dernière minute ne peut gâcher la magie du moment."

# game/scripts/c32/c32.rpy:313
translate french c32s001_AmaDate_48aa883a:

    # "Neither of you is able to see it."
    "Aucun de vous deux n'est capable de le voir."

# game/scripts/c32/c32.rpy:315
translate french c32s001_AmaDate_3b61fbcc:

    # "You only have eyes for each other."
    "Vous n'avez d'yeux que l'un pour l'autre."

# game/scripts/c32/c32.rpy:316
translate french c32s001_AmaDate_09994c39:

    # "You'll have to come back to watch the sunset another day."
    "Vous devrez revenir regarder le coucher de soleil un autre jour."

# game/scripts/c32/c32.rpy:317
translate french c32s001_AmaDate_78aefecf:

    # "And you will."
    "Et c'est ce que vous ferez."
# game/scripts/c32/c32.rpy:318
translate french c32s001_AmaDate_f22f5d53:

    # "And you'll miss it again."
    "Et tu vas encore le rater."

# game/scripts/c32/c32.rpy:321
translate french c32s001_AmaDate_9537abf0:

    # "You didn't even notice that [saa] turned on the lights at some point."
    "Tu n'as même pas remarqué que [saa] a allumé les lumières à un moment donné."

# game/scripts/c32/c32.rpy:322
translate french c32s001_AmaDate_a0c3a3d5:

    # mc "Looks like we missed the sunset."
    mc "On dirait qu'on a raté le coucher de soleil."

# game/scripts/c32/c32.rpy:323
translate french c32s001_AmaDate_9b0f8974:

    # ama "There was something more interesting to look at."
    ama "Il y avait quelque chose de plus intéressant à regarder."

# game/scripts/c32/c32.rpy:324
translate french c32s001_AmaDate_2ebb5df0:

    # mc "That should've been my line..."
    mc "Ça aurait dû être ma réplique..."

# game/scripts/c32/c32.rpy:325
translate french c32s001_AmaDate_1704db63:

    # ama "We're a team. It doesn't matter who says the lines."
    ama "On est une équipe. Peu importe qui dit les répliques."

# game/scripts/c32/c32.rpy:327
translate french c32s001_AmaDate_7fdab66d:

    # ama "Do you know how to dive?"
    ama "Tu sais plonger ?"

# game/scripts/c32/c32.rpy:328
translate french c32s001_AmaDate_ae23b10c:

    # mc "Like with oxygen tanks and stuff? I've never done it, but it can't be {b}that{/b} hard, right?"
    mc "Genre avec des bouteilles d'oxygène et tout ? Je ne l'ai jamais fait, mais ça ne doit pas être {b}si{/b} dur que ça, non ?"

# game/scripts/c32/c32.rpy:329
translate french c32s001_AmaDate_da5e3d4c:

    # ama "It's harder than it looks. But I meant snorkeling and skin diving."
    ama "C'est plus dur que ça en a l'air. Mais je parlais de plongée avec tuba et en apnée."

# game/scripts/c32/c32.rpy:330
translate french c32s001_AmaDate_339ee637:

    # mc "Oh, yeah! I definitely know how to do that."
    mc "Oh, ouais ! Je sais carrément faire ça."

# game/scripts/c32/c32.rpy:332
translate french c32s001_AmaDate_a1363d08:

    # ama "Then let's go. [car] sent me the address of a place where they do night dives."
    ama "Alors on y va. [car] m'a envoyé l'adresse d'un endroit où ils font des plongées de nuit."
# game/scripts/c32/c32.rpy:333
translate french c32s001_AmaDate_9b5dddfb:

    # mc "Now?"
    mc "Maintenant ?"

# game/scripts/c32/c32.rpy:335
translate french c32s001_AmaDate_c3531e5a:

    # ama "*Laugh* Doing night dives during the day isn't very fun. Besides, it's impossible."
    ama "*Rires* Faire des plongées de nuit pendant la journée, ce n'est pas très amusant. En plus, c'est impossible."

# game/scripts/c32/c32.rpy:336
translate french c32s001_AmaDate_6f56ef04:

    # mc "*Laugh* Okay, I'm an idiot. But [car] wants to kill me!"
    mc "*Rires* D'accord, je suis un idiot. Mais [car] veut me tuer !"

# game/scripts/c32/c32.rpy:338
translate french c32s001_AmaDate_e161fd1b:

    # ama "It was my idea. I asked her if she knew a place where we could do it."
    ama "C'était mon idée. Je lui ai demandé si elle connaissait un endroit où on pourrait le faire."

# game/scripts/c32/c32.rpy:339
translate french c32s001_AmaDate_6a5fdb75:

    # ama "I'm sure none of your dates have included a diving session."
    ama "Je suis sûre qu'aucun de tes rencards n'a inclus une session de plongée."

# game/scripts/c32/c32.rpy:340
translate french c32s001_AmaDate_29f1bdca:

    # mc "Once again, you're right. And once again, [ama]'s box of surprises seems bottomless."
    mc "Encore une fois, tu as raison. Et encore une fois, la boîte à surprises de [ama] semble inépuisable."

# game/scripts/c32/c32.rpy:342
translate french c32s001_AmaDate_4a189bfb:

    # "Before you can go pay, [ama] gives you a passionate kiss under the light of the stars."
    "Avant que tu ne puisses aller payer, [ama] t'embrasse passionnément sous la lumière des étoiles."

# game/scripts/c32/c32.rpy:343
translate french c32s001_AmaDate_011d3867:

    # "The date is going fantastic."
    "Le rencard se passe à merveille."

# game/scripts/c32/c32.rpy:346
translate french c32s001_AmaDate_b6211181:

    # "Once you pay the bill and say goodbye to [saa], back in the car..."
    "Une fois l'addition payée et après avoir dit au revoir à [saa], de retour dans la voiture..."

# game/scripts/c32/c32.rpy:347
translate french c32s001_AmaDate_0f007347:

    # ama "Are you having a good time? Is the date going as you expected?"
    ama "Tu passes un bon moment ? Le rencard se passe comme tu l'espérais ?"

# game/scripts/c32/c32.rpy:348
translate french c32s001_AmaDate_52af21d5:

    # mc "The dinner and the place were great. And the company was unbeatable."
    mc "Le dîner et l'endroit étaient super. Et la compagnie était inégalable."
# game/scripts/c32/c32.rpy:349
translate french c32s001_AmaDate_bbe48600:

    # mc "But, again, that was supposed to be my line."
    mc "Mais, encore une fois, c'était censé être ma réplique."

# game/scripts/c32/c32.rpy:350
translate french c32s001_AmaDate_bf1c000c:

    # mc "How's your first date?"
    mc "Comment se passe ton premier rencard ?"

# game/scripts/c32/c32.rpy:352
translate french c32s001_AmaDate_9eed93bf:

    # ama "Wanting it to never end. And wanting it to be over."
    ama "J'ai envie que ça ne se termine jamais. Et j'ai envie que ce soit fini."

# game/scripts/c32/c32.rpy:353
translate french c32s001_AmaDate_3af1be9b:

    # mc "You know we don't have to go snorkeling if you don't want to, right?"
    mc "Tu sais qu'on n'est pas obligés de faire du snorkeling si tu n'en as pas envie, pas vrai ?"

# game/scripts/c32/c32.rpy:354
translate french c32s001_AmaDate_feba2e80:

    # mc "If you want it to end, there will be other days we can do it."
    mc "Si tu veux que ça se termine, il y aura d'autres jours pour le faire."

# game/scripts/c32/c32.rpy:356
translate french c32s001_AmaDate_4e4dc524:

    # ama "But then it wouldn't be a memorable first date."
    ama "Mais alors ce ne serait pas un premier rencard mémorable."

# game/scripts/c32/c32.rpy:357
translate french c32s001_AmaDate_c9346d2d:

    # mc "*Laugh* You're wrong this time. It's already memorable."
    mc "*Rire* Tu as tort cette fois. C'est déjà mémorable."

# game/scripts/c32/c32.rpy:359
translate french c32s001_AmaDate_b3e22bf7:

    # ama "In 20 years, if we have kids and they ask how our first date was..."
    ama "Dans 20 ans, si on a des enfants et qu'ils nous demandent comment s'est passé notre premier rencard..."

# game/scripts/c32/c32.rpy:360
translate french c32s001_AmaDate_ffb3119e:

    # ama "Do you want to tell them 'we went to dinner and that was it'?"
    ama "Tu veux leur dire 'on est allés dîner et c'est tout' ?"

# game/scripts/c32/c32.rpy:361
translate french c32s001_AmaDate_25b5c5de:

    # mc "*Laugh* I don't care what those little rascals think about our first date."
    mc "*Rire* Je m'en fous de ce que ces petites canailles pensent de notre premier rencard."

# game/scripts/c32/c32.rpy:362
translate french c32s001_AmaDate_90bf980e:

    # mc "Besides, it wasn't just a dinner."
    mc "En plus, ce n'était pas juste un dîner."
# game/scripts/c32/c32.rpy:364
translate french c32s001_AmaDate_ef922001:

    # ama "*Laugh* Yeah, yeah. *Imitating [mc]* 'I spent two hours watching the setting sun reflecting in your mother's eyes.'"
    ama "*Rires* Ouais, ouais. *Imitant [mc]* 'J'ai passé deux heures à regarder le soleil couchant se refléter dans les yeux de ta mère.'"

# game/scripts/c32/c32.rpy:365
translate french c32s001_AmaDate_825d0bce:

    # ama "'The sea paled with envy before such beauty. The universe stopped time so the sunset would last longer just for us.'"
    ama "'La mer a pâli d'envie devant une telle beauté. L'univers a arrêté le temps pour que le coucher de soleil dure plus longtemps rien que pour nous.'"

# game/scripts/c32/c32.rpy:366
translate french c32s001_AmaDate_77e751de:

    # mc "*Laugh* Do I really sound that cheesy?"
    mc "*Rires* J'ai vraiment l'air aussi fleur bleue ?"

# game/scripts/c32/c32.rpy:368
translate french c32s001_AmaDate_8502cadb:

    # ama "That was a watered-down imitation of your cheesiness. But I don't like it any less for it."
    ama "C'était une imitation édulcorée de ton côté fleur bleue. Mais je ne l'en apprécie pas moins pour autant."

# game/scripts/c32/c32.rpy:369
translate french c32s001_AmaDate_014601af:

    # mc "*Imitating a tough guy* Hey, you, driver. Are we there yet? You drive like a grandma!"
    mc "*Imitant un dur à cuire* Hé, toi, le chauffeur. On est bientôt arrivés ? Tu conduis comme une grand-mère !"

# game/scripts/c32/c32.rpy:371
translate french c32s001_AmaDate_b936ee4d:

    # ama "*Laugh* You can't even get it right when you try, [mc]. It's not in your character to talk like that."
    ama "*Rires* Tu n'y arrives même pas quand tu essaies, [mc]. Ce n'est pas dans ta nature de parler comme ça."

# game/scripts/c32/c32.rpy:372
translate french c32s001_AmaDate_603a1586:

    # ama "And nobody wants you to, or even wants you to try to change. You're a tough guy in many other ways."
    ama "Et personne ne te le demande, ni même ne veut que tu essaies de changer. Tu es un dur à cuire de bien d'autres manières."

# game/scripts/c32/c32.rpy:373
translate french c32s001_AmaDate_5bcf09f4:

    # mc "*Laugh* I think that's the first time anyone's called me a tough guy."
    mc "*Rires* Je crois que c'est la première fois qu'on me traite de dur à cuire."

# game/scripts/c32/c32.rpy:375
translate french c32s001_AmaDate_e0f88d70:

    # ama "Few people have seen how you dealt with [kev] or [sol]."
    ama "Peu de gens ont vu comment tu as géré [kev] ou [sol]."

# game/scripts/c32/c32.rpy:376
translate french c32s001_AmaDate_d9ff6e54:

    # ama "Someone isn't tough because of how they talk, but because of how they act when it really matters."
    ama "On n'est pas un dur à cuire par sa façon de parler, mais par sa façon d'agir quand ça compte vraiment."

# game/scripts/c32/c32.rpy:377
translate french c32s001_AmaDate_c53c0510:

    # mc "Well, with [sol], [eva] and you had to save my ass. And if you hadn't shown up at [sca]'s house..."
    mc "Eh bien, avec [sol], [eva] et toi avez dû me sauver le cul. Et si tu n'avais pas débarqué chez [sca]..."
# game/scripts/c32/c32.rpy:379
translate french c32s001_AmaDate_e8c9cbd6:

    # ama "That's not important. What matters is that [kia] was part of the family and you defended her."
    ama "Ce n'est pas important. Ce qui compte, c'est que [kia] faisait partie de la famille et que tu l'as défendue."

# game/scripts/c32/c32.rpy:380
translate french c32s001_AmaDate_5cd8c9d0:

    # ama "That you defended [sca] in her house, confronting [kev]. I just stopped him from pressing charges against you."
    ama "Que tu as défendu [sca] chez elle, en affrontant [kev]. Je l'ai juste empêché de porter plainte contre toi."

# game/scripts/c32/c32.rpy:381
translate french c32s001_AmaDate_72dd2ab2:

    # ama "That you faced armed mercenaries when [erc] held you hostage at [nor]'s house."
    ama "Que tu as fait face à des mercenaires armés quand [erc] t'a pris en otage chez [nor]."

# game/scripts/c32/c32.rpy:383
translate french c32s001_AmaDate_ab03d45d:

    # ama "That you stopped [ich] in his tracks when it was necessary to defend [kim]."
    ama "Que tu as arrêté [ich] net quand il a fallu défendre [kim]."

# game/scripts/c32/c32.rpy:384
translate french c32s001_AmaDate_1b59a524:

    # ama "A lot of those tough guys you were trying to imitate would have folded under those circumstances."
    ama "Beaucoup de ces durs à cuire que tu essayais d'imiter se seraient dégonflés dans ces circonstances."

# game/scripts/c32/c32.rpy:386
translate french c32s001_AmaDate_1c3a390f:

    # ama "And, by the way, we've arrived. Don't ever say I drive like a grandma again."
    ama "Et au fait, on est arrivés. Ne dis plus jamais que je conduis comme une grand-mère."

# game/scripts/c32/c32.rpy:387
translate french c32s001_AmaDate_d2645100:

    # mc "*Laugh* As long as I don't say you cook like a grandma, you can't complain."
    mc "*Rires* Tant que je ne dis pas que tu cuisines comme une grand-mère, tu ne peux pas te plaindre."

# game/scripts/c32/c32.rpy:389
translate french c32s001_AmaDate_94fb603e:

    # "You pay for the excursion and board a beautiful sailboat where you put on some wetsuits."
    "Vous payez l'excursion et montez à bord d'un magnifique voilier où vous enfilez des combinaisons de plongée."

# game/scripts/c32/c32.rpy:390
translate french c32s001_AmaDate_ce1d816b:

    # "The guy on the boat tells you that you got lucky. You'll be alone during the excursion."
    "Le gars sur le bateau vous dit que vous avez de la chance. Vous serez seuls pendant l'excursion."

# game/scripts/c32/c32.rpy:391
translate french c32s001_AmaDate_be06eba6:

    # "On the previous excursion, there were eight Russian tourists. Some of them drunk. He says it wasn't a pleasant experience."
    "Lors de la précédente excursion, il y avait huit touristes russes. Certains étaient bourrés. Il dit que ce n'était pas une expérience agréable."

# game/scripts/c32/c32.rpy:393
translate french c32s001_AmaDate_eedc870d:

    # "After sailing for a while..."
    "Après avoir navigué un moment..."
# game/scripts/c32/c32.rpy:394
translate french c32s001_AmaDate_b69a5b0c:

    # usn "Well, we've arrived. All you have to do now, is to enjoy."
    usn "Eh bien, nous sommes arrivés. Tout ce qu'il vous reste à faire maintenant, c'est de profiter."

# game/scripts/c32/c32.rpy:395
translate french c32s001_AmaDate_a5d3b85c:

    # "He speaks with a Colombian accent so thick it makes [oma] sound like an Oxford native."
    "Il parle avec un accent colombien si prononcé qu'il fait passer [oma] pour une native d'Oxford."

# game/scripts/c32/c32.rpy:396
translate french c32s001_AmaDate_47df0b8f:

    # usn "I'll light up the coolest areas with that spotlight back there. You have 45 minutes to enjoy."
    usn "Je vais éclairer les zones les plus sympas avec ce projecteur là-derrière. Vous avez 45 minutes pour en profiter."

# game/scripts/c32/c32.rpy:398
translate french c32s001_AmaDate_fa5a7068:

    # ama "Are there any safety guidelines?"
    ama "Y a-t-il des consignes de sécurité ?"

# game/scripts/c32/c32.rpy:399
translate french c32s001_AmaDate_6ec9608d:

    # "Of course, [ama] looks better in her wetsuit than you do in yours."
    "Bien sûr, [ama] est bien plus belle dans sa combinaison que toi dans la tienne."

# game/scripts/c32/c32.rpy:401
translate french c32s001_AmaDate_2768801e:

    # usn "*Laugh* Don't forget to come up to the surface to breathe."
