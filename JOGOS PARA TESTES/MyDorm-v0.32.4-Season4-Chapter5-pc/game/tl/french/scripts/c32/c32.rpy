translate french c32s004_MarSamArrival_6e4ac718:

    # mom "Like I used to tell you on Christmas when you were a kid, open it and you'll see."
    mom "Comme je te le disais à Noël quand tu étais petit, ouvre-le et tu verras."

# game/scripts/c32/c32.rpy:3093
translate french c32s004_MarSamArrival_f057ccd6:

