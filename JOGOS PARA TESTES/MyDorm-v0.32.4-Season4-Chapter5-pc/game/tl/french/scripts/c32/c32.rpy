    mom "Aujourd'hui, je ne crois pas que ce soit parce que tu as reconnu les phalanges."

# game/scripts/c32/c32.rpy:3136
translate french c32s005_MarSamThreesome_3beec4e1:

    # mc "The knuckles were [sam.nick]'s."
