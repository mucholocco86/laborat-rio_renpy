# game/scripts/c32/c32.rpy:1145
translate french c32s002_trainingCamp_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c32/c32.rpy:1146
translate french c32s002_trainingCamp_3e597b1c:

    # mc "Come in, [ama]."
    mc "Entre, [ama]."

# game/scripts/c32/c32.rpy:1149
translate french c32s002_trainingCamp_6905e83d:

    # mc "Do you need to get out of here again?"
    mc "Tu as encore besoin de sortir d'ici ?"

# game/scripts/c32/c32.rpy:1150
translate french c32s002_trainingCamp_b98d12cd:

    # ama "No. YOU need to get out of here."
    ama "Non. C'est TOI qui dois sortir d'ici."

# game/scripts/c32/c32.rpy:1151
translate french c32s002_trainingCamp_2ee38508:

    # ama "I asked [car], and your schedule is clear for the whole morning."
    ama "J'ai demandé à [car], et ton emploi du temps est libre pour toute la matinée."
# game/scripts/c32/c32.rpy:1152
translate french c32s002_trainingCamp_c9c869d9:

    # mc "Where are we going?"
    mc "Où est-ce qu'on va ?"

# game/scripts/c32/c32.rpy:1154
translate french c32s002_trainingCamp_3089f2d7:

    # ama "You wanted to see the training camp, right?"
    ama "Tu voulais voir le camp d'entraînement, pas vrai ?"

# game/scripts/c32/c32.rpy:1155
translate french c32s002_trainingCamp_1042eedd:

    # ama "It's almost empty right now, so it's a good time."
    ama "Il est presque vide en ce moment, alors c'est le bon moment."

# game/scripts/c32/c32.rpy:1156
translate french c32s002_trainingCamp_35c82184:

    # mc "Almost empty? We don't have that many missions going on."
    mc "Presque vide ? On n'a pas tant de missions que ça en cours."

# game/scripts/c32/c32.rpy:1158
translate french c32s002_trainingCamp_5cef495a:

    # ama "*Laugh* I might have told [aar] to send the boys on maneuvers until the afternoon."
    ama "*Rire* J'ai peut-être dit à [aar] d'envoyer les gars en manœuvre jusqu'à l'après-midi."

# game/scripts/c32/c32.rpy:1159
translate french c32s002_trainingCamp_102ad838:

    # mc "*Laugh* You don't want me hanging out with tough guys?"
    mc "*Rire* Tu ne veux pas que je traîne avec des durs à cuire ?"

# game/scripts/c32/c32.rpy:1161
translate french c32s002_trainingCamp_7f2f6e54:

    # ama "I don't want you hanging out with tough KIDS. They aren't ready to meet you yet."
    ama "Je ne veux pas que tu traînes avec des GAMINS qui jouent les durs. Ils ne sont pas encore prêts à te rencontrer."

# game/scripts/c32/c32.rpy:1162
translate french c32s002_trainingCamp_78a2e242:

    # mc "We're still training the kids?"
    mc "On entraîne encore les gamins ?"

# game/scripts/c32/c32.rpy:1163
translate french c32s002_trainingCamp_0452cf97:

    # ama "Yes. You haven't decided what to do with them yet, and [aar] doesn't want them sitting idle and wasting time."
    ama "Oui. Tu n'as pas encore décidé quoi faire d'eux, et [aar] ne veut pas qu'ils restent à rien faire et perdent leur temps."

# game/scripts/c32/c32.rpy:1164
translate french c32s002_trainingCamp_0a135cd4:

    # mc "Deciding what to do with them just became one of my top priorities. I thought..."
    mc "Décider quoi faire d'eux vient de devenir l'une de mes priorités absolues. Je pensais..."

# game/scripts/c32/c32.rpy:1166
translate french c32s002_trainingCamp_3781b298:

    # ama "Did you think [aar] was going to make that decision for you? He can't."
    ama "Tu pensais qu'[aar] allait prendre cette décision à ta place ? Il ne peut pas."
# game/scripts/c32/c32.rpy:1167
translate french c32s002_trainingCamp_5beb8d55:

    # ama "It's an order that has to come from this office. Only you can make it."
    ama "C'est un ordre qui doit venir de ce bureau. Il n'y a que toi qui puisses le donner."

# game/scripts/c32/c32.rpy:1168
translate french c32s002_trainingCamp_29c99abf:

    # mc "Should we meet tomorrow and talk about it? We also need to discuss the rest of the requests the operatives made."
    mc "On devrait se voir demain pour en parler ? On doit aussi discuter du reste des demandes faites par les agents."

# game/scripts/c32/c32.rpy:1169
translate french c32s002_trainingCamp_5394274e:

    # mc "But I want the younger kids away from weapons as soon as possible."
    mc "Mais je veux que les plus jeunes soient tenus à l'écart des armes le plus vite possible."

# game/scripts/c32/c32.rpy:1171
translate french c32s002_trainingCamp_e79f43ef:

    # ama "I think it's a good idea. But we need to find something to do with them."
    ama "Je pense que c'est une bonne idée. Mais on doit trouver quoi faire d'eux."

# game/scripts/c32/c32.rpy:1172
translate french c32s002_trainingCamp_91ec79dd:

    # ama "You'll have a problem with anyone who wants to be a field operative. What are you going to do if one of them wants to keep training with weapons?"
    ama "Tu vas avoir un problème avec ceux qui veulent être agents de terrain. Qu'est-ce que tu vas faire si l'un d'eux veut continuer à s'entraîner avec des armes ?"

# game/scripts/c32/c32.rpy:1173
translate french c32s002_trainingCamp_52ee661c:

    # mc "I think that's a bridge we'll cross when we get to it."
    mc "Je pense qu'on gérera ça le moment venu."

# game/scripts/c32/c32.rpy:1174
translate french c32s002_trainingCamp_b57a80cf:

    # mc "But I think I'm going to have to act like they're normal kids. There's an age for school and an age for making decisions."
    mc "Mais je crois que je vais devoir agir comme si c'étaient des gamins normaux. Il y a un âge pour l'école et un âge pour prendre des décisions."

# game/scripts/c32/c32.rpy:1176
translate french c32s002_trainingCamp_a45ddc36:

    # ama "*Laugh* Do you realize you just used the word 'normal' to leave our kids out of it?"
    ama "*Rire* Tu te rends compte que tu viens d'utiliser le mot 'normal' pour exclure nos enfants de ça ?"

# game/scripts/c32/c32.rpy:1177
translate french c32s002_trainingCamp_32990a61:

    # mc "I didn't realize it. And I don't think it's funny."
    mc "Je ne m'en étais pas rendu compte. Et je ne trouve pas ça drôle."

# game/scripts/c32/c32.rpy:1178
translate french c32s002_trainingCamp_ba32d449:

    # ama "What I think is funny is that a few days ago you wanted to tell [alb] off for the exact same thing."
    ama "Ce que je trouve drôle, c'est qu'il y a quelques jours, tu voulais engueuler [alb] pour exactement la même chose."

# game/scripts/c32/c32.rpy:1179
translate french c32s002_trainingCamp_54283b73:

    # mc "You're right. Sometimes language plays tricks on us because we're used to using it in a specific way."
    mc "Tu as raison. Parfois, le langage nous joue des tours parce qu'on a l'habitude de l'utiliser d'une certaine manière."
# game/scripts/c32/c32.rpy:1180
translate french c32s002_trainingCamp_c58e2da7:

    # mc "But you'll never hear me use 'humans' to leave clones out of that word. Or at least I hope not."
    mc "Mais tu ne m'entendras jamais utiliser 'humains' pour exclure les clones de ce mot. Ou du moins, je l'espère."

# game/scripts/c32/c32.rpy:1182
translate french c32s002_trainingCamp_f9c39b1b:

    # ama "I hope so too. Now get dressed. Jeans aren't a good outfit for the training camp."
    ama "Je l'espère aussi. Maintenant, habille-toi. Un jean n'est pas une bonne tenue pour le camp d'entraînement."

# game/scripts/c32/c32.rpy:1183
translate french c32s002_trainingCamp_006b4b86:

    # mc "Are you going to make me run around the walls?"
    mc "Tu vas me faire courir autour des murs ?"

# game/scripts/c32/c32.rpy:1185
translate french c32s002_trainingCamp_45da8c5a:

    # ama "You already know about the walls? Did [aar] take you there?"
    ama "Tu es déjà au courant pour les murs ? Est-ce que [aar] t'y a emmené ?"

# game/scripts/c32/c32.rpy:1186
translate french c32s002_trainingCamp_e8a68b02:

    # mc "No, but I've checked the blueprints. And I was impressed."
    mc "Non, mais j'ai regardé les plans. Et j'ai été impressionné."

# game/scripts/c32/c32.rpy:1187
translate french c32s002_trainingCamp_c8bbda3f:

    # mc "The walls seem extensive enough that it wouldn't be pleasant to run around them in this heat."
    mc "Les murs ont l'air assez étendus pour que ce ne soit pas une partie de plaisir de courir autour avec cette chaleur."

# game/scripts/c32/c32.rpy:1189
translate french c32s002_trainingCamp_9cf08c40:

    # ama "Then you'd better get dressed quickly. Or I'll have to make you run."
    ama "Alors tu ferais bien de t'habiller vite. Sinon, je vais devoir te faire courir."

# game/scripts/c32/c32.rpy:1190
translate french c32s002_trainingCamp_507f27d6:

    # mc "At your command, Ma'am!"
    mc "À vos ordres, M'dame !"

# game/scripts/c32/c32.rpy:1192
translate french c32s002_trainingCamp_83d048aa:

    # "This time, [ama] drives the same beat-up Humvee down a normal road."
    "Cette fois, [ama] conduit le même Humvee cabossé sur une route normale."

# game/scripts/c32/c32.rpy:1193
translate french c32s002_trainingCamp_7a72735a:

    # "You assume the transport trucks need asphalt to drive on."
    "Tu supposes que les camions de transport ont besoin d'asphalte pour rouler."

# game/scripts/c32/c32.rpy:1195
translate french c32s002_trainingCamp_9377038d:

    # "After a few minutes, you arrive at the main base. It's big, but not as big as you thought."
    "Après quelques minutes, tu arrives à la base principale. C'est grand, mais pas autant que tu le pensais."
# game/scripts/c32/c32.rpy:1196
translate french c32s002_trainingCamp_2a23c3a3:

    # "The blueprints seem to have fooled you. An airstrip wouldn't fit here."
    "Les plans semblent t'avoir trompé. Une piste d'atterrissage ne tiendrait pas ici."

# game/scripts/c32/c32.rpy:1197
translate french c32s002_trainingCamp_4758d1c4:

    # "The base is empty, except for a few guards in the watchtowers."
    "La base est vide, à l'exception de quelques gardes dans les miradors."

# game/scripts/c32/c32.rpy:1199
translate french c32s002_trainingCamp_92862130:

    # mc "I thought it would be bigger."
    mc "Je pensais que ce serait plus grand."

# game/scripts/c32/c32.rpy:1200
translate french c32s002_trainingCamp_0c46102b:

    # ama "The blueprints you checked are probably outdated."
    ama "Les plans que tu as consultés sont probablement obsolètes."

# game/scripts/c32/c32.rpy:1201
translate french c32s002_trainingCamp_f7b9a57f:

    # ama "This was built a couple of years ago to mimic an American outpost in Jordan."
    ama "Ça a été construit il y a quelques années pour imiter un avant-poste américain en Jordanie."

# game/scripts/c32/c32.rpy:1202
translate french c32s002_trainingCamp_dd973a24:

    # ama "Except for the desert, of course."
    ama "À l'exception du désert, bien sûr."

# game/scripts/c32/c32.rpy:1203
translate french c32s002_trainingCamp_a9f7e2b1:

    # mc "So, the airstrip and the hangars...?"
    mc "Donc, la piste d'atterrissage et les hangars... ?"

# game/scripts/c32/c32.rpy:1205
translate french c32s002_trainingCamp_0e384c41:

    # ama "They're beyond the north wall. A couple of transport planes, three training planes, and a couple more helicopters are there."
    ama "Ils sont au-delà du mur nord. Il y a quelques avions de transport, trois avions d'entraînement et quelques hélicoptères de plus là-bas."

# game/scripts/c32/c32.rpy:1206
translate french c32s002_trainingCamp_0b0708ad:

    # ama "We'll see them when I'm done showing you this."
    ama "On les verra quand j'aurai fini de te montrer ça."

# game/scripts/c32/c32.rpy:1207
translate french c32s002_trainingCamp_5bf71cb7:

    # ama "And no, we don't have fighter jets for the same reason we don't have tanks."
    ama "Et non, on n'a pas d'avions de chasse pour la même raison qu'on n'a pas de chars."

# game/scripts/c32/c32.rpy:1208
translate french c32s002_trainingCamp_082b3008:

    # ama "The closest thing you'll see is that black beauty over there."
    ama "Ce qui s'en rapproche le plus, c'est cette beauté noire là-bas."
# game/scripts/c32/c32.rpy:1209
translate french c32s002_trainingCamp_819af20e:

    # mc "Is that an attack helicopter?"
    mc "C'est un hélicoptère d'attaque ?"

# game/scripts/c32/c32.rpy:1211
translate french c32s002_trainingCamp_d4e01ea4:

    # ama "Now it's more of a ground support helicopter. It's an AH-60L."
    ama "Maintenant, c'est plus un hélicoptère de soutien au sol. C'est un AH-60L."

# game/scripts/c32/c32.rpy:1212
translate french c32s002_trainingCamp_8546ac1d:

    # ama "This one was... stolen by some D's in Riohacha. It has machine guns and rockets, but no Hellfire missiles. Again, we don't have them and we don't need them."
    ama "Celui-ci a été... volé par des D à Riohacha. Il a des mitrailleuses et des roquettes, mais pas de missiles Hellfire. Encore une fois, on n'en a pas et on n'en a pas besoin."

# game/scripts/c32/c32.rpy:1213
translate french c32s002_trainingCamp_5511b27c:

    # mc "*Surprised Gasp* We steal equipment from our customers?"
    mc "*Halètement de surprise* On vole l'équipement de nos clients ?"

# game/scripts/c32/c32.rpy:1215
translate french c32s002_trainingCamp_2d4448b2:

    # ama "Theft or payment in kind. Whatever you prefer to call it."
    ama "Vol ou paiement en nature. Appelle ça comme tu veux."

# game/scripts/c32/c32.rpy:1216
translate french c32s002_trainingCamp_25261f89:

    # ama "It's not official company policy, but if they refuse to pay... We don't risk our lives for nothing."
    ama "Ce n'est pas la politique officielle de l'entreprise, mais s'ils refusent de payer... On ne risque pas nos vies pour rien."

# game/scripts/c32/c32.rpy:1217
translate french c32s002_trainingCamp_bb0d884a:

    # "You realize that, despite everything, that sentence shows a loyalty to the company that's hard to understand in the world outside of NTR."
    "Tu réalises que, malgré tout, cette phrase montre une loyauté envers l'entreprise qui est difficile à comprendre dans le monde en dehors de NTR."

# game/scripts/c32/c32.rpy:1219
translate french c32s002_trainingCamp_fd08b1fe:

    # ama "There haven't been any more problems with payments from Colombia."
    ama "Il n'y a plus eu de problèmes avec les paiements en provenance de Colombie."

# game/scripts/c32/c32.rpy:1220
translate french c32s002_trainingCamp_8091043c:

    # ama "The loss of that helicopter hurt them more than the benefit it brings us."
    ama "La perte de cet hélicoptère leur a fait plus de mal que le bénéfice qu'il nous apporte."

# game/scripts/c32/c32.rpy:1221
translate french c32s002_trainingCamp_b3961c59:

    # mc "Why?"
    mc "Pourquoi ?"

# game/scripts/c32/c32.rpy:1223
translate french c32s002_trainingCamp_e9f6640a:

    # ama "We have limited deployment capabilities. We can't take it on a mission to Cambodia, for example."
    ama "On a des capacités de déploiement limitées. On ne peut pas l'emmener en mission au Cambodge, par exemple."
# game/scripts/c32/c32.rpy:1224
translate french c32s002_trainingCamp_5d434da7:

    # ama "Well, we could, but the American government wouldn't be very happy if we did. Too close to China, in case we lose it."
    ama "Eh bien, on pourrait, mais le gouvernement américain ne serait pas très content si on le faisait. Trop près de la Chine, au cas où on le perdrait."

# game/scripts/c32/c32.rpy:1225
translate french c32s002_trainingCamp_f9d06dcf:

    # ama "And we don't have the infrastructure to get the most out of it. Spare parts, weaponry, etc."
    ama "Et on n'a pas l'infrastructure pour en tirer le meilleur parti. Pièces de rechange, armement, etc."

# game/scripts/c32/c32.rpy:1226
translate french c32s002_trainingCamp_15a161b6:

    # ama "But it's useful for training, in case we need to fly one someday."
    ama "Mais c'est utile pour l'entraînement, au cas où on aurait besoin d'en piloter un un jour."

# game/scripts/c32/c32.rpy:1227
translate french c32s002_trainingCamp_5a02179d:

    # mc "Or if we need to steal another one."
    mc "Ou si on a besoin d'en voler un autre."

# game/scripts/c32/c32.rpy:1229
translate french c32s002_trainingCamp_63310262:

    # ama "*Laugh* Exactly. Next time, we'll try not to kill any soldiers in the process."
    ama "*Rires* Exactement. La prochaine fois, on essaiera de ne tuer aucun soldat au passage."

# game/scripts/c32/c32.rpy:1230
translate french c32s002_trainingCamp_1de43f72:

    # "The casualness of the phrase, said between laughs, makes your blood run cold."
    "La désinvolture de la phrase, prononcée entre deux rires, te glace le sang."

# game/scripts/c32/c32.rpy:1231
translate french c32s002_trainingCamp_6389fc17:

    # ama "*Laugh* But we make no promises. Pay up to make sure we don't need to."
    ama "*Rires* Mais on ne promet rien. Payez pour être sûrs qu'on n'ait pas à le faire."

# game/scripts/c32/c32.rpy:1232
translate french c32s002_trainingCamp_3f645419:

    # "You hadn't realized that, to steal a helicopter, the D's had to kill Colombian soldiers."
    "Tu n'avais pas réalisé que, pour voler un hélicoptère, les D avaient dû tuer des soldats colombiens."

# game/scripts/c32/c32.rpy:1235
translate french c32s002_trainingCamp_90d4ac56:

    # ama "Oh! Shit!"
    ama "Oh ! Merde !"

# game/scripts/c32/c32.rpy:1236
translate french c32s002_trainingCamp_e8bdf55d:

    # ama "Did I say that laughing?"
    ama "J'ai dit ça en riant ?"

# game/scripts/c32/c32.rpy:1237
translate french c32s002_trainingCamp_ebb33a63:

    # mc "I'm afraid so..."
    mc "J'en ai bien peur..."
# game/scripts/c32/c32.rpy:1239
translate french c32s002_trainingCamp_a495d38f:

    # ama "Right now I feel inhuman..."
    ama "En ce moment, je me sens inhumaine..."

# game/scripts/c32/c32.rpy:1241
translate french c32s002_trainingCamp_8ed395fb:

    # ama "Just like how those who don't consider clones to be people see us..."
    ama "Exactement comme nous voient ceux qui ne considèrent pas les clones comme des personnes..."

# game/scripts/c32/c32.rpy:1242
translate french c32s002_trainingCamp_57f14506:

    # ama "Those soldiers must have had mothers and families who will miss them..."
    ama "Ces soldats devaient avoir des mères et des familles à qui ils vont manquer..."

# game/scripts/c32/c32.rpy:1243
translate french c32s002_trainingCamp_65f9676b:

    # mc "Yes..."
    mc "Oui..."

# game/scripts/c32/c32.rpy:1246
translate french c32s002_trainingCamp_ca5334ee:

    # ama "We all celebrated when Dax and [dec] brought that helicopter back."
    ama "On a tous fêté ça quand Dax et [dec] ont ramené cet hélicoptère."

# game/scripts/c32/c32.rpy:1247
translate french c32s002_trainingCamp_fd4f4e50:

    # ama "Colombia had tried to rob us and we had robbed them."
    ama "La Colombie avait essayé de nous voler et on les a volés."

# game/scripts/c32/c32.rpy:1248
translate french c32s002_trainingCamp_e73abae1:

    # ama "No one thought about the 14 soldiers they killed between the two of them to take the bird. No one cared."
    ama "Personne n'a pensé aux 14 soldats qu'ils ont tués à eux deux pour prendre l'hélico. Tout le monde s'en foutait."

# game/scripts/c32/c32.rpy:1249
translate french c32s002_trainingCamp_6700eb92:

    # mc "You didn't know what a family was beyond these walls. It was you against the rest of the world."
    mc "Tu ne savais pas ce qu'était une famille au-delà de ces murs. C'était vous contre le reste du monde."

# game/scripts/c32/c32.rpy:1250
translate french c32s002_trainingCamp_e7668583:

    # mc "Now you know. And you understand what loss is, or what [mar], [nor], or [emm] would feel if you didn't come home from a mission."
    mc "Maintenant tu sais. Et tu comprends ce qu'est la perte, ou ce que [mar], [nor], ou [emm] ressentiraient si tu ne rentrais pas d'une mission."

# game/scripts/c32/c32.rpy:1252
translate french c32s002_trainingCamp_7456d26c:

    # ama "[mar] is the first one I thought of."
    ama "[mar] est la première à qui j'ai pensé."

# game/scripts/c32/c32.rpy:1253
translate french c32s002_trainingCamp_15784a87:

    # ama "And I feel ashamed of what she would think if she heard me say that while I was laughing..."
    ama "Et j'ai honte de ce qu'elle penserait si elle m'entendait dire ça en riant..."

# game/scripts/c32/c32.rpy:1254
translate french c32s002_trainingCamp_12748f12:

    # mc "You're changing, [ama]. And that's good. But it's a process. Don't expect to be a different person overnight."
    mc "Tu changes, [ama]. Et c'est une bonne chose. Mais c'est un processus. Ne t'attends pas à devenir une personne différente du jour au lendemain."

# game/scripts/c32/c32.rpy:1256
translate french c32s002_trainingCamp_8af89b15:

    # ama "It's... so hard."
    ama "C'est... tellement dur."

# game/scripts/c32/c32.rpy:1257
translate french c32s002_trainingCamp_26fbc775:

    # mc "It's not hard, [ama]. It's something that requires learning."
    mc "Ce n'est pas dur, [ama]. C'est quelque chose qui s'apprend."

# game/scripts/c32/c32.rpy:1258
translate french c32s002_trainingCamp_3c091858:

    # mc "While you were learning to shoot bazookas and speak 30 languages, we were learning to live as a family, to feel empathy."
    mc "Pendant que tu apprenais à tirer au bazooka et à parler 30 langues, nous apprenions à vivre en famille, à ressentir de l'empathie."

# game/scripts/c32/c32.rpy:1259
translate french c32s002_trainingCamp_7cecae76:

    # mc "In less than a month you've taken a crash course on family and empathy, but..."
    mc "En moins d'un mois, tu as suivi un cours accéléré sur la famille et l'empathie, mais..."

# game/scripts/c32/c32.rpy:1261
translate french c32s002_trainingCamp_a66b9a63:

    # ama "But I still speak the language of empathy with a weird accent, right?"
    ama "Mais je parle toujours la langue de l'empathie avec un accent bizarre, c'est ça ?"

# game/scripts/c32/c32.rpy:1262
translate french c32s002_trainingCamp_e62dd4bb:

    # mc "I like the analogy. Yes, that's exactly it. And every now and then a word in your native language slips out."
    mc "J'aime bien l'analogie. Oui, c'est exactement ça. Et de temps en temps, un mot de ta langue maternelle t'échappe."

# game/scripts/c32/c32.rpy:1263
translate french c32s002_trainingCamp_3bc0cfcd:

    # mc "But that gets fixed with practice."
    mc "Mais ça s'arrange avec la pratique."

# game/scripts/c32/c32.rpy:1265
translate french c32s002_trainingCamp_e0260a26:

    # "At that moment, you hear the gates of the replica outpost open."
    "À ce moment-là, tu entends les portes de la réplique de l'avant-poste s'ouvrir."

# game/scripts/c32/c32.rpy:1266
translate french c32s002_trainingCamp_ccd8fce5:

    # "A troop transport truck makes its appearance."
    "Un camion de transport de troupes fait son apparition."

# game/scripts/c32/c32.rpy:1268
translate french c32s002_trainingCamp_09eeff9d:

    # mc "I thought we were going to be alone..."
    mc "Je croyais qu'on allait être seuls..."
# game/scripts/c32/c32.rpy:1269
translate french c32s002_trainingCamp_1d7c36fe:

    # ama "Me too. No one was supposed to be back for another two hours, at least."
    ama "Moi aussi. Personne n'était censé revenir avant au moins deux heures."

# game/scripts/c32/c32.rpy:1271
translate french c32s002_trainingCamp_a903f090:

    # mc "Hey, [dam]... Wait, you're not [dam]."
    mc "Hé, [dam]... Attends, tu n'es pas [dam]."

# game/scripts/c32/c32.rpy:1276
translate french c32s002_trainingCamp_c35ea246:

    # dec "Hello, Sir. I'm [dec]. How did you know?"
    dec "Bonjour, Monsieur. Je suis [dec]. Comment l'avez-vous su ?"

# game/scripts/c32/c32.rpy:1278
translate french c32s002_trainingCamp_522a4dbc:

    # dam "Because I'm unmistakable, [dec]. I don't think I'll ever get tired of saying it."
    dam "Parce que je suis inimitable, [dec]. Je crois que je ne me lasserai jamais de le dire."

# game/scripts/c32/c32.rpy:1280
translate french c32s002_trainingCamp_eeaa3e2f:

    # dam "Hey, [ama] and [mc]."
    dam "Salut, [ama] et [mc]."

# game/scripts/c32/c32.rpy:1281
translate french c32s002_trainingCamp_b8710cc5:

    # mc "Hey, [dam]. I thought you guys would be on maneuvers all day."
    mc "Salut, [dam]. Je croyais que vous seriez en manœuvres toute la journée."

# game/scripts/c32/c32.rpy:1282
translate french c32s002_trainingCamp_4555acbd:

    # dam "One of the guys got hurt."
    dam "Un des gars s'est blessé."

# game/scripts/c32/c32.rpy:1284
translate french c32s002_trainingCamp_e5b8eb24:

    # dam "Take Henry to the infirmary while I talk to the... boss."
    dam "Emmenez Henry à l'infirmerie pendant que je parle au... patron."

# game/scripts/c32/c32.rpy:1285
translate french c32s002_trainingCamp_a6c4ce43:

    # "The 'guys' who got off the truck could be your age. They've been staring at your interaction with [dam] and [dec]."
    "Les 'gars' qui sont descendus du camion pourraient avoir ton âge. Ils n'ont pas arrêté de regarder ton interaction avec [dam] et [dec]."

# game/scripts/c32/c32.rpy:1286
translate french c32s002_trainingCamp_b1d39e06:

    # dec "Don't worry, Dam. I'll go with them."
    dec "T'inquiète pas, Dam. Je vais avec eux."

# game/scripts/c32/c32.rpy:1287
translate french c32s002_trainingCamp_c578bcfc:

    # dec "Guys, stop gawking at the boss and follow me."
    dec "Les gars, arrêtez de reluquer le patron et suivez-moi."
# game/scripts/c32/c32.rpy:1290
translate french c32s002_trainingCamp_52fc87e2:

    # mc "Is the kid okay?"
    mc "Le gamin va bien ?"

# game/scripts/c32/c32.rpy:1291
translate french c32s002_trainingCamp_abbbed43:

    # dam "Yeah, a sprained ankle. The H's are small but tough. He'll be walking in a couple of hours."
    dam "Ouais, une entorse à la cheville. Les H sont petits mais costauds. Il marchera d'ici quelques heures."

# game/scripts/c32/c32.rpy:1292
translate french c32s002_trainingCamp_70936128:

    # dam "We've notified the base and Doc said he'll be here in five or six minutes."
    dam "On a prévenu la base et Doc a dit qu'il serait là dans cinq ou six minutes."

# game/scripts/c32/c32.rpy:1293
translate french c32s002_trainingCamp_7f952e9c:

    # "Some of the H's and a G, you think it's [gid], have taken shelter in the shade of a tent. Watching you."
    "Certains des H et un G, tu penses que c'est [gid], se sont abrités à l'ombre d'une tente. Ils t'observent."

# game/scripts/c32/c32.rpy:1295
translate french c32s002_trainingCamp_74226d1c:

    # "Neither [dam] nor [ama] bother to introduce you to them. They whisper with little subtlety."
    "Ni [dam] ni [ama] ne prennent la peine de te présenter à eux. Ils chuchotent avec peu de subtilité."

# game/scripts/c32/c32.rpy:1296
translate french c32s002_trainingCamp_13e3bbec:

    # cl1 "*Whispering* How dare he dress like one of us? Is he going to train?"
    cl1 "*Chuchotant* Comment ose-t-il s'habiller comme l'un de nous ? Il va s'entraîner ?"

# game/scripts/c32/c32.rpy:1297
translate french c32s002_trainingCamp_fd7edea0:

    # cl2 "*Whispering* [gav] and [fred] say he's different, but until I see it..."
    cl2 "*Chuchotant* [gav] et [fred] disent qu'il est différent, mais tant que je ne l'aurai pas vu..."

# game/scripts/c32/c32.rpy:1299
translate french c32s002_trainingCamp_7966bd9f:

    # mc "Isn't there a doctor at the outpost?"
    mc "Il n'y a pas de médecin à l'avant-poste ?"

# game/scripts/c32/c32.rpy:1300
translate french c32s002_trainingCamp_eee74502:

    # dam "[carl] acts as a nurse. The C's are good with technical stuff and he can't fight anymore."
    dam "[carl] fait office d'infirmier. Les C sont doués pour les trucs techniques et il ne peut plus se battre."

# game/scripts/c32/c32.rpy:1301
translate french c32s002_trainingCamp_be52efb0:

    # mc "You only have one nurse?"
    mc "Vous n'avez qu'un seul infirmier ?"

# game/scripts/c32/c32.rpy:1302
translate french c32s002_trainingCamp_a1f246ea:

    # gid "*Whispering* I saw him in the waiting room while [gav] was in surgery..."
    gid "*Chuchotant* Je l'ai vu dans la salle d'attente pendant que [gav] se faisait opérer..."
# game/scripts/c32/c32.rpy:1303
translate french c32s002_trainingCamp_55b3d01b:

    # cl1 "*Whispering* I bet the only thing he cared about was if the surgery went well and he could sell the arm."
    cl1 "*Chuchotant* Je parie que la seule chose qui l'intéressait, c'était de savoir si l'opération s'était bien passée et s'il pouvait vendre le bras."

# game/scripts/c32/c32.rpy:1304
translate french c32s002_trainingCamp_1226a41c:

    # cl2 "*Whispering* I was told he stayed until the very last moment. Even after the surgery was already over."
    cl2 "*Chuchotant* On m'a dit qu'il est resté jusqu'au tout dernier moment. Même après que l'opération soit terminée."

# game/scripts/c32/c32.rpy:1305
translate french c32s002_trainingCamp_a8c05bbf:

    # cl3 "*Whispering* I saw him too. And it wasn't the worried face of someone thinking about how much money they can make."
    cl3 "*Chuchotant* Je l'ai vu aussi. Et ce n'était pas le visage inquiet de quelqu'un qui pense à l'argent qu'il peut se faire."

# game/scripts/c32/c32.rpy:1307
translate french c32s002_trainingCamp_82a8419d:

    # ama "It's not a combat zone, it's a training ground. [carl] probably doesn't see more than one guy a day."
    ama "Ce n'est pas une zone de combat, c'est un terrain d'entraînement. [carl] ne voit probablement pas plus d'un gars par jour."

# game/scripts/c32/c32.rpy:1308
translate french c32s002_trainingCamp_1ac44143:

    # ama "And Doc probably doesn't have to come more than once a month."
    ama "Et Doc n'a probablement pas besoin de venir plus d'une fois par mois."

# game/scripts/c32/c32.rpy:1309
translate french c32s002_trainingCamp_386896de:

    # cl1 "*Whispering* I bet he just wants to save on the gas Doc uses when he comes."
    cl1 "*Chuchotant* Je parie qu'il veut juste économiser sur l'essence que Doc utilise quand il vient."

# game/scripts/c32/c32.rpy:1310
translate french c32s002_trainingCamp_1a2de688:

    # cl3 "*Whispering* Didn't you hear? The first thing he did was to ask about Henry."
    cl3 "*Chuchotant* T'as pas entendu ? La première chose qu'il a faite, c'est de demander des nouvelles d'Henry."

# game/scripts/c32/c32.rpy:1311
translate french c32s002_trainingCamp_46228ead:

    # cl2 "*Whispering* He looked worried..."
    cl2 "*Chuchotant* Il avait l'air inquiet..."

# game/scripts/c32/c32.rpy:1313
translate french c32s002_trainingCamp_e2c47665:

    # dam "Guys, you wanna see how the boss handles himself at the old shooting range?"
    dam "Les gars, vous voulez voir comment le boss se débrouille à l'ancien stand de tir ?"

# game/scripts/c32/c32.rpy:1314
translate french c32s002_trainingCamp_66b631dd:

    # mc "*Whispering* What are you doing?"
    mc "*Chuchotant* Qu'est-ce que tu fous ?"

# game/scripts/c32/c32.rpy:1315
translate french c32s002_trainingCamp_d80ccc61:

    # cl2 "Yeah!"
    cl2 "Ouais !"
# game/scripts/c32/c32.rpy:1316
translate french c32s002_trainingCamp_74435f2a:

    # cl1 "If he dresses like that, he should earn the right to do so."
    cl1 "S'il s'habille comme ça, il devrait mériter le droit de le faire."

# game/scripts/c32/c32.rpy:1317
translate french c32s002_trainingCamp_381504a5:

    # cl3 "It's not necessary, but I'd like to see what he's made of."
    cl3 "C'est pas nécessaire, mais j'aimerais bien voir ce qu'il a dans le ventre."

# game/scripts/c32/c32.rpy:1318
translate french c32s002_trainingCamp_13416aa7:

    # dam "I think I'm going to kick his and [ama]'s asses."
    dam "Je crois que je vais lui botter le cul, à lui et à [ama]."

# game/scripts/c32/c32.rpy:1320
translate french c32s002_trainingCamp_f960e63f:

    # ama "*Whispering* [dam], what are you doing? He's not ready."
    ama "*Chuchote* [dam], qu'est-ce que tu fous ? Il n'est pas prêt."

# game/scripts/c32/c32.rpy:1322
translate french c32s002_trainingCamp_73e30a03:

    # ama "You don't have to do this, [mc]. I think [dam] wants to make a fool out of you."
    ama "T'es pas obligé de faire ça, [mc]. Je crois que [dam] veut te ridiculiser."

# game/scripts/c32/c32.rpy:1323
translate french c32s002_trainingCamp_df6d2739:

    # ama "And out of me too, while he's at it."
    ama "Et moi avec, tant qu'il y est."

# game/scripts/c32/c32.rpy:1324
translate french c32s002_trainingCamp_40de2197:

    # mc "I'm going to do it, [ama]. I'm not going to pretend to be someone I'm not."
    mc "Je vais le faire, [ama]. Je vais pas faire semblant d'être quelqu'un que je ne suis pas."

# game/scripts/c32/c32.rpy:1326
translate french c32s002_trainingCamp_475c75cb:

    # dam "Let's go to the old shooting range. Ladies, get in the truck."
    dam "Allons au vieux stand de tir. Les filles, montez dans le pick-up."

# game/scripts/c32/c32.rpy:1328
translate french c32s002_trainingCamp_9de2bbd1:

    # "[dam] drives for a few minutes until reaching the shooting range."
    "[dam] conduit pendant quelques minutes jusqu'à atteindre le stand de tir."

# game/scripts/c32/c32.rpy:1329
translate french c32s002_trainingCamp_0c63ec9d:

    # "The ride in the back of the truck is uncomfortable. Aside from the three H's, there's only [gid], the G you met in the waiting room."
    "Le trajet à l'arrière du pick-up est inconfortable. À part les trois H, il n'y a que [gid], le G que tu as rencontré dans la salle d'attente."

# game/scripts/c32/c32.rpy:1330
translate french c32s002_trainingCamp_79ad38b7:

    # "No one says a word to [ama] or you. [ama] is lost in a strange silence."
    "Personne ne dit un mot à [ama] ou à toi. [ama] est perdue dans un étrange silence."
# game/scripts/c32/c32.rpy:1331
translate french c32s002_trainingCamp_8a3bb6db:

    # "She's probably wondering what vehicle she's going to use to run over [dam]. And regretting not having a tank."
    "Elle se demande probablement quel véhicule elle va utiliser pour rouler sur [dam]. Et regrette de ne pas avoir de tank."

# game/scripts/c32/c32.rpy:1333
translate french c32s002_trainingCamp_2f31eedc:

    # "Upon arriving at the shooting range, the clones stay behind you, except for [dam]..."
    "En arrivant au stand de tir, les clones restent derrière vous, à l'exception de [dam]..."

# game/scripts/c32/c32.rpy:1334
translate french c32s002_trainingCamp_a108674e:

    # dam "Let's make it easy. 10 shots, standing, at 25 meters and we add up the scores."
    dam "Faisons simple. 10 tirs, debout, à 25 mètres et on additionne les scores."

# game/scripts/c32/c32.rpy:1335
translate french c32s002_trainingCamp_278f4e71:

    # ama "*Whispering* He's never shot at 25 meters, [dam]."
    ama "*Chuchotant* Il n'a jamais tiré à 25 mètres, [dam]."

# game/scripts/c32/c32.rpy:1337
translate french c32s002_trainingCamp_69799174:

    # dam "If he wants to dress like us, he has to prove he's one of us. Right, boys?"
    dam "S'il veut s'habiller comme nous, il doit prouver qu'il est l'un des nôtres. Pas vrai, les gars ?"

# game/scripts/c32/c32.rpy:1339
translate french c32s002_trainingCamp_a23a6e36:

    # cl4 "*Shouting* Yeah!"
    cl4 "*Criant* Ouais !"

# game/scripts/c32/c32.rpy:1341
translate french c32s002_trainingCamp_16a67e4d:

    # dam "Him being old [aar]'s original isn't going to exempt him from having to show us how good he is."
    dam "Le fait qu'il soit l'original du vieux [aar] ne va pas le dispenser de nous montrer ce qu'il vaut."

# game/scripts/c32/c32.rpy:1342
translate french c32s002_trainingCamp_7446952a:

    # dam "Hank, get my gun from the truck and some magazines."
    dam "Hank, va chercher mon flingue dans le camion et quelques chargeurs."

# game/scripts/c32/c32.rpy:1344
translate french c32s002_trainingCamp_0bf6647d:

    # cl2 "What?"
    cl2 "Quoi ?"

# game/scripts/c32/c32.rpy:1345
translate french c32s002_trainingCamp_794b0a75:

    # cl1 "Did you know?"
    cl1 "Tu le savais ?"

# game/scripts/c32/c32.rpy:1346
translate french c32s002_trainingCamp_04bfcb4f:

    # gid "I saw them together on Sunday... [dam] is right."
    gid "Je les ai vus ensemble dimanche... [dam] a raison."
# game/scripts/c32/c32.rpy:1347
translate french c32s002_trainingCamp_93cac421:

    # cl3 "I told you he was different..."
    cl3 "Je t'avais dit qu'il était différent..."

# game/scripts/c32/c32.rpy:1349
translate french c32s002_trainingCamp_ee477e51:

    # dam "Ladies first."
    dam "Honneur aux dames."

# game/scripts/c32/c32.rpy:1350
translate french c32s002_trainingCamp_3047d0c2:

    # ama "*Whispering* I still don't get what you're trying to pull, asshole."
    ama "*Chuchotant* Je pige toujours pas à quoi tu joues, connard."

# game/scripts/c32/c32.rpy:1351
translate french c32s002_trainingCamp_dfc207a7:

    # dam "Move that ass to the shooting position and show us you haven't gotten rusty with your comfy life in Newport."
    dam "Bouge ce cul jusqu'au pas de tir et montre-nous que t'as pas rouillé avec ta petite vie douillette à Newport."

# game/scripts/c32/c32.rpy:1352
translate french c32s002_trainingCamp_a9b9aa4d:

    # dam "Here's my gun."
    dam "Voilà mon flingue."

# game/scripts/c32/c32.rpy:1354
translate french c32s002_trainingCamp_8fcfd3d3:

    # dam "*Laugh* See, boys? You have to be gentle when you give something to a lady."
    dam "*Rires* Vous voyez, les gars ? Il faut être doux quand on donne quelque chose à une dame."

# game/scripts/c32/c32.rpy:1356
translate french c32s002_trainingCamp_ee71ee81:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1357
translate french c32s002_trainingCamp_96aef4f9:

    # "Watching [ama] shoot with no apparent effort is like watching a leopard chase a gazelle."
    "Regarder [ama] tirer sans aucun effort apparent, c'est comme regarder un léopard chasser une gazelle."

# game/scripts/c32/c32.rpy:1358
translate french c32s002_trainingCamp_b812fa12:

    # "Focused, making an art out of economy of movement."
    "Concentrée, faisant de l'économie de mouvement un véritable art."

# game/scripts/c32/c32.rpy:1360
translate french c32s002_trainingCamp_070f6b7f:

    # "Beautiful and deadly at the same time."
    "Magnifique et mortelle à la fois."

# game/scripts/c32/c32.rpy:1362
translate french c32s002_trainingCamp_967be4be:

    # "Deadly."
    "Mortelle."
# game/scripts/c32/c32.rpy:1364
translate french c32s002_trainingCamp_ca34ba5e:

    # ama "Done. Hank, go count the scores. Please."
    ama "Fini. Hank, va compter les points. S'il te plaît."

# game/scripts/c32/c32.rpy:1368
translate french c32s002_trainingCamp_cce713a9:

    # cl1 "Yes, Ma'am."
    cl1 "Oui, Madame."

# game/scripts/c32/c32.rpy:1370
translate french c32s002_trainingCamp_7446f74b:

    # "[cl1] returns after a minute. He ran there and back. He hasn't even started sweating under the Caribbean summer sun."
    "[cl1] revient après une minute. Il a fait l'aller-retour en courant. Il n'a même pas commencé à transpirer sous le soleil d'été des Caraïbes."

# game/scripts/c32/c32.rpy:1371
translate french c32s002_trainingCamp_179b7413:

    # "You are drenched in sweat. Partly from the heat, partly from the nervousness of what is happening."
    "Tu es trempé de sueur. En partie à cause de la chaleur, en partie à cause de la nervosité face à ce qui se passe."

# game/scripts/c32/c32.rpy:1372
translate french c32s002_trainingCamp_5905370c:

    # cl1 "97.5 points, [ama]. Two of the shots hit the 9 and another on the line between the 9 and the 10. The rest in the 10."
    cl1 "97,5 points, [ama]. Deux des tirs ont touché le 9 et un autre sur la ligne entre le 9 et le 10. Le reste dans le 10."

# game/scripts/c32/c32.rpy:1373
translate french c32s002_trainingCamp_e45d6dd6:

    # ama "Thanks, Hank."
    ama "Merci, Hank."

# game/scripts/c32/c32.rpy:1374
translate french c32s002_trainingCamp_acda52cf:

    # dam "*Laugh* Are you out of practice? Give me the gun."
    dam "*Rire* Tu manques de pratique ? Donne-moi le flingue."

# game/scripts/c32/c32.rpy:1376
translate french c32s002_trainingCamp_bc518237:

    # "[ama] unloads the gun and hands it to [dam]. You're sure that barrel must be really hot."
    "[ama] décharge l'arme et la tend à [dam]. Tu es sûr que le canon doit être brûlant."

# game/scripts/c32/c32.rpy:1377
translate french c32s002_trainingCamp_d5ef2e16:

    # dam "I see we taught you well. Safety first."
    dam "Je vois qu'on t'a bien appris. La sécurité avant tout."

# game/scripts/c32/c32.rpy:1378
translate french c32s002_trainingCamp_220dc0f6:

    # ama "*Whispering* You know there are 7 bullets left in that magazine, right? Don't make me say where I want to shove them right now."
    ama "*Chuchote* Tu sais qu'il reste 7 balles dans ce chargeur, hein ? Ne m'oblige pas à te dire où j'ai envie de te les fourrer tout de suite."

# game/scripts/c32/c32.rpy:1379
translate french c32s002_trainingCamp_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."
# game/scripts/c32/c32.rpy:1381
translate french c32s002_trainingCamp_263a634e:

    # "They both ignore you. [dam] checks again that the chamber is empty before pulling out a new magazine."
    "Ils t'ignorent tous les deux. [dam] vérifie à nouveau que la chambre est vide avant de sortir un nouveau chargeur."

# game/scripts/c32/c32.rpy:1383
translate french c32s002_trainingCamp_70ff9d7f:

    # dam "Your turn, boss..."
    dam "À ton tour, boss..."

# game/scripts/c32/c32.rpy:1384
translate french c32s002_trainingCamp_1114cc9a:

    # "He makes the gesture of handing you the gun in 'damsel mode' as he said before. You don't think it's the safest way to hand a gun to anyone."
    "Il fait le geste de te tendre le flingue en 'mode demoiselle' comme il l'a dit plus tôt. Tu ne penses pas que ce soit la façon la plus sûre de tendre une arme à qui que ce soit."

# game/scripts/c32/c32.rpy:1385
translate french c32s002_trainingCamp_f2dda412:

    # dam "*Whispering* I'm going to drop the gun. Don't catch it."
    dam "*En chuchotant* Je vais lâcher le flingue. Ne le rattrape pas."

# game/scripts/c32/c32.rpy:1386
translate french c32s002_trainingCamp_969c08b9:

    # mc "*Whispering* What?"
    mc "*En chuchotant* Quoi ?"

# game/scripts/c32/c32.rpy:1388
translate french c32s002_trainingCamp_8d77159f:

    # "Without letting you react, [dam] discreetly drops the unloaded gun."
    "Sans te laisser réagir, [dam] lâche discrètement l'arme déchargée."

# game/scripts/c32/c32.rpy:1389
translate french c32s002_trainingCamp_b43a6143:

    # "You don't understand what's going on."
    "Tu ne comprends pas ce qui se passe."

# game/scripts/c32/c32.rpy:1391
translate french c32s002_trainingCamp_80e5a899:

    # dam "Sorry, boss. My bad. I let it go before you grabbed it. I thought you'd have better reflexes."
    dam "Désolé, boss. C'est ma faute. Je l'ai lâché avant que tu le prennes. Je pensais que tu aurais de meilleurs réflexes."

# game/scripts/c32/c32.rpy:1392
translate french c32s002_trainingCamp_19b901d1:

    # mc "Thanks?"
    mc "Merci ?"

# game/scripts/c32/c32.rpy:1393
translate french c32s002_trainingCamp_4dc455aa:

    # "You don't understand what game the mercenary is playing."
    "Tu ne comprends pas à quel jeu joue le mercenaire."

# game/scripts/c32/c32.rpy:1395
translate french c32s002_trainingCamp_ffa0f3d2:

    # dam "Your turn, {b}boss{/b}. Remember that the bullets come out of the hole in the front."
    dam "À ton tour, {b}boss{/b}. N'oublie pas que les balles sortent par le trou à l'avant."
# game/scripts/c32/c32.rpy:1396
translate french c32s002_trainingCamp_62c6f937:

    # dam "*Whispering* Make the first shot go way off."
    dam "*Chuchotant* Fais en sorte que le premier tir soit complètement à côté."

# game/scripts/c32/c32.rpy:1397
translate french c32s002_trainingCamp_a7583bcd:

    # dam "And that's how you hand a gun to an {b}experienced damsel{/b}, boys."
    dam "Et c'est comme ça qu'on tend une arme à une {b}demoiselle expérimentée{/b}, les gars."

# game/scripts/c32/c32.rpy:1398
translate french c32s002_trainingCamp_430d4dfc:

    # dam "Don't try this with rookies. You see what can happen."
    dam "N'essayez pas ça avec des bleus. Vous voyez ce qui peut arriver."

# game/scripts/c32/c32.rpy:1400
translate french c32s002_trainingCamp_75aec83f:

    # "You get into the stance [eva] taught you, but this time you decide to use both hands."
    "Tu prends la position qu'[eva] t'a apprise, mais cette fois tu décides d'utiliser tes deux mains."

# game/scripts/c32/c32.rpy:1401
translate french c32s002_trainingCamp_20b86b0b:

    # "It's not just about impressing a girl, but tough mercenaries. Even if the girl there is a tough mercenary."
    "Il ne s'agit pas seulement d'impressionner une fille, mais des mercenaires endurcis. Même si la fille en question est une mercenaire endurcie."

# game/scripts/c32/c32.rpy:1402
translate french c32s002_trainingCamp_e0a5ff4e:

    # "And you know you're not going to get anywhere near [ama]'s score. If you even manage to hit the target from that distance, of course."
    "Et tu sais que tu ne vas même pas t'approcher du score d'[ama]. Si tu arrives à toucher la cible à cette distance, bien sûr."

# game/scripts/c32/c32.rpy:1403
translate french c32s002_trainingCamp_e10fbc1a:

    # "A drop of sweat runs down the back of your neck to join the sea of sweat on your back."
    "Une goutte de sueur coule sur ta nuque pour rejoindre l'océan de sueur sur ton dos."

# game/scripts/c32/c32.rpy:1404
translate french c32s002_trainingCamp_63aac271:

    # "The target looks incredibly far away."
    "La cible semble incroyablement loin."

# game/scripts/c32/c32.rpy:1406
translate french c32s002_trainingCamp_ee71ee81_1:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1407
translate french c32s002_trainingCamp_218541ad:

    # "You try to shoot low, just like [dam] told you to. Obviously, the target doesn't move."
    "Tu essaies de tirer bas, exactement comme [dam] te l'a dit. Évidemment, la cible ne bouge pas."

# game/scripts/c32/c32.rpy:1409
translate french c32s002_trainingCamp_6de95574:

    # "A dust cloud appears to the right of the target, pretty high up."
    "Un nuage de poussière apparaît à droite de la cible, assez haut."
# game/scripts/c32/c32.rpy:1411
translate french c32s002_trainingCamp_865fa0cd:

    # dam "*Laugh* Is that the best you can do? If you ever face an army of moles, maybe you'll hit them."
    dam "*Rire* C'est le mieux que tu puisses faire ? Si jamais tu affrontes une armée de taupes, tu arriveras peut-être à les toucher."

# game/scripts/c32/c32.rpy:1412
translate french c32s002_trainingCamp_e0d54415:

    # cl1 "*Laughing whisper* I don't think I've missed that miserably since I was seven."
    cl1 "*Chuchotement en riant* Je ne crois pas avoir raté aussi lamentablement depuis l'âge de sept ans."

# game/scripts/c32/c32.rpy:1413
translate french c32s002_trainingCamp_e68282f9:

    # cl2 "*Whispering* Don't lie. You were at least eight."
    cl2 "*Chuchotement* Ne mens pas. Tu en avais au moins huit."

# game/scripts/c32/c32.rpy:1414
translate french c32s002_trainingCamp_5c2c25ff:

    # cl3 "*Whispering* Hard to believe he's the old man's original."
    cl3 "*Chuchotement* Difficile de croire qu'il est l'original du vieux."

# game/scripts/c32/c32.rpy:1415
translate french c32s002_trainingCamp_1c899f33:

    # gid "*Whispering* Maybe he isn't used to the weight of the Glock..."
    gid "*Chuchotement* Peut-être qu'il n'est pas habitué au poids du Glock..."

# game/scripts/c32/c32.rpy:1417
translate french c32s002_trainingCamp_1c30c8d9:

    # "This must be what [dam] wanted. To make a fool of you in front of the rest of the guys."
    "C'est sûrement ce que [dam] voulait. Te ridiculiser devant le reste des gars."

# game/scripts/c32/c32.rpy:1418
translate french c32s002_trainingCamp_de2fa46e:

    # "You adjust your aim as best you can. With nine bullets you won't be able to reach [ama]'s score."
    "Tu ajustes ta visée du mieux que tu peux. Avec neuf balles, tu ne pourras pas atteindre le score de [ama]."

# game/scripts/c32/c32.rpy:1419
translate french c32s002_trainingCamp_2d8e903d:

    # "You probably wouldn't manage it with 90 bullets."
    "Tu n'y arriverais probablement pas avec 90 balles."

# game/scripts/c32/c32.rpy:1420
translate french c32s002_trainingCamp_00a996b8:

    # "You focus on the target, just like [eva] taught you."
    "Tu te concentres sur la cible, exactement comme [eva] te l'a appris."

# game/scripts/c32/c32.rpy:1422
translate french c32s002_trainingCamp_ee71ee81_2:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1423
translate french c32s002_trainingCamp_cd78e42a:

    # "You fire the nine shots in quick succession, slightly adjusting your position between shots."
    "Tu tires les neuf coups en succession rapide, en ajustant légèrement ta position entre chaque tir."
# game/scripts/c32/c32.rpy:1424
translate french c32s002_trainingCamp_e11a2b20:

    # "You could swear the dust cloud kicked up behind the target on every single one of them, but you were too focused to be sure."
    "Tu pourrais jurer que le nuage de poussière s'est soulevé derrière la cible à chacun de tes tirs, mais tu étais trop concentré pour en être sûr."

# game/scripts/c32/c32.rpy:1427
translate french c32s002_trainingCamp_df04cecb:

    # "You unload the weapon and hand it to [dam], looking him straight in the eyes defiantly."
    "Tu décharges l'arme et la tends à [dam], le regardant droit dans les yeux avec défi."

# game/scripts/c32/c32.rpy:1428
translate french c32s002_trainingCamp_6f9d9285:

    # "You know he's won, whatever game he's playing."
    "Tu sais qu'il a gagné, quel que soit le jeu auquel il joue."

# game/scripts/c32/c32.rpy:1429
translate french c32s002_trainingCamp_4d4a0b0d:

    # mc "Done."
    mc "C'est fait."

# game/scripts/c32/c32.rpy:1430
translate french c32s002_trainingCamp_b4729405:

    # dam "*Laugh* Careful, don't drop the gun."
    dam "*Rires* Attention, ne fais pas tomber l'arme."

# game/scripts/c32/c32.rpy:1431
translate french c32s002_trainingCamp_bf7c647c:

    # "Without breaking eye contact with the mercenary..."
    "Sans rompre le contact visuel avec le mercenaire..."

# game/scripts/c32/c32.rpy:1432
translate french c32s002_trainingCamp_0f3b981c:

    # mc "[gid], can you go check the score, please?"
    mc "[gid], tu peux aller vérifier le score, s'il te plaît ?"

# game/scripts/c32/c32.rpy:1434
translate french c32s002_trainingCamp_dec27729:

    # "A minute later..."
    "Une minute plus tard..."

# game/scripts/c32/c32.rpy:1435
translate french c32s002_trainingCamp_4e8b7ccc:

    # gid "48.5, Sir. Less than half of [ama]'s."
    gid "48,5, Monsieur. Moins de la moitié de celui d'[ama]."

# game/scripts/c32/c32.rpy:1436
translate french c32s002_trainingCamp_dbfa764d:

    # "Under any other circumstances, you'd feel proud of yourself. But you still don't understand what game [dam] is playing."
    "Dans d'autres circonstances, tu serais fier de toi. Mais tu ne comprends toujours pas à quel jeu joue [dam]."

# game/scripts/c32/c32.rpy:1437
translate french c32s002_trainingCamp_ca327555:

    # "[ama] looks at you with disbelief and pride."
    "[ama] te regarde avec incrédulité et fierté."
# game/scripts/c32/c32.rpy:1439
translate french c32s002_trainingCamp_85a87ecd:

    # dam "Not bad for a rookie. Especially considering you wasted the first bullet."
    dam "Pas mal pour un bleu. Surtout vu que t'as gaspillé la première balle."

# game/scripts/c32/c32.rpy:1440
translate french c32s002_trainingCamp_e8a14f9f:

    # dam "*Whispering* Don't answer."
    dam "*Chuchotant* Ne réponds pas."

# game/scripts/c32/c32.rpy:1441
translate french c32s002_trainingCamp_166632e1:

    # dam "Now I'm going to show you what a real man does."
    dam "Maintenant, je vais te montrer comment fait un vrai mec."

# game/scripts/c32/c32.rpy:1442
translate french c32s002_trainingCamp_dd29310d:

    # "You follow his advice and don't respond to his provocation. You think you're starting to see his game."
    "Tu suis son conseil et ne réponds pas à sa provocation. Tu penses commencer à comprendre son petit jeu."

# game/scripts/c32/c32.rpy:1444
translate french c32s002_trainingCamp_b8f2d890:

    # dam "Pay attention, boys. Watch how it's done."
    dam "Faites bien attention, les gars. Regardez comment on fait."

# game/scripts/c32/c32.rpy:1446
translate french c32s002_trainingCamp_f75f79fc:

    # ama "*Whispering* I feel like killing him right now. Where's a Bradley when you need one?"
    ama "*Chuchotant* J'ai envie de le buter, là, tout de suite. Où est-ce qu'on peut trouver un Bradley quand on en a besoin ?"

# game/scripts/c32/c32.rpy:1447
translate french c32s002_trainingCamp_efeb9587:

    # mc "*Whispering* I'm not sure yet, but I think there's more to this than what we can see."
    mc "*Chuchotant* J'en suis pas encore sûr, mais je crois qu'il y a plus que ce qu'il n'y paraît."

# game/scripts/c32/c32.rpy:1448
translate french c32s002_trainingCamp_9814655f:

    # ama "*Whispering* [dam] is pretty simple. I don't think he's thought of anything complicated."
    ama "*Chuchotant* [dam] est plutôt basique. Je ne pense pas qu'il ait pensé à un truc compliqué."

# game/scripts/c32/c32.rpy:1449
translate french c32s002_trainingCamp_b267efde:

    # mc "*Whispering* Give him the benefit of the doubt..."
    mc "*Chuchotant* Laisse-lui le bénéfice du doute..."

# game/scripts/c32/c32.rpy:1451
translate french c32s002_trainingCamp_07a1dfb7:

    # "[dam] gets into a one-handed shooting stance."
    "[dam] se met en position de tir à une main."

# game/scripts/c32/c32.rpy:1452
translate french c32s002_trainingCamp_2e83baa6:

    # "It's clear he's showing off in front of the other clones."
    "C'est clair qu'il frime devant les autres clones."
# game/scripts/c32/c32.rpy:1454
translate french c32s002_trainingCamp_ee71ee81_3:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1455
translate french c32s002_trainingCamp_b2b3e98a:

    # "He fires the first bullet."
    "Il tire la première balle."

# game/scripts/c32/c32.rpy:1457
translate french c32s002_trainingCamp_4ce8d8ce:

    # "The dust cloud rises far from the target, in a position similar to your first shot."
    "Le nuage de poussière s'élève loin de la cible, dans une position similaire à ton premier tir."

# game/scripts/c32/c32.rpy:1458
translate french c32s002_trainingCamp_546b9e13:

    # "Now you understand his game perfectly."
    "Maintenant, tu comprends parfaitement son petit jeu."

# game/scripts/c32/c32.rpy:1460
translate french c32s002_trainingCamp_ee71ee81_4:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1461
translate french c32s002_trainingCamp_97d3991b:

    # "He fires for the second time."
    "Il tire pour la deuxième fois."

# game/scripts/c32/c32.rpy:1463
translate french c32s002_trainingCamp_1eecee43:

    # "The cloud rises in exactly the same spot."
    "Le nuage s'élève exactement au même endroit."

# game/scripts/c32/c32.rpy:1465
translate french c32s002_trainingCamp_ee71ee81_5:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1466
translate french c32s002_trainingCamp_e69bc401:

    # "He fires for the third time."
    "Il tire pour la troisième fois."

# game/scripts/c32/c32.rpy:1468
translate french c32s002_trainingCamp_70ae0ece:

    # "This time, the dust cloud rises behind the target."
    "Cette fois, le nuage de poussière s'élève derrière la cible."

# game/scripts/c32/c32.rpy:1470
translate french c32s002_trainingCamp_d7da26e2:

    # dam "[cl2], give me your gun. I think my sight got misaligned when the boss dropped it."
    dam "[cl2], donne-moi ton flingue. Je crois que mon viseur s'est déréglé quand le boss l'a fait tomber."
# game/scripts/c32/c32.rpy:1471
translate french c32s002_trainingCamp_0daa77dc:

    # dam "I have to correct my aim down and to the left."
    dam "Je dois corriger ma visée vers le bas et à gauche."

# game/scripts/c32/c32.rpy:1473
translate french c32s002_trainingCamp_ebb93b56:

    # "After swapping guns, he returns to the shooting position."
    "Après avoir changé d'arme, il retourne en position de tir."

# game/scripts/c32/c32.rpy:1475
translate french c32s002_trainingCamp_ee71ee81_6:

    # "*Bang*"
    "*Bang*"

# game/scripts/c32/c32.rpy:1476
translate french c32s002_trainingCamp_c4ac4da5:

    # "He fires seven shots, one after the other."
    "Il tire sept coups, l'un après l'autre."

# game/scripts/c32/c32.rpy:1478
translate french c32s002_trainingCamp_dbbbf1aa:

    # dam "That's better. I'll have to check my gun when we get back to the outpost."
    dam "C'est mieux. Je vais devoir vérifier mon arme quand on rentrera à l'avant-poste."

# game/scripts/c32/c32.rpy:1479
translate french c32s002_trainingCamp_2f23ab16:

    # dam "[cl3], go check the scores. With only 8 good shots, I couldn't have caught up to [ama]."
    dam "[cl3], va vérifier les scores. Avec seulement 8 bons tirs, je n'aurais pas pu rattraper [ama]."

# game/scripts/c32/c32.rpy:1481
translate french c32s002_trainingCamp_904e2706:

    # "After a couple of minutes..."
    "Après quelques minutes..."

# game/scripts/c32/c32.rpy:1482
translate french c32s002_trainingCamp_a122138c:

    # cl3 "62 points, [dam]. One of the first three shots hit the target, but... on the one. It must have been the third shot."
    cl3 "62 points, [dam]. Un des trois premiers tirs a touché la cible, mais... dans le un. Ça devait être le troisième tir."

# game/scripts/c32/c32.rpy:1483
translate french c32s002_trainingCamp_96dbd380:

    # cl3 "Of the rest, one ten, three nines, and three eights."
    cl3 "Pour le reste, un dix, trois neufs et trois huits."

# game/scripts/c32/c32.rpy:1485
translate french c32s002_trainingCamp_3b69c48a:

    # dam "[cl2], I'm keeping your weapon. It seems a bit off too. I'll take a look at it."
    dam "[cl2], je garde ton arme. Elle a l'air un peu déréglée aussi. J'y jetterai un œil."

# game/scripts/c32/c32.rpy:1486
translate french c32s002_trainingCamp_516803cc:

    # dam "I didn't beat [ama], but it's clear I'm several levels above the... {b}boss{/b}."
    dam "Je n'ai pas battu [ama], mais il est clair que je suis à plusieurs niveaux au-dessus du... {b}boss{/b}."
# game/scripts/c32/c32.rpy:1488
translate french c32s002_trainingCamp_3f2ce5d4:

    # gid "Don't be unfair, [dam]. With your faulty gun, he scored... more than five points per shot once he adjusted."
    gid "Ne sois pas de mauvaise foi, [dam]. Avec ton flingue défectueux, il a fait... plus de cinq points par tir une fois qu'il s'est adapté."

# game/scripts/c32/c32.rpy:1489
translate french c32s002_trainingCamp_333527c6:

    # gid "And he only needed one shot to adjust. You used two and got a miserable one on the third."
    gid "Et il n'a eu besoin que d'un seul tir pour s'adapter. Tu en as utilisé deux et tu as fait un score minable au troisième."

# game/scripts/c32/c32.rpy:1491
translate french c32s002_trainingCamp_05887a0a:

    # dam "I think I'm going to make you run laps when we get back to the outpost. But you're {b}somewhat{/b} right."
    dam "Je crois que je vais te faire courir des tours de terrain quand on rentrera à l'avant-poste. Mais tu as {b}en quelque sorte{/b} raison."

# game/scripts/c32/c32.rpy:1492
translate french c32s002_trainingCamp_bcc1a34b:

    # dam "Luckily, his role isn't to fight, but to make decisions."
    dam "Heureusement, son rôle n'est pas de se battre, mais de prendre des décisions."

# game/scripts/c32/c32.rpy:1494
translate french c32s002_trainingCamp_84e0fe8c:

    # dam "We're heading back to base, guys. I think the boss has earned the right to ride up front with me."
    dam "On rentre à la base, les gars. Je pense que le boss a mérité le droit de monter à l'avant avec moi."

# game/scripts/c32/c32.rpy:1495
translate french c32s002_trainingCamp_10c8e61e:

    # dam "You guys ride in the back like damsels. And no causing trouble. The deadliest damsel on the base will be watching you."
    dam "Vous, vous montez à l'arrière comme des demoiselles. Et pas d'embrouilles. La demoiselle la plus mortelle de la base vous surveillera."

# game/scripts/c32/c32.rpy:1498
translate french c32s002_trainingCamp_895151c4:

    # "In the truck..."
    "Dans le camion..."

# game/scripts/c32/c32.rpy:1499
translate french c32s002_trainingCamp_a60ad23a:

    # mc "*Whispering* Why, [dam]?"
    mc "*Chuchotant* Pourquoi, [dam] ?"

# game/scripts/c32/c32.rpy:1500
translate french c32s002_trainingCamp_67852316:

    # dam "Why what?"
    dam "Pourquoi quoi ?"

# game/scripts/c32/c32.rpy:1501
translate french c32s002_trainingCamp_5e7c2edc:

    # mc "*Whispering* Why did you put on that act with the gun dropping?"
    mc "*Chuchotant* Pourquoi tu as joué la comédie en faisant tomber l'arme ?"

# game/scripts/c32/c32.rpy:1503
translate french c32s002_trainingCamp_3f1c365c:

    # dam "No need to whisper. You can't hear anything back there."
    dam "Pas la peine de chuchoter. On n'entend rien à l'arrière."
# game/scripts/c32/c32.rpy:1504
translate french c32s002_trainingCamp_ab518dac:

    # dam "[ama] told me that [eva] had been teaching you, and I wanted to see how good you were."
    dam "[ama] m'a dit qu'[eva] t'avait entraîné, et je voulais voir ce que tu valais."

# game/scripts/c32/c32.rpy:1506
translate french c32s002_trainingCamp_00bd99ba:

    # dam "I knew someone was going to challenge you sooner or later. Why not me?"
    dam "Je savais que quelqu'un allait te défier tôt ou tard. Pourquoi pas moi ?"

# game/scripts/c32/c32.rpy:1507
translate french c32s002_trainingCamp_78556c65:

    # dam "Everyone says us D's are show-offs, not too bright, and have problems with authority. So I was a good choice."
    dam "Tout le monde dit que nous, les D, on est des frimeurs, pas très futés, et qu'on a des problèmes avec l'autorité. Donc j'étais un bon choix."

# game/scripts/c32/c32.rpy:1509
translate french c32s002_trainingCamp_8f252dd6:

    # dam "*Laugh* But I couldn't make a fool out of you in front of the guys."
    dam "*Rires* Mais je ne pouvais pas te faire passer pour un con devant les gars."

# game/scripts/c32/c32.rpy:1510
translate french c32s002_trainingCamp_4d505fd7:

    # dam "They would have lost respect for you."
    dam "Ils auraient perdu tout respect pour toi."

# game/scripts/c32/c32.rpy:1511
translate french c32s002_trainingCamp_313980c0:

    # mc "But you knew I couldn't match [ama]..."
    mc "Mais tu savais que je ne ferais pas le poids face à [ama]..."

# game/scripts/c32/c32.rpy:1513
translate french c32s002_trainingCamp_88d2c2dc:

    # dam "Not you, not me, not anyone, except [eva]. And the other girls, of course. But they're not here anymore."
    dam "Ni toi, ni moi, ni personne, à part [eva]. Et les autres filles, bien sûr. Mais elles ne sont plus là."

# game/scripts/c32/c32.rpy:1514
translate french c32s002_trainingCamp_8d14edb3:

    # dam "Do you know anything about basketball?"
    dam "Tu t'y connais un peu en basket ?"

# game/scripts/c32/c32.rpy:1515
translate french c32s002_trainingCamp_54eef042:

    # mc "A little..."
    mc "Un peu..."

# game/scripts/c32/c32.rpy:1517
translate french c32s002_trainingCamp_c48eac61:

    # dam "You'd be a high school player. You wouldn't be the star of your team, but from what I've seen today, you'd be good."
    dam "Tu serais un joueur de lycée. Tu ne serais pas la star de ton équipe, mais d'après ce que j'ai vu aujourd'hui, tu serais bon."

# game/scripts/c32/c32.rpy:1518
translate french c32s002_trainingCamp_5b3bd0f8:

    # dam "If you trained your ass off, you might make it to the NCAA."
    dam "Si tu te cassais le cul à l'entraînement, tu pourrais peut-être atteindre la NCAA."
# game/scripts/c32/c32.rpy:1519
translate french c32s002_trainingCamp_77b0e51f:

    # dam "A regular soldier would be a decent NCAA player."
    dam "Un soldat ordinaire serait un joueur décent de la NCAA."

# game/scripts/c32/c32.rpy:1520
translate french c32s002_trainingCamp_ac74606f:

    # dam "SEALs, Green Berets, and the like would be NBA players. Some starters, some benchwarmers."
    dam "Les SEALs, les Bérets Verts et autres seraient des joueurs de la NBA. Certains titulaires, d'autres cireurs de banc."

# game/scripts/c32/c32.rpy:1521
translate french c32s002_trainingCamp_46ba947d:

    # dam "Most of us clones would be the star players of our NBA teams."
    dam "La plupart d'entre nous, les clones, serions les joueurs vedettes de nos équipes NBA."

# game/scripts/c32/c32.rpy:1523
translate french c32s002_trainingCamp_e0028ce1:

    # dam "[ama] and [eva] are like if Kareem, Magic, Michael, Larry, Lebron, and Kobe had a crazy night of sex and gave birth to them."
    dam "[ama] et [eva], c'est comme si Kareem, Magic, Michael, Larry, Lebron et Kobe avaient passé une nuit de baise de folie et leur avaient donné naissance."

# game/scripts/c32/c32.rpy:1524
translate french c32s002_trainingCamp_b701ed4e:

    # mc "Are they really that good? I know they're good, but..."
    mc "Elles sont vraiment si fortes que ça ? Je sais qu'elles sont douées, mais..."

# game/scripts/c32/c32.rpy:1526
translate french c32s002_trainingCamp_1ca4d774:

    # dam "Good? They're the best there is in the killing business."
    dam "Fortes ? Ce sont les meilleures dans le business de la mort."

# game/scripts/c32/c32.rpy:1527
translate french c32s002_trainingCamp_1df0d75f:

    # dam "They know how to do everything, and they do it well. I promise you I tried my hardest on those last seven shots."
    dam "Elles savent tout faire, et elles le font bien. Je te promets que j'ai tout donné sur ces sept derniers tirs."

# game/scripts/c32/c32.rpy:1528
translate french c32s002_trainingCamp_33b00cd1:

    # dam "I'm good, and I didn't even average a 9. [ama] did it almost perfectly."
    dam "Je suis bon, et je n'ai même pas atteint une moyenne de 9. [ama] l'a fait presque parfaitement."

# game/scripts/c32/c32.rpy:1530
translate french c32s002_trainingCamp_21a1ff26:

    # dam "Olympic shooter level. But she could do the same with a rifle, a knife, or a grenade launcher. An Olympic shooter couldn't."
    dam "Niveau tireur olympique. Mais elle pourrait faire la même chose avec un fusil, un couteau ou un lance-grenades. Un tireur olympique ne pourrait pas."

# game/scripts/c32/c32.rpy:1531
translate french c32s002_trainingCamp_06b407f6:

    # dam "They also couldn't fly a plane or a helicopter like [eva], or design an improvised defense post like [ama]."
    dam "Ils ne pourraient pas non plus piloter un avion ou un hélicoptère comme [eva], ni concevoir un poste de défense improvisé comme [ama]."

# game/scripts/c32/c32.rpy:1532
translate french c32s002_trainingCamp_b2e12b56:

    # dam "Although with a grenade launcher I'd probably beat them. Both of them and the Olympic shooter."
    dam "Bien qu'avec un lance-grenades, je les battrais probablement. Toutes les deux et le tireur olympique."
# game/scripts/c32/c32.rpy:1533
translate french c32s002_trainingCamp_ce4f99cf:

    # mc "*Laugh* And we'd have to change the targets after every shot."
    mc "*Rire* Et on devrait changer les cibles après chaque tir."

# game/scripts/c32/c32.rpy:1535
translate french c32s002_trainingCamp_567cf30e:

    # dam "*Laugh* I like your sense of humor. I think it's the first time I've heard you laugh."
    dam "*Rire* J'aime ton sens de l'humour. Je crois que c'est la première fois que je t'entends rire."

# game/scripts/c32/c32.rpy:1536
translate french c32s002_trainingCamp_9732a5e6:

    # mc "But you still haven't told me why. That thing about wanting to see how good I was, I don't buy it."
    mc "Mais tu ne m'as toujours pas dit pourquoi. Cette histoire de vouloir voir à quel point j'étais bon, j'y crois pas une seconde."

# game/scripts/c32/c32.rpy:1537
translate french c32s002_trainingCamp_b43ddd82:

    # mc "You could have asked me to go together and... test me."
    mc "Tu aurais pu me demander d'y aller ensemble et... de me tester."

# game/scripts/c32/c32.rpy:1539
translate french c32s002_trainingCamp_bb501a4f:

    # dam "You don't get it. I already told you someone had to challenge you sooner or later."
    dam "Tu piges pas. Je t'ai déjà dit que quelqu'un devait te défier tôt ou tard."

# game/scripts/c32/c32.rpy:1540
translate french c32s002_trainingCamp_8d01d0d8:

    # dam "Ever since we had the meeting and saw you with [aar], we know whose clone the old man is. And the guys are starting to talk about it."
    dam "Depuis qu'on a eu la réunion et qu'on t'a vu avec [aar], on sait de qui le vieux est le clone. Et les gars commencent à en parler."

# game/scripts/c32/c32.rpy:1541
translate french c32s002_trainingCamp_5a2df039:

    # dam "The old man was really good on the range back there."
    dam "Le vieux était vraiment doué au stand de tir, à l'époque."

# game/scripts/c32/c32.rpy:1543
translate french c32s002_trainingCamp_46c5f32f:

    # dam "Besides, you were at [gav]'s surgery. Someone saw you leave the waiting room last."
    dam "En plus, tu étais à l'opération de [gav]. Quelqu'un t'a vu quitter la salle d'attente en dernier."

# game/scripts/c32/c32.rpy:1544
translate french c32s002_trainingCamp_43d5c0b9:

    # dam "You were in there alone for over 20 minutes."
    dam "Tu y étais seul pendant plus de 20 minutes."

# game/scripts/c32/c32.rpy:1545
translate french c32s002_trainingCamp_12e114a8:

    # mc "I wanted to talk to [bet], the surgeon. Not just because she's my aunt and I wanted to know how she was doing."
    mc "Je voulais parler à [bet], la chirurgienne. Pas seulement parce que c'est ma tante et que je voulais savoir comment elle allait."

# game/scripts/c32/c32.rpy:1546
translate french c32s002_trainingCamp_2cd1eb53:

    # mc "I also wanted to know details about [gav]. Not just an 'Everything went as expected.'"
    mc "Je voulais aussi avoir des détails sur [gav]. Pas juste un 'Tout s'est passé comme prévu'."
# game/scripts/c32/c32.rpy:1547
translate french c32s002_trainingCamp_e5757408:

    # dam "That's what I mean."
    dam "C'est ce que je veux dire."

# game/scripts/c32/c32.rpy:1549
translate french c32s002_trainingCamp_b5c17d6e:

    # dam "And besides, you realized that [dec] wasn't me. How did you know? You only saw me for an hour in a meeting."
    dam "Et en plus, tu as réalisé que [dec] n'était pas moi. Comment tu as su ? Tu ne m'as vu qu'une heure lors d'une réunion."

# game/scripts/c32/c32.rpy:1550
translate french c32s002_trainingCamp_8f695b74:

    # mc "I don't know. I knew it wasn't you a second after saying your name."
    mc "Je ne sais pas. J'ai su que ce n'était pas toi une seconde après avoir dit ton nom."

# game/scripts/c32/c32.rpy:1551
translate french c32s002_trainingCamp_e2ba9e50:

    # dam "And is that important to you?"
    dam "Et c'est important pour toi ?"

# game/scripts/c32/c32.rpy:1552
translate french c32s002_trainingCamp_4c9a4f2c:

    # mc "Of course it is. I said you aren't slaves. You're just as human as I am, and you have to maintain your individuality."
    mc "Bien sûr que ça l'est. J'ai dit que vous n'étiez pas des esclaves. Vous êtes tout aussi humains que moi, et vous devez conserver votre individualité."

# game/scripts/c32/c32.rpy:1553
translate french c32s002_trainingCamp_e04bcd7e:

    # mc "And I have to be the first to treat you as individuals."
    mc "Et je dois être le premier à vous traiter comme des individus."

# game/scripts/c32/c32.rpy:1555
translate french c32s002_trainingCamp_7f7be5ed:

    # dam "Do you know what Daniels called me after more than 15 years of seeing me almost every day?"
    dam "Tu sais comment Daniels m'appelait après plus de 15 ans à me voir presque tous les jours ?"

# game/scripts/c32/c32.rpy:1556
translate french c32s002_trainingCamp_cc761816:

    # mc "No..."
    mc "Non..."

# game/scripts/c32/c32.rpy:1558
translate french c32s002_trainingCamp_bcd9ff64:

    # dam "*Faking a derogatory tone* 'Hey, you. That D over there.'"
    dam "*Imitant un ton péjoratif* 'Hé, toi. Ce D là-bas.'"

# game/scripts/c32/c32.rpy:1559
translate french c32s002_trainingCamp_525ea951:

    # mc "I'm not Daniels."
    mc "Je ne suis pas Daniels."

# game/scripts/c32/c32.rpy:1561
translate french c32s002_trainingCamp_888ebbb1:

    # dam "I know. You proved it the other day at the meeting and you've proved it today. That's why I want to help you."
    dam "Je sais. Tu l'as prouvé l'autre jour à la réunion et tu l'as prouvé aujourd'hui. C'est pour ça que je veux t'aider."
# game/scripts/c32/c32.rpy:1562
translate french c32s002_trainingCamp_3df83acc:

    # dam "Daniels would have come in a suit and wouldn't have accepted the shooting range challenge."
    dam "Daniels serait venu en costard et n'aurait pas accepté le défi du stand de tir."

# game/scripts/c32/c32.rpy:1563
translate french c32s002_trainingCamp_6c3949fc:

    # dam "And he wouldn't have known that [dec] wasn't me."
    dam "Et il n'aurait pas su que [dec] n'était pas moi."

# game/scripts/c32/c32.rpy:1564
translate french c32s002_trainingCamp_528348ad:

    # mc "*Laugh* Well, [dec] didn't ask me for a Ferrarini."
    mc "*Rires* Eh bien, [dec] ne m'a pas demandé une Ferrarini."

# game/scripts/c32/c32.rpy:1566
translate french c32s002_trainingCamp_8be9b251:

    # dam "*Laugh* I told you I liked your sense of humor. I think I'm going to regret saying that."
    dam "*Rires* Je t'ai dit que j'aimais ton sens de l'humour. Je crois que je vais regretter d'avoir dit ça."

# game/scripts/c32/c32.rpy:1567
translate french c32s002_trainingCamp_25ef46ee:

    # dam "But back to my point. You're different from Daniels, even though you'll never be one of us."
    dam "Mais pour en revenir à ce que je disais. Tu es différent de Daniels, même si tu ne seras jamais l'un des nôtres."

# game/scripts/c32/c32.rpy:1569
translate french c32s002_trainingCamp_ef9c9507:

    # dam "But you carry [aar]'s genes and you try to fit in with us. You listen to us and show that you care about us."
    dam "Mais tu portes les gènes d'[aar] et tu essaies de t'intégrer avec nous. Tu nous écoutes et tu montres que tu tiens à nous."

# game/scripts/c32/c32.rpy:1570
translate french c32s002_trainingCamp_09460c0a:

    # dam "Those guys back there will say you almost kicked my ass at the shooting range with a defective gun."
    dam "Ces gars-là diront que tu m'as presque botté le cul au stand de tir avec une arme défectueuse."

# game/scripts/c32/c32.rpy:1572
translate french c32s002_trainingCamp_4bebf0f9:

    # dam "Even though I beat you with my seven bullets against your nine. But they're going to exaggerate and, in a few days, someone will say you scored 70 points."
    dam "Même si je t'ai battu avec mes sept balles contre tes neuf. Mais ils vont exagérer et, dans quelques jours, quelqu'un dira que tu as marqué 70 points."

# game/scripts/c32/c32.rpy:1573
translate french c32s002_trainingCamp_8d5f9a05:

    # dam "At least no one is dumb enough to say you beat [ama]. No one would believe that."
    dam "Au moins, personne n'est assez con pour dire que tu as battu [ama]. Personne ne croirait ça."

# game/scripts/c32/c32.rpy:1574
translate french c32s002_trainingCamp_6dd6f2ee:

    # mc "They could have noticed you playing tricks."
    mc "Ils auraient pu remarquer tes petits tours."

# game/scripts/c32/c32.rpy:1576
translate french c32s002_trainingCamp_c007af19:

    # dam "The G's, except for [gav] and Grant, aren't very smart. I knew [gid] was predisposed to support you because he saw you in the waiting room."
    dam "Les G, à part [gav] et Grant, ne sont pas très futés. Je savais que [gid] était prédisposé à te soutenir parce qu'il t'a vu dans la salle d'attente."
# game/scripts/c32/c32.rpy:1577
translate french c32s002_trainingCamp_4ba72e84:

    # dam "The H's are a bit smarter, but the moment [gid] fell into the trap, they followed him."
    dam "Les H sont un peu plus malins, mais au moment où [gid] est tombé dans le piège, ils l'ont suivi."

# game/scripts/c32/c32.rpy:1579
translate french c32s002_trainingCamp_e4a5568d:

    # dam "Gear gets fucked up in the field every day, and the guys know it. It's easier to think about that than me helping you."
    dam "Le matos se fait niquer sur le terrain tous les jours, et les gars le savent. C'est plus facile de penser à ça plutôt qu'au fait que je t'aide."

# game/scripts/c32/c32.rpy:1580
translate french c32s002_trainingCamp_44d390b5:

    # dam "You're not going to have to prove anything to anyone else."
    dam "Tu n'auras rien à prouver à personne d'autre."

# game/scripts/c32/c32.rpy:1581
translate french c32s002_trainingCamp_39e82539:

    # mc "Yes. I'm going to have to prove that everything you said is true. And I plan to do it."
    mc "Si. Je vais devoir prouver que tout ce que tu as dit est vrai. Et j'ai bien l'intention de le faire."

# game/scripts/c32/c32.rpy:1583
translate french c32s002_trainingCamp_c284c804:

    # dam "*Laugh* You better. Remember I'm the one who knows how to use grenade launchers and cannons."
    dam "*Rire* T'as intérêt. N'oublie pas que c'est moi qui sais utiliser les lance-grenades et les canons."

# game/scripts/c32/c32.rpy:1584
translate french c32s002_trainingCamp_2ebf26db:

    # mc "*Laugh* If you attack me with that, I won't give you the Ferrarini."
    mc "*Rire* Si tu m'attaques avec ça, je ne te donnerai pas la Ferrarini."

# game/scripts/c32/c32.rpy:1586
translate french c32s002_trainingCamp_e2564258:

    # dam "What? You're going to give me the Ferrarini?"
    dam "Quoi ? Tu vas me donner la Ferrarini ?"

# game/scripts/c32/c32.rpy:1587
translate french c32s002_trainingCamp_50d089ac:

    # mc "*Laugh* Nope."
    mc "*Rire* Nan."

# game/scripts/c32/c32.rpy:1589
translate french c32s002_trainingCamp_79bfddef:

    # dam "*Grunt* I hate your sense of humor."
    dam "*Grogne* Je déteste ton sens de l'humour."

# game/scripts/c32/c32.rpy:1593
translate french c32s002_choices_94fcc3b1:

    # centered "{size=+20}{b}DAY 44 – WEDNESDAY{/b}{/size}"
    centered "{size=+20}{b}JOUR 44 – MERCREDI{/b}{/size}"

# game/scripts/c32/c32.rpy:1595
translate french c32s002_choices_31e7a1d4:

    # mcp "(Tomorrow marks a week since I arrived in Aruba.)"
    mcp "(Demain, ça fera une semaine que je suis arrivé à Aruba.)"
# game/scripts/c32/c32.rpy:1596
translate french c32s002_choices_6b1bf788:

    # mcp "(There's a ton of things to do, but I have to take it one step at a time.)"
    mcp "(Il y a une tonne de choses à faire, mais je dois y aller une étape à la fois.)"

# game/scripts/c32/c32.rpy:1598
translate french c32s002_choices_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c32/c32.rpy:1599
translate french c32s002_choices_3e597b1c:

    # mc "Come in, [ama]."
    mc "Entre, [ama]."

# game/scripts/c32/c32.rpy:1601
translate french c32s002_choices_ddb8a5e8:

    # ama "You know it's creepy when you do that, right?"
    ama "Tu sais que c'est flippant quand tu fais ça, hein ?"

# game/scripts/c32/c32.rpy:1602
translate french c32s002_choices_05bc6133:

    # mc "Do what?"
    mc "Faire quoi ?"

# game/scripts/c32/c32.rpy:1603
translate french c32s002_choices_60e2acf7:

    # ama "Know who's knocking on the door just by how their knuckles sound on the wood."
    ama "Savoir qui frappe à la porte juste au bruit de ses jointures sur le bois."

# game/scripts/c32/c32.rpy:1604
translate french c32s002_choices_f8a95736:

    # mc "It makes sense. You're soft, though not as much as [car]. [vin] is shy. [flo] and [mael] are assertive, but in different ways."
    mc "C'est logique. Tu es douce, bien que pas autant que [car]. [vin] est timide. [flo] et [mael] sont sûrs d'eux, mais de manières différentes."

# game/scripts/c32/c32.rpy:1605
translate french c32s002_choices_9acceccf:

    # mc "And [aar] never knocks."
    mc "Et [aar] ne frappe jamais."

# game/scripts/c32/c32.rpy:1606
translate french c32s002_choices_5044cb74:

    # mc "No one else visits me, except [geo] from IT. And I can hear his voice from here when he asks [car] if I'm around."
    mc "Personne d'autre ne me rend visite, à part [geo] de l'informatique. Et je peux entendre sa voix d'ici quand il demande à [car] si je suis dans le coin."

# game/scripts/c32/c32.rpy:1608
translate french c32s002_choices_84d8ad22:

    # ama "You look overwhelmed. Did something happen?"
    ama "Tu as l'air débordé. Il s'est passé quelque chose ?"

# game/scripts/c32/c32.rpy:1609
translate french c32s002_choices_a2bfa642:

    # mc "[vin] and his tiny hands just left. This morning he sent me the three reports I asked for the other day."
    mc "[vin] et ses petites mains viennent de partir. Ce matin, il m'a envoyé les trois rapports que je lui avais demandés l'autre jour."
# game/scripts/c32/c32.rpy:1611
translate french c32s002_choices_65e9afd8:

    # ama "That's more efficient than I expected... Why are you like this, then?"
    ama "C'est plus efficace que ce que j'espérais... Pourquoi es-tu dans cet état, alors ?"

# game/scripts/c32/c32.rpy:1612
translate french c32s002_choices_e1821513:

    # mc "Because I've been looking at the numbers, and I don't think I'll be able to meet the expectations set during the meeting with the operatives."
    mc "Parce que j'ai regardé les chiffres, et je ne pense pas pouvoir répondre aux attentes fixées lors de la réunion avec les agentes."

# game/scripts/c32/c32.rpy:1613
translate french c32s002_choices_d004ed67:

    # mc "There's not enough money to do it all, and they're not going to be happy. I have to leave out one of the promises we made."
    mc "Il n'y a pas assez d'argent pour tout faire, et elles ne vont pas être contentes. Je vais devoir laisser de côté l'une des promesses qu'on a faites."

# game/scripts/c32/c32.rpy:1615
translate french c32s002_choices_6d115153:

    # ama "If I can help... Explain the situation to me."
    ama "Si je peux aider... Explique-moi la situation."

# game/scripts/c32/c32.rpy:1616
translate french c32s002_choices_687a3364:

    # ama "You already gave them personal style and the ability to leave the base. The first ones will go out this weekend."
    ama "Tu leur as déjà accordé un style personnel et la possibilité de quitter la base. Les premières sortiront ce week-end."

# game/scripts/c32/c32.rpy:1617
translate french c32s002_choices_757c50f3:

    # mc "But there are still prosthetics, salaries, back pay, potential contract terminations, internal promotions, and passports."
    mc "Mais il reste les prothèses, les salaires, les arriérés, les éventuelles ruptures de contrat, les promotions internes et les passeports."

# game/scripts/c32/c32.rpy:1619
translate french c32s002_choices_cffed37b:

    # ama "Well, I don't think we know the cost of each of those things."
    ama "Eh bien, je ne pense pas qu'on connaisse le coût de chacune de ces choses."

# game/scripts/c32/c32.rpy:1620
translate french c32s002_choices_e2352b74:

    # mc "Oh, yes! We do know. There are some tiny hands that type very fast."
    mc "Oh, que si ! On le sait. Il y a des petites mains qui tapent très vite."

# game/scripts/c32/c32.rpy:1622
translate french c32s002_choices_860b0df6:

    # "You're having a hard time concentrating with the new blouse [ama] is wearing. Did her tits grow in the last three days?"
    "Tu as du mal à te concentrer avec le nouveau chemisier que porte [ama]. Est-ce que ses nichons ont grossi ces trois derniers jours ?"

# game/scripts/c32/c32.rpy:1624
translate french c32s002_choices_3942ae45:

    # ama "The passport issue too?"
    ama "Le problème des passeports aussi ?"

# game/scripts/c32/c32.rpy:1625
translate french c32s002_choices_0b7cfa00:

    # mc "Yeah. I talked to [flo] to see if he could think of anything, since he has contacts with foreign governments."
    mc "Ouais. J'ai parlé à [flo] pour voir s'il avait une idée, vu qu'il a des contacts avec des gouvernements étrangers."
# game/scripts/c32/c32.rpy:1626
translate french c32s002_choices_4556bcda:

    # mc "He gave [vin] the numbers on what it's going to cost us... in bribes."
    mc "Il a donné à [vin] les chiffres sur ce que ça va nous coûter... en pots-de-vin."

# game/scripts/c32/c32.rpy:1627
translate french c32s002_choices_40942838:

    # mc "And as for the rest, [vin] has made an estimate. And we can't afford it all."
    mc "Et pour le reste, [vin] a fait une estimation. Et on ne peut pas tout se permettre."

# game/scripts/c32/c32.rpy:1628
translate french c32s002_choices_38cf63f7:

    # mc "If only I knew how it would affect the operatives' opinion if I break each of these promises..."
    mc "Si seulement je savais comment ça affecterait l'opinion des agents si je brise chacune de ces promesses..."

# game/scripts/c32/c32.rpy:1630
translate french c32s002_choices_2c4da2b2:

    # ama "I think I can help you with that. After all, I'm just another operative... or I was until a few months ago."
    ama "Je pense pouvoir t'aider avec ça. Après tout, je ne suis qu'une agente de plus... ou je l'étais jusqu'à il y a quelques mois."

# game/scripts/c32/c32.rpy:1631
translate french c32s002_choices_51ef8059:

    # ama "If I had to rate from one to ten how much unhappiness each promise you leave out creates..."
    ama "Si je devais évaluer de un à dix le mécontentement que crée chaque promesse que tu laisses de côté..."

# game/scripts/c32/c32.rpy:1633
translate french c32s002_choices_9b0e52c3:

    # ama "The prosthetics would be a 9 for those who need them, but a 1 for the rest."
    ama "Les prothèses seraient un 9 pour ceux qui en ont besoin, mais un 1 pour les autres."

# game/scripts/c32/c32.rpy:1634
translate french c32s002_choices_455ef5af:

    # ama "If we're going to stop doing dangerous missions, they're going to think they'll never need them."
    ama "Si on arrête de faire des missions dangereuses, ils vont penser qu'ils n'en auront jamais besoin."

# game/scripts/c32/c32.rpy:1635
translate french c32s002_choices_aba4f93f:

    # ama "So I'd say a 3 overall."
    ama "Donc je dirais un 3 dans l'ensemble."

# game/scripts/c32/c32.rpy:1636
translate french c32s002_choices_6105f3e2:

    # mc "That helps. I hadn't thought of it that way."
    mc "Ça m'aide. Je n'y avais pas pensé de cette façon."

# game/scripts/c32/c32.rpy:1637
translate french c32s002_choices_f003b06f:

    # mc "But it would suck to leave [cal] without his prosthetic. He worked hard on [gav]'s."
    mc "Mais ça ferait chier de laisser [cal] sans sa prothèse. Il a travaillé dur sur celle de [gav]."

# game/scripts/c32/c32.rpy:1638
translate french c32s002_choices_399fde01:

    # ama "That's why I don't envy your job. These aren't easy decisions."
    ama "C'est pour ça que je n'envie pas ton boulot. Ce ne sont pas des décisions faciles."
# game/scripts/c32/c32.rpy:1640
translate french c32s002_choices_8e984af3:

    # mc "What if we leave the salary out?"
    mc "Et si on laissait tomber le salaire ?"

# game/scripts/c32/c32.rpy:1641
translate french c32s002_choices_0dc6f52f:

    # ama "They'd probably jump at your throat. A 10, for sure. For everyone."
    ama "Ils te sauteraient probablement à la gorge. Un 10, c'est sûr. Pour tout le monde."

# game/scripts/c32/c32.rpy:1642
translate french c32s002_choices_55b7c020:

    # ama "Besides, that was tied to the retroactive pay. What are you going to do about that?"
    ama "En plus, c'était lié au paiement rétroactif. Qu'est-ce que tu vas faire pour ça ?"

# game/scripts/c32/c32.rpy:1643
translate french c32s002_choices_966728e7:

    # mc "I don't know yet. I can't give them both without leaving something else out."
    mc "Je ne sais pas encore. Je ne peux pas leur donner les deux sans laisser tomber autre chose."

# game/scripts/c32/c32.rpy:1644
translate french c32s002_choices_8e41c56e:

    # mc "I thought giving them the salary might be a good idea."
    mc "Je me disais que leur donner le salaire pourrait être une bonne idée."

# game/scripts/c32/c32.rpy:1645
translate french c32s002_choices_f7b95eaa:

    # mc "Not only would it be fair, but it would also be a way of saying 'From now on, things are changing.'"
    mc "Non seulement ce serait juste, mais ce serait aussi une façon de dire 'À partir de maintenant, les choses changent.'"

# game/scripts/c32/c32.rpy:1647
translate french c32s002_choices_0f886ed8:

    # ama "That's a good idea. And you can deny them the retroactive pay by saying that's a problem from the previous management."
    ama "C'est une bonne idée. Et tu peux leur refuser le paiement rétroactif en disant que c'est un problème de la direction précédente."

# game/scripts/c32/c32.rpy:1648
translate french c32s002_choices_276f2f87:

    # ama "That would create... about 6 points of unhappiness."
    ama "Ça créerait... environ 6 points de mécontentement."

# game/scripts/c32/c32.rpy:1649
translate french c32s002_choices_017c6753:

    # mc "We can't do that. It's the company that owes them. And now we are the company."
    mc "On ne peut pas faire ça. C'est l'entreprise qui leur doit ça. Et maintenant, l'entreprise, c'est nous."

# game/scripts/c32/c32.rpy:1650
translate french c32s002_choices_afe105b3:

    # mc "I was thinking that, if that's what we leave out, it should be temporary."
    mc "Je pensais que, si c'est ce qu'on laisse de côté, ça devrait être temporaire."

# game/scripts/c32/c32.rpy:1651
translate french c32s002_choices_48532c43:

    # mc "Like, we're not going to give a million to the A series, plus whatever to each of the C's, plus whatever the D's get..."
    mc "Genre, on ne va pas donner un million à la série A, plus je ne sais combien à chacun des C, plus ce que les D reçoivent..."
# game/scripts/c32/c32.rpy:1653
translate french c32s002_choices_01f03d7e:

    # ama "*Laugh* And don't forget about [eva] and me..."
    ama "*Rires* Et n'oublie pas [eva] et moi..."

# game/scripts/c32/c32.rpy:1654
translate french c32s002_choices_ae6332de:

    # mc "*Laugh* I haven't forgotten. You're in the 'Halfling Fingers' report."
    mc "*Rires* Je n'ai pas oublié. Vous êtes dans le rapport des 'Halfling Fingers'."

# game/scripts/c32/c32.rpy:1655
translate french c32s002_choices_2c712dc7:

    # mc "I mean not paying it all at once. Giving it as a salary supplement until we settle the accounts with each of them."
    mc "Je veux dire ne pas tout payer d'un coup. Le donner comme supplément de salaire jusqu'à ce qu'on règle les comptes avec chacun d'eux."

# game/scripts/c32/c32.rpy:1656
translate french c32s002_choices_6fa8024f:

    # mc "I'm sure I know what [dam] would spend the money on if he got it all at once."
    mc "Je suis sûr de savoir à quoi [dam] dépenserait l'argent s'il le recevait d'un coup."

# game/scripts/c32/c32.rpy:1658
translate french c32s002_choices_2ec02901:

    # ama "That's none of our business. But I think I like your idea."
    ama "Ça ne nous regarde pas. Mais je crois que j'aime bien ton idée."

# game/scripts/c32/c32.rpy:1659
translate french c32s002_choices_c406347e:

    # ama "When [eva] and I received the money from the shares, we went to [mar] and [nor] for guidance on how to spend it."
    ama "Quand [eva] et moi avons reçu l'argent des parts, on est allées voir [mar] et [nor] pour qu'elles nous conseillent sur comment le dépenser."

# game/scripts/c32/c32.rpy:1661
translate french c32s002_choices_369e6a74:

    # ama "The guys aren't going to have them here to ask."
    ama "Les gars ne les auront pas ici pour leur demander."

# game/scripts/c32/c32.rpy:1662
translate french c32s002_choices_a75a49e4:

    # ama "But if you link receiving the supplement to... I don't know... some kind of home economics lessons..."
    ama "Mais si tu lies la réception du supplément à... je ne sais pas... une sorte de cours d'économie domestique..."

# game/scripts/c32/c32.rpy:1663
translate french c32s002_choices_45946b11:

    # ama "I think that would lower the unhappiness from 6 to 2 points. They know they'll get it, even if not all at once."
    ama "Je pense que ça ferait baisser le mécontentement de 6 à 2 points. Ils savent qu'ils l'auront, même si ce n'est pas tout d'un coup."

# game/scripts/c32/c32.rpy:1664
translate french c32s002_choices_f5271567:

    # mc "Sounds like a good idea to me."
    mc "Ça me semble être une bonne idée."

# game/scripts/c32/c32.rpy:1666
translate french c32s002_choices_a0298ab4:

    # ama "Of course, you could just not pay their salary and give them the back pay."
    ama "Bien sûr, tu pourrais juste ne pas payer leur salaire et leur donner les arriérés."
# game/scripts/c32/c32.rpy:1667
translate french c32s002_choices_4bec6998:

    # ama "*Laugh* I'd almost bet many would leave the company and we'd save on their salaries."
    ama "*Rires* Je parierais presque que beaucoup quitteraient l'entreprise et qu'on économiserait sur leurs salaires."

# game/scripts/c32/c32.rpy:1668
translate french c32s002_choices_0e4a7c10:

    # mc "*Laugh* Would they leave the company before or after killing me?"
    mc "*Rires* Quitteraient-ils l'entreprise avant ou après m'avoir tué ?"

# game/scripts/c32/c32.rpy:1669
translate french c32s002_choices_806401e9:

    # mc "You said they'd jump at my throat, and pissing off 400 guys who are trained to kill doesn't sound like a good idea."
    mc "Tu as dit qu'ils me sauteraient à la gorge, et faire chier 400 mecs entraînés à tuer ne me semble pas être une bonne idée."

# game/scripts/c32/c32.rpy:1671
translate french c32s002_choices_23783ce4:

    # ama "*Laugh* [aar] and I would defend you."
    ama "*Rires* [aar] et moi on te défendrait."

# game/scripts/c32/c32.rpy:1672
translate french c32s002_choices_7b0c4e87:

    # mc "*Laugh* You two wouldn't get paid either."
    mc "*Rires* Vous ne seriez pas payés non plus tous les deux."

# game/scripts/c32/c32.rpy:1673
translate french c32s002_choices_31174db0:

    # ama "*Laugh* Then I'll correct myself. [car] would defend you."
    ama "*Rires* Alors je me corrige. [car] te défendrait."

# game/scripts/c32/c32.rpy:1674
translate french c32s002_choices_353e4ea1:

    # mc "*Laugh* Then I'm safe, as long as I don't leave the office."
    mc "*Rires* Alors je suis en sécurité, tant que je ne quitte pas le bureau."

# game/scripts/c32/c32.rpy:1675
translate french c32s002_choices_e2728bc7:

    # mc "No one would dare cross her."
    mc "Personne n'oserait se frotter à elle."

# game/scripts/c32/c32.rpy:1677
translate french c32s002_choices_f367cf65:

    # ama "Well, let's move on before we spout too much nonsense and [car] comes in to see what's wrong with us."
    ama "Bon, passons à autre chose avant de dire trop de conneries et que [car] n'entre pour voir ce qui cloche chez nous."

# game/scripts/c32/c32.rpy:1678
translate french c32s002_choices_40000b84:

    # ama "What's the next promise?"
    ama "C'est quoi la prochaine promesse ?"

# game/scripts/c32/c32.rpy:1679
translate french c32s002_choices_52599a5d:

    # mc "Contract terminations. The part about you being able to leave the company whenever you want."
    mc "Les ruptures de contrat. La partie où vous pouvez quitter l'entreprise quand vous le voulez."
# game/scripts/c32/c32.rpy:1681
translate french c32s002_choices_105c6197:

    # ama "Oof! I think if I had to rate the unhappiness that would cause... A 5 overall."
    ama "Ouf ! Je pense que si je devais évaluer le mécontentement que ça causerait... Un 5 au total."

# game/scripts/c32/c32.rpy:1682
translate french c32s002_choices_6a258d65:

    # mc "Only a 5?"
    mc "Seulement un 5 ?"

# game/scripts/c32/c32.rpy:1684
translate french c32s002_choices_41645337:

    # ama "There are some who will probably never want to leave. [aar], the C's, the D's..."
    ama "Il y en a qui ne voudront probablement jamais partir. [aar], les C, les D..."

# game/scripts/c32/c32.rpy:1685
translate french c32s002_choices_75c47816:

    # ama "They're too... old... to start making a living outside of here. And it's the same as with the prosthetics. For them, it would be a 1."
    ama "Ils sont trop... vieux... pour commencer à gagner leur vie en dehors d'ici. Et c'est pareil qu'avec les prothèses. Pour eux, ce serait un 1."

# game/scripts/c32/c32.rpy:1686
translate french c32s002_choices_59d5d9da:

    # ama "For the younger ones, it might be closer to a 10. If you deny them that, they'd still feel like slaves. I just averaged it out."
    ama "Pour les plus jeunes, ça pourrait être plus proche de 10. Si tu leur refuses ça, ils se sentiront toujours comme des esclaves. J'ai juste fait la moyenne."

# game/scripts/c32/c32.rpy:1687
translate french c32s002_choices_2d8b5842:

    # mc "I get it. A 5 then."
    mc "Je pige. Un 5 alors."

# game/scripts/c32/c32.rpy:1689
translate french c32s002_choices_dd541633:

    # ama "We're making progress. Next?"
    ama "On progresse. Ensuite ?"

# game/scripts/c32/c32.rpy:1690
translate french c32s002_choices_ae585396:

    # mc "Next would be the internal promotion system and applying for different positions."
    mc "Ensuite, il y aurait le système de promotion interne et les candidatures pour différents postes."

# game/scripts/c32/c32.rpy:1691
translate french c32s002_choices_22346e53:

    # mc "I thought that was going to be cheap, but when I explained it to [vin], he said it wasn't that easy."
    mc "Je pensais que ça ne coûterait pas cher, mais quand je l'ai expliqué à [vin], il a dit que ce n'était pas si facile."

# game/scripts/c32/c32.rpy:1692
translate french c32s002_choices_1ef53656:

    # mc "There would have to be a training program for the various positions. And he made the budget. He loves making budgets!"
    mc "Il faudrait un programme de formation pour les différents postes. Et il a fait le budget. Il adore faire des budgets !"

# game/scripts/c32/c32.rpy:1693
translate french c32s002_choices_c39aa0d6:

    # mc "We shouldn't accept that you ask for the accountant position, for example, if you don't have the training for it."
    mc "On ne devrait pas accepter que quelqu'un demande le poste de comptable, par exemple, s'il n'a pas la formation pour."
# game/scripts/c32/c32.rpy:1695
translate french c32s002_choices_8a2bcda6:

    # ama "It pisses me off to agree with [vin]."
    ama "Ça me fait chier d'être d'accord avec [vin]."

# game/scripts/c32/c32.rpy:1696
translate french c32s002_choices_0eae8b01:

    # ama "If you present it as a long-term thing, with training programs, you're going to make the younger ones very happy."
    ama "Si tu présentes ça comme un projet à long terme, avec des programmes de formation, tu vas rendre les plus jeunes très heureux."

# game/scripts/c32/c32.rpy:1697
translate french c32s002_choices_65bf15d4:

    # mc "That is, if it's not the idea we leave out..."
    mc "C'est-à-dire, si ce n'est pas l'idée qu'on laisse de côté..."

# game/scripts/c32/c32.rpy:1699
translate french c32s002_choices_6da0627d:

    # ama "Exactly. If you leave it out, it would anger a lot of people. A 7, I'd say. And it would have ramifications."
    ama "Exactement. Si tu la laisses de côté, ça mettrait beaucoup de gens en colère. Un 7, je dirais. Et ça aurait des répercussions."

# game/scripts/c32/c32.rpy:1700
translate french c32s002_choices_64c0c948:

    # ama "For example, for the Newport team. Instead of choosing volunteers, we should handpick them."
    ama "Par exemple, pour l'équipe de Newport. Au lieu de choisir des volontaires, on devrait les sélectionner sur le volet."

# game/scripts/c32/c32.rpy:1701
translate french c32s002_choices_43bd7f7f:

    # mc "But if there are enough volunteers, we could choose from among them."
    mc "Mais s'il y a assez de volontaires, on pourrait choisir parmi eux."

# game/scripts/c32/c32.rpy:1703
translate french c32s002_choices_0c5f88a8:

    # ama "You'd be sending a mixed message. 'To protect my family, yes, for the rest, no.'"
    ama "Tu enverrais un message contradictoire. 'Pour protéger ma famille, oui, pour le reste, non.'"

# game/scripts/c32/c32.rpy:1704
translate french c32s002_choices_32f8f8f4:

    # mc "I hadn't thought of it like that, but you're right. I wasn't looking at it from the kids' psychology."
    mc "Je n'y avais pas pensé comme ça, mais tu as raison. Je ne voyais pas ça du point de vue de la psychologie des gamins."

# game/scripts/c32/c32.rpy:1706
translate french c32s002_choices_870bc08c:

    # ama "Although you could implement the promotion system for things they are prepared for, like security."
    ama "Bien que tu puisses mettre en place le système de promotion pour les choses auxquelles ils sont préparés, comme la sécurité."

# game/scripts/c32/c32.rpy:1707
translate french c32s002_choices_bf533a1e:

    # ama "And leave the positions that need training for later. Imagine someone from the P Series who wants to be a doctor."
    ama "Et laisser les postes qui nécessitent une formation pour plus tard. Imagine quelqu'un de la Série P qui veut être médecin."

# game/scripts/c32/c32.rpy:1708
translate french c32s002_choices_83e8d4c5:

    # ama "They are five years old now, even if their bodies are eight. It gives them time to prepare for whatever they want to be."
    ama "Ils ont cinq ans maintenant, même si leurs corps en ont huit. Ça leur donne le temps de se préparer à ce qu'ils veulent être."
# game/scripts/c32/c32.rpy:1710
translate french c32s002_choices_e14d3140:

    # ama "If we do it like that, it would be a... possibly a 2?"
    ama "Si on fait comme ça, ce serait un... peut-être un 2 ?"

# game/scripts/c32/c32.rpy:1711
translate french c32s002_choices_62df770a:

    # ama "There might be someone who wants to be a CFO tomorrow, but the rest will understand."
    ama "Il y aura peut-être quelqu'un qui voudra être directeur financier demain, mais les autres comprendront."

# game/scripts/c32/c32.rpy:1712
translate french c32s002_choices_b5e5ca31:

    # mc "I like that idea."
    mc "J'aime cette idée."

# game/scripts/c32/c32.rpy:1713
translate french c32s002_choices_aa942b95:

    # mc "Besides, we can combine it with a normal education program for the little ones. I told you yesterday I don't want them near weapons."
    mc "En plus, on peut combiner ça avec un programme d'éducation normal pour les plus petits. Je t'ai dit hier que je ne voulais pas qu'ils s'approchent des armes."

# game/scripts/c32/c32.rpy:1715
translate french c32s002_choices_e2ffec41:

    # ama "We can create something similar to a rural school with our own teachers."
    ama "On peut créer quelque chose de similaire à une école rurale avec nos propres professeurs."

# game/scripts/c32/c32.rpy:1716
translate french c32s002_choices_b4c994f7:

    # ama "You can't send 20 Q-series kids to the same school."
    ama "Tu ne peux pas envoyer 20 gamins de la série Q dans la même école."

# game/scripts/c32/c32.rpy:1717
translate french c32s002_choices_878fcbb9:

    # mc "I know. I already have the budget for it, courtesy of [vin]. That option is already approved in my head."
    mc "Je sais. J'ai déjà le budget pour ça, gracieuseté de [vin]. Cette option est déjà approuvée dans ma tête."

# game/scripts/c32/c32.rpy:1718
translate french c32s002_choices_904513b8:

    # mc "And only the last one is left. Passports."
    mc "Et il ne reste que la dernière. Les passeports."

# game/scripts/c32/c32.rpy:1720
translate french c32s002_choices_78fa534d:

    # ama "It makes no sense for you to let them terminate the contract and not give them passports. Nor vice versa."
    ama "Ça n'a aucun sens que tu les laisses résilier le contrat et que tu ne leur donnes pas de passeports. Ni l'inverse."

# game/scripts/c32/c32.rpy:1721
translate french c32s002_choices_8ef72c39:

    # mc "I know. They are two choices that are linked together. One without the other would be useless."
    mc "Je sais. Ce sont deux choix qui sont liés. L'un sans l'autre serait inutile."

# game/scripts/c32/c32.rpy:1722
translate french c32s002_choices_378afdc8:

    # mc "But, since we're ranking them by unpopularity, how many points would you give this if we left it out?"
    mc "Mais, puisqu'on les classe par impopularité, combien de points tu donnerais à ça si on le laissait de côté ?"
# game/scripts/c32/c32.rpy:1724
translate french c32s002_choices_4aed6620:

    # ama "It's complicated. You'd condemn anyone who wanted to leave the company to a life as a pariah."
    ama "C'est compliqué. Tu condamnerais quiconque voudrait quitter l'entreprise à une vie de paria."

# game/scripts/c32/c32.rpy:1725
translate french c32s002_choices_e4568a61:

    # ama "Although it would be a way to make them not want to leave."
    ama "Bien que ce serait un moyen de leur faire passer l'envie de partir."

# game/scripts/c32/c32.rpy:1726
translate french c32s002_choices_862b697e:

    # mc "That's playing dirty, [ama]. I don't want to be like Daniels or Richards in that regard."
    mc "C'est un coup bas, [ama]. Je ne veux pas être comme Daniels ou Richards sur ce point."

# game/scripts/c32/c32.rpy:1728
translate french c32s002_choices_998e98ee:

    # ama "I know, I was just thinking out loud."
    ama "Je sais, je pensais juste à voix haute."

# game/scripts/c32/c32.rpy:1729
translate french c32s002_choices_8c2ea8cb:

    # ama "I think a 6."
    ama "Je dirais un 6."

# game/scripts/c32/c32.rpy:1730
