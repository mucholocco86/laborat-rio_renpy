# game/scripts/c32/c32.rpy:3137
translate french c32s005_MarSamThreesome_d0f7ffd8:

    # mc "But I knew you wouldn't be able to decide who was going to sleep here today. I wouldn't have been able to either."
    mc "Mais je savais que vous ne pourriez pas décider qui allait dormir ici aujourd'hui. Je n'en aurais pas été capable non plus."

# game/scripts/c32/c32.rpy:3138
translate french c32s005_MarSamThreesome_a2574667:

    # mc "*Laugh* And, seeing how you're both dressed, I don't think either of you has much intention of sleeping."
    mc "*Rires* Et, vu comment vous êtes habillées toutes les deux, je ne pense pas qu'aucune de vous n'ait vraiment l'intention de dormir."

