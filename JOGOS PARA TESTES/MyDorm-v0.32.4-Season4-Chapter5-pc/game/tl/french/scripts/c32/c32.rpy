# game/scripts/c32/c32.rpy:1863
translate french c32s003_EmmPickup_a5004f25:

    # mc "Has [sol] already moved out? I thought he'd try to drag it out as long as possible..."
    mc "[sol] a déjà déménagé ? Je pensais qu'il essaierait de faire traîner ça le plus longtemps possible..."

# game/scripts/c32/c32.rpy:1865
translate french c32s003_EmmPickup_4fc985b8:

    # emm "Yeah, he left days ago. But none of them wanted to move out until they absolutely had to."
    emm "Ouais, il est parti il y a plusieurs jours. Mais aucune d'elles ne voulait déménager avant d'y être absolument obligée."

# game/scripts/c32/c32.rpy:1866
translate french c32s003_EmmPickup_e9b0a8a5:

    # emm "Me neither. I'm going to have to pick them up every day..."
    emm "Moi non plus. Je vais devoir aller les chercher tous les jours..."
# game/scripts/c32/c32.rpy:1867
translate french c32s003_EmmPickup_0706dc4b:

    # mc "*Laugh* Like you said, it's a chance to spend more time with them."
    mc "*Rires* Comme tu l'as dit, c'est une occasion de passer plus de temps avec elles."

# game/scripts/c32/c32.rpy:1868
translate french c32s003_EmmPickup_29d09da0:

    # mc "Though I'm sure [eil] would rather bike home than get in that pink truck."
    mc "Même si je suis sûr qu'[eil] préférerait rentrer à vélo plutôt que de monter dans ce camion rose."

# game/scripts/c32/c32.rpy:1870
translate french c32s003_EmmPickup_1d1ec004:

    # emm "Want to know a secret?"
    emm "Tu veux connaître un secret ?"

# game/scripts/c32/c32.rpy:1871
translate french c32s003_EmmPickup_0d25cee0:

    # mc "Yeah. And I hope it's not that you convinced [eil] to wear pink permanently."
    mc "Ouais. Et j'espère que ce n'est pas que tu as convaincu [eil] de porter du rose en permanence."

# game/scripts/c32/c32.rpy:1873
translate french c32s003_EmmPickup_bb5eff42:

    # emm "*Laugh* I haven't tried that yet."
    emm "*Rires* Je n'ai pas encore essayé ça."

# game/scripts/c32/c32.rpy:1874
translate french c32s003_EmmPickup_d1548faf:

    # emm "But you just gave me an idea. If I swap her clothes for mine, she'll have no choice but to wear pink."
    emm "Mais tu viens de me donner une idée. Si j'échange ses vêtements avec les miens, elle n'aura pas d'autre choix que de porter du rose."

# game/scripts/c32/c32.rpy:1875
translate french c32s003_EmmPickup_18831dd5:

    # mc "I think she'd rather walk down the street naked. She hates pink almost as much as I do."
    mc "Je pense qu'elle préférerait marcher nue dans la rue. Elle déteste le rose presque autant que moi."

# game/scripts/c32/c32.rpy:1876
translate french c32s003_EmmPickup_b4f659a4:

    # mc "But you were going to tell me a secret."
    mc "Mais tu allais me dire un secret."

# game/scripts/c32/c32.rpy:1878
translate french c32s003_EmmPickup_a4235ba2:

    # emm "I did the truck thing with PaintStore. Just to see if you'd bother calling me."
    emm "J'ai fait le coup du camion avec PaintStore. Juste pour voir si tu prendrais la peine de m'appeler."

# game/scripts/c32/c32.rpy:1879
translate french c32s003_EmmPickup_f03ec283:

    # mc "It's no bother, but finding time is hard."
    mc "Ça ne me dérange pas, mais c'est dur de trouver le temps."

# game/scripts/c32/c32.rpy:1880
translate french c32s003_EmmPickup_9a90979e:

    # mc "Although I think I'll forget to call you for the next few days for being so mean to me."
    mc "Bien que je pense que je vais oublier de t'appeler pendant les prochains jours pour avoir été si méchante avec moi."
# game/scripts/c32/c32.rpy:1882
translate french c32s003_EmmPickup_e517e361:

    # emm "*Laugh* You wouldn't dare!"
    emm "*Rires* Tu n'oserais pas !"

# game/scripts/c32/c32.rpy:1883
translate french c32s003_EmmPickup_75581794:

    # mc "*Laugh* Try me."
    mc "*Rires* Essaie pour voir."

# game/scripts/c32/c32.rpy:1884
translate french c32s003_EmmPickup_1fc23c24:

    # emm "*Laugh* If you do, I'll paint the truck for real."
    emm "*Rires* Si tu fais ça, je peindrai le pick-up pour de vrai."

# game/scripts/c32/c32.rpy:1885
translate french c32s003_EmmPickup_e3f7d95e:

    # mc "*Laugh* If you do, I'll tell Mom to take the keys from you and give them to [eri]."
    mc "*Rires* Si tu fais ça, je dirai à Maman de te prendre les clés et de les donner à [eri]."

# game/scripts/c32/c32.rpy:1887
translate french c32s003_EmmPickup_4c362ceb:

    # emm "*Laugh* Okay. No painting the truck. [eri] would return it to its boring black color."
    emm "*Rires* D'accord. Pas de peinture sur le pick-up. [eri] lui redonnerait sa couleur noire ennuyeuse."

# game/scripts/c32/c32.rpy:1888
translate french c32s003_EmmPickup_4c7ddfe8:

    # mc "[eri] has good taste."
    mc "[eri] a bon goût."

# game/scripts/c32/c32.rpy:1891
translate french c32s003_EmmPickup_159a10ee:

    # emm "So do I, I married you."
    emm "Moi aussi, je t'ai épousé."

# game/scripts/c32/c32.rpy:1893
translate french c32s003_EmmPickup_adc3d004:

    # emm "So do I, even if you don't share it."
    emm "Moi aussi, même si tu ne le partages pas."

# game/scripts/c32/c32.rpy:1894
translate french c32s003_EmmPickup_5029cea1:

    # mc "I'm not going to argue about that."
    mc "Je ne vais pas discuter là-dessus."

# game/scripts/c32/c32.rpy:1895
translate french c32s003_EmmPickup_e1f8ba16:

    # mc "By the way, I thought we agreed on no lies, right?"
    mc "Au fait, on avait dit pas de mensonges, non ?"

# game/scripts/c32/c32.rpy:1897
translate french c32s003_EmmPickup_c5901631:

    # emm "*Laugh* What did I lie about?"
    emm "*Rires* Sur quoi j'ai menti ?"
# game/scripts/c32/c32.rpy:1898
translate french c32s003_EmmPickup_1a689a82:

    # mc "You told me you just got out of the paint shop. I know it was a joke, but..."
    mc "Tu m'as dit que tu venais de sortir de l'atelier de peinture. Je sais que c'était une blague, mais..."

# game/scripts/c32/c32.rpy:1899
translate french c32s003_EmmPickup_45386833:

    # emm "*Laugh* Check the message. It says 'the paint store', not 'the paint shop'. Paint Store Pro."
    emm "*Rire* Vérifie le message. Ça dit 'le magasin de peinture', pas 'l'atelier de peinture'. Paint Store Pro."

# game/scripts/c32/c32.rpy:1900
translate french c32s003_EmmPickup_d2305e57:

    # emm "It's the app I used to change the color. Technically, I didn't lie. You just understood what you wanted to understand."
    emm "C'est l'application que j'ai utilisée pour changer la couleur. Techniquement, je n'ai pas menti. Tu as juste compris ce que tu voulais comprendre."

# game/scripts/c32/c32.rpy:1901
translate french c32s003_EmmPickup_0f90d343:

    # mc "*Laugh* I think I've created a monster!"
    mc "*Rire* Je crois que j'ai créé un monstre !"

# game/scripts/c32/c32.rpy:1903
translate french c32s003_EmmPickup_35b5bcaa:

    # "You spend a while chatting as she catches you up on all the news from home."
    "Tu passes un moment à discuter pendant qu'elle te met au courant de toutes les nouvelles de la maison."

# game/scripts/c32/c32.rpy:1904
translate french c32s003_EmmPickup_28d0257f:

    # "Except for the move on Sunday, you already knew everything, but you love hearing your sister talk."
    "À l'exception du déménagement de dimanche, tu savais déjà tout, mais tu adores écouter ta sœur parler."

# game/scripts/c32/c32.rpy:1906
translate french c32s003_EmmPickup_1c8ef41c:

    # "Hearing your wife laugh."
    "Entendre ta femme rire."

# game/scripts/c32/c32.rpy:1907
translate french c32s003_EmmPickup_0859dc54:

    # "But a call from [car] to let you know that [aar] has arrived for your pending meeting interrupts your conversation."
    "Mais un appel de [car] pour te prévenir que [aar] est arrivé pour ta réunion prévue interrompt votre conversation."

# game/scripts/c32/c32.rpy:1909
translate french c32s003_EmmPickup_60fa06bd:

    # mc "I have to go now."
    mc "Je dois y aller maintenant."

# game/scripts/c32/c32.rpy:1910
translate french c32s003_EmmPickup_50d6d1cd:

    # emm "*Laugh* I haven't even met this [car] yet, but I already don't like her."
    emm "*Rire* Je n'ai même pas encore rencontré cette [car], mais je ne l'aime déjà pas."

# game/scripts/c32/c32.rpy:1911
translate french c32s003_EmmPickup_b5bc54b1:

    # emm "*Laugh* Can I fire her? I'm a shareholder too... Just kidding..."
    emm "*Rire* Je peux la virer ? Je suis aussi actionnaire... Je plaisante..."
# game/scripts/c32/c32.rpy:1912
translate french c32s003_EmmPickup_dadd86d1:

    # mc "Better not fire her. She's super efficient. If I didn't have her, I'd have even less time to call you."
    mc "Vaut mieux pas la virer. Elle est super efficace. Si je ne l'avais pas, j'aurais encore moins de temps pour t'appeler."

# game/scripts/c32/c32.rpy:1914
translate french c32s003_EmmPickup_d023f58d:

    # emm "Then she'll keep her job... for now. Tell [aar] he can come in for that boring meeting."
    emm "Alors elle gardera son boulot... pour l'instant. Dis à [aar] qu'il peut entrer pour cette réunion chiante."

# game/scripts/c32/c32.rpy:1915
translate french c32s003_EmmPickup_7aef4169:

    # emm "I love you. Don't take so long to call me."
    emm "Je t'aime. Ne mets pas si longtemps à m'appeler."

# game/scripts/c32/c32.rpy:1916
translate french c32s003_EmmPickup_9b6bc7b6:

    # mc "I love you too. I'll try not to."
    mc "Je t'aime aussi. J'essaierai."

# game/scripts/c32/c32.rpy:1918
translate french c32s003_EmmPickup_143f3bdf:

    # mc "Come in, [aar]."
    mc "Entre, [aar]."

# game/scripts/c32/c32.rpy:1924
translate french c32s003_JamPics_b642f630:

    # centered "{size=+20}{b}DAY 47 – SATURDAY{/b}{/size}"
    centered "{size=+20}{b}JOUR 47 – SAMEDI{/b}{/size}"

# game/scripts/c32/c32.rpy:1926
translate french c32s003_JamPics_b6bfd682:

    # "The next day, at home, after a day of meetings..."
    "Le lendemain, à la maison, après une journée de réunions..."

# game/scripts/c32/c32.rpy:1927
translate french c32s003_JamPics_da4e93b4:

    # ama "I stopped by to see [gav] today, he seems really excited about the arm being turned on tomorrow."
    ama "Je suis passée voir [gav] aujourd'hui, il a l'air vraiment excité à l'idée que le bras soit activé demain."

# game/scripts/c32/c32.rpy:1928
translate french c32s003_JamPics_15682a8e:

    # bet "He's recovering better than I expected."
    bet "Il récupère mieux que je ne l'espérais."

# game/scripts/c32/c32.rpy:1929
translate french c32s003_JamPics_535588ed:

    # bet "One of the surgeons told me it might have something to do with the accelerated aging of the clones."
    bet "Un des chirurgiens m'a dit que ça pourrait avoir un rapport avec le vieillissement accéléré des clones."

# game/scripts/c32/c32.rpy:1930
translate french c32s003_JamPics_ff9bbd2a:

    # mc "Is that possible?"
    mc "C'est possible ça ?"
# game/scripts/c32/c32.rpy:1932
translate french c32s003_JamPics_5d108e28:

    # bet "Not only is it possible, but it's highly likely that it's having a positive influence."
    bet "Non seulement c'est possible, mais il est très probable que ça ait une influence positive."

# game/scripts/c32/c32.rpy:1933
translate french c32s003_JamPics_723e38ce:

    # bet "I was surprised by the condition of the stump when I first examined it."
    bet "J'ai été surprise par l'état du moignon quand je l'ai examiné pour la première fois."

# game/scripts/c32/c32.rpy:1934
translate french c32s003_JamPics_f5d74ae8:

    # bet "It didn't look like the result of an amputation that had taken place less than a month ago. The healing was advanced."
    bet "Ça ne ressemblait pas au résultat d'une amputation qui avait eu lieu il y a moins d'un mois. La cicatrisation était avancée."

# game/scripts/c32/c32.rpy:1935
translate french c32s003_JamPics_efd02cbc:

    # mc "That's incredible!"
    mc "C'est incroyable !"

# game/scripts/c32/c32.rpy:1937
translate french c32s003_JamPics_01018e67:

    # ama "If male clones age faster, I guess it makes sense that they heal faster too."
    ama "Si les clones masculins vieillissent plus vite, j'imagine que c'est logique qu'ils guérissent plus vite aussi."

# game/scripts/c32/c32.rpy:1938
translate french c32s003_JamPics_3659106d:

    # bet "I've spent the last few days looking at surgery reports, and it seems to be the case almost always."
    bet "J'ai passé ces derniers jours à examiner des rapports chirurgicaux, et il semble que ce soit presque toujours le cas."

# game/scripts/c32/c32.rpy:1939
translate french c32s003_JamPics_d1859b2d:

    # mc "Almost always?"
    mc "Presque toujours ?"

# game/scripts/c32/c32.rpy:1941
translate french c32s003_JamPics_a95f9e48:

    # bet "Recovery times for a wound are usually faster in muscle and bone tissue."
    bet "Les temps de guérison d'une blessure sont généralement plus rapides dans les tissus musculaires et osseux."

# game/scripts/c32/c32.rpy:1942
translate french c32s003_JamPics_30646272:

    # bet "But not with internal organs. A wound to a lung or the liver tends to heal at the same rate as in..."
    bet "Mais pas pour les organes internes. Une blessure au poumon ou au foie a tendance à guérir au même rythme que chez..."

# game/scripts/c32/c32.rpy:1943
translate french c32s003_JamPics_43dc707d:

    # mc "Don't say 'a normal person'."
    mc "Ne dis pas 'une personne normale'."

# game/scripts/c32/c32.rpy:1945
translate french c32s003_JamPics_8846a775:

    # bet "*Laugh* I was going to say 'a person with standard aging.'"
    bet "*Rires* J'allais dire 'une personne avec un vieillissement standard'."
# game/scripts/c32/c32.rpy:1946
translate french c32s003_JamPics_86f45a26:

    # mc "We need to find a more appropriate term. And a shorter one."
    mc "On doit trouver un terme plus approprié. Et plus court."

# game/scripts/c32/c32.rpy:1948
translate french c32s003_JamPics_9d448dc8:

    # bet "What I meant is that I have a lot more data on muscle and bone injuries than on internal organs."
    bet "Ce que je voulais dire, c'est que j'ai beaucoup plus de données sur les blessures musculaires et osseuses que sur les organes internes."

# game/scripts/c32/c32.rpy:1949
translate french c32s003_JamPics_97efaa43:

    # bet "I don't know if it's an issue with the small sample size or if that's what is actually happening."
    bet "Je ne sais pas si c'est un problème lié à la petite taille de l'échantillon ou si c'est ce qui se passe réellement."

# game/scripts/c32/c32.rpy:1950
translate french c32s003_JamPics_ceb87502:

    # mc "Have you tried talking to [mael] about it?"
    mc "Tu as essayé d'en parler à [mael] ?"

# game/scripts/c32/c32.rpy:1952
translate french c32s003_JamPics_d7ed914d:

    # bet "Not yet. I'll probably do it after powering up [gav]'s arm."
    bet "Pas encore. Je le ferai probablement après avoir renforcé le bras de [gav]."

# game/scripts/c32/c32.rpy:1953
translate french c32s003_JamPics_49e84a7b:

    # bet "That will provide me with more data. The surgery combines muscle tissue, bone, and nerve tissue."
    bet "Ça me fournira plus de données. L'opération combine du tissu musculaire, de l'os et du tissu nerveux."

# game/scripts/c32/c32.rpy:1954
translate french c32s003_JamPics_f326d78f:

    # mc "I get it. If you see how each of them recovers..."
    mc "Je vois. Si tu vois comment chacun d'eux récupère..."

# game/scripts/c32/c32.rpy:1956
translate french c32s003_JamPics_6d556482:

    # ama "Could that effect be reproduced?"
    ama "Cet effet pourrait-il être reproduit ?"

# game/scripts/c32/c32.rpy:1957
translate french c32s003_JamPics_64733fed:

    # ama "I can imagine [flo] selling it to elite athletes to heal their injuries faster."
    ama "J'imagine bien [flo] vendre ça à des athlètes de haut niveau pour guérir leurs blessures plus vite."

# game/scripts/c32/c32.rpy:1958
translate french c32s003_JamPics_a7de8f72:

    # mc "I hadn't thought of that... Is it possible?"
    mc "Je n'y avais pas pensé... C'est possible ?"

# game/scripts/c32/c32.rpy:1960
translate french c32s003_JamPics_c9b6b3cf:

    # bet "I highly doubt it can be reproduced without accelerating aging. It's something in the boys' genes."
    bet "Je doute fort que ça puisse être reproduit sans accélérer le vieillissement. C'est quelque chose dans les gènes des garçons."
# game/scripts/c32/c32.rpy:1961
translate french c32s003_JamPics_50599d7f:

    # bet "And I don't think anyone would accept it if you tell them they'll recover in three months from an injury that would normally take six."
    bet "Et je ne pense pas que quiconque l'accepterait si on leur disait qu'ils se remettront en trois mois d'une blessure qui en prendrait normalement six."

# game/scripts/c32/c32.rpy:1962
translate french c32s003_JamPics_75e340f7:

    # bet "But that they'll lose two months of their life in the process. I'm just making up the numbers, before you ask."
    bet "Mais qu'ils perdront deux mois de leur vie dans le processus. J'invente juste les chiffres, avant que tu ne demandes."

# game/scripts/c32/c32.rpy:1963
translate french c32s003_JamPics_f4640ff6:

    # mc "There are some crazy athletes out there who would want to squeeze the most out of their time in the elite."
    mc "Il y a des athlètes fous qui voudraient tirer le maximum de leur temps dans l'élite."

# game/scripts/c32/c32.rpy:1964
translate french c32s003_JamPics_652471e8:

    # mc "But I don't think I'd feel comfortable if [deb.nick] used it..."
    mc "Mais je ne pense pas que je me sentirais à l'aise si [deb.nick] l'utilisait..."

# game/scripts/c32/c32.rpy:1966
translate french c32s003_JamPics_f7840f1e:

    # ama "It would be her decision. [deb.nick] is a smart girl and I doubt she'd agree to pay that price."
    ama "Ce serait sa décision. [deb.nick] est une fille intelligente et je doute qu'elle accepterait de payer ce prix."

# game/scripts/c32/c32.rpy:1967
translate french c32s003_JamPics_c53f565b:

    # ama "But while [bet] was talking, my head was spinning..."
    ama "Mais pendant que [bet] parlait, ma tête tournait..."

# game/scripts/c32/c32.rpy:1968
translate french c32s003_JamPics_4e4b056d:

    # mc "Surprise us."
    mc "Surprends-nous."

# game/scripts/c32/c32.rpy:1970
translate french c32s003_JamPics_1b1104d8:

    # ama "It seems healing works differently depending on the organs."
    ama "Il semble que la guérison fonctionne différemment selon les organes."

# game/scripts/c32/c32.rpy:1971
translate french c32s003_JamPics_79e44b54:

    # ama "Imagine if we could isolate the component that makes skin heal faster."
    ama "Imaginez si nous pouvions isoler le composant qui fait guérir la peau plus vite."

# game/scripts/c32/c32.rpy:1972
translate french c32s003_JamPics_efa56c08:

    # ama "It would age faster, but wounds would close sooner, preventing infections. And having an older skin isn't going to kill anyone."
    ama "Elle vieillirait plus vite, mais les blessures se refermeraient plus tôt, évitant les infections. Et avoir une peau plus vieille ne va tuer personne."

## game/scripts/c32/c32.rpy:1974
translate french c32s003_JamPics_6b6bb70a:

    # bet "*Laugh* I'm proof of that. I'm still alive."
    bet "*Rire* J'en suis la preuve. Je suis toujours en vie."
# game/scripts/c32/c32.rpy:1975
translate french c32s003_JamPics_a556eab7:

    # bet "But you're right. If the healing of independent organs, like the skin, could be accelerated, it would be an incredible breakthrough."
    bet "Mais tu as raison. Si la guérison d'organes indépendants, comme la peau, pouvait être accélérée, ce serait une avancée incroyable."

# game/scripts/c32/c32.rpy:1977
translate french c32s003_JamPics_31a133aa:

    # bet "For a moment I thought about some places in Africa where there are barely any antibiotics."
    bet "Pendant un instant, j'ai pensé à certains endroits en Afrique où il n'y a presque pas d'antibiotiques."

# game/scripts/c32/c32.rpy:1978
translate french c32s003_JamPics_2f16d33d:

    # bet "But it would be difficult for that kind of technology to reach places where a simple antibiotic can't."
    bet "Mais il serait difficile pour ce genre de technologie d'atteindre des endroits où un simple antibiotique ne le peut pas."

# game/scripts/c32/c32.rpy:1979
translate french c32s003_JamPics_5604c904:

    # mc "Do you think I should talk to [mael] about it? I think it could be a good direction for the research."
    mc "Vous pensez que je devrais en parler à [mael] ? Je pense que ça pourrait être une bonne direction pour la recherche."

# game/scripts/c32/c32.rpy:1981
translate french c32s003_JamPics_26105e2f:

    # bet "Absolutely." (multiple=2)
    bet "Absolument." (multiple=2)

# game/scripts/c32/c32.rpy:1982
translate french c32s003_JamPics_91516e54:

    # ama "Yes." (multiple=2)
    ama "Oui." (multiple=2)

# game/scripts/c32/c32.rpy:1983
translate french c32s003_JamPics_0677ebd6:

    # mc "I didn't expect any other answer... I have a meeting with him next week. I'll mention it to him."
    mc "Je ne m'attendais pas à une autre réponse... J'ai une réunion avec lui la semaine prochaine. Je lui en toucherai un mot."

# game/scripts/c32/c32.rpy:1984
translate french c32s003_JamPics_b2085af1:

    # mc "I guess that doesn't apply to female clones, right?"
    mc "Je suppose que ça ne s'applique pas aux clones féminins, pas vrai ?"

# game/scripts/c32/c32.rpy:1986
translate french c32s003_JamPics_f33a8b2e:

    # bet "They don't have accelerated aging, so I doubt they heal faster."
    bet "Elles n'ont pas de vieillissement accéléré, donc je doute qu'elles guérissent plus vite."

# game/scripts/c32/c32.rpy:1988
translate french c32s003_JamPics_24a51902:

    # ama "We've never noticed anything. But we didn't have anything to compare it with either."
    ama "Nous n'avons jamais rien remarqué. Mais nous n'avions rien pour comparer non plus."

# game/scripts/c32/c32.rpy:1990
translate french c32s003_JamPics_1c135af5:

    # ama "I guess you would have noticed something weird with [eri], [dap], or [emm]. Although it's something that can go unnoticed."
    ama "Je suppose que tu aurais remarqué quelque chose de bizarre avec [eri], [dap] ou [emm]. Bien que ce soit le genre de chose qui puisse passer inaperçu."
# game/scripts/c32/c32.rpy:1991
translate french c32s003_JamPics_7d334e1e:

    # mc "You guys are right."
    mc "Vous avez raison."

# game/scripts/c32/c32.rpy:1993
translate french c32s003_JamPics_aed981fe:

    # bet "*Laugh* Should we buy a t-shirt that says that?"
    bet "*Rires* On devrait acheter un t-shirt qui dit ça ?"

# game/scripts/c32/c32.rpy:1994
translate french c32s003_JamPics_784adad9:

    # ama "*Laugh* It would be funny if we had the t-shirt and [mc] didn't."
    ama "*Rires* Ce serait marrant si on avait le t-shirt et pas [mc]."

# game/scripts/c32/c32.rpy:1995
translate french c32s003_JamPics_3ac578d5:

    # mc "*Laugh* I think [geo], from IT, beat us to it with the t-shirt thing."
    mc "*Rires* Je crois que [geo], de l'informatique, nous a devancés avec cette histoire de t-shirt."

# game/scripts/c32/c32.rpy:1997
translate french c32s003_JamPics_d6424525:

    # bet "*Laugh* He has... questionable taste in clothing."
    bet "*Rires* Il a... des goûts vestimentaires douteux."

# game/scripts/c32/c32.rpy:1998
translate french c32s003_JamPics_1846047d:

    # ama "I had never talked to him before, but he's as funny as his t-shirts."
    ama "Je ne lui avais jamais parlé avant, mais il est aussi drôle que ses t-shirts."

# game/scripts/c32/c32.rpy:1999
translate french c32s003_JamPics_1ff74519:

    # ama "Today's shirt said 'If I'm eating, I'm not Tech Support. Open a ticket.'"
    ama "Celui d'aujourd'hui disait : 'Si je mange, je ne suis pas le support technique. Ouvrez un ticket.'"

# game/scripts/c32/c32.rpy:2000
translate french c32s003_JamPics_1d8cc47c:

    # mc "Speaking of IT..."
    mc "En parlant d'informatique..."

# game/scripts/c32/c32.rpy:2001
translate french c32s003_JamPics_ecb12898:

    # mc "[ama], could you lend me the photos of the girls tomorrow?"
    mc "[ama], tu pourrais me prêter les photos des filles demain ?"

# game/scripts/c32/c32.rpy:2003
translate french c32s003_JamPics_7b15896d:

    # ama "What? Why?"
    ama "Quoi ? Pourquoi ?"

# game/scripts/c32/c32.rpy:2004
translate french c32s003_JamPics_7d098f3b:

    # mc "They're the only ones you have and I wouldn't want them to get damaged any further."
    mc "Ce sont les seules que tu as et je ne voudrais pas qu'elles s'abîment davantage."
# game/scripts/c32/c32.rpy:2005
translate french c32s003_JamPics_94d60f6f:

    # mc "They're pretty faded. A polaroid isn't the best way to preserve something long-term."
    mc "Elles sont assez effacées. Un polaroïd n'est pas le meilleur moyen de conserver quelque chose à long terme."

# game/scripts/c32/c32.rpy:2006
translate french c32s003_JamPics_5256d2cf:

    # mc "I thought about digitizing them and sending them to Jamaal to see if he can fix them up a bit. Make the colors more vibrant and stuff."
    mc "J'ai pensé à les numériser et à les envoyer à Jamaal pour voir s'il peut les retoucher un peu. Rendre les couleurs plus vives et tout."

# game/scripts/c32/c32.rpy:2007
translate french c32s003_JamPics_b6d7f8e8:

    # mc "Only if you want to, of course."
    mc "Seulement si tu le veux, bien sûr."

# game/scripts/c32/c32.rpy:2009
translate french c32s003_JamPics_aa9da374:

    # ama "That would be fantastic! I don't know how I didn't think of that before."
    ama "Ce serait fantastique ! Je ne sais pas comment je n'y ai pas pensé avant."

# game/scripts/c32/c32.rpy:2011
translate french c32s003_JamPics_bb707e10:

    # bet "It makes sense that you didn't think of it. In your head, those photos are tied to the format they're in."
    bet "C'est logique que tu n'y aies pas pensé. Dans ta tête, ces photos sont liées au format dans lequel elles sont."

# game/scripts/c32/c32.rpy:2012
translate french c32s003_JamPics_82a599b1:

    # bet "And, if you're like me with this stuff, you wouldn't know where to start to improve those photos."
    bet "Et, si tu es comme moi avec ces trucs, tu ne saurais pas par où commencer pour améliorer ces photos."

# game/scripts/c32/c32.rpy:2013
translate french c32s003_JamPics_6fe9ad0f:

    # mc "I'm no PaintStore genius either, but [emm]'s joke yesterday gave me the idea."
    mc "Je ne suis pas non plus un génie de PaintStore, mais la blague d'[emm] hier m'a donné l'idée."

# game/scripts/c32/c32.rpy:2015
translate french c32s003_JamPics_ac814da3:

    # ama "What joke?"
    ama "Quelle blague ?"

# game/scripts/c32/c32.rpy:2017
translate french c32s003_JamPics_bd677ef2:

    # "You explain [emm]'s stunt with your truck."
    "Tu expliques le coup d'[emm] avec ton pick-up."

# game/scripts/c32/c32.rpy:2018
translate french c32s003_JamPics_79664ecc:

    # "[ama] is surprised by how little you call home. She makes twelve or thirteen calls a day."
    "[ama] est surprise de voir à quel point tu appelles peu à la maison. Elle passe douze ou treize appels par jour."

# game/scripts/c32/c32.rpy:2019
translate french c32s003_JamPics_8a2afdc4:

    # "Sometimes talking to several of the girls at once."
    "Parfois en parlant à plusieurs filles en même temps."
# game/scripts/c32/c32.rpy:2020
translate french c32s003_JamPics_3ce79dc8:

    # "You start to feel bad because work is absorbing you too much."
    "Tu commences à te sentir mal parce que le travail t'absorbe trop."

# game/scripts/c32/c32.rpy:2024
translate french c32s003_GavArm_10c8f21b:

    # centered "{size=+20}{b}DAY 48 – SUNDAY{/b}{/size}"
    centered "{size=+20}{b}JOUR 48 – DIMANCHE{/b}{/size}"

# game/scripts/c32/c32.rpy:2026
translate french c32s003_GavArm_7350183e:

    # bet "Are you ready?"
    bet "Tu es prêt ?"

# game/scripts/c32/c32.rpy:2027
translate french c32s003_GavArm_62b2a051:

    # gav "I'm nervous."
    gav "Je suis nerveux."

# game/scripts/c32/c32.rpy:2028
translate french c32s003_GavArm_b724a123:

    # mc "It's normal that you are."
    mc "C'est normal que tu le sois."

# game/scripts/c32/c32.rpy:2030
translate french c32s003_GavArm_72da5f61:

    # gav "I'm also anxious. When Ms. [bet] told me I was progressing well, I thought we could turn it on sooner."
    gav "Je suis aussi anxieux. Quand Mme [bet] m'a dit que je progressais bien, je pensais qu'on pourrait l'allumer plus tôt."

# game/scripts/c32/c32.rpy:2031
translate french c32s003_GavArm_f9bd5a44:

    # bet "I preferred to be cautious. You've healed better than I expected in a week, but we don't have all the data yet."
    bet "J'ai préféré être prudente. Tu as mieux guéri que ce que j'espérais en une semaine, mais nous n'avons pas encore toutes les données."

# game/scripts/c32/c32.rpy:2032
translate french c32s003_GavArm_90a13bad:

    # bet "Let's take off the sling. Try to keep your shoulder still until [cal] arrives."
    bet "Enlevons l'écharpe. Essaie de garder ton épaule immobile jusqu'à ce que [cal] arrive."

# game/scripts/c32/c32.rpy:2034
translate french c32s003_GavArm_85c4b47d:

    # gav "I understand you wanted to be cautious, but I hate being locked up in here."
    gav "Je comprends que vous vouliez être prudente, mais je déteste être enfermé ici."

# game/scripts/c32/c32.rpy:2035
translate french c32s003_GavArm_3a04f4da:

    # bet "Don't worry. As soon as [cal] arrives, we'll turn it on. He should be here in a few minutes."
    bet "Ne t'inquiète pas. Dès que [cal] arrivera, on l'allumera. Il devrait être là dans quelques minutes."

# game/scripts/c32/c32.rpy:2036
translate french c32s003_GavArm_259c2215:

    # mc "From what he told me, he was going to check some final parameters before powering it up."
    mc "D'après ce qu'il m'a dit, il allait vérifier quelques derniers paramètres avant de le mettre en marche."
# game/scripts/c32/c32.rpy:2037
translate french c32s003_GavArm_2c240e5b:

    # mc "Keep in mind that it's important to him too."
    mc "Garde à l'esprit que c'est important pour lui aussi."

# game/scripts/c32/c32.rpy:2039
translate french c32s003_GavArm_ed482c82:

    # gav "I know, and I don't want to sound ungrateful, but seeing the finish line so close, yet not getting any closer, is tough."
    gav "Je sais, et je ne veux pas avoir l'air ingrat, mais voir la ligne d'arrivée si proche, et pourtant ne pas s'en rapprocher, c'est dur."

# game/scripts/c32/c32.rpy:2040
translate french c32s003_GavArm_372ddeac:

    # mc "I get it. I was in the hospital once, and one morning the doctors told me I'd be discharged."
    mc "Je comprends. J'ai été à l'hôpital une fois, et un matin les médecins m'ont dit que j'allais sortir."

# game/scripts/c32/c32.rpy:2041
translate french c32s003_GavArm_20755a4e:

    # mc "The discharge didn't come until the afternoon, and those hours dragged on forever. I know it's not the same, but..."
    mc "La sortie n'est arrivée que l'après-midi, et ces heures ont duré une éternité. Je sais que ce n'est pas pareil, mais..."

# game/scripts/c32/c32.rpy:2043
translate french c32s003_GavArm_b5d684b5:

    # gav "What happened to you to end up in the hospital?"
    gav "Qu'est-ce qui t'est arrivé pour finir à l'hôpital ?"

# game/scripts/c32/c32.rpy:2044
translate french c32s003_GavArm_c4a2e13a:

    # mc "Back then I had too much of a sweet tooth, and I made myself sick eating [sam.nick]'s desserts."
    mc "À l'époque, j'étais trop gourmand, et je me suis rendu malade en mangeant les desserts de [sam.nick]."

# game/scripts/c32/c32.rpy:2046
translate french c32s003_GavArm_c7406647:

    # bet "*Laugh* It's hard to stop eating [sam.nick]'s desserts. Or [mar]'s, or [nor]'s."
    bet "*Rire* C'est dur d'arrêter de manger les desserts de [sam.nick]. Ou ceux de [mar], ou de [nor]."

# game/scripts/c32/c32.rpy:2047
translate french c32s003_GavArm_21945001:

    # mc "I know. But you've never eaten yourself sick."
    mc "Je sais. Mais tu ne t'es jamais rendue malade à force de manger."

# game/scripts/c32/c32.rpy:2048
translate french c32s003_GavArm_3da607c3:

    # bet "*Laugh* I always leave a little room in my stomach in case someone made chocolate and banana pizza..."
    bet "*Rire* Je garde toujours une petite place dans mon estomac au cas où quelqu'un aurait fait une pizza chocolat-banane..."

# game/scripts/c32/c32.rpy:2050
translate french c32s003_GavArm_6f89ce60:

    # gav "That's really weird..."
    gav "C'est vraiment bizarre..."

# game/scripts/c32/c32.rpy:2051
translate french c32s003_GavArm_49fb39a3:

    # mc "What do you find so weird? Aside from being a calorie bomb, chocolate and banana pizza is good."
    mc "Qu'est-ce que tu trouves si bizarre ? À part être une bombe calorique, la pizza chocolat-banane c'est bon."
# game/scripts/c32/c32.rpy:2052
translate french c32s003_GavArm_2bafb0e6:

    # gav "I don't mean that. When we were watching you, you were... I don't know... the enemy."
    gav "Ce n'est pas ce que je voulais dire. Quand on vous surveillait, vous étiez... je ne sais pas... l'ennemi."

# game/scripts/c32/c32.rpy:2054
translate french c32s003_GavArm_5e2aca3a:

    # gav "Now that I'm starting to get to know you... I'm looking forward to meeting [nor] and [mee] again. And apologizing to them for what happened."
    gav "Maintenant que je commence à vous connaître... J'ai hâte de revoir [nor] et [mee]. Et de m'excuser auprès d'elles pour ce qui s'est passé."

# game/scripts/c32/c32.rpy:2055
translate french c32s003_GavArm_da865680:

    # gav "And trying all those desserts Ms. [bet] told me about."
    gav "Et de goûter tous ces desserts dont Mme [bet] m'a parlé."

# game/scripts/c32/c32.rpy:2057
translate french c32s003_GavArm_73910ee0:

    # bet "You already apologized to me, and I told you it wasn't necessary. You were following orders."
    bet "Tu t'es déjà excusé auprès de moi, et je t'ai dit que ce n'était pas nécessaire. Tu suivais les ordres."

# game/scripts/c32/c32.rpy:2058
translate french c32s003_GavArm_01cdd2e2:

    # bet "The problem lies with whoever gave those orders."
    bet "Le problème vient de la personne qui a donné ces ordres."

# game/scripts/c32/c32.rpy:2059
translate french c32s003_GavArm_eba8b333:

    # gav "I know, but..."
    gav "Je sais, mais..."

# game/scripts/c32/c32.rpy:2060
translate french c32s003_GavArm_17f6d309:

    # bet "And the next problem is that you keep calling me 'Ms. [bet].' But we'll talk about that later."
    bet "Et l'autre problème, c'est que tu continues de m'appeler 'Mme [bet]'. Mais on en reparlera plus tard."

# game/scripts/c32/c32.rpy:2061
translate french c32s003_GavArm_04274168:

    # mc "The one you're going to have to apologize to is [emm]."
    mc "Celle à qui tu vas devoir présenter des excuses, c'est [emm]."

# game/scripts/c32/c32.rpy:2063
translate french c32s003_GavArm_0df9484f:

    # gav "Why? We never did anything to her!"
    gav "Pourquoi ? On ne lui a jamais rien fait !"

# game/scripts/c32/c32.rpy:2064
translate french c32s003_GavArm_96da2808:

    # mc "*Laugh* You said you're looking forward to meeting [nor] and [mee]. You didn't say anything about her."
    mc "*Rires* Tu as dit que tu avais hâte de revoir [nor] et [mee]. Tu n'as rien dit à son sujet."

# game/scripts/c32/c32.rpy:2065
translate french c32s003_GavArm_4d54b127:

    # mc "But don't worry, we'll keep your secret."
    mc "Mais ne t'inquiète pas, on gardera ton secret."
# game/scripts/c32/c32.rpy:2067
translate french c32s003_GavArm_3e3662d8:

    # gav "*Laugh* It's one of the main reasons I want this to go well."
    gav "*Rires* C'est l'une des principales raisons pour lesquelles je veux que ça se passe bien."

# game/scripts/c32/c32.rpy:2068
translate french c32s003_GavArm_26d360c7:

    # gav "Obviously, feeling whole again is the main reason, but..."
    gav "Évidemment, me sentir à nouveau entier est la raison principale, mais..."

# game/scripts/c32/c32.rpy:2070
translate french c32s003_GavArm_47c81d0d:

    # gav "Giving your family back part of what we tried to take from you is an important reason for me too."
    gav "Rendre à ta famille une partie de ce qu'on a essayé de vous prendre est aussi une raison importante pour moi."

# game/scripts/c32/c32.rpy:2071
translate french c32s003_GavArm_63da6de0:

    # gav "I know you told me that if this didn't work out, I could take care of surveillance, but..."
    gav "Je sais que tu m'as dit que si ça ne marchait pas, je pourrais m'occuper de la surveillance, mais..."

# game/scripts/c32/c32.rpy:2072
translate french c32s003_GavArm_10d517b8:

    # gav "I don't know... watching you through cameras wouldn't be the same. And even less so with what Miss [bet] has told me."
    gav "Je ne sais pas... vous regarder à travers des caméras, ce ne serait pas pareil. Et encore moins avec ce que Mademoiselle [bet] m'a raconté."

# game/scripts/c32/c32.rpy:2073
translate french c32s003_GavArm_5aead583:

    # mc "*Laugh* Don't pay too much attention to Aunt [bet], she exaggerates a bit when she talks about the family."
    mc "*Rires* Ne fais pas trop attention à Tante [bet], elle exagère un peu quand elle parle de la famille."

# game/scripts/c32/c32.rpy:2075
translate french c32s003_GavArm_add21243:

    # bet "I haven't exaggerated ONE BIT! Everything I've told him is true."
    bet "Je n'ai pas exagéré DU TOUT ! Tout ce que je lui ai dit est vrai."

# game/scripts/c32/c32.rpy:2076
translate french c32s003_GavArm_565ea2b9:

    # mc "But I'm sure you've only told him the good things."
    mc "Mais je suis sûr que tu ne lui as dit que les bonnes choses."

# game/scripts/c32/c32.rpy:2077
translate french c32s003_GavArm_822e7378:

    # bet "Of course! He'll discover the rest for himself."
    bet "Bien sûr ! Il découvrira le reste par lui-même."

# game/scripts/c32/c32.rpy:2079
translate french c32s003_GavArm_f6da07a6:

    # mc "Is there anyone you're especially looking forward to meeting?"
    mc "Y a-t-il quelqu'un que tu as particulièrement hâte de rencontrer ?"

# game/scripts/c32/c32.rpy:2080
translate french c32s003_GavArm_15888eb9:

    # gav "All the girls, Jamaal, Zeus... But I think, from the information I have, [sca] and [dap]."
    gav "Toutes les filles, Jamaal, Zeus... Mais je pense, d'après les informations que j'ai, [sca] et [dap]."

# game/scripts/c32/c32.rpy:2081
translate french c32s003_GavArm_6e6f6c12:

    # gav "And obviously [emm], in case this is being recorded and the file ends up in her hands."
    gav "Et évidemment [emm], au cas où ce serait enregistré et que le fichier tomberait entre ses mains."

# game/scripts/c32/c32.rpy:2082
translate french c32s003_GavArm_a99a1a6d:

    # mc "*Laugh* Good choices all around. Especially [emm]. You never know what she might do to your truck if she gets mad."
    mc "*Rires* De très bons choix. Surtout [emm]. Tu ne sais jamais ce qu'elle pourrait faire à ton camion si elle s'énerve."

# game/scripts/c32/c32.rpy:2084
translate french c32s003_GavArm_522acbfe:

    # cal "Sorry for the delay. There were some last-minute adjustments I had to make on the server."
    cal "Désolé pour le retard. Il y a eu quelques ajustements de dernière minute que j'ai dû faire sur le serveur."

# game/scripts/c32/c32.rpy:2085
translate french c32s003_GavArm_01eb8a1e:

    # mc "Don't worry, we were going to start biting our nails in a few minutes."
    mc "T'inquiète pas, on allait commencer à se ronger les ongles dans quelques minutes."

# game/scripts/c32/c32.rpy:2086
translate french c32s003_GavArm_7be86d31:

    # mc "Did the adjustments go well?"
    mc "Les ajustements se sont bien passés ?"

# game/scripts/c32/c32.rpy:2088
translate french c32s003_GavArm_9dd41f19:

    # cal "Since the muscle has healed better than we expected, we can turn it on with a little more power than planned."
    cal "Vu que le muscle a mieux guéri qu'on ne l'espérait, on peut l'activer avec un peu plus de puissance que prévu."

# game/scripts/c32/c32.rpy:2089
translate french c32s003_GavArm_8dc67954:

    # cal "Roughly the same as a biological arm would have. I think it will be a better test than with a reduced-power arm."
    cal "À peu près la même qu'un bras biologique. Je pense que ce sera un meilleur test qu'avec un bras à puissance réduite."

# game/scripts/c32/c32.rpy:2090
translate french c32s003_GavArm_66f6e46a:

    # cal "[gav]'s body and brain will be able to adapt more quickly."
    cal "Le corps et le cerveau de [gav] pourront s'adapter plus rapidement."

# game/scripts/c32/c32.rpy:2091
translate french c32s003_GavArm_66baa76d:

    # mc "It's your creation. I trust you completely with this."
    mc "C'est ta création. Je te fais totalement confiance là-dessus."

# game/scripts/c32/c32.rpy:2092
translate french c32s003_GavArm_6fa062ba:

    # mc "Any questions, [gav]?"
    mc "Des questions, [gav] ?"

# game/scripts/c32/c32.rpy:2094
translate french c32s003_GavArm_dee17e91:

    # gav "What do I have to do when you turn it on?"
    gav "Qu'est-ce que je dois faire quand tu l'allumeras ?"
# game/scripts/c32/c32.rpy:2095
translate french c32s003_GavArm_f336953f:

    # gav "Do I have to clear my mind or something like that?"
    gav "Est-ce que je dois faire le vide dans mon esprit ou un truc du genre ?"

# game/scripts/c32/c32.rpy:2096
translate french c32s003_GavArm_897fea52:

    # cal "Just the opposite. You have to think about what you want to do with the arm, just like you would with your left one."
    cal "Tout le contraire. Tu dois penser à ce que tu veux faire avec le bras, exactement comme tu le ferais avec le gauche."

# game/scripts/c32/c32.rpy:2097
translate french c32s003_GavArm_4ff43c89:

    # cal "We'll start with simple tests, like touching your forehead, first with your biological arm and then with the prosthesis."
    cal "On va commencer par des tests simples, comme te toucher le front, d'abord avec ton bras biologique puis avec la prothèse."

# game/scripts/c32/c32.rpy:2098
translate french c32s003_GavArm_1c928c5b:

    # cal "With the prosthesis, try to make the movements slowly. We don't want your finger to pierce your skull if you do it too fast."
    cal "Avec la prothèse, essaie de faire les mouvements lentement. On ne veut pas que ton doigt te transperce le crâne si tu vas trop vite."

# game/scripts/c32/c32.rpy:2099
translate french c32s003_GavArm_672b0293:

    # mc "*Surprised* Can it do that?"
    mc "*Surpris* Ça peut faire ça ?"

# game/scripts/c32/c32.rpy:2101
translate french c32s003_GavArm_1a2e1b91:

    # cal "Probably not right now, with the power I've assigned to it. But at full capacity, it could."
    cal "Probablement pas pour l'instant, avec la puissance que je lui ai assignée. Mais à pleine capacité, ça le pourrait."

# game/scripts/c32/c32.rpy:2102
translate french c32s003_GavArm_c1d95887:

    # cal "But by the time we turn the power up to the max, [gav] will already be used to the weight and reaction speed."
    cal "Mais d'ici à ce qu'on pousse la puissance au max, [gav] sera déjà habitué au poids et à la vitesse de réaction."

# game/scripts/c32/c32.rpy:2104
translate french c32s003_GavArm_2e3372dd:

    # bet "Don't worry, sweetie. You're not going to break any bones today. We'll gradually increase the power over the next few days."
    bet "Ne t'inquiète pas, chéri. Tu ne vas te casser aucun os aujourd'hui. On augmentera progressivement la puissance au cours des prochains jours."

# game/scripts/c32/c32.rpy:2105
translate french c32s003_GavArm_2afa93cd:

    # gav "OK. Got it. Think about what gesture I want to make and hope the arm understands it and does it at a normal speed."
    gav "OK. J'ai pigé. Penser au geste que je veux faire et espérer que le bras le comprenne et le fasse à une vitesse normale."

# game/scripts/c32/c32.rpy:2106
translate french c32s003_GavArm_2b493bc2:

    # bet "Not normal. Slower than normal. You won't break your skull, but you could poke an eye out."
    bet "Pas normale. Plus lente que la normale. Tu ne te briseras pas le crâne, mais tu pourrais te crever un œil."

# game/scripts/c32/c32.rpy:2107
translate french c32s003_GavArm_a36fb724:

    # gav "Understood. Whenever you're ready."
    gav "Compris. Quand vous êtes prêts."
# game/scripts/c32/c32.rpy:2109
translate french c32s003_GavArm_38c4a54f:

    # cal "As soon as I turn it on, you'll feel a tingling in your shoulder and a phantom limb sensation after a few seconds."
    cal "Dès que je l'allumerai, tu vas sentir un picotement dans ton épaule et une sensation de membre fantôme après quelques secondes."

# game/scripts/c32/c32.rpy:2110
translate french c32s003_GavArm_b47e3fce:

    # cal "Unlike a real phantom limb, the arm will react to your thoughts because it's actually there."
    cal "Contrairement à un vrai membre fantôme, le bras réagira à tes pensées parce qu'il est bel et bien là."

# game/scripts/c32/c32.rpy:2111
translate french c32s003_GavArm_e88c9348:

    # cal "Ready?"
    cal "Prêt ?"

# game/scripts/c32/c32.rpy:2112
translate french c32s003_GavArm_d8c0d925:

    # gav "Scared shitless, but ready."
    gav "Je me chie dessus, mais je suis prêt."

# game/scripts/c32/c32.rpy:2114
translate french c32s003_GavArm_920b6c07:

    # cal "There you go. As soon as you feel the tingling, think about the movement you want to make. Although we'll start with the biological arm."
    cal "Et voilà. Dès que tu sens le picotement, pense au mouvement que tu veux faire. Même si on va commencer par le bras biologique."

# game/scripts/c32/c32.rpy:2115
translate french c32s003_GavArm_8c0fd058:

    # cal "For now, it's best you don't think about moving it. You'll move the left one, and then try to repeat the movement with the right one."
    cal "Pour l'instant, il vaut mieux que tu ne penses pas à le bouger. Tu vas bouger le gauche, et ensuite essayer de répéter le mouvement avec le droit."

# game/scripts/c32/c32.rpy:2116
translate french c32s003_GavArm_6b826ef0:

    # cal "At first, it has to be a conscious thought, or your subconscious will take control."
    cal "Au début, ça doit être une pensée consciente, sinon ton subconscient prendra le contrôle."

# game/scripts/c32/c32.rpy:2117
translate french c32s003_GavArm_a788a8e6:

    # cal "Step by step, you should get used to the sensation and you'll end up feeling it just like the other arm."
    cal "Étape par étape, tu devrais t'habituer à la sensation et tu finiras par le ressentir exactement comme l'autre bras."

# game/scripts/c32/c32.rpy:2118
translate french c32s003_GavArm_a88810b9:

    # gav "I'm already starting to feel the tingling. It's like my arm is numb. But I feel it."
    gav "Je commence déjà à sentir le picotement. C'est comme si mon bras était engourdi. Mais je le sens."

# game/scripts/c32/c32.rpy:2119
translate french c32s003_GavArm_dcd32898:

    # cal "Great. That's what we expected. Now close your left hand and..."
    cal "Super. C'est ce qu'on attendait. Maintenant ferme ta main gauche et..."

# game/scripts/c32/c32.rpy:2121
translate french c32s003_GavArm_d3fb0ca3:

    # "The arm suddenly jerks and starts moving in a gesture you know very well from your teenage years."
    "Le bras s'agite soudainement et commence à bouger dans un geste que tu connais très bien depuis ton adolescence."
# game/scripts/c32/c32.rpy:2122
translate french c32s003_GavArm_04aaece0:

    # gav "What? Stop that! That's not what I wanted to do!"
    gav "Quoi ? Arrête ça ! Ce n'est pas ce que je voulais faire !"

# game/scripts/c32/c32.rpy:2123
translate french c32s003_GavArm_8770cab2:

    # cal "Give me a second. Try to keep the arm still."
    cal "Donne-moi une seconde. Essaie de garder le bras immobile."

# game/scripts/c32/c32.rpy:2125
translate french c32s003_GavArm_f5d9d106:

    # cal "Done. Disconnected. Let me check some parameters."
    cal "C'est fait. Déconnecté. Laisse-moi vérifier quelques paramètres."

# game/scripts/c32/c32.rpy:2126
translate french c32s003_GavArm_4ae4dbe7:

    # bet "What happened? How did it feel?"
    bet "Que s'est-il passé ? Qu'est-ce que tu as ressenti ?"

# game/scripts/c32/c32.rpy:2127
translate french c32s003_GavArm_54dc25cc:

    # gav "It felt like I'd slept on my arm for hours, but like it was mine."
    gav "C'était comme si j'avais dormi sur mon bras pendant des heures, mais comme si c'était le mien."

# game/scripts/c32/c32.rpy:2129
translate french c32s003_GavArm_76b4d919:

    # gav "I don't know why it made... those movements... I didn't think about moving it. [cal] said the first movements would be with the real one."
    gav "Je ne sais pas pourquoi il a fait... ces mouvements... Je n'ai pas pensé à le bouger. [cal] a dit que les premiers mouvements se feraient avec le vrai."

# game/scripts/c32/c32.rpy:2130
translate french c32s003_GavArm_6bce648b:

    # mc "[cal] said that if you didn't control it with a conscious thought, your subconscious would take over..."
    mc "[cal] a dit que si tu ne le contrôlais pas avec une pensée consciente, ton subconscient prendrait le relais..."

# game/scripts/c32/c32.rpy:2132
translate french c32s003_GavArm_4c36d11f:

    # gav "But I wasn't thinking about... that..."
    gav "Mais je ne pensais pas à... ça..."

# game/scripts/c32/c32.rpy:2133
translate french c32s003_GavArm_3aee887d:

    # mc "The subconscious can be a real son of a bitch, [gav]. And if you're right-handed, I guess you've gone weeks without..."
    mc "Le subconscient peut être un vrai fils de pute, [gav]. Et si tu es droitier, j'imagine que tu as passé des semaines sans..."

# game/scripts/c32/c32.rpy:2134
translate french c32s003_GavArm_37aae690:

    # gav "But I wouldn't have wanted to do it... let alone here in front of Miss [bet], you, and [cal]..."
    gav "Mais je n'aurais pas voulu le faire... et encore moins ici devant Mlle [bet], toi et [cal]..."

# game/scripts/c32/c32.rpy:2136
translate french c32s003_GavArm_33c9f972:

    # bet "I wouldn't even recommend it in the first few weeks, until you have control of the arm."
    bet "Je ne le recommanderais même pas dans les premières semaines, jusqu'à ce que tu aies le contrôle du bras."
# game/scripts/c32/c32.rpy:2137
translate french c32s003_GavArm_762cdd70:

    # bet "Remember that it's stronger than your original arm. You don't want to end up with your family jewels squashed between plastic and titanium."
    bet "N'oublie pas qu'il est plus fort que ton bras d'origine. Tu ne voudrais pas te retrouver avec tes bijoux de famille écrabouillés entre du plastique et du titane."

# game/scripts/c32/c32.rpy:2138
translate french c32s003_GavArm_5e5c9dc1:

    # mc "You're so tactless, Aunt [bet]!"
    mc "T'as vraiment aucun tact, tante [bet] !"

# game/scripts/c32/c32.rpy:2140
translate french c32s003_GavArm_e7a03cc8:

    # bet "If the kid hasn't consciously thought about it and tries it tonight, he could have an accident."
    bet "Si le gamin n'y a pas pensé consciemment et qu'il essaie ce soir, il pourrait avoir un accident."

# game/scripts/c32/c32.rpy:2141
translate french c32s003_GavArm_f53b0e63:

    # "[bet] keeps her fist closed, illustrating in the minds of the three men around the table a pain you can perfectly imagine."
    "[bet] garde son poing fermé, illustrant dans l'esprit des trois hommes autour de la table une douleur que tu peux parfaitement imaginer."

# game/scripts/c32/c32.rpy:2142
translate french c32s003_GavArm_c6f6b944:

    # bet "It's better if he's warned. Besides, I don't know how pleasant the touch will be in a sensitive area."
    bet "C'est mieux s'il est prévenu. En plus, je ne sais pas si le contact sera très agréable dans une zone sensible."

# game/scripts/c32/c32.rpy:2143
translate french c32s003_GavArm_ddb08430:

    # mc "I think I can do without that information."
    mc "Je pense que je peux me passer de cette information."

# game/scripts/c32/c32.rpy:2145
translate french c32s003_GavArm_56a556e3:

    # cal "Done. I've adjusted a parameter. Shall we try turning it on again?"
    cal "C'est fait. J'ai ajusté un paramètre. On essaie de le rallumer ?"

# game/scripts/c32/c32.rpy:2146
translate french c32s003_GavArm_8c65d973:

    # mc "Can you manage subconscious thoughts?"
    mc "Tu peux gérer les pensées subconscientes ?"

# game/scripts/c32/c32.rpy:2147
translate french c32s003_GavArm_2c36f5c7:

    # cal "No. What I've done is introduce a delay in the response."
    cal "Non. Ce que j'ai fait, c'est introduire un délai dans la réponse."

# game/scripts/c32/c32.rpy:2148
translate french c32s003_GavArm_5add1a99:

    # cal "If a subconscious thought tries to take control and [gav] realizes it, he can rectify it with a conscious thought."
    cal "Si une pensée subconsciente essaie de prendre le contrôle et que [gav] s'en rend compte, il peut rectifier le tir avec une pensée consciente."

# game/scripts/c32/c32.rpy:2149
translate french c32s003_GavArm_ac38b695:

    # cal "Can you help [gav] put his arm on the table?"
    cal "Tu peux aider [gav] à mettre son bras sur la table ?"
# game/scripts/c32/c32.rpy:2151
translate french c32s003_GavArm_bd9861b3:

    # cal "Now you'll notice that the arm takes a little while to react to what you command it. We'll manage that as you adapt."
    cal "Maintenant, tu vas remarquer que le bras met un peu de temps à réagir à ce que tu lui commandes. On gérera ça au fur et à mesure que tu t'adapteras."

# game/scripts/c32/c32.rpy:2152
translate french c32s003_GavArm_e88c9348_1:

    # cal "Ready?"
    cal "Prêt ?"

# game/scripts/c32/c32.rpy:2153
translate french c32s003_GavArm_7c5c6ada:

    # gav "I'm even more scared shitless than before, but I'm ready."
    gav "Je me chie encore plus dessus qu'avant, mais je suis prêt."

# game/scripts/c32/c32.rpy:2154
translate french c32s003_GavArm_916d8ecb:

    # cal "Think about keeping your hand on the table. Both hands on the table."
    cal "Pense à garder ta main sur la table. Les deux mains sur la table."

# game/scripts/c32/c32.rpy:2156
translate french c32s003_GavArm_5e77f1ba:

    # cal "Done."
    cal "C'est fait."

# game/scripts/c32/c32.rpy:2157
translate french c32s003_GavArm_0b8b462a:

    # "You all stare at the titanium arm. It starts to move with slight twitches. But nothing like the previous movements."
    "Vous fixez tous le bras en titane. Il commence à bouger avec de légers spasmes. Mais rien à voir avec les mouvements précédents."

# game/scripts/c32/c32.rpy:2158
translate french c32s003_GavArm_e6173868:

    # gav "I swear I'm thinking about keeping it still."
    gav "Je te jure que je pense à le garder immobile."

# game/scripts/c32/c32.rpy:2159
translate french c32s003_GavArm_841dc95d:

    # bet "You're doing great, honey."
    bet "Tu t'en sors très bien, chéri."

# game/scripts/c32/c32.rpy:2160
translate french c32s003_GavArm_a25d3cb7:

    # cal "Give the arm a little time to understand how you think."
    cal "Laisse un peu de temps au bras pour comprendre comment tu penses."

# game/scripts/c32/c32.rpy:2161
translate french c32s003_GavArm_d60f5ece:

    # cal "Remember that we've introduced a slight delay between what you think and what the arm does."
    cal "N'oublie pas qu'on a introduit un léger délai entre ce que tu penses et ce que le bras fait."

# game/scripts/c32/c32.rpy:2162
translate french c32s003_GavArm_4895d3ae:

    # mc "And I don't know if it'll do any good, but relax. As [emm] would say, it's a bitch having to think all the time."
    mc "Et je ne sais pas si ça va servir à quelque chose, mais détends-toi. Comme dirait [emm], c'est chiant de devoir penser tout le temps."
# game/scripts/c32/c32.rpy:2164
translate french c32s003_GavArm_3b1579f9:

    # "After a few minutes, the arm goes completely still."
    "Après quelques minutes, le bras s'immobilise complètement."

# game/scripts/c32/c32.rpy:2166
translate french c32s003_GavArm_b8746d3c:

    # gav "I did it! It's still."
    gav "J'ai réussi ! Il ne bouge plus."

# game/scripts/c32/c32.rpy:2167
translate french c32s003_GavArm_426fc2c6:

    # mc "I told you, you could do it."
    mc "Je t'avais dit que tu pouvais le faire."

# game/scripts/c32/c32.rpy:2168
translate french c32s003_GavArm_ac25214a:

    # bet "Great job, sweetie!"
    bet "Beau travail, mon chéri !"

# game/scripts/c32/c32.rpy:2169
translate french c32s003_GavArm_e42d1294:

    # cal "Well, the batteries actually died..."
    cal "Eh bien, en fait, les batteries sont mortes..."

# game/scripts/c32/c32.rpy:2171
translate french c32s003_GavArm_0e48af55:

    # bet "That fast?" (multiple=2)
    bet "Si vite ?" (multiple=2)

# game/scripts/c32/c32.rpy:2172
translate french c32s003_GavArm_82e95baf:

    # gav "What? Already?" (multiple=2)
    gav "Quoi ? Déjà ?" (multiple=2)

# game/scripts/c32/c32.rpy:2173
translate french c32s003_GavArm_9d363c81:

    # mc "I thought they'd last more than a couple of minutes. Or is it because we're using a test charge?"
    mc "Je pensais qu'elles dureraient plus de quelques minutes. Ou c'est parce qu'on utilise une charge de test ?"

# game/scripts/c32/c32.rpy:2174
translate french c32s003_GavArm_c5728af2:

    # cal "Just kidding. They last over a week on this charge level. Around ten days on a full charge."
    cal "Je plaisante. Elles durent plus d'une semaine à ce niveau de charge. Environ dix jours avec une charge complète."

# game/scripts/c32/c32.rpy:2175
translate french c32s003_GavArm_78bf9afd:

    # cal "But look."
    cal "Mais regardez."

# game/scripts/c32/c32.rpy:2177
translate french c32s003_GavArm_55d8c126:

    # "The moment [gav] stopped thinking about keeping his arm still, his subconscious took over."
    "Au moment où [gav] a arrêté de penser à garder son bras immobile, son subconscient a pris le relais."
# game/scripts/c32/c32.rpy:2178
translate french c32s003_GavArm_4697f8e8:

    # "He made the exact same gesture he would have made with his biological arm."
    "Il fit exactement le même geste qu'il aurait fait avec son bras biologique."

# game/scripts/c32/c32.rpy:2179
translate french c32s003_GavArm_d968e801:

    # gav "It works!"
    gav "Ça marche !"

# game/scripts/c32/c32.rpy:2180
translate french c32s003_GavArm_dad22c5f:

    # mc "Looks like [cal] is a crafty bastard."
    mc "On dirait que [cal] est un enfoiré rusé."

# game/scripts/c32/c32.rpy:2181
translate french c32s003_GavArm_9ae3de6e:

    # bet "He made you stop thinking about the arm for a second."
    bet "Il t'a fait arrêter de penser au bras pendant une seconde."

# game/scripts/c32/c32.rpy:2182
translate french c32s003_GavArm_8ab09fce:

    # cal "I knew it would be hard for him to relax if he was thinking about the arm..."
    cal "Je savais que ce serait dur pour lui de se détendre s'il pensait au bras..."

# game/scripts/c32/c32.rpy:2183
translate french c32s003_GavArm_22479201:

    # mc "You did good, [cal]."
    mc "Tu as fait du bon boulot, [cal]."

# game/scripts/c32/c32.rpy:2184
translate french c32s003_GavArm_89abc18e:

    # mc "What's the next step?"
    mc "C'est quoi la prochaine étape ?"

# game/scripts/c32/c32.rpy:2186
translate french c32s003_GavArm_da8f30a4:

    # cal "We have a lot of testing and training ahead of us."
    cal "On a beaucoup de tests et d'entraînement devant nous."

# game/scripts/c32/c32.rpy:2187
translate french c32s003_GavArm_f71a2802:

    # cal "The parameters shown on the graphs are within what I expected."
    cal "Les paramètres affichés sur les graphiques correspondent à ce que j'attendais."

# game/scripts/c32/c32.rpy:2188
translate french c32s003_GavArm_e5c9dfdc:

    # cal "We'll have to make adjustments, but we're on the right track."
    cal "On va devoir faire des ajustements, mais on est sur la bonne voie."

# game/scripts/c32/c32.rpy:2189
translate french c32s003_GavArm_3731ac97:

    # mc "Your absolute priority right now is to get that arm working exactly as you designed it."
    mc "Ta priorité absolue pour l'instant, c'est de faire fonctionner ce bras exactement comme tu l'as conçu."
# game/scripts/c32/c32.rpy:2191
translate french c32s003_GavArm_4affd92c:

    # cal "But [mael]..."
    cal "Mais [mael]..."

# game/scripts/c32/c32.rpy:2192
translate french c32s003_GavArm_918d8213:

    # mc "If [mael] has any doubts about my priorities, tell him the door to my office is open."
    mc "Si [mael] a des doutes sur mes priorités, dis-lui que la porte de mon bureau est ouverte."

# game/scripts/c32/c32.rpy:2194
translate french c32s003_GavArm_51ad5f10:

    # bet "*Laugh* If [car] lets him in, of course."
    bet "*Rire* Si [car] le laisse entrer, bien sûr."

# game/scripts/c32/c32.rpy:2195
translate french c32s003_GavArm_a4678617:

    # gav "[car] is a good woman, Miss [bet]."
    gav "[car] est une femme bien, Mademoiselle [bet]."

# game/scripts/c32/c32.rpy:2196
translate french c32s003_GavArm_74bf70db:

    # cal "Yeah, but she can be scary and overprotective with... Well, with her prerogatives as a secretary."
    cal "Ouais, mais elle peut être effrayante et surprotectrice avec... Eh bien, avec ses prérogatives de secrétaire."

# game/scripts/c32/c32.rpy:2197
translate french c32s003_GavArm_8fba4473:

    # mc "Can we continue with the tests? I'd like to see some progress before my next meeting."
    mc "On peut continuer les tests ? J'aimerais voir des progrès avant ma prochaine réunion."

# game/scripts/c32/c32.rpy:2198
translate french c32s003_GavArm_afb76904:

    # mc "I mean the planned progress. The fact that [gav] is crossing his arms tells me everything is going to be fine."
    mc "Je veux dire les progrès prévus. Le fait que [gav] croise les bras me dit que tout va bien se passer."

# game/scripts/c32/c32.rpy:2200
translate french c32s003_GavArm_f8bcad4c:

    # "For the next few minutes, [gav] does basic exercises, like opening and closing both hands at the same time or lifting them off the table."
    "Pendant les minutes qui suivent, [gav] fait des exercices de base, comme ouvrir et fermer les deux mains en même temps ou les soulever de la table."

# game/scripts/c32/c32.rpy:2201
translate french c32s003_GavArm_7db94244:

    # "The mechanical arm takes a bit to react, just as you expected."
    "Le bras mécanique met un peu de temps à réagir, comme tu t'y attendais."

# game/scripts/c32/c32.rpy:2203
translate french c32s003_GavArm_20e68520:

    # cal "Give me a second to tweak the delay parameters. I think we're on the right track."
    cal "Laissez-moi une seconde pour ajuster les paramètres de délai. Je pense qu'on est sur la bonne voie."

# game/scripts/c32/c32.rpy:2204
translate french c32s003_GavArm_0a7083da:

    # mc "How are you feeling, [gav]? Remember it's the first day and I don't think it's a good idea to push yourself too hard."
    mc "Comment tu te sens, [gav] ? N'oublie pas que c'est le premier jour et je ne pense pas que ce soit une bonne idée de trop forcer."
# game/scripts/c32/c32.rpy:2205
translate french c32s003_GavArm_66f06a31:

    # bet "[mc] is right. Your muscles aren't completely healed."
    bet "[mc] a raison. Tes muscles ne sont pas complètement guéris."

# game/scripts/c32/c32.rpy:2206
translate french c32s003_GavArm_1a1bbf51:

    # gav "Nothing hurts and I don't feel tired..."
    gav "Je n'ai mal nulle part et je ne me sens pas fatigué..."

# game/scripts/c32/c32.rpy:2208
translate french c32s003_GavArm_e12aa78b:

    # gav "Speaking of which... Can the new arm get tired? How will I notice?"
    gav "En parlant de ça... Est-ce que le nouveau bras peut se fatiguer ? Comment je m'en rendrai compte ?"

# game/scripts/c32/c32.rpy:2209
translate french c32s003_GavArm_50d54b4d:

    # cal "It's complicated to explain. There are two types of fatigue. Peripheral and central."
    cal "C'est compliqué à expliquer. Il y a deux types de fatigue. Périphérique et centrale."

# game/scripts/c32/c32.rpy:2211
translate french c32s003_GavArm_cacee1d5:

    # cal "Peripheral fatigue is due to an excess or lack of certain chemical compounds. You won't notice that, at least not in the arm, but you will in the shoulder."
    cal "La fatigue périphérique est due à un excès ou un manque de certains composés chimiques. Tu ne le remarqueras pas, du moins pas dans le bras, mais tu le sentiras dans l'épaule."

# game/scripts/c32/c32.rpy:2212
translate french c32s003_GavArm_a048237b:

    # cal "Central fatigue occurs because your brain knows you should be reaching your exercise limit."
    cal "La fatigue centrale se produit parce que ton cerveau sait que tu devrais atteindre ta limite d'exercice."

# game/scripts/c32/c32.rpy:2213
translate french c32s003_GavArm_ece65c24:

    # cal "It reduces the frequency and intensity of the electrical signals it sends to the muscles."
    cal "Il réduit la fréquence et l'intensité des signaux électriques qu'il envoie aux muscles."

# game/scripts/c32/c32.rpy:2215
translate french c32s003_GavArm_786b3dd3:

    # cal "There's also a change in the balance of chemical compounds, like serotonin or dopamine."
    cal "Il y a aussi un changement dans l'équilibre des composés chimiques, comme la sérotonine ou la dopamine."

# game/scripts/c32/c32.rpy:2216
translate french c32s003_GavArm_6234604c:

    # cal "That makes YOU feel tired."
    cal "C'est ce qui fait que TU te sens fatigué."

# game/scripts/c32/c32.rpy:2217
translate french c32s003_GavArm_41548868:

    # cal "Since your shoulder is still biological and your brain thinks your arm is too, it's possible you'll feel that kind of fatigue, although reduced."
    cal "Puisque ton épaule est encore biologique et que ton cerveau pense que ton bras l'est aussi, il est possible que tu ressentes ce genre de fatigue, bien qu'atténuée."

# game/scripts/c32/c32.rpy:2218
translate french c32s003_GavArm_85a77c27:

    # cal "Although I think Ms. [bet] will be able to explain that better than me."
    cal "Bien que je pense que Mme [bet] sera capable de l'expliquer mieux que moi."
# game/scripts/c32/c32.rpy:2219
translate french c32s003_GavArm_0c1ec4f5:

    # cal "I've readjusted the delay. Try repeating the exercises now."
    cal "J'ai réajusté le délai. Essaie de répéter les exercices maintenant."

# game/scripts/c32/c32.rpy:2221
translate french c32s003_GavArm_24d6121a:

    # "[gav] repeats the exercises again. This time there is no noticeable delay in copying the movements."
    "[gav] répète les exercices. Cette fois, il n'y a pas de délai notable dans la copie des mouvements."

# game/scripts/c32/c32.rpy:2222
translate french c32s003_GavArm_f8a2fb37:

    # cal "There are still a few milliseconds of delay, but we'll keep fixing it."
    cal "Il y a encore quelques millisecondes de délai, mais on va continuer à régler ça."

# game/scripts/c32/c32.rpy:2223
translate french c32s003_GavArm_eac86c48:

    # gav "It feels more natural now... It's almost as if the arm were mine."
    gav "C'est plus naturel maintenant... C'est presque comme si ce bras était le mien."

# game/scripts/c32/c32.rpy:2224
translate french c32s003_GavArm_5c5a6a8d:

    # gav "I can't wait to try it at the shooting range."
    gav "J'ai hâte de l'essayer au stand de tir."

# game/scripts/c32/c32.rpy:2225
translate french c32s003_GavArm_1e16ffdd:

    # bet "That's still a few days away, sweetie. You just learned to close both hands at the same time."
    bet "C'est pas pour tout de suite, mon chou. Tu viens juste d'apprendre à fermer les deux mains en même temps."

# game/scripts/c32/c32.rpy:2227
translate french c32s003_GavArm_0d9d7253:

    # mc "I'm really happy for you, [gav]. And for you, [cal]. Great job."
    mc "Je suis vraiment content pour toi, [gav]. Et pour toi, [cal]. Super boulot."

# game/scripts/c32/c32.rpy:2228
translate french c32s003_GavArm_e71f44d7:

    # mc "I have to leave you guys now; I have a meeting in a few minutes. Thank you all for this."
    mc "Je dois vous laisser maintenant ; j'ai une réunion dans quelques minutes. Merci à tous pour ça."

# game/scripts/c32/c32.rpy:2230
translate french c32s003_GavArm_e3922a20:

    # gav "Thank you, [mc]."
    gav "Merci, [mc]."

# game/scripts/c32/c32.rpy:2231
translate french c32s003_GavArm_bed27aab:

    # "The touch of the mechanical arm feels weird during the unexpected hug. The tenderness of the embrace makes up for its strangeness."
    "Le contact du bras mécanique fait bizarre pendant cette étreinte inattendue. La tendresse du câlin compense son étrangeté."

# game/scripts/c32/c32.rpy:2232
translate french c32s003_GavArm_76f7c807:

    # "For a moment, before returning the hug, you understand how [aar] feels."
    "Pendant un instant, avant de lui rendre son étreinte, vous comprenez ce que ressent [aar]."
# game/scripts/c32/c32.rpy:2233
translate french c32s003_GavArm_790b6cbf:

    # mc "*Laugh* I think you spend too much time with Aunt [bet]."
    mc "*Rires* Je crois que tu passes trop de temps avec Tante [bet]."

# game/scripts/c32/c32.rpy:2236
translate french c32s003_GavArm_20eda20b:

    # gav "Sorry, Sir! I overstepped."
    gav "Désolé, Monsieur ! J'ai dépassé les bornes."

# game/scripts/c32/c32.rpy:2237
translate french c32s003_GavArm_317a2055:

    # mc "You didn't, [gav]. If I laugh at something someone does, it means it doesn't bother me."
    mc "Pas du tout, [gav]. Si je rigole de ce que fait quelqu'un, c'est que ça ne me dérange pas."

# game/scripts/c32/c32.rpy:2238
translate french c32s003_GavArm_3ff9ae72:

    # mc "At least we know you can give hugs without breaking anyone's ribs."
    mc "Au moins, on sait que tu peux faire des câlins sans briser les côtes de personne."

# game/scripts/c32/c32.rpy:2240
translate french c32s003_GavArm_92e17f17:

    # cal "*Chuckles* He'll probably be able to do that when the arm is at its final power."
    cal "*Glousse* Il sera probablement capable de faire ça quand le bras sera à sa puissance maximale."

# game/scripts/c32/c32.rpy:2241
translate french c32s003_GavArm_e77af221:

    # mc "Then he better learn to control his strength by then. *Laugh* Or I'm not going to let him hug me again."
    mc "Alors il a intérêt à apprendre à contrôler sa force d'ici là. *Rires* Sinon je ne le laisserai plus me faire de câlins."

# game/scripts/c32/c32.rpy:2242
translate french c32s003_GavArm_d0379337:

    # mc "Keep up with the tests, please. [cal], send me a daily report with the progress... by email."
    mc "Continuez les tests, s'il vous plaît. [cal], envoie-moi un rapport quotidien des progrès... par e-mail."

# game/scripts/c32/c32.rpy:2243
translate french c32s003_GavArm_be1396cf:

    # mc "I don't think I'll be able to attend all the tests."
    mc "Je ne pense pas pouvoir assister à tous les tests."

# game/scripts/c32/c32.rpy:2245
translate french c32s003_GavArm_fe1ff717:

    # "You turn towards the door when a thought strikes you before opening it."
    "Vous vous tournez vers la porte lorsqu'une pensée vous frappe avant de l'ouvrir."

# game/scripts/c32/c32.rpy:2246
translate french c32s003_GavArm_b29bbb93:

    # mcp "(I hope [cal]'s reports aren't as exhaustive as [aar]'s.)"
    mcp "(J'espère que les rapports de [cal] ne seront pas aussi exhaustifs que ceux de [aar].)"

# game/scripts/c32/c32.rpy:2247
translate french c32s003_GavArm_a0b1e474:

    # mc "An executive report, [cal]."
    mc "Un rapport de synthèse, [cal]."
# game/scripts/c32/c32.rpy:2251
translate french c32s003_redecor_31d3fd93:

    # centered "{size=+20}{b}DAY 50 – TUESDAY{/b}{/size}"
    centered "{size=+20}{b}JOUR 50 – MARDI{/b}{/size}"

# game/scripts/c32/c32.rpy:2253
translate french c32s003_redecor_238acad7:

    # "A few days later, after having to insist to [ama] several times to let you borrow the photos..."
    "Quelques jours plus tard, après avoir dû insister auprès d'[ama] à plusieurs reprises pour qu'elle vous laisse emprunter les photos..."

# game/scripts/c32/c32.rpy:2254
translate french c32s003_redecor_e45b1c18:

    # mc "Good morning, [car]."
    mc "Bonjour, [car]."

# game/scripts/c32/c32.rpy:2255
translate french c32s003_redecor_c13d31a6:

    # car "Good morning, Mr. Marks."
    car "Bonjour, M. Marks."

# game/scripts/c32/c32.rpy:2256
translate french c32s003_redecor_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c32/c32.rpy:2257
translate french c32s003_redecor_f1983638:

    # "You know it seems like a losing battle, but you've won a few battles in your life by being very persistent."
    "Vous savez que ça ressemble à une bataille perdue d'avance, mais vous avez gagné quelques batailles dans votre vie en étant très persévérant."

# game/scripts/c32/c32.rpy:2258
translate french c32s003_redecor_380e9a9f:

    # car "Can I help you with anything?"
    car "Puis-je vous aider pour quoi que ce soit ?"

# game/scripts/c32/c32.rpy:2259
translate french c32s003_redecor_88cda85d:

    # mc "I have a question about my office. Is there any reason why it looks like something out of a World War II documentary?"
    mc "J'ai une question à propos de mon bureau. Y a-t-il une raison pour laquelle il ressemble à un truc sorti d'un documentaire sur la Seconde Guerre mondiale ?"

# game/scripts/c32/c32.rpy:2261
translate french c32s003_redecor_23f9e468:

    # car "Mr. Daniels had it redecorated when Mr. Richards died."
    car "M. Daniels l'a fait redécorer à la mort de M. Richards."

# game/scripts/c32/c32.rpy:2262
translate french c32s003_redecor_f8242671:

    # car "He had the side room walled off and gave it that look."
    car "Il a fait murer la pièce adjacente et lui a donné cet aspect."

# game/scripts/c32/c32.rpy:2263
translate french c32s003_redecor_c3a63e61:

    # mc "Side room?"
    mc "La pièce adjacente ?"
# game/scripts/c32/c32.rpy:2265
translate french c32s003_redecor_e5f0c54b:

    # car "Beyond the wall behind your chair there is a bedroom. Mr. Richards used it when he had to stay overnight on the premises."
    car "Derrière le mur derrière votre chaise, il y a une chambre. M. Richards l'utilisait quand il devait passer la nuit sur place."

# game/scripts/c32/c32.rpy:2266
translate french c32s003_redecor_b3868a15:

    # car "Mr. Daniels said it wasn't necessary. Initially he planned to use it as an extra filing room, but in the end, he decided to wall it off."
    car "M. Daniels a dit que ce n'était pas nécessaire. Au départ, il prévoyait de l'utiliser comme salle d'archives supplémentaire, mais au final, il a décidé de la murer."

# game/scripts/c32/c32.rpy:2268
translate french c32s003_redecor_0b2f3354:

    # car "Would you like to recover the room with the office renovation?"
    car "Aimeriez-vous récupérer la pièce avec la rénovation du bureau ?"

# game/scripts/c32/c32.rpy:2269
translate french c32s003_redecor_49413162:

    # mc "I hadn't thought about renovating it, I just thought about a coat of paint and furniture... from the 21st century."
    mc "Je n'avais pas pensé à le rénover, je pensais juste à un coup de peinture et à des meubles... du 21e siècle."

# game/scripts/c32/c32.rpy:2270
translate french c32s003_redecor_c70365a8:

    # mc "Sometimes I feel like General Eisenhower in that office."
    mc "Parfois, j'ai l'impression d'être le général Eisenhower dans ce bureau."

# game/scripts/c32/c32.rpy:2272
translate french c32s003_redecor_45c1e533:

    # car "That was the effect Mr. Daniels was looking for. Although he said General MacArthur."
    car "C'était l'effet que M. Daniels recherchait. Bien qu'il ait parlé du général MacArthur."

# game/scripts/c32/c32.rpy:2273
translate french c32s003_redecor_40f73263:

    # car "I can take care of the painting and the furniture if you want."
    car "Je peux m'occuper de la peinture et des meubles si vous voulez."

# game/scripts/c32/c32.rpy:2274
translate french c32s003_redecor_c868a26a:

    # car "And opening up the room wouldn't be too much of a problem if it's done before painting."
    car "Et ouvrir la pièce ne poserait pas trop de problème si c'est fait avant la peinture."

# game/scripts/c32/c32.rpy:2275
translate french c32s003_redecor_4fa9b471:

    # mc "Sounds like a good idea to me. I think it's a waste of space to have a walled-off room."
    mc "Ça me semble être une bonne idée. Je trouve que c'est du gâchis d'espace d'avoir une pièce murée."

# game/scripts/c32/c32.rpy:2277
translate french c32s003_redecor_723ce434:

    # car "Don't worry, then. I'll make a few calls and have it done in less than a week."
    car "Ne vous en faites pas, alors. Je vais passer quelques coups de fil et ce sera fait en moins d'une semaine."

# game/scripts/c32/c32.rpy:2278
translate french c32s003_redecor_da378e55:

    # mc "Thank you, [car]."
    mc "Merci, [car]."
# game/scripts/c32/c32.rpy:2279
translate french c32s003_redecor_28091c3e:

    # mc "Other than that, can I ask you a favor?"
    mc "À part ça, je peux vous demander un service ?"

# game/scripts/c32/c32.rpy:2281
translate french c32s003_redecor_75ac0b65:

    # "The tiny woman almost seems offended, but you find it hard to read her expressions."
    "La petite femme semble presque offensée, mais tu as du mal à lire ses expressions."

# game/scripts/c32/c32.rpy:2282
translate french c32s003_redecor_c7b34bf9:

    # car "If it's work, it's not a favor. I am your secretary."
    car "Si c'est pour le travail, ce n'est pas un service. Je suis votre secrétaire."

# game/scripts/c32/c32.rpy:2283
translate french c32s003_redecor_2227724b:

    # mc "I've tried scanning a couple of photos with the scanner in my office, but I can't get the resolution I want."
    mc "J'ai essayé de scanner quelques photos avec le scanner de mon bureau, mais je n'arrive pas à obtenir la résolution que je veux."

# game/scripts/c32/c32.rpy:2284
translate french c32s003_redecor_b27a59ef:

    # mc "Is there a higher resolution scanner I could use?"
    mc "Est-ce qu'il y a un scanner avec une meilleure résolution que je pourrais utiliser ?"

# game/scripts/c32/c32.rpy:2286
translate french c32s003_redecor_7409ba52:

    # car "The scanner in your office is several years old and... it's not very good. The previous CEOs never used it."
    car "Le scanner de votre bureau a plusieurs années et... il n'est pas très performant. Les anciens PDG ne l'ont jamais utilisé."

# game/scripts/c32/c32.rpy:2287
translate french c32s003_redecor_3c0196bf:

    # "It's the first time she hasn't referred to them by their last names. Maybe it's not a lost cause after all."
    "C'est la première fois qu'elle ne les appelle pas par leur nom de famille. Ce n'est peut-être pas une cause perdue après tout."

# game/scripts/c32/c32.rpy:2288
translate french c32s003_redecor_28f6891b:

    # car "If you leave the photos with me, I can send someone to scan them on the high-resolution scanner in [mael]'s office."
    car "Si vous me laissez les photos, je peux envoyer quelqu'un les scanner sur le scanner haute résolution dans le bureau de [mael]."

# game/scripts/c32/c32.rpy:2289
translate french c32s003_redecor_3a2aaf61:

    # "A shiver runs down your spine. You're not willing to part with the photos and let [car] give them to someone."
    "Un frisson te parcourt le dos. Tu n'as pas envie de te séparer des photos et de laisser [car] les confier à quelqu'un."

# game/scripts/c32/c32.rpy:2290
translate french c32s003_redecor_512c21ab:

    # "They are the only existing copies and you wouldn't want anything to happen to them."
    "Ce sont les seules copies existantes et tu ne voudrais pas qu'il leur arrive quelque chose."

# game/scripts/c32/c32.rpy:2292
translate french c32s003_redecor_63f9c6de:

    # "The old woman catches your hesitation, though she misinterprets it."
    "La vieille femme remarque ton hésitation, bien qu'elle l'interprète mal."

# game/scripts/c32/c32.rpy:2293
translate french c32s003_redecor_ae0636cd:

    # car "Although if it's something too private... I can tell [mael] that you'll go scan them yourself."
    car "Mais si c'est quelque chose de trop privé... Je peux dire à [mael] que vous irez les scanner vous-même."

# game/scripts/c32/c32.rpy:2294
translate french c32s003_redecor_0e6edf94:

    # mc "It's not that it's private, but... I wouldn't want anything to happen to these photos. They're unique and there are no other copies."
    mc "Ce n'est pas que ce soit privé, mais... Je ne voudrais pas qu'il arrive quoi que ce soit à ces photos. Elles sont uniques et il n'y a pas d'autres copies."

# game/scripts/c32/c32.rpy:2295
translate french c32s003_redecor_e5f0650e:

    # mc "I wouldn't feel comfortable if you gave them to someone to scan and they got damaged."
    mc "Je ne serais pas tranquille si vous les donniez à quelqu'un pour les scanner et qu'elles soient endommagées."

# game/scripts/c32/c32.rpy:2297
translate french c32s003_redecor_52498c2f:

    # "The secretary visibly relaxes."
    "La secrétaire se détend visiblement."

# game/scripts/c32/c32.rpy:2298
translate french c32s003_redecor_bd286382:

    # car "If you want, I can personally take care of scanning them. I promise nothing will happen to them."
    car "Si vous voulez, je peux m'occuper personnellement de les scanner. Je vous promets qu'il ne leur arrivera rien."

# game/scripts/c32/c32.rpy:2299
translate french c32s003_redecor_590c887f:

    # mc "I wouldn't want to be a bother. It's not exactly a work matter."
    mc "Je ne voudrais pas vous déranger. Ce n'est pas vraiment lié au travail."

# game/scripts/c32/c32.rpy:2300
translate french c32s003_redecor_0583db68:

    # car "It's no bother. It's just a couple of photos..."
    car "Ce n'est pas un dérangement. Ce ne sont que deux photos..."

# game/scripts/c32/c32.rpy:2301
translate french c32s003_redecor_e04f1e3e:

    # mc "Alright. Thank you very much, [car]."
    mc "Très bien. Merci beaucoup, [car]."

# game/scripts/c32/c32.rpy:2303
translate french c32s003_redecor_1f05ae37:

    # "After handing her an envelope with the two polaroids, you go to your office and start reading reports from [aar] and [vin]."
    "Après lui avoir remis une enveloppe avec les deux polaroïds, vous allez dans votre bureau et commencez à lire les rapports de [aar] et [vin]."

# game/scripts/c32/c32.rpy:2304
translate french c32s003_redecor_9c4fc14b:

    # "After a few minutes..."
    "Après quelques minutes..."

# game/scripts/c32/c32.rpy:2305
translate french c32s003_redecor_4df7da16:

    # car "*Through the wall* *SURPRISED GASP*"
    car "*À travers le mur* *HOQUET DE SURPRISE*"
# game/scripts/c32/c32.rpy:2307
translate french c32s003_redecor_88e7e3af:

    # "You quickly leave the room and find her looking at Fiona's photo. Almost afraid to touch it."
    "Tu sors rapidement de la pièce et tu la trouves en train de regarder la photo de Fiona. Presque effrayée de la toucher."

# game/scripts/c32/c32.rpy:2308
translate french c32s003_redecor_231bd4d0:

    # mc "Are you okay, [car]?"
    mc "Ça va, [car] ?"

# game/scripts/c32/c32.rpy:2309
translate french c32s003_redecor_b801e032:

    # car "No."
    car "Non."

# game/scripts/c32/c32.rpy:2311
translate french c32s003_redecor_3536ec54:

    # car "I didn't know any photos of Fiona existed..."
    car "Je ne savais pas qu'il existait des photos de Fiona..."

# game/scripts/c32/c32.rpy:2312
translate french c32s003_redecor_8cd60998:

    # mc "[ama] had them hidden for fear that someone would take them from her."
    mc "[ama] les avait cachées de peur qu'on les lui prenne."

# game/scripts/c32/c32.rpy:2314
translate french c32s003_redecor_eb74dd5d:

    # car "If Daniels or Richards had known, they surely would have taken it from her."
    car "Si Daniels ou Richards l'avaient su, ils la lui auraient sûrement prise."

# game/scripts/c32/c32.rpy:2315
translate french c32s003_redecor_c935a5ce:

    # "You can't help but notice the absence of 'Mr.' in her sentence."
    "Tu ne peux pas t'empêcher de remarquer l'absence de 'M.' dans sa phrase."

# game/scripts/c32/c32.rpy:2316
translate french c32s003_redecor_b6f5f1d9:

    # mc "Now, no one is going to take them away. But they are the only copies and I want to have them in digital format, to try to enhance them."
    mc "Maintenant, personne ne va les lui prendre. Mais ce sont les seules copies et je veux les avoir au format numérique, pour essayer de les améliorer."

# game/scripts/c32/c32.rpy:2318
translate french c32s003_redecor_22422a74:

    # car "Do you mind if I make a copy for myself? Of both photos. Please."
    car "Ça te dérange si je m'en fais une copie ? Des deux photos. S'il te plaît."

# game/scripts/c32/c32.rpy:2319
translate french c32s003_redecor_497f5eba:

    # "The pitiful tone in her voice makes it very hard for you to refuse. But they aren't your photos."
    "Le ton pitoyable de sa voix fait qu'il t'est très difficile de refuser. Mais ce ne sont pas tes photos."

# game/scripts/c32/c32.rpy:2320
translate french c32s003_redecor_9c795e23:

    # mc "I guess there won't be a problem, but let me check with [ama]. The photos aren't mine and..."
    mc "Je suppose qu'il n'y aura pas de problème, mais laisse-moi vérifier avec [ama]. Les photos ne sont pas à moi et..."
# game/scripts/c32/c32.rpy:2322
translate french c32s003_redecor_86c8a592:

    # car "Thank you, Mr. Marks."
    car "Merci, M. Marks."

# game/scripts/c32/c32.rpy:2323
translate french c32s003_redecor_702cd021:

    # "The surprise of the inappropriate hug makes you forget to remind her to call you [mc]. A missed opportunity to tip the battle in your favor."
    "La surprise de ce câlin inapproprié vous fait oublier de lui rappeler de vous appeler [mc]. Une occasion manquée de faire pencher la balance en votre faveur."

# game/scripts/c32/c32.rpy:2324
translate french c32s003_redecor_064d56ed:

    # mc "You care about the girls, don't you?"
    mc "Vous tenez aux filles, n'est-ce pas ?"

# game/scripts/c32/c32.rpy:2326
translate french c32s003_redecor_5a861ad9:

    # car "I've seen every one of the series born, Mr. Marks. I care about all of them."
    car "J'ai vu naître chacune des séries, M. Marks. Je tiens à tous."

# game/scripts/c32/c32.rpy:2327
translate french c32s003_redecor_6876b3f1:

    # car "But with the girls... I don't know... the feeling is a bit different."
    car "Mais avec les filles... Je ne sais pas... le sentiment est un peu différent."

# game/scripts/c32/c32.rpy:2329
translate french c32s003_redecor_48ebb23a:

    # car "I cradled them all when they were born. They were the only ones they let me do that with."
    car "Je les ai toutes bercées à leur naissance. Ce sont les seules avec qui ils m'ont laissée faire ça."

# game/scripts/c32/c32.rpy:2331
translate french c32s003_redecor_228c02bc:

    # car "I'm so glad that [ama] and [eva] have found their family after all these years."
    car "Je suis tellement heureuse qu'[ama] et [eva] aient retrouvé leur famille après toutes ces années."

# game/scripts/c32/c32.rpy:2332
translate french c32s003_redecor_ccb117ab:

    # car "I was happy when I found out they had met [mar] and [nor]. Also for [aar]."
    car "J'étais heureuse quand j'ai appris qu'elles avaient rencontré [mar] et [nor]. Aussi pour [aar]."

# game/scripts/c32/c32.rpy:2333
translate french c32s003_redecor_ffe26750:

    # mc "It seems they've enjoyed it more than [aar]."
    mc "On dirait qu'elles ont plus apprécié ça qu'[aar]."

# game/scripts/c32/c32.rpy:2335
translate french c32s003_redecor_9614a4a5:

    # car "[aar] is from the first series. Alfred and Arnau were his family. Later they 'adopted' the girls."
    car "[aar] est de la première série. Alfred et Arnau étaient sa famille. Plus tard, ils ont 'adopté' les filles."

# game/scripts/c32/c32.rpy:2336
translate french c32s003_redecor_5b93ff25:

    # car "The girls grew up as a group of six, and the A's were like their older cousins."
    car "Les filles ont grandi en un groupe de six, et les A étaient comme leurs grands cousins."
# game/scripts/c32/c32.rpy:2337
translate french c32s003_redecor_8148a000:

    # car "The B's and C's were also there, and then the rest of the series arrived. They have a broader concept of family."
    car "Les B et les C étaient là aussi, et puis le reste de la série est arrivé. Ils ont un concept plus large de la famille."

# game/scripts/c32/c32.rpy:2338
translate french c32s003_redecor_d56b9c53:

    # mc "I understand."
    mc "Je comprends."

# game/scripts/c32/c32.rpy:2340
translate french c32s003_redecor_0a0ecd13:

    # car "Someday, I'd like to be able to meet [emm], [dap], and [eri]. To see where my girls came from."
    car "Un jour, j'aimerais pouvoir rencontrer [emm], [dap] et [eri]. Pour voir d'où viennent mes filles."

# game/scripts/c32/c32.rpy:2341
translate french c32s003_redecor_ae3d316b:

    # mc "I'm sure you will. The three of them are looking forward to coming to see the company."
    mc "Je suis sûr que tu pourras. Toutes les trois ont hâte de venir voir l'entreprise."

# game/scripts/c32/c32.rpy:2342
translate french c32s003_redecor_9dabb949:

    # mc "Knowing how you feel about them, I'm sure they'll come even sooner than planned."
    mc "Sachant ce que tu ressens pour elles, je suis sûr qu'elles viendront encore plus tôt que prévu."

# game/scripts/c32/c32.rpy:2344
translate french c32s003_redecor_86c8a592_1:

    # car "Thank you, Mr. Marks."
    car "Merci, M. Marks."

# game/scripts/c32/c32.rpy:2345
translate french c32s003_redecor_42cfac64:

    # mc "[mc]. Or I'll have to tell them not to come to the island."
    mc "[mc]. Ou je devrai leur dire de ne pas venir sur l'île."

# game/scripts/c32/c32.rpy:2347
translate french c32s003_redecor_d559e15b:

    # car "I looked for their mothers. They're partly here because of me."
    car "J'ai cherché leurs mères. Elles sont en partie ici grâce à moi."

# game/scripts/c32/c32.rpy:2348
translate french c32s003_redecor_0d668228:

    # car "And, someday, I'd like to be able to meet [emm], [dap], and [eri]."
    car "Et, un jour, j'aimerais pouvoir rencontrer [emm], [dap] et [eri]."

# game/scripts/c32/c32.rpy:2349
translate french c32s003_redecor_353b3527:

    # mc "Wait... Did you say you looked for their mothers?"
    mc "Attends... Tu as dit que tu avais cherché leurs mères ?"

# game/scripts/c32/c32.rpy:2351
translate french c32s003_redecor_1b13cfa0:

    # car "Yes. Low-income women from the city. Women who wanted abortions."
    car "Oui. Des femmes à faibles revenus de la ville. Des femmes qui voulaient avorter."
# game/scripts/c32/c32.rpy:2352
translate french c32s003_redecor_74d945ef:

    # car "It wasn't hard to ask them to give them up to the company for adoption. In exchange for financial compensation."
    car "Ce n'était pas difficile de leur demander de les confier à l'entreprise pour l'adoption. En échange d'une compensation financière."

# game/scripts/c32/c32.rpy:2353
translate french c32s003_redecor_11dc2b83:

    # mc "Do we keep in touch with them? Do we know where they are?"
    mc "Est-ce qu'on garde contact avec elles ? Est-ce qu'on sait où elles sont ?"

# game/scripts/c32/c32.rpy:2355
translate french c32s003_redecor_ad4624d6:

    # car "The company never had any interest in them after paying them. And, without resources, I lost track of most of them."
    car "L'entreprise ne s'est plus jamais intéressée à elles après les avoir payées. Et, sans ressources, j'ai perdu la trace de la plupart d'entre elles."

# game/scripts/c32/c32.rpy:2356
translate french c32s003_redecor_fe480c24:

    # car "I know Clarice and [eva]'s mothers died. Drugs... But I don't have any information about the rest."
    car "Je sais que les mères de Clarice et d'[eva] sont mortes. La drogue... Mais je n'ai aucune information sur les autres."

# game/scripts/c32/c32.rpy:2357
translate french c32s003_redecor_a31a153d:

    # mc "Do you want a new assignment?"
    mc "Vous voulez une nouvelle mission ?"

# game/scripts/c32/c32.rpy:2359
translate french c32s003_redecor_f4f918b4:

    # car "What? Really?"
    car "Quoi ? Vraiment ?"

# game/scripts/c32/c32.rpy:2360
translate french c32s003_redecor_dc610d7b:

    # mc "I think [ama] should have the right to meet her biological mother, if it's possible and if she wants to."
    mc "Je pense qu'[ama] devrait avoir le droit de rencontrer sa mère biologique, si c'est possible et si elle le veut."

# game/scripts/c32/c32.rpy:2362
translate french c32s003_redecor_579c675a:

    # car "Thank you, Mr. Marks. I'll get on it right away."
    car "Merci, M. Marks. Je m'y mets tout de suite."

# game/scripts/c32/c32.rpy:2363
translate french c32s003_redecor_2067cae6:

    # mc "[mc]. Or I'll have to cancel the assignment."
    mc "[mc]. Ou je vais devoir annuler la mission."

# game/scripts/c32/c32.rpy:2364
translate french c32s003_redecor_9845723d:

    # car "Thank you, [mc]."
    car "Merci, [mc]."

# game/scripts/c32/c32.rpy:2365
translate french c32s003_redecor_1bc7d8fc:

    # "It seems like the name gets stuck in her throat when she says it. But it's a small victory."
    "On dirait que le nom lui reste en travers de la gorge quand elle le prononce. Mais c'est une petite victoire."
# game/scripts/c32/c32.rpy:2370
translate french c32s003_MaelDrug_58586704:

    # "A few hours later, during the meeting with [mael], after explaining the idea of isolating the aging gene..."
    "Quelques heures plus tard, lors de la réunion avec [mael], après avoir expliqué l'idée d'isoler le gène du vieillissement..."

# game/scripts/c32/c32.rpy:2371
translate french c32s003_MaelDrug_9712c73b:

    # mael "That's impossible!"
    mael "C'est impossible !"

# game/scripts/c32/c32.rpy:2372
translate french c32s003_MaelDrug_509403a1:

    # mc "I'm not going to tell you what is and isn't possible in your field, [mael]."
    mc "Je ne vais pas te dire ce qui est possible ou non dans ton domaine, [mael]."

# game/scripts/c32/c32.rpy:2373
translate french c32s003_MaelDrug_f4408e3a:

    # mc "But you were the one who talked about frontier research. I think this is an opportunity."
    mc "Mais c'est toi qui as parlé de recherche de pointe. Je pense que c'est une opportunité."

# game/scripts/c32/c32.rpy:2375
translate french c32s003_MaelDrug_eb57254e:

    # mael "But isolating the accelerated aging gene organ by organ?"
    mael "Mais isoler le gène du vieillissement accéléré organe par organe ?"

# game/scripts/c32/c32.rpy:2376
translate french c32s003_MaelDrug_18d740f1:

    # mael "That is decidedly insane. It can't be done."
    mael "C'est complètement dingue. C'est infaisable."

# game/scripts/c32/c32.rpy:2377
translate french c32s003_MaelDrug_efda01e9:

    # mc "I'm just asking you to take a look into it and think about what you might need to do it."
    mc "Je te demande juste d'y jeter un œil et de réfléchir à ce dont tu pourrais avoir besoin pour le faire."

# game/scripts/c32/c32.rpy:2378
translate french c32s003_MaelDrug_4edf14e6:

    # mc "Or to run the necessary tests to rule it out completely."
    mc "Ou de faire les tests nécessaires pour l'écarter complètement."

# game/scripts/c32/c32.rpy:2380
translate french c32s003_MaelDrug_f84d661f:

    # mael "There's no need to run any tests. We already did them years ago when we were researching how to stop aging after a certain age."
    mael "Il n'y a pas besoin de faire de tests. Nous les avons déjà faits il y a des années quand nous cherchions comment arrêter le vieillissement après un certain âge."

# game/scripts/c32/c32.rpy:2381
translate french c32s003_MaelDrug_ba2ba4d9:

    # mael "You either accelerate everything or slow everything down. You can't make the brain age without aging the lungs."
    mael "Soit on accélère tout, soit on ralentit tout. On ne peut pas faire vieillir le cerveau sans faire vieillir les poumons."

# game/scripts/c32/c32.rpy:2382
translate french c32s003_MaelDrug_a243cd23:

    # mael "And you can't slow down bone growth without slowing down liver growth."
    mael "Et on ne peut pas ralentir la croissance osseuse sans ralentir celle du foie."
# game/scripts/c32/c32.rpy:2383
translate french c32s003_MaelDrug_ea336610:

    # mc "Wait. Were there tests done to eliminate accelerated aging?"
    mc "Attends. Des tests ont été faits pour éliminer le vieillissement accéléré ?"

# game/scripts/c32/c32.rpy:2385
translate french c32s003_MaelDrug_df37c1a0:

    # mael "Not to eliminate it, but to slow it down. So the clones would age at a... more or less normal rate."
    mael "Pas pour l'éliminer, mais pour le ralentir. Pour que les clones vieillissent à un rythme... plus ou moins normal."

# game/scripts/c32/c32.rpy:2386
translate french c32s003_MaelDrug_ccada870:

    # mc "I guess you failed. They still age at an accelerated rate. Except for the girls, of course."
    mc "Je suppose que vous avez échoué. Ils vieillissent toujours à un rythme accéléré. Sauf les filles, bien sûr."

# game/scripts/c32/c32.rpy:2388
translate french c32s003_MaelDrug_7e865ac5:

    # mael "We didn't fail! The experiment was a success. We managed to slow down aging to 1.064!"
    mael "Nous n'avons pas échoué ! L'expérience a été un succès. Nous avons réussi à ralentir le vieillissement à 1,064 !"

# game/scripts/c32/c32.rpy:2389
translate french c32s003_MaelDrug_a12ae5a8:

    # mael "And it's independent of the series. It doesn't matter if it's an A, which ages at 3x, or a J, which ages at 1.7x."
    mael "Et c'est indépendant de la série. Peu importe que ce soit un A, qui vieillit à 3x, ou un J, qui vieillit à 1,7x."

# game/scripts/c32/c32.rpy:2390
translate french c32s003_MaelDrug_22ed5e2e:

    # mc "Then why does [aar] look like my grandpa?"
    mc "Alors pourquoi [aar] ressemble à mon grand-père ?"

# game/scripts/c32/c32.rpy:2392
translate french c32s003_MaelDrug_3c96a823:

    # mael "Because it's expensive and neither Richards nor Daniels saw any benefit in it."
    mael "Parce que c'est cher et que ni Richards ni Daniels n'y ont vu d'intérêt."

# game/scripts/c32/c32.rpy:2393
translate french c32s003_MaelDrug_561d5c00:

    # mael "If you have replacements for the clones that you eventually have to retire for being too old... It's cheaper."
    mael "Si vous avez des remplaçants pour les clones que vous devez finir par retirer parce qu'ils sont trop vieux... C'est moins cher."

# game/scripts/c32/c32.rpy:2394
translate french c32s003_MaelDrug_3e7eeba9:

    # mc "Are you telling me we're taking years of life away from the guys over money?"
    mc "Tu me dis qu'on vole des années de vie aux gars pour une question de fric ?"

# game/scripts/c32/c32.rpy:2395
translate french c32s003_MaelDrug_23349408:

    # mc "Do you think that's normal? How much money are we talking about?"
    mc "Tu trouves ça normal ? De combien d'argent on parle ?"

# game/scripts/c32/c32.rpy:2397
translate french c32s003_MaelDrug_90a456b8:

    # mael "Yes. It was an economic decision."
    mael "Oui. C'était une décision économique."
# game/scripts/c32/c32.rpy:2398
translate french c32s003_MaelDrug_2c48e42c:

    # mael "But it's not a decision I had to make. That has to be decided by the person sitting behind this desk."
    mael "Mais ce n'est pas une décision que j'avais à prendre. Ça doit être décidé par la personne assise derrière ce bureau."

# game/scripts/c32/c32.rpy:2399
translate french c32s003_MaelDrug_ace6a4ce:

    # mc "Okay, but how much money are we talking about?"
    mc "D'accord, mais on parle de combien d'argent ?"

# game/scripts/c32/c32.rpy:2401
translate french c32s003_MaelDrug_1845bfe5:

    # mael "The experiments were 'expensive', but if mass production of the drug were implemented, about $5,000 or $6,000 a year per clone."
    mael "Les expériences étaient 'coûteuses', mais si la production en masse du médicament était mise en place, ça reviendrait à environ 5 000 ou 6 000 $ par an et par clone."

# game/scripts/c32/c32.rpy:2402
translate french c32s003_MaelDrug_e055ccbb:

    # "You do some quick mental math..."
    "Tu fais un rapide calcul mental..."

# game/scripts/c32/c32.rpy:2403
translate french c32s003_MaelDrug_0cf5685b:

    # mc "That's less than 3 million a year for the 426 clones! You spend way more than that every month on research equipment."
    mc "C'est moins de 3 millions par an pour les 426 clones ! Tu dépenses bien plus que ça chaque mois en équipement de recherche."

# game/scripts/c32/c32.rpy:2405
translate french c32s003_MaelDrug_ec54a8bd:

    # mael "The research equipment is necessary."
    mael "L'équipement de recherche est nécessaire."

# game/scripts/c32/c32.rpy:2406
translate french c32s003_MaelDrug_8cd2bc9c:

    # mc "And giving our boys a life is also necessary. They're not spare parts anymore, nor are they expendable."
    mc "Et donner une vie à nos gars est aussi nécessaire. Ce ne sont plus des pièces de rechange, ni des pions sacrifiables."

# game/scripts/c32/c32.rpy:2407
translate french c32s003_MaelDrug_eddf5070:

    # mc "I'll find where to get the 3 million to allocate to the manufacturing and distribution of the drug."
    mc "Je trouverai où prendre les 3 millions pour les allouer à la fabrication et à la distribution du médicament."

# game/scripts/c32/c32.rpy:2409
translate french c32s003_MaelDrug_89557db6:

    # mael "As long as you don't touch my research equipment expenses."
    mael "Tant que tu ne touches pas à mes dépenses d'équipement de recherche."

# game/scripts/c32/c32.rpy:2410
translate french c32s003_MaelDrug_f8b9c421:

    # mael "If you cut back on that, I won't be able to clone your pancreas."
    mael "Si tu réduis ça, je ne pourrai pas cloner ton pancréas."

# game/scripts/c32/c32.rpy:2411
translate french c32s003_MaelDrug_6b40592f:

    # mc "My pancreas?"
    mc "Mon pancréas ?"
# game/scripts/c32/c32.rpy:2413
translate french c32s003_MaelDrug_22c35b07:

    # mael "You asked me to clone individual organs and to start with a pancreas."
    mael "Tu m'as demandé de cloner des organes individuels et de commencer par un pancréas."

# game/scripts/c32/c32.rpy:2414
translate french c32s003_MaelDrug_04dd84a9:

    # mc "*Laugh* I didn't ask you to start with a pancreas. It was an example. I don't care if it's a kidney or a heart."
    mc "*Rires* Je ne t'ai pas demandé de commencer par un pancréas. C'était un exemple. Je m'en fous que ce soit un rein ou un cœur."

# game/scripts/c32/c32.rpy:2415
translate french c32s003_MaelDrug_ef0f5b2f:

    # mc "I want you to research how to clone individual organs. And I want to be able to clone them from a donor of any age."
    mc "Je veux que tu fasses des recherches sur la façon de cloner des organes individuels. Et je veux pouvoir les cloner à partir d'un donneur de n'importe quel âge."

# game/scripts/c32/c32.rpy:2417
translate french c32s003_MaelDrug_df4f15f3:

    # mael "That complicates everything. Our process starts from embryonic tissue, not fully formed organs."
    mael "Ça complique tout. Notre processus part de tissus embryonnaires, pas d'organes complètement formés."

# game/scripts/c32/c32.rpy:2418
translate french c32s003_MaelDrug_e68efedd:

    # mc "Can it be done?"
    mc "C'est faisable ?"

# game/scripts/c32/c32.rpy:2420
translate french c32s003_MaelDrug_79de1b96:

    # mael "With enough money and time... We can research it, if there's an organ to clone. At least at first."
    mael "Avec assez d'argent et de temps... On peut faire des recherches, s'il y a un organe à cloner. Du moins au début."

# game/scripts/c32/c32.rpy:2421
translate french c32s003_MaelDrug_2b384a36:

    # mael "I don't think we could clone [gav]'s right arm, because it doesn't exist anymore. Not even if we started with his left arm."
    mael "Je ne pense pas qu'on pourrait cloner le bras droit de [gav], parce qu'il n'existe plus. Même si on commençait avec son bras gauche."

# game/scripts/c32/c32.rpy:2422
translate french c32s003_MaelDrug_a0bec804:

    # "At that moment you realize that, for some reason, you were expecting a different answer."
    "À ce moment-là, tu réalises que, pour une raison quelconque, tu t'attendais à une réponse différente."

# game/scripts/c32/c32.rpy:2423
translate french c32s003_MaelDrug_b56402af:

    # "[mee]'s uterus comes to mind for a second. It's a shame that it's not even a possibility."
    "L'utérus de [mee] te vient à l'esprit pendant une seconde. C'est dommage que ce ne soit même pas une possibilité."

# game/scripts/c32/c32.rpy:2424
translate french c32s003_MaelDrug_3614ef2c:

    # mc "Alright, I won't cut your research budget."
    mc "D'accord, je ne réduirai pas ton budget de recherche."

# game/scripts/c32/c32.rpy:2425
translate french c32s003_MaelDrug_a953d617:

    # mc "I have another question. The drug to stop aging...?"
    mc "J'ai une autre question. Le médicament pour arrêter de vieillir... ?"
# game/scripts/c32/c32.rpy:2427
translate french c32s003_MaelDrug_d43a98dc:

    # mael "To slow it down so it's almost normal."
    mael "Pour le ralentir afin que ce soit presque normal."

# game/scripts/c32/c32.rpy:2428
translate french c32s003_MaelDrug_361a803d:

    # mc "Okay. The drug to slow down aging so it's almost normal, would it be applicable to people who age at a normal rate?"
    mc "D'accord. Le médicament pour ralentir le vieillissement afin qu'il soit presque normal, serait-il applicable aux personnes qui vieillissent à un rythme normal ?"

# game/scripts/c32/c32.rpy:2429
translate french c32s003_MaelDrug_19b471f4:

    # mc "It could be the ultimate anti-aging cream and [flo] would be very happy to sell it."
    mc "Ça pourrait être la crème anti-âge ultime et [flo] serait très heureux de la vendre."

# game/scripts/c32/c32.rpy:2431
translate french c32s003_MaelDrug_ae84133e:

    # mael "Have you ever looked in a mirror? You look older than you are."
    mael "Tu t'es déjà regardé dans un miroir ? Tu fais plus vieux que ton âge."

# game/scripts/c32/c32.rpy:2432
translate french c32s003_MaelDrug_d10adfea:

    # mc "I know. But what does that have to do with anything?"
    mc "Je sais. Mais qu'est-ce que ça a à voir avec tout ça ?"

# game/scripts/c32/c32.rpy:2434
translate french c32s003_MaelDrug_d451e3f6:

    # mael "You are donor zero."
    mael "Tu es le donneur zéro."

# game/scripts/c32/c32.rpy:2435
translate french c32s003_MaelDrug_bc8b02ab:

    # mael "We didn't know it back then, but those genes that make you look older were accidentally amplified in the cloning of the A's."
    mael "Nous ne le savions pas à l'époque, mais ces gènes qui te font paraître plus vieux ont été accidentellement amplifiés lors du clonage des A."

# game/scripts/c32/c32.rpy:2436
translate french c32s003_MaelDrug_babe3941:

    # mael "We've been tweaking those genes for years so they produce accelerated growth, but not as much as in the A's."
    mael "Nous avons modifié ces gènes pendant des années pour qu'ils produisent une croissance accélérée, mais pas autant que chez les A."

# game/scripts/c32/c32.rpy:2438
translate french c32s003_MaelDrug_6bd563ed:

    # mael "Since the G's, it's 1.7. The previous management considered it the appropriate value."
    mael "Depuis les G, c'est 1,7. L'ancienne direction considérait que c'était la valeur appropriée."

# game/scripts/c32/c32.rpy:2439
translate french c32s003_MaelDrug_3a6b2480:

    # mc "Those genes? Are you telling me that all the clones have those genes that are mine?"
    mc "Ces gènes ? Tu es en train de me dire que tous les clones ont ces gènes qui sont les miens ?"

# game/scripts/c32/c32.rpy:2441
translate french c32s003_MaelDrug_d5865521:

    # mael "Yes. I thought you knew..."
    mael "Oui. Je pensais que tu le savais..."
# game/scripts/c32/c32.rpy:2442
translate french c32s003_MaelDrug_661f5220:

    # mc "I had no idea! Fuck! Somehow I'm the father to all of them!"
    mc "J'en avais aucune idée ! Putain ! D'une façon ou d'une autre, je suis leur père à tous !"

# game/scripts/c32/c32.rpy:2444
translate french c32s003_MaelDrug_423dd648:

    # mael "No. It doesn't work like that."
    mael "Non. Ça ne marche pas comme ça."

# game/scripts/c32/c32.rpy:2445
translate french c32s003_MaelDrug_94d8e2c6:

    # mc "Explain it to me like I'm an idiot."
    mc "Expliquez-moi ça comme si j'étais un idiot."

# game/scripts/c32/c32.rpy:2447
translate french c32s003_MaelDrug_3a93b443:

    # "The look on the scientist's face tells you that's what he's been doing up until now."
    "Le regard sur le visage du scientifique vous fait comprendre que c'est ce qu'il faisait jusqu'à présent."

# game/scripts/c32/c32.rpy:2448
translate french c32s003_MaelDrug_7731bf2a:

    # mael "A human has about 19,500 genes with their genetic code and around 40,000 RNA genes, which produce about three billion 'letters'."
    mael "Un humain possède environ 19 500 gènes avec son code génétique et environ 40 000 gènes d'ARN, ce qui produit environ trois milliards de 'lettres'."

# game/scripts/c32/c32.rpy:2449
translate french c32s003_MaelDrug_99cf7892:

    # mael "The accelerated aging genes are a group of fifteen 'letters'."
    mael "Les gènes de vieillissement accéléré sont un groupe de quinze 'lettres'."

# game/scripts/c32/c32.rpy:2451
translate french c32s003_MaelDrug_088a8879:

    # mael "If you take any two humans, they share 99.9%% of their DNA. 2,997,000,000 'letters'."
    mael "Si vous prenez deux humains au hasard, ils partagent 99,9%% de leur ADN. 2 997 000 000 de 'lettres'."

# game/scripts/c32/c32.rpy:2452
translate french c32s003_MaelDrug_0da02c49:

    # mael "If you take a father and a child, they share 99.95%% of their DNA. 2,998,500,000 'letters'."
    mael "Si vous prenez un père et un enfant, ils partagent 99,95%% de leur ADN. 2 998 500 000 de 'lettres'."

# game/scripts/c32/c32.rpy:2453
translate french c32s003_MaelDrug_8cdc2f2c:

    # mael "You share 2,997,000,015 'letters' with the clones. 99.9000005%%. Except with [aar], obviously."
    mael "Vous partagez 2 997 000 015 'lettres' avec les clones. 99,9000005%%. Sauf avec [aar], évidemment."

# game/scripts/c32/c32.rpy:2455
translate french c32s003_MaelDrug_724e339c:

    # mael "In any case, you're not their 'father'. And that would be oversimplifying it a lot, and explaining it for idiots."
    mael "En tout cas, vous n'êtes pas leur 'père'. Et ce serait simplifier les choses à l'extrême, et l'expliquer pour des idiots."

# game/scripts/c32/c32.rpy:2456
translate french c32s003_MaelDrug_2a13f622:

    # mael "Choosing you as donor zero and the amplification of that gene cluster caused the company's original plans to fail."
    mael "Vous choisir comme donneur zéro et l'amplification de ce groupe de gènes a fait échouer les plans initiaux de l'entreprise."
# game/scripts/c32/c32.rpy:2457
translate french c32s003_MaelDrug_5fef4978:

    # mael "On the other hand, it made us understand accelerated aging much better."
    mael "D'un autre côté, ça nous a permis de beaucoup mieux comprendre le vieillissement accéléré."

# game/scripts/c32/c32.rpy:2458
translate french c32s003_MaelDrug_58644b62:

    # mc "I understand all that... more or less. But what does it have to do with using the anti-aging drug on you or me?"
    mc "Je comprends tout ça... plus ou moins. Mais qu'est-ce que ça a à voir avec l'utilisation du médicament anti-âge sur toi ou moi ?"

# game/scripts/c32/c32.rpy:2460
translate french c32s003_MaelDrug_f2280a52:

    # mael "It could work on you because you have that gene cluster, even if it's not amplified. But the result would be almost unnoticeable."
    mael "Ça pourrait marcher sur toi parce que tu as ce groupe de gènes, même s'il n'est pas amplifié. Mais le résultat serait presque imperceptible."

# game/scripts/c32/c32.rpy:2461
translate french c32s003_MaelDrug_614d0f95:

    # mael "In your case, your skin 'ages' faster, but the rest of your body is your age. That's why you look older, but you have the energy that corresponds to your age."
    mael "Dans ton cas, ta peau 'vieillit' plus vite, mais le reste de ton corps a ton âge. C'est pour ça que tu as l'air plus vieux, mais que tu as l'énergie qui correspond à ton âge."

# game/scripts/c32/c32.rpy:2462
translate french c32s003_MaelDrug_70ca4754:

    # mael "Like I told you, we've reduced the aging to 1.064. Except for your skin, the rest of your body doesn't age at that speed."
    mael "Comme je te l'ai dit, on a réduit le vieillissement à 1,064. À l'exception de ta peau, le reste de ton corps ne vieillit pas à cette vitesse."

# game/scripts/c32/c32.rpy:2464
translate french c32s003_MaelDrug_fc765629:

    # mael "If I used it, it probably wouldn't have any effect. I don't have that gene cluster, so the drug wouldn't do anything to me."
    mael "Si je l'utilisais, ça n'aurait probablement aucun effet. Je n'ai pas ce groupe de gènes, donc le médicament ne me ferait rien."

# game/scripts/c32/c32.rpy:2466
translate french c32s003_MaelDrug_26a42c84:

    # "You see his face light up for a moment when he realizes the implications."
    "Tu vois son visage s'illuminer un instant quand il réalise les implications."

# game/scripts/c32/c32.rpy:2467
translate french c32s003_MaelDrug_79d9cb53:

    # mael "But with the right budget, I could try to replicate it for people without that gene cluster..."
    mael "Mais avec le bon budget, je pourrais essayer de le reproduire pour les personnes sans ce groupe de gènes..."

# game/scripts/c32/c32.rpy:2468
translate french c32s003_MaelDrug_951e9630:

    # mc "*Laugh* I can almost see the dollar signs in your eyes, [mael]. Don't be greedy."
    mc "*Rire* Je peux presque voir les signes du dollar dans tes yeux, [mael]. Ne sois pas trop gourmand."

# game/scripts/c32/c32.rpy:2469
translate french c32s003_MaelDrug_8b95871e:

    # mc "For now, I've agreed not to cut your budget. I still have to find three million a year for the clones' drugs."
    mc "Pour l'instant, j'ai accepté de ne pas réduire ton budget. Je dois encore trouver trois millions par an pour les médicaments des clones."

# game/scripts/c32/c32.rpy:2471
translate french c32s003_MaelDrug_30294f0f:

    # mael "I had to try..."
    mael "Il fallait bien que j'essaie..."
# game/scripts/c32/c32.rpy:2472
translate french c32s003_MaelDrug_938f5ab1:

    # mc "And, this time, I have to refuse to accept it. Maybe later."
    mc "Et, cette fois, je dois refuser de l'accepter. Peut-être plus tard."

# game/scripts/c32/c32.rpy:2473
translate french c32s003_MaelDrug_3ba3848f:

    # mc "But let's move on. We have a ton of work pending."
    mc "Mais passons à autre chose. On a une tonne de boulot en attente."

# game/scripts/c32/c32.rpy:2477
translate french c32s004_Eric_9bc69a25:

    # centered "{size=+20}{b}DAY 52 – THURSDAY{/b}{/size}"
    centered "{size=+20}{b}JOUR 52 – JEUDI{/b}{/size}"

# game/scripts/c32/c32.rpy:2478
translate french c32s004_Eric_b23037c6:

    # "The days go by too fast between meetings and various tasks."
    "Les jours passent trop vite entre les réunions et les diverses tâches."

# game/scripts/c32/c32.rpy:2479
translate french c32s004_Eric_8fb6f876:

    # "The remodeling of your office starts two days after talking about it with [car]."
    "Le réaménagement de ton bureau commence deux jours après en avoir parlé avec [car]."

# game/scripts/c32/c32.rpy:2480
translate french c32s004_Eric_497491b6:

    # "Jamaal already has the photos of [ama]."
    "Jamaal a déjà les photos de [ama]."

# game/scripts/c32/c32.rpy:2482
translate french c32s004_Eric_87a0871e:

    # "And the day comes to face [erc]."
    "Et le jour vient d'affronter [erc]."

# game/scripts/c32/c32.rpy:2483
translate french c32s004_Eric_7907732e:

    # "[ama], [aar], and you visit him in a room set up for the interrogation. NTR doesn't have an interrogation room as such."
    "[ama], [aar] et toi lui rendez visite dans une pièce aménagée pour l'interrogatoire. NTR n'a pas de salle d'interrogatoire en tant que telle."

# game/scripts/c32/c32.rpy:2484
translate french c32s004_Eric_96f93eda:

    # "[eva] participates via video conference."
    "[eva] participe par visioconférence."

# game/scripts/c32/c32.rpy:2485
translate french c32s004_Eric_e3e3223f:

    # "The plan is for you to lead the interrogation and for them to provide questions you might miss. They're too emotionally involved."
    "Le plan est que tu mènes l'interrogatoire et qu'ils fournissent les questions que tu pourrais oublier. Ils sont trop impliqués émotionnellement."

# game/scripts/c32/c32.rpy:2486
translate french c32s004_Eric_d8fed5e9:

    # erc "*Laugh* Iz thiz my execution committee?"
    erc "*Rires* C'ezt mon comité d'exécution ?"
# game/scripts/c32/c32.rpy:2487
translate french c32s004_Eric_d4a6c7aa:

    # "His pronunciation, aggravated by the lack of teeth, causes a hissing sound."
    "Sa prononciation, aggravée par l'absence de dents, provoque un sifflement."

# game/scripts/c32/c32.rpy:2488
translate french c32s004_Eric_be8b7233:

    # aar "Shut up, [erc]."
    aar "Ferme-la, [erc]."

# game/scripts/c32/c32.rpy:2489
translate french c32s004_Eric_93a93dc0:

    # mc "This is an investigative commission. There is no sentence yet."
    mc "C'est une commission d'enquête. Il n'y a pas encore de sentence."

# game/scripts/c32/c32.rpy:2491
translate french c32s004_Eric_6a5ad07a:

    # erc "I wazn't expecting that. Well, I wazn't expecting to ztill be alive at thiz point."
    erc "Je ne m'attendais paz à ça. Enfin, je ne m'attendais paz à être encore en vie à ce ztade."

# game/scripts/c32/c32.rpy:2492
translate french c32s004_Eric_bfa337e5:

    # "His defiant look and his attitude of not giving a shit about what you do freezes the blood in your veins."
    "Son regard de défi et son attitude de n'en avoir rien à foutre de ce que vous faites vous glacent le sang."

# game/scripts/c32/c32.rpy:2493
translate french c32s004_Eric_3047510e:

    # "At the same time, it makes you feel an unpleasant heat. He threatened your family. He probably would have killed you all if it hadn't been for [ama] and [eva]."
    "En même temps, cela vous fait ressentir une chaleur désagréable. Il a menacé votre famille. Il vous aurait probablement tous tués si [ama] et [eva] n'avaient pas été là."

# game/scripts/c32/c32.rpy:2494
translate french c32s004_Eric_9672b112:

    # mc "What you expected is the least of it. The company is no longer governed by the same principles as before."
    mc "Ce à quoi tu t'attendais est le cadet de nos soucis. L'entreprise n'est plus régie par les mêmes principes qu'avant."

# game/scripts/c32/c32.rpy:2495
translate french c32s004_Eric_689d9711:

    # mc "We are here to listen to your version of what happened in Newport. Your colleagues asked for it and we accepted."
    mc "Nous sommes ici pour écouter ta version de ce qui s'est passé à Newport. Tes collègues l'ont demandé et nous avons accepté."

# game/scripts/c32/c32.rpy:2497
translate french c32s004_Eric_cb3604ca:

    # "He looks, smiling, at the turned-off cameras on the wall at the back of the room."
    "Il regarde, en souriant, les caméras éteintes sur le mur au fond de la pièce."

# game/scripts/c32/c32.rpy:2498
translate french c32s004_Eric_cf9fe9ff:

    # erc "Thoze lozerz azked for thiz? I'm very zurprized."
    erc "Cez nazez ont demandé ça ? Je zuis très zurpris."

# game/scripts/c32/c32.rpy:2499
translate french c32s004_Eric_6e39e87a:

    # erc "They aren't capable of tying their bootz unlez they're ordered to."
    erc "Ilz ne zont paz capables de lacer leurz bottez à moinz qu'on leur en donne l'ordre."
# game/scripts/c32/c32.rpy:2501
translate french c32s004_Eric_e22c802c:

    # eva "Can we shoot him already? He's opened his mouth enough to make me want to be there and pull the trigger myself."
    eva "On peut le buter, maintenant ? Il a assez ouvert sa gueule pour me donner envie d'être là-bas et de presser la détente moi-même."

# game/scripts/c32/c32.rpy:2502
translate french c32s004_Eric_38a95589:

    # mc "[eva], I promised a fair review of the case. We're not going to shoot anyone. Yet."
    mc "[eva], j'ai promis un examen équitable de l'affaire. On ne va tirer sur personne. Pour le moment."

# game/scripts/c32/c32.rpy:2504
translate french c32s004_Eric_d5fdca53:

    # aar "What do you know about the Portland operation?"
    aar "Qu'est-ce que tu sais sur l'opération de Portland ?"

# game/scripts/c32/c32.rpy:2505
translate french c32s004_Eric_ff63967d:

    # aar "The operatives who survived only knew what Enzo had told them."
    aar "Les agents qui ont survécu savaient seulement ce qu'Enzo leur avait dit."

# game/scripts/c32/c32.rpy:2507
translate french c32s004_Eric_ba605928:

    # erc "I don't know anything. I waz juzt following orderz."
    erc "Je ne zaiz rien. Je zuivaiz juzte lez ordrez."

# game/scripts/c32/c32.rpy:2508
translate french c32s004_Eric_817263a7:

    # erc "The orderz were given verbally to Enzo and me. There'z no record of them."
    erc "Lez ordrez ont été donnez verbalement à Enzo et moi. Il n'y a aucune traze d'eux."

# game/scripts/c32/c32.rpy:2509
translate french c32s004_Eric_1b76cdb6:

    # mc "So we just have to take your word for it, right?"
    mc "Donc on doit juste te croire sur parole, c'est ça ?"

# game/scripts/c32/c32.rpy:2511
translate french c32s004_Eric_5cde44cb:

    # ama "Are you really going to believe him?"
    ama "Tu vas vraiment le croire ?"

# game/scripts/c32/c32.rpy:2512
translate french c32s004_Eric_f2b4dd52:

    # mc "For now, I have to believe him."
    mc "Pour l'instant, je dois le croire."

# game/scripts/c32/c32.rpy:2514
translate french c32s004_Eric_2da1df79:

    # "[ama] tenses up, holding herself back from jumping across the table and strangling the mercenary in front of her."
    "[ama] se crispe, se retenant de sauter par-dessus la table pour étrangler le mercenaire devant elle."

# game/scripts/c32/c32.rpy:2515
translate french c32s004_Eric_7d4e9da7:

    # ama "Why were the E's in charge of the operation?"
    ama "Pourquoi les E étaient-ils en charge de l'opération ?"
# game/scripts/c32/c32.rpy:2517
translate french c32s004_Eric_0a3e5299:

    # erc "Who waz Mr. Danielz going to put in charge?"
    erc "Qui M. Danielz allait-il mettre aux commandez ?"

# game/scripts/c32/c32.rpy:2518
translate french c32s004_Eric_f4f6b103:

    # erc "The Cz are old. The Dz are idiotz. The Fz... let'z juzt zay they're too young for a mizzion like that."
    erc "Lez C zont vieux. Lez D zont dez idiotz. Lez F... dizonz juzte qu'ilz zont trop jeunez pour une mizzion comme ça."

# game/scripts/c32/c32.rpy:2519
translate french c32s004_Eric_f0a0a51d:

    # erc "The only onez who could get the job done were the Ez."
    erc "Lez zeulz qui pouvaient faire le boulot, c'étaient lez E."

# game/scripts/c32/c32.rpy:2520
translate french c32s004_Eric_0e2cd135:

    # mc "Did you know the mission went against the founding principles of NTR? Against the founders' will?"
    mc "Savais-tu que la mission allait à l'encontre des principes fondateurs de NTR ? Contre la volonté des fondateurs ?"

# game/scripts/c32/c32.rpy:2522
translate french c32s004_Eric_61d3c119:

    # erc "No. We couldn't have known. He told uz that [aar] and the bitchez had betrayed uz."
    erc "Non. On ne pouvait paz zavoir. Il nouz a dit qu'[aar] et lez zalopez nouz avaient trahiz."

# game/scripts/c32/c32.rpy:2524
translate french c32s004_Eric_d6c02b2e:

    # eva "Just kill him already, please. This is a charade."
    eva "Tue-le et qu'on en finisse, s'il te plaît. C'est une mascarade."

# game/scripts/c32/c32.rpy:2525
translate french c32s004_Eric_a8f5e398:

    # mc "[eva]..."
    mc "[eva]..."

# game/scripts/c32/c32.rpy:2527
translate french c32s004_Eric_9d5efc5b:

    # erc "Our orderz were to eliminate the traitorz and a family that waz helping them."
    erc "Noz ordrez étaient d'éliminer lez traîtrez et une famille qui lez aidait."

# game/scripts/c32/c32.rpy:2528
translate french c32s004_Eric_1747fcf4:

    # erc "If I had the rezourcez I azked for, my part of the mizzion would have been completed."
    erc "Zi j'avaiz eu lez rezourcez que j'avaiz demandéez, ma partie de la mizzion aurait été accomplie."

# game/scripts/c32/c32.rpy:2529
translate french c32s004_Eric_e91435a1:

    # erc "I waz very zurprized when the orderz changed and we had to azzault your houze zo you would zign thoze paperz."
    erc "J'ai été trèz zurpriz quand lez ordrez ont changé et qu'on a dû attaquer ta maizon pour que tu zignez cez papierz."

# game/scripts/c32/c32.rpy:2530
translate french c32s004_Eric_f383cd53:

    # mc "At that moment you must have known something was wrong, right?"
    mc "À ce moment-là, tu as bien dû te douter que quelque chose clochait, non ?"
# game/scripts/c32/c32.rpy:2532
translate french c32s004_Eric_7cd83570:

    # "[aar] doesn't let him answer. He has other interests."
    "[aar] ne le laisse pas répondre. Il a d'autres intérêts."

# game/scripts/c32/c32.rpy:2533
translate french c32s004_Eric_4482125b:

    # aar "We know Enzo talked to you on the radio shortly before he died. I don't believe a word that you didn't know what was going on."
    aar "On sait qu'Enzo t'a parlé à la radio peu avant de mourir. Je ne crois pas un mot quand tu dis que tu ne savais pas ce qui se passait."

# game/scripts/c32/c32.rpy:2534
translate french c32s004_Eric_a9670929:

    # aar "What did he tell you?"
    aar "Qu'est-ce qu'il t'a dit ?"

# game/scripts/c32/c32.rpy:2535
translate french c32s004_Eric_44bb8011:

    # "He's going off the script you had planned."
    "Il s'éloigne du scénario que vous aviez prévu."

# game/scripts/c32/c32.rpy:2536
translate french c32s004_Eric_6c1bc2e1:

    # "You couldn't prevent him, [ama], and [eva] from being here, but you thought it was a bad idea from the very beginning."
    "Tu n'as pas pu l'empêcher, lui, [ama] et [eva] d'être ici, mais tu pensais que c'était une mauvaise idée depuis le tout début."

# game/scripts/c32/c32.rpy:2538
translate french c32s004_Eric_829c6962:

    # erc "You knew Enzo. He waz one of the bezt. He waz fucked. Hiz gutz were zpilling out. And you had ezcaped."
    erc "Tu connaizzaiz Enzo. C'était l'un dez meilleurz. Il était foutu. Sez tripez ze répandaient partout. Et tu t'étaiz échappé."

# game/scripts/c32/c32.rpy:2539
translate french c32s004_Eric_8d3ef995:

    # erc "He couldn't truzt the remaining Fz and Gz to find you and eliminate you."
    erc "Il ne pouvait paz faire confianze aux Fz et Gz reztantz pour te trouver et t'éliminer."

# game/scripts/c32/c32.rpy:2540
translate french c32s004_Eric_8ee0aa50:

    # "You decide to follow [aar]'s line of questioning. There will be time to go back to Newport later."
    "Tu décides de suivre la ligne d'interrogatoire de [aar]. Il sera toujours temps de revenir sur Newport plus tard."

# game/scripts/c32/c32.rpy:2541
translate french c32s004_Eric_36c48389:

    # mc "Why couldn't he trust them?"
    mc "Pourquoi il ne pouvait pas leur faire confiance ?"

# game/scripts/c32/c32.rpy:2543
translate french c32s004_Eric_5ed2fad0:

    # erc "Becauze they're uzelez if there'z no one to give them orderz."
    erc "Parze qu'ilz zont inutilez z'il n'y a perzonne pour leur donner dez ordrez."

# game/scripts/c32/c32.rpy:2544
translate french c32s004_Eric_8b510061:

    # mc "And yet, they are some of the ones who asked for this review."
    mc "Et pourtant, ce sont eux qui ont demandé cette évaluation."
# game/scripts/c32/c32.rpy:2545
translate french c32s004_Eric_33d0e91a:

    # erc "It'z another proof that they're az idiotic az the Dz and az zoft az the Cz."
    erc "C'ezt une autre preuve qu'ilz zont auzzi idiotz que lez D et auzzi mouz que lez C."

# game/scripts/c32/c32.rpy:2546
translate french c32s004_Eric_953b7128:

    # erc "But I'm innozent. I waz juzt following orderz."
    erc "Maiz je zuiz innozent. Je ne faizaiz que zuivre lez ordrez."

# game/scripts/c32/c32.rpy:2548
translate french c32s004_Eric_da795dd9:

    # eva "What did he tell you about my sisters?"
    eva "Qu'est-ce qu'il t'a dit sur mes sœurs ?"

# game/scripts/c32/c32.rpy:2549
translate french c32s004_Eric_8913186b:

    # eva "How did they die?"
    eva "Comment sont-elles mortes ?"

# game/scripts/c32/c32.rpy:2551
translate french c32s004_Eric_f8091efc:

    # erc "They died like bitchez. I know Diana begged for her life. I don't know anything about the rezt."
    erc "Ellez zont mortez comme dez zalepez. Je zaiz que Diana a zupplié pour za vie. Je ne zaiz rien pour le rezte."

# game/scripts/c32/c32.rpy:2552
translate french c32s004_Eric_ce7b088d:

    # erc "Maybe, if zhe ztill had both legz to open them, Enzo would have zpared her life."
    erc "Peut-être que zi elle avait encore zez deux jambez pour lez écarter, Enzo l'aurait épargnée."

# game/scripts/c32/c32.rpy:2553
translate french c32s004_Eric_fdfd8235:

    # erc "At leazt for a while."
    erc "Au moinz pour un tempz."

# game/scripts/c32/c32.rpy:2554
translate french c32s004_Eric_753b56db:

    # "Now you're the one who has to hold back from jumping over the table and strangling him."
    "Maintenant, c'est toi qui dois te retenir de sauter par-dessus la table pour l'étrangler."

# game/scripts/c32/c32.rpy:2556
translate french c32s004_Eric_0cbdd7e0:

    # ama "The question is, why? You knew that [aar] or we were incapable of betraying the company."
    ama "La question est, pourquoi ? Tu savais qu'[aar] ou nous étions incapables de trahir l'entreprise."

# game/scripts/c32/c32.rpy:2557
translate french c32s004_Eric_07c8b066:

    # ama "What did they promise you? You can speak honestly. You can see the cameras are off."
    ama "Qu'est-ce qu'ils t'ont promis ? Tu peux parler honnêtement. Tu vois bien que les caméras sont éteintes."

# game/scripts/c32/c32.rpy:2559
translate french c32s004_Eric_2df9b935:

    # "The cameras on the wall are off. It's not even pointing at the table where you're sitting."
    "Les caméras sur le mur sont éteintes. Elles ne pointent même pas vers la table où vous êtes assis."
# game/scripts/c32/c32.rpy:2560
translate french c32s004_Eric_9065d5b4:

    # "You knew that, if you recorded this preliminary interrogation, [erc] would clam up."
    "Tu savais que si tu enregistrais cet interrogatoire préliminaire, [erc] se braquerait."

# game/scripts/c32/c32.rpy:2562
translate french c32s004_Eric_97143b77:

    # erc "You don't underztand. You're an anomaly."
    erc "Tu ne comprendz paz. Tu ez une anomalie."

# game/scripts/c32/c32.rpy:2564
translate french c32s004_Eric_f657462e:

    # erc "You're a clone that agez at a normal rate."
    erc "Tu ez un clone qui vieillitz à une vitezze normale."

# game/scripts/c32/c32.rpy:2566
translate french c32s004_Eric_469bbe72:

    # erc "You're not one of uz, even if you were raized within theze wallz."
    erc "Tu n'ez paz l'un dez nôtrez, même zi tu az été élevé entre cez murz."

# game/scripts/c32/c32.rpy:2567
translate french c32s004_Eric_305f51ce:

    # erc "Mr. Danielz promized uz a medicine that would ztop aging if we completed the mizzion."
    erc "M. Danielz nouz a promiz un médicament qui ztopperait le vieillizzement zi nouz accomplizzionz la mizzion."

# game/scripts/c32/c32.rpy:2569
translate french c32s004_Eric_973fca28:

    # aar "And you believed him? That medicine doesn't exist! There have been rumors for years."
    aar "Et tu l'as cru ? Ce médicament n'existe pas ! Il y a des rumeurs depuis des années."

# game/scripts/c32/c32.rpy:2570
translate french c32s004_Eric_99872925:

    # aar "I thought you were smarter than that, [erc]. A son of a bitch. But a smart son of a bitch."
    aar "Je te croyais plus intelligent que ça, [erc]. Un fils de pute. Mais un fils de pute intelligent."

# game/scripts/c32/c32.rpy:2571
translate french c32s004_Eric_f9d176fc:

    # "You're not sure if calling a clone who never had a mother a 'son of a bitch' will have the same effect as it would outside this base."
    "Tu n'es pas sûr que traiter de 'fils de pute' un clone qui n'a jamais eu de mère aura le même effet qu'à l'extérieur de cette base."

# game/scripts/c32/c32.rpy:2573
translate french c32s004_Eric_5df0f3c7:

    # mc "He only promised it to Enzo and you, I suppose."
    mc "Il ne l'a promis qu'à Enzo et toi, je suppose."

# game/scripts/c32/c32.rpy:2574
translate french c32s004_Eric_f15be114:

    # erc "Of courze. We were the onez who were going to carry the weight of the mizzion, the only onez who knew what waz at ztake."
    erc "Bien zûr. Nouz étionz ceuz qui allionz porter le poidz de la mizzion, lez zeulz à zavoir ce qui était en zeu."

# game/scripts/c32/c32.rpy:2576
translate french c32s004_Eric_dc810c4f:

    # erc "But I'm zure that thiz medicine exiztz. Right?"
    erc "Maiz je zuiz zûr que ce médicament exizte. Paz vrai ?"
# game/scripts/c32/c32.rpy:2577
translate french c32s004_Eric_881b12b7:

    # "You can hear the doubt in his voice. It seems he's wondering if they did what they did chasing a fairy tale."
    "Tu peux entendre le doute dans sa voix. On dirait qu'il se demande s'ils ont fait tout ça pour courir après un conte de fées."

# game/scripts/c32/c32.rpy:2578
translate french c32s004_Eric_bb3a6d40:

    # "Maybe it's time to press him."
    "C'est peut-être le moment de lui mettre la pression."

# game/scripts/c32/c32.rpy:2579
translate french c32s004_Eric_6bb0f73d:

    # mc "The only ones who knew what was at stake? So, you were following orders, but you knew they were the wrong orders."
    mc "Les seuls à savoir ce qui était en jeu ? Donc, tu suivais les ordres, mais tu savais que c'étaient les mauvais."

# game/scripts/c32/c32.rpy:2580
translate french c32s004_Eric_8c68a61a:

    # mc "And all for a medicine that doesn't exist."
    mc "Et tout ça pour un médicament qui n'existe pas."

# game/scripts/c32/c32.rpy:2581
translate french c32s004_Eric_cbcf7ba7:

    # "Technically, that's true. The medicine doesn't {b}stop{/b} aging."
    "Techniquement, c'est vrai. Le médicament ne {b}stoppe{/b} pas le vieillissement."

# game/scripts/c32/c32.rpy:2583
translate french c32s004_Eric_97022a86:

    # erc "It really doezn't exizt? Danielz tricked uz?"
    erc "Ça n'exizte vraiment paz ? Danielz nouz a piégéz ?"

# game/scripts/c32/c32.rpy:2584
translate french c32s004_Eric_d4a4f48e:

    # "He's not Mr. Daniels anymore."
    "Ce n'est plus M. Daniels."

# game/scripts/c32/c32.rpy:2585
translate french c32s004_Eric_d78235d9:

    # mc "As the CEO of the company, I can assure you that we don't have anything that stops the aging of clones."
    mc "En tant que PDG de l'entreprise, je peux t'assurer qu'on n'a rien qui stoppe le vieillissement des clones."

# game/scripts/c32/c32.rpy:2587
translate french c32s004_Eric_7d7e6953:

    # eva "You killed my sisters for nothing, asshole. You betrayed the founders for nothing."
    eva "T'as tué mes sœurs pour rien, connard. T'as trahi les fondateurs pour que dalle."

# game/scripts/c32/c32.rpy:2588
translate french c32s004_Eric_c4cab3ea:

    # eva "There was no prize at the end of the rainbow for you, even if you had completed the mission."
    eva "Y avait pas de trésor au bout de l'arc-en-ciel pour toi, même si t'avais accompli la mission."

# game/scripts/c32/c32.rpy:2589
translate french c32s004_Eric_b99e5dbe:

    # eva "And you're going to die knowing you fucked up for nothing."
    eva "Et tu vas crever en sachant que t'as fait de la merde pour rien."
# game/scripts/c32/c32.rpy:2591
translate french c32s004_Eric_8191471c:

    # erc "Danielz promized uz that, when he took full control of NTR, we'd have thoze medz."
    erc "Danielz nouz a promiz que, quand il prendrait le contrôle total de NTR, on aurait cez médocz."

# game/scripts/c32/c32.rpy:2592
translate french c32s004_Eric_1f224aa8:

    # erc "If they don't exizt... what would he have done?"
    erc "Z'ilz n'exiztent paz... qu'ezt-ce qu'il aurait fait ?"

# game/scripts/c32/c32.rpy:2593
translate french c32s004_Eric_96012848:

    # mc "I guess the same thing he did to Arnau. You and Enzo would have disappeared without a trace."
    mc "Je suppose la même chose qu'il a faite à Arnau. Toi et Enzo auriez disparu sans laisser de trace."

# game/scripts/c32/c32.rpy:2594
translate french c32s004_Eric_9bfeb03c:

    # mc "It was a promise he couldn't keep."
    mc "C'était une promesse qu'il ne pouvait pas tenir."

# game/scripts/c32/c32.rpy:2595
translate french c32s004_Eric_8a592e2e:

    # mc "But, I feel sorry for you. A lot."
    mc "Mais, j'ai de la peine pour toi. Beaucoup."

# game/scripts/c32/c32.rpy:2597
translate french c32s004_Eric_e4bfbb50:

    # aar "Did I just hear you say you feel sorry for him? Are you crazy?"
    aar "Je viens bien d'entendre que tu as de la peine pour lui ? Tu es fou ?"

# game/scripts/c32/c32.rpy:2599
translate french c32s004_Eric_2e744139:

    # ama "If it weren't for us, he would have killed the family."
    ama "Si on n'avait pas été là, il aurait tué la famille."

# game/scripts/c32/c32.rpy:2601
translate french c32s004_Eric_b0909cdd:

    # eva "[gav] lost his arm because of him! And you've heard how he talked about my sisters!"
    eva "[gav] a perdu son bras à cause de lui ! Et tu as entendu comment il a parlé de mes sœurs !"

# game/scripts/c32/c32.rpy:2602
translate french c32s004_Eric_25d03be2:

    # "For [eva], it's easier to unload some of the guilt she feels about [gav]'s arm onto [erc]."
    "Pour [eva], c'est plus facile de décharger une partie de la culpabilité qu'elle ressent pour le bras de [gav] sur [erc]."

# game/scripts/c32/c32.rpy:2604
translate french c32s004_Eric_8b3f34bf:

    # "You understand the girls' and [aar]'s anger, but you've detected a crack in [erc]'s armor and it's time to push."
    "Tu comprends la colère des filles et d'[aar], mais tu as détecté une faille dans l'armure d'[erc] et il est temps d'appuyer là où ça fait mal."

# game/scripts/c32/c32.rpy:2605
translate french c32s004_Eric_3e6a0211:

    # mc "The reason I feel sorry for you is because you're an idiot."
    mc "La raison pour laquelle j'ai de la peine pour toi, c'est parce que tu es un idiot."
# game/scripts/c32/c32.rpy:2607
translate french c32s004_Eric_30333dc2:

    # erc "What? I'm a victim! I waz tricked!"
    erc "Quoi ? Je zuis une victime ! J'ai été piégé !"

# game/scripts/c32/c32.rpy:2608
translate french c32s004_Eric_d4fb9a25:

    # mc "You were tricked about one part, but you gave yourself away. You said 'When he took full control of NTR'."
    mc "Tu as été piégé sur un point, mais tu t'es trahi. Tu as dit 'Quand il a pris le contrôle total de NTR'."

# game/scripts/c32/c32.rpy:2609
translate french c32s004_Eric_c1969485:

    # mc "Which indicates you knew what was at stake. You knew what the mission represented."
    mc "Ce qui indique que tu savais ce qui était en jeu. Tu savais ce que la mission représentait."

# game/scripts/c32/c32.rpy:2610
translate french c32s004_Eric_8227470f:

    # mc "You knew you were betraying the rightful owners of the company."
    mc "Tu savais que tu trahissais les propriétaires légitimes de l'entreprise."

# game/scripts/c32/c32.rpy:2612
translate french c32s004_Eric_a702f618:

    # erc "Wouldn't you do it if you could live more yearz? I don't care who runz the company if I could gain 20 yearz of life."
    erc "Tu ne le feraiz paz zi tu pouvais vivre pluz d'annéez ? Je m'en fiche de zavoir qui dirige l'entreprize zi je peux gagner 20 anz de vie."

# game/scripts/c32/c32.rpy:2613
translate french c32s004_Eric_34490225:

    # erc "If I had to kill Arnau, or if we had to kill [aar] and the girlz, it waz a zmall price to pay."
    erc "Zi je devais tuer Arnau, ou zi on devait tuer [aar] et lez fillez, c'était un petit prix à payer."

# game/scripts/c32/c32.rpy:2614
translate french c32s004_Eric_5469d240:

    # erc "And if zome F or G died... deep down, they're expendable..."
    erc "Et zi certainz F ou G mouraient... au fond, ilz zont zacrifiables..."

# game/scripts/c32/c32.rpy:2615
translate french c32s004_Eric_b5dba9ee:

    # mc "I understand. And that's why I want to announce right now that what does exist is a medication that slows down aging."
    mc "Je comprends. Et c'est pourquoi je veux annoncer dès maintenant que ce qui existe, c'est un médicament qui ralentit le vieillissement."

# game/scripts/c32/c32.rpy:2617
translate french c32s004_Eric_6332ac6c:

    # aar "What? Since when?" (multiple=2)
    aar "Quoi ? Depuis quand ?" (multiple=2)

# game/scripts/c32/c32.rpy:2618
translate french c32s004_Eric_76fc3e74:

    # erc "Then it doez exizt!\nYou tricked me!" (multiple=2)
    erc "Alorz ça exizte vraiment !\nTu m'az piégé !" (multiple=2)

# game/scripts/c32/c32.rpy:2619
translate french c32s004_Eric_93fc5d9e:

    # mc "I haven't deceived you. You were talking about a drug that stops it. That doesn't exist. This one slows it down."
    mc "Je ne t'ai pas trompé. Tu parlais d'un médicament qui l'arrête. Ça n'existe pas. Celui-ci le ralentit."
# game/scripts/c32/c32.rpy:2620
translate french c32s004_Eric_eb6e9a72:

    # mc "But don't worry about semantics. You won't have access to it."
    mc "Mais ne t'inquiète pas pour la sémantique. Tu n'y auras pas accès."

# game/scripts/c32/c32.rpy:2622
translate french c32s004_Eric_779dbf67:

    # erc "What? Why?"
    erc "Quoi ? Pourquoi ?"

# game/scripts/c32/c32.rpy:2623
translate french c32s004_Eric_3ffb9a33:

    # mc "Because you didn't complete the mission. Because Daniels isn't in charge."
    mc "Parce que tu n'as pas accompli la mission. Parce que Daniels n'est pas aux commandes."

# game/scripts/c32/c32.rpy:2624
translate french c32s004_Eric_c112fea9:

    # mc "Because, even though it might seem cruel on my part, I'm not going to give that drug to someone who betrayed the company's values."
    mc "Parce que, même si ça peut paraître cruel de ma part, je ne vais pas donner cette drogue à quelqu'un qui a trahi les valeurs de l'entreprise."

# game/scripts/c32/c32.rpy:2625
translate french c32s004_Eric_53c11870:

    # mc "Because as of today, you're no longer part of the company. Even less so for being a murderer."
    mc "Parce qu'à partir d'aujourd'hui, tu ne fais plus partie de l'entreprise. Encore moins en étant un meurtrier."

# game/scripts/c32/c32.rpy:2627
translate french c32s004_Eric_953a159e:

    # erc "We didn't kill anyone in Newport."
    erc "On n'a tué personne à Newport."

# game/scripts/c32/c32.rpy:2628
translate french c32s004_Eric_54fc0f8a:

    # mc "You killed Arnau. You admitted it yourself."
    mc "Tu as tué Arnau. Tu l'as admis toi-même."

# game/scripts/c32/c32.rpy:2630
translate french c32s004_Eric_fc844581:

    # erc "You have no proof. I'll ztick to my verzion that I waz following orderz."
    erc "Tu n'as aucune preuve. Je vaiz rezter zur ma verzion que je zuivais dez ordrez."

# game/scripts/c32/c32.rpy:2631
translate french c32s004_Eric_73b8e69f:

    # mc "You're not very smart, are you? As much as you despise the other series, I think they're much smarter than you."
    mc "Tu n'es pas très malin, n'est-ce pas ? Autant tu méprises les autres séries, autant je pense qu'elles sont bien plus intelligentes que toi."

# game/scripts/c32/c32.rpy:2633
translate french c32s004_Eric_82e4eaf8:

    # erc "What are you talking about?"
    erc "De quoi tu parles ?"

# game/scripts/c32/c32.rpy:2634
translate french c32s004_Eric_a652a6ca:

    # mc "We told you this interrogation wasn't being recorded. And we weren't lying."
    mc "On t'a dit que cet interrogatoire n'était pas enregistré. Et on ne mentait pas."

# game/scripts/c32/c32.rpy:2636
translate french c32s004_Eric_978abd97:

    # mc "But [eva] is broadcasting it live to several rooms on the base, where your former comrades are watching."
    mc "Mais [eva] le diffuse en direct dans plusieurs pièces de la base, où tes anciens camarades regardent."

# game/scripts/c32/c32.rpy:2638
translate french c32s004_Eric_6d7aff13:

    # mc "You can wave to them through the laptop camera. By the way, they all have their shoelaces tied without anyone ordering them to."
    mc "Tu peux leur faire coucou par la caméra de l'ordinateur. Au fait, ils ont tous leurs lacets noués sans que personne ne leur ait ordonné de le faire."

# game/scripts/c32/c32.rpy:2640
translate french c32s004_Eric_9e1783b8:

    # "You get up from the chair without giving a single thought to the murderer sitting in front of you."
    "Tu te lèves de la chaise sans accorder la moindre pensée au meurtrier assis devant toi."

# game/scripts/c32/c32.rpy:2641
translate french c32s004_Eric_c8cd9444:

    # "You didn't meet Arnau, but between Daniels and him, they took away your chance to do so."
    "Tu n'as pas rencontré Arnau, mais entre Daniels et lui, ils t'ont enlevé toute chance de le faire."

# game/scripts/c32/c32.rpy:2642
translate french c32s004_Eric_b0aebcb1:

    # mc "I think we're done here. Shall we go?"
    mc "Je crois qu'on a fini ici. On y va ?"

# game/scripts/c32/c32.rpy:2643
translate french c32s004_Eric_8ec86340:

    # erc "You can't do thiz to me!"
    erc "Tu peux pas m'faire zça !"

# game/scripts/c32/c32.rpy:2645
translate french c32s004_Eric_60d946b5:

    # "You pick up the laptop, because saying you're picking up [eva] would sound weird, and head for the door without waiting for an answer."
    "Tu ramasses l'ordinateur portable, parce que dire que tu ramasses [eva] ferait bizarre, et tu te diriges vers la porte sans attendre de réponse."

# game/scripts/c32/c32.rpy:2646
translate french c32s004_Eric_3bfdcce0:

    # "You feel like the red-haired detective from that show when you were a kid. The only thing missing is [erc]'s head exploding behind your back."
    "Tu te sens comme le détective roux de cette série quand tu étais gamin. Il ne manque plus que la tête de [erc] qui explose dans ton dos."

# game/scripts/c32/c32.rpy:2647
translate french c32s004_Eric_84f59513:

    # "The last time you felt like this was when you met [mad.nick]'s mother."
    "La dernière fois que tu t'es senti comme ça, c'est quand tu as rencontré la mère de [mad.nick]."

# game/scripts/c32/c32.rpy:2650
translate french c32s004_Eric_fee505d3:

    # aar "When were you going to tell us about the medication?"
    aar "Quand est-ce que tu allais nous parler des médicaments ?"

# game/scripts/c32/c32.rpy:2651
translate french c32s004_Eric_d90d9db5:

    # mc "I found out it existed two days ago. Neither Richards nor Daniels thought it was necessary to give it to you."
    mc "J'ai découvert leur existence il y a deux jours. Ni Richards ni Daniels ne pensaient qu'il était nécessaire de vous les donner."
# game/scripts/c32/c32.rpy:2652
translate french c32s004_Eric_3ba0397e:

    # mc "Today I got [vin] to allocate the funds to manufacture it."
    mc "Aujourd'hui, j'ai convaincu [vin] d'allouer les fonds pour le fabriquer."

# game/scripts/c32/c32.rpy:2654
translate french c32s004_Eric_bbd28b37:

    # ama "Where is the money going to come from? We had to walk back some of the promises you made in the meeting with the operatives..."
    ama "D'où va venir l'argent ? On a dû revenir sur certaines des promesses que tu as faites lors de la réunion avec les agents..."

# game/scripts/c32/c32.rpy:2655
translate french c32s004_Eric_ac8b1d33:

    # mc "I've spoken with [mar] and [nor]. They'll accept a delay in collecting the money the company owes them."
    mc "J'ai parlé avec [mar] et [nor]. Elles accepteront un délai pour récupérer l'argent que l'entreprise leur doit."

# game/scripts/c32/c32.rpy:2656
translate french c32s004_Eric_a60341d9:

    # mc "That will cover a few months of treatment for all the clones. All but one. After that, we'll find the money."
    mc "Ça couvrira quelques mois de traitement pour tous les clones. Tous sauf un. Après ça, on trouvera l'argent."

# game/scripts/c32/c32.rpy:2658
translate french c32s004_Eric_f75af7a8:

    # eva "Hey! I'm here! Can you move me? I can only see [mc]'s armpit."
    eva "Hé ! Je suis là ! Tu peux me déplacer ? Je ne vois que l'aisselle de [mc]."

# game/scripts/c32/c32.rpy:2659
translate french c32s004_Eric_fd98ea7c:

    # mc "Sorry, [eva]."
    mc "Désolé, [eva]."

# game/scripts/c32/c32.rpy:2661
translate french c32s004_Eric_1e6f8569:

    # eva "Thanks. I've already cut the broadcast to the meeting rooms."
    eva "Merci. J'ai déjà coupé la diffusion vers les salles de réunion."

# game/scripts/c32/c32.rpy:2662
translate french c32s004_Eric_b74b71ac:

    # eva "I'm really happy for the guys, but what makes me happiest is how you played [erc] right into your hands."
    eva "Je suis vraiment contente pour les gars, mais ce qui me fait le plus plaisir, c'est comment tu as manipulé [erc] pour qu'il tombe dans tes filets."

# game/scripts/c32/c32.rpy:2663
translate french c32s004_Eric_b954ddb3:

    # mc "I didn't do anything. The moment he felt betrayed, he dug his own grave."
    mc "Je n'ai rien fait. Dès l'instant où il s'est senti trahi, il a creusé sa propre tombe."

# game/scripts/c32/c32.rpy:2665
translate french c32s004_Eric_ea09bec3:

    # eva "When are you going to execute him? I hope you hold off until I'm there."
    eva "Quand est-ce que tu vas l'exécuter ? J'espère que tu vas attendre que je sois là."

# game/scripts/c32/c32.rpy:2666
translate french c32s004_Eric_d5c05c27:

    # mc "I'm not going to execute anyone, [eva]. We'll decide what to do with him."
    mc "Je ne vais exécuter personne, [eva]. On décidera de ce qu'on va faire de lui."
# game/scripts/c32/c32.rpy:2667
translate french c32s004_Eric_1f4aaadf:

    # mc "The murder charge should be enough to put him in a... normal prison."
    mc "L'accusation de meurtre devrait suffire à l'envoyer dans une... prison normale."

# game/scripts/c32/c32.rpy:2669
translate french c32s004_Eric_7081a17d:

    # ama "But we didn't record it..."
    ama "Mais nous ne l'avons pas enregistré..."

# game/scripts/c32/c32.rpy:2670
translate french c32s004_Eric_468d8298:

    # mc "I know. I wasn't expecting him to confess to a murder in the first interrogation."
    mc "Je sais. Je ne m'attendais pas à ce qu'il avoue un meurtre lors du premier interrogatoire."

# game/scripts/c32/c32.rpy:2672
translate french c32s004_Eric_f04c798b:

    # eva "*Cough* {b}You{/b} didn't record it. All these video conferencing programs have a little red button."
    eva "*Tousse* {b}Vous{/b} ne l'avez pas enregistré. Tous ces programmes de visioconférence ont un petit bouton rouge."

# game/scripts/c32/c32.rpy:2673
translate french c32s004_Eric_6fc8354b:

    # eva "*Giggle* I might have pressed it by 'mistake'."
    eva "*Glousse* J'ai peut-être appuyé dessus par 'erreur'."

# game/scripts/c32/c32.rpy:2674
translate french c32s004_Eric_3ae11115:

    # mc "*Laugh* Sometimes you're adorable, [eva]."
    mc "*Rire* Parfois tu es adorable, [eva]."

# game/scripts/c32/c32.rpy:2676
translate french c32s004_Eric_0ebd4423:

    # aar "The operatives from almost all the older series have seen the interrogation."
    aar "Les agents de presque toutes les anciennes séries ont vu l'interrogatoire."

# game/scripts/c32/c32.rpy:2677
translate french c32s004_Eric_90f498ac:

    # aar "I think they should also have a say in what to do with [erc]. He's made it clear what he thinks of them."
    aar "Je pense qu'elles devraient aussi avoir leur mot à dire sur ce qu'on doit faire de [erc]. Il a clairement fait savoir ce qu'il pensait d'elles."

# game/scripts/c32/c32.rpy:2678
translate french c32s004_Eric_50eb87d4:

    # mc "[aar], we're making changes in the company, but this isn't a democracy."
    mc "[aar], nous faisons des changements dans l'entreprise, mais ce n'est pas une démocratie."

# game/scripts/c32/c32.rpy:2679
translate french c32s004_Eric_11e2ab21:

    # mc "I'm not going to let [erc] get away unpunished just because the rest of the series ask for it."
    mc "Je ne vais pas laisser [erc] s'en tirer sans punition juste parce que le reste des séries le demande."

# game/scripts/c32/c32.rpy:2681
translate french c32s004_Eric_ab5d7ac2:

    # aar "I understand, but don't worry."
    aar "Je comprends, mais ne t'inquiète pas."
# game/scripts/c32/c32.rpy:2682
translate french c32s004_Eric_91abcba3:

    # aar "After what they've heard, I think they'll ask for a harsher punishment than what you want to apply."
