translate french c25s006_AmaCuddle_d251d02d:

    # mc "¿También vas a colaborar en el entrenamiento?"
    mc "Allez-vous également participer à la formation ?"

# game/scripts/c25/c25.rpy:3824
translate french c25s006_AmaCuddle_033c675d:

    # ama "*Risa* Solo estaré allí para asegurarme de que [eva] no hace ninguna locura."
    ama "*Rires* Je serai juste là pour m'assurer que [eva] ne fasse rien de fou."

# game/scripts/c25/c25.rpy:3829
translate french c25s006_AmaCuddle_5d2db9a0:

    # mom "Yo también voy a ir con ellas. No caben todas en la furgoneta y hace años que no disparo."
    mom "Je les accompagne. Ils ne rentreront pas tous dans la camionnette, et ça fait des années que je n'ai pas tiré avec une arme à feu."

# game/scripts/c25/c25.rpy:3830
translate french c25s006_AmaCuddle_3eb85b39:

    # mc "Id con cuidado."
    mc "Sois prudent."

# game/scripts/c25/c25.rpy:3835
translate french c25s006_AmaCuddle_ada7d006:

    # dap "Mamá no quiere venir y no quiere armas en casa..."
    dap "Maman ne veut pas venir et elle ne veut pas d'armes à la maison..."

# game/scripts/c25/c25.rpy:3836
translate french c25s006_AmaCuddle_ca951e25:

    # mc "Bueno, tenemos las de [eva]. No creo que sea necesaria ninguna más."
    mc "Bon, nous avons celles pour [eva]. Je ne pense pas qu'il en faille d'autres."

# game/scripts/c25/c25.rpy:3841
translate french c25s006_AmaCuddle_28208348:

    # nor "Eso mismo le dije hace un par de días."
    nor "Je lui ai dit la même chose il y a deux jours."

# game/scripts/c25/c25.rpy:3846
translate french c25s006_AmaCuddle_bb3a03b5:

    # sai "A mí tampoco me gustaría que hubiera armas en casa, pero no por ello voy a dejar de aprender a disparar."
    sai "Je n'aimerais pas non plus avoir d'armes à la maison, mais cela ne veut pas dire que je vais arrêter d'apprendre à tirer."

# game/scripts/c25/c25.rpy:3847
translate french c25s006_AmaCuddle_e840bce7:

    # mc "Me parece razonable, siempre va bien saber lo básico."
    mc "Cela me semble raisonnable ; il est toujours bon de connaître les bases."

# game/scripts/c25/c25.rpy:3852
translate french c25s006_AmaCuddle_29d58be2:

    # lis "Yo he disparado con escopetas y rifles, cuando mi padre intentaba enseñarme a cazar. Fallaba a propósito."
    lis "Je tirais au fusil et à la carabine quand mon père essayait de m'apprendre à chasser. Je ratais volontairement mes cibles."

# game/scripts/c25/c25.rpy:3853
translate french c25s006_AmaCuddle_191c0e97:

    # lis "Pero tengo ganas de aprender a disparar una pistola."
    lis "Mais j'ai très envie d'apprendre à tirer au fusil."

# game/scripts/c25/c25.rpy:3855
translate french c25s006_AmaCuddle_049e304b:

    # mc "*Risa* No te imagino matando animales. Eso iría en contra de todo lo que defiendes."
    mc "*Rires* Je n'arrive pas à t'imaginer tuer des animaux. Ce serait contraire à tout ce que tu défends."

# game/scripts/c25/c25.rpy:3857
translate french c25s006_AmaCuddle_11a7a2ba:

    # mc "*Risa* No te imagino matando animales, Princesa. Eso iría en contra de todo lo que defiendes."
    mc "*Rires* Je ne peux pas vous imaginer tuer des animaux, Princesse. Ce serait contraire à tout ce que vous représentez."

# game/scripts/c25/c25.rpy:3859
translate french c25s006_AmaCuddle_26549643:

    # lis "No mataría un animal si no fuera para defender a un ser humano. *Risa* Soy ecologista, pero no idiota."
    lis "Je ne tuerais un animal que pour défendre un être humain. *Rires* Je suis écologiste, mais je ne suis pas idiot."

# game/scripts/c25/c25.rpy:3860
translate french c25s006_AmaCuddle_66f71547:

    # lis "Y ahora nos vamos antes de que a [eri] y a [eil] se les haga tarde para ir a trabajar."
    lis "Et maintenant, nous partons avant que [eri] et [eil] ne soient en retard au travail."

# game/scripts/c25/c25.rpy:3862
translate french c25s006_AmaCuddle_c9a7983f:

    # "Después de que todas se pongan de nuevo sus zapatos..."
    "Une fois que tout le monde a remis ses chaussures..."

# game/scripts/c25/c25.rpy:3863
translate french c25s006_AmaCuddle_d6430870:

    # todas "Hasta luego, [mc]."
    todas "À plus tard, [mc]."

# game/scripts/c25/c25.rpy:3864
translate french c25s006_AmaCuddle_29132585:

    # mc "Hasta luego, chicas. Pasadlo bien."
    mc "À plus tard, les filles. Amusez-vous bien."

# game/scripts/c25/c25.rpy:3866
translate french c25s006_AmaCuddle_8070afad:

    # zeu "*¿Miau?* (Ahora que se han ido, ¿me das atún?)"
    zeu "*Miaou ?* (Maintenant qu'ils sont partis, je peux avoir du thon ?)"

# game/scripts/c25/c25.rpy:3867
translate french c25s006_AmaCuddle_2e343e3c:

    # mc "¿Qué te parece si vamos a la cocina y miramos si ha quedado algo de pollo para darte?"
    mc "Et si on allait à la cuisine voir s'il reste du poulet à te donner ?"

# game/scripts/c25/c25.rpy:3868
translate french c25s006_AmaCuddle_e2c05dd6:

    # zeu "*Miau* (Pollo me sirve. Veo que empiezas a entenderme.)"
    zeu "*Miaou* (Un poulet fera l'affaire. Je vois que tu commences à me comprendre.)"

# game/scripts/c25/c25.rpy:3870
translate french c25s006_AmaCuddle_c1417f2b:

    # "Pasas un rato en la cocina dando de comer al puto gato que te ha roto la cama."
    "Vous passez du temps dans la cuisine à nourrir ce satané chat qui a cassé votre lit."

# game/scripts/c25/c25.rpy:3871
translate french c25s006_AmaCuddle_4ac0586c:

    # "A este paso, va a engordar hasta parecer un tigre."
    "À ce rythme, il va devenir tellement gros qu'il ressemblera à un tigre."

# game/scripts/c25/c25.rpy:3872
translate french c25s006_AmaCuddle_c265d90f:

    # "Después de darle de comer al gato, compras una cama por internet. No hay camas de titanio anti-gatos."
    "Après avoir nourri le chat, vous achetez un panier en ligne. Il n'existe pas de paniers en titane résistants aux chats."

# game/scripts/c25/c25.rpy:3874
translate french c25s006_AmaCuddle_bd58b940:

    # "Pero hay camas grandes. Muy grandes."
    "Mais il y a de grands lits. De très grands lits."

# game/scripts/c25/c25.rpy:3880
translate french c25s007_iceCream_d8ce753e:

    # "Después de ducharte, pasas por la cocina de [nor]. Hay un helado de leche materna esperándote."
    "Après ta douche, tu vas dans la cuisine de [nor]. Une glace au lait maternel t'y attend."

# game/scripts/c25/c25.rpy:3882
translate french c25s007_iceCream_b97a050f:

    # "Coges una porción pequeña del cuenco de helado que [mee] te había indicado."
    "Vous prenez une petite portion du bol de glace que [mee] vous avait indiqué."

# game/scripts/c25/c25.rpy:3884
translate french c25s007_iceCream_72369e53:

    # mcp "(¡Está bueno! No hay mucha diferencia con el helado normal.)"
    mcp "(C'est bon ! Il n'y a pas beaucoup de différence avec une glace classique.)"

# game/scripts/c25/c25.rpy:3885
translate french c25s007_iceCream_4afedb0d:

    # mcp "(Ni siquiera el toque de Meemaw ha podido estropearlo.)"
    mcp "(Même le toucher de Mémé n'a pas pu gâcher ça.)"

# game/scripts/c25/c25.rpy:3887
translate french c25s007_iceCream_81658836:

    # mcp "(No sé por qué esperaba algo diferente. Es leche al fin y al cabo.)"
    mcp "(Je ne sais pas pourquoi je m'attendais à autre chose. C'est du lait, après tout.)"

# game/scripts/c25/c25.rpy:3889
translate french c25s007_iceCream_1aa0f13c:

    # mcp "(Estoy acostumbrado a beber su leche y, si dejamos de lado el morbo del fetiche, no deja de ser leche.)"
    mcp "(J'ai l'habitude de boire son lait, et si l'on fait abstraction de l'aspect morbide du fétichisme, ça reste du lait.)"

# game/scripts/c25/c25.rpy:3891
translate french c25s007_iceCream_391c5558:

    # mcp "(Creo que es hora de ir a buscar a Meemaw para nuestra cena.)"
    mcp "(Je crois qu'il est temps d'aller chercher Meemaw pour notre dîner.)"

# game/scripts/c25/c25.rpy:3894
translate french c25s007_iceCream_f76426e3:

    # "Decides volver a tu habitación. Después de todo el día trabajando en la contabilidad, tienes ganas de jugar un rato."
    "Vous décidez de retourner dans votre chambre. Après avoir travaillé toute la journée à la comptabilité, vous avez envie de vous détendre un peu."

# game/scripts/c25/c25.rpy:3899
translate french c25s007_MeeDate_1340357e:

    # "Llegas a la puerta de la habitación de [mee]. Por alguna razón estás nervioso por la cita que no es una cita... aún."
    "Vous arrivez devant la porte de la chambre de [mee]. Pour une raison inconnue, vous êtes nerveux à l'idée de ce rendez-vous qui n'en est pas encore un..."

# game/scripts/c25/c25.rpy:3901
translate french c25s007_MeeDate_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c25/c25.rpy:3902
translate french c25s007_MeeDate_b9d45fd7:

    # mc "Meemaw, soy yo. ¿Puedo pasar?"
    mc "Meemaw, c'est moi. Puis-je entrer ?"

# game/scripts/c25/c25.rpy:3903
translate french c25s007_MeeDate_d91056fe:

    # mee "*A través de la puerta* Sí, pasa."
    mee "*Par la porte* Oui, entrez."

# game/scripts/c25/c25.rpy:3905
translate french c25s007_MeeDate_d2b04026:

    # mee "Estoy al fondo..."
    mee "Je suis au fond..."

# game/scripts/c25/c25.rpy:3906
translate french c25s007_MeeDate_37f2f65d:

    # mc "¿Estás preparada para nuestra cena?"
    mc "Êtes-vous prêts pour notre dîner ?"

# game/scripts/c25/c25.rpy:3912
translate french c25s007_MeeDate_d2a0fceb:

    # mee "No he estado más preparada para una cena en mi vida."
    mee "Je n'ai jamais été aussi bien préparée pour un dîner de toute ma vie."

# game/scripts/c25/c25.rpy:3914
translate french c25s007_MeeDate_b06a25ba:

    # mc "¡Wow, Meemaw!"
    mc "Waouh, Meemaw !"

