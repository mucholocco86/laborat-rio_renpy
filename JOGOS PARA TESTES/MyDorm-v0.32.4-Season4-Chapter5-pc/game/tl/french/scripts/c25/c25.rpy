

# game/scripts/c25/c25.rpy:32
translate french c25s001_Eva_879c1fb9:

    # "Al llegar a la galería de tiro, [eva] guarda la moto dentro de lo que parece un almacén vacío."
    "En arrivant au stand de tir, [eva] range la moto dans ce qui semble être un entrepôt vide."

# game/scripts/c25/c25.rpy:33
translate french c25s001_Eva_60361cd5:

    # eva "Ya estamos aquí. ¿Preparado para la clase de tiro? Hoy no será con munición de práctica."
    eva "Nous sommes arrivés. Prêts pour le cours de tir ? Aujourd'hui, nous n'utiliserons pas de munitions d'entraînement."

# game/scripts/c25/c25.rpy:34
translate french c25s001_Eva_07ece46c:

    # mc "Sí, hace días que no hemos practicado y..."
    mc "Oui, cela fait quelques jours que nous n'avons pas pratiqué et..."

# game/scripts/c25/c25.rpy:36
translate french c25s001_Eva_fb88a8bd:

    # eva "*Risa* ¡No has practicado tú! Yo practico todos los días."
    eva "*Rires* Tu ne t'es pas entraîné ! Je m'entraîne tous les jours."

# game/scripts/c25/c25.rpy:39
translate french c25s001_Eva_1e8d7864:

    # eva "Pero entiendo que has estado muy ocupado últimamente para practicar."
    eva "Mais je comprends que vous ayez été trop occupé ces derniers temps pour vous entraîner."

# game/scripts/c25/c25.rpy:40
translate french c25s001_Eva_671f92cf:

    # mc "No he tenido tiempo ni de tumbarme a no hacer nada. Era uno de mis pasatiempos favoritos. *Risa*"
    mc "Je n'ai même pas eu le temps de me prélasser à ne rien faire. C'était pourtant l'un de mes passe-temps favoris. *Rires*"

# game/scripts/c25/c25.rpy:42
translate french c25s001_Eva_01d76747:

    # eva "Pero entiendo que has estado muy ocupado últimamente para pasar tiempo conmigo y practicar."
    eva "Mais je comprends que vous ayez été très occupé ces derniers temps et que vous n'ayez pas eu le temps de passer du temps avec moi et de vous entraîner."

# game/scripts/c25/c25.rpy:43
translate french c25s001_Eva_f3695eec:

    # mc "[eva], siempre tendré tiempo para pasar tiempo contigo. Sea para disparar o para tumbarnos a tomar el sol sin hacer nada."
    mc "[eva], j'aurai toujours du temps à te consacrer. Que ce soit pour faire du tir ou simplement pour me prélasser au soleil sans rien faire."

# game/scripts/c25/c25.rpy:45
translate french c25s001_Eva_ca9b99e3:

    # eva "*Risa* Nunca entenderé cómo podéis desperdiciar el tiempo sin hacer nada. Aparte de aburrido... es un desperdicio enorme."
    eva "*Rires* Je ne comprendrai jamais comment on peut perdre son temps à ne rien faire. En plus d'être ennuyeux… c'est un gâchis énorme."

# game/scripts/c25/c25.rpy:46
translate french c25s001_Eva_53705c25:

    # eva "¡Hay un montón de cosas que hacer, que ver, que leer! Yo no tengo horas suficientes para hacer todo lo que me gustaría..."
    eva "Il y a tellement de choses à faire, à voir et à lire ! Je n'ai pas assez d'heures dans la journée pour tout faire…"

# game/scripts/c25/c25.rpy:47
translate french c25s001_Eva_b037bcf5:

    # mc "Nadie las tiene, [eva]. ¿Qué te gustaría hacer?"
    mc "Personne n'en a, [eva]. Que souhaiteriez-vous faire ?"

# game/scripts/c25/c25.rpy:49
translate french c25s001_Eva_487c0bf9:

    # eva "Hay mil cosas que me gustaría hacer, pero no hay tiempo para todo. Y menos aún para tumbarme a no hacer nada."
    eva "J'aimerais faire mille choses, mais je n'ai pas le temps de tout faire. Et encore moins de temps pour ne rien faire."

# game/scripts/c25/c25.rpy:50
translate french c25s001_Eva_9e49941c:

    # eva "El otro día estaba viendo una película... la he empezado tres o cuatro veces... pero cuando matan a la madre del cervatillo... tengo que dejarlo."
    eva "L'autre jour, je regardais un film... Je l'ai recommencé trois ou quatre fois... mais quand ils tuent la mère du faon... j'ai dû arrêter."

# game/scripts/c25/c25.rpy:51
translate french c25s001_Eva_3ed6b865:

    # eva "Lo mismo que con la película en que muere el padre del leoncito. Me gustaría tener tiempo para acabar las dos."
    eva "Il en va de même pour le film où meurt le père du lionceau. J'aurais aimé avoir le temps de voir les deux en entier."

# game/scripts/c25/c25.rpy:52
translate french c25s001_Eva_735cd2da:

    # mc "Son muy buenas. Si quieres un día las acabamos de ver juntos. Te queda la mitad de cada película más o menos."
    mc "Ils sont vraiment excellents. Si tu veux, on peut les finir ensemble un de ces jours. Tu en es à peu près à la moitié de chaque film."

# game/scripts/c25/c25.rpy:54
translate french c25s001_Eva_18ac9d9e:

    # eva "¿Te gustan esas películas? [ama] dice que son para niños... pero a mí me encantan."
    eva "Tu aimes ces films ? [ama] Ils disent qu'ils sont pour les enfants… mais je les adore."

# game/scripts/c25/c25.rpy:55
translate french c25s001_Eva_02f9af6d:

    # eva "Y a ella también. No le digas que te lo he dicho... La vi llorando después de lo del león."
    eva "Elle aussi. Ne lui dis pas que je te l'ai dit… Je l'ai vue pleurer après l'incident avec le lion."

# game/scripts/c25/c25.rpy:56
translate french c25s001_Eva_dc2f137d:

    # mc "*Risa* No te preocupes. Tu secreto está a salvo conmigo."
    mc "*Rires* Ne t'inquiète pas. Ton secret est bien gardé."

# game/scripts/c25/c25.rpy:58
translate french c25s001_Eva_f97d75b3:

    # eva "Vamos dentro. Ya llevamos dos minutos aquí, hablando sin hacer nada. Se te va a pasar el tiempo para entrenar."
    eva "Entrons. Ça fait déjà deux minutes qu'on est là à parler sans rien faire. Tu vas rater ta formation."

# game/scripts/c25/c25.rpy:59
translate french c25s001_Eva_078381f9:

    # mc "*Risa* Estamos hablando. Eso es hacer algo."
    mc "*Rires* On discute. C'est déjà ça."

# game/scripts/c25/c25.rpy:61
translate french c25s001_Eva_fb7bd1e4:

    # mc "Y acabamos de planificar una cita para acabar de ver dos películas de dibujos animados."
    mc "Et nous venions justement de prévoir une sortie pour finir de regarder deux films d'animation."

# game/scripts/c25/c25.rpy:63
translate french c25s001_Eva_dcadb36a:

    # mc "Y acabamos de planificar ver dos películas de dibujos animados."
    mc "Et nous avions justement prévu de regarder deux films d'animation."

# game/scripts/c25/c25.rpy:65
translate french c25s001_Eva_5ca67a1d:

    # eva "Vale, pero hemos venido a que entrenes con una pistola de verdad. Y es lo que vamos a hacer."
    eva "D'accord, mais nous sommes là pour que vous vous entraîniez avec une vraie arme. Et c'est ce que nous allons faire."

# game/scripts/c25/c25.rpy:66
translate french c25s001_Eva_abb97725:

    # mc "*Risa* También tienes que aprender a relajarte y a que los planes pueden cambiar sobre la marcha."
    mc "*Rires* Il faut aussi apprendre à se détendre, car les plans peuvent changer à la dernière minute."

# game/scripts/c25/c25.rpy:67
translate french c25s001_Eva_2ad03cc3:

    # mc "Por cierto, ¿por qué has guardado la moto en el almacén? El aparcamiento está vacío."
    mc "Au fait, pourquoi avez-vous entreposé la moto dans le local de stockage ? Le parking est vide."

# game/scripts/c25/c25.rpy:69
translate french c25s001_Eva_4db698b7:

    # eva "La primera razón es porque no quiero que cuando venga el helicóptero vea la moto y la matrícula. No sabemos qué intenciones tienen y no queremos darles pistas."
    eva "La première raison est que je ne veux pas que l'hélicoptère repère la moto et sa plaque d'immatriculation à son arrivée. Nous ignorons leurs intentions et nous ne voulons leur donner aucun indice."

# game/scripts/c25/c25.rpy:70
translate french c25s001_Eva_7baeba08:

    # mc "Me parece una buena razón, pero intuyo que hay una segunda razón más importante."
    mc "Cela semble être une bonne raison, mais je soupçonne qu'il y en a une seconde, plus importante."

# game/scripts/c25/c25.rpy:72
translate french c25s001_Eva_1416c684:

    # eva "No más importante, pero casi. Si el piloto es torpe, no quiero que tire a mi niña al suelo."
    eva "Ce n'est pas le plus important, mais presque. Si le pilote est maladroit, je ne veux pas qu'il jette ma fille au sol."

# game/scripts/c25/c25.rpy:73
translate french c25s001_Eva_d816f5b6:

    # mc "*Risa* ¿Tu niña?"
    mc "*Rires* Votre petite fille ?"

# game/scripts/c25/c25.rpy:75
translate french c25s001_Eva_24fa4d16:

    # eva "*Risa* Mi niña, mi novia... llámala como quieras. Adoro esa moto."
    eva "*Rires* Ma chérie, ma copine… appelez-la comme vous voulez. J’adore cette moto."

# game/scripts/c25/c25.rpy:76
translate french c25s001_Eva_893c668a:

    # eva "Y, por cierto, felicidades. No has llorado viniendo hacia aquí."
    eva "Et au fait, félicitations. Vous n'avez pas pleuré en venant ici."

# game/scripts/c25/c25.rpy:77
translate french c25s001_Eva_e7f0c5b9:

    # mc "*Risa* Ha sido intenso, pero menos de lo que esperaba."
    mc "*Rires* Ça a été intense, mais moins que ce à quoi je m'attendais."

# game/scripts/c25/c25.rpy:79
translate french c25s001_Eva_ccf45a17:

    # eva "*Risa* Entonces la próxima vez no me contendré."
    eva "*Rires* Alors la prochaine fois, je ne me retiendrai pas."

# game/scripts/c25/c25.rpy:80
translate french c25s001_Eva_b04f7cd8:

    # mc "*Risa* Te puedes seguir conteniendo. Por mí no lo hagas."
    mc "*Rires* Tu peux continuer à te retenir. Ne le fais pas pour moi."

# game/scripts/c25/c25.rpy:82
translate french c25s001_Eva_fcbcbddf:

    # eva "Bueno, aquí estamos. Disculpa el desorden, les dije que barrieran los cartuchos vacíos antes de cerrar ayer."
    eva "Voilà, c'est fait. Désolé pour le désordre, je vous avais dit de ramasser les cartouches vides avant la fermeture hier."

# game/scripts/c25/c25.rpy:83
translate french c25s001_Eva_ec5caaa9:

    # eva "He dejado esas cajas de munición ahí. Espero que no la gastes toda."
    eva "J'ai laissé ces boîtes de munitions là-bas. J'espère que vous ne les utiliserez pas toutes."

# game/scripts/c25/c25.rpy:84
translate french c25s001_Eva_38ab1845:

    # mc "¿Tanto voy a tener que disparar?"
    mc "Vais-je vraiment devoir prendre autant de photos ?"

# game/scripts/c25/c25.rpy:86
translate french c25s001_Eva_8dbeaacc:

    # eva "Hoy vamos a entrenar el Taladro de Mozambique. Lo tienes que hacer seis veces."
    eva "Aujourd'hui, nous allons nous entraîner à l'exercice du Mozambique. Vous devez le faire six fois."

# game/scripts/c25/c25.rpy:87
translate french c25s001_Eva_d4288bdd:

    # mc "¿El Taladro de Mozambique?"
    mc "Le forage du Mozambique ?"

# game/scripts/c25/c25.rpy:89
translate french c25s001_Eva_2728605b:

    # eva "Dos tiros en el pecho y uno en la cabeza. Rápidamente."
    eva "Deux balles dans la poitrine et une dans la tête. Rapidement."

# game/scripts/c25/c25.rpy:90
translate french c25s001_Eva_5c628167:

    # eva "¿Has visto las pelis de Jack Wick? Lo suele hacer bastante. Es una técnica muy buena para acabar con gente con chalecos antibalas."
    eva "Avez-vous vu les films de Jack Wick ? Il utilise souvent cette technique. C'est particulièrement efficace pour neutraliser les personnes portant un gilet pare-balles."

# game/scripts/c25/c25.rpy:91
translate french c25s001_Eva_2ff1ce86:

    # mc "Sí, las he visto. No parece demasiado complicado... ¿verdad?"
    mc "Oui, je les ai vus. Ça n'a pas l'air trop compliqué… si ?"

# game/scripts/c25/c25.rpy:93
translate french c25s001_Eva_0603a7c7:

    # eva "Hacerlo bien es más complicado de lo que parece. Porque además iré alejando el objetivo un metro cada vez que lo consigas."
    eva "Réussir correctement est plus compliqué qu'il n'y paraît. Car à chaque réussite, la cible sera reculée d'un mètre."

# game/scripts/c25/c25.rpy:94
translate french c25s001_Eva_3b89bbf4:

    # mc "OK. ¿Empezamos?"
    mc "OK. On commence ?"

# game/scripts/c25/c25.rpy:96
translate french c25s001_Eva_ad621afe:

    # eva "OK. Te he traído la misma pistola con la que practicaste en el bosque."
    eva "OK. Je vous ai apporté le même fusil que celui avec lequel vous vous êtes entraîné dans les bois."

# game/scripts/c25/c25.rpy:97
translate french c25s001_Eva_85306643:

    # eva "Quería traerte una Desert Stork, pero [ama] ha dicho que sería mucho para ti. Ponte las gafas y los auriculares de protección."
    eva "Je voulais t'offrir une cigogne du désert, mais [ama] a dit que ce serait trop pour toi. Mets tes lunettes et tes protections auditives."

# game/scripts/c25/c25.rpy:98
translate french c25s001_Eva_3ea6388d:

    # mc "Sabes que no entiendo de armas y no sé lo que es una Desert Stork, ¿verdad?"
    mc "Vous savez que je ne connais rien aux armes et que je ne sais pas ce qu'est une cigogne du désert, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:99
translate french c25s001_Eva_439c0f24:

    # eva "Lo sé. Recuerda que el entrenamiento es para disparar con una sola mano. Si lo consigues hacer bien, el día que tengas que disparar con dos manos será más fácil."
    eva "Je sais. N'oublie pas que l'entraînement est axé sur le tir à une main. Si tu y arrives bien, le jour où tu devras tirer à deux mains sera plus facile."

# game/scripts/c25/c25.rpy:103
translate french c25s001_Eva_d4bea65b:

    # "Practicas durante bastante tiempo. Al principio, cuando los objetivos están cerca, es relativamente fácil."
    "On s'entraîne pendant un bon moment. Au début, quand les objectifs sont proches, c'est relativement facile."

# game/scripts/c25/c25.rpy:106
translate french c25s001_Eva_aa9f35ca:

    # "Tal como [eva] los va alejando, se hace mucho más difícil. No sólo hacer el Taladro de Mozambique, sino acertar al objetivo."
    "Plus [eva] les éloigne, plus la tâche devient difficile. Non seulement pour exécuter l'exercice du Mozambique, mais aussi pour atteindre la cible."

# game/scripts/c25/c25.rpy:107
translate french c25s001_Eva_12edc81e:

    # "Tienes que aguantar algunas miradas de desaprobación de [eva]."
    "Vous allez devoir supporter quelques regards désapprobateurs de [eva]."

# game/scripts/c25/c25.rpy:108
translate french c25s001_Eva_cb28b39c:

    # "Finalizas el entrenamiento habiendo conseguido el objetivo cuando la diana estaba a siete metros."
    "Vous terminez l'entraînement en ayant atteint l'objectif lorsque la cible se trouvait à sept mètres."

# game/scripts/c25/c25.rpy:110
translate french c25s001_Eva_abefe31e:

    # "Más allá has acertado algunos disparos, pero no suficiente para los estándares de [eva]."
    "Au-delà de ça, vous avez réussi quelques coups, mais pas assez selon les normes [eva]."

# game/scripts/c25/c25.rpy:111
translate french c25s001_Eva_2fc54b12:

    # eva "No ha estado mal, pero tienes que mejorar. Le diré a [ama] que te entrene en Aruba. Pon el seguro del arma y déjala en la estantería."
    eva "Ce n'était pas mal, mais tu dois t'améliorer. Je dirai à [ama] de t'entraîner à Aruba. Mets le pistolet en sécurité et laisse-le sur l'étagère."

# game/scripts/c25/c25.rpy:112
translate french c25s001_Eva_17bfd97c:

    # mc "No sé si alguna vez me voy a enfrentar con alguien a tiros a esa distancia... o a alguna en realidad."
    mc "Je ne sais pas si je serai un jour confronté à quelqu'un qui tire à cette distance... ni à aucune autre distance d'ailleurs."

# game/scripts/c25/c25.rpy:114
translate french c25s001_Eva_a7c14f44:

    # eva "Es mejor que estés preparado por si lo tienes que hacer. Pero no hay tiempo para más."
    eva "Il vaut mieux être préparé au cas où. Mais il n'y a plus de temps à perdre."

# game/scripts/c25/c25.rpy:115
translate french c25s001_Eva_959d43ad:

    # eva "Estoy escuchando la furgoneta de [ama] en el aparcamiento."
    eva "J'écoute la camionnette de [ama] sur le parking."

# game/scripts/c25/c25.rpy:116
translate french c25s001_Eva_1f4f2240:

    # mc "¿Hemos acabado entonces?"
    mc "Alors, c'est terminé ?"

# game/scripts/c25/c25.rpy:118
translate french c25s001_Eva_97851d56:

    # eva "Sí. No creo que tengamos muchas más oportunidades de entrenar antes de que os vayáis a Aruba."
    eva "Oui. Je ne pense pas que nous aurons beaucoup d'autres occasions de nous entraîner avant ton départ pour Aruba."

# game/scripts/c25/c25.rpy:119
translate french c25s001_Eva_6ea1fe2d:

    # eva "Yo sí que te entrenaré allí. Me dará lo mismo que estés ocupado."
    eva "Je te formerai là-bas. Peu importe si tu es occupé(e)."

# game/scripts/c25/c25.rpy:120
translate french c25s001_Eva_a8f5e398:

    # mc "[eva]..."
    mc "[eva]..."

# game/scripts/c25/c25.rpy:122
translate french c25s001_Eva_c0579bb2:

    # eva "Dime."
    eva "Dites-moi."

# game/scripts/c25/c25.rpy:123
translate french c25s001_Eva_7ed3cce9:

    # mc "Gracias. Por el entrenamiento y por todo."
    mc "Merci. Pour la formation et pour tout."

# game/scripts/c25/c25.rpy:125
translate french c25s001_Eva_0717bc69:

    # eva "No hay de qué. Aunque me hayas hecho perder una apuesta."
    eva "De rien. Même si tu m'as fait perdre un pari."

# game/scripts/c25/c25.rpy:126
translate french c25s001_Eva_d9cb9e70:

    # mc "¿Qué apuesta?"
    mc "Quel est le pari ?"

# game/scripts/c25/c25.rpy:127
translate french c25s001_Eva_5ca0b702:

    # eva "Le había dicho a [ama] que no lo conseguirías pasados los seis metros."
    eva "J'avais dit à [ama] que tu ne dépasserais pas les six mètres."

# game/scripts/c25/c25.rpy:128
translate french c25s001_Eva_69166cb4:

    # eva "Estoy orgullosa de ti."
    eva "Je suis fier de toi."

# game/scripts/c25/c25.rpy:130
translate french c25s001_Eva_987fe4d4:

    # eva "Espera a que [ama] te traiga el traje. Puedes ducharte si quieres. Hay una ducha en la oficina."
    eva "Attendez que [ama] vous apporte le costume. Vous pouvez prendre une douche si vous le souhaitez. Il y a une douche au bureau."

# game/scripts/c25/c25.rpy:131
translate french c25s001_Eva_67b2f681:

    # eva "Voy al lavabo mientras tanto. Deja el arma ahí y lo recogeré todo yo cuando os vayáis."
    eva "Je vais aux toilettes en attendant. Laisse le pistolet là-bas, je nettoierai tout quand tu seras parti."

# game/scripts/c25/c25.rpy:133
translate french c25s001_Eva_73566961:

    # "Y tras eso, tu entrenadora personal desaparece."
    "Et après ça, votre entraîneur personnel disparaît."

# game/scripts/c25/c25.rpy:137
translate french c25s001_Eva_088cc437:

    # eva "Bueno, puedes ir practicando mientras me cambio de ropa."
    eva "D'accord, tu peux t'entraîner pendant que je me change."

# game/scripts/c25/c25.rpy:138
translate french c25s001_Eva_004b3196:

    # mc "¿Te vas a cambiar?"
    mc "Vas-tu changer ?"

# game/scripts/c25/c25.rpy:140
translate french c25s001_Eva_225a7bc6:

    # eva "Sí. Para hacer el entrenamiento más interesante, vamos a jugar a un juego."
    eva "Oui. Pour rendre la formation plus intéressante, jouons à un jeu."

# game/scripts/c25/c25.rpy:141
translate french c25s001_Eva_fcda545b:

    # mc "¿Qué juego?"
    mc "Quel jeu ?"

# game/scripts/c25/c25.rpy:142
translate french c25s001_Eva_b08541e5:

    # eva "Ya lo verás. No seas impaciente."
    eva "Vous verrez. Ne soyez pas impatient."

# game/scripts/c25/c25.rpy:144
translate french c25s001_Eva_d50e5cd9:

    # "Tras eso, desaparece."
    "Après cela, il disparaît."

# game/scripts/c25/c25.rpy:145
translate french c25s001_Eva_68c41f89:

    # "Aprovechas los minutos en los que [eva] no está para recordar el tacto del arma. No quieres hacer ningún disparo antes de que ella vuelva."
    "Profitez des minutes d'absence de [eva] pour vous remémorer la sensation de l'arme. Vous ne voulez pas tirer avant son retour."

# game/scripts/c25/c25.rpy:148
translate french c25s001_Eva_bb4edac2:

    # eva "Ya estoy aquí de nuevo. Podemos empezar."
    eva "Me revoilà. Nous pouvons commencer."

# game/scripts/c25/c25.rpy:150
translate french c25s001_Eva_7077719e:

    # mc "¿Y ese cambio de ropa? A mí me parecía que estabas bien vestida para disparar."
    mc "Et ce changement de vêtements ? Je croyais que vous étiez habillé(e) convenablement pour le shooting."

# game/scripts/c25/c25.rpy:152
translate french c25s001_Eva_1c9c6472:

    # eva "*Risa* El que disparará eres tú, no yo. Pero voy a darte un incentivo."
    eva "*Rires* C'est toi qui vas tirer, pas moi. Mais je vais te donner une motivation."

# game/scripts/c25/c25.rpy:153
translate french c25s001_Eva_b474b579:

    # eva "Jugaremos a strip shooting. Cada vez que lo consigas, me quitaré una prenda de ropa. Con el otro traje duraría muy poco."
    eva "On va jouer au strip-tease. À chaque fois que tu réussis, j'enlève un vêtement. Je ne tiendrais pas longtemps avec l'autre tenue."

# game/scripts/c25/c25.rpy:154
translate french c25s001_Eva_eba7f701:

    # mc "*Risa* Me parece muy interesante..."
    mc "*Rires* Je trouve ça très intéressant..."

# game/scripts/c25/c25.rpy:156
translate french c25s001_Eva_0834f8ac:

    # eva "Si lo consigues a la primera en cada distancia, además te llevarás un beso."
    eva "Si vous réussissez du premier coup à chaque distance, vous aurez aussi droit à un baiser."

# game/scripts/c25/c25.rpy:157
translate french c25s001_Eva_2b0b9525:

    # mc "*Risa* Eso me parece más interesante todavía. ¿Empezamos?"
    mc "*Rires* Ça me paraît encore plus intéressant. On commence ?"

# game/scripts/c25/c25.rpy:160
translate french c25s001_Eva_4e261d7f:

    # eva "*Risita* Y si aciertas en el centro, ya sea en el pecho o en la cabeza, a lo mejor te hago un baile..."
    eva "*Rires* Et si tu touches le centre, la poitrine ou la tête, peut-être que je te ferai une danse..."

# game/scripts/c25/c25.rpy:161
translate french c25s001_Eva_c1213e80:

    # mc "*Risa* Sin presión, ¿verdad?"
    mc "*Rires* Pas de pression, hein ?"

# game/scripts/c25/c25.rpy:162
translate french c25s001_Eva_3619c14a:

    # eva "*Risa* Si alguna vez estás en un tiroteo de verdad, vas a tener mucha presión. *Risa* Te tengo que entrenar para que aciertes bajo presión o no serviría de nada."
    eva "*Rires* Si jamais tu te retrouves dans une vraie fusillade, tu vas subir une pression énorme. *Rires* Il faudra que je t'entraîne à atteindre ta cible sous pression, sinon ça ne servira à rien."

# game/scripts/c25/c25.rpy:165
translate french c25s001_Eva_c9cd1628:

    # "La primera ronda, a cinco metros de distancia, es fácil. Lo consigues al segundo intento."
    "Le premier essai, à cinq mètres de distance, est facile. Vous y arriverez au deuxième."

# game/scripts/c25/c25.rpy:166
translate french c25s001_Eva_cc223ab3:

    # "Pierdes el beso, pero te has ganado el baile. Has acertado en el centro en el cuarto y el sexto disparo."
    "Tu as raté le baiser, mais tu as gagné la danse. Tu as fait mouche au quatrième et au sixième coup."

# game/scripts/c25/c25.rpy:167
translate french c25s001_Eva_9e1bd096:

    # "Pones el seguro del arma antes de dejarla en la estantería, tal como [eva] te ha indicado."
    "Vous enclenchez la sécurité de l'arme avant de la placer sur l'étagère, comme [eva] vous l'a indiqué."

# game/scripts/c25/c25.rpy:169
translate french c25s001_Eva_6f7890a8:

    # eva "Bien hecho. Te has ganado que me quite una prenda."
    eva "Bravo ! Vous avez mérité que j'enlève un vêtement."

# game/scripts/c25/c25.rpy:170
translate french c25s001_Eva_2a326ff4:

    # mc "¡Las zapatillas no! *Risa* ¡Es injusto!"
    mc "Pas les baskets ! *Rires* C'est injuste !"

# game/scripts/c25/c25.rpy:172
translate french c25s001_Eva_6941c6f9:

    # eva "*Risa* Si no las contamos como prenda, creo que el entrenamiento duraría muy poco. Y la diana estaba muy cerca. Creo que es premio suficiente."
    eva "*Rires* Si on ne les considère pas comme une pénalité, l'entraînement serait vraiment trop court. Et l'objectif était tout proche. Je pense que c'est une récompense suffisante."

# game/scripts/c25/c25.rpy:173
translate french c25s001_Eva_da8c5d3e:

    # mc "Pero el baile sí que lo voy a tener, ¿verdad?"
    mc "Mais j'aurai quand même la danse, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:177
translate french c25s001_Eva_47c2ab4e:

    # eva "Por supuesto. Has tenido dos aciertos."
    eva "Bien sûr. Vous en avez trouvé deux."

# game/scripts/c25/c25.rpy:178
translate french c25s001_Eva_84972d6f:

    # mc "Mi imaginación me está poniendo más presión aún. Te estoy imaginando haciendo eso sin ropa."
    mc "Mon imagination me met encore plus la pression. Je t'imagine faire ça sans vêtements."

# game/scripts/c25/c25.rpy:179
translate french c25s001_Eva_0ffb2b4d:

    # eva "*Risita* Tan solo tienes que seguir acertando en el centro... "
    eva "*Rires* Il suffit de viser le centre..."

# game/scripts/c25/c25.rpy:182
translate french c25s001_Eva_09a9fdad:

    # "[eva] aleja la diana a seis metros y vuelves a disparar."
    "[eva] Déplacez la cible de six mètres et tirez à nouveau."

# game/scripts/c25/c25.rpy:183
translate french c25s001_Eva_22ec0ebb:

    # "Lo consigues a la primera y un acierto en el centro de la cabeza."
    "Vous réussissez du premier coup, un tir parfait en plein centre de la tête."

# game/scripts/c25/c25.rpy:185
translate french c25s001_Eva_7678b869:

    # eva "¡Bien hecho!"
    eva "Bien joué!"

# game/scripts/c25/c25.rpy:186
translate french c25s001_Eva_6cdf7c03:

    # mc "¡Quiero mi beso!"
    mc "Je veux mon baiser !"

# game/scripts/c25/c25.rpy:187
translate french c25s001_Eva_9f5e4c6d:

    # eva "*Risa* Te lo has ganado esta vez."
    eva "*Rires* Tu l'as bien mérité cette fois-ci."

# game/scripts/c25/c25.rpy:189
translate french c25s001_Eva_d9ab773d:

    # "[eva] se acerca a darte tu recompensa. Como ha dicho, es un gran incentivo."
    "[eva] vient vous remettre votre récompense. Comme il l'a dit, c'est une excellente motivation."

# game/scripts/c25/c25.rpy:191
translate french c25s001_Eva_60c22897:

    # mc "Y ahora quiero mi prenda y mi baile."
    mc "Et maintenant, je veux mon vêtement et ma danse."

# game/scripts/c25/c25.rpy:192
translate french c25s001_Eva_8e9c396a:

    # eva "*Risa* Sobre el baile te he dicho a lo mejor..."
    eva "*Rires* À propos de la danse, je vous l'ai peut-être déjà dit..."

# game/scripts/c25/c25.rpy:193
translate french c25s001_Eva_44185f3e:

    # mc "Pero estás deseando hacerlo, ¿verdad?"
    mc "Mais vous avez hâte de le faire, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:194
translate french c25s001_Eva_54269a30:

    # eva "*Risa* Creo que me conoces demasiado..."
    eva "*Rires* Je crois que vous me connaissez trop bien..."

# game/scripts/c25/c25.rpy:196
translate french c25s001_Eva_e56991c7:

    # eva "Pero vamos a empezar pagando con esta camiseta..."
    eva "Mais commençons par payer avec ce t-shirt..."

# game/scripts/c25/c25.rpy:197
translate french c25s001_Eva_c6175cd8:

    # mc "Me gusta la idea..."
    mc "J'aime bien l'idée..."

# game/scripts/c25/c25.rpy:202
translate french c25s001_Eva_f4d05ec4:

    # eva "*Risa* ¿Contento con el baile?"
    eva "*Rires* Content(e) de la danse ?"

# game/scripts/c25/c25.rpy:203
translate french c25s001_Eva_c6402620:

    # "Ponerse un sujetador con volantes y hacer eso casi se podría considerar trampa. Hace parecer que sus tetas se mueven más de lo que lo hacen en realidad."
    "Porter un soutien-gorge à froufrous et faire ça pourrait presque être considéré comme de la triche. Ça donne l'impression que ses seins bougent plus qu'ils ne bougent réellement."

# game/scripts/c25/c25.rpy:204
translate french c25s001_Eva_f0f2048b:

    # mc "*Risa* Sí, aunque eso añade más presión todavía a los siete metros."
    mc "*Rires* Oui, même si cela ajoute encore plus de pression sur les sept mètres."

# game/scripts/c25/c25.rpy:205
translate french c25s001_Eva_0630471f:

    # eva "*Risa* Eso sólo quiere decir que el entrenamiento será mejor."
    eva "*Rires* Ça veut juste dire que l'entraînement sera meilleur."

# game/scripts/c25/c25.rpy:206
translate french c25s001_Eva_f4566a28:

    # mc "*Risa* Dudo que pueda ser mejor que esto."
    mc "*Rires* Je doute que ça puisse être mieux que ça."

# game/scripts/c25/c25.rpy:209
translate french c25s001_Eva_944858b7:

    # "[eva] aleja la diana a siete metros y vuelves a disparar."
    "[eva] Déplacez la cible de sept mètres et tirez à nouveau."

# game/scripts/c25/c25.rpy:210
translate french c25s001_Eva_c12cf223:

    # "Consigues hacer el Taladro de Mozambique al tercer intento y un acierto en el centro del pecho."
    "Vous parvenez à exécuter le Mozambique Drill à la troisième tentative et vous l'atteignez en plein centre de la poitrine."

# game/scripts/c25/c25.rpy:211
translate french c25s001_Eva_db0b090c:

    # "No va a haber beso esta vez."
    "Il n'y aura pas de baiser cette fois-ci."

# game/scripts/c25/c25.rpy:213
translate french c25s001_Eva_f500f5e5:

    # mc "Prenda y baile..."
    mc "Vêtements et danse..."

# game/scripts/c25/c25.rpy:214
translate french c25s001_Eva_28cf3fbf:

    # eva "No hay beso esta vez."
    eva "Il n'y aura pas de baiser cette fois-ci."

# game/scripts/c25/c25.rpy:215
translate french c25s001_Eva_9d40879e:

    # mc "Lo sé..."
    mc "Je sais..."

# game/scripts/c25/c25.rpy:217
translate french c25s001_Eva_62e758fe:

    # eva "Suenas decepcionado."
    eva "Tu as l'air déçu."

# game/scripts/c25/c25.rpy:218
translate french c25s001_Eva_15a6150a:

    # mc "Me gusta besarte..."
    mc "J'aime t'embrasser..."

# game/scripts/c25/c25.rpy:220
translate french c25s001_Eva_4f0f7e3b:

    # eva "¿Te alegraría un poco si esta vez te dejo que seas tú quien me quite la prenda? Van a ser los shorts..."
    eva "Serais-tu un peu plus heureux si, cette fois, je te laissais me déshabiller ? Ce sera mon short…"

# game/scripts/c25/c25.rpy:221
translate french c25s001_Eva_29709d1e:

    # mc "*Risa* Sabes cómo alegrar a un hombre."
    mc "*Rires* Tu sais comment remonter le moral d'un homme."

# game/scripts/c25/c25.rpy:223
translate french c25s001_Eva_89a7865b:

    # eva "Sólo hay un hombre al que quiera alegrar."
    eva "Il n'y a qu'un seul homme que je veux rendre heureux."

# game/scripts/c25/c25.rpy:224
translate french c25s001_Eva_b1381979:

    # mc "*Risa* No me refería a eso, pero me alegra ser ese hombre."
    mc "*Rires* Je ne voulais pas dire ça, mais je suis content d'être cet homme."

# game/scripts/c25/c25.rpy:226
translate french c25s001_Eva_632ca161:

    # eva "*Risa* ¿De dónde has sacado que me refiera a ti? Me refería a... Jamaal..."
    eva "*Rires* D'où vous vient l'idée que je parlais de vous ? Je voulais dire… Jamaal…"

# game/scripts/c25/c25.rpy:227
translate french c25s001_Eva_588d1652:

    # mc "*Risa* Vale, me lo he ganado."
    mc "*Rires* Bon, je l'ai bien mérité."

# game/scripts/c25/c25.rpy:228
translate french c25s001_Eva_031aaf89:

    # eva "Y ahora vuelve a tu posición, déjame espacio para mi baile."
    eva "Et maintenant, retournez à votre place, laissez-moi de la place pour ma danse."

# game/scripts/c25/c25.rpy:232
translate french c25s001_Eva_3e758b29:

    # "La preciosa mercenaria empieza a mover su culo sensualmente. Sigues pensando lo mismo sobre los volantes que hace unos minutos."
    "La sublime mercenaire commence à onduler sensuellement ses fesses. Tu penses toujours la même chose aux volants qu'il y a quelques minutes."

# game/scripts/c25/c25.rpy:233
translate french c25s001_Eva_229fde86:

    # eva "¿Te gusta lo que ves?"
    eva "Ce que vous voyez vous plaît ?"

# game/scripts/c25/c25.rpy:234
translate french c25s001_Eva_3c74e715:

    # mc "Mucho."
    mc "Beaucoup."

# game/scripts/c25/c25.rpy:235
translate french c25s001_Eva_f6089df7:

    # eva "Si sigues acertando me lo tendré que quitar..."
    eva "Si tu continues à bien faire les choses, je devrai l'enlever..."

# game/scripts/c25/c25.rpy:236
translate french c25s001_Eva_2141d235:

    # mc "*Risa* Ahora tengo la duda de si seguir disparando o seguir mirando."
    mc "*Rires* Maintenant, je me demande si je dois continuer à filmer ou continuer à regarder."

# game/scripts/c25/c25.rpy:239
translate french c25s001_Eva_7dfe4a08:

    # eva "Seguir disparando. Esto sigue siendo un entrenamiento."
    eva "Continuez à tirer. C'est encore un entraînement."

# game/scripts/c25/c25.rpy:240
translate french c25s001_Eva_a01617fb:

    # mc "¡Ohhh! ¿Si pongo ojos de cachorrito me dejarás mirar un rato más?"
    mc "Ohhh ! Si je te fais les yeux doux, me laisseras-tu regarder un peu plus longtemps ?"

# game/scripts/c25/c25.rpy:242
translate french c25s001_Eva_39cbe7ab:

    # eva "No."
    eva "Non."

# game/scripts/c25/c25.rpy:243
translate french c25s001_Eva_af327336:

    # mc "Eres una maestra demasiado estricta. *Risa*"
    mc "Vous êtes un professeur trop strict. *Rires*"

# game/scripts/c25/c25.rpy:244
translate french c25s001_Eva_ae619087:

    # eva "Si perdemos tiempo en esto, no te va a dar tiempo a acabar. Ahora vienen los ocho metros."
    eva "Si nous perdons du temps avec ça, vous n'aurez pas le temps de finir. Passons maintenant aux huit mètres."

# game/scripts/c25/c25.rpy:245
translate french c25s001_Eva_da042db1:

    # "Cambias la distancia a ocho metros sin esperar que lo haga [eva]."
    "Vous modifiez la distance à huit mètres sans vous attendre à ce que cela fasse [eva]."

# game/scripts/c25/c25.rpy:248
translate french c25s001_Eva_ade60c53:

    # "La distancia parece que es demasiado para tus habilidades. En cada ronda de tres disparos aciertas uno o dos, pero nunca los tres."
    "La distance semble trop importante pour votre niveau. À chaque série de trois tirs, vous en touchez un ou deux, mais jamais les trois."

# game/scripts/c25/c25.rpy:250
translate french c25s001_Eva_3fa92260:

    # eva "¿Está muy lejos para ti? ¿O no quieres seguir con el striptease?"
    eva "Est-ce trop loin pour vous ? Ou ne souhaitez-vous pas poursuivre le strip-tease ?"

# game/scripts/c25/c25.rpy:251
translate french c25s001_Eva_9b07e5a3:

    # mc "*Risa* Creo que es la primera opción. Ocho metros es demasiado, aunque he acertado al menos un disparo en cada ronda."
    mc "*Rires* Je crois que c'est la première option. Huit mètres, c'est trop, même si j'ai réussi à toucher la cible au moins une fois à chaque manche."

# game/scripts/c25/c25.rpy:253
translate french c25s001_Eva_3275bdde:

    # eva "¿Qué tal si te doy un incentivo, aunque no te lo hayas ganado?"
    eva "Et si je vous offrais une récompense, même si vous ne l'avez pas méritée ?"

# game/scripts/c25/c25.rpy:254
translate french c25s001_Eva_8dc37940:

    # mc "¿Otra prenda?"
    mc "Un autre vêtement ?"

# game/scripts/c25/c25.rpy:255
translate french c25s001_Eva_39cbe7ab_1:

    # eva "No."
    eva "Non."

# game/scripts/c25/c25.rpy:257
translate french c25s001_Eva_fe6b4312:

    # eva "Me refiero a esto."
    eva "Je fais référence à ceci."

# game/scripts/c25/c25.rpy:262
translate french c25s001_Eva_694afb1b:

    # "[eva] se lanza a tus labios con una ansiedad que no ha demostrado en ninguna de las veces que os habéis besado anteriormente."
    "[eva] se jette sur vos lèvres avec une ardeur qu'il n'a jamais manifestée lors de vos précédents baisers."

# game/scripts/c25/c25.rpy:263
translate french c25s001_Eva_74fb1f5c:

    # "Parece que el juego de bailes y striptease ha hecho que tenga ganas de más. Igual que tú."
    "Il semblerait que le jeu de la danse et du strip-tease m'ait laissé sur ma faim. Tout comme vous."

# game/scripts/c25/c25.rpy:264
translate french c25s001_Eva_269613c3:

    # "Sus labios aprisionan los tuyos en una batalla que los dos ganáis. Su lengua lucha con la tuya. Vuestros alientos se entremezclan."
    "Ses lèvres capturent les vôtres dans une bataille que vous remportez tous deux. Sa langue se bat avec la vôtre. Vos souffles se mêlent."

# game/scripts/c25/c25.rpy:266
translate french c25s001_Eva_afc6301a:

    # "Sin dejar de besarte, la preciosa pelirroja alarga la mano para coger la pistola."
    "Sans cesser de vous embrasser, la belle rousse tend la main pour ramasser le pistolet."

# game/scripts/c25/c25.rpy:269
translate french c25s001_Eva_ee71ee81:

    # "*Bang*"
    "*Claquer*"

# game/scripts/c25/c25.rpy:272
translate french c25s001_Eva_ee71ee81_1:

    # "*Bang*"
    "*Claquer*"

# game/scripts/c25/c25.rpy:275
translate french c25s001_Eva_ee71ee81_2:

    # "*Bang*"
    "*Claquer*"

# game/scripts/c25/c25.rpy:276
translate french c25s001_Eva_1449d702:

    # "Dispara tres veces en rápida sucesión sin ni siquiera mirar a la diana."
    "Il tire trois fois en succession rapide sans même regarder la cible."

# game/scripts/c25/c25.rpy:277
translate french c25s001_Eva_10500c1f:

    # "No necesitas mirar para saber que ha acertado todos los disparos. Ni siquiera te importa si lo ha hecho."
    "Pas besoin de regarder pour savoir qu'il a réussi tous ses coups. Et ça ne vous intéresse même pas."

# game/scripts/c25/c25.rpy:279
translate french c25s001_Eva_f3130e66:

    # "La hermosa pelirroja interrumpe el beso y te mira con una pícara sonrisa."
    "La belle rousse interrompt le baiser et vous regarde avec un sourire malicieux."

# game/scripts/c25/c25.rpy:280
translate french c25s001_Eva_82e99a82:

    # eva "Creo que me he ganado una prenda."
    eva "Je crois que j'ai mérité un vêtement."

# game/scripts/c25/c25.rpy:281
translate french c25s001_Eva_fc77edc8:

    # mc "Creía que era yo el que se las había ganado."
    mc "Je croyais être celle qui les avait mérités."

# game/scripts/c25/c25.rpy:282
translate french c25s001_Eva_c83afe6f:

    # eva "*Risa* He disparado yo."
    eva "*Rires* J'ai tiré dessus."

# game/scripts/c25/c25.rpy:283
translate french c25s001_Eva_ccfc52f7:

    # mc "*Risa* Demuéstralo."
    mc "*Rires* Prouve-le."

# game/scripts/c25/c25.rpy:285
translate french c25s001_Eva_adc187a6:

    # eva "*Risa* Te propongo un trato. Todas tus prendas por todas las mías."
    eva "*Rires* Je vous propose un marché. Tous vos vêtements contre tous les miens."

# game/scripts/c25/c25.rpy:286
translate french c25s001_Eva_8d117477:

    # mc "*Risa* Me parece un trato justo. Aunque eso acabará los incentivos para el entrenamiento."
    mc "*Rires* Ça me paraît un bon compromis. Même si ça va décourager toute formation."

# game/scripts/c25/c25.rpy:288
translate french c25s001_Eva_687e0cce:

    # eva "*Risa* Que le jodan al entrenamiento. La ropa me quema sobre la piel. Y seguro que empezabas a pagar prenda con las putas botas."
    eva "*Rires* L'entraînement, c'est nul. Ces vêtements me brûlent la peau. Et je parie que tu commençais à le payer cher avec ces fichues bottes."

# game/scripts/c25/c25.rpy:289
translate french c25s001_Eva_bdaafdef:

    # mc "*Risa* ¡Ese lenguaje! ¡No estamos en un cuartel!"
    mc "*Rires* Quel langage ! On n'est pas dans une caserne !"

# game/scripts/c25/c25.rpy:291
translate french c25s001_Eva_0d2e69b7:

    # eva "*Risa* Tienes suerte de que no estemos en un cuartel o ahora mismo estarías haciendo flexiones."
    eva "*Rires* Tu as de la chance qu'on ne soit pas dans une caserne, sinon tu serais en train de faire des pompes en ce moment."

# game/scripts/c25/c25.rpy:292
translate french c25s001_Eva_0d340a6d:

    # eva "Desnúdate. ¡Ya!"
    eva "Déshabillez-vous. Maintenant !"

# game/scripts/c25/c25.rpy:294
translate french c25s001_Eva_08d5442d:

    # eva "Y no mires."
    eva "Et ne regardez pas."

# game/scripts/c25/c25.rpy:296
translate french c25s001_Eva_6db9118f:

    # "Te sorprende que ahora se vuelva tímida después de como se ha estado comportando, pero puedes esperar un poco para verla desnuda."
    "Vous êtes surpris qu'elle soit soudainement devenue timide après son comportement habituel, mais vous pouvez attendre un peu avant de la voir nue."

# game/scripts/c25/c25.rpy:297
translate french c25s001_Eva_3cbfd07a:

    # "Conociendo el fuego que la recorre, esperabas que os estuvierais arrancando la ropa mutuamente."
    "Connaissant la passion qui l'anime, vous vous attendiez à ce que vous vous arrachiez mutuellement vos vêtements."

# game/scripts/c25/c25.rpy:298
translate french c25s001_Eva_b9483fd3:

    # "Acabas de desnudarte y te quedas mirando en dirección opuesta a ella."
    "Tu viens de te déshabiller et tu regardes dans la direction opposée à la sienne."

# game/scripts/c25/c25.rpy:299
translate french c25s001_Eva_6cd40a10:

    # "Unos eternos segundos."
    "Quelques secondes qui dureront une éternité."

# game/scripts/c25/c25.rpy:300
translate french c25s001_Eva_73abbc1f:

    # eva "Ya puedes girarte."
    eva "Vous pouvez faire demi-tour maintenant."

# game/scripts/c25/c25.rpy:306
translate french c25s001_Eva_e60234c7:

    # mc "¡Wow!"
    mc "Ouah!"

# game/scripts/c25/c25.rpy:308
translate french c25s001_Eva_229fde86_1:

    # eva "¿Te gusta lo que ves?"
    eva "Ce que vous voyez vous plaît ?"

# game/scripts/c25/c25.rpy:311
