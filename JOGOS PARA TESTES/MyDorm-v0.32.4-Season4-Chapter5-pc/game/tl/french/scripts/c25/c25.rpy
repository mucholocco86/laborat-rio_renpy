    "*Toc-Toc*"

# game/scripts/c25/c25.rpy:754
translate french c25s002_AmaHelo_7b542366:

    # ama "*A través de la puerta* Soy yo. Dejad de disparar."
    ama "*À travers la porte* C'est moi. Arrêtez de tirer."

# game/scripts/c25/c25.rpy:756
translate french c25s002_AmaHelo_494514af:

    # mc "Pasa, [ama]. Estoy solo."
    mc "Entre, [ama]. Je suis seul."

# game/scripts/c25/c25.rpy:758
translate french c25s002_AmaHelo_6a99b549:

    # ama "¿Dónde está [eva]?"
    ama "Où se trouve [eva] ?"

# game/scripts/c25/c25.rpy:759
translate french c25s002_AmaHelo_3068a9d6:

    # mc "Ha ido al lavabo. En cuanto vuelva iré a darme una ducha."
    mc "Elle est allée aux toilettes. Dès qu'elle revient, j'irai prendre une douche."

# game/scripts/c25/c25.rpy:761
translate french c25s002_AmaHelo_3fea9d67:

    # ama "Sí, será lo mejor. Hueles a pólvora..."
    ama "Oui, c'est mieux ainsi. Tu sens la poudre à canon..."

# game/scripts/c25/c25.rpy:762
translate french c25s002_AmaHelo_7c98e1a2:

    # mc "*Risa* Para una reunión con tipos malotes no me parece una mala colonia: *Con acento francés* Eau de pólvora."
    mc "*Rires* Pour une rencontre avec des méchants, je ne pense pas que ce soit une mauvaise eau de Cologne : *Avec un accent français* Eau de polvora."

# game/scripts/c25/c25.rpy:764
translate french c25s002_AmaHelo_9ea68e3b:

    # ama "No son tipos malotes, [mc]. Son asesinos como lo somos [eva] y yo. Ya has visto los expedientes."
    ama "Ce ne sont pas juste des méchants, [mc]. Ce sont des tueurs, tout comme [eva] et moi. Tu as vu les dossiers."

# game/scripts/c25/c25.rpy:765
translate french c25s002_AmaHelo_8f2da685:

    # ama "Aparte de Ichigo y algunos militares, el resto son mafiosos y traficantes."
    ama "Hormis Ichigo et quelques militaires, les autres sont des mafieux et des trafiquants."

# game/scripts/c25/c25.rpy:766
translate french c25s002_AmaHelo_044f1a5a:

    # ama "No es para tomárselo a broma."
    ama "Il ne faut pas prendre cela à la légère."

# game/scripts/c25/c25.rpy:767
translate french c25s002_AmaHelo_73649545:

    # mc "No me lo tomo a broma, [ama]. Puedo bromear contigo, pero en ningún momento voy a tomármelo a broma."
    mc "Je ne prends pas ça à la légère, [ama]. Je peux plaisanter avec toi, mais je ne vais pas prendre ça à la légère."

# game/scripts/c25/c25.rpy:769
translate french c25s002_AmaHelo_08ec546e:

    # ama "Si algo bueno ha tenido NTR es que sólo ha aceptado gobiernos como clientes."
    ama "S'il y a un point positif concernant NTR, c'est qu'elle n'a accepté que des gouvernements comme clients."

# game/scripts/c25/c25.rpy:770
translate french c25s002_AmaHelo_fe5a0fdd:

    # ama "Es más... limpio."
    ama "C'est plus propre."

# game/scripts/c25/c25.rpy:771
translate french c25s002_AmaHelo_73fa82f3:

    # mc "Y será más limpio aún una vez nos libremos de esa parte del negocio, no te preocupes."
    mc "Et ce sera encore plus propre une fois que nous nous serons débarrassés de cette partie de l'entreprise, ne vous inquiétez pas."

# game/scripts/c25/c25.rpy:774
translate french c25s002_AmaHelo_d6cc1b64:

    # ama "¿Cómo ha ido el entrenamiento-cita?"
    ama "Comment s'est déroulée la séance de formation ?"

# game/scripts/c25/c25.rpy:776
translate french c25s002_AmaHelo_6261797a:

    # ama "¿Cómo ha ido el entrenamiento?"
    ama "Comment s'est déroulée la formation ?"

# game/scripts/c25/c25.rpy:777
translate french c25s002_AmaHelo_a37d1ddb:

    # mc "Muy bien. Creo que [eva] te debe dinero. He conseguido el objetivo a los siete metros."
    mc "Très bien. Je crois que [eva] te doit de l'argent. J'ai touché la cible à sept mètres."

# game/scripts/c25/c25.rpy:779
translate french c25s002_AmaHelo_42f32fe8:

    # eva "¡Chivato! *Risa* Lo ha hecho mejor de lo que esperaba. Pero no es dinero lo que habíamos apostado."
    eva "Balance ! *Rires* Il a fait mieux que prévu. Mais on n'avait pas parié d'argent."

# game/scripts/c25/c25.rpy:780
translate french c25s002_AmaHelo_a1d9da83:

    # mc "¿Qué habíais apostado?"
    mc "Qu'as-tu parié ?"

# game/scripts/c25/c25.rpy:782
translate french c25s002_AmaHelo_ea198bf0:

    # ama "[eva] va a tener que hacer la limpieza de la base hasta que nos vayamos a Aruba."
    ama "[eva] devra nettoyer la base jusqu'à notre départ pour Aruba."

# game/scripts/c25/c25.rpy:783
translate french c25s002_AmaHelo_5004716a:

    # ama "Le servirá de entrenamiento para cuando estemos fuera. No se le da muy bien la escoba. *Risa* Aún está buscando el gatillo."
    ama "Ça lui servira d'entraînement pour nos sorties. Il n'est pas très doué avec un balai. *Rires* Il cherche encore le bon moment pour s'y mettre."

# game/scripts/c25/c25.rpy:785
translate french c25s002_AmaHelo_edd38c32:

    # eva "*Grrrr*"
    eva "*Grrrr*"

# game/scripts/c25/c25.rpy:786
translate french c25s002_AmaHelo_72de87dc:

    # mc "*Risa* Voy a ducharme."
    mc "*Rires* Je vais prendre une douche."

# game/scripts/c25/c25.rpy:788
translate french c25s002_AmaHelo_df416df9:

    # ama "Ahora te llevo el traje a la oficina. Te esperamos aquí."
    ama "Je vais apporter le costume au bureau tout de suite. On vous attend ici."

# game/scripts/c25/c25.rpy:790
translate french c25s002_AmaHelo_89c5abfd:

    # "Después de la ducha, con el traje puesto..."
    "Après la douche, en maillot de bain..."

# game/scripts/c25/c25.rpy:791
translate french c25s002_AmaHelo_f6878a68:

    # mc "Cuando quieras."
    mc "Quand vous voulez."

# game/scripts/c25/c25.rpy:792
translate french c25s002_AmaHelo_fb1fe5ec:

    # ama "Me dejas sin palabras." (multiple=2)
    ama "Vous me laissez sans voix." (multiple=2)

# game/scripts/c25/c25.rpy:793
translate french c25s002_AmaHelo_57c734ca:

    # eva "¡Wow! Me encanta ese traje." (multiple=2)
    eva "Waouh ! J'adore cette tenue." (multiple=2)

# game/scripts/c25/c25.rpy:794
translate french c25s002_AmaHelo_cf43b851:

    # mc "Gracias, chicas."
    mc "Merci les filles."

# game/scripts/c25/c25.rpy:796
translate french c25s002_AmaHelo_85a47555:

    # eva "Voy a recoger todo esto un poco antes de volver a la base. Mañana vengo con las chicas..."
    eva "Je vais ranger un peu tout ça avant de rentrer à la base. Je rejoins les filles demain..."

# game/scripts/c25/c25.rpy:797
translate french c25s002_AmaHelo_fbd6731e:

    # eva "Me servirá de entrenamiento con la escoba."
    eva "Cela me permettra de m'entraîner à manier le balai."

# game/scripts/c25/c25.rpy:798
translate french c25s002_AmaHelo_ebe3097d:

    # mc "*Risa* La parte peluda es la que va hacia el suelo."
    mc "*Rires* La partie poilue, c'est celle qui va vers le sol."

# game/scripts/c25/c25.rpy:799
translate french c25s002_AmaHelo_1b219632:

    # mc "*Risa* Quería devolvértela desde aquel día en el lago cuando me dijiste que la parte del agujero de la pistola es por donde salían las balas."
    mc "*Rires* Je voulais me venger depuis ce jour au lac où tu m'as dit que c'est par la partie avec le trou dans le fusil que les balles sortent."

# game/scripts/c25/c25.rpy:801
translate french c25s002_AmaHelo_5ecb02a4:

    # eva "Muy gracioso..."
    eva "Très drôle..."

# game/scripts/c25/c25.rpy:802
translate french c25s002_AmaHelo_e6e3d5a3:

    # eva "Os veo mañana. Suerte."
    eva "À demain. Bonne chance."

# game/scripts/c25/c25.rpy:804
translate french c25s002_AmaHelo_c46d96ad:

    # ama "Nosotros vamos a esperar el helicóptero fuera. Debe estar a punto de llegar."
    ama "Nous attendrons l'hélicoptère dehors. Il devrait arriver d'une minute à l'autre."

# game/scripts/c25/c25.rpy:805
translate french c25s002_AmaHelo_73ceecc0:

    # mc "Como quieras."
    mc "Tout ce que vous voulez."

# game/scripts/c25/c25.rpy:807
translate french c25s002_AmaHelo_b19024b5:

    # mc "Veo que tú también has escondido la furgoneta."
    mc "Je vois que vous avez aussi caché la camionnette."

# game/scripts/c25/c25.rpy:808
translate french c25s002_AmaHelo_254e14a6:

    # ama "Si dices 'también' supongo que [eva] te ha explicado la razón para hacerlo."
    ama "Si vous dites « aussi », je suppose que [eva] a expliqué la raison de cela."

# game/scripts/c25/c25.rpy:809
translate french c25s002_AmaHelo_13f8337d:

    # mc "Sí, la considero lógica. Son cosas en las que yo no pensaría nunca."
    mc "Oui, je pense que c'est logique. Ce sont des choses auxquelles je n'aurais jamais pensé."

# game/scripts/c25/c25.rpy:811
translate french c25s002_AmaHelo_2048a6f5:

    # ama "Para eso nos tienes a nosotras. Nos han entrenado para esto."
    ama "C'est pour ça qu'on est là. On a été formés pour ça."

# game/scripts/c25/c25.rpy:812
translate french c25s002_AmaHelo_30665ae1:

    # mc "Y sois la mejor compañía que podría tener para hacer esto ¿Algún último consejo para la reunión?"
    mc "Et vous êtes la meilleure entreprise avec laquelle je pouvais faire cela. Un dernier conseil pour la réunion ?"

# game/scripts/c25/c25.rpy:814
translate french c25s002_AmaHelo_2c6c69af:

    # ama "Lo mismo que te he dicho estos días. No muestres tus puntos débiles, no te comprometas a nada, y no caigas en ninguna provocación."
    ama "C'est la même chose que je vous répète depuis quelques jours. Ne montrez pas vos faiblesses, ne vous engagez à rien et ne cédez à aucune provocation."

# game/scripts/c25/c25.rpy:815
translate french c25s002_AmaHelo_bbd4519f:

    # ama "Ichigo va a aprovechar cualquier punto débil que pueda encontrar."
    ama "Ichigo exploitera la moindre faiblesse qu'il pourra trouver."

# game/scripts/c25/c25.rpy:816
translate french c25s002_AmaHelo_04a071c1:

    # mc "Por suerte, te tendré conmigo para evitar que cometa cualquier error infantil."
    mc "Heureusement, tu seras là pour m'éviter de faire des erreurs enfantines."

# game/scripts/c25/c25.rpy:818
translate french c25s002_AmaHelo_aa80181c:

    # ama "Tan solo tienes que pensar antes de actuar."
    ama "Il faut simplement réfléchir avant d'agir."

# game/scripts/c25/c25.rpy:820
translate french c25s002_AmaHelo_7d4fec1e:

    # ama "Es hora de prepararse. Oigo el helicóptero."
    ama "Il est temps de se préparer. J'entends l'hélicoptère."

# game/scripts/c25/c25.rpy:823
translate french c25s002_AmaHelo_065bb374:

    # "Un minuto después, aterriza un helicóptero en el aparcamiento. El ruido es ensordecedor."
    "Une minute plus tard, un hélicoptère atterrit sur le parking. Le bruit est assourdissant."

# game/scripts/c25/c25.rpy:825
translate french c25s002_AmaHelo_af736a31:

    # "???" "¿Señor Marks? ¿Señorita Gilford?"
    "???" "Monsieur Marks ? Mademoiselle Gilford ?"

# game/scripts/c25/c25.rpy:826
translate french c25s002_AmaHelo_8969bc10:

    # mc "Sí, y usted es..."
    mc "Oui, et vous l'êtes..."

# game/scripts/c25/c25.rpy:827
translate french c25s002_AmaHelo_e5195af9:

    # "Kostner" "Kostner. ¿Me acompañan al helicóptero?"
    "Kostner" "Kostner. Voulez-vous m'accompagner jusqu'à l'hélicoptère ?"

# game/scripts/c25/c25.rpy:829
translate french c25s002_AmaHelo_1676d518:

    # "Nada más sentaros, [ama] se pone unos auriculares y te indica que te pongas unos que hay colgando a tu espalda. Te los pones."
    "Dès que vous vous asseyez, [ama] met des écouteurs et vous dit d'en mettre d'autres qui sont accrochés derrière vous. Vous les mettez."

# game/scripts/c25/c25.rpy:830
translate french c25s002_AmaHelo_0bc3e242:

    # mc "*Gritando* Ahora entiendo por qué gritan tanto en las películas cuando van en helicóptero."
    mc "*Cris* Maintenant je comprends pourquoi ils crient autant dans les films quand ils sont dans un hélicoptère."

# game/scripts/c25/c25.rpy:831
translate french c25s002_AmaHelo_33d819e7:

    # ama "No hace falta que grites demasiado con esto. De lo que pase en las películas..."
    ama "Inutile d'en faire tout un plat. C'est comme dans les films..."

# game/scripts/c25/c25.rpy:832
translate french c25s002_AmaHelo_da069275:

    # mc "Lo sé, no me puedo fiar."
    mc "Je sais, je ne peux pas lui faire confiance."

# game/scripts/c25/c25.rpy:833
translate french c25s002_AmaHelo_c2bcb16d:

    # ama "Será mejor que no digas nada en este viaje de lo que no quieras que se enteren."
    ama "Il vaut mieux ne rien dire pendant ce voyage que vous ne voudriez pas qu'ils découvrent."

# game/scripts/c25/c25.rpy:834
translate french c25s002_AmaHelo_962b4142:

    # mc "Entendido."
    mc "Compris."

# game/scripts/c25/c25.rpy:836
translate french c25s002_AmaHelo_212afea5:

    # "El helicóptero viaja mar adentro durante varios minutos alejándose de la costa."
    "L'hélicoptère s'éloigne des côtes en mer pendant plusieurs minutes."

# game/scripts/c25/c25.rpy:837
translate french c25s002_AmaHelo_2adbcdb9:

    # "Es tu primera vez en un helicóptero lo que hace los primeros minutos emocionantes. Después, es como ir en un taxi ruidoso."
    "C'est votre premier vol en hélicoptère, ce qui rend les premières minutes palpitantes. Après, c'est comme prendre un taxi bruyant."

# game/scripts/c25/c25.rpy:839
translate french c25s002_AmaHelo_55cf0135:

    # mc "Creía que la reunión era en el puerto de Westport."
    mc "Je croyais que la réunion avait lieu au port de Westport."

# game/scripts/c25/c25.rpy:840
translate french c25s002_AmaHelo_af81e864:

    # ama "Creo que vamos a salir de las aguas territoriales de Estados Unidos."
    ama "Je pense que nous allons quitter les eaux territoriales américaines."

# game/scripts/c25/c25.rpy:841
translate french c25s002_AmaHelo_35e16972:

    # mc "¡Eso son 200 millas!"
    mc "Cela représente 200 miles !"

# game/scripts/c25/c25.rpy:843
translate french c25s002_AmaHelo_647a523d:

    # ama "*Risa* Eso es la Zona Económica Exclusiva, que son 200 millas NÁUTICAS. 225 millas terrestres."
    ama "*Rires* C'est la zone économique exclusive, qui s'étend sur 200 milles nautiques, soit 225 milles terrestres."

# game/scripts/c25/c25.rpy:844
translate french c25s002_AmaHelo_55db1520:

    # ama "Yo me refiero a las aguas territoriales. 12 millas náuticas, 13.5 millas terrestres."
    ama "Je fais référence aux eaux territoriales. 12 milles nautiques, 13,5 milles terrestres."

# game/scripts/c25/c25.rpy:845
translate french c25s002_AmaHelo_3574fa84:

    # mc "¿Por qué tan lejos?"
    mc "Pourquoi si loin ?"

# game/scripts/c25/c25.rpy:847
translate french c25s002_AmaHelo_4ad3cccf:

    # ama "Ya has visto la lista de invitados. Seguro que se hace algo ilegal en ese barco. Prostitución, drogas..."
    ama "Vous avez vu la liste des invités. Je suis sûr qu'il se passe des choses illégales sur ce bateau. Prostitution, drogue…"

# game/scripts/c25/c25.rpy:848
translate french c25s002_AmaHelo_7d2af2cb:

    # ama "En aguas territoriales se aplican las leyes americanas y podrían tener problemas."
    ama "Les lois américaines s'appliquent dans les eaux territoriales et cela pourrait poser problème."

# game/scripts/c25/c25.rpy:849
translate french c25s002_AmaHelo_cadae66b:

    # mc "Claro. Lo entiendo."
    mc "Bien sûr. Je comprends."

# game/scripts/c25/c25.rpy:851
translate french c25s002_AmaHelo_62691890:

    # "Unos minutos después, puedes ver el enorme yate flotando, majestuoso en medio de la nada, cuando el helicóptero gira para hacer la maniobra de aproximación."
    "Quelques minutes plus tard, on aperçoit l'énorme yacht flottant majestueusement au milieu de nulle part, tandis que l'hélicoptère effectue sa manœuvre d'approche."

# game/scripts/c25/c25.rpy:853
translate french c25s002_AmaHelo_4f1281dd:

    # mc "¡Es enorme!"
    mc "C'est énorme !"

# game/scripts/c25/c25.rpy:854
translate french c25s002_AmaHelo_0c558043:

    # ama "*Risa* ¡Eso dijo ella!"
    ama "*Rires* C'est ce qu'elle a dit !"

# game/scripts/c25/c25.rpy:855
translate french c25s002_AmaHelo_752cb9f2:

    # mc "*Risa* ¡Qué gran serie!"
    mc "*Rires* Quelle super série !"

# game/scripts/c25/c25.rpy:857
translate french c25s002_AmaHelo_f41581d9:

    # mc "¿Eso son ametralladoras?"
    mc "Ce sont des mitrailleuses ?"

# game/scripts/c25/c25.rpy:858
translate french c25s002_AmaHelo_5c5f0774:

    # ama "Estaciones de armas. Pero sí, para ti, son ametralladoras."
    ama "Postes de tir. Mais oui, pour vous, ce sont des mitrailleuses."

# game/scripts/c25/c25.rpy:860
translate french c25s002_AmaHelo_2a167ef3:

    # ama "Para mí estaciones bastante inútiles. No pueden cubrir todas las aproximaciones al barco."
    ama "À mon avis, ces stations sont plutôt inutiles. Elles ne permettent pas de couvrir tous les accès au navire."

# game/scripts/c25/c25.rpy:861
translate french c25s002_AmaHelo_0c10fbe0:

    # ama "Creo que están para impresionar. Supongo que más a clientes que a posibles asaltantes."
    ama "Je pense qu'ils sont là pour impressionner. J'imagine qu'il y a plus de clients que de voleurs potentiels."

# game/scripts/c25/c25.rpy:862
translate french c25s002_AmaHelo_dc1d549c:

    # ama "Ya he descubierto al menos tres puntos por donde subir al barco fuera del alcance de las estaciones de armas."
    ama "J'ai déjà découvert au moins trois points d'abordage du vaisseau hors de portée des stations d'armement."

# game/scripts/c25/c25.rpy:863
translate french c25s002_AmaHelo_71e7f957:

    # mc "No dejas de sorprenderme..."
    mc "Tu ne cesses de m'étonner..."

# game/scripts/c25/c25.rpy:872
translate french c25s002_IronFist_1bb816d1:

    # "Al bajar del helicóptero, encuentras una sorpresa esperándote."
    "En sortant de l'hélicoptère, une surprise vous attend."

# game/scripts/c25/c25.rpy:875
translate french c25s002_IronFist_33167358:

    # mc "¿Qué hace [kim] aquí?"
    mc "Que fait [kim] ici ?"

# game/scripts/c25/c25.rpy:877
translate french c25s002_IronFist_aab61a7a:

    # ama "No tengo ni idea. Sabía que tenía un evento hoy en un yate, pero no podía imaginar que fuera aquí."
    ama "Je n'en ai aucune idée. Je savais que j'avais un événement aujourd'hui sur un yacht, mais je n'aurais jamais imaginé que ce serait ici."

# game/scripts/c25/c25.rpy:878
translate french c25s002_IronFist_2c196318:

    # ama "No des muestras de conocerla. Me parece que hay algo turbio aquí."
    ama "Ne laisse pas croire que tu la connais. Je pense qu'il y a anguille sous roche."

# game/scripts/c25/c25.rpy:879
translate french c25s002_IronFist_20dbbe35:

    # mc "Tienes razón. Me parece que será lo mejor."
    mc "Vous avez raison. Je pense que ce sera mieux ainsi."

# game/scripts/c25/c25.rpy:880
translate french c25s002_IronFist_5994add1:

    # ama "Vamos a acercarnos."
    ama "Rapprochons-nous."

# game/scripts/c25/c25.rpy:882
translate french c25s002_IronFist_06d50574:

    # kim "¿[mc]? ¿[ama]? ¿Qué hacéis...?"
    kim "[mc]? [ama]? Que fais-tu...?"

# game/scripts/c25/c25.rpy:883
translate french c25s002_IronFist_849ad7a0:

    # mc "Sí. [mc] Marks, de NTR. Y mi asistente, la Señorita Gilford."
    mc "Oui. [mc] Marks, de NTR. Et mon assistante, Mlle Gilford."

# game/scripts/c25/c25.rpy:885
translate french c25s002_IronFist_7db32d32:

    # kim "Bienvenidos al Luxe. ¿Les apetece una copa de champagne?"
    kim "Bienvenue chez Luxe. Souhaitez-vous une coupe de champagne ?"

# game/scripts/c25/c25.rpy:886
translate french c25s002_IronFist_b1fa3eeb:

    # mcp "(Chica lista. Se ha dado cuenta de que estoy fingiendo no conocerla y ha empezado a actuar profesionalmente.)"
    mcp "(Maline. Elle a compris que je faisais semblant de ne pas la connaître et elle a commencé à se comporter de manière professionnelle.)"

# game/scripts/c25/c25.rpy:887
translate french c25s002_IronFist_58c8c47a:

    # mc "No, gracias."
    mc "Non merci."

# game/scripts/c25/c25.rpy:889
translate french c25s002_IronFist_1f34fcb8:

    # kim "El Sr. Ichigo está en la cubierta superior. ¿Me quieren acompañar, por favor?"
    kim "Monsieur Ichigo se trouve sur le pont supérieur. Voulez-vous me rejoindre, s'il vous plaît ?"

# game/scripts/c25/c25.rpy:890
translate french c25s002_IronFist_eee71231:

    # mc "Adelante, por favor. Indíquenos el camino."
    mc "Allez-y, je vous en prie. Montrez-nous le chemin."

# game/scripts/c25/c25.rpy:892
translate french c25s002_IronFist_91a00641:

    # "Seguís a [kim] a través de unas escaleras hasta la cubierta principal, donde está la piscina."
    "Vous suivez [kim] jusqu'à l'escalier menant au pont principal, où se trouve la piscine."

# game/scripts/c25/c25.rpy:893
translate french c25s002_IronFist_00dc971a:

    # "[ama] te va dando información de quién es quién. No es necesario. Esta vez has leído los expedientes, pero no la quieres interrumpir."
    "[ama] Elle vous donne des informations sur les personnes impliquées. Ce n'est pas nécessaire. Vous avez déjà lu les dossiers, mais vous ne voulez pas l'interrompre."

# game/scripts/c25/c25.rpy:894
translate french c25s002_IronFist_828699f1:

    # ama "Fong, prostitución y tráfico de personas y armas. De una de las tríadas de San Francisco."
    ama "Fong, prostitution, trafic d'êtres humains et d'armes. Issu d'une des triades de San Francisco."

# game/scripts/c25/c25.rpy:895
translate french c25s002_IronFist_0e18f730:

    # ama "Davidovic, traficante de drogas y armas de Serbia."
    ama "Davidovic, trafiquant de drogue et d'armes serbe."

# game/scripts/c25/c25.rpy:896
translate french c25s002_IronFist_a88541c9:

    # mc "Supongo que las chicas deben ser..."
    mc "J'imagine que les filles doivent être..."

# game/scripts/c25/c25.rpy:898
translate french c25s002_IronFist_24b8f9b4:

    # ama "Prostitutas, supongo. Como te he dicho, si salíamos de las aguas territoriales sería por algo así."
    ama "Des prostituées, j'imagine. Comme je l'ai dit, si nous quittions les eaux territoriales, ce serait pour quelque chose comme ça."

# game/scripts/c25/c25.rpy:899
translate french c25s002_IronFist_ff00476d:

    # mc "Me da la sensación de estar en un videojuego o una película. Esto suena surrealista."
    mc "J'ai l'impression d'être dans un jeu vidéo ou un film. C'est surréaliste."

# game/scripts/c25/c25.rpy:901
translate french c25s002_IronFist_ba33b84b:

    # "[kim] os lleva a la cubierta superior, donde Ichigo está hablando con un hombre y una mujer."
    "[kim] vous emmène sur le pont supérieur, où Ichigo parle à un homme et une femme."

# game/scripts/c25/c25.rpy:902
translate french c25s002_IronFist_871ea4a4:

    # ama "General Fuckebythenavele. Ejército."
    ama "Général Fuckebythenavele. Armée."

# game/scripts/c25/c25.rpy:903
translate french c25s002_IronFist_fd40b062:

    # mcp "(¿Fuckebythenavele? Lo había leído en el expediente, pero creía que era algún tipo de broma de [ama].)"
    mcp "(Fuckebythenavele ? Je l'avais lu dans le fichier, mais je pensais que c'était une sorte de blague [ama].)"

# game/scripts/c25/c25.rpy:904
translate french c25s002_IronFist_c74cb228:

    # ama "Alejandra García, ministerio de interior de México."
    ama "Alejandra García, Ministère de l'Intérieur du Mexique."

# game/scripts/c25/c25.rpy:905
translate french c25s002_IronFist_5ec6f213:

    # ama "Y, óbviamente, Ichigo."
    ama "Et, évidemment, Ichigo."

# game/scripts/c25/c25.rpy:906
translate french c25s002_IronFist_bfd72421:

    # mc "Esta cubierta parece casi normal comparada con la de abajo."
    mc "Cette couverture paraît presque normale comparée à celle ci-dessous."

# game/scripts/c25/c25.rpy:908
translate french c25s002_IronFist_e9e094ea:

    # mc "Casi me siento como un pececillo entre tiburones."
    mc "J'ai presque l'impression d'être un petit poisson au milieu des requins."

# game/scripts/c25/c25.rpy:909
translate french c25s002_IronFist_484b8f64:

    # ama "No te preocupes, lo harás bien."
    ama "Ne t'inquiète pas, tout ira bien."

# game/scripts/c25/c25.rpy:915
translate french c25s002_IronFist_7166247e:

    # "Llegáis a donde están Ichigo y sus acompañantes."
    "Vous arrivez là où se trouvent Ichigo et ses compagnons."

# game/scripts/c25/c25.rpy:916
translate french c25s002_IronFist_64277485:

    # kim "Sr. Ichigo, el Señor Marks y la Señorita Gilford, de NTR."
    kim "M. Ichigo, M. Marks et Mlle Gilford, de NTR."

# game/scripts/c25/c25.rpy:917
translate french c25s002_IronFist_59d605cb:

    # ich "Gracias, chica. Puedes volver al helipuerto."
    ich "Merci, ma belle. Tu peux retourner à l'héliport."

# game/scripts/c25/c25.rpy:919
translate french c25s002_IronFist_9acadcc3:

    # kim "Creo que eran los últimos invitados."
    kim "Je crois que c'étaient les derniers invités."

# game/scripts/c25/c25.rpy:920
translate french c25s002_IronFist_49e86576:

    # ich "Te he dicho que vuelvas al helipuerto, chica. Eres necesaria allí."
    ich "Je t'avais dit de retourner à l'héliport, ma fille. On a besoin de toi là-bas."

# game/scripts/c25/c25.rpy:921
translate french c25s002_IronFist_dc0284b3:

    # "El tono despreciativo de Ichigo te molesta por alguna razón. Seguramente porque va dirigido a [kim]."
    "Le ton méprisant d'Ichigo vous dérange pour une raison inconnue. Sans doute parce qu'il est adressé à [kim]."

# game/scripts/c25/c25.rpy:923
translate french c25s002_IronFist_d668118e:

    # kim "Sí, Sr. Ichigo."
    kim "Oui, Monsieur Ichigo."

# game/scripts/c25/c25.rpy:925
translate french c25s002_IronFist_72a5dcb9:

    # ich "Encantado de conocerle por fin, Sr. Marks."
    ich "Enchanté de enfin vous rencontrer, Monsieur Marks."

# game/scripts/c25/c25.rpy:926
translate french c25s002_IronFist_ad9b86e3:

    # mc "Igualmente, Sr. Ichigo. Un yate impresionante."
    mc "De même, Monsieur Ichigo. Un yacht impressionnant."

# game/scripts/c25/c25.rpy:927
translate french c25s002_IronFist_1aff69e9:

    # ich "Gracias. Es uno de los activos más vistosos de Iron Fist."
    ich "Merci. C'est l'un des atouts les plus remarquables d'Iron Fist."

# game/scripts/c25/c25.rpy:929
translate french c25s002_IronFist_e82f729d:

    # ich "Déjame presentarte a algunos de nuestros invitados, muchacho."
    ich "Permettez-moi de vous présenter quelques-uns de nos invités, mon garçon."

# game/scripts/c25/c25.rpy:930
translate french c25s002_IronFist_1db898aa:

    # ich "General Fuckebythenavele, el Sr. Marks y la Srta. Gilford, de NTR."
    ich "Le général Fuckebythenavele, M. Marks et Mlle Gilford, de NTR."

# game/scripts/c25/c25.rpy:931
translate french c25s002_IronFist_a10a2379:

    # gfu "Un placer conocerle. He trabajado en varias ocasiones con sus predecesores. Espero continuar la relación con usted."
    gfu "C'est un plaisir de faire votre connaissance. J'ai eu l'occasion de travailler à plusieurs reprises avec vos prédécesseurs. Je me réjouis de poursuivre notre collaboration."

# game/scripts/c25/c25.rpy:932
translate french c25s002_IronFist_69da3703:

    # mc "Igualmente. Espero que nuestra relación con su gobierno sea tan provechosa para ambas partes como lo ha sido en el pasado."
    mc "De même. J'espère que nos relations avec votre gouvernement seront aussi mutuellement bénéfiques qu'elles l'ont été par le passé."

# game/scripts/c25/c25.rpy:933
translate french c25s002_IronFist_b0f2de53:

    # ich "La Sra. García, del Gobierno de México."
    ich "Mme Garcia, du gouvernement mexicain."

# game/scripts/c25/c25.rpy:934
translate french c25s002_IronFist_9ffe8158:

    # aga "Encantada. No hemos trabajado juntos aún, pero esperamos tener la oportunidad de hacerlo en el futuro."
    aga "Enchantés. Nous n'avons pas encore eu l'occasion de travailler ensemble, mais nous espérons le faire à l'avenir."

# game/scripts/c25/c25.rpy:935
translate french c25s002_IronFist_cc69bb38:

    # mc "Encantado de conocerla. En NTR siempre estamos abiertos a nuevos socios comerciales."
    mc "Enchanté(e) de faire votre connaissance. Chez NTR, nous sommes toujours ouverts à de nouveaux partenaires commerciaux."

# game/scripts/c25/c25.rpy:936
translate french c25s002_IronFist_5fb056a2:

    # "[ama] estrecha las manos del general y la política en silencio."
    "[ama] serre la main du général et de l'homme politique en silence."

# game/scripts/c25/c25.rpy:938
translate french c25s002_IronFist_612a8788:

    # ich "Luego te presentaré al resto de asistentes. Mientras tanto, disfruta de la fiesta, muchacho."
    ich "Je te présenterai les autres invités plus tard. En attendant, amuse-toi bien, mon petit."

# game/scripts/c25/c25.rpy:940
translate french c25s002_IronFist_cc79a861:

    # ich "¡Chica! Trae algo de beber a mis invitados."
    ich "Ma petite ! Apporte quelque chose à boire à mes invités."

# game/scripts/c25/c25.rpy:942
translate french c25s002_IronFist_3551baf2:

    # "Se acerca una de las camareras, uniformada como [kim]. Crees recordar que, cuando llevaste a [kim] al puerto, dijo que se llamaba Adeline."
    "Une des serveuses s'approche, vêtue d'un uniforme semblable à celui de [kim]. Vous pensez vous souvenir que lorsque vous avez emmené [kim] au port, elle a dit s'appeler Adeline."

# game/scripts/c25/c25.rpy:944
translate french c25s002_IronFist_6d4489e6:

    # "Ahora sabes de qué te sonaba la camarera del restaurante donde fuiste con [kia]."
    "Maintenant, vous savez pourquoi la serveuse du restaurant où vous êtes allé avec [kia] vous semblait familière."

# game/scripts/c25/c25.rpy:945
translate french c25s002_IronFist_23872bda:

    # "Adeline" "¿Puedo traerles algo para beber?"
    "Adeline" "Puis-je vous offrir quelque chose à boire ?"

# game/scripts/c25/c25.rpy:946
translate french c25s002_IronFist_55ce625d:

    # ama "Agua para mí, por favor."
    ama "De l'eau pour moi, s'il vous plaît."

# game/scripts/c25/c25.rpy:947
translate french c25s002_IronFist_7d7a1008:

    # mc "Un zumo de piña para mí, si es tan amable."
    mc "Un jus d'ananas pour moi, si vous voulez bien."

# game/scripts/c25/c25.rpy:948
translate french c25s002_IronFist_8b5e3c4b:

    # "Adeline" "Ahora mismo."
    "Adeline" "Tout de suite."

# game/scripts/c25/c25.rpy:950
translate french c25s002_IronFist_12b5f176:

    # gfu "Ichigo, ¿no le ofreces las chicas a nuestro amigo?"
    gfu "Ichigo, tu ne vas pas offrir les filles à notre ami ?"

# game/scripts/c25/c25.rpy:951
translate french c25s002_IronFist_54df2213:

    # ich "Oh, claro. Si te apetece, tan solo tienes que elegir una de las chicas. Hay camarotes privados en las cubiertas inferiores."
    ich "Bien sûr. Si vous le souhaitez, il vous suffit de choisir une des filles. Il y a des cabines privées sur les ponts inférieurs."

# game/scripts/c25/c25.rpy:952
translate french c25s002_IronFist_43292d06:

    # gfu "*Risa* Cualquiera menos Alejandra, claro."
    gfu "*Rires* N'importe qui sauf Alejandra, bien sûr."

# game/scripts/c25/c25.rpy:953
translate french c25s002_IronFist_a2f6fc80:

    # aga "*Risa fingida* Sí, yo no estoy en el menú. Y para nosotras nunca traen chicos. ¿Lo ve justo, Srta. Gilford?"
    aga "*Rires forcés* Oui, je ne suis pas au menu. Et ils ne nous amènent jamais de garçons. Trouvez-vous cela juste, mademoiselle Gilford ?"

# game/scripts/c25/c25.rpy:955
translate french c25s002_IronFist_cd4e645c:

    # ama "No se preocupe por mí, Sra. García. Yo no estaría interesada en los chicos que pudieran traer."
    ama "Ne vous inquiétez pas pour moi, Mme Garcia. Je ne serais pas intéressée par les garçons que vous pourriez amener."

# game/scripts/c25/c25.rpy:957
translate french c25s002_IronFist_c46d5cc1:

    # ich "¡Oh! Entonces, también le extiendo la invitación por si quiere escoger cualquiera de las chicas, Srta. Gilford."
    ich "Oh ! Alors, je vous invite également, mademoiselle Gilford, au cas où vous souhaiteriez choisir l'une des filles."

# game/scripts/c25/c25.rpy:958
translate french c25s002_IronFist_134f59f6:

    # mcp "(Ha dicho cualquiera. ¿Eso incluye a [kim]? No creo que sepa dónde se ha metido.)"
    mcp "(Il a dit n'importe qui. Est-ce que ça inclut [kim] ? Je ne pense pas qu'il se rende compte dans quoi il s'est embarqué.)"

# game/scripts/c25/c25.rpy:960
translate french c25s002_IronFist_0978aeb5:

    # "Al cabo de unos minutos, Ichigo y Alejandra se disculpan y os dejan a solas con el general."
    "Au bout de quelques minutes, Ichigo et Alejandra s'excusent et vous laissent seul avec le général."

# game/scripts/c25/c25.rpy:961
translate french c25s002_IronFist_dc9dd7b4:

    # gfu "¿Qué le trae a esta fiesta, Sr. Marks? NTR suele ser más discreta."
    gfu "Qu'est-ce qui vous amène à cette fête, Monsieur Marks ? NTR est généralement plus discret."

# game/scripts/c25/c25.rpy:962
translate french c25s002_IronFist_c8fbb145:

    # mc "El Sr. Ichigo me invitó para conocernos después del cambio de propiedad de NTR. Represento a los accionistas mayoritarios."
    mc "M. Ichigo m'a invité à le rencontrer après le changement de propriétaire de NTR. Je représente les actionnaires majoritaires."

# game/scripts/c25/c25.rpy:963
translate french c25s002_IronFist_94137b3e:

    # mc "Tan solo es una visita de cortesía a un posible rival comercial."
    mc "Il s'agit simplement d'une visite de courtoisie à un concurrent potentiel."

# game/scripts/c25/c25.rpy:965
translate french c25s002_IronFist_fa2615bd:

    # gfu "Ichigo es... un personaje interesante. Lleva años intentando que trabajemos con él, pero preferimos compañías más... respetables, como la suya."
    gfu "Ichigo est… un personnage intéressant. Il essaie de nous faire travailler avec lui depuis des années, mais nous préférons des entreprises plus… respectables, comme la sienne."

# game/scripts/c25/c25.rpy:966
translate french c25s002_IronFist_1239ce29:

    # gfu "Dentro de lo respetable que se puede ser en este negocio, claro."
    gfu "Dans les limites de ce qui est respectable dans ce secteur, bien sûr."

# game/scripts/c25/c25.rpy:967
translate french c25s002_IronFist_eb34503e:

    # mc "Bueno, desde NTR estamos intentando ser tan respetables como sea posible. Sabemos que no es un negocio limpio, pero al menos puede ser un negocio entre caballeros."
    mc "Chez NTR, nous nous efforçons d'être aussi respectables que possible. Nous savons que ce n'est pas un secteur très propre, mais au moins, on peut le gérer avec élégance."

# game/scripts/c25/c25.rpy:969
translate french c25s002_IronFist_4ba47aa8:

    # gfu "*Risa* Un bonito objetivo. Pero todos los países necesitamos tener nuestros propios perros de presa sin tener responsabilidades si el perro hace algo que no debe."
    gfu "*Rires* Un beau but. Mais chaque pays devrait avoir ses propres chiens de garde, sans aucune responsabilité si le chien fait quelque chose d'inapproprié."

# game/scripts/c25/c25.rpy:970
translate french c25s002_IronFist_a342cad0:

    # gfu "NTR es uno de esos perros. No te lo tomes como un insulto. Sois el perro más quirúrgico que hemos tenido nunca."
    gfu "NTR fait partie de ces chiens. Ne le prenez pas mal. Vous êtes les chiens les plus chirurgicaux que nous ayons jamais eus."

# game/scripts/c25/c25.rpy:971
translate french c25s002_IronFist_03cbb3ba:

    # mc "No se preocupe, General. No me lo tomo como una ofensa. Evitar daños colaterales es una de las políticas de NTR."
    mc "Ne vous inquiétez pas, Général. Je ne le prends pas mal. Éviter les dommages collatéraux est l'une des politiques de NTR."

# game/scripts/c25/c25.rpy:973
translate french c25s002_IronFist_e417a518:

    # ama "Es una forma de que nadie se intente deshacer de un perro de presa que se ha vuelto rabioso e incómodo."
    ama "C'est un moyen d'empêcher quiconque de se débarrasser d'un chien de garde devenu enragé et dangereux."

# game/scripts/c25/c25.rpy:975
translate french c25s002_IronFist_e9048879:

    # gfu "Me gusta su política. Es una de las razones por las que es tan difícil que trabajemos con Iron Fist."
    gfu "J'aime leurs idées politiques. C'est l'une des raisons pour lesquelles il est si difficile pour nous de travailler avec Iron Fist."

# game/scripts/c25/c25.rpy:976
translate french c25s002_IronFist_f9e5c659:

    # gfu "Aparte de su lista de clientes, claro. Sería difícil defender en el Pentágono que trabajamos con los mismos tipos que las tríadas."
    gfu "Hormis leur liste de clients, bien sûr. Il serait difficile de prétendre au Pentagone que nous travaillons avec les mêmes personnes que les triades."

# game/scripts/c25/c25.rpy:977
translate french c25s002_IronFist_b46f2676:

    # mc "Lo entiendo. Entonces, ¿qué hace usted aquí, General?"
    mc "Je comprends. Alors, que faites-vous ici, Général ?"

# game/scripts/c25/c25.rpy:979
translate french c25s002_IronFist_b61a9edd:

    # gfu "Una cosa es no querer trabajar con ellos. Otra distinta insultarlos rechazando sus invitaciones."
    gfu "Ne pas vouloir travailler avec eux est une chose. Les insulter en rejetant leurs invitations en est une autre."

# game/scripts/c25/c25.rpy:980
translate french c25s002_IronFist_9204ee72:

    # gfu "Ichigo puede ser despreciable, pero ya conoces el dicho, 'Los amigos cerca y los posibles enemigos más cerca aún'."
    gfu "Ichigo est peut-être méprisable, mais comme dit le proverbe : « Les amis sont proches, mais les ennemis potentiels le sont encore plus. »"

# game/scripts/c25/c25.rpy:981
translate french c25s002_IronFist_eae00f1f:

    # gfu "Además, yo estoy aquí extraoficialmente, sin uniforme. No sé si me entiende."
    gfu "Par ailleurs, je suis ici officieusement, en civil. Je ne sais pas si vous comprenez."

# game/scripts/c25/c25.rpy:982
translate french c25s002_IronFist_49eb693c:

    # mc "Me parece una buena política."
    mc "Je pense que c'est une bonne politique."

# game/scripts/c25/c25.rpy:984
translate french c25s002_IronFist_48a06a3d:

    # gfu "Ha sido soldado y mercenario en varios conflictos, y después fue operativo de campo en Iron Fist antes de ascender."
    gfu "Il a été soldat et mercenaire dans plusieurs conflits, puis agent de terrain au sein d'Iron Fist avant de gravir les échelons."

# game/scripts/c25/c25.rpy:985
translate french c25s002_IronFist_8dca39d2:

    # gfu "Se quemó la cara en una de sus misiones. Sobre todo, no se lo menciones."
    gfu "Il s'est brûlé le visage lors d'une de ses missions. Surtout, ne lui en parlez pas."

# game/scripts/c25/c25.rpy:986
translate french c25s002_IronFist_d95481d8:

    # gfu "Ya sabes lo que se dice de cuando solo tienes un martillo como ves los problemas."
    gfu "Vous savez ce qu'on dit à propos des problèmes qu'on ne voit que lorsqu'on a un marteau."

# game/scripts/c25/c25.rpy:987
translate french c25s002_IronFist_9d03c102:

    # mc "Sí, todos los problemas se convierten en clavos."
    mc "Oui, tous les problèmes se transforment en clous."

# game/scripts/c25/c25.rpy:989
translate french c25s002_IronFist_ae5c924e:

    # "Se os acerca un hombre al que no habías visto."
    "Un homme que vous n'avez jamais vu auparavant s'approche de vous."

# game/scripts/c25/c25.rpy:990
translate french c25s002_IronFist_cdc0c28d:

    # jef "Sr. Marks, Srta. Gilford, soy Jeff Sound, hablamos por teléfono."
    jef "Monsieur Marks, Mademoiselle Gilford, ici Jeff Sound, nous avons parlé au téléphone."

# game/scripts/c25/c25.rpy:991
translate french c25s002_IronFist_e2ceb370:

    # mc "Encantado de conocerle, Sr. Sound."
    mc "Enchanté, Monsieur Sound."

# game/scripts/c25/c25.rpy:993
translate french c25s002_IronFist_37d8c613:

    # jef "¿Pueden acompañarme? El Sr. Ichigo querría reunirse con ustedes en el jacuzzi."
    jef "Pouvez-vous me rejoindre ? Monsieur Ichigo aimerait vous rencontrer dans le jacuzzi."

# game/scripts/c25/c25.rpy:994
translate french c25s002_IronFist_5bb55b13:

    # mc "Creo que no vengo con el atuendo adecuado para una visita al jacuzzi, Sr. Sound."
    mc "Je ne pense pas être habillée de façon appropriée pour une visite au jacuzzi, Monsieur Sound."

# game/scripts/c25/c25.rpy:996
translate french c25s002_IronFist_70526c4f:

    # jef "No se preocupe, la reunión tendrá lugar en los sofás que hay al lado del jacuzzi, no dentro."
    jef "Ne vous inquiétez pas, la réunion aura lieu sur les canapés à côté du jacuzzi, et non à l'intérieur."

# game/scripts/c25/c25.rpy:997
translate french c25s002_IronFist_2d89d0ee:

    # mc "Perdón por el malentendido. Le seguimos."
    mc "Toutes nos excuses pour ce malentendu. Nous vous suivrons."

# game/scripts/c25/c25.rpy:999
translate french c25s002_IronFist_8ac84c95:

    # "Sound os deja en el jacuzzi, donde Ichigo ya está sentado en un sofá y hay una chica en topless dentro del agua."
    "Le son vous quitte dans le jacuzzi, où Ichigo est déjà assis sur un canapé et où une fille seins nus se trouve dans l'eau."

# game/scripts/c25/c25.rpy:1000
translate french c25s002_IronFist_fe993fb1:

    # "Inteligentemente, el sofá donde se ha sentado solo tiene dos plazas, lo que va a obligar a [ama] a sentarse al lado del jacuzzi o a quedarse de pie."
    "Astucieusement, le canapé sur lequel il s'est assis ne comporte que deux places, ce qui obligera [ama] soit à s'asseoir à côté du jacuzzi, soit à se lever."

# game/scripts/c25/c25.rpy:1001
translate french c25s002_IronFist_deb5067a:

    # "Supones que la chica medio desnuda está para intentar despistaros tanto a [ama] como a ti, tras haber interpretado que [ama] era lesbiana."
    "Vous supposez que la fille à moitié nue est là pour essayer d'induire en erreur à la fois [ama] et vous, après avoir interprété [ama] comme étant lesbienne."

# game/scripts/c25/c25.rpy:1002
translate french c25s002_IronFist_a4b18349:

    # "Todo está perfectamente estudiado. Cada detalle cuenta."
    "Tout est parfaitement planifié. Chaque détail compte."

# game/scripts/c25/c25.rpy:1003
translate french c25s002_IronFist_f0f5052b:

    # ich "Siéntate, muchacho."
    ich "Assieds-toi, garçon."

# game/scripts/c25/c25.rpy:1004
translate french c25s002_IronFist_fab0c3d6:

    # "Cada vez que te llama 'muchacho' tienes ganas de estrangularlo. Seguramente también está estudiado para sacarte de tus casillas."
    "Chaque fois qu'il t'appelle « garçon », tu as envie de l'étrangler. C'est sans doute une manœuvre calculée pour te faire sortir de tes gonds."

# game/scripts/c25/c25.rpy:1006
translate french c25s002_IronFist_be105551:

    # "Te sientas al lado de Ichigo. [ama] se sienta al lado del jacuzzi, ignorando a la mujer que hay dentro."
    "Tu t'assieds à côté d'Ichigo. [ama] Il s'assoit près du jacuzzi, ignorant la femme qui s'y trouve."

# game/scripts/c25/c25.rpy:1007
translate french c25s002_IronFist_38b3bf7a:

    # mc "Aquí estamos. Las vibraciones se parecen poco a la reunión informal de la que habló Sound."
    mc "Nous y voilà. L'ambiance est complètement différente de la réunion informelle dont parlait Sound."

# game/scripts/c25/c25.rpy:1009
translate french c25s002_IronFist_13ca937b:

    # ich "*Risa* ¿En cuantas reuniones formales has estado, muchacho? ¿Cuántas tenían putas?"
    ich "*Rires* T'as assisté à combien de réunions officielles, gamin ? Et combien d'entre elles avaient des prostituées ?"

# game/scripts/c25/c25.rpy:1010
translate french c25s002_IronFist_7d198584:

    # mc "He estado en unas cuantas reuniones formales, aunque no había prostitutas en ninguna, en eso tiene razón."
    mc "J'ai assisté à quelques réunions officielles, mais vous avez raison sur ce point : il n'y avait aucune prostituée à aucune d'entre elles."

# game/scripts/c25/c25.rpy:1011
translate french c25s002_IronFist_903246ca:

    # mcp "(¿Las reuniones con los profesores de la universidad se pueden considerar formales? Voy a tener que empezar a mentir si tengo que tratar con tipos como este.)"
    mcp "(Peut-on considérer les rencontres avec des professeurs d'université comme formelles ? Je vais devoir commencer à mentir si je dois avoir affaire à des types comme ça.)"

# game/scripts/c25/c25.rpy:1013
translate french c25s002_IronFist_61debedd:

    # ich "Relájate, muchacho. Realmente es una reunión informal para tener un primer contacto. No pienses que esto te viene grande."
    ich "Détends-toi, gamin. C'est juste une rencontre informelle pour faire connaissance. Ne t'inquiète pas trop."

# game/scripts/c25/c25.rpy:1014
translate french c25s002_IronFist_404bcb13:

    # "Deja caer la última frase precisamente para que pienses que no das la talla. Aparte de [ama] y [kim], es posible que seas la persona más joven en el barco."
    "Cette dernière phrase est là précisément pour vous faire croire que vous n'êtes pas à la hauteur. Hormis [ama] et [kim], vous êtes probablement la personne la plus jeune à bord."

# game/scripts/c25/c25.rpy:1015
translate french c25s002_IronFist_3d3dd610:

    # ich "Y para ver qué opinan vuestros accionistas sobre una absorción o una fusión."
    ich "Et pour connaître l'avis de vos actionnaires sur une prise de contrôle ou une fusion."

# game/scripts/c25/c25.rpy:1016
translate french c25s002_IronFist_5551abd5:

    # mc "No están interesados en vender."
    mc "Ils ne sont pas intéressés par la vente."

# game/scripts/c25/c25.rpy:1018
translate french c25s002_IronFist_23f3d422:

    # ich "Aún no sabes el precio que estamos dispuestos a pagar, muchacho."
    ich "Tu ne connais toujours pas le prix que nous sommes prêts à payer, gamin."

# game/scripts/c25/c25.rpy:1019
translate french c25s002_IronFist_e475b953:

    # mc "No, pero sabemos lo que podéis pagar, y no es suficiente."
    mc "Non, mais nous savons ce que vous pouvez vous permettre, et ce n'est pas suffisant."

# game/scripts/c25/c25.rpy:1021
translate french c25s002_IronFist_d8c0a0eb:

    # mc "¿Se lo explicas, [ama]?"
    mc "Peux-tu lui expliquer, [ama] ?"

# game/scripts/c25/c25.rpy:1022
translate french c25s002_IronFist_5f1e10ad:

    # ama "Sabemos que vuestra facturación es algo más de la mitad de la nuestra. Un tercio del valor de NTR aproximadamente."
    ama "Nous savons que votre chiffre d'affaires représente un peu plus de la moitié du nôtre, soit environ un tiers de la valeur de NTR."

# game/scripts/c25/c25.rpy:1024
translate french c25s002_IronFist_658ed36d:

    # "Consulta el móvil un momento para comprobar la información que encontró Jamaal."
    "Vérifiez un instant votre téléphone pour vérifier les informations trouvées par Jamaal."

# game/scripts/c25/c25.rpy:1026
translate french c25s002_IronFist_44467747:

    # ama "Conociendo vuestro flujo de caja y vuestro presupuesto, creemos que podríais pagar, incluso con financiación externa, un máximo de 600 millones. Más cerca de 500."
    ama "Compte tenu de votre trésorerie et de votre budget, nous estimons que vous pourriez payer, même avec un financement externe, un maximum de 600 millions. Plus près de 500."

# game/scripts/c25/c25.rpy:1027
translate french c25s002_IronFist_68b89a04:

    # ama "Menos de dos tercios del valor de mercado de NTR, en el mejor de los casos. ¿Me equivoco?"
    ama "Moins des deux tiers de la valeur marchande de NTR, au mieux. Ai-je tort ?"

# game/scripts/c25/c25.rpy:1028
translate french c25s002_IronFist_61f5aecb:

    # "Tras ver que la prostituta no ejerce ningún efecto en [ama], Ichigo le hace una señal para que se vaya."
    "Après avoir constaté que la prostituée n'a aucun effet sur [ama], Ichigo lui fait signe de partir."

# game/scripts/c25/c25.rpy:1030
translate french c25s002_IronFist_004bab3e:

    # ich "Las cifras estarían en esos valores, sí."
    ich "Les chiffres seraient dans ces valeurs, oui."

# game/scripts/c25/c25.rpy:1031
translate french c25s002_IronFist_a36e819e:

    # "Se dirige a ti, como si [ama] no existiera. Si no existe, no hay que hacer caso de las cifras que ha puesto sobre la mesa. No le ha gustado que tuvierais esa información."
    "Il s'adresse à vous comme si [ama] n'existait pas. Si [ama] n'existe pas, alors les chiffres qu'il a présentés ne sont pas crédibles. Il n'a pas apprécié que vous possédiez cette information."

# game/scripts/c25/c25.rpy:1032
translate french c25s002_IronFist_00575222:

    # ich "Por eso estaba proponiendo también una fusión, muchacho. Si unimos fuerzas..."
    ich "C'est pour ça que je proposais aussi une fusion, gamin. Si on unissait nos forces..."

# game/scripts/c25/c25.rpy:1033
translate french c25s002_IronFist_24e7660c:

    # mc "[ama], ¿puedes darnos números?"
    mc "[ama], pouvez-vous nous donner des chiffres ?"

# game/scripts/c25/c25.rpy:1035
translate french c25s002_IronFist_0bbe686b:

    # "Su falsa sonrisa se crispa por un momento al volver a dirigir la atención de la conversación sobre [ama]."
    "Son faux sourire se fige un instant alors qu'elle recentre la conversation sur [ama]."

# game/scripts/c25/c25.rpy:1037
translate french c25s002_IronFist_16272952:

    # ama "El valor de mercado de Iron Fist, según nuestros cálculos, ronda los 650 millones. 700 como mucho."
    ama "D'après nos calculs, la valeur marchande d'Iron Fist avoisine les 650 millions, 700 au maximum."

# game/scripts/c25/c25.rpy:1038
translate french c25s002_IronFist_aa5b00ff:

    # ama "El valor de NTR supera los 1,000 millones. Si hay una fusión, NTR será la entidad dominante."
    ama "La valeur de NTR dépasse le milliard de dollars. En cas de fusion, NTR deviendra l'entité dominante."

# game/scripts/c25/c25.rpy:1040
translate french c25s002_IronFist_f11118fa:

    # mc "Y eso no es lo que quieres, ¿verdad?"
    mc "Et ce n'est pas ce que vous voulez, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1041
translate french c25s002_IronFist_438be0ef:

    # ich "Bueno, creo que esas cifras están un poco sesgadas."
    ich "Eh bien, je pense que ces chiffres sont un peu faussés."

# game/scripts/c25/c25.rpy:1042
translate french c25s002_IronFist_d52f5999:

    # ich "Ahora mismo, NTR carece de liderazgo y dirección, lo cual rebaja el valor considerablemente. Nosotros podríamos darle el empuje que necesita."
    ich "Actuellement, NTR manque de leadership et de direction, ce qui diminue considérablement sa valeur. Nous pourrions lui donner l'impulsion nécessaire."

# game/scripts/c25/c25.rpy:1043
translate french c25s002_IronFist_04947582:

    # mc "¿Te parezco una persona que no proporciona liderazgo a la empresa?"
    mc "Pensez-vous que je suis quelqu'un qui ne fait pas preuve de leadership dans l'entreprise ?"

# game/scripts/c25/c25.rpy:1045
translate french c25s002_IronFist_580710fb:

    # ich "Sin querer insultarte, muchacho, no tienes experiencia en este negocio. Cero. O en ningún otro, excepto un dormitorio universitario."
    ich "Sans vouloir t'offenser, gamin, tu n'as aucune expérience dans ce domaine. Zéro. Ni dans aucun autre, à part peut-être dans une résidence universitaire."

# game/scripts/c25/c25.rpy:1046
translate french c25s002_IronFist_d26ca4a4:

    # "Tu cara, que intentas mantener impasible, tiene que reflejar más de lo que esperabas."
    "Votre visage, que vous vous efforcez de garder impassible, doit refléter bien plus que vous ne l'imaginiez."

# game/scripts/c25/c25.rpy:1048
translate french c25s002_IronFist_bb404a98:

    # "La sonrisa de Ichigo se ensancha."
    "Le sourire d'Ichigo s'élargit."

# game/scripts/c25/c25.rpy:1049
translate french c25s002_IronFist_09b4f67c:

    # ich "¿Creías que erais los únicos que sabían buscar información, muchacho?"
    ich "Tu croyais être les seuls à savoir comment trouver des informations, gamin ?"

# game/scripts/c25/c25.rpy:1050
translate french c25s002_IronFist_59c7cff2:

    # "Mantienes el tono de voz lo más neutral posible."
    "Gardez un ton de voix aussi neutre que possible."

# game/scripts/c25/c25.rpy:1051
translate french c25s002_IronFist_4e7f098e:

    # mc "Si creyéramos que no sabéis ni siquiera buscar en Foogle, no estaríamos perdiendo el tiempo reuniéndonos con vosotros."
    mc "Si nous pensions que vous ne saviez même pas comment faire une recherche sur Google, nous ne perdrions pas notre temps à vous rencontrer."

# game/scripts/c25/c25.rpy:1052
translate french c25s002_IronFist_eb47144c:

    # mc "Es cierto que no tengo experiencia en este negocio, pero tengo un equipo que sí que la tiene."
    mc "Il est vrai que je n'ai pas d'expérience dans ce secteur, mais j'ai une équipe qui en a."

# game/scripts/c25/c25.rpy:1053
translate french c25s002_IronFist_780daced:

    # mc "No es necesario saber pilotar una nave espacial para construirla. No es necesario ser un operativo de campo para dirigir NTR."
    mc "Il n'est pas nécessaire de savoir piloter un vaisseau spatial pour en construire un. Il n'est pas nécessaire d'être un opérateur de terrain pour gérer NTR."

# game/scripts/c25/c25.rpy:1055
translate french c25s002_IronFist_2d1bda87:

    # ich "Bueno, muchacho, no hace falta que te pongas a la defensiva. Ya te he dicho que esto era una reunión informal."
    ich "Écoute, mon petit, pas besoin de te mettre sur la défensive. Je t'ai déjà dit que c'était une réunion informelle."

# game/scripts/c25/c25.rpy:1056
translate french c25s002_IronFist_d1ca8f6e:

    # ich "Pero creo que sería bueno que le comunicaras a tu familia nuestra oferta. Te la enviaré la semana que viene."
    ich "Mais je pense qu'il serait judicieux d'informer votre famille de notre offre. Je vous l'enverrai la semaine prochaine."

# game/scripts/c25/c25.rpy:1058
translate french c25s002_IronFist_6d645498:

    # ich "¿Quieres que te la mande por correo electrónico o mando un mensajero a tu casa?"
    ich "Préférez-vous que je vous l'envoie par courriel ou dois-je envoyer un coursier à votre domicile ?"

# game/scripts/c25/c25.rpy:1059
translate french c25s002_IronFist_1839f8fe:

    # ich "Y no me refiero al campo de baseball en San Luis Obispo."
    ich "Et je ne parle pas du terrain de baseball de San Luis Obispo."

# game/scripts/c25/c25.rpy:1060
translate french c25s002_IronFist_e79bd92e:

    # mc "La puedes mandar por correo electrónico. Una vez la reciba, lo consultaré con el resto de los accionistas."
    mc "Vous pouvez me l'envoyer par courriel. Dès réception, j'en discuterai avec les autres actionnaires."

# game/scripts/c25/c25.rpy:1062
translate french c25s002_IronFist_8085e2c0:

    # "Miras a [ama], que asiente con la cabeza, felicitándote por no haberte comprometido a nada."
    "Vous regardez [ama], qui hoche la tête, vous félicitant de ne vous être engagé à rien."

# game/scripts/c25/c25.rpy:1064
translate french c25s002_IronFist_da0b8aed:

    # ich "Entonces, muchacho..."
    ich "Alors, mon garçon..."

# game/scripts/c25/c25.rpy:1065
translate french c25s002_IronFist_cf39b048:

    # "Tienes que mantener las manos quietas para no estrangularlo."
    "Vous devez garder les mains immobiles pour ne pas l'étrangler."

# game/scripts/c25/c25.rpy:1066
translate french c25s002_IronFist_390ac85f:

    # ich "...vamos a la cubierta principal. Tienen que estar a punto de servir la cena."
    ich "Allons sur le pont principal. Le dîner devrait être servi prochainement."

# game/scripts/c25/c25.rpy:1067
translate french c25s002_IronFist_6bd70785:

    # ich "Y esto es una reunión informal. No deberíamos hablar de negocios toda la noche."
    ich "Et c'est une réunion informelle. Nous ne devrions pas parler affaires toute la soirée."

# game/scripts/c25/c25.rpy:1069
translate french c25s002_IronFist_602d43e2:

    # "Al llegar a la cubierta principal, ves que han retirado las tumbonas y han puesto algunas mesas altas."
    "En arrivant sur le pont principal, vous constatez qu'ils ont enlevé les transats et installé des tables hautes."

# game/scripts/c25/c25.rpy:1070
translate french c25s002_IronFist_3806b875:

    # "No ves al General por ningún lado, pero el resto de los invitados que has visto están aquí, incluso uno que no habías visto hasta ahora. Alguien de Italia."
    "Vous ne voyez le Général nulle part, mais tous les autres invités que vous avez vus sont là, y compris un que vous n'aviez pas remarqué auparavant. Un Italien."

# game/scripts/c25/c25.rpy:1071
translate french c25s002_IronFist_9a6634c2:

    # ich "Bueno, creo que ha llegado el momento que todos estabais esperando. Veo que nuestro amigo [dav] ya tiene cara de tener hambre."
    ich "Eh bien, je crois que le moment que vous attendiez tous est arrivé. Je vois que notre ami [dav] a déjà l'air affamé."

# game/scripts/c25/c25.rpy:1072
translate french c25s002_IronFist_63a8f934:

    # dav "*Acento de Europa del Este* *Risa* Ya me conoces. Siempre dispuesto a comer."
    dav "*Accent d'Europe de l'Est* *Rires* Vous me connaissez. Toujours prêt à grignoter."

# game/scripts/c25/c25.rpy:1073
translate french c25s002_IronFist_f9954ab4:

    # ich "Señoritas, pueden traer la comida."
    ich "Mesdames, vous pouvez apporter la nourriture."

# game/scripts/c25/c25.rpy:1075
translate french c25s002_IronFist_1fc7d1fb:

    # "Aparecen tres camareras con platos de comida que depositan en las mesas."
    "Trois serveuses apparaissent avec des assiettes de nourriture qu'elles déposent sur les tables."

# game/scripts/c25/c25.rpy:1076
translate french c25s002_IronFist_673828b6:

    # dav "¿Sólo hay esto? *Risa* ¿No vas a dar de comer al resto de tus invitados, puto Japo? Esto se lo come [dav] él solo."
    dav "C'est tout ? *Rires* Tu ne vas pas nourrir le reste de tes invités, espèce de Japonais ? [dav] mange tout ça tout seul."

# game/scripts/c25/c25.rpy:1078
translate french c25s002_IronFist_7677d865:

    # "A Ichigo se le crispan las facciones por un momento pero disimula rápidamente. No sabes si por lo de 'Japo' o por lo desagradable que es el serbio."
    "Les traits d'Ichigo se crispent un instant, mais il le dissimule aussitôt. Impossible de dire si c'est à cause de la remarque sur le terme « Japo » ou à cause de l'attitude désagréable du Serbe."

# game/scripts/c25/c25.rpy:1079
translate french c25s002_IronFist_3fae0390:

    # ich "Tranquilo, Dave, tenéis más comida dentro si queréis. Y bebida. Toda la que queráis."
    ich "Ne t'inquiète pas, Dave, il y a encore à manger à l'intérieur si tu veux. Et des boissons. À volonté."

# game/scripts/c25/c25.rpy:1080
translate french c25s002_IronFist_00439364:

    # ich "Además, ahora llega el plato principal. No te va a decepcionar."
    ich "Et maintenant, le plat principal. Vous ne serez pas déçu."

# game/scripts/c25/c25.rpy:1083
translate french c25s002_IronFist_0179df6f:

    # ich "Podéis traer las bandejas."
    ich "Vous pouvez apporter les plateaux."

# game/scripts/c25/c25.rpy:1086
translate french c25s002_IronFist_198b54a5:

    # "Dos de los guardaespaldas traen las tumbonas con chicas sirviendo como bandejas de sushi. Siempre habías pensado que tenían que estar desnudas."
    "Deux des gardes du corps apportent les transats, servis par des jeunes femmes qui les présentent comme des plateaux de sushis. On aurait cru qu'elles devaient être nues."

# game/scripts/c25/c25.rpy:1087
translate french c25s002_IronFist_f70e458b:

    # "Estas conservan los ligueros y las medias, para dar más impresión de algo fetichista."
    "Ces modèles conservent les porte-jarretelles et les bas, pour donner une impression plus fétichiste."

# game/scripts/c25/c25.rpy:1088
translate french c25s002_IronFist_740b394d:

    # "El espectáculo y la compañía te han quitado el poco hambre que pudieras haber tenido."
    "Le spectacle et la compagnie ont fait disparaître le peu d'appétit qu'il vous restait."

# game/scripts/c25/c25.rpy:1089
translate french c25s002_IronFist_11caea9a:

    # dav "¡Eso le gusta más a [dav]!"
    dav "[dav] préfère ça !"

# game/scripts/c25/c25.rpy:1091
translate french c25s002_IronFist_46655a7a:

    # "Nada más llegar las bandejas humanas, el serbio se lanza como una bestia sobre una de las chicas. El tipo de las tríadas hace lo mismo, más delicadamente."
    "Dès l'arrivée des plateaux humains, le Serbe se jette sur l'une des filles comme une bête. Le membre de la triade fait de même, avec plus de délicatesse."

# game/scripts/c25/c25.rpy:1093
translate french c25s002_IronFist_0e96ca42:

    # "El invitado que no reconoces, el italiano, y la política mejicana están asqueados con la actuación del serbio."
    "L'invité que vous ne reconnaissez pas, l'Italien et les politiciens mexicains sont dégoûtés par la prestation du Serbe."

# game/scripts/c25/c25.rpy:1095
translate french c25s002_IronFist_ff81b68e:

    # "Te apartas del grotesco espectáculo y te apoyas en la borda, cerca de una de las estaciones de armas."
    "Vous vous éloignez de ce spectacle grotesque et vous vous appuyez contre la rambarde, près d'un des postes de tir."

# game/scripts/c25/c25.rpy:1096
translate french c25s002_IronFist_d2ef441b:

    # "Se te pasa por la mente girar la ametralladora y barrer la cubierta del barco. Si no fuera por las chicas y porque no sabes disparar ametralladoras..."
    "L'idée vous traverse l'esprit de retourner la mitrailleuse et de balayer le pont du navire. Si ce n'était les filles et le fait que vous ne sachiez pas vous servir d'une mitrailleuse…"

# game/scripts/c25/c25.rpy:1098
translate french c25s002_IronFist_de7653ca:

    # ama "¿Estás muy asqueado?"
    ama "Êtes-vous très dégoûté ?"

# game/scripts/c25/c25.rpy:1099
translate french c25s002_IronFist_d6f3faed:

    # mc "No te lo puedes llegar a imaginar. ¿Siempre son así estas 'fiestas'?"
    mc "Vous n'imaginez même pas. Ces « vacances » sont-elles toujours comme ça ?"

# game/scripts/c25/c25.rpy:1101
translate french c25s002_IronFist_5876cddb:

    # ama "Es la primera en la que estoy. Me dan ganas de sacar el arma y hacer una barbaridad."
    ama "C'est la première fois que je me retrouve dans une telle situation. J'ai envie de sortir mon arme et de faire quelque chose d'horrible."

# game/scripts/c25/c25.rpy:1102
translate french c25s002_IronFist_ab4456b0:

    # mc "*Risa triste* Yo estaba pensando en las estaciones de armas hace un segundo."
    mc "*Rire triste* Je pensais justement aux stations d'armement il y a une seconde."

# game/scripts/c25/c25.rpy:1104
translate french c25s002_IronFist_b274b6f4:

    # ama "No sabía que iba a ser así. Ni que sabían lo de la familia y el dormitorio."
    ama "Je ne savais pas que ça se passerait comme ça. Ni qu'ils étaient au courant pour la famille et la chambre."

# game/scripts/c25/c25.rpy:1105
translate french c25s002_IronFist_c26beed8:

    # ama "Si lo hubiera sabido, hubiéramos rechazado la invitación. Ha sido una muestra de que te han investigado."
    ama "Si nous avions su, nous aurions décliné l'invitation. Il est clair qu'ils enquêtaient sur vous."

# game/scripts/c25/c25.rpy:1106
translate french c25s002_IronFist_a7dd2707:

    # mc "Bueno, ahora lo sabemos. También sabremos cuánto ofrecen, aunque no vayamos a vender."
    mc "Eh bien, maintenant nous le savons. Nous saurons aussi combien ils proposent, même si nous ne vendons pas."

# game/scripts/c25/c25.rpy:1108
translate french c25s002_IronFist_27752367:

    # ama "¿De qué nos va a servir eso?"
    ama "À quoi cela nous servira-t-il ?"

# game/scripts/c25/c25.rpy:1109
translate french c25s002_IronFist_752f4ab9:

    # mc "Sabiendo cuanto ofrecen podemos saber cuánto tienen y, a través de eso, cuánto valen. Ya no será 500 o 600 millones. Será una cifra más concreta."
    mc "Connaître leur offre nous permet de connaître leurs ressources et, par conséquent, leur valeur. Il ne s'agira plus de 500 ou 600 millions, mais d'un chiffre plus précis."

# game/scripts/c25/c25.rpy:1111
translate french c25s002_IronFist_c2795dab:

    # ama "Repito. ¿De qué nos va a servir eso? No estás pensando en comprar Iron Fist, ¿verdad? No podríamos hacerlo y..."
    ama "Je le répète. À quoi cela nous servirait-il ? Vous n'envisagez pas d'acheter Iron Fist, n'est-ce pas ? Nous ne pourrions pas faire cela et…"

# game/scripts/c25/c25.rpy:1112
translate french c25s002_IronFist_a1400b69:

    # mc "No sé de qué nos va a servir, [ama]. Pero parece que la información es poder en este juego. Y no, no quiero comprar... esto."
    mc "Je ne sais pas à quoi ça nous servira, [ama]. Mais il semblerait que l'information soit un pouvoir dans ce jeu. Et non, je ne veux pas acheter… ça."

# game/scripts/c25/c25.rpy:1113
translate french c25s002_IronFist_0b02b795:

    # mc "Si vamos a cerrar la parte de NTR dedicada a las operaciones encubiertas, no nos aportaría nada..."
    mc "Si nous fermons la section NTR dédiée aux opérations clandestines, cela ne nous apportera absolument aucun bénéfice..."

# game/scripts/c25/c25.rpy:1114
translate french c25s002_IronFist_69193b37:

    # mc "Aparte de la satisfacción por eliminar Iron Fist, a Ichigo, y este puto barco."
    mc "Outre la satisfaction d'avoir éliminé Iron Fist, Ichigo et ce satané navire."

# game/scripts/c25/c25.rpy:1116
translate french c25s002_IronFist_31bcc5d7:

    # dav "¡Japo! Antes había tres tumbonas. ¿No hay tres chicas?"
    dav "Japonais ! Il y avait trois transats. Il y a trois filles, non ?"

# game/scripts/c25/c25.rpy:1118
translate french c25s002_IronFist_ed7b97bb:

    # "Ichigo te mira antes de hacer una seña a uno de los guardaespaldas, que trae la tercera tumbona. Vacía."
    "Ichigo vous regarde avant de faire signe à l'un des gardes du corps, qui apporte le troisième transat. Vide."

# game/scripts/c25/c25.rpy:1119
translate french c25s002_IronFist_2138737c:

    # dav "¿Una tumbona sin chica? ¿Nos estás timando?"
    dav "Un transat sans fille ? Vous essayez de nous arnaquer ?"

# game/scripts/c25/c25.rpy:1121
translate french c25s002_IronFist_85190d89:

    # ich "Trae a la chica."
    ich "Amène la fille."

# game/scripts/c25/c25.rpy:1122
translate french c25s002_IronFist_81d55cb3:

    # "La mirada de Ichigo antes de pedir la tumbona te ha dado escalofríos."
    "Le regard d'Ichigo avant de demander le transat vous a donné des frissons."

# game/scripts/c25/c25.rpy:1124
translate french c25s002_IronFist_a9fad70a:

    # mc "¿Qué está pasando, [ama]? ¿A qué ha venido esa mirada?"
    mc "Que se passe-t-il, [ama] ? Qu'est-ce que c'est que ce regard ?"

# game/scripts/c25/c25.rpy:1125
translate french c25s002_IronFist_04e83625:

    # ama "No tengo ni idea. Debes estar preparado para cualquier cosa."
    ama "Je n'en ai aucune idée. Il faut être prêt à tout."

# game/scripts/c25/c25.rpy:1127
translate french c25s002_IronFist_1c379060:

    # "El guardaespaldas vuelve un par de minutos después, acompañando a [kim]. Hace bien no mirándote, con su mirada fija en Ichigo."
    "Le garde du corps revient quelques minutes plus tard, accompagnant [kim]. Il a raison de ne pas vous regarder, son regard étant fixé sur Ichigo."

# game/scripts/c25/c25.rpy:1128
translate french c25s002_IronFist_1beaa9a4:

    # "Cada vez estás más convencido de que vas a tener que usar la estación de armas."
    "Vous êtes de plus en plus convaincu que vous allez devoir utiliser le poste d'armement."

# game/scripts/c25/c25.rpy:1130
translate french c25s002_IronFist_15eb703c:

    # dav "¡Oh, sí! ¡La vaca suiza! A [dav] le gusta la idea."
    dav "Ah oui ! La vache suisse ! [dav] aime l'idée."

# game/scripts/c25/c25.rpy:1131
translate french c25s002_IronFist_5fe1e341:

    # "O coger el arma de [ama] y pegarle un tiro al serbio."
    "Ou prenez l'arme [ama] et tirez sur le Serbe."

# game/scripts/c25/c25.rpy:1133
translate french c25s002_IronFist_f4d73818:

    # ich "Chica, quítate el uniforme y estírate en la tumbona. Déjate solo la ropa que llevan las otras chicas."
    ich "Fille, enlève ton uniforme et allonge-toi sur le transat. Garde juste les vêtements que portent les autres filles."

# game/scripts/c25/c25.rpy:1134
translate french c25s002_IronFist_5ea9857f:

    # kim "¿Qué?"
    kim "Que?"

# game/scripts/c25/c25.rpy:1136
translate french c25s002_IronFist_c5cca174:

    # "[kim] os mira incrédula y desamparada, alternando la mirada entre Ichigo y tú."
    "[kim] Elle vous regarde avec incrédulité et impuissance, alternant son regard entre Ichigo et vous."

# game/scripts/c25/c25.rpy:1137
translate french c25s002_IronFist_77d9d38e:

    # "Ichigo te mira con aires de superioridad. Te ha demostrado que puede hacer daño a personas cercanas a ti."
    "Ichigo vous regarde avec un air de supériorité. Il vous a prouvé qu'il pouvait blesser vos proches."

# game/scripts/c25/c25.rpy:1161
translate french c25s002_SaveKim_11ae0633:

    # mc "Espera... Japo Cara Quemada."
    mc "Attendez... Japonais au visage brûlé."

# game/scripts/c25/c25.rpy:1162
translate french c25s002_SaveKim_e48b9522:

    # "Tú también quieres jugar al juego de sacar a la gente de sus casillas y vas con toda la artillería."
    "Vous aussi, vous voulez jouer au jeu de l'agacement, et vous y mettez tout votre cœur."

# game/scripts/c25/c25.rpy:1164
translate french c25s002_SaveKim_b9326388:

    # "Ichigo se crispa. No era disgusto por el serbio."
    "Ichigo se raidit. Ce n'était pas de l'aversion pour le Serbe."

# game/scripts/c25/c25.rpy:1165
translate french c25s002_SaveKim_d4124b03:

    # ich "¿Qué quieres, muchacho? Nuestro amigo serbio tiene hambre."
    ich "Que veux-tu, mon garçon ? Notre ami serbe a faim."

# game/scripts/c25/c25.rpy:1166
translate french c25s002_SaveKim_c524af29:

    # mc "Me has dicho antes que me podía llevar a cualquier chica a un camarote privado. La elijo a ella."
    mc "Tu m'as dit tout à l'heure que je pouvais emmener n'importe quelle fille dans une cabine privée. Je la choisis."

# game/scripts/c25/c25.rpy:1167
translate french c25s002_SaveKim_c6ba82be:

    # mc "Me la voy a llevar a un camarote ahora mismo."
    mc "Je vais l'emmener dans un chalet tout de suite."

# game/scripts/c25/c25.rpy:1169
translate french c25s002_SaveKim_fc9800cd:

    # dav "¡Nos has dicho que cualquiera menos ella, Japo!"
    dav "Tu nous as dit n'importe qui sauf elle, Japo !"

# game/scripts/c25/c25.rpy:1171
translate french c25s002_SaveKim_48411ab6:

    # mc "A mí me ha dicho cualquier chica y quiero a esa. ¿O esa es la forma de hacer negocios de Iron Fist?"
    mc "Toutes les filles m'ont dit qu'elles me désiraient. Ou est-ce simplement la méthode d'Iron Fist pour faire des affaires ?"

# game/scripts/c25/c25.rpy:1172
translate french c25s002_SaveKim_b201a37b:

    # mc "¿Promete cosas que no puede cumplir?"
    mc "Promets-il des choses qu'il ne peut pas tenir ?"

# game/scripts/c25/c25.rpy:1174
translate french c25s002_SaveKim_9865ec09:

    # aga "El Sr. Marks tiene razón. Le ha dicho que podía escoger cualquier chica. Yo estaba ahí."
    aga "M. Marks a raison. Il lui a dit qu'il pouvait choisir n'importe quelle fille. J'étais là."

# game/scripts/c25/c25.rpy:1175
translate french c25s002_SaveKim_c7d7f6a5:

    # "Sabes que Alejandra está tan asqueada por el espectáculo como tú, y decide unirse a tu bando aunque no sabe lo que está en juego."
    "Vous savez qu'Alejandra est aussi dégoûtée par ce spectacle que vous, et elle décide de se joindre à vous même si elle ignore ce qui est en jeu."

# game/scripts/c25/c25.rpy:1177
translate french c25s002_SaveKim_61837a44:

    # ich "Todos tenéis razón. He dicho que estaba fuera de límites y he cometido un error al decirle al Sr. Marks que podía escoger cualquier chica."
    ich "Tout va bien. J'ai dit que c'était inacceptable, et j'ai commis une erreur en disant à M. Marks qu'il pouvait choisir n'importe quelle fille."

# game/scripts/c25/c25.rpy:1178
translate french c25s002_SaveKim_3b9f62b5:

    # ich "Puedes escoger cualquier chica menos esta, muchacho. Esta es para disfrute de todos."
    ich "Tu peux choisir n'importe quelle fille sauf celle-ci, garçon. Celle-ci est pour le plaisir de tous."

# game/scripts/c25/c25.rpy:1180
translate french c25s002_SaveKim_615d9bc1:

    # "[kim] os mira a [ama] y a ti desvalida y asustada a partes iguales."
    "[kim] te regarde [ama], à la fois impuissant et effrayé."

# game/scripts/c25/c25.rpy:1181
translate french c25s002_SaveKim_1c0ad054:

    # mc "¿Así es como Iron Fist hace negocios? ¿Ichigo comete un error, promete algo que no puede, o no quiere, cumplir, y ahora se retracta?"
    mc "Est-ce ainsi qu'Iron Fist fonctionne ? Ichigo fait une erreur, promet quelque chose qu'il ne peut ou ne veut pas tenir, et maintenant il recule ?"

# game/scripts/c25/c25.rpy:1182
translate french c25s002_SaveKim_eb2f3149:

    # mc "Espero que no os haga lo mismo cuando lo contratéis para una operación de la que dependan vuestras organizaciones."
    mc "J'espère qu'il ne vous fera pas la même chose lorsque vous l'embaucherez pour une opération dont vos organisations dépendent."

# game/scripts/c25/c25.rpy:1183
translate french c25s002_SaveKim_c18f2b3c:

    # "Notas la mano de [ama] en la espalda, diciéndote que lo estás haciendo bien."
    "Tu sens la main de [ama] sur ton dos, te disant que tu te débrouilles bien."

# game/scripts/c25/c25.rpy:1185
translate french c25s002_SaveKim_f926944d:

    # aga "Ahí te ha pillado, Ichigo. Creo que le deberías permitir irse con la chica."
    aga "Voilà, Ichigo. Je pense que tu devrais le laisser partir avec la fille."

# game/scripts/c25/c25.rpy:1186
translate french c25s002_SaveKim_050e8487:

    # aga "Estoy segura de que cualquiera de las chicas que se han estado paseando con las tetas al aire podrán sustituirla."
    aga "Je suis sûre que n'importe laquelle des filles qui se promènent les seins à l'air peut la remplacer."

# game/scripts/c25/c25.rpy:1187
translate french c25s002_SaveKim_79ee2016:

    # aga "Incluso puedes dejar que [dav] escoja la que quiera como compensación."
    aga "Vous pouvez même laisser [dav] choisir celui qu'il souhaite en guise de compensation."

# game/scripts/c25/c25.rpy:1189
translate french c25s002_SaveKim_5ed1ae75:

    # ich "Bueno, si lo he prometido, debo cumplir. Te puedes llevar a la chica y que [dav] elija su sustituta."
    ich "Bon, si j'ai promis, je dois tenir parole. Vous pouvez prendre la fille et laisser [dav] choisir sa remplaçante."

# game/scripts/c25/c25.rpy:1190
translate french c25s002_SaveKim_ffc907c0:

    # "Temes por las otras camareras por un momento. Pero ellas no son familia."
    "Vous vous inquiétez un instant pour les autres serveuses. Mais ce ne sont pas des membres de votre famille."

# game/scripts/c25/c25.rpy:1191
translate french c25s002_SaveKim_49801325:

    # dav "A [dav] le parece una buena idea. Elijo a la puta de las tetas grandes. *Risa* ¡A ver cómo se aguanta el sushi en esas tetas!"
    dav "[dav] trouve que c'est une bonne idée. Je choisis la pute aux gros seins. *Rires* Voyons voir comment elle va tenir les sushis sur ces seins !"

# game/scripts/c25/c25.rpy:1193
translate french c25s002_SaveKim_4b4f0e3a:

    # "Coges a [kim] del brazo y te la llevas hacia el interior del barco antes de que alguien cambie de opinión."
    "Vous attrapez [kim] par le bras et vous l'emmenez à l'intérieur du vaisseau avant que quelqu'un ne change d'avis."

# game/scripts/c25/c25.rpy:1194
translate french c25s002_SaveKim_1d55b5a9:

    # kim "¿Qué está pasando, [mc]?"
    kim "Que se passe-t-il, [mc] ?"

# game/scripts/c25/c25.rpy:1195
translate french c25s002_SaveKim_0cdad13c:

    # mc "Luego, [kim]."
    mc "Ensuite, [kim]."

# game/scripts/c25/c25.rpy:1200
translate french c25s002_DontSaveKim_e07fbec1:

    # ama "Espera... Japo Cara Quemada."
    ama "Attendez... Japonais au visage brûlé."

# game/scripts/c25/c25.rpy:1201
translate french c25s002_DontSaveKim_1e433059:

    # "Ella también quiere jugar al juego de sacar a la gente de sus casillas y va con toda la artillería."
    "Elle veut aussi jouer au jeu de l'agacement et elle ne recule devant rien."

# game/scripts/c25/c25.rpy:1203
translate french c25s002_DontSaveKim_b9326388:

    # "Ichigo se crispa. No era disgusto por el serbio."
    "Ichigo se raidit. Ce n'était pas de l'aversion pour le Serbe."

# game/scripts/c25/c25.rpy:1204
translate french c25s002_DontSaveKim_539a1099:

    # ich "¿Qué quiere, Srta. Gilford? Nuestro amigo serbio tiene hambre."
    ich "Que désirez-vous, mademoiselle Gilford ? Notre ami serbe a faim."

# game/scripts/c25/c25.rpy:1206
translate french c25s002_DontSaveKim_6e0ce421:

    # ama "Me has dicho antes que me podía llevar a cualquier chica a un camarote privado. La elijo a ella."
    ama "Tu m'as dit tout à l'heure que je pouvais emmener n'importe quelle fille dans une cabine privée. Je la choisis."

# game/scripts/c25/c25.rpy:1207
translate french c25s002_DontSaveKim_990eba46:

    # ama "Me la voy a llevar a un camarote ahora mismo."
    ama "Je vais l'emmener dans un chalet tout de suite."

# game/scripts/c25/c25.rpy:1209
translate french c25s002_DontSaveKim_fc9800cd:

    # dav "¡Nos has dicho que cualquiera menos ella, Japo!"
    dav "Tu nous as dit n'importe qui sauf elle, Japo !"

# game/scripts/c25/c25.rpy:1211
translate french c25s002_DontSaveKim_7da79d62:

    # ama "A mí me ha dicho cualquier chica y quiero a esa. ¿O esa es la forma de hacer negocios de Iron Fist?"
    ama "Toutes les filles m'ont dit qu'elles me désiraient. Ou est-ce simplement la méthode d'Iron Fist pour faire des affaires ?"

# game/scripts/c25/c25.rpy:1212
translate french c25s002_DontSaveKim_153c273e:

    # ama "¿Promete cosas que no puede cumplir?"
    ama "Promets-il des choses qu'il ne peut pas tenir ?"

# game/scripts/c25/c25.rpy:1214
translate french c25s002_DontSaveKim_dc116445:

    # aga "La Srta. Gilford tiene razón. Le ha dicho que podía escoger cualquier chica. Yo estaba ahí."
    aga "Mlle Gilford a raison. Elle lui a dit qu'il pouvait choisir n'importe quelle fille. J'étais là."

# game/scripts/c25/c25.rpy:1215
translate french c25s002_DontSaveKim_4c89fd9e:

    # "Sabes que Alejandra está tan asqueada por el espectáculo como tú, y decide unirse al bando de [ama] aunque no sabe lo que está en juego."
    "Vous savez qu'Alejandra est aussi dégoûtée par ce spectacle que vous, et elle décide de rejoindre le camp [ama] même si elle ne sait pas ce qui est en jeu."

# game/scripts/c25/c25.rpy:1217
translate french c25s002_DontSaveKim_18f23169:

    # ich "Todos tenéis razón. He dicho que estaba fuera de límites y he cometido un error al decirle a la Srta. Gilford que podía escoger cualquier chica."
    ich "Vous avez raison. J'ai dit que c'était hors de question, et j'ai commis une erreur en disant à Mlle Gilford qu'elle pouvait choisir n'importe quelle fille."

# game/scripts/c25/c25.rpy:1218
translate french c25s002_DontSaveKim_0e37b919:

    # ich "Puede escoger cualquier chica menos esta, Srta. Gilford. Esta es para disfrute de todos."
    ich "Vous pouvez choisir n'importe quelle fille sauf celle-ci, Mlle Gilford. Celle-ci est pour le plaisir de tous."

# game/scripts/c25/c25.rpy:1220
translate french c25s002_DontSaveKim_0f46b098:

    # "[kim] os mira a [ama] y a ti desvalida y asustada a partes iguales. Decides intervenir."
    "[kim] regarde [ama] et vous, à la fois impuissant et effrayé. Vous décidez d'intervenir."

# game/scripts/c25/c25.rpy:1221
translate french c25s002_DontSaveKim_1c0ad054:

    # mc "¿Así es como Iron Fist hace negocios? ¿Ichigo comete un error, promete algo que no puede, o no quiere, cumplir, y ahora se retracta?"
    mc "Est-ce ainsi qu'Iron Fist fonctionne ? Ichigo fait une erreur, promet quelque chose qu'il ne peut ou ne veut pas tenir, et maintenant il recule ?"

# game/scripts/c25/c25.rpy:1222
translate french c25s002_DontSaveKim_eb2f3149:

    # mc "Espero que no os haga lo mismo cuando lo contratéis para una operación de la que dependan vuestras organizaciones."
    mc "J'espère qu'il ne vous fera pas la même chose lorsque vous l'embaucherez pour une opération dont vos organisations dépendent."

# game/scripts/c25/c25.rpy:1223
translate french c25s002_DontSaveKim_d154f028:

    # "Notas la mano de [ama] en tu brazo, diciéndote que lo estás haciendo bien."
    "Vous sentez la main de [ama] sur votre bras, vous disant que vous vous en sortez bien."

# game/scripts/c25/c25.rpy:1225
translate french c25s002_DontSaveKim_f926944d:

    # aga "Ahí te ha pillado, Ichigo. Creo que le deberías permitir irse con la chica."
    aga "Voilà, Ichigo. Je pense que tu devrais le laisser partir avec la fille."

# game/scripts/c25/c25.rpy:1226
translate french c25s002_DontSaveKim_050e8487:

    # aga "Estoy segura de que cualquiera de las chicas que se han estado paseando con las tetas al aire podrán sustituirla."
    aga "Je suis sûre que n'importe laquelle des filles qui se promènent les seins à l'air peut la remplacer."

# game/scripts/c25/c25.rpy:1227
translate french c25s002_DontSaveKim_79ee2016:

    # aga "Incluso puedes dejar que [dav] escoja la que quiera como compensación."
    aga "Vous pouvez même laisser [dav] choisir celui qu'il souhaite en guise de compensation."

# game/scripts/c25/c25.rpy:1229
translate french c25s002_DontSaveKim_5ed1ae75:

    # ich "Bueno, si lo he prometido, debo cumplir. Te puedes llevar a la chica y que [dav] elija su sustituta."
    ich "Bon, si j'ai promis, je dois tenir parole. Vous pouvez prendre la fille et laisser [dav] choisir sa remplaçante."

# game/scripts/c25/c25.rpy:1230
translate french c25s002_DontSaveKim_0b7fda0a:

    # "Temes por las otras camareras por un momento. Todas miran asustadas a [dav]."
    "Vous craignez un instant pour les autres serveuses. Elles regardent toutes [dav] avec crainte."

# game/scripts/c25/c25.rpy:1231
translate french c25s002_DontSaveKim_ab677966:

    # "Pero ellas no son familia. Estás complacido de que [ama] haya sabido reaccionar."
    "Mais ce ne sont pas des membres de la famille. Tu es content que [ama] ait su réagir."

# game/scripts/c25/c25.rpy:1232
translate french c25s002_DontSaveKim_02528ae8:

    # "Quizás puedas hacer lo mismo si elige a una camarera..."
    "Vous pourriez peut-être faire de même si vous choisissiez une serveuse..."

# game/scripts/c25/c25.rpy:1233
translate french c25s002_DontSaveKim_49801325:

    # dav "A [dav] le parece una buena idea. Elijo a la puta de las tetas grandes. *Risa* ¡A ver cómo se aguanta el sushi en esas tetas!"
    dav "[dav] trouve que c'est une bonne idée. Je choisis la pute aux gros seins. *Rires* Voyons voir comment elle va tenir les sushis sur ces seins !"

# game/scripts/c25/c25.rpy:1235
translate french c25s002_DontSaveKim_bedca6c7:

    # "Ves que [ama] coge a [kim] del brazo y se la lleva hacia el interior del barco antes de que alguien cambie de opinión."
    "Vous voyez [ama] saisir [kim] par le bras et l'emmener à l'intérieur du vaisseau avant que quiconque ne change d'avis."

# game/scripts/c25/c25.rpy:1236
translate french c25s002_DontSaveKim_5c26b5a5:

    # kim "¿Qué está pasando, [ama]?"
    kim "Que se passe-t-il, [ama] ?"

# game/scripts/c25/c25.rpy:1237
translate french c25s002_DontSaveKim_af750646:

    # ama "Luego, [kim]."
    ama "Ensuite, [kim]."

# game/scripts/c25/c25.rpy:1251
translate french c25s002_KimSaved_2259d25d:

    # "Mientras vas con [kim] hacia el camarote..."
    "En vous dirigeant vers la cabine avec [kim]..."

# game/scripts/c25/c25.rpy:1252
translate french c25s002_KimSaved_feb187f6:

    # ama "{i}(Joder, como se ha complicado todo.){/i}"
    ama "{i}(Mince, les choses sont devenues tellement compliquées.){/i}"

# game/scripts/c25/c25.rpy:1254
translate french c25s002_KimSaved_172f8095:

    # "Un par de minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c25/c25.rpy:1255
translate french c25s002_KimSaved_e62085b0:

    # aga "¿Qué tiene Ichigo contra vosotros? Lo de esa chica parecía algo personal."
    aga "Qu'est-ce qu'Ichigo a contre toi ? Ce que cette fille a fait semblait être une attaque personnelle."

# game/scripts/c25/c25.rpy:1257
translate french c25s002_KimSaved_e3b6fb65:

    # ama "No es un tema personal, sino de negocios. Estaba haciendo una competición a ver quién tenía la polla más grande."
    ama "Ce n'est rien de personnel, c'est du business. On organisait un concours pour voir qui avait la plus grosse bite."

# game/scripts/c25/c25.rpy:1258
translate french c25s002_KimSaved_23f566b0:

    # ama "La chica se aloja en el dormitorio universitario que es el negocio de la familia de [mc], e Ichigo quería demostrar que podía atacarnos por ahí."
    ama "La jeune fille séjourne dans le dortoir universitaire qui appartient à la famille de [mc], et Ichigo voulait prouver qu'il pouvait nous attaquer de là."

# game/scripts/c25/c25.rpy:1260
translate french c25s002_KimSaved_e9ff619d:

    # aga "Ichigo siempre me ha parecido un tipo muy zafio, pero usar a una chica así es demasiado incluso para él."
    aga "J'ai toujours pensé qu'Ichigo était un type vraiment grossier, mais utiliser une fille comme ça, c'est trop même pour lui."

# game/scripts/c25/c25.rpy:1261
translate french c25s002_KimSaved_b0480fff:

    # aga "Ha tenido que aceptar la derrota temporalmente pero, si puedes, indícale a [mc] que no salga del camarote hasta que no acabe la fiesta."
    aga "Il a dû accepter la défaite temporairement, mais si vous le pouvez, dites à [mc] de ne pas quitter la cabine jusqu'à ce que la fête soit terminée."

# game/scripts/c25/c25.rpy:1263
translate french c25s002_KimSaved_fb9e295d:

    # ama "Gracias, Alejandra. Lo haré."
    ama "Merci, Alejandra. Je le ferai."

# game/scripts/c25/c25.rpy:1264
translate french c25s002_KimSaved_19ede4b3:

    # ama "Y gracias también por apoyarnos antes."
    ama "Et merci également de nous avoir soutenus auparavant."

# game/scripts/c25/c25.rpy:1266
translate french c25s002_KimSaved_3f754ca1:

    # aga "Como te he dicho, Ichigo me parece zafio y despreciable. No me gusta cómo trata a las mujeres en estas fiestas."
    aga "Comme je l'ai dit, je trouve Ichigo grossier et méprisable. Je n'apprécie pas la façon dont il traite les femmes lors de ces soirées."

# game/scripts/c25/c25.rpy:1267
translate french c25s002_KimSaved_16cffa4d:

    # aga "No es que me haya puesto de vuestro lado, pero me ha gustado verle mordiendo el polvo por una vez."
    aga "Ce n'est pas que j'aie pris votre parti, mais j'ai aimé le voir mordre la poussière pour une fois."

# game/scripts/c25/c25.rpy:1269
translate french c25s002_KimSaved_06d54048:

    # ama "De todas formas, gracias."
    ama "En tout cas, merci."

# game/scripts/c25/c25.rpy:1271
translate french c25s002_KimSaved_ec881d9d:

    # aga "Ahora te tengo que dejar. Tengo que seguir la conversación con nuestro amigo italiano."
    aga "Je dois y aller. Je dois poursuivre ma conversation avec notre ami italien."

# game/scripts/c25/c25.rpy:1273
translate french c25s002_KimSaved_39bd0ac4:

    # ama "Me gustaría llamarte algún día. Estamos reorientando el negocio y quizás México sería un buen sitio por el que comenzar."
    ama "J'aimerais vous appeler prochainement. Nous réorientons nos activités, et le Mexique serait peut-être un bon point de départ."

# game/scripts/c25/c25.rpy:1275
translate french c25s002_KimSaved_91231aa9:

    # aga "Perfecto. Siempre es bueno tener otras opciones para según qué trabajos."
    aga "Parfait. C'est toujours bien d'avoir d'autres options pour certains emplois."

# game/scripts/c25/c25.rpy:1278
translate french c25s002_KimSaved_953f8ab3:

    # "Mientras tanto..."
    "Entre-temps..."

# game/scripts/c25/c25.rpy:1280
translate french c25s002_KimSaved_ce95e0af:

    # "Cuando estás llegando a los camarotes, te cruzas con el general, que sale de una habitación con una de las chicas que había en la piscina."
    "En approchant des cabanes, vous croisez le général, qui sort d'une chambre avec une des filles qui étaient dans la piscine."

# game/scripts/c25/c25.rpy:1281
translate french c25s002_KimSaved_42e729fb:

    # "Os ignoráis mutuamente más allá de una mirada. Tú sabes lo que él ha venido a hacer y el cree que tú vienes a lo mismo."
    "Vous vous ignorez, vous contentant d'un regard. Vous savez ce qu'il est venu faire, et il pense que vous êtes venu pour la même raison."

# game/scripts/c25/c25.rpy:1283
translate french c25s002_KimSaved_d9241808:

    # "Entras en un camarote vacío y cierras la puerta con pestillo."
    "Vous entrez dans une cabine vide et verrouillez la porte."

# game/scripts/c25/c25.rpy:1284
translate french c25s002_KimSaved_ac57285e:

    # "La cama está hecha, con lo que parece que nadie lo ha usado."
    "Le lit est fait, il semble donc que personne ne l'ait utilisé."

# game/scripts/c25/c25.rpy:1286
translate french c25s002_KimSaved_a0668ca1:

    # kim "¿Qué ha pasado ahí? ¿Por qué quería el Sr. Ichigo que me desnudara?"
    kim "Que s'est-il passé ? Pourquoi M. Ichigo voulait-il que je me déshabille ?"

# game/scripts/c25/c25.rpy:1287
translate french c25s002_KimSaved_6af850ee:

    # kim "¿Qué hacéis aquí [ama] y tú? ¿Iron Fist es la compañía rival de la que hablabais?"
    kim "Que fais-tu ici, [ama] ? Iron Fist est-elle la société rivale dont tu parlais ?"

# game/scripts/c25/c25.rpy:1288
translate french c25s002_KimSaved_edea03ab:

    # mc "Sí, [kim]. Iron Fist es la empresa que quería comprar NTR. Y cuando nos hemos negado, han intentado usarte para castigarnos."
    mc "Oui, [kim]. Iron Fist est la société qui voulait racheter NTR. Et quand nous avons refusé, ils ont essayé de se servir de toi pour nous punir."

# game/scripts/c25/c25.rpy:1289
translate french c25s002_KimSaved_b414de14:

    # mc "¿Es el mismo yate donde estuviste el miércoles?"
    mc "Est-ce le même yacht que celui où vous étiez mercredi ?"

# game/scripts/c25/c25.rpy:1291
translate french c25s002_KimSaved_37c6da68:

    # kim "Sí, pero entonces era diferente. Sólo había militares de uniforme, y no vi nada como lo de las chicas sirviendo como bandejas de sushi."
    kim "Oui, mais c'était différent à l'époque. Il n'y avait que des militaires en uniforme, et je n'ai rien vu de semblable à ces filles servant de plateaux de sushis."

# game/scripts/c25/c25.rpy:1292
translate french c25s002_KimSaved_c649fab0:

    # kim "Pero no me moví del helipuerto, con lo que tampoco puedo asegurar que no pasara."
    kim "Mais je n'ai pas bougé de l'héliport, donc je ne peux pas affirmer avec certitude que cela ne s'est pas produit."

# game/scripts/c25/c25.rpy:1293
translate french c25s002_KimSaved_5bee00e6:

    # mc "¿Y las ametralladoras en la cubierta no te hicieron pensar nada raro?"
    mc "Et les mitrailleuses sur le pont ne vous ont rien fait d'étrange ?"

# game/scripts/c25/c25.rpy:1295
translate french c25s002_KimSaved_528f1ee9:

    # kim "No soy estúpida, [mc]. Si hubiera visto las ametralladoras se lo hubiera comentado a [eva] y a [ama]. Me hubiera parecido sospechoso."
    kim "Je ne suis pas stupide, [mc]. Si j'avais vu les mitrailleuses, j'en aurais parlé à [eva] et [ama]. J'aurais trouvé ça suspect."

# game/scripts/c25/c25.rpy:1296
translate french c25s002_KimSaved_e911ec7b:

    # kim "Pero estaban tapadas con unas lonas grises. Hasta que no he llegado hoy no las he visto."
    kim "Mais elles étaient recouvertes de bâches grises. Je ne les ai vues qu'à mon arrivée aujourd'hui."

# game/scripts/c25/c25.rpy:1297
translate french c25s002_KimSaved_faff3186:

    # mc "Supongo que no había prostitutas tampoco, ¿no?"
    mc "J'imagine qu'il n'y avait pas de prostituées non plus, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1299
translate french c25s002_KimSaved_55b0a9b9:

    # kim "No, ni tampoco mafiosos serbios, italianos, o chinos. Adeline ha estado conmigo casi toda la tarde, y era ella la que acompañaba a los invitados."
    kim "Non, ni des mafieux serbes, italiens ou chinois. Adeline a été avec moi presque tout l'après-midi, et c'est elle qui accompagnait les invités."

# game/scripts/c25/c25.rpy:1300
translate french c25s002_KimSaved_3fb319c0:

    # kim "Lo mismo pasó el otro día, pero hacia el final del evento me hicieron ir a la cubierta de la piscina para ayudar a recoger."
    kim "La même chose s'est produite l'autre jour, mais vers la fin de l'événement, ils m'ont obligé à aller au bord de la piscine pour aider au nettoyage."

# game/scripts/c25/c25.rpy:1302
translate french c25s002_KimSaved_238d5632:

    # "Suena tu teléfono. Es un mensaje de [ama] indicándote que te quedes en el camarote hasta que ella te lo diga. No le dices nada a [kim]."
    "Votre téléphone sonne. C'est un message de [ama] vous demandant de rester dans la cabine jusqu'à nouvel ordre. Vous ne dites rien à [kim]."

# game/scripts/c25/c25.rpy:1304
translate french c25s002_KimSaved_62d537a1:

    # kim "Hoy ha sido un poco diferente. Yo tenía órdenes de quedarme en el helipuerto hasta que llegara el último helicóptero."
    kim "Aujourd'hui, c'était un peu différent. J'avais reçu l'ordre de rester à l'héliport jusqu'à l'arrivée du dernier hélicoptère."

# game/scripts/c25/c25.rpy:1305
translate french c25s002_KimSaved_d87c0a2d:

    # kim "Era el vuestro. No me habían dicho el nombre de la empresa."
    kim "C'était à vous. Ils ne m'avaient pas dit le nom de l'entreprise."

# game/scripts/c25/c25.rpy:1306
translate french c25s002_KimSaved_4693061c:

    # mc "Lo han hecho de tal forma que te mantenían apartada y segura hasta que fuera necesario utilizarte para intentar hacernos daño."
    mc "Ils ont procédé de telle sorte qu'ils vous ont tenu à l'écart et en sécurité jusqu'à ce qu'il soit nécessaire de vous utiliser pour tenter de nous nuire."

# game/scripts/c25/c25.rpy:1307
translate french c25s002_KimSaved_8504494e:

    # mc "Siento que te hayas visto involucrada en esto."
    mc "Je suis désolé que vous ayez été impliqué dans cette affaire."

# game/scripts/c25/c25.rpy:1309
translate french c25s002_KimSaved_6e363e6a:

    # kim "Gracias por salvarme. Tú no tienes la culpa, pero has evitado que tuviera que hacer... eso."
    kim "Merci de m'avoir sauvé. Ce n'est pas votre faute, mais vous m'avez évité d'avoir à faire… ça."

# game/scripts/c25/c25.rpy:1310
translate french c25s002_KimSaved_88a1d046:

    # mc "No podía aceptar que te usaran para atacar a NTR. No por NTR, sino por ti."
    mc "Je ne pouvais pas accepter qu'ils se servent de toi pour attaquer NTR. Non pas à cause de NTR, mais à cause de toi."

# game/scripts/c25/c25.rpy:1311
translate french c25s002_KimSaved_5558385b:

    # mc "Nunca he compartido lo de que los daños colaterales son necesarios, y a Ichigo parece que no le importaba usarte a ti para darnos una lección."
    mc "Je n'ai jamais été d'accord pour dire que les dommages collatéraux étaient nécessaires, et Ichigo ne semblait pas s'opposer à ce qu'il vous utilise pour nous donner une leçon."

# game/scripts/c25/c25.rpy:1313
translate french c25s002_KimSaved_e3964144:

    # kim "Pero la lección se la has dado tú. Espero que no tenga consecuencias para vosotros. Para mí..."
    kim "Mais tu leur as donné une leçon. J'espère que cela n'aura pas de conséquences pour toi. Pour moi…"

# game/scripts/c25/c25.rpy:1314
translate french c25s002_KimSaved_8f21a839:

    # mc "¿Qué puede hacer? No te contrató directamente. Tus jefes son la agencia, ¿no?"
    mc "Que pouvez-vous faire ? Il ne vous a pas embauché directement. Vos supérieurs sont l'agence, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1316
translate french c25s002_KimSaved_36f0b49e:

    # kim "Sí, pero si pone alguna queja en la agencia sobre mí, posiblemente no me vuelvan a contratar."
    kim "Oui, mais si vous déposez des plaintes à mon sujet auprès de l'agence, ils ne me réembaucheront probablement pas."

# game/scripts/c25/c25.rpy:1317
translate french c25s002_KimSaved_6e2ccdc5:

    # mc "No lo había pensado... En ese caso podríamos hablar con la agencia. Supongo que no les gustará que te hayan querido usar como bandeja de sushi."
    mc "Je n'y avais pas pensé… Dans ce cas, on pourrait parler à l'agence. J'imagine qu'ils ne seront pas contents qu'on ait essayé de vous utiliser comme un plateau de sushis."

# game/scripts/c25/c25.rpy:1319
translate french c25s002_KimSaved_f63a7ab0:

    # kim "Sería mi palabra contra la del cliente. No serviría de nada. Cuando casi me obliga a desnudarme no había nadie más de la agencia."
    kim "Ce serait ma parole contre celle du client. Cela ne servirait à rien. Lorsqu'il a failli me forcer à me déshabiller, il n'y avait personne d'autre de l'agence aux alentours."

# game/scripts/c25/c25.rpy:1320
translate french c25s002_KimSaved_daba12f7:

    # kim "Las chicas del sushi no eran de mi agencia, y las prostitutas tampoco."
    kim "Les serveuses de sushis n'étaient pas de mon agence, et les prostituées non plus."

# game/scripts/c25/c25.rpy:1321
translate french c25s002_KimSaved_69eaf061:

    # mc "¿La agencia abre mañana? Es domingo."
    mc "L'agence est-elle ouverte demain ? Nous sommes dimanche."

# game/scripts/c25/c25.rpy:1323
translate french c25s002_KimSaved_55cb149e:

    # kim "Creo que no. ¿Por qué lo preguntas?"
    kim "Je ne crois pas. Pourquoi me posez-vous cette question ?"

# game/scripts/c25/c25.rpy:1324
translate french c25s002_KimSaved_af574919:

    # mc "Porque se me está ocurriendo una idea. Tendré que hablar con [ama]."
    mc "Parce que j'ai une idée. Il faudra que j'en parle à [ama]."

# game/scripts/c25/c25.rpy:1326
translate french c25s002_KimSaved_d52bd857:

    # "[kim] se derrumba sobre la cama, con la cara ente las manos."
    "[kim] s'effondre sur le lit, le visage dans les mains."

# game/scripts/c25/c25.rpy:1327
translate french c25s002_KimSaved_48e69bb0:

    # mc "¿Estás bien, [kim]?"
    mc "Ça va, [kim] ?"

# game/scripts/c25/c25.rpy:1329
translate french c25s002_KimSaved_0b1affd7:

    # kim "Ha empezado a temblarme todo. Me he puesto muy nerviosa con la situación del Sr. Ichigo, y supongo que..."
    kim "Tout mon corps s'est mis à trembler. J'étais vraiment très inquiète pour M. Ichigo, et je suppose…"

# game/scripts/c25/c25.rpy:1330
translate french c25s002_KimSaved_46237382:

    # mc "La adrenalina del momento te está abandonando."
    mc "L'adrénaline du moment vous quitte."

# game/scripts/c25/c25.rpy:1331
translate french c25s002_KimSaved_0815777d:

    # kim "Sí, no sabía cómo reaccionar. Tenía ganas de salir corriendo, pero no había dónde huir."
    kim "Oui, je ne savais pas comment réagir. J'avais envie de m'enfuir, mais il n'y avait nulle part où aller."

# game/scripts/c25/c25.rpy:1332
translate french c25s002_KimSaved_c36133f6:

    # mc "¿Quieres tumbarte un rato? Parece que vamos a estar un rato aquí..."
    mc "Vous aimeriez vous allonger un moment ? On dirait qu'on va rester ici un bon moment..."

# game/scripts/c25/c25.rpy:1334
translate french c25s002_KimSaved_02e334cc:

    # kim "No sé lo que quiero, [mc]. Quiero estar lejos de este barco..."
    kim "Je ne sais pas ce que je veux. Je veux être loin de ce navire..."

# game/scripts/c25/c25.rpy:1335
translate french c25s002_KimSaved_d56b9c53:

    # mc "Lo entiendo."
    mc "Je comprends."

# game/scripts/c25/c25.rpy:1336
translate french c25s002_KimSaved_a90b0a0c:

    # kim "Quiero que me abraces, sentirme segura..."
    kim "Je veux que tu me prennes dans tes bras, pour que je me sente en sécurité..."

# game/scripts/c25/c25.rpy:1337
translate french c25s002_KimSaved_2b797475:

    # mc "Eso puedo hacerlo, al menos lo de abrazarte. Ven aquí."
    mc "Je peux faire ça, du moins pour les câlins. Viens ici."

# game/scripts/c25/c25.rpy:1339
translate french c25s002_KimSaved_2ad592c1:

    # kim "Se está bien aquí."
    kim "Il fait bon ici."

# game/scripts/c25/c25.rpy:1340
translate french c25s002_KimSaved_bc59560f:

    # mc "Podemos estar así todo el tiempo que quieras."
    mc "Nous pouvons rester comme ça aussi longtemps que vous le souhaitez."

# game/scripts/c25/c25.rpy:1346
translate french c25s002_KimSaved_f501db08:

    # kim "Soy una cobarde, [mc]."
    kim "Je suis un lâche, [mc]."

# game/scripts/c25/c25.rpy:1347
translate french c25s002_KimSaved_6be98b58:

    # mc "No lo eres, [kim]. Creo que nadie habría sabido reaccionar en tu situación."
    mc "Tu ne l'es pas, [kim]. Je ne pense pas que quiconque aurait su comment réagir dans ta situation."

# game/scripts/c25/c25.rpy:1348
translate french c25s002_KimSaved_674422e7:

    # mc "Estoy seguro de que, si hubiera tardado un par de segundos en decirle a Ichigo que te traía al camarote, lo hubiera hecho [ama]."
    mc "Je suis sûr que si cela m'avait pris quelques secondes pour dire à Ichigo que je t'emmenais au chalet, je l'aurais fait [ama]."

# game/scripts/c25/c25.rpy:1349
translate french c25s002_KimSaved_09255eb3:

    # mc "Es la única que está entrenada para reaccionar rápido bajo presión."
    mc "Elle est la seule formée pour réagir rapidement sous pression."

# game/scripts/c25/c25.rpy:1351
translate french c25s002_KimSaved_ca03c492:

    # kim "Pero tú lo has hecho y no estás entrenado. Yo me he quedado ahí, sin saber que hacer, como un conejo deslumbrado por los faros de un coche."
    kim "Mais tu l'as fait, et tu n'es pas formé. Je suis resté là, sans savoir quoi faire, comme un lapin aveuglé par les phares d'une voiture."

# game/scripts/c25/c25.rpy:1352
translate french c25s002_KimSaved_302fb5f9:

    # mc "No le des más vueltas. Lo importante es que estás a salvo."
    mc "N'y pense pas trop. L'important, c'est que tu sois en sécurité."

# game/scripts/c25/c25.rpy:1353
translate french c25s002_KimSaved_ef0f3a70:

    # mc "Eso no te convierte en una cobarde."
    mc "Cela ne fait pas de vous un lâche."

# game/scripts/c25/c25.rpy:1355
translate french c25s002_KimSaved_5709a08c:

    # kim "Si no fuese una cobarde te estaría besando ahora mismo."
    kim "Si je n'étais pas un lâche, je t'embrasserais en ce moment même."

# game/scripts/c25/c25.rpy:1356
translate french c25s002_KimSaved_f0ff79a3:

    # mc "No tienes por qué hacerlo por agradecimiento. [ama] hubiera hecho lo mismo si le hubiera dado tiempo."
    mc "Tu n'es pas obligé de le faire par gratitude. [ama] J'aurais fait pareil si j'avais eu le temps."

# game/scripts/c25/c25.rpy:1358
translate french c25s002_KimSaved_c753e785:

    # kim "No sería... sólo... por agradecimiento..."
    kim "Ce ne serait pas... juste... par gratitude..."

# game/scripts/c25/c25.rpy:1360
translate french c25s002_KimSaved_9730c504:

    # mc "Pero querías hablar con mi madre, ¿no?"
    mc "Mais vous vouliez parler à ma mère, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1362
translate french c25s002_KimSaved_6a9a884c:

    # mc "Pero querías hablar con [mar], ¿no?"
    mc "Mais vous vouliez parler à [mar], n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1364
translate french c25s002_KimSaved_ebf4f5a8:

    # kim "Sí, y lo hice mientras estabais en Monterey."
    kim "Oui, et je l'ai fait pendant que tu étais à Monterey."

# game/scripts/c25/c25.rpy:1365
translate french c25s002_KimSaved_a8eeec1e:

    # kim "Otra muestra de cobardía. Me tuvo que obligar [kat]. Me hizo lo que [deb.nick] te hizo a ti con [lis]."
    kim "Encore un exemple de lâcheté. Il a dû me forcer à jouer [kat]. Il m'a fait subir ce que [deb.nick] vous a fait subir avec [lis]."

# game/scripts/c25/c25.rpy:1384
translate french c25s002_KimRoute_de7b367e:

    # kim "Me dijo que no le importaba que..."
    kim "Il m'a dit que ça ne le dérangeait pas..."

# game/scripts/c25/c25.rpy:1387
translate french c25s002_KimRoute_3ad23dec:

    # kim "¿QUÉ? ¿Has dicho que vas a besarme?"
    kim "QUOI ? Tu as dit que tu allais m'embrasser ?"

# game/scripts/c25/c25.rpy:1390
translate french c25s002_KimRoute_5e958d49:

    # "Vale más una imagen, o en este caso un beso, que mil palabras. Acallas sus preguntas poniendo tus labios sobre los suyos."
    "Une image, ou plutôt un baiser, vaut mille mots. Vous faites taire ses questions en posant vos lèvres sur les siennes."

# game/scripts/c25/c25.rpy:1391
translate french c25s002_KimRoute_17df26f5:

    # "Se queda paralizada como un conejo deslumbrado por los faros de un coche."
    "Elle se fige comme un lapin aveuglé par les phares d'une voiture."

# game/scripts/c25/c25.rpy:1392
translate french c25s002_KimRoute_70763c3a:

    # "Es como besar una estatua. Una estatua que respira en tu boca, y cuyos labios son deliciosamente suaves."
    "C'est comme embrasser une statue. Une statue qui respire dans votre bouche et dont les lèvres sont délicieusement douces."

# game/scripts/c25/c25.rpy:1394
translate french c25s002_KimRoute_4dfbacf4:

    # "La parálisis tan solo dura unos segundos, hasta que su cerebro procesa lo que está pasando."
    "La paralysie ne dure que quelques secondes, le temps que votre cerveau traite ce qui se passe."

# game/scripts/c25/c25.rpy:1395
translate french c25s002_KimRoute_ab3af1fa:

    # "Entonces la estatua cobra vida y empieza a devolverte el beso torpemente, casi inconscientemente, dejándose llevar por sus instintos."
    "Alors la statue s'anime et commence à vous répondre maladroitement, presque inconsciemment, cédant à ses instincts."

# game/scripts/c25/c25.rpy:1397
translate french c25s002_KimRoute_4eeeefb6:

    # "Por un momento se tensa antes de separarse de ti y darte la espalda."
    "Il se raidit un instant avant de se séparer de vous et de vous tourner le dos."

# game/scripts/c25/c25.rpy:1398
translate french c25s002_KimRoute_6b7d9638:

    # kim "¡No!"
    kim "Non!"

# game/scripts/c25/c25.rpy:1399
translate french c25s002_KimRoute_b31a7ac8:

    # mc "¿No? ¿A qué te refieres?"
    mc "Non ? Que voulez-vous dire ?"

# game/scripts/c25/c25.rpy:1401
translate french c25s002_KimRoute_60c08b65:

    # kim "No soy estúpida, [mc]."
    kim "Je ne suis pas stupide, [mc]."

# game/scripts/c25/c25.rpy:1402
translate french c25s002_KimRoute_783432b5:

    # mc "Lo sé, pero sigo sin saber a qué te refieres."
    mc "Je sais, mais je ne comprends toujours pas ce que vous voulez dire."

# game/scripts/c25/c25.rpy:1404
translate french c25s002_KimRoute_923f5d13:

    # kim "Sé para qué se usan estos camarotes..."
    kim "Je sais à quoi servent ces cabanes..."

# game/scripts/c25/c25.rpy:1405
translate french c25s002_KimRoute_03a5515f:

    # mc "¿Crees que Ichigo y yo nos hemos puesto de acuerdo para que montase el espectáculo en la cubierta y tuviera la oportunidad de traerte aquí y tener sexo contigo?"
    mc "Crois-tu qu'Ichigo et moi avons comploté pour qu'il fasse un spectacle sur le pont afin qu'il ait l'occasion de t'amener ici et de coucher avec toi ?"

# game/scripts/c25/c25.rpy:1406
translate french c25s002_KimRoute_c6196eec:

    # kim "No... Dicho en voz alta... Parece que sí. Soy estúpida."
    kim "Non… dit à voix haute… Il semblerait bien. Je suis bête."

# game/scripts/c25/c25.rpy:1407
translate french c25s002_KimRoute_98cffde8:

    # mc "No lo eres. Hoy te han pasado cosas raras y tu mente aún las está procesando."
    mc "Non. Il vous est arrivé des choses étranges aujourd'hui, et votre esprit est encore en train de les assimiler."

# game/scripts/c25/c25.rpy:1409
translate french c25s002_KimRoute_a7dd6f21:

    # kim "¿Como que me beses?"
    kim "Que veux-tu dire par « m'embrasser » ?"

# game/scripts/c25/c25.rpy:1410
translate french c25s002_KimRoute_4d41733f:

    # mc "Bueno, eso no lo consideraría raro. He estado esperando mucho tiempo para hacerlo."
    mc "Eh bien, je ne trouverais pas ça étrange. J'attendais ce moment depuis longtemps."

# game/scripts/c25/c25.rpy:1412
translate french c25s002_KimRoute_3529c579:

    # kim "Sabes que podrías haberlo hecho hace varios días, ¿verdad?"
    kim "Tu sais que tu aurais pu le faire il y a plusieurs jours, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1414
translate french c25s002_KimRoute_0a28e4c0:

    # mc "No. No hasta que no hubieras tenido la conversación con mi madre."
    mc "Non. Pas avant que vous ayez eu cette conversation avec ma mère."

# game/scripts/c25/c25.rpy:1416
translate french c25s002_KimRoute_bd6e224c:

    # mc "No. No hasta que no hubieras tenido la conversación con [mar]."
    mc "Non. Pas avant d'avoir eu la conversation avec [mar]."

# game/scripts/c25/c25.rpy:1417
translate french c25s002_KimRoute_cd09315c:

    # mc "No te hubieras sentido a gusto si lo hubiera hecho antes de esa conversación."
    mc "Vous n'auriez pas été à l'aise si je l'avais fait avant cette conversation."

# game/scripts/c25/c25.rpy:1419
translate french c25s002_KimRoute_bb564976:

    # kim "Pero ahora... me sentiría a gusto si lo repitieras... Lo sabes, ¿verdad?"
    kim "Mais maintenant... je serais à l'aise si tu le recommencais... Tu le sais, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1420
translate french c25s002_KimRoute_d642f603:

    # mc "*Risa* Lo sé."
    mc "*Rires* Je sais."

# game/scripts/c25/c25.rpy:1422
translate french c25s002_KimRoute_32249ab8:

    # "Vuestros labios vuelven a unirse. Esta vez está preparada y el beso devuelto es mucho menos torpe."
    "Vos lèvres se rencontrent à nouveau. Cette fois, elle est prête, et le baiser qui lui répond est beaucoup moins maladroit."

# game/scripts/c25/c25.rpy:1423
translate french c25s002_KimRoute_d8f636f5:

    # "Y mucho más largo."
    "Et bien plus longtemps."

# game/scripts/c25/c25.rpy:1424
translate french c25s002_KimRoute_99e27d59:

    # "La tensión de todo lo que ha pasado en la última hora desaparece por completo, sustituida por pasión."
    "La tension accumulée durant la dernière heure disparaît complètement, remplacée par la passion."

# game/scripts/c25/c25.rpy:1425
translate french c25s002_KimRoute_0c1f6b62:

    # "El beso dura hasta que [kim] empieza a respirar entrecortadamente en tu boca."
    "Le baiser dure jusqu'à ce que [kim] commence à respirer bruyamment dans ta bouche."

# game/scripts/c25/c25.rpy:1427
translate french c25s002_KimRoute_2fb47448:

    # kim "*Jadeo* Deberías dejarme respirar. Tengo el corazón que parece que me va a explotar en el pecho."
    kim "*Halètement* Laissez-moi respirer. J'ai l'impression que mon cœur va exploser dans ma poitrine."

# game/scripts/c25/c25.rpy:1428
translate french c25s002_KimRoute_8113615d:

    # mc "*Risa* Eso no tiene que ver con la falta de aire, preciosa. El mío también está latiendo deprisa."
    mc "*Rires* Ça n'a rien à voir avec l'essoufflement, ma chérie. Le mien bat vite aussi."

# game/scripts/c25/c25.rpy:1430
translate french c25s002_KimRoute_27e3476b:

    # kim "¡No te rías de mí!"
    kim "Ne vous moquez pas de moi !"

# game/scripts/c25/c25.rpy:1431
translate french c25s002_KimRoute_dee052a6:

    # mc "Nunca lo haría."
    mc "Je ne ferais jamais ça."

# game/scripts/c25/c25.rpy:1434
translate french c25s002_KimRoute_251628e3:

    # kim "¿Ni siquiera cuando me dijiste que debería usar el maquillaje corporal?"
    kim "Même pas quand tu m'as dit que je devais utiliser du maquillage corporel ?"

# game/scripts/c25/c25.rpy:1435
translate french c25s002_KimRoute_b09b2ec0:

    # mc "Ni siquiera entonces. Te lo dije porque parecías más segura de ti misma y porque te importaba lo que tus compañeras pensaran."
    mc "Même pas à ce moment-là. Je te l'ai dit parce que tu semblais plus sûr de toi et parce que tu te souciais de l'opinion de tes camarades."

# game/scripts/c25/c25.rpy:1436
translate french c25s002_KimRoute_df03c4cf:

    # mc "No porque a mí no me guste tu piel."
    mc "Non pas parce que je n'aime pas ta peau."

# game/scripts/c25/c25.rpy:1438
translate french c25s002_KimRoute_71c081be:

    # kim "¿De verdad te gusta?"
    kim "Tu aimes vraiment ça ?"

# game/scripts/c25/c25.rpy:1439
translate french c25s002_KimRoute_63d47a1c:

    # mc "Es como un mapa que me encantaría pasarme una noche recorriendo."
    mc "C'est comme une carte que j'adorerais explorer pendant une nuit."

# game/scripts/c25/c25.rpy:1441
translate french c25s002_KimRoute_fbc7097e:

    # kim "Puedes hacerlo ahora..."
    kim "Vous pouvez le faire maintenant..."

# game/scripts/c25/c25.rpy:1444
translate french c25s002_KimRoute_123f70fa:

    # kim "Lo sé. Lo descubrí el día que me dijiste que no necesitaba usar el maquillaje corporal."
    kim "Je sais. Je l'ai compris le jour où tu m'as dit que je n'avais pas besoin de maquillage corporel."

# game/scripts/c25/c25.rpy:1445
translate french c25s002_KimRoute_b8ee195b:

    # kim "Visto ahora que han pasado dos semanas... podías haberte reído de mí, y no lo hiciste."
    kim "Avec le recul, deux semaines plus tard… vous auriez pu vous moquer de moi, et vous ne l’avez pas fait."

# game/scripts/c25/c25.rpy:1446
translate french c25s002_KimRoute_0514034b:

    # mc "Nunca me reiría de ti. Y menos por algo que para ti es tan importante."
    mc "Je ne me moquerais jamais de toi. Surtout pas pour quelque chose d'aussi important à tes yeux."

# game/scripts/c25/c25.rpy:1447
translate french c25s002_KimRoute_0f402e6c:

    # mc "Me gusta tu piel y..."
    mc "J'aime ta peau et..."

# game/scripts/c25/c25.rpy:1449
translate french c25s002_KimRoute_269585ef:

    # kim "Y es como un mapa que te pasarías la noche recorriendo con los dedos..."
    kim "Et c'est comme une carte que l'on pourrait passer toute la nuit à tracer du bout des doigts..."

# game/scripts/c25/c25.rpy:1450
translate french c25s002_KimRoute_c13c0904:

    # mc "¿Te acuerdas?"
    mc "Vous souvenez-vous?"

# game/scripts/c25/c25.rpy:1452
translate french c25s002_KimRoute_14366cd2:

    # kim "No podría olvidarlo. En ese momento empecé a sentir algo por ti. Aún no lo sabía, pero... me di cuenta de que no me mirabas como me mira todo el mundo."
    kim "Je ne l'oublierai jamais. C'est à ce moment-là que j'ai commencé à éprouver des sentiments pour toi. Je ne le savais pas encore, mais… j'ai compris que tu ne me regardais pas comme tout le monde."

# game/scripts/c25/c25.rpy:1453
translate french c25s002_KimRoute_ac18ac78:

    # mc "[kim], eres especial. Eres preciosa. No eres como las demás chicas, cierto. Pero no por ello eres menos hermosa."
    mc "[kim], tu es spéciale. Tu es belle. Tu n'es pas comme les autres filles, c'est vrai. Mais cela ne te rend pas moins belle."

# game/scripts/c25/c25.rpy:1455
translate french c25s002_KimRoute_c043af28:

    # kim "Sabes que podrías empezar a recorrer ese mapa ahora, ¿no?"
    kim "Vous savez que vous pourriez commencer à explorer cette carte dès maintenant, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1456
translate french c25s002_KimRoute_47c8b1d7:

    # mc "No creo que sea el lugar más adecuado para nuestra primera vez."
    mc "Je ne pense pas que ce soit l'endroit le plus approprié pour une première fois."

# game/scripts/c25/c25.rpy:1458
translate french c25s002_KimRoute_c85dbdd9:

    # kim "¿Qué? ¡No! ¡No me refería a eso!"
    kim "Quoi ? Non ! Je ne voulais pas dire ça !"

# game/scripts/c25/c25.rpy:1459
translate french c25s002_KimRoute_7123177f:

    # kim "No me gustaría que nuestra primera vez fuera en este barco, ni en un camarote donde... ya sabes..."
    kim "Je ne voudrais pas que notre première fois se passe sur ce bateau, ni dans une cabine où... vous savez..."

# game/scripts/c25/c25.rpy:1460
translate french c25s002_KimRoute_04b4d579:

    # mc "Exacto. ¿A qué te referías, entonces?"
    mc "Exactement. Que vouliez-vous dire, alors ?"

# game/scripts/c25/c25.rpy:1462
translate french c25s002_KimRoute_326bcf4a:

    # kim "A que puedes recorrer el mapa... en las zonas visibles..."
    kim "Je parie que vous pouvez explorer la carte... dans les zones visibles..."

# game/scripts/c25/c25.rpy:1463
translate french c25s002_KimRoute_b3777a72:

    # kim "Me encantaría sentir tus dedos sobre la piel, pero no me gustaría quitarme la ropa... aquí."
    kim "J'adorerais sentir tes doigts sur ma peau, mais je ne voudrais pas me déshabiller... ici."

# game/scripts/c25/c25.rpy:1464
translate french c25s002_KimRoute_5f0d1ce8:

    # mc "Me parece una idea genial. Túmbate mientras me quito la chaqueta."
    mc "Ça me paraît une excellente idée. Allonge-toi pendant que j'enlève ma veste."

# game/scripts/c25/c25.rpy:1466
translate french c25s002_KimRoute_844c5ddf:

    # kim "¿Así?"
    kim "Donc?"

# game/scripts/c25/c25.rpy:1467
translate french c25s002_KimRoute_fd671cf1:

    # mc "Así estás perfecta. Siempre estás perfecta."
    mc "Tu es parfaite comme ça. Tu es toujours parfaite."

# game/scripts/c25/c25.rpy:1468
translate french c25s002_KimRoute_7ee801e9:

    # mc "¿Puedo empezar a recorrer el mapa con los dedos?"
    mc "Puis-je commencer à tracer le contour de la carte avec mes doigts ?"

# game/scripts/c25/c25.rpy:1469
translate french c25s002_KimRoute_19047ffe:

    # kim "Cuando quieras..."
    kim "Quand vous voulez..."

# game/scripts/c25/c25.rpy:1471
translate french c25s002_KimRoute_525f2efb:

    # kim "¿Qué estás haciendo, [mc]?"
    kim "Que fais-tu, [mc] ?"

# game/scripts/c25/c25.rpy:1472
translate french c25s002_KimRoute_8d43e436:

    # mc "*Risa* Ya te lo he dicho, recorrer el mapa con los dedos."
    mc "*Rires* Je te l'ai déjà dit, suis la carte du doigt."

# game/scripts/c25/c25.rpy:1473
translate french c25s002_KimRoute_7ee4012b:

    # kim "[mc], ¿puedes mirarme un momento?"
    kim "[mc], peux-tu me regarder un instant ?"

# game/scripts/c25/c25.rpy:1475
translate french c25s002_KimRoute_add7085a:

    # "Una almohada salta inesperadamente de la mano de [kim] a tu cara."
    "Un oreiller saute inopinément de la main de [kim] sur votre visage."

# game/scripts/c25/c25.rpy:1476
translate french c25s002_KimRoute_68fe5918:

    # kim "*Risa* Eso te pasa por reírte de mí. ¡Has dicho que nunca lo harías!"
    kim "*Rires* Voilà ce qui arrive quand on se moque de moi ! Tu avais dit que tu ne ferais jamais ça !"

# game/scripts/c25/c25.rpy:1477
translate french c25s002_KimRoute_29f541ee:

    # mc "*Risa* Al menos has quitado la chocolatina que había encima de la almohada antes de tirármela."
    mc "*Rires* Au moins, tu as enlevé la barre de chocolat qui était sur l'oreiller avant de me la jeter."

# game/scripts/c25/c25.rpy:1479
translate french c25s002_KimRoute_567c60e0:

    # kim "*Risa* Me la he comido antes, cuando has empezado a hacer el tonto con el mapa de la pared."
    kim "*Rires* Je l'ai mangé plus tôt, quand tu as commencé à jouer avec la carte au mur."

# game/scripts/c25/c25.rpy:1480
translate french c25s002_KimRoute_1f5fafdf:

    # mc "*Risa* He tenido suerte. No querría ser el protagonista del titular 'Pierde un ojo por culpa de una chocolatina'."
    mc "*Rires* J'ai eu de la chance. Je ne voudrais pas faire la une des journaux avec le titre « Perd un œil à cause d'une barre chocolatée »."

# game/scripts/c25/c25.rpy:1481
translate french c25s002_KimRoute_17de5028:

    # mc "¿Preparada?"
    mc "Prêt?"

# game/scripts/c25/c25.rpy:1483
translate french c25s002_KimRoute_e4e2f81c:

    # kim "Cuando quieras."
    kim "Quand vous voulez."

# game/scripts/c25/c25.rpy:1484
translate french c25s002_KimRoute_40aecd78:

    # mc "¿Por dónde quieres que empiece?"
    mc "Par où voulez-vous que je commence ?"

# game/scripts/c25/c25.rpy:1485
translate french c25s002_KimRoute_0f359ed0:

    # kim "Por donde quieras. Espero que en los próximos días encuentres el camino al tesoro en el mapa."
    kim "Comme vous le souhaitez. J'espère que vous trouverez le chemin vers le trésor sur la carte dans les prochains jours."

# game/scripts/c25/c25.rpy:1486
translate french c25s002_KimRoute_6cd87abd:

    # kim "Cuando estemos en algún otro sitio."
    kim "Quand nous sommes ailleurs."

# game/scripts/c25/c25.rpy:1488
translate french c25s002_KimRoute_87c0778a:

    # "Empiezas a recorrer la suave mano de la modelo, recorriendo con la yema de tu dedo la frontera en su piel donde cambia de color."
    "Vous commencez à caresser la main douce du mannequin, en faisant glisser votre doigt le long du contour de sa peau, là où la couleur change."

# game/scripts/c25/c25.rpy:1489
translate french c25s002_KimRoute_fe816c23:

    # mc "¿Ves? Si usaras maquillaje corporal, no podría hacer esto. Los exploradores se perderían sin un mapa que seguir."
    mc "Vous voyez ? Si vous aviez utilisé de la peinture corporelle, je n'aurais pas pu faire ça. Les explorateurs se seraient perdus sans carte."

# game/scripts/c25/c25.rpy:1490
translate french c25s002_KimRoute_9c89e44b:

    # kim "*Risa* ¿Siempre le ves el lado bueno a las cosas?"
    kim "*Rires* Tu vois toujours le bon côté des choses ?"

# game/scripts/c25/c25.rpy:1492
translate french c25s002_KimRoute_e4ce436d:

    # mc "Si sólo tuviera que mirar el lado bueno de las cosas, nunca más podría apartar la mirada de donde la tengo puesta ahora mismo."
    mc "Si je ne devais voir que le bon côté des choses, je ne pourrais jamais quitter des yeux l'endroit où ils se trouvent en ce moment."

# game/scripts/c25/c25.rpy:1493
translate french c25s002_KimRoute_59d67c2c:

    # kim "Es lo más bonito que me han dicho nunca, [mc]."
    kim "C'est la chose la plus gentille qu'on m'ait jamais dite, [mc]."

# game/scripts/c25/c25.rpy:1495
translate french c25s002_KimRoute_71648375:

    # mc "Este trozo en tu muslo me recuerda a un mapa medieval de Irlanda que vi una vez."
    mc "Ce tatouage sur ta cuisse me fait penser à une carte médiévale de l'Irlande que j'ai vue une fois."

# game/scripts/c25/c25.rpy:1496
translate french c25s002_KimRoute_9c61816a:

    # mc "Me podría pasar horas recorriendo las costas de nuestra Irlanda particular."
    mc "Je pourrais passer des heures à explorer les côtes de notre propre Irlande."

# game/scripts/c25/c25.rpy:1497
translate french c25s002_KimRoute_65e64d28:

    # kim "Tus dedos me están dando escalofríos..."
    kim "Tes doigts me donnent des frissons..."

# game/scripts/c25/c25.rpy:1499
translate french c25s002_KimRoute_e651fd6a:

    # mc "¿Quieres que pare?"
    mc "Voulez-vous que je m'arrête?"

# game/scripts/c25/c25.rpy:1500
translate french c25s002_KimRoute_82cf176d:

    # kim "Quiero que sigas recorriéndome, pero ya lo sabes... sólo las zonas visibles..."
    kim "Je veux que tu continues à m'explorer, mais tu ne connais déjà que les parties visibles..."

# game/scripts/c25/c25.rpy:1501
translate french c25s002_KimRoute_4dd2773f:

    # kim "Solo de pensar en quitarme la ropa aquí... "
    kim "Je pense juste à enlever mes vêtements ici..."

# game/scripts/c25/c25.rpy:1503
translate french c25s002_KimRoute_6eaa78b0:

    # mc "Lo sé, preciosa. Le quitaría toda la magia."
    mc "Je sais, chérie. Cela enlèverait toute la magie."

# game/scripts/c25/c25.rpy:1504
translate french c25s002_KimRoute_3d8f184c:

    # mc "Pero no te preocupes, hay suficientes zonas visibles que quiero recorrer."
    mc "Mais ne vous inquiétez pas, il y a suffisamment d'endroits visibles que je souhaite explorer."

# game/scripts/c25/c25.rpy:1505
translate french c25s002_KimRoute_0ebc6125:

    # mc "Siempre me ha parecido espectacular esta forma, como si estuvieras en un baile de máscaras..."
    mc "J'ai toujours trouvé ce style spectaculaire, comme si j'étais à un bal masqué..."

# game/scripts/c25/c25.rpy:1506
translate french c25s002_KimRoute_bf728b61:

    # kim "Pero eso no es un mapa, entonces..."
    kim "Mais ce n'est donc pas une carte..."

# game/scripts/c25/c25.rpy:1507
translate french c25s002_KimRoute_d6bb04a7:

    # mc "Si me dejas decir la cursilada del día, te diré que es el mapa que lleva a tus ojos. Es una de las partes que más me gustan de ti."
    mc "Si vous me permettez une petite déclaration un peu mièvre aujourd'hui, je dirais que c'est le regard qui guide mes pas. C'est une des choses que j'aime le plus chez vous."

# game/scripts/c25/c25.rpy:1509
translate french c25s002_KimRoute_1811c1ca:

    # kim "*Risa* Sí. Ha sonado muy cursi. Pero me ha encantado."
    kim "*Rires* Oui. Ça sonnait vraiment ringard. Mais j'ai adoré."

# game/scripts/c25/c25.rpy:1510
translate french c25s002_KimRoute_1dea0ec7:

    # kim "Normalmente me dicen que parezco un mapache..."
    kim "On me dit souvent que je ressemble à un raton laveur..."

# game/scripts/c25/c25.rpy:1511
translate french c25s002_KimRoute_d2f6e034:

    # mc "¡Pues te nombro Miss Mapache California 2023! *Risa*"
    mc "Eh bien, je vous nomme Miss Raton laveur de Californie 2023 ! *Rires*"

# game/scripts/c25/c25.rpy:1512
translate french c25s002_KimRoute_f45ae86e:

    # kim "*Risa* ¡Eres increíble!"
    kim "*Rires* Tu es incroyable !"

# game/scripts/c25/c25.rpy:1514
translate french c25s002_KimRoute_d23d7163:

    # mc "¿Sabes lo que le falta a este mapa?"
    mc "Savez-vous ce qui manque à cette carte ?"

# game/scripts/c25/c25.rpy:1515
translate french c25s002_KimRoute_5ea9857f:

    # kim "¿Qué?"
    kim "Que?"

# game/scripts/c25/c25.rpy:1516
translate french c25s002_KimRoute_bf19f9f2:

    # mc "Besos. Le faltan muchos besos."
    mc "Des bisous. Elle a besoin de beaucoup de bisous."

# game/scripts/c25/c25.rpy:1518
translate french c25s002_KimRoute_2699c0f4:

    # "Vuelves a la mano, donde has empezado el recorrido por el mapa, repartiendo besos en sus nudillos, donde la piel cambia entre dos maravillosos colores."
    "Vous revenez à la main, point de départ de votre voyage à travers la carte, en déposant des baisers sur ses jointures, là où la peau oscille entre deux couleurs magnifiques."

# game/scripts/c25/c25.rpy:1519
translate french c25s002_KimRoute_8ca6c868:

    # kim "Aquí arriba hay un lugar que no has explorado aún."
    kim "Ici, il y a un endroit que vous n'avez pas encore exploré."

# game/scripts/c25/c25.rpy:1521
translate french c25s002_KimRoute_d4c5a57a:

    # kim "Creo que también necesita besos."
    kim "Je pense qu'elle a aussi besoin de baisers."

# game/scripts/c25/c25.rpy:1522
translate french c25s002_KimRoute_2f3d7147:

    # mc "Pero eso sería hacer trampas. ¿Te he visto alguna vez sin pintalabios? Ni siquiera en la piscina puedo recordarte sin pintalabios."
    mc "Mais ce serait de la triche. T'ai-je déjà vue sans rouge à lèvres ? Je ne me souviens même pas t'avoir vue sans rouge à lèvres à la piscine."

# game/scripts/c25/c25.rpy:1524
translate french c25s002_KimRoute_fd0a466b:

    # kim "Creo que la primera vez que subimos al lago no llevaba. Se me había acabado."
    kim "Je crois que je n'en avais plus la première fois que nous sommes allés au lac. J'étais à court."

# game/scripts/c25/c25.rpy:1525
translate french c25s002_KimRoute_e11dbaca:

    # kim "Siempre llevo. Tengo unos labios muy feos..."
    kim "Je les porte tout le temps. J'ai des lèvres vraiment laides..."

# game/scripts/c25/c25.rpy:1526
translate french c25s002_KimRoute_9e860ef4:

    # mc "Creo que eso debería decidirlo yo. Al menos decidir si me gustan."
    mc "Je pense que ce devrait être à moi d'en décider. Du moins, de décider si je les aime."

# game/scripts/c25/c25.rpy:1528
translate french c25s002_KimRoute_4aff812e:

    # kim "Puedes empezar por explorarlos con los tuyos. A lo mejor consigues borrarlo..."
    kim "Vous pouvez commencer par les explorer avec vos propres données. Peut-être parviendrez-vous à la supprimer…"

# game/scripts/c25/c25.rpy:1529
translate french c25s002_KimRoute_a59fc07d:

    # mc "Suena como un buen plan."
    mc "Ça me semble un bon plan."

# game/scripts/c25/c25.rpy:1530
translate french c25s002_KimRoute_5188245c:

    # mc "Pero... es pintalabios de ese que no se quita ni con disolvente industrial, ¿verdad?"
    mc "Mais… c’est le genre de rouge à lèvres qui ne part même pas avec un solvant industriel, n’est-ce pas ?"

# game/scripts/c25/c25.rpy:1532
translate french c25s002_KimRoute_5a33ffe1:

    # kim "*Risa* Sí."
    kim "*Rires* Oui."

# game/scripts/c25/c25.rpy:1534
translate french c25s002_KimRoute_3ab1f227:

    # "A ninguno de los dos os importa."
    "Vous vous en fichez tous les deux."

# game/scripts/c25/c25.rpy:1535
translate french c25s002_KimRoute_21e845d9:

    # "Os besáis durante un largo rato. No sabéis si dos minutos o dos horas."
    "Vous vous embrassez longuement. Vous ne savez plus si cela dure deux minutes ou deux heures."

# game/scripts/c25/c25.rpy:1537
translate french c25s002_KimRoute_0be07545:

    # "Tampoco os importa."
    "Vous aussi, ça vous est égal."

# game/scripts/c25/c25.rpy:1539
translate french c25s002_KimRoute_627f745d:

    # "Podrían haber sido dos años y, pese a todo, cuando suena tu móvil os hubiera costado igual separaros."
    "Cela aurait pu durer deux ans et, malgré tout, quand ton téléphone a sonné, la séparation aurait été tout aussi difficile."

# game/scripts/c25/c25.rpy:1541
translate french c25s002_KimRoute_7cbbdce6:

    # mc "Es [ama]. El helicóptero nos está esperando."
    mc "C'est [ama]. L'hélicoptère nous attend."

# game/scripts/c25/c25.rpy:1542
translate french c25s002_KimRoute_323ce83d:

    # kim "¿Nos vamos ya?"
    kim "On y va maintenant ?"

# game/scripts/c25/c25.rpy:1543
translate french c25s002_KimRoute_95c1cc56:

    # mc "Sí. Ha hablado con Sound sobre ti."
    mc "Oui. Il a parlé de vous à Sound."

# game/scripts/c25/c25.rpy:1544
translate french c25s002_KimRoute_751c8964:

    # kim "El Sr. Sound parece un buen tipo."
    kim "Monsieur Sound a l'air d'être un type sympa."

# game/scripts/c25/c25.rpy:1545
translate french c25s002_KimRoute_3fa3fca9:

    # "Ni un átomo de pintalabios ha desaparecido de los labios de la azafata."
    "Pas une seule trace de rouge à lèvres n'a disparu des lèvres de l'hôtesse de l'air."

# game/scripts/c25/c25.rpy:1551
translate french c25s002_KimHome_e8ddb21c:

    # "El helicóptero os deja en el parking de la galería de tiro y [ama] os lleva a casa."
    "L'hélicoptère vous dépose sur le parking du stand de tir et vous ramène chez vous."

# game/scripts/c25/c25.rpy:1552
translate french c25s002_KimHome_f47c7b0e:

    # "Estáis demasiado cansados para hablar sobre lo que ha pasado."
    "Tu es trop fatigué(e) pour parler de ce qui s'est passé."

# game/scripts/c25/c25.rpy:1555
translate french c25s002_KimHome_d6744449:

    # "Al llegar a casa..."
    "Quand je suis rentré chez moi..."

# game/scripts/c25/c25.rpy:1556
translate french c25s002_KimHome_cf7b87b5:

    # kim "Gracias por todo, [ama]."
    kim "Merci pour tout, [ama]."

# game/scripts/c25/c25.rpy:1557
translate french c25s002_KimHome_32108638:

    # ama "Yo no he hecho casi nada. Le tienes que dar las gracias al héroe de la noche."
    ama "Je n'ai quasiment rien fait. Il faut remercier le héros de la nuit."

# game/scripts/c25/c25.rpy:1558
translate french c25s002_KimHome_cf685f34:

    # kim "Ahora lo haré, no te preocupes."
    kim "Je vais le faire maintenant, ne t'inquiète pas."

# game/scripts/c25/c25.rpy:1561
translate french c25s002_KimHome_a14ad160:

    # kim "Te veo mañana, cielo. Estoy cansadísima."
    kim "Je te verrai demain, chérie. Je suis épuisée."

# game/scripts/c25/c25.rpy:1564
translate french c25s002_KimHome_10b54872:

    # kim "Te veo mañana, [mc]. Estoy cansadísima."
    kim "Je te verrai demain, [mc]. Je suis épuisé(e)."

# game/scripts/c25/c25.rpy:1565
translate french c25s002_KimHome_6a5181fc:

    # mc "Hasta mañana, guapísima. Descansa. Te lo mereces."
    mc "À demain, ma belle. Repose-toi bien. Tu le mérites."

# game/scripts/c25/c25.rpy:1567
translate french c25s002_KimHome_a84efca4:

    # "[kim] se mete en casa sin decir una palabra más y sin mirar atrás."
    "[kim] entre dans la maison sans dire un mot de plus et sans se retourner."

# game/scripts/c25/c25.rpy:1570
translate french c25s002_KimHome_b7a86c32:

    # ama "*Risita* Parece que habéis aprovechado el tiempo en el camarote."
    ama "*Rires* On dirait que tu as bien profité de ton temps dans la cabine."

# game/scripts/c25/c25.rpy:1571
translate french c25s002_KimHome_5ca885ad:

    # mc "Bueno, hemos hablado, una cosa ha llevado a la otra y... supongo que mañana os lo explicará en el grupo de WhatsUp."
    mc "Bon, on a discuté, une chose en entraînant une autre… je suppose qu’il vous l’expliquera demain dans le groupe WhatsUp."

# game/scripts/c25/c25.rpy:1572
translate french c25s002_KimHome_10fb1518:

    # mc "Por si tienes curiosidad, no nos hemos quitado la ropa. No era el mejor sitio para hacerlo."
    mc "Au cas où vous vous poseriez la question, nous ne nous sommes pas déshabillés. Ce n'était pas l'endroit idéal."

# game/scripts/c25/c25.rpy:1574
translate french c25s002_KimHome_300fa51b:

    # ama "No, [mc]. No tengo curiosidad. Tan solo me alegro por vosotros."
    ama "Non, [mc]. Je ne suis pas curieux. Je suis juste content pour toi."

# game/scripts/c25/c25.rpy:1575
translate french c25s002_KimHome_8427c55c:

    # mc "Gracias, [ama]."
    mc "Merci, [ama]."

# game/scripts/c25/c25.rpy:1580
translate french c25s002_KimHome_9b6c7699:

    # ama "Te veo mañana."
    ama "À demain."

# game/scripts/c25/c25.rpy:1581
translate french c25s002_KimHome_0b433688:

    # mc "Hasta mañana, [ama]."
    mc "À demain, [ama]."

# game/scripts/c25/c25.rpy:1583
translate french c25s002_KimHome_fd824944:

    # mc "Espera, [ama]. Se me acaba de ocurrir una idea. ¿Tienes un momento?"
    mc "Attends, [ama]. Je viens d'avoir une idée. Tu as une minute ?"

# game/scripts/c25/c25.rpy:1585
translate french c25s002_KimHome_9adc0781:

    # "Unos minutos después subes a tu habitación, pensando que, quizás, con la idea que se te ha ocurrido a última hora, quizás puedas proteger un poco a [kim]."
    "Quelques minutes plus tard, vous montez dans votre chambre, pensant que, peut-être, avec l'idée qui vous est venue à la dernière minute, vous pourriez protéger un peu [kim]."

# game/scripts/c25/c25.rpy:1586
translate french c25s002_KimHome_93ddaae3:

    # "Te desnudas y te metes en la cama. Compruebas el móvil un rato, esperando el correo electrónico que le has pedido a [ama]."
    "Vous vous déshabillez et vous vous mettez au lit. Vous consultez votre téléphone pendant un moment, en attendant l'e-mail que vous avez demandé à [ama]."

# game/scripts/c25/c25.rpy:1587
translate french c25s002_KimHome_eb780aab:

    # "Te duermes antes de que llegue."
    "Vous vous endormez avant son arrivée."

# game/scripts/c25/c25.rpy:1589
translate french c25s002_KimHome_05d11916:

    # "Te despiertas en algún momento de la noche con una sensación extraña. Como de tener algo peludo en la boca."
    "Vous vous réveillez parfois en pleine nuit avec une sensation étrange. Comme si vous aviez quelque chose de poilu dans la bouche."

# game/scripts/c25/c25.rpy:1591
translate french c25s002_KimHome_d698d57f:

    # "Hay un precioso mapa con piernas acurrucado contra tu pecho, durmiendo profundamente."
    "Il y a une magnifique carte, les jambes repliées contre votre poitrine, profondément endormie."

# game/scripts/c25/c25.rpy:1592
translate french c25s002_KimHome_d593171b:

    # "Su respiración es relajada, como si estuviera en el lugar en el que se supone que debe estar."
    "Sa respiration est détendue, comme si elle était à sa place."

# game/scripts/c25/c25.rpy:1593
translate french c25s002_KimHome_927c40a6:

    # "Te duermes inmediatamente, sin ni siquiera pensar en que estás desnudo."
    "Vous vous endormez immédiatement, sans même penser au fait que vous êtes nu(e)."

# game/scripts/c25/c25.rpy:1601
translate french c25s002_NoKimRoute_d820b3b1:

    # kim "Lo entiendo. Y también entiendo por qué no me quisiste dar una respuesta antes de que hablara con ella."
    kim "Je comprends. Et je comprends aussi pourquoi vous n'avez pas voulu me répondre avant que je lui parle."

# game/scripts/c25/c25.rpy:1602
translate french c25s002_NoKimRoute_aff10a86:

    # mc "¿Sí?"
    mc "Ouais?"

# game/scripts/c25/c25.rpy:1604
translate french c25s002_NoKimRoute_c504efb8:

    # kim "Te lo acabo de decir. Soy una cobarde. Y, al no darme una pista antes de que hablara con ella me has obligado a hacer algo que tenía miedo de hacer."
    kim "Je viens de te le dire. Je suis un lâche. Et en ne me donnant aucun indice avant que je lui parle, tu m'as forcé à faire quelque chose que je craignais de faire."

# game/scripts/c25/c25.rpy:1605
translate french c25s002_NoKimRoute_79545ceb:

    # kim "Aunque [kat] tuviera que encerrarme con ella en la cocina."
    kim "Même si je devais m'enfermer dans la cuisine avec elle."

# game/scripts/c25/c25.rpy:1607
translate french c25s002_NoKimRoute_091a3c8e:

    # kim "De alguna forma siempre nos diriges a hacer lo que necesitamos hacer. Y además haces que parezca idea nuestra."
    kim "D'une manière ou d'une autre, tu nous guides toujours vers ce que nous devons faire. Et tu arrives même à donner l'impression que c'est notre propre idée."

# game/scripts/c25/c25.rpy:1608
translate french c25s002_NoKimRoute_d30da599:

    # kim "Gracias a haberlo hecho, [mar] y yo ahora estamos más unidas. Si me hubieras dicho que no querías salir conmigo, no hubiera pasado."
    kim "Grâce à toi, [mar] et moi sommes plus proches maintenant. Si tu m'avais dit que tu ne voulais pas sortir avec moi, ça ne se serait pas fait."

# game/scripts/c25/c25.rpy:1609
translate french c25s002_NoKimRoute_afd7582e:

    # kim "No hubiéramos tenido la conversación y no nos sentiríamos como..."
    kim "Nous n'aurions pas eu cette conversation et nous n'aurions pas eu ce sentiment..."

# game/scripts/c25/c25.rpy:1610
translate french c25s002_NoKimRoute_66a145a5:

    # mc "¿Como si fuera una segunda madre?"
    mc "Comme une seconde mère ?"

# game/scripts/c25/c25.rpy:1612
translate french c25s002_NoKimRoute_243f3149:

    # kim "¿Qué? ¿Cómo lo sabes?"
    kim "Quoi ? Comment le sais-tu ?"

# game/scripts/c25/c25.rpy:1613
translate french c25s002_NoKimRoute_801d1a94:

    # mc "Porque yo pasé por algo parecido con [sam]. Conozco la sensación de sentirte unido a alguien como si fuera una segunda madre."
    mc "Parce que j'ai vécu quelque chose de similaire avec [sam]. Je connais ce sentiment d'être attachée à quelqu'un comme à une seconde mère."

# game/scripts/c25/c25.rpy:1615
translate french c25s002_NoKimRoute_76d80de5:

    # mc "O una tercera, en mi caso."
    mc "Ou une troisième, dans mon cas."

# game/scripts/c25/c25.rpy:1616
translate french c25s002_NoKimRoute_5f1dacb3:

    # mc "Pero ¿puedo serte sincero?"
    mc "Mais puis-je être honnête avec vous ?"

# game/scripts/c25/c25.rpy:1618
translate french c25s002_NoKimRoute_f5b70ec1:

    # kim "Por supuesto."
    kim "Bien sûr."

# game/scripts/c25/c25.rpy:1619
translate french c25s002_NoKimRoute_ef20ad7b:

    # mc "No lo hice para forzarte a una conversación con [mar] que te daba miedo, pero me alegro de que haya acabado así."
    mc "Je ne l'ai pas fait pour te forcer à avoir une conversation avec [mar] qui t'effrayait, mais je suis content que cela se soit terminé ainsi."

# game/scripts/c25/c25.rpy:1621
translate french c25s002_NoKimRoute_0f777387:

    # kim "Entonces no quiero saber por qué lo hiciste. Prefiero seguir creyendo mi teoría."
    kim "Alors je ne veux pas savoir pourquoi tu as fait ça. Je préfère continuer à croire à ma théorie."

# game/scripts/c25/c25.rpy:1622
translate french c25s002_NoKimRoute_9b6814d2:

    # kim "¿Podemos quedarnos abrazados un rato?"
    kim "Peut-on rester enlacés un moment ?"

# game/scripts/c25/c25.rpy:1623
translate french c25s002_NoKimRoute_94f57313:

    # mc "Tanto tiempo como quieras."
    mc "Aussi longtemps que vous le souhaitez."

# game/scripts/c25/c25.rpy:1633
translate french c25s002_NoKimSaved_5b3b09ef:

    # "Vuelves a dar la espalda a la escena que se está desarrollando en la cubierta."
    "Vous tournez à nouveau le dos à la scène qui se déroule sur le pont."

# game/scripts/c25/c25.rpy:1634
translate french c25s002_NoKimSaved_81cd69b1:

    # "No tienes ninguna intención de participar."
    "Vous n'avez aucune intention de participer."

# game/scripts/c25/c25.rpy:1636
translate french c25s002_NoKimSaved_172f8095:

    # "Un par de minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c25/c25.rpy:1637
translate french c25s002_NoKimSaved_e62085b0:

    # aga "¿Qué tiene Ichigo contra vosotros? Lo de esa chica parecía algo personal."
    aga "Qu'est-ce qu'Ichigo a contre toi ? Ce que cette fille a fait semblait être une attaque personnelle."

# game/scripts/c25/c25.rpy:1638
translate french c25s002_NoKimSaved_9ad86061:

    # mc "No es un tema personal, sino de negocios. Estaba haciendo una competición a ver quién tenía la polla más grande."
    mc "Ce n'est rien de personnel, c'est du business. On organisait un concours pour voir qui avait la plus grosse bite."

# game/scripts/c25/c25.rpy:1639
translate french c25s002_NoKimSaved_b64e7c26:

    # mc "La chica se aloja en el dormitorio universitario que es el negocio familiar e Ichigo quería demostrar que podía atacarnos por ahí."
    mc "La jeune fille loge dans la résidence universitaire qui appartient à l'entreprise familiale, et Ichigo voulait prouver qu'il pouvait nous attaquer de là."

# game/scripts/c25/c25.rpy:1641
translate french c25s002_NoKimSaved_e9ff619d:

    # aga "Ichigo siempre me ha parecido un tipo muy zafio, pero usar a una chica así es demasiado incluso para él."
    aga "J'ai toujours pensé qu'Ichigo était un type vraiment grossier, mais utiliser une fille comme ça, c'est trop même pour lui."

# game/scripts/c25/c25.rpy:1642
translate french c25s002_NoKimSaved_fe0f85c7:

    # aga "Ha tenido que aceptar la derrota temporalmente pero, si puedes, indícale a tu amiga que no salga del camarote hasta que no acabe la fiesta."
    aga "Elle a dû accepter la défaite temporairement, mais si vous le pouvez, dites à votre amie de ne pas quitter le chalet avant la fin de la fête."

# game/scripts/c25/c25.rpy:1643
translate french c25s002_NoKimSaved_ac4074df:

    # mc "Gracias, Alejandra. Lo haré."
    mc "Merci, Alejandra. Je le ferai."

# game/scripts/c25/c25.rpy:1644
translate french c25s002_NoKimSaved_bc20b7fe:

    # mc "Y gracias también por apoyarnos antes."
    mc "Et merci également de nous avoir soutenus auparavant."

# game/scripts/c25/c25.rpy:1646
translate french c25s002_NoKimSaved_3f754ca1:

    # aga "Como te he dicho, Ichigo me parece zafio y despreciable. No me gusta cómo trata a las mujeres en estas fiestas."
    aga "Comme je l'ai dit, je trouve Ichigo grossier et méprisable. Je n'apprécie pas la façon dont il traite les femmes lors de ces soirées."

# game/scripts/c25/c25.rpy:1647
translate french c25s002_NoKimSaved_16cffa4d:

    # aga "No es que me haya puesto de vuestro lado, pero me ha gustado verle mordiendo el polvo por una vez."
    aga "Ce n'est pas que j'aie pris votre parti, mais j'ai aimé le voir mordre la poussière pour une fois."

# game/scripts/c25/c25.rpy:1648
translate french c25s002_NoKimSaved_395b1468:

    # mc "De todas formas, gracias."
    mc "En tout cas, merci."

# game/scripts/c25/c25.rpy:1650
translate french c25s002_NoKimSaved_ec881d9d:

    # aga "Ahora te tengo que dejar. Tengo que seguir la conversación con nuestro amigo italiano."
    aga "Je dois y aller. Je dois poursuivre ma conversation avec notre ami italien."

# game/scripts/c25/c25.rpy:1651
translate french c25s002_NoKimSaved_fd1b3c82:

    # mc "Me gustaría llamarte algún día. Estamos reorientando el negocio y quizás México sería un buen sitio por el que comenzar."
    mc "J'aimerais vous appeler prochainement. Nous réorientons nos activités, et le Mexique serait peut-être un bon point de départ."

# game/scripts/c25/c25.rpy:1652
translate french c25s002_NoKimSaved_91231aa9:

    # aga "Perfecto. Siempre es bueno tener otras opciones para según qué trabajos."
    aga "Parfait. C'est toujours bien d'avoir d'autres options pour certains emplois."

# game/scripts/c25/c25.rpy:1654
translate french c25s002_NoKimSaved_178a7f20:

    # "Alejandra desaparece y vuelves a mirar al mar."
    "Alejandra disparaît et tu regardes une dernière fois la mer."

# game/scripts/c25/c25.rpy:1655
translate french c25s002_NoKimSaved_ebc5f5b1:

    # "Mandas un mensaje a [ama] diciéndole que no abandonen el camarote hasta que las avises."
    "Vous envoyez un message à [ama] leur disant de ne pas quitter la cabine avant que vous ne les en informiez."

# game/scripts/c25/c25.rpy:1657
translate french c25s002_NoKimSaved_103a5873:

    # "Al cabo de poco más de una hora..."
    "Après un peu plus d'une heure..."

# game/scripts/c25/c25.rpy:1659
translate french c25s002_NoKimSaved_4591ce80:

    # jef "Sr. Marks, la velada está a punto de acabar. La mayoría de los invitados van a pasar la noche en el barco. ¿Qué desean hacer usted y su acompañante?"
    jef "Monsieur Marks, la soirée touche à sa fin. La plupart des invités passeront la nuit sur le bateau. Qu'aimeriez-vous faire, vous et votre invité ?"

# game/scripts/c25/c25.rpy:1660
translate french c25s002_NoKimSaved_31a0a98a:

    # mc "Volveremos a tierra, si es posible. Y nos llevaremos a la chica del helipuerto."
    mc "Nous retournerons à terre, si possible. Et nous emmènerons avec nous la jeune fille qui se trouve sur l'héliport."

# game/scripts/c25/c25.rpy:1662
translate french c25s002_NoKimSaved_77da7b24:

    # jef "No sé si lo de la chica va a ser posible..."
    jef "Je ne sais pas si ce qui se passera avec la fille sera possible..."

# game/scripts/c25/c25.rpy:1663
translate french c25s002_NoKimSaved_8452390a:

    # mc "Hágalo posible, Sr. Sound. Por lo que sé, su contrato no incluía pasar la noche aquí."
    mc "Faites-le, Monsieur Sound. À ma connaissance, votre contrat ne prévoyait pas de passer la nuit ici."

# game/scripts/c25/c25.rpy:1664
translate french c25s002_NoKimSaved_c5721464:

    # jef "Deme un minuto para comprobarlo."
    jef "Donnez-moi une minute pour vérifier."

# game/scripts/c25/c25.rpy:1666
translate french c25s002_NoKimSaved_a7cff355:

    # "Tras comprobar algo en el móvil..."
    "Après avoir vérifié quelque chose sur mon téléphone..."

# game/scripts/c25/c25.rpy:1667
translate french c25s002_NoKimSaved_f1a9141e:

    # jef "Tiene razón. Las azafatas y las camareras vuelven a tierra en la lancha en una hora más o menos."
    jef "Vous avez raison. Les hôtesses de l'air et les serveuses regagnent la terre ferme en bateau dans environ une heure."

# game/scripts/c25/c25.rpy:1668
translate french c25s002_NoKimSaved_c17d7769:

    # mc "Pues a esa azafata nos la llevaremos nosotros en el helicóptero."
    mc "Eh bien, nous emmènerons cette hôtesse de l'air avec nous en hélicoptère."

# game/scripts/c25/c25.rpy:1669
translate french c25s002_NoKimSaved_b6955f63:

    # jef "Como desee. Avíseme cuando estén listos."
    jef "Comme vous le souhaitez. Prévenez-moi quand ils seront prêts."

# game/scripts/c25/c25.rpy:1671
translate french c25s002_NoKimSaved_05c3ce64:

    # "Avisas a [ama] de que puede salir del camarote y subís al helicóptero. Ichigo no está disponible para poder despediros de él."
    "Vous dites à [ama] qu'il peut quitter la cabine et vous montez à bord de l'hélicoptère. Ichigo n'est pas là pour lui dire au revoir."

# game/scripts/c25/c25.rpy:1675
translate french c25s002_NoKimSaved_20e5aa69:

    # "Al llegar al aparcamiento, [ama] va a por la furgoneta, dejándoos a [kim] y a ti a solas."
    "En arrivant sur le parking, [ama] va chercher la camionnette, vous laissant [kim] et vous seuls."

# game/scripts/c25/c25.rpy:1677
translate french c25s002_NoKimSaved_35fd8f7a:

    # kim "Antes de que lo preguntes, no, no sabía quiénes eran Iron Fist o que eran una empresa rival de NTR."
    kim "Avant que vous ne posiez la question, non, je ne savais pas qui était Iron Fist ni qu'il s'agissait d'une entreprise rivale de NTR."

# game/scripts/c25/c25.rpy:1678
translate french c25s002_NoKimSaved_de11a839:

    # "Está visiblemente molesta. Supones que esperaba que fueras tú quien intercediera por ella."
    "Elle est visiblement contrariée. Vous supposez qu'elle attendait de vous que vous interveniez en sa faveur."

# game/scripts/c25/c25.rpy:1679
translate french c25s002_NoKimSaved_a24eea82:

    # kim "No, no había visto las ametralladoras la última vez. Estaban tapadas con lonas."
    kim "Non, je n'avais pas vu les mitrailleuses la dernière fois. Elles étaient recouvertes de bâches."

# game/scripts/c25/c25.rpy:1680
translate french c25s002_NoKimSaved_03e927cc:

    # kim "No, no había mafiosos tampoco la última vez. Tan solo militares de uniforme. Tampoco había mujeres desnudas que yo viera."
    kim "Non, il n'y avait pas de gangsters la dernière fois non plus. Juste des soldats en uniforme. Et je n'ai vu aucune femme nue."

# game/scripts/c25/c25.rpy:1681
translate french c25s002_NoKimSaved_90ae5620:

    # mc "[kim], cálmate. Nadie te está acusando de nada."
    mc "[kim], calme-toi. Personne ne t'accuse de quoi que ce soit."

# game/scripts/c25/c25.rpy:1683
translate french c25s002_NoKimSaved_c59e65c4:

    # kim "Lo sé, pero son preguntas que [ama] me ha hecho, y es lógico que tú también quieras saber la respuesta."
    kim "Je sais, mais ce sont des questions que [ama] m'a posées, et il est tout à fait naturel que vous vouliez aussi connaître la réponse."

# game/scripts/c25/c25.rpy:1684
translate french c25s002_NoKimSaved_75df8a95:

    # kim "No soy estúpida, ¿sabes? Si hubiera sospechado algo, os lo hubiera dicho."
    kim "Je ne suis pas stupide, vous savez ? Si j'avais soupçonné quoi que ce soit, je vous l'aurais dit."

# game/scripts/c25/c25.rpy:1685
translate french c25s002_NoKimSaved_0b2f8296:

    # mc "Lo sé. Deberías..."
    mc "Je sais. Tu devrais..."

# game/scripts/c25/c25.rpy:1687
translate french c25s002_NoKimSaved_d02329f5:

    # kim "¿Qué? ¿Preguntar a la agencia cómo se llama cada cliente? ¿Informaros de quienes son esos clientes por si tienen algo que ver con vuestra empresa?"
    kim "Quoi ? Demander à l’agence le nom de chaque client ? Se renseigner sur l’identité de ces clients afin de savoir s’ils ont un lien quelconque avec votre entreprise ?"

# game/scripts/c25/c25.rpy:1688
translate french c25s002_NoKimSaved_ec65a0ac:

    # kim "No te preocupes, después de lo de hoy, lo más probable es que el Sr. Ichigo ponga alguna queja sobre mí y me despidan."
    kim "Ne vous inquiétez pas, après ce qui s'est passé aujourd'hui, M. Ichigo va très probablement porter plainte contre moi et je serai licencié."

# game/scripts/c25/c25.rpy:1689
translate french c25s002_NoKimSaved_2a8029f7:

    # mc "Si necesitas que hablemos con la agencia..."
    mc "Si vous avez besoin que nous parlions à l'agence..."

# game/scripts/c25/c25.rpy:1691
translate french c25s002_NoKimSaved_73245fad:

    # kim "¿Para qué? Vosotros no sois el cliente. Vuestra palabra no tiene ningún peso."
    kim "Pourquoi ? Parce que vous n'êtes pas le client. Votre avis n'a aucune valeur."

# game/scripts/c25/c25.rpy:1692
translate french c25s002_NoKimSaved_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c25/c25.rpy:1693
translate french c25s002_NoKimSaved_55151d95:

    # kim "Pero nada, [mc]. Lo hecho, hecho está. Por suerte, [ama] ha evitado que pasara algo peor."
    kim "Enfin bref. C'est fait, c'est fait. Heureusement, il s'est passé pire."

# game/scripts/c25/c25.rpy:1695
translate french c25s002_NoKimSaved_cf694178:

    # "En ese momento, llega [ama] con la furgoneta, interrumpiendo la conversación."
    "À ce moment-là, [ama] arrive dans la camionnette, interrompant la conversation."

# game/scripts/c25/c25.rpy:1697
translate french c25s002_NoKimSaved_9594b755:

    # "El viaje a casa se produce en silencio, ninguna de las dos chicas tiene ganas de hablar."
    "Le trajet du retour se déroule en silence ; aucune des deux filles n'a envie de parler."

# game/scripts/c25/c25.rpy:1699
translate french c25s002_NoKimSaved_d6744449:

    # "Al llegar a casa..."
    "Quand je suis rentré chez moi..."

# game/scripts/c25/c25.rpy:1700
translate french c25s002_NoKimSaved_3a8e380f:

    # kim "Gracias por lo que has hecho en el barco, [ama]."
    kim "Merci pour ce que vous avez fait sur le bateau, [ama]."

# game/scripts/c25/c25.rpy:1701
translate french c25s002_NoKimSaved_595a33f1:

    # ama "No tienes por qué agradecérmelo, [kim]. La familia nos tenemos que cuidar."
    ama "Tu n'as pas à me remercier, [kim]. Nous devons prendre soin les uns des autres comme une famille."

# game/scripts/c25/c25.rpy:1702
translate french c25s002_NoKimSaved_434018f0:

    # kim "Sí, la familia..."
    kim "Oui, la famille..."

# game/scripts/c25/c25.rpy:1703
translate french c25s002_NoKimSaved_cc17993b:

    # ama "Sube a dormir y cálmate. Mañana lo verás todo con otros ojos."
    ama "Monte te coucher et calme-toi. Demain, tu verras tout différemment."

# game/scripts/c25/c25.rpy:1705
translate french c25s002_NoKimSaved_4fe3dae7:

    # kim "Hasta mañana, [mc]."
    kim "À demain, [mc]."

# game/scripts/c25/c25.rpy:1706
translate french c25s002_NoKimSaved_a004f610:

    # mc "Hasta mañana, [kim]. Duerme bien."
    mc "À demain, [kim]. Dors bien."

# game/scripts/c25/c25.rpy:1708
translate french c25s002_NoKimSaved_41a4f5ec:

    # "[kim] se mete en casa sin mirar atrás o decir nada más."
    "[kim] entre dans la maison sans se retourner ni dire quoi que ce soit d'autre."

# game/scripts/c25/c25.rpy:1710
translate french c25s002_NoKimSaved_dec77af6:

    # ama "No se lo tengas en cuenta. Está nerviosa y asustada por lo que ha estado a punto de pasarle."
    ama "Ne lui en tenez pas rigueur. Elle est nerveuse et effrayée par ce qui a failli lui arriver."

# game/scripts/c25/c25.rpy:1711
translate french c25s002_NoKimSaved_33bb8981:

    # mc "Y decepcionada porque no he sido yo quién ha intervenido, ¿no?"
    mc "Et déçue parce que ce n'est pas moi qui suis intervenue, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1714
translate french c25s002_NoKimSaved_4fe67dcd:

    # ama "Creo que sí. Has actuado como el caballero de brillante armadura con varias de las chicas y, cuando ella lo ha necesitado, he tenido que hacerlo yo."
    ama "Je le crois. Tu as joué les chevaliers servants avec plusieurs filles, et quand elle en a eu besoin, j'ai dû intervenir."

# game/scripts/c25/c25.rpy:1716
translate french c25s002_NoKimSaved_758b0092:

    # ama "Hasta cierto punto. Creo que no esperaba que hicieras lo que he hecho yo, pero tampoco que te quedaras impasible."
    ama "Dans une certaine mesure. Je ne m'attendais pas à ce que vous fassiez comme moi, mais je ne m'attendais pas non plus à ce que vous restiez insensibles."

# game/scripts/c25/c25.rpy:1717
translate french c25s002_NoKimSaved_c7df31f0:

    # mc "Tienes razón. No he sabido reaccionar, y cuando he podido hacerlo, tú ya lo habías resuelto."
    mc "Vous avez raison. Je ne savais pas comment réagir, et quand j'ai pu le faire, vous aviez déjà trouvé la solution."

# game/scripts/c25/c25.rpy:1718
translate french c25s002_NoKimSaved_d2a26170:

    # ama "Al menos has soltado el discurso sobre la forma de hacer negocios de Iron Fist. Eso y lo que ha dicho Alejandra me han permitido sacarla de ahí."
    ama "Au moins, tu as réussi à prononcer ce discours sur les pratiques commerciales d'Iron Fist. Ça, et ce qu'a dit Alejandra, m'ont permis de la faire sortir de là."

# game/scripts/c25/c25.rpy:1719
translate french c25s002_NoKimSaved_914868ee:

    # mc "Es poco consuelo, pero al menos todo ha acabado bien... o no tan mal como podía haberlo hecho."
    mc "C'est une maigre consolation, mais au moins tout s'est bien terminé... ou du moins pas aussi mal que ça aurait pu l'être."

# game/scripts/c25/c25.rpy:1724
translate french c25s002_NoKimSaved_add4614b:

    # ama "No le des más vueltas. En cuanto tenga tiempo de pensar, se le pasará la decepción que tiene contigo ahora mismo. No siempre puedes hacerlo todo bien."
    ama "N'y pense pas trop. Dès qu'elle aura eu le temps de réfléchir, elle se remettra de sa déception. On ne peut pas toujours être parfait."

# game/scripts/c25/c25.rpy:1725
translate french c25s002_NoKimSaved_1c354712:

    # ama "Hasta mañana, [mc]."
    ama "À demain, [mc]."

# game/scripts/c25/c25.rpy:1726
translate french c25s002_NoKimSaved_0b433688:

    # mc "Hasta mañana, [ama]."
    mc "À demain, [ama]."

# game/scripts/c25/c25.rpy:1728
translate french c25s002_NoKimSaved_fd824944:

    # mc "Espera, [ama]. Se me acaba de ocurrir una idea. ¿Tienes un momento?"
    mc "Attends, [ama]. Je viens d'avoir une idée. Tu as une minute ?"

# game/scripts/c25/c25.rpy:1730
translate french c25s002_NoKimSaved_a7a75903:

    # "Unos minutos después subes a tu habitación, pensando que, quizás, podrías haber hecho las cosas de otra forma en el barco."
    "Quelques minutes plus tard, vous montez dans votre cabine, en pensant que, peut-être, vous auriez pu faire les choses différemment sur le bateau."

# game/scripts/c25/c25.rpy:1732
translate french c25s002_NoKimSaved_52e6c759:

    # "Al menos con la idea que se te ha ocurrido a última hora, quizás puedas proteger un poco a [kim]."
    "Au moins, avec l'idée que tu as eue à la dernière minute, tu pourras peut-être protéger un peu [kim]."

# game/scripts/c25/c25.rpy:1737
translate french c25s003_HeloTrip_d0ea0e8a:

    # "Sin que os deis cuenta, pasa el tiempo, hasta que suena tu móvil de nuevo. [ama] te indica que ya podéis salir de vuestro refugio."
    "Sans que vous vous en rendiez compte, le temps passe, jusqu'à ce que votre téléphone sonne à nouveau. [ama] vous annonce que vous pouvez désormais quitter votre abri."

# game/scripts/c25/c25.rpy:1740
translate french c25s003_HeloTrip_70487c49:

    # "Subís a cubierta y al helicóptero. Ichigo no está disponible para poder despediros de él."
    "Vous montez sur le pont puis dans l'hélicoptère. Ichigo n'est pas là pour que vous puissiez lui dire au revoir."

# game/scripts/c25/c25.rpy:1741
translate french c25s003_HeloTrip_ae60eadf:

    # "Crees que es lo mejor."
    "Vous pensez que c'est pour le mieux."

# game/scripts/c25/c25.rpy:1742
translate french c25s003_HeloTrip_ca7fff4d:

    # "El viaje en helicóptero pasa sin nada reseñable y os vuelve a dejar en el aparcamiento de la galería de tiro."
    "Le trajet en hélicoptère se déroule sans incident et vous dépose sur le parking du stand de tir."

# game/scripts/c25/c25.rpy:1749
translate french c25s003_MyResidence_2f324e16:

    # centered "{size=+20}{b}DÍA 27 – DOMINGO{/b}{/size}"
    centered "{size=+20}{b}JOUR 27 – DIMANCHE{/b}{/size}"

# game/scripts/c25/c25.rpy:1751
translate french c25s003_MyResidence_f42af20d:

    # "Te despiertas antes de lo habitual y bajas a desayunar. [kim] ha desaparecido."
    "Vous vous réveillez plus tôt que d'habitude et descendez prendre votre petit-déjeuner. [kim] a disparu."

# game/scripts/c25/c25.rpy:1753
translate french c25s003_MyResidence_ed803360:

    # "Te despiertas antes de lo habitual y bajas a desayunar."
    "Vous vous réveillez plus tôt que d'habitude et descendez prendre votre petit-déjeuner."

# game/scripts/c25/c25.rpy:1754
translate french c25s003_MyResidence_9b6c0794:

    # "Te estás muriendo de hambre. No cenaste en el barco y no tenías hambre al llegar a casa."
    "Tu meurs de faim. Tu n'as pas dîné sur le bateau et tu n'avais pas faim en rentrant chez toi."

# game/scripts/c25/c25.rpy:1757
translate french c25s003_MyResidence_afc87665:

    # "Al pasar por la planta de las estudiantes, ves a [deb.nick] con su portátil."
    "En passant devant l'étage des étudiants, vous voyez [deb.nick] avec son ordinateur portable."

# game/scripts/c25/c25.rpy:1758
translate french c25s003_MyResidence_766a1ec7:

    # mc "Buenos días, [deb.nick]. ¿Esperando a las chicas para hacer yoga? ¿O vas a salir a correr?"
    mc "Bonjour, [deb.nick]. Tu attends que les filles fassent leur yoga ? Ou tu vas courir ?"

# game/scripts/c25/c25.rpy:1759
translate french c25s003_MyResidence_cd593736:

    # deb "Buenos días, [mc]. Iba a hacer yoga, pero me he entretenido con un juego. Lo dejaré para otro día."
    deb "Bonjour, [mc]. Je comptais faire du yoga, mais j'ai été distrait par un jeu. Je le ferai un autre jour."

# game/scripts/c25/c25.rpy:1761
translate french c25s003_MyResidence_c0eddb25:

    # mc "¿Alguna novela visual nueva?"
    mc "Des nouveautés en matière de romans visuels ?"

# game/scripts/c25/c25.rpy:1763
translate french c25s003_MyResidence_014d448b:

    # deb "No, no he tenido tiempo de mirar ninguna más aparte de My Residence. Un día me tienes que recomendar alguna que no haya jugado."
    deb "Non, je n'ai pas eu le temps d'en regarder d'autres que My Residence. Il faudra que vous m'en recommandiez un auquel je n'ai pas encore joué."

# game/scripts/c25/c25.rpy:1764
translate french c25s003_MyResidence_5974e48e:

    # mc "He jugado a varias muy buenas. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner... y óbviamente My Residence."
    mc "J'ai joué à plusieurs jeux vraiment excellents : Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner… et bien sûr My Residence."

# game/scripts/c25/c25.rpy:1767
translate french c25s003_MyResidence_be8269ab:

    # deb "Es una novela visual que estoy jugando..."
    deb "C'est un roman visuel auquel je joue..."

# game/scripts/c25/c25.rpy:1768
translate french c25s003_MyResidence_372ed14c:

    # mc "¿Una novela visual japonesa u occidental?"
    mc "Un roman visuel japonais ou occidental ?"

# game/scripts/c25/c25.rpy:1770
translate french c25s003_MyResidence_c5619880:

    # deb "Occidental, para adultos..."
    deb "Western, pour adultes..."

# game/scripts/c25/c25.rpy:1771
translate french c25s003_MyResidence_8b0b7420:

    # mc "¡[deb.nick]! ¡Me sorprendes!"
    mc "Waouh ! Tu me surprends !"

# game/scripts/c25/c25.rpy:1773
translate french c25s003_MyResidence_be0d43fe:

    # deb "¿Qué pasa? ¡No hay nada de lo que avergonzarse!"
    deb "Qu'y a-t-il de mal ? Il n'y a pas de quoi avoir honte !"

# game/scripts/c25/c25.rpy:1774
translate french c25s003_MyResidence_40adb682:

    # mc "*Risa* Estoy de acuerdo. Yo también juego a novelas visuales."
    mc "*Rires* Je suis d'accord. Je joue aussi à des romans visuels."

# game/scripts/c25/c25.rpy:1776
translate french c25s003_MyResidence_73abaeb1:

    # deb "¿De verdad? ¿A cuáles juegas?"
    deb "Vraiment ? À quels jeux joues-tu ?"

# game/scripts/c25/c25.rpy:1777
translate french c25s003_MyResidence_179551d1:

    # mc "He jugado a varias. Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner, My Residence..."
    mc "J'en ai joué à plusieurs : Princess on the Fly, Origin Tale, The Awesome Game, Puddles of Astrum, Basking All-Out, The Diner, My Residence…"

# game/scripts/c25/c25.rpy:1779
translate french c25s003_MyResidence_8979c922:

    # deb "¿My Residence? Es precisamente la que estoy jugando ahora."
    deb "Ma Résidence ? C'est précisément celle à laquelle je joue en ce moment."

# game/scripts/c25/c25.rpy:1781
translate french c25s003_MyResidence_7a0e404f:

    # deb "¿Te enteraste de que algún hijo de puta filtró la última actualización de My Residence?"
    deb "Tu as entendu dire qu'un fils de pute a fait fuiter la dernière mise à jour de Ma Résidence ?"

# game/scripts/c25/c25.rpy:1782
translate french c25s003_MyResidence_00920cd5:

    # mc "Sí. ¿Ha hecho Clichecita algún otro post mandando a tomar por culo al filtrador? No me importa si me haces algún spoiler."
    mc "Oui. Clichecita a-t-il publié d'autres messages envoyant balader la personne qui a divulgué l'information ? Un spoiler ne me dérange pas."

# game/scripts/c25/c25.rpy:1783
translate french c25s003_MyResidence_8bb6a13b:

    # mc "Me gustó que casi toda la comunidad le apoyásemos. Tanto los que somos suscriptores como los que no lo son. Menos el hijo de puta, claro."
    mc "J'ai apprécié que la quasi-totalité de la communauté le soutienne. Abonnés et non-abonnés. Sauf ce salaud, bien sûr."

# game/scripts/c25/c25.rpy:1785
translate french c25s003_MyResidence_cada3249:

    # deb "¡Ha hecho algo mucho mejor! *Risa* Ha mandado a Vee y a Mandy, las espías, en una misión para acabar con filtradores de juegos y moderadores fascistas de foros."
    deb "Il a fait bien mieux ! *Rires* Il a envoyé Vee et Mandy, les espionnes, en mission pour neutraliser les fuites de jeux et les modérateurs de forums fascistes."

# game/scripts/c25/c25.rpy:1786
translate french c25s003_MyResidence_bff44c1f:

    # mc "*Risa* Ese tío se va a meter en problemas algún día, lo van a banear de todos los foros. Pero es gracioso que haga cosas así. ¿Tienes alguna imagen?"
    mc "*Rires* Ce type va finir par avoir des ennuis, il va se faire bannir de tous les forums. Mais c'est marrant qu'il fasse des trucs pareils. Tu as des photos ?"

# game/scripts/c25/c25.rpy:1788
translate french c25s003_MyResidence_3c8d18db:

    # deb "Sí, déjame mirar en la galería un momento."
    deb "Oui, laissez-moi jeter un coup d'œil à la galerie un instant."

# game/scripts/c25/c25.rpy:1790
translate french c25s003_MyResidence_60877694:

    # deb "Mira, aquí es cuando ya han acabado con él."
    deb "Regardez, c'est à ce moment-là qu'ils l'ont déjà achevé."

# game/scripts/c25/c25.rpy:1791
translate french c25s003_MyResidence_fc1c22b9:

    # mc "*Risa* ¡Qué graciosa es Mandy diciendo 'Un criminal menos en el mundo.' después de matar al filtrador!"
    mc "*Rires* C'est tellement drôle, Mandy qui dit « Un criminel de moins dans le monde » après avoir tué la source de la fuite !"

# game/scripts/c25/c25.rpy:1792
translate french c25s003_MyResidence_6ff25640:

    # mc "Y Vee diciendo 'Ahora, a por los moderadores fascistas'. Dan miedo."
    mc "Et Vee qui dit : « Maintenant, attaquons-nous aux modérateurs fascistes. » Ils sont effrayants."

# game/scripts/c25/c25.rpy:1793
translate french c25s003_MyResidence_ad1e5397:

    # deb "*Risa* A mí me han hecho reír las pantallas y el cartel: 'El sótano de mi madre es mi castillo' y '¿Por qué no puedo encontrar mi culo con dos manos y una linterna'"
    deb "*Rires* J'ai trouvé les écrans et le panneau qui m'ont fait rire : « Le sous-sol de ma mère est mon château » et « Pourquoi est-ce que je ne peux pas retrouver mes fesses avec deux mains et une lampe de poche ? »"

# game/scripts/c25/c25.rpy:1794
translate french c25s003_MyResidence_082d43cd:

    # mc "*Risa* Libro 1. Supongo que los filtradores necesitan instrucciones para eso."
    mc "*Rires* Livre 1. J'imagine que les filtres ont besoin d'instructions pour ça."

# game/scripts/c25/c25.rpy:1795
translate french c25s003_MyResidence_9e65cbbd:

    # mc "*Risa* ¡Espera! ¿Eso es un consolador?"
    mc "*Rires* Attendez ! C'est un vibromasseur ?"

# game/scripts/c25/c25.rpy:1797
translate french c25s003_MyResidence_81deed43:

    # deb "Sí, y el papel higiénico al lado. Supongo que ha tirado de... clichés sobre perdedores. O tropes. *Risa*"
    deb "Oui, et le papier toilette à côté. J'imagine qu'il a sorti… des clichés sur les losers. Ou des stéréotypes. *Rires*"

# game/scripts/c25/c25.rpy:1798
translate french c25s003_MyResidence_2ddc50f3:

    # mc "Lo que me gusta es que ninguna de las dos parece contenta. Como diciendo 'Es algo que había que hacer, no por ello nos gusta.'"
    mc "Ce que j'aime, c'est que ni l'un ni l'autre ne semble heureux. Comme pour dire : « C'était nécessaire, mais ça ne veut pas dire que ça nous plaît. »"

# game/scripts/c25/c25.rpy:1800
translate french c25s003_MyResidence_bc8c2e8a:

    # deb "Exactamente eso. Te va a parecer gracioso, pero Vee y Mandy me recuerdan en cierta forma a [eva] y [ama]."
    deb "Exactement. Ça va vous faire rire, mais Vee et Mandy me font un peu penser à [eva] et [ama]."

# game/scripts/c25/c25.rpy:1801
translate french c25s003_MyResidence_be2df33f:

    # mc "¡Qué va! [ama] y [eva] son mucho más tiernas. Vee y Mandy son mucho más despiadadas."
    mc "Absolument pas ! [ama] et [eva] sont bien plus mignonnes. Vee et Mandy sont bien plus impitoyables."

# game/scripts/c25/c25.rpy:1802
translate french c25s003_MyResidence_d9a3b146:

    # mc "¿Has desayunado ya?"
    mc "Avez-vous déjà pris votre petit-déjeuner ?"

# game/scripts/c25/c25.rpy:1804
translate french c25s003_MyResidence_461b7954:

    # deb "Sí, hace un rato. No quería hacer yoga con el estómago vacío, y al final me he quedado jugando."
    deb "Oui, il y a quelque temps. Je n'avais pas envie de faire du yoga l'estomac vide, alors finalement je suis restée et j'ai joué."

# game/scripts/c25/c25.rpy:1805
translate french c25s003_MyResidence_acd05f45:

    # mc "Pues te dejo jugando y voy a desayunar."
    mc "Bon, je vous laisse jouer et je vais prendre votre petit-déjeuner."

# game/scripts/c25/c25.rpy:1808
translate french c25s003_MyResidence_77e0e675:

    # "Das un beso a la hermosa sirena, intentando no tirar el portátil."
    "Vous embrassez la belle sirène en essayant de ne pas laisser tomber l'ordinateur portable."

# game/scripts/c25/c25.rpy:1810
translate french c25s003_MyResidence_bc8b5b8c:

    # mc "Te veo luego. Me muero de hambre."
    mc "À plus tard. Je meurs de faim."

# game/scripts/c25/c25.rpy:1812
translate french c25s003_MyResidence_1f1f5279:

    # deb "Hasta luego, [mc]."
    deb "À plus tard, [mc]."

# game/scripts/c25/c25.rpy:1832
translate french c25s003_Yoga_482a03e9:

    # "Al entrar en la cocina te invade el olor de croissants recién hechos."
    "En entrant dans la cuisine, vous êtes enveloppé par l'odeur des croissants fraîchement sortis du four."

# game/scripts/c25/c25.rpy:1834
translate french c25s003_Yoga_f080aca5:

    # "No puedes resistirte y, después de preparar un café, comes un par."
    "Vous ne pouvez pas résister et, après avoir préparé un café, vous en mangez deux ou trois."

# game/scripts/c25/c25.rpy:1836
translate french c25s003_Yoga_6a39a92d:

    # "Mientras te tomas el café, te asomas a la ventana."
    "Pendant que vous prenez votre café, vous regardez par la fenêtre."

# game/scripts/c25/c25.rpy:1837
translate french c25s003_Yoga_aca5b583:

    # "Recuerdas que [kia] dijo que un montón de chicas se apuntarían a la sesión de yoga de hoy."
    "Vous vous souvenez que [kia] avait dit que beaucoup de filles s'inscriraient à la séance de yoga d'aujourd'hui."

# game/scripts/c25/c25.rpy:1838
translate french c25s003_Yoga_92d27e8d:

    # "A este paso vais a tener que ampliar la piscina."
    "À ce rythme, vous allez devoir agrandir la piscine."

# game/scripts/c25/c25.rpy:1839
translate french c25s003_Yoga_795f6dcc:

    # "Decides bajar a saludar y acabarte el café en la piscina. Estando todas juntas, va a ser más eficiente."
    "Vous décidez de descendre dire bonjour et de finir votre café au bord de la piscine. Être tous ensemble facilitera les choses."

# game/scripts/c25/c25.rpy:1841
translate french c25s003_Yoga_0f266157:

    # mc "Buenos días, chicas. Hace un día genial para veros hacer yoga sin unirme. *Risa*"
    mc "Bonjour mesdames. C'est une journée idéale pour vous regarder faire du yoga sans y participer. *Rires*"

# game/scripts/c25/c25.rpy:1842
translate french c25s003_Yoga_08dc160d:

    # mcp "(No tengo intención de volver a ponerme las mallas de Tío Mike en mi vida.)"
    mcp "(Je n'ai aucune intention de porter à nouveau des collants Uncle Mike's de toute ma vie.)"

# game/scripts/c25/c25.rpy:1844
translate french c25s003_Yoga_0b288a70:

    # "Sin interrumpir sus ejercicios ni decir nada, todas te dedican una sonrisa."
    "Sans interrompre leurs exercices ni dire un mot, ils vous sourient tous."

# game/scripts/c25/c25.rpy:1845
translate french c25s003_Yoga_6cb7a019:

    # "Una preciosa imagen para empezar el día. Como has pensado, mucho más eficiente."
    "Une belle image pour commencer la journée. Comme vous le pensiez, bien plus efficace."

# game/scripts/c25/c25.rpy:1846
translate french c25s003_Yoga_5d07fb2b:

    # kat "Me estás tapando las vistas, [mc]."
    kat "Tu me bloques la vue, [mc]."

# game/scripts/c25/c25.rpy:1848
translate french c25s003_Yoga_84a3d87d:

    # mc "¡Oh, [kat]! Perdona, no te había visto."
    mc "Oh, [kat] ! Désolé, je ne vous avais pas vu."

# game/scripts/c25/c25.rpy:1849
translate french c25s003_Yoga_019b7d21:

    # kat "*Risa* Lo difícil es no verme con lo que abulto, pero te entiendo. Es difícil apartar los ojos de esas trece mujeres."
    kat "*Rires* Le plus dur, c'est de ne pas voir à quel point je suis imposant, mais je comprends. Difficile de détacher son regard de ces treize femmes."

# game/scripts/c25/c25.rpy:1850
translate french c25s003_Yoga_ce27227c:

    # mc "*Risa* No las había contado."
    mc "*Rires* Je ne les avais pas comptés."

# game/scripts/c25/c25.rpy:1852
translate french c25s003_Yoga_c7194c7b:

    # kat "*Risa* Bueno, aparte de mirar, no he tenido mucho que hacer en los últimos 10 minutos."
    kat "*Rires* Eh bien, à part regarder, je n'ai pas eu grand-chose à faire ces 10 dernières minutes."

# game/scripts/c25/c25.rpy:1853
translate french c25s003_Yoga_6d4db9af:

    # kat "Y si no sales de en medio, no voy a poder seguir mirando."
    kat "Et si vous ne vous écartez pas, je ne pourrai plus regarder."

# game/scripts/c25/c25.rpy:1855
translate french c25s003_Yoga_70d56761:

    # kat "{i}(¡Deja de mirar, [kat]! ¡Céntrate! Ni te va a mirar con el espectáculo que hay detrás suyo.){/i}"
    kat "{i}(Arrête de le fixer, [kat] ! Concentre-toi ! Il ne va pas te regarder avec le spectacle derrière lui.){/i}"

# game/scripts/c25/c25.rpy:1857
translate french c25s003_Yoga_e8b4c525:

    # mc "¿Estoy bien aquí? ¿No te tapo las vistas ahora?"
    mc "Je suis bien placée ? Est-ce que je vous gêne la vue ?"

# game/scripts/c25/c25.rpy:1858
translate french c25s003_Yoga_538eee44:

    # kat "Sí, ahí estás bien."
    kat "Oui, vous avez tout à fait raison."

# game/scripts/c25/c25.rpy:1859
translate french c25s003_Yoga_7c72c85d:

    # kat "Además, justo a tiempo para el cambio de postura."
    kat "De plus, juste à temps pour le changement de position."

# game/scripts/c25/c25.rpy:1861
translate french c25s003_Yoga_416ed5b5:

    # mc "Casi parece que estén haciendo una coreografía, ¿no?"
    mc "On dirait presque qu'ils exécutent une chorégraphie, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1862
translate french c25s003_Yoga_0de4beb4:

    # kat "Todas siguen lo que hace [nor]. Y quien no puede, sigue a [sai], que también conoce todos los movimientos."
    kat "Ils imitent tous ce que fait [nor]. Et ceux qui ne le peuvent pas, imitent [sai], qui connaît également tous les coups."

# game/scripts/c25/c25.rpy:1863
translate french c25s003_Yoga_36157d72:

    # mc "*Risa* Veo que lo tienes todo estudiado."
    mc "*Rires* Je vois que vous avez tout compris."

# game/scripts/c25/c25.rpy:1865
translate french c25s003_Yoga_1a6e8f52:

    # kat "*Risa* Bajar a desayunar aquí es una de las mejores vistas de la casa."
    kat "*Rires* Descendre ici pour prendre le petit-déjeuner offre l'une des plus belles vues de la maison."

# game/scripts/c25/c25.rpy:1866
translate french c25s003_Yoga_29ca9c16:

    # mc "*Risa* No voy a decir lo contrario. ¿Bajas muy a menudo?"
    mc "*Rires* Je ne vais pas le nier. Vous y allez souvent ?"

# game/scripts/c25/c25.rpy:1867
translate french c25s003_Yoga_24988b39:

    # kat "No bajo todos los días. Cuando tengo clase a primera hora es complicado."
    kat "Je n'y vais pas tous les jours. Quand j'ai cours tôt le matin, c'est difficile."

# game/scripts/c25/c25.rpy:1868
translate french c25s003_Yoga_29c85ce7:

    # mc "Entiendo. ¿Tienes algún plan para hoy?"
    mc "Je comprends. Avez-vous des projets pour aujourd'hui ?"

# game/scripts/c25/c25.rpy:1870
translate french c25s003_Yoga_f122de9b:

    # kat "*Risa* NO ir a correr al lago es el primer plan. Hoy es mi día de descanso sin ejercicio."
    kat "*Rires* Au programme : pas de jogging au bord du lac. Aujourd'hui, c'est jour de repos, pas de sport."

# game/scripts/c25/c25.rpy:1871
translate french c25s003_Yoga_fe06ee76:

    # kat "El segundo era bajar aquí a ver a las chicas haciendo yoga. [eil], [oma], y [kia] no se apuntan nunca, y [sam] solo es la segunda vez que viene."
    kat "La deuxième raison était de venir ici pour regarder les filles faire du yoga. [eil], [oma] et [kia] ne s'inscrivent jamais, et [sam] ne vient que pour la deuxième fois."

# game/scripts/c25/c25.rpy:1872
translate french c25s003_Yoga_58f7fbd7:

    # kat "No podía perdérmelo."
    kat "Je ne pouvais pas rater ça."

# game/scripts/c25/c25.rpy:1873
translate french c25s003_Yoga_87bf4a62:

    # mc "¿Y más allá de ver chicas en leggins?"
    mc "Et au-delà du simple fait de voir des filles en leggings ?"

# game/scripts/c25/c25.rpy:1875
translate french c25s003_Yoga_0652bea0:

    # kat "*Risa* Más allá no he pensado nada."
    kat "*Rires* Je n'ai pensé à rien d'autre."

# game/scripts/c25/c25.rpy:1876
translate french c25s003_Yoga_38dfc874:

    # kat "Supongo que estudiar un rato, leer, y hacer el vago hasta la hora de comer."
    kat "Je suppose que je vais étudier un peu, lire et paresser jusqu'à midi."

# game/scripts/c25/c25.rpy:1877
translate french c25s003_Yoga_ca3709f4:

    # mc "*Risa* Es un plan perfecto para un domingo."
    mc "*Rires* C'est le plan parfait pour un dimanche."

# game/scripts/c25/c25.rpy:1879
translate french c25s003_Yoga_cbcfa4c4:

    # kat "¡Oh, por el amor de Dios! Adoro esa postura. No sería capaz de hacerla aunque me pagaran por ello."
    kat "Oh, mon Dieu ! J'adore cette pose. Je serais incapable de la faire même si on me payait."

# game/scripts/c25/c25.rpy:1880
translate french c25s003_Yoga_89a73eb7:

    # mc "*Risa* Yo tampoco. ¿Entiendes ahora por qué no me apunto a las sesiones de yoga?"
    mc "*Rires* Moi non plus. Vous comprenez maintenant pourquoi je ne m'inscris pas à des cours de yoga ?"

# game/scripts/c25/c25.rpy:1882
translate french c25s003_Yoga_a49cb0dd:

    # kat "Visto que compartimos gustos por las vistas... ¿por qué no quedamos para desayunar juntos alguna mañana?"
    kat "Puisque nous partageons une passion pour les beaux paysages… pourquoi ne pas nous retrouver pour prendre le petit-déjeuner ensemble un matin ?"

# game/scripts/c25/c25.rpy:1884
translate french c25s003_Yoga_8cfc6c8d:

    # kat "{i}(¡Mierda, [kat]! ¡Eso ha sonado como si le pidieras una cita! ¿Dónde has dejado tu cerebro hoy?){/i}"
    kat "{i}(Mince alors, [kat] ! On dirait que tu l'invites à sortir ! Où as-tu laissé ton cerveau aujourd'hui ?){/i}"

# game/scripts/c25/c25.rpy:1885
translate french c25s003_Yoga_dd0bb5a2:

    # mc "No te puedo asegurar nada, pero me parece una idea genial."
    mc "Je ne peux rien garantir, mais je pense que c'est une excellente idée."

# game/scripts/c25/c25.rpy:1887
translate french c25s003_Yoga_ce86d6b6:

    # kat "{i}(¿Ha dicho que sí? ¿No podría haberse negado y así dejarme las cosas claras?){/i}"
    kat "{i}(A-t-il dit oui ? N'aurait-il pas pu refuser et me dire les choses clairement ?){/i}"

# game/scripts/c25/c25.rpy:1888
translate french c25s003_Yoga_6901a23b:

    # mcp "(¿De qué se sorprende? ¿No quiere que desayunemos juntos? ¿Por qué lo ha propuesto?)"
    mcp "(Qu'y a-t-il de si surprenant à cela ? Ne veut-il pas que nous prenions le petit-déjeuner ensemble ? Pourquoi a-t-il suggéré cela ?)"

# game/scripts/c25/c25.rpy:1890
translate french c25s003_Yoga_5ca9b544:

    # "Suena tu móvil. Es el correo de [ama] con la información que le pediste anoche."
    "Votre téléphone portable sonne. C'est un courriel de [ama] contenant les informations que vous avez demandées hier soir."

# game/scripts/c25/c25.rpy:1891
translate french c25s003_Yoga_1b980033:

    # mc "Dame un momento, tengo que leer un correo."
    mc "Donnez-moi un instant, je dois lire un courriel."

# game/scripts/c25/c25.rpy:1893
translate french c25s003_Yoga_336253eb:

    # kat "{i}(¡Joder, [mc]! ¿Lo puedes poner más difícil?){/i}"
    kat "{i}(Mince alors, [mc] ! Tu peux rendre ça plus difficile ?){/i}"

# game/scripts/c25/c25.rpy:1895
translate french c25s003_Yoga_81b1d609:

    # mc "[kat], te tengo que dejar. Tengo que hacer una llamada."
    mc "[kat], je dois y aller. Je dois passer un coup de fil."

# game/scripts/c25/c25.rpy:1896
translate french c25s003_Yoga_b00c8c74:

    # kat "No te preocupes, aunque te vas a perder las últimas posturas."
    kat "Ne t'inquiète pas, même si tu rates les dernières places."

# game/scripts/c25/c25.rpy:1897
translate french c25s003_Yoga_1eb34e55:

    # mc "*Risa* Las veré el día que desayunemos juntos. Cuento contigo como comentarista."
    mc "*Rires* Je les verrai le jour où nous prendrons le petit-déjeuner ensemble. Je compte sur toi comme commentateur."

# game/scripts/c25/c25.rpy:1899
translate french c25s003_Yoga_8443039f:

    # mc "¿Puedes dejar mi taza en tu bandeja, por favor?"
    mc "Pourriez-vous poser ma tasse sur votre plateau, s'il vous plaît ?"

# game/scripts/c25/c25.rpy:1902
translate french c25s003_Yoga_53041b4b:

    # "Te mueves a la puerta del garaje para llamar a Sound. Intentas mantener un tono amigable."
    "Vous vous dirigez vers la porte du garage pour appeler Sound. Vous essayez de garder un ton amical."

# game/scripts/c25/c25.rpy:1903
translate french c25s003_Yoga_28e9ff02:

    # mc "Buenos días, Jeff. Soy [mc] Marks. Espero no molestarte tan temprano."
    mc "Bonjour Jeff. C'est Marks. J'espère que je ne vous dérange pas si tôt."

# game/scripts/c25/c25.rpy:1904
translate french c25s003_Yoga_d7153acc:

    # jef "Buenos días, Sr. Marks. No se preocupe. ¿En qué puedo ayudarle?"
    jef "Bonjour, Monsieur Marks. Ne vous inquiétez pas. Comment puis-je vous aider ?"

# game/scripts/c25/c25.rpy:1906
translate french c25s003_Yoga_3a6c962e:

    # mc "Te llamaba por lo que pasó ayer en el barco. Con la chica..."
    mc "Je vous appelais au sujet de ce qui s'est passé hier sur le bateau. Avec la fille..."

# game/scripts/c25/c25.rpy:1907
translate french c25s003_Yoga_13de4800:

    # jef "¿De qué quería hablar sobre ese tema?"
    jef "De quoi voulais-je parler concernant ce sujet ?"

# game/scripts/c25/c25.rpy:1908
translate french c25s003_Yoga_a7fb9abd:

    # mc "No sé lo que Ichigo tiene planeado con ella, pero no la vais a volver a contratar."
    mc "Je ne sais pas ce qu'Ichigo lui réserve, mais vous ne la réembaucherez pas."

# game/scripts/c25/c25.rpy:1909
translate french c25s003_Yoga_ab9b3eec:

    # jef "Perdone, Sr. Marks, pero no está en posición de decir quién puede o no puede contratar Iron Fist."
    jef "Excusez-moi, Monsieur Marks, mais vous n'êtes pas en mesure de dire qui peut ou ne peut pas engager Iron Fist."

# game/scripts/c25/c25.rpy:1911
translate french c25s003_Yoga_4603a574:

    # "El tono amigable desaparece de tu voz."
    "Le ton amical disparaît de votre voix."

# game/scripts/c25/c25.rpy:1912
translate french c25s003_Yoga_52a371b3:

    # mc "Tiene razón. No puedo decirles a quién tienen que contratar."
    mc "Vous avez raison. Je ne peux pas leur dire qui embaucher."

# game/scripts/c25/c25.rpy:1913
translate french c25s003_Yoga_ec357799:

    # mc "Pero puedo revisar todos los contratos que nuestra división de Apoyo tiene con Iron Fist. Mis antecesores pusieron una cláusula que nos eximía en caso de fuerza mayor."
    mc "Je peux toutefois examiner tous les contrats que notre division Support a conclus avec Iron Fist. Mes prédécesseurs y avaient inclus une clause nous exonérant de toute responsabilité en cas de force majeure."

# game/scripts/c25/c25.rpy:1914
translate french c25s003_Yoga_a79b60c2:

    # jef "No puede hacer eso. La reputación de NTR..."
    jef "Il ne peut pas faire ça. La réputation de NTR..."

# game/scripts/c25/c25.rpy:1916
translate french c25s003_Yoga_912af936:

    # mc "La reputación de NTR quedará intacta. Estaremos cumpliendo el contrato. Los contratos."
    mc "La réputation de NTR restera intacte. Nous honorerons le contrat. Les contrats."

# game/scripts/c25/c25.rpy:1917
translate french c25s003_Yoga_808169d6:

    # mc "El martes hay un despliegue de operativos de Iron Fist en Venezuela usando un avión de NTR como transporte. Es posible que ese avión tenga algún problema con los motores."
    mc "Mardi, des agents d'Iron Fist ont été déployés au Venezuela à bord d'un avion de la NTR. Il est possible que l'appareil rencontre des problèmes de moteur."

# game/scripts/c25/c25.rpy:1918
translate french c25s003_Yoga_d02ea4ac:

    # mc "Tres días después, extracción de esos operativos en la costa. Mmmm... creo que el barco que íbamos a enviar tiene un problema y hace aguas."
    mc "Trois jours plus tard, extraction des ressources de ces opérations côtières. Mmm... Je crois que le navire que nous devions envoyer a un problème et prend l'eau."

# game/scripts/c25/c25.rpy:1919
translate french c25s003_Yoga_b2b81e8c:

    # mc "¿Sigo? Hay once contratos para los próximos tres meses."
    mc "Dois-je continuer ? Il y a onze contrats pour les trois prochains mois."

# game/scripts/c25/c25.rpy:1920
translate french c25s003_Yoga_94fbceff:

    # jef "No, Sr. Marks. No hace falta que continúe."
    jef "Non, monsieur Marks. Il n'est pas nécessaire de continuer."

# game/scripts/c25/c25.rpy:1922
translate french c25s003_Yoga_02f8e7ca:

    # mc "Ustedes nos necesitan a nosotros. Nosotros no les necesitamos a ustedes."
    mc "Vous avez besoin de nous. Nous n'avons pas besoin de vous."

# game/scripts/c25/c25.rpy:1923
translate french c25s003_Yoga_b8546b5b:

    # mc "Ya sabe. No volverán a contratar a la Srta. Brown, ni harán ningún informe negativo sobre ninguno de sus dos contratos con ustedes."
    mc "Vous savez, ils ne réembaucheront pas Mme Brown et ne rédigeront aucun rapport négatif concernant ses contrats avec vous."

# game/scripts/c25/c25.rpy:1924
translate french c25s003_Yoga_e7cb3e0f:

    # jef "Lo entiendo. Se lo comunicaré al Sr. Ichigo. Se pondrá en contacto con usted."
    jef "Je comprends. J'en informerai M. Ichigo. Il vous contactera."

# game/scripts/c25/c25.rpy:1926
translate french c25s003_Yoga_05d8d838:

    # mc "No hace falta que Ichigo pierda su tiempo llamándome. Que envíe un 'OK' junto a la oferta que me tiene que enviar para la absorción o fusión."
    mc "Ichigo n'a pas besoin de perdre son temps à m'appeler. Il devrait simplement envoyer un « OK » avec l'offre qu'il est censé me faire concernant l'absorption ou la fusion."

# game/scripts/c25/c25.rpy:1927
translate french c25s003_Yoga_fe35dedf:

    # mc "El mismo tipo de suspensión de contratos se aplicará si alguien de Iron Fist se acerca a alguien de mi familia, o si ponen alguna queja ante la agencia de la Srta. Brown."
    mc "Le même type de suspension de contrat s'appliquera si un membre d'Iron Fist contacte un membre de ma famille ou s'ils déposent une plainte auprès de l'agence de Mme Brown."

# game/scripts/c25/c25.rpy:1928
translate french c25s003_Yoga_d3fe41ce:

    # mc "¿Entendido?"
    mc "Compris?"

# game/scripts/c25/c25.rpy:1929
translate french c25s003_Yoga_cb47e656:

    # jef "Entendido, Sr. Marks."
    jef "Compris, M. Marks."

# game/scripts/c25/c25.rpy:1930
translate french c25s003_Yoga_f7467f31:

    # mc "Que tenga un buen día, Sr. Sound."
    mc "Bonne journée, Monsieur Sound."

# game/scripts/c25/c25.rpy:1932
translate french c25s003_Yoga_798928a5:

    # mcp "(Sound parece un buen tipo, pero tiene que defender su empresa. Supongo que es difícil trabajar para alguien como Ichigo.)"
    mcp "(Sound a l'air d'être un type bien, mais il doit défendre sa société. J'imagine que ce n'est pas facile de travailler pour quelqu'un comme Ichigo.)"

# game/scripts/c25/c25.rpy:1933
translate french c25s003_Yoga_d45b95c1:

    # "Cuando estás a punto de girarte volver con [kat]..."
    "Au moment où vous vous apprêtez à faire demi-tour et à repartir avec [kat]..."

# game/scripts/c25/c25.rpy:1935
translate french c25s003_Yoga_4ccac790:

    # kim "*Jadeo de sorpresa*"
    kim "*Halètement de surprise*"

# game/scripts/c25/c25.rpy:1938
translate french c25s003_Yoga_3af9bd6a:

    # kim "¿Qué has hecho, [mc]?"
    kim "Qu'as-tu fait, [mc] ?"

# game/scripts/c25/c25.rpy:1939
translate french c25s003_Yoga_f06892bd:

    # mc "¿Cuánto llevas ahí, [kim]?"
    mc "Depuis combien de temps es-tu là, [kim] ?"

# game/scripts/c25/c25.rpy:1940
translate french c25s003_Yoga_d638db65:

    # kim "Desde que has dicho algo de Venezuela..."
    kim "Puisque vous avez mentionné le Venezuela..."

# game/scripts/c25/c25.rpy:1942
translate french c25s003_Yoga_3394374b:

    # kim "Y después has dicho lo de mi contrato y los informes a la agencia..."
    kim "Et puis vous avez mentionné mon contrat et les rapports à l'agence..."

# game/scripts/c25/c25.rpy:1943
translate french c25s003_Yoga_ee048b03:

    # mc "No puedo dejar que seas una víctima en una guerra que no va contigo, [kim]. No sería justo."
    mc "Je ne peux pas te laisser être une victime dans une guerre qui ne te concerne pas, [kim]. Ce ne serait pas juste."

# game/scripts/c25/c25.rpy:1950
translate french c25s003_Yoga_f703d36b:

    # "Miss Mapache California 2023 se lanza a darte un beso en el que hay tanto agradecimiento como pasión."
    "Miss Mapache Californie 2023 ose vous offrir un baiser empreint de gratitude et de passion."

# game/scripts/c25/c25.rpy:1953
translate french c25s003_Yoga_c6d4cb33:

    # "[kim] se lanza a darte un abrazo en el que hay tanto agradecimiento como alivio."
    "[kim] se jette sur vous pour vous serrer dans ses bras, un câlin empli à la fois de gratitude et de soulagement."

# game/scripts/c25/c25.rpy:1955
translate french c25s003_Yoga_f97594fc:

    # kim "Gracias, [mc]. No sé cómo darte las gracias por algo así..."
    kim "Merci, [mc]. Je ne sais pas comment vous remercier pour quelque chose comme ça..."

# game/scripts/c25/c25.rpy:1956
translate french c25s003_Yoga_c39f7a0e:

    # mc "No hace falta darlas pero, de todas formas, lo acabas de hacer."
    mc "Vous n'étiez pas obligé de les donner, mais bon, vous venez de le faire."

# game/scripts/c25/c25.rpy:1958
translate french c25s003_Yoga_3cfa9aac:

    # mc "Y no estoy para nada de acuerdo con que tengas los labios feos."
    mc "Et je suis en total désaccord avec l'idée que vos lèvres soient laides."

# game/scripts/c25/c25.rpy:1960
translate french c25s003_Yoga_f0cdb5dc:

    # kim "*Risa* Gracias. Pero no te acostumbres. Me encanta mi pintalabios."
    kim "*Rires* Merci. Mais ne vous y habituez pas. J'adore mon rouge à lèvres."

# game/scripts/c25/c25.rpy:1963
translate french c25s003_Yoga_4c564d64:

    # kim "¡Me voy a dar una ducha o, si no, se me van a adelantar!"
    kim "Je vais prendre une douche, sinon ils vont me devancer !"

# game/scripts/c25/c25.rpy:1965
translate french c25s003_Yoga_9da71f01:

    # kim "Y no estás invitado, antes de que preguntes."
    kim "Et vous n'êtes pas invité, avant même de poser la question."

# game/scripts/c25/c25.rpy:1966
translate french c25s003_Yoga_fe2c55b0:

    # mc "*Risa* Parece que las invitaciones no son necesarias entre nosotros, ¿no?"
    mc "*Rires* Il semblerait que les invitations ne soient pas nécessaires entre nous, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:1967
translate french c25s003_Yoga_eefa4139:

    # mc "Anoche me desperté con una preciosidad entre mis brazos."
    mc "La nuit dernière, je me suis réveillée avec un magnifique enfant dans les bras."

# game/scripts/c25/c25.rpy:1969
translate french c25s003_Yoga_f1ff02c7:

    # kim "¿Te molestó? Cada vez que cerraba los ojos... veía al Sr. Ichigo ordenándome que me desnudara..."
    kim "Ça vous dérangeait ? Chaque fois que je fermais les yeux… je voyais M. Ichigo me donner l’ordre de me déshabiller…"

# game/scripts/c25/c25.rpy:1970
translate french c25s003_Yoga_04975c8b:

    # kim "Pensé que dormir contigo me calmaría, y así fue."
    kim "Je pensais que dormir avec toi me calmerait, et ça a été le cas."

# game/scripts/c25/c25.rpy:1971
translate french c25s003_Yoga_bfe1e78f:

    # mc "No me ha molestado, [kim]. Pero despiértame la próxima vez. Al menos para darme un beso de buenas noches."
    mc "Ça ne me dérangeait pas, [kim]. Mais réveille-moi la prochaine fois. Au moins pour me donner un bisou de bonne nuit."

# game/scripts/c25/c25.rpy:1973
translate french c25s003_Yoga_7904dd8f:

    # "La hermosa modelo te da un beso de buenos días. La compensación no es algo por lo que vayas a quejarte."
    "La sublime mannequin vous envoie un baiser de bonjour. La compensation est plus que satisfaisante."

# game/scripts/c25/c25.rpy:1975
translate french c25s003_Yoga_6ee8f5fd:

    # kim "Lo tendré en cuenta para la próxima vez. Voy a darme esa ducha."
    kim "J'en tiendrai compte pour la prochaine fois. Je vais prendre une douche."

# game/scripts/c25/c25.rpy:1976
translate french c25s003_Yoga_ea6e0675:

    # mc "Te veo luego, [kim]."
    mc "À plus tard, [kim]."

# game/scripts/c25/c25.rpy:1978
translate french c25s003_Yoga_c1fb1bcb:

    # "Te asomas para despedirte de [kat] y las chicas del yoga."
    "Tu jettes un coup d'œil pour dire au revoir à [kat] et aux filles du yoga."

# game/scripts/c25/c25.rpy:1981
translate french c25s003_Yoga_e58b0ead:

    # "La reacción al verte de [kia] especialmente, y de [mar], [nor], y [sam] es sospechosa."
    "La réaction lorsqu'on vous voit depuis [kia] en particulier, et depuis [mar], [nor] et [sam] est suspecte."

# game/scripts/c25/c25.rpy:1982
translate french c25s003_Yoga_9b6c9a20:

    # "Quizás solo creían que ya te habías ido y se han sorprendido al verte de nuevo."
    "Peut-être pensaient-ils simplement que vous étiez déjà parti et ont-ils été surpris de vous revoir."

# game/scripts/c25/c25.rpy:1983
translate french c25s003_Yoga_4266ee6f:

    # "O eso hubieras pensado hace tan solo unas semanas."
    "Du moins, c'est ce que l'on aurait pu croire il y a quelques semaines à peine."

# game/scripts/c25/c25.rpy:1985
translate french c25s003_Yoga_bca053f3:

    # "Están demasiado ocupadas para notar que has vuelto."
    "Ils sont trop occupés pour remarquer votre retour."

# game/scripts/c25/c25.rpy:1987
translate french c25s003_Yoga_4af25a40:

    # mc "Te veo luego, [kat]."
    mc "À plus tard, [kat]."

# game/scripts/c25/c25.rpy:1988
translate french c25s003_Yoga_91e627bf:

    # kat "Hasta luego, [mc]. Recuerda que tenemos una... {i}(¡No digas cita, no digas cita!){/i}... cita para desayunar."
    kat "À plus tard, [mc]. N'oublie pas que nous avons un... {i}(Ne dis pas rendez-vous, ne dis pas rendez-vous !){/i}... rendez-vous pour le petit-déjeuner."

# game/scripts/c25/c25.rpy:1989
translate french c25s003_Yoga_723dcc36:

    # mc "No te preocupes, no la olvidaré."
    mc "Ne t'inquiète pas, je ne l'oublierai pas."

# game/scripts/c25/c25.rpy:1990
translate french c25s003_Yoga_808e530b:

    # kat "{i}(¡Mierda, [kat]! ¡Lo has dicho!){/i}"
    kat "{i}(Mince alors, [kat] ! Tu l'as dit !){/i}"

# game/scripts/c25/c25.rpy:1992
translate french c25s003_Yoga_e459e51c:

    # "Subes a la habitación, contento por cómo ha ido la conversación con Sound."
    "Vous montez dans la chambre, satisfait du déroulement de votre conversation avec Sound."

# game/scripts/c25/c25.rpy:1994
translate french c25s003_Yoga_c1a26487:

    # "Estás contento de que la relación con [kim] se haya arreglado. Anoche estaba muy enfadada contigo."
    "Tu es content que les choses aillent mieux avec [kim]. Elle était vraiment en colère contre toi hier soir."

# game/scripts/c25/c25.rpy:1996
translate french c25s003_Yoga_1b9c32e4:

    # "También estás confuso con la reacción de [mar], [nor], [sam], y [kia]. Ha sido solo un momento, pero era como si estuvieran planeando algo en lo que estabas involucrado."
    "Vous êtes également déconcerté par la réaction de [mar], [nor], [sam] et [kia]. Ce n'était qu'un instant, mais c'était comme s'ils préparaient quelque chose auquel vous étiez mêlé."

# game/scripts/c25/c25.rpy:1997
translate french c25s003_Yoga_a0cf6f8e:

    # "Y has quedado para desayunar con [kat]..."
    "Et vous avez prévu de prendre le petit-déjeuner avec [kat]..."

# game/scripts/c25/c25.rpy:2000
translate french c25s003_Yoga_8e326afb:

    # mcp "(¡Un momento! ¿Ha dicho cita? No puede ser, ¿no?)"
    mcp "(Attendez une minute ! A-t-il dit « rendez-vous » ? Ce n'est pas possible, si ?)"

# game/scripts/c25/c25.rpy:2005
translate french c25s003_NoMeg_a3890ba2:

    # "Al llegar a tu habitación empiezas a jugar a My Residence. La conversación con [deb.nick] te ha hecho recordar que llevas varias actualizaciones de retraso."
    "En arrivant dans votre chambre, vous lancez My Residence. La conversation avec [deb.nick] vous rappelle que vous avez plusieurs mises à jour de retard."

# game/scripts/c25/c25.rpy:2006
translate french c25s003_NoMeg_e428453f:

    # "Tienes una tórrida escena con Kimberly, la bailarina, que está en la habitación del MC cuando vuelve de desayunar."
    "Vous avez une scène torride avec Kimberly, la danseuse, qui se trouve dans la chambre du protagoniste à son retour du petit-déjeuner."

# game/scripts/c25/c25.rpy:2007
translate french c25s003_NoMeg_70d4e350:

    # "[deb.nick] tenía parte de razón. Si Mandy y Vee tienen algo de [ama] y [eva], Kimberly tiene algo que te recuerda a [meg]."
    "[deb.nick] avait raison. Si Mandy et Vee ont quelque chose qui rappelle [ama] et [eva], Kimberly a quelque chose qui évoque [meg]."

# game/scripts/c25/c25.rpy:2008
translate french c25s003_NoMeg_dbe4278f:

    # "Sin el comentario de [deb.nick] no crees que hubieras descubierto el parecido nunca."
    "Sans le commentaire de [deb.nick], vous n'auriez sans doute jamais remarqué la ressemblance."

# game/scripts/c25/c25.rpy:2022
translate french c25s003_Meg_1d2445d4:

    # "Al llegar a tu habitación, te encuentras una sorpresa en el sofá."
    "En arrivant dans votre chambre, vous découvrez une surprise sur le canapé."

# game/scripts/c25/c25.rpy:2023
translate french c25s003_Meg_49f2b733:

    # mc "¡Hola, [meg]! ¿Puedo ayudarte en algo?"
    mc "Salut, [meg] ! Puis-je vous aider ?"

# game/scripts/c25/c25.rpy:2025
translate french c25s003_Meg_fe3a4bfa:

    # meg "Un momento que acabo la página, por favor."
    meg "Un instant, je vais terminer la page, s'il vous plaît."

# game/scripts/c25/c25.rpy:2026
translate french c25s003_Meg_f63377ab:

    # "Esperas."
    "Vous attendez."

# game/scripts/c25/c25.rpy:2027
translate french c25s003_Meg_0981270f:

    # mc "¿Qué estás leyendo?"
    mc "Que lisez-vous ?"

# game/scripts/c25/c25.rpy:2029
translate french c25s003_Meg_c927252f:

    # meg "Un libro sobre unos compositores que me gustan mucho."
    meg "Un livre sur des compositeurs que j'aime beaucoup."

# game/scripts/c25/c25.rpy:2030
translate french c25s003_Meg_a0e16017:

    # mc "Lo que a mí me gusta mucho es el conjunto que llevas."
    mc "Ce que j'aime vraiment, c'est la tenue que tu portes."

# game/scripts/c25/c25.rpy:2037
translate french c25s003_Meg_f4b6e8a0:

    # meg "¿Esto? Es algo que he pensado que te podría gustar..."
    meg "Ça ? C'est quelque chose que je pensais que ça pourrait te plaire..."

# game/scripts/c25/c25.rpy:2038
translate french c25s003_Meg_f99c883a:

    # mc "Y has acertado completamente."
    mc "Et vous avez tout à fait raison."

# game/scripts/c25/c25.rpy:2039
translate french c25s003_Meg_eba83385:

    # mc "Pero... ¿quién eres y qué has hecho con [meg]?"
    mc "Mais… qui êtes-vous et qu’avez-vous fait avec [meg] ?"

# game/scripts/c25/c25.rpy:2041
translate french c25s003_Meg_c029dfe6:

    # meg "¿A qué te refieres?"
    meg "De quoi parles-tu?"

# game/scripts/c25/c25.rpy:2042
translate french c25s003_Meg_e561c481:

    # mc "Mi [meg] nunca diría algo así. Estaría quejándose de que el modelo es precioso pero de que no le queda igual que le quedaría a [ama], o a [nor]."
    mc "Ma [meg] ne dirait jamais une chose pareille. Elle se plaindrait plutôt que le modèle est magnifique, mais qu'il ne lui va pas aussi bien qu'à [ama] ou [nor]."

# game/scripts/c25/c25.rpy:2043
translate french c25s003_Meg_2d340316:

    # mc "¡Alien, sal del cuerpo de [meg]! *Risa* ¡Has poseído su cuerpo, pero no sabes cómo piensa!"
