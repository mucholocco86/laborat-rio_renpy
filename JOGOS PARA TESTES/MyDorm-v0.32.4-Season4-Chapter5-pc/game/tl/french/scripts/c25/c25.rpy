translate french c25s004_GetMad_73bdd14d:

    # zeu "*Miau* *Purr* (Pero si me rascas así, puedes llamarme como quieras.)" id c25s004_GetMad_73bdd14d
    zeu "*Miaou* *Ronronnement* (Mais si tu me griffes comme ça, tu peux m'appeler comme tu veux.)" id c25s004_GetMad_73bdd14d

# game/scripts/c25/c25.rpy:3245
translate french c25s004_GetMad_e0122449:

    # mad "Me encanta ver lo bien que se lleva contigo. *Risa* Más aún teniendo en cuenta que no le traes comida."
    mad "J'adore voir à quel point il s'entend bien avec toi. *Rires* Surtout que tu ne lui apportes pas à manger."

# game/scripts/c25/c25.rpy:3246
translate french c25s004_GetMad_be2a8125:

    # mc "Le he comprado una lata de atún, pero me la he dejado en la camioneta."
    mc "Je lui ai acheté une boîte de thon, mais je l'ai laissée dans le camion."

# game/scripts/c25/c25.rpy:3247
translate french c25s004_GetMad_dbd50b39:

    # mc "Te iba a proponer que lo trajeras a casa, estoy seguro de que a las chicas les va a encantar conocerlo."
    mc "J'allais te suggérer de le ramener à la maison ; je suis sûre que les filles seront ravies de le rencontrer."

# game/scripts/c25/c25.rpy:3249
translate french c25s004_GetMad_2665f6a9:

    # zeu "*Miau* *Purr* (Normal, soy adorable... Especialmente una vez me coma esa lata que has olvidado.)" id c25s004_GetMad_2665f6a9
    zeu "*Miaou* *Ronronnement* (Normal, je suis adorable... Surtout une fois que j'ai mangé cette boîte que tu as oubliée.)" id c25s004_GetMad_2665f6a9

# game/scripts/c25/c25.rpy:3251
translate french c25s004_GetMad_0e6853e8:

    # mad "No sé, [mc]. Aunque contigo se lleve bien, no es muy sociable. No sé si arañará a alguna de las chicas."
    mad "Je ne sais pas, [mc]. Même s'il s'entend bien avec toi, il n'est pas très sociable. Je ne sais pas s'il va draguer les filles."

# game/scripts/c25/c25.rpy:3252
translate french c25s004_GetMad_c851fea0:

    # mc "Bueno, es tu gato. Tu lo conoces mejor que nadie."
    mc "Eh bien, c'est votre chat. Vous le connaissez mieux que quiconque."

# game/scripts/c25/c25.rpy:3254
translate french c25s004_GetMad_0a4d1a18:

    # zeu "*Purr divertido* *¡Miau!* (*Risa* ¡Su gato! Estos humanos son tan graciosos... ¡Mascotas creyéndose los amos!)" id c25s004_GetMad_0a4d1a18
    zeu "*Ronronnement (amusant)* *Miaou !* (*Rires* Son chat ! Ces humains sont vraiment drôles... Leurs animaux de compagnie qui se prennent pour les chefs !)" id c25s004_GetMad_0a4d1a18

# game/scripts/c25/c25.rpy:3255
translate french c25s004_GetMad_3ecd5704:

    # mcp "(¿El gato se ha reido? Deben ser imaginaciones mías...)"
    mcp "(Le chat a-t-il ri ? Je dois rêver...)"

# game/scripts/c25/c25.rpy:3257
translate french c25s004_GetMad_d68064d0:

    # mad "Zeus, ¿quieres venir a conocer a las chicas? ¿Te vas a portar bien? Seguro que hay comida para ti."
    mad "Zeus, veux-tu venir rencontrer les filles ? Tu seras sage, j'en suis sûre. Il y a à manger pour toi."

# game/scripts/c25/c25.rpy:3258
translate french c25s004_GetMad_e0079f15:

    # mc "*Risa* Le hablas como si te entendiera."
    mc "*Rires* Tu lui parles comme s'il te comprenait."

# game/scripts/c25/c25.rpy:3259
translate french c25s004_GetMad_88233d1e:

    # mad "Te sorprenderías de lo mucho que parece entender..."
    mad "Vous seriez surpris de voir à quel point il semble comprendre..."

# game/scripts/c25/c25.rpy:3261
translate french c25s004_GetMad_dbcaa708:

    # mc "¡Ostias! ¿Dónde ha ido?"
    mc "Putain de merde ! Où est-il passé ?"

# game/scripts/c25/c25.rpy:3262
translate french c25s004_GetMad_a465a5d3:

    # mad "*Risa* Te he dicho que te sorprenderías."
    mad "*Rires* Je vous avais dit que vous seriez surpris."

# game/scripts/c25/c25.rpy:3264
translate french c25s004_GetMad_70cbe712:

    # zeu "*¿Miau?* (¿Nos podemos ir a conocer a esas chicas que regalan comida?)" id c25s004_GetMad_70cbe712
    zeu "*Miaou ?* (On peut aller rencontrer ces filles qui distribuent de la nourriture ?)" id c25s004_GetMad_70cbe712

# game/scripts/c25/c25.rpy:3266
translate french c25s004_GetMad_8a261ec7:

    # mad "*Risa* Ya está en la puerta esperando. No hay como decirle que hay comida en algún sitio."
    mad "*Rires* Il attend déjà à la porte. Impossible de lui dire qu'il y a à manger quelque part."

# game/scripts/c25/c25.rpy:3267
translate french c25s004_GetMad_45d1dbca:

    # mad "Dame un momento para que coja el bolso y nos podemos ir. También tengo que coger otra cosa..."
    mad "Donnez-moi une seconde pour prendre mon sac et on y va. Il me faut aussi autre chose…"

# game/scripts/c25/c25.rpy:3268
translate french c25s004_GetMad_326d9f1b:

    # mc "*Risa* Te espero acariciando a Zeus."
    mc "*Rires* Je t'attendrai en train de caresser Zeus."

# game/scripts/c25/c25.rpy:3270
translate french c25s004_GetMad_b9015529:

    # zeu "*¡Miau!* (¡Sí, caricias para Lord Simba!)" id c25s004_GetMad_b9015529
    zeu "*Miaou !* (Oui, des caresses pour Lord Simba !)" id c25s004_GetMad_b9015529

# game/scripts/c25/c25.rpy:3272
translate french c25s004_GetMad_df76e855:

    # "Os ponéis en camino unos minutos después. Zeus se pasa todo el viaje con la cabeza dentro de la bolsa donde está la lata de atún."
    "Vous partez quelques minutes plus tard. Zeus passe tout le trajet la tête dans le sac où se trouve la boîte de thon."

# game/scripts/c25/c25.rpy:3274
translate french c25s004_GetMad_8c466a7c:

    # "Por suerte, no sabe abrirla... O es demasiado vago para hacerlo y está esperando que sus sirvientes humanos lo hagan por él."
    "Heureusement, il ne sait pas comment l'ouvrir... Ou alors il est trop paresseux pour le faire et attend que ses serviteurs humains le fassent pour lui."

# game/scripts/c25/c25.rpy:3331
translate french c25s005_ZeusAtHome_c1e656bf:

    # "Al llegar a casa, vais directos a la cocina de [nor]."
    "Lorsque vous rentrez chez vous, vous allez directement dans la cuisine de [nor]."

# game/scripts/c25/c25.rpy:3332
translate french c25s005_ZeusAtHome_ef64a4e3:

    # mc "Te dejo los pepinillos que me has pedido en la nevera."
    mc "J'ai mis les cornichons que vous m'avez demandés au réfrigérateur."

# game/scripts/c25/c25.rpy:3333
translate french c25s005_ZeusAtHome_b1c907a2:

    # nor "Gracias, [mc]."
    nor "Merci, [mc]."

# game/scripts/c25/c25.rpy:3334
translate french c25s005_ZeusAtHome_7549b2ae:

    # nor "Hola, [mad.nick]."
    nor "Bonjour, [mad.nick]."

# game/scripts/c25/c25.rpy:3337
translate french c25s005_ZeusAtHome_9c50a15a:

    # "Al llegar a casa, dejas el pollo que te ha pedido [mar] en la nevera y vais a la cocina de [nor]."
    "Lorsque tu rentres à la maison, tu laisses le poulet que [mar] a demandé dans le réfrigérateur et tu vas dans la cuisine de [nor]."

# game/scripts/c25/c25.rpy:3339
translate french c25s005_ZeusAtHome_d6cfd815:

    # "Al llegar a casa, dejas los pepinillos en la nevera, le mandas un mensaje a [whoPickles], y vais a la cocina de [nor]."
    "Quand tu rentres à la maison, tu mets les cornichons au réfrigérateur, tu envoies un message à [whoPickles] et tu vas dans la cuisine de [nor]."

# game/scripts/c25/c25.rpy:3340
translate french c25s005_ZeusAtHome_7c234c8f:

    # nor "Hola, [mad.nick]. Hola de nuevo, [mc]."
    nor "Bonjour, [mad.nick]. Bonjour à nouveau, [mc]."

# game/scripts/c25/c25.rpy:3342
translate french c25s005_ZeusAtHome_71b1c336:

    # nor "¿Llevas un gato en la bolsa, [mad.nick]?"
    nor "Tu transportes un chat dans ton sac, [mad.nick] ?"

# game/scripts/c25/c25.rpy:3344
translate french c25s005_ZeusAtHome_57a99d67:

    # mad "Hola, [nor]. *Risa* Sí, es Zeus. Creo que está intentando abrir la lata de atún que [mc] le ha comprado."
    mad "Salut, [nor]. *Rires* Oui, c'est Zeus. Je crois qu'il essaie d'ouvrir la boîte de thon que [mc] lui a achetée."

# game/scripts/c25/c25.rpy:3345
translate french c25s005_ZeusAtHome_0ca02bc7:

    # mc "Es un pequeño glotón. Te lo ganarás si le das comida."
    mc "C'est un petit glouton. Vous finirez par le conquérir si vous le nourrissez."

# game/scripts/c25/c25.rpy:3347
translate french c25s005_ZeusAtHome_41f59f42:

    # zeu "*Miau* (¿He oído que esta señora reparte comida?)"
    zeu "*Miaou* (J'ai entendu dire que cette dame livre des repas ?)"

# game/scripts/c25/c25.rpy:3348
translate french c25s005_ZeusAtHome_3b938227:

    # mc "*Risa* A veces creo que nos entiende. Oye la palabra 'comida' y se olvida de lo que estaba haciendo."
    mc "*Rires* Parfois, je crois qu'il nous comprend. Il entend le mot « nourriture » et oublie ce qu'il était en train de faire."

# game/scripts/c25/c25.rpy:3350
translate french c25s005_ZeusAtHome_07ff799a:

    # mad "¿Quieres que lo deje en algún sitio donde no moleste? Está bien educado, y no va a hacer sus cosas en el suelo ni a arañar los muebles."
    mad "Voulez-vous que je le mette à un endroit où il ne vous gênera pas ? Il est bien élevé et ne fait pas ses besoins sur le sol ni ne griffe les meubles."

# game/scripts/c25/c25.rpy:3352
translate french c25s005_ZeusAtHome_6a2f5e12:

    # nor "Si está bien educado lo puedes dejar suelto. ¿Le puedo dar un trozo de salchicha?"
    nor "S'il est sage, vous pouvez le détacher. Puis-je lui donner un morceau de saucisse ?"

# game/scripts/c25/c25.rpy:3354
translate french c25s005_ZeusAtHome_99acdd36:

    # zeu "*Miau* (Si dices que no, sé dónde duermes. Mi cola puede meterse en tu boca sin que yo pueda, o quiera, hacer nada por evitarlo.)"
    zeu "*Miaou* (Si tu dis non, je sais où tu dors. Ma queue peut entrer dans ta bouche et je ne peux, ou ne veux, rien faire pour l'en empêcher.)"

# game/scripts/c25/c25.rpy:3356
translate french c25s005_ZeusAtHome_fbb3b9ff:

    # mad "Creo que no habrá ningún problema. Come de todo."
    mad "Je ne pense pas qu'il y aura de problème. Mangez tout."

# game/scripts/c25/c25.rpy:3357
translate french c25s005_ZeusAtHome_7f2d48c2:

    # mc "*Risa* Además, Zeus tendrá una nueva mejor amiga."
    mc "*Rires* De plus, Zeus aura un nouveau meilleur ami."

# game/scripts/c25/c25.rpy:3358
translate french c25s005_ZeusAtHome_8df3ef23:

    # mc "Dame la bolsa, [mad.nick], voy a guardar las cosas en la nevera."
    mc "Donne-moi le sac, [mad.nick], je vais mettre les choses au frigo."

# game/scripts/c25/c25.rpy:3360
translate french c25s005_ZeusAtHome_308493de:

    # "El gato, como siempre, parece entender lo que estáis diciendo y salta ágilmente de la bolsa a la isla de la cocina."
    "Le chat, comme toujours, semble comprendre ce que vous dites et saute avec agilité du sac à l'îlot de cuisine."

# game/scripts/c25/c25.rpy:3361
translate french c25s005_ZeusAtHome_d7055b23:

    # zeu "*Miau* (Tienes mi autorización para alimentarme, humana.)"
    zeu "*Miaou* (Tu as ma permission de me nourrir, humain.)"

# game/scripts/c25/c25.rpy:3363
translate french c25s005_ZeusAtHome_8a4f2de9:

    # mad "¡Zeus! ¡Baja de ahí ahora mismo! Acabo de decirles que estás bien educado."
    mad "Zeus ! Descends de là immédiatement ! Je viens de leur dire que tu es bien élevé."

# game/scripts/c25/c25.rpy:3365
translate french c25s005_ZeusAtHome_f49740ea:

    # zeu "*Miau lastimero* (Pero el tipo feo le ha dicho a la Alimentadora Suprema que si hay comida por en medio me olvido de todo...)"
    zeu "*Miaou de pitié* (Mais le type moche a dit au Nourrisseur Suprême que s'il y a de la nourriture en jeu, j'oublierai tout...)"

# game/scripts/c25/c25.rpy:3367
translate french c25s005_ZeusAtHome_e98194c3:

    # mad "Zeeeeus..."
    mad "Zeeeeus..."

# game/scripts/c25/c25.rpy:3369
translate french c25s005_ZeusAtHome_0690a050:

    # zeu "*Miaaaau* (Vaaaaale.)"
    zeu "*Miaou* (D'accord.)"

# game/scripts/c25/c25.rpy:3371
translate french c25s005_ZeusAtHome_ebb7109f:

    # "Baja del mostrador tan ágilmente como ha subido, aunque por alguna razón te parece que lo hace con cara de pena."
    "Elle descend du comptoir avec autant d'agilité qu'elle y est montée, même si, pour une raison inconnue, vous avez l'impression qu'elle le fait avec un air triste."

# game/scripts/c25/c25.rpy:3372
translate french c25s005_ZeusAtHome_94415e2c:

    # "Rodea la isla de la cocina para ir a los pies de [nor]."
    "Contournez l'îlot de cuisine pour atteindre les pieds de [nor]."

# game/scripts/c25/c25.rpy:3374
translate french c25s005_ZeusAtHome_4fb1d052:

    # nor "Realmente lo has educado muy bien. Felicidades, [mad.nick]. Siempre he oído que los gatos son más difíciles de educar que los perros."
    nor "Vous l'avez vraiment bien dressé. Félicitations ! J'ai toujours entendu dire que les chats étaient plus difficiles à dresser que les chiens."

# game/scripts/c25/c25.rpy:3375
translate french c25s005_ZeusAtHome_800adf8b:

    # mc "*Risa* A mí siempre me han parecido más listos que los perros."
    mc "*Rires* J'ai toujours pensé qu'ils étaient plus intelligents que les chiens."

# game/scripts/c25/c25.rpy:3376
translate french c25s005_ZeusAtHome_eece51dd:

    # mc "Un perro es como un niño pequeño, siempre haciendo ruido, necesitando atención, y emocionándose por todo."
    mc "Un chien est comme un petit enfant : il fait toujours du bruit, a besoin d'attention et s'enthousiasme pour tout."

# game/scripts/c25/c25.rpy:3377
translate french c25s005_ZeusAtHome_f710df82:

    # mc "Un gato es como un jubilado. *Risa* Se deja alimentar y sólo te presta atención cuando a él le da la gana."
    mc "Un chat, c'est comme un retraité. *Rires* Il se laisse nourrir et ne vous prête attention que quand ça lui chante."

# game/scripts/c25/c25.rpy:3379
translate french c25s005_ZeusAtHome_6a8e89aa:

    # zeu "*Miau* (Escuchad a este tío. Sabe de lo que habla.)"
    zeu "*Miaou* (Écoutez-le. Il sait de quoi il parle.)"

# game/scripts/c25/c25.rpy:3380
translate french c25s005_ZeusAtHome_c30791f8:

    # zeu "*Miau?* (¿Dónde está mi salchicha?)" id c25s005_ZeusAtHome_c30791f8
    zeu "*Miaou ?* (Où est ma saucisse ?)" id c25s005_ZeusAtHome_c30791f8

# game/scripts/c25/c25.rpy:3382
translate french c25s005_ZeusAtHome_5247916e:

    # nor "¿Quieres un trozo de salchicha, chiquitín?"
    nor "Tu veux un morceau de saucisse, mon petit ?"

# game/scripts/c25/c25.rpy:3383
translate french c25s005_ZeusAtHome_4917eeff:

    # zeu "*Miau* (¡Sí! ¡Alimenta a tu Señor!)"
    zeu "*Miaou* (Oui ! Nourrissez votre Seigneur !)"

# game/scripts/c25/c25.rpy:3385
translate french c25s005_ZeusAtHome_903b361d:

    # "La salchicha desaparece en un momento en la boca del felino."
    "La saucisse disparaît en un instant dans la gueule du chat."

# game/scripts/c25/c25.rpy:3386
translate french c25s005_ZeusAtHome_bf052574:

    # zeu "*Miau* (He puesto mi sagrada zarpa sobre ti. Ahora eres mía.)"
    zeu "*Miaou* (J'ai posé ma patte sacrée sur toi. Maintenant tu es à moi.)"

# game/scripts/c25/c25.rpy:3388
translate french c25s005_ZeusAtHome_023ef6eb:

    # nor "*Risa* Es super bonito. Y muy simpático."
    nor "*Rires* Il est super mignon. Et très gentil."

# game/scripts/c25/c25.rpy:3389
translate french c25s005_ZeusAtHome_d1866030:

    # mc "*Risa* Mientras le des comida seguirá siendo simpático, no lo dudes."
    mc "*Rires* Tant que vous le nourrirez, il restera mignon, n'en doutez pas."

# game/scripts/c25/c25.rpy:3391
translate french c25s005_ZeusAtHome_766bb000:

    # mad "[mc], ¿podrías enseñarle la casa a Zeus mientras yo ayudo a [nor] con la comida? Sobre todo, enséñale dónde están los lavabos."
    mad "[mc], pourrais-tu faire visiter la maison à Zeus pendant que j'aide [nor] à préparer le repas ? Montre-lui surtout où se trouvent les toilettes."

# game/scripts/c25/c25.rpy:3392
translate french c25s005_ZeusAtHome_948d1c75:

    # mc "Estás de broma, ¿no?"
    mc "Vous plaisantez, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:3393
translate french c25s005_ZeusAtHome_5f5eb2ec:

    # mad "No, le he enseñado a hacer sus cosas en el retrete. Hay que dejar la puerta abierta y la tapa levantada."
    mad "Non, je lui ai appris à faire ses besoins aux toilettes. Il faut laisser la porte ouverte et le couvercle relevé."

# game/scripts/c25/c25.rpy:3395
translate french c25s005_ZeusAtHome_f4b4206c:

    # nor "Eso lo he visto en varias películas y en videos de internet. Parece que es algo común. Cada vez más gente vive en apartamentos."
    nor "J'ai vu ça dans plusieurs films et vidéos en ligne. Ça a l'air assez courant. De plus en plus de gens vivent en appartement."

# game/scripts/c25/c25.rpy:3396
translate french c25s005_ZeusAtHome_7b8b0137:

    # mc "Vamos, Zeus. Voy a enseñarte la casa y a presentarte al resto de la familia."
    mc "Allez, Zeus. Je vais te faire visiter la maison et te présenter au reste de la famille."

# game/scripts/c25/c25.rpy:3398
translate french c25s005_ZeusAtHome_e240b5d7:

    # "Antes de que te dé tiempo de irte con el gato aparecen las dos primeras chicas nuevas. Al menos nuevas para Zeus."
    "Avant même que vous ayez eu le temps de partir avec le chat, deux nouvelles filles font leur apparition. Du moins, nouvelles pour Zeus."

# game/scripts/c25/c25.rpy:3399
translate french c25s005_ZeusAtHome_b7c47a1e:

    # dap "¿Has traído a Zeus, [mad.nick]?"
    dap "As-tu amené Zeus, [mad.nick] ?"

# game/scripts/c25/c25.rpy:3400
translate french c25s005_ZeusAtHome_660e4f31:

    # mad "Sí, [mc] me ha dicho que os gustaría conocerlo."
    mad "Oui, [mc] m'a dit que vous aimeriez le rencontrer."

# game/scripts/c25/c25.rpy:3401
translate french c25s005_ZeusAtHome_9d2f8ab2:

    # eri "No se ha equivocado. Tanto oír hablar de él, ya tenía ganas de verlo."
    eri "Il n'avait pas tort. Après avoir tant entendu parler de lui, j'avais hâte de le voir."

# game/scripts/c25/c25.rpy:3403
translate french c25s005_ZeusAtHome_e3998c0a:

    # zeu "*Miau* (Vuestro color de pelo me confunde. Pero ahora sois mías.)"
    zeu "*Miaou* (Ta couleur de cheveux me perturbe. Mais maintenant tu es à moi.)"

# game/scripts/c25/c25.rpy:3404
translate french c25s005_ZeusAtHome_8c047715:

    # mad "Creo que le habéis caído bien."
    mad "Je pense qu'il t'appréciait."

# game/scripts/c25/c25.rpy:3406
translate french c25s005_ZeusAtHome_f80ebe80:

    # eri "¡Es precioso!"
    eri "C'est magnifique !"

# game/scripts/c25/c25.rpy:3407
translate french c25s005_ZeusAtHome_c51120b9:

    # dap "¡Y se deja tocar por desconocidos! Me encanta."
    dap "Et elle laisse des inconnus la toucher ! J'adore ça."

# game/scripts/c25/c25.rpy:3408
translate french c25s005_ZeusAtHome_84ce6875:

    # zeu "*Miau* (Rascad, esclavas, rascad.)"
    zeu "*Miaou* (Grattez-vous, esclaves, grattez-vous.)"

# game/scripts/c25/c25.rpy:3411
translate french c25s005_ZeusAtHome_6c0166bf:

    # dap "Hola, [mc]. Nos tienes que explicar lo que pasó en el barco. [kim] nos ha explicado algo, pero hay partes que no sabe."
    dap "Bonjour, [mc]. Il faut que tu expliques ce qui s'est passé sur le vaisseau. [kim] a donné quelques explications, mais il y a des choses qu'elle ignore."

# game/scripts/c25/c25.rpy:3412
translate french c25s005_ZeusAtHome_2f307c20:

    # mc "Luego os lo explico."
    mc "Je vous l'expliquerai plus tard."

# game/scripts/c25/c25.rpy:3415
translate french c25s005_ZeusAtHome_3a916b49:

    # eri "Hola, cielo. Antes, durante el yoga, has desaparecido antes de que te saludara."
    eri "Salut chérie. Tout à l'heure, pendant le yoga, tu as disparu avant que je puisse te dire bonjour."

# game/scripts/c25/c25.rpy:3416
translate french c25s005_ZeusAtHome_6c43b663:

    # mc "Hola, preciosa."
    mc "Salut beauté."

# game/scripts/c25/c25.rpy:3420
translate french c25s005_ZeusAtHome_ac96826c:

    # zeu "*Miau* (Me confundes. Creía que estabas con mi sirvienta...)"
    zeu "*Miaou* (Tu me confonds. Je croyais que tu étais avec ma femme de ménage...)"

# game/scripts/c25/c25.rpy:3422
translate french c25s005_ZeusAtHome_8dca6ede:

    # zeu "*Miau* (¿Pero también estás con estas dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miaou* (Mais tu es aussi avec ces deux filles ? Tu dois être l'équivalent d'un étalon humain !)"

# game/scripts/c25/c25.rpy:3424
translate french c25s005_ZeusAtHome_f1082c23:

    # zeu "*Miau* (¿Pero también esta chica? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miaou* (Mais cette fille aussi ? Tu dois être l'équivalent d'un étalon humain !)"

# game/scripts/c25/c25.rpy:3425
translate french c25s005_ZeusAtHome_9af538dc:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Oui, Zeus, je vais te montrer la maison. Ne me presse pas."

# game/scripts/c25/c25.rpy:3428
translate french c25s005_ZeusAtHome_4346f707:

    # zeu "*Miau* (¿Estás con las dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miaou* (Tu es avec les deux filles ? Tu dois être l'équivalent d'un étalon humain !)"

# game/scripts/c25/c25.rpy:3429
translate french c25s005_ZeusAtHome_9af538dc_1:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Oui, Zeus, je vais te montrer la maison. Ne me presse pas."

# game/scripts/c25/c25.rpy:3430
translate french c25s005_ZeusAtHome_f2dd6715:

    # mc "Os veo luego. Vamos, Zeus."
    mc "À plus tard. Allez, Zeus."

# game/scripts/c25/c25.rpy:3432
translate french c25s005_ZeusAtHome_10a86f4b:

    # "La primera parada es la sala de estar, donde están [kat] y [kim]."
    "Le premier arrêt est le salon, où se trouvent [kat] et [kim]."

# game/scripts/c25/c25.rpy:3433
translate french c25s005_ZeusAtHome_4c34e75e:

    # mc "Hola, chicas. Traigo visita."
    mc "Salut les filles. J'ai des visiteuses."

# game/scripts/c25/c25.rpy:3435
translate french c25s005_ZeusAtHome_d625f10a:

    # kim "¡Qué bonito! Supongo que este debe de ser Zeus."
    kim "Que c'est beau ! Je suppose que c'est Zeus."

# game/scripts/c25/c25.rpy:3436
translate french c25s005_ZeusAtHome_b5e1ca31:

    # zeu "*Miau* (¡Mi fama me precede! Me gustas. Una vez conocí a una gata con la piel como la tuya. Ella era más guapa. Y más peluda.)"
    zeu "*Miaou* (Ma réputation me précède ! Je t'aime bien. J'ai connu une chatte avec un pelage comme le tien. Elle était plus jolie. Et plus poilue.)"

# game/scripts/c25/c25.rpy:3438
translate french c25s005_ZeusAtHome_ce9eba37:

    # zeu "*Miau* (Mía.)"
    zeu "*Miaou* (À moi.)"

# game/scripts/c25/c25.rpy:3440
translate french c25s005_ZeusAtHome_fc52ad29:

    # kat "¡Es precioso!"
    kat "C'est magnifique !"

# game/scripts/c25/c25.rpy:3441
translate french c25s005_ZeusAtHome_f52acb1f:

    # zeu "*Miau* (Tú también eres mía. Tienes pinta de ser mullida para echarme una siesta encima tuyo. Me entra sueño sólo de pensarlo.)"
    zeu "*Miaou* (Tu es à moi aussi. Tu as l'air si duveteux que je pourrais faire une sieste sur toi. J'ai sommeil rien qu'en y pensant.)"

# game/scripts/c25/c25.rpy:3442
translate french c25s005_ZeusAtHome_7f60e2da:

    # mc "Chicas, os tengo que dejar. Voy a seguir enseñándole la casa."
    mc "Les filles, je dois y aller. Je vais continuer à lui faire visiter la maison."

# game/scripts/c25/c25.rpy:3445
translate french c25s005_ZeusAtHome_b2764ae8:

    # kim "Me encanta poder hacer esto ahora."
    kim "J'adore pouvoir faire ça maintenant."

# game/scripts/c25/c25.rpy:3446
translate french c25s005_ZeusAtHome_0b02ff88:

    # mc "A mí también, cielo."
    mc "Moi aussi, chérie."

# game/scripts/c25/c25.rpy:3448
translate french c25s005_ZeusAtHome_1456d3b7:

    # kim "Hasta luego, [mc]. ¿Vendrás a la clase de tiro de [eva]?"
    kim "À plus tard, [mc]. Viendras-tu au cours de tir de [eva] ?"

# game/scripts/c25/c25.rpy:3449
translate french c25s005_ZeusAtHome_ab5ca70d:

    # mc "No, tuve suficiente con la de ayer y tengo algunas cosas que hacer."
    mc "Non, j'en ai assez d'hier et j'ai des choses à faire."

# game/scripts/c25/c25.rpy:3450
translate french c25s005_ZeusAtHome_6e024dc1:

    # kat "Bueno, entonces seremos solo chicas y armas."
    kat "D'accord, alors ce ne sera que des filles et des armes."

# game/scripts/c25/c25.rpy:3452
translate french c25s005_ZeusAtHome_c36c1d98:

    # "La siguiente parada es el baño de la planta baja, dónde nada más levantar la tapa del retrete, Zeus se sube a él."
    "L'étape suivante est la salle de bain du rez-de-chaussée, où, dès que la lunette des toilettes est soulevée, Zeus grimpe dessus."

# game/scripts/c25/c25.rpy:3453
translate french c25s005_ZeusAtHome_89fd84b0:

    # zeu "*¿Miau?* (¿Vas a quedarte ahí mirando?)" id c25s005_ZeusAtHome_89fd84b0
    zeu "*Miaou ?* (Tu vas rester là à me regarder comme ça ?)" id c25s005_ZeusAtHome_89fd84b0

# game/scripts/c25/c25.rpy:3454
translate french c25s005_ZeusAtHome_09c64d23:

    # "Por alguna razón te sientes raro mirando cómo el gato hace sus cosas."
    "Pour une raison inconnue, vous vous sentez mal à l'aise en regardant le chat faire ce qu'il a à faire."

# game/scripts/c25/c25.rpy:3456
translate french c25s005_ZeusAtHome_a98c077a:

    # "Te giras hasta que acaba, para darle un poco de intimidad. No tienes ni idea de si los gatos necesitan intimidad."
    "Vous vous détournez jusqu'à ce que ce soit fini, pour lui laisser un peu d'intimité. Vous n'imaginez pas si les chats ont besoin d'intimité."

# game/scripts/c25/c25.rpy:3457
translate french c25s005_ZeusAtHome_758c4ae1:

    # "No sabe tirar de la cadena en este retrete y lo haces tú."
    "Il ne sait pas comment tirer la chasse d'eau, alors vous le faites pour lui."

# game/scripts/c25/c25.rpy:3459
translate french c25s005_ZeusAtHome_36109bc7:

    # "Al llegar a la habitación de [dap]..."
    "En arrivant dans la chambre de [dap]..."

# game/scripts/c25/c25.rpy:3460
translate french c25s005_ZeusAtHome_daabbe21:

    # sca "Mira que gracioso. Ha ido en seguida a ver el cuadro que [mad.nick] hizo de él."
    sca "C'est drôle. Il est allé directement voir le tableau que [mad.nick] a fait de lui."

# game/scripts/c25/c25.rpy:3461
translate french c25s005_ZeusAtHome_b8eb4aca:

    # zeu "*Miau* (Mia. Te nombro Protectora del Sagrado Retrato del Gato Inteligente.)"
    zeu "*Miaou* (Miaou. Je te nomme Protecteur du Portrait Sacré du Chat Intelligent.)"

# game/scripts/c25/c25.rpy:3462
translate french c25s005_ZeusAtHome_43b6b919:

    # sca "De pequeña quería tener un gato, pero mi madre no me hubiera dejado nunca."
    sca "Enfant, je rêvais d'avoir un chat, mais ma mère ne me l'aurait jamais permis."

# game/scripts/c25/c25.rpy:3463
translate french c25s005_ZeusAtHome_13721b2f:

    # zeu "*¿Miau?* *Miau* (¿Tener? Voy a tener que educarte. Está claro quién es el inteligente aquí.)" id c25s005_ZeusAtHome_13721b2f
    zeu "*Miaou ?* *Miaou* (Avoir ? Je vais devoir t'expliquer. Il est clair que c'est moi qui suis intelligent ici.)" id c25s005_ZeusAtHome_13721b2f

# game/scripts/c25/c25.rpy:3466
translate french c25s005_ZeusAtHome_f12d5351:

    # mc "Le podemos preguntar a [nor] si te dejaría tener uno."
    mc "On peut demander à [nor] s'il vous en laisserait prendre un."

# game/scripts/c25/c25.rpy:3467
translate french c25s005_ZeusAtHome_386cbb86:

    # sca "No hace falta. Creo que Zeus va a venir mucho por casa."
    sca "Ce n'est pas nécessaire. Je pense que Zeus va beaucoup rôder dans la maison."

# game/scripts/c25/c25.rpy:3468
translate french c25s005_ZeusAtHome_4ff0b71f:

    # zeu "*Miau* (Depende. De momento sólo me han dado un trozo de salchicha.)"
    zeu "*Miaou* (Ça dépend. Pour l'instant, ils ne m'ont donné qu'un morceau de saucisse.)"

# game/scripts/c25/c25.rpy:3470
translate french c25s005_ZeusAtHome_ee3410c3:

    # "Salta del armario y sube con curiosidad al regazo de [oma]."
    "Elle sort du placard en sautillant et grimpe curieusement sur les genoux de [oma]."

# game/scripts/c25/c25.rpy:3471
translate french c25s005_ZeusAtHome_c19e3ac0:

    # zeu "*Miau* (Por alguna razón huelo a algo peludo aquí, pero esta chica está perfectamente depilada. Bueno, ahora es mía.)"
    zeu "*Miaou* (Je ne sais pas pourquoi, mais je sens une odeur de fourrure ici, alors que cette fille est parfaitement épilée. Bon, elle est à moi maintenant.)"

# game/scripts/c25/c25.rpy:3472
translate french c25s005_ZeusAtHome_e7bf0abd:

    # oma "Parece que tiene curiosidad por mí. *Risa* Los cachorros son tan monos..."
    oma "Il a l'air curieux à mon sujet. *Rires* Les chiots sont tellement mignons..."

# game/scripts/c25/c25.rpy:3473
translate french c25s005_ZeusAtHome_c3c3ec4e:

    # mc "*Risa* Creo que le atraen las novedades. Vamos, Zeus. Te tengo que acabar de enseñar la casa."
    mc "*Rires* Je crois qu'il est attiré par la nouveauté. Allez, Zeus. Je dois encore te faire visiter la maison."

# game/scripts/c25/c25.rpy:3475
translate french c25s005_ZeusAtHome_d89e55e2:

    # "Cuando os cruzáis con [bet] en la planta superior..."
    "Lorsque vous tombez sur [bet] à l'étage supérieur..."

# game/scripts/c25/c25.rpy:3476
translate french c25s005_ZeusAtHome_09e3044b:

    # zeu "*Bufido* (No me caes bien. Me parece que eres una rival por la comida.)"
    zeu "*Reniflement* (Je ne t'aime pas. Je pense que tu es un rival pour la nourriture.)"

# game/scripts/c25/c25.rpy:3478
translate french c25s005_ZeusAtHome_0058df62:

    # bet "Parece que no le gusto."
    bet "Il semblerait qu'il ne m'aime pas."

# game/scripts/c25/c25.rpy:3479
translate french c25s005_ZeusAtHome_a6206542:

    # mc "Es extraño. Eres la primera con la que reacciona así."
    mc "C'est étrange. Tu es la première personne à qui il réagit comme ça."

# game/scripts/c25/c25.rpy:3480
translate french c25s005_ZeusAtHome_8082c2f6:

    # mc "A lo mejor ya está cansado de pasear por toda la casa."
    mc "Peut-être qu'il en a déjà marre de parcourir toute la maison."

# game/scripts/c25/c25.rpy:3482
translate french c25s005_ZeusAtHome_46078c94:

    # bet "Puedo llevármelo a la cocina y darle algo de comer si quieres."
    bet "Je peux l'emmener à la cuisine et lui donner quelque chose à manger si vous le souhaitez."

# game/scripts/c25/c25.rpy:3483
translate french c25s005_ZeusAtHome_77fa34b1:

    # mc "*Risa* Creo que eso le va a hacer muy feliz."
    mc "*Rires* Je pense que cela la rendra très heureuse."

# game/scripts/c25/c25.rpy:3485
translate french c25s005_ZeusAtHome_fc660de9:

    # zeu "*Miau* (La había juzgado mal. Alguien como ella seguro que sabe dónde está la mejor comida. Ahora es mía.)"
    zeu "*Miaou* (Je l'ai mal jugée. Une personne comme elle sait sûrement où trouver les meilleurs plats. Maintenant, elle est à moi.)"

# game/scripts/c25/c25.rpy:3486
translate french c25s005_ZeusAtHome_9a7a48ca:

    # mc "*Risa* Creo que ya es tu amigo."
    mc "*Rires* Je crois que c'est ton ami maintenant."

# game/scripts/c25/c25.rpy:3487
translate french c25s005_ZeusAtHome_230baf06:

    # bet "*Risa* Sí. Los gatos son tan básicos..."
    bet "*Rires* Oui. Les chats sont tellement basiques..."

# game/scripts/c25/c25.rpy:3489
translate french c25s005_ZeusAtHome_6115ac07:

    # "Durante la comida, Zeus hace nuevas amigas."
    "Au cours du repas, Zeus se fait de nouveaux amis."

# game/scripts/c25/c25.rpy:3491
translate french c25s005_ZeusAtHome_d229ff39:

    # "Todas quieren darle de comer algo."
    "Ils veulent tous lui donner quelque chose à manger."

# game/scripts/c25/c25.rpy:3493
translate french c25s005_ZeusAtHome_fb055bc9:

    # "[mad.nick] da por perdida la batalla por que no se suba a los muebles. El resto de las chicas lo están empezando a malcriar."
    "[mad.nick] considère la bataille perdue car il l'empêche de grimper sur les meubles. Les autres filles commencent à la gâter."

# game/scripts/c25/c25.rpy:3494
translate french c25s005_ZeusAtHome_0c3fbf91:

    # "Al menos está lo suficientemente bien educado como para no coger la comida directamente de los platos."
    "Au moins, il est assez poli pour ne pas prendre la nourriture directement dans les assiettes."

# game/scripts/c25/c25.rpy:3495
translate french c25s005_ZeusAtHome_773d5a9c:

    # "O es lo suficientemente vago como para esperar a que se la den."
    "Ou alors il est assez paresseux pour attendre qu'on le lui donne."

# game/scripts/c25/c25.rpy:3497
translate french c25s005_ZeusAtHome_b419ad78:

    # "Al único que no se acerca es a Jamaal. De todas formas ninguno de los dos iba a compartir su comida con el otro."
    "Le seul qu'il n'aborde pas, c'est Jamaal. De toute façon, aucun des deux n'allait partager sa nourriture avec l'autre."

# game/scripts/c25/c25.rpy:3499
translate french c25s005_ZeusAtHome_e5f1f834:

    # "Supones que, si los gatos tienen un calendario, Zeus estará deseando que lleguen los domingos a partir de ahora."
    "Vous supposez que, si les chats ont un calendrier, Zeus attendra désormais avec impatience les dimanches."

# game/scripts/c25/c25.rpy:3501
translate french c25s005_ZeusAtHome_f3d76e69:

    # "Al acabar de comer..."
    "Après avoir fini de manger..."

# game/scripts/c25/c25.rpy:3502
translate french c25s005_ZeusAtHome_207aa8fa:

    # mad "Chicas, creo que es el momento de darle nuestro regalo a [mc]. Ha llegado esta mañana."
    mad "Les filles, je crois qu'il est temps d'offrir notre cadeau à [mc]. Il est arrivé ce matin."

# game/scripts/c25/c25.rpy:3503
translate french c25s005_ZeusAtHome_34bc92a6:

    # mc "¿Un regalo? ¿Para mí?"
    mc "Un cadeau ? Pour moi ?"

# game/scripts/c25/c25.rpy:3505
translate french c25s005_ZeusAtHome_cbca8d35:

    # mad "Es una tontería que les propuse a algunas de las chicas el viernes y les pareció una buena idea."
    mad "C'est une idée un peu bête que j'ai suggérée à quelques filles vendredi et elles ont trouvé que c'était une bonne idée."

# game/scripts/c25/c25.rpy:3506
translate french c25s005_ZeusAtHome_fd0be7c6:

    # mad "La he mandado a imprimir y me la han entregado poco antes de que llegaras a mi apartamento."
    mad "Je l'ai fait imprimer et il m'a été livré peu de temps avant votre arrivée à mon appartement."

# game/scripts/c25/c25.rpy:3507
translate french c25s005_ZeusAtHome_d41497fe:

    # mc "Pero no es mi cumpleaños ni nada por el estilo..."
    mc "Mais ce n'est pas mon anniversaire ou quoi que ce soit de ce genre..."

# game/scripts/c25/c25.rpy:3509
translate french c25s005_ZeusAtHome_d5efef94:

    # nor "Pero te lo mereces más ahora que si lo fuese."
    nor "Mais tu le mérites davantage maintenant que si c'était le cas."

# game/scripts/c25/c25.rpy:3510
translate french c25s005_ZeusAtHome_aa82bc75:

    # bet "Estoy de acuerdo con [nor]. Ha sido una gran idea por parte de [mad.nick]."
    bet "Je suis d'accord avec [nor]. C'était une excellente idée de [mad.nick]."

# game/scripts/c25/c25.rpy:3511
translate french c25s005_ZeusAtHome_e9575096:

    # mc "Dame ese paquete, [mad.nick]." id c25s005_ZeusAtHome_e9575096
    mc "Donnez-moi ce paquet, [mad.nick]." id c25s005_ZeusAtHome_e9575096

# game/scripts/c25/c25.rpy:3513
translate french c25s005_ZeusAtHome_87a29028:

    # mc "¡Oh! ¿Una camiseta?"
    mc "Oh ! Un t-shirt ?"

# game/scripts/c25/c25.rpy:3514
translate french c25s005_ZeusAtHome_02f708a9:

    # mc "*Risa* ¿A quién se le ha ocurrido la frase?"
    mc "*Rires* Qui a inventé cette expression ?"

# game/scripts/c25/c25.rpy:3515
translate french c25s005_ZeusAtHome_fce971d3:

    # eri "Fue cosa de [mad.nick]. Nos pareció muy graciosa."
    eri "C'était l'œuvre de [mad.nick]. On a trouvé ça hilarant."

# game/scripts/c25/c25.rpy:3516
translate french c25s005_ZeusAtHome_3091e53e:

    # dap "Póntela. Queremos ver cómo te queda."
    dap "Enfile-le. On veut voir ce que ça donne sur toi."

# game/scripts/c25/c25.rpy:3518
translate french c25s005_ZeusAtHome_21b666b0:

    # mc "*Risa* ¡Me encanta!"
    mc "*Rires* J'adore !"

# game/scripts/c25/c25.rpy:3519
translate french c25s005_ZeusAtHome_7e8ba433:

    # mc "'Desafié a la Iglesia y lo único que conseguí fue esta camiseta y un finiquito para mi tía.'"
    mc "« J'ai défié l'Église et tout ce que j'ai obtenu, c'est ce t-shirt et une indemnité de départ pour ma tante. »"

# game/scripts/c25/c25.rpy:3520
translate french c25s005_ZeusAtHome_3b3c29dd:

    # mc "Bien hecho, [mad.nick]. Y gracias a todas."
    mc "Bravo, [mad.nick]. Et merci à tous."

# game/scripts/c25/c25.rpy:3522
translate french c25s005_ZeusAtHome_b551a62a:

    # todas "*Risa* No hay de qué."
    todas "*Rires* De rien."

# game/scripts/c25/c25.rpy:3523
translate french c25s005_ZeusAtHome_9e8be2bd:

    # lis "[mad.nick] es una artista con buenas ideas."
    lis "[mad.nick] est un artiste qui a de bonnes idées."

# game/scripts/c25/c25.rpy:3524
translate french c25s005_ZeusAtHome_8a5e80eb:

    # mad "Chicas... me vais a hacer ruborizar."
    mad "Les filles... vous allez me faire rougir."

# game/scripts/c25/c25.rpy:3526
translate french c25s005_ZeusAtHome_396433db:

    # "Después de unas cuantas risas y de que todos consigáis que [mad.nick] se ruborice, vas a tu habitación."
    "Après quelques rires et après avoir tous réussi à faire rougir [mad.nick], vous allez dans votre chambre."

# game/scripts/c25/c25.rpy:3527
translate french c25s005_ZeusAtHome_7336d122:

    # "Zeus vuelve a ser el centro de atención después de la pequeña interrupción por la camiseta."
    "Zeus est de retour sur le devant de la scène après la brève interruption causée par le t-shirt."

# game/scripts/c25/c25.rpy:3529
translate french c25s005_ZeusAtHome_83af6113:

    # "Ir a comprar los pepinillos no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Le fait d'aller acheter les cornichons ne vous a pas permis de terminer ce que vous faisiez avec les comptes de la chambre."

# game/scripts/c25/c25.rpy:3531
translate french c25s005_ZeusAtHome_ed8271c6:

    # "Ir a comprar el pollo no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Le fait d'aller acheter le poulet ne vous a pas permis de terminer ce que vous faisiez avec les comptes de la chambre."

# game/scripts/c25/c25.rpy:3533
translate french c25s005_ZeusAtHome_a42c4d50:

    # "[nor] te dice que el helado no está listo todavía. Prepararlo con la leche de [mee] ha sido más lento de lo esperado."
    "[nor] vous indique que la glace n'est pas encore prête. Sa préparation avec le lait de [mee] a pris plus de temps que prévu."

# game/scripts/c25/c25.rpy:3548
translate french c25s006_AmaCuddle_aeca0d27:

    # "Al cabo de un rato..."
    "Après un certain temps..."

# game/scripts/c25/c25.rpy:3550
translate french c25s006_AmaCuddle_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c25/c25.rpy:3552
translate french c25s006_AmaCuddle_46915100:

    # ama "*A través de la puerta* Soy yo, ¿puedo pasar?"
    ama "*À travers la porte* C'est moi, puis-je entrer ?"

# game/scripts/c25/c25.rpy:3553
translate french c25s006_AmaCuddle_4d601f0e:

    # mc "Sí, pasa."
    mc "Oui, ça arrive."

# game/scripts/c25/c25.rpy:3555
translate french c25s006_AmaCuddle_d9f612d1:

    # mc "¿Te has cansado ya del gato?"
    mc "Vous en avez déjà assez du chat ?"

# game/scripts/c25/c25.rpy:3556
translate french c25s006_AmaCuddle_730c3bf8:

    # ama "*Risa* No, pero están todas ocupadas con él, con lo que sabía que estarías solo."
    ama "*Rires* Non, mais ils sont tous occupés avec lui, alors je savais que tu serais seule."

# game/scripts/c25/c25.rpy:3557
translate french c25s006_AmaCuddle_98dd9003:

    # mc "¿Quieres hablar de algo?"
    mc "Tu veux parler de quelque chose ?"

# game/scripts/c25/c25.rpy:3560
translate french c25s006_AmaCuddle_8e4413bb:

    # ama "Bueno, quería besarte. *Risita*"
    ama "Eh bien, j'avais envie de t'embrasser. *Rires*"

# game/scripts/c25/c25.rpy:3561
translate french c25s006_AmaCuddle_fb98d4e8:

    # mc "Me parece una buena forma de empezar."
    mc "Je pense que c'est une bonne façon de commencer."

# game/scripts/c25/c25.rpy:3563
translate french c25s006_AmaCuddle_4c1488fc:

    # ama "Y quería darte las gracias por lo que hiciste ayer en el barco."
    ama "Et je voulais vous remercier pour ce que vous avez fait hier sur le bateau."

# game/scripts/c25/c25.rpy:3566
translate french c25s006_AmaCuddle_611a8c6e:

    # ama "Quería darte las gracias por lo que hiciste ayer en el barco."
    ama "Je voulais vous remercier pour ce que vous avez fait hier sur le bateau."

# game/scripts/c25/c25.rpy:3567
translate french c25s006_AmaCuddle_f6d18e4d:

    # mc "Es lo menos que podía hacer. Me pasé la mitad del tiempo que estuve allí queriendo darle un puñetazo en la cara a Ichigo."
    mc "C'est la moindre des choses. J'ai passé la moitié de mon temps là-bas à avoir envie de frapper Ichigo au visage."

# game/scripts/c25/c25.rpy:3569
translate french c25s006_AmaCuddle_f437c1d3:

    # ama "Siempre tienes que sacar el caballero de brillante armadura, ¿no?"
    ama "Il faut toujours faire appel au chevalier en armure étincelante, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:3571
translate french c25s006_AmaCuddle_b64f279c:

    # mc "Anoche lo retuve bastante. Lo que me extraña es que Alejandra nos apoyara."
    mc "Je l'ai pas mal retenu hier soir. Ce qui me surprend, c'est qu'Alejandra nous ait soutenus."

# game/scripts/c25/c25.rpy:3573
translate french c25s006_AmaCuddle_91ba4451:

    # mc "Anoche lo retuve bastante. Fuiste tú quien intervino con lo de [kim] cuando yo me quedé paralizado. Lo que me extraña es que Alejandra nos apoyara."
    mc "Je me suis beaucoup retenue hier soir. C'est toi qui es intervenue avec le truc [kim] quand j'ai paniqué. Ce qui me surprend, c'est qu'Alejandra nous ait soutenues."

# game/scripts/c25/c25.rpy:3575
translate french c25s006_AmaCuddle_0c8268ed:

    # ama "Alejandra estaba allí por negocios. Por suficiente dinero, o en su caso cuando no hay otra opción, se puede aceptar cualquier insulto."
    ama "Alejandra était là pour affaires. Contre une somme d'argent suffisante, ou, dans son cas, faute d'alternative, elle pouvait accepter n'importe quelle insulte."

# game/scripts/c25/c25.rpy:3577
translate french c25s006_AmaCuddle_dde97603:

    # ama "Y fue tu discurso junto con el apoyo de Alejandra lo que me permitió sacar a [kim] de allí."
    ama "Et c'est votre discours, ainsi que le soutien d'Alejandra, qui m'ont permis de sortir de là."

# game/scripts/c25/c25.rpy:3578
translate french c25s006_AmaCuddle_a54cb1f4:

    # ama "De todas formas, que no reaccionaras tan rápido como yo, no significa que no lo fueras a hacer. O eso quiero pensar."
    ama "Bref, ce n'est pas parce que tu n'as pas réagi aussi vite que moi que tu n'aurais pas réagi. Du moins, c'est ce que j'aimerais croire."

# game/scripts/c25/c25.rpy:3579
translate french c25s006_AmaCuddle_a70383bf:

    # mc "¿Dónde vas? ¿Se ha acabado el abrazo?"
    mc "Où vas-tu ? L'étreinte est terminée ?"

# game/scripts/c25/c25.rpy:3581
translate french c25s006_AmaCuddle_e75ae730:

    # ama "No, pero quiero quitarme las botas para continuarlo en la cama, si no te importa."
    ama "Non, mais j'aimerais enlever mes bottes pour qu'on puisse continuer au lit, si ça ne te dérange pas."

# game/scripts/c25/c25.rpy:3582
translate french c25s006_AmaCuddle_f26db8d2:

    # mc "*Risa* No me importa."
    mc "*Rires* Je m'en fiche."

# game/scripts/c25/c25.rpy:3584
translate french c25s006_AmaCuddle_dc888c21:

    # mc "¿Sólo las botas?"
    mc "Juste les bottes ?"

# game/scripts/c25/c25.rpy:3586
translate french c25s006_AmaCuddle_2018f5e4:

    # ama "*Risa* Sí, sólo las botas. No estás pensando que tengo segundas intenciones, ¿verdad? Tan solo quiero un abrazo muy largo."
    ama "*Rires* Oui, juste les bottes. Vous ne pensez pas que j'ai des arrière-pensées, n'est-ce pas ? Je veux juste un très long câlin."

# game/scripts/c25/c25.rpy:3588
translate french c25s006_AmaCuddle_c8c9b586:

    # ama "Y si cae algún beso no voy a decir que no, pero ya está."
    ama "Et s'il y a un baiser, je ne dirai pas non, mais c'est tout."

# game/scripts/c25/c25.rpy:3589
translate french c25s006_AmaCuddle_d8b96890:

    # mc "Abrazos y besos me sirve."
    mc "Les câlins et les bisous, ça marche."

# game/scripts/c25/c25.rpy:3591
translate french c25s006_AmaCuddle_76bee679:

    # ama "¿Vienes?"
    ama "Tu viens ?"

# game/scripts/c25/c25.rpy:3592
translate french c25s006_AmaCuddle_617dfb78:

    # mc "Déjame quitarme las zapatillas."
    mc "Laissez-moi enlever mes chaussures."

# game/scripts/c25/c25.rpy:3594
translate french c25s006_AmaCuddle_2a766e47:

    # ama "Se está bien aquí."
    ama "Il fait bon ici."

# game/scripts/c25/c25.rpy:3595
translate french c25s006_AmaCuddle_faafae77:

    # mc "¿Pasa algo, [ama]? Hoy estás más dulce de lo normal. No es que tenga ninguna queja, pero..."
    mc "Quelque chose ne va pas, [ama] ? Tu es plus gentil que d'habitude aujourd'hui. Je n'ai rien à redire, mais..."

# game/scripts/c25/c25.rpy:3597
translate french c25s006_AmaCuddle_69801c5e:

    # mc "¿Tiene algo que ver que ayer tuviera la cita-entrenamiento con [eva]?"
    mc "Est-ce que cela a un lien avec le fait que j'ai eu la séance de formation avec [eva] hier ?"

# game/scripts/c25/c25.rpy:3599
translate french c25s006_AmaCuddle_ba8a0e6b:

    # ama "No, me he alegrado mucho por ella. Por vosotros dos. Cuando llegué a la base, estaba exultante."
    ama "Non, j'étais très heureux pour elle. Pour vous deux. Quand je suis arrivé à la base, j'étais aux anges."

# game/scripts/c25/c25.rpy:3600
translate french c25s006_AmaCuddle_254f81c9:

    # ama "*Risa* Y si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Rires* Et si vous aviez des reproches à faire parce que je suis plus aimable aujourd'hui, vous n'auriez qu'à faire avec."

# game/scripts/c25/c25.rpy:3603
translate french c25s006_AmaCuddle_76520bf3:

    # ama "*Risa* Si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Rires* Si vous avez des reproches à faire parce que je suis plus aimable aujourd'hui, vous n'aurez qu'à faire avec."

# game/scripts/c25/c25.rpy:3605
translate french c25s006_AmaCuddle_0562a6f7:

    # ama "Tan solo quiero pasar un rato a solas con mi novio, sin hacer nada. No hemos tenido mucho tiempo desde... aquel beso. Siempre estamos hablando de trabajo."
    ama "J'aimerais juste passer un peu de temps seule avec mon copain, à ne rien faire. On n'a pas eu beaucoup de temps depuis… ce baiser. On parle toujours du travail."

# game/scripts/c25/c25.rpy:3607
translate french c25s006_AmaCuddle_2275ad91:

    # ama "Tan solo quiero pasar un rato a solas con mi hermano, sin hacer nada. No hemos tenido muchas oportunidades de pasar tiempo juntos si no era por trabajo."
    ama "J'aimerais juste passer un peu de temps seul avec mon frère, à ne rien faire. On n'a pas souvent l'occasion de passer du temps ensemble, sauf pour le travail."

# game/scripts/c25/c25.rpy:3608
translate french c25s006_AmaCuddle_7f377dcb:

    # mc "Un día tenemos que ir tú y yo a comer, o a cenar. Nada en plan cita. Sólo tú y yo pasando un rato juntos."
    mc "On devrait aller déjeuner ou dîner un de ces jours, juste toi et moi. Rien de tel qu'un rendez-vous. Juste toi et moi, passer un moment ensemble."

# game/scripts/c25/c25.rpy:3610
translate french c25s006_AmaCuddle_b19eddd6:

    # mc "Tenemos que tener tú y yo también una cita algún día."
    mc "Il faudrait qu'on se voie un de ces jours, toi et moi."

# game/scripts/c25/c25.rpy:3612
translate french c25s006_AmaCuddle_33be946b:

    # ama "Estaría bien, pero vas a estar muy ocupado antes de que vayamos a Aruba. Una vez allí te llevaré a mi restaurante favorito."
    ama "Ce serait sympa, mais tu seras très occupé avant notre départ pour Aruba. Une fois sur place, je t'emmènerai dans mon restaurant préféré."

# game/scripts/c25/c25.rpy:3613
translate french c25s006_AmaCuddle_019feb62:

    # mc "¿Vendrás tú conmigo? ¿[eva] se quedará aquí protegiendo a la familia?"
    mc "Viendras-tu avec moi ? [eva] restera-t-il ici pour protéger la famille ?"

# game/scripts/c25/c25.rpy:3615
translate french c25s006_AmaCuddle_615741e7:

    # ama "Aún no está preparada para ver a Gavin. Aún está muy afectada por lo que pasó, con que perdiera el brazo. Estaré yo contigo el primer mes."
    ama "Elle n'est pas encore prête à voir Gavin. Elle est encore très bouleversée par ce qui s'est passé, par la perte de son bras. Je serai avec toi pendant le premier mois."

# game/scripts/c25/c25.rpy:3616
translate french c25s006_AmaCuddle_a02ed068:

    # ama "Después iremos rotando, un mes cada una allí mientras la otra está aquí."
    ama "Ensuite, nous ferons des rotations, l'un de nous là-bas pendant un mois pendant que l'autre est ici."

# game/scripts/c25/c25.rpy:3617
translate french c25s006_AmaCuddle_36a0b53c:

    # mc "Me parece una buena idea. ¿Estará preparada dentro de un mes?"
    mc "Ça me paraît une bonne idée. Ce sera prêt dans un mois ?"

# game/scripts/c25/c25.rpy:3620
translate french c25s006_AmaCuddle_4fc1e6b9:

    # ama "Eso espero. No tengo ganas de estar lejos de las chicas más de ese tiempo."
    ama "Je l'espère. Je ne veux pas rester loin des filles plus longtemps."

# game/scripts/c25/c25.rpy:3622
translate french c25s006_AmaCuddle_f4f04ed7:

    # ama "Eso espero. Se va a tener que enfrentar a ese tema tarde o temprano."
    ama "Je l'espère. Il devra affronter ce problème tôt ou tard."

# game/scripts/c25/c25.rpy:3624
translate french c25s006_AmaCuddle_642c555e:

    # ama "Y, después de lo de ayer, dudo que ella quiera estar lejos de ti más de un mes."
    ama "Et, après ce qui s'est passé hier, je doute qu'elle veuille être loin de toi pendant plus d'un mois."

# game/scripts/c25/c25.rpy:3625
translate french c25s006_AmaCuddle_855b4530:

    # mc "¿Cómo te sientes tú por tener que volver a Aruba?"
    mc "Que pensez-vous de devoir retourner à Aruba ?"

# game/scripts/c25/c25.rpy:3627
translate french c25s006_AmaCuddle_3d1a5af3:

    # ama "Tengo sentimientos conflictivos. Quiero enseñarte dónde crecimos, pero hay sitios que me traerán recuerdos tristes."
    ama "J'ai des sentiments partagés. Je veux te montrer où nous avons grandi, mais certains endroits vont raviver de tristes souvenirs."

# game/scripts/c25/c25.rpy:3628
translate french c25s006_AmaCuddle_d56b9c53:

    # mc "Lo entiendo."
    mc "Je comprends."

# game/scripts/c25/c25.rpy:3630
translate french c25s006_AmaCuddle_973951c8:

    # ama "Y descubrirás una parte... monstruosa de mí."
    ama "Et vous découvrirez une part monstrueuse de moi."

# game/scripts/c25/c25.rpy:3631
translate french c25s006_AmaCuddle_85c68686:

    # mc "No creo que haya ninguna parte monstruosa en ti, [ama]. Te obligaron a hacer cosas monstruosas, pero no eres un monstruo."
    mc "Je ne pense pas qu'il y ait quoi que ce soit de monstrueux en toi, [ama]. Tu as été forcé de faire des choses monstrueuses, mais tu n'es pas un monstre."

# game/scripts/c25/c25.rpy:3633
translate french c25s006_AmaCuddle_e5fd6cf2:

    # ama "No me refiero a eso. Te enseñaré mi posesión más preciada, y a lo mejor entonces piensas que estoy mal de la cabeza."
    ama "Ce n'est pas ce que je veux dire. Je vais vous montrer mon bien le plus précieux, et vous penserez sans doute que je suis fou."

# game/scripts/c25/c25.rpy:3634
translate french c25s006_AmaCuddle_f5b226b8:

    # mc "¿Qué es?"
    mc "Qu'est-ce que c'est?"

# game/scripts/c25/c25.rpy:3636
translate french c25s006_AmaCuddle_f3609450:

    # ama "No sé si decírtelo... no me corresponde sólo a mí."
    ama "Je ne sais pas si je devrais vous le dire… ce n’est pas uniquement de ma responsabilité."

# game/scripts/c25/c25.rpy:3637
translate french c25s006_AmaCuddle_811f780f:

    # mc "No te preocupes. Ya llegará el momento de hacerlo."
    mc "Ne t'inquiète pas. Le moment viendra."

# game/scripts/c25/c25.rpy:3638
translate french c25s006_AmaCuddle_321ec4e6:

    # ama "Gracias..."
    ama "Merci..."

# game/scripts/c25/c25.rpy:3639
translate french c25s006_AmaCuddle_30e9b407:

    # mc "Como supongo que tiene que ver con [eva], ¿le has dicho que me lo enseñarás cuando estemos allí?"
    mc "Puisque je suppose que cela a quelque chose à voir avec [eva], lui as-tu dit que tu me le montrerais quand nous serons là-bas ?"

# game/scripts/c25/c25.rpy:3641
translate french c25s006_AmaCuddle_a860af8f:

    # ama "No, aún no... Me da un poco de miedo decírselo."
    ama "Non, pas encore... J'ai un peu peur de lui dire."

# game/scripts/c25/c25.rpy:3642
translate french c25s006_AmaCuddle_f777227d:

    # mc "No le des más vueltas. Si es una cosa vuestra, obviamente me gustaría saberlo, pero habrá tiempo, siempre y cuando [eva] acepte contármelo."
    mc "N'y pense pas trop. Si c'est quelque chose entre vous deux, évidemment j'aimerais le savoir, mais il y aura du temps, du moment que [eva] accepte de me le dire."

# game/scripts/c25/c25.rpy:3643
translate french c25s006_AmaCuddle_87cc63f9:

    # ama "Gracias. Para nosotras es muy especial. Para otras personas sería algo... macabro."
    ama "Merci. C'est très précieux pour nous. Pour d'autres, cela pourrait paraître… macabre."

# game/scripts/c25/c25.rpy:3645
translate french c25s006_AmaCuddle_bb3f24f8:

    # mc "Hablando de cosas especiales. ¿Qué tiene de especial el collar de [eva]?"
    mc "En parlant de choses spéciales, qu'est-ce qui rend le collier de [eva] si spécial ?"

# game/scripts/c25/c25.rpy:3647
translate french c25s006_AmaCuddle_ad683714:

    # mc "Le he visto ese corazón puesto cada vez que ha hecho algo... nuevo, por decirlo de alguna forma."
    mc "J'ai vu cette passion en lui à chaque fois qu'il a fait quelque chose de... nouveau, pour ainsi dire."

# game/scripts/c25/c25.rpy:3648
translate french c25s006_AmaCuddle_003e478f:

    # mc "La primera visita con la familia, lo de ayer, y alguna vez más."
    mc "La première visite à la famille, la visite d'hier et une autre fois."

# game/scripts/c25/c25.rpy:3650
translate french c25s006_AmaCuddle_31f6a996:

    # ama "No te lo puedo decir, [mc]. Se lo deberías preguntar a ella..."
    ama "Je ne peux pas te le dire, [mc]. Tu devrais lui demander..."

# game/scripts/c25/c25.rpy:3651
translate french c25s006_AmaCuddle_c34ef301:

    # mc "No te preocupes. Espero que no sea nada... ¿cómo has dicho? Ah, sí. Macabro."
    mc "Ne t'inquiète pas. J'espère que ce n'est rien... Qu'est-ce que tu as dit ? Ah oui. Flippant."

# game/scripts/c25/c25.rpy:3655
translate french c25s006_AmaCuddle_2c8733c9:

    # mc "Cambiando de tema. ¿Hay alguien a quien quieras evitar en Aruba?"
    mc "Pour changer de sujet, y a-t-il quelqu'un que vous aimeriez éviter à Aruba ?"

# game/scripts/c25/c25.rpy:3657
translate french c25s006_AmaCuddle_947dcd6f:

    # ama "Especialmente a Daniels. Por su culpa murieron tres de mis hermanas y Arnau, el hermano de Aaron."
    ama "Surtout Daniels. À cause de lui, trois de mes sœurs et Arnau, le frère d'Aaron, sont morts."

# game/scripts/c25/c25.rpy:3658
translate french c25s006_AmaCuddle_9c96c333:

    # mc "Lo entiendo. No tienes por qué verlo. Aaron y yo nos podemos ocupar de hacer lo que sea necesario."
    mc "Je comprends. Vous n'êtes pas obligé de le voir. Aaron et moi pouvons nous occuper de tout ce qu'il y a à faire."

# game/scripts/c25/c25.rpy:3661
translate french c25s006_AmaCuddle_58cc0162:

    # ama "Gracias. ¿Por qué no te callas y me dejas disfrutar de este abrazo en paz? No quiero pensar en trabajo."
    ama "Merci. Pourquoi ne pas vous taire et me laisser profiter de ce câlin en paix ? Je ne veux pas penser au travail."

# game/scripts/c25/c25.rpy:3664
translate french c25s006_AmaCuddle_b9c8e4f9:

    # ama "Gracias. Sois muy parecidos y no me vais a dejar hacer nada que me haga daño."
    ama "Merci. Vous êtes très semblables et vous ne me laisserez rien faire qui puisse me blesser."

# game/scripts/c25/c25.rpy:3665
translate french c25s006_AmaCuddle_f05d1af5:

    # mc "En eso consiste protegerte, ¿no? Me encanta que, alguna vez, podamos ser otros los que te protegemos a ti."
    mc "C'est ça, vous protéger, non ? J'adore le fait que, parfois, ce soit nous qui vous protégions."

# game/scripts/c25/c25.rpy:3667
translate french c25s006_AmaCuddle_4c9ecae2:

    # ama "*Risa* El caballero de brillante armadura ha vuelto."
    ama "*Rires* Le chevalier en armure étincelante est de retour."

# game/scripts/c25/c25.rpy:3668
translate french c25s006_AmaCuddle_d9a20a23:

    # mc "*Risa* Ni siquiera me había dado cuenta."
    mc "*Rires* Je ne l'avais même pas remarqué."

# game/scripts/c25/c25.rpy:3669
translate french c25s006_AmaCuddle_67a4ac62:

    # mc "Pero no querías que habláramos de trabajo..."
    mc "Mais vous ne vouliez pas qu'on parle de travail..."

# game/scripts/c25/c25.rpy:3671
translate french c25s006_AmaCuddle_31c71ae0:

    # ama "No, quería disfrutar de un abrazo en silencio. *Risa* Pero eso contigo es imposible."
    ama "Non, je voulais juste un câlin silencieux. *Rires* Mais c'est impossible avec toi."

# game/scripts/c25/c25.rpy:3672
translate french c25s006_AmaCuddle_cb0ba765:

    # mc "*Risa* ¿Hablo demasiado?"
    mc "*Rires* Est-ce que je parle trop ?"

# game/scripts/c25/c25.rpy:3673
translate french c25s006_AmaCuddle_0e7ec165:

    # ama "*Risa* La mayoría del tiempo."
    ama "*Rires* La plupart du temps."

# game/scripts/c25/c25.rpy:3674
translate french c25s006_AmaCuddle_dc2bd698:

    # mc "*Risa* Déjame hacerte una última pregunta y me callaré."
    mc "*Rires* Permettez-moi de vous poser une dernière question et ensuite je me tais."

# game/scripts/c25/c25.rpy:3676
translate french c25s006_AmaCuddle_a30458cd:

    # ama "*Risa* Me das miedo. Haz esa pregunta."
    ama "*Rires* Tu me fais peur. Pose cette question."

# game/scripts/c25/c25.rpy:3677
translate french c25s006_AmaCuddle_3e88635e:

    # mc "Dices que tengo que esperar a llegar a Aruba para una cita contigo. ¿Por qué no podemos ir a cenar mañana, por ejemplo?"
    mc "Tu dis que je dois attendre d'être à Aruba pour un rendez-vous avec toi. Pourquoi ne pas aller dîner demain, par exemple ?"

# game/scripts/c25/c25.rpy:3679
translate french c25s006_AmaCuddle_aa536e84:

    # ama "Porque no soy como [sai]."
    ama "Parce que je ne suis pas comme [sai]."

# game/scripts/c25/c25.rpy:3680
translate french c25s006_AmaCuddle_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c25/c25.rpy:3681
translate french c25s006_AmaCuddle_ef86d131:

    # ama "Sabes que [sai] estuvo planificando vuestra primera vez juntos desde vuestra primera cita, ¿no?"
    ama "Tu sais que [sai] planifie votre première fois ensemble depuis votre premier rendez-vous, n'est-ce pas ?"

# game/scripts/c25/c25.rpy:3682
translate french c25s006_AmaCuddle_af008da4:

    # mc "Sí, lo ha comentado varias veces. Siempre me pareció gracioso que se pasara una semana planeándolo para que fuera perfecto."
    mc "Oui, il l'a mentionné à plusieurs reprises. J'ai toujours trouvé ça amusant qu'il ait passé une semaine à tout planifier pour que ce soit parfait."

# game/scripts/c25/c25.rpy:3683
translate french c25s006_AmaCuddle_6ce0b2fd:

    # mc "¿Quieres decir que no quieres planearlo?"
    mc "Vous voulez dire que vous ne voulez pas le planifier ?"

# game/scripts/c25/c25.rpy:3685
translate french c25s006_AmaCuddle_d5dec225:

    # ama "Quiero decir que no quiero pensar en ello. A diferencia de [sai], no considero el sexo importante."
    ama "Je veux dire, je ne veux pas y penser. Contrairement à [sai], je ne considère pas le sexe comme important."

# game/scripts/c25/c25.rpy:3686
translate french c25s006_AmaCuddle_56833dc0:

    # ama "Sé que para ti sí que lo es, pero yo me podría pasar los próximos meses haciendo solo esto, abrazándonos."
    ama "Je sais que c'est important pour toi, mais je pourrais passer les prochains mois à faire juste ça, à nous enlacer."

# game/scripts/c25/c25.rpy:3688
translate french c25s006_AmaCuddle_f2aba790:

    # ama "Y esto."
    ama "Et ceci."

# game/scripts/c25/c25.rpy:3690
translate french c25s006_AmaCuddle_dd444808:

    # ama "Estar así, abrazados, es suficiente para mí ahora mismo."
