    kat "*Halètement* Quoi ? Oh, salut [mc] !"

# game/scripts/c25/c25.rpy:2759
translate french c25s004_KimDebLisaSai_d2e03d80:

    # "Oyes ruido de gente moviéndose."
    "On entend des bruits de pas."

# game/scripts/c25/c25.rpy:2760
translate french c25s004_KimDebLisaSai_b4e0fc81:

    # mc "¿Qué tal, [kat]? ¿Estás sola?"
    mc "Comment vas-tu, [kat] ? Es-tu seul(e) ?"

# game/scripts/c25/c25.rpy:2763
translate french c25s004_KimDebLisaSai_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c25/c25.rpy:2764
translate french c25s004_KimDebLisaSai_c535d765:

    # "Oyes cerrarse la habitación de [sai]."
    "Vous entendez la porte de la chambre [sai] se fermer."

# game/scripts/c25/c25.rpy:2766
translate french c25s004_KimDebLisaSai_e4a8b87d:

    # kat "No, estoy con [eil]. Estábamos charlando."
    kat "Non, je suis avec [eil]. On discutait."

# game/scripts/c25/c25.rpy:2767
translate french c25s004_KimDebLisaSai_12067155:

    # mc "Ah, okay. No os molesto. Iba de camino a mi habitación."
    mc "Ah, d'accord. Je ne vous dérangerai pas. J'allais dans ma chambre."

# game/scripts/c25/c25.rpy:2769
translate french c25s004_KimDebLisaSai_8810d176:

    # "Subes hasta el rellano."
    "Vous montez jusqu'au palier."

# game/scripts/c25/c25.rpy:2770
translate french c25s004_KimDebLisaSai_6a00cd21:

    # mc "Hola, [eil]. ¿No trabajas hoy?"
    mc "Salut, [eil]. Tu ne travailles pas aujourd'hui ?"

# game/scripts/c25/c25.rpy:2771
translate french c25s004_KimDebLisaSai_67dc9595:

    # eil "Esta tarde. [eri] y yo entramos tarde hoy."
    eil "Cet après-midi. [eri] et moi sommes arrivés en retard aujourd'hui."

# game/scripts/c25/c25.rpy:2772
translate french c25s004_KimDebLisaSai_46ff96f9:

    # mcp "(Conozco esa sonrisa. Ella sabe que yo sé que oculta algo.)"
    mcp "(Je connais ce sourire. Elle sait que je sais qu'elle cache quelque chose.)"

# game/scripts/c25/c25.rpy:2773
translate french c25s004_KimDebLisaSai_eac49f44:

    # mc "Okay. Decídmelo si necesitáis que os lleve. Estaré en mi habitación trabajando un poco hasta la hora de comer."
    mc "D'accord. Préviens-moi si tu as besoin que je te dépose. Je serai dans ma chambre à travailler jusqu'à midi."

# game/scripts/c25/c25.rpy:2775
translate french c25s004_KimDebLisaSai_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "À plus tard, les filles."

# game/scripts/c25/c25.rpy:2776
translate french c25s004_KimDebLisaSai_6ad62d0c:

    # kat "Hasta luego, [mc]." (multiple=2)
    kat "À plus tard, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2777
translate french c25s004_KimDebLisaSai_a9c1d0ed:

    # eil "Hasta luego, [mc]." (multiple=2)
    eil "À plus tard, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2779
translate french c25s004_KimDebLisaSai_2fdb8487:

    # "Abres la puerta de tu habitación para dejar el móvil antes de ir al lavabo."
    "Vous ouvrez la porte de votre chambre pour ranger votre téléphone avant d'aller aux toilettes."

# game/scripts/c25/c25.rpy:2780
translate french c25s004_KimDebLisaSai_8fbaa740:

    # "En el momento en que cierras tu puerta, oyes cómo se abre la de [sai]."
    "Au moment où vous fermez votre porte, vous entendez celle de [sai] s'ouvrir."

# game/scripts/c25/c25.rpy:2781
translate french c25s004_KimDebLisaSai_5a4dd715:

    # sai "[kat], te tenías que ocupar de vigilar que no viniera nadie. Y menos aún [mc]."
    sai "[kat], il fallait s'assurer que personne ne vienne. Et encore moins [mc]."

# game/scripts/c25/c25.rpy:2782
translate french c25s004_KimDebLisaSai_767591b8:

    # kat "Lo siento. La conversación estaba interesante y no lo he oído llegar."
    kat "Je suis désolé(e). La conversation était intéressante et je ne vous ai pas entendu(e) arriver."

# game/scripts/c25/c25.rpy:2783
translate french c25s004_KimDebLisaSai_359ef0e4:

    # deb "A mí me ha pasado lo mismo. Estaba tan atenta a lo que decíais que no lo he oído llegar."
    deb "La même chose m'est arrivée. J'étais tellement concentré sur ce que tu disais que je ne l'ai pas entendu venir."

# game/scripts/c25/c25.rpy:2785
translate french c25s004_KimDebLisaSai_143d600b:

    # deb "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    deb "Et cela en supposant que je doute de jamais dîner seule avec lui."

# game/scripts/c25/c25.rpy:2786
translate french c25s004_KimDebLisaSai_5a72e6b1:

    # lis "Estoy en la misma situación que [deb.nick]."
    lis "Je suis dans la même situation que [deb.nick]."

# game/scripts/c25/c25.rpy:2788
translate french c25s004_KimDebLisaSai_3882306f:

    # lis "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    lis "Et cela en supposant que je doute de jamais dîner seule avec lui."

# game/scripts/c25/c25.rpy:2789
translate french c25s004_KimDebLisaSai_3fce954d:

    # kim "Es que lo explicáis de tal forma que es casi como estar ahí, en vuestras citas."
    kim "Vous l'expliquez de telle manière que c'est presque comme si vous y étiez, à vos rendez-vous."

# game/scripts/c25/c25.rpy:2791
translate french c25s004_KimDebLisaSai_256bcef7:

    # kim "Aunque dudo que me vayan a servir de mucho esos conocimientos."
    kim "Bien que je doute que ces connaissances me soient d'une grande utilité."

# game/scripts/c25/c25.rpy:2792
translate french c25s004_KimDebLisaSai_f3e4baaa:

    # eil "Chicas, no sé si nos ha oído, pero sabe que estaba pasando algo. Se lo he leído en la cara."
    eil "Les filles, je ne sais pas si elle nous a entendues, mais elle savait que quelque chose se passait. Ça se voyait sur son visage."

# game/scripts/c25/c25.rpy:2794
translate french c25s004_KimDebLisaSai_daa8d239:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si no las he querido escuchar antes, mejor será no hacerlo ahora.)"
    mcp "(Je ferais mieux de reprendre ce que je faisais. Si je ne voulais pas les écouter avant, il vaut mieux ne pas le faire maintenant.)"

# game/scripts/c25/c25.rpy:2796
translate french c25s004_KimDebLisaSai_a446b3de:

    # kat "Bueno, ya se ha ido. Ibas a hablar del columpio, [eil]."
    kat "Bon, il est parti maintenant. Tu allais parler du swing, [eil]."

# game/scripts/c25/c25.rpy:2797
translate french c25s004_KimDebLisaSai_a1fc8034:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si van a empezar a hablar de [eil] y de mí en el columpio...)"
    mcp "(Je ferais mieux de reprendre ce que je faisais. S'ils commencent à parler de [eil] et de moi sur la balançoire...)"

# game/scripts/c25/c25.rpy:2800
translate french c25s004_KimDebLisaSai_9bf43002:

    # "Vas al lavabo y trabajas durante una hora, hasta que empieza a entrarte sed. Sigues sin acordarte de coger una botella de agua."
    "Vous allez aux toilettes et travaillez pendant une heure, jusqu'à ce que la soif vous prenne. Vous oubliez toujours de prendre une bouteille d'eau."

# game/scripts/c25/c25.rpy:2801
translate french c25s004_KimDebLisaSai_0e4aee02:

    # "Bajas a la cocina a beber algo."
    "Vous descendez à la cuisine pour prendre un verre."

# game/scripts/c25/c25.rpy:2805
translate french c25s004_Listen_e330979f:

    # "Por sus voces las puedes imaginar sentadas en el suelo, alrededor de las dos maestras."
    "À entendre leurs voix, on les imagine assis par terre, autour des deux professeurs."

# game/scripts/c25/c25.rpy:2806
translate french c25s004_Listen_3d3682ee:

    # "Casi se te escapa la risa y delatas tu presencia."
    "Vous avez failli éclater de rire et révéler votre présence."

# game/scripts/c25/c25.rpy:2808
translate french c25s004_Listen_4ebdddd8:

    # kim "¿Dónde lo llevaste a cenar en tu primera cita, [sai]?"
    kim "Où l'as-tu emmené dîner lors de votre premier rendez-vous, [sai] ?"

# game/scripts/c25/c25.rpy:2810
translate french c25s004_Listen_1e00e275:

    # sai "Bueno, fue él quien me llevó a comer a mí, no a cenar. Fue en un restaurante escandinavo. Pero no fue la primera cita. Esa había sido en la cafetería de la que os he hablado."
    sai "En fait, c'est lui qui m'a invitée à déjeuner, pas à dîner. C'était dans un restaurant scandinave. Mais ce n'était pas notre premier rendez-vous. Celui-là, c'était au café dont je t'ai parlé."

# game/scripts/c25/c25.rpy:2811
translate french c25s004_Listen_41f2ece9:

    # sai "Por si os interesa, pidió albóndigas suecas y smorrebrod, o como se diga."
    sai "Si ça vous intéresse, il a commandé des boulettes de viande suédoises et des smørrebrød, ou quelque chose comme ça."

# game/scripts/c25/c25.rpy:2813
translate french c25s004_Listen_1ec9791d:

    # eil "*Risa* Me lo imaginaba. Lo que me hubiera sorprendido es que hubiese pedido arenque."
    eil "*Rires* Je m'en doutais. Ce qui m'aurait surpris, c'est qu'il ait commandé du hareng."

# game/scripts/c25/c25.rpy:2815
translate french c25s004_Listen_26125ae6:

    # deb "¿Y tú, [eil]? ¿Cómo fue vuestra primera cita?"
    deb "Et toi, [eil] ? Comment s'est passé ton premier rendez-vous ?"

# game/scripts/c25/c25.rpy:2817
translate french c25s004_Listen_da3bec1c:

    # eil "Te va a parecer gracioso, pero nunca tuvimos una 'primera cita'. Nos veíamos todos los días en el instituto, la cosa entre nosotros surgió poco a poco."
    eil "Ça va te faire rire, mais on n'a jamais eu de « premier rendez-vous ». On se voyait tous les jours à l'école, et les choses se sont développées petit à petit entre nous."

# game/scripts/c25/c25.rpy:2818
translate french c25s004_Listen_bc26e0c0:

    # eil "Para cuando nos dimos cuenta, estábamos saliendo y no habíamos tenido una cita. La mayoría de las veces comíamos con Jamaal. Imaginaos qué romántico era todo. *Risa*"
    eil "Avant même de nous en rendre compte, on se voyait déjà sans même être sortis ensemble. La plupart du temps, on déjeunait juste avec Jamaal. Imaginez un peu le romantisme ! *Rires*"

# game/scripts/c25/c25.rpy:2821
translate french c25s004_Listen_92ed8ad3:

    # lis "A mí me gustaría tener una primera cita. Sería algo que recordar siempre y... no sé... como una fecha para nuestro aniversario de salir juntos."
    lis "J'adorerais avoir un premier rendez-vous. Ce serait un moment inoubliable et… je ne sais pas… comme un rendez-vous pour notre anniversaire de rencontre."

# game/scripts/c25/c25.rpy:2823
translate french c25s004_Listen_ce44d423:

    # lis "Cuando salga con alguien, me gustaría tener una primera cita. Sería algo que recordar siempre y como una fecha para nuestro aniversario de salir juntos."
    lis "Quand je commencerai à fréquenter quelqu'un, j'aimerais avoir un premier rendez-vous mémorable, un peu comme la date de notre anniversaire."

# game/scripts/c25/c25.rpy:2824
translate french c25s004_Listen_283ad907:

    # lis "*Risita* Al menos hasta que pueda sustituírlo por el aniversario de boda."
    lis "*Rires* Du moins jusqu'à ce que je puisse le remplacer par l'anniversaire de mariage."

# game/scripts/c25/c25.rpy:2827
translate french c25s004_Listen_8aa32af2:

    # deb "No digas tonterías, [lis]. Tienes marcado en tu diario el día que te besó por primera vez, cuando os encerré en nuestra habitación."
    deb "Ne dis pas de bêtises, [lis]. Tu as noté dans ton journal le jour où il t'a embrassée pour la première fois, quand je t'ai enfermée dans notre chambre."

# game/scripts/c25/c25.rpy:2828
translate french c25s004_Listen_afa4cd12:

    # deb "Creo que, cuando se cumpla un año de ese beso, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Je pense que lorsque viendra l'anniversaire de ce baiser, tu le célébreras davantage que celui de ton futur premier rendez-vous."

# game/scripts/c25/c25.rpy:2830
translate french c25s004_Listen_64db342a:

    # deb "No digas tonterías, [lis]. Si te hubiera besado cuando os encerré en nuestra habitación, tendrías ese día marcado en tu diario."
    deb "Ne dis pas de bêtises, [lis]. Si je t'avais embrassé quand je t'ai enfermé dans notre chambre, tu aurais noté cette date dans ton journal."

# game/scripts/c25/c25.rpy:2831
translate french c25s004_Listen_7eb04199:

    # deb "Creo que, cuando se cumpla un año de tu primer beso cuando salgas con alguien, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Je pense que lorsque viendra l'anniversaire de votre premier baiser avec quelqu'un, vous le célébrerez davantage que celui de votre futur premier rendez-vous."

# game/scripts/c25/c25.rpy:2833
translate french c25s004_Listen_77282ea8:

    # deb "A mí me gustaría celebrar como nuestro aniversario el día que nos besamos en el lago por primera vez."
    deb "J'aimerais célébrer le jour où nous nous sommes embrassés pour la première fois au bord du lac comme notre anniversaire."

# game/scripts/c25/c25.rpy:2835
translate french c25s004_Listen_7d823dbe:

    # kat "Pero eso es porque tú y [kim] sois unas románticas. *Risa* La mayoría de la gente celebra la boda."
    kat "Mais c'est parce que toi et [kim] êtes de grands romantiques. *Rires* La plupart des gens célèbrent le mariage."

# game/scripts/c25/c25.rpy:2836
translate french c25s004_Listen_261a1a24:

    # kat "Pero la pregunta importante es... ¿Lees el diario de tu hermana, [deb.nick]?"
    kat "Mais la question importante est... Lis-tu le journal intime de ta sœur, [deb.nick] ?"

# game/scripts/c25/c25.rpy:2838
translate french c25s004_Listen_60629825:

    # sai "Chicas, guardad vuestros diarios bajo llave. *Risa* Tenemos una espía."
    sai "Les filles, rangez vos journaux intimes ! *Rires* On a un espion !"

# game/scripts/c25/c25.rpy:2839
translate french c25s004_Listen_2f6e62de:

    # mcp "(*Risa mental* Sí, pero no tiene que ver con los diarios.)"
    mcp "(*Rires intérieurs* Oui, mais ça n'a rien à voir avec les journaux intimes.)"

# game/scripts/c25/c25.rpy:2841
translate french c25s004_Listen_9f506759:

    # lis "*Risa* Siempre se lo he dejado leer. Es un diario online y tiene permiso para leerlo... al menos tiene permisos para ver algunas entradas."
    lis "*Rires* Je l'ai toujours laissé le lire. C'est un journal en ligne et il a la permission de le lire… enfin, il a la permission de voir certains articles."

# game/scripts/c25/c25.rpy:2842
translate french c25s004_Listen_a958c3d2:

    # lis "Nos ha ido muy bien algunas veces. Ya sabéis que a veces me pongo muy estúpida sin venir a cuento."
    lis "On a parfois vraiment bien réussi. Tu sais à quel point je peux devenir bête sans raison."

# game/scripts/c25/c25.rpy:2843
translate french c25s004_Listen_0e536994:

    # todas "*Risa* Sí."
    todas "*Rires* Oui."

# game/scripts/c25/c25.rpy:2845
translate french c25s004_Listen_7dcc2caf:

    # kim "*Risa* Somos unas malas amigas... Tendríamos que haberle dicho, 'No, [lis], siempre que te pones estúpida es por una razón justificada.'"
    kim "*Rires* On est de mauvaises amies... On aurait dû lui dire : « Non, [lis], chaque fois que tu fais l'idiote, c'est pour une raison justifiée. »"

# game/scripts/c25/c25.rpy:2846
translate french c25s004_Listen_3e51f1da:

    # kim "*Risa* Pero mentir también es de malas amigas... Estoy en una encrucijada."
    kim "*Rires* Mais mentir, c'est aussi fréquenter de mauvaises personnes… Je suis à la croisée des chemins."

# game/scripts/c25/c25.rpy:2847
translate french c25s004_Listen_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c25/c25.rpy:2849
translate french c25s004_Listen_23de23e2:

    # lis "*Risa* Te robaré el pintalabios como venganza por lo que acabas de decir."
    lis "*Rires* Je vais te voler ton rouge à lèvres pour me venger de ce que tu viens de dire."

# game/scripts/c25/c25.rpy:2850
translate french c25s004_Listen_63251888:

    # lis "Es broma. Me encanta que me digáis lo que hago mal. Hasta ahora sólo se atrevía [deb.nick]."
    lis "Je plaisante. J'adore quand tu me dis ce que je fais mal. Jusqu'à présent, seul [deb.nick] avait osé le faire."

# game/scripts/c25/c25.rpy:2852
translate french c25s004_Listen_f25147f6:

    # kat "Chicas, nos estamos desviando del tema. Estábamos hablando de [mc]."
    kat "Les filles, on s'éloigne du sujet. On parlait de [mc]."

# game/scripts/c25/c25.rpy:2853
translate french c25s004_Listen_972239aa:

    # kat "[eil], la última vez estabas diciendo algo de un columpio."
    kat "[eil], la dernière fois tu parlais d'un swing."

# game/scripts/c25/c25.rpy:2855
translate french c25s004_Listen_6c13d4f7:

    # eil "Bueno, ha habido varias veces en un columpio, pero..."
    eil "Eh bien, c'est arrivé plusieurs fois sur une balançoire, mais..."

# game/scripts/c25/c25.rpy:2856
translate french c25s004_Listen_1e77ac63:

    # mcp "(Creo que es el momento de hacerme notar. Si empiezan a hablar de sexo y me descubren escuchando se van a enfadar.)"
    mcp "(Je crois qu'il est temps de me faire connaître. S'ils commencent à parler de sexe et qu'ils me surprennent à écouter, ils vont être furieux.)"

# game/scripts/c25/c25.rpy:2857
translate french c25s004_Listen_1fa64ca7:

    # mcp "(Especialmente si hablan de sexo conmigo.)"
    mcp "(Surtout s'ils me parlent de sexe.)"

# game/scripts/c25/c25.rpy:2918
translate french c25s004_MarPickles_edd270a7:

    # "Llegas a la cocina y ves a [mar] con la cabeza metida en la nevera."
    "Vous arrivez dans la cuisine et vous voyez [mar] avec la tête coincée dans le réfrigérateur."

# game/scripts/c25/c25.rpy:2919
translate french c25s004_MarPickles_956ec74f:

    # mc "¿Estás preparando la comida?"
    mc "Tu prépares le repas ?"

# game/scripts/c25/c25.rpy:2922
translate french c25s004_MarPickles_71094ac0:

    # mom "No, aún no. Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    mom "Non, pas encore. J'ai tellement envie de cornichons avec de la glace au chocolat, mais on n'a plus de cornichons."

# game/scripts/c25/c25.rpy:2923
translate french c25s004_MarPickles_84f35fa2:

    # mc "¡Aargh! *Risa* ¡Eso tiene que tener un gusto horrendo! No te he visto nunca comer algo así."
    mc "Aargh ! *Rires* Ça doit être affreux ! Je ne t'ai jamais vu manger quelque chose comme ça."

# game/scripts/c25/c25.rpy:2924
translate french c25s004_MarPickles_7613b351:

    # mc "¿Es posible que sea un antojo del embarazo?"
    mc "Est-ce possible qu'il s'agisse d'une envie liée à la grossesse ?"

# game/scripts/c25/c25.rpy:2927
translate french c25s004_MarPickles_7c51ff83:

    # mom "No lo creo. No tuve antojos cuando estuve embarazada de ti ni de [emm]. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Je ne crois pas. Je n'ai eu aucune envie particulière pendant mes grossesses, ni avec toi ni avec [emm]. J'ai toujours pensé que les envies étaient un moyen ridicule de profiter de la vulnérabilité des parents."

# game/scripts/c25/c25.rpy:2929
translate french c25s004_MarPickles_28435bd9:

    # mom "No lo creo. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Je ne crois pas. J'ai toujours pensé que les envies alimentaires étaient un moyen ridicule de profiter de la vulnérabilité des parents."

# game/scripts/c25/c25.rpy:2930
translate french c25s004_MarPickles_14bc9b06:

    # mom "Pero es posible... ahora que lo dices, suena asqueroso."
    mom "Mais c'est possible… maintenant que vous le dites, ça a l'air dégoûtant."

# game/scripts/c25/c25.rpy:2931
translate french c25s004_MarPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Tu veux que j'aille acheter des cornichons ?"

# game/scripts/c25/c25.rpy:2933
translate french c25s004_MarPickles_59520599:

    # mom "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    mom "Si ça ne vous dérange pas… Même si ça paraît dégoûtant, j’en ai quand même envie."

# game/scripts/c25/c25.rpy:2934
translate french c25s004_MarPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Ne t'inquiète pas, je vais les acheter maintenant."

# game/scripts/c25/c25.rpy:2936
translate french c25s004_MarPickles_f88ea23f:

    # mom "Estaba empezando a prepararla, pero no hay suficiente pollo."
    mom "J'avais commencé à le préparer, mais il n'y a pas assez de poulet."

# game/scripts/c25/c25.rpy:2937
translate french c25s004_MarPickles_ee07af24:

    # mc "¿Quieres que vaya a comprar?"
    mc "Tu veux que j'aille faire les courses ?"

# game/scripts/c25/c25.rpy:2939
translate french c25s004_MarPickles_2dfd3d61:

    # mom "Si no te importa... Iba a hacer paella, aunque seguramente algún español me mataría si probase mi receta de paella."
    mom "Si cela ne vous dérange pas… j’allais faire une paella, même si je suis sûre qu’un Espagnol me tuerait s’il goûtait ma recette."

# game/scripts/c25/c25.rpy:2940
translate french c25s004_MarPickles_2efe82ef:

    # mc "*Risa* Ningún problema. Y seguramente ese español cambiaría la receta tradicional por la tuya en cuanto la probara. Tu paella está buenísima."
    mc "*Rires* Pas de problème. Et je suis sûr que cet Espagnol troquerait la recette traditionnelle contre la vôtre dès qu'il l'aurait goûtée. Votre paella est délicieuse."

# game/scripts/c25/c25.rpy:2943
translate french c25s004_MarPickles_70958b08:

    # mom "Gracias, mi amor."
    mom "Merci mon amour."

# game/scripts/c25/c25.rpy:2945
translate french c25s004_MarPickles_4724458f:

    # mom "¿Puedes pasar a buscar a [mad.nick] también? Así le ahorras tener que coger un Under para venir a comer."
    mom "Peux-tu aussi ramasser [mad.nick] ? Comme ça, tu lui éviteras de devoir faire un Under pour venir manger."

