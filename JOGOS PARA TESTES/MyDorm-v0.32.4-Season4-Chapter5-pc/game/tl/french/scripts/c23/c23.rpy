    mc "Je lui demanderai peut-être d'y jeter un coup d'œil."

# game/scripts/c23/c23.rpy:1840
translate french c23s005_MarVisit_1f11f99c:

    # mom "Aparte de hablar de mis gustos literarios... *Risa* ¿Querías algo más?"
    mom "À part parler de mes goûts littéraires… *Rires* Vous vouliez autre chose ?"

# game/scripts/c23/c23.rpy:1841
translate french c23s005_MarVisit_b3f442bd:

    # mc "No, sólo venía por lo de la camisa. No es que tenga intención de ponérmela, pero..."
    mc "Non, je suis juste venu pour la chemise. Ce n'est pas comme si j'avais l'intention de la porter, mais…"

# game/scripts/c23/c23.rpy:1844
translate french c23s005_MarVisit_0e04b775:

    # mom "Pero hoy ya has perdido una camisa y no quieres perder más. *Risa*"
    mom "Mais tu as déjà perdu une chemise aujourd'hui, et tu ne veux pas en perdre d'autres. *Rires*"

# game/scripts/c23/c23.rpy:1845
translate french c23s005_MarVisit_0151713c:

