translate french c23s006_AfterBreakfastBetConfession_e62be100:

    # bet "Sí y no. Hacía muchas cosas bien, pero también se equivocaba en muchas otras."
    bet "Oui et non. Il a réussi beaucoup de choses, mais il a aussi commis beaucoup d'erreurs."

# game/scripts/c23/c23.rpy:2676
translate french c23s006_AfterBreakfastBetConfession_a6bdd1ff:

    # bet "No, no era perfecto."
    bet "Non, ce n'était pas parfait."

