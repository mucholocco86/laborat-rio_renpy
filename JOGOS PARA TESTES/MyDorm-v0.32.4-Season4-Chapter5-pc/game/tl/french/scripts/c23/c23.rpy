    # "Subes a tu habitación y duermes toda la noche sin soñar..."
    "Tu montes dans ta chambre et tu dors toute la nuit sans rêver..."

# game/scripts/c23/c23.rpy:1866
translate french c23s005_NoMar_b3f31ca1:

    # centered "{size=+20}{b}DÍA 24 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}JOUR 24 – JEUDI{/b}{/size}"

# game/scripts/c23/c23.rpy:1869
translate french c23s005_NoMar_ec286efa:

    # "... Hasta que la puerta se abre de golpe y alguien enciende la luz."
    "…Jusqu’à ce que la porte s’ouvre brusquement et que quelqu’un allume la lumière."

# game/scripts/c23/c23.rpy:1870
translate french c23s005_NoMar_35ad285c:

    # emm "¡Despierta! ¡Nos tenemos que ir!"
    emm "Réveille-toi ! On doit y aller !"

# game/scripts/c23/c23.rpy:1871
translate french c23s005_NoMar_4102bb2b:

    # "OK. Ya estás despierto. Y sobresaltado."
    "OK. Tu es réveillé maintenant. Et surpris."

# game/scripts/c23/c23.rpy:1872
translate french c23s005_NoMar_d525fe1d:

    # mc "¿Qué hora es, [emm]? No he oído el despertador."
    mc "Quelle heure est-il, [emm] ? Je n'ai pas entendu le réveil."

# game/scripts/c23/c23.rpy:1874
translate french c23s005_NoMar_2060c21e:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a buscarte."
    emm "Il est 6h du matin. Je suis réveillée depuis plus d'une heure et je me retiens de monter te chercher."

# game/scripts/c23/c23.rpy:1875
translate french c23s005_NoMar_e6da23ea:

    # emm "Pero si no te levantas ya, se va a hacer tarde."
    emm "Mais si tu ne te lèves pas maintenant, il va se faire tard."

# game/scripts/c23/c23.rpy:1876
translate french c23s005_NoMar_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], nous avions dit que nous partirions d'ici à 8h00. J'avais réglé mon réveil pour 7h15."

# game/scripts/c23/c23.rpy:1878
translate french c23s005_NoMar_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "Et dans 45 minutes, tu allais prendre une douche..."

# game/scripts/c23/c23.rpy:1879
translate french c23s005_NoMar_f4b84d41:

    # mc "Me duché anoche..."
    mc "J'ai pris une douche hier soir..."

# game/scripts/c23/c23.rpy:1880
translate french c23s005_NoMar_d664759d:

    # emm "A vestirte..."
    emm "S'habiller..."

# game/scripts/c23/c23.rpy:1881
translate french c23s005_NoMar_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Je suis un homme. Il me faut moins de cinq minutes. Cinq vraies minutes…"

# game/scripts/c23/c23.rpy:1882
translate french c23s005_NoMar_d6f2a180:

    # emm "Y a desayunar..."
    emm "Et c'est l'heure du petit-déjeuner..."

# game/scripts/c23/c23.rpy:1883
translate french c23s005_NoMar_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Voilà à quoi ont servi 30 des 45 minutes. *Rires*"

# game/scripts/c23/c23.rpy:1884
translate french c23s005_NoMar_d48c1dce:

    # mc "Puedes ir preparando el café, si quieres ir avanzando. Mamá dijo que se levantaría para hacer el desayuno."
    mc "Tu peux commencer à faire le café si tu veux prendre de l'avance. Maman a dit qu'elle se lèverait pour préparer le petit-déjeuner."

# game/scripts/c23/c23.rpy:1886
translate french c23s005_NoMar_ea722677:

    # emm "Mamá ya está en la cocina horneando algo. El olor es lo que me ha convencido de que ya era hora de despertarte."
    emm "Maman est déjà dans la cuisine en train de préparer quelque chose. C'est l'odeur qui m'a convaincu qu'il était temps de te réveiller."

# game/scripts/c23/c23.rpy:1887
translate french c23s005_NoMar_37ec136f:

    # mc "Vale... ¿Tía [bet] ya está despierta?"
    mc "D'accord... Tante [bet] est-elle réveillée ?"

# game/scripts/c23/c23.rpy:1889
translate french c23s005_NoMar_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Je ne sais pas ! Je ne suis pas encore allée la voir !"

# game/scripts/c23/c23.rpy:1890
translate french c23s005_NoMar_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "Qu'est-ce que tu attends ? C'est une femme, elle mettra plus de temps à s'habiller que moi."

# game/scripts/c23/c23.rpy:1891
translate french c23s005_NoMar_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Tu as raison ! Je m'en vais !"

# game/scripts/c23/c23.rpy:1894
translate french c23s005_NoMar_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:1895
translate french c23s005_NoMar_6713e858:

    # emm "*A través de la puerta* Todo lo tengo que hacer yo en esta casa..."
    emm "*À travers la porte* Je dois tout faire dans cette maison..."

# game/scripts/c23/c23.rpy:1897
translate french c23s005_NoMar_efe2aa2c:

    # mcp "(Y se fue. Bajaré a la cocina a ayudar a [mar] a preparar el desayuno.)"
    mcp "(Et elle est partie. Je vais descendre à la cuisine pour aider à préparer le petit-déjeuner.)"

# game/scripts/c23/c23.rpy:1901
translate french c23s005_Mar_82ff8c0e:

    # mom "¿Quieres quedarte a dormir?"
    mom "Voulez-vous passer la nuit sur place ?"

# game/scripts/c23/c23.rpy:1902
translate french c23s005_Mar_ec063b6b:

    # mc "*Risa* Creía que no me lo ibas a pedir."
    mc "*Rires* Je pensais que tu n'allais pas me le demander."

# game/scripts/c23/c23.rpy:1904
translate french c23s005_Mar_e4a23ead:

    # mom "¿De verdad lo creías? Venir a preguntar por la camisa, cuando no tienes interés en ella, es la peor excusa que se te podía haber ocurrido."
    mom "Tu y as vraiment cru ? Venir ici poser des questions sur cette chemise alors qu'elle ne t'intéresse pas du tout, c'est la pire excuse que tu aurais pu trouver."

# game/scripts/c23/c23.rpy:1905
translate french c23s005_Mar_0374b3a7:

    # mom "Y saber que vas a estar dos días fuera cuando apenas acabas de volver de la universidad..."
    mom "Et savoir que vous allez être absent pendant deux jours alors que vous venez à peine de rentrer de l'université..."

# game/scripts/c23/c23.rpy:1906
translate french c23s005_Mar_2125c473:

    # mc "Hace más de tres semanas que volví. Y no son dos días. Sólo es una noche."
    mc "Je suis rentré depuis plus de trois semaines. Et ce n'est pas deux jours. C'est juste une nuit."

# game/scripts/c23/c23.rpy:1908
translate french c23s005_Mar_9c8bbee0:

    # mom "Bueno, lo que sea. A una madre no le gusta perder de vista a sus polluelos aunque sea sólo por una noche."
    mom "Bon, peu importe. Une mère n'aime pas perdre de vue ses petits, même si ce n'est que pour une nuit."

# game/scripts/c23/c23.rpy:1909
translate french c23s005_Mar_8bfb55eb:

    # mc "*Risa* Y estoy seguro de que me dirás que conduzca con cuidado y que no corra por la autopista."
    mc "*Rires* Et je suis sûr que vous me direz de conduire prudemment et de ne pas rouler trop vite sur l'autoroute."

# game/scripts/c23/c23.rpy:1911
translate french c23s005_Mar_65ccc2dd:

    # mom "¡Por supuesto! *Risa* ¡Y me levantaré temprano para prepararos el desayuno!"
    mom "Bien sûr ! *Rires* Et je me lèverai tôt pour te préparer le petit-déjeuner !"

# game/scripts/c23/c23.rpy:1912
translate french c23s005_Mar_bdcf4cd9:

    # mc "No hace falta, sé preparar café y coger un trozo de tarta."
    mc "Pas besoin, je sais faire du café et prendre une part de gâteau."

# game/scripts/c23/c23.rpy:1914
translate french c23s005_Mar_86e6ca78:

    # mom "Me da lo mismo. Mis dos niños se van a pasar la noche fuera y no pienso dejar que os vayáis con el estómago vacío."
    mom "Je m'en fiche. Mes deux enfants sortent ce soir, et je ne te laisserai pas partir le ventre vide."

# game/scripts/c23/c23.rpy:1915
translate french c23s005_Mar_281c7abb:

    # mc "Lo haces para sentirte mejor, ¿no?"
    mc "Tu le fais pour te sentir mieux, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1917
translate french c23s005_Mar_e77b74f5:

    # mom "Entre otras cosas..."
    mom "Entre autres choses..."

# game/scripts/c23/c23.rpy:1918
translate french c23s005_Mar_d961e82b:

    # mc "Entonces estaré encantado de que nos prepares el desayuno."
    mc "Je serais alors ravi(e) si vous nous prépariez le petit-déjeuner."

# game/scripts/c23/c23.rpy:1920
translate french c23s005_Mar_81e58346:

    # mom "¿Por qué no te pones cómodo mientras yo guardo el cómic?"
    mom "Pourquoi ne pas vous installer confortablement pendant que je range la BD ?"

# game/scripts/c23/c23.rpy:1921
translate french c23s005_Mar_bc03d346:

    # mc "¿Guardarlo? ¿Por qué no lo dejas en la mesilla de noche?"
    mc "Le ranger ? Pourquoi ne pas le laisser sur la table de nuit ?"

# game/scripts/c23/c23.rpy:1923
translate french c23s005_Mar_f95c1578:

    # mom "Estoy casi segura de que [emm] vendrá aquí si se despierta antes que yo, y no quiero que tenga ninguna idea rara."
    mom "Je suis presque certain que [emm] viendra ici s'il se réveille avant moi, et je ne veux pas qu'il se fasse des idées bizarres."

# game/scripts/c23/c23.rpy:1925
translate french c23s005_Mar_83323914:

    # mom "Últimamente la he visto queriendo probar cosas nuevas..."
    mom "J'ai remarqué ces derniers temps qu'elle avait envie d'essayer de nouvelles choses..."

# game/scripts/c23/c23.rpy:1926
translate french c23s005_Mar_d2d9d612:

    # mc "Si me encuentra durmiendo aquí, en lo que menos se va a fijar será en un cómic lésbico encima de tu mesilla."
    mc "S'il me trouve endormie ici, la dernière chose qu'il remarquera, c'est une BD lesbienne sur ta table de chevet."

# game/scripts/c23/c23.rpy:1927
translate french c23s005_Mar_09f08358:

    # mc "Además, con lo excitada que estará, no creo que se fije ni siquiera en si estoy yo. *Risa*"
    mc "En plus, vu son excitation, je ne pense pas qu'elle remarquera ma présence. *Rires*"

# game/scripts/c23/c23.rpy:1929
translate french c23s005_Mar_540fe0fa:

    # mom "Bueno, de todas formas voy a guardarlo. No voy a leer nada más esta noche..."
    mom "Bon, je le sauvegarderai quand même. Je ne lirai rien d'autre ce soir..."

# game/scripts/c23/c23.rpy:1930
translate french c23s005_Mar_0ea7bcf6:

    # mom "Hay cosas que me apetecen más hacer que leer."
    mom "Il y a des choses que je préférerais faire que lire."

# game/scripts/c23/c23.rpy:1931
translate french c23s005_Mar_f9788a14:

    # mc "Me parece una idea prometedora... Voy a hacerte caso y a ponerme cómodo."
    mc "Ça me semble une idée prometteuse… Je vais suivre votre conseil et m’installer confortablement."

# game/scripts/c23/c23.rpy:1933
translate french c23s005_Mar_c350f7d3:

    # mom "Yo también voy a ponerme cómoda."
    mom "Je vais m'installer confortablement aussi."

# game/scripts/c23/c23.rpy:1934
translate french c23s005_Mar_41efa3af:

    # mc "Déjate puesto el collar, si no te importa. Me encanta cómo te queda."
    mc "Si cela ne vous dérange pas, gardez le collier. Je trouve qu'il vous va très bien."

# game/scripts/c23/c23.rpy:1936
translate french c23s005_Mar_2fd6017d:

    # mom "¿Sólo el collar?"
    mom "Juste le collier ?"

# game/scripts/c23/c23.rpy:1938
translate french c23s005_Mar_55410cb7:

    # mc "Solo el collar."
    mc "Juste le col."

# game/scripts/c23/c23.rpy:1941
translate french c23s005_Mar_172f8095:

    # "Un par de minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c23/c23.rpy:1942
translate french c23s005_Mar_1ecafe17:

    # mom "Aquí estamos... Solo con el collar..."
    mom "Nous y voilà... Juste avec le collier..."

# game/scripts/c23/c23.rpy:1943
translate french c23s005_Mar_e9a384b1:

    # mc "Es un collar precioso, pero me gusta mucho más el resto de ti."
    mc "C'est un joli collier, mais je préfère de loin le reste de toi."

# game/scripts/c23/c23.rpy:1945
translate french c23s005_Mar_e7446202:

    # mom "Te va a parecer una tontería..."
    mom "Vous allez trouver ça idiot..."

# game/scripts/c23/c23.rpy:1946
translate french c23s005_Mar_ff0f72cd:

    # mc "¿El qué?"
    mc "Le fait que ?"

# game/scripts/c23/c23.rpy:1948
translate french c23s005_Mar_c37b1656:

    # mom "Quiero hacer el amor contigo esta noche..."
    mom "J'ai envie de faire l'amour avec toi ce soir..."

# game/scripts/c23/c23.rpy:1949
translate french c23s005_Mar_3d47e4df:

    # mc "*Risa* No, no me parece una tontería."
    mc "*Rires* Non, je ne trouve pas ça idiot."

# game/scripts/c23/c23.rpy:1951
translate french c23s005_Mar_e8a84b31:

    # mom "*Risa* Calla y escucha..."
    mom "*Rires* Silence et écoutez..."

# game/scripts/c23/c23.rpy:1953
translate french c23s005_Mar_6415efb1:

    # mom "Cuando lo hicimos la primera vez, era como la culminación de una noche perfecta y fue mágico..."
    mom "La première fois, c'était comme l'apogée d'une soirée parfaite, c'était magique..."

# game/scripts/c23/c23.rpy:1954
translate french c23s005_Mar_dc9bf552:

    # mom "Hoy somos como una pareja normal... no sé cómo hacerlo sin que se pierda la magia."
    mom "Aujourd'hui, nous sommes comme un couple normal... Je ne sais pas comment faire sans que la magie disparaisse."

# game/scripts/c23/c23.rpy:1955
translate french c23s005_Mar_4ce30d57:

    # mom "Sin que parezca algo programado..."
    mom "Sans que cela paraisse prémédité..."

# game/scripts/c23/c23.rpy:1956
translate french c23s005_Mar_fb980dbe:

    # mc "Bueno, creo que lo de pareja normal no se nos aplica demasiado."
    mc "Eh bien, je ne pense pas que le terme « couple normal » s'applique vraiment à nous."

# game/scripts/c23/c23.rpy:1959
translate french c23s005_Mar_712254c7:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con mi hijo, pero me da lo mismo."
    mom "*Rires* Tu as raison. Personne n'approuverait que je couche avec mon fils, mais je m'en fiche."

# game/scripts/c23/c23.rpy:1961
translate french c23s005_Mar_fd1ecd9f:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con el chico a quién he criado, pero me da lo mismo."
    mom "*Rires* Tu as raison. Personne n'approuverait que je couche avec le garçon que j'ai élevé, mais je m'en fiche."

# game/scripts/c23/c23.rpy:1962
translate french c23s005_Mar_609eeb6e:

    # mc "No me refiero sólo a eso. ¿Crees que las parejas normales se plantean estas cosas tan pronto?"
    mc "Je ne parle pas seulement de ça. Croyez-vous que les couples normaux prennent en compte ces choses-là aussi tôt ?"

# game/scripts/c23/c23.rpy:1963
translate french c23s005_Mar_54d66051:

    # mc "¿Que hablan en su segunda vez sobre no perder la magia?"
    mc "De quoi parlent-ils la deuxième fois, de ne pas perdre la magie ?"

# game/scripts/c23/c23.rpy:1965
translate french c23s005_Mar_470249da:

    # mom "Me preocupo demasiado, ¿verdad?"
    mom "Je m'inquiète trop, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1966
translate french c23s005_Mar_54eef042:

    # mc "Un poco..."
    mc "Un peu..."

# game/scripts/c23/c23.rpy:1967
translate french c23s005_Mar_92da2253:

    # mom "Es que no quiero que se convierta en algo rutinario, en plan \"Es sábado y toca sexo\"."
    mom "Je ne veux pas que ça devienne une routine, du genre « C'est samedi, c'est l'heure du sexe. »"

# game/scripts/c23/c23.rpy:1968
translate french c23s005_Mar_6637b5c0:

    # mc "Si no lleváramos una vida tan ajetreada, seguramente sería \"Es una noche cualquiera y toca sexo\"."
    mc "Si nous n'avions pas des vies aussi trépidantes, ce serait probablement : « C'est juste une nuit comme les autres, et c'est l'heure de faire l'amour. »"

# game/scripts/c23/c23.rpy:1969
translate french c23s005_Mar_07e123ca:

    # mc "Llevo días queriendo bajar a dormir contigo, pero cuando no pasa una cosa, pasa otra."
    mc "Ça fait des jours que j'ai envie de descendre dormir avec toi, mais quand une chose n'arrive pas, une autre arrive."

# game/scripts/c23/c23.rpy:1971
translate french c23s005_Mar_f9164bb5:

    # mc "O te veo cansada durante el día y quiero que tengas una buena noche de descanso."
    mc "Ou alors je vois que tu es fatigué(e) pendant la journée et je veux que tu passes une bonne nuit de repos."

# game/scripts/c23/c23.rpy:1972
translate french c23s005_Mar_862a3f45:

    # mom "Lo sé. Yo también he estado a punto de pedirte varias veces que vengas."
    mom "Je sais. J'ai moi aussi failli te demander de venir à plusieurs reprises."

# game/scripts/c23/c23.rpy:1973
translate french c23s005_Mar_46a99c1c:

    # mom "Ayer iba a subir a tu habitación pero..."
    mom "Je comptais monter dans ta chambre hier mais..."

# game/scripts/c23/c23.rpy:1975
translate french c23s005_Mar_9189a531:

    # mom "Me crucé con [sca] que iba a tu habitación en pijama."
    mom "J'ai croisé [sca] qui allait dans ta chambre en pyjama."

# game/scripts/c23/c23.rpy:1977
translate french c23s005_Mar_694b034f:

    # mom "No podía hacer el esfuerzo de subir las escaleras."
    mom "Je n'avais pas la force de monter les escaliers."

# game/scripts/c23/c23.rpy:1978
translate french c23s005_Mar_5718e506:

    # mc "Bueno, hoy estamos aquí y nadie nos va a molestar."
    mc "Eh bien, nous sommes là aujourd'hui et personne ne va nous déranger."

# game/scripts/c23/c23.rpy:1981
translate french c23s005_Mar_ba39104e:

    # mc "Y hay mucha piel pidiendo ser acariciada..."
    mc "Et il y a tant de peau qui ne demande qu'à être caressée..."

# game/scripts/c23/c23.rpy:1982
translate french c23s005_Mar_a96da54c:

    # "En cuanto empiezas a recorrer su costado, apenas rozándola, puedes notar en la yema de tus dedos cómo a [mar] se le pone la piel de gallina."
    "Dès que vous commencez à faire glisser vos doigts le long de son flanc, à peine en la touchant, vous pouvez sentir la peau de [mar] se hérisser de chair de poule."

# game/scripts/c23/c23.rpy:1983
translate french c23s005_Mar_774e7cb8:

    # mom "Me encanta eso..."
    mom "J'adore ça..."

# game/scripts/c23/c23.rpy:1985
translate french c23s005_Mar_6d7f7dc8:

    # "Tu madre se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "Votre mère frissonne chaque fois que vous faites glisser vos doigts le long de la courbe de sa hanche ou lorsque vous tracez le contour de son ventre en remontant vers son dos."

# game/scripts/c23/c23.rpy:1987
translate french c23s005_Mar_3a9a845d:

    # "[mar] se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "[mar] Elle frissonne chaque fois que vous faites glisser vos doigts le long de la courbe de sa hanche ou lorsque vous tracez son ventre en remontant vers son dos."

# game/scripts/c23/c23.rpy:1988
translate french c23s005_Mar_ef24df22:

    # mc "Lo estoy notando. Aquella noche no tuve mucho tiempo para explorar, quiero conocer cada rincón de tu piel."
    mc "Je le remarque. Cette nuit-là, je n'ai pas eu beaucoup de temps pour explorer ; je veux connaître chaque centimètre de ta peau."

# game/scripts/c23/c23.rpy:1989
translate french c23s005_Mar_e4ba915d:

    # "Un estremecimiento vuelve a recorrer el cuerpo de la hermosa mujer, esta vez provocado por tus palabras en vez de por tus dedos."
    "Un frisson parcourt à nouveau le corps de la belle femme, cette fois provoqué par vos mots et non par vos doigts."

# game/scripts/c23/c23.rpy:1993
translate french c23s005_Mar_e236bd13:

    # mom "Me encanta que seas tan delicado siempre... Bueno, siempre que tienes que serlo."
    mom "J'aime ta douceur... Enfin, quand il le faut."

# game/scripts/c23/c23.rpy:1994
translate french c23s005_Mar_c5991eda:

    # "Su mirada se vuelve felina por momentos, empiezas a sentirte como se debe sentir la presa de un puma. Una presa voluntaria."
    "Son regard se fait parfois félin ; on commence à ressentir ce que ça doit être d'être la proie d'un puma. Une proie consentante."

# game/scripts/c23/c23.rpy:1995
translate french c23s005_Mar_82eabf47:

    # mc "Tan solo soy tan delicado como mereces en cada momento. Ni un poco más ni un poco menos."
    mc "Je suis tout simplement aussi douce que vous le méritez à chaque instant. Ni un peu plus, ni un peu moins."

# game/scripts/c23/c23.rpy:1996
translate french c23s005_Mar_31801a03:

    # "Otro estremecimiento recorre su cuerpo, deseoso de caricias. Deseoso de delicadeza."
    "Un autre frisson la parcourt, un désir ardent de caresses. Un désir de tendresse."

# game/scripts/c23/c23.rpy:1997
translate french c23s005_Mar_35bc0097:

    # mom "*Gemido* Pero todavía tienes mucha piel que conocer, no solo ese costado."
    mom "*Gémissement* Mais il te reste encore beaucoup de peau à explorer, pas seulement de ce côté-là."

# game/scripts/c23/c23.rpy:1998
translate french c23s005_Mar_8f53ac06:

    # mc "¿Ya te has cansado de mis caricias?"
    mc "Te lasses de mes caresses ?"

# game/scripts/c23/c23.rpy:2001
translate french c23s005_Mar_71571ec5:

    # mom "No, hijo mío, pero yo también quiero que acaricies toda mi piel."
    mom "Non, mon fils, mais je veux aussi que tu caresses toute ma peau."

# game/scripts/c23/c23.rpy:2003
translate french c23s005_Mar_df3b1392:

    # mom "No, mi amor, pero yo también quiero que acaricies toda mi piel."
    mom "Non, mon amour, mais je veux aussi que tu caresses toute ma peau."

# game/scripts/c23/c23.rpy:2004
translate french c23s005_Mar_e07511f8:

    # mom "*Gemido* Si no lo haces tú, tendré que empezar yo a descubrir cada rincón de la tuya."
    mom "*Gémissement* Si tu ne le fais pas, je vais devoir commencer à explorer chaque recoin de ton intimité."

# game/scripts/c23/c23.rpy:2005
translate french c23s005_Mar_90d70d9d:

    # mc "*Risa* Hoy estás teniendo unas ideas excelentes, pero me parece que voy a seguir yo con mi exploración."
    mc "*Rires* Tu as d'excellentes idées aujourd'hui, mais je pense que je vais poursuivre mes recherches."

# game/scripts/c23/c23.rpy:2006
translate french c23s005_Mar_79488545:

    # "Otro estremecimiento más. Esta vez producido por la anticipación."
    "Un autre frisson. Cette fois-ci provoqué par l'anticipation."

# game/scripts/c23/c23.rpy:2008
translate french c23s005_Mar_7f85be74:

    # "Tumbándola de espaldas, empiezas a recorrer su cuerpo con tu boca, tal como has prometido que harías."
    "Vous la couchez sur le dos et commencez à explorer son corps avec votre bouche, comme vous l'aviez promis."

# game/scripts/c23/c23.rpy:2009
translate french c23s005_Mar_0d3a73f5:

    # mom "*Gemido* Me encanta sentir tus labios sobre mi piel. *Jadeo*"
    mom "*Gémissement* J'adore sentir tes lèvres sur ma peau. *Halètement*"

# game/scripts/c23/c23.rpy:2010
translate french c23s005_Mar_048a3dcc:

    # "Y tú disfrutas explorando cada rincón de su cuerpo. Cada lugar es un nuevo descubrimiento que atesoras para más tarde."
    "Et vous prenez plaisir à explorer chaque centimètre de son corps. Chaque endroit est une nouvelle découverte que vous chérissez pour plus tard."

# game/scripts/c23/c23.rpy:2011
translate french c23s005_Mar_8d6c0127:

    # mc "*Smooch* Una piel fantástica que no me voy a cansar de recorrer."
    mc "*Bisou* Un skin fantastique que je ne me lasserai jamais d'explorer."

# game/scripts/c23/c23.rpy:2012
translate french c23s005_Mar_ae01bd62:

    # "Tomas notas mentales sobre qué zonas son más sensitivas para ella, es un conocimiento al que sacarás partido durante años."
    "Vous prenez mentalement note des zones les plus sensibles pour elle ; c'est une connaissance dont vous profiterez pendant des années."

# game/scripts/c23/c23.rpy:2014
translate french c23s005_Mar_5c66f73f:

    # "No sólo tus labios recorren su cuerpo, sino que tus manos también lo hacen al mismo tiempo."
    "Non seulement vos lèvres parcourent son corps, mais vos mains le font en même temps."

# game/scripts/c23/c23.rpy:2015
translate french c23s005_Mar_efca7294:

    # mom "*Jadeo* Me estás volviendo loca... *Gemido* Y aún no has tocado lo más sensible. *Jadeo*"
    mom "*Halètement* Tu me rends folle... *Gémissement* Et tu n'as même pas encore touché le point le plus sensible. *Halètement*"

# game/scripts/c23/c23.rpy:2016
translate french c23s005_Mar_a444c619:

    # "Miente. Cada trozo de su piel es más sensible que el anterior. Cada estremecimiento es mayor que el que la ha recorrido un segundo antes."
    "Elle ment. Chaque parcelle de sa peau est plus sensible que la précédente. Chaque frisson est plus intense que celui qui l'a parcourue une seconde auparavant."

# game/scripts/c23/c23.rpy:2017
translate french c23s005_Mar_7d703def:

    # mom "*Gemido* Voy a necesitarte dentro... *Jadeo* No puedo aguantar más. *Gemido*"
    mom "*Gémissement* J'ai besoin de toi à l'intérieur... *Halètement* Je ne peux plus me retenir. *Gémissement*"

# game/scripts/c23/c23.rpy:2018
translate french c23s005_Mar_d65c5420:

    # "Todo lo bueno se acaba. Lo mejor está por llegar."
    "Toutes les bonnes choses ont une fin. Le meilleur est à venir."

# game/scripts/c23/c23.rpy:2020
translate french c23s005_Mar_ae412d67:

    # "[mar] te da la vuelta sin saber muy bien cómo lo ha hecho. Te tumba de espaldas y se sienta encima tuyo."
    "[mar] Il te retourne sans vraiment savoir comment il s'y prend. Il te couche sur le dos et s'assoit sur toi."

# game/scripts/c23/c23.rpy:2021
translate french c23s005_Mar_f6f48287:

    # mom "*Risita* Estar cachonda me da fuerzas. No creía que pudiera tumbarte así."
    mom "*Rires* Être excitée me donne de la force. Je ne pensais pas pouvoir te mettre KO comme ça."

# game/scripts/c23/c23.rpy:2022
translate french c23s005_Mar_c3157580:

    # "No tienes por qué decirle que no has opuesto ninguna resistencia. Escuchar su risa es suficiente premio por dejarte vencer."
    "Tu n'as pas besoin de lui dire que tu n'as opposé aucune résistance. Entendre son rire est une récompense suffisante pour avoir accepté ta défaite."

# game/scripts/c23/c23.rpy:2023
translate french c23s005_Mar_d880f54b:

    # mc "Ahora me tienes a tu merced. ¿Qué piensas hacer con este pobre muchacho?"
    mc "Maintenant, je suis à votre merci. Que comptez-vous faire de ce pauvre garçon ?"

# game/scripts/c23/c23.rpy:2026
translate french c23s005_Mar_9c3a06fe:

    # "Mjolnir ha encontrado la perfecta posición entre los cachetes de tu madre, pareciendo indicar dónde quiere entrar hoy."
    "Mjolnir a trouvé la position idéale entre les joues de votre mère, indiquant apparemment où il veut aller aujourd'hui."

# game/scripts/c23/c23.rpy:2028
translate french c23s005_Mar_a823d02c:

    # "Mjolnir ha encontrado la perfecta posición entre los cachetes de [mar], pareciendo indicar dónde quiere entrar hoy."
    "Mjolnir a trouvé la position parfaite entre les joues de [mar], indiquant apparemment où il veut entrer aujourd'hui."

# game/scripts/c23/c23.rpy:2029
translate french c23s005_Mar_dd2409d2:

    # mom "Por muy tentador que sea donde estás apuntando, te quiero en el otro agujero."
    mom "Aussi tentant que soit l'endroit où tu vises, je te veux dans l'autre trou."

# game/scripts/c23/c23.rpy:2048
translate french c23s005_Mar_cd64d767:

    # mc "Con lo que puedes hacer lo que quieras."
    mc "Avec ça, vous pouvez faire tout ce que vous voulez."

# game/scripts/c23/c23.rpy:2050
translate french c23s005_Mar_533df833:

    # mom "*GEMIDO* ¡Ooof! *JADEO*"
    mom "*GÉMISSEMENT* Ouf ! *HALETANT*"

# game/scripts/c23/c23.rpy:2053
translate french c23s005_Mar_8bec1e9d:

    # mom "*Gemido* Pues si es lo que quiera, quiero volver a tener a mi hijo dentro de mí. *Jadeo*"
    mom "*Gémissement* Eh bien, si c'est ce qu'il veut, je veux mon fils en moi. *Halètement*"

# game/scripts/c23/c23.rpy:2055
translate french c23s005_Mar_de1f3dee:

    # mom "*Gemido* Pues volver a tener a Mjolnir dentro de mí me parece la mejor idea."
    mom "*Soupir* Bon, avoir Mjolnir en moi à nouveau me semble être la meilleure idée."

# game/scripts/c23/c23.rpy:2056
