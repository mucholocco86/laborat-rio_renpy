    mc "*Rires* Exactement."

# game/scripts/c23/c23.rpy:1846
translate french c23s005_MarVisit_f67bb261:

    # mom "No te preocupes, está en la maleta de [emm]. En una de sus maletas."
    mom "Ne t'inquiète pas, c'est dans la valise de [emm]. Dans une de ses valises."

# game/scripts/c23/c23.rpy:1853
translate french c23s005_NoMar_3ee1513b:

    # mc "Bueno, entonces me voy a dormir ya. Mañana nos levantamos temprano."
    mc "Bon, alors je vais dormir maintenant. Il faut se lever tôt demain."

# game/scripts/c23/c23.rpy:1854
translate french c23s005_NoMar_3d6e8676:

    # mc "Te veo el viernes."
    mc "Je te verrai vendredi."

