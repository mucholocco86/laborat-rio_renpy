# game/scripts/c23/c23.rpy:1455
translate french c23s003_Eil_eca9fa9b:

    # eil "Lo que quiero decir es que no tengo con quién compararte como amante. Ninguna de esas citas pasó de una cena o de ir al cine."
    eil "Ce que je veux dire, c'est que je n'ai personne à qui te comparer en tant qu'amant. Aucun de ces rendez-vous n'a dépassé le stade d'un dîner ou d'un film."

# game/scripts/c23/c23.rpy:1456
translate french c23s003_Eil_1a554488:

    # eil "No me acosté con ninguno de esos chicos."
    eil "Je n'ai couché avec aucun de ces gars."

# game/scripts/c23/c23.rpy:1458
translate french c23s003_Eil_c8d25e30:

    # eil "Ninguno de aquellos chicos eras tú."
    eil "Aucun de ces garçons n'était toi."

# game/scripts/c23/c23.rpy:1459
translate french c23s003_Eil_7b06167a:

    # mc "Me lo imagino. Si hubiera yo hubiera sido uno de ellos, lo recordaría."
    mc "Je peux l'imaginer. Si j'avais été à leur place, je m'en souviendrais."

# game/scripts/c23/c23.rpy:1461
translate french c23s003_Eil_7c792f56:

    # eil "¡Idiota! ¡Estoy hablando en serio!"
    eil "Crétin ! Je suis sérieux !"

# game/scripts/c23/c23.rpy:1462
translate french c23s003_Eil_e108b29c:

    # mc "Y yo también. ¿Crees que me importaría si te hubieras acostado con alguno de ellos?"
    mc "Moi aussi. Tu crois que ça me dérangerait si tu avais couché avec l'une d'elles ?"

# game/scripts/c23/c23.rpy:1463
translate french c23s003_Eil_ea8e1c3f:

    # mc "¿Te importa a ti que saliera y me acostara con [sai] mientras tú y yo no estábamos juntos?"
    mc "Est-ce que ça te dérange que je sois sortie et que j'aie couché avec [sai] alors que nous n'étions pas ensemble ?"

# game/scripts/c23/c23.rpy:1465
translate french c23s003_Eil_bed78a97:

    # eil "No. Y no. Pero con las mujeres es diferente..."
    eil "Non. Et non. Mais avec les femmes, c'est différent..."

# game/scripts/c23/c23.rpy:1466
translate french c23s003_Eil_d5fb6099:

    # eil "Si un hombre se acuesta con diez mujeres diferentes es un macho."
    eil "Si un homme couche avec dix femmes différentes, c'est un tombeur."

# game/scripts/c23/c23.rpy:1467
translate french c23s003_Eil_69d7a2f3:

    # eil "Si una mujer se acuesta con tres hombres, es una puta para muchos hombres."
    eil "Si une femme couche avec trois hommes, elle est une putain pour beaucoup d'hommes."

# game/scripts/c23/c23.rpy:1468
translate french c23s003_Eil_e8be8f2f:

    # mc "Son esos hombres los que tienen un problema, no la mujer. Sabes que yo no pienso así."
    mc "Ce sont ces hommes qui ont un problème, pas la femme. Tu sais que je ne pense pas comme ça."

# game/scripts/c23/c23.rpy:1469
translate french c23s003_Eil_c9d46b3a:

    # mc "Además, no lo hiciste, con lo que no hay más de que hablar."
    mc "D'ailleurs, tu ne l'as pas fait, donc il n'y a plus rien à discuter."

# game/scripts/c23/c23.rpy:1471
translate french c23s003_Eil_36321820:

    # eil "Son por estas cosas por las que te quiero. Lo sabes, ¿verdad?"
    eil "C'est pour ces raisons que je t'aime. Tu le sais, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1472
translate french c23s003_Eil_656b4a49:

    # mc "Yo creía que sólo me querías porque soy el mejor amante que nadie pueda imaginar. *Risa*"
    mc "Je croyais que tu ne m'aimais que parce que je suis le meilleur amant qu'on puisse imaginer. *Rires*"

# game/scripts/c23/c23.rpy:1474
translate french c23s003_Eil_f6938275:

    # eil "A veces eres idiota. Estoy hablando en serio, [mc]."
    eil "Parfois, tu fais vraiment l'idiot. Je suis sérieux, [mc]."

# game/scripts/c23/c23.rpy:1475
translate french c23s003_Eil_daa9aca1:

    # eil "Si fueras diferente no me atrevería a hablarte de todo."
    eil "Si tu étais différent, je n'oserais pas te parler de tout."

# game/scripts/c23/c23.rpy:1476
translate french c23s003_Eil_b8dd6aac:

    # mc "Lo sé. Yo también te quiero, [eil.nick]. Eres una mujer maravillosa."
    mc "Je sais. Je t'aime aussi, [eil.nick]. Tu es une femme merveilleuse."

# game/scripts/c23/c23.rpy:1478
translate french c23s003_Eil_efa06021:

    # eil "Pues ahora esta mujer maravillosa se va a tener que ir. Me quiero dar una ducha rápida antes de ir a trabajar."
    eil "Bon, cette femme formidable va devoir partir. Je voudrais prendre une douche rapide avant d'aller travailler."

# game/scripts/c23/c23.rpy:1479
translate french c23s003_Eil_74edfffa:

    # mc "Puedes coger mi albornoz si quieres y ducharte aquí."
    mc "Tu peux prendre mon peignoir si tu veux et prendre une douche ici."

# game/scripts/c23/c23.rpy:1481
translate french c23s003_Eil_ed09d202:

    # eil "No hace falta. Me vuelvo a poner el uniforme y voy a casa. Tengo tiempo."
    eil "Ce n'est pas nécessaire. Je vais remettre mon uniforme et rentrer chez moi. J'ai le temps."

# game/scripts/c23/c23.rpy:1482
translate french c23s003_Eil_8a4b213f:

    # mc "Como desees."
    mc "Comme vous le souhaitez."

# game/scripts/c23/c23.rpy:1484
translate french c23s003_Eil_a882f7fe:

    # "Una vez los dos os habéis vestido..."
    "Une fois que vous serez tous les deux habillés..."

# game/scripts/c23/c23.rpy:1485
translate french c23s003_Eil_7b478453:

    # eil "Me voy a ir ya. Gracias por ser como eres."
    eil "Je vais partir maintenant. Merci d'être vous-même."

# game/scripts/c23/c23.rpy:1486
translate french c23s003_Eil_2a5242a9:

    # mc "Gracias a ti por hacerme como soy."
    mc "Merci de m'avoir permis de devenir ce que je suis."

# game/scripts/c23/c23.rpy:1488
translate french c23s003_Eil_4092f2d3:

    # eil "¡Oh! ¡Eso es muy bonito! No me lo habías dicho nunca."
    eil "Oh ! C'est très gentil ! Vous ne me l'aviez jamais dit auparavant."

# game/scripts/c23/c23.rpy:1490
translate french c23s003_Eil_460ad180:

    # mc "Pero te lo he demostrado muchas veces."
    mc "Mais je vous l'ai prouvé à maintes reprises."

# game/scripts/c23/c23.rpy:1498
translate french c23s004_Kia_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c23/c23.rpy:1499
translate french c23s004_Kia_999e0f29:

    # kia "*A través de la puerta* [mc], ¿estás ahí? ¿Puedo pasar?"
    kia "*À travers la porte* [mc], êtes-vous là ? Puis-je entrer ?"

# game/scripts/c23/c23.rpy:1500
translate french c23s004_Kia_4d601f0e:

    # mc "Sí, pasa."
    mc "Oui, ça arrive."

# game/scripts/c23/c23.rpy:1503
translate french c23s004_Kia_dd2620e4:

    # kia "¡Oh! No sabía que estabas aquí, [eil.nick]. Precisamente venía a preguntarle a [mc] si te había visto."
    kia "Oh ! Je ne savais pas que tu étais là, [eil.nick]. Je venais justement demander à [mc] si elle t'avait vu."

# game/scripts/c23/c23.rpy:1505
translate french c23s004_Kia_f92d1814:

    # eil "Llevo un rato aquí, hemos estado... charlando."
    eil "Je suis là depuis un moment, on a... discuté."

# game/scripts/c23/c23.rpy:1506
translate french c23s004_Kia_fd36aada:

    # mc "¿No estabas trabajando?"
    mc "Tu ne travaillais pas ?"

# game/scripts/c23/c23.rpy:1508
translate french c23s004_Kia_59b23038:

    # kia "Hoy empiezo a mediodía. Por eso estaba buscando a [eil]."
    kia "Je commence à midi aujourd'hui. C'est pourquoi je cherchais [eil]."

# game/scripts/c23/c23.rpy:1509
translate french c23s004_Kia_8fe2bb9b:

    # kia "Me ha llamado [oma]. Va a venir a recogerme para llevarme al trabajo, por si querías venir tú también y te dejamos en el café."
    kia "[oma] m'a appelé. Il vient me chercher pour m'emmener au travail, au cas où tu voudrais venir aussi et qu'on puisse te déposer au café."

# game/scripts/c23/c23.rpy:1511
translate french c23s004_Kia_62fd67d7:

    # eil "¡Oh, eso sería fantástico! ¡Voy a cambiarme!"
    eil "Oh, ce serait fantastique ! Je vais changer !"

# game/scripts/c23/c23.rpy:1514
translate french c23s004_Kia_84ff7fc5:

    # eil "Por cierto, Mamá, sabes que puedes besar a [mc] aunque yo esté delante, ¿verdad?"
    eil "Au fait, maman, tu sais que tu peux m'embrasser même si je suis là, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1515
translate french c23s004_Kia_945c30b7:

    # mc "[eil], no tienes que presionarla."
    mc "[eil], vous n'avez pas besoin d'appuyer dessus."

# game/scripts/c23/c23.rpy:1517
translate french c23s004_Kia_6b45fe62:

    # kia "*Risa* No me siento presionada, pero prefiero hacerlo cuando te hayas ido."
    kia "*Rires* Je ne me sens pas sous pression, mais je préférerais le faire après votre départ."

# game/scripts/c23/c23.rpy:1519
translate french c23s004_Kia_c2a7821f:

    # eil "Pues me voy y os dejo que os beséis con tranquilidad."
    eil "Bon, je vais vous laisser tous les deux vous embrasser en paix."

# game/scripts/c23/c23.rpy:1522
translate french c23s004_Kia_59fe7813:

    # kia "Esta chica..."
    kia "Cette fille..."

# game/scripts/c23/c23.rpy:1523
translate french c23s004_Kia_9fcd8d5a:

    # mc "Creo que tenías un beso para mí..."
    mc "Je crois que tu m'as envoyé un baiser..."

# game/scripts/c23/c23.rpy:1525
translate french c23s004_Kia_d243bc2f:

    # "Sin decir una palabra, sus dulces labios buscan los tuyos."
    "Sans dire un mot, ses douces lèvres cherchent les vôtres."

# game/scripts/c23/c23.rpy:1526
translate french c23s004_Kia_c1e0c57d:

    # "Hoy no saben a aguacate, pero no por ello son menos deliciosos."
    "Elles n'ont pas le goût d'avocat aujourd'hui, mais cela ne les rend pas moins délicieuses."

# game/scripts/c23/c23.rpy:1527
translate french c23s004_Kia_5c482df3:

    # "Como siempre, os separáis para recuperar el aliento. Demasiado pronto."
    "Comme toujours, vous vous séparez pour reprendre votre souffle. Trop tôt."

# game/scripts/c23/c23.rpy:1530
translate french c23s004_Kia_e1381dbf:

    # kia "*Respiración entrecortada* ¡Phew! Y por esto prefiero besarte en privado. *Risa*"
    kia "*Haletant* Ouf ! Voilà pourquoi je préfère t'embrasser en privé. *Rires*"

# game/scripts/c23/c23.rpy:1531
translate french c23s004_Kia_b9a14b7b:

    # mc "Llamaremos a estos besos Darth Bader. *Risa* Cada vez que nos separamos respiramos como él."
    mc "On appellera ces baisers « les bavardages de Dark Vador ». *Rires* À chaque fois qu'on se sépare, on respire comme lui."

# game/scripts/c23/c23.rpy:1533
translate french c23s004_Kia_9b46c866:

    # kia "*Risa* A veces me extraña que algo tan de mi época lo hayáis adoptado los jóvenes."
    kia "*Rires* Parfois, je suis surprise de voir que quelque chose d'aussi typique de mon époque a été adopté par les jeunes."

# game/scripts/c23/c23.rpy:1534
translate french c23s004_Kia_248258de:

    # mc "*Risa* Con la cantidad de spin offs que han hecho, creo que es de todas las épocas."
    mc "*Rires* Vu le nombre de spin-offs qu'ils ont produits, je pense que ça couvre toutes les époques."

# game/scripts/c23/c23.rpy:1536
translate french c23s004_Kia_c37a601b:

    # kia "*Risa* Tienes razón, han encontrado la gallina de los huevos de oro y no pararán hasta que la maten."
    kia "*Rires* Vous avez raison, ils ont trouvé la poule aux œufs d'or et ils ne s'arrêteront pas tant qu'ils ne l'auront pas tuée."

# game/scripts/c23/c23.rpy:1537
translate french c23s004_Kia_1d1af333:

    # mc "Cambiando de tema, ¿hoy no hay vestido morado?"
    mc "Pour changer de sujet, il n'y a pas de robe violette aujourd'hui ?"

# game/scripts/c23/c23.rpy:1539
translate french c23s004_Kia_60fbe70c:

    # kia "Hoy no he quedado para comer con ningún chico guapo, con lo que no hay nadie a quien impresionar."
    kia "Je ne vais déjeuner avec aucun beau garçon aujourd'hui, donc je n'ai personne à impressionner."

# game/scripts/c23/c23.rpy:1540
translate french c23s004_Kia_c5e92548:

    # mc "Tú impresionarías a ese chico afortunado llevaras lo que llevaras, o aunque no llevaras nada..."
    mc "Vous impressionneriez ce garçon chanceux peu importe ce que vous portez, ou même si vous ne portez rien du tout..."

# game/scripts/c23/c23.rpy:1541
translate french c23s004_Kia_d5096617:

    # mc "Eso ha sonado mejor en mi cabeza..."
    mc "Ça sonnait mieux dans ma tête..."

# game/scripts/c23/c23.rpy:1543
translate french c23s004_Kia_f6aedbdd:

    # kia "Bueno, espero, si no impresionarte, al menos no decepcionarte cuando no lleve nada."
    kia "Eh bien, j'espère, sinon vous impressionner, du moins ne pas vous décevoir quand je ne porterai rien."

# game/scripts/c23/c23.rpy:1544
translate french c23s004_Kia_2321c125:

    # mc "No me podrías decepcionar nunca, [kia]. Estoy deseando poder demostrártelo."
    mc "Tu ne pourrais jamais me décevoir, [kia]. J'ai hâte de te le prouver."

# game/scripts/c23/c23.rpy:1546
translate french c23s004_Kia_d6ca2621:

    # kia "Si no fuera porque mañana tienes que levantarte temprano... Tenemos una cena pendiente."
    kia "Si tu ne devais pas te lever tôt demain… Nous avons prévu un dîner en amoureux."

# game/scripts/c23/c23.rpy:1547
translate french c23s004_Kia_a377bd3d:

    # kia "¿Cuándo vuelves? ¿El viernes?"
    kia "Quand reviens-tu ? Vendredi ?"

# game/scripts/c23/c23.rpy:1548
translate french c23s004_Kia_1da55bc6:

    # mc "Sí, el viernes por la tarde espero estar de vuelta."
    mc "Oui, je prévois d'être de retour vendredi après-midi."

# game/scripts/c23/c23.rpy:1550
translate french c23s004_Kia_94beec8a:

    # kia "¿Te apetece que vayamos a cenar? Si no estás muy cansado cuando vuelvas, claro."
    kia "Aimerais-tu aller dîner au restaurant ? Si tu n'es pas trop fatigué(e) en rentrant, bien sûr."

# game/scripts/c23/c23.rpy:1551
translate french c23s004_Kia_8d395c57:

    # mc "Apúntalo en la agenda. *Risa* Son poco más de dos horas conduciendo, no voy a estar cansado."
    mc "Note-le dans ton agenda. *Rires* C'est à peine plus de deux heures de route, je ne serai pas fatigué(e)."

# game/scripts/c23/c23.rpy:1553
translate french c23s004_Kia_acfffe06:

    # kia "Entonces el viernes. Me apetece mucho tener nuestra tercera cita."
    kia "Donc, vendredi. J'attends avec impatience notre troisième rendez-vous."

# game/scripts/c23/c23.rpy:1554
translate french c23s004_Kia_5daa83ad:

    # mc "A mí también. Me encanta pasar tiempo contigo."
    mc "Moi aussi. J'adore passer du temps avec toi."

# game/scripts/c23/c23.rpy:1556
translate french c23s004_Kia_6dc9d2f6:

    # kia "Eres tan dulce... Pero debería bajar antes de que llegue [oma]."
    kia "Tu es si gentil(le)... Mais je devrais descendre avant l'arrivée de [oma]."

# game/scripts/c23/c23.rpy:1560
translate french c23s004_Kia_dd9d5367:

    # kia "Debería bajar por si [oma] llega pronto."
    kia "Je devrais descendre au cas où [oma] arriverait bientôt."

# game/scripts/c23/c23.rpy:1561
translate french c23s004_Kia_615ebbcf:

    # mc "Vamos. Te acompaño. No he visto a [oma] desde la fiesta de la piscina."
    mc "Allez, viens. Je t'accompagne. Je n'ai pas vu [oma] depuis la fête à la piscine."

# game/scripts/c23/c23.rpy:1563
translate french c23s004_Kia_590abfbf:

    # mc "Por cierto, sólo te había visto con las gafas en el restaurante."
    mc "D'ailleurs, je ne vous ai vu qu'avec les lunettes, au restaurant."

# game/scripts/c23/c23.rpy:1565
translate french c23s004_Kia_bcd2c2af:

    # mc "Por cierto, hacía mucho tiempo que no te veía con gafas."
    mc "Au fait, ça fait longtemps que je ne t'ai pas vu porter des lunettes."

# game/scripts/c23/c23.rpy:1567
translate french c23s004_Kia_0f258b53:

    # kia "Me las pongo para leer y trabajar. Estas son las de reserva y no tienen funda, con lo que no las quiero llevar sueltas en el bolso para evitar rayarlas."
    kia "Je les porte pour lire et travailler. Ce sont mes lunettes de rechange et elles n'ont pas d'étui, donc je ne veux pas les transporter en vrac dans mon sac pour éviter de les rayer."

# game/scripts/c23/c23.rpy:1568
translate french c23s004_Kia_fe9e1f12:

    # kia "No sé dónde he dejado las otras gafas. A lo mejor las dejé en la biblioteca."
    kia "Je ne sais pas où j'ai laissé mes autres lunettes. Peut-être à la bibliothèque."

# game/scripts/c23/c23.rpy:1569
translate french c23s004_Kia_7992e3ae:

    # mc "Si quieres le puedo pedir una funda a [mar] o a [kim]. Seguro que tienen de sobras."
    mc "Si vous voulez, je peux demander à [mar] ou [kim] de m'en fournir un exemple. Je suis sûr qu'ils en ont plein."

# game/scripts/c23/c23.rpy:1571
translate french c23s004_Kia_7557bf5a:

    # kia "No hace falta, son progresivas, puedo ver bien con ellas en cualquier circunstancia. Ya encontraré la funda."
    kia "Pas besoin, ce sont des verres progressifs, je vois très bien avec dans toutes les situations. Je trouverai un étui."

# game/scripts/c23/c23.rpy:1572
translate french c23s004_Kia_e67890ae:

    # mc "Como quieras. Vamos entonces."
    mc "Comme tu veux. Allons-y alors."

# game/scripts/c23/c23.rpy:1575
translate french c23s004_Kia_8ef4ccaf:

    # mc "De todas formas, estás guapísima con ellas."
    mc "En tout cas, tu es magnifique dedans."

# game/scripts/c23/c23.rpy:1577
translate french c23s004_Kia_5a3d2aba:

    # kia "Vamos antes de que te tenga que besar otra vez. *Risa*"
    kia "Allons-y avant que je sois obligée de t'embrasser à nouveau. *Rires*"

# game/scripts/c23/c23.rpy:1582
translate french c23s004_EilKiss_d5eece30:

    # eil "Hasta luego, cielo."
    eil "À plus tard, mon amour."

# game/scripts/c23/c23.rpy:1585
translate french c23s004_EilKiss_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:1586
translate french c23s004_EilKiss_c8213c6a:

    # eil "*A través de la puerta* Date prisa, Mamá. En menos de diez minutos estaré lista."
    eil "*À travers la porte* Dépêche-toi, maman. Je serai prêt dans moins de dix minutes."

# game/scripts/c23/c23.rpy:1600
translate french c23s004_Oma_79acbd77:

    # "Cuando llegáis abajo, [oma] ya está esperando a [kia]."
    "Lorsque vous arrivez en bas, [oma] attend déjà [kia]."

# game/scripts/c23/c23.rpy:1603
translate french c23s004_Oma_14a2700e:

    # oma "Hola, cielo."
    oma "Bonjour chérie."

# game/scripts/c23/c23.rpy:1604
translate french c23s004_Oma_86b43a6a:

    # mc "Hola, preciosa. ¿No trabajas hoy?"
    mc "Salut, beauté. Tu ne travailles pas aujourd'hui ?"

# game/scripts/c23/c23.rpy:1607
translate french c23s004_Oma_c63c3e9c:

    # oma "Hola, [kia] y [mc]."
    oma "Bonjour, [kia] et [mc]."

# game/scripts/c23/c23.rpy:1608
translate french c23s004_Oma_45b32b95:

    # mc "Hola, [oma]. ¿No trabajas hoy?"
    mc "Salut, [oma]. Tu ne travailles pas aujourd'hui ?"

# game/scripts/c23/c23.rpy:1610
translate french c23s004_Oma_025afa94:

    # oma "Acabo de salir. Llevo toda la semana cubriendo el primer turno. Schrute está enfermo y estoy en el mostrador de la comisaría."
    oma "Je viens de terminer le travail. J'ai fait le remplacement de l'équipe du matin toute la semaine. Schrute est malade, et je suis au guichet du commissariat."

# game/scripts/c23/c23.rpy:1611
translate french c23s004_Oma_4e4ad102:

    # mc "Ufff. Yo odiaría tener que madrugar tanto."
    mc "Pff. Je détesterais devoir me lever si tôt."

# game/scripts/c23/c23.rpy:1613
translate french c23s004_Oma_e6ca9f9a:

    # kia "*Risa* Todo el mundo sabe que te gusta dormir hasta tarde."
    kia "*Rires* Tout le monde sait que tu aimes faire la grasse matinée."

# game/scripts/c23/c23.rpy:1614
translate french c23s004_Oma_50206f78:

    # mc "¡Hey! ¡A primera hora de la mañana no tengo nada que hacer!"
    mc "Salut ! Je n'ai rien à faire demain matin !"

# game/scripts/c23/c23.rpy:1616
translate french c23s004_Oma_5dd58847:

    # oma "Podrías venir a correr conmigo, al menos cuando tengo turno normal."
    oma "Tu pourrais venir courir avec moi, au moins quand j'ai un horaire normal."

# game/scripts/c23/c23.rpy:1618
translate french c23s004_Oma_15d6cb33:

    # kia "O hacer yoga con las chicas. Me han dicho que lo probaste una vez y no has vuelto."
    kia "Ou alors, fais du yoga avec les filles. J'ai entendu dire que tu avais essayé une fois et que tu n'y étais jamais retournée depuis."

# game/scripts/c23/c23.rpy:1619
translate french c23s004_Oma_1cfafede:

    # mc "*Risa* ¿Os dais cuenta de que lo único que proponéis es que haga más ejercicio?"
    mc "*Rires* Vous vous rendez compte que vous me suggérez simplement de faire plus d'exercice ?"

# game/scripts/c23/c23.rpy:1620
translate french c23s004_Oma_36ca33fd:

    # mc "*Risa* ¿Me estáis soltando indirectas de que me estoy engordando?"
    mc "*Rires* Vous insinuez que je prends du poids ?"

# game/scripts/c23/c23.rpy:1623
translate french c23s004_Oma_1640c236:

    # oma "No, sabemos que vas a correr al lago a menudo. *Risita* No necesitas más ejercicio."
    oma "Non, on sait que tu vas souvent courir au lac. *Rires* Tu n'as pas besoin de faire plus d'exercice."

# game/scripts/c23/c23.rpy:1625
translate french c23s004_Oma_11b1b1a1:

    # oma "No, sabemos que vas a correr al lago a menudo. No necesitas más ejercicio."
    oma "Non, nous savons que tu cours souvent jusqu'au lac. Tu n'as pas besoin de faire plus d'exercice."

# game/scripts/c23/c23.rpy:1626
translate french c23s004_Oma_7b373f76:

    # oma "Pero has dicho que no tienes nada que hacer por las mañanas. *Risa* Sólo te estamos dando opciones."
    oma "Mais vous avez dit que vous n'aviez rien à faire le matin. *Rires* On vous propose juste des options."

# game/scripts/c23/c23.rpy:1627
translate french c23s004_Oma_5dedd215:

    # mc "Ya, pero lo del yoga... Ufff..."
    mc "Oui, mais le yoga... Beurk..."

# game/scripts/c23/c23.rpy:1629
translate french c23s004_Oma_cd68c1c0:

    # kia "Yo quiero apuntarme algún día. Quizás el domingo. ¿Por qué no vienes, [oma]?"
    kia "Je voudrais m'inscrire un de ces jours. Peut-être dimanche. Pourquoi ne viendrais-tu pas, [oma] ?"

# game/scripts/c23/c23.rpy:1631
translate french c23s004_Oma_ee8a7892:

    # oma "El domingo lo tengo libre. A lo mejor me apunto también. Solo lo he probado una vez, hace años, pero me gustó."
    oma "Je suis libre dimanche. Je me joindrai peut-être à vous. Je n'ai essayé qu'une seule fois, il y a des années, mais j'avais bien aimé."

# game/scripts/c23/c23.rpy:1633
translate french c23s004_Oma_d512827e:

    # eil "¿Qué pasa el domingo?"
    eil "Que se passe-t-il dimanche ?"

# game/scripts/c23/c23.rpy:1635
translate french c23s004_Oma_0fe0c027:

    # kia "Estábamos diciendo de apuntarnos a una sesión de yoga con las chicas."
    kia "Nous parlions de nous inscrire à un cours de yoga avec les filles."

# game/scripts/c23/c23.rpy:1636
translate french c23s004_Oma_e83a65fa:

    # kia "A ver si así convencemos a [mc] de que se apunte también."
    kia "Voyons si nous pouvons convaincre [mc] de s'inscrire également."

# game/scripts/c23/c23.rpy:1638
translate french c23s004_Oma_3a16bc45:

    # eil "¡Contad conmigo! Creo que estoy perdiendo algo de flexibilidad."
    eil "J'en suis ! Je crois que je perds en souplesse."

# game/scripts/c23/c23.rpy:1639
translate french c23s004_Oma_c2d9c488:

    # mc "Sabéis que no me vais a convencer, ¿verdad?"
    mc "Tu sais que tu ne vas pas me convaincre, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1641
translate french c23s004_Oma_d0553f4e:

    # oma "No estés tan seguro. Con todas las chicas haciéndote bullying para que te apuntes, dudo que puedas resistirte."
    oma "N'en sois pas si sûr. Avec toutes ces filles qui te pressent de t'inscrire, je doute que tu puisses résister."

# game/scripts/c23/c23.rpy:1642
translate french c23s004_Oma_483a9cb6:

    # mc "Ya veremos, pero no estéis tan seguras."
    mc "On verra bien, mais n'en soyez pas si sûr."

# game/scripts/c23/c23.rpy:1647
translate french c23s004_Oma_e5c65855:

    # oma "Bueno, ya veremos. Me llevo a estas dos chicas antes de que se haga más tarde. Espero verte el domingo con mallas."
    oma "On verra bien. J'emmène ces deux filles avant qu'il ne soit trop tard. J'espère te voir en collants dimanche."

# game/scripts/c23/c23.rpy:1648
translate french c23s004_Oma_6546857c:

    # mc "No me vuelvo a poner las mallas de Tío Mike en mi vida. *Risa*"
    mc "Je ne porterai plus jamais de collants Uncle Mike's de ma vie. *Rires*"

# game/scripts/c23/c23.rpy:1653
translate french c23s004_Oma_06f8ca53:

    # kia "*Risa* Nos hablaron de lo anticuadas que se veían."
    kia "*Rires* Ils nous ont dit qu'ils avaient l'air démodés."

# game/scripts/c23/c23.rpy:1654
translate french c23s004_Oma_9ca7d97f:

    # mc "*Risa* Deben tener 20 años por lo menos."
    mc "*Rires* Ils doivent avoir au moins 20 ans."

# game/scripts/c23/c23.rpy:1659
translate french c23s004_Oma_38329130:

    # eil "Le preguntaremos a [mad.nick] si tiene unas más modernas para regalártelas. Así no podrás negarte. *Risa* No vas a despreciar nuestro regalo."
    eil "On va demander à [mad.nick] si elle en a de plus récentes à te donner. Comme ça, tu ne pourras pas refuser. *Rires* Tu ne vas quand même pas refuser notre cadeau !"

# game/scripts/c23/c23.rpy:1660
translate french c23s004_Oma_85eddbf0:

    # mc "*Risa* Sois malvadas..."
    mc "*Rires* Tu es diabolique..."

# game/scripts/c23/c23.rpy:1661
translate french c23s004_Oma_df14b767:

    # mc "Iros antes de que me convenzáis de irme a Aruba antes de que llegue el domingo."
    mc "Partez avant de me convaincre d'aller à Aruba avant dimanche."

# game/scripts/c23/c23.rpy:1663
translate french c23s004_Oma_d6430870:

    # todas "Hasta luego, [mc]."
    todas "À plus tard, [mc]."

# game/scripts/c23/c23.rpy:1665
translate french c23s004_Oma_ddf0c1b3:

    # oma "Por cierto, os tengo que contar algo que pasó el lunes."
    oma "Au fait, je dois vous raconter quelque chose qui s'est passé lundi."

# game/scripts/c23/c23.rpy:1667
translate french c23s004_Oma_b6374b4b:

    # oma "Ahora os lo explico en el coche."
    oma "Je te l'expliquerai dans la voiture."

# game/scripts/c23/c23.rpy:1671
translate french c23s004_Kim_2754a701:

    # "Pasas un rato después de comer leyendo los expedientes que [ama] y [jam] te han enviado sobre Iron Fist."
    "Vous passez un peu de temps après le déjeuner à lire les fichiers que [ama] et [jam] vous ont envoyés à propos d'Iron Fist."

# game/scripts/c23/c23.rpy:1673
translate french c23s004_Kim_1ab19608:

    # "Bajas a media tarde a la cocina a por un vaso de agua. Tienes que comprarte una nevera para tu habitación."
    "Tu descends à la cuisine en milieu d'après-midi pour prendre un verre d'eau. Il te faut acheter un réfrigérateur pour ta chambre."

# game/scripts/c23/c23.rpy:1674
translate french c23s004_Kim_91d604d7:

    # "[oma] y [kia] no contaban con la cantidad de escaleras que subes y bajas al cabo del día cuando hablaban del ejercicio que haces."
    "[oma] et [kia] n'ont pas pris en compte le nombre d'escaliers que vous montez et descendez au cours de la journée lorsqu'ils ont parlé de l'exercice que vous faites."

# game/scripts/c23/c23.rpy:1680
translate french c23s004_Kim_3bce768b:

    # "Al pasar por la planta de las estudiantes te encuentras con [kim], que baja de tu planta."
    "En passant devant l'étage des étudiants, vous rencontrez [kim], qui descend de votre étage."

# game/scripts/c23/c23.rpy:1682
translate french c23s004_Kim_d4f784dc:

    # kim "Hola, [mc]. He pasado a verte por tu habitación."
    kim "Bonjour, [mc]. Je suis venu te voir dans ta chambre."

# game/scripts/c23/c23.rpy:1683
translate french c23s004_Kim_8b63b330:

    # mc "¡Wow! ¿Dónde vas así vestida? Pareces una cazavampiros."
    mc "Waouh ! Où vas-tu habillé comme ça ? On dirait un chasseur de vampires."

# game/scripts/c23/c23.rpy:1685
translate french c23s004_Kim_742bca56:

    # kim "¿Te has olvidado?"
    kim "Avez-vous oublié ?"

# game/scripts/c23/c23.rpy:1695
translate french c23s004_Kim_81b0bcd4:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Mais je ne savais pas qu'il fallait s'habiller comme ça. Tu m'as dit que c'était un travail d'hôtesse de l'air et que tu pouvais te faire passer pour une espionne comme [eva] et [ama]."

# game/scripts/c23/c23.rpy:1697
translate french c23s004_Kim_8475a636:

    # kim "¡Sabía que no te olvidarías!"
    kim "Je savais que tu n'oublierais pas !"

# game/scripts/c23/c23.rpy:1700
translate french c23s004_Kim_b94cca21:

    # mc "¿Tenía que hacer algo? No soy capaz de acordarme."
    mc "Devais-je faire quelque chose ? Je ne m'en souviens plus."

# game/scripts/c23/c23.rpy:1702
translate french c23s004_Kim_7883c373:

    # kim "Te pedí que me llevaras al puerto para el trabajo que tengo esta tarde..."
    kim "Je t'ai demandé de m'emmener au port pour le travail que j'ai cet après-midi..."

# game/scripts/c23/c23.rpy:1703
translate french c23s004_Kim_39884136:

    # mc "¡Es verdad! ¡No me acordaba!"
    mc "C'est vrai ! J'avais oublié !"

# game/scripts/c23/c23.rpy:1704
translate french c23s004_Kim_81b0bcd4_1:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Mais je ne savais pas qu'il fallait s'habiller comme ça. Tu m'as dit que c'était un travail d'hôtesse de l'air et que tu pouvais te faire passer pour une espionne comme [eva] et [ama]."

# game/scripts/c23/c23.rpy:1707
translate french c23s004_Kim_3898579d:

    # kim "Me han enviado el uniforme con una nota de que tengo que llegar vestida."
    kim "Ils m'ont envoyé l'uniforme avec un mot disant que je devais arriver déjà habillé."

# game/scripts/c23/c23.rpy:1708
translate french c23s004_Kim_afd55317:

    # kim "Por lo visto no hay espacio suficiente para cambiarse en el evento."
    kim "Apparemment, il n'y a pas assez de place pour se changer lors de l'événement."

# game/scripts/c23/c23.rpy:1709
translate french c23s004_Kim_1e4949d6:

    # mc "Ah, OK. ¿Cuándo quieres que vayamos?"
    mc "Ah, d'accord. Quand voulez-vous que nous partions ?"

# game/scripts/c23/c23.rpy:1711
translate french c23s004_Kim_3833d28d:

    # kim "Debería estar allí en una hora, pero, si te va bien, me gustaría salir antes. No me gusta llegar con el tiempo justo a los sitios."
    kim "Je devrais être là dans une heure, mais si cela vous convient, je préférerais partir plus tôt. Je n'aime pas arriver à la dernière minute."

# game/scripts/c23/c23.rpy:1712
translate french c23s004_Kim_ce457f98:

    # mc "*Risa* Ningún problema. Pero deberías dar clases de puntualidad al resto de las chicas. Lo de llegar con tiempo no se les suele dar bien."
    mc "*Rires* Pas de problème. Mais tu devrais donner des cours de ponctualité aux autres filles. Arriver à l'heure n'est généralement pas leur point fort."

# game/scripts/c23/c23.rpy:1713
translate french c23s004_Kim_f18b0b21:

    # mc "Déjame coger las llaves y la cartera, y nos podemos ir."
    mc "Laissez-moi prendre les clés et le portefeuille, et nous pourrons y aller."

# game/scripts/c23/c23.rpy:1715
translate french c23s004_Kim_473af28b:

    # "Unos minutos después, en el coche..."
    "Quelques minutes plus tard, dans la voiture..."

# game/scripts/c23/c23.rpy:1716
translate french c23s004_Kim_22885cfa:

    # mc "Ese evento, ¿es algo de ciencia ficción o de espías? Podrías salir en una peli de ciencia ficción con ese atuendo."
    mc "Cet événement est-il digne d'un film de science-fiction ou d'un film d'espionnage ? On pourrait vous voir dans un film de science-fiction avec cette tenue."

# game/scripts/c23/c23.rpy:1717
translate french c23s004_Kim_64bf16da:

    # kim "No tengo ni idea. No me ha contratado el cliente final, sino la agencia de la que te hablé."
    kim "Je n'en ai aucune idée. Je n'ai pas été embauché par le client final, mais par l'agence dont je vous ai parlé."

# game/scripts/c23/c23.rpy:1718
translate french c23s004_Kim_c94679bc:

    # mc "Pero ¿no deberías saber qué tienes que hacer?"
    mc "Mais ne devriez-vous pas savoir ce que vous avez à faire ?"

# game/scripts/c23/c23.rpy:1720
translate french c23s004_Kim_00dde143:

    # kim "Bueno, es un trabajo de azafata. Recibir a los asistentes al evento, estar por allí en caso de que alguien necesite ayuda."
    kim "Eh bien, c'est un poste d'hôtesse. Accueillir les participants à l'événement et être disponible au cas où quelqu'un aurait besoin d'aide."

# game/scripts/c23/c23.rpy:1721
translate french c23s004_Kim_f172c3df:

    # kim "En algunos de esos eventos, incluso nos toca pasear con bandejas de comida. Odio esa parte."
    kim "Lors de certains de ces événements, nous devons même nous promener avec des plateaux de nourriture. Je déteste ça."

# game/scripts/c23/c23.rpy:1722
translate french c23s004_Kim_27cd09c9:

    # mc "¿Por qué? Tiene que ser más divertido que quedarse en la puerta esperando que lleguen asistentes con retraso."
    mc "Pourquoi ? Parce que ce sera forcément plus amusant que d'attendre à la porte les retardataires."

# game/scripts/c23/c23.rpy:1724
translate french c23s004_Kim_041f33bd:

    # kim "*Risa* ¿No me conoces aún? Aeropuerto, bosque... Tengo cierta tendencia a tropezar."
    kim "*Rires* Vous ne me connaissez pas encore ? Aéroport, forêt… J’ai tendance à trébucher."

# game/scripts/c23/c23.rpy:1725
translate french c23s004_Kim_34ecb851:

    # kim "Imagina esos tropiezos con una bandeja llena de canapés. *Risa* Canapés voladores..."
    kim "Imaginez trébucher sur un plateau rempli de canapés. *Rires* Des canapés qui volent…"

# game/scripts/c23/c23.rpy:1726
translate french c23s004_Kim_2974ddbd:

    # mc "Y el CEO de una compañía acaba con caviar en la corbata."
    mc "Et le PDG d'une entreprise se retrouve avec du caviar sur sa cravate."

# game/scripts/c23/c23.rpy:1728
translate french c23s004_Kim_97a08e5a:

    # kim "Más o menos. *Risa* O Dwayne Johnston con un canapé de salmón y dos de queso en la calva."
    kim "Plus ou moins. *Rires* Ou Dwayne Johnston avec un canapé au saumon et deux au fromage sur son crâne chauve."

# game/scripts/c23/c23.rpy:1729
translate french c23s004_Kim_578f7d1d:

    # mc "*Risa* ¿Te pasó eso?"
    mc "*Rires* Ça vous est déjà arrivé ?"

# game/scripts/c23/c23.rpy:1731
translate french c23s004_Kim_03094166:

    # kim "*Risa* Sí. No sabía dónde meterme. Era el primer evento que hacía con gente famosa."
    kim "*Rires* Oui. Je ne savais pas où me cacher. C'était le premier événement auquel je participais avec des gens célèbres."

# game/scripts/c23/c23.rpy:1732
translate french c23s004_Kim_655c0f4d:

    # mc "¿Qué pasó?"
    mc "Ce qui s'est passé?"

# game/scripts/c23/c23.rpy:1734
translate french c23s004_Kim_8ece0b8c:

    # kim "El Sr. Johnston fue muy amable... después de lanzarme una mirada asesina. Me ayudó a levantarme y me preguntó si me había hecho daño."
    kim "M. Johnston a été très gentil… après m’avoir lancé un regard noir. Il m’a aidé à me relever et m’a demandé si j’étais blessé."

# game/scripts/c23/c23.rpy:1735
translate french c23s004_Kim_fd2a107a:

    # kim "Después se rio mucho cuando me ruboricé mientras le pedía disculpas. Por suerte solo le manché la cabeza y no el traje."
    kim "Il a beaucoup ri quand j'ai rougi en m'excusant. Heureusement, je ne l'ai éclaboussé que la tête et pas son costume."

# game/scripts/c23/c23.rpy:1736
translate french c23s004_Kim_3d98e978:

    # mc "Con un tipo tan enorme mirándome con ganas de asesinarme, seguramente me hubiera escondido debajo de una mesa. *Risa*"
    mc "Avec un type aussi imposant qui me fixait comme s'il voulait me tuer, je me serais probablement cachée sous une table. *Rires*"

# game/scripts/c23/c23.rpy:1738
translate french c23s004_Kim_9a184fb3:

    # kim "*Risa* Te aseguro que es lo primero que se me pasó por la cabeza. Hacer como el actor ese pequeñito que hace pelis con él y salir de allí gateando."
    kim "*Rires* Je vous assure que c'est la première chose qui m'est venue à l'esprit. Faire comme ce petit acteur qui tourne des films avec ça et me faufiler hors de là."

# game/scripts/c23/c23.rpy:1739
translate french c23s004_Kim_f81bda84:

    # mc "¿Kevin Heart?"
    mc "Kevin Heart ?"

# game/scripts/c23/c23.rpy:1740
translate french c23s004_Kim_3a463a4e:

    # kim "Sí, ese. ¡Me encanta ese tío! ¡Es super gracioso!"
    kim "Oui, celui-là. J'adore ce type ! Il est hilarant !"

# game/scripts/c23/c23.rpy:1741
translate french c23s004_Kim_8c1dc6b4:

    # mc "Y sobre el evento, ¿conoces a alguna de las otra chicas? Si os ha contratado la misma agencia..."
    mc "Et concernant l'événement, connaissez-vous d'autres filles ? Si vous avez été engagées par la même agence…"

# game/scripts/c23/c23.rpy:1743
translate french c23s004_Kim_aef6db14:

    # kim "A una de ellas, Adeline. Hemos coincidido en la agencia, pero no he trabajado nunca con ella. Va a ser la jefa esta noche."
    kim "L'une d'elles s'appelle Adeline. On s'est rencontrées à l'agence, mais je n'ai jamais travaillé avec elle. Ce soir, c'est elle qui sera la chef."

# game/scripts/c23/c23.rpy:1744
translate french c23s004_Kim_8dd56270:

    # mc "Bueno, al menos tendrás una cara conocida. Supongo que siempre es bueno."
    mc "Au moins, vous reconnaîtrez un visage familier. C'est toujours une bonne chose, j'imagine."

# game/scripts/c23/c23.rpy:1746
translate french c23s004_Kim_4ae755b4:

    # kim "Depende a quién pertenezca esa cara. *Risa* En este mundillo hay muchas perras."
    kim "Ça dépend de qui c'est. *Rires* Il y a beaucoup de garces dans ce milieu."

# game/scripts/c23/c23.rpy:1747
translate french c23s004_Kim_ba1a071a:

    # kim "Y en el mundo de las modelos es peor todavía."
    kim "Et dans le monde du mannequinat, c'est encore pire."

# game/scripts/c23/c23.rpy:1748
translate french c23s004_Kim_4ca7ba1b:

    # mc "Me tienes que contar cómo empezaste en lo de trabajar de modelo."
    mc "Vous devez me raconter comment vous avez débuté dans le mannequinat."

# game/scripts/c23/c23.rpy:1750
translate french c23s004_Kim_ffce8934:

    # kim "Todo empezó cuando Winnie Carlow saltó a la fama. Los cazatalentos empezaron a visitar escuelas y..."
    kim "Tout a commencé lorsque Winnie Carlow est devenue célèbre. Les chasseurs de talents ont commencé à visiter les écoles et..."

# game/scripts/c23/c23.rpy:1752
translate french c23s004_Kim_beddfb92:

    # "[kim] te explica todo lo que tuvo que aprender en las escuelas de modelos, sus primeros trabajos, sus primeros éxitos y fracasos..."
    "[kim] explique tout ce qu'elle a dû apprendre dans les écoles de mannequinat, ses premiers emplois, ses premiers succès et ses premiers échecs..."

# game/scripts/c23/c23.rpy:1753
translate french c23s004_Kim_ab5d1645:

    # "Se nota que adora su trabajo por la ilusión con la que habla de ello."
    "On voit bien qu'elle adore son travail à l'enthousiasme avec lequel elle en parle."

# game/scripts/c23/c23.rpy:1754
translate french c23s004_Kim_a076c416:

    # "La conversación es tan amena que casi no te das cuenta de que ya habéis llegado al puerto, donde hay otras chicas vestidas como [kim]."
    "La conversation est si agréable que vous réalisez à peine que vous êtes déjà arrivé au port, où se trouvent d'autres filles habillées en [kim]."

# game/scripts/c23/c23.rpy:1756
translate french c23s004_Kim_b0dea2ba:

    # mc "Pues ya hemos llegado. ¿Quieres que te acompañe?"
    mc "Nous sommes arrivés. Voulez-vous que je vous accompagne ?"

# game/scripts/c23/c23.rpy:1757
translate french c23s004_Kim_7d98cdb5:

    # kim "Gracias, pero no hace falta."
    kim "Merci, mais ce n'est pas nécessaire."

# game/scripts/c23/c23.rpy:1759
translate french c23s004_Kim_d4ea101b:

    # kim "Aquella rubia es Adeline. De la que te he hablado antes. Mi jefa por esta noche."
    kim "Cette blonde, c'est Adeline. Celle dont je t'ai parlé tout à l'heure. Ma patronne pour ce soir."

# game/scripts/c23/c23.rpy:1760
translate french c23s004_Kim_68afdd7b:

    # kim "Iré a presentarme al resto de chicas, y si me acompañas sería como mostrar inseguridad."
    kim "Je vais me présenter aux autres filles, et si tu viens avec moi, ce serait comme faire preuve d'insécurité."

# game/scripts/c23/c23.rpy:1761
translate french c23s004_Kim_1a6ba295:

    # mc "Como desees. ¿Los dos tipos que parecen guardaespaldas también pertenecen al evento?"
    mc "Comme vous le souhaitez. Les deux hommes qui ressemblent à des gardes du corps sont-ils également présents à cet événement ?"

# game/scripts/c23/c23.rpy:1763
translate french c23s004_Kim_bbeda5a9:

    # kim "No lo sé. Por lo que sé, somos cinco azafatas y otras dos chicas para otros servicios. No me han dicho nada de chicos."
    kim "Je ne sais pas. À ma connaissance, nous sommes cinq hôtesses de l'air et deux autres filles pour d'autres services. Ils n'ont rien mentionné concernant d'éventuels garçons."

# game/scripts/c23/c23.rpy:1764
translate french c23s004_Kim_81f6d6f7:

    # kim "A lo mejor son los porteros y los han contratado en otra agencia. No tengo ni idea."
    kim "Peut-être sont-ils les gardiens de but et ont-ils été recrutés par une autre agence. Je n'en sais rien."

# game/scripts/c23/c23.rpy:1765
translate french c23s004_Kim_7cd995a2:

    # mc "Pues eres la cuarta en llegar. Falta una cazavampiros y las dos chicas de los otros... servicios."
    mc "Eh bien, vous êtes le quatrième à arriver. Nous attendons toujours un chasseur de vampires et les deux filles des autres... services."

# game/scripts/c23/c23.rpy:1767
translate french c23s004_Kim_051f4639:

    # kim "*Risa* Has dicho lo de servicios como si te sonara sospechoso."
    kim "*Rires* Tu as dit « services » comme si ça te paraissait suspect."

# game/scripts/c23/c23.rpy:1768
translate french c23s004_Kim_1f1e79c0:

    # kim "Se suele llamar así a la gente del cátering, de la limpieza, etc."
    kim "C'est généralement ainsi qu'on appelle les personnes travaillant dans la restauration, le nettoyage, etc."

# game/scripts/c23/c23.rpy:1769
translate french c23s004_Kim_76125965:

    # mc "Ah, OK. Al decirlo así ha sonado... *Risa* sospechoso."
    mc "Ah, d'accord. Dit comme ça, ça sonnait... *Rires* suspect."

# game/scripts/c23/c23.rpy:1770
translate french c23s004_Kim_73a9eea1:

    # mc "¿Quieres que te venga a buscar cuando acabes?"
    mc "Voulez-vous que je vienne vous chercher quand vous aurez terminé ?"

# game/scripts/c23/c23.rpy:1772
translate french c23s004_Kim_c4904bff:

    # kim "No hace falta. Acabará tarde y no quiero molestarte."
    kim "Ce n'est pas nécessaire. Il sera tard et je ne veux pas vous déranger."

# game/scripts/c23/c23.rpy:1773
translate french c23s004_Kim_5ad080fa:

    # mc "No es molestia. ¿Cómo volverás a casa si nadie viene a buscarte?"
    mc "Ce n'est pas un problème. Comment rentreras-tu chez toi si personne ne vient te chercher ?"

# game/scripts/c23/c23.rpy:1775
translate french c23s004_Kim_f82ff79f:

    # kim "Pediré un Under o a lo mejor alguna de las chicas puede llevarme."
    kim "Je vais commander un Under ou peut-être qu'une des filles pourra m'accompagner."

# game/scripts/c23/c23.rpy:1776
translate french c23s004_Kim_c31e85f0:

    # mc "Si tienes algún problema, no dudes en llamarme. Sea la hora que sea."
    mc "Si vous avez le moindre problème, n'hésitez pas à m'appeler. À n'importe quelle heure."

# game/scripts/c23/c23.rpy:1778
translate french c23s004_Kim_3225c954:

    # kim "Gracias de nuevo, [mc]. Pero no te preocupes. Si tengo algún problema, te llamaré."
    kim "Merci encore, [mc]. Mais ne t'inquiète pas. Si j'ai le moindre problème, je t'appellerai."

# game/scripts/c23/c23.rpy:1780
translate french c23s004_Kim_81b83644:

    # kim "Ahora tengo que irme, antes de que llegue la última cazavampiros."
    kim "Je dois partir avant l'arrivée du dernier chasseur de vampires."

# game/scripts/c23/c23.rpy:1781
translate french c23s004_Kim_5d67085f:

    # mc "Suerte con el trabajo y, si te hacen pasear bandejas, que sean de canapés y no de copas de champán. *Risa*"
    mc "Bonne chance pour le travail ! Et s’ils vous font porter des plateaux, assurez-vous que ce soient des plateaux de canapés et non des coupes de champagne. *Rires*"

# game/scripts/c23/c23.rpy:1783
translate french c23s004_Kim_cb4717cc:

    # kim "Muy gracioso... *Risa*"
    kim "Très drôle... *Rires*"

# game/scripts/c23/c23.rpy:1784
translate french c23s004_Kim_98cbe997:

    # kim "Te veo mañana en casa."
    kim "Je te verrai à la maison demain."

# game/scripts/c23/c23.rpy:1785
translate french c23s004_Kim_1171553f:

    # mc "Hasta mañana, [kim]."
    mc "À demain, [kim]."

# game/scripts/c23/c23.rpy:1790
translate french c23s004_Kim_022da978:

    # "[kim] se aleja del coche con paso seguro, pasando de largo de los porteros y dirigiéndose a las cazavampiros."
    "[kim] s'éloigne de la voiture d'un pas assuré, passe devant les portiers et se dirige vers les chasseurs de vampires."

# game/scripts/c23/c23.rpy:1791
translate french c23s004_Kim_39b267af:

    # "Por primera vez, te la puedes imaginar caminando por una pasarela. Los porteros parecen tener otros pensamientos."
    "Pour la première fois, on l'imagine défiler sur un podium. Les portiers, eux, semblent avoir d'autres idées."

# game/scripts/c23/c23.rpy:1795
translate french c23s004_Kim_cd871e42:

    # "Vuelves a casa y cenas con las chicas. El tema de conversación se centra en el viaje de [bet] a Monterey."
    "Tu rentres chez toi et dînes avec les filles. La conversation dérive sur le voyage de [bet] à Monterey."

# game/scripts/c23/c23.rpy:1796
translate french c23s004_Kim_bb870621:

    # "Que seas tú quien conduce o que [emm] vaya a cumplir su sueño de conducir un Ferrarini rosa casi no se comenta."
    "On ne s'attarde guère sur le fait que ce soit vous qui conduisiez ou que [emm] réalise son rêve de conduire une Ferrari rose."

# game/scripts/c23/c23.rpy:1797
translate french c23s004_Kim_0bae2113:

    # "Todo el mundo está preocupado con lo que pueda pasar en la reunión de [bet]."
    "Tout le monde s'inquiète de ce qui pourrait se passer lors de la réunion [bet]."

# game/scripts/c23/c23.rpy:1811
translate french c23s005_MarVisit_d348568e:

    # "Después de cenar te das una ducha y bajas a la habitación de [mar]."
    "Après le dîner, vous prenez une douche et descendez dans la chambre [mar]."

