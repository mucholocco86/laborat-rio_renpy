translate french c23s002_SaiPregnancy_9e188d5b:

    # "A los pocos minutos aparece [sai]."
    "Quelques minutes plus tard, [sai] apparaît."

# game/scripts/c23/c23.rpy:591
translate french c23s002_SaiPregnancy_f200ce13:

    # sai "Hola, [mc]. Qué raro ver la cocina tan vacía."
    sai "Salut, [mc]. C'est étrange de voir la cuisine si vide."

# game/scripts/c23/c23.rpy:594
translate french c23s002_SaiPregnancy_b7d10e84:

    # mc "Hola, cielo."
    mc "Bonjour chérie."

# game/scripts/c23/c23.rpy:595
translate french c23s002_SaiPregnancy_8dfe7662:

    # mc "Creo que todo el mundo está haciendo yoga ahora mismo o preparándose para ir a clase."
    mc "Je pense que tout le monde est en train de faire du yoga en ce moment, ou de se préparer pour aller en cours."

# game/scripts/c23/c23.rpy:597
translate french c23s002_SaiPregnancy_7844caef:

    # sai "Tienes razón. Hoy es más tarde que ayer. No tengo clase esta mañana."
    sai "Tu as raison. Il est plus tard aujourd'hui qu'hier. Je n'ai pas cours ce matin."

# game/scripts/c23/c23.rpy:598
translate french c23s002_SaiPregnancy_48f80515:

    # sai "Tan solo tengo que acabar un estudio sobre Maria Montessori."
    sai "Je dois juste terminer une étude sur Maria Montessori."

# game/scripts/c23/c23.rpy:599
translate french c23s002_SaiPregnancy_9319a8a3:

    # mc "No tengo ni idea de quién es."
    mc "Je n'ai aucune idée de qui elle est."

# game/scripts/c23/c23.rpy:602
translate french c23s002_SaiPregnancy_502d27d9:

    # "Para cuando acaba, tú has terminado tu trozo de pastel, quizás demasiado pequeño, y subes a tu habitación."
    "Une fois que c'est terminé, vous avez fini votre part de gâteau, peut-être un peu petite, et vous montez dans votre chambre."

# game/scripts/c23/c23.rpy:606
translate french c23s002_SaiPregnancy_b6c6519b:

    # sai "Era una profesora italiana que..."
    sai "Elle était professeure d'italien qui..."

# game/scripts/c23/c23.rpy:609
translate french c23s002_SaiPregnancy_5e9d0ebe:

    # mc "Parece interesante."
    mc "Ça a l'air intéressant."

# game/scripts/c23/c23.rpy:610
translate french c23s002_SaiPregnancy_d1b6da3b:

    # sai "Lo es. Pero ¿sabes qué sería interesante también?"
    sai "Oui. Mais vous savez ce qui serait intéressant d'autre ?"

# game/scripts/c23/c23.rpy:611
translate french c23s002_SaiPregnancy_a02421db:

    # mc "*Risa* Muchas cosas. Es una pregunta imposible de acertar."
    mc "*Rires* Plein de choses. C'est une question à laquelle il est impossible de répondre correctement."

# game/scripts/c23/c23.rpy:613
translate french c23s002_SaiPregnancy_ed23f690:

    # sai "Tienes razón. *Risa* Sin saber en lo que estoy pensando es imposible que lo aciertes."
    sai "Tu as raison. *Rires* Sans savoir ce que je pense, il t'est impossible de deviner."

# game/scripts/c23/c23.rpy:614
translate french c23s002_SaiPregnancy_1b6c05eb:

    # mc "Dame alguna pista..."
    mc "Donne-moi un indice..."

# game/scripts/c23/c23.rpy:616
translate french c23s002_SaiPregnancy_3ceb6b04:

    # sai "Hablando de Montessori he empezado a pensar en niños..."
    sai "Le fait de parler de Montessori m'a fait réfléchir aux enfants..."

# game/scripts/c23/c23.rpy:617
translate french c23s002_SaiPregnancy_669007dc:

    # mc "Y quieres saber el resultado de la prueba de embarazo."
    mc "Et vous voulez connaître le résultat du test de grossesse."

# game/scripts/c23/c23.rpy:619
translate french c23s002_SaiPregnancy_933d228c:

    # sai "Me conoces demasiado. ¿Te importa si subimos ya? Puedo desayunar más tarde."
    sai "Tu me connais trop bien. Ça te dérange si on monte maintenant ? Je peux prendre mon petit-déjeuner plus tard."

# game/scripts/c23/c23.rpy:620
translate french c23s002_SaiPregnancy_ed63e57f:

    # mc "Si, por mí perfecto. Cuanto antes lo sepamos, mejor. Vamos."
    mc "Oui, c'est parfait pour moi. Le plus tôt on le saura, le mieux ce sera. Allons-y."

# game/scripts/c23/c23.rpy:623
translate french c23s002_SaiPregnancy_f3a408c1:

    # sai "*Risa* Pobre [sca]. Con lo poco que le gusta el deporte, y ha tenido que subir hasta la azotea para nada."
    sai "*Rires* La pauvre [sca]. Elle n'aime pas beaucoup le sport, et elle a dû grimper jusqu'au toit pour rien."

# game/scripts/c23/c23.rpy:624
translate french c23s002_SaiPregnancy_07355acc:

    # mc "*Risa* Y ahora bajar corriendo a la piscina. Va a llegar agotada."
    mc "*Rires* Et maintenant, elle doit descendre en courant jusqu'à la piscine. Elle sera épuisée d'ici là."

# game/scripts/c23/c23.rpy:626
translate french c23s002_SaiPregnancy_28c4ed1c:

    # sai "¿Continuamos a tu habitación?"
    sai "Devons-nous continuer jusqu'à votre chambre ?"

# game/scripts/c23/c23.rpy:627
translate french c23s002_SaiPregnancy_63cd8ebd:

    # mc "Vamos."
    mc "Allez."

# game/scripts/c23/c23.rpy:629
translate french c23s002_SaiPregnancy_b95a4741:

    # mc "Lo puedes coger tú misma si quieres. Está en el armario."
    mc "Vous pouvez aller le chercher vous-même si vous voulez. Il est dans le placard."

# game/scripts/c23/c23.rpy:630
translate french c23s002_SaiPregnancy_b8617989:

    # sai "Mejor míralo tú primero. Estoy un poco nerviosa."
    sai "Tu devrais y jeter un œil en premier. Je suis un peu nerveux."

# game/scripts/c23/c23.rpy:631
translate french c23s002_SaiPregnancy_0e4115b6:

    # mc "¿Te da miedo estar embarazada?"
    mc "Avez-vous peur d'être enceinte ?"

# game/scripts/c23/c23.rpy:633
translate french c23s002_SaiPregnancy_5c972d3b:

    # sai "Por un lado no. Quiero tener un par de críos correteando por casa lo antes posible. Me da lo mismo si son niños o niñas."
    sai "D'un côté, non. Je veux avoir des enfants qui courent partout dans la maison le plus tôt possible. Peu importe que ce soient des garçons ou des filles."

# game/scripts/c23/c23.rpy:634
translate french c23s002_SaiPregnancy_7ff3a75e:

    # sai "Por otro lado... creo que es demasiado pronto... aún no he acabado la carrera y nunca me había planteado tener hijos tan joven..."
    sai "D'un autre côté… je pense que c'est trop tôt… Je n'ai pas encore terminé mes études et je n'ai jamais envisagé d'avoir des enfants si jeune…"

# game/scripts/c23/c23.rpy:635
translate french c23s002_SaiPregnancy_88c6d337:

    # mc "Bueno, si estás embarazada, no hay mucho que podamos hacer, pero si no lo estás, si quieres puedes volver a tomar anticonceptivos."
    mc "Si vous êtes enceinte, il n'y a pas grand-chose à faire, mais si vous ne l'êtes pas, vous pouvez reprendre la contraception si vous le souhaitez."

# game/scripts/c23/c23.rpy:636
translate french c23s002_SaiPregnancy_7c8ba9d4:

    # mc "Tenemos mucho tiempo para tener ese par de niños."
    mc "Nous avons largement le temps d'avoir ces deux enfants."

# game/scripts/c23/c23.rpy:638
translate french c23s002_SaiPregnancy_e13264a4:

    # sai "No pienso tomar anticonceptivos. Cuando el destino decida que tienen que llegar, llegarán."
    sai "Je n'ai pas l'intention de prendre la pilule. Quand le destin décidera qu'ils sont faits l'un pour l'autre, ils le seront."

# game/scripts/c23/c23.rpy:639
translate french c23s002_SaiPregnancy_6a559599:

    # sai "Y míralo ya antes de que me ponga más nerviosa."
    sai "Et regardez-le maintenant avant que je ne devienne encore plus nerveuse."

# game/scripts/c23/c23.rpy:655
translate french c23s002_ScaYoga_6b530c5d:

    # "Al salir al comedor te encuentras con [sca] con pinta de estar perdida."
    "En entrant dans la salle à manger, vous rencontrez [sca] qui semble être perdu."

# game/scripts/c23/c23.rpy:656
translate french c23s002_ScaYoga_c8e9c7f8:

    # mc "¿Buscas algo, [sca]?"
    mc "Vous cherchez quelque chose, [sca] ?"

# game/scripts/c23/c23.rpy:657
translate french c23s002_ScaYoga_4fd9952d:

    # sca "Creo que he llegado tarde a la sesión de yoga."
    sca "Je crois que je suis en retard pour la séance de yoga."

# game/scripts/c23/c23.rpy:659
translate french c23s002_ScaYoga_212eb0dc:

    # mc "¿Has decidido apuntarte? Eso es nuevo."
    mc "Avez-vous décidé de vous inscrire ? C'est nouveau."

# game/scripts/c23/c23.rpy:660
translate french c23s002_ScaYoga_bc90664b:

    # sca "Bueno, después de lo de ayer, quiero hacer aún más cosas con las chicas."
    sca "Eh bien, après ce qui s'est passé hier, j'ai encore plus envie de faire des choses avec les filles."

# game/scripts/c23/c23.rpy:661
translate french c23s002_ScaYoga_cc3dd443:

    # sca "Pero acabo de ir a la terraza y parece que ya han acabado."
    sca "Mais je viens de sortir sur la terrasse et on dirait qu'ils ont terminé."

# game/scripts/c23/c23.rpy:662
translate french c23s002_ScaYoga_709d1211:

    # mc "Oh, ¿nadie te ha dicho que han movido las sesiones de yoga a la piscina?"
    mc "Ah bon, personne ne vous a dit que les séances de yoga ont été déplacées à la piscine ?"

# game/scripts/c23/c23.rpy:664
translate french c23s002_ScaYoga_9c5d3a71:

    # sca "¿Qué? ¡No! Nadie me lo había dicho."
    sca "Quoi ? Non ! Personne ne me l'avait dit."

# game/scripts/c23/c23.rpy:665
translate french c23s002_ScaYoga_7763df00:

    # sca "¡Me voy antes de que acaben!"
    sca "Je pars avant qu'ils aient fini !"

# game/scripts/c23/c23.rpy:667
translate french c23s002_ScaYoga_e4aaf8ac:

    # mc "Hasta luego, [sca]."
    mc "À plus tard, [sca]."

# game/scripts/c23/c23.rpy:669
translate french c23s002_ScaYoga_12242b08:

    # sai "Adiós, [sca]."
    sai "Au revoir, [sca]."

# game/scripts/c23/c23.rpy:670
translate french c23s002_ScaYoga_06da67ce:

    # sca "Hasta luego..."
    sca "À plus tard..."

# game/scripts/c23/c23.rpy:673
translate french c23s002_ScaYoga_3cbfaa21:

    # sca "Ahora sí. Hasta luego."
    sca "Voilà, c'est tout. À plus tard."

# game/scripts/c23/c23.rpy:677
translate french c23s002_Montessori_b75a7dd9:

    # "[sai] pasa los siguientes minutos explicándote la biografía de la pedagoga. Por lo visto hizo cosas revolucionarias para su época."
    "[sai] consacre les minutes suivantes à expliquer la biographie de l'éducatrice. Apparemment, elle a accompli des choses révolutionnaires pour son époque."

# game/scripts/c23/c23.rpy:678
translate french c23s002_Montessori_01d25fc0:

    # "Pero es una historia en la que se entrevén muchos grises."
    "Mais c'est une histoire où l'on peut observer de nombreuses nuances de gris."

# game/scripts/c23/c23.rpy:682
translate french c23s002_SaiPregnant_a5389849:

    # mc "¡Verde. Vamos a tener un bebé!"
    mc "Vert. Nous allons avoir un bébé !"

# game/scripts/c23/c23.rpy:684
translate french c23s002_SaiPregnant_b0eb6df2:

    # sai "Felicidades, cielo. Sé que te hacía ilusión."
    sai "Félicitations, ma chérie. Je sais que tu étais impatiente."

# game/scripts/c23/c23.rpy:685
translate french c23s002_SaiPregnant_0b584a5b:

    # mc "No suenas muy contenta."
    mc "Tu n'as pas l'air très heureux."

# game/scripts/c23/c23.rpy:687
translate french c23s002_SaiPregnant_2d6f41fa:

    # sai "Estoy contenta, pero preocupada."
    sai "Je suis heureux, mais inquiet."

# game/scripts/c23/c23.rpy:688
translate french c23s002_SaiPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Pour la course ? Nous vous aiderons de toutes les manières possibles."

# game/scripts/c23/c23.rpy:690
translate french c23s002_SaiPregnant_f2f8f8f9:

    # sai "No, la carrera no me preocupa demasiado. Me parece raro tener un bebé antes de acabarla, pero ya está."
    sai "Non, mes études ne m'inquiètent pas trop. C'est bizarre d'avoir un bébé avant d'avoir terminé, mais c'est tout."

# game/scripts/c23/c23.rpy:691
translate french c23s002_SaiPregnant_7ddf9ba8:

    # sai "Me preocupa decírselo a mis padres."
    sai "J'ai peur de l'annoncer à mes parents."

# game/scripts/c23/c23.rpy:692
translate french c23s002_SaiPregnant_0cabfb10:

    # mc "¿Cómo se lo van a tomar?"
    mc "Comment vont-ils réagir ?"

# game/scripts/c23/c23.rpy:694
translate french c23s002_SaiPregnant_2c5430c4:

    # mc "Bueno, si quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Eh bien, si vous voulez que je sois là pour le lui annoncer, comptez sur moi..."

# game/scripts/c23/c23.rpy:696
translate french c23s002_SaiPregnant_1219b8ff:

    # sai "No te preocupes. No se lo voy a decir todavía."
    sai "Ne t'inquiète pas. Je ne vais pas lui dire pour l'instant."

# game/scripts/c23/c23.rpy:697
translate french c23s002_SaiPregnant_038560de:

    # mc "¿Por qué? ¿Cuánto quieres esperar?"
    mc "Pourquoi ? Combien de temps voulez-vous attendre ?"

# game/scripts/c23/c23.rpy:699
translate french c23s002_SaiPregnant_c5240d56:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les digo que me he quedado embarazada del dueño de la residencia, no le van a dejar venir."
    sai "Du moins jusqu'à l'arrivée de Kaly. Si je leur dis que je suis enceinte du propriétaire, ils ne la laisseront pas venir."

# game/scripts/c23/c23.rpy:700
translate french c23s002_SaiPregnant_4244b12a:

    # sai "Van a pensar que la vas a dejar embarazada en cuanto llegue..."
    sai "Ils vont croire que tu vas la mettre enceinte dès son arrivée..."

# game/scripts/c23/c23.rpy:702
translate french c23s002_SaiPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "Et cela sans même parler de votre réputation de père d'enfants qui a déjà atteint l'Inde."

# game/scripts/c23/c23.rpy:703
translate french c23s002_SaiPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Je n'ai aucune intention d'avoir quoi que ce soit avec Kalyani, [sai]."

# game/scripts/c23/c23.rpy:705
translate french c23s002_SaiPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Rires* Dès que tu verras tes grands yeux cligner, tu me le confirmeras."

# game/scripts/c23/c23.rpy:706
translate french c23s002_SaiPregnant_5aacd3bb:

    # mc "Bueno, pero aparte de lo de tus padres, ¿cómo estás tú?"
    mc "D'accord, mais à part tes parents, comment vas-tu ?"

# game/scripts/c23/c23.rpy:708
translate french c23s002_SaiPregnant_a7bc00ad:

    # sai "Ya te digo que estoy contenta, aunque..."
    sai "Je vous le dis, je suis heureux, même si..."

# game/scripts/c23/c23.rpy:709
translate french c23s002_SaiPregnant_3b916da8:

    # mc "¿Qué pasa?"
    mc "Ce qui se passe?"

# game/scripts/c23/c23.rpy:711
translate french c23s002_SaiPregnant_ed7721cb:

    # sai "No voy a poder volverme a poner este top en cuanto éstas empiecen a crecer. Voy a tener que cambiar el vestuario."
    sai "Je ne pourrai plus porter ce haut une fois que ma poitrine aura commencé à pousser. Il va falloir que je renouvelle ma garde-robe."

# game/scripts/c23/c23.rpy:712
translate french c23s002_SaiPregnant_29681486:

    # mc "*Risa* Vas a estar guapísima lleves lo que lleves."
    mc "*Rires* Tu seras magnifique quoi que tu portes."

# game/scripts/c23/c23.rpy:714
translate french c23s002_SaiPregnant_5b606ea9:

    # sai "No es cómo esperaba que pasara, pero estoy más contenta de lo que parezco. Tan solo me siento rara de tener que ocultárselo a mis padres."
    sai "Ce n'est pas comme ça que je l'imaginais, mais je suis plus heureuse que je n'en ai l'air. C'est juste bizarre de devoir le cacher à mes parents."

# game/scripts/c23/c23.rpy:715
translate french c23s002_SaiPregnant_490a5817:

    # mc "No se lo ocultas, retrasas la noticia tan solo."
    mc "Tu ne lui caches rien, tu retardes simplement l'annonce."

# game/scripts/c23/c23.rpy:717
translate french c23s002_SaiPregnant_50ec1616:

    # sai "¡Vamos a la piscina! Quiero darles la noticia al resto de las chicas. Después lo publicaré en el grupo de WhatsUp."
    sai "Allons à la piscine ! Je veux le dire aux autres filles. Je posterai un message sur le groupe WhatsApp plus tard."

# game/scripts/c23/c23.rpy:718
translate french c23s002_SaiPregnant_c884d001:

    # mc "¿En el que estoy yo o en el que no estoy?"
    mc "Celui dans lequel je suis, ou celui dans lequel je ne suis pas ?"

# game/scripts/c23/c23.rpy:720
translate french c23s002_SaiPregnant_f50b3bac:

    # sai "En los dos. En el tuyo no contestará casi nadie, pero lo publicaré por si alguien quiere felicitarte a ti."
    sai "Dans les deux cas. Presque personne ne répondra au vôtre, mais je le publie au cas où quelqu'un voudrait vous féliciter."

# game/scripts/c23/c23.rpy:721
translate french c23s002_SaiPregnant_831b697a:

    # mc "*Risa* A veces os odio. Vamos."
    mc "*Rires* Parfois, je vous déteste. Allez !"

# game/scripts/c23/c23.rpy:725
translate french c23s002_parents_7589d59f:

    # sai "Imagínate enviar a tu hija al extranjero a estudiar y que antes de que acabe la carrera se quede embarazada."
    sai "Imaginez envoyer votre fille étudier à l'étranger et qu'elle tombe enceinte avant d'avoir terminé ses études."

# game/scripts/c23/c23.rpy:726
translate french c23s002_parents_f5a86a18:

    # sai "Y del dueño de la residencia de estudiantes nada menos... Y sin estar casados..."
    sai "Et de la part du propriétaire de la résidence étudiante, rien de moins… Et sans être marié…"

# game/scripts/c23/c23.rpy:727
translate french c23s002_parents_3c948955:

    # mc "Me lo puedo imaginar. Ya me dijiste que eran muy tradicionales."
    mc "Je peux l'imaginer. Vous m'avez déjà dit qu'ils étaient très traditionnels."

# game/scripts/c23/c23.rpy:729
translate french c23s002_parents_0da23dec:

    # sai "*Risa triste* ¿Tradicionales? Une a eso retrógrados y te acercarás a una versión modernizada de mis padres."
    sai "*Rire triste* Traditionnel ? Ajoutez à cela un côté rétrograde et vous obtiendrez une version presque modernisée de mes parents."

# game/scripts/c23/c23.rpy:730
translate french c23s002_parents_1b3c77e8:

    # sai "A veces parece que vivan en el Siglo XIX o el XX."
    sai "Parfois, on a l'impression qu'ils vivent au XIXe ou au XXe siècle."

# game/scripts/c23/c23.rpy:734
translate french c23s002_SaiNotPregnant_26eea004:

    # mc "Rojo. No vamos a tener un bebé aún."
    mc "Rouge. Nous n'aurons pas encore de bébé."

# game/scripts/c23/c23.rpy:736
translate french c23s002_SaiNotPregnant_d975b988:

    # sai "Bueno, otra vez será. No tenemos prisa."
    sai "Bon, ce sera pour une autre fois. On n'est pas pressés."

# game/scripts/c23/c23.rpy:737
translate french c23s002_SaiNotPregnant_2537456b:

    # mc "No suenas muy decepcionada. Eso es bueno."
    mc "Tu n'as pas l'air très déçu. C'est bien."

# game/scripts/c23/c23.rpy:739
translate french c23s002_SaiNotPregnant_e6495c22:

    # sai "Estoy decepcionada, pero, por otro lado, estoy aliviada."
    sai "Je suis déçu, mais d'un autre côté, je suis soulagé."

# game/scripts/c23/c23.rpy:740
translate french c23s002_SaiNotPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Pour la course ? Nous vous aiderons de toutes les manières possibles."

# game/scripts/c23/c23.rpy:742
translate french c23s002_SaiNotPregnant_b6444778:

    # sai "No, la carrera no me preocupa demasiado. Me hubiera parecido raro tener un bebé antes de acabarla, pero ya está."
    sai "Non, mon diplôme ne m'inquiète pas trop. Avoir un bébé avant de l'avoir terminé aurait paru étrange, mais c'est ainsi."

# game/scripts/c23/c23.rpy:743
translate french c23s002_SaiNotPregnant_4b9b2f05:

    # sai "Me preocupaba decírselo a mis padres."
    sai "J'avais peur de l'annoncer à mes parents."

# game/scripts/c23/c23.rpy:744
translate french c23s002_SaiNotPregnant_0beea497:

    # mc "¿Cómo se lo iban a tomar?"
    mc "Comment allaient-ils réagir ?"

# game/scripts/c23/c23.rpy:746
translate french c23s002_SaiNotPregnant_7eec1ef5:

    # mc "Bueno, si, cuando te quedes embarazada, quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Eh bien, si tu veux que je sois là pour lui annoncer ta grossesse, compte sur moi…"

# game/scripts/c23/c23.rpy:748
translate french c23s002_SaiNotPregnant_e4455855:

    # sai "No te preocupes. No se lo pensaba decir aunque me hubiera quedado embarazada ahora."
    sai "Ne t'inquiète pas. Je n'avais pas l'intention de lui dire, même si j'étais enceinte maintenant."

# game/scripts/c23/c23.rpy:749
translate french c23s002_SaiNotPregnant_d9f65540:

    # mc "¿Por qué? ¿Cuánto hubieras querido esperar?"
    mc "Pourquoi ? Combien de temps auriez-vous voulu attendre ?"

# game/scripts/c23/c23.rpy:751
translate french c23s002_SaiNotPregnant_6016f36c:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les hubiera dicho que me he quedado embarazada del dueño de la residencia, no le iban a dejar venir."
    sai "Du moins jusqu'à l'arrivée de Kaly. Si je leur avais dit que j'étais enceinte du propriétaire, ils ne l'auraient pas laissée venir."

# game/scripts/c23/c23.rpy:752
translate french c23s002_SaiNotPregnant_e27513d6:

    # sai "Iban a pensar que la ibas a dejar embarazada en cuanto llegara..."
    sai "Ils allaient croire que tu allais la mettre enceinte dès son arrivée..."

# game/scripts/c23/c23.rpy:754
translate french c23s002_SaiNotPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "Et cela sans même parler de votre réputation de père d'enfants qui a déjà atteint l'Inde."

# game/scripts/c23/c23.rpy:755
translate french c23s002_SaiNotPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Je n'ai aucune intention d'avoir quoi que ce soit avec Kalyani, [sai]."

# game/scripts/c23/c23.rpy:757
translate french c23s002_SaiNotPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Rires* Dès que tu verras tes grands yeux cligner, tu me le confirmeras."

# game/scripts/c23/c23.rpy:758
translate french c23s002_SaiNotPregnant_79b68995:

    # mc "*Risa* No me tientes, sabes que unos ojos bonitos son mi perdición."
    mc "*Rires* Ne me tente pas, tu sais que les jolis yeux sont ma faiblesse."

# game/scripts/c23/c23.rpy:759
translate french c23s002_SaiNotPregnant_b22bd2d7:

    # mc "Pero volviendo a tus padres, la parte buena es que no tienes que ocultarles nada."
    mc "Mais pour en revenir à tes parents, l'avantage c'est que tu n'as rien à leur cacher."

# game/scripts/c23/c23.rpy:761
translate french c23s002_SaiNotPregnant_7bc4da83:

    # sai "Sí, y al menos no tendré que cambiar de vestuario."
    sai "Oui, et au moins je n'aurai pas à changer de tenue."

# game/scripts/c23/c23.rpy:762
translate french c23s002_SaiNotPregnant_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c23/c23.rpy:764
translate french c23s002_SaiNotPregnant_f3513bd4:

    # sai "Si me hubiera quedado embarazada no hubiera podido volver a ponerme este top en cuanto éstas empezaran a crecer."
    sai "Si j'étais tombée enceinte, je n'aurais plus pu porter ce haut une fois que ma poitrine aurait commencé à se développer."

# game/scripts/c23/c23.rpy:765
translate french c23s002_SaiNotPregnant_5f5a76d1:

    # mc "*Risa* Ibas a estar guapísima llevaras lo que llevaras."
    mc "*Rires* Tu allais être magnifique quoi que tu portes."

# game/scripts/c23/c23.rpy:767
translate french c23s002_SaiNotPregnant_15a7439e:

    # sai "Voy a ir a la piscina a decirle a [mar] y a [emm] que el test ha salido negativo."
    sai "Je vais à la piscine pour dire à [mar] et [emm] que le test est revenu négatif."

# game/scripts/c23/c23.rpy:768
translate french c23s002_SaiNotPregnant_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Voulez-vous que je vous accompagne ?"

# game/scripts/c23/c23.rpy:770
translate french c23s002_SaiNotPregnant_f0467d0d:

    # sai "No hace falta. Me van a querer dar abrazos para consolarme, aunque no sean necesarios. *Risa* Quiero esos abrazos solo para mí."
    sai "Ce n'est pas nécessaire. Ils voudront me faire des câlins pour me réconforter, même si ce n'est pas nécessaire. *Rires* Je veux ces câlins rien que pour moi."

# game/scripts/c23/c23.rpy:771
translate french c23s002_SaiNotPregnant_91dba7af:

    # mc "*Risa* A veces os odio. Te veo luego."
    mc "*Rires* Parfois, je vous déteste. À plus tard."

# game/scripts/c23/c23.rpy:781
translate french c23s002_Lugagge_75bb8a0c:

    # "Vas al lavabo y vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Vous allez aux toilettes puis retournez dans votre chambre pour préparer des vêtements de rechange dans un sac à dos pour l'excursion de demain."

# game/scripts/c23/c23.rpy:783
translate french c23s002_Lugagge_ecee5073:

    # "Después de pasar por la piscina, vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Après la piscine, vous retournez dans votre chambre pour préparer des vêtements de rechange dans un sac à dos pour l'excursion de demain."

# game/scripts/c23/c23.rpy:785
translate french c23s002_Lugagge_c1485301:

    # "Vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Vous retournez dans votre chambre pour préparer des vêtements de rechange dans un sac à dos pour le voyage de demain."

# game/scripts/c23/c23.rpy:786
translate french c23s002_Lugagge_12d1537c:

    # "Cuando casi has acabado..."
    "Quand vous avez presque terminé..."

# game/scripts/c23/c23.rpy:789
translate french c23s002_Lugagge_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c23/c23.rpy:791
translate french c23s002_Lugagge_bb9c1f60:

    # mom "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mom "*À travers la porte* C'est moi. Puis-je entrer ?"

# game/scripts/c23/c23.rpy:792
translate french c23s002_Lugagge_4d601f0e:

    # mc "Sí, pasa."
    mc "Oui, ça arrive."

# game/scripts/c23/c23.rpy:797
translate french c23s002_Lugagge_9bbf8b8f:

    # mom "Venía a ver si querías que te ayudara a hacer la maleta para mañana."
    mom "Je suis venu vous demander si vous vouliez que je vous aide à faire votre valise pour demain."

# game/scripts/c23/c23.rpy:798
translate french c23s002_Lugagge_88471209:

    # mc "*Risa* ¿Maleta? Con una mochila tengo suficiente. Una muda de ropa y artículos de higiene."
    mc "*Rires* Une valise ? Un sac à dos suffit. Des vêtements de rechange et des articles de toilette."

# game/scripts/c23/c23.rpy:800
translate french c23s002_Lugagge_7a59eeaa:

    # mom "¿Sólo eso?"
    mom "C'est tout ?"

# game/scripts/c23/c23.rpy:801
translate french c23s002_Lugagge_d157fcf1:

    # mc "No necesito más. Es solo una noche."
    mc "Je n'ai besoin de rien de plus. Ce n'est qu'une nuit."

# game/scripts/c23/c23.rpy:802
translate french c23s002_Lugagge_0299b411:

    # mom "¿Y si llueve? ¿O si hace frío? Deberías coger una chaqueta."
    mom "Et s'il pleut ? Ou s'il fait froid ? Dans ce cas, il vaut mieux prendre une veste."

# game/scripts/c23/c23.rpy:807
translate french c23s002_Lugagge_54eacab5:

    # mc "[Mom], he mirado las temperaturas en el móvil, y se espera que haga buen día."
    mc "[Mom], j'ai vérifié les températures sur mon portable, et on prévoit une belle journée."

# game/scripts/c23/c23.rpy:809
translate french c23s002_Lugagge_c95214f0:

    # mom "Nunca te puedes fiar de esas aplicaciones, cielo. Acuérdate de cuando fuimos a Fresno. La app decía que iba a hacer sol y llovió."
    mom "Tu ne peux jamais te fier à ces applis, chérie. Tu te souviens quand on est allés à Fresno ? L’appli disait qu’il allait faire beau, et il a plu."

# game/scripts/c23/c23.rpy:810
translate french c23s002_Lugagge_623d3f2f:

    # mc "De eso hace casi diez años, [Mom]. Las aplicaciones son mucho más fiables ahora."
    mc "C'était il y a presque dix ans, [Mom]. Les applications sont beaucoup plus fiables maintenant."

# game/scripts/c23/c23.rpy:812
translate french c23s002_Lugagge_56eefaa0:

    # mom "Bueno, pero llévate una chaqueta por lo que pueda ser. ¿Qué camisas te vas a llevar?"
    mom "D'accord, mais prends une veste au cas où. Quelles chemises comptes-tu emporter ?"

# game/scripts/c23/c23.rpy:813
translate french c23s002_Lugagge_6690c782:

    # mc "Una camiseta. Nada de camisas. Van a llegar arrugadas."
    mc "Un t-shirt. Pas de chemises habillées. Elles arriveront froissées."

# game/scripts/c23/c23.rpy:815
translate french c23s002_Lugagge_9939e1dd:

    # mom "Deberías llevarte la camisa azul. Tienes que ir bien vestido si vas a reunirte con el obispo, y esa camisa te queda muy bien."
    mom "Prenez la chemise bleue. Il faut être bien habillé pour rencontrer l'évêque, et cette chemise vous va très bien."

# game/scripts/c23/c23.rpy:816
translate french c23s002_Lugagge_4eddcb7c:

    # mc "*Risa* No soy yo quien se reúne con el obispo, es Tía [bet]. Por una vez sólo hago de chófer, no tengo que resolver nada."
    mc "*Rires* Ce n'est pas moi qui rencontre l'évêque, c'est ma tante [bet]. Pour une fois, je ne suis que le chauffeur, je n'ai rien à régler."

# game/scripts/c23/c23.rpy:817
translate french c23s002_Lugagge_f5adc8f7:

    # mc "Y la reunión ni siquiera es con el obispo, es con un secretario."
    mc "Et la réunion n'a même pas lieu avec l'évêque, mais avec une secrétaire."

# game/scripts/c23/c23.rpy:819
translate french c23s002_Lugagge_0cff2902:

    # mom "Pero la acompañarás, ¿verdad? Está muy nerviosa."
    mom "Mais tu l'accompagneras, n'est-ce pas ? Elle est très nerveuse."

# game/scripts/c23/c23.rpy:820
translate french c23s002_Lugagge_5f6d22fc:

    # mc "No creo que quiera que la acompañe a la reunión. La llevaré a las oficinas de la diócesis, pero no creo que entrar con ella sea lo mejor."
    mc "Je ne pense pas qu'elle souhaite que je l'accompagne à la réunion. Je la conduirai aux bureaux du diocèse, mais je ne crois pas qu'il soit judicieux d'y entrer avec elle."

# game/scripts/c23/c23.rpy:821
translate french c23s002_Lugagge_d91007c6:

    # mc "De todas formas, le preguntaré, pero dudo que quiera que esté en esa reunión."
    mc "Bref, je lui demanderai, mais je doute qu'il veuille ma présence à cette réunion."

# game/scripts/c23/c23.rpy:823
translate french c23s002_Lugagge_98e60a1c:

    # mom "Bueno, pues mete la camisa azul por si acaso la tienes que acompañar."
    mom "Eh bien, emportez la chemise bleue au cas où vous auriez besoin de l'accompagner."

# game/scripts/c23/c23.rpy:824
translate french c23s002_Lugagge_4d2532ae:

    # mom "Siempre tienes que llevar algo de ropa correcta por si surge un imprevisto."
    mom "Il est toujours conseillé d'avoir sur soi des vêtements appropriés en cas d'imprévu."

# game/scripts/c23/c23.rpy:825
translate french c23s002_Lugagge_fa56d19b:

    # mc "La eché a lavar ayer o anteayer. No la he visto en el armario."
    mc "Je l'ai mis à laver hier ou avant-hier. Je ne l'ai pas vu dans le placard."

# game/scripts/c23/c23.rpy:827
translate french c23s002_Lugagge_8fff1679:

    # mom "Tienes razón, creo que la lavé ayer. Tengo que plancharla."
    mom "Tu as raison, je crois que je l'ai lavé hier. Il faut que je le repasse."

# game/scripts/c23/c23.rpy:828
translate french c23s002_Lugagge_213e7078:

    # mc "No te molestes, [Mom], con una camiseta también voy bien. Además, se va a arrugar en la mochila."
    mc "Ne t'inquiète pas, [Mom], un t-shirt fera l'affaire. De toute façon, il sera tout froissé dans mon sac à dos."

# game/scripts/c23/c23.rpy:830
translate french c23s002_Lugagge_8d3d8ca3:

    # mom "No te preocupes. La meteré en una de las maletas de [emm]. Luego le tengo que ayudar a hacerlas."
    mom "Ne t'inquiète pas. Je le mettrai dans une des valises de [emm]. Ensuite, je devrai l'aider à les faire."

# game/scripts/c23/c23.rpy:831
translate french c23s002_Lugagge_8c11638b:

    # mc "Espera. ¿Has dicho una de las maletas? ¿Cuántas lleva?"
    mc "Attendez. Vous avez dit une des valises ? Combien en a-t-elle ?"

# game/scripts/c23/c23.rpy:833
translate french c23s002_Lugagge_275536a9:

    # mom "La he visto subir con dos maletas del sótano."
    mom "Je l'ai vue remonter du sous-sol avec deux valises."

# game/scripts/c23/c23.rpy:834
translate french c23s002_Lugagge_2b7ff2c2:

    # mc "¿Para una noche?"
    mc "Pour une seule nuit ?"

# game/scripts/c23/c23.rpy:836
translate french c23s002_Lugagge_7c82fa6b:

    # mom "Es [emm]..."
    mom "C'est [emm]..."

# game/scripts/c23/c23.rpy:840
translate french c23s002_Lugagge_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c23/c23.rpy:841
translate french c23s002_Lugagge_fda8aa56:

    # emm "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    emm "*À travers la porte* C'est moi. Puis-je entrer ?"

# game/scripts/c23/c23.rpy:843
translate french c23s002_Lugagge_4d601f0e_1:

    # mc "Sí, pasa."
    mc "Oui, ça arrive."

# game/scripts/c23/c23.rpy:845
translate french c23s002_Lugagge_09daa09b:

    # emm "Mamá, ¿crees que esto será suficiente para mañana?"
    emm "Maman, tu penses que ça suffira pour demain ?"

# game/scripts/c23/c23.rpy:846
translate french c23s002_Lugagge_50a76aac:

    # mc "¿Dónde crees que vas con eso, [emm]?"
    mc "Où crois-tu aller avec ça, [emm] ?"

# game/scripts/c23/c23.rpy:848
translate french c23s002_Lugagge_bc6e01fa:

    # emm "Vamos al norte. Hará más frío que aquí, y ya sabes que yo tengo frío en seguida..."
    emm "Allons vers le nord. Il fera plus froid qu'ici, et tu sais à quel point je suis frileuse..."

# game/scripts/c23/c23.rpy:849
translate french c23s002_Lugagge_9e86e008:

    # mc "Vamos 200 Km al norte. No nos vamos a Alaska..."
    mc "Nous allons 200 km au nord. Nous n'allons pas en Alaska..."

# game/scripts/c23/c23.rpy:851
translate french c23s002_Lugagge_b6d431b2:

    # mom "Te he dicho una chaqueta, [emm], no que te vistas de invierno."
    mom "Je t'avais dit de prendre une veste, [emm], pas de t'habiller pour l'hiver."

# game/scripts/c23/c23.rpy:853
translate french c23s002_Lugagge_75c72859:

    # emm "Pero el Ferrarini será descapotable y hará frío..."
    emm "Mais la Ferrarini sera un cabriolet et il fera froid..."

# game/scripts/c23/c23.rpy:854
translate french c23s002_Lugagge_de0cbafe:

    # mc "No, [emm], el coche no es descapotable. Además, ¿crees que vas a poder conducir con eso puesto?"
    mc "Non, [emm], la voiture n'est pas un cabriolet. D'ailleurs, pensez-vous pouvoir conduire avec ça ?"

# game/scripts/c23/c23.rpy:856
translate french c23s002_Lugagge_44c92de4:

    # emm "Tienes razón. Sería muy incómodo."
    emm "Vous avez raison. Ce serait très gênant."

# game/scripts/c23/c23.rpy:857
translate french c23s002_Lugagge_e9df9ef7:

    # emm "Mamá, ¿me ayudas a escoger una chaqueta adecuada?"
    emm "Maman, peux-tu m'aider à choisir une veste appropriée ?"

# game/scripts/c23/c23.rpy:859
translate french c23s002_Lugagge_a67edac7:

    # mom "Sí, te acompaño. Después tengo que ir a planchar. Deja un hueco en una de tus maletas para una camisa de [mc]."
    mom "Oui, je t'accompagne. Je repasserai après. Garde de la place dans une de tes valises pour une chemise."

# game/scripts/c23/c23.rpy:864
translate french c23s002_Lugagge_1cdac493:

    # mom "Hasta luego, [mc]."
    mom "À plus tard, [mc]."

# game/scripts/c23/c23.rpy:869
translate french c23s002_Lugagge_1f4e85f3:

    # emm "Te vemos luego. Voy a tener que añadir otra maleta por lo de tu camisa."
    emm "À plus tard. Je vais devoir prendre une valise de plus à cause de ta chemise."

# game/scripts/c23/c23.rpy:871
translate french c23s002_Lugagge_41c98829:

    # mcp "(¿Otra maleta por una camisa? Creo que es una excusa para poder llevarse más ropa.)"
    mcp "(Une autre valise pour une chemise ? Je pense que c'est un prétexte pour pouvoir emporter plus de vêtements.)"

# game/scripts/c23/c23.rpy:873
translate french c23s002_Lugagge_884ef907:

    # mcp "(No me extrañaría que se llevara un traje de buzo por si hay una inundación. Mujeres...)"
    mcp "(Je ne serais pas surpris qu'elle ait emporté une combinaison de plongée en cas d'inondation. Les femmes...)"

# game/scripts/c23/c23.rpy:883
translate french c23s002_NoPatty_21994c80:

    # "Cuando acabas de preparar la mochila, trabajas un rato en la contabilidad del dormitorio y después bajas a la cocina a comer algo."
    "Une fois ton sac à dos bouclé, tu travailles un moment sur la comptabilité du dortoir, puis tu descends à la cuisine pour manger un morceau."

# game/scripts/c23/c23.rpy:885
translate french c23s002_NoPatty_1bf6c7ed:

    # "El trozo de pastel era demasiado pequeño."
    "La part de gâteau était trop petite."

# game/scripts/c23/c23.rpy:887
translate french c23s002_NoPatty_3df9d16d:

    # "[nor] aparece al cabo de unos minutos."
    "[nor] apparaît après quelques minutes."

# game/scripts/c23/c23.rpy:888
translate french c23s002_NoPatty_77ad9ccc:

    # nor "Hola, [mc]. ¿No está [mar]?"
    nor "Bonjour, [mc]. [mar] n'est-il pas là ?"

# game/scripts/c23/c23.rpy:895
translate french c23s002_NoPatty_b7d10e84:

    # mc "Hola, cielo."
    mc "Bonjour chérie."

# game/scripts/c23/c23.rpy:897
translate french c23s002_NoPatty_2f11503d:

    # mc "Hola, [Aunt!t][nor]."
    mc "Bonjour, [Aunt!t][nor]."

# game/scripts/c23/c23.rpy:898
translate french c23s002_NoPatty_25f01a6b:

    # mc "Si no está en la habitación de [emm], está en el sótano, planchando. Se ha empeñado en que me lleve la camisa azul mañana a Monterey."
    mc "Si elle n'est pas dans la chambre [emm], elle est au sous-sol en train de repasser. Elle a insisté pour que j'apporte la chemise bleue à Monterey demain."

# game/scripts/c23/c23.rpy:899
translate french c23s002_NoPatty_8c75a300:

    # mc "Ni que me fuera una semana. Si por ella fuera, me tendría que llevar tres maletas para pasar una noche fuera."
    mc "Ce n'est pas comme si je partais une semaine. Si ça ne tenait qu'à elle, il me faudrait trois valises juste pour une seule nuit."

# game/scripts/c23/c23.rpy:901
translate french c23s002_NoPatty_f4b434c3:

    # nor "Es que esa camisa te queda muy bien. Y nunca lo entenderás."
    nor "Cette chemise te va super bien. Et tu ne comprendras jamais."

# game/scripts/c23/c23.rpy:902
translate french c23s002_NoPatty_80f3e399:

    # nor "Las mujeres nos solemos llevar mucha ropa a cualquier sitio. *Risa* Casi puedo apostar a que [emm] va a llevar tres maletas."
    nor "Les femmes ont tendance à emporter beaucoup de vêtements partout où elles vont. *Rires* Je parierais presque que [emm] va prendre trois valises."

# game/scripts/c23/c23.rpy:903
translate french c23s002_NoPatty_3d0d59aa:

    # mc "*Risa* ¿Sólo tres? Ha dicho que iba a añadir otra maleta porque tenía que meter mi camisa."
    mc "*Rires* Seulement trois ? Il a dit qu'il allait ajouter une autre valise parce qu'il devait mettre ma chemise dans sa valise."

# game/scripts/c23/c23.rpy:904
translate french c23s002_NoPatty_01cf69eb:

    # mc "No me extrañaría que cogiera una cuarta maleta para meter el secador y los artículos de higiene."
    mc "Je ne serais pas surpris qu'il ait pris une quatrième valise pour y ranger le sèche-cheveux et les articles de toilette."

# game/scripts/c23/c23.rpy:905
translate french c23s002_NoPatty_b1a3975c:

    # mc "Pero, ¿necesitabas algo? ¿Te puedo ayudar yo?"
    mc "Mais aviez-vous besoin de quelque chose ? Puis-je vous aider ?"

# game/scripts/c23/c23.rpy:907
translate french c23s002_NoPatty_2fe2ba7a:

    # nor "No, no es nada importante. Me han escrito de la universidad diciendo que hay un cambio en las chicas que tenían que alojarse en mi casa."
