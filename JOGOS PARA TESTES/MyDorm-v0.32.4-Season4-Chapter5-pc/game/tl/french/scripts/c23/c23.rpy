    # "Vuestros labios se unen en un dulce beso de buenas noches que cierra con un broche dorado una noche perfecta."
    "Vos lèvres se rencontrent dans un doux baiser de bonne nuit qui clôt une nuit parfaite d'une touche dorée."

# game/scripts/c23/c23.rpy:2467
translate french c23s005_sleep_2d3205c3:

    # "Ahora te toca una de las mejores partes. Dormir abrazado a la mujer más maravillosa del mundo. Porque no hay otra mujer en el mundo."
    "Et voici l'un des meilleurs moments : dormir dans les bras de la femme la plus merveilleuse du monde. Car il n'y a pas d'autre femme au monde."

# game/scripts/c23/c23.rpy:2469
translate french c23s005_sleep_2bd7f903:

    # "Apagáis la luz y os tumbáis a dormir. Tal como has dicho, [mar] está preciosa mientras duerme."
    "Tu éteins la lumière et tu t'allonges pour dormir. Comme tu l'as dit, [mar] est magnifique quand elle dort."

# game/scripts/c23/c23.rpy:2470
translate french c23s005_sleep_408c669c:

    # mom "*Voz adormilada* No me mires..."
    mom "*Voix endormie* Ne me regardez pas..."

# game/scripts/c23/c23.rpy:2471
translate french c23s005_sleep_b87815ac:

    # "No le piensas hacer caso. Es una visión que quieres grabar en tus retinas."
    "Vous n'allez pas l'écouter. C'est une image que vous voudrez graver dans votre mémoire."

# game/scripts/c23/c23.rpy:2473
translate french c23s005_sleep_fbe5dfe9:

    # "La miras hasta que, sin darte cuenta, se te cierran los ojos."
    "Vous la regardez jusqu'à ce que, sans vous en rendre compte, vos yeux se ferment."

# game/scripts/c23/c23.rpy:2475
translate french c23s005_sleep_e0bf00dc:

    # "Duermes plácidamente toda la noche sin recordar tus sueños..."
    "Vous dormez paisiblement toute la nuit sans vous souvenir de vos rêves..."

# game/scripts/c23/c23.rpy:2478
translate french c23s005_Emm_b3f31ca1:

    # centered "{size=+20}{b}DÍA 24 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}JOUR 24 – JEUDI{/b}{/size}"

# game/scripts/c23/c23.rpy:2480
translate french c23s005_Emm_ec286efa:

    # "... Hasta que la puerta se abre de golpe y alguien enciende la luz."
    "…Jusqu’à ce que la porte s’ouvre brusquement et que quelqu’un allume la lumière."

# game/scripts/c23/c23.rpy:2482
translate french c23s005_Emm_58e0ed1f:

    # emm "¡Despertad! ¡Nos tenemos que ir!"
    emm "Réveille-toi ! On doit y aller !"

# game/scripts/c23/c23.rpy:2483
translate french c23s005_Emm_4102bb2b:

    # "OK. Ya estás despierto. Y sobresaltado."
    "OK. Tu es réveillé maintenant. Et surpris."

# game/scripts/c23/c23.rpy:2485
translate french c23s005_Emm_731dbbe0:

    # mom "¿Qué hora es, [emm]? No he oído el despertador."
    mom "Quelle heure est-il, [emm] ? Je n'ai pas entendu le réveil."

# game/scripts/c23/c23.rpy:2486
translate french c23s005_Emm_01b992b8:

    # "En algún momento, durante la noche, [mar] se ha tapado con el edredón."
    "À un moment donné de la nuit, [mar] s'est couvert avec la couette."

# game/scripts/c23/c23.rpy:2488
translate french c23s005_Emm_1b146ec7:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a la habitación de [mc]. Y resulta que estaba aquí."
    emm "6h00 du matin. Je suis réveillé depuis plus d'une heure, et je me retiens d'aller dans la chambre de [mc]. Et il s'avère qu'il était là."

# game/scripts/c23/c23.rpy:2491
translate french c23s005_Emm_18ac9830:

    # emm "¡Y no me habéis invitado! Pero os lo perdono porque hoy estoy emocionada con el viaje."
    emm "Et tu ne m'as même pas invité ! Mais je te pardonne parce que je suis tellement contente de partir en voyage aujourd'hui."

# game/scripts/c23/c23.rpy:2492
translate french c23s005_Emm_8f31b5b2:

    # emm "Pero si no os levantáis ya, se va a hacer tarde."
    emm "Mais si tu ne te lèves pas maintenant, il va se faire tard."

# game/scripts/c23/c23.rpy:2493
translate french c23s005_Emm_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], nous avions dit que nous partirions d'ici à 8h00. J'avais réglé mon réveil pour 7h15."

# game/scripts/c23/c23.rpy:2495
translate french c23s005_Emm_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "Et dans 45 minutes, tu allais prendre une douche..."

# game/scripts/c23/c23.rpy:2496
translate french c23s005_Emm_f4b84d41:

    # mc "Me duché anoche..."
    mc "J'ai pris une douche hier soir..."

# game/scripts/c23/c23.rpy:2497
translate french c23s005_Emm_d664759d:

    # emm "A vestirte..."
    emm "S'habiller..."

# game/scripts/c23/c23.rpy:2498
translate french c23s005_Emm_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Je suis un homme. Il me faut moins de cinq minutes. Cinq vraies minutes…"

# game/scripts/c23/c23.rpy:2499
translate french c23s005_Emm_d6f2a180:

    # emm "Y a desayunar..."
    emm "Et c'est l'heure du petit-déjeuner..."

# game/scripts/c23/c23.rpy:2500
translate french c23s005_Emm_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Voilà à quoi ont servi 30 des 45 minutes. *Rires*"

# game/scripts/c23/c23.rpy:2501
translate french c23s005_Emm_711c7675:

    # mc "Puedes ir preparando el café, si quieres ir avanzando."
    mc "Vous pouvez commencer à préparer le café, si vous voulez vous y mettre."

# game/scripts/c23/c23.rpy:2503
translate french c23s005_Emm_54e1c1b6:

    # mom "No os preocupéis por el desayuno. Ya lo preparo yo mientras te vistes."
    mom "Ne t'inquiète pas pour le petit-déjeuner. Je le préparerai pendant que tu t'habilles."

# game/scripts/c23/c23.rpy:2504
translate french c23s005_Emm_e3ab73bc:

    # mom "De todas formas mi despertador iba a sonar en 15 minutos para prepararlo."
    mom "Bref, mon réveil allait sonner dans 15 minutes, donc je pouvais me préparer."

# game/scripts/c23/c23.rpy:2506
translate french c23s005_Emm_15b05d64:

    # emm "Mamá, eres la mejor. Sabía que no ibas a dejar que nos fuéramos con sólo un trozo de tarta de ayer en el estómago."
    emm "Maman, tu es la meilleure. Je savais que tu ne nous laisserais pas partir avec juste un morceau de gâteau de la veille dans le ventre."

# game/scripts/c23/c23.rpy:2507
translate french c23s005_Emm_e096a202:

    # mc "Vale, [emm]... ¿Tía [bet] ya está despierta?"
    mc "D'accord, [emm]... Tante [bet] est-elle déjà réveillée ?"

# game/scripts/c23/c23.rpy:2509
translate french c23s005_Emm_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Je ne sais pas ! Je ne suis pas encore allée la voir !"

# game/scripts/c23/c23.rpy:2510
translate french c23s005_Emm_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "Qu'est-ce que tu attends ? C'est une femme, elle mettra plus de temps que moi à s'habiller."

# game/scripts/c23/c23.rpy:2511
translate french c23s005_Emm_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Tu as raison ! Je m'en vais !"

# game/scripts/c23/c23.rpy:2514
translate french c23s005_Emm_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:2516
translate french c23s005_Emm_80ab0291:

    # emm "*A través de la puerta* ¡Lo tengo que hacer todo yo!"
    emm "*À travers la porte* Je dois tout faire moi-même !"

# game/scripts/c23/c23.rpy:2518
translate french c23s005_Emm_f7f4d563:

    # mc "Y se fue. Voy a vestirme y a ayudarte a preparar el desayuno."
    mc "Et elle est partie. Je vais m'habiller et t'aider à préparer le petit-déjeuner."

# game/scripts/c23/c23.rpy:2520
translate french c23s005_Emm_232a26e2:

    # mom "No es necesario, puedes dormir un rato más, si quieres. ¿Te levanto dentro de 30 minutos?"
    mom "Ce n'est pas nécessaire, vous pouvez dormir un peu plus longtemps si vous voulez. Je vous réveille dans 30 minutes ?"

# game/scripts/c23/c23.rpy:2521
translate french c23s005_Emm_beeb27c0:

    # mc "No voy a poder dormirme otra vez si no estás aquí."
    mc "Je ne pourrai plus me rendormir si tu n'es pas là."

# game/scripts/c23/c23.rpy:2522
translate french c23s005_Emm_f104feef:

    # mc "Me va a faltar tu peso sobre mi pecho."
    mc "Ton poids sur ma poitrine va me manquer."

# game/scripts/c23/c23.rpy:2524
translate french c23s005_Emm_7b679049:

    # "[mar] te besa apasionadamente por sorpresa. Te podrías acostumbrar a despertarte así todos los días."
    "[mar] Il t'embrasse passionnément et à l'improviste. Tu pourrais t'habituer à te réveiller ainsi tous les jours."

# game/scripts/c23/c23.rpy:2526
translate french c23s005_Emm_e4df2143:

    # mom "Entonces sube a vestirte y ven a la cocina."
    mom "Ensuite, monte à l'étage, habille-toi et viens dans la cuisine."

# game/scripts/c23/c23.rpy:2542
translate french c23s006_AfterBreakfastBetConfession_6b8dfbb6:

    # "Después de desayunar bajas las {b}tres{/b} maletas de [emm] a la camioneta."
    "Après le petit-déjeuner, vous prenez les trois valises de c2 et vous les mettez dans la camionnette."

# game/scripts/c23/c23.rpy:2543
translate french c23s006_AfterBreakfastBetConfession_79e3a8e3:

    # "[bet] solo lleva una maleta pequeña, donde lleva el hábito y otras cosas más normales."
    "[bet] Elle ne transporte qu'une petite valise, où elle range son habitude et d'autres choses plus normales."

# game/scripts/c23/c23.rpy:2544
translate french c23s006_AfterBreakfastBetConfession_a6fd427d:

    # "Tú sólo llevas tu mochila."
    "Vous ne portez que votre sac à dos."

# game/scripts/c23/c23.rpy:2547
translate french c23s006_AfterBreakfastBetConfession_22f01abd:

    # mom "No corras. Conduce con cuidado. Haz un par de paradas a medio camino para descansar..."
    mom "Ne roulez pas trop vite. Conduisez prudemment. Faites quelques arrêts en cours de route pour vous reposer..."

# game/scripts/c23/c23.rpy:2548
translate french c23s006_AfterBreakfastBetConfession_32ff118e:

    # mc "No te preocupes, en cuanto lleguemos te llamo para decirte que hemos llegado bien. Espera la llamada alrededor de la hora de comer."
    mc "Ne t'inquiète pas, je t'appellerai dès notre arrivée pour te rassurer. L'appel devrait avoir lieu vers midi."

# game/scripts/c23/c23.rpy:2550
translate french c23s006_AfterBreakfastBetConfession_a2652fb6:

    # mom "¿Tan tarde?"
    mom "Si tard ?"

# game/scripts/c23/c23.rpy:2551
translate french c23s006_AfterBreakfastBetConfession_c2eaf91d:

    # mc "Cuando lleguemos tenemos que ir a alquilar el coche y después tengo que llevar a Tía [bet]."
    mc "Quand nous arriverons, nous devrons louer la voiture et ensuite je devrai emmener tante [bet]."

# game/scripts/c23/c23.rpy:2552
translate french c23s006_AfterBreakfastBetConfession_fa66d2bd:

    # mc "Mejor que la esperes tarde y te llame antes, a que la esperes pronto y me retrase."
    mc "Il vaut mieux que tu l'attendes en retard et qu'elle t'appelle plus tôt, plutôt que tu l'attendes en avance et que je sois en retard."

# game/scripts/c23/c23.rpy:2555
translate french c23s006_AfterBreakfastBetConfession_e0795c02:

    # mom "Hasta mañana, mi amor."
    mom "À demain, mon amour."

# game/scripts/c23/c23.rpy:2558
translate french c23s006_AfterBreakfastBetConfession_58ac1d50:

    # mom "Hasta mañana, [mc]."
    mom "À demain, [mc]."

# game/scripts/c23/c23.rpy:2559
translate french c23s006_AfterBreakfastBetConfession_6bb4321b:

    # mc "No te preocupes por nada. Vamos dos adultos... y [emm]. Hasta mañana."
    mc "Ne t'inquiète de rien. Il y a deux adultes... et [emm]. À demain."

# game/scripts/c23/c23.rpy:2562
translate french c23s006_AfterBreakfastBetConfession_b53a8c44:

    # "Al cabo de unos minutos, sospechosamente cuando todas las maletas ya están cargadas, aparece [emm]."
    "Après quelques minutes, de façon suspecte alors que toutes les valises sont déjà chargées, [emm] apparaît."

# game/scripts/c23/c23.rpy:2564
translate french c23s006_AfterBreakfastBetConfession_98dad1eb:

    # emm "¡Me pido el asiento de atrás! Así podré echar una cabezada por el camino."
    emm "Je prendrai la place arrière ! Comme ça, je pourrai faire une sieste en route."

# game/scripts/c23/c23.rpy:2565
translate french c23s006_AfterBreakfastBetConfession_ad278a8e:

    # mc "No esperarás ir tumbada, ¿verdad?"
    mc "Vous n'allez tout de même pas vous laisser faire, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:2567
translate french c23s006_AfterBreakfastBetConfession_2f1b87bd:

    # emm "Claro que sí. He dormido muy poco..."
    emm "Bien sûr. J'ai très peu dormi..."

# game/scripts/c23/c23.rpy:2568
translate french c23s006_AfterBreakfastBetConfession_1baf40e6:

    # mcp "(Y has dejado dormir poco a los demás.)"
    mcp "(Et vous avez laissé les autres dormir très peu.)"

# game/scripts/c23/c23.rpy:2569
translate french c23s006_AfterBreakfastBetConfession_f7a399a1:

    # emm "Y no me vengas con que si frenas de golpe me voy a caer del asiento. Conduces como una abuelita."
    emm "Et ne me dites pas que si vous freinez brusquement, je vais tomber de mon siège. Vous conduisez comme une grand-mère."

# game/scripts/c23/c23.rpy:2570
translate french c23s006_AfterBreakfastBetConfession_5ddd15d0:

    # mc "Era precisamente lo que te iba a decir. *Risa* Bueno, excepto lo de la abuelita."
    mc "C'est exactement ce que j'allais te dire. *Rires* Enfin, sauf pour le passage sur grand-mère."

# game/scripts/c23/c23.rpy:2572
translate french c23s006_AfterBreakfastBetConfession_8e89c4e6:

    # emm "¡Pero no puedo dormir sentada! ¡Siempre acabo con dolor de cuello y de mal humor!"
    emm "Mais je n'arrive pas à dormir assise ! Je finis toujours par avoir mal au cou et par être de mauvaise humeur !"

# game/scripts/c23/c23.rpy:2573
translate french c23s006_AfterBreakfastBetConfession_a041378f:

    # emm "Y eso me va a estropear el día."
    emm "Et ça va me gâcher la journée."

# game/scripts/c23/c23.rpy:2574
translate french c23s006_AfterBreakfastBetConfession_191006ce:

    # mc "Lo que me extraña es que no estés de mal humor por haber tenido que levantarte temprano. *Risa*"
    mc "Ce qui me surprend, c'est que tu ne sois pas de mauvaise humeur à l'idée de te lever tôt. *Rires*"

# game/scripts/c23/c23.rpy:2576
translate french c23s006_AfterBreakfastBetConfession_e6d83b0e:

    # emm "¡Hoy había una buena razón para hacerlo!"
    emm "Aujourd'hui, il y avait une bonne raison de le faire !"

# game/scripts/c23/c23.rpy:2577
translate french c23s006_AfterBreakfastBetConfession_6a65be27:

    # mc "Bueno, por ahí viene Tía [bet]. Ya nos podemos ir."
    mc "Voilà tante [bet]. On peut y aller maintenant."

# game/scripts/c23/c23.rpy:2579
translate french c23s006_AfterBreakfastBetConfession_60cd69d7:

    # "Tras unas cuantas despedidas más, por fin os ponéis en camino."
    "Après quelques adieux supplémentaires, vous êtes finalement partis."

# game/scripts/c23/c23.rpy:2580
translate french c23s006_AfterBreakfastBetConfession_acd46f2a:

    # "Por suerte habéis salido con tiempo. Había unas obras en la carretera antes de llegar a Atascadero que os han retrasado un poco."
    "Heureusement, vous êtes parti bien à l'avance. Il y avait des travaux routiers avant d'arriver à Atascadero, ce qui vous a un peu retardé."

# game/scripts/c23/c23.rpy:2582
translate french c23s006_AfterBreakfastBetConfession_a38307b1:

    # "Aún vais bien de tiempo."
    "Vous avez encore largement le temps."

# game/scripts/c23/c23.rpy:2585
translate french c23s006_AfterBreakfastBetConfession_75d8b8da:

    # emm "¿Cómo estás, Tía [bet]? ¿Nerviosa?"
    emm "Comment vas-tu, tante [bet] ? Nerveuse ?"

# game/scripts/c23/c23.rpy:2587
translate french c23s006_AfterBreakfastBetConfession_f3201952:

    # mcp "(Extrañamente [emm] se preocupa por otras personas en un día importante para ella. ¿Habrá entendido lo que significa la empatía?)"
    mcp "(Étrangement, [emm] se soucie des autres un jour qui est important pour elle. Aurait-elle enfin compris le sens de l'empathie ?)"

# game/scripts/c23/c23.rpy:2589
translate french c23s006_AfterBreakfastBetConfession_9823ca60:

    # bet "Sí, estoy nerviosa. No tengo ni idea de qué va a pasar en esa reunión, pero no soy capaz de encontrar ningún escenario bueno para mí."
    bet "Oui, je suis nerveux. Je n'ai aucune idée de ce qui va se passer lors de cette réunion, mais je n'imagine aucun scénario qui me soit favorable."

# game/scripts/c23/c23.rpy:2590
translate french c23s006_AfterBreakfastBetConfession_6d5eb0ec:

    # mc "El mejor escenario para ti sería que te destinasen a otro hospital en África, en otro país, ¿no?"
    mc "Le meilleur scénario pour vous serait d'être affecté à un autre hôpital en Afrique, dans un autre pays, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:2592
translate french c23s006_AfterBreakfastBetConfession_5d599fd4:

    # emm "Eso no, Tía. Nadie quiere que te vayas ahora que te conocemos mejor y que la abuela se va a mudar aquí."
    emm "Non, tante. Personne ne veut que tu partes maintenant qu'on te connaît mieux et que grand-mère emménage ici."

# game/scripts/c23/c23.rpy:2593
translate french c23s006_AfterBreakfastBetConfession_65730c64:

    # mc "Pero no tenemos que ser egoístas, [emm]. Yo tampoco quiero que se vaya, pero si es lo que quiere ella..."
    mc "Mais nous ne devons pas être égoïstes. Je ne veux pas qu'elle parte non plus, mais si c'est ce qu'elle souhaite…"

# game/scripts/c23/c23.rpy:2595
translate french c23s006_AfterBreakfastBetConfession_17d2fc40:

    # bet "Gracias, chicos. Realmente aún no sé lo que quiero. Me gustaría volver a África."
    bet "Merci les gars. Je ne sais pas encore vraiment ce que je veux. J'aimerais retourner en Afrique."

# game/scripts/c23/c23.rpy:2596
translate french c23s006_AfterBreakfastBetConfession_9408a313:

    # bet "Pero también me gustaría quedarme por aquí y trabajar en algún hospital que me permita veros más a menudo."
    bet "Mais j'aimerais aussi rester ici et travailler dans un hôpital qui me permettrait de vous voir plus souvent."

# game/scripts/c23/c23.rpy:2597
translate french c23s006_AfterBreakfastBetConfession_a8285983:

    # bet "Incluso hay un par de hospitales católicos cerca de casa donde podría trabajar sin mudarme de Newport."
    bet "Il y a même quelques hôpitaux catholiques près de chez moi où je pourrais travailler sans avoir à quitter Newport."

# game/scripts/c23/c23.rpy:2598
translate french c23s006_AfterBreakfastBetConfession_7409e022:

    # mc "Eso sería fantástico. Nadie quiere que te vayas de casa, pero todos lo entenderíamos si decidieras volver a África."
    mc "Ce serait formidable. Personne ne souhaite que tu quittes la maison, mais nous comprendrions tous si tu décidais de retourner en Afrique."

# game/scripts/c23/c23.rpy:2599
translate french c23s006_AfterBreakfastBetConfession_927f1ed8:

    # mc "Bueno, quizás todos menos [emm]. *Risa*"
    mc "Bon, peut-être tout le monde sauf [emm]. *Rires*"

# game/scripts/c23/c23.rpy:2601
translate french c23s006_AfterBreakfastBetConfession_219cca74:

    # emm "*Risa* Ni siquiera que gastes bromas sobre mí va a poder estropearme el día."
    emm "*Rires* Même vos blagues à mon sujet ne vont pas gâcher ma journée."

# game/scripts/c23/c23.rpy:2602
translate french c23s006_AfterBreakfastBetConfession_6b3f5e74:

    # mc "Nunca querría estropearte el día, hermanita. Además, tengo una sorpresa para ti, para cuando lleguemos a Monterey."
    mc "Je ne voudrais surtout pas gâcher ta journée, petite sœur. D'ailleurs, j'ai une surprise pour toi quand on arrivera à Monterey."

# game/scripts/c23/c23.rpy:2604
translate french c23s006_AfterBreakfastBetConfession_5ffbefca:

    # emm "¿Qué es?"
    emm "Qu'est-ce que c'est?"

# game/scripts/c23/c23.rpy:2605
translate french c23s006_AfterBreakfastBetConfession_67e6de57:

    # mc "No te lo voy a decir. Si te lo dijera, ya no sería una sorpresa."
    mc "Je ne vais pas vous le dire. Si je le faisais, ce ne serait plus une surprise."

# game/scripts/c23/c23.rpy:2607
translate french c23s006_AfterBreakfastBetConfession_44cef866:

    # emm "Decirme que tienes una sorpresa para mí y no decirme qué es... Eso sí que podría estropearme el día..."
    emm "Me dire que tu as une surprise pour moi sans me dire ce que c'est… Ça pourrait vraiment me gâcher la journée…"

# game/scripts/c23/c23.rpy:2608
translate french c23s006_AfterBreakfastBetConfession_d51f57a2:

    # mc "Los chantajes emocionales no sirven conmigo, [emm]."
    mc "Le chantage affectif ne fonctionne pas sur moi, [emm]."

