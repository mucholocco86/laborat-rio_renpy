    # bet "*Risa* Te puedo asegurar que sus pedos NO eran arcoíris. Sabías que había estado en una habitación horas después de que se fuera."
    bet "*Rires* Je peux vous assurer que ses pets n'étaient PAS des arcs-en-ciel. On savait qu'il était resté dans une pièce des heures après son départ."

# game/scripts/c23/c23.rpy:2689
translate french c23s006_AfterBreakfastBetConfession_49aba72c:

    # bet "Bromeábamos con que no fue a Vietnam porque se le consideraba un arma química con piernas. *Risa*"
    bet "On plaisantait en disant qu'il n'était pas allé au Vietnam parce qu'il était considéré comme une arme chimique ambulante. *Rires*"

# game/scripts/c23/c23.rpy:2690
translate french c23s006_AfterBreakfastBetConfession_44f9ad22:

    # mc "*Risa* Bueno, al menos en eso no me parezco a él... creo."
    mc "*Rires* Enfin, au moins sur ce point je ne suis pas comme lui... je crois."

# game/scripts/c23/c23.rpy:2692
translate french c23s006_AfterBreakfastBetConfession_331c1e76:

    # bet "Sobre el resto, como resumen está bien. Se conocieron cuando [mee] iba a la universidad. John ya había acabado."
    bet "Pour le reste, c'est un bon résumé. Ils se sont rencontrés lorsque [mee] était à l'université. John avait déjà obtenu son diplôme."

# game/scripts/c23/c23.rpy:2693
translate french c23s006_AfterBreakfastBetConfession_b8677642:

    # bet "[mee] estaba en su tercer año en San Luis Obispo y yo acababa de empezar en Stanford."
    bet "[mee] était dans sa troisième année à San Luis Obispo et je venais de commencer à Stanford."

# game/scripts/c23/c23.rpy:2694
translate french c23s006_AfterBreakfastBetConfession_396c3c56:

    # bet "John estaba trabajando en un pequeño estudio de arquitectura en San Francisco."
    bet "John travaillait dans un petit cabinet d'architecture à San Francisco."

# game/scripts/c23/c23.rpy:2696
translate french c23s006_AfterBreakfastBetConfession_39888221:

    # mc "Sigo sin entender qué tiene que ver el abuelo en todo esto."
    mc "Je ne comprends toujours pas ce que le grand-père a à voir avec tout ça."

# game/scripts/c23/c23.rpy:2698
translate french c23s006_AfterBreakfastBetConfession_c44ca57b:

    # mc "Sigo sin entender qué tiene que ver John en todo esto."
    mc "Je ne comprends toujours pas ce que John a à voir avec tout ça."

# game/scripts/c23/c23.rpy:2700
translate french c23s006_AfterBreakfastBetConfession_68f149a5:

    # bet "Déjame continuar y lo entenderás."
    bet "Laissez-moi continuer et vous comprendrez."

# game/scripts/c23/c23.rpy:2701
translate french c23s006_AfterBreakfastBetConfession_67102796:

    # bet "Yo conocí a John antes que [mee]. Me lo presentó un amigo común."
    bet "J'ai rencontré John avant [mee]. Un ami commun nous a présentés."

# game/scripts/c23/c23.rpy:2702
translate french c23s006_AfterBreakfastBetConfession_9f83902b:

    # mc "¿Os llevabais bien?"
    mc "Vous vous êtes bien entendus ?"

# game/scripts/c23/c23.rpy:2704
translate french c23s006_AfterBreakfastBetConfession_325bf1ea:

    # bet "Nos hicimos amigos en seguida."
    bet "Nous sommes devenus amis immédiatement."

# game/scripts/c23/c23.rpy:2705
translate french c23s006_AfterBreakfastBetConfession_baea9b98:

    # bet "Teníamos un sentido del humor muy parecido, a los dos nos gustaba pasear, y salía con mi grupo de amigos los fines de semana."
    bet "Nous avions un sens de l'humour très similaire, nous aimions tous les deux faire des promenades, et je sortais avec mon groupe d'amis le week-end."

# game/scripts/c23/c23.rpy:2706
translate french c23s006_AfterBreakfastBetConfession_8516836a:

    # bet "Era el mayor de todos nosotros, pero eso era bueno. Arnold no había sido gobernador y la edad para beber eran 21 todavía."
    bet "Il était le plus âgé d'entre nous, mais c'était un avantage. Arnold n'était pas encore gouverneur, et l'âge légal pour boire était toujours de 21 ans."

# game/scripts/c23/c23.rpy:2707
translate french c23s006_AfterBreakfastBetConfession_9494eba4:

    # mc "¿Lo llevabais para que os comprara alcohol? *Risa*"
    mc "Tu l'as emmené pour qu'il t'achète de l'alcool ? *Rires*"

# game/scripts/c23/c23.rpy:2709
translate french c23s006_AfterBreakfastBetConfession_ad5fa407:

    # bet "Eran los setenta... conseguir alcohol... y otras cosas... era fácil. *Risa* Pero sí, él nos compraba las bebidas."
    bet "C'était les années soixante-dix… se procurer de l'alcool… et d'autres choses… était facile. *Rires* Mais oui, il nous offrait des verres."

# game/scripts/c23/c23.rpy:2710
translate french c23s006_AfterBreakfastBetConfession_20ab19b8:

    # mc "*Risa* Tía [bet] en plan malota, bebiendo... y haciendo otras cosas... ilegalmente. Me hubiera gustado conocerte en aquella época."
    mc "*Rires* Tante [bet] qui fait la dure, qui boit… et qui fait d’autres choses… illégales. J’aurais aimé te connaître à cette époque."

# game/scripts/c23/c23.rpy:2712
translate french c23s006_AfterBreakfastBetConfession_60943014:

    # bet "*Risa* Yo era una chiquilla divertida en aquella época. Creo que nos hubiéramos llevado bien."
    bet "*Rires* J'étais une enfant joyeuse à l'époque. Je pense que nous nous serions bien entendus."

# game/scripts/c23/c23.rpy:2713
translate french c23s006_AfterBreakfastBetConfession_f51ac469:

    # mc "Sigues siendo divertida y nos llevamos bien. No ha cambiado nada."
    mc "Tu es toujours aussi sympa et on s'entend toujours aussi bien. Rien n'a changé."

# game/scripts/c23/c23.rpy:2715
translate french c23s006_AfterBreakfastBetConfession_55459c89:

    # bet "Excepto que tengo 46 años más que entonces..."
    bet "Sauf que j'ai 46 ans de plus qu'à l'époque..."

# game/scripts/c23/c23.rpy:2716
translate french c23s006_AfterBreakfastBetConfession_395d9e0e:

    # mc "Bueno, la edad sólo es un número. Si te sientes joven eres joven."
    mc "L'âge n'est qu'un chiffre. Si vous vous sentez jeune, vous êtes jeune."

# game/scripts/c23/c23.rpy:2718
translate french c23s006_AfterBreakfastBetConfession_1bb5e936:

    # bet "¡Qué fácil parece todo a tu edad!"
    bet "Tout semble si facile à ton âge !"

# game/scripts/c23/c23.rpy:2719
translate french c23s006_AfterBreakfastBetConfession_6e1125b6:

    # bet "Pero volviendo a John..."
    bet "Mais revenons à John..."

# game/scripts/c23/c23.rpy:2720
translate french c23s006_AfterBreakfastBetConfession_720e0757:

    # bet "Nos llevábamos tan bien que empecé a ver cosas dónde no las había."
    bet "Nous nous entendions si bien que j'ai commencé à voir des choses là où il n'y en avait pas."

# game/scripts/c23/c23.rpy:2721
translate french c23s006_AfterBreakfastBetConfession_e3c28eeb:

    # bet "Me hacía la encontradiza con él para verlo, paseaba cerca de su trabajo, de su casa..."
    bet "J'essayais de le croiser par hasard, de le voir, je passais près de son travail, près de chez lui..."

# game/scripts/c23/c23.rpy:2722
translate french c23s006_AfterBreakfastBetConfession_83728b01:

    # mc "Vaya, que te enamoraste como una adolescente."
    mc "Waouh, tu es tombé amoureux comme un adolescent."

# game/scripts/c23/c23.rpy:2724
translate french c23s006_AfterBreakfastBetConfession_de131cf3:

    # bet "*Risa triste* ¡Era una adolescente!"
    bet "*Rire triste* C'était une adolescente !"

# game/scripts/c23/c23.rpy:2725
translate french c23s006_AfterBreakfastBetConfession_c9cdb920:

    # bet "Pero sí, enamorada hasta las trancas. Y un poco acosadora."
    bet "Oui, follement amoureuse. Et un peu obsessionnelle."

# game/scripts/c23/c23.rpy:2726
translate french c23s006_AfterBreakfastBetConfession_bfcfc81c:

    # mc "Esas cosas pasan cuando eres joven."
    mc "Ces choses arrivent quand on est jeune."

# game/scripts/c23/c23.rpy:2728
translate french c23s006_AfterBreakfastBetConfession_90cc7385:

    # bet "Ya te dije que yo vivía en una caravana cerca del campus, ¿no?"
    bet "Je vous ai déjà dit que je vivais dans une caravane près du campus, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:2729
translate french c23s006_AfterBreakfastBetConfession_0e7ce500:

    # mc "Sí, la caravana rosa de la que [emm] estaría orgullosa."
    mc "Oui, la caravane rose dont [emm] serait fier."

# game/scripts/c23/c23.rpy:2731
translate french c23s006_AfterBreakfastBetConfession_5e564651:

    # bet "Pues [mee] vino a visitarme un fin de semana, se iba a quedar a dormir en la caravana el viernes y el sábado."
    bet "Eh bien, [mee] est venu me rendre visite pour le week-end, il allait passer la nuit dans la caravane vendredi et samedi."

# game/scripts/c23/c23.rpy:2733
translate french c23s006_AfterBreakfastBetConfession_83578eae:

    # mc "Y conoció al abuelo."
    mc "Et il rencontra son grand-père."

# game/scripts/c23/c23.rpy:2735
translate french c23s006_AfterBreakfastBetConfession_f0d2d10b:

    # mc "Y conoció a John."
    mc "Et elle a rencontré John."

# game/scripts/c23/c23.rpy:2737
translate french c23s006_AfterBreakfastBetConfession_9c437df7:

    # bet "Exacto. La llevé a una bar, donde había quedado con mi grupo de amigos y se la presenté a todo el mundo."
    bet "Exactement. Je l'ai emmenée dans un bar où je retrouvais mes amis et je l'ai présentée à tout le monde."

# game/scripts/c23/c23.rpy:2738
translate french c23s006_AfterBreakfastBetConfession_aff28618:

    # bet "Y ahí entra lo que tú conoces. Amor a primera vista."
    bet "Et c'est là que vos connaissances entrent en jeu. Le coup de foudre."

# game/scripts/c23/c23.rpy:2739
translate french c23s006_AfterBreakfastBetConfession_907e6dd5:

    # bet "Él arquitecto. Ella estudiando arquitectura. Empezaron a charlar y encajaron."
    bet "Il était architecte. Elle étudiait l'architecture. Ils ont commencé à discuter et le courant est tout de suite passé."

# game/scripts/c23/c23.rpy:2741
translate french c23s006_AfterBreakfastBetConfession_ea724bd7:

    # bet "Parecía que el resto del mundo no existía para ellos, como si fuéramos estatuas decorativas del bar."
    bet "On aurait dit que le reste du monde n'existait pas pour eux, comme si nous étions des statues décoratives dans le bar."

# game/scripts/c23/c23.rpy:2742
translate french c23s006_AfterBreakfastBetConfession_fabb8ff0:

    # bet "Se pasaron toda la noche juntos, charlando y riendo. Conociéndose."
    bet "Ils ont passé toute la nuit ensemble, à bavarder et à rire. À apprendre à se connaître."

# game/scripts/c23/c23.rpy:2743
translate french c23s006_AfterBreakfastBetConfession_a5680026:

    # mc "Y tú te sentiste fatal."
    mc "Et vous vous sentiez mal."

# game/scripts/c23/c23.rpy:2745
translate french c23s006_AfterBreakfastBetConfession_2d672509:

    # bet "Sí. No quiero endulzarlo. *Risa* Me comporté como una niña celosa de mi propia hermana."
    bet "Oui. Je ne vais pas minimiser les choses. *Rires* J'ai agi comme une petite fille jalouse envers ma propre sœur."

# game/scripts/c23/c23.rpy:2746
translate french c23s006_AfterBreakfastBetConfession_8afc0df8:

    # bet "*Risa* Me pasé toda la noche pensando en mil formas de asesinar a [mee] cuando fuéramos a la caravana a dormir."
    bet "*Rires* J'ai passé toute la nuit à penser à mille façons de tuer [mee] quand nous sommes allés dormir dans la caravane."

# game/scripts/c23/c23.rpy:2747
translate french c23s006_AfterBreakfastBetConfession_8411fb7d:

    # mc "Pero no lo hiciste. *Risa* Si todos los asesinatos mentales sucedieran, no quedaría nadie en el mundo."
    mc "Mais vous ne l'avez pas fait. *Rires* Si tous les meurtres psychiatriques avaient lieu, il ne resterait plus personne sur Terre."

# game/scripts/c23/c23.rpy:2749
translate french c23s006_AfterBreakfastBetConfession_ba3e7d41:

    # bet "No lo hice porque [mee] no vino a dormir a la caravana ninguna de las dos noches."
    bet "Je ne l'ai pas fait parce que [mee] n'est pas venu dormir dans la caravane aucune des deux nuits."

# game/scripts/c23/c23.rpy:2750
translate french c23s006_AfterBreakfastBetConfession_e04a5c20:

    # mc "Eso es sorprendente, viniendo de Meemaw."
    mc "C'est surprenant venant de Mémé."

# game/scripts/c23/c23.rpy:2752
translate french c23s006_AfterBreakfastBetConfession_bb687e89:

    # bet "Ella también era joven entonces. *Risa* Y recuerda lo del amor a primera vista."
    bet "Elle était jeune à l'époque aussi. *Rires* Et n'oublie pas le coup de foudre !"

# game/scripts/c23/c23.rpy:2753
translate french c23s006_AfterBreakfastBetConfession_7c5b2432:

    # mc "Amor a primera vista y sexo a primer parpadeo. *Risa* Pero sigo sin entender qué tiene que ver eso con lo que pasó el otro día."
    mc "Coup de foudre et sexe au premier clin d'œil. *Rires* Mais je ne comprends toujours pas le rapport avec ce qui s'est passé l'autre jour."

# game/scripts/c23/c23.rpy:2755
translate french c23s006_AfterBreakfastBetConfession_77c5b7ce:

    # bet "Ni [mee] ni John sabían lo que yo sentía por él. Con lo que di un paso a un lado y empecé mi descenso a los infiernos."
    bet "Ni [mee] ni John ne savaient ce que je ressentais pour lui. Alors je me suis effacé et j'ai entamé ma descente aux enfers."

# game/scripts/c23/c23.rpy:2756
translate french c23s006_AfterBreakfastBetConfession_ba4ae07c:

    # mc "Así que John es quien, sin saberlo, te empujó a frecuentar esas compañías inadecuadas de las que hablaste."
    mc "C’est donc John qui, sans le savoir, vous a poussé à fréquenter ces entreprises inappropriées que vous avez mentionnées."

# game/scripts/c23/c23.rpy:2757
translate french c23s006_AfterBreakfastBetConfession_2b019f8b:

    # mc "Y finalmente hacerte monja..."
    mc "Et enfin, devenir nonne..."

# game/scripts/c23/c23.rpy:2759
translate french c23s006_AfterBreakfastBetConfession_433c9882:

    # bet "No, no me empujó él. Me empujó el no saber gestionar mis emociones."
    bet "Non, il ne m'a pas poussé. C'est mon incapacité à maîtriser mes émotions qui m'a poussé."

# game/scripts/c23/c23.rpy:2760
translate french c23s006_AfterBreakfastBetConfession_ab94bc8b:

    # bet "Era una niña imbécil que no podía soportar ver al hombre del que me había enamorado con otra."
    bet "J'étais une fille stupide qui ne supportait pas de voir l'homme dont j'étais tombée amoureuse avec une autre."

# game/scripts/c23/c23.rpy:2761
translate french c23s006_AfterBreakfastBetConfession_dd5d1635:

    # bet "Y menos aún con mi hermana."
    bet "Et encore moins avec ma sœur."

# game/scripts/c23/c23.rpy:2763
translate french c23s006_AfterBreakfastBetConfession_e194d768:

    # bet "Sentía como si [mee] me lo hubiera robado. *Risa triste* No me podía robar algo que nunca fue mío, pero era como me sentía."
    bet "J'avais l'impression que [mee] me l'avait volé. *Rire triste* Je ne pouvais pas voler quelque chose qui ne m'avait jamais appartenu, mais c'est pourtant ce que j'ai ressenti."

# game/scripts/c23/c23.rpy:2764
translate french c23s006_AfterBreakfastBetConfession_55a20160:

    # mc "Te entiendo. Las comidas familiares tuvieron que ser una pesadilla para ti."
    mc "Je comprends. Les repas en famille ont dû être un vrai cauchemar pour vous."

# game/scripts/c23/c23.rpy:2766
translate french c23s006_AfterBreakfastBetConfession_d4ba9580:

    # bet "Lo fueron durante un tiempo, la boda de [mee] incluida. Después ya no."
    bet "Ils l'ont été pendant un certain temps, y compris pour le mariage de [mee]. Puis ils ne l'ont plus été."

# game/scripts/c23/c23.rpy:2767
translate french c23s006_AfterBreakfastBetConfession_636b4824:

    # bet "Me alegré mucho por ellos, pero dejé de ir a esas comidas. Siempre buscaba una excusa para quedarme en Stanford."
    bet "J'étais très contente pour eux, mais j'ai cessé d'aller à ces repas. Je cherchais toujours une excuse pour rester à Stanford."

# game/scripts/c23/c23.rpy:2769
translate french c23s006_AfterBreakfastBetConfession_e4232a8c:

    # bet "Eso me distanció de [mee] y de tus bisabuelos. Me sentí muy sola durante años."
    bet "Cela m'a éloigné de [mee] et de vos arrière-grands-parents. Je me suis senti très seul pendant des années."

# game/scripts/c23/c23.rpy:2771
translate french c23s006_AfterBreakfastBetConfession_a13fabc5:

    # bet "Eso me distanció de [mee] y de mis padres. Me sentí muy sola durante años"
    bet "Cela m'a éloigné de [mee] et de mes parents. Je me suis senti très seul pendant des années."

# game/scripts/c23/c23.rpy:2772
translate french c23s006_AfterBreakfastBetConfession_5e2cf973:

    # mc "Y encontraste a la iglesia que llenó ese vacío."
    mc "Et vous avez trouvé l'église qui a comblé ce vide."

# game/scripts/c23/c23.rpy:2774
translate french c23s006_AfterBreakfastBetConfession_23b458a9:

    # bet "Sí, pero fue mucho más tarde. Me volqué en estudiar primero y en trabajar después."
    bet "Oui, mais c'était bien plus tard. Je me suis d'abord concentré sur mes études, et j'ai travaillé ensuite."

# game/scripts/c23/c23.rpy:2775
translate french c23s006_AfterBreakfastBetConfession_2fb56829:

    # bet "Cuando acabé la carrera, mientras hacía la residencia en San José descubrí que la religión ayudaba a muchas personas a superar sus pérdidas."
    bet "Après avoir obtenu mon diplôme, pendant mon internat à San José, j'ai découvert que la religion aidait beaucoup de gens à surmonter leurs pertes."

# game/scripts/c23/c23.rpy:2777
translate french c23s006_AfterBreakfastBetConfession_3f08b0e8:

    # bet "Empecé a ir a la iglesia y poco tiempo después lo dejé todo atrás y me hice monja. El resto ya lo sabes."
    bet "J'ai commencé à aller à l'église, et peu de temps après, j'ai tout quitté pour devenir religieuse. Vous connaissez la suite."

# game/scripts/c23/c23.rpy:2779
translate french c23s006_AfterBreakfastBetConfession_f8cafc43:

    # mc "Y todo ese tiempo estuviste enamorada del abuelo, ¿no? ¿Hasta que murió?"
    mc "Et pendant tout ce temps, tu étais amoureuse de ton grand-père, n'est-ce pas ? Jusqu'à sa mort ?"

# game/scripts/c23/c23.rpy:2781
translate french c23s006_AfterBreakfastBetConfession_14e82712:

    # mc "Y todo ese tiempo estuviste enamorada de John, ¿no? ¿Hasta que murió?"
    mc "Et pendant tout ce temps, tu étais amoureuse de John, n'est-ce pas ? Jusqu'à sa mort ?"

# game/scripts/c23/c23.rpy:2783
translate french c23s006_AfterBreakfastBetConfession_979cf0f8:

    # bet "No tanto, pero lo estuve durante mucho tiempo."
    bet "Pas tellement, mais je l'ai été pendant longtemps."

# game/scripts/c23/c23.rpy:2784
translate french c23s006_AfterBreakfastBetConfession_0f4baa8f:

    # bet "Hasta que, a principios de los 90, me fui a África y descubrí que mis problemas eran nimiedades comparados con los del resto del mundo."
    bet "Jusqu'à ce que, au début des années 90, je parte en Afrique et découvre que mes problèmes étaient insignifiants comparés à ceux du reste du monde."

# game/scripts/c23/c23.rpy:2785
translate french c23s006_AfterBreakfastBetConfession_e649715c:

    # bet "Una historia de amor no correspondido que duró más de 10 años, y en la que no hay culpables aparte de mí."
    bet "Une histoire d'amour non partagé qui a duré plus de 10 ans, et dans laquelle il n'y a pas d'autres coupables que moi."

# game/scripts/c23/c23.rpy:2786
translate french c23s006_AfterBreakfastBetConfession_d12f1b69:

    # mc "No creo que haya culpables, ni siquiera tú. Te enamoraste y lo guardaste en silencio. Otra mujer se llevó al chico."
    mc "Je ne pense pas que quiconque soit à blâmer, pas même toi. Tu es tombé amoureux et tu l'as gardé pour toi. Une autre femme t'a pris ton fils."

# game/scripts/c23/c23.rpy:2788
translate french c23s006_AfterBreakfastBetConfession_d68451be:

    # bet "Por eso es por lo que más culpable me sentí todos esos años. Mi cabeza estaba llena de escenarios que no pasaron."
    bet "C’est pour ça que je me suis sentie si coupable pendant toutes ces années. J’avais la tête pleine de scénarios qui ne se sont jamais produits."

# game/scripts/c23/c23.rpy:2789
translate french c23s006_AfterBreakfastBetConfession_b10aa4ec:

    # bet "¿Qué hubiera pasado si le hubiera dicho a John lo que sentía por él antes de presentarle a [mee]?"
    bet "Que se serait-il passé si j'avais dit à John ce que je ressentais à son sujet avant de le présenter à [mee] ?"

# game/scripts/c23/c23.rpy:2790
translate french c23s006_AfterBreakfastBetConfession_360a42cb:

    # bet "¿Hubiera sido correspondida? ¿Hubiéramos durado? ¿Hubiera sido un matrimonio tan bonito como el que tuvo [mee]?"
    bet "Mes sentiments auraient-ils été réciproques ? Notre relation aurait-elle duré ? Notre mariage aurait-il été aussi beau que celui de [mee] ?"

# game/scripts/c23/c23.rpy:2791
translate french c23s006_AfterBreakfastBetConfession_3d127226:

    # mc "Son cosas que no puedes saber, con lo que no tienes que pensar en eso. Solo te harás daño."
    mc "Ce sont des choses que tu ne peux pas savoir, alors ne t'y attarde pas. Tu ne feras que te faire du mal."

# game/scripts/c23/c23.rpy:2793
translate french c23s006_AfterBreakfastBetConfession_c05bd513:

    # bet "Hacía años que no pensaba en eso. Hasta que pasó lo del otro día."
    bet "Je n'y avais pas pensé depuis des années. Jusqu'à ce qui s'est passé l'autre jour."

# game/scripts/c23/c23.rpy:2794
translate french c23s006_AfterBreakfastBetConfession_e266889c:

    # mc "Y ahí vino el \"Otra vez\". Estabas viviendo otra vez lo mismo, con la misma persona."
    mc "Et puis, c'était reparti pour un tour. Vous viviez la même chose, avec la même personne."

# game/scripts/c23/c23.rpy:2796
translate french c23s006_AfterBreakfastBetConfession_e608e602:

    # mc "Pero esta vez era yo en vez del abuelo."
    mc "Mais cette fois, c'était moi à la place de grand-père."

# game/scripts/c23/c23.rpy:2798
translate french c23s006_AfterBreakfastBetConfession_5ac837c0:

    # mc "Pero esta vez era yo en vez de John."
    mc "Mais cette fois, c'était moi et non John."

# game/scripts/c23/c23.rpy:2800
translate french c23s006_AfterBreakfastBetConfession_5d2be7a8:

    # bet "No pareces sorprendido."
    bet "Tu n'as pas l'air surpris."

# game/scripts/c23/c23.rpy:2801
translate french c23s006_AfterBreakfastBetConfession_22eb8a58:

    # mc "No lo estoy. Empecé a sospecharlo aquel día en el que hablamos de por qué [kia] me estaba evitando."
    mc "Non. J'ai commencé à le soupçonner ce jour-là, quand on a parlé des raisons pour lesquelles [kia] m'évitait."

# game/scripts/c23/c23.rpy:2802
translate french c23s006_AfterBreakfastBetConfession_4a03f641:

    # mc "Después de lo que pasó en el baño, has sido tú la que me evitabas."
    mc "Après ce qui s'est passé dans la salle de bain, c'est toi qui m'as évité."

# game/scripts/c23/c23.rpy:2803
translate french c23s006_AfterBreakfastBetConfession_dc27d420:

    # mc "Y tu historia me ha dado el contexto para entender el \"Otra vez\", que era la única pieza que me faltaba."
    mc "Et votre récit m'a permis de comprendre le « Encore », qui était la seule pièce manquante."

# game/scripts/c23/c23.rpy:2805
translate french c23s006_AfterBreakfastBetConfession_eaa2602f:

    # bet "Pues ahora lo entiendes todo. Me siento estúpida."
    bet "Maintenant vous comprenez tout. Je me sens bête."

# game/scripts/c23/c23.rpy:2806
translate french c23s006_AfterBreakfastBetConfession_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c23/c23.rpy:2808
translate french c23s006_AfterBreakfastBetConfession_dc1ef5d1:

    # bet "Por mil razones. Porque me he vuelto a enamorar de una persona que no debo."
    bet "Pour mille raisons. Parce que je suis retombée amoureuse de quelqu'un que je ne devrais pas."

# game/scripts/c23/c23.rpy:2810
translate french c23s006_AfterBreakfastBetConfession_92d4465f:

    # bet "Porque esa persona es mi sobrino nieto."
    bet "Parce que cette personne est mon petit-neveu."

# game/scripts/c23/c23.rpy:2811
translate french c23s006_AfterBreakfastBetConfession_0e60839f:

    # bet "Porque soy 1,000 años mayor que él."
    bet "Parce que j'ai 1000 ans de plus que lui."

# game/scripts/c23/c23.rpy:2812
translate french c23s006_AfterBreakfastBetConfession_03e19a9b:

    # bet "Porque, aunque existiera la remota posibilidad de que quisieras estar conmigo, yo no podría porque soy monja."
    bet "Car, même s'il y avait une infime possibilité que tu veuilles être avec moi, je ne pourrais pas, car je suis une nonne."

# game/scripts/c23/c23.rpy:2813
translate french c23s006_AfterBreakfastBetConfession_8949cccb:

    # bet "Porque soy una vieja estúpida..."
    bet "Parce que je suis une vieille femme stupide..."

# game/scripts/c23/c23.rpy:2814
translate french c23s006_AfterBreakfastBetConfession_ad386c7e:

    # mc "Te voy a hacer dos preguntas, que es lo único que no he entendido."
    mc "Je vais vous poser deux questions, c'est la seule chose que je n'ai pas comprise."

# game/scripts/c23/c23.rpy:2815
translate french c23s006_AfterBreakfastBetConfession_269ca14d:

    # bet "Dime..."
    bet "Dites-moi..."

# game/scripts/c23/c23.rpy:2817
translate french c23s006_AfterBreakfastBetConfession_93174448:

    # mc "¿Te has enamorado de mí o del reflejo que ves del abuelo en mí?"
    mc "Êtes-vous tombé amoureux de moi, ou du reflet que vous voyez en moi de votre grand-père ?"

# game/scripts/c23/c23.rpy:2819
translate french c23s006_AfterBreakfastBetConfession_025c7aa9:

    # mc "¿Te has enamorado de mí o del reflejo que ves de John en mí?"
    mc "Es-tu tombé amoureux de moi, ou du reflet de John que tu vois en moi ?"

# game/scripts/c23/c23.rpy:2821
translate french c23s006_AfterBreakfastBetConfession_0d0dbd6c:

    # bet "¿Cuándo te has vuelto así?"
    bet "Quand es-tu devenu comme ça ?"

# game/scripts/c23/c23.rpy:2822
translate french c23s006_AfterBreakfastBetConfession_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c23/c23.rpy:2823
translate french c23s006_AfterBreakfastBetConfession_3551d6e0:

    # bet "Hace dos semanas no hubieras preguntado eso. No te hubieras ni siquiera dado cuenta. Ni te lo hubieras planteado."
    bet "Il y a deux semaines, vous n'auriez pas posé cette question. Vous ne l'auriez même pas remarqué. Vous n'y auriez même pas pensé."

# game/scripts/c23/c23.rpy:2824
translate french c23s006_AfterBreakfastBetConfession_e6c9391d:

    # mc "He tenido una buena maestra a la hora de observar cosas. No he pasado tanto tiempo contigo como me gustaría, pero el suficiente para aprender algunos trucos."
    mc "J'ai eu un excellent professeur pour ce qui est de l'observation. Je n'ai pas passé autant de temps avec vous que je l'aurais souhaité, mais suffisamment pour apprendre quelques astuces."

# game/scripts/c23/c23.rpy:2826
translate french c23s006_AfterBreakfastBetConfession_1c7cf176:

    # bet "Empecé en pensar en ti de una forma inapropiada porque me recordabas a John."
    bet "J'ai commencé à penser à toi d'une manière inappropriée parce que tu me rappelais John."

# game/scripts/c23/c23.rpy:2827
translate french c23s006_AfterBreakfastBetConfession_0df00951:

    # bet "Pero me he dado cuenta de que lo que me gusta de ti son las cosas que te hacen diferente a él."
    bet "Mais j'ai réalisé que ce que j'aime chez toi, ce sont les choses qui te différencient de lui."

# game/scripts/c23/c23.rpy:2828
translate french c23s006_AfterBreakfastBetConfession_f47f1290:

    # mc "Lo que significa que no era tan perfecto... pedos aparte."
    mc "Ce qui signifie que ce n'était pas si parfait... pets mis à part."

# game/scripts/c23/c23.rpy:2830
translate french c23s006_AfterBreakfastBetConfession_f0e80352:

    # bet "*Risa* No era perfecto. Y tú tampoco lo eres, no empieces a buscar un pedestal al que subirte."
    bet "*Rires* Il n'était pas parfait. Et vous non plus, alors ne cherchez pas à vous mettre sur un piédestal."

# game/scripts/c23/c23.rpy:2831
translate french c23s006_AfterBreakfastBetConfession_83479e7a:

    # bet "Pero tú tienes virtudes que él no tenía, y algunas que él tenía son más grandes en ti. Pero lo mismo pasa con los defectos."
    bet "Mais tu possèdes des vertus qu'il n'avait pas, et certaines de celles qu'il possédait sont même plus grandes en toi. Il en va de même pour tes défauts."

# game/scripts/c23/c23.rpy:2833
translate french c23s006_AfterBreakfastBetConfession_ccd78334:

    # bet "Tan solo es que... tu combinación de virtudes y defectos es diferente..."
    bet "C'est juste que... votre combinaison de forces et de faiblesses est différente..."

# game/scripts/c23/c23.rpy:2834
translate french c23s006_AfterBreakfastBetConfession_e0946371:

    # bet "Me recuerdas mucho a él. También a [mee] se lo recuerdas. Pero no sois la misma persona."
    bet "Tu me le rappelles beaucoup. Tu lui fais penser à [mee] aussi. Mais vous n'êtes pas la même personne."

# game/scripts/c23/c23.rpy:2835
translate french c23s006_AfterBreakfastBetConfession_d89a9f1a:

    # bet "Pero hay una segunda pregunta..."
    bet "Mais il y a une deuxième question..."

# game/scripts/c23/c23.rpy:2836
translate french c23s006_AfterBreakfastBetConfession_a896bf5b:

    # mc "Y esa va a ser la más complicada."
    mc "Et ce sera le plus compliqué."

# game/scripts/c23/c23.rpy:2837
translate french c23s006_AfterBreakfastBetConfession_116a5016:

    # mc "¿Cómo querrías que acabara esto? Como has dicho, eres monja."
    mc "Comment aimeriez-vous que cela se termine ? Comme vous l'avez dit, vous êtes une nonne."

# game/scripts/c23/c23.rpy:2839
translate french c23s006_AfterBreakfastBetConfession_81fa4560:

    # bet "No tengo una respuesta para esa pregunta. Y no es la pregunta que me esperaba."
    bet "Je n'ai pas de réponse à cette question. Et ce n'est pas la question à laquelle je m'attendais."

# game/scripts/c23/c23.rpy:2840
translate french c23s006_AfterBreakfastBetConfession_abc02a0b:

    # mc "¿Qué pregunta esperabas?"
    mc "À quelle question vous attendiez-vous ?"

# game/scripts/c23/c23.rpy:2842
translate french c23s006_AfterBreakfastBetConfession_9d736f53:

    # bet "No sé, algo en plan \"¿Te has vuelto loca, Tía [bet]?\" *Risa*"
    bet "Je ne sais pas, un truc du genre : « Tu es devenue folle, tante ? » *Rires*"

# game/scripts/c23/c23.rpy:2843
translate french c23s006_AfterBreakfastBetConfession_48662069:

    # mc "¿Por qué iba a preguntarte algo así?"
    mc "Pourquoi vous demanderais-je une chose pareille ?"

# game/scripts/c23/c23.rpy:2846
translate french c23s006_AfterBreakfastBetConfession_69825cdc:

    # bet "Porque es una locura."
    bet "Parce que c'est fou."

# game/scripts/c23/c23.rpy:2847
translate french c23s006_AfterBreakfastBetConfession_2acee1f5:

    # bet "Que yo sienta esto y que tengamos esta conversación precisamente hoy."
    bet "Que je ressens cela et que nous ayons cette conversation aujourd'hui."

# game/scripts/c23/c23.rpy:2863
translate french c23s006_AfterBreakfastBetConfession_e87268ed:

    # bet "Lo sé. Entre la edad, ser monja, y ni siquiera saber lo que quiero..."
    bet "Je sais. Entre mon âge, le fait d'être religieuse et le fait que je ne sais même pas ce que je veux..."

# game/scripts/c23/c23.rpy:2864
translate french c23s006_AfterBreakfastBetConfession_52142a7a:

    # mc "Principalmente la última razón. Creo que tienes la cabeza hecha un lío ahora mismo."
    mc "Principalement la dernière raison. Je pense que tu as la tête qui tourne en ce moment."

# game/scripts/c23/c23.rpy:2865
translate french c23s006_AfterBreakfastBetConfession_98030007:

    # mc "Estás muy presionada con esta visita y me parece que estás buscando experiencias que viviste antes de ser monja por si tienes que dejar de serlo."
    mc "Cette visite vous met beaucoup sous pression, et il me semble que vous recherchez des expériences que vous avez vécues avant de devenir religieuse, au cas où vous devriez cesser de l'être."

# game/scripts/c23/c23.rpy:2867
translate french c23s006_AfterBreakfastBetConfession_19d38509:

    # bet "Empecé a sentir algo por ti antes de saber nada de esta visita..."
    bet "J'ai commencé à éprouver des sentiments pour toi avant même de savoir quoi que ce soit sur cette visite..."

# game/scripts/c23/c23.rpy:2868
translate french c23s006_AfterBreakfastBetConfession_b986d233:

    # mc "Pero esos sentimientos han crecido desde que lo sabes, ¿verdad?"
    mc "Mais ces sentiments se sont intensifiés depuis que vous l'avez découvert, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:2869
translate french c23s006_AfterBreakfastBetConfession_726b97aa:

    # bet "Sí..."
    bet "Ouais..."

# game/scripts/c23/c23.rpy:2870
translate french c23s006_AfterBreakfastBetConfession_8955be1d:

    # mc "Hagamos un trato. Resolvamos lo de la visita al obispado y después volvemos a hablar sobre cómo te sientes. ¿Te parece bien?"
    mc "Trouvons un arrangement. Organiseons la visite à l'évêché, et nous reparlerons ensuite de ce que vous ressentez. Ça vous convient ?"

# game/scripts/c23/c23.rpy:2871
translate french c23s006_AfterBreakfastBetConfession_de7d5078:

    # mc "De esa forma sabrás hacia dónde va tu vida y qué quieres hacer con ella."
    mc "Ainsi, vous saurez où vous allez dans la vie et ce que vous voulez en faire."

# game/scripts/c23/c23.rpy:2873
translate french c23s006_AfterBreakfastBetConfession_df3e1714:

    # bet "Me parece un buen plan. Creo que tienes razón y que la incertidumbre de este viaje me está afectando más de lo que debería."
    bet "Ça me paraît une bonne idée. Je crois que tu as raison, et l'incertitude liée à ce voyage m'affecte plus qu'elle ne le devrait."

# game/scripts/c23/c23.rpy:2876
translate french c23s006_AfterBreakfastBetConfession_90897d00:

    # bet "¿Qué? Ahora el que estás loco eres tú."
    bet "Quoi ? C'est toi qui es fou maintenant."

# game/scripts/c23/c23.rpy:2877
translate french c23s006_AfterBreakfastBetConfession_3ce076c4:

    # mc "No quiero influir en tu decisión sobre qué hacer hoy pero, de todos los impedimentos que has puesto, es el único que veo insalvable."
    mc "Je ne veux pas influencer votre décision quant à ce que vous allez faire aujourd'hui, mais de tous les obstacles que vous avez dressés, c'est le seul qui me semble insurmontable."

# game/scripts/c23/c23.rpy:2878
translate french c23s006_AfterBreakfastBetConfession_1910dd40:

    # mc "Quiero que la decisión que tomes, la tomes por ti, no por mí. No tengo ningún derecho a pedirte que dejes de ser monja y no lo voy a hacer."
    mc "Je veux que tu prennes cette décision toi-même, pas pour moi. Je n'ai aucun droit de te demander d'arrêter d'être religieuse, et je ne le ferai pas."

# game/scripts/c23/c23.rpy:2880
translate french c23s006_AfterBreakfastBetConfession_55466a06:

    # bet "¿Me estás diciendo que, si no fuera monja, estarías conmigo?"
    bet "Tu es en train de me dire que si je n'étais pas une nonne, tu serais avec moi ?"

# game/scripts/c23/c23.rpy:2881
translate french c23s006_AfterBreakfastBetConfession_4cecda61:

    # mc "Te estoy diciendo que, si no fueras monja, tendríamos una posibilidad de estar juntos."
    mc "Je te dis que si tu n'étais pas une religieuse, nous aurions une chance d'être ensemble."

# game/scripts/c23/c23.rpy:2882
translate french c23s006_AfterBreakfastBetConfession_2e5cde8c:

    # mc "Sé que no estarías a gusto si pasara mientras aún lo eres. Y no quiero que esto pese en tu decisión de qué hacer hoy."
    mc "Je sais que tu ne serais pas à l'aise si cela arrivait pendant que tu es encore jeune. Et je ne veux pas que cela influence ta décision quant à ce que tu vas faire aujourd'hui."

# game/scripts/c23/c23.rpy:2884
translate french c23s006_AfterBreakfastBetConfession_844e3a3d:

    # bet "Pero no me puedes pedir eso..."
    bet "Mais vous ne pouvez pas me demander ça..."

# game/scripts/c23/c23.rpy:2885
translate french c23s006_AfterBreakfastBetConfession_8354474c:

    # mc "Exacto. NO te lo estoy pidiendo."
    mc "Exactement. Je ne vous le demande pas."

# game/scripts/c23/c23.rpy:2886
translate french c23s006_AfterBreakfastBetConfession_a57d3d10:

    # mc "Cuando ese secretario te diga qué opciones tienes, deberás decidir qué quieres hacer con tu vida."
    mc "Lorsque cette secrétaire vous énumérera les options qui s'offrent à vous, vous devrez décider ce que vous voulez faire de votre vie."

# game/scripts/c23/c23.rpy:2887
translate french c23s006_AfterBreakfastBetConfession_1440bb4c:

    # mc "Decidas lo que decidas, yo voy a apoyarte."
    mc "Quel que soit votre choix, je vous soutiendrai."

# game/scripts/c23/c23.rpy:2888
translate french c23s006_AfterBreakfastBetConfession_158f2936:

    # mc "Y no quiero que esa decisión tenga nada que ver con esta conversación. Lo tienes que decidir por lo que quieres tú."
    mc "Et je ne veux pas que cette décision ait la moindre incidence sur cette conversation. Vous devez décider en fonction de ce que vous voulez."

# game/scripts/c23/c23.rpy:2890
translate french c23s006_AfterBreakfastBetConfession_24a83dd2:

    # bet "Estás pidiendo un imposible. ¿Cómo no voy a tener en cuenta lo que has dicho?"
    bet "Vous demandez l'impossible. Comment puis-je ignorer ce que vous avez dit ?"

# game/scripts/c23/c23.rpy:2891
translate french c23s006_AfterBreakfastBetConfession_b6788258:

    # mc "Porque primero tienes que saber lo que te dicen. Después tienes que decidir qué quieres."
    mc "Car il faut d'abord savoir ce qu'ils vous disent. Ensuite, il faut décider de ce que l'on veut."

# game/scripts/c23/c23.rpy:2892
translate french c23s006_AfterBreakfastBetConfession_30cf15e2:

    # mc "Si te dicen que puedes volver a África, ¿lo dejarías correr y dejarías de ser monja?"
    mc "Si on vous disait que vous pouviez retourner en Afrique, accepteriez-vous et cesseriez-vous d'être une nonne ?"

# game/scripts/c23/c23.rpy:2894
translate french c23s006_AfterBreakfastBetConfession_690d08fe:

    # bet "Seguramente me arrepentiría si lo hiciera..."
    bet "Je le regretterais probablement si je le faisais..."

# game/scripts/c23/c23.rpy:2895
translate french c23s006_AfterBreakfastBetConfession_36abd58f:

    # mc "Por eso tienes que decidir una vez sepas que opciones tienes. No en base a esta conversación, sino en base a lo que tú quieres hacer."
    mc "C'est pourquoi vous devez prendre une décision une fois que vous connaîtrez toutes les options qui s'offrent à vous. Non pas en fonction de cette conversation, mais en fonction de ce que vous souhaitez faire."

# game/scripts/c23/c23.rpy:2896
translate french c23s006_AfterBreakfastBetConfession_c27ce51f:

    # mc "Pero si decides dejar de ser monja, porque tú quieres dejar de serlo, me gustaría que tuviéramos una oportunidad."
    mc "Mais si vous décidez de cesser d'être religieuse, parce que vous le souhaitez, j'aimerais que nous ayons une chance."

# game/scripts/c23/c23.rpy:2898
translate french c23s006_AfterBreakfastBetConfession_4293882f:

    # mc "¿Y sabes una cosa, Tía [bet]? Pase lo que pase hoy, decidas lo que decidas, te voy a seguir queriendo. Todos lo vamos a hacer."
    mc "Et tu sais quoi, tante ? Quoi qu'il arrive aujourd'hui, quelle que soit ta décision, je continuerai à t'aimer. Nous t'aimerons tous."

# game/scripts/c23/c23.rpy:2900
translate french c23s006_AfterBreakfastBetConfession_c7e0f64c:

    # bet "Gracias, [mc]. Nadie podría pedir una familia mejor."
    bet "Merci, [mc]. On ne pourrait pas rêver d'une meilleure famille."

# game/scripts/c23/c23.rpy:2901
translate french c23s006_AfterBreakfastBetConfession_c8acdb43:

    # bet "Y sobre la familia..."
    bet "Et à propos de la famille..."

# game/scripts/c23/c23.rpy:2903
translate french c23s006_AfterBreakfastBetConfession_f63b975f:

    # "Pasáis los siguientes 40 minutos charlando de cómo ha cambiado la familia en los días que hace que llegaron las estudiantes, [bet] y [mee]."
    "Vous passez les 40 minutes suivantes à discuter de la façon dont la famille a changé depuis l'arrivée des élèves, [bet] et [mee]."

# game/scripts/c23/c23.rpy:2904
translate french c23s006_AfterBreakfastBetConfession_53deecef:

    # "Ninguno de vosotros podría imaginar cómo iba a evolucionar. Los dos estáis contentos de cómo lo ha hecho."
    "Aucun de vous deux n'aurait pu imaginer comment cela se passerait. Vous êtes tous les deux satisfaits du résultat."

# game/scripts/c23/c23.rpy:2906
translate french c23s006_AfterBreakfastBetConfession_9abf102f:

    # "Dejáis la conversación aparcada para más adelante."
    "Vous laissez la conversation de côté pour plus tard."

# game/scripts/c23/c23.rpy:2908
translate french c23s006_AfterBreakfastBetConfession_098d5e8b:

    # "Cuando estáis a mitad de la ruta..."
    "Lorsque vous êtes à mi-chemin du parcours..."

# game/scripts/c23/c23.rpy:2910
translate french c23s006_AfterBreakfastBetConfession_5e1f901f:

    # emm "*Bostezo* ¿Falta mucho? ¡Me estoy meando!"
    emm "*Bâillement* On arrive bientôt ? J'ai envie de faire pipi !"

# game/scripts/c23/c23.rpy:2911
translate french c23s006_AfterBreakfastBetConfession_905c0ea0:

    # mc "*Risa* La Bella Durmiente se ha despertado y se ha convertido en La Bella Meona."
    mc "*Rires* La Belle au Bois Dormant s'est réveillée et est devenue la Belle qui fait pipi."

# game/scripts/c23/c23.rpy:2912
translate french c23s006_AfterBreakfastBetConfession_adb3d7ff:

    # mc "Queda poco más de una hora."
    mc "Il reste un peu plus d'une heure."

# game/scripts/c23/c23.rpy:2914
translate french c23s006_AfterBreakfastBetConfession_5ce2ed8e:

    # emm "¿Podemos parar en algún bar de carretera? Os invito a desayunar de nuevo y así voy al lavabo."
    emm "On pourrait s'arrêter dans un bar en bord de route ? Je t'offrirai encore le petit-déjeuner, et ensuite j'irai aux toilettes."

# game/scripts/c23/c23.rpy:2915
translate french c23s006_AfterBreakfastBetConfession_47b16007:

    # mc "*Risa* ¿Segundo desayuno? ¿Has comprobado si tienes los pies peludos?"
    mc "*Rires* Un deuxième petit-déjeuner ? Avez-vous vérifié si vous avez des poils aux pieds ?"

# game/scripts/c23/c23.rpy:2917
translate french c23s006_AfterBreakfastBetConfession_98d377a6:

    # bet "Creo que [emm] no va a pillar la referencia."
    bet "Je ne pense pas que [emm] détectera la référence."

# game/scripts/c23/c23.rpy:2918
translate french c23s006_AfterBreakfastBetConfession_835c8bda:

    # mc "Yo creo que sí. Le gustan las películas de fantasía."
    mc "Je le crois. Il aime les films fantastiques."

# game/scripts/c23/c23.rpy:2920
translate french c23s006_AfterBreakfastBetConfession_2c8220af:

    # emm "¡Claro que lo he pillado! Es de El Señor de los Pendientes. No es tan buena como La Novia Princesa, pero no está mal."
    emm "Bien sûr que je l'ai ! C'est tiré du Seigneur des boucles d'oreilles. Ce n'est pas aussi bien que Princess Bride, mais ce n'est pas mal non plus."

# game/scripts/c23/c23.rpy:2921
translate french c23s006_AfterBreakfastBetConfession_e116c8b7:

    # emm "Y me estoy meando."
    emm "Et je vais faire pipi."

# game/scripts/c23/c23.rpy:2922
translate french c23s006_AfterBreakfastBetConfession_4bdcfd18:

    # mc "*Risa* En cinco minutos pasaremos por King City. Hay varios sitios para comer allí."
    mc "*Rires* Nous traverserons King City dans cinq minutes. Il y a plusieurs restaurants là-bas."

# game/scripts/c23/c23.rpy:2925
translate french c23s006_AfterBreakfastBetConfession_456d7e0d:

    # "Paráis a desayunar de nuevo en King City. [emm] apenas llega al lavabo."
    "Vous vous arrêtez à nouveau pour prendre le petit-déjeuner à King City. [emm] Il parvient à peine à atteindre les toilettes."

# game/scripts/c23/c23.rpy:2926
translate french c23s006_AfterBreakfastBetConfession_7777aded:

    # "La única que pide un desayuno completo es [bet]. Ni siquiera la preocupación por la reunión le quita el hambre."
    "La seule à demander un petit-déjeuner complet est [bet]. Même le fait de ne pas s'inquiéter de la réunion ne lui fait pas perdre la faim."

# game/scripts/c23/c23.rpy:2933
translate french c23s006_Rent_0c456281:

    # "Finalmente llegáis a la agencia de alquiler de coches..."
    "Vous arrivez enfin à l'agence de location de voitures..."

# game/scripts/c23/c23.rpy:2935
translate french c23s006_Rent_665081d0:

    # emm "¡Es precioso! ¡Pink Dreams! ¡Es un sueño hecho realidad!"
    emm "C'est magnifique ! Des rêves roses ! C'est un rêve devenu réalité !"

# game/scripts/c23/c23.rpy:2936
translate french c23s006_Rent_2000b3ce:

    # mc "Vamos antes de que me empiecen a sangrar los ojos con tanto rosa."
    mc "Allons-y avant que mes yeux ne se mettent à saigner à cause de tout ce rose."

# game/scripts/c23/c23.rpy:2937
translate french c23s006_Rent_adfcaa2c:

    # emm "¡Qué poco gusto!"
    emm "Quel mauvais goût !"

# game/scripts/c23/c23.rpy:2939
translate french c23s006_Rent_48260182:

    # "Amber" "Hola, buenos días, soy Amber. ¿En qué puedo ayudarles?"
    "Amber" "Bonjour, je m'appelle Amber. Comment puis-je vous aider ?"

# game/scripts/c23/c23.rpy:2940
translate french c23s006_Rent_6f08a874:

    # mc "Teníamos una reserva para un Ferrarini rosa. A nombre de [mc] Marks."
    mc "Nous avions réservé une Ferrarini rose. Au nom de Marks."

# game/scripts/c23/c23.rpy:2941
translate french c23s006_Rent_91e507dd:

    # mcp "(¡Qué forma de destrozar esos coches pintándolos de rosa!)"
    mcp "(Quelle façon de gâcher ces voitures en les peignant en rose !)"

# game/scripts/c23/c23.rpy:2943
translate french c23s006_Rent_c455070a:

    # "Amber mira directamente a [bet]."
    "Amber regarde directement [bet]."

# game/scripts/c23/c23.rpy:2944
translate french c23s006_Rent_a2e96bfc:

    # "Amber" "He mirado el expediente y he visto que también ha contratado las clases de conducción segura para deportivos con nuestro instructor Chad."
    "Amber" "J'ai consulté son dossier et j'ai vu qu'il avait également réservé des leçons de conduite sécuritaire pour voitures de sport avec notre moniteur Chad."

# game/scripts/c23/c23.rpy:2945
translate french c23s006_Rent_9c578732:

    # "Amber" "En breve estará aquí. Justo a tiempo para que, cuando acabemos el papeleo, la pueda llevar a comer. La comida está incluida en el curso."
    "Amber" "Elle arrive bientôt. Juste à temps pour que, une fois les formalités administratives réglées, je puisse l'emmener déjeuner. Le déjeuner est inclus dans les frais de cours."

# game/scripts/c23/c23.rpy:2947
translate french c23s006_Rent_75933c3b:

    # emm "¿Unas clases de conducción de deportivos? ¿Esa era la sorpresa? ¡Eres el mejor hermano del mundo!"
    emm "Des cours de conduite de voitures de sport ? C'était ça la surprise ? Tu es le meilleur frère du monde !"

# game/scripts/c23/c23.rpy:2948
translate french c23s006_Rent_fb5e1891:

    # mc "Conducción {b}segura{/b} de deportivos."
    mc "Conduite sûre des voitures de sport."

# game/scripts/c23/c23.rpy:2950
translate french c23s006_Rent_92805b84:

    # "Amber mira alternativamente a [emm] y a [bet] como si no entendiera nada."
    "Amber regarde alternativement [emm] et [bet] comme si elle ne comprenait rien."

# game/scripts/c23/c23.rpy:2951
translate french c23s006_Rent_8755467d:

    # "Amber" "Perdón por la confusión. Esas clases las suelen contratar señoras... más maduras. Muchas de ellas repiten el curso."
    "Amber" "Veuillez m'excuser pour la confusion. Ces cours sont généralement suivis par des femmes plus âgées. Nombre d'entre elles suivent d'ailleurs la même formation une deuxième fois."

# game/scripts/c23/c23.rpy:2952
translate french c23s006_Rent_faabfd68:

    # mc "En este caso, las lecciones son un regalo para mi hermana."
    mc "Dans ce cas précis, les cours sont un cadeau pour ma sœur."

# game/scripts/c23/c23.rpy:2954
translate french c23s006_Rent_e818b96a:

    # emm "No veo el Ferrarini aquí. ¿Dónde está? ¿Qué modelo es? ¿Podemos ir a verlo?"
    emm "Je ne vois pas la Ferrarini ici. Où est-elle ? De quel modèle s'agit-il ? Peut-on aller la voir ?"

# game/scripts/c23/c23.rpy:2955
translate french c23s006_Rent_d8ef348f:

    # mc "Veo que estás impaciente."
    mc "Je vois que vous êtes impatient."

# game/scripts/c23/c23.rpy:2957
translate french c23s006_Rent_6805dc70:

    # "Amber" "Sí, podemos ir a verlo antes de hacer el papeleo. Sígame por aquí."
    "Amber" "Oui, nous pouvons aller le voir avant de remplir les papiers. Suivez-moi ici."

# game/scripts/c23/c23.rpy:2958
translate french c23s006_Rent_b26d677c:

    # "Amber" "Es nuestro modelo más valioso y lo tenemos apartado del resto."
    "Amber" "C'est notre modèle le plus précieux et nous le conservons à part des autres."

# game/scripts/c23/c23.rpy:2960
translate french c23s006_Rent_26fcca02:

    # "Amber abre una puerta con un mando a distancia y allí está el peor atentado contra el buen gusto de la historia de la automoción."
    "Amber ouvre une portière avec une télécommande et là, c'est le pire affront au bon goût de toute l'histoire de l'automobile."

# game/scripts/c23/c23.rpy:2962
translate french c23s006_Rent_023fcdde:

    # emm "¡Oh! ¡Es el Ferrarini F69 de 2018! ¡Tiene 660 CV y puede llegar a 355 Km/h! ¡Me encanta este coche!"
    emm "Oh ! C'est la Ferrari F69 de 2018 ! Elle développe 660 chevaux et peut atteindre 355 km/h ! J'adore cette voiture !"

# game/scripts/c23/c23.rpy:2964
translate french c23s006_Rent_d882cbb8:

    # emm "Pero este no se comercializó en ese color... Solo en rojo o en negro."
    emm "Mais celui-ci n'était pas vendu dans cette couleur... Seulement en rouge ou en noir."

# game/scripts/c23/c23.rpy:2966
translate french c23s006_Rent_e89101dd:

    # "Amber" "Todos nuestros coches son pintados localmente para que proporcionen una experiencia más exclusiva."
    "Amber" "Toutes nos voitures sont peintes localement afin de vous offrir une expérience plus exclusive."

# game/scripts/c23/c23.rpy:2967
translate french c23s006_Rent_df9a0882:

    # "Amber" "Tenemos tres tonos de rosa dependiendo del tipo de coche."
    "Amber" "Nous proposons trois nuances de rose selon le type de voiture."

# game/scripts/c23/c23.rpy:2969
translate french c23s006_Rent_f4a0d06c:

    # emm "¡Han hecho un trabajo exquisito! ¡Sácame una foto con el logo, [mc]!"
    emm "Ils ont fait un travail formidable ! Prends-moi en photo avec le logo, [mc] !"

# game/scripts/c23/c23.rpy:2971
translate french c23s006_Rent_9ff5d38a:

    # emm "Que salga bien el Jaballino. Da lo mismo que no me encuadres bien a mí."
    emm "J'espère que le sanglier sera réussi. Ce n'est pas grave si vous ne me cadrez pas correctement."

# game/scripts/c23/c23.rpy:2972
translate french c23s006_Rent_2a0cfc61:

    # emm "Sí, ya sé que es Cinghialetto. Pero me gusta más como lo digo yo. Más fotos."
    emm "Oui, je sais que c'est Cinghialetto. Mais je préfère le prononcer comme ça. Plus de photos."

# game/scripts/c23/c23.rpy:2973
translate french c23s006_Rent_a2af1c25:

    # mc "Creo que sería mejor fuera que en un garaje."
    mc "Je pense que ce serait mieux dehors que dans un garage."

# game/scripts/c23/c23.rpy:2974
translate french c23s006_Rent_34c9d6a6:

    # emm "¡Ya habrá tiempo para eso! ¡Hazme un par de fotos ahora!"
    emm "On aura le temps pour ça plus tard ! Prends quelques photos de moi maintenant !"

# game/scripts/c23/c23.rpy:2976
translate french c23s006_Rent_f8177bba:

    # "Tomas varias fotos de [emm] posando con el coche. Apenas se atreve a tocarlo."
    "Vous prenez plusieurs photos de [emm] posant avec la voiture. Elle ose à peine la toucher."

# game/scripts/c23/c23.rpy:2978
translate french c23s006_Rent_d7fbe99b:

    # "Amber" "Miren, por allí llega nuestro instructor Chad. Se ha adelantado."
    "Amber" "Regardez, voilà notre instructeur Chad. Il est parti devant."

# game/scripts/c23/c23.rpy:2979
translate french c23s006_Rent_229f631e:

    # "Amber" "Buenos días, Chad."
    "Amber" "Bonjour Chad."

# game/scripts/c23/c23.rpy:2981
translate french c23s006_Rent_f5ba0928:

    # "Puedes entender por qué las señoras maduras contratan el curso de conducción."
    "On comprend aisément pourquoi des femmes d'un certain âge s'inscrivent à des cours de conduite."

# game/scripts/c23/c23.rpy:2982
translate french c23s006_Rent_b2741f27:

    # "Chad se dirige directamente a [bet]."
    "Chad se dirige directement vers [bet]."

# game/scripts/c23/c23.rpy:2983
translate french c23s006_Rent_db84fff6:

    # "Chad" "Buenos días, señora. ¿Preparada para la mejor experiencia automovilística de su vida con Chad?"
    "Chad" "Bonjour madame. Prête à vivre la meilleure expérience automobile de votre vie avec Chad ?"

# game/scripts/c23/c23.rpy:2985
translate french c23s006_Rent_aff2351e:

    # bet "*Risa* Creo que te equivocas, Chad."
    bet "*Rires* Je crois que tu te trompes, Chad."

# game/scripts/c23/c23.rpy:2987
translate french c23s006_Rent_9409452e:

    # bet "Amber, ¿me puedes decir dónde está el lavabo? Voy a ir a cambiarme mientras le presenta a Chad a su clienta."
    bet "Amber, peux-tu me dire où sont les toilettes ? Je vais me changer pendant qu'elle présente Chad à son client."

# game/scripts/c23/c23.rpy:2989
translate french c23s006_Rent_479bdf44:

    # "Unos minutos después, una vez acabadas las presentaciones y el papeleo..."
    "Quelques minutes plus tard, une fois les présentations et les formalités administratives terminées..."

# game/scripts/c23/c23.rpy:2990
translate french c23s006_Rent_c060a39f:

    # emm "Entonces nos vemos aquí en tres horas, ¿no?"
    emm "On se retrouve ici dans trois heures, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:2991
translate french c23s006_Rent_41170b53:

    # mc "Bueno, la reunión es en una hora y media. No sé cuánto durará."
    mc "La réunion a lieu dans une heure et demie. Je ne sais pas combien de temps elle durera."

# game/scripts/c23/c23.rpy:2992
translate french c23s006_Rent_847e04d9:

    # mc "El curso de conducción segura acaba en tres horas, con lo que seguramente nosotros acabaremos antes."
    mc "Le cours de conduite sécuritaire se termine dans trois heures, donc nous aurons probablement fini avant."

# game/scripts/c23/c23.rpy:2994
translate french c23s006_Rent_2a10c184:

    # emm "Conducción segura {b}de deportivos{/b}. *Risa*"
    emm "Conduite sûre des voitures de sport. *Rires*"

# game/scripts/c23/c23.rpy:2995
translate french c23s006_Rent_a0fc9c2e:

    # mc "Sí, vale. Te he mandado la dirección del motel en el que nos alojaremos, por si nos retrasamos y quieres ir a descansar."
    mc "Oui, d'accord. Je t'ai envoyé l'adresse du motel où nous logerons, au cas où nous aurions du retard et que tu veuilles aller te reposer."

# game/scripts/c23/c23.rpy:2996
translate french c23s006_Rent_a0644686:

    # mc "En cuanto acabemos te llamo y quedamos en algún sitio."
    mc "Dès que nous aurons terminé, je t'appellerai et nous nous retrouverons quelque part."

# game/scripts/c23/c23.rpy:2997
translate french c23s006_Rent_339f1f96:

    # emm "Perfecto."
    emm "Parfait."

# game/scripts/c23/c23.rpy:3000
translate french c23s006_Rent_bd67ed74:

    # emm "*Susurrando* Te daría un beso, pero seguro que Amber se escandaliza después de decirle que eras mi hermano."
    emm "*Chuchotant* Je t'embrasserais bien, mais je suis sûre qu'Amber serait scandalisée si je lui disais que tu étais mon frère."

# game/scripts/c23/c23.rpy:3001
translate french c23s006_Rent_6b4f6085:

    # mc "*Susurrando* No creo que se escandalice demasiado, teniendo en cuenta las señoras maduras que contratan a Chad. *Risa*"
    mc "*À voix basse* Je ne pense pas qu'elle sera trop surprise, vu le genre de femmes mûres qui font appel à Chad. *Rires*"

# game/scripts/c23/c23.rpy:3003
translate french c23s006_Rent_33a146cb:

    # emm "*Susurrando* Creo que el curso para señoras maduras con Chad debe incluir alguna cosa más que conducir, viendo su aspecto."
    emm "*À voix basse* Je pense que le cours de Chad pour femmes mûres doit comprendre plus que de la simple conduite, à en juger par son apparence."

# game/scripts/c23/c23.rpy:3004
translate french c23s006_Rent_74a6046c:

    # mc "*Susurrando* Estoy seguro de ello."
    mc "*Chuchotant* J'en suis sûr."

# game/scripts/c23/c23.rpy:3006
translate french c23s006_Rent_9fdb4cfa:

    # emm "*Susurrando* Pues que no espere nada conmigo. No es para nada mi tipo."
    emm "*Chuchotant* Eh bien, elle ne devrait rien attendre de moi. Elle n'est pas du tout mon genre."

# game/scripts/c23/c23.rpy:3008
translate french c23s006_Rent_aa8ef0d9:

    # emm "*Susurrando* Me gustan más como tú."
    emm "*Chuchotant* Je les préfère comme toi."

# game/scripts/c23/c23.rpy:3009
translate french c23s006_Rent_a2cc8b2a:

    # mc "*Risa* Te veo luego. [bet] ya está saliendo del lavabo."
    mc "*Rires* À plus tard. [bet] Elle sort déjà de la salle de bain."

# game/scripts/c23/c23.rpy:3011
translate french c23s006_Rent_e7b71ffd:

    # bet "Disfruta del coche y no dejes que Chad haga nada que no debe, [emm]."
    bet "Profite de la voiture et ne laisse pas Chad faire quoi que ce soit qu'il ne devrait pas, [emm]."

# game/scripts/c23/c23.rpy:3012
translate french c23s006_Rent_a312c07f:

    # mc "*Risa* Precisamente estábamos hablando de eso."
    mc "*Rires* On en parlait justement."

# game/scripts/c23/c23.rpy:3014
translate french c23s006_Rent_3a64c416:

    # bet "¿Nos vamos, entonces?"
    bet "On y va, alors ?"

# game/scripts/c23/c23.rpy:3015
translate french c23s006_Rent_ded19230:

    # mcp "(Claramente no tiene ganas de ir a esa reunión. Yo tampoco las tendría.)"
    mcp "(De toute évidence, elle ne souhaite pas assister à cette réunion. Moi non plus.)"

# game/scripts/c23/c23.rpy:3016
translate french c23s006_Rent_8fbff358:

    # mc "Sí, vámonos."
    mc "Oui, allons-y."

# game/scripts/c23/c23.rpy:3018
translate french c23s006_Rent_53d871ed:

    # emm "Suerte, Tía [bet]."
    emm "Bonne chance, tante [bet]."

# game/scripts/c23/c23.rpy:3019
translate french c23s006_Rent_6a4fac72:

    # mcp "(A veces [emm] es sorprendentemente maravillosa.)"
    mcp "(Parfois, [emm] est étonnamment merveilleux.)"

# game/scripts/c23/c23.rpy:3021
translate french c23s006_Rent_303d6258:

    # bet "Gracias, cielo."
    bet "Merci, chérie."

# game/scripts/c23/c23.rpy:3026
translate french c23s006_RideBetChurch_f874252a:

    # "Después de una comida en la que intentas levantarle los ánimos sin éxito, llevas a [bet] a la catedral de Monterey."
    "Après un repas au cours duquel vous essayez sans succès de le réconforter, vous emmenez [bet] à la cathédrale de Monterey."

# game/scripts/c23/c23.rpy:3027
translate french c23s006_RideBetChurch_7b15b09b:

    # "La reunión tendrá lugar en un edificio cercano a la catedral."
    "La réunion aura lieu dans un bâtiment situé près de la cathédrale."

# game/scripts/c23/c23.rpy:3028
translate french c23s006_RideBetChurch_b5b10e17:

    # bet "Aquí estamos..."
    bet "Nous y voilà..."

# game/scripts/c23/c23.rpy:3029
translate french c23s006_RideBetChurch_dd568640:

    # mc "No tienes ganas de entrar, ¿verdad?"
    mc "Tu n'as pas envie d'y aller, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3031
translate french c23s006_RideBetChurch_2beddb44:

    # bet "Ahora mismo me apetecería más pegarme un martillazo en el pie que entrar ahí."
    bet "À l'heure actuelle, je préférerais me frapper le pied avec un marteau plutôt que d'y aller."

# game/scripts/c23/c23.rpy:3032
translate french c23s006_RideBetChurch_cdb4a5bb:

    # mc "Te entiendo. Pero ¿sabes qué me decía [nor] cuando no quería hacer algo de niño?"
    mc "Je comprends. Mais sais-tu ce que [nor] me disait quand je ne voulais pas faire quelque chose d'enfantin ?"

# game/scripts/c23/c23.rpy:3034
translate french c23s006_RideBetChurch_46d10b95:

    # bet "Que cuanto antes lo hicieras, antes podrías dedicarte a otras cosas que te gustan más."
    bet "Plus tôt vous le ferez, plus tôt vous pourrez vous consacrer à d'autres choses que vous aimez davantage."

# game/scripts/c23/c23.rpy:3035
translate french c23s006_RideBetChurch_9ef0b9a7:

    # mc "Veo que la frase tiene raíces profundas en la familia. Son exactamente las mismas palabras."
    mc "Je vois que cette expression est profondément ancrée dans la famille. Ce sont exactement les mêmes mots."

# game/scripts/c23/c23.rpy:3037
translate french c23s006_RideBetChurch_86fa3e95:

    # bet "*Risa triste* Es una frase que nos decía mi abuela cuando íbamos a visitarla a Missouri."
    bet "*Rire triste* C'est une phrase que ma grand-mère nous disait souvent quand nous allions lui rendre visite dans le Missouri."

# game/scripts/c23/c23.rpy:3039
translate french c23s006_RideBetChurch_791a2692:

    # bet "Tu bisabuela se la decía a [nor] y a [mar]. Es una frase que suelen decir las abuelas de la familia."
    bet "Votre arrière-grand-mère avait l'habitude de le dire à [nor] et [mar]. C'est une expression que les grands-mères de la famille utilisent souvent."

# game/scripts/c23/c23.rpy:3041
translate french c23s006_RideBetChurch_78a73330:

    # bet "Mi madre se la decía a [nor]. Es una frase que suelen decir las abuelas de la familia."
    bet "Ma mère avait l'habitude de le dire à [nor]. C'est une expression que les grands-mères de la famille utilisent souvent."

# game/scripts/c23/c23.rpy:3042
translate french c23s006_RideBetChurch_5435b956:

    # mc "Y ahora invertimos el proceso y te la digo yo, igual que [nor] me la dijo a mí."
    mc "Et maintenant, nous inversons le processus et je vais vous le dire, tout comme [nor] me l'a dit."

# game/scripts/c23/c23.rpy:3043
translate french c23s006_RideBetChurch_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Voulez-vous que je vous accompagne ?"

# game/scripts/c23/c23.rpy:3045
translate french c23s006_RideBetChurch_83e3f56b:

    # bet "Gracias, pero será mejor que entre sola. De todas formas, a la reunión no puedes asistir."
    bet "Merci, mais il serait préférable qu'elle y aille seule. De toute façon, vous ne pouvez pas assister à la réunion."

# game/scripts/c23/c23.rpy:3046
translate french c23s006_RideBetChurch_b6b048eb:

    # mc "Entonces iré al motel a dejar las maletas y vuelvo a buscarte. He visto un café en el que puedo esperarte."
    mc "Ensuite, j'irai au motel déposer mes bagages et je reviendrai te chercher. J'ai repéré un café où je pourrai t'attendre."

# game/scripts/c23/c23.rpy:3047
translate french c23s006_RideBetChurch_ef862ae9:

    # mc "Llámame cuando salgas y vengo en dos minutos."
    mc "Appelle-moi quand tu partiras et je serai là dans deux minutes."

# game/scripts/c23/c23.rpy:3049
translate french c23s006_RideBetChurch_854f9db8:

    # bet "Me parece perfecto. No sé cuánto voy a tardar y no quiero que te quedes en el coche todo este rato."
    bet "Ça me paraît parfait. Je ne sais pas combien de temps je vais rester, et je ne veux pas que tu restes dans la voiture tout ce temps."

# game/scripts/c23/c23.rpy:3050
translate french c23s006_RideBetChurch_5155cd4f:

    # mc "¿Quieres un abrazo antes de ir?"
    mc "Tu veux un câlin avant de partir ?"

# game/scripts/c23/c23.rpy:3052
translate french c23s006_RideBetChurch_7dc9295c:

    # bet "Me encantaría, pero mejor no. *Risa triste* Si me abrazas ahora no voy a querer ir."
    bet "J'adorerais, mais peut-être pas. *Rire triste* Si tu me prends dans tes bras maintenant, je n'aurai plus envie de partir."

# game/scripts/c23/c23.rpy:3053
translate french c23s006_RideBetChurch_6bc1a3fa:

    # mc "Entonces sin abrazos."
    mc "Donc pas de câlins."

# game/scripts/c23/c23.rpy:3054
translate french c23s006_RideBetChurch_7a2874a6:

    # mc "Suerte, Tía [bet]."
    mc "Bonne chance, tante [bet]."

# game/scripts/c23/c23.rpy:3056
translate french c23s006_RideBetChurch_303d6258:

    # bet "Gracias, cielo."
    bet "Merci, chérie."

# game/scripts/c23/c23.rpy:3058
translate french c23s006_RideBetChurch_59dfcd2a:

    # "Puedes ver como Tía [bet] se dirige al edificio de oficinas de la diócesis con los hombros hundidos, como un fantasma azul."
    "On peut voir tante [bet] se diriger vers le bâtiment administratif du diocèse, les épaules affaissées, comme un fantôme bleu."

# game/scripts/c23/c23.rpy:3059
translate french c23s006_RideBetChurch_9d3303d5:

    # "La batalla que tenga que librar ahí dentro está perdida antes de empezar."
    "La bataille qu'il doit mener là-bas est perdue d'avance."

# game/scripts/c23/c23.rpy:3061
translate french c23s006_RideBetChurch_1635f2b6:

    # "Vas al motel a dejar las maletas de [bet] y [emm] en una habitación y tu mochila en otra."
    "Vous allez au motel pour laisser les valises de [bet] et [emm] dans une chambre et votre sac à dos dans une autre."

# game/scripts/c23/c23.rpy:3062
translate french c23s006_RideBetChurch_ceec7348:

    # "[bet] ha dejado la ropa que llevaba puesta para el viaje en la camioneta. La dejas allí por si se quiere cambiar después."
    "Elle a laissé ses vêtements de voyage dans la camionnette. Vous les laissez là au cas où elle voudrait se changer plus tard."

# game/scripts/c23/c23.rpy:3063
translate french c23s006_RideBetChurch_76d4436f:

    # "Vuelves al barrio de la catedral y te tomas un café en una heladería a tres minutos del edificio donde [bet] está teniendo la reunión."
    "Vous retournez dans le quartier de la cathédrale et prenez un café dans un glacier à trois minutes du bâtiment où [bet] tient la réunion."

# game/scripts/c23/c23.rpy:3064
translate french c23s006_RideBetChurch_8b918e17:

    # "No disfrutas del café. Estás casi tan nervioso por el resultado como lo estaba [bet] al entrar."
    "Tu n'apprécies pas ton café. Tu es presque aussi anxieux que moi en entrant."

# game/scripts/c23/c23.rpy:3070
translate french c23s006_FerrariniGirl_df34c2a7:

    # "La reunión se alarga tanto que [emm] te llama para decirte que ya ha acabado el curso."
    "La réunion s'éternise tellement que [emm] vous appelle pour vous annoncer que le cours est terminé."

# game/scripts/c23/c23.rpy:3072
translate french c23s006_FerrariniGirl_185cb950:

    # emm "Hey, [mc]. ¿Aún no habéis acabado la reunión?"
    emm "Salut, [mc]. Tu n'as pas encore fini la réunion ?"

# game/scripts/c23/c23.rpy:3074
translate french c23s006_FerrariniGirl_41cb7534:

    # mc "No, estoy esperando a que Tía [bet] me llame para recogerla e ir a buscarte."
    mc "Non, j'attends que tante [bet] m'appelle pour que je puisse aller la chercher et venir te chercher."

# game/scripts/c23/c23.rpy:3076
translate french c23s006_FerrariniGirl_e6d88fd1:

    # emm "No te preocupes por mí. Ya he acabado el curso y voy a conducir un rato. ¡Este coche es increíble!"
    emm "Ne vous inquiétez pas pour moi. J'ai terminé ma formation et je vais conduire pendant un moment. Cette voiture est géniale !"

# game/scripts/c23/c23.rpy:3077
translate french c23s006_FerrariniGirl_b5b66e29:

    # mc "¿Qué tal el curso?"
    mc "Comment s'est déroulé le cours ?"

# game/scripts/c23/c23.rpy:3079
translate french c23s006_FerrariniGirl_67eda2dc:

    # emm "¡Genial! Aunque estoy casi segura de que Chad se saca un extra como gigoló con las maduras, realmente es un profesional."
    emm "Génial ! Même si je suis presque sûre que Chad arrondit ses fins de mois en tant que gigolo avec des femmes plus âgées, c'est vraiment un professionnel."

# game/scripts/c23/c23.rpy:3080
translate french c23s006_FerrariniGirl_80d5d336:

    # emm "Fue piloto de pruebas en un equipo de la WEC durante varios años."
    emm "Il a été pilote d'essai pour une équipe du WEC pendant plusieurs années."

# game/scripts/c23/c23.rpy:3081
translate french c23s006_FerrariniGirl_f4eba33d:

    # mc "¿WEC?"
    mc "WEC ?"

# game/scripts/c23/c23.rpy:3083
translate french c23s006_FerrariniGirl_4977e205:

    # emm "El World Endurance Championship, el mundial de resistencia... 24 horas de Le Mans y ese tipo de carreras."
    emm "Le Championnat du Monde d'Endurance, le championnat du monde d'endurance... les 24 Heures du Mans et ce type de courses."

# game/scripts/c23/c23.rpy:3085
translate french c23s006_FerrariniGirl_6c6bc686:

    # emm "A veces parece que el hombre en esta relación sea yo. No sabes nada de coches."
    emm "Parfois, j'ai l'impression d'être l'homme dans ce couple. Tu n'y connais rien en voitures."

# game/scripts/c23/c23.rpy:3087
translate french c23s006_FerrariniGirl_38254f85:

    # emm "A veces parece que yo sea el hermano y tú la hermana. No sabes nada de coches."
    emm "Parfois, j'ai l'impression que je suis le frère et toi la sœur. Tu n'y connais rien en voitures."

# game/scripts/c23/c23.rpy:3089
translate french c23s006_FerrariniGirl_49730f47:

    # emm "¡Pero alquilas unos coches de puta madre!"
    emm "Mais vous louez de sacrées bonnes voitures !"

# game/scripts/c23/c23.rpy:3090
translate french c23s006_FerrariniGirl_ac6e7f7f:

    # mc "Me alegra que lo estés disfrutando. Me hubiera gustado estar contigo y que lo disfrutáramos juntos."
    mc "Je suis content que ça te plaise. J'aurais adoré être avec toi et en profiter ensemble."

# game/scripts/c23/c23.rpy:3092
translate french c23s006_FerrariniGirl_ea46b0f5:

    # emm "A mí también me hubiera gustado, pero entiendo que no podemos dejar a Tía [bet] sola."
    emm "J'aurais bien aimé aussi, mais je comprends qu'on ne peut pas laisser tante [bet] seule."

# game/scripts/c23/c23.rpy:3093
translate french c23s006_FerrariniGirl_b635a88c:

    # mc "*Risa* Tu concepto de \"podemos\" es un poco especial. Yo estoy aquí y tú estás conduciendo un coche hortera."
    mc "*Rires* Ta conception du « on peut » est un peu particulière. Je suis là et toi, tu conduis une voiture ringarde."

# game/scripts/c23/c23.rpy:3095
translate french c23s006_FerrariniGirl_a9df7e34:

    # emm "*Risa* ¡Qué poco gusto tienes para los coches!"
    emm "*Rires* Tu as vraiment mauvais goût en matière de voitures !"

# game/scripts/c23/c23.rpy:3096
translate french c23s006_FerrariniGirl_fe44a410:

    # mc "Eso es discutible. *Risa* Si no se comercializaba en rosa, por algo será..."
    mc "C'est discutable. *Rires* S'il n'était pas vendu en rose, il doit y avoir une raison…"

# game/scripts/c23/c23.rpy:3097
translate french c23s006_FerrariniGirl_1f2f1237:

    # mc "Por cierto, sabes que si te ponen una multa de velocidad me tocará pagarla a mí, ¿verdad?"
    mc "Au fait, tu sais que si tu reçois une contravention pour excès de vitesse, je devrai la payer, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3099
translate french c23s006_FerrariniGirl_7304d0d2:

    # mc "Aunque sea un coche de alquiler, las multas llegan igualmente. Y te las pienso pasar a ti para que las pagues."
    mc "Même s'il s'agit d'une voiture de location, les amendes vous seront facturées. Je vais donc vous les refacturer afin que vous puissiez les régler."

# game/scripts/c23/c23.rpy:3102
translate french c23s006_FerrariniGirl_507c29bd:

    # emm "¡Oops! No lo sabía. Pero no te preocupes... no estoy corriendo... {b}demasiado{/b}."
    emm "Oups ! Je ne savais pas. Mais ne t'inquiète pas... je ne cours pas... beaucoup."

# game/scripts/c23/c23.rpy:3103
translate french c23s006_FerrariniGirl_6f48d758:

    # mc "*Risa* Ese \"demasiado\" me da mucho miedo."
    mc "*Rires* Ce « trop » me fait très peur."

# game/scripts/c23/c23.rpy:3105
translate french c23s006_FerrariniGirl_ff2af8d1:

    # emm "Una pregunta, ¿mi nombre está en algún sitio en el motel? Es decir... ¿puedo ir y pedir una llave de la habitación?"
    emm "Une question : mon nom est-il indiqué quelque part dans le motel ? Autrement dit… puis-je aller demander une clé de chambre ?"

# game/scripts/c23/c23.rpy:3106
translate french c23s006_FerrariniGirl_9188fde9:

    # mc "Sí, ya he avisado en la recepción que era posible que fueras y les pidieras una llave. Estás en la habitación número 6."
    mc "Oui, j'ai déjà prévenu la réception que vous pourriez avoir besoin d'aller leur demander une clé. Vous êtes dans la chambre numéro 6."

# game/scripts/c23/c23.rpy:3107
translate french c23s006_FerrariniGirl_9165b904:

    # mc "¿Por qué? ¿Estás cansada?"
    mc "Pourquoi ? Tu es fatigué(e) ?"

# game/scripts/c23/c23.rpy:3109
translate french c23s006_FerrariniGirl_bbed22e2:

    # emm "No, es que es posible que compre algunas cosas para las chicas y me gustaría dejarlas en la habitación en vez de llevarlas en el coche todo el día."
    emm "Non, c'est juste que je vais peut-être acheter des choses pour les filles et j'aimerais les laisser dans la chambre plutôt que de les transporter toute la journée en voiture."

# game/scripts/c23/c23.rpy:3110
translate french c23s006_FerrariniGirl_2dd5ec5c:

    # mc "¿Has visto algún souvenir? *Risa* Solo espero que no necesites comprar una cuarta maleta para llevar los regalos."
    mc "Avez-vous vu des souvenirs ? *Rires* J’espère juste que vous n’aurez pas besoin d’acheter une quatrième valise pour transporter les cadeaux."

# game/scripts/c23/c23.rpy:3112
translate french c23s006_FerrariniGirl_0a8e6cd1:

    # emm "Más o menos. *Risita* Te veo luego. Avísame cuando Tía [bet] acabe, a ver dónde estoy."
    emm "Plus ou moins. *Rires* À plus tard. Préviens-moi quand tante [bet] aura fini, pour que je sache où je suis."

# game/scripts/c23/c23.rpy:3113
translate french c23s006_FerrariniGirl_031b37f6:

    # mc "Si conduces demasiado, es posible que acabes en San Francisco... *Risa* con un montón de multas de velocidad."
    mc "Si vous conduisez trop, vous pourriez vous retrouver à San Francisco… *Rires* avec une montagne de contraventions pour excès de vitesse."

# game/scripts/c23/c23.rpy:3114
translate french c23s006_FerrariniGirl_9c47d0e7:

    # emm "No te preocupes. *Risa* No voy a llegar tan lejos. Hasta luego."
    emm "Ne t'inquiète pas. *Rires* Je ne vais pas jusque-là. À plus tard."

# game/scripts/c23/c23.rpy:3119
translate french c23s006_AfterTheMeeting_44117e4a:

    # "Media hora y dos cafés después, [bet] te avisa de que ya ha salido. Le propones ir a buscarla, pero cuando le dices dónde estás, decide unirse a ti en el café."
    "Une demi-heure et deux cafés plus tard, [bet] vous annonce qu'elle est déjà partie. Vous proposez d'aller la chercher, mais lorsque vous lui dites où vous êtes, elle décide de vous rejoindre au café."

# game/scripts/c23/c23.rpy:3120
translate french c23s006_AfterTheMeeting_7529841f:

    # "Avisas a [emm] de que [bet] ya está llegando y le mandas tu ubicación. Está en el motel y llegará en 15 minutos."
    "Vous prévenez [emm] que [bet] est en route et vous lui envoyez votre position. Il/Elle se trouve au motel et arrivera dans 15 minutes."

# game/scripts/c23/c23.rpy:3121
translate french c23s006_AfterTheMeeting_54937a4c:

    # "La monja llega cinco minutos después y se va inmediatamente a poner la ropa que llevaba durante el viaje mientras llega la chica del Ferrarini."
    "La religieuse arrive cinq minutes plus tard et va aussitôt enfiler les vêtements qu'elle portait pendant le voyage, tandis que la jeune fille des Ferrarini arrive."

# game/scripts/c23/c23.rpy:3122
translate french c23s006_AfterTheMeeting_2f523696:

    # "[bet] no quiere empezar a explicarte cómo ha ido la reunión para tener que volver a hacerlo cuando llegue [emm]."
    "[bet] ne veut pas commencer à expliquer comment s'est déroulée la réunion pour devoir le refaire lorsque [emm] arrivera."

# game/scripts/c23/c23.rpy:3124
translate french c23s006_AfterTheMeeting_89a31f19:

    # "Cuando estáis los tres por fin sentados a la mesa..."
    "Lorsque vous serez enfin tous les trois assis à table..."

# game/scripts/c23/c23.rpy:3126
translate french c23s006_AfterTheMeeting_76548f66:

    # emm "Me muero de impaciencia, Tía [bet]. ¿Qué te han dicho?"
    emm "Je meurs d'impatience, tante [bet]. Qu'est-ce qu'ils t'ont dit ?"

# game/scripts/c23/c23.rpy:3128
translate french c23s006_AfterTheMeeting_140ce337:

    # bet "El secretario me ha dicho que hice bien en negarme a operar a aquel muchacho."
    bet "La secrétaire m'a dit que j'avais bien fait de refuser d'opérer ce garçon."

# game/scripts/c23/c23.rpy:3129
translate french c23s006_AfterTheMeeting_1fd1471c:

    # mc "Eso es bueno, ¿no?"
    mc "C'est bien, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3130
translate french c23s006_AfterTheMeeting_fce9380f:

    # bet "Pero que hice mal en informar a su padre, el jefe tribal, de que el obispo Bakari le había engañado diciéndole que la homosexualidad se podía curar."
    bet "Mais j'ai eu tort d'informer son père, le chef de la tribu, que l'évêque Bakari l'avait trompé en affirmant que l'homosexualité pouvait être guérie."

# game/scripts/c23/c23.rpy:3131
translate french c23s006_AfterTheMeeting_96743008:

    # bet "El obispo es una figura muy importante en la iglesia de Tanzania y... ha pedido mi cabeza."
    bet "L'évêque est une figure très importante de l'Église en Tanzanie et... il a demandé ma tête."

# game/scripts/c23/c23.rpy:3133
translate french c23s006_AfterTheMeeting_63794710:

    # emm "¡Que hijo de puta! Supongo que se refiere a que no vuelvas a Tanzania, ¿no?"
    emm "Quel salaud ! J'imagine qu'il veut dire de ne pas retourner en Tanzanie, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3135
translate french c23s006_AfterTheMeeting_5d2c44a7:

    # bet "Ni a Tanzania ni a ningún otro lugar de África."
    bet "Ni en Tanzanie, ni dans aucun autre endroit d'Afrique."

# game/scripts/c23/c23.rpy:3136
translate french c23s006_AfterTheMeeting_34cb8151:

    # mc "Entonces solo te queda lo de trabajar en hospitales en California..."
    mc "Il ne vous reste donc plus qu'à travailler dans des hôpitaux en Californie..."

# game/scripts/c23/c23.rpy:3138
translate french c23s006_AfterTheMeeting_078df519:

    # bet "Eso tampoco."
    bet "Pas ça non plus."

# game/scripts/c23/c23.rpy:3139
translate french c23s006_AfterTheMeeting_ae35ad01:

    # bet "La iglesia me da dos opciones. Entrar en un convento de clausura en los Estados Unidos o jubilación en otro convento de mi elección en Latinoamérica."
    bet "L'Église me propose deux options : entrer dans un couvent cloîtré aux États-Unis ou me retirer dans un autre couvent de mon choix en Amérique latine."

# game/scripts/c23/c23.rpy:3141
translate french c23s006_AfterTheMeeting_86c23442:

    # emm "¿Por qué? No lo entiendo. ¿Tú lo entiendes?"
    emm "Pourquoi ? Je ne comprends pas. Vous comprenez ?"

# game/scripts/c23/c23.rpy:3142
translate french c23s006_AfterTheMeeting_2b63b98c:

    # mc "Si está aquí en un convento en el que pueda hablar con la prensa, podría liarla parda. Por eso aquí el convento es de clausura."
    mc "Si elle était ici, dans un couvent où elle pourrait parler à la presse, elle pourrait provoquer un véritable scandale. C'est pourquoi ce couvent est cloîtré."

# game/scripts/c23/c23.rpy:3143
translate french c23s006_AfterTheMeeting_0c2b8817:

    # mc "Si está jubilada en un convento en... yo qué sé... Nicaragua o Bolivia... La prensa de allí no le prestará atención."
    mc "Si elle est retirée dans un couvent au... je ne sais pas... au Nicaragua ou en Bolivie... la presse locale ne lui prêtera aucune attention."

# game/scripts/c23/c23.rpy:3144
translate french c23s006_AfterTheMeeting_f27c25a1:

    # mc "Y si habla con la prensa, la iglesia puede decir que la jubilaron con antelación porque ya no pensaba con claridad."
    mc "Et si elle parle à la presse, l'Église pourra dire qu'elle a été mise à la retraite anticipée parce qu'elle ne réfléchissait plus clairement."

# game/scripts/c23/c23.rpy:3146
translate french c23s006_AfterTheMeeting_1c2fa445:

    # mc "¿Me equivoco?"
    mc "Ai-je tort ?"

# game/scripts/c23/c23.rpy:3147
translate french c23s006_AfterTheMeeting_28a3741f:

    # bet "No lo ha dicho así, pero tienes razón sobre sus motivos."
    bet "Il ne l'a pas dit comme ça, mais vous avez raison concernant ses motivations."

# game/scripts/c23/c23.rpy:3148
translate french c23s006_AfterTheMeeting_e064dfa2:

    # bet "Sea como sea no volveré a ejercer en ningún hospital."
    bet "Quoi qu'il en soit, je ne travaillerai plus jamais dans un hôpital."

# game/scripts/c23/c23.rpy:3150
translate french c23s006_AfterTheMeeting_94f0859e:

    # emm "No volverás a ejercer si sigues siendo monja, ¿no?"
    emm "Vous ne pourrez plus exercer votre profession si vous restez religieuse, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3151
translate french c23s006_AfterTheMeeting_6e09d1d7:

    # emm "Podrías dejar la iglesia y seguir trabajando. Problema resuelto."
    emm "Vous pourriez quitter l'église et continuer à travailler. Problème résolu."

# game/scripts/c23/c23.rpy:3153
translate french c23s006_AfterTheMeeting_94c7a5e2:

    # bet "Me tendría que volver a certificar para poder ejercer de cirujana en los Estados Unidos."
    bet "Je devrais obtenir une nouvelle certification pour pouvoir exercer la profession de chirurgien aux États-Unis."

# game/scripts/c23/c23.rpy:3154
translate french c23s006_AfterTheMeeting_d0b6a0d2:

    # bet "Y eso vale dinero, no tengo ni idea de cuánto. En mi plan de trabajar en hospitales católicos, esa certificación la pagaba la iglesia..."
    bet "Et cela a un coût, je n'ai aucune idée du montant. Dans le cadre de mon projet de travailler dans des hôpitaux catholiques, l'Église devait prendre en charge cette certification..."

# game/scripts/c23/c23.rpy:3155
translate french c23s006_AfterTheMeeting_e6940cd5:

    # mc "Por el dinero no te preocupes."
    mc "Ne vous inquiétez pas pour l'argent."

# game/scripts/c23/c23.rpy:3157
translate french c23s006_AfterTheMeeting_050d8cb9:

    # emm "Tenemos una empresa millonaria. Podemos pagar tu certificación sin problemas."
    emm "Notre entreprise pèse plusieurs millions de dollars. Nous pouvons prendre en charge votre certification sans aucun problème."

# game/scripts/c23/c23.rpy:3158
translate french c23s006_AfterTheMeeting_0b57ea3e:

    # mc "Bueno, no con dinero de NTR. Sería un gasto injustificable."
    mc "Eh bien, pas avec l'argent de NTR. Ce serait une dépense injustifiable."

# game/scripts/c23/c23.rpy:3159
translate french c23s006_AfterTheMeeting_6009a7e8:

    # mc "Pero yo puedo pedir un adelanto de mi sueldo para pagar por tu certificación. Y dudo que el CEO de NTR lo rechace."
    mc "Mais je peux demander une avance sur salaire pour financer votre certification. Et je doute que le PDG de NTR refuse."

# game/scripts/c23/c23.rpy:3161
translate french c23s006_AfterTheMeeting_55389b78:

    # bet "No os puedo pedir eso..."
    bet "Je ne peux pas vous demander ça..."

# game/scripts/c23/c23.rpy:3162
translate french c23s006_AfterTheMeeting_99751757:

    # mc "No lo estás pidiendo. Lo estamos ofreciendo nosotros."
    mc "Vous ne le demandez pas, nous vous le proposons."

# game/scripts/c23/c23.rpy:3163
translate french c23s006_AfterTheMeeting_f0ef9c25:

    # mc "El sábado voy a actuar como CEO por primera vez, y pienso cobrar por ello. Ese dinero es tuyo para la certificación."
    mc "Samedi, j'assumerai pour la première fois le rôle de PDG et je compte bien être rémunéré pour cela. Cet argent vous est destiné en récompense de la certification."

# game/scripts/c23/c23.rpy:3165
translate french c23s006_AfterTheMeeting_82ed1e9d:

    # bet "..."
    bet "..."

# game/scripts/c23/c23.rpy:3166
translate french c23s006_AfterTheMeeting_f878632a:

    # mc "Tía [bet]... ¿Estás bien?"
    mc "Tante [bet]... Ça va ?"

# game/scripts/c23/c23.rpy:3168
translate french c23s006_AfterTheMeeting_b5b31101:

    # emm "¿Qué pasa, Tía?"
    emm "Qu'est-ce qui ne va pas, tante ?"

# game/scripts/c23/c23.rpy:3170
translate french c23s006_AfterTheMeeting_6423ffeb:

    # bet "No me merezco esta familia..."
    bet "Je ne mérite pas cette famille..."

# game/scripts/c23/c23.rpy:3171
translate french c23s006_AfterTheMeeting_3c3e34d0:

    # mc "Te mereces esto y más."
    mc "Tu mérites cela et bien plus encore."

# game/scripts/c23/c23.rpy:3173
translate french c23s006_AfterTheMeeting_0db44c4a:

    # emm "Estoy de acuerdo con [mc]. Todos querríamos ayudarte, y todo el mundo estaba muy preocupado por tu situación."
    emm "Je suis d'accord avec [mc]. Nous voulions tous vous aider, et nous étions tous très préoccupés par votre situation."

# game/scripts/c23/c23.rpy:3174
translate french c23s006_AfterTheMeeting_54b45c27:

    # emm "Si [mc] se negara a sí mismo el adelanto de sueldo, estoy segura de que entre todas conseguiríamos el dinero para tu certificación."
    emm "Si [mc] refusait son avance sur salaire, je suis sûr qu'ensemble nous pourrions réunir l'argent nécessaire à votre certification."

# game/scripts/c23/c23.rpy:3176
translate french c23s006_AfterTheMeeting_93f90172:

    # emm "Seguro que para alguien como [lis] y [deb.nick], lo que cuesta la certificación es calderilla, y dijeron que podíamos contar con ellas para lo que necesitáramos."
    emm "Je suis sûr que pour quelqu'un comme [lis] et [deb.nick], le coût de la certification est une broutille, et ils ont dit que nous pouvions compter sur eux pour tout ce dont nous aurions besoin."

# game/scripts/c23/c23.rpy:3177
translate french c23s006_AfterTheMeeting_e9157e62:

    # emm "Aunque no hablamos de dinero, claro, porque no sabíamos que eso podría ser el problema."
    emm "Bien sûr, nous n'avons pas parlé d'argent, car nous ne savions pas que cela pouvait être le problème."

# game/scripts/c23/c23.rpy:3179
translate french c23s006_AfterTheMeeting_55001268:

    # mc "Todo el mundo va a querer ayudarte. No te preocupes por eso."
    mc "Tout le monde voudra vous aider. Ne vous en faites pas."

# game/scripts/c23/c23.rpy:3180
translate french c23s006_AfterTheMeeting_761152f7:

    # bet "Pero..."
    bet "Mais..."

# game/scripts/c23/c23.rpy:3182
translate french c23s006_AfterTheMeeting_6819fc88:

    # emm "Y [dap] y [sca] te ayudarán a estudiar si es necesario... Hay que estudiar para la certificación, ¿no?"
    emm "Et [dap] et [sca] vous aideront à étudier si nécessaire... Vous devez étudier pour la certification, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:3183
translate french c23s006_AfterTheMeeting_f6ee4e4b:

    # emm "Yo también te ayudaría, pero no tengo ni idea de medicina."
    emm "Je vous aiderais bien aussi, mais je ne connais rien à la médecine."

# game/scripts/c23/c23.rpy:3185
translate french c23s006_AfterTheMeeting_597e2389:

    # bet "Chicos... me estáis emocionando..."
    bet "Les gars... vous me touchez..."

# game/scripts/c23/c23.rpy:3186
translate french c23s006_AfterTheMeeting_a7073025:

    # mc "La familia está para eso, Tía [bet]. No sólo para cuando todo va bien, sino para apoyarnos cuando hay algún problema."
    mc "C'est à ça que sert la famille, tante [bet]. Pas seulement quand tout va bien, mais aussi pour nous soutenir en cas de problème."

# game/scripts/c23/c23.rpy:3187
translate french c23s006_AfterTheMeeting_9da09452:

    # mc "¿Cuándo les tienes que dar una respuesta?"
    mc "Quand devez-vous leur donner une réponse ?"

# game/scripts/c23/c23.rpy:3189
translate french c23s006_AfterTheMeeting_cd37e247:

    # bet "Me han dado dos meses para pensármelo. Mañana tengo que pasar a recoger una documentación sobre los diferentes conventos que proponen."
    bet "Ils m'ont donné deux mois pour y réfléchir. Demain, je dois aller chercher des documents sur les différents couvents qu'ils me proposent."

# game/scripts/c23/c23.rpy:3190
translate french c23s006_AfterTheMeeting_21bc1964:

    # bet "Todo eso, obviamente, bajo la condición de que no hable con la prensa nunca."
    bet "Tout cela, évidemment, à condition que je ne parle jamais à la presse."

# game/scripts/c23/c23.rpy:3191
translate french c23s006_AfterTheMeeting_a57063ee:

    # mc "¿Qué te pueden hacer si hablas con la prensa?"
    mc "Que peuvent-ils vous faire si vous parlez à la presse ?"

# game/scripts/c23/c23.rpy:3193
translate french c23s006_AfterTheMeeting_79da8654:

    # bet "Podrían eliminar la opción del convento en Latinoamérica, que era la menos mala."
    bet "Ils pourraient éliminer l'option des couvents en Amérique latine, qui était la moins mauvaise."

# game/scripts/c23/c23.rpy:3194
translate french c23s006_AfterTheMeeting_c2fe0315:

    # bet "De todas formas, no pensaba hablar con la prensa. No serviría de nada. El obispo Bakari no se vería afectado."
    bet "De toute façon, je n'avais pas l'intention de parler à la presse. Cela n'aurait servi à rien. L'évêque Bakari n'en aurait pas souffert."

# game/scripts/c23/c23.rpy:3196
translate french c23s006_AfterTheMeeting_2dc9513a:

    # emm "Bueno, como no vas a hablar con la prensa ni vas a coger esa opción, no tenemos que hablar de eso ahora."
    emm "Bon, puisque vous n'allez pas parler à la presse ni choisir cette option, nous n'avons pas besoin d'en parler maintenant."

# game/scripts/c23/c23.rpy:3197
translate french c23s006_AfterTheMeeting_df7a30d6:

    # mc "Tienes razón, [emm]. Ahora hay dos meses para sopesar opciones y pensar en qué podemos hacer y cómo hacerlo."
    mc "Tu as raison, [emm]. Nous avons maintenant deux mois pour évaluer les options et réfléchir à ce que nous pouvons faire et comment le faire."

# game/scripts/c23/c23.rpy:3199
translate french c23s006_AfterTheMeeting_aa316288:

    # bet "No hay mucho que pensar. Si me prestáis el dinero..."
    bet "Il n'y a pas grand-chose à réfléchir. Si vous me prêtez l'argent..."

# game/scripts/c23/c23.rpy:3200
translate french c23s006_AfterTheMeeting_33e8120e:

    # mc "No es un préstamo, es un regalo."
    mc "Ce n'est pas un prêt, c'est un don."

# game/scripts/c23/c23.rpy:3202
translate french c23s006_AfterTheMeeting_ae5cced6:

    # bet "{b}Si me prestáis el dinero{/b} para certificarme, creo que mi mejor opción sería abandonar la iglesia..."
    bet "Si vous me prêtez l'argent pour obtenir ma certification, je pense que la meilleure solution serait de quitter l'église..."

# game/scripts/c23/c23.rpy:3203
translate french c23s006_AfterTheMeeting_8f7740d3:

    # bet "Y empezar a buscar trabajo como cirujana... a mi edad... Ufff..."
    bet "Et commencer à chercher un emploi de chirurgien... à mon âge... Pfff..."

# game/scripts/c23/c23.rpy:3204
translate french c23s006_AfterTheMeeting_b233d797:

    # mc "Bueno, si piensas que es la mejor opción no vamos a intentar convencerte de lo contrario. Tienes dos meses para pensártelo."
    mc "Si vous pensez que c'est la meilleure option, nous n'essaierons pas de vous convaincre du contraire. Vous avez deux mois pour y réfléchir."

# game/scripts/c23/c23.rpy:3206
translate french c23s006_AfterTheMeeting_c2e00819:

    # emm "Y para alegrarte un poco el día, hoy invito yo a pizza."
    emm "Et pour égayer un peu ta journée, aujourd'hui je t'offre une pizza."

# game/scripts/c23/c23.rpy:3207
translate french c23s006_AfterTheMeeting_462726fc:

    # emm "Por si estabas triste había buscado pizzerías con buenas reseñas."
    emm "Au cas où vous auriez le moral à zéro, j'ai cherché des pizzerias ayant de bonnes critiques."

# game/scripts/c23/c23.rpy:3208
translate french c23s006_AfterTheMeeting_c25289da:

    # mc "A veces eres sorprendente, [emm]. Cada vez más."
    mc "Parfois, tu es incroyable, [emm]. De plus en plus."

# game/scripts/c23/c23.rpy:3210
translate french c23s006_AfterTheMeeting_64416a28:

    # bet "¿Crees que me puedes comprar con comida, [emm]?"
    bet "Tu crois pouvoir me soudoyer avec de la nourriture, [emm] ?"

# game/scripts/c23/c23.rpy:3212
translate french c23s006_AfterTheMeeting_6010d2ad:

    # emm "No quería que sonara así, Tía... perdona..."
    emm "Je ne voulais pas que ça sonne comme ça, tante... Je suis désolée..."

# game/scripts/c23/c23.rpy:3214
translate french c23s006_AfterTheMeeting_40b9e80e:

    # bet "Porque si lo crees, tienes toda la razón. *Risa*"
    bet "Car si vous y croyez, vous avez absolument raison. *Rires*"

# game/scripts/c23/c23.rpy:3215
translate french c23s006_AfterTheMeeting_db62733e:

    # mc "*Risa* Vamos al motel a ducharnos y vamos a ver qué pizzería ha encontrado [emm]."
    mc "*Rires* Allons au motel prendre une douche et voir ce que la pizzeria [emm] a trouvé."

# game/scripts/c23/c23.rpy:3218
translate french c23s006_AfterTheMeeting_afab1693:

    # "Ver que se han abierto más opciones de las que había planteado la iglesia ayuda a mejorar los ánimos."
    "Constater que d'autres options que celles proposées par l'Église se sont ouvertes contribue à remonter le moral."

# game/scripts/c23/c23.rpy:3219
translate french c23s006_AfterTheMeeting_8401a92d:

    # "Vais al motel a ducharos y cambiaros de ropa. Te pones la camisa azul."
    "Vous allez au motel pour prendre une douche et vous changer. Vous enfilez la chemise bleue."

# game/scripts/c23/c23.rpy:3228
translate french c23s007_AmaCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c23/c23.rpy:3229
translate french c23s007_AmaCalls_26e5f8ba:

    # "Suena tu teléfono, es [ama]."
    "Votre téléphone sonne, c'est [ama]."

# game/scripts/c23/c23.rpy:3233
translate french c23s007_AmaCalls_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Salut, [ama]. Puis-je vous aider ?"

# game/scripts/c23/c23.rpy:3235
translate french c23s007_AmaCalls_921677e6:

    # ama "Sólo llamábamos para saber cómo había ido la reunión de Tía [bet]. No queremos molestarla a ella."
    ama "Nous appelions simplement pour savoir comment s'était passée la réunion de tante. Nous ne voulons pas la déranger."

# game/scripts/c23/c23.rpy:3236
translate french c23s007_AmaCalls_d1e46081:

    # eva "Hubiéramos llamado antes, pero no sabíamos a qué hora iba a terminar la reunión."
    eva "Nous aurions appelé plus tôt, mais nous ne savions pas à quelle heure la réunion allait se terminer."

# game/scripts/c23/c23.rpy:3237
translate french c23s007_AmaCalls_8279e80c:

    # mc "Bueno, ha ido como uno de los peores escenarios que habíamos pensado."
    mc "Eh bien, c'est devenu l'un des pires scénarios que nous avions imaginés."

# game/scripts/c23/c23.rpy:3238
translate french c23s007_AmaCalls_8e598236:

    # mc "La propuesta de la iglesia es que se retire a un convento."
    mc "L'Église propose qu'elle se retire dans un couvent."

# game/scripts/c23/c23.rpy:3240
translate french c23s007_AmaCalls_d1718586:

    # eva "¡Putos cabrones! ¿Necesitas que hagamos una visita a ese obispo para convencerle... sutilmente?"
    eva "Espèces d'enfoirés ! Vous voulez qu'on aille rendre visite à cet évêque pour le convaincre… subtilement ?"

# game/scripts/c23/c23.rpy:3241
translate french c23s007_AmaCalls_ba40ba01:

    # mc "No, [eva]. Tía [bet] tiene que darles una respuesta en dos meses, con lo que hay tiempo para pensar qué quiere hacer."
    mc "Non, [eva]. Tante [bet] doit leur donner une réponse dans deux mois, elle a donc le temps de réfléchir à ce qu'elle veut faire."

# game/scripts/c23/c23.rpy:3243
translate french c23s007_AmaCalls_99d6c0b8:

    # ama "Si quieres... podemos buscar cosas sobre ese obispo, o sobre el de Tanzania, para poder hacer más presión y que cambien de opinión."
    ama "Si vous voulez... nous pouvons enquêter sur cet évêque, ou celui de Tanzanie, afin de faire pression sur eux et de les amener à changer d'avis."

# game/scripts/c23/c23.rpy:3244
translate french c23s007_AmaCalls_b04b3be0:

    # mc "Creo que Tía [bet] no querría eso. Ahora mismo se siente como que no pertenece a la Iglesia. Se siente traicionada."
    mc "Je ne pense pas que tante [bet] le souhaiterait. Pour l'instant, elle a l'impression de ne plus avoir sa place dans l'Église. Elle se sent trahie."

# game/scripts/c23/c23.rpy:3245
translate french c23s007_AmaCalls_b86234e6:

    # mc "Por eso se tomará estos meses para sopesar dejar de ser monja. Casi lo ha decidido ya."
    mc "C'est pourquoi elle prend ces mois pour réfléchir à son départ du couvent. Elle a presque pris sa décision."

# game/scripts/c23/c23.rpy:3247
translate french c23s007_AmaCalls_2dbe68e6:

    # ama "Es lógico. La quieren esconder después de lo de Tanzania, y eso es cruel."
    ama "C'est logique. Ils veulent la cacher après ce qui s'est passé en Tanzanie, et c'est cruel."

# game/scripts/c23/c23.rpy:3248
translate french c23s007_AmaCalls_7cad4306:

    # mc "Por lo que me ha explicado, esa es exactamente su intención, que acabe sus días en un sitio donde no moleste."
    mc "D'après ce qu'il m'a expliqué, c'est précisément son intention : finir ses jours dans un endroit où il ne dérangera personne."

# game/scripts/c23/c23.rpy:3249
translate french c23s007_AmaCalls_5d374c27:

    # mc "Y donde no pueda hablar con la prensa."
    mc "Et là où je ne peux pas parler à la presse."

# game/scripts/c23/c23.rpy:3251
translate french c23s007_AmaCalls_5f6a0907:

    # eva "¡Putos cabrones! Necesito dispararle a algo. Dale un abrazo de mi parte a Tía [bet]."
    eva "Espèces d'enfoirés ! J'ai besoin de tirer sur quelque chose. Faites un gros câlin à tante [bet] de ma part."

# game/scripts/c23/c23.rpy:3252
translate french c23s007_AmaCalls_9fa74b4e:

    # mc "¡[eva]!"
    mc "[eva]!"

# game/scripts/c23/c23.rpy:3254
translate french c23s007_AmaCalls_7a9a2ae8:

    # ama "Ya se ha ido. Cuando se le desatan sentimientos que no puede controlar hace prácticas de tiro. Ya lo viste ayer."
    ama "Il est parti maintenant. Quand il ressent des émotions qu'il ne peut contrôler, il va s'entraîner au tir. Tu l'as vu hier."

# game/scripts/c23/c23.rpy:3255
translate french c23s007_AmaCalls_6991613d:

    # mc "Espero no enfadarla nunca..."
    mc "J'espère ne jamais la contrarier..."

# game/scripts/c23/c23.rpy:3258
translate french c23s007_AmaCalls_26a478e8:

    # ama "Hasta vuestra primera cita, como mínimo, estás seguro. *Risa*"
    ama "Au moins jusqu'à ton premier rendez-vous, tu es tranquille. *Rires*"

# game/scripts/c23/c23.rpy:3259
translate french c23s007_AmaCalls_60db5d70:

    # mc "Entonces tendremos la primera cita dentro de muchos años. *Risa*"
    mc "Ce sera donc notre premier rendez-vous depuis des années. *Rires*"

# game/scripts/c23/c23.rpy:3260
translate french c23s007_AmaCalls_a787076b:

    # ama "Si la retrasas mucho dejarás de estar seguro también. *Risa*"
    ama "Si vous tardez trop, vous finirez vous aussi par ne plus en être sûr. *Rires*"

# game/scripts/c23/c23.rpy:3262
translate french c23s007_AmaCalls_06c6a38d:

    # ama "Si no te disparó ayer después de rechazarla, supongo que puedes considerarte seguro."
    ama "Si elle ne t'a pas tiré dessus hier après que tu l'aies éconduite, je suppose que tu peux t'estimer en sécurité."

# game/scripts/c23/c23.rpy:3263
translate french c23s007_AmaCalls_826e85ca:

    # mc "¿Necesitas algo más? Iba a llevar a las chicas a cenar..."
    mc "Vous avez besoin de quelque chose d'autre ? Je comptais emmener les filles dîner..."

# game/scripts/c23/c23.rpy:3265
translate french c23s007_AmaCalls_4edac293:

    # ama "Solo una cosa más. Es una idea que se les ha ocurrido a Jamaal y a [nor], pero puede esperar si tienes prisa."
    ama "Juste une dernière chose. C'est une idée que Jamaal avait déjà [nor], mais ça peut attendre si vous êtes pressé."

# game/scripts/c23/c23.rpy:3266
translate french c23s007_AmaCalls_a9665a34:

    # mc "No, tranquila, [emm] aún se está acabando de vestir. Dime."
    mc "Non, ne t'inquiète pas, elle est encore en train de s'habiller. Dis-moi."

# game/scripts/c23/c23.rpy:3268
translate french c23s007_AmaCalls_7762f7d9:

    # ama "Jamaal y yo estábamos hablando de lo de los asistentes a la fiesta del barco de Iron Fist cuando ha aparecido [nor]."
    ama "Jamaal et moi parlions des participants à la fête sur le bateau d'Iron Fist lorsque [nor] est apparu."

# game/scripts/c23/c23.rpy:3269
translate french c23s007_AmaCalls_61d4ff67:

    # ama "[nor] es muy inteligente y ha estado pensando en que, si reconvertimos NTR en una empresa médica, el nombre puede ser un lastre."
    ama "[nor] est très intelligent et pense que, si nous rebaptisons NTR en société médicale, le nom pourrait être un handicap."

# game/scripts/c23/c23.rpy:3270
translate french c23s007_AmaCalls_e7d42cd0:

    # mc "*Risa* Ese nombre sería un lastre fuera como fuera."
    mc "*Rires* Ce nom serait un fardeau quoi qu'il arrive."

# game/scripts/c23/c23.rpy:3272
translate french c23s007_AmaCalls_187a4d9b:

    # ama "Algo parecido ha dicho Jamaal, pero no entiendo por qué."
    ama "Jamaal a dit quelque chose de similaire, mais je ne comprends pas pourquoi."

# game/scripts/c23/c23.rpy:3273
translate french c23s007_AmaCalls_02086512:

    # ama "[nor] lo decía porque NTR tiene un pasado militar y, en este país, puede ser un problema."
    ama "[nor] J'ai dit cela parce que NTR a un passé militaire et que, dans ce pays, cela peut être un problème."

# game/scripts/c23/c23.rpy:3274
translate french c23s007_AmaCalls_f594ed77:

    # mc "Tiene razón, pero no por el pasado militar, sino por las operaciones encubiertas. La gente desconfía de lo que se le oculta."
    mc "Il a raison, mais pas à cause de son passé militaire, plutôt à cause des opérations secrètes. Les gens se méfient de ce qui leur est caché."

# game/scripts/c23/c23.rpy:3275
translate french c23s007_AmaCalls_c2426e12:

    # mc "¿Ha propuesto cambiarle el nombre a la empresa?"
    mc "Avez-vous proposé de changer le nom de l'entreprise ?"

# game/scripts/c23/c23.rpy:3277
translate french c23s007_AmaCalls_06b509fe:

    # ama "Más que cambiarle el nombre, crear una empresa filial y traspasar toda la actividad médica allí. Al menos a nivel comercial."
    ama "Plutôt que de changer le nom, il serait préférable de créer une filiale et d'y transférer toute l'activité médicale. Du moins sur le plan commercial."

# game/scripts/c23/c23.rpy:3278
translate french c23s007_AmaCalls_ac8b2401:

    # mc "Me parece bien. Así NTR quedará para soporte a otras empresas de operaciones encubiertas y la nueva empresa se ocupará de todo el tema médico."
    mc "Cela me convient. Ainsi, NTR pourra apporter son soutien à d'autres sociétés d'opérations secrètes, et la nouvelle société se chargera de tous les aspects médicaux."

# game/scripts/c23/c23.rpy:3280
translate french c23s007_AmaCalls_a9164267:

    # ama "A Jamaal también le ha parecido una buena idea. Incluso se le ha ocurrido un nombre. Harnessing Advanced Research for Enhancing Medicine."
    ama "Jamaal pensait lui aussi que c'était une bonne idée. Il a même trouvé un nom : Exploiter la recherche de pointe pour améliorer la médecine."

# game/scripts/c23/c23.rpy:3281
translate french c23s007_AmaCalls_0a88ead0:

    # ama "Aprovechar la investigación avanzada para mejorar la medicina. Aunque me parece un poco largo"
    ama "Mettre à profit la recherche de pointe pour améliorer la médecine. Cela me semble un peu long, je trouve."

# game/scripts/c23/c23.rpy:3282
translate french c23s007_AmaCalls_72c20cb4:

    # mc "A mí me parece un buen nombre, podemos usar siglas como NTR..."
    mc "Je pense que c'est un bon nom ; on peut utiliser des acronymes comme NTR..."

# game/scripts/c23/c23.rpy:3283
translate french c23s007_AmaCalls_5367af7b:

    # mc "Espera..."
    mc "Attendez..."

# game/scripts/c23/c23.rpy:3284
translate french c23s007_AmaCalls_91f9fbdb:

    # mc "*Risa* Jamaal es un capullo."
    mc "*Rires* Jamaal est un crétin."

# game/scripts/c23/c23.rpy:3286
translate french c23s007_AmaCalls_5dc56569:

    # ama "¿Qué pasa?"
    ama "Ce qui se passe?"

# game/scripts/c23/c23.rpy:3287
translate french c23s007_AmaCalls_5ceedf9e:

    # mc "¿No te has dado cuenta de cuáles serían las siglas? H.A.R.E.M."
    mc "Vous n'avez pas encore compris ce que signifie cet acronyme ? HAREM"

# game/scripts/c23/c23.rpy:3289
translate french c23s007_AmaCalls_18aedd9b:

    # ama "¡Me ha tomado el pelo! *Risa* Voy a decirle a [eva] que practique tiro contra sus ruedas."
    ama "Il se moque de moi ! *Rires* Je vais dire à [eva] de s'entraîner à tirer sur ses propres pneus."

# game/scripts/c23/c23.rpy:3290
translate french c23s007_AmaCalls_2459552a:

    # mc "*Risa* Si Jamaal empieza a gastarte bromas, significa que está dejando de teneros miedo. Es su forma de daros la bienvenida a la familia."
    mc "*Rires* Si Jamaal commence à te taquiner, c'est qu'il n'a plus peur de toi. C'est sa façon de t'accueillir dans la famille."

# game/scripts/c23/c23.rpy:3291
translate french c23s007_AmaCalls_4dfc6171:

    # mc "*Risa* Pero sigue pareciéndome un buen nombre. Sigue la línea de NTR y GILF."
    mc "*Rires* Mais je trouve quand même que c'est un bon nom. Ça suit la tendance NTR et GILF."

# game/scripts/c23/c23.rpy:3293
translate french c23s007_AmaCalls_f5d9ea6d:

    # ama "Continúo sin entender qué tiene de malo NTR."
    ama "Je ne comprends toujours pas ce qu'il y a de mal avec le NTR."

# game/scripts/c23/c23.rpy:3294
translate french c23s007_AmaCalls_290dcc15:

    # mc "Mucho, [ama]. Mucho."
    mc "Beaucoup, [ama]. Beaucoup."

# game/scripts/c23/c23.rpy:3296
translate french c23s007_AmaCalls_f3cd91b4:

    # mc "Puedes preguntárselo a [deb.nick] cuando la veas. *Risa*"
    mc "Tu peux lui demander quand tu la verras. *Rires*"

# game/scripts/c23/c23.rpy:3299
translate french c23s007_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c23/c23.rpy:3300
translate french c23s007_AmaCalls_6aeda812:

    # emm "*A través de la puerta* [mc], ya estamos listas. Te esperamos en el coche."
    emm "*À travers la porte* [mc], nous sommes prêts. Nous vous attendrons dans la voiture."

# game/scripts/c23/c23.rpy:3301
translate french c23s007_AmaCalls_c02ac796:

    # mc "Ahora voy. Un segundo."
    mc "J'arrive. Une seconde."

# game/scripts/c23/c23.rpy:3303
translate french c23s007_AmaCalls_7bd50a56:

    # ama "Ve antes de que [emm] se impaciente. *Risa* No sé si ese hotel tiene tienda de regalos, pero podría empezar a comprar cosas rosas."
    ama "Vas-y avant que [emm] ne s'impatiente. *Rires* Je ne sais pas si cet hôtel a une boutique de souvenirs, mais je pourrais commencer à acheter des trucs roses."

# game/scripts/c23/c23.rpy:3304
translate french c23s007_AmaCalls_a54e5e50:

    # mc "*Risa* No te preocupes, no hay tienda de regalos."
    mc "*Rires* Ne vous inquiétez pas, il n'y a pas de boutique de souvenirs."

# game/scripts/c23/c23.rpy:3305
translate french c23s007_AmaCalls_cdc39172:

    # mc "Os mantengo informadas de cómo va lo de Tía [bet] mañana."
    mc "Je vous tiendrai au courant demain de la situation avec tante [bet]."

# game/scripts/c23/c23.rpy:3307
translate french c23s007_AmaCalls_a6bb3df2:

    # mc "Y has dicho que estaré seguro hasta la primera cita con [eva]. Tú y yo tenemos que planificar la nuestra también."
    mc "Et tu as dit que je serais en sécurité jusqu'à mon premier rendez-vous avec [eva]. Nous devons aussi planifier le nôtre."

# game/scripts/c23/c23.rpy:3309
translate french c23s007_AmaCalls_ac110be9:

    # mc "Y tú y yo tenemos una cita que planificar."
    mc "Et nous avons un rendez-vous à organiser, toi et moi."

# game/scripts/c23/c23.rpy:3312
translate french c23s007_AmaCalls_13fd4da7:

    # ama "No te preocupes por eso. El otro día en el café cuenta como nuestra primera cita. Hubo besos. Suficiente para mí, al menos por ahora."
    ama "Ne t'en fais pas. Notre rendez-vous de l'autre jour au café compte comme notre premier rendez-vous. On s'est embrassés. Ça me suffit, du moins pour l'instant."

# game/scripts/c23/c23.rpy:3313
translate french c23s007_AmaCalls_1c86b48c:

    # ama "Y vete antes de que Tía [bet] empiece a tener hambre. *Risa* Hasta mañana, [mc]."
    ama "Et pars avant que tante [bet] n'ait faim. *Rires* À demain, [mc]."

# game/scripts/c23/c23.rpy:3314
translate french c23s007_AmaCalls_69ad4751:

    # mc "Hablamos mañana, [ama]."
    mc "On se reparle demain, [ama]."

# game/scripts/c23/c23.rpy:3322
translate french c23s007_SleepingArrangements_452e6387:

    # "Pasáis una noche agradable, cenando y riendo, sin nombrar ni una sola vez el dilema de [bet]."
    "Vous passez une agréable soirée, à dîner et à rire, sans même évoquer une seule fois le dilemme de [bet]."

# game/scripts/c23/c23.rpy:3323
translate french c23s007_SleepingArrangements_eb458632:

    # "[emm] os explica emocionada todo lo que ha aprendido en el curso de conducción y por dónde ha conducido mientras os esperaba."
    "[emm] Elle vous explique avec enthousiasme tout ce qu'elle a appris pendant le cours de conduite et les endroits où elle a conduit en vous attendant."

# game/scripts/c23/c23.rpy:3324
translate french c23s007_SleepingArrangements_8a3270a9:

    # "Cuando le preguntas, se niega a decir qué ha comprado para las chicas en casa."
    "Quand on lui pose la question, elle refuse de dire ce qu'elle a acheté pour les filles à la maison."

# game/scripts/c23/c23.rpy:3326
translate french c23s007_SleepingArrangements_96c1d5b6:

    # "Al llegar al hotel os dirigís a vuestras respectivas habitaciones."
    "À votre arrivée à l'hôtel, vous vous rendrez dans vos chambres respectives."

# game/scripts/c23/c23.rpy:3327
translate french c23s007_SleepingArrangements_e2dd6b3a:

    # "Pasas una buena noche de descanso."
    "Passez une bonne nuit."

# game/scripts/c23/c23.rpy:3331
translate french c23s007_SleepingArrangements_9c10f707:

    # "Al llegar al hotel..."
    "À notre arrivée à l'hôtel..."

# game/scripts/c23/c23.rpy:3332
translate french c23s007_SleepingArrangements_bf7af1cf:

    # emm "¡Ay! ¡Uff!"
    emm "Ouf !"

# game/scripts/c23/c23.rpy:3333
translate french c23s007_SleepingArrangements_05b11d12:

    # mc "¿Qué te pasa, [emm]?"
    mc "Qu'est-ce qui ne va pas, [emm] ?"

# game/scripts/c23/c23.rpy:3335
translate french c23s007_SleepingArrangements_d6407639:

    # emm "Te he dicho antes de salir que si tenía que dormir sentada me acabaría doliendo el cuello."
    emm "Je t'avais dit avant notre départ que si je devais dormir assise, j'aurais mal au cou."

# game/scripts/c23/c23.rpy:3336
translate french c23s007_SleepingArrangements_2fe6ac9f:

    # emm "Entre eso y después el curso de conducción, lo tengo hecho polvo. Ahora entiendo por qué los pilotos tienen cuellos como troncos."
    emm "Entre ça et le stage de conduite, je suis complètement épuisé. Maintenant, je comprends pourquoi les pilotes ont un cou aussi longiligne."

# game/scripts/c23/c23.rpy:3338
translate french c23s007_SleepingArrangements_34e6e135:

    # bet "¿Quieres que te dé un masaje o algo?"
    bet "Tu veux que je te masse ou quelque chose comme ça ?"

# game/scripts/c23/c23.rpy:3339
translate french c23s007_SleepingArrangements_dd323ab7:

    # mc "O tomarte un analgésico."
    mc "Ou prenez un analgésique."

# game/scripts/c23/c23.rpy:3341
translate french c23s007_SleepingArrangements_75440d8e:

    # emm "No hace falta. Con una buena noche de descanso..."
    emm "Pas besoin. Avec une bonne nuit de sommeil..."

# game/scripts/c23/c23.rpy:3343
translate french c23s007_SleepingArrangements_71b9ad2d:

    # emm "¡Oh!"
    emm "Oh!"

# game/scripts/c23/c23.rpy:3344
translate french c23s007_SleepingArrangements_3b916da8:

    # mc "¿Qué pasa?"
    mc "Ce qui se passe?"

# game/scripts/c23/c23.rpy:3346
translate french c23s007_SleepingArrangements_4f341d25:

    # emm "No has cogido camas individuales, y cuando tengo este dolor de cuello me muevo mucho durmiendo."
    emm "Vous n'avez pas réservé de lits simples, et quand j'ai mal au cou, je bouge beaucoup pendant mon sommeil."

# game/scripts/c23/c23.rpy:3347
translate french c23s007_SleepingArrangements_964584cf:

    # emm "Voy a molestar a Tía [bet] y no le voy a dejar dormir."
    emm "Je vais embêter tante [bet] et l'empêcher de dormir."

# game/scripts/c23/c23.rpy:3349
translate french c23s007_SleepingArrangements_7dc2697f:

    # bet "No te preocupes, yo duermo como un tronco..."
    bet "Ne t'inquiète pas, je dors comme une souche..."

# game/scripts/c23/c23.rpy:3351
translate french c23s007_SleepingArrangements_6912d95d:

    # mc "Puedes dormir en mi cama y yo duermo en el sofá. No parece incómodo."
    mc "Tu peux dormir dans mon lit et je dormirai sur le canapé. Ça ne me paraît pas bizarre."

# game/scripts/c23/c23.rpy:3353
translate french c23s007_SleepingArrangements_d20312a3:

    # emm "No podría hacerte eso. Es tu cama..."
    emm "Je ne pourrais pas te faire ça. C'est ton lit..."

# game/scripts/c23/c23.rpy:3354
translate french c23s007_SleepingArrangements_97a9ca7c:

    # emm "Pero has tenido una buena idea. ¿Por qué no nos cambiamos de habitación? Yo duermo en la tuya y tú en la mía."
    emm "Mais tu as eu une bonne idée. Pourquoi n'échangerions-nous pas nos chambres ? Je dormirai dans la tienne et toi dans la mienne."

# game/scripts/c23/c23.rpy:3355
translate french c23s007_SleepingArrangements_808af671:

    # mc "Porque acabas de decir que es una cama doble. No sé si Tía [bet] querrá compartirla conmigo."
    mc "Parce que tu viens de dire que c'est un lit double. Je ne sais pas si tante [bet] voudra le partager avec moi."

# game/scripts/c23/c23.rpy:3357
translate french c23s007_SleepingArrangements_6910781a:

    # bet "No voy a permitir que duermas en un sofá."
    bet "Je ne te permettrai pas de dormir sur un canapé."

# game/scripts/c23/c23.rpy:3359
translate french c23s007_SleepingArrangements_344a8f78:

    # emm "¿Ves? Además, Tía [bet] seguro que ha traído un pijama nada sexy de esos de franela."
    emm "Tu vois ? En plus, tante [bet] a probablement apporté un de ces pyjamas en flanelle pas très sexy."

# game/scripts/c23/c23.rpy:3361
translate french c23s007_SleepingArrangements_17664d9e:

    # bet "*Risa* ¿Has estado revolviendo en mi maleta? No es de franela, pero no creo que nadie pueda considerarlo sexy."
    bet "*Rires* Tu as fouillé dans ma valise ? Ce n'est pas de la flanelle, mais je ne pense pas que quiconque trouverait ça sexy."

# game/scripts/c23/c23.rpy:3362
translate french c23s007_SleepingArrangements_079ee38a:

    # mc "¿Estás segura, Tía [bet]?"
    mc "Tu es sûre, tante [bet] ?"

# game/scripts/c23/c23.rpy:3364
translate french c23s007_SleepingArrangements_da3bdc54:

    # bet "¿De que el pijama no es sexy o de que no voy a dejarte dormir en el sofá?"
    bet "Tu insinues que les pyjamas ne sont pas sexy, ou que je ne vais pas te laisser dormir sur le canapé ?"

# game/scripts/c23/c23.rpy:3365
translate french c23s007_SleepingArrangements_eeb87e89:

    # bet "Porque estoy muy segura de las dos cosas."
    bet "Parce que j'en suis absolument certain."

# game/scripts/c23/c23.rpy:3367
translate french c23s007_SleepingArrangements_6dfe85cb:

    # emm "Entonces todo arreglado. Ayúdame a mover mis tres maletas a tu habitación, [mc]."
    emm "Alors tout est réglé. Aide-moi à transporter mes trois valises dans ta chambre, [mc]."

# game/scripts/c23/c23.rpy:3368
translate french c23s007_SleepingArrangements_048f453e:

    # mc "Vamos, se está haciendo tarde y tú has dormido poco esta noche."
    mc "Allez, il se fait tard et tu n'as pas beaucoup dormi cette nuit."

# game/scripts/c23/c23.rpy:3370
translate french c23s007_SleepingArrangements_c43baea5:

    # "Una vez movidas las maletas..."
    "Une fois les valises déplacées..."

# game/scripts/c23/c23.rpy:3371
translate french c23s007_SleepingArrangements_b7167afb:

    # emm "Descansa, que mañana quiero hacer turismo. Podemos dejar el Ferrarini aquí e ir con tu coche. O incluso devolverlo antes."
    emm "Repose-toi bien, j'aimerais faire du tourisme demain. On peut laisser la Ferrarini ici et prendre ta voiture. Ou même la rendre plus tôt."

# game/scripts/c23/c23.rpy:3372
translate french c23s007_SleepingArrangements_bae81fae:

    # mcp "(¿No era el otro lado del cuello el que le dolía? Es posible que le duelan los dos, ¿no?)"
    mcp "(N'était-ce pas l'autre côté de son cou qui lui faisait mal ? Il est possible qu'il ait mal des deux côtés, non ?)"

# game/scripts/c23/c23.rpy:3373
translate french c23s007_SleepingArrangements_4f77b52a:

    # emm "Tengo ganas de pasar tiempo con Tía [bet]."
    emm "J'ai hâte de passer du temps avec tante [bet]."

# game/scripts/c23/c23.rpy:3374
translate french c23s007_SleepingArrangements_99eda8c5:

    # mc "Ahora necesita nuestro apoyo más que nunca."
    mc "Aujourd'hui, il a plus que jamais besoin de notre soutien."

# game/scripts/c23/c23.rpy:3379
translate french c23s007_SleepingArrangements_7cd59be0:

    # emm "Espero que la apoyes mucho esta noche. Hasta mañana, [mc]."
    emm "J'espère que vous la soutiendrez beaucoup ce soir. À demain, [mc]."

# game/scripts/c23/c23.rpy:3380
translate french c23s007_SleepingArrangements_4a6b95a4:

    # mc "Hasta mañana, [emm]."
    mc "À demain, [emm]."

# game/scripts/c23/c23.rpy:3382
translate french c23s007_SleepingArrangements_fa714a8c:

    # emm "Cuídala."
    emm "Prenez soin d'elle."

# game/scripts/c23/c23.rpy:3385
translate french c23s007_SleepingArrangements_793b3422:

    # "Al llegar a la habitación que compartes con [bet] con tu mochila..."
    "En arrivant dans la chambre que vous partagez avec [bet], avec votre sac à dos..."

# game/scripts/c23/c23.rpy:3387
translate french c23s007_SleepingArrangements_c3ad1eb3:

    # bet "*Desde el lavabo* ¡Voy a matarla!"
    bet "*Depuis la salle de bain* Je vais la tuer !"

# game/scripts/c23/c23.rpy:3388
translate french c23s007_SleepingArrangements_40d33d62:

    # mc "¿Qué pasa Tía [bet]? ¿A quién quieres matar?"
    mc "Qu'est-ce qui ne va pas, tante [bet] ? Qui veux-tu tuer ?"

# game/scripts/c23/c23.rpy:3390
translate french c23s007_SleepingArrangements_c64c1474:

    # bet "*A través de la puerta* ¡A [emm]!"
    bet "*Par la porte* Vers [emm] !"

# game/scripts/c23/c23.rpy:3391
translate french c23s007_SleepingArrangements_471ed3c8:

    # mc "¿Qué ha hecho ahora?"
    mc "Qu'a-t-il fait maintenant ?"

# game/scripts/c23/c23.rpy:3392
translate french c23s007_SleepingArrangements_0a3bc0ad:

    # bet "*A través de la puerta* ¡Se ha llevado toda mi ropa!"
    bet "*Par la porte* Il a pris tous mes vêtements !"

# game/scripts/c23/c23.rpy:3393
translate french c23s007_SleepingArrangements_7da7d367:

    # mc "¿Se ha llevado tu maleta?"
    mc "Ont-ils pris votre valise ?"

# game/scripts/c23/c23.rpy:3394
translate french c23s007_SleepingArrangements_df326ead:

    # bet "*A través de la puerta* ¡No! ¡Ha vaciado mi maleta! ¡No ha dejado ni la ropa que llevaba en el viaje!"
    bet "*À travers la porte* Non ! Il a vidé ma valise ! Il n'a même pas laissé les vêtements que je portais pendant le voyage !"

# game/scripts/c23/c23.rpy:3396
translate french c23s007_SleepingArrangements_aa5200eb:

    # mc "Voy a decirle que te la devuelva. Seguramente te quería gastar una broma."
    mc "Je vais lui dire de me le rendre. Il te faisait probablement une blague."

# game/scripts/c23/c23.rpy:3403
translate french c23s007_SleepingArrangements_805a62d9:

    # "Cuando sales de la habitación, ves el Ferrarini rosa saliendo a toda velocidad del aparcamiento."
    "En quittant la pièce, vous voyez la Ferrarini rose quitter le parking à toute vitesse."

# game/scripts/c23/c23.rpy:3405
translate french c23s007_SleepingArrangements_7797bda8:

    # mcp "(¿Qué trama esta chica?)"
    mcp "(Que mijote cette fille ?)"

# game/scripts/c23/c23.rpy:3410
translate french c23s007_End_190cc9d2:

    # "Tras un paso infructuoso por recepción, vuelves a la habitación de [bet]..."
    "Après une visite infructueuse à la réception, vous retournez dans la chambre [bet]..."

# game/scripts/c23/c23.rpy:3412
translate french c23s007_End_4542e5fa:

    # bet "*A través de la puerta* ¿Has conseguido que te devuelva mi ropa?"
    bet "*Par la porte* As-tu réussi à récupérer mes vêtements ?"

# game/scripts/c23/c23.rpy:3413
translate french c23s007_End_4aed78c4:

    # mc "No, cuando he salido se iba en su coche."
    mc "Non, quand je suis parti, il s'éloignait en voiture."

# game/scripts/c23/c23.rpy:3414
translate french c23s007_End_16c84f24:

    # bet "*A través de la puerta* ¿Has ido a recepción para que te den la llave? Esa habitación está a tu nombre."
    bet "*Par la porte* Êtes-vous allé à la réception chercher la clé ? Cette chambre est à votre nom."

# game/scripts/c23/c23.rpy:3415
translate french c23s007_End_3b041b6f:

    # mc "He ido, y [emm] les ha dicho que hemos cambiado de habitaciones y que no le den su llave a nadie bajo ninguna circunstancia."
    mc "Je suis allé et [emm] leur a dit que nous avions changé de chambre et de ne donner leur clé à personne en aucune circonstance."

# game/scripts/c23/c23.rpy:3416
translate french c23s007_End_0a45188f:

    # bet "*A través de la puerta* ¡La mato!"
    bet "*À travers la porte* Je vais la tuer !"

# game/scripts/c23/c23.rpy:3417
translate french c23s007_End_8523e6ab:

    # bet "*A través de la puerta* ¿Tú estás seguro de que estaba durmiendo en el coche?"
    bet "*À travers la porte* Êtes-vous sûr qu'il dormait dans la voiture ?"

# game/scripts/c23/c23.rpy:3418
translate french c23s007_End_8f561cb0:

    # mc "No lo sé, has sido tú quien ha dicho que estaba durmiendo. ¿Por qué?"
    mc "Je ne sais pas, c'est toi qui as dit que je dormais. Pourquoi ?"

# game/scripts/c23/c23.rpy:3419
translate french c23s007_End_a8f57bba:

    # bet "*A través de la puerta* Porque creo que lo ha oído todo."
    bet "*À travers la porte* Parce que je pense qu'il a tout entendu."

# game/scripts/c23/c23.rpy:3420
translate french c23s007_End_0c9657de:

    # mc "¿Por qué crees eso?"
    mc "Pourquoi pensez-vous cela ?"

# game/scripts/c23/c23.rpy:3426
translate french c23s007_End_25fcd05b:

    # bet "Porque lo único que ha dejado en mi maleta ha sido esto, que ni siquiera es mío y todavía tiene la etiqueta."
    bet "Parce que la seule chose qu'il a laissée dans ma valise, c'est ça, qui n'est même pas à moi et qui a encore son étiquette."

# game/scripts/c23/c23.rpy:3428
translate french c23s007_End_a5e54b11:

    # bet "Y una nota que decía \"Disfrútalo\"."
    bet "Et un petit mot qui disait « Profitez-en »."

