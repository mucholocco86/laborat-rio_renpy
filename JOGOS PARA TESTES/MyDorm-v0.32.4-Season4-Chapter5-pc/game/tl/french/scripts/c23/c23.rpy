translate french c23s005_NoMar_45dc9a44:

    # mom "No, me levantaré para haceros el desayuno antes de que salgáis."
    mom "Non, je me lèverai pour te préparer le petit-déjeuner avant ton départ."

# game/scripts/c23/c23.rpy:1857
translate french c23s005_NoMar_2c3b5aa8:

    # mc "No te tienes que preocupar por eso."
    mc "Vous n'avez pas à vous en soucier."

# game/scripts/c23/c23.rpy:1859
translate french c23s005_NoMar_e70b3cce:

    # mom "He dicho que me levantaré y lo pienso hacer. No voy a dejar que conduzcas tres horas con el estómago vacío."
    mom "J'ai dit que je me lèverais, et je compte le faire. Je ne vais pas te laisser conduire pendant trois heures le ventre vide."

# game/scripts/c23/c23.rpy:1860
translate french c23s005_NoMar_e4aa384c:

    # mc "Sabes que soy capaz de prepararme un café y cortarme un trozo de tarta, ¿verdad?"
    mc "Tu sais que je suis capable de me faire un café et de me couper une part de gâteau, n'est-ce pas ?"

# game/scripts/c23/c23.rpy:1861
translate french c23s005_NoMar_ac66e14c:

    # mc "Pero bueno, no te voy a convencer de que no lo hagas. Te veo mañana."
    mc "Bref, je ne vais pas te dissuader. À demain."

# game/scripts/c23/c23.rpy:1862
translate french c23s005_NoMar_f617ec24:

    # mom "Hasta mañana."
    mom "À demain."

# game/scripts/c23/c23.rpy:1865
