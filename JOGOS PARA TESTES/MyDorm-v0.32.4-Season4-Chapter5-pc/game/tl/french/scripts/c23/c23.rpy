translate french c23s005_MarVisit_7af44f31:

    # mom "Un grupo de chicas en un dormitorio femenino. Ellas no tienen la suerte de tenerte a ti para ayudarlas, aunque tampoco parecen necesitarlo."
    mom "Un groupe de filles dans un dortoir féminin. Elles n'ont pas la chance de pouvoir compter sur votre aide, même si elles n'en ont pas l'air."

# game/scripts/c23/c23.rpy:1835
translate french c23s005_MarVisit_195caa06:

    # mom "Y... ya sabes..."
    mom "Et... vous savez..."

# game/scripts/c23/c23.rpy:1836
