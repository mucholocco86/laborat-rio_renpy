translate french c23s005_MarVisit_564f71da:

    # mc "Quería preguntarte por la camisa azul. ¿La has encontrado?"
    mc "Je voulais vous interroger sur la chemise bleue. L'avez-vous retrouvée ?"

# game/scripts/c23/c23.rpy:1820
translate french c23s005_MarVisit_fd0098b2:

    # mom "Sí, la he metido en la maleta de [emm]. En una de las maletas."
    mom "Oui, je l'ai mis dans la valise de [emm]. Dans une des valises."

# game/scripts/c23/c23.rpy:1821
translate french c23s005_MarVisit_d2a50ced:

    # mc "*Risa* ¿Cuántas se lleva al final?"
    mc "*Rires* Combien en prend-elle finalement ?"

# game/scripts/c23/c23.rpy:1822
translate french c23s005_MarVisit_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Ça vous dérange si je m'assieds ?"

# game/scripts/c23/c23.rpy:1824
translate french c23s005_MarVisit_731a1635:

    # mom "*Risa* Eso es algo que tendrás que descubrir mañana."
    mom "*Rires* Vous le découvrirez demain."

# game/scripts/c23/c23.rpy:1825
translate french c23s005_MarVisit_d8845d26:

    # mc "Dame sólo una pista. Si fuéramos en tu coche en vez de con la pick up, ¿cabrían?"
    mc "Juste un petit indice. Si on prenait ta voiture au lieu du pick-up, est-ce qu'ils rentreraient ?"

# game/scripts/c23/c23.rpy:1827
translate french c23s005_MarVisit_70ce664e:

    # mom "No. *Risa* Seguramente deberíais dejar a Tía [bet] aquí."
    mom "Non. *Rires* Tu devrais probablement laisser tante [bet] ici."

# game/scripts/c23/c23.rpy:1828
translate french c23s005_MarVisit_943171d1:

    # mc "Vale, me hago una idea."
    mc "D'accord, j'ai compris."

