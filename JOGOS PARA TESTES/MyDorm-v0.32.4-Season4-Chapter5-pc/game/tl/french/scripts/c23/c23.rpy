    mc "Bon, si on ne peut pas aller à Carmel, je te promets que je t'y emmènerai un jour, à mon retour d'Aruba."

# game/scripts/c23/c23.rpy:2625
translate french c23s006_AfterBreakfastBetConfession_62ca9199:

    # emm "Me parece bien. Y ahora voy a dormir un poco."
    emm "Ça me convient. Et maintenant, je vais dormir un peu."

# game/scripts/c23/c23.rpy:2626
translate french c23s006_AfterBreakfastBetConfession_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c23/c23.rpy:2628
translate french c23s006_AfterBreakfastBetConfession_0740b24c:

    # bet "No la pongas de mal humor discutiendo con ella por una causa perdida, [mc]."
    bet "Ne la contrarie pas en te disputant avec elle sur une cause perdue, [mc]."

# game/scripts/c23/c23.rpy:2629
translate french c23s006_AfterBreakfastBetConfession_6c170086:

