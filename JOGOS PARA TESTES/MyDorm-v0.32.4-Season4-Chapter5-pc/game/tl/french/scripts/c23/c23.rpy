# game/scripts/c23/c23.rpy:2678
translate french c23s006_AfterBreakfastBetConfession_526ca8a7:

    # mc "Entonces se olvidan las buenas, si es que hizo alguna."
    mc "Puis on oublie les bonnes choses, si tant est qu'elle en ait fait."

# game/scripts/c23/c23.rpy:2680
translate french c23s006_AfterBreakfastBetConfession_7f0c7e18:

    # bet "No, con John no era así. De sus equivocaciones te olvidabas a los cinco minutos."
    bet "Non, ce n'était pas comme ça avec John. On oubliait ses erreurs en cinq minutes."

# game/scripts/c23/c23.rpy:2681
translate french c23s006_AfterBreakfastBetConfession_edf7a302:

    # bet "Tenía un don para que sus aciertos y éxitos pesaran mucho más que sus fallos y sus fracasos."
    bet "Il avait le don de faire en sorte que ses succès et ses réalisations surpassent largement ses échecs et ses erreurs."

# game/scripts/c23/c23.rpy:2683
translate french c23s006_AfterBreakfastBetConfession_2b3e9541:

    # bet "Tenía un carisma especial para hacer que ni te fijaras en sus carencias o en lo que hacía mal."
    bet "Il possédait un charisme particulier qui faisait qu'on ne remarquait même pas ses défauts ou ses erreurs."

# game/scripts/c23/c23.rpy:2684
translate french c23s006_AfterBreakfastBetConfession_4fd6f76e:

    # bet "Como siempre estaba haciendo cosas por los demás, todo el mundo pensaba que él no tenía problemas propios."
    bet "Comme il était toujours là pour les autres, tout le monde pensait qu'il n'avait aucun problème personnel."

# game/scripts/c23/c23.rpy:2685
translate french c23s006_AfterBreakfastBetConfession_477e8157:

    # bet "Tú te pareces mucho a él. Más de lo que incluso [mee] ha descubierto."
    bet "Tu lui ressembles beaucoup. Plus encore que [mee] ne l'a réalisé."

# game/scripts/c23/c23.rpy:2686
translate french c23s006_AfterBreakfastBetConfession_45f202a6:

    # mc "Gracias, supongo. A veces lo describís como si meara whisky y sus pedos fueran arcoíris."
    mc "Merci, je suppose. Parfois, vous le décrivez comme s'il urinait du whisky et que ses pets étaient des arcs-en-ciel."

# game/scripts/c23/c23.rpy:2688
