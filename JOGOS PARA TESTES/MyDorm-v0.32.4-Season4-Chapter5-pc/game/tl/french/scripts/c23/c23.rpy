    mc "Au fait, que lis-tu ? Je ne savais pas que tu aimais les BD."

# game/scripts/c23/c23.rpy:1831
translate french c23s005_MarVisit_852f836e:

    # mom "Creía que era una revista. Se llama Días de Dormitorio."
    mom "Je croyais que c'était un magazine. Il s'appelle Dormitory Days."

# game/scripts/c23/c23.rpy:1832
translate french c23s005_MarVisit_c76428d1:

    # mom "Pero creo que es de [kat]."
    mom "Mais je pense que ça vient de [kat]."

