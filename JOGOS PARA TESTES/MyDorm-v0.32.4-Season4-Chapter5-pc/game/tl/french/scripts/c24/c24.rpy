# game/scripts/c24/c24.rpy:1020
translate french c24s002_Meanwhile_Kim_Mar_Kat_4965e1df:

    # kim "Nos tenemos que desnudar emocionalmente delante de él..."
    kim "Nous devons nous dévoiler émotionnellement devant lui..."

# game/scripts/c24/c24.rpy:1022
translate french c24s002_Meanwhile_Kim_Mar_Kat_a85b66b0:

    # mom "Los hombres han estado en esa situación durante siglos."
    mom "Les hommes se trouvent dans cette situation depuis des siècles."

