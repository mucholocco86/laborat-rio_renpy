translate french c24s004_kiaOnMC_06dd01f1:

    # mc "*Risa* Voy a acabar de limpiarme y te espero en la habitación. Me tienes que contar esos escenarios."
    mc "*Rires* Je vais finir de ranger et je t'attendrai dans la chambre. Il faut absolument que tu me racontes ces histoires."

# game/scripts/c24/c24.rpy:2912
translate french c24s004_kiaOnMC_54e794a2:

    # "Vuelves a la habitación después de limpiarte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Vous retournez dans la chambre après vous être lavé et séché. Vous attendez que [kia] finisse de se doucher, le regard perdu dans la cheminée."

# game/scripts/c24/c24.rpy:2916
translate french c24s004_kiaOnFloor_6d537bfa:

    # kia "¿Cómo va a importarme que mires? Eso era lo más interesante de mi petición..."
    kia "Pourquoi devrais-je me soucier de votre présence ? C'était la partie la plus intéressante de ma demande…"

# game/scripts/c24/c24.rpy:2917
translate french c24s004_kiaOnFloor_bd03522c:

    # mc "Eres mucho más traviesa de lo que imaginaba. Me encanta..."
    mc "Tu es bien plus coquin(e) que je ne l'imaginais. J'adore ça..."

# game/scripts/c24/c24.rpy:2919
translate french c24s004_kiaOnFloor_2408be39:

    # kia "¿Vas a mirar desde ahí arriba?"
    kia "Tu vas regarder d'en haut ?"

# game/scripts/c24/c24.rpy:2920
translate french c24s004_kiaOnFloor_9b21b8ce:

    # mc "Voy a mirar desde todos los ángulos. No es algo que quiera perderme."
    mc "Je vais l'examiner sous tous les angles. Je ne veux pas rater ça."

# game/scripts/c24/c24.rpy:2921
translate french c24s004_kiaOnFloor_852a656d:

    # kia "Ahí voy, entonces."
    kia "Me voilà donc."

# game/scripts/c24/c24.rpy:2923
translate french c24s004_kiaOnFloor_bbfbdeee:

    # "Un potente chorro amarillento hace su aparición en un momento. Es hipnótico."
    "Un puissant jet jaunâtre apparaît en un instant. C'est hypnotique."

# game/scripts/c24/c24.rpy:2924
translate french c24s004_kiaOnFloor_5b30cf74:

    # kia "Me está poniendo cómo me miras..."
    kia "La façon dont tu me regardes m'excite..."

# game/scripts/c24/c24.rpy:2925
translate french c24s004_kiaOnFloor_b875b0be:

    # mc "A mí me está poniendo mirarte..."
    mc "Je suis excitée rien qu'en te regardant..."

# game/scripts/c24/c24.rpy:2927
translate french c24s004_kiaOnFloor_3947b7fb:

    # "Se forma un pequeño charco en el suelo que lucha por no ser lavado por el agua de la ducha."
    "Une petite flaque se forme sur le sol, luttant pour ne pas être emportée par l'eau de la douche."

# game/scripts/c24/c24.rpy:2928
translate french c24s004_kiaOnFloor_bc241615:

    # kia "¿Te pongo yo o verme mear?"
    kia "Dois-je te le donner ou me regarder faire pipi ?"

# game/scripts/c24/c24.rpy:2929
translate french c24s004_kiaOnFloor_b65ed262:

    # mc "Las dos cosas... que seas tú quién mee. Que seas tú quién lo ha propuesto."
    mc "Les deux choses… que ce soit toi qui fasses pipi. Que ce soit toi qui l’aies suggéré."

# game/scripts/c24/c24.rpy:2931
translate french c24s004_kiaOnFloor_dfa67c31:

    # "Cambias de ángulo, no queriendo perderte nada del espectáculo. [kia] cambia de posición para darte una mejor visión."
    "Vous changez d'angle de vue pour ne rien manquer. [kia] Changez de position pour avoir une meilleure vue."

# game/scripts/c24/c24.rpy:2932
translate french c24s004_kiaOnFloor_01ab4c6d:

    # kia "Ya se está acabando..."
    kia "C'est presque fini..."

# game/scripts/c24/c24.rpy:2933
translate french c24s004_kiaOnFloor_25bda972:

    # mc "Habrá que disfrutar las vistas hasta el último momento, entonces."
    mc "Nous devrons donc profiter de la vue jusqu'au dernier moment."

# game/scripts/c24/c24.rpy:2935
translate french c24s004_kiaOnFloor_caed8249:

    # "El chorro desaparece casi de golpe y el charco un par de segundos después."
    "Le jet disparaît presque instantanément, et la flaque quelques secondes plus tard."

# game/scripts/c24/c24.rpy:2936
translate french c24s004_kiaOnFloor_a36448f8:

    # mc "Ha durado menos de lo que esperaba... pero ha valido la pena."
    mc "Ça a duré moins longtemps que prévu... mais ça en valait la peine."

# game/scripts/c24/c24.rpy:2937
translate french c24s004_kiaOnFloor_4a613eab:

    # kia "Una experiencia nueva para los dos."
    kia "Une nouvelle expérience pour nous deux."

# game/scripts/c24/c24.rpy:2939
translate french c24s004_kiaOnFloor_2201430b:

    # kia "Ahora mismo estoy cachondísima. Hacer esto delante tuyo ha sido super caliente."
    kia "J'ai tellement envie de faire ça. C'était incroyablement excitant de faire ça devant toi."

# game/scripts/c24/c24.rpy:2940
translate french c24s004_kiaOnFloor_b406bea8:

    # kia "Y veo que a ti también te ha puesto igual de cachondo. Mjolnir vuelve a estar enorme."
    kia "Et je vois que ça vous a tout autant excité. Mjolnir est redevenu gigantesque."

# game/scripts/c24/c24.rpy:2941
translate french c24s004_kiaOnFloor_d3071c47:

    # mc "*Risa* ¿Quieres el cuarto asalto? Te estás volviendo avariciosa..."
    mc "*Rires* Tu veux une quatrième manche ? Tu deviens gourmand..."

# game/scripts/c24/c24.rpy:2943
translate french c24s004_kiaOnFloor_9f1dbd4c:

    # kia "No creo que pudiera. Ahora quiero acabar de ducharme e ir a la cama a darnos abrazos antes de dormir."
    kia "Je ne crois pas que je pourrais. Maintenant, j'ai juste envie de finir ma douche et d'aller me coucher pour qu'on puisse se faire des câlins avant de dormir."

# game/scripts/c24/c24.rpy:2944
translate french c24s004_kiaOnFloor_f5fd80b6:

    # mc "Me parece una idea estupenda. Déjame aclararme y te espero en la cama mientras acabas de ducharte."
    mc "Ça me paraît une excellente idée. Laisse-moi y réfléchir et je t'attendrai au lit pendant que tu finis ta douche."

# game/scripts/c24/c24.rpy:2946
translate french c24s004_kiaOnFloor_3935088c:

    # "Vuelves a la habitación después de aclararte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Vous retournez dans la chambre après vous être rincé et séché. Vous attendez que la douche soit terminée, le regard perdu dans la cheminée."

# game/scripts/c24/c24.rpy:2954
translate french c24s004_Deb_Sim_f573cf4a:

    # "Después de comer, algunas de las chicas te preguntan si te vas a unir a ellas en la piscina."
    "Après le repas, certaines filles vous demandent si vous voulez les rejoindre dans la piscine."

# game/scripts/c24/c24.rpy:2955
translate french c24s004_Deb_Sim_0b862711:

    # "Subes a tu habitación a ponerte el bañador. Quieres relajarte un rato antes de la reunión con Iron Fist de la noche."
    "Vous montez dans votre chambre pour enfiler votre maillot de bain. Vous voulez vous détendre un peu avant votre rendez-vous avec Iron Fist plus tard dans la soirée."

# game/scripts/c24/c24.rpy:2957
translate french c24s004_Deb_Sim_69ea716e:

    # "Cuando bajas a la piscina, encuentras a [deb.nick] y a [sim] charlando animadamente en el agua."
    "Lorsque vous descendez à la piscine, vous trouvez [deb.nick] déjà en train de [sim] bavarder avec animation dans l'eau."

# game/scripts/c24/c24.rpy:2959
translate french c24s004_Deb_Sim_9262c7af:

    # mc "¿Qué tal, chicas? ¿Cómo están las dos sirenas?"
    mc "Salut les filles ! Comment vont les deux sirènes ?"

# game/scripts/c24/c24.rpy:2960
translate french c24s004_Deb_Sim_b368d369:

    # sim "Genial. Después de ver a un montón de niños nadando esta mañana, tenía ganas de nadar un rato. Y no hay nadie mejor que [deb.nick] para hacerlo."
    sim "Super. Après avoir vu plein d'enfants nager ce matin, j'ai eu envie d'aller nager moi aussi. Et qui de mieux que [deb.nick] pour le faire ?"

# game/scripts/c24/c24.rpy:2961
translate french c24s004_Deb_Sim_e7d1088a:

    # deb "No exageres, [sim]."
    deb "N'exagérez pas, [sim]."

# game/scripts/c24/c24.rpy:2962
translate french c24s004_Deb_Sim_8db86fd1:

    # mc "¿Hacéis carreras entre vosotras?"
    mc "Vous faites la course ?"

# game/scripts/c24/c24.rpy:2964
translate french c24s004_Deb_Sim_a7c2f323:

    # sim "*Risa* ¡Qué va! [deb.nick] es demasiado buena para mí."
    sim "*Rires* Pas question ! [deb.nick] Elle est trop bien pour moi."

# game/scripts/c24/c24.rpy:2965
translate french c24s004_Deb_Sim_4e273363:

    # sim "Hicimos una amistosa y no tuvo que esforzarse para darme una paliza."
    sim "Nous avons disputé un match amical et il n'a pas eu à forcer pour me battre."

# game/scripts/c24/c24.rpy:2967
translate french c24s004_Deb_Sim_74c39d65:

    # deb "No le hagas caso. Está exagerando y está desentrenada."
    deb "Ne l'écoutez pas. Elle exagère et elle n'est plus en forme."

# game/scripts/c24/c24.rpy:2968
translate french c24s004_Deb_Sim_be167096:

    # mc "Bueno, lleva tiempo sin nadar. Es lógico."
    mc "Eh bien, ça fait un moment qu'il n'a pas nagé. C'est compréhensible."

# game/scripts/c24/c24.rpy:2970
translate french c24s004_Deb_Sim_72045934:

    # sim "Llevo un año sin nadar en una competición y ni siquiera entonces llegué a los campeonatos nacionales."
    sim "Je n'ai pas participé à une compétition de natation depuis un an, et même à cette époque, je n'avais pas réussi à me qualifier pour les championnats nationaux."

# game/scripts/c24/c24.rpy:2971
translate french c24s004_Deb_Sim_0d68806d:

    # sim "Ella llegó y los ganó. Creo que la diferencia está clara, ¿no?"
    sim "Elle est arrivée et a gagné. La différence est flagrante, non ?"

# game/scripts/c24/c24.rpy:2973
translate french c24s004_Deb_Sim_164b1d20:

    # deb "Ya sabes por qué fue. No tienes el cuerpo adecuado para ser nadadora competitiva."
    deb "Tu sais pourquoi. Tu n'as pas le physique requis pour être un nageur de compétition."

# game/scripts/c24/c24.rpy:2974
translate french c24s004_Deb_Sim_b60a4e8e:

    # deb "Te desarrollaste donde no me desarrollé yo, y eso te quita centésimas en cada brazada."
    deb "Tu as progressé là où je ne l'ai pas fait, et cela nous fait gagner des centièmes de seconde à chaque coup."

# game/scripts/c24/c24.rpy:2976
translate french c24s004_Deb_Sim_abcd2cb9:

    # sim "A veces odio estas tetas..."
    sim "Parfois, je déteste ces seins..."

# game/scripts/c24/c24.rpy:2978
translate french c24s004_Deb_Sim_2b71414e:

    # mc "A mí me encantan..."
    mc "Je les adore..."

# game/scripts/c24/c24.rpy:2981
translate french c24s004_Deb_Sim_cd85f167:

    # sim "También te encantan las de [deb.nick]. *Risa* Tu opinión es bienvenida, pero eres poco quisquilloso en cuanto a tetas."
    sim "Tu aimes aussi celles de [deb.nick]. *Rires* Ton avis est le bienvenu, mais tu n'es pas très difficile en matière de seins."

# game/scripts/c24/c24.rpy:2982
translate french c24s004_Deb_Sim_a140637f:

    # mc "Tienes razón, ¿para qué negarlo? *Risa*"
    mc "Tu as raison, pourquoi le nier ? *Rires*"

# game/scripts/c24/c24.rpy:2983
translate french c24s004_Deb_Sim_9f4a647f:

    # mc "Todos tenemos que aceptar el cuerpo que nos toca, [sim]."
    mc "Nous devons tous accepter le corps qui nous est donné, [sim]."

# game/scripts/c24/c24.rpy:2985
translate french c24s004_Deb_Sim_6e665169:

    # mc "Y a mí me gustan los vuestros. Los de las dos."
    mc "Et j'aime bien le vôtre. Les leurs tous les deux."

# game/scripts/c24/c24.rpy:2987
translate french c24s004_Deb_Sim_52e20141:

    # deb "¿Sí?" (multiple=2)
    deb "Ouais?" (multiple=2)

# game/scripts/c24/c24.rpy:2988
translate french c24s004_Deb_Sim_5a8cda6f:

    # sim "¡Sí!" (multiple=2)
    sim "Ouais!" (multiple=2)

# game/scripts/c24/c24.rpy:2989
translate french c24s004_Deb_Sim_4761ff8d:

    # mc "Sí, ¿sobre qué?"
    mc "Oui, à propos de quoi ?"

# game/scripts/c24/c24.rpy:2992
translate french c24s004_Deb_Sim_7010c693:

    # sim "¡Ahora!"
    sim "Maintenant!"

# game/scripts/c24/c24.rpy:2993
translate french c24s004_Deb_Sim_5e482cd8:

    # mc "¿QUÉ?"
    mc "QUE?"

# game/scripts/c24/c24.rpy:2995
translate french c24s004_Deb_Sim_d0b5fe9c:

    # mc "*Risa* ¿A qué ha venido eso?"
    mc "*Rires* De quoi s'agissait-il ?"

# game/scripts/c24/c24.rpy:2996
translate french c24s004_Deb_Sim_9d5b35df:

    # sim "*Risa* Me estaba entrando tortícolis de mirar tan arriba."
    sim "*Rires* J'avais mal au cou à force de regarder si haut."

# game/scripts/c24/c24.rpy:2997
translate french c24s004_Deb_Sim_bab7afa5:

    # deb "*Risa* Y a ti te ha tocado un cuerpo poco ágil que no ha podido esquivar nuestros ataques."
    deb "*Rires* Et toi, tu t'es retrouvée avec un corps maladroit incapable d'esquiver nos attaques."

# game/scripts/c24/c24.rpy:3000
translate french c24s004_Deb_Sim_e83606cc:

    # sim "Además, tenía ganas de hacer esto."
    sim "En plus, j'avais vraiment envie de le faire."

# game/scripts/c24/c24.rpy:3001
translate french c24s004_Deb_Sim_f953d662:

    # mc "Entonces no me voy a quejar del ataque a traición."
    mc "Alors je ne vais pas me plaindre de l'attaque sournoise."

# game/scripts/c24/c24.rpy:3004
translate french c24s004_Deb_Sim_ff0a09ef:

    # deb "Yo también tenía ganas de besarte."
    deb "Moi aussi, j'avais envie de t'embrasser."

# game/scripts/c24/c24.rpy:3005
translate french c24s004_Deb_Sim_fe762c04:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Rires* Tu peux m'attaquer quand tu veux si c'est ça la récompense."

# game/scripts/c24/c24.rpy:3008
translate french c24s004_Deb_Sim_229a9d02:

    # deb "Además, tenía ganas de besarte."
    deb "D'ailleurs, j'avais envie de t'embrasser."

# game/scripts/c24/c24.rpy:3009
translate french c24s004_Deb_Sim_fe762c04_1:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Rires* Tu peux m'attaquer quand tu veux si c'est ça la récompense."

# game/scripts/c24/c24.rpy:3011
translate french c24s004_Deb_Sim_0393a250:

    # mc "Y, aparte de atacar a pobres hombres que pasaban por aquí, ¿de qué estabais hablando?"
    mc "Et, à part s'en prendre à de pauvres gens qui passaient par là, de quoi parliez-vous ?"

# game/scripts/c24/c24.rpy:3013
translate french c24s004_Deb_Sim_371b629d:

    # deb "Precisamente estábamos hablando de nadar."
    deb "Nous parlions justement de natation."

# game/scripts/c24/c24.rpy:3014
translate french c24s004_Deb_Sim_179d63bb:

    # deb "Le estaba diciendo a [sim] que quizás pudiera convencer al entrenador de la universidad para que la dejara entrenar algunos días con nosotras."
    deb "Je disais à [sim] que je pourrais peut-être convaincre l'entraîneur de l'université de la laisser s'entraîner avec nous pendant quelques jours."

# game/scripts/c24/c24.rpy:3015
translate french c24s004_Deb_Sim_0cb3e1bd:

    # mc "¿Puedes hacer eso?"
    mc "Pouvez-vous faire cela ?"

# game/scripts/c24/c24.rpy:3017
translate french c24s004_Deb_Sim_ea14bc84:

    # sim "¡Claro que puede! ¡Es la estrella de la universidad! Seguro que no le niegan nada."
    sim "Bien sûr qu'elle peut ! C'est la star de l'université ! Je suis sûre qu'ils ne lui refuseront rien."

# game/scripts/c24/c24.rpy:3019
translate french c24s004_Deb_Sim_1ce3d555:

    # sim "Pero prefiero que no lo haga. Sería como... no sé... probar cómo hubiera sido mi vida en otras circunstancias pero no poder vivirla del todo."
    sim "Mais je préférerais éviter. Ce serait comme… je ne sais pas… essayer d’imaginer ce qu’aurait été ma vie dans d’autres circonstances, sans pouvoir la vivre pleinement."

# game/scripts/c24/c24.rpy:3021
translate french c24s004_Deb_Sim_bf03d1c9:

    # deb "¡Es tan cabezota como su hermano!"
    deb "Il est tout aussi têtu que son frère !"

# game/scripts/c24/c24.rpy:3022
translate french c24s004_Deb_Sim_52bdc56e:

    # deb "Aprendería técnicas nuevas y cómo se entrena en la universidad. Sólo por eso ya valdría la pena."
    deb "J'apprendrais de nouvelles techniques et comment se déroule la formation à l'université. Rien que ça en vaudrait la peine."

# game/scripts/c24/c24.rpy:3023
translate french c24s004_Deb_Sim_b8aabfc3:

    # mc "Creo que tienes razón, pero también comprendo a [sim]."
    mc "Je pense que vous avez raison, mais je comprends aussi [sim]."

# game/scripts/c24/c24.rpy:3025
translate french c24s004_Deb_Sim_5a84b9a5:

    # sim "¿Ves? ¡El me entiende!"
    sim "Vous voyez ? Il me comprend !"

# game/scripts/c24/c24.rpy:3026
translate french c24s004_Deb_Sim_4ea9139c:

    # mc "Te entiendo, pero no comparto tu decisión."
    mc "Je vous comprends, mais je ne suis pas d'accord avec votre décision."

# game/scripts/c24/c24.rpy:3028
translate french c24s004_Deb_Sim_2e41f7dc:

    # sim "¿Qué?"
    sim "Que?"

# game/scripts/c24/c24.rpy:3029
translate french c24s004_Deb_Sim_1c685b6d:

    # mc "Siempre te ha gustado nadar y ahora tienes que ver cómo otros lo hacen y esperar a que se ahoguen para salvarlos."
    mc "Tu as toujours adoré nager, et maintenant tu dois regarder les autres nager et attendre qu'ils se noient pour pouvoir les sauver."

# game/scripts/c24/c24.rpy:3031
translate french c24s004_Deb_Sim_c2dd440a:

    # sim "*Risa* ¡No se ahoga nadie en mi guardia!"
    sim "*Rires* Personne ne se noie sous ma surveillance !"

# game/scripts/c24/c24.rpy:3032
translate french c24s004_Deb_Sim_e2a3c315:

    # mc "[sim], hablo en serio. Entiendo cómo te sientes, pero creo que deberías aceptar la oferta de [deb.nick]."
    mc "[sim], je suis sérieux. Je comprends ce que tu ressens, mais je pense que tu devrais accepter l'offre de [deb.nick]."

# game/scripts/c24/c24.rpy:3033
translate french c24s004_Deb_Sim_fb51b049:

    # mc "Entrenarías con las mejores de la ciudad y, aunque no vuelvas a competir, aprenderás muchísimo."
    mc "Vous vous entraîneriez avec les meilleurs de la ville et, même si vous ne participiez plus jamais à des compétitions, vous apprendriez beaucoup."

# game/scripts/c24/c24.rpy:3035
translate french c24s004_Deb_Sim_a9a18e0c:

    # deb "Es lo que le he dicho. Además, nuestro entrenador es muy bueno y aprenderá cómo entrenar a otros."
    deb "C'est ce que je lui ai dit. De plus, notre entraîneur est très bon et il apprendra à entraîner les autres."

# game/scripts/c24/c24.rpy:3037
translate french c24s004_Deb_Sim_df1264f7:

    # deb "Es lo que querías estudiar, ¿no?"
    deb "C'est ce que tu voulais étudier, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3039
translate french c24s004_Deb_Sim_142d4e09:

    # sim "Sí, pero sin la beca, no voy a ir nunca a la universidad. Dudo que nunca sea entrenadora."
    sim "Oui, mais sans cette bourse, je n'irai jamais à l'université. Je doute de devenir un jour entraîneur."

# game/scripts/c24/c24.rpy:3040
translate french c24s004_Deb_Sim_cb3953ee:

    # sim "Y con mis récords, nunca voy a conseguir una beca."
    sim "Et avec mon dossier scolaire, je n'obtiendrai jamais de bourse."

# game/scripts/c24/c24.rpy:3041
translate french c24s004_Deb_Sim_f7506dbb:

    # mc "Pero aprenderás mucho igualmente. Y seguirás nadando, que es lo que importa."
    mc "Mais tu apprendras beaucoup de toute façon. Et tu continueras à nager, c'est le principal."

# game/scripts/c24/c24.rpy:3043
translate french c24s004_Deb_Sim_0f43e16d:

    # deb "Creo que no la vas a convencer. Como he dicho, es casi peor que intentar convencer a Jamaal para que suelte un plato de comida."
    deb "Je ne pense pas que tu la convaincras. Comme je l'ai dit, c'est presque pire que d'essayer de convaincre Jamaal de te laisser une assiette de nourriture."

# game/scripts/c24/c24.rpy:3044
translate french c24s004_Deb_Sim_58e478ce:

    # mc "Siempre he dicho que se parecen mucho. No sé cuál de los dos es más terco."
    mc "J'ai toujours dit qu'ils étaient très similaires. Je ne sais pas lequel est le plus têtu."

# game/scripts/c24/c24.rpy:3046
translate french c24s004_Deb_Sim_9e085d60:

    # sim "¡Hey! Estoy aquí, ¿sabéis?"
    sim "Hé ! Je suis là, tu sais ?"

# game/scripts/c24/c24.rpy:3047
translate french c24s004_Deb_Sim_188127f9:

    # "[deb.nick] y tú la ignoráis. Habéis encontrado su punto débil."
    "[deb.nick] et tu l'ignores. Tu as trouvé son point faible."

# game/scripts/c24/c24.rpy:3049
translate french c24s004_Deb_Sim_30cf8c66:

    # deb "No creas que no la entiendo. Con esos dos flotadores tiene que ser incómodo nadar. En eso se diferencia de Jamaal."
    deb "Ne croyez pas que je ne la comprends pas. Nager avec ces deux brassards doit être inconfortable. C'est ce qui la différencie de Jamaal."

# game/scripts/c24/c24.rpy:3050
translate french c24s004_Deb_Sim_c021f347:

    # mc "*Risa* Sí, creo que Jamaal tiene poca flotabilidad con la silla de ruedas."
    mc "*Rires* Oui, je pense que Jamaal a peu de flottabilité dans son fauteuil roulant."

# game/scripts/c24/c24.rpy:3051
translate french c24s004_Deb_Sim_31753902:

    # mc "Pero, ¿sabes en lo que sí que se parecen? A los dos les cuesta aceptar retos."
    mc "Mais savez-vous ce qu'ils ont en commun ? Ils ont tous deux du mal à relever les défis."

# game/scripts/c24/c24.rpy:3052
translate french c24s004_Deb_Sim_de0144ff:

    # mc "Jamaal tardó tiempo en descubrir que, aunque tuviera que vivir una vida diferente, podía hacer lo que le gustaba."
    mc "Jamaal a mis du temps à comprendre que, même s'il devait vivre une vie différente, il pouvait faire ce qu'il aimait."

# game/scripts/c24/c24.rpy:3054
translate french c24s004_Deb_Sim_903a7b4e:

    # sim "¡Tenía once años! ¡Era un niño!"
    sim "Il avait onze ans ! Ce n'était qu'un enfant !"

# game/scripts/c24/c24.rpy:3055
translate french c24s004_Deb_Sim_866a67f9:

    # "Seguís ignorándola."
    "Tu continues de l'ignorer."

# game/scripts/c24/c24.rpy:3057
translate french c24s004_Deb_Sim_f9147568:

    # deb "Y es una lástima que [sim] se comporte como una niña de once años, ¿verdad?"
    deb "Et c'est dommage que [sim] se comporte comme une fillette de onze ans, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3058
translate french c24s004_Deb_Sim_a34fa9e3:

    # mc "Sí, una verdadera lástima. Va a dejar de hacer lo que le gusta porque no puede hacerlo al nivel que le gustaría."
    mc "Oui, c'est vraiment dommage. Il va devoir arrêter de faire ce qu'il aime car il ne peut plus le faire au niveau qu'il souhaiterait."

# game/scripts/c24/c24.rpy:3059
translate french c24s004_Deb_Sim_ce1a8e38:

    # deb "*Risa* Justo como su hermano." (multiple=2)
    deb "*Rires* Exactement comme son frère." (multiple=2)

# game/scripts/c24/c24.rpy:3060
translate french c24s004_Deb_Sim_c7beffad:

    # mc "*Risa* Justo como Jamaal." (multiple=2)
    mc "*Rires* Exactement comme Jamaal." (multiple=2)

# game/scripts/c24/c24.rpy:3061
translate french c24s004_Deb_Sim_def7e49a:

    # mc "¿Sabes que Jam estuvo a punto de no ir al baile de graduación?"
    mc "Saviez-vous que Jam a failli ne pas aller au bal de promo ?"

# game/scripts/c24/c24.rpy:3063
translate french c24s004_Deb_Sim_28bc3de6:

    # sim "¡Porque le dejó su novio dos semanas antes del baile!"
    sim "Parce que son petit ami l'a larguée deux semaines avant le bal !"

# game/scripts/c24/c24.rpy:3065
translate french c24s004_Deb_Sim_fad15be1:

    # "[deb.nick] continúa como si no hubiera escuchado nada."
    "[deb.nick] continue comme s'il n'avait rien entendu."

# game/scripts/c24/c24.rpy:3066
translate french c24s004_Deb_Sim_14558884:

    # deb "¿Porque no podía bailar?"
    deb "Pourquoi ne pouvait-elle pas danser ?"

# game/scripts/c24/c24.rpy:3067
translate french c24s004_Deb_Sim_78320f97:

    # mc "No, le encanta bailar y hace unas cosas tremendas con las ruedas. Pero no quería porque no podía bailar con quién él hubiera querido bailar."
    mc "Non, il adore danser et il fait des choses incroyables avec les roues. Mais il ne voulait pas danser parce qu'il ne pouvait pas danser avec la personne avec qui il voulait danser."

# game/scripts/c24/c24.rpy:3068
translate french c24s004_Deb_Sim_bd261694:

    # mc "Es como su hermana. Ella no quiere nadar porque no puede nadar en competiciones."
    mc "Elle est exactement comme sa sœur. Elle ne veut pas nager parce qu'elle ne peut pas faire de compétition."

# game/scripts/c24/c24.rpy:3069
translate french c24s004_Deb_Sim_befe1427:

    # mc "Yo convencí a Jam, pero te tocará a ti convencer a [sim]."
    mc "J'ai convaincu Jam, mais ce sera à vous de convaincre [sim]."

# game/scripts/c24/c24.rpy:3071
translate french c24s004_Deb_Sim_1039aabf:

    # sim "¡Parad! ¡Vale! ¡Habla con ese entrenador a ver si puedo entrenar con vosotras alguna tarde este verano!"
    sim "Stop ! OK ! Parlez-en à cet entraîneur et voyez si je peux m'entraîner avec vous certains après-midi cet été !"

# game/scripts/c24/c24.rpy:3072
translate french c24s004_Deb_Sim_8821a64c:

    # mc "¡Oh, [sim]! ¿Estabas aquí?"
    mc "Oh, [sim] ! Étiez-vous là ?"

# game/scripts/c24/c24.rpy:3073
translate french c24s004_Deb_Sim_46eb31ff:

    # sim "*Grrrr*"
    sim "*Grrrr*"

# game/scripts/c24/c24.rpy:3075
translate french c24s004_Deb_Sim_ebd8990d:

    # deb "*Risa* Si lo hubiéramos planeado no hubiera podido salir mejor."
    deb "*Rires* Si on l'avait planifié, ça n'aurait pas pu mieux se passer."

# game/scripts/c24/c24.rpy:3076
translate french c24s004_Deb_Sim_a52d9d69:

    # mc "*Risa* Pero es una táctica que siempre funciona con los Washington. Comparar a [sim] y a Jamaal."
    mc "*Rires* Mais c'est une tactique qui fonctionne toujours avec les Washington. Comparer [sim] à Jamaal."

# game/scripts/c24/c24.rpy:3078
translate french c24s004_Deb_Sim_721bf2a3:

    # sim "Pues ahora te vamos a expulsar de la piscina."
    sim "Bon, maintenant on va vous sortir de la piscine."

# game/scripts/c24/c24.rpy:3079
translate french c24s004_Deb_Sim_5a242d9e:

    # mc "¿Por qué a mí? ¡Lo hemos hecho [deb.nick] y yo!"
    mc "Pourquoi moi ? Nous l'avons fait [deb.nick] et je l'ai fait !"

# game/scripts/c24/c24.rpy:3081
translate french c24s004_Deb_Sim_2e27a1e4:

    # sim "Puedes ir a la otra zona. Esto se acaba de convertir en Zona de Entrenamiento [sim]. Vamos a ponernos bañadores para entrenar. ¡No se puede entrenar en bikini!"
    sim "Vous pouvez aller dans l'autre zone. Elle vient d'être transformée en zone d'entraînement [sim]. Enfilez vos maillots de bain pour l'entraînement. Pas d'entraînement en bikini !"

# game/scripts/c24/c24.rpy:3082
translate french c24s004_Deb_Sim_00322b59:

    # sim "No puedo hacer el ridículo cuando vaya a esos entrenamientos. Y [deb.nick] lo va a pagar ayudándome a entrenar. *Risa* Se le acabó hacer top-less."
    sim "Je ne peux pas me ridiculiser à ces entraînements. Et elle va payer pour ça en m'aidant à m'entraîner. *Rires* Elle ne se mettra plus seins nus."

# game/scripts/c24/c24.rpy:3083
translate french c24s004_Deb_Sim_6e95e83f:

    # mc "Vale, vale. Ya me voy. Puedes pedirle un bañador a mi madre."
    mc "D'accord, d'accord. Je m'en vais. Tu peux demander un maillot de bain à ma mère."

# game/scripts/c24/c24.rpy:3086
translate french c24s004_Deb_Sim_525bacf2:

    # sim "Aunque te bese, me las pagarás por lo que acabas de hacer."
    sim "Même si je t'embrasse, tu paieras pour ce que tu viens de faire."

# game/scripts/c24/c24.rpy:3089
translate french c24s004_Deb_Sim_5d0b2999:

    # sim "Aunque te abrace, me las pagarás por lo que acabas de hacer."
    sim "Même si je te prends dans mes bras, tu paieras pour ce que tu viens de faire."

# game/scripts/c24/c24.rpy:3090
translate french c24s004_Deb_Sim_ba6e11d1:

    # mc "Creo que más que pagártelas, me lo acabarás agradeciendo."
    mc "Je pense qu'au lieu de les payer, vous finirez par me remercier."

# game/scripts/c24/c24.rpy:3095
translate french c24s004_Deb_Sim_207adb5a:

    # deb "Yo también lo creo. Nos lo acabará agradeciendo, pero ahora debes marcharte, antes de que cambie de opinión."
    deb "Je le pense aussi. Il nous en remerciera à la fin, mais vous devez partir maintenant, avant qu'il ne change d'avis."

# game/scripts/c24/c24.rpy:3098
translate french c24s004_Deb_Sim_55823a68:

    # mc "Os dejo que vayáis a poneros los bañadores. Voy a ver qué están haciendo las otras chicas."
    mc "Je vous laisse aller mettre vos maillots de bain. Je vais voir ce que font les autres filles."

# game/scripts/c24/c24.rpy:3108
translate french c24s004_Mad_Lis_Emm_516952fc:

    # "Orgulloso de cómo las chicas se están ayudando entre ellas, sales de la piscina y te secas."
    "Fiers de voir les filles s'entraider, vous sortez de la piscine et vous vous séchez."

# game/scripts/c24/c24.rpy:3109
translate french c24s004_Mad_Lis_Emm_e2be684a:

    # "Te acercas a [lis], [emm], y [mad.nick], que parecen ocupadas alrededor de unos papeles."
    "Vous vous approchez de [lis], [emm] et [mad.nick], qui semblent occupés autour de quelques papiers."

# game/scripts/c24/c24.rpy:3110
translate french c24s004_Mad_Lis_Emm_525cc9aa:

    # mc "¿Qué tal, chicas?"
    mc "Salut les filles !"

# game/scripts/c24/c24.rpy:3112
translate french c24s004_Mad_Lis_Emm_a71852af:

    # emm "¡Hola, [mc]!"
    emm "Bonjour, [mc] !"

# game/scripts/c24/c24.rpy:3113
translate french c24s004_Mad_Lis_Emm_b1e4a5db:

    # lis "Estamos ayudando a [mad.nick] con sus diseños. A ver si podemos acabar hoy y así puede empezar con la costura."
    lis "Nous aidons [mad.nick] avec ses créations. Voyons si nous pouvons terminer aujourd'hui pour qu'elle puisse commencer à coudre."

# game/scripts/c24/c24.rpy:3114
translate french c24s004_Mad_Lis_Emm_00469f9c:

    # mad "Hay un montón de cosas en las que no había pensado."
    mad "Il y a beaucoup de choses auxquelles je n'avais pas pensé."

# game/scripts/c24/c24.rpy:3115
translate french c24s004_Mad_Lis_Emm_85b9ddbf:

    # mc "Es genial que os estéis ayudando tanto."
    mc "C'est formidable que vous vous entraidiez autant."

# game/scripts/c24/c24.rpy:3117
translate french c24s004_Mad_Lis_Emm_41e57a73:

    # mc "¿No hay besos para mí, hoy?"
    mc "Pas de bisous pour moi aujourd'hui ?"

# game/scripts/c24/c24.rpy:3121
translate french c24s004_Mad_Lis_Emm_af271d4a:

    # "Tu hermana se lanza a tus brazos para darte un largo beso. Prácticamente no habéis hablado desde que volvisteis de Monterey."
    "Votre sœur se jette dans vos bras et vous embrasse longuement. Vous vous êtes à peine parlé depuis votre retour de Monterey."

# game/scripts/c24/c24.rpy:3123
translate french c24s004_Mad_Lis_Emm_9c4f444d:

    # "[emm] se lanza a tus brazos para darte un largo beso. Prácticamente no habéis hablado desde que volvisteis de Monterey."
    "[emm] se jette dans vos bras pour vous embrasser longuement. Vous avez à peine échangé un mot depuis votre retour de Monterey."

# game/scripts/c24/c24.rpy:3125
translate french c24s004_Mad_Lis_Emm_6e1a52bd:

    # emm "Te aseguro que no voy a dejar de darte besos por unos vestidos, por bonitos que sean."
    emm "Je t'assure que je ne cesserai pas de t'embrasser à cause de certaines robes, aussi belles soient-elles."

# game/scripts/c24/c24.rpy:3128
translate french c24s004_Mad_Lis_Emm_113f97cd:

    # "La preciosa asiática te da un apasionado beso."
    "La belle femme asiatique vous embrasse passionnément."

# game/scripts/c24/c24.rpy:3130
translate french c24s004_Mad_Lis_Emm_149653a2:

    # mad "Por mucho que me gusten mis diseños, me gusta más esto."
    mad "J'aime beaucoup mes créations, mais j'aime encore plus celle-ci."

# game/scripts/c24/c24.rpy:3133
translate french c24s004_Mad_Lis_Emm_f0bc6dec:

    # "[lis] se acerca tímidamente y se dirige a darte un beso en la mejilla. Giras un poco la cara para rozar sus labios. No se aparta."
    "Il s'approche timidement et se penche pour vous embrasser sur la joue. Vous tournez légèrement la tête pour effleurer ses lèvres des vôtres. Il ne se retire pas."

# game/scripts/c24/c24.rpy:3134
translate french c24s004_Mad_Lis_Emm_f4e0d435:

    # "Es la primera vez que tiene la oportunidad de demostrar en público que estáis juntos."
    "C'est la première fois qu'elle a l'occasion de montrer publiquement que vous êtes ensemble."

# game/scripts/c24/c24.rpy:3136
translate french c24s004_Mad_Lis_Emm_26089012:

    # emm "¡Eso no es un beso, [lis]! Estoy segura de que lo puedes hacer mejor."
    emm "Ce n'est pas un baiser, [lis] ! Je suis sûre que tu peux faire mieux."

# game/scripts/c24/c24.rpy:3138
translate french c24s004_Mad_Lis_Emm_f28bc6e6:

    # "Tu pequeña princesa parece olvidarse de que las otras dos chicas están alrededor y aumenta la pasión del beso. Un largo beso."
    "Votre petite princesse semble oublier la présence des deux autres filles et la passion du baiser s'intensifie. Un long baiser."

# game/scripts/c24/c24.rpy:3140
translate french c24s004_Mad_Lis_Emm_a4a11aa1:

    # emm "*Risa* ¡Eso está mejor! Pero, o volvemos a los vestidos, u os buscáis una habitación."
    emm "*Rires* C'est mieux ! Mais soit on remet des robes, soit vous vous trouvez une chambre."

# game/scripts/c24/c24.rpy:3142
translate french c24s004_Mad_Lis_Emm_7e19a99d:

    # lis "*Risa* Si nos buscamos una habitación, seguro que convences a [mad.nick] para que haga todos los vestidos rosas."
    lis "*Rires* Si on trouve une chambre, je suis sûre que tu convaincras [mad.nick] de faire toutes les robes roses."

# game/scripts/c24/c24.rpy:3144
translate french c24s004_Mad_Lis_Emm_24ba1971:

    # mad "¡Ni en broma! *Risa* Van a ser blancos. Le van a quedar genial a [kim]."
    mad "Pas question ! *Rires* Elles seront blanches. Elles iront super bien à [kim]."

# game/scripts/c24/c24.rpy:3148
translate french c24s004_Mad_Lis_Emm_d5d72893:

    # mad "Y falta [kim], que es quién va a ser la modelo."
    mad "Et [kim] manque à l'appel, qui sera le modèle."

# game/scripts/c24/c24.rpy:3149
translate french c24s004_Mad_Lis_Emm_7dcd21bd:

    # mad "Está probándose el uniforme que le han mandado para el trabajo de esta noche."
    mad "Il essaie l'uniforme qu'ils lui ont envoyé pour son travail de ce soir."

# game/scripts/c24/c24.rpy:3150
translate french c24s004_Mad_Lis_Emm_efd19175:

    # mc "¿Puedo ayudaros con el tema de los vestidos? No es que sea un experto, pero..."
    mc "Puis-je vous aider pour les robes ? Je ne suis pas vraiment une experte, mais…"

# game/scripts/c24/c24.rpy:3151
translate french c24s004_Mad_Lis_Emm_a8e56f70:

    # mc "Sé lo que queda sexy en una mujer."
    mc "Je sais ce qui est sexy chez une femme."

# game/scripts/c24/c24.rpy:3154
translate french c24s004_Mad_Lis_Emm_0ec2c031:

    # emm "*Risa* Si tuvieras que elegir lo que queda sexy en [kim], seguro que acababa sólo con un tanga."
    emm "*Rires* Si je devais choisir ce qui est encore sexy dans [kim], je finirais sans aucun doute par ne porter qu'un string."

# game/scripts/c24/c24.rpy:3155
translate french c24s004_Mad_Lis_Emm_1f3c663c:

    # mc "Y estoy seguro de que estaría super sexy, pero no creo que sea el estilo que [mad.nick] quiere para sus vestidos."
    mc "Et je suis sûre que ça aurait l'air super sexy, mais je ne pense pas que ce soit le style que [mad.nick] souhaite pour ses robes."

# game/scripts/c24/c24.rpy:3156
translate french c24s004_Mad_Lis_Emm_27ad541d:

    # mc "¿Es para otro concurso?"
    mc "Est-ce pour un autre concours ?"

# game/scripts/c24/c24.rpy:3158
translate french c24s004_Mad_Lis_Emm_30d98925:

    # mad "No, esta vez estamos refinando mi portfolio de diseños. Voy a coser los vestidos para [kim], de tal forma que [emm] pueda hacer las fotos."
    mad "Non, cette fois-ci, nous peaufinons mon portfolio de design. Je vais coudre les robes pour [kim], afin que [emm] puisse prendre les photos."

# game/scripts/c24/c24.rpy:3160
translate french c24s004_Mad_Lis_Emm_d415f031:

    # mc "Me parece una idea estupenda. Y supongo que [lis] está para evitar que [emm] te convenza para que los hagas rosas."
    mc "Je trouve que c'est une excellente idée. Et je suppose que [lis] est là pour empêcher [emm] de vous convaincre de les faire roses."

# game/scripts/c24/c24.rpy:3162
translate french c24s004_Mad_Lis_Emm_31799661:

    # mc "Me parece una idea estupenda. Y, aparte de evitar que [emm] te convenza para que los hagas rosas, ¿cuál es la función de [lis]?"
    mc "Je trouve que c'est une excellente idée. Et, outre le fait d'empêcher [emm] de vous convaincre de les faire roses, à quoi sert [lis] ?"

# game/scripts/c24/c24.rpy:3164
translate french c24s004_Mad_Lis_Emm_ac794a80:

    # lis "*Risa* Hay un par de vestidos que están pensados para cenas de gala y eventos sociales."
    lis "*Rires* Il existe quelques robes conçues pour les dîners de gala et les événements mondains."

# game/scripts/c24/c24.rpy:3165
translate french c24s004_Mad_Lis_Emm_86bf68ab:

    # lis "Esos los va a hacer [mad.nick] también en mi talla y la de [deb.nick], así podemos usarlos cuando vayamos a alguna fiesta con famosos y hacerle un poco de publicidad."
    lis "Il va les fabriquer à ma taille et à celle de F3 aussi, pour qu'on puisse les porter quand on ira à une soirée avec des célébrités et lui faire un peu de pub."

# game/scripts/c24/c24.rpy:3166
translate french c24s004_Mad_Lis_Emm_e47691d6:

    # mc "Empezáis a dar un poco de miedo. Parece que habéis encontrado una forma en que todas aportáis algo y todas ganáis algo."
    mc "Tu commences à faire un peu peur. On dirait que tu as trouvé un système où chacun contribue et où chacun y gagne."

# game/scripts/c24/c24.rpy:3167
translate french c24s004_Mad_Lis_Emm_e122a3d5:

    # mc "Experiencia, publicidad, portfolio, o vestidos."
    mc "Expérience, publicité, portfolio ou robes."

# game/scripts/c24/c24.rpy:3169
translate french c24s004_Mad_Lis_Emm_477f2a47:

    # lis "*Risa* Lo dices como si fuera una transacción comercial, y lo estamos haciendo por ayudar a [mad.nick] con sus diseños y a [kim] con su portfolio."
    lis "*Rires* Vous le dites comme s'il s'agissait d'une transaction commerciale, et nous le faisons pour aider [mad.nick] avec leurs conceptions et [kim] avec leur portfolio."

# game/scripts/c24/c24.rpy:3170
translate french c24s004_Mad_Lis_Emm_b344721f:

    # lis "Y para que [emm] pueda hacer su primer trabajo semiprofesional... *Risa* Vale, sí. Experiencia, publicidad, portfolio, y vestidos."
    lis "Et pour que [emm] puisse décrocher son premier boulot semi-professionnel… *Rires* Bon, d’accord. Expérience, publicité, portfolio et robes."

# game/scripts/c24/c24.rpy:3171
translate french c24s004_Mad_Lis_Emm_d97cdb7b:

    # mc "*Risa* Aunque vuestras acciones sean altruistas, todas ganáis algo. Es la mejor forma de hacerlo."
    mc "*Rires* Même si vos actions sont altruistes, vous y gagnez tous quelque chose. C'est la meilleure façon de procéder."

# game/scripts/c24/c24.rpy:3173
translate french c24s004_Mad_Lis_Emm_1b1ee8ed:

    # mad "Sólo nos falta convencer a [deb.nick] para que pose con los vestidos que le voy a hacer."
    mad "Il ne nous reste plus qu'à convaincre [deb.nick] de poser dans les robes que je vais lui confectionner."

# game/scripts/c24/c24.rpy:3174
translate french c24s004_Mad_Lis_Emm_bb28ec00:

    # mad "Siendo tan alta, las fotos quedarían geniales."
    mad "Étant donné sa grande taille, les photos seraient superbes."

# game/scripts/c24/c24.rpy:3175
translate french c24s004_Mad_Lis_Emm_05d04fb6:

    # mcp "(Y le ayudaríais a entender que ser alta puede tener muchas ventajas.)"
    mcp "(Et vous l'aideriez à comprendre qu'être grand peut avoir de nombreux avantages.)"

# game/scripts/c24/c24.rpy:3177
translate french c24s004_Mad_Lis_Emm_fec9e41f:

    # mcp "(Y que no me gusta sólo a mí que sea así.)"
    mcp "(Et je ne suis pas le seul à préférer ainsi.)"

# game/scripts/c24/c24.rpy:3178
translate french c24s004_Mad_Lis_Emm_9cf0af5b:

    # mc "Supongo que diferentes vestidos quedarán mejor o peor en diferentes modelos."
    mc "J'imagine que différentes robes rendront mieux ou moins bien sur différents mannequins."

# game/scripts/c24/c24.rpy:3180
translate french c24s004_Mad_Lis_Emm_b12266cc:

    # emm "*Risa* Y si haces un vestido rosa, yo me presto voluntaria para posar con él."
    emm "*Rires* Et si vous faites une robe rose, je me porterai volontaire pour poser dedans."

# game/scripts/c24/c24.rpy:3181
translate french c24s004_Mad_Lis_Emm_980c43f9:

    # emm "Cuantas más modelos diferentes tengas, más profesional quedará tu portfolio."
    emm "Plus vous aurez de modèles différents, plus votre portfolio aura l'air professionnel."

# game/scripts/c24/c24.rpy:3182
translate french c24s004_Mad_Lis_Emm_a7eac97b:

    # mc "¿Quién sacará las fotos si tú estás posando?"
    mc "Qui prendra les photos si vous posez ?"

# game/scripts/c24/c24.rpy:3184
translate french c24s004_Mad_Lis_Emm_27553ae9:

    # lis "Las puedo sacar yo. No soy tan buena como [emm], pero sé algo de fotografía."
    lis "Je peux les prendre moi-même. Je ne suis pas aussi bon que [emm], mais je m'y connais un peu en photographie."

# game/scripts/c24/c24.rpy:3185
translate french c24s004_Mad_Lis_Emm_f1bbd183:

    # mc "Genial ¿Vais a hacer las fotos en la piscina? Podrían quedar muy chulas."
    mc "Super ! Tu vas prendre les photos dans la piscine ? Elles pourraient être vraiment géniales."

# game/scripts/c24/c24.rpy:3187
translate french c24s004_Mad_Lis_Emm_8d2b93f9:

    # mad "Haremos algunas aquí y otras en el bosque, quizás algunas en la playa, incluso. Pero, para el portfolio, quedarían mejor en un estudio."
    mad "On en prendra quelques-unes ici, d'autres dans les bois, peut-être même sur la plage. Mais pour le portfolio, elles seraient plus belles en studio."

# game/scripts/c24/c24.rpy:3189
translate french c24s004_Mad_Lis_Emm_fd57f5d8:

    # emm "Quiero convencer a Mamá para que me deje usar parte del sótano para montar un estudio de fotografía. No necesito mucha inversión y hay un montón de espacio sin usar."
    emm "Je voudrais convaincre maman de me laisser utiliser une partie du sous-sol pour y installer un studio photo. Ça ne me coûte pas cher et il y a plein d'espace libre."

# game/scripts/c24/c24.rpy:3190
translate french c24s004_Mad_Lis_Emm_fcf0bd70:

    # emm "¿Crees que me dejará hacerlo?"
    emm "Tu crois qu'il me laissera faire ?"

# game/scripts/c24/c24.rpy:3191
translate french c24s004_Mad_Lis_Emm_145f4ce8:

    # mc "No creo que ponga ningún impedimento. Siempre dice que deberíamos darle alguna utilidad al sótano."
    mc "Je ne pense pas qu'il s'y opposera. Il dit toujours qu'on devrait utiliser le sous-sol d'une manière ou d'une autre."

# game/scripts/c24/c24.rpy:3193
translate french c24s004_Mad_Lis_Emm_c3e133e8:

    # mad "Para alguna de las fotos que tengo pensadas... ¿te importaría posar con [kim]?"
    mad "Pour certaines des photos que j'ai prévues... cela vous dérangerait-il de poser avec [kim] ?"

# game/scripts/c24/c24.rpy:3194
translate french c24s004_Mad_Lis_Emm_c128bb2e:

    # mad "Hay algunos vestidos que quedarían genial en poses románticas con un chico."
    mad "Il existe certaines robes qui seraient magnifiques dans des poses romantiques avec un garçon."

# game/scripts/c24/c24.rpy:3195
translate french c24s004_Mad_Lis_Emm_5b721e88:

    # mc "*Risa* ¿Quieres que haga de modelo para ti? Por mí no hay ningún problema."
    mc "*Rires* Vous voulez que je pose pour vous ? Ça ne me pose aucun problème."

# game/scripts/c24/c24.rpy:3197
translate french c24s004_Mad_Lis_Emm_d085e527:

    # emm "*Risa* Podrías hacer del madurito cuarentón seduciendo a una jovencita. Ya sabes que aparentas más edad de la que tienes."
    emm "*Rires* Tu pourrais jouer le rôle d'un homme d'une quarantaine d'années séduisant une jeune femme. Tu sais que tu fais plus vieux que ton âge."

# game/scripts/c24/c24.rpy:3199
translate french c24s004_Mad_Lis_Emm_c553849f:

    # mc "*Risa* Contigo funcionó, aunque no tuviera que hacer nada para seducirte."
    mc "*Rires* Ça a marché avec toi, même si je n'ai rien eu à faire pour te séduire."

# game/scripts/c24/c24.rpy:3201
translate french c24s004_Mad_Lis_Emm_ab9a09cf:

    # mc "*Risa* Podría ser divertido."
    mc "*Rires* Ça pourrait être amusant."

# game/scripts/c24/c24.rpy:3202
translate french c24s004_Mad_Lis_Emm_91fefb40:

    # mc "¿También hay trajes para mí?"
    mc "Existe-t-il des costumes pour moi aussi ?"

# game/scripts/c24/c24.rpy:3204
translate french c24s004_Mad_Lis_Emm_4cefdcd6:

    # lis "No, [mad.nick] no hace ropa para hombre, al menos aún."
    lis "Non, [mad.nick] ne fabrique pas de vêtements pour hommes, du moins pas encore."

# game/scripts/c24/c24.rpy:3205
translate french c24s004_Mad_Lis_Emm_cd94c3a4:

    # lis "Pero estarías muy bien con el traje que llevaste al Jazz Corner."
    lis "Mais tu serais superbe dans le costume que tu portais à Jazz Corner."

# game/scripts/c24/c24.rpy:3207
translate french c24s004_Mad_Lis_Emm_5b71ce45:

    # mad "*Risa* Sabéis que os odio a veces, ¿verdad?"
    mad "*Rires* Vous savez que je vous déteste parfois, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3208
translate french c24s004_Mad_Lis_Emm_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c24/c24.rpy:3210
translate french c24s004_Mad_Lis_Emm_801f217c:

    # mad "Es una tontería pero, excepto el cumpleaños de las chicas, me he perdido todas las actividades familiares."
    mad "C'est bête, mais à part l'anniversaire des filles, j'ai raté toutes les activités familiales."

# game/scripts/c24/c24.rpy:3211
translate french c24s004_Mad_Lis_Emm_b40dc845:

    # mad "La fiesta en la playa, la noche en el club de Jazz... A veces os ponéis a hablar de esas cosas y estoy un poco fuera de lugar."
    mad "La fête sur la plage, la soirée au club de jazz… Parfois, vous commencez à parler de ces choses-là et je me sens un peu à l’écart."

# game/scripts/c24/c24.rpy:3212
translate french c24s004_Mad_Lis_Emm_a2ed892b:

    # mad "Me hubiera gustado estar, pero hasta la partida de DnD no me sentía parte de esto..."
    mad "J'aurais aimé être là, mais tant que D&D étaient là, je n'avais pas l'impression d'en faire partie..."

# game/scripts/c24/c24.rpy:3214
translate french c24s004_Mad_Lis_Emm_89c7a297:

    # emm "No te preocupes, [mad.nick]. A partir de ahora vendrás siempre que hagamos algo especial."
    emm "Ne t'inquiète pas, [mad.nick]. Désormais, tu viendras chaque fois que nous ferons quelque chose de spécial."

# game/scripts/c24/c24.rpy:3215
translate french c24s004_Mad_Lis_Emm_c4691a62:

    # emm "Estoy pensando que, si tú te sientes así, ¿cómo se van a sentir las chicas que llegan en Septiembre?"
    emm "Je me demande, si vous vous sentez comme ça, comment vont se sentir les filles qui arriveront en septembre ?"

# game/scripts/c24/c24.rpy:3216
translate french c24s004_Mad_Lis_Emm_ea950fdc:

    # mc "Bueno, falta por ver si se integran en la familia tan rápido como..."
    mc "Eh bien, il reste à voir s'ils s'intègrent à la famille aussi rapidement que..."

# game/scripts/c24/c24.rpy:3218
translate french c24s004_Mad_Lis_Emm_13336c01:

    # lis "¿Como nosotras? Estoy segura de que lo harán. [sca] me dijo que una de ellas era amiga suya y de [dap] hace años, que vivía en Newport."
    lis "Vous nous aimez ? J'en suis sûre. [sca] m'a dit que l'une d'elles était une amie à elle et à [dap] d'il y a des années, qui vivait à Newport."

# game/scripts/c24/c24.rpy:3219
translate french c24s004_Mad_Lis_Emm_d2bfd7da:

    # lis "Integrarla a ella en la familia será fácil, y a la prima de [sai] también."
    lis "L'intégrer à la famille sera facile, tout comme le cousin de [sai]."

# game/scripts/c24/c24.rpy:3220
translate french c24s004_Mad_Lis_Emm_73e1891a:

    # mc "¿Quién es la amiga de [dap] y [sca]?"
    mc "Qui est l'ami de [dap] et [sca] ?"

# game/scripts/c24/c24.rpy:3222
translate french c24s004_Mad_Lis_Emm_2006bb97:

    # emm "Patty. No sé si la recuerdas, morena, ojos grandes... era un par de días mayor que [sca]. No era muy amiga mía, pero nos llevábamos bien."
    emm "Patty. Je ne sais pas si tu te souviens d'elle, brune, grands yeux… elle avait quelques jours de plus que [sca]. Ce n'était pas une amie très proche, mais on s'entendait bien."

# game/scripts/c24/c24.rpy:3223
translate french c24s004_Mad_Lis_Emm_c6e65843:

    # emm "Su madre encontró trabajo en Dallas, y se marcharon un año antes de que tú te graduaras."
    emm "Votre mère a trouvé un emploi à Dallas, et ils sont partis un an avant que vous ne soyez diplômé."

# game/scripts/c24/c24.rpy:3224
translate french c24s004_Mad_Lis_Emm_9735c5af:

    # mc "Me suena el nombre, pero no le puedo poner cara."
    mc "Ce nom me dit quelque chose, mais je n'arrive pas à me représenter la personne."

# game/scripts/c24/c24.rpy:3225
translate french c24s004_Mad_Lis_Emm_361c0599:

    # emm "Deberías mirar los expedientes de las chicas nuevas y..."
    emm "Vous devriez consulter les dossiers des nouvelles filles et..."

# game/scripts/c24/c24.rpy:3227
translate french c24s004_Mad_Lis_Emm_7e4f81b9:

    # kim "[mad.nick], ¿me puedes ayudar a...?"
    kim "[mad.nick], pouvez-vous m'aider avec...?"

# game/scripts/c24/c24.rpy:3229
translate french c24s004_Mad_Lis_Emm_1b793e18:

    # kim "¡Oops! Veo que estáis ocupadas. No os preocupéis."
    kim "Oups ! Je vois que vous êtes occupé(e). Ne vous inquiétez pas."

# game/scripts/c24/c24.rpy:3231
translate french c24s004_Mad_Lis_Emm_92ebf9da:

    # kim "Voy a pedirle ayuda a la Abuela..."
    kim "Je vais demander de l'aide à grand-mère..."

# game/scripts/c24/c24.rpy:3233
translate french c24s004_Mad_Lis_Emm_0cf2d20b:

    # mc "¿Qué le pasa?"
    mc "Qu'est-ce qui ne va pas chez lui ?"

# game/scripts/c24/c24.rpy:3234
translate french c24s004_Mad_Lis_Emm_1312c559:

    # emm "¿No la has oído? Ha visto que [mad.nick] está ocupada y..."
    emm "Tu ne l'as pas entendue ? Elle a vu que [mad.nick] était occupé et..."

# game/scripts/c24/c24.rpy:3235
translate french c24s004_Mad_Lis_Emm_4c912813:

    # mad "... Y no ha querido entretenerme por si..."
    mad "…Et il ne voulait pas me garder au cas où…"

# game/scripts/c24/c24.rpy:3236
translate french c24s004_Mad_Lis_Emm_ae12de5d:

    # lis "... Por si estaba haciendo algo importante... supongo..."
    lis "...Au cas où il ferait quelque chose d'important... j'imagine..."

# game/scripts/c24/c24.rpy:3237
translate french c24s004_Mad_Lis_Emm_8fb9d37f:

    # mc "¿Qué me estáis ocultando, chicas?"
    mc "Que me cachez-vous, les filles ?"

# game/scripts/c24/c24.rpy:3239
translate french c24s004_Mad_Lis_Emm_82af4742:

    # lis "¿Nosotras?"
    lis "Nous?"

# game/scripts/c24/c24.rpy:3240
translate french c24s004_Mad_Lis_Emm_54273a9a:

    # emm "¿Qué íbamos a querer ocultarte?"
    emm "Qu'aurions-nous à vous cacher ?"

# game/scripts/c24/c24.rpy:3241
translate french c24s004_Mad_Lis_Emm_c88f9707:

    # mad "Si es algo en lo que puede ayudarle [mee]..." id c24s004_Mad_Lis_Emm_c88f9707
    mad "Si je peux vous aider en quoi que ce soit..." id c24s004_Mad_Lis_Emm_c88f9707

# game/scripts/c24/c24.rpy:3242
translate french c24s004_Mad_Lis_Emm_926339a4:

    # mc "Vale, no os voy a sacar nada, ¿verdad?"
    mc "Bon, je ne vais rien obtenir de vous, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3244
translate french c24s004_Mad_Lis_Emm_358c1155:

    # "Todas" "Nope."
    "Todas" "Non."

# game/scripts/c24/c24.rpy:3245
translate french c24s004_Mad_Lis_Emm_0d14768e:

    # lis "Además, lo dices como si... en el caso de que le pasara algo a [kim]... nosotras supiéramos qué es."
    lis "D'ailleurs, vous le dites comme si... au cas où quelque chose arriverait à [kim]... nous saurions ce que c'est."

# game/scripts/c24/c24.rpy:3246
translate french c24s004_Mad_Lis_Emm_e6e01b5f:

    # emm "Y no estamos diciendo que le pase nada..."
    emm "Et nous ne disons pas qu'il lui arrivera quoi que ce soit de mal..."

# game/scripts/c24/c24.rpy:3247
translate french c24s004_Mad_Lis_Emm_64443da5:

    # mad "Ni que sepamos qué le pasa... si es que le pasa algo. O que te lo fuéramos a decir si lo supiéramos."
    mad "Non pas que nous sachions ce qui ne va pas chez lui… si tant est qu’il ait un problème. Et même si nous le savions, nous ne vous le dirions pas."

# game/scripts/c24/c24.rpy:3248
translate french c24s004_Mad_Lis_Emm_6245c0df:

    # mc "*Risa* Vale, vale. Pero... ¿ha llamado 'Abuela' a Meemaw?"
    mc "*Rires* Bon, d'accord. Mais... est-ce qu'elle a appelé Meemaw « Grand-mère » ?"

# game/scripts/c24/c24.rpy:3250
translate french c24s004_Mad_Lis_Emm_d2f469c8:

    # emm "*Risa* Sí. [kim] está llevando lo de integrarse en la familia a un nuevo nivel. Pero aún no se atreve a llamárselo a ella."
    emm "*Rires* Oui. [kim] pousse l'intégration familiale à un tout autre niveau. Mais il n'ose toujours pas l'appeler."

# game/scripts/c24/c24.rpy:3251
translate french c24s004_Mad_Lis_Emm_07cfc36c:

    # lis "*Risa* El día menos pensado nos empieza a llamar hermanas a todas."
    lis "*Rires* Un de ces jours, il commencera à nous appeler toutes sœurs."

# game/scripts/c24/c24.rpy:3252
translate french c24s004_Mad_Lis_Emm_d9c03e82:

    # mad "*Risa* No dejaría de ser divertido que tantas chicas de razas diferentes nos empezásemos a considerar hermanas algún día."
    mad "*Rires* Ce serait amusant si un jour, tant de filles de races différentes commençaient à se considérer comme des sœurs."

# game/scripts/c24/c24.rpy:3253
translate french c24s004_Mad_Lis_Emm_e2655347:

    # "En ese momento oís una furgoneta y cómo se abre la verja de entrada."
    "À ce moment-là, vous entendez une camionnette et le portail d'entrée s'ouvrir."

# game/scripts/c24/c24.rpy:3256
translate french c24s004_Mad_Lis_Emm_d4ec7df7:

    # emm "Creo que esa es [ama]. Debe venir a buscarte para lo de esta noche."
    emm "Je pense que c'est [ama]. Il devrait venir te chercher ce soir."

# game/scripts/c24/c24.rpy:3257
translate french c24s004_Mad_Lis_Emm_36dfb3ee:

    # mc "Pero es muy pronto para que venga el helicóptero."
    mc "Mais il est trop tôt pour que l'hélicoptère arrive."

# game/scripts/c24/c24.rpy:3258
translate french c24s004_Mad_Lis_Emm_43266a7a:

    # emm "A lo mejor quiere repasar algunos datos."
    emm "Il souhaite peut-être examiner certaines données."

# game/scripts/c24/c24.rpy:3259
translate french c24s004_Mad_Lis_Emm_605d1430:

    # mc "Voy a ver..."
    mc "Je verrai..."

# game/scripts/c24/c24.rpy:3269
translate french c24s004_Mad_Lis_Emm_66e9c8c2:

    # "Te despides de las chicas y te diriges a la furgoneta."
    "Vous dites au revoir aux filles et vous vous dirigez vers la camionnette."

# game/scripts/c24/c24.rpy:3271
translate french c24s004_Mad_Lis_Emm_7a8239e6:

    # "[ama] está sentada dentro, parece que está escribiendo algo."
    "[ama] est assise à l'intérieur, on dirait qu'elle écrit quelque chose."

# game/scripts/c24/c24.rpy:3273
translate french c24s004_Mad_Lis_Emm_d9be006a:

    # "Te acercas a la furgoneta, dispuesto a golpear en la ventanilla."
    "Vous vous approchez de la camionnette, prêt à frapper à la vitre."

# game/scripts/c24/c24.rpy:3274
translate french c24s004_Mad_Lis_Emm_4671c751:

    # ama "Un momento, [mc], por favor."
    ama "Un instant, [mc], s'il vous plaît."

# game/scripts/c24/c24.rpy:3276
translate french c24s004_Mad_Lis_Emm_f63377ab:

    # "Esperas."
    "Vous attendez."

# game/scripts/c24/c24.rpy:3280
translate french c24s004_Kim_Mee_Meg_1657ce25:

    # "Unos minutos antes, en la cocina de [nor]..."
    "Quelques minutes plus tôt, dans la cuisine de [nor]..."

# game/scripts/c24/c24.rpy:3282
translate french c24s004_Kim_Mee_Meg_c653479e:

    # mee "Un día tengo que ir a oírte cantar. Siempre me ha gustado el jazz."
    mee "Il faut absolument que je vienne t'écouter chanter un jour. J'ai toujours adoré le jazz."

# game/scripts/c24/c24.rpy:3283
translate french c24s004_Kim_Mee_Meg_af457e4a:

    # meg "Aunque el sitio se llame Jazz Corner, no solo canto jazz. Tenemos un repertorio muy variado."
    meg "Bien que l'endroit s'appelle Jazz Corner, je ne chante pas que du jazz. Nous avons un répertoire très varié."

# game/scripts/c24/c24.rpy:3285
translate french c24s004_Kim_Mee_Meg_3af7fb04:

    # mee "Bueno, igualmente me gustaría ir. Hace años que no voy a ningún sitio con música en directo."
    mee "Eh bien, j'aimerais toujours y aller. Ça fait des années que je ne suis pas allé quelque part où il y a de la musique en direct."

# game/scripts/c24/c24.rpy:3287
translate french c24s004_Kim_Mee_Meg_ff447e67:

    # meg "¿Ibas mucho cuando...?"
    meg "Tu y allais souvent quand...?"

# game/scripts/c24/c24.rpy:3289
translate french c24s004_Kim_Mee_Meg_1dfbe6a8:

    # mee "*Risa* ¿Cuando era joven?"
    mee "*Rires* Quand j'étais jeune ?"

# game/scripts/c24/c24.rpy:3290
translate french c24s004_Kim_Mee_Meg_441cb2fd:

    # mee "Sí, a John y a mí nos gustaba mucho ir, especialmente antes de casarnos, cuando él aún vivía en San Francisco."
    mee "Oui, John et moi aimions beaucoup y aller, surtout avant notre mariage, lorsqu'il vivait encore à San Francisco."

# game/scripts/c24/c24.rpy:3292
translate french c24s004_Kim_Mee_Meg_ee6c2dee:

    # meg "San Francisco siempre ha tenido buenos clubes de jazz. ¿Teníais algún favorito?"
    meg "San Francisco a toujours eu d'excellents clubs de jazz. En aviez-vous des préférés ?"

# game/scripts/c24/c24.rpy:3294
translate french c24s004_Kim_Mee_Meg_19267300:

    # mee "Sí, el Keystone Korner. Un clásico. Incluso estuvimos allí en un par de ocasiones cuando hicieron grabaciones de directos."
    mee "Oui, le Keystone Korner. Un classique. Nous y étions même à quelques reprises lors d'enregistrements d'émissions en direct."

# game/scripts/c24/c24.rpy:3295
translate french c24s004_Kim_Mee_Meg_fee7d91a:

    # mee "Todavía tengo los vinilos de esas grabaciones."
    mee "J'ai encore les disques vinyles de ces enregistrements."

# game/scripts/c24/c24.rpy:3297
translate french c24s004_Kim_Mee_Meg_add89710:

    # meg "¡Oh! ¡Eso es increíble! ¿De quién son los discos?"
    meg "Oh ! C'est incroyable ! À qui appartiennent ces disques ?"

# game/scripts/c24/c24.rpy:3299
translate french c24s004_Kim_Mee_Meg_050b1da4:

    # mee "Uno es de Tete Montoliu y otro de Jaki Byard, los dos en el '79 o el '80. Son fantásticos."
    mee "L'une est de Tete Montoliu et l'autre de Jaki Byard, toutes deux de 1979 ou 1980. Elles sont fantastiques."

# game/scripts/c24/c24.rpy:3301
translate french c24s004_Kim_Mee_Meg_90e7cdda:

    # meg "¡Me tienes que dejar escucharlos!"
    meg "Vous devez me laisser les écouter !"

# game/scripts/c24/c24.rpy:3302
translate french c24s004_Kim_Mee_Meg_c08e7e22:

    # meg "Me das mucha envidia. ¡Estuviste ahí cuando se escribía historia de la música!"
    meg "Je t'envie tellement. Tu étais là quand l'histoire de la musique s'écrivait !"

# game/scripts/c24/c24.rpy:3304
translate french c24s004_Kim_Mee_Meg_db86b5aa:

    # mee "Bueno, eran otros tiempos. Todo era más artesanal."
    mee "C'était une autre époque. Tout était plus artisanal."

# game/scripts/c24/c24.rpy:3305
translate french c24s004_Kim_Mee_Meg_5a09e21b:

    # mee "Los tengo en la casa de Florida. Te los traeré cuando vaya la semana que viene a poner la casa en venta."
    mee "Je les ai chez moi en Floride. Je vous les apporterai la semaine prochaine quand j'irai mettre la maison en vente."

# game/scripts/c24/c24.rpy:3307
translate french c24s004_Kim_Mee_Meg_efa5a653:

    # meg "Explícame cosas de aquella época, por favor. Es una de mis épocas favoritas de la música."
    meg "Parlez-moi de cette époque, s'il vous plaît. C'est l'une de mes périodes musicales préférées."

# game/scripts/c24/c24.rpy:3309
translate french c24s004_Kim_Mee_Meg_a17d78ab:

    # "Las dos mujeres se enzarzan en una conversación sobre una época pasada de clubs de música donde pasaban cosas importantes."
    "Les deux femmes entament une conversation sur une époque révolue des clubs de musique où se déroulaient des choses importantes."

# game/scripts/c24/c24.rpy:3311
translate french c24s004_Kim_Mee_Meg_8015d8a9:

    # "Un tiempo en el que podías coincidir con músicos famosos en clubs que no estaban abarrotados."
    "Une époque où l'on pouvait rencontrer des musiciens célèbres dans des clubs qui n'étaient pas bondés."

# game/scripts/c24/c24.rpy:3314
translate french c24s004_Kim_Mee_Meg_96cd1768:

    # kim "Hola, [mee]. ¿Qué hay, [meg]?"
    kim "Salut, [mee]. Quoi de neuf, [meg] ?"

# game/scripts/c24/c24.rpy:3315
translate french c24s004_Kim_Mee_Meg_acb33e75:

    # kim "¿Puedo pedirte un favor, [mee]?"
    kim "Puis-je vous demander une faveur, [mee] ?"

# game/scripts/c24/c24.rpy:3317
translate french c24s004_Kim_Mee_Meg_566154d1:

    # mee "Lo que quieras, cielo."
    mee "Tout ce que tu veux, chérie."

# game/scripts/c24/c24.rpy:3318
translate french c24s004_Kim_Mee_Meg_f494511a:

    # meg "¿Qué pasa, [kim]?"
    meg "Quoi de neuf, [kim] ?"

# game/scripts/c24/c24.rpy:3320
translate french c24s004_Kim_Mee_Meg_37bf481f:

    # kim "Al ponerme el uniforme para esta noche lo he roto. Me va un poco apretado..."
    kim "J'ai déchiré mon uniforme en l'enfilant ce soir. Il est un peu trop serré..."

# game/scripts/c24/c24.rpy:3321
translate french c24s004_Kim_Mee_Meg_551c25ce:

    # kim "He intentado coserlo, pero... estoy muy nerviosa y soy incapaz de enhebrar la aguja."
    kim "J'ai essayé de le coudre, mais... je suis très nerveuse et je n'arrive pas à enfiler l'aiguille."

# game/scripts/c24/c24.rpy:3323
translate french c24s004_Kim_Mee_Meg_af0836b9:

    # mee "Dame ese uniforme. Deja que la abuela haga su magia con la aguja."
    mee "Donnez-moi cet uniforme. Laissez grand-mère faire des merveilles avec l'aiguille."

# game/scripts/c24/c24.rpy:3324
translate french c24s004_Kim_Mee_Meg_b57a3de6:

    # mee "¿Hay hilo y aguja en esa bolsa? Siéntate mientras lo coso."
    mee "Y a-t-il du fil et une aiguille dans ce sac ? Asseyez-vous pendant que je le couds."

# game/scripts/c24/c24.rpy:3326
translate french c24s004_Kim_Mee_Meg_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c24/c24.rpy:3327
translate french c24s004_Kim_Mee_Meg_330d4fd8:

    # mee "Ya está cosido. He reforzado alguna de las costuras que parecían más débiles."
    mee "C'est déjà cousu. J'ai renforcé certaines coutures qui semblaient plus fragiles."

# game/scripts/c24/c24.rpy:3328
translate french c24s004_Kim_Mee_Meg_29f1f78b:

    # mee "Ese uniforme estaba muy mal cosido."
    mee "Cet uniforme était très mal cousu."

# game/scripts/c24/c24.rpy:3330
translate french c24s004_Kim_Mee_Meg_b8c3d049:

    # kim "Gracias, [mee]. No sé qué habría hecho sin ti. Voy a probármelo a ver si no rompo nada esta vez."
    kim "Merci, [mee]. Je ne sais pas ce que j'aurais fait sans toi. Je vais essayer et voir si je ne casse rien cette fois-ci."

# game/scripts/c24/c24.rpy:3332
translate french c24s004_Kim_Mee_Meg_c1aba282:

    # meg "Pruébatelo en el baño si quieres y así te lo vemos puesto."
    meg "Essayez-le dans la salle de bain si vous voulez, et on vous verra le porter."

# game/scripts/c24/c24.rpy:3333
translate french c24s004_Kim_Mee_Meg_5dabd8a1:

    # meg "Y [mee] puede repararlo si se rompe alguna otra costura."
    meg "Et [mee] vous pouvez le réparer si une autre couture se casse."

# game/scripts/c24/c24.rpy:3335
translate french c24s004_Kim_Mee_Meg_7c4a90bf:

    # mee "O puedes subir a mi habitación si quieres. O incluso cambiarte aquí."
    mee "Ou tu peux monter dans ma chambre si tu veux. Ou même te changer ici."

# game/scripts/c24/c24.rpy:3336
translate french c24s004_Kim_Mee_Meg_7741ec41:

    # mee "*Risa* Esta cocina ya ha visto a mucha gente desnuda últimamente."
    mee "*Rires* Cette cuisine a vu passer beaucoup de gens nus ces derniers temps."

# game/scripts/c24/c24.rpy:3338
translate french c24s004_Kim_Mee_Meg_fcd06ab9:

    # meg "¿A quién? Creía que la zona nudista era solo en el jacuzzi."
    meg "À qui ? Je croyais que l'espace nudiste se limitait au jacuzzi."

# game/scripts/c24/c24.rpy:3340
translate french c24s004_Kim_Mee_Meg_71aa2cba:

    # kim "Oí que [mc] se había desnudado aquí para poner fin a una discusión sobre la desnudez el día del secuestro."
    kim "J'ai entendu dire que [mc] s'était déshabillé ici pour mettre fin à une dispute à propos de la nudité le jour de l'enlèvement."

# game/scripts/c24/c24.rpy:3341
translate french c24s004_Kim_Mee_Meg_393174ef:

    # kim "A veces tiene unos métodos... extraños..."
    kim "Parfois, il a des méthodes... étranges..."

# game/scripts/c24/c24.rpy:3342
translate french c24s004_Kim_Mee_Meg_d05e16a5:

    # kim "Dame la bolsa. [mc] está ocupado en la piscina y el resto somos todas chicas. Voy a cambiarme en ese rincón."
    kim "Donne-moi le sac. [mc] est occupée dans la piscine et nous autres, on est toutes des filles. Je vais me changer dans ce coin."

# game/scripts/c24/c24.rpy:3344
translate french c24s004_Kim_Mee_Meg_0c47b986:

    # meg "¿Es eso cierto? ¿[mc] se desnudó durante el secuestro?"
    meg "Est-ce vrai ? S'est-elle déshabillée pendant l'enlèvement ?"

# game/scripts/c24/c24.rpy:3346
translate french c24s004_Kim_Mee_Meg_9c24b532:

    # mee "*Risa* No, [mc] lo hizo después del secuestro. Me estaba comportando como una idiota y me puso en mi sitio."
    mee "*Rires* Non, [mc] l'a fait après l'enlèvement. Je me comportais comme un idiot et il m'a remis à ma place."

# game/scripts/c24/c24.rpy:3347
translate french c24s004_Kim_Mee_Meg_e869658b:

    # mee "*Risa* La que se desnudó durante el secuestro fui yo. O más bien, ya estaba desnuda pero dejé caer la toalla."
    mee "*Rires* C'est moi qui me suis déshabillée pendant l'enlèvement. Enfin, j'étais déjà nue, mais j'ai laissé tomber ma serviette."

# game/scripts/c24/c24.rpy:3349
translate french c24s004_Kim_Mee_Meg_ce6e31d7:

    # kim "Tía [bet] me lo contó. Fuiste muy valiente y sirvió para que los secuestradores se despistaran y [eva] pudiera entrar."
    kim "Ma tante me l'a dit. Tu as été très courageuse, et cela a permis de semer les ravisseurs et de me laisser entrer."

# game/scripts/c24/c24.rpy:3351
translate french c24s004_Kim_Mee_Meg_5881d1d8:

    # meg "¡Esperad! Había oído lo del secuestro, pero no me había enterado de nada de eso..."
    meg "Attendez ! J'avais entendu parler de l'enlèvement, mais pas des détails..."

# game/scripts/c24/c24.rpy:3352
translate french c24s004_Kim_Mee_Meg_0e4a078c:

    # meg "¡Me lo tenéis que explicar todo!"
    meg "Vous devez tout m'expliquer !"

# game/scripts/c24/c24.rpy:3354
translate french c24s004_Kim_Mee_Meg_435c2cc6:

    # "Mientras [mee] pone en antecedentes a [meg], [kim] se prueba el uniforme para el evento de la noche."
    "Pendant que [mee] prépare le terrain pour [meg], [kim] essaie l'uniforme pour l'événement de la soirée."

# game/scripts/c24/c24.rpy:3357
translate french c24s004_Kim_Mee_Meg_04f6548a:

    # kim "¡Ha quedado genial, [mee]! ¡Muchas gracias!"
    kim "C'est magnifique, [mee] ! Merci beaucoup !"

# game/scripts/c24/c24.rpy:3359
translate french c24s004_Kim_Mee_Meg_43720c20:

    # meg "¡Estás monísima con ese uniforme!"
    meg "Tu es adorable dans cet uniforme !"

# game/scripts/c24/c24.rpy:3360
translate french c24s004_Kim_Mee_Meg_c1f18785:

    # mee "Es super gracioso. Pareces salida de una película de Corea o Vietnam, cuando las actrices y cantantes se vestían de militares para apoyar a las tropas."
    mee "C'est hilarant. On dirait que tu sors tout droit d'un film sur la guerre de Corée ou du Vietnam, à l'époque où les actrices et les chanteuses se déguisaient en soldats pour soutenir les troupes."

# game/scripts/c24/c24.rpy:3362
translate french c24s004_Kim_Mee_Meg_fefc7116:

    # kim "La verdad es que es muy chulo. Tengo ganas de hacer este evento. El yate es increíble."
    kim "C'est vraiment génial. J'ai hâte d'y être. Le yacht est incroyable."

# game/scripts/c24/c24.rpy:3364
translate french c24s004_Kim_Mee_Meg_ca9e7bac:

    # kim "Ahora solo necesito llamar a un Under para que me lleve a Westport."
    kim "Il ne me reste plus qu'à appeler un Under pour qu'il m'emmène à Westport."

# game/scripts/c24/c24.rpy:3366
translate french c24s004_Kim_Mee_Meg_d27e5cac:

    # meg "¿Dónde de Westport tienes que ir y a qué hora tienes que estar?"
    meg "Où exactement à Westport devez-vous vous rendre et à quelle heure devez-vous y être ?"

# game/scripts/c24/c24.rpy:3367
translate french c24s004_Kim_Mee_Meg_ef69494f:

    # meg "Te podría llevar yo antes de ir al club."
    meg "Je pourrais t'emmener avant d'aller en boîte."

# game/scripts/c24/c24.rpy:3369
translate french c24s004_Kim_Mee_Meg_75c4ea81:

    # "Las tres mujeres pasan un rato hablando sobre el trabajo de [kim] y geografía de Westport."
    "Les trois femmes passent un certain temps à parler du travail de [kim] et de la géographie de Westport."

# game/scripts/c24/c24.rpy:3370
translate french c24s004_Kim_Mee_Meg_04244bf3:

    # "También hablan de la familia y de los planes que tiene cada una de ellas."
    "Ils parlent aussi de leur famille et des projets de chacun."

# game/scripts/c24/c24.rpy:3371
translate french c24s004_Kim_Mee_Meg_2fd41570:

    # "[kim] llama 'Abuela' un par de veces a [mee]."
    "[kim] appelle [mee] 'Grand-mère' à quelques reprises."

# game/scripts/c24/c24.rpy:3373
translate french c24s004_Kim_Mee_Meg_5b8e52db:

    # "Ninguna de ellas se da cuenta."
    "Aucun d'eux ne s'en rend compte."

# game/scripts/c24/c24.rpy:3381
translate french c24s005_Ama_ee6ec8ff:

    # "De vuelta en la furgoneta..."
    "De retour dans la camionnette..."

# game/scripts/c24/c24.rpy:3383
translate french c24s005_Ama_f22882bc:

    # ama "Disculpa, tenía que acabar de escribir algo que tienes que firmar."
    ama "Excusez-moi, je devais terminer un document que vous devez signer."

# game/scripts/c24/c24.rpy:3384
translate french c24s005_Ama_f5b226b8:

    # mc "¿Qué es?"
    mc "Qu'est-ce que c'est?"

# game/scripts/c24/c24.rpy:3386
translate french c24s005_Ama_c65a50a2:

    # ama "Aquí no. Te lo explico en tu habitación."
    ama "Pas ici. Je te l'expliquerai dans ta chambre."

# game/scripts/c24/c24.rpy:3387
translate french c24s005_Ama_aed47ba9:

    # mc "¡Qué misteriosa! Pero es muy pronto para que venga el helicóptero ¿no?"
    mc "Quel mystère ! Mais il est trop tôt pour que l'hélicoptère arrive, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3389
translate french c24s005_Ama_98187efb:

    # ama "No va a venir aquí. No quieres que Iron Fist sepa dónde vives, ¿verdad?"
    ama "Il ne viendra pas ici. Vous ne voulez pas qu'Iron Fist sache où vous habitez, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3390
translate french c24s005_Ama_f29cba8a:

    # mc "Si tienen mi teléfono, supongo que también tienen mi dirección."
    mc "S'ils ont mon numéro de téléphone, je suppose qu'ils ont aussi mon adresse."

# game/scripts/c24/c24.rpy:3392
translate french c24s005_Ama_13ff6026:

    # ama "En tu ficha de empleado de NTR figura tu teléfono, pero tu dirección es de San Luis Obispo."
    ama "Votre dossier d'employé NTR indique votre numéro de téléphone, mais votre adresse se trouve à San Luis Obispo."

# game/scripts/c24/c24.rpy:3393
translate french c24s005_Ama_b4118369:

    # ama "*Risa* Vives en el campo de beisbol de la universidad. Por si teníamos algún topo."
    ama "*Rires* Tu habites sur le terrain de baseball de l'université. Au cas où on aurait une taupe."

# game/scripts/c24/c24.rpy:3394
translate french c24s005_Ama_a01d843a:

    # mc "*Risa* Espero que sea debajo de las gradas o me mojaré cuando llueva."
    mc "*Rires* J'espère que c'est sous les gradins, sinon je serai trempé quand il pleuvra."

# game/scripts/c24/c24.rpy:3395
translate french c24s005_Ama_e8a1b105:

    # mc "¿Dónde va a ir a buscarnos el helicóptero, entonces?"
    mc "Où l'hélicoptère va-t-il venir nous chercher ?"

# game/scripts/c24/c24.rpy:3397
translate french c24s005_Ama_3cb607a6:

    # ama "Hemos alquilado un campo de tiro todo el fin de semana. Mañana por la tarde [eva] enseñará a disparar a algunas chicas."
    ama "Nous avons loué un stand de tir pour tout le week-end. Demain après-midi, je donnerai un cours de tir à des filles."

# game/scripts/c24/c24.rpy:3398
translate french c24s005_Ama_325b4e17:

    # ama "El helicóptero nos recogerá allí en cuatro horas."
    ama "L'hélicoptère viendra nous chercher là-bas dans quatre heures."

# game/scripts/c24/c24.rpy:3399
translate french c24s005_Ama_827d0a03:

    # mc "OK. Voy a ducharme."
    mc "OK. Je vais prendre une douche."

# game/scripts/c24/c24.rpy:3401
translate french c24s005_Ama_8f56740e:

    # ama "Voy a saludar a [mar] y te veo en 15 minutos en tu habitación."
    ama "Je vais saluer [mar] et je te rejoins dans 15 minutes dans ta chambre."

# game/scripts/c24/c24.rpy:3402
translate french c24s005_Ama_525112d5:

    # mc "¿15 minutos? Acabo de decir que me tenía que duchar. ¡Tenemos cuatro horas!"
    mc "15 minutes ? Je viens de dire que je devais prendre une douche. Nous avons quatre heures !"

# game/scripts/c24/c24.rpy:3403
translate french c24s005_Ama_7deaa528:

    # ama "*Risa* La última vez que te espié duchándote, no eras tan lento como [emm]. ¿Te tienes que maquillar y depilar las piernas?"
    ama "*Rires* La dernière fois que je t'ai espionnée sous la douche, tu n'étais pas aussi lente que [emm]. Tu dois te maquiller et te raser les jambes ?"

# game/scripts/c24/c24.rpy:3404
translate french c24s005_Ama_d1f01a44:

    # mc "*Risa* Vale, 15 minutos ¿Qué llevas en esa bolsa?"
    mc "*Rires* Bon, 15 minutes. Qu'est-ce que tu as dans ce sac ?"

# game/scripts/c24/c24.rpy:3405
translate french c24s005_Ama_1ca49a82:

    # ama "Lo que vas a firmar y lo que te vas a poner."
    ama "Ce que vous allez signer et ce que vous allez porter."

# game/scripts/c24/c24.rpy:3407
translate french c24s005_Ama_738d9a61:

    # "15 minutos después..."
    "15 minutes plus tard..."

# game/scripts/c24/c24.rpy:3408
translate french c24s005_Ama_2dcb8dae:

    # mc "Ya estoy aquí. ¿Qué querías que firmara? ¿Y por qué tanta prisa?"
    mc "Me voilà. Que vouliez-vous que je signe ? Et pourquoi cette précipitation ?"

# game/scripts/c24/c24.rpy:3411
translate french c24s005_Ama_1eadca4e:

    # "[ama] se levanta y te da un tierno beso."
    "[ama] se lève et vous donne un tendre baiser."

# game/scripts/c24/c24.rpy:3413
translate french c24s005_Ama_a4e24b27:

    # ama "Primero, mis labios..."
    ama "D'abord, mes lèvres..."

# game/scripts/c24/c24.rpy:3414
translate french c24s005_Ama_d9236e6a:

    # mc "Me parece la forma ideal de empezar una reunión de trabajo."
    mc "Je pense que c'est la manière idéale de commencer une réunion de travail."

# game/scripts/c24/c24.rpy:3416
translate french c24s005_Ama_d0b258b1:

    # ama "*Risa* Espero que no hagas lo mismo con Ichigo esta noche."
    ama "*Rires* J'espère que tu ne feras pas la même chose à Ichigo ce soir."

# game/scripts/c24/c24.rpy:3417
translate french c24s005_Ama_8d80c347:

    # mc "No, eso solo lo hago con mercenarias rubias."
    mc "Non, je ne fais ça qu'avec des mercenaires blondes."

# game/scripts/c24/c24.rpy:3418
translate french c24s005_Ama_a7fbeadb:

    # ama "*Risa* Que no te oiga [eva]."
    ama "*Rires* Ne le laisse pas t'entendre [eva]."

# game/scripts/c24/c24.rpy:3420
translate french c24s005_Ama_de43ceea:

    # "[ama] se gira para sacar algo de la bolsa de viaje que ha traído."
    "[ama] se retourne pour sortir quelque chose du sac de voyage qu'elle a apporté."

# game/scripts/c24/c24.rpy:3421
translate french c24s005_Ama_3fef17f8:

    # "Las vistas son excelentes."
    "La vue est magnifique."

# game/scripts/c24/c24.rpy:3423
translate french c24s005_Ama_9b4bf20c:

    # ama "Lo siguiente que tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "Le prochain document à signer est celui-ci. Aujourd'hui est votre premier jour en tant que PDG et le premier document que vous signerez."

# game/scripts/c24/c24.rpy:3426
translate french c24s005_Ama_c3551559:

    # ama "Dame un segundo."
    ama "Donnez-moi une seconde."

# game/scripts/c24/c24.rpy:3427
translate french c24s005_Ama_85ade774:

    # "[ama] se agacha para sacar algo de la bolsa de viaje que ha traído."
    "[ama] se penche pour sortir quelque chose du sac de voyage qu'elle a apporté."

# game/scripts/c24/c24.rpy:3429
translate french c24s005_Ama_f3f3881d:

    # ama "Tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "Vous devez signer ceci. Aujourd'hui est votre premier jour en tant que PDG et le premier document que vous allez signer."

# game/scripts/c24/c24.rpy:3431
translate french c24s005_Ama_3bca18c7:

    # "[ama] te entrega un papel escrito a mano, con varios tachones."
    "[ama] vous tend un papier manuscrit, avec plusieurs mots barrés."

# game/scripts/c24/c24.rpy:3441
translate french c24s005_Ama_15062ef8:

    # "Carta de autorización"
    "Lettre d'autorisation"

# game/scripts/c24/c24.rpy:3442
translate french c24s005_Ama_92f35414:

    # "Como CEO de NTR, por la presente autorizo a la Srta. Gilford a realizar un estudio exhaustivo de las necesidades"
    "En tant que PDG de NTR, j'autorise par la présente Mme Gilford à procéder à une évaluation approfondie des besoins."

# game/scripts/c24/c24.rpy:3443
translate french c24s005_Ama_55b4d0ec:

    # "y requisitos pertinentes para establecer la Beca NTR para el próximo año académico."
    "et les exigences pertinentes pour l'établissement de la bourse NTR pour la prochaine année universitaire."

# game/scripts/c24/c24.rpy:3444
translate french c24s005_Ama_105a3ed5:

    # "Esta beca {s}del programa{/s} tiene como objetivo apoyar a los nadadores de Newport que han decidido abandonar la natación de competición"
    "Cette bourse du programme vise à soutenir les nageurs de Newport qui ont décidé de quitter la natation de compétition."

# game/scripts/c24/c24.rpy:3445
translate french c24s005_Ama_7e68bbd5:

    # "y {s}desean{/s} aspiran a convertirse en entrenadores de natación."
    "et {s}veulent{/s} devenir entraîneurs de natation."

# game/scripts/c24/c24.rpy:3446
translate french c24s005_Ama_5e0df578:

    # "A la Srta. Gilford se le confían las siguientes responsabilidades:"
    "Mlle Gilford se voit confier les responsabilités suivantes :"

# game/scripts/c24/c24.rpy:3447
translate french c24s005_Ama_f6a40645:

    # "*Realizar una evaluación exhaustiva para determinar los criterios y requisitos específicos para {s}la{/s} esta nueva beca."
    "*Procéder à une évaluation approfondie afin de déterminer les critères et exigences spécifiques de cette nouvelle bourse."

# game/scripts/c24/c24.rpy:3448
translate french c24s005_Ama_e1fac448:

    # "*Interactuar con posibles {s}estudiantes{/s} candidatos para comprender sus motivaciones, desafíos y aspiraciones en la transición de nadadores a entrenadores."
    "*Interagir avec les candidats étudiants potentiels pour comprendre leurs motivations, leurs défis et leurs aspirations dans la transition de nageurs à entraîneurs."

# game/scripts/c24/c24.rpy:3449
translate french c24s005_Ama_6f084748:

    # "*Colaborar con clubes de natación locales, instituciones educativas y partes interesadas relevantes para desarrollar un marco de becas sólido."
    "*Collaborer avec les clubs de natation locaux, les établissements d'enseignement et les parties prenantes concernées afin de développer un cadre de bourses d'études solide."

# game/scripts/c24/c24.rpy:3450
translate french c24s005_Ama_504d1964:

    # "*Asegurarse de que la beca proporcione el apoyo financiero, los recursos y las oportunidades de desarrollo profesional adecuados para los candidatos seleccionados."
    "*Veiller à ce que la bourse offre un soutien financier adéquat, des ressources et des possibilités de perfectionnement professionnel aux candidats sélectionnés."

# game/scripts/c24/c24.rpy:3451
translate french c24s005_Ama_f54b3c12:

    # "Se espera que la Srta. Gilford presente sus conclusiones y recomendaciones en los próximos tres días,"
    "Mme Gilford devrait présenter ses conclusions et recommandations dans les trois prochains jours."

# game/scripts/c24/c24.rpy:3452
translate french c24s005_Ama_bb1971f7:

    # "tras lo cual se desarrollará la estructura final y el plan de implementación de la Beca NTR."
    "Suite à cela, la structure finale et le plan de mise en œuvre de la bourse NTR seront élaborés."

# game/scripts/c24/c24.rpy:3453
translate french c24s005_Ama_0419c24d:

    # "Esta autorización entra en vigor inmediatamente y permanecerá vigente hasta la finalización del proyecto."
    "Cette autorisation prend effet immédiatement et restera en vigueur jusqu'à l'achèvement du projet."

# game/scripts/c24/c24.rpy:3454
translate french c24s005_Ama_29859d0b:

    # "Firmado:"
    "Signé :"

# game/scripts/c24/c24.rpy:3455
translate french c24s005_Ama_31adcaef:

    # "[mc] Marks"
    "[mc] Marques"

# game/scripts/c24/c24.rpy:3456
translate french c24s005_Ama_eae190af:

    # "CEO de NTR"
    "PDG de NTR"

# game/scripts/c24/c24.rpy:3460
translate french c24s005_Ama_220637b1:

    # mc "Esto es la creación de una beca hecha a medida para [sim]. 'Nadadores de Newport que han decidido abandonar la natación de competición y aspiran a convertirse en entrenadores'."
    mc "Il s'agit de la création d'une bourse sur mesure pour [sim]. 'les nageurs de Newport qui ont décidé de quitter la natation de compétition et aspirent à devenir entraîneurs'."

# game/scripts/c24/c24.rpy:3461
translate french c24s005_Ama_1856ed1b:

    # ama "He oído vuestra conversación en la piscina y he creído que, con todo el mal que ha hecho NTR, es hora de que haga algo bueno."
    ama "J'ai surpris votre conversation à la piscine et je me suis dit qu'avec tout le mal que NTR a fait, il est temps qu'il fasse quelque chose de bien."

# game/scripts/c24/c24.rpy:3462
translate french c24s005_Ama_1fadd701:

    # mc "Pero puedes hacer esto sin mi autorización. Tú también eres accionista."
    mc "Mais vous pouvez le faire sans mon autorisation. Vous êtes actionnaire vous aussi."

# game/scripts/c24/c24.rpy:3464
translate french c24s005_Ama_0434ed66:

    # ama "Todavía no tengo un cargo oficial en NTR, con lo que no puedo hacerlo. Tiene que ser todo legal si queremos que la empresa evolucione, [mc]."
    ama "Je n'occupe pas encore de poste officiel chez NTR, je ne peux donc pas le faire. Tout doit être légal si nous voulons que l'entreprise évolue."

# game/scripts/c24/c24.rpy:3465
translate french c24s005_Ama_2ae863ca:

    # ama "La estaba acabando de escribir en la furgoneta. De ahí los tachones."
    ama "Je terminais de l'écrire dans la camionnette. D'où les mots barrés."

# game/scripts/c24/c24.rpy:3466
translate french c24s005_Ama_42507974:

    # mc "*Risa* Le quitan un punto de oficialidad, pero supongo que es igual de legal."
    mc "*Rires* Ça leur enlève un point de statut officiel, mais j'imagine que c'est tout aussi légal."

# game/scripts/c24/c24.rpy:3467
translate french c24s005_Ama_ade9dc87:

    # mc "Y tú vuelves a demostrar que eres una mujer increíble."
    mc "Et vous prouvez une fois de plus que vous êtes une femme incroyable."

# game/scripts/c24/c24.rpy:3468
translate french c24s005_Ama_88b0999c:

    # "Firmas el documento."
    "Vous signez le document."

# game/scripts/c24/c24.rpy:3470
translate french c24s005_Ama_409b61d4:

    # ama "Gracias, pero no hay nada que no estuviera dispuesta a hacer por esta familia."
    ama "Merci, mais il n'y a rien que je ne serais pas prêt à faire pour cette famille."

# game/scripts/c24/c24.rpy:3471
translate french c24s005_Ama_8f570b82:

    # ama "Haga lo que haga, nunca os podré devolver lo que me estáis dando vosotros."
    ama "Quoi que je fasse, je ne pourrai jamais vous rembourser ce que vous me donnez."

# game/scripts/c24/c24.rpy:3472
translate french c24s005_Ama_38dcce63:

    # mc "La familia no es un negocio, [ama]. No hay que pesar lo que se da o se recibe. Pero tú estás dando mucho."
    mc "La famille n'est pas une entreprise. Il ne faut pas compter ce que l'on donne ou ce que l'on reçoit. Mais tu donnes beaucoup."

# game/scripts/c24/c24.rpy:3476
translate french c24s005_Ama_f3231476:

    # ama "Y lo siguiente es lo que te vas a poner esta tarde."
    ama "Voici ce que vous allez porter cet après-midi."

# game/scripts/c24/c24.rpy:3477
translate french c24s005_Ama_4a49ef0b:

    # mcp "(Como siempre, cambiando de tema en el momento en que alguien la alaba. Al menos esta vez sonríe.)"
    mcp "(Comme toujours, elle change de sujet dès qu'on la complimente. Au moins, cette fois-ci, elle sourit.)"

# game/scripts/c24/c24.rpy:3478
translate french c24s005_Ama_c607143e:

    # mc "¿Mis trajes no son adecuados para la reunión con Iron Fist?"
    mc "Mes costumes ne sont-ils pas appropriés pour une rencontre avec Iron Fist ?"

# game/scripts/c24/c24.rpy:3480
translate french c24s005_Ama_ce59d6cf:

    # ama "Sí, y ahora me darás uno. El que te pondrás esta noche."
    ama "Oui, et maintenant tu vas m'en donner une. Celle que tu porteras ce soir."

# game/scripts/c24/c24.rpy:3481
translate french c24s005_Ama_eb603de7:

    # mc "No lo entiendo. ¿Me traes un traje para la tarde y yo te doy uno para la noche? ¿Me voy a cambiar en el yate?"
    mc "Je ne comprends pas. Vous m'apportez un costume pour l'après-midi et je vous en donne un pour le soir ? Je vais me changer sur le yacht ?"

# game/scripts/c24/c24.rpy:3483
translate french c24s005_Ama_92867519:

    # ama "¿No has hablado con [eva]?"
    ama "N'as-tu pas parlé à [eva] ?"

# game/scripts/c24/c24.rpy:3484
translate french c24s005_Ama_9e545ae0:

    # mc "Hoy no. ¿Por qué?"
    mc "Pas aujourd'hui. Pourquoi ?"

# game/scripts/c24/c24.rpy:3485
translate french c24s005_Ama_1ac21101:

    # ama "Te tenía que haber llamado esta mañana."
    ama "J'aurais dû t'appeler ce matin."

# game/scripts/c24/c24.rpy:3486
translate french c24s005_Ama_38fa9700:

    # mc "He dormido hasta tarde y me quedé sin batería anoche. Lo he puesto a cargar cuando me he levantado. Ni siquiera lo he encendido aún."
    mc "J'ai fait la grasse matinée et ma batterie s'est déchargée la nuit dernière. Je l'ai branchée pour la recharger en me réveillant. Je ne l'ai même pas encore allumée."

# game/scripts/c24/c24.rpy:3488
translate french c24s005_Ama_7478643a:

    # ama "Eso lo explica todo."
    ama "Voilà qui explique tout."

# game/scripts/c24/c24.rpy:3489
translate french c24s005_Ama_1b5b5f4b:

    # ama "Vas a hacer prácticas de tiro con [eva] antes de ir a la reunión. Dice que no has practicado más después del primer día en el bosque."
    ama "Tu vas t'entraîner au tir avec le D6 avant la réunion. Il est indiqué que tu n'as pas pratiqué depuis le premier jour en forêt."

# game/scripts/c24/c24.rpy:3490
translate french c24s005_Ama_e2d41494:

    # mc "¿Por eso habéis alquilado el campo de tiro?"
    mc "C'est pour ça que vous avez loué le stand de tir ?"

# game/scripts/c24/c24.rpy:3492
translate french c24s005_Ama_147bd032:

    # ama "Por eso, para enseñar a las chicas a disparar, y para que venga el helicóptero a buscarnos."
    ama "C'est pourquoi, pour apprendre aux filles à tirer, et pour que l'hélicoptère puisse venir nous chercher."

# game/scripts/c24/c24.rpy:3495
translate french c24s005_Ama_8c75a391:

    # ama "[eva] quería pasar un rato a solas contigo. Ella no lo llama cita sino entrenamiento."
    ama "[eva] Je voulais passer un peu de temps seule avec toi. Elle n'appelle pas ça un rendez-vous, mais un entraînement."

# game/scripts/c24/c24.rpy:3496
translate french c24s005_Ama_26751aa9:

    # ama "Pero no lo dudes. Es una cita. Con armas en vez de con comida o vino."
    ama "Mais ne vous y trompez pas. C'est un rendez-vous. Avec des armes à feu au lieu de nourriture ou de vin."

# game/scripts/c24/c24.rpy:3497
translate french c24s005_Ama_6c430bd0:

    # mc "¿No crees que me lo debería haber preguntado antes a mí?"
    mc "Ne pensez-vous pas qu'il aurait dû me demander la permission en premier ?"

# game/scripts/c24/c24.rpy:3499
translate french c24s005_Ama_e48042ab:

    # ama "*Risa* Si no te hubieras quedado sin batería o lo hubieras encendido..."
    ama "*Rires* Si ta batterie n'était pas à plat ou si tu l'avais allumé..."

# game/scripts/c24/c24.rpy:3500
translate french c24s005_Ama_3069ddbb:

    # mc "*Risa* Touché."
    mc "*Rires* Touché."

# game/scripts/c24/c24.rpy:3501
translate french c24s005_Ama_28d7ea60:

    # mc "¿Qué tengo que ponerme para la cita?"
    mc "Que dois-je porter pour ce rendez-vous ?"

# game/scripts/c24/c24.rpy:3503
translate french c24s005_Ama_a580d8cf:

    # ama "Lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "Qu'y a-t-il dans le sac ? Je t'attendrai dehors pendant que tu te changes."

# game/scripts/c24/c24.rpy:3505
translate french c24s005_Ama_0ecf28f9:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Vous savez que ce n'est pas nécessaire, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3507
translate french c24s005_Ama_509365cd:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la cita con [eva]."
    ama "*Rires* Si tu te déshabilles devant moi, tu risques de rater ton rendez-vous avec [eva]."

# game/scripts/c24/c24.rpy:3508
translate french c24s005_Ama_208599b9:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Rires* Et il me le fera probablement payer. Atrocement. Pendant mon sommeil."

# game/scripts/c24/c24.rpy:3510
translate french c24s005_Ama_e79e417a:

    # mc "OK. En dos minutos estaré vestido."
    mc "OK. Je serai habillé dans deux minutes."

# game/scripts/c24/c24.rpy:3514
translate french c24s005_Ama_1bdbea1e:

    # ama "Ponte lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "Mets ce qu'il y a dans le sac. Je t'attendrai dehors pendant que tu te changes."

# game/scripts/c24/c24.rpy:3516
translate french c24s005_Ama_0ecf28f9_1:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Vous savez que ce n'est pas nécessaire, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:3518
translate french c24s005_Ama_047ab889:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la clase de tiro con [eva]."
    ama "*Rires* Si tu te déshabilles devant moi, tu risques de ne pas pouvoir aller au cours de tir avec [eva]."

# game/scripts/c24/c24.rpy:3519
translate french c24s005_Ama_208599b9_1:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Rires* Et il me le fera probablement payer. Atrocement. Pendant mon sommeil."

# game/scripts/c24/c24.rpy:3521
translate french c24s005_Ama_e79e417a_1:

    # mc "OK. En dos minutos estaré vestido."
    mc "OK. Je serai habillé dans deux minutes."

# game/scripts/c24/c24.rpy:3523
translate french c24s005_Ama_dda3e113:

    # ama "Saca el traje que te vas a poner para el yate."
    ama "Sortez le costume que vous allez porter sur le yacht."

# game/scripts/c24/c24.rpy:3525
translate french c24s005_Ama_0d0a47eb:

    # "Dos minutos después..."
    "Deux minutes plus tard..."

# game/scripts/c24/c24.rpy:3526
translate french c24s005_Ama_1a08177b:

    # mc "[ama], ya estoy vestido. Aunque no entiendo para qué necesito esto..."
    mc "[ama], je suis déjà habillé(e). Même si je ne comprends pas pourquoi j'ai besoin de ça..."

# game/scripts/c24/c24.rpy:3528
translate french c24s005_Ama_cac620c4:

    # ama "*Risa* ¡Estás ridículo!"
    ama "*Rires* Tu as l'air ridicule !"

# game/scripts/c24/c24.rpy:3529
translate french c24s005_Ama_b2246951:

    # mc "*Risa* Lo sé. Más que a practicar tiro, parece que voy a hacer una carrera en Laguna Seca."
    mc "*Rires* Je sais. On dirait plus que je vais à une course à Laguna Seca qu'à un entraînement de tir."

# game/scripts/c24/c24.rpy:3532
translate french c24s005_Ama_027cb8e1:

    # ama "*Risa* Bueno, esa es la otra parte de la cita con [eva]."
    ama "*Rires* Eh bien, c'est l'autre aspect du rendez-vous avec [eva]."

# game/scripts/c24/c24.rpy:3533
translate french c24s005_Ama_736e1139:

    # ama "¿Has montado en moto alguna vez?"
    ama "Avez-vous déjà conduit une moto ?"

# game/scripts/c24/c24.rpy:3534
translate french c24s005_Ama_cc761816:

    # mc "No..."
    mc "Non..."

# game/scripts/c24/c24.rpy:3536
translate french c24s005_Ama_30e93606:

    # ama "Pues hoy va a ser tu primera vez. [eva] quería que fueras seguro. El traje lo ha elegido ella."
    ama "Eh bien, aujourd'hui ce sera ta première fois. [eva] Je voulais que tu sois sûre. Elle a choisi le tailleur."

# game/scripts/c24/c24.rpy:3537
translate french c24s005_Ama_0d907c5a:

    # ama "Es uno de los trajes de skydiving de NTR. Era lo más adecuado que teníamos para ti."
    ama "C'est l'une des combinaisons de parachutisme de NTR. C'était la meilleure que nous avions pour vous."

# game/scripts/c24/c24.rpy:3538
translate french c24s005_Ama_4058bc50:

    # mc "¿No vamos a ir en la furgoneta al campo de tiro?"
    mc "On ne va pas au stand de tir en camionnette ?"

# game/scripts/c24/c24.rpy:3540
translate french c24s005_Ama_6c2bceab:

    # ama "No, te lleva [eva]. Yo me quedaré con [mar] y [nor], pasando la tarde hasta que se acerque la hora de que llegue el helicóptero."
    ama "Non, il faut [eva]. Je vais rester avec [mar] et [nor], en attendant l'arrivée de l'hélicoptère."

# game/scripts/c24/c24.rpy:3541
translate french c24s005_Ama_5eda9e51:

    # mc "*Risa* Es decir, motos y armas. ¿Alguna cosa peligrosa más?"
    mc "*Rires* Je veux dire, les motos et les armes à feu. Y a-t-il autre chose de dangereux ?"

# game/scripts/c24/c24.rpy:3543
translate french c24s005_Ama_e6a8262e:

    # ama "*Risa* [eva]."
    ama "*Rires* [eva]."

# game/scripts/c24/c24.rpy:3544
translate french c24s005_Ama_a1e0e3b7:

    # mc "*Risa* No me da miedo. Seguramente porque no soy capaz de imaginar la mitad de las cosas que puede hacerme."
    mc "*Rires* Je n'ai pas peur. Sans doute parce que je n'arrive même pas à imaginer la moitié de ce qu'il pourrait me faire."

# game/scripts/c24/c24.rpy:3545
translate french c24s005_Ama_4bcaaf83:

    # mc "Bueno, las armas tampoco después del primer entrenamiento. Y las motos..."
    mc "Eh bien, les armes n'étaient pas performantes après la première séance d'entraînement non plus. Et les motos…"

# game/scripts/c24/c24.rpy:3548
translate french c24s005_Ama_e7521246:

    # "Suena una moto a toda velocidad por la carretera, todavía lejos."
    "On entend, encore au loin, le bruit d'une moto qui file à toute allure sur la route."

# game/scripts/c24/c24.rpy:3549
translate french c24s005_Ama_c629957a:

    # ama "Creo que la tuya está llegando."
    ama "Je pense que le vôtre arrive."

# game/scripts/c24/c24.rpy:3550
translate french c24s005_Ama_83b2b023:

    # mc "Te veo luego, entonces."
    mc "À plus tard alors."

# game/scripts/c24/c24.rpy:3551
translate french c24s005_Ama_162ef4fb:

    # ama "Sí, cuando falten 20 minutos para que llegue el helicóptero, iré al campo de tiro. Así tienes tiempo de cambiarte."
    ama "Oui, quand il restera 20 minutes avant l'arrivée de l'hélicoptère, j'irai au stand de tir. Comme ça, tu auras le temps de te changer."

# game/scripts/c24/c24.rpy:3554
translate french c24s005_Ama_18f5f726:

    # "[ama] se despide de ti con otro tierno beso."
    "[ama] vous dit au revoir avec un autre tendre baiser."

# game/scripts/c24/c24.rpy:3555
translate french c24s005_Ama_689458b3:

    # ama "Te veo luego."
    ama "À plus tard."

# game/scripts/c24/c24.rpy:3558
translate french c24s005_Ama_5b63b58c:

    # "Mientras bajas las escaleras, enciendes el móvil. Tienes 32 llamadas perdidas de [eva]. Y 24 mensajes de texto."
    "En descendant les escaliers, vous allumez votre téléphone. Vous avez 32 appels manqués de [eva] et 24 SMS."

# game/scripts/c24/c24.rpy:3565
translate french c24s005_Eva_5f0fa22f:

    # "Al salir a la calle, [eva] ya te está esperando."
    "Lorsque vous sortez, [eva] vous attend déjà."

# game/scripts/c24/c24.rpy:3566
translate french c24s005_Eva_3b8ddfb4:

    # mc "Hola, [eva]."
    mc "Bonjour, [eva]."

# game/scripts/c24/c24.rpy:3569
translate french c24s005_Eva_6f818418:

    # "[eva] salta a tus brazos buscando tus labios. Hace días que no os habéis besado."
    "[eva] se jette dans tes bras, cherchant tes lèvres. Cela fait des jours que vous ne vous êtes pas embrassés."

# game/scripts/c24/c24.rpy:3571
translate french c24s005_Eva_6c435b77:

    # eva "Hola, [mc]. ¿Preparado para el entrenamiento?"
    eva "Bonjour, [mc]. Prêt pour la formation ?"

# game/scripts/c24/c24.rpy:3572
translate french c24s005_Eva_e69ff49e:

    # mc "*Risa* Para el entrenamiento sí. Para la moto no tanto."
    mc "*Rires* Pour l'entraînement, oui. Pour le vélo, pas tellement."

# game/scripts/c24/c24.rpy:3575
translate french c24s005_Eva_0d100dc8:

    # "[eva] te pega un puñetazo en el hombro. No es un puñetazo suave. Los matones del colegio te pegaban más flojo."
    "[eva] te donne un coup de poing dans l'épaule. Ce n'est pas un coup léger. Les brutes à l'école te frappent plus doucement."

# game/scripts/c24/c24.rpy:3576
translate french c24s005_Eva_eb7708ca:

    # mc "¡Ouch! ¿A qué ha venido eso?"
    mc "Aïe ! Qu'est-ce qui s'est passé ?"

# game/scripts/c24/c24.rpy:3577
translate french c24s005_Eva_81215681:

    # eva "A que así aprenderás a responder a mis llamadas."
    eva "Ainsi, tu apprendras à répondre à mes appels."

# game/scripts/c24/c24.rpy:3578
translate french c24s005_Eva_6b7cc6ac:

    # mc "¡Me quedé sin batería y no me he acordado de encenderlo hasta hace un momento!"
    mc "Ma batterie était déchargée et je n'ai pas pensé à l'allumer jusqu'à il y a un instant !"

# game/scripts/c24/c24.rpy:3580
translate french c24s005_Eva_4f44b872:

    # eva "Seguro que no se te vuelve a olvidar."
    eva "Je suis sûr que vous ne l'oublierez plus jamais."

# game/scripts/c24/c24.rpy:3582
translate french c24s005_Eva_37099f52:

    # eva "¿Has montado alguna vez en moto?"
    eva "Avez-vous déjà conduit une moto ?"

# game/scripts/c24/c24.rpy:3583
translate french c24s005_Eva_ce0ec26c:

    # mc "No... ¿Hay algo que deba saber?"
    mc "Non… Y a-t-il quelque chose que je devrais savoir ?"

# game/scripts/c24/c24.rpy:3584
translate french c24s005_Eva_cb9f023f:

    # eva "Tan solo agárrate fuerte a mí e intenta no moverte demasiado. Actúa como si fueras mi mochila."
    eva "Accroche-toi bien à moi et essaie de ne pas trop bouger. Fais comme si tu étais mon sac à dos."

# game/scripts/c24/c24.rpy:3586
translate french c24s005_Eva_45865617:

    # eva "*Risa* Y no grites ni llores en las curvas."
    eva "*Rires* Et surtout, ne criez pas et ne pleurez pas dans les virages."

# game/scripts/c24/c24.rpy:3587
translate french c24s005_Eva_6a83a2b3:

    # mc "*Risa* Lo intentaré, pero no prometo nada."
    mc "*Rires* Je vais essayer, mais je ne promets rien."

# game/scripts/c24/c24.rpy:3588
translate french c24s005_Eva_0619b416:

    # mc "*Risa* ¿En las rectas puedo llorar?"
    mc "*Rires* Est-ce que je peux pleurer dans les lignes droites ?"

# game/scripts/c24/c24.rpy:3590
translate french c24s005_Eva_c5e1570a:

    # eva "*Risa* Puedes hacerlo, pero no te voy a oír ni voy a parar."
    eva "*Rires* Tu peux le faire, mais je ne t'écouterai pas et je ne t'en empêcherai pas."

# game/scripts/c24/c24.rpy:3593
translate french c24s005_Eva_8e46c040:

    # eva "¡Sube en la moto!"
    eva "Montez sur la moto !"

# game/scripts/c24/c24.rpy:3600
translate french c24s005_Eva_2ad01fba:

    # "[eva] arranca para llevarte a la cita más extraña de tu vida."
    "[eva] vous emmène au rendez-vous le plus étrange de votre vie."

# game/scripts/c24/c24.rpy:3602
translate french c24s005_Eva_08fe7d89:

    # "[eva] arranca para llevarte al entrenamiento más extraño de tu vida."
    "[eva] vous emmène à l'entraînement le plus étrange de votre vie."

# game/scripts/c24/c24.rpy:3603
translate french c24s005_Eva_257de6ea:

    # "Consigues no gritar en la primera curva pese al frenazo de [eva]. Te comportas como una buena mochila."
    "Tu parviens à ne pas crier dans le premier virage malgré le freinage brusque en [eva]. Tu te comportes comme un bon sac à dos."

translate french strings:

    # game/scripts/c24/c24.rpy:336
    old "[bet] embarazada."
    new "[bet] enceinte."

    # game/scripts/c24/c24.rpy:711
    old "Pintar su culo y su espalda."
