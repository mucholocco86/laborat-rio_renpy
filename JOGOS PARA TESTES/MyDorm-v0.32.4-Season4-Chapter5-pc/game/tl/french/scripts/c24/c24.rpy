translate french c24s002_Meanwhile_Kim_Mar_Kat_94047155:

    # kim "Creo que le gusto físicamente."
    kim "Je pense qu'il la trouve physiquement attirante."

# game/scripts/c24/c24.rpy:1035
translate french c24s002_Meanwhile_Kim_Mar_Kat_33940d17:

    # mom "Siguiente pregunta. ¿Por qué iba a salir contigo si no está enamorado de ti?"
