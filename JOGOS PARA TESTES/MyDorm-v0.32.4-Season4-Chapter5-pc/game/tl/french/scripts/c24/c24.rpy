# game/scripts/c24/c24.rpy:1133
translate french c24s002_BetNoNun_6ae2b90c:

    # mc "Si todo es legal y hecho de buena fe, no debería haber ningún problema."
    mc "Si tout est légal et fait de bonne foi, il ne devrait y avoir aucun problème."

# game/scripts/c24/c24.rpy:1134
translate french c24s002_BetNoNun_872ad6ca:

    # mc "Tampoco en explicar lo que pasó en Tanzania, que es lo que nos ha traído a esta situación."
    mc "Ni pour expliquer ce qui s'est passé en Tanzanie, et qui nous a conduits à cette situation."

# game/scripts/c24/c24.rpy:1136
translate french c24s002_BetNoNun_602e9eff:

    # "Segismund" "¡No puede hacer eso! Ayer acordamos con su tía que si hablaba con la prensa retiraríamos la oferta."
    "Segismund" "Il ne peut pas faire ça ! Hier, nous avons convenu avec sa tante que s'il parlait à la presse, nous retirerions notre offre."

# game/scripts/c24/c24.rpy:1137
translate french c24s002_BetNoNun_84d26f25:

    # mc "Y la expulsarían, ¿no?"
    mc "Et ils l'expulseraient, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1138
translate french c24s002_BetNoNun_963f1ff6:

    # mc "Si no acepta los conventos también la expulsarán, con lo que nada evita que vayamos a la prensa."
    mc "Si elle n'accepte pas les couvents, ils l'expulseront aussi, donc rien ne nous empêche d'aller voir la presse."

# game/scripts/c24/c24.rpy:1140
translate french c24s002_BetNoNun_7b4c3d17:

    # bet "[mc], déjalo. La decisión ya estaba tomada."
    bet "[mc], laissez tomber. La décision avait déjà été prise."

# game/scripts/c24/c24.rpy:1141
translate french c24s002_BetNoNun_cd05795e:

    # mc "Déjame un momento, por favor."
    mc "Donnez-moi un instant, s'il vous plaît."

# game/scripts/c24/c24.rpy:1143
translate french c24s002_BetNoNun_0733a41f:

    # mc "Entonces, una pequeña indemnización por los años de servicio sería lo idóneo y lo justo, ¿no?"
    mc "Une petite compensation pour des années de service serait donc idéale et juste, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1144
translate french c24s002_BetNoNun_38e5141f:

    # "Segismund" "Eso no se ha hecho nunca. Sentaría un precedente."
    "Segismund" "Cela ne s'est jamais fait auparavant. Cela créerait un précédent."

# game/scripts/c24/c24.rpy:1145
translate french c24s002_BetNoNun_beaa8c9e:

    # mc "Mire, no le estoy diciendo que compre nuestro silencio. Eso sería chantaje. Solo le estoy pidiendo lo que es justo para mi tía."
    mc "Écoutez, je ne vous demande pas d'acheter notre silence. Ce serait du chantage. Je demande simplement ce qui est juste pour ma tante."

# game/scripts/c24/c24.rpy:1146
translate french c24s002_BetNoNun_8be17c10:

    # mc "Ustedes la expulsan y ella tiene que empezar una vida nueva después de 40 años de servicio sin tener un dólar ahorrado."
    mc "Vous la renvoyez et elle doit recommencer sa vie à zéro après 40 ans de service sans avoir économisé un seul dollar."

# game/scripts/c24/c24.rpy:1147
translate french c24s002_BetNoNun_271ef249:

    # mc "No es justo, ¿no?"
    mc "Ce n'est pas juste, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1149
translate french c24s002_BetNoNun_ca634ae9:

    # "Segismund" "No... pero... es legal."
    "Segismund" "Non... mais... c'est légal."

# game/scripts/c24/c24.rpy:1150
translate french c24s002_BetNoNun_1abd3170:

    # mc "También es legal ir a la prensa a explicar la situación."
    mc "Il est également légal de s'adresser à la presse pour expliquer la situation."

# game/scripts/c24/c24.rpy:1151
translate french c24s002_BetNoNun_eb986132:

    # mc "Podrán comprobar como descienden las donaciones cuando se descubra cómo trata esta diócesis a personas que han trabajado 40 años para la Iglesia."
    mc "Vous constaterez la baisse des dons lorsqu'on découvrira comment ce diocèse traite les personnes qui ont travaillé pour l'Église pendant 40 ans."

# game/scripts/c24/c24.rpy:1153
translate french c24s002_BetNoNun_435cc83a:

    # bet "¿Qué haces, [mc]?"
    bet "Que fais-tu, [mc] ?"

# game/scripts/c24/c24.rpy:1154
translate french c24s002_BetNoNun_66fdf6fa:

    # mc "Tratar a la Iglesia como te ha intentado tratar a ti."
    mc "Traitez l'Église comme elle a essayé de vous traiter."

# game/scripts/c24/c24.rpy:1155
translate french c24s002_BetNoNun_5210031e:

    # mc "Si ellos pueden usar sus armas, nosotros podemos usar las nuestras."
    mc "S'ils peuvent utiliser leurs armes, nous pouvons utiliser les nôtres."

# game/scripts/c24/c24.rpy:1156
translate french c24s002_BetNoNun_e157e17d:

    # mc "Supongo que no habían pensado que pudieras tener un sobrino abogado laboralista."
    mc "J'imagine qu'ils n'avaient pas imaginé que vous puissiez avoir un neveu avocat spécialisé en droit du travail."

# game/scripts/c24/c24.rpy:1158
translate french c24s002_BetNoNun_3b973a9c:

    # "Segismund" "¿Abogado laboralista? Entonces, ¿qué propone?"
    "Segismund" "Un avocat spécialisé en droit du travail ? Alors, que propose-t-il ?"

# game/scripts/c24/c24.rpy:1159
translate french c24s002_BetNoNun_0a5736cf:

    # mc "Una pequeña indemnización por cada año trabajado."
    mc "Une petite compensation pour chaque année travaillée."

# game/scripts/c24/c24.rpy:1160
translate french c24s002_BetNoNun_3cf6aad0:

    # mc "No le estoy pidiendo que lo haga teniendo en cuenta el sueldo de un cirujano con los años de experiencia de mi tía."
    mc "Je ne vous demande pas de le faire en tenant compte du salaire d'un chirurgien ayant l'expérience de ma tante."

# game/scripts/c24/c24.rpy:1161
translate french c24s002_BetNoNun_97335d6b:

    # mc "Puede usar su sueldo actual como referencia. Nos conformamos con 30 días de indemnización por año trabajado."
    mc "Vous pouvez utiliser votre salaire actuel comme référence. Nous acceptons une indemnité de départ équivalente à 30 jours de salaire par année d'ancienneté."

# game/scripts/c24/c24.rpy:1162
translate french c24s002_BetNoNun_6f19be5d:

    # mc "No sé si, en alguno de los países en los que ha trabajado, la indemnización puede llegar a los 40 días por año trabajado. Lo tendría que mirar."
    mc "J'ignore si, dans les pays où il a travaillé, l'indemnité de licenciement peut atteindre 40 jours par année d'ancienneté. Il faudrait que je vérifie."

# game/scripts/c24/c24.rpy:1164
translate french c24s002_BetNoNun_56cc5e5f:

    # "Segismund" "¡Eso sería mucho dinero! La Iglesia..."
    "Segismund" "Ce serait une somme considérable ! L'Église..."

# game/scripts/c24/c24.rpy:1165
translate french c24s002_BetNoNun_344c5410:

    # mc "La Iglesia va a perder mucho más en donaciones si esto sale en la prensa."
    mc "L'Église perdra beaucoup plus de dons si cela se sait dans la presse."

# game/scripts/c24/c24.rpy:1166
translate french c24s002_BetNoNun_b220ae06:

    # mc "Son poco más de tres años de sueldo de una monja. Lo acabo de calcular."
    mc "Cela représente un peu plus de trois ans de salaire pour une religieuse. Je viens de faire le calcul."

# game/scripts/c24/c24.rpy:1168
translate french c24s002_BetNoNun_d5a797ff:

    # "Segismund" "No puedo autorizar eso. No tengo poder para ello."
    "Segismund" "Je ne peux pas l'autoriser. Je n'en ai pas le pouvoir."

# game/scripts/c24/c24.rpy:1169
translate french c24s002_BetNoNun_7e4db1e6:

    # "Segismund" "¿Podrían volver en un mes y les hacemos una propuesta?"
    "Segismund" "Pourriez-vous revenir dans un mois et nous vous ferons une proposition ?"

# game/scripts/c24/c24.rpy:1170
translate french c24s002_BetNoNun_fca52711:

    # mc "No."
    mc "Non."

# game/scripts/c24/c24.rpy:1172
translate french c24s002_BetNoNun_d31c8329:

    # bet "¿No?"
    bet "Non?"

# game/scripts/c24/c24.rpy:1173
translate french c24s002_BetNoNun_51d522b1:

    # mc "No, Tía [bet]. En un mes estaré fuera del país, y no quiero que te intenten estafar."
    mc "Non, tante [bet]. Je serai à l'étranger dans un mois, et je ne veux pas que tu te fasses arnaquer."

# game/scripts/c24/c24.rpy:1175
translate french c24s002_BetNoNun_29eb690c:

    # mc "Dice que no tiene poder para tomar esa decisión. Consúltelo con quién lo tenga que consultar y volveremos en tres horas."
    mc "Il affirme ne pas avoir le pouvoir de prendre cette décision. Consultez les personnes compétentes, et nous serons de retour dans trois heures."

# game/scripts/c24/c24.rpy:1176
translate french c24s002_BetNoNun_cd0aa0e1:

    # "Segismund" "¿Tres horas? No sé si tendré tiempo de..."
    "Segismund" "Trois heures ? Je ne sais pas si j'aurai le temps de..."

# game/scripts/c24/c24.rpy:1177
translate french c24s002_BetNoNun_a3d0111e:

    # mc "Si en tres horas no tiene una propuesta, en tres días aparecerá en prensa nuestra versión de los hechos."
    mc "Si vous ne nous présentez pas de proposition dans les trois heures, notre version des faits paraîtra dans la presse dans trois jours."

# game/scripts/c24/c24.rpy:1178
translate french c24s002_BetNoNun_6fc27c56:

    # mc "Para que no puedan adelantarse y mentir, publicaré ahora mismo un twirp indicando el inicio de la historia."
    mc "Pour éviter qu'ils ne s'emballent et ne mentent, je vais poster un tweet tout de suite pour indiquer le début de l'histoire."

# game/scripts/c24/c24.rpy:1179
translate french c24s002_BetNoNun_5eb435dd:

    # mc "Deme un segundo."
    mc "Donnez-moi une seconde."

# game/scripts/c24/c24.rpy:1181
translate french c24s002_BetNoNun_60f8d2ab:

    # "Después de publicar el twirp..."
    "Après avoir posté le tweet..."

# game/scripts/c24/c24.rpy:1182
translate french c24s002_BetNoNun_ec06f76b:

    # mc "Ya está hecho. La historia de una monja maltratada y chantajeada por la iglesia. En tres días sabrán toda la verdad."
    mc "C'est fait. L'histoire d'une religieuse maltraitée et victime de chantage de la part de l'Église. Dans trois jours, toute la vérité éclatera."

# game/scripts/c24/c24.rpy:1183
translate french c24s002_BetNoNun_0dee7c33:

    # mc "Nos vemos en tres horas. Tic-tac."
    mc "À dans trois heures. Tic-tac."

# game/scripts/c24/c24.rpy:1185
translate french c24s002_BetNoNun_ae9f9ed3:

    # mc "¿Nos vamos, Tía [bet]?"
    mc "On y va, tante [bet] ?"

# game/scripts/c24/c24.rpy:1186
translate french c24s002_BetNoNun_24af5e07:

    # bet "Sí, vámonos. Creo que el Padre Segismund tiene unas llamadas que hacer."
    bet "Oui, allons-y. Je crois que le père Segismund a des coups de fil à passer."

# game/scripts/c24/c24.rpy:1189
translate french c24s002_BetNoNun_825c2221:

    # "Al salir del edificio de la Iglesia..."
    "En sortant de l'église..."

# game/scripts/c24/c24.rpy:1191
translate french c24s002_BetNoNun_eccb5103:

    # bet "¿Qué has hecho? Ya habíamos hablado de que venía a informarles de que dejaba de ser monja."
    bet "Qu'avez-vous fait ? Nous avions déjà convenu que je viendrais vous annoncer mon départ du couvent."

# game/scripts/c24/c24.rpy:1192
translate french c24s002_BetNoNun_5530c9aa:

    # mc "Vas a dejar de ser monja igualmente, no te van a permitir seguir en la Iglesia y moverte libremente. Pero te irás con los bolsillos llenos."
    mc "Vous cesserez tout de même d'être religieuse ; on ne vous permettra plus de rester dans l'Église et de circuler librement. Mais vous repartirez les poches pleines."

# game/scripts/c24/c24.rpy:1193
translate french c24s002_BetNoNun_5c16c34c:

    # mc "Podrás pagar la certificación y ayudar a Meemaw con su nueva casa, tal como queréis las dos."
    mc "Vous pouvez financer la certification et aider Mémé à s'installer dans sa nouvelle maison, comme vous le souhaitez tous les deux."

# game/scripts/c24/c24.rpy:1195
translate french c24s002_BetNoNun_f72c981a:

    # bet "*Risa* Tienes razón. No se me hubiera ocurrido nunca."
    bet "*Rires* Tu as raison. Je n'y aurais jamais pensé."

# game/scripts/c24/c24.rpy:1196
translate french c24s002_BetNoNun_7a807ac2:

    # mc "*Risa* Para eso me tienes a mí."
    mc "*Rires* C'est pour ça que je suis là."

# game/scripts/c24/c24.rpy:1198
translate french c24s002_BetNoNun_89b009df:

    # bet "Por cierto, creía que no mentías nunca."
    bet "Au fait, je croyais que tu n'avais jamais menti."

# game/scripts/c24/c24.rpy:1199
translate french c24s002_BetNoNun_4190fe76:

    # mc "Y no he mentido."
    mc "Et je n'ai pas menti."

# game/scripts/c24/c24.rpy:1200
translate french c24s002_BetNoNun_277eb0a0:

    # bet "¿Abogado laboralista? ¿Desde cuándo eres abogado?"
    bet "Avocat spécialisé en droit du travail ? Depuis combien de temps êtes-vous avocat ?"

# game/scripts/c24/c24.rpy:1201
translate french c24s002_BetNoNun_1502332f:

    # mc "Yo no he dicho que lo fuera. He dicho que ellos no podían imaginar que tuvieras un sobrino que lo fuera."
    mc "Je n'ai pas dit qu'il l'était. J'ai dit qu'ils n'arrivaient pas à imaginer que vous ayez un neveu qui l'était."

# game/scripts/c24/c24.rpy:1202
translate french c24s002_BetNoNun_5c2166f5:

    # mc "Yo tampoco. *Risa* Porque no lo tienes."
    mc "Moi non plus. *Rires* Parce que tu ne l'as pas."

# game/scripts/c24/c24.rpy:1204
translate french c24s002_BetNoNun_b6d42a34:

    # bet "¿Y lo de las indemnizaciones de 40 días en los países en los que he trabajado?"
    bet "Et qu'en est-il de l'indemnité de licenciement de 40 jours dans les pays où j'ai travaillé ?"

# game/scripts/c24/c24.rpy:1205
translate french c24s002_BetNoNun_57b7c2d1:

    # mc "He dicho que no sabía si alguno de esos países tenía 40 días de indemnización. *Risa*"
    mc "J'ai dit que je ne savais pas si l'un de ces pays offrait une indemnisation de 40 jours. *Rires*"

# game/scripts/c24/c24.rpy:1206
translate french c24s002_BetNoNun_2a5f9b56:

    # mc "He pedido 30 días esperando que nos den 15. Lo de los 40 días de indemnización lo he dicho para ponerlo nervioso."
    mc "J'ai demandé 30 jours en espérant qu'ils nous en accorderaient 15. J'ai mentionné les 40 jours d'indemnisation juste pour l'inquiéter."

# game/scripts/c24/c24.rpy:1207
translate french c24s002_BetNoNun_ee19411c:

    # mc "Tanto él como tú habéis entendido lo que habéis creído oír, pero que yo no he dicho. *Risa* No hay una sola mentira en lo que he dicho."
    mc "Vous avez tous deux compris ce que vous pensiez avoir entendu, mais que je n'ai pas dit. *Rires* Je n'ai pas menti une seule fois."

# game/scripts/c24/c24.rpy:1209
translate french c24s002_BetNoNun_7af3c1c9:

    # bet "*Risa* A partir de ahora tendré que analizar todo lo que digas."
    bet "*Rires* À partir de maintenant, je vais devoir analyser tout ce que vous dites."

# game/scripts/c24/c24.rpy:1210
translate french c24s002_BetNoNun_538d6a77:

    # mc "No hace falta. Esos trucos solo los uso con gente de fuera de la familia."
    mc "Ce n'est pas nécessaire. Je n'utilise ces astuces qu'avec des personnes extérieures à la famille."

# game/scripts/c24/c24.rpy:1211
translate french c24s002_BetNoNun_87171caa:

    # mc "Con la familia tendrían un recorrido muy corto."
    mc "En famille, le voyage serait très court."

# game/scripts/c24/c24.rpy:1212
translate french c24s002_BetNoNun_a08b775d:

    # mc "¿Vamos a buscar a [emm]? Tenemos tres horas para hacer turismo antes de tener que volver."
    mc "On va chercher [emm] ? On a trois heures pour visiter avant de devoir rentrer."

# game/scripts/c24/c24.rpy:1214
translate french c24s002_BetNoNun_c73d7a39:

    # bet "Eso es otra cosa que no he entendido. ¿Por qué tres horas y no dos o cinco?"
    bet "Voilà encore une chose que je ne comprends pas. Pourquoi trois heures et pas deux ou cinq ?"

# game/scripts/c24/c24.rpy:1215
translate french c24s002_BetNoNun_5ae5607f:

    # mc "Sonaba bien lo de tres horas para arreglarlo o tres días para publicarlo."
    mc "Trois heures pour le corriger ou trois jours pour le publier, ça me semblait bien."

# game/scripts/c24/c24.rpy:1216
translate french c24s002_BetNoNun_e04d2764:

    # mc "Hoy es viernes, con el fin de semana por en medio, se publicaría el lunes. No tenían mucho tiempo para reaccionar."
    mc "Aujourd'hui, c'est vendredi, et avec le week-end, la publication aurait lieu lundi. Ils n'ont pas eu beaucoup de temps pour réagir."

# game/scripts/c24/c24.rpy:1217
translate french c24s002_BetNoNun_3f06bdb9:

    # mc "Además, a ese pobre hombre se le veía muy agobiado, como si no supiera de dónde le venían los golpes."
    mc "De plus, ce pauvre homme semblait très angoissé, comme s'il ne savait pas d'où venaient les coups."

# game/scripts/c24/c24.rpy:1218
translate french c24s002_BetNoNun_0b5eb55b:

    # mc "Y lo del twirp ha sido lo que ha acabado de descolocarlo. Por suerte solo me sigue Jamaal en Twirper."
    mc "Et c'est l'histoire de Twirper qui l'a vraiment déstabilisé. Heureusement, seul Jamaal me suit sur Twirper."

# game/scripts/c24/c24.rpy:1220
translate french c24s002_BetNoNun_e573a454:

    # bet "*Risa* ¿Y todo eso lo has pensado en un minuto?"
    bet "*Rires* Et tu as pensé à tout ça en une minute ?"

# game/scripts/c24/c24.rpy:1221
translate french c24s002_BetNoNun_ba1d33a2:

    # mc "No, ayer estuve pensando en diferentes escenarios, pero hasta que no ha dicho lo de la expulsión no he atado cabos."
    mc "Non, hier je réfléchissais à différents scénarios, mais ce n'est que lorsqu'il a mentionné l'expulsion que j'ai fait le rapprochement."

# game/scripts/c24/c24.rpy:1222
translate french c24s002_BetNoNun_27ccb0ee:

    # mc "En mi mente expulsión y despido venía a ser lo mismo, y he ido planeando cosas mientras hablaba."
    mc "Pour moi, l'expulsion et le renvoi étaient fondamentalement la même chose, et je planifiais des choses pendant que je parlais."

# game/scripts/c24/c24.rpy:1224
translate french c24s002_BetNoNun_4cfa58a6:

    # bet "Pero les estás haciendo chantaje con lo de ir a la prensa. Podríamos acabar en la cárcel."
    bet "Mais vous les faites chanter en menaçant de parler à la presse. On pourrait finir en prison."

# game/scripts/c24/c24.rpy:1225
translate french c24s002_BetNoNun_a710e820:

    # mc "No, no les estoy chantajeando. Son ellos los que intentaron chantajearte a ti diciendo que si ibas a la prensa retiraban su oferta."
    mc "Non, je ne les fais pas chanter. Ce sont eux qui ont essayé de vous faire chanter, en disant que si vous alliez voir la presse, ils retireraient leur offre."

# game/scripts/c24/c24.rpy:1226
translate french c24s002_BetNoNun_ca7e35a8:

    # mc "Yo tan solo les he dicho que pueden retirar la oferta porque vamos a ir a la prensa igualmente."
    mc "Je leur ai simplement dit qu'ils pouvaient retirer leur offre puisque nous allions de toute façon la communiquer à la presse."

# game/scripts/c24/c24.rpy:1227
translate french c24s002_BetNoNun_35aa0b2b:

    # mc "Si no quieren prensa, queremos un trato justo. Tan solo estamos rechazando su chantaje."
    mc "S'ils ne veulent pas de couverture médiatique, nous voulons un traitement équitable. Nous rejetons tout simplement leur chantage."

# game/scripts/c24/c24.rpy:1229
translate french c24s002_BetNoNun_a06661e2:

    # bet "Y si intentaran denunciarnos, tendrían que reconocer que estaban intentando chantajearme."
    bet "Et s'ils essayaient de nous poursuivre en justice, ils devraient admettre qu'ils essayaient de me faire chanter."

# game/scripts/c24/c24.rpy:1230
translate french c24s002_BetNoNun_a82b70fa:

    # mc "Exacto. No soy abogado, pero el cura tampoco lo es. El sentido común es lo que me dice, y supongo que a él también."
    mc "Exactement. Je ne suis pas avocat, et le prêtre non plus. Le bon sens me le dit, et j'imagine que c'est le cas pour lui aussi."

# game/scripts/c24/c24.rpy:1231
translate french c24s002_BetNoNun_4c6701dc:

    # mc "Por eso le he dado poco tiempo para decidir. No va a poder consultar con mucha gente."
    mc "C'est pourquoi je lui ai laissé peu de temps pour se décider. Il ne pourra pas consulter beaucoup de personnes."

# game/scripts/c24/c24.rpy:1233
translate french c24s002_BetNoNun_c944ee30:

    # bet "*Risa* Espero no tenerte nunca de enemigo."
    bet "*Rires* J'espère ne jamais t'avoir comme ennemi."

# game/scripts/c24/c24.rpy:1234
translate french c24s002_BetNoNun_b446b678:

    # mc "No deberías temerme a mí. *Risa* [ama] y [eva] te deberían preocupar más. Especialmente si no tienes un rodillo a mano."
    mc "Tu ne devrais pas avoir peur de moi. *Rires* Ce sont plutôt [ama] et [eva] qui devraient t'inquiéter. Surtout si tu n'as pas de rouleau à pâtisserie sous la main."

# game/scripts/c24/c24.rpy:1235
translate french c24s002_BetNoNun_2f33abec:

    # mc "Vamos a buscar a [emm] y a hacer un poco de turismo. Solo tenemos tres horas."
    mc "Allons trouver [emm] et faire un peu de tourisme. Nous n'avons que trois heures."

# game/scripts/c24/c24.rpy:1237
translate french c24s002_BetNoNun_3e3e712e:

    # "Pasáis a buscar a [emm] por la heladería y le explicáis el resultado de la reunión."
    "Vous récupérez [emm] à la boutique de glaces et lui expliquez le résultat de la réunion."

# game/scripts/c24/c24.rpy:1238
translate french c24s002_BetNoNun_eb17b87f:

    # emm "Menos mal que no he ido."
    emm "Dieu merci, je n'y suis pas allé."

# game/scripts/c24/c24.rpy:1239
translate french c24s002_BetNoNun_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c24/c24.rpy:1240
translate french c24s002_BetNoNun_b2a91863:

    # emm "Lo primero que le hubiera dicho al cura hubiese sido 'Mi tía os abandona, gilipollas. Vosotros os lo perdéis.'"
    emm "La première chose que j'aurais dite au prêtre aurait été : « Ma tante vous quitte, bande d'idiots ! C'est vous qui allez le regretter ! »"

# game/scripts/c24/c24.rpy:1241
translate french c24s002_BetNoNun_7ae3d058:

    # emm "Y no hubiera habido indemnización. *Risa* Además, no se me hubiera ocurrido nunca."
    emm "Et il n'y aurait eu aucune compensation. *Rires* D'ailleurs, ça ne m'aurait jamais traversé l'esprit."

# game/scripts/c24/c24.rpy:1243
translate french c24s002_BetNoNun_7d2c8bc1:

    # bet "A mí tampoco. Pero [mc] ha pensado muy rápido y no ha dejado un segundo para que el Padre Segismund pudiera pararse a pensar."
    bet "Moi non plus. Mais [mc] a réfléchi très vite et n'a pas laissé au Père Segismund le temps de s'arrêter et de réfléchir."

# game/scripts/c24/c24.rpy:1244
translate french c24s002_BetNoNun_8c2de467:

    # mc "Bueno, es una de las técnicas de negociación que me enseñaron en la universidad."
    mc "Eh bien, c'est une des techniques de négociation qu'on m'a enseignées à l'université."

# game/scripts/c24/c24.rpy:1245
translate french c24s002_BetNoNun_74514363:

    # mc "No la recomiendan por ser demasiado agresiva, y normalmente la gente tiene tiempo para pensar después, con lo que se dan cuenta de los fallos que haya cometido."
    mc "Ce n'est pas recommandé car c'est trop agressif, et les gens ont généralement le temps de réfléchir après coup, ce qui leur permet de se rendre compte des erreurs qu'ils ont pu commettre."

# game/scripts/c24/c24.rpy:1247
translate french c24s002_BetNoNun_54844984:

    # emm "Lo importante es que está resuelto... a medias."
    emm "L'important, c'est que le problème soit réglé... plus ou moins."

# game/scripts/c24/c24.rpy:1248
translate french c24s002_BetNoNun_42ea4e89:

    # emm "¿Preparados para que os haga de guía turístico de Monterey?"
    emm "Prêts à ce que je sois votre guide touristique à Monterey ?"

# game/scripts/c24/c24.rpy:1249
translate french c24s002_BetNoNun_377e71a0:

    # mc "No sabía que habías estado aquí antes."
    mc "Je ne savais pas que tu étais déjà venu ici."

# game/scripts/c24/c24.rpy:1251
translate french c24s002_BetNoNun_eddf0b65:

    # emm "No he estado nunca, pero he tenido tiempo de mirarme unas guías por internet mientras esperaba."
    emm "Je n'y suis jamais allé, mais j'ai eu le temps de consulter quelques guides en ligne pendant mon attente."

# game/scripts/c24/c24.rpy:1253
translate french c24s002_BetNoNun_5e38cf5d:

    # emm "Y anoche, mientras alguien hacía otras cosas más divertidas."
    emm "Et hier soir, pendant que quelqu'un d'autre faisait des choses plus amusantes."

# game/scripts/c24/c24.rpy:1254
translate french c24s002_BetNoNun_ea8e8ae5:

    # mc "*Risa* Es un buen entrenamiento para ti. Querías ser fotógrafa de guías de viaje."
    mc "*Rires* C'est un bon entraînement pour toi. Tu voulais être photographe et guide de voyage."

# game/scripts/c24/c24.rpy:1256
translate french c24s002_BetNoNun_aa056308:

    # bet "Nunca me has dicho como [eri] y tú decidisteis que vuestro sueño era algo tan específico y que coincidieseis en lo que queríais ser."
    bet "Tu ne m'as jamais dit comment [eri] et tu as décidé que ton rêve était quelque chose de si précis et que vous étiez d'accord sur ce que tu voulais devenir."

# game/scripts/c24/c24.rpy:1258
translate french c24s002_BetNoNun_061db69d:

    # emm "Encontramos unas guías de Europa en la biblioteca del instituto, de esas viejas, en papel."
    emm "Nous avons trouvé de vieux guides touristiques sur l'Europe dans la bibliothèque de l'école."

# game/scripts/c24/c24.rpy:1259
translate french c24s002_BetNoNun_5d5079a9:

    # emm "Venecia, París, Roma, Barcelona, Atenas..."
    emm "Venise, Paris, Rome, Barcelone, Athènes..."

# game/scripts/c24/c24.rpy:1260
translate french c24s002_BetNoNun_863ae883:

    # emm "Decidimos que queríamos conocer todas esas ciudades. *Risa* Y que no había mejor forma de hacerlo que si nos pagaban."
    emm "Nous avons décidé de visiter toutes ces villes. *Rires* Et il n'y avait pas de meilleur moyen d'y parvenir que d'être payés."

# game/scripts/c24/c24.rpy:1261
translate french c24s002_BetNoNun_45cf909a:

    # mc "El plan se le ocurrió a [eri], ¿no?"
    mc "Le plan venait de [eri], n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1263
translate french c24s002_BetNoNun_6f9ba524:

    # emm "¿Qué insinúas con eso? ¿Que mis planes no son realistas?"
    emm "Que sous-entendez-vous ? Que mes projets sont irréalistes ?"

# game/scripts/c24/c24.rpy:1265
translate french c24s002_BetNoNun_e228ff71:

    # emm "El de anoche funcionó."
    emm "Ça a fonctionné hier soir."

# game/scripts/c24/c24.rpy:1266
translate french c24s002_BetNoNun_b84309d8:

    # mc "Pero se le ocurrió a [eri], ¿verdad?"
    mc "Mais c'était l'idée de [eri], n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1268
translate french c24s002_BetNoNun_08debe65:

    # emm "Sí. *Risa* Y vámonos a visitar Monterey o al final no podré enseñaros los sitios que he descubierto."
    emm "Oui. *Rires* Et allons visiter Monterey, sinon je ne pourrai pas vous montrer les endroits que j'ai découverts."

# game/scripts/c24/c24.rpy:1269
translate french c24s002_BetNoNun_d9a0c285:

    # mc "Vamos. Tenemos menos de tres horas."
    mc "Allons-y. Il nous reste moins de trois heures."

# game/scripts/c24/c24.rpy:1271
translate french c24s002_BetNoNun_2f35927b:

    # "[emm] os lleva por algunos de los sitios más emblemáticos de Monterey, aprovechando para sacar fotografías en cada uno de ellos."
    "[emm] vous emmène à la découverte de certains des sites les plus emblématiques de Monterey, en vous offrant la possibilité de prendre des photos à chacun d'eux."

# game/scripts/c24/c24.rpy:1272
translate french c24s002_BetNoNun_a4dee4f8:

    # "Os da explicaciones sorprendentemente detalladas sobre cada uno de los lugares que visitáis."
    "Il vous donne des explications étonnamment détaillées sur chacun des lieux que vous visitez."

# game/scripts/c24/c24.rpy:1273
translate french c24s002_BetNoNun_bf6175b6:

    # "Pero esas tres horas se hacen muy cortas y tenéis que dejar muchas cosas en el tintero, para otra visita."
    "Mais ces trois heures passent très vite, et il faut laisser beaucoup de choses en suspens pour une autre visite."

# game/scripts/c24/c24.rpy:1274
translate french c24s002_BetNoNun_5706c58a:

    # "La última parada es la Catedral de Monterey, muy cerca del edificio donde os habéis reunido con el Padre Segismund."
    "La dernière étape est la cathédrale de Monterey, tout près du bâtiment où vous avez rencontré le père Segismund."

# game/scripts/c24/c24.rpy:1275
translate french c24s002_BetNoNun_c926f7ff:

    # emm "Y esta es la catedral más pequeña de los Estados Unidos. Se fundó como la capilla de un presidio español."
    emm "Et voici la plus petite cathédrale des États-Unis. Elle a été fondée comme chapelle d'un presidio espagnol."

# game/scripts/c24/c24.rpy:1276
translate french c24s002_BetNoNun_77f2441d:

    # emm "Era como llamaban a sus fuertes."
    emm "C'est ainsi qu'ils appelaient leurs forts."

# game/scripts/c24/c24.rpy:1277
translate french c24s002_BetNoNun_27596bdb:

    # bet "Muy interesante la visita, [emm]. Nos has dado un montón de información para haber estudiado la ciudad solo unas horas."
    bet "La visite était très intéressante, [emm]. Vous nous avez donné beaucoup d'informations alors que vous n'avez étudié la ville que pendant quelques heures."

# game/scripts/c24/c24.rpy:1278
translate french c24s002_BetNoNun_6c389925:

    # mc "Si lo de hacerte fotógrafa no funciona, tienes futuro como guía turística."
    mc "Si la photographie ne vous réussit pas, vous avez un avenir comme guide touristique."

# game/scripts/c24/c24.rpy:1280
translate french c24s002_BetNoNun_6b6926e8:

    # emm "Iros antes de que me hagáis ruborizar. No estoy acostumbrada a los elogios."
    emm "Pars avant de me faire rougir. Je n'ai pas l'habitude des compliments."

# game/scripts/c24/c24.rpy:1281
translate french c24s002_BetNoNun_c9198b76:

    # emm "Me llevo la camioneta a la heladería y os espero allí. Ya me estoy haciendo amiga de Margaret, la camarera."
    emm "Je prendrai le camion pour aller au glacier et je t'y attendrai. Je commence déjà à sympathiser avec Margaret, la serveuse."

# game/scripts/c24/c24.rpy:1282
translate french c24s002_BetNoNun_e57e09a3:

    # bet "Déjame un poco de helado. El dónut de antes me ha dejado con hambre."
    bet "Laissez-moi de la glace. Ce beignet m'a donné faim."

# game/scripts/c24/c24.rpy:1284
translate french c24s002_BetNoNun_733dc6d8:

    # mc "Te vemos en un rato."
    mc "À tout à l'heure."

# game/scripts/c24/c24.rpy:1287
translate french c24s002_BetNoNun_efd32a54:

    # bet "Hola de nuevo, Hermana. Venimos a ver al Padre Segismund de nuevo."
    bet "Bonjour à nouveau, sœur. Nous sommes venus voir le père Segismund."

# game/scripts/c24/c24.rpy:1288
translate french c24s002_BetNoNun_e9c67058:

    # "Monja" "Les está esperando. Pasen."
    "Monja" "Il vous attend. Entrez."

# game/scripts/c24/c24.rpy:1290
translate french c24s002_BetNoNun_61637fb9:

    # "Segismund" "Hola de nuevo. Tengo noticias para ustedes. Siéntense, por favor."
    "Segismund" "Bonjour à nouveau. J'ai des nouvelles pour vous. Veuillez vous asseoir."

# game/scripts/c24/c24.rpy:1291
translate french c24s002_BetNoNun_03495d72:

    # "Segismund" "He hablado con mis superiores y, por desgracia, no han aceptado lo de los 30 días de indemnización por año trabajado."
    "Segismund" "J'ai parlé à mes supérieurs et, malheureusement, ils n'ont pas accepté l'indemnité de 30 jours par année travaillée."

# game/scripts/c24/c24.rpy:1292
translate french c24s002_BetNoNun_19bf6c02:

    # mc "Bueno, entonces no nos deja más opciones que ir a la prensa."
    mc "Eh bien, il ne nous reste donc pas d'autre choix que de nous adresser à la presse."

# game/scripts/c24/c24.rpy:1294
translate french c24s002_BetNoNun_d3db4a6b:

    # "Segismund" "No, espere. Me han autorizado a pagarle a la Hermana Beatrix tan solo 20 días de indemnización."
    "Segismund" "Non, attendez. Je n'ai été autorisé à verser à sœur Beatrix que l'équivalent de 20 jours de salaire."

# game/scripts/c24/c24.rpy:1295
translate french c24s002_BetNoNun_f4c62f42:

    # "Segismund" "Usted tenía razón en que hay países en los que ha trabajado con indemnizaciones de hasta 45, pero otros tienen menos."
    "Segismund" "Vous aviez raison de dire qu'il existe des pays où vous avez travaillé avec une rémunération allant jusqu'à 45, mais que dans d'autres, elle est moindre."

# game/scripts/c24/c24.rpy:1296
translate french c24s002_BetNoNun_4911aef5:

    # "Segismund" "Sé que no era lo que esperaban, pero..."
    "Segismund" "Je sais que ce n'est pas ce à quoi vous vous attendiez, mais..."

# game/scripts/c24/c24.rpy:1297
translate french c24s002_BetNoNun_dc7f482b:

    # mc "Entonces eso sería... algo más de dos años de sueldo."
    mc "Cela représenterait donc... un peu plus de deux ans de salaire."

# game/scripts/c24/c24.rpy:1299
translate french c24s002_BetNoNun_830701cc:

    # "Segismund" "Algo más. He pedido que, al no cumplir con sus peticiones, añadieran algo más por algunos complementos para su tía."
    "Segismund" "Une dernière chose. J'ai demandé que, puisqu'ils n'ont pas accédé à ses demandes, ils ajoutent un petit quelque chose en plus pour quelques accessoires pour sa tante."

# game/scripts/c24/c24.rpy:1300
translate french c24s002_BetNoNun_61103e94:

    # "Segismund" "Al final, serán 2.64 años de sueldo. Lo siento pero no he podido conseguir más." id c24s002_BetNoNun_61103e94
    "Segismund" "Au final, cela représentera 2,64 années de salaire. Je suis désolé, mais je ne pouvais pas obtenir davantage." id c24s002_BetNoNun_61103e94

# game/scripts/c24/c24.rpy:1301
translate french c24s002_BetNoNun_0f58b44f:

    # "Segismund" "Obviamente tendrá que firmar un acuerdo de confidencialidad sobre todo este asunto."
    "Segismund" "Bien entendu, vous devrez signer un accord de confidentialité concernant toute cette affaire."

# game/scripts/c24/c24.rpy:1302
translate french c24s002_BetNoNun_d093d5c0:

    # mc "2.64 años y acuerdo de confidencialidad. ¿Cómo lo ves, Tía [bet]?" id c24s002_BetNoNun_d093d5c0
    mc "2,64 ans et un accord de confidentialité. Qu'en pensez-vous, tante [bet] ?" id c24s002_BetNoNun_d093d5c0

# game/scripts/c24/c24.rpy:1304
translate french c24s002_BetNoNun_3c013f7c:

    # bet "Me parece bien..."
    bet "Cela me semble bien..."

# game/scripts/c24/c24.rpy:1306
translate french c24s002_BetNoNun_d957b91c:

    # mc "¿Hay oferta por escrito de todo esto?"
    mc "Existe-t-il une offre écrite pour tout cela ?"

# game/scripts/c24/c24.rpy:1307
translate french c24s002_BetNoNun_56633b5c:

    # "Segismund" "Sí, también tengo el acuerdo de confidencialidad. Ha llegado todo hace unos minutos. Tres horas era muy poco tiempo."
    "Segismund" "Oui, j'ai également l'accord de confidentialité. Tout est arrivé il y a quelques minutes. Trois heures, c'était trop court."

# game/scripts/c24/c24.rpy:1308
translate french c24s002_BetNoNun_5917cbbf:

    # "Segismund" "La oferta indica que dejará la Iglesia a final de mes, que es cuando se les entregará el dinero. Pero el acuerdo de confidencialidad entra en vigor hoy."
    "Segismund" "L'offre stipule qu'il quittera l'Église à la fin du mois, date à laquelle l'argent leur sera remis. Or, l'accord de confidentialité prend effet aujourd'hui."

# game/scripts/c24/c24.rpy:1309
translate french c24s002_BetNoNun_987ab9f2:

    # mc "Me parece bien. ¿Firmamos?"
    mc "Ça me convient. On signe ?"

# game/scripts/c24/c24.rpy:1311
translate french c24s002_BetNoNun_e16f9f5e:

    # "Después de firmar todos los papeles..."
    "Après avoir signé tous les papiers..."

# game/scripts/c24/c24.rpy:1312
translate french c24s002_BetNoNun_149060ab:

    # mc "Bueno, Tía [bet], en unos días dejarás de ser monja y tendrás una buena cantidad de dinero en tu cuenta."
    mc "Eh bien, tante [bet], dans quelques jours tu cesseras d'être une nonne et tu auras une belle somme d'argent sur ton compte."

# game/scripts/c24/c24.rpy:1313
translate french c24s002_BetNoNun_fa655e45:

    # bet "Sí. Creo que es lo mejor para todos. Para la Iglesia y para mí."
    bet "Oui. Je pense que c'est ce qu'il y a de mieux pour tout le monde. Pour l'Église et pour moi."

# game/scripts/c24/c24.rpy:1314
translate french c24s002_BetNoNun_48ee1e2b:

    # mc "Creo que, ahora que todo está firmado, le puedes decir al Padre Segismund cuál era tu intención al entrar por esa puerta esta mañana."
    mc "Je pense que, maintenant que tout est signé, vous pouvez dire au père Segismund quelle était votre intention en franchissant cette porte ce matin."

# game/scripts/c24/c24.rpy:1316
translate french c24s002_BetNoNun_3938639c:

    # bet "¿Qué? ¿Crees que es necesario?"
    bet "Quoi ? Vous pensez que c'est nécessaire ?"

# game/scripts/c24/c24.rpy:1317
translate french c24s002_BetNoNun_0f1781b4:

    # mc "Creo que vas a disfrutar cada segundo."
    mc "Je pense que vous allez apprécier chaque seconde."

# game/scripts/c24/c24.rpy:1319
translate french c24s002_BetNoNun_d1f08a29:

    # bet "Padre Segismund, primero quiero darle las gracias por hacer las gestiones tan rápido."
    bet "Père Segismund, je tiens tout d'abord à vous remercier d'avoir réglé les choses si rapidement."

# game/scripts/c24/c24.rpy:1321
translate french c24s002_BetNoNun_5165c59d:

    # "Segismund" "Supongo que hay algún pero por lo que ha dicho su sobrino."
    "Segismund" "J'imagine qu'il y a un « mais » à cause de ce que son neveu a dit."

# game/scripts/c24/c24.rpy:1323
translate french c24s002_BetNoNun_97c571f0:

    # bet "Sí. Pero mi intención al venir hoy era abandonar la Iglesia. Nunca pensé en una indemnización ya que era yo la que me iba."
    bet "Oui. Mais mon intention en venant ici aujourd'hui était de quitter l'Église. Je n'ai jamais pensé à une compensation puisque c'était moi qui partais."

# game/scripts/c24/c24.rpy:1324
translate french c24s002_BetNoNun_492795a5:

    # bet "Gracias por 2.64 años de mi sueldo." id c24s002_BetNoNun_492795a5
    bet "Merci pour 2,64 années de mon salaire." id c24s002_BetNoNun_492795a5

# game/scripts/c24/c24.rpy:1326
translate french c24s002_BetNoNun_7ed23dc3:

    # "Segismund" "¿Qué?"
    "Segismund" "Que?"

# game/scripts/c24/c24.rpy:1327
translate french c24s002_BetNoNun_f3acb3c7:

    # mc "*Risa* Por suerte, todo está firmado y mi tía ya no se puede echar atrás."
    mc "*Rires* Heureusement, tout est signé et ma tante ne peut plus se rétracter."

# game/scripts/c24/c24.rpy:1328
translate french c24s002_BetNoNun_5cd145b7:

    # mc "Gracias por todo, Padre Segismund."
    mc "Merci pour tout, Père Segismund."

# game/scripts/c24/c24.rpy:1329
translate french c24s002_BetNoNun_d78cd553:

    # "Abandonáis el edificio de la Iglesia con la cara de sorpresa del Padre Segismund grabada en vuestras retinas."
    "Vous quittez l'église avec le visage surpris du père Segismund gravé dans votre rétine."

# game/scripts/c24/c24.rpy:1332
translate french c24s002_BetNoNun_b438befd:

    # "Una vez en el exterior..."
    "Une fois dehors..."

# game/scripts/c24/c24.rpy:1334
translate french c24s002_BetNoNun_3aa48686:

    # bet "Gracias por todo, [mc]. Si no hubiera sido por ti..."
    bet "Merci pour tout, [mc]. Sans toi..."

# game/scripts/c24/c24.rpy:1335
translate french c24s002_BetNoNun_5dc15e44:

    # mc "No tienes por qué darlas. He visto una oportunidad y la he aprovechado. Esperaba 15 días y nos han dado 20. No está mal."
    mc "Vous n'êtes pas obligé d'y renoncer. J'ai vu une opportunité et je l'ai saisie. Je m'attendais à 15 jours et ils nous en ont accordé 20. Pas mal."

# game/scripts/c24/c24.rpy:1336
translate french c24s002_BetNoNun_a0116eca:

    # mc "Ahora tienes dinero suficiente para la recertificación, supongo."
    mc "Vous avez maintenant suffisamment d'argent pour la recertification, je suppose."

# game/scripts/c24/c24.rpy:1339
translate french c24s002_BetNoNun_a26a6a4e:

    # bet "Lo que más me jode de no haber dejado de ser monja hoy es que no te puedo besar ahora mismo aquí delante."
    bet "Ce qui me met le plus en colère, c'est que, n'ayant pas cessé d'être une nonne aujourd'hui, je ne peux pas t'embrasser ici même, devant toi."

# game/scripts/c24/c24.rpy:1340
translate french c24s002_BetNoNun_f2817d0d:

    # bet "Serían capaces de excomulgarme para ahorrarse el dinero. *Risa*"
    bet "Ils seraient capables de m'excommunier pour économiser de l'argent. *Rires*"

# game/scripts/c24/c24.rpy:1341
translate french c24s002_BetNoNun_5c2c04f5:

    # mc "*Risa* Habrá mucho tiempo para eso. No te preocupes."
    mc "*Rires* Il y aura largement le temps pour ça. Ne t'inquiète pas."

# game/scripts/c24/c24.rpy:1342
translate french c24s002_BetNoNun_c72099de:

    # mc "Vamos a buscar a [emm]. Se tiene que estar mordiendo las uñas del nerviosismo."
    mc "Allons trouver [emm]. Il doit se ronger les ongles de nervosité."

# game/scripts/c24/c24.rpy:1344
translate french c24s002_BetNoNun_583d8878:

    # "Después de recoger a [emm] y explicárselo todo..."
    "Après avoir récupéré [emm] et tout lui avoir expliqué..."

# game/scripts/c24/c24.rpy:1346
translate french c24s002_BetNoNun_7f514a72:

    # emm "Si queréis puedo conducir yo de vuelta a casa. Por si estáis cansados después de la noche de ayer. *Risita*"
    emm "Si tu veux, je peux te raccompagner. Au cas où tu serais fatiguée après hier soir. *Rires*"

# game/scripts/c24/c24.rpy:1347
translate french c24s002_BetNoNun_5321e4ac:

    # mc "Me parece una buena idea. Así podemos echar una siesta mientras tú conduces."
    mc "Ça me paraît une bonne idée. Comme ça, on pourra faire une sieste pendant que tu conduis."

# game/scripts/c24/c24.rpy:1348
translate french c24s002_BetNoNun_e7093740:

    # mc "Tu dormiste en el viaje de ida y nosotros en el de vuelta."
    mc "Tu as dormi pendant le voyage aller et nous avons dormi pendant le voyage retour."

# game/scripts/c24/c24.rpy:1350
translate french c24s002_BetNoNun_e9b48284:

    # emm "Vuelvo a pedirme el asiento de atrás. He dormido poco con los ronquidos de Tía [bet]."
    emm "Je vais encore une fois me mettre à l'arrière. Je n'ai pas beaucoup dormi à cause des ronflements de ma tante."

# game/scripts/c24/c24.rpy:1351
translate french c24s002_BetNoNun_5db2a345:

    # emm "¡De vuelta a casa!"
    emm "De retour à la maison !"

# game/scripts/c24/c24.rpy:1353
translate french c24s002_BetNoNun_4bdf22d8:

    # "Durante el viaje a casa, Tía [bet] manda varios mensajes al grupo de WhatsUp para informar de cómo ha ido todo."
    "Durant le voyage de retour, tante [bet] envoie plusieurs messages au groupe WhatsUp pour raconter comment tout s'est passé."

# game/scripts/c24/c24.rpy:1355
translate french c24s002_BetNoNun_ceeade09:

    # "Se queda profundamente dormida después de contestar todos los mensajes del resto de las chicas."
    "Elle sombre dans un profond sommeil après avoir répondu à tous les messages des autres filles."

# game/scripts/c24/c24.rpy:1366
translate french c24s003_Mar_203aaac2:

    # "Paráis a comer en King City. Pizza para todos. Idea de [bet]."
    "Vous vous arrêtez déjeuner à King City. Pizza pour tout le monde. Idée de [bet]."

# game/scripts/c24/c24.rpy:1367
translate french c24s003_Mar_ac4278e6:

    # "Después de charlar un rato y reposar la comida, seguís camino a casa."
    "Après avoir bavardé un moment et laissé le repas se digérer, vous reprenez le chemin du retour."

# game/scripts/c24/c24.rpy:1369
translate french c24s003_Mar_60eee3d4:

    # "Conduces tú después de comer. [emm] ha querido competir con [bet] comiendo pizza y se siente pesada."
    "Tu conduis après avoir mangé. [emm] voulait rivaliser avec [bet] en mangeant une pizza et se sent lourd."

# game/scripts/c24/c24.rpy:1372
translate french c24s003_Mar_8d1d0d97:

    # "En cuanto abres la puerta del garaje, aparece [mar] en la puerta de casa. Parece que os ha estado esperando."
    "Dès que vous ouvrez la porte du garage, [mar] apparaît devant votre porte d'entrée. Il semble qu'il vous attendait."

# game/scripts/c24/c24.rpy:1374
translate french c24s003_Mar_1b82c39b:

    # mom "Hola, [emm]. ¿Te lo has pasado bien con el coche?"
    mom "Salut, [emm]. As-tu passé un bon moment avec la voiture ?"

# game/scripts/c24/c24.rpy:1375
translate french c24s003_Mar_6d205f3c:

    # emm "Ha sido fantástico. Incluso hemos tenido un poco de tiempo para hacer turismo en Monterey."
    emm "C'était fantastique. Nous avons même eu un peu de temps pour faire du tourisme à Monterey."

# game/scripts/c24/c24.rpy:1376
translate french c24s003_Mar_57e1baed:

    # emm "¿Todo bien por aquí?"
    emm "Tout va bien ici ?"

# game/scripts/c24/c24.rpy:1377
translate french c24s003_Mar_7f0d05a4:

    # mom "Sí, cielo. Os he echado de menos. Déjame abrazar a Tía [bet]."
    mom "Oui, chérie. Vous m'avez tous manqué. Laisse-moi serrer tante dans mes bras [bet]."

# game/scripts/c24/c24.rpy:1379
translate french c24s003_Mar_cc2845ff:

    # mom "Felicidades por haberlo resuelto todo, Tía."
    mom "Félicitations pour avoir tout réglé, tante."

# game/scripts/c24/c24.rpy:1382
translate french c24s003_Mar_725c9f3b:

    # mom "Y bienvenida al harén."
    mom "Et bienvenue au harem."

# game/scripts/c24/c24.rpy:1384
translate french c24s003_Mar_da4826a4:

    # mom "Y por entrar en el harén de [mc]."
    mom "Et pour entrer dans le harem de [mc]."

# game/scripts/c24/c24.rpy:1386
translate french c24s003_Mar_2aee896c:

    # mom "Y por lo tuyo con [mc]."
    mom "Et à propos de ton histoire avec [mc]."

# game/scripts/c24/c24.rpy:1387
translate french c24s003_Mar_2d1c0355:

    # bet "Gracias, cielo. Ha sido un viaje muy intenso."
    bet "Merci, chérie. Ce fut un voyage très intense."

# game/scripts/c24/c24.rpy:1388
translate french c24s003_Mar_798c6d0d:

    # bet "Ve a abrazar a [mc]. Te veo ansiosa. [emm] y yo vamos a meter las maletas dentro."
    bet "Va faire un câlin à [mc]. Tu as l'air anxieux. [emm] et moi allons ranger les valises à l'intérieur."

# game/scripts/c24/c24.rpy:1390
translate french c24s003_Mar_b5bb3a83:

    # emm "¿No nos va a ayudar [mc]? ¡Yo tengo tres maletas!"
    emm "Vous n'allez pas nous aider ? J'ai trois valises !"

# game/scripts/c24/c24.rpy:1392
translate french c24s003_Mar_4307645b:

    # bet "Él las ha bajado de la camioneta."
    bet "Il les a sortis du camion."

# game/scripts/c24/c24.rpy:1393
translate french c24s003_Mar_29b2db10:

    # bet "Si quieres trabajar viajando tendrás que aprender a llevar menos equipaje. Esta es tu primera lección."
    bet "Si vous voulez travailler en voyageant, vous devrez apprendre à emporter moins de bagages. C'est votre première leçon."

# game/scripts/c24/c24.rpy:1394
translate french c24s003_Mar_b278f219:

    # bet "Yo subo una y tú otra. Después subes la tercera mientras yo recojo la mía."
    bet "J'en prends un, et tu en prends un autre. Ensuite, tu prends le troisième pendant que je prends le mien."

# game/scripts/c24/c24.rpy:1396
translate french c24s003_Mar_7ef7b476:

    # "[mar] te da un abrazo que sería la envidia de cualquier mamá oso."
    "[mar] te fait un câlin qui ferait l'envie de n'importe quelle maman ours."

# game/scripts/c24/c24.rpy:1397
translate french c24s003_Mar_9520bae5:

    # mom "Se me ha hecho muy largo no teneros por aquí."
    mom "Cela fait longtemps que je ne vous ai pas tous réunis ici."

# game/scripts/c24/c24.rpy:1398
translate french c24s003_Mar_9846dfae:

    # mc "Sólo ha sido un día. Pero me alegro de volver, y más con este recibimiento."
    mc "Cela ne fait qu'un jour. Mais je suis ravi d'être de retour, surtout avec cet accueil."

# game/scripts/c24/c24.rpy:1402
translate french c24s003_Mar_8e84404a:

    # "Tu madre te da un apasionado beso que te deja sin aliento."
    "Votre mère vous donne un baiser passionné qui vous laisse à bout de souffle."

# game/scripts/c24/c24.rpy:1404
translate french c24s003_Mar_4f036114:

    # "[mar] te da un apasionado beso que te deja sin aliento."
    "[mar] vous donne un baiser passionné qui vous laisse à bout de souffle."

# game/scripts/c24/c24.rpy:1406
translate french c24s003_Mar_c153a469:

    # mom "Ahora todo está mejor. Ya estáis en casa."
    mom "Tout va mieux maintenant. Tu es chez toi."

# game/scripts/c24/c24.rpy:1409
translate french c24s003_Mar_3f492dcd:

    # "Después de un largo abrazo..."
    "Après une longue étreinte..."

# game/scripts/c24/c24.rpy:1410
translate french c24s003_Mar_fee1222a:

    # mom "Hoy tienes tu primera cita con [kia], no lo olvides."
    mom "Aujourd'hui, c'est votre premier rendez-vous avec [kia], n'oubliez pas."

# game/scripts/c24/c24.rpy:1411
translate french c24s003_Mar_3f4dc75d:

    # mc "*Risa* No lo puedo olvidar, aunque para nosotros es la tercera. Salimos a comer y dimos un paseo."
    mc "*Rires* Je ne l'oublierai jamais, même si c'est la troisième fois. Nous sommes allés manger au restaurant et nous avons fait une promenade."

# game/scripts/c24/c24.rpy:1412
translate french c24s003_Mar_86c2bfee:

    # mom "¿Dónde vais a ir?"
    mom "Où vas-tu?"

# game/scripts/c24/c24.rpy:1413
translate french c24s003_Mar_c6bff8c9:

    # mc "No tengo ni idea. Me dijo que lo organizaba ella, con lo que es una sorpresa también para mí."
    mc "Je n'en ai aucune idée. Elle m'avait dit qu'elle l'organisait, alors c'est une surprise pour moi aussi."

# game/scripts/c24/c24.rpy:1415
translate french c24s003_Mar_941e8bf1:

    # mom "Ah, por eso me estuvo preguntando por restaurantes bonitos. ¡Seré tonta!"
    mom "Ah, c'est pour ça qu'il me demandait des recommandations de bons restaurants. Je suis vraiment bête !"

# game/scripts/c24/c24.rpy:1416
translate french c24s003_Mar_1bbfa337:

    # mom "El único que conozco es el de la cueva al que me llevaste. Parece que hace mil años."
    mom "La seule que je connaisse, c'est celle de la grotte où tu m'as emmené. J'ai l'impression que c'était il y a mille ans."

# game/scripts/c24/c24.rpy:1418
translate french c24s003_Mar_c696b1b4:

    # mom "Pero ese no se lo voy a recomendar a nadie. Ese es nuestro. Nuestra primera cita, aunque no saliéramos juntos aún."
    mom "Mais je ne le recommanderais à personne. C'est notre rendez-vous. Notre premier rendez-vous, même si on n'était pas encore ensemble."

# game/scripts/c24/c24.rpy:1419
translate french c24s003_Mar_7518d039:

    # mc "Un día tenemos que volver a ese sitio. Fue una noche fantástica."
    mc "Il faudra qu'on y retourne un jour. C'était une soirée fantastique."

# game/scripts/c24/c24.rpy:1421
translate french c24s003_Mar_693f7f38:

    # mom "Estoy segura de que, te lleve donde te lleve [kia] también os lo vais a pasar muy bien."
    mom "Je suis sûr que où que cela te mène [kia] tu passeras un excellent moment."

# game/scripts/c24/c24.rpy:1422
translate french c24s003_Mar_77981c86:

    # mom "Ayer estaba nerviosa por la cita."
    mom "Hier, j'étais nerveuse à propos de ce rendez-vous."

# game/scripts/c24/c24.rpy:1423
translate french c24s003_Mar_2f7cf5dc:

    # mc "A lo mejor debería hablar con ella antes..."
    mc "Peut-être devrais-je lui parler d'abord..."

# game/scripts/c24/c24.rpy:1425
translate french c24s003_Mar_07317058:

    # mom "No creo que tengas mucho tiempo para eso. Está trabajando y supongo que, cuando vuelva a casa, se querrá poner guapa para ti."
    mom "Je ne pense pas que tu aies beaucoup de temps pour ça. Elle travaille, et j'imagine qu'elle voudra se faire belle pour toi en rentrant."

# game/scripts/c24/c24.rpy:1426
translate french c24s003_Mar_2bed33bd:

    # mom "Los nervios se le pasarán en cuanto la recojas."
    mom "Ses nerfs disparaîtront dès que vous la prendrez dans vos bras."

# game/scripts/c24/c24.rpy:1427
translate french c24s003_Mar_100c80b0:

    # mc "*Risa* Espero que también se me pasen a mí."
    mc "*Rires* J'espère qu'ils passeront pour moi aussi."

# game/scripts/c24/c24.rpy:1429
translate french c24s003_Mar_5874c68b:

    # mom "*Risa* Bueno, ve a descansar un rato antes de esa cita."
    mom "*Rires* Bon, va te reposer avant ce rendez-vous."

# game/scripts/c24/c24.rpy:1431
translate french c24s003_Mar_10c61dcb:

    # mom "Será mejor que vayas a descansar un rato antes de la cena."
    mom "Tu ferais mieux d'aller te reposer un peu avant le dîner."

# game/scripts/c24/c24.rpy:1432
translate french c24s003_Mar_8bb863a8:

    # mom "Dame la mochila. Bajaré a dejar la ropa en la lavadora."
    mom "Donne-moi le sac à dos. Je vais descendre mettre les vêtements dans la machine à laver."

# game/scripts/c24/c24.rpy:1433
translate french c24s003_Mar_7ce5b618:

    # mom "Veo que al final te has puesto la camisa azul. *Risa*"
    mom "Je vois que tu as enfin mis la chemise bleue. *Rires*"

# game/scripts/c24/c24.rpy:1435
translate french c24s003_Mar_03172388:

    # mc "*Risa* Si, te veo luego."
    mc "*Rires* Oui, à plus tard."

# game/scripts/c24/c24.rpy:1441
translate french c24s003_NoKia_e8c88a3a:

    # "Subes a tu habitación a dejar tus cosas y aprovechas para jugar un rato a My Residence."
    "Vous montez dans votre chambre pour y déposer vos affaires et en profitez pour jouer un peu à My Residence."

# game/scripts/c24/c24.rpy:1442
translate french c24s003_NoKia_55699688:

    # "Hoy toca cita con Claire, la preciosa irlandesa que es la madre de la exnovia del protagonista."
    "Aujourd'hui, nous avons rendez-vous avec Claire, la belle Irlandaise qui est la mère de l'ex-petite amie du protagoniste."

# game/scripts/c24/c24.rpy:1443
translate french c24s003_NoKia_c128ba42:

    # "Hay una tórrida escena en la ducha que crees que rejugarás varias veces en la galería."
    "Il y a une scène de douche torride que vous aurez envie de revoir plusieurs fois dans la galerie."

# game/scripts/c24/c24.rpy:1445
translate french c24s003_NoKia_90b73b27:

    # "Después de cenar, te retiras a tu habitación, donde lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Après le dîner, vous vous retirez dans votre chambre, où vous lisez quelques documents que [ama] vous a envoyés à propos d'Iron Fist."

# game/scripts/c24/c24.rpy:1446
translate french c24s003_NoKia_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Vous devez être prêt pour la réunion de demain sur le yacht."

# game/scripts/c24/c24.rpy:1447
translate french c24s003_NoKia_14a02826:

    # "Es información muy aburrida y te quedas dormido mientras la lees."
    "Ce sont des informations très ennuyeuses et on s'endort en les lisant."

# game/scripts/c24/c24.rpy:1448
translate french c24s003_NoKia_479b95c0:

    # centered "{size=+20}{b}DÍA 26 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}JOUR 26 – SAMEDI{/b}{/size}"

# game/scripts/c24/c24.rpy:1450
translate french c24s003_NoKia_7e47640e:

    # "Te levantas muy tarde, casi a mediodía. Debías estar más cansado de lo que creías."
    "Tu te lèves très tard, presque à midi. Tu devais être plus fatigué que tu ne le pensais."

# game/scripts/c24/c24.rpy:1459
translate french c24s003_KiaDate_2237f21b:

    # "Subes a tu habitación a dejar tus cosas y lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Vous montez dans votre chambre pour ranger vos affaires et lire quelques documents que [ama] vous a envoyés à propos d'Iron Fist."

# game/scripts/c24/c24.rpy:1460
translate french c24s003_KiaDate_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Vous devez être prêt pour la réunion de demain sur le yacht."

# game/scripts/c24/c24.rpy:1461
translate french c24s003_KiaDate_06007255:

    # "Cuando se acerca la hora de tu cita, te das una ducha y te cambias. No sabes dónde vais a ir, con lo que eliges algo que pueda ir bien en casi cualquier sitio."
    "À l'approche de votre rendez-vous, vous prenez une douche et vous vous habillez. Ne sachant pas où vous allez, vous choisissez une tenue passe-partout."

# game/scripts/c24/c24.rpy:1464
translate french c24s003_KiaDate_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c24/c24.rpy:1465
translate french c24s003_KiaDate_93c9ba13:

    # kia "*A través de la puerta* Soy yo, ¿puedo pasar?"
    kia "*À travers la porte* C'est moi, puis-je entrer ?"

# game/scripts/c24/c24.rpy:1467
translate french c24s003_KiaDate_4d601f0e:

    # mc "Sí, pasa."
    mc "Oui, ça arrive."

# game/scripts/c24/c24.rpy:1473
translate french c24s003_KiaDate_7cf199b5:

    # mc "¡Wow, [kia]! ¡Estás preciosa!"
    mc "Waouh, [kia] ! Tu es magnifique !"

# game/scripts/c24/c24.rpy:1474
translate french c24s003_KiaDate_0018e517:

    # kia "Gracias, [mc]. Tú también estás muy guapo."
    kia "Merci, [mc]. Vous êtes très beau vous aussi."

# game/scripts/c24/c24.rpy:1475
translate french c24s003_KiaDate_0ad25d4f:

    # kia "¿Estás preparado para irnos?"
    kia "Êtes-vous prêt à partir ?"

# game/scripts/c24/c24.rpy:1476
translate french c24s003_KiaDate_75d3cb24:

    # mc "Cuando tú quieras. ¿Dónde vamos a ir? ¿Voy bien así?"
    mc "Quand tu veux. Où est-ce qu'on va ? Est-ce que ça me convient comme ça ?"

# game/scripts/c24/c24.rpy:1478
translate french c24s003_KiaDate_8e87288a:

    # kia "Estás perfecto."
    kia "Tu es parfaite."

# game/scripts/c24/c24.rpy:1479
translate french c24s003_KiaDate_85bd524c:

    # kia "Voy a ser la envidia de todas las mujeres."
    kia "Je vais faire des envieuses parmi les femmes."

# game/scripts/c24/c24.rpy:1480
translate french c24s003_KiaDate_5ff2e895:

    # mc "Y a mí me van a envidiar todos los hombres vayamos donde vayamos."
    mc "Et tous les hommes m'envieront où que nous allions."

# game/scripts/c24/c24.rpy:1482
translate french c24s003_KiaDate_bfcf7a77:

    # kia "*Risa* Van a pensar que sales a cenar con tu madre. Nada envidiable."
    kia "*Rires* Ils vont croire que tu vas dîner avec ta mère. Pas du tout enviable."

# game/scripts/c24/c24.rpy:1485
translate french c24s003_KiaDate_4930ddd9:

    # kia "¡Oh! No me refería a [mar] y a ti. Hacéis una pareja perfecta."
    kia "Oh ! Je ne parlais pas de toi. Vous formez un couple parfait."

# game/scripts/c24/c24.rpy:1486
translate french c24s003_KiaDate_1268706e:

    # mc "Ya lo sé. Entiendo a lo que te refieres y, aunque no seas mi madre, te aseguro que cualquier hombre querría estar en mi posición hoy."
    mc "Je sais. Je comprends ce que vous voulez dire, et même si vous n'êtes pas ma mère, je vous assure que n'importe quel homme voudrait être à ma place aujourd'hui."

# game/scripts/c24/c24.rpy:1487
translate french c24s003_KiaDate_b8ec88c3:

    # mc "Si piensan que eres mi madre y que además estamos saliendo juntos, más hombres aún me van a envidiar. Ya sabes, fetiche con el incesto..." id c24s003_KiaDate_b8ec88c3
    mc "S'ils pensent que tu es ma mère et qu'on sort ensemble, encore plus d'hommes vont m'envier. Tu sais, le fétichisme de l'inceste..." id c24s003_KiaDate_b8ec88c3

# game/scripts/c24/c24.rpy:1488
translate french c24s003_KiaDate_5bb546fa:

    # mc "La mitad de los hombres del mundo darían lo que fuera por tener una madre como tú y poder hacer esto con ella."
    mc "La moitié des hommes du monde donneraient n'importe quoi pour avoir une mère comme toi et pouvoir faire ça avec elle."

# game/scripts/c24/c24.rpy:1490
translate french c24s003_KiaDate_33452344:

    # "Sin dejarle reaccionar, la coges entre tus brazos y dejas que tus labios recorran los suyos."
    "Sans lui laisser le temps de réagir, vous la prenez dans vos bras et laissez vos lèvres effleurer les siennes."

# game/scripts/c24/c24.rpy:1491
translate french c24s003_KiaDate_83561e84:

    # "Tras un segundo de sorpresa, la hermosa pelirroja entreabre su boca y deja que su lengua empiece a jugar con la tuya."
    "Après une seconde de surprise, la belle rousse entrouvre la bouche et laisse sa langue commencer à jouer avec la vôtre."

# game/scripts/c24/c24.rpy:1493
translate french c24s003_KiaDate_721bb120:

    # kia "¡Hey! ¡Para! Tenemos una reserva para cenar, y quiero una cena tranquila."
    kia "Hé ! Stop ! Nous avons une réservation pour dîner, et je veux un dîner tranquille."

# game/scripts/c24/c24.rpy:1494
translate french c24s003_KiaDate_09d5b8a8:

    # mc "*Risa* ¿Te pones nerviosa cenando?"
    mc "*Rires* Êtes-vous nerveux(se) lorsque vous dînez ?"

# game/scripts/c24/c24.rpy:1496
translate french c24s003_KiaDate_d620db7b:

    # kia "*Risa* No, idiota. Pero si empiezas así antes de que nos vayamos, no voy a poder pensar en otra cosa mientras cenamos."
    kia "*Rires* Non, idiot. Mais si tu commences comme ça avant même qu'on parte, je ne pourrai penser à rien d'autre pendant le dîner."

# game/scripts/c24/c24.rpy:1497
translate french c24s003_KiaDate_0d0f8a07:

    # mc "Eres consciente de que, aunque estemos en un restaurante, podemos besarnos, ¿verdad?"
    mc "Tu sais bien que même si on est au restaurant, on peut s'embrasser, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1499
translate french c24s003_KiaDate_18057fc8:

    # kia "Sí, lo sé. Y seguramente te besaré. Pero no serán besos así."
    kia "Oui, je sais. Et je t'embrasserai probablement. Mais ce ne seront pas des baisers de ce genre."

# game/scripts/c24/c24.rpy:1500
translate french c24s003_KiaDate_ce099bae:

    # kia "Nunca me han gustado las parejas que se enrollan en público. Son cosas que se tienen que hacer en la intimidad."
    kia "Je n'ai jamais aimé les couples qui s'embrassent langoureusement en public. Ce sont des choses qui devraient se faire en privé."

# game/scripts/c24/c24.rpy:1501
translate french c24s003_KiaDate_f2bcde51:

    # mc "Me parece bien. A mí nunca me han importado, pero si a ti no te gusta esperaré a disfrutar de tus labios."
    mc "Ça me va. Ça ne m'a jamais dérangé, mais si ça ne te plaît pas, j'attendrai avant de savourer tes lèvres."

# game/scripts/c24/c24.rpy:1503
translate french c24s003_KiaDate_3be31b74:

    # kia "Tengo pensado pedir una ensalada de aguacate, con lo que espero que te siga gustando la combinación con mi pintalabios."
    kia "Je compte commander une salade d'avocat, j'espère donc que vous aimerez toujours l'association avec mon rouge à lèvres."

# game/scripts/c24/c24.rpy:1504
translate french c24s003_KiaDate_8666bcd5:

    # mc "Me gustaría aunque no llevaras pintalabios. Aunque no comieras aguacate."
    mc "Je l'aimerais même si tu ne portais pas de rouge à lèvres. Même si tu ne mangeais pas d'avocat."

# game/scripts/c24/c24.rpy:1506
translate french c24s003_KiaDate_aafcc2ca:

    # kia "Entonces vámonos antes de que te tenga que volver a besar."
    kia "Alors allons-y avant que je sois obligée de t'embrasser à nouveau."

# game/scripts/c24/c24.rpy:1507
translate french c24s003_KiaDate_d2aa7bb0:

    # mc "Me tendrás que decir dónde vamos si tengo que conducir hasta allí. ¿O vamos a coger un Under?"
    mc "Il faudra que tu me dises où on va si je dois y aller en voiture. Ou alors on passe sous terre ?"

# game/scripts/c24/c24.rpy:1509
translate french c24s003_KiaDate_606649cc:

    # kia "Conduzco yo. Le he pedido el coche a [mar]. Vamos a un par de sitios donde coger un Under sería complicado."
    kia "Je conduis. J'ai emprunté la voiture à [mar]. On va dans quelques endroits où passer sous la barre des 50 km/h serait difficile."

# game/scripts/c24/c24.rpy:1510
translate french c24s003_KiaDate_d3f0e0fb:

    # mc "¡Oh! Eso quiere decir que no quieres revelar la sorpresa."
    mc "Oh ! Cela signifie que vous ne voulez pas dévoiler la surprise."

# game/scripts/c24/c24.rpy:1512
translate french c24s003_KiaDate_4f1d7478:

    # kia "Exacto. Ya he dejado la bolsa y el bolso en el coche."
    kia "Exactement. J'ai déjà laissé mon sac et mon sac à main dans la voiture."

# game/scripts/c24/c24.rpy:1513
translate french c24s003_KiaDate_03682c61:

    # mc "¿Bolsa? ¿Para qué necesitas una bolsa?"
    mc "Un sac ? Pourquoi as-tu besoin d'un sac ?"

# game/scripts/c24/c24.rpy:1514
translate french c24s003_KiaDate_9171ef72:

    # kia "Esa es la segunda sorpresa de esta noche."
    kia "Voilà la deuxième surprise de la soirée."

# game/scripts/c24/c24.rpy:1516
translate french c24s003_KiaDate_050a880b:

    # "[kia] conduce durante 20 minutos antes de aparcar el coche en lo que parece una viejo edificio."
    "[kia] conduit pendant 20 minutes avant de garer la voiture dans ce qui ressemble à un vieux bâtiment."

# game/scripts/c24/c24.rpy:1517
translate french c24s003_KiaDate_36c8bdc3:

    # "Por alguna razón, acabas cargando con su bolso."
    "Pour une raison ou une autre, tu finis par porter son sac."

# game/scripts/c24/c24.rpy:1519
translate french c24s003_KiaDate_5dc99045:

    # "Cuando entráis al restaurante está totalmente vacío. Es muy pronto para cenar."
    "Quand vous entrez dans le restaurant, il est complètement vide. Il est trop tôt pour dîner."

# game/scripts/c24/c24.rpy:1520
translate french c24s003_KiaDate_3220c059:

    # kia "Ya hemos llegado. Creo que no debes conocer este sitio. Lo abrieron mientras estabas en Portland."
    kia "Nous sommes là. Je ne crois pas que vous soyez déjà venu. Ça a ouvert pendant que vous étiez à Portland."

# game/scripts/c24/c24.rpy:1521
translate french c24s003_KiaDate_eb55958c:

    # kia "Y ninguna de las chicas lo conocía, con lo que seguramente no habrás venido nunca."
    kia "Et aucune des filles ne le connaissait, donc vous n'êtes probablement jamais venu ici."

# game/scripts/c24/c24.rpy:1522
translate french c24s003_KiaDate_44e12ef9:

    # mc "No, no he venido nunca. No sabía ni que habían hecho un restaurante en este viejo almacén."
    mc "Non, je ne suis jamais venu ici. Je ne savais même pas qu'ils avaient transformé cet ancien entrepôt en restaurant."

# game/scripts/c24/c24.rpy:1524
translate french c24s003_KiaDate_e57afa09:

    # kia "Las fotos de internet parecían muy bonitas y le hacen justicia. Espero que te guste."
    kia "Les photos que j'ai trouvées en ligne sont vraiment jolies et lui rendent bien justice. J'espère que vous l'aimerez."

# game/scripts/c24/c24.rpy:1525
translate french c24s003_KiaDate_e47f72b7:

    # mc "Me gustaría aunque fuera tu carrito de perritos calientes favorito."
    mc "Je l'aimerais même si c'était ton stand de hot-dogs préféré."

# game/scripts/c24/c24.rpy:1526
translate french c24s003_KiaDate_94812cb4:

    # mc "Me importa estar aquí contigo. Me da lo mismo dónde sea 'aquí'."
    mc "Ça compte pour moi d'être ici avec toi. Peu importe où se trouve ce « ici »."

# game/scripts/c24/c24.rpy:1527
translate french c24s003_KiaDate_3e238f06:

    # mc "Pero es pronto para cenar, ¿no?"
    mc "Mais il est trop tôt pour dîner, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1529
translate french c24s003_KiaDate_5c661d6f:

    # kia "Quiero acabar de cenar pronto para llevarte a un sitio."
    kia "Je veux finir de dîner tôt pour pouvoir t'emmener quelque part."

# game/scripts/c24/c24.rpy:1530
translate french c24s003_KiaDate_5c4c9c2b:

    # mc "Eso suena interesante. ¿Es para ese sitio la bolsa?"
    mc "Ça a l'air intéressant. C'est la bourse de ce site ?"

# game/scripts/c24/c24.rpy:1531
translate french c24s003_KiaDate_91ddeff0:

    # kia "Sí, y no preguntes qué hay dentro."
    kia "Oui, et ne demandez pas ce qu'il y a à l'intérieur."

# game/scripts/c24/c24.rpy:1532
translate french c24s003_KiaDate_b3621a01:

    # mc "*Risa* Estoy empezando a ponerme nervioso por esa sorpresa."
    mc "*Rires* Je commence à être nerveuse à l'idée de cette surprise."

# game/scripts/c24/c24.rpy:1534
translate french c24s003_KiaDate_708aa274:

    # kia "No hace falta que te pongas nervioso. Es uno de mis lugares favoritos de Newport. E ir esta noche contigo me apetece mucho."
    kia "Il n'y a pas de quoi s'inquiéter. C'est un de mes endroits préférés à Newport. Et j'aimerais beaucoup y aller avec toi ce soir."

# game/scripts/c24/c24.rpy:1535
translate french c24s003_KiaDate_24fdb8f4:

    # mc "Entonces vamos a cenar. Casi tengo ganas de ir a ver tu sitio favorito."
    mc "Alors allons dîner. J'ai presque envie d'aller dans ton restaurant préféré."

# game/scripts/c24/c24.rpy:1538
translate french c24s003_KiaDate_77bca2e2:

    # wai "Buenas noches, perdón por la espera. ¿Tenían reserva?"
    wai "Bonsoir, désolé pour l'attente. Aviez-vous une réservation ?"

# game/scripts/c24/c24.rpy:1539
translate french c24s003_KiaDate_9f4e6521:

    # kia "Sí, a nombre de [kia] Wellesley."
    kia "Oui, au nom de [kia] Wellesley."

# game/scripts/c24/c24.rpy:1540
translate french c24s003_KiaDate_5b089228:

    # wai "Sí, acompáñeme, por favor."
    wai "Oui, venez avec moi."

# game/scripts/c24/c24.rpy:1542
translate french c24s003_KiaDate_4c334347:

    # "La camarera os acompaña a la mesa y os entrega los menús."
    "La serveuse vous accompagne à votre table et vous apporte les menus."

# game/scripts/c24/c24.rpy:1543
translate french c24s003_KiaDate_8ca89980:

    # mc "¿Wellesley?"
    mc "Wellesley ?"

# game/scripts/c24/c24.rpy:1544
translate french c24s003_KiaDate_e21185a8:

    # kia "Sí. No pienso usar nunca más el apellido Lamb, si puedo evitarlo. Quiero recuperar mi apellido de soltera."
    kia "Oui. Je n'ai pas l'intention de réutiliser le nom de famille Lamb, si je peux l'éviter. Je souhaite reprendre mon nom de jeune fille."

# game/scripts/c24/c24.rpy:1545
translate french c24s003_KiaDate_79b41575:

    # mc "Me parece una gran idea. Creo que brindaré por ello en cuanto nos traigan el vino."
    mc "Ça me paraît une excellente idée. Je crois que je porterai un toast à ça dès qu'ils nous auront apporté le vin."

# game/scripts/c24/c24.rpy:1547
translate french c24s003_KiaDate_47bed3e8:

    # kia "No voy a beber vino, [mc]. Hoy conduzco yo, y no quiero que la noche acabe con el coche de [mar] en la cuneta o nosotros detenidos."
    kia "Je ne vais pas boire de vin, [mc]. Je conduis ce soir, et je ne veux pas que la soirée se termine avec la voiture de [mar] dans le fossé ou qu'on se fasse arrêter par la police."

# game/scripts/c24/c24.rpy:1548
translate french c24s003_KiaDate_8871f35d:

    # kia "Pero tú puedes beber si quieres."
    kia "Mais vous pouvez boire si vous le souhaitez."

# game/scripts/c24/c24.rpy:1549
translate french c24s003_KiaDate_2af4c5b6:

    # mc "No me apetece beber si no lo haces tú pero, si quieres, podemos pedir mosto. Veo que tienen en la carta. No es lo mismo, pero..."
    mc "Je n'ai pas envie de boire, sauf si tu en as envie, mais si tu veux, on peut commander du jus de raisin. Je vois qu'il est à la carte. Ce n'est pas pareil, mais…"

# game/scripts/c24/c24.rpy:1551
translate french c24s003_KiaDate_1f8250a7:

    # kia "Nunca lo he probado. ¿Sabe a vino?"
    kia "Je n'y ai jamais goûté. Est-ce que ça a le goût du vin ?"

# game/scripts/c24/c24.rpy:1552
translate french c24s003_KiaDate_8aa61e12:

    # mc "No. *Risa* Es mucho más dulce. Básicamente es zumo de uva."
    mc "Non. *Rires* C'est beaucoup plus sucré. C'est essentiellement du jus de raisin."

# game/scripts/c24/c24.rpy:1553
translate french c24s003_KiaDate_8eccb780:

    # kia "*Risa* Entonces sí que lo he probado. Bebía mucho zumo de uva cuando era niña. Me gustaba. Y voy a cambiar la ensalada por filete."
    kia "*Rires* Alors, j'ai essayé. Je buvais beaucoup de jus de raisin quand j'étais enfant. J'aimais ça. Et je vais remplacer la salade par un steak."

# game/scripts/c24/c24.rpy:1554
translate french c24s003_KiaDate_b63d19d6:

    # mc "Entonces no se hable más. Zumo de uva y filete para la señora. Echaré de menos el aguacate."
    mc "Voilà qui est décidé. Jus de raisin et steak pour Madame. L'avocat va me manquer."

# game/scripts/c24/c24.rpy:1555
translate french c24s003_KiaDate_514b4ad6:

    # "Miras la carta durante un momento."
    "Vous regardez la lettre un instant."

# game/scripts/c24/c24.rpy:1556
translate french c24s003_KiaDate_80a7d886:

    # mc "Y zumo de uva y pollo para mí."
    mc "Et du jus de raisin et du poulet pour moi."

# game/scripts/c24/c24.rpy:1558
translate french c24s003_KiaDate_22e872b3:

    # "Después de que la camarera os tome nota..."
    "Une fois que la serveuse a pris votre commande..."

# game/scripts/c24/c24.rpy:1559
translate french c24s003_KiaDate_ec2f9a24:

    # kia "Llevo desde el día que comimos juntos queriendo salir a cenar contigo."
    kia "Depuis le jour où nous avons déjeuné ensemble, j'ai envie d'aller dîner avec toi."

# game/scripts/c24/c24.rpy:1560
translate french c24s003_KiaDate_9e42db99:

    # mc "Han sido unos días muy ocupados. Siento que no haya podido ser antes."
    mc "Ces derniers jours ont été très chargés. Je suis désolé que cela n'ait pas pu être plus tôt."

# game/scripts/c24/c24.rpy:1561
translate french c24s003_KiaDate_5b3de040:

    # mc "¿Le has dicho a Geneviève que salimos a cenar? ¿Sigue pensando que me quiero aprovechar de ti?"
    mc "As-tu dit à Geneviève que nous allions dîner au restaurant ? Pense-t-elle encore que j’essaie de profiter de toi ?"

# game/scripts/c24/c24.rpy:1563
translate french c24s003_KiaDate_89718c77:

    # kia "No, al menos no me ha dicho nada más. Cuando te fuiste se disculpó por meterse donde no le llamaban."
    kia "Non, au moins il ne m'a rien dit d'autre. Quand tu es parti, il s'est excusé de s'être mêlé de ce qui ne le regardait pas."

# game/scripts/c24/c24.rpy:1564
translate french c24s003_KiaDate_70432cf4:

    # kia "Pero no hemos vuelto a hablar de ti."
    kia "Mais nous n'avons plus parlé de vous depuis."

# game/scripts/c24/c24.rpy:1565
translate french c24s003_KiaDate_a9d6a22b:

    # mc "Cuando me fui pensé que quizás había sido un poco duro con ella. Solo estaba intentando cuidar de ti. Protegerte."
    mc "En partant, je me suis dit que j'avais peut-être été un peu dure avec elle. J'essayais juste de prendre soin de toi, de te protéger."

# game/scripts/c24/c24.rpy:1567
translate french c24s003_KiaDate_3e5fbbb7:

    # kia "Sus intenciones eran buenas, [mc], pero la forma de hacerlo no."
    kia "Ses intentions étaient bonnes, [mc], mais sa façon de faire ne l'était pas."

# game/scripts/c24/c24.rpy:1568
translate french c24s003_KiaDate_7e77b0fb:

    # kia "No debería juzgarte sin conocerte. Y si te conociera..."
    kia "Je ne devrais pas te juger sans te connaître. Et si je te connaissais…"

# game/scripts/c24/c24.rpy:1571
translate french c24s003_KiaDate_7ff36164:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, habría que hacerle un hueco en el harén."
    kia "*Rires* Si elle n'était pas jeune mariée et amoureuse de son mari, il faudrait lui faire une place dans le harem."

# game/scripts/c24/c24.rpy:1573
translate french c24s003_KiaDate_58c340bc:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, seguramente me pediría compartirte."
    kia "*Rires* Si elle n'était pas jeune mariée et amoureuse de son mari, elle me demanderait sûrement de te partager."

# game/scripts/c24/c24.rpy:1574
translate french c24s003_KiaDate_4cb32db6:

    # kia "*Risa* Con lo que prefiero que no te conozca a fondo. Nos pasaríamos el día hablando de ti en la biblioteca."
    kia "*Rires* C'est pourquoi je préfère ne pas trop te connaître. On passerait la journée à parler de toi à la bibliothèque."

# game/scripts/c24/c24.rpy:1575
translate french c24s003_KiaDate_5067e76e:

    # mc "*Risa* Lo dices como si las mujeres cayeran a mis pies a los cinco minutos de conocerme."
    mc "*Rires* Tu dis ça comme si les femmes tombaient à mes pieds cinq minutes après m'avoir rencontré."

# game/scripts/c24/c24.rpy:1577
translate french c24s003_KiaDate_e8271815:

    # kia "*Risa* Bueno, yo tardé cinco días viviendo en la misma casa. O en la de [nor] para ser más exactos."
    kia "*Rires* Eh bien, il m'a fallu cinq jours à vivre dans la même maison. Ou chez [nor], pour être plus précis."

# game/scripts/c24/c24.rpy:1578
translate french c24s003_KiaDate_13e7e7dc:

    # mc "Tú me conocías de antes. Sabías cómo era."
    mc "Tu me connaissais avant. Tu savais comment j'étais."

# game/scripts/c24/c24.rpy:1580
translate french c24s003_KiaDate_edcd5283:

    # "La camarera interrumpe vuestra conversación trayendo vuestro pedido. Continuáis en cuanto se va."
    "La serveuse interrompt votre conversation en apportant votre commande. Vous reprenez votre discussion dès qu'elle est partie."

# game/scripts/c24/c24.rpy:1581
translate french c24s003_KiaDate_489d1cf1:

    # kia "Aunque te conociera de antes, nunca me hubiera planteado estar aquí contigo."
    kia "Même si je t'avais connu auparavant, je n'aurais jamais imaginé être ici avec toi."

# game/scripts/c24/c24.rpy:1582
translate french c24s003_KiaDate_ecaeda33:

    # kia "No, [mc]. No eres el mismo chico que conocí. Hay que ver el hombre en el que te has convertido para entender lo que siento."
    kia "Non, [mc]. Tu n'es plus le même garçon que j'ai connu. Il faut que tu voies l'homme que tu es devenu pour comprendre ce que je ressens."

# game/scripts/c24/c24.rpy:1583
translate french c24s003_KiaDate_b2516466:

    # mc "Gracias."
    mc "Merci."

# game/scripts/c24/c24.rpy:1585
translate french c24s003_KiaDate_7fb94f8f:

    # kia "Y no solo me refiero a cómo eres conmigo o a las dos veces que te enfrentaste a Solomon."
    kia "Et je ne fais pas seulement référence à la façon dont vous vous comportez avec moi ou aux deux fois où vous avez confronté Salomon."

# game/scripts/c24/c24.rpy:1586
translate french c24s003_KiaDate_4cfeb268:

    # kia "Cómo trataste al Decano para defender a [mar]. Cómo solucionaste el tema con el antiguo novio de [eri]."
    kia "Comment avez-vous géré la situation avec le doyen pour défendre [mar] ? Comment avez-vous réglé le problème avec l'ex-petit ami de [eri] ?"

# game/scripts/c24/c24.rpy:1587
translate french c24s003_KiaDate_96302297:

    # kia "Cómo actuaste con el novio de la madre de [sca]. O cómo has solucionado lo de [bet]."
    kia "Comment avez-vous réagi face au petit ami de la mère de [sca] ? Ou comment avez-vous résolu la situation de [bet] ?"

# game/scripts/c24/c24.rpy:1589
translate french c24s003_KiaDate_949b0c0b:

    # kia "Todo eso no lo hace un chico. Son cosas que hace un hombre que toma las riendas cuando debe."
    kia "Un garçon ne fait pas tout ça. Ce sont des choses qu'un homme fait lorsqu'il prend les rênes."

# game/scripts/c24/c24.rpy:1590
translate french c24s003_KiaDate_baea7e73:

    # mc "*Risa* Me vas a hacer ruborizar."
    mc "*Rires* Tu vas me faire rougir."

# game/scripts/c24/c24.rpy:1591
translate french c24s003_KiaDate_31c784a3:

    # mc "No lo he hecho todo solo. [mar] ayudó mucho con el Decano. [eva] y [ama] con Solomon y Kevin..."
    mc "Je n'ai pas tout fait seul. [mar] m'a beaucoup aidé avec le doyen. [eva] et [ama] avec Solomon et Kevin..."

# game/scripts/c24/c24.rpy:1593
translate french c24s003_KiaDate_a795c765:

    # kia "A eso me refiero. No sólo haces lo que tienes que hacer. Nos das ejemplo a las demás y nos inspiras para que nosotras hagamos lo que debemos."
    kia "C'est exactement ce que je veux dire. Tu ne te contentes pas de faire le strict minimum. Tu montres l'exemple et tu nous inspires à faire ce que nous devrions faire."

# game/scripts/c24/c24.rpy:1594
translate french c24s003_KiaDate_532f5c8b:

    # mc "*Risa* ¡Joder, [kia]! Haces que parezca el líder de una secta."
    mc "*Rires* Zut alors, [kia] ! Tu me fais passer pour le chef d'une secte."

# game/scripts/c24/c24.rpy:1596
translate french c24s003_KiaDate_cee6e392:

    # kia "Mas o menos. *Risa* Has creado una familia de elección a tu alrededor."
    kia "Plus ou moins. *Rires* Tu t'es créé une famille de cœur."

# game/scripts/c24/c24.rpy:1598
translate french c24s003_KiaDate_976b3965:

    # kia "Y no me refiero solo a las mujeres que estamos contigo. No eres el líder de esa familia. Pero eres el centro."
    kia "Et je ne parle pas seulement des femmes qui sont avec toi. Tu n'es pas le chef de cette famille, mais tu en es le centre."

# game/scripts/c24/c24.rpy:1600
translate french c24s003_KiaDate_fab6b4e0:

    # kia "Y aunque no seas el líder de esa familia, pero eres el centro..."
    kia "Et même si vous n'êtes pas le chef de cette famille, vous en êtes toujours le centre..."

# game/scripts/c24/c24.rpy:1601
translate french c24s003_KiaDate_14d6182a:

    # kia "Eres el factor común para todas nosotras. De [kat] a [mee], pasando por mí o por [mar]."
    kia "Tu es le point commun entre nous tous. De [kat] à [mee], en passant par moi ou [mar]."

# game/scripts/c24/c24.rpy:1602
translate french c24s003_KiaDate_ef310305:

    # mc "¿[kat]? Ella ya iba a venir a casa antes de que yo volviera de la universidad."
    mc "[kat]? Elle rentrait déjà à la maison avant même que je ne revienne de l'université."

# game/scripts/c24/c24.rpy:1604
translate french c24s003_KiaDate_be7cdbc8:

    # kia "Sí, pero antes de que llegaran las chicas ya habías creado el ambiente que hay ahora."
    kia "Oui, mais avant l'arrivée des filles, vous aviez déjà créé l'atmosphère qui règne aujourd'hui."

# game/scripts/c24/c24.rpy:1605
translate french c24s003_KiaDate_3424a685:

    # kia "Sólo con la familia cercana, pero suficiente para que fuera fácil que ellas se sumaran. Después nos hemos sumado el resto."
    kia "Tout a commencé avec la famille proche, mais cela a suffi pour qu'ils se joignent facilement à nous. Puis, le reste d'entre nous nous sommes joints à nous."

# game/scripts/c24/c24.rpy:1606
translate french c24s003_KiaDate_e0583063:

    # mc "No hice nada de eso, [kia]. Me encanta que me veas así, pero no me puedo otorgar el mérito."
    mc "Je n'ai rien fait de tout ça, [kia]. J'adore que tu me voies ainsi, mais je ne peux pas m'en attribuer le mérite."

# game/scripts/c24/c24.rpy:1607
translate french c24s003_KiaDate_3391d298:

    # mc "Además, estamos hablando mucho de la familia y poco de nosotros."
    mc "De plus, nous parlons beaucoup de famille et très peu de nous-mêmes."

# game/scripts/c24/c24.rpy:1609
translate french c24s003_KiaDate_320e7130:

    # kia "Me da un poco de miedo hablar de nosotros. Hablar de ello lo hace demasiado real."
    kia "J'ai un peu peur de parler de nous. En parler rend tout cela trop réel."

# game/scripts/c24/c24.rpy:1610
translate french c24s003_KiaDate_7987df6b:

    # mc "¿Es por Solomon? ¿Porque aún sigues casada con él?"
    mc "Est-ce à cause de Salomon ? Parce que vous êtes encore mariée à lui ?"

# game/scripts/c24/c24.rpy:1612
translate french c24s003_KiaDate_eba57e1f:

    # kia "En parte sí. Pese a que soy católica, no soy de esas que rechaza el divorcio, pero él sí. Nunca me lo va a dar."
    kia "En partie, oui. Même si je suis catholique, je ne suis pas contre le divorce, mais lui, si. Il ne me l'accordera jamais."

# game/scripts/c24/c24.rpy:1614
translate french c24s003_KiaDate_ecbea4c6:

    # kia "Y aunque me lo diera, tú y yo no nos vamos a poder casar nunca."
    kia "Et même s'il me le donnait, toi et moi ne pourrions jamais nous marier."

# game/scripts/c24/c24.rpy:1615
translate french c24s003_KiaDate_44b2af23:

    # kia "No sería justo que sólo una de nosotras se pudiera casar contigo, con lo que lo hemos hablado entre nosotras y ninguna va a aceptar casarse contigo."
    kia "Ce ne serait pas juste que l'un d'entre nous seulement puisse t'épouser, alors nous en avons discuté entre nous et aucun de nous n'acceptera de t'épouser."

# game/scripts/c24/c24.rpy:1617
translate french c24s003_KiaDate_a7ce1239:

    # kia "Y eso hace que tú y yo no nos vayamos a casar nunca."
    kia "Et cela signifie que toi et moi ne nous marierons jamais."

# game/scripts/c24/c24.rpy:1618
translate french c24s003_KiaDate_18a88386:

    # mc "Se puede vivir una vida muy feliz sin estar casados, [kia]."
    mc "On peut vivre une vie très heureuse sans être marié, [kia]."

# game/scripts/c24/c24.rpy:1620
translate french c24s003_KiaDate_93e42b6c:

    # kia "Lo sé, pero me educaron para casarme con el hombre de mi vida. Creí que era Solomon y resultó no serlo."
    kia "Je sais, mais j'ai été élevée dans l'idée d'épouser l'homme de mes rêves. Je pensais que c'était Salomon, et il s'est avéré que ce n'était pas le cas."

# game/scripts/c24/c24.rpy:1621
translate french c24s003_KiaDate_fd166dc8:

    # kia "Y si al final lo eres tú, no podremos hacerlo."
    kia "Et si cela s'avère être vous, nous ne pourrons pas le faire."

# game/scripts/c24/c24.rpy:1623
translate french c24s003_KiaDate_04a0ca8e:

    # kia "No voy a decir que me entristezca tener una relación contigo sin estar casados, pero..."
    kia "Je ne vais pas dire que je suis triste d'être en couple avec toi sans être mariée, mais..."

# game/scripts/c24/c24.rpy:1624
translate french c24s003_KiaDate_8d55fe6c:

    # mc "Te entiendo. Pero tiene difícil solución."
    mc "Je comprends. Mais c'est un problème difficile à résoudre."

# game/scripts/c24/c24.rpy:1625
translate french c24s003_KiaDate_d912836c:

    # kia "Lo sé. Pero hablemos de cosas más alegres."
    kia "Je sais. Mais parlons de choses plus joyeuses."

# game/scripts/c24/c24.rpy:1627
translate french c24s003_KiaDate_34ea56d4:

    # kia "[bet] me ha explicado lo que has hecho con la Iglesia en Monterey."
    kia "[bet] m'a expliqué ce que vous avez fait avec l'Église à Monterey."

# game/scripts/c24/c24.rpy:1628
translate french c24s003_KiaDate_6753da62:

    # mc "*Risa* Tenías que haber visto la cara del pobre cura al final."
    mc "*Rires* Vous auriez dû voir la tête du pauvre prêtre à la fin."

# game/scripts/c24/c24.rpy:1629
translate french c24s003_KiaDate_a2e76ea8:

    # kia "Soy católica, pero no me gustan muchas de las cosas que hace la Iglesia."
    kia "Je suis catholique, mais je n'aime pas beaucoup de choses que fait l'Église."

# game/scripts/c24/c24.rpy:1630
translate french c24s003_KiaDate_e94bfd37:

    # "Empiezas a explicarle cómo ha ido la reunión. Ella ya lo sabe porque se lo ha explicado [bet], pero te escucha atentamente."
    "Vous commencez à lui expliquer le déroulement de la réunion. Elle le sait déjà puisque vous le lui avez expliqué [bet], mais elle écoute attentivement."

# game/scripts/c24/c24.rpy:1631
translate french c24s003_KiaDate_3a324a98:

    # "Disfrutando del cambio de conversación."
    "J'apprécie le changement de conversation."

# game/scripts/c24/c24.rpy:1633
translate french c24s003_KiaDate_18f9417f:

    # "Cuando estás llegando al final de la explicación entra un grupo de ruidosos chicos, algo mayores que tú."
    "Alors que vous approchez de la fin de votre explication, un groupe de garçons bruyants, un peu plus âgés que vous, entrent."

# game/scripts/c24/c24.rpy:1634
translate french c24s003_KiaDate_66f128d6:

    # "Todos se quedan mirando a [kia], que brilla como una estrella en el casi vacío restaurante."
    "Tous les regards sont tournés vers [kia], qui brille comme une étoile dans le restaurant presque vide."

# game/scripts/c24/c24.rpy:1636
translate french c24s003_KiaDate_ea867ee3:

    # "[kia] se da cuenta de sus miradas y baja la suya."
    "[kia] remarque leurs regards et baisse le sien."

# game/scripts/c24/c24.rpy:1637
translate french c24s003_KiaDate_2a7c7656:

    # mc "Te he dicho que sería la envidia del restaurante."
    mc "Je vous avais dit que je ferais des envieux dans ce restaurant."

# game/scripts/c24/c24.rpy:1638
translate french c24s003_KiaDate_99b16475:

    # kia "No estoy acostumbrada..."
    kia "Je n'y suis pas habitué..."

# game/scripts/c24/c24.rpy:1639
translate french c24s003_KiaDate_87be2d7e:

    # mc "Estoy seguro de que los chicos del instituto te miran igual en la biblioteca que esos de ahí."
    mc "Je suis sûr que les lycéens vous regardent de la même façon à la bibliothèque que ces types-là."

# game/scripts/c24/c24.rpy:1641
translate french c24s003_KiaDate_bda69feb:

    # kia "¡Qué va! Miran a Gen. Es mucho más joven que yo."
    kia "Impossible ! Ils s'intéressent au général. Il est bien plus jeune que moi."

# game/scripts/c24/c24.rpy:1642
translate french c24s003_KiaDate_16a2e00a:

    # mc "Puede que sea más joven, pero no te cambiaría por dos Genevièves. Ni siquiera para hacer un trío con ellas dos."
    mc "Elle est peut-être plus jeune, mais je ne t'échangerais pas contre deux Genevièves. Même pas pour un plan à trois avec elles."

# game/scripts/c24/c24.rpy:1643
translate french c24s003_KiaDate_5c527e8d:

    # mc "Ella es mona. Tú eres preciosa."
    mc "Elle est mignonne. Tu es belle."

# game/scripts/c24/c24.rpy:1645
translate french c24s003_KiaDate_e3c79d87:

    # kia "Ellos no deben pensar lo mismo. Nunca me han mirado, y no es que me importe. Casi lo prefiero."
    kia "Ils ne pensent pas comme moi. Ils ne m'ont même jamais regardé, et ça m'est égal. Je préfère presque que ce soit ainsi."

# game/scripts/c24/c24.rpy:1646
translate french c24s003_KiaDate_e03cdab1:

    # mc "Geneviève va maquillada al trabajo. Cada vez que te he visto ir a la biblioteca, excepto el día que quedamos para comer, ibas sin maquillaje."
    mc "Geneviève se maquille pour aller travailler. À chaque fois que je t'ai vue aller à la bibliothèque, sauf le jour où nous avons déjeuné ensemble, tu n'étais pas maquillée."

# game/scripts/c24/c24.rpy:1647
translate french c24s003_KiaDate_7d344cf0:

    # mc "Y no quiero decir que lo necesites para estar preciosa. Pero en igualdad de condiciones, estoy seguro de que nadie miraría a Geneviève."
    mc "Et je ne dis pas que c'est indispensable pour être belle. Mais à qualité égale, je suis sûre que personne ne remarquerait Geneviève."

# game/scripts/c24/c24.rpy:1649
translate french c24s003_KiaDate_4db88899:

    # kia "*Risita* Ahora voy maquillada todos los días. Por si decides pasarte por la biblioteca. Sé que te gusta." id c24s003_KiaDate_4db88899
    kia "*Rires* Je me maquille tous les jours maintenant. Au cas où tu passerais à la bibliothèque. Je sais que ça te plaît." id c24s003_KiaDate_4db88899

# game/scripts/c24/c24.rpy:1650
translate french c24s003_KiaDate_4c98d145:

    # mc "Tendré que hacerlo más a menudo. Aunque solo sea para hacer esto."
    mc "Il faudra que je le fasse plus souvent. Ne serait-ce que pour ça."

# game/scripts/c24/c24.rpy:1654
translate french c24s003_KiaDate_32860475:

    # "La besas sin avisarla. Lo que empieza como un dulce beso, acaba como el beso que os habéis dado en la habitación."
    "Tu l'embrasses sans prévenir. Ce qui commence comme un doux baiser finit par ressembler au baiser échangé dans la chambre."

# game/scripts/c24/c24.rpy:1655
translate french c24s003_KiaDate_29306c14:

    # "No puedes evitar desear abrir los ojos para ver la cara de los ruidosos chicos cuando oyes sus sonidos de sorpresa."
    "Impossible de résister à l'envie d'ouvrir les yeux pour voir les visages de ces garçons bruyants quand on entend leurs cris de surprise."

# game/scripts/c24/c24.rpy:1656
translate french c24s003_KiaDate_327ef64d:

    # "Pero después del primer segundo, no existen para ti. Tan solo existen vuestros labios y vuestras lenguas rozándose y jugando."
    "Mais après la première seconde, ils cessent d'exister pour vous. Seules vos lèvres et vos langues subsistent, se frôlant et jouant l'une contre l'autre."

# game/scripts/c24/c24.rpy:1657
translate french c24s003_KiaDate_5e918d8d:

    # "Escribiendo con saliva una carta de amor."
    "Écrire une lettre d'amour avec de la salive."

# game/scripts/c24/c24.rpy:1659
translate french c24s003_KiaDate_c46855bc:

    # mc "Creía que no te gustaban las parejas que se enrollan en público."
    mc "Je croyais que tu n'aimais pas les couples qui s'embrassent en public."

# game/scripts/c24/c24.rpy:1660
translate french c24s003_KiaDate_1f661852:

    # kia "Y no me gustan, pero no sé si has oído al grupo de chicos. Se han sorprendido cuando me has besado."
    kia "Et je ne les aime pas, mais je ne sais pas si tu as entendu ce que les garçons ont dit. Ils ont été surpris quand tu m'as embrassée."

# game/scripts/c24/c24.rpy:1661
translate french c24s003_KiaDate_65f9676b:

    # mc "Sí..."
    mc "Ouais..."

# game/scripts/c24/c24.rpy:1663
translate french c24s003_KiaDate_eadb2922:

    # kia "Pues me ha encantado ese sonido."
    kia "Eh bien, j'ai adoré ce son."

# game/scripts/c24/c24.rpy:1664
translate french c24s003_KiaDate_961be510:

    # mc "*Risa* Por mí pueden sorprenderse todo lo que quieran. Soy el tío más afortunado en el restaurante."
    mc "*Rires* Ils peuvent être aussi surpris qu'ils le souhaitent. Je suis le plus chanceux du restaurant."

# game/scripts/c24/c24.rpy:1665
translate french c24s003_KiaDate_2e8f6f7b:

    # mc "En el mundo."
    mc "Dans le monde."

# game/scripts/c24/c24.rpy:1667
translate french c24s003_KiaDate_dbb63d53:

    # kia "Además de eso..."
    kia "Par ailleurs..."

# game/scripts/c24/c24.rpy:1668
translate french c24s003_KiaDate_a3db9a7f:

    # mc "¿Qué?"
    mc "Que?"

# game/scripts/c24/c24.rpy:1669
translate french c24s003_KiaDate_b22ca392:

    # kia "Hoy he entendido por primera vez a esas parejas. Me daba lo mismo que estuviéramos en público. Era como si sólo existiéramos tú y yo."
    kia "Aujourd'hui, j'ai enfin compris ces couples. Le fait d'être en public ne me dérangeait pas. C'était comme si nous étions seuls au monde."

# game/scripts/c24/c24.rpy:1670
translate french c24s003_KiaDate_a2ab25f7:

    # mc "Es que solo existimos tú y yo, cielo."
    mc "Il n'y a que toi et moi, chérie."

# game/scripts/c24/c24.rpy:1672
translate french c24s003_KiaDate_de836a6e:

    # "Vuelves a besarla para demostrárselo."
    "Tu l'embrasses à nouveau pour lui montrer."

# game/scripts/c24/c24.rpy:1673
translate french c24s003_KiaDate_dc92a470:

    # "Vuelve a besarte para decirte que está de acuerdo."
    "Il t'embrasse à nouveau pour te dire qu'il est d'accord."

# game/scripts/c24/c24.rpy:1674
translate french c24s003_KiaDate_23adfe77:

    # "Esta vez no escucháis sonidos de sorpresa. No hay nadie para emitirlos."
    "Cette fois, vous n'entendez aucun cri de surprise. Il n'y a personne ici pour en produire."

# game/scripts/c24/c24.rpy:1676
translate french c24s003_KiaDate_a23cf46f:

    # kia "Necesito beber algo... y recuperar el aliento."
    kia "J'ai besoin de boire quelque chose... et de reprendre mon souffle."

# game/scripts/c24/c24.rpy:1677
translate french c24s003_KiaDate_319ec1d2:

    # mc "La combinación del filete con tu pintalabios también está deliciosa."
    mc "L'association d'un steak et de votre rouge à lèvres est également délicieuse."

# game/scripts/c24/c24.rpy:1678
translate french c24s003_KiaDate_be8e3a1f:

    # mc "Ahora me gustaría probarla con el mosto."
    mc "Maintenant, j'aimerais l'essayer avec le must."

# game/scripts/c24/c24.rpy:1680
translate french c24s003_KiaDate_1033a2cc:

    # "[kia] bebe un largo sorbo de mosto mientras aparta la mirada. Esperas que acabe para volver a besarla."
    "Elle prend une longue gorgée de jus de raisin en détournant le regard. Tu attends qu'elle ait fini pour pouvoir l'embrasser à nouveau."

# game/scripts/c24/c24.rpy:1682
translate french c24s003_KiaDate_b838b453:

    # kia "Creo que deberíamos dejar los besos para después. O se nos va a hacer tarde para ir donde te quiero llevar."
    kia "Je pense qu'on devrait garder les baisers pour plus tard. Sinon, on va arriver en retard là où je veux t'emmener."

# game/scripts/c24/c24.rpy:1683
translate french c24s003_KiaDate_f3a3e63d:

    # kia "Allí podremos besarnos todo lo que quieras. No hay nadie nunca."
    kia "Là-bas, on peut s'embrasser autant qu'on veut. Il n'y a jamais personne autour."

# game/scripts/c24/c24.rpy:1684
translate french c24s003_KiaDate_86071e2e:

    # mc "¿Pido la cuenta entonces?"
    mc "Dois-je alors demander l'addition ?"

# game/scripts/c24/c24.rpy:1686
translate french c24s003_KiaDate_eb1388a2:

    # kia "*Risa* ¿Tan ansioso estás? ¿No quieres postre?"
    kia "*Rires* Tu es si anxieux(se) que ça ? Tu ne veux pas de dessert ?"

# game/scripts/c24/c24.rpy:1687
translate french c24s003_KiaDate_d117af68:

    # mc "Voy a sonar cursi, pero acabo de besar los labios más dulces. Cualquier postre me sabrá soso."
    mc "Je vais peut-être paraître un peu fleur bleue, mais je viens d'embrasser les lèvres les plus douces qui soient. Après tout, n'importe quel dessert me semblera fade."

# game/scripts/c24/c24.rpy:1689
translate french c24s003_KiaDate_767fc431:

    # kia "*Risa* Pues sí, has sonado cursi. Pero me encanta."
    kia "*Rires* Oui, c'était un peu niais. Mais j'adore."

# game/scripts/c24/c24.rpy:1690
translate french c24s003_KiaDate_3957492e:

    # kia "Pide la cuenta mientras voy al lavabo. Seguro que me tengo que retocar el pintalabios."
    kia "Demande l'addition pendant que je vais aux toilettes. Je suis sûre que je dois faire une retouche à mon rouge à lèvres."

# game/scripts/c24/c24.rpy:1692
translate french c24s003_KiaDate_ff456594:

    # kia "No pagues. Hoy me toca a mí."
    kia "Ne payez pas. C'est mon tour aujourd'hui."

# game/scripts/c24/c24.rpy:1693
translate french c24s003_KiaDate_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c24/c24.rpy:1695
translate french c24s003_KiaDate_a4273a91:

    # "La preciosa bibliotecaria te da un suave beso indicando que no empieces una discusión que no vas a ganar."
    "La charmante bibliothécaire vous donne un doux baiser, vous faisant comprendre qu'il vaut mieux éviter une dispute que vous êtes voué à perdre."

# game/scripts/c24/c24.rpy:1697
translate french c24s003_KiaDate_31a63462:

    # "Pides la cuenta y te das cuenta de que el restaurante sigue medio vacío. Aunque hayáis acabado de cenar, sigue siendo pronto."
    "Vous demandez l'addition et vous vous apercevez que le restaurant est encore à moitié vide. Même si vous avez fini de dîner, il est encore tôt."

# game/scripts/c24/c24.rpy:1698
translate french c24s003_KiaDate_e9534601:

    # "Siempre te ha gustado hacer figuritas con la capa de estaño que protege el corcho."
    "Tu as toujours aimé fabriquer des petites figurines avec la couche d'étain qui protège le liège."

# game/scripts/c24/c24.rpy:1699
translate french c24s003_KiaDate_1d6014e1:

    # "Empiezas a juguetear con la cápsula del mosto mientras tu mente divaga, pensando en la conversación que habéis tenido."
    "Vous commencez à tripoter la capsule de moustiquaire tout en laissant vagabonder votre esprit, repensant à la conversation que vous avez eue."

# game/scripts/c24/c24.rpy:1700
translate french c24s003_KiaDate_0a131c61:

    # "La camarera trae la cuenta al mismo tiempo que [kia] vuelve del lavabo."
    "La serveuse apporte l'addition au moment même où [kia] revient des toilettes."

# game/scripts/c24/c24.rpy:1702
translate french c24s003_KiaDate_95755e39:

    # "Cuando vuelve [kia]..."
    "Lorsque [kia] revient..."

# game/scripts/c24/c24.rpy:1703
translate french c24s003_KiaDate_1ec91d72:

    # wai "¿Estaba todo a su gusto?"
    wai "Tout vous a-t-il plu ?"

# game/scripts/c24/c24.rpy:1704
translate french c24s003_KiaDate_cfcef8ad:

    # mc "Sí, todo perfecto."
    mc "Oui, tout est parfait."

# game/scripts/c24/c24.rpy:1705
translate french c24s003_KiaDate_7965fbc1:

    # kia "Un sitio muy bonito y con una calidad excelente. Volveremos."
    kia "Un endroit magnifique et d'excellente qualité. Nous reviendrons."

# game/scripts/c24/c24.rpy:1707
translate french c24s003_KiaDate_6ec69178:

    # "Después de que [kia] pague la cuenta, una vez en el coche..."
    "Une fois que [kia] a réglé l'addition, une fois dans la voiture..."

# game/scripts/c24/c24.rpy:1708
translate french c24s003_KiaDate_55c4ae5e:

    # mc "¿Siguiente parada?"
    mc "Prochaine étape ?"

# game/scripts/c24/c24.rpy:1709
translate french c24s003_KiaDate_cf0aee0d:

    # kia "Ahí es donde está la sorpresa."
    kia "C'est là que réside la surprise."

# game/scripts/c24/c24.rpy:1710
translate french c24s003_KiaDate_35bb01ce:

    # mc "Tenía que intentarlo."
    mc "J'ai dû essayer."

# game/scripts/c24/c24.rpy:1712
translate french c24s003_KiaDate_5e17a1ec:

    # kia "Aunque me gustaría explicártelo, no lo podrías entender hasta que lo vieras, con lo que prefiero llevarte allí."
    kia "Bien que j'aimerais vous l'expliquer, vous ne comprendrez qu'en le voyant, je préfère donc vous y emmener."

# game/scripts/c24/c24.rpy:1713
translate french c24s003_KiaDate_3937d899:

    # mc "Cada vez estás más misteriosa. *Risa*"
    mc "Tu deviens de plus en plus mystérieux. *Rires*"

# game/scripts/c24/c24.rpy:1714
translate french c24s003_KiaDate_bbf64fe2:

    # kia "Allí te explicaré por qué me gusta ese sitio. Pero nos tenemos que ir ya o no llegaremos a tiempo."
    kia "Je t'expliquerai là-bas pourquoi j'aime cet endroit. Mais nous devons partir maintenant, sinon nous n'arriverons pas à l'heure."

# game/scripts/c24/c24.rpy:1716
translate french c24s003_KiaDate_eb706e74:

    # mc "Entonces vamos. Quiero saberlo todo de ti."
    mc "Alors allons-y. Je veux tout savoir sur toi."

# game/scripts/c24/c24.rpy:1726
translate french c24s003_KiaBeach_c321fe03:

    # "[kia] conduce diez minutos por una carretera estrecha hasta llegar a un camino sin asfaltar cerca del mar, donde aparca el coche."
    "[kia] Il roule pendant dix minutes sur une route étroite jusqu'à ce qu'il atteigne un chemin non pavé près de la mer, où il gare la voiture."

# game/scripts/c24/c24.rpy:1727
translate french c24s003_KiaBeach_b0d89349:

    # "Ella coge su bolso y te toca cargar con la bolsa del maletero."
    "Elle prend son sac et vous devez le porter depuis le coffre."

# game/scripts/c24/c24.rpy:1728
translate french c24s003_KiaBeach_e1a61012:

    # mc "¿Aquí? ¿En medio de la nada?"
    mc "Ici ? En plein milieu de nulle part ?"

# game/scripts/c24/c24.rpy:1729
translate french c24s003_KiaBeach_adb64eac:

    # kia "*Risa* No, tenemos que caminar un par de minutos."
    kia "*Rires* Non, nous devons marcher quelques minutes."

# game/scripts/c24/c24.rpy:1730
translate french c24s003_KiaBeach_42b7ae76:

    # mc "Déjame llevar la bolsa."
    mc "Laissez-moi porter le sac."

# game/scripts/c24/c24.rpy:1731
translate french c24s003_KiaBeach_0589cccb:

    # kia "Vale, pero no la abras."
    kia "D'accord, mais ne l'ouvrez pas."

# game/scripts/c24/c24.rpy:1732
translate french c24s003_KiaBeach_6882bb03:

    # "Más misterios."
    "Encore des mystères."

# game/scripts/c24/c24.rpy:1734
translate french c24s003_KiaBeach_d153e3b3:

    # "Tras dos minutos andando por el camino de tierra, puedes ver el que supones que es el lugar al que [kia] se refería."
    "Après avoir marché pendant deux minutes le long du chemin de terre, vous pouvez voir ce que vous supposez être l'endroit auquel [kia] faisait référence."

# game/scripts/c24/c24.rpy:1735
translate french c24s003_KiaBeach_5ce76cd8:

    # "Con el tiempo perfectamente medido, llegáis cuando el cielo empieza a teñirse de naranja con la puesta de sol."
    "Avec un timing parfaitement calculé, vous arrivez au moment où le ciel commence à se teinter d'orange au coucher du soleil."

# game/scripts/c24/c24.rpy:1737
translate french c24s003_KiaBeach_5bcc7d86:

    # mc "¡Es precioso! No había estado nunca aquí."
    mc "C'est magnifique ! Je n'étais jamais venu ici auparavant."

# game/scripts/c24/c24.rpy:1738
translate french c24s003_KiaBeach_17ca26fa:

    # kia "Está escondido. Lo descubrí un día mirando mapas en internet. Marcaba que había un mirador y decidí venir a verlo."
    kia "Il est bien caché. Je l'ai découvert un jour en consultant des cartes en ligne. Un point de vue y était indiqué, alors j'ai décidé de venir le voir."

# game/scripts/c24/c24.rpy:1739
translate french c24s003_KiaBeach_c365e15c:

    # kia "Me gustó el sitio el primer día que vine. Me enamoré de él la primera vez que vine a ver la puesta de sol."
    kia "J'ai aimé cet endroit dès le premier jour. J'en suis tombée amoureuse la première fois que je suis venue admirer le coucher du soleil."

# game/scripts/c24/c24.rpy:1740
translate french c24s003_KiaBeach_3e0e061e:

    # kia "Hoy la marea está baja y es menos espectacular, pero sigue siendo muy bonito."
    kia "Aujourd'hui, la marée est basse et le spectacle est moins impressionnant, mais le paysage reste magnifique."

# game/scripts/c24/c24.rpy:1741
translate french c24s003_KiaBeach_2eaf27bc:

    # kia "Vamos a aquella punta y déjame sacar una cosa de la bolsa."
    kia "Passons à ce point et laissez-moi vous révéler quelque chose."

# game/scripts/c24/c24.rpy:1743
translate french c24s003_KiaBeach_a87881f2:

    # "Siendo una mujer previsora, ha traído una manta de picnic, en la que se sienta tras extenderla."
    "Étant une femme prévoyante, elle a apporté une couverture de pique-nique sur laquelle elle s'assoit après l'avoir étalée."

# game/scripts/c24/c24.rpy:1744
translate french c24s003_KiaBeach_d9cb06de:

    # mc "Hay un banco justo ahí detrás..."
    mc "Il y a une banque juste là-bas..."

# game/scripts/c24/c24.rpy:1745
translate french c24s003_KiaBeach_447b9601:

    # kia "*Risa* Siempre está lleno de cacas de gaviota. Por eso vengo con la manta."
    kia "*Rires* C'est toujours plein de fientes de goélands. C'est pour ça que j'apporte une couverture."

# game/scripts/c24/c24.rpy:1746
translate french c24s003_KiaBeach_f978bbdc:

    # mc "*Risa* Ni me había fijado. Me hubiera llevado un montón de cacas a casa pegadas en los pantalones."
    mc "*Rires* Je n'avais même pas remarqué. J'aurais ramené à la maison plein de crottes collées à mon pantalon."

# game/scripts/c24/c24.rpy:1748
translate french c24s003_KiaBeach_3c569df0:

    # "Te tumbas a su lado. Mirarla desde abajo, por una vez, te da una perspectiva diferente de su belleza."
    "Vous vous allongez à côté d'elle. La regarder d'en bas, pour une fois, vous offre une perspective différente sur sa beauté."

# game/scripts/c24/c24.rpy:1749
translate french c24s003_KiaBeach_24dafdd2:

    # kia "*Risa* Por suerte vienes con una mujer previsora."
    kia "*Rires* Heureusement que tu es avec une femme qui planifie à l'avance."

# game/scripts/c24/c24.rpy:1750
translate french c24s003_KiaBeach_728c6dcc:

    # mc "Una mujer que me tiene que explicar la historia de este sitio para ella, aparte de encontrarlo en un mapa por casualidad."
    mc "Une femme qui doit m'expliquer l'histoire de cet endroit, alors qu'elle l'a trouvé par hasard sur une carte."

# game/scripts/c24/c24.rpy:1752
translate french c24s003_KiaBeach_a7c3bcd5:

    # kia "No es una historia alegre..."
    kia "Ce n'est pas une histoire joyeuse..."

# game/scripts/c24/c24.rpy:1753
translate french c24s003_KiaBeach_03418fd9:

    # mc "Pero es tu historia. Quiero escucharla."
    mc "Mais c'est votre histoire. Je veux l'entendre."

# game/scripts/c24/c24.rpy:1755
translate french c24s003_KiaBeach_1c484da6:

    # kia "Lo descubrí el verano de hace seis años. Unos meses antes de que [eil.nick] y tú empezarais a salir."
    kia "Je l'ai découvert il y a six ans, en été. Quelques mois avant que toi et [eil.nick] ne commenciez à sortir ensemble."

# game/scripts/c24/c24.rpy:1756
translate french c24s003_KiaBeach_714a706b:

    # kia "Ella se fue dos semanas a un campamento de animadoras y estaba en casa sola con Solomon."
    kia "Elle est partie deux semaines en camp d'entraînement de cheerleading et s'est retrouvée seule à la maison avec Solomon."

# game/scripts/c24/c24.rpy:1757
translate french c24s003_KiaBeach_83fbd330:

    # kia "Por entonces Solomon bebía y estaba agresivo. No tanto como se puso después."
    kia "À cette époque, Solomon buvait et était agressif. Pas autant qu'il le devint plus tard."

# game/scripts/c24/c24.rpy:1758
translate french c24s003_KiaBeach_b8ff51ed:

    # mc "Recuerdo como empeoró durante el año siguiente..."
    mc "Je me souviens comment la situation a empiré l'année suivante..."

# game/scripts/c24/c24.rpy:1760
translate french c24s003_KiaBeach_2f40382c:

    # kia "Exacto. Él trabajaba en el turno de tarde en la fábrica aquel verano, con lo que yo estaba sola en casa casi todo el día."
    kia "Exactement. Il travaillait de l'après-midi à l'usine cet été-là, donc j'étais seule à la maison presque toute la journée."

# game/scripts/c24/c24.rpy:1761
translate french c24s003_KiaBeach_401b72ff:

    # kia "Por la mañana él dormía, se levantaba, iba a trabajar, volvía de noche y bebía hasta caer dormido."
    kia "Le matin, il dormait, se levait, allait travailler, rentrait le soir et buvait jusqu'à s'endormir."

# game/scripts/c24/c24.rpy:1762
translate french c24s003_KiaBeach_68db1dba:

    # kia "En los días buenos."
    kia "Les bons jours."

# game/scripts/c24/c24.rpy:1763
translate french c24s003_KiaBeach_fb61827f:

    # mc "Una vida de mierda que eligió él."
    mc "Une vie de merde qu'il a choisie."

# game/scripts/c24/c24.rpy:1764
translate french c24s003_KiaBeach_46f639b5:

    # kia "Sí, y que nos hacía pagar a [eil.nick] y a mí."
    kia "Oui, et il nous a fait payer [eil.nick] et moi."

# game/scripts/c24/c24.rpy:1766
translate french c24s003_KiaBeach_1b5d6271:

    # kia "Pero a lo que iba... Cuando se iba a trabajar, no quería estar sola en casa. Me parecía opresiva."
    kia "Mais ce que je voulais dire… Quand elle partait travailler, elle ne voulait pas rester seule à la maison. Je trouvais ça oppressant."

# game/scripts/c24/c24.rpy:1767
translate french c24s003_KiaBeach_d5176a34:

    # kia "Empecé a conducir sin rumbo fijo. Después de un par de días, empecé a buscar en internet sitios cerca de Newport donde no hubiera estado nunca."
    kia "J'ai commencé à conduire sans but précis. Au bout de deux jours, j'ai commencé à chercher en ligne des endroits près de Newport où je n'étais jamais allé."

# game/scripts/c24/c24.rpy:1768
translate french c24s003_KiaBeach_b6967b68:

    # mc "Lo entiendo..."
    mc "Je comprends..."

# game/scripts/c24/c24.rpy:1770
translate french c24s003_KiaBeach_5997eb17:

    # kia "Descubrí algunos sitios bonitos, pero ninguno como este. Se convirtió en mi lugar favorito."
    kia "J'ai découvert de beaux endroits, mais aucun comme celui-ci. C'est devenu mon endroit préféré."

# game/scripts/c24/c24.rpy:1771
translate french c24s003_KiaBeach_575229bd:

    # kia "Me daba... paz."
    kia "Cela m'a apporté... la paix."

# game/scripts/c24/c24.rpy:1772
translate french c24s003_KiaBeach_7ee7c847:

    # kia "Aquí me sentía segura. Sola pero segura."
    kia "Je me sentais en sécurité ici. Seule, mais en sécurité."

# game/scripts/c24/c24.rpy:1774
translate french c24s003_KiaBeach_87833168:

    # kia "Aquí nadie me decía que era una inútil ni me agarraba del pelo, llevándome por la casa para enseñarme lo que había hecho mal."
    kia "Ici, personne ne m'a dit que j'étais inutile, ni ne m'a tiré par les cheveux pour me traîner dans la maison et me montrer ce que j'avais fait de mal."

# game/scripts/c24/c24.rpy:1776
translate french c24s003_KiaBeach_6740bf72:

    # kia "Me podía imaginar navegando hacia la puesta de sol en un barco con [eil.nick]. Para no volver nunca."
    kia "Je pouvais m'imaginer voguer vers le coucher du soleil sur un bateau avec [eil.nick]. Sans jamais revenir."

# game/scripts/c24/c24.rpy:1778
translate french c24s003_KiaBeach_fb35d1b6:

    # kia "Sé que es una tontería. El sueño de un ama de casa infeliz."
    kia "Je sais, c'est idiot. Le rêve d'une femme au foyer malheureuse."

# game/scripts/c24/c24.rpy:1779
translate french c24s003_KiaBeach_b7bf6898:

    # kia "Pero me daba tranquilidad."
    kia "Mais cela m'a rassuré."

# game/scripts/c24/c24.rpy:1780
translate french c24s003_KiaBeach_b1600ea5:

    # mc "Lo entiendo, pero ¿por qué volver ahora que has dejado eso atrás?"
    mc "Je comprends, mais pourquoi revenir en arrière maintenant que vous avez laissé tout cela derrière vous ?"

# game/scripts/c24/c24.rpy:1782
translate french c24s003_KiaBeach_4fb7752b:

    # kia "Porque, aunque sea un sitio que evoca recuerdos oscuros, hace que los recuerdos felices que estamos creando se vean más brillantes."
    kia "Car, même si c'est un lieu qui évoque de sombres souvenirs, il rend les souvenirs heureux que nous créons encore plus éclatants."

# game/scripts/c24/c24.rpy:1783
translate french c24s003_KiaBeach_8a3915a6:

    # kia "Y porque es un lugar precioso que quería compartir contigo."
    kia "Et parce que c'est un endroit magnifique que je voulais partager avec vous."

# game/scripts/c24/c24.rpy:1784
translate french c24s003_KiaBeach_cd6b8591:

    # mc "Entonces deberíamos empezar a crear recuerdos felices aquí, ¿no?"
    mc "Alors, commençons dès maintenant à créer de beaux souvenirs, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:1786
translate french c24s003_KiaBeach_6dc0e356:

    # kia "Estar aquí hoy, contigo, ya es un recuerdo feliz, aunque lo esté viviendo ahora mismo."
    kia "Être ici aujourd'hui, avec vous, est déjà un souvenir heureux, même si je le vis en ce moment même."

# game/scripts/c24/c24.rpy:1787
translate french c24s003_KiaBeach_f93717c6:

    # mc "Pienso lo mismo. Pero me has prometido que habría besos aquí."
    mc "Je pense la même chose. Mais tu m'as promis qu'il y aurait des baisers ici."

# game/scripts/c24/c24.rpy:1789
translate french c24s003_KiaBeach_1e80552e:

    # kia "*Risa* Si empezamos a besarnos, nos perderemos la puesta de sol."
    kia "*Rires* Si on commence à s'embrasser, on va rater le coucher du soleil."

# game/scripts/c24/c24.rpy:1790
translate french c24s003_KiaBeach_9482bb51:

    # mc "Prefiero mirarte a ti que a la puesta de sol. Además, aún queda mucho."
    mc "Je préfère te regarder plutôt que de contempler le coucher du soleil. D'ailleurs, il reste encore beaucoup de temps."

# game/scripts/c24/c24.rpy:1792
translate french c24s003_KiaBeach_18249387:

    # kia "A mí me puedes mirar cuando quieras. La puesta de sol sólo dura un segundo."
    kia "Tu peux me regarder quand tu veux. Le coucher du soleil ne dure qu'une seconde."

# game/scripts/c24/c24.rpy:1793
translate french c24s003_KiaBeach_477b69bf:

    # mc "Entonces déjame hacer algo antes de que se ponga el sol. Sé que puede parecerte una tontería."
    mc "Permettez-moi donc de faire quelque chose avant le coucher du soleil. Je sais que cela peut vous paraître idiot."

# game/scripts/c24/c24.rpy:1795
translate french c24s003_KiaBeach_5d83a112:

    # kia "Ahora soy yo la que tiene curiosidad por lo que vas a hacer."
    kia "Maintenant, c'est moi qui suis curieux de savoir ce que tu vas faire."

# game/scripts/c24/c24.rpy:1796
translate french c24s003_KiaBeach_e29a6b75:

    # mc "Antes has dicho que tú y yo no nos podríamos casar nunca. Porque Solomon nunca te dará el divorcio."
    mc "Tu as dit tout à l'heure que nous ne pourrions jamais nous marier, car Salomon ne te donnera jamais le divorce."

# game/scripts/c24/c24.rpy:1799
translate french c24s003_KiaBeach_5b9f333e:

    # mc "Y porque, aunque te lo diera, sería injusto que solo me casara contigo."
    mc "Et parce que, même si je te le donnais, ce serait injuste de n'épouser que toi."

# game/scripts/c24/c24.rpy:1801
translate french c24s003_KiaBeach_14df12c2:

    # mc "Y, aunque te lo diera, pasarían meses antes de que pudiéramos hacer algo así."
    mc "Et même si je vous le donnais, il faudrait des mois avant que nous puissions faire quoi que ce soit de ce genre."

# game/scripts/c24/c24.rpy:1802
translate french c24s003_KiaBeach_8ea327c4:

    # kia "Sí. Pero lo entiendo, aunque me hubiera gustado si todo esto hubiera pasado en otras circunstancias."
    kia "Oui. Mais je comprends, même si j'aurais préféré que tout cela se produise dans des circonstances différentes."

# game/scripts/c24/c24.rpy:1804
translate french c24s003_KiaBeach_c9956e94:

    # mc "Podemos crear nuestras propias circunstancias."
    mc "Nous pouvons créer nos propres circonstances."

# game/scripts/c24/c24.rpy:1805
translate french c24s003_KiaBeach_3952fb47:

    # kia "¿A qué te refieres?"
    kia "De quoi parles-tu?"

# game/scripts/c24/c24.rpy:1807
translate french c24s003_KiaBeach_fdb6c9c3:

    # mc "[kia] Wellesley, ¿quieres casarte conmigo aunque nunca lo legalicemos?"
    mc "[kia] Wellesley, veux-tu m'épouser même si nous ne l'officialisons jamais ?"

# game/scripts/c24/c24.rpy:1808
translate french c24s003_KiaBeach_757bfbc7:

    # mc "Estaremos casados a nuestros ojos, aunque no lo estemos a los ojos del mundo."
    mc "Nous serons mariés à nos propres yeux, même si nous ne le sommes pas aux yeux du monde."

# game/scripts/c24/c24.rpy:1809
translate french c24s003_KiaBeach_adbf85c5:

    # kia "¿QUÉ?"
    kia "QUE?"

# game/scripts/c24/c24.rpy:1810
translate french c24s003_KiaBeach_56304b23:

    # kia "¿De dónde has sacado un anillo?"
    kia "Où as-tu trouvé une bague ?"

# game/scripts/c24/c24.rpy:1811
translate french c24s003_KiaBeach_a237cbdb:

    # mc "Del bolsillo..."
    mc "De ma poche..."

# game/scripts/c24/c24.rpy:1813
translate french c24s003_KiaBeach_1da5a730:

    # kia "Me refiero... ¿Tenías esto planeado? ¿Has llevado un anillo todo este tiempo?"
    kia "Je veux dire… Tu avais prévu ça ? Tu portais une bague depuis tout ce temps ?"

# game/scripts/c24/c24.rpy:1814
translate french c24s003_KiaBeach_e6ec41e7:

    # mc "No, cielo. Sé que es un muy cutre, pero lo he hecho con el estaño del tapón del mosto cuando has ido al lavabo."
    mc "Non, chérie. Je sais que ce n'est vraiment pas cher, mais je l'ai fait avec la boîte de conserve du bouchon de la bouteille de moût quand tu es allée aux toilettes."

# game/scripts/c24/c24.rpy:1818
translate french c24s003_KiaBeach_f35fd59b:

    # mc "Mis dedos han empezado a jugar con el metal y ha salido un anillo. Mi subconsciente me ha dicho que tenía que pedirte que te casaras conmigo."
    mc "Mes doigts ont commencé à jouer avec le métal et une bague en est apparue. Mon subconscient m'a dit que je devais te demander en mariage."

# game/scripts/c24/c24.rpy:1820
translate french c24s003_KiaBeach_d4001fa4:

    # kia "¡Sí quiero!"
    kia "Oui, je veux !"

# game/scripts/c24/c24.rpy:1821
translate french c24s003_KiaBeach_8162835f:

    # mc "Te prometo cambiarlo por uno de verdad en cuanto pueda."
    mc "Je promets de le remplacer par un vrai dès que possible."

# game/scripts/c24/c24.rpy:1823
translate french c24s003_KiaBeach_c774bda3:

    # "Tu prometida se lanza a tus labios con una pasión desconocida hasta ese momento."
    "Votre fiancée se jette sur vos lèvres avec une passion inconnue jusqu'à cet instant."

# game/scripts/c24/c24.rpy:1825
translate french c24s003_KiaBeach_63ac09ce:

    # kia "Sí quiero. No te puedes imaginar lo bonito que es lo que acabas de hacer."
    kia "Oui, je le sais. Vous ne pouvez pas imaginer à quel point ce que vous venez de faire est beau."

# game/scripts/c24/c24.rpy:1826
translate french c24s003_KiaBeach_d572b899:

    # mc "Sólo es un anillo hecho con el estaño de una botella..."
    mc "C'est juste une bague fabriquée à partir du métal d'une bouteille..."

# game/scripts/c24/c24.rpy:1827
translate french c24s003_KiaBeach_b8fa6c64:

    # kia "No es el anillo. Es el hecho. Sabías que era importante para mí y lo has hecho."
    kia "Ce n'est pas la bague. C'est le geste. Tu savais que c'était important pour moi, et tu l'as fait."

# game/scripts/c24/c24.rpy:1830
translate french c24s003_KiaBeach_7a750b76:

    # kia "Pero tengo que poner una condición."
    kia "Mais je dois poser une condition."

# game/scripts/c24/c24.rpy:1831
translate french c24s003_KiaBeach_77c47ed2:

    # mc "¿Cuál?"
    mc "Lequel?"

# game/scripts/c24/c24.rpy:1832
translate french c24s003_KiaBeach_ab2e544a:

    # kia "Que yo no sea la única a quién se lo pidas."
    kia "Ne me laissez pas être le seul à qui vous posez la question."

# game/scripts/c24/c24.rpy:1833
translate french c24s003_KiaBeach_18f223f2:

    # mc "Me parece una condición que puedo cumplir."
    mc "Je pense que c'est une condition que je peux remplir."

# game/scripts/c24/c24.rpy:1834
translate french c24s003_KiaBeach_3f179b78:

    # mc "Y vuelve a demostrar lo maravillosa que eres."
    mc "Et montrez-nous une fois de plus à quel point vous êtes merveilleux."

# game/scripts/c24/c24.rpy:1836
translate french c24s003_KiaBeach_2e521197:

    # kia "¿Por qué?"
    kia "Parce que?"

# game/scripts/c24/c24.rpy:1837
translate french c24s003_KiaBeach_8b4e3db9:

    # mc "Porque en un momento importante para ti, lo que haces es pensar en otras personas."
    mc "Car, dans un moment important pour vous, ce que vous faites, c'est penser aux autres."

# game/scripts/c24/c24.rpy:1838
translate french c24s003_KiaBeach_0356e1ef:

    # kia "Es lo lógico, ¿no? Somos una familia..."
    kia "C'est la chose logique à faire, non ? Nous sommes une famille..."

# game/scripts/c24/c24.rpy:1839
translate french c24s003_KiaBeach_3672b52e:

    # mc "Sí, es lo lógico. Pero no todo el mundo lo haría en tus circunstancias."
    mc "Oui, c'est logique. Mais tout le monde ne le ferait pas dans votre situation."

# game/scripts/c24/c24.rpy:1841
translate french c24s003_KiaBeach_b351e505:

    # mc "Lo que es importante para ti, es importante para mí."
    mc "Ce qui est important pour toi est important pour moi."

# game/scripts/c24/c24.rpy:1843
translate french c24s003_KiaBeach_1c9399f7:

    # kia "¿Puedo volver a besar a mi prometido?"
    kia "Puis-je embrasser à nouveau mon fiancé ?"

# game/scripts/c24/c24.rpy:1844
translate french c24s003_KiaBeach_33974255:

    # mc "Por supuesto, pero... ¿y la puesta de sol?"
    mc "Bien sûr, mais... et le coucher de soleil ?"

# game/scripts/c24/c24.rpy:1845
translate french c24s003_KiaBeach_b1b12e44:

    # kia "Ya la veremos otro día."
    kia "Nous la reverrons un autre jour."

# game/scripts/c24/c24.rpy:1847
translate french c24s003_KiaBeach_39520351:

    # "Os empezáis a besar como si no hubiera un mañana, como si el tiempo se hubiera paralizado y el sol no se fuera a poner nunca."
    "Vous vous embrassez comme s'il n'y avait pas de lendemain, comme si le temps s'était arrêté et que le soleil ne se coucherait jamais."

# game/scripts/c24/c24.rpy:1848
translate french c24s003_KiaBeach_7da5e73a:

    # "No eres capaz de saber cómo es posible que acabarais ese beso con la misma ropa que lo empezasteis."
    "Il est impossible que tu saches comment il est possible que vous ayez terminé ce baiser en portant les mêmes vêtements qu'au début."

# game/scripts/c24/c24.rpy:1849
translate french c24s003_KiaBeach_c1073a74:

    # "Tan solo recuerdas que fue uno de los besos más maravillosos de tu vida. Tu primer beso como prometido de alguien."
    "Vous ne vous souvenez que d'un seul baiser : l'un des plus beaux de votre vie. Votre premier baiser en tant que fiancé(e)."

# game/scripts/c24/c24.rpy:1850
translate french c24s003_KiaBeach_fd099c8e:

    # "Y el sol se puso sin que os dierais cuenta."
    "Et le soleil s'est couché sans que vous vous en aperceviez."

# game/scripts/c24/c24.rpy:1852
translate french c24s003_KiaBeach_bef69e4a:

    # "Os da lo mismo."
    "Pour vous, c'est du pareil au même."

# game/scripts/c24/c24.rpy:1863
translate french c24s004_Eri_Dap_Kat_Nor_8e4c7523:

    # "Después de cenar, en la cocina de [nor]..."
    "Après le dîner, dans la cuisine de [nor]..."

# game/scripts/c24/c24.rpy:1865
translate french c24s004_Eri_Dap_Kat_Nor_75401fcb:

    # nor "Estoy muy contenta por Tía [bet]. Era injusto..."
    nor "Je suis tellement contente pour tante [bet]. C'était injuste..."

# game/scripts/c24/c24.rpy:1866
translate french c24s004_Eri_Dap_Kat_Nor_76f0a7ee:

    # eri "Estoy de acuerdo. Querían aprovecharse de lo que creían que era un momento de vulnerabilidad de la tía."
    eri "Je suis d'accord. Ils voulaient profiter de ce qu'ils pensaient être un moment de vulnérabilité chez la tante."

# game/scripts/c24/c24.rpy:1867
translate french c24s004_Eri_Dap_Kat_Nor_b58475de:

    # dap "Pero no contaban con [mc]. *Risita*"
    dap "Mais ils n'avaient pas prévu le C4. *Rires*"

# game/scripts/c24/c24.rpy:1869
translate french c24s004_Eri_Dap_Kat_Nor_2aa59a1a:

    # nor "¿Tenéis algún plan para el fin de semana?"
    nor "Avez-vous des projets pour le week-end ?"

# game/scripts/c24/c24.rpy:1871
translate french c24s004_Eri_Dap_Kat_Nor_d1d3ee28:

    # dap "He quedado con [eva] para que me enseñe a disparar el domingo por la tarde. También vienen varias de las chicas."
    dap "J'ai rendez-vous avec [eva] dimanche après-midi pour qu'il m'apprenne à tirer. Plusieurs filles seront là aussi."

# game/scripts/c24/c24.rpy:1873
translate french c24s004_Eri_Dap_Kat_Nor_f0f38756:

    # nor "¿Vas a ir tú también, [eri]?"
    nor "Tu y vas aussi, [eri] ?"

# game/scripts/c24/c24.rpy:1875
translate french c24s004_Eri_Dap_Kat_Nor_121141d3:

    # eri "Me hubiera gustado ir. Ha alquilado un campo de tiro y podría haber estado bien, pero trabajo, con lo que quedaremos otro día."
    eri "J'aurais bien aimé y aller. Il a loué un stand de tir et ça aurait été sympa, mais j'ai du travail, alors on se verra un autre jour."

# game/scripts/c24/c24.rpy:1876
translate french c24s004_Eri_Dap_Kat_Nor_e4a29f7f:

    # eri "Iremos al bosque, donde le enseñó a disparar a [mc]."
    eri "Nous irons dans la forêt, là où il lui a appris à tirer au C4."

# game/scripts/c24/c24.rpy:1878
translate french c24s004_Eri_Dap_Kat_Nor_13a3344b:

    # nor "Ir con cuidado con las armas... No son juguetes."
    nor "Attention aux armes... Ce ne sont pas des jouets."

# game/scripts/c24/c24.rpy:1880
translate french c24s004_Eri_Dap_Kat_Nor_7ab70709:

    # dap "Lo sabemos, Mamá. Creo que tú también deberías aprender a disparar."
    dap "On le sait, maman. Je pense que tu devrais apprendre à tirer aussi."

# game/scripts/c24/c24.rpy:1881
translate french c24s004_Eri_Dap_Kat_Nor_742d8287:

    # dap "Nunca puedes saber cuándo se repetirá otro secuestro, y creo que deberíamos tener armas en casa."
    dap "On ne sait jamais quand un autre enlèvement aura lieu, et je pense que nous devrions avoir des armes à la maison."

# game/scripts/c24/c24.rpy:1883
translate french c24s004_Eri_Dap_Kat_Nor_5fb4770a:

    # eri "Yo creo que no son necesarias, pese a lo bien que fue que [eva] tuviera una pistola escondida cuando pasó lo de Solomon."
    eri "Je ne pense pas qu'elles soient nécessaires, même si c'était une bonne chose que [eva] ait eu une arme cachée lors de l'incident de Solomon."

# game/scripts/c24/c24.rpy:1885
translate french c24s004_Eri_Dap_Kat_Nor_6c8ae9f0:

    # nor "Yo pienso lo mismo. Yo ya sé disparar pero, si hubiera intentado hacer lo que hizo [eva], lo más probable es que le hubiera dado en la mano a Solomon."
    nor "Je pense la même chose. Je sais déjà tirer, mais si j'avais essayé de faire comme [eva], j'aurais très probablement touché Salomon à la main."

# game/scripts/c24/c24.rpy:1886
translate french c24s004_Eri_Dap_Kat_Nor_ce7a280b:

    # nor "O incluso sería más probable que hubiera matado a una ardilla en el bosque al otro lado de la calle. *Risa*"
    nor "Ou alors, il serait encore plus probable qu'il ait tué un écureuil dans les bois de l'autre côté de la rue. *Rires*"

# game/scripts/c24/c24.rpy:1888
translate french c24s004_Eri_Dap_Kat_Nor_1a092b52:

    # nor "[eva] y [ama] no van a ir a ningún sitio, con lo que creo que es mejor si son ellas las que se ocupan de las armas."
    nor "[eva] et [ama] ne vont pas disparaître, donc je pense qu'il vaut mieux qu'ils s'occupent des armes."

# game/scripts/c24/c24.rpy:1889
translate french c24s004_Eri_Dap_Kat_Nor_ad0b0264:

    # nor "Es bueno que aprendáis, pero no me gustaría tener armas en casa."
    nor "C'est bien que tu apprennes, mais je ne voudrais pas avoir d'armes à la maison."

# game/scripts/c24/c24.rpy:1891
translate french c24s004_Eri_Dap_Kat_Nor_02763481:

    # eri "Aparte de las que tiene [eva] escondidas, ¿no? *Risa*"
    eri "À part celles qu'elle a cachées, bien sûr ? *Rires*"

# game/scripts/c24/c24.rpy:1892
translate french c24s004_Eri_Dap_Kat_Nor_fb5e8d29:

    # nor "*Risa* Exacto. Aparte de esas."
    nor "*Rires* Exactement. À part ça."

# game/scripts/c24/c24.rpy:1893
translate french c24s004_Eri_Dap_Kat_Nor_7be2239a:

    # dap "Bueno, una vez nos enseñe a disparar, nos podría decir dónde están..."
    dap "Eh bien, une fois que vous nous aurez appris à tirer, vous pourrez nous dire où ils sont..."

# game/scripts/c24/c24.rpy:1894
translate french c24s004_Eri_Dap_Kat_Nor_7df8a7a2:

    # nor "*Risa* Entonces dejarían de estar escondidas. ¿Te imaginas a [emm] sabiendo dónde están las armas?"
    nor "*Rires* Alors elles ne seraient plus cachées. Imaginez un peu [emm] savoir où sont les armes !"

# game/scripts/c24/c24.rpy:1896
translate french c24s004_Eri_Dap_Kat_Nor_b711c9e5:

    # kat "Hola, chicas. ¿De qué habláis?"
    kat "Salut les filles. De quoi parlez-vous ?"

# game/scripts/c24/c24.rpy:1898
translate french c24s004_Eri_Dap_Kat_Nor_226c8906:

    # "Todas" "De armas."
    "Todas" "Des armes."

# game/scripts/c24/c24.rpy:1900
translate french c24s004_Eri_Dap_Kat_Nor_7c813c76:

    # kat "¿Ah, de lo de [eva] el domingo? Va a ser divertido."
    kat "Ah, et le truc [eva] de dimanche ? Ça va être amusant."

# game/scripts/c24/c24.rpy:1901
translate french c24s004_Eri_Dap_Kat_Nor_2fc0434f:

    # kat "Al final [kim] también vendrá."
    kat "Finalement, [kim] viendra aussi."

# game/scripts/c24/c24.rpy:1903
translate french c24s004_Eri_Dap_Kat_Nor_daefa916:

    # dap "*Risa* Yo que tú iría con cuidado si [kim] está armada cerca de ti."
    dap "*Rires* À votre place, je ferais attention si [kim] est armé près de vous."

# game/scripts/c24/c24.rpy:1905
translate french c24s004_Eri_Dap_Kat_Nor_d8fca8c5:

    # kat "¿Por qué? Le he hecho un favor..."
    kat "Pourquoi ? Je lui ai rendu service..."

# game/scripts/c24/c24.rpy:1907
translate french c24s004_Eri_Dap_Kat_Nor_1bfe855c:

    # eri "Sí, probablemente, pero las formas no han sido las correctas y lo sabes, [kat]."
    eri "Oui, probablement, mais les méthodes n'ont pas été les bonnes et tu le sais, [kat]."

# game/scripts/c24/c24.rpy:1908
translate french c24s004_Eri_Dap_Kat_Nor_d8a5c890:

    # eri "La podías haber puesto en una situación desagradable cuando no estaba preparada."
    eri "Vous auriez pu la mettre dans une situation désagréable alors qu'elle n'y était pas préparée."

# game/scripts/c24/c24.rpy:1910
translate french c24s004_Eri_Dap_Kat_Nor_75b6556d:

    # kat "Si no lo hubiera hecho, le hubiera estado dando vueltas al mismo tema durante meses..."
    kat "Si je ne l'avais pas fait, j'aurais ruminé le même problème pendant des mois..."

# game/scripts/c24/c24.rpy:1912
translate french c24s004_Eri_Dap_Kat_Nor_ea410f3c:

    # nor "Chicas, ¿me podéis dejar a solas con [kat] un momento?"
    nor "Les filles, vous pouvez me laisser seul avec [kat] un instant ?"

# game/scripts/c24/c24.rpy:1914
translate french c24s004_Eri_Dap_Kat_Nor_e0a53f01:

    # dap "Sí, quiero acostarme pronto hoy."
    dap "Oui, je veux me coucher tôt ce soir."

# game/scripts/c24/c24.rpy:1915
translate french c24s004_Eri_Dap_Kat_Nor_b88c34fe:

    # eri "No seas muy dura con ella, Mamá."
    eri "Ne sois pas trop dure avec elle, maman."

# game/scripts/c24/c24.rpy:1917
translate french c24s004_Eri_Dap_Kat_Nor_1c4ddfff:

    # kat "¿Tan malo ha sido lo que he hecho?"
    kat "Ce que j'ai fait était-il vraiment si grave ?"

# game/scripts/c24/c24.rpy:1919
translate french c24s004_Eri_Dap_Kat_Nor_fc1e12cb:

    # nor "Solo ha sido malo que lo hicieras sin consultarle a [kim] previamente."
    nor "Le seul point négatif, c'est que vous l'avez fait sans consulter [kim] au préalable."

# game/scripts/c24/c24.rpy:1922
translate french c24s004_Eri_Dap_Kat_Nor_b0d28bba:

    # nor "Cuando ha venido a preguntarme si me importaría que entrara en el harén estaba muy enfadada."
    nor "Quand il est venu me demander si cela me dérangeait qu'il entre dans le harem, j'étais furieuse."

# game/scripts/c24/c24.rpy:1924
translate french c24s004_Eri_Dap_Kat_Nor_16589389:

    # nor "Cuando ha venido a preguntarme si me importaría que intentara algo con [mc] estaba muy enfadada."
    nor "Quand il est venu me demander si cela me dérangerait qu'il essaie quelque chose avec [mc], j'étais très en colère."

# game/scripts/c24/c24.rpy:1926
translate french c24s004_Eri_Dap_Kat_Nor_0150f8d4:

    # nor "Cuando me ha contado lo que has hecho estaba muy enfadada."
    nor "Quand elle m'a raconté ce que tu as fait, j'étais furieuse."

# game/scripts/c24/c24.rpy:1928
translate french c24s004_Eri_Dap_Kat_Nor_8912c844:

    # kat "Lo siento, supongo que debería disculparme..."
    kat "Je suis désolé, je suppose que je devrais m'excuser..."

# game/scripts/c24/c24.rpy:1930
translate french c24s004_Eri_Dap_Kat_Nor_a706ac1f:

    # nor "Como ha dicho [eri], el problema han sido las formas."
    nor "Comme l'a dit [eri], le problème réside dans les méthodes."

# game/scripts/c24/c24.rpy:1931
translate french c24s004_Eri_Dap_Kat_Nor_486e0076:

    # nor "Imagínate que yo hago lo mismo contigo."
    nor "Imaginez si je vous faisais la même chose."

# game/scripts/c24/c24.rpy:1933
translate french c24s004_Eri_Dap_Kat_Nor_a275e1f1:

    # kat "No es lo mismo, [nor]..."
    kat "Ce n'est pas pareil, [nor]..."

# game/scripts/c24/c24.rpy:1935
translate french c24s004_Eri_Dap_Kat_Nor_84383461:

    # nor "¿Cuál es la diferencia? Tú también vas a darle vueltas al tema durante mucho tiempo, por lo que parece."
    nor "Quelle est la différence ? Il semblerait que vous alliez y réfléchir longuement vous aussi."

# game/scripts/c24/c24.rpy:1936
translate french c24s004_Eri_Dap_Kat_Nor_57295e46:

    # nor "Y no me digas que es más complicado."
    nor "Et ne me dites pas que c'est plus compliqué."

# game/scripts/c24/c24.rpy:1938
translate french c24s004_Eri_Dap_Kat_Nor_d3d12574:

    # kat "Es que es más complicado..."
    kat "C'est plus compliqué que ça..."

# game/scripts/c24/c24.rpy:1940
translate french c24s004_Eri_Dap_Kat_Nor_b2ffd429:

    # nor "¿Por qué? ¿Porque incluye a [kim] y a [mc] en tu caso?"
    nor "Pourquoi ? Parce que cela inclut [kim] et [mc] dans votre cas ?"

# game/scripts/c24/c24.rpy:1941
translate french c24s004_Eri_Dap_Kat_Nor_3feb4a95:

    # nor "¿Te encierro con los dos en una habitación mañana? ¿O espero a saber si acaban juntos?"
    nor "Devrais-je vous enfermer tous les deux dans une pièce demain ? Ou devrais-je attendre de voir s’ils finissent par se mettre ensemble ?"

# game/scripts/c24/c24.rpy:1943
translate french c24s004_Eri_Dap_Kat_Nor_71da3642:

    # kat "Me moriría de vergüenza..."
    kat "Je mourrais de honte..."

# game/scripts/c24/c24.rpy:1945
translate french c24s004_Eri_Dap_Kat_Nor_0e9fbcee:

    # nor "Eso es lo que le ha pasado a [kim] esta mañana."
    nor "C'est ce qui est arrivé à [kim] ce matin."

# game/scripts/c24/c24.rpy:1946
translate french c24s004_Eri_Dap_Kat_Nor_ccee749e:

    # nor "[deb.nick] lo podía hacer con [lis] porque son hermanas. Sabía cómo iba a reaccionar ella saliera lo que saliera de ese encierro."
    nor "[deb.nick] Je pouvais le faire avec [lis] parce que ce sont des sœurs. Je savais comment elle réagirait quoi qu'il arrive après cet enfermement."

# game/scripts/c24/c24.rpy:1948
translate french c24s004_Eri_Dap_Kat_Nor_17a5433c:

    # nor "No la has encerrado con [mc], pero sí con [mar], que es casi más importante para ella."
    nor "Vous ne l'avez pas entouré d'un [mc], mais vous l'avez fait avec un [mar], ce qui est presque plus important pour elle."

# game/scripts/c24/c24.rpy:1949
translate french c24s004_Eri_Dap_Kat_Nor_e6ee482d:

    # nor "Y tú te podías imaginar la respuesta que iba a dar [mar], pero pese a todo has forzado una situación que no tenías derecho a forzar."
    nor "Et vous pouvez imaginer la réponse que j'allais donner [mar], mais malgré tout, vous avez forcé une situation que vous n'aviez pas le droit de forcer."

# game/scripts/c24/c24.rpy:1951
translate french c24s004_Eri_Dap_Kat_Nor_117fad36:

    # kat "Pero es que... necesitaba forzarla..."
    kat "Mais... j'ai dû forcer les choses..."

# game/scripts/c24/c24.rpy:1953
translate french c24s004_Eri_Dap_Kat_Nor_0b9824dc:

    # nor "¿Por qué? ¿Crees que, si [kim] y [mc] acaban juntos, te vas a quitar a los dos de la cabeza?"
    nor "Pourquoi ? Crois-tu vraiment que si [kim] et [mc] se retrouvent ensemble, tu parviendras à les oublier ?"

# game/scripts/c24/c24.rpy:1955
translate french c24s004_Eri_Dap_Kat_Nor_c90b7790:

    # kat "Sí, esa es la idea. Matar dos pájaros de un tiro..."
    kat "Oui, c'est l'idée. Faire d'une pierre deux coups..."

# game/scripts/c24/c24.rpy:1956
translate french c24s004_Eri_Dap_Kat_Nor_6455063e:

    # kat "*Susurrando para sí misma* O dos esperanzas a la vez..."
    kat "*À voix basse* Ou deux espoirs à la fois..."

# game/scripts/c24/c24.rpy:1958
translate french c24s004_Eri_Dap_Kat_Nor_6e890a8a:

    # nor "Eso no va a funcionar, [kat]."
    nor "Ça ne marchera pas, [kat]."

# game/scripts/c24/c24.rpy:1959
translate french c24s004_Eri_Dap_Kat_Nor_0904c7da:

    # nor "Si acaban juntos te empezarás a imaginar las posibilidades."
    nor "S'ils finissent par se mettre ensemble, vous commencerez à imaginer les possibilités."

# game/scripts/c24/c24.rpy:1960
translate french c24s004_Eri_Dap_Kat_Nor_25c26731:

    # nor "Y si no acaban juntos, seguirás como estás ahora mismo, pero habrás conseguido enfadar a [kim]."
    nor "Et s'ils ne finissent pas ensemble, vous resterez comme vous êtes actuellement, mais vous aurez réussi à mettre [kim] en colère."

# game/scripts/c24/c24.rpy:1962
translate french c24s004_Eri_Dap_Kat_Nor_69402303:

    # kat "Pero es que no sabes lo difícil que es compartir habitación con una de las mujeres más bonitas que he visto nunca."
    kat "Mais vous n'imaginez pas à quel point il est difficile de partager une chambre avec l'une des plus belles femmes que j'aie jamais vues."

# game/scripts/c24/c24.rpy:1963
translate french c24s004_Eri_Dap_Kat_Nor_bfef32ac:

    # kat "Reír juntas, hacernos amigas... verla desnuda cada día..."
    kat "Rire ensemble, devenir amis… la voir nue tous les jours…"

# game/scripts/c24/c24.rpy:1965
translate french c24s004_Eri_Dap_Kat_Nor_7fac8621:

    # nor "¿Y con [mc]? ¿Qué esperas conseguir con él? ¿Ya has conseguido aclararte?"
    nor "Et [mc] ? Quel est votre objectif ? Avez-vous déjà trouvé une solution ?"

# game/scripts/c24/c24.rpy:1967
translate french c24s004_Eri_Dap_Kat_Nor_aebf4443:

    # kat "Ahí está el problema... yo era feliz mientras sólo me gustaban las mujeres..."
    kat "Voilà le problème… J’étais heureuse tant que je n’aimais que les femmes…"

# game/scripts/c24/c24.rpy:1969
translate french c24s004_Eri_Dap_Kat_Nor_2f49e779:

    # kat "Entonces llega [mc] y me empieza a tratar como una persona normal, y eso me desconcierta."
    kat "Puis [mc] arrive et commence à me traiter comme une personne normale, et cela me perturbe."

# game/scripts/c24/c24.rpy:1971
translate french c24s004_Eri_Dap_Kat_Nor_9aa444f3:

    # kat "Entonces llega [mc] y, pese a que se ha comportado como un capullo muchas veces, me desconcierta."
    kat "Puis [mc] arrive et, malgré son comportement odieux à de nombreuses reprises, il me laisse perplexe."

# game/scripts/c24/c24.rpy:1973
translate french c24s004_Eri_Dap_Kat_Nor_b47939bc:

    # kat "Aún no sé si siento algo por él, o si tan solo estoy tan desconcertada con él que tengo la cabeza hecha un lío."
    kat "Je ne sais toujours pas si j'éprouve quelque chose pour lui, ou si je suis simplement tellement perturbée par lui que j'en ai la tête qui tourne."

# game/scripts/c24/c24.rpy:1974
translate french c24s004_Eri_Dap_Kat_Nor_58fa7ef1:

    # kat "Pero si [kim] y él acaban juntos, en el fondo les habré hecho un favor... ¿no?"
    kat "Mais si [kim] et lui finissent ensemble, au fond de moi, je leur aurai rendu service… n’est-ce pas ?"

# game/scripts/c24/c24.rpy:1976
translate french c24s004_Eri_Dap_Kat_Nor_eb6b5d3f:

    # nor "Mi niña, las cosas no funcionan así."
    nor "Ma chère enfant, les choses ne fonctionnent pas ainsi."

# game/scripts/c24/c24.rpy:1977
translate french c24s004_Eri_Dap_Kat_Nor_7fb92b5e:

    # nor "Respóndeme a esta pregunta sin pensarlo. Si tuvieras que elegir entre estar con [kim] o estar con [mc], ¿qué escogerías?"
    nor "Répondez à cette question sans réfléchir. Si vous deviez choisir entre être avec [kim] ou être avec [mc], lequel choisiriez-vous ?"

# game/scripts/c24/c24.rpy:1979
translate french c24s004_Eri_Dap_Kat_Nor_f6372631:

    # "[kat] responde automáticamente, sin pensar."
    "[kat] répond automatiquement, sans réfléchir."

# game/scripts/c24/c24.rpy:1982
translate french c24s004_Eri_Dap_Kat_Nor_9b4bb496:

    # kat "Con los dos."
    kat "Avec tous les deux."

# game/scripts/c24/c24.rpy:1984
translate french c24s004_Eri_Dap_Kat_Nor_dfd0c326:

    # kat "Con [mc]."
    kat "Avec [mc]."

# game/scripts/c24/c24.rpy:1986
translate french c24s004_Eri_Dap_Kat_Nor_f9c67328:

    # kat "Con [kim]."
    kat "Avec [kim]."

# game/scripts/c24/c24.rpy:1987
translate french c24s004_Eri_Dap_Kat_Nor_fdcb1017:

    # kat "Y si [mc] fuera menos capullo, con los dos."
    kat "Et si [mc] était moins un crétin, alors avec les deux."

# game/scripts/c24/c24.rpy:1989
translate french c24s004_Eri_Dap_Kat_Nor_218c765e:

    # nor "Ahí tienes la respuesta a tus dilemas. A veces, no pensar las cosas es la mejor forma de descubrir la respuesta adecuada."
    nor "Voilà la solution à vos dilemmes. Parfois, ne pas trop réfléchir est la meilleure façon de trouver la bonne réponse."

# game/scripts/c24/c24.rpy:1991
translate french c24s004_Eri_Dap_Kat_Nor_b887f943:

    # kat "¡Joder! ¿Así de fácil?"
    kat "Mince ! Comme ça, d'un coup ?"

