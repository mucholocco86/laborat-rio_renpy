

# game/scripts/c24/c24.rpy:37
translate french c24s001_Bet_6854d5fe:

    # mc "Pues sí, creo que nos ha oído."
    mc "Oui, je pense qu'il nous a entendus."

# game/scripts/c24/c24.rpy:38
translate french c24s001_Bet_bdb3454f:

    # mc "¿Vas a dormir con eso?"
    mc "Tu vas dormir avec ça ?"

# game/scripts/c24/c24.rpy:40
translate french c24s001_Bet_747077f8:

    # bet "No he dormido con un sujetador en mi vida... Esto tiene que ser super incómodo."
    bet "Je n'ai jamais dormi avec un soutien-gorge de ma vie... Ça doit être super inconfortable."

# game/scripts/c24/c24.rpy:41
translate french c24s001_Bet_26f867c8:

    # mc "Te puedo dejar la camiseta que me iba a poner mañana, si quieres."
    mc "Je peux te prêter la chemise que je comptais porter demain, si tu veux."

# game/scripts/c24/c24.rpy:43
translate french c24s001_Bet_1c3588bf:

    # bet "Sí, por favor..."
    bet "Oui s'il vous plait..."

# game/scripts/c24/c24.rpy:44
translate french c24s001_Bet_b71ed625:

    # mc "Aunque también podrías dormir sin el sujetador. No voy a ver nada que no haya visto en la piscina..."
    mc "On pourrait aussi dormir sans soutien-gorge. Je ne verrai rien de nouveau à la piscine…"

# game/scripts/c24/c24.rpy:45
translate french c24s001_Bet_1f50df54:

    # mc "O en la cocina, durante la partida de DnD."
    mc "Ou dans la cuisine, pendant une partie de Donjons et Dragons."

# game/scripts/c24/c24.rpy:47
translate french c24s001_Bet_7c4deb52:

    # bet "¡[mc]! ¡Es diferente!"
    bet "C'est différent !"

# game/scripts/c24/c24.rpy:48
translate french c24s001_Bet_e1e7e3f0:

    # bet "No íbamos a compartir cama y no habíamos tenido la conversación que hemos tenido esta mañana en el coche."
    bet "Nous n'allions pas partager le même lit et nous n'avions pas eu la conversation que nous avons eue ce matin dans la voiture."

# game/scripts/c24/c24.rpy:49
translate french c24s001_Bet_6b8e33f0:

    # mc "No te preocupes, te presto mi camiseta."
    mc "Ne t'inquiète pas, je te prêterai ma chemise."

# game/scripts/c24/c24.rpy:50
translate french c24s001_Bet_3e6d5518:

    # mc "De todas formas, no iba a pasar nada. Te dije que podríamos tener una oportunidad de estar juntos si no eras monja. Y aún lo eres."
    mc "De toute façon, il ne se passerait rien. Je t'avais dit qu'on aurait une chance d'être ensemble si tu n'étais pas religieuse. Et tu l'es toujours."

# game/scripts/c24/c24.rpy:52
translate french c24s001_Bet_2d289fcf:

    # bet "Lo sé..."
    bet "Je sais..."

# game/scripts/c24/c24.rpy:53
translate french c24s001_Bet_190311ff:

    # bet "Dame esa camiseta, por favor."
    bet "Donnez-moi cette chemise, s'il vous plaît."

# game/scripts/c24/c24.rpy:54
translate french c24s001_Bet_ba2cbe37:

    # mc "Se la presté a [eil] el día que llegó a casa y me parece que ha dado el cuello de sí un poco..."
    mc "Je l'ai prêté à [eil] le jour de son retour à la maison et il me semble que le manche s'est un peu détendu..."

# game/scripts/c24/c24.rpy:56
translate french c24s001_Bet_a5a52c4a:

    # bet "*Desde el lavabo* ¿En serio? ¿No tenías otra camiseta?"
    bet "*Depuis la salle de bain* Sérieusement ? Tu n'avais pas une autre chemise ?"

# game/scripts/c24/c24.rpy:57
translate french c24s001_Bet_cc013ef9:

    # mc "*Risa* Lo sé, casi parece hecho a propósito."
    mc "*Rires* Je sais, on dirait presque que c'était fait exprès."

# game/scripts/c24/c24.rpy:58
translate french c24s001_Bet_b09f2caa:

    # bet "*Desde el lavabo* ¿Estás seguro de que esto no es un plan tuyo y de [emm]?"
    bet "*Depuis la salle de bain* Es-tu sûr que ce n'est pas un plan que toi et [emm] avez concocté ?"

# game/scripts/c24/c24.rpy:59
translate french c24s001_Bet_6f244a5c:

    # mc "*Risa* No podía haber planeado algo así antes de la conversación de esta mañana."
    mc "*Rires* Je n'aurais pas pu prévoir une chose pareille avant notre conversation de ce matin."

# game/scripts/c24/c24.rpy:60
translate french c24s001_Bet_b9f3d257:

    # mc "[emm] ha tenido tiempo de planearlo si ha fingido estar dormida, pero lo de la camiseta es casualidad. *Risa* Me la regaló Jam hace años."
    mc "[emm] Si elle a fait semblant de dormir, elle a eu le temps de le planifier, mais l'histoire du t-shirt, c'est juste une coïncidence. *Rires* Jam me l'a donné il y a des années."

# game/scripts/c24/c24.rpy:61
translate french c24s001_Bet_ce5e6d01:

    # mc "Y antes de que preguntes, me gustaría recuperarla. Es un préstamo."
    mc "Et avant que vous ne posiez la question, je souhaite récupérer cet argent. C'est un prêt."

# game/scripts/c24/c24.rpy:67
translate french c24s001_Bet_38add06f:

    # bet "Al menos es grande. No creo que entrase en una camiseta tuya de ahora. Pero es cortísima..."
    bet "Au moins, il est grand. Je ne pense pas qu'il rentrerait dans un de tes t-shirts actuels. Mais il est vraiment court…"

# game/scripts/c24/c24.rpy:68
translate french c24s001_Bet_baa147e2:

    # mc "No voy a ver nada que no haya visto hace cinco minutos. *Risa* Porque sigues llevando las bragas, ¿verdad?"
    mc "Je ne vais rien voir que je n'aie pas vu il y a cinq minutes. *Rires* Parce que tu portes encore ta culotte, n'est-ce pas ?"

# game/scripts/c24/c24.rpy:70
translate french c24s001_Bet_5573fb9b:

    # bet "¡Claro que sigo llevándolas!"
    bet "Bien sûr que je les porte encore !"

# game/scripts/c24/c24.rpy:71
translate french c24s001_Bet_0a4dd1d1:

    # mc "Sólo bromeaba, Tía [bet]. Vamos a la cama; se está haciendo tarde."
    mc "Je plaisantais, tante [bet]. Allons nous coucher ; il se fait tard."

# game/scripts/c24/c24.rpy:73
translate french c24s001_Bet_67289901:

    # "Tras apagar las luces..."
    "Après avoir éteint les lumières..."

# game/scripts/c24/c24.rpy:74
translate french c24s001_Bet_aaa1b5a2:

    # mc "Buenas noches, Tía [bet]."
    mc "Bonsoir, tante [bet]."

# game/scripts/c24/c24.rpy:75
translate french c24s001_Bet_5f3e1bd6:

    # bet "Buenas noches, [mc]."
    bet "Bonsoir, [mc]."

# game/scripts/c24/c24.rpy:77
translate french c24s001_Bet_2b7a1410:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y que tu mano acabe en el mismo sitio que acabó con [sca]. Salvando las diferencias de tamaño."
    "Vous essayez de dormir, mais en vain. Vous craignez de bouger pendant votre sommeil et que votre main se retrouve au même endroit qu'avant [sca]. Différences de taille mises à part."

# game/scripts/c24/c24.rpy:79
translate french c24s001_Bet_6dd4bc9d:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y hacer algo que incomode a Tía [bet]."
    "Tu essaies de dormir, mais tu n'y arrives pas. Tu as peur de bouger pendant ton sommeil et de faire quelque chose qui pourrait contrarier tante [bet]."

# game/scripts/c24/c24.rpy:80
translate french c24s001_Bet_aeca0d27:

    # "Al cabo de un rato..."
    "Après un certain temps..."

# game/scripts/c24/c24.rpy:81
translate french c24s001_Bet_6a5cc46a:

    # bet "*Susurrando* ¿Estás dormido?"
    bet "*Chuchotant* Tu dors ?"

# game/scripts/c24/c24.rpy:82
translate french c24s001_Bet_142b9233:

    # mc "No, no puedo dormir. ¿Tú tampoco?"
    mc "Non, je n'arrive pas à dormir. Vous non plus ?"

# game/scripts/c24/c24.rpy:84
translate french c24s001_Bet_ba16db52:

    # bet "No, estaba pensando en todo lo que ha pasado hoy..."
    bet "Non, je pensais à tout ce qui s'est passé aujourd'hui..."

# game/scripts/c24/c24.rpy:85
translate french c24s001_Bet_2cab15e3:

    # mc "¿Quieres hablarlo?"
    mc "Tu veux en parler ?"

# game/scripts/c24/c24.rpy:86
translate french c24s001_Bet_bd85b516:

    # bet "No, no quiero que pierdas horas de sueño. Intenta dormir."
    bet "Non, je ne veux pas que tu perdes le sommeil. Essaie de dormir un peu."

# game/scripts/c24/c24.rpy:87
translate french c24s001_Bet_c250bdf1:

    # mc "No voy a poder. Voy a encender la luz."
    mc "Je ne pourrai pas. Je vais allumer la lumière."

# game/scripts/c24/c24.rpy:89
translate french c24s001_Bet_1c55fdce:

    # mc "Sé que es tontería preguntarte qué te preocupa, pero no tienes que tomar la decisión hoy. Tienes dos meses para pensarlo."
    mc "Je sais que ça peut paraître bête de te demander ce qui te préoccupe, mais tu n'es pas obligée de prendre cette décision aujourd'hui. Tu as deux mois pour y réfléchir."

# game/scripts/c24/c24.rpy:90
translate french c24s001_Bet_0d21d4ba:

    # bet "Esa decisión ya la he tomado. No voy a entrar en un convento de clausura ni me voy a ir a Latinoamérica."
    bet "Ma décision est déjà prise. Je n'entrerai pas dans un couvent, et je n'irai pas non plus en Amérique latine."

# game/scripts/c24/c24.rpy:91
translate french c24s001_Bet_4845b11d:

    # bet "Las dos cosas significarían perder a la familia, y no estoy dispuesta a ello."
    bet "Les deux options signifieraient perdre ma famille, et je ne suis pas prêt à cela."

# game/scripts/c24/c24.rpy:92
translate french c24s001_Bet_640320c2:

    # mc "Bueno, volver a África, que era tu plan inicial, también hubiera significado que no nos verías..."
    mc "Eh bien, retourner en Afrique, comme prévu initialement, aurait aussi signifié que vous ne nous auriez pas revus..."

# game/scripts/c24/c24.rpy:94
translate french c24s001_Bet_cb00520d:

    # bet "Es diferente. De allí podría volver una o dos veces al año para veros. De un convento en Perú, no."
    bet "C'est différent. De là, je pourrais revenir une ou deux fois par an pour te voir. D'un couvent au Pérou, non."

# game/scripts/c24/c24.rpy:95
translate french c24s001_Bet_b2431031:

    # mc "Tienes razón, no lo había pensado así. Para mí sería casi igual de duro que te fueras a Perú que a... no sé... un país de África que no fuera Tanzania."
    mc "Vous avez raison, je n'y avais pas pensé. Pour moi, ce serait presque aussi difficile si vous alliez au Pérou que si vous alliez dans… je ne sais pas… un autre pays africain que la Tanzanie."

# game/scripts/c24/c24.rpy:96
translate french c24s001_Bet_1d335301:

    # mc "Me he acostumbrado a verte todos los días, y sería difícil si te tuvieras que ir."
    mc "Je me suis habitué à te voir tous les jours, et ce serait difficile si tu devais partir."

# game/scripts/c24/c24.rpy:98
translate french c24s001_Bet_fb7a27b1:

    # bet "Por eso te digo que la decisión está tomada. Por lo que a mí respecta, he dejado de ser monja hace horas, aunque deje de serlo oficialmente en unos meses."
    bet "C'est pourquoi je vous annonce que la décision est prise. Pour moi, j'ai cessé d'être religieuse il y a quelques heures, même si je ne cesserai officiellement de l'être que dans quelques mois."

# game/scripts/c24/c24.rpy:99
translate french c24s001_Bet_c1614e7a:

    # mc "Si tienes la decisión tomada, ¿por qué no hacerlo oficial mañana cuando vayas a por la documentación de los conventos?"
    mc "Si vous avez pris votre décision, pourquoi ne pas l'officialiser demain lorsque vous irez chercher les documents pour les couvents ?"

# game/scripts/c24/c24.rpy:100
translate french c24s001_Bet_44470795:

    # mc "Supongo que la iglesia pensará que tomarás la decisión entre las dos opciones que te han propuesto, no una tercera opción."
    mc "Je suppose que l'église pensera que vous choisirez entre les deux options qu'elle a proposées, et non entre une troisième."

# game/scripts/c24/c24.rpy:101
translate french c24s001_Bet_5ce4fd71:

    # mc "No sé si tendrán que preparar algún papel para que te des de baja, o como se diga."
    mc "Je ne sais pas s'ils devront préparer des documents pour que vous puissiez vous désabonner, ou quel que soit le nom de la procédure."

# game/scripts/c24/c24.rpy:103
translate french c24s001_Bet_7d4ff649:

    # bet "Tienes razón... sería una forma de cerrar todo este asunto, al menos hasta que firme los papeles que seguro que me harán firmar."
    bet "Vous avez raison… ce serait un moyen de clore toute cette affaire, du moins jusqu’à ce que je signe les papiers qu’ils ne manqueront pas de me faire signer."

# game/scripts/c24/c24.rpy:104
translate french c24s001_Bet_d0033555:

    # mc "Genial. Un tema resuelto. Supongo que lo otro a lo que le estabas dando vueltas era a lo de la certificación, pero eso ya ha quedado resuelto."
    mc "Parfait. Problème résolu. J'imagine que vous pensiez aussi à la certification, mais c'est réglé maintenant."

# game/scripts/c24/c24.rpy:106
translate french c24s001_Bet_b1035ecd:

    # bet "Me preocupa ponerme a estudiar a mi edad, y empezar a buscar trabajo... Soy una anciana a punto de retirarse, al fin y al cabo."
    bet "Je m'inquiète de commencer mes études à mon âge et de commencer à chercher un emploi... Après tout, je suis une vieille dame sur le point de prendre ma retraite."

# game/scripts/c24/c24.rpy:107
translate french c24s001_Bet_1e4e4c73:

    # mc "Eres una mujer con un montón de experiencia. Creo que eso también lo valorarán. ¿Alguna cosa más que te preocupe?"
    mc "Vous êtes une femme très expérimentée. Je pense qu'ils apprécieront cela aussi. Avez-vous autre chose en tête ?"

# game/scripts/c24/c24.rpy:110
translate french c24s001_Bet_770afeaa:

    # bet "Lo que has dicho antes."
    bet "Ce que vous avez dit précédemment."

# game/scripts/c24/c24.rpy:111
translate french c24s001_Bet_17f34aa8:

    # mc "¿Qué he dicho?"
    mc "Qu'est-ce que j'ai dit ?"

# game/scripts/c24/c24.rpy:114
translate french c24s001_Bet_676009a9:

    # bet "Lo de que podríamos tener una oportunidad de estar juntos si no era monja. Y que aún lo era. Aunque solo sea oficialmente..."
    bet "L'idée qu'on aurait peut-être une chance d'être ensemble si elle n'était pas religieuse. Et qu'elle l'était encore. Même si ce n'était qu'officiellement..."

# game/scripts/c24/c24.rpy:115
translate french c24s001_Bet_2d82726b:

    # mc "¿Y qué te preocupa sobre eso?"
    mc "Et qu'est-ce qui vous inquiète à ce sujet ?"

# game/scripts/c24/c24.rpy:117
translate french c24s001_Bet_dcbab1f8:

    # bet "Hace 40 años que no estoy con nadie... Ya no sé qué hacer o cómo hacerlo. Y no me refiero al sexo... me refiero... a esa oportunidad de la que hablabas."
    bet "Ça fait quarante ans que je n'ai pas été avec quelqu'un… Je ne sais plus quoi faire ni comment m'y prendre. Et je ne parle pas de sexe… Je veux dire… cette opportunité dont tu parlais."

# game/scripts/c24/c24.rpy:118
translate french c24s001_Bet_c88be3be:

    # mc "Eso es muy fácil. Se habla todo. Cualquier duda que tengas sobre lo que debes o no debes hacer, solo tienes que hablarlo conmigo."
    mc "C'est très simple. Nous parlerons de tout. Si vous avez le moindre doute sur ce que vous devez ou ne devez pas faire, n'hésitez pas à m'en parler."

# game/scripts/c24/c24.rpy:120
translate french c24s001_Bet_debec0dd:

    # mc "Por ejemplo, yo podría preguntar si puedo hacer esto ahora que sólo eres monja oficialmente pero ya no te consideras una."
    mc "Par exemple, je pourrais vous demander si je peux faire cela maintenant que vous n'êtes officiellement qu'une religieuse, mais que vous ne vous considérez plus comme telle."

# game/scripts/c24/c24.rpy:121
translate french c24s001_Bet_57cad9b2:

    # mc "Y tú podrías contestar sí o no, o no contestar y dejarme seguir."
    mc "Vous pouvez répondre par oui ou par non, ou ne pas répondre et me laisser continuer."

# game/scripts/c24/c24.rpy:122
translate french c24s001_Bet_09ec5f6e:

    # bet "O podría preguntar qué pretendes con eso..."
    bet "Ou je pourrais vous demander ce que vous espérez obtenir avec cela..."

# game/scripts/c24/c24.rpy:123
translate french c24s001_Bet_46c34fcd:

    # mc "Podrías, pero... ¿lo estás preguntando?"
    mc "Vous pourriez, mais... vous posez la question ?"

# game/scripts/c24/c24.rpy:125
translate french c24s001_Bet_2fd44d12:

    # bet "No..."
    bet "Non..."

# game/scripts/c24/c24.rpy:126
translate french c24s001_Bet_0d02ac2b:

    # mc "Yo tampoco he preguntado si puedo..."
    mc "Je n'ai pas demandé si je pouvais non plus..."

# game/scripts/c24/c24.rpy:127
translate french c24s001_Bet_c7bbd3dd:

    # bet "Pero puedes..."
    bet "Mais vous pouvez..."

# game/scripts/c24/c24.rpy:128
translate french c24s001_Bet_3c1ea0e5:

    # mc "Y si te dijera que quiero recuperar mi camiseta, ¿cuál sería tu respuesta?"
    mc "Et si je vous disais que je voulais récupérer ma chemise, que répondriez-vous ?"

# game/scripts/c24/c24.rpy:130
translate french c24s001_Bet_46c8122d:

    # bet "*Risa* Que te la tendré que devolver porque me la has prestado mientras aún era monja..."
    bet "*Rires* Je vais devoir te le rendre, car tu me l'as prêté quand j'étais encore religieuse..."

# game/scripts/c24/c24.rpy:132
translate french c24s001_Bet_a8f8ea5e:

    # bet "[sca] te enseño cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "[sca] Je vais te montrer comment ça marche quand tu prêtes des vêtements à ton/ta partenaire, d'accord ? Ça n'a pas changé depuis mon époque."

# game/scripts/c24/c24.rpy:134
translate french c24s001_Bet_bc00184a:

    # bet "Ya sabes cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "Vous savez comment ça marche quand vous prêtez des vêtements à votre partenaire, n'est-ce pas ? Ça n'a pas changé depuis mon époque."

# game/scripts/c24/c24.rpy:135
translate french c24s001_Bet_afb45094:

    # mc "*Risa* Creo que gastaré mucho en ropa entonces. Pero de momento, quiero mi camiseta."
    mc "*Rires* Je crois que je vais dépenser une fortune en vêtements alors. Mais pour l'instant, je veux juste mon t-shirt."

# game/scripts/c24/c24.rpy:138
translate french c24s001_Bet_20be496e:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a tu Tía Abuela?"
    bet "*Réprimant un rire tout en feignant la surprise* [mc]! Veux-tu voir les seins de ta grand-tante ?"

# game/scripts/c24/c24.rpy:140
translate french c24s001_Bet_03021ef5:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a una anciana exmonja?"
    bet "*Réprimant un rire tout en feignant la surprise* [mc]! Tu veux voir les seins d'une ancienne nonne ?"

# game/scripts/c24/c24.rpy:141
translate french c24s001_Bet_aedbe009:

    # mc "No solo verlas. Aunque no me canse de verlas, hoy quiero hacer más que solo mirarlas."
    mc "Pas seulement pour les regarder. Bien que je ne me lasse jamais de les regarder, aujourd'hui je veux faire plus que simplement les observer."

# game/scripts/c24/c24.rpy:143
translate french c24s001_Bet_0cf9ce16:

    # bet "¿Mejor así, entonces?"
    bet "C'est mieux comme ça, alors ?"

# game/scripts/c24/c24.rpy:144
translate french c24s001_Bet_70eac7fa:

    # mc "Mucho mejor... pero antes de continuar quiero preguntarte si estás realmente segura de esto."
    mc "C'est beaucoup mieux... mais avant de continuer, je voudrais vous demander si vous en êtes vraiment sûr."

# game/scripts/c24/c24.rpy:145
translate french c24s001_Bet_68c35d5c:

    # mc "Aún eres oficialmente una monja y no me gustaría que por la mañana te sintieras mal por lo que pase ahora."
    mc "Tu es toujours officiellement une religieuse, et je ne voudrais pas que tu te sentes mal demain matin à cause de ce qui se passe maintenant."

# game/scripts/c24/c24.rpy:147
translate french c24s001_Bet_13a4ced8:

    # bet "Estoy segurísima, no te preocupes. No me voy a volver a poner el hábito nunca más."
    bet "J'en suis absolument sûre, ne t'inquiète pas. Je ne porterai plus jamais cette habitude."

# game/scripts/c24/c24.rpy:148
translate french c24s001_Bet_f0e73b0b:

    # mc "En ese caso, creo que necesito acariciarte. *Risa* Y eliminar la camiseta de la ecuación."
    mc "Dans ce cas, je crois que je vais te caresser. *Rires* Et oublions la chemise."

# game/scripts/c24/c24.rpy:149
translate french c24s001_Bet_69b8fde0:

    # bet "En ese caso, creo que estoy de acuerdo en devolverte la camiseta. Por esta vez."
    bet "Dans ce cas, je crois que je vais accepter de renvoyer la chemise. Juste pour cette fois."

# game/scripts/c24/c24.rpy:151
translate french c24s001_Bet_007a24b7:

    # bet "¿Así o quieres que me desnude del todo?"
    bet "Alors, vous voulez que je me déshabille complètement ?"

# game/scripts/c24/c24.rpy:152
translate french c24s001_Bet_3c378150:

    # mc "Querré, pero todo a su tiempo. Ahora es el momento de entregar las caricias prometidas."
    mc "Je le ferai, mais chaque chose en son temps. Le moment est venu de prodiguer les caresses promises."

# game/scripts/c24/c24.rpy:153
translate french c24s001_Bet_1c7d23d5:

    # mc "Túmbate, por favor, quiero disfrutar de ese cuerpo como es debido."
    mc "Allongez-vous, s'il vous plaît, je veux profiter pleinement de ce corps."

# game/scripts/c24/c24.rpy:155
translate french c24s001_Bet_0c11c9c5:

    # bet "¿Así va bien?"
    bet "Est-ce que ça vous convient ?"

