    # eva "Supongo que no te refieres a lo que haces con [eri.nick]..."
    eva "Je suppose que vous ne faites pas référence à ce que vous faites avec [eri.nick]..."

# game/scripts/c22/c22.rpy:2266
translate french c22s004_EveNoRoute_2e706747:

    # mc "[eva], te quiero, pero no de esa forma."
    mc "[eva], je t'aime, mais pas de cette façon."

# game/scripts/c22/c22.rpy:2267
translate french c22s004_EveNoRoute_8d85247c:

    # mc "Quizás no sea el mejor momento para decirte algo así, pero tengo que ser sincero contigo y evitar que te hagas falsas esperanzas."
    mc "Ce n'est peut-être pas le meilleur moment pour vous annoncer une chose pareille, mais je dois être honnête avec vous et vous éviter de vous faire de faux espoirs."

# game/scripts/c22/c22.rpy:2269
translate french c22s004_EveNoRoute_97986df1:

    # "Salta como impulsada por un resorte."
    "Il bondit comme s'il était propulsé par un ressort."

# game/scripts/c22/c22.rpy:2270
translate french c22s004_EveNoRoute_aeb4230e:

    # eva "Pues llegas un poco tarde para eso... ¿Quieres que cambie algo de mí?"
    eva "Bon, vous arrivez un peu tard… Voulez-vous que je change quelque chose chez moi ?"

# game/scripts/c22/c22.rpy:2272
translate french c22s004_EveNoRoute_bff80ff8:

    # eva "Creía que... tengo la cara de [dap.nick]... ¿Quieres que me haga una trenza?"
    eva "Je me suis dit… J’ai le visage de [dap.nick]… Tu veux que je me tresse les cheveux ?"

# game/scripts/c22/c22.rpy:2274
