# game/scripts/c22/c22.rpy:1829
translate french c22s003_AmaCalls_c0b62619:

    # mc "¿Gavin? ¿Quién es Gavin?"
    mc "Gavin ? Qui est Gavin ?"

# game/scripts/c22/c22.rpy:1831
translate french c22s003_AmaCalls_df6f3fe4:

    # ama "Durante el secuestro... en la cocina... El Serie G a quién disparó [eva]."
    ama "Pendant l'enlèvement... dans la cuisine... Le G-Series qui a tiré [eva]."

# game/scripts/c22/c22.rpy:1832
translate french c22s003_AmaCalls_4b65fb16:

    # mc "¡Hostias! ¡Había olvidado su nombre! Recordaba a Erik y a Grant."
    mc "Putain ! J'avais oublié son nom ! Je me souvenais d'Erik et de Grant."

# game/scripts/c22/c22.rpy:1833
translate french c22s003_AmaCalls_38938ae3:

    # mc "Parezco tonto... iba a preguntar si está grave."
    mc "J'ai l'air bête... J'allais lui demander s'il était gravement malade."

# game/scripts/c22/c22.rpy:1835
translate french c22s003_AmaCalls_9ee20603:

    # ama "Sí, está grave. Fuera de peligro, pero grave."
    ama "Oui, son état est grave. Il n'est plus en danger, mais son état est grave."

# game/scripts/c22/c22.rpy:1836
translate french c22s003_AmaCalls_1e3e6765:

    # ama "Aunque le hicimos los primeros auxilios y lo evacuamos a Aruba en un avión medicalizado, no le han podido salvar el brazo."
    ama "Bien que nous lui ayons prodigué les premiers soins et l'ayons évacué vers Aruba par avion médical, ils n'ont pas pu sauver son bras."

# game/scripts/c22/c22.rpy:1837
translate french c22s003_AmaCalls_4e1bc8fc:

    # ama "[eva] le destrozó los nervios."
    ama "[eva] lui a brisé les nerfs."

# game/scripts/c22/c22.rpy:1838
translate french c22s003_AmaCalls_c3dc8ad6:

    # mc "Pero eran los malos, no se debería sentir así. Nos salvasteis."
    mc "Mais c'étaient les méchants, tu ne devrais pas penser comme ça. Tu nous as sauvés."

# game/scripts/c22/c22.rpy:1840
translate french c22s003_AmaCalls_74575155:

    # ama "[mc], parte del entrenamiento de los G lo hicieron [eva] y Diana. Conocíamos a los chicos desde que eran niños..."
    ama "[mc], une partie de l'entraînement des G était assurée par [eva] et Diana. Nous connaissions les garçons depuis leur enfance..."

# game/scripts/c22/c22.rpy:1841
translate french c22s003_AmaCalls_c691fab9:

    # mc "Lo entiendo. ¿Cómo está ella?"
    mc "Je comprends. Comment va-t-elle ?"

# game/scripts/c22/c22.rpy:1843
translate french c22s003_AmaCalls_5dae45bb:

    # ama "Muy jodida. Después de vaciar seis cargadores se ha metido en su habitación."
    ama "Elle est vraiment défoncée. Après avoir vidé six magazines, elle est allée dans sa chambre."

# game/scripts/c22/c22.rpy:1844
translate french c22s003_AmaCalls_9d125419:

    # ama "No quiere hablar conmigo. Por eso te he llamado."
    ama "Il ne veut pas me parler. C'est pour ça que je t'ai appelé."

# game/scripts/c22/c22.rpy:1845
translate french c22s003_AmaCalls_8ac27694:

    # mc "¿Y cómo estás tú?"
    mc "Et vous, comment allez-vous ?"

# game/scripts/c22/c22.rpy:1847
translate french c22s003_AmaCalls_55ed25ae:

    # ama "Jodida, pero menos. No lo conocía tanto como [eva], y no fui yo quien disparó."
    ama "C'était compliqué, mais moins grave. Je ne le connaissais pas aussi bien que [eva], et ce n'est pas moi qui lui ai tiré dessus."

# game/scripts/c22/c22.rpy:1848
translate french c22s003_AmaCalls_1450603d:

    # ama "[eva] es quién necesita hablar ahora mismo, no te preocupes por mí."
    ama "C'est [eva] qui a besoin de parler maintenant, ne vous inquiétez pas pour moi."

# game/scripts/c22/c22.rpy:1849
translate french c22s003_AmaCalls_ae45af4c:

    # mc "¿Crees que va a querer hablar conmigo?"
    mc "Pensez-vous qu'il voudra me parler ?"

# game/scripts/c22/c22.rpy:1851
translate french c22s003_AmaCalls_ac09df05:

    # ama "Hasta cierto punto representas la razón por la que disparó."
    ama "Dans une certaine mesure, vous représentez la raison pour laquelle il a tiré."

# game/scripts/c22/c22.rpy:1852
translate french c22s003_AmaCalls_f4956f9a:

    # ama "No por ti. Por la familia."
    ama "Pas pour vous. Pour la famille."

# game/scripts/c22/c22.rpy:1853
translate french c22s003_AmaCalls_93f7def9:

    # ama "Una familia que ni siquiera sabíamos que teníamos por entonces."
    ama "Une famille dont nous ignorions même l'existence à l'époque."

# game/scripts/c22/c22.rpy:1855
translate french c22s003_AmaCalls_cc0a482f:

    # mc "Lo entiendo. Déjame intentarlo. Sólo espero que no me dispare."
    mc "Je comprends. Laissez-moi essayer. J'espère juste qu'il ne me tirera pas dessus."

# game/scripts/c22/c22.rpy:1858
translate french c22s003_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c22/c22.rpy:1860
translate french c22s003_AmaCalls_7ee1cfab:

    # mc "[eva], soy yo. ¿Puedo pasar?"
    mc "[eva], c'est moi. Puis-je entrer ?"

# game/scripts/c22/c22.rpy:1861
translate french c22s003_AmaCalls_913eaf57:

    # eva "*A través de la puerta* ¡No!"
    eva "*À travers la porte* Non !"

# game/scripts/c22/c22.rpy:1862
translate french c22s003_AmaCalls_35a4914f:

    # mc "No me voy a ir a menos que salgas con un arma y me eches."
    mc "Je ne partirai pas à moins que vous ne sortiez avec une arme et ne me mettiez à la porte."

# game/scripts/c22/c22.rpy:1863
translate french c22s003_AmaCalls_96b3f929:

    # eva "*A través de la puerta* No quiero ver a nadie, [mc]."
    eva "*À travers la porte* Je ne veux voir personne, [mc]."

# game/scripts/c22/c22.rpy:1864
translate french c22s003_AmaCalls_be088dc4:

    # mc "OK. Me voy."
    mc "OK. Je m'en vais."

# game/scripts/c22/c22.rpy:1865
translate french c22s003_AmaCalls_1d338278:

    # eva "*A través de la puerta* Gracias por entenderlo, [mc]."
    eva "*Par la porte* Merci de votre compréhension, [mc]."

# game/scripts/c22/c22.rpy:1867
translate french c22s003_AmaCalls_efd3647b:

    # "Esperas un minuto al lado de la puerta antes de volver a llamar."
    "Vous attendez une minute devant la porte avant de frapper à nouveau."

# game/scripts/c22/c22.rpy:1869
translate french c22s003_AmaCalls_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c22/c22.rpy:1870
translate french c22s003_AmaCalls_7bb8904d:

    # "No hay respuesta."
    "Il n'y a pas de réponse."

# game/scripts/c22/c22.rpy:1872
translate french c22s003_AmaCalls_dd0461ef_2:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c22/c22.rpy:1873
translate french c22s003_AmaCalls_003de099:

    # eva "*A través de la puerta* ¡Vete, [ama]!"
    eva "*À travers la porte* Va-t'en, [ama] !"

# game/scripts/c22/c22.rpy:1874
translate french c22s003_AmaCalls_e2696b73:

    # mc "*Cambiando la voz* Traigo una entrega para la Srta. [eva] Gilford."
    mc "*Changement de voix* J'ai une livraison pour Mlle Gilford."

# game/scripts/c22/c22.rpy:1875
translate french c22s003_AmaCalls_357dc4bd:

    # eva "*A través de la puerta* [mc], no estoy de humor para bromas."
    eva "*À travers la porte* [mc], je n'ai pas envie de plaisanter."

# game/scripts/c22/c22.rpy:1876
translate french c22s003_AmaCalls_8c2a994e:

    # mc "*Cambiando la voz* Es un abrazo del Sr. [mc] Marks."
    mc "*Changement de voix* C'est un câlin de M. [mc] Marks."

# game/scripts/c22/c22.rpy:1877
translate french c22s003_AmaCalls_03d54948:

    # "Pasan unos segundos sin que se oiga nada."
    "Quelques secondes s'écoulent sans aucun bruit."

# game/scripts/c22/c22.rpy:1878
translate french c22s003_AmaCalls_163cb1f9:

    # eva "*A través de la puerta* Pasa..."
    eva "*Par la porte* Entrez..."

# game/scripts/c22/c22.rpy:1880
translate french c22s003_AmaCalls_a9487c9a:

    # mc "¿Cómo estás?"
    mc "Comment vas-tu?"

# game/scripts/c22/c22.rpy:1881
translate french c22s003_AmaCalls_95e2709c:

    # eva "Queriendo estar sola, pero no me dejáis."
    eva "Je veux être seul, mais tu ne me le permets pas."

# game/scripts/c22/c22.rpy:1882
translate french c22s003_AmaCalls_c200bccf:

    # mc "¿Quieres ese abrazo?"
    mc "Tu veux ce câlin ?"

# game/scripts/c22/c22.rpy:1884
translate french c22s003_AmaCalls_fa05883a:

    # eva "Te he dicho que no estoy de humor para bromas, [mc]."
    eva "Je t'ai dit que je n'étais pas d'humeur à plaisanter, [mc]."

# game/scripts/c22/c22.rpy:1885
translate french c22s003_AmaCalls_3a76a33d:

    # eva "No quiero ponerme borde o maleducada, pero no es el mejor momento."
    eva "Je ne veux pas être impoli, mais ce n'est pas le moment idéal."

# game/scripts/c22/c22.rpy:1886
translate french c22s003_AmaCalls_26e320bf:

    # mc "OK. Te entiendo."
    mc "OK. Je comprends."

# game/scripts/c22/c22.rpy:1887
translate french c22s003_AmaCalls_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Ça vous dérange si je m'assieds ?"

# game/scripts/c22/c22.rpy:1889
translate french c22s003_AmaCalls_1efe5fbb:

    # eva "Lo vas a hacer quiera o no quiera yo, ¿verdad?"
    eva "Tu vas le faire, que ça me plaise ou non, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:1890
translate french c22s003_AmaCalls_494a6419:

    # mc "Sí."
    mc "Ouais."

# game/scripts/c22/c22.rpy:1891
translate french c22s003_AmaCalls_97a257c1:

    # eva "Entonces siéntate."
    eva "Asseyez-vous."

# game/scripts/c22/c22.rpy:1893
translate french c22s003_AmaCalls_13d27f07:

    # "Te sientas en silencio durante un rato, mirándola, contagiándote de su tristeza."
    "Vous restez assis en silence pendant un moment, à la regarder, à percevoir sa tristesse."

# game/scripts/c22/c22.rpy:1894
translate french c22s003_AmaCalls_8ddd4361:

    # "No puedes sentirlo por Gavin más allá de que sea una persona que ha perdido un brazo. Una persona que ahora es tu responsabilidad."
    "Vous ne pouvez éprouver pour Gavin que le constat qu'il a perdu un bras. Un homme qui est désormais sous votre responsabilité."

# game/scripts/c22/c22.rpy:1895
translate french c22s003_AmaCalls_b5ce6cb1:

    # "Entraron en casa de tu familia y os amenazaron. Pusieron en peligro a [nor], [bet] y [mee]."
    "Ils ont fait irruption chez vous et vous ont menacés. Ils ont mis en danger [nor], [bet] et [mee]."

# game/scripts/c22/c22.rpy:1896
translate french c22s003_AmaCalls_478e5cdb:

    # "Ahora conoces su historia a través de las historias de [eva] y [ama]. Notas algo de empatía hacia él creciendo en ti."
    "Vous connaissez maintenant son histoire à travers les récits de [eva] et [ama]. Vous remarquez qu'une certaine empathie à son égard grandit en vous."

# game/scripts/c22/c22.rpy:1897
translate french c22s003_AmaCalls_733dfc17:

    # "Pero lo que te está rompiendo el alma es ver a [eva]."
    "Mais ce qui vous brise le cœur, c'est de voir [eva]."

# game/scripts/c22/c22.rpy:1898
translate french c22s003_AmaCalls_485bae61:

    # "Ver cómo juega con Fee mientras las lágrimas están a punto de asomar a sus ojos."
    "Le voir jouer avec Fee alors que les larmes sont sur le point de lui monter aux yeux."

# game/scripts/c22/c22.rpy:1899
translate french c22s003_AmaCalls_d38b993d:

    # "Decides levantarte."
    "Vous décidez de vous lever."

# game/scripts/c22/c22.rpy:1901
translate french c22s003_AmaCalls_355187ae:

    # eva "¿Ya te vas?"
    eva "Tu pars déjà ?"

# game/scripts/c22/c22.rpy:1903
translate french c22s003_AmaCalls_ed54cc7a:

    # mc "No, no te vas a librar tan rápido de mí."
    mc "Non, vous n'allez pas vous débarrasser de moi aussi rapidement."

# game/scripts/c22/c22.rpy:1906
translate french c22s003_AmaCalls_cda63e2d:

    # mc "El abrazo que traía estaba a punto de caducar."
    mc "L'étreinte que j'avais apportée était sur le point de s'estomper."

# game/scripts/c22/c22.rpy:1908
translate french c22s003_AmaCalls_c25fedb0:

    # eva "Gracias..."
    eva "Merci..."

# game/scripts/c22/c22.rpy:1909
translate french c22s003_AmaCalls_4559c981:

    # "Os pasáis un rato abrazados en silencio antes de que [eva] diga algo."
    "Vous passez un moment à vous enlacer en silence avant que [eva] ne dise quoi que ce soit."

# game/scripts/c22/c22.rpy:1911
translate french c22s003_AmaCalls_742528ea:

    # eva "No te vas a ir hasta que hable contigo de lo que me pasa, ¿verdad?"
    eva "Tu ne vas pas partir avant que je t'aie expliqué ce qui ne va pas, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:1912
translate french c22s003_AmaCalls_bfbddfc6:

    # mc "Yo solo estoy disfrutando del abrazo. Si quieres hablar de ello, habla. Si no quieres, podemos seguir en silencio."
    mc "Je profite simplement de ce câlin. Si tu veux en parler, vas-y. Sinon, on peut continuer en silence."

# game/scripts/c22/c22.rpy:1913
translate french c22s003_AmaCalls_f60662ab:

    # mc "No me voy a ir a ninguna parte. Ni ahora ni nunca."
    mc "Je ne vais nulle part. Ni maintenant, ni jamais."

# game/scripts/c22/c22.rpy:1915
translate french c22s003_AmaCalls_bb5ca692:

    # eva "Es que no lo vas a entender..."
    eva "Vous ne comprendrez tout simplement pas..."

# game/scripts/c22/c22.rpy:1916
translate french c22s003_AmaCalls_3eeb4099:

    # mc "Dame una oportunidad. No soy tan tonto como parezco."
    mc "Donnez-moi une chance. Je ne suis pas aussi bête que j'en ai l'air."

# game/scripts/c22/c22.rpy:1917
translate french c22s003_AmaCalls_c9516075:

    # mc "Al menos a veces..."
    mc "Au moins parfois..."

# game/scripts/c22/c22.rpy:1919
translate french c22s003_AmaCalls_641085b4:

    # eva "*Risa triste* Sólo a veces..."
    eva "*Rire triste* Seulement parfois..."

# game/scripts/c22/c22.rpy:1920
translate french c22s003_AmaCalls_e634a4df:

    # mc "Bueno, alguna que otra vez. Ahora he sido tan listo como para conseguir entrar en tu fortaleza. *Risa*"
    mc "Eh bien, de temps en temps. Maintenant, j'ai été assez malin pour pénétrer dans votre forteresse. *Rires*"

# game/scripts/c22/c22.rpy:1922
translate french c22s003_AmaCalls_c73f839f:

    # eva "En más de un sentido..."
    eva "À plus d'un titre..."

# game/scripts/c22/c22.rpy:1923
translate french c22s003_AmaCalls_628758e0:

    # eva "No sé qué tienes, pero haces que la gente se sienta cómoda hablando."
    eva "Je ne sais pas ce que vous avez de si spécial, mais vous mettez les gens à l'aise pour parler."

# game/scripts/c22/c22.rpy:1924
translate french c22s003_AmaCalls_92a69b0a:

    # mc "Será mi don de gentes. A veces puedo ser encantador."
    mc "Ce doit être mon sens du relationnel. Parfois, je peux être charmant."

# game/scripts/c22/c22.rpy:1926
translate french c22s003_AmaCalls_e112eb74:

    # eva "Gavin ha perdido el brazo, aunque supongo que [ama] ya te lo ha contado."
    eva "Gavin a perdu son bras, bien que je suppose que [ama] vous l'ait déjà dit."

# game/scripts/c22/c22.rpy:1927
translate french c22s003_AmaCalls_36f66786:

    # mc "Sí, me lo ha contado."
    mc "Oui, il me l'a dit."

# game/scripts/c22/c22.rpy:1929
translate french c22s003_AmaCalls_d5ee0b2a:

    # eva "Si hubiera apuntado un par de centímetros a la derecha no hubiera pasado."
    eva "Si j'avais visé quelques centimètres à droite, je n'aurais pas réussi."

# game/scripts/c22/c22.rpy:1930
translate french c22s003_AmaCalls_e4a5b722:

    # mc "Y si no hubieras disparado, te hubiera disparado él."
    mc "Et si vous n'aviez pas tiré, il vous aurait tiré dessus."

# game/scripts/c22/c22.rpy:1932
translate french c22s003_AmaCalls_c4752d40:

    # eva "Gavin tenía la puntería de un stormtrooper. Nunca conseguí que mejorara."
    eva "Gavin avait la précision d'un stormtrooper. Je n'ai jamais réussi à lui faire progresser."

# game/scripts/c22/c22.rpy:1933
translate french c22s003_AmaCalls_a438d52d:

    # eva "Sin embargo, era bueno en el cuerpo a cuerpo."
    eva "Cependant, il était doué pour le combat au corps à corps."

# game/scripts/c22/c22.rpy:1934
translate french c22s003_AmaCalls_1ac56caf:

    # mc "¿Lo conocías mucho? Me refiero aparte del entrenamiento."
    mc "Le connaissiez-vous bien ? Je veux dire, en dehors du cadre de l'entraînement."

# game/scripts/c22/c22.rpy:1936
translate french c22s003_AmaCalls_a99858d6:

    # eva "Imagínate convivir con 500 personas las 24 horas del día durante 19 años. Cuando no estábamos en misiones, claro."
    eva "Imaginez vivre avec 500 personnes 24 heures sur 24 pendant 19 ans. Quand nous n'étions pas en mission, bien sûr."

# game/scripts/c22/c22.rpy:1937
translate french c22s003_AmaCalls_1f00698f:

    # eva "Doce o trece años en el caso de los G. Sí, nos conocíamos. No, no éramos amigos, pero nos llevábamos bien."
    eva "Douze ou treize ans pour les G. Oui, on se connaissait. Non, on n'était pas amis, mais on s'entendait bien."

# game/scripts/c22/c22.rpy:1938
translate french c22s003_AmaCalls_ccb3b460:

    # mc "Entiendo..."
    mc "Je comprends..."

# game/scripts/c22/c22.rpy:1940
translate french c22s003_AmaCalls_1aa524a0:

    # eva "No, [mc]. No lo puedes entender. Tenía mis órdenes y las cumplí. Y alguien salió herido en el proceso. Irreversiblemente."
    eva "Non, [mc]. Tu ne peux pas comprendre. J'ai reçu des ordres et je les ai exécutés. Et quelqu'un a été blessé. Irréversiblement."

# game/scripts/c22/c22.rpy:1941
translate french c22s003_AmaCalls_ebbc4e6f:

    # eva "Pero conocía a ese alguien."
    eva "Mais je connaissais cette personne."

# game/scripts/c22/c22.rpy:1942
translate french c22s003_AmaCalls_f3bec387:

    # eva "He matado a gente, [mc]. Soy una puta asesina. Pero nunca había hecho daño a alguien a quien conociera."
    eva "J'ai tué des gens, [mc]. Je suis un putain de meurtrier. Mais je n'ai jamais fait de mal à personne que je connaissais."

# game/scripts/c22/c22.rpy:1943
translate french c22s003_AmaCalls_c8af1e5d:

    # eva "O a alguien que no se lo mereciera."
    eva "Ou à quelqu'un qui ne le méritait pas."

# game/scripts/c22/c22.rpy:1944
translate french c22s003_AmaCalls_775b3eb4:

    # mc "¿Nunca?"
    mc "Jamais?"

# game/scripts/c22/c22.rpy:1946
translate french c22s003_AmaCalls_41fe9448:

    # eva "No así, al menos."
    eva "Pas comme ça, en tout cas."

# game/scripts/c22/c22.rpy:1947
translate french c22s003_AmaCalls_bff6921b:

    # eva "Tu primer domingo aquí, evité que otro serie G os matara, en el bosque."
    eva "Le premier dimanche que j'ai passé ici, j'ai empêché un autre type de la série G de te tuer, dans la forêt."

# game/scripts/c22/c22.rpy:1948
translate french c22s003_AmaCalls_316ec7e7:

    # mc "¿Cuando estaba con [eil]?"
    mc "Quand étais-je avec [eil] ?"

# game/scripts/c22/c22.rpy:1950
translate french c22s003_AmaCalls_490e543a:

    # eva "No, mientras vosotros comíais en casa. En el bosque estábamos él y yo. Él tenía un rifle de francotirador."
    eva "Non, pendant que tu mangeais à la maison. Il n'y avait que lui et moi dans les bois. Il avait un fusil de précision."

# game/scripts/c22/c22.rpy:1951
translate french c22s003_AmaCalls_9c3c9f68:

    # eva "Sólo necesité un disparo de advertencia para que Gustav bajara el arma y pudiera apresarlo y traerlo a la base."
    eva "Un seul coup de semonce a suffi pour que Gustav baisse son arme, ce qui m'a permis de l'arrêter et de le ramener à la base."

# game/scripts/c22/c22.rpy:1952
translate french c22s003_AmaCalls_1cd0c3fa:

    # eva "Aparte de un ataque de nervios, no recibió más daños."
    eva "Hormis une dépression nerveuse, elle n'a subi aucun autre dommage."

# game/scripts/c22/c22.rpy:1953
translate french c22s003_AmaCalls_a1555d01:

    # mc "No sé cómo darte las gracias por eso..."
    mc "Je ne sais pas comment vous remercier pour cela..."

# game/scripts/c22/c22.rpy:1955
translate french c22s003_AmaCalls_6e623447:

    # eva "No hace falta que me las des. Eran mis órdenes. No lo hacía por ti, ni por la familia."
    eva "Vous n'avez pas besoin de me les donner. C'étaient mes ordres. Je ne le faisais ni pour vous, ni pour la famille."

# game/scripts/c22/c22.rpy:1956
translate french c22s003_AmaCalls_ef009b77:

    # eva "No erais nuestra familia aún. Ni siquiera lo erais el día del secuestro."
    eva "Tu n'étais pas encore de notre famille. Tu n'en faisais même pas partie le jour de l'enlèvement."

# game/scripts/c22/c22.rpy:1957
translate french c22s003_AmaCalls_9d40879e:

    # mc "Lo sé..."
    mc "Je sais..."

# game/scripts/c22/c22.rpy:1959
translate french c22s003_AmaCalls_44489a93:

    # eva "Nunca he estado en las circunstancias en las que estuvieron Beatrice, Claire, o Diana."
    eva "Je n'ai jamais été dans les mêmes circonstances que Béatrice, Claire ou Diana."

# game/scripts/c22/c22.rpy:1960
translate french c22s003_AmaCalls_3cda6ecc:

    # eva "Nunca tuve que luchar por mi vida contra nuestra gente."
    eva "Je n'ai jamais eu à me battre pour ma vie contre notre peuple."

# game/scripts/c22/c22.rpy:1961
translate french c22s003_AmaCalls_c8563811:

    # eva "Y la primera vez que lo hago, alguien sale herido."
    eva "Et la première fois que je le fais, quelqu'un se blesse."

# game/scripts/c22/c22.rpy:1962
translate french c22s003_AmaCalls_93eff6a9:

    # mc "Ellos querían hacernos daño, [eva]."
    mc "Ils voulaient nous faire du mal, [eva]."

# game/scripts/c22/c22.rpy:1964
translate french c22s003_AmaCalls_1aa74c76:

    # eva "Lo sé. Y Eric nos hubiese matado si hubiera tenido la oportunidad, como hicieron con mis hermanas."
    eva "Je sais. Et Eric nous aurait tués s'il en avait eu l'occasion, comme ils l'ont fait à mes sœurs."

# game/scripts/c22/c22.rpy:1965
translate french c22s003_AmaCalls_b625d932:

    # eva "Pero Gavin no. Gavin estaba ahí cumpliendo órdenes. Igual que yo. Y no se merecía acabar así..."
    eva "Mais pas Gavin. Gavin était là pour obéir aux ordres. Tout comme moi. Et il ne méritait pas de finir comme ça…"

# game/scripts/c22/c22.rpy:1966
translate french c22s003_AmaCalls_61e87c1d:

    # mc "No quiero sonar insensible, pero prefiero que sea él quien haya acabado así en vez de ser tú."
    mc "Je ne veux pas paraître insensible, mais j'aurais préféré que ce soit lui qui finisse comme ça plutôt que toi."

# game/scripts/c22/c22.rpy:1968
translate french c22s003_AmaCalls_7b8f7b14:

    # eva "Gracias. Yo... Gracias..."
    eva "Merci. Je... Merci..."

# game/scripts/c22/c22.rpy:1970
translate french c22s003_AmaCalls_26d2f151:

    # eva "No te puedes imaginar lo complicado que es todo en mi cabeza."
    eva "Vous ne pouvez pas imaginer à quel point tout est compliqué dans ma tête."

# game/scripts/c22/c22.rpy:1971
translate french c22s003_AmaCalls_9468925e:

    # eva "He herido a una persona a la que aprecio por salvar a una familia a la que quiero."
    eva "J'ai blessé une personne qui m'est chère afin de sauver une famille que j'aime."

# game/scripts/c22/c22.rpy:1972
translate french c22s003_AmaCalls_6a058b62:

    # eva "No sé qué le voy a decir la próxima vez que le vea..."
    eva "Je ne sais pas ce que je vais lui dire la prochaine fois que je le verrai..."

# game/scripts/c22/c22.rpy:1973
translate french c22s003_AmaCalls_e2c467b9:

    # mc "Los dos cumplíais órdenes, y tú estabas en el bando ganador."
    mc "Vous obéissiez tous les deux aux ordres, et vous étiez du côté des vainqueurs."

# game/scripts/c22/c22.rpy:1974
translate french c22s003_AmaCalls_b201a47a:

    # mc "Tú hiciste que ese bando ganara."
    mc "Vous avez permis à cette équipe de gagner."

# game/scripts/c22/c22.rpy:1976
translate french c22s003_AmaCalls_7f51842a:

    # eva "Pero no se tenía que haber llegado a esto. Ha muerto gente en esta guerra clon. Mis hermanas."
    eva "Mais on n'aurait pas dû en arriver là. Des gens sont morts dans cette guerre des clones. Mes sœurs."

# game/scripts/c22/c22.rpy:1977
translate french c22s003_AmaCalls_5ef9f1ea:

    # eva "Gavin ha perdido el brazo..."
    eva "Gavin a perdu son bras..."

# game/scripts/c22/c22.rpy:1978
translate french c22s003_AmaCalls_865d5e8f:

    # mc "Y Eric los dientes..."
    mc "Et les dents d'Eric..."

# game/scripts/c22/c22.rpy:1980
translate french c22s003_AmaCalls_50c59d76:

    # eva "Eric es quien menos me importa. Los E tenían una vena cruel."
    eva "Eric est celui que j'apprécie le moins. Les E avaient un côté cruel."

# game/scripts/c22/c22.rpy:1981
translate french c22s003_AmaCalls_73caf2a5:

    # mc "¿Clonamos dientes en NTR? *Risa*"
    mc "Est-ce qu'on clone les dents chez NTR ? *Rires*"

# game/scripts/c22/c22.rpy:1983
translate french c22s003_AmaCalls_edbc953c:

    # eva "*Risa triste* No, y tampoco brazos."
    eva "*Rire triste* Non, et les bras non plus."

# game/scripts/c22/c22.rpy:1984
translate french c22s003_AmaCalls_f8af6c01:

    # eva "¿Qué va a hacer ahora?"
    eva "Que va-t-il faire maintenant ?"

# game/scripts/c22/c22.rpy:1985
translate french c22s003_AmaCalls_0dae425a:

    # mc "Supongo que le podemos buscar un puesto donde siga siendo útil con un solo brazo y donde se sienta a gusto."
    mc "Je suppose que nous pouvons lui trouver un poste où il pourra encore être utile avec un seul bras et où il se sentira à l'aise."

# game/scripts/c22/c22.rpy:1986
translate french c22s003_AmaCalls_283db93c:

    # mc "Ahora soy su jefe y una de las cosas que debe hacer un jefe es conseguir sacar el mejor partido de sus empleados."
    mc "Maintenant, je suis votre patron et l'une des choses qu'un patron doit faire, c'est tirer le meilleur parti de ses employés."

# game/scripts/c22/c22.rpy:1988
translate french c22s003_AmaCalls_19b090fc:

    # eva "No sé qué podría hacer con un solo brazo, la verdad..."
    eva "Honnêtement, je ne sais pas ce que je pourrais faire avec un seul bras..."

# game/scripts/c22/c22.rpy:1989
translate french c22s003_AmaCalls_f1281ea7:

    # eva "No sé qué podría hacer yo si sólo tuviera un brazo."
    eva "Je ne sais pas ce que je pourrais faire si je n'avais qu'un seul bras."

# game/scripts/c22/c22.rpy:1990
translate french c22s003_AmaCalls_4f0f86a0:

    # mc "Seguramente patearías culos con un solo brazo, pero ¿sabes una cosa?"
    mc "Tu pourrais probablement être redoutable avec un seul bras, mais tu sais quoi ?"

# game/scripts/c22/c22.rpy:2011
translate french c22s004_EveRoute_2be0c5eb:

    # eva "¿Qué? ¿Pareja? ¿Como si fuera tu novia?"
    eva "Quoi ? Une partenaire ? Genre, ta copine ?"

# game/scripts/c22/c22.rpy:2012
translate french c22s004_EveRoute_0d9c3d27:

    # mcp "(¡Por Dios! ¡Cómo odio esa palabra!)"
    mcp "(Mon Dieu ! Que je déteste ce mot !)"

# game/scripts/c22/c22.rpy:2013
translate french c22s004_EveRoute_61ca86f1:

    # mc "Sí, he dicho pareja. Como si fueras novia. ¿Demasiados disparos están afectando a tu audición?"
    mc "Oui, j'ai bien dit partenaire. Comme si tu étais ma copine. Est-ce que les coups de feu ont trop affecté ton audition ?"

# game/scripts/c22/c22.rpy:2015
translate french c22s004_EveRoute_8e994c1b:

    # "[eva] salta como impulsada por un muelle."
    "[eva] saute comme s'il était propulsé par un ressort."

# game/scripts/c22/c22.rpy:2016
translate french c22s004_EveRoute_351f6459:

    # eva "¿Me estás tomando el pelo?"
    eva "Vous plaisantez j'espère?"

# game/scripts/c22/c22.rpy:2017
translate french c22s004_EveRoute_fca52711:

    # mc "No."
    mc "Non."

# game/scripts/c22/c22.rpy:2019
translate french c22s004_EveRoute_b4a622fd:

    # eva "¿Lo estás haciendo porque te doy pena?"
    eva "Tu fais ça parce que tu as pitié de moi ?"

# game/scripts/c22/c22.rpy:2020
translate french c22s004_EveRoute_fca52711_1:

    # mc "No."
    mc "Non."

# game/scripts/c22/c22.rpy:2022
translate french c22s004_EveRoute_226cf3ff:

    # eva "¿Entonces por qué? ¿Por qué ahora?"
    eva "Alors pourquoi ? Pourquoi maintenant ?"

# game/scripts/c22/c22.rpy:2023
translate french c22s004_EveRoute_00da5eaf:

    # mc "Porque me gustas desde que te conocí... más o menos."
    mc "Parce que je t'apprécie depuis que je t'ai rencontré... plus ou moins."

# game/scripts/c22/c22.rpy:2024
translate french c22s004_EveRoute_83dd1981:

    # mc "Y porque ahora [ama] y tú habéis arreglado vuestras diferencias."
    mc "Et parce que maintenant [ama] et vous avez réglé vos différends."

# game/scripts/c22/c22.rpy:2025
translate french c22s004_EveRoute_01dfadaf:

    # mc "¿No puedes aceptar una buena noticia cuando la escuchas? O lo que para ti es una buena noticia..."
    mc "Avez-vous du mal à accepter les bonnes nouvelles quand vous les entendez ? Ou qu'est-ce qui, pour vous, constitue une bonne nouvelle…"

# game/scripts/c22/c22.rpy:2027
translate french c22s004_EveRoute_125ce26d:

    # eva "¿Y [ama]?"
    eva "Et [ama] ?"

# game/scripts/c22/c22.rpy:2028
translate french c22s004_EveRoute_e8df90f5:

    # mc "[ama] no tiene nada que ver con lo que hagamos tú y yo."
    mc "[ama] n'a rien à voir avec ce que vous et moi faisons."

# game/scripts/c22/c22.rpy:2029
translate french c22s004_EveRoute_3b2521e3:

    # eva "¿Crees que se va a enfadar porque me hayas elegido a mí antes que a ella? También vas a querer salir con ella, ¿verdad?"
    eva "Tu crois qu'elle sera fâchée que tu m'aies choisi moi plutôt qu'elle ? Tu voudras aussi sortir avec elle, non ?"

# game/scripts/c22/c22.rpy:2030
translate french c22s004_EveRoute_f150a240:

    # mcp "(No le ha dicho lo que pasó ayer en el café.)"
    mcp "(Elle ne lui a pas dit ce qui s'est passé hier au café.)"

# game/scripts/c22/c22.rpy:2031
translate french c22s004_EveRoute_2833b24b:

    # mc "No, no creo que se enfade."
    mc "Non, je ne pense pas qu'il sera en colère."

# game/scripts/c22/c22.rpy:2032
translate french c22s004_EveRoute_00c1bef0:

    # mc "Y no te tienes que preocupar por si salgo con ella o no. No sois un pack indivisible como los yogures."
    mc "Et tu n'as pas à t'inquiéter de savoir si je sors avec elle ou non. Vous n'êtes pas inséparables comme un yaourt."

# game/scripts/c22/c22.rpy:2034
translate french c22s004_EveRoute_c7fac3f2:

    # eva "Pero..."
    eva "Mais..."

# game/scripts/c22/c22.rpy:2035
translate french c22s004_EveRoute_215caa51:

    # mc "Yo esperaba un beso en vez de un interrogatorio."
    mc "Je m'attendais à un baiser, pas à un interrogatoire."

# game/scripts/c22/c22.rpy:2037
translate french c22s004_EveRoute_cafec592:

    # "La asesina pelirroja se lanza hacia ti, tumbándote en el arcón, y empieza a recorrer tus labios con ansia."
    "L'assassine aux cheveux roux se jette sur vous, vous faisant tomber sur la poitrine, et commence à tracer avidement vos lèvres du bout des doigts."

# game/scripts/c22/c22.rpy:2038
translate french c22s004_EveRoute_161d4452:

    # "Y mucha más torpeza de la que hubieras esperado."
    "Et beaucoup plus de maladresse que vous ne l'auriez imaginé."

# game/scripts/c22/c22.rpy:2040
translate french c22s004_EveRoute_34f26697:

    # eva "¿Contento?"
    eva "Content?"

# game/scripts/c22/c22.rpy:2041
translate french c22s004_EveRoute_a0adf509:

    # mc "Sí. ¿Y tú?"
    mc "Oui et vous?"

# game/scripts/c22/c22.rpy:2043
translate french c22s004_EveRoute_6fff242d:

    # eva "Ermmm... Sí..."
    eva "Euh... Oui..."

# game/scripts/c22/c22.rpy:2044
translate french c22s004_EveRoute_00731f2d:

    # mc "No creo que estés muy convencida."
    mc "Je ne pense pas que vous soyez très convaincu."

# game/scripts/c22/c22.rpy:2046
translate french c22s004_EveRoute_6b8aa6b2:

    # eva "Me siento rara... hace unos minutos tenía ganas de llorar."
    eva "Je me sens bizarre… il y a quelques minutes, j’avais envie de pleurer."

# game/scripts/c22/c22.rpy:2047
translate french c22s004_EveRoute_37b4782c:

    # eva "Ahora tengo ganas de reír. Y de llorar a la vez..."
    eva "J'ai envie de rire. Et de pleurer en même temps..."

# game/scripts/c22/c22.rpy:2048
translate french c22s004_EveRoute_39b5f54e:

    # mc "Supongo que estás en medio de una montaña rusa emocional."
    mc "J'imagine que vous traversez une période émotionnellement très intense."

# game/scripts/c22/c22.rpy:2050
translate french c22s004_EveRoute_a9be9b21:

    # eva "Supongo... No sé cómo actuar ahora..."
    eva "Je crois... que je ne sais plus comment réagir..."

# game/scripts/c22/c22.rpy:2051
translate french c22s004_EveRoute_155a73b6:

    # mc "¿Qué tal un largo abrazo? No hace falta que digas nada si no quieres."
    mc "Et un long câlin ? Tu n'es pas obligé(e) de dire quoi que ce soit si tu n'en as pas envie."

# game/scripts/c22/c22.rpy:2053
translate french c22s004_EveRoute_59a046a5:

    # eva "Creo que me puedo conformar con eso."
    eva "Je crois que ça me convient."

# game/scripts/c22/c22.rpy:2054
translate french c22s004_EveRoute_45a53858:

    # mc "*Risa* No sé si sentirme como que mis abrazos son un premio menor."
    mc "*Rires* Je ne sais pas si je devrais considérer mes câlins comme une récompense mineure."

# game/scripts/c22/c22.rpy:2056
translate french c22s004_EveRoute_f3211d1f:

    # eva "No te rías de mí. Lo que sí sé es que quiero tener una cita contigo."
    eva "Ne te moque pas de moi. Ce que je sais, c'est que j'ai envie de sortir avec toi."

# game/scripts/c22/c22.rpy:2057
translate french c22s004_EveRoute_e2f99f94:

    # mc "¿Quieres que busque un sitio bonito?"
    mc "Voulez-vous que je vous trouve un endroit agréable ?"

# game/scripts/c22/c22.rpy:2059
translate french c22s004_EveRoute_c7e6be72:

    # eva "No. Quiero planear la cita yo."
    eva "Non. Je veux organiser la date moi-même."

# game/scripts/c22/c22.rpy:2060
translate french c22s004_EveRoute_f84ba5ae:

    # eva "Estoy segura de que has tenido mil citas y no quiero que sea como ninguna que hayas tenido con anterioridad."
    eva "Je suis sûre que tu as déjà eu des milliers de rendez-vous, et je ne veux pas que celui-ci ressemble à tous ceux que tu as eus auparavant."

# game/scripts/c22/c22.rpy:2061
translate french c22s004_EveRoute_2d00f394:

    # mc "Me parece bien. Sorpréndeme."
    mc "Ça me convient. Surprenez-moi."

# game/scripts/c22/c22.rpy:2063
translate french c22s004_EveRoute_7894efb0:

    # eva "¡Mierda!"
    eva "Merde!"

# game/scripts/c22/c22.rpy:2064
translate french c22s004_EveRoute_788fe75f:

    # mc "¿Qué pasa, cielo?"
    mc "Qu'est-ce qui ne va pas, chérie ?"

# game/scripts/c22/c22.rpy:2066
translate french c22s004_EveRoute_0c0618a7:

    # eva "Se lo tengo que contar a [ama]. Ahora."
    eva "Je dois le dire à [ama]. Maintenant."

# game/scripts/c22/c22.rpy:2067
translate french c22s004_EveRoute_3ed89801:

    # eva "Levántate. Vamos a decírselo. No quiero que piense que se lo estamos ocultando."
    eva "Lève-toi. Dis-le-lui. Je ne veux pas qu'il pense qu'on le lui cache."

# game/scripts/c22/c22.rpy:2068
translate french c22s004_EveRoute_48688e12:

    # mc "*Risa* Lo de estar quieta disfrutando del abrazo no se te da muy bien. Vamos."
    mc "*Rires* Tu n'es pas très douée pour rester immobile et apprécier un câlin. Allez !"

# game/scripts/c22/c22.rpy:2070
translate french c22s004_EveRoute_f9704243:

    # eva "[ama], tenemos algo que decirte."
    eva "[ama], nous avons quelque chose à vous dire."

# game/scripts/c22/c22.rpy:2072
translate french c22s004_EveRoute_6cdbd57d:

    # ama "¿Te encuentras mejor?"
    ama "Vous vous sentez mieux ?"

# game/scripts/c22/c22.rpy:2074
translate french c22s004_EveRoute_db54e694:

    # eva "Mas o menos. Todavía me siento mal por Gavin..."
    eva "Plus ou moins. Je plains toujours Gavin..."

# game/scripts/c22/c22.rpy:2075
translate french c22s004_EveRoute_b33399f4:

    # eva "Pero... queríamos decirte que..."
    eva "Mais... nous voulions vous dire que..."

# game/scripts/c22/c22.rpy:2077
translate french c22s004_EveRoute_ac83c3e7:

    # eva "Ayúdame, [mc]..."
    eva "Aidez-moi, [mc]..."

# game/scripts/c22/c22.rpy:2078
translate french c22s004_EveRoute_fd12ea1d:

    # mc "Nope. Esto es algo que tienes que hacer tú."
    mc "Non. C'est quelque chose que vous devez faire vous-même."

# game/scripts/c22/c22.rpy:2080
translate french c22s004_EveRoute_a40c1f78:

    # eva "*Grrr* ¡Capullo!"
    eva "*Grrr* Espèce d'idiot !"

# game/scripts/c22/c22.rpy:2081
translate french c22s004_EveRoute_eef46fb8:

    # eva "¡Vale!"
    eva "D'accord!"

# game/scripts/c22/c22.rpy:2083
translate french c22s004_EveRoute_98f390cb:

    # eva "¡[mc] y yo estamos saliendo juntos! Aunque no sé por qué salgo con capullos."
    eva "[mc] et moi, on sort ensemble ! Même si je ne sais pas pourquoi je sors avec des crétins."

# game/scripts/c22/c22.rpy:2084
translate french c22s004_EveRoute_c1284afa:

    # eva "¡Vamos a tener una cita!"
    eva "Allons à un rendez-vous !"

# game/scripts/c22/c22.rpy:2086
translate french c22s004_EveRoute_9e8efeb1:

    # eva "Y nos hemos besado..."
    eva "Et nous nous sommes embrassés..."

# game/scripts/c22/c22.rpy:2088
translate french c22s004_EveRoute_bb654dc4:

    # ama "¡Eso es fantástico, [eva]!"
    ama "C'est fantastique, [eva] !"

# game/scripts/c22/c22.rpy:2090
translate french c22s004_EveRoute_90b2909c:

    # ama "Felicidades, [mc]. No podrías salir con nadie mejor."
    ama "Félicitations, [mc]. Tu ne pourrais pas sortir avec quelqu'un de mieux."

# game/scripts/c22/c22.rpy:2092
translate french c22s004_EveRoute_f104a946:

    # eva "Ahora solo falta que se decida contigo."
    eva "Il ne lui reste plus qu'à décider d'être avec toi."

# game/scripts/c22/c22.rpy:2094
translate french c22s004_EveRoute_9d066684:

    # eva "Obviamente, me ha elegido a mi primero, pero me gustaría que también tú pudieras salir con él."
    eva "Évidemment, c'est moi qu'il a choisie en premier, mais j'aimerais que tu puisses sortir avec lui aussi."

# game/scripts/c22/c22.rpy:2096
translate french c22s004_EveRoute_8f8d9b64:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego. *Risa mental*)"
    mcp "(Je ne sais pas ce qu'il manigance, mais il vaut mieux jouer le jeu. *Rires intérieurs*)"

# game/scripts/c22/c22.rpy:2098
translate french c22s004_EveRoute_8ee39ad0:

    # ama "Aunque si [mc] quiere salir conmigo, sabe lo que yo pienso y lo puede decir {b}ahora mismo{/b}."
    ama "Même si [mc] veut sortir avec moi, elle sait ce que je pense et elle peut le dire {b}maintenant{/b}."

# game/scripts/c22/c22.rpy:2099
translate french c22s004_EveRoute_aa92414a:

    # mc "Me encantaría. Estar con las dos sería maravilloso."
    mc "J'adorerais. Être avec eux deux serait merveilleux."

# game/scripts/c22/c22.rpy:2101
translate french c22s004_EveRoute_cb287e39:

    # eva "¡Felicidades, [ama]!"
    eva "Félicitations, [ama] !"

# game/scripts/c22/c22.rpy:2102
translate french c22s004_EveRoute_22901ee7:

    # eva "¡Nuestro primer novio oficial y lo compartimos!"
    eva "Notre premier petit ami officiel et on le partage !"

# game/scripts/c22/c22.rpy:2103
translate french c22s004_EveRoute_7d0ef333:

    # mc "¿Qué es eso del primer novio oficial?"
    mc "De quoi s'agit-il avec cette histoire de premier petit ami officiel ?"

# game/scripts/c22/c22.rpy:2105
translate french c22s004_EveRoute_7af743dd:

    # eva "En una misión en Budapest tuvimos que fingir que salíamos con dos operativos de la serie F."
    eva "Lors d'une mission à Budapest, nous avons dû faire semblant de sortir avec deux agents de la série F."

# game/scripts/c22/c22.rpy:2106
translate french c22s004_EveRoute_6cd56b27:

    # ama "Ellos se hacían pasar por gemelos ricos y nosotras por sus novias."
    ama "Ils ont fait semblant d'être des jumeaux riches et nous avons fait semblant d'être leurs copines."

# game/scripts/c22/c22.rpy:2108
translate french c22s004_EveRoute_b68d22d1:

    # eva "¡Pero nunca pasó nada entre nosotros!"
    eva "Mais il ne s'est jamais rien passé entre nous !"

# game/scripts/c22/c22.rpy:2109
translate french c22s004_EveRoute_aa885f6b:

    # ama "Más allá de algún beso fingido."
    ama "Au-delà de quelques faux baisers."

# game/scripts/c22/c22.rpy:2111
translate french c22s004_EveRoute_4edb2e23:

    # eva "¡Oops! ¡Te he abrazado y no te he dejado besar a tu novio!"
    eva "Oups ! Je t'ai serrée dans mes bras et je ne t'ai pas laissé embrasser ton petit ami !"

# game/scripts/c22/c22.rpy:2112
translate french c22s004_EveRoute_f1d23f62:

    # mcp "(Cada vez odio más la palabra. Pero en esto es como una niña, y necesita poner etiquetas.)"
    mcp "(Je déteste de plus en plus ce mot. Mais là, elle se comporte comme une enfant et elle a besoin de tout étiqueter.)"

# game/scripts/c22/c22.rpy:2114
translate french c22s004_EveRoute_648e3dbd:

    # ama "¿Puedo?"
    ama "Peut?"

# game/scripts/c22/c22.rpy:2115
translate french c22s004_EveRoute_15025985:

    # eva "¡Di que sí!"
    eva "Dites oui !"

# game/scripts/c22/c22.rpy:2116
translate french c22s004_EveRoute_a3a04cea:

    # ama "*Susurrando* Me da un poco de vergüenza delante de [eva]."
    ama "*Chuchotant* Je me sens un peu gênée devant [eva]."

# game/scripts/c22/c22.rpy:2117
translate french c22s004_EveRoute_6e49d741:

    # mc "Sólo hay una forma de superar la vergüenza, preciosa."
    mc "Il n'y a qu'une seule façon de surmonter la honte, ma chérie."

# game/scripts/c22/c22.rpy:2119
translate french c22s004_EveRoute_069ebbec:

    # "Sin dejarle responder, tu boca se acerca a la suya y le das un tierno beso."
    "Sans lui laisser le temps de répondre, votre bouche se rapproche de la sienne et vous lui donnez un tendre baiser."

# game/scripts/c22/c22.rpy:2120
translate french c22s004_EveRoute_63fd7115:

    # "Ella responde de forma mucho menos apasionada que el día anterior en el café."
    "Sa réponse est beaucoup moins passionnée que la veille au café."

# game/scripts/c22/c22.rpy:2121
translate french c22s004_EveRoute_bede44a2:

    # "La vergüenza es una barrera que le cuesta superar."
    "La honte est un obstacle qu'elle a du mal à surmonter."

# game/scripts/c22/c22.rpy:2123
translate french c22s004_EveRoute_57cd6c62:

    # mc "¿Bien?"
    mc "Bien?"

# game/scripts/c22/c22.rpy:2124
translate french c22s004_EveRoute_350a7b0e:

    # ama "Bien."
    ama "Bien."

# game/scripts/c22/c22.rpy:2126
translate french c22s004_EveRoute_cdfd0960:

    # eva "¿Bien? ¡Ha sido precioso!"
    eva "Bien ? C'était merveilleux !"

# game/scripts/c22/c22.rpy:2159
translate french c22s004_EveRoute_2a8de6b7:

    # eva "¡Ha sido como cuando besa a las otras chicas!"
    eva "C'était exactement comme lorsqu'il embrasse les autres filles !"

# game/scripts/c22/c22.rpy:2162
translate french c22s004_EveRoute_0ae1c79d:

    # eva "Ha sido como cuando besa a [gf]."
    eva "C'était comme quand il embrasse [gf]."

# game/scripts/c22/c22.rpy:2163
translate french c22s004_EveRoute_29959d60:

    # mc "¿Cómo querías que fuera?"
    mc "Comment vouliez-vous que cela se passe ?"

# game/scripts/c22/c22.rpy:2165
translate french c22s004_EveRoute_e662d2a0:

    # eva "No tengo ni idea... pero presenciar vuestro primer beso me ha hecho sentir especial."
    eva "Je n'en ai aucune idée... mais être témoin de ton premier baiser m'a fait me sentir spéciale."

# game/scripts/c22/c22.rpy:2167
translate french c22s004_EveRoute_acabbfe7:

    # eva "¡Tengo que irme!"
    eva "Je dois y aller!"

# game/scripts/c22/c22.rpy:2168
translate french c22s004_EveRoute_a613997b:

    # mc "¿Dónde?"
    mc "Où?"

# game/scripts/c22/c22.rpy:2169
translate french c22s004_EveRoute_fa3e71ef:

    # eva "¡Tengo que poner un mensaje en el grupo de WhatsUp! ¡Quiero que todas sepan que las dos estamos contigo!"
    eva "Je dois poster un message dans le groupe WhatsApp ! Je veux que tout le monde sache que nous sommes tous les deux avec toi !"

# game/scripts/c22/c22.rpy:2171
translate french c22s004_EveRoute_8cb7a7b1:

    # eva "Y tengo que ducharme. Apesto."
    eva "Et j'ai besoin de prendre une douche. Je pue."

# game/scripts/c22/c22.rpy:2174
translate french c22s004_EveRoute_7980a049:

    # mc "Y se fue."
    mc "Et il est parti."

# game/scripts/c22/c22.rpy:2175
translate french c22s004_EveRoute_7ef1027e:

    # ama "Sí. Gracias por seguirme el juego."
    ama "Oui. Merci d'avoir joué le jeu."

# game/scripts/c22/c22.rpy:2176
translate french c22s004_EveRoute_8b0c6de9:

    # mc "¿A qué venía eso?"
    mc "De quoi s'agissait-il ?"

# game/scripts/c22/c22.rpy:2178
translate french c22s004_EveRoute_f877ba9c:

    # ama "Ayer, cuando llegué, quería contárselo, pero [eva] estaba muy cansada y se fue a dormir en seguida. La tenía que despertar para ir a casa a cenar."
    ama "Hier, en arrivant, j'ai voulu lui annoncer la nouvelle, mais elle était très fatiguée et s'est endormie aussitôt. J'ai dû la réveiller pour rentrer dîner."

# game/scripts/c22/c22.rpy:2179
translate french c22s004_EveRoute_4a174a9a:

    # ama "La despertó la llamada de [aar]. Y se puso como la has visto cuando has llegado."
    ama "Elle a été réveillée par l'appel de [aar]. Et elle était exactement comme vous l'avez vue à votre arrivée."

# game/scripts/c22/c22.rpy:2180
translate french c22s004_EveRoute_3750bc87:

    # mc "Por eso llamaste para decir que no os encontrabais bien, ¿no?"
    mc "C'est pour ça que vous avez appelé pour dire que vous ne vous sentiez pas bien, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2182
translate french c22s004_EveRoute_77c898c5:

    # ama "Exacto. Ella no estaba de humor para socializar, y yo no quería dejarla sola, por muchas ganas que tuviera de volver a verte. De veros a todos."
    ama "Exactement. Elle n'avait pas envie de voir du monde, et je ne voulais pas la laisser seule, même si j'avais très envie de vous revoir. De vous revoir tous."

# game/scripts/c22/c22.rpy:2183
translate french c22s004_EveRoute_bb76bcc2:

    # ama "Después de la llamada, no estaba de humor para nada, menos aún para que se lo contara."
    ama "Après l'appel, elle n'était d'humeur à rien, et encore moins à ce que je lui dise quelque chose."

# game/scripts/c22/c22.rpy:2185
translate french c22s004_EveRoute_acb231af:

    # ama "Ya has visto lo feliz que le ha hecho que la \"eligieras antes que a mí\"."
    ama "Tu as déjà vu à quel point elle était heureuse que tu l'aies « choisie elle plutôt que moi »."

# game/scripts/c22/c22.rpy:2186
translate french c22s004_EveRoute_ae2d444e:

    # mc "Si se lo hubieras dicho, se hubiera sentido más miserable aún, sumado a lo de Gavin."
    mc "Si tu lui avais dit, il se serait senti encore plus malheureux, en plus de ce qui s'est passé avec Gavin."

# game/scripts/c22/c22.rpy:2188
translate french c22s004_EveRoute_0ce98a1f:

    # ama "Exacto. Por eso envié el mensaje individualmente a todas las chicas."
    ama "Exactement. C'est pourquoi j'ai envoyé le message individuellement à chacune des filles."

# game/scripts/c22/c22.rpy:2189
translate french c22s004_EveRoute_2999362c:

    # mc "Hablando del mensaje. Deberías avisar a [emm] de que no le responda diciendo que ya sabía lo tuyo."
    mc "À propos du message, vous devriez avertir [emm] de ne pas répondre en disant qu'il était déjà au courant pour vous."

# game/scripts/c22/c22.rpy:2190
translate french c22s004_EveRoute_4533066c:

    # mc "Si lo lee en el grupo, es capaz de descubrirte."
    mc "S'il le lit en groupe, il pourra te démasquer."

# game/scripts/c22/c22.rpy:2192
translate french c22s004_EveRoute_102790c8:

    # ama "*Risa* No te preocupes."
    ama "*Rires* Ne t'inquiète pas."

# game/scripts/c22/c22.rpy:2193
translate french c22s004_EveRoute_bddecb9f:

    # ama "Llamé a [emm] después de enviar el mensaje y le dije que, hasta que [eva] no dijera algo o yo lo publicara en el grupo, ella no sabía nada."
    ama "J'ai appelé [emm] après avoir envoyé le message et je lui ai dit que tant que [eva] n'aurait rien dit ou que je ne l'aurais pas publié dans le groupe, elle ne saurait rien."

# game/scripts/c22/c22.rpy:2194
translate french c22s004_EveRoute_429b41cd:

    # mc "Me sorprende lo mucho que nos conoces, [ama]."
    mc "Je suis surpris de voir à quel point tu nous connais bien, [ama]."

# game/scripts/c22/c22.rpy:2196
translate french c22s004_EveRoute_55913309:

    # ama "*Risa* Gajes del oficio."
    ama "*Rires* Risques professionnels."

# game/scripts/c22/c22.rpy:2199
translate french c22s004_EveRoute_1c771fe6:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego.)"
    mcp "(Je ne sais pas ce qu'il manigance, mais il vaut mieux jouer le jeu.)"

# game/scripts/c22/c22.rpy:2201
translate french c22s004_EveRoute_1095c513:

    # ama "[mc] y yo decidimos ayer que no vamos a salir juntos de momento."
    ama "[mc] et moi avons décidé hier que nous ne sortirions plus ensemble pour le moment."

# game/scripts/c22/c22.rpy:2202
translate french c22s004_EveRoute_f54fd145:

    # ama "Entre otras cosas, con la preparación del viaje a Aruba y todo lo que hay que hacer, hubiera sido una distracción."
    ama "Entre autres choses, avec la préparation du voyage à Aruba et tout ce qu'il y a à faire, cela aurait constitué une distraction."

# game/scripts/c22/c22.rpy:2203
translate french c22s004_EveRoute_ed5bbd50:

