    eva "Je ne fais pas référence à cela..."

# game/scripts/c22/c22.rpy:2285
translate french c22s004_EveNoRoute_39834124:

    # mc "¿Entonces a qué te refieres?"
    mc "Que voulez-vous dire ?"

# game/scripts/c22/c22.rpy:2287
translate french c22s004_EveNoRoute_0b7bf467:

    # eva "A que te estoy pidiendo explicaciones sobre algo que no tengo ningún derecho a hacer."
    eva "Pourquoi vous demander des explications sur quelque chose que je n'ai pas le droit de faire ?"

# game/scripts/c22/c22.rpy:2288
translate french c22s004_EveNoRoute_e7791b8c:

    # mc "Eso casi suena como [ama]. Pero siempre me podrás pedir explicaciones sobre lo que quieras."
    mc "Ça ressemble presque à [ama]. Mais vous pouvez toujours me demander des explications sur n'importe quel sujet."

# game/scripts/c22/c22.rpy:2291
translate french c22s004_EveNoRoute_5d9b0e4a:

    # eva "Incluso te he propuesto cambiar físicamente. Es algo que no debería hacer."
    eva "Je t'ai même suggéré de changer d'apparence. C'est quelque chose que tu ne devrais pas faire."

# game/scripts/c22/c22.rpy:2292
translate french c22s004_EveNoRoute_894ebe24:

    # eva "Yo soy yo y no tengo que parecerme a nadie."
    eva "Je suis moi-même et je n'ai pas à ressembler à quelqu'un d'autre."

# game/scripts/c22/c22.rpy:2293
translate french c22s004_EveNoRoute_9843b2bc:

    # mc "Voy a repetirlo, [eva]. Eres perfecta como eres, pero yo no soy perfecto para ti."
    mc "Je le répète, [eva]. Tu es parfait(e) tel(le) que tu es, mais je ne suis pas parfait(e) pour toi."

# game/scripts/c22/c22.rpy:2295
translate french c22s004_EveNoRoute_6fa08cef:

    # eva "Y además, me he comportado muy mal con [ama] desde ayer."
    eva "Et en plus, je me suis très mal comporté envers [ama] depuis hier."

# game/scripts/c22/c22.rpy:2296
translate french c22s004_EveNoRoute_f9ef55d9:

    # eva "Ella también conocía a Gavin, aunque no había tenido tanto trato con él como yo. También lo debe estar pasando mal."
    eva "Elle connaissait aussi Gavin, même si elle n'avait pas eu autant de contacts avec lui que moi. Elle doit traverser une période difficile, elle aussi."

# game/scripts/c22/c22.rpy:2297
translate french c22s004_EveNoRoute_65c96ef7:

    # mc "Deberías hablar con ella y disculparte, si crees que lo has hecho mal."
    mc "Tu devrais lui parler et t'excuser si tu penses avoir mal agi."

# game/scripts/c22/c22.rpy:2299
translate french c22s004_EveNoRoute_5e059f15:

    # eva "¿Puedes esperar aquí mientras hablo con ella?"
    eva "Pouvez-vous attendre ici pendant que je lui parle ?"

# game/scripts/c22/c22.rpy:2300
translate french c22s004_EveNoRoute_e6b42cb7:

    # eva "Me gustaría hablar en privado, si no te molesta."
    eva "J'aimerais vous parler en privé, si cela ne vous dérange pas."

# game/scripts/c22/c22.rpy:2301
translate french c22s004_EveNoRoute_97dbc3a2:

    # mc "Ningún problema. Es vuestra conversación y tus disculpas."
    mc "Pas de problème. C'est votre conversation et vos excuses."

# game/scripts/c22/c22.rpy:2302
translate french c22s004_EveNoRoute_e8cb8c5f:

    # eva "Te veo en cinco minutos."
    eva "Je te vois dans cinq minutes."

# game/scripts/c22/c22.rpy:2304
translate french c22s004_EveNoRoute_4c8540f5:

    # "Nunca te fíes de una mujer hermosa cuando diga cinco minutos."
    "Ne faites jamais confiance à une belle femme lorsqu'elle dit cinq minutes."

# game/scripts/c22/c22.rpy:2306
translate french c22s004_EveNoRoute_c0f374b2:

    # "Tras quince minutos de mirar el móvil, aparece [eva] de nuevo."
    "Après quinze minutes passées à regarder le téléphone portable, [eva] réapparaît."

# game/scripts/c22/c22.rpy:2307
translate french c22s004_EveNoRoute_df2abffe:

    # eva "Ya está. Ya me he disculpado."
    eva "Voilà. Je me suis déjà excusé."

# game/scripts/c22/c22.rpy:2308
translate french c22s004_EveNoRoute_1e0bcec0:

    # mc "¿Estás mejor?"
    mc "Vous vous sentez mieux ?"

# game/scripts/c22/c22.rpy:2310
translate french c22s004_EveNoRoute_e55d0ee7:

    # eva "Mucho mejor. Sienta bien quitarse ese peso de encima."
    eva "C'est beaucoup mieux. Quel soulagement de ne plus avoir ce poids sur les épaules !"

# game/scripts/c22/c22.rpy:2313
translate french c22s004_EveNoRoute_a7267a48:

    # eva "Por cierto, felicidades. No vas a encontrar a nadie mejor que mi hermana."
    eva "Au fait, félicitations. Vous ne trouverez personne de mieux que ma sœur."

# game/scripts/c22/c22.rpy:2315
translate french c22s004_EveNoRoute_572bbbe6:

    # eva "Bueno, sí, pero no quieres salir conmigo. *Risa*"
    eva "Oui, mais tu ne veux pas sortir avec moi. *Rires*"

# game/scripts/c22/c22.rpy:2316
translate french c22s004_EveNoRoute_1922a406:

    # mc "No sabía que te lo iba a decir ahora."
    mc "Je ne savais pas que j'allais te le dire maintenant."

# game/scripts/c22/c22.rpy:2318
translate french c22s004_EveNoRoute_7c4f0b77:

    # eva "Cuando llegó ayer yo estaba molida. Quería contármelo cuando me despertara, antes de ir a cenar a casa."
    eva "Quand il est arrivé hier, j'étais épuisée. Il voulait me le dire à mon réveil, avant de rentrer dîner."

# game/scripts/c22/c22.rpy:2319
translate french c22s004_EveNoRoute_fdd9098f:

    # eva "Pero me despertó la llamada de Aaron para decirnos lo de Gavin."
    eva "Mais j'ai été réveillé par l'appel d'Aaron qui nous parlait de Gavin."

# game/scripts/c22/c22.rpy:2320
translate french c22s004_EveNoRoute_269fe6c5:

    # eva "Supongo que me puse demasiado borde y no quería contármelo entonces."
    eva "J'imagine que j'ai été trop impolie et qu'il n'a pas voulu me le dire à ce moment-là."

# game/scripts/c22/c22.rpy:2321
translate french c22s004_EveNoRoute_d21196a6:

    # mc "Sabes que a mí no me gustan los secretos."
    mc "Tu sais que je n'aime pas les secrets."

# game/scripts/c22/c22.rpy:2323
translate french c22s004_EveNoRoute_01e892ae:

    # eva "Lo sé. Y en este caso era justificado. No sé cómo hubiera recibido la noticia antes de que llegaras."
    eva "Je sais. Et dans ce cas précis, c'était justifié. Je ne sais pas comment j'aurais accueilli la nouvelle avant ton arrivée."

# game/scripts/c22/c22.rpy:2324
translate french c22s004_EveNoRoute_c949557a:

    # eva "Tus abrazos tienen algo de curativo. ¿Te lo han dicho alguna vez?"
    eva "Tes câlins ont un pouvoir guérisseur. Est-ce que quelqu'un te l'a déjà dit ?"

# game/scripts/c22/c22.rpy:2325
translate french c22s004_EveNoRoute_c0c7f532:

    # mc "*Risa* Sí, alguna vez me lo han dicho."
    mc "*Rires* Oui, on me l'a déjà dit."

# game/scripts/c22/c22.rpy:2327
translate french c22s004_EveNoRoute_f28a609b:

    # eva "Ahora vas a tener que irte. Quiero ducharme. Apesto."
    eva "Maintenant, tu vas devoir partir. Je veux prendre une douche. Je pue."

# game/scripts/c22/c22.rpy:2328
translate french c22s004_EveNoRoute_9ecb9510:

    # eva "[ama] quería hablar contigo sobre algo del viaje a Aruba."
    eva "[ama] Je voulais te parler de quelque chose qui s'est passé lors de mon voyage à Aruba."

# game/scripts/c22/c22.rpy:2329
translate french c22s004_EveNoRoute_344bf5f0:

    # mc "¿Te veo luego?"
    mc "À plus tard?"

# game/scripts/c22/c22.rpy:2330
translate french c22s004_EveNoRoute_362ece90:

    # eva "¡Por supuesto!"
    eva "Bien sûr!"

# game/scripts/c22/c22.rpy:2333
translate french c22s004_EveNoRoute_5fa41bfe:

    # "Nada más entrar en la sala de control, suena tu teléfono"
    "Dès que vous entrez dans la salle de contrôle, votre téléphone sonne."

# game/scripts/c22/c22.rpy:2341
translate french c22s003_IronFistCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c22/c22.rpy:2343
translate french c22s003_IronFistCalls_9ba0a8c0:

    # mcp "(Número desconocido...)"
    mcp "(Nombre inconnu...)"

# game/scripts/c22/c22.rpy:2346
translate french c22s003_IronFistCalls_6c5f241b:

    # mc "Hola, [mc] Marks al habla."
    mc "Bonjour, [mc] Marks à l'appareil."

# game/scripts/c22/c22.rpy:2347
translate french c22s003_IronFistCalls_5d7bf905:

    # mcp "(Acabo de sonar super ridículo.)"
    mcp "(Je viens de paraître complètement ridicule.)"

# game/scripts/c22/c22.rpy:2348
translate french c22s003_IronFistCalls_391a3adf:

    # man "Buenos días, Sr. Marks. Le llamo de Iron Fist, soy Jeff Sound, el asistente del Sr. Ichigo, Vicepresidente de Operaciones."
    man "Bonjour, M. Marks. Je vous appelle de la part d'Iron Fist, ici Jeff Sound, l'assistant de M. Ichigo, vice-président des opérations."

# game/scripts/c22/c22.rpy:2349
translate french c22s003_IronFistCalls_a40dc997:

    # mc "Un momento, Sr. Sound. Le pongo en manos libres, tengo una persona de mi equipo aquí que va a estar interesada en esta conversación."
    mc "Un instant, Monsieur le Son. Je vous mets sur haut-parleur ; un membre de mon équipe est ici et sera intéressé par cette conversation."

# game/scripts/c22/c22.rpy:2351
translate french c22s003_IronFistCalls_dd32dc13:

    # jef "Ningún problema, Sr. Marks."
    jef "Pas de problème, M. Marks."

# game/scripts/c22/c22.rpy:2353
translate french c22s003_IronFistCalls_ea0ae3a0:

    # ama "Buenos días, Sr. Sound. Soy [ama] Gilford. Le escucho bien."
    ama "Bonjour, Monsieur Sound. Ici Gilford. Je vous entends très bien."

# game/scripts/c22/c22.rpy:2354
translate french c22s003_IronFistCalls_6b91c75d:

    # jef "Encantado de hablar con usted, Srta. Gilford. ¿O es Sra.?"
    jef "C'est un plaisir de vous parler, Mademoiselle Gilford. Ou est-ce Madame ?"

# game/scripts/c22/c22.rpy:2356
translate french c22s003_IronFistCalls_1b076072:

    # ama "Srta. está bien."
    ama "Mademoiselle, ça va ?"

# game/scripts/c22/c22.rpy:2357
translate french c22s003_IronFistCalls_015cdb0f:

    # mc "Dígame, Sr. Sound."
    mc "Dites-moi, Monsieur le Son."

# game/scripts/c22/c22.rpy:2358
translate french c22s003_IronFistCalls_6804df4e:

    # jef "Les llamo porque han llegado a nosotros informaciones sobre el cambio de propiedad de NTR y..."
    jef "Je vous appelle car nous avons reçu des informations concernant un changement de propriétaire de NTR et..."

# game/scripts/c22/c22.rpy:2359
translate french c22s003_IronFistCalls_5d519b79:

    # mc "¿Me puede decir de dónde han sacado esa información? ¿Y este número de teléfono?"
    mc "Pouvez-vous me dire où vous avez trouvé ces informations ? Et ce numéro de téléphone ?"

# game/scripts/c22/c22.rpy:2360
translate french c22s003_IronFistCalls_306afe27:

    # jef "Esa es una información reservada, Sr. Marks. No podemos revelar nuestras fuentes."
    jef "Ce sont des informations confidentielles, Monsieur Marks. Nous ne pouvons pas révéler nos sources."

# game/scripts/c22/c22.rpy:2362
translate french c22s003_IronFistCalls_886708b9:

    # ama "Estaba hablando usted del cambio de propiedad de NTR. Siga, por favor."
    ama "Vous parliez du changement de propriétaire de NTR. Veuillez continuer."

# game/scripts/c22/c22.rpy:2363
translate french c22s003_IronFistCalls_2caf15f7:

    # jef "Sí. Nos hemos enterado del cambio de propiedad y de que ésta ha recaído en un grupo representado por el Sr. Marks."
    jef "Oui. Nous avons appris le changement de propriétaire et que l'entreprise est passée à un groupe représenté par M. Marks."

# game/scripts/c22/c22.rpy:2364
translate french c22s003_IronFistCalls_3fa127ba:

    # ama "Exacto."
    ama "Exact."

# game/scripts/c22/c22.rpy:2365
translate french c22s003_IronFistCalls_6c01e46a:

    # jef "También nos han llegado noticias de que el Sr. Marks va a ocupar el puesto de CEO en breve."
    jef "Nous avons également appris que M. Marks prendra prochainement la direction générale."

# game/scripts/c22/c22.rpy:2366
translate french c22s003_IronFistCalls_528a8536:

    # ama "Sí. Esas informaciones son exactas."
    ama "Oui, cette information est exacte."

# game/scripts/c22/c22.rpy:2367
translate french c22s003_IronFistCalls_db3ac24a:

    # jef "¿Me podrían decir quién es ese grupo de accionistas, por favor?"
    jef "Pourriez-vous me dire de qui il s'agit ?"

# game/scripts/c22/c22.rpy:2369
translate french c22s003_IronFistCalls_2e120bea:

    # mc "Son..."
    mc "Sont..."

# game/scripts/c22/c22.rpy:2370
translate french c22s003_IronFistCalls_19797f13:

    # ama "No creo que sea de su interés, Sr. Sound. Están representados por el Sr. Marks y él es capaz de hablar por ellos."
    ama "Je ne crois pas que ce soit dans votre intérêt, Monsieur Sound. Vous êtes représenté par Monsieur Marks, et il est habilité à parler en votre nom."

# game/scripts/c22/c22.rpy:2371
translate french c22s003_IronFistCalls_a6c58ba9:

    # ama "¿Quería algo más?"
    ama "Vous vouliez autre chose ?"

# game/scripts/c22/c22.rpy:2372
translate french c22s003_IronFistCalls_ae258745:

    # jef "También llamaba porque al Sr. Ichigo le gustaría reunirse con el Sr. Marks."
    jef "Il appelait également parce que M. Ichigo souhaitait rencontrer M. Marks."

# game/scripts/c22/c22.rpy:2373
translate french c22s003_IronFistCalls_f68c9824:

    # mc "¿Por alguna razón en concreto?"
    mc "Pour une raison particulière ?"

# game/scripts/c22/c22.rpy:2374
translate french c22s003_IronFistCalls_b8e36178:

    # jef "Una primera toma de contacto entre dos de las principales empresas del sector. El Sr. Ichigo se había reunido varias veces con el Sr. Daniels."
    jef "Il s'agissait d'une première rencontre entre deux des entreprises leaders du secteur. M. Ichigo avait déjà rencontré M. Daniels à plusieurs reprises."

# game/scripts/c22/c22.rpy:2376
translate french c22s003_IronFistCalls_6f9ec9b5:

    # ama "*Pone el móvil en mute* Xabier Daniels era el jefe de GILF que empezó la Guerra Clon."
    ama "*Met son téléphone en mode silencieux* Xabier Daniels était le chef de GILF qui a déclenché la Guerre des Clones."

# game/scripts/c22/c22.rpy:2377
translate french c22s003_IronFistCalls_c95b64af:

    # "Asientes."
    "Vous hochez la tête."

# game/scripts/c22/c22.rpy:2378
translate french c22s003_IronFistCalls_372a491b:

    # mc "Desafortunadamente, el Sr. Daniels ya no trabaja con nosotros, pero si se trata de una visita de cortesía, no tengo ningún problema en conocer al Sr. Ichigo."
    mc "Malheureusement, M. Daniels ne travaille plus avec nous, mais s'il s'agit d'une visite de courtoisie, je n'ai aucun problème à rencontrer M. Ichigo."

# game/scripts/c22/c22.rpy:2379
translate french c22s003_IronFistCalls_72b19fea:

    # jef "Muchas gracias, Sr. Marks. El Sr. Ichigo estará en Vandenberg mañana por la tarde, y dará una recepción para algunos clientes en su yate por la noche."
    jef "Merci beaucoup, Monsieur Marks. Monsieur Ichigo sera à Vandenberg demain après-midi et donnera une réception pour certains clients sur son yacht le soir même."

# game/scripts/c22/c22.rpy:2380
translate french c22s003_IronFistCalls_5d55801b:

    # jef "Le gustaría que acudiera."
    jef "Il aimerait qu'elle vienne."

# game/scripts/c22/c22.rpy:2382
translate french c22s003_IronFistCalls_7f58a0aa:

    # ama "Imposible. El Sr. Marks tiene la agenda ocupada hasta el viernes. Debería ser a partir del sábado."
    ama "Impossible. L'emploi du temps de M. Marks est complet jusqu'à vendredi. Il faudrait que ce soit à partir de samedi."

# game/scripts/c22/c22.rpy:2383
translate french c22s003_IronFistCalls_f359de1c:

    # jef "Déjeme mirar un tema. Un momento..."
    jef "Laissez-moi vérifier quelque chose. Un instant…"

# game/scripts/c22/c22.rpy:2384
translate french c22s003_IronFistCalls_e8924f49:

    # jef "El sábado es un buen día. Hay un evento más pequeño en el yate frente al puerto de Westport. Tendrán más oportunidades de conocerse."
    jef "Samedi est une bonne journée. Il y a un événement plus intime sur le yacht devant le port de Westport. Ils auront ainsi davantage l'occasion de faire connaissance."

# game/scripts/c22/c22.rpy:2386
translate french c22s003_IronFistCalls_68fcb964:

    # ama "El sábado entonces. ¿Transporte?"
    ama "Samedi alors. Transport ?"

# game/scripts/c22/c22.rpy:2387
translate french c22s003_IronFistCalls_1337076f:

    # jef "Podemos enviar un helicóptero a recoger al Sr. Marks."
    jef "Nous pouvons envoyer un hélicoptère chercher M. Marks."

# game/scripts/c22/c22.rpy:2388
translate french c22s003_IronFistCalls_f3ffb496:

    # ama "Y a mí. Iremos juntos."
    ama "Et moi. Nous irons ensemble."

# game/scripts/c22/c22.rpy:2389
translate french c22s003_IronFistCalls_2135db09:

    # jef "Perfecto. Nos tendrán que indicar dónde quieren que les recojamos."
    jef "Parfait. Vous devrez nous indiquer où vous souhaitez que nous venions vous chercher."

# game/scripts/c22/c22.rpy:2391
translate french c22s003_IronFistCalls_647b9adc:

    # "[ama] continúa atando detalles de la reunión, dando indicaciones y detalles, pero sin revelar ninguna información."
    "[ama] continue de rassembler les détails de la réunion, en donnant des instructions et des détails, mais sans révéler aucune information."

# game/scripts/c22/c22.rpy:2392
translate french c22s003_IronFistCalls_ed693545:

    # "Consigue algunos nombres de las personas que asistirán al evento menor, y el Sr. Sound se compromete a enviarle la lista completa de invitados."
    "Obtenez quelques noms des personnes qui assisteront à ce petit événement, et M. Sound vous promet de vous envoyer la liste complète des invités."

# game/scripts/c22/c22.rpy:2393
translate french c22s003_IronFistCalls_a48b253f:

    # "Aunque vaya vestida de mecánico, es mucho mejor en esto de lo que tú serías con un traje."
    "Même si elle est habillée en mécanicienne, elle est bien meilleure dans ce domaine que vous ne le seriez en costume."

# game/scripts/c22/c22.rpy:2394
translate french c22s003_IronFistCalls_fcea9a6f:

    # "Unos minutos después os despedís del Sr. Sound."
    "Quelques minutes plus tard, vous dites au revoir à M. Sound."

# game/scripts/c22/c22.rpy:2396
translate french c22s003_IronFistCalls_d96573d6:

    # ama "Ya está. El sábado nos reunimos con Ichigo."
    ama "Voilà. Nous rencontrons Ichigo samedi."

# game/scripts/c22/c22.rpy:2397
translate french c22s003_IronFistCalls_2d22882c:

    # mc "He estado a punto de meter la pata con lo de los accionistas, ¿verdad?"
    mc "J'ai failli faire une gaffe avec cette histoire d'actionnaires, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2399
translate french c22s003_IronFistCalls_180508eb:

    # ama "Sí, un poco. Nunca des información si no es necesario. Si no tienen los nombres de los accionistas tienen que pasar por ti para todo."
    ama "Oui, un peu. Ne divulguez jamais d'informations sauf si c'est absolument nécessaire. S'ils n'ont pas les noms des actionnaires, ils devront passer par vous pour tout."

# game/scripts/c22/c22.rpy:2400
translate french c22s003_IronFistCalls_3c34a0cb:

    # ama "Es nuestra forma de controlar el flujo de información. Cuánto más anónimas sean las chicas, mejor. No podrán contactarlas directamente."
    ama "C'est notre façon de contrôler la diffusion de l'information. Plus les filles restent anonymes, mieux c'est. Elles ne pourront pas être contactées directement."

# game/scripts/c22/c22.rpy:2401
translate french c22s003_IronFistCalls_2d2ddaaa:

    # mc "Me viene muy grande todo esto."
    mc "Tout cela est bien trop pour moi."

# game/scripts/c22/c22.rpy:2403
translate french c22s003_IronFistCalls_6f275ac6:

    # ama "No te preocupes, aprenderás. Esto es nuevo para ti, pero al menos te das cuenta de cuándo estás a punto de cometer un error."
    ama "Ne t'inquiète pas, tu apprendras. C'est nouveau pour toi, mais au moins tu te rendras compte quand tu es sur le point de faire une erreur."

# game/scripts/c22/c22.rpy:2404
translate french c22s003_IronFistCalls_070a9693:

    # ama "Lo que tienes que aprender es a darte cuenta antes de cometerlo."
    ama "Ce que vous devez apprendre, c'est à vous en rendre compte avant de commettre l'erreur."

# game/scripts/c22/c22.rpy:2405
translate french c22s003_IronFistCalls_d3ffc09e:

    # mc "Si no hubieras estado aquí... hubiera aceptado la reunión de mañana. ¿Por qué la has rechazado?"
    mc "Si vous n'aviez pas été là… j'aurais accepté la réunion de demain. Pourquoi avez-vous refusé ?"

# game/scripts/c22/c22.rpy:2407
translate french c22s003_IronFistCalls_f0a1b841:

    # ama "*Risa* Porque la han propuesto ellos. Si nos negamos a su primera propuesta, se pueden poner ansiosos."
    ama "*Rires* Parce que c'est eux qui l'ont proposé. Si on refuse leur première proposition, ils risquent de s'inquiéter."

# game/scripts/c22/c22.rpy:2408
translate french c22s003_IronFistCalls_bcad0b66:

    # ama "Si aceptamos una propuesta así con tan poca antelación, parece que estemos besándoles el culo."
    ama "Accepter une telle proposition avec si peu de préavis, c'est comme leur lécher les bottes."

# game/scripts/c22/c22.rpy:2410
translate french c22s003_IronFistCalls_1f6dad46:

    # ama "De esta forma demostramos que son ellos los que tienen interés y no nosotros."
    ama "Nous démontrons ainsi que ce sont eux qui ont un intérêt, et non nous."

# game/scripts/c22/c22.rpy:2411
translate french c22s003_IronFistCalls_111d4888:

    # ama "Si no hubieran tenido el evento del sábado, posiblemente se hubieran tenido que inventar algo para forzar esa reunión informal."
    ama "S'ils n'avaient pas eu l'événement de samedi, ils auraient probablement dû trouver un prétexte pour forcer cette réunion informelle."

# game/scripts/c22/c22.rpy:2412
translate french c22s003_IronFistCalls_2d9d8c2c:

    # mc "Que de informal tendrá poco, ¿no?"
    mc "Ça ne peut pas être très informel, si ?"

# game/scripts/c22/c22.rpy:2414
translate french c22s003_IronFistCalls_51ab4840:

    # ama "Poquísimo. Vandenberg es una base de la Fuerza Aérea, más dedicada al espacio que a algo con lo que Iron Fist tenga algo que ver."
    ama "Très peu. Vandenberg est une base aérienne, bien plus dédiée à l'espace qu'à tout ce qui a trait à Iron Fist."

# game/scripts/c22/c22.rpy:2415
translate french c22s003_IronFistCalls_6e0ea7a5:

    # ama "Te querían demostrar que son fuertes y que tienen contactos en todos lados. No te conocen y te quieren impresionar."
    ama "Ils voulaient vous montrer leur pouvoir et leurs relations partout. Ils ne vous connaissent pas et cherchent à vous impressionner."

# game/scripts/c22/c22.rpy:2416
translate french c22s003_IronFistCalls_dbeb0dd0:

    # ama "Seguro que al evento en Westport va algún coronel de Fort Hunter Liggett. Está a menos de dos horas."
    ama "Je suis certain qu'un colonel de Fort Hunter Liggett sera présent à l'événement de Westport. C'est à moins de deux heures d'ici."

# game/scripts/c22/c22.rpy:2417
translate french c22s003_IronFistCalls_e950b2e2:

    # mc "Hay demasiados matices en todo esto y yo no tengo ni idea... Creo que tú, [eva], o [aar] seríais mejores CEO que yo."
    mc "Il y a trop de nuances dans tout cela et je n'en ai aucune idée... Je pense que vous, [eva], ou [aar], seriez de meilleurs PDG que moi."

# game/scripts/c22/c22.rpy:2419
translate french c22s003_IronFistCalls_7b341c6d:

    # ama "Nosotros somos operativos de campo. No tenemos ni idea de cómo gestionar una empresa, pero conocemos el negocio."
    ama "Nous sommes des opérateurs de terrain. Nous n'y connaissons rien en gestion d'entreprise, mais nous connaissons le secteur."

# game/scripts/c22/c22.rpy:2420
translate french c22s003_IronFistCalls_d110c58d:

    # ama "Nuestro problema es de visión, al menos el mío. Tengo una visión limitada del conjunto."
    ama "Notre problème est un problème de vision, du moins le mien. J'ai une vision limitée de la situation dans son ensemble."

# game/scripts/c22/c22.rpy:2421
translate french c22s003_IronFistCalls_dd063c89:

    # ama "[aar] no es una figura cómoda en NTR para los que trabajaron bajo las órdenes de Xabier."
    ama "[aar] n'est pas une figure rassurante dans NTR pour ceux qui ont travaillé sous les ordres de Xabier."

# game/scripts/c22/c22.rpy:2422
translate french c22s003_IronFistCalls_5bc7e3dd:

    # ama "Y [eva] tiene el problema del martillo."
    ama "Et [eva] a le problème du marteau."

# game/scripts/c22/c22.rpy:2423
translate french c22s003_IronFistCalls_55a23645:

    # mc "¿Martillo?"
    mc "Marteau?"

# game/scripts/c22/c22.rpy:2425
translate french c22s003_IronFistCalls_1b21ec91:

    # ama "Para [eva], sus armas son sus herramientas. Su martillo. Y cualquier problema es un clavo."
    ama "Pour [eva], ses armes sont ses outils. Son marteau. Et tout problème est un clou."

# game/scripts/c22/c22.rpy:2426
translate french c22s003_IronFistCalls_aebbd428:

    # ama "Intentaría resolver cualquier problema con la fuerza, y no es la dirección que queremos darle a la empresa, ¿no?"
    ama "Il essayait de résoudre tous les problèmes par la force, et ce n'est pas la direction que nous voulons donner à l'entreprise, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2427
translate french c22s003_IronFistCalls_ab6417a5:

    # mc "No, en eso tienes razón. *Risa* No queremos que hundan el yate de Ichigo."
    mc "Non, tu as raison. *Rires* On ne veut pas que le yacht d'Ichigo coule."

# game/scripts/c22/c22.rpy:2429
translate french c22s003_IronFistCalls_a3396ac1:

    # ama "Bueno, tengo que arreglar unos temas para la reunión del sábado y buscar información sobre los asistentes. Te voy a tener que dejar."
    ama "Bon, je dois régler quelques détails pour la réunion de samedi et trouver des informations sur les participants. Je dois y aller."

# game/scripts/c22/c22.rpy:2430
translate french c22s003_IronFistCalls_a12fc195:

    # mc "¿Has pensado en pedirle ayuda a [jam]? Creo que os podría ser útil para buscar cosas."
    mc "Avez-vous pensé à demander de l'aide à [jam] ? Je pense que cela pourrait vous être utile pour trouver des choses."

# game/scripts/c22/c22.rpy:2431
translate french c22s003_IronFistCalls_27c95d9c:

    # ama "No es mala idea. Le llamaré esta tarde, cuando volvamos de comer en casa de [nor]."
    ama "C'est une bonne idée. Je l'appellerai cet après-midi, à notre retour de déjeuner chez [nor]."

# game/scripts/c22/c22.rpy:2433
translate french c22s003_IronFistCalls_e0575fec:

    # ama "Y, por cierto, gracias por lo de [eva]."
    ama "Et au fait, merci pour le [eva]."

# game/scripts/c22/c22.rpy:2434
translate french c22s003_IronFistCalls_46cea44c:

    # mc "¿Gracias por qué? Es tu hermana, pero es mi prima."
    mc "Merci pour quoi ? C'est ta sœur, mais c'est ma cousine."

# game/scripts/c22/c22.rpy:2435
translate french c22s003_IronFistCalls_131c04dc:

    # ama "Tienes razón, pero no por ello estoy menos agradecida por lo que has hecho."
    ama "Vous avez raison, mais cela ne me rend pas moins reconnaissant de ce que vous avez fait."

# game/scripts/c22/c22.rpy:2437
translate french c22s003_IronFistCalls_6ed672c4:

    # mc "Y también mi novia, por lo que parece."
    mc "Et ma copine aussi, apparemment."

# game/scripts/c22/c22.rpy:2439
translate french c22s003_IronFistCalls_31693633:

    # ama "*Risa* ¿Por qué odias tanto esa palabra?"
    ama "*Rires* Pourquoi détestes-tu autant ce mot ?"

# game/scripts/c22/c22.rpy:2440
translate french c22s003_IronFistCalls_f8cb2d92:

    # mc "Porque cuando se dice tantas veces pierde el significado. Además nunca me han gustado las etiquetas."
    mc "Parce que, répété sans cesse, ça finit par perdre son sens. Et puis, je n'ai jamais aimé les étiquettes."

# game/scripts/c22/c22.rpy:2442
translate french c22s003_IronFistCalls_c1490d2d:

    # mc "*Risa* Suena muy raro decir que las dos sois mis novias. Creo que no es el uso que tenían pensado cuando inventaron la puta palabra."
    mc "*Rires* Ça sonne vraiment bizarre de dire que vous êtes toutes les deux mes copines. Je ne pense pas que ce soit ce qu'ils avaient en tête quand ils ont inventé ce fichu mot."

# game/scripts/c22/c22.rpy:2444
translate french c22s003_IronFistCalls_f45f20b0:

    # ama "Tienes razón. Te veo luego... novio. *Risa*"
    ama "Tu as raison. À plus tard... mon chéri. *Rires*"

# game/scripts/c22/c22.rpy:2446
translate french c22s003_IronFistCalls_1cb86906:

    # ama "No te entretengo más."
    ama "Je ne vous retiendrai plus."

# game/scripts/c22/c22.rpy:2450
translate french c22s003_IronFistCalls_689458b3:

    # ama "Te veo luego."
    ama "À plus tard."

# game/scripts/c22/c22.rpy:2452
translate french c22s003_IronFistCalls_614f43b7:

    # mc "Hasta dentro de un rato."
    mc "À tout à l'heure."

# game/scripts/c22/c22.rpy:2459
translate french c22s004_EriPregnancyResult_eb0ace6b:

    # "Conduces a casa esperando que [ama] tenga razón en que vas a aprender rápido el nuevo oficio."
    "Vous rentrez chez vous en voiture en espérant que [ama] a raison et que vous apprendrez rapidement votre nouveau travail."

# game/scripts/c22/c22.rpy:2460
translate french c22s004_EriPregnancyResult_38ff4c55:

    # "Estás seguro de que no eres un buen negociador. Ni siquiera sabes que salario vas a tener y ya has aceptado el puesto."
    "Vous êtes persuadé de ne pas être un bon négociateur. Vous ignorez même votre futur salaire, et vous avez déjà accepté le poste."

# game/scripts/c22/c22.rpy:2463
translate french c22s004_EriPregnancyResult_d97e40d3:

    # "Al volver a casa, encuentras a [eri] charlando con [kat] en la planta de las estudiantes."
    "En rentrant chez vous, vous trouvez [eri] en train de discuter avec [kat] sur le sol des étudiants."

# game/scripts/c22/c22.rpy:2464
translate french c22s004_EriPregnancyResult_a9d94cc5:

    # eri "... Creo que deberías unirte. El yoga puede ser divertido."
    eri "Je pense que tu devrais t'inscrire. Le yoga peut être amusant."

# game/scripts/c22/c22.rpy:2465
translate french c22s004_EriPregnancyResult_97b63234:

    # kat "No me vas a convencer, [eri]. Hoy es mi día de descanso de hacer deporte."
    kat "Tu ne vas pas me convaincre, [eri]. Aujourd'hui, je ne fais pas de sport."

# game/scripts/c22/c22.rpy:2466
translate french c22s004_EriPregnancyResult_e2488fb9:

    # kat "Suficiente tengo con despertarme pronto porque [kim] pone la alarma para levantarse en un día que no tengo clase por la mañana."
    kat "J'ai déjà assez à faire avec le simple fait de me réveiller tôt parce que [kim] programme le réveil pour un jour où je n'ai pas cours le matin."

# game/scripts/c22/c22.rpy:2467
translate french c22s004_EriPregnancyResult_67e2393e:

    # mc "Hola, chicas, ¿qué tal?"
    mc "Salut les filles, comment allez-vous ?"

# game/scripts/c22/c22.rpy:2469
translate french c22s004_EriPregnancyResult_0d644090:

    # kat "[eri] sigue la tendencia del día de intentar que me una a las sesiones de yoga. *Risa*"
    kat "Elle continue d'essayer de me convaincre de participer aux séances de yoga. *Rires*"

# game/scripts/c22/c22.rpy:2470
translate french c22s004_EriPregnancyResult_e2acc59a:

    # mc "Ya les has dicho que no te vas a unir mientras lleven ropa, ¿no?"
    mc "Tu leur as déjà dit que tu ne participerais pas tant qu'ils seraient habillés, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2472
translate french c22s004_EriPregnancyResult_20ef6082:

    # kat "*Risa* Ni siquiera entonces. Me sentaría en una tumbona a mirarlas."
    kat "*Rires* Même pas dans ce cas-là. Je me contenterais de m'asseoir sur un transat et de les regarder."

# game/scripts/c22/c22.rpy:2473
translate french c22s004_EriPregnancyResult_aaafa764:

    # mc "*Risa* Guárdame un sitio en esa tumbona."
    mc "*Rires* Garde-moi une place sur ce transat."

# game/scripts/c22/c22.rpy:2475
translate french c22s004_EriPregnancyResult_4b5d8867:

    # eri "*Risa* Y por eso no haremos nunca yoga desnudas. Queremos que os unáis, y no como público."
    eri "*Rires* Voilà pourquoi nous ne ferons jamais de yoga nus. Nous voulons que vous participiez, pas que vous soyez spectateurs."

# game/scripts/c22/c22.rpy:2476
translate french c22s004_EriPregnancyResult_00ff4d75:

    # mc "*Risa* Ya sabes que la flexibilidad no es lo mío."
    mc "*Rires* Tu sais que la souplesse n'est pas mon point fort."

# game/scripts/c22/c22.rpy:2478
translate french c22s004_EriPregnancyResult_5870f805:

    # kat "Bueno, yo voy a ir a estudiar un rato. Hoy quería acabar un informe sobre las belugas."
    kat "Bon, je vais étudier un peu. Aujourd'hui, je voulais terminer un exposé sur les bélugas."

# game/scripts/c22/c22.rpy:2479
translate french c22s004_EriPregnancyResult_3be3a8ac:

    # mc "Las belugas son primas de las ballenas, ¿no?"
    mc "Les bélugas sont des cousins des baleines, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2481
translate french c22s004_EriPregnancyResult_c983b5c7:

    # kat "No son primas de las ballenas. Son ballenas."
    kat "Ce ne sont pas des baleines. Ce sont des baleines."

# game/scripts/c22/c22.rpy:2482
translate french c22s004_EriPregnancyResult_0bbf2f8b:

    # kat "Pero bien hecho, [mc]. Ya era hora que te atrevieras."
    kat "Bravo, [mc]. Il était temps que tu oses."

# game/scripts/c22/c22.rpy:2483
translate french c22s004_EriPregnancyResult_7a2136d1:

    # mc "¿Qué he hecho?"
    mc "Qu'ai-je fait ?"

# game/scripts/c22/c22.rpy:2485
translate french c22s004_EriPregnancyResult_2b1883cb:

    # kat "Insinuar que, al ser ballenas, tengo algún tipo de ventaja para escribir el informe. Es un buen chiste de gordos. Un poco cruel, pero es bueno."
    kat "Suggérer que, étant donné mon gabarit, j'aurais un avantage quelconque pour rédiger ce rapport, c'est une bonne blague grossophobe. Un peu cruelle, certes, mais drôle."

# game/scripts/c22/c22.rpy:2486
translate french c22s004_EriPregnancyResult_6dfd96c5:

    # mc "¿Qué? ¡No! ¡No quería decir eso!"
    mc "Quoi ? Non ! Je ne voulais pas dire ça !"

# game/scripts/c22/c22.rpy:2488
translate french c22s004_EriPregnancyResult_47ce2a6e:

    # eri "¡[mc]! ¿Cómo te atreves? No tienes que intentar acomplejar a nadie sobre su cuerpo."
    eri "Comment osez-vous ! Vous n'avez pas à chercher à complexer qui que ce soit sur son physique."

# game/scripts/c22/c22.rpy:2489
translate french c22s004_EriPregnancyResult_f2370a05:

    # mc "¡De verdad! ¡No he insinuado nada de eso!"
    mc "Vraiment ! Je n'ai rien insinué de tel !"

# game/scripts/c22/c22.rpy:2492
translate french c22s004_EriPregnancyResult_ca594ec9:

    # eri "*Risa* Tenías razón..."
    eri "*Rires* Tu avais raison..."

# game/scripts/c22/c22.rpy:2493
translate french c22s004_EriPregnancyResult_ae4a07a5:

    # kat "*Risa* Nunca falla..."
    kat "*Rires* Ça ne rate jamais..."

# game/scripts/c22/c22.rpy:2494
translate french c22s004_EriPregnancyResult_f8f197a8:

    # mc "¿Qué está pasando aquí?"
    mc "Que se passe-t-il ici ?"

# game/scripts/c22/c22.rpy:2496
translate french c22s004_EriPregnancyResult_a1697737:

    # eri "*Risa* [kat] me estaba diciendo que si consigue que alguien piense que se ha metido con su físico sin darse cuenta, por norma se ponen incómodos."
    eri "*Rires* [kat] Il me disait que s'il réussit à faire croire à quelqu'un qu'il s'est moqué de son apparence sans qu'il s'en rende compte, cette personne se sent généralement mal à l'aise."

# game/scripts/c22/c22.rpy:2497
translate french c22s004_EriPregnancyResult_4dbd5471:

    # kat "*Risa* Y diez minutos después llegas tú y me das la oportunidad de demostrarlo. Gracias por ser mi conejillo de indias."
    kat "*Rires* Et dix minutes plus tard, tu arrives et me donnes l'occasion de le prouver. Merci d'avoir été mon cobaye."

# game/scripts/c22/c22.rpy:2498
translate french c22s004_EriPregnancyResult_6b5bdb3b:

    # mc "Sois malas personas. *Risa* Y yo he caído en vuestra broma. ¡Me voy a mi habitación hasta la hora de comer! Castigado por tonto. *Risa*"
    mc "Vous êtes tous méchants. *Rires* Et moi, je suis tombée dans le panneau ! Je vais dans ma chambre jusqu'à midi ! Je suis punie pour avoir été bête. *Rires*"

# game/scripts/c22/c22.rpy:2503
translate french c22s004_EriPregnancyResult_d2cbeeda:

    # ambas "Hasta luego, [mc]."
    ambas "À plus tard, [mc]."

# game/scripts/c22/c22.rpy:2519
translate french c22s004_EriPregnancy_91543177:

    # eri "Ahora subo a verte. Tengo un tema que tratar contigo."
    eri "Je viens te voir. J'ai quelque chose à te dire."

# game/scripts/c22/c22.rpy:2525
translate french c22s004_EriPregnancy_08b5df7f:

    # mc "Ok."
    mc "D'accord."

# game/scripts/c22/c22.rpy:2527
translate french c22s004_EriPregnancy_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c22/c22.rpy:2529
translate french c22s004_EriPregnancy_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c22/c22.rpy:2531
translate french c22s004_EriPregnancy_fbcb10e3:

    # eri "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    eri "*À travers la porte* C'est moi. Puis-je entrer ?"

# game/scripts/c22/c22.rpy:2532
translate french c22s004_EriPregnancy_3b55a4ab:

    # mc "Sí, entra."
    mc "Oui, entrez."

# game/scripts/c22/c22.rpy:2534
translate french c22s004_EriPregnancy_70251361:

    # mc "Dime. Parecía urgente."
    mc "Dites-moi. Cela semblait urgent."

# game/scripts/c22/c22.rpy:2535
translate french c22s004_EriPregnancy_5c69d3c4:

    # eri "No, todo lo contrario que urgente."
    eri "Non, tout le contraire d'urgent."

# game/scripts/c22/c22.rpy:2536
translate french c22s004_EriPregnancy_9b6f6612:

    # eri "Hace un par de días que la prueba de embarazo tiene que haber dado los resultados..."
    eri "Le test de grossesse aurait dû donner les résultats il y a deux jours..."

# game/scripts/c22/c22.rpy:2537
translate french c22s004_EriPregnancy_5e4174aa:

    # mc "¡Es verdad! ¡Me había olvidado de ella!"
    mc "C'est vrai ! Je l'avais oubliée !"

# game/scripts/c22/c22.rpy:2538
translate french c22s004_EriPregnancy_3198ded4:

    # mc "¿Quieres hacer los honores? Está en ese armario."
    mc "Tu veux bien faire les honneurs ? C'est dans ce placard."

# game/scripts/c22/c22.rpy:2541
translate french c22s004_EriPregnancy_27e10dda:

    # eri "¡Verde! ¡Vamos a tener a Hope!"
    eri "Vert ! Nous allons avoir de l'espoir !"

# game/scripts/c22/c22.rpy:2542
translate french c22s004_EriPregnancy_6d51f1a5:

    # mc "¡Felicidades, futura mamá!"
    mc "Félicitations à la future maman !"

# game/scripts/c22/c22.rpy:2544
translate french c22s004_EriPregnancy_6bb6d4cd:

    # eri "Felicidades a ti también, Papá."
    eri "Félicitations à toi aussi, papa."

# game/scripts/c22/c22.rpy:2545
translate french c22s004_EriPregnancy_05e3eae1:

    # mc "Gracias, cielo."
    mc "Merci, chérie."

# game/scripts/c22/c22.rpy:2547
translate french c22s004_EriPregnancy_f004ec1b:

    # mc "¿Has hablado con [nor] sobre lo del nombre?"
    mc "Avez-vous parlé à [nor] du nom ?"

# game/scripts/c22/c22.rpy:2549
translate french c22s004_EriPregnancy_06c017cb:

    # eri "Sí, le dije que me hacía mucha ilusión ponerle Hope a mi hija y no tuvo ningún problema."
    eri "Oui, je lui ai dit que j'étais vraiment ravie d'appeler ma fille Hope et cela ne lui a posé aucun problème."

# game/scripts/c22/c22.rpy:2550
translate french c22s004_EriPregnancy_68b8233f:

    # eri "Al fin y al cabo, el nombre lo había elegido yo."
    eri "Après tout, c'est moi qui avais choisi le nom."

# game/scripts/c22/c22.rpy:2551
translate french c22s004_EriPregnancy_7db9fc44:

    # mc "Me alegra que lo hayáis podido resolver sin dramas."
    mc "Je suis content que vous ayez pu régler le problème sans incident."

# game/scripts/c22/c22.rpy:2553
translate french c22s004_EriPregnancy_ad07759b:

    # eri "Y ¿ahora qué?"
    eri "Et maintenant ?"

# game/scripts/c22/c22.rpy:2554
translate french c22s004_EriPregnancy_28760dbb:

    # mc "Supongo que después de la Gran Revelación, debemos comunicar estas cosas a la familia, ¿no?"
    mc "Je suppose qu'après la Révélation, nous devrions communiquer ces choses à la famille, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2555
translate french c22s004_EriPregnancy_7ed1aafd:

    # mc "Me he cansado de guardar cosas en secreto."
    mc "J'en ai marre de garder des secrets."

# game/scripts/c22/c22.rpy:2557
translate french c22s004_EriPregnancy_fd25e266:

    # eri "Me parece buena idea. Me gustaría decírselo a mi madre y a mi hermana en persona."
    eri "Ça me paraît une bonne idée. J'aimerais l'annoncer en personne à ma mère et à ma sœur."

# game/scripts/c22/c22.rpy:2558
translate french c22s004_EriPregnancy_e0602a5e:

    # eri "Al resto se lo podemos decir en la comida y publicarlo en el grupo de WhatsUp."
    eri "On pourra raconter le reste à midi et le poster dans le groupe WhatsApp."

# game/scripts/c22/c22.rpy:2559
translate french c22s004_EriPregnancy_90552759:

    # mc "En el que no estoy... *Risa*"
    mc "Ce à quoi je ne participe pas... *Rires*"

# game/scripts/c22/c22.rpy:2561
translate french c22s004_EriPregnancy_04ebd4e9:

    # eri "*Risa* Y en el que no estarás. [emm] me ha dicho que crearemos otro contigo, pero ese es solo para chicas."
    eri "*Rires* Et tu n'y seras pas. [emm] Elle m'a dit qu'on en ferait un autre avec toi, mais celui-là serait réservé aux filles."

