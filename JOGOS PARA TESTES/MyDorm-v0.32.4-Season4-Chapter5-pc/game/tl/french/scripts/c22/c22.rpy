translate french c22s002_EmmMarChat_02fcb6ab_1:

    # mc "Pues cuando quieras podemos subir a hacerla. Las tengo en mi habitación."
    mc "On peut monter et le faire quand tu veux. Je les ai dans ma chambre."

# game/scripts/c22/c22.rpy:886
translate french c22s002_EmmMarChat_55df95c8_1:

    # sai "¿Ahora te va bien? Así después de hacerla me puedo vestir para ir a clase."
    sai "Ça vous convient maintenant ? Comme ça, je pourrai m'habiller pour le cours après avoir fini."

# game/scripts/c22/c22.rpy:887
translate french c22s002_EmmMarChat_c3f1da34_1:

    # mc "Perfecto. Vamos y ya acabaré de desayunar luego."
    mc "Parfait. Allons-y, je finirai mon petit-déjeuner plus tard."

# game/scripts/c22/c22.rpy:890
translate french c22s002_EmmMarChat_03d285af:

    # mc "¿Pasa algo, [deb.nick]?"
    mc "Y a-t-il un problème, [deb.nick] ?"

# game/scripts/c22/c22.rpy:891
translate french c22s002_EmmMarChat_99c19ea1:

    # deb "No sé si voy a poder llevar los tres cafés a la vez por las escaleras."
    deb "Je ne sais pas si je serai capable de monter les trois cafés en même temps."

# game/scripts/c22/c22.rpy:892
translate french c22s002_EmmMarChat_50a2762a:

    # mc "No te preocupes, te acompaño y ya acabaré de desayunar luego."
    mc "Ne t'inquiète pas, je t'accompagnerai et je finirai mon petit-déjeuner plus tard."

# game/scripts/c22/c22.rpy:897
translate french c22s002_EmmMarChat_bffc7bbc:

    # "Unos minutos después, de vuelta en la cocina..."
    "Quelques minutes plus tard, de retour dans la cuisine..."

# game/scripts/c22/c22.rpy:899
translate french c22s002_EmmMarChat_e76c8103:

    # mc "Ya estoy de vuelta. A ver si ahora puedo acabarme el café."
    mc "Me revoilà. Voyons si je peux finir mon café maintenant."

# game/scripts/c22/c22.rpy:901
translate french c22s002_EmmMarChat_c76bd69d:

    # mc "Ya estamos de vuelta. A ver si ahora puedo acabarme el café."
    mc "Nous revoilà. Voyons si je peux finir mon café maintenant."

# game/scripts/c22/c22.rpy:902
translate french c22s002_EmmMarChat_a62ffa4a:

    # mc "[emm], ¿no quieres sentarte?"
    mc "[emm], tu ne veux pas t'asseoir ?"

# game/scripts/c22/c22.rpy:905
translate french c22s002_EmmMarChat_5f3b5313:

    # emm "No... no puedo..."
    emm "Non... je ne peux pas..."

# game/scripts/c22/c22.rpy:906
translate french c22s002_EmmMarChat_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c22/c22.rpy:908
translate french c22s002_EmmMarChat_42a03b71:

    # emm "Por tu culpa. *Risa* Y por la mía por pedirlo..."
    emm "Grâce à toi. *Rires* Et grâce à moi pour avoir posé la question..."

# game/scripts/c22/c22.rpy:909
translate french c22s002_EmmMarChat_873e66b5:

    # mc "¡Ah! Por eso..."
    mc "Ah ! Voilà pourquoi..."

# game/scripts/c22/c22.rpy:911
translate french c22s002_EmmMarChat_66d0d6ab:

    # mom "¿Qué? ¿Por eso preguntabas ayer si hoy volveríamos a comer de pie?"
    mom "Quoi ? C'est pour ça que tu demandais hier si on allait encore manger debout aujourd'hui ?"

# game/scripts/c22/c22.rpy:913
translate french c22s002_EmmMarChat_f9cf5905:

    # emm "Es que me encantó, pero llevo dos días arrepintiéndome."
    emm "J'ai adoré, mais je le regrette depuis deux jours."

# game/scripts/c22/c22.rpy:914
translate french c22s002_EmmMarChat_20fb2687:

    # emm "Me pasó lo mismo la primera vez que lo hicimos... normal..."
    emm "La même chose m'est arrivée la première fois... normal..."

# game/scripts/c22/c22.rpy:915
translate french c22s002_EmmMarChat_209dbdee:

    # mc "Entonces será mejor no volver a probarlo."
    mc "Alors il vaut mieux ne pas réessayer."

# game/scripts/c22/c22.rpy:917
translate french c22s002_EmmMarChat_624953b1:

    # emm "¿Qué? ¡NO! No me refería a eso. La primera vez normal también me arrepentí, y ahora ya no tengo molestias nunca."
    emm "Quoi ? Non ! Je ne voulais pas dire ça. La première fois que je l'ai fait normalement, je l'ai aussi regretté, et maintenant je ne ressens plus aucune gêne."

# game/scripts/c22/c22.rpy:919
translate french c22s002_EmmMarChat_4c3fa8c1:

    # emm "Supongo que pasará lo mismo por detrás, ¿no, Mamá?"
    emm "J'imagine que la même chose se produit dans ton dos, n'est-ce pas, maman ?"

# game/scripts/c22/c22.rpy:921
translate french c22s002_EmmMarChat_e86f18ce:

    # mom "Pues no lo sé. Yo no tengo experiencia en eso."
    mom "Eh bien, je ne sais pas. Je n'ai aucune expérience dans ce domaine."

# game/scripts/c22/c22.rpy:924
translate french c22s002_EmmMarChat_6f0c21f0:

    # emm "¡Pues lo tienes que probar! Te recomiendo que uses un plug más grande que el mío para ir acostumbrándote."
    emm "Eh bien, il faut absolument que tu essaies ! Je te recommande d'utiliser une prise plus grosse que la mienne pour t'y habituer."

# game/scripts/c22/c22.rpy:925
translate french c22s002_EmmMarChat_768b1c3e:

    # emm "Pero es alucinante. Y nuestro chico es muy delicado... O todo lo delicado que se puede ser con Mjolnir."
    emm "Mais c'est incroyable. Et notre homme est très fragile… Ou du moins, aussi fragile qu'on puisse l'être avec Mjolnir."

# game/scripts/c22/c22.rpy:927
translate french c22s002_EmmMarChat_2093e9ff:

    # mom "Bueno, creo que no es algo de lo que tengamos que hablar ahora..."
    mom "Eh bien, je ne pense pas que ce soit un sujet dont nous ayons besoin de parler maintenant..."

# game/scripts/c22/c22.rpy:929
translate french c22s002_EmmMarChat_0bc1ca38:

    # emm "¿Qué pusiste en el grupo de WhatsUp ayer? Que, si nos estamos convirtiendo en una familia, lo podemos hablar todo, ¿no?"
    emm "Qu'as-tu posté hier dans le groupe WhatsApp ? Que si on devient une famille, on peut parler de tout, c'est ça ?"

# game/scripts/c22/c22.rpy:931
translate french c22s002_EmmMarChat_d06b0c08:

    # mom "Pero eso no incluye que hable sobre lo que [mc] y yo hacemos en la intimidad contigo o con cualquier otra chica."
    mom "Mais cela n'inclut pas le fait que je parle de ce que [mc] et moi faisons en privé avec toi ou avec n'importe quelle autre fille."

# game/scripts/c22/c22.rpy:932
translate french c22s002_EmmMarChat_20847ee2:

    # mom "Si tú quieres hablar de ello, me parece bien, pero tienes que respetar a las que pensamos que lo que hacemos en privado debe quedarse en privado."
    mom "Si vous voulez en parler, ça me va, mais vous devez respecter ceux d'entre nous qui pensent que ce que nous faisons en privé doit rester privé."

# game/scripts/c22/c22.rpy:934
translate french c22s002_EmmMarChat_4455ecf7:

    # mc "Mamá tiene razón. A mí no me importa que tú le expliques lo que quieras a ella, pero yo no lo voy a hacer."
    mc "Maman a raison. Ça ne me dérange pas que tu lui expliques ce que tu veux, mais moi, je ne le ferai pas."

# game/scripts/c22/c22.rpy:935
translate french c22s002_EmmMarChat_a2f5bd30:

    # mc "Igual que no voy a explicarte lo que hago con ella. Para mí forma parte de la intimidad de la pareja."
    mc "De même que je ne vais pas expliquer ce que je fais avec elle. Pour moi, cela fait partie de notre vie privée de couple."

# game/scripts/c22/c22.rpy:936
translate french c22s002_EmmMarChat_d849de77:

    # emm "Tenéis razón... Deberíamos ir bajando a la piscina, ¿no?"
    emm "Tu as raison… On devrait aller à la piscine, non ?"

# game/scripts/c22/c22.rpy:939
translate french c22s002_EmmMarChat_776949b1:

    # mom "Y antes de que me saquéis más secretos, deberíamos bajar a la piscina. *Risa*"
    mom "Et avant que vous ne me demandiez d'autres secrets, on devrait aller à la piscine. *Rires*"

# game/scripts/c22/c22.rpy:942
translate french c22s002_EmmMarChat_4319dfc6:

    # emm "No te preocupes. Vamos a bajar a yoga. No me gusta ser la última."
    emm "Ne t'inquiète pas. On ira au yoga. Je n'aime pas être la dernière."

# game/scripts/c22/c22.rpy:944
translate french c22s002_EmmMarChat_e01423d2:

    # mc "OK."
    mc "D'ACCORD."

# game/scripts/c22/c22.rpy:959
translate french c22s002_MarAboutEdmund_71fd8ec1:

    # mom "¿Puedes ir bajando, [emm]? Tengo que hablar con [mc]."
    mom "Peux-tu descendre, [emm] ? J'ai besoin de parler à [mc]."

# game/scripts/c22/c22.rpy:961
translate french c22s002_MarAboutEdmund_007c9d1b:

    # emm "¿Me tengo que ir?"
    emm "Je dois y aller?"

# game/scripts/c22/c22.rpy:963
translate french c22s002_MarAboutEdmund_bd555d5e:

    # mom "Es algo que tengo que hablar con [mc] en privado, [emm]."
    mom "C'est quelque chose dont je dois discuter en privé avec [mc], [emm]."

# game/scripts/c22/c22.rpy:966
translate french c22s002_MarAboutEdmund_0bc1ca38:

    # emm "¿Qué pusiste en el grupo de WhatsUp ayer? Que, si nos estamos convirtiendo en una familia, lo podemos hablar todo, ¿no?"
    emm "Qu'as-tu posté hier dans le groupe WhatsApp ? Que si on devient une famille, on peut parler de tout, c'est ça ?"

# game/scripts/c22/c22.rpy:967
translate french c22s002_MarAboutEdmund_9cbc62e6:

    # mc "No sé de lo que quiere hablar pero, si quiere hablarlo en privado, creo que se lo debemos."
    mc "Je ne sais pas de quoi il veut parler, mais s'il souhaite en discuter en privé, je pense que nous lui devons cela."

# game/scripts/c22/c22.rpy:969
translate french c22s002_MarAboutEdmund_807334c2:

    # mom "[mc] tiene razón. Lo que tengo que preguntarle le afecta principalmente a él."
    mom "[mc] a raison. Ce que je dois lui demander le concerne principalement."

# game/scripts/c22/c22.rpy:970
translate french c22s002_MarAboutEdmund_d9faa267:

    # mom "A ti también, pero de otra forma. Y contigo también lo hablaré en su momento, y en privado."
    mom "À toi aussi, mais différemment. Je t'en parlerai en temps voulu, en privé."

# game/scripts/c22/c22.rpy:973
translate french c22s002_MarAboutEdmund_b6de5149:

    # mom "Y antes de que protestes, esta es una de esas cosas que se tienen que hablar en privado."
    mom "Et avant de protester, sachez que c'est une de ces choses qui doivent être discutées en privé."

# game/scripts/c22/c22.rpy:975
translate french c22s002_MarAboutEdmund_e26fbe29:

    # emm "Tenéis razón... Entonces voy a ir bajando a la piscina. Os dejo solos."
    emm "Tu as raison… Alors je descends à la piscine. Je vous laisse tous les deux."

# game/scripts/c22/c22.rpy:977
translate french c22s002_MarAboutEdmund_25780dba:

    # "Cuando [emm] se ha ido..."
    "Quand [emm] disparaît..."

# game/scripts/c22/c22.rpy:978
translate french c22s002_MarAboutEdmund_79e0d6b9:

    # mc "Dime. Parece serio..."
    mc "Dites-moi. Vous avez l'air sérieux..."

# game/scripts/c22/c22.rpy:979
translate french c22s002_MarAboutEdmund_c3709e18:

    # mom "Lo es. ¿Recuerdas cuando, durante la reunión con [aar], dijiste que habías hablado con tu padre?"
    mom "Oui. Vous souvenez-vous, lors de votre rencontre avec [aar], quand vous avez dit avoir parlé avec votre père ?"

# game/scripts/c22/c22.rpy:980
translate french c22s002_MarAboutEdmund_d216a60c:

    # mom "Me había olvidado por completo, han pasado tantas cosas desde aquel día..."
    mom "J'avais complètement oublié, il s'est passé tellement de choses depuis ce jour-là..."

# game/scripts/c22/c22.rpy:982
translate french c22s002_MarAboutEdmund_07b00d0d:

    # mom "Hoy, cuando me he levantado, me ha venido como un flash."
    mom "Aujourd'hui, au réveil, ça m'est apparu comme un éclair."

# game/scripts/c22/c22.rpy:983
translate french c22s002_MarAboutEdmund_8e8c81f2:

    # mom "Parece que hayan pasado un par de meses en vez de... ¿cuántos días han pasado?"
    mom "J'ai l'impression que deux mois se sont écoulés au lieu de... combien de jours exactement ?"

# game/scripts/c22/c22.rpy:984
translate french c22s002_MarAboutEdmund_c451d65a:

    # mc "Cinco días. Fue el jueves."
    mc "Cinq jours. C'était jeudi."

# game/scripts/c22/c22.rpy:986
translate french c22s002_MarAboutEdmund_3ee8d882:

    # mom "Vale. En cinco días no has tenido tiempo de explicármelo, ¿verdad?"
    mom "D'accord. Vous n'avez pas eu le temps de me l'expliquer en cinq jours, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:987
translate french c22s002_MarAboutEdmund_cfd530ab:

    # mc "[Mom!t], para mí también han pasado un montón de cosas. No hemos tenido un momento para hablarlo."
    mc "[Mom!t], il m'est arrivé beaucoup de choses aussi. Nous n'avons pas eu le temps d'en parler."

# game/scripts/c22/c22.rpy:989
translate french c22s002_MarAboutEdmund_e742ee60:

    # mom "Tienes razón... Hablar de tu padre saca lo peor de mí."
    mom "Tu as raison… Parler de ton père fait ressortir le pire en moi."

# game/scripts/c22/c22.rpy:990
translate french c22s002_MarAboutEdmund_bd4e3e65:

    # mom "Explícame por qué y cómo estás en contacto con él."
    mom "Expliquez-moi pourquoi et comment vous êtes en contact avec lui."

# game/scripts/c22/c22.rpy:991
translate french c22s002_MarAboutEdmund_971ed953:

    # mc "Lo primero es decirte que, aunque parezca raro, creo que lo que me ha contado es verdad."
    mc "Avant toute chose, je tiens à vous dire que, même si cela peut paraître étrange, je crois que ce qu'il m'a dit est vrai."

# game/scripts/c22/c22.rpy:993
translate french c22s002_MarAboutEdmund_c55d8317:

    # mom "No sé qué te habrá contado, pero no entiendo cómo puedes creerte nada de lo que diga."
    mom "Je ne sais pas ce qu'il vous a dit, mais je ne comprends pas comment vous pouvez croire un seul mot de ce qu'il dit."

# game/scripts/c22/c22.rpy:994
translate french c22s002_MarAboutEdmund_ce178841:

    # mc "Porque no tendría sentido negar algo para admitir algo más... importante."
    mc "Car il serait absurde de nier quelque chose pour admettre quelque chose de plus… important."

# game/scripts/c22/c22.rpy:995
translate french c22s002_MarAboutEdmund_9e5894d4:

    # mom "Sigue."
    mom "Continue."

# game/scripts/c22/c22.rpy:996
translate french c22s002_MarAboutEdmund_7f143e4c:

    # mc "Papá está en Bali. Cuando se fue de aquí fue a Aruba y después se fue a Bali."
    mc "Papa est à Bali. Quand il est parti d'ici, il est allé à Aruba puis à Bali."

# game/scripts/c22/c22.rpy:998
translate french c22s002_MarAboutEdmund_5457ef21:

    # mom "Destinos tropicales donde estar con su amante y todo el dinero que nos robó a nosotros y a la universidad."
    mom "Des destinations tropicales où il pourra être avec sa maîtresse et tout l'argent qu'il nous a volé, à nous et à l'université."

# game/scripts/c22/c22.rpy:999
translate french c22s002_MarAboutEdmund_9363335e:

    # mom "Bien, típico de él."
    mom "Eh bien, c'est bien son genre."

# game/scripts/c22/c22.rpy:1000
translate french c22s002_MarAboutEdmund_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c22/c22.rpy:1002
translate french c22s002_MarAboutEdmund_0335912f:

    # mom "¡Vale! Ya me callo."
    mom "D'accord ! Je me tais maintenant."

# game/scripts/c22/c22.rpy:1003
translate french c22s002_MarAboutEdmund_7a11157b:

    # mc "La chica con la que se fugó no es su amante. Era una estudiante a la que estaba ayudando a instalarse en el hotel."
    mc "La jeune fille avec laquelle il s'est enfui n'était pas sa compagne. C'était une étudiante qu'il aidait à s'installer à l'hôtel."

# game/scripts/c22/c22.rpy:1004
translate french c22s002_MarAboutEdmund_41bd3e1b:

    # mc "Ella le ayudó a instalarse en Aruba, ya que tenía amigos allí. Ahora está en Canadá de nuevo."
    mc "Elle l'a aidé à s'installer à Aruba, car elle y avait des amis. Elle est maintenant de retour au Canada."

# game/scripts/c22/c22.rpy:1006
translate french c22s002_MarAboutEdmund_e666e107:

    # mom "¿Y dices que le crees?"
    mom "Et vous dites que vous le croyez ?"

# game/scripts/c22/c22.rpy:1007
translate french c22s002_MarAboutEdmund_b063e33a:

    # mc "Sí, [Mom!t]. Le creo. Después llegaré a eso. Pero eso no lo convierte en un santo."
    mc "Oui, [Mom!t]. Je le crois. J'y reviendrai plus tard. Mais cela ne fait pas de lui un saint."

# game/scripts/c22/c22.rpy:1009
translate french c22s002_MarAboutEdmund_f1ab759f:

    # mom "¿Pero por qué se fue entonces? ¿Para ocultar sus delitos?"
    mom "Mais pourquoi est-il parti alors ? Pour dissimuler ses crimes ?"

# game/scripts/c22/c22.rpy:1010
translate french c22s002_MarAboutEdmund_9270d653:

    # mc "Es más complicado que eso. NTR nos vigilaba a todos. [eva] y [ama] evitaban que se acercaran a vosotros, pero nadie evitaba que se acercaran a él."
    mc "C'est plus compliqué que ça. NTR nous observait tous. [eva] et [ama] les ont empêchés de t'approcher, mais personne ne les a empêchés de l'approcher."

# game/scripts/c22/c22.rpy:1011
translate french c22s002_MarAboutEdmund_790c5a38:

    # mc "Y él los descubrió, pero no sabía quieres eran. En el fondo no era tan mal jefe de seguridad."
    mc "Il les découvrit, mais il ignorait qui ils étaient. Au fond, il n'était pas si mauvais chef de la sécurité."

# game/scripts/c22/c22.rpy:1012
translate french c22s002_MarAboutEdmund_6cbc2468:

    # mc "Supongo que se cruzó con los que lo seguían a él y con los que os seguían a vosotras. Cuando se produjo el incendio en la universidad creía que habían querido matarlo."
    mc "J'imagine qu'il a croisé la route de ceux qui le suivaient et de ceux qui vous suivaient. Quand l'incendie s'est déclaré à l'université, j'ai cru qu'ils avaient essayé de le tuer."

# game/scripts/c22/c22.rpy:1014
translate french c22s002_MarAboutEdmund_6b6c6d80:

    # mom "¿Por qué iban a querer matarlo? Él no tiene nada que ver con NTR."
    mom "Pourquoi voudraient-ils le tuer ? Il n'a rien à voir avec le NTR."

# game/scripts/c22/c22.rpy:1015
translate french c22s002_MarAboutEdmund_c41a6026:

    # mc "No sabía que eran de NTR. Para él eran dos gemelos. Ahora sabemos que eran clones de la Serie G, y que había más de dos."
    mc "J'ignorais qu'ils venaient de NTR. Pour lui, c'étaient des jumeaux. On sait maintenant qu'il s'agissait de clones de la série G, et qu'il y en avait plus de deux."

# game/scripts/c22/c22.rpy:1016
translate french c22s002_MarAboutEdmund_915c2f40:

    # mc "Pero él no tenía ni idea. Sabía que el incendio iba a descubrir sus robos a la universidad, con lo que cogió nuestro dinero y se fue."
    mc "Mais il n'en avait aucune idée. Il savait que l'incendie révélerait ses vols à l'université, alors il a pris notre argent et il est parti."

# game/scripts/c22/c22.rpy:1018
translate french c22s002_MarAboutEdmund_052a37b2:

    # mom "Bueno... no lo cogió todo..."
    mom "Bon... il n'a pas tout attrapé..."

# game/scripts/c22/c22.rpy:1019
translate french c22s002_MarAboutEdmund_350aef84:

    # mc "¿Cuánto dejó? Me dijiste que se había llevado vuestros ahorros."
    mc "Combien a-t-il laissé ? Tu m'as dit qu'il avait pris tes économies."

# game/scripts/c22/c22.rpy:1020
translate french c22s002_MarAboutEdmund_679a5359:

    # mom "Dejó el fondo de la universidad de [emm]. Y dinero para un par de meses de gastos. Se llevó el resto."
    mom "Il a laissé son argent de poche pour ses études. Et de quoi couvrir quelques mois de dépenses. Il a pris le reste."

# game/scripts/c22/c22.rpy:1021
translate french c22s002_MarAboutEdmund_244237fe:

    # mc "Eso encaja más con su historia."
    mc "Cela correspond mieux à son histoire."

# game/scripts/c22/c22.rpy:1023
translate french c22s002_MarAboutEdmund_b9c8723c:

    # mc "Como te decía, se fue a Aruba a esconderse. Y sabes quién está en Aruba, ¿verdad?"
    mc "Comme je le disais, il est allé se cacher à Aruba. Et vous savez qui est à Aruba, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:1026
translate french c22s002_MarAboutEdmund_7d994328:

    # mom "NTR. Se fue huyendo de ellos y no pudo elegir peor sitio."
    mom "NTR. Il a fui et n'aurait pas pu choisir un pire endroit."

# game/scripts/c22/c22.rpy:1027
translate french c22s002_MarAboutEdmund_8cd01924:

    # mc "Exacto. A los pocos días se cruzó con otros Serie G. Creía que le habían seguido hasta allí y se fue a Bali."
    mc "Exactement. Quelques jours plus tard, il a croisé d'autres voitures de la série G. Il a pensé qu'elles l'avaient suivi jusque-là et étaient parties pour Bali."

# game/scripts/c22/c22.rpy:1028
translate french c22s002_MarAboutEdmund_76523aff:

    # mc "En Indonesia no hay extradición a Estados Unidos y creía que \"los gemelos\" no le seguirían hasta allí. Y, obviamente, no le han seguido."
    mc "L'Indonésie n'autorise pas l'extradition vers les États-Unis, et il pensait que « les jumeaux » ne le suivraient pas là-bas. Et, de toute évidence, ils ne l'ont pas fait."

# game/scripts/c22/c22.rpy:1031
