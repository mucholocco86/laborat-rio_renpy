translate french c22s004_ScaPatch_ae866916:

    # "[sca] se dirige hacia ti y [emm]. Te apartas para dejarle un hueco entre ambos, que ocupa para sorpresa de todo el mundo."
    "[sca] se dirige vers vous et [emm]. Vous vous écartez pour laisser un espace entre vous, qu'il occupe à la surprise générale."

# game/scripts/c22/c22.rpy:2880
translate french c22s004_ScaPatch_21c2e29a:

    # todas "{b}¿QUÉ?{/b}"
    todas "{b}QUOI ?{/b}"

# game/scripts/c22/c22.rpy:2881
translate french c22s004_ScaPatch_c1e2b664:

    # "Tan solo [mar] evita la cara de sorpresa."
    "[mar] évite simplement l'air surpris."

# game/scripts/c22/c22.rpy:2882
translate french c22s004_ScaPatch_06b5d63f:

    # "[ama] y [eva] sabían que buscabas a una hermana, pero no sabían quién era."
    "[ama] et [eva] savaient que vous cherchiez une sœur, mais ils ne savaient pas qui elle était."

# game/scripts/c22/c22.rpy:2884
translate french c22s004_ScaPatch_cc30ddd6:

    # "[dap] ignora la pregunta que está en la boca de casi todas las mujeres y sigue hablando como si nada hubiera pasado."
    "[dap] ignore la question qui est sur les lèvres de presque toutes les femmes et continue de parler comme si de rien n'était."

# game/scripts/c22/c22.rpy:2885
translate french c22s004_ScaPatch_27fe9f16:

    # dap "Bienvenida oficialmente a la familia, [sca]. Ahora eres una Marks de pleno derecho."
    dap "Bienvenue officiellement dans la famille, [sca]. Tu es désormais un Marks à part entière."

# game/scripts/c22/c22.rpy:2887
translate french c22s004_ScaPatch_cad353ae:

    # mom "Ven aquí, cielo."
    mom "Viens ici, mon amour."

# game/scripts/c22/c22.rpy:2888
translate french c22s004_ScaPatch_cc349d22:

    # "[mar] se acerca a [sca], ignorando las caras de sorpresa del resto de mujeres, y se funde en un abrazo con la chica a medio camino."
    "[mar] s'approche de [sca], ignorant les visages surpris des autres femmes, et se fond dans une étreinte avec la fille à mi-chemin."

# game/scripts/c22/c22.rpy:2889
translate french c22s004_ScaPatch_5409146d:

    # mom "Bienvenida a la familia, cariño."
    mom "Bienvenue dans la famille, chérie."

# game/scripts/c22/c22.rpy:2891
translate french c22s004_ScaPatch_6d953712:

    # mee "¿Qué está pasando aquí?"
    mee "Que se passe-t-il ici ?"

# game/scripts/c22/c22.rpy:2893
translate french c22s004_ScaPatch_f3b02d0c:

    # "[dap] decide pasar a un segundo plano. Ella ha puesto los cimientos para esta situación."
    "[dap] décide de se mettre en retrait. Elle a préparé le terrain pour cette situation."

# game/scripts/c22/c22.rpy:2894
translate french c22s004_ScaPatch_bd0c6666:

    # "Pero contar la verdad podría ser muy humillante para [mar]. No es algo a lo que tenga derecho."
    "Mais dire la vérité pourrait être très humiliant pour [mar]. Ce n'est pas quelque chose qu'elle a le droit de faire."

# game/scripts/c22/c22.rpy:2896
translate french c22s004_ScaPatch_a6a34926:

    # "[sca] está demasiado abrumada para hablar. El desarrollo del \"experimento de [dap]\" la ha dejado con las emociones a flor de piel."
    "[sca] est trop bouleversée pour parler. Le déroulement de l'« expérience [dap] » l'a profondément marquée."

# game/scripts/c22/c22.rpy:2897
translate french c22s004_ScaPatch_187b6314:

    # "Tú tampoco puedes dar las explicaciones por las mismas razones que [dap]. Te alegras de haber tenido la conversación con [mar] por la mañana."
    "Vous ne pouvez pas non plus donner d'explications, pour les mêmes raisons que [dap]. Vous êtes content d'avoir eu cette conversation avec [mar] ce matin."

# game/scripts/c22/c22.rpy:2899
translate french c22s004_ScaPatch_b6bed2ee:

    # mar "[sca] es la hija de Edmund. Me engañó hace años y este es el resultado."
    mar "[sca] est la fille d'Edmund. Il m'a piégé il y a des années et voilà le résultat."

# game/scripts/c22/c22.rpy:2901
translate french c22s004_ScaPatch_c322422b:

    # todas "¿QUÉ?"
    todas "QUE?"

# game/scripts/c22/c22.rpy:2903
translate french c22s004_ScaPatch_cdf1519b:

    # mar "Sí, lleva años siendo un cabrón, por lo visto, pero..."
    mar "Oui, apparemment, c'est un salaud depuis des années, mais..."

# game/scripts/c22/c22.rpy:2904
translate french c22s004_ScaPatch_82f9c8e3:

    # mar "No creía que pudiera pensar esto, pero [sca] es un regalo que ha llegado a casa con retraso, aunque lo hemos tenido delante todos estos años."
    mar "Je ne pensais pas pouvoir penser cela, mais [sca] est un cadeau qui est arrivé tard, même si nous l'avions sous les yeux depuis toutes ces années."

# game/scripts/c22/c22.rpy:2906
translate french c22s004_ScaPatch_75d74da8:

    # mar "Cielo, no eres mi hija, pero... ¿me permitirías ejercer de madre?"
    mar "Chérie, tu n'es pas ma fille, mais... me permettrais-tu de jouer le rôle de ta mère ?"

# game/scripts/c22/c22.rpy:2907
translate french c22s004_ScaPatch_f7b54a42:

    # sca "No podría tener una madre mejor, [mar]."
    sca "Je ne pourrais pas avoir une meilleure mère, [mar]."

# game/scripts/c22/c22.rpy:2909
translate french c22s004_ScaPatch_c9c66e1d:

    # emm "¿Puedo abrazar a mi nueva hermana?"
    emm "Puis-je serrer ma nouvelle sœur dans mes bras ?"

# game/scripts/c22/c22.rpy:2911
translate french c22s004_ScaPatch_48d5b831:

    # emm "Dos hermanas nuevas en una semana. Al final me voy a hacer un lío..."
    emm "Deux nouvelles sœurs en une semaine. Je vais être complètement déboussolée..."

# game/scripts/c22/c22.rpy:2912
translate french c22s004_ScaPatch_2d7e9c6d:

    # emm "Bienvenida a casa, hermanita."
    emm "Bienvenue à la maison, petite sœur."

# game/scripts/c22/c22.rpy:2913
translate french c22s004_ScaPatch_c051dd51:

    # sca "Gracias, [emm]. Me alegra muchísimo que seas mi hermana."
    sca "Merci, [emm]. Je suis si heureuse que tu sois ma sœur."

# game/scripts/c22/c22.rpy:2915
translate french c22s004_ScaPatch_64313a6f:

    # "El resto os vais turnando para abrazar a [sca]. Dándole la bienvenida a la familia."
    "Vous autres, à tour de rôle, vous embrassez [sca], en l'accueillant dans la famille."

# game/scripts/c22/c22.rpy:2917
translate french c22s004_ScaPatch_08a6e81d:

    # "Sienta tan bien quitarse los secretos de encima..."
    "Quel soulagement de se débarrasser de tous ses secrets..."

# game/scripts/c22/c22.rpy:2918
translate french c22s004_ScaPatch_a6c1761f:

    # "[dap] envía un mensaje al grupo de WhatsUp mientras el resto de las chicas acaban de abrazar a [sca]."
    "[dap] envoie un message au groupe WhatsUp tandis que les autres filles viennent de serrer [sca] dans leurs bras."

# game/scripts/c22/c22.rpy:2919
translate french c22s004_ScaPatch_adfcbf79:

    # "El resto de la familia también tiene derecho a saber la verdad."
    "Le reste de la famille a également le droit de connaître la vérité."

# game/scripts/c22/c22.rpy:2925
translate french c22s004_ScaUnPatch_92dacd4e:

    # sca "¿Qué?"
    sca "Que?"

# game/scripts/c22/c22.rpy:2927
translate french c22s004_ScaUnPatch_3cf8b728:

    # dap "Ven aquí. *Risa* Parezco una gaviota idiota con el ala levantada."
    dap "Viens ici. *Rires* J'ai l'air d'une mouette idiote avec l'aile levée."

# game/scripts/c22/c22.rpy:2929
translate french c22s004_ScaUnPatch_c1a59b8a:

    # sca "*Susurrando* ¿De qué va esto?"
    sca "*Chuchotant* De quoi s'agit-il ?"

# game/scripts/c22/c22.rpy:2930
translate french c22s004_ScaUnPatch_87041c3e:

    # dap "Calla y escucha."
    dap "Silence et écoute."

# game/scripts/c22/c22.rpy:2933
translate french c22s004_ScaUnPatch_4951328c:

    # dap "Os habéis dado cuenta de que, menos con [lis] y [deb.nick], y con Tía [bet] y la abuela, el resto de las parejas de hermanos no lo son de sangre, ¿verdad?"
    dap "Vous avez remarqué que, mis à part [lis] et [deb.nick], et tante [bet] et grand-mère, le reste des paires de frères et sœurs ne sont pas des parents de sang, n'est-ce pas ?"

# game/scripts/c22/c22.rpy:2935
translate french c22s004_ScaUnPatch_03e2ab71:

    # dap "Os habéis dado cuenta con los ejemplos de [eva] y [ama] de que no es necesario compartir genes para ser hermanas."
    dap "Vous avez constaté, à partir des exemples de [eva] et [ama], qu’il n’est pas nécessaire de partager des gènes pour être sœurs."

# game/scripts/c22/c22.rpy:2936
translate french c22s004_ScaUnPatch_90b541cb:

    # todas "Sí."
    todas "Ouais."

# game/scripts/c22/c22.rpy:2939
translate french c22s004_ScaUnPatch_d42c5c3b:

    # dap "He estado hablando estos días con mi madre sobre nuestro parentesco legal."
    dap "J'ai discuté avec ma mère ces derniers jours de notre filiation légale."

# game/scripts/c22/c22.rpy:2940
translate french c22s004_ScaUnPatch_ccc4a29c:

    # dap "Ni siquiera soy adoptada. Ni siquiera es mi madre legalmente."
    dap "Je ne suis même pas adoptée. Elle n'est même pas ma mère légale."

# game/scripts/c22/c22.rpy:2941
translate french c22s004_ScaUnPatch_8c7306ee:

    # dap "¿Alguien pone en duda que [nor] sea mi madre?"
    dap "Quelqu'un doute-t-il que [nor] soit ma mère ?"

# game/scripts/c22/c22.rpy:2943
translate french c22s004_ScaUnPatch_664969f4:

    # dap "Pero nadie duda de que sean hermanas. O de que [eva] sea mi hermana."
    dap "Mais personne ne doute qu'elles soient sœurs. Ni que [eva] soit ma sœur."

# game/scripts/c22/c22.rpy:2944
translate french c22s004_ScaUnPatch_c425aa82:

    # todas "No."
    todas "Non."

# game/scripts/c22/c22.rpy:2947
translate french c22s004_ScaUnPatch_4e4e916b:

    # mee "Yo lo hice durante años. Ya no."
    mee "Je l'ai fait pendant des années. Plus maintenant."

# game/scripts/c22/c22.rpy:2949
translate french c22s004_ScaUnPatch_29c985f9:

    # mee "Es tu hermana y es mi nieta perdida."
    mee "C'est ta sœur et c'est ma petite-fille perdue de vue depuis longtemps."

# game/scripts/c22/c22.rpy:2952
translate french c22s004_ScaUnPatch_17168897:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por Mi Abuela\"?"
    dap "D'accord, mamie. Ou devrais-je dire « Madame qui fait semblant d'être ma grand-mère » ?"

# game/scripts/c22/c22.rpy:2954
translate french c22s004_ScaUnPatch_951671e8:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por La Abuela de [eva] y [ama]\"?"
    dap "D'accord, grand-mère. Ou devrais-je dire « Madame qui fait semblant d'être la grand-mère de [eva] et [ama] » ?"

# game/scripts/c22/c22.rpy:2957
translate french c22s004_ScaUnPatch_a698cdd3:

    # mee "*Risa* Ni se te ocurra. Soy tu abuela te guste o no."
    mee "*Rires* N'y pense même pas. Je suis ta grand-mère, que ça te plaise ou non."

# game/scripts/c22/c22.rpy:2959
translate french c22s004_ScaUnPatch_ea73dd64:

    # mee "*Risa* Ni se te ocurra. Soy su abuela les guste o no."
    mee "*Rires* N'y pense même pas. Je suis leur grand-mère, qu'ils le veuillent ou non."

# game/scripts/c22/c22.rpy:2960
translate french c22s004_ScaUnPatch_4a7779fa:

    # mee "Y, si quieren, también puedo serlo para cualquier chica que necesite una abuela."
    mee "Et, si vous le souhaitez, je peux aussi être une grand-mère pour toute petite fille qui en a besoin."

# game/scripts/c22/c22.rpy:2961
translate french c22s004_ScaUnPatch_c8ee8ea5:

    # mee "No hago galletas, por cierto."
    mee "Au fait, je ne fais pas de biscuits."

# game/scripts/c22/c22.rpy:2962
translate french c22s004_ScaUnPatch_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c22/c22.rpy:2964
translate french c22s004_ScaUnPatch_550ac64e:

    # dap "¿Puedo continuar? Gracias."
    dap "Puis-je continuer ? Merci."

# game/scripts/c22/c22.rpy:2965
translate french c22s004_ScaUnPatch_ff63ea89:

    # dap "A lo que me refiero es a que esta familia es rara. Se ha creado a través de mentiras, secretos, y clonaciones."
    dap "Ce que je veux dire, c'est que cette famille est étrange. Elle a été créée à partir de mensonges, de secrets et de clonage."

# game/scripts/c22/c22.rpy:2966
translate french c22s004_ScaUnPatch_797171cd:

    # dap "¿Pero alguien duda de que sea una familia?"
    dap "Mais quelqu'un doute-t-il qu'ils forment une famille ?"

# game/scripts/c22/c22.rpy:2967
translate french c22s004_ScaUnPatch_c425aa82_1:

    # todas "No."
    todas "Non."

# game/scripts/c22/c22.rpy:2969
translate french c22s004_ScaUnPatch_90cb866e:

    # deb "Es una familia increíble, [dap]. Los lazos de sangre importan menos que la voluntad de ser una familia."
    deb "C'est une famille formidable. Les liens du sang comptent moins que la volonté d'être une famille."

# game/scripts/c22/c22.rpy:2970
translate french c22s004_ScaUnPatch_1f3ae072:

    # lis "Si leyera esto en un libro, no me lo creería. Vivirlo es totalmente diferente."
    lis "Si je lisais ça dans un livre, je n'y croirais pas. Le vivre, c'est complètement différent."

# game/scripts/c22/c22.rpy:2972
translate french c22s004_ScaUnPatch_fb14b4c6:

    # dap "Eso es exactamente lo que quiero decir."
    dap "C'est exactement ce que je veux dire."

# game/scripts/c22/c22.rpy:2973
translate french c22s004_ScaUnPatch_4901efbe:

    # dap "Me da lo mismo lo que piense la gente de fuera de la familia."
    dap "Je me fiche de ce que pensent les gens en dehors de la famille."

# game/scripts/c22/c22.rpy:2974
translate french c22s004_ScaUnPatch_b487daa7:

    # dap "Me da lo mismo lo que digan las leyes."
    dap "Je me fiche de ce que disent les lois."

# game/scripts/c22/c22.rpy:2977
translate french c22s004_ScaUnPatch_49550204:

    # dap "Si [nor] es mi madre porque elegimos que lo sea..."
    dap "Si [nor] est ma mère parce que nous l'avons choisie comme telle..."

# game/scripts/c22/c22.rpy:2978
translate french c22s004_ScaUnPatch_d8503a7a:

    # dap "Si [mee] es mi abuela porque así lo hemos decidido..."
    dap "Si [mee] est ma grand-mère parce que nous l'avons décidé ainsi..."

# game/scripts/c22/c22.rpy:2980
translate french c22s004_ScaUnPatch_36b275d9:

    # dap "Si [ama] y [eva] son de la familia porque elegimos que lo sean..."
    dap "Si [ama] et [eva] sont de la même famille parce que nous les avons choisis comme tels..."

# game/scripts/c22/c22.rpy:2981
translate french c22s004_ScaUnPatch_dc19810b:

    # dap "Si la abuela es también su abuela porque así lo han decidido..."
    dap "Si la grand-mère est aussi leur grand-mère parce qu'ils l'ont décidé ainsi..."

# game/scripts/c22/c22.rpy:2982
translate french c22s004_ScaUnPatch_35ae7fab:

    # mc "Y porque si no, seguramente sí que nos haría esas galletas y nos obligaría a comerlas como tortura."
    mc "Et sinon, il nous préparerait sûrement ces biscuits et nous obligerait à les manger comme une torture."

# game/scripts/c22/c22.rpy:2983
translate french c22s004_ScaUnPatch_b3b94564_1:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c22/c22.rpy:2985
translate french c22s004_ScaUnPatch_8364dc4d:

    # dap "Bueno, pues una vez establecida la premisa..."
    dap "Eh bien, une fois ce postulat établi..."

# game/scripts/c22/c22.rpy:2986
translate french c22s004_ScaUnPatch_6998dd2e:

    # dap "He decidido que [sca] es mi hermana."
    dap "J'ai décidé que [sca] est ma sœur."

# game/scripts/c22/c22.rpy:2988
translate french c22s004_ScaUnPatch_9d49d5cf:

    # dap "Joder, me ha quedado totalmente anticlimático con tantas interrupciones."
    dap "Mince alors, avec toutes ces interruptions, c'est une vraie déception."

# game/scripts/c22/c22.rpy:2990
translate french c22s004_ScaUnPatch_7dbc2656:

    # mee "¡Ese lenguaje, señorita! Como tu abuela no te dejo usarlo."
    mee "Ce langage, mademoiselle ! Comme votre grand-mère, je ne vous permets pas de l'utiliser."

# game/scripts/c22/c22.rpy:2991
translate french c22s004_ScaUnPatch_b3b94564_2:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c22/c22.rpy:2992
translate french c22s004_ScaUnPatch_f994bd47:

    # mee "Y a ti tampoco, [sca], antes de que preguntes. Quiero que mis nietas hablen como señoritas bien educadas."
    mee "Et vous non plus, [sca], avant même que vous ne posiez la question. Je souhaite que mes petites-filles parlent comme de jeunes filles bien élevées."

# game/scripts/c22/c22.rpy:2994
translate french c22s004_ScaUnPatch_4ebbfbb7:

    # sca "..."
    sca "..."

# game/scripts/c22/c22.rpy:2996
translate french c22s004_ScaUnPatch_490df30a:

    # sca "Gracias, [dap.nick]..."
    sca "Merci, [dap.nick]..."

# game/scripts/c22/c22.rpy:2997
translate french c22s004_ScaUnPatch_1504d153:

    # dap "Es lo menos que podía hacer. Sabes que te considero mi hermana. Ahora lo saben todos."
    dap "C'est la moindre des choses. Tu sais que je te considère comme ma sœur. Maintenant, tout le monde le sait."

# game/scripts/c22/c22.rpy:2999
translate french c22s004_ScaUnPatch_61677265:

    # eri "[dap], ¿puedes dejar de monopolizar a mi hermana? Yo también quiero abrazarla."
    eri "[dap], peux-tu arrêter de monopoliser ma sœur ? Je veux la serrer dans mes bras aussi."

# game/scripts/c22/c22.rpy:3001
translate french c22s004_ScaUnPatch_b4b3c095:

    # sca "Me vais a hacer llorar..."
    sca "Tu vas me faire pleurer..."

# game/scripts/c22/c22.rpy:3002
translate french c22s004_ScaUnPatch_d31d2ea0:

    # eri "Yo llevaría un rato llorando. Ya sabes que soy muy llorona, y lo que ha dicho [dap] es muy bonito."
    eri "Je pleurerais un bon moment. Tu sais que je suis une vraie pleurnicheuse, et ce que [dap] a dit était vraiment adorable."

# game/scripts/c22/c22.rpy:3004
translate french c22s004_ScaUnPatch_b851f5fa:

    # "El resto os vais turnando para abrazar a [sca]. Todas dicen algo que la hace sentir querida."
    "Vous autres, vous prenez chacun votre tour pour embrasser [sca]. Chacun dit quelque chose qui lui fait sentir qu'elle est aimée."

# game/scripts/c22/c22.rpy:3006
translate french c22s004_ScaUnPatch_923f197c:

    # "[sca] ha pasado de tener una madre de mierda a tener dos madres y dos abuelas maravillosas. Y un montón de hermanas."
    "[sca] est passée d'une mère exécrable à deux mères et deux grands-mères merveilleuses. Et une ribambelle de sœurs."

# game/scripts/c22/c22.rpy:3009
translate french c22s004_hugs_d8a24664:

    # "La escena te recuerda mucho a la fiesta de la piscina, cuando [mee] contó su secreto sobre el cáncer."
    "La scène rappelle beaucoup la fête à la piscine, lorsque [mee] a révélé son secret concernant son cancer."

# game/scripts/c22/c22.rpy:3010
translate french c22s004_hugs_5dc73603:

    # "No podrías estar más orgulloso de tu familia."
    "Vous ne pourriez pas être plus fier de votre famille."

# game/scripts/c22/c22.rpy:3019
translate french c22s004_BetCallsBishop_bea50ff2:

    # bet "Lo que pasa en esta familia es increíble."
    bet "Ce qui se passe dans cette famille est incroyable."

# game/scripts/c22/c22.rpy:3020
translate french c22s004_BetCallsBishop_9ef0ffa9:

    # mc "Pero es para sentirse orgulloso de formar parte de ella."
    mc "Mais c'est quelque chose dont on peut être fier de faire partie."

# game/scripts/c22/c22.rpy:3021
translate french c22s004_BetCallsBishop_2e68811e:

    # mc "El día menos pensado, pasará un perro callejero por delante de casa y le diremos \"Tú también eres de la familia\"."
    mc "Un jour, sans prévenir, un chien errant passera devant notre maison et nous lui dirons : « Toi aussi, tu fais partie de la famille. »"

# game/scripts/c22/c22.rpy:3022
translate french c22s004_BetCallsBishop_c0d47adb:

    # mc "Y que conste que no estoy comparando a [sca] con un perro callejero. Se merece formar parte de esta familia."
    mc "Et que ce soit clair : je ne compare pas [sca] à un chien errant. Il mérite de faire partie de cette famille."

# game/scripts/c22/c22.rpy:3025
translate french c22s004_BetCallsBishop_dea11c03:

    # bet "Claro que sí. Es tu hermana. Y aunque no lo fuera, esa chica es adorable y necesita una familia que la quiera."
    bet "Bien sûr que si. C'est ta sœur. Et même si ce n'était pas le cas, cette petite fille est adorable et mérite une famille qui l'aime."

# game/scripts/c22/c22.rpy:3026
translate french c22s004_BetCallsBishop_13dcbbbf:

    # mc "Sí, es sorprendente lo adorable que es con la mierda de padres que tiene."
