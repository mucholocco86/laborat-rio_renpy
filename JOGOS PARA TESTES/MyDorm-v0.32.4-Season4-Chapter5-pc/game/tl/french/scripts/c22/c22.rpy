    # ama "¡Ah, no! Ya las he recogido yo. Me había olvidado..."
    ama "Oh non ! Je les ai déjà pris. J'avais oublié…"

# game/scripts/c22/c22.rpy:2256
translate french c22s004_EveNoRoute_cd149d43:

    # eva "Has dicho prima y no novia."
    eva "Tu as dit cousine, pas petite amie."

# game/scripts/c22/c22.rpy:2260
translate french c22s004_EveNoRoute_66b2c48a:

    # eva "Supongo que no te refieres a lo que haces con [dap.nick] y [eri.nick]..."
    eva "Je suppose que vous ne faites pas référence à ce que vous faites avec [dap.nick] et [eri.nick]..."

# game/scripts/c22/c22.rpy:2262
translate french c22s004_EveNoRoute_380047ea:

