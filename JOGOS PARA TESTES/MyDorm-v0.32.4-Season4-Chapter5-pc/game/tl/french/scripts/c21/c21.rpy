

# game/scripts/c21/c21.rpy:24
translate french c21s001_FoursomeWhatIf_d6b32481:

    # "Hay una escena con [eri], [dap], y [emm], pero no estás en ruta con las tres simultáneamente."
    "Il y a une scène avec [eri], [dap] et [emm], mais vous n'êtes pas en route avec les trois simultanément."

# game/scripts/c21/c21.rpy:127
translate french c21s001_Foursome_ffbf891b:

    # "Al volver a tu habitación..."
    "Lorsque vous retournerez dans votre chambre..."

# game/scripts/c21/c21.rpy:129
translate french c21s001_Foursome_d72364f0:

    # emm "¡Has tardado muchísimo en volver!"
    emm "Tu as mis une éternité à revenir !"

# game/scripts/c21/c21.rpy:130
translate french c21s001_Foursome_433f4a0f:

    # dap "Estábamos a punto de irnos. Menos mal que has llegado ahora."
    dap "Nous étions sur le point de partir. Heureusement que vous êtes arrivés maintenant."

# game/scripts/c21/c21.rpy:132
translate french c21s001_Foursome_54f0ebc1:

    # eri "Creíamos que te ibas a quedar a dormir en casa de [mad.nick]."
    eri "Nous pensions que tu allais passer la nuit chez [mad.nick]."

# game/scripts/c21/c21.rpy:134
translate french c21s001_Foursome_37fa3aff:

    # eri "O de llamarte para saber si te había pasado algo."
    eri "Ou pour vous appeler afin de savoir si quelque chose vous est arrivé."

# game/scripts/c21/c21.rpy:137
translate french c21s001_Foursome_b90d68d2:

    # emm "Veníamos a por nuestros regalos de cumpleaños, pero has tardado tanto que se nos han pasado las ganas."
    emm "Nous étions venus chercher nos cadeaux d'anniversaire, mais vous avez tellement tardé que nous avons perdu tout intérêt."

# game/scripts/c21/c21.rpy:139
translate french c21s001_Foursome_b8113d19:

    # eri "Las tres nos habíamos comprado esta lencería tan bonita para darte una sorpresa..."
    eri "Nous avions acheté toutes les trois cette magnifique lingerie pour te faire la surprise..."

# game/scripts/c21/c21.rpy:141
translate french c21s001_Foursome_c5491be0:

    # dap "Pero después de una hora esperándote... mejor nos vamos..."
    dap "Mais après t'avoir attendu pendant une heure... il vaut mieux y aller..."

# game/scripts/c21/c21.rpy:142
translate french c21s001_Foursome_d9f214b9:

    # mc "Chicas, tenía que llevar a [mad.nick]..."
    mc "Les filles, j'ai dû prendre [mad.nick]..."

# game/scripts/c21/c21.rpy:144
translate french c21s001_Foursome_309e5c9d:

    # mc "Y al volver me he encontrado con [kia] abajo..."
    mc "Et à mon retour, j'ai trouvé [kia] en bas..."

# game/scripts/c21/c21.rpy:147
translate french c21s001_Foursome_d04b2885:

    # emm "Es decir, tus otras novias antes que nosotras, ¿no?"
    emm "Donc, tes autres copines avant nous, c'est ça ?"

# game/scripts/c21/c21.rpy:149
translate french c21s001_Foursome_609962f8:

    # emm "Es decir, el resto de las chicas antes que nosotras, ¿no?"
    emm "Donc, les autres filles qui nous ont précédées, c'est bien ça ?"

# game/scripts/c21/c21.rpy:150
translate french c21s001_Foursome_398bcaed:

    # eri "Esperábamos más de ti, [mc]."
    eri "Nous attendions plus de vous, [mc]."

# game/scripts/c21/c21.rpy:151
translate french c21s001_Foursome_e3a61a1a:

    # dap "Nos has decepcionado."
    dap "Vous nous avez déçus."

# game/scripts/c21/c21.rpy:152
translate french c21s001_Foursome_deff457d:

    # mc "¡Pero si ni siquiera sabía que estabais aquí!"
    mc "Mais je ne savais même pas que tu étais là !"

# game/scripts/c21/c21.rpy:155
translate french c21s001_Foursome_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c21/c21.rpy:156
translate french c21s001_Foursome_d1199fbd:

    # mcp "(¡Son casi las 2:00 AM! Cuidado con la puerta o vais a despertar a alguien.)"
    mcp "(Il est presque 2h du matin ! Faites attention à la porte, vous allez réveiller quelqu'un.)"

# game/scripts/c21/c21.rpy:157
translate french c21s001_Foursome_c5efcdc6:

    # eri "*A través de la puerta* *Susurrando* ¡[emm]! ¡Vas a despertar a [sai] y a [meg]!"
    eri "*À travers la porte* *Chuchotant* [emm]! Tu vas te réveiller [sai] [meg]!"

# game/scripts/c21/c21.rpy:158
translate french c21s001_Foursome_9bc4801a:

    # emm "*A través de la puerta* *Susurrando* Lo siento... me he metido demasiado en mi papel. *Risita*"
    emm "*À travers la porte* *Chuchotant* Je suis désolée… Je me suis un peu trop prise au jeu. *Rires*"

# game/scripts/c21/c21.rpy:159
translate french c21s001_Foursome_3dd07e34:

    # dap "*A través de la puerta* *Susurrando* Chicas, ¿creéis que se lo ha creído?"
    dap "*À travers la porte* *Chuchotant* Les filles, vous pensez qu'il y a cru ?"

# game/scripts/c21/c21.rpy:160
translate french c21s001_Foursome_b9031dcc:

    # mcp "(En cinco minutos están de vuelta... como mucho cinco minutos. Voy a ir desnudándome.)"
    mcp "(Ils seront de retour dans cinq minutes... cinq minutes maximum. Je vais commencer à me déshabiller.)"

# game/scripts/c21/c21.rpy:161
translate french c21s001_Foursome_bdf9f113:

    # emm "*A través de la puerta* *Susurrando* ¡Por supuesto! En diez segundos abrirá la puerta para venir a buscarnos."
    emm "*À travers la porte* *Chuchotant* Bien sûr ! Dans dix secondes, il ouvrira la porte pour venir nous chercher."

# game/scripts/c21/c21.rpy:162
translate french c21s001_Foursome_62228065:

    # eri "*A través de la puerta* *Susurrando* No estoy segura. Ya han pasado diez segundos. Creo que sabe que estábamos de broma."
    eri "*À travers la porte* *Chuchotant* Je ne suis pas sûr. Ça fait déjà dix secondes. Je crois qu'il sait qu'on plaisantait."

# game/scripts/c21/c21.rpy:163
translate french c21s001_Foursome_28ac3415:

    # dap "*A través de la puerta* *Susurrando* Eso nos pasa por hacer caso a los planes de [emm]. Ya os he dicho que era un plan de mierda. Debe estar muy cansado."
    dap "*À travers la porte* *Chuchotant* Voilà ce qui arrive quand on écoute les plans de [emm]. Je te l'avais dit, c'était un plan pourri. Il doit être vraiment épuisé."

# game/scripts/c21/c21.rpy:164
translate french c21s001_Foursome_9502c5d8:

    # emm "*A través de la puerta* *Susurrando* ¡Hey! El plan era bueno... ¿Habéis visto la cara que ha puesto?"
    emm "*À travers la porte* *Chuchotant* Hé ! Le plan était bon… Tu as vu sa tête ?"

# game/scripts/c21/c21.rpy:165
translate french c21s001_Foursome_7d7341c2:

    # dap "*A través de la puerta* *Susurrando* Imaginaos que decide darnos tiempo para que se nos pase el \"enfado\". Sería muy típico de él."
    dap "*À travers la porte* *Chuchotant* Imaginez qu'il décide de nous laisser le temps de nous calmer. Ce serait tout à fait son genre."

# game/scripts/c21/c21.rpy:166
translate french c21s001_Foursome_60605bc9:

    # emm "*A través de la puerta* *Susurrando* ¿Volvemos?"
    emm "*À travers la porte* *Chuchotant* On rentre ?"

# game/scripts/c21/c21.rpy:167
translate french c21s001_Foursome_39f3b792:

    # eri "*A través de la puerta* *Susurrando* Vamos antes de que se duerma."
    eri "*À travers la porte* *Chuchotant* Allons-y avant qu'elle ne s'endorme."

# game/scripts/c21/c21.rpy:169
translate french c21s001_Foursome_cc59538f:

    # mc "Hola de nuevo, chicas. *Risa*"
    mc "Salut les filles ! *Rires*"

# game/scripts/c21/c21.rpy:171
translate french c21s001_Foursome_5095615f:

    # emm "¿Sabías que íbamos a volver?"
    emm "Saviez-vous que nous allions revenir ?"

# game/scripts/c21/c21.rpy:172
translate french c21s001_Foursome_54eb101d:

    # mc "¡Por supuesto! Dudo que hayáis venido vestidas así todo el camino atravesando la planta de las estudiantes."
    mc "Bien sûr ! Je doute que vous soyez restée habillée comme ça tout le long dans le bâtiment étudiant."

# game/scripts/c21/c21.rpy:173
translate french c21s001_Foursome_1ba58714:

    # mc "Y dudo que fuerais a volver a vuestras habitaciones así."
    mc "Et je doute que vous soyez retournés dans vos chambres comme ça."

# game/scripts/c21/c21.rpy:175
translate french c21s001_Foursome_1ed30e3d:

    # eri "Es cierto, no habíamos contado con eso. Las batas están en el armario."
    eri "C'est exact, nous n'y avions pas pensé. Les peignoirs sont dans le placard."

# game/scripts/c21/c21.rpy:176
translate french c21s001_Foursome_6f14276a:

    # mc "Además, creo que han escuchado vuestros susurros desde San Francisco. *Risa*"
    mc "D'ailleurs, je crois qu'ils ont entendu vos chuchotements jusqu'à San Francisco. *Rires*"

# game/scripts/c21/c21.rpy:178
translate french c21s001_Foursome_deef0111:

    # dap "¡No hablábamos tan alto! Y si nos escuchabas, ¿por qué no has salido a buscarnos?"
    dap "Nous ne parlions pas si fort ! Et si vous pouviez nous entendre, pourquoi n'êtes-vous pas sortis pour nous chercher ?"

# game/scripts/c21/c21.rpy:179
translate french c21s001_Foursome_60d8fbac:

    # mc "Me estaba preparando para cuando volvierais. *Risa*"
    mc "Je me préparais à ton retour. *Rires*"

# game/scripts/c21/c21.rpy:181
translate french c21s001_Foursome_fb5a2e67:

    # eri "Y no nos has dejado abrir nuestro regalo como castigo, ¿no? *Risa*"
    eri "Et vous ne nous avez pas laissé ouvrir nos cadeaux en guise de punition, n'est-ce pas ? *Rires*"

# game/scripts/c21/c21.rpy:182
translate french c21s001_Foursome_8c28168a:

    # mc "Nunca os castigaría por intentar hacer una broma. Ni por ninguna otra cosa, para ser sincero. Tan solo os he ahorrado tiempo. *Risa*"
    mc "Je ne te punirais jamais pour avoir essayé de faire une blague. Ni pour quoi que ce soit d'autre, à vrai dire. Je t'ai juste fait gagner du temps. *Rires*"

# game/scripts/c21/c21.rpy:184
translate french c21s001_Foursome_a2f3101f:

    # dap "Sobre el papel, lo de plantarnos las tres en tu habitación parecía una buena idea, pero ahora no sé por dónde empezar..."
    dap "Sur le papier, l'idée que nous nous présentions tous les trois dans ta chambre semblait bonne, mais maintenant je ne sais pas par où commencer..."

# game/scripts/c21/c21.rpy:185
translate french c21s001_Foursome_8c649f98:

    # mc "¿Qué tal si venís aquí y vamos descubriéndolo?"
    mc "Et si tu venais ici et qu'on le découvrait ?"

# game/scripts/c21/c21.rpy:186
translate french c21s001_Foursome_70e29f35:

    # mc "Me ha sorprendido un poco veros aquí, pero es casi un sueño hecho realidad."
    mc "J'étais un peu surpris de vous voir ici, mais c'est presque un rêve devenu réalité."

# game/scripts/c21/c21.rpy:189
translate french c21s001_Foursome_259c23ba:

    # dap "Después de lo que ha pasado en la partida de DnD... tú ponías caras, pero nosotras nos podíamos imaginar..."
    dap "Après ce qui s'est passé dans la partie de D&D... vous faisiez des grimaces, mais on pouvait imaginer..."

# game/scripts/c21/c21.rpy:191
translate french c21s001_Foursome_c453c2b1:

    # dap "Al menos en mi cabeza, el trío con Aelia, Vilfredo, y Paula ha sido super caliente."
    dap "Du moins, dans mon imagination, le plan à trois avec Aelia, Vilfredo et Paula était super excitant."

# game/scripts/c21/c21.rpy:192
translate french c21s001_Foursome_d00e1eab:

    # mc "Os entiendo. A mí me ha pasado lo mismo."
    mc "Je comprends. La même chose m'est arrivée."

# game/scripts/c21/c21.rpy:195
translate french c21s001_Foursome_c353d4c9:

    # dap "Después de lo que ha pasado en la partida de DnD... de haber rechazado a Beagan..."
    dap "Après ce qui s'est passé dans la partie de D&D... après avoir rejeté Beagan..."

# game/scripts/c21/c21.rpy:196
translate french c21s001_Foursome_083d2918:

    # dap "Hemos pensado que si no lo hubieras hecho, quizás hubiera acabado con las cuatro en la cama de Vilfredo."
    dap "Nous pensions que si tu ne l'avais pas fait, nous aurions peut-être tous les quatre fini dans le lit de Vilfredo."

# game/scripts/c21/c21.rpy:198
translate french c21s001_Foursome_43f2fa1c:

    # emm "Para que después digan que DnD no sirve de nada. *Risa*"
    emm "Et après ils disent que D&D ne sert à rien. *Rires*"

# game/scripts/c21/c21.rpy:199
translate french c21s001_Foursome_af076395:

    # emm "Cuando te has ido a llevar a [mad.nick], casi nos hemos peleado por quién venía a verte. *Risita*"
    emm "Quand tu es venu chercher [mad.nick], on a failli se disputer pour savoir qui allait te voir. *Rires*"

# game/scripts/c21/c21.rpy:201
translate french c21s001_Foursome_fcace866:

    # eri "Si no hubiera sido por la partida, lo hubiéramos echado a suertes, pero después de jugar... hemos decidido venir las tres."
    eri "Sans ce jeu, nous aurions tiré au sort, mais après avoir joué... nous avons décidé que nous viendraient tous les trois."

# game/scripts/c21/c21.rpy:203
translate french c21s001_Foursome_7bcff052:

    # mc "No quiero sonar desagradecido o avaricioso, pero ¿[sca] no se ha querido unir?"
    mc "Je ne veux pas paraître ingrat ou avide, mais vous n'avez pas voulu vous joindre à nous ?"

# game/scripts/c21/c21.rpy:205
translate french c21s001_Foursome_558c177b:

    # dap "Se lo hemos propuesto, pero ha dicho que era nuestro cumpleaños..."
    dap "Nous le lui avons suggéré, mais il a dit que c'était notre anniversaire..."

# game/scripts/c21/c21.rpy:207
translate french c21s001_Foursome_c59c26f9:

    # dap "Y que quiere mantener las distancias hasta el martes."
    dap "Et qu'il souhaite maintenir la distanciation sociale jusqu'à mardi."

# game/scripts/c21/c21.rpy:209
translate french c21s001_Foursome_dd893afc:

    # emm "No lo he entendido. ¿Qué pasa el martes?"
    emm "Je n'ai pas compris. Que se passe-t-il mardi ?"

# game/scripts/c21/c21.rpy:210
translate french c21s001_Foursome_fc1578f6:

    # mcp "(Que llegan los resultados del test de ADN.)"
    mcp "(Les résultats du test ADN arrivent.)"

# game/scripts/c21/c21.rpy:213
translate french c21s001_Foursome_c79b9725:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Mais minuit est passé, la fête d'anniversaire est terminée."

# game/scripts/c21/c21.rpy:216
translate french c21s001_Foursome_9f91f5c6:

    # dap "Sexo de cumpleaños, y esas cosas. *Risita*"
    dap "Du sexe pour son anniversaire, et des trucs comme ça. *Rires*"

# game/scripts/c21/c21.rpy:218
translate french c21s001_Foursome_c79b9725_1:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Mais minuit est passé, la fête d'anniversaire est terminée."

# game/scripts/c21/c21.rpy:220
translate french c21s001_Foursome_c82eb9fb:

    # eri "Hoy, aunque sea lunes, todavía es nuestro cumpleaños, al menos el de [dap] y el mío."
    eri "Aujourd'hui, même si c'est lundi, c'est quand même notre anniversaire, du moins celui de [dap] et le mien."

# game/scripts/c21/c21.rpy:222
translate french c21s001_Foursome_4b42ed68:

    # emm "Lo siento, chicas, a veces me olvido... especialmente cuando vuestro cumpleaños es después del domingo de la fiesta."
    emm "Désolée les filles, il m'arrive d'oublier... surtout quand votre anniversaire est après la fête du dimanche."

# game/scripts/c21/c21.rpy:223
translate french c21s001_Foursome_e5270572:

    # mc "No le des más vueltas, [emm]. Son cosas que pasan. Le dais tanta importancia a la fiesta del domingo que olvidáis cuándo son los cumpleaños oficiales."
    mc "N'y pense pas trop. Ça arrive. Tu accordes tellement d'importance à la fête de dimanche que tu en oublies les dates officielles des anniversaires."

# game/scripts/c21/c21.rpy:226
translate french c21s001_Foursome_1033a870:

    # eri "Sobre eso... sabes que me han encantado los pendientes, pero quiero mi regalo de cumpleaños de verdad."
    eri "À ce propos... tu sais que j'ai adoré les boucles d'oreilles, mais je veux mon vrai cadeau d'anniversaire."

# game/scripts/c21/c21.rpy:228
translate french c21s001_Foursome_273c7378:

    # mc "*Risa* No sé a lo que te refieres... pero veo que no llevas los pendientes."
    mc "*Rires* Je ne sais pas ce que vous voulez dire... mais je vois que vous ne portez pas de boucles d'oreilles."

# game/scripts/c21/c21.rpy:233
translate french c21s001_Foursome_b9731cb0:

    # eri "No estoy acostumbrada a llevarlos aún. Después de cambiarme me los he quitado."
    eri "Je n'ai pas encore l'habitude de les porter. Je les ai enlevées après m'être changée."

# game/scripts/c21/c21.rpy:234
translate french c21s001_Foursome_fcc40a71:

    # emm "¡Ve a por él, [eri]!"
    emm "Vas-y, [eri] !"

# game/scripts/c21/c21.rpy:235
translate french c21s001_Foursome_b36f1535:

    # "Después de un largo día, los ojos te pican un poco y las luces te molestan. Esperas que no vaya a ser un problema para disfrutar de la noche."
    "Après une longue journée, vos yeux vous piquent un peu et la lumière vous gêne. Vous espérez que cela ne vous empêchera pas de profiter de votre soirée."

# game/scripts/c21/c21.rpy:238
translate french c21s001_Foursome_06999336:

    # eri "Y en cuanto a mi regalo, me refiero a esto..."
    eri "Quant à mon cadeau, je veux dire ceci..."

# game/scripts/c21/c21.rpy:241
translate french c21s001_Foursome_c734993d:

    # "[eri] se sienta a horcajadas en tu regazo y empieza un maravilloso beso."
    "[eri] s'assoit à califourchon sur vos genoux et commence un merveilleux baiser."

# game/scripts/c21/c21.rpy:242
translate french c21s001_Foursome_9dbf5877:

    # "El tiempo de los besos a escondidas ha pasado después de la Gran Revelación y los dos os sentís liberados de la presión de mantener el secreto."
    "Après la Grande Révélation, le temps des baisers secrets est révolu et vous vous sentez tous deux libérés de la pression du secret."

# game/scripts/c21/c21.rpy:243
translate french c21s001_Foursome_96bcc3e2:

    # "Vuestros labios se rozan, vuestras lenguas se entrelazan, vuestros alientos se entremezclan."
    "Vos lèvres se frôlent, vos langues s'entrelacent, vos souffles se mêlent."

# game/scripts/c21/c21.rpy:246
translate french c21s001_Foursome_58c5e4a6:

    # emm "Nosotras también queremos nuestra ración de [mc]."
    emm "Nous aussi, nous voulons notre part de [mc]."

# game/scripts/c21/c21.rpy:248
translate french c21s001_Foursome_2761fc71:

    # dap "No seas impaciente, [emm]. Tenemos toda la noche para compartir a [mc]."
    dap "Ne sois pas impatient, [emm]. Nous avons toute la nuit à partager [mc]."

# game/scripts/c21/c21.rpy:250
translate french c21s001_Foursome_93d797d6:

    # eri "Todo vuestro, al menos durante un rato. *Risa* Voy a querer más."
    eri "Tout à toi, du moins pour un temps. *Rires* J'en voudrai plus."

# game/scripts/c21/c21.rpy:252
translate french c21s001_Foursome_11a6afa6:

    # "[emm] te tumba en la cama y empieza un delicioso beso"
    "[emm] Il te couche sur le lit et commence un délicieux baiser"

# game/scripts/c21/c21.rpy:254
translate french c21s001_Foursome_79ef90b6:

    # "Al que no tarda en unirse [dap]."
    "Qui sera bientôt rejoint par [dap]."

# game/scripts/c21/c21.rpy:256
translate french c21s001_Foursome_77b9c9b2:

    # "Ambas se van turnando, en un baile casi sincronizado, por una vez sin discutir entre ellas."
    "Ils se relaient, dans une danse presque synchronisée, pour une fois sans se disputer."

# game/scripts/c21/c21.rpy:257
translate french c21s001_Foursome_6b92b5b5:

    # "Un baile complicado donde sus cabezas están a punto de chocar más de una vez entre ellas."
    "Une danse complexe où leurs têtes sont sur le point de se heurter plus d'une fois."

# game/scripts/c21/c21.rpy:260
translate french c21s001_Foursome_c0ad023a:

    # "Puedes notar cómo [eri] no se queda inactiva mientras su hermana y su prima te besan."
    "Vous pouvez remarquer que [eri] ne reste pas inactive pendant que sa sœur et sa cousine vous embrassent."

# game/scripts/c21/c21.rpy:262
translate french c21s001_Foursome_f156274e:

    # "Puedes notar cómo [eri] no se queda inactiva mientras las otras dos mujeres te besan."
    "Vous pouvez remarquer que [eri] ne reste pas inactive pendant que les deux autres femmes vous embrassent."

# game/scripts/c21/c21.rpy:263
translate french c21s001_Foursome_0d9b1752:

    # eri "Tu pierna me molesta, [emm]. Creo que vuestros besos lo han dejado preparado para nosotras."
    eri "Ta jambe me gêne, [emm]. Je crois que tes baisers nous y ont préparés."

# game/scripts/c21/c21.rpy:264
translate french c21s001_Foursome_38d826de:

    # emm "Ya estaba así cuando te has levantado de su regazo. *Risita*"
    emm "Elle était déjà comme ça quand tu t'es levé de ses genoux. *Rires*"

# game/scripts/c21/c21.rpy:265
translate french c21s001_Foursome_b7817f99:

