# game/scripts/c21/c21.rpy:1653
translate french c21s002_MarChat_b4d1f2ec:

    # mom "Ahora deberías irte a buscar a [meg] o vais a llegar tarde."
    mom "Maintenant, tu devrais aller trouver [meg] sinon tu seras en retard."

# game/scripts/c21/c21.rpy:1657
translate french c21s002_MarChat_61ac67b1:

    # mom "Hasta luego, mi amor."
    mom "À plus tard, mon amour."

# game/scripts/c21/c21.rpy:1659
translate french c21s002_MarChat_c966101d:

    # mc "Hasta luego, Mamá."
    mc "À plus tard, maman."

# game/scripts/c21/c21.rpy:1662
translate french c21s002_MarChat_fd0b2265:

    # mc "Hasta luego, mi vida."
    mc "Au revoir, mon amour."

# game/scripts/c21/c21.rpy:1664
translate french c21s002_MarChat_5aec6711:

    # mc "Hasta luego, [mar]."
    mc "À plus tard, [mar]."

# game/scripts/c21/c21.rpy:1677
translate french c21s002_Megan_04fc0305:

    # "Después de recoger a [meg] en su habitación y llevarla a la estación de autobuses..."
    "Après avoir récupéré [meg] dans sa chambre et l'avoir conduite à la gare routière..."

# game/scripts/c21/c21.rpy:1678
translate french c21s002_Megan_3c65a76f:

    # mc "¿Qué tal lo has pasado el fin de semana?"
    mc "Comment s'est passé votre week-end ?"

# game/scripts/c21/c21.rpy:1679
translate french c21s002_Megan_d15af0eb:

    # meg "Ha sido genial. Me lo he pasado muy bien y ha sido fantástico conocer a todo el mundo."
    meg "C'était génial. J'ai passé un très bon moment et c'était fantastique de rencontrer tout le monde."

# game/scripts/c21/c21.rpy:1680
translate french c21s002_Megan_c24435be:

    # mc "¿Te sientes más a gusto ahora, después de la fiesta de cumpleaños?"
    mc "Vous sentez-vous plus à l'aise maintenant, après la fête d'anniversaire ?"

# game/scripts/c21/c21.rpy:1682
translate french c21s002_Megan_bd07e85a:

    # meg "No me la imaginaba así. Con lo locos que estáis todos, esperaba algo más salvaje. Fue bastante tranquila."
    meg "Je ne l'imaginais pas comme ça. Vu votre côté déjanté, je m'attendais à quelque chose de plus extravagant. C'était plutôt calme."

# game/scripts/c21/c21.rpy:1683
translate french c21s002_Megan_3567414e:

    # mc "Creo que la parte más salvaje estuvo en el jacuzzi. Las chicas se lo pasaron muy bien."
    mc "Je crois que le moment le plus fou s'est passé dans le jacuzzi. Les filles se sont éclatées."

# game/scripts/c21/c21.rpy:1685
translate french c21s002_Megan_6fcafd80:

    # meg "Bueno, Jamaal también se puso muy salvaje cuando tú te fuiste. *Risa* Y no me refiero solo a su capacidad para comer."
    meg "Eh bien, Jamaal a fait une crise de nerfs quand tu es parti. *Rires* Et je ne parle pas seulement de son appétit."

# game/scripts/c21/c21.rpy:1686
translate french c21s002_Megan_03b871f3:

    # meg "Empezó a contar chistes sobre todo el mundo, menos [mad.nick] y las estudiantes. Supongo que aún no tiene suficiente material."
    meg "Il a commencé à raconter des blagues sur tout le monde sauf sur [mad.nick] et les étudiants. Je suppose qu'il n'a pas encore assez de matériel."

# game/scripts/c21/c21.rpy:1687
translate french c21s002_Megan_1fee9104:

    # mc "Es un monologuista frustrado. *Risa* Por eso le dejo hablar solo muchas veces."
    mc "C'est un humoriste frustré. *Rires* C'est pour ça que je le laisse souvent parler tout seul."

# game/scripts/c21/c21.rpy:1689
translate french c21s002_Megan_388d91bd:

    # meg "*Risa* Sois tal para cual. Me encanta cómo os metéis el uno con el otro. Se nota que os queréis."
    meg "*Rires* Vous êtes faits l'un pour l'autre. J'adore la façon dont vous vous taquinez. On voit que vous tenez l'un à l'autre."

# game/scripts/c21/c21.rpy:1690
translate french c21s002_Megan_08b7f981:

    # mc "Ya sabes que es el deber de cualquier amo querer a su mascota. *Risa*"
    mc "Vous savez bien que c'est le devoir de tout propriétaire d'aimer son animal de compagnie. *Rires*"

# game/scripts/c21/c21.rpy:1692
translate french c21s002_Megan_a92ae0ce:

    # meg "¿Ves? A eso me refiero. *Risa*"
    meg "Vous voyez ? C'est ce que je veux dire. *Rires*"

# game/scripts/c21/c21.rpy:1693
translate french c21s002_Megan_cfc7a130:

    # mc "Hablando de cosas más serias. ¿Cuándo vuelves? ¿Vendrás el próximo fin de semana también?"
    mc "Plus sérieusement, quand reviens-tu ? Seras-tu là le week-end prochain aussi ?"

# game/scripts/c21/c21.rpy:1695
translate french c21s002_Megan_d5787976:

    # meg "Trabajo hasta el miércoles en Westport y empiezo el viernes aquí de nuevo."
    meg "Je travaille jusqu'à mercredi à Westport et je reprends ici vendredi."

# game/scripts/c21/c21.rpy:1696
translate french c21s002_Megan_481ae79b:

    # meg "[mar] me ha dicho que venga el jueves, pero no estoy segura. Normalmente los jueves los aprovecho para hacer la limpieza en casa."
    meg "Elle m'a dit de venir jeudi, mais je ne suis pas sûre. D'habitude, je fais le ménage le jeudi."

# game/scripts/c21/c21.rpy:1697
translate french c21s002_Megan_052760bc:

    # mc "*Risa* Si no estás en casa no verás si está sucia, y se ensuciará menos."
    mc "*Rires* Si tu n'es pas à la maison, tu ne verras pas si c'est sale, et ça le sera moins."

# game/scripts/c21/c21.rpy:1699
translate french c21s002_Megan_5a02c626:

    # meg "*Risa* ¡Hombres!"
    meg "*Rires* Les hommes !"

# game/scripts/c21/c21.rpy:1701
translate french c21s002_Megan_71dc5177:

    # meg "Ya veremos. El jueves o el viernes estaré de nuevo aquí. Además ya tendré el coche arreglado."
    meg "On verra. Je serai de retour jeudi ou vendredi. De toute façon, ma voiture sera réparée d'ici là."

# game/scripts/c21/c21.rpy:1702
translate french c21s002_Megan_e1b0ccdd:

    # mc "Entonces espero verte el jueves."
    mc "J'espère donc vous voir jeudi."

# game/scripts/c21/c21.rpy:1705
translate french c21s002_Megan_486a9a17:

    # meg "Tú también puedes venir a mi casa, si quieres. Sólo está a 35 minutos."
    meg "Tu peux aussi venir chez moi, si tu veux. C'est à seulement 35 minutes."

# game/scripts/c21/c21.rpy:1706
translate french c21s002_Megan_34c0c949:

    # mc "Si puedo lo haré."
    mc "Si je peux, je le ferai."

# game/scripts/c21/c21.rpy:1707
translate french c21s002_Megan_a08a7190:

    # mc "Esta semana va a ser complicada."
    mc "Cette semaine va être compliquée."

# game/scripts/c21/c21.rpy:1709
translate french c21s002_Megan_bbdca4c9:

    # meg "Lo sé. Tienes lo de [emm] entre las otras miles de cosas que tienes que hacer."
    meg "Je sais. Tu as ce truc [emm] parmi les milliers d'autres choses que tu dois faire."

# game/scripts/c21/c21.rpy:1711
translate french c21s002_Megan_051cbb70:

    # meg "Por allí llega mi autobús."
    meg "Mon bus arrive par là."

# game/scripts/c21/c21.rpy:1716
translate french c21s002_Megan_ab1de559:

    # meg "Te veo el jueves o el viernes. Seguramente el jueves por la noche."
    meg "Je te verrai jeudi ou vendredi. Probablement jeudi soir."

# game/scripts/c21/c21.rpy:1717
translate french c21s002_Megan_afd5ac81:

    # mc "Hasta el jueves, [meg]."
    mc "Jusqu'à jeudi, [meg]."

# game/scripts/c21/c21.rpy:1719
translate french c21s002_Megan_00700b65:

    # "[meg] desaparece en el interior del autobús."
    "[meg] disparaît à l'intérieur du bus."

# game/scripts/c21/c21.rpy:1721
translate french c21s002_Megan_51ef8b47:

    # "Te acabas de dar cuenta de que no lleva la maleta que trajo. ¿Ha dejado ropa en casa?"
    "Vous venez de remarquer qu'elle ne porte pas la valise qu'elle a apportée. Aurait-elle oublié des vêtements chez elle ?"

# game/scripts/c21/c21.rpy:1725
translate french c21s003_NoKiaraDate_79f93db8:

    # "Justo al irse el autobús..."
    "Au moment même où le bus démarrait..."

# game/scripts/c21/c21.rpy:1727
translate french c21s003_NoKiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1731
translate french c21s003_NoKiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Salut, [ama]. Puis-je vous aider ?"

# game/scripts/c21/c21.rpy:1733
translate french c21s003_NoKiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Je voulais juste te rappeler qu'on devait se voir aujourd'hui pour prendre un café et discuter de mes idées sur le NTR. À quelle heure te conviendrait ?"

# game/scripts/c21/c21.rpy:1734
translate french c21s003_NoKiaraDate_2e084d07:

    # mc "Estoy en la estación de autobuses ahora mismo. Como algo rápido y podemos quedar. ¿En 30 minutos te va bien?"
    mc "Je suis à la gare routière. Prends un petit quelque chose à manger et on se retrouve. Ça te va dans 30 minutes ?"

# game/scripts/c21/c21.rpy:1736
translate french c21s003_NoKiaraDate_ed11e94d:

    # ama "Perfecto. Te mando la dirección de un café que tienes cerca y podemos quedar allí."
    ama "Parfait. Je t'enverrai l'adresse d'un café près de chez toi et on pourra s'y retrouver."

# game/scripts/c21/c21.rpy:1737
translate french c21s003_NoKiaraDate_2a5423d0:

    # mc "Genial. Te veo en 30 minutos. Hasta ahora."
    mc "Super. À dans 30 minutes. À tout à l'heure."

# game/scripts/c21/c21.rpy:1738
translate french c21s003_NoKiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Jusqu'à présent, [mc]."

# game/scripts/c21/c21.rpy:1766
translate french c21s003_KiaraDate_7386f7a4:

    # "Llegas a la biblioteca unos minutos antes de la hora a la que has quedado con [kia]."
    "Vous arrivez à la bibliothèque quelques minutes avant l'heure à laquelle vous avez convenu de vous retrouver [kia]."

# game/scripts/c21/c21.rpy:1767
translate french c21s003_KiaraDate_9ae42375:

    # "Pasaste mucho tiempo en tu época del instituto en este edificio."
    "Vous avez passé beaucoup de temps dans ce bâtiment pendant vos années de lycée."

# game/scripts/c21/c21.rpy:1768
translate french c21s003_KiaraDate_b594cfce:

    # "Por un momento dudas si debes entrar o no a buscarla. Decides hacerlo."
    "Vous hésitez un instant à entrer pour la chercher. Vous décidez finalement d'y aller."

# game/scripts/c21/c21.rpy:1770
translate french c21s003_KiaraDate_11283da7:

    # mcp "(Allí está. Se ha cambiado el peinado y se ha puesto un vestido precioso. Creo que el premio a la elegancia de hoy ya tiene dueño.)"
    mcp "(La voilà ! Elle a changé de coiffure et porte une robe magnifique. Je crois que le prix de l'élégance d'aujourd'hui a déjà trouvé sa lauréate.)"

# game/scripts/c21/c21.rpy:1771
translate french c21s003_KiaraDate_6c3c6634:

    # mcp "(Y no soy yo.)"
    mcp "(Et ce n'est pas moi.)"

# game/scripts/c21/c21.rpy:1773
translate french c21s003_KiaraDate_898d49a2:

    # "Te acercas tímidamente al mostrador donde está hablando con la Srta. Walker, la bibliotecaria canadiense de tu época de instituto. De Montreal, crees recordar."
    "Vous vous approchez timidement du comptoir où il discute avec Mme Walker, la bibliothécaire canadienne de vos années de lycée. De Montréal, il vous semble."

# game/scripts/c21/c21.rpy:1774
translate french c21s003_KiaraDate_634d1076:

    # "No sabes cuánto sabe sobre vuestra relación, si es que sabe algo. O de la situación con Solomon."
    "Vous ignorez ce qu'il sait de votre relation, voire s'il sait quoi que ce soit. Ni la situation avec Solomon."

# game/scripts/c21/c21.rpy:1775
translate french c21s003_KiaraDate_68ffd690:

    # mc "Hola, [kia]. Hola..."
    mc "Bonjour, [kia]. Bonjour..."

# game/scripts/c21/c21.rpy:1776
translate french c21s003_KiaraDate_e8747f1d:

    # kia "Hola, [mc]. Te presento a Geneviève, mi jefa. Gen, este es [mc], el sobrino de [nor], de quien te he hablado."
    kia "Salut, [mc]. C'est Geneviève, ma chef. Gen, voici [mc], le neveu de [nor], dont je t'ai parlé."

# game/scripts/c21/c21.rpy:1778
translate french c21s003_KiaraDate_934429e1:

    # gen "Encantada de conocerte, [mc]."
    gen "Enchanté(e), [mc]."

# game/scripts/c21/c21.rpy:1779
translate french c21s003_KiaraDate_2c25e289:

    # mc "Igualmente, Geneviève."
    mc "De même, Geneviève."

# game/scripts/c21/c21.rpy:1780
translate french c21s003_KiaraDate_29d3b3f0:

    # gen "Puedes llamarme Gen."
    gen "Vous pouvez m'appeler Général."

# game/scripts/c21/c21.rpy:1782
translate french c21s003_KiaraDate_a6907f6d:

    # mc "¿Estás lista para irnos?"
    mc "Êtes-vous prêt à partir ?"

# game/scripts/c21/c21.rpy:1783
translate french c21s003_KiaraDate_53dcdf3b:

    # kia "Sí, dame un momento que vaya a por el bolso."
    kia "Oui, donnez-moi un instant pendant que je vais chercher mon sac."

# game/scripts/c21/c21.rpy:1784
translate french c21s003_KiaraDate_8b397a73:

    # mc "Perfecto, te espero aquí."
    mc "Parfait, je t'attendrai ici."

# game/scripts/c21/c21.rpy:1785
translate french c21s003_KiaraDate_b4418a13:

    # kia "Será solo un segundo."
    kia "Ce ne sera qu'une seconde."

# game/scripts/c21/c21.rpy:1787
translate french c21s003_KiaraDate_7cae2efd:

    # gen "Así que [kia] y [eil] se están alojando en tu casa mientras acaban con el problema de termitas, ¿no?"
    gen "Donc [kia] et [eil] restent chez vous pendant qu'ils règlent le problème de termites, c'est bien ça ?"

# game/scripts/c21/c21.rpy:1788
translate french c21s003_KiaraDate_3a42f87c:

    # gen "Les estáis haciendo un favor muy grande."
    gen "Vous leur rendez un immense service."

# game/scripts/c21/c21.rpy:1789
translate french c21s003_KiaraDate_7a642010:

    # mcp "(¿Termitas? Está claro que no le ha contado lo de Solomon.)"
    mcp "(Des termites ? Visiblement, il ne lui a pas parlé de Salomon.)"

# game/scripts/c21/c21.rpy:1790
translate french c21s003_KiaraDate_cfd7f90b:

    # mc "Bueno, no se aloja en mi casa, sino en la de mi tía, [nor]."
    mc "Eh bien, il ne loge pas chez moi, mais chez ma tante, [nor]."

# game/scripts/c21/c21.rpy:1792
translate french c21s003_KiaraDate_12ae6060:

    # gen "Tú y yo nos conocemos, ¿verdad?"
    gen "Nous nous connaissons, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1793
translate french c21s003_KiaraDate_e8944aa2:

    # mc "Pasaba mucho tiempo aquí cuando iba al instituto."
    mc "J'y passais beaucoup de temps quand j'étais au lycée."

# game/scripts/c21/c21.rpy:1795
translate french c21s003_KiaraDate_74fc50ac:

    # gen "*Risa* ¡No llevo tanto tiempo trabajando aquí! Sólo llevo ocho años."
    gen "*Rires* Je ne travaille pas ici depuis si longtemps ! Je ne suis là que depuis huit ans."

# game/scripts/c21/c21.rpy:1796
translate french c21s003_KiaraDate_1752be01:

    # mc "Y hace cuatro yo estudiaba en el instituto de Newport, Srta. Walker. Es posible que no me reconozca."
    mc "Il y a quatre ans, j'étais élève au lycée de Newport, mademoiselle Walker. Vous ne me reconnaîtrez peut-être pas."

# game/scripts/c21/c21.rpy:1797
translate french c21s003_KiaraDate_7b7a8bca:

    # mc "Pasado de peso, con la nariz metida en un libro, con un amigo en silla de ruedas..."
    mc "En surpoids, le nez plongé dans un livre, avec un ami en fauteuil roulant..."

# game/scripts/c21/c21.rpy:1799
translate french c21s003_KiaraDate_aa0f87b2:

    # gen "¿Marks? ¿[mc] Marks? ¡No puede ser!"
    gen "Des notes ? [mc] Des notes ? Pas question !"

# game/scripts/c21/c21.rpy:1800
translate french c21s003_KiaraDate_72f95f2a:

    # mc "Puede ser. Supongo que no me dejé ningún libro por devolver cuando me fui a la universidad. *Risa*"
    mc "Peut-être. Je suppose que je n'ai oublié aucun livre à rendre en partant à l'université. *Rires*"

# game/scripts/c21/c21.rpy:1802
translate french c21s003_KiaraDate_35b065bd:

    # gen "Estoy sorprendida... Un gran cambio..."
    gen "Je suis surpris… Un grand changement…"

# game/scripts/c21/c21.rpy:1803
translate french c21s003_KiaraDate_817b71b9:

    # gen "Y ya no soy la Srta. Walker. Ahora soy la Sra. Sky."
    gen "Et je ne suis plus Mlle Walker. Maintenant, je suis Mme Sky."

# game/scripts/c21/c21.rpy:1804
translate french c21s003_KiaraDate_3e97c86b:

    # mc "Felicidades, Sra. Sky."
    mc "Félicitations, Mme Sky."

# game/scripts/c21/c21.rpy:1806
translate french c21s003_KiaraDate_76b619e2:

    # gen "Puedes seguir llamándome Gen. Ya no eres un adolescente."
    gen "Tu peux toujours m'appeler Gen. Tu n'es plus un adolescent."

# game/scripts/c21/c21.rpy:1807
translate french c21s003_KiaraDate_4003899d:

    # mc "Felicidades, Gen, entonces."
    mc "Félicitations, Gen, alors."

# game/scripts/c21/c21.rpy:1809
translate french c21s003_KiaraDate_efa2a30a:

    # kia "Ya nos podemos ir, [mc]. No lo entretengas, Gen, o tendré que tomarme más tiempo para comer."
    kia "On peut y aller maintenant, [mc]. Ne le retiens pas, Gen, sinon je vais devoir prendre plus de temps pour manger."

# game/scripts/c21/c21.rpy:1810
translate french c21s003_KiaraDate_f9fc42cb:

    # mc "Nos estábamos poniendo al día. Gen y yo nos conocíamos de mi época de rata de biblioteca."
    mc "Nous prenions des nouvelles l'une de l'autre. Gen et moi nous connaissions depuis l'époque où j'étais une grande lectrice."

# game/scripts/c21/c21.rpy:1812
translate french c21s003_KiaraDate_e60a6b7c:

    # mc "Hasta otra, Gen."
    mc "À la prochaine, Général."

# game/scripts/c21/c21.rpy:1813
translate french c21s003_KiaraDate_3357fab1:

    # gen "Hasta otra, [mc]."
    gen "À la prochaine, [mc]."

# game/scripts/c21/c21.rpy:1815
translate french c21s003_KiaraDate_9af56f4c:

    # kia "Vuelvo en una hora... más o menos."
    kia "Je serai de retour dans une heure... plus ou moins."

# game/scripts/c21/c21.rpy:1817
translate french c21s003_KiaraDate_ff564463:

    # kia "¿Dónde has decidido que vayamos a comer?"
    kia "Où as-tu décidé que nous irions manger ?"

# game/scripts/c21/c21.rpy:1818
translate french c21s003_KiaraDate_b2e3f62c:

    # mc "Un restaurante que me ha recomendado Tía [bet]. Es sorprendente que en una semana conozca tantos restaurantes."
    mc "Un restaurant que ma tante [bet] m'a recommandé. C'est incroyable de pouvoir visiter autant de restaurants en une seule semaine."

# game/scripts/c21/c21.rpy:1819
translate french c21s003_KiaraDate_a85a021e:

    # mc "Pero... ¿no hay beso para mí?"
    mc "Mais... n'y a-t-il pas un baiser pour moi ?"

# game/scripts/c21/c21.rpy:1821
translate french c21s003_KiaraDate_2b7a744e:

    # kia "¿Delante de la biblioteca? Es mi puesto de trabajo... Y Gen conoce a Solomon... y..."
    kia "Devant la bibliothèque ? C'est mon lieu de travail… Et Gen connaît Solomon… et…"

# game/scripts/c21/c21.rpy:1822
translate french c21s003_KiaraDate_24a6a742:

    # mc "No te preocupes. Será duro, pero lo entiendo y puedo esperar a cuando llegues a casa."
    mc "Ne t'inquiète pas. Ce sera difficile, mais je comprends et je peux attendre que tu rentres à la maison."

# game/scripts/c21/c21.rpy:1823
translate french c21s003_KiaraDate_ab0752d3:

    # mc "No me gustan los secretos, pero entiendo que no quieras hacer público lo nuestro aún, hasta que se resuelva lo de Solomon."
    mc "Je n'aime pas les secrets, mais je comprends que tu ne souhaites pas encore rendre notre relation publique, tant que la situation avec Solomon n'est pas résolue."

# game/scripts/c21/c21.rpy:1825
translate french c21s003_KiaraDate_f0fc850c:

    # kia "No es que no quiera hacerlo público. Me da lo mismo que la gente sepa que Solomon y yo hemos roto. No voy a volver con él nunca."
    kia "Ce n'est pas que je ne veuille pas le rendre public. Je me fiche que les gens sachent que Solomon et moi avons rompu. Je ne me remettrai jamais avec lui."

# game/scripts/c21/c21.rpy:1826
translate french c21s003_KiaraDate_cce4706b:

    # kia "Pero hace una semana estaba con él y ahora estoy contigo... todo el mundo va a pensar que soy... una zorra que se ha ido con un hombre más joven."
    kia "Mais il y a une semaine, j'étais avec lui et maintenant je suis avec toi… tout le monde va penser que je suis… une salope qui s'est enfuie avec un homme plus jeune."

# game/scripts/c21/c21.rpy:1828
translate french c21s003_KiaraDate_0efd211a:

    # mc "[kia], escúchame. En casa podremos repetir lo de anoche si quieres. Te dije que no teníamos que hacer nada que no quisieras hacer"
    mc "[kia], écoute-moi. On peut refaire ce qu'on a fait hier soir à la maison si tu veux. Je t'ai dit qu'on n'était pas obligés de faire quoi que ce soit contre ton gré."

# game/scripts/c21/c21.rpy:1829
translate french c21s003_KiaraDate_d1a401c8:

    # mc "Y si una de las cosas que no quieres hacer es que te bese delante de la biblioteca, no hay ningún problema."
    mc "Et si l'une des choses que vous ne souhaitez pas faire est qu'il vous embrasse devant la bibliothèque, c'est tout à fait normal."

# game/scripts/c21/c21.rpy:1831
translate french c21s003_KiaraDate_63650acf:

    # mc "No quiero estropear nuestra primera... o segunda cita... por una nimiedad como esta."
    mc "Je ne veux pas gâcher notre premier... ni notre deuxième rendez-vous... pour une chose aussi insignifiante."

# game/scripts/c21/c21.rpy:1832
translate french c21s003_KiaraDate_e36381cf:

    # mc "Estás preciosa, me encanta lo que te has hecho en el pelo y ese color de pintalabios te favorece mucho."
    mc "Tu es magnifique, j'adore ta nouvelle coiffure et la couleur de ton rouge à lèvres te va vraiment bien."

# game/scripts/c21/c21.rpy:1833
translate french c21s003_KiaraDate_eabac296:

    # mc "Voy a tener muchas ocasiones de comerme ese pintalabios, pero sólo si no lo estropeamos hoy."
    mc "J'aurai plein d'occasions de manger ce rouge à lèvres, mais seulement si on ne le gâche pas aujourd'hui."

# game/scripts/c21/c21.rpy:1835
translate french c21s003_KiaraDate_60bfadf0:

    # mc "¿Te parece bien si vamos a comer? Mi idea de una cita no es discutir con una preciosa mujer en la calle ni hacerla sentir mal."
    mc "Ça te dirait d'aller manger ? Pour moi, un rendez-vous, ce n'est pas se disputer avec une belle femme dans la rue ou la faire se sentir mal."

# game/scripts/c21/c21.rpy:1836
translate french c21s003_KiaraDate_7e6a20e0:

    # kia "Vamos... pero no creas que te va a ser fácil estropear hoy. Y menos si, como {b}casi{/b} siempre, aciertas en lo que tienes que decir."
    kia "Allez… mais ne croyez pas que ce sera facile de tout gâcher aujourd’hui. Surtout si, comme presque toujours, vous trouvez les mots justes."

# game/scripts/c21/c21.rpy:1837
translate french c21s003_KiaraDate_f4d8ef39:

    # mc "*Risa* Es un defecto con el que tendrás que lidiar. No acierto siempre, pero sí las suficientes veces."
    mc "*Rires* C'est un défaut avec lequel il faudra composer. Je ne réussis pas toujours, mais assez souvent."

# game/scripts/c21/c21.rpy:1839
translate french c21s003_KiaraDate_44d2b74e:

    # mc "Vamos antes de que se haga más tarde."
    mc "Allons-y avant qu'il ne soit trop tard."

# game/scripts/c21/c21.rpy:1842
translate french c21s003_KiaraDate_040b5c5b:

    # mc "No sé por qué no me imaginé que sería una pizzería, habiéndolo recomendado Tía [bet]."
    mc "Je ne sais pas pourquoi je n'ai pas imaginé que ce serait une pizzeria, après que ma tante [bet] me l'ait recommandée."

# game/scripts/c21/c21.rpy:1843
translate french c21s003_KiaraDate_86dbd28c:

    # kia "*Risa* ¿De verdad es tan adicta a la pizza?"
    kia "*Rires* Est-elle vraiment si accro à la pizza ?"

# game/scripts/c21/c21.rpy:1844
translate french c21s003_KiaraDate_fb71eec9:

    # mc "*Risa* Supongo que la gula es el único pecado que se permite. ¿Y qué mejor que cometerlo con pizza?"
    mc "*Rires* J'imagine que la gourmandise est le seul péché permis. Et quoi de mieux pour se faire plaisir qu'une pizza ?"

# game/scripts/c21/c21.rpy:1846
translate french c21s003_KiaraDate_b424f89a:

    # "Después de que el camarero os siente en una mesa no tan apartada como te hubiera gustado..."
    "Après que le serveur vous ait installé à une table qui n'est pas aussi isolée que vous l'auriez souhaité..."

# game/scripts/c21/c21.rpy:1847
translate french c21s003_KiaraDate_2095de9e:

    # mc "¿Qué te apetece comer?"
    mc "Qu'est-ce qui te fait envie ?"

# game/scripts/c21/c21.rpy:1848
translate french c21s003_KiaraDate_2061c43f:

    # kia "Si por mí fuera, haría como [bet] y pediría una pizza, pero entre el tiempo que van a tardar y lo lenta que soy comiendo, la cita no daría para nada más."
    kia "Si ça ne tenait qu'à moi, je ferais comme [bet] et je commanderais une pizza, mais vu le temps que ça prendrait et ma lenteur à manger, le rendez-vous ne me permettrait rien d'autre."

# game/scripts/c21/c21.rpy:1849
translate french c21s003_KiaraDate_c5db446e:

    # kia "Con lo que creo que pediré esta ensalada. Tiene buena pinta."
    kia "Je pense donc commander cette salade. Elle a l'air bonne."

# game/scripts/c21/c21.rpy:1850
translate french c21s003_KiaraDate_977aa4a9:

    # mc "¿Tienes algún plan para después de comer?"
    mc "Avez-vous des projets pour après le déjeuner ?"

# game/scripts/c21/c21.rpy:1854
translate french c21s003_KiaraDate_c279c58a:

    # kia "Había pensado en dar un paseo antes de volver a la biblioteca... si te apetece."
    kia "Je pensais aller faire un tour avant de retourner à la bibliothèque... si vous voulez."

# game/scripts/c21/c21.rpy:1855
translate french c21s003_KiaraDate_9d638618:

    # mc "Me encantan los paseos contigo. *Risa* Pero no podremos hacer tantas pausas como anoche."
    mc "J'adore me promener avec toi. *Rires* Mais on ne pourra pas faire autant de pauses qu'hier soir."

# game/scripts/c21/c21.rpy:1857
translate french c21s003_KiaraDate_4cb0af9f:

    # kia "*Risa* No me refería a ese tipo de paseo."
    kia "*Rires* Je ne faisais pas référence à ce genre de promenade."

# game/scripts/c21/c21.rpy:1858
translate french c21s003_KiaraDate_4db7ab3b:

    # mc "Lo sé. *Risa* Que sean dos ensaladas, pero no le digas a [mar] que he pedido una ensalada en un restaurante."
    mc "Je sais. *Rires* Prends deux salades, mais ne dis pas à [mar] que j'ai commandé une salade au restaurant."

# game/scripts/c21/c21.rpy:1860
translate french c21s003_KiaraDate_974b0be7:

    # kia "*Risa* ¿Por qué?"
    kia "*Rires* Pourquoi ?"

# game/scripts/c21/c21.rpy:1861
translate french c21s003_KiaraDate_46df123c:

    # mc "No te creería. *Risa* ¿Pagar por algo verde? Orégano o albahaca, sí. Lechuga, quizás, dentro de una hamburguesa. Broccoli, nunca."
    mc "Je ne te croirais pas. *Rires* Payer pour quelque chose de vert ? De l’origan ou du basilic, oui. De la laitue, peut-être, dans un hamburger. Du brocoli, jamais."

# game/scripts/c21/c21.rpy:1863
translate french c21s003_KiaraDate_75b5078a:

    # kia "*Risa* Si fueras hijo mío comerías de todo."
    kia "*Rires* Si tu étais mon fils, tu mangerais tout."

# game/scripts/c21/c21.rpy:1864
translate french c21s003_KiaraDate_9bf7c2c9:

    # mc "*Risa* Prefiero ser tu novio y olvidarme del broccoli."
    mc "*Rires* Je préférerais être ton petit ami et oublier les brocolis."

# game/scripts/c21/c21.rpy:1866
translate french c21s003_KiaraDate_890574b6:

    # kia "Yo también... A lo del novio. No tengo ningún problema con el broccoli."
    kia "Moi aussi… à propos du petit ami. Je n'ai aucun problème avec les brocolis."

# game/scripts/c21/c21.rpy:1868
translate french c21s003_KiaraDate_bae6e3a4:

    # mc "Te cedo mi parte de la producción mundial de broccoli. *Risa* Para que veas que tienes un novio generoso."
    mc "Je te donne ma part de la production mondiale de brocolis. *Rires* Comme ça tu vois que tu as un petit ami généreux."

# game/scripts/c21/c21.rpy:1870
translate french c21s003_KiaraDate_6c944c47:

    # kia "*Risa* Es super generoso de tu parte."
    kia "*Rires* C'est vraiment très généreux de votre part."

# game/scripts/c21/c21.rpy:1871
translate french c21s003_KiaraDate_13c4ada8:

    # mc "¿Sabes que me encanta verte reír?"
    mc "Sais-tu que j'adore te voir rire ?"

# game/scripts/c21/c21.rpy:1873
translate french c21s003_KiaraDate_1fa740fc:

    # kia "Gracias, pero ¿sabes que [eil] me habló de tu costumbre de intentar ruborizarla?"
    kia "Merci, mais sais-tu que [eil] m'a parlé de ton habitude d'essayer de la faire rougir ?"

# game/scripts/c21/c21.rpy:1874
translate french c21s003_KiaraDate_ed8042b5:

    # mc "*Risa* ¡Maldita chivata!"
    mc "*Rires* Sacré mouchard !"

# game/scripts/c21/c21.rpy:1876
translate french c21s003_KiaraDate_31f7727d:

    # kia "¡Devuelve esa mano ahí ahora mismo!"
    kia "Rends-moi cette main immédiatement !"

# game/scripts/c21/c21.rpy:1877
translate french c21s003_KiaraDate_66e26340:

    # mc "*Risa* ¡A tus órdenes!"
    mc "*Rires* À votre service !"

# game/scripts/c21/c21.rpy:1880
translate french c21s003_KiaraDate_82e507c2:

    # kia "*Risa* Ahora que las dos salimos contigo, me ha dado algunos consejos. Y me ha explicado algunos de tus trucos para hacerla sentir bien."
    kia "*Rires* Maintenant qu'on sort toutes les deux avec toi, elle m'a donné quelques conseils. Et elle m'a expliqué certaines de tes astuces pour lui faire plaisir."

# game/scripts/c21/c21.rpy:1882
translate french c21s003_KiaraDate_04b2472b:

    # kia "*Risa* Me ha explicado muchas cosas de cuando salíais juntos. Supongo que quería ponerme en sobre aviso sobre tus viejos trucos para hacerla sentir bien."
    kia "*Rires* Elle m'a raconté plein de choses sur votre relation. Je suppose qu'elle voulait me mettre en garde contre tes vieilles combines pour la charmer."

# game/scripts/c21/c21.rpy:1883
translate french c21s003_KiaraDate_44dc4434:

    # mc "*Risa* Tendré que encontrar trucos nuevos, entonces. La compañía los merece."
    mc "*Rires* Il va falloir que je trouve de nouvelles astuces, alors. L'entreprise le mérite."

# game/scripts/c21/c21.rpy:1885
translate french c21s003_KiaraDate_1432e0f3:

    # kia "¿Puedo serte sincera?"
    kia "Puis-je être honnête avec vous ?"

# game/scripts/c21/c21.rpy:1886
translate french c21s003_KiaraDate_28927394:

    # mc "Siempre."
    mc "Toujours."

# game/scripts/c21/c21.rpy:1888
translate french c21s003_KiaraDate_0578fcb0:

    # kia "Si lo que dices es sincero, no me importa que se lo hayas dicho con anterioridad a mi hija. O a otras mujeres."
    kia "Si ce que vous dites est sincère, cela ne me dérange pas que vous l'ayez déjà dit à ma fille. Ou à d'autres femmes."

# game/scripts/c21/c21.rpy:1889
translate french c21s003_KiaraDate_4ab6eb4e:

    # kia "No quiero que digas cosas que no sientes sólo para hacerme sentir bien, pero tampoco necesito que inventes frases bonitas cada día."
    kia "Je ne veux pas que tu dises des choses que tu ne penses pas juste pour me faire plaisir, mais je n'ai pas non plus besoin que tu inventes de jolies phrases tous les jours."

# game/scripts/c21/c21.rpy:1890
translate french c21s003_KiaraDate_abe63749:

    # kia "Si sientes realmente lo que dices, me va a gustar igualmente."
    kia "Si tu penses vraiment ce que tu dis, ça me plaira quand même."

# game/scripts/c21/c21.rpy:1891
translate french c21s003_KiaraDate_95e51857:

    # mc "Entendido. Entonces... ¿Sabes que me encanta verte reír? *Risa*"
    mc "Compris. Alors… tu sais que j’adore te voir rire ? *Rires*"

# game/scripts/c21/c21.rpy:1893
translate french c21s003_KiaraDate_1e2e1528:

    # kia "*Risa* ¡Idiota!"
    kia "*Rires* Idiot !"

# game/scripts/c21/c21.rpy:1894
translate french c21s003_KiaraDate_a77e5548:

    # mc "*Risa* ¡Hey! Has dicho que podía repetir cosas si era sincero. Y lo he sido. Me encanta verte reír."
    mc "*Rires* Hé ! Tu as dit que je pouvais répéter les choses si j'étais sincère. Et je l'ai été. J'adore te voir rire."

# game/scripts/c21/c21.rpy:1896
translate french c21s003_KiaraDate_12adb927:

    # kia "Y a mí me encanta que me hagas reír..."
    kia "Et j'adore quand tu me fais rire..."

# game/scripts/c21/c21.rpy:1898
translate french c21s003_KiaraDate_b85e53b2:

    # kia "Es tan diferente a cuando iba a comer con Solomon..."
    kia "C'est tellement différent de l'époque où j'allais manger au restaurant avec Solomon..."

# game/scripts/c21/c21.rpy:1899
translate french c21s003_KiaraDate_04f1bee2:

    # mc "¿Solomon? ¿Quién es Solomon? El nombre me suena. Algo de partir un bebé por la mitad, ¿no?"
    mc "Salomon ? Qui est Salomon ? Ce nom me dit quelque chose. Ça a un rapport avec un bébé coupé en deux, non ?"

# game/scripts/c21/c21.rpy:1900
translate french c21s003_KiaraDate_0e916f4b:

    # mc "Pero no eres tan mayor como para haber ido a comer con él... *Risa*"
    mc "Mais tu n'es pas assez âgée pour avoir déjeuné avec lui... *Rires*"

# game/scripts/c21/c21.rpy:1902
translate french c21s003_KiaraDate_0c1f5e70:

    # kia "*Risa* Realmente eres idiota. Me acabas de llamar vieja en nuestra segunda cita."
    kia "*Rires* Tu es vraiment un idiot. Tu m'as traitée de vieille dès notre deuxième rendez-vous."

# game/scripts/c21/c21.rpy:1903
translate french c21s003_KiaraDate_0f5ad404:

    # mc "¡Oops! El chiste se me ha ido de las manos."
    mc "Oups ! Cette blague a dérapé."

# game/scripts/c21/c21.rpy:1905
translate french c21s003_KiaraDate_c96dfcd9:

    # kia "Sé que no está bien que hable de él en una cita contigo y prometo que será la última vez que lo haga."
    kia "Je sais que ce n'est pas bien de parler de lui lors d'un rendez-vous avec toi, et je te promets que ce sera la dernière fois."

# game/scripts/c21/c21.rpy:1906
translate french c21s003_KiaraDate_04e443a7:

    # kia "Con él siempre tenía que estar alerta para no decir algo que le molestara."
    kia "Avec lui, je devais toujours être sur mes gardes pour ne rien dire qui puisse le contrarier."

# game/scripts/c21/c21.rpy:1907
translate french c21s003_KiaraDate_98d3c2c0:

    # kia "Para que no bebiera demasiado."
    kia "Pour qu'il ne boive pas trop."

# game/scripts/c21/c21.rpy:1908
translate french c21s003_KiaraDate_f8e57f27:

    # kia "Para que no montara un espectáculo si algún hombre me miraba..."
    kia "Pour ne pas faire de scandale si un homme me regardait..."

# game/scripts/c21/c21.rpy:1909
translate french c21s003_KiaraDate_ed80e219:

    # mc "Lo entiendo, no tenía que ser cómodo."
    mc "Je comprends, ça n'avait pas besoin d'être confortable."

# game/scripts/c21/c21.rpy:1911
translate french c21s003_KiaraDate_3bb71433:

    # kia "No, no lo era. Y a eso me refiero con que esto es diferente."
    kia "Non, ce n'était pas le cas. Et c'est ce que je veux dire quand j'affirme que c'est différent."

# game/scripts/c21/c21.rpy:1912
translate french c21s003_KiaraDate_655cfbf9:

    # kia "Contigo, lo único que tengo que temer es no poder resistir las ganas de besarte en medio del restaurante."
    kia "Avec toi, la seule chose que je crains, c'est de ne pas pouvoir résister à l'envie de t'embrasser en plein restaurant."

# game/scripts/c21/c21.rpy:1913
translate french c21s003_KiaraDate_4613651e:

    # kia "Me haces sentir... relajada."
    kia "Tu me fais me sentir... détendu(e)."

# game/scripts/c21/c21.rpy:1914
translate french c21s003_KiaraDate_15014567:

    # mc "Solomon es una de las personas a las que no me gustaría parecerme. Si alguna vez empiezo a comportarme como él, avísame para dejar de hacerlo."
    mc "Solomon fait partie des personnes que je ne voudrais surtout pas imiter. Si jamais je me mets à faire comme lui, prévenez-moi pour que je puisse arrêter."

# game/scripts/c21/c21.rpy:1916
translate french c21s003_KiaraDate_dcfcb449:

    # kia "Los dos respiráis. *Risa* Creo que ahí acaban las similitudes."
    kia "Vous respirez tous les deux. *Rires* Je crois que c'est là que s'arrêtent les similitudes."

# game/scripts/c21/c21.rpy:1917
translate french c21s003_KiaraDate_726e8e80:

    # mc "*Risa* Y, en mi caso, no lo considero un desperdicio de oxígeno."
    mc "*Rires* Et, dans mon cas, je ne considère pas cela comme un gaspillage d'oxygène."

# game/scripts/c21/c21.rpy:1918
translate french c21s003_KiaraDate_5b0f932d:

    # kia "*Risa* No, no lo es."
    kia "*Rires* Non, ce n'est pas le cas."

# game/scripts/c21/c21.rpy:1920
translate french c21s003_KiaraDate_d84d6fa3:

    # mc "¿Puedes pedir la ensalada de pasta y un agua con gas para mí? Tengo que ir al lavabo."
    mc "Pourriez-vous commander une salade de pâtes et une eau gazeuse pour moi ? J'ai besoin d'aller aux toilettes."

# game/scripts/c21/c21.rpy:1921
translate french c21s003_KiaraDate_fae66d88:

    # kia "¿Ensalada de pasta? Habías dicho algo verde..."
    kia "Salade de pâtes ? Vous avez dit quelque chose de vert..."

# game/scripts/c21/c21.rpy:1922
translate french c21s003_KiaraDate_9ae059ac:

    # mc "La pasta en la ensalada es verde, roja, y blanca. *Risa* No esperabas que pidiera lechuga o endivias, ¿verdad?"
    mc "Les pâtes dans la salade sont vertes, rouges et blanches. *Rires* Vous ne vous attendiez quand même pas à ce que je commande de la laitue ou des endives ?"

# game/scripts/c21/c21.rpy:1923
translate french c21s003_KiaraDate_d93fd5d3:

    # mc "Paso a paso..."
    mc "Pas à pas..."

# game/scripts/c21/c21.rpy:1925
translate french c21s003_KiaraDate_4bb7ff47:

    # kia "*Risa* Vale, aceptaré pasta verde como ensalada. Creo que lleva una ínfima porción de espinacas."
    kia "*Rires* Bon, d'accord, je veux bien considérer les pâtes vertes comme une salade. Je crois qu'il y a un peu d'épinards dedans."

# game/scripts/c21/c21.rpy:1926
translate french c21s003_KiaraDate_802c91c8:

    # mc "Suficiente para mí."
    mc "Ça me suffit."

# game/scripts/c21/c21.rpy:1928
translate french c21s003_KiaraDate_c65d2a7d:

    # "Sorprendes a [kia] con un beso antes de ir al lavabo. La sorpresa inicial pasa en seguida."
    "Tu surprends [kia] avec un baiser avant d'aller aux toilettes. La surprise initiale s'estompe rapidement."

# game/scripts/c21/c21.rpy:1930
translate french c21s003_KiaraDate_f74dc452:

    # kia "Pero..."
    kia "Mais..."

# game/scripts/c21/c21.rpy:1931
translate french c21s003_KiaraDate_423d8675:

    # mc "Luego, cielo. *Risa* Tengo que ir al lavabo."
    mc "Alors, chérie. *Rires* Je dois aller aux toilettes."

# game/scripts/c21/c21.rpy:1932
translate french c21s003_KiaraDate_debea350:

    # mc "Y esto no es la puerta de la biblioteca."
    mc "Et ceci n'est pas la porte de la bibliothèque."

# game/scripts/c21/c21.rpy:1934
translate french c21s003_KiaraDate_8365c687:

    # mc "Ya estoy de vuelta. ¿Han tomado nota?"
    mc "Je suis de retour. Vous l'avez remarqué ?"

# game/scripts/c21/c21.rpy:1935
translate french c21s003_KiaraDate_45d0364b:

    # kia "Sí. No tenían la ensalada de pasta y te he pedido un combo de lechugas y espinacas."
    kia "Oui. Ils n'avaient pas de salade de pâtes, alors je vous ai demandé un mélange de laitue et d'épinards."

# game/scripts/c21/c21.rpy:1936
translate french c21s003_KiaraDate_27c68bcf:

    # mc "*Risa* Un restaurante italiano sin pasta. ¿Se está acabando el mundo?"
    mc "*Rires* Un restaurant italien sans pâtes. Est-ce la fin du monde ?"

# game/scripts/c21/c21.rpy:1938
translate french c21s003_KiaraDate_9acb8625:

    # kia "*Risa* Estoy bromeando. He pedido tu ensalada rebosante de calorías."
    kia "*Rires* Je plaisante. J'ai commandé votre salade hypercalorique."

# game/scripts/c21/c21.rpy:1939
translate french c21s003_KiaraDate_7cb16a11:

    # kia "Pero te hubieras merecido la lechuga por ese beso a traición. *Risa*"
    kia "Mais tu méritais bien la salade pour ce baiser volé. *Rires*"

# game/scripts/c21/c21.rpy:1940
translate french c21s003_KiaraDate_e24315f5:

    # mc "Era para que pudieras soportar mejor las ganas de besarme en medio del restaurante. Ahora te puedes relajar aún más."
    mc "C'était pour que tu puisses mieux résister à l'envie de m'embrasser en plein restaurant. Maintenant, tu peux te détendre encore plus."

# game/scripts/c21/c21.rpy:1942
translate french c21s003_KiaraDate_a982092f:

    # kia "A ti nadie te ha dicho nunca que besas muy bien, ¿verdad?"
    kia "Personne ne vous a jamais dit que vous embrassiez très bien, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1943
translate french c21s003_KiaraDate_640090e0:

    # mc "Si te soy sincero, me lo han dicho alguna vez. No preguntes quién."
    mc "Franchement, on me l'a déjà dit. Ne me demandez pas qui."

# game/scripts/c21/c21.rpy:1945
translate french c21s003_KiaraDate_3718abcf:

    # kia "*Risa* Era una pregunta retórica, idiota. Sé que [eil] te lo ha dicho muchas veces. Alguna vez incluso la oí decírtelo."
    kia "*Rires* C'était une question rhétorique, imbécile. Je sais que [eil] te l'a dit des tas de fois. Je l'ai même entendue te le dire une fois."

# game/scripts/c21/c21.rpy:1947
translate french c21s003_KiaraDate_7bf62b15:

    # kia "¿Tú crees que un beso como ese va a quitarme las ganas de darte más?"
    kia "Crois-tu qu'un baiser comme celui-là puisse me faire perdre l'envie de t'en donner davantage ?"

# game/scripts/c21/c21.rpy:1948
translate french c21s003_KiaraDate_99ca66d3:

    # mc "Espero que no. Me gusta el sabor de ese pintalabios."
    mc "J'espère que non. J'aime bien le goût de ce rouge à lèvres."

# game/scripts/c21/c21.rpy:1950
translate french c21s003_KiaraDate_5b59703b:

    # kia "¡Dios mío! ¿Qué he hecho yo para merecer un idiota como este?"
    kia "Oh mon Dieu ! Qu'ai-je fait pour mériter un idiot pareil ?"

# game/scripts/c21/c21.rpy:1951
translate french c21s003_KiaraDate_c1c083cd:

    # mc "Soy el premio por ser una mujer maravillosa. *Risa* Y no se aceptan devoluciones."
    mc "Je suis la récompense pour être une femme merveilleuse. *Rires* Et aucun remboursement."

# game/scripts/c21/c21.rpy:1953
translate french c21s003_KiaraDate_4feb9baa:

    # kia "*Risa* No pensaba devolverte a fábrica. No eres {b}tan{/b} defectuoso."
    kia "*Rires* Je n'avais pas l'intention de te renvoyer à l'usine. Tu n'es pas si défectueux."

# game/scripts/c21/c21.rpy:1954
translate french c21s003_KiaraDate_ca2064ab:

    # mc "*Risa* No sé si ofenderme o tomármelo como un cumplido..."
    mc "*Rires* Je ne sais pas si je dois m'en offusquer ou le prendre comme un compliment..."

# game/scripts/c21/c21.rpy:1956
translate french c21s003_KiaraDate_37786e99:

    # "Cuando traen vuestras dos ensaladas (y sí, una ensalada de pasta {b}es{/b} una ensalada) empieza una comida llena de risas."
    "Quand ils vous apportent vos deux salades (et oui, une salade de pâtes {b}est{/b} une salade), un repas plein de rires commence."

# game/scripts/c21/c21.rpy:1957
translate french c21s003_KiaraDate_5eb6f5b9:

    # "[kia] está relajada y os lo pasáis bien. Habláis de todo y de nada."
    "[kia] est détendu et vous passez un bon moment. Vous parlez de tout et de rien."

# game/scripts/c21/c21.rpy:1958
translate french c21s003_KiaraDate_6638e4f2:

    # "Habláis de su trabajo, del dormitorio, y de NTR."
    "Tu parles de son travail, de la chambre à coucher et de NTR."

# game/scripts/c21/c21.rpy:1959
translate french c21s003_KiaraDate_38379001:

    # "Charláis sobre [eil] y del resto de las mujeres de la familia."
    "Vous discutez de [eil] et des autres femmes de la famille."

# game/scripts/c21/c21.rpy:1960
translate french c21s003_KiaraDate_3bff8f4a:

    # "Habláis de vosotros."
    "Vous parlez de vous-mêmes."

# game/scripts/c21/c21.rpy:1961
translate french c21s003_KiaraDate_f44433f0:

    # "Pero, sobre todo, os reís mucho. Os reís de todo. De ti y de ella. Del mundo."
    "Mais surtout, tu ris beaucoup. Tu ris de tout. De toi et d'elle. Du monde."

# game/scripts/c21/c21.rpy:1963
translate french c21s003_KiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1964
translate french c21s003_KiaraDate_7a14f67a:

    # mc "Tengo que cogerlo, [kia]. Es [ama]. Dame un segundo."
    mc "Je dois le récupérer, [kia]. C'est [ama]. Donnez-moi une seconde."

# game/scripts/c21/c21.rpy:1965
translate french c21s003_KiaraDate_5b2bdc80:

    # kia "Todo el tiempo que necesites."
    kia "Tout le temps dont vous avez besoin."

# game/scripts/c21/c21.rpy:1966
translate french c21s003_KiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Salut, [ama]. Puis-je vous aider ?"

# game/scripts/c21/c21.rpy:1968
translate french c21s003_KiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Je voulais juste te rappeler qu'on devait se voir aujourd'hui pour prendre un café et discuter de mes idées sur le NTR. À quelle heure te conviendrait ?"

# game/scripts/c21/c21.rpy:1969
translate french c21s003_KiaraDate_dabe8d4e:

    # mc "Estoy comiendo con [kia]. ¿En una hora y media te va bien?"
    mc "Je déjeune avec [kia]. Une heure et demie vous convient-elle ?"

# game/scripts/c21/c21.rpy:1970
translate french c21s003_KiaraDate_7df02780:

    # kia "Puedes quedar antes. En 30 minutos tengo que estar de vuelta en la biblioteca."
    kia "Vous pouvez nous retrouver plus tôt. Je dois être de retour à la bibliothèque dans 30 minutes."

# game/scripts/c21/c21.rpy:1972
translate french c21s003_KiaraDate_aa011d24:

    # ama "La he escuchado. Te mando la dirección de un café que tienes cerca y podemos quedar allí. ¿En una hora?"
    ama "Je l'ai entendue. Je t'envoie l'adresse d'un café près de chez toi, on pourra s'y retrouver. Dans une heure ?"

# game/scripts/c21/c21.rpy:1973
translate french c21s003_KiaraDate_4890fe3f:

    # mc "Genial. Te veo en una hora. Hasta dentro de un rato."
    mc "Super. À dans une heure. À plus tard."

# game/scripts/c21/c21.rpy:1974
translate french c21s003_KiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Jusqu'à présent, [mc]."

# game/scripts/c21/c21.rpy:1976
translate french c21s003_KiaraDate_f8b86bf9:

    # mc "¿Por dónde íbamos?"
    mc "Où en étions-nous ?"

# game/scripts/c21/c21.rpy:1977
translate french c21s003_KiaraDate_e9290c40:

    # kia "Íbamos por el momento en que pido la cuenta y nos vamos a dar ese paseo antes de que se haga más tarde."
    kia "Nous en étions au point où j'ai demandé l'addition et nous sommes allés faire cette promenade avant qu'il ne soit trop tard."

# game/scripts/c21/c21.rpy:1978
translate french c21s003_KiaraDate_dfdeb562:

    # mc "De acuerdo, pero la cuenta la pido yo. Fui yo quien te invitó a comer. Pago yo."
    mc "D'accord, mais je vais demander l'addition. C'est moi qui vous ai invité à déjeuner. Je paierai."

# game/scripts/c21/c21.rpy:1980
translate french c21s003_KiaraDate_f74dc452_1:

    # kia "Pero..."
    kia "Mais..."

# game/scripts/c21/c21.rpy:1981
translate french c21s003_KiaraDate_41aa0cb0:

    # mc "Si quieres pagar tú, vas a tener que invitarme tú a comer. Un trato es un trato."
    mc "Si tu veux payer, tu devras m'inviter à déjeuner. Marché conclu."

# game/scripts/c21/c21.rpy:1982
translate french c21s003_KiaraDate_23f26bfb:

    # mc "Y así es como se consigue una tercera cita. *Risa*"
    mc "Et voilà comment on obtient un troisième rendez-vous. *Rires*"

# game/scripts/c21/c21.rpy:1984
translate french c21s003_KiaraDate_9a370fb8:

    # kia "Vale, pero la próxima vez será para cenar. Tener que volver al trabajo con prisa no es lo mejor... para una tercera cita."
    kia "D'accord, mais la prochaine fois ce sera pour dîner. Devoir se dépêcher de retourner au travail n'est pas idéal… pour un troisième rendez-vous."

# game/scripts/c21/c21.rpy:1985
translate french c21s003_KiaraDate_ce722ab8:

    # mc "Aún tenemos tiempo para ese paseo. Has dicho que tienes que volver en 30 minutos. Que ya deben ser 28."
    mc "Nous avons encore le temps pour cette promenade. Tu as dit que tu devais être de retour dans 30 minutes. Il doit être 28 minutes maintenant."

# game/scripts/c21/c21.rpy:1986
translate french c21s003_KiaraDate_15e51949:

    # mc "Déjame ir al mostrador a pagar, así ganaremos un par de minutos."
    mc "Je vais payer à la caisse, comme ça on gagnera quelques minutes."

# game/scripts/c21/c21.rpy:1988
translate french c21s003_KiaraDate_6bc7f6ee:

    # "Menos de diez minutos después, en un parque cercano..."
    "Moins de dix minutes plus tard, dans un parc voisin..."

# game/scripts/c21/c21.rpy:1989
translate french c21s003_KiaraDate_15fe2d35:

    # kia "Y aquí es dónde vengo a comerme los perritos calientes cuando tengo que comer sola. Un libro y mi perrito."
    kia "Et c'est ici que je viens manger des hot-dogs quand je dois manger seule. Un livre et mon petit chien."

# game/scripts/c21/c21.rpy:1990
translate french c21s003_KiaraDate_893e09f7:

    # mc "Lo sé. Vinimos con [sca], en vuestro primer día en casa."
    mc "Je sais. Nous sommes venus avec [sca], le jour de ton retour à la maison."

# game/scripts/c21/c21.rpy:1992
translate french c21s003_KiaraDate_6ca23feb:

    # kia "¡Es verdad! ¡Parece que hace un mes!"
    kia "C'est vrai ! On dirait que c'était il y a seulement un mois !"

# game/scripts/c21/c21.rpy:1993
translate french c21s003_KiaraDate_a5e89514:

    # mc "Mañana hace una semana, [kia]."
    mc "Demain marquera une semaine, [kia]."

# game/scripts/c21/c21.rpy:1995
translate french c21s003_KiaraDate_f4962993:

    # kia "Lo sé. Parece increíble que en una semana mi vida haya dado este vuelco."
    kia "Je sais. C'est incroyable qu'en une semaine ma vie ait pris un tel tournant."

# game/scripts/c21/c21.rpy:1996
translate french c21s003_KiaraDate_073db8a4:

    # mc "Pero ¿estás contenta de que lo haya dado?"
    mc "Mais êtes-vous content qu'il y ait renoncé ?"

# game/scripts/c21/c21.rpy:1998
translate french c21s003_KiaraDate_a9728b22:

    # kia "No te puedes imaginar cuánto. Y no me refiero sólo a estar contigo. Es todo. Me siento libre por primera vez en años."
    kia "Tu ne peux pas imaginer à quel point. Et je ne parle pas seulement d'être avec toi. C'est tout. Je me sens libre pour la première fois depuis des années."

# game/scripts/c21/c21.rpy:1999
translate french c21s003_KiaraDate_30454c6e:

    # kia "¿Te acuerdas hace unos días, cuando te dije que teníais un castillo precioso como hogar y todas esas tonterías?"
    kia "Te souviens-tu, il y a quelques jours, quand je t'ai dit que tu avais un magnifique château comme maison et toutes ces bêtises ?"

# game/scripts/c21/c21.rpy:2000
translate french c21s003_KiaraDate_924e117b:

    # mc "Fue ayer, [kia]. Estábamos en la piscina, durante la fiesta de cumpleaños."
    mc "C'était hier, [kia]. Nous étions à la piscine, pendant la fête d'anniversaire."

# game/scripts/c21/c21.rpy:2002
translate french c21s003_KiaraDate_fb9a12a4:

    # kia "¿Ayer? ¿No te lo dije durante la comida con [ama]? Se me mezclan los días... todo ha sido tan intenso..."
    kia "Hier ? Je ne te l'avais pas dit pendant le déjeuner avec [ama] ? J'ai la tête qui tourne… tout a été tellement intense…"

# game/scripts/c21/c21.rpy:2003
translate french c21s003_KiaraDate_4c34fbdb:

    # mc "*Risa* Durante la comida con [ama] es cuando saliste corriendo. Eso fue anteayer."
    mc "*Rires* C'est pendant le déjeuner avec [ama] que tu t'es enfui. C'était avant-hier."

# game/scripts/c21/c21.rpy:2004
translate french c21s003_KiaraDate_5de9aba8:

    # kia "Me estoy volviendo loca. Todo parece que haya pasado hace muchísimo..."
    kia "Je deviens fou. J'ai l'impression que tout cela s'est passé il y a une éternité..."

# game/scripts/c21/c21.rpy:2006
translate french c21s003_KiaraDate_c4f7488d:

    # kia "Sentirme aceptada por la familia, besarte ayer... por la tarde... hablar con todas las chicas después de eso... y lo que pasó por la noche..."
    kia "Le sentiment d'être acceptée par la famille, t'avoir embrassée hier après-midi… avoir parlé à toutes les filles ensuite… et ce qui s'est passé hier soir…"

# game/scripts/c21/c21.rpy:2007
translate french c21s003_KiaraDate_392d8bed:

    # kia "Yo llevaba una vida aburrida donde todos los días eran iguales..."
    kia "J'ai mené une vie ennuyeuse où chaque jour se ressemblait..."

# game/scripts/c21/c21.rpy:2008
translate french c21s003_KiaraDate_bf02bf81:

    # mc "En casa nunca hay tiempo para aburrirse. Te adaptaste a la familia. También te adaptarás a esto."
    mc "On ne s'ennuie jamais à la maison. Tu t'es adapté à la famille. Tu t'adapteras à ça aussi."

# game/scripts/c21/c21.rpy:2010
translate french c21s003_KiaraDate_50f0c08d:

    # kia "Lo sé, pero ahora mismo, la última semana es un torbellino de recuerdos."
    kia "Je sais, mais pour l'instant, la semaine dernière est un véritable tourbillon de souvenirs."

# game/scripts/c21/c21.rpy:2011
translate french c21s003_KiaraDate_b1e79ea5:

    # kia "Llegar a casa, la fiesta en la playa, cuando fuimos a mi antigua casa, intentar evitarte, la fiesta de cumpleaños... el beso... y lo de anoche."
    kia "Le retour à la maison, la fête sur la plage, notre visite dans mon ancienne maison, mes tentatives pour t'éviter, la fête d'anniversaire... le baiser... et hier soir."

# game/scripts/c21/c21.rpy:2013
translate french c21s003_KiaraDate_5c0849e7:

    # kia "Que voy a ser abuela..."
    kia "Je vais être grand-mère..."

# game/scripts/c21/c21.rpy:2014
translate french c21s003_KiaraDate_3f92739f:

    # kia "Casi no puedo poner los recuerdos en el orden correcto."
    kia "J'ai beaucoup de mal à remettre les souvenirs dans le bon ordre."

# game/scripts/c21/c21.rpy:2016
translate french c21s003_KiaraDate_3a5e5d9b:

    # kia "Y ni siquiera hace una semana..."
    kia "Et ça ne fait même pas une semaine..."

# game/scripts/c21/c21.rpy:2017
translate french c21s003_KiaraDate_d584132f:

    # mc "Te han pasado muchas cosas importantes en esta semana. Es normal. A veces a mí también me cuesta."
    mc "Il t'est arrivé beaucoup de choses importantes cette semaine. C'est normal. Parfois, j'ai aussi du mal à gérer ça."

# game/scripts/c21/c21.rpy:2018
translate french c21s003_KiaraDate_afe9bcb6:

    # mc "Pero tengo una pregunta... Después del beso de ayer por la tarde, las chicas te secuestraron durante un buen rato. ¿Qué te dijeron?"
    mc "Mais j'ai une question… Après le baiser d'hier après-midi, les filles t'ont kidnappé pendant un bon moment. Qu'est-ce qu'elles t'ont dit ?"

# game/scripts/c21/c21.rpy:2020
translate french c21s003_KiaraDate_eb884940:

    # kia "*Risa* ¡Es una cosa entre chicas! Te puedo decir que todas me felicitaron por haber dejado atrás el pasado."
    kia "*Rires* C'est un truc de filles ! Je peux vous dire qu'elles m'ont toutes félicitée d'avoir tourné la page."

# game/scripts/c21/c21.rpy:2021
translate french c21s003_KiaraDate_86d4bac7:

    # kia "Algunas, aunque no te voy a decir quienes, me dieron consejos sobre ti."
    kia "Certaines personnes, dont je ne vous dirai pas qui, m'ont donné des conseils à votre sujet."

# game/scripts/c21/c21.rpy:2022
translate french c21s003_KiaraDate_944522a8:

    # mc "*Risa* ¡Eso es injusto! ¿Habláis de mi a mis espaldas?"
    mc "*Rires* C'est injuste ! Tu parles de moi dans mon dos ?"

# game/scripts/c21/c21.rpy:2024
translate french c21s003_KiaraDate_aafa9a2f:

    # kia "*Risa* Obviamente. Y duermo con [eil], que es quien más tiempo ha salido contigo."
    kia "*Rires* Évidemment. Et je couche avec [eil], celle avec qui tu es sorti le plus longtemps."

# game/scripts/c21/c21.rpy:2025
translate french c21s003_KiaraDate_2505296a:

    # kia "Ya te dije que se pasó buena parte de la noche hablándome de ti e intentando convencerme para..."
    kia "Je t'ai déjà dit qu'il a passé une bonne partie de la nuit à me parler de toi et à essayer de me convaincre de..."

# game/scripts/c21/c21.rpy:2026
translate french c21s003_KiaraDate_03f9afb6:

    # mc "Tengo que hablar con ella. No es lo que quería decir cuando le pedía ayuda."
    mc "Il faut que je lui parle. Ce n'est pas ce que je voulais dire quand je lui ai demandé de l'aide."

# game/scripts/c21/c21.rpy:2028
translate french c21s003_KiaraDate_14d72b5c:

    # kia "Sin su insistencia, no hubiéramos hablado anoche en el pasillo ni en la piscina, ni hubiéramos paseado después. Ni estaríamos aquí hoy."
    kia "Sans son insistance, nous n'aurions pas discuté hier soir dans le couloir ni au bord de la piscine, et nous ne serions pas allés nous promener ensuite. Nous ne serions pas là aujourd'hui non plus."

# game/scripts/c21/c21.rpy:2029
translate french c21s003_KiaraDate_333bdd8e:

    # kia "Ni podría hacer esto."
    kia "Je ne pouvais pas faire ça non plus."

# game/scripts/c21/c21.rpy:2031
translate french c21s003_KiaraDate_791a31f8:

    # "[kia] te sorprende con un beso en los labios. Tierno y pasional a partes iguales."
    "[kia] te surprend avec un baiser sur les lèvres. À la fois tendre et passionné."

# game/scripts/c21/c21.rpy:2032
translate french c21s003_KiaraDate_21d044b8:

    # "No es muy largo, pero puedes leer muchas cosas en él. Alivio, felicidad, esperanza..."
    "Il n'est pas très long, mais on peut y lire beaucoup de choses. Du soulagement, du bonheur, de l'espoir…"

# game/scripts/c21/c21.rpy:2034
translate french c21s003_KiaraDate_c8dc03e3:

    # kia "Ya no aguantaba más."
    kia "Je n'en pouvais plus."

# game/scripts/c21/c21.rpy:2035
translate french c21s003_KiaraDate_e60234c7:

    # mc "¡Wow!"
    mc "Ouah!"

# game/scripts/c21/c21.rpy:2037
translate french c21s003_KiaraDate_a888af23:

    # kia "¿Quieres quitar esa sonrisa de tu cara? ¡La gente va a empezar a mirarnos!"
    kia "Tu veux effacer ce sourire de ton visage ? Les gens vont commencer à nous regarder fixement !"

# game/scripts/c21/c21.rpy:2038
translate french c21s003_KiaraDate_e60234c7_1:

    # mc "¡Wow!"
    mc "Ouah!"

# game/scripts/c21/c21.rpy:2040
translate french c21s003_KiaraDate_8a485d4c:

    # kia "¡[mc], por favor! ¡Deja de hacer el tonto!"
    kia "[mc], s'il vous plaît ! Arrêtez de faire l'idiot !"

# game/scripts/c21/c21.rpy:2041
translate french c21s003_KiaraDate_42931d20:

    # mc "¡Wow! *Risa* Me acabo de enamorar del sabor de aguacate mezclado con tu pintalabios."
    mc "Waouh ! *Rires* Je suis tombée amoureuse du goût de l'avocat mélangé à votre rouge à lèvres."

# game/scripts/c21/c21.rpy:2043
translate french c21s003_KiaraDate_d98ac0e5:

    # kia "*Risa* ¿Todavía tengo sabor a aguacate?"
    kia "*Rires* Est-ce que j'ai encore le goût de l'avocat ?"

# game/scripts/c21/c21.rpy:2044
translate french c21s003_KiaraDate_b1b8b40a:

    # mc "Muy ligero, pero todavía se nota. *Risa* Creo que puedo añadir otra cosa verde al menú. Pero lo tendré que comer de tus labios."
    mc "Très subtil, mais tout de même perceptible. *Rires* Je crois que je peux ajouter un autre élément vert au menu. Mais je devrai le manger directement sur tes lèvres."

# game/scripts/c21/c21.rpy:2046
translate french c21s003_KiaraDate_6c92bb1c:

    # "La bibliotecaria pelirroja atrae tu cabeza hasta su altura y vuelve a besarte de una forma que las bibliotecarias deberían tener prohibida."
    "La bibliothécaire rousse relève votre tête à sa hauteur et vous embrasse à nouveau d'une manière que les bibliothécaires devraient avoir l'interdiction de faire."

# game/scripts/c21/c21.rpy:2047
translate french c21s003_KiaraDate_24e1f98a:

    # "Esta vez es todo pasión, sin rastro de ternura. Pasea su lengua por tus encías, la entrelaza con la tuya, recorre toda tu boca... Te deja sin aliento."
    "Cette fois, c'est la passion à l'état pur, sans la moindre tendresse. Il passe sa langue sur vos gencives, l'entrelace à la vôtre, explore toute votre bouche… Il vous coupe le souffle."

# game/scripts/c21/c21.rpy:2048
translate french c21s003_KiaraDate_37461727:

    # "Bendito aguacate."
    "Avocat béni."

# game/scripts/c21/c21.rpy:2050
translate french c21s003_KiaraDate_e60234c7_2:

    # mc "¡Wow!"
    mc "Ouah!"

# game/scripts/c21/c21.rpy:2051
translate french c21s003_KiaraDate_d5771a00:

    # kia "*Respiración entrecortada* ¡Wow! *Risa* Tenía que colaborar con que lleves una dieta saludable."
    kia "*Haletant* Waouh ! *Rires* J'ai dû t'aider à adopter une alimentation saine."

# game/scripts/c21/c21.rpy:2052
translate french c21s003_KiaraDate_0655365d:

    # kia "Me podría pasar horas aquí haciendo esto y diciendo Wow. Pero, desafortunadamente, tengo que volver al trabajo."
    kia "Je pourrais passer des heures ici à faire ça et à dire « Waouh ! ». Mais malheureusement, je dois retourner au travail."

# game/scripts/c21/c21.rpy:2053
translate french c21s003_KiaraDate_298eab58:

    # mc "Entonces vamos. No quiero que llegues tarde."
    mc "Allons-y alors. Je ne veux pas que tu sois en retard."

# game/scripts/c21/c21.rpy:2055
translate french c21s003_KiaraDate_a05e80ee:

    # kia "Y tú has quedado con [ama]..."
    kia "Et vous avez prévu de vous rencontrer [ama]..."

# game/scripts/c21/c21.rpy:2056
translate french c21s003_KiaraDate_8fdac1cc:

    # mc "Sí, me quiere comentar sus ideas sobre la empresa."
    mc "Oui, il souhaite partager ses idées sur l'entreprise avec moi."

# game/scripts/c21/c21.rpy:2058
translate french c21s003_KiaraDate_ef05061a:

    # kia "*Risa* No estaba interrogándote. Sé que no estás con ella. Al menos aún..."
    kia "*Rires* Je ne te posais pas de questions. Je sais que tu n'es pas avec elle. Du moins pas encore..."

# game/scripts/c21/c21.rpy:2059
translate french c21s003_KiaraDate_d66fabe3:

    # mc "*Risa* Lo sé. Después de lo de ayer, no tengo secretos y no quiero tenerlos."
    mc "*Rires* Je sais. Après ce qui s'est passé hier, je n'ai plus de secrets et je n'en veux pas."

# game/scripts/c21/c21.rpy:2061
translate french c21s003_KiaraDate_c6ec59ab:

    # mc "¿Vamos?"
    mc "Allez?"

# game/scripts/c21/c21.rpy:2064
translate french c21s003_KiaraDate_b60c23b3:

    # "Unos minutos después, en la biblioteca, justo a la hora en que [kia] tenía que volver..."
    "Quelques minutes plus tard, à la bibliothèque, pile à l'heure où [kia] devait rentrer..."

# game/scripts/c21/c21.rpy:2065
translate french c21s003_KiaraDate_8b2f8fdb:

    # kia "Ya estoy aquí, Gen. Puedes hacer tu pausa para la comida cuando quieras."
    kia "Je suis là, Général. Vous pouvez prendre votre pause déjeuner quand vous le souhaitez."

# game/scripts/c21/c21.rpy:2066
translate french c21s003_KiaraDate_1edb4e6e:

    # mc "Hola de nuevo, Gen."
    mc "Bonjour à nouveau, Général."

# game/scripts/c21/c21.rpy:2067
translate french c21s003_KiaraDate_29a64304:

    # gen "Justo a tiempo, me estaba muriendo de hambre. La biblioteca está vacía, no queda nada pendiente."
    gen "Ça tombait à pic, j'étais affamé. La bibliothèque est vide, il n'y a plus rien à faire."

# game/scripts/c21/c21.rpy:2069
translate french c21s003_KiaraDate_a31f8e02:

    # kia "Pues el puesto de perritos calientes tiene bastante cola ahora. Si necesitas más tiempo no hay ningún problema."
    kia "Il y a beaucoup de monde au stand de hot-dogs en ce moment. Si vous avez besoin de plus de temps, il n'y a pas de problème."

# game/scripts/c21/c21.rpy:2070
translate french c21s003_KiaraDate_0ed3ff23:

    # gen "[kia]... ¿dónde está tu bolso?"
    gen "[kia]... où est ton sac ?"

# game/scripts/c21/c21.rpy:2072
translate french c21s003_KiaraDate_21ee7fe8:

    # kia "¡Mierda! Me lo he dejado en el restaurante."
    kia "Zut ! Je l'ai oublié au restaurant."

# game/scripts/c21/c21.rpy:2074
translate french c21s003_KiaraDate_ee87a7da:

    # kia "¿Puedes cubrirme diez minutos mientras voy a buscarlo?"
    kia "Tu peux me remplacer pendant dix minutes, le temps que j'aille le chercher ?"

# game/scripts/c21/c21.rpy:2075
translate french c21s003_KiaraDate_40554669:

    # gen "Ningún problema. Ve a ver si lo han encontrado antes de que desaparezca."
    gen "Pas de problème. Va voir s'ils l'ont trouvé avant qu'il ne disparaisse."

# game/scripts/c21/c21.rpy:2076
translate french c21s003_KiaraDate_962e9524:

    # mc "No os preocupéis, voy a llamarles y voy a buscarlo, voy a llegar más rápido que tú con los tacones. Ahora lo traigo."
    mc "Ne t'inquiète pas, je les appelle et j'irai le chercher. J'y serai plus vite que toi en talons. Je te l'apporte tout de suite."

# game/scripts/c21/c21.rpy:2077
translate french c21s003_KiaraDate_7d70251d:

    # mcp "(Espero que siga allí o que lo haya encontrado el camarero cuando nos hemos ido.)"
    mcp "(J'espère qu'il est encore là, ou que le serveur l'a trouvé après notre départ.)"

# game/scripts/c21/c21.rpy:2079
translate french c21s003_KiaraDate_2a1b37fd:

    # kia "Gracias, [mc]. ¿Aviso a [ama] de que vas a llegar tarde?"
    kia "Merci, [mc]. Dois-je prévenir [ama] que tu vas être en retard ?"

# game/scripts/c21/c21.rpy:2080
translate french c21s003_KiaraDate_8b13deee:

    # mc "Sí, por favor."
    mc "Oui s'il vous plait."

# game/scripts/c21/c21.rpy:2082
translate french c21s003_KiaraDate_82c139e0:

    # "Sales de la biblioteca y empiezas a correr hacia el restaurante mientras les llamas. No cogen el teléfono."
    "Vous quittez la bibliothèque et vous vous mettez à courir vers le restaurant en les appelant. Ils ne répondent pas au téléphone."

# game/scripts/c21/c21.rpy:2083
translate french c21s003_KiaraDate_28f6b659:

    # "Llegas un par de minutos después. Nunca habías corrido tan rápido en tu vida."
    "Vous arrivez quelques minutes plus tard. Vous n'avez jamais couru aussi vite de votre vie."

# game/scripts/c21/c21.rpy:2085
translate french c21s003_KiaraDate_ddd4ef24:

    # "El camarero saca el bolso de la barra antes de que puedas recuperar el aliento para pedírselo."
    "Le serveur retire le sac du comptoir avant même que vous ayez eu le temps de reprendre votre souffle pour le demander."

# game/scripts/c21/c21.rpy:2086
translate french c21s003_KiaraDate_61bec498:

    # "Hubiera sido una forma horrible de acabar la segunda cita si [kia] hubiera perdido el bolso."
    "Cela aurait été une fin horrible pour le deuxième rendez-vous si [kia] avait perdu son sac à main."

# game/scripts/c21/c21.rpy:2088
translate french c21s003_KiaraDate_f8948cde:

    # "Vuelves corriendo a la biblioteca. No quieres que [kia] se preocupe por su bolso más de lo necesario. Corres un poco más lento."
    "Tu retournes en courant à la bibliothèque. Tu ne veux pas que [kia] s'inquiète plus que nécessaire pour son sac. Tu cours un peu plus lentement."

# game/scripts/c21/c21.rpy:2089
translate french c21s003_KiaraDate_7ec444f4:

    # "Quieres mantener un poco de dignidad cuando llegues, y fregar la biblioteca con la lengua no es la mejor forma de hacerlo."
    "Vous souhaitez conserver une certaine dignité à votre arrivée, et lécher la bibliothèque n'est pas la meilleure façon d'y parvenir."

# game/scripts/c21/c21.rpy:2092
translate french c21s003_KiaraDate_41e727be:

    # "Cuando estás a punto de entrar, oyes voces..."
    "Au moment où vous vous apprêtez à entrer, vous entendez des voix..."

# game/scripts/c21/c21.rpy:2094
translate french c21s003_KiaraDate_12932815:

    # kia "...¡Me da lo mismo que tenga edad para ser mi hijo!"
    kia "Peu m'importe son âge pour être mon fils !"

# game/scripts/c21/c21.rpy:2095
translate french c21s003_KiaraDate_a9cc36f2:

    # gen "[kia], lo digo por tu bien. Los chavales como él sólo quieren una cosa en una mujer de tu edad..."
    gen "[kia], je te dis ça pour ton bien. Les types comme lui ne veulent qu'une chose d'une femme de ton âge..."

# game/scripts/c21/c21.rpy:2096
translate french c21s003_KiaraDate_5751ce07:

    # kia "Él es diferente..."
    kia "Il est différent..."

# game/scripts/c21/c21.rpy:2097
translate french c21s003_KiaraDate_31d65093:

    # gen "Si supieras las veces que he oído eso..."
    gen "Si seulement vous saviez combien de fois j'ai entendu ça..."

# game/scripts/c21/c21.rpy:2098
translate french c21s003_KiaraDate_f46409ae:

    # mcp "(Es el momento de intervenir.)"
    mcp "(Il est temps d'intervenir.)"

# game/scripts/c21/c21.rpy:2100
translate french c21s003_KiaraDate_a641d824:

    # mc "Hola, [kia], Sra. Sky. Vengo con el bolso. Lo había recogido el camarero en cuanto nos hemos ido."
    mc "Bonjour, Mme Sky. Je suis venu avec votre sac. Le serveur l'a récupéré dès notre départ."

# game/scripts/c21/c21.rpy:2101
translate french c21s003_KiaraDate_0d7b308b:

    # kia "¡Gracias a Dios!"
    kia "Dieu merci!"

# game/scripts/c21/c21.rpy:2102
translate french c21s003_KiaraDate_5e5e2a04:

    # gen "Gracias, [mc]. [kia] estaba muy preocupada. Y puedes seguir llamándome Gen..."
    gen "Merci, [mc]. [kia] J'étais vraiment inquiet. Et vous pouvez toujours m'appeler Gen..."

# game/scripts/c21/c21.rpy:2104
translate french c21s003_KiaraDate_ef1dcc07:

    # "Ignoras a Geneviève y te arrodillas a los pies de [kia], poniendo el bolso en el suelo."
    "Vous ignorez Geneviève et vous vous agenouillez aux pieds de [kia], en posant votre sac sur le sol."

# game/scripts/c21/c21.rpy:2106
translate french c21s003_KiaraDate_3c0703f5:

    # kia "¿Qué haces, [mc]?"
    kia "Que fais-tu, [mc] ?"

# game/scripts/c21/c21.rpy:2107
translate french c21s003_KiaraDate_51b3fcab:

    # mc "He oído como la Sra. Sky decía que los chavales como yo sólo queremos una cosa con mujeres como tú."
    mc "J'ai entendu Mme Sky dire que les gars comme moi ne veulent qu'une seule chose chez les femmes comme vous."

# game/scripts/c21/c21.rpy:2109
translate french c21s003_KiaraDate_2d0d83f0:

    # mc "No sé lo que quieren otros chavales como yo."
    mc "Je ne sais pas ce que veulent les autres enfants comme moi."

# game/scripts/c21/c21.rpy:2111
translate french c21s003_KiaraDate_6e1b5cf3:

    # mc "Yo lo único que quiero es poner el mundo a tus pies, [kia]. Empiezo con un bolso."
    mc "Tout ce que je veux, c'est mettre le monde à tes pieds, [kia]. Je commencerai par un sac à main."

# game/scripts/c21/c21.rpy:2112
translate french c21s003_KiaraDate_6b53cf56:

    # mc "Y también quiero callar a quien opina sobre nosotros sin saber nada sobre lo que hemos pasado."
    mc "Et je veux aussi faire taire ceux qui nous critiquent sans rien savoir de ce que nous avons vécu."

# game/scripts/c21/c21.rpy:2113
translate french c21s003_KiaraDate_c3f1b5be:

    # kia "Gracias, [mc], pero... ¿puedes levantarte?"
    kia "Merci, [mc], mais... peux-tu te lever ?"

# game/scripts/c21/c21.rpy:2116
translate french c21s003_KiaraDate_8ee06496:

    # "Estás enfadado. Mucho. Sabes que tus relaciones pueden hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Vous êtes en colère. Très en colère. Vous savez que vos relations peuvent susciter des interrogations. Mais vous n'étiez pas préparé à ça."

# game/scripts/c21/c21.rpy:2118
translate french c21s003_KiaraDate_5c20a138:

    # "Estás enfadado. Mucho. Sabes que tu relación con [kia] puede hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Vous êtes en colère. Très en colère. Vous savez que votre relation avec [kia] pourrait en éveiller plus d'un. Mais vous n'étiez pas préparé à ça."

# game/scripts/c21/c21.rpy:2119
translate french c21s003_KiaraDate_83eb79b0:

    # mc "¿Has podido llamar a [ama]?"
    mc "Avez-vous pu appeler [ama] ?"

# game/scripts/c21/c21.rpy:2120
translate french c21s003_KiaraDate_ecb11950:

    # kia "Mi móvil estaba en el bolso... ni siquiera he pensado en ello, y no me he aprendido su número."
    kia "Mon téléphone était dans mon sac… Je n’y ai même pas pensé et je n’ai pas noté son numéro."

# game/scripts/c21/c21.rpy:2121
translate french c21s003_KiaraDate_7d61ae16:

    # mc "Entonces no te preocupes. Aún llego a tiempo."
    mc "Alors ne t'inquiète pas. Je serai là à temps."

# game/scripts/c21/c21.rpy:2123
translate french c21s003_KiaraDate_45d03ede:

    # gen "Siento si te he ofendido, [mc]. Sólo intentaba proteger a [kia]."
    gen "Je suis désolé si je vous ai offensé, [mc]. J'essayais seulement de protéger [kia]."

# game/scripts/c21/c21.rpy:2124
translate french c21s003_KiaraDate_4ab0c2c3:

    # "Está nerviosa. Sabe que ha metido la pata. Se le nota más aún el acento francés."
    "Elle est nerveuse. Elle sait qu'elle a fait une bêtise. Son accent français est encore plus prononcé."

# game/scripts/c21/c21.rpy:2125
translate french c21s003_KiaraDate_4bed652a:

    # mc "Me parece loable, pero debería informarse sobre lo que habla antes de decir algo de lo que pueda arrepentirse, Sra. Sky."
    mc "Je trouve cela louable, mais vous devriez vous renseigner sur le sujet avant de dire quelque chose que vous pourriez regretter, Mme Sky."

# game/scripts/c21/c21.rpy:2126
translate french c21s003_KiaraDate_6547ca29:

    # "Tu tono es cortante. Ahora mismo no quieres dar explicaciones ni hablar con esta mujer."
    "Votre ton est sec. Vous ne semblez pas vouloir donner d'explications ni parler à cette femme."

# game/scripts/c21/c21.rpy:2127
translate french c21s003_KiaraDate_9e5bf2a2:

    # gen "Gen..."
    gen "Général..."

# game/scripts/c21/c21.rpy:2128
translate french c21s003_KiaraDate_557ac246:

    # mc "Sólo acorto los nombres de mis amigos, Geneviève."
    mc "Je raccourcis simplement le nom de mes amis, Geneviève."

# game/scripts/c21/c21.rpy:2130
translate french c21s003_KiaraDate_56a4311f:

    # "Dulcificas tu tono cuando te diriges a [kia]."
    "Vous adoucissez votre ton lorsque vous vous adressez à [kia]."

# game/scripts/c21/c21.rpy:2131
translate french c21s003_KiaraDate_47c19fca:

    # mc "Voy a ir a lo de [ama] antes de que se haga tarde."
    mc "Je vais chez [ama] avant qu'il ne soit trop tard."

# game/scripts/c21/c21.rpy:2132
translate french c21s003_KiaraDate_1ac8e5cc:

    # kia "Gracias de nuevo, [mc]."
    kia "Merci encore, [mc]."

# game/scripts/c21/c21.rpy:2133
translate french c21s003_KiaraDate_8b0e91b1:

    # mc "Te veo en casa, cielo."
    mc "Je te verrai à la maison, chérie."

# game/scripts/c21/c21.rpy:2135
translate french c21s003_KiaraDate_da634e8e:

    # kia "Espera un momento..."
    kia "Attendez une minute..."

# game/scripts/c21/c21.rpy:2136
translate french c21s003_KiaraDate_5c6b8bd7:

    # mc "¿Falta algo en el bolso?"
    mc "Manque-t-il quelque chose dans le sac ?"

# game/scripts/c21/c21.rpy:2137
translate french c21s003_KiaraDate_da7da0b6:

    # kia "Ni lo sé ni me importa."
    kia "Je ne sais pas et ça m'est égal."

# game/scripts/c21/c21.rpy:2138
translate french c21s003_KiaraDate_9493c8fc:

    # "El bolso continúa en el suelo, donde los has dejado."
    "Le sac est toujours par terre, là où vous l'avez laissé."

# game/scripts/c21/c21.rpy:2140
translate french c21s003_KiaraDate_6a149303:

    # "[kia] se lanza a tus labios para sorpresa tuya y de Geneviève. Tú has defendido vuestra relación a tu manera."
    "[kia] se jette sur vos lèvres, à votre grande surprise et à celle de Geneviève. Vous avez défendu votre relation à votre manière."

# game/scripts/c21/c21.rpy:2141
translate french c21s003_KiaraDate_5781450e:

    # "Ella la defiende a la suya."
    "Elle défend les siens."

# game/scripts/c21/c21.rpy:2142
translate french c21s003_KiaraDate_f42e6c2d:

    # "Demostrándole a Geneviève que sus palabras no han conseguido sembrar ninguna duda."
    "Démontrant à Geneviève que ses paroles n'avaient pas réussi à semer le moindre doute."

# game/scripts/c21/c21.rpy:2143
translate french c21s003_KiaraDate_8800b7ec:

    # "También te lo quiere demostrar a ti."
    "Il veut vous le prouver aussi."

# game/scripts/c21/c21.rpy:2144
translate french c21s003_KiaraDate_319ad8f0:

    # "Todavía sabe a aguacate."
    "Ça a toujours le goût d'avocat."

# game/scripts/c21/c21.rpy:2146
translate french c21s003_KiaraDate_e03f835c:

    # kia "¡Wow! *Risa*"
    kia "Waouh ! *Rires*"

# game/scripts/c21/c21.rpy:2147
translate french c21s003_KiaraDate_9a736d83:

    # mc "¡Wow! *Risa*"
    mc "Waouh ! *Rires*"

# game/scripts/c21/c21.rpy:2149
translate french c21s003_KiaraDate_a7d06318:

    # kia "Gracias por todo, cielo."
    kia "Merci pour tout, chérie."

# game/scripts/c21/c21.rpy:2150
translate french c21s003_KiaraDate_01b1a236:

    # "Ese \"por todo\" incluye dar la cara por ella. Quizás por primera vez en su vida alguien lo ha hecho."
    "Ce « pour tout » inclut de la défendre. Peut-être pour la première fois de sa vie, quelqu'un l'a fait."

# game/scripts/c21/c21.rpy:2151
translate french c21s003_KiaraDate_e2d67541:

    # mc "Te veo en casa, preciosa."
    mc "Je te verrai à la maison, ma belle."

# game/scripts/c21/c21.rpy:2153
translate french c21s003_KiaraDate_54905dfa:

    # mc "Adiós, Geneviève."
    mc "Au revoir, Geneviève."

# game/scripts/c21/c21.rpy:2155
translate french c21s003_KiaraDate_e5568ef5:

    # "Te marchas mientras escuchas la despedida murmurada de Geneviève."
    "Vous partez en écoutant les adieux murmurés de Geneviève."

# game/scripts/c21/c21.rpy:2168
translate french c21s004_AmandaCoffee_73df7f5a:

    # "Llegas al café donde has quedado con [ama]. Era un sitio que no habías visitado nunca anteriormente, pero has venido varias veces en las últimas semanas."
    "Vous arrivez au café où vous avez rendez-vous avec [ama]. C'est un endroit que vous n'avez jamais visité auparavant, mais vous y êtes allé plusieurs fois ces dernières semaines."

# game/scripts/c21/c21.rpy:2170
translate french c21s004_AmandaCoffee_142dc0f7:

    # "[ama] ya está allí, con un café y un portátil sobre la mesa."
    "[ama] est déjà là, avec un café et un ordinateur portable sur la table."

# game/scripts/c21/c21.rpy:2172
translate french c21s004_AmandaCoffee_db15f581:

    # mc "Hola, [ama]. No te levantes. ¿Llevas mucho esperando? No llego tarde, ¿verdad?"
    mc "Salut, [ama]. Ne te lève pas. Tu attends depuis longtemps ? Je ne suis pas en retard, si ?"

# game/scripts/c21/c21.rpy:2173
translate french c21s004_AmandaCoffee_5e28640c:

    # ama "No te preocupes, llevo diez minutos aquí tan solo. He llegado antes de la hora. Y tú llegas super puntual."
    ama "Ne t'inquiète pas, je suis là depuis seulement dix minutes. Je suis arrivé en avance. Et tu es super ponctuel."

# game/scripts/c21/c21.rpy:2174
translate french c21s004_AmandaCoffee_ed741d2f:

    # mc "Nunca me ha parecido bien hacer esperar a nadie. Lo considero una falta de respeto hacia el tiempo de los demás."
    mc "Je n'ai jamais pensé qu'il était juste de faire attendre qui que ce soit. Je considère cela comme un manque de respect pour le temps d'autrui."

# game/scripts/c21/c21.rpy:2176
translate french c21s004_AmandaCoffee_4a9e8483:

    # ama "No sé cómo lo consigues. Los civiles tenéis unas vidas muy complicadas con un montón de cosas por hacer que se solapan."
    ama "Je ne sais pas comment vous faites. Vous autres, les civils, avez des vies très compliquées, avec beaucoup de choses à faire qui se chevauchent."

# game/scripts/c21/c21.rpy:2178
translate french c21s004_AmandaCoffee_30339c94:

    # ama "Casi echo de menos la vida organizada de la base en la que siempre sabes qué tienes que hacer a qué hora. Solo casi."
    ama "La vie organisée de la base me manque presque, elle où l'on sait toujours ce qu'on a à faire et à quelle heure. Presque seulement."

# game/scripts/c21/c21.rpy:2179
translate french c21s004_AmandaCoffee_1043c8a0:

    # mc "Yo estoy pensando en fichar una secretaria. *Risa*"
    mc "Je pense embaucher une secrétaire. *Rires*"

# game/scripts/c21/c21.rpy:2181
translate french c21s004_AmandaCoffee_6f095e24:

    # ama "¿Más mujeres a tu alrededor? *Risa* ¿No tienes suficientes?"
    ama "Plus de femmes autour de toi ? *Rires* Tu n'en as pas assez ?"

# game/scripts/c21/c21.rpy:2182
translate french c21s004_AmandaCoffee_1759b4a8:

    # mc "*Risa* Estaba pensando en fichar a Meemaw para eso. *Risa* Al menos se mantendría activa y se sentiría útil."
    mc "*Rires* J'avais pensé à recruter Mémé pour ça. *Rires* Au moins, elle resterait active et se sentirait utile."

# game/scripts/c21/c21.rpy:2183
translate french c21s004_AmandaCoffee_8c8428b9:

    # mc "Además, evitaría tener que informar a más personas de los secretos familiares."
    mc "De plus, cela éviterait d'avoir à informer davantage de personnes des secrets de famille."

# game/scripts/c21/c21.rpy:2185
translate french c21s004_AmandaCoffee_a0fef5fc:

    # ama "Los secretos parece que van a dejar de serlos. He hablado con [aar] esta mañana. ¿Ha conseguido contactar contigo?"
    ama "Les secrets semblent sur le point d'être révélés. J'ai parlé avec [aar] ce matin. A-t-il réussi à vous contacter ?"

# game/scripts/c21/c21.rpy:2186
translate french c21s004_AmandaCoffee_7ff06615:

    # mc "Sí, hemos estado hablando sobre la compañía que quiere comprar NTR... ¿Iron Fist se llamaban?"
    mc "Oui, nous parlions de la société qui veut racheter NTR... Elle s'appelait Iron Fist ?"

# game/scripts/c21/c21.rpy:2188
translate french c21s004_AmandaCoffee_f7182efb:

    # ama "Sí, son unos capullos, aunque efectivos."
    ama "Oui, ce sont des crétins, mais ils sont efficaces."

# game/scripts/c21/c21.rpy:2189
translate french c21s004_AmandaCoffee_8b2a1015:

    # ama "Su concepto de operaciones encubiertas es que si no hay supervivientes nadie puede informar. Tienen la sutileza de un ariete... o de [emm]."
    ama "Leur conception des opérations clandestines repose sur le principe suivant : s'il n'y a pas de survivants, personne ne peut faire de rapport. Leur subtilité est comparable à celle d'un bélier… ou d'un détonateur C2."

# game/scripts/c21/c21.rpy:2190
translate french c21s004_AmandaCoffee_a53a432a:

    # mc "*Risa* No es la primera vez que comparan la sutileza de [emm] con un ariete."
    mc "*Rires* Ce n'est pas la première fois que la subtilité de [emm] est comparée à un bélier."

# game/scripts/c21/c21.rpy:2191
translate french c21s004_AmandaCoffee_82069f6e:

    # mc "Pero hablando de Iron Fist, tienen que ser enormes si pueden pagar los nueve o diez dígitos que [aar] dijo que valía NTR."
    mc "Mais en parlant d'Iron Fist, ils doivent être énormes s'ils peuvent payer les neuf ou dix chiffres que [aar] disait que NTR valait."

# game/scripts/c21/c21.rpy:2193
translate french c21s004_AmandaCoffee_136c728f:

    # ama "No, no lo son. Son grandes, pero más pequeños que nosotros. Quieren aprovechar el vacío de poder para comprar NTR por una fracción de su valor."
    ama "Non, pas du tout. Ils sont importants, mais plus petits que nous. Ils veulent profiter du vide du pouvoir pour racheter NTR à un prix dérisoire."

# game/scripts/c21/c21.rpy:2194
translate french c21s004_AmandaCoffee_ae964a75:

    # ama "Comprarnos casi triplicaría su cifra de negocio y les proporcionaría contratos a los que no tienen acceso ahora mismo."
    ama "Notre rachat triplerait presque leur chiffre d'affaires et leur donnerait accès à des contrats auxquels ils n'ont actuellement pas accès."

# game/scripts/c21/c21.rpy:2195
translate french c21s004_AmandaCoffee_4929bee7:

    # ama "Su negocio de operaciones especiales es algo menos de la mitad del nuestro. Y estamos hablando de cientos de millones."
    ama "Leur activité dans les opérations spéciales représente un peu moins de la moitié de la nôtre. Et on parle de centaines de millions."

# game/scripts/c21/c21.rpy:2196
translate french c21s004_AmandaCoffee_2e7db18d:

    # mc "Eso es un montón de dinero. ¿Tantas operaciones especiales se hacen?"
    mc "C'est une somme considérable. Autant d'opérations spéciales sont-elles menées ?"

# game/scripts/c21/c21.rpy:2198
translate french c21s004_AmandaCoffee_a148b45a:

    # ama "Se hacen muchas. Y son caras. Iron Fist trabaja mucho con los gobiernos de países que Estados Unidos no considera amigables."
    ama "Il en existe beaucoup. Et elles sont chères. Iron Fist collabore étroitement avec les gouvernements de pays que les États-Unis ne considèrent pas comme amis."

# game/scripts/c21/c21.rpy:2199
translate french c21s004_AmandaCoffee_19c56fe5:

    # ama "Por eso no tienen acceso a algunos contratos."
    ama "C'est pourquoi ils n'ont pas accès à certains contrats."

# game/scripts/c21/c21.rpy:2201
translate french c21s004_AmandaCoffee_54f98cb9:

    # ama "Los clientes principales de NTR son precisamente Estados Unidos y otros países occidentales que no se quieren manchar las manos haciendo algunas cosas."
    ama "Les principaux clients de NTR sont précisément les États-Unis et d'autres pays occidentaux qui ne veulent pas se salir les mains pour certaines choses."

# game/scripts/c21/c21.rpy:2202
translate french c21s004_AmandaCoffee_0c7e8fb7:

    # ama "Pagan MUY bien por evitar salir en la prensa si algo sale mal."
    ama "Ils paient très bien pour éviter d'apparaître dans la presse en cas de problème."

# game/scripts/c21/c21.rpy:2203
translate french c21s004_AmandaCoffee_01b2a114:

    # mc "Lo entiendo. Como una misión en Burkina Faso donde envían a dos niñas de 14 años. Quedaría mal en la prensa si se emborrachan."
    mc "Je comprends. Comme cette mission au Burkina Faso où ils envoient deux jeunes filles de 14 ans. Si elles s'enivraient, ça ferait mauvaise presse."

# game/scripts/c21/c21.rpy:2205
translate french c21s004_AmandaCoffee_6298a0d4:

    # ama "Sí, a eso me refiero. Esa misión no la podían hacer los Navy SEAL. *Risa* Y no solo porque Burkina no tenga mar."
    ama "Oui, c'est exactement ce que je veux dire. Les Navy SEALs n'auraient pas pu accomplir cette mission. *Rires* Et pas seulement parce que le Burkina Faso n'a pas de mer."

# game/scripts/c21/c21.rpy:2206
translate french c21s004_AmandaCoffee_2534901f:

    # ama "Y por eso quería hablar contigo sobre el futuro de NTR. He hecho algunos números con la información que me ha enviado [aar]..."
    ama "C'est pourquoi je voulais vous parler de l'avenir de NTR. J'ai fait quelques calculs avec les informations que vous m'avez envoyées [aar]..."

# game/scripts/c21/c21.rpy:2207
translate french c21s004_AmandaCoffee_98fe2261:

    # mc "Déjame pedir un café y me lo explicas."
    mc "Laissez-moi commander un café et vous pourrez me l'expliquer."

# game/scripts/c21/c21.rpy:2209
translate french c21s004_AmandaCoffee_86475cc1:

    # "[ama] pasa unos 20 minutos explicándote la situación del negocio, hasta que llega a la parte más interesante. El dinero."
    "[ama] passe environ 20 minutes à expliquer la situation commerciale, jusqu'à ce qu'il arrive à la partie la plus intéressante : l'argent."

# game/scripts/c21/c21.rpy:2211
translate french c21s004_AmandaCoffee_472a8405:

    # ama "La parte médica de la compañía es el 12%% de la facturación global de NTR. El 71%% de la facturación proviene de operaciones de Seguridad."
    ama "La division médicale de l'entreprise représente 12%% du chiffre d'affaires mondial de NTR. Les activités de sécurité représentent 71%% de ce chiffre d'affaires."

# game/scripts/c21/c21.rpy:2212
translate french c21s004_AmandaCoffee_6b6de5d5:

    # ama "Puedes ver aquí la mala noticia. La parte médica es la que menos dinero da. Es imposible basar la compañía sólo en eso ahora mismo."
    ama "Vous voyez le problème : la division médicale est la moins rentable. Il est impossible, pour l’instant, de fonder l’entreprise uniquement sur ce segment."

# game/scripts/c21/c21.rpy:2213
translate french c21s004_AmandaCoffee_1ada89a7:

    # mc "¿Qué es ese concepto? ¿Servicios de Apoyo?"
    mc "De quel concept s'agit-il ? Services de soutien ?"

# game/scripts/c21/c21.rpy:2215
translate french c21s004_AmandaCoffee_4f41ba3a:

    # ama "Alquiler de Equipos y Soporte Logístico, básicamente. A otras compañías como NTR, pero más pequeñas. Transporte de operativos, alquiler de equipos, etc."
    ama "Nous proposons principalement des services de location de matériel et de soutien logistique. Nous apportons également notre soutien à d'autres entreprises comme NTR, mais à plus petite échelle. Cela inclut le transport de personnel, la location de matériel, etc."

# game/scripts/c21/c21.rpy:2216
translate french c21s004_AmandaCoffee_c15671a1:

    # mc "¿Podríamos mantener esa parte de la Compañía? No nos involucraríamos en Operaciones Especiales con eso, ¿no?"
    mc "Pourrions-nous conserver cette partie de l'entreprise ? Nous ne nous impliquerions pas dans des opérations spéciales avec elle, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:2218
translate french c21s004_AmandaCoffee_0e46556c:

    # ama "Déjame mirar una cosa..."
    ama "Permettez-moi d'examiner une chose..."

# game/scripts/c21/c21.rpy:2219
translate french c21s004_AmandaCoffee_467f4d49:

    # ama "No sería difícil de hacer. Tenemos los contactos y, si dejamos de ser su competencia, otras compañías podrían requerir nuestros servicios."
    ama "Ce ne serait pas difficile. Nous avons les contacts nécessaires, et si nous cessions d'être leurs concurrents, d'autres entreprises pourraient avoir besoin de nos services."

# game/scripts/c21/c21.rpy:2221
translate french c21s004_AmandaCoffee_e03e8c16:

    # ama "Bien pensado, pero habría que estudiarlo bien. Y no, no nos involucramos en las operaciones de otras compañías. Solo les damos apoyo."
    ama "C'est une bonne idée, mais elle nécessiterait une étude approfondie. Et non, nous ne nous immisçons pas dans les activités d'autres entreprises. Nous leur apportons seulement notre soutien."

# game/scripts/c21/c21.rpy:2222
translate french c21s004_AmandaCoffee_992f61f5:

    # mc "Dale trabajo a [aar]. *Risa* Creo que, de momento, sería bueno mantener esa fuente de ingresos."
    mc "Donnez un emploi à [aar]. *Rires* Je pense que, pour le moment, il serait bon de maintenir cette source de revenus."

# game/scripts/c21/c21.rpy:2223
translate french c21s004_AmandaCoffee_bc05e904:

    # mc "Has dicho que es la mala noticia. ¿Hay una buena?"
    mc "Vous avez dit que c'était la mauvaise nouvelle. Y a-t-il de bonnes nouvelles ?"

# game/scripts/c21/c21.rpy:2225
translate french c21s004_AmandaCoffee_5d5c4dac:

    # ama "Sí, esta. Y con lo que acabas de decir de mantener los Servicios de Apoyo, es incluso mejor."
    ama "Oui, celui-ci. Et compte tenu de ce que vous venez de dire concernant le maintien des services d'assistance, c'est encore mieux."

# game/scripts/c21/c21.rpy:2226
translate french c21s004_AmandaCoffee_b76726e1:

    # ama "La facturación crece en las tres áreas cada año, pero el crecimiento en el área de Seguridad es casi residual, entre un 2%% y un 5%%."
    ama "Le chiffre d'affaires augmente chaque année dans les trois domaines, mais la croissance dans le domaine de la sécurité est presque négligeable, entre 2%% et 5%%."

# game/scripts/c21/c21.rpy:2227
translate french c21s004_AmandaCoffee_c9bfcae3:

    # ama "El crecimiento en los Servicios de Apoyo es de entre un 15%% y un 18%% anual."
    ama "La croissance des services de soutien se situe entre 15%% et 18%% par an."

# game/scripts/c21/c21.rpy:2228
translate french c21s004_AmandaCoffee_5ac46d50:

    # mc "Eso es una barbaridad de crecimiento."
    mc "C'est une croissance incroyable."

# game/scripts/c21/c21.rpy:2230
translate french c21s004_AmandaCoffee_f4f742b4:

    # ama "La facturación de la parte médica crece entre el 50%% y el 60%%. Y acelerando. Hemos empezado muy abajo y es fácil crecer."
    ama "Le chiffre d'affaires de la division médicale progresse de 50%% à 60%% et cette croissance s'accélère. Nous sommes partis d'une base très modeste, et la croissance est facile."

# game/scripts/c21/c21.rpy:2231
translate french c21s004_AmandaCoffee_b400262a:

    # ama "Es la partida más pequeña, pero el año que viene seguramente superará a los Servicios de Apoyo."
    ama "C'est le poste le plus petit, mais l'année prochaine, il surpassera certainement les services d'assistance."

# game/scripts/c21/c21.rpy:2232
translate french c21s004_AmandaCoffee_0bbcecef:

    # mc "Déjame hacer unos cálculos..."
    mc "Laissez-moi faire quelques calculs..."

# game/scripts/c21/c21.rpy:2234
translate french c21s004_AmandaCoffee_72a4dfa7:

    # mc "En cinco años, con ese ritmo de crecimiento, podría ser la principal área de negocio."
    mc "Dans cinq ans, à ce rythme de croissance, cela pourrait devenir le principal secteur d'activité."

# game/scripts/c21/c21.rpy:2235
translate french c21s004_AmandaCoffee_6a6d173c:

    # ama "Y en dos años, combinada con los Servicios de Apoyo, superarían al área de Seguridad. Yo también he hecho los cálculos."
    ama "Et en deux ans, en incluant les services d'assistance, ils dépasseraient le secteur de la sécurité. J'ai fait les calculs moi aussi."

# game/scripts/c21/c21.rpy:2237
translate french c21s004_AmandaCoffee_e0adb9a3:

    # "[ama] pasa los siguientes minutos explicándote todos los cálculos que ha hecho y cómo su plan puede ser realizable."
    "[ama] passe les minutes suivantes à expliquer tous les calculs qu'il a effectués et comment son plan peut être mis en œuvre."

# game/scripts/c21/c21.rpy:2238
translate french c21s004_AmandaCoffee_27e2028b:

    # "A veces tiene que parar para hacer algún cálculo nuevo debido a la posibilidad de mantener los Servicios de Apoyo."
    "Il doit parfois s'interrompre pour effectuer de nouveaux calculs en raison de la nécessité de maintenir les services de support."

# game/scripts/c21/c21.rpy:2239
translate french c21s004_AmandaCoffee_cf440c51:

    # "Son cálculos que aburrirían a cualquiera que no fuera un empollón. Por suerte ambos lo sois."
    "Ce sont des calculs qui ennuieraient n'importe qui, sauf peut-être un intello. Heureusement pour vous, vous l'êtes tous les deux."

# game/scripts/c21/c21.rpy:2241
translate french c21s004_AmandaCoffee_36ef2119:

    # ama "Y eso sería todo. Creo que, económicamente, el plan es realizable."
    ama "Et ce sera tout. Je crois que le plan est économiquement réalisable."

# game/scripts/c21/c21.rpy:2242
translate french c21s004_AmandaCoffee_44943cd0:

    # mc "Le veo un problema. ¿Qué hacemos con vosotras? ¿Y con los XY?"
    mc "Je vois un problème. Que fait-on de vous ? Et des XY ?"

# game/scripts/c21/c21.rpy:2244
translate french c21s004_AmandaCoffee_a5795415:

    # ama "También he pensado en eso, pero necesito modificarlo."
    ama "J'y ai pensé aussi, mais je dois le modifier."

# game/scripts/c21/c21.rpy:2245
translate french c21s004_AmandaCoffee_e53d4110:

    # ama "No estoy segura de que todos los XY quieran abandonar la vida que llevan. Las misiones dan mucha adrenalina, son como una droga."
    ama "Je ne suis pas sûr que tous les XY souhaitent renoncer à leur vie actuelle. Les missions procurent une montée d'adrénaline intense, comme une drogue."

# game/scripts/c21/c21.rpy:2246
translate french c21s004_AmandaCoffee_e342d899:

    # mc "Pero vosotras sí que queréis dejar esas misiones."
    mc "Mais vous souhaitez quitter ces missions."

# game/scripts/c21/c21.rpy:2248
translate french c21s004_AmandaCoffee_10dcc7de:

    # ama "Nosotras somos diferentes. Envejecemos a un ritmo normal. Ellos saben que tienen una juventud limitada y querrán sacarle el máximo partido."
    ama "Nous sommes différents. Nous vieillissons à un rythme normal. Ils savent que leur jeunesse est limitée et voudront en profiter au maximum."

# game/scripts/c21/c21.rpy:2249
translate french c21s004_AmandaCoffee_55c23b04:

    # ama "[eva] y yo nos conformaríamos con un trabajo normal."
    ama "[eva] et je serais content d'un travail normal."

# game/scripts/c21/c21.rpy:2250
translate french c21s004_AmandaCoffee_dda27f5f:

    # mc "¿Como jefas de seguridad de la base, por ejemplo? Había pensado en eso como opción. En el fondo, la empresa también es vuestra."
    mc "En tant que responsable de la sécurité de la base, par exemple ? J’avais envisagé cette possibilité. Au final, l’entreprise vous appartient aussi."

# game/scripts/c21/c21.rpy:2252
translate french c21s004_AmandaCoffee_99e64c93:

    # ama "¿Qué? ¡No! ¿Por qué quieres hacernos esto?"
    ama "Quoi ? Non ! Pourquoi voulez-vous nous faire ça ?"

# game/scripts/c21/c21.rpy:2253
translate french c21s004_AmandaCoffee_44b2bddf:

    # mc "¿Qué? ¿Haceros qué?"
    mc "Quoi ? Faire quoi ?"

# game/scripts/c21/c21.rpy:2255
translate french c21s004_AmandaCoffee_4254531d:

    # ama "¡Mandarnos lejos!"
    ama "Renvoie-nous au loin !"

# game/scripts/c21/c21.rpy:2256
translate french c21s004_AmandaCoffee_7e3a8c72:

    # ama "¡Os acabamos de encontrar!"
    ama "Nous venons de vous trouver !"

# game/scripts/c21/c21.rpy:2258
translate french c21s004_AmandaCoffee_3a65f1d9:

    # ama "¡[eva] y yo incluso hemos resuelto nuestras diferencias respecto a ti!"
    ama "[eva] et moi avons même réglé nos différends à ton sujet !"

# game/scripts/c21/c21.rpy:2259
translate french c21s004_AmandaCoffee_1024c403:

    # mc "No os quiero mandar lejos, [ama]. Yo también voy a ir a Aruba."
    mc "Je ne veux pas t'envoyer loin, [ama]. Je vais aussi à Aruba."

# game/scripts/c21/c21.rpy:2261
translate french c21s004_AmandaCoffee_44557789:

    # ama "Pero tu volverás... y nosotras, si somos las jefas de seguridad, nos tendremos que quedar allí..."
    ama "Mais vous reviendrez… et nous, si nous sommes responsables de la sécurité, nous devrons rester là…"

# game/scripts/c21/c21.rpy:2274
translate french c21s004_AmandaCoffee_532effae:

    # mc "También necesitaremos a alguien que proteja a los accionistas, ¿no?"
    mc "Il nous faudra aussi quelqu'un pour protéger les actionnaires, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:2275
translate french c21s004_AmandaCoffee_87cbbccf:

    # mc "Y no se me ocurre nadie mejor que vosotras. Podéis turnaros, no sé... ¿Una semana cada una en Aruba mientras la otra está aquí con la familia?"
    mc "Et je ne vois personne de mieux que vous deux. Vous pourriez alterner, je ne sais pas… Une semaine chacun à Aruba pendant que l’autre est ici avec la famille ?"

# game/scripts/c21/c21.rpy:2278
translate french c21s004_AmandaCoffee_fb44ec1f:

    # ama "Espera... has dicho que me quieres cerca de ti... ¿Significa eso que...?"
    ama "Attends... tu as dit que tu voulais que je sois près de toi... Ça veut dire...?"

# game/scripts/c21/c21.rpy:2279
translate french c21s004_AmandaCoffee_c1ad7533:

    # mc "Sí, [ama]. Significa que, si quieres, me encantaría salir contigo."
    mc "Oui, [ama]. Cela signifie que, si tu veux, j'adorerais sortir avec toi."

# game/scripts/c21/c21.rpy:2280
translate french c21s004_AmandaCoffee_ffd67f7e:

    # mc "Sólo estaba esperando a que [eva] y tú aclararais las cosas para decírtelo."
    mc "J'attendais juste que toi et [eva] clarifiiez les choses pour pouvoir te le dire."

# game/scripts/c21/c21.rpy:2282
translate french c21s004_AmandaCoffee_79933eac:

    # ama "¿Decírmelo? ¿Sólo a mí? ¿No quieres estar con [eva]?"
    ama "Dis-le-moi ? À moi seul ? Tu ne veux pas être avec [eva] ?"

# game/scripts/c21/c21.rpy:2283
translate french c21s004_AmandaCoffee_f87257ab:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "C'est quelque chose dont [eva] et moi devons parler. Seuls. Juste nous deux. Que je veuille être avec elle ou non."

# game/scripts/c21/c21.rpy:2284
translate french c21s004_AmandaCoffee_0d111a06:

    # ama "Lo entiendo..."
    ama "Je comprends..."

# game/scripts/c21/c21.rpy:2286
translate french c21s004_AmandaCoffee_bb3a07dc:

    # ama "¿Significa eso que... puedo besarte?"
    ama "Cela signifie-t-il que… je peux t’embrasser ?"

# game/scripts/c21/c21.rpy:2287
translate french c21s004_AmandaCoffee_4b26efe4:

    # mc "No, significa que ahora vamos a tirar las tazas al suelo y vamos a follar encima de la mesa. *Risa*"
    mc "Non, ça veut dire qu'on va jeter les tasses par terre et baiser sur la table. *Rires*"

# game/scripts/c21/c21.rpy:2289
translate french c21s004_AmandaCoffee_08e8d48b:

    # ama "¿Qué? ¿Ahora? ¿Aquí?"
    ama "Quoi ? Maintenant ? Ici ?"

# game/scripts/c21/c21.rpy:2290
translate french c21s004_AmandaCoffee_f67c14de:

    # mc "*Risa* Tenemos que trabajar en tu detección del sarcasmo."
    mc "*Rires* Il faut qu'on travaille sur votre détection du sarcasme."

# game/scripts/c21/c21.rpy:2292
translate french c21s004_AmandaCoffee_e0b1a77f:

    # mc "Claro que vamos a besarnos. ¿Me permites?"
    mc "Bien sûr qu'on va s'embrasser. Je peux ?"

# game/scripts/c21/c21.rpy:2295
translate french c21s004_AmandaCoffee_a122784e:

    # "[ama] se levanta como impulsada por un muelle y ataca tus labios con furia."
    "[ama] se lève comme propulsé par un ressort et attaque vos lèvres avec fureur."

# game/scripts/c21/c21.rpy:2296
translate french c21s004_AmandaCoffee_97e8eb5a:

    # "\"Atacar\" es la palabra adecuada."
    "« Attaque » est le mot juste."

# game/scripts/c21/c21.rpy:2297
translate french c21s004_AmandaCoffee_36b607be:

    # "Hay furia y pasión en su beso. Creías que iba a ser un beso tímido, pero no podías estar más equivocado."
    "Leur baiser est empreint de fureur et de passion. Tu t'attendais à un baiser timide, mais tu ne pouvais pas te tromper davantage."

# game/scripts/c21/c21.rpy:2298
translate french c21s004_AmandaCoffee_e5708729:

    # "Sólo se separa de tus labios cuando le falta el aire."
    "Elle ne se détache de vos lèvres que lorsqu'elle est à court d'air."

# game/scripts/c21/c21.rpy:2301
translate french c21s004_AmandaCoffee_e8e43958:

    # ama "¡Wow!"
    ama "Ouah!"

# game/scripts/c21/c21.rpy:2302
translate french c21s004_AmandaCoffee_08f7d3ff:

    # mc "*Risa* Estoy de acuerdo. ¡Wow!"
    mc "*Rires* Je suis d'accord. Waouh !"

# game/scripts/c21/c21.rpy:2304
translate french c21s004_AmandaCoffee_c89321d1:

    # ama "*Risa* No te rías de mí. Llevo días queriendo hacer esto..."
    ama "*Rires* Ne vous moquez pas de moi. J'avais tellement envie de faire ça depuis des jours..."

# game/scripts/c21/c21.rpy:2306
translate french c21s004_AmandaCoffee_21ef5df9:

    # ama "¿Sabes cuando quieres algo durante mucho tiempo y lo consigues...? ¿Ese sentimiento de decepción? ¿De vacío al cumplir el objetivo?"
    ama "Vous connaissez cette sensation, quand vous désirez quelque chose depuis longtemps et que vous l'obtenez enfin… ? Ce sentiment de déception ? De vide une fois votre objectif atteint ?"

# game/scripts/c21/c21.rpy:2307
translate french c21s004_AmandaCoffee_d5415aec:

    # mc "Sí, conozco ese sentimiento. ¿Decepcionada?"
    mc "Oui, je connais ce sentiment. Déçu(e) ?"

# game/scripts/c21/c21.rpy:2309
translate french c21s004_AmandaCoffee_f6769de9:

    # ama "*Risa* Tenemos que trabajar en tu costumbre de interrumpir a la gente cuando habla."
    ama "*Rires* Il faut qu'on travaille sur ton habitude d'interrompre les gens quand ils parlent."

# game/scripts/c21/c21.rpy:2310
translate french c21s004_AmandaCoffee_6eb8b13a:

    # ama "Quería decir que esperaba ese sentimiento, pero no se ha dado. *Risa* Al revés. Tengo ganas de ignorar tu sarcasmo y tirar las tazas al suelo."
    ama "Je voulais dire que je m'attendais à ressentir ça, mais ça n'a pas été le cas. *Rires* Bien au contraire. J'ai envie d'ignorer ton sarcasme et de jeter les tasses par terre."

# game/scripts/c21/c21.rpy:2311
translate french c21s004_AmandaCoffee_2612622a:

    # mc "*Risa* Tengo que ser una bestia besando."
    mc "*Rires* Je dois être un monstre en matière de baisers."

# game/scripts/c21/c21.rpy:2313
translate french c21s004_AmandaCoffee_a565ca82:

    # ama "*Risa* No voy a decir ni que sí ni que no. No quiero alimentar tu ego más de lo que ya lo está."
    ama "*Rires* Je ne vais pas dire oui ni non. Je ne veux pas flatter davantage votre ego."

# game/scripts/c21/c21.rpy:2315
translate french c21s004_AmandaCoffee_6c486a00:

    # "Te da un rápido beso."
    "Il te donne un baiser rapide."

# game/scripts/c21/c21.rpy:2316
translate french c21s004_AmandaCoffee_69881554:

    # ama "Siéntate donde estabas, voy al lavabo un momento y seguimos con la reunión."
    ama "Retournez à votre place, je vais aux toilettes un instant et nous reprendrons la réunion ensuite."

# game/scripts/c21/c21.rpy:2317
translate french c21s004_AmandaCoffee_3e89e8ed:

    # mc "¿No quieres que me siente a tu lado?"
    mc "Tu ne veux pas que je m'assoie à côté de toi ?"

# game/scripts/c21/c21.rpy:2318
translate french c21s004_AmandaCoffee_3d50c3d3:

    # ama "Sí, pero si lo haces no vamos a poder acabar con lo que hemos venido a hacer. Si hay una mesa entre los dos puedo mantener la cabeza centrada en la reunión."
    ama "Oui, mais si vous faites cela, nous ne pourrons pas terminer ce que nous sommes venus faire. S'il y a une table entre nous, je pourrai me concentrer sur la réunion."

# game/scripts/c21/c21.rpy:2320
translate french c21s004_AmandaCoffee_412cc044:

    # ama "Más o menos."
    ama "Plus ou moins."

# game/scripts/c21/c21.rpy:2323
translate french c21s004_AmandaCoffee_23c48176:

    # ama "Espera... Has dicho que quieres que forme parte de la familia, pero no has dicho nada de nosotros."
    ama "Attends… Tu as dit que tu voulais que je fasse partie de la famille, mais tu n’as rien dit à notre sujet."

# game/scripts/c21/c21.rpy:2324
translate french c21s004_AmandaCoffee_3289a10b:

    # ama "¿Significa eso que tú y yo...?"
    ama "Cela signifie-t-il que toi et moi...?"

# game/scripts/c21/c21.rpy:2325
translate french c21s004_AmandaCoffee_d27eeaf8:

    # mc "Significa que quiero que formes parte de nuestras vidas. Me caes muy bien, [ama], pero a diferencia de ti, te conozco tan solo desde hace unos días."
    mc "Cela signifie que je souhaite que tu fasses partie de nos vies. Je t'apprécie beaucoup, [ama], mais contrairement à toi, je ne te connais que depuis quelques jours."

# game/scripts/c21/c21.rpy:2327
translate french c21s004_AmandaCoffee_eb151802:

    # mc "No he tenido tiempo de desarrollar sentimientos por ti, y... no creo que lo haga en el futuro. Al menos no como tú quieres."
    mc "Je n'ai pas eu le temps d'éprouver des sentiments pour toi, et… je ne pense pas que ce sera le cas à l'avenir. Du moins, pas comme tu le souhaites."

# game/scripts/c21/c21.rpy:2328
translate french c21s004_AmandaCoffee_c6d41377:

    # mc "Despiertas en mí un sentimiento de protección, pero no uno romántico."
    mc "Tu éveilles en moi un sentiment de protection, mais pas un sentiment romantique."

# game/scripts/c21/c21.rpy:2329
translate french c21s004_AmandaCoffee_59e887db:

    # mc "No quiero darte falsas esperanzas. Creo que tengo que ser sincero sobre eso."
    mc "Je ne veux pas vous donner de faux espoirs. Je pense qu'il est important d'être honnête à ce sujet."

# game/scripts/c21/c21.rpy:2330
translate french c21s004_AmandaCoffee_a242232e:

    # mc "Que [eva] y tú hayáis tardado tanto en resolver vuestras diferencias, me ha dado tiempo a mí para examinar lo que siento hacia vosotras."
    mc "Le fait que [eva] et toi ayez mis autant de temps à régler vos différends m'a donné le temps d'examiner mes sentiments à ton égard."

# game/scripts/c21/c21.rpy:2332
translate french c21s004_AmandaCoffee_f63e1d87:

    # ama "Lo entiendo y te agradezco la sinceridad..."
    ama "Je comprends et j'apprécie votre honnêteté..."

# game/scripts/c21/c21.rpy:2333
translate french c21s004_AmandaCoffee_6c772ee3:

    # ama "¿Te pasa lo mismo con [eva]? No sé si te va a arrancar la cabeza si le dices algo así."
    ama "As-tu le même problème avec [eva] ? Je ne sais pas s'il te fera une scène si tu lui dis un truc pareil."

# game/scripts/c21/c21.rpy:2334
translate french c21s004_AmandaCoffee_f87257ab_1:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "C'est quelque chose dont [eva] et moi devons parler. Seuls. Juste nous deux. Que je veuille être avec elle ou non."

# game/scripts/c21/c21.rpy:2336
translate french c21s004_AmandaCoffee_5d7ed353:

    # ama "Tienes razón, no debería inmiscuirme."
    ama "Vous avez raison, je ne devrais pas m'en mêler."

# game/scripts/c21/c21.rpy:2337
translate french c21s004_AmandaCoffee_4a3807a0:

    # ama "Dame un segundo, voy al lavabo."
    ama "Donnez-moi une seconde, je vais aux toilettes."

# game/scripts/c21/c21.rpy:2338
translate french c21s004_AmandaCoffee_3c72afc8:

    # mc "El tiempo que necesites."
    mc "Tout le temps dont vous avez besoin."

# game/scripts/c21/c21.rpy:2340
translate french c21s004_AmandaCoffee_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c21/c21.rpy:2341
translate french c21s004_AmandaCoffee_11e8caa8:

    # ama "Volviendo al tema de los XY..."
    ama "Pour revenir au sujet de XY..."

# game/scripts/c21/c21.rpy:2342
translate french c21s004_AmandaCoffee_2bc208ce:

    # mc "¿No quieres hablar de lo que acaba de pasar?"
    mc "Tu ne veux pas parler de ce qui vient de se passer ?"

# game/scripts/c21/c21.rpy:2344
translate french c21s004_AmandaCoffee_2e791067:

    # ama "Prefiero no hacerlo ahora. Tenemos que acabar esto y tengo que relevar a [eva]."
    ama "Je préférerais ne pas le faire maintenant. Nous devons terminer cela, et je dois relever [eva]."

# game/scripts/c21/c21.rpy:2346
translate french c21s004_AmandaCoffee_434b87cf:

    # ama "Si empiezo a hablar de lo que ha pasado, no vamos a parar y voy a pasarme horas besándote."
    ama "Si je commence à parler de ce qui s'est passé, on ne s'arrêtera plus et je passerai des heures à t'embrasser."

# game/scripts/c21/c21.rpy:2347
translate french c21s004_AmandaCoffee_38c8e290:

    # ama "Tendremos mucho tiempo para hablar cuando llegue el momento. Ahora tenemos una reunión que terminar."
    ama "Nous aurons tout le temps d'en parler le moment venu. Pour l'instant, nous avons une réunion à terminer."

# game/scripts/c21/c21.rpy:2349
translate french c21s004_AmandaCoffee_13d3336d:

    # ama "No tiene sentido hablarlo. Sentimos cosas diferentes por el otro, pero ni quiero ni puedo forzarte a sentir lo que siento yo."
    ama "Ça ne sert à rien d'en parler. Nous éprouvons des sentiments différents l'un pour l'autre, mais je ne veux ni ne peux te forcer à ressentir ce que je ressens."

# game/scripts/c21/c21.rpy:2350
translate french c21s004_AmandaCoffee_815b5864:

    # ama "No me debes ninguna explicación ni yo la quiero, pero tenemos una reunión que terminar."
    ama "Vous ne me devez aucune explication, et je n'en veux pas, mais nous avons une réunion à terminer."

# game/scripts/c21/c21.rpy:2351
translate french c21s004_AmandaCoffee_3aff1176:

    # mc "De acuerdo, sigamos entonces."
    mc "Très bien, continuons alors."

# game/scripts/c21/c21.rpy:2353
translate french c21s004_AmandaCoffee_87d6d455:

    # ama "Contamos con 109 efectivos XY operativos ahora mismo. Aparte de eso hay 19 inoperativos."
    ama "Nous comptons actuellement 109 membres du personnel XY opérationnels. Par ailleurs, 19 membres du personnel sont hors service."

# game/scripts/c21/c21.rpy:2354
translate french c21s004_AmandaCoffee_b23bbd8c:

    # ama "En los próximos diez años, 461 más completarán su crecimiento y formación."
    ama "Au cours des dix prochaines années, 461 autres personnes achèveront leur formation et leur développement."

# game/scripts/c21/c21.rpy:2355
translate french c21s004_AmandaCoffee_29bf8ed0:

    # mcp "(Acaba de aparecer la [ama] fría y profesional para separarse emocionalmente de lo que acaba de pasar.)"
    mcp "(Son attitude froide et professionnelle semblait trahir une certaine distance émotionnelle avec ce qui venait de se passer.)"

# game/scripts/c21/c21.rpy:2357
translate french c21s004_AmandaCoffee_aa1e9894:

    # ama "Como ya te he dicho, si les damos opciones, no todos van a querer abandonar las Operaciones Especiales."
    ama "Comme je vous l'ai déjà dit, si nous leur donnons le choix, tout le monde ne voudra pas quitter les forces spéciales."

# game/scripts/c21/c21.rpy:2358
translate french c21s004_AmandaCoffee_b86fa212:

    # ama "Pero podremos reubicar a la mayoría en operaciones de Apoyo o en seguridad de la base, especialmente a los nuevos."
    ama "Mais nous pourrons en redéployer la plupart vers les opérations de soutien ou la sécurité des bases, notamment les nouveaux."

# game/scripts/c21/c21.rpy:2359
translate french c21s004_AmandaCoffee_e578e9b6:

    # mc "Creo que tenemos que darles la opción de decidir. Tienen tanto derecho como tú o como yo."
    mc "Je pense qu'il faut leur laisser la possibilité de décider. Ils ont autant de droits que vous et moi."

# game/scripts/c21/c21.rpy:2360
translate french c21s004_AmandaCoffee_a917d171:

    # mc "Incluso si quieren desvincularse totalmente de NTR deberíamos aceptarlo."
    mc "Même s'ils souhaitent se dissocier complètement de NTR, nous devrions l'accepter."

# game/scripts/c21/c21.rpy:2361
translate french c21s004_AmandaCoffee_843a0f18:

    # mc "¿Cuánta seguridad necesitamos en la base?"
    mc "De quel niveau de sécurité avons-nous besoin à la base ?"

# game/scripts/c21/c21.rpy:2363
translate french c21s004_AmandaCoffee_7824fc7a:

    # ama "Ahora mismo hay 36 en tres turnos. Casi todos de las Series J y K, la última y la próxima en ser considerada operativa. Les sirve como entrenamiento."
    ama "Actuellement, 36 personnes sont en service, réparties en trois équipes. Presque toutes travaillent sur les séries J et K, les plus récentes et les prochaines à être opérationnelles. Ce matériel leur sert de formation."

# game/scripts/c21/c21.rpy:2365
translate french c21s004_AmandaCoffee_c2659771:

    # ama "Aquí puedes ver las estadísticas por series. De la K a la T todavía están en crecimiento y formación."
    ama "Vous trouverez ici les statistiques par série. Les séries K à T sont encore en développement et en croissance."

# game/scripts/c21/c21.rpy:2366
translate french c21s004_AmandaCoffee_42975966:

    # mc "Hay mucho rojo, incluso entre las series que no han entrado en servicio. Demasiado rojo."
    mc "Il y a beaucoup de rouge, même parmi les séries qui ne sont pas encore entrées en service. Trop de rouge."

# game/scripts/c21/c21.rpy:2367
translate french c21s004_AmandaCoffee_deb35d10:

    # ama "Alrededor del 7%% son bajas durante el entrenamiento, como Fiona. El resto son bajas operativas. Sumadas al entrenamiento, alrededor del 32%% son bajas."
    ama "Environ 7%% des victimes sont des blessés à l'entraînement, comme Fiona. Les autres sont des blessés en opération. En incluant les blessés à l'entraînement, le total des victimes s'élève à environ 32%%."

# game/scripts/c21/c21.rpy:2368
translate french c21s004_AmandaCoffee_d26ea785:

    # mc "Si seguimos con el entrenamiento, hay que cambiar los métodos. No quiero que niños pequeños mueran jugando con explosivos."
    mc "Si nous poursuivons cette formation, nous devons changer de méthodes. Je ne veux pas que de jeunes enfants meurent en jouant avec des explosifs."

# game/scripts/c21/c21.rpy:2369
translate french c21s004_AmandaCoffee_5f5b1891:

    # mc "Y me da lo mismo que tengan cuerpos de adultos. No quiero. Punto."
    mc "Et je me fiche qu'elles aient des corps d'adultes. Je n'en veux pas. Point final."

# game/scripts/c21/c21.rpy:2371
translate french c21s004_AmandaCoffee_a5965deb:

    # ama "Me sorprende la empatía que tienes hacia gente que no conoces."
    ama "Je suis surpris par l'empathie que vous manifestez envers des personnes que vous ne connaissez pas."

# game/scripts/c21/c21.rpy:2372
translate french c21s004_AmandaCoffee_dede75a0:

    # mc "Os conozco a [eva] y a ti. Y a [aar], aunque sea poco. Tengo suficiente."
    mc "Je te connais, toi et [eva]. Et [aar], même si ce n'est qu'un peu. J'en ai assez."

# game/scripts/c21/c21.rpy:2373
translate french c21s004_AmandaCoffee_d91b722c:

    # mc "¿Quién se encarga del entrenamiento ahora mismo?"
    mc "Qui est responsable de la formation actuellement ?"

# game/scripts/c21/c21.rpy:2375
translate french c21s004_AmandaCoffee_949531d5:

    # ama "Los C y los D, principalmente. Los entrenan como fueron entrenados ellos. Como fuimos entrenadas nosotras."
    ama "Les groupes C et D, principalement. Ils les forment comme ils ont été formés. Comme nous l'avons été."

# game/scripts/c21/c21.rpy:2376
translate french c21s004_AmandaCoffee_a4bf90de:

    # mc "Lo primero que quiero hacer cuando llegue a Aruba, entonces, es reunirme con los C y los D. Y quiero sus nombres. No quiero pensar en ellos como letras."
    mc "La première chose que je veux faire en arrivant à Aruba, c'est rencontrer les C et les D. Et je veux connaître leurs noms. Je ne veux pas les considérer comme de simples lettres."

# game/scripts/c21/c21.rpy:2378
translate french c21s004_AmandaCoffee_c07cbb22:

    # "Pasáis los siguientes minutos haciendo planes y números, modificando las ideas de [ama], ampliando la información que tienes sobre la empresa. Tomando más cafés."
    "Vous passez les minutes suivantes à élaborer des plans, à analyser des chiffres, à retravailler les idées de [ama] et à approfondir vos connaissances sur l'entreprise. Vous buvez aussi plus de café."

# game/scripts/c21/c21.rpy:2379
translate french c21s004_AmandaCoffee_337e57f0:

    # "Al cabo casi una hora, suena una alarma en el móvil de [ama]."
    "Au bout de presque une heure, une alarme retentit sur le téléphone portable de [ama]."

# game/scripts/c21/c21.rpy:2381
translate french c21s004_AmandaCoffee_c36b8809:

    # ama "Voy a tener que irme. Me toca relevar a [eva]. Lleva casi 30 horas sin dormir."
    ama "Je dois y aller. C'est à mon tour de le relayer. Il est réveillé depuis près de 30 heures."

# game/scripts/c21/c21.rpy:2382
translate french c21s004_AmandaCoffee_7a628fb8:

    # ama "Recopilaré todos los datos y te los mando. Supongo que en un par de días los tendré hechos."
    ama "Je vais rassembler toutes les données et vous les envoyer. Je pense que ce sera fait d'ici deux jours."

# game/scripts/c21/c21.rpy:2383
translate french c21s004_AmandaCoffee_7b2c571d:

    # mc "Genial. ¿Vais a venir a casa a cenar esta noche?"
    mc "Super. Tu viens dîner ce soir ?"

# game/scripts/c21/c21.rpy:2385
translate french c21s004_AmandaCoffee_45b1f444:

    # ama "Sí, hemos ido a comer, pero no estabas."
    ama "Oui, nous sommes allés manger au restaurant, mais tu n'étais pas là."

# game/scripts/c21/c21.rpy:2387
translate french c21s004_AmandaCoffee_250366b8:

    # mc "Ya sabes que había quedado para comer con [kia]."
    mc "Tu sais que j'avais prévu de déjeuner avec [kia]."

# game/scripts/c21/c21.rpy:2389
translate french c21s004_AmandaCoffee_debde37a:

    # mc "Ya sabes que tenía que llevar a [meg] a la estación de autobuses."
    mc "Tu sais que j'ai dû prendre le [meg] pour aller à la gare routière."

# game/scripts/c21/c21.rpy:2390
translate french c21s004_AmandaCoffee_a7810a76:

    # ama "Lo sé..."
    ama "Je sais..."

# game/scripts/c21/c21.rpy:2392
translate french c21s004_AmandaCoffee_97d1780f:

    # ama "Entonces te veo esta noche."
    ama "Alors je te verrai ce soir."

# game/scripts/c21/c21.rpy:2395
translate french c21s004_AmandaCoffee_f80d270f:

    # "[ama] se vuelve a lanzar a tus labios, esta vez sin el ansia del beso anterior. Sabe que vendrán más."
    "[ama] Il se jette à nouveau sur vos lèvres, cette fois sans l'empressement du baiser précédent. Il sait qu'il y en aura d'autres."

# game/scripts/c21/c21.rpy:2398
translate french c21s004_AmandaCoffee_b7bb21ab:

    # "Os dais un abrazo de despedida. Tácitamente, sin necesidad de palabras, habéis decidido que los besos de despedida están de más ahora que habéis aclarado que no estaréis juntos."
    "Vous vous donnez une étreinte d'adieu. Tacitement, sans avoir besoin de mots, vous avez décidé que les baisers d'adieu sont inutiles maintenant que vous avez clairement indiqué que vous ne serez plus ensemble."

# game/scripts/c21/c21.rpy:2400
translate french c21s004_AmandaCoffee_705a5ed1:

    # ama "Hasta la noche, [mc]."
    ama "Jusqu'à ce soir, [mc]."

# game/scripts/c21/c21.rpy:2402
translate french c21s004_AmandaCoffee_70d3a368:

    # mc "Hasta la noche, [ama]."
    mc "Jusqu'à ce soir, [ama]."

# game/scripts/c21/c21.rpy:2445
translate french c21s005_DebRun_f640654f:

    # "Al llegar a casa te encuentras con [deb.nick] en la puerta."
    "Quand tu rentres chez toi, tu trouves [deb.nick] à la porte."

# game/scripts/c21/c21.rpy:2447
translate french c21s005_DebRun_d207482f:

    # deb "Buenas tardes, [mc]."
    deb "Bonjour, [mc]."

# game/scripts/c21/c21.rpy:2450
translate french c21s005_DebRun_b822a602:

    # mc "Buenas tardes, cielo."
    mc "Bonjour, chérie."

# game/scripts/c21/c21.rpy:2452
translate french c21s005_DebRun_52bcb279:

    # mc "Buenas tardes, [deb.nick]."
    mc "Bonjour, [deb.nick]."

# game/scripts/c21/c21.rpy:2453
translate french c21s005_DebRun_b6945ea0:

    # mc "¿Sales a correr o vuelves ahora?"
    mc "Tu vas courir ou tu rentres déjà ?"

# game/scripts/c21/c21.rpy:2455
translate french c21s005_DebRun_d567ddad:

    # deb "Salgo ahora. Iba a ir al lago. [kim] y [kat] han salido hace un rato."
    deb "Je pars maintenant. J'allais au lac. [kim] et [kat] sont partis il y a un moment."

# game/scripts/c21/c21.rpy:2456
translate french c21s005_DebRun_54fd321b:

    # mc "Si me das cinco minutos para cambiarme, te acompaño."
    mc "Si vous me donnez cinq minutes pour me changer, je viendrai avec vous."

# game/scripts/c21/c21.rpy:2457
translate french c21s005_DebRun_289bde06:

    # deb "¡Genial! Te espero en la piscina. [lis] está allí."
    deb "Super ! Je t'attends à la piscine. [lis] est là."

# game/scripts/c21/c21.rpy:2460
translate french c21s005_DebRun_bbcbf13f:

    # mc "Hasta ahora."
    mc "Jusqu'à maintenant."

# game/scripts/c21/c21.rpy:2462
translate french c21s005_DebRun_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c21/c21.rpy:2463
translate french c21s005_DebRun_c68b29c7:

    # mc "Hola, [lis]."
    mc "Bonjour, [lis]."

# game/scripts/c21/c21.rpy:2464
translate french c21s005_DebRun_1e28d7f9:

    # lis "Hola, [mc]. No contéis conmigo para ir a correr. [deb.nick] estaba intentando convencerme."
    lis "Salut, [mc]. Je ne compte pas sur toi pour gagner. [deb.nick] essayait de me convaincre."

# game/scripts/c21/c21.rpy:2474
translate french c21s005_DebRun_19916109:

    # deb "[lis] prefiere quedarse leyendo y tomando el sol. *Risa*"
    deb "[lis] préfère rester chez elle à lire et à bronzer. *Rires*"

# game/scripts/c21/c21.rpy:2475
translate french c21s005_DebRun_0981270f:

    # mc "¿Qué estás leyendo?"
    mc "Que lisez-vous ?"

# game/scripts/c21/c21.rpy:2477
translate french c21s005_DebRun_be0e08a0:

    # lis "Teoría política. Alguien me hizo pensar el otro día en el Jazz Corner y lo he cogido de la biblioteca de la universidad."
    lis "Théorie politique. Quelqu'un m'a fait penser à Jazz Corner l'autre jour, et je l'ai emprunté à la bibliothèque universitaire."

# game/scripts/c21/c21.rpy:2478
