# game/scripts/c21/c21.rpy:2894
translate french c21s005_DebRun_c69382fa_1:

    # mc "Supongo que hoy ha decidido resolverlo."
    mc "Je suppose qu'il a décidé de régler le problème aujourd'hui."

# game/scripts/c21/c21.rpy:2896
translate french c21s005_DebRun_596e9ef8:

    # "Continuáis corriendo y charlando, adaptando el paso para que [kat] no llegue en condiciones deplorables a casa."
    "Vous continuez à courir et à bavarder, en ajustant votre rythme pour que [kat] n'arrive pas à la maison dans un état déplorable."

# game/scripts/c21/c21.rpy:2897
translate french c21s005_DebRun_61dbc307:

    # "Llegáis con tiempo suficiente para ducharos antes de cenar."
    "Vous arrivez suffisamment tôt pour prendre une douche avant le dîner."

# game/scripts/c21/c21.rpy:2904
translate french c21s005_DebLake_12065133:

    # deb "Pues nos hemos quedado solos..."
    deb "Eh bien, nous sommes tous seuls maintenant..."

# game/scripts/c21/c21.rpy:2907
translate french c21s005_DebLake_322b355d:

    # "En vez de responder, bajas la cabeza de [deb.nick] hasta tu altura y la besas apasionadamente."
    "Au lieu de répondre, vous baissez la tête de [deb.nick] à votre hauteur et l'embrassez passionnément."

# game/scripts/c21/c21.rpy:2909
translate french c21s005_DebLake_ec43ae26:

    # "Vuestras lenguas se entrelazan en un beso que habéis deseado repetir desde la noche en el club de jazz."
    "Vos langues s'entrelacent dans un baiser que vous avez rêvé de répéter depuis cette nuit au club de jazz."

# game/scripts/c21/c21.rpy:2910
translate french c21s005_DebLake_25287385:

    # "Los besos de buenos días son un pobre sustituto de los besos de verdad."
    "Les baisers du matin ne remplacent pas les vrais baisers."

# game/scripts/c21/c21.rpy:2911
translate french c21s005_DebLake_8ed87b8b:

    # "El beso en el camino ha sido algo rápido para quitaros el mono de la droga que son vuestros labios."
    "Le baiser en chemin était un moyen rapide d'atténuer le manque que vous ressentiez face à la drogue que représentaient vos lèvres."

# game/scripts/c21/c21.rpy:2912
translate french c21s005_DebLake_798a5658:

    # "Después de unos segundos, de unos siglos, os separáis reluctantemente."
    "Après quelques secondes, après quelques siècles, vous vous séparez à regret."

# game/scripts/c21/c21.rpy:2914
translate french c21s005_DebLake_bf33ba3a:

    # deb "*Respiración entrecortada* Tengo que quedarme a solas más veces contigo..."
    deb "*Respiration haletante* J'ai besoin d'être seul avec toi plus souvent..."

# game/scripts/c21/c21.rpy:2915
translate french c21s005_DebLake_e4b9f52d:

    # mc "Siempre que quieras. Sabes donde vivo y donde duermo. *Risa*"
    mc "Quand tu veux. Tu sais où j'habite et où je dors. *Rires*"

# game/scripts/c21/c21.rpy:2917
translate french c21s005_DebLake_47e1ce00:

    # deb "Sabes que no estoy preparada para dormir contigo todavía..."
    deb "Tu sais que je ne suis pas encore prête à coucher avec toi..."

# game/scripts/c21/c21.rpy:2918
translate french c21s005_DebLake_b2efa7ea:

    # mc "[deb.nick], me refería a que puedes venir cuando quieras a por más besos, no a que te quedaras a dormir."
    mc "[deb.nick], je voulais dire que tu peux venir quand tu veux pour plus de baisers, pas que tu dois rester toute la nuit."

# game/scripts/c21/c21.rpy:2920
translate french c21s005_DebLake_7230aabd:

    # deb "¡Oh! ¡Eso sí que puedo hacerlo! No sé por qué no se me había ocurrido."
    deb "Oh ! Je peux faire ça ! Je ne sais pas pourquoi je n'y avais pas pensé avant."

# game/scripts/c21/c21.rpy:2921
translate french c21s005_DebLake_519a871b:

    # mc "Además, ahora todo el mundo sabe que estamos juntos. Podemos besarnos donde queramos."
    mc "En plus, maintenant tout le monde sait qu'on est ensemble. On peut s'embrasser où on veut."

# game/scripts/c21/c21.rpy:2923
translate french c21s005_DebLake_31423815:

    # deb "Nunca me he sentido cómoda alrededor de parejas que se pasan el día besándose."
    deb "Je ne me suis jamais sentie à l'aise en présence de couples qui passent toute la journée à s'embrasser."

# game/scripts/c21/c21.rpy:2924
translate french c21s005_DebLake_5c437b3d:

    # deb "Un beso como los de buenos días no me incomoda. Uno como el que acabamos de darnos..."
    deb "Un baiser comme celui du matin ne me dérange pas. Un baiser comme celui que nous venons d'échanger…"

# game/scripts/c21/c21.rpy:2926
translate french c21s005_DebLake_f51883cd:

    # deb "Y no quiero que nadie se sienta incómodo a nuestro alrededor. Quiero compartir nuestra felicidad, no que salgan corriendo en cuanto nos vean."
    deb "Et je ne veux pas que qui que ce soit se sente mal à l'aise en notre présence. Je veux partager notre bonheur, pas les voir prendre la fuite dès qu'ils nous aperçoivent."

# game/scripts/c21/c21.rpy:2927
translate french c21s005_DebLake_5b6c6e6a:

    # mc "*Risa* \"Ahí vienen los besucones. Vámonos.\""
    mc "*Rires* « Voilà les bisous. Allons-y. »"

# game/scripts/c21/c21.rpy:2929
translate french c21s005_DebLake_f01fe619:

    # deb "*Risa* Exactamente eso. [lis] es una de las que no se sentiría cómoda y tendría que escuchar su charla al volver a la habitación."
    deb "*Rires* Exactement. [lis] fait partie de celles qui ne se sentiraient pas à l'aise et devraient écouter leurs bavardages à son retour dans la pièce."

# game/scripts/c21/c21.rpy:2930
translate french c21s005_DebLake_e3e92888:

    # mc "*Risa* Eso tiene fácil solución. No vuelvas y ven a la mía."
    mc "*Rires* C'est facile à régler. Ne reviens pas ici, viens plutôt chez moi."

# game/scripts/c21/c21.rpy:2931
translate french c21s005_DebLake_6811bf29:

    # mc "Además, creo que [lis] está cambiando mucho. Como has dicho antes, se siente más cómoda alrededor de todo el mundo."
    mc "De plus, je pense que [lis] change beaucoup. Comme vous l'avez dit précédemment, elle se sent plus à l'aise partout dans le monde."

# game/scripts/c21/c21.rpy:2933
translate french c21s005_DebLake_054da1b0:

    # mc "Igual que tú. Es una sorpresa muy agradable."
    mc "Tout comme vous. C'est une très agréable surprise."

# game/scripts/c21/c21.rpy:2935
translate french c21s005_DebLake_5443ed31:

    # deb "Siempre he tenido un poco de complejo con mis... inexistentes tetas... Pero el otro día, en el Jazz Corner, un chico maravilloso me demostró que son suficientes..."
    deb "J'ai toujours été un peu complexée par ma… poitrine inexistante… Mais l'autre jour, au Jazz Corner, un type formidable m'a montré qu'elles me suffisaient amplement…"

# game/scripts/c21/c21.rpy:2936
translate french c21s005_DebLake_215bfd9d:

    # mc "*Risa* ¿Tengo que matar a ese chico maravilloso? ¿Me estás intentando poner celoso?"
    mc "*Rires* Dois-je vraiment tuer ce garçon merveilleux ? Essayez-vous de me rendre jalouse ?"

# game/scripts/c21/c21.rpy:2938
translate french c21s005_DebLake_76ec9dcd:

    # deb "Te lo estoy diciendo en serio, [mc]."
    deb "Je te le dis sérieusement, [mc]."

# game/scripts/c21/c21.rpy:2939
translate french c21s005_DebLake_ce7f1637:

    # deb "Puede parecerte una tontería, pero que bailáramos juntos... si se puede llamar bailar a eso... y lo que dijiste sobre mi cuerpo..."
    deb "Ça peut te paraître bête, mais le fait qu'on ait dansé ensemble… si on peut appeler ça de la danse… et ce que tu as dit sur mon corps…"

# game/scripts/c21/c21.rpy:2940
translate french c21s005_DebLake_c49aa8f5:

    # mc "No dije nada que no sea cierto, [deb.nick]. Me encanta tu cuerpo."
    mc "Je n'ai rien dit de faux, [deb.nick]. J'aime ton corps."

# game/scripts/c21/c21.rpy:2942
translate french c21s005_DebLake_a002b6f8:

    # mc "No necesitas tener las tetas de Tía [bet] para que sean preciosas."
    mc "Tu n'as pas besoin d'avoir les seins de ta tante pour être belle."

# game/scripts/c21/c21.rpy:2943
translate french c21s005_DebLake_9bf14226:

    # deb "¡[mc]! Se me acaba de poner piel de gallina..."
    deb "Waouh ! J'en ai la chair de poule..."

# game/scripts/c21/c21.rpy:2945
translate french c21s005_DebLake_09a37da8:

    # mc "Espero que no te esté entrando frío, aunque tengo una solución para eso..."
    mc "J'espère que vous n'avez pas froid, même si j'ai une solution pour ça..."

# game/scripts/c21/c21.rpy:2946
translate french c21s005_DebLake_bdd67bec:

    # deb "¿Frío? No exactamente..."
    deb "Froid ? Pas vraiment..."

# game/scripts/c21/c21.rpy:2949
translate french c21s005_DebLake_c7b13635:

    # "Sin retirar tu mano del pecho de [deb.nick], empiezas a besar su cuello, su clavícula, otra vez su cuello."
    "Sans retirer votre main de la poitrine de [deb.nick], vous commencez à embrasser son cou, sa clavicule, puis son cou à nouveau."

# game/scripts/c21/c21.rpy:2950
translate french c21s005_DebLake_fc034de2:

    # deb "Mmmmm... eso me gusta..."
    deb "Mmm... J'aime ça..."

# game/scripts/c21/c21.rpy:2951
translate french c21s005_DebLake_7d1b630f:

    # "Puedes notar como su pezón, duro como una piedra, roza contra la palma de tu mano. No es una teta para estrujar, sino para rozar suavemente."
    "Tu sens son téton, dur comme la pierre, effleurer la paume de ta main. Ce n'est pas un sein à presser, mais à caresser doucement."

# game/scripts/c21/c21.rpy:2952
translate french c21s005_DebLake_7b7c2d58:

    # deb "*Gemido* No sé qué estás haciendo... pero me encanta..."
    deb "*Gémissement* Je ne sais pas ce que tu fais... mais j'adore ça..."

# game/scripts/c21/c21.rpy:2953
translate french c21s005_DebLake_fdd6a303:

    # "Habrá tiempo más adelante para estrujarla y mordisquearla. Ahora tan solo quieres excitar más todavía ese maravilloso pezón."
    "Tu auras le temps plus tard de le caresser et de le mordiller. Pour l'instant, tu as juste envie d'exciter encore plus ce merveilleux téton."

# game/scripts/c21/c21.rpy:2956
translate french c21s005_DebLake_0b52b465:

    # "Bajas tu cabeza un poco, salpicando de besos el camino que une su clavícula a su pezón."
    "Tu baisses légèrement la tête, semant des baisers le long du chemin qui relie sa clavicule à son téton."

# game/scripts/c21/c21.rpy:2957
translate french c21s005_DebLake_a33c784d:

    # deb "*Jadeo* [mc], podría venir alguien..."
    deb "*Halètement* [mc], quelqu'un pourrait arriver..."

# game/scripts/c21/c21.rpy:2959
translate french c21s005_DebLake_20e30aae:

    # mc "¿Te importaría que nos vieran? ¿O tan solo te molestaría porque nos interrumpirían?"
    mc "Cela vous dérangerait-il s'ils nous voyaient ? Ou cela vous gênerait-il simplement parce qu'ils nous interrompraient ?"

# game/scripts/c21/c21.rpy:2960
translate french c21s005_DebLake_f28a66eb:

    # deb "Creo que lo segundo..."
    deb "Je pense que le deuxième..."

# game/scripts/c21/c21.rpy:2961
translate french c21s005_DebLake_90aaa3eb:

    # mc "Entonces no les demos tiempo a interrumpirnos."
    mc "Alors ne leur donnons pas le temps de nous interrompre."

# game/scripts/c21/c21.rpy:2963
translate french c21s005_DebLake_acafa8ca:

    # "Por fin llegas a su enhiesto pezón. Ha estado esperándote con ansia durante todo el recorrido de tus labios. Lo saludas con tu lengua."
    "Enfin, vous atteignez son téton dressé. Il vous attendait avec impatience pendant que vos lèvres l'exploraient. Vous le saluez de votre langue."

# game/scripts/c21/c21.rpy:2964
translate french c21s005_DebLake_509d5c3c:

    # deb "*Gemido* ¡Aaah! *Jadeo* ¡Qué bien se siente!"
    deb "*Gémissement* Aaah ! *Halètement* Ça fait tellement du bien !"

# game/scripts/c21/c21.rpy:2966
translate french c21s005_DebLake_81badf58:

    # "Dedicas tus labios, tu lengua, tus dientes, al pezón de la sirena durante unos maravillosos momentos."
    "Vous consacrez vos lèvres, votre langue, vos dents au téton de la sirène pendant quelques merveilleux instants."

# game/scripts/c21/c21.rpy:2967
translate french c21s005_DebLake_7a2d572f:

    # deb "*Jadeo* Tengo los pezones muy sensibles, [mc]... *Gemido* Se me está erizando el vello de la nuca..."
    deb "*Halètement* Mes tétons sont tellement sensibles, [mc]... *Gémissement* Les poils de ma nuque se hérissent..."

# game/scripts/c21/c21.rpy:2968
translate french c21s005_DebLake_500799dd:

    # mcp "(No es lo único que tienes erizado, cielo.)"
    mcp "(Ce n'est pas la seule chose qui te hérisse, chérie.)"

# game/scripts/c21/c21.rpy:2970
translate french c21s005_DebLake_a1027213:

    # "La musculosa mujer está tan concentrada en el tacto de tu boca en su pezón que no descubre a donde se dirige tu mano hasta que es demasiado tarde."
    "Cette femme musclée est tellement concentrée sur le contact de vos lèvres sur son téton qu'elle ne remarque pas où va votre main avant qu'il ne soit trop tard."

# game/scripts/c21/c21.rpy:2971
translate french c21s005_DebLake_d2c42390:

    # deb "*Jadeo* ¡[mc]!"
    deb "*Halètement* [mc]!"

# game/scripts/c21/c21.rpy:2972
translate french c21s005_DebLake_c18611a4:

    # "Puedes notar el calor de su entrepierna a través del húmedo bikini."
    "On sent la chaleur de son entrejambe à travers son bikini mouillé."

# game/scripts/c21/c21.rpy:2974
translate french c21s005_DebLake_2e0c34ce:

    # mc "Dime, cielo."
    mc "Dis-moi, chérie."

# game/scripts/c21/c21.rpy:2975
translate french c21s005_DebLake_c274e862:

    # "Empiezas a mover tus dedos por encima de la tela que te separa de su tesoro."
    "Vous commencez à faire glisser vos doigts sur le tissu qui vous sépare de son trésor."

# game/scripts/c21/c21.rpy:2976
translate french c21s005_DebLake_0b809364:

    # deb "*Gemido* Te he dicho que no estaba preparada..."
    deb "*Gémissement* Je t'avais dit que je n'étais pas prêt..."

# game/scripts/c21/c21.rpy:2977
translate french c21s005_DebLake_e8c21032:

    # "Sus palabras expresan dudas. Su cuerpo pide más, aunque sabes... crees... que no vas a poder llegar hasta el final. Habrá tiempo para eso."
    "Ses paroles expriment le doute. Son corps en désire davantage, même si tu sais… tu penses… que tu n’iras pas jusqu’au bout. Il y aura un autre moment pour ça."

# game/scripts/c21/c21.rpy:2978
translate french c21s005_DebLake_3630ffe7:

    # mc "Has dicho que no estabas preparada para acostarte conmigo. Hay muchas cosas que podemos hacer sin acostarnos."
    mc "Tu as dit que tu n'étais pas prêt à coucher avec moi. Il y a plein de choses qu'on peut faire sans coucher ensemble."

# game/scripts/c21/c21.rpy:2979
translate french c21s005_DebLake_3abd998a:

    # mc "¿Confías en mí?"
    mc "Me faites-vous confiance ?"

# game/scripts/c21/c21.rpy:2981
translate french c21s005_DebLake_e57bd149:

    # deb "*Jadeo* Sí..."
    deb "*Halètement* Oui..."

# game/scripts/c21/c21.rpy:2982
translate french c21s005_DebLake_9ab1c2ea:

    # mc "Si hago algo que no te gusta, dímelo y pararé."
    mc "Si je fais quelque chose qui ne vous plaît pas, dites-le-moi et j'arrêterai."

# game/scripts/c21/c21.rpy:2983
translate french c21s005_DebLake_2a8a47a9:

    # deb "*Gemido* De acuerdo. Hasta ahora me gusta todo... casi demasiado."
    deb "*Gémissement* Bon. Pour l'instant, j'aime tout... presque trop."

# game/scripts/c21/c21.rpy:2985
translate french c21s005_DebLake_446ca98c:

    # "Tus labios empiezan a repartir besos lentamente por todo el camino que lleva de su pezón a la goma de su bikini, hasta acabar arrodillado delante de ella."
    "Vos lèvres commencent à déposer lentement des baisers, de son téton jusqu'à l'élastique de son bikini, jusqu'à ce que vous finissiez par vous agenouiller devant elle."

# game/scripts/c21/c21.rpy:2986
translate french c21s005_DebLake_bc23773c:

    # "Tan lentamente que, para cuando acabas, ambos estáis casi secos."
    "Si lentement que, lorsque vous aurez terminé, vous serez tous les deux presque secs."

# game/scripts/c21/c21.rpy:2988
translate french c21s005_DebLake_fd76c62d:

    # deb "*Gemido* ¿Vas a desnudarme del todo?... Me siento... vulnerable..."
    deb "*Gémissement* Tu vas me déshabiller complètement ?... Je me sens... vulnérable..."

# game/scripts/c21/c21.rpy:2989
translate french c21s005_DebLake_d7d007aa:

    # mc "Si no te importa, me gustaría hacerlo. Verte desnuda para mí por primera vez."
    mc "Si ça ne vous dérange pas, j'aimerais le faire. Vous voir nue pour moi pour la première fois."

# game/scripts/c21/c21.rpy:2990
translate french c21s005_DebLake_a1de54d5:

    # deb "Adelante... pero después me gustaría verte yo también..."
    deb "Vas-y... mais après, j'aimerais bien te revoir aussi..."

# game/scripts/c21/c21.rpy:2992
translate french c21s005_DebLake_4dcfabdf:

    # "Bajas lentamente un lado de su bikini. Quieres alargar la experiencia lo máximo posible."
    "Vous abaissez lentement un côté de son bikini. Vous voulez prolonger ce moment le plus longtemps possible."

# game/scripts/c21/c21.rpy:2993
translate french c21s005_DebLake_393069da:

    # mc "Tu ya me viste, cielo."
    mc "Tu m'as déjà vue, chérie."

# game/scripts/c21/c21.rpy:2995
translate french c21s005_DebLake_c310b0b4:

    # "El otro lado sigue al primero. Queda poco para poder llegar al tesoro de la sirenita."
    "L'autre rive suit la première. Nous y sommes presque, tout près d'atteindre le trésor de la Petite Sirène."

# game/scripts/c21/c21.rpy:2996
translate french c21s005_DebLake_eb66c4a7:

    # deb "¿Cuándo?"
    deb "Quand?"

# game/scripts/c21/c21.rpy:2997
translate french c21s005_DebLake_78df7a2a:

    # mc "Cuando apareció el jabalí, aquí mismo."
    mc "Quand le sanglier est apparu, juste ici."

# game/scripts/c21/c21.rpy:2999
translate french c21s005_DebLake_71cc47a0:

    # "Descubres el tesoro, perfectamente depilado. El aroma que inunda tus sentidos te indica que la preciosa mujer está preparada para más."
    "Vous découvrez ce trésor, impeccablement soigné. Le parfum qui embaume vos sens vous indique que cette belle femme est prête à passer à l'acte."

# game/scripts/c21/c21.rpy:3000
translate french c21s005_DebLake_0069c8fd:

    # deb "Espero que no estés tan flácido como aquel día."
    deb "J'espère que tu n'es plus aussi flasque que ce jour-là."

# game/scripts/c21/c21.rpy:3001
translate french c21s005_DebLake_744cb7ec:

    # mc "*Risa* No lo estoy, no te preocupes."
    mc "*Rires* Non, ne t'inquiète pas."

# game/scripts/c21/c21.rpy:3003
translate french c21s005_DebLake_a841b57c:

    # "No puedes resistir la tentación de probarla su sabor por primera vez. Hundes tu cara en su entrepierna."
    "Vous ne pouvez résister à la tentation de la goûter pour la première fois. Vous enfouissez votre visage dans son entrejambe."

# game/scripts/c21/c21.rpy:3004
translate french c21s005_DebLake_5f55e36b:

    # deb "*Gemido* ¡Ooooh! *Jadeo*"
    deb "*Gémissement* Ooooh ! *Halètement*"

# game/scripts/c21/c21.rpy:3005
translate french c21s005_DebLake_8d6b3fbd:

    # "Tu lengua encuentra una multitud de sensaciones. El frescor de su baño en el lago mezclado con el calor que emana de su interior."
    "Votre langue découvre une multitude de sensations. La fraîcheur de son bain dans le lac se mêle à la chaleur qui émane de l'intérieur."

# game/scripts/c21/c21.rpy:3006
translate french c21s005_DebLake_0b9070b2:

    # deb "*Jadeo* ¡Ahhhhh! *Gemido*"
    deb "*Halètement* Ahhhhh ! *Gémissement*"

# game/scripts/c21/c21.rpy:3007
translate french c21s005_DebLake_28d34e9a:

    # "El aroma terroso de su excitación y el sabor agridulce de su lubricación."
    "L'arôme terreux de son excitation et le goût doux-amer de sa lubrification."

# game/scripts/c21/c21.rpy:3009
translate french c21s005_DebLake_152dbe63:

    # mc "Sabes maravillosamente bien, [deb.nick]."
    mc "Tu as un goût délicieux, [deb.nick]."

# game/scripts/c21/c21.rpy:3010
translate french c21s005_DebLake_582fba12:

    # deb "*Gemido* ¿Ya está? *Jadeo* ¿Sólo eso?"
    deb "*Gémissement* C'est tout ? *Halètement* Juste ça ?"

# game/scripts/c21/c21.rpy:3011
translate french c21s005_DebLake_59d6f7dd:

    # mc "*Risa* No, cielo, recuéstate en la piedra que tienes detrás, quiero probarte toda."
    mc "*Rires* Non, chérie, allonge-toi sur le rocher derrière toi, je veux te tester de partout."

# game/scripts/c21/c21.rpy:3013
translate french c21s005_DebLake_73656bc3:

    # deb "¿Así está bien?"
    deb "Est-ce que ça vous convient ?"

# game/scripts/c21/c21.rpy:3014
translate french c21s005_DebLake_b73e4cd5:

    # "Sus piernas cerradas revelan la inseguridad que siente en ese momento."
