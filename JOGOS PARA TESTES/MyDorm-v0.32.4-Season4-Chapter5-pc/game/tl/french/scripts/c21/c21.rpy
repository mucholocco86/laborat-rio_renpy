translate french c21s002_BettyMassageAndDrivingLicense_fbcea2f0:

    # mc "Pero antes, ¿no tengo beso de buenos días?"
    mc "Mais d'abord, je n'ai pas droit à un bisou du matin ?"

# game/scripts/c21/c21.rpy:1395
translate french c21s002_BettyMassageAndDrivingLicense_7fec4f33:

    # bet "Sobre eso... si no te importa... Sé que lo propuse yo, pero... preferiría dejar de hacerlo."
    bet "À ce propos... si cela ne vous dérange pas... je sais que c'est moi qui l'ai suggéré, mais... je préférerais arrêter."

# game/scripts/c21/c21.rpy:1396
translate french c21s002_BettyMassageAndDrivingLicense_eeb3e37d:

    # mc "*Risa* ¿Beso demasiado bien y te vienen pensamientos demasiado impuros para una monja?"
    mc "*Rires* Est-ce que j'embrasse trop bien et que tu as des pensées trop impures pour une nonne ?"

# game/scripts/c21/c21.rpy:1398
translate french c21s002_BettyMassageAndDrivingLicense_77afb663:

    # bet "*Risa* ¿Eso es lo que querrías? ¡Creía que eras un buen chico!"
    bet "*Rires* C'est ce que tu voulais ? Je te croyais un bon garçon !"

# game/scripts/c21/c21.rpy:1399
translate french c21s002_BettyMassageAndDrivingLicense_c3c47659:

    # mc "En serio, si te incomoda no hay ningún problema por dejar de hacerlo."
    mc "Franchement, si ça vous met mal à l'aise, il n'y a aucun problème à arrêter."

# game/scripts/c21/c21.rpy:1401
translate french c21s002_BettyMassageAndDrivingLicense_c87bee9f:

    # bet "¿Recuerdas por qué lo propuse?"
    bet "Te souviens-tu pourquoi je te l'ai suggéré ?"

# game/scripts/c21/c21.rpy:1402
translate french c21s002_BettyMassageAndDrivingLicense_c5fbcc46:

    # mc "Para fastidiar a Meemaw."
    mc "Pour embêter Mémé."

# game/scripts/c21/c21.rpy:1403
translate french c21s002_BettyMassageAndDrivingLicense_7afaff1c:

    # bet "Ahora que parece que ya no le importa, no hay razón para seguir haciéndolo."
    bet "Maintenant qu'il semble s'en moquer, il n'y a plus aucune raison de continuer."

# game/scripts/c21/c21.rpy:1405
translate french c21s002_BettyMassageAndDrivingLicense_a8a6c874:

    # bet "No está bien que una monja haga eso. No creo que el Obispo lo aprobara, y menos aún en mi situación."
    bet "Il n'est pas convenable qu'une religieuse agisse ainsi. Je ne pense pas que l'évêque approuverait, surtout pas dans ma situation."

# game/scripts/c21/c21.rpy:1406
translate french c21s002_BettyMassageAndDrivingLicense_16ea5513:

    # mc "Te entiendo. No te preocupes. No hay ningún problema en dejar de hacerlo, pero si alguna de las chicas pregunta, serás tú quien se lo explique."
    mc "Je comprends. Ne t'inquiète pas. Il n'y a aucun problème à arrêter, mais si l'une des filles pose la question, c'est toi qui devras lui expliquer."

# game/scripts/c21/c21.rpy:1408
translate french c21s002_BettyMassageAndDrivingLicense_9cbb42fe:

    # bet "Me parece un trato justo. Te veo luego si no estás muy ocupado. Voy a darle ese masaje a Olivia antes de que se impaciente."
    bet "Ça me paraît un bon compromis. À plus tard si tu n'es pas trop occupé(e). Je vais masser Olivia avant qu'elle ne s'impatiente."

# game/scripts/c21/c21.rpy:1409
translate french c21s002_BettyMassageAndDrivingLicense_05812d8f:

    # mc "Espera, Tía [bet]."
    mc "Attends, tante [bet]."

# game/scripts/c21/c21.rpy:1411
translate french c21s002_BettyMassageAndDrivingLicense_f947d43b:

    # mc "Estoy dispuesto a dejar los besos de lado, pero no los abrazos."
    mc "Je suis prête à renoncer aux baisers, mais pas aux câlins."

# game/scripts/c21/c21.rpy:1413
translate french c21s002_BettyMassageAndDrivingLicense_1577c66c:

    # bet "Nunca voy a permitirte que dejes de dármelos."
    bet "Je ne te permettrai jamais d'arrêter de m'en donner."

# game/scripts/c21/c21.rpy:1414
translate french c21s002_BettyMassageAndDrivingLicense_1738c3ad:

    # mc "Ahora ya puedes ir a masajear esas tetas."
    mc "Maintenant, tu peux aller masser ces seins."

# game/scripts/c21/c21.rpy:1416
translate french c21s002_BettyMassageAndDrivingLicense_31fc745e:

    # bet "Olivia puede esperar un par de minutos más... se está muy bien aquí."
    bet "Olivia peut attendre encore quelques minutes... il fait très bon ici."

# game/scripts/c21/c21.rpy:1417
translate french c21s002_BettyMassageAndDrivingLicense_dd201e21:

    # mc "Tantos minutos como necesites."
    mc "Autant de minutes que nécessaire."

# game/scripts/c21/c21.rpy:1420
translate french c21s002_BettyMassageAndDrivingLicense_6f8bfe7a:

    # "Casi diez minutos después, [bet] abandona tu habitación."
    "Près de dix minutes plus tard, [bet] quittez votre chambre."

# game/scripts/c21/c21.rpy:1426
translate french c21s002_AaronCall_4141d7ac:

    # "Bajas a desayunar, y al volver a tu habitación..."
    "Vous descendez prendre votre petit-déjeuner, et lorsque vous retournez dans votre chambre..."

# game/scripts/c21/c21.rpy:1428
translate french c21s002_AaronCall_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1429
translate french c21s002_AaronCall_9987422b:

    # mcp "(Videoconferencia de un número desconocido, pero el prefijo es de Aruba.)"
    mcp "(Vidéoconférence depuis un numéro inconnu, mais l'indicatif régional est celui d'Aruba.)"

# game/scripts/c21/c21.rpy:1433
translate french c21s002_AaronCall_1c7111b2:

    # mc "Buenos días, [aar]"
    mc "Bonjour, [aar]"

# game/scripts/c21/c21.rpy:1434
translate french c21s002_AaronCall_c1e7a21d:

    # aar "Hola, [mc]. Te debía una llamada desde hace unos días. ¿Puedes hablar? ¿Estás solo?"
    aar "Salut, [mc]. Je te dois un appel depuis quelques jours. Tu peux me parler ? Tu es seul(e) ?"

# game/scripts/c21/c21.rpy:1435
translate french c21s002_AaronCall_37be49c1:

    # mc "Sí, llevo varios días esperándola."
    mc "Oui, je l'attends depuis plusieurs jours."

# game/scripts/c21/c21.rpy:1437
translate french c21s002_AaronCall_20b8d4d3:

    # aar "¿Cómo se están portando mis dos chicas? Anoche hablé con ellas y estaban entusiasmadas con... unas muñecas..."
    aar "Comment se comportent mes deux filles ? Je leur ai parlé hier soir et elles étaient ravies à propos de… des poupées…"

# game/scripts/c21/c21.rpy:1438
translate french c21s002_AaronCall_e11ef6ad:

    # aar "No quisieron decirme a qué se referían. ¿Le han puesto un mote a alguna de tus chicas?"
    aar "Ils n'ont pas voulu me dire ce qu'ils voulaient dire. Ont-ils donné un surnom à l'une de vos filles ?"

# game/scripts/c21/c21.rpy:1439
translate french c21s002_AaronCall_87f7cf83:

    # mc "No, [aar], pero si no quisieron decirte de que iba el tema, no voy a ser yo quien lo haga."
    mc "Non, [aar], mais s'ils n'ont pas voulu te dire de quoi il s'agissait, je ne vais pas être celui qui le fera."

# game/scripts/c21/c21.rpy:1441
translate french c21s002_AaronCall_c819bfc5:

    # aar "Me parece bien. Pero, ¿cómo se están portando? No me has contestado."
    aar "Ça me convient. Mais comment se comportent-ils ? Vous ne m'avez pas répondu."

# game/scripts/c21/c21.rpy:1442
translate french c21s002_AaronCall_d8ceffa6:

    # mc "Muy bien. Se están integrando genial en la familia y todo el mundo las adora."
    mc "Très bien. Ils se sont merveilleusement bien intégrés à la famille et tout le monde les adore."

# game/scripts/c21/c21.rpy:1444
translate french c21s002_AaronCall_0cf727f2:

    # aar "Por todo el mundo... te refieres a ti, a [mar] y a [nor], ¿verdad?"
    aar "Partout dans le monde... tu veux dire toi, [mar] et [nor], n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1445
translate french c21s002_AaronCall_62e249b3:

    # mc "No, [aar], a toda la familia. ¿Qué crees que querían decir [mar] y [nor] cuando las invitaron a comer y a cenar a casa?"
    mc "Non, [aar], toute la famille. À votre avis, que voulaient dire [mar] et [nor] lorsqu'ils les ont invités à déjeuner et à dîner à la maison ?"

# game/scripts/c21/c21.rpy:1447
translate french c21s002_AaronCall_778fce69:

    # aar "Realmente no lo había pensado. Creía que iba a ser... no sé... para conocerse mejor. Algo privado de ellas cuatro."
    aar "Je n'y avais pas vraiment réfléchi. Je pensais que ce serait… je ne sais pas… pour qu'ils apprennent à mieux se connaître. Quelque chose de privé entre eux quatre."

# game/scripts/c21/c21.rpy:1448
translate french c21s002_AaronCall_81e38309:

    # mc "[aar], creo que no entiendes a mi familia. Intentamos no guardar secretos, y en este estaban implicadas [eri], [dap], y [emm]."
    mc "[aar], je ne crois pas que vous compreniez ma famille. Nous essayons de ne pas garder de secrets, et [eri], [dap] et [emm] étaient impliqués dans celui-ci."

# game/scripts/c21/c21.rpy:1450
translate french c21s002_AaronCall_a3a825e3:

    # aar "Bueno, si es así, supongo que no hay ningún problema porque lo sepan. Ellas también son accionistas de La Compañía."
    aar "Eh bien, si c'est le cas, je suppose qu'il n'y a pas de problème à ce qu'ils le sachent. Ils sont aussi actionnaires de la société."

# game/scripts/c21/c21.rpy:1451
translate french c21s002_AaronCall_ee28dc16:

    # mc "Sigues sin entenderlo. Lo sabe toda la familia. Ayer estuvieron en la fiesta de cumpleaños de las chicas. 25 personas."
    mc "Tu ne comprends toujours pas. Toute la famille est au courant. Ils étaient à l'anniversaire des filles hier. 25 personnes."

# game/scripts/c21/c21.rpy:1453
translate french c21s002_AaronCall_681e2a3c:

    # aar "¿Qué? No me parece bien, [mc]. No están preparadas para eso y, si el secreto sale a la luz, pueden tener problemas."
    aar "Quoi ? Je ne pense pas que ce soit une bonne idée. Ils ne sont pas prêts pour ça, et si le secret est révélé, ils pourraient avoir des ennuis."

# game/scripts/c21/c21.rpy:1454
translate french c21s002_AaronCall_2c6f98cc:

    # aar "Tus chicas y las mías."
    aar "Tes filles et les miennes."

# game/scripts/c21/c21.rpy:1455
translate french c21s002_AaronCall_e9d1a1ef:

    # mc "Sigues sin entenderlo. Tus chicas son mis chicas también. Nuestras chicas. De la familia."
    mc "Tu ne comprends toujours pas. Tes filles sont aussi mes filles. Nos filles. La famille."

# game/scripts/c21/c21.rpy:1456
translate french c21s002_AaronCall_ea0668be:

    # mc "Nadie va a hacer nada para perjudicarlas. Apostaría mi vida en ello."
    mc "Personne ne leur fera de mal. J'en mettrais ma main à couper."

# game/scripts/c21/c21.rpy:1458
translate french c21s002_AaronCall_95c9301c:

    # aar "Pero no están preparadas para ese tipo de interacciones sociales... no tienen entrenamiento para eso."
    aar "Mais ils ne sont pas préparés à ce genre d'interactions sociales... ils n'ont reçu aucune formation pour cela."

# game/scripts/c21/c21.rpy:1459
translate french c21s002_AaronCall_b3d3453b:

    # mc "Pues, al no tener entrenamiento, usaron su instinto. Y se les dio bien. No debes sobreprotegerlas."
    mc "Comme ils n'avaient reçu aucune formation, ils se sont fiés à leur instinct. Et ils s'en sont bien sortis. Il ne faut pas les surprotéger."

# game/scripts/c21/c21.rpy:1460
translate french c21s002_AaronCall_60636dc3:

    # mcp "(De eso ya me ocuparé yo.)"
    mcp "(Je m'en occupe.)"

# game/scripts/c21/c21.rpy:1462
translate french c21s002_AaronCall_1967bdf8:

    # aar "No me queda más remedio que confiar en ti, ¿no?"
    aar "Je n'ai pas d'autre choix que de vous faire confiance, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1463
translate french c21s002_AaronCall_3e5bfe1e:

    # mc "Esto es un camino en dos direcciones. Yo he confiado en ti, ahora te toca confiar en mí. Y en ellas. En todos nosotros."
    mc "C'est une relation à double sens. Je t'ai fait confiance, maintenant c'est à ton tour de me faire confiance. Et à eux aussi. À nous tous."

# game/scripts/c21/c21.rpy:1464
translate french c21s002_AaronCall_593d6733:

    # mc "Pero supongo que no me llamabas solo por eso, ¿no?"
    mc "Mais j'imagine que vous ne m'appeliez pas uniquement pour cette raison, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1466
translate french c21s002_AaronCall_0ba84e38:

    # aar "No. Te llamaba porque ha habido una filtración durante el proceso de toma de poder."
    aar "Non. J'appelais parce qu'il y a eu une fuite pendant la procédure de prise de contrôle du courant."

# game/scripts/c21/c21.rpy:1467
translate french c21s002_AaronCall_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Ce qui s'est passé?"

# game/scripts/c21/c21.rpy:1468
translate french c21s002_AaronCall_32fa659b:

    # aar "Una de las competidoras de NTR en el mundo de las... operaciones de seguridad... ha recibido información sobre el cambio de propietarios."
    aar "Un des concurrents de NTR dans le secteur des opérations de sécurité a été informé du changement de propriétaire."

# game/scripts/c21/c21.rpy:1469
translate french c21s002_AaronCall_1e8a5b88:

    # mc "Eso es malo, ¿no? ¿Estamos en peligro otra vez? ¿También tienen clones?"
    mc "C'est grave, n'est-ce pas ? Sommes-nous à nouveau en danger ? Ont-ils aussi des clones ?"

# game/scripts/c21/c21.rpy:1471
translate french c21s002_AaronCall_fab57a01:

    # aar "No, no es especialmente malo. No van a tomar ninguna acción violenta o ilegal. Y no, no tienen clones, actúan con personal exmilitar."
    aar "Non, ce n'est pas particulièrement grave. Ils ne vont commettre aucun acte violent ou illégal. Et non, ils n'ont pas de clones ; ils emploient d'anciens militaires."

# game/scripts/c21/c21.rpy:1472
translate french c21s002_AaronCall_6ba3a832:

    # aar "Quieren comprar NTR aprovechando lo que consideran una posición de debilidad. ¿Habéis hablado ya sobre si vais a vender vuestras acciones?"
    aar "Ils souhaitent racheter NTR, profitant de ce qu'ils perçoivent comme une position faible. Avez-vous déjà discuté de la possibilité de vendre vos actions ?"

# game/scripts/c21/c21.rpy:1473
translate french c21s002_AaronCall_116344af:

    # mc "Yo no voy a venderlas y [dap] tampoco. Supongo que tú, [ama] y [eva] tampoco."
    mc "Je ne vais pas les vendre, et [dap] non plus. Je suppose que vous non plus, [ama] et [eva]."

# game/scripts/c21/c21.rpy:1475
translate french c21s002_AaronCall_2223e756:

    # aar "No, no vamos a vender, con lo que podrían hacerse con un 50%% de la compañía como máximo. No es malo del todo, pero tampoco bueno."
    aar "Non, nous n'allons pas vendre, ils pourraient donc obtenir au maximum 50%% de l'entreprise. Ce n'est pas catastrophique, mais ce n'est pas idéal non plus."

# game/scripts/c21/c21.rpy:1476
translate french c21s002_AaronCall_ea8b9317:

    # mc "No creo que [mar], [nor], [emm], o [eri] vayan a querer vender tampoco."
    mc "Je ne pense pas que [mar], [nor], [emm] ou [eri] voudront vendre non plus."

# game/scripts/c21/c21.rpy:1477
translate french c21s002_AaronCall_19f7739d:

    # aar "Eso es mejor todavía, pero deberíais concretarlo. Hoy."
    aar "C'est encore mieux, mais vous devriez finaliser cela. Aujourd'hui."

# game/scripts/c21/c21.rpy:1478
translate french c21s002_AaronCall_22910fb8:

    # mc "¿Hoy? ¿Por qué tanta prisa?"
    mc "Aujourd'hui ? Pourquoi cette précipitation ?"

# game/scripts/c21/c21.rpy:1480
translate french c21s002_AaronCall_b6f53ead:

    # aar "Uno de sus directivos está en San Diego reunido con vuestra Armada. No me extrañaría que se pusiera en contacto contigo para tener una reunión."
    aar "L'un de leurs directeurs est à San Diego pour rencontrer votre Marine. Je ne serais pas surpris qu'il vous contacte pour organiser une rencontre."

# game/scripts/c21/c21.rpy:1481
translate french c21s002_AaronCall_5c70738c:

    # mc "¿Conmigo? ¿Por qué? ¿Por qué no con [mar] o [nor]?"
    mc "Avec moi ? Pourquoi ? Pourquoi pas avec [mar] ou [nor] ?"

# game/scripts/c21/c21.rpy:1482
translate french c21s002_AaronCall_f6925132:

    # aar "La información filtrada llevaba tu nombre como futuro CEO de la compañía representando al grupo mayoritario de accionistas."
    aar "Les informations divulguées mentionnaient votre nom en tant que futur PDG de l'entreprise, représentant le groupe d'actionnaires majoritaires."

# game/scripts/c21/c21.rpy:1483
translate french c21s002_AaronCall_f795a7f0:

    # mc "Vale, pues si se ponen en contacto, con decirle que no estamos interesados en vender hay suficiente, ¿no?"
    mc "D'accord, donc s'ils nous contactent, leur dire simplement que nous ne sommes pas intéressés par la vente suffit, n'est-ce pas ?"

# game/scripts/c21/c21.rpy:1485
translate french c21s002_AaronCall_f3896c95:

    # aar "Debería haber suficiente, pero tienes que hablarlo antes con tu familia. No puedes tomar una decisión por ellos."
    aar "Il devrait y en avoir assez, mais vous devez d'abord en parler à votre famille. Vous ne pouvez pas décider à leur place."

# game/scripts/c21/c21.rpy:1486
translate french c21s002_AaronCall_89f7514c:

    # aar "Incluso sería bueno que te reunieras con él, llevando a [ama] como guardaespaldas. Para saber qué intenciones tienen."
    aar "Il serait même judicieux que vous le rencontriez, accompagné de [ama] comme garde du corps, afin de découvrir ses intentions."

# game/scripts/c21/c21.rpy:1487
translate french c21s002_AaronCall_023dbd88:

    # mc "Si no vamos a vender, ¿qué más da las intenciones que tengan?"
    mc "Si nous ne vendons pas, à quoi bon connaître leurs intentions ?"

# game/scripts/c21/c21.rpy:1489
translate french c21s002_AaronCall_4d83f4ea:

    # aar "[mc], la información es poder en este mundo. No creo que seas capaz de sacarle nada, pero [ama] sí que puede conseguir algo de información."
    aar "[mc], dans ce monde, l'information est un pouvoir. Je ne pense pas que vous puissiez obtenir quoi que ce soit de lui, mais [ama] il peut obtenir certaines informations."

# game/scripts/c21/c21.rpy:1490
translate french c21s002_AaronCall_e00384c4:

    # mc "No me hace ninguna gracia ir a una reunión con un tipo que seguramente sea peligroso sin tener ni idea de nada."
    mc "Je n'ai aucune envie d'aller à une réunion avec un type probablement dangereux sans rien y connaître."

# game/scripts/c21/c21.rpy:1492
translate french c21s002_AaronCall_56cd97e0:

    # aar "¿Crees que ese directivo va a ser más peligroso que [ama]? *Risa*"
    aar "Pensez-vous que ce cadre sera plus dangereux que [ama] ? *Rires*"

# game/scripts/c21/c21.rpy:1493
translate french c21s002_AaronCall_261ccb82:

    # mc "*Risa* En eso tienes razón. No voy a estar más protegido con nadie mejor que con ella."
    mc "*Rires* Tu as raison. Je ne serais pas plus en sécurité avec quelqu'un d'autre qu'avec elle."

# game/scripts/c21/c21.rpy:1495
translate french c21s002_AaronCall_1d102f4f:

    # aar "*Risa* Que no te oiga [eva] decir eso."
    aar "*Rires* Ne me dites surtout pas ça."

# game/scripts/c21/c21.rpy:1496
translate french c21s002_AaronCall_b9e32a8d:

    # aar "Te la has terminado de ganar con el regalo de las muñecas. Un buen detalle. No la pierdas ahora."
    aar "Tu l'as vraiment conquise avec la poupée. C'était une délicate attention. Ne la perds pas maintenant."

# game/scripts/c21/c21.rpy:1497
translate french c21s002_AaronCall_69ecb324:

    # mc "Espera. Habías dicho que no sabías de qué hablaban con lo de las muñecas."
    mc "Attendez. Vous avez dit que vous ne saviez pas de quoi ils parlaient avec les poupées."

# game/scripts/c21/c21.rpy:1499
translate french c21s002_AaronCall_3a98564c:

    # aar "Quería comprobar lo leal que eras hacia ellas. Lo de las muñecas era algo simple sobre lo que quizás quisieras fanfarronear."
    aar "Je voulais tester ta loyauté envers eux. L'histoire de la poupée, c'était juste un petit détail dont tu pourrais te vanter."

# game/scripts/c21/c21.rpy:1500
translate french c21s002_AaronCall_acb236f1:

    # aar "Pero siendo algo que puede que para ti no sea importante has guardado lo que creías que era su secreto. Bien hecho."
    aar "Même si cela ne vous paraît peut-être pas important, vous avez gardé ce que vous pensiez être leur secret. Bravo."

# game/scripts/c21/c21.rpy:1501
translate french c21s002_AaronCall_6f76af63:

    # mc "No me gustan estos juegos, [aar]."
    mc "Je n'aime pas ces jeux, [aar]."

# game/scripts/c21/c21.rpy:1503
translate french c21s002_AaronCall_3da1a804:

    # aar "A mí tampoco, te lo aseguro. Pero no sé cuánto tiempo voy a poder seguir protegiéndolas. Necesito saber que tú y tu familia lo vais a hacer cuando yo no esté."
    aar "Moi non plus, je vous l'assure. Mais je ne sais pas combien de temps je pourrai encore les protéger. J'ai besoin de savoir que vous et votre famille continuerez à le faire après mon départ."

# game/scripts/c21/c21.rpy:1504
translate french c21s002_AaronCall_d31034f7:

    # mc "Lo haremos, no te preocupes. ¿No hay nada que pueda frenar el envejecimiento acelerado?"
    mc "On s'en occupera, ne t'inquiète pas. N'y a-t-il rien qui puisse ralentir le vieillissement accéléré ?"

# game/scripts/c21/c21.rpy:1506
translate french c21s002_AaronCall_c3c0825a:

    # aar "No, no hay nada. No voy a durar diez años más. Quizás ni siquiera cinco."
    aar "Non, il n'y a rien. Je ne vais pas tenir encore dix ans. Peut-être même pas cinq."

# game/scripts/c21/c21.rpy:1507
translate french c21s002_AaronCall_84ab57b7:

    # mc "Lo siento. No tengo palabras..."
    mc "Je suis désolé. Je suis sans voix..."

# game/scripts/c21/c21.rpy:1508
translate french c21s002_AaronCall_fd33cf36:

    # aar "No te preocupes. Hace años que lo tengo asumido."
    aar "Ne t'inquiète pas. Je l'ai accepté il y a des années."

# game/scripts/c21/c21.rpy:1510
translate french c21s002_AaronCall_d08c7506:

    # aar "Volviendo al tema que nos ocupaba. Si se ponen en contacto contigo desde Iron Fist, la otra compañía, intenta tener una reunión en persona e informa a [ama]."
    aar "Pour en revenir à nos moutons, si Iron Fist, l'autre société, vous contacte, essayez d'organiser une rencontre en personne et informez-en [ama]."

# game/scripts/c21/c21.rpy:1511
translate french c21s002_AaronCall_10b09256:

    # mc "De acuerdo. ¿Alguna cosa más?"
    mc "D'accord. Autre chose ?"

# game/scripts/c21/c21.rpy:1513
translate french c21s002_AaronCall_34537b06:

    # aar "No, eso es todo. ¿Tienes alguna pregunta?"
    aar "Non, c'est tout. Avez-vous des questions ?"

# game/scripts/c21/c21.rpy:1514
translate french c21s002_AaronCall_5a73e046:

    # mc "Sí. Me dijiste que me dirías de qué te conocía. O de qué me sonabas."
    mc "Oui. Tu m'as dit que tu me dirais d'où je te connaissais. Ou pourquoi tu me semblaits familier."

# game/scripts/c21/c21.rpy:1516
translate french c21s002_AaronCall_62cf7be6:

    # aar "Supongo que ya lo has pensado, pero... ¿alguna vez te han dicho que pareces mayor de tu edad?"
    aar "J'imagine que vous y avez déjà pensé, mais… vous a-t-on déjà dit que vous paraissiez plus vieux que votre âge ?"

# game/scripts/c21/c21.rpy:1517
translate french c21s002_AaronCall_75c3e23a:

    # mc "Sí. No me digas que yo también soy un clon que envejece más rápido."
    mc "Oui. Ne me dites pas que je suis aussi un clone qui vieillit plus vite."

# game/scripts/c21/c21.rpy:1519
translate french c21s002_AaronCall_fca3faa7:

    # aar "No, no eres un clon. Arnau, Alfred, y yo somos clones tuyos." id c21s002_AaronCall_fca3faa7
    aar "Non, tu n'es pas un clone. Arnau, Alfred et moi sommes tes clones." id c21s002_AaronCall_fca3faa7

# game/scripts/c21/c21.rpy:1521
translate french c21s002_AaronCall_bce8a29d:

    # aar "Tus tíos le sacaron células madre a [mar] durante su embarazo, con la excusa de hacer pruebas sobre enfermedades genéticas."
    aar "Vos oncles ont extrait des cellules souches de [mar] pendant sa grossesse, sous prétexte de mener des tests sur des maladies génétiques."

# game/scripts/c21/c21.rpy:1523
translate french c21s002_AaronCall_1e40d8c8:

    # aar "Ana se extrajo células madre durante su embarazo. Fuiste el primer sujeto al que lograron clonar."
    aar "Des cellules souches ont été prélevées chez Ana pendant sa grossesse. Vous avez été la première personne qu'ils ont pu cloner."

# game/scripts/c21/c21.rpy:1525
translate french c21s002_AaronCall_f3053091:

    # aar "No pareces sorprendido."
    aar "Tu n'as pas l'air surpris."

# game/scripts/c21/c21.rpy:1526
translate french c21s002_AaronCall_c909980b:

    # mc "Veo una versión joven de tu cara cada día en el espejo. Desde que te conocí, era una de las opciones que barajaba."
    mc "Je vois chaque jour dans le miroir une version plus jeune de ton visage. Depuis que je t'ai rencontré, c'était une des possibilités que j'avais envisagées."

# game/scripts/c21/c21.rpy:1527
translate french c21s002_AaronCall_8cb11edb:

    # mc "¿Lo saben [ama] y [eva]?"
    mc "Est-ce que [ama] et [eva] le savent ?"

# game/scripts/c21/c21.rpy:1529
translate french c21s002_AaronCall_780ec8d6:

    # aar "No, no lo saben. Y preferiría que no lo supieran. Aunque no me extrañaría que lo sospecharan. Seguramente recuerdan qué aspecto teníamos hace 13 o 14 años."
    aar "Non, ils ne savent pas. Et je préfère qu'ils ne le sachent pas. Même si je ne serais pas surpris qu'ils s'en doutent. Ils se souviennent probablement de notre apparence il y a 13 ou 14 ans."

# game/scripts/c21/c21.rpy:1530
translate french c21s002_AaronCall_efcb1f17:

    # aar "Nos parecíamos más a ti de lo que me parezco yo ahora. Un día atarán cabos, pero espero que tarden en hacerlo."
    aar "Nous étions plus comme toi à l'époque que je ne le suis maintenant. Un jour, ils comprendront, mais j'espère que ça leur prendra du temps."

# game/scripts/c21/c21.rpy:1531
translate french c21s002_AaronCall_d0059116:

    # mc "No te preocupes, no se lo diré. Pero ahora que he confirmado mis sospechas... no sé cómo tratarte."
    mc "Ne t'inquiète pas, je ne lui dirai rien. Mais maintenant que mes soupçons sont confirmés… je ne sais plus comment me comporter avec toi."

# game/scripts/c21/c21.rpy:1533
translate french c21s002_AaronCall_aff66c1e:

    # aar "*Risa* Es por lo que no quiero que [ama] y [eva] lo sepan. Sería raro para ellas. Puedes tratarme como a un socio."
    aar "*Rires* C'est pour ça que je ne veux pas que [ama] et [eva] le sachent. Ce serait bizarre pour eux. Vous pouvez me considérer comme un partenaire."

# game/scripts/c21/c21.rpy:1534
translate french c21s002_AaronCall_3f71da55:

    # aar "No nos vamos a convertir en familia por compartir ADN."
    aar "Nous ne deviendrons pas une famille simplement parce que nous partageons le même ADN."

# game/scripts/c21/c21.rpy:1535
translate french c21s002_AaronCall_24f9d7c8:

    # mc "Me parece bien. Raro, pero bien."
    mc "Ça me paraît bien. Bizarre, mais bien."

# game/scripts/c21/c21.rpy:1537
translate french c21s002_AaronCall_e7a7e5cf:

    # aar "Entonces te dejo. Tienes que hablar con tu familia sobre las acciones. Dile a cualquiera de mis chicas que me informe de vuestra decisión, por favor."
    aar "Je vous laisse donc. Vous devez parler des options d'achat d'actions à votre famille. Veuillez demander à l'une de mes filles de me tenir au courant de votre décision."

# game/scripts/c21/c21.rpy:1538
translate french c21s002_AaronCall_14010c89:

    # mc "Lo haré. Pero son nuestras chicas."
    mc "Je le ferai. Mais ce sont nos filles."

# game/scripts/c21/c21.rpy:1539
translate french c21s002_AaronCall_0639f7d8:

    # aar "La próxima vez que nos veamos, supongo que será aquí, en Aruba. En dos o tres semanas más o menos deberías venir."
    aar "La prochaine fois que nous nous verrons, je suppose que ce sera ici à Aruba. Tu devrais arriver dans deux ou trois semaines."

# game/scripts/c21/c21.rpy:1540
translate french c21s002_AaronCall_e226d49b:

    # mc "¿Sólo dos o tres semanas?"
    mc "Deux ou trois semaines seulement ?"

# game/scripts/c21/c21.rpy:1542
translate french c21s002_AaronCall_2b20622b:

    # aar "Más o menos. Hay mucho trabajo que hacer y cuanto antes haya una figura visible, mejor."
    aar "Plus ou moins. Il reste beaucoup de travail à faire, et plus tôt on aura une idée précise, mieux ce sera."

# game/scripts/c21/c21.rpy:1543
translate french c21s002_AaronCall_ca79b601:

    # mc "No me gusta la idea pero vale. Nos vemos en dos o tres semanas en Aruba."
    mc "L'idée ne me plaît pas, mais bon. On se voit dans deux ou trois semaines à Aruba."

