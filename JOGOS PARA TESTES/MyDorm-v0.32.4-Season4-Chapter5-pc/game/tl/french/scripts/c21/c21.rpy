# game/scripts/c21/c21.rpy:3266
translate french c21s005_DebLake_208d556e:

    # mc "Bueno, creo que toca volver a casa."
    mc "Bon, je crois qu'il est temps de rentrer à la maison."

# game/scripts/c21/c21.rpy:3267
translate french c21s005_DebLake_44d9699d:

    # deb "Sí. Me da pena irme de aquí, nos lo hemos pasado muy bien hoy."
    deb "Oui. Je suis triste de partir d'ici, nous avons passé une excellente journée."

# game/scripts/c21/c21.rpy:3268
translate french c21s005_DebLake_57c7bb62:

    # mc "Podemos volver cuando quieras."
    mc "Nous pouvons revenir quand vous le souhaitez."

# game/scripts/c21/c21.rpy:3270
translate french c21s005_DebLake_8ab4c3ea:

    # deb "La próxima vez quiero que sea en una cama."
    deb "La prochaine fois, je veux que ce soit dans un lit."

# game/scripts/c21/c21.rpy:3271
translate french c21s005_DebLake_9a09cad8:

    # mc "Hay una cama muy grande en mi habitación."
    mc "Il y a un très grand lit dans ma chambre."

# game/scripts/c21/c21.rpy:3273
translate french c21s005_DebLake_9aecbdc0:

    # deb "Y quiero... llegar hasta el final... si crees que estoy preparada."
    deb "Et je veux... aller jusqu'au bout... si vous pensez que je suis prêt."

# game/scripts/c21/c21.rpy:3274
translate french c21s005_DebLake_ae6bc43e:

    # mc "Si crees que lo estás, significa que lo estás."
    mc "Si vous pensez l'être, alors vous l'êtes."

# game/scripts/c21/c21.rpy:3276
translate french c21s005_DebLake_c704286c:

    # deb "Dame unos días para pensar un par de cosas que quiero hablar contigo antes."
    deb "Laissez-moi quelques jours pour réfléchir à deux ou trois choses dont je voudrais vous parler avant de vous les annoncer."

# game/scripts/c21/c21.rpy:3277
translate french c21s005_DebLake_a1aa434a:

    # mc "Todo el tiempo que necesites, y puedes hablar conmigo de cualquier cosa que necesites."
    mc "Vous avez tout le temps qu'il vous faut, et vous pouvez me parler de tout ce dont vous avez besoin."

# game/scripts/c21/c21.rpy:3279
translate french c21s005_DebLake_15213cf1:

    # deb "Entonces, ya nos podemos ir. Pero antes..."
    deb "Alors nous pourrons y aller. Mais avant cela…"

# game/scripts/c21/c21.rpy:3281
translate french c21s005_DebLake_34381cbc:

    # "Su beso sabe a despedida."
    "Son baiser a le goût des adieux."

# game/scripts/c21/c21.rpy:3282
translate french c21s005_DebLake_a0de7194:

    # "Sabes que, pese a que todo el mundo sepa que estáis juntos, no va a besarte así en casa."
    "Tu sais bien que, même si tout le monde sait que vous êtes ensemble, il ne t'embrassera pas comme ça à la maison."

# game/scripts/c21/c21.rpy:3283
translate french c21s005_DebLake_35075453:

    # "Al menos por un tiempo, aunque no entiendas por qué."
    "Au moins pour un temps, même si vous ne comprenez pas pourquoi."

# game/scripts/c21/c21.rpy:3286
translate french c21s005_DebLake_d270ce06:

    # "Al cabo de unos minutos emprendéis el camino a casa."
    "Après quelques minutes, vous entamez votre voyage de retour à la maison."

# game/scripts/c21/c21.rpy:3287
translate french c21s005_DebLake_c360a1cc:

    # "De camino a casa intentas sonsacarle el porqué de la timidez de los besos en casa. No obtienes respuestas."
    "Sur le chemin du retour, tu essaies de lui faire expliquer pourquoi elle est timide pour embrasser à la maison. Tu n'obtiens aucune réponse."

# game/scripts/c21/c21.rpy:3288
translate french c21s005_DebLake_61dbc307:

    # "Llegáis con tiempo suficiente para ducharos antes de cenar."
    "Vous arrivez suffisamment tôt pour prendre une douche avant le dîner."

# game/scripts/c21/c21.rpy:3292
translate french c21s006_Nor_85a5dca5:

    # "La cena pasa sin ningún evento reseñable, muchas risas, muchas anécdotas sobre la fiesta del día anterior que te perdiste por no estar en el sitio adecuado."
    "Le dîner se déroule sans incident notable, avec beaucoup de rires et de nombreuses anecdotes sur la fête de la veille que vous avez manquée parce que vous n'étiez pas au bon endroit."

# game/scripts/c21/c21.rpy:3293
translate french c21s006_Nor_72be6aaf:

    # "Era imposible estar en todos sitios, y las chicas tienen muchas cosas que contarse unas a otras."
    "Il était impossible d'être partout, et les filles avaient beaucoup de choses à se raconter."

# game/scripts/c21/c21.rpy:3294
translate french c21s006_Nor_88570f07:

    # "Todas guardan silencio sobre lo que pasó en el jacuzzi."
    "Ils gardent tous le silence sur ce qui s'est passé dans le jacuzzi."

# game/scripts/c21/c21.rpy:3295
translate french c21s006_Nor_da5560f9:

    # "[eva] y [ama] no vienen a cenar. [ama] llama para decir que no se encuentran bien. Nada de lo que preocuparse, pero prefieren quedarse en la base."
    "[eva] et [ama] ne viennent pas dîner. [ama] appelle pour dire qu'il/elle ne se sent pas bien. Rien d'inquiétant, mais il/elle préfère rester à la base."

# game/scripts/c21/c21.rpy:3302
translate french c21s006_Teaser_a7a419ea:

    # "Al final de la noche, cuando estás ayudando a [nor] a recoger los platos..."
    "À la fin de la soirée, quand vous aidez [nor] à débarrasser la table..."

# game/scripts/c21/c21.rpy:3303
translate french c21s006_Teaser_3642816b:

    # nor "¿Te apetece subir a mi habitación cuando acabemos? Parece que hace siglos que no estamos a solas."
    nor "Tu aimerais monter dans ma chambre quand on aura fini ? Ça fait une éternité qu'on n'a pas été seuls ensemble."

# game/scripts/c21/c21.rpy:3304
translate french c21s006_Teaser_df96d4a7:

    # mc "Me apetece siempre. Tú también podrías venir a mi habitación."
    mc "Je suis toujours partant. Tu peux venir dans ma chambre aussi."

# game/scripts/c21/c21.rpy:3306
translate french c21s006_Teaser_101752c9:

    # nor "Podría, pero hay menos posibilidades de que alguien nos interrumpa en la mía."
    nor "Je pourrais, mais il y a moins de chances que quelqu'un nous interrompe sur la mienne."

# game/scripts/c21/c21.rpy:3307
translate french c21s006_Teaser_85785e06:

    # mc "*Risa* Tienes razón. Mi habitación parece un aeropuerto últimamente, con tantas entradas y salidas."
    mc "*Rires* Tu as raison. Ma chambre ressemble à un aéroport ces derniers temps, avec tous ces allées et venues."

# game/scripts/c21/c21.rpy:3309
translate french c21s006_Teaser_80d73381:

    # nor "*Susurrando* ¿Acabas tú de recoger mientras yo subo y me voy poniendo guapa para ti?"
    nor "*Chuchotant* Tu viens de finir de ranger pendant que je monte me préparer pour toi ?"

# game/scripts/c21/c21.rpy:3310
translate french c21s006_Teaser_c17bfb64:

    # mc "Ya estás guapa para mí, mi amor. Pero ve subiendo si quieres. En cinco minutos estoy allí."
    mc "Tu es magnifique à mes yeux, mon amour. Mais monte si tu veux. J'arrive dans cinq minutes."

# game/scripts/c21/c21.rpy:3311
translate french c21s006_Teaser_3a494236:

    # nor "Que sean diez."
    nor "Qu'il y en ait dix."

# game/scripts/c21/c21.rpy:3313
translate french c21s006_Teaser_20acc60e:

    # "Diez minutos después..."
    "Dix minutes plus tard..."

# game/scripts/c21/c21.rpy:3314
translate french c21s006_Teaser_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c21/c21.rpy:3315
translate french c21s006_Teaser_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "C'est moi. Puis-je entrer ?"

# game/scripts/c21/c21.rpy:3316
translate french c21s006_Teaser_846dc0f1:

    # nor "*A través de la puerta* Pasa, mi amor."
    nor "*Par la porte* Entre, mon amour."

# game/scripts/c21/c21.rpy:3322
translate french c21s006_Teaser_80385b21:

    # nor "Espero que te guste esto. Lo he comprado hoy en la tienda de [mad.nick]."
    nor "J'espère que ça vous plaira. Je l'ai acheté aujourd'hui sur la boutique [mad.nick]."

