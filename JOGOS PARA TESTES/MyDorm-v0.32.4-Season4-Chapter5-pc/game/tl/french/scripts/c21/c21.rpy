translate french c21s002_BettyMassageAndDrivingLicense_586a8abe:

    # emm "*Susurrando* ¿Creéis que aunque nos vistamos no va a saber lo que ha pasado?"
    emm "*Chuchotant* Tu crois que même si on s'habille, il ne saura pas ce qui s'est passé ?"

# game/scripts/c21/c21.rpy:1252
translate french c21s002_BettyMassageAndDrivingLicense_2f8f0326:

    # bet "*Suspiro de sorpresa* ¡Oh!"
    bet "*Soupir de surprise* Oh !"

# game/scripts/c21/c21.rpy:1253
translate french c21s002_BettyMassageAndDrivingLicense_a089bd75:

    # mc "Buenos días, Tía [bet]. ¿Te puedo... te podemos ayudar en algo?"
    mc "Bonjour, tante [bet]. Puis-je... pouvons-nous vous aider pour quelque chose ?"

# game/scripts/c21/c21.rpy:1255
translate french c21s002_BettyMassageAndDrivingLicense_34482b3e:

    # bet "No... venía por lo del carnet de conducir, pero si estás... estáis ocupados... ya volveré más tarde."
    bet "Non… Je suis venu pour le permis de conduire, mais si vous êtes occupé… je reviendrai plus tard."

# game/scripts/c21/c21.rpy:1257
translate french c21s002_BettyMassageAndDrivingLicense_57c35b93:

    # eri "No te preocupes, Tía [bet]. Nosotras ya nos íbamos."
    eri "Ne t'inquiète pas, tante [bet]. On partait justement."

# game/scripts/c21/c21.rpy:1258
translate french c21s002_BettyMassageAndDrivingLicense_54c2425e:

    # mcp "(No se atreve a mirarla directamente. Pese a lo que ha dicho [emm] se tienen que sentir un poco avergonzadas.)"
    mcp "(Elle n'ose pas la regarder directement. Malgré ce qu'elle a dit, elles doivent se sentir un peu gênées.)"

# game/scripts/c21/c21.rpy:1259
translate french c21s002_BettyMassageAndDrivingLicense_8c898c2f:

    # mc "Siéntate un momento, Tía [bet]."
    mc "Asseyez-vous un instant, tante [bet]."

# game/scripts/c21/c21.rpy:1261
translate french c21s002_BettyMassageAndDrivingLicense_21057d78:

    # dap "Sí, quiero darme una ducha..."
    dap "Oui, je veux prendre une douche..."

# game/scripts/c21/c21.rpy:1263
translate french c21s002_BettyMassageAndDrivingLicense_9f93c98b:

    # emm "*Risa* ¿Quieres quitarte todo el sudor de anoche?"
    emm "*Rires* Tu veux te débarrasser de toute la sueur d'hier soir ?"

# game/scripts/c21/c21.rpy:1265
translate french c21s002_BettyMassageAndDrivingLicense_088efb80:

    # eri "Ya os dejamos solos, Tía [bet]."
    eri "Nous vous laissons tranquille maintenant, tante [bet]."

# game/scripts/c21/c21.rpy:1266
translate french c21s002_BettyMassageAndDrivingLicense_f83f9f91:

    # dap "Si puedes... no se lo cuentes a nadie."
    dap "Si vous le pouvez... ne le dites à personne."

# game/scripts/c21/c21.rpy:1267
translate french c21s002_BettyMassageAndDrivingLicense_9d188053:

    # mc "¿Vamos a volver a los secretos después de lo de ayer?"
    mc "Allons-nous retourner aux secrets après ce qui s'est passé hier ?"

# game/scripts/c21/c21.rpy:1268
translate french c21s002_BettyMassageAndDrivingLicense_af6c42bd:

    # emm "Por lo que a mí respecta, se lo puedes contar a quien quieras. Estoy orgullosa de que mi novio haya podido complacer a tres mujeres a la vez."
    emm "Pour moi, tu peux le dire à qui tu veux. Je suis fière que mon copain ait pu satisfaire trois femmes à la fois."

# game/scripts/c21/c21.rpy:1270
translate french c21s002_BettyMassageAndDrivingLicense_c409a293:

    # emm "No sabes lo que te pierdes siendo monja. *Risa*"
    emm "Tu ne sais pas ce que tu rates en devenant nonne. *Rires*"

# game/scripts/c21/c21.rpy:1272
translate french c21s002_BettyMassageAndDrivingLicense_6ae4d506:

    # bet "No era lo que esperaba encontrarme... Pero no os preocupéis. No es algo que salga en una conversación normal."
    bet "Ce n'est pas ce à quoi je m'attendais… Mais ne vous inquiétez pas. Ce n'est pas un sujet qui revient dans une conversation ordinaire."

# game/scripts/c21/c21.rpy:1274
translate french c21s002_BettyMassageAndDrivingLicense_5c9f488e:

    # "Las chicas abandonan la habitación. Ninguna de ellas te da un beso de buenos días."
    "Les filles quittent la pièce. Aucune d'elles ne te fait la bise du matin."

# game/scripts/c21/c21.rpy:1275
translate french c21s002_BettyMassageAndDrivingLicense_9be5cfb5:

    # bet "¿Te va bien que miremos lo del carnet de conducir ahora?"
    bet "Est-ce que nous pouvons examiner le permis de conduire maintenant ?"

# game/scripts/c21/c21.rpy:1277
translate french c21s002_BettyMassageAndDrivingLicense_5066a30e:

    # mcp "(Es mejor que nos pongamos a hacer lo que ha venido a hacer antes de que quiera meter la nariz en lo que acaba de ver.)"
    mcp "(Nous ferions mieux de nous occuper de ce qu'elle est venue faire avant qu'elle n'essaie de fouiller dans ce qu'elle vient de voir.)"

# game/scripts/c21/c21.rpy:1281
