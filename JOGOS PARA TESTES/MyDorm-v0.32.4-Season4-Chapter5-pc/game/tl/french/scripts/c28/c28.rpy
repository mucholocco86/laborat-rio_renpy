    dap "[sca]!" (multiple=2)

# game/scripts/c28/c28.rpy:1958
translate french c28s004_ScaGetsJob_87511055:

    # sca "¡Oops! Perdón..."
    sca "Oups ! Désolé..."

# game/scripts/c28/c28.rpy:1959
translate french c28s004_ScaGetsJob_3b916da8:

    # mc "¿Qué pasa?"
    mc "Ce qui se passe?"

# game/scripts/c28/c28.rpy:1961
translate french c28s004_ScaGetsJob_cc10cf6f:

    # todas "Nada, nada. No te preocupes."
    todas "Rien, rien. Ne t'inquiète pas."

# game/scripts/c28/c28.rpy:1962
translate french c28s004_ScaGetsJob_e3d0f55a:

    # mc "*Risa* Eso casi me preocupa más que si no hubierais dicho nada."
    mc "*Rires* Ça m'inquiète presque plus que si tu n'avais rien dit."

# game/scripts/c28/c28.rpy:1963
translate french c28s004_ScaGetsJob_6a3745ed:

    # mc "Pero supongo que no os voy a sacar ninguna información."
    mc "Mais je suppose que je n'obtiendrai aucune information de votre part."

# game/scripts/c28/c28.rpy:1964
translate french c28s004_ScaGetsJob_3b1f156c:

    # todas "Ni una palabra."
    todas "Pas un mot."

# game/scripts/c28/c28.rpy:1967
translate french c28s004_ScaGetsJob_40a14f2d:

    # mom "Sí, coge los que quieras."
    mom "Oui, prenez-en autant que vous voulez."

# game/scripts/c28/c28.rpy:1969
translate french c28s004_ScaGetsJob_02533cd2:

    # mc "Por cierto, ¿por qué vais disfrazadas?"
    mc "Au fait, pourquoi êtes-vous tous déguisés ?"

# game/scripts/c28/c28.rpy:1970
translate french c28s004_ScaGetsJob_dc53d40d:

    # dap "Nos estábamos probando ropa cuando [sca] ha recibido la llamada." id c28s004_ScaGetsJob_dc53d40d
    dap "Nous étions en train d'essayer des vêtements lorsque [sca] a reçu l'appel." id c28s004_ScaGetsJob_dc53d40d

# game/scripts/c28/c28.rpy:1971
translate french c28s004_ScaGetsJob_cc1dd83f:

    # sca "Queríamos hacer unas fotos de cosplay para subirlas a InstaPic."
    sca "Nous voulions prendre des photos de cosplay à télécharger sur InstaPic."

# game/scripts/c28/c28.rpy:1974
translate french c28s004_ScaGetsJob_df0910b6:

    # "Después de eso, pasáis un rato charlando de la propuesta de matrimonio y del trabajo de [sca]."
    "Après cela, vous passez un peu de temps à discuter de la demande en mariage et du travail de [sca]."

# game/scripts/c28/c28.rpy:1976
translate french c28s004_ScaGetsJob_018726bd:

    # "Obviamente, lo que fuera a escapársele a [sca] no vuelve a hacer su aparición en la conversación."
    "Évidemment, ce que [sca] a manqué ne réapparaît pas dans la conversation."

# game/scripts/c28/c28.rpy:1978
translate french c28s004_ScaGetsJob_5dc0265d:

    # "Pasáis un rato charlando del trabajo de [sca], intentando sin éxito quitarle los nervios."
    "Vous passez un peu de temps à discuter du travail de [sca], en essayant sans succès de calmer ses nerfs."

# game/scripts/c28/c28.rpy:1979
translate french c28s004_ScaGetsJob_9327230f:

    # "Al cabo de un rato las chicas deciden seguir visitando a todo el mundo para dar la noticia. Hay una nueva camarera en la familia."
    "Au bout d'un moment, les filles décident de continuer à rendre visite à tout le monde pour partager la nouvelle : il y a une nouvelle serveuse dans la famille."

# game/scripts/c28/c28.rpy:1982
translate french c28s004_ScaGetsJob_3431064b:

    # "Tú vuelves a tu habitación. Estás seguro de que Aaron te habrá mandado dos o tres correos a estas horas."
    "Vous retournez dans votre chambre. Vous êtes certain qu'Aaron vous a déjà envoyé deux ou trois courriels."

# game/scripts/c28/c28.rpy:1997
translate french c28s004_DebKiaraTalk_7d80596c:

    # kia "Ahora te busco ese libro. Me extraña que no tengan las memorias de Dana Torres en la universidad."
    kia "Je vais chercher ce livre pour vous. Je suis surprise qu'ils n'aient pas les mémoires de Dana Torres à l'université."

# game/scripts/c28/c28.rpy:1998
translate french c28s004_DebKiaraTalk_5914091b:

    # deb "No es que no lo tengan. Es que solo tienen un ejemplar y alguien lo ha cogido justo hoy."
    deb "Ce n'est pas qu'ils ne l'ont pas. C'est qu'ils n'en ont qu'un seul exemplaire, et quelqu'un vient de s'en emparer aujourd'hui."

# game/scripts/c28/c28.rpy:1999
translate french c28s004_DebKiaraTalk_985b03a9:

    # deb "Tengo ganas de leerlo y no quiero esperar a que lo devuelvan."
    deb "J'ai hâte de le lire et je ne veux pas attendre qu'il me soit rendu."

# game/scripts/c28/c28.rpy:2001
translate french c28s004_DebKiaraTalk_cfb21edb:

    # kia "¿Por eso has pensado en mí?"
    kia "C'est pour ça que tu as pensé à moi ?"

# game/scripts/c28/c28.rpy:2002
translate french c28s004_DebKiaraTalk_ce20af47:

    # kia "*Risa* Solo me quieres por mis libros..."
    kia "*Rires* Tu ne m'aimes que pour mes livres..."

# game/scripts/c28/c28.rpy:2004
translate french c28s004_DebKiaraTalk_f99561bb:

    # deb "*Risa* Sabes que no es verdad. Te quiero por muchas más cosas. Pero adoro tus libros y que nos podamos sentar en la piscina a hablar de ellos."
    deb "*Rires* Tu sais bien que ce n'est pas vrai. Je t'aime pour tellement d'autres choses. Mais j'adore tes livres et le fait qu'on puisse s'asseoir au bord de la piscine et en parler."

# game/scripts/c28/c28.rpy:2005
translate french c28s004_DebKiaraTalk_d974cf2b:

    # deb "No hay mucha gente en casa con quien hablar de algunos libros."
    deb "Il n'y a pas grand monde à la maison avec qui parler de certains livres."

# game/scripts/c28/c28.rpy:2007
translate french c28s004_DebKiaraTalk_9dfce8ea:

    # kia "Tienes razón. No hay muchos fans de Jane Austen en casa."
    kia "Vous avez raison. Il n'y a pas beaucoup de fans de Jane Austen à la maison."

# game/scripts/c28/c28.rpy:2008
translate french c28s004_DebKiaraTalk_a70f3e8e:

    # kia "¿Quieres llevarte algún libro más?"
    kia "Souhaiteriez-vous prendre d'autres livres ?"

# game/scripts/c28/c28.rpy:2010
translate french c28s004_DebKiaraTalk_dd8e9a89:

    # deb "Sí. Mira a ver si tenéis '¿Por qué Tía [kia] no nos ha dicho que ayer fue su cumpleaños?'"
    deb "Oui. Regarde si tu as trouvé la question : « Pourquoi tante [kia] ne nous a-t-elle pas dit que c’était son anniversaire hier ? »"

# game/scripts/c28/c28.rpy:2011
translate french c28s004_DebKiaraTalk_30c9a8e8:

    # deb "Dicen que es un clásico sobre la gente que cree que no tiene nada que celebrar."
    deb "On dit que c'est un classique sur des gens qui pensent n'avoir rien à célébrer."

# game/scripts/c28/c28.rpy:2013
translate french c28s004_DebKiaraTalk_f184a36d:

    # kia "¿Me vas a echar la bronca por no celebrar mi cumpleaños?"
    kia "Tu vas me gronder parce que je n'ai pas fêté mon anniversaire ?"

# game/scripts/c28/c28.rpy:2015
translate french c28s004_DebKiaraTalk_e58d1bf5:

    # deb "Esa era una de mis ideas cuando venía hacia aquí. [eil] nos lo ha dicho esta mañana."
    deb "C'est une des choses auxquelles je pensais en venant ici. [eil] nous l'a dit ce matin."

# game/scripts/c28/c28.rpy:2016
translate french c28s004_DebKiaraTalk_b0572988:

    # deb "Primero le hemos echado la bronca a ella por no decírnoslo antes para prepararte una fiesta sorpresa."
    deb "Nous l'avons d'abord grondée de ne pas nous l'avoir dit plus tôt, afin que nous puissions te préparer une fête surprise."

# game/scripts/c28/c28.rpy:2018
translate french c28s004_DebKiaraTalk_9f0693f3:

    # kia "No me gustan las fiestas sorpresa, y no me gusta celebrar mi cumpleaños."
    kia "Je n'aime pas les fêtes surprises, et je n'aime pas fêter mon anniversaire."

# game/scripts/c28/c28.rpy:2019
translate french c28s004_DebKiaraTalk_cf466563:

    # kia "Con lo que es mejor que [eil] os lo haya dicho cuando ya ha pasado. De todas formas, le echaré bronca por decíroslo." id c28s004_DebKiaraTalk_cf466563
    kia "C'est donc mieux que [eil] te l'ait dit après coup. Bref, je vais lui dire ses quatre vérités pour te l'avoir dit." id c28s004_DebKiaraTalk_cf466563

# game/scripts/c28/c28.rpy:2021
translate french c28s004_DebKiaraTalk_442ec956:

    # deb "Se le ha escapado. Estábamos tomando el sol y [sca] ha venido preguntando las fechas de nacimiento."
    deb "Ça m'a échappé. On prenait un bain de soleil et [sca] est venu nous demander nos dates de naissance."

# game/scripts/c28/c28.rpy:2022
translate french c28s004_DebKiaraTalk_4c09976b:

    # deb "Quiere hacer algo con una app para que no se nos olvide nunca felicitarnos entre nosotras."
    deb "Elle veut créer une application pour qu'on n'oublie jamais de se féliciter les uns les autres."

# game/scripts/c28/c28.rpy:2023
translate french c28s004_DebKiaraTalk_411d97f9:

    # deb "[eil] ha dicho su fecha de nacimiento y la tuya. Todas hemos flipado cuando nos hemos dado cuenta de que tu cumpleaños fue ayer."
    deb "[eil] a dit sa date de naissance et la tienne. On a tous été surpris d'apprendre que ton anniversaire était hier."

# game/scripts/c28/c28.rpy:2025
translate french c28s004_DebKiaraTalk_1adbd33d:

    # kia "¿[eil] no os ha dicho por qué no lo celebro?"
    kia "[eil] Ne t'a-t-il pas dit pourquoi je ne fête rien ?"

# game/scripts/c28/c28.rpy:2027
translate french c28s004_DebKiaraTalk_3602b04a:

    # deb "Nos ha dicho que no te gusta hacerlo, pero no nos ha querido contar por qué." id c28s004_DebKiaraTalk_3602b04a
    deb "Elle nous a dit qu'elle n'aimait pas le faire, mais elle n'a pas voulu nous dire pourquoi." id c28s004_DebKiaraTalk_3602b04a

# game/scripts/c28/c28.rpy:2029
translate french c28s004_DebKiaraTalk_58e825de:

    # kia "Mis cumpleaños dejaron de ser importantes cuando nació ella. No porque naciera ella, claro."
    kia "Mes anniversaires ont cessé d'avoir de l'importance le jour de sa naissance. Non pas parce qu'elle est née, bien sûr."

# game/scripts/c28/c28.rpy:2030
translate french c28s004_DebKiaraTalk_4d5b1087:

    # kia "Pero es cuando todo se empezó a ir a la mierda con Solomon."
    kia "Mais c'est à ce moment-là que tout a commencé à partir en vrille avec Solomon."

# game/scripts/c28/c28.rpy:2032
translate french c28s004_DebKiaraTalk_5dd4bae7:

    # kia "Cada vez tenía menos ganas de celebrar nada que no tuviera que ver directamente con [eil]."
    kia "J'étais de moins en moins enclin à célébrer quoi que ce soit qui ne soit pas directement lié à [eil]."

# game/scripts/c28/c28.rpy:2033
translate french c28s004_DebKiaraTalk_4f89a79a:

    # kia "Ella no tenía que pagar las consecuencias de un matrimonio infeliz."
    kia "Elle n'a pas eu à subir les conséquences d'un mariage malheureux."

# game/scripts/c28/c28.rpy:2035
translate french c28s004_DebKiaraTalk_df9c82cd:

    # kia "Y celebrar mi cumpleaños era un recordatorio de que... no sé..."
    kia "Et fêter mon anniversaire m'a rappelé que... je ne sais pas..."

# game/scripts/c28/c28.rpy:2036
translate french c28s004_DebKiaraTalk_afea7ea1:

    # kia "Cuando Solomon empezó a olvidarlos casi me alegré. Se convirtió en una costumbre no celebrarlos. Porque no había nada que celebrar."
    kia "Quand Salomon commença à les oublier, j'en fus presque soulagé. Ne plus les célébrer devint une habitude, car il n'y avait plus rien à célébrer."

# game/scripts/c28/c28.rpy:2038
translate french c28s004_DebKiaraTalk_54288c34:

    # deb "Pero ahora Solomon no está, con lo que sería un buen momento para volver a celebrarlos."
    deb "Mais maintenant que Salomon n'est plus là, ce serait le moment idéal pour les célébrer à nouveau."

# game/scripts/c28/c28.rpy:2039
translate french c28s004_DebKiaraTalk_925d495a:

    # deb "No te vas a librar. Recuerda lo bien que estuvo la fiesta de las chicas."
    deb "Tu ne t'en tireras pas comme ça. Tu te souviens comme la fête des filles était géniale ?"

# game/scripts/c28/c28.rpy:2041
translate french c28s004_DebKiaraTalk_096eee75:

    # kia "*Risa* Ellas cumplían 19. ¡Yo cumpliré 48 en mi próximo cumpleaños!"
    kia "*Rires* Ils allaient avoir 19 ans. J'aurai 48 ans à mon prochain anniversaire !"

# game/scripts/c28/c28.rpy:2042
translate french c28s004_DebKiaraTalk_96c2dd60:

    # kia "*Risa* No creo que sea algo para celebrar."
    kia "*Rires* Je ne pense pas que ce soit une raison de se réjouir."

# game/scripts/c28/c28.rpy:2045
translate french c28s004_DebKiaraTalk_448f7aea:

    # deb "Pues celebremos el primer año sin Solomon el día de tu cumpleaños."
    deb "Alors, fêtons cette première année sans Solomon le jour de ton anniversaire."

# game/scripts/c28/c28.rpy:2047
translate french c28s004_DebKiaraTalk_3e9bea39:

    # deb "Y tu primer año con [mc]."
    deb "Et votre première année avec [mc]."

# game/scripts/c28/c28.rpy:2048
translate french c28s004_DebKiaraTalk_ca4e1fb3:

    # deb "Al menos así no coincidirá con el cumpleaños de las chicas. Y si no quieres, te haremos una fiesta sorpresa."
    deb "Au moins, ça ne coïncidera pas avec l'anniversaire des filles. Et si ça ne vous plaît pas, on vous organisera une fête surprise."

# game/scripts/c28/c28.rpy:2050
translate french c28s004_DebKiaraTalk_90b2d3df:

    # kia "*Risa* Las fiestas sorpresa las odiaba antes de conocer a Solomon. Ni se os ocurra hacerme una si no queréis verme enfadada de verdad."
    kia "*Rires* Avant de rencontrer Solomon, je détestais les fêtes surprises. N'y pensez même pas si vous ne voulez pas me voir vraiment en colère."

# game/scripts/c28/c28.rpy:2051
translate french c28s004_DebKiaraTalk_0e83532a:

    # kia "Voy a buscarte ese libro antes de que llegue más gente."
    kia "Je te procurerai ce livre avant l'arrivée d'autres personnes."

# game/scripts/c28/c28.rpy:2053
translate french c28s004_DebKiaraTalk_5a865f4a:

    # deb "*Escribiendo en el grupo de WhatsUp 'Fiesta sorpresa para [kia]'* Chicas, fiesta sorpresa de mañana anulada. Parece que realmente no le gustan." id c28s004_DebKiaraTalk_5a865f4a
    deb "*Message dans le groupe WhatsApp « Fête surprise pour [kia] »* Les filles, la fête surprise de demain est annulée. Il semblerait qu'elle ne les apprécie pas vraiment." id c28s004_DebKiaraTalk_5a865f4a

# game/scripts/c28/c28.rpy:2054
translate french c28s004_DebKiaraTalk_867f7d97:

    # eil "*En el grupo de WhatsUp* Os lo he dicho. Sé cómo es mi madre..."
    eil "*Dans le groupe WhatsApp*, je te l'ai dit. Je sais comment est ma mère..."

# game/scripts/c28/c28.rpy:2055
translate french c28s004_DebKiaraTalk_35a5a348:

    # sca "*En el grupo de WhatsUp* Mañana preguntaré en el grupo general a quién le gustan las fiestas sorpresa. Así [kia] puede decir que a ella no."
    sca "*Dans le groupe WhatsApp* Demain, je demanderai dans le groupe général qui aime les fêtes surprises. Comme ça, [kia] pourra dire qu'elle n'aime pas ça."

# game/scripts/c28/c28.rpy:2056
translate french c28s004_DebKiaraTalk_6b349194:

    # sca "*En el grupo de WhatsUp* Lo añadiré a la ficha de cada una en la app."
    sca "*Dans le groupe WhatsApp*, je l'ajouterai au profil de chaque personne dans l'application."

# game/scripts/c28/c28.rpy:2057
translate french c28s004_DebKiaraTalk_3a6fe0b3:

    # sai "*En el grupo de WhatsUp* Eso le quitará algo de sorpresa a las fiestas. Pero puedes apuntar que a mí no me desagradan."
    sai "*Dans le groupe WhatsApp* Cela atténuera un peu l'effet de surprise. Mais vous pouvez préciser que cela ne me dérange pas."

# game/scripts/c28/c28.rpy:2061
translate french c28s004_DebKiaraTalk_172f8095:

    # "Un par de minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c28/c28.rpy:2062
translate french c28s004_DebKiaraTalk_e304f6eb:

    # kia "Aquí tienes el libro. ¿Necesitas alguna cosa más?"
    kia "Voici le livre. Avez-vous besoin de quelque chose d'autre ?"

# game/scripts/c28/c28.rpy:2065
translate french c28s004_DebKiaraTalk_f5e21b63:

    # deb "Como tu fuiste la primera..."
    deb "Puisque vous étiez le premier..."

# game/scripts/c28/c28.rpy:2066
translate french c28s004_DebKiaraTalk_e30e4f8e:

    # deb "¿Quería preguntarte qué te parece la idea de [mad.nick] sobre los anillos?"
    deb "Je voulais vous demander ce que vous pensez de l'idée de [mad.nick] concernant les anneaux ?"

# game/scripts/c28/c28.rpy:2067
translate french c28s004_DebKiaraTalk_22c689f3:

    # deb "Creo que resolvería el problema del que se estuvo hablando el otro día en el grupo de WhatsUp."
    deb "Je pense que cela résoudrait le problème dont on parlait l'autre jour dans le groupe WhatsApp."

# game/scripts/c28/c28.rpy:2069
translate french c28s004_DebKiaraTalk_9a1ce82b:

    # kia "A mí me parece una idea buenísima. Ponerse de acuerdo iba a ser muy difícil."
    kia "Je trouve que c'est une excellente idée. Parvenir à un accord aurait été très difficile."

# game/scripts/c28/c28.rpy:2071
translate french c28s004_DebKiaraTalk_61e819b4:

    # kia "Yo ya tengo mi anillo y tenía pensado hacer uno de verdad con la misma forma, pero..."
    kia "J'ai déjà ma bague et je comptais en faire une vraie, de la même forme, mais..."

# game/scripts/c28/c28.rpy:2073
translate french c28s004_DebKiaraTalk_2a02b7ca:

    # deb "Yo creo que iba a ser imposible ponerse de acuerdo."
    deb "Je pense qu'il aurait été impossible de parvenir à un accord."

# game/scripts/c28/c28.rpy:2074
translate french c28s004_DebKiaraTalk_7d8483cc:

    # deb "Ya sabes, diferentes gustos y diferentes expectativas..."
    deb "Vous savez, chacun ses goûts et ses attentes..."

# game/scripts/c28/c28.rpy:2077
translate french c28s004_DebKiaraTalk_04241428:

    # kia "Y después de lo de [mar] de hoy... Creo que no se puede ser más original."
    kia "Et après ce qui s'est passé avec [mar] aujourd'hui... je ne pense pas qu'on puisse faire plus original."

# game/scripts/c28/c28.rpy:2078
translate french c28s004_DebKiaraTalk_3cb371e4:

    # kia "Ya me dirás tú dónde podría encontrar [mar] un anillo con forma de dónut."
    kia "Dites-moi où je pourrais trouver une bague en forme de donut."

# game/scripts/c28/c28.rpy:2079
translate french c28s004_DebKiaraTalk_8ea7861b:

    # kia "Además, creo que lo de [mad.nick] con el post-it es casi insuperable."
    kia "De plus, je pense que le post-it de [mad.nick] est presque imbattable."

# game/scripts/c28/c28.rpy:2081
translate french c28s004_DebKiaraTalk_dc185753:

    # deb "La verdad es que ya empiezo a tener ganas de que llegue el día..."
    deb "À vrai dire, je commence déjà à attendre ce jour avec impatience..."

# game/scripts/c28/c28.rpy:2083
translate french c28s004_DebKiaraTalk_ee7f31df:

    # deb "Aunque no vaya a participar, me encantaría estar ahí cuando suceda."
    deb "Même si je ne participerai pas, j'adorerais être présent lorsque cela se produira."

# game/scripts/c28/c28.rpy:2085
translate french c28s004_DebKiaraTalk_5ea0d84c:

    # kia "[mad.nick] decía que no hay demasiada prisa, pero creo tampoco hay demasiado tiempo."
    kia "[mad.nick] J'ai dit qu'il n'y avait pas trop d'urgence, mais je ne pense pas qu'il y ait beaucoup de temps non plus."

# game/scripts/c28/c28.rpy:2086
translate french c28s004_DebKiaraTalk_1926dc87:

    # kia "La semana que viene se irá a Aruba, y la idea de [mad.nick] era para hacerla antes de que se fuera."
    kia "La semaine prochaine, elle part à Aruba, et l'idée de [mad.nick] était de le faire avant son départ."

# game/scripts/c28/c28.rpy:2088
translate french c28s004_DebKiaraTalk_39b5cd68:

    # kia "Las chicas van a tener que darse prisa."
    kia "Les filles vont devoir se dépêcher."

# game/scripts/c28/c28.rpy:2090
translate french c28s004_DebKiaraTalk_f2160220:

    # kia "Vais a tener que daros un poco de prisa."
    kia "Il va falloir vous dépêcher un peu."

# game/scripts/c28/c28.rpy:2092
translate french c28s004_DebKiaraTalk_afa0faa9:

    # kia "Vamos a tener que darnos prisa."
    kia "Il va falloir se dépêcher."

# game/scripts/c28/c28.rpy:2095
translate french c28s004_DebKiaraTalk_119b056a:

    # deb "Hay que esperar a que vuelvan las Chicas de Oro. No se puede hacer nada antes de que regresen."
    deb "Il faut attendre le retour des Golden Girls. On ne peut rien faire en attendant."

# game/scripts/c28/c28.rpy:2097
translate french c28s004_DebKiaraTalk_9f569263:

    # deb "Aunque las Chicas de Oro no estén implicadas, creo que habría que esperar a que estén aquí para hacerlo."
    deb "Même si les Golden Girls ne sont pas impliquées, je pense qu'il vaut mieux attendre leur présence pour le faire."

# game/scripts/c28/c28.rpy:2099
translate french c28s004_DebKiaraTalk_400f1ae5:

    # deb "Y [meg] tendrá que venir también... Tienes razón, no hay muchos días en que lo podamos hacer..."
    deb "Et [meg] devra venir aussi… Vous avez raison, il n’y a pas beaucoup de jours où nous pouvons le faire…"

# game/scripts/c28/c28.rpy:2101
translate french c28s004_DebKiaraTalk_310db826:

    # "Las dos mujeres continúan charlando un rato, haciendo planes sobre la idea de [mad.nick]."
    "Les deux femmes continuent à bavarder pendant un moment, élaborant des plans concernant l'idée de [mad.nick]."

# game/scripts/c28/c28.rpy:2102
translate french c28s004_DebKiaraTalk_353533ed:

    # "¿Quién podía pensar que un post-it cambiaría el futuro de la familia?"
    "Qui aurait pu croire qu'un simple post-it changerait l'avenir de cette famille ?"

# game/scripts/c28/c28.rpy:2112
translate french c28s005_EriNor_64380619:

    # "Pasas toda la mañana leyendo los informes de Aaron. Te inunda con tanta información que te sientes sobrepasado."
    "Vous passez toute la matinée à lire les rapports d'Aaron. Il vous submerge d'informations, vous laissant complètement dépassé."

# game/scripts/c28/c28.rpy:2114
translate french c28s005_EriNor_079208aa:

    # "Desde informes financieros, pasando por listas de compras e inventarios, a los informes detallados de todas las misiones que NTR ha hecho en los últimos años."
    "Des rapports financiers aux listes de courses et aux inventaires, en passant par des rapports détaillés de toutes les missions entreprises par NTR ces dernières années."

# game/scripts/c28/c28.rpy:2115
translate french c28s005_EriNor_c87d3bcf:

    # "Te detienes especialmente en los informes de las misiones que han hecho [eva] y [ama], sorprendiéndote por las muchas cosas que han hecho."
    "Vous vous attardez particulièrement sur les rapports de mission que [eva] et [ama] ont effectués, et vous êtes surpris par les nombreuses choses qu'ils ont faites."

# game/scripts/c28/c28.rpy:2116
translate french c28s005_EriNor_cd3ff40a:

    # "También lees los informes de las misiones de Beatrice, Claire, y Diana. Es una forma de saber más sobre las chicas que nunca conocerás. No hay informes sobre Fiona."
    "Vous pouvez également lire les rapports de mission de Béatrice, Claire et Diana. C'est une façon d'en apprendre davantage sur les filles que vous ne rencontrerez jamais. Il n'y a aucun rapport sur Fiona."

# game/scripts/c28/c28.rpy:2117
translate french c28s005_EriNor_efc585b4:

    # "Hay muchos informes que descartas o lees tan solo por encima. No crees que tu trabajo como CEO incluya saber cuántos rollos de papel higiénico se gastan mensualmente en la base."
    "Vous ignorez ou survolez de nombreux rapports. Vous pensez sans doute que votre rôle de PDG ne comprend pas la consommation mensuelle de papier toilette à la base."

# game/scripts/c28/c28.rpy:2118
translate french c28s005_EriNor_0795de50:

    # "Tienes que decirle a Aaron que sólo te envíe la documentación relevante o no vas a poder leerlo todo antes de ir a Aruba."
    "Vous devez dire à Aaron de ne vous envoyer que les documents pertinents, sinon vous ne pourrez pas tout lire avant de partir pour Aruba."

# game/scripts/c28/c28.rpy:2119
translate french c28s005_EriNor_e38938f9:

    # "Después de comer, encuentras un informe financiero que llama tu atención. No acabas de entenderlo y decides ir a consultarlo con [nor]."
    "Après le déjeuner, un rapport financier attire votre attention. Vous ne le comprenez pas bien et décidez d'aller consulter [nor]."

# game/scripts/c28/c28.rpy:2120
translate french c28s005_EriNor_109f06c6:

    # "Desde el desayuno solo has salido de tu habitación para comer. Ir a ver a [nor] servirá para despejar la cabeza después de tantas horas leyendo documentación."
    "Depuis le petit-déjeuner, vous n'avez quitté votre chambre que pour manger. Aller voir [nor] vous permettra de vous aérer l'esprit après tant d'heures passées à lire des documents."

# game/scripts/c28/c28.rpy:2162
translate french c28s005_EriNor_110e5f73:

    # "Al llegar a la cocina de [nor]..."
    "En arrivant dans la cuisine de [nor]..."

# game/scripts/c28/c28.rpy:2164
translate french c28s005_EriNor_49426654:

    # eri "¡Esta es preciosa!"
    eri "Celui-ci est magnifique !"

# game/scripts/c28/c28.rpy:2165
translate french c28s005_EriNor_f8b7ead8:

    # nor "Todas lo son. *Risa* Parece que en la universidad hicieron un cásting para enviarnos a las chicas más guapas."
    nor "Elles le sont toutes. *Rires* On dirait que l'université a organisé un casting pour nous envoyer les plus jolies filles."

# game/scripts/c28/c28.rpy:2167
translate french c28s005_EriNor_9d725932:

    # eri "*Risa* Tienes razón."
    eri "*Rires* Tu as raison."

# game/scripts/c28/c28.rpy:2168
translate french c28s005_EriNor_1a3670eb:

    # nor "Aunque las más guapas ya estaban aquí. Nadie supera a mis dos niñas."
    nor "Même si les plus jolies étaient déjà là, personne ne peut rivaliser avec mes deux filles."

# game/scripts/c28/c28.rpy:2169
translate french c28s005_EriNor_7612ebb8:

    # eri "*Risa* ¡Mamá!"
    eri "*Rires* Maman !"

# game/scripts/c28/c28.rpy:2170
translate french c28s005_EriNor_4a194945:

    # mc "Hola, chicas. ¿Qué hacéis?"
    mc "Salut les filles. Qu'est-ce que vous faites ?"

# game/scripts/c28/c28.rpy:2172
translate french c28s005_EriNor_23475f52:

    # nor "Hola, [mc]. Han llegado las fotos de las nuevas estudiantes."
    nor "Bonjour, [mc]. Les photos des nouveaux élèves sont arrivées."

# game/scripts/c28/c28.rpy:2173
translate french c28s005_EriNor_f47010ba:

    # mc "¿Para los expedientes? Ya teníamos esas fotos, ¿no?"
    mc "Pour les fichiers ? Nous avions déjà ces photos, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:2175
translate french c28s005_EriNor_d929966e:

    # mc "Vi la foto de [pat]..."
    mc "J'ai vu la photo de [pat]..."

# game/scripts/c28/c28.rpy:2176
translate french c28s005_EriNor_b984b454:

    # eri "No, ha sido una idea que ha tenido [kal.nick], la prima de [sai]. Debían hacerse una foto a la vez, estuvieran donde estuvieran." id c28s005_EriNor_b984b454
    eri "Non, c'était l'idée de [kal.nick], le cousin de [sai]. Ils devaient absolument prendre une photo en même temps, où qu'ils soient." id c28s005_EriNor_b984b454

# game/scripts/c28/c28.rpy:2177
translate french c28s005_EriNor_de5b68b9:

    # mc "*Risa* Espero que no hubiera ninguna en el lavabo."
    mc "*Rires* J'espère qu'il n'y en avait pas dans l'évier."

# game/scripts/c28/c28.rpy:2180
translate french c28s005_EriNor_7df73a03:

    # nor "*Risa* ¡Qué bruto eres! Supongo que, en ese caso, la hubieran enviado más tarde."
    nor "*Rires* Tu es vraiment naïf ! J'imagine qu'ils l'auraient envoyé plus tard dans ce cas."

# game/scripts/c28/c28.rpy:2181
translate french c28s005_EriNor_852f820d:

    # nor "No creo que una foto sentada en el retrete sea la mejor presentación, pero con las chicas jóvenes nunca lo puedes saber."
    nor "Je ne pense pas qu'une photo d'elle assise sur les toilettes soit la meilleure façon de se présenter, mais avec les jeunes filles, on n'est jamais sûr."

# game/scripts/c28/c28.rpy:2183
translate french c28s005_EriNor_63423b12:

    # eri "¡Mamá! ¡No todas nos tomamos fotos cada vez que respiramos!"
    eri "Maman ! On ne prend pas tous des photos à chaque respiration !"

# game/scripts/c28/c28.rpy:2184
translate french c28s005_EriNor_8eb0eeca:

    # eri "Hasta ahora no hemos tenido ninguna selfie-adicta."
    eri "Jusqu'à présent, nous n'avons eu aucun accro aux selfies."

# game/scripts/c28/c28.rpy:2185
translate french c28s005_EriNor_e7935ec9:

    # mc "Recuerda el meme. Neil Armstrong fue a la luna y tomó tres fotos. Ashley fue al lavabo y tomó 45."
    mc "Vous vous souvenez de ce mème ? Neil Armstrong est allé sur la Lune et a pris trois photos. Ashley est allée aux toilettes et en a pris 45."

# game/scripts/c28/c28.rpy:2187
translate french c28s005_EriNor_2584a64f:

    # eri "*Risa* Eres un capullo. Y tú también perteneces a la generación selfie."
    eri "*Rires* Tu es vraiment un crétin. Et en plus, tu fais partie de la génération selfie."

# game/scripts/c28/c28.rpy:2188
translate french c28s005_EriNor_689998e0:

    # mc "*Risa* Sí, pero yo soy feo, con lo que no me saco fotos."
    mc "*Rires* Oui, mais je suis moche, alors je ne me prends pas en photo."

# game/scripts/c28/c28.rpy:2189
translate french c28s005_EriNor_46ca3edd:

    # mc "A ver esas fotos de las chicas nuevas."
    mc "Montrez-nous les photos des nouvelles filles."

# game/scripts/c28/c28.rpy:2191
translate french c28s005_EriNor_d17145a4:

    # nor "*Risa* Sabía que no te ibas a poder resistir. Y eso que no sabes que algunas están en bikini."
    nor "*Rires* Je savais que tu ne pourrais pas résister. Et tu ne sais même pas que certaines sont en bikini."

# game/scripts/c28/c28.rpy:2193
translate french c28s005_EriNor_d7ba6a78:

    # mc "*Risa* Bueno, ya he visto fotos de [kal] y de [pat]. Me faltan las otras cuatro. No quiero discriminar a nadie."
    mc "*Rires* Bon, j'ai déjà vu les photos de [kal] et [pat]. Il me manque les quatre autres. Je ne veux discriminer personne."

# game/scripts/c28/c28.rpy:2195
translate french c28s005_EriNor_c981aab1:

    # mc "*Risa* Bueno, ya he visto fotos de [kal]. Me faltan las otras cinco. No quiero discriminar a nadie."
    mc "*Rires* Eh bien, j'ai déjà vu des photos de [kal]. Il me manque les cinq autres. Je ne veux discriminer personne."

# game/scripts/c28/c28.rpy:2197
translate french c28s005_EriNor_cdc0fb39:

    # eri "Hay una que no ha enviado la foto todavía. A lo mejor no lo hace. Era opcional, aunque las indicaciones de [kal.nick] eran que tenían que hacerlas hace un par de horas." id c28s005_EriNor_cdc0fb39
    eri "L'une d'elles n'a pas encore envoyé la photo. Peut-être qu'elle ne le fera pas. C'était facultatif, même si [kal.nick] avait demandé qu'elles soient envoyées il y a quelques heures." id c28s005_EriNor_cdc0fb39

# game/scripts/c28/c28.rpy:2198
translate french c28s005_EriNor_d48681d3:

    # mc "Bueno, pues enseñadme las fotos de las otras. Empiezo a tener curiosidad por cómo son."
    mc "D'accord, alors montrez-moi les photos des autres. Je commence à être curieux de voir à quoi ils ressemblent."

# game/scripts/c28/c28.rpy:2200
translate french c28s005_EriNor_aa5bf397:

    # nor "Esta es [kal.nick], pero ya lo sabes por las fotos que te había enseñado [sai]." id c28s005_EriNor_aa5bf397
    nor "C'est [kal.nick], mais vous le savez déjà grâce aux photos que je vous ai montrées [sai]." id c28s005_EriNor_aa5bf397

# game/scripts/c28/c28.rpy:2201
translate french c28s005_EriNor_f7a11f20:

    # mc "¿Sigue de vacaciones por Europa? Eso no parece la India."
    mc "Tu es encore en vacances en Europe ? Ça ne ressemble pas à l'Inde."

# game/scripts/c28/c28.rpy:2202
translate french c28s005_EriNor_b3a7f8e2:

    # nor "Sí, en el correo dice que está en Alemania ahora."
    nor "Oui, le courriel indique qu'il est actuellement en Allemagne."

# game/scripts/c28/c28.rpy:2203
translate french c28s005_EriNor_e0fb7aac:

    # eri "Es guapísima. No sé si me parece más guapa ella o [sai]."
    eri "Elle est magnifique. Je ne sais pas si je la trouve plus jolie ou [sai]."

# game/scripts/c28/c28.rpy:2204
translate french c28s005_EriNor_92e6ac56:

    # mc "[sai] siempre habla de ella como 'mi prima la guapa'. *Risa* A lo mejor el resto de sus primas son horribles."
    mc "Elle parle toujours d'elle comme de « ma jolie cousine ». *Rires* Peut-être que ses autres cousins sont insupportables."

# game/scripts/c28/c28.rpy:2206
translate french c28s005_EriNor_4bafba38:

    # eri "Maldición, hasta yo la llamaría 'mi prima la guapa'. *Risa* Aunque [emm] se enfadaría si me oyera."
    eri "Mince, même moi je l'appellerais « ma jolie cousine ». *Rires* Mais [emm] se fâcherait si elle m'entendait."

# game/scripts/c28/c28.rpy:2207
translate french c28s005_EriNor_9a3980e1:

    # mc "*Risa* Puedo imaginarme a [emm] entrando en modo asesina psicópata si te oye decir algo como eso."
    mc "*Rires* J'imagine bien [emm] passer en mode psychopathe si elle t'entend dire un truc pareil."

# game/scripts/c28/c28.rpy:2209
translate french c28s005_EriNor_2654ef1a:

    # nor "Esta es... ¿cómo se llamaba esta, [eri]?"
    nor "C'est... comment ça s'appelait déjà, [eri] ?"

# game/scripts/c28/c28.rpy:2213
translate french c28s005_EriNor_19a37ef8:

    # eri "[nia] Serrat. Es de Nueva York."
    eri "[nia] Serrat. Il vient de New York."

# game/scripts/c28/c28.rpy:2214
translate french c28s005_EriNor_c84ce105:

    # mc "¿Otra deportista? ¿Viene becada?"
    mc "Une autre athlète ? Bénéficie-t-elle d'une bourse ?"

# game/scripts/c28/c28.rpy:2216
translate french c28s005_EriNor_a637e0e1:

    # nor "En su expediente no pone nada sobre deporte. Estudia Administración de Empresas. Supongo que tan solo estaba jugando un partido de voleibol cuando tocó hacer la foto."
    nor "Son dossier scolaire ne mentionne rien concernant le sport. Il étudie l'administration des affaires. J'imagine qu'il était en train de jouer au volley-ball au moment de la photo."

# game/scripts/c28/c28.rpy:2217
translate french c28s005_EriNor_a65d80f9:

    # mc "Pues al fotógrafo le ha quedado una foto fantástica. A ver la siguiente..."
    mc "Le photographe a pris une photo fantastique. Voyons voir la prochaine…"

# game/scripts/c28/c28.rpy:2219
translate french c28s005_EriNor_2322cfa9:

    # eri "Esta es... espera que mire el nombre..."
    eri "C'est... attendez, laissez-moi regarder le nom..."

# game/scripts/c28/c28.rpy:2223
translate french c28s005_EriNor_c03ad76d:

    # eri "[hai] Jenkinson. De Verbena, Alabama. Estudia trabajo social."
    eri "[hai] Jenkinson. Originaire de Verbena, Alabama. Étudie le travail social."

# game/scripts/c28/c28.rpy:2224
translate french c28s005_EriNor_9a565357:

    # mc "Me recuerda a alguien y no sé a quién."
    mc "Cela me rappelle quelqu'un, mais je ne sais pas qui."

# game/scripts/c28/c28.rpy:2226
translate french c28s005_EriNor_758320a1:

    # eri "A mí me ha pasado lo mismo."
    eri "La même chose m'est arrivée."

# game/scripts/c28/c28.rpy:2227
translate french c28s005_EriNor_c4f32212:

    # eri "Mi madre dice que se parece a una chica en una vieja peli, en que está montada en un caballo de esos para niños que les echas una moneda."
    eri "Ma mère dit qu'elle ressemble à une petite fille dans un vieux film, celle qui monte un de ces chevaux pour enfants où l'on jette une pièce."

# game/scripts/c28/c28.rpy:2228
translate french c28s005_EriNor_7dc96144:

    # mc "¡Maldición! Es verdad. Recuerdo esa peli."
    mc "Mince alors ! C'est vrai. Je me souviens de ce film."

# game/scripts/c28/c28.rpy:2230
translate french c28s005_EriNor_87c8e2b9:

    # nor "¡Hey! *Risa* ¡La peli no es tan vieja! Debía tener 12 o 14 años cuando la vi por primera vez."
    nor "Hé ! *Rires* Le film n'est pas si vieux ! Je devais avoir 12 ou 14 ans quand je l'ai vu pour la première fois."

# game/scripts/c28/c28.rpy:2231
translate french c28s005_EriNor_77b11ed9:

    # mc "*Levanta una ceja*"
    mc "*Lève un sourcil*"

# game/scripts/c28/c28.rpy:2232
translate french c28s005_EriNor_4a7c5060:

    # nor "*Risa* Vale, sí. Es una peli vieja. Veamos la siguiente foto antes de que tenga que ir a cambiarme los pañales de anciana."
    nor "*Rires* Bon, d'accord. C'est un vieux film. Regardons la scène suivante avant que je doive aller changer ma couche de vieille dame."

# game/scripts/c28/c28.rpy:2233
translate french c28s005_EriNor_d837cf5b:

    # mc "*Risa* La peli es vieja. Tú eres solo una veterana. Pero sí, siguiente foto."
    mc "*Rires* Le film est vieux. Toi, t'es juste un vétéran. Bon, passons au film suivant."

# game/scripts/c28/c28.rpy:2237
translate french c28s005_EriNor_0411c690:

    # eri "Esta es [pat], pero prefiere que la llamemos [pat.nick]. Es la más joven de todas."
    eri "Voici [pat], mais elle préfère qu'on l'appelle [pat.nick]. C'est la plus jeune de toutes."

# game/scripts/c28/c28.rpy:2239
translate french c28s005_EriNor_7a1b3546:

    # eri "Va a estudiar medicina, con lo que es probable que vaya a clases con [sca]."
    eri "Elle va étudier la médecine, il est donc probable qu'elle soit dans les mêmes cours que [sca]."

# game/scripts/c28/c28.rpy:2241
translate french c28s005_EriNor_e0065075:

    # eri "Pero eso ya lo sabes, miraste su expediente."
    eri "Mais vous le savez déjà, vous avez consulté son dossier."

# game/scripts/c28/c28.rpy:2242
translate french c28s005_EriNor_0caa3bad:

    # mc "No sé por qué, pero me suena de algo."
    mc "Je ne sais pas pourquoi, mais ça me semble familier."

# game/scripts/c28/c28.rpy:2244
translate french c28s005_EriNor_8c19f855:

    # eri "¿No la recuerdas?"
    eri "Tu ne te souviens pas d'elle ?"

# game/scripts/c28/c28.rpy:2245
translate french c28s005_EriNor_146caaa6:

    # mc "¿Debería?"
    mc "Devrait?"

# game/scripts/c28/c28.rpy:2247
translate french c28s005_EriNor_da86c9ea:

    # nor "¿Te acuerdas de cuando [dap] y [sca] no eran amigas aún porque se consideraban rivales por ser la que sacaba mejores notas?"
    nor "Te souviens-tu de l'époque où [dap] et [sca] n'étaient pas encore amis parce qu'ils se considéraient comme des rivaux pour obtenir de meilleures notes ?"

# game/scripts/c28/c28.rpy:2248
translate french c28s005_EriNor_84010e4e:

    # mc "Sí, pero de eso hace muchísimo. Son amigas desde... ¿que tenían diez u once?"
    mc "Oui, mais ça remonte à très longtemps. Ils sont amis depuis… l'âge de dix ou onze ans ?"

# game/scripts/c28/c28.rpy:2250
translate french c28s005_EriNor_8daf7f9d:

    # eri "Sí, desde que tuvieron que hacer un trabajo en parejas y se dieron cuenta de que podían ser aliadas. Yo lo hice con [emm]."
    eri "Oui, depuis qu'ils ont dû faire un projet de groupe et qu'ils ont réalisé qu'ils pouvaient être alliés. Je l'ai fait avec [emm]."

# game/scripts/c28/c28.rpy:2251
translate french c28s005_EriNor_2ff893af:

    # eri "[pat.nick] y Patricia eran las mejores amigas de [sca] por entonces. [pat.nick] vivía aquí, en Newport, hasta que sus padres se mudaron de vuelta a Charlotte."
    eri "[pat.nick] et Patricia étaient les meilleures amies de [sca] à l'époque. [pat.nick] a vécu ici à Newport jusqu'à ce que ses parents retournent à Charlotte."

# game/scripts/c28/c28.rpy:2252
translate french c28s005_EriNor_c52dae0b:

    # eri "Vino a casa un par de veces."
    eri "Il est venu chez moi à deux reprises."

# game/scripts/c28/c28.rpy:2253
translate french c28s005_EriNor_9cfd53b5:

    # mc "Debe ser de eso que me suena, pero no soy capaz de recordarla."
    mc "Ça doit être quelque chose qui me dit quelque chose, mais je n'arrive pas à me souvenir exactement."

# game/scripts/c28/c28.rpy:2255
translate french c28s005_EriNor_9bdc357f:

    # nor "Era una niña y ahora es una mujer. No me extraña que no seas capaz de reconocerla."
    nor "C'était une jeune fille, et maintenant c'est une femme. Il n'est pas étonnant que vous ne la reconnaissiez pas."

# game/scripts/c28/c28.rpy:2256
translate french c28s005_EriNor_50009e7f:

    # mc "Me parece que le pasaría lo mismo a cualquiera que me hubiera conocido hace diez años y viera una foto mía actual."
    mc "Je pense que la même chose arriverait à quiconque me connaissait il y a dix ans et verrait une photo actuelle de moi."

# game/scripts/c28/c28.rpy:2258
translate french c28s005_EriNor_0f282a8e:

    # nor "*Risa* Casi te pasó a ti cuando me viste al volver de la universidad, y yo no era una foto."
    nor "*Rires* Ça a failli t'arriver quand tu m'as vu revenir de l'université, et que je n'étais pas sur la photo."

# game/scripts/c28/c28.rpy:2259
translate french c28s005_EriNor_d8dc30a0:

    # mc "*Risa* Es que faltaba la mitad de mi Tía [nor] cuando volví."
    mc "*Rires* C'est juste que la moitié de ma tante [nor] avait disparu à mon retour."

# game/scripts/c28/c28.rpy:2260
translate french c28s005_EriNor_65ef0603:

    # mc "Pero sigamos con las fotos. Queda otra, ¿no?"
    mc "Mais revenons aux photos. Il y en a une autre, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:2262
translate french c28s005_EriNor_1c5cd3a1:

    # nor "Sí, también está en una playa o algo así."
    nor "Oui, c'est aussi sur une plage ou quelque chose comme ça."

# game/scripts/c28/c28.rpy:2264
translate french c28s005_EriNor_60a12c9c:

    # nor "Pero prefiere que la llamen por el diminutivo..."
    nor "Mais elle préfère qu'on l'appelle par son diminutif..."

# game/scripts/c28/c28.rpy:2269
translate french c28s005_EriNor_e447ca61:

    # mc "*Risa* Parece que esta no quería que le sacaran la foto."
