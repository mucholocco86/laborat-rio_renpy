translate french c28s002_Kat_4277a1dc:

    # mc "*Risa* O el día que una beluga te llame prima."
    mc "*Rires* Ou le jour où un béluga vous appelle cousin."

# game/scripts/c28/c28.rpy:3611
translate french c28s002_Kat_b637e84e:

    # kat "No, [mc], no has hecho nada malo, pero no estoy preparada para esto."
    kat "Non, [mc], tu n'as rien fait de mal, mais je ne suis pas prêt pour ça."

# game/scripts/c28/c28.rpy:3612
translate french c28s002_Kat_3438cd03:

    # mc "¿Qué es 'esto'? Si no me lo explicas, no podemos hablarlo. Y si no lo hablamos, no podemos arreglarlo."
    mc "Qu'est-ce que « ça » ? Si vous ne me l'expliquez pas, nous ne pouvons pas en parler. Et si nous n'en parlons pas, nous ne pouvons pas le réparer."

# game/scripts/c28/c28.rpy:3613
translate french c28s002_Kat_f7ae26ea:

    # mc "No quiero que estés evitándome hasta que me vaya a Aruba."
    mc "Je ne veux pas que tu m'évites jusqu'à ce que j'aille à Aruba."

# game/scripts/c28/c28.rpy:3614
translate french c28s002_Kat_fca9b049:

    # mc "Si lo quieres hacer, tendré que aceptarlo, pero preferiría que no lo hicieras."
    mc "Si vous voulez le faire, je devrai l'accepter, mais je préférerais que vous ne le fassiez pas."

# game/scripts/c28/c28.rpy:3616
translate french c28s002_Kat_d8d084f0:

    # kat "Es que yo tampoco quiero evitarte, pero no sé cómo enfrentar la situación. Esto es nuevo para mí."
    kat "Je ne veux pas t'éviter non plus, mais je ne sais pas comment gérer la situation. Tout cela est nouveau pour moi."

# game/scripts/c28/c28.rpy:3617
translate french c28s002_Kat_89fa7b32:

    # kat "O estaba tan enterrado que es como si lo fuera."
    kat "Ou alors, il était tellement enfoui qu'on a l'impression qu'il l'était."

# game/scripts/c28/c28.rpy:3618
translate french c28s002_Kat_d5d0f500:

    # mc "Sigues sin decirme que es 'esto'."
    mc "Vous ne m'avez toujours pas dit ce que « ceci » est."

# game/scripts/c28/c28.rpy:3620
translate french c28s002_Kat_142a7457:

    # kat "No se me da bien hablar de mis sentimientos..."
    kat "J'ai du mal à parler de mes sentiments..."

# game/scripts/c28/c28.rpy:3621
translate french c28s002_Kat_4bffae9c:

    # mc "A nadie se le da bien. Decimos un montón de tonterías y balbuceamos. Hablar de sentimientos es complicado."
    mc "Personne n'y arrive vraiment. On dit n'importe quoi et on divague. Parler de ses sentiments, c'est compliqué."

# game/scripts/c28/c28.rpy:3622
translate french c28s002_Kat_dce30889:

    # kat "Y más aún cuando temes hacer el ridículo."
    kat "Et encore plus lorsqu'on a peur de se ridiculiser."

# game/scripts/c28/c28.rpy:3623
translate french c28s002_Kat_9c9b78f3:

    # mc "No vas a hacer el ridículo digas lo que digas."
    mc "Tu ne vas pas te ridiculiser quoi que tu dises."

# game/scripts/c28/c28.rpy:3625
translate french c28s002_Kat_0f921d9a_1:

    # kat "Después de la no-cita... No entendía lo que sentía cuando estaba cerca de ti."
    kat "Après ce non-rendez-vous… je ne comprenais plus ce que je ressentais quand j’étais près de toi."

# game/scripts/c28/c28.rpy:3626
translate french c28s002_Kat_a2bd8322_1:

    # kat "Por un momento... Por tres o cuatro días, más bien... Incluso antes de la no-cita... He estado dudando de si me estabas empezando a gustar... a nivel romántico."
    kat "Pendant un instant… Pendant trois ou quatre jours, plutôt… Même avant ce qui n’était pas un rendez-vous… je me demandais si je commençais à t’apprécier… de façon romantique."

# game/scripts/c28/c28.rpy:3627
translate french c28s002_Kat_7071482f_1:

    # mc "Tal como lo dices, parece que has llegado a la conclusión de que no te gusto a ese nivel."
    mc "À vous entendre, il semble que vous en ayez conclu que vous ne m'appréciez pas à ce niveau-là."

# game/scripts/c28/c28.rpy:3629
translate french c28s002_Kat_25560176:

    # kat "He descubierto que lo que estaba sintiendo es que puedo confiar en ti y estar confortable a tu lado..."
    kat "J'ai découvert que ce que je ressentais, c'est que je peux te faire confiance et me sentir à l'aise à tes côtés..."

# game/scripts/c28/c28.rpy:3630
translate french c28s002_Kat_69752053:

    # kat "No estoy acostumbrada a sentirme así cerca de un tío, y... No sé... Creía que lo estaba confundiendo con otra cosa."
    kat "Je n'ai pas l'habitude de ressentir ça en présence d'un homme, et... je ne sais pas... je pensais le confondre avec autre chose."

# game/scripts/c28/c28.rpy:3631
translate french c28s002_Kat_5648fd32_1:

    # mc "Y por eso me estabas esquivando. Necesitabas aclarar tus ideas."
    mc "Et c'est pour ça que tu m'évitais. Tu avais besoin de te changer les idées."

# game/scripts/c28/c28.rpy:3632
translate french c28s002_Kat_3e2a17ba:

    # mc "Pero podíamos haberlo hablado..."
    mc "Mais nous aurions pu en parler..."

# game/scripts/c28/c28.rpy:3634
translate french c28s002_Kat_900b1acb_1:

    # kat "*Risa* Eres un jodido caballero de la brillante armadura siempre buscando damiselas que salvar."
    kat "*Rires* Tu es un vrai chevalier en armure étincelante, toujours à la recherche de demoiselles en détresse à sauver."

# game/scripts/c28/c28.rpy:3635
translate french c28s002_Kat_82e50f83:

    # mc "*Risa* Me lo han dicho alguna vez."
    mc "*Rires* On me l'a déjà dit."

# game/scripts/c28/c28.rpy:3637
translate french c28s002_Kat_d52a721e:

    # kat "No necesitaba que me salvaran. Necesitaba aclararme."
    kat "Je n'avais pas besoin d'être sauvé. J'avais besoin de me vider la tête."

# game/scripts/c28/c28.rpy:3638
translate french c28s002_Kat_a8b660ce_1:

    # kat "Si no te hubiera estado esquivando estos últimos dos días, seguro que hubieras venido en plan caballero salvador."
    kat "Si je ne t'avais pas évité ces deux derniers jours, je suis sûre que tu serais arrivé comme un chevalier en armure étincelante."

# game/scripts/c28/c28.rpy:3639
translate french c28s002_Kat_1c273892_1:

    # kat "Yo, estando confundida como estaba, seguramente hubiera caído en tus brazos sin remedio y..."
    kat "Dans mon état de confusion, je serais sans aucun doute tombée dans vos bras et..."

# game/scripts/c28/c28.rpy:3640
translate french c28s002_Kat_5b8669da:

    # mc "Y después te hubieras arrepentido..."
    mc "Et vous l'auriez regretté..."

# game/scripts/c28/c28.rpy:3642
translate french c28s002_Kat_2f796d27:

    # kat "¿Has oído hablar del multiverso y los universos paralelos?"
    kat "Avez-vous entendu parler du multivers et des univers parallèles ?"

# game/scripts/c28/c28.rpy:3643
translate french c28s002_Kat_652a0f09:

    # kat "¿Sabes que, si esa teoría es cierta, hay un universo en el que tenemos esta conversación, pero estamos en un árbol en vez de en una piscina?"
    kat "Saviez-vous que, si cette théorie est vraie, il existe un univers dans lequel nous avons cette conversation, mais que nous sommes dans un arbre au lieu d'être dans une piscine ?"

# game/scripts/c28/c28.rpy:3644
translate french c28s002_Kat_cd9c9111:

    # kat "En uno de esos universos, yo soy una ardilla y tú un loro."
    kat "Dans l'un de ces univers, je suis un écureuil et tu es un perroquet."

# game/scripts/c28/c28.rpy:3645
translate french c28s002_Kat_4e37e471:

    # "El cambio de tema te pilla un poco a traspiés. Sabes que a [kat] no le gusta hablar de sus sentimientos, pero..."
    "Ce changement de sujet vous prend un peu au dépourvu. Vous savez que [kat] n'aime pas parler de ses sentiments, mais…"

# game/scripts/c28/c28.rpy:3646
translate french c28s002_Kat_dfb67a9d:

    # mc "Sí, claro que he oído hablar de ello. He leído un montón de cómics sobre eso. Pero ¿a qué viene eso?"
    mc "Oui, bien sûr que j'en ai entendu parler. J'ai lu beaucoup de bandes dessinées à ce sujet. Mais quel est l'intérêt ?"

# game/scripts/c28/c28.rpy:3648
translate french c28s002_Kat_da923084:

    # kat "Pues que, en algunos de esos universos paralelos, no soy una ardilla, pero tampoco soy una lesbiana idiota que no sabe lo que quiere."
    kat "Bon, dans certains de ces univers parallèles, je ne suis pas un écureuil, mais je ne suis pas non plus une lesbienne idiote qui ne sait pas ce qu'elle veut."

# game/scripts/c28/c28.rpy:3649
translate french c28s002_Kat_bf5909b5:

    # kat "Y, en al menos uno de esos universos, tú me estas besando en este mismo momento."
    kat "Et, dans au moins un de ces univers, tu es en train de m'embrasser en ce moment même."

# game/scripts/c28/c28.rpy:3663
translate french c28s002_Kat_6ccbac6e_1:

    # "*Splash*"
    "*Éclabousser*"

# game/scripts/c28/c28.rpy:3666
translate french c28s002_Kat_0c1b889f_1:

    # kat "¿Qué haces? ¿Por qué te has metido en el agua ahora?"
    kat "Que fais-tu ? Pourquoi es-tu entré dans l'eau maintenant ?"

# game/scripts/c28/c28.rpy:3667
translate french c28s002_Kat_d53b75e3:

    # mc "Siento mucho que este no sea ese universo, [kat]."
    mc "Je suis vraiment désolé que ce ne soit pas cet univers, [kat]."

# game/scripts/c28/c28.rpy:3669
translate french c28s002_Kat_d36a0aee:

    # kat "¿Ves? No debería haber hablado de esto contigo. Ahora me siento idiota."
    kat "Tu vois ? Je n'aurais pas dû t'en parler. Maintenant, je me sens bête."

# game/scripts/c28/c28.rpy:3675
translate french c28s002_Kat_4138c944:

    # kat "*Risa* Capullo. Abrázame fuerte y calla."
    kat "*Rires* Espèce d'idiot. Serre-moi fort et tais-toi."

# game/scripts/c28/c28.rpy:3677
translate french c28s002_Kat_d8fd6742:

    # kat "Al menos hasta que te tengas que ir a cambiar para la cita con [lis]."
    kat "Du moins jusqu'à ce que tu doives aller te changer pour ton rendez-vous avec [lis]."

# game/scripts/c28/c28.rpy:3680
translate french c28s002_Kat_0da6717f:

    # "Alternáis besos y abrazos hasta que [sam], [nor], y [mar] hacen su aparición en la piscina."
    "Vous alternez baisers et câlins jusqu'à ce que [sam], [nor] et [mar] fassent leur apparition dans la piscine."

# game/scripts/c28/c28.rpy:3682
translate french c28s002_Kat_49b771b1:

    # "Continuáis con los abrazos hasta que [sam], [nor], y [mar] hacen su aparición en la piscina."
    "Vous continuez à vous serrer dans les bras jusqu'à ce que [sam], [nor] et [mar] fassent leur apparition dans la piscine."

# game/scripts/c28/c28.rpy:3683
translate french c28s002_Kat_5018881f:

    # "Os han dejado privacidad para arreglar las cosas, pero ellas también quieren su ración de sol y relax."
    "Ils vous ont laissé l'intimité nécessaire pour régler les choses, mais ils veulent aussi profiter du soleil et se détendre."

# game/scripts/c28/c28.rpy:3684
translate french c28s002_Kat_d7138312:

    # "Su llegada marca el momento de dejarlas solas para que [kat] les explique cómo ha ido." id c28s002_Kat_d7138312
    "Leur arrivée marque le moment de les laisser seuls afin que [kat] puisse expliquer comment cela s'est passé." id c28s002_Kat_d7138312

# game/scripts/c28/c28.rpy:3686
translate french c28s002_Kat_f325572f:

    # "Vuelves a tu habitación para ducharte y prepararte para ir a buscar a [lis]."
    "Vous retournez dans votre chambre pour prendre une douche et vous préparer à aller trouver [lis]."

# game/scripts/c28/c28.rpy:3688
translate french c28s002_Kat_9ae976fc:

    # "Vuelves a tu habitación y te das una ducha antes de la cena."
    "Vous retournez dans votre chambre et prenez une douche avant le dîner."

# game/scripts/c28/c28.rpy:3694
translate french c28s002_noKatRoute_f8eea7ed:

    # mc "No debes sentirte idiota. Creo que los dos hemos malinterpretado lo que está pasando."
    mc "Ne te sens pas bête. Je crois qu'on a tous les deux mal compris ce qui se passe."

# game/scripts/c28/c28.rpy:3696
translate french c28s002_noKatRoute_ecc5805c:

    # mc "Dices que crees que puedes confiar en mí y estar confortable a mi lado, y que no estás acostumbrada a eso con un tío."
    mc "Tu dis que tu penses pouvoir me faire confiance et te sentir à l'aise en ma présence, et que tu n'as pas l'habitude de ça avec un garçon."

# game/scripts/c28/c28.rpy:3698
translate french c28s002_noKatRoute_53a0381d:

    # kat "Es exactamente lo que he dicho..."
    kat "C'est exactement ce que j'ai dit..."

# game/scripts/c28/c28.rpy:3699
translate french c28s002_noKatRoute_493b7130:

    # mc "Pero fíjate que en ningún momento has hablado de que te sientas atraída por mí, o que sientas algo por mí aparte de sentirte a gusto a mi lado."
    mc "Mais remarquez qu'à aucun moment vous n'avez mentionné être attiré par moi, ni éprouver quoi que ce soit d'autre pour moi que le simple fait de vous sentir à l'aise en ma présence."

# game/scripts/c28/c28.rpy:3700
translate french c28s002_noKatRoute_ee1d92f6:

    # mc "Esa no es una base para empezar una relación, [kat]. Yo me siento a gusto al lado de Jamaal y confío en él, pero no empezaría una relación con él."
    mc "Ce n'est pas une base pour entamer une relation, [kat]. Je me sens à l'aise avec Jamaal et j'ai confiance en lui, mais je ne commencerais pas une relation avec lui."

# game/scripts/c28/c28.rpy:3702
translate french c28s002_noKatRoute_c9f88420:

    # kat "¿Quieres decir que estoy confundiendo descubrir que eres un buen tío con sentir algo por ti?"
    kat "Tu veux dire que je confonds le fait de découvrir que tu es quelqu'un de bien avec le fait d'avoir des sentiments pour toi ?"

# game/scripts/c28/c28.rpy:3703
translate french c28s002_noKatRoute_a6510c01:

    # mc "No soy yo quien tiene que ponerles nombre a tus sentimientos, [kat], pero sé que el tipo aquel en el instituto te hizo daño."
    mc "Ce n'est pas à moi de mettre des mots sur ce que tu ressens, [kat], mais je sais que ce type au lycée t'a fait du mal."

# game/scripts/c28/c28.rpy:3704
translate french c28s002_noKatRoute_2816b3d2:

    # mc "Y que has evitado a los tíos como a la peste desde entonces."
    mc "Et que depuis, tu évites les garçons comme la peste."

# game/scripts/c28/c28.rpy:3705
translate french c28s002_noKatRoute_42992cb5:

    # mc "Supongo que descubrir que hay un tío que no te va a hacer daño por nada del mundo puede ser confuso."
    mc "Je suppose que découvrir qu'il existe un homme qui ne vous ferait jamais de mal, pour rien au monde, peut être déroutant."

# game/scripts/c28/c28.rpy:3707
translate french c28s002_noKatRoute_d8ffb4b9:

    # kat "Es posible que tengas razón... Ahora que lo dices... nunca me he imaginado formando una familia contigo..."
    kat "Tu as peut-être raison… Maintenant que tu le dis… Je n’avais jamais imaginé fonder une famille avec toi…"

# game/scripts/c28/c28.rpy:3708
translate french c28s002_noKatRoute_19019062:

    # mc "Ya hemos formado una familia juntos, [kat]. No es una familia tradicional, pero es una familia."
    mc "Nous avons déjà formé une famille ensemble, [kat]. Ce n'est pas une famille traditionnelle, mais c'est une famille."

# game/scripts/c28/c28.rpy:3709
translate french c28s002_noKatRoute_126d27c6:

    # kat "Quizás necesito más tiempo para analizar lo que siento desde esa nueva perspectiva..."
    kat "J'ai peut-être besoin de plus de temps pour analyser ce que je ressens sous ce nouveau angle..."

# game/scripts/c28/c28.rpy:3710
translate french c28s002_noKatRoute_25b97585:

    # kat "¿Me puedes dar un abrazo?"
    kat "Peux-tu me faire un câlin ?"

# game/scripts/c28/c28.rpy:3712
translate french c28s002_noKatRoute_c8d48a77:

    # mc "¿Amigos? Tómate el tiempo que quieras, pero no sigas evitándome. Eso no es lo que hacen los amigos."
    mc "Des amis ? Prenez tout le temps qu'il vous faut, mais arrêtez de m'éviter. Ce n'est pas le comportement des amis."

# game/scripts/c28/c28.rpy:3713
translate french c28s002_noKatRoute_9da8bdff:

    # kat "Siempre va bien tener un amigo que abraza de puta madre."
    kat "C'est toujours agréable d'avoir un ami qui fait des câlins formidables."

# game/scripts/c28/c28.rpy:3714
translate french c28s002_noKatRoute_3a86be98:

    # kat "El día que una chica me deje, puedo venir a por un abrazo como este."
    kat "Le jour où une fille me larguera, je pourrai venir me faire câliner comme ça."

# game/scripts/c28/c28.rpy:3715
translate french c28s002_noKatRoute_4277a1dc:

    # mc "*Risa* O el día que una beluga te llame prima."
    mc "*Rires* Ou le jour où un béluga vous appelle cousin."

# game/scripts/c28/c28.rpy:3718
translate french c28s002_KatRoute_a25d7a48:

    # mc "No debes sentirte idiota. El que debe sentirse idiota es nuestro universo, porque va con retraso."
    mc "Tu ne devrais pas te sentir idiot. C'est notre univers qui devrait se sentir idiot, car il est en retard."

# game/scripts/c28/c28.rpy:3721
translate french c28s002_KatRoute_852b9800:

    # kat "¿Qué quieres decir?"
    kat "Que veux-tu dire?"

# game/scripts/c28/c28.rpy:3722
translate french c28s002_KatRoute_512f622f:

    # mc "Has dicho que en algún universo te estaba besando hace un minuto."
    mc "Tu as dit que dans un univers parallèle, je t'embrassais il y a une minute."

# game/scripts/c28/c28.rpy:3724
translate french c28s002_KatRoute_dafc7e8e:

    # "Sin dejarla responder, la coges entre tus brazos y le das un suave beso en los labios."
    "Sans lui laisser le temps de répondre, vous la prenez dans vos bras et lui donnez un doux baiser sur les lèvres."

# game/scripts/c28/c28.rpy:3725
translate french c28s002_KatRoute_28b23a47:

    # "La sorpresa se muestra en sus ojos. Tú no cierras los tuyos. No quieres perderte nada de vuestro primer beso."
    "La surprise se lit dans ses yeux. Vous ne fermez pas les vôtres. Vous ne voulez rien manquer de votre premier baiser."

# game/scripts/c28/c28.rpy:3726
translate french c28s002_KatRoute_a23e3bbd:

    # "Besarla es como besar a una estatua. Petrificada, sin mover un músculo. Por un momento piensas que incluso su corazón ha dejado de latir."
    "L'embrasser, c'est comme embrasser une statue. Pétrifiée, immobile. Un instant, on croit même que son cœur a cessé de battre."

# game/scripts/c28/c28.rpy:3728
translate french c28s002_KatRoute_8abebfe3:

    # "Pero [kat] no es una mujer que se deje sobrepasar por los acontecimientos y recupera el control de su cuerpo unos segundos después."
    "Mais [kat] n’est pas une femme qui se laisse submerger par les événements et reprend le contrôle de son corps quelques secondes plus tard."

# game/scripts/c28/c28.rpy:3729
translate french c28s002_KatRoute_a93a60a7:

    # "Cierra sus ojos y entreabre su boca, invitándote a entrar en ella por primera vez. No será la última."
    "Elle ferme les yeux et entrouvre la bouche, vous invitant à entrer en elle pour la première fois. Ce ne sera pas la dernière."

# game/scripts/c28/c28.rpy:3730
translate french c28s002_KatRoute_f25fd3ee:

    # "No te sorprende que sea una gran besadora. En un solo movimiento, mientras vuestras lenguas se entrelazan, hay tanta ternura como pasión y alivio."
    "Rien d'étonnant à ce qu'elle embrasse si bien. En un seul mouvement, lorsque vos langues s'entrelacent, on ressent autant de tendresse que de passion et de soulagement."

# game/scripts/c28/c28.rpy:3732
translate french c28s002_KatRoute_fa5d6964:

    # "Al cabo de un segundo o de una hora, vuestros labios se separan mientras vuestras miradas se unen."
    "Au bout d'une seconde ou d'une heure, vos lèvres s'entrouvrent lorsque vos regards se croisent."

# game/scripts/c28/c28.rpy:3733
translate french c28s002_KatRoute_a0f05d92:

    # kat "*Jadeo* ¿Qué ha sido eso, [mc]?"
    kat "*Halètement* Qu'est-ce que c'était, [mc] ?"

# game/scripts/c28/c28.rpy:3734
translate french c28s002_KatRoute_cf5a9bfc:

    # mc "La demostración de que nuestro universo no es idiota del todo y le gusta recuperar el tiempo perdido."
    mc "La preuve que notre univers n'est pas entièrement idiot et qu'il aime rattraper le temps perdu."

# game/scripts/c28/c28.rpy:3735
translate french c28s002_KatRoute_2dd904ed:

    # kat "*Jadeo* ¿Significa eso que tú y yo...?"
    kat "*Halètement* Est-ce que ça veut dire que toi et moi...?"

# game/scripts/c28/c28.rpy:3736
translate french c28s002_KatRoute_c1710d60:

    # mc "Significa que tú y yo nos hemos besado, sí."
    mc "Cela signifie que nous nous sommes embrassés, oui."

# game/scripts/c28/c28.rpy:3738
translate french c28s002_KatRoute_0f6d8571:

    # kat "*Jadeo* Pero... ¿significa que tú y yo somos algo?"
    kat "*Halètement* Mais... est-ce que ça veut dire que toi et moi, on est quelque chose ?"

# game/scripts/c28/c28.rpy:3739
translate french c28s002_KatRoute_562d7fd7:

    # mc "A mí me gusta pensar que soy algo. Una persona o algo así... Sobre ti... no estoy tan seguro. *Risa* Dudo entre persona y beluga."
    mc "J'aime à penser que je suis quelque chose. Une personne, peut-être… Quant à toi… je n'en suis pas si sûre. *Rires* J'hésite entre être une personne et un béluga."

# game/scripts/c28/c28.rpy:3741
translate french c28s002_KatRoute_5926bcb6:

    # kat "*Risa* Eres un capullo."
    kat "*Rires* Tu es un crétin."

# game/scripts/c28/c28.rpy:3742
translate french c28s002_KatRoute_4263b3ab:

    # mc "*Risa* ¿Ves? Eso también es ser algo."
    mc "*Rires* Tu vois ? C'est quelque chose aussi."

