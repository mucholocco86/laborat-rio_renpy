

# game/scripts/c28/c28.rpy:44
translate french c28s001_foursome_337cb758:

    # mc "No dudéis ni por un momento que esos regalos se vayan a quedar sin abrir."
    mc "N'en doutez pas un seul instant, ces cadeaux resteront intacts."

# game/scripts/c28/c28.rpy:46
translate french c28s001_foursome_33108e94:

    # "Te acercas a [sai] y la besas apasionadamente. Su cuerpo vibra bajo tus manos."
    "Vous vous approchez de [sai] et l'embrassez passionnément. Son corps tremble sous vos mains."

# game/scripts/c28/c28.rpy:47
translate french c28s001_foursome_4d2b9ef6:

    # "Sabes que está excitada por lo que está a punto de pasar. Hablasteis varias veces de hacer un trío mientras estabais en Portland."
    "Tu sais qu'elle est impatiente de ce qui va se passer. Vous avez parlé plusieurs fois d'un plan à trois pendant votre séjour à Portland."

# game/scripts/c28/c28.rpy:48
translate french c28s001_foursome_d1741da1:

    # "Nunca surgió la oportunidad o nunca encontrasteis a la chica adecuada. Nunca se planteó hacer un trío con un chico."
    "L'occasion ne s'est jamais présentée, ou tu n'as jamais trouvé la bonne fille. L'idée d'un plan à trois avec un mec n'a même jamais été envisagée."

# game/scripts/c28/c28.rpy:49
translate french c28s001_foursome_cf3c7d87:

    # "Ahora, su primera experiencia de sexo en grupo va a ser con dos mujeres a las que ha empezado a considerar más que amigas."
    "Sa première expérience de sexe à plusieurs va se dérouler avec deux femmes qu'il a commencé à considérer comme plus que des amies."

# game/scripts/c28/c28.rpy:51
translate french c28s001_foursome_12a1ca43:

    # sai "Creo que hay una perra pelirroja esperando su beso. *Risa*"
    sai "Je crois qu'une garce rousse attend son baiser. *Rires*"

# game/scripts/c28/c28.rpy:52
translate french c28s001_foursome_18cfed98:

    # sai "*Risa* Después de las bromas que hemos hecho sobre sacarle los ojos, no quiero que use mis ideas contra mí."
    sai "*Rires* Après toutes les blagues qu'on a faites sur le fait de lui crever les yeux, je ne veux pas qu'il utilise mes idées contre moi."

# game/scripts/c28/c28.rpy:53
translate french c28s001_foursome_0dede26d:

    # mc "No queremos que esos preciosos ojos oscuros acaben en un tarro, ¿no?"
    mc "Nous ne voulons pas que ces précieux yeux noirs finissent dans un bocal, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:55
translate french c28s001_foursome_036484d0:

    # eil "No se los sacaría a ella. *Risa* Recuerda que soy la Primera Concubina del harén."
    eil "Je ne les lui prendrais pas. *Rires* N'oubliez pas, je suis la première concubine du harem."

# game/scripts/c28/c28.rpy:56
translate french c28s001_foursome_f79a4b9d:

    # eil "*Risa* Si no soy importante para el sultán, quizás sean sus ojos los que acaben en un tarro."
    eil "*Rires* Si je ne suis pas important pour le sultan, peut-être que ce seront ses yeux qui finiront dans un bocal."

# game/scripts/c28/c28.rpy:57
translate french c28s001_foursome_5422e68e:

    # mc "¡Vamos, [eil]! Te juro que, en este momento, lo significas todo."
    mc "Allez, [eil] ! Je te jure, là, tout de suite, tu comptes énormément pour moi."

# game/scripts/c28/c28.rpy:58
translate french c28s001_foursome_93048d5f:

    # mc "Las tres lo significáis todo."
    mc "Vous trois, vous comptez énormément pour moi."

# game/scripts/c28/c28.rpy:60
translate french c28s001_foursome_0fef0510:

    # oma "*Risa* ¿Y tus pensamientos se vuelven impuros al verla vestida así?"
    oma "*Rires* Et vos pensées deviennent-elles impures quand vous la voyez habillée comme ça ?"

# game/scripts/c28/c28.rpy:61
translate french c28s001_foursome_433125eb:

    # mc "*Risa* Al veros a las tres. Pero dame un momento antes de que la Primera Concubina me saque los ojos."
    mc "*Rires* Quel plaisir de vous voir tous les trois ! Mais laissez-moi un instant avant que la Première Concubine ne me crève les yeux."

# game/scripts/c28/c28.rpy:63
translate french c28s001_foursome_35737497:

    # "Coges a la hermosa pelirroja entre tus brazos y tus labios encuentran los suyos, entreabiertos para recibir tu lengua."
    "Vous prenez la belle rousse dans vos bras et vos lèvres trouvent les siennes, légèrement entrouvertes pour recevoir votre langue."

# game/scripts/c28/c28.rpy:64
translate french c28s001_foursome_f82359bd:

    # "Su respiración transmite tanta excitación como los temblores de [sai]. No eres el único que está excitado por lo que va a pasar."
    "Sa respiration traduit autant d'excitation que les tremblements de [sai]. Vous n'êtes pas le seul à être impatient de voir ce qui va se passer."

# game/scripts/c28/c28.rpy:65
translate french c28s001_foursome_fec024e6:

    # "Va a ser su segundo sexo en grupo después de estar con [oma] en el bosque. Se pasó días hablando de aquel trío." id c28s001_foursome_fec024e6
    "Ce sera sa deuxième séance de sexe à trois après celle avec [oma] dans les bois. Elle a passé des jours à parler de ce plan à trois." id c28s001_foursome_fec024e6

# game/scripts/c28/c28.rpy:66
translate french c28s001_foursome_2899cfe0:

    # "Aquello lo propició ella, y esto parece que también. Adoras a [eil]."
    "C'est elle qui a provoqué ça, et il semblerait qu'elle ait fait ça aussi. Tu adores [eil]."

# game/scripts/c28/c28.rpy:68
translate french c28s001_foursome_b13c298f:

    # eil "Creo que es el momento de que beses a nuestra policía o es capaz de arrestarnos a todos."
    eil "Je crois qu'il est temps d'embrasser nos policiers, sinon ils sont capables de tous nous arrêter."

# game/scripts/c28/c28.rpy:69
translate french c28s001_foursome_cdc0b5f4:

    # mc "Yo no lo recomiendo. Las esposas son bastante incómodas."
    mc "Je ne le recommande pas. Les menottes sont assez inconfortables."

# game/scripts/c28/c28.rpy:71
translate french c28s001_foursome_7e9b4743:

    # oma "*Risa* Sabes que te las puedes quitar cuando quieras, ¿verdad?"
    oma "*Rires* Tu sais que tu peux les enlever quand tu veux, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:72
translate french c28s001_foursome_3054f9de:

    # mc "*Risa* Esperaba a que me dieras permiso para hacerlo. Decidimos probar y no es lo mío."
    mc "*Rires* J'attendais ta permission pour le faire. On a décidé d'essayer, et ce n'est pas mon truc."

# game/scripts/c28/c28.rpy:73
translate french c28s001_foursome_d8eac6ef:

    # oma "Tampoco lo mío. Prefiero sentir tus manos recorriendo mi piel."
    oma "Pas pour moi non plus. Je préfère sentir tes mains parcourir ma peau."

# game/scripts/c28/c28.rpy:75
translate french c28s001_foursome_2c5be866:

    # "Después de quitarte las esposas, abrazas fuertemente a [oma] mientras vuestros labios se unen otra vez."
    "Après avoir retiré vos menottes, vous serrez [oma] fort dans vos bras tandis que vos lèvres se rencontrent à nouveau."

# game/scripts/c28/c28.rpy:76
translate french c28s001_foursome_11c8dab9:

    # "Hace diez minutos que la tenías entre tus brazos y hace nueve que la echabas de menos."
    "Tu la tenais dans tes bras il y a dix minutes, et tu la regrettais déjà il y a neuf minutes."

# game/scripts/c28/c28.rpy:77
translate french c28s001_foursome_18befd20:

    # "Su cuerpo reacciona diferente a las otras dos mujeres, más tranquila después de haberte tenido para ella sola hace un rato."
    "Son corps réagit différemment aux deux autres femmes, plus calme après vous avoir eue pour elle seule il y a quelque temps."

# game/scripts/c28/c28.rpy:79
translate french c28s001_foursome_6958b37c:

    # sai "¿Vamos a caber todos en esa cama? Me parece un poco pequeña, ¿no?"
    sai "Est-ce qu'on tiendra tous dans ce lit ? Il a l'air un peu petit, non ?"

# game/scripts/c28/c28.rpy:80
translate french c28s001_foursome_c447616a:

    # mc "No te preocupes, encontraremos la forma de hacerlo."
    mc "Ne vous inquiétez pas, nous trouverons une solution."

# game/scripts/c28/c28.rpy:82
translate french c28s001_foursome_c4df37b5:

    # oma "Creo que [sai] tiene razón. Id ocupándoos de nuestro invitado mientras yo hago algo."
    oma "Je pense que [sai] a raison. Occupez-vous de notre invité pendant que je m'occupe de quelque chose."

# game/scripts/c28/c28.rpy:83
translate french c28s001_foursome_e13094b8:

    # mc "¿Qué vas a hacer?"
    mc "Qu'est-ce que tu vas faire?"

# game/scripts/c28/c28.rpy:84
translate french c28s001_foursome_3e896faf:

    # oma "Voy a probar algo. Intenta no correrte antes de que vuelva."
    oma "Je vais tenter quelque chose. Essayez de ne pas venir avant mon retour."

# game/scripts/c28/c28.rpy:85
translate french c28s001_foursome_22294bf2:

    # mc "Creo que va a ser complicado con las dos fierecillas."
    mc "Je pense que ça va être compliqué avec ces deux petits chenapans."

# game/scripts/c28/c28.rpy:87
translate french c28s001_foursome_14a0ac8a:

    # eil "No prometemos nada, pero, de momento, túmbate. Mjolnir ya está preparado para nosotras."
    eil "Nous ne promettons rien, mais pour l'instant, allongez-vous. Mjolnir nous attend."

# game/scripts/c28/c28.rpy:88
translate french c28s001_foursome_70b1251d:

    # mc "*Risa* ¿No puedo desenvolver mis regalos?"
    mc "*Rires* Je ne peux pas déballer mes cadeaux ?"

# game/scripts/c28/c28.rpy:90
translate french c28s001_foursome_44bec75e:

    # sai "Habrá tiempo para eso. Pero nuestro regalo ya está desenvuelto y no queremos desaprovecharlo."
    sai "Nous aurons le temps pour cela. Mais notre cadeau est déjà déballé, et nous ne voulons pas le gâcher."

# game/scripts/c28/c28.rpy:91
translate french c28s001_foursome_f8da55b5:

    # sai "Por una vez, te toca obedecer órdenes y estar calladito."
    sai "Pour une fois, c'est à ton tour d'obéir aux ordres et de te taire."

# game/scripts/c28/c28.rpy:92
translate french c28s001_foursome_84d5be27:

    # mc "Entonces me tendré que tumbar. ¿De verdad tengo que estar callado?"
    mc "Alors je vais devoir m'allonger. Dois-je vraiment rester silencieux ?"

# game/scripts/c28/c28.rpy:95
translate french c28s001_foursome_31502197:

    # sai "Y no empieces a discutir." (multiple=2)
    sai "Et ne commencez pas à vous disputer." (multiple=2)

# game/scripts/c28/c28.rpy:96
translate french c28s001_foursome_d7dcc00f:

    # eil "Puedes hablar, pero poco." (multiple=2)
    eil "Vous pouvez parler, mais pas beaucoup." (multiple=2)

# game/scripts/c28/c28.rpy:98
translate french c28s001_foursome_51368258:

    # mc "Vale. Hablar poco y no discutir. Creo que puedo hacerlo."
    mc "D'accord. Parlez peu et ne discutez pas. Je pense pouvoir faire ça."

# game/scripts/c28/c28.rpy:101
translate french c28s001_foursome_bb5392c0:

    # sai "¿Qué le hacemos?"
    sai "Que pouvons-nous y faire ?"

# game/scripts/c28/c28.rpy:102
translate french c28s001_foursome_4beb54ea:

    # eil "Creo que lo que hablamos anoche estaría bien para empezar. Aunque falte [oma.nick]..."
    eil "Je pense que ce dont nous avons parlé hier soir serait un bon point de départ. Même si [oma.nick] est porté disparu..."

# game/scripts/c28/c28.rpy:103
translate french c28s001_foursome_c46edd51:

    # mc "¿Habláis de lo que me vais a hacer cuando compartís habitación?"
    mc "Tu parles de ce que tu vas me faire quand vous partagerez une chambre ?"

# game/scripts/c28/c28.rpy:105
translate french c28s001_foursome_6f0a3e5c:

    # sai "¡Por supuesto! Entre otras muchas cosas." (multiple=2)
    sai "Bien sûr ! Entre autres choses." (multiple=2)

# game/scripts/c28/c28.rpy:106
translate french c28s001_foursome_0d0ccedb:

    # eil "¿Qué te hemos dicho de estar callado?" (multiple=2)
    eil "Que vous avons-nous dit à propos du silence ?" (multiple=2)

# game/scripts/c28/c28.rpy:107
translate french c28s001_foursome_e2011828:

    # mc "Pero me parece un tema muy interesante... Mis chicas hablando de mí..."
    mc "Mais je trouve le sujet très intéressant… Mes filles qui parlent de moi…"

# game/scripts/c28/c28.rpy:109
translate french c28s001_foursome_53460904:

    # sai "No hablamos sólo de ti, pero cuando [eil] propuso hacer esto, empezamos a fantasear..."
    sai "On ne parlait pas seulement de toi, mais quand [eil] a suggéré de faire ça, on a commencé à fantasmer..."

# game/scripts/c28/c28.rpy:110
translate french c28s001_foursome_724d119b:

    # eil "No esperábamos que la oportunidad llegara tan pronto, con lo que los planes son un poco... vagos."
    eil "Nous ne nous attendions pas à ce que l'occasion se présente si tôt, donc les plans sont un peu... vagues."

# game/scripts/c28/c28.rpy:111
translate french c28s001_foursome_ea009b6c:

    # mc "*Risa* Estoy seguro de que no me voy a quejar por ello."
    mc "*Rires* Je suis sûre que je ne m'en plaindrai pas."

# game/scripts/c28/c28.rpy:114
translate french c28s001_foursome_74467882:

    # eil "Eso espero. Esto siempre te encantó, pero me faltaban manos."
    eil "Je l'espère. Tu as toujours adoré ça, mais je n'avais pas assez de mains."

# game/scripts/c28/c28.rpy:115
translate french c28s001_foursome_02775026:

    # "Mientras [sai] te masturba y te acaricia los huevos, [eil] se dedica a acariciarte y a excitar tu glande con sus dedos."
    "Pendant que [sai] te masturbe et caresse tes testicules, [eil] est occupé à caresser et exciter ton gland avec ses doigts."

# game/scripts/c28/c28.rpy:116
translate french c28s001_foursome_493e96c9:

    # sai "A mí me pasaba lo mismo. Soy India, pero no soy Kali."
    sai "La même chose m'est arrivée. Je suis indienne, mais je ne suis pas Kali."

# game/scripts/c28/c28.rpy:117
translate french c28s001_foursome_19d1a60f:

    # "Notar las cuatro manos de las dos mujeres recorriendo tu cuerpo a la vez es una sensación increíble."
    "Sentir les quatre mains des deux femmes parcourir votre corps simultanément procure une sensation incroyable."

# game/scripts/c28/c28.rpy:118
translate french c28s001_foursome_db1dbd6d:

    # mc "¿Qué tiene que ver tu prima en esto?"
    mc "Quel rapport avec ton cousin ?"

# game/scripts/c28/c28.rpy:119
translate french c28s001_foursome_18c65b38:

    # sai "He dicho Kali, no [kal.nick]."
    sai "J'ai dit Kali, pas [kal.nick]."

# game/scripts/c28/c28.rpy:120
translate french c28s001_foursome_350ff9b9:

    # "No notas la diferencia en la pronunciación. Pero en ese momento te da lo mismo."
    "Vous ne remarquez pas la différence de prononciation. Mais à ce moment-là, cela n'a aucune importance."

# game/scripts/c28/c28.rpy:125
translate french c28s001_foursome_4229e796:

    # "En ese momento lo que echas de menos es un espejo en el techo y poder observar los cuerpos de las dos mujeres."
    "À ce moment précis, ce qui vous manque, c'est un miroir au plafond pour pouvoir observer les corps des deux femmes."

# game/scripts/c28/c28.rpy:126
translate french c28s001_foursome_91c5f63a:

    # "Cuerpos muy diferentes, pero los dos preciosos. Los conoces a la perfección, pero nunca te cansarás de ellos."
    "Des corps très différents, mais tous deux magnifiques. Vous les connaissez parfaitement, mais vous ne vous en lasserez jamais."

# game/scripts/c28/c28.rpy:127
translate french c28s001_foursome_053be75c:

    # eil "¿Qué tal? ¿Cómo te sientes manoseado por dos mujeres a la vez?"
    eil "Comment ça se passe ? Qu'est-ce que ça fait d'être tripoté par deux femmes en même temps ?"

# game/scripts/c28/c28.rpy:128
translate french c28s001_foursome_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c28/c28.rpy:129
translate french c28s001_foursome_cfaeb64e:

    # sai "*Risa* Le hemos dicho que esté callado y creo que nos va a hacer caso. Puedes contestar."
    sai "*Rires* On lui a dit de se taire et je crois qu'il va obéir. Tu peux répondre."

# game/scripts/c28/c28.rpy:130
translate french c28s001_foursome_7f5b67a9:

    # mc "¿Mi ex-novia del instituto y mi ex-no-novia de la universidad jugando con Mjolnir? Creo que hay pocas cosas mejores. Al menos hasta que se una [oma]."
    mc "Mon ex du lycée et mon ex-petite amie de la fac qui jouent avec Mjolnir ? Je crois qu’il y a peu de choses mieux. Du moins jusqu’à un [oma]."

# game/scripts/c28/c28.rpy:131
translate french c28s001_foursome_14362538:

    # sai "¡No me recuerdes lo tonta que fui! Y menos ahora que yo tengo el poder."
    sai "Ne me rappelez pas à quel point j'ai été stupide ! Surtout pas maintenant que j'ai le pouvoir."

# game/scripts/c28/c28.rpy:132
translate french c28s001_foursome_32a534d6:

    # "[sai] aprieta tus huevos entre sus dedos en un gesto juguetón. Lejos de ser doloroso, es sólo un pequeño aviso de que no te metas con ella."
    "Elle vous serre les testicules entre ses doigts, d'un air taquin. Loin d'être douloureux, c'est juste un avertissement amical : mieux vaut ne pas la provoquer."

# game/scripts/c28/c28.rpy:133
translate french c28s001_foursome_3b4e2eca:

    # "Siempre le ha gustado tener el poder. O al menos una ilusión de poder que nunca ha utilizado."
    "Il a toujours aimé avoir du pouvoir. Ou du moins une illusion de pouvoir qu'il n'a jamais utilisée."

# game/scripts/c28/c28.rpy:137
translate french c28s001_foursome_d9ae582f:

    # eil "Bueno, ahora las dos somos tus novias y no vamos a cometer los mismos errores que cometimos, ni siquiera cuando te marches."
    eil "Bon, maintenant nous sommes toutes les deux tes copines et nous n'allons pas refaire les mêmes erreurs, même quand tu seras parti."

# game/scripts/c28/c28.rpy:138
translate french c28s001_foursome_ffb2f160:

    # "Tienen más en común de lo que les hubiera gustado aceptar hace unas semanas. Tu relación a distancia con [eil] no funcionó."
    "Ils ont plus en commun qu'ils ne voulaient l'admettre il y a quelques semaines. Ta relation à distance avec [eil] n'a pas fonctionné."

# game/scripts/c28/c28.rpy:139
translate french c28s001_foursome_80c693c2:

    # "La de [sai] no llegó a existir por su miedo a una relación a distancia. Ahora pasaréis meses separados, pero esta vez no habrá rupturas."
    "Sa relation avec [sai] n'a jamais abouti à cause de sa peur d'une relation à distance. Vous allez maintenant passer des mois séparés, mais cette fois, il n'y aura pas de rupture."

# game/scripts/c28/c28.rpy:140
translate french c28s001_foursome_319131b9:

    # sai "¡Céntrate, [eil]! ¡No hables de cosas tristes! Y tú no contestes. Relájate y disfruta."
    sai "Concentre-toi, [eil] ! Ne parle pas de choses tristes ! Et ne réponds pas. Détends-toi et profite."

# game/scripts/c28/c28.rpy:141
translate french c28s001_foursome_7b55e9fd:

    # "No pensabas contestar. Tener a las dos mujeres produciendo sensaciones increíbles en tu polla no te deja mucho espacio para pensar en una respuesta ingeniosa."
    "Tu n'avais pas l'intention de répondre. Les sensations incroyables que te procuraient les deux femmes sur ton pénis ne te laissaient guère le temps de trouver une réplique spirituelle."

# game/scripts/c28/c28.rpy:142
translate french c28s001_foursome_dc34ba8e:

    # "Prefieres disfrutar de cada roce de sus dedos y mantenerte callado."
    "Vous préférez savourer chaque effleurement de ses doigts et rester silencieux."

# game/scripts/c28/c28.rpy:145
translate french c28s001_foursome_06a8f39d:

    # oma "Ya está. Ya podéis venir."
    oma "Voilà. Vous pouvez venir maintenant."

# game/scripts/c28/c28.rpy:146
translate french c28s001_foursome_8a7b9a6f:

    # mc "¿A dónde? ¿Qué has hecho?"
    mc "Où êtes-vous allé ? Qu'avez-vous fait ?"

# game/scripts/c28/c28.rpy:147
translate french c28s001_foursome_4922e44b:

    # oma "Ya lo verás. Chicas, dejad a Mjolnir un rato."
    oma "Vous verrez. Mesdames, laissez Mjolnir tranquille un moment."

# game/scripts/c28/c28.rpy:149
translate french c28s001_foursome_468046f0:

    # eil "Has aguantado como un campeón sin correrte."
    eil "Tu as tenu bon comme un champion sans venir."

# game/scripts/c28/c28.rpy:150
translate french c28s001_foursome_7043cf46:

    # sai "*Risita* Me ha costado mantener el ritmo lento. Hubiera sido egoísta por nuestra parte hacer que te corrieras antes de que volviera [oma]."
    sai "*Rires* C'était difficile de maintenir ce rythme lent. Ça aurait été égoïste de notre part de te faire jouir avant mon retour [oma]."

# game/scripts/c28/c28.rpy:151
translate french c28s001_foursome_9b2a6dbd:

    # mc "*Risa* Sabéis que sois unas perras malas, ¿verdad?"
    mc "*Rires* Vous savez que vous êtes des bombes, hein ?"

# game/scripts/c28/c28.rpy:153
translate french c28s001_foursome_a1dfcffe:

    # eil "*Risa* Yo sí. [sai] me lo recuerda cada día."
    eil "*Rires* Moi aussi. [sai] Il me le rappelle tous les jours."

# game/scripts/c28/c28.rpy:154
translate french c28s001_foursome_37739c7f:

    # sai "*Risa* Pero pese a todo la quiero."
    sai "*Rires* Mais malgré tout, je l'aime."

