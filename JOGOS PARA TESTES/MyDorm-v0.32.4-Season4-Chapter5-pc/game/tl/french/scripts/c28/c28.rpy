# game/scripts/c28/c28.rpy:2808
translate french c28s005_AmaMad_ed053baf:

    # mad "Ya has oído lo que dicen las chicas. Es súper tierno, especialmente en las primeras veces."
    mad "Vous avez entendu ce que disent les filles. C'est vraiment adorable, surtout les premières fois."

# game/scripts/c28/c28.rpy:2810
translate french c28s005_AmaMad_cc96dfe3:

    # mad "Oyéndolas hablar, me hubiera gustado perder la virginidad con él."
    mad "En les écoutant parler, j'aurais bien aimé perdre ma virginité avec lui."

# game/scripts/c28/c28.rpy:2811
translate french c28s005_AmaMad_0ea61e2d:

    # mad "Creo que no debes preocuparte por nada."
    mad "Je pense que tu ne devrais t'inquiéter de rien."

# game/scripts/c28/c28.rpy:2813
translate french c28s005_AmaMad_509fadd8:

    # ama "No me da miedo por él, sino por mí. No sé cómo me voy a sentir... durante o después."
    ama "Je n'ai pas peur pour lui, mais pour moi. Je ne sais pas comment je vais me sentir… pendant ou après."

# game/scripts/c28/c28.rpy:2815
translate french c28s005_AmaMad_c5dd16f3:

    # mad "Mira, [ama]. Mi experiencia dice que la primera vez es una mierda. No sabes qué hacer ni cómo ponerte para estar cómoda."
    mad "Écoute, [ama]. D'après mon expérience, la première fois est horrible. On ne sait pas quoi faire ni comment se positionner pour être à l'aise."

# game/scripts/c28/c28.rpy:2816
translate french c28s005_AmaMad_426d7499:

    # mad "Además, estás super nerviosa y da lo mismo que sepas que te tienes que relajar. No puedes hacerlo. Las expectativas son altísimas."
    mad "En plus, tu es terriblement nerveux, et même si tu sais que tu dois te détendre, ça n'y change rien. Tu n'y arrives pas. La pression est énorme."

# game/scripts/c28/c28.rpy:2817
translate french c28s005_AmaMad_662a8cc3:

    # mad "Y sobre cómo te vas a sentir después, es fácil. Dolorida."
    mad "Quant à ce que vous ressentirez après, c'est simple : des courbatures."

# game/scripts/c28/c28.rpy:2819
translate french c28s005_AmaMad_9ecdf0dc:

    # mad "Pero oyes lo que cuentan las chicas y parece que [mc] tenga una polla mágica que no hace daño."
    mad "Mais à en croire les filles, il semblerait que [mc] ait une bite magique qui ne fait pas mal."

# game/scripts/c28/c28.rpy:2821
translate french c28s005_AmaMad_e17b32dd:

    # mad "Que sí, que estoy de acuerdo en que Mjolnir es mágico, pero..."
    mad "Oui, je suis d'accord, Mjolnir est magique, mais..."

# game/scripts/c28/c28.rpy:2822
translate french c28s005_AmaMad_499eca96:

    # mad "Lo mejor que puedes hacer es no crearte expectativas. Vas a estar un mes allí con él."
    mad "Le mieux à faire, c'est de ne pas vous faire de faux espoirs. Vous allez passer un mois avec lui."

# game/scripts/c28/c28.rpy:2823
translate french c28s005_AmaMad_e78f64bf:

    # mad "Si la primera vez no es tan buena como esperabas, seguro que alguna de las otras 29 lo serán. Posiblemente la segunda o la tercera."
    mad "Si la première fois n'est pas à la hauteur de vos espérances, l'une des 29 autres le sera sûrement. Peut-être même la deuxième ou la troisième."

# game/scripts/c28/c28.rpy:2825
translate french c28s005_AmaMad_41d3b27a:

    # ama "*Risa* Lo dices como si fuéramos a hacerlo todos los días..."
    ama "*Rires* Tu dis ça comme si on allait faire ça tous les jours..."

# game/scripts/c28/c28.rpy:2826
translate french c28s005_AmaMad_2970494f:

    # ama "Eso sería casi como si fuera adicta al sexo, ¿no?"
    ama "Ce serait presque comme être accro au sexe, non ?"

# game/scripts/c28/c28.rpy:2828
translate french c28s005_AmaMad_4ef7b1fe:

    # mad "*Risa* ¿Eso es lo que te preocupa? No, mi niña. Eso sería lo más normal."
    mad "*Rires* C'est ça qui vous inquiète ? Non, ma chère. Ce serait même tout à fait normal."

# game/scripts/c28/c28.rpy:2830
translate french c28s005_AmaMad_672b91c3:

    # mad "¿Un mes a solas con nuestro novio sin tener que compartirlo con nadie? ¿Dónde tengo que firmar?"
    mad "Un mois rien qu'avec notre copain, sans avoir à le partager avec personne ? Où est-ce que je signe ?"

# game/scripts/c28/c28.rpy:2832
translate french c28s005_AmaMad_b27eb2fa:

    # mad "¿Un mes a solas con tu novio sin tener que compartirlo con el resto del harén? Si yo fuera tú, firmaría ahora mismo."
    mad "Un mois rien qu'avec ton copain, sans avoir à le partager avec le reste du harem ? À ta place, je m'inscrirais direct."

# game/scripts/c28/c28.rpy:2834
translate french c28s005_AmaMad_232e4a4d:

    # mad "¿Un mes a solas con tu novio con el que estás empezando? Si yo fuera tú, firmaría ahora mismo."
    mad "Un mois en tête-à-tête avec ton copain, avec qui tu viens de commencer ta relation ? À ta place, je m’inscrirais tout de suite."

# game/scripts/c28/c28.rpy:2835
translate french c28s005_AmaMad_4321983d:

    # mad "Quizás no todos los días, porque tendrás que descansar uno o dos días después de la primera vez, pero después..."
    mad "Peut-être pas tous les jours, car il vous faudra un jour ou deux de repos après la première fois, mais après cela…"

# game/scripts/c28/c28.rpy:2837
translate french c28s005_AmaMad_299e700d:

    # ama "Me quitas un peso de encima... creía que... no sé... tengo tantas cosas que aprender..."
    ama "Tu m'as soulagé d'un poids... Je pensais que... Je ne sais pas... J'ai encore tellement de choses à apprendre..."

# game/scripts/c28/c28.rpy:2839
translate french c28s005_AmaMad_ea998e09:

    # mad "Tendrás tiempo para aprender lo que necesites. Y ya conoces a [mc]. Tiene mucha paciencia con todo."
    mad "Tu auras le temps d'apprendre ce dont tu as besoin. Et tu sais déjà [mc]. Il est très patient avec tout."

# game/scripts/c28/c28.rpy:2840
translate french c28s005_AmaMad_99ffd67b:

    # mad "Yo no tengo tanta paciencia, con lo que lo primero que vas a aprender es qué vestidos te gustan."
    mad "Je n'ai pas beaucoup de patience, donc la première chose que tu vas apprendre, c'est quelles robes tu aimes."

# game/scripts/c28/c28.rpy:2842
translate french c28s005_AmaMad_34fabdeb:

    # mad "Voy a coger algunos trajes para que te los pruebes mientras busco vestidos que puedan ir con tu estilo." id c28s005_AmaMad_34fabdeb
    mad "Je vais t'acheter quelques tailleurs à essayer pendant que je cherche des robes qui pourraient correspondre à ton style." id c28s005_AmaMad_34fabdeb

# game/scripts/c28/c28.rpy:2844
translate french c28s005_AmaMad_c82394af:

    # ama "*Risita* Y no te olvides de la lencería..."
    ama "*Rires* Et n'oubliez pas la lingerie..."

# game/scripts/c28/c28.rpy:2846
translate french c28s005_AmaMad_e9c8979d:

    # ama "Y, cuando acabemos, me gustaría hablar de tu idea sobre los anillos..."
    ama "Et, lorsque nous aurons terminé, j'aimerais parler de votre idée concernant les anneaux..."

# game/scripts/c28/c28.rpy:2848
translate french c28s005_AmaMad_83533506:

    # "[ama] acabó comprando mucho más de lo que esperaba. También pasa mucho más tiempo en la tienda de [mad.nick] del que tenía pensado."
    "[ama] a finalement acheté bien plus que prévu. Elle passe aussi beaucoup plus de temps dans la boutique de [mad.nick] qu'elle ne l'avait imaginé."

# game/scripts/c28/c28.rpy:2849
translate french c28s005_AmaMad_b77b9251:

    # "Los trajes para la oficina van a ser una sorpresa para quién ha visto a [ama] sólo con ropa militar."
    "Les tailleurs de bureau surprendront tous ceux qui n'ont jamais vu [ama] qu'en tenue militaire."

# game/scripts/c28/c28.rpy:2852
translate french c28s005_AmaMad_da03fdda:

    # "Los vestidos y la lencería van a ser una bonita sorpresa para alguien durante el primer mes en Aruba."
    "Des robes et de la lingerie seront une belle surprise pour une personne lors de son premier mois à Aruba."

# game/scripts/c28/c28.rpy:2859
translate french c28s006_Kim_db4fa19c:

    # "Después de la llamada a traición con Aaron, sigues leyendo los nuevos documentos que te ha enviado al acabar la reunión."
    "Après cet appel perfide avec Aaron, vous continuez à lire les nouveaux documents qu'il vous a envoyés après la fin de la réunion."

# game/scripts/c28/c28.rpy:2861
translate french c28s006_Kim_125dad34:

    # "Hace calor y te quitas la camiseta mientras lees. No quieres poner el aire acondicionado para el poco rato que vas a estar leyendo."
    "Il fait chaud, alors vous enlevez votre chemise pour lire. Vous n'avez pas envie d'allumer la climatisation pendant le court laps de temps que vous allez passer à lire."

# game/scripts/c28/c28.rpy:2862
translate french c28s006_Kim_54811ec2:

    # "¿Te está empezando a influenciar [lis] con su concepto del ahorro energético?"
    "Commencez-vous à être influencé par le concept d'économie d'énergie de [lis] ?"

# game/scripts/c28/c28.rpy:2864
translate french c28s006_Kim_67ea73ab:

    # "Cuando acabas de leer el último informe del día..."
    "Lorsque vous venez de terminer la lecture du dernier rapport du jour..."

# game/scripts/c28/c28.rpy:2866
translate french c28s006_Kim_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c28/c28.rpy:2867
translate french c28s006_Kim_2a71ad67:

    # kim "*A través de la puerta* Soy yo, ¿puedo pasar?"
    kim "*À travers la porte* C'est moi, puis-je entrer ?"

# game/scripts/c28/c28.rpy:2868
translate french c28s006_Kim_a688a39f:

    # mc "Sí, pasa, [kim]."
    mc "Oui, ça arrive, [kim]."

# game/scripts/c28/c28.rpy:2870
translate french c28s006_Kim_6842348b:

    # mc "Hola, [kim], ¿te puedo ayudar en algo?"
    mc "Salut [kim], puis-je t'aider ?"

# game/scripts/c28/c28.rpy:2879
translate french c28s006_KimOnKate_746b167a:

    # kim "Ayer me preguntaste si a [kat] le pasa algo desde vuestra no-cita."
    kim "Hier, tu m'as demandé si quelque chose n'allait pas avec [kat] puisque tu n'as pas eu de rendez-vous."

# game/scripts/c28/c28.rpy:2880
translate french c28s006_KimOnKate_6c348a1c:

    # kim "¿Aún lo quieres saber?"
    kim "Voulez-vous toujours savoir ?"

# game/scripts/c28/c28.rpy:2882
translate french c28s006_KimOnKate_d0dac0dd:

    # mc "Por supuesto. Ayer [sai] dijo algo que me sorprendió y he estado atando algunos cabos, pero necesito confirmación antes decidir que paso dar."
    mc "Bien sûr. Hier, [sai] a dit quelque chose qui m'a surpris et j'ai commencé à rassembler les pièces du puzzle, mais j'ai besoin d'une confirmation avant de décider de la suite."

# game/scripts/c28/c28.rpy:2884
translate french c28s006_KimOnKate_4b31ad11:

    # mc "Por supuesto. Últimamente he estado atando algunos cabos, pero necesito confirmación antes decidir que paso dar."
    mc "Bien sûr. J'ai commencé à rassembler quelques éléments ces derniers temps, mais j'ai besoin d'une confirmation avant de décider de la marche à suivre."

# game/scripts/c28/c28.rpy:2889
translate french c28s006_KimOnKate_061dcc4a:

    # kim "*Risa* Es una posición muy cómoda para ti. No te arriesgas..."
    kim "*Rires* C'est une position très confortable pour vous. Vous ne prenez aucun risque..."

# game/scripts/c28/c28.rpy:2890
translate french c28s006_KimOnKate_77f0858e:

    # mc "[kat] es una chica compleja y lo que menos querría es que nuestra amistad sufriera porque yo he malinterpretado las señales."
    mc "[kat] est une fille complexe et la dernière chose que je voudrais, c'est que notre amitié en souffre parce que j'aurais mal interprété les signaux."

# game/scripts/c28/c28.rpy:2891
translate french c28s006_KimOnKate_05c5df0a:

    # mc "Y sabiendo su relación pasada con algunos tipos, lo que menos querría sería hacerle daño de alguna manera por estar equivocado."
    mc "Et connaissant ses relations passées avec certains garçons, la dernière chose que je voudrais, c'est la blesser en ayant tort."

# game/scripts/c28/c28.rpy:2896
translate french c28s006_KimOnKate_039dee72:

    # kim "A veces olvido lo considerado que eres."
    kim "Parfois, j'oublie à quel point tu es attentionné."

# game/scripts/c28/c28.rpy:2897
translate french c28s006_KimOnKate_7649a9aa:

    # kim "La mayoría de los hombres que conozco intentarían follarse a una mujer tan guapa como [kat] sin pensar en sus sentimientos."
    kim "La plupart des hommes que je connais tenteraient d'avoir des relations sexuelles avec une femme aussi belle que [kat] sans penser à ses sentiments."

# game/scripts/c28/c28.rpy:2898
translate french c28s006_KimOnKate_972349e3:

    # kim "Tú intentas saber cuáles son esos sentimientos antes de hacer nada. Muy encomiable por tu parte."
    kim "Vous essayez de comprendre ces sentiments avant d'agir. C'est très admirable de votre part."

# game/scripts/c28/c28.rpy:2899
translate french c28s006_KimOnKate_7bfebbd8:

    # mc "Hacer daño a alguien gratuitamente es una de las cosas que más odio."
    mc "Faire du mal à quelqu'un sans raison est une des choses que je déteste le plus."

# game/scripts/c28/c28.rpy:2904
translate french c28s006_KimOnKate_0b07b60c:

    # kim "Lo entiendo."
    kim "Je comprends."

# game/scripts/c28/c28.rpy:2905
translate french c28s006_KimOnKate_d3a6c09e:

    # kim "[kat] está en una encrucijada emocional ahora mismo. Se ha pasado años construyendo un castillo anti-hombres alrededor de sus sentimientos."
    kim "[kat] se trouve actuellement à un tournant émotionnel. Elle a passé des années à se construire une carapace anti-hommes autour de ses sentiments."

# game/scripts/c28/c28.rpy:2906
translate french c28s006_KimOnKate_be3da2dc:

    # kim "Y has llegado tú y has abierto una brecha en las murallas con gestos amables y tratándola como si fuera una chica normal."
    kim "Et puis tu es arrivé et tu as fait tomber les barrières par tes gestes bienveillants et en la traitant comme une fille normale."

# game/scripts/c28/c28.rpy:2907
translate french c28s006_KimOnKate_3fee3191:

    # mc "Es una chica normal..."
    mc "C'est une fille normale..."

# game/scripts/c28/c28.rpy:2912
translate french c28s006_KimOnKate_305867b0:

    # kim "Ella no es normal; es especial. Detrás de ese sentido del humor caustico hay una chica muy sensible."
    kim "Elle n'est pas comme les autres ; elle est spéciale. Derrière cet humour caustique se cache une fille très sensible."

# game/scripts/c28/c28.rpy:2913
translate french c28s006_KimOnKate_4d45cd2b:

    # kim "Ha usado ese sentido del humor para protegerse. Forma parte de su castillo."
    kim "Il utilise son humour pour se protéger. Cela fait partie de ses mécanismes de défense."

# game/scripts/c28/c28.rpy:2914
translate french c28s006_KimOnKate_15092a66:

    # kim "Y llegas tú como un ariete y derrumbas esas fortificaciones. Un ariete mucho más sutil que los que usa [emm], pero no por ello menos efectivo."
    kim "Et puis vous arrivez comme un bélier et vous détruisez ces fortifications. Un bélier bien plus subtil que ceux utilisés par [emm], mais non moins efficace pour autant."

# game/scripts/c28/c28.rpy:2915
translate french c28s006_KimOnKate_3721bc5c:

    # mc "Pero yo no tenía intención de..."
    mc "Mais je n'avais aucune intention de..."

# game/scripts/c28/c28.rpy:2920
translate french c28s006_KimOnKate_40a1866e:

    # kim "Da lo mismo cuáles fueran tus intenciones, [mc]. Le has demostrado a [kat] que no todos los hombres son unos capullos."
    kim "Peu importe quelles étaient vos intentions, [mc]. Vous avez montré [kat] que tous les hommes ne sont pas des crétins."

# game/scripts/c28/c28.rpy:2921
translate french c28s006_KimOnKate_c50b03dc:

    # kim "Le has enseñado que hay hombres sensibles que tienen en consideración los sentimientos de los demás. Y esta conversación es un ejemplo de ello."
    kim "Vous lui avez montré qu'il existe des hommes sensibles qui prennent en compte les sentiments des autres. Et cette conversation en est un exemple."

# game/scripts/c28/c28.rpy:2922
translate french c28s006_KimOnKate_8f7ed704:

    # mc "¿Qué crees que debería hacer?"
    mc "Que pensez-vous que je devrais faire ?"

# game/scripts/c28/c28.rpy:2927
translate french c28s006_KimOnKate_6ecf48ee:

    # kim "*Risa* Lo que más te gusta hacer."
    kim "*Rires* Qu'est-ce que tu préfères faire ?"

# game/scripts/c28/c28.rpy:2929
translate french c28s006_KimOnKate_424615c9:

    # kim "*Risa* Y no me refiero a lo que acabamos de hacer nosotros. Habla con ella."
    kim "*Rires* Et je ne parle pas de ce qu'on vient de faire. Parle-lui."

# game/scripts/c28/c28.rpy:2931
translate french c28s006_KimOnKate_02d5d123:

    # kim "Habla con ella."
    kim "Parlez-lui."

# game/scripts/c28/c28.rpy:2936
translate french c28s006_KimOnKate_8066a96d:

    # kim "No importa si quieres tener algo romántico con ella o no. Pero tienes que hablar con ella."
    kim "Peu importe que vous souhaitiez ou non une relation amoureuse avec elle. L'important, c'est que vous lui parliez."

# game/scripts/c28/c28.rpy:2937
translate french c28s006_KimOnKate_5498f0d6:

    # kim "Ella lleva todo el día cabizbaja y pensativa. Creo que la ventana de oportunidad se está cerrando para que lo arregléis."
    kim "Elle est abattue et pensive depuis ce matin. Je pense que vous n'avez plus beaucoup de temps pour arranger les choses."

# game/scripts/c28/c28.rpy:2939
translate french c28s006_KimOnKate_54b17fb0:

    # mc "Hablaré con ella mañana, cuando vuelva de la fiesta de [lis]."
    mc "Je lui parlerai demain, quand je rentrerai de la fête de [lis]."

# game/scripts/c28/c28.rpy:2941
translate french c28s006_KimOnKate_6c63c676:

    # mc "Hablaré con ella mañana cuando tenga la oportunidad."
    mc "Je lui parlerai demain dès que j'en aurai l'occasion."

# game/scripts/c28/c28.rpy:2946
translate french c28s006_KimOnKate_0a074928:

    # kim "¿Qué parte de que la ventana de oportunidad se está cerrando no has entendido?"
    kim "Quelle partie de « la fenêtre d'opportunité se referme » ne comprenez-vous pas ?"

# game/scripts/c28/c28.rpy:2947
translate french c28s006_KimOnKate_95235473:

    # kim "Mañana a lo mejor es tarde, si le dejas reconstruir sus muros."
    kim "Demain, il sera peut-être trop tard si vous le laissez reconstruire ses murs."

# game/scripts/c28/c28.rpy:2948
translate french c28s006_KimOnKate_e49dd5eb:

    # kim "Cuando he venido aquí, ella bajaba a la piscina y no había ninguna otra chica allí. Deberías ir a hablar con ella. Ahora mejor que mañana."
    kim "Quand je suis arrivé, elle descendait à la piscine et il n'y avait aucune autre fille. Tu devrais aller lui parler. Mieux vaut maintenant que demain."

# game/scripts/c28/c28.rpy:2950
translate french c28s006_KimOnKate_9dc3cff8:

    # mc "Me parece una buena idea. Voy a ir a hablar con ella. Gracias, [kim]."
    mc "Ça me paraît une bonne idée. Je vais lui parler. Merci, [kim]."

# game/scripts/c28/c28.rpy:2953
translate french c28s006_KimOnKate_d2842e7e:

    # mc "¿No te importa?"
    mc "Ça ne vous dérange pas ?"

# game/scripts/c28/c28.rpy:2955
translate french c28s006_KimOnKate_68c9c3f2:

    # kim "Al contrario. Estoy deseando que se resuelva esta situación."
    kim "Au contraire. J'ai hâte que cette situation se résolve."

# game/scripts/c28/c28.rpy:2956
translate french c28s006_KimOnKate_43416bed:

    # kim "[kat] no es la misma desde vuestra no-cita y quiero que vuelva a ser la que era antes. Deberías ir cuanto antes."
    kim "[kat] Elle n'est plus la même depuis votre rendez-vous manqué, et je veux qu'elle redevienne comme avant. Tu devrais y aller au plus vite."

# game/scripts/c28/c28.rpy:2959
translate french c28s006_KimOnKate_dff6da1c:

    # kim "Además..."
    kim "En plus..."

# game/scripts/c28/c28.rpy:2960
translate french c28s006_KimOnKate_da8be3fb:

    # mc "¿En qué estás pensando?"
    mc "À quoi penses-tu ?"

# game/scripts/c28/c28.rpy:2961
translate french c28s006_KimOnKate_b178e545:

    # kim "Sé que suena un poco raro decirte esto después de acostarnos juntos por primera vez..."
    kim "Je sais que ça peut paraître un peu étrange de te dire ça après avoir couché ensemble pour la première fois..."

# game/scripts/c28/c28.rpy:2962
translate french c28s006_KimOnKate_d11e6c36:

    # mc "No lo sé. Aún no me has dicho nada."
    mc "Je ne sais pas. Tu ne m'as encore rien dit."

# game/scripts/c28/c28.rpy:2964
translate french c28s006_KimOnKate_0786f280:

    # kim "Si decidieras que [kat] entrara en el harén y ella quisiera... me gustaría que... pero sólo si los dos queréis..."
    kim "Si vous décidiez que [kat] devait entrer dans le harem et qu'elle le souhaitait... j'en serais ravi... mais seulement si vous le souhaitez tous les deux..."

# game/scripts/c28/c28.rpy:2965
translate french c28s006_KimOnKate_6ec8f3aa:

    # mc "[kim], suéltalo ya, estás balbuceando."
    mc "[kim], crache le morceau, tu divagues."

# game/scripts/c28/c28.rpy:2967
translate french c28s006_KimOnKate_66553a69:

    # kim "Si los dos quisierais, me gustaría que tuviéramos un trío algún día."
    kim "Si vous le vouliez toutes les deux, j'aimerais qu'on fasse un plan à trois un jour."

# game/scripts/c28/c28.rpy:2968
translate french c28s006_KimOnKate_2ac746a3:

    # kim "Me gusta [kat]. La considero super atractiva, aunque no tenga sentimientos por ella más allá de la amistad. Y siempre he querido probar el sexo con otra chica."
    kim "Je l'aime bien. Je la trouve très attirante, même si je n'ai aucun sentiment amoureux pour elle. Et j'ai toujours eu envie de coucher avec une autre fille."

