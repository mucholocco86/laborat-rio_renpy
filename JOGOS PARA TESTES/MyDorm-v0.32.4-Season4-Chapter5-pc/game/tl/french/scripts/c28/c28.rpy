    # mc "Pero, hasta que no cambies 'lesbiana' por 'bisexual' o por 'hetero', no vamos a empezar a salir juntos."
    mc "Mais tant que vous ne remplacerez pas « lesbienne » par « bisexuelle » ou « hétéro », nous ne commencerons pas à sortir ensemble."

# game/scripts/c28/c28.rpy:3750
translate french c28s002_KatRoute_70f5f845:

    # kat "*Risa* ¡Voy a salir con un idiota!"
    kat "*Rires* Je sors avec un idiot !"

# game/scripts/c28/c28.rpy:3751
