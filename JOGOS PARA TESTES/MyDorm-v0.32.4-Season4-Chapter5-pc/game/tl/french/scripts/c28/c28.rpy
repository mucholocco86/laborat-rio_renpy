    lis "Je vais essayer le premier sur..."

# game/scripts/c28/c28.rpy:2516
translate french c28s004_LisaDress_4d3e61b8:

    # lis "¿Qué os parece este?"
    lis "Qu'en pensez-vous ?"

# game/scripts/c28/c28.rpy:2518
translate french c28s004_LisaDress_a2846197:

    # eva "Me gusta. Es muy atrevido, teniendo en cuenta que no vas a poder llevar ropa interior con él."
    eva "J'aime bien. C'est très audacieux, surtout qu'on ne pourra pas porter de sous-vêtements avec."

# game/scripts/c28/c28.rpy:2520
