# game/scripts/c28/c28.rpy:1002
translate french c28s001_vaginalEil_3e10341c:

    # sai "¡Voy!"
    sai "Aller!"

# game/scripts/c28/c28.rpy:1003
translate french c28s001_vaginalEil_5f113aa8:

    # oma "Hay servilletas de papel en la cocina."
    oma "Il y a des serviettes en papier dans la cuisine."

# game/scripts/c28/c28.rpy:1007
translate french c28s001_noFoursome_fe27b9a3:

    # "Al volver a casa, [eil] te dice que la entrevista de [sca] ha ido bien. Mañana le dirán algo sobre el trabajo."
    "De retour chez lui, [eil] vous annonce que l'entretien de [sca] s'est bien passé. Ils auront des nouvelles du poste demain."

# game/scripts/c28/c28.rpy:1009
translate french c28s001_noFoursome_21f6375b:

    # "Subes a tu habitación y juegas un rato a My Residence antes de cenar."
    "Vous montez dans votre chambre et jouez à My Residence pendant un moment avant le dîner."

# game/scripts/c28/c28.rpy:1010
translate french c28s001_noFoursome_b909fe44:

    # "Tienes una tórrida escena de sexo en grupo con Aishwarya, Alejandra, y Laoise."
    "Vous avez une scène de sexe de groupe torride avec Aishwarya, Alejandra et Laoise."

# game/scripts/c28/c28.rpy:1011
translate french c28s001_noFoursome_4aae1ba2:

    # "Aishwarya y Laoise no intentan sacarse los ojos la una a la otra."
    "Aishwarya et Laoise ne cherchent pas à s'arracher les yeux."

# game/scripts/c28/c28.rpy:1012
translate french c28s001_noFoursome_b52c336b:

    # "Laoise incluso acaba descubriendo que tiene cierta curiosidad por cómo sabe el coño de su amiga."
    "Laoise finit même par découvrir qu'elle est quelque peu curieuse de savoir quel goût a le vagin de son amie."

# game/scripts/c28/c28.rpy:1021
translate french c28s002_Kim_0b13330a:

    # "Después de cenar, tras ayudar a [nor] a recoger la cocina, mientras vuelves hacia tu habitación..."
    "Après le dîner, après avoir aidé [nor] à ranger la cuisine, alors que vous retournez dans votre chambre..."

# game/scripts/c28/c28.rpy:1022
translate french c28s002_Kim_a601a6ca:

    # mc "Hey, [kim]. ¿Qué haces aquí?"
    mc "Salut, [kim]. Que fais-tu ici ?"

# game/scripts/c28/c28.rpy:1023
translate french c28s002_Kim_2369d178:

    # kim "Estoy esperando a las chicas. Vamos a dar un paseo por la carretera para bajar la cena."
    kim "J'attends les filles. Nous allons faire une promenade le long de la route pour digérer notre dîner."

# game/scripts/c28/c28.rpy:1024
translate french c28s002_Kim_baebb2a0:

    # kim "Han ido a ponerse calzado cómodo."
    kim "Ils sont allés mettre des chaussures confortables."

# game/scripts/c28/c28.rpy:1025
translate french c28s002_Kim_28a0b0ab:

    # mc "¿Una nueva costumbre?"
    mc "Une nouvelle coutume ?"

# game/scripts/c28/c28.rpy:1027
translate french c28s002_Kim_d265cee6:

    # kim "*Risa* Todas nos hemos engordado un par de libras como mínimo desde que llegamos."
    kim "*Rires* Nous avons tous pris au moins un kilo depuis notre arrivée."

# game/scripts/c28/c28.rpy:1029
translate french c28s002_Kim_8600849f:

    # kim "Todas menos [kat], claro."
    kim "Tous sauf [kat], bien sûr."

# game/scripts/c28/c28.rpy:1030
translate french c28s002_Kim_8149f8bb:

    # kim "Hoy hemos decidido que daremos un paseo cada noche. [kat] es la única que ha decidido no apuntarse."
    kim "Aujourd'hui, nous avons décidé d'aller nous promener tous les soirs. [kat] est le seul à avoir décidé de ne pas se joindre à nous."

# game/scripts/c28/c28.rpy:1031
translate french c28s002_Kim_5458bceb:

    # mc "*Risa* Comer todos los días la comida de [mar] y [nor] tiene efectos secundarios."
    mc "*Rires* Manger tous les jours la nourriture de [mar] et [nor] a des effets secondaires."

# game/scripts/c28/c28.rpy:1032
translate french c28s002_Kim_95d5c3d9:

    # mc "Hablando de [kat], ¿sabes si está enfadada conmigo? Lleva evitándome desde la no-cita."
    mc "À propos de [kat], sais-tu si elle m'en veut ? Elle m'évite depuis qu'on a annulé notre rendez-vous."

# game/scripts/c28/c28.rpy:1034
translate french c28s002_Kim_c4248889:

    # kim "*Susurrando* Ahora no es un buen momento para hablar de eso, [mc]. Podría estar detrás de la puerta esperando al resto de las chicas."
    kim "*Chuchotant* Ce n'est pas le bon moment pour en parler, [mc]. Elle pourrait être derrière la porte à attendre les autres filles."

# game/scripts/c28/c28.rpy:1035
translate french c28s002_Kim_7522274c:

    # mc "Eso que estás diciendo significa que algo pasa, ¿no?"
    mc "Ce que vous dites signifie qu'il y a anguille sous roche, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:1036
translate french c28s002_Kim_20e20485:

    # kim "*Susurrando* Sí, pero será mejor que lo hablemos mañana."
    kim "*À voix basse* Oui, mais il vaut mieux en parler demain."

# game/scripts/c28/c28.rpy:1037
translate french c28s002_Kim_f5271567:

    # mc "Me parece una buena idea."
    mc "Je pense que c'est une bonne idée."

# game/scripts/c28/c28.rpy:1041
translate french c28s002_Kim_99ac3d3d:

    # kim "Cambiando de tema, te invito a comer el viernes. Acabo las clases a mediodía y podríamos hacer algo."
    kim "Pour changer de sujet, je vous invite à déjeuner vendredi. Mes cours se terminent à midi, et nous pourrions faire quelque chose ensemble."

# game/scripts/c28/c28.rpy:1042
translate french c28s002_Kim_2b1b6541:

    # mc "¿Algo en plan cita?"
    mc "Un rendez-vous, en quelque sorte ?"

# game/scripts/c28/c28.rpy:1044
translate french c28s002_Kim_1f428758:

    # kim "Yo había pensado en algo más informal que una cita."
    kim "J'avais pensé à quelque chose de plus informel qu'un rendez-vous."

# game/scripts/c28/c28.rpy:1045
translate french c28s002_Kim_02857be4:

    # kim "Después de lo que pasó en el barco de Iron Fist, creo que invertir parte de mi sueldo de esa noche en invitarte a comer estaría bien."
    kim "Après ce qui s'est passé sur le vaisseau Iron Fist, je pense qu'investir une partie de mon salaire ce soir-là pour t'inviter à dîner serait une bonne idée."

# game/scripts/c28/c28.rpy:1046
translate french c28s002_Kim_0ccde321:

    # mc "Sabes que no hace falta, ¿verdad?"
    mc "Vous savez que ce n'est pas nécessaire, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:1048
translate french c28s002_Kim_5ea97489:

    # kim "Lo sé, pero quiero hacerlo. Cuesta tanto tener tiempo a solas contigo..."
    kim "Je sais, mais j'ai envie de le faire. C'est tellement difficile de trouver du temps seule avec toi..."

# game/scripts/c28/c28.rpy:1049
translate french c28s002_Kim_a2c86fb5:

    # mc "Lo siento, [kim]. Últimamente he estado muy ocupado preparando el viaje a Aruba."
    mc "Désolé, [kim]. J'ai été très occupé ces derniers temps à préparer mon voyage à Aruba."

# game/scripts/c28/c28.rpy:1050
translate french c28s002_Kim_9fafd7cd:

    # mc "Me da la impresión de que me paso el día leyendo informes."
    mc "J'ai l'impression de passer toute ma journée à lire des rapports."

# game/scripts/c28/c28.rpy:1052
translate french c28s002_Kim_a1ae8809:

    # kim "Entonces, ¿eso es un sí?"
    kim "Alors, c'est un oui ?"

# game/scripts/c28/c28.rpy:1053
translate french c28s002_Kim_7eb31e98:

    # mc "Sí, claro que es un sí. ¿Quieres que busque algún sitio para ir a comer?"
    mc "Oui, bien sûr que oui. Voulez-vous que je vous trouve un endroit où manger ?"

# game/scripts/c28/c28.rpy:1055
translate french c28s002_Kim_a57b7044:

    # "La preciosa modelo te besa con alegría. Aquella noche en el barco de Iron Fist cambió muchas cosas en ella."
    "La belle mannequin vous embrasse avec joie. Cette nuit sur le bateau d'Iron Fist a tout changé pour elle."

# game/scripts/c28/c28.rpy:1056
translate french c28s002_Kim_f3f74e1c:

    # "Le dio una seguridad en sí misma que no tenía anteriormente. La [kim] de antes no hubiera tomado la iniciativa para invitarte a comer."
    "Cela lui a donné une assurance qu'elle n'avait pas auparavant. Avant, elle n'aurait jamais pris l'initiative de t'inviter à déjeuner."

# game/scripts/c28/c28.rpy:1057
translate french c28s002_Kim_4fb211f3:

    # "Si no odiaras tanto a Ichigo, casi le tendrías que estar agradecido."
    "Si vous ne détestiez pas autant Ichigo, vous seriez presque obligé de lui être reconnaissant."

# game/scripts/c28/c28.rpy:1059
translate french c28s002_Kim_34de37af:

    # kim "Invito yo, con lo que buscaré algún sitio. No es una cita, no va a ser ningún sitio romántico ni nada por el estilo."
    kim "C'est moi qui invite, je trouverai un endroit. Ce n'est pas un rendez-vous, ce ne sera pas un lieu romantique ou quoi que ce soit de ce genre."

# game/scripts/c28/c28.rpy:1060
translate french c28s002_Kim_9e8ff537:

    # kim "Sólo quiero pasar un rato a solas con mi novio."
    kim "Je veux juste passer un peu de temps seule avec mon copain."

# game/scripts/c28/c28.rpy:1061
translate french c28s002_Kim_1c55f897:

    # mc "Me parece una idea estupenda."
    mc "Je pense que c'est une excellente idée."

# game/scripts/c28/c28.rpy:1063
translate french c28s002_Kim_6486bfca:

    # kim "Cuando lo tenga decidido te aviso, no sea que no te guste el sitio..."
    kim "Je vous tiendrai au courant quand j'aurai pris ma décision, au cas où l'endroit ne vous plairait pas..."

# game/scripts/c28/c28.rpy:1064
translate french c28s002_Kim_1e31a2ef:

    # mc "No te preocupes, mientras tengan un plato sin brócoli no va a haber ningún problema."
    mc "Ne vous inquiétez pas, tant qu'ils proposent un plat sans brocoli, il n'y aura aucun problème."

# game/scripts/c28/c28.rpy:1066
translate french c28s002_Kim_2d7d5ca4:

    # kim "*Risa* ¿Incluso si el único plato sin brócoli es una pizza con piña?"
    kim "*Rires* Même si le seul plat sans brocoli est une pizza à l'ananas ?"

# game/scripts/c28/c28.rpy:1067
translate french c28s002_Kim_2e988f6a:

    # mc "No voy a responder a esa pregunta. *Risa* Ese tema podría ser motivo de ruptura para algunas parejas."
    mc "Je ne répondrai pas à cette question. *Rires* Ce sujet pourrait être une raison de rupture pour certains couples."

# game/scripts/c28/c28.rpy:1069
translate french c28s002_Kim_44a29aed:

    # kim "Si sirve de algo, nunca la pediría, pero no tengo ningún problema en comerla si es una pizza para compartir."
    kim "Pour information, je ne la commanderais jamais, mais je n'ai aucun problème à la manger si c'est une pizza à partager."

# game/scripts/c28/c28.rpy:1070
translate french c28s002_Kim_51d374a2:

    # kim "No es mi favorita ni mucho menos, pero no me resulta desagradable."
    kim "Ce n'est certes pas mon préféré, mais je ne le trouve pas désagréable."

# game/scripts/c28/c28.rpy:1071
translate french c28s002_Kim_d605a170:

    # kim "La que no soporto es la pizza con kiwi."
    kim "Celle que je ne supporte pas, c'est la pizza au kiwi."

# game/scripts/c28/c28.rpy:1072
translate french c28s002_Kim_2262a25d:

    # mc "*Risa* Creo que el tipo que inventó la pizza con kiwi quería convertirse en el más odiado de la humanidad. Por suerte, no se ha hecho popular."
    mc "*Rires* Je crois que le type qui a inventé la pizza au kiwi rêvait d'être la personne la plus détestée au monde. Heureusement, ça n'a pas marché."

# game/scripts/c28/c28.rpy:1074
translate french c28s002_Kim_a58eff80:

    # kim "¿Cuánto se puede tardar en cambiarse de zapatos?"
    kim "Combien de temps faut-il pour changer de chaussures ?"

# game/scripts/c28/c28.rpy:1076
translate french c28s002_Kim_868fb842:

    # mc "*Risa* Para querer pasar tiempo a solas conmigo, tienes muchas ganas de irte con las chicas ahora que estamos a solas..."
    mc "*Rires* Pour quelqu'un qui veut passer du temps seul avec moi, tu as vraiment hâte de partir avec les filles maintenant qu'on est seuls..."

# game/scripts/c28/c28.rpy:1078
translate french c28s002_Kim_e9cd26e9:

    # mc "*Risa* Pareces un chico esperando a su cita."
    mc "*Rires* On dirait un mec qui attend sa rencard."

# game/scripts/c28/c28.rpy:1080
translate french c28s002_Kim_519db893:

    # kim "¡Oh! *Risa* ¡No lo decía por eso! Es que a veces entiendo cuando los chicos os quejáis de lo que tardamos las mujeres en estar listas."
    kim "Oh ! *Rires* Je ne voulais pas dire ça comme ça ! C'est juste que parfois je comprends quand les hommes se plaignent du temps que nous, les femmes, mettons à nous préparer."

# game/scripts/c28/c28.rpy:1081
translate french c28s002_Kim_698a2f68:

    # kim "¡Es sólo cambiarse unos zapatos! ¡No tienen que maquillarse ni probarse ropa nueva!"
    kim "Il suffit de changer de chaussures ! Pas besoin de se maquiller ni d'essayer de nouveaux vêtements !"

# game/scripts/c28/c28.rpy:1082
translate french c28s002_Kim_1dc34f98:

    # mc "*Risa* Bienvenida al mundo de los hombres."
    mc "*Rires* Bienvenue dans le monde des hommes."

# game/scripts/c28/c28.rpy:1085
translate french c28s002_Kim_63bcf9a3:

    # "En ese momento se abre la puerta."
    "À ce moment-là, la porte s'ouvre."

# game/scripts/c28/c28.rpy:1087
translate french c28s002_Kim_a363811b:

    # deb "¿De qué os estáis riendo?"
    deb "De quoi riez-vous ?"

# game/scripts/c28/c28.rpy:1088
translate french c28s002_Kim_31a04b39:

    # mc "Mejor no lo quieras saber. *Risa*"
    mc "Tu ferais mieux de ne pas le savoir. *Rires*"

# game/scripts/c28/c28.rpy:1089
translate french c28s002_Kim_bc69fc2c:

    # lis "No hemos tardado mucho, ¿verdad?"
    lis "Nous n'avons pas été longs, n'est-ce pas ?"

# game/scripts/c28/c28.rpy:1090
translate french c28s002_Kim_c93c4533:

    # kim "Precisamente de eso nos estábamos riendo."
    kim "C'est exactement ce qui nous faisait rire."

# game/scripts/c28/c28.rpy:1091
translate french c28s002_Kim_f3d65716:

    # sai "[lis] ha tenido que ir al lavabo."
    sai "[lis] a dû aller aux toilettes."

# game/scripts/c28/c28.rpy:1093
translate french c28s002_Kim_5c6e4704:

    # lis "¡[sai]!"
    lis "[sai]!"

# game/scripts/c28/c28.rpy:1094
translate french c28s002_Kim_dbc76063:

    # sai "¿Qué? Podías haber ido a lavarte los dientes. Yo lo he hecho mientras te esperábamos."
    sai "Quoi ? Tu aurais pu aller te brosser les dents. Je l'ai fait pendant qu'on t'attendait."

# game/scripts/c28/c28.rpy:1095
translate french c28s002_Kim_b0ef1f77:

    # sai "*Risa* Ahora todo el mundo sabe a lo que has ido."
    sai "*Rires* Maintenant, tout le monde sait pourquoi vous êtes venus."

# game/scripts/c28/c28.rpy:1096
translate french c28s002_Kim_a329b8df:

    # deb "[lis] cree que el resto de los mortales pensamos que las princesas no cagan. *Risa*"
    deb "[lis] pense que nous autres, simples mortels, croyons que les princesses ne font pas caca. *Rires*"

# game/scripts/c28/c28.rpy:1097
translate french c28s002_Kim_0feba2ca:

    # lis "¡[deb.nick]!"
    lis "[deb.nick]!"

# game/scripts/c28/c28.rpy:1098
translate french c28s002_Kim_b44f5814:

    # kim "Chicas, vámonos antes de que acabemos de hacer la digestión... *Risa* Aunque [lis] parece que ya la ha hecho."
    kim "Les filles, allons-y avant d'avoir fini de digérer... *Rires* Bien que [lis] semble avoir déjà digéré."

# game/scripts/c28/c28.rpy:1100
translate french c28s002_Kim_0e50168c:

    # lis "*Risa* ¡Os odio!"
    lis "*Rires* Je vous déteste tous !"

# game/scripts/c28/c28.rpy:1101
translate french c28s002_Kim_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c28/c28.rpy:1102
translate french c28s002_Kim_8489236f:

    # mc "Que vaya bien el paseo, chicas."
    mc "Bonne promenade, les filles."

# game/scripts/c28/c28.rpy:1104
translate french c28s002_Kim_383cd8ec:

    # todas "Hasta mañana, [mc]."
    todas "À demain, [mc]."

# game/scripts/c28/c28.rpy:1106
translate french c28s002_Kim_d9a16ac4:

    # "Te sientes tentado de llamar a la puerta de la habitación que [kim] y [kat] comparten aprovechando que estará sola."
    "Vous êtes tenté de frapper à la porte de la pièce que partagent [kim] et [kat], en profitant du fait qu'elle sera vide."

# game/scripts/c28/c28.rpy:1108
translate french c28s002_Kim_30fa4e80:

    # "Lo piensas mejor y decides esperar a tener toda la información después de hablar con [kim] mañana."
    "Vous y réfléchissez et décidez d'attendre d'avoir toutes les informations après avoir parlé à [kim] demain."

# game/scripts/c28/c28.rpy:1115
translate french c28s002_SimGrateful_f1bce70a:

    # "Al llegar a tu habitación..."
    "Lorsque vous arrivez dans votre chambre..."

# game/scripts/c28/c28.rpy:1117
translate french c28s002_SimGrateful_a23925e4:

    # mc "Hola, [sim]. ¿Puedo ayudarte en algo?"
    mc "Salut, [sim]. Puis-je vous aider ?"

# game/scripts/c28/c28.rpy:1118
translate french c28s002_SimGrateful_ee2bcfe1:

    # sim "Venía tan solo a darte las gracias por lo que hicisteis [ama] y tú."
    sim "Je suis simplement venu vous remercier pour ce que nous avons fait ensemble."

# game/scripts/c28/c28.rpy:1119
translate french c28s002_SimGrateful_d0655e4f:

    # mc "Yo no tuve nada que ver, [sim]. Fue idea de [ama]. Yo solo firmé el papeleo."
    mc "Je n'y suis pour rien, [sim]. C'était l'idée de [ama]. J'ai juste signé les papiers."

# game/scripts/c28/c28.rpy:1121
translate french c28s002_SimGrateful_99b3a6e2:

    # sim "Bueno, si no lo hubieras firmado, [ama] no podría haberlo hecho."
    sim "Eh bien, si vous ne l'aviez pas signé, je n'aurais pas pu le faire."

# game/scripts/c28/c28.rpy:1122
translate french c28s002_SimGrateful_5a69f4be:

    # mc "Estoy seguro de que hubiera encontrado la manera de hacerlo. Se preocupa mucho por todas vosotras."
    mc "Je suis sûre qu'elle aurait trouvé une solution. Elle tient beaucoup à vous tous."

# game/scripts/c28/c28.rpy:1124
translate french c28s002_SimGrateful_8d200725:

    # sim "¿Puedo decirte una cosa? Llevo desde el cumpleaños de las chicas queriéndome quitar el peso de encima..."
    sim "Je peux vous dire quelque chose ? Depuis l'anniversaire des filles, je voulais me libérer de ce poids..."

# game/scripts/c28/c28.rpy:1125
translate french c28s002_SimGrateful_57496572:

    # mc "Lo que quieras. ¿Es tan grave?"
    mc "Comme tu veux. C'est si grave ?"

# game/scripts/c28/c28.rpy:1127
translate french c28s002_SimGrateful_7b7ac8ea:

    # sim "No sé si es grave. Y decírtelo ahora puede parecer que es por las razones equivocadas, pero me siento súper culpable..."
    sim "Je ne sais pas si c'est grave. Et vous le dire maintenant pourrait sembler déplacé, mais je me sens terriblement coupable…"

# game/scripts/c28/c28.rpy:1128
translate french c28s002_SimGrateful_4bfa24fc:

    # mc "¿Qué has hecho para sentirte culpable, [sim]?"
    mc "Qu'as-tu fait pour te sentir coupable, [sim] ?"

# game/scripts/c28/c28.rpy:1129
translate french c28s002_SimGrateful_270232c0:

    # mc "¿Tiene algo que ver con la beca?"
    mc "Est-ce que cela a un lien avec la bourse d'études ?"

# game/scripts/c28/c28.rpy:1131
translate french c28s002_SimGrateful_89f00b40:

    # sim "No, no. No tiene nada que ver con la beca... Tiene que ver con [ama] y [eva]..."
    sim "Non, non. Cela n'a rien à voir avec la bourse... Cela a à voir avec [ama] et [eva]..."

# game/scripts/c28/c28.rpy:1132
translate french c28s002_SimGrateful_80a5b1ff:

    # mc "¿Qué pasa con ellas? ¿Han hecho algo? Me estás empezando a preocupar."
    mc "Qu'est-ce qui leur prend ? Ont-ils fait quelque chose ? Vous commencez à m'inquiéter."

# game/scripts/c28/c28.rpy:1134
translate french c28s002_SimGrateful_e047aac5:

    # sim "No han sido ellas. Fui yo..."
    sim "Ce n'était pas eux. C'était moi..."

# game/scripts/c28/c28.rpy:1135
translate french c28s002_SimGrateful_9157256e:

    # mc "¿Qué hiciste?"
    mc "Qu'est-ce que tu as fait?"

# game/scripts/c28/c28.rpy:1136
translate french c28s002_SimGrateful_ea60ddee:

    # sim "Las prejuzgue. Cuando mi madre me habló de ellas por primera vez... No me parecía normal. Ni siquiera bien."
    sim "Je les ai jugés. Quand ma mère m'en a parlé pour la première fois… ça ne m'a pas paru normal. Ni même bien."

# game/scripts/c28/c28.rpy:1138
translate french c28s002_SimGrateful_2a226678:

    # sim "Clones de mis amigas, unas asesinas, se iban a unir a la familia..."
    sim "Des clones de mes amis, des meurtriers, allaient rejoindre la famille..."

