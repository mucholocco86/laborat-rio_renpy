    emm "Qu'avons-nous dit à propos du style de Jackie ? Vous allez à une fête, pas à un gala."

# game/scripts/c28/c28.rpy:2546
translate french c28s004_LisaDress_20efe1b4:

    # emm "Pero esa chaquetilla te la voy a robar algún día. *Risa*"
    emm "Mais un jour, je te piquerai cette veste. *Rires*"

