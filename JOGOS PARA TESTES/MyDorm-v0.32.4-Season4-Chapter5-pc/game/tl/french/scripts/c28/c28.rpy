    # lis "El top me gusta, pero el conjunto lo encuentro un poco soso..."
    lis "J'aime bien le haut, mais je trouve l'ensemble un peu fade..."

# game/scripts/c28/c28.rpy:2558
translate french c28s004_LisaDress_fec6e6ac:

    # emm "El top me gusta tanto que te lo voy a coger prestado algún día."
    emm "J'aime tellement ce haut que je vais te l'emprunter un jour."

# game/scripts/c28/c28.rpy:2559
translate french c28s004_LisaDress_007f82dd:

    # emm "Pero la falda no te pega a menos que vayas a ir a bailar salsa."
    emm "Mais cette jupe ne vous va pas, sauf si vous allez danser la salsa."

# game/scripts/c28/c28.rpy:2561
translate french c28s004_LisaDress_a52c607e:

    # eva "No estoy de acuerdo con [emm]. A mí me gusta el conjunto. Y el color te pega mucho."
    eva "Je ne suis pas d'accord avec [emm]. J'aime bien ta tenue. Et la couleur te va vraiment bien."

# game/scripts/c28/c28.rpy:2563
translate french c28s004_LisaDress_69244627:

    # lis "Por fin hemos encontrado un candidato. Al menos el top. Vamos a por el último."
    lis "Nous avons enfin trouvé un candidat. Du moins, le meilleur. Passons au dernier."

# game/scripts/c28/c28.rpy:2569
translate french c28s004_LisaDress_b6495cea:

    # lis "Este es el último... Me gusta, aunque el color no demasiado. No sé si me acaba de convencer..."
    lis "Voici le dernier modèle… Je l'aime bien, même si la couleur me laisse un peu perplexe. Je ne suis pas encore totalement convaincue…"

# game/scripts/c28/c28.rpy:2570
translate french c28s004_LisaDress_4e1738e5:

    # lis "Es más sexy que los últimos dos."
    lis "C'est plus sexy que les deux précédents."

# game/scripts/c28/c28.rpy:2572
translate french c28s004_LisaDress_f9fb60c6:

    # emm "Si quieres ir de secretaria sexy está genial."
    emm "Si vous voulez vous habiller en secrétaire sexy, c'est super."

# game/scripts/c28/c28.rpy:2573
translate french c28s004_LisaDress_f8af16ec:

    # eva "A mí me parece muy chulo. Te realza las curvas en los sitios correctos."
    eva "Je trouve ça vraiment génial. Ça met en valeur tes courbes là où il faut."

# game/scripts/c28/c28.rpy:2574
translate french c28s004_LisaDress_d2d80fd7:

    # emm "*Risa* Por eso he dicho lo de secretaria sexy. Para mí es el mejor."
    emm "*Rires* C'est pour ça que j'ai dit « secrétaire sexy ». Pour moi, c'est le meilleur."

# game/scripts/c28/c28.rpy:2576
translate french c28s004_LisaDress_eb0d88ea:

    # lis "¿Entonces os gusta o no?"
    lis "Alors, ça vous plaît ou pas ?"

# game/scripts/c28/c28.rpy:2578
translate french c28s004_LisaDress_750e3ced:

    # eva "A mí me gusta mucho. De todos los que has enseñado, yo elegiría este."
    eva "Je l'aime beaucoup. De tous ceux que vous m'avez montrés, je choisirais celui-ci."

# game/scripts/c28/c28.rpy:2579
translate french c28s004_LisaDress_92fcba97:

    # emm "Yo también. Es moderno, es sexy, y te queda genial. Los tíos van a tener problemas para apartar la mirada de ti."
    emm "Moi aussi. C'est moderne, c'est sexy et ça te va super bien. Les garçons vont avoir du mal à te quitter des yeux."

# game/scripts/c28/c28.rpy:2582
translate french c28s004_LisaDress_836b36b5:

    # lis "El único tío que quiero que me mire es tu hermano."
    lis "Le seul homme que je veux voir me regarder, c'est ton frère."

# game/scripts/c28/c28.rpy:2584
translate french c28s004_LisaDress_5b7d5e0e:

    # emm "Pues no vas a tener ningún problema con eso. Se va a quedar embobado."
    emm "Vous n'aurez aucun problème avec ça. Il sera fasciné."

# game/scripts/c28/c28.rpy:2586
translate french c28s004_LisaDress_85b1c382:

    # lis "Entonces este es el que debería competir con el que había elegido yo."
    lis "C'est donc celui-ci qui devrait concurrencer celui que j'avais choisi."

# game/scripts/c28/c28.rpy:2588
translate french c28s004_LisaDress_603b169a:

    # eva "¿Te hemos hecho dudar con los comentarios? ¿Este ha desbancado al que tú querías?"
    eva "Nos commentaires vous ont-ils fait douter de vous-même ? Celui-ci a-t-il remplacé celui que vous souhaitiez ?"

# game/scripts/c28/c28.rpy:2590
translate french c28s004_LisaDress_82572576:

    # lis "No. *Risa* Ha sido como lo de la moneda que habéis dicho antes."
    lis "Non. *Rires* C'était comme cette histoire de pièces dont tu parlais tout à l'heure."

# game/scripts/c28/c28.rpy:2591
translate french c28s004_LisaDress_950cc61d:

    # lis "Esperaba que le encontrarais pegas a todos los vestidos que me he probado."
    lis "Je m'attendais à ce que vous trouviez à redire à toutes les robes que j'ai essayées."

# game/scripts/c28/c28.rpy:2593
translate french c28s004_LisaDress_23d7c73e:

    # eva "¿Entonces por qué te los has probado?"
    eva "Alors pourquoi les avez-vous essayés ?"

# game/scripts/c28/c28.rpy:2594
translate french c28s004_LisaDress_4cc08b57:

    # emm "[eva], ¿conoces a alguna mujer a la que no le guste probarse cosas? [ama] y tú no contáis."
    emm "[eva], connais-tu une seule femme qui n'aime pas essayer des vêtements ? [ama] et tu ne comptes pas."

# game/scripts/c28/c28.rpy:2596
translate french c28s004_LisaDress_6b56ab09:

    # eva "*Risa* ¡A mí me gusta probarme ropa! Soy casi una chica normal."
    eva "*Rires* J'adore essayer des vêtements ! Je suis presque une fille normale."

# game/scripts/c28/c28.rpy:2597
translate french c28s004_LisaDress_b3b94564_1:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c28/c28.rpy:2599
translate french c28s004_LisaDress_60cd3688:

    # "Las chicas pasan un rato ayudando a [lis] a recoger los vestidos."
    "Les filles passent un peu de temps à aider [lis] à ramasser les robes."

# game/scripts/c28/c28.rpy:2601
translate french c28s004_LisaDress_8c211cf9:

    # "Con la lencería es mucho más fácil. [lis] no quiere ofender a [emm], y usará la que le compró en Monterey. No hay show con la lencería."
    "Avec la lingerie, c'est beaucoup plus simple. [lis] ne veut pas offenser [emm], et elle portera celle qu'elle lui a achetée à Monterey. Il n'y a aucun problème avec la lingerie."

# game/scripts/c28/c28.rpy:2602
translate french c28s004_LisaDress_4d31e4db:

    # "Además, le queda genial, con lo que no tiene dudas en este caso. La única duda que tiene es sobre el color. Cree que [emm] no acertó."
    "De plus, ça lui va très bien, elle n'a donc aucun doute là-dessus. Son seul doute concerne la couleur. Elle pense que [emm] s'est trompé."

# game/scripts/c28/c28.rpy:2603
translate french c28s004_LisaDress_0b88777b:

    # "[emm] le dice que no la tenían en el color que ella cree que le hubiera pegado más."
    "[emm] lui dit qu'ils ne l'avaient pas dans la couleur qui, selon elle, lui aurait le mieux convenu."

# game/scripts/c28/c28.rpy:2604
translate french c28s004_LisaDress_9a8a9232:

    # "Decide buscar el mismo modelo por internet en el color que ella prefiere."
    "Elle décide de chercher le même modèle en ligne dans la couleur qu'elle préfère."

# game/scripts/c28/c28.rpy:2611
translate french c28s005_GavCall_a811e75a:

    # "La llamada con Aaron se desarrolla con normalidad. Un montón de datos sobre operaciones en curso, suministros, y un montón de otras pequeñeces."
    "L'appel avec Aaron se déroule sans problème. Il donne beaucoup d'informations sur les opérations en cours, les approvisionnements et une foule d'autres détails mineurs."

# game/scripts/c28/c28.rpy:2613
translate french c28s005_GavCall_00300e31:

    # "Empiezas a pensar que la decisión de Aaron de dar un paso al lado cuando llegues a Aruba va a ser buena."
    "Vous commencez à penser que la décision d'Aaron de se retirer à votre arrivée à Aruba sera une bonne chose."

# game/scripts/c28/c28.rpy:2614
translate french c28s005_GavCall_6e563707:

    # "Su visión de la empresa todavía es la de un operativo de campo, con lo que le da demasiada importancia a las misiones."
    "Sa vision de l'entreprise reste celle d'un opérateur de terrain, ce qui signifie qu'il accorde trop d'importance aux missions."

# game/scripts/c28/c28.rpy:2615
translate french c28s005_GavCall_a51a8fd4:

    # "Incluso sabiendo que esa parte de la empresa va a desaparecer."
    "Même en sachant que cette partie de l'entreprise va disparaître."

# game/scripts/c28/c28.rpy:2616
translate french c28s005_GavCall_6e102ecf:

    # "Ahora mismo, la empresa está en un impasse. Se mantiene por inercia y por los temas que ya estaban en marcha antes de la Guerra Clon."
    "À l'heure actuelle, l'entreprise est au point mort. Elle survit grâce à l'inertie et à des problèmes qui existaient déjà avant la Guerre des Clones."

# game/scripts/c28/c28.rpy:2617
translate french c28s005_GavCall_5cf4beb5:

    # "Pero nadie se atreve a dar un paso adelante en ninguna dirección."
    "Mais personne n'ose faire un pas en avant, dans quelque direction que ce soit."

# game/scripts/c28/c28.rpy:2618
translate french c28s005_GavCall_0662559a:

    # "Vas a tener que buscar un puesto en el que Aaron pueda ser productivo y relevante."
    "Il va falloir trouver un poste où Aaron puisse être productif et utile."

# game/scripts/c28/c28.rpy:2619
translate french c28s005_GavCall_c79336aa:

    # "Cuando por fin habéis tratado todas las pequeñeces..."
    "Une fois que vous aurez enfin réglé tous les petits détails..."

# game/scripts/c28/c28.rpy:2620
translate french c28s005_GavCall_b3aa1735:

    # mc "Creo que, con eso, ya está todo, ¿no?"
    mc "Je crois que ça couvre tout, non ?"

# game/scripts/c28/c28.rpy:2621
translate french c28s005_GavCall_6dfc8e42:

    # aar "De lo que queríamos tratar hoy, sí."
    aar "C'est précisément ce dont nous voulions parler aujourd'hui, oui."

# game/scripts/c28/c28.rpy:2622
translate french c28s005_GavCall_b7144786:

    # mc "¿Hay algún otro tema?"
    mc "Y a-t-il d'autres sujets à aborder ?"

# game/scripts/c28/c28.rpy:2624
translate french c28s005_GavCall_6962d5d7:

    # aar "Hay alguien que quiere hablar contigo. Creo que deberías escucharle."
    aar "Quelqu'un souhaite te parler. Je pense que tu devrais l'écouter."

# game/scripts/c28/c28.rpy:2625
translate french c28s005_GavCall_39a644d6:

    # mc "¿Quién?"
    mc "OMS?"

# game/scripts/c28/c28.rpy:2627
translate french c28s005_GavCall_129d3ac7:

    # aar "Gavin. Hoy los médicos le han dejado salir de la base por primera vez y hemos estado hablando."
    aar "Gavin. Aujourd'hui, les médecins l'ont autorisé à quitter la base pour la première fois et nous avons pu discuter."

# game/scripts/c28/c28.rpy:2628
translate french c28s005_GavCall_377bd95e:

    # aar "Bueno, llevamos varios días hablando. No lo conocía demasiado, pero es buen chico."
    aar "Eh bien, nous avons discuté pendant plusieurs jours. Je ne le connaissais pas très bien, mais c'est un type sympa."

# game/scripts/c28/c28.rpy:2629
translate french c28s005_GavCall_ce6225f6:

    # mc "¿Cuándo habéis estado paseando por la playa?"
    mc "Quand avez-vous marché sur la plage pour la dernière fois ?"

# game/scripts/c28/c28.rpy:2632
translate french c28s005_GavCall_e6e985b6:

    # aar "¿Tienes a gente espiándome? ¿No te fías de mí?"
    aar "Est-ce que quelqu'un m'espionne ? Vous ne me faites pas confiance ?"

# game/scripts/c28/c28.rpy:2633
translate french c28s005_GavCall_23c40331:

    # mc "No, Aaron. No es mi estilo. Alguien nos ha mandado una foto desde Aruba y te he visto."
    mc "Non, Aaron. Ce n'est pas mon style. Quelqu'un nous a envoyé une photo d'Aruba et je t'ai vu."

# game/scripts/c28/c28.rpy:2634
translate french c28s005_GavCall_b5becebb:

    # mc "Para ser más exactos, he descubierto que era Aruba porque tú salías en la foto."
    mc "Plus précisément, j'ai découvert qu'il s'agissait d'Aruba parce que vous étiez sur la photo."

# game/scripts/c28/c28.rpy:2636
translate french c28s005_GavCall_6ae1d6b4:

    # aar "Disculpa, supongo que es la costumbre de desconfiar de todo el mundo."
    aar "Excusez-moi, je suppose que c'est juste une habitude de me méfier de tout le monde."

# game/scripts/c28/c28.rpy:2637
translate french c28s005_GavCall_01059510:

    # mc "No te preocupes. No sabía que con quien paseabas fuera Gavin... Únicamente sabía que era un G."
    mc "Ne t'inquiète pas. Je ne savais pas que la personne qui t'accompagnait était Gavin… Je savais seulement que c'était un G."

# game/scripts/c28/c28.rpy:2638
translate french c28s005_GavCall_8d59341d:

    # mc "Aunque ahora que sé que es el, me doy cuenta de que había notado algo raro en sus brazos... como si le faltara uno."
    mc "Maintenant que je sais que c'est lui, je me rends compte que j'avais remarqué quelque chose d'étrange au niveau de ses bras… comme s'il lui en manquait un."

# game/scripts/c28/c28.rpy:2640
translate french c28s005_GavCall_d9516baf:

    # aar "Bueno, distinguir a los clones es difícil. *Risa* A veces me cuesta incluso a mí."
    aar "Eh bien, distinguer les clones, c'est difficile. *Rires* Parfois, même moi, j'ai du mal."

# game/scripts/c28/c28.rpy:2641
translate french c28s005_GavCall_8ddf76b8:

    # aar "Supongo que va en lo de ser clones."
    aar "Je suppose que c'est lié au fait d'être des clones."

# game/scripts/c28/c28.rpy:2642
translate french c28s005_GavCall_593ad66f:

    # mc "El otro día [eva] intentó disfrazarse de [dap] y las distinguí perfectamente."
    mc "L'autre jour, [eva] a essayé de se déguiser en [dap] et j'ai pu les distinguer parfaitement."

# game/scripts/c28/c28.rpy:2643
translate french c28s005_GavCall_a14d96d6:

    # mc "Para mí es fácil con ellas. Las veo todos los días."
    mc "C'est facile pour moi avec eux. Je les vois tous les jours."

# game/scripts/c28/c28.rpy:2645
translate french c28s005_GavCall_1aa8ccfc:

    # aar "Supongo que, con el tiempo, acabarás distinguiendo al resto de series. Pero lleva tiempo, especialmente con gente con la que no has tratado mucho."
    aar "Je suppose que vous finirez par distinguer les autres séries. Mais cela prend du temps, surtout avec des personnes avec lesquelles vous n'avez pas beaucoup d'interactions."

# game/scripts/c28/c28.rpy:2646
translate french c28s005_GavCall_9a4a893c:

    # aar "¿Le puedo decir a Gavin que pase?"
    aar "Puis-je dire à Gavin d'entrer ?"

# game/scripts/c28/c28.rpy:2648
translate french c28s005_GavCall_f3c8c6da:

    # mc "Sí, sí, por supuesto."
    mc "Oui, oui, bien sûr."

# game/scripts/c28/c28.rpy:2653
translate french c28s005_GavCall_b43efe1d:

    # gav "Buenas tardes, Señor."
    gav "Bonjour monsieur."

# game/scripts/c28/c28.rpy:2654
translate french c28s005_GavCall_b8032aec:

    # mc "Buenas tardes, Gavin. Llámame [mc]. ¿De qué querías hablar conmigo?"
    mc "Bonjour Gavin. Appelle-moi au [mc]. De quoi voulais-tu me parler ?"

# game/scripts/c28/c28.rpy:2655
translate french c28s005_GavCall_a6922e9a:

    # mc "¿Cómo estás del... brazo?"
    mc "Comment va ton... bras ?"

# game/scripts/c28/c28.rpy:2657
translate french c28s005_GavCall_7f9add48:

    # gav "El brazo... o la queda de él... va bien, de momento."
    gav "Le bras… ou ce qu’il en reste… se porte bien, pour le moment."

# game/scripts/c28/c28.rpy:2658
translate french c28s005_GavCall_7cd7f82b:

    # gav "Los médicos me empiezan a dejar hacer vida normal. Esperan que en menos de un mes pueda volver a los entrenamientos."
    gav "Les médecins commencent à me permettre de reprendre une vie normale. Ils prévoient que je pourrai reprendre l'entraînement d'ici moins d'un mois."

# game/scripts/c28/c28.rpy:2659
translate french c28s005_GavCall_425a5b6e:

    # gav "Dependiendo de cómo vaya la próxima operación, claro."
    gav "Tout dépendra du déroulement de la prochaine opération, bien sûr."

# game/scripts/c28/c28.rpy:2660
translate french c28s005_GavCall_5bbe538c:

    # mc "¿No es demasiado pronto?"
    mc "N'est-ce pas trop tôt ?"

# game/scripts/c28/c28.rpy:2662
translate french c28s005_GavCall_57f48ceb:

    # gav "No debería serlo. Pero debo mantener el brazo izquierdo y las piernas en forma."
    gav "Ça ne devrait pas être le cas. Mais je dois garder mon bras et mes jambes gauches en forme."

# game/scripts/c28/c28.rpy:2663
translate french c28s005_GavCall_e8afb69f:

    # mc "Bueno, los médicos saben mucho más de eso que yo."
    mc "Eh bien, les médecins en savent beaucoup plus que moi à ce sujet."

# game/scripts/c28/c28.rpy:2664
translate french c28s005_GavCall_3953ab2b:

    # mc "Pero supongo que no querías hablar conmigo de tu herida."
    mc "Mais je suppose que vous ne vouliez pas me parler de votre blessure."

# game/scripts/c28/c28.rpy:2666
translate french c28s005_GavCall_2a4e279a:

    # gav "No, Señor. Sólo quería pedirle disculpas a usted y a su familia por lo que pasó aquel día."
    gav "Non, monsieur. Je voulais simplement vous présenter mes excuses, à vous et à votre famille, pour ce qui s'est passé ce jour-là."

# game/scripts/c28/c28.rpy:2667
translate french c28s005_GavCall_7c50392a:

    # gav "Yo sólo cumplía órdenes. Ninguno sabíamos las implicaciones de lo que estábamos haciendo allí, excepto Eric."
    gav "Je ne faisais qu'obéir aux ordres. Aucun d'entre nous, sauf Eric, ne connaissait les implications de ce que nous faisions là-bas."

# game/scripts/c28/c28.rpy:2668
translate french c28s005_GavCall_d56b9c53:

    # mc "Lo entiendo."
    mc "Je comprends."

# game/scripts/c28/c28.rpy:2670
translate french c28s005_GavCall_9cb8b5f3:

    # gav "No, Señor. No lo entiende. Fuimos engañados. Eric nos dijo que ustedes eran una amenaza para NTR."
    gav "Non, monsieur. Vous ne comprenez pas. Nous avons été trompés. Eric nous a dit que vous représentiez une menace pour NTR."

# game/scripts/c28/c28.rpy:2671
translate french c28s005_GavCall_a04e793d:

    # gav "Tan sólo defendíamos a nuestra familia. Nuestro hogar."
    gav "Nous ne faisions que défendre notre famille. Notre maison."

# game/scripts/c28/c28.rpy:2673
translate french c28s005_GavCall_a7548688:

    # gav "Hasta que Aaron nos explicó todo lo que había pasado y lo que estaba en juego no comprendimos lo engañados que estuvimos."
    gav "Ce n'est que lorsqu'Aaron nous a expliqué tout ce qui s'était passé et les enjeux que nous avons réalisé à quel point nous avions été trompés."

