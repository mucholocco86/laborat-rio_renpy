    todas "*Rire*"

# game/scripts/c28/c28.rpy:2508
translate french c28s004_LisaDress_aa31f173:

    # lis "Voy a empezar a probarme los vestidos o no acabaremos nunca. ¡Son cinco vestidos!"
    lis "Je vais commencer à essayer les robes, sinon on n'en finira jamais. Il y a cinq robes !"

# game/scripts/c28/c28.rpy:2509
translate french c28s004_LisaDress_fd46c9cb:

    # lis "Ya he decidido cuál será el sexto que no os enseñaré. Creo que le pega a la 'nueva [lis]'."
    lis "J'ai déjà décidé laquelle des six je ne vous montrerai pas. Je pense qu'elle convient au « nouveau [lis] »."

# game/scripts/c28/c28.rpy:2510
