# game/scripts/c16/c16.rpy:3872
translate french c16s007_NorPregnant_508fb12c:

    # nor "¿Lo habéis mirado? ¿Qué ha salido? Las dos estábamos muy nerviosas..."
    nor "Tu l'as regardé ? Qu'est-ce qu'il y avait d'écrit ? On était tous les deux tellement nerveux..."

# game/scripts/c16/c16.rpy:3874
translate french c16s007_NorPregnant_e6f0faee:

    # mc "¡Positivo! ¡Vas a ser tía abuela!"
    mc "C'est positif ! Tu vas être grand-tante !"

