    # mom "Sabes que vas a ser un padre fantástico, ¿verdad?"
    mom "Tu sais que tu vas être un père fantastique, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:3738
translate french c16s006_MarPregnant_5d48dc38:

    # mc "¿Los padres fantásticos están acojonados a la vez que contentos?"
