    # deb "Por no hablar de besarme..."
    deb "Sans parler du fait de m'embrasser..."

# game/scripts/c16/c16.rpy:1579
translate french c16s002_RunWithDebbie_9097ea63:

    # mc "Es posible que los chicos que has encontrado hasta ahora fueran idiotas. No puedo saberlo."
    mc "Il est possible que les types que tu as rencontrés jusqu'ici soient des idiots. Je ne peux pas en être sûr."

# game/scripts/c16/c16.rpy:1582
translate french c16s002_RunWithDebbie_e5438e46:

    # deb "*Risita* También es posible que yo esté viendo cosas donde no las hay."
    deb "*Rires* Il est aussi possible que je voie des choses qui n'existent pas."

# game/scripts/c16/c16.rpy:1584
translate french c16s002_RunWithDebbie_e53d216f:

    # "Justo en ese momento, un remolino de aire llega donde estáis y rodea a Debbie de un tornado de pétalos de flores."
    "Soudain, un tourbillon d'air vous atteint et entoure Debbie d'une tornade de pétales de fleurs."

# game/scripts/c16/c16.rpy:1587
translate french c16s002_RunWithDebbie_b227959f:

    # deb "¡Qué bonito! *Risa* ¡Es como estar en una película de Disseny!"
    deb "C'est magnifique ! *Rires* On se croirait dans un film Disney !"

# game/scripts/c16/c16.rpy:1588
translate french c16s002_RunWithDebbie_84b5c16b:

    # "Ver así a Debbie, con la cara ilusionada intentando cazar unos pétalos que se le escapan entre los dedos cada vez, es un contraste increíble."
    "Voir Debbie ainsi, le visage empli d'espoir alors qu'elle tente d'attraper les pétales qui lui glissent entre les doigts à chaque fois, offre un contraste saisissant."

# game/scripts/c16/c16.rpy:1589
translate french c16s002_RunWithDebbie_8e9213ec:

    # "Es como ver una niña en el cuerpo de una mujer. Una mujer enorme, pero con la ilusión de una niña."
    "C'est comme voir une petite fille dans un corps de femme. Une femme immense, mais avec l'enthousiasme d'une enfant."

# game/scripts/c16/c16.rpy:1590
translate french c16s002_RunWithDebbie_c046eb09:

    # mc "Ahora mismo eres como una Princesa Disseny. *Risa*"
    mc "En ce moment, tu ressembles à une princesse Disney. *Rires*"

# game/scripts/c16/c16.rpy:1591
translate french c16s002_RunWithDebbie_7d99381c:

    # deb "Solo me falta pillar un pétalo, o mejor una flor, y ponérmela en el pelo. *Risa*"
    deb "Il ne me reste plus qu'à cueillir un pétale, ou mieux encore, une fleur, et à la mettre dans mes cheveux. *Rires*"

# game/scripts/c16/c16.rpy:1592
translate french c16s002_RunWithDebbie_7408f431:

    # "Se te ocurre una idea, quizás sea un poco osada..."
    "Vous avez une idée, peut-être un peu audacieuse..."

# game/scripts/c16/c16.rpy:1609
translate french c16s002_RunWithDebbie_fe833cd9:

    # "Una margarita pasa volando por delante tuyo y la cazas al vuelo."
    "Une marguerite passe devant vous en volant et vous l'attrapez en plein vol."

# game/scripts/c16/c16.rpy:1610
translate french c16s002_RunWithDebbie_f52661d1:

    # mc "¿Una como esta?"
    mc "Un comme celui-ci ?"

# game/scripts/c16/c16.rpy:1611
translate french c16s002_RunWithDebbie_9e3cddaa:

    # "El remolino sigue su camino, llevándose los pétalos y las flores."
    "Le tourbillon poursuit sa course, emportant les pétales et les fleurs."

# game/scripts/c16/c16.rpy:1612
translate french c16s002_RunWithDebbie_4d0a4e9a:

    # deb "Exactamente como esa. Además, justo a tiempo. *Risita*"
    deb "Exactement comme celui-là. Et pile à l'heure. *Rires*"

# game/scripts/c16/c16.rpy:1614
translate french c16s002_RunWithDebbie_fad2761f:

    # mc "¿Me permites?"
    mc "Puis-je?"

# game/scripts/c16/c16.rpy:1615
translate french c16s002_RunWithDebbie_a3f20181:

    # deb "Por supuesto... tú la has cazado... para mí... gracias..."
    deb "Bien sûr… vous l’avez attrapée… pour moi… merci…"

# game/scripts/c16/c16.rpy:1619
translate french c16s002_RunWithDebbie_bd472ab8:

    # "Una margarita pasa volando por delante suyo y Debbie la caza al vuelo."
    "Une marguerite passe devant elle en volant et Debbie l'attrape en plein vol."

# game/scripts/c16/c16.rpy:1620
translate french c16s002_RunWithDebbie_cf53752c:

    # mc "¿Una como esa?"
    mc "Un comme ça ?"

# game/scripts/c16/c16.rpy:1621
translate french c16s002_RunWithDebbie_9e3cddaa_1:

    # "El remolino sigue su camino, llevándose los pétalos y las flores."
    "Le tourbillon poursuit sa course, emportant les pétales et les fleurs."

# game/scripts/c16/c16.rpy:1622
translate french c16s002_RunWithDebbie_eb061492:

    # deb "Exactamente como esta. Además, justo a tiempo. *Risita*"
    deb "Exactement comme ça. Et pile à l'heure. *Rires*"

# game/scripts/c16/c16.rpy:1624
translate french c16s002_RunWithDebbie_6de33996:

    # mc "Te queda muy bien. Ahora eres una auténtica Princesa Disseny."
    mc "Ça te va à merveille. Tu es maintenant une vraie princesse Disseny."

# game/scripts/c16/c16.rpy:1625
translate french c16s002_RunWithDebbie_eaa26fff:

    # deb "Aunque los pétalos ya se han ido."
    deb "Bien que les pétales soient déjà fanés."

# game/scripts/c16/c16.rpy:1626
translate french c16s002_RunWithDebbie_249545ca:

    # mc "Ahora solo falta que cantes y que se te pose un pajarillo en el dedo."
    mc "Il ne vous reste plus qu'à chanter et à espérer qu'un petit oiseau se pose sur votre doigt."

# game/scripts/c16/c16.rpy:1628
translate french c16s002_RunWithDebbie_64d45b23:

    # deb "*Risa* Mejor no, creo que habría una migración de aves en California si me pongo a cantar. En dirección contraria a mi dedo."
    deb "*Rires* Il vaut mieux éviter, je crois qu'il y aurait une migration d'oiseaux en Californie si je me mettais à chanter. Dans la direction opposée à celle de mon doigt."

# game/scripts/c16/c16.rpy:1629
translate french c16s002_RunWithDebbie_60ecec49:

    # mc "No me lo creo. *Risa* ¿Seguimos?"
    mc "Je n'arrive pas à y croire. *Rires* On continue ?"

# game/scripts/c16/c16.rpy:1630
translate french c16s002_RunWithDebbie_cbe3b417:

    # deb "Sí, sigamos hasta el lago. Tengo ganas de bañarme."
    deb "Oui, continuons jusqu'au lac. J'ai envie d'aller nager."

# game/scripts/c16/c16.rpy:1633
translate french c16s002_RunWithDebbie_a4aca7b8:

    # "El remolino de pétalos ha sido una experiencia bonita, pero ha interrumpido la conversación que estabais teniendo sobre como desconciertas a Debbie."
    "Le tourbillon de pétales était une expérience charmante, mais il a interrompu la conversation que vous aviez sur la façon dont vous semez la confusion chez Debbie."

# game/scripts/c16/c16.rpy:1634
translate french c16s002_RunWithDebbie_8d09d5ac:

    # "Con lo tímida que es, va a ser difícil volver a hablar del tema."
    "Étant donné sa timidité, il va être difficile d'aborder à nouveau le sujet."

# game/scripts/c16/c16.rpy:1637
translate french c16s002_RunWithDebbie_6ffed3d9:

    # "Unos minutos después, en el lago, una vez os habéis cambiado de ropa cada cual en su arbusto habitual..."
    "Quelques minutes plus tard, au bord du lac, une fois que vous vous serez tous changés dans vos buissons habituels..."

# game/scripts/c16/c16.rpy:1638
translate french c16s002_RunWithDebbie_eb44829e:

    # mc "¿Nos bañamos?"
    mc "Et si on prenait un bain ?"

# game/scripts/c16/c16.rpy:1640
translate french c16s002_RunWithDebbie_c4f8f570:

    # deb "Dame un segundo. Quiero guardar la flor."
    deb "Donnez-moi une seconde. Je veux garder la fleur."

# game/scripts/c16/c16.rpy:1642
translate french c16s002_RunWithDebbie_d1a22536:

    # deb "Ya está. Así se secará y durará por siempre."
    deb "Voilà. Ça va sécher comme ça et ça durera éternellement."

# game/scripts/c16/c16.rpy:1643
translate french c16s002_RunWithDebbie_1c2c2660:

    # mc "¿Llevas un libro cuando sales a correr?"
    mc "Emportez-vous un livre avec vous lorsque vous allez courir ?"

# game/scripts/c16/c16.rpy:1644
translate french c16s002_RunWithDebbie_9532d122:

    # deb "Estudio Literatura, [mc], y tengo que volver sola. Si encuentro un sitio bonito donde quedarme a leer..."
    deb "J'étudie la littérature et je dois rentrer chez moi seule. Si je trouve un endroit agréable où dormir et lire…"

# game/scripts/c16/c16.rpy:1645
translate french c16s002_RunWithDebbie_256ddbd9:

    # mc "Pero es una flor corriente..."
    mc "Mais ce n'est qu'une fleur ordinaire..."

# game/scripts/c16/c16.rpy:1647
translate french c16s002_RunWithDebbie_d1a83591:

    # deb "Puede que la flor sea corriente, pero la has cazado tú para mí."
    deb "La fleur est peut-être commune, mais vous l'avez cueillie pour moi."

# game/scripts/c16/c16.rpy:1648
translate french c16s002_RunWithDebbie_42039d98:

    # deb "Verla me recordará siempre el remolino de pétalos y como me pusiste la flor en el pelo."
    deb "La voir me rappellera toujours le tourbillon des pétales et la façon dont tu as mis la fleur dans mes cheveux."

# game/scripts/c16/c16.rpy:1649
translate french c16s002_RunWithDebbie_c8be821b:

    # mc "Eso es muy bonito, Debbie."
    mc "C'est très gentil, Debbie."

# game/scripts/c16/c16.rpy:1650
translate french c16s002_RunWithDebbie_df90d381:

    # deb "¡Vamos!"
    deb "Allez!"

# game/scripts/c16/c16.rpy:1652
translate french c16s002_RunWithDebbie_da61d265:

    # deb "¡No te quedes atrás! *Risa* ¡Sólo tenemos media hora!"
    deb "Ne vous laissez pas distancer ! *Rires* Il ne nous reste qu'une demi-heure !"

# game/scripts/c16/c16.rpy:1653
translate french c16s002_RunWithDebbie_d365fdd4:

    # "Otra vez aparece la niña adorable para sustituir a la tímida mujer."
    "Une fois de plus, l'adorable petite fille semble remplacer la femme timide."

# game/scripts/c16/c16.rpy:1659
translate french c16s002_RunWithDebbie_ca53953c:

    # deb "El agua está a la temperatura perfecta hoy. Ni muy fría ni muy caliente. Y es tan transparente..."
    deb "L'eau est à la température idéale aujourd'hui. Ni trop froide, ni trop chaude. Et elle est si claire…"

# game/scripts/c16/c16.rpy:1660
translate french c16s002_RunWithDebbie_36959404:

    # mc "Este lago siempre ha estado muy limpio. Casi nadie sube aquí nunca y los arroyos que lo alimentan bajan muy limpios."
    mc "Ce lac a toujours été très propre. Presque personne ne vient ici, et les ruisseaux qui l'alimentent sont d'une pureté remarquable."

# game/scripts/c16/c16.rpy:1661
translate french c16s002_RunWithDebbie_3bde6d15:

    # mc "Solo está turbio los días después de llover. La lluvia arrastra barro de las laderas, pero en un par de días vuelve a estar transparente."
    mc "Le ciel est nuageux seulement les jours qui suivent la pluie. La pluie emporte la boue des pentes, mais le ciel se dégage à nouveau en quelques jours."

# game/scripts/c16/c16.rpy:1663
translate french c16s002_RunWithDebbie_fbb39a25:

    # deb "Eso me da una idea... ¿has jugado alguna vez a buscar tesoros en este lago? Lisa y yo jugábamos en la playa."
    deb "Ça me donne une idée… Avez-vous déjà fait des chasses au trésor dans ce lac ? Lisa et moi, on jouait sur la plage."

# game/scripts/c16/c16.rpy:1664
translate french c16s002_RunWithDebbie_1abcb75d:

    # mc "¿Buscar tesoros? No creo que haya nada interesante..."
    mc "La chasse au trésor ? Je ne crois pas qu'il y ait quoi que ce soit d'intéressant..."

# game/scripts/c16/c16.rpy:1666
translate french c16s002_RunWithDebbie_9a61adeb:

    # deb "Bueno, no consiste en encontrar doblones españoles. *Risa*"
    deb "Bon, il ne s'agit pas de trouver des doublons espagnols. *Rires*"

# game/scripts/c16/c16.rpy:1667
translate french c16s002_RunWithDebbie_fa3f1b3d:

    # deb "Consiste en hacer una inmersión buscando cosas en el fondo. El que consiga encontrar la cosa más bonita, valiosa, o rara, gana la ronda."
    deb "Il s'agit de plonger et de chercher des objets au fond de l'eau. Celui qui trouve l'objet le plus beau, le plus précieux ou le plus insolite remporte la manche."

# game/scripts/c16/c16.rpy:1668
translate french c16s002_RunWithDebbie_109fa44c:

    # mc "Suena interesante. Nunca he buscado nada aquí. ¡Hagámoslo!"
    mc "Ça a l'air intéressant. Je n'ai jamais rien cherché ici auparavant. Allons-y !"

# game/scripts/c16/c16.rpy:1669
translate french c16s002_RunWithDebbie_71f6139d:

    # mc "Pero ¿hay premio para el que gane?"
    mc "Mais y a-t-il un prix pour le gagnant ?"

# game/scripts/c16/c16.rpy:1671
translate french c16s002_RunWithDebbie_46b767c6:

    # deb "Nunca he jugado por un premio. Siempre he jugado por diversión..."
    deb "Je n'ai jamais joué pour gagner un prix. J'ai toujours joué pour le plaisir..."

# game/scripts/c16/c16.rpy:1672
translate french c16s002_RunWithDebbie_162e597b:

    # mc "Si estuviera Kate aquí seguro que decía que el que pierde paga prenda. *Risa*"
    mc "Si Kate était là, elle dirait sans hésiter que c'est le perdant qui paie la pénalité. *Rires*"

# game/scripts/c16/c16.rpy:1675
translate french c16s002_RunWithDebbie_91782b6a:

    # deb "Pero no lo vamos a hacer, ¿verdad? ¿Qué te parece un beso?"
    deb "Mais on ne va pas faire ça, n'est-ce pas ? Et un baiser, ça vous dit ?"

# game/scripts/c16/c16.rpy:1676
translate french c16s002_RunWithDebbie_094adc07:

    # mc "¿Cómo funcionaría? Un beso es mutuo..."
    mc "Comment cela fonctionnerait-il ? Un baiser est réciproque..."

# game/scripts/c16/c16.rpy:1677
translate french c16s002_RunWithDebbie_fe902c79:

    # deb "Si tú encuentras el mejor tesoro, te beso yo... si lo encuentro yo, me besas tú..."
    deb "Si tu trouves le plus grand trésor, je t'embrasserai… si je le trouve, tu m'embrasseras…"

# game/scripts/c16/c16.rpy:1678
translate french c16s002_RunWithDebbie_3fb014b0:

    # mc "Es decir, que habrá beso después de cada ronda, ¿no?"
    mc "Donc il y aura un baiser après chaque round, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:1680
translate french c16s002_RunWithDebbie_9dea28d6:

    # deb "A menos que haya empate... *Risita*"
    deb "Sauf en cas d'égalité... *Rires*"

# game/scripts/c16/c16.rpy:1681
translate french c16s002_RunWithDebbie_62d84d6b:

    # mc "*Risa* A menos que haya empate."
    mc "*Rires* Sauf en cas d'égalité."

# game/scripts/c16/c16.rpy:1692
translate french c16s002_RunWithDebbie_ffa16180:

    # mc "No sé si me apetece ganar o perder. Pero seguro que no quiero empatar."
    mc "Je ne sais pas si je veux gagner ou perdre. Mais je ne veux surtout pas de match nul."

# game/scripts/c16/c16.rpy:1694
translate french c16s002_RunWithDebbie_aeed3e2c:

    # deb "Te aseguro que estoy en la misma situación. *Risita*"
    deb "Je vous assure que je suis dans la même situation. *Rires*"

# game/scripts/c16/c16.rpy:1695
translate french c16s002_RunWithDebbie_141e4de2:

    # mc "¿Empezamos a jugar? Al mejor de tres."
    mc "On commence à jouer ? Au meilleur des trois manches."

# game/scripts/c16/c16.rpy:1697
translate french c16s002_RunWithDebbie_132350b6:

    # mcp "(Me duele hacerte esto, Debbie, pero no puedo dejar que te ilusiones viendo cosas donde no las hay.)"
    mcp "(Ça me fait mal de te faire ça, Debbie, mais je ne peux pas te laisser te faire de faux espoirs en voyant des choses qui n'existent pas.)"

# game/scripts/c16/c16.rpy:1698
translate french c16s002_RunWithDebbie_6c54ff70:

    # mc "No me malinterpretes, me gustas, pero creo que esto podría llevar a algo que no deberíamos hacer."
    mc "Ne vous méprenez pas, je vous apprécie, mais je pense que cela pourrait mener à quelque chose que nous ne devrions pas faire."

# game/scripts/c16/c16.rpy:1699
translate french c16s002_RunWithDebbie_5d4ff3ad:

    # mc "Me gustas, pero no de ese modo, Debbie, lo siento."
    mc "Je t'aime bien, mais pas de cette façon-là, Debbie, je suis désolé."

# game/scripts/c16/c16.rpy:1701
translate french c16s002_RunWithDebbie_852ea924:

    # deb "Pero... pero... creo que... tú también me has malinterpretado..."
    deb "Mais... mais... je crois... que vous m'avez mal compris aussi..."

# game/scripts/c16/c16.rpy:1702
translate french c16s002_RunWithDebbie_31a33386:

    # deb "No es que... quiera salir contigo... No. Nada de eso... es solo que... besarte es divertido..."
    deb "Ce n'est pas que... je veux sortir avec toi... Non. Rien de tel... c'est juste que... t'embrasser est agréable..."

# game/scripts/c16/c16.rpy:1703
translate french c16s002_RunWithDebbie_95009036:

    # mc "¿Te parece bien si dejamos los besos sólo como buenos días y buenas noches?"
    mc "Serait-ce acceptable d'utiliser simplement des bisous pour se dire bonjour et bonne nuit ?"

# game/scripts/c16/c16.rpy:1705
translate french c16s002_RunWithDebbie_d9fbc30c:

    # deb "Ermmm... sí, vale. Así evitaremos... malentendidos..."
    deb "Euh… oui, d’accord. Comme ça, on évitera… les malentendus…"

# game/scripts/c16/c16.rpy:1706
translate french c16s002_RunWithDebbie_173875ba:

    # deb "Podríamos jugar por... no sé... El que gane menos rondas le paga una cerveza al otro."
    deb "On pourrait jouer pour... je ne sais pas... Celui qui gagne le moins de manches offre une bière à l'autre."

# game/scripts/c16/c16.rpy:1707
translate french c16s002_RunWithDebbie_a8f158c9:

    # mc "Me parece genial. Al mejor de tres ¿Empezamos a jugar?"
    mc "Ça me va très bien. Au meilleur des trois manches. On commence à jouer ?"

# game/scripts/c16/c16.rpy:1709
translate french c16s002_RunWithDebbie_cf7b1fe4:

    # deb "Pero no lo vamos a hacer, ¿verdad? ¿Qué te parece una cerveza? El que gane menos rondas le paga una cerveza al otro."
    deb "Mais on ne va pas faire ça, n'est-ce pas ? Et si on prenait une bière ? Celui qui gagne le moins de manches offre une bière à l'autre."

# game/scripts/c16/c16.rpy:1710
translate french c16s002_RunWithDebbie_1eb54c01:

    # mc "Me parece genial. ¿Empezamos a jugar? Al mejor de tres."
    mc "Ça a l'air super. On commence à jouer ? Au meilleur des trois manches."

# game/scripts/c16/c16.rpy:1712
translate french c16s002_RunWithDebbie_e6504547:

    # "Te sumerges y buscas por el fondo del lago y solo encuentras una piedra con una forma especial antes de que tus pulmones empiecen a pedirte aire."
    "Vous plongez et fouillez le fond du lac, et ne trouvez qu'une pierre à la forme particulière avant que vos poumons ne commencent à réclamer de l'air."

# game/scripts/c16/c16.rpy:1714
translate french c16s002_RunWithDebbie_00e450f8:

    # "Cuando sacas la cabeza del agua Debbie todavía está sumergida. Como dijo Kim, es como una sirenita. ¿O lo dijiste tú?"
    "Quand tu sors la tête de l'eau, Debbie est toujours immergée. Comme l'a dit Kim, elle ressemble à une petite sirène. Ou c'est toi qui as dit ça ?"

# game/scripts/c16/c16.rpy:1717
translate french c16s002_RunWithDebbie_551d07df:

    # "Aparece de pronto, como surgida de la nada, esparciendo agua a su alrededor."
    "Elle apparaît soudainement, comme surgie de nulle part, répandant l'eau tout autour d'elle."

# game/scripts/c16/c16.rpy:1719
translate french c16s002_RunWithDebbie_367bc4c2:

    # deb "¿Qué has encontrado? Tenías razón sobre que estaba muy limpio, es difícil encontrar nada."
    deb "Qu'avez-vous trouvé ? Vous aviez raison, c'était très propre ; on y trouve difficilement quoi que ce soit."

# game/scripts/c16/c16.rpy:1720
translate french c16s002_RunWithDebbie_cf8f509f:

    # mc "¿Lo enseñamos a la vez?"
    mc "Devrions-nous l'enseigner en même temps ?"

# game/scripts/c16/c16.rpy:1721
translate french c16s002_RunWithDebbie_0a73a9e8:

    # deb "¡Venga!"
    deb "Allez!"

# game/scripts/c16/c16.rpy:1723
translate french c16s002_RunWithDebbie_17307285:

    # deb "Una taza oxidada. *Risa*" (multiple=2)
    deb "Une tasse rouillée. *Rires*" (multiple=2)

# game/scripts/c16/c16.rpy:1724
translate french c16s002_RunWithDebbie_8a9a7840:

    # mc "Una piedra. *Risa* Pero tiene una forma especial." (multiple=2)
    mc "Une pierre. *Rires* Mais elle a une forme particulière." (multiple=2)

# game/scripts/c16/c16.rpy:1725
translate french c16s002_RunWithDebbie_2432bdfb:

    # mc "Mal empezamos si lo primero que encuentras es una lata. Te acabo de hacer publicidad de que el lago estaba muy limpio. *Risa*"
    mc "Ça commence mal si la première chose que vous trouvez est une canette. Je viens de vous faire de la pub gratuite pour la propreté du lac. *Rires*"

# game/scripts/c16/c16.rpy:1726
translate french c16s002_RunWithDebbie_d60d007a:

    # deb "¿Has encontrado una piedra que parece un corazón? Está claro que esta ronda la ganas tú. 1-0."
    deb "As-tu trouvé une pierre en forme de cœur ? Tu as clairement gagné cette manche. 1-0."

# game/scripts/c16/c16.rpy:1729
translate french c16s002_RunWithDebbie_19fe362f:

    # deb "Es el momento de que te pague, ¿no?"
    deb "Il est temps que je te paie, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:1730
translate french c16s002_RunWithDebbie_10ad818e:

    # mc "Por supuesto. ¡Quiero mi pago!"
    mc "Bien sûr. Je veux mon paiement !"

# game/scripts/c16/c16.rpy:1732
translate french c16s002_RunWithDebbie_f3be97b8:

    # "El beso de Debbie es muy tierno, como todas las veces que te ha besado hasta ahora. Pero hay algo más, una seguridad que no habías notado anteriormente."
    "Le baiser de Debbie est très tendre, comme tous les baisers qu'elle t'a donnés jusqu'ici. Mais il y a quelque chose de plus, une certitude que tu n'avais pas remarquée auparavant."

# game/scripts/c16/c16.rpy:1733
translate french c16s002_RunWithDebbie_b0ac62f5:

    # mcp "(Aceptar besos como pago la ha hecho sentirse más segura de sí misma. Es una buena señal.)"
    mcp "(Le fait d'accepter des baisers en guise de paiement lui a donné plus d'assurance. C'est bon signe.)"

# game/scripts/c16/c16.rpy:1734
translate french c16s002_RunWithDebbie_01fc50f9:

    # "El beso acaba abruptamente, como si a Debbie se le hubiera ocurrido una idea de repente."
    "Le baiser s'interrompt brusquement, comme si Debbie avait soudain eu une idée."

# game/scripts/c16/c16.rpy:1736
translate french c16s002_RunWithDebbie_f6a02aa0:

    # deb "¿Puedo pedirte un favor?"
    deb "Puis-je vous demander une faveur ?"

# game/scripts/c16/c16.rpy:1737
translate french c16s002_RunWithDebbie_bb3703fb:

    # mc "Lo que quieras."
    mc "Tout ce que vous voulez."

# game/scripts/c16/c16.rpy:1738
translate french c16s002_RunWithDebbie_4bf2bb0b:

    # deb "¿Me regalas la Piedra Corazón?"
    deb "Me donneras-tu la Pierre du Cœur ?"

# game/scripts/c16/c16.rpy:1739
translate french c16s002_RunWithDebbie_ffcffc62:

    # mc "Lo que quieras menos eso. No puedo, Debbie, es muy valiosa."
    mc "Tout sauf ça. Je ne peux pas, Debbie, c'est trop précieux."

# game/scripts/c16/c16.rpy:1741
translate french c16s002_RunWithDebbie_41d447f7:

    # deb "Pero si solo es una piedra..."
    deb "Mais ce n'est qu'une pierre..."

# game/scripts/c16/c16.rpy:1742
translate french c16s002_RunWithDebbie_14218cf8:

    # mc "Pero encontrarla me ha hecho ganar un beso de una chica preciosa. Tiene que ser una piedra increíble."
    mc "Mais la trouver m'a valu un baiser d'une fille magnifique. Ce doit être une pierre extraordinaire."

# game/scripts/c16/c16.rpy:1743
translate french c16s002_RunWithDebbie_1116f50c:

    # mc "Te la podría vender... por otro beso..."
    mc "Je pourrais te le vendre... pour un autre baiser..."

# game/scripts/c16/c16.rpy:1745
translate french c16s002_RunWithDebbie_f10217f9:

    # deb "No puedo aceptar. *Risita* Si es tan valiosa... sentiría que te estoy timando."
    deb "Je ne peux pas accepter. *Rires* Si c'est si précieux... j'aurais l'impression de te tromper."

# game/scripts/c16/c16.rpy:1746
translate french c16s002_RunWithDebbie_5390541b:

    # mc "Mmmmm... ¿qué propones, entonces?"
    mc "Mmm... que proposez-vous alors ?"

# game/scripts/c16/c16.rpy:1747
translate french c16s002_RunWithDebbie_23da9877:

    # deb "¿Qué te parecería un pago a plazos?"
    deb "Et si vous payiez en plusieurs fois ?"

# game/scripts/c16/c16.rpy:1748
translate french c16s002_RunWithDebbie_1fddbcd6:

    # mc "¿Cómo funcionaría eso? ¿Tengo que llamar a mi abogado?"
    mc "Comment cela se passerait-il ? Dois-je appeler mon avocat ?"

# game/scripts/c16/c16.rpy:1749
translate french c16s002_RunWithDebbie_78bf1ad8:

    # deb "Un beso ahora y puedes venir a por más cuando quieras. *Risita*"
    deb "Un seul baiser maintenant, et tu pourras en recevoir d'autres quand tu voudras. *Rires*"

# game/scripts/c16/c16.rpy:1750
translate french c16s002_RunWithDebbie_ffa967c3:

    # mc "Me parece un trato que no voy a poder rechazar. Creo que podemos dejar a los abogados en sus despachos."
    mc "Voilà une offre que je ne peux pas refuser. Je pense que nous pouvons laisser les avocats dans leurs bureaux."

# game/scripts/c16/c16.rpy:1751
translate french c16s002_RunWithDebbie_cece6ae1:

    # deb "Pues aquí va el primer pago..."
    deb "Voici le premier versement..."

# game/scripts/c16/c16.rpy:1753
translate french c16s002_RunWithDebbie_7e613c72:

    # mcp "(Cada vez es más segura besando, también más ansiosa. Demostrarle que yo también quiero estos besos lo está cambiando todo para ella.)"
    mcp "(Elle prend davantage confiance en elle pour embrasser, et elle est aussi plus enthousiaste. Le fait de lui montrer que je désire aussi ces baisers change tout pour elle.)"

# game/scripts/c16/c16.rpy:1755
translate french c16s002_RunWithDebbie_8223a4a9:

    # deb "¡Wow! Lo de dejarme sin aliento, ¿es alguna táctica para que tenga menos tiempo para buscar algo en la siguiente ronda?"
    deb "Waouh ! C'est à couper le souffle ! Est-ce une tactique pour me compliquer la tâche au prochain tour ?"

# game/scripts/c16/c16.rpy:1756
translate french c16s002_RunWithDebbie_803e5147:

    # mc "El premio es tan sabroso que tengo que utilizar todos los trucos sucios a mi alcance. *Risa*"
    mc "Le prix est tellement tentant que je dois utiliser tous les coups bas à ma disposition. *Rires*"

# game/scripts/c16/c16.rpy:1758
translate french c16s002_RunWithDebbie_1605d854:

    # deb "Dame un segundo que voy a guardar mi Piedra Corazón en la mochila. No quiero perderla."
    deb "Donnez-moi une seconde, je vais mettre ma Pierre Cœur dans mon sac à dos. Je ne veux pas la perdre."

# game/scripts/c16/c16.rpy:1759
translate french c16s002_RunWithDebbie_fd80f95e:

    # mc "Es tuya, mientras sigas pagando los plazos. *Risa*"
    mc "Elle est à vous, tant que vous continuez à payer. *Rires*"

# game/scripts/c16/c16.rpy:1761
translate french c16s002_RunWithDebbie_2c5ffd05:

    # mc "¿Segunda ronda?"
    mc "Deuxième tour ?"

# game/scripts/c16/c16.rpy:1762
translate french c16s002_RunWithDebbie_90599b34:

    # deb "Vamos. Esta vez tengo que encontrar algo que te supere o habrás ganado la partida."
    deb "Allez. Cette fois, je dois trouver quelque chose qui te surpasse, sinon tu auras gagné la partie."

# game/scripts/c16/c16.rpy:1765
translate french c16s002_RunWithDebbie_98ee6541:

    # "Debbie ha dejado su taza al lado de su mochila. Ya la recogeréis cuando acabe la partida."
    "Debbie a laissé sa tasse à côté de son sac à dos. Tu pourras la récupérer après la partie."

# game/scripts/c16/c16.rpy:1767
translate french c16s002_RunWithDebbie_ad0afd56:

    # "Lanzáis la taza y la piedra fuera del lago, ya las recogeréis cuando acabe la partida."
    "Jetez la coupe et la pierre hors du lac ; vous pourrez les récupérer une fois la partie terminée."

# game/scripts/c16/c16.rpy:1768
translate french c16s002_RunWithDebbie_babc9790:

    # "Os volvéis a sumergir y a rebuscar en el fondo del lago. No está tan limpio cómo creías, con varias botellas y latas repartidas por el fondo."
    "Vous replongez et commencez à fouiller le fond du lac. Il n'est pas aussi propre que vous le pensiez : plusieurs bouteilles et canettes jonchent le fond."

# game/scripts/c16/c16.rpy:1769
translate french c16s002_RunWithDebbie_bf7d7de6:

    # "Supones que algún excursionista las dejaría en el bosque y serían arrastradas por la lluvia."
    "Vous supposez qu'un randonneur les laisserait dans la forêt et qu'ils seraient emportés par la pluie."

# game/scripts/c16/c16.rpy:1770
translate french c16s002_RunWithDebbie_0fa77e3f:

    # "Los pulmones no aguantan más antes de que tengas que salir con una lata en la mano."
    "Vos poumons ne peuvent plus rien supporter avant que vous ne deviez sortir avec une canette à la main."

# game/scripts/c16/c16.rpy:1772
translate french c16s002_RunWithDebbie_c1b31f4b:

    # deb "Creía que tendría que ir a buscarte... *Risa* O que te habías ahogado."
    deb "Je pensais devoir venir te chercher… *Rires* Ou que tu t’étais noyé."

# game/scripts/c16/c16.rpy:1773
translate french c16s002_RunWithDebbie_a59c4a00:

    # mc "No había piedras bonitas esta vez. *Risa* ¿Qué has encontrado?"
    mc "Il n'y avait pas de jolies pierres cette fois-ci. *Rires* Qu'as-tu trouvé ?"

# game/scripts/c16/c16.rpy:1775
translate french c16s002_RunWithDebbie_72418e04:

    # deb "*Risa* ¡Una lata!" (multiple=2)
    deb "*Rires* Quelle galère !" (multiple=2)

# game/scripts/c16/c16.rpy:1776
translate french c16s002_RunWithDebbie_a210ffc7:

    # mc "*Risa* ¡Una lata esta vez!" (multiple=2)
    mc "*Rires* Une canette cette fois !" (multiple=2)

# game/scripts/c16/c16.rpy:1777
translate french c16s002_RunWithDebbie_44136401:

    # deb "*Risa*" (multiple=2)
    deb "*Rire*" (multiple=2)

# game/scripts/c16/c16.rpy:1778
translate french c16s002_RunWithDebbie_192941cc:

    # mc "*Risa*" (multiple=2)
    mc "*Rire*" (multiple=2)

# game/scripts/c16/c16.rpy:1779
translate french c16s002_RunWithDebbie_121154f5:

    # deb "Eso significa empate, ¿no?"
    deb "Cela signifie un match nul, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:1781
translate french c16s002_RunWithDebbie_211c3725:

    # mc "Bueno, creo que tu lata está en bastante mejor estado que la mía, aún tiene la anilla, con lo que yo te daría por ganadora de esta ronda."
    mc "Eh bien, je pense que ta canette est en bien meilleur état que la mienne ; elle a encore son anneau, donc je dirais que tu as gagné cette manche."

# game/scripts/c16/c16.rpy:1783
translate french c16s002_RunWithDebbie_81a031c1:

    # mc "Además, con un empate me quedo sin beso y tendría que empezar a cobrar los de la Piedra Corazón. *Risa*"
    mc "En plus, avec une égalité, je raterais le baiser et je devrais commencer à récupérer les récompenses de la Pierre du Cœur. *Rires*"

# game/scripts/c16/c16.rpy:1784
translate french c16s002_RunWithDebbie_85bb4ef9:

    # deb "¿Prefieres perder tú a quedarte con el empate? *Risita*"
    deb "Préféreriez-vous perdre plutôt que de faire match nul ? *Rires*"

# game/scripts/c16/c16.rpy:1785
translate french c16s002_RunWithDebbie_45f32f86:

    # mc "Es imposible que besarte signifique perder, Debbie."
    mc "Il est impossible que t'embrasser signifie perdre, Debbie."

# game/scripts/c16/c16.rpy:1787
translate french c16s002_RunWithDebbie_39ac7a8d:

    # deb "¡Ufff! ¿Sabes que me podría acostumbrar a oír esas cosas?"
    deb "Pff ! Tu sais que je pourrais m'habituer à entendre ces choses-là ?"

# game/scripts/c16/c16.rpy:1788
translate french c16s002_RunWithDebbie_e46b3b1b:

    # mc "Y yo me podría acostumbrar a decírtelas. Y ahora tengo que pagar."
    mc "Et je pourrais m'y habituer. Et maintenant, je dois payer."

# game/scripts/c16/c16.rpy:1790
translate french c16s002_RunWithDebbie_665ce14d:

    # mcp "(Veamos qué pasa si ponemos un poco de lengua en el beso)"
    mcp "(Voyons voir ce qui se passe si on ajoute un peu de langue au baiser)"

# game/scripts/c16/c16.rpy:1791
translate french c16s002_RunWithDebbie_c6fc8e3a:

    # deb "*Jadeo de sorpresa*"
    deb "*Halètement de surprise*"

# game/scripts/c16/c16.rpy:1793
translate french c16s002_RunWithDebbie_1d4bae82:

    # "Después de la sorpresa inicial, Debbie entiende lo que tiene que hacer y, sorprendentemente, su lengua sigue la tuya con mucha agilidad."
    "Passé le choc initial, Debbie comprend ce qu'elle doit faire et, étonnamment, sa langue suit la vôtre avec une grande agilité."

# game/scripts/c16/c16.rpy:1794
translate french c16s002_RunWithDebbie_3772e5de:

    # "Poco a poco el beso va subiendo la velocidad y la pasión."
    "Peu à peu, le baiser gagne en vitesse et en passion."

# game/scripts/c16/c16.rpy:1796
translate french c16s002_RunWithDebbie_b74e41b9:

    # deb "¡Ufff! Eso ha sido alucinante. Y otra vez me falta la respiración."
    deb "Waouh ! C'était incroyable. Et je suis à nouveau essoufflé."

# game/scripts/c16/c16.rpy:1797
translate french c16s002_RunWithDebbie_856169ff:

    # mc "Ha sido nuestro primer beso... \"de verdad\". Si quieres vendrán más."
    mc "C'était notre premier baiser… « pour de vrai ». Si tu veux, il y en aura d'autres."

# game/scripts/c16/c16.rpy:1799
translate french c16s002_RunWithDebbie_d4cf42d5:

    # deb "¿Si quiero? ¿Puedo elegir?"
    deb "Ai-je envie de le faire ? Ai-je le choix ?"

# game/scripts/c16/c16.rpy:1800
translate french c16s002_RunWithDebbie_52fa6308:

    # deb "Los besos de antes me ponían la carne de gallina. Este ha convertido mis piernas de gelatina."
    deb "Ses baisers me donnaient la chair de poule. Celui-ci m'a fait flancher les jambes."

# game/scripts/c16/c16.rpy:1801
translate french c16s002_RunWithDebbie_58ea3556:

    # mc "¿Y cuáles prefieres?"
    mc "Et lesquels préférez-vous ?"

# game/scripts/c16/c16.rpy:1803
translate french c16s002_RunWithDebbie_9826a326:

    # deb "¿Por qué no ambos? Creo que debe haber uno para cada circunstancia, ¿no?"
    deb "Pourquoi pas les deux ? Il devrait y en avoir une pour chaque situation, vous ne croyez pas ?"

# game/scripts/c16/c16.rpy:1804
translate french c16s002_RunWithDebbie_2ea22504:

    # mc "Bien pensado. ¿Última ronda?"
    mc "Bonne idée. Dernier tour ?"

# game/scripts/c16/c16.rpy:1806
translate french c16s002_RunWithDebbie_cfeec243:

    # deb "Me parece bien, eso nos deja la última ronda para decidir quién gana."
    deb "Ça me convient, il ne nous reste plus qu'une manche pour décider du vainqueur."

# game/scripts/c16/c16.rpy:1807
translate french c16s002_RunWithDebbie_e3fe8334:

    # mc "¿Vamos a por ella?"
    mc "On tente le coup ?"

# game/scripts/c16/c16.rpy:1809
translate french c16s002_RunWithDebbie_df90d381_1:

    # deb "¡Vamos!"
    deb "Allez!"

# game/scripts/c16/c16.rpy:1811
translate french c16s002_RunWithDebbie_e9427085:

    # "Te diriges a la otra orilla antes de sumergirte. No queda nada interesante donde has estado buscando hasta ahora."
    "Vous vous dirigez de l'autre côté avant de vous lancer. Il n'y a plus rien d'intéressant là où vous avez cherché jusqu'à présent."

# game/scripts/c16/c16.rpy:1813
translate french c16s002_RunWithDebbie_d538ca1f:

    # "Sigues buscando por el fondo del lago sin ver nada que te llame la atención. Puedes ver que Debbie está en la misma situación a través de la cristalina agua del lago."
    "Vous continuez à fouiller le fond du lac sans rien apercevoir. À travers l'eau cristalline, vous voyez que Debbie est dans la même situation."

# game/scripts/c16/c16.rpy:1815
translate french c16s002_RunWithDebbie_ae246103:

    # "Encuentras una piedra redondeada y pulida. No es la Piedra Corazón, pero es mejor que otra lata. Subes a la superficie antes de quedarte sin aire."
    "Vous trouvez une pierre arrondie et polie. Ce n'est pas la Pierre du Cœur, mais c'est mieux qu'une autre. Vous remontez à la surface avant d'être à court d'air."

# game/scripts/c16/c16.rpy:1817
translate french c16s002_RunWithDebbie_7dfa881d:

    # "Debbie ya está allí, esperándote con las manos en la espalda. Mala señal para tu sencilla piedra."
    "Debbie est déjà là, elle t'attend, les mains derrière le dos. Mauvais présage pour ta simple pierre."

# game/scripts/c16/c16.rpy:1818
translate french c16s002_RunWithDebbie_dcd369fa:

    # deb "¿Qué has encontrado esta vez?"
    deb "Qu'avez-vous trouvé cette fois-ci ?"

# game/scripts/c16/c16.rpy:1819
translate french c16s002_RunWithDebbie_731e088c:

    # mc "Vamos a mostrarlo a la vez. Esta ronda designa el ganador."
    mc "Nous allons tous les montrer en même temps. Ce tour déterminera le vainqueur."

# game/scripts/c16/c16.rpy:1822
translate french c16s002_RunWithDebbie_054be045:

    # mc "Otra piedra. Pero más simple."
    mc "Une autre pierre. Mais plus simple."

# game/scripts/c16/c16.rpy:1824
translate french c16s002_RunWithDebbie_88b1c9b8:

    # mc "¿Debbie? ¿Qué has encontrado?"
    mc "Debbie ? Qu'as-tu trouvé ?"

# game/scripts/c16/c16.rpy:1826
translate french c16s002_RunWithDebbie_3ebc731d:

    # deb "Esto. Y no voy a aceptar que me digas que no he ganado la ronda."
    deb "Voilà. Et je n'accepterai pas que vous me disiez que je n'ai pas gagné la manche."

# game/scripts/c16/c16.rpy:1828
translate french c16s002_RunWithDebbie_91db9549:

    # deb "A ti."
    deb "Pour vous."

# game/scripts/c16/c16.rpy:1829
translate french c16s002_RunWithDebbie_40cd3e84:

    # mc "¡Wow, Debbie! Me siento super halagado ahora mismo..."
    mc "Waouh, Debbie ! Je suis vraiment très flattée…"

# game/scripts/c16/c16.rpy:1831
translate french c16s002_RunWithDebbie_c3f76876:

    # deb "¿Pero...?"
    deb "Mais...?"

# game/scripts/c16/c16.rpy:1832
translate french c16s002_RunWithDebbie_2e5bbd4b:

    # mc "¿Qué? ¡No! No hay ningún pero. Me ha sorprendido como lo has dicho."
    mc "Quoi ? Non ! Il n'y a pas de « mais ». J'ai été surpris par la façon dont vous l'avez dit."

# game/scripts/c16/c16.rpy:1834
translate french c16s002_RunWithDebbie_c693eb11:

    # deb "¿Puedo serte sincera?"
    deb "Puis-je être honnête avec vous ?"

# game/scripts/c16/c16.rpy:1835
translate french c16s002_RunWithDebbie_28927394:

    # mc "Siempre."
    mc "Toujours."

# game/scripts/c16/c16.rpy:1836
translate french c16s002_RunWithDebbie_d613aede:

    # deb "No sé qué está pasando."
    deb "Je ne sais pas ce qui se passe."

# game/scripts/c16/c16.rpy:1837
translate french c16s002_RunWithDebbie_cdb26d12:

    # deb "Me gustas. Mucho. Y me gusta que nos besemos. Pero no sé qué somos... o si somos algo. No hemos hablado de nada. Tan solo hemos empezado a besarnos como..."
    deb "Je t'aime bien. Beaucoup. Et j'aime qu'on s'embrasse. Mais je ne sais pas ce qu'on est… ni même si on est quoi que ce soit. On n'a rien dit. On a juste commencé à s'embrasser comme…"

# game/scripts/c16/c16.rpy:1838
translate french c16s002_RunWithDebbie_9b2e2259:

    # mc "¿Como si fuera lo más natural del mundo?"
    mc "Comme si c'était la chose la plus naturelle au monde ?"

# game/scripts/c16/c16.rpy:1840
translate french c16s002_RunWithDebbie_4d6167ff:

    # deb "Exacto. No sé cómo funciona esto. No sé si tenemos que decidir... o decir si eres mi novio o no. O si solo soy una amiga con derecho a besos. No sé nada..."
    deb "Exactement. Je ne sais pas comment ça marche. Je ne sais pas si on doit se décider… ou dire si tu es mon copain ou pas. Ou si je suis juste un ami avec qui on a une relation sans engagement. Je n'y comprends rien…"

# game/scripts/c16/c16.rpy:1841
translate french c16s002_RunWithDebbie_4ca09d7e:

    # mc "No hace falta decir o decidir nada. Tú también me gustas mucho..."
    mc "Il n'est pas nécessaire de dire ou de décider quoi que ce soit. Je t'aime beaucoup aussi..."

# game/scripts/c16/c16.rpy:1843
translate french c16s002_RunWithDebbie_a65a904f:

    # mc "Pero ya sabes que hay alguien más."
    mc "Mais vous savez qu'il y a quelqu'un d'autre."

# game/scripts/c16/c16.rpy:1846
translate french c16s002_RunWithDebbie_734ecb73:

    # deb "Sí, [dap]. Y no sé si está bien que le haga esto."
    deb "Oui, [dap]. Et je ne sais pas si c'est bien de ma part de lui faire ça."

# game/scripts/c16/c16.rpy:1847
translate french c16s002_RunWithDebbie_8363c8f2:

    # mc "No le estás haciendo nada. Ella sabe, y acepta, que puedo salir con otras chicas."
    mc "Tu ne lui fais rien. Elle sait, et elle accepte, que je puisse sortir avec d'autres filles."

# game/scripts/c16/c16.rpy:1849
translate french c16s002_RunWithDebbie_6a551e30:

    # deb "Eso me sorprende aún más. Saliendo con alguien quieres pasar tiempo conmigo... besarme... y..."
    deb "Ça me surprend encore plus. Quand on sort avec quelqu'un, on a envie de passer du temps avec moi… de m'embrasser… et…"

# game/scripts/c16/c16.rpy:1851
translate french c16s002_RunWithDebbie_91bea49b:

    # mc "Y ya te he dicho que no salgo con nadie ahora mismo."
    mc "Et je vous ai déjà dit que je ne sors avec personne en ce moment."

# game/scripts/c16/c16.rpy:1853
translate french c16s002_RunWithDebbie_68e1c7e0:

    # deb "Eso me desconcierta aún más. Pudiendo salir con quien quisieras, quieres pasar tiempo conmigo... besarme... y..."
    deb "Ça me perturbe encore plus. Alors que tu pourrais sortir avec qui tu voulais, tu préfères passer du temps avec moi… m’embrasser… et…"

# game/scripts/c16/c16.rpy:1854
translate french c16s002_RunWithDebbie_4b5eee26:

    # mc "De momento dejémoslo ahí. No sigas con ese \"y\"."
    mc "Arrêtons-nous là pour le moment. N'insistez pas avec ce « et »."

# game/scripts/c16/c16.rpy:1855
translate french c16s002_RunWithDebbie_232e9a3b:

    # mc "Me gusta pasar tiempo contigo. Me gusta besarte. Y el día que quieras, continuaremos con ese \"y\", pero no ahora."
    mc "J'aime passer du temps avec toi. J'aime t'embrasser. Et le jour où tu le voudras, on continuera comme ça, mais pas maintenant."

# game/scripts/c16/c16.rpy:1857
translate french c16s002_RunWithDebbie_f4045637:

    # deb "¿Me estás diciendo que soy tu novia? ¿O una amiga con derecho a roce como era Saira? ¿O alguien con quien pasar el rato si no hay otra chica disponible?"
    deb "Tu es en train de me dire que je suis ta copine ? Ou une amie avec qui tu as une relation sans engagement, comme Saira ? Ou juste quelqu'un avec qui passer du temps s'il n'y a pas d'autre fille disponible ?"

# game/scripts/c16/c16.rpy:1858
translate french c16s002_RunWithDebbie_8ff2a5d7:

    # mc "No me gustan las etiquetas, pero desde luego no eres con quien pasar el rato. Ahora soy yo el que tiene una pregunta."
    mc "Je n'aime pas les étiquettes, mais tu n'es certainement pas quelqu'un avec qui je passerais du temps. À mon tour de poser une question."

# game/scripts/c16/c16.rpy:1859
translate french c16s002_RunWithDebbie_0430a13b:

    # mc "¿Qué quieres que seamos?"
    mc "Que voulez-vous que nous soyons ?"

# game/scripts/c16/c16.rpy:1861
translate french c16s002_RunWithDebbie_87b8442e:

    # deb "¿Qué? ¿Tengo que decidirlo yo?"
    deb "Quoi ? Je dois décider ?"

# game/scripts/c16/c16.rpy:1862
translate french c16s002_RunWithDebbie_d4eb9317:

    # mc "Tú tienes que decidir qué quieres que seamos. Lo que tú quieres es algo que no puedo decidir yo."
    mc "C'est à vous de décider ce que vous voulez que nous devenions. Ce que vous voulez, je n'y peux rien."

# game/scripts/c16/c16.rpy:1865
translate french c16s002_RunWithDebbie_5788175d:

    # deb "No tengo ni idea... hace un rato, cuando me has puesto la flor en el pelo, te hubiera dicho que preferiría ser tu novia. Y no nos habíamos besado... de verdad."
    deb "Je n'en ai aucune idée… Il y a quelques instants, quand tu as mis la fleur dans mes cheveux, je t'aurais dit que je préférais être ta copine. Et on ne s'était même pas embrassés… vraiment."

# game/scripts/c16/c16.rpy:1867
translate french c16s002_RunWithDebbie_b7243ee3:

    # deb "No tengo ni idea... hace un rato, cuando hemos salido de casa, te hubiera dicho que preferiría ser tu novia. Y no nos habíamos besado... de verdad."
    deb "Je n'en sais rien… Il y a quelques instants, quand on est sortis de la maison, je t'aurais dit que je préférais être ta copine. Et on ne s'était même pas embrassés… vraiment."

# game/scripts/c16/c16.rpy:1868
translate french c16s002_RunWithDebbie_481ca0c6:

    # deb "Pero creo que tienes razón. Quizás sea pronto para poner etiquetas todavía, ¿no?"
    deb "Mais je crois que vous avez raison. Il est peut-être encore trop tôt pour étiqueter les choses, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:1869
translate french c16s002_RunWithDebbie_468c4f51:

    # mc "Me parece bien. Cuando lo tengamos más claro, podemos poner las etiquetas que queramos, o inventarnos una que sólo nos defina a nosotros."
    mc "Ça me paraît bien. Une fois que nous aurons une compréhension plus claire, nous pourrons ajouter les étiquettes que nous voulons, ou même en inventer une qui nous définisse uniquement."

# game/scripts/c16/c16.rpy:1871
translate french c16s002_RunWithDebbie_d1a81114:

    # deb "Pero lo que no te voy a perdonar es mi premio... si quieres dármelo."
    deb "Mais ce que je ne te pardonnerai jamais, c'est mon prix… si tu veux bien me le donner."

# game/scripts/c16/c16.rpy:1872
translate french c16s002_RunWithDebbie_e975a156:

    # mc "Un Marks siempre paga sus deudas. *Risa*"
    mc "Marks paie toujours ses dettes. *Rires*"

# game/scripts/c16/c16.rpy:1874
translate french c16s002_RunWithDebbie_92fa167f:

    # "Esta vez el beso tiene una pasión desatada que no ha tenido ninguno de los anteriores."
    "Cette fois, le baiser est d'une passion débridée, différente de toutes les précédentes."

# game/scripts/c16/c16.rpy:1875
translate french c16s002_RunWithDebbie_2878decc:

    # "Tienes que luchar con tus manos para que no empiecen a recorrer el cuerpo de Debbie, empezar a seguir los picos y valles de su musculatura."
    "Il faut lutter avec les mains pour les empêcher de parcourir tout le corps de Debbie, de suivre les reliefs et les creux de sa musculature."

# game/scripts/c16/c16.rpy:1877
translate french c16s002_RunWithDebbie_3fe21357:

    # deb "¡Ufff! Me ha costado tener las manos quietas, [mc]."
    deb "Ouf ! C'était difficile de garder mes mains immobiles, [mc]."

# game/scripts/c16/c16.rpy:1878
translate french c16s002_RunWithDebbie_0f34832b:

    # mc "A mí me ha pasado lo mismo. Pero puedes usarlas si quieres."
    mc "La même chose m'est arrivée. Mais vous pouvez les utiliser si vous le souhaitez."

# game/scripts/c16/c16.rpy:1879
translate french c16s002_RunWithDebbie_05619fae:

    # deb "Pero me has dicho que no continuara con el \"y\"..."
    deb "Mais vous m'avez dit de ne pas continuer avec le « et »..."

# game/scripts/c16/c16.rpy:1880
translate french c16s002_RunWithDebbie_4619879d:

    # mc "¿Te referías a eso? ¡Oops! Te malentendí, culpa mía."
    mc "C'est ce que vous vouliez dire ? Oups ! Je vous ai mal compris, toutes mes excuses."

# game/scripts/c16/c16.rpy:1882
translate french c16s002_RunWithDebbie_5fcce661:

    # deb "¿Qué habías entendido?"
    deb "Qu'aviez-vous compris ?"

# game/scripts/c16/c16.rpy:1883
translate french c16s002_RunWithDebbie_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c16/c16.rpy:1885
translate french c16s002_RunWithDebbie_82f12fab:

    # deb "¡Oh! ¡No! ¡Qué idiota soy! Para ti unos besos están más que superados... tú ya estabas pensando en... eso..."
    deb "Oh non ! Quelle idiote je suis ! Pour toi, quelques baisers, c'est tellement démodé… tu pensais déjà à… ça…"

# game/scripts/c16/c16.rpy:1886
translate french c16s002_RunWithDebbie_61254abf:

    # mc "No, Debbie, no estaba pensando en \"eso\". Hay muchos pasos intermedios entre los besos y \"eso\". Y quiero que los demos juntos."
    mc "Non, Debbie, je ne pensais pas à « ça ». Il y a beaucoup d'étapes entre un baiser et « ça ». Et je veux qu'on les franchisse ensemble."

# game/scripts/c16/c16.rpy:1888
translate french c16s002_RunWithDebbie_dea11191:

    # deb "Ahora mismo te debo parecer una niña tonta para la que unos besos son un tesoro..."
    deb "En ce moment, je dois te paraître comme une petite fille idiote pour qui les baisers sont un trésor..."

# game/scripts/c16/c16.rpy:1889
translate french c16s002_RunWithDebbie_23d69cc1:

    # mc "Para nada, cielo. Tus besos son un tesoro, y cada paso que demos hacia \"eso\" lo será también, pero los daremos cuando llegue el momento y cuando estés cómoda con ello."
    mc "Pas du tout, chérie. Tes baisers sont un trésor, et chaque pas que nous ferons vers « cela » le sera aussi, mais nous les ferons au moment opportun et quand tu seras d'accord."

# game/scripts/c16/c16.rpy:1890
translate french c16s002_RunWithDebbie_ce942098:

    # eva "¡Ejem!"
    eva "Ahem !"

# game/scripts/c16/c16.rpy:1892
translate french c16s002_RunWithDebbie_c15a5fa7:

    # deb "¡Oh, [dap]! ¡Esto no es lo que parece!"
    deb "Oh, [dap] ! Ce n'est pas ce que vous croyez !"

# game/scripts/c16/c16.rpy:1895
translate french c16s002_RunWithDebbie_3e391e5b:

    # deb "Una herradura." (multiple=2)
    deb "Un fer à cheval." (multiple=2)

# game/scripts/c16/c16.rpy:1896
translate french c16s002_RunWithDebbie_b370d95f:

    # mc "Otra piedra. Pero más simple." (multiple=2)
    mc "Une autre pierre. Mais plus simple." (multiple=2)

# game/scripts/c16/c16.rpy:1898
translate french c16s002_RunWithDebbie_bdaf2039:

    # deb "¡Sí! Definitivamente esta vez he ganado yo."
    deb "Oui ! J'ai définitivement gagné cette fois-ci."

# game/scripts/c16/c16.rpy:1899
translate french c16s002_RunWithDebbie_d9a7bd9f:

    # mc "Desde luego. Esa herradura debe llevar décadas ahí. Te debo una cerveza."
    mc "Absolument. Ce fer à cheval doit être là depuis des décennies. Je te dois une bière."

# game/scripts/c16/c16.rpy:1901
translate french c16s002_RunWithDebbie_2abce8fc:

    # deb "Un día que vayamos a la ciudad me la pagas. Ahora me debería ir yendo a secar y a vestir. Quiero llegar a casa y ducharme."
    deb "Tu me rembourseras quand on ira en ville. Je devrais aller me sécher et m'habiller. J'ai envie de rentrer prendre une douche."

# game/scripts/c16/c16.rpy:1902
translate french c16s002_RunWithDebbie_0622f1f0:

    # mc "Perfecto. En unos minutos llegará mi cita."
    mc "Parfait. Mon rendez-vous arrive dans quelques minutes."

# game/scripts/c16/c16.rpy:1903
translate french c16s002_RunWithDebbie_ce942098_1:

    # eva "¡Ejem!"
    eva "Ahem !"

# game/scripts/c16/c16.rpy:1905
translate french c16s002_RunWithDebbie_88cf3c99:

    # deb "¡Oh, [dap]! ¿Qué haces aquí?"
    deb "Oh, [dap] ! Que fais-tu ici ?"

# game/scripts/c16/c16.rpy:1906
translate french c16s002_RunWithDebbie_4dd47fcf:

    # mc "Hola, Eva. No es [dap], Debbie. Ven, os presento. Tengo que explicarte algo."
    mc "Salut Eva. Ce n'est pas Debbie. Viens, je te présente. Je dois t'expliquer quelque chose."

# game/scripts/c16/c16.rpy:1908
translate french c16s002_RunWithDebbie_eadd3d25:

    # "Después de las presentaciones y de que Debbie se cambie, Eva os deja un poco de espacio para que puedas tener La Conversación con Debbie."
    "Après les présentations et une fois que Debbie s'est changée, Eva vous laisse un peu d'espace pour que vous puissiez avoir LA conversation avec Debbie."

# game/scripts/c16/c16.rpy:1910
translate french c16s002_RunWithDebbie_53102d3d:

    # deb "Es alucinante. Si no tuviera a Eva delante de mis ojos, te diría que me estás tomando el pelo."
    deb "C'est incroyable. Si Eva n'était pas devant moi, je vous dirais que vous vous moquez de moi."

# game/scripts/c16/c16.rpy:1912
translate french c16s002_RunWithDebbie_e01241f3:

    # deb "Solo pensar que es un clon de [dap]... o de [eri]... No me lo puedo creer..."
    deb "Rien que de penser que c'est un clone de [dap]... ou de [eri]... je n'arrive pas à y croire..."

# game/scripts/c16/c16.rpy:1914
translate french c16s002_RunWithDebbie_3a789ddf:

    # deb "Solo pensar que [dap] y [eri] son clones suyos... No me lo puedo creer..."
    deb "Rien que de penser que [dap] et [eri] sont des clones de lui... je n'arrive pas à y croire..."

# game/scripts/c16/c16.rpy:1915
translate french c16s002_RunWithDebbie_c137c561:

    # deb "No podía imaginar que estas cosas pasaran..."
    deb "Je n'aurais jamais imaginé que de telles choses puissent se produire..."

# game/scripts/c16/c16.rpy:1916
translate french c16s002_RunWithDebbie_295f3a58:

    # mc "Hoy os lo iban a contar [mar] y [nor], después de contárselo a [emm], [eri], y [dap]."
    mc "Aujourd'hui, [mar] et [nor] allaient vous le dire, après l'avoir dit à [emm], [eri] et [dap]."

# game/scripts/c16/c16.rpy:1917
translate french c16s002_RunWithDebbie_2a51cfb7:

    # mc "Como has venido a correr conmigo no han tenido la oportunidad de hacerlo contigo."
    mc "Depuis que tu cours avec moi, ils n'ont pas eu l'occasion de le faire avec toi."

# game/scripts/c16/c16.rpy:1919
translate french c16s002_RunWithDebbie_69165295:

    # deb "Gracias por confiar en nosotras con un secreto tan grande."
    deb "Merci de nous avoir confié un si grand secret."

# game/scripts/c16/c16.rpy:1920
translate french c16s002_RunWithDebbie_cd5cb341:

    # mc "No creo que vayáis a hacer nada que perjudique a las chicas, y de todas formas, Eva va a venir a comer hoy a casa, con lo que lo descubriríais igualmente."
    mc "Je ne pense pas que tu feras quoi que ce soit pour nuire aux filles, et de toute façon, Eva vient déjeuner aujourd'hui, donc tu le saurais de toute façon."

# game/scripts/c16/c16.rpy:1921
translate french c16s002_RunWithDebbie_0c4ef9b4:

    # deb "Nunca haría nada que pudiera hacer daño a [emm], [eri], o [dap]. Lisa tampoco. Y pondría la mano en el fuego por el resto."
    deb "Je ne ferais jamais rien qui puisse nuire à [emm], [eri] ou [dap]. Lisa non plus. Et je me porte garant pour les autres."

# game/scripts/c16/c16.rpy:1922
translate french c16s002_RunWithDebbie_169c7bc9:

    # deb "Pero ahora os voy a dejar con vuestras cosas. Voy a volver a casa para ver si puedo ayudar en algo."
    deb "Je vais donc vous laisser avec vos affaires. Je rentre chez moi pour voir si je peux vous être utile."

# game/scripts/c16/c16.rpy:1925
translate french c16s002_RunWithDebbie_dd4a2c67:

    # "Es un beso tierno, no sensual. Es un beso que dice \"te veré luego y continuaremos\"."
    "C'est un baiser tendre, pas sensuel. C'est un baiser qui dit : « À plus tard, on continue. »"

# game/scripts/c16/c16.rpy:1926
translate french c16s002_RunWithDebbie_64cdd974:

    # deb "Hasta luego, guapo. Recuerda que me llevo la Piedra Corazón y que puedes cobrar tus besos cuando quieras."
    deb "À plus tard, beau gosse. N'oublie pas que je prends la Pierre du Cœur et que tu pourras récupérer tes baisers quand tu voudras."

# game/scripts/c16/c16.rpy:1927
translate french c16s002_RunWithDebbie_0f5727bc:

    # mc "Hasta luego, preciosa. Lo haré."
    mc "À plus tard, ma belle. Oui, à plus tard."

# game/scripts/c16/c16.rpy:1929
translate french c16s002_RunWithDebbie_1f1f5279:

    # deb "Hasta luego, [mc]."
    deb "À plus tard, [mc]."

# game/scripts/c16/c16.rpy:1930
translate french c16s002_RunWithDebbie_d207ca37:

    # mc "Nos vemos en casa, Debbie."
    mc "À bientôt à la maison, Debbie."

# game/scripts/c16/c16.rpy:1932
translate french c16s002_RunWithDebbie_1d8c41b7:

    # deb "Hasta dentro de un rato, Eva."
    deb "À tout à l'heure, Eva."

# game/scripts/c16/c16.rpy:1934
translate french c16s002_RunWithDebbie_71b77468:

    # eva "Te veo en casa, Debbie."
    eva "Je te verrai à la maison, Debbie."

# game/scripts/c16/c16.rpy:2043
translate french c16s003_ShootingLessons_7d9e18ed:

    # eva "Llegas tarde."
    eva "Tu es en retard."

# game/scripts/c16/c16.rpy:2044
translate french c16s003_ShootingLessons_a93d1747:

    # mc "No, llevo aquí media hora."
    mc "Non, je suis là depuis une demi-heure."

# game/scripts/c16/c16.rpy:2045
translate french c16s003_ShootingLessons_9a5c8c45:

    # eva "36 minutos. Con lo que empezamos 6 minutos tarde."
    eva "36 minutes. Nous avons donc commencé avec 6 minutes de retard."

# game/scripts/c16/c16.rpy:2046
translate french c16s003_ShootingLessons_eed0145f:

    # mc "¿Has estado aquí todo este tiempo? ¿Por qué no nos has avisado?"
    mc "Vous étiez là tout ce temps ? Pourquoi ne nous l'avez-vous pas dit ?"

# game/scripts/c16/c16.rpy:2048
translate french c16s003_ShootingLessons_31789036:

    # eva "Porque habíamos quedado a las 12. Yo he venido antes para prepararlo todo. Y no quería interrumpir vuestro... juego."
    eva "Comme nous avions rendez-vous à midi, je suis arrivée en avance pour tout préparer. Et je ne voulais pas interrompre votre… partie."

# game/scripts/c16/c16.rpy:2049
translate french c16s003_ShootingLessons_c8f04224:

    # eva "Pero a las 12 eres mío. Tú pediste que te enseñara y lo voy a hacer, pero pido puntualidad."
    eva "Mais à 12 ans, tu es à moi. Tu m'as demandé de t'apprendre et je vais le faire, mais je te demande d'être ponctuel."

# game/scripts/c16/c16.rpy:2051
translate french c16s003_ShootingLessons_995f1376:

    # "Cuando llegas al lago, Eva ya te está esperando, con cara de evidente enfado."
    "Lorsque vous arrivez au lac, Eva vous attend déjà, le visage visiblement furieux."

# game/scripts/c16/c16.rpy:2052
translate french c16s003_ShootingLessons_7d9e18ed_1:

    # eva "Llegas tarde."
    eva "Tu es en retard."

# game/scripts/c16/c16.rpy:2053
translate french c16s003_ShootingLessons_8ff7e8b4:

    # mc "Lo siento, he tenido que llevar a Meemaw al médico para un chequeo."
    mc "Je suis désolé, j'ai dû emmener Meemaw chez le médecin pour un bilan de santé."

# game/scripts/c16/c16.rpy:2055
translate french c16s003_ShootingLessons_4950e5b3:

    # eva "¿Está bien?"
    eva "Bien?"

# game/scripts/c16/c16.rpy:2056
translate french c16s003_ShootingLessons_720dc198:

    # mc "Sí, era sólo un chequeo por sus enfermedades. Nada importante."
    mc "Oui, c'était juste un bilan de santé. Rien de grave."

# game/scripts/c16/c16.rpy:2058
translate french c16s003_ShootingLessons_e05a80e0:

    # eva "Con lo que empezamos 6 minutos tarde por algo que no era importante. Dijimos que a las 12 eras mío."
    eva "On a donc commencé avec six minutes de retard pour quelque chose d'insignifiant. On a dit qu'à midi, tu étais à moi."

# game/scripts/c16/c16.rpy:2059
translate french c16s003_ShootingLessons_237c919d:

    # eva "Tú pediste que te enseñara y lo voy a hacer, pero pido puntualidad."
    eva "Vous m'avez demandé de vous enseigner et je le ferai, mais je vous demande d'être ponctuel."

# game/scripts/c16/c16.rpy:2060
translate french c16s003_ShootingLessons_9cb30c09:

    # mc "De acuerdo, disculpa. No sabía que 6 minutos fueran tan importantes."
    mc "D'accord, désolé. Je ne savais pas que 6 minutes étaient si importantes."

# game/scripts/c16/c16.rpy:2062
translate french c16s003_ShootingLessons_77f92da9:

    # eva "Vamos a tratar con armas de verdad, [mc], todo es importante. ¿Vamos?"
    eva "On parle d'armes réelles, de C4, tout compte. On y va ?"

# game/scripts/c16/c16.rpy:2063
translate french c16s003_ShootingLessons_a613997b:

    # mc "¿Dónde?"
    mc "Où?"

# game/scripts/c16/c16.rpy:2064
translate french c16s003_ShootingLessons_5c4d03d5:

    # eva "Ahí detrás de ese repecho. Más tranquilos que en el lago. Menos animales... y menos personas."
    eva "Là, derrière cette colline. Plus paisible qu'au bord du lac. Moins d'animaux... et moins de monde."

# game/scripts/c16/c16.rpy:2065
translate french c16s003_ShootingLessons_0aea45ba:

    # mc "Perfecto. Te sigo."
    mc "Parfait. Je vous suivrai."

# game/scripts/c16/c16.rpy:2078
translate french c16s003_ShootingLessons_0ed08ea3:

    # eva "¿Así que otra más para el harén? No sabía que te gustaban musculosas."
    eva "Alors, une autre pour le harem ? Je ne savais pas que tu aimais les femmes musclées."

# game/scripts/c16/c16.rpy:2080
translate french c16s003_ShootingLessons_3b105dbc:

    # eva "No sabía que te gustaban musculosas."
    eva "Je ne savais pas que tu aimais les femmes musclées."

# game/scripts/c16/c16.rpy:2081
translate french c16s003_ShootingLessons_0beb8d12:

    # mc "Sin querer parecer maleducado, no creo que..."
    mc "Sans vouloir paraître impoli, je ne pense pas..."

# game/scripts/c16/c16.rpy:2083
translate french c16s003_ShootingLessons_183a235d:

    # eva "¿Que sea asunto mío? ¡Oh! No lo es, solo hacía una observación."
    eva "Est-ce que ça me regarde ? Oh ! Non, ça ne me regarde pas, je faisais juste une observation."

# game/scripts/c16/c16.rpy:2084
translate french c16s003_ShootingLessons_f162da72:

    # eva "*Susurrando para sí misma* Pero si no llego a interrumpiros te hubieras podido acostar con ella."
    eva "*Murmure pour elle-même* Mais si je ne t'avais pas interrompu, tu aurais pu coucher avec elle."

# game/scripts/c16/c16.rpy:2085
translate french c16s003_ShootingLessons_e245da95:

    # mc "Sabes que te he oído, ¿verdad?"
    mc "Tu sais que je t'ai entendu, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:2086
translate french c16s003_ShootingLessons_2728ab9d:

    # mc "Debbie y yo aún no estamos ahí."
    mc "Debbie et moi n'y sommes pas encore."

# game/scripts/c16/c16.rpy:2088
translate french c16s003_ShootingLessons_90a084c5:

    # eva "¡Oops! No pretendía que me escucharas."
    eva "Oups ! Je ne voulais pas que tu m'écoutes."

# game/scripts/c16/c16.rpy:2089
translate french c16s003_ShootingLessons_eb585346:

    # eva "Me refería a que, está claro lo que la chica siente por ti..."
    eva "Je voulais dire qu'il est clair ce que la fille ressent pour toi..."

# game/scripts/c16/c16.rpy:2090
translate french c16s003_ShootingLessons_dfcd2792:

    # mc "Bueno, hoy hemos dado un paso, pero sigo pensando que es algo que no te debería importar."
    mc "Bon, nous avons fait un pas en avant aujourd'hui, mais je pense toujours que c'est quelque chose dont vous ne devriez pas vous soucier."

# game/scripts/c16/c16.rpy:2093
translate french c16s003_ShootingLessons_d4384259:

    # mc "Tengo una pregunta..."
    mc "J'ai une question..."

# game/scripts/c16/c16.rpy:2095
translate french c16s003_ShootingLessons_3288126a:

