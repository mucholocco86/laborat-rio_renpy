translate french c16s007_NorPregnant_34010ce8:

    # nor "¿Lo quieres abrir tú o lo abro yo? Tenía que haber tirado la caja. Ahora ya sabríamos lo que es."
    nor "Tu veux l'ouvrir, ou je devrais ? J'aurais dû jeter la boîte. Au moins, on saurait ce que c'est."

# game/scripts/c16/c16.rpy:3891
translate french c16s007_NorPregnant_074b1c12:

    # mc "Y lo hubieras sabido sin mí, en el momento en que ha pitado."
    mc "Et vous l'auriez su sans moi, dès que le coup de sifflet a retenti."

# game/scripts/c16/c16.rpy:3893
translate french c16s007_NorPregnant_0d1b8dc0:

    # nor "Tienes razón... ¿lo abro?"
    nor "Vous avez raison... devrais-je l'ouvrir ?"

# game/scripts/c16/c16.rpy:3894
translate french c16s007_NorPregnant_e8571dd3:

    # mc "Ábrelo. Me estoy empezando a poner nervioso..."
    mc "Ouvre-le. Je commence à m'inquiéter..."

# game/scripts/c16/c16.rpy:3897
translate french c16s007_NorPregnant_68e900c7:

    # nor "Después del resultado de [mar], tengo aún más miedo. ¿Y si el nuestro sale negativo también?"
    nor "Après le résultat de [mar], j'ai encore plus peur. Et si le nôtre est négatif lui aussi ?"

# game/scripts/c16/c16.rpy:3899
translate french c16s007_NorPregnant_ab2d4f3b:

