translate french c16s007_NorPregnant_e703c9e2:

    # nor "¡Felicidades! Al menos no lo seré legalmente, si no, me hubieras hecho sentir muy vieja. *Risa* Pero felicidades, mi amor. Luego hablaré con [mar]."
    nor "Félicitations ! Au moins, je ne le serai pas légalement, sinon tu m'aurais fait me sentir très vieille. *Rires* Mais félicitations, mon amour. Je parlerai à [mar] plus tard."

# game/scripts/c16/c16.rpy:3880
translate french c16s007_NorPregnant_579e1f1d:

    # mc "Gracias, mi vida. Vamos a ver el tuyo, a ver si repetimos resultado."
    mc "Merci, mon amour. Montre-nous le tien, et voyons si nous pouvons obtenir le même résultat."

# game/scripts/c16/c16.rpy:3882
translate french c16s007_NorPregnant_7d39a4f6:

    # mc "Negativo... [mar] estaba muy decepcionada."
    mc "Négatif... [mar] J'ai été très déçu."

