# game/scripts/c16/c16.rpy:3783
translate french c16s006_MarPregnant_945f1a21:

    # mc "No pasa nada, mi amor. Lo seguiremos intentando."
    mc "Ça va aller, mon amour. On va continuer d'essayer."

# game/scripts/c16/c16.rpy:3785
translate french c16s006_MarPregnant_177e5bb3:

