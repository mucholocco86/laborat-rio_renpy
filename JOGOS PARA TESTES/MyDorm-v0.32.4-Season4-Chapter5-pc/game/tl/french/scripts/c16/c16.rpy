translate french c16s006_MarPregnant_d452bc3d:

    # mom "Hace tiempo que los tengo pensados. Solo espero que te gusten."
    mom "J'y pense depuis un moment. J'espère que vous les aimerez."

# game/scripts/c16/c16.rpy:3735
translate french c16s006_MarPregnant_e9e4a96a:

    # mc "Prefiero Sharon a [MarSon]. Pero si sale niño, no le pienso llamar Sharon. *Risa*"
    mc "Je préfère Sharon à [MarSon]. Mais si c'est un garçon, je ne l'appellerai pas Sharon. *Rires*"

