translate french c16s007_NorPregnant_83335f9f:

    # nor "Tengo miedo. ¿Y si sale negativo?"
    nor "J'ai peur. Et si le résultat est négatif ?"

# game/scripts/c16/c16.rpy:3902
translate french c16s007_NorPregnant_736e0295:

    # mc "Habrá más oportunidades. No creerás que voy a dejar de hacerte el amor porque salga negativo el primer test que hacemos que nos puede dar una respuesta fiable, ¿no?"
    mc "Il y aura d'autres occasions. Tu ne crois pas que je vais arrêter de te faire l'amour juste parce que le premier test, qui devrait nous donner une réponse fiable, est négatif, si ?"

# game/scripts/c16/c16.rpy:3904
translate french c16s007_NorPregnant_f99335f0:

    # nor "Espero que no dejes de hacerme el amor nunca, mi vida. Salga positivo o negativo."
    nor "J'espère que tu ne cesseras jamais de me faire l'amour, mon amour. Que le test de grossesse soit positif ou négatif."

# game/scripts/c16/c16.rpy:3906
translate french c16s007_NorPregnant_c5a7ae78:

    # mc "No lo hare, mi amor. Pero, por lo que más quieras, ¡ábrelo ya!"
    mc "Je ne le ferai pas, mon amour. Mais s'il te plaît, par pitié, ouvre-le maintenant !"

# game/scripts/c16/c16.rpy:3911
translate french c16s007_NorPregnant_77f0dd73:

    # nor "¡Verde! ¿Eso es un sí? ¿Estoy embarazada?"
    nor "Vert ! C'est un oui ? Suis-je enceinte ?"

# game/scripts/c16/c16.rpy:3912
translate french c16s007_NorPregnant_df5cf238:

    # mc "Sí, mi amor. ¡Estamos embarazados!"
    mc "Oui, mon amour. Nous attendons un bébé !"

# game/scripts/c16/c16.rpy:3914
translate french c16s007_NorPregnant_b1f56ee4:

    # "[nor] se lanza encima tuyo y te da un beso lleno de alegría y alivio a partes iguales."
    "[nor] se jette sur vous et vous donne un baiser empli à parts égales de joie et de soulagement."

# game/scripts/c16/c16.rpy:3916
translate french c16s007_NorPregnant_3af52d72:

    # nor "¡Felicidades, Papá!"
    nor "Bonne fête des pères !"

# game/scripts/c16/c16.rpy:3917
translate french c16s007_NorPregnant_17e7f44c:

    # mc "¡Felicidades, Mamá! ¿Contenta?"
    mc "Félicitations, maman ! Es-tu heureuse ?"

# game/scripts/c16/c16.rpy:3919
translate french c16s007_NorPregnant_4ed246a8:

    # nor "Contenta, feliz, aliviada, entusiasmada, ilusionada... ¿Y tú?"
    nor "Heureux, soulagé, excité, ravi… Et vous ?"

# game/scripts/c16/c16.rpy:3920
translate french c16s007_NorPregnant_6ab08d11:

    # mc "Lo mismo y un poco más. *Risa*"
    mc "Pareil, et un peu plus. *Rires*"

# game/scripts/c16/c16.rpy:3923
translate french c16s007_NorPregnant_f2b7d42a:

    # nor "No quiero sonar como una mala madre, pero las gemelas llegaron... por accidente. Ni Mike ni yo queríamos tener hijos en ese momento."
    nor "Je ne veux pas passer pour une mauvaise mère, mais les jumeaux sont arrivés… par accident. Ni Mike ni moi ne souhaitions avoir d'enfants à ce moment-là."

# game/scripts/c16/c16.rpy:3926
translate french c16s007_NorPregnant_69e95901:

    # nor "Cuando aquel test salió positivo fue algo inesperado. Este positivo ha sido deseado. Muy deseado. Estoy muy feliz ahora mismo."
    nor "Quand le test s'est révélé positif, c'était inattendu. Ce résultat positif était souhaité. Très souhaité. Je suis très heureux."

# game/scripts/c16/c16.rpy:3927
translate french c16s007_NorPregnant_7c2265b3:

    # nor "A mi edad no pensaba que fuera a volverme a pasar suceder nunca..."
    nor "À mon âge, je n'aurais jamais cru que cela puisse m'arriver à nouveau..."

# game/scripts/c16/c16.rpy:3930
translate french c16s007_NorPregnant_9a797f4e:

    # nor "No quiero sonar como una mala madre, pero las gemelas llegaron... de una forma diferente."
    nor "Je ne veux pas passer pour une mauvaise mère, mais les jumeaux sont arrivés… d’une manière différente."

# game/scripts/c16/c16.rpy:3933
translate french c16s007_NorPregnant_4bf6cc33:

    # nor "Cuando llegaron a mi vida me enamoré de ellas inmediatamente. Pero con este test... me ha pasado lo mismo. ¡Voy a ser madre! ¡Estoy embarazada!"
    nor "Quand ils sont entrés dans ma vie, je suis tombée amoureuse d'eux instantanément. Mais avec ce test… c'est la même chose. Je vais être maman ! Je suis enceinte !"

# game/scripts/c16/c16.rpy:3934
translate french c16s007_NorPregnant_c7353256:

    # mc "Ya eres madre, mi amor. Ahora tan solo vas a tener que pasar por el embarazo."
    mc "Tu es maman maintenant, mon amour. Il ne te reste plus qu'à traverser la grossesse."

# game/scripts/c16/c16.rpy:3936
translate french c16s007_NorPregnant_909f3702:

    # nor "Ya sabes a lo que me refiero. A mi edad no pensaba que fuera a suceder nunca..."
    nor "Vous voyez ce que je veux dire. À mon âge, je n'aurais jamais cru que cela arriverait..."

# game/scripts/c16/c16.rpy:3937
translate french c16s007_NorPregnant_339deede:

    # mc "Pues ha pasado. Ahora solo hay que cuidarte y mimarte. Espero no volver a verte acarrear dos neveras de camping nunca más. Pide ayuda."
    mc "Voilà, c'est fini. Maintenant, il ne me reste plus qu'à prendre soin de toi et à te choyer. J'espère ne plus jamais te revoir trimballer deux glacières de camping. Demande de l'aide."

# game/scripts/c16/c16.rpy:3939
translate french c16s007_NorPregnant_b2227a89:

    # nor "No lo volveré a hacer, no te preocupes. El problema va a ser el vino... con mi madre y Betty aquí..."
    nor "Je ne recommencerai pas, ne t'inquiète pas. Le problème, ce sera le vin… avec ma mère et Betty ici…"

# game/scripts/c16/c16.rpy:3940
translate french c16s007_NorPregnant_c73cd744:

    # mc "¿El vino? ¿Necesitas vino para estar con ellas? Se están portando... relativamente bien."
    mc "Du vin ? Avez-vous besoin de vin pour être avec eux ? Ils se comportent… relativement bien."

# game/scripts/c16/c16.rpy:3942
translate french c16s007_NorPregnant_1bb8ed9a:

    # nor "¡No! ¡No me refiero a eso! *Risa* Ahora que sé que estoy embarazada, no voy a beber vino, y van a sospechar. Especialmente Betty."
    nor "Non ! Je ne veux pas dire ça ! *Rires* Maintenant que je sais que je suis enceinte, je ne vais pas boire de vin, et ils vont se poser des questions. Surtout Betty."

# game/scripts/c16/c16.rpy:3943
translate french c16s007_NorPregnant_d7c96df5:

    # nor "El otro día en la playa se sorprendieron del cava sin alcohol. Pero tenía la excusa de que así las chicas podían brindar. Si compramos también vino sin alcohol..."
    nor "L'autre jour à la plage, ils ont été surpris par le cava sans alcool. Mais j'ai prétexté que les filles pourraient trinquer avec. Si on achète aussi du vin sans alcool…"

# game/scripts/c16/c16.rpy:3944
translate french c16s007_NorPregnant_89bc3ac2:

    # mc "Puedes decir que el alcohol te está haciendo ganar un poco de peso. Realmente vas a ganar peso. *Risa*"
    mc "On peut dire que l'alcool vous fait prendre un peu de poids. Vous allez vraiment prendre du poids. *Rires*"

# game/scripts/c16/c16.rpy:3946
translate french c16s007_NorPregnant_2d9bffca:

    # nor "¿Te voy a tener que llamar Mr. Alcohol? *Risa* Puedes resultar igual de adictivo."
    nor "Vais-je devoir vous appeler Monsieur Alcool ? *Rires* Vous pouvez être tout aussi addictif."

# game/scripts/c16/c16.rpy:3947
translate french c16s007_NorPregnant_4e6e9df2:

    # mc "Puedes llamarme como quieras, mi amor."
    mc "Tu peux m'appeler comme tu veux, mon amour."

# game/scripts/c16/c16.rpy:3952
translate french c16s007_NorPregnant_377aaa65:

    # nor "¡Rojo! Eso es un no, ¿verdad?"
    nor "Rouge ! C'est non, n'est-ce pas ?"

# game/scripts/c16/c16.rpy:3953
translate french c16s007_NorPregnant_d0acab7f:

    # mc "Sí, mi amor. No hemos tenido suerte."
    mc "Oui, mon amour. Nous n'avons pas eu de chance."

# game/scripts/c16/c16.rpy:3955
translate french c16s007_NorPregnant_40b32f42:

    # nor "Bueno, me lo imaginaba... a mi edad no es fácil quedarse embarazada..."
    nor "Je m'en doutais bien... tomber enceinte à mon âge n'est pas chose facile..."

# game/scripts/c16/c16.rpy:3956
translate french c16s007_NorPregnant_7e0adbb5:

    # mc "¿A tu edad? [nor], aún eres joven, creo que tan solo tenemos que intentarlo más."
    mc "À ton âge ? [nor], tu es encore jeune, je pense qu'il faut juste faire plus d'efforts."

# game/scripts/c16/c16.rpy:3958
translate french c16s007_NorPregnant_e2464680:

    # nor "No, [mc], a mi edad se considera difícil, y aunque me quedara embarazada sería un embarazo de riesgo."
    nor "Non, [mc], à mon âge, c'est considéré comme difficile, et même si je tombais enceinte, ce serait une grossesse à haut risque."

# game/scripts/c16/c16.rpy:3959
translate french c16s007_NorPregnant_d49325de:

    # nor "Estaba muy ilusionada con este test, pero..."
    nor "J'étais vraiment enthousiaste à l'idée de ce test, mais..."

# game/scripts/c16/c16.rpy:3961
translate french c16s007_NorPregnant_f2b7d42a_1:

    # nor "No quiero sonar como una mala madre, pero las gemelas llegaron... por accidente. Ni Mike ni yo queríamos tener hijos en ese momento."
    nor "Je ne veux pas passer pour une mauvaise mère, mais les jumeaux sont arrivés… par accident. Ni Mike ni moi ne souhaitions avoir d'enfants à ce moment-là."

# game/scripts/c16/c16.rpy:3964
translate french c16s007_NorPregnant_43c3fccc:

    # nor "Cuando aquel test salió positivo fue algo inesperado. Pero deseaba que este también saliera positivo... lo deseaba mucho. Un bebe tuyo y mío."
    nor "Quand le test s'est révélé positif, c'était inattendu. Mais je voulais tellement que celui-ci le soit aussi… Je le désirais tellement. Un bébé de nous deux."

# game/scripts/c16/c16.rpy:3965
translate french c16s007_NorPregnant_8362186a:

    # nor "A mi edad estaba segura de que no iba a volver a pasarme... y no me he equivocado."
