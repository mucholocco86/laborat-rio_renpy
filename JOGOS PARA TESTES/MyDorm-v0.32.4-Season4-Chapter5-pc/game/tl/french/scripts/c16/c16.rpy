

# game/scripts/c16/c16.rpy:66
translate french c16s001_Whatif_7247ad10:

    # "No estás en ruta con [emm] y [mar] a la vez y hay una escena interesante que necesita las dos rutas abiertas. ¿Quieres verla?"
    "Vous n'êtes pas sur les routes [emm] et [mar] en même temps, et il y a une scène intéressante qui nécessite que les deux routes soient ouvertes. Envie de la voir ?"

# game/scripts/c16/c16.rpy:112
translate french c16s001_EmmaLessons_716a5ffc:

    # mc "¿Pero qué estás diciendo, [mar.mc!t]?"
    mc "Que dis-tu, [mar.mc!t] ?"

# game/scripts/c16/c16.rpy:113
translate french c16s001_EmmaLessons_8cd9cd9a:

    # mc "¿Cómo voy a enseñar a [emm] a besar contigo aquí?"
    mc "Comment vais-je t'apprendre à [emm] comment t'embrasser ici ?"

# game/scripts/c16/c16.rpy:115
translate french c16s001_EmmaLessons_1d3dc463:

    # mom "Bueno, yo preferiría estar para poder corregir lo que vea que hace mal. Pero si creéis que si me quedo aquí os cohibiría..."
    mom "Eh bien, je préférerais être ici pour pouvoir corriger ses erreurs. Mais si vous pensez que ma présence vous mettrait mal à l'aise…"

# game/scripts/c16/c16.rpy:117
translate french c16s001_EmmaLessons_e0c0c11d:

    # emm "No, Mamá, yo preferiría que estuvieras."
    emm "Non, maman, je préférerais que tu sois là."

# game/scripts/c16/c16.rpy:118
translate french c16s001_EmmaLessons_bd9fb73f:

    # emm "Si te vas, ¿cómo voy a saber si lo hago bien o no?"
    emm "Si tu pars, comment saurai-je si je fais les choses correctement ou non ?"

# game/scripts/c16/c16.rpy:120
translate french c16s001_EmmaLessons_036c6829:

    # mom "No sé... supongo que [mc] te lo podría decir, aunque ver a mis hijos besándose... podría ser raro, ¿no?"
    mom "Je ne sais pas... Je pourrais peut-être vous le dire, même si voir mes enfants s'embrasser... ça pourrait être bizarre, non ?"

# game/scripts/c16/c16.rpy:122
translate french c16s001_EmmaLessons_58b4823c:

    # mcp "(A partir de mañana, una vez le cuentes la verdad a [emm], ya no vas a poder decir eso. Realmente no te envidio teniendo que tener esa conversación.)"
    mcp "(À partir de demain, une fois que tu auras dit la vérité à [emm], tu ne pourras plus dire ça. Je ne t'envie vraiment pas d'avoir cette conversation.)"

# game/scripts/c16/c16.rpy:123
translate french c16s001_EmmaLessons_f4182a73:

    # mcp "(No sé a lo que está jugando [emm], pero voy a seguirle el juego.)"
    mcp "(Je ne sais pas ce que [emm] essaie de faire, mais je vais jouer le jeu.)"

# game/scripts/c16/c16.rpy:124
translate french c16s001_EmmaLessons_f575c78b:

    # mc "Si [emm] se va a sentir más cómoda contigo aquí, por mí no hay ningún problema en que te quedes."
    mc "Si [emm] se sent plus à l'aise avec toi ici, je n'ai aucun problème à ce que tu restes."

# game/scripts/c16/c16.rpy:125
translate french c16s001_EmmaLessons_850ffdca:

    # mc "Lo que me sorprende es que quieras que le enseñe a besar yo. ¿Eso no lo hacéis entre chicas?"
    mc "Ce qui me surprend, c'est que tu veuilles que je lui apprenne à embrasser. Vous les filles, vous ne faites pas ça ?"

# game/scripts/c16/c16.rpy:127
translate french c16s001_EmmaLessons_6c57c742:

    # mom "Bueno, sí, pero normalmente cuando somos más jóvenes que [emm]. A esta edad... pueden pasar cosas..."
    mom "Oui, mais généralement quand on est plus jeune que [emm]. À cet âge-là... il peut arriver des choses..."

# game/scripts/c16/c16.rpy:128
translate french c16s001_EmmaLessons_492b8be0:

    # mom "[emm] es una flor tardía. 18 años y aún no ha besado a ningún chico... al menos un beso de verdad."
    mom "[emm] Elle est un peu en retard. À dix-huit ans, elle n'a toujours pas embrassé de garçon... du moins pas un vrai baiser."

# game/scripts/c16/c16.rpy:130
translate french c16s001_EmmaLessons_dd1ac1df:

    # emm "Si no fuera porque esto ha sido idea tuya, casi me enfadaría por lo que acabas de decir, Mamá."
    emm "Si ce n'était pas ton idée, je serais presque en colère contre ce que tu viens de dire, maman."

# game/scripts/c16/c16.rpy:131
translate french c16s001_EmmaLessons_8ae85801:

    # mc "[emm], ser una flor tardía no es nada malo. Imagínate que eres una rosa."
    mc "[emm], être une personne qui s'épanouit tardivement n'est absolument pas une mauvaise chose. Imaginez que vous êtes une rose."

# game/scripts/c16/c16.rpy:133
translate french c16s001_EmmaLessons_da480aac:

    # emm "¿Puedo ser una rosa de color rosa?"
    emm "Puis-je être une rose rose ?"

# game/scripts/c16/c16.rpy:134
translate french c16s001_EmmaLessons_48ac0d55:

    # mcp "(Me está costando horrores aguantarme la risa. [emm] está sobreactuando comportándose como una niña pequeña.)"
    mcp "(J'ai énormément de mal à retenir mon rire. [emm] Elle en fait des tonnes, elle se comporte comme une petite fille.)"

# game/scripts/c16/c16.rpy:135
translate french c16s001_EmmaLessons_a8c9557f:

    # mc "Sí, [emm], puedes ser una rosa rosa."
    mc "Oui, [emm], tu peux être une rose rose."

# game/scripts/c16/c16.rpy:137
translate french c16s001_EmmaLessons_34db9ec4:

    # emm "Entonces, ¿te quedas, Mamá? Ya sabes... para darme consejos sobre lo que hago mal."
    emm "Alors, tu restes, maman ? Tu sais… pour me donner des conseils sur ce que je fais de mal."

# game/scripts/c16/c16.rpy:138
translate french c16s001_EmmaLessons_ea119207:

    # mc "A mí no me importa que te quedes, ya te lo he dicho. Parece que [emm] necesita tu apoyo."
    mc "Ça ne me dérange pas que tu restes, je te l'ai déjà dit. Il semblerait que [emm] ait besoin de ton soutien."

# game/scripts/c16/c16.rpy:140
translate french c16s001_EmmaLessons_8d27d7a6:

    # mom "OK. Os miraré desde el sofá y le daré las indicaciones necesarias."
    mom "OK. Je vais vous observer depuis le canapé et vous donner les instructions nécessaires."

# game/scripts/c16/c16.rpy:141
translate french c16s001_EmmaLessons_e51ff240:

    # mc "¿Me dais un momento para que me quite esta ropa? Yo iba a dormir, pero creo que estas lecciones pueden ser divertidas."
    mc "Pouvez-vous me laisser un instant pour enlever ces vêtements ? J’allais dormir, mais je pense que ces cours peuvent être amusants."

# game/scripts/c16/c16.rpy:143
translate french c16s001_EmmaLessons_0a784105:

    # mom "Vale, ¿salimos de la habitación?"
    mom "Bon, on sort de la pièce ?"

# game/scripts/c16/c16.rpy:144
translate french c16s001_EmmaLessons_3fc0f0e1:

    # mc "¿Para qué? Las dos me visteis dormir desnudo la última vez. No vais a ver nada que no hayáis visto."
    mc "À quoi bon ? Vous m'avez tous les deux vu dormir nu la dernière fois. Vous n'allez rien voir de nouveau."

# game/scripts/c16/c16.rpy:146
translate french c16s001_EmmaLessons_30672f27:

    # emm "¿Te vas a desnudar? Pero yo... yo..."
    emm "Tu vas te déshabiller ? Mais je... je..."

# game/scripts/c16/c16.rpy:147
translate french c16s001_EmmaLessons_63017d86:

    # mom "No me parece correcto, [mc]. Si [emm] lo hace bien y Mjolnir empieza a crecer... no creo que haya visto ninguna... erección nunca..."
    mom "Je ne crois pas que ce soit correct, [mc]. Si [emm] s'y prend bien et que Mjolnir commence à grandir... Je crois que je n'ai jamais vu d'érection..."

# game/scripts/c16/c16.rpy:148
translate french c16s001_EmmaLessons_008f3a27:

    # mc "¿Ni siquiera en el porno?"
    mc "Même pas dans le porno ?"

# game/scripts/c16/c16.rpy:150
translate french c16s001_EmmaLessons_c5bd2ffd:

    # emm "¿Por quién me has tomado, [mc]? ¿Por una pervertida que ve porno?"
    emm "Pour qui me prenez-vous, [mc] ? Un pervers qui regarde du porno ?"

# game/scripts/c16/c16.rpy:151
translate french c16s001_EmmaLessons_5febbab6:

    # mcp "(No te pases, [emm]. Si yo sé que ves porno, lo más probable es que [mar.mc!t] también lo sepa.)"
    mcp "(N'exagère pas, [emm]. Si je sais que tu regardes du porno, il y a de fortes chances que [mar.mc!t] le sache aussi.)"

# game/scripts/c16/c16.rpy:152
translate french c16s001_EmmaLessons_b87cb3be:

    # mc "Como ya os he dicho, me voy a desnudar. Mi habitación, mis normas. Dadme un segundo."
    mc "Comme je vous l'ai déjà dit, je vais me déshabiller. Ma chambre, mes règles. Attendez une seconde."

# game/scripts/c16/c16.rpy:154
translate french c16s001_EmmaLessons_4c1c0296:

    # mc "Ya está. ¿Cómo quieres hacerlo, Mamá?"
    mc "D'accord. Comment veux-tu faire, maman ?"

# game/scripts/c16/c16.rpy:155
translate french c16s001_EmmaLessons_ccb72c29:

    # mom "Pues creo que... ahí, de pie... sería lo mejor... cuando [emm] bese a su novio... los primeros besos serán... de pie, ¿no?"
    mom "Eh bien, je pense que… rester debout là-haut… serait le mieux… quand [emm] embrassera son petit ami… les premiers baisers seront… debout, n’est-ce pas ?"

# game/scripts/c16/c16.rpy:156
translate french c16s001_EmmaLessons_3deb5bbc:

    # emm "A mí me parece... buena idea... así puedes... corregirme... si hago algo mal..."
    emm "Je pense que c'est une bonne idée... comme ça, vous pourrez me corriger si je fais quelque chose de mal..."

# game/scripts/c16/c16.rpy:157
translate french c16s001_EmmaLessons_5e2f8223:

    # mc "Me parece bien. [emm], ven aquí."
    mc "Ça me convient. Viens ici."

# game/scripts/c16/c16.rpy:159
translate french c16s001_EmmaLessons_1cb1e37c:

    # emm "¿Preparado para el mejor beso del mundo?"
    emm "Prêt(e) pour le meilleur baiser du monde ?"

# game/scripts/c16/c16.rpy:161
translate french c16s001_EmmaLessons_a08d05ab:

    # mc "Seguro que lo es, [emm]."
    mc "J'en suis sûr, [emm]."

# game/scripts/c16/c16.rpy:164
translate french c16s001_EmmaLessons_7d26a247:

    # "Tras guiñarte un ojo, [emm] te da posiblemente el peor beso de tu vida. Solo comparable al de Scarlett en el Twins."
    "Après vous avoir fait un clin d'œil, [emm] vous donne sans doute le pire baiser de votre vie. Seul celui de Scarlett dans Twins peut rivaliser avec celui-ci."

# game/scripts/c16/c16.rpy:165
translate french c16s001_EmmaLessons_27c96495:

    # emm "¿Qué tal lo he hecho?"
    emm "Comment ai-je fait ?"

# game/scripts/c16/c16.rpy:166
translate french c16s001_EmmaLessons_41bba42b:

    # mc "La abuela me besa con más pasión, [emm]."
    mc "Grand-mère m'embrasse avec plus de passion, [emm]."

# game/scripts/c16/c16.rpy:168
translate french c16s001_EmmaLessons_e932921a:

    # mom "¡Por Dios, [emm]! ¡Eso se parece más a los besos que me dabas a mí cuando eras una niña que a cómo deberías besar a un chico!"
    mom "Oh mon Dieu, [emm] ! Ça ressemble plus aux baisers que tu me donnais quand tu étais petite fille qu'à la façon dont tu devrais embrasser un garçon !"

# game/scripts/c16/c16.rpy:169
translate french c16s001_EmmaLessons_40d572cc:

    # mc "Bueno, para eso estamos aquí, ¿no? ¿Por qué no le explicas lo que ha hecho mal? Tú tenías mejor visión."
    mc "Eh bien, c'est pour ça qu'on est là, non ? Pourquoi ne lui expliques-tu pas ce qu'il a fait de mal ? Tu avais une meilleure vision des choses."

# game/scripts/c16/c16.rpy:171
translate french c16s001_EmmaLessons_ac3ca6e7:

    # "[mar] se enzarza en una serie de explicaciones sobre cómo poner los labios, qué hacer con la boca, cuál debe ser la actitud..."
    "[mar] se lance alors dans une série d'explications sur la façon de positionner les lèvres, ce qu'il faut faire avec la bouche, quelle attitude adopter..."

# game/scripts/c16/c16.rpy:172
translate french c16s001_EmmaLessons_f88ddcc2:

    # mom "... y ahora me voy a poner aquí. Desde el sofá no he tenido una buena visión. Aquí podré ver qué haces mal."
    mom "…et maintenant, je vais rester ici. Je n'avais pas une bonne vue depuis le canapé. D'ici, je pourrai voir ce que vous faites de travers."

# game/scripts/c16/c16.rpy:174
translate french c16s001_EmmaLessons_e1ad5def:

    # "Se vuelve a repetir la secuencia y [emm] vuelve besarte mal. Aún no sabes a qué está jugando."
    "La scène se répète et [emm] t'embrasse maladroitement à nouveau. Tu ne sais toujours pas à quoi il joue."

# game/scripts/c16/c16.rpy:175
translate french c16s001_EmmaLessons_bf56ebf6:

    # emm "¿Mejor ahora?"
    emm "Ça va mieux maintenant ?"

# game/scripts/c16/c16.rpy:177
translate french c16s001_EmmaLessons_8b799d1a:

    # mc "Algo mejor... ¿no?"
    mc "Quelque chose de mieux... n'est-ce pas ?"

# game/scripts/c16/c16.rpy:178
translate french c16s001_EmmaLessons_3933e3b7:

    # mom "Si, algo mejor, pero va a necesitar mucha práctica. A esto me refería con que no podía besar a su chico así."
    mom "Oui, c'est mieux, mais elle va avoir besoin de beaucoup d'entraînement. C'est ce que je voulais dire quand j'ai dit qu'elle ne pouvait pas embrasser son petit ami comme ça."

# game/scripts/c16/c16.rpy:180
translate french c16s001_EmmaLessons_42bb600f:

    # emm "¿Y si lo besas tú para que yo pueda verlo?"
    emm "Et si tu l'embrassais pour que je puisse le voir ?"

# game/scripts/c16/c16.rpy:181
translate french c16s001_EmmaLessons_0cf81bd1:

    # mcp "(Así que es a eso a lo que estaba jugando, ¿no? [mar.mc!t] no se puede estar tragando eso, ¿verdad?)"
    mcp "(Alors c'est à ça qu'il jouait, hein ? [mar.mc!t] Tu ne vas quand même pas te faire avoir, si ?)"

# game/scripts/c16/c16.rpy:183
translate french c16s001_EmmaLessons_cf65c388:

    # mom "{b}¿Estás loca?{/b} ¿Cómo voy a besarlo? ¡Es mi hijo!"
    mom "{b}Tu es folle ?{/b} Comment suis-je censée l'embrasser ? C'est mon fils !"

# game/scripts/c16/c16.rpy:185
translate french c16s001_EmmaLessons_51527562:

    # mcp "(A ver cómo le explicas mañana que no lo soy y que te has negado a besarme con una excusa falsa.)"
    mcp "(Voyons comment tu vas lui expliquer demain que je ne suis pas elle et que tu as refusé de m'embrasser sous un faux prétexte.)"

# game/scripts/c16/c16.rpy:186
translate french c16s001_EmmaLessons_af1887fa:

    # mcp "(Además, como si eso te importara mucho. *Risa mental*)"
    mcp "(Et puis, comme si ça t'importait tant que ça. *Rires intérieurs*)"

# game/scripts/c16/c16.rpy:188
translate french c16s001_EmmaLessons_bf028e3d:

    # mcp "(Como si eso te importara mucho. *Risa mental*)"
    mcp "(Comme si ça vous importait beaucoup. *Rire intérieur*)"

# game/scripts/c16/c16.rpy:190
translate french c16s001_EmmaLessons_e71d4ac2:

    # emm "Porfi, porfi, porfi..."
    emm "S'il vous plaît, s ......"

# game/scripts/c16/c16.rpy:191
translate french c16s001_EmmaLessons_143a6549:

    # mc "[emm], si le incomoda hacerlo, no la fuerces. Tiene que ser complicado para ella..."
    mc "Si elle n'est pas à l'aise avec ça, ne la forcez pas. Ça doit être difficile pour elle..."

# game/scripts/c16/c16.rpy:193
translate french c16s001_EmmaLessons_b735fe07:

    # mom "No es que me incomode o que sea complicado... es que viendo cómo te beso no va a aprender más que viendo un beso en una película."
    mom "Ce n'est pas que ça me mette mal à l'aise ou que ce soit compliqué… c'est juste que me voir t'embrasser ne lui apprendra pas plus que de regarder un baiser dans un film."

# game/scripts/c16/c16.rpy:194
translate french c16s001_EmmaLessons_f9b26ebc:

    # mc "En eso tienes razón."
    mc "Vous avez raison sur ce point."

# game/scripts/c16/c16.rpy:196
translate french c16s001_EmmaLessons_78f70c88:

    # emm "¿Creéis que me fijo en cómo se besan en una película? No es que me haya interesado nunca... son actores..."
    emm "Tu crois que je fais attention à la façon dont ils s'embrassent dans un film ? Ça ne m'a jamais intéressée… ce sont des acteurs, après tout…"

# game/scripts/c16/c16.rpy:197
translate french c16s001_EmmaLessons_d4210aa1:

    # emm "Porfi, Mamá... ahora me fijaré bien en cómo lo haces tú..."
    emm "S'il te plaît, maman... maintenant je vais bien observer comment tu fais..."

# game/scripts/c16/c16.rpy:199
translate french c16s001_EmmaLessons_7a402623:

    # mom "¿No te importa?"
    mom "Ça ne vous dérange pas ?"

# game/scripts/c16/c16.rpy:200
translate french c16s001_EmmaLessons_e67d343d:

    # mc "No, no me importa, Mamá. Si es por enseñar a [emm]..."
    mc "Non, je m'en fiche, maman. Si c'est pour enseigner [emm]..."

# game/scripts/c16/c16.rpy:201
translate french c16s001_EmmaLessons_be8c7606:

    # mcp "(Si descubre que ya es una experta besando... besándome... nos va a matar a los dos.)"
    mcp "(Si elle découvre qu'elle est déjà experte en baisers... en m'embrassant... elle va nous tuer toutes les deux.)"

# game/scripts/c16/c16.rpy:203
translate french c16s001_EmmaLessons_3dcf73b4:

    # mom "Observa bien, [emm]. No lo vamos a repetir."
    mom "Regarde bien, [emm]. Nous n'allons pas le répéter."

# game/scripts/c16/c16.rpy:204
translate french c16s001_EmmaLessons_85bee377:

    # emm "Entonces necesitaré que sea un beso largo, para poder verlo desde todos los ángulos."
    emm "Alors il me faudra un long baiser, pour pouvoir le voir sous tous les angles."

# game/scripts/c16/c16.rpy:206
translate french c16s001_EmmaLessons_a3b9535d:

    # "El beso con [mar] empieza con cierta timidez, pero va ganando en pasión tal como pasan los segundos y [emm] va dando vueltas alrededor vuestro como si estuviera tomando notas."
    "Le baiser avec [mar] commence timidement, mais il devient plus passionné au fur et à mesure que les secondes passent et [emm] tourne autour de vous comme s'il prenait des notes."

# game/scripts/c16/c16.rpy:207
translate french c16s001_EmmaLessons_caee7d60:

    # mom "*Susurrando* ¡Ufff! ¡Cómo echaba de menos esto! Me has puesto cachonda con un solo beso..."
    mom "*Chuchotant* Oh ! Ça m'avait tellement manqué ! Un seul baiser m'a fait chavirer..."

# game/scripts/c16/c16.rpy:208
translate french c16s001_EmmaLessons_b96d3726:

    # mc "*Susurrando* Tú a mí también."
    mc "*Chuchotant* Toi aussi."

# game/scripts/c16/c16.rpy:211
translate french c16s001_EmmaLessons_da4159dd:

    # "Después de eso se pasan la noche jugando al ajedrez. Sí, ajedrez para tres. Cosas más ridículas se han visto, como un gato en con el logo del desarrollador."
    "Après cela, ils passent la nuit à jouer aux échecs. Oui, aux échecs à trois. Il s'est passé des choses encore plus absurdes, comme un chat portant le logo du développeur."

# game/scripts/c16/c16.rpy:212
translate french c16s001_EmmaLessons_a1700e9d:

    # mcp "(Yo no recuerdo esto así, creo que hicimos algo diferente. Seguro que si pregunto en Discord alguien me lo recuerda. Me estoy cansando de jugar tanto al ajedrez.)"
    mcp "(Je ne m'en souviens pas comme ça ; je crois qu'on a fait quelque chose de différent. Je suis sûr que si je pose la question sur Discord, quelqu'un me le rappellera. J'en ai marre de jouer autant aux échecs.)"

# game/scripts/c16/c16.rpy:215
translate french c16s001_EmmaLessons_da108a7d:

    # emm "Mamá, tienes que ser una fiera besando. Fíjate cómo se ha puesto [mc] con un solo beso."
    emm "Maman, tu dois être une sacrée bonne baiseuse ! Regarde comme il est excité après un seul baiser."

# game/scripts/c16/c16.rpy:216
translate french c16s001_EmmaLessons_1c5cd16e:

    # mc "Besa muy bien, no podrías tener una mejor maestra."
    mc "Elle embrasse très bien, vous ne pourriez pas avoir une meilleure professeure."

# game/scripts/c16/c16.rpy:217
translate french c16s001_EmmaLessons_46831f12:

    # mom "¡No mires! Aunque eso es lo que les pasa a los chicos cuando se les besa bien."
    mom "Ne regarde pas ! C'est pourtant ce qui arrive aux garçons quand ils reçoivent un bon baiser."

# game/scripts/c16/c16.rpy:218
translate french c16s001_EmmaLessons_fcc3c740:

    # mc "Ya la ha visto..."
    mc "Elle l'a déjà vu..."

# game/scripts/c16/c16.rpy:219
translate french c16s001_EmmaLessons_51753740:

    # mom "Bueno, sí, pero no tiene por qué recrearse mirando."
    mom "Oui, mais vous n'êtes pas obligé de vous attarder à regarder."

# game/scripts/c16/c16.rpy:221
translate french c16s001_EmmaLessons_3ccd497a:

    # emm "¡Ahora creo que lo haré mejor! Ya he visto cómo lo hacías y creo que ya sé lo que yo hacía mal."
    emm "Maintenant, je pense que je ferai mieux ! J'ai vu comment tu as fait et je crois savoir où j'ai commis des erreurs."

# game/scripts/c16/c16.rpy:222
translate french c16s001_EmmaLessons_25d9fd46:

    # mc "[emm], mis ojos están aquí..."
    mc "[emm], mes yeux sont ici..."

# game/scripts/c16/c16.rpy:224
translate french c16s001_EmmaLessons_c4dc53e3:

    # emm "Perdón... ¿probamos?"
    emm "Excusez-moi... on essaie ?"

# game/scripts/c16/c16.rpy:225
translate french c16s001_EmmaLessons_de4d03e5:

    # mc "Perfecto."
    mc "Parfait."

# game/scripts/c16/c16.rpy:228
translate french c16s001_EmmaLessons_4373f18b:

    # "El beso de [emm] es mucho mejor que los anteriores, pero muy lejos de sus besos habituales o de cómo te ha besado [mar]."
    "Le baiser de [emm] est bien meilleur que les précédents, mais loin de ses baisers habituels ou de la façon dont [mar] t'a embrassé."

# game/scripts/c16/c16.rpy:230
translate french c16s001_EmmaLessons_b4d6c9f6:

    # "El beso de [emm] es mucho mejor que los anteriores, demostrándole a [mar] que ha aprendido la lección. Una lección que no necesitaba."
    "Le baiser de [emm] est bien meilleur que les précédents, ce qui prouve à [mar] qu'il a retenu la leçon. Une leçon dont il aurait bien pu se passer."

# game/scripts/c16/c16.rpy:231
translate french c16s001_EmmaLessons_fbc288bd:

    # emm "¡Ahora sí que ha ido bien! Ya he entendido qué hacía mal. Gracias, Mamá."
    emm "Voilà ! J'ai enfin compris mon erreur. Merci maman."

# game/scripts/c16/c16.rpy:232
translate french c16s001_EmmaLessons_1841e041:

    # mc "Mucho mejor, desde luego."
    mc "Bien mieux, évidemment."

# game/scripts/c16/c16.rpy:235
translate french c16s001_EmmaLessons_33baaf8c:

    # mom "Ha estado mucho mejor, pero han faltado cosas. Desde aquí parecía que no movías tu lengua dentro de la boca de [mc]. ¿Me equivoco?"
    mom "Ça va beaucoup mieux, mais il manque encore quelque chose. D'ici, on dirait que tu ne bougeais pas ta langue dans la bouche de [mc]. Je me trompe ?"

# game/scripts/c16/c16.rpy:236
translate french c16s001_EmmaLessons_b58eb69c:

    # mc "Bueno, la ha dejado bastante quieta..."
    mc "Eh bien, ça l'a laissée plutôt immobile..."

# game/scripts/c16/c16.rpy:238
translate french c16s001_EmmaLessons_24e55400:

    # mom "A eso es a lo que me refiero, tiene que aprender ella. No puede hacerlo mal con su chico ni esperar que sea él quien lleve la iniciativa."
    mom "C'est bien ce que je veux dire, elle doit apprendre. Elle ne peut pas tout gâcher avec son copain ni s'attendre à ce qu'il prenne l'initiative."

# game/scripts/c16/c16.rpy:240
translate french c16s001_EmmaLessons_87c2898e:

    # emm "En vuestro beso no podía ver qué hacíais con la lengua. Y en los dibujos japoneses tienen la lengua fuera de la boca cuando se besan, pero vosotros lo habéis hecho diferente."
    emm "Je n'arrivais pas à voir ce que vous faisiez avec vos langues pendant votre baiser. Dans les dessins animés japonais, les personnages tirent la langue quand ils s'embrassent, mais vous, vous faisiez différemment."

# game/scripts/c16/c16.rpy:242
translate french c16s001_EmmaLessons_fd4a5a9d:

    # emm "Se me ocurre una idea... ¿por qué no me enseñas tú lo que tengo que hacer con la lengua, Mamá?"
    emm "J'ai une idée… pourquoi ne m'apprends-tu pas quoi faire avec ma langue, maman ?"

# game/scripts/c16/c16.rpy:244
translate french c16s001_EmmaLessons_11a7d59a:

    # mom "{b}¿Qué?{/b} ¿Quieres que {b}yo{/b} te enseñe a besar?"
    mom "{b}Quoi ?{/b} Tu veux que je t’apprenne à embrasser ?"

# game/scripts/c16/c16.rpy:246
translate french c16s001_EmmaLessons_61451ff1:

    # emm "Así sabría lo que tiene que hacer una chica. [mc] me podría enseñar sólo a besar como un chico..."
    emm "Comme ça, je saurais ce qu'une fille est censée faire. Elle pourrait m'apprendre à embrasser comme un garçon..."

# game/scripts/c16/c16.rpy:247
translate french c16s001_EmmaLessons_1753a486:

    # mcp "(Cada vez es más difícil contenerse la risa. Creo que desde que sabe que [mar.mc!t] y yo estamos juntos ha estado buscando algo así.)"
    mcp "(J'ai de plus en plus de mal à retenir mon rire. Je crois que depuis qu'il a découvert que [mar.mc!t] et moi sommes ensemble, il cherchait quelque chose comme ça.)"

# game/scripts/c16/c16.rpy:248
translate french c16s001_EmmaLessons_67ff2bbd:

    # mc "Aunque no creyera que iba a decir esto nunca, la lógica de [emm] es correcta en este caso. *Risa*"
    mc "Même si je n'aurais jamais cru dire ça, le raisonnement de [emm] est correct dans ce cas précis. *Rires*"

# game/scripts/c16/c16.rpy:250
translate french c16s001_EmmaLessons_028c5c97:

    # mom "Tienes razón. Por una vez la lógica de [emm] no tiene fallos."
    mom "Vous avez raison. Pour une fois, la logique de [emm] est irréprochable."

# game/scripts/c16/c16.rpy:252
translate french c16s001_EmmaLessons_bb706933:

    # emm "¡Mamaaaa!"
    emm "Maman!"

# game/scripts/c16/c16.rpy:254
translate french c16s001_EmmaLessons_c087c4da:

    # mom "Sé que me voy a arrepentir de esto, pero ven aquí."
    mom "Je sais que je vais le regretter, mais viens ici."

# game/scripts/c16/c16.rpy:255
translate french c16s001_EmmaLessons_dfa5602a:

    # mom "Sigue los movimientos que haga yo. Que tu lengua no pierda contacto con la mía. Pero no hagas nada brusco..."
    mom "Suivez mes mouvements. Gardez votre langue en contact avec la mienne. Mais ne faites rien de brusque…"

# game/scripts/c16/c16.rpy:256
translate french c16s001_EmmaLessons_30aa2cf9:

    # mom "¿Te acuerdas cuando te enseñé a amasar? Pues algo así, suave pero continuo. No se me ocurre otra forma de describirlo. Mejor te lo demuestro."
    mom "Tu te souviens quand je t'ai appris à pétrir la pâte ? Eh bien, quelque chose comme ça, doucement mais sans interruption. Je ne vois pas d'autre façon de l'expliquer. Je vais te montrer."

# game/scripts/c16/c16.rpy:258
translate french c16s001_EmmaLessons_f801b914:

    # "El beso empieza como algo tierno."
    "Le baiser commence par quelque chose de tendre."

# game/scripts/c16/c16.rpy:260
translate french c16s001_EmmaLessons_4d7ca59d:

    # "Pero parece que [emm] le va pillando el truco... aunque sabes que ya lo domina. Al final, casi te ha hecho pensar que necesitaba las clases."
    "Mais il semblerait que [emm] commence à comprendre… même si tu sais qu'il maîtrise déjà le truc. À la fin, il t'a presque fait croire qu'il avait besoin de cours."

# game/scripts/c16/c16.rpy:262
translate french c16s001_EmmaLessons_dd71f45a:

    # "Poco a poco va haciéndose más apasionado y las manos de ambas empiezan a explorar el cuerpo de la otra."
    "Peu à peu, la passion s'intensifie et leurs mains commencent à explorer les corps de l'autre."

# game/scripts/c16/c16.rpy:264
translate french c16s001_EmmaLessons_28fc7066:

    # "Nunca hubieras imaginado que pudiera ser tan tórrido verlas gemir en la boca de la otra."
    "Vous n'auriez jamais imaginé qu'il puisse être si torride de les voir gémir dans la bouche l'une de l'autre."

# game/scripts/c16/c16.rpy:266
translate french c16s001_EmmaLessons_ff7336c1:

    # "Aunque después de lo que pasó hace un par de días en la piscina, deberías haber aprendido como pueden ser las cosas."
    "Après ce qui s'est passé il y a quelques jours à la piscine, vous auriez dû comprendre comment les choses peuvent se passer."

# game/scripts/c16/c16.rpy:268
translate french c16s001_EmmaLessons_2af27120:

    # mom "*Jadeando* Creo que ya está... ya ha aprendido lo que había que aprender..."
    mom "*Haletant* Je crois que c'est tout... il a appris ce qu'il avait besoin d'apprendre..."

# game/scripts/c16/c16.rpy:269
translate french c16s001_EmmaLessons_9a44d0f1:

    # mom "Ahora que repita el beso contigo aplicando lo que hemos hecho juntas..."
    mom "Maintenant, laissez-la répéter le baiser avec vous, en appliquant ce que nous avons fait ensemble..."

# game/scripts/c16/c16.rpy:271
translate french c16s001_EmmaLessons_9980d60b:

    # "Esta vez [emm] te besa como sabe hacerlo. Después de ver el espectáculo que ambas han dado notas como tu polla podría reventar en cualquier momento."
    "Cette fois, [emm] t'embrasse comme elle seule sait le faire. Après le spectacle que vous avez offert, on dirait que ton sexe pourrait exploser à tout moment."

# game/scripts/c16/c16.rpy:272
translate french c16s001_EmmaLessons_f106d8e8:

    # "Si a eso le sumas que puedes notar el calor que emana de la entrepierna de [emm] a través de la fina tela de su pijama, y que parece que [mar] también se está poniendo cachonda..."
    "Ajoutez à cela le fait que vous pouvez sentir la chaleur émanant de l'entrejambe de [emm] à travers le tissu fin de son pyjama, et que [mar] semble également être excitée..."

# game/scripts/c16/c16.rpy:274
translate french c16s001_EmmaLessons_b51c3e08:

    # emm "¡Wow! Ahora lo entiendo todo. Mamá es una maestra genial. ¿Lo he hecho bien?"
    emm "Waouh ! Maintenant je comprends tout. Maman est une super enseignante. Ai-je bien fait ?"

# game/scripts/c16/c16.rpy:275
translate french c16s001_EmmaLessons_d34bf9b0:

    # mc "Lo has hecho genial ahora, [emm]."
    mc "Tu as fait du très bon travail, [emm]."

# game/scripts/c16/c16.rpy:277
translate french c16s001_EmmaLessons_5335ebc1:

    # emm "¿Lo he hecho bien, Mami?"
    emm "Ai-je bien fait, maman ?"

# game/scripts/c16/c16.rpy:278
translate french c16s001_EmmaLessons_0dd6907a:

    # mom "Sí, muy bien, cielo. Ha sido... muy bonito veros besaros..."
    mom "Oui, très bien, chérie. C'était... très agréable de vous voir vous embrasser..."

# game/scripts/c16/c16.rpy:279
translate french c16s001_EmmaLessons_1d0b762a:

    # emm "¿Tu conejito también tiene calor, Mamá?"
    emm "Ton lapin est canon aussi, maman ?"

# game/scripts/c16/c16.rpy:281
translate french c16s001_EmmaLessons_9c302d47:

    # mom "{b}¿Qué?{/b}"
    mom "{b}Quoi ?{/b}"

# game/scripts/c16/c16.rpy:283
translate french c16s001_EmmaLessons_7d04d5eb:

    # emm "Hace calor en esta habitación. Después de nuestro beso he empezado a notar que mi conejito se ponía caliente y a sudar..."
    emm "Il fait chaud dans cette pièce. Après notre baiser, j'ai commencé à sentir mon sexe devenir chaud et moite..."

# game/scripts/c16/c16.rpy:284
translate french c16s001_EmmaLessons_62b1af2e:

    # emm "Y ahora, con el beso con [mc]... parece que tenga fiebre..."
    emm "Et maintenant, avec ce baiser avec [mc]... il semblerait que j'aie de la fièvre..."

# game/scripts/c16/c16.rpy:286
translate french c16s001_EmmaLessons_d289f7a3:

    # emm "Hace calor en esta habitación. Durante el beso he empezado a notar que mi conejito se ponía caliente y a sudar..."
    emm "Il fait chaud dans cette pièce. Pendant le baiser, j'ai commencé à sentir mon sexe devenir chaud et moite..."

# game/scripts/c16/c16.rpy:287
translate french c16s001_EmmaLessons_3c5d4d43:

    # emm "Veo que el tuyo también está pasando calor, Mamá. Te lo estás tocando..."
    emm "Je vois que le tien chauffe aussi, maman. Tu le touches..."

# game/scripts/c16/c16.rpy:288
translate french c16s001_EmmaLessons_c6b481a3:

    # mc "*Risa* Es cierto que hace calor en esta habitación. Por eso duermo desnudo."
    mc "*Rires* C'est vrai qu'il fait chaud dans cette chambre. C'est pour ça que je dors nu."

# game/scripts/c16/c16.rpy:290
translate french c16s001_EmmaLessons_32411430:

    # mom "¿Qué? ¡No!... Digo... Sí... hace calor en esta habitación... al estar debajo del tejado es la habitación más... caliente... de la casa. ¿Verdad, [mc]?"
    mom "Quoi ? Non !… Enfin… Oui… il fait chaud dans cette pièce… étant sous le toit, c’est la pièce la plus chaude de la maison. Pas vrai ?"

# game/scripts/c16/c16.rpy:292
translate french c16s001_EmmaLessons_c95644e4:

    # mom "¿Qué estás haciendo, [emm]?"
    mom "Que fais-tu, [emm] ?"

# game/scripts/c16/c16.rpy:294
translate french c16s001_EmmaLessons_52c61de2:

    # emm "Desnudarme yo también. Ya has oído a [mc] y lo acabas de reconocer. Hace calor aquí y mi conejito está ardiendo y sudando."
    emm "Je vais me déshabiller aussi. Tu as entendu [mc] et tu viens de l'admettre. Il fait chaud ici et mon lapin a très chaud et transpire."

# game/scripts/c16/c16.rpy:295
translate french c16s001_EmmaLessons_7585f791:

    # mc "*Risa* No me refería a que os tuvierais que desnudar vosotras, [emm]."
    mc "*Rires* Je ne voulais pas dire que tu devais te déshabiller, [emm]."

# game/scripts/c16/c16.rpy:297
translate french c16s001_EmmaLessons_e14db1ea:

    # emm "Y tu zanahoria también está sudando... No sabía que las zanahorias sudaran..."
    emm "Et ta carotte transpire aussi… Je ne savais pas que les carottes transpiraient…"

# game/scripts/c16/c16.rpy:298
translate french c16s001_EmmaLessons_52da6ae5:

    # mc "*Risa* No es sudor, [emm]..."
    mc "*Rires* Ce n'est pas de la transpiration, [emm]..."

# game/scripts/c16/c16.rpy:299
translate french c16s001_EmmaLessons_bbc5f02a:

    # mcp "(Me siento ridículo explicándole cosas que sabe perfectamente, pero quiero ver a dónde quiere llegar con este juego.)"
    mcp "(Je me sens ridicule de lui expliquer des choses qu'il connaît déjà parfaitement, mais je veux voir où il veut aller avec ce jeu.)"

# game/scripts/c16/c16.rpy:300
translate french c16s001_EmmaLessons_ef929c35:

    # mc "Eso es lo que pasa cuando a un chico le besan muy bien."
    mc "Voilà ce qui arrive quand un garçon reçoit un très bon baiser."

# game/scripts/c16/c16.rpy:302
translate french c16s001_EmmaLessons_f6335312:

    # mom "*Mascullando para sí misma* Esto se me está yendo de las manos... no es lo que había pensado..."
    mom "*Marmonnant pour elle-même* Ça dégénère... ce n'est pas ce que je croyais..."

# game/scripts/c16/c16.rpy:303
translate french c16s001_EmmaLessons_82450f63:

    # mom "Bueno, creo que con esto hemos llegado al final de la clase de hoy. Está claro que ya has aprendido a besar. ¡Vístete, [emm]! Nos vamos."
    mom "Voilà, je crois que la leçon d'aujourd'hui est terminée. Tu as clairement appris à embrasser. Habille-toi ! On y va."

# game/scripts/c16/c16.rpy:305
translate french c16s001_EmmaLessons_876cf006:

    # emm "¿Es normal que se ponga tan duro? Parece que tienes una rampa..."
    emm "Est-ce normal que ce soit si dur ? J'ai l'impression d'avoir une crampe..."

# game/scripts/c16/c16.rpy:306
translate french c16s001_EmmaLessons_591e6d63:

    # mc "Sí, es normal. Ya te digo que cuando a un chico le besan tan bien pasan estas cosas."
    mc "Oui, c'est normal. Comme je l'ai dit, quand un homme est aussi bien embrassé, ce genre de choses arrive."

# game/scripts/c16/c16.rpy:307
translate french c16s001_EmmaLessons_1b57a296:

    # emm "Y ¿duele?"
    emm "Et est-ce que ça fait mal ?"

# game/scripts/c16/c16.rpy:308
translate french c16s001_EmmaLessons_a01c24b7:

    # mc "No, ahora mismo no, pero si se pasa así mucho tiempo sin... bueno... si se pasa así mucho tiempo, puede doler un poco, pero más bien lo que duelen los..."
    mc "Non, pas maintenant, mais si ça continue comme ça trop longtemps sans… enfin… si ça continue comme ça trop longtemps, ça risque de faire un peu mal, mais surtout, ça fait mal de…"

# game/scripts/c16/c16.rpy:309
translate french c16s001_EmmaLessons_70b6a02a:

    # emm "¿Los champiñones?"
    emm "Des champignons ?"

# game/scripts/c16/c16.rpy:311
translate french c16s001_EmmaLessons_96c51ef6:

    # mom "{b}¡[emm]!{/b} ¡Deja de tocarle la polla a tu hermano! Vamos a irnos y a dejarle... arreglarlo por él mismo..."
    mom "{b}¡[emm]!{/b} Arrête de toucher la bite de ton frère ! Laissons-le… se débrouiller tout seul…"

# game/scripts/c16/c16.rpy:313
translate french c16s001_EmmaLessons_34e7d4c9:

    # mom "*Susurrando* Lo siento..."
    mom "*Chuchotant* Je suis désolé..."

# game/scripts/c16/c16.rpy:315
translate french c16s001_EmmaLessons_dc63cc5c:

    # emm "Pero Mamá, no podemos irnos y dejar a su zanahoria así y que después le duelan los champiñones."
    emm "Mais maman, on ne peut pas laisser sa carotte comme ça et risquer de lui faire mal aux champignons."

# game/scripts/c16/c16.rpy:316
translate french c16s001_EmmaLessons_2a00da51:

    # emm "¿Hay algo que pueda hacer para solucionarlo? Ya que lo he provocado yo..."
    emm "Puis-je faire quelque chose pour régler ce problème ? Puisque c'est moi qui en suis la cause…"

# game/scripts/c16/c16.rpy:318
translate french c16s001_EmmaLessons_d6aba605:

    # mom "{b}¡[emm]! ¿Qué crees que estás haciendo?{/b}"
    mom "{b}¡[emm]! Qu'est-ce que tu crois faire ?{/b}"

# game/scripts/c16/c16.rpy:320
translate french c16s001_EmmaLessons_3b43825b:

    # emm "Quizás dándole un besito..."
    emm "Peut-être en lui donnant un petit baiser..."

# game/scripts/c16/c16.rpy:322
translate french c16s001_EmmaLessons_d3bd7231:

    # mom "{b}¡[emm]!{/b}"
    mom "{b}¡[emm]!{/b}"

# game/scripts/c16/c16.rpy:324
translate french c16s001_EmmaLessons_527e31ec:

    # emm "¿Qué? Parece que le ha gustado. Ha saltado de alegría en mi mano cuando le he dado un besito... Además se está poniendo más duro aún."
    emm "Quoi ? On dirait que ça lui a plu. Il a sauté de joie dans ma main quand je lui ai fait un petit bisou… Et il est de plus en plus dur."

# game/scripts/c16/c16.rpy:325
translate french c16s001_EmmaLessons_eb6b405d:

    # mc "*Risa* Sí, le ha gustado. Y lo de ponerse más duro es normal cuando le besa una preciosa chica desnuda."
    mc "*Rires* Oui, ça lui a plu. Et avoir une érection, c'est normal quand une belle fille nue l'embrasse."

# game/scripts/c16/c16.rpy:326
translate french c16s001_EmmaLessons_33e23d0a:

    # emm "¿No podemos hacer nada para ayudarle, Mamá?"
    emm "Maman, n'y a-t-il rien que nous puissions faire pour vous aider ?"

# game/scripts/c16/c16.rpy:328
translate french c16s001_EmmaLessons_c080d8d1:

    # mom "*Susurrando* ¿Qué quieres hacer?"
    mom "*Chuchotant* Que veux-tu faire ?"

# game/scripts/c16/c16.rpy:329
translate french c16s001_EmmaLessons_9c718281:

    # mc "*Encogiéndose de hombros* Tú misma, tú has empezado esto de las lecciones..."
    mc "*Haussement d'épaules* C'est toi qui as déclenché tout ça avec les cours..."

# game/scripts/c16/c16.rpy:330
translate french c16s001_EmmaLessons_21ed3390:

    # mom "Vale, quédate donde estás... *Entre dientes* Se me ha ido totalmente de las manos..."
    mom "D'accord, restez où vous êtes... *Entre les dents* La situation a complètement dégénéré..."

# game/scripts/c16/c16.rpy:332
translate french c16s001_EmmaLessons_20f24776:

    # mom "Escúchame, [emm]. Tienes que cogerle la... mira, me niego a llamarle zanahoria... tienes que cogerle la polla rodeándola con los dedos."
    mom "Écoute-moi, [emm]. Tu dois lui attraper... écoute, je refuse de l'appeler carotte... tu dois lui attraper la bite en enroulant tes doigts autour."

# game/scripts/c16/c16.rpy:333
translate french c16s001_EmmaLessons_7efd4c7f:

    # emm "¿Y con eso dejará de dolerle?"
    emm "Et cela fera-t-il cesser la douleur ?"

# game/scripts/c16/c16.rpy:334
translate french c16s001_EmmaLessons_01fc610f:

    # mom "No, tienes que subir y bajar la mano, desde la base hasta la punta... creo que con eso habrá suficiente..."
    mom "Non, il faut déplacer la main de haut en bas, de la base jusqu'au bout... Je pense que ça suffira..."

# game/scripts/c16/c16.rpy:337
translate french c16s001_EmmaLessons_b3b63198:

    # emm "¿Así, Mamá?"
    emm "C'est bien ça, maman ?"

# game/scripts/c16/c16.rpy:338
translate french c16s001_EmmaLessons_41adf945:

    # mom "Exactamente así, [emm]. [mc] te indicará si quiere que hagas más presión o no."
    mom "Exactement comme ça, [emm]. [mc] vous indiquera s'il faut appliquer plus de pression ou non."

# game/scripts/c16/c16.rpy:339
translate french c16s001_EmmaLessons_de09770b:

    # emm "¿Te gusta así, [mc]?"
    emm "Tu aimes ça comme ça, [mc] ?"

# game/scripts/c16/c16.rpy:340
translate french c16s001_EmmaLessons_9ca085f9:

    # mc "Sí, me está gustando mucho, pero puedes hacer un poco más de presión."
    mc "Oui, j'y prends beaucoup de plaisir, mais vous pourriez mettre un peu plus de pression."

# game/scripts/c16/c16.rpy:344
translate french c16s001_EmmaLessons_7e8f800a:

    # emm "Mamá, ¿tu conejito te está dando calor todavía? Como has vuelto a tocártelo..."
    emm "Maman, ton lapin te fait toujours autant d'effet ? Tu l'as encore touché..."

# game/scripts/c16/c16.rpy:345
translate french c16s001_EmmaLessons_a1bfb4c4:

    # mom "A mi conejito le gusta ver como uno de mis hijos le da placer al otro..."
    mom "Mon lapin aime regarder l'un de mes enfants donner du plaisir à l'autre..."

# game/scripts/c16/c16.rpy:347
translate french c16s001_EmmaLessons_3784aad9:

    # mcp "(Cada vez te entiendo más. Me da lo mismo que unos papeles digan que no eres mi madre y que [emm] no es mi hermana.)"
    mcp "(Je te comprends de mieux en mieux. Peu m'importe si certains papiers disent que tu n'es pas ma mère et que [emm] n'est pas ma sœur.)"

