translate french c16s007_NorPregnant_3a6cb102:

    # mc "Vamos a ver el tuyo, a ver si tenemos más suerte."
    mc "Jetons un coup d'œil au vôtre et voyons si nous avons plus de chance."

# game/scripts/c16/c16.rpy:3888
translate french c16s007_NorPregnant_10ce37ee:

    # mc "He venido antes porque no me aguantaba los nervios. Prefería esperar aquí contigo."
    mc "Je suis arrivée plus tôt parce que je ne supportais plus le stress. Je préférais attendre ici avec toi."

