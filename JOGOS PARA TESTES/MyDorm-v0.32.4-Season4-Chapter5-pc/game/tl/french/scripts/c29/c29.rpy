    # kat "{i}(And to check that I didn't dream about yesterday){/i}"
    kat "{i}(Et pour vérifier que je n'ai pas rêvé d'hier){/i}"

# game/scripts/c29/c29.rpy:1657
translate french c29s003_KatKiss_8201f246:

    # kat "Yes, I just came for the hug. I like that everything is back to normal between us."
    kat "Oui, je suis juste venue pour le câlin. J'aime que tout soit redevenu normal entre nous."

# game/scripts/c29/c29.rpy:1658
translate french c29s003_KatKiss_939e2928:

    # mc "You can come back for more as often as you like."
    mc "Tu peux revenir en chercher d'autres aussi souvent que tu le souhaites."

# game/scripts/c29/c29.rpy:1662
translate french c29s003_KatKiss_af0d77cb:

    # kat "*Laugh* I might run the risk of them becoming an addiction."
    kat "*Rires* Je pourrais courir le risque que ça devienne une addiction."

# game/scripts/c29/c29.rpy:1663
translate french c29s003_KatKiss_5c93d575:

    # mc "*Laugh* There's nothing wrong with that."
    mc "*Rires* Il n'y a rien de mal à ça."

# game/scripts/c29/c29.rpy:1664
translate french c29s003_KatKiss_72bb4987:

    # kat "See you later, [mc]."
    kat "À plus tard, [mc]."

# game/scripts/c29/c29.rpy:1665
translate french c29s003_KatKiss_a0a087e8:

    # mc "See you later, [kat]."
    mc "À plus tard, [kat]."

# game/scripts/c29/c29.rpy:1667
translate french c29s003_KatKiss_c7852d20:

    # kat "Oops! Hi, [mar]. I'm going to my room to study. Bye, [mar]."
    kat "Oups ! Salut, [mar]. Je vais dans ma chambre pour étudier. Au revoir, [mar]."

# game/scripts/c29/c29.rpy:1668
translate french c29s003_KatKiss_9fca1351:

    # mom "Hi, [kat]."
    mom "Salut, [kat]."

# game/scripts/c29/c29.rpy:1670
translate french c29s003_KatKiss_ce84636d:

    # mom "Bye, [kat]."
    mom "Au revoir, [kat]."

# game/scripts/c29/c29.rpy:1672
translate french c29s003_KatKiss_66d07510:

    # mom "Is something wrong with her?"
    mom "Il y a un problème avec elle ?"

# game/scripts/c29/c29.rpy:1675
translate french c29s003_KatKiss_39f6b635:

    # mc "*Laugh* She's just discovering the advantages of belonging to the harem."
    mc "*Rire* Elle découvre juste les avantages d'appartenir au harem."

# game/scripts/c29/c29.rpy:1677
translate french c29s003_KatKiss_5718ffbf:

    # mc "*Laugh* She's just discovering the advantages of dating me."
    mc "*Rire* Elle découvre juste les avantages de sortir avec moi."

# game/scripts/c29/c29.rpy:1679
translate french c29s003_KatKiss_5fdbef85:

    # mc "*Laugh* She's just discovering the advantages of being friends again after clearing everything up yesterday."
    mc "*Rire* Elle découvre juste les avantages d'être à nouveau amis après avoir tout mis au clair hier."

# game/scripts/c29/c29.rpy:1681
translate french c29s003_KatKiss_0b1afe7c:

    # mom "Thank goodness you sorted it out. [nor] was starting to get a little hysterical. [kat] couldn't decide what to do or how to do it, and all she did was hide."
    mom "Dieu merci, tu as réglé ça. [nor] commençait à devenir un peu hystérique. [kat] n'arrivait pas à décider quoi faire ni comment le faire, et tout ce qu'elle faisait, c'était se cacher."

# game/scripts/c29/c29.rpy:1682
translate french c29s003_KatKiss_207fa8c2:

    # mc "Well, I think she was entitled to take the time she needed to clear her head. It mustn't have been easy for her."
    mc "Eh bien, je pense qu'elle avait le droit de prendre le temps dont elle avait besoin pour se vider la tête. Ça n'a pas dû être facile pour elle."

# game/scripts/c29/c29.rpy:1685
translate french c29s003_KatKiss_98d9bd42:

    # mom "*Laugh* I know, I'm not criticizing your new girlfriend. I went through the same thing on the day of the costume breakfast."
    mom "*Rire* Je sais, je ne critique pas ta nouvelle petite amie. J'ai traversé la même chose le jour du petit-déjeuner costumé."

# game/scripts/c29/c29.rpy:1687
translate french c29s003_KatKiss_7ec0da26:

    # mom "*Laugh* I know. I went through the same thing on the day of the costume breakfast."
    mom "*Rire* Je sais. J'ai traversé la même chose le jour du petit-déjeuner costumé."

# game/scripts/c29/c29.rpy:1688
translate french c29s003_KatKiss_f397e244:

    # mom "But you didn't give me time to think."
    mom "Mais tu ne m'as pas laissé le temps de réfléchir."

# game/scripts/c29/c29.rpy:1689
translate french c29s003_KatKiss_5a16c9fa:

    # mc "Different people and different circumstances."
    mc "Des personnes différentes et des circonstances différentes."

# game/scripts/c29/c29.rpy:1691
translate french c29s003_KatKiss_0d599a88:

    # mc "Do you regret that I didn't let you think?"
    mc "Tu regrettes que je ne t'aie pas laissée réfléchir ?"

# game/scripts/c29/c29.rpy:1694
translate french c29s003_KatKiss_43210a07:

    # mom "I don't regret anything that has happened between us since you arrived."
    mom "Je ne regrette rien de ce qui s'est passé entre nous depuis ton arrivée."

# game/scripts/c29/c29.rpy:1695
translate french c29s003_KatKiss_535e9e2c:

    # mom "Thanks to that, I am now your wife. Not officially, but your wife, after all."
    mom "Grâce à ça, je suis maintenant ta femme. Pas officiellement, mais ta femme, après tout."

# game/scripts/c29/c29.rpy:1697
translate french c29s003_KatKiss_6ab909f7:

    # mom "Besides, I think I'm the first one you've called wife, which makes me feel even more special."
    mom "En plus, je crois que je suis la première que tu as appelée ta femme, ce qui me fait me sentir encore plus spéciale."

# game/scripts/c29/c29.rpy:1698
translate french c29s003_KatKiss_02e0f225:

    # mc "You were the first, and so far the last one I've called that. For me, it was natural."
    mc "Tu as été la première, et jusqu'à présent la dernière que j'ai appelée comme ça. Pour moi, c'était naturel."

# game/scripts/c29/c29.rpy:1699
translate french c29s003_KatKiss_841914fb:

    # mc "And you know I don't care if it's official or not, right?"
    mc "Et tu sais que je m'en fous que ce soit officiel ou pas, n'est-ce pas ?"

# game/scripts/c29/c29.rpy:1701
translate french c29s003_KatKiss_26708cd4:

    # mom "I know, and that makes me even happier."
    mom "Je sais, et ça me rend encore plus heureuse."

# game/scripts/c29/c29.rpy:1702
translate french c29s003_KatKiss_452f7b21:

    # mom "But don't keep going down that road or I'll have to take you to the bedroom right now, and I've made plans with [sam.nick] and [meg]."
    mom "Mais ne continue pas sur cette voie ou je vais devoir t'emmener dans la chambre tout de suite, et j'ai prévu des trucs avec [sam.nick] et [meg]."

# game/scripts/c29/c29.rpy:1705
translate french c29s003_KatKiss_103a66d9:

    # mom "I know. Each of us is different."
    mom "Je sais. Chacune de nous est différente."

# game/scripts/c29/c29.rpy:1706
translate french c29s003_KatKiss_4c79d54a:

    # mom "I'm meeting [sam.nick] and [meg] downtown today."
    mom "Je rejoins [sam.nick] et [meg] en ville aujourd'hui."

# game/scripts/c29/c29.rpy:1707
translate french c29s003_KatKiss_4e68ae81:

    # mom "I never could have imagined that two people so different could become my friends, and friends with each other."
    mom "Je n'aurais jamais pu imaginer que deux personnes aussi différentes puissent devenir mes amies, et amies entre elles."

# game/scripts/c29/c29.rpy:1708
translate french c29s003_KatKiss_4f25efdf:

    # mc "What are you going to do? Are you meeting for lunch?"
    mc "Qu'est-ce que vous allez faire ? Vous vous retrouvez pour déjeuner ?"

# game/scripts/c29/c29.rpy:1710
translate french c29s003_KatKiss_2c708908:

    # mom "Yes, we're going to have lunch, and we want to go look at some things. Maybe buy some clothes and other stuff."
    mom "Oui, on va déjeuner, et on veut aller regarder quelques trucs. Peut-être acheter des vêtements et d'autres choses."

# game/scripts/c29/c29.rpy:1711
translate french c29s003_KatKiss_ca30266c:

    # mom "[nor] is taking care of lunch today. I've been helping her prepare some things."
    mom "[nor] s'occupe du déjeuner aujourd'hui. Je l'ai aidée à préparer quelques trucs."

# game/scripts/c29/c29.rpy:1714
translate french c29s003_KatKiss_1d4ce990:

    # mom "I've already prepared the basket for your picnic with [kim] and it's in her fridge. This fridge is always completely full."
    mom "J'ai déjà préparé le panier pour ton pique-nique avec [kim] et il est dans son frigo. Ce frigo est toujours plein à craquer."

# game/scripts/c29/c29.rpy:1716
translate french c29s003_KatKiss_029dd635:

    # mc "Thanks, Mom. With so many girls living at home and those who stay over, the fridge is getting small."
    mc "Merci, Maman. Avec autant de filles qui vivent à la maison et celles qui restent dormir, le frigo devient petit."

# game/scripts/c29/c29.rpy:1718
translate french c29s003_KatKiss_406f9f55:

    # mc "Thanks, [mar]. With so many girls living at home and those who stay over, the fridge is getting small."
    mc "Merci, [mar]. Avec autant de filles qui vivent à la maison et celles qui restent dormir, le frigo devient petit."

# game/scripts/c29/c29.rpy:1721
translate french c29s003_KatKiss_11955644:

    # mom "This fridge is completely full, and I brought her some things to keep there."
    mom "Ce frigo est complètement plein, et je lui ai apporté quelques trucs à garder là-dedans."

# game/scripts/c29/c29.rpy:1722
translate french c29s003_KatKiss_ff7abfc5:

    # mc "With so many girls living at home and those who stay over, the fridge is getting small."
    mc "Avec autant de filles qui vivent à la maison et celles qui restent dormir, le frigo devient petit."

# game/scripts/c29/c29.rpy:1723
translate french c29s003_KatKiss_46060d94:

    # mc "We should buy one for the basement. And the same thing will happen at [nor]'s house in a month, when the new girls arrive."
    mc "On devrait en acheter un pour le sous-sol. Et la même chose va se passer chez [nor] dans un mois, quand les nouvelles filles arriveront."

# game/scripts/c29/c29.rpy:1725
translate french c29s003_KatKiss_ac86ebad:

    # mom "I think that would be a good idea. Now I have to go. I want to change my shirt, and [meg] must be waiting for me at the garage door."
    mom "Je pense que ce serait une bonne idée. Maintenant je dois y aller. Je veux changer de chemise, et [meg] doit m'attendre à la porte du garage."

# game/scripts/c29/c29.rpy:1726
translate french c29s003_KatKiss_1a4a1819:

    # mc "Aren't you going in her car? Is your battery charged?"
    mc "Vous n'y allez pas avec sa voiture ? Ta batterie est chargée ?"

# game/scripts/c29/c29.rpy:1727
translate french c29s003_KatKiss_ddec9179:

    # mom "It's incredibly difficult for her to pull it in and out, so we'll go in mine. And yes, the battery is charged."
    mom "C'est incroyablement difficile pour elle de la rentrer et de la sortir, alors on va prendre la mienne. Et oui, la batterie est chargée."

# game/scripts/c29/c29.rpy:1731
translate french c29s003_KatKiss_8b51e9f4:

    # mom "See you later."
    mom "À plus tard."

# game/scripts/c29/c29.rpy:1732
translate french c29s003_KatKiss_5e437787:

    # mc "Have fun at lunch and shopping."
    mc "Amusez-vous bien au déjeuner et pour le shopping."

# game/scripts/c29/c29.rpy:1746
translate french c29s003_KimPicnic_6cf35a58:

    # "When it gets close to lunchtime, you go to [nor]'s kitchen for the picnic supplies and drive to the campus."
    "Quand l'heure du déjeuner approche, tu vas dans la cuisine de [nor] pour prendre les affaires de pique-nique et tu conduis jusqu'au campus."

# game/scripts/c29/c29.rpy:1748
translate french c29s003_KimPicnic_760b91a0:

    # "You head to the university's garden area. It feels strange to be practically the only man on campus who doesn't work there."
    "Tu te diriges vers les jardins de l'université. Ça fait bizarre d'être pratiquement le seul mec sur le campus qui n'y travaille pas."

# game/scripts/c29/c29.rpy:1749
translate french c29s003_KimPicnic_8487764f:

    # "Since it's summer, you expected there to be more guys visiting their girlfriends to enjoy the sunny day, but you've only seen a couple of them."
    "Comme c'est l'été, tu t'attendais à voir plus de mecs rendre visite à leurs copines pour profiter de la journée ensoleillée, mais tu n'en as vu que quelques-uns."

# game/scripts/c29/c29.rpy:1751
translate french c29s003_KimPicnic_2330e931:

    # "When you arrive at the area where you were meeting [kim], you see her sitting on a bench, waiting for you while reading a book."
    "Quand tu arrives à l'endroit où tu devais retrouver [kim], tu la vois assise sur un banc, t'attendant tout en lisant un livre."

# game/scripts/c29/c29.rpy:1752
translate french c29s003_KimPicnic_0c28f627:

    # "You both arrived before the agreed time. You both are eager to spend time together."
    "Vous êtes tous les deux arrivés avant l'heure convenue. Vous avez tous les deux hâte de passer du temps ensemble."

# game/scripts/c29/c29.rpy:1754
translate french c29s003_KimPicnic_903c5f2f:

    # "You approach without her noticing your presence."
    "Tu t'approches sans qu'elle remarque ta présence."

# game/scripts/c29/c29.rpy:1755
translate french c29s003_KimPicnic_86f16256:

    # mc "Boo."
    mc "Bouh."

# game/scripts/c29/c29.rpy:1757
translate french c29s003_KimPicnic_a6666380:

    # kim "*Laugh* You didn't scare me. I saw your feet... just before you said 'Boo'. And the book was NOT about to fall."
    kim "*Rires* Tu ne m'as pas fait peur. J'ai vu tes pieds... juste avant que tu dises 'Bouh'. Et le livre n'était PAS sur le point de tomber."

# game/scripts/c29/c29.rpy:1758
translate french c29s003_KimPicnic_82fd791c:

    # mc "*Laugh* It wasn't my intention to scare you or make the book fly away. Ready to have lunch?"
    mc "*Rires* Ce n'était pas mon intention de te faire peur ou de faire voler le livre. Prête pour le déjeuner ?"

# game/scripts/c29/c29.rpy:1761
translate french c29s003_KimPicnic_44f1abc0:

    # kim "Now I am. Come on, I found a cool spot for us to have the picnic."
    kim "Maintenant je le suis. Allez, j'ai trouvé un coin sympa pour qu'on fasse le pique-nique."

# game/scripts/c29/c29.rpy:1762
translate french c29s003_KimPicnic_e87cf047:

    # mc "Do you know I was mad at this university when I was in high school?"
    mc "Tu sais que j'étais en colère contre cette université quand j'étais au lycée ?"

# game/scripts/c29/c29.rpy:1764
translate french c29s003_KimPicnic_2662c006:

    # kim "Why? Your dad worked here..."
    kim "Pourquoi ? Ton père travaillait ici..."

# game/scripts/c29/c29.rpy:1765
translate french c29s003_KimPicnic_5ca3f87a:

    # mc "*Laugh* It was nothing to do with my dad. You spend your whole life watching movies about college students lying on the grass studying."
    mc "*Rire* Ça n'avait rien à voir avec mon père. Tu passes toute ta vie à regarder des films sur des étudiants allongés dans l'herbe en train d'étudier."

# game/scripts/c29/c29.rpy:1766
translate french c29s003_KimPicnic_f6f4508a:

    # mc "And the university next to your house is only for girls, and you end up going to Portland. It's not the best climate for lying on the grass."
    mc "Et l'université à côté de chez toi est réservée aux filles, et tu finis par aller à Portland. Ce n'est pas le meilleur climat pour s'allonger dans l'herbe."

# game/scripts/c29/c29.rpy:1768
translate french c29s003_KimPicnic_6a44ac31:

    # kim "I get it. I wanted to study in Cleveland, but I ended up even further north than you. And colder."
    kim "Je comprends. Je voulais étudier à Cleveland, mais j'ai fini encore plus au nord que toi. Et il y faisait plus froid."

# game/scripts/c29/c29.rpy:1769
translate french c29s003_KimPicnic_8b8ea7e3:

    # mc "*Laugh* That's right, you came from Bellingham."
    mc "*Rire* C'est vrai, tu viens de Bellingham."

# game/scripts/c29/c29.rpy:1770
translate french c29s003_KimPicnic_e13b6718:

    # kim "Yeah. It's really cold there."
    kim "Ouais. Il y fait vraiment froid."

# game/scripts/c29/c29.rpy:1772
translate french c29s003_KimPicnic_f055bbbf:

    # kim "But if you hadn't gone to Portland, you wouldn't have met [sai], and you wouldn't have had your open relationship."
    kim "Mais si tu n'étais pas allé à Portland, tu n'aurais pas rencontré [sai], et tu n'aurais pas eu votre relation libre."

# game/scripts/c29/c29.rpy:1774
translate french c29s003_KimPicnic_05c4883e:

    # kim "And without that, it's highly likely there wouldn't be a harem, and we wouldn't be together."
    kim "Et sans ça, il est fort probable qu'il n'y aurait pas de harem, et on ne serait pas ensemble."

# game/scripts/c29/c29.rpy:1775
translate french c29s003_KimPicnic_ad6de255:

    # mc "Looking at it that way, I have to be grateful that this university is only for girls."
    mc "Vu comme ça, je dois être reconnaissant que cette université soit réservée aux filles."

# game/scripts/c29/c29.rpy:1776
translate french c29s003_KimPicnic_0f9d3c77:

    # mc "*Laugh* All it took was starting to date one of the students to be able to lie down on the grass."
    mc "*Rires* Il a suffi de commencer à sortir avec l'une des étudiantes pour pouvoir s'allonger sur l'herbe."

# game/scripts/c29/c29.rpy:1779
translate french c29s003_KimPicnic_b21225dc:

    # kim "*Laugh* Only one?"
    kim "*Rires* Seulement une ?"

# game/scripts/c29/c29.rpy:1780
translate french c29s003_KimPicnic_477f0758:

    # mc "Only one that matters right now."
    mc "La seule qui compte en ce moment."

# game/scripts/c29/c29.rpy:1782
translate french c29s003_KimPicnic_c00114a9:

    # kim "Are you always going to try to make me feel special?"
    kim "Tu vas toujours essayer de me faire me sentir spéciale ?"

# game/scripts/c29/c29.rpy:1783
translate french c29s003_KimPicnic_cc2e3c0d:

    # mc "The day I stop trying, let me know. And if I stop succeeding, you should tell me that too."
    mc "Le jour où j'arrête d'essayer, dis-le-moi. Et si je n'y arrive plus, tu devrais me le dire aussi."

# game/scripts/c29/c29.rpy:1784
translate french c29s003_KimPicnic_d9a9141d:

    # mc "Trying something and succeeding don't always go hand in hand."
    mc "Essayer quelque chose et y arriver ne vont pas toujours de pair."

# game/scripts/c29/c29.rpy:1786
translate french c29s003_KimPicnic_b1479b6b:

    # kim "Let me pack up the stuff and we'll go."
    kim "Laisse-moi ranger les affaires et on y va."

# game/scripts/c29/c29.rpy:1787
translate french c29s003_KimPicnic_6098eddb:

    # mc "Can I help you?"
    mc "Je peux t'aider ?"

# game/scripts/c29/c29.rpy:1788
translate french c29s003_KimPicnic_d9dd32a1:

    # kim "No need. I'm not even going to ask you to carry my backpack."
    kim "Pas la peine. Je ne vais même pas te demander de porter mon sac à dos."

# game/scripts/c29/c29.rpy:1790
translate french c29s003_KimPicnic_1a642686:

    # kim "By the way, there are many more things you can do besides lying on the grass."
    kim "Au fait, il y a bien d'autres choses que tu peux faire à part t'allonger sur l'herbe."

# game/scripts/c29/c29.rpy:1791
translate french c29s003_KimPicnic_8da74567:

    # mc "And this is one of the things I like the most."
    mc "Et c'est l'une des choses que j'aime le plus."

# game/scripts/c29/c29.rpy:1794
translate french c29s003_KimPicnic_6a769cca:

    # "Once you arrive at the spot chosen by [kim] and spread out the blanket..."
    "Une fois arrivé à l'endroit choisi par [kim] et après avoir étalé la couverture..."

# game/scripts/c29/c29.rpy:1795
translate french c29s003_KimPicnic_d2e04a56:

    # kim "Well, we're here. What did [mar] prepare? I'm starving!"
    kim "Bon, on y est. Qu'est-ce que [mar] a préparé ? Je meurs de faim !"

# game/scripts/c29/c29.rpy:1796
translate french c29s003_KimPicnic_cf50d2ac:

    # mc "To be honest, I haven't looked. I grabbed the basket and came straight here."
    mc "Pour être honnête, je n'ai pas regardé. J'ai pris le panier et je suis venu directement ici."

# game/scripts/c29/c29.rpy:1798
translate french c29s003_KimPicnic_c00b21c6:

    # "[kim] reaches for the food basket and interrupts the gesture halfway through with a small spasm."
    "[kim] tend la main vers le panier de nourriture et s'interrompt à mi-chemin avec un petit spasme."

# game/scripts/c29/c29.rpy:1799
translate french c29s003_KimPicnic_28d30388:

    # mc "Is something wrong, [kim]?"
    mc "Quelque chose ne va pas, [kim] ?"

# game/scripts/c29/c29.rpy:1801
translate french c29s003_KimPicnic_aa296d48:

    # kim "After... what we did yesterday... I feel a little pain depending on the movement I make."
    kim "Après... ce qu'on a fait hier... je ressens une petite douleur selon le mouvement que je fais."

# game/scripts/c29/c29.rpy:1802
translate french c29s003_KimPicnic_b1cbf0d6:

    # kim "When I stretched toward the basket, I got a small pain in... the lower part of my stomach."
    kim "Quand je me suis étirée vers le panier, j'ai eu une petite douleur dans... le bas du ventre."

# game/scripts/c29/c29.rpy:1803
translate french c29s003_KimPicnic_0423d5b0:

    # mc "Does it hurt a lot? You said a little pain, but..."
    mc "Ça fait très mal ? Tu as dit une petite douleur, mais..."

# game/scripts/c29/c29.rpy:1805
translate french c29s003_KimPicnic_9b3df548:

    # kim "But my face said it wasn't little, right?"
    kim "Mais mon visage disait que ce n'était pas si petit, c'est ça ?"

# game/scripts/c29/c29.rpy:1806
translate french c29s003_KimPicnic_65f9676b:

    # mc "Yeah..."
    mc "Ouais..."

# game/scripts/c29/c29.rpy:1807
translate french c29s003_KimPicnic_1616aef4:

    # kim "[kat] told me the same thing this morning, while I was getting dressed for class. [sai] told me it will disappear today or tomorrow."
    kim "[kat] m'a dit la même chose ce matin, pendant que je m'habillais pour les cours. [sai] m'a dit que ça disparaîtrait aujourd'hui ou demain."

# game/scripts/c29/c29.rpy:1808
translate french c29s003_KimPicnic_c298d430:

    # mc "I hope it's today instead of tomorrow."
    mc "J'espère que ce sera aujourd'hui plutôt que demain."

# game/scripts/c29/c29.rpy:1810
translate french c29s003_KimPicnic_f6aa170d:

    # kim "Me too. Every time I get a sharp pain, it's a little less painful than the last one, but it still hurts."
    kim "Moi aussi. À chaque fois que je ressens une douleur aiguë, c'est un peu moins douloureux que la précédente, mais ça fait toujours mal."

# game/scripts/c29/c29.rpy:1811
translate french c29s003_KimPicnic_7a2f7317:

    # mc "I'm sorry..."
    mc "Je suis désolé..."

# game/scripts/c29/c29.rpy:1813
translate french c29s003_KimPicnic_5d30dac8:

    # kim "You don't have to be sorry. We did it together because we both wanted it."
    kim "Tu n'as pas à être désolé. On l'a fait ensemble parce qu'on en avait tous les deux envie."

# game/scripts/c29/c29.rpy:1814
translate french c29s003_KimPicnic_ee1bd4ba:

    # mc "I know, but it sucks that you have to be suffering for a day or two because of it."
    mc "Je sais, mais ça fait chier que tu doives souffrir pendant un jour ou deux à cause de ça."

# game/scripts/c29/c29.rpy:1816
translate french c29s003_KimPicnic_13af9aa4:

    # kim "At least [sai] says it only happens once."
    kim "Au moins, [sai] dit que ça n'arrive qu'une fois."

# game/scripts/c29/c29.rpy:1817
translate french c29s003_KimPicnic_d6920920:

    # mc "*Laugh* If it happened every time, I think humanity would go extinct due to lack of sex."
    mc "*Rires* Si ça arrivait à chaque fois, je pense que l'humanité s'éteindrait par manque de sexe."

# game/scripts/c29/c29.rpy:1819
translate french c29s003_KimPicnic_9b0c55c6:

    # kim "*Laugh* Don't think so. If this is the price to pay for yesterday, I think I'd pay it every time."
    kim "*Rires* Je ne pense pas. Si c'est le prix à payer pour hier, je crois que je le paierais à chaque fois."

# game/scripts/c29/c29.rpy:1820
translate french c29s003_KimPicnic_c328fa8f:

    # mc "It's better if you don't have to pay it. But you said you were hungry. Shall we eat?"
    mc "C'est mieux si tu n'as pas à le payer. Mais tu as dit que tu avais faim. On mange ?"

# game/scripts/c29/c29.rpy:1821
translate french c29s003_KimPicnic_323daddf:

    # kim "*Laugh* Yes, please. You don't want to see me hungry and sore at the same time. I can be a little cranky."
    kim "*Rires* Oui, s'il te plaît. Tu n'as pas envie de me voir affamée et endolorie en même temps. Je peux être un peu grincheuse."

# game/scripts/c29/c29.rpy:1823
translate french c29s003_KimPicnic_6d3cda26:

    # "You eat amidst laughter and jokes. The meal is interrupted by kisses from time to time."
    "Vous mangez au milieu des rires et des blagues. Le repas est interrompu par des baisers de temps en temps."

# game/scripts/c29/c29.rpy:1824
translate french c29s003_KimPicnic_7ce1b4a2:

    # "It's not the kind of picnic you remembered, but you wouldn't trade it for the ones you had when you were a child."
    "Ce n'est pas le genre de pique-nique dont tu te souvenais, mais tu ne l'échangerais pas contre ceux que tu faisais quand tu étais enfant."

# game/scripts/c29/c29.rpy:1825
translate french c29s003_KimPicnic_ef63521a:

    # "For a moment you imagine this kind of picnic with Jamaal. Disgusting."
    "Pendant un instant, tu imagines ce genre de pique-nique avec Jamaal. Dégoûtant."

# game/scripts/c29/c29.rpy:1826
translate french c29s003_KimPicnic_a4bc74d9:

    # "In the mental image, his wheelchair is resting on your legs."
    "Dans cette image mentale, son fauteuil roulant repose sur tes jambes."

# game/scripts/c29/c29.rpy:1829
translate french c29s003_KimPicnic_f3d76e69:

    # "After you finish eating..."
    "Après avoir fini de manger..."

# game/scripts/c29/c29.rpy:1830
translate french c29s003_KimPicnic_d5592caf:

    # kim "I think that was the best picnic of my life."
    kim "Je crois que c'était le meilleur pique-nique de ma vie."

# game/scripts/c29/c29.rpy:1831
translate french c29s003_KimPicnic_bb78a173:

    # mc "I think we can repeat it, but it's not over yet."
    mc "Je pense qu'on pourra remettre ça, mais ce n'est pas encore fini."

# game/scripts/c29/c29.rpy:1833
translate french c29s003_KimPicnic_1a8cb8cd:

    # kim "What do you want to do now?"
    kim "Qu'est-ce que tu veux faire maintenant ?"

# game/scripts/c29/c29.rpy:1834
translate french c29s003_KimPicnic_4734d9f3:

    # mc "I'd like to stay like this for a while. The view of those eyes is incredible."
    mc "J'aimerais rester comme ça un moment. La vue de ces yeux est incroyable."

# game/scripts/c29/c29.rpy:1835
translate french c29s003_KimPicnic_979338d3:

    # mc "And this is usually the time for transcendental post-lunch conversations. *Laugh*"
    mc "Et c'est généralement le moment des conversations transcendantales d'après-repas. *Rires*"

# game/scripts/c29/c29.rpy:1837
translate french c29s003_KimPicnic_0cad5588:

    # kim "I like the part about staying like this, but I don't think I'm someone who goes in for transcendental conversations. *Laugh* I'm a model."
    kim "J'aime bien l'idée de rester comme ça, mais je ne pense pas être le genre de personne à avoir des conversations transcendantales. *Rires* Je suis mannequin."

# game/scripts/c29/c29.rpy:1838
translate french c29s003_KimPicnic_65eb5909:

    # mc "*Laugh* We can just stay silent like this, then."
    mc "*Rires* On peut juste rester en silence comme ça, alors."

# game/scripts/c29/c29.rpy:1841
translate french c29s003_KimPicnic_d798c77f:

    # "The silence lasts less than a minute."
    "Le silence dure moins d'une minute."

# game/scripts/c29/c29.rpy:1842
translate french c29s003_KimPicnic_dc9b912a:

    # kim "I'm really glad you sorted things out with [kat]."
    kim "Je suis vraiment contente que tu aies arrangé les choses avec [kat]."

# game/scripts/c29/c29.rpy:1843
translate french c29s003_KimPicnic_3e225a4f:

    # mc "Me too. The situation was getting awkward."
    mc "Moi aussi. La situation devenait gênante."

# game/scripts/c29/c29.rpy:1845
translate french c29s003_KimPicnic_3479484c:

    # kim "Last night, she was back to her old self for the first time in days."
    kim "Hier soir, elle est redevenue elle-même pour la première fois depuis des jours."

# game/scripts/c29/c29.rpy:1847
translate french c29s003_KimPicnic_d0365222:

    # mc "Her situation was complicated. She was seeing things that weren't there, both on her part and mine."
    mc "Sa situation était compliquée. Elle voyait des choses qui n'existaient pas, que ce soit de son côté ou du mien."

# game/scripts/c29/c29.rpy:1848
translate french c29s003_KimPicnic_8762efa4:

    # mc "I'm glad I cleared things up with her. Now we can go back to being friends."
    mc "Je suis content d'avoir mis les choses au clair avec elle. Maintenant, on peut redevenir amis."

# game/scripts/c29/c29.rpy:1849
translate french c29s003_KimPicnic_d151b96f:

    # mc "But let's not talk about [kat] during our first meal together."
    mc "Mais ne parlons pas de [kat] pendant notre premier repas ensemble."

# game/scripts/c29/c29.rpy:1851
translate french c29s003_KimPicnic_a0b5ecd3:

    # mc "Her situation was complicated. I'm glad it's resolved."
    mc "Sa situation était compliquée. Je suis content que ce soit résolu."

# game/scripts/c29/c29.rpy:1853
translate french c29s003_KimPicnic_db5e618b:

    # kim "You should have seen her last night. She was thrilled. *Laugh* But you were a bit of a jerk."
    kim "Tu aurais dû la voir hier soir. Elle était aux anges. *Rires* Mais tu as été un peu salaud."

# game/scripts/c29/c29.rpy:1854
translate french c29s003_KimPicnic_0a75022a:

    # mc "Why? What did I do?"
    mc "Pourquoi ? Qu'est-ce que j'ai fait ?"

# game/scripts/c29/c29.rpy:1856
translate french c29s003_KimPicnic_0ad182f4:

    # kim "*Laugh* When you told her you were sorry that the universe she was talking about wasn't ours..."
    kim "*Rires* Quand tu lui as dit que tu étais désolé que l'univers dont elle parlait ne soit pas le nôtre..."

# game/scripts/c29/c29.rpy:1857
translate french c29s003_KimPicnic_581f5c49:

    # kim "From what she told me, she felt like sticking her head underwater and never coming back up."
    kim "D'après ce qu'elle m'a dit, elle avait envie de se plonger la tête sous l'eau et de ne jamais remonter."

# game/scripts/c29/c29.rpy:1858
translate french c29s003_KimPicnic_49cd90be:

    # mc "*Laugh* Good thing she didn't."
    mc "*Rires* Heureusement qu'elle ne l'a pas fait."

# game/scripts/c29/c29.rpy:1859
translate french c29s003_KimPicnic_1a539426:

    # mc "But I'm glad she's as excited as I am."
    mc "Mais je suis content qu'elle soit aussi excitée que moi."

# game/scripts/c29/c29.rpy:1861
translate french c29s003_KimPicnic_c26ff61d:

    # kim "I think she's even more excited. Yesterday she kept asking me things..."
    kim "Je crois qu'elle l'est encore plus. Hier, elle n'arrêtait pas de me poser des questions..."

# game/scripts/c29/c29.rpy:1862
translate french c29s003_KimPicnic_b225d9fa:

    # mc "About what you and I did before I went down to the pool?"
    mc "Sur ce qu'on a fait tous les deux avant que je descende à la piscine ?"

# game/scripts/c29/c29.rpy:1864
translate french c29s003_KimPicnic_b5583109:

    # kim "About that too, but I didn't give her details. What happened in that room is ours. Yours and mine."
    kim "Sur ça aussi, mais je ne lui ai pas donné de détails. Ce qui s'est passé dans cette chambre est à nous. À toi et à moi."

# game/scripts/c29/c29.rpy:1865
translate french c29s003_KimPicnic_bdc8f0c4:

    # kim "Maybe someday I'll talk about it, but for now, I prefer to keep it to myself."
    kim "Peut-être qu'un jour j'en parlerai, mais pour l'instant, je préfère garder ça pour moi."

# game/scripts/c29/c29.rpy:1866
translate french c29s003_KimPicnic_f310a217:

    # mc "That makes sense. But then, what was she asking you about?"
    mc "C'est logique. Mais alors, sur quoi elle te posait des questions ?"

# game/scripts/c29/c29.rpy:1868
translate french c29s003_KimPicnic_88e693d3:

    # kim "A bunch of things."
    kim "Plein de choses."

# game/scripts/c29/c29.rpy:1869
translate french c29s003_KimPicnic_75f93fd4:

    # kim "If she could kiss you whenever she wanted in front of the other girls or [mar]..."
    kim "Si elle pouvait t'embrasser quand elle le voulait devant les autres filles ou [mar]..."

# game/scripts/c29/c29.rpy:1870
translate french c29s003_KimPicnic_6e12326f:

    # kim "If she always had to wear makeup and dress nicely or if she could keep wearing her own clothes..."
    kim "Si elle devait toujours se maquiller et bien s'habiller ou si elle pouvait continuer à porter ses propres vêtements..."

# game/scripts/c29/c29.rpy:1872
translate french c29s003_KimPicnic_33f1d64e:

    # kim "If she had to behave differently around me..."
    kim "Si elle devait se comporter différemment avec moi..."

# game/scripts/c29/c29.rpy:1874
translate french c29s003_KimPicnic_751db79c:

    # kim "If she had to behave differently around the girls in the harem..."
    kim "Si elle devait se comporter différemment avec les filles du harem..."

# game/scripts/c29/c29.rpy:1875
translate french c29s003_KimPicnic_75affc1e:

    # mc "I don't get it. I'm not the first person she's dated."
    mc "Je ne comprends pas. Je ne suis pas la première personne avec qui elle sort."

# game/scripts/c29/c29.rpy:1877
translate french c29s003_KimPicnic_b3bd934d:

    # kim "But you are the first person she's dating and living with."
    kim "Mais tu es la première personne avec qui elle sort et avec qui elle vit."

# game/scripts/c29/c29.rpy:1878
translate french c29s003_KimPicnic_7644cc2b:

    # kim "It's not the same when you only see your partner when you meet up with them, as opposed to running into them right after you wake up, still without your hair done."
    kim "Ce n'est pas la même chose quand tu ne vois ton partenaire que lors de vos rendez-vous, par rapport au fait de tomber sur lui juste après ton réveil, pas encore coiffée."

# game/scripts/c29/c29.rpy:1879
translate french c29s003_KimPicnic_61b3af13:

    # mc "*Laugh* Don't you brush your hair as soon as you wake up?"
    mc "*Rires* Tu ne te brosses pas les cheveux dès que tu te réveilles ?"

# game/scripts/c29/c29.rpy:1881
translate french c29s003_KimPicnic_94403679:

    # kim "*Laugh* I comb my hair after showering. And we might cross paths while I go from my room to the shower."
    kim "*Rires* Je me peigne après la douche. Et on pourrait se croiser pendant que je vais de ma chambre à la douche."

# game/scripts/c29/c29.rpy:1882
translate french c29s003_KimPicnic_ca218cf1:

    # kim "It doesn't worry me too much, just like I don't mind you seeing me without makeup, but it was one of the questions [kat] asked me."
    kim "Ça ne m'inquiète pas trop, tout comme ça ne me dérange pas que tu me voies sans maquillage, mais c'était l'une des questions que [kat] m'a posées."

# game/scripts/c29/c29.rpy:1883
translate french c29s003_KimPicnic_a5e28ff0:

    # mc "*Laugh* I sometimes go down for breakfast without brushing my hair."
    mc "*Rires* Parfois, je descends prendre le petit-déjeuner sans me brosser les cheveux."

# game/scripts/c29/c29.rpy:1884
translate french c29s003_KimPicnic_5c0a4d2c:

    # mc "But we're talking a lot about [kat] and very little about us."
    mc "Mais on parle beaucoup de [kat] et très peu de nous."

# game/scripts/c29/c29.rpy:1885
translate french c29s003_KimPicnic_6d33c123:

    # mc "You never explained to me why a model studies Economics."
    mc "Tu ne m'as jamais expliqué pourquoi un mannequin étudie l'économie."

# game/scripts/c29/c29.rpy:1887
translate french c29s003_KimPicnic_c7510bd8:

    # kim "*Laugh* To have a reliable job when I break both my ankles while modeling."
    kim "*Rire* Pour avoir un boulot stable quand je me briserai les deux chevilles en défilant."

# game/scripts/c29/c29.rpy:1888
translate french c29s003_KimPicnic_57c7068f:

    # kim "*Laugh* Sometimes it's scary getting up on a runway and seeing the massive fall I could take."
    kim "*Rire* Parfois, ça fait peur de monter sur un podium et de voir la chute énorme que je pourrais faire."

# game/scripts/c29/c29.rpy:1889
translate french c29s003_KimPicnic_908c9784:

    # mc "*Laugh* That shows how brave you are. Modeling without armor, knowing you..."
    mc "*Rire* Ça montre à quel point tu es courageuse. Défiler sans armure, te connaissant..."

# game/scripts/c29/c29.rpy:1890
translate french c29s003_KimPicnic_4e3a13f1:

    # mc "But seriously, why Economics?"
    mc "Mais sérieusement, pourquoi l'économie ?"

# game/scripts/c29/c29.rpy:1892
translate french c29s003_KimPicnic_93cfa8db:

    # kim "It's easy to explain. I know that a modeling career is usually not long unless you reach the top."
    kim "C'est facile à expliquer. Je sais qu'une carrière de mannequin n'est généralement pas longue, à moins d'atteindre le sommet."

# game/scripts/c29/c29.rpy:1893
translate french c29s003_KimPicnic_bc3716e3:

    # kim "I never thought I could be like Klaudia Schiffer or Noemi Campbell, so the most likely thing is that, by 30, no one will hire me anymore."
    kim "Je n'ai jamais pensé pouvoir être comme Klaudia Schiffer ou Noemi Campbell, donc le plus probable c'est qu'à 30 ans, plus personne ne m'engagera."

# game/scripts/c29/c29.rpy:1894
translate french c29s003_KimPicnic_e9584cf3:

    # mc "That doesn't necessarily have to be the case."
    mc "Ce n'est pas nécessairement le cas."

# game/scripts/c29/c29.rpy:1896
translate french c29s003_KimPicnic_807e41f6:

    # kim "It doesn't have to be, but it's better to be prepared just in case it is."
    kim "Pas forcément, mais il vaut mieux être préparée au cas où ça arriverait."

# game/scripts/c29/c29.rpy:1897
translate french c29s003_KimPicnic_e8d9411e:

    # kim "If I have to stop modeling, what I would like to do is to help other girls who are starting out."
    kim "Si je dois arrêter le mannequinat, ce que j'aimerais faire, c'est aider d'autres filles qui débutent."

# game/scripts/c29/c29.rpy:1898
translate french c29s003_KimPicnic_415a28c6:

    # kim "And the best way would be to have a modeling agency."
    kim "Et le meilleur moyen serait d'avoir une agence de mannequins."

# game/scripts/c29/c29.rpy:1899
translate french c29s003_KimPicnic_97f8e04d:

    # mc "That's a good idea. But why Economics and not Business Administration or something more related to fashion?"
    mc "C'est une bonne idée. Mais pourquoi l'économie et pas la gestion d'entreprise ou quelque chose de plus lié à la mode ?"

# game/scripts/c29/c29.rpy:1901
translate french c29s003_KimPicnic_84c74b43:

    # kim "*Laugh* Because my high school counselor made a mistake or misinterpreted me when I explained what I wanted to do."
    kim "*Rires* Parce que mon conseiller d'orientation au lycée a fait une erreur ou m'a mal comprise quand je lui ai expliqué ce que je voulais faire."

# game/scripts/c29/c29.rpy:1902
translate french c29s003_KimPicnic_3e74629e:

    # kim "It seemed strange to me that he recommended Economics, but since I've never liked contradicting people who know what they're talking about..."
    kim "Ça m'a paru bizarre qu'il me recommande l'économie, mais comme je n'ai jamais aimé contredire les gens qui savent de quoi ils parlent..."

# game/scripts/c29/c29.rpy:1903
translate french c29s003_KimPicnic_51e5134e:

    # mc "You thought there was something you were missing, right?"
    mc "Tu t'es dit que quelque chose t'échappait, c'est ça ?"

# game/scripts/c29/c29.rpy:1905
translate french c29s003_KimPicnic_8edee16d:

    # kim "Exactly. And now I'm doing a degree that... it's not that I don't like it, but I don't see the utility in it."
    kim "Exactement. Et maintenant je fais des études qui... c'est pas que je n'aime pas ça, mais je n'en vois pas l'utilité."

# game/scripts/c29/c29.rpy:1906
translate french c29s003_KimPicnic_d4e3695e:

    # kim "I'll probably end up with two degrees or drop this one and take advantage of everything I can transfer to switch to Business Administration."
    kim "Je vais probablement finir avec deux diplômes ou laisser tomber celui-ci et profiter de tout ce que je peux transférer pour passer en administration des affaires."

# game/scripts/c29/c29.rpy:1907
translate french c29s003_KimPicnic_18c880f4:

    # kim "If I ever have a company, I'll need to master things they don't teach me in this degree."
    kim "Si j'ai un jour une entreprise, j'aurai besoin de maîtriser des choses qu'on ne m'apprend pas dans ce cursus."

# game/scripts/c29/c29.rpy:1908
translate french c29s003_KimPicnic_4105365b:

    # mc "I don't think that's necessary. [nor] and I studied Business Administration."
    mc "Je ne pense pas que ce soit nécessaire. [nor] et moi avons étudié l'administration des affaires."

# game/scripts/c29/c29.rpy:1909
translate french c29s003_KimPicnic_a565ca76:

    # mc "You don't need to know how to do everything related to a company. You can let others help you if you ever need it."
    mc "Tu n'as pas besoin de savoir tout faire dans une entreprise. Tu peux laisser d'autres personnes t'aider si jamais tu en as besoin."

# game/scripts/c29/c29.rpy:1911
translate french c29s003_KimPicnic_63b9e2a2:

    # kim "I think you're going to be very busy, and we already give [nor] too much work."
    kim "Je pense que tu vas être très occupé, et on donne déjà trop de travail à [nor]."

# game/scripts/c29/c29.rpy:1912
translate french c29s003_KimPicnic_b6b07f67:

    # mc "Unless you want to have a huge modeling agency, I think we could handle it."
    mc "À moins que tu ne veuilles avoir une énorme agence de mannequins, je pense qu'on pourrait gérer."

# game/scripts/c29/c29.rpy:1913
translate french c29s003_KimPicnic_0e8fb5cd:

    # mc "And if you have a huge modeling agency, you'll spend your time on other things, and hire a professional to handle the administration."
    mc "Et si tu as une énorme agence de mannequins, tu passeras ton temps sur d'autres choses, et tu embaucheras un professionnel pour s'occuper de l'administration."

# game/scripts/c29/c29.rpy:1915
translate french c29s003_KimPicnic_31633934:

    # kim "You're right. Since I was thinking of something small... I already told you it would be to help girls who are starting out... I thought I would have to do everything myself, but..."
    kim "Tu as raison. Comme je pensais à quelque chose de petit... Je t'ai déjà dit que ce serait pour aider les filles qui débutent... Je pensais que je devrais tout faire moi-même, mais..."

# game/scripts/c29/c29.rpy:1916
translate french c29s003_KimPicnic_0ba53983:

    # mc "But now you have a family around you that you can lean on. We can help you in a hundred different ways."
    mc "Mais maintenant, tu as une famille autour de toi sur laquelle tu peux t'appuyer. On peut t'aider d'une centaine de façons différentes."

# game/scripts/c29/c29.rpy:1917
translate french c29s003_KimPicnic_7469a82d:

    # mc "And I'm not just saying that because we're dating. I would offer it even if we weren't."
    mc "Et je ne dis pas ça juste parce qu'on sort ensemble. Je te le proposerais même si ce n'était pas le cas."

# game/scripts/c29/c29.rpy:1919
translate french c29s003_KimPicnic_9d2acfaf:

    # kim "That's one of the things that made me start falling in love with you."
    kim "C'est l'une des choses qui m'a fait tomber amoureuse de toi."

# game/scripts/c29/c29.rpy:1920
translate french c29s003_KimPicnic_4cf2e0a4:

    # kim "You're always thinking about how to help others without considering the workload it will bring you."
    kim "Tu penses toujours à la façon d'aider les autres sans tenir compte de la charge de travail que ça va t'apporter."

# game/scripts/c29/c29.rpy:1921
translate french c29s003_KimPicnic_1c02ec21:

    # mc "I'm not Elon Must. I don't plan to live to work; I prefer to work to live."
    mc "Je ne suis pas Elon Must. Je ne prévois pas de vivre pour travailler ; je préfère travailler pour vivre."

# game/scripts/c29/c29.rpy:1922
translate french c29s003_KimPicnic_e8ed5ada:

    # mc "I will always have time to help the people who matter to me."
    mc "J'aurai toujours du temps pour aider les personnes qui comptent pour moi."

# game/scripts/c29/c29.rpy:1929
translate french c29s004_BetMeeCall_7dda0259:

    # "*Ring-Ring*"
    "*Dring-Dring*"

# game/scripts/c29/c29.rpy:1930
translate french c29s004_BetMeeCall_d184ed08:

    # mc "It's Aunt [bet]. I have to answer."
    mc "C'est Tante [bet]. Il faut que je réponde."

# game/scripts/c29/c29.rpy:1931
translate french c29s004_BetMeeCall_cf0589c2:

    # kim "Don't worry. Give her a kiss from me. I'll start packing this up in the meantime."
    kim "T'inquiète pas. Fais-lui un bisou de ma part. Je vais commencer à ranger tout ça en attendant."

# game/scripts/c29/c29.rpy:1935
translate french c29s004_BetMeeCall_3a23c045:

    # "After watching several episodes of a series you hadn't seen in a long time..."
    "Après avoir regardé plusieurs épisodes d'une série que tu n'avais pas vue depuis longtemps..."

# game/scripts/c29/c29.rpy:1936
translate french c29s004_BetMeeCall_7dda0259_1:

    # "*Ring-Ring*"
    "*Dring-Dring*"

# game/scripts/c29/c29.rpy:1938
translate french c29s004_BetMeeCall_4fc57f2f:

    # mc "Good afternoon, Aunt [bet] and Meemaw."
    mc "Bonjour, Tante [bet] et Mamie."

# game/scripts/c29/c29.rpy:1939
translate french c29s004_BetMeeCall_0f2c3c98:

    # bet "Hello, [mc]."
    bet "Bonjour, [mc]."

# game/scripts/c29/c29.rpy:1940
translate french c29s004_BetMeeCall_a45814fd:

    # mee "How are you, [mc]?"
    mee "Comment vas-tu, [mc] ?"

# game/scripts/c29/c29.rpy:1942
translate french c29s004_BetMeeCall_7e0d777b:

    # mc "I'm doing well. I'm with [kim] on the campus having a picnic. She sends you kisses. And how are you two?"
    mc "Je vais bien. Je suis avec [kim] sur le campus pour un pique-nique. Elle vous fait des bisous. Et comment allez-vous toutes les deux ?"

# game/scripts/c29/c29.rpy:1944
translate french c29s004_BetMeeCall_d7a3022f:

    # bet "Are we interrupting a date? She didn't post it in the WhatsUp group..."
    bet "On interrompt un rencard ? Elle n'a rien posté dans le groupe WhatsUp..."

# game/scripts/c29/c29.rpy:1945
translate french c29s004_BetMeeCall_a782e4a0:

    # mee "We'll call later. It's not urgent."
    mee "On rappellera plus tard. Ce n'est pas urgent."

# game/scripts/c29/c29.rpy:1946
translate french c29s004_BetMeeCall_c4d179a1:

    # mc "Don't worry. [kim] went to throw the trash in the recycling bins while I talk to you two."
    mc "Ne vous inquiétez pas. [kim] est allée jeter les poubelles dans les bacs de recyclage pendant que je vous parle."

# game/scripts/c29/c29.rpy:1947
translate french c29s004_BetMeeCall_935ec1c0:

    # mc "How are you? How is the house sale going?"
    mc "Comment allez-vous ? Comment se passe la vente de la maison ?"

# game/scripts/c29/c29.rpy:1949
translate french c29s004_BetMeeCall_79611646:

    # mc "I'm fine. I was about to start working now. How about you two? How is the house sale going?"
    mc "Je vais bien. J'allais commencer à travailler. Et vous deux ? Comment se passe la vente de la maison ?"

# game/scripts/c29/c29.rpy:1950
translate french c29s004_BetMeeCall_f97bd0f7:

    # bet "I'll let you talk about the house. I'll be right back."
    bet "Je te laisse parler de la maison. Je reviens tout de suite."

# game/scripts/c29/c29.rpy:1952
translate french c29s004_BetMeeCall_4fe34119:

    # mee "Very well, the guy I told you about was here this morning and thinks it will sell well."
    mee "Très bien, le gars dont je t'ai parlé était là ce matin et pense que ça se vendra bien."

# game/scripts/c29/c29.rpy:1953
translate french c29s004_BetMeeCall_27ca7fdb:

    # mee "Plus, he saved us a ton of work."
    mee "En plus, il nous a épargné une tonne de boulot."

# game/scripts/c29/c29.rpy:1954
translate french c29s004_BetMeeCall_d953e167:

    # mc "Why? What happened?"
    mc "Pourquoi ? Qu'est-ce qui s'est passé ?"

# game/scripts/c29/c29.rpy:1956
translate french c29s004_BetMeeCall_8d8279c7:

    # mee "A house sells better if it's decorated... Well, if it's decorated with minimal taste. At least for a certain type of client."
    mee "Une maison se vend mieux si elle est décorée... Enfin, si elle est décorée avec un minimum de goût. Du moins pour un certain type de client."

# game/scripts/c29/c29.rpy:1957
translate french c29s004_BetMeeCall_61b5d4fb:

    # mee "Buyers can see how the spaces in the house look and get an idea of how it would look with their furniture."
    mee "Les acheteurs peuvent voir à quoi ressemblent les espaces de la maison et se faire une idée de ce que ça donnerait avec leurs meubles."

# game/scripts/c29/c29.rpy:1958
translate french c29s004_BetMeeCall_3cfa67ca:

    # mc "I understand. It's hard to get a good idea of the size of an empty room."
    mc "Je comprends. C'est dur de se faire une bonne idée de la taille d'une pièce vide."

# game/scripts/c29/c29.rpy:1960
translate french c29s004_BetMeeCall_6388142c:

    # mee "Exactly. This guy is very professional, and when I mentioned it to him, he offered me a moving service after the sale."
    mee "Exactement. Ce gars est très professionnel, et quand je lui en ai parlé, il m'a proposé un service de déménagement après la vente."

# game/scripts/c29/c29.rpy:1961
translate french c29s004_BetMeeCall_5ca1eba2:

    # mee "Meaning we'll only have to pack clothes and other personal items. But we won't need to dismantle the whole house."
    mee "Ce qui veut dire qu'on aura juste à emballer les vêtements et autres objets personnels. Mais on n'aura pas besoin de démonter toute la maison."

# game/scripts/c29/c29.rpy:1962
translate french c29s004_BetMeeCall_f9385ed1:

    # mc "That's great. Does that mean you'll be back sooner than expected?"
    mc "C'est génial. Ça veut dire que tu seras de retour plus tôt que prévu ?"

# game/scripts/c29/c29.rpy:1964
translate french c29s004_BetMeeCall_a3b6a4e7:

    # mee "Yes. The guy will be here with the contract in a couple of hours."
    mee "Oui. Le gars sera là avec le contrat dans quelques heures."

# game/scripts/c29/c29.rpy:1965
translate french c29s004_BetMeeCall_ba904868:

    # mee "On Monday, the movers will come to label the things that need to be taken to Newport and to take what we pack this weekend."
    mee "Lundi, les déménageurs viendront étiqueter les affaires qui doivent être emmenées à Newport et prendre ce qu'on aura emballé ce week-end."

# game/scripts/c29/c29.rpy:1966
translate french c29s004_BetMeeCall_58861b56:

    # mee "On Tuesday morning, we'll fly back to San Luis."
    mee "Mardi matin, on rentre à San Luis."

# game/scripts/c29/c29.rpy:1967
translate french c29s004_BetMeeCall_35c7a97d:

    # mc "Wonderful! That means I'll see you before I leave for Aruba."
    mc "Génial ! Ça veut dire que je vous verrai avant de partir pour Aruba."

# game/scripts/c29/c29.rpy:1969
translate french c29s004_BetMeeCall_2ded94f2:

    # mee "Yes, [bet] wanted to talk to you about that, let's see if she comes back."
    mee "Oui, [bet] voulait te parler de ça, voyons si elle revient."

# game/scripts/c29/c29.rpy:1970
translate french c29s004_BetMeeCall_a60259ed:

    # bet "*Off-camera* I'm here."
    bet "*Hors caméra* Je suis là."

# game/scripts/c29/c29.rpy:1971
translate french c29s004_BetMeeCall_311be437:

    # mc "What did you want to talk about, Aunt [bet]?"
    mc "De quoi voulais-tu parler, Tante [bet] ?"

# game/scripts/c29/c29.rpy:1974
translate french c29s004_BetMeeCall_49069ee2:

    # bet "*Laugh* Anything that doesn't have to do with selling the house."
    bet "*Rire* De tout ce qui n'a rien à voir avec la vente de la maison."

# game/scripts/c29/c29.rpy:1975
translate french c29s004_BetMeeCall_c516d295:

    # mc "I guess that's Meemaw's favorite topic right now. Professional deformation and all that. I bet she criticized how that guy handled the issue."
    mc "J'imagine que c'est le sujet préféré de Mamie en ce moment. Déformation professionnelle et tout ça. Je parie qu'elle a critiqué la façon dont ce gars a géré le truc."

# game/scripts/c29/c29.rpy:1976
translate french c29s004_BetMeeCall_20c1a642:

    # mee "*Off-camera* *Laugh* I can hear you..."
    mee "*Hors caméra* *Rire* Je vous entends..."

# game/scripts/c29/c29.rpy:1977
translate french c29s004_BetMeeCall_1a41291d:

    # bet "*Laugh* I think you know her too well. She would have done a lot of things differently than what the real estate agent did."
    bet "*Rire* Je crois que tu la connais trop bien. Elle aurait fait plein de choses différemment de ce qu'a fait l'agent immobilier."

# game/scripts/c29/c29.rpy:1978
translate french c29s004_BetMeeCall_bf616982:

    # mc "She spent many years selling houses. She knows what she's talking about."
    mc "Elle a passé des années à vendre des maisons. Elle sait de quoi elle parle."

# game/scripts/c29/c29.rpy:1980
translate french c29s004_BetMeeCall_f05d04ba:

    # bet "The truth is, the guy has been very kind and patient. I wouldn't have been so patient if someone were telling me how to do my job."
    bet "La vérité, c'est que le gars a été très gentil et patient. Je n'aurais pas été aussi patiente si quelqu'un me disait comment faire mon boulot."

# game/scripts/c29/c29.rpy:1981
translate french c29s004_BetMeeCall_6ae0f1a6:

    # mee "*Off-camera* He just wasn't taking some things into account!"
    mee "*Hors-champ* Il ne prenait juste pas certaines choses en compte !"

# game/scripts/c29/c29.rpy:1982
translate french c29s004_BetMeeCall_2711dc53:

    # bet "See? That's what I mean. Accepting advice is fine. Having your client tell you how things need to be done is different."
    bet "Tu vois ? C'est ce que je veux dire. Accepter des conseils, c'est bien. Que ton client te dise comment les choses doivent être faites, c'est différent."

# game/scripts/c29/c29.rpy:1983
translate french c29s004_BetMeeCall_1dba9e68:

    # mc "*Laugh* I can imagine the seller's face when he thought he was going to sell the house of two sweet old ladies and instead found a real estate market beast."
    mc "*Rires* J'imagine la tête du vendeur quand il pensait vendre la maison de deux douces vieilles dames et qu'il est tombé sur une bête du marché immobilier."

# game/scripts/c29/c29.rpy:1985
translate french c29s004_BetMeeCall_a7dca11f:

    # bet "*Laugh* That's pretty much what happened. Luckily, my clients are usually anesthetized."
    bet "*Rires* C'est à peu près ce qui s'est passé. Heureusement, mes clients sont généralement anesthésiés."

# game/scripts/c29/c29.rpy:1986
translate french c29s004_BetMeeCall_d5d5fc42:

    # mc "*Laugh* I can't imagine one of your clients saying 'operate a little more to the left'."
    mc "*Rires* Je n'imagine pas un de tes clients dire 'opérez un peu plus sur la gauche'."

# game/scripts/c29/c29.rpy:1987
translate french c29s004_BetMeeCall_e8053039:

    # mc "*Laugh* And luckily you're not a forensic pathologist. If they told you that, then it would be time to run."
    mc "*Rires* Et heureusement que tu n'es pas médecin légiste. S'ils te disaient ça, il serait temps de courir."

# game/scripts/c29/c29.rpy:1989
translate french c29s004_BetMeeCall_8d7b5009:

    # bet "But what I really wanted to talk to you about is that I've already written to Aaron to tell him I'm going to Aruba to try and perform the surgery."
    bet "Mais ce dont je voulais vraiment te parler, c'est que j'ai déjà écrit à Aaron pour lui dire que je vais à Aruba pour essayer de faire l'opération."

# game/scripts/c29/c29.rpy:1990
translate french c29s004_BetMeeCall_ae4da733:

    # mc "That's great, Aunt [bet]."
    mc "C'est génial, tante [bet]."

# game/scripts/c29/c29.rpy:1991
translate french c29s004_BetMeeCall_6644e336:

    # bet "Can you tell [ama] to take care of my plane tickets? I called her a while ago, but I couldn't reach her."
    bet "Tu peux dire à [ama] de s'occuper de mes billets d'avion ? Je l'ai appelée tout à l'heure, mais je n'ai pas réussi à la joindre."

# game/scripts/c29/c29.rpy:1992
translate french c29s004_BetMeeCall_e006e001:

    # mc "I don't think that will be necessary. Even if [lis] complains, I think we'll fly on one of the company's planes."
    mc "Je ne pense pas que ce sera nécessaire. Même si [lis] se plaint, je pense qu'on volera dans un des avions de l'entreprise."

# game/scripts/c29/c29.rpy:1994
translate french c29s004_BetMeeCall_3666c65d:

    # bet "Oh! I hadn't thought about that. I have to get used to the fact that my great-nephew is the CEO of a major company with private planes."
    bet "Oh ! Je n'y avais pas pensé. Il faut que je m'habitue au fait que mon petit-neveu est le PDG d'une grande entreprise avec des avions privés."

# game/scripts/c29/c29.rpy:1995
translate french c29s004_BetMeeCall_f78e1345:

    # mc "If you want, I can ask [ama] if the plane can pick you up on Tuesday so you can avoid the layover in Dallas."
    mc "Si tu veux, je peux demander à [ama] si l'avion peut venir vous chercher mardi pour que vous évitiez l'escale à Dallas."

# game/scripts/c29/c29.rpy:1997
translate french c29s004_BetMeeCall_772ca54d:

    # bet "*Laugh* That would be nice, but I prefer you don't do weird things with the company."
    bet "*Rires* Ce serait sympa, mais je préfère que tu ne fasses pas de trucs bizarres avec l'entreprise."

# game/scripts/c29/c29.rpy:1998
translate french c29s004_BetMeeCall_462f4ca7:

    # mc "Whatever you want. We wouldn't lose anything by asking [ama]..."
    mc "Comme tu veux. On ne perdrait rien à demander à [ama]..."

# game/scripts/c29/c29.rpy:2000
translate french c29s004_BetMeeCall_323fcec4:

    # bet "Don't worry. We already have the tickets, and if we cancel them, [mee] is going to have a heart attack over the money we'll lose."
    bet "T'inquiète pas. On a déjà les billets, et si on les annule, [mee] va faire une crise cardiaque pour l'argent qu'on va perdre."

# game/scripts/c29/c29.rpy:2001
translate french c29s004_BetMeeCall_cec56519:

    # mc "But you would save more if..."
    mc "Mais vous économiseriez plus si..."

# game/scripts/c29/c29.rpy:2003
translate french c29s004_BetMeeCall_2a5d9723:

    # bet "*Laugh* Don't you know [mee]? She'd be more bothered by the money she'd lose on the cancellation than she'd be happy about what she'd recover."
    bet "*Rires* Tu ne connais pas [mee] ? Elle serait plus contrariée par l'argent qu'elle perdrait sur l'annulation qu'elle ne serait heureuse de ce qu'elle récupérerait."

# game/scripts/c29/c29.rpy:2004
translate french c29s004_BetMeeCall_c9538b7c:

    # bet "Now she's in that mode of saving everything she can for the new house."
    bet "En ce moment, elle est dans l'optique d'économiser tout ce qu'elle peut pour la nouvelle maison."

# game/scripts/c29/c29.rpy:2005
translate french c29s004_BetMeeCall_4c2df674:

    # mc "It's normal, in a few years she went from San Luis to Florida, and now she's coming back here. That's three houses in a short time."
    mc "C'est normal, en quelques années elle est passée de San Luis à la Floride, et maintenant elle revient ici. Ça fait trois maisons en peu de temps."

# game/scripts/c29/c29.rpy:2006
translate french c29s004_BetMeeCall_ad0a4c60:

    # mee "*Off-camera* [bet], I can still hear you. And we're going to have to go get boxes before the store closes."
    mee "*Hors champ* [bet], je t'entends encore. Et on va devoir aller chercher des cartons avant que le magasin ferme."

# game/scripts/c29/c29.rpy:2008
translate french c29s004_BetMeeCall_ca142f06:

    # mee "We miss you a lot and all that, but if the store closes, we won't be able to pack the clothes."
    mee "Tu nous manques beaucoup et tout ça, mais si le magasin ferme, on ne pourra pas emballer les vêtements."

# game/scripts/c29/c29.rpy:2009
translate french c29s004_BetMeeCall_e9ffb4d3:

    # bet "*Chuckles* You know how practical [mee] is."
    bet "*Glousse* Tu sais à quel point [mee] est pragmatique."

# game/scripts/c29/c29.rpy:2010
translate french c29s004_BetMeeCall_b7cc7e31:

    # mc "Well, that's understandable. Don't tire yourselves out too much, you have all weekend to do it."
    mc "Eh bien, c'est compréhensible. Ne vous fatiguez pas trop, vous avez tout le week-end pour le faire."

# game/scripts/c29/c29.rpy:2012
translate french c29s004_BetMeeCall_a888e02b:

    # bet "*Chuckles* If it were up to [mee], we'd finish it tonight, even if we had to spend two days in bed afterward recovering from back pain."
    bet "*Rires* Si ça ne tenait qu'à [mee], on finirait ce soir, même si on devait passer deux jours au lit après pour se remettre de nos maux de dos."

# game/scripts/c29/c29.rpy:2013
translate french c29s004_BetMeeCall_cd3bcca1:

    # mee "*Laugh* Are you implying that I have you enslaved?"
    mee "*Rires* Tu insinues que je te réduis en esclavage ?"

# game/scripts/c29/c29.rpy:2014
translate french c29s004_BetMeeCall_cfa21a14:

    # mc "*Laugh* I think you should treat Aunt [bet] to a pizza place when you go get the boxes, Meemaw. As payment for all the help she's giving you."
    mc "*Rires* Je pense que tu devrais inviter Tante [bet] dans une pizzeria quand vous irez chercher les cartons, Mamie. En guise de paiement pour toute l'aide qu'elle t'apporte."

# game/scripts/c29/c29.rpy:2016
translate french c29s004_BetMeeCall_1d916268:

    # bet "*Laugh* Yes!"
    bet "*Rires* Oui !"

# game/scripts/c29/c29.rpy:2017
translate french c29s004_BetMeeCall_541bc991:

    # mee "But we already ordered pizza yesterday!"
    mee "Mais on a déjà commandé des pizzas hier !"

# game/scripts/c29/c29.rpy:2018
translate french c29s004_BetMeeCall_f8735f2c:

    # mc "*Laugh* I'm sure Aunt [bet] would appreciate eating with cutlery instead of getting her hands greasy..."
    mc "*Rires* Je suis sûr que Tante [bet] apprécierait de manger avec des couverts au lieu d'avoir les mains grasses..."

# game/scripts/c29/c29.rpy:2019
translate french c29s004_BetMeeCall_6abb1e90:

    # bet "*Laugh* I don't care about the grease!"
    bet "*Rires* Je m'en fous du gras !"

# game/scripts/c29/c29.rpy:2020
translate french c29s004_BetMeeCall_28ed440e:

    # mc "Well, I won't keep you any longer. I love you."
    mc "Bon, je ne vous retiens pas plus longtemps. Je vous aime."

# game/scripts/c29/c29.rpy:2022
translate french c29s004_BetMeeCall_ef9fc207:

    # mee "And we love you too." (multiple=2)
    mee "Et nous t'aimons aussi." (multiple=2)

# game/scripts/c29/c29.rpy:2023
translate french c29s004_BetMeeCall_1b6c33dd:

    # bet "We do too." (multiple=2)
    bet "Nous aussi." (multiple=2)

# game/scripts/c29/c29.rpy:2026
translate french c29s004_BetMeeCall_6bf0530e:

    # mee "And take care of [kim]. After what happened yesterday, she must be sore."
    mee "Et prends soin de [kim]. Après ce qui s'est passé hier, elle doit avoir mal."

# game/scripts/c29/c29.rpy:2027
translate french c29s004_BetMeeCall_a78f2e80:

    # mc "*Laugh* Wow. News travels fast. It's already reached Florida."
    mc "*Rires* Wow. Les nouvelles vont vite. C'est déjà arrivé jusqu'en Floride."

# game/scripts/c29/c29.rpy:2028
translate french c29s004_BetMeeCall_011aafed:

    # bet "*Chuckles* Haven't you heard that we're in the 21st Century? There's the internet, video calls, and WhatsUp groups."
    bet "*Glousse* T'es pas au courant qu'on est au 21ème siècle ? Y'a internet, les appels vidéo et les groupes WhatsUp."

# game/scripts/c29/c29.rpy:2030
translate french c29s004_BetMeeCall_0d52a332:

    # mee "We're going to let you go before the store closes. We have to get back for when the guy with the contract gets here."
    mee "On va te laisser avant que le magasin ferme. On doit rentrer pour quand le type avec le contrat arrivera."

# game/scripts/c29/c29.rpy:2031
translate french c29s004_BetMeeCall_d65aa413:

    # bet "Ciao! *Laugh* I have to practice my Italian so I can order the pizza correctly."
    bet "Ciao ! *Rires* Je dois pratiquer mon italien pour pouvoir commander la pizza correctement."

# game/scripts/c29/c29.rpy:2032
translate french c29s004_BetMeeCall_3acc6771:

    # mc "See you Tuesday. Have fun."
    mc "À mardi. Amusez-vous bien."

# game/scripts/c29/c29.rpy:2045
translate french c29s004_SamMegMarTattoo_bc4a0b78:

    # "Meanwhile, in a cafe on the other side of Newport..."
    "Pendant ce temps, dans un café de l'autre côté de Newport..."

# game/scripts/c29/c29.rpy:2047
translate french c29s004_SamMegMarTattoo_d6768315:

    # mar "Well, it's done. It wasn't that bad, right?"
    mar "Bon, c'est fait. C'était pas si terrible, non ?"

# game/scripts/c29/c29.rpy:2048
translate french c29s004_SamMegMarTattoo_709bc7a9:

    # meg "I really thought it was going to be much worse. It was very bearable."
    meg "Je pensais vraiment que ça allait être bien pire. C'était très supportable."

# game/scripts/c29/c29.rpy:2049
translate french c29s004_SamMegMarTattoo_915811fa:

    # sam "*Chuckles* You guys are such whiners. You spent the whole way here scared, and now you find out it's not a big deal."
    sam "*Glousse* Vous êtes de vraies pleurnicheuses. Vous avez passé tout le trajet à flipper, et maintenant vous vous rendez compte que c'est pas grand-chose."

# game/scripts/c29/c29.rpy:2050
translate french c29s004_SamMegMarTattoo_6bbde5e9:

    # sam "You should have listened to me and saved yourselves the worry."
    sam "Vous auriez dû m'écouter et vous épargner toute cette inquiétude."

# game/scripts/c29/c29.rpy:2053
translate french c29s004_SamMegMarTattoo_61602fb5:

    # meg "What scares me most is how we're going to hide it from [mc]. If he finds out, the surprise could be ruined."
    meg "Ce qui me fait le plus peur, c'est comment on va le cacher à [mc]. S'il le découvre, la surprise pourrait être gâchée."

