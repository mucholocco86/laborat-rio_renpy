# game/scripts/c29/c29.rpy:51
translate french c29s001_LisParty_9f3f1963:

    # "Upon arriving in Los Angeles, there is a limousine sent by [lis]'s friend, waiting for you."
    "En arrivant à Los Angeles, une limousine envoyée par l'amie de [lis] vous attend."

# game/scripts/c29/c29.rpy:52
translate french c29s001_LisParty_cc83c1af:

    # "You could almost get used to this kind of service, even though you consider it excessive."
    "Vous pourriez presque vous habituer à ce genre de service, même si vous trouvez ça excessif."

# game/scripts/c29/c29.rpy:53
translate french c29s001_LisParty_d19f7c51:

    # "You have never been on a helicopter, and you've taken several trips in the last week. And the limousines?... An Under would have been enough."
    "Vous n'étiez jamais monté dans un hélicoptère, et vous avez fait plusieurs voyages la semaine dernière. Et les limousines ?... Un Under aurait suffi."

# game/scripts/c29/c29.rpy:54
translate french c29s001_LisParty_738582fb:

    # "You're starting to think that you're the environmentalist instead of [lis]."
    "Vous commencez à penser que c'est vous l'écolo, et non [lis]."

# game/scripts/c29/c29.rpy:56
translate french c29s001_LisParty_9ea7bcf5:

    # "Once inside the car..."
    "Une fois à l'intérieur de la voiture..."

# game/scripts/c29/c29.rpy:57
translate french c29s001_LisParty_296655d9:

    # mc "I knew something was missing. I was surprised you weren't wearing earrings."
    mc "Je savais qu'il manquait quelque chose. J'étais surpris que tu ne portes pas de boucles d'oreilles."

# game/scripts/c29/c29.rpy:58
translate french c29s001_LisParty_82bdde9d:

    # lis "Never wear large earrings if you're going to use helicopter headphones. They can easily get tangled."
    lis "Ne porte jamais de grandes boucles d'oreilles si tu vas utiliser un casque d'hélicoptère. Elles peuvent facilement s'emmêler."

# game/scripts/c29/c29.rpy:59
translate french c29s001_LisParty_e3a2bd18:

    # mc "*Laugh* I won't wear earrings in that case. Or in any case."
    mc "*Rires* Je ne porterai pas de boucles d'oreilles dans ce cas. Ni dans aucun autre cas."

# game/scripts/c29/c29.rpy:61
translate french c29s001_LisParty_47c6133a:

    # lis "*Laugh* Guys have it so much easier. You hardly mess up your hair. Sometimes I envy you."
    lis "*Rires* Les mecs ont la vie tellement plus facile. Vous vous décoiffez à peine. Parfois, je vous envie."

# game/scripts/c29/c29.rpy:62
translate french c29s001_LisParty_36c3903c:

    # mc "*Laugh* That would be like me envying bald men because they can't mess up their hair."
    mc "*Rires* Ce serait comme si j'enviais les chauves parce qu'ils ne peuvent pas se décoiffer."

# game/scripts/c29/c29.rpy:63
translate french c29s001_LisParty_5e1b25da:

    # mc "Sometimes I miss the long hair I had when I came back from Portland. Then I realize how comfortable this is, and the feeling passes."
    mc "Parfois, mes cheveux longs que j'avais en revenant de Portland me manquent. Puis je réalise à quel point c'est confortable, et le sentiment passe."

# game/scripts/c29/c29.rpy:65
translate french c29s001_LisParty_5705ee66:

    # lis "You had long hair? I can't imagine you with long hair."
    lis "T'avais les cheveux longs ? J'arrive pas à t'imaginer avec les cheveux longs."

# game/scripts/c29/c29.rpy:66
translate french c29s001_LisParty_bea6c798:

    # mc "Hasn't [sai] shown you any pictures from when we were in Portland?"
    mc "[sai] ne t'a pas montré de photos de quand on était à Portland ?"

# game/scripts/c29/c29.rpy:68
translate french c29s001_LisParty_d7b25d3f:

    # lis "Yes, but they must have been older pictures, because your hair was like it is now, and hers was a little longer than mine."
    lis "Si, mais ça devait être de vieilles photos, parce que tes cheveux étaient comme maintenant, et les siens étaient un peu plus longs que les miens."

# game/scripts/c29/c29.rpy:69
translate french c29s001_LisParty_cfb42710:

    # mc "Yeah, those are from the beginning of our 'dating'. The last few months were crazy, and I didn't visit a barber... I think since before Christmas."
    mc "Ouais, elles datent du début de notre 'relation'. Les derniers mois ont été dingues, et je suis pas allé chez le coiffeur... depuis avant Noël, je crois."

# game/scripts/c29/c29.rpy:70
translate french c29s001_LisParty_ea9c3021:

    # mc "When I got back home, that was one of the first things I did. [nor] laughed at me, saying I looked like a barbarian."
    mc "Quand je suis rentré, c'est l'une des premières choses que j'ai faites. [nor] s'est foutue de ma gueule en disant que je ressemblais à un barbare."

# game/scripts/c29/c29.rpy:71
translate french c29s001_LisParty_de51c229:

    # mc "It was a little shorter than yours, but not by much."
    mc "C'était un peu plus court que les tiens, mais pas de beaucoup."

# game/scripts/c29/c29.rpy:73
translate french c29s001_LisParty_02405c28:

    # lis "I'll ask the girls if they have pictures of you with long hair. Knowing you, I'm almost certain you don't take selfies."
    lis "Je demanderai aux filles si elles ont des photos de toi avec les cheveux longs. Te connaissant, je suis presque sûre que tu prends pas de selfies."

# game/scripts/c29/c29.rpy:74
translate french c29s001_LisParty_db7befd3:

    # mc "*Laugh* Want to bet?"
    mc "*Rires* Tu veux parier ?"

# game/scripts/c29/c29.rpy:76
translate french c29s001_LisParty_438a75aa:

    # lis "What? You take selfies? You're one of the few people I would never have said that about..."
    lis "Quoi ? Tu prends des selfies ? T'es l'une des rares personnes pour qui je n'aurais jamais dit ça..."

# game/scripts/c29/c29.rpy:77
translate french c29s001_LisParty_c3b58748:

    # mc "*Laugh* No."
    mc "*Rires* Non."

# game/scripts/c29/c29.rpy:79
translate french c29s001_LisParty_9e2c523d:

    # lis "*Laugh* Idiot."
    lis "*Rires* Idiot."

# game/scripts/c29/c29.rpy:80
translate french c29s001_LisParty_bd8341fe:

    # mc "*Laugh* I love you too."
    mc "*Rires* Je t'aime aussi."

# game/scripts/c29/c29.rpy:83
translate french c29s001_LisParty_7554661d:

    # "After a few minutes, you arrive at [lis]'s friend's apartment. The elevator leaves you in a hallway that leads to the living room."
    "Après quelques minutes, vous arrivez à l'appartement de l'amie de [lis]. L'ascenseur vous laisse dans un couloir qui mène au salon."

# game/scripts/c29/c29.rpy:94
translate french c29s001_LisParty_3b835d5f:

    # lis "Let's go find Sidney. I want you to meet her, although I'm sure you've seen her in one of her series or movies. She killed it in 'Euphoric'."
    lis "Allons trouver Sidney. Je veux te la présenter, même si je suis sûre que tu l'as déjà vue dans l'une de ses séries ou l'un de ses films. Elle a tout déchiré dans 'Euphoric'."

# game/scripts/c29/c29.rpy:95
translate french c29s001_LisParty_b5d1d7a0:

    # mc "Wait. Is that Sidney? Sidney Todd?"
    mc "Attends. C'est Sidney ? Sidney Todd ?"

# game/scripts/c29/c29.rpy:97
translate french c29s001_LisParty_8d22985b:

    # lis "Yes. Didn't I tell you? Do you like that show?"
    lis "Oui. Je ne te l'avais pas dit ? Tu aimes cette série ?"

# game/scripts/c29/c29.rpy:98
translate french c29s001_LisParty_76fefa72:

    # mc "I didn't have time to follow it much. I think I saw one or two episodes where I disliked all the characters."
    mc "Je n'ai pas trop eu le temps de suivre. Je crois que j'ai vu un ou deux épisodes où je détestais tous les personnages."

# game/scripts/c29/c29.rpy:100
translate french c29s001_LisParty_5b4296ac:

    # lis "*Laugh* Don't tell Sidney that. She was nominated for a Silvery Globe for that role."
    lis "*Rires* Ne dis pas ça à Sidney. Elle a été nommée pour un Silvery Globe pour ce rôle."

# game/scripts/c29/c29.rpy:101
translate french c29s001_LisParty_99653dce:

    # lis "Let's go find her."
    lis "Allons la trouver."

# game/scripts/c29/c29.rpy:103
translate french c29s001_LisParty_d83a4d1b:

    # lis "SIDNEY!"
    lis "SIDNEY !"

# game/scripts/c29/c29.rpy:104
translate french c29s001_LisParty_205d30af:

    # sid "[lis!u]! You made it!"
    sid "[lis!u] ! Vous êtes là !"

# game/scripts/c29/c29.rpy:106
translate french c29s001_LisParty_3f9873bd:

    # lis "Thanks for sending the car for us, Sid."
    lis "Merci d'avoir envoyé la voiture pour nous, Sid."

# game/scripts/c29/c29.rpy:107
translate french c29s001_LisParty_48187e0c:

    # sid "*Laugh* Stop growing or you'll end up having to borrow clothes from [deb]."
    sid "*Rires* Arrête de grandir ou tu vas finir par devoir emprunter des vêtements à [deb]."

# game/scripts/c29/c29.rpy:108
translate french c29s001_LisParty_aa66c29e:

    # lis "Come here. I want to introduce you to someone."
    lis "Viens là. Je veux te présenter quelqu'un."

# game/scripts/c29/c29.rpy:110
translate french c29s001_LisParty_eb3c4ab8:

    # lis "Sid, this is [mc]. My boyfriend."
    lis "Sid, voici [mc]. Mon petit ami."

# game/scripts/c29/c29.rpy:111
translate french c29s001_LisParty_33764a5d:

    # mc "Nice to meet you, Sidney."
    mc "Ravi de te rencontrer, Sidney."

# game/scripts/c29/c29.rpy:112
translate french c29s001_LisParty_64d34bc4:

    # sid "Likewise, [mc]. So, someone finally managed to snag our [lis]?"
    sid "De même, [mc]. Alors, quelqu'un a enfin réussi à mettre le grappin sur notre [lis] ?"

# game/scripts/c29/c29.rpy:113
translate french c29s001_LisParty_0df8848c:

    # mc "*Laugh* It seems so."
    mc "*Rires* On dirait bien."

# game/scripts/c29/c29.rpy:115
translate french c29s001_LisParty_0b13a6f5:

    # lis "*Laugh* Or maybe I'm the one who snagged him."
    lis "*Rires* Ou peut-être que c'est moi qui lui ai mis le grappin dessus."

# game/scripts/c29/c29.rpy:116
translate french c29s001_LisParty_a0dd3b9a:

    # sid "*Laugh* Then he can be considered one of the luckiest men in the world, if you're interested in him."
    sid "*Rires* Alors il peut être considéré comme l'un des hommes les plus chanceux du monde, si tu t'intéresses à lui."

# game/scripts/c29/c29.rpy:117
translate french c29s001_LisParty_94019a11:

    # mc "*Laugh* I think you're wrong. I don't consider myself among the luckiest men in the world. I'm at the very top of the luckiest men's pyramid."
    mc "*Rires* Je pense que tu as tort. Je ne me considère pas parmi les hommes les plus chanceux du monde. Je suis tout en haut de la pyramide des hommes les plus chanceux."

# game/scripts/c29/c29.rpy:119
translate french c29s001_LisParty_c9cadba7:

    # lis "*Laugh* Do you understand now why I'm with him?"
    lis "*Rires* Tu comprends maintenant pourquoi je suis avec lui ?"

# game/scripts/c29/c29.rpy:120
translate french c29s001_LisParty_c2983f37:

    # sid "Honestly, that's not the answer I expected. *Laugh* But if he's always like that, keep him close."
    sid "Honnêtement, ce n'est pas la réponse à laquelle je m'attendais. *Rires* Mais s'il est toujours comme ça, garde-le près de toi."

# game/scripts/c29/c29.rpy:121
translate french c29s001_LisParty_155c3f74:

    # mc "*Laugh* I hope so."
    mc "*Rire* Je l'espère."

# game/scripts/c29/c29.rpy:123
translate french c29s001_LisParty_65070f98:

    # lis "Oh! I just saw Jenny! Did she come in costume?"
    lis "Oh ! Je viens de voir Jenny ! Elle est venue déguisée ?"

# game/scripts/c29/c29.rpy:124
translate french c29s001_LisParty_45ee02db:

    # sid "No. Or maybe she did... She came straight from a photoshoot for her new show."
    sid "Non. Ou peut-être que si... Elle est venue directement d'une séance photo pour sa nouvelle série."

# game/scripts/c29/c29.rpy:126
translate french c29s001_LisParty_688ebfb8:

    # lis "Watch [mc] for a bit, Sid. I'm going to say hi to Jenny and bring her over so he can meet her."
    lis "Surveille [mc] un instant, Sid. Je vais dire bonjour à Jenny et l'amener pour qu'il puisse la rencontrer."

# game/scripts/c29/c29.rpy:127
translate french c29s001_LisParty_16d832f3:

    # lis "*Laugh* Don't let any hussies near my boyfriend."
    lis "*Rire* Ne laisse aucune traînée s'approcher de mon petit ami."

# game/scripts/c29/c29.rpy:128
translate french c29s001_LisParty_43c0ed37:

    # sid "Don't worry. *Laugh* I'll defend his honor with my claws."
    sid "Ne t'inquiète pas. *Rire* Je défendrai son honneur avec mes griffes."

# game/scripts/c29/c29.rpy:131
translate french c29s001_LisParty_a3398586:

    # lis "Wait for me here with Sidney. I'll be back in a minute."
    lis "Attends-moi ici avec Sidney. Je reviens dans une minute."

# game/scripts/c29/c29.rpy:132
translate french c29s001_LisParty_3173a809:

    # mc "Don't worry. *Laugh* I'll try not to bore her."
    mc "Ne t'inquiète pas. *Rire* Je vais essayer de ne pas l'ennuyer."

# game/scripts/c29/c29.rpy:135
translate french c29s001_LisParty_7483f194:

    # "You approach the bar with Sidney. You always thought it looked stupid when you saw a full bar in movies about mansions. This is the first time you've seen one outside of TV."
    "Tu t'approches du bar avec Sidney. Tu as toujours trouvé ça stupide quand tu voyais un bar complet dans les films sur les manoirs. C'est la première fois que tu en vois un en dehors de la télé."

# game/scripts/c29/c29.rpy:136
translate french c29s001_LisParty_e3e1bf5d:

    # sid "So, you're [lis]'s guy. When she wrote to tell me she was coming with someone, I almost couldn't believe it."
    sid "Alors, tu es le mec de [lis]. Quand elle m'a écrit pour me dire qu'elle venait avec quelqu'un, j'ai failli ne pas y croire."

# game/scripts/c29/c29.rpy:138
translate french c29s001_LisParty_82cf0183:

    # mcp "(I have no idea what she knows about us, the family, or the harem... It's better not to give away any relevant information.)"
    mcp "(Je n'ai aucune idée de ce qu'elle sait sur nous, la famille ou le harem... Il vaut mieux ne pas donner d'informations pertinentes.)"

# game/scripts/c29/c29.rpy:140
translate french c29s001_LisParty_0c0d671f:

    # mcp "(I have no idea what she knows about us or the family... It's better not to give away any relevant information.)"
    mcp "(Je n'ai aucune idée de ce qu'elle sait sur nous ou sur la famille... Il vaut mieux ne pas donner d'informations pertinentes.)"

# game/scripts/c29/c29.rpy:141
translate french c29s001_LisParty_aada82dd:

    # mc "I think if anyone had told us this less than a month ago, we wouldn't have believed it either."
    mc "Je pense que si quelqu'un nous avait dit ça il y a moins d'un mois, on n'y aurait pas cru non plus."

# game/scripts/c29/c29.rpy:143
translate french c29s001_LisParty_7cef4d48:

    # sid "Have you and she known each other for a long time?"
    sid "Vous vous connaissez depuis longtemps, elle et toi ?"

# game/scripts/c29/c29.rpy:144
translate french c29s001_LisParty_7f404c0c:

    # mc "*Laugh* Less than a month."
    mc "*Rire* Moins d'un mois."

# game/scripts/c29/c29.rpy:146
translate french c29s001_LisParty_10246c7b:

    # sid "*Laugh* I see you have a sense of humor. You're going to need it with [lis]."
    sid "*Rire* Je vois que tu as le sens de l'humour. Tu vas en avoir besoin avec [lis]."

# game/scripts/c29/c29.rpy:147
translate french c29s001_LisParty_0f4813ed:

    # sid "Sometimes she needs someone to keep her grounded when she gets too excited about something. And it's always better to do it with a sense of humor."
    sid "Parfois, elle a besoin de quelqu'un pour lui faire garder les pieds sur terre quand elle s'emballe trop pour quelque chose. Et c'est toujours mieux de le faire avec le sens de l'humour."

# game/scripts/c29/c29.rpy:148
translate french c29s001_LisParty_d4c5bc55:

    # mc "Don't worry about that. My role isn't to keep her grounded, but to accompany and encourage her, so she reaches the goals she has set."
    mc "Ne t'inquiète pas pour ça. Mon rôle n'est pas de lui faire garder les pieds sur terre, mais de l'accompagner et de l'encourager, pour qu'elle atteigne les objectifs qu'elle s'est fixés."

# game/scripts/c29/c29.rpy:149
translate french c29s001_LisParty_9a299d2c:

    # mc "By the way, I like your apartment."
    mc "Au fait, j'aime bien ton appartement."

# game/scripts/c29/c29.rpy:151
translate french c29s001_LisParty_d495a0d3:

    # sid "Thanks. It's really cool, but this is actually the farewell party for this apartment."
    sid "Merci. Il est vraiment cool, mais c'est en fait la fête d'adieu pour cet appartement."

# game/scripts/c29/c29.rpy:152
translate french c29s001_LisParty_49489061:

    # mc "Are you leaving the apartment? It's an amazing place, and [lis] told me you have a pool upstairs."
    mc "Tu quittes l'appartement ? C'est un endroit incroyable, et [lis] m'a dit que tu avais une piscine à l'étage."

# game/scripts/c29/c29.rpy:153
translate french c29s001_LisParty_a3fa4c8e:

    # sid "I like the place, but it's a rental. It belongs to a British producer, and the layout isn't the best. The bar takes up too much space and I can't remove it."
    sid "J'aime bien l'endroit, mais c'est une location. Il appartient à un producteur britannique, et l'agencement n'est pas le meilleur. Le bar prend trop de place et je ne peux pas l'enlever."

# game/scripts/c29/c29.rpy:155
translate french c29s001_LisParty_a1468165:

    # sid "This apartment is designed more for throwing parties than for living in. I bought a house last year, and now that the renovations are finished, I'm moving there."
    sid "Cet appartement est plus conçu pour organiser des fêtes que pour y vivre. J'ai acheté une maison l'année dernière, et maintenant que les rénovations sont terminées, je m'y installe."

# game/scripts/c29/c29.rpy:156
translate french c29s001_LisParty_c569f646:

    # sid "I've already moved a lot of things out, and now this apartment feels... empty. The new house is much quieter than this place, and more secluded."
    sid "J'ai déjà déménagé beaucoup de choses, et maintenant cet appartement semble... vide. La nouvelle maison est beaucoup plus calme qu'ici, et plus isolée."

# game/scripts/c29/c29.rpy:157
translate french c29s001_LisParty_94948ae3:

    # mc "The price of fame, I guess. Something I hope I never have to deal with."
    mc "La rançon de la gloire, j'imagine. Quelque chose que j'espère ne jamais avoir à gérer."

# game/scripts/c29/c29.rpy:159
translate french c29s001_LisParty_1f5f3556:

    # sid "It has its good parts and its bad parts. Although there are more good parts than bad."
    sid "Ça a ses bons et ses mauvais côtés. Même s'il y a plus de bons que de mauvais."

# game/scripts/c29/c29.rpy:160
translate french c29s001_LisParty_b15b0059:

    # mc "I imagine so. Otherwise, people would run away from fame."
    mc "J'imagine, oui. Sinon, les gens fuiraient la célébrité."

# game/scripts/c29/c29.rpy:161
translate french c29s001_LisParty_fd95efb8:

    # mc "By the way, I thought there would be more people. [lis] mentioned 60 or 70 people."
    mc "Au fait, je pensais qu'il y aurait plus de monde. [lis] a parlé de 60 ou 70 personnes."

# game/scripts/c29/c29.rpy:163
translate french c29s001_LisParty_5a485bd6:

    # sid "There are 80 invited guests, but they won't all come or be here at the same time. People come and go, but less than half will stay for the entire party."
    sid "Il y a 80 invités, mais ils ne viendront pas tous ou ne seront pas là en même temps. Les gens vont et viennent, mais moins de la moitié resteront pour toute la soirée."

# game/scripts/c29/c29.rpy:164
translate french c29s001_LisParty_31232478:

    # sid "Also, there are a lot of people upstairs on the rooftop and by the pool right now. It's a nice evening and people want to take advantage of that and be outdoors."
    sid "De plus, il y a beaucoup de monde en haut sur le toit et près de la piscine en ce moment. C'est une belle soirée et les gens veulent en profiter pour être dehors."

# game/scripts/c29/c29.rpy:165
translate french c29s001_LisParty_838aabed:

    # mc "You're right, I hadn't thought about there being a lot of people in the pool at this time."
    mc "Tu as raison, je n'avais pas pensé qu'il y aurait autant de monde dans la piscine à cette heure-ci."

# game/scripts/c29/c29.rpy:167
translate french c29s001_LisParty_e4ce73e0:

    # sid "By the way, what do you do, [mc]? [lis] hasn't told me anything about you except that you exist."
    sid "Au fait, que fais-tu dans la vie, [mc] ? [lis] ne m'a rien dit sur toi à part que tu existes."

# game/scripts/c29/c29.rpy:168
translate french c29s001_LisParty_cad631e2:

    # mc "My family owns a housing company for university students. We founded it this year."
    mc "Ma famille possède une entreprise de logements pour étudiants universitaires. Nous l'avons fondée cette année."

# game/scripts/c29/c29.rpy:169
translate french c29s001_LisParty_d7787222:

    # mc "*Laugh* [lis] would say I'm the bellhop, but I'm the financial director, among other things."
    mc "*Rire* [lis] dirait que je suis le groom, mais je suis le directeur financier, entre autres choses."

# game/scripts/c29/c29.rpy:171
translate french c29s001_LisParty_8d340300:

    # sid "Oh, how interesting! Is that where you met [lis]?"
    sid "Oh, comme c'est intéressant ! C'est là que vous avez rencontré [lis] ?"

# game/scripts/c29/c29.rpy:172
translate french c29s001_LisParty_e4854777:

    # sid "A couple of months ago, she told me she was moving to a coastal town to study. According to her, 'like a normal girl'."
    sid "Il y a quelques mois, elle m'a dit qu'elle déménageait dans une ville côtière pour étudier. Selon elle, 'comme une fille normale'."

# game/scripts/c29/c29.rpy:173
translate french c29s001_LisParty_6862b974:

    # sid "I suppose her family could buy the entire university, or at least a mansion to live in while she studies."
    sid "Je suppose que sa famille pourrait acheter l'université entière, ou au moins un manoir pour y vivre pendant ses études."

# game/scripts/c29/c29.rpy:174
translate french c29s001_LisParty_79a45be1:

    # mc "Yes, [lis] is staying at the dorm. It's the house where I've lived almost my entire life."
    mc "Oui, [lis] loge à la résidence. C'est la maison où j'ai vécu presque toute ma vie."

# game/scripts/c29/c29.rpy:175
translate french c29s001_LisParty_fd195d7d:

    # mc "The atmosphere is very... family-like. My sister and mother also live there, and my aunt and cousins live in the house next door, which also belongs to the dorm."
    mc "L'ambiance est très... familiale. Ma sœur et ma mère y vivent aussi, et ma tante et mes cousines vivent dans la maison d'à côté, qui appartient aussi à la résidence."

# game/scripts/c29/c29.rpy:177
translate french c29s001_LisParty_6f4ed15f:

    # mc "(*Mental laughter* If I had to explain to you that we aren't related, your head would probably explode and the party would end.)"
    mc "(*Rire mental* Si je devais vous expliquer que nous ne sommes pas de la même famille, votre tête exploserait probablement et la fête serait finie.)"

# game/scripts/c29/c29.rpy:179
translate french c29s001_LisParty_f775a5d2:

    # sid "Mmmm... When you said a housing company, I thought you would have several buildings at different universities."
    sid "Mmmm... Quand vous avez parlé d'une société de logement, je pensais que vous auriez plusieurs bâtiments dans différentes universités."

# game/scripts/c29/c29.rpy:180
translate french c29s001_LisParty_c250229d:

    # mc "It will happen in time. As I said, we just started this year."
    mc "Ça viendra avec le temps. Comme je l'ai dit, nous venons juste de commencer cette année."

# game/scripts/c29/c29.rpy:182
translate french c29s001_LisParty_81bee7ce:

    # sid "Oh, don't misunderstand me! I'm not one of those people who judge others by the size of their bank account."
    sid "Oh, ne vous méprenez pas ! Je ne suis pas de ces gens qui jugent les autres à la taille de leur compte en banque."

# game/scripts/c29/c29.rpy:183
translate french c29s001_LisParty_c22e46a6:

    # sid "Here in Hollywood, everything seems to revolve around money and fame, but I grew up in rural Idaho."
    sid "Ici à Hollywood, tout semble tourner autour de l'argent et de la célébrité, mais j'ai grandi dans l'Idaho rural."

# game/scripts/c29/c29.rpy:184
translate french c29s001_LisParty_52d80627:

    # mc "I wasn't misunderstanding you, don't worry. I was just clarifying that point. I don't want to look like a guy who owns one hotel and claims he has a chain."
    mc "Je ne me méprenais pas, ne t'inquiète pas. Je voulais juste clarifier ce point. Je ne veux pas passer pour le mec qui possède un seul hôtel et prétend avoir une chaîne."

# game/scripts/c29/c29.rpy:185
translate french c29s001_LisParty_52feb7aa:

    # mc "For us right now, it's more important that the girls feel comfortable than anything else. That's what I meant by a family-like atmosphere."
    mc "Pour nous en ce moment, c'est plus important que les filles se sentent à l'aise qu'autre chose. C'est ce que je voulais dire par une atmosphère familiale."

# game/scripts/c29/c29.rpy:189
translate french c29s001_LisParty_189f97dd:

    # sid "Look, [lis] is coming back with Jenny. I'm going to leave you; I have more guests I need to attend to."
    sid "Regarde, [lis] revient avec Jenny. Je vais te laisser ; j'ai d'autres invités dont je dois m'occuper."

# game/scripts/c29/c29.rpy:190
translate french c29s001_LisParty_836c1691:

    # mc "Don't worry. It was nice to meet you."
    mc "Ne t'en fais pas. C'était un plaisir de te rencontrer."

# game/scripts/c29/c29.rpy:191
translate french c29s001_LisParty_418e3e02:

    # sid "Likewise. Have fun."
    sid "De même. Amuse-toi bien."

# game/scripts/c29/c29.rpy:193
translate french c29s001_LisParty_43502c32:

    # lis "Has Sid left already? Did she leave you alone?"
    lis "Sid est déjà partie ? Elle t'a laissé tout seul ?"

# game/scripts/c29/c29.rpy:194
translate french c29s001_LisParty_2b7c6072:

    # mc "She just left. She waited until she saw you were coming back."
    mc "Elle vient de partir. Elle a attendu de voir que tu revenais."

# game/scripts/c29/c29.rpy:195
translate french c29s001_LisParty_4f769a1b:

    # lis "Well, let me introduce you to Jenny. This is [mc], my boyfriend."
    lis "Eh bien, laisse-moi te présenter Jenny. Voici [mc], mon petit ami."

# game/scripts/c29/c29.rpy:196
translate french c29s001_LisParty_8216a1aa:

    # mc "Nice to meet you, Jenny."
    mc "Ravi de te rencontrer, Jenny."

# game/scripts/c29/c29.rpy:197
translate french c29s001_LisParty_266f381e:

    # jen "Same here, [mc]."
    jen "Moi de même, [mc]."

# game/scripts/c29/c29.rpy:199
translate french c29s001_LisParty_ead44969:

    # jen "I see that coming to California has suited our very tall friends well. They haven't been here even a month yet, and both of them are already paired up."
    jen "Je vois que venir en Californie a bien réussi à nos très grandes amies. Elles ne sont même pas là depuis un mois, et elles sont déjà toutes les deux en couple."

# game/scripts/c29/c29.rpy:201
translate french c29s001_LisParty_2d6ccfec:

    # "You understand from [lis]'s gesture that Jenny doesn't know that both of them are paired up with you."
    "Tu comprends au geste de [lis] que Jenny ne sait pas qu'elles sont toutes les deux en couple avec toi."

# game/scripts/c29/c29.rpy:202
translate french c29s001_LisParty_af24240d:

    # mc "Each of them has found a lucky guy."
    mc "Chacune d'elles a trouvé un mec chanceux."

# game/scripts/c29/c29.rpy:204
translate french c29s001_LisParty_83bb5b5e:

    # lis "I'm still not sure who is luckier. If it's us or our boyfriend... Our boyfriends..."
    lis "Je ne sais toujours pas qui a le plus de chance. Si c'est nous ou notre mec... Nos mecs..."

# game/scripts/c29/c29.rpy:206
translate french c29s001_LisParty_c17d5949:

    # jen "I see that coming to California has suited our very tall friend well. She hasn't been here even a month yet, and she's already paired up."
    jen "Je vois que venir en Californie a bien réussi à notre très grande amie. Ça fait même pas un mois qu'elle est là, et elle est déjà casée."

# game/scripts/c29/c29.rpy:207
translate french c29s001_LisParty_c9060efd:

    # mc "[lis] has found a lucky guy."
    mc "[lis] a trouvé un mec chanceux."

# game/scripts/c29/c29.rpy:209
translate french c29s001_LisParty_f2acd914:

    # lis "I'm still not sure who is luckier. If it's him or me."
    lis "Je ne sais toujours pas qui a le plus de chance. Si c'est lui ou moi."

# game/scripts/c29/c29.rpy:210
translate french c29s001_LisParty_294ed5b5:

    # jen "*Laugh* How beautiful a relationship is when it starts!"
    jen "*Rire* Qu'est-ce que c'est beau une relation qui commence !"

# game/scripts/c29/c29.rpy:211
translate french c29s001_LisParty_1feac208:

    # mc "*Laugh* I hope I never have to compare it to how it is when it ends."
    mc "*Rire* J'espère ne jamais avoir à comparer ça avec la façon dont ça se termine."

# game/scripts/c29/c29.rpy:213
translate french c29s001_LisParty_8ae9094d:

    # jen "*Laugh* Girl, keep this man close. It looks like he has no intention of letting you get away."
    jen "*Rire* Meuf, garde cet homme près de toi. On dirait qu'il n'a aucune intention de te laisser filer."

# game/scripts/c29/c29.rpy:214
translate french c29s001_LisParty_7e0454d0:

    # lis "*Giggle* He has already seen one of the worst parts of me, and that hasn't scared him off, so..."
    lis "*Gloussement* Il a déjà vu un de mes pires côtés, et ça ne l'a pas fait fuir, alors..."

# game/scripts/c29/c29.rpy:215
translate french c29s001_LisParty_d17a656e:

    # jen "One of your worst parts? *Laugh* Which one? You have so many!"
    jen "Un de tes pires côtés ? *Rire* Lequel ? Tu en as tellement !"

# game/scripts/c29/c29.rpy:216
translate french c29s001_LisParty_6998b61e:

    # lis "*Laugh* You're such a bitch, Jenny."
    lis "*Rires* T'es vraiment une garce, Jenny."

# game/scripts/c29/c29.rpy:217
translate french c29s001_LisParty_04cdd0ca:

    # mc "*Laugh* Do you really have bad parts, [lis]?"
    mc "*Rires* Tu as vraiment des parties moches, [lis] ?"

# game/scripts/c29/c29.rpy:219
translate french c29s001_LisParty_e2b75e16:

    # jen "Guys, I'm glad I saw you, but I'm meeting Saoirse upstairs by the pool and she's probably wondering where I am."
    jen "Les gars, je suis contente de vous avoir vus, mais je rejoins Saoirse en haut près de la piscine et elle doit se demander où je suis."

# game/scripts/c29/c29.rpy:220
translate french c29s001_LisParty_ee3e000d:

    # lis "Saoirse is here? I didn't know she was coming!"
    lis "Saoirse est là ? Je ne savais pas qu'elle venait !"

# game/scripts/c29/c29.rpy:221
translate french c29s001_LisParty_49917b6c:

    # jen "They suspended filming because one of the actors broke a hand. Why don't you come? I'm sure she'll be happy to see you."
    jen "Ils ont suspendu le tournage parce qu'un des acteurs s'est cassé la main. Pourquoi tu ne viens pas ? Je suis sûre qu'elle sera contente de te voir."

# game/scripts/c29/c29.rpy:223
translate french c29s001_LisParty_a55935a6:

    # lis "I don't want to leave you alone again... Are you coming up to the pool with us?"
    lis "Je ne veux pas te laisser seul à nouveau... Tu montes à la piscine avec nous ?"

# game/scripts/c29/c29.rpy:224
translate french c29s001_LisParty_e720b56e:

    # mc "Don't worry. Go say hello to your friends and I'll wait for you here, at the bar. I'm starting to get thirsty."
    mc "T'inquiète pas. Va dire bonjour à tes amies et je t'attendrai ici, au bar. Je commence à avoir soif."

# game/scripts/c29/c29.rpy:226
translate french c29s001_LisParty_8216a1aa_1:

    # mc "It was nice to meet you, Jenny."
    mc "C'était sympa de te rencontrer, Jenny."

# game/scripts/c29/c29.rpy:227
translate french c29s001_LisParty_84124514:

    # jen "Likewise, [mc]. Sorry for stealing your girlfriend, but it will only be for a little while."
    jen "De même, [mc]. Désolée de te voler ta petite amie, mais ce ne sera que pour un petit moment."

# game/scripts/c29/c29.rpy:228
translate french c29s001_LisParty_4c4d4878:

    # mc "Don't worry about it."
    mc "T'en fais pas pour ça."

# game/scripts/c29/c29.rpy:231
translate french c29s001_LisParty_5fa82abd:

    # lis "You are the best boyfriend in the world!"
    lis "Tu es le meilleur petit ami du monde !"

# game/scripts/c29/c29.rpy:232
translate french c29s001_LisParty_30ac6a47:

    # mc "*Laugh* And I'll be right here, at the bar waiting for the best girlfriend in the world. Well, in that corner."
    mc "*Rire* Et je serai juste là, au bar, à attendre la meilleure petite amie du monde. Enfin, dans ce coin-là."

# game/scripts/c29/c29.rpy:234
translate french c29s001_LisParty_6e77fb75:

    # "You head to the bartender and order a pineapple juice. You don't feel like drinking alone."
    "Vous vous dirigez vers le barman et commandez un jus d'ananas. Vous n'avez pas envie de boire seul."

# game/scripts/c29/c29.rpy:235
translate french c29s001_LisParty_aeca0d27:

    # "After a while..."
    "Après un moment..."

# game/scripts/c29/c29.rpy:236
translate french c29s001_LisParty_d5a26e97:

    # wom "Hey, I know you!"
    wom "Hé, je vous connais !"

# game/scripts/c29/c29.rpy:238
translate french c29s001_LisParty_228014cc:

    # mc "Hello... I don't recall your name. We saw each other at the San Luis airport about a month ago."
    mc "Bonjour... Je ne me souviens plus de votre nom. On s'est vus à l'aéroport de San Luis il y a environ un mois."

# game/scripts/c29/c29.rpy:239
translate french c29s001_LisParty_f4ed3db8:

    # olg "Olga. That's right, you were the one who came to pick up that beautiful girl... Kim? Kelly?"
    olg "Olga. C'est vrai, c'est vous qui êtes venu chercher cette magnifique fille... Kim ? Kelly ?"

# game/scripts/c29/c29.rpy:240
translate french c29s001_LisParty_1fb8da12:

    # mc "[kim]. I'm [mc]."
    mc "[kim]. Moi, c'est [mc]."

# game/scripts/c29/c29.rpy:241
translate french c29s001_LisParty_f5e5de13:

    # olg "Nice to meet you, [mc]. *Laugh* Meet you for the second time, of course."
    olg "Ravie de vous rencontrer, [mc]. *Rire* De vous rencontrer pour la deuxième fois, bien sûr."

# game/scripts/c29/c29.rpy:242
translate french c29s001_LisParty_72baf4a9:

    # mc "Likewise, Olga."
    mc "De même, Olga."

# game/scripts/c29/c29.rpy:244
translate french c29s001_LisParty_83a38109:

    # olg "Do you mind if I keep you company? My boss will be busy for a while. I assume whoever you brought here is busy too."
    olg "Ça vous dérange si je vous tiens compagnie ? Mon patron va être occupé pendant un moment. Je suppose que la personne que vous avez amenée ici est occupée aussi."

# game/scripts/c29/c29.rpy:245
translate french c29s001_LisParty_f320d15d:

    # mc "I don't know what you mean..."
    mc "Je ne vois pas de quoi vous parlez..."

# game/scripts/c29/c29.rpy:247
translate french c29s001_LisParty_f6eb3c6b:

    # olg "I assumed you were a driver or something... If you went to pick up [kim], and today you're here drinking juice..."
    olg "Je pensais que tu étais un chauffeur ou un truc du genre... Vu que tu es allé chercher [kim], et qu'aujourd'hui tu es là à boire du jus..."

# game/scripts/c29/c29.rpy:248
translate french c29s001_LisParty_7fdff375:

    # mc "*Laugh* Oh, no. I came with my girlfriend. She's a friend of the host."
    mc "*Rire* Oh, non. Je suis venu avec ma copine. C'est une amie de l'hôte."

# game/scripts/c29/c29.rpy:250
translate french c29s001_LisParty_60ce5514:

    # olg "Oops! Sorry."
    olg "Oups ! Désolée."

# game/scripts/c29/c29.rpy:251
translate french c29s001_LisParty_6e4d595f:

    # mc "Don't worry about it. The confusion is normal. So, you work for someone at this party?"
    mc "T'inquiète pas. C'est normal de se tromper. Alors, tu travailles pour quelqu'un à cette soirée ?"

# game/scripts/c29/c29.rpy:253
translate french c29s001_LisParty_012159c6:

    # olg "Yes, I'm her personal assistant. But these parties bore me."
    olg "Oui, je suis son assistante personnelle. Mais ces soirées m'ennuient."

# game/scripts/c29/c29.rpy:254
translate french c29s001_LisParty_d88fa85b:

    # mc "I guess meeting the rich and famous stops being interesting after the third or fourth time."
    mc "J'imagine que rencontrer des gens riches et célèbres n'est plus très intéressant après la troisième ou quatrième fois."

# game/scripts/c29/c29.rpy:256
translate french c29s001_LisParty_516ea2ab:

    # olg "*Laugh* Exactly. It ends up being more interesting to talk to the people surrounding them."
    olg "*Rire* Exactement. Ça finit par être plus intéressant de parler aux gens qui les entourent."

# game/scripts/c29/c29.rpy:257
translate french c29s001_LisParty_49a1eb43:

    # olg "Unless you're a huge fan of someone, of course."
    olg "À moins d'être un grand fan de quelqu'un, bien sûr."

# game/scripts/c29/c29.rpy:258
translate french c29s001_LisParty_f313b5c9:

    # mc "That's not my case, but I'm sure one of my cousins would be totally starstruck."
    mc "Ce n'est pas mon cas, mais je suis sûr qu'une de mes cousines serait complètement éblouie."

# game/scripts/c29/c29.rpy:259
translate french c29s001_LisParty_e87d582f:

    # mc "A little while ago I saw Taylor Shift. She's her favorite singer."
    mc "Il y a un instant, j'ai vu Taylor Shift. C'est sa chanteuse préférée."

# game/scripts/c29/c29.rpy:261
translate french c29s001_LisParty_e00d2266:

    # olg "Look, there she is."
    olg "Regarde, elle est là."

# game/scripts/c29/c29.rpy:262
translate french c29s001_LisParty_3018769e:

    # mc "Is the other girl...?"
    mc "Est-ce que l'autre fille... ?"

# game/scripts/c29/c29.rpy:263
translate french c29s001_LisParty_3cc9f3c5:

    # olg "Yes, that's her. A very nice girl."
    olg "Oui, c'est elle. Une fille très gentille."

# game/scripts/c29/c29.rpy:264
translate french c29s001_LisParty_7366607d:

    # mc "Well, now my cousin would be totally starstruck. Her two favorite singers in the same place."
    mc "Eh bien, ma cousine serait complètement éblouie. Ses deux chanteuses préférées au même endroit."

# game/scripts/c29/c29.rpy:266
translate french c29s001_LisParty_b3429eed:

    # olg "Do you want me to tell them you want to take a selfie with them to send to your cousin?"
    olg "Tu veux que je leur dise que tu veux prendre un selfie avec elles pour l'envoyer à ta cousine ?"

# game/scripts/c29/c29.rpy:267
translate french c29s001_LisParty_1499b1ae:

    # mc "That won't be necessary. I'm not much for selfies or celebrities. *Laugh* Just telling [dap] that I was at the same party as them will make her die of envy."
    mc "Ce ne sera pas nécessaire. Je ne suis pas très porté sur les selfies ou les célébrités. *Rires* Rien que de dire à [dap] que j'étais à la même soirée qu'elles la fera mourir de jalousie."

# game/scripts/c29/c29.rpy:268
translate french c29s001_LisParty_86079a21:

    # mc "Besides, I think these kinds of people, celebrities, don't come to these parties for fans to take pictures with them."
    mc "En plus, je pense que ce genre de personnes, les célébrités, ne viennent pas à ces soirées pour que les fans prennent des photos avec elles."

# game/scripts/c29/c29.rpy:270
translate french c29s001_LisParty_a050c391:

    # olg "It's true that they usually don't like it, but I know both of them, and they probably wouldn't mind if I asked."
    olg "C'est vrai qu'elles n'aiment généralement pas ça, mais je les connais toutes les deux, et ça ne les dérangerait probablement pas si je le demandais."

# game/scripts/c29/c29.rpy:271
translate french c29s001_LisParty_9ba930e8:

    # olg "Especially if I tell them you came all the way from San Luis. That must be... What? 4 or 5 hours driving?"
    olg "Surtout si je leur dis que tu as fait tout le chemin depuis San Luis. Ça doit faire... Quoi ? 4 ou 5 heures de route ?"

# game/scripts/c29/c29.rpy:272
translate french c29s001_LisParty_32283a60:

    # mc "More or less, but I'm not from San Luis, I'm from Newport. A nearby city."
    mc "Plus ou moins, mais je ne suis pas de San Luis, je suis de Newport. Une ville voisine."

# game/scripts/c29/c29.rpy:274
translate french c29s001_LisParty_223cfb27:

    # olg "From Newport? My sister and my brother live there! Well, my half-siblings..."
    olg "De Newport ? Ma sœur et mon frère y vivent ! Enfin, mes demi-frère et sœur..."

# game/scripts/c29/c29.rpy:275
translate french c29s001_LisParty_6d6228be:

    # mc "*Laugh* I think you and I are destined for something. It's too many coincidences, isn't it?"
    mc "*Rires* Je crois que toi et moi sommes destinés à quelque chose. Ça fait beaucoup de coïncidences, non ?"

# game/scripts/c29/c29.rpy:277
translate french c29s001_LisParty_9d6fc455:

    # olg "*Laugh* You're right. We've run into each other a couple of times in places where neither of us live."
    olg "*Rire* Tu as raison. On s'est croisés quelques fois dans des endroits où aucun de nous ne vit."

# game/scripts/c29/c29.rpy:278
translate french c29s001_LisParty_2cb5ca5f:

    # olg "And my family lives in the same city as you. It would be a huge coincidence if you knew them."
    olg "Et ma famille vit dans la même ville que toi. Ce serait une énorme coïncidence si tu les connaissais."

# game/scripts/c29/c29.rpy:279
translate french c29s001_LisParty_c7554716:

    # mc "*Laugh* Newport isn't Los Angeles, but it's not a town with a hundred inhabitants either. I don't know everyone in the city."
    mc "*Rire* Newport n'est pas Los Angeles, mais ce n'est pas non plus un village de cent habitants. Je ne connais pas tout le monde en ville."

# game/scripts/c29/c29.rpy:280
translate french c29s001_LisParty_98762c14:

    # mc "Besides, I've been away for a few years, studying in Portland."
    mc "En plus, je suis parti quelques années pour étudier à Portland."

# game/scripts/c29/c29.rpy:282
translate french c29s001_LisParty_f267babd:

    # olg "Well, I think it's time for me to go. Here comes my boss."
    olg "Bon, je crois qu'il est temps pour moi d'y aller. Voilà mon patron."

# game/scripts/c29/c29.rpy:283
translate french c29s001_LisParty_21ac95f6:

    # mc "It was great seeing you again, even if it was for an encounter almost as brief as the last time."
    mc "C'était super de te revoir, même si c'était pour une rencontre presque aussi brève que la dernière fois."

# game/scripts/c29/c29.rpy:284
translate french c29s001_LisParty_2cac3785:

    # olg "Likewise, [mc]. If I ever go visit my siblings, I'm sure we won't run into each other."
    olg "De même, [mc]. Si jamais je vais rendre visite à mes frères et sœurs, je suis sûre qu'on ne se croisera pas."

# game/scripts/c29/c29.rpy:285
translate french c29s001_LisParty_31665faf:

    # mc "*Laugh* Write down my number if you want, and call me when you go."
    mc "*Rire* Note mon numéro si tu veux, et appelle-moi quand tu y vas."

# game/scripts/c29/c29.rpy:287
translate french c29s001_LisParty_db15a403:

    # olg "I think I prefer them to remain casual encounters. *Laugh* If we plan something, we might lose our magic."
    olg "Je crois que je préfère que ça reste des rencontres fortuites. *Rire* Si on prévoit quelque chose, on risque de perdre notre magie."

# game/scripts/c29/c29.rpy:288
translate french c29s001_LisParty_155c8cc2:

    # mc "*Laugh* Whatever works for you. Until the next casual encounter."
    mc "*Rire* Comme tu veux. À la prochaine rencontre fortuite."

# game/scripts/c29/c29.rpy:290
translate french c29s001_LisParty_0adc3382:

    # hal "Hello. Am I interrupting something?"
    hal "Bonjour. J'interromps quelque chose ?"

# game/scripts/c29/c29.rpy:292
translate french c29s001_LisParty_7ea4f864:

    # olg "No, Halley. This is [mc]. This is Halley, my boss."
    olg "Non, Halley. Voici [mc]. Voici Halley, ma patronne."

# game/scripts/c29/c29.rpy:293
translate french c29s001_LisParty_1fe6d187:

    # hal "Hello, [mc]. Do you mind if I steal my assistant back?"
    hal "Bonjour, [mc]. Ça te dérange si je récupère mon assistante ?"

# game/scripts/c29/c29.rpy:294
translate french c29s001_LisParty_c6a78234:

    # mc "Nice to meet you, Halley. And don't worry, Olga is your assistant, after all."
    mc "Ravi de te rencontrer, Halley. Et ne t'inquiète pas, Olga est ton assistante, après tout."

# game/scripts/c29/c29.rpy:296
translate french c29s001_LisParty_0ee44f2f:

    # hal "We can leave whenever you want. Or you can stay, if you prefer."
    hal "On peut partir quand tu veux. Ou tu peux rester, si tu préfères."

# game/scripts/c29/c29.rpy:297
translate french c29s001_LisParty_308a290d:

    # olg "It's not necessary. We can go. *Giggle* [mc] and I prefer brief encounters."
    olg "Ce n'est pas la peine. On peut y aller. *Glousse* [mc] et moi préférons les rencontres brèves."

# game/scripts/c29/c29.rpy:299
translate french c29s001_LisParty_360c4275:

    # olg "Well, [mc]. Until next time, whether it's in Newport, New York, or a Caribbean island."
    olg "Eh bien, [mc]. À la prochaine, que ce soit à Newport, New York, ou sur une île des Caraïbes."

# game/scripts/c29/c29.rpy:300
translate french c29s001_LisParty_5d013122:

    # mc "Until next time, Olga. Take care."
    mc "À la prochaine, Olga. Prends soin de toi."

# game/scripts/c29/c29.rpy:302
translate french c29s001_LisParty_eed5c47f:

    # hal "See you later, [mc]."
    hal "À plus tard, [mc]."

# game/scripts/c29/c29.rpy:303
translate french c29s001_LisParty_f9df8820:

    # mc "See you later, Halley."
    mc "À plus tard, Halley."

# game/scripts/c29/c29.rpy:305
translate french c29s001_LisParty_b2bdf5dd:

    # "You are left alone at the bar again. You order another pineapple juice."
    "Tu te retrouves de nouveau seul au bar. Tu commandes un autre jus d'ananas."

# game/scripts/c29/c29.rpy:306
translate french c29s001_LisParty_2b04c5d7:

    # "Although 'alone' is relative, since people keep coming and going without interacting with you."
    "Bien que « seul » soit relatif, vu que les gens n'arrêtent pas d'aller et venir sans interagir avec toi."

# game/scripts/c29/c29.rpy:307
translate french c29s001_LisParty_f2087289:

    # "You suppose that the regulars at these parties must be having a good time."
    "Tu supposes que les habitués de ces soirées doivent bien s'amuser."

# game/scripts/c29/c29.rpy:308
translate french c29s001_LisParty_000cf23e:

    # "But you expected something different on your first date with [lis]. You understand she hasn't seen her friends in a while, but you feel lonely and bored."
    "Mais tu t'attendais à autre chose pour ton premier rencard avec [lis]. Tu comprends qu'elle n'ait pas vu ses amis depuis un moment, mais tu te sens seul et tu t'ennuies."

# game/scripts/c29/c29.rpy:309
translate french c29s001_LisParty_1999e859:

    # "When you are on your third pineapple juice..."
    "Alors que tu en es à ton troisième jus d'ananas..."

# game/scripts/c29/c29.rpy:311
translate french c29s001_LisParty_894ed6c9:

    # ska "Don't you like these parties?"
    ska "Vous n'aimez pas ces soirées ?"

# game/scripts/c29/c29.rpy:312
translate french c29s001_LisParty_292ac2ed:

    # mc "Not really... Oh! You're Scarlett Johnson..."
    mc "Pas vraiment... Oh ! Vous êtes Scarlett Johnson..."

# game/scripts/c29/c29.rpy:314
translate french c29s001_LisParty_5272e16b:

    # ska "*Laugh* Yes, last time I checked, that was me."
    ska "*Rires* Oui, aux dernières nouvelles, c'est bien moi."

# game/scripts/c29/c29.rpy:315
translate french c29s001_LisParty_95acdeab:

    # mc "Sorry. I'm not used to these environments. Nor running into singers and actors every two minutes."
    mc "Désolé. Je ne suis pas habitué à ce genre d'environnement. Ni à croiser des chanteurs et des acteurs toutes les deux minutes."

# game/scripts/c29/c29.rpy:316
translate french c29s001_LisParty_5b8c892d:

    # mc "*Laugh* I guess it will pass after four or five more celebrities."
    mc "*Rires* J'imagine que ça passera après quatre ou cinq autres célébrités."

# game/scripts/c29/c29.rpy:317
translate french c29s001_LisParty_31a34033:

    # ska "*Laugh* Some people never get used to it. But it's better to adapt."
    ska "*Rires* Certains ne s'y habituent jamais. Mais il vaut mieux s'adapter."

# game/scripts/c29/c29.rpy:318
translate french c29s001_LisParty_2e28ad86:

    # mc "I'm [mc]. *Laugh* I'm not famous."
    mc "Je suis [mc]. *Rires* Je ne suis pas célèbre."

# game/scripts/c29/c29.rpy:320
translate french c29s001_LisParty_a9c71ca8:

    # ska "Let me guess. Someone brought you to this party where you don't know anyone and left you alone."
    ska "Laissez-moi deviner. Quelqu'un vous a amené à cette soirée où vous ne connaissez personne et vous a laissé tout seul."

# game/scripts/c29/c29.rpy:321
translate french c29s001_LisParty_9084df31:

    # mc "More or less. My girlfriend is friends with Sidney and some other people here. She hadn't seen them in a while and they are catching up."
    mc "Plus ou moins. Ma copine est amie avec Sidney et d'autres personnes ici. Elle ne les avait pas vus depuis un moment et ils rattrapent le temps perdu."

# game/scripts/c29/c29.rpy:322
translate french c29s001_LisParty_93a851c8:

    # ska "And, since this is your first time at one of these parties, you don't know who to talk to."
    ska "Et, vu que c'est ta première fois à une de ces soirées, tu ne sais pas à qui parler."

# game/scripts/c29/c29.rpy:323
translate french c29s001_LisParty_c1edb5c4:

    # mc "Neither who, nor what to talk about. I don't think I have many interests in common with 90%% of the people at this party."
    mc "Ni à qui, ni de quoi parler. Je ne pense pas avoir beaucoup de centres d'intérêt en commun avec 90%% des gens à cette soirée."

# game/scripts/c29/c29.rpy:324
translate french c29s001_LisParty_769f95ba:

    # mc "Hey! *Laugh* But I'm talking to Scarlett Johnson!"
    mc "Hé ! *Rire* Mais je suis en train de parler à Scarlett Johnson !"

# game/scripts/c29/c29.rpy:325
translate french c29s001_LisParty_e120103f:

    # mcp "(And I know someone who could be your replacement playing Natasha. It's a role [eva] would be perfect for.)"
    mcp "(Et je connais quelqu'un qui pourrait te remplacer pour jouer Natasha. C'est un rôle pour lequel [eva] serait parfaite.)"

# game/scripts/c29/c29.rpy:327
translate french c29s001_LisParty_1fa3f870:

    # ska "*Laugh* With whom you probably don't have many interests in common."
    ska "*Rire* Avec qui tu n'as probablement pas beaucoup de centres d'intérêt en commun."

# game/scripts/c29/c29.rpy:328
translate french c29s001_LisParty_3069ddbb:

    # mc "*Laugh* Touché."
    mc "*Rire* Touché."

# game/scripts/c29/c29.rpy:330
translate french c29s001_LisParty_ed7786b7:

    # ska "Most of us are normal people, or we try to keep behaving as we were before all this."
    ska "La plupart d'entre nous sommes des gens normaux, ou du moins on essaie de continuer à se comporter comme on l'était avant tout ça."

# game/scripts/c29/c29.rpy:331
translate french c29s001_LisParty_720e483a:

    # ska "You'll find a few who believe that because they achieved fame, they are special, but it's still just a job."
    ska "Tu en trouveras quelques-uns qui croient que parce qu'ils ont atteint la célébrité, ils sont spéciaux, mais ça reste juste un boulot."

# game/scripts/c29/c29.rpy:332
translate french c29s001_LisParty_2d16feef:

    # mc "No offense, but how old were you when you started acting? Do you really remember what a normal life was like before that?"
    mc "Sans vouloir t'offenser, quel âge avais-tu quand tu as commencé à jouer ? Tu te souviens vraiment de ce qu'était une vie normale avant ça ?"

# game/scripts/c29/c29.rpy:334
translate french c29s001_LisParty_05fd065f:

    # ska "*Laugh* Now it's my turn to say 'Touché'. Not many people think about that."
    ska "*Rire* Maintenant c'est à mon tour de dire 'Touché'. Peu de gens y pensent."

# game/scripts/c29/c29.rpy:335
translate french c29s001_LisParty_36f62228:

    # mc "I think I've watched you acting since I was born. It's logical to think that way."
    mc "I think I've watched you acting since I was born. It's logical to think that way."

# game/scripts/c29/c29.rpy:337
translate french c29s001_LisParty_676f94bf:

    # ska "*Laugh* I'm not that old!"
    ska "*Laugh* I'm not that old!"

# game/scripts/c29/c29.rpy:338
translate french c29s001_LisParty_ff8e2efe:

    # mc "*Laugh* And I'm not as old as I look."
    mc "*Laugh* And I'm not as old as I look."

# game/scripts/c29/c29.rpy:340
translate french c29s001_LisParty_2e9bbaac:

    # ska "My first movie was in 1994. Where were you then?"
    ska "My first movie was in 1994. Where were you then?"

# game/scripts/c29/c29.rpy:341
translate french c29s001_LisParty_58aa581f:

    # mc "I don't think I was even a thought in my parents' minds back then. My mother was 12."
    mc "I don't think I was even a thought in my parents' minds back then. My mother was 12."

# game/scripts/c29/c29.rpy:343
translate french c29s001_LisParty_c87abfee:

    # ska "*Laugh* You just made me feel like a fossil. As if half the girls at this party weren't already doing that."
    ska "*Laugh* You just made me feel like a fossil. As if half the girls at this party weren't already doing that."

# game/scripts/c29/c29.rpy:344
translate french c29s001_LisParty_1f757312:

    # mc "*Laugh* I told you I've been watching you act since I was born..."
    mc "*Laugh* I told you I've been watching you act since I was born..."

# game/scripts/c29/c29.rpy:345
translate french c29s001_LisParty_9403d4cd:

    # lis "And my boyfriend never lies, Scarlett."
    lis "And my boyfriend never lies, Scarlett."

# game/scripts/c29/c29.rpy:347
translate french c29s001_LisParty_1c1bc14e:

    # ska "What? You're the one who left this guy alone for so long, [lis]?"
    ska "What? You're the one who left this guy alone for so long, [lis]?"

# game/scripts/c29/c29.rpy:348
translate french c29s001_LisParty_086960a9:

    # lis "Don't make me feel guilty about that. I already feel bad enough."
    lis "Don't make me feel guilty about that. I already feel bad enough."

# game/scripts/c29/c29.rpy:349
translate french c29s001_LisParty_bddcc345:

    # lis "Besides, this way he had the chance to meet you."
    lis "Besides, this way he had the chance to meet you."

# game/scripts/c29/c29.rpy:351
translate french c29s001_LisParty_79f5e331:

    # ska "I didn't know you were coming. If I had known, I would have set aside more time for this party."
    ska "Je ne savais pas que tu venais. Si j'avais su, j'aurais prévu plus de temps pour cette fête."

# game/scripts/c29/c29.rpy:352
translate french c29s001_LisParty_d3191ac3:

    # ska "And even more so if I had known you were dating this nice guy. But they are waiting for me somewhere else."
    ska "Et encore plus si j'avais su que tu sortais avec ce mec sympa. Mais on m'attend ailleurs."

# game/scripts/c29/c29.rpy:353
translate french c29s001_LisParty_e3fe4cf6:

    # lis "You're always super busy. You need to learn to relax a little."
    lis "Tu es toujours super occupée. Tu dois apprendre à te détendre un peu."

# game/scripts/c29/c29.rpy:355
translate french c29s001_LisParty_3a2f07ed:

    # ska "*Laugh* The day you learn which dictionary you need to look up the word 'relax' in."
    ska "*Rire* Le jour où tu apprendras dans quel dictionnaire chercher le mot 'détente'."

# game/scripts/c29/c29.rpy:356
translate french c29s001_LisParty_c8688883:

    # lis "*Laugh* I think I could give you advice on where to look for it. I've already found it."
    lis "*Rire* Je pense que je pourrais te donner des conseils sur où le chercher. Je l'ai déjà trouvé."

# game/scripts/c29/c29.rpy:358
translate french c29s001_LisParty_201423a5:

    # ska "Let me look at you..."
    ska "Laisse-moi te regarder..."

# game/scripts/c29/c29.rpy:359
translate french c29s001_LisParty_eab16225:

    # ska "..."
    ska "..."

# game/scripts/c29/c29.rpy:360
translate french c29s001_LisParty_96cb31fb:

    # ska "I hadn't noticed, but you're right. There's something different about you, something that says you're in a much better place than the last time I saw you."
    ska "Je n'avais pas remarqué, mais tu as raison. Il y a quelque chose de différent chez toi, quelque chose qui dit que tu es dans une bien meilleure passe que la dernière fois que je t'ai vue."

# game/scripts/c29/c29.rpy:361
translate french c29s001_LisParty_74abd93c:

    # ska "And that hair... I love it. The [lis] from three months ago would never have worn it like that."
    ska "Et ces cheveux... J'adore. La [lis] d'il y a trois mois ne les aurait jamais portés comme ça."

# game/scripts/c29/c29.rpy:362
translate french c29s001_LisParty_4fa0bf7b:

    # lis "I'm much better, Scarlett. Moving to Newport has had... unexpected effects."
    lis "Je vais beaucoup mieux, Scarlett. Déménager à Newport a eu... des effets inattendus."

# game/scripts/c29/c29.rpy:363
translate french c29s001_LisParty_a7f983ba:

    # mc "*Laugh* Also in Newport. Clothing sales have multiplied in the last month."
    mc "*Rire* À Newport aussi. Les ventes de vêtements se sont multipliées ce dernier mois."

# game/scripts/c29/c29.rpy:365
translate french c29s001_LisParty_9e2c523d_1:

    # lis "*Laugh* Idiot."
    lis "*Rires* Idiot."

# game/scripts/c29/c29.rpy:366
translate french c29s001_LisParty_df828034:

    # ska "*Laugh* If this is the result, it's a good thing. And I don't just mean a good thing for local commerce in Newport."
    ska "*Rires* Si c'est le résultat, c'est une bonne chose. Et je ne parle pas seulement d'une bonne chose pour le commerce local de Newport."

# game/scripts/c29/c29.rpy:367
translate french c29s001_LisParty_11895ee4:

    # mc "*Laugh* There are a couple of stores thinking about buying red carpets for when [lis] arrives."
    mc "*Rires* Il y a quelques magasins qui pensent à acheter des tapis rouges pour quand [lis] arrive."

# game/scripts/c29/c29.rpy:369
translate french c29s001_LisParty_d257d4c3:

    # ska "Guys, I'd love to stay and chat with you, but as I already told you, I'm expected somewhere else."
    ska "Les gars, j'adorerais rester discuter avec vous, mais comme je vous l'ai déjà dit, on m'attend ailleurs."

# game/scripts/c29/c29.rpy:370
translate french c29s001_LisParty_ef70fc5b:

    # ska "Chris was throwing a party today too. Only for fossils over 35."
    ska "Chris organisait une fête aujourd'hui aussi. Uniquement pour les fossiles de plus de 35 ans."

# game/scripts/c29/c29.rpy:371
translate french c29s001_LisParty_dabc054b:

    # lis "Prat or Evan? I saw Hemswort around here a while ago, so it can't be him. Well, it doesn't matter. I like both of them. Give them a kiss for me."
    lis "Prat ou Evan ? J'ai vu Hemswort dans le coin il y a un moment, donc ça ne peut pas être lui. Bref, peu importe. Je les aime bien tous les deux. Fais-leur un bisou de ma part."

# game/scripts/c29/c29.rpy:372
translate french c29s001_LisParty_8e8f47a1:

    # mc "*Laugh* You don't even need to say hi to them for me. I'm sure they won't remember me."
    mc "*Rires* Tu n'as même pas besoin de leur dire bonjour de ma part. Je suis sûr qu'ils ne se souviendront pas de moi."

# game/scripts/c29/c29.rpy:374
translate french c29s001_LisParty_4da31d28:

    # ska "You've met them already? They didn't tell me [lis] was dating someone."
    ska "Tu les as déjà rencontrés ? Ils ne m'ont pas dit que [lis] sortait avec quelqu'un."

# game/scripts/c29/c29.rpy:375
translate french c29s001_LisParty_1b22e0a8:

    # mc "*Laugh* Nope. That's why they won't remember me."
    mc "*Rires* Non. C'est pour ça qu'ils ne se souviendront pas de moi."

# game/scripts/c29/c29.rpy:377
translate french c29s001_LisParty_0922c26d:

    # ska "*Laugh* I like your boyfriend's sense of humor."
    ska "*Rires* J'aime bien l'humour de ton mec."

# game/scripts/c29/c29.rpy:378
translate french c29s001_LisParty_28370279:

    # ska "But seriously, I have to go or Chris will kill me."
    ska "Mais sérieusement, je dois y aller ou Chris va me tuer."

# game/scripts/c29/c29.rpy:379
translate french c29s001_LisParty_d7947a35:

    # lis "We won't keep you any longer. Besides, I have to make it up to [mc] for leaving him alone for so long."
    lis "On ne va pas vous retenir plus longtemps. Et puis, je dois me faire pardonner auprès de [mc] pour l'avoir laissé seul si longtemps."

# game/scripts/c29/c29.rpy:381
translate french c29s001_LisParty_b7f40313:

    # ska "Take care of this girl. She's one of the good ones."
    ska "Prends soin de cette fille. C'est une fille bien."

# game/scripts/c29/c29.rpy:382
translate french c29s001_LisParty_cb1928b7:

    # mc "Don't worry. I will. Now go before one of the Chrises kills you."
    mc "T'inquiète pas. Je le ferai. Maintenant file avant qu'un des Chris ne te tue."

# game/scripts/c29/c29.rpy:385
translate french c29s001_LisParty_1a17c915:

    # lis "I'm sorry I left you alone. I wanted to come back, but I kept running into people and..."
    lis "Je suis désolée de t'avoir laissé seul. Je voulais revenir, mais je n'arrêtais pas de croiser du monde et..."

# game/scripts/c29/c29.rpy:386
translate french c29s001_LisParty_d8f26b75:

    # mc "Don't worry, I get it. You hadn't seen your friends in months, and you wanted to catch up with them."
    mc "T'inquiète, je comprends. Tu n'avais pas vu tes amis depuis des mois, et tu voulais rattraper le temps perdu avec eux."

# game/scripts/c29/c29.rpy:388
translate french c29s001_LisParty_6568d44b:

    # lis "Yes, but I wanted to be with you too. This isn't what I had planned for our first date."
    lis "Oui, mais je voulais être avec toi aussi. Ce n'est pas ce que j'avais prévu pour notre premier rencard."

# game/scripts/c29/c29.rpy:389
translate french c29s001_LisParty_a16cd5dc:

    # mc "[lis], sometimes things don't go as planned. And there will be more dates."
    mc "[lis], parfois les choses ne se passent pas comme prévu. Et il y aura d'autres rencards."

# game/scripts/c29/c29.rpy:391
translate french c29s001_LisParty_0752ae83:

    # lis "But there will never be a first date again..."
    lis "Mais il n'y aura plus jamais de premier rencard..."

# game/scripts/c29/c29.rpy:392
translate french c29s001_LisParty_dfce5d9d:

    # mc "That's easy to fix. I'm breaking up with you."
    mc "C'est facile à arranger. Je romps avec toi."

# game/scripts/c29/c29.rpy:394
translate french c29s001_LisParty_4f78a3e9:

    # lis "What?"
    lis "Quoi ?"

# game/scripts/c29/c29.rpy:395
translate french c29s001_LisParty_ba82f3b4:

    # mc "Do you want to go on a date with me?"
    mc "Tu veux sortir avec moi ?"

# game/scripts/c29/c29.rpy:397
translate french c29s001_LisParty_4f78a3e9_1:

    # lis "What?"
    lis "Quoi ?"

# game/scripts/c29/c29.rpy:398
translate french c29s001_LisParty_533c3583:

    # mc "If you say yes, we can start our second first date right now."
    mc "Si tu dis oui, on peut commencer notre deuxième premier rencard tout de suite."

# game/scripts/c29/c29.rpy:400
translate french c29s001_LisParty_5fa82abd_1:

    # lis "You're the best boyfriend in the world!"
    lis "T'es le meilleur petit ami du monde !"

# game/scripts/c29/c29.rpy:401
translate french c29s001_LisParty_38c58766:

    # mc "*Laugh* Right now I'm just the best ex-boyfriend in the world. You haven't said yes yet."
    mc "*Rire* Pour l'instant, je suis juste le meilleur ex du monde. Tu n'as pas encore dit oui."

# game/scripts/c29/c29.rpy:402
translate french c29s001_LisParty_76cb2aaa:

    # lis "Of course I want to go on a date with you!"
    lis "Bien sûr que je veux sortir avec toi !"

# game/scripts/c29/c29.rpy:404
translate french c29s001_LisParty_9ce55039:

    # "The relief the girl feels is reflected in how her lips greet yours."
    "Le soulagement que ressent la fille se reflète dans la façon dont ses lèvres accueillent les tiennes."

# game/scripts/c29/c29.rpy:405
translate french c29s001_LisParty_41682c14:

    # "What started as an awkward night changes in a moment. For the better."
    "Ce qui avait commencé comme une soirée gênante change en un instant. Pour le mieux."

# game/scripts/c29/c29.rpy:407
translate french c29s001_LisParty_a28953c2:

    # "The celebrities and [lis]'s friends cease to exist, and it feels like you are alone at the party as your tongues intertwine."
    "Les célébrités et les amis de [lis] cessent d'exister, et c'est comme si vous étiez seuls à la fête alors que vos langues s'entremêlent."

# game/scripts/c29/c29.rpy:409
translate french c29s001_LisParty_ac1d45e6:

    # "Even the party disappears around you. There is no apartment. There is no music. There is nothing except the two of you and a long kiss."
    "Même la fête disparaît autour de vous. Il n'y a plus d'appartement. Il n'y a plus de musique. Il n'y a plus rien, à part vous deux et un long baiser."

# game/scripts/c29/c29.rpy:410
translate french c29s001_LisParty_1107fc5a:

    # "Your world at that moment is only inhabited by the two of you."
    "À cet instant, votre monde n'est habité que par vous deux."

# game/scripts/c29/c29.rpy:412
translate french c29s001_LisParty_820c46a5:

    # mc "This party just got a lot better."
    mc "Cette soirée vient de devenir vachement mieux."

# game/scripts/c29/c29.rpy:413
translate french c29s001_LisParty_e20c95b6:

    # lis "Thanks for breaking up with me... And for asking me out again."
    lis "Merci d'avoir rompu avec moi... Et de m'avoir invitée à sortir à nouveau."

# game/scripts/c29/c29.rpy:414
translate french c29s001_LisParty_b5f7e227:

    # mc "*Laugh* I couldn't let another guy take the prettiest girl at the party now that she was single again."
    mc "*Rire* Je ne pouvais pas laisser un autre mec prendre la plus belle fille de la fête maintenant qu'elle était de nouveau célibataire."

# game/scripts/c29/c29.rpy:416
translate french c29s001_LisParty_2895657c:

    # lis "*Laugh* But let this be the last time you break up with me. Next time there might be a knife nearby."
    lis "*Rire* Mais que ce soit la dernière fois que tu romps avec moi. La prochaine fois, il pourrait y avoir un couteau dans le coin."

# game/scripts/c29/c29.rpy:417
translate french c29s001_LisParty_60ab4b40:

    # mc "I'm not going to push my luck a second time. *Laugh* Imagine if you said no when I asked you out."
    mc "Je ne vais pas tenter le diable une deuxième fois. *Rire* Imagine si tu avais dit non quand je t'ai invitée."

# game/scripts/c29/c29.rpy:418
translate french c29s001_LisParty_daa0756b:

    # mc "If you want this to end, you'll have to be the one to do it."
    mc "Si tu veux que ça se termine, ce sera à toi de le faire."

# game/scripts/c29/c29.rpy:420
translate french c29s001_LisParty_ae5b8e90:

    # lis "Want this to end? It's just started!"
    lis "Que ça se termine ? Ça vient juste de commencer !"

# game/scripts/c29/c29.rpy:422
translate french c29s001_LisParty_9cf72a99:

    # lis "Come on, I want to dance with you."
    lis "Allez, je veux danser avec toi."

# game/scripts/c29/c29.rpy:423
translate french c29s001_LisParty_f5271567:

    # mc "That sounds like a good idea."
    mc "Ça m'a l'air d'être une bonne idée."

# game/scripts/c29/c29.rpy:425
translate french c29s001_LisParty_0a8a796b:

    # "You spend the next few minutes dancing in silence, unsure if you are moving to the rhythm of the nonexistent music."
    "Vous passez les minutes suivantes à danser en silence, sans savoir si vous bougez au rythme de la musique inexistante."

# game/scripts/c29/c29.rpy:426
translate french c29s001_LisParty_1881c26b:

    # "No words are needed. Your arms around each other say everything necessary."
    "Aucun mot n'est nécessaire. Vos bras l'un autour de l'autre disent tout ce qu'il faut."

# game/scripts/c29/c29.rpy:427
translate french c29s001_LisParty_fda42bcd:

    # "You don't care what other people are doing around you, because there is no one else."
    "Vous vous fichez de ce que font les autres autour de vous, car il n'y a personne d'autre."

# game/scripts/c29/c29.rpy:428
translate french c29s001_LisParty_d039f828:

    # "You hold your world in your arms. A world that embraces you in return."
    "Tu tiens ton monde entre tes bras. Un monde qui t'enlace en retour."

# game/scripts/c29/c29.rpy:430
translate french c29s001_LisParty_f6c822b3:

    # "But all good things come to an end, and someone enters your private bubble."
    "Mais toutes les bonnes choses ont une fin, et quelqu'un pénètre dans votre bulle privée."

# game/scripts/c29/c29.rpy:431
translate french c29s001_LisParty_2d68492c:

    # jen "[lis], I came to say goodbye."
    jen "[lis], je suis venue te dire au revoir."

# game/scripts/c29/c29.rpy:432
translate french c29s001_LisParty_d4fa3d47:

    # lis "You're leaving already? I arrived less than an hour ago! We barely had time to talk."
    lis "Tu pars déjà ? Je suis arrivée il y a moins d'une heure ! On a à peine eu le temps de parler."

# game/scripts/c29/c29.rpy:434
translate french c29s001_LisParty_c1a0dcca:

    # jen "Less than an hour? How beautiful love is when it starts! You've been dancing with [mc] for over an hour."
    jen "Moins d'une heure ? Comme l'amour est beau à ses débuts ! Ça fait plus d'une heure que tu danses avec [mc]."

# game/scripts/c29/c29.rpy:435
translate french c29s001_LisParty_413f6504:

    # jen "Everyone has been upstairs for a while now. You two are the only ones left here."
    jen "Tout le monde est monté depuis un moment déjà. Vous êtes les seuls qui restent ici."

# game/scripts/c29/c29.rpy:436
translate french c29s001_LisParty_2bde6888:

    # mc "Impossible! Ten minutes at most."
    mc "Impossible ! Dix minutes tout au plus."

# game/scripts/c29/c29.rpy:438
translate french c29s001_LisParty_d5be0e19:

    # jen "I've been waiting almost 30 minutes to approach and say goodbye to [lis]."
    jen "Ça fait presque 30 minutes que j'attends pour m'approcher et dire au revoir à [lis]."

# game/scripts/c29/c29.rpy:439
translate french c29s001_LisParty_5e1eb1fd:

    # jen "You looked so sweet that I didn't dare. But I have to go. I have a shoot tomorrow."
    jen "Vous aviez l'air si mignons que je n'osais pas. Mais je dois y aller. J'ai un shooting demain."

# game/scripts/c29/c29.rpy:441
translate french c29s001_LisParty_2107b012:

    # lis "Has that much time really passed?"
    lis "Autant de temps s'est vraiment écoulé ?"

# game/scripts/c29/c29.rpy:443
translate french c29s001_LisParty_3645f7bd:

    # jen "Yes, and it's been almost two hours since you left the pool."
    jen "Oui, et ça fait presque deux heures que vous avez quitté la piscine."

# game/scripts/c29/c29.rpy:444
translate french c29s001_LisParty_1708c55e:

    # jen "I was hoping to chat with you a bit longer, but it's fine. We'll see each other at the next party."
    jen "J'espérais discuter avec toi un peu plus longtemps, mais c'est pas grave. On se verra à la prochaine soirée."

# game/scripts/c29/c29.rpy:446
translate french c29s001_LisParty_b97c683d:

    # jen "I'm throwing a party at my place next month. You're invited, [mc]."
    jen "J'organise une soirée chez moi le mois prochain. Tu es invité, [mc]."

# game/scripts/c29/c29.rpy:447
translate french c29s001_LisParty_87d7cc15:

    # mc "Thanks, but that will be impossible. I'm leaving the country for a few months next week."
    mc "Merci, mais ça va être impossible. Je quitte le pays pour quelques mois la semaine prochaine."

# game/scripts/c29/c29.rpy:448
translate french c29s001_LisParty_b790514b:

    # jen "What a shame! I would have liked to get to know you better."
    jen "Quel dommage ! J'aurais aimé apprendre à mieux te connaître."

# game/scripts/c29/c29.rpy:450
translate french c29s001_LisParty_e8d10c10:

    # jen "I hope you do come, even if it's alone."
    jen "J'espère que tu viendras, même si tu es seule."

# game/scripts/c29/c29.rpy:451
translate french c29s001_LisParty_698ca636:

    # lis "I don't know. Next month I'll have exams and the start of the new term. Send me a message with the details and I'll confirm."
    lis "Je ne sais pas. Le mois prochain, j'aurai des examens et le début du nouveau semestre. Envoie-moi un message avec les détails et je te confirmerai."

# game/scripts/c29/c29.rpy:453
translate french c29s001_LisParty_c98f6a10:

    # jen "Great. I'll write to you when I know the exact date. See you next month, [lis]."
    jen "Super. Je t'écrirai quand je connaîtrai la date exacte. On se voit le mois prochain, [lis]."

# game/scripts/c29/c29.rpy:454
translate french c29s001_LisParty_da485347:

    # lis "See you soon, Jenny."
    lis "À bientôt, Jenny."

# game/scripts/c29/c29.rpy:456
translate french c29s001_LisParty_7e9184f1:

    # jen "See you later, [mc]. I hope you come to one of my parties when you return to the country."
    jen "À plus tard, [mc]. J'espère que tu viendras à l'une de mes soirées quand tu seras de retour au pays."

# game/scripts/c29/c29.rpy:457
translate french c29s001_LisParty_930027ec:

    # mc "Definitely. See you later, Jenny."
    mc "Carrément. À plus tard, Jenny."

# game/scripts/c29/c29.rpy:460
translate french c29s001_LisParty_46205c19:

    # lis "Do you want to go to the bar for something to drink and sit down for a bit?"
    lis "Tu veux qu'on aille au bar pour boire un truc et s'asseoir un peu ?"

# game/scripts/c29/c29.rpy:461
translate french c29s001_LisParty_c521344b:

    # mc "Yes. My feet are telling me we've been dancing for a long time, but my head is telling me it's only been a few minutes."
    mc "Oui. Mes pieds me disent qu'on danse depuis un bon moment, mais ma tête me dit que ça ne fait que quelques minutes."

# game/scripts/c29/c29.rpy:463
translate french c29s001_LisParty_ad016c17:

    # lis "The same thing is happening to me. I can't believe we've been dancing for an hour."
    lis "Il m'arrive la même chose. Je n'arrive pas à croire qu'on danse depuis une heure."

# game/scripts/c29/c29.rpy:464
translate french c29s001_LisParty_55a2b8d0:

    # mc "My feet are like me. They don't lie. And I think Jenny said more than an hour."
    mc "Mes pieds sont comme moi. Ils ne mentent pas. Et je crois que Jenny a dit plus d'une heure."

# game/scripts/c29/c29.rpy:465
translate french c29s001_LisParty_891bd0c0:

    # mc "Find a place to sit down. What can I bring you to drink?"
    mc "Trouve une place pour t'asseoir. Qu'est-ce que je te rapporte à boire ?"

# game/scripts/c29/c29.rpy:467
translate french c29s001_LisParty_b0d056db:

    # "After picking up the drinks, you head towards the sofa where [lis] has sat down."
    "Après avoir récupéré les verres, tu te diriges vers le canapé où [lis] s'est assise."

# game/scripts/c29/c29.rpy:468
translate french c29s001_LisParty_467291c1:

    # "At a party surrounded by celebrities, it's clear who the real princess is."
    "Dans une soirée entourée de célébrités, il est clair qui est la vraie princesse."

# game/scripts/c29/c29.rpy:469
translate french c29s001_LisParty_16e9e361:

    # "Even if only the bartender and you two are left on this floor, it doesn't matter."
    "Même s'il ne reste plus que le barman et vous deux à cet étage, ça n'a pas d'importance."

# game/scripts/c29/c29.rpy:470
translate french c29s001_LisParty_e99fb34c:

    # "[lis] would shine brighter than any jewel in a treasure chamber."
    "[lis] brillerait plus que n'importe quel joyau dans une salle au trésor."

# game/scripts/c29/c29.rpy:473
translate french c29s001_LisParty_38e752a2:

    # mc "Is something wrong, [lis]?"
    mc "Quelque chose ne va pas, [lis] ?"

# game/scripts/c29/c29.rpy:474
translate french c29s001_LisParty_641e8f40:

    # lis "Why do you say that?"
    lis "Pourquoi tu dis ça ?"

# game/scripts/c29/c29.rpy:475
translate french c29s001_LisParty_f5149b14:

    # mc "Your body language tells me something happened."
    mc "Ton langage corporel me dit qu'il s'est passé quelque chose."

# game/scripts/c29/c29.rpy:476
translate french c29s001_LisParty_d9b8eebb:

    # mc "If it's because you left me alone for a bit, don't worry. I understand."
    mc "Si c'est parce que tu m'as laissé seul un moment, t'inquiète pas. Je comprends."

# game/scripts/c29/c29.rpy:478
translate french c29s001_LisParty_f71c52a9:

    # lis "It's not that. Or not entirely that."
    lis "C'est pas ça. Ou pas tout à fait ça."

# game/scripts/c29/c29.rpy:479
translate french c29s001_LisParty_f81a0029:

    # mc "Then explain what's wrong, please."
    mc "Alors explique-moi ce qui ne va pas, s'il te plaît."


# game/scripts/c29/c29.rpy:480
translate french c29s001_LisParty_0a14f1ae:

    # lis "I really wanted to come to this party with you and see my friends again. For you to meet them."
    lis "Je voulais vraiment venir à cette fête avec toi et revoir mes amis. Pour que tu les rencontres."

# game/scripts/c29/c29.rpy:481
translate french c29s001_LisParty_62d43a56:

    # mc "That makes sense. You hadn't seen them in a while."
    mc "C'est logique. Tu ne les avais pas vus depuis un moment."

# game/scripts/c29/c29.rpy:483
translate french c29s001_LisParty_e762cb45:

    # lis "Yes, and I spent that time surrounded by the Marks and the rest of the girls."
    lis "Oui, et j'ai passé ce temps entourée des Marks et du reste des filles."

# game/scripts/c29/c29.rpy:484
translate french c29s001_LisParty_29794af6:

    # mc "What does that have to do with anything?"
    mc "Qu'est-ce que ça a à voir avec tout ça ?"

# game/scripts/c29/c29.rpy:485
translate french c29s001_LisParty_c5ea3cc6:

    # lis "When I was upstairs, by the pool... I just wanted to come back to you."
    lis "Quand j'étais en haut, près de la piscine... je voulais juste revenir vers toi."

# game/scripts/c29/c29.rpy:486
translate french c29s001_LisParty_99e94d18:

    # mc "I'm flattered, but I understand you wanted to spend time with Jenny, Sidney, or whoever."
    mc "Je suis flatté, mais je comprends que tu aies voulu passer du temps avec Jenny, Sidney, ou peu importe."

# game/scripts/c29/c29.rpy:488
translate french c29s001_LisParty_b82b3495:

    # lis "But that's not it... I wanted you to get me out of there. To show up in your shining armor and riding your white horse to rescue me."
    lis "Mais c'est pas ça... Je voulais que tu me sortes de là. Que tu débarques dans ton armure étincelante sur ton cheval blanc pour me secourir."

# game/scripts/c29/c29.rpy:489
translate french c29s001_LisParty_88448909:

    # lis "I've discovered that I prefer a minute with [kim], [eva], [emm], or [mad.nick] over an hour with the girls I considered my friends."
    lis "J'ai découvert que je préfère une minute avec [kim], [eva], [emm] ou [mad.nick] à une heure avec les filles que je considérais comme mes amies."

# game/scripts/c29/c29.rpy:491
translate french c29s001_LisParty_760c7803:

    # lis "You guys have changed me so much... The conversations seemed empty. They only talked about filming, albums, who was dating whom..."
    lis "Vous m'avez tellement changée... Les conversations me semblaient vides. Elles ne parlaient que de tournages, d'albums, de qui sortait avec qui..."

# game/scripts/c29/c29.rpy:493
translate french c29s001_LisParty_3c31a23b:

    # lis "I wanted to talk about the family. About the harem. About [eva] and [ama]. About NTR and the Clone War..."
    lis "Je voulais parler de la famille. Du harem. De [eva] et [ama]. De NTR et de la Guerre des Clones..."

# game/scripts/c29/c29.rpy:495
translate french c29s001_LisParty_faa95afa:

    # lis "I wanted to talk about the family. About [eva] and [ama]. About NTR and the Clone War..."
    lis "Je voulais parler de la famille. De [eva] et [ama]. De NTR et de la Guerre des Clones..."

# game/scripts/c29/c29.rpy:496
translate french c29s001_LisParty_29bb002a:

    # lis "Compared to that, talking about who they are going to nominate for the Silvery Globes seems... simplistic..."
    lis "Comparé à ça, parler de qui elles vont nominer pour les Silvery Globes semble... simpliste..."

# game/scripts/c29/c29.rpy:497
translate french c29s001_LisParty_dadf1cdf:

    # mc "You can't compare friendships, [lis]. What we have at home is different from friends you see once a month or every couple of months at a party."
    mc "Tu ne peux pas comparer les amitiés, [lis]. Ce qu'on a à la maison est différent des amis que tu vois une fois par mois ou tous les deux mois à une soirée."

# game/scripts/c29/c29.rpy:498
translate french c29s001_LisParty_4ebb6574:

    # mc "You live with the girls at home every day, even several times a week with those who don't live there..."
    mc "Tu vis avec les filles à la maison tous les jours, même plusieurs fois par semaine avec celles qui n'y vivent pas..."

# game/scripts/c29/c29.rpy:500
translate french c29s001_LisParty_4c2fd4c3:

    # lis "That's what I mean. We evolve together. We know everything about each other. The good and the bad. We are real friends."
    lis "C'est ce que je veux dire. On évolue ensemble. On sait tout les unes des autres. Le bon comme le mauvais. On est de vraies amies."

# game/scripts/c29/c29.rpy:501
translate french c29s001_LisParty_409eef29:

    # lis "I like Jenny, Scarlett, and Sidney a lot, but we have a... superficial relationship."
    lis "J'aime beaucoup Jenny, Scarlett et Sidney, mais on a une relation... superficielle."

# game/scripts/c29/c29.rpy:504
translate french c29s001_LisParty_904bd1de:

    # lis "I would never dare tell them that I share you with other women."
    lis "Je n'oserais jamais leur dire que je te partage avec d'autres femmes."

# game/scripts/c29/c29.rpy:505
translate french c29s001_LisParty_5abd6aff:

    # lis "Or that I'm dating the owner of a company that does things that would be illegal in the United States."
    lis "Ou que je sors avec le propriétaire d'une entreprise qui fait des choses qui seraient illégales aux États-Unis."

# game/scripts/c29/c29.rpy:507
translate french c29s001_LisParty_4792d6b4:

    # lis "I would never dare tell them that I'm dating the owner of a company that does things that would be illegal in the United States."
    lis "Je n'oserais jamais leur dire que je sors avec le propriétaire d'une entreprise qui fait des choses qui seraient illégales aux États-Unis."

# game/scripts/c29/c29.rpy:508
translate french c29s001_LisParty_deff08d5:

    # lis "Or that two of my best friends are professional assassins. They would only see that. They wouldn't see past that."
    lis "Ou que deux de mes meilleures amies sont des tueuses à gages professionnelles. Elles ne verraient que ça. Elles ne verraient pas plus loin."

# game/scripts/c29/c29.rpy:509
translate french c29s001_LisParty_9d164788:

    # lis "They wouldn't try to understand how special [ama] and [eva] are. Or what they've been through."
    lis "Elles n'essaieraient pas de comprendre à quel point [ama] et [eva] sont spéciales. Ou ce qu'elles ont traversé."

# game/scripts/c29/c29.rpy:510
translate french c29s001_LisParty_3bab2975:

    # mc "And if you have to hide things that are important to you from your friends..."
    mc "Et si tu dois cacher des choses qui sont importantes pour toi à tes amies..."

# game/scripts/c29/c29.rpy:512
translate french c29s001_LisParty_5744c35f:

    # lis "Exactly. You wonder if they really are your friends or just girls you get along with in this environment."
    lis "Exactement. Tu te demandes si ce sont vraiment tes amies ou juste des filles avec qui tu t'entends bien dans cet environnement."

# game/scripts/c29/c29.rpy:513
translate french c29s001_LisParty_c23b5cbc:

    # mc "I understand. I think, at home, you've discovered what real friends are."
    mc "Je comprends. Je pense qu'à la maison, tu as découvert ce que sont de vraies amies."

# game/scripts/c29/c29.rpy:515
translate french c29s001_LisParty_28ce6d65:

    # lis "If I had to hide a body, these 'friends' would be scandalized. 'Little [lis]' killed someone?"
    lis "Si je devais cacher un corps, ces 'amies' seraient scandalisées. 'La petite [lis]' a tué quelqu'un ?"

# game/scripts/c29/c29.rpy:516
translate french c29s001_LisParty_ba3750de:

    # lis "[eva] would bring a shovel without asking questions. [ama] would dismember the corpse and ask questions later. But she wouldn't judge me, whatever the answers were."
    lis "[eva] apporterait une pelle sans poser de questions. [ama] démembrerait le cadavre et poserait des questions plus tard. Mais elle ne me jugerait pas, quelles que soient les réponses."

# game/scripts/c29/c29.rpy:517
translate french c29s001_LisParty_9d16cace:

    # lis "And [emm] would bring a bag with a pink ribbon so the dead person could arrive in the afterlife in style."
    lis "Et [emm] apporterait un sac avec un ruban rose pour que le mort puisse arriver dans l'au-delà avec style."

# game/scripts/c29/c29.rpy:519
translate french c29s001_LisParty_46255eed:

    # lis "I guess I didn't know I lacked real friends until today."
    lis "Je suppose que je ne savais pas que je manquais de vraies amies jusqu'à aujourd'hui."

# game/scripts/c29/c29.rpy:520
translate french c29s001_LisParty_2720c518:

    # mc "You don't lack friends. You have a bunch of them waiting for you at home."
    mc "Tu ne manques pas d'amies. Tu en as un paquet qui t'attendent à la maison."

# game/scripts/c29/c29.rpy:522
translate french c29s001_LisParty_ef8867fa:

    # lis "You're right... Get me out of here, please."
    lis "Tu as raison... Sors-moi de là, s'il te plaît."

# game/scripts/c29/c29.rpy:523
translate french c29s001_LisParty_a1bcb23e:

    # mc "I think you're the one who's going to have to get me out. I don't remember where the elevator is. But we should say goodbye to Sidney first."
    mc "Je crois que c'est toi qui vas devoir me sortir de là. Je ne me souviens pas où est l'ascenseur. Mais on devrait d'abord dire au revoir à Sidney."

# game/scripts/c29/c29.rpy:524
translate french c29s001_LisParty_bb164f90:

    # lis "You're right again."
    lis "Tu as encore raison."

# game/scripts/c29/c29.rpy:532
translate french c29s002_LisLewd_74efddb6:

    # "There are no limousines this time. [lis] calls an Under who arrives to pick you up in a few minutes and takes you to the hotel the girl booked."
    "Il n'y a pas de limousines cette fois. [lis] appelle un Under qui arrive pour vous chercher en quelques minutes et vous emmène à l'hôtel que la fille a réservé."

# game/scripts/c29/c29.rpy:534
translate french c29s002_LisLewd_a81b6731:

    # lis "Here we are. I'm sorry if the room is small."
    lis "Nous y voilà. Je suis désolée si la chambre est petite."

# game/scripts/c29/c29.rpy:535
translate french c29s002_LisLewd_5c59dbf2:

    # mc "I like the room. I don't need anything else. The only thing I need is for you to be in it."
    mc "J'aime bien la chambre. Je n'ai besoin de rien d'autre. La seule chose dont j'ai besoin, c'est que tu y sois."

# game/scripts/c29/c29.rpy:537
translate french c29s002_LisLewd_ba6bb419:

    # lis "If I overspend on some expenses, my father would check what I spent the money on and..."
    lis "Si je dépense trop pour certaines choses, mon père vérifierait à quoi j'ai dépensé l'argent et..."

# game/scripts/c29/c29.rpy:538
translate french c29s002_LisLewd_37f2ef5a:

    # mc "And you would have to explain why you didn't stay overnight at Sidney's house, right?"
    mc "Et tu devrais expliquer pourquoi tu n'as pas passé la nuit chez Sidney, c'est ça ?"

# game/scripts/c29/c29.rpy:540
translate french c29s002_LisLewd_dea66962:

    # lis "Exactly... It's not that I want to hide that you and I are together, but I don't want to have to give explanations to my parents."
    lis "Exactement... Ce n'est pas que je veuille cacher que toi et moi sommes ensemble, mais je n'ai pas envie de devoir donner des explications à mes parents."

# game/scripts/c29/c29.rpy:541
translate french c29s002_LisLewd_420f9242:

    # lis "I don't want to be worrying about an interrogation on our first night together."
    lis "Je n'ai pas envie de m'inquiéter d'un interrogatoire pour notre première nuit ensemble."

# game/scripts/c29/c29.rpy:542
translate french c29s002_LisLewd_73d5ca14:

    # mc "[lis], you don't have to give me explanations either. The room is more than enough."
    mc "[lis], tu n'as pas non plus à me donner d'explications. La chambre est plus que suffisante."

# game/scripts/c29/c29.rpy:543
