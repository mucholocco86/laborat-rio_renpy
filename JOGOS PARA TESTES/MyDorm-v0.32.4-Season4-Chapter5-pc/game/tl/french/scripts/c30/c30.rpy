    # mc "I don't know what you're talking about. I haven't had sex since I got back to Newport!"
    mc "Je ne sais pas de quoi tu parles. Je n'ai pas baisé depuis mon retour à Newport !"

# game/scripts/c30/c30.rpy:2481
translate french c30s006_wedding_05e357e1:

    # jam "Do you think you can go to Aruba without your girlfriend wanting to do something special before you two leave?"
    jam "Tu crois que tu peux aller à Aruba sans que ta copine veuille faire un truc spécial avant que vous partiez tous les deux ?"

# game/scripts/c30/c30.rpy:2486
translate french c30s006_wedding_953f2014:

    # jam "Do you think you can leave for Aruba without your girlfriends wanting to do something special before you go?"
    jam "Tu crois que tu peux partir pour Aruba sans que tes copines veuillent faire un truc spécial avant que tu partes ?"

# game/scripts/c30/c30.rpy:2488
translate french c30s006_wedding_f652d3f6:

    # jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"
    jam "Tu crois que tu peux aller à Aruba et laisser ta copine ici sans qu'elle veuille faire un truc spécial avant ton départ ?"

# game/scripts/c30/c30.rpy:2493
translate french c30s006_wedding_f652d3f6_1:

    # jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"
    jam "Tu crois que tu peux aller à Aruba et laisser ta copine ici sans qu'elle veuille faire un truc spécial avant ton départ ?"

# game/scripts/c30/c30.rpy:2495
translate french c30s006_wedding_fc06d66f:

    # jam "Do you think you can go to Aruba without the girlfriends you're leaving behind wanting to do something special before you leave?"
    jam "Tu crois que tu peux aller à Aruba sans que les copines que tu laisses derrière toi veuillent faire un truc spécial avant ton départ ?"

# game/scripts/c30/c30.rpy:2497
