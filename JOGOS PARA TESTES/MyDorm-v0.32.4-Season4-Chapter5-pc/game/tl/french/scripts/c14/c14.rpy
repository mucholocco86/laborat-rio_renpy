    # nor "¿Competitiva yo? No iba a preguntar eso... o al menos delante de [eri]..."
    nor "Compétitif, moi ? Je n'allais pas poser cette question... ou du moins pas devant [eri]..."

# game/scripts/c14/c14.rpy:1080
translate french c14s002_NorEri_cd6070b6:

    # eri "¿Tu quieres que continúe hasta que se corra y no te deje probarlo? *Risa*"
    eri "Tu veux que je continue jusqu'à ce qu'il éjacule et que je t'empêche d'y goûter ? *Rires*"

# game/scripts/c14/c14.rpy:1081
translate french c14s002_NorEri_602a86a4:

    # nor "No, cielo. Pero puedes continuar si quieres."
    nor "Non, chérie. Mais tu peux continuer si tu veux."

# game/scripts/c14/c14.rpy:1082
translate french c14s002_NorEri_a76ce5ef:

    # mc "Chicas, no discutáis ahora... me estaba poniendo muy cachondo"
    mc "Les filles, ne vous disputez pas maintenant... J'étais vraiment excitée"

# game/scripts/c14/c14.rpy:1084
translate french c14s002_NorEri_4af49d37:

    # eri "No estabamos discutiendo, cielo. Solo bromeábamos."
    eri "On ne se disputait pas, chérie. On plaisantait, c'est tout."

# game/scripts/c14/c14.rpy:1085
translate french c14s002_NorEri_c24b3467:

    # eri "Pero quiero ver esos labios rojos alrededor de tu polla. A lo mejor puedo aprender algo..."
    eri "Mais j'ai envie de voir ces lèvres rouges autour de ta bite. Peut-être que je pourrais en tirer une leçon…"

# game/scripts/c14/c14.rpy:1086
translate french c14s002_NorEri_4fa26376:

    # nor "Lo estabas haciendo muy bien, cariño, ¿verdad, [mc]?."
    nor "Tu te débrouillais vraiment bien, chérie, n'est-ce pas, [mc] ?"

# game/scripts/c14/c14.rpy:1087
translate french c14s002_NorEri_87d6318d:

    # mc "Genial, pero si [eri] ha pedido que continúes tú, ¿se lo vas a negar?"
    mc "Parfait, mais si [eri] vous a demandé de continuer, allez-vous refuser ?"

# game/scripts/c14/c14.rpy:1091
translate french c14s002_NorEri_73a934c0:

    # "[nor] no responde y se apodera de tu polla, introduciéndosela profundamente en la boca."
    "[nor] ne répond pas et saisit votre pénis, le mettant profondément dans sa bouche."

# game/scripts/c14/c14.rpy:1092
translate french c14s002_NorEri_2c4b49e0:

    # eri "¡Wow! Yo no soy capaz de metérmela tanto... ¿te gusta más así?"
    eri "Waouh ! Je n'arrive pas à l'enfoncer aussi loin... Tu préfères comme ça ?"

# game/scripts/c14/c14.rpy:1093
translate french c14s002_NorEri_e26c2dc7:

    # mc "Lo que tú hacías con la lengua era perfecto. Lo que hace tu madre con toda la boca es increíble. Son dos sensaciones diferentes."
    mc "Ce que tu faisais avec ta langue était parfait. Ce que ta mère fait avec toute sa bouche est incroyable. Ce sont deux sensations différentes."

# game/scripts/c14/c14.rpy:1094
translate french c14s002_NorEri_f56eda3e:

    # nor "*Gemido ahogado*"
    nor "*Gémissement étouffé*"

# game/scripts/c14/c14.rpy:1095
translate french c14s002_NorEri_a6ef2eef:

    # eri "Creo que mi madre quiere decir algo, pero no la acabo de entender. No recuerda que no se debe hablar con la boca llena. *Risa*"
    eri "Je crois que ma mère veut dire quelque chose, mais je n'arrive pas bien à la comprendre. On dirait qu'elle a oublié qu'il ne faut pas parler la bouche pleine. *Rires*"

# game/scripts/c14/c14.rpy:1096
translate french c14s002_NorEri_556e0e7e:

    # mc "Chicas, estoy a punto de llegar..."
    mc "Les filles, j'arrive bientôt..."

# game/scripts/c14/c14.rpy:1097
translate french c14s002_NorEri_fb1e4508:

    # eri "¿Donde quieres acabar?"
    eri "Où souhaitez-vous arriver ?"

# game/scripts/c14/c14.rpy:1119
translate french c14s002_NorEri_e7b00c68:

    # mc "¿Ya estáis pensando en la próxima? Yo puedo estar listo en cinco minutos..."
    mc "Tu penses déjà au prochain ? Je peux être prêt dans cinq minutes…"

# game/scripts/c14/c14.rpy:1126
translate french c14s002_NorEri_92302daa:

    # "Justo cuando se vuelven de poner de rodillas delante tuyo oís el motor de un coche y la verja abriéndose. Os han dado el tiempo justo para acabar, aunque no para un segundo round."
    "Au moment où ils se détournent de leur position agenouillée devant vous, vous entendez un moteur de voiture et le portail s'ouvrir. Vous avez eu juste assez de temps pour terminer, mais pas assez pour une deuxième manche."

# game/scripts/c14/c14.rpy:1128
translate french c14s002_NorEri_063e4613:

    # "Justo en ese momento oís el motor de un coche y la verja abriéndose. Os han dado el tiempo justo para acabar, aunque no para un segundo round."
    "Soudain, vous entendez un moteur de voiture et le portail s'ouvrir. Vous avez eu juste assez de temps pour terminer, mais pas pour une deuxième manche."

# game/scripts/c14/c14.rpy:1129
translate french c14s002_NorEri_5cfaa514:

    # eri "¡Oh, mierda! Un poco más y nos pillan. Vamos a meternos en la piscina..."
    eri "Oh mince ! On a failli se faire prendre. Allons dans la piscine…"

# game/scripts/c14/c14.rpy:1131
translate french c14s002_NorEri_8e69189d:

    # mc "Espera... [nor]"
    mc "Attendez... [nor]"

# game/scripts/c14/c14.rpy:1134
translate french c14s002_NorEri_bcaec58a:

    # mcp "(Espero que lo coja antes de que la vea alguien.)"
    mcp "(J'espère qu'elle le verra avant quelqu'un d'autre.)"

# game/scripts/c14/c14.rpy:1136
translate french c14s002_NorEri_94cac7dd:

    # "Te terminas de subir el bañador justo cuando aparece [mar]."
    "Vous finissez de remonter votre maillot de bain juste au moment où [mar] apparaît."

# game/scripts/c14/c14.rpy:1138
translate french c14s002_NorEri_94a8561e:

    # mom "Hola, [mc]. ¿Estás solo?"
    mom "Bonjour, [mc]. Êtes-vous seul(e) ?"

# game/scripts/c14/c14.rpy:1139
translate french c14s002_NorEri_a4a59e92:

    # mc "No, [eri] y [nor] están buceando."
    mc "Non, [eri] et [nor] plongent."

# game/scripts/c14/c14.rpy:1142
translate french c14s002_NorEri_3f89381e:

    # mc "Mira, por ahí vuelven de su buceo."
    mc "Regardez, ils reviennent de leur plongée."

# game/scripts/c14/c14.rpy:1144
translate french c14s002_NorEri_cc9f95d1:

    # nor "Hola, [mar]. Qué pronto habéis vuelto."
    nor "Bonjour, [mar]. Vous êtes de retour si vite."

# game/scripts/c14/c14.rpy:1145
translate french c14s002_NorEri_8d8b4a43:

    # eri "Hola, Tía [mar]. ¿Lo habéis comprado todo?"
    eri "Salut, tante [mar]. As-tu tout acheté ?"

# game/scripts/c14/c14.rpy:1147
translate french c14s002_NorEri_c171d896:

    # mom "Sí, nos ha costado encontrar un gorro para ti, pero lo tenemos todo."
    mom "Oui, c'était difficile de vous trouver un chapeau, mais nous avons tout."

# game/scripts/c14/c14.rpy:1149
translate french c14s002_NorEri_52304a51:

    # mom "¡Oops! *Susurrando* [nor], tu bikini no está... donde debería."
    mom "Oups ! *Chuchotant* [nor], ton bikini n'est pas... à sa place."

# game/scripts/c14/c14.rpy:1151
translate french c14s002_NorEri_300412a8:

    # nor "¡Oops! Nada que no hayaís visto ninguno, ¿no? Somos todo chicas... y [mc], que ha visto a las chicas mil veces."
    nor "Oups ! Rien de nouveau sous le soleil, n'est-ce pas ? Nous sommes toutes des filles... et [mc], qui a vu ces filles mille fois."

# game/scripts/c14/c14.rpy:1153
translate french c14s002_NorEri_847c3402:

    # mom "Vale, pero no hace falta que te exhibas..."
    mom "D'accord, mais tu n'as pas besoin de te vanter..."

# game/scripts/c14/c14.rpy:1154
translate french c14s002_NorEri_b81c5011:

    # mc "¿Un gorro para [eri]? No tiene la cabeza grande. *Risa*"
    mc "Un chapeau pour [eri] ? Il n'a pas une grosse tête. *Rires*"

# game/scripts/c14/c14.rpy:1156
translate french c14s002_NorEri_e65c66c5:

    # mom "Si es difícil encontrar gorros navideños en Julio, imagínate encontrarlos negros. Tu prima tiene alergia al rojo."
    mom "S'il est difficile de trouver des bonnets de Noël en juillet, imaginez en trouver des noirs. Votre cousine est allergique au rouge."

# game/scripts/c14/c14.rpy:1158
translate french c14s002_NorEri_3b63eff1:

    # eri "Y al rosa. *Risa*"
    eri "Et rose. *Rires*"

# game/scripts/c14/c14.rpy:1160
translate french c14s002_NorEri_b17220b2:

    # mom "Calla, calla, que [emm] ha encontrado un gorro rosa."
    mom "Chut, chut, [emm] a trouvé un chapeau rose."

# game/scripts/c14/c14.rpy:1162
translate french c14s002_NorEri_42ff8788:

    # nor "Lo de [emm] con el rosa..."
    nor "Ce qui est particulier avec [emm] et le rose..."

# game/scripts/c14/c14.rpy:1163
translate french c14s002_NorEri_3688b5d7:

    # eri "¡Eso tengo que verlo!"
    eri "Je dois voir ça !"

# game/scripts/c14/c14.rpy:1164
translate french c14s002_NorEri_1c8ff853:

    # mc "Id vosotras. Yo prefiero la sorpresa mañana. Iré a ducharme."
    mc "Vas-y. Je préfère la surprise de demain. Je vais prendre une douche."

# game/scripts/c14/c14.rpy:1166
translate french c14s002_NorEri_0264b280:

    # nor "Hasta luego, [mc]."
    nor "À plus tard, [mc]."

# game/scripts/c14/c14.rpy:1167
translate french c14s002_NorEri_e4fd4856:

    # eri "¡Vale! Nos vemos luego."
    eri "D'accord ! À plus tard."

# game/scripts/c14/c14.rpy:1169
translate french c14s002_NorEri_1cdac493:

    # mom "Hasta luego, [mc]."
    mom "À plus tard, [mc]."

# game/scripts/c14/c14.rpy:1172
translate french c14s002_NorEri_c0425391:

    # "Las tres se van, riéndose de algo que no puedes escuchar. Tan parecidas y diferentes a la vez."
    "Tous trois s'en vont en riant de quelque chose que vous ne pouvez pas entendre. Si semblables et pourtant si différents."

# game/scripts/c14/c14.rpy:1177
translate french c14s002_CumInNor_37c393c6:

    # "Explotas en la boca de [nor] mientras [eri] le sujeta la cabeza."
    "Tu exploses dans la bouche de [nor] tandis que [eri] lui tient la tête."

# game/scripts/c14/c14.rpy:1178
translate french c14s002_CumInNor_6082d9cb:

    # mc "¡Mpfft!"
    mc "Mpfft !"

# game/scripts/c14/c14.rpy:1179
translate french c14s002_CumInNor_77c69cba:

    # eri "¡Déjame algo para mí!"
    eri "Laissez-m'en un peu !"

# game/scripts/c14/c14.rpy:1181
translate french c14s002_CumInNor_b0b312d4:

    # "Después de limpiar tu polla, [nor] te mira inquisitivamente."
    "Après avoir nettoyé ton pénis, [nor] te regarde d'un air interrogateur."

# game/scripts/c14/c14.rpy:1182
translate french c14s002_CumInNor_3bb18810:

    # mc "¿Me estás preguntando que hacer con la corrida?"
    mc "Vous me demandez ce que je dois faire concernant la corrida ?"

# game/scripts/c14/c14.rpy:1184
translate french c14s002_CumInNor_cbe5a83f:

    # "[nor] asiente."
    "[nor] hoche la tête."

# game/scripts/c14/c14.rpy:1194
translate french c14s002_CumInNor_1f17efd2:

    # "Las dos te miran con sorpresa inicial, pasando después a una sonrisa de pillería tras mirarse."
    "Ils vous regardent tous les deux avec une surprise initiale, puis un sourire malicieux se dessine sur leurs visages après s'être regardés."

# game/scripts/c14/c14.rpy:1196
translate french c14s002_CumInNor_a2d18649:

    # "[nor] se incorpora un poco antes de dejar caer tu corrida en la boca abierta de [eri]."
    "[nor] se redresse un peu avant de laisser tomber votre charge dans la bouche ouverte de [eri]."

# game/scripts/c14/c14.rpy:1197
translate french c14s002_CumInNor_9da58a1a:

    # mc "¡Wow! Eso ha sido muy tórrido..."
    mc "Waouh ! C'était vraiment torride..."

# game/scripts/c14/c14.rpy:1201
translate french c14s002_CumInNor_4f21fd3f:

    # "[nor] deja caer su cabeza hasta que sus labios rozan los de su hija, para sorpesa de ésta."
    "[nor] baisse la tête jusqu'à ce que ses lèvres touchent celles de sa fille, à sa grande surprise."

# game/scripts/c14/c14.rpy:1203
translate french c14s002_CumInNor_34ee1e7e:

    # "[nor] deja caer su cabeza hasta que sus labios rozan los de la que pasa por su hija, para sorpesa de ésta."
    "[nor] Elle baisse la tête jusqu'à ce que ses lèvres effleurent celles de la femme qui passe pour sa fille, à la grande surprise de cette dernière."

# game/scripts/c14/c14.rpy:1205
translate french c14s002_CumInNor_e153f049:

    # "[eri] tarda un segundo en devolverle el beso a su madre. Si antes era tórrido, ahora casi podrías arder solo con ver esa imagen."
    "Il lui faut une seconde pour répondre au baiser de sa mère. Si la scène était déjà torride, elle est maintenant à couper le souffle."

# game/scripts/c14/c14.rpy:1206
translate french c14s002_CumInNor_c4265770:

    # mc "¡Wow! Eso es mejor todavía..."
    mc "Waouh ! C'est encore mieux..."

# game/scripts/c14/c14.rpy:1208
translate french c14s002_CumInNor_522e5fe5:

    # nor "¿Qué te ha parecido?"
    nor "Qu'en avez-vous pensé ?"

# game/scripts/c14/c14.rpy:1209
translate french c14s002_CumInNor_c725c79d:

    # mc "¡Increíble! Que dos mujeres como vosotras me coman así... sin palabras..."
    mc "Incroyable ! Que deux femmes comme vous me dévorent ainsi… sans voix…"

# game/scripts/c14/c14.rpy:1211
translate french c14s002_CumInNor_c5b75135:

    # mc "Y el beso final... ¡Ufff!"
    mc "Et le baiser final... Ouf !"

# game/scripts/c14/c14.rpy:1212
translate french c14s002_CumInNor_c203cee2:

    # eri "Después de la sorpresa inicial ha sido una experiencia impresionante..."
    eri "Après la surprise initiale, ce fut une expérience incroyable..."

# game/scripts/c14/c14.rpy:1214
translate french c14s002_CumInNor_ad9b8803:

    # nor "La próxima vez lo podemos hacer al revés si quieres..."
    nor "La prochaine fois, on pourra faire l'inverse si tu veux..."

# game/scripts/c14/c14.rpy:1215
translate french c14s002_CumInNor_b6381ce6:

    # eri "¡Genial! Quiero repetir esto, ha sido una pasada..."
    eri "Génial ! J'ai envie de recommencer, c'était incroyable…"

# game/scripts/c14/c14.rpy:1218
translate french c14s002_CumInNor_524c7374:

    # "[nor] hace caso de tu petición sin dudar, mientras [eri] os mira a ambos con cara de sorpresa."
    "[nor] obéit à votre demande sans hésitation, tandis que [eri] vous regarde tous les deux avec une expression surprise."

# game/scripts/c14/c14.rpy:1219
translate french c14s002_CumInNor_e47073a7:

    # eri "¡Wow! Eso ha sido muy tórrido, Mamá."
    eri "Waouh ! C'était vraiment chaud, maman."

# game/scripts/c14/c14.rpy:1221
translate french c14s002_CumInNor_4212cb98:

    # nor "La próxima vez puedes hacerlo tú, cielo. A los chicos les gusta. O al menos a [mc]."
    nor "Tu peux le faire la prochaine fois, chérie. Les garçons aiment ça. Enfin, [mc] en tout cas, oui."

# game/scripts/c14/c14.rpy:1222
translate french c14s002_CumInNor_6d80289b:

    # eri "Lo haré, lo haré... Quiero repetir esto, ha sido una pasada..."
    eri "Je le ferai, je le ferai… Je veux recommencer, c'était incroyable…"

# game/scripts/c14/c14.rpy:1226
translate french c14s002_CumInNor_7dddc7b9:

    # "[nor] se levanta a escupir tu corrida en una de las macetas y vuelve unos segundos después."
    "[nor] se lève pour cracher ton sperme dans un des pots de fleurs et revient quelques secondes plus tard."

# game/scripts/c14/c14.rpy:1228
translate french c14s002_CumInNor_b7f321d3:

    # eri "Tendrías que habértelo tragado... he leído que a los chicos les gusta."
    eri "Tu aurais dû l'avaler... J'ai lu que les garçons aiment ça."

# game/scripts/c14/c14.rpy:1229
translate french c14s002_CumInNor_07b6777e:

    # nor "La próxima vez..."
    nor "La prochaine fois..."

# game/scripts/c14/c14.rpy:1230
translate french c14s002_CumInNor_1c0c00e2:

    # eri "No, no. La próxima vez me toca a mí. Quiero continuar esto, ha sido una pasada... y nuestro chico puede correrse otra vez, ¿no?"
    eri "Non, non. La prochaine fois, c'est mon tour. Je veux que ça continue, c'était génial… et notre gars peut jouir à nouveau, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:1235
translate french c14s002_CumInEri_765fe271:

    # "Explotas en la boca de [eri] mientras [nor] le sujeta la cabeza."
