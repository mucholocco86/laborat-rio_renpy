translate french c14s005_BallGame_de080c2d:

    # kat "¡Vaya dos bailarines! Kim, que forma más sensual de moverte..."
    kat "Waouh, ces deux danseurs ! Kim, tu as une façon de bouger tellement sensuelle…"

# game/scripts/c14/c14.rpy:2650
translate french c14s005_BallGame_d1c317ad:

    # kat "Chicas, todas las pelotas a [mc]. A ver si se le escapa alguna y nos saca a bailar a las demás. *Risa*"
    kat "Les filles, on y va à fond ! On va voir s'il en réussit une et nous entraîne toutes sur la piste de danse. *Rires*"

# game/scripts/c14/c14.rpy:2651
translate french c14s005_BallGame_5ac5d7ee:

    # mc "Kate, ¿estás segura que quieres que se me escape una pelota?"
    mc "Kate, es-tu sûre de vouloir que je fasse une gaffe ?"

# game/scripts/c14/c14.rpy:2654
translate french c14s005_BallGame_a67189dc:

    # kat "{b}¿Qué?... ¡No!{/b} ¡No me refería a una de esas pelotas...!"
    kat "{b}Quoi ?... Non !{/b} Je ne parlais pas d'une de ces balles... !"

# game/scripts/c14/c14.rpy:2655
translate french c14s005_BallGame_5f70629d:

    # mc "Yo tampoco, malpensada. *Risa* Me refería a que si la pelota me la tira [dap] también te va a tocar bailar a ti. *Risa*"
    mc "Moi non plus, espèce de pervers ! *Rires* Je voulais dire que si [dap] me lance la balle, tu devras danser aussi. *Rires*"

