    # nor "*Carcajada*" (multiple=2)
    nor "*Rire*" (multiple=2)

# game/scripts/c14/c14.rpy:3383
translate french c14s006_Christmas_bf87f68f:

    # nor "*Risa*"
    nor "*Rire*"

# game/scripts/c14/c14.rpy:3387
translate french c14s006_Christmas_ffb1a49f:

    # mom "*Risa*"
    mom "*Rire*"

# game/scripts/c14/c14.rpy:3389
translate french c14s006_Christmas_f057ccd6:

    # mc "*Risa*"
    mc "*Rire*"

# game/scripts/c14/c14.rpy:3391
translate french c14s006_Christmas_5e846fc9:

    # mee "¿He dicho algo gracioso?"
    mee "Ai-je dit quelque chose de drôle ?"

# game/scripts/c14/c14.rpy:3392
translate french c14s006_Christmas_18b90fc2:

    # mc "Un poco, Meemaw. Siempre decís que parezco más mayor de mi edad. Sería injusto que yo juzgase a las mujeres por la suya."
    mc "Un peu, Mémé. Tu dis toujours que je fais plus vieille que mon âge. Ce serait injuste de ma part de juger les femmes sur leur âge."

# game/scripts/c14/c14.rpy:3394
translate french c14s006_Christmas_60566bfc:

    # mee "Pero tienes que salir con chicas de tu edad. ¿Qué harías con dos viejas como Betty o yo?"
    mee "Mais tu dois sortir avec des filles de ton âge. Que ferais-tu avec deux vieilles dames comme Betty ou moi ?"

# game/scripts/c14/c14.rpy:3395
translate french c14s006_Christmas_8c0e4406:

    # mc "Un trío con mucho cuidado por si os rompéis. *Risa*"
    mc "Un plan à trois, attention à ne pas vous casser. *Rires*"

# game/scripts/c14/c14.rpy:3396
translate french c14s006_Christmas_2013a020:

    # _("Todas menos Meemaw") "*Risa*"
    _("Todas menos Meemaw") ""

# game/scripts/c14/c14.rpy:3398
translate french c14s006_Christmas_4c7eee92:

    # mee "¡Ni se te ocurra bromear con eso!"
    mee "N'y pensez même pas, vous ne plaisantez pas avec ça !"

# game/scripts/c14/c14.rpy:3399
translate french c14s006_Christmas_b488a032:

    # bet "Me parece que no está bromeando, Olivia. *Risa* Creo que nuestro chico tiene razón..."
    bet "Je ne crois pas qu'il plaisante, Olivia. *Rires* Je pense que notre homme a raison..."

# game/scripts/c14/c14.rpy:3401
translate french c14s006_Christmas_28914a20:

    # mee "Pero nosotras somos... somos..."
    mee "Mais nous sommes... nous sommes..."

# game/scripts/c14/c14.rpy:3402
translate french c14s006_Christmas_9f5f0860:

    # mc "Dos mujeres preciosas a las que quiero mucho y que me quieren a mí. Si fuera posible... Pero tranquilízate, estaba de broma. Sé que tú nunca aceptarías, Meemaw."
    mc "Deux femmes magnifiques que j'aime beaucoup et qui m'aiment en retour. Si seulement c'était possible… Mais du calme, je plaisantais. Je sais que tu ne serais jamais d'accord, Mémé."

# game/scripts/c14/c14.rpy:3404
translate french c14s006_Christmas_6f81fbaa:

    # mee "¿Yo? ¿Y Betty sí?"
    mee "Moi ? Et Betty, oui ?"

# game/scripts/c14/c14.rpy:3405
translate french c14s006_Christmas_e32d0ef3:

    # bet "Quizás no con [mc], pero en otras circunstancias, ¿quién sabe qué hubiera pasado?"
    bet "Peut-être pas avec [mc], mais dans d'autres circonstances, qui sait ce qui se serait passé ?"

# game/scripts/c14/c14.rpy:3407
translate french c14s006_Christmas_6dbdc625:

    # mom "Tía Betty nos ha salido pícara. *Risa*" (multiple=2)
    mom "Tante Betty s'est révélée être une vraie chipie. *Rires*" (multiple=2)

# game/scripts/c14/c14.rpy:3408
translate french c14s006_Christmas_09e5deb6:

    # nor "*Risa* Tía, me acabas de sorprender mucho." (multiple=2)
    nor "*Rires* Tante, vous m'avez vraiment surprise." (multiple=2)

# game/scripts/c14/c14.rpy:3409
translate french c14s006_Christmas_d68ee34c:

    # mc "Yo solo veo cinco mujeres hermosas. No veo la edad que sumáis entre todas."
    mc "Je ne vois que cinq belles femmes. Je ne peux pas connaître votre âge total."

# game/scripts/c14/c14.rpy:3411
translate french c14s006_Christmas_f831008e:

    # kia "Porque te has dejado la calculadora en casa. *Risa*"
    kia "Parce que tu as oublié ta calculatrice à la maison. *Rires*"

# game/scripts/c14/c14.rpy:3412
translate french c14s006_Christmas_b3b94564_1:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c14/c14.rpy:3413
translate french c14s006_Christmas_18e1c939:

    # mc "Mamá, pásame otra cerveza, por favor."
    mc "Maman, passe-moi une autre bière, s'il te plaît."

# game/scripts/c14/c14.rpy:3415
translate french c14s006_Christmas_f0264c1b:

    # mom "¿Ya te has acabado la que te acabas de llevar? Deberías frenar un poco con el alcohol, ¿no?"
    mom "Tu as déjà fini celui que tu viens de boire ? Tu devrais peut-être lever le pied sur l'alcool, non ?"

# game/scripts/c14/c14.rpy:3416
translate french c14s006_Christmas_b94bc6f7:

    # mc "No, tranquila. Creo que acabo de ver a alguien y voy a saludarla."
    mc "Non, ne t'inquiète pas. Je crois que je viens d'apercevoir quelqu'un et je vais lui dire bonjour."

# game/scripts/c14/c14.rpy:3417
translate french c14s006_Christmas_71d7e15c:

    # mom "¿Alguien?"
    mom "Quelqu'un?"

# game/scripts/c14/c14.rpy:3419
translate french c14s006_Christmas_ba3f445a:

    # mc "Cosas mías, Mamá."
    mc "Mes affaires, maman."

# game/scripts/c14/c14.rpy:3428
translate french c14s006_Christmas_da16b24b:

    # mc "Buenos días, Eva. No es un buen sitio para esconderse, ¿no?"
    mc "Bonjour Eva. Ce n'est pas un bon endroit pour se cacher, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3429
translate french c14s006_Christmas_2217a33d:

    # eva "Buenos días, [mc]. Es difícil esconderse en una playa casi vacía."
    eva "Bonjour, [mc]. Il est difficile de se cacher sur une plage presque déserte."

# game/scripts/c14/c14.rpy:3431
translate french c14s006_Christmas_a625d38b:

    # eva "Y más aún si vienes aquí y llamas la atención sobre mí."
    eva "Et encore plus si vous venez ici et attirez l'attention sur moi."

# game/scripts/c14/c14.rpy:3432
translate french c14s006_Christmas_0606b398:

    # mc "Lo siento, pero estamos de celebración navideña y os quería incluír. ¿Amanda está por aquí?"
    mc "Je suis désolée, mais nous fêtons Noël et je voulais vous inclure. Amanda est-elle là ?"

# game/scripts/c14/c14.rpy:3434
translate french c14s006_Christmas_b91f8a88:

    # eva "¿Incluirnos? ¿A nosotras? ¿Por qué?"
    eva "Nous inclure ? Nous ? Pourquoi ?"

# game/scripts/c14/c14.rpy:3435
translate french c14s006_Christmas_0a43cdf1:

    # mc "Es fácil. Es una celebración familiar. Y sois parte de la famila. De una forma rara, pero lo sois."
    mc "C'est simple. C'est une fête de famille. Et tu fais partie de la famille. D'une manière un peu étrange, certes, mais tu en fais partie."

# game/scripts/c14/c14.rpy:3437
translate french c14s006_Christmas_883516cc:

    # mc "Sois los clones de mi hermana y de mis primas. Por raro que parezca, desde que ayer le vi la cara a Amanda, no puedo evitar pensar en vosotras como parte de la familia."
    mc "Tu es le portrait craché de ma sœur et de mes cousins. Aussi étrange que cela puisse paraître, depuis que j'ai vu le visage d'Amanda hier, je ne peux m'empêcher de te considérer comme un membre de la famille."

# game/scripts/c14/c14.rpy:3439
translate french c14s006_Christmas_9215dc47:

    # mc "Mi hermana y mis primas son clones vuestros. Por raro que parezca, desde que ayer le vi la cara a Amanda, no puedo evitar pensar en vosotras como parte de la familia."
    mc "Ma sœur et mes cousines te ressemblent comme deux gouttes d'eau. Aussi étrange que cela puisse paraître, depuis que j'ai vu le visage d'Amanda hier, je ne peux m'empêcher de te considérer comme faisant partie de la famille."

# game/scripts/c14/c14.rpy:3441
translate french c14s006_Christmas_46c421fa:

    # eva "No somos {b}tu{/b} familia. Amanda es {b}mi{/b} familia. No vosotros."
    eva "Nous ne sommes pas votre famille. Amanda est ma famille. Pas vous."

# game/scripts/c14/c14.rpy:3443
translate french c14s006_Christmas_0469219c:

    # eva "Ni siquiera tu \"hermana\" y tus \"primas\" son tu familia."
    eva "Même votre « sœur » et vos « cousins » ne font pas partie de votre famille."

# game/scripts/c14/c14.rpy:3444
translate french c14s006_Christmas_db123823:

    # mc "Te equivocas en eso, Eva. Yo decido quién es mi familia, no la sangre que corre por nuestras venas."
    mc "Tu te trompes sur ce point, Eva. C'est moi qui décide qui est ma famille, pas le sang qui coule dans nos veines."

# game/scripts/c14/c14.rpy:3445
translate french c14s006_Christmas_b8b37c13:

    # mc "Puede que tu no me consideres parte de tu familia, pero yo si que os considero familia a vosotras dos. No puedo mirarte a la cara y no ver a [dap] o a [eri]."
    mc "Vous ne me considérez peut-être pas comme faisant partie de votre famille, mais je vous considère tous les deux comme ma famille. Je ne peux pas vous regarder dans les yeux sans voir [dap] ou [eri]."

# game/scripts/c14/c14.rpy:3447
translate french c14s006_Christmas_e3b24e4a:

    # eva "Lo que tú digas..."
    eva "Quoi que vous disiez..."

# game/scripts/c14/c14.rpy:3448
translate french c14s006_Christmas_a96613df:

    # mc "Pero no me has respondido, ¿Amanda también está por aquí?"
    mc "Mais vous ne m'avez pas répondu, Amanda est-elle là aussi ?"

# game/scripts/c14/c14.rpy:3450
translate french c14s006_Christmas_fc5eb797:

    # eva "No... está en la base. ¿Por qué?"
    eva "Non… c’est à la base. Pourquoi ?"

# game/scripts/c14/c14.rpy:3451
translate french c14s006_Christmas_97efceca:

    # mc "Porque, aunque te parezca ridículo después de lo que acabas de decirme, quiero felicitaros la Navidad a las dos. La Navidad es para pasarla en familia, ¿no?"
    mc "Parce que, même si cela peut paraître ridicule après ce que vous venez de me dire, je voulais vous souhaiter à tous les deux un joyeux Noël. Noël, c'est fait pour passer du temps en famille, non ?"

# game/scripts/c14/c14.rpy:3453
translate french c14s006_Christmas_6913f80f:

    # eva "Pero... ¿tú eres tonto? ¡No es Navidad! ¡Y ya te he dicho que no somos tu familia!"
    eva "Tu es bête ou quoi ? Ce n'est pas Noël ! Et je t'ai déjà dit qu'on n'est pas de ta famille !"

# game/scripts/c14/c14.rpy:3454
translate french c14s006_Christmas_e5e4d666:

    # mc "Y yo te he dicho que tu concepto de familia y el mío son diferentes. ¿Puedes llamarla?"
    mc "Et je t'ai dit que nos conceptions de la famille sont différentes. Peux-tu l'appeler ?"

# game/scripts/c14/c14.rpy:3456
translate french c14s006_Christmas_2903d95e:

    # mc "Te he traído una cerveza si sirve de algo..."
    mc "Je t'ai apporté une bière, si ça peut te faire plaisir..."

# game/scripts/c14/c14.rpy:3457
translate french c14s006_Christmas_15cb36bd:

    # eva "Gracias... supongo... Aquí tienes a Amanda..."
    eva "Merci... enfin, je suppose... Voici Amanda..."

# game/scripts/c14/c14.rpy:3459
translate french c14s006_Christmas_50b7caf2:

    # mc "Hola, Amanda. ¿Qué te pasa?"
    mc "Salut Amanda. Qu'est-ce qui ne va pas ?"

# game/scripts/c14/c14.rpy:3460
translate french c14s006_Christmas_c49fda70:

    # ama "Nada, nada... se me ha metido algo en el ojo..."
    ama "Rien, rien... J'ai quelque chose dans l'œil..."

# game/scripts/c14/c14.rpy:3461
translate french c14s006_Christmas_5b1a03f0:

    # mc "¿Nos estabas escuchando?"
    mc "Nous écoutiez-vous ?"

# game/scripts/c14/c14.rpy:3463
translate french c14s006_Christmas_0e4ab121:

    # ama "Sí, Eva siempre tiene el micro abierto..."
    ama "Oui, Eva a toujours son micro allumé..."

# game/scripts/c14/c14.rpy:3464
translate french c14s006_Christmas_2c21f765:

    # mc "Pues debes saber que lo que le he dicho a ella, también se aplica a ti."
    mc "Eh bien, sachez que ce que je lui ai dit s'applique également à vous."

# game/scripts/c14/c14.rpy:3465
translate french c14s006_Christmas_b63f1bae:

    # mc "Espero que un día os podáis sentar en la mesa con nosotros en Navidad o en Acción de Gracias. O en cumpleaños. O cuando sea."
    mc "J'espère qu'un jour tu pourras t'asseoir à notre table pour Noël ou Thanksgiving. Ou pour ton anniversaire. Ou n'importe quand."

# game/scripts/c14/c14.rpy:3467
translate french c14s006_Christmas_5971d798:

    # ama "Gracias, pero no será posible. Nuestra misión con vosotros casi ha acabado... dudo que nos veamos demasiado después. "
    ama "Merci, mais ce ne sera pas possible. Notre mission avec vous touche à sa fin… Je doute que nous nous revoyions bien plus tard."

# game/scripts/c14/c14.rpy:3468
translate french c14s006_Christmas_13159d92:

    # ama "De todas formas, eso levantaría demasiadas liebres. No sé cómo se lo tomarían [emm], [dap] y [eri]."
    ama "Bref, cela soulèverait trop de questions. Je ne sais pas comment [emm], [dap] et [eri] réagiraient."

# game/scripts/c14/c14.rpy:3469
translate french c14s006_Christmas_b0917ed2:

    # mc "Seguramente fliparian al principio. Después os recibirían con los brazos abiertos. Es posible que os debamos la vida..."
    mc "Ils seraient sans doute stupéfaits au début. Puis ils vous accueilleraient à bras ouverts. Nous vous devons peut-être la vie…"

# game/scripts/c14/c14.rpy:3471
translate french c14s006_Christmas_72c0baf5:

    # eva "*Susurrando* ¿Solo posible?"
    eva "*Chuchotant* Est-ce la seule option possible ?"

# game/scripts/c14/c14.rpy:3472
translate french c14s006_Christmas_b579a18c:

    # ama "¡Eva!"
    ama "Veille!"

# game/scripts/c14/c14.rpy:3473
translate french c14s006_Christmas_9ea4742e:

    # mc "¿Qué? No te he entendido..."
    mc "Quoi ? Je n'ai pas compris..."

# game/scripts/c14/c14.rpy:3475
translate french c14s006_Christmas_9e423c2d:

    # eva "No... nada..."
    eva "Non, rien..."

# game/scripts/c14/c14.rpy:3477
translate french c14s006_Christmas_1fd7b00f:

    # mc "¿Eso es un arma? ¿Has traído un arma a la playa?"
    mc "Est-ce une arme ? Avez-vous apporté une arme à la plage ?"

# game/scripts/c14/c14.rpy:3479
translate french c14s006_Christmas_5803d896:

    # eva "A menos que quieras que proteja a {b}tu{/b} familia tirandoles conchas de almeja a los tipos malos... la tengo que llevar encima."
    eva "À moins que vous ne vouliez que je protège votre famille en lançant des coquillages sur les méchants... je dois les transporter sur moi."

# game/scripts/c14/c14.rpy:3481
translate french c14s006_Christmas_9553a853:

    # mc "Bueno, pues entonces creo que me llevaré la cerveza. Armas y alcohol..."
    mc "Bon, alors je prendrai la bière. Armes et alcool..."

# game/scripts/c14/c14.rpy:3484
translate french c14s006_Christmas_ca5f15c7:

    # eva "Si se te ocurre tocar mi cerveza, me obligarás a usar la pistola. *Risa*"
    eva "Si tu touches ne serait-ce qu'à ma bière, je serai obligé de sortir mon flingue. *Rires*"

# game/scripts/c14/c14.rpy:3485
translate french c14s006_Christmas_4047a438:

    # mc "¡Coño! Sabes reírte y hacer bromas..."
    mc "Mince alors ! Tu sais rire et faire des blagues..."

# game/scripts/c14/c14.rpy:3487
translate french c14s006_Christmas_9a174d02:

    # mc "Creía que más que un clon eras un robot."
    mc "Je te croyais plus un robot qu'un clone."

# game/scripts/c14/c14.rpy:3489
translate french c14s006_Christmas_55c837bd:

    # ama "Ahí te ha pillado, Eva. *Risa*"
    ama "Voilà, Eva. *Rires*"

# game/scripts/c14/c14.rpy:3491
translate french c14s006_Christmas_5d4e8276:

    # eva "*Gruñido*"
    eva "*Gronder*"

# game/scripts/c14/c14.rpy:3493
translate french c14s006_Christmas_06fca160:

    # ama "[mc], deberías irte ya. [emm], [eri], y Eileen se acercan a vuestra posición y si te ven descubrirán a Eva."
    ama "[mc], vous devriez partir maintenant. [emm], [eri] et Eileen approchent de votre position et s'ils vous voient, ils découvriront Eva."

# game/scripts/c14/c14.rpy:3494
translate french c14s006_Christmas_08fdf717:

    # mc "Bueno, chicas, entonces tan solo desearos Feliz Navidad."
    mc "Eh bien, les filles, je voulais simplement vous souhaiter un joyeux Noël."

# game/scripts/c14/c14.rpy:3496
translate french c14s006_Christmas_48fe6d84:

    # ama "Feliz Navidad, [mc]."
    ama "Joyeux Noël, [mc]."

# game/scripts/c14/c14.rpy:3497
translate french c14s006_Christmas_4bc1e65c:

    # mc "Feliz Navidad, Amanda."
    mc "Joyeux Noël, Amanda."

# game/scripts/c14/c14.rpy:3498
translate french c14s006_Christmas_e62105b5:

    # mc "Eva, ¿brindas conmigo o me tengo que llevar la cerveza?"
    mc "Eva, veux-tu trinquer avec moi ou dois-je apporter la bière ?"

# game/scripts/c14/c14.rpy:3500
translate french c14s006_Christmas_5604323f:

    # eva "Feliz Navidad, [mc]."
    eva "Joyeux Noël, [mc]."

# game/scripts/c14/c14.rpy:3501
translate french c14s006_Christmas_b22be3eb:

    # mc "Feliz Navidad, Eva."
    mc "Joyeux Noël, Eva."

# game/scripts/c14/c14.rpy:3502
translate french c14s006_Christmas_7c45520f:

    # mc "Espero volver a veros pronto."
    mc "J'espère vous revoir bientôt."

# game/scripts/c14/c14.rpy:3504
translate french c14s006_Christmas_bf009481:

    # ama "Nos verás. Vete ya. Hacia el noreste para interceptar a las chicas."
    ama "Vous allez nous voir. Allez-y maintenant. Dirigez-vous vers le nord-est pour intercepter les filles."

# game/scripts/c14/c14.rpy:3505
translate french c14s006_Christmas_b7825201:

    # mc "No seas como mi GPS, no tengo una brújula en el reloj. ¿Dónde coño está el noreste?"
    mc "Ne fais pas comme mon GPS, je n'ai pas de boussole sur ma montre. Où diable se trouve le nord-est ?"

# game/scripts/c14/c14.rpy:3506
translate french c14s006_Christmas_c043cac7:

    # ama "*Risa* Hacia el merendero..."
    ama "*Rires* Vers l'aire de pique-nique..."

# game/scripts/c14/c14.rpy:3507
translate french c14s006_Christmas_d0cb31d2:

    # mc "Hasta otra, chicas."
    mc "À plus tard, les filles."

# game/scripts/c14/c14.rpy:3509
translate french c14s006_Christmas_2cfd03ff:

    # ama "Te dije que no era mal tipo. Ha sido muy bonito lo que ha dicho."
    ama "Je te l'avais dit, ce n'était pas un mauvais garçon. Ce qu'il a dit était vraiment gentil."

# game/scripts/c14/c14.rpy:3510
translate french c14s006_Christmas_db943ceb:

    # eva "*Susurrando* Y ha traído cerveza. Sin querer meterse en mis bragas por ello."
    eva "*Chuchotant* Et il a apporté de la bière. Je n'avais pas envie de me déshabiller à cause de ça."

# game/scripts/c14/c14.rpy:3511
translate french c14s006_Christmas_e5c1f31a:

    # ama "¿Te puedes imaginar teniendo una familia como esa?"
    ama "Pouvez-vous imaginer avoir une famille comme celle-là ?"

# game/scripts/c14/c14.rpy:3512
translate french c14s006_Christmas_6d44ce54:

    # eva "*Susurrando* Estaría bien pasar una Navidad con una familia de verdad por una vez."
    eva "*À voix basse* Ce serait agréable de passer Noël avec une vraie famille pour une fois."

# game/scripts/c14/c14.rpy:3514
translate french c14s006_Christmas_93674dee:

    # eva "*Susurrando* Aunque viendo como trata a la familia, no me extrañaría que realmente quisiera meterse en nuestras bragas. *Risa*"
    eva "*Chuchotant* Vu comment il traite la famille, ça ne m'étonnerait pas qu'il ait vraiment envie de coucher avec nous. *Rires*"

# game/scripts/c14/c14.rpy:3516
translate french c14s006_Christmas_863d97b4:

    # eva "*Susurrando* Aunque viendo como trata a lo que llama familia, no me extrañaría que realmente quisiera meterse en nuestras bragas. *Risa*"
    eva "*Chuchotement* Vu comment il traite ceux qu'il appelle sa famille, je ne serais pas surprise qu'il ait vraiment envie de coucher avec nous. *Rires*"

# game/scripts/c14/c14.rpy:3517
translate french c14s006_Christmas_2c481062:

    # ama "Sé que eso no te importaría demasiado. *Risa*"
    ama "Je sais que ça ne vous dérangerait pas trop. *Rires*"

# game/scripts/c14/c14.rpy:3518
translate french c14s006_Christmas_d7db2251:

    # eva "*Susurrando* Yo tengo suficiente contigo, hermanita. Y que conste que hablo de la Navidad."
    eva "*Chuchotant* J'en ai assez de toi, petite sœur. Et sache-le bien, je parle de Noël."

# game/scripts/c14/c14.rpy:3519
translate french c14s006_Christmas_53a020dc:

    # ama "También sé que eso es mentira. *Risa*"
    ama "Je sais aussi que c'est un mensonge. *Rires*"

# game/scripts/c14/c14.rpy:3520
translate french c14s006_Christmas_79022e2b:

    # eva "*Gruñido* Te acabas de ganar que te cuelgue. Hasta luego. Feliz Navidad."
    eva "*Grogne* Tu t'es attiré des ennuis. À plus. Joyeux Noël."

# game/scripts/c14/c14.rpy:3521
translate french c14s006_Christmas_ae5d4fea:

    # ama "Feliz Navidad, Eva."
    ama "Joyeux Noël, Eva."

# game/scripts/c14/c14.rpy:3524
translate french c14s006_Christmas_08b9f087:

    # "Te diriges hacia el merendero (sí, sí, hacia el jodido noreste), con la esperanza de interceptar a las chicas a tiempo."
    "Vous vous dirigez vers l'aire de pique-nique (oui, oui, vers le nord-est !), en espérant intercepter les filles à temps."

# game/scripts/c14/c14.rpy:3535
translate french c14s006_Christmas_210fc8d5:

    # mc "Hola, chicas. ¿Qué tal el paseo?"
    mc "Salut les filles. Comment s'est passée la promenade ?"

# game/scripts/c14/c14.rpy:3536
translate french c14s006_Christmas_ef5396b5:

    # eri "Bien, hemos estado charlando y poniéndonos al día."
    eri "D'accord, on a discuté et on s'est raconté nos vies."

# game/scripts/c14/c14.rpy:3542
translate french c14s006_Christmas_01d95318:

    # emm "¿Nos hemos perdido algo?"
    emm "Avons-nous oublié quelque chose ?"

# game/scripts/c14/c14.rpy:3543
translate french c14s006_Christmas_c5ee7190:

    # mc "Una partida de Verdad o Reto con las chicas..."
    mc "Une partie de Action ou Vérité avec les filles..."

# game/scripts/c14/c14.rpy:3545
translate french c14s006_Christmas_44bc1b70:

    # mc "Qué se ha ido un poco de las manos. No aprenderemos nunca."
    mc "La situation a un peu dégénéré. On n'apprendra jamais."

# game/scripts/c14/c14.rpy:3547
translate french c14s006_Christmas_920e32e6:

    # emm "¿[dap] haciendo de las suyas?"
    emm "[dap]recommencent avec leurs vieilles combines ?"

# game/scripts/c14/c14.rpy:3548
translate french c14s006_Christmas_18d545f0:

    # mc "No, esta vez ha sido Kate, pero no ha habido malos rollos."
    mc "Non, cette fois c'était Kate, mais il n'y a pas eu de rancune."

# game/scripts/c14/c14.rpy:3558
translate french c14s006_Christmas_c46936de:

    # eil "¿Dónde están ahora?"
    eil "Où sont-ils maintenant ?"

# game/scripts/c14/c14.rpy:3559
translate french c14s006_Christmas_17a90bd3:

    # mc "Han ido a por hielo a la gasolinera. Tenemos una nevera con una fuga."
    mc "Ils sont allés à la station-service acheter de la glace. Notre réfrigérateur a une fuite."

# game/scripts/c14/c14.rpy:3560
translate french c14s006_Christmas_11555ef9:

    # mc "Y de paso a ver si os encontraban."
    mc "Et tant qu'on y est, voyons s'ils pourraient vous retrouver."

# game/scripts/c14/c14.rpy:3562
translate french c14s006_Christmas_5fc40a5b:

    # eri "Ah, pues podemos ir a la gasolinera a buscarlas y las ayudamos..."
    eri "Ah, eh bien, nous pouvons aller à la station-service pour les trouver et les aider..."

# game/scripts/c14/c14.rpy:3563
translate french c14s006_Christmas_a109c1cd:

    # mc "Así os enteráis de lo que ha pasado en la partida, ¿no? *Risa*"
    mc "Comme ça, tu découvres ce qui s'est passé dans le jeu, pas vrai ? *Rires*"

# game/scripts/c14/c14.rpy:3566
translate french c14s006_Christmas_ea75c01d:

    # emm "¿Puedo hablar un momento contigo antes de irnos?"
    emm "Puis-je vous parler un instant avant de partir ?"

# game/scripts/c14/c14.rpy:3567
translate french c14s006_Christmas_e0dc6594:

    # mc "Sí, claro. ¿Nos perdonáis un momento?"
    mc "Oui, bien sûr. Veuillez nous excuser un instant."

# game/scripts/c14/c14.rpy:3569
translate french c14s006_Christmas_92357e5f:

    # eil "Por supuesto." (multiple=2)
    eil "Bien sûr." (multiple=2)

# game/scripts/c14/c14.rpy:3570
translate french c14s006_Christmas_fcde78ae:

    # eri "No tengáis prisa." (multiple=2)
    eri "Ne soyez pas pressé." (multiple=2)

# game/scripts/c14/c14.rpy:3572
translate french c14s006_Christmas_23a92444:

    # mc "¿Qué pasa, [emm]?"
    mc "Quoi de neuf, [emm] ?"

# game/scripts/c14/c14.rpy:3573
translate french c14s006_Christmas_fa3d3b61:

    # emm "Bueno... sé que querías que hiciéramos público lo nuestro... y creo que [eri] lo debería saber."
    emm "Bon... je sais que tu voulais qu'on officialise notre relation... et je pense que [eri] devrait le savoir."

# game/scripts/c14/c14.rpy:3574
translate french c14s006_Christmas_5004e101:

    # mc "Cuando quieras. El día de Verdad o Reto querías restregárselo por la cara..."
    mc "Quand tu veux. Le jour du jeu Action ou Vérité, tu avais envie de lui faire payer cher..."

# game/scripts/c14/c14.rpy:3576
translate french c14s006_Christmas_e7735ec0:

    # emm "Y me dijiste que no lo hiciera porque lo de Jack estaba muy reciente. Me acuerdo."
    emm "Et tu m'as dit de ne pas le faire parce que ce qui s'était passé avec Jack était encore très récent. Je m'en souviens."

# game/scripts/c14/c14.rpy:3577
translate french c14s006_Christmas_a7424214:

    # emm "Entonces ¿no te importaría que lo supiera?"
    emm "Cela ne vous dérangerait pas si je le savais ?"

# game/scripts/c14/c14.rpy:3578
translate french c14s006_Christmas_600871e5:

    # mc "No, cuando estés preparada, se lo decimos."
    mc "Non, quand vous serez prêts, nous lui dirons."

# game/scripts/c14/c14.rpy:3580
translate french c14s006_Christmas_7a085273:

    # emm "¡Genial! Porque se me ha escapado... Ahora no te puedes enfadar."
    emm "Génial ! Parce que ça a échappé à la vigilance... Maintenant, tu ne peux plus te fâcher."

# game/scripts/c14/c14.rpy:3581
translate french c14s006_Christmas_391eb16b:

    # emm "Chicas, no le importa que se me haya escapado. ¡Uff!"
    emm "Les filles, elle s'en fiche que je me sois échappée. Ouf !"

# game/scripts/c14/c14.rpy:3582
translate french c14s006_Christmas_b2ce9547:

    # mc "{b}¿QUÉ?{/b}"
    mc "{b}QUOI ?{/b}"

# game/scripts/c14/c14.rpy:3584
translate french c14s006_Christmas_11967536:

    # eil "Estábamos hablando de chicos..."
    eil "Nous parlions de garçons..."

# game/scripts/c14/c14.rpy:3586
translate french c14s006_Christmas_43cf2b28:

    # eri "Y [emm] estaba todo el rato \"mi chico esto, mi chico aquello\"..."
    eri "Et [emm] répétait sans cesse « mon garçon ceci, mon garçon cela »..."

# game/scripts/c14/c14.rpy:3588
translate french c14s006_Christmas_b546f41a:

    # emm "Y una de las veces he dicho \"[mc] esto, [mc] aquello\". Lo siento, supongo que querías estar cuando se lo dijésemos."
    emm "Et une des fois, j'ai dit « ceci, cela ». Je suis désolé, je suppose que vous auriez voulu être là quand nous le lui avons annoncé."

# game/scripts/c14/c14.rpy:3589
translate french c14s006_Christmas_2f0af520:

    # emm "Tenías que haberles visto las caras..."
    emm "Vous auriez dû voir leurs têtes..."

# game/scripts/c14/c14.rpy:3590
translate french c14s006_Christmas_d673f2f0:

    # mc "Pues sí. Me hubiera gustado estar... Sólo me puedo imaginar su sorpresa... lástima que no la pueda ver ya."
    mc "Oui, vraiment. J'aurais adoré être là… J'imagine sa surprise… Quel dommage que je ne puisse pas la voir maintenant."

# game/scripts/c14/c14.rpy:3593
translate french c14s006_Christmas_59e544f5:

    # "[eri] capta el sentido de tus palabras y te mira inquisitivamente. Asientes con la cabeza."
    "[eri] saisit le sens de vos paroles et vous regarde d'un air interrogateur. Vous hochez la tête."

# game/scripts/c14/c14.rpy:3595
translate french c14s006_Christmas_d8ef1cb1:

    # eri "Bueno, no puedes ver la mía, pero puedes ver la de [emm]."
    eri "Eh bien, vous ne pouvez pas voir le mien, mais vous pouvez voir celui de [emm]."

# game/scripts/c14/c14.rpy:3597
translate french c14s006_Christmas_30b72e36:

    # emm "¿La mía? ¿Por qué? Yo ya sabía que salía con él."
    emm "À moi ? Pourquoi ? Je savais déjà qu'elle sortait avec lui."

# game/scripts/c14/c14.rpy:3599
translate french c14s006_Christmas_26771490:

    # eri "Porque yo también salgo con él, [emm]."
    eri "Parce que je sors avec lui aussi, [emm]."

# game/scripts/c14/c14.rpy:3601
translate french c14s006_Christmas_8a79acca:

    # emm "{b}¿Qué?{/b}"
    emm "{b}Quoi ?{/b}"

# game/scripts/c14/c14.rpy:3602
translate french c14s006_Christmas_14711e51:

    # emm "¡No me jodáis! ¡Con eso no se bromea!"
    emm "Ne me cherchez pas ! Ce n'est pas une chose dont on plaisante !"

# game/scripts/c14/c14.rpy:3603
translate french c14s006_Christmas_e975c650:

    # emm "¿Me lo estáis diciendo en serio?"
    emm "Êtes-vous sérieux?"

# game/scripts/c14/c14.rpy:3604
translate french c14s006_Christmas_d1adefff:

    # emm "¡Por el amor de Dios! ¡Decid algo!"
    emm "Pour l'amour de Dieu ! Dis quelque chose !"

# game/scripts/c14/c14.rpy:3605
translate french c14s006_Christmas_2fde6581:

    # mc "Sí, [emm]. Estamos saliendo juntos."
    mc "Oui, [emm]. Nous sommes en couple."

# game/scripts/c14/c14.rpy:3607
translate french c14s006_Christmas_48447efd:

    # emm "¡Joder, [eri]! No quiero saber lo mal que lo has pasado..."
    emm "Bon sang, [eri] ! Je ne veux même pas savoir à quel point tu as souffert..."

# game/scripts/c14/c14.rpy:3608
translate french c14s006_Christmas_033cb142:

    # eri "¿Qué? ¿Yo? ¿Mal? ¡No te entiendo!"
    eri "Quoi ? Moi ? Mauvais ? Je ne te comprends pas !"

# game/scripts/c14/c14.rpy:3610
translate french c14s006_Christmas_47e165fb:

    # emm "Con lo mal que se te da guardar secretos, tenerme que ocultar algo así..."
    emm "Vu comme tu es incapable de garder un secret, devoir me cacher quelque chose comme ça..."

# game/scripts/c14/c14.rpy:3611
translate french c14s006_Christmas_5065c013:

    # mc "[emm], a quien se le da mal guardarlos es a ti..."
    mc "[emm], c'est toi qui es mauvais pour assurer leur sécurité..."

# game/scripts/c14/c14.rpy:3614
translate french c14s006_Christmas_5020f681:

    # emm "No me digas eso, que bien he guardado el de..."
    emm "Ne me dites pas ça, j'ai gardé celui de..."

# game/scripts/c14/c14.rpy:3615
translate french c14s006_Christmas_99af6d99:

    # mc "¡[emm]!"
    mc "[emm]!"

# game/scripts/c14/c14.rpy:3617
translate french c14s006_Christmas_3f2ec84d:

    # emm "¡Oops! ¡Casi!"
    emm "Oups ! Presque !"

# game/scripts/c14/c14.rpy:3620
translate french c14s006_Christmas_da2dc271:

    # emm "No me digas eso. Siempre he guardado tus secretos... bueno... casi siempre..."
    emm "Ne me dis pas ça. J'ai toujours gardé tes secrets… enfin… presque toujours…"

# game/scripts/c14/c14.rpy:3622
translate french c14s006_Christmas_1448a3a1:

    # eri "¿Algún secreto más que quieras compartir con nosotros, [mc]?"
    eri "D'autres secrets que vous aimeriez partager avec nous, [mc] ?"

# game/scripts/c14/c14.rpy:3624
translate french c14s006_Christmas_53966c96:

    # mc "Yo no, pero..."
    mc "Pas moi, mais..."

# game/scripts/c14/c14.rpy:3626
translate french c14s006_Christmas_c83ad9cb:

    # eil "Yo también salgo con él, [emm]."
    eil "Je sors aussi avec lui, [emm]."

# game/scripts/c14/c14.rpy:3628
translate french c14s006_Christmas_fb563225:

    # emm "Bueno, de ti ya me lo imaginaba..."
    emm "Eh bien, je l'avais déjà deviné à ton sujet..."

# game/scripts/c14/c14.rpy:3630
translate french c14s006_Christmas_a5d7bb60:

    # eil "¿Qué? ¿Desde cuando?"
    eil "Quoi ? Depuis quand ?"

# game/scripts/c14/c14.rpy:3632
translate french c14s006_Christmas_4251c24c:

    # emm "Desde que me dijo que estaría con otras chicas."
    emm "Depuis qu'il m'a dit qu'il serait avec d'autres filles."

# game/scripts/c14/c14.rpy:3633
translate french c14s006_Christmas_c58fde1c:

    # emm "A ver, si estaba conmigo y quería estar con otras... tú tenías que ser una de las otras."
    emm "Écoute, s'il était avec moi et qu'il voulait être avec d'autres... tu devais être l'un de ces autres."

# game/scripts/c14/c14.rpy:3634
translate french c14s006_Christmas_4caf16ce:

    # emm "Además, eso de llevar a [eri] cada día al café... pero claro, si también sale con ella..."
    emm "En plus, il emmène [eri] au café tous les jours... mais bien sûr, il sort aussi avec elle..."

# game/scripts/c14/c14.rpy:3635
translate french c14s006_Christmas_223e504d:

    # emm "Todos os veíamos antes de que se fuera a Portland y erais la pareja perfecta. Yo incluso lloré un poquito cuando rompisteis."
    emm "On vous a tous vus avant son départ pour Portland, et vous formiez le couple parfait. J'ai même versé quelques larmes lors de votre rupture."

# game/scripts/c14/c14.rpy:3637
translate french c14s006_Christmas_69c3d218:

    # emm "¡Joder! ¡Las tres saliendo con el mismo chico!"
    emm "Mince alors ! Elles sortent toutes les trois avec le même garçon !"

# game/scripts/c14/c14.rpy:3639
translate french c14s006_Christmas_f1a75798:

    # emm "No me imagino a nadie con la que me importase menos compartirlo que con vosotras... bueno, sí... pero soy una tumba."
    emm "Je ne peux imaginer personne avec qui je tiendrais moins à partager ça que toi… enfin, si… mais je suis un coffre-fort."

# game/scripts/c14/c14.rpy:3641
translate french c14s006_Christmas_252fc179:

    # emm "No me imagino a nadie con la que me importase menos compartirlo que con vosotras..."
    emm "Je ne peux imaginer personne avec qui je serais moins enclin à partager cela qu'avec vous tous..."

# game/scripts/c14/c14.rpy:3642
translate french c14s006_Christmas_381c8a2b:

    # eil "*Susurrando* Se ha roto." (multiple=2)
    eil "*Chuchotant* Il est cassé." (multiple=2)

# game/scripts/c14/c14.rpy:3643
translate french c14s006_Christmas_4dd608ab:

    # eri "*Susurrando* Creía que nos iba a matar." (multiple=2)
    eri "*Chuchotant* Je pensais qu'il allait nous tuer." (multiple=2)

# game/scripts/c14/c14.rpy:3645
translate french c14s006_Christmas_f2b04eb8:

    # mc "Ninguno que esté en mi poder compartir. Y si [emm] sabe alguno, mejor que tenga esa preciosa boca cerrada."
    mc "Je n'en connais aucune. Et si [emm] en sait, il ferait mieux de la fermer."

# game/scripts/c14/c14.rpy:3647
translate french c14s006_Christmas_1e533c31:

    # mc "Igual que vas a hacer tú, ¿no?"
    mc "Exactement comme tu vas le faire, n'est-ce pas ?"

