translate french c14s006_Christmas_1fa169a9:

    # mc "Y no tenemos por qué defender nuestra relación delante de nadie, Meemaw. Ni necesitamos la autorización de nadie."
    mc "Et nous n'avons à justifier notre relation devant personne, Mémé. Nous n'avons besoin de la permission de personne non plus."

# game/scripts/c14/c14.rpy:3883
translate french c14s006_Christmas_ff186d88:

    # bet "*Risa* Sigue así, hermanita. Si sigues protestando, los vas a unir más todavía."
    bet "*Rires* Continue comme ça, petite sœur. Si tu continues à protester, tu ne feras que les rapprocher."

# game/scripts/c14/c14.rpy:3886
translate french c14s006_Christmas_e21f8a91:

    # mee "¿Tú no ves que sea una locura?"
    mee "Tu ne vois pas que c'est absurde ?"

# game/scripts/c14/c14.rpy:3888
translate french c14s006_Christmas_c65e3e94:

    # bet "Claro que sí. Igual de locura que nuestros padres vieron que te casaras con John. Y eso os unió aún más."
    bet "Bien sûr. Tout comme nos parents trouvaient ça fou quand tu as épousé John. Et ça vous a encore plus rapprochés."

# game/scripts/c14/c14.rpy:3890
translate french c14s006_Christmas_16d0abd3:

    # mee "¡Pero eso es porque eran unos clasistas y John estaba sin blanca! ¿Tú ves esto normal?"
    mee "Mais c'est parce qu'ils étaient classistes et que John était fauché ! Vous trouvez ça normal ?"

# game/scripts/c14/c14.rpy:3892
translate french c14s006_Christmas_85a1caa0:

    # mee "¡Son familia, por el amor de Dios!"
    mee "C'est la famille, bon sang !"

# game/scripts/c14/c14.rpy:3894
translate french c14s006_Christmas_d5e2b20e:

    # mee "¡La diferencia de edad es enorme!"
    mee "La différence d'âge est énorme !"

# game/scripts/c14/c14.rpy:3896
translate french c14s006_Christmas_c507a76b:

    # bet "Y cuantos más impedimentos pongas, más fuerte se va a hacer su relación. ¿No lo puedes ver?"
    bet "Et plus vous leur mettrez d'obstacles, plus leur relation se renforcera. Vous ne voyez pas ça ?"

# game/scripts/c14/c14.rpy:3897
translate french c14s006_Christmas_ad5eff57:

    # bet "En África he visto relaciones de todo tipo. Las que tú consideras normales y las que no. De los dos tipos han funcionado y de los dos tipos se han roto."
    bet "En Afrique, j'ai vu toutes sortes de relations. Celles que l'on considère comme normales et celles que l'on ne considère pas comme telles. Les deux types ont fonctionné, et les deux types ont échoué."

# game/scripts/c14/c14.rpy:3898
translate french c14s006_Christmas_176835aa:

    # bet "Esto parece especial, ¿no?"
    bet "Cela semble exceptionnel, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3900
translate french c14s006_Christmas_aaf505d1:

    # mee "*Gruñido* Especial es una forma suave de llamarlo."
    mee "*Grogne* Spécial est une façon polie de le dire."

# game/scripts/c14/c14.rpy:3902
translate french c14s006_Christmas_aa190cb1:

    # bet "Y nuestro [mc] también es especial, ¿no?"
    bet "Et notre [mc] est spécial lui aussi, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3904
translate french c14s006_Christmas_d2a724d6:

    # mee "*Gruñido* Sí, ya se ve que es especial."
    mee "*Grogne* Ouais, on voit bien qu'il est spécial."

# game/scripts/c14/c14.rpy:3906
translate french c14s006_Christmas_60017145:

    # bet "¿Por qué no le das un voto de confianza a ver que sale de esta relación?"
    bet "Pourquoi ne pas donner une chance à cette relation et voir ce qu'elle donnera ?"

# game/scripts/c14/c14.rpy:3908
translate french c14s006_Christmas_7391561a:

    # mee "*Gruñido* ¡Qué fácil es para ti decirlo!"
    mee "*Grogne* Comme c'est facile à dire pour toi !"

# game/scripts/c14/c14.rpy:3910
translate french c14s006_Christmas_e646a744:

    # kia "Sé que me voy a meter en un asunto familiar en el que no pinto nada, pero escuchadme un momento, por favor."
    kia "Je sais que je m'immisce dans une affaire familiale qui ne me concerne pas, mais s'il vous plaît, écoutez-moi un instant."

# game/scripts/c14/c14.rpy:3911
translate french c14s006_Christmas_46fff3ea:

    # kia "Cuando [mc] empezó a salir con mi Eileen, no veía ningún futuro a esa relación. Me parecía que [mc] no era lo suficientemente bueno para mi hija."
    kia "Quand il a commencé à sortir avec ma fille Eileen, je ne voyais aucun avenir dans leur relation. Je sentais qu'il n'était pas assez bien pour ma fille."

# game/scripts/c14/c14.rpy:3913
translate french c14s006_Christmas_fc9b7e22:

    # mee "¿Qué? ¿Estás diciendo que mi nieto no era lo suficientemente bueno?"
    mee "Quoi ? Vous insinuez que mon petit-fils n'était pas assez bien ?"

# game/scripts/c14/c14.rpy:3915
translate french c14s006_Christmas_ab6f5705:

    # bet "Déjala acabar, por Dios, Olivia."
    bet "Laisse-la finir, pour l'amour de Dieu, Olivia."

# game/scripts/c14/c14.rpy:3917
translate french c14s006_Christmas_684fb2d6:

    # kia "Gracias, Betty."
    kia "Merci, Betty."

# game/scripts/c14/c14.rpy:3918
translate french c14s006_Christmas_7d17a230:

    # kia "Si me hubiera opuesto a su relación, la hubiera hecho más fuerte artificialmente. Y el tiempo me demostró que estaba equivocada."
    kia "Si je m'étais opposé à leur relation, je l'aurais artificiellement renforcée. Et le temps m'a donné tort."

# game/scripts/c14/c14.rpy:3919
translate french c14s006_Christmas_715381ec:

    # kia "Si hay alguien capaz de sacar adelante esta relación, por diferente que sea, es [mc]."
    kia "S'il y a quelqu'un capable de faire fonctionner cette relation, aussi différente soit-elle, c'est [mc]."

# game/scripts/c14/c14.rpy:3920
translate french c14s006_Christmas_887f84c9:

    # mc "Gracias, Kiara."
    mc "Merci, Kiara."

# game/scripts/c14/c14.rpy:3921
translate french c14s006_Christmas_76045841:

    # mc "Por cierto, las chicas no saben nada y solo es decisión nuestra cuándo y dónde decírselo, con lo que cuento con vuestra discrección."
    mc "D'ailleurs, les filles ne savent rien et c'est à nous seuls de décider quand et où leur dire, je compte donc sur votre discrétion."

# game/scripts/c14/c14.rpy:3923
translate french c14s006_Christmas_afc07c9b:

    # kia "Ningún problema. Estoy totalmente de acuerdo y es un asunto vuestro."
    kia "Pas de problème. Je suis tout à fait d'accord, et ça ne vous regarde pas."

# game/scripts/c14/c14.rpy:3924
translate french c14s006_Christmas_6869a41f:

    # mee "*Gruñido* Vale."
    mee "*Grogne* D'accord."

# game/scripts/c14/c14.rpy:3925
translate french c14s006_Christmas_94723c11:

    # bet "Es lo lógico. La noticia puede caer como una bomba."
    bet "C'est logique. Cette nouvelle pourrait faire l'effet d'une bombe."

# game/scripts/c14/c14.rpy:3927
translate french c14s006_Christmas_67f94806:

    # mc "Perfecto, porque por allí vienen con el hielo. Espero que tengamos la fiesta en paz y no le amargues la Navidad a nadie, Meemaw."
    mc "Parfait, puisqu'ils apportent la glace. J'espère que nous pourrons passer une fête paisible et que tu ne gâcheras le Noël de personne, Mémé."

# game/scripts/c14/c14.rpy:3929
translate french c14s006_Christmas_e3a2a239:

    # mee "*Gruñido* Vale. Pero tú y yo vamos a tener que hablar cuando lleguemos a casa."
    mee "*Grogne* D'accord. Mais il faudra qu'on parle quand on rentrera à la maison."

# game/scripts/c14/c14.rpy:3932
translate french c14s006_Christmas_83f290af:

    # mee "No estoy protestando. Tan solo creía que era una cosa que hacía dentro de la familia."
    mee "Je ne proteste pas. Je pensais simplement que c'était quelque chose que j'avais fait au sein de ma famille."

# game/scripts/c14/c14.rpy:3934
translate french c14s006_Christmas_e6315368:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Voici les filles avec la glace."

# game/scripts/c14/c14.rpy:3938
translate french c14s006_Christmas_e6315368_1:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Voici les filles avec la glace."

# game/scripts/c14/c14.rpy:3940
translate french c14s006_Christmas_e91e0cfe:

    # mc "Ya solo faltan por llegar Alexia y Saira, y podremos ir a comer."
    mc "Alexia et Saira sont les seules qui ne sont pas encore arrivées, et ensuite nous pourrons aller manger."

# game/scripts/c14/c14.rpy:3942
translate french c14s006_Christmas_12de1401:

    # "Mientras esperáis a Alexia y Saira, se van formando grupitos de conversación."
    "Pendant que vous attendez Alexia et Saira, de petits groupes de personnes commencent à se former."

# game/scripts/c14/c14.rpy:3945
translate french c14s006_Christmas_978b03ad:

    # "[mar] y [nor] se apartan para discutir lo que acaba de pasar tras lanzarte una mirada indicándote que no te acerques."
    "[mar] et [nor] s'écartent pour discuter de ce qui vient de se passer après vous avoir lancé un regard indiquant que vous ne devriez pas vous approcher davantage."

# game/scripts/c14/c14.rpy:3947
translate french c14s006_Christmas_1ba577de:

    # "[mar] y [nor] se apartan para charlar después de indicarte con una mirada que no te acerques."
    "[mar] et [nor] s'écartent pour discuter après avoir indiqué d'un regard que vous ne devriez pas vous approcher."

# game/scripts/c14/c14.rpy:3950
translate french c14s006_Christmas_f7e19f40:

    # "Samantha y Kiara empiezan a charlar. Supones por los gestos que la conversación va tanto sobre el brazo como sobre el beso."
    "Samantha et Kiara entament une conversation. Leurs gestes laissent deviner que le sujet abordé est à la fois le bras et le baiser."

# game/scripts/c14/c14.rpy:3951
translate french c14s006_Christmas_e1fc02fa:

    # "Tienes que darle las gracias a Kiara en algún momento, pero prefieres no acercarte."
    "Vous devrez remercier Kiara à un moment donné, mais vous préféreriez ne pas l'aborder."

# game/scripts/c14/c14.rpy:3953
translate french c14s006_Christmas_86266bc7:

    # "Samantha y Kiara empiezan a charlar sobre el brazo."
    "Samantha et Kiara commencent à discuter du bras."

# game/scripts/c14/c14.rpy:3955
translate french c14s006_Christmas_0888e985:

    # "[dap] y Scarlett han secuestrado a Simone y ha empezado a presentarles a las chicas. Hasta ahora solo conocía a Debbie."
    "Scarlett et elle ont kidnappé Simone et ont commencé à la présenter aux filles. Jusqu'à présent, elle ne connaissait que Debbie."

# game/scripts/c14/c14.rpy:3957
translate french c14s006_Christmas_7f47eb10:

    # "[emm] y Eileen se quedan apartadas. Parece que tienen cosas que decirse."
    "[emm] et Eileen se tiennent à l'écart. Il semble qu'elles aient quelque chose à se dire."

# game/scripts/c14/c14.rpy:3959
translate french c14s006_Christmas_f7f18243:

    # "Tan solo esperas que a [emm] no se le escapen más secretos de los necesarios."
    "Vous espérez simplement que [emm] ne laisse pas fuiter plus de secrets que nécessaire."

# game/scripts/c14/c14.rpy:3962
translate french c14s006_Christmas_35ac3e9e:

    # "[eri] acude a hacer compañía a Meemaw y Betty, que parecían a punto de tener una discusión."
    "[eri] va tenir compagnie à Meemaw et Betty, qui semblaient sur le point de se disputer."

# game/scripts/c14/c14.rpy:3973
translate french c14s006_Christmas_102ac85a:

    # "A lo lejos ves aparecer a Saira. Parece que se ha cambiado nada más bajar del taxi que la ha traído de la universidad."
    "Au loin, on aperçoit Saira. On dirait qu'elle a changé dès qu'elle est sortie du taxi qui l'a amenée de l'université."

# game/scripts/c14/c14.rpy:3975
translate french c14s006_Christmas_9457da45:

    # "[emm] te hace señas para que te acerques mientras llama a Saira."
    "[emm] vous signale de vous rapprocher tout en appelant Saira."

# game/scripts/c14/c14.rpy:3976
translate french c14s006_Christmas_d276daf7:

    # emm "¡Saira! Ven aquí, quiero presentarte a alguien."
    emm "Saira ! Viens ici, je veux te présenter quelqu'un."

# game/scripts/c14/c14.rpy:3978
translate french c14s006_Christmas_135d3b44:

    # sai "Hola, [emm]. Gracias por mandarme la ubicación. Como Lisa se ha ido antes, no sabía donde era."
    sai "Salut [emm]. Merci de m'avoir envoyé l'adresse. Comme Lisa est partie plus tôt, je ne savais pas où c'était."

# game/scripts/c14/c14.rpy:3981
translate french c14s006_Christmas_0a337b23:

    # emm "No pasa nada, lo mejor para nuestras clientas, ¿no?"
    emm "C'est bon, c'est ce qu'il y a de mieux pour nos clients, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3984
translate french c14s006_Christmas_f77bdc26:

    # emm "No pasa nada, para eso estamos las amigas, ¿no?"
    emm "C'est bon, c'est à ça que servent les amis, non ?"

# game/scripts/c14/c14.rpy:3985
translate french c14s006_Christmas_c3f90b4c:

    # emm "Por cierto, te presento a Eileen. Eileen, esta es Saira."
    emm "Au fait, permettez-moi de vous présenter Eileen. Eileen, voici Saira."

# game/scripts/c14/c14.rpy:3988
translate french c14s006_Christmas_156b44f1:

    # sai "Así que tú eres la famosa Eileen, con la que {b}rompió{/b} antes de estar conmigo, ¿no? Encantada. de. conocerte."
    sai "Alors, vous êtes la fameuse Eileen, celle avec qui il a rompu avant d'être avec moi, c'est bien ça ? Enchantée."

# game/scripts/c14/c14.rpy:3990
translate french c14s006_Christmas_e64a05aa:

    # sai "Así que tú eres la famosa Eileen, la {b}ex-novia{/b} del instituto, ¿no? Encantada. de. conocerte."
    sai "Alors, tu es la fameuse Eileen, ton ex du lycée, c'est bien ça ? Enchantée."

# game/scripts/c14/c14.rpy:3992
translate french c14s006_Christmas_92867534:

    # eil "Y tú eres la ex-novia de Portland... Ah, no, perdona... la {b}follamiga{/b} de Portland. No sé si puedo decir lo mismo sobre conocerte."
    eil "Et tu es l'ex de Portland… Oh non, pardon… sa partenaire de sexe. Je ne sais pas si je peux en dire autant de toi."

# game/scripts/c14/c14.rpy:3994
translate french c14s006_Christmas_9c321a78:

    # emm "Bueno, os dejo aquí a los tres para que os pongáis al día. Voy a hablar con la abuela antes de que muerda a Tía Betty."
    emm "Bon, je vous laisse tous les trois pour rattraper le temps perdu. Je vais parler à grand-mère avant qu'elle ne morde tante Betty."

# game/scripts/c14/c14.rpy:3995
translate french c14s006_Christmas_b45e6e58:

    # mc "*Susurrando* Sabes que la puedes haber liado, ¿no?"
    mc "*Chuchotant* Tu sais que tu as peut-être fait une bêtise, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3996
translate french c14s006_Christmas_617af5c0:

    # emm "Tarde o temprano se tenían que conocer. Las dos viven en casa... Suerte con las fieras. *Risa*"
    emm "Ils allaient forcément se rencontrer un jour ou l'autre. Ils vivent tous les deux chez leurs parents... Bonne chance avec les animaux sauvages ! *Rires*"

# game/scripts/c14/c14.rpy:3998
translate french c14s006_Christmas_12cb9bdf:

    # sai "Me alegra conocerte por fin. Solo había visto fotos tuyas. Estabas mejor en las fotos."
    sai "Je suis ravie de vous rencontrer enfin. Je n'avais vu que des photos de vous. Vous étiez plus belle en photo."

# game/scripts/c14/c14.rpy:3999
translate french c14s006_Christmas_caa48aef:

    # eil "Bueno, al menos de mí estaba lo suficientemente orgulloso como para enseñar fotos. Yo no sabía el aspecto que tenías. No me sorprende."
    eil "Eh bien, au moins j'étais assez fière de moi pour montrer des photos. Je ne savais pas à quoi tu ressemblais. Ça ne m'étonne pas."

# game/scripts/c14/c14.rpy:4000
translate french c14s006_Christmas_dda9ef10:

    # mc "Chicas..."
    mc "Filles..."

# game/scripts/c14/c14.rpy:4002
translate french c14s006_Christmas_cfa05590:

    # sai "Bueno, a lo mejor no quería enseñarte fotos mías para que no te sintieras mal."
    sai "Eh bien, peut-être que je ne voulais pas te montrer de photos de moi pour que tu ne te sentes pas mal."

# game/scripts/c14/c14.rpy:4003
translate french c14s006_Christmas_694d9386:

    # eil "O es posible que sea por que se avergonzaba de haber salido... perdón, haberse acostado contigo."
    eil "Ou peut-être parce qu'il avait honte d'être sorti… pardon, d'avoir couché avec toi."

# game/scripts/c14/c14.rpy:4004
translate french c14s006_Christmas_09a87050:

    # mc "Chicas, dejadlo ya, por favor."
    mc "Les filles, arrêtez ça, s'il vous plaît."

# game/scripts/c14/c14.rpy:4006
translate french c14s006_Christmas_a9e4b562:

    # sai "Al menos yo no me lié con nadie una vez lo dejamos, putón."
    sai "Au moins, je n'ai couché avec personne après notre rupture, espèce de salope."

# game/scripts/c14/c14.rpy:4007
translate french c14s006_Christmas_19030c30:

    # eil "¿Quién coño querría liarse contigo? Si le tuviste que dejar la puerta abierta a que se liara con otras... Fea."
    eil "Qui voudrait bien sortir avec toi ? Tu lui as laissé la porte ouverte pour qu'il puisse coucher avec d'autres femmes… C'est moche."

# game/scripts/c14/c14.rpy:4009
translate french c14s006_Christmas_8f27b491:

    # sai "¿Ya se ha ido?" (multiple=2)
    sai "Est-il déjà parti ?" (multiple=2)

# game/scripts/c14/c14.rpy:4010
translate french c14s006_Christmas_146f3b81:

    # eil "¿No nos ve?" (multiple=2)
    eil "Vous ne nous voyez pas ?" (multiple=2)

# game/scripts/c14/c14.rpy:4011
translate french c14s006_Christmas_3b396030:

    # mc "¿Qué? ¿Quién?"
    mc "Quoi ? Qui ?"

# game/scripts/c14/c14.rpy:4013
translate french c14s006_Christmas_bd8cfe57:

    # sai "Tu hermana." (multiple=2)
    sai "Ta sœur." (multiple=2)

# game/scripts/c14/c14.rpy:4014
translate french c14s006_Christmas_4392ef66:

    # eil "[emm]." (multiple=2)
    eil "[emm]." (multiple=2)

# game/scripts/c14/c14.rpy:4015
translate french c14s006_Christmas_3f59ed2d:

    # mc "Sí... ya se ha ido. ¿Por qué?"
    mc "Oui… il est déjà parti. Pourquoi ?"

# game/scripts/c14/c14.rpy:4018
translate french c14s006_Christmas_0d78fc0a:

    # eil "¿Qué tal el primer día de clase?"
    eil "Comment s'est passée ta première journée de cours ?"

# game/scripts/c14/c14.rpy:4019
translate french c14s006_Christmas_3e91fc64:

    # sai "Muy pesado, pero por fin ha acabado y me puedo relajar con vosotras."
    sai "C'était vraiment difficile, mais c'est enfin terminé et je peux me détendre avec vous tous."

# game/scripts/c14/c14.rpy:4020
translate french c14s006_Christmas_db98c677:

    # mc "¿Qué? ¿Qué está pasando aquí? No entiendo nada."
    mc "Quoi ? Que se passe-t-il ici ? Je ne comprends rien."

# game/scripts/c14/c14.rpy:4022
translate french c14s006_Christmas_3602adb2:

    # eil "Saira y yo nos conocimos anoche, nos presentó [eri]."
    eil "Saira et moi nous sommes rencontrées hier soir, elle nous a présentées [eri]."

# game/scripts/c14/c14.rpy:4023
translate french c14s006_Christmas_a02bac1e:

    # sai "Estaba en la piscina tomando el aire después de cenar. Tenía que digerir la conversación contigo. Entonces llegaron las dos."
    sai "Après le dîner, j'étais au bord de la piscine pour prendre l'air. J'avais besoin de digérer notre conversation. C'est alors qu'ils sont arrivés."

# game/scripts/c14/c14.rpy:4025
translate french c14s006_Christmas_63d8eaa0:

    # eil "Digamos que la conversación empezó más o menos como la de ahora, pero [eri] puso paz."
    eil "Disons que la conversation a commencé plus ou moins comme elle l'est maintenant, mais [eri] a fait la paix."

# game/scripts/c14/c14.rpy:4026
translate french c14s006_Christmas_13bf4b37:

    # sai "Bueno, fue un poco más suave..."
    sai "Eh bien, c'était un peu plus doux..."

# game/scripts/c14/c14.rpy:4028
translate french c14s006_Christmas_c0dbabff:

    # eil "Sí, te has pasado con lo de putón. Además tú eso no lo debías saber... y solo fueron un par de citas, no me acosté con nadie."
    eil "Oui, tu es allé trop loin en me traitant de salope. De plus, tu n'aurais pas dû le savoir… et ce n'était que quelques rendez-vous, je n'ai couché avec personne."

# game/scripts/c14/c14.rpy:4029
translate french c14s006_Christmas_102e2bcb:

    # sai "¿Y lo de llamarme fea? ¿Tenemos 10 años, Eileen? *Risa*"
    sai "Et le fait de me traiter de moche ? On a dix ans, Eileen ? *Rires*"

# game/scripts/c14/c14.rpy:4030
translate french c14s006_Christmas_311c06b0:

    # mc "Estoy flipando..."
    mc "Je panique..."

# game/scripts/c14/c14.rpy:4032
translate french c14s006_Christmas_164be0b6:

    # eil "[eri] nos dijo que no nos sorprendiéramos si [emm] intentaba enfrentarnos hoy de alguna forma."
    eil "[eri] nous a dit de ne pas être surpris si [emm] essayait de nous confronter aujourd'hui d'une manière ou d'une autre."

# game/scripts/c14/c14.rpy:4034
translate french c14s006_Christmas_3824816c:

    # eil "{i}(Y ahora que sé que está contigo, la entiendo perfectamente. Si peleábamos delante tuyo nos ridiculizaríamos a nosotras mismas.){/i}"
    eil "{i}(Et maintenant que je sais qu'elle est avec toi, je la comprends parfaitement. Si nous nous étions battus devant toi, nous nous serions ridiculisés.){/i}"

# game/scripts/c14/c14.rpy:4035
translate french c14s006_Christmas_726c3f15:

    # eil "Supongo que tener a dos ex-novias en la misma comida navideña podía ser un riesgo."
    eil "J'imagine que réunir deux ex-petites amies au même dîner de Noël pourrait être risqué."

# game/scripts/c14/c14.rpy:4037
translate french c14s006_Christmas_076eb4a7:

    # sai "¿Ya no soy la follamiga? *Risa* ¿He ascendido a ex-novia?"
    sai "Je ne suis plus une simple conquête sexuelle ? *Rires* Suis-je devenue son ex-petite amie ?"

# game/scripts/c14/c14.rpy:4039
translate french c14s006_Christmas_b8cfd6a9:

    # sai "Después de lo que dijo [eri], Eileen y yo estuvimos hablando largo y tendido."
    sai "Après ce qu'a dit [eri], Eileen et moi avons eu une longue conversation."

# game/scripts/c14/c14.rpy:4041
translate french c14s006_Christmas_aa265f5d:

    # sai "Tú me habías dicho que estabas con Eileen. Era raro estar hablando con ella en la piscina, después de un mes comiéndome la cabeza."
    sai "Tu m'as dit que tu étais avec Eileen. C'était étrange de lui parler au bord de la piscine après un mois à être obsédé par elle."

# game/scripts/c14/c14.rpy:4043
translate french c14s006_Christmas_d4423745:

    # sai "Tú me habías dicho que no habías vuelto con Eileen, pero era raro estar hablando con ella en la piscina después de un mes comiéndome la cabeza."
    sai "Tu m'avais dit que tu n'étais pas retourné avec Eileen, mais c'était étrange de lui parler à la piscine après un mois à me rendre fou."

# game/scripts/c14/c14.rpy:4045
translate french c14s006_Christmas_234e5c34:

    # eil "Empezamos como dos perras celosas, especialmente Saira, y acabamos contándonos los mejores momentos que hemos pasado contigo."
    eil "Au début, on se comportait comme deux jalouses, surtout Saira, et finalement on a fini par se raconter les meilleurs moments qu'on a passés avec toi."

# game/scripts/c14/c14.rpy:4047
translate french c14s006_Christmas_340c7610:

    # eil "Parece que vuelves a estar con las dos... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "On dirait que tu es de nouveau avec les deux… oui, Saira a laissé échapper l'info. Tant mieux pour toi, Saira sera un excellent ajout au harem."

# game/scripts/c14/c14.rpy:4049
translate french c14s006_Christmas_96103bf0:

    # eil "Parece que vuestro reencuentro fue más frío que el nuestro, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Il semblerait que vos retrouvailles aient été plus froides que les nôtres, mais vous devriez y réfléchir à deux fois. Saira serait un excellent ajout au harem."

# game/scripts/c14/c14.rpy:4051
translate french c14s006_Christmas_8147fbdd:

    # eil "Parece que vuestro reencuentro no fue tan frío como el nuestro... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "Il semblerait que vos retrouvailles n'aient pas été aussi glaciales que les nôtres… oui, Saira a laissé échapper l'information. Tant mieux pour toi, Saira sera un atout précieux pour le harem."

# game/scripts/c14/c14.rpy:4053
translate french c14s006_Christmas_16813b17:

    # eil "Parece que nuestros reencuentros contigo fueron igual de frío, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Il semblerait que nos retrouvailles avec vous aient été tout aussi glaciales, mais vous devriez y réfléchir à deux fois. Saira serait un excellent ajout au harem."

# game/scripts/c14/c14.rpy:4054
translate french c14s006_Christmas_583e6a89:

    # mc "¿Qué? ¿Le has dicho lo del harén?"
    mc "Quoi ? Tu lui as parlé du harem ?"

# game/scripts/c14/c14.rpy:4056
translate french c14s006_Christmas_ef0f64a8:

    # mc "No hay harén, solo estoy saliendo con Saira."
    mc "Il n'y a pas de harem, je sors juste avec Saira."

# game/scripts/c14/c14.rpy:4059
translate french c14s006_Christmas_0a11ba44:

    # mc "No hay harén, solo estoy saliendo contigo."
    mc "Il n'y a pas de harem, je sors juste avec toi."

# game/scripts/c14/c14.rpy:4061
translate french c14s006_Christmas_a8320589:

    # mc "No hay harén, solo estoy saliendo con una chica."
    mc "Il n'y a pas de harem, je sors juste avec une fille."

# game/scripts/c14/c14.rpy:4063
translate french c14s006_Christmas_e1841300:

    # sai "Después de hablar bastante rato..."
    sai "Après avoir discuté pendant un bon moment..."

# game/scripts/c14/c14.rpy:4065
translate french c14s006_Christmas_1e128303:

    # sai "Nos dimos cuenta de que si estás con las dos es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Nous avons compris que si vous êtes avec les deux, c'est parce que nous vous avons mis en tête l'idée d'une relation libre et d'un harem."

# game/scripts/c14/c14.rpy:4067
translate french c14s006_Christmas_62551a4f:

    # sai "Nos dimos cuenta de que si estás con Eileen y yo puedo tener una oportunidad, es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Nous avons compris que si tu es avec Eileen et que nous avons une chance, c'est parce que nous t'avons mis en tête l'idée d'une relation libre et d'un harem."

# game/scripts/c14/c14.rpy:4070
translate french c14s006_Christmas_d23144e1:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me haya dado la oportunidad que necesitaba para volver contigo."
    sai "J'ai compris que la proposition d'Eileen de vous avoir créé un harem m'avait peut-être donné l'opportunité dont j'avais besoin pour revenir vers vous."

# game/scripts/c14/c14.rpy:4072
translate french c14s006_Christmas_6fd24c25:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me de la oportunidad que necesitaba para volver contigo en el futuro."
    sai "J'ai compris que la proposition d'Eileen de te constituer un harem pourrait me donner l'opportunité dont j'avais besoin pour me remettre avec toi à l'avenir."

# game/scripts/c14/c14.rpy:4074
translate french c14s006_Christmas_56102810:

    # sai "Después nos pasamos un rato riendo." (multiple=2)
    sai "Après cela, nous avons passé un peu de temps à rire." (multiple=2)

# game/scripts/c14/c14.rpy:4075
translate french c14s006_Christmas_bf25048c:

    # eil "Y comparando notas. *Risa*" (multiple=2)
    eil "Et on compare nos notes. *Rires*" (multiple=2)

# game/scripts/c14/c14.rpy:4076
translate french c14s006_Christmas_3c1a15a5:

    # sai "Descubrimos que no somos rivales." (multiple=2)
    sai "Nous avons découvert que nous ne sommes pas rivaux." (multiple=2)

# game/scripts/c14/c14.rpy:4077
translate french c14s006_Christmas_12db876d:

    # eil "Y decidimos hacernos amigas." (multiple=2)
    eil "Et nous avons décidé de devenir amis." (multiple=2)

# game/scripts/c14/c14.rpy:4079
translate french c14s006_Christmas_f9ce5a32:

    # eil "Saira no podía creerse que [emm] fuera a intentar algo como lo que ha hecho, pero yo la conozco mejor."
    eil "Saira n'arrivait pas à croire que [emm] puisse tenter une chose pareille, mais je la connais mieux."

# game/scripts/c14/c14.rpy:4081
translate french c14s006_Christmas_7dad870f:

    # sai "Traté poco con ella ayer, parecía enfadada, pero creía que tenía que ver con la situación de Scarlett."
    sai "Je ne lui ai pas beaucoup parlé hier ; elle semblait en colère, mais je pensais que c'était lié à la situation de Scarlett."

# game/scripts/c14/c14.rpy:4083
translate french c14s006_Christmas_e55bb51d:

    # sai "Traté poco con ella ayer, parecía una chica muy agradable."
    sai "Je ne lui ai pas beaucoup parlé hier, elle avait l'air d'une fille très gentille."

# game/scripts/c14/c14.rpy:4084
translate french c14s006_Christmas_e29c8e39:

    # mc "Es muy agradable... cuando quiere. Supongo que querrá después de que le de unos azotes. *Risa*"
    mc "Il est très gentil… quand il le veut. J’imagine qu’il le voudra après que je lui ai donné quelques fessées. *Rires*"

# game/scripts/c14/c14.rpy:4086
translate french c14s006_Christmas_2a35a010:

    # eil "Déjale creer que nos hemos peleado. Será una pequeña victoria en su cabeza."
    eil "Laissons-le croire qu'on s'est disputés. Ce sera une petite victoire à ses yeux."

# game/scripts/c14/c14.rpy:4087
translate french c14s006_Christmas_11c00290:

    # sai "Y nos dará tiempo de planear nuestra venganza. *Risa*"
    sai "Et cela nous donnera le temps de préparer notre vengeance. *Rires*"

# game/scripts/c14/c14.rpy:4089
translate french c14s006_Christmas_2891af26:

    # mc "Haced que parezca un accidente. Por allí viene la última invitada y sospecharía enseguida de vosotras."
    mc "Faites croire à un accident. La dernière invitée arrive par ici et elle vous soupçonnerait immédiatement."

# game/scripts/c14/c14.rpy:4100
translate french c14s006_Christmas_00d216ac:

    # mc "Alexia, ven. Quiero presentarte a alguien."
    mc "Alexia, viens ici. Je veux te présenter quelqu'un."

# game/scripts/c14/c14.rpy:4101
translate french c14s006_Christmas_14e3d577:

    # mc "Alexia, Saira. Saira, Alexia."
    mc "Alexia, Saira. Saira, Alexia."

# game/scripts/c14/c14.rpy:4103
translate french c14s006_Christmas_8777e192:

    # oma "Encantada de conocerte, Saira. ¿Eres la última estudiante?"
    oma "Enchantée de faire votre connaissance, Saira. Êtes-vous la dernière élève ?"

# game/scripts/c14/c14.rpy:4104
translate french c14s006_Christmas_042239fa:

    # sai "Sí, llegué ayer. ¿Eres amiga de la familia?"
    sai "Oui, je suis arrivé hier. Êtes-vous un ami de la famille ?"

# game/scripts/c14/c14.rpy:4105
translate french c14s006_Christmas_fe99e360:

    # oma "Más o menos. He tenido que ayudar a [mc] en algunas cosas."
    oma "Plus ou moins. J'ai dû aider [mc] sur certains points."

# game/scripts/c14/c14.rpy:4106
translate french c14s006_Christmas_874d55fb:

    # oma "Hola, Eileen. Tenemos que hablar."
    oma "Salut Eileen. Il faut qu'on parle."

# game/scripts/c14/c14.rpy:4108
translate french c14s006_Christmas_a68d3962:

    # mc "¿Qué tal el viaje, Alexia?"
    mc "Comment s'est passé ton voyage, Alexia ?"

# game/scripts/c14/c14.rpy:4109
translate french c14s006_Christmas_f915a04a:

    # oma "Muy pesado, pero al menos ya estoy aquí."
    oma "Le chemin a été long, mais au moins j'y suis arrivé."

# game/scripts/c14/c14.rpy:4110
translate french c14s006_Christmas_716d306f:

    # oma "Me tienes que contar qué querías el lunes cuando me llamaste."
    oma "Vous devez me dire ce que vous vouliez lundi, lorsque vous m'avez appelé."

# game/scripts/c14/c14.rpy:4111
translate french c14s006_Christmas_325f881f:

    # mc "Te tengo que contar muchas cosas, Alexia, pero habrá tiempo."
    mc "J'ai beaucoup de choses à te dire, Alexia, mais nous aurons le temps."

# game/scripts/c14/c14.rpy:4112
translate french c14s006_Christmas_caa9a5c2:

    # mc "Creo que te estaban esperando para comer. A estas alturas Tía Betty se tiene que estar muriendo de hambre."
    mc "Je crois qu'ils attendaient que tu manges. Tante Betty doit mourir de faim maintenant."

# game/scripts/c14/c14.rpy:4115
translate french c14s006_Christmas_3f8bae97:

    # "Recogéis las sombrillas y las sillas y os dirigís al merendero."
    "Vous prenez les parasols et les chaises et vous vous dirigez vers l'aire de pique-nique."

# game/scripts/c14/c14.rpy:4117
translate french c14s006_Christmas_171f3852:

    # "Emma y Scarlett reparten gorros navideños para todos."
    "Emma et Scarlett distribuent des bonnets de Noël à tout le monde."

# game/scripts/c14/c14.rpy:4119
translate french c14s006_Christmas_6d2bc954:

    # "Después de lo que ha pasado durante la mañana, no te extraña que los grupos se entremezclen."
    "Après ce qui s'est passé ce matin, il n'est pas étonnant que les groupes se mélangent."

# game/scripts/c14/c14.rpy:4121
translate french c14s006_Christmas_007c3147:

    # "No parece haber diferencia entre familia, estudiantes, y las chicas de la ciudad."
    "Il ne semble y avoir aucune différence entre les filles de la famille, les étudiantes et les filles de la ville."

# game/scripts/c14/c14.rpy:4123
translate french c14s006_Christmas_06c9ac7f:

    # "Todo el mundo parece dispuesto a pasárselo bien y disfrutar de la comida."
    "Tout le monde semble prêt à passer un bon moment et à apprécier le repas."

# game/scripts/c14/c14.rpy:4125
translate french c14s006_Christmas_1d87fb41:

    # "Algunos gorros duran poco en las cabezas y acaban encima de la mesa. Hace demasiado calor para llevarlos en pleno verano."
    "Certains chapeaux ne restent pas longtemps sur la tête et finissent par tomber sur la table. Il fait trop chaud pour les porter en plein été."

# game/scripts/c14/c14.rpy:4127
translate french c14s006_Christmas_a9208bfb:

    # "Es vuestra primera Navidad juntos. ¿Quién sabe cómo será la próxima, la de verdad?"
    "C'est votre premier Noël ensemble. Qui sait à quoi ressemblera le prochain, le vrai ?"

# game/scripts/c14/c14.rpy:4136
translate french c14s006_Christmas_b2b9fa2b:

    # "Hay más gente que te gustaría que estuviera aquí. Y todavía faltan por llegar las últimas estudiantes. En la Navidad de verdad estarán."
    "Il y a encore des personnes que vous aimeriez avoir ici. Et les derniers étudiants ne sont pas encore arrivés. Ils seront là pour Noël."

# game/scripts/c14/c14.rpy:4137
translate french c14s006_Christmas_2031e2a1:

    # "¿Pero habrá vuelto Meemaw a Florida por entonces? ¿Tía Betty estará en algún hospital de África?"
    "Mais Meemaw sera-t-elle rentrée en Floride d'ici là ? Tante Betty sera-t-elle hospitalisée en Afrique ?"

# game/scripts/c14/c14.rpy:4139
translate french c14s006_Christmas_b3eee4f3:

    # "La sonrisa de Scarlett te saca de tus ensoñaciones."
    "Le sourire de Scarlett vous tire de vos rêveries."

# game/scripts/c14/c14.rpy:4140
translate french c14s006_Christmas_4b9e4cd6:

    # sca "¿Pasa algo, [mc]? Te veo ausente..."
    sca "Quelque chose ne va pas, [mc] ? Tu sembles distant..."

# game/scripts/c14/c14.rpy:4141
translate french c14s006_Christmas_85f4e9f8:

    # mc "No, cielo, no pasa nada. Solo estaba pensando en la próxima Navidad, la de verdad."
    mc "Non, chérie, ce n'est rien. Je pensais juste à Noël prochain, le vrai."

# game/scripts/c14/c14.rpy:4143
translate french c14s006_Christmas_0a62ee21:

    # sca "La verdad es que ésta ha salido un poco sosa, ¿cierto? Al final es un día de playa comiendo con ridículos gorros navideños."
    sca "Franchement, c'est un peu fade, non ? Au final, c'est juste une journée à la plage à manger en portant des chapeaux de Noël ridicules."

# game/scripts/c14/c14.rpy:4144
translate french c14s006_Christmas_007ebe11:

    # mc "¡Hey! No es nada sosa. No había visto nunca a 19 personas pasándoselo bien juntos sin malos rollos. Y menos habiendo familia en la mezcla."
    mc "Eh bien ! C'est tout sauf ennuyeux. Je n'ai jamais vu 19 personnes s'amuser autant ensemble sans le moindre problème. Surtout avec la famille de la partie."

# game/scripts/c14/c14.rpy:4146
translate french c14s006_Christmas_bcfa7996:

    # sca "La verdad es que tienes una familia increíble. Gracias por acogerme, [mc]. A [nor], a [mar] y a las chicas las he inundado de gracias, pero si no hubiera sido por ti..."
    sca "La vérité, c'est que vous avez une famille formidable. Merci de m'avoir accueillie, [mc]. J'ai déjà remercié [nor] et [mar] les filles mille fois, mais sans vous…"

# game/scripts/c14/c14.rpy:4147
translate french c14s006_Christmas_12abece5:

    # mc "No hace falta que des las gracias. Y te equivocas en una cosa, no tengo una familia increíble. La tenemos. Tú, yo, las chicas..."
    mc "Tu n'as pas besoin de me remercier. Et tu te trompes sur un point : je n'ai pas une famille extraordinaire. Nous, si. Toi, moi, les filles…"

# game/scripts/c14/c14.rpy:4148
translate french c14s006_Christmas_a9087ca8:

    # mc "Mira lo que has conseguido que hagamos y dime que no parecemos una gran familia."
    mc "Regarde ce que tu nous as fait faire et dis-moi qu'on ne ressemble pas à une grande famille."

# game/scripts/c14/c14.rpy:4149
translate french c14s006_Christmas_f015529a:

    # sca "*Risa* Nada que ver con mi concepto de familia. No hay nadie discutiendo. Me podría acostumbrar a esto."
    sca "*Rires* Ça n'a rien à voir avec ma conception de la famille. Personne ne se dispute. Je pourrais m'y faire."

# game/scripts/c14/c14.rpy:4150
translate french c14s006_Christmas_6d4d214a:

    # mc "Lo harás. No pensamos dejarte escapar. *Risa*"
    mc "Vous allez y arriver. On ne vous laissera pas vous en tirer comme ça. *Rires*"

# game/scripts/c14/c14.rpy:4152
translate french c14s006_Christmas_b110a990:

    # sca "¡Vamos a hacernos una foto juntos!"
    sca "Prenons une photo ensemble !"

# game/scripts/c14/c14.rpy:4153
translate french c14s006_Christmas_7e57e035:

    # mc "¿Una selfie?"
    mc "Un selfie ?"

# game/scripts/c14/c14.rpy:4154
translate french c14s006_Christmas_f81b7379:

    # sca "No, tonto, una foto de toda la familia junta."
    sca "Non, voyons, une photo de toute la famille réunie."

# game/scripts/c14/c14.rpy:4155
translate french c14s006_Christmas_57d4b6c8:

    # mc "¡Vamos!"
    mc "Allez!"

# game/scripts/c14/c14.rpy:4157
translate french c14s006_Christmas_d54ed7b9:

    # "Scarlett propone la foto y todo el mundo responde entusiasmado."
    "Scarlett propose la photo et tout le monde réagit avec enthousiasme."

# game/scripts/c14/c14.rpy:4159
translate french c14s006_Christmas_2117895e:

    # todas "¡Feliz Navidad!"
    todas "Joyeux noël!"

# game/scripts/c14/c14.rpy:4160
translate french c14s006_Christmas_71f0ba30:

    # "Con el paso del tiempo, los que salís en la foto consideraréis ese momento como el pistoletazo de salida para vuestra familia."
    "Avec le temps, ceux d'entre vous qui figurent sur la photo considéreront ce moment comme le coup de feu qui a donné le coup d'envoi à votre famille."

# game/scripts/c14/c14.rpy:4161
translate french c14s006_Christmas_1eb8fe7c:

    # "Las chicas que se unirán a la familia en los próximos meses mirarán la foto deseando haber estado allí, haber formado parte de la familia desde el primer día."
    "Les filles qui rejoindront la famille dans les prochains mois regarderont cette photo en regrettant de ne pas y avoir été, de ne pas avoir fait partie de la famille dès le premier jour."

# game/scripts/c14/c14.rpy:4162
translate french c14s006_Christmas_6299b99f:

    # "Nadie lo sabe en ese momento, pero esa foto acabará en el despacho de la primera Gobernadora de California muchos años después."
    "Personne ne le sait à l'époque, mais cette photo se retrouvera bien des années plus tard dans le bureau de la première femme gouverneure de Californie."

# game/scripts/c14/c14.rpy:4163
translate french c14s006_Christmas_0b08f94d:

    # "Y más años después todavía, estará encima del escritorio Resolute, en el despacho Oval. Pero esa es otra historia."
    "Et des années plus tard encore, elle trônera sur le bureau Resolute, dans le Bureau ovale. Mais ceci est une autre histoire."

# game/scripts/c14/c14.rpy:4165
translate french c14s006_Christmas_d79c5293:

    # "Después de la foto todo el mundo sigue con sus conversaciones. Si la conversación era animada antes, ahora lo es incluso más."
    "Après la photo, chacun reprend ses conversations. Si la conversation était animée auparavant, elle l'est encore plus maintenant."

# game/scripts/c14/c14.rpy:4167
translate french c14s006_Christmas_7dbeec67:

    # dap "Nos deberiamos ir yendo, [mc]."
    dap "Nous devrions commencer à partir, [mc]."

# game/scripts/c14/c14.rpy:4168
translate french c14s006_Christmas_1384af00:

    # mc "¿A dónde?"
    mc "Où aller ?"

# game/scripts/c14/c14.rpy:4170
translate french c14s006_Christmas_845213ff:

    # dap "No te acuerdas, ¿verdad? Tenemos que ir a la tienda de Maddie para hacer vuestros personajes de DnD."
    dap "Tu ne te souviens pas, n'est-ce pas ? Il faut aller à la boutique de Maddie pour créer tes personnages de D&D."

# game/scripts/c14/c14.rpy:4171
translate french c14s006_Christmas_feeb53b3:

    # mc "Pues no, no me acordaba para nada."
    mc "Non, je ne m'en souvenais pas du tout."

# game/scripts/c14/c14.rpy:4172
translate french c14s006_Christmas_d0ab2d02:

    # mc "Vamos a despedirnos de todo el mundo, cogemos unos gorros, y vamos para allí. Voy a ver si queda alguna botella de cava."
    mc "Disons au revoir à tout le monde, prenons nos chapeaux et allons-y. Je vais voir s'il reste des bouteilles de cava."

# game/scripts/c14/c14.rpy:4174
translate french c14s006_Christmas_b05ff61a:

    # dap "¿Cava? ¿Gorros?"
    dap "Du cava ? Des chapeaux ?"

# game/scripts/c14/c14.rpy:4175
translate french c14s006_Christmas_1c1f91b1:

    # mc "No querrás dejar a Maddie sin celebrar la Navidad, ¿verdad? *Risa*"
    mc "Tu ne voudrais pas laisser Maddie sans fêter Noël, n'est-ce pas ? *Rires*"

# game/scripts/c14/c14.rpy:4181
translate french c14s006_KissMartha_774bc444:

    # mom "¿Te importa?"
    mom "Est-ce important pour vous ?"

# game/scripts/c14/c14.rpy:4182
translate french c14s006_KissMartha_98a2015f:

    # mc "No, hace tiempo que lo estaba deseando."
    mc "Non, j'avais envie de faire ça depuis longtemps."

# game/scripts/c14/c14.rpy:4185
translate french c14s006_KissMartha_142cd168:

    # "Tal como ha pasado con [nor], el mundo vuelve a desaparecer. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "Tout comme avec [nor], le monde disparaît à nouveau. Vous sentez la voix de Mémé monter en puissance, mais vous choisissez de ne pas l'écouter."

# game/scripts/c14/c14.rpy:4187
translate french c14s006_KissMartha_7eb6706a:

    # "El mundo desaparece a vuestro alrededor. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "Le monde disparaît autour de vous. Vous sentez la voix de Mémé monter en puissance, mais vous choisissez de ne pas l'écouter."

# game/scripts/c14/c14.rpy:4189
translate french c14s006_KissMartha_fc4dea53:

    # mom "No sabes que peso de encima me he quitado."
    mom "Vous n'imaginez pas le poids qui m'a été enlevé des épaules."

# game/scripts/c14/c14.rpy:4190
translate french c14s006_KissMartha_6b85ac1c:

    # mc "Lo sé. Salir a la luz es una sensación increíble."
    mc "Je sais. Se dévoiler au grand jour est un sentiment incroyable."

# game/scripts/c14/c14.rpy:4191
translate french c14s006_KissMartha_f7ae8057:

    # mom "Ahora viene el problema. ¿Nos giramos y las escuchamos?"
    mom "Voilà le problème : devons-nous nous retourner et les écouter ?"

# game/scripts/c14/c14.rpy:4193
translate french c14s006_KissMartha_0e30a3fb:

    # mee "¿Estáis todos locos? ¿Sabéis lo que estáis haciendo?"
    mee "Vous êtes tous fous ? Savez-vous ce que vous faites ?"

# game/scripts/c14/c14.rpy:4225
translate french c14s007_MaddieDnD_4c84d95a:

    # "Llegáis a la tienda de ropa y Maddie está sola, no hay ningún cliente."
    "Vous arrivez au magasin de vêtements et Maddie est seule, il n'y a pas de clients."

# game/scripts/c14/c14.rpy:4228
translate french c14s007_MaddieDnD_061e2002:

    # mad "Buenas tardes, [dap]. [mc]."
    mad "Bonjour, [dap]. [mc]."

# game/scripts/c14/c14.rpy:4229
translate french c14s007_MaddieDnD_7b78d6ee:

    # mc "Hola, Maddie. ¿No tienes clientes hoy?"
    mc "Salut Maddie. Tu n'as pas de clients aujourd'hui ?"

# game/scripts/c14/c14.rpy:4230
translate french c14s007_MaddieDnD_ad0568c2:

    # mad "No suele haber clientes a esta hora en los días laborables. Un poco más tarde quizás."
    mad "En semaine, il n'y a généralement pas de clients à cette heure-ci. Un peu plus tard, peut-être."

# game/scripts/c14/c14.rpy:4232
translate french c14s007_MaddieDnD_f23f573a:

    # dap "Entonces genial. Podemos hacer vuestros personajes sin interrupción."
    dap "Super ! Nous pouvons travailler sur vos personnages sans interruption."

# game/scripts/c14/c14.rpy:4233
translate french c14s007_MaddieDnD_42961c19:

    # mc "Pero antes vamos a brindar, ¿no?"
    mc "Mais d'abord, trinquons, voulez-vous ?"

# game/scripts/c14/c14.rpy:4235
translate french c14s007_MaddieDnD_f5d43592:

    # mad "¿Brindar? ¿Por qué?"
    mad "Un toast ? Pourquoi ?"

# game/scripts/c14/c14.rpy:4236
translate french c14s007_MaddieDnD_4901a442:

    # mc "Hemos celebrado una fiesta navideña en la playa y te hemos traído un poco de cava... sin alcohol, que tú estás trabajando y yo tengo que conducir luego."
    mc "Nous avons fait une fête de Noël sur la plage et nous t'avons apporté du cava... sans alcool, parce que tu travailles et que je dois conduire après."

# game/scripts/c14/c14.rpy:4237
translate french c14s007_MaddieDnD_fbc35e0b:

    # mad "¿Navidad? ¿En Julio? ¿Para eso queríais los gorros de Santa ayer?"
    mad "Noël ? En juillet ? C'est pour ça que vous vouliez des bonnets de Père Noël hier ?"

# game/scripts/c14/c14.rpy:4239
translate french c14s007_MaddieDnD_3bc0af21:

    # dap "Sí, por lo visto es una costumbre italiana y Scarlett, mi amiga, leyo sobre ella. Lo propuso y lo hemos hecho. *Risa*"
    dap "Oui, apparemment c'est une coutume italienne, et mon amie Scarlett a lu un article à ce sujet. Elle me l'a proposé, et on l'a fait. *Rires*"

# game/scripts/c14/c14.rpy:4240
translate french c14s007_MaddieDnD_fe055228:

    # mc "Ha sido divertido. Un dia de playa normal y comida con los gorros. Mucho espíritu navideño sin que nadie discutiera."
    mc "C'était sympa. Une journée normale à la plage, un déjeuner avec les chapeaux. Beaucoup d'esprit de Noël et personne ne se disputait."

# game/scripts/c14/c14.rpy:4242
translate french c14s007_MaddieDnD_995e76bd:

    # dap "Y sin regalos..."
    dap "Et sans cadeaux..."

# game/scripts/c14/c14.rpy:4243
translate french c14s007_MaddieDnD_a11e50be:

    # mc "¿Quieres un regalo? Estás en una tienda de ropa... corre de mi cuenta. *Risa*"
    mc "Tu veux un cadeau ? Tu es dans un magasin de vêtements… c’est pour moi ! *Rires*"

# game/scripts/c14/c14.rpy:4245
translate french c14s007_MaddieDnD_cfb16629:

    # mad "Estáis locos, pero trae ese champagne. *Risa*"
    mad "Vous êtes tous fous, mais apportez le champagne ! *Rires*"

# game/scripts/c14/c14.rpy:4246
translate french c14s007_MaddieDnD_06553e8d:

    # mc "Es cava..."
    mc "C'est du vin mousseux..."

# game/scripts/c14/c14.rpy:4247
translate french c14s007_MaddieDnD_2dca0aea:

    # mad "Bueno, lo que sea. *Risa*"
    mad "Bon, peu importe. *Rires*"

# game/scripts/c14/c14.rpy:4249
translate french c14s007_MaddieDnD_003746c6:

    # mc "Feliz Navidad, Maddie."
    mc "Joyeux Noël, Maddie."

# game/scripts/c14/c14.rpy:4250
translate french c14s007_MaddieDnD_04b7c815:

    # dap "¡Feliz Navidad!" (multiple=2)
    dap "Joyeux noël!" (multiple=2)

# game/scripts/c14/c14.rpy:4251
translate french c14s007_MaddieDnD_0c9ede57:

    # mad "¡Feliz Navidad, chicos!" (multiple=2)
    mad "Joyeux Noël à tous !" (multiple=2)

# game/scripts/c14/c14.rpy:4253
translate french c14s007_MaddieDnD_482f9740:

    # dap "¿Podemos hacer los personajes ya? He traído la tablet para apuntar los datos. En casa, [emm] hará una ilustración de vuestros personajes y tendréis la hoja de personaje en papel."
    dap "On peut commencer à créer les personnages maintenant ? J’ai apporté la tablette pour noter les informations. À la maison, [emm] dessinera une illustration de vos personnages et vous aurez la fiche de personnage imprimée."

# game/scripts/c14/c14.rpy:4254
translate french c14s007_MaddieDnD_074455aa:

    # mc "Me vas a tener que explicar como funciona todo."
    mc "Vous allez devoir m'expliquer comment tout cela fonctionne."

# game/scripts/c14/c14.rpy:4255
translate french c14s007_MaddieDnD_1241d032:

    # dap "Ningún problema. Ya te expliqué el mundo. Ahora te enseñaré las reglas."
    dap "Pas de problème. Je t'ai déjà expliqué le monde. Maintenant, je vais t'en enseigner les règles."

# game/scripts/c14/c14.rpy:4257
translate french c14s007_MaddieDnD_1511a305:

    # mad "Deberías explicarme el mundo a mí también."
    mad "Tu devrais aussi m'expliquer le monde."

# game/scripts/c14/c14.rpy:4258
translate french c14s007_MaddieDnD_2029f14a:

    # mc "Es super original, al menos para alguien que nunca ha jugado a esto."
    mc "C'est super original, du moins pour quelqu'un qui n'a jamais joué à ce jeu auparavant."

# game/scripts/c14/c14.rpy:4266
translate french c14s007_MaddieDnD_6f7a6ac9:

    # dap "Imagínate nuestro mundo a finales del Siglo II. El Imperio Romano está en su auge. Entonces se abren una serie de portales a otros mundos y entran los diferentes seres de fantasía."
    dap "Imaginez notre monde à la fin du IIe siècle. L'Empire romain est à son apogée. Soudain, une série de portails vers d'autres mondes s'ouvrent et différentes créatures fantastiques y pénètrent."

# game/scripts/c14/c14.rpy:4267
translate french c14s007_MaddieDnD_7e12dd88:

    # dap "Elfos, orcos, enanos, dragones... Pero no solo entran ellos, sino que además sus Dioses les acompañan. Y también la magia."
    dap "Elfes, orcs, nains, dragons… Mais ils ne sont pas les seuls à entrer ; leurs dieux les accompagnent. Et la magie aussi."

# game/scripts/c14/c14.rpy:4269
translate french c14s007_MaddieDnD_9bc0bac6:

    # mad "Pobres romanos. Les va a caer la del pulpo."
    mad "Pauvres Romains ! Ils vont avoir ce qu'ils méritent."

# game/scripts/c14/c14.rpy:4270
translate french c14s007_MaddieDnD_c1d3dfb0:

    # mc "Yo pensé lo mismo, pero espera..."
    mc "Je pensais la même chose, mais attendez..."

# game/scripts/c14/c14.rpy:4272
translate french c14s007_MaddieDnD_be5d83ef:

    # dap "Esos pueblos aparecen muy al norte y muy al sur. Elfos, Enanos y Medianos en Escandinavia, los pueblos faericos en las Islas Británicas, y los Orcos y Goblins en Siberia."
    dap "Ces peuples apparaissent aussi bien au nord qu'au sud. Elfes, nains et hobbits en Scandinavie, peuples féeriques dans les îles Britanniques, orques et gobelins en Sibérie."

# game/scripts/c14/c14.rpy:4273
translate french c14s007_MaddieDnD_7e3d5ef7:

    # dap "Hay otras razas en otras partes del planeta de las que vuestros personajes no han oído hablar, con lo que no entraré en ello."
    dap "Il existe d'autres races dans d'autres parties de la planète dont vos personnages n'ont jamais entendu parler, je n'entrerai donc pas dans les détails."

# game/scripts/c14/c14.rpy:4274
translate french c14s007_MaddieDnD_333a7a0c:

    # dap "La parte que nos interesa es Europa. La partida se desarrolla en lo que hoy en día es Austria."
    dap "La partie qui nous intéresse, c'est l'Europe. Le jeu se déroule dans ce qui est aujourd'hui l'Autriche."

# game/scripts/c14/c14.rpy:4276
translate french c14s007_MaddieDnD_99bcbc7b:

    # mad "Déjame adivinar, los pueblos que llegan se pelan a los Germanos y los Alpes se convierten en la frontera."
    mad "Si je comprends bien, les peuples qui arrivent combattent les Allemands et les Alpes deviennent la frontière."

# game/scripts/c14/c14.rpy:4278
translate french c14s007_MaddieDnD_48023f27:

    # dap "Más o menos. Los Germanos desaparecen, son absorbidos, o se refugian en el Imperio, y los Enanos fundan sus reinos en la cara norte de los Alpes."
    dap "Plus ou moins. Les Allemands disparaissent, sont absorbés ou se réfugient dans l'Empire, et les Nains fondent leurs royaumes au nord des Alpes."

# game/scripts/c14/c14.rpy:4279
translate french c14s007_MaddieDnD_fda8cec8:

    # dap "Los elfos atraviesan la Galia y se establecen en lo que sería España, Portugal y el sur de Francia."
    dap "Les elfes traversent la Gaule et s'installent dans ce qui deviendra l'Espagne, le Portugal et le sud de la France."

# game/scripts/c14/c14.rpy:4280
translate french c14s007_MaddieDnD_5218815c:

    # dap "Los romanos no tienen nada que hacer sin magia en ese momento y reciben hostias en todos lados. En menos de un siglo han perdido toda Europa Occidental."
    dap "Sans magie, les Romains étaient alors impuissants et subissaient des défaites de toutes parts. En moins d'un siècle, ils avaient perdu toute l'Europe occidentale."

# game/scripts/c14/c14.rpy:4281
translate french c14s007_MaddieDnD_4d42de70:

    # dap "Pero junto con las razas invasoras también han llegado Dioses que no son adorados por ninguna raza. Esos Dioses se identifican con el Panteón Romano y empiezan a dar poderes a sus sacerdotes."
    dap "Mais avec les peuples envahisseurs arrivèrent aussi des dieux qui n'étaient vénérés par aucun peuple. Ces dieux s'identifièrent au panthéon romain et commencèrent à conférer du pouvoir à leurs prêtres."

# game/scripts/c14/c14.rpy:4283
translate french c14s007_MaddieDnD_a5917141:

    # mad "Y eso equilibra la balanza. Las legiones con clérigos curándolas pueden ser un espectáculo."
    mad "Et cela rétablit l'équilibre. Des légions soignées par des clercs, c'est un spectacle impressionnant."

# game/scripts/c14/c14.rpy:4284
translate french c14s007_MaddieDnD_aef893fb:

    # mad "¿Qué hay del Cristianismo?"
    mad "Et le christianisme ?"

# game/scripts/c14/c14.rpy:4286
translate french c14s007_MaddieDnD_84736935:

    # dap "Prácticamente desaparece, igual que el judaísmo. En un mundo con múltiples Dioses dando poderes a sus clérigos, el precepto del único Dios verdadero no se sustenta."
    dap "Elle disparaît pratiquement, tout comme le judaïsme. Dans un monde où plusieurs dieux confèrent du pouvoir à leur clergé, le précepte d'un seul vrai Dieu ne peut être maintenu."

# game/scripts/c14/c14.rpy:4287
translate french c14s007_MaddieDnD_37ed1056:

    # dap "Y ningún Dios quiere dar poderes a los sacerdotes de esos Dioses. Si lo hacen, estarían negando la existencia de otros Dioses que está muy clara."
    dap "Et aucun dieu ne souhaite conférer de pouvoir aux prêtres de ces dieux. S'ils le faisaient, ils nieraient l'existence des autres dieux, ce qui est parfaitement évident."

# game/scripts/c14/c14.rpy:4289
translate french c14s007_MaddieDnD_b5d4dd59:

    # mad "Me gusta, tiene lógica. Pero aún queda la magia de los magos... Los elfos tienen y los romanos no."
    mad "J'aime bien, c'est logique. Mais la magie des sorciers demeure… Les elfes la possèdent, les Romains non."

# game/scripts/c14/c14.rpy:4291
translate french c14s007_MaddieDnD_6c90460d:

    # dap "Los humanos no somos tontos del todo y en el primer siglo de luchas la gente aprende cómo funciona la magia. Los nuevos Dioses les ayudan a entenderlo."
    dap "Les humains ne sont pas complètement stupides, et au cours du premier siècle de luttes, ils apprennent comment fonctionne la magie. Les nouveaux dieux les aident à la comprendre."

# game/scripts/c14/c14.rpy:4293
translate french c14s007_MaddieDnD_c1eab4a3:

    # dap "Total que la paz se establece al cabo de un siglo y medio. El norte de los Alpes y de los Cárpatos son los Reinos Enanos."
    dap "La paix fut donc enfin rétablie après un siècle et demi. Les terres situées au nord des Alpes et des Carpates devinrent les royaumes nains."

# game/scripts/c14/c14.rpy:4294
translate french c14s007_MaddieDnD_a89899b3:

    # dap "España, Portugal y el sur de Francia es territorio elfo. Italia, los Balcanes, Turquía, y toda la costa del Mediterraneo menos lo que tienen los elfos es Romano."
    dap "L'Espagne, le Portugal et le sud de la France sont des territoires elfiques. L'Italie, les Balkans, la Turquie et toute la côte méditerranéenne, à l'exception des régions elfiques, sont romaines."

# game/scripts/c14/c14.rpy:4296
translate french c14s007_MaddieDnD_25678638:

    # dap "Pasan los siglos y los Enanos empiezan a expandirse echando a los Elfos de sus territorios. El Macizo Central de Francia, los Pirineos, y al final toda España."
    dap "Les siècles passent et les Nains commencent à étendre leur territoire, chassant les Elfes de leurs terres. Le Massif central de France, les Pyrénées, et finalement toute l'Espagne."

# game/scripts/c14/c14.rpy:4297
translate french c14s007_MaddieDnD_52fceac4:

    # dap "En este mundo la enemistad de Elfos y Enanos nace ahí. Los Elfos que quedan tienen que pedir asilo en el Imperio Romano, que se parece más al final de la Edad Media."
    dap "Dans ce monde, l'inimitié entre Elfes et Nains trouve son origine. Les Elfes survivants doivent chercher refuge dans l'Empire romain, qui ressemble davantage à la fin du Moyen Âge."

# game/scripts/c14/c14.rpy:4298
translate french c14s007_MaddieDnD_e61e64b8:

    # dap "Ahí empieza el equivalente del Renacimiento en este mundo. Algunos siglos antes. En lo que sería nuestro Siglo X, pero sin Cristianismo nadie le llama así."
    dap "C'est là que commence l'équivalent de la Renaissance dans ce monde. Quelques siècles plus tôt. Au cours de ce qui serait notre Xᵉ siècle, mais sans le christianisme, personne ne l'appellerait ainsi."

# game/scripts/c14/c14.rpy:4300
translate french c14s007_MaddieDnD_52dd91f2:

    # mad "Me gusta. ¿Y qué pasa en Asia? Querría hacerme un personaje que viniera de allí, si es posible."
    mad "J'aime bien. Et l'Asie ? J'aimerais créer un personnage originaire de là-bas, si possible."

# game/scripts/c14/c14.rpy:4302
translate french c14s007_MaddieDnD_2ca7a2ec:

    # dap "Ningún problema. Los Orcos le han dado de hostias a los Chinos. No hay ningún Dios que les quiera ayudar porque ponen a su Emperador al mismo nivel que los Dioses."
    dap "Pas de problème. Les Orques ont écrasé les Chinois. Aucun dieu ne veut les aider car ils ont placé leur Empereur au même niveau que les dieux."

# game/scripts/c14/c14.rpy:4303
translate french c14s007_MaddieDnD_8894c41e:

    # mc "Creo que yo eso no lo tengo que saber, ¿no? Mientras se lo explicas voy al lavabo. ¿Dónde está, Maddie?"
    mc "Je crois que je n'ai pas besoin de savoir ça, si ? Pendant que tu lui expliques, je vais aux toilettes. Où est Maddie ?"

# game/scripts/c14/c14.rpy:4305
translate french c14s007_MaddieDnD_dc7a102f:

    # mad "La puerta de la izquierda de los probadores da a un pasillo. Ahí está el lavabo."
    mad "La porte à gauche des cabines d'essayage donne sur un couloir. Le lavabo s'y trouve."

# game/scripts/c14/c14.rpy:4306
translate french c14s007_MaddieDnD_0d2bbdb7:

    # mc "OK, Ahora vuelvo."
    mc "OK, je reviens tout de suite."

# game/scripts/c14/c14.rpy:4308
translate french c14s007_MaddieDnD_be862ec1:

    # "Acabas de lavarte las manos después de hacer eso que solo puedes hacer sentado, cuando..."
    "Vous venez de vous laver les mains après avoir fait cette chose que vous ne pouvez faire qu'en position assise, quand..."

# game/scripts/c14/c14.rpy:4310
translate french c14s007_MaddieDnD_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c14/c14.rpy:4311
translate french c14s007_MaddieDnD_75924a45:

    # mad "*A través de la puerta* ¿Te encuentras bien? Ya hemos acabado mi personaje."
    mad "*À travers la porte* Ça va ? On a terminé mon personnage."

# game/scripts/c14/c14.rpy:4312
translate french c14s007_MaddieDnD_e617c3f5:

    # mc "Si, ahora salgo. Habéis sido muy rápidas."
    mc "Oui, je sors maintenant. Vous avez été très rapide."

# game/scripts/c14/c14.rpy:4313
translate french c14s007_MaddieDnD_474d4131:

    # mad "*A través de la puerta* Con la aplicación que tiene [dap] en la tablet el personaje se hace muy rápido."
    mad "*À travers la porte* Grâce à l'application que [dap] possède sur la tablette, le personnage est créé très rapidement."

# game/scripts/c14/c14.rpy:4315
translate french c14s007_MaddieDnD_f3c3dd4b:

    # mc "¿Qué te has hecho?"
    mc "Qu'est-ce que tu t'es fait ?"

# game/scripts/c14/c14.rpy:4316
translate french c14s007_MaddieDnD_d0c83c5b:

    # mad "*Risa* Tendrás que esperar a la partida para descubrirlo. Puede ser muy divertido."
    mad "*Rires* Il faudra attendre le match pour le savoir. Ça promet d'être très amusant."

# game/scripts/c14/c14.rpy:4319
translate french c14s007_MaddieDnD_fe3a1791:

    # mad "Tenía ganas de estar a solas contigo. Feliz Navidad."
    mad "J'avais hâte d'être seule avec toi. Joyeux Noël."

# game/scripts/c14/c14.rpy:4320
translate french c14s007_MaddieDnD_87b0ef7f:

    # mc "Feliz Navidad, preciosa."
    mc "Joyeux Noël, ma belle."

# game/scripts/c14/c14.rpy:4322
translate french c14s007_MaddieDnD_ab09920f:

    # mad "¿Quieres que volvamos a quedar el viernes en mi casa?"
    mad "Veux-tu qu'on se revoie vendredi chez moi ?"

# game/scripts/c14/c14.rpy:4323
translate french c14s007_MaddieDnD_f6b4a967:

    # mc "Por mí genial. ¿Otra película?"
    mc "Ça me paraît super. Un autre film ?"

# game/scripts/c14/c14.rpy:4325
translate french c14s007_MaddieDnD_ffb66364:

    # mad "Para no acabar de verla, mejor no empezarla, ¿no?"
    mad "Si vous ne comptez pas finir de le regarder, il vaut mieux ne pas le commencer, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:4326
translate french c14s007_MaddieDnD_34a4903f:

    # mc "Tienes razón. ¿Te recojo a las 6 como la semana pasada?"
    mc "Tu as raison. Je devrais venir te chercher à 18h comme la semaine dernière ?"

# game/scripts/c14/c14.rpy:4328
translate french c14s007_MaddieDnD_6bebe949:

