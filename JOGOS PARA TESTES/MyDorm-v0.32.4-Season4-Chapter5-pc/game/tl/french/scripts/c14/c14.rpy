# game/scripts/c14/c14.rpy:2044
translate french c14s003_SairaChat_f9bb63a0_3:

    # mc "Allí teníamos una relación abierta. Ninguno de los dos hizo nada fuera de la relación, pero los dos aceptamos que el otro pudiera hacerlo."
    mc "Nous avions une relation libre. Aucun de nous deux n'a rien fait en dehors de la relation, mais nous acceptions tous les deux que l'autre puisse le faire."

# game/scripts/c14/c14.rpy:2045
translate french c14s003_SairaChat_cf70031f_1:

