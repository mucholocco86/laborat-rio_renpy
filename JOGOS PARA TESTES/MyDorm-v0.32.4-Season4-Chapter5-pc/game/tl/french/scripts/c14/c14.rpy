translate french c14s005_BallGame_353b2be8:

    # sca "Parece que Kate tiene más interés en las pelotas de [mc] del que pensábamos. *Risa*"
    sca "Il semblerait que Kate s'intéresse plus aux balles [mc] qu'on ne le pensait. *Rires*"

# game/scripts/c14/c14.rpy:2658
translate french c14s005_BallGame_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c14/c14.rpy:2660
translate french c14s005_BallGame_4d6b238c:

    # "Saca Kim y volveis a hacer otra ronda."
    "Faites venir Kim et on remet ça."

# game/scripts/c14/c14.rpy:2662
