# game/scripts/c14/c14.rpy:2047
translate french c14s003_SairaChat_eaa5a76a_1:

    # sai "Sabes por qué teniamos esa relación, ¿verdad?"
    sai "Tu sais pourquoi nous avions cette relation, n'est-ce pas ?"

