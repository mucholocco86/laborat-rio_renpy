    # nor "¡Genial! Parece una buena chica."
    nor "Super ! Elle a l'air d'une fille sympa."

# game/scripts/c14/c14.rpy:3374
translate french c14s006_Christmas_55bb34ed:

    # bet "Y muy guapa..."
    bet "Et très joli..."

# game/scripts/c14/c14.rpy:3375
translate french c14s006_Christmas_299959ce:

    # mee "Sí, si la hubierais visto en el aeropuerto... Iba un poco arreglada y estaba guapísima. Lástima que sea un poco mayor para nuestro [mc]."
    mee "Oui, si vous l'aviez vue à l'aéroport… Elle était très élégante et resplendissante. Dommage qu'elle soit un peu trop âgée pour notre âge."

# game/scripts/c14/c14.rpy:3378
