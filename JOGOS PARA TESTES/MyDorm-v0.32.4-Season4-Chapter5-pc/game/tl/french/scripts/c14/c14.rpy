    mc "On retourne au cercle ? À toi de dessiner…"

# game/scripts/c14/c14.rpy:2638
translate french c14s005_BallGame_3100f0a5:

    # deb "¡Ha sido un espectáculo, chicos! El mejor reto que se me podía haber ocurrido."
    deb "C'était un spectacle, les gars ! Le meilleur défi que j'aurais pu imaginer."

# game/scripts/c14/c14.rpy:2640
translate french c14s005_BallGame_fc15a81e:

    # dap "No sabía que bailabas así, [mc]."
    dap "Je ne savais pas que tu dansais comme ça, [mc]."

# game/scripts/c14/c14.rpy:2643
translate french c14s005_BallGame_6390617f:

    # dap "{i}(Ahora me arrepiento de no haber escogido un sitio donde bailar esta noche para nuestra cita.){/b}"
    dap "{i}(Maintenant, je regrette de ne pas avoir choisi d'endroit où danser ce soir pour notre rendez-vous.){/b}"

# game/scripts/c14/c14.rpy:2645
translate french c14s005_BallGame_e5930e87:

    # sca "¡Increíble!"
    sca "Incroyable!"

