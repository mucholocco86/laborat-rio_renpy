    kim "Oui, un peu… mais je n’ai jamais dansé dans l’eau… Je ferais mieux d’aller sur le rivage…"

# game/scripts/c14/c14.rpy:2564
translate french c14s005_BallGame_fbe12c7b:

    # kim "¿Así va bien?"
    kim "Est-ce que ça vous convient ?"

# game/scripts/c14/c14.rpy:2565
translate french c14s005_BallGame_b288a4ce:

