    mc "[emm]..."

# game/scripts/c14/c14.rpy:3683
translate french c14s006_Christmas_93676ae4:

    # eri "Lo que pasa en Las Vegas se queda en Las Vegas, [emm]."
    eri "Ce qui se passe à Vegas reste à Vegas, [emm]."

# game/scripts/c14/c14.rpy:3684
translate french c14s006_Christmas_5156f3a7:

    # eil "Y no digas que ha pasado en Newport. Ya sabes lo que significa el dicho."
    eil "Et surtout, ne dites à personne que ça s'est passé à Newport. Vous connaissez la signification de l'expression."

# game/scripts/c14/c14.rpy:3686
translate french c14s006_Christmas_148ab6a3:

    # emm "Significa que no tengo que preguntar, pero seguro que hay alguna que no es tan buena guardando secretos como yo."
    emm "Cela signifie que je n'ai pas besoin de demander, mais je suis sûr qu'il y a quelqu'un qui n'est pas aussi doué que moi pour garder les secrets."

# game/scripts/c14/c14.rpy:3687
translate french c14s006_Christmas_b3b94564_2:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c14/c14.rpy:3690
translate french c14s006_Christmas_5845a21e:

    # emm "Te quiero. Mola salir a la luz. Lo tenemos que hacer con toda la familia."
    emm "Je t'aime. C'est génial d'être au grand jour. On doit le faire en famille."

# game/scripts/c14/c14.rpy:3691
translate french c14s006_Christmas_6616e794:

    # mc "Yo también te quiero."
    mc "Je t'aime aussi."

# game/scripts/c14/c14.rpy:3694
translate french c14s006_Christmas_4e174df4:

    # eri "Nos vemos ahora, mi amor."
    eri "À bientôt, mon amour."

# game/scripts/c14/c14.rpy:3695
translate french c14s006_Christmas_2a7eb574:

    # mc "Os espero en las sombrillas, mi vida."
    mc "Je t'attendrai sous les parapluies, mon amour."

# game/scripts/c14/c14.rpy:3698
translate french c14s006_Christmas_ef35767a:

    # eil "Recuerda a quien le diste el título de primera concubina. Te quiero."
    eil "Souviens-toi de celle à qui tu as donné le titre de première concubine. Je t'aime."

# game/scripts/c14/c14.rpy:3699
translate french c14s006_Christmas_2945552b:

    # mc "Yo más. Y no lo olvidaré nunca."
    mc "Moi aussi. Et je ne l'oublierai jamais."

# game/scripts/c14/c14.rpy:3701
translate french c14s006_Christmas_bde675c5:

    # emm "¿Qué es eso del título de primera concubina?"
    emm "Que signifie ce titre de première concubine ?"

# game/scripts/c14/c14.rpy:3702
translate french c14s006_Christmas_829b0f58:

    # eil "Nada, una tontería. Sabes qué es una concubina, ¿no?"
    eil "Rien, c'est absurde. Vous savez ce qu'est une concubine, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3703
translate french c14s006_Christmas_e41cb5d3:

    # eri "Y sabes que cuando un hombre tiene varias mujeres se llama harén, ¿verdad?"
    eri "Et vous savez que lorsqu'un homme a plusieurs femmes, on appelle ça un harem, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:3704
translate french c14s006_Christmas_9fdba566:

    # emm "Emmm... claro que lo sé... no soy tonta..."
    emm "Euh... bien sûr que je sais... je ne suis pas stupide..."

# game/scripts/c14/c14.rpy:3707
translate french c14s006_Christmas_6a82562e:

    # "Vuelves hacia las sombrillas y te das cuenta de que ha llegado más gente en el rato que has estado fuera."
    "Vous retournez vers les parapluies et vous vous apercevez que d'autres personnes sont arrivées pendant que vous étiez dehors."

# game/scripts/c14/c14.rpy:3715
translate french c14s006_Christmas_223514c4:

    # mc "Hola, Simone, que bien que hayáis llegado."
    mc "Bonjour Simone, c'est super que tu sois arrivée."

# game/scripts/c14/c14.rpy:3716
translate french c14s006_Christmas_c0496660:

    # sim "[mc]..."
    sim "[mc]..."

# game/scripts/c14/c14.rpy:3723
translate french c14s006_Christmas_223514c4_1:

    # mc "Hola, Simone, que bien que hayáis llegado."
    mc "Bonjour Simone, c'est super que tu sois arrivée."

# game/scripts/c14/c14.rpy:3724
translate french c14s006_Christmas_51f8c4d6:

    # sim "[mc], sí, hemos tardado más porque mi madre no encontraba el pareo. Hace siglos que no venimos a la playa."
    sim "[mc], oui, on a mis plus de temps parce que ma mère ne trouvait pas le paréo. Ça fait une éternité qu'on n'est pas allés à la plage."

# game/scripts/c14/c14.rpy:3738
translate french c14s006_Christmas_1d50a73d:

    # mc "Sam, estás preciosa de rojo."
    mc "Sam, tu es magnifique en rouge."

# game/scripts/c14/c14.rpy:3739
translate french c14s006_Christmas_31e4efe9:

    # sam "Gracias. Ha sido una buena idea. Al menos hacemos algo diferente."
    sam "Merci. C'était une bonne idée. Au moins, on fait quelque chose de différent."

# game/scripts/c14/c14.rpy:3744
translate french c14s006_Christmas_d2f17514:

    # sim "Por cierto, hay algo que quiero hacer."
    sim "Au fait, il y a quelque chose que je veux faire."

# game/scripts/c14/c14.rpy:3745
translate french c14s006_Christmas_73203639:

    # mc "Si quieres, por mí ningún problema."
    mc "Si tu veux, ça me va."

# game/scripts/c14/c14.rpy:3747
translate french c14s006_Christmas_1b069038:

    # "La seguridad que le da a Simone que su madre ya sepa lo vuestro se nota en sus labios."
    "Le soulagement que ressent Simone en sachant que sa mère est déjà au courant pour vous deux est évident sur ses lèvres."

# game/scripts/c14/c14.rpy:3749
translate french c14s006_Christmas_1ffc9153:

    # sim "*Susurrando* ¡Mielda! He cerrado los ojos y no he mirado si alguna se ha enfadado."
    sim "*Chuchotant* Zut ! J'ai fermé les yeux et je n'ai pas regardé pour voir si quelqu'un était en colère."

# game/scripts/c14/c14.rpy:3750
translate french c14s006_Christmas_c318ef06:

    # mc "*Susurrando* Más que enfadadas, sorprendidas."
    mc "*Chuchotant* Plus que de la colère, de la surprise."

# game/scripts/c14/c14.rpy:3754
translate french c14s006_Christmas_3fc0b2e9:

    # sam "*Susurrando* Creo que es mi turno. Si a alguien le da un infarto, tengo el desfibrilador en el coche."
    sam "*À voix basse* Je crois que c'est mon tour. Si quelqu'un fait une crise cardiaque, j'ai le défibrillateur dans la voiture."

# game/scripts/c14/c14.rpy:3756
translate french c14s006_Christmas_464b8318:

    # sam "*Susurrando* Voy a hacer algo. Si a alguien le da un infarto, tengo el desfibrilador en el coche."
    sam "*À voix basse* Je vais faire quelque chose. Si quelqu'un fait une crise cardiaque, j'ai le défibrillateur dans la voiture."

# game/scripts/c14/c14.rpy:3757
translate french c14s006_Christmas_f8a3399c:

    # mc "*Susurrando* Adelante. Soy tuyo para hacer lo que quieras."
    mc "*Chuchotant* Vas-y. Je suis à toi, fais de moi ce que tu veux."

# game/scripts/c14/c14.rpy:3758
translate french c14s006_Christmas_54e2e1ed:

    # sam "*Susurrando* Lo que quiera no, pero esto sí."
    sam "*Chuchotant* Pas tout ce que je veux, mais ça, oui."

# game/scripts/c14/c14.rpy:3760
translate french c14s006_Christmas_030379f5:

    # "Besar a Samantha delante de todo el mundo tiene algo especial."
    "Embrasser Samantha devant tout le monde, c'est quelque chose de spécial."

# game/scripts/c14/c14.rpy:3762
translate french c14s006_Christmas_d706fdf9:

    # sam "*Susurrando* ¿Ha pasado algo? Me da miedo mirar..."
    sam "*Chuchotant* Il s'est passé quelque chose ? J'ai peur de regarder..."

# game/scripts/c14/c14.rpy:3763
translate french c14s006_Christmas_c325831a:

    # mc "*Susurrando* Ningún infarto de momento."
    mc "*Chuchotant* Pas de crise cardiaque pour l'instant."

# game/scripts/c14/c14.rpy:3766
translate french c14s006_Christmas_70289f71:

    # mee "No sabía que lo de saludar con un beso también lo hacías fuera de la familia, [mc]."
    mee "Je ne savais pas que tu saluais aussi les gens en dehors de la famille avec un baiser, [mc]."

# game/scripts/c14/c14.rpy:3768
translate french c14s006_Christmas_ce786000:

    # nor "No, Mamá, creo que no lo estás pillando..."
    nor "Non, maman, je ne crois pas que tu comprennes..."

# game/scripts/c14/c14.rpy:3771
translate french c14s006_Christmas_b07d62c4:

    # nor "Es tan buen momento como cualquier otro, ¿no?"
    nor "C'est le bon moment, non ?"

# game/scripts/c14/c14.rpy:3772
translate french c14s006_Christmas_5ba0bd3b:

    # mc "Siempre es buen momento para lo que vas a hacer, cielo."
    mc "Il y a toujours un bon moment pour ce que tu vas faire, chérie."

# game/scripts/c14/c14.rpy:3774
translate french c14s006_Christmas_94a9ae04:

    # "El mundo desaparece a vuestro alrededor. Da lo mismo quién esté ahí, qué caras pongan, o qué piensen de vuestro beso."
    "Le monde disparaît autour de vous. Peu importe qui est là, les expressions de leurs visages ou ce qu'ils pensent de votre baiser."

# game/scripts/c14/c14.rpy:3776
translate french c14s006_Christmas_0fb52211:

    # nor "*Susurrando* Si me desheredan será culpa tuya. *Risa*"
    nor "*Chuchotant* Si je suis déshérité, ce sera de ta faute. *Rires*"

# game/scripts/c14/c14.rpy:3777
translate french c14s006_Christmas_2c6b27b4:

    # mc "*Susurrando* Pero ¿ha valido la pena?"
    mc "*Chuchotant* Mais est-ce que ça en valait la peine ?"

# game/scripts/c14/c14.rpy:3778
translate french c14s006_Christmas_1c92cd0a:

    # nor "*Susurrando* Por supuesto. Solo espero que a mi madre no le de un infarto. *Risa*"
    nor "*À voix basse* Bien sûr. J'espère juste que ma mère ne va pas faire une crise cardiaque. *Rires*"

# game/scripts/c14/c14.rpy:3779
translate french c14s006_Christmas_4b85b44c:

    # mc "*Susurrando* No te preocupes. Samantha siempre lleva un desfibrilador en el coche. *Risa*"
    mc "*À voix basse* Ne t'inquiète pas. Samantha a toujours un défibrillateur dans sa voiture. *Rires*"

# game/scripts/c14/c14.rpy:3780
translate french c14s006_Christmas_dd975be8:

    # "En ese momento os dáis cuenta de que se escuchan voces airadas a vuestro alrededor."
    "À ce moment-là, vous réalisez que vous entendez des voix en colère tout autour de vous."

# game/scripts/c14/c14.rpy:3782
translate french c14s006_Christmas_60a9057f:

    # mee "... es tu sobrino! ¿Cómo puedes hacer algo así? Además le doblas la edad..."
    mee "…c’est votre neveu ! Comment avez-vous pu faire une chose pareille ? En plus, vous avez le double de son âge…"

# game/scripts/c14/c14.rpy:3784
translate french c14s006_Christmas_f3e73158:

    # nor "Mamá, tú siempre has dicho una frase que me ha gustado. No eliges de quién te enamoras. Yo no elegí a [mc], pero me enamoré de él."
    nor "Maman, tu as toujours dit des choses que j'ai aimées. On ne choisit pas de qui on tombe amoureux. Je n'ai pas choisi [mc], mais je suis tombée amoureuse de lui."

# game/scripts/c14/c14.rpy:3786
translate french c14s006_Christmas_7b5af4d3:

    # mc "Meemaw, nos queremos. Igual que quiero a Samantha y a Simone..."
    mc "Meemaw, on s'aime. Tout comme j'aime Samantha et Simone..."

