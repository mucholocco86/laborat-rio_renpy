    # sim "No, claro. Estar desnuda sentada encima de la polla de mi novio en el sofá no es lo que parece."
    sim "Non, bien sûr que non. Être assise nue sur la bite de mon copain sur le canapé, ce n'est pas ce que ça paraît."

# game/scripts/c14/c14.rpy:228
translate french c14s001_ContinuationSam_82aaae6f:

    # sim "No, claro. Estar desnuda sentada encima de la polla de [mc] en el sofá no es lo que parece."
    sim "Non, bien sûr que non. Être assis nu sur la bite de <c4 sur le canapé, ce n'est pas ce que ça paraît."

# game/scripts/c14/c14.rpy:231
translate french c14s001_ContinuationSam_86bdc33a:

    # sim "Si hasta te has depilado..."
    sim "Vous vous êtes même épilée..."

# game/scripts/c14/c14.rpy:236
translate french c14s001_ContinuationSam_94976363:

    # sam "Simone, puedo explicarlo..."
    sam "Simone, je peux expliquer..."

# game/scripts/c14/c14.rpy:238
translate french c14s001_ContinuationSam_00b0e3ae:

    # sim "Por supuesto, que puedes. [mc] ha venido a tomar té y pastitas, os habéis tirado el té por encima y os habéis tenido que desnudar, ¿verdad?"
    sim "Bien sûr que tu peux. [mc] est venu prendre le thé et des biscuits, vous avez renversé du thé l'un sur l'autre et vous avez dû vous déshabiller, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:239
translate french c14s001_ContinuationSam_e22da03f:

    # sim "Estoy en shock... tu sabías lo que [mc] significaba para mí..."
    sim "Je suis sous le choc... tu savais ce que [mc] représentait pour moi..."

# game/scripts/c14/c14.rpy:241
translate french c14s001_ContinuationSam_201f5dd5:

    # mc "Simone, ya te dije que..."
    mc "Simone, je te l'ai déjà dit..."

# game/scripts/c14/c14.rpy:243
translate french c14s001_ContinuationSam_5f487485:

    # sim "¿Y tú? ¿Tú lo sabías...?"
    sim "Et vous ? Saviez-vous que... ?"

# game/scripts/c14/c14.rpy:244
translate french c14s001_ContinuationSam_7d2c4615:

    # sim "Claro que lo sabías, que tonterías estoy diciendo... tienes que pasártelo de puta madre follándonos a las dos..."
    sim "Bien sûr que tu le savais, à quoi je raconte des bêtises… tu dois bien t’amuser à nous baiser tous les deux…"

# game/scripts/c14/c14.rpy:245
translate french c14s001_ContinuationSam_48378cc2:

    # mc "Simone, te dije que podía haber otras chicas..."
    mc "Simone, je t'avais dit qu'il pouvait y avoir d'autres filles..."

# game/scripts/c14/c14.rpy:247
translate french c14s001_ContinuationSam_7f9c9723:

    # sim "Sí, pero no me dijiste que una de ellas era mi madre..."
    sim "Oui, mais vous ne m'avez pas dit que l'une d'elles était ma mère..."

# game/scripts/c14/c14.rpy:252
translate french c14s001_ContinuationSam_a2c28566:

    # sam "Espera... espera... ¿Tu novio? ¿Estáis saliendo?"
    sam "Attends… attends… Ton copain ? Vous sortez ensemble ?"

# game/scripts/c14/c14.rpy:254
translate french c14s001_ContinuationSam_e0235614:

    # sim "Sí, Mamá, o lo estábamos hasta hace dos minutos..."
    sim "Oui, maman, enfin c'est ce que nous étions jusqu'à il y a deux minutes..."

# game/scripts/c14/c14.rpy:256
translate french c14s001_ContinuationSam_b52a0e3d:

    # sam "¿Y qué es eso de que te estás follando a las dos?"
    sam "Et qu'est-ce que c'est que cette histoire de coucher avec les deux ?"

# game/scripts/c14/c14.rpy:261
translate french c14s001_ContinuationSam_c7f51d82:

    # sam "{b}¿Te estás follando a mi niña?{/b}"
    sam "{b}Tu couches avec ma copine ?{/b}"

# game/scripts/c14/c14.rpy:262
translate french c14s001_ContinuationSam_84c97c36:

    # mc "Sam..."
    mc "Sam..."

# game/scripts/c14/c14.rpy:267
translate french c14s001_ContinuationSam_d54af1d1:

    # sam "{b}¡Fuera de mi casa!{/b}"
    sam "{b}Sortez de chez moi !{/b}"

# game/scripts/c14/c14.rpy:268
translate french c14s001_ContinuationSam_8c90346f:

    # mc "Sam, déjame hablar..."
    mc "Sam, laisse-moi parler..."

# game/scripts/c14/c14.rpy:273
translate french c14s001_ContinuationSam_189750c7:

    # sam "¡No quiero oírte! Nos has engañado a las dos, a la una con la otra... no quiero volver a verte aquí..."
    sam "Je ne veux plus rien entendre de toi ! Tu nous as trompés tous les deux, l'un avec l'autre… Je ne veux plus jamais te revoir ici…"

# game/scripts/c14/c14.rpy:274
translate french c14s001_ContinuationSam_c47ae3eb:

    # sam "¡Y además te has aprovechado de mi niña!"
    sam "Et vous avez profité de ma petite fille !"

# game/scripts/c14/c14.rpy:275
translate french c14s001_ContinuationSam_7f896c98:

    # mc "Sam, no os he engañado a ninguna..."
    mc "Sam, je ne vous ai trompés..."

# game/scripts/c14/c14.rpy:280
translate french c14s001_ContinuationSam_e7d3f9ba:

    # sam "{b}¡Fuera... de... mi... puta... casa!{/b}"
    sam "{b}Sors... de... ma... putain... maison !{/b}"

# game/scripts/c14/c14.rpy:282
translate french c14s001_ContinuationSam_4d72310e:

    # sim "No. También es mi casa y quiero que se quede."
    sim "Non. C'est aussi ma maison, et je veux qu'elle reste."

# game/scripts/c14/c14.rpy:287
translate french c14s001_ContinuationSam_c32b4214:

    # sam "No sabes lo que estás diciendo, Simone. ¡Nos ha engañado a las dos! ¡Lo quiero fuera de aquí! {b}¡Ya!{/b}"
    sam "Tu ne sais pas ce que tu dis, Simone. Il nous a trompés tous les deux ! Je veux qu'il parte ! Immédiatement !"

# game/scripts/c14/c14.rpy:289
translate french c14s001_ContinuationSam_9976b665:

    # sim "A mí no. A mí me dijo que podía ser que saliera con otras mujeres."
    sim "Pas moi. Il m'a dit qu'il voyait peut-être d'autres femmes."

# game/scripts/c14/c14.rpy:294
translate french c14s001_ContinuationSam_e3b3cfb3:

    # sam "¿Y tú lo aceptaste?"
    sam "Et vous l'avez accepté ?"

# game/scripts/c14/c14.rpy:296
translate french c14s001_ContinuationSam_e6e21b58:

    # sim "¡Sí, lo acepté! Y hasta que no hablemos de lo que acabo de ver, sigue siendo mi novio. No tienes derecho a echarlo."
    sim "Oui, j'ai accepté ! Et tant qu'on n'aura pas parlé de ce que je viens de voir, il est toujours mon copain. Tu n'as pas le droit de le mettre à la porte."

# game/scripts/c14/c14.rpy:301
translate french c14s001_ContinuationSam_3c8fc4f0:

    # sam "Pero..."
    sam "Mais..."

# game/scripts/c14/c14.rpy:303
translate french c14s001_ContinuationSam_d02a3030:

    # sim "Mamá, siempre me has dicho que si tenía novio podría traerlo a casa sin problemas. Pues aquí está, aunque lo hayas traído tú para follártelo. No voy a dejar que lo eches."
    sim "Maman, tu m'as toujours dit que si j'avais un petit ami, je pouvais le ramener à la maison sans problème. Eh bien, le voilà, même si tu l'as ramené pour coucher avec lui. Je ne te laisserai pas le mettre à la porte."

# game/scripts/c14/c14.rpy:308
translate french c14s001_ContinuationSam_ddfb43c6:

    # sam "Pero... a mí sí que me ha engañado..."
    sam "Mais... il m'a trompé..."

# game/scripts/c14/c14.rpy:309
translate french c14s001_ContinuationSam_2d56d47b:

    # mc "No, Samantha. Tú me dijiste que habías hablado con [mar] y que no te importaba compartir..."
    mc "Non, Samantha. Tu m'as dit avoir parlé avec [mar] et que cela ne te dérangeait pas de partager..."

# game/scripts/c14/c14.rpy:311
translate french c14s001_ContinuationSam_50ed2fc1:

    # sim "¿Qué? ¿Estás saliendo también con tu madre?"
    sim "Quoi ? Tu sors aussi avec ta mère ?"

# game/scripts/c14/c14.rpy:316
translate french c14s001_ContinuationSam_7dccb779:

    # sam "No, fue una conversación hipotética. En aquel momento yo no pensaba que acabaría así... aquí... delante de mi hija..."
    sam "Non, c'était une conversation hypothétique. À ce moment-là, je n'imaginais pas que cela se terminerait ainsi… ici… devant ma fille…"

# game/scripts/c14/c14.rpy:318
translate french c14s001_ContinuationSam_98f66496:

    # sim "¡Ufff! Me había asustado..."
    sim "Ouf ! Ça m'a fait peur..."

# game/scripts/c14/c14.rpy:319
translate french c14s001_ContinuationSam_4bc9d2f5:

    # mc "Sam, no te dije que estaba con otras mujeres por que tú me dijiste eso... lo tomé como que no te importaba..."
    mc "Sam, je ne t'ai pas dit que j'étais avec d'autres femmes parce que tu me l'as dit... J'ai cru que tu t'en fichais..."

# game/scripts/c14/c14.rpy:324
translate french c14s001_ContinuationSam_8788c55c:

    # sam "¿Cómo no me va a importar? ¿Cómo crees que me puedo sentir sabiendo que sales con mi hija?"
    sam "Comment pourrais-je rester indifférente ? Comment crois-tu que je suis censée me sentir en sachant que tu sors avec ma fille ?"

# game/scripts/c14/c14.rpy:325
translate french c14s001_ContinuationSam_b4b10eb3:

    # sam "Hace un momento decías que no las preferías jóvenes..."
    sam "Il y a un instant, vous avez dit que vous ne les préfériez pas jeunes..."

# game/scripts/c14/c14.rpy:326
translate french c14s001_ContinuationSam_7281e1d0:

    # mc "Y no las prefiero jóvenes, Sam. ¿Todo esto es por el tema de la edad otra vez?"
    mc "Et je ne les préfère pas jeunes, Sam. Est-ce que tout est encore une question d'âge ?"

# game/scripts/c14/c14.rpy:327
translate french c14s001_ContinuationSam_1fccad41:

    # mc "Me gusta Simone y estoy con ella, no por la edad que tiene, sino por quién es. Por cómo es. Y tú me gustas por cómo eres. Me da lo mismo la edad que tengas. Sólo parece importarte a ti."
    mc "J'aime Simone et je suis avec elle, non pas à cause de son âge, mais pour ce qu'elle est. Pour sa personnalité. Et je t'aime pour ce que tu es. Ton âge m'importe peu. Il n'y a que toi qui sembles y accorder de l'importance."

# game/scripts/c14/c14.rpy:330
translate french c14s001_ContinuationSam_8de1d9b7:

    # sim "*Risa*"
    sim "*Rire*"

# game/scripts/c14/c14.rpy:335
translate french c14s001_ContinuationSam_73e751ed:

    # mc "¿Qué pasa?" (multiple=2)
    mc "Ce qui se passe?" (multiple=2)

# game/scripts/c14/c14.rpy:336
translate french c14s001_ContinuationSam_99d3d593:

    # sam "¿De qué te ríes?" (multiple=2)
    sam "De quoi riez-vous ?" (multiple=2)

# game/scripts/c14/c14.rpy:338
translate french c14s001_ContinuationSam_87930fcc:

    # sim "Me acabo de dar cuenta de lo ridículo de la situación..."
    sim "Je viens de réaliser à quel point la situation est absurde..."

# game/scripts/c14/c14.rpy:344
translate french c14s001_ContinuationSam_6278532a:

    # mc "No te entiendo" (multiple=2)
    mc "Je ne te comprends pas" (multiple=2)

# game/scripts/c14/c14.rpy:345
translate french c14s001_ContinuationSam_a2b96805:

    # sam "¿Qué te parece ridículo de todo esto?" (multiple=2)
    sam "Qu'est-ce qui vous paraît ridicule dans tout cela ?" (multiple=2)

# game/scripts/c14/c14.rpy:347
translate french c14s001_ContinuationSam_26fc2ba9:

    # sim "Primero que los dos estáis en pelotas en medio del salón."
    sim "Tout d'abord, vous êtes tous les deux nus au milieu du salon."

# game/scripts/c14/c14.rpy:352
translate french c14s001_ContinuationSam_cd99faad:

    # sam "¡Oops! ¡[mc], tápate!"
    sam "Oups ! Couvrez-vous !"

# game/scripts/c14/c14.rpy:353
translate french c14s001_ContinuationSam_60170bca:

    # mc "No es nada que no hayáis visto antes las dos, no quiero interrumpir a Simone antes de saber el resto de los puntos por lo que la situación le parece ridícula."
    mc "Ce n'est rien que vous n'ayez déjà vu tous les deux, je ne veux pas interrompre Simone avant qu'elle ne connaisse le reste des points, c'est pourquoi la situation lui paraît ridicule."

# game/scripts/c14/c14.rpy:355
translate french c14s001_ContinuationSam_b11b492d:

    # sim "Os dais cuenta de que soy yo quien os ha pillado, ¿verdad?"
    sim "Tu te rends compte que c'est moi qui t'ai attrapé, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:360
translate french c14s001_ContinuationSam_db5df92a:

    # sam "Sí, claro, pero no veo qué tiene que ver con que sea ridículo."
    sam "Oui, bien sûr, mais je ne vois pas le rapport avec le fait que ce soit ridicule."

# game/scripts/c14/c14.rpy:361
translate french c14s001_ContinuationSam_3ba08259:

    # mc "Yo creo que sé por dónde va."
    mc "Je crois savoir où cela va mener."

# game/scripts/c14/c14.rpy:363
translate french c14s001_ContinuationSam_2075b658:

    # sim "Os he pillado yo y me he enfadado, pero parece que la más ofendida seas tú, Mamá. Y estás aquí en pelotas, gesticulando y enfadada..."
    sim "Je t'ai surprise et je suis en colère, mais il semblerait que ce soit toi qui sois la plus offensée, maman. Et te voilà, complètement nue, gesticulant frénétiquement et furieuse…"

# game/scripts/c14/c14.rpy:364
translate french c14s001_ContinuationSam_45019296:

    # sim "Es gracioso. Quieres echar de {b}nuestra{/b} casa a {b}nuestro{/b} novio, sin tener en cuenta mi opinión. Tan solo porque las dos salimos con él."
    sim "C'est absurde. Tu veux mettre notre copain à la porte sans même me demander mon avis, juste parce qu'on sort toutes les deux avec lui."

# game/scripts/c14/c14.rpy:369
translate french c14s001_ContinuationSam_fa3dff8a:

    # sam "Y porque nos ha engañado..."
    sam "Et parce qu'il nous a trompés..."

# game/scripts/c14/c14.rpy:371
translate french c14s001_ContinuationSam_47ccd05f:

    # sim "A mí no, Mamá. Me lo dijo antes de aceptar salir conmigo, o de que yo aceptara salir con él. Y si lo he entendido bien, tú también le diste autorización."
    sim "Non, maman. Il me l'a dit avant d'accepter de sortir avec moi, ou avant que j'accepte de sortir avec lui. Et si j'ai bien compris, tu lui as donné la permission aussi."

# game/scripts/c14/c14.rpy:376
translate french c14s001_ContinuationSam_698d45b5:

    # sam "Pero era en un caso hipotético..."
    sam "Mais c'était dans un cas hypothétique..."

# game/scripts/c14/c14.rpy:378
translate french c14s001_ContinuationSam_81f0c9d0:

    # sim "Y la hipótesis se convirtió en realidad. ¿Estarías igual si en vez de conmigo se estuviera acostando con [mar]? Dejemos de lado lo raro que sería. ¿Te enfadaría igual?"
    sim "Et l'hypothèse est devenue réalité. Réagirais-tu de la même façon si, au lieu de moi, il couchait avec [mar] ? Laissons de côté le côté bizarre de la chose. Serais-tu tout aussi en colère ?"

# game/scripts/c14/c14.rpy:383
translate french c14s001_ContinuationSam_1df0ebb0:

    # sam "Supongo que no..."
    sam "Je suppose que non..."

# game/scripts/c14/c14.rpy:385
translate french c14s001_ContinuationSam_66b3d6ee:

    # sim "Y si hubiera vuelto con Eileen tampoco, ¿verdad?"
    sim "Et si j'étais retournée auprès d'Eileen, cela ne se serait pas produit non plus, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:390
translate french c14s001_ContinuationSam_b7361115:

    # sam "No sé... quizás un poco más..."
    sam "Je ne sais pas... peut-être un peu plus..."

# game/scripts/c14/c14.rpy:392
translate french c14s001_ContinuationSam_e6f009fc:

    # sim "Entonces si saliera con [mar] no te enfadarías, con Eileen un poco, y porque sale conmigo te pones hecha una furia."
    sim "Donc si je sortais avec [mar], tu ne te fâcherais pas, un peu avec Eileen, et parce qu'elle sort avec moi, tu es furieux."

# game/scripts/c14/c14.rpy:393
translate french c14s001_ContinuationSam_c34e9336:

    # sim "¿Puedes ver el patrón? Cuanto más joven sea la chica más te enfadas. Creo que el problema está en que te sientes amenazada por chicas más jóvenes."
    sim "Vous voyez le problème ? Plus la fille est jeune, plus vous vous énervez. Je crois que vous vous sentez menacé par les jeunes filles."

# game/scripts/c14/c14.rpy:398
translate french c14s001_ContinuationSam_0a979f5e:

    # sam "{b}¡No es eso!{/b} Con [mar] lo habíamos hablado, aunque solo fuera en broma. Si volviera con Eileen... todos lo esperábamos..."
    sam "{b}Ce n'est pas ça !{/b} J'en avais parlé avec [mar], même si c'était pour rire. S'il se remettait avec Eileen… on s'y attendait tous…"

# game/scripts/c14/c14.rpy:399
translate french c14s001_ContinuationSam_9a83ba9b:

    # sam "¿Pero tú? ¡Tú eres mi niña! No puedo dejar que nadie se aproveche de ti..."
    sam "Mais toi ? Tu es ma petite fille ! Je ne peux laisser personne profiter de toi..."

# game/scripts/c14/c14.rpy:401
translate french c14s001_ContinuationSam_9d1e9d37:

    # sim "Nadie se está aprovechando, Mamá. Yo estuve de acuerdo. No me imaginaba que también estuviera contigo, pero estuve de acuerdo."
    sim "Personne n'en profite, maman. J'étais d'accord. Je n'imaginais pas être d'accord avec toi aussi, mais j'étais d'accord."

# game/scripts/c14/c14.rpy:402
translate french c14s001_ContinuationSam_ab0868b9:

    # sim "Y posiblemente siga estándolo una vez acabemos esta conversación y tenga un momento para hablar con mi novio."
    sim "Et ce sera probablement toujours le cas une fois que nous aurons terminé cette conversation et que j'aurai eu un moment pour parler à mon copain."

# game/scripts/c14/c14.rpy:407
translate french c14s001_ContinuationSam_b6699f85:

    # sam "{b}Nuestro{/b}."
    sam "{b}Notre{/b}."

# game/scripts/c14/c14.rpy:409
translate french c14s001_ContinuationSam_7b66c460:

    # sim "Hace un momento lo querías echar de casa. ¿Ahora vuelve a ser nuestro novio?"
    sim "Tu voulais juste le mettre à la porte. Et maintenant, c'est de nouveau notre petit ami ?"

# game/scripts/c14/c14.rpy:414
translate french c14s001_ContinuationSam_cd9adbf4:

    # sam "Tu novio. Mi hombre. Yo también voy a tener que hablar con él, pero aún no he roto con él... ni le he roto la cara a hostias."
    sam "Ton copain. Mon homme. Je vais devoir lui parler aussi, mais je ne l'ai pas encore quitté... ni frappé au visage."

# game/scripts/c14/c14.rpy:415
translate french c14s001_ContinuationSam_4b63743d:

    # sam "Supongo que tiene mucho que ver con que... haya mantenido la boca cerrada este rato..."
    sam "Je suppose que c'est lié au fait que... je n'ai rien dit pendant tout ce temps..."

# game/scripts/c14/c14.rpy:417
translate french c14s001_ContinuationSam_1da127aa:

    # sim "Es que es un tipo listo... sale con las dos..."
    sim "C'est un type malin... il sort avec les deux..."

# game/scripts/c14/c14.rpy:422
translate french c14s001_ContinuationSam_1f1deb53:

    # sam "Sí... "
    sam "Ouais..."

# game/scripts/c14/c14.rpy:424
translate french c14s001_ContinuationSam_05f53ef6:

    # sim "Y ahora que está arreglado..."
    sim "Et maintenant que c'est réparé..."

# game/scripts/c14/c14.rpy:429
translate french c14s001_ContinuationSam_de214aa7:

    # sam "¡No hay nada arreglado! ¡Tú y yo tenemos que hablar de muchas cosas!"
    sam "Rien n'est encore décidé ! Nous avons beaucoup de choses à nous dire !"

# game/scripts/c14/c14.rpy:431
translate french c14s001_ContinuationSam_1e0487b3:

    # sim "Sí, pero preferiría no hacerlo delante de [mc]. ¿Por qué no vas a ponerte algo mientras yo hablo con él un momento?"
    sim "Oui, mais je préférerais éviter de le faire devant [mc]. Pourquoi n'irais-tu pas mettre quelque chose pendant que je lui parle un instant ?"

# game/scripts/c14/c14.rpy:436
translate french c14s001_ContinuationSam_30459373:

    # sim "Ver esto botando cada vez que te alteras me está desconcentrando."
    sim "Voir ça rebondir à chaque fois que tu t'énerves me distrait."

# game/scripts/c14/c14.rpy:441
translate french c14s001_ContinuationSam_1af4d505:

    # sam "¡Simone!"
    sam "Simone !"

# game/scripts/c14/c14.rpy:442
translate french c14s001_ContinuationSam_fbad18a5:

    # mc "¿Puedo ir yo también a ponerme algo?"
    mc "Puis-je y aller aussi et faire quelque chose ?"

# game/scripts/c14/c14.rpy:444
translate french c14s001_ContinuationSam_58a05077:

    # sim "No, tu quédate aquí."
    sim "Non, vous restez ici."

# game/scripts/c14/c14.rpy:449
translate french c14s001_ContinuationSam_8f26ab3a:

    # sam "Cuidado con lo que hacéis. No me gustaría pillaros haciendo algo inapropiado... *Risa*"
    sam "Fais attention à ce que tu fais. Je ne voudrais pas te surprendre à faire quelque chose d'inapproprié... *Rires*"

# game/scripts/c14/c14.rpy:451
translate french c14s001_ContinuationSam_79a4ad17:

    # mc "Tú dirás, pero quiero que quede claro que no te he engañado en ningún momento."
    mc "Vous pouvez dire ce que vous voulez, mais je tiens à préciser que je ne vous ai jamais trompé."

# game/scripts/c14/c14.rpy:452
translate french c14s001_ContinuationSam_472edd16:

    # sim "Lo sé."
    sim "Je sais."

# game/scripts/c14/c14.rpy:454
translate french c14s001_ContinuationSam_be678842:

    # sim "¿Cuánto tiempo llevas con mi madre?"
    sim "Depuis combien de temps es-tu avec ma mère ?"

# game/scripts/c14/c14.rpy:455
translate french c14s001_ContinuationSam_554ee6dc:

    # mc "Desde el día que fui a la comisaría."
    mc "Depuis le jour où je suis allé au poste de police."

# game/scripts/c14/c14.rpy:457
translate french c14s001_ContinuationSam_cfcfc58d:

    # sim "Es decir, antes de salir conmigo... mmmm..."
    sim "Je veux dire, avant de sortir avec moi... mmm..."

# game/scripts/c14/c14.rpy:458
translate french c14s001_ContinuationSam_61c1538a:

    # sim "¿Hay más chicas? ¿Cuántas?"
    sim "Y a-t-il d'autres filles ? Combien ?"

# game/scripts/c14/c14.rpy:460
translate french c14s001_ContinuationSam_e517e5ab:

    # mc "Sí, las hay."
    mc "Oui, il y en a."

# game/scripts/c14/c14.rpy:462
translate french c14s001_ContinuationSam_aa235da0:

    # sim "¿Cuántas?"
    sim "Combien?"

# game/scripts/c14/c14.rpy:463
translate french c14s001_ContinuationSam_a13d45a6:

    # mc "No sé si debería decirlo..."
    mc "Je ne sais pas si je devrais dire ça..."

# game/scripts/c14/c14.rpy:465
translate french c14s001_ContinuationSam_5380c9eb:

    # sim "Te acabo de pillar con mi madre. Dame algo de información, la voy a necesitar cuando hable con ella."
    sim "Je vous ai surpris avec ma mère. Donnez-moi quelques informations ; j’en aurai besoin pour lui parler."

# game/scripts/c14/c14.rpy:466
translate french c14s001_ContinuationSam_598822b0:

    # sim "No te estoy preguntando quienes son, tan solo cuantas aparte de mi madre y de mí."
    sim "Je ne demande pas qui ils sont, juste combien ils sont en plus de ma mère et moi."

# game/scripts/c14/c14.rpy:468
translate french c14s001_ContinuationSam_0f22c1f0:

    # mc "OK, estoy con otra chica aparte de vosotras."
    mc "OK, je suis avec une autre fille que toi."

# game/scripts/c14/c14.rpy:470
translate french c14s001_ContinuationSam_247713a3:

    # sim "¿Sólo una? No me parece una mala cifra. Casi esperaba 10 u 11."
    sim "Un seul ? Ça me paraît un bon nombre. Je m'attendais presque à 10 ou 11."

# game/scripts/c14/c14.rpy:473
translate french c14s001_ContinuationSam_01e1b9cb:

    # mc "OK, estoy con [Aux] chicas aparte de vosotras."
    mc "OK, je suis avec les filles [Aux] autres que toi."

# game/scripts/c14/c14.rpy:475
translate french c14s001_ContinuationSam_9620be00:

    # sim "¿[Aux] más? Eres insaciable..."
    sim "Encore ? Vous êtes insatiable…"

# game/scripts/c14/c14.rpy:477
translate french c14s001_ContinuationSam_1ac19d67:

    # mc "No, no hay ninguna más aparte de vosotras."
    mc "Non, il n'y en a pas d'autres que vous."

# game/scripts/c14/c14.rpy:479
translate french c14s001_ContinuationSam_a98f2837:

    # sim "¿Va a haber más?"
    sim "Y en aura-t-il d'autres ?"

# game/scripts/c14/c14.rpy:480
translate french c14s001_ContinuationSam_8183cb53:

    # mc "Te dije cuál era la situación y lo aceptaste. Tu madre lo aceptó implícitamente al decir que no le importaría compartirme."
    mc "Je t'ai expliqué la situation et tu l'as acceptée. Ta mère l'a implicitement acceptée en disant que ça ne la dérangeait pas de me partager."

# game/scripts/c14/c14.rpy:481
translate french c14s001_ContinuationSam_d2b4e4bb:

    # mc "No puedo saber si va a haber más, Simone. No puedo saber si al salir al rellano voy a encontrar otra chica que me guste tanto como vosotras."
    mc "Je ne peux pas savoir s'il y en aura d'autres, Simone. Je ne peux pas savoir si, en arrivant sur le palier, je trouverai une autre fille qui me plaira autant qu'à vous deux."

# game/scripts/c14/c14.rpy:482
translate french c14s001_ContinuationSam_9c300746:

    # mc "¿Qué querrías que hiciera en ese caso?"
    mc "Que voulez-vous que je fasse dans ce cas ?"

# game/scripts/c14/c14.rpy:484
translate french c14s001_ContinuationSam_fcdb244f:

    # sim "Ignorarla..."
    sim "Ignore-la..."

# game/scripts/c14/c14.rpy:485
translate french c14s001_ContinuationSam_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c14/c14.rpy:487
translate french c14s001_ContinuationSam_b36ec734:

    # sim "Pero entonces también hubieras tenido que ignorarme a mí porque ya estabas con mi madre."
    sim "Mais alors tu aurais dû m'ignorer aussi, puisque tu étais déjà avec ma mère."

# game/scripts/c14/c14.rpy:488
translate french c14s001_ContinuationSam_1c64ea5b:

    # mc "Exacto. Nuestra relación es diferente de las habituales, no es mejor ni peor."
    mc "Exactement. Notre relation est différente des relations habituelles ; elle n'est ni meilleure ni pire."

# game/scripts/c14/c14.rpy:490
translate french c14s001_ContinuationSam_29f0f833:

    # mc "Mientras nos haga felices a los tres y a quien sea que esté también en esta relación, la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Tant que cela nous rend tous les trois heureux, ainsi que toutes les autres personnes impliquées dans cette relation, nous pouvons continuer. Je ne veux surtout pas que qui que ce soit souffre."

# game/scripts/c14/c14.rpy:492
translate french c14s001_ContinuationSam_7260d9ce:

    # mc "Mientras nos haga felices a los tres la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Tant que cela nous rend tous les trois heureux, nous pouvons continuer. Je ne veux surtout pas que quelqu'un soit blessé."

# game/scripts/c14/c14.rpy:494
translate french c14s001_ContinuationSam_3f90d1fe:

    # sim "Lo dices como si los tres estuviéramos en una relación poliamorosa. Espero que no quieras hacer un trío conmigo y con mi madre."
    sim "Tu parles comme si nous étions tous les trois dans une relation polyamoureuse. J'espère que tu ne souhaites pas faire un plan à trois avec ma mère et moi."

# game/scripts/c14/c14.rpy:495
translate french c14s001_ContinuationSam_15410ddb:

    # mc "Si pensara que eso os iba a hacer felices, os lo propondría. Pero creo que hay líneas rojas que no deberíamos cruzar, creo que solo con proponerlo te incomodaría a ti."
    mc "Si je pensais que cela te ferait plaisir, je te le suggérerais. Mais je crois qu'il y a des limites à ne pas franchir ; je pense que le simple fait de le suggérer te mettrait mal à l'aise."

# game/scripts/c14/c14.rpy:497
translate french c14s001_ContinuationSam_3ada1db0:

    # sim "¿A mí? ¿No a mi madre?"
    sim "Moi ? Pas ma mère ?"

# game/scripts/c14/c14.rpy:498
translate french c14s001_ContinuationSam_5faaf4a7:

    # mc "Creo que tu madre podría estar más abierta a la idea de un trío que tú, aunque no si tú estás involucrada. Pero con la persona correcta..."
    mc "Je pense que ta mère serait peut-être plus ouverte à l'idée d'un plan à trois que toi, mais pas si tu y participes. Avec la bonne personne…"

# game/scripts/c14/c14.rpy:500
translate french c14s001_ContinuationSam_87ec4d53:

    # sim "{b}¿Qué?{/b} ¿Mi madre en un trío? Estás loco..."
    sim "{b}Quoi ?{/b}Ma mère dans un plan à trois ? Tu es fou…"

# game/scripts/c14/c14.rpy:502
translate french c14s001_ContinuationSam_e00638a7:

    # sim "¿Y de dónde has sacado la idea de que yo no estaría dispuesta? Con la persona adecuada..."
    sim "Et d'où vous vient l'idée que je refuserais ? Avec la bonne personne…"

# game/scripts/c14/c14.rpy:503
translate french c14s001_ContinuationSam_1c8e0ffd:

    # mc "¿Y quién sería esa persona adecuada, Simone? Y no digas ninguna actriz famosa a quien no conocemos."
    mc "Et qui serait cette personne idéale, Simone ? Et surtout, ne citez pas une actrice célèbre que nous ne connaissons pas."

# game/scripts/c14/c14.rpy:505
translate french c14s001_ContinuationSam_24dcce7f:

    # sim "{i}(¡Mielda! ¡Piensa, Simone! Alguien con quién él nunca tendría sexo...){/i}"
    sim "{i}(Mince ! Réfléchis, Simone ! Quelqu'un avec qui il ne coucherait jamais...){/i}"

# game/scripts/c14/c14.rpy:507
translate french c14s001_ContinuationSam_b4d2c42c:

    # sim "[mar], por ejemplo. O [nor]. [emm], [dap], o [eri]. Incluso con tu abuela también serviría..."
    sim "Par exemple, [mar]. Ou [nor]. [emm], [dap], ou [eri]. Même votre grand-mère ferait l'affaire..."

# game/scripts/c14/c14.rpy:508
translate french c14s001_ContinuationSam_574a2760:

    # sim "{i}(¡Uff! Resuelto...){/i}"
    sim "{i}(Ouf ! Résolu...){/i}"

# game/scripts/c14/c14.rpy:509
translate french c14s001_ContinuationSam_674b981e:

    # mc "Veo que tienes un fetiche con mi familia. *Risa*"
    mc "Je vois que ma famille vous plaît. *Rires*"

# game/scripts/c14/c14.rpy:511
translate french c14s001_ContinuationSam_c241f862:

    # sim "{b}¿Qué? ¡No!{/b} No es eso..."
    sim "{b}Quoi ? Non !{/b} Ce n'est pas ça…"

# game/scripts/c14/c14.rpy:512
translate french c14s001_ContinuationSam_241751b0:

    # mc "Bueno, si surge la oportunidad les preguntaré si están interesadas en un trío contigo. *Risa*"
    mc "Eh bien, si l'occasion se présente, je leur demanderai si elles sont intéressées par un plan à trois avec toi. *Rires*"

# game/scripts/c14/c14.rpy:515
translate french c14s001_ContinuationSam_659165b0:

    # sim "{b}¿Qué?{/b} ¿Estás con alguna de ellas? ¿Con todas?"
    sim "{b}Quoi ?{/b} Es-tu avec l’un d’eux ? Avec tous ?"

# game/scripts/c14/c14.rpy:517
translate french c14s001_ContinuationSam_3d3489af:

    # sim "{b}¿Qué?{/b} ¿Estás con alguna de ellas?"
    sim "{b}Quoi ?{/b} Es-tu avec l'un d'eux ?"

# game/scripts/c14/c14.rpy:518
translate french c14s001_ContinuationSam_6ada8b21:

    # mc "Ya sabes la respuesta a eso. Tan solo he dicho que les preguntaré si surge la oportunidad."
    mc "Vous connaissez déjà la réponse. J'ai simplement dit que je leur demanderais si l'occasion se présentait."

# game/scripts/c14/c14.rpy:520
translate french c14s001_ContinuationSam_6b0bc833:

    # sim "Bueno, la próxima vez que te vea y estén ellas delante, te besaré y las observaré para comprobar si ponen la misma cara que tenía yo hace unos minutos."
    sim "Eh bien, la prochaine fois que je te verrai et qu'ils seront là, je t'embrasserai et je les observerai pour voir s'ils font la même tête que moi il y a quelques minutes."

# game/scripts/c14/c14.rpy:521
translate french c14s001_ContinuationSam_66b7953b:

    # mc "*Risa* Eso podría ser muy divertido. Ahora que tu madre ya sabe lo nuestro, parece que no te importa hacerlo público."
    mc "*Rires* Ça pourrait être vraiment amusant. Maintenant que ta mère est au courant, il semblerait que ça ne te dérange pas de le rendre public."

# game/scripts/c14/c14.rpy:523
translate french c14s001_ContinuationSam_cc13c2d8:

    # sim "No quiero parecer una perra celosa, pero sería una forma de marcar territorio si alguna de ellas tiene ideas... controvertidas. *Risa*"
    sim "Je ne veux pas passer pour une jalouse, mais ce serait une façon de marquer mon territoire si l'un d'eux avait des idées… controversées. *Rires*"

# game/scripts/c14/c14.rpy:524
translate french c14s001_ContinuationSam_4e7df14c:

    # mc "¿Controvertidas?"
    mc "Controversé?"

# game/scripts/c14/c14.rpy:526
translate french c14s001_ContinuationSam_c6b1927e:

    # sim "Es tu familia... no sé cómo llamar a que te estuvieras acostando con tus primas... ya me cuesta saber cómo llamar a que te acuestes con mi madre y conmigo..."
    sim "C'est ta famille… Je ne sais pas comment qualifier le fait que tu couches avec tes cousins… J'ai déjà du mal à savoir comment qualifier le fait que tu couches avec ma mère et moi…"

# game/scripts/c14/c14.rpy:527
translate french c14s001_ContinuationSam_8ce5c22c:

    # mc "¿Un hombre feliz? *Risa*"
    mc "Un homme heureux ? *Rires*"

# game/scripts/c14/c14.rpy:529
translate french c14s001_ContinuationSam_edbb98cd:

    # sim "*Risa* ¡Capullo!"
    sim "*Rires* Crétin !"

# game/scripts/c14/c14.rpy:530
translate french c14s001_ContinuationSam_f259e62d:

    # mc "Pero volviendo al tema de tu madre. ¿Estamos bien?"
    mc "Pour en revenir à ta mère, tout va bien ?"

# game/scripts/c14/c14.rpy:532
translate french c14s001_ContinuationSam_51fdc84c:

    # sim "Sí, estamos bien. Verla tan enfadada y azorada al mismo tiempo me ha hecho darme cuenta de una cosa..."
    sim "Oui, tout va bien. La voir à la fois si en colère et si perturbée m'a fait réaliser quelque chose…"

# game/scripts/c14/c14.rpy:533
translate french c14s001_ContinuationSam_06833430:

    # sim "Lleva una semana cantando mientras cocina. Canta fatal, pero canta. Y haciendo cuentas, empezó a hacerlo cuando... empezasteis lo vuestro..."
    sim "Ça fait une semaine qu'elle chante en cuisinant. Elle chante très mal, mais elle chante. Et si on fait le calcul, elle a commencé à le faire quand… vous avez commencé à sortir ensemble…"

# game/scripts/c14/c14.rpy:534
translate french c14s001_ContinuationSam_faa4a11d:

    # sim "No había cantado desde que murió mi padre. ¿Quién soy yo para negarle eso?"
    sim "Je n'avais pas chanté depuis la mort de mon père. Qui suis-je pour le lui refuser ?"

# game/scripts/c14/c14.rpy:535
translate french c14s001_ContinuationSam_1caf40a3:

    # mc "Te entiendo. Sabes que lo único que quiero es haceros felices. A las dos."
    mc "Je comprends. Vous savez que tout ce que je veux, c'est vous rendre heureux tous les deux. Tous les deux."

# game/scripts/c14/c14.rpy:537
translate french c14s001_ContinuationSam_679cb55e:

    # sim "Nunca me atrevería a hacerte elegir entre las dos."
    sim "Je n'oserais jamais vous demander de choisir entre les deux."

# game/scripts/c14/c14.rpy:538
translate french c14s001_ContinuationSam_ff542e68:

    # mc "Haces bien. No me gusta que me pongan entre la espada y la pared."
    mc "Vous avez raison. Je n'aime pas être mise dans une situation difficile."

# game/scripts/c14/c14.rpy:540
translate french c14s001_ContinuationSam_abeadc17:

    # sim "Lo sé, hace 10 años que te conozco. Seguro que quién te dé a elegir no es la elegida. No soy tan tonta como para caer en esa trampa."
    sim "Je sais, je te connais depuis dix ans. Je suis sûre que celui qui te laisse le choix n'est pas celui que tu as choisi. Je ne suis pas assez naïve pour me faire avoir."

# game/scripts/c14/c14.rpy:542
translate french c14s001_ContinuationSam_e8b9e2b9:

    # sam "¿Trampa? ¿Qué trampa?"
    sam "Un piège ? Quel piège ?"

# game/scripts/c14/c14.rpy:544
translate french c14s001_ContinuationSam_caf1916a:

    # sim "En la que caería quien intentase hacer que [mc] eligiera entre dos cosas. Ya sean amigos... o chicas."
    sim "Voilà ce qui arriverait à quiconque tenterait de faire choisir [mc] entre deux choses. Qu'il s'agisse d'amis... ou de filles."

# game/scripts/c14/c14.rpy:546
translate french c14s001_ContinuationSam_4cf055e0:

    # sam "Ninguna de las dos vamos a hacerlo, ¿verdad?"
    sam "Aucun de nous deux ne le fera, n'est-ce pas ?"

# game/scripts/c14/c14.rpy:547
translate french c14s001_ContinuationSam_97fb0a95:

    # sam "Es una elección que debemos tomar nosotras. Él puede elegir seguir con las dos o con ninguna."
    sam "C'est un choix que nous devons faire. Il peut choisir de continuer avec nous deux ou avec aucun des deux."

# game/scripts/c14/c14.rpy:549
translate french c14s001_ContinuationSam_4999fe3f:

    # sim "Entonces va a ser con las dos. Una vez pasada la sorpresa, no pienso renunciar a él. Tú puedes hacerlo si quieres."
    sim "Alors ce sera avec les deux. Une fois le choc initial passé, je ne compte pas le laisser partir. Vous pouvez le faire si vous voulez."

# game/scripts/c14/c14.rpy:551
translate french c14s001_ContinuationSam_dc9041b7:

    # sam "Entonces dejémoslo en que tú y yo vamos a tener que hablar para ver cómo nos organizamos."
    sam "Disons donc que nous allons devoir discuter pour voir comment nous pouvons organiser cela."

# game/scripts/c14/c14.rpy:552
translate french c14s001_ContinuationSam_c23167d6:

    # sam "Y para ver como se lo decimos a Jamaal..."
    sam "Et trouver comment l'annoncer à Jamaal..."

# game/scripts/c14/c14.rpy:554
translate french c14s001_ContinuationSam_44276223:

    # sim "Eso va a ser lo más difícil. Se va a estar riendo de nosotras por compartir hombre. Y además {b}este{/b} hombre."
    sim "Ça va être le plus dur. Il va se moquer de nous parce qu'on partage le même homme. Et puis, cet homme…"

# game/scripts/c14/c14.rpy:555
translate french c14s001_ContinuationSam_faa8e77a:

    # mc "Hey, que estoy aquí..."
    mc "Salut, je suis là..."

# game/scripts/c14/c14.rpy:557
translate french c14s001_ContinuationSam_66e33ffc:

    # sam "Pero vas a estarlo por poco tiempo. Creo que es hora de que te vayas, tengo mucho que hablar con mi hija y no va a ser agradable si tú estás delante."
    sam "Mais vous ne resterez pas longtemps. Je pense qu'il est temps pour vous de partir ; j'ai beaucoup de choses à dire à ma fille, et ce ne sera pas agréable si vous êtes là."

# game/scripts/c14/c14.rpy:558
translate french c14s001_ContinuationSam_45228cb4:

    # mc "¿Estás bien, Samantha?"
    mc "Ça va, Samantha ?"

# game/scripts/c14/c14.rpy:560
translate french c14s001_ContinuationSam_7920aae5:

    # sam "Sí y no. No puedo estar bien sabiendo que no soy suficiente para ti."
    sam "Oui et non. Je ne peux pas accepter de savoir que je ne suis pas assez bien pour toi."

# game/scripts/c14/c14.rpy:561
translate french c14s001_ContinuationSam_62dfc4f2:

    # sam "Por otro lado... no te enfades, Simone... saber que tampoco es suficiente para ti mi niña de 19 años... lo suaviza un poco..."
    sam "D'un autre côté… ne te fâche pas, Simone… savoir que ma fille de 19 ans ne te suffit pas non plus… ça adoucit un peu les choses…"

# game/scripts/c14/c14.rpy:563
translate french c14s001_ContinuationSam_ea4a8556:

    # sim "¡Mamá! Empezó a salir conmigo después de ti. Él no podía saber si yo sería suficiente."
    sim "Maman ! Il a commencé à sortir avec moi après toi. Il ne savait pas si je serais à la hauteur."

# game/scripts/c14/c14.rpy:564
translate french c14s001_ContinuationSam_925e88e6:

    # mc "¡Chicas, parad!"
    mc "Les filles, arrêtez !"

# game/scripts/c14/c14.rpy:565
translate french c14s001_ContinuationSam_6d87e007:

    # mc "Cualquiera de las dos sería suficiente para cualquier hombre."
    mc "L'une ou l'autre suffirait à n'importe quel homme."

# game/scripts/c14/c14.rpy:567
translate french c14s001_ContinuationSam_f308f316:

    # mc "Si para vosotras es un problema que esté con las dos a la vez..."
    mc "Si le fait que je sois avec les deux en même temps vous pose problème..."

# game/scripts/c14/c14.rpy:569
translate french c14s001_ContinuationSam_73d5a7de:

    # mc "Si para vosotras es un problema que esté con las dos a la vez y con la otra chica..."
    mc "Si le fait qu'il soit avec les deux en même temps et avec l'autre fille vous pose problème..."

# game/scripts/c14/c14.rpy:571
translate french c14s001_ContinuationSam_feca9bf2:

    # mc "Si para vosotras es un problema que esté con las dos a la vez y con el resto de las chicas..."
    mc "Si le fait qu'il soit avec vous deux en même temps et avec les autres filles vous pose problème..."

# game/scripts/c14/c14.rpy:572
translate french c14s001_ContinuationSam_29a68f3d:

    # mc "Si sois capaces de decidir, cívicamente, cual corta conmigo..."
    mc "Si vous êtes capable de décider, de manière courtoise, lequel me coupe la parole..."

# game/scripts/c14/c14.rpy:574
translate french c14s001_ContinuationSam_72ebd1f2:

    # sam "¿Qué? ¡No! ¡No podríamos!" (multiple=2)
    sam "Quoi ? Non ! On ne pouvait pas !" (multiple=2)

# game/scripts/c14/c14.rpy:575
translate french c14s001_ContinuationSam_994715e2:

    # sim "¡Las dos te querríamos para nosotras!" (multiple=2)
    sim "Nous te voudrions tous les deux pour nous-mêmes !" (multiple=2)

# game/scripts/c14/c14.rpy:576
translate french c14s001_ContinuationSam_1c81ceec:

    # mc "Entonces la decisión la habéis tomado vosotras."
    mc "Vous avez donc pris la décision."

# game/scripts/c14/c14.rpy:579
translate french c14s001_ContinuationSam_d166b3ec:

    # sam "Imagínate cómo se quedaría la otra. Prefiero compartirte a tener que cederte, aunque sea a mi hija."
    sam "Imaginez ce que ressentirait l'autre. Je préférerais te partager plutôt que de devoir me séparer de toi, même s'il s'agit de ma fille."

# game/scripts/c14/c14.rpy:581
translate french c14s001_ContinuationSam_8f38c44e:

    # sim "Yo tampoco querría cederte. Y ser la que se queda contigo sería casi peor..."
    sim "Je ne voudrais pas te laisser partir non plus. Et rester avec toi serait presque pire…"

# game/scripts/c14/c14.rpy:583
translate french c14s001_ContinuationSam_d166b3ec_1:

    # sam "Imagínate cómo se quedaría la otra. Prefiero compartirte a tener que cederte, aunque sea a mi hija."
    sam "Imaginez ce que ressentirait l'autre. Je préférerais te partager plutôt que de devoir me séparer de toi, même s'il s'agit de ma fille."

# game/scripts/c14/c14.rpy:585
translate french c14s001_ContinuationSam_8f38c44e_1:

    # sim "Yo tampoco querría cederte. Y ser la que se queda contigo sería casi peor..."
    sim "Je ne voudrais pas te laisser partir non plus. Et rester avec toi serait presque pire…"

# game/scripts/c14/c14.rpy:587
translate french c14s001_ContinuationSam_166572f3:

