    todas "Fantastique!"

# game/scripts/c14/c14.rpy:2566
translate french c14s005_BallGame_6da79885:

    # kim "Pues ahora le toca a [mc]"
    kim "C'est maintenant au tour de [mc]"

# game/scripts/c14/c14.rpy:2567
translate french c14s005_BallGame_ab1a80f0:

    # mc "*Risa* Empieza a no gustarme este juego."
    mc "*Rires* Je commence à ne plus aimer ce jeu."

# game/scripts/c14/c14.rpy:2570
translate french c14s005_BallGame_747e2707:

    # "Te acercas a Kim, en la orilla, y le susurras al oído."
    "Vous vous approchez de Kim sur la plage et lui chuchotez à l'oreille."

# game/scripts/c14/c14.rpy:2589
translate french c14s005_BallGame_01266326:

    # mc "*Susurrando* No va a bailar nadie más, podríamos aprovechar y enseñarles cómo se hace..."
    mc "*Chuchotements* Personne d'autre ne va danser, on pourrait en profiter pour leur montrer comment on fait..."

# game/scripts/c14/c14.rpy:2593
translate french c14s005_BallGame_706bcf19:

    # kim "No, no. Te toca dar el espectáculo a ti solo. Yo ya lo he hecho."
    kim "Non, non. C'est à toi de monter le spectacle toi-même. Je l'ai déjà fait."

# game/scripts/c14/c14.rpy:2599
translate french c14s005_BallGame_f49f9dc8:

    # kat "¡Mueve ese cuerpo!"
    kat "Bouge ce corps !"

# game/scripts/c14/c14.rpy:2600
translate french c14s005_BallGame_604f24d4:

    # dap "¡Demuéstranos el ritmo que llevas dentro!"
    dap "Montre-nous le rythme que tu as en toi !"

# game/scripts/c14/c14.rpy:2603
translate french c14s005_BallGame_86a10d9a:

    # sca "¡Olé! ¡Ese ritmo caribeño solo se puede llevar en la sangre!"
    sca "Olé ! Ce rythme caribéen ne peut se transmettre que par le sang !"

# game/scripts/c14/c14.rpy:2604
translate french c14s005_BallGame_583094ad:

    # deb "Parece que haya nacido en Cuba o en Aruba."
    deb "Il a l'air d'être né à Cuba ou à Aruba."

# game/scripts/c14/c14.rpy:2605
translate french c14s005_BallGame_cc6e7ec0:

    # kim "No entiendo por que nos ibamos a reir de ti. ¡Lo estás haciendo genial!"
    kim "Je ne comprends pas pourquoi on se moquerait de toi. Tu te débrouilles super bien !"

# game/scripts/c14/c14.rpy:2609
translate french c14s005_BallGame_8332641c:

    # mc "Se acabó el espectáculo por hoy. Saca Kim."
    mc "Le spectacle est terminé pour aujourd'hui. Place à Kim."

# game/scripts/c14/c14.rpy:2611
translate french c14s005_BallGame_0fb5ea12:

    # kat "Chicas, todas las pelotas a [mc]. A ver si se le escapa alguna y nos hace otro baile."
    kat "Les filles, à vos marques [mc] ! Voyons s'il laisse échapper une petite gaffe et nous offre une autre danse."

# game/scripts/c14/c14.rpy:2613
translate french c14s005_BallGame_0c2bcd45:

    # kim "*Susurrando* Por mí genial. ¿Qué se te ha ocurrido?"
    kim "*À voix basse* Ça me paraît super. Qu'est-ce que tu as trouvé ?"

# game/scripts/c14/c14.rpy:2614
translate french c14s005_BallGame_3abd998a:

    # mc "¿Confías en mí?"
    mc "Me faites-vous confiance ?"

# game/scripts/c14/c14.rpy:2615
translate french c14s005_BallGame_8611b606:

    # kim "Sí."
    kim "Ouais."

# game/scripts/c14/c14.rpy:2617
translate french c14s005_BallGame_10dc82cc:

    # mc "¿Qué tal se te dan los bailes latinos?"
    mc "Quel est votre niveau en danses latines ?"

# game/scripts/c14/c14.rpy:2618
translate french c14s005_BallGame_c1ff4d04:

    # kim "Fatal, pero probemos. *Risa* Eres una caja de sorpresas."
    kim "C'est terrible, mais essayons. *Rires* Tu es une vraie surprise !"

# game/scripts/c14/c14.rpy:2621
translate french c14s005_BallGame_1a7e0ece:

    # "Empezáis a bailar sin necesidad de música."
    "Vous vous mettez à danser sans avoir besoin de musique."

# game/scripts/c14/c14.rpy:2622
translate french c14s005_BallGame_684abe0e:

    # "Parece que hayáis bailado juntos multitud de veces en alguna vida pasada."
    "On dirait que vous avez dansé ensemble d'innombrables fois dans une vie antérieure."

# game/scripts/c14/c14.rpy:2623
translate french c14s005_BallGame_8cbbefa2:

    # "Vuestros cuerpos se adaptan perfectamente a los movimientos del otro, sin necesidad de palabras, tan solo con un gesto el otro ya sabe lo que tiene que hacer."
    "Vos corps s'adaptent parfaitement aux mouvements de l'autre, sans qu'un mot soit nécessaire ; d'un simple geste, l'autre sait déjà quoi faire."

# game/scripts/c14/c14.rpy:2624
translate french c14s005_BallGame_6f841cae:

    # "Dónde moverse."
    "Où déménager."

# game/scripts/c14/c14.rpy:2625
translate french c14s005_BallGame_65f1ba60:

    # "Cómo hacerlo."
    "Comment faire."

# game/scripts/c14/c14.rpy:2626
translate french c14s005_BallGame_cbbac6fa:

    # "El sonido del mar es suficiente música para vosotros."
    "Le bruit de la mer est une musique suffisante pour vous."

# game/scripts/c14/c14.rpy:2627
translate french c14s005_BallGame_4a691b7f:

    # "No sabes cuánto tiempo habéis bailado antes de que vuestro público empiece a aplaudiros, substituyendo la inexistente música con sus palmadas."
    "On ne se rend même pas compte depuis combien de temps on danse avant que le public ne se mette à applaudir, remplaçant la musique inexistante par ses applaudissements."

# game/scripts/c14/c14.rpy:2628
translate french c14s005_BallGame_12098f90:

    # "Esas palmadas os recuerdan que, aunque lo haya parecido durante unos instantes, no estáis solos en la playa."
    "Ces tapes dans le dos vous rappellent que, même si vous avez pu le croire pendant quelques instants, vous n'êtes pas seul sur la plage."

# game/scripts/c14/c14.rpy:2630
translate french c14s005_BallGame_9bc56aa7:

    # "Acabáis vuestro baile, para deleite de vuestro público."
    "Vous terminez votre danse, pour le plus grand plaisir de votre public."

# game/scripts/c14/c14.rpy:2633
translate french c14s005_BallGame_2c823109:

    # todas "*Aplausos*"
    todas "*Applaudissements*"

# game/scripts/c14/c14.rpy:2634
translate french c14s005_BallGame_58955911:

    # kim "*Susurrando* ¡Ha sido increíble, [mc]! ¡No había bailado así en mi vida!"
    kim "*Chuchotant* C'était incroyable, [mc] ! Je n'ai jamais dansé comme ça de ma vie !"

# game/scripts/c14/c14.rpy:2635
translate french c14s005_BallGame_17d78d89:

    # mc "*Susurrando* Nadie podría imaginar que se te dan fatal los bailes latinos."
    mc "*À voix basse* Personne n'imaginerait que tu es si mauvaise en danses latines."

