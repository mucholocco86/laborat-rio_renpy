

# game/scripts/c27/c27.rpy:40
translate french c27_0ae9bcd0:

    # ""
    ""

# game/scripts/c27/c27.rpy:55
translate french c27s001_DebDate_6e671808:

    # deb "Gracias, pero no intentes ruborizarme. Creo que ya lo has hecho suficiente con [kat] esta mañana."
    deb "Merci, mais ne cherchez pas à me mettre dans l'embarras. Je pense que vous en avez assez fait avec [kat] ce matin."

# game/scripts/c27/c27.rpy:56
translate french c27s001_DebDate_0d4c2f91:

    # mc "No lo digo por ruborizarte, lo digo porque es verdad. Además, me encanta cómo te queda ese vestido."
    mc "Je ne dis pas ça pour te gêner, je le dis parce que c'est vrai. En plus, j'adore comme cette robe te va bien."

# game/scripts/c27/c27.rpy:58
translate french c27s001_DebDate_81172e04:

    # deb "[kim] me ha dicho que... como tengo las piernas tan largas... un vestido asimétrico las realzaría."
    deb "[kim] m'a dit que... comme j'ai de si longues jambes... une robe asymétrique les mettrait en valeur."

# game/scripts/c27/c27.rpy:59
translate french c27s001_DebDate_51301f4a:

    # deb "No sé si creerla. Siempre he pensado que tengo las piernas {b}demasiado{/b} largas. No es una cosa que me guste realzar."
    deb "Je ne sais pas si je la crois. J'ai toujours pensé que mes jambes étaient trop longues. Ce n'est pas quelque chose que j'aime souligner."

# game/scripts/c27/c27.rpy:60
translate french c27s001_DebDate_ef669374:

    # mc "Cielo, no existen 'piernas {b}demasiado{/b} largas'."
    mc "Chérie, il n'existe pas de jambes « trop longues »."

# game/scripts/c27/c27.rpy:61
translate french c27s001_DebDate_20b041d4:

    # mc "Como se suele decir, las tuyas son tan largas que, al recorrerlas, apetece hacer un descanso a medio camino."
    mc "Comme on dit, vos chemins sont si longs que, lorsqu'on les parcourt, on a envie de faire une pause à mi-chemin."

# game/scripts/c27/c27.rpy:63
translate french c27s001_DebDate_a513a08c:

    # deb "¡[mc]! ¡Eso ha sonado más travieso de lo que creo que querías sonar!"
    deb "[mc]! Ça sonnait plus coquin que ce que tu voulais dire, je pense !"

# game/scripts/c27/c27.rpy:64
translate french c27s001_DebDate_442b68f3:

    # mc "*Risa* No te imaginas lo travieso que quería sonar."
    mc "*Rires* Vous ne pouvez pas imaginer à quel point j'avais envie de paraître coquine."

# game/scripts/c27/c27.rpy:65
translate french c27s001_DebDate_f5cc2b81:

    # mc "Pero, ¿puedo besar a mi cita?"
    mc "Mais puis-je embrasser mon/ma partenaire ?"

# game/scripts/c27/c27.rpy:67
translate french c27s001_DebDate_a10869e9:

    # "La sirena no te contesta y toma la iniciativa por sí misma, besándote dulcemente. Los tacones y la diferencia de altura te hacen sentirte pequeño."
    "La sirène ne vous répond pas et prend l'initiative en vous embrassant tendrement. Ses talons et la différence de taille vous font vous sentir tout petit."

# game/scripts/c27/c27.rpy:68
translate french c27s001_DebDate_72f51c6f:

    # "¡Cómo ha cambiado la nadadora! Ha pasado de inventarse juegos para robarte un beso a tomar la iniciativa."
    "Comme la nageuse a changé ! Elle est passée d'inventer des jeux pour voler un baiser à prendre l'initiative."

# game/scripts/c27/c27.rpy:69
translate french c27s001_DebDate_db44b796:

    # "Es un beso que te dejará con ganas de más cuando termine. Da lo mismo que dure un segundo o una hora."
    "C'est un baiser qui vous laissera sur votre faim. Qu'il dure une seconde ou une heure, peu importe."

# game/scripts/c27/c27.rpy:71
translate french c27s001_DebDate_4b388357:

    # "Cuando separa sus labios de los tuyos sientes una sensación de pérdida."
    "Lorsqu'il sépare ses lèvres des vôtres, vous éprouvez un sentiment de perte."

# game/scripts/c27/c27.rpy:72
translate french c27s001_DebDate_b763e483:

    # deb "Vámonos antes de que tenga que llevarte a tu habitación a probar esa cama nueva."
    deb "Allons-y avant que je sois obligée de vous emmener dans votre chambre pour essayer ce nouveau lit."

# game/scripts/c27/c27.rpy:73
translate french c27s001_DebDate_e4ee9aa0:

    # mc "*Risa* Ahora eres tú la que has sonado traviesa..."
    mc "*Rires* Maintenant, c'est toi qui as l'air coquin..."

# game/scripts/c27/c27.rpy:75
translate french c27s001_DebDate_151de55f:

    # deb "*Risa* Pero no más de lo que quería sonar."
    deb "*Rires* Mais pas plus que je ne le souhaitais."

# game/scripts/c27/c27.rpy:76
translate french c27s001_DebDate_4730b6b0:

    # deb "Tengo intención de que me enseñes esa cama cuando volvamos de comer."
    deb "Je compte que tu me montreras ce lit à notre retour de repas."

# game/scripts/c27/c27.rpy:77
translate french c27s001_DebDate_9e51209c:

    # "Otra vez te maravillas de lo mucho que ha evolucionado la siempre tímida [deb.nick]."
    "Une fois de plus, vous vous émerveillez de l'évolution de l'éternel timide [deb.nick]."

# game/scripts/c27/c27.rpy:78
translate french c27s001_DebDate_e9d72f3f:

    # mc "Entonces será mejor que nos vayamos. [emm] quería ser la primera en probar la cama."
    mc "Alors on ferait mieux d'y aller. [emm] Je voulais être le premier à essayer le lit."

# game/scripts/c27/c27.rpy:80
translate french c27s001_DebDate_e8b5c3db:

    # deb "Ya veremos..."
    deb "On verra..."

# game/scripts/c27/c27.rpy:81
translate french c27s001_DebDate_04df0c90:

    # mc "Me gusta esa nueva [deb.nick]. Pero espera..."
    mc "J'aime bien ce nouveau [deb.nick]. Mais attendez..."

# game/scripts/c27/c27.rpy:83
translate french c27s001_DebDate_9b1b27ed:

    # deb "¿Qué pasa?"
    deb "Ce qui se passe?"

# game/scripts/c27/c27.rpy:84
translate french c27s001_DebDate_dc5fdda3:

    # mc "Quiero un beso antes de irnos."
    mc "Je veux un baiser avant de partir."

# game/scripts/c27/c27.rpy:86
translate french c27s001_DebDate_0d0a276b:

    # deb "¡Soy idiota! ¡Estaba tan nerviosa por si te gustaría el vestido que ni he pensado en el beso!"
    deb "Je suis vraiment bête ! J'étais tellement nerveuse à l'idée de savoir si la robe te plairait que je n'ai même pas pensé au baiser !"

# game/scripts/c27/c27.rpy:87
translate french c27s001_DebDate_29ea87c7:

    # mc "Y sigues nerviosa. Ya nos hemos besado."
    mc "Et tu es encore nerveux. On s'est déjà embrassés."

# game/scripts/c27/c27.rpy:88
translate french c27s001_DebDate_8ca2a38c:

    # deb "¿Qué? ¿Cuándo?"
    deb "Quoi ? Quand ?"

# game/scripts/c27/c27.rpy:89
translate french c27s001_DebDate_e9fe48bf:

    # mc "*Risa* Hace un minuto. Ven aquí."
    mc "*Rires* Il y a une minute. Viens ici."

# game/scripts/c27/c27.rpy:91
translate french c27s001_DebDate_e23c623f:

    # "Las tres pulgadas que [deb.nick] es más alta que tú, más los tacones suplen el escalón que ella está más abajo."
    "Les trois pouces que [deb.nick] mesure de plus que toi, plus les talons, compensent la marche qu'elle a plus basse."

# game/scripts/c27/c27.rpy:92
translate french c27s001_DebDate_792ce7a8:

    # "Por primera vez no tienes que inclinar tu cabeza hacia atrás para besarla. Lo echas de menos. Adoras la altura de la nadadora."
    "Pour la première fois, tu n'as plus besoin de pencher la tête en arrière pour l'embrasser. Ça te manquait. Tu adores sa grande taille."

# game/scripts/c27/c27.rpy:94
translate french c27s001_DebDate_9cb06c4d:

    # deb "Si me besas así, se me van a pasar los nervios. Pero creo que entonces podré pasar de la comida e ir directamente a ver esa cama."
    deb "Si tu m'embrasses comme ça, je me calmerai. Mais je crois que dans ce cas, je pourrai sauter le repas et aller directement au lit."

# game/scripts/c27/c27.rpy:95
translate french c27s001_DebDate_8cc92cfd:

    # mc "Entonces dejaré de besarte hasta que acabemos de comer. Tengo muchas ganas de ir a comer contigo."
    mc "Alors j'arrêterai de t'embrasser jusqu'à ce qu'on ait fini de manger. J'ai vraiment hâte de manger avec toi."

# game/scripts/c27/c27.rpy:97
translate french c27s001_DebDate_dc12975b:

    # deb "Besar o comer. *Risa* Me pones entre la espada y la pared. Vámonos antes de que haga una locura."
    deb "Embrasse-moi ou mange-moi. *Rires* Tu m'as mis dans une situation délicate. Allons-y avant que je ne fasse une bêtise."

# game/scripts/c27/c27.rpy:98
translate french c27s001_DebDate_765d6b56:

    # mc "Cualquier locura compartida me parecería bien. Pero podemos esperar a después de comer."
    mc "Toute folie partagée me conviendrait parfaitement. Mais nous pouvons attendre après le déjeuner."

# game/scripts/c27/c27.rpy:101
translate french c27s001_DebDate_cec05883:

    # "Una vez llegáis al restaurante..."
    "Une fois arrivé au restaurant..."

# game/scripts/c27/c27.rpy:103
translate french c27s001_DebDate_2a2dd50a:

    # deb "Es bonito. Me recuerda a un sitio en el que estuvimos hace un par de años, en Verona."
    deb "C'est magnifique. Cela me rappelle un endroit que nous avons visité il y a quelques années à Vérone."

# game/scripts/c27/c27.rpy:104
translate french c27s001_DebDate_2c8bb01b:

    # deb "Se nota que es un decorado, pero está muy logrado."
    deb "C'est clairement un décor, mais il est très bien réalisé."

# game/scripts/c27/c27.rpy:105
translate french c27s001_DebDate_9a611046:

    # mc "¿Has viajado mucho fuera de Estados Unidos?"
    mc "Avez-vous beaucoup voyagé en dehors des États-Unis ?"

# game/scripts/c27/c27.rpy:107
translate french c27s001_DebDate_844704a1:

    # deb "Un poco. Creo que este año es el primer verano que recuerdo sin ningún viaje al extranjero en los últimos 13 o 14 años."
    deb "Un peu. Je crois que c'est le premier été dont je me souvienne sans aucun voyage à l'étranger depuis 13 ou 14 ans."

# game/scripts/c27/c27.rpy:108
translate french c27s001_DebDate_ebd54c03:

    # mc "¿En qué países has estado?"
    mc "Dans quels pays êtes-vous allé ?"

# game/scripts/c27/c27.rpy:109
translate french c27s001_DebDate_eb037365:

    # deb "Italia, Reino Unido, Portugal, España, Francia, Dinamarca, Suecia, Noruega, Suiza, Alemania, Grecia, Turquía, Japón, China, Australia, Nueva Zelanda, India, Vietnam..."
    deb "Italie, Royaume-Uni, Portugal, Espagne, France, Danemark, Suède, Norvège, Suisse, Allemagne, Grèce, Turquie, Japon, Chine, Australie, Nouvelle-Zélande, Inde, Vietnam..."

# game/scripts/c27/c27.rpy:111
translate french c27s001_DebDate_57e9a0d2:

    # deb "¿Cuánto rato me vas a seguir dejando decir países?"
    deb "Combien de temps encore allez-vous me laisser nommer des pays ?"

# game/scripts/c27/c27.rpy:112
translate french c27s001_DebDate_fb7527d3:

    # mc "Pensaba dejarte hasta que recorrieras la ONU al completo. *Risa*"
    mc "Je comptais te laisser jusqu'à ce que tu aies exploré l'intégralité de l'ONU. *Rires*"

# game/scripts/c27/c27.rpy:114
translate french c27s001_DebDate_ee968cba:

    # deb "*Risa* No, qué va. En África sólo he estado en Marruecos, Túnez y Egipto. En Latino América sólo en México, Perú, Guatemala, Ecuador, Brasil y Colombia."
    deb "*Rires* Non, pas du tout. En Afrique, je ne suis allée qu'au Maroc, en Tunisie et en Égypte. En Amérique latine, seulement au Mexique, au Pérou, au Guatemala, en Équateur, au Brésil et en Colombie."

# game/scripts/c27/c27.rpy:115
translate french c27s001_DebDate_79a6b884:

    # deb "La Unión Europea la he recorrido entera, y de Asia me quedaban por decir Camboya y Tailandia. Creo que no me dejo ningún país de la lista..."
    deb "J'ai parcouru toute l'Union européenne, et en Asie, il me restait encore le Cambodge et la Thaïlande à mentionner. Je crois que je n'ai oublié aucun pays sur la liste..."

# game/scripts/c27/c27.rpy:116
translate french c27s001_DebDate_d5f11554:

    # mc "Es decir... unos 50 países en 13 o 14 años... es impresionante. Pero casi te daba tiempo a aterrizar y poco más, ¿no?"
    mc "Je veux dire… une cinquantaine de pays en 13 ou 14 ans… c’est impressionnant. Mais vous avez à peine eu le temps d’atterrir et pas grand-chose d’autre, n’est-ce pas ?"

# game/scripts/c27/c27.rpy:118
translate french c27s001_DebDate_02eeb9de:

    # deb "Bueno, en verano hacíamos viajes de un mes con mi madre cuando acababan las clases. Y después un par de semanas extras con mi padre en Agosto."
    deb "Eh bien, l'été, nous avions l'habitude de partir en voyage pendant un mois avec ma mère une fois les cours terminés. Et puis, quelques semaines supplémentaires avec mon père en août."

# game/scripts/c27/c27.rpy:119
translate french c27s001_DebDate_f42e0d10:

    # deb "Suma a eso Acción de Gracias, Navidad... Quizás eran un par de meses viajando cada año. Y no son 50 países, sólo 48."
    deb "Ajoutez à cela Thanksgiving, Noël… Peut-être s'agissait-il de quelques mois de voyage chaque année. Et ce n'est pas 50 pays, mais seulement 48."

# game/scripts/c27/c27.rpy:120
translate french c27s001_DebDate_96ed9f61:

    # mc "Sigue siendo impresionante."
    mc "C'est toujours impressionnant."

# game/scripts/c27/c27.rpy:122
translate french c27s001_DebDate_e5b3767a:

    # deb "Hay países que me hubiera gustado ver más en profundidad. De algunos sólo he estado en una o dos ciudades."
    deb "Il y a des pays que j'aurais aimé explorer plus en profondeur. Dans certains, je n'ai visité qu'une ou deux villes."

# game/scripts/c27/c27.rpy:123
translate french c27s001_DebDate_24a624ac:

    # deb "Y hay otros a los que he ido varias veces, como Italia, Francia, España, Canadá..."
    deb "Et il y en a d'autres où je suis allée plusieurs fois, comme l'Italie, la France, l'Espagne, le Canada..."

# game/scripts/c27/c27.rpy:124
translate french c27s001_DebDate_9b15654d:

    # mc "¿Tienes algún país favorito?"
    mc "Avez-vous un pays préféré ?"

# game/scripts/c27/c27.rpy:126
translate french c27s001_DebDate_9ff5f84b:

    # deb "Muchos. No podría elegir uno. Cada país tiene su encanto, su cultura... Por norma mi país favorito es en el que estoy en ese momento."
    deb "Il y en a tellement ! Impossible d'en choisir un seul. Chaque pays a son charme, sa culture… En général, mon pays préféré est celui où je me trouve actuellement."

# game/scripts/c27/c27.rpy:127
translate french c27s001_DebDate_0559c921:

    # deb "Si empiezas a pensar cosas como 'esto era más bonito, o estaba más bueno, en otro sitio' no disfrutas lo que estás viviendo."
    deb "Si vous commencez à penser des choses comme « c'était plus joli, ou mieux, ailleurs », vous ne profiterez pas de ce que vous vivez."

# game/scripts/c27/c27.rpy:128
translate french c27s001_DebDate_5dc520e9:

    # deb "Me encanta viajar, y cuando estoy en un sitio sólo existe ese sitio. No puedo compararlo con otros."
    deb "J'adore voyager, et quand je suis quelque part, c'est le seul endroit qui existe vraiment. Je ne peux pas le comparer à d'autres."

# game/scripts/c27/c27.rpy:129
translate french c27s001_DebDate_97045e27:

    # mc "Nunca lo había visto así. Siempre he oído a gente decir 'Estoy enamorado de Japón, Italia, o España'."
    mc "Je n'y avais jamais pensé de cette façon. J'ai toujours entendu les gens dire : « Je suis amoureux du Japon, de l'Italie ou de l'Espagne. »"

# game/scripts/c27/c27.rpy:130
translate french c27s001_DebDate_120ee616:

    # mc "Tiene mucha más lógica cómo lo dices tú."
    mc "C'est beaucoup plus logique comme ça."

# game/scripts/c27/c27.rpy:132
translate french c27s001_DebDate_c9ea9070:

    # deb "¿Y tú? ¿En qué países has estado?"
    deb "Et vous ? Dans quels pays êtes-vous allé ?"

# game/scripts/c27/c27.rpy:133
translate french c27s001_DebDate_2998f279:

    # mc "De toda tu lista, sólo en Canadá. Fui a un concierto en Vancouver cuando estaba en Portland, el primer año."
    mc "De tout ce qui figure sur votre liste, seulement au Canada. Je suis allée à un concert à Vancouver lors de ma première année à Portland."

# game/scripts/c27/c27.rpy:134
translate french c27s001_DebDate_1eb823d3:

    # deb "¿Y sitios que no estén en mi lista?"
    deb "Et les endroits qui ne figurent pas sur ma liste ?"

# game/scripts/c27/c27.rpy:135
translate french c27s001_DebDate_dbbd4c94:

    # mc "*Risa* Ninguno. No hemos viajado mucho, ni dentro ni fuera de Estados Unidos."
    mc "*Rires* Aucun. Nous n'avons pas beaucoup voyagé, ni aux États-Unis ni à l'étranger."

# game/scripts/c27/c27.rpy:136
translate french c27s001_DebDate_64d51d8f:

    # mc "Pero estaré en Aruba, que no está en tu lista. *Risa*"
    mc "Mais je serai à Aruba, qui ne figure pas sur votre liste. *Rires*"

# game/scripts/c27/c27.rpy:138
translate french c27s001_DebDate_2553ffcc:

    # deb "Bueno, el status de Aruba como país es diferente a lo que estamos acostumbrados los americanos."
    deb "Eh bien, le statut d'Aruba en tant que pays est différent de celui auquel nous, Américains, sommes habitués."

# game/scripts/c27/c27.rpy:139
translate french c27s001_DebDate_cd1fe8ab:

    # deb "Casi sería como hablar de un estado de los Países Bajos. Como si habláramos de Virginia respecto a Estados Unidos."
    deb "Ce serait presque comme parler d'un État des Pays-Bas. Comme parler de la Virginie par rapport aux États-Unis."

# game/scripts/c27/c27.rpy:140
translate french c27s001_DebDate_7b3ff11f:

    # mc "Siempre he pensado que era un país independiente."
    mc "J'ai toujours cru que c'était un pays indépendant."

# game/scripts/c27/c27.rpy:142
translate french c27s001_DebDate_c9eceb4a:

    # deb "Yo también. Nunca había leído nada sobre él hasta que decidiste irte allí."
    deb "Moi aussi. Je n'avais jamais rien lu à ce sujet avant que tu décides d'y aller."

# game/scripts/c27/c27.rpy:143
translate french c27s001_DebDate_e8dc22b4:

    # deb "Conozco gente que ha ido a hacer turismo, pero no sabía nada del país."
    deb "Je connais des gens qui y sont allés en tant que touristes, mais je ne connaissais rien de ce pays."

# game/scripts/c27/c27.rpy:144
translate french c27s001_DebDate_af3ebf53:

    # mc "Es conmovedor que te preocupes así por mí."
    mc "C'est touchant que tu te soucies de moi comme ça."

# game/scripts/c27/c27.rpy:146
translate french c27s001_DebDate_7f378831:

    # deb "*Risa* Tenía que comprobar si iban a secuestrar a mi novio o algo así."
    deb "*Rires* J'ai dû vérifier s'ils allaient kidnapper mon copain ou quelque chose comme ça."

# game/scripts/c27/c27.rpy:147
translate french c27s001_DebDate_acd21027:

    # mc "Creo que el riesgo de secuestro es más alto por parte de la empresa que del país."
    mc "Je crois que le risque d'enlèvement est plus élevé du côté de l'entreprise que du côté du pays."

# game/scripts/c27/c27.rpy:148
translate french c27s001_DebDate_43673dbb:

    # mc "*Risa* Y que me protejan de un posible secuestro también."
    mc "*Rires* Et qu'ils me protègent aussi d'un éventuel enlèvement."

# game/scripts/c27/c27.rpy:149
translate french c27s001_DebDate_a7f8dac3:

    # deb "*Risa* Tienes razón. Yo no intentaría secuestrarte con [ama] o [eva] cerca. *Susurrando* Y un ejército de clones."
    deb "*Rires* Tu as raison. Je ne tenterais pas de te kidnapper avec [ama] ou [eva] dans les parages. *Chuchotant* Et une armée de clones."

# game/scripts/c27/c27.rpy:151
translate french c27s001_DebDate_69705291:

    # deb "Por suerte hoy no están en casa..."
    deb "Heureusement, ils ne sont pas à la maison aujourd'hui..."

# game/scripts/c27/c27.rpy:152
translate french c27s001_DebDate_c5aaca27:

    # mc "Te noto muy traviesa hoy. *Risa* No me lo esperaba."
    mc "Tu as l'air bien espiègle aujourd'hui. *Rires* Je ne m'y attendais pas."

# game/scripts/c27/c27.rpy:154
translate french c27s001_DebDate_91aa1172:

    # deb "Empecé a hacer bromas con [lis] anoche para ocultar lo insegura que me sentía."
    deb "J'ai commencé à faire des blagues avec [lis] hier soir pour cacher mon manque de confiance en moi."

# game/scripts/c27/c27.rpy:155
translate french c27s001_DebDate_e927e82f:

    # deb "¿Sabes lo de fingir una sonrisa hasta que sea real? Pues con las bromas sobre sexo funcionó. Tras varias bromas, dejé de preocuparme."
    deb "Vous connaissez ce truc de faire semblant de sourire jusqu'à ce que ça devienne vrai ? Eh bien, ça a marché avec les blagues sexuelles. Après quelques blagues, j'ai arrêté de m'inquiéter."

# game/scripts/c27/c27.rpy:156
translate french c27s001_DebDate_073c9c8e:

    # deb "Empecé a verlo como la continuación de lo que hicimos en el lago. Se que es un paso más, y un paso muy importante, pero..."
    deb "J'ai commencé à le voir comme une suite de ce que nous avions fait au lac. Je sais que c'est une autre étape, et une étape très importante, mais…"

# game/scripts/c27/c27.rpy:157
translate french c27s001_DebDate_c1a5986e:

    # mc "Pero lo ves natural ahora, ¿no?"
    mc "Mais vous considérez cela comme naturel maintenant, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:159
translate french c27s001_DebDate_1fc4c21d:

    # deb "Lo veo el paso más natural del mundo. No es que no hayamos hecho cosas tórridas ya, con lo que el siguiente paso parece menos grande."
    deb "Pour moi, c'est la suite logique. Ce n'est pas qu'on n'ait pas déjà fait des choses assez osées, alors la prochaine étape me paraît moins intimidante."

# game/scripts/c27/c27.rpy:160
translate french c27s001_DebDate_8244b8f2:

    # deb "Y bromear anoche... y seguir bromeando contigo, hace que dé menos miedo."
    deb "Et plaisanter hier soir... et continuer à plaisanter avec toi, ça rend la chose moins effrayante."

# game/scripts/c27/c27.rpy:161
translate french c27s001_DebDate_0b3f517b:

    # mc "Si tienes miedo..."
    mc "Si vous avez peur..."

# game/scripts/c27/c27.rpy:163
translate french c27s001_DebDate_00f1240c:

    # deb "De lo único que tengo miedo es de hacerte daño. *Risa* ¡Mis músculos son de acero!"
    deb "La seule chose que j'ai peur, c'est de te blesser. *Rires* Mes muscles sont en acier !"

# game/scripts/c27/c27.rpy:164
translate french c27s001_DebDate_29b7bf87:

    # mc "Preciosos músculos, por cierto."
    mc "Au fait, vos muscles sont magnifiques."

# game/scripts/c27/c27.rpy:166
translate french c27s001_DebDate_1aa8bd84:

    # deb "Pero no adelantemos acontecimientos y sigamos como si fuera una cita normal. ¿Cuál es tu libro favorito?"
    deb "Mais n'allons pas trop vite et continuons comme si c'était un rendez-vous normal. Quel est ton livre préféré ?"

# game/scripts/c27/c27.rpy:167
translate french c27s001_DebDate_db8e0778:

    # mc "¡Ufff! Esa es una pregunta complicada. Hay muchísimos libros que me gustan, pero si tuviera que elegir un favorito..."
    mc "Ouf ! C'est une question difficile. J'aime tellement de livres, mais si je devais en choisir un préféré…"

# game/scripts/c27/c27.rpy:168
translate french c27s001_DebDate_38165e76:

    # mc "Seguramente sería el tercero del Círculo del Tiempo. ¿Y el tuyo?"
    mc "Ce serait probablement le troisième dans le Cercle du Temps. Et le vôtre ?"

# game/scripts/c27/c27.rpy:170
translate french c27s001_DebDate_f9ee2129:

    # deb "Yo lo tengo muy fácil. Orgullo y Prejuicio. Es el libro que me hizo amar los libros. Y por eso empecé a estudiar Literatura Inglesa."
    deb "J'ai beaucoup de chance. Orgueil et Préjugés. C'est le livre qui m'a donné le goût de la lecture. Et c'est pour ça que j'ai commencé à étudier la littérature anglaise."

# game/scripts/c27/c27.rpy:171
translate french c27s001_DebDate_3e25f0ac:

    # deb "He leído libros mejores, pero Orgullo y Prejuicio siempre tendrá un lugar especial en mi cabeza."
    deb "J'ai lu de meilleurs livres, mais Orgueil et Préjugés occupera toujours une place particulière dans mon cœur."

# game/scripts/c27/c27.rpy:172
translate french c27s001_DebDate_82b97cbd:

    # mc "Suena a una relación especial con un libro. Yo también tengo un libro así, pero en sentido opuesto."
    mc "On dirait une relation particulière avec un livre. J'ai aussi un livre comme ça, mais dans le sens inverse."

# game/scripts/c27/c27.rpy:173
translate french c27s001_DebDate_7f2176e2:

    # mc "Estadística Avanzada (III) del último año de carrera. *Risa* Odié ese libro en cada una de sus páginas."
    mc "Statistiques avancées (III) de ma dernière année d'études. *Rires* J'ai détesté ce livre du début à la fin."

# game/scripts/c27/c27.rpy:175
translate french c27s001_DebDate_2ac0b655:

    # deb "*Risa* Puedo entenderlo. Hay libros académicos que parecen ser escritos para que odies cada momento que pasas estudiando esa asignatura."
    deb "*Rires* Je comprends. Il existe des ouvrages universitaires qui semblent écrits exprès pour vous faire détester chaque instant passé à étudier le sujet."

# game/scripts/c27/c27.rpy:176
translate french c27s001_DebDate_ec400438:

    # mc "Sí, hay profesores que deberían tener prohibido escribir libros."
    mc "Oui, il y a des enseignants qui devraient être interdits d'écrire des livres."

# game/scripts/c27/c27.rpy:177
translate french c27s001_DebDate_76358196:

    # mc "Pero hablando de estudios, ¿por qué elegiste Newport?"
    mc "Mais en parlant d'études, pourquoi avoir choisi Newport ?"

# game/scripts/c27/c27.rpy:179
translate french c27s001_DebDate_9cc8bb8e:

    # deb "Después de meses de chatear con Anthony, [lis] quería venir un fin de semana a conocerlo."
    deb "Après des mois de discussions avec Anthony, [lis] voulait venir le rencontrer pour un week-end."

# game/scripts/c27/c27.rpy:180
translate french c27s001_DebDate_7acc7880:

    # deb "Cuando le dije que quería irme de Phoenix, empezó a planearlo todo para hacer el traslado aquí."
    deb "Quand je lui ai dit que je voulais quitter Phoenix, il a commencé à tout planifier pour que je déménage ici."

# game/scripts/c27/c27.rpy:181
translate french c27s001_DebDate_ce183507:

    # deb "Tienen un buen programa de Literatura Inglesa y un entrenador conocido de natación, con lo que me pareció bien."
    deb "Ils ont un bon programme de littérature anglaise et un entraîneur de natation réputé, ce qui me convenait parfaitement."

# game/scripts/c27/c27.rpy:182
translate french c27s001_DebDate_3a584d81:

    # mc "¿Cambiasteis de universidad por Anthony?"
    mc "As-tu changé d'université à cause d'Anthony ?"

# game/scripts/c27/c27.rpy:184
translate french c27s001_DebDate_18f5ef8b:

    # deb "No, Anthony fue lo que hizo que [lis] se interesara por la NWU. Es una universidad pequeña que ni siquiera conocíamos."
    deb "Non, c'est Anthony qui a suscité l'intérêt de [lis] pour NWU. C'est une petite université dont nous ignorions même l'existence."

# game/scripts/c27/c27.rpy:185
translate french c27s001_DebDate_e2c60607:

    # deb "Si no hubiera sido por él, habríamos acabado en alguna otra universidad. [lis] quería que estuviera en la costa."
    deb "Sans lui, nous serions allés dans une autre université. Il voulait que je sois sur la côte."

# game/scripts/c27/c27.rpy:186
translate french c27s001_DebDate_5f59394e:

    # deb "De todas formas, sólo nos matriculamos para el curso de verano, con lo que era una decisión poco arriesgada para probar."
    deb "De toute façon, nous ne nous sommes inscrits qu'au cours d'été, donc c'était une décision peu risquée à prendre."

# game/scripts/c27/c27.rpy:187
translate french c27s001_DebDate_0e5eaaf0:

    # mc "¿Sólo el curso de verano? Creía que os quedabais en septiembre también."
    mc "Seulement le cours d'été ? Je croyais que vous restiez aussi en septembre."

# game/scripts/c27/c27.rpy:189
translate french c27s001_DebDate_2691dc9a:

    # deb "Nos quedamos. Pero queríamos probar la universidad antes de decidir."
    deb "Nous sommes restés. Mais nous voulions tenter l'expérience universitaire avant de prendre une décision."

# game/scripts/c27/c27.rpy:190
translate french c27s001_DebDate_eda4a3fc:

    # deb "La universidad nos ha convencido lo suficiente. Y de todas formas yo no querría irme. Al menos no para volver a Phoenix."
    deb "L'université nous a suffisamment convaincus. Et puis, de toute façon, je n'ai pas envie de partir. Du moins, pas pour retourner à Phoenix."

# game/scripts/c27/c27.rpy:191
translate french c27s001_DebDate_51bef97d:

    # mc "Si quería costa, ¿cómo acabasteis en Phoenix en primer lugar?"
    mc "Si vous vouliez la côte, comment vous êtes-vous retrouvé à Phoenix au départ ?"

# game/scripts/c27/c27.rpy:193
translate french c27s001_DebDate_cef27452:

    # deb "Ella quería una universidad lejos de casa, para poder vivir su vida lejos donde nadie la conociera y lejos de la influencia de mi padre."
    deb "Elle voulait une université loin de chez elle, pour pouvoir vivre sa vie loin de tout, là où personne ne la connaissait et loin de l'influence de mon père."

# game/scripts/c27/c27.rpy:194
translate french c27s001_DebDate_284c3d14:

    # deb "Cuando me tocó elegir universidad a mí, fui con ella."
    deb "Quand ce fut mon tour de choisir une université, je suis allée avec elle."

# game/scripts/c27/c27.rpy:195
translate french c27s001_DebDate_ff408941:

    # mc "Y después de un año, decidiste que querías irte de allí. ¿El clima?"
    mc "Et au bout d'un an, vous avez décidé de partir. Le temps ?"

# game/scripts/c27/c27.rpy:197
translate french c27s001_DebDate_4f5affb8:

    # deb "No, un asistente de entrenador... demasiado cariñoso. Yo me sentía muy incómoda con él."
    deb "Non, un entraîneur adjoint… trop affectueux. Je me sentais très mal à l'aise en sa présence."

# game/scripts/c27/c27.rpy:198
translate french c27s001_DebDate_4a05a759:

    # deb "[lis] quería que lo denunciara, pero no tenía ninguna prueba, con lo que irme era lo mejor."
    deb "[lis] voulait que je le signale, mais je n'avais aucune preuve, alors partir était la meilleure chose à faire."

# game/scripts/c27/c27.rpy:199
translate french c27s001_DebDate_bc5966e7:

    # mc "Cuando dices cariñoso..."
    mc "Quand vous dites affectueux..."

# game/scripts/c27/c27.rpy:201
translate french c27s001_DebDate_deabdb51:

    # deb "Una mano que se escapa y toca donde no debe a la hora de corregir una postura. Abrazos que duran demasiado para celebrar victorias..."
    deb "Une main qui s'aventure et touche là où il ne faut pas lorsqu'on corrige une posture. Des étreintes qui s'éternisent pour célébrer les victoires…"

# game/scripts/c27/c27.rpy:202
translate french c27s001_DebDate_2bc39e06:

    # deb "Cosas así. Cosas que, visto desde fuera, pueden parecer que no son nada, pero cuando las vas sumando... te hacen sentir incómoda."
    deb "Des choses comme ça. Des choses qui, vues de l'extérieur, peuvent paraître insignifiantes, mais qui, mises bout à bout... finissent par mettre mal à l'aise."

# game/scripts/c27/c27.rpy:203
translate french c27s001_DebDate_d19a604f:

    # mc "Es normal. ¿Cómo empezó? ¿Lo hacía con otras chicas también?"
    mc "C'est normal. Comment ça a commencé ? Il l'a fait avec d'autres filles aussi ?"

# game/scripts/c27/c27.rpy:205
translate french c27s001_DebDate_e46d8acf:

    # deb "Cuando llegué, era muy simpático y me hizo sentir integrada en el equipo. Fue el primero que empezó a llamarme 'Deb'."
    deb "À mon arrivée, il a été très accueillant et m'a tout de suite mise à l'aise. Il a été le premier à m'appeler « Deb »."

# game/scripts/c27/c27.rpy:207
translate french c27s001_DebDate_ea46801a:

    # deb "Por eso me molestó cuando me lo llamaste tú. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_ea46801a
    deb "C'est pour ça que ça m'a dérangé quand tu m'as appelé comme ça. Seules ma grand-mère et [lis] m'appellent comme ça, et si quelqu'un d'autre le fait, je vais faire le lien avec cet entraîneur." id c27s001_DebDate_ea46801a

# game/scripts/c27/c27.rpy:209
translate french c27s001_DebDate_a42fff8c:

    # deb "Por eso no me gusta que me llamen así. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_a42fff8c
    deb "C'est pour ça que je n'aime pas qu'on m'appelle comme ça. Seules ma grand-mère et [lis] m'appellent ainsi, et si quelqu'un d'autre le fait, je vais faire le lien avec cet entraîneur." id c27s001_DebDate_a42fff8c

# game/scripts/c27/c27.rpy:211
translate french c27s001_DebDate_554cc2f4:

    # deb "Poco a poco la cosa se fue poniendo más incómoda, pero como veía que con algunas de las otras chicas hacía lo mismo, pensé que era normal."
    deb "Petit à petit, la situation est devenue de plus en plus gênante, mais comme j'ai vu qu'il faisait la même chose avec d'autres filles, j'ai pensé que c'était normal."

# game/scripts/c27/c27.rpy:212
translate french c27s001_DebDate_7148f2b7:

    # deb "A ellas no parecía importarles. Era guapo y ellas se lo consentían. Pero a mí me molestaba. Intenté hablarlo con él, pero negó estar haciendo nada incorrecto."
    deb "Ça ne semblait pas les déranger. Il était beau, et ils ont fermé les yeux. Mais ça me tracassait. J'ai essayé de lui en parler, mais il a nié avoir mal agi."

# game/scripts/c27/c27.rpy:213
translate french c27s001_DebDate_3dbcc7d5:

    # mc "Y decidiste irte. Si puedo hacer algo..."
    mc "Et vous avez décidé de partir. S'il y a quoi que ce soit que je puisse faire..."

# game/scripts/c27/c27.rpy:215
translate french c27s001_DebDate_7e4b3d06:

    # deb "Gracias, pero no. Yéndome ha quedado resuelto."
    deb "Merci, mais non. Le fait de quitter l'application a résolu le problème."

# game/scripts/c27/c27.rpy:216
translate french c27s001_DebDate_b9d7f0f7:

    # deb "Mis tiempos se resintieron. No iba a gusto a entrenar y se notaba. En dos años hay Juegos Olímpicos en París y me gustaría estar ahí."
    deb "Mes performances ont chuté. Je ne prenais aucun plaisir à l'entraînement, et ça se voyait. Les Jeux olympiques sont à Paris dans deux ans, et j'aimerais y participer."

# game/scripts/c27/c27.rpy:217
translate french c27s001_DebDate_2faf6ea9:

    # deb "Al menos intentarlo. Si seguía en Phoenix no iba a poder hacerlo. Con lo que el cambio es bienvenido."
    deb "Au moins, j'ai essayé. Si j'étais resté à Phoenix, je n'aurais pas pu. Ce changement est donc le bienvenu."

# game/scripts/c27/c27.rpy:218
translate french c27s001_DebDate_07b6ae05:

    # mc "¿Juegos Olímpicos? Entonces [sim] tenía razón. ¡Eres buenísima!"
    mc "Les Jeux olympiques ? Alors [sim] avait raison. Tu es incroyable !"

# game/scripts/c27/c27.rpy:220
translate french c27s001_DebDate_59776c96:

    # deb "Ahora mismo no me clasificaría, pero si trabajo duro... Tengo una posibilidad. Quedan casi dos años para los Trials y sólo necesitaría unos meses para ponerme en forma."
    deb "Pour l'instant, je ne serais pas qualifié, mais si je m'entraîne dur… j'ai une chance. Il reste presque deux ans avant les sélections et il me suffirait de quelques mois pour être en forme."

# game/scripts/c27/c27.rpy:221
translate french c27s001_DebDate_0cf8fd2b:

    # deb "Si Dara Vollmer y Dana Torres pudieron ganar medallas en las olimpiadas después de dar a luz... "
    deb "Si Dara Vollmer et Dana Torres avaient pu remporter des médailles aux Jeux olympiques après avoir accouché..."

# game/scripts/c27/c27.rpy:222
translate french c27s001_DebDate_36a2a20e:

    # mc "No sé quiénes son. Supongo que nadadoras que han tenido hijos."
    mc "Je ne sais pas qui ils sont. Je suppose que ce sont des nageurs qui ont eu des enfants."

# game/scripts/c27/c27.rpy:224
translate french c27s001_DebDate_921c2fc2:

    # deb "Sí, las dos compitieron después de sus embarazos y las dos ganaron medallas en las olimpiadas. En Pekín y en Rio."
    deb "Oui, toutes deux ont repris la compétition après leur grossesse et ont remporté des médailles olympiques. À Pékin et à Rio."

# game/scripts/c27/c27.rpy:225
translate french c27s001_DebDate_6345e182:

    # deb "Pero claro, ellas eran mejores de lo que yo soy ahora antes de quedarse embarazadas..."
    deb "Mais bien sûr, elles étaient en meilleure forme que moi avant de tomber enceintes..."

# game/scripts/c27/c27.rpy:226
translate french c27s001_DebDate_a6de434a:

    # mc "Te iba a preguntar si querías tener hijos, pero viendo que has investigado..."
    mc "J'allais vous demander si vous vouliez avoir des enfants, mais vu que vous avez déjà fait vos recherches..."

# game/scripts/c27/c27.rpy:231
translate french c27s001_DebDate_80342353:

    # deb "Todas las que se han hecho la prueba han salido positivas. Eso significa que quieres tener muchos hijos."
    deb "Tous les tests effectués se sont révélés positifs. Cela signifie que vous voulez avoir beaucoup d'enfants."

# game/scripts/c27/c27.rpy:232
translate french c27s001_DebDate_b32708d1:

    # deb "No me gustaría ser la única con la que no los tienes."
    deb "Je ne voudrais pas être le seul avec qui tu ne les as pas."

# game/scripts/c27/c27.rpy:234
translate french c27s001_DebDate_87cec64c:

    # deb "Sabiendo que quieres tener hijos, me gustaría que los tuviéramos."
    deb "Sachant que tu désires avoir des enfants, je souhaite que nous en ayons."

# game/scripts/c27/c27.rpy:236
translate french c27s001_DebDate_0ccba3b9:

    # deb "No sé si quieres tener hijos o no, pero a mí no me importaría."
    deb "Je ne sais pas si vous souhaitez avoir des enfants ou non, mais cela ne me dérangerait pas."

# game/scripts/c27/c27.rpy:237
translate french c27s001_DebDate_5e145226:

    # deb "Dentro de un año me afectaría más para mi carrera de nadadora. Si los quieres tener, ahora o justo después de unas olimpiadas serían los mejores momentos."
    deb "Dans un an, cela aurait un impact plus important sur ma carrière de nageur. Si vous souhaitez les faire, le meilleur moment serait maintenant ou juste après les Jeux olympiques."

# game/scripts/c27/c27.rpy:238
translate french c27s001_DebDate_da88ba8b:

    # mc "No había pensado en cómo te podría afectar en tu carrera. Me gusta que lo hayas hecho tú por los dos."
    mc "Je n'avais pas pensé à l'impact que cela pourrait avoir sur ta carrière. Je suis content que tu l'aies fait pour nous deux."

# game/scripts/c27/c27.rpy:240
translate french c27s001_DebDate_7b849e5f:

    # deb "Sé que quizás suene muy frío dicho así, pero uno de mis sueños es participar en unas olimpiadas. Y no quiero renunciar a él."
    deb "Je sais que dit comme ça, ça peut paraître froid, mais participer aux Jeux olympiques est un de mes rêves. Et je ne veux pas y renoncer."

# game/scripts/c27/c27.rpy:241
translate french c27s001_DebDate_2c0460ba:

    # mc "No te preocupes. No me ha sonado frío. Son cosas en las que, los que sólo hacemos deporte en los videojuegos, no solemos pensar."
    mc "Ne t'inquiète pas. Ça ne m'a pas paru froid. Ce sont des choses auxquelles ceux d'entre nous qui ne pratiquent le sport que dans les jeux vidéo ne pensent généralement pas."

# game/scripts/c27/c27.rpy:242
translate french c27s001_DebDate_5543d3d8:

    # mc "Y, teniendo todo el tiempo del mundo para tener hijos, no tienes por qué renunciar a tus sueños."
    mc "Et, ayant tout le temps du monde pour avoir des enfants, vous n'êtes pas obligée de renoncer à vos rêves."

# game/scripts/c27/c27.rpy:243
translate french c27s001_DebDate_0d4449b2:

    # mc "Lo que me extraña es tu elección de estudios. ¿Literatura Inglesa en vez de algo relacionado con el deporte?"
    mc "Ce qui me surprend, c'est votre choix d'études. La littérature anglaise plutôt qu'un domaine lié au sport ?"

# game/scripts/c27/c27.rpy:245
translate french c27s001_DebDate_670ba289:

    # deb "Mi segunda opción era Ciencias del Deporte, pero no estaba segura de si querría dedicarme a entrenar a otras nadadoras cuando dejase de nadar."
    deb "Mon deuxième choix était les sciences du sport, mais je n'étais pas sûre de vouloir me consacrer à l'entraînement d'autres nageurs une fois que j'aurais arrêté de nager."

# game/scripts/c27/c27.rpy:246
translate french c27s001_DebDate_94666eeb:

    # deb "Sería una forma de seguir ligada al mundo de la natación, pero aún no estoy segura de querer hacerlo."
    deb "Ce serait une façon de rester en contact avec le monde de la natation, mais je ne suis toujours pas sûre de vouloir le faire."

# game/scripts/c27/c27.rpy:247
translate french c27s001_DebDate_5fde71bc:

    # mc "¿Prefieres ser una profesora de literatura en un instituto?"
    mc "Préféreriez-vous être professeur de littérature dans un lycée ?"

# game/scripts/c27/c27.rpy:249
translate french c27s001_DebDate_7f8f4c84:

    # deb "*Risa* Dudo que alguna vez pueda ser profesora de instituto. Los alumnos me tomarían el pelo. Hay que ser más dura de lo que soy yo para manejar un grupo de 20 adolescentes."
    deb "*Rires* Je doute que je puisse un jour être professeur de lycée. Les élèves se moqueraient de moi. Il faut être bien plus coriace que moi pour gérer un groupe de 20 adolescents."

# game/scripts/c27/c27.rpy:250
translate french c27s001_DebDate_b197bbe0:

    # deb "Elegí la carrera porque me encanta la literatura, no para ejercer. Ya sabes..."
    deb "J'ai choisi ces études parce que j'aime la littérature, pas pour travailler dans ce domaine. Vous savez..."

# game/scripts/c27/c27.rpy:251
translate french c27s001_DebDate_6862479b:

    # mc "Sí, dinero viejo y falta de necesidad de trabajar."
    mc "Oui, de l'argent de vieille génération et pas besoin de travailler."

# game/scripts/c27/c27.rpy:253
translate french c27s001_DebDate_2575181e:

    # deb "Mas o menos. No somos dinero MUY viejo, pero lo suficiente. A principios del siglo pasado mi tatarabuelo era un pequeño granjero en Aurora."
    deb "Plus ou moins. Nous ne sommes pas issus d'une famille très fortunée, mais suffisamment. Au début du siècle dernier, mon arrière-arrière-grand-père était un petit agriculteur à Aurora."

# game/scripts/c27/c27.rpy:254
translate french c27s001_DebDate_06f581e8:

    # mc "De granjero a familia rica..."
    mc "De paysan à famille riche..."

# game/scripts/c27/c27.rpy:256
translate french c27s001_DebDate_989e8c07:

    # deb "En la Gran Depresión y durante el Dust Bowl compró un montón de tierras a bajo precio en Illinois y Missouri. También algunas minas de plomo."
    deb "Pendant la Grande Dépression et le Dust Bowl, il acheta de nombreuses terres à bas prix dans l'Illinois et le Missouri. Il acquit également des mines de plomb."

# game/scripts/c27/c27.rpy:257
translate french c27s001_DebDate_3a0c2978:

    # deb "Él y mi bisabuelo diversificaron la fortuna durante la Segunda Guerra Mundial. Industria, investigación, contratos con el ejército..."
    deb "Mon arrière-grand-père et lui ont diversifié leurs activités pendant la Seconde Guerre mondiale : industrie, recherche, contrats avec l’armée…"

# game/scripts/c27/c27.rpy:258
translate french c27s001_DebDate_98584c64:

    # deb "Nunca he sabido la lista completa de empresas en las que tenemos participación. Ni me interesa."
    deb "Je n'ai jamais connu la liste complète des entreprises dans lesquelles nous détenons des parts. Et cela ne m'intéresse pas."

# game/scripts/c27/c27.rpy:259
translate french c27s001_DebDate_049fbf8d:

    # mc "Supongo que tiene que ser complicado."
    mc "J'imagine que ça doit être compliqué."

# game/scripts/c27/c27.rpy:261
translate french c27s001_DebDate_8d14cd96:

    # deb "Complicado y aburrido. Nunca me ha interesado el dinero. Quizás porque nunca me ha faltado."
    deb "Compliqué et ennuyeux. L'argent ne m'a jamais intéressé. Peut-être parce que je n'en ai jamais manqué."

# game/scripts/c27/c27.rpy:262
translate french c27s001_DebDate_e38dd30a:

    # deb "A [lis], aunque tampoco le interese, siempre le ha gustado más todo lo que rodea el dinero. Alta sociedad, famosos, y todo eso."
    deb "A, bien que cela ne l'intéresse pas non plus, a toujours aimé tout ce qui touche à l'argent : la haute société, les célébrités, et tout ça."

# game/scripts/c27/c27.rpy:263
translate french c27s001_DebDate_f43cd1ef:

    # deb "Pero a mí no. El dinero tiene que servir para cubrir las necesidades propias y de la familia."
    deb "Mais pas pour moi. L'argent doit servir à subvenir à ses propres besoins et à ceux de sa famille."

# game/scripts/c27/c27.rpy:264
translate french c27s001_DebDate_a94459db:

    # mc "Es normal. En el fondo es para lo único que sirve. Una vez cubiertas las necesidades, el resto son caprichos."
    mc "C'est normal. Au fond, ça ne sert à rien d'autre. Une fois vos besoins satisfaits, tout le reste n'est que caprice."

# game/scripts/c27/c27.rpy:266
translate french c27s001_DebDate_de64881b:

    # deb "Por suerte, mis caprichos son relativamente baratos. *Risa* Libros, videojuegos, música..."
    deb "Heureusement, mes petits plaisirs sont relativement peu coûteux. *Rires* Livres, jeux vidéo, musique…"

# game/scripts/c27/c27.rpy:267
translate french c27s001_DebDate_f92bf164:

    # mc "Hemos hablado de libros y videojuegos, pero nunca de música. ¿Qué música te gusta?"
    mc "Nous avons parlé de livres et de jeux vidéo, mais jamais de musique. Quel genre de musique aimes-tu ?"

# game/scripts/c27/c27.rpy:268
translate french c27s001_DebDate_02794b27:

    # deb "Tengo gustos muy variados y que [lis] dice que no pegan demasiado. Pop, Folk, Blues, Metal, Rock, Clásica..."
    deb "J'ai des goûts très variés, et [lis] dit qu'ils ne vont pas vraiment ensemble. Pop, folk, blues, métal, rock, classique…"

# game/scripts/c27/c27.rpy:269
translate french c27s001_DebDate_b12523bf:

    # mc "*Risa* Es cierto que no pegan demasiado."
    mc "*Rires* C'est vrai qu'ils ne vont pas vraiment ensemble."

# game/scripts/c27/c27.rpy:271
translate french c27s001_DebDate_549d5b2a:

    # deb "*Risa* Imagíname con una peluca barroca haciendo así. ¡Yeahhh!"
    deb "*Rires* Imaginez-moi avec une perruque baroque en train de faire ça. Ouais !"

# game/scripts/c27/c27.rpy:272
translate french c27s001_DebDate_34fc4868:

    # mc "*Risa* Puedo hacerlo. Además, oliendo a pachuli, con un bolso de diseño y con una chaqueta de cuero."
    mc "*Rires* Je peux le faire. En plus, je sentirai le patchouli, j'aurai un sac de créateur et une veste en cuir."

# game/scripts/c27/c27.rpy:274
translate french c27s001_DebDate_b01b50cd:

    # deb "¡Ni siquiera yo iría así! *Risa* ¡[lis] no me dejaría salir de mi habitación! Bueno, de nuestra habitación."
    deb "Même moi, je n'aurais pas fait ça ! *Rires* [lis] Il ne me laissait pas sortir de ma chambre ! Enfin, de notre chambre."

# game/scripts/c27/c27.rpy:275
translate french c27s001_DebDate_d4dec132:

    # deb "Pero sea la música que sea, me gusta escucharla, no bailarla."
    deb "Mais quelle que soit la musique, j'aime l'écouter, pas danser dessus."

# game/scripts/c27/c27.rpy:276
translate french c27s001_DebDate_9ccbcedc:

    # mc "Bueno, en el Jazz Corner bailamos."
    mc "Eh bien, nous avons dansé au Jazz Corner."

# game/scripts/c27/c27.rpy:278
translate french c27s001_DebDate_c56d3f1b:

    # deb "No bailamos. Me hiciste volar."
    deb "Nous n'avons pas dansé. Tu m'as donné l'impression de voler."

# game/scripts/c27/c27.rpy:279
translate french c27s001_DebDate_6f9af9ef:

    # mc "La próxima vez te dejaré poner los pies en el suelo."
    mc "La prochaine fois, je te laisserai poser les pieds sur terre."

# game/scripts/c27/c27.rpy:280
translate french c27s001_DebDate_4c81d3ec:

    # deb "¿A riesgo de que te pise?"
    deb "Au risque de se faire marcher dessus ?"

# game/scripts/c27/c27.rpy:281
translate french c27s001_DebDate_d65ffcb1:

    # mc "Aceptaré ese riesgo. Aunque dudo que lo hagas. Deberías tener más seguridad en ti misma."
    mc "Je prendrai ce risque. Même si je doute que vous le fassiez. Vous devriez avoir davantage confiance en vous."

# game/scripts/c27/c27.rpy:282
translate french c27s001_DebDate_047876a6:

    # mc "No eres [kim] y no vas a tropezarte con tus propios pies. Y ni siquiera ella me pisó."
    mc "Tu n'es pas [kim] et tu ne vas pas trébucher sur tes propres pieds. Et elle ne m'a même pas marché dessus."

# game/scripts/c27/c27.rpy:284
translate french c27s001_DebDate_0359da27:

    # deb "¡No te metas con [kim]! Yo sería incapaz de andar por una pasarela como lo hace ella."
    deb "Ne vous frottez pas à [kim] ! Je serais incapable de défiler comme elle."

# game/scripts/c27/c27.rpy:285
translate french c27s001_DebDate_98cbb0ea:

    # mc "No me estoy metiendo con ella. *Risa* Tan solo estoy haciendo una constatación de hechos."
    mc "Je ne me moque pas d'elle. *Rires* Je ne fais que constater un fait."

# game/scripts/c27/c27.rpy:287
translate french c27s001_DebDate_be4b8545:

    # deb "*Risita* Se puede tropezar con su sombra, ¿verdad?"
    deb "*Rires* On peut trébucher sur sa propre ombre, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:288
translate french c27s001_DebDate_f0a2a5b5:

    # mc "*Risa* Aún no la he visto hacerlo, pero estoy seguro de que sería capaz."
    mc "*Rires* Je ne l'ai pas encore vue le faire, mais je suis sûre qu'elle en serait capable."

# game/scripts/c27/c27.rpy:289
translate french c27s001_DebDate_d9213a52:

    # mc "Tan solo estoy diciendo que si alguien como ella puede reunir la confianza para subirse a una pasarela, tu deberías reunirla para bailar."
    mc "Je dis simplement que si une personne comme elle peut avoir l'assurance nécessaire pour défiler sur un podium, vous devriez pouvoir avoir l'assurance nécessaire pour danser."

# game/scripts/c27/c27.rpy:290
translate french c27s001_DebDate_8a7979ea:

    # mc "Creo que tienes más miedo a lo que pensarán los que te vean que a pisarme."
    mc "Je crois que vous avez plus peur de ce que les gens vont penser que de me marcher dessus."

# game/scripts/c27/c27.rpy:292
translate french c27s001_DebDate_78d7344c:

    # deb "Un poco... No tengo demasiado ritmo..."
    deb "Un peu... Je n'ai pas beaucoup de rythme..."

# game/scripts/c27/c27.rpy:293
translate french c27s001_DebDate_ddc9e81a:

    # mc "Pues aprovechando que te gustan los libros. Mark Twain dijo algo de lo que puedes aprender."
    mc "Puisque vous aimez les livres, Mark Twain a dit quelque chose dont vous pouvez tirer des leçons."

# game/scripts/c27/c27.rpy:294
translate french c27s001_DebDate_0e187ff3:

    # mc "Tienes que bailar como si nadie te estuviera mirando, amar como si nunca te fueran a hacer daño, cantar como si nadie te estuviera escuchando y... algo más."
    mc "Il faut danser comme si personne ne regardait, aimer comme si on ne risquait jamais d'être blessé, chanter comme si personne n'écoutait et... encore autre chose."

# game/scripts/c27/c27.rpy:296
translate french c27s001_DebDate_2780dfb9:

    # deb "...y vivir como si estuvieras en el cielo."
    deb "...et vivez comme si vous étiez au paradis."

# game/scripts/c27/c27.rpy:297
translate french c27s001_DebDate_6b540cb0:

    # deb "Lo segundo ya lo hago. Sé que no me vas a hacer daño. Lo del cielo... no soy creyente."
    deb "Je fais déjà la deuxième chose. Je sais que tu ne me feras pas de mal. Quant au paradis… je ne crois pas."

# game/scripts/c27/c27.rpy:298
translate french c27s001_DebDate_a833f795:

    # mc "Pues hay que trabajar en el resto. Un día iremos tú y yo solos a bailar. A un sitio donde nadie te conozca."
    mc "Bon, il nous reste le reste à régler. Un jour, toi et moi irons danser, tous les deux. Dans un endroit où personne ne te connaît."

# game/scripts/c27/c27.rpy:299
translate french c27s001_DebDate_4f2b6878:

    # mc "Así, aunque te miren, dará lo mismo. ¿Qué te importa lo que piensen personas a las que no conoces?"
    mc "Alors, même s'ils vous fixent du regard, ça n'aura aucune importance. Qu'est-ce que ça peut bien vous faire ce que pensent des inconnus ?"

# game/scripts/c27/c27.rpy:300
translate french c27s001_DebDate_ffaf1105:

    # mc "Yo estaré mirándote a los ojos, con lo que no sabré si bailas bien o mal. Ni me importará."
    mc "Je te regarderai droit dans les yeux, donc je ne saurai pas si tu danses bien ou mal. Et ça m'est égal."

# game/scripts/c27/c27.rpy:302
translate french c27s001_DebDate_128a2e45:

    # deb "¿Dónde has estado toda mi vida, [mc]?"
    deb "Où étais-tu passé pendant tout ce temps, [mc] ?"

# game/scripts/c27/c27.rpy:303
translate french c27s001_DebDate_08f4e540:

    # mc "Esperando que vinieras a Newport."
    mc "En espérant que vous viendrez à Newport."

# game/scripts/c27/c27.rpy:304
translate french c27s001_DebDate_65c76376:

    # mc "Y cuando resolvamos lo de bailar, lo siguiente será un karaoke."
    mc "Et une fois qu'on aura réglé le problème de la danse, la prochaine étape sera le karaoké."

# game/scripts/c27/c27.rpy:306
translate french c27s001_DebDate_7e1a98b6:

    # deb "¡No! *Risa* ¡Eso no, por favor!"
    deb "Non ! *Rires* Pas ça, s'il vous plaît !"

# game/scripts/c27/c27.rpy:307
translate french c27s001_DebDate_16262c90:

    # deb "Una cosa es que no me veas bailar si estás mirándome a los ojos. Pero no vas a poder evitar escuchar lo mal que canto si vamos a un karaoke."
    deb "C'est une chose de ne pas me voir danser tout en me regardant dans les yeux. Mais vous ne pourrez pas éviter d'entendre à quel point je chante mal si nous allons au karaoké."

# game/scripts/c27/c27.rpy:308
translate french c27s001_DebDate_b77a7ca3:

    # mc "¿Tan mal cantas?"
    mc "Tu chantes si mal que ça ?"

# game/scripts/c27/c27.rpy:309
translate french c27s001_DebDate_78e4296c:

    # deb "Digamos que, si canto en la ducha, el champú se suicida. *Risa* No quiero torturar a nadie."
    deb "Disons simplement que si je chante sous la douche, le shampoing se suicide. *Rires* Je ne veux faire souffrir personne."

# game/scripts/c27/c27.rpy:310
translate french c27s001_DebDate_f0a4f26d:

    # mc "Entonces tendremos que hablar con [meg] para que te dé clases de canto."
    mc "Ensuite, nous devrons parler à [meg] pour qu'il puisse te donner des cours de chant."

# game/scripts/c27/c27.rpy:312
translate french c27s001_DebDate_c011313a:

    # deb "¿Sabes de lo que me acabo de dar cuenta?"
    deb "Sais-tu ce que je viens de réaliser ?"

# game/scripts/c27/c27.rpy:313
translate french c27s001_DebDate_1a6ca3d7:

    # mc "¿De qué?"
    mc "À propos de quoi?"

# game/scripts/c27/c27.rpy:314
translate french c27s001_DebDate_238eeee4:

    # deb "Esto no se parece a la típica cita de las películas."
    deb "Ce n'est pas une citation de film typique."

# game/scripts/c27/c27.rpy:315
translate french c27s001_DebDate_7cf3844e:

    # mc "¿Decepcionada?"
    mc "Déçu?"

# game/scripts/c27/c27.rpy:317
translate french c27s001_DebDate_4889e93c:

    # deb "Todo lo contrario. Es mucho mejor. Estamos hablando de un montón de cosas y no estoy nada nerviosa."
    deb "Tout le contraire. C'est bien mieux. On parle de plein de choses et je ne suis pas du tout nerveuse."

# game/scripts/c27/c27.rpy:318
translate french c27s001_DebDate_5e890471:

    # mc "¿Por qué ibas a estar nerviosa? Tan solo estamos comiendo y charlando. Conociéndonos mejor."
    mc "Pourquoi serais-tu nerveux ? On mange et on discute, c'est tout. On apprend à mieux se connaître."

# game/scripts/c27/c27.rpy:319
translate french c27s001_DebDate_0e6ff9a9:

    # deb "Precisamente por eso. Todo es muy natural. Creía que iba a ser una situación tensa... ya sabes... por lo que vendrá después."
    deb "C'est exactement pour ça. C'est tout à fait naturel. Je pensais que la situation allait être tendue… vous savez… à cause de ce qui allait suivre."

# game/scripts/c27/c27.rpy:320
translate french c27s001_DebDate_d4207e8d:

    # mc "No he pensado ni por un momento en lo que vendrá después, [deb.nick]. Estoy disfrutando de cada minuto de esta comida contigo."
    mc "Je n'ai pas pensé un seul instant à ce qui va se passer ensuite, [deb.nick]. Je savoure chaque minute de ce repas avec toi."

# game/scripts/c27/c27.rpy:322
translate french c27s001_DebDate_62daf288:

    # deb "Yo lo he pensado un par de veces, pero consigues que se me olvide. Es como estar comiendo... con un amigo..."
    deb "J'y ai pensé à plusieurs reprises, mais tu me le fais oublier. C'est comme manger… avec un ami…"

# game/scripts/c27/c27.rpy:323
translate french c27s001_DebDate_e89958f6:

    # mc "*Fingiendo sorpresa* ¿Ya no soy tu novio? *Risa*"
    mc "*Feignant la surprise* Je ne suis plus ton petit ami ? *Rires*"

# game/scripts/c27/c27.rpy:324
translate french c27s001_DebDate_acac9f02:

    # mc "Hablando en serio, en eso consiste una cita. Creo que fuimos amigos antes que pareja, y eso no se debe perder."
    mc "Franchement, c'est ça un rendez-vous. Je crois qu'on était amis avant d'être en couple, et c'est quelque chose qu'on ne doit pas perdre."

# game/scripts/c27/c27.rpy:325
translate french c27s001_DebDate_10fcd32c:

    # mc "No hay que estar hablando de amor y sentimientos todo el día, aunque suene poco romántico."
    mc "Vous n'êtes pas obligé de parler d'amour et de sentiments toute la journée, même si cela peut paraître peu romantique."

# game/scripts/c27/c27.rpy:327
translate french c27s001_DebDate_65999903:

    # deb "Prefiero esto al romanticismo impostado. Para eso están los libros y los videojuegos."
    deb "Je préfère cela à un romantisme artificiel. Pour cela, il y a les livres et les jeux vidéo."

# game/scripts/c27/c27.rpy:328
translate french c27s001_DebDate_1bde9f70:

    # deb "Esto es más natural, más... auténtico. Pero no por ello menos sexy."
    deb "C'est plus naturel, plus... authentique. Mais pas moins sexy pour autant."

# game/scripts/c27/c27.rpy:329
translate french c27s001_DebDate_8abd0f2e:

    # deb "En realidad has estado hablando de amor todo el rato, interesándote por mí, queriendo llevarme a bailar..."
    deb "En fait, tu n'as fait que parler d'amour tout ce temps, tu t'es intéressé à moi, tu voulais m'emmener danser..."

# game/scripts/c27/c27.rpy:330
translate french c27s001_DebDate_8aba94ec:

    # deb "Si llevase bragas, las tendría mojadas después de todo lo que has dicho hoy."
    deb "Si je portais une culotte, elle serait trempée après tout ce que tu as dit aujourd'hui."

# game/scripts/c27/c27.rpy:332
translate french c27s001_DebDate_c5a6879d:

    # mc "*Susurrando* ¿No llevas bragas? Antes has dicho que estabas en modo travieso. Ahora me lo creo del todo."
    mc "*Chuchotant* Tu ne portes pas de culotte ? Tu as dit tout à l'heure que tu étais d'humeur coquine. Maintenant, je te crois totalement."

# game/scripts/c27/c27.rpy:334
translate french c27s001_DebDate_ad38a363:

    # deb "Bueno, este vestido transparenta un poco dependiendo de cómo le dé la luz. [kim] y [lis] me han recomendado no llevarlas."
    deb "Eh bien, cette robe est un peu transparente selon la lumière. [kim] et [lis] m'ont conseillé de ne pas les porter."

# game/scripts/c27/c27.rpy:335
translate french c27s001_DebDate_391e4a3f:

    # deb "Además, han dicho que así habrá menos estorbos luego."
    deb "De plus, ils ont affirmé que cela créerait moins d'obstacles par la suite."

# game/scripts/c27/c27.rpy:337
translate french c27s001_DebDate_3ccfc812:

    # deb "He estado de acuerdo con ellas. *Risita* Lo de no llevar sujetador ha sido idea mía."
    deb "J'étais d'accord avec elles. *Rires* L'idée de ne pas porter de soutien-gorge venait de moi."

# game/scripts/c27/c27.rpy:338
translate french c27s001_DebDate_94f623d6:

    # mc "Es decir... ¿me estás diciendo que estás desnuda debajo de ese ligero vestido?"
    mc "Alors… vous êtes en train de me dire que vous êtes nue sous cette robe légère ?"

# game/scripts/c27/c27.rpy:339
translate french c27s001_DebDate_d913fd69:

    # mc "¿Sabes que ahora voy a ser yo el que no va a poder dejar de pensar en lo que pasará después?"
    mc "Sais-tu que maintenant, je vais être celle qui ne cessera de penser à ce qui va se passer ensuite ?"

# game/scripts/c27/c27.rpy:341
translate french c27s001_DebDate_a5f63b9b:

    # deb "*Risa* Creo que ha sido un error decírtelo. Ahora no vamos a poder dejar de pensar ninguno de los dos en eso."
    deb "*Rires* Je crois que c'était une erreur de te le dire. Maintenant, aucun de nous deux ne pourra s'empêcher d'y penser."

# game/scripts/c27/c27.rpy:342
translate french c27s001_DebDate_b4a350df:

    # mc "A menos que reconduzcamos la conversación."
    mc "À moins que nous ne réorientions la conversation."

# game/scripts/c27/c27.rpy:344
translate french c27s001_DebDate_a2956840:

    # "[deb.nick] mira a todos lados para comprobar que nadie os está mirando."
    "[deb.nick] Regardez autour de vous pour vous assurer que personne ne vous observe."

# game/scripts/c27/c27.rpy:346
translate french c27s001_DebDate_9702315b:

    # deb "¿Estás seguro de que quieres que reconduzcamos la conversación?"
    deb "Êtes-vous sûr(e) de vouloir que nous redirigeions la conversation ?"

# game/scripts/c27/c27.rpy:347
translate french c27s001_DebDate_dc44bf7c:

    # mc "¡Eso es injusto! *Risa* ¡Ahora voy a tener que pedir la cuenta y nos vamos a quedar sin postre!"
    mc "C'est injuste ! *Rires* Maintenant, je vais devoir demander l'addition et on va rater le dessert !"

# game/scripts/c27/c27.rpy:349
translate french c27s001_DebDate_c8dcb238:

    # deb "Nunca he sido de esas personas a las que les importa mucho el postre. Al menos hasta que empecé a probar los de [mar]."
    deb "Je n'ai jamais été du genre à accorder beaucoup d'importance aux desserts. Du moins, pas avant de commencer à goûter ceux de [mar]."

# game/scripts/c27/c27.rpy:350
translate french c27s001_DebDate_38add229:

    # deb "Por muy buena que esté la comida aquí, creo que esa abuela italiana no está al mismo nivel que [mar]."
    deb "Même si la nourriture est excellente ici, je ne pense pas que la grand-mère italienne soit au même niveau que [mar]."

# game/scripts/c27/c27.rpy:352
translate french c27s001_DebDate_7a0e4b54:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que mi madre si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Rires* Je doute qu'il y ait beaucoup de gens aussi doués que ma mère en matière de desserts. Même pas [sam] ou [nor], pourtant j'adore leurs desserts."

# game/scripts/c27/c27.rpy:354
translate french c27s001_DebDate_e269bf6f:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que [mar] si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Rires* Je doute qu'il y ait beaucoup de gens au même niveau que [mar] en matière de desserts. Pas même [sam] ou [nor], pourtant j'adore leurs desserts."

# game/scripts/c27/c27.rpy:355
translate french c27s001_DebDate_6071fd30:

    # mc "¿Pido la cuenta, entonces?"
    mc "Dois-je demander l'addition, alors ?"

# game/scripts/c27/c27.rpy:357
translate french c27s001_DebDate_b61664cf:

    # deb "Creía que ya la habrías pedido a estas alturas..."
    deb "Je pensais que tu l'aurais commandé depuis le temps..."

# game/scripts/c27/c27.rpy:359
translate french c27s001_DebDate_d7e2a6ff:

    # "Pides la cuenta, que tardan lo que te parece una eternidad en traer."
    "Vous demandez l'addition, qui met une éternité à arriver."

# game/scripts/c27/c27.rpy:360
translate french c27s001_DebDate_8c5b91a0:

    # "Por suerte, el camarero viene con el datáfono, ahorrándoos unos interminables segundos de espera por un segundo viaje."
    "Heureusement, le serveur est équipé d'un lecteur de cartes, ce qui vous évite de longues secondes d'attente pour un deuxième passage."

# game/scripts/c27/c27.rpy:361
translate french c27s001_DebDate_97bb0187:

    # "Dejas una generosa propina y os marcháis."
    "Vous laissez un pourboire généreux et vous partez."

# game/scripts/c27/c27.rpy:364
translate french c27s001_DebDate_f7db6f75:

    # "El viaje a casa se hace raro. ¿Ha estado siempre tan lejos tu casa del centro de la ciudad?"
    "Le retour à la maison me paraît étrange. Ta maison a-t-elle toujours été aussi loin du centre-ville ?"

# game/scripts/c27/c27.rpy:373
