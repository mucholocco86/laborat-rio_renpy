# game/scripts/c27/c27.rpy:3839
translate french c27s008_Oma_028b112c:

    # mc "¿Me vas a dejar comerme al Yeti?"
    mc "Tu vas me laisser manger le Yéti ?"

# game/scripts/c27/c27.rpy:3840
translate french c27s008_Oma_ba7c94e4:

    # oma "Después de todo lo bueno que me han dicho [sai] y [eil] sobre tu lengua, creo que estoy preparada para probarlo."
    oma "Après tout ce que [sai] et [eil] m'ont dit de bien sur votre langue, je pense que je suis prêt à l'essayer."

# game/scripts/c27/c27.rpy:3841
translate french c27s008_Oma_8d99c66b:

    # mc "Entonces ven aquí arriba... aún estoy encadenado, ¿no?"
    mc "Alors viens ici... Je suis toujours enchaîné, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:3843
translate french c27s008_Oma_e9d90752:

    # oma "*Risa* ¡Por supuesto que estás encadenado! No dejarás de estarlo hasta que te lo diga."
    oma "*Rires* Bien sûr que tu es enchaîné ! Tu ne seras pas détaché tant que je ne te le dirai pas."

# game/scripts/c27/c27.rpy:3844
translate french c27s008_Oma_c4656008:

    # mc "*Risa* No me arriesgaré a que saques 'la chancla'. Voy a seguir encadenado."
    mc "*Rires* Je ne prendrai pas le risque que tu sortes « la pantoufle ». Je reste enchaîné."

# game/scripts/c27/c27.rpy:3846
translate french c27s008_Oma_f59d97d2:

    # oma "*Risa* ¿'La chancla'? ¡Esa es el arma de destrucción masiva que usan las madres latinas!"
    oma "*Rires* « La sandale » ? C'est l'arme de destruction massive que les mères latines utilisent !"

# game/scripts/c27/c27.rpy:3847
translate french c27s008_Oma_7c1fc9f1:

    # oma "Aún le tengo miedo a la chancla de mi madre."
    oma "J'ai toujours peur de la sandale de ma mère."

# game/scripts/c27/c27.rpy:3849
translate french c27s008_Oma_123b9076:

    # mc "Y vas a ser una madre latina preciosa. Y temible con 'la chancla'."
    mc "Et tu seras une magnifique maman latine. Et redoutable avec la sandale."

# game/scripts/c27/c27.rpy:3851
translate french c27s008_Oma_63431b5b:

    # mc "Y, si alguna vez tenemos hijos, vas a ser una madre latina preciosa. Y temible con 'la chancla'."
    mc "Et si jamais on a des enfants, tu seras une magnifique maman latine. Et redoutable en sandale."

# game/scripts/c27/c27.rpy:3853
translate french c27s008_Oma_81fc0b6b:

    # oma "*Risa* No me digas que 'la chancla' es lo primero que aprendes en español."
    oma "*Rires* Ne me dites pas que « la sandale » est la première chose qu'on apprend en espagnol."

# game/scripts/c27/c27.rpy:3854
translate french c27s008_Oma_46072297:

    # mc "No, también sé decir *Con acento español* 'jalapeños', 'chorizo' y 'croquetas'. Esas son difíciles."
    mc "Non, je peux aussi dire *avec un accent espagnol* « jalapeños », « chorizo » et « croquetas ». Ceux-là sont difficiles."

# game/scripts/c27/c27.rpy:3855
translate french c27s008_Oma_16e2356a:

    # mc "Y Yeti. *Risa* Se me da bien decir cosas que se pueden comer."
    mc "Et Yeti. *Rires* Je suis douée pour dire des choses qu'on peut manger."

# game/scripts/c27/c27.rpy:3857
translate french c27s008_Oma_c375e95f:

