    # oma "¿No te da un poco de morbo hacerlo en público, donde alguien pueda vernos?"
    oma "Ça ne vous donne pas un petit frisson de le faire en public, où quelqu'un pourrait nous voir ?"

# game/scripts/c27/c27.rpy:4079
translate french c27s008_Oma_7f483d77:

    # mc "Le da un punto de... peligrosidad... que lo hace más excitante."
    mc "Cela ajoute une touche de... danger... qui rend le tout plus excitant."

# game/scripts/c27/c27.rpy:4081
translate french c27s008_Oma_9e29afde:

    # oma "Pero también me ha encantado aquí. Es como... más íntimo. Como si fueras más mío."
    oma "Mais j'ai adoré être ici aussi. C'est comme... plus intime. Comme si tu m'appartenais davantage."

# game/scripts/c27/c27.rpy:4082
translate french c27s008_Oma_fb4c1ecb:

    # mc "Aquí sólo existimos los dos. Y no puedo ser más tuyo de lo que ya lo soy."
    mc "Ici, il n'y a que nous deux. Et je ne peux pas être plus à toi que je ne le suis déjà."

# game/scripts/c27/c27.rpy:4085
translate french c27s008_Oma_f59711fb:

    # oma "Eso me encanta de ti. No importa con cuántas chicas estés. Cuando estamos juntos me haces sentir que solo estás conmigo. Que soy única."
    oma "C'est ce que j'aime chez toi. Peu importe avec combien de filles tu es. Quand on est ensemble, j'ai l'impression que tu n'as d'yeux que pour moi. Que je suis unique."

# game/scripts/c27/c27.rpy:4087
translate french c27s008_Oma_0aa03334:

    # oma "Eso es una cosa que me encanta de estar contigo. Me haces sentir especial. Única."
    oma "C'est une des choses que j'aime chez toi. Tu me fais me sentir spéciale, unique."

# game/scripts/c27/c27.rpy:4088
translate french c27s008_Oma_0398b58f:

    # mc "Es que eres única, mi amor."
    mc "Tu es unique, mon amour."

# game/scripts/c27/c27.rpy:4090
translate french c27s008_Oma_5daaea07:

    # "Pasáis un rato charlando. De vosotros y de la familia."
    "Vous passez un peu de temps à discuter. De vous et de votre famille."

# game/scripts/c27/c27.rpy:4091
translate french c27s008_Oma_a69a830a:

    # "Del presente y del futuro. De tu viaje a Aruba y de lo mucho que os vais a echar de menos."
    "À propos du présent et de l'avenir. À propos de votre voyage à Aruba et du manque que vous allez ressentir l'un pour l'autre."

# game/scripts/c27/c27.rpy:4092
translate french c27s008_Oma_01c90d95:

    # "El tiempo pasa volando cuando tienes una preciosa Latina entre los brazos."
    "Le temps passe vite quand on a une belle Latina dans les bras."

# game/scripts/c27/c27.rpy:4093
translate french c27s008_Oma_179531e7:

    # "El tiempo pierde el sentido cuando tú mismo estás perdido en sus enormes ojos."
    "Le temps perd son sens quand on se perd soi-même dans leurs yeux immenses."

