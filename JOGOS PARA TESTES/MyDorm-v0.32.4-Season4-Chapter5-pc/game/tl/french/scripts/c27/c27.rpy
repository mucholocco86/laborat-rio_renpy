# game/scripts/c27/c27.rpy:1018
translate french c27s002_AmaSimSamJam_5dd29f13:

    # ama "No sé cómo se hace esto. Creo que lo de los apellidos es más... no sé... oficial."
    ama "Je ne sais pas comment ça se passe. Je pense que le système de nom de famille est plus... je ne sais pas... officiel."

# game/scripts/c27/c27.rpy:1020
translate french c27s002_AmaSimSamJam_c21bea45:

    # sam "*Risa* Si alguna vez tienes que venir al hospital, Dios no lo quiera, y me llamas Enfermera Washington, te pondré un enema de ortigas."
    sam "*Rires* Si jamais vous devez venir à l'hôpital, Dieu nous en préserve, et que vous m'appelez infirmière Washington, je vous ferai un lavement aux orties."

# game/scripts/c27/c27.rpy:1021
translate french c27s002_AmaSimSamJam_5da0f725:

    # sam "Que sea oficial no quiere decir que nos tengamos que tratar como desconocidas. Siéntate, por favor."
    sam "Ce n'est pas parce que c'est officiel que nous devons nous traiter comme des étrangers. Veuillez vous asseoir."

# game/scripts/c27/c27.rpy:1023
translate french c27s002_AmaSimSamJam_4951757e:

    # ama "¡Menos mal! Se me estaba haciendo rarísimo llamarte por tu apellido..."
    ama "Dieu merci ! Ça commençait à devenir vraiment bizarre de t'appeler par ton nom de famille..."

# game/scripts/c27/c27.rpy:1024
translate french c27s002_AmaSimSamJam_898664cf:

    # ama "¿Puedes avisar a [sim], por favor?"
    ama "Pouvez-vous en informer [sim], s'il vous plaît ?"

# game/scripts/c27/c27.rpy:1026
translate french c27s002_AmaSimSamJam_e4bf4017:

    # sim "¿Qué pasa [ama]? ¿Por qué estás tan elegante? ¿Vas a alguna parte?"
    sim "Salut [ama] ! Pourquoi es-tu si bien habillé(e) ? Tu vas quelque part ?"

# game/scripts/c27/c27.rpy:1027
translate french c27s002_AmaSimSamJam_22c68fe0:

    # sam "Viene en misión de trabajo. Creo que ese 'alguna parte' es aquí. Siéntate."
    sam "Il est ici pour le travail. Je pense que « quelque part » signifie ici. Asseyez-vous."

# game/scripts/c27/c27.rpy:1029
translate french c27s002_AmaSimSamJam_dd943f91:

    # ama "Bueno, creo que esto se me da muy mal..."
    ama "Eh bien, je crois que je suis vraiment nulle à ça..."

# game/scripts/c27/c27.rpy:1030
translate french c27s002_AmaSimSamJam_81764b8f:

    # ama "Quería entregarte estos papeles, [sim]. Sólo tienes que firmarlos en la última hoja."
    ama "Je voulais vous remettre ces papiers, [sim]. Il vous suffit de les signer à la dernière page."

# game/scripts/c27/c27.rpy:1032
translate french c27s002_AmaSimSamJam_1cc80c8a:

    # sim "¿Qué es esto?"
    sim "Qu'est-ce que c'est?"

# game/scripts/c27/c27.rpy:1034
translate french c27s002_AmaSimSamJam_7d2f2646:

    # sim "¿Qué? ¿Una beca? ¿Para la universidad?"
    sim "Quoi ? Une bourse ? Pour l'université ?"

# game/scripts/c27/c27.rpy:1035
translate french c27s002_AmaSimSamJam_9d20ceba:

    # sam "¿Qué? ¿Esto ha sido idea de [mc]? Ayer en el super le dije que no aceptábamos caridad."
    sam "Quoi ? C'était l'idée de [mc] ? Je lui ai dit hier au supermarché que nous n'acceptons pas la charité."

# game/scripts/c27/c27.rpy:1037
translate french c27s002_AmaSimSamJam_d17cab04:

    # ama "Bueno, [mc] firmó esos papeles hace unos días. No creo que vuestra conversación de ayer haya tenido nada que ver."
    ama "Eh bien, [mc] a signé ces documents il y a quelques jours. Je ne pense pas que votre conversation d'hier y soit pour quelque chose."

# game/scripts/c27/c27.rpy:1038
translate french c27s002_AmaSimSamJam_568d7891:

    # ama "Si lo firmas, puedo ir a la universidad a oficializar tu matrícula. Vamos un poco justos de tiempo."
    ama "Si vous signez, je peux aller à l'université pour vous inscrire officiellement. Nous sommes un peu pressés par le temps."

# game/scripts/c27/c27.rpy:1040
translate french c27s002_AmaSimSamJam_5bb3075d:

    # sim "¡No puedo aceptar esto! No lo merezco y no vamos a aceptar caridad, como ha dicho mi madre."
    sim "Je ne peux pas accepter ça ! Je ne le mérite pas, et nous n'accepterons pas la charité, comme disait ma mère."

# game/scripts/c27/c27.rpy:1042
translate french c27s002_AmaSimSamJam_81ba66f6:

    # ama "Yo no lo considero caridad. NTR ha creado una beca para la que eres la mejor candidata, con lo que no es como si [mc] estuviera pagando tu matriculación."
    ama "Je ne considère pas cela comme de la charité. NTR a créé une bourse pour laquelle vous êtes le/la meilleur(e) candidat(e), donc ils ne prennent pas en charge vos frais de scolarité."

# game/scripts/c27/c27.rpy:1044
translate french c27s002_AmaSimSamJam_1a288648:

    # sim "¡Seguro que hay candidatas mejores! ¡Yo ya no puedo competir!"
    sim "Il y a assurément de meilleurs candidats ! Je ne peux plus rivaliser !"

# game/scripts/c27/c27.rpy:1046
translate french c27s002_AmaSimSamJam_062caa19:

    # ama "En el tiempo que he tenido para evaluar a todas las candidatas no he encontrado a nadie mejor."
    ama "Durant la période où j'ai eu le temps d'évaluer tous les candidats, je n'ai trouvé personne de meilleur."

# game/scripts/c27/c27.rpy:1047
translate french c27s002_AmaSimSamJam_d6f1a6f5:

    # ama "Y la beca es para que estudies Ciencias del Deporte, no para que nades. Para que te conviertas en entrenadora."
    ama "Cette bourse est destinée à vous permettre d'étudier les sciences du sport, pas la natation. Elle vous permettra de devenir entraîneur."

# game/scripts/c27/c27.rpy:1049
translate french c27s002_AmaSimSamJam_0ec6aa72:

    # sam "¿Cuándo te encargó [mc] que hicieras esto, [ama]?"
    sam "Quand est-ce que [mc] t'a demandé de faire ça, [ama] ?"

# game/scripts/c27/c27.rpy:1051
translate french c27s002_AmaSimSamJam_44b66365:

    # ama "[mc] firmó los papeles el Sábado y..."
    ama "[mc] a signé les documents samedi et..."

# game/scripts/c27/c27.rpy:1053
translate french c27s002_AmaSimSamJam_0fb2f8cd:

    # sam "No te he preguntado cuándo lo firmó. Te estoy preguntando cuándo te encargó que estudiaras la creación de la beca."
    sam "Je ne vous ai pas demandé quand il a signé le document. Je vous demande quand il vous a chargé d'étudier la création de cette bourse."

# game/scripts/c27/c27.rpy:1054
translate french c27s002_AmaSimSamJam_768dcbc5:

    # sam "Porque te lo encargó él, ¿no? ¿O ha sido idea tuya? ¿O de alguien más?"
    sam "Parce qu'il te l'a demandé, n'est-ce pas ? Ou était-ce ton idée ? Ou celle de quelqu'un d'autre ?"

# game/scripts/c27/c27.rpy:1056
translate french c27s002_AmaSimSamJam_57dbe55f:

    # ama "Bueno... Como CEO de NTR, me lo encargó él en cuanto firmó los papeles y..."
    ama "Eh bien… En tant que PDG de NTR, il m’en a confié la gestion dès la signature des documents et…"

# game/scripts/c27/c27.rpy:1058
translate french c27s002_AmaSimSamJam_06fc8dc9:

    # sim "Pero esos papeles... ¿los redactó él o se los entregaste tú? ¿O se los entregó alguna otra persona?"
    sim "Mais ces papiers… est-ce lui qui les a écrits ou est-ce vous qui les lui avez donnés ? Ou est-ce que quelqu’un d’autre les lui a donnés ?"

# game/scripts/c27/c27.rpy:1060
translate french c27s002_AmaSimSamJam_884f0e9f:

    # ama "¿Qué más da quién redactara los requisitos de la beca? Lo importante es que lo firmes."
    ama "Qu'importe qui a rédigé les critères d'attribution de la bourse ? L'important, c'est que vous les signiez."

# game/scripts/c27/c27.rpy:1062
translate french c27s002_AmaSimSamJam_6c1250ef:

    # sam "Está claro que no fue idea de [mc]. Si lo fuera, ella lo habría dicho sin dar tantos rodeos."
    sam "Il est clair que ce n'était pas l'idée de <c4. Si ça avait été le cas, elle l'aurait dit sans détour."

# game/scripts/c27/c27.rpy:1063
translate french c27s002_AmaSimSamJam_7c9c4d16:

    # sam "Apostaría algo a que 'alguien' escuchó tu conversación con [deb.nick] y [mc] sobre entrenar y sobre que hubieras querido estudiar educación deportiva."
    sam "Je parierais quelque chose que « quelqu'un » a entendu votre conversation avec [deb.nick] et [mc] à propos de l'entraînement et de votre désir d'étudier l'éducation sportive."

# game/scripts/c27/c27.rpy:1065
translate french c27s002_AmaSimSamJam_d36f86f0:

    # sim "Tienes razón. Allí sólo estábamos [deb.nick], [mc], y yo. [deb.nick], pese a que tiene el dinero para hacerlo, no haría una beca a nombre de NTR."
    sim "Tu as raison. Il n'y avait que moi, F3 et C4. F3, même s'il en avait les moyens, a refusé de créer une bourse d'études au nom de NTR."

# game/scripts/c27/c27.rpy:1066
translate french c27s002_AmaSimSamJam_b587d91b:

    # sim "Y [mc], como acabas de decir, está claro que no lo ha hecho."
    sim "Et [mc], comme vous venez de le dire, il est clair qu'il ne l'a pas fait."

# game/scripts/c27/c27.rpy:1068
translate french c27s002_AmaSimSamJam_a1c41572:

    # sim "¿O de [eva]?" (multiple=2)
    sim "Ou [eva] ?" (multiple=2)

# game/scripts/c27/c27.rpy:1069
translate french c27s002_AmaSimSamJam_476bab9b:

    # sam "¿Ha sido idea tuya?" (multiple=2)
    sam "Était-ce votre idée ?" (multiple=2)

# game/scripts/c27/c27.rpy:1071
translate french c27s002_AmaSimSamJam_8b47d22e:

    # sam "Si hubiera sido de [eva], sería ella la que estuviera aquí."
    sam "Si ça avait été [eva], ce serait elle qui serait là."

# game/scripts/c27/c27.rpy:1072
translate french c27s002_AmaSimSamJam_a796d1ba:

    # sim "Tienes razón. Además, [eva] no tendría tantos reparos en aceptar que la idea ha sido suya."
    sim "Vous avez raison. D'ailleurs, [eva] n'aurait pas autant de scrupules à admettre que l'idée était la sienne."

# game/scripts/c27/c27.rpy:1073
translate french c27s002_AmaSimSamJam_1a69b8d9:

    # sam "Ni en aceptar el agradecimiento por haber tenido la idea."
    sam "Ni en acceptant des remerciements pour avoir eu l'idée."

# game/scripts/c27/c27.rpy:1075
translate french c27s002_AmaSimSamJam_e6babcf2:

    # ama "¿Agradecimiento? ¿No estáis enfadadas porque le presentara los papeles a [mc]?"
    ama "De la gratitude ? Vous n'êtes pas en colère qu'il ait présenté les documents à [mc] ?"

# game/scripts/c27/c27.rpy:1077
translate french c27s002_AmaSimSamJam_1fb92d4a:

    # sim "¡Has caído en la trampa!" (multiple=2)
    sim "Vous êtes tombé dans le piège !" (multiple=2)

# game/scripts/c27/c27.rpy:1078
translate french c27s002_AmaSimSamJam_25c95a6b:

    # sam "¡Lo sabía!" (multiple=2)
    sam "Je le savais!" (multiple=2)

# game/scripts/c27/c27.rpy:1080
translate french c27s002_AmaSimSamJam_db7734ff:

    # sim "¡Se nota que no te has criado con mi madre! Ni Jamaal ni yo caemos en esas trampas desde hace años."
    sim "Il est évident que tu n'as pas été élevé par ma mère ! Ni Jamaal ni moi ne sommes tombés dans ces pièges depuis des années."

# game/scripts/c27/c27.rpy:1081
translate french c27s002_AmaSimSamJam_9cfb1054:

    # sim "Pero ahora entiendo por qué a mi madre le gustaba tanto tendérnoslas."
    sim "Mais maintenant je comprends pourquoi ma mère aimait tant nous les donner."

# game/scripts/c27/c27.rpy:1083
translate french c27s002_AmaSimSamJam_a5a08d73:

    # ama "Entonces... ¿vas a firmar los papeles ahora que sabéis que no es cosa de [mc], [sim]?"
    ama "Alors... allez-vous signer les papiers maintenant que vous savez que ce n'est pas une question de [mc], [sim] ?"

# game/scripts/c27/c27.rpy:1085
translate french c27s002_AmaSimSamJam_a066af1d:

    # sim "¡No! ¡No lo puedo aceptar!" (multiple=2)
    sim "Non ! Je ne peux pas l'accepter !" (multiple=2)

# game/scripts/c27/c27.rpy:1086
translate french c27s002_AmaSimSamJam_83a2f811:

    # sam "¡Ya te hemos dicho que no aceptamos caridad!" (multiple=2)
    sam "Nous vous avons déjà dit que nous n'acceptons pas les dons !" (multiple=2)

# game/scripts/c27/c27.rpy:1088
translate french c27s002_AmaSimSamJam_8f2353c6:

    # jam "¿Quieres firmar los putos papeles de una vez, [sim]?"
    jam "Tu veux signer ces putains de papiers, [sim] ?"

# game/scripts/c27/c27.rpy:1089
translate french c27s002_AmaSimSamJam_1a5db2cb:

    # jam "Y ya sé que tengo que poner un dólar en el bote de los tacos, pero es el dólar que menos me va a doler poner en mi vida."
    jam "Et je sais que je dois mettre un dollar dans le pot à tacos, mais c'est le dollar qui me fera le moins mal dans ma vie."

# game/scripts/c27/c27.rpy:1091
translate french c27s002_AmaSimSamJam_9500304c:

    # jam "[ama] se ha molestado en crear una beca para ti y te pones... os ponéis las dos... hechas una furia."
    jam "[ama] s'est donné la peine de créer une bourse pour vous et vous... vous deux... devenez furieux."

# game/scripts/c27/c27.rpy:1092
translate french c27s002_AmaSimSamJam_9be860db:

    # jam "Una cosa es no aceptar caridad, y otra distinta es no aceptar favores."
    jam "Refuser la charité est une chose, refuser les faveurs en est une autre."

# game/scripts/c27/c27.rpy:1094
translate french c27s002_AmaSimSamJam_bdae2aa2:

    # jam "Por cierto, hola, [ama]. Perdona a las irracionales Washington. Yo soy la parte que piensa. Esa beca, ¿te cuesta dinero a ti?"
    jam "Au fait, salut, [ama]. Excuse-moi pour mes réactions irrationnelles. C'est moi qui réfléchis. Cette bourse est-elle payante ?"

# game/scripts/c27/c27.rpy:1096
translate french c27s002_AmaSimSamJam_037995c1:

    # ama "Hola, Jamaal. No, es dinero de NTR... Y tiene retorno de impuestos."
    ama "Salut Jamaal. Non, c'est de l'argent provenant de NTR... Et il y a une déclaration de revenus."

# game/scripts/c27/c27.rpy:1098
translate french c27s002_AmaSimSamJam_79fd1ecd:

    # jam "¿Veis? ¡No es una maldita obra de caridad! Sí, otro dólar. Es una empresa haciendo algo que le beneficia a largo plazo."
    jam "Vous voyez ? Ce n'est pas une œuvre de charité ! Oui, encore un dollar. C'est une entreprise qui fait quelque chose qui lui sera bénéfique à long terme."

# game/scripts/c27/c27.rpy:1099
translate french c27s002_AmaSimSamJam_5f37ebc4:

    # jam "¿La estaríais rechazando si fuese MocoSoft o FAPple en vez de NTR? Seguro que no pero, como es la empresa de [mc], hay que poner pegas, ¿no?"
    jam "Le rejetteriez-vous si c'était MocoSoft ou FAPple au lieu de NTR ? Certainement pas, mais comme c'est la société de [mc], on est bien obligé de lui trouver à redire, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1100
translate french c27s002_AmaSimSamJam_7a2b6df3:

    # jam "¡Ni siquiera le habéis dado las gracias a [ama]!"
    jam "Tu n'as même pas remercié [ama] !"

# game/scripts/c27/c27.rpy:1102
translate french c27s002_AmaSimSamJam_91f72a49:

    # sam "Tiene un poco de razón, ¿no? ¿Estamos siendo un poco irracionales?"
    sam "Il n'a pas tort, n'est-ce pas ? Ne sommes-nous pas un peu irrationnels ?"

# game/scripts/c27/c27.rpy:1103
translate french c27s002_AmaSimSamJam_d5fa0ea9:

    # sim "Es posible. ¡Mielda, no me gusta darle la razón a Jamaal!"
    sim "C'est possible. Zut, je n'aime pas être d'accord avec Jamaal !"

# game/scripts/c27/c27.rpy:1105
translate french c27s002_AmaSimSamJam_ea91ad77:

    # jam "Entonces todo arreglado. Vuelvo a mi habitación. He dejado a medias el chat con un cliente."
    jam "Tout est réglé. Je retourne dans ma chambre. J'avais interrompu ma conversation avec un client."

# game/scripts/c27/c27.rpy:1107
translate french c27s002_AmaSimSamJam_3949f53b:

    # sim "Toma, aquí están los papeles firmados. Y gracias."
    sim "Voici les documents signés. Merci."

# game/scripts/c27/c27.rpy:1108
translate french c27s002_AmaSimSamJam_fb9896bb:

    # sim "Pero, ¿cómo lo sabías? Nunca hemos hablado de ello..."
    sim "Mais comment le savais-tu ? On n'en a jamais parlé..."

# game/scripts/c27/c27.rpy:1110
translate french c27s002_AmaSimSamJam_56ba5122:

    # ama "El otro día, cuando estabas en la piscina con [mc] y [deb.nick]..."
    ama "L'autre jour, quand tu étais à la piscine avec [mc] et [deb.nick]..."

# game/scripts/c27/c27.rpy:1112
translate french c27s002_AmaSimSamJam_c5c40574:

    # "Después de dar las explicaciones de cómo surgió el plan de la beca..."
    "Après avoir expliqué comment le programme de bourses a vu le jour..."

# game/scripts/c27/c27.rpy:1113
translate french c27s002_AmaSimSamJam_c1b46714:

    # sim "Gracias, [ama]. No sé si hubiera podido estudiar sin lo que acabas de hacer."
    sim "Merci, [ama]. Je ne sais pas si j'aurais pu étudier sans ce que tu viens de faire."

# game/scripts/c27/c27.rpy:1114
translate french c27s002_AmaSimSamJam_0d63803d:

    # ama "No es sólo mérito mío. [mc] estuvo de acuerdo con la idea y fue quien dio la orden ejecutiva."
    ama "Ce n'est pas seulement grâce à mon mérite. [mc] a approuvé l'idée et c'est lui qui a donné le décret."

# game/scripts/c27/c27.rpy:1115
translate french c27s002_AmaSimSamJam_1a37f0cd:

    # sim "Seguramente no lo hubiera hecho si no hubiera sido por ti. Sabe cómo nos sentimos cuando se nos ofrece... caridad."
    sim "Je ne l'aurais probablement pas fait sans toi. Tu sais ce que l'on ressent quand on nous propose… la charité."

# game/scripts/c27/c27.rpy:1116
translate french c27s002_AmaSimSamJam_bc5bac69:

    # ama "Yo también lo sé, pero esto no es caridad. Son negocios. Y un favor a una hermana."
    ama "Je le sais aussi, mais ce n'est pas de la charité. C'est du business. Et un service rendu à une sœur."

# game/scripts/c27/c27.rpy:1118
translate french c27s002_AmaSimSamJam_12319058:

    # sam "Disculpa por cómo nos hemos comportado. Lo de ser irracional lo llevamos en la sangre."
    sam "Nous nous excusons pour notre comportement. L'irrationalité est dans notre nature."

# game/scripts/c27/c27.rpy:1119
translate french c27s002_AmaSimSamJam_f2fb2f00:

    # ama "No hay nada por lo que disculparse."
    ama "Il n'y a pas lieu de s'excuser."

# game/scripts/c27/c27.rpy:1120
translate french c27s002_AmaSimSamJam_a63e40e4:

    # sam "¿Has comido ya? ¿Quieres quedarte a comer?"
    sam "Avez-vous déjà mangé ? Voulez-vous rester déjeuner ?"

# game/scripts/c27/c27.rpy:1121
translate french c27s002_AmaSimSamJam_13f2237f:

    # ama "Me encantaría."
    ama "J'adorerais."

# game/scripts/c27/c27.rpy:1122
translate french c27s002_AmaSimSamJam_3e16133e:

    # sam "He hecho pierogi para nosotros tres, podemos dividirlos y hacer una ensalada más grande."
    sam "J'ai préparé des pierogis pour nous trois ; on peut les partager et faire une plus grande salade."

# game/scripts/c27/c27.rpy:1123
translate french c27s002_AmaSimSamJam_40ca604f:

    # jam "*Desde su habitación* ¡Noooo!"
    jam "*Depuis sa chambre* Nooon !"

# game/scripts/c27/c27.rpy:1132
translate french c27s002_AaronVC_05f06837:

    # "Un par de minutos después de que [emm] se vaya..."
    "Quelques minutes après le départ de [emm]..."

# game/scripts/c27/c27.rpy:1134
translate french c27s002_AaronVC_f51bd432:

    # "Nada más entrar en tu habitación después de comer..."
    "Dès que vous entrez dans votre chambre après avoir mangé..."

# game/scripts/c27/c27.rpy:1136
translate french c27s002_AaronVC_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1137
translate french c27s002_AaronVC_307848b4:

    # mcp "(¿Videoconferencia con Aaron? No teníamos nada programado para hoy...)"
    mcp "(Une visioconférence avec Aaron ? Nous n'avions rien de prévu aujourd'hui...)"

# game/scripts/c27/c27.rpy:1141
translate french c27s002_AaronVC_12e8a860:

    # mc "Hola, Aaron. ¿Puedo ayudarte en algo?"
    mc "Salut Aaron. Puis-je t'aider ?"

# game/scripts/c27/c27.rpy:1142
translate french c27s002_AaronVC_b015eb34:

    # aar "Bueno, llamaba para un par de cosas. La primera es que quiero asegurarme de que habéis recibido el dinero."
    aar "Eh bien, je vous appelais concernant deux choses. La première est que je voulais m'assurer que vous aviez bien reçu l'argent."

# game/scripts/c27/c27.rpy:1143
translate french c27s002_AaronVC_66a28bc0:

    # mc "Sí, fue una sorpresa. Lo esperábamos hacia final de año."
    mc "Oui, c'était une surprise. Nous nous y attendions vers la fin de l'année."

# game/scripts/c27/c27.rpy:1145
translate french c27s002_AaronVC_eb8b7b59:

    # aar "Bueno, sobre eso... He descubierto que Daniels maquillaba los libros de contabilidad. [mar] y [nor] sólo estaban recibiendo la mitad de lo que les pertocaba."
    aar "À propos de ça… J’ai découvert que Daniels falsifiait les comptes. [mar] et [nor] ne recevaient que la moitié de ce qui leur était dû."

# game/scripts/c27/c27.rpy:1146
translate french c27s002_AaronVC_f59c8bb0:

    # aar "Una de las transferencias era desviada como gastos. Se quedaba una parte. Richards lo hacía antes que él, con lo que..."
    aar "L'un des virements a été détourné et comptabilisé comme dépense. Il en a conservé une partie. Richards l'avait fait avant lui, alors…"

# game/scripts/c27/c27.rpy:1147
translate french c27s002_AaronVC_758f2346:

    # mc "Le debemos un montón de dinero a [mar] y a [nor]. 20 años a $83,000... alrededor de $1,600,000."
    mc "Nous devons beaucoup d'argent à [mar] et [nor]. 20 ans à 83 000 $... environ 1 600 000 $."

# game/scripts/c27/c27.rpy:1149
translate french c27s002_AaronVC_71b1055b:

    # aar "Bastante menos. Los primeros años era muy poco dinero, y después fue creciendo. Pero sí, NTR les debe algo menos de $900,000 a cada una."
    aar "Bien moins. Les premières années, c'était très peu, puis ça a augmenté. Mais oui, NTR leur doit un peu moins de 900 000 $ chacun."

# game/scripts/c27/c27.rpy:1150
translate french c27s002_AaronVC_bbfdd42e:

    # aar "Es algo que tendremos que solucionar, pero habrá tiempo para eso cuando estés aquí."
    aar "C'est quelque chose que nous devrons régler, mais nous aurons le temps d'en parler quand vous serez là."

# game/scripts/c27/c27.rpy:1152
translate french c27s002_AaronVC_79decbe0:

    # aar "¿Cómo ves tu sueldo de CEO? Creo que no habíamos hablado de ello en ningún momento."
    aar "Comment percevez-vous votre salaire de PDG ? Je ne crois pas que nous en ayons discuté."

# game/scripts/c27/c27.rpy:1153
translate french c27s002_AaronVC_83eaadaa:

    # mc "Me sorprendió la cantidad. No esperaba tanto."
    mc "J'ai été surpris par la somme. Je ne m'attendais pas à autant."

# game/scripts/c27/c27.rpy:1154
translate french c27s002_AaronVC_a26866a8:

    # aar "Era lo que cobraba Daniels, con lo que es difícil de justificar bajar tu sueldo."
    aar "C'est ce que gagnait Daniels, il est donc difficile de justifier une baisse de salaire."

# game/scripts/c27/c27.rpy:1156
translate french c27s002_AaronVC_a6df5df9:

    # aar "Sobre el tema de los sueldos... tengo que pedirte una cosa..."
    aar "Concernant la question des salaires… j’ai une question à vous poser…"

# game/scripts/c27/c27.rpy:1157
translate french c27s002_AaronVC_e42e4e08:

    # mc "Dime. Lo que necesites. Supongo que ahora que tienes el cargo de Director de Operaciones, te habrás subido el sueldo, ¿no?"
    mc "Dites-moi tout ce dont vous avez besoin. J'imagine que maintenant que vous êtes directeur des opérations, vous vous êtes octroyé une augmentation, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1159
translate french c27s002_AaronVC_9aa7c0c5:

    # aar "Bueno, no es que me haya subido el sueldo. He cobrado un sueldo por primera vez en mi vida."
    aar "En fait, je n'ai pas eu d'augmentation. J'ai reçu un salaire pour la première fois de ma vie."

# game/scripts/c27/c27.rpy:1160
translate french c27s002_AaronVC_4de36aed:

    # mc "¿Qué? ¿No cobrabas? ¿Las chicas tampoco?"
    mc "Quoi ? Vous n'étiez pas payés ? Les filles non plus ?"

# game/scripts/c27/c27.rpy:1162
translate french c27s002_AaronVC_1b997de3:

    # aar "No. Ninguno de los operativos cobrábamos. Nuestro 'pago' era vivir en la base, alimentación, entrenamiento..."
    aar "Non. Aucun d'entre nous, les opérateurs, n'était payé. Notre « rémunération » consistait à loger sur la base, à manger, à s'entraîner…"

# game/scripts/c27/c27.rpy:1163
translate french c27s002_AaronVC_a8247bb1:

    # aar "Tampoco es que hubiéramos tenido dónde gastarlos. Imagínate 16 clones de la Serie G entrando a la vez en un bar de Oranjestad." id c27s002_AaronVC_a8247bb1
    aar "On n'aurait pas eu d'endroit où les dépenser. Imaginez 16 clones de la série G entrant en même temps dans un bar à Oranjestad." id c27s002_AaronVC_a8247bb1

# game/scripts/c27/c27.rpy:1164
translate french c27s002_AaronVC_d56b9c53:

    # mc "Lo entiendo."
    mc "Je comprends."

# game/scripts/c27/c27.rpy:1166
translate french c27s002_AaronVC_9493f119:

    # aar "Por eso quiero pedirte el favor del que te hablaba. Las chicas nunca han tenido dinero propio. Ahora tienen más de $50,000 cada una." id c27s002_AaronVC_9493f119
    aar "C'est pourquoi je souhaite vous demander la faveur dont je vous ai parlé. Ces filles n'ont jamais eu d'argent à elles. Maintenant, elles ont chacune plus de 50 000 $." id c27s002_AaronVC_9493f119

# game/scripts/c27/c27.rpy:1167
translate french c27s002_AaronVC_6f6582e4:

    # aar "Dudo que [ama] vaya a hacer alguna locura, pero... si pudieras vigilar un poco a [eva], me harías... nos harías un favor a todos."
    aar "Je doute que [ama] fasse quoi que ce soit d'extravagant, mais... si vous pouviez surveiller un peu [eva], vous me rendriez service... vous nous rendriez service à tous."

# game/scripts/c27/c27.rpy:1168
translate french c27s002_AaronVC_43923d2e:

    # mc "Ningún problema. Creo que puedo convencer a [mar] y a [nor] para que les den una charla sobre el dinero."
    mc "Pas de problème. Je pense pouvoir convaincre [mar] et [nor] de leur parler d'argent."

# game/scripts/c27/c27.rpy:1169
translate french c27s002_AaronVC_cc7d56b7:

    # mc "Les dará la oportunidad de pasar más tiempo con ellas a solas y ejercer de madres."
    mc "Cela leur donnera l'occasion de passer plus de temps seules avec elles et d'agir comme des mères."

# game/scripts/c27/c27.rpy:1171
translate french c27s002_AaronVC_4d156b23:

    # aar "Perfecto. Entonces, creo que ahora viene el tema más complicado."
    aar "Parfait. Je pense donc que la partie la plus compliquée arrive maintenant."

# game/scripts/c27/c27.rpy:1173
translate french c27s002_AaronVC_98fd59ca:

    # aar "Necesitaría hablar con [bet.full]."
    aar "Je devrais parler à [bet.full]."

# game/scripts/c27/c27.rpy:1174
translate french c27s002_AaronVC_6e0c7c96:

    # mc "¿Con Tía [bet]? ¿Para qué?"
    mc "Avec tante [bet] ? Pourquoi ?"

# game/scripts/c27/c27.rpy:1175
translate french c27s002_AaronVC_b3f8879e:

    # aar "Es por un tema médico que..."
    aar "C'est pour une raison médicale que..."

# game/scripts/c27/c27.rpy:1176
translate french c27s002_AaronVC_9683bb47:

    # mc "¿Te pasa algo? ¿Estás bien?"
    mc "Quelque chose ne va pas ? Ça va ?"

# game/scripts/c27/c27.rpy:1178
translate french c27s002_AaronVC_254f7d09:

    # aar "No, tranquilo, no es para mí. Hemos perdido al cirujano que teníamos en NTR y..."
    aar "Non, ne vous inquiétez pas, ce n'est pas pour moi. Nous avons perdu le chirurgien que nous avions à NTR et..."

# game/scripts/c27/c27.rpy:1181
translate french c27s002_AaronVC_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c27/c27.rpy:1182
translate french c27s002_AaronVC_2d7ccd4e:

    # mar "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mar "*À travers la porte* C'est moi. Puis-je entrer ?"

# game/scripts/c27/c27.rpy:1183
translate french c27s002_AaronVC_2422e723:

    # mc "Sí, pasa. Estoy en una videoconferencia con Aaron."
    mc "Oui, c'est en train de se produire. Je suis en visioconférence avec Aaron."

# game/scripts/c27/c27.rpy:1185
translate french c27s002_AaronVC_c61f7c69:

    # mar "¿Hola, Aaron? ¿Qué tal todo por Aruba?"
    mar "Salut Aaron ! Comment ça va à Aruba ?"

# game/scripts/c27/c27.rpy:1187
translate french c27s002_AaronVC_d7bc2045:

    # aar "Todo bien, [mar]. Estaba discutiendo unos temas con [mc]."
    aar "Tout va bien, [mar]. Je discutais de certaines choses avec [mc]."

# game/scripts/c27/c27.rpy:1189
translate french c27s002_AaronVC_86e106ad:

    # mar "Entonces os dejo con vuestros asuntos. Lo que venía a decirle a..."
    mar "Je vous laisse donc à vos affaires. Ce que je voulais dire à..."

# game/scripts/c27/c27.rpy:1191
translate french c27s002_AaronVC_9bb25db6:

    # mar "... [mc]..."
    mar "... [mc]..."

# game/scripts/c27/c27.rpy:1192
translate french c27s002_AaronVC_3f55ac25:

    # mar "... no es..."
    mar "...ce n'est pas..."

# game/scripts/c27/c27.rpy:1193
translate french c27s002_AaronVC_08ad065f:

    # mar "... urgente..."
    mar "... urgent..."

# game/scripts/c27/c27.rpy:1194
translate french c27s002_AaronVC_316010b6:

    # mc "¿Puedes decirle a Tía [bet] que venga, por favor? Aaron quiere hablar con ella."
    mc "Peux-tu dire à tante [bet] de venir ici, s'il te plaît ? Aaron veut lui parler."

# game/scripts/c27/c27.rpy:1196
translate french c27s002_AaronVC_dd74f574:

    # mar "Sí... Ahora voy... a avisarla... Está en la piscina..."
    mar "Oui… je vais lui dire maintenant… Elle est dans la piscine…"

# game/scripts/c27/c27.rpy:1198
translate french c27s002_AaronVC_eaef52fa:

    # mc "Gracias, Mamá."
    mc "Merci maman."

# game/scripts/c27/c27.rpy:1200
translate french c27s002_AaronVC_73d262ed:

    # mc "Gracias, [mar]."
    mc "Merci, [mar]."

# game/scripts/c27/c27.rpy:1202
translate french c27s002_AaronVC_c8e89903:

    # mc "Si quieres esperamos que llegue Tía [bet] para seguir hablando de lo que necesitas de ella."
    mc "Si vous le souhaitez, nous pouvons attendre l'arrivée de tante [bet] pour continuer à parler de ce dont vous avez besoin de sa part."

# game/scripts/c27/c27.rpy:1203
translate french c27s002_AaronVC_bd5d5f95:

    # mc "Mientras tanto voy pasando la video conferencia al portátil. Será más cómodo."
    mc "En attendant, je transfère la visioconférence sur mon ordinateur portable. Ce sera plus pratique."

# game/scripts/c27/c27.rpy:1204
translate french c27s002_AaronVC_e7c51356:

    # mc "¿Qué ha pasado con el cirujano?"
    mc "Qu'est-il arrivé au chirurgien ?"

# game/scripts/c27/c27.rpy:1205
translate french c27s002_AaronVC_1b5a9b9a:

    # aar "El cirujano principal era Daniels."
    aar "Le chirurgien principal était Daniels."

# game/scripts/c27/c27.rpy:1206
translate french c27s002_AaronVC_7f59aec1:

    # mc "Y supongo que ahora no puede trabajar con nosotros, ¿no?"
    mc "Et je suppose qu'il ne peut plus travailler avec nous maintenant, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1208
translate french c27s002_AaronVC_a92cc8e6:

    # aar "Es complicado... Aún tenemos que decidir qué vamos a hacer con él. Pero no me fiaría de que me operara, si fuera necesario."
    aar "C'est compliqué… On doit encore décider quoi faire. Mais je ne lui ferais pas confiance pour m'opérer, même si c'était nécessaire."

# game/scripts/c27/c27.rpy:1209
translate french c27s002_AaronVC_d323c6bf:

    # aar "Y sus ayudantes dan el nivel para operaciones más básicas. No para lo que necesitamos ahora mismo."
    aar "Et leurs assistants sont capables de gérer des opérations plus élémentaires. Pas pour ce dont nous avons besoin actuellement."

# game/scripts/c27/c27.rpy:1210
translate french c27s002_AaronVC_95da287a:

    # mc "Sobre Daniels, ¿qué opciones tenemos?"
    mc "Concernant Daniels, quelles sont nos options ?"

# game/scripts/c27/c27.rpy:1212
translate french c27s002_AaronVC_6de03863:

    # aar "Como te digo, es complicado. No lo podemos entregar a la justicia de Aruba."
    aar "Comme je l'ai dit, c'est compliqué. Nous ne pouvons pas le livrer à la justice arubaise."

# game/scripts/c27/c27.rpy:1213
translate french c27s002_AaronVC_31a5810a:

    # aar "Ha ordenado asesinatos, pero todo saldría a la luz en un juicio público y eso es lo que menos nos conviene."
    aar "Il a ordonné des meurtres, mais tout serait révélé lors d'un procès public, et c'est la dernière chose que nous souhaitons."

# game/scripts/c27/c27.rpy:1214
translate french c27s002_AaronVC_7539a30f:

    # mc "Lo entiendo. Nos tocará a nosotros impartir justicia, entonces."
    mc "Je comprends. Il nous appartiendra donc de rendre justice."

# game/scripts/c27/c27.rpy:1216
translate french c27s002_AaronVC_0d52c23f:

    # aar "Justicia. Aunque no sea legal. Quiero consultarlo con las chicas cuando estén aquí. No es algo para tratar en una video conferencia."
    aar "La justice. Même si ce n'est pas légal. Je veux en parler avec les filles quand elles seront là. Ce n'est pas le genre de chose à aborder en visioconférence."

# game/scripts/c27/c27.rpy:1217
translate french c27s002_AaronVC_461bdae7:

    # aar "De hecho, tenerlo 'prisionero' ya es ilegal. No tenemos ningún derecho legal a hacerlo, pero las autoridades de Aruba van a mirar hacia otro lado."
    aar "En réalité, le détenir « prisonnier » est déjà illégal. Nous n'avons aucun droit légal de le faire, mais les autorités arubaises vont fermer les yeux."

# game/scripts/c27/c27.rpy:1218
translate french c27s002_AaronVC_e867c270:

    # mc "Supongo que tan ilegal como asesinarlo..."
    mc "J'imagine que c'est aussi illégal que de le tuer..."

# game/scripts/c27/c27.rpy:1220
translate french c27s002_AaronVC_62464051:

    # aar "Por eso lo quiero consultar con las chicas. Si por mi fuera, le dispararía en la cabeza ahora mismo, pero ellas también tienen derecho a decidir qué hacer con él."
    aar "C'est pourquoi je veux en parler aux filles. Si ça ne tenait qu'à moi, je lui tirerais une balle dans la tête sur-le-champ, mais elles ont aussi le droit de décider de son sort."

# game/scripts/c27/c27.rpy:1221
translate french c27s002_AaronVC_1aa76c3f:

    # aar "Sus hermanas murieron por culpa de Daniels, igual que mi hermano. Tienen el mismo derecho a decidir que yo."
    aar "Ses sœurs sont mortes à cause de Daniels, tout comme mon frère. Elles ont le même droit de décider que moi."

# game/scripts/c27/c27.rpy:1231
translate french c27s002_AaronVC_7d323a19:

    # mc "Creo que también deberíamos tener derecho a decidir, aunque gracias a vosotros no perdiéramos a nadie."
    mc "Je crois que nous devrions aussi avoir le droit de décider, même si, grâce à vous, nous n'avons perdu personne."

# game/scripts/c27/c27.rpy:1233
translate french c27s002_AaronVC_f90ff87a:

    # aar "Esperaba que dijeras algo así y lo considero lógico."
    aar "Je m'attendais à ce que vous disiez quelque chose comme ça, et je trouve cela logique."

# game/scripts/c27/c27.rpy:1234
translate french c27s002_AaronVC_d50e5700:

    # aar "Pienso que, cuando estéis los tres aquí, habrá que decidir."
    aar "Je pense que lorsque vous serez tous les trois là, nous devrons prendre une décision."

# game/scripts/c27/c27.rpy:1237
translate french c27s002_AaronVC_2d094ad0:

    # mc "Creo que es un tema que deberíais decidir vosotros, gracias a vosotros nosotros no perdimos a nadie, y no creo que debamos intervenir en esa situación."
    mc "Je pense que c'est à vous de décider ; grâce à vous, nous n'avons perdu personne, et je ne pense pas que nous devions intervenir dans cette situation."

# game/scripts/c27/c27.rpy:1239
translate french c27s002_AaronVC_aab08895:

    # aar "No esperaba que dijeras algo así... Creía que ibas a querer participar en la decisión, aunque te agradezco que lo dejes en nuestras manos."
    aar "Je ne m'attendais pas à ce que vous disiez quelque chose comme ça... Je pensais que vous souhaiteriez participer à la décision, même si j'apprécie que vous nous laissiez le soin de la prendre."

# game/scripts/c27/c27.rpy:1240
translate french c27s002_AaronVC_4f6ee7d1:

    # aar "Pienso que, cuando estén las dos aquí, habrá que decidir."
    aar "Je pense que lorsqu'ils seront tous les deux là, nous devrons prendre une décision."

# game/scripts/c27/c27.rpy:1242
translate french c27s002_AaronVC_34d3bc90:

    # mc "Me parece que no van a coincidir las dos allí. [eva] no está preparada para ver a Gavin todavía, con lo que se quedará aquí el primer mes."
    mc "Je ne pense pas qu'ils seront tous les deux là en même temps. Elle n'est pas encore prête à voir Gavin, alors elle restera ici le premier mois."

# game/scripts/c27/c27.rpy:1243
translate french c27s002_AaronVC_7322ce6c:

    # mc "Después rotarán. [ama] volverá a casa y [eva] estará allí conmigo."
    mc "Ensuite, ils tourneront. [ama] rentrera chez lui et [eva] sera là avec moi."

# game/scripts/c27/c27.rpy:1245
translate french c27s002_AaronVC_04ee3015:

    # aar "Entonces, durante la rotación. Habrá que hacer que coincidan las dos aquí para tomar esa decisión."
    aar "Donc, pendant la rotation, il faudra s'assurer que les deux coïncident pour prendre cette décision."

# game/scripts/c27/c27.rpy:1246
translate french c27s002_AaronVC_f5687c30:

    # mc "Por cierto, ¿cómo está Gavin?"
    mc "Au fait, comment va Gavin ?"

# game/scripts/c27/c27.rpy:1247
translate french c27s002_AaronVC_cf05b26f:

    # aar "De eso es de lo que quiero hablar con [bet.full]."
    aar "C'est de cela que je veux parler à [bet.full]."

# game/scripts/c27/c27.rpy:1248
translate french c27s002_AaronVC_4932b211:

    # mc "Oigo pasos en la escalera. Debe ser ella."
    mc "J'entends des pas dans l'escalier. Ça doit être elle."

# game/scripts/c27/c27.rpy:1251
translate french c27s002_AaronVC_dd0461ef_1:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c27/c27.rpy:1252
translate french c27s002_AaronVC_76ad3c97:

    # bet "*A través de la puerta* Soy yo. [mar] me ha dicho que querías verme."
    bet "*À travers la porte* C'est moi. [mar] m'a dit que tu voulais me voir."

# game/scripts/c27/c27.rpy:1253
translate french c27s002_AaronVC_3e917570:

    # mc "Sí, pasa, Tía [bet]."
    mc "Oui, entrez, tante [bet]."

# game/scripts/c27/c27.rpy:1255
translate french c27s002_AaronVC_ffd92977:

    # mc "Siéntate. Aaron quiere hablar contigo. Os presento."
    mc "Asseyez-vous. Aaron veut vous parler. Permettez-moi de vous le présenter."

# game/scripts/c27/c27.rpy:1256
translate french c27s002_AaronVC_b705c9da:

    # bet "Encantada de conocerte, Aaron."
    bet "Enchanté de faire votre connaissance, Aaron."

# game/scripts/c27/c27.rpy:1258
translate french c27s002_AaronVC_f2636f38:

    # aar "Lo mismo digo, Sra. [bet.full]."
    aar "Je suis d'accord, Mme [bet.full]."

# game/scripts/c27/c27.rpy:1260
translate french c27s002_AaronVC_82ed1e9d:

    # bet "..."
    bet "..."

# game/scripts/c27/c27.rpy:1261
translate french c27s002_AaronVC_88aef742:

    # mc "¿Qué pasa Tía [bet]?"
    mc "Quoi de neuf, tante [bet] ?"

# game/scripts/c27/c27.rpy:1263
translate french c27s002_AaronVC_7f1d29ac:

    # bet "Nadie me había dicho que Aaron era un clon tuyo."
    bet "Personne ne m'avait dit qu'Aaron était un clone de toi."

# game/scripts/c27/c27.rpy:1264
translate french c27s002_AaronVC_221ba789:

    # mc "¡Mierda, Tía [bet]! No se te puede ocultar nada. No se lo hemos dicho a nadie todavía."
    mc "Zut alors, tante [bet] ! Tu ne peux rien nous cacher. On n'a encore rien dit à personne."

# game/scripts/c27/c27.rpy:1265
translate french c27s002_AaronVC_27a325bb:

    # bet "Veros a la vez lo hace obvio. Seguramente no lo hubiera notado si os viera por separado. Como mucho hubiera pensado que tenéis un cierto parecido."
    bet "Vous voir tous les deux ensemble, c'est flagrant. Je ne l'aurais probablement pas remarqué si je vous avais vus séparément. Tout au plus, j'aurais pensé que vous vous ressembliez un peu."

# game/scripts/c27/c27.rpy:1266
translate french c27s002_AaronVC_0b02bf49:

    # mc "Ni Mamá ni Tía [nor] lo notaron durante la reunión que tuvimos con él..."
    mc "Ni maman ni tante ne l'ont remarqué lors de notre rencontre avec lui..."

# game/scripts/c27/c27.rpy:1268
translate french c27s002_AaronVC_a01aaafe:

    # bet "*Risa* Supongo que sólo tenían ojos para [ama] y [eva]."
    bet "*Rires* J'imagine qu'ils n'avaient d'yeux que pour [ama] et [eva]."

# game/scripts/c27/c27.rpy:1269
translate french c27s002_AaronVC_ab8af0b0:

    # bet "Además, la diferencia de edad aparente hace que el cerebro no os relacione. Nuestro cerebro no está preparado para procesar algo así."
    bet "De plus, la différence d'âge apparente rend difficile pour le cerveau de faire le lien entre vous deux. Notre cerveau n'est pas programmé pour traiter ce genre d'information."

# game/scripts/c27/c27.rpy:1270
translate french c27s002_AaronVC_697acc41:

    # mc "Excepto el tuyo, por lo que parece..."
    mc "À part le vôtre, il semble..."

# game/scripts/c27/c27.rpy:1272
translate french c27s002_AaronVC_9a01a595:

    # aar "Le agradecería que no les dijera nada al resto de su familia, ni a [ama] y a [eva]."
    aar "Je vous serais reconnaissant de ne pas le dire au reste de votre famille, ni à [ama] et [eva]."

# game/scripts/c27/c27.rpy:1273
translate french c27s002_AaronVC_c806bbff:

    # aar "No quiero que se sientan obligados a considerarme parte de la familia sólo porque compartamos genes."
    aar "Je ne veux pas qu'ils se sentent obligés de me considérer comme un membre de la famille simplement parce que nous partageons des gènes."

# game/scripts/c27/c27.rpy:1274
translate french c27s002_AaronVC_17ef67ef:

    # aar "Y se lo quiero decir a mis chicas en persona."
    aar "Et je veux le dire à mes filles en personne."

# game/scripts/c27/c27.rpy:1276
translate french c27s002_AaronVC_f39fbdc6:

    # bet "Lo entiendo, aunque no lo comparta. Pero voy a ponerte una condición, Aaron. Deja de llamarme Sra. [bet.full] y llámame [bet]."
    bet "Je comprends, même si je ne suis pas d'accord. Mais je vais poser une condition, Aaron : arrête de m'appeler Mme [bet.full] et appelle-moi [bet]."

# game/scripts/c27/c27.rpy:1277
translate french c27s002_AaronVC_21b8e252:

    # bet "*Risa* No eres mi sobrino, pero eres el clon de [mc] y me siento rara viendo a su cara llamándome así."
    bet "*Rires* Tu n'es pas mon neveu, mais tu es le clone de [mc] et c'est bizarre de voir son visage m'appeler comme ça."

# game/scripts/c27/c27.rpy:1279
translate french c27s002_AaronVC_ca2214ee:

    # aar "Me parece una condición que puedo cumplir. Mientras no me obligue a llamarla Tía [bet]..."
    aar "Je pense que c'est une condition que je peux remplir. Du moment qu'elle ne m'oblige pas à l'appeler Tante [bet]..."

# game/scripts/c27/c27.rpy:1280
translate french c27s002_AaronVC_9f143587:

    # aar "Pero no quiero entretenerla más de lo necesario, con lo que, si no le importa, voy a ir al grano."
    aar "Mais je ne veux pas vous retenir plus longtemps que nécessaire, alors si vous le permettez, je vais aller droit au but."

# game/scripts/c27/c27.rpy:1281
translate french c27s002_AaronVC_a39c3339:

    # aar "No sé si se acuerda de Gavin..."
    aar "Je ne sais pas si vous vous souvenez de Gavin..."

# game/scripts/c27/c27.rpy:1283
translate french c27s002_AaronVC_e17e8f7f:

    # bet "Sí, el chico que perdió el brazo por lo que pasó en nuestra cocina. ¿Qué le pasa?"
    bet "Oui, le garçon qui a perdu son bras à cause de ce qui s'est passé dans notre cuisine. Qu'est-ce qui ne va pas chez lui ?"

# game/scripts/c27/c27.rpy:1285
translate french c27s002_AaronVC_0ac571ae:

    # aar "Necesita una operación, y no tenemos un neurocirujano disponible. Creo que usted podría ser una buena opción."
    aar "Elle a besoin d'une opération, et nous n'avons pas de neurochirurgien disponible. Je pense que vous pourriez être une bonne solution."

# game/scripts/c27/c27.rpy:1286
translate french c27s002_AaronVC_44514949:

    # aar "Como además... no es demasiado legal en los Estados Unidos... debería hacerse aquí."
    aar "Puisque ce n'est pas tout à fait légal aux États-Unis... il faudrait le faire ici."

# game/scripts/c27/c27.rpy:1288
translate french c27s002_AaronVC_301f5ad1:

    # bet "¿De qué tipo de operación estamos hablando, Aaron? ¿Por qué no es legal aquí?"
    bet "De quel genre d'opération parle-t-on, Aaron ? Pourquoi n'est-ce pas légal ici ?"

# game/scripts/c27/c27.rpy:1290
translate french c27s002_AaronVC_7ec91e4c:

    # "Aaron pasa alrededor de 10 minutos explicando la operación a un nivel que incluso tú puedes entender."
    "Aaron consacre environ 10 minutes à expliquer le fonctionnement à un niveau que même vous pouvez comprendre."

# game/scripts/c27/c27.rpy:1291
translate french c27s002_AaronVC_e06644f0:

    # "Lo entiendes tan bien que, cuando acaba con la explicación, tienes la boca abierta por la sorpresa."
    "Vous le comprenez si bien que, lorsqu'il a fini d'expliquer, vous restez bouche bée de surprise."

# game/scripts/c27/c27.rpy:1292
translate french c27s002_AaronVC_47d34dd9:

    # mcp "(¡Oh, Dios mío! ¡Eso es pura ciencia ficción!)"
    mcp "(Oh mon Dieu ! C'est de la pure science-fiction !)"

# game/scripts/c27/c27.rpy:1294
translate french c27s002_AaronVC_59639f94:

    # bet "Parece una operación complicada y no sé si tengo los conocimientos para hacerla. No creo que NADIE tenga los conocimientos para hacerla."
    bet "Cela semble être une opération compliquée, et je ne sais pas si j'ai les compétences nécessaires. Je ne pense pas que quiconque ait les compétences nécessaires."

# game/scripts/c27/c27.rpy:1295
translate french c27s002_AaronVC_792505a9:

    # bet "Mándame toda la documentación de la que has hablado y lo estudiaré. ¿Cuándo se debería hacer?"
    bet "Envoyez-moi tous les documents que vous avez mentionnés et je les examinerai. Quand cela devrait-il être fait ?"

# game/scripts/c27/c27.rpy:1297
translate french c27s002_AaronVC_90efe756:

    # aar "Por lo que me han dicho los cirujanos que tenemos aquí, cuanto antes mejor."
    aar "D'après ce que m'ont dit les chirurgiens présents ici, le plus tôt sera le mieux."

# game/scripts/c27/c27.rpy:1298
translate french c27s002_AaronVC_f2ecd04f:

    # aar "Lo ideal sería que, si decide hacerlo, acompañe a [mc] a Aruba cuando él venga."
    aar "Idéalement, si vous décidez de le faire, vous devriez accompagner [mc] à Aruba lorsqu'il viendra."

# game/scripts/c27/c27.rpy:1299
translate french c27s002_AaronVC_55699a5f:

    # aar "Una vez esté aquí, tendrá tiempo de comentar todo el proceso junto con el equipo."
    aar "Une fois sur place, vous aurez le temps de discuter de l'ensemble du processus avec l'équipe."

# game/scripts/c27/c27.rpy:1301
translate french c27s002_AaronVC_25fba1cb:

    # bet "Suena a un buen plan. Aún quedan unos días para que [mc] vaya y tendré tiempo de estudiar la documentación y confirmarte si me veo preparada para hacer esa operación."
    bet "Ça me semble une bonne idée. Il me reste encore quelques jours avant de partir, j'aurai donc le temps d'étudier les documents et de vous dire si je me sens prêt(e)."

# game/scripts/c27/c27.rpy:1302
translate french c27s002_AaronVC_d6328777:

    # bet "Si decidimos hacerlo, quiero tener el control absoluto en el proceso."
    bet "Si nous décidons de le faire, je veux avoir un contrôle total sur le processus."

# game/scripts/c27/c27.rpy:1303
translate french c27s002_AaronVC_c22ae55b:

    # bet "No quiero algo a medias tintas que pueda poner en peligro la vida del chico."
    bet "Je ne veux pas d'une solution bâclée qui pourrait mettre la vie du garçon en danger."

# game/scripts/c27/c27.rpy:1305
translate french c27s002_AaronVC_90466345:

    # aar "Me parece bien. Voy a pedirle al equipo que le mande toda la documentación lo antes posible."
    aar "Cela me convient. Je demanderai à l'équipe de vous envoyer toute la documentation au plus vite."

# game/scripts/c27/c27.rpy:1306
translate french c27s002_AaronVC_b0dea3e0:

    # aar "Y ahora les tengo que dejar. Debo entrar en otra reunión."
    aar "Et maintenant, je dois y aller. Je dois me rendre à une autre réunion."

# game/scripts/c27/c27.rpy:1307
translate french c27s002_AaronVC_afd0d15c:

    # aar "Gracias, Sra. ... Gracias, [bet]."
    aar "Merci, madame... Merci, [bet]."

# game/scripts/c27/c27.rpy:1309
translate french c27s002_AaronVC_411eccb5:

    # bet "¡Es increíble! Ya me parecía increíble lo de las pruebas de embarazo, pero esto..."
    bet "C'est incroyable ! Je pensais déjà que les tests de grossesse étaient incroyables, mais ça…"

# game/scripts/c27/c27.rpy:1310
translate french c27s002_AaronVC_af4552c0:

    # mc "Aún estoy asombrado. ¿Te ves preparada para hacerlo?"
    mc "Je suis encore émerveillé. Te sens-tu prêt à le faire ?"

# game/scripts/c27/c27.rpy:1312
translate french c27s002_AaronVC_0cb66e63:

    # bet "No hay nadie preparado para hacerlo en el mundo, excepto el tal Daniels, quizás. Ha tenido años para familiarizarse con cerebros que envejecen aceleradamente."
    bet "Personne au monde n'est préparé à le faire, sauf peut-être Daniels. Il a eu des années pour se familiariser avec le vieillissement accéléré du cerveau."

# game/scripts/c27/c27.rpy:1313
translate french c27s002_AaronVC_12e76d7a:

    # bet "Y estoy segura de que no soy la mejor opción para hacer esa operación, pero dudo que otros cirujanos con más reputación estuvieran dispuestos a hacerla."
    bet "Et je suis sûr que je ne suis pas le meilleur choix pour réaliser cette opération, mais je doute que d'autres chirurgiens, plus réputés, soient disposés à la faire."

# game/scripts/c27/c27.rpy:1314
translate french c27s002_AaronVC_e59d24df:

    # mc "Es comprensible. Por lo ilegal y porque habría que darles una información que no creo que NTR esté preparada para dar aún."
    mc "C'est compréhensible. Parce que c'est illégal, et parce que nous devrions leur fournir des informations que NTR n'est pas encore prête à communiquer, à mon avis."

# game/scripts/c27/c27.rpy:1316
translate french c27s002_AaronVC_25231bcf:

    # bet "*Risa* Decirle a alguien '¿Quieres hacer una operación ilegal en alguien que no debería existir?' no es la mejor forma de establecer un primer contacto."
    bet "*Rires* Demander à quelqu'un : « Voulez-vous pratiquer une opération illégale sur une personne qui ne devrait pas exister ? » n'est pas la meilleure façon d'établir un premier contact."

# game/scripts/c27/c27.rpy:1317
translate french c27s002_AaronVC_cc2bcafa:

    # mc "*Risa* Desde luego que no."
    mc "*Rires* Bien sûr que non."

# game/scripts/c27/c27.rpy:1319
translate french c27s002_AaronVC_f5e9527a:

    # mc "Hablando de cosas que no deberían existir... ¿Quieres hacerte la prueba de embarazo?"
    mc "En parlant de choses qui ne devraient pas exister… Voulez-vous faire un test de grossesse ?"

# game/scripts/c27/c27.rpy:1321
translate french c27s002_AaronVC_36f8ec43:

    # bet "No hace falta. Tengo una edad y..."
    bet "Ce n'est pas nécessaire. J'ai un certain âge et..."

# game/scripts/c27/c27.rpy:1322
translate french c27s002_AaronVC_772dccd7:

    # mc "Y me dijiste que las mujeres de la familia son fértiles hasta edades muy avanzadas..."
    mc "Et vous m'avez dit que les femmes de la famille sont fertiles jusqu'à un âge très avancé..."

# game/scripts/c27/c27.rpy:1324
translate french c27s002_AaronVC_d0baac51:

    # bet "Sí, pero no es lo que iba a decir. Mañana por la mañana me voy a Florida. Si hiciéramos la prueba ahora, no estaría lista cuando me fuera."
    bet "Oui, mais ce n'est pas ce que j'allais dire. Je pars pour la Floride demain matin. Si on faisait le test maintenant, je ne serais pas prêt(e) au moment de partir."

# game/scripts/c27/c27.rpy:1325
translate french c27s002_AaronVC_a9a4d97a:

    # bet "Si me hiciera la prueba, querría ver el resultado contigo. Habrá tiempo cuando vuelva de Florida, especialmente si voy a Aruba contigo."
    bet "Si je me fais tester, j'aimerais voir les résultats avec toi. J'aurai le temps à mon retour de Floride, surtout si je vais à Aruba avec toi."

# game/scripts/c27/c27.rpy:1326
translate french c27s002_AaronVC_f5271567:

    # mc "Me parece una buena idea."
    mc "Je pense que c'est une bonne idée."

# game/scripts/c27/c27.rpy:1329
translate french c27s002_AaronVC_1717c583:

    # bet "Voy a mi habitación a coger el móvil. Tengo ganas de recibir la información y empezar a estudiarla."
    bet "Je vais dans ma chambre chercher mon téléphone. J'ai hâte de recevoir les informations et de commencer à les étudier."

# game/scripts/c27/c27.rpy:1330
translate french c27s002_AaronVC_b8fcea38:

    # bet "Te veo luego, [mc]."
    bet "À plus tard, [mc]."

# game/scripts/c27/c27.rpy:1333
translate french c27s002_AaronVC_0eb93267:

    # mc "Te veo luego, [bet]."
    mc "À plus tard, [bet]."

# game/scripts/c27/c27.rpy:1335
translate french c27s002_AaronVC_9f881016:

    # mc "Te veo luego, Tía [bet]."
    mc "À plus tard, tante [bet]."

# game/scripts/c27/c27.rpy:1342
translate french c27s002_KiaEilNor_02f19c98:

    # "Mientras tanto, en el salón de [nor]..."
    "Pendant ce temps, dans le salon [nor]..."

# game/scripts/c27/c27.rpy:1344
translate french c27s002_KiaEilNor_2835e1d0:

    # kia "Lo siento, [nor], pero ya lo hemos decidido."
    kia "Je suis désolé, [nor], mais nous avons déjà décidé."

# game/scripts/c27/c27.rpy:1345
translate french c27s002_KiaEilNor_dbe376fe:

    # eil "No digas 'hemos decidido', Mamá. Di 'has decidido'. Yo no quiero irme. [eri] incluso me ha ofrecido compartir habitación cuando lleguen las chicas nuevas."
    eil "Ne dis pas « on a décidé », maman. Dis « c'est toi qui as décidé ». Je ne veux pas partir. [eri] Elle m'a même proposé une colocataire quand les nouvelles filles arriveront."

# game/scripts/c27/c27.rpy:1346
translate french c27s002_KiaEilNor_83b58739:

    # nor "No quiero meterme entre vosotras dos, pero si [eil] quiere quedarse en casa, es bienvenida."
    nor "Je ne veux pas m'immiscer entre vous deux, mais si [eil] veut rester à la maison, elle est la bienvenue."

# game/scripts/c27/c27.rpy:1348
translate french c27s002_KiaEilNor_b3d68f5a:

    # kia "Es nuestra casa. Deberíamos vivir allí una vez Solomon se vaya y podamos volver."
    kia "C'est notre maison. Nous devrions y vivre une fois que Salomon sera parti et que nous pourrons y retourner."

# game/scripts/c27/c27.rpy:1349
translate french c27s002_KiaEilNor_c13f6344:

    # kia "Quiero dejar de ser una carga para ti. Suficiente trabajo tendrás una vez lleguen las chicas nuevas."
    kia "Je veux arrêter d'être un fardeau pour toi. Tu auras assez de travail une fois que les nouvelles filles seront arrivées."

# game/scripts/c27/c27.rpy:1351
translate french c27s002_KiaEilNor_680bf2d7:

    # nor "No dais ningún trabajo, [kia]. ¿Comida? Viváis donde viváis espero que vengáis a comer o cenar todos los días."
    nor "Tu ne fais rien, [kia]. Et la nourriture ? Où que tu habites, je m'attends à ce que tu viennes déjeuner ou dîner tous les jours."

# game/scripts/c27/c27.rpy:1352
translate french c27s002_KiaEilNor_94bf2c09:

    # nor "Me fastidia que [sam] y [sim], [oma], [mad.nick], o [meg] sólo vengan un par de días por semana, tres como mucho, pero ellas nunca han vivido aquí."
    nor "Cela m'énerve que [sam] et [sim], [oma], [mad.nick] ou [meg] ne viennent que quelques jours par semaine, trois au maximum, mais qu'ils n'aient jamais vécu ici."

# game/scripts/c27/c27.rpy:1353
translate french c27s002_KiaEilNor_adfdc780:

    # nor "Si lo hicierais vosotras después de estas dos semanas... Sería como si la casa estuviera vacía."
    nor "Si vous le faisiez après ces deux semaines... ce serait comme si la maison était vide."

# game/scripts/c27/c27.rpy:1355
translate french c27s002_KiaEilNor_ad86e822:

    # eil "Bueno, más trabajo sí que damos. Hay más lavadoras que poner..."
    eil "Eh bien, cela crée certainement plus de travail. Il y a plus de vaisselle à faire…"

# game/scripts/c27/c27.rpy:1357
translate french c27s002_KiaEilNor_201ecad1:

    # nor "¿Cuántas lavadoras has puesto en la última semana, [eil]? ¿Cuántas ha puesto tu madre?"
    nor "Combien de lessives as-tu faites la semaine dernière, [eil] ? Et ta mère, combien en a-t-elle fait ?"

# game/scripts/c27/c27.rpy:1358
translate french c27s002_KiaEilNor_501253ad:

    # nor "¡Desde que vivís aquí, pongo menos lavadoras que nunca! Entre vosotras y mi madre me estáis quitando un montón de trabajo."
    nor "Depuis que tu habites ici, je fais beaucoup moins de lessive que jamais ! Entre toi et ma mère, vous me soulagez énormément."

# game/scripts/c27/c27.rpy:1360
translate french c27s002_KiaEilNor_89ee9a5f:

    # kia "Pero los gastos... La factura de la luz, del agua... la comida... todo eso te tiene que ocasionar gastos..."
    kia "Mais les dépenses… La facture d’électricité, la facture d’eau… la nourriture… tout cela a un coût…"

# game/scripts/c27/c27.rpy:1362
translate french c27s002_KiaEilNor_20ae6ea4:

    # nor "Aún no ha llegado ninguna factura desde que estáis aquí, pero no creo que sea mucho el incremento, por mucho rato que os paséis con el secador."
    nor "Aucune facture n'est arrivée depuis votre arrivée, mais je ne pense pas que l'augmentation sera importante, peu importe le temps que vous passerez avec le sèche-cheveux."

# game/scripts/c27/c27.rpy:1363
translate french c27s002_KiaEilNor_81f0583b:

    # nor "¿Quieres pagar por esos gastos? No seas ridícula, [kia]. No sois inquilinas. Sois familia."
    nor "Voulez-vous vraiment prendre en charge ces dépenses ? Allons donc ! Vous n’êtes pas des locataires, vous faites partie de la famille."

# game/scripts/c27/c27.rpy:1366
translate french c27s002_KiaEilNor_a908e873:

    # nor "Hablando de familia. ¿Ya le has dicho a [mc] lo del divorcio?"
    nor "En parlant de famille, as-tu déjà parlé du divorce à [mc] ?"

# game/scripts/c27/c27.rpy:1368
translate french c27s002_KiaEilNor_9eedc9e1:

    # kia "No, y le pedí a [oma] que no le dijera nada. No quiero decirle nada hasta no haber decidido dónde vamos a vivir."
    kia "Non, et j'ai demandé à [oma] de ne rien lui dire. Je ne veux rien lui dire tant qu'on n'aura pas décidé où on va habiter."

# game/scripts/c27/c27.rpy:1369
translate french c27s002_KiaEilNor_169a5014:

    # kia "Si lo supiera, seguro que me presionaría para que nos quedáramos aquí."
    kia "S'il le savait, il me ferait certainement pression pour que je reste ici."

# game/scripts/c27/c27.rpy:1371
translate french c27s002_KiaEilNor_14da87d0:

    # eil "Aún no conoces a [mc] lo suficiente, Mamá. Él buscaría soluciones y argumentos para que no te fueras."
    eil "Tu ne connais pas encore assez bien [mc], maman. Il trouverait des solutions et des arguments pour t'empêcher de partir."

# game/scripts/c27/c27.rpy:1372
translate french c27s002_KiaEilNor_482ce281:

    # eil "Pero no te presionaría. La decisión es tuya y él la aceptará. Sólo te propondrá alternativas."
    eil "Mais je ne vous mettrais pas la pression. La décision vous appartient et il l'acceptera. Il vous proposera simplement d'autres solutions."

# game/scripts/c27/c27.rpy:1374
translate french c27s002_KiaEilNor_0ccef5d8:

    # kia "¿Y crees que eso no sería una forma de presión? Llevamos juntos diez días y le digo que me voy de casa para vivir en nuestra casa."
    kia "Et vous ne pensez pas que ce serait une forme de pression ? Nous sommes ensemble depuis dix jours et je lui dis que je quitte la maison pour vivre chez nous."

# game/scripts/c27/c27.rpy:1375
translate french c27s002_KiaEilNor_f398d692:

    # kia "Si empieza a proponer alternativas y las rechazo todas... parecerá que no quiero vivir en la misma casa que él..."
    kia "S'il commence à proposer des solutions de rechange et que je les rejette toutes... on aura l'impression que je ne veux pas vivre sous le même toit que lui..."

# game/scripts/c27/c27.rpy:1376
translate french c27s002_KiaEilNor_d384f096:

    # kia "Por eso es mejor hacerlo ahora que lo hemos decidido."
    kia "C'est pourquoi il vaut mieux le faire maintenant que nous avons pris notre décision."

# game/scripts/c27/c27.rpy:1379
translate french c27s002_KiaEilNor_e37e927c:

    # kia "Bueno, da lo mismo. Nos iremos de casa para vivir en nuestra casa. Ya te he dicho que lo hemos decidido."
    kia "Bon, peu importe. On quitte notre maison pour vivre dans la nôtre. Je te l'ai déjà dit, c'est décidé."

# game/scripts/c27/c27.rpy:1381
translate french c27s002_KiaEilNor_e30ee04a:

    # eil "Y yo te he dicho que no 'hemos decidido' nada. Tú has tomado tu decisión. Yo la mía."
    eil "Et je t'ai dit qu'on n'avait rien « décidé ». Tu as pris ta décision. J'ai pris la mienne."

# game/scripts/c27/c27.rpy:1382
translate french c27s002_KiaEilNor_83a18851:

    # eil "[nor] ha dicho que soy bienvenida, con lo que me voy a quedar aquí."
    eil "[nor] a dit que je suis le bienvenu, alors je vais rester ici."

# game/scripts/c27/c27.rpy:1384
translate french c27s002_KiaEilNor_298ea3bb:

    # nor "¿De verdad quieres volver a vivir en esa casa? ¿Tú sola?"
    nor "Voulez-vous vraiment revivre dans cette maison ? Seule ?"

# game/scripts/c27/c27.rpy:1385
translate french c27s002_KiaEilNor_24e69273:

    # nor "Lo único que te va a traer son malos recuerdos. Si [eil] fuera contigo, podríais crear recuerdos nuevos."
    nor "Cela ne vous apportera que de mauvais souvenirs. Si [eil] était avec vous, vous pourriez en créer de nouveaux."

# game/scripts/c27/c27.rpy:1386
translate french c27s002_KiaEilNor_18f3a71a:

    # nor "Pero le he ofrecido quedarse, ha aceptado, y no voy a retirar la invitación."
    nor "Mais je lui ai proposé de l'héberger, il a accepté, et je ne vais pas retirer mon invitation."

# game/scripts/c27/c27.rpy:1388
translate french c27s002_KiaEilNor_d378074d:

    # kia "Lo sé, pero no es que quiera. Es que debo. Me estáis haciendo sentir incómoda con tanta amabilidad."
    kia "Je sais, mais ce n'est pas que j'en aie envie. C'est que je suis obligée. Toute cette gentillesse me met mal à l'aise."

# game/scripts/c27/c27.rpy:1389
translate french c27s002_KiaEilNor_dc33e4a4:

    # kia "Una vez Solomon se vaya de casa, las circunstancias que os obligaron a acogernos habrán desaparecido."
    kia "Une fois que Solomon aura quitté la maison, les circonstances qui vous ont obligés à nous accueillir auront disparu."

# game/scripts/c27/c27.rpy:1391
translate french c27s002_KiaEilNor_f5ed110f:

    # nor "*Risa* ¿Obligado? ¿Te has dado un golpe en la cabeza?"
    nor "*Rires* Forcé ? Tu t'es cogné la tête ?"

# game/scripts/c27/c27.rpy:1392
translate french c27s002_KiaEilNor_f21ef800:

    # nor "Que viváis aquí es una de las mejores cosas que le han pasado a esta familia."
    nor "Votre présence ici est l'une des meilleures choses qui soient jamais arrivées à cette famille."

# game/scripts/c27/c27.rpy:1393
translate french c27s002_KiaEilNor_da6f0423:

    # nor "¡Entre vosotras, las estudiantes, mi madre y mi tía, la casa está más viva que nunca!"
    nor "Entre vous, les élèves, ma mère et ma tante, la maison est plus vivante que jamais !"

# game/scripts/c27/c27.rpy:1395
translate french c27s002_KiaEilNor_5744ade3:

    # bet "He oído que alguien me nombraba... ¿Qué estáis discutiendo, si puedo preguntarlo?"
    bet "J'ai entendu quelqu'un parler de moi... De quoi parlez-vous, si je peux me permettre ?"

# game/scripts/c27/c27.rpy:1397
translate french c27s002_KiaEilNor_a7808cc3:

    # nor "Hola, Tía [bet]."
    nor "Bonjour, tante [bet]."

# game/scripts/c27/c27.rpy:1398
translate french c27s002_KiaEilNor_a2fa1dd8:

    # eil "Mi madre se ha vuelto idiota y quiere volver a nuestra casa..."
    eil "Ma mère est devenue idiote et veut revenir vivre chez nous..."

# game/scripts/c27/c27.rpy:1399
translate french c27s002_KiaEilNor_503cd810:

    # kia "¡[eil]!"
    kia "[eil]!"

# game/scripts/c27/c27.rpy:1401
translate french c27s002_KiaEilNor_5974aad6:

    # bet "Desde luego que te has vuelto idiota. ¿Quieres volver a vivir con Solomon?"
    bet "Tu es vraiment devenu un idiot. Tu veux retourner vivre avec Solomon ?"

# game/scripts/c27/c27.rpy:1403
translate french c27s002_KiaEilNor_a45339fc:

    # bet "¿Ahora que estás con [mc]? ¿Estás loca?"
    bet "Maintenant que tu es avec [mc] ? Tu es fou ?"

# game/scripts/c27/c27.rpy:1405
translate french c27s002_KiaEilNor_a8f10047:

    # kia "No, no sería vivir con Solomon. Me ha pedido el divorcio y me cede la casa. Se irá... no sé cuándo se irá."
    kia "Non, je ne vivrai pas avec Solomon. Il m'a demandé le divorce et me laisse la maison. Il partira… Je ne sais pas quand."

# game/scripts/c27/c27.rpy:1407
translate french c27s002_KiaEilNor_798b8523:

    # nor "Y como [kia] ya era idiota de antes, cree que es una carga en casa y por eso quiere volver allí."
    nor "Et comme [kia] était déjà un idiot avant, il pense qu'il est un fardeau à la maison et c'est pourquoi il veut y retourner."

# game/scripts/c27/c27.rpy:1408
translate french c27s002_KiaEilNor_56a3b283:

    # kia "*Risa* ¡[nor]! ¿Todo el mundo va a llamarme idiota hoy?"
    kia "*Rires* [nor]! Est-ce que tout le monde va me traiter d'idiot aujourd'hui ?"

# game/scripts/c27/c27.rpy:1409
translate french c27s002_KiaEilNor_9cf97917:

    # eil "*Risa* Tiene razón. No en que seas una carga, claro. Ya querías irte antes de la fiesta de cumpleaños."
    eil "*Rires* Elle a raison. Non pas que tu sois un fardeau, bien sûr. Tu voulais partir avant la fête d'anniversaire."

# game/scripts/c27/c27.rpy:1410
translate french c27s002_KiaEilNor_e37d0cb8:

    # eil "Si todo el mundo te llama idiota, por algo será..."
    eil "Si tout le monde vous traite d'idiot, c'est qu'il doit y avoir une raison..."

# game/scripts/c27/c27.rpy:1412
translate french c27s002_KiaEilNor_6ec5ceb3:

    # bet "¿Puedo hacerte una propuesta, [kia]?"
    bet "Puis-je vous faire une proposition, [kia] ?"

# game/scripts/c27/c27.rpy:1413
translate french c27s002_KiaEilNor_959b35cb:

    # bet "Conseguirías lo que quieres y todas conseguiríamos que sigas viviendo 'en casa', que es lo que queremos el resto."
    bet "Tu obtiendrais ce que tu veux, et nous ferions tous en sorte que tu continues à vivre « chez toi », ce que nous souhaitons tous."

# game/scripts/c27/c27.rpy:1414
translate french c27s002_KiaEilNor_63f50414:

    # bet "¿Cuántas habitaciones tiene tu casa?"
    bet "Combien de pièces compte votre maison ?"

# game/scripts/c27/c27.rpy:1416
translate french c27s002_KiaEilNor_cb585557:

    # kia "Cuatro, pero no lo entiendo. Son cosas incompatibles. O vivo aquí o no vivo aquí."
    kia "Quatre, mais je ne comprends pas. Ce sont des choses incompatibles. Soit je vis ici, soit je n'y vis pas."

# game/scripts/c27/c27.rpy:1417
translate french c27s002_KiaEilNor_f44a2ca6:

    # kia "¿Y qué tiene que ver el número de habitaciones?"
    kia "Et quel rapport avec le nombre de pièces ?"

# game/scripts/c27/c27.rpy:1419
translate french c27s002_KiaEilNor_922dfd9c:

    # bet "[eri] y yo tenemos un plan. ¿Nos acogerías a [mee] y a mí durante unos meses?"
    bet "[eri] et moi avons un plan. Pourriez-vous nous accueillir, [mee] et moi, pendant quelques mois ?"

# game/scripts/c27/c27.rpy:1420
translate french c27s002_KiaEilNor_be97a80a:

    # bet "¿Y estarías interesada en vender tu casa y que construyéramos una aquí cerca si podemos comprar la parcela y construir en ella?"
    bet "Seriez-vous intéressé(e) par la vente de votre maison et par la construction d'une maison à proximité, si nous parvenons à acheter le terrain et à y construire ?"

# game/scripts/c27/c27.rpy:1422
translate french c27s002_KiaEilNor_a16bddfb:

    # eil "¿Qué?" (multiple=2)
    eil "Que?" (multiple=2)

# game/scripts/c27/c27.rpy:1423
translate french c27s002_KiaEilNor_6fbc6d77:

    # kia "*Jadeo* ¿QUÉ?" (multiple=2)
    kia "*Halètement* QUOI ?" (multiple=2)

# game/scripts/c27/c27.rpy:1424
translate french c27s002_KiaEilNor_3d5b5aa0:

    # nor "¿Qué? ¿Qué parcela, Tía [bet]?"
    nor "Quoi ? Quel complot, tante [bet] ?"

# game/scripts/c27/c27.rpy:1426
translate french c27s002_KiaEilNor_fe3866ab:

    # bet "Una de las que hay al otro lado de la carretera, o la de más allá de casa de [mar]."
    bet "L'une de celles qui se trouvent de l'autre côté de la route, ou celle qui est au-delà de la maison de [mar]."

# game/scripts/c27/c27.rpy:1427
translate french c27s002_KiaEilNor_2f0196e1:

    # bet "Si conseguimos comprarla, voy a proponerle a [mee] que, en vez de comprar o alquilar algo en el centro, construyamos una casa ahí."
    bet "Si nous parvenons à l'acheter, je vais suggérer à [mee] qu'au lieu d'acheter ou de louer quelque chose en centre-ville, nous y construisions une maison."

# game/scripts/c27/c27.rpy:1428
translate french c27s002_KiaEilNor_7093ea9b:

    # bet "Si [kia] quiere, puede unirse a la iniciativa y podemos construir una casa más grande."
    bet "Si [kia] le souhaite, il peut se joindre à l'initiative et nous pourrons construire une maison plus grande."

# game/scripts/c27/c27.rpy:1430
translate french c27s002_KiaEilNor_e8b9b26a:

    # eil "¡Di que sí, Mamá!"
    eil "Dis oui, maman !"

# game/scripts/c27/c27.rpy:1431
translate french c27s002_KiaEilNor_c139524e:

    # kia "¡Me encantaría!"
    kia "J'adorerais !"

# game/scripts/c27/c27.rpy:1433
translate french c27s002_KiaEilNor_adfd03f6:

    # bet "¡Estupendo! Tendríamos que saber quiénes son los dueños de la parcela que elijamos, y saber si podremos construir."
    bet "Super ! Il nous faudrait savoir à qui appartient le terrain que nous choisissons et si nous pouvons y construire."

# game/scripts/c27/c27.rpy:1434
translate french c27s002_KiaEilNor_b27cf8bf:

    # bet "Supongo que después habrá que pedir permisos de construcción, pero de eso se ocupará [mee] si la convenzo..."
    bet "Je suppose qu'il faudra demander des permis de construire ensuite, mais [mee] s'en occupera si j'arrive à la convaincre..."

# game/scripts/c27/c27.rpy:1436
translate french c27s002_KiaEilNor_bf87f68f:

    # nor "*Risa*"
    nor "*Rire*"

# game/scripts/c27/c27.rpy:1438
translate french c27s002_KiaEilNor_f2d2447c:

    # bet "¿De qué te ríes, [nor]?"
    bet "De quoi ris-tu, [nor] ?"

# game/scripts/c27/c27.rpy:1440
translate french c27s002_KiaEilNor_63896659:

    # nor "Las tres parcelas que hay al otro lado de la carretera, las tres de detrás de las casas, y la que hay más allá de casa de [mar] no las podréis comprar."
    nor "Vous ne pourrez pas acheter les trois parcelles de terrain de l'autre côté de la route, les trois derrière les maisons, et celle au-delà de la maison de [mar]."

# game/scripts/c27/c27.rpy:1441
translate french c27s002_KiaEilNor_41086b3d:

    # nor "La propietaria es una bruja que no os las va a vender."
    nor "La propriétaire est une sorcière qui ne vous les vendra pas."

# game/scripts/c27/c27.rpy:1442
translate french c27s002_KiaEilNor_2328c337:

    # nor "¡Son mías desde hace años! Las compró Mike para que nadie pudiera construir cerca nuestro."
    nor "Elles sont à moi depuis des années ! Mike les a achetées pour que personne ne puisse construire près de chez nous."

# game/scripts/c27/c27.rpy:1443
translate french c27s002_KiaEilNor_b6a58c0b:

    # nor "Os las cederé gustosa, con un par de condiciones."
    nor "Je vous les donnerai volontiers, sous certaines conditions."

# game/scripts/c27/c27.rpy:1445
translate french c27s002_KiaEilNor_ecbc4eeb:

    # nor "La primera es que mientras dure la construcción, vendréis todos los días a comer y a cenar."
    nor "Premièrement, pendant la durée des travaux, vous devrez venir déjeuner et dîner tous les jours."

# game/scripts/c27/c27.rpy:1446
translate french c27s002_KiaEilNor_3e7ede50:

    # nor "La segunda es que te unas al proyecto de mi madre y mi tía."
    nor "La deuxième chose, c'est que vous rejoigniez le projet de ma mère et de ma tante."

# game/scripts/c27/c27.rpy:1447
translate french c27s002_KiaEilNor_9b067bcf:

    # nor "Y no vas a dejar que dos ancianitas se tengan que ir lejos de su familia por no unirte a ellas, ¿verdad?"
    nor "Et vous n'allez tout de même pas laisser deux vieilles dames s'éloigner de leurs familles simplement parce que vous ne voulez pas les accompagner, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1449
translate french c27s002_KiaEilNor_dac768f2:

    # eil "¿Qué? ¿Son tuyas?" (multiple=2)
    eil "Quoi ? Ils sont à vous ?" (multiple=2)

# game/scripts/c27/c27.rpy:1450
translate french c27s002_KiaEilNor_96439efb:

    # kia "¿Qué? ¡Claro que me uniría!" (multiple=2)
    kia "Quoi ? Bien sûr que je participerais !" (multiple=2)

# game/scripts/c27/c27.rpy:1452
translate french c27s002_KiaEilNor_92cfab91:

    # bet "¿Qué?"
    bet "Que?"

# game/scripts/c27/c27.rpy:1454
translate french c27s002_KiaEilNor_13a3db2e:

    # nor "*Risa* ¿Por qué creéis que mi parcela es más pequeña que la de [mar] y no tiene piscina?"
    nor "*Rires* À votre avis, pourquoi mon terrain est-il plus petit que celui de [mar] et n'a-t-il pas de piscine ?"

# game/scripts/c27/c27.rpy:1455
translate french c27s002_KiaEilNor_b3bb7bc0:

    # nor "Mike se dejó un dineral en esas parcelas. Siempre quiso que las usara alguien de la familia cuando se quisiera independizar."
    nor "Mike a dépensé une fortune pour ces terrains. Il a toujours souhaité qu'un membre de la famille puisse les utiliser lorsqu'il voudrait prendre son indépendance."

# game/scripts/c27/c27.rpy:1456
translate french c27s002_KiaEilNor_f7d79988:

    # nor "Creo que estaría contento de que seáis vosotras, aunque nunca le cayó muy bien Mamá."
    nor "Je pense qu'il serait heureux si c'était toi, même s'il n'a jamais vraiment aimé maman."

# game/scripts/c27/c27.rpy:1458
translate french c27s002_KiaEilNor_c2c8a80f:

    # bet "*Risa* Esto parece el inicio del 'Barrio Marks'."
    bet "*Rires* On dirait le début de « Marks Neighborhood »."

# game/scripts/c27/c27.rpy:1460
translate french c27s002_KiaEilNor_85364476:

    # "Las cuatro mujeres empiezan a hacer planes sobre la construcción de la casa."
    "Les quatre femmes commencent à faire des plans pour construire la maison."

# game/scripts/c27/c27.rpy:1461
translate french c27s002_KiaEilNor_e452ac4f:

    # "Son castillos en el aire, ya que ni siquiera [nor] sabe qué hay que hacer para construir en esas parcelas."
    "Ce sont des châteaux en Espagne, puisque même [nor] ne sait pas ce qu'il faut faire pour construire sur ces parcelles."

# game/scripts/c27/c27.rpy:1462
translate french c27s002_KiaEilNor_9ab84de7:

    # "Pero la ilusión de no separar a la familia es mayor que la posibilidad de que surjan problemas."
    "Mais le désir de préserver l'unité familiale est plus fort que la possibilité de problèmes."

# game/scripts/c27/c27.rpy:1468
translate french c27s002_AmaAtCollege1_325ec4ea:

    # "Pocos minutos después de que [bet] se haya ido..."
    "Quelques minutes après le départ de [bet]..."

# game/scripts/c27/c27.rpy:1470
translate french c27s002_AmaAtCollege1_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1473
translate french c27s002_AmaAtCollege1_feac9063:

    # mc "Hola, [ama]. ¿Cómo ha ido?"
    mc "Salut, [ama]. Comment ça va ?"

# game/scripts/c27/c27.rpy:1476
translate french c27s002_AmaAtCollege1_2389a3ff:

    # ama "¡Horrible! ¡Odio a los Washington!"
    ama "Horrible ! Je déteste les Washington !"

# game/scripts/c27/c27.rpy:1477
translate french c27s002_AmaAtCollege1_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Ce qui s'est passé?"

# game/scripts/c27/c27.rpy:1479
translate french c27s002_AmaAtCollege1_ded31857:

    # ama "¡[sam] me ha hecho comer dos raciones de pierogi!"
    ama "[sam] Il m'a fait manger deux portions de pierogi !"

# game/scripts/c27/c27.rpy:1480
translate french c27s002_AmaAtCollege1_82e20e44:

    # ama "¡Casi no puedo moverme! Voy a tener que correr muchos kilómetros en la cinta para quemar todas esas calorías."
    ama "J'ai du mal à bouger ! Je vais devoir courir des kilomètres sur le tapis roulant pour brûler toutes ces calories."

# game/scripts/c27/c27.rpy:1481
translate french c27s002_AmaAtCollege1_d1ca4ed9:

    # mc "*Risa* Los pierogi de [sam.nick] están buenísimos."
    mc "*Rires* Les pierogis de [sam.nick] sont délicieux."

# game/scripts/c27/c27.rpy:1483
translate french c27s002_AmaAtCollege1_61725a62:

    # ama "¡Están deliciosos! Pero después de los primeros diez..."
    ama "Ils sont délicieux ! Mais après les dix premiers..."

# game/scripts/c27/c27.rpy:1484
translate french c27s002_AmaAtCollege1_8d2ab383:

    # ama "Ahora mismo estoy mirando por el retrovisor con miedo de que salga con una bandeja para que me la lleve a la base."
    ama "En ce moment, je regarde dans le rétroviseur, craignant qu'il ne sorte avec un plateau pour me ramener à la base."

# game/scripts/c27/c27.rpy:1485
translate french c27s002_AmaAtCollege1_a34d9996:

    # mc "¿Te has comido diez pierogis? No me extraña que no puedas moverte."
    mc "Tu as mangé dix pierogis ? Pas étonnant que tu n'arrives plus à bouger."

# game/scripts/c27/c27.rpy:1487
translate french c27s002_AmaAtCollege1_99f222e0:

    # ama "He dicho los primeros diez... [sam.nick] me ha obligado a seguir comiendo..."
    ama "J'ai dit les dix premiers... [sam.nick] m'a forcé à continuer à manger..."

# game/scripts/c27/c27.rpy:1488
translate french c27s002_AmaAtCollege1_2a9865b8:

    # mc "*Risa* ¿Qué hacía Jamaal mientras tanto?"
    mc "*Rires* Que faisait Jamaal pendant ce temps-là ?"

# game/scripts/c27/c27.rpy:1490
translate french c27s002_AmaAtCollege1_2f2c36d8:

    # ama "Fingía llorar en un rincón porque me estaba comiendo sus pierogis. Pero finge muy mal. Se le escapaba la risa."
    ama "Elle a fait semblant de pleurer dans un coin parce que je mangeais ses pierogis. Mais c'est une piètre actrice. Elle n'arrêtait pas de rire."

# game/scripts/c27/c27.rpy:1491
translate french c27s002_AmaAtCollege1_58c545e8:

    # ama "Había comida para alimentar un regimiento de soldados hambrientos."
    ama "Il y avait assez de nourriture pour nourrir un régiment de soldats affamés."

# game/scripts/c27/c27.rpy:1492
translate french c27s002_AmaAtCollege1_1d179161:

    # mc "Acostúmbrate a las comidas de [sam]."
    mc "Habituez-vous aux repas de [sam]."

# game/scripts/c27/c27.rpy:1493
translate french c27s002_AmaAtCollege1_6cb4d253:

    # mc "¿Y el otro tema? ¿Cómo ha ido?"
    mc "Et l'autre problème ? Comment cela s'est-il passé ?"

# game/scripts/c27/c27.rpy:1495
translate french c27s002_AmaAtCollege1_7354ada8:

    # ama "Igual de mal. Pero al final ha firmado."
    ama "Tout aussi mauvais. Mais finalement, il a signé."

# game/scripts/c27/c27.rpy:1496
translate french c27s002_AmaAtCollege1_a0eb44d1:

    # mc "Si ha firmado no habrá ido tan mal, ¿no?"
    mc "S'il a signé, ça ne doit pas s'être trop mal passé, non ?"

# game/scripts/c27/c27.rpy:1497
translate french c27s002_AmaAtCollege1_ee7272f3:

    # ama "Jamaal les ha hecho entrar en razón, aunque parezca mentira."
    ama "Jamaal leur a fait entendre raison, même si cela paraît incroyable."

# game/scripts/c27/c27.rpy:1498
translate french c27s002_AmaAtCollege1_9dce10b0:

    # mc "A veces Jam es el más racional de esa familia. Algunas veces. De vez en cuando. En extrañas ocasiones."
    mc "Parfois, Jam est le plus rationnel de la famille. Parfois. Occasionnellement. Rarement."

# game/scripts/c27/c27.rpy:1500
translate french c27s002_AmaAtCollege1_fda6152b:

    # ama "No esperes agradecimiento de [sim], por cierto. Me han sacado que había sido idea mía."
    ama "Au fait, n'attendez pas de remerciements de la part de [sim]. Ils m'ont dit que c'était mon idée."

# game/scripts/c27/c27.rpy:1501
translate french c27s002_AmaAtCollege1_9dff03c6:

    # mc "¿Te han tendido una trampa y has caído? ¿En plan 'No te va a pasar nada si dices que la idea ha sido tuya'?"
    mc "Vous êtes-vous fait piéger et êtes-vous tombé dans le panneau ? Du genre : « Il ne vous arrivera rien si vous dites que c'était votre idée » ?"

# game/scripts/c27/c27.rpy:1503
translate french c27s002_AmaAtCollege1_604b1170:

    # ama "¡Exactamente eso! O más bien 'Estaríamos agradecidas si nos dices que has sido tú'."
    ama "Exactement ! Ou plutôt : « Nous vous serions reconnaissants de nous confirmer qu'il s'agit de vous. »"

# game/scripts/c27/c27.rpy:1504
translate french c27s002_AmaAtCollege1_6a084b8d:

    # ama "A veces odio a los civiles. ¡Estáis llenos de estratagemas traicioneras!"
    ama "Parfois, je déteste les civils. Vous êtes pleins de complots perfides !"

# game/scripts/c27/c27.rpy:1505
translate french c27s002_AmaAtCollege1_15cb9e7b:

    # mc "*Risa* Eso es lo que se siente cuando tienes una madre, [ama]. Le acabarás cogiendo el gusto."
    mc "*Rires* C'est ça, avoir une mère, [ama]. Tu finiras par t'y habituer."

# game/scripts/c27/c27.rpy:1507
translate french c27s002_AmaAtCollege1_53243ded:

    # ama "Bueno, voy a ir a la universidad a formalizar la inscripción de [sim]."
    ama "Eh bien, je vais à l'université pour officialiser l'inscription de [sim]."

# game/scripts/c27/c27.rpy:1508
translate french c27s002_AmaAtCollege1_cc7f096d:

    # mc "Ya que vas, ¿me puedes hacer un favor?"
    mc "Puisque tu y vas, peux-tu me rendre un service ?"

# game/scripts/c27/c27.rpy:1509
translate french c27s002_AmaAtCollege1_63831521:

    # ama "Sí, dime qué necesitas."
    ama "Oui, dites-moi ce dont vous avez besoin."

# game/scripts/c27/c27.rpy:1510
translate french c27s002_AmaAtCollege1_25177f8c:

    # mc "Matricula a [eil] también. En este caso, que lo cobren de mi cuenta."
    mc "Des frais d'inscription sont également à prévoir pour [eil]. Dans ce cas, veuillez les débiter de mon compte."

# game/scripts/c27/c27.rpy:1512
translate french c27s002_AmaAtCollege1_d6403d39:

    # ama "¿[eil]? No tengo su expediente. No sé en qué carrera tengo que matricularla..."
    ama "[eil] ? Je n'ai pas son dossier. Je ne sais pas dans quel programme je dois l'inscrire…"

# game/scripts/c27/c27.rpy:1513
translate french c27s002_AmaAtCollege1_cf25dae0:

    # mc "No te preocupes. Tienen el expediente en la universidad. Dejó la carrera el año pasado por culpa de Solomon."
    mc "Ne t'inquiète pas. Ils ont son dossier à l'université. Elle a abandonné ses études l'année dernière à cause de Solomon."

# game/scripts/c27/c27.rpy:1514
translate french c27s002_AmaAtCollege1_9472e3ca:

    # mc "Ahora que he cobrado el primer sueldo, puedo pagarle la inscripción para su último año. No tiene por qué pagar los errores de su padre."
    mc "Maintenant que j'ai reçu mon premier salaire, je peux payer ses frais d'inscription pour sa dernière année. Elle ne devrait pas avoir à payer pour les erreurs de son père."

# game/scripts/c27/c27.rpy:1516
translate french c27s002_AmaAtCollege1_f25db8ed:

    # ama "Es muy generoso por tu parte, pero no sé si podré hacerlo. Me costó conseguir una plaza para [sim], y..."
    ama "C'est très gentil de votre part, mais je ne sais pas si je pourrai le faire. C'était difficile de trouver une place pour [sim], et..."

# game/scripts/c27/c27.rpy:1517
translate french c27s002_AmaAtCollege1_3c7d659d:

    # mc "Si te ponen algún problema, pide ver al Decano Jonas y dile que vas de mi parte."
    mc "S'ils vous causent des problèmes, demandez à voir le doyen Jonas et dites-lui que vous êtes là pour moi."

# game/scripts/c27/c27.rpy:1519
translate french c27s002_AmaAtCollege1_b3e3dff0:

    # ama "Lo haré. Voy a ir yendo, antes de que se haga más tarde. Te veo luego."
    ama "Je le ferai. Je vais partir avant qu'il ne soit trop tard. À plus tard."

# game/scripts/c27/c27.rpy:1521
translate french c27s002_AmaAtCollege1_ec8c6a24:

    # mc "Hasta luego, [ama]."
    mc "À plus tard, [ama]."

# game/scripts/c27/c27.rpy:1536
translate french c27s002_LisShopping_63770401:

    # "Pasas un rato leyendo los informes financieros que te ha enviado Aaron. La contabilidad de Daniels era como mínimo 'creativa'."
    "Vous passez un peu de temps à lire les rapports financiers qu'Aaron vous a envoyés. La comptabilité de Daniels était, pour le moins, « créative »."

# game/scripts/c27/c27.rpy:1537
translate french c27s002_LisShopping_0ff8066f:

    # "La doble contabilidad es para novatos. Lo de Daniels, o lo de sus contables para ser más exactos, es verdadero arte para ocultar ingresos."
    "La double comptabilité est une affaire d'amateurs. Ce que fait Daniels, ou plus précisément ce que font ses comptables, relève du véritable art de dissimuler des revenus."

# game/scripts/c27/c27.rpy:1540
translate french c27s002_LisShopping_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c27/c27.rpy:1541
translate french c27s002_LisShopping_45867f07:

    # lis "*A través de la puerta* Soy yo, ¿puedo pasar?"
    lis "*À travers la porte* C'est moi, puis-je entrer ?"

# game/scripts/c27/c27.rpy:1542
translate french c27s002_LisShopping_8bd4ab17:

    # mc "Entra, [lis]."
    mc "Entrez, [lis]."

# game/scripts/c27/c27.rpy:1547
translate french c27s002_LisShopping_f23fa279:

    # lis "Hola, [mc]."
    lis "Bonjour, [mc]."

# game/scripts/c27/c27.rpy:1549
translate french c27s002_LisShopping_b6034917:

    # mc "Hola, Princesa. ¿Puedo ayudarte en algo?"
    mc "Bonjour, Princesse. Puis-je vous aider ?"

# game/scripts/c27/c27.rpy:1551
translate french c27s002_LisShopping_dad9dfe9:

    # mc "Hola, [lis]. ¿Puedo ayudarte en algo?"
    mc "Bonjour, [lis]. Puis-je vous aider ?"

# game/scripts/c27/c27.rpy:1553
translate french c27s002_LisShopping_31d57116:

    # lis "Venía a ver la cama nueva. ¡Es enorme! Van a ser geniales los abrazos de los domingos."
    lis "Je suis venue voir le nouveau lit. Il est immense ! Les câlins du dimanche vont être géniaux."

# game/scripts/c27/c27.rpy:1554
translate french c27s002_LisShopping_2513e8f2:

    # mc "*Risa* En el momento en que se corra la voz sobre los abrazos, estaremos 23 ahí. No sé si cabremos."
    mc "*Rires* Dès que l'info sur les câlins se répandra, on sera 23 ! Je ne sais pas si on pourra tous tenir."

# game/scripts/c27/c27.rpy:1555
translate french c27s002_LisShopping_251565a1:

    # mc "Creo que será mejor mover los abrazos al jardín de [nor]. Allí se podría unir incluso Jamaal. *Risa* Aquí no va a subir."
    mc "Je pense qu'il vaudrait mieux déplacer les câlins dans le jardin de [nor]. Même Jamaal pourrait se joindre à nous. *Rires* Il ne montera pas ici."

# game/scripts/c27/c27.rpy:1557
translate french c27s002_LisShopping_8aadbf33:

    # lis "Hablando de Jamaal..."
    lis "À propos de Jamaal..."

# game/scripts/c27/c27.rpy:1558
translate french c27s002_LisShopping_fcd7fd98:

    # mc "¿Qué pasa con él?"
    mc "Qu'est-ce qui ne va pas chez lui ?"

# game/scripts/c27/c27.rpy:1560
translate french c27s002_LisShopping_43b3e756:

    # lis "Esta mañana he visto a Anthony en la universidad. Me ha dicho que los viste juntos..."
    lis "J'ai croisé Anthony à la fac ce matin. Il m'a dit les avoir vus ensemble..."

# game/scripts/c27/c27.rpy:1561
translate french c27s002_LisShopping_68b347b2:

    # mc "Sí. No sabía que él me había visto."
    mc "Oui. Je ne savais pas qu'il m'avait vue."

# game/scripts/c27/c27.rpy:1562
translate french c27s002_LisShopping_a9ef2025:

    # lis "Bueno, por lo visto se lo ha dicho Jamaal... Y que te ha dicho que salen juntos..."
    lis "Apparemment, Jamaal le lui a dit… Et elle a dit qu’ils sortaient ensemble…"

# game/scripts/c27/c27.rpy:1563
translate french c27s002_LisShopping_fb2bf9d3:

    # mc "¿Y hay algún problema con eso? Supongo que tú no tienes ningún problema con que salgan juntos."
    mc "Et quel est le problème avec ça ? Je suppose que vous n'avez aucun problème avec le fait qu'ils sortent ensemble."

# game/scripts/c27/c27.rpy:1565
translate french c27s002_LisShopping_e004ddcd:

    # mc "Tú sales conmigo y Anthony con Jamaal. No veo que haya ningún problema."
    mc "Tu sors avec moi et Anthony sort avec Jamaal. Je n'y vois aucun problème."

# game/scripts/c27/c27.rpy:1567
translate french c27s002_LisShopping_2780200c:

    # lis "No lo digo por mí. Lo digo por ti."
    lis "Je ne dis pas ça pour moi-même. Je le dis pour vous."

# game/scripts/c27/c27.rpy:1568
translate french c27s002_LisShopping_2fd84506:

    # mc "¿Por mí? Yo me alegro mucho por Jamaal. Anthony es un tipo afortunado si está saliendo con él."
    mc "Pourquoi moi ? Je suis vraiment contente pour Jamaal. Anthony a bien de la chance s'il sort avec lui."

# game/scripts/c27/c27.rpy:1569
translate french c27s002_LisShopping_9c1b2634:

    # mc "*Risa* Y negaré haber dicho eso si alguna vez Jamaal me pregunta."
    mc "*Rires* Et je nierai avoir dit ça si Jamaal me le demande un jour."

# game/scripts/c27/c27.rpy:1571
translate french c27s002_LisShopping_eb66a83e:

    # lis "Espera... ¿qué te ha contado Jamaal sobre Anthony?"
    lis "Attends… qu’est-ce que Jamaal t’a dit à propos d’Anthony ?"

# game/scripts/c27/c27.rpy:1572
translate french c27s002_LisShopping_9bfad9b5:

    # mc "Todo. Cómo se conocieron, que tenía dudas sobre su sexualidad cuando estaba intentándolo contigo, cómo empezaron a salir cuando por fin se decidió..."
    mc "Tout. Leur rencontre, ses doutes sur sa sexualité lorsqu'elle essayait avec toi, le début de leur relation après qu'elle ait enfin pris sa décision…"

# game/scripts/c27/c27.rpy:1573
translate french c27s002_LisShopping_518fd08d:

    # mc "¿Por qué lo preguntas?"
    mc "Pourquoi demandez-vous?"

# game/scripts/c27/c27.rpy:1575
translate french c27s002_LisShopping_ad2d1023:

    # lis "Me parece raro que no hagas ninguna broma ingeniosa sobre que Jamaal ha acabado saliendo con una chica."
    lis "Je trouve étrange que tu ne fasses aucune blague spirituelle sur le fait que Jamaal finisse par sortir avec une fille."

# game/scripts/c27/c27.rpy:1576
translate french c27s002_LisShopping_e4ee6cd0:

    # lis "Aunque Anthony ya no es una chica, claro. Pero ya sabes... hay gente que no acepta a los trans o que hacen bromas de mal gusto."
    lis "Bien sûr, Anthony n'est plus une fille. Mais vous savez… il y a des gens qui n'acceptent pas les personnes transgenres ou qui font des blagues de mauvais goût."

# game/scripts/c27/c27.rpy:1577
translate french c27s002_LisShopping_4f2d4076:

    # mc "¿Ves? Eso no me lo había contado."
    mc "Tu vois ? Il ne me l'avait pas dit."

# game/scripts/c27/c27.rpy:1579
translate french c27s002_LisShopping_c0728b24:

    # lis "¡Oops! ¡Acabo de meter la pata!"
    lis "Oups ! J'ai fait une bêtise !"

# game/scripts/c27/c27.rpy:1581
translate french c27s002_LisShopping_b54e7bab:

    # lis "Cuando has dicho que te lo había contado todo y lo de sus dudas..."
    lis "Quand tu as dit qu'elle t'avait tout raconté, y compris ses doutes..."

# game/scripts/c27/c27.rpy:1582
translate french c27s002_LisShopping_191e4e86:

    # mc "Bueno, parece que me ha contado todo lo que creía que yo debía saber en ese momento."
    mc "Eh bien, il semble qu'il m'ait dit tout ce qu'il pensait que je devais savoir à ce moment-là."

# game/scripts/c27/c27.rpy:1583
translate french c27s002_LisShopping_4e762e96:

    # mc "Me dijo que había cosas que no tenía el derecho a contarme. Supongo que se refería a esto."
    mc "Il m'a dit qu'il y avait des choses qu'il n'avait pas le droit de me dire. Je suppose qu'il voulait dire ceci."

# game/scripts/c27/c27.rpy:1584
translate french c27s002_LisShopping_25464f9e:

    # mc "Pero me da lo mismo. Jamaal está contento y supongo que Anthony también. Es suficiente para mí."
    mc "Mais ça m'est égal. Jamaal est heureux, et j'imagine qu'Anthony l'est aussi. Ça me suffit."

# game/scripts/c27/c27.rpy:1586
translate french c27s002_LisShopping_88a8e731:

    # lis "Sí. Está muy contento. Lo ha pasado mal y estaba... confuso."
    lis "Oui. Il est très heureux. Il a traversé une période difficile et était… perdu."

# game/scripts/c27/c27.rpy:1587
translate french c27s002_LisShopping_fd2a5197:

    # lis "Cuando me lo explicó se sentía avergonzado, tanto por nuestra situación como por lo que ha tenido que pasar."
    lis "Lorsqu'il me l'a expliqué, il a eu honte, à la fois à cause de notre situation et à cause de ce qu'il avait dû endurer."

# game/scripts/c27/c27.rpy:1588
translate french c27s002_LisShopping_8faabc56:

    # lis "Me hizo prometer que no se lo contaría a nadie que lo conociera..."
    lis "Il m'a fait promettre de ne le dire à personne qui le connaissait..."

# game/scripts/c27/c27.rpy:1589
translate french c27s002_LisShopping_73d90374:

    # mc "*Risa* Y me lo has contado a mí por error. ¡Me encantan esos malentendidos!"
    mc "*Rires* Et vous me l'avez dit par erreur ! J'adore ces malentendus !"

# game/scripts/c27/c27.rpy:1591
translate french c27s002_LisShopping_b732c400:

    # lis "*Risa* ¡Me has dicho que te lo había explicado todo!"
    lis "*Rires* Tu m'as dit que je t'avais tout expliqué !"

# game/scripts/c27/c27.rpy:1592
translate french c27s002_LisShopping_671594a4:

    # mc "*Risa* Yo creía que me lo había explicado todo."
    mc "*Rires* Je croyais qu'il m'avait tout expliqué."

# game/scripts/c27/c27.rpy:1593
translate french c27s002_LisShopping_2379b883:

    # mc "Pero no te preocupes. A mí no se me escapará."
    mc "Mais ne vous inquiétez pas. Je ne l'échapperai pas."

# game/scripts/c27/c27.rpy:1595
translate french c27s002_LisShopping_43773600:

    # lis "¡Eres un capullo!"
    lis "Espèce d'idiot !"

# game/scripts/c27/c27.rpy:1596
translate french c27s002_LisShopping_aae7dd80:

    # mc "Es posible. *Risa* Me lo dicen mucho."
    mc "C'est possible. *Rires* On me le dit souvent."

# game/scripts/c27/c27.rpy:1598
translate french c27s002_LisShopping_b623dc96:

    # mc "Pero soy tu capullo."
    mc "Mais je suis ton crétin."

# game/scripts/c27/c27.rpy:1601
translate french c27s002_LisShopping_9f913e33:

    # lis "En eso tienes razón."
    lis "Vous avez raison sur ce point."

# game/scripts/c27/c27.rpy:1602
translate french c27s002_LisShopping_263518b6:

    # lis "Bueno, me voy, que tengo que coger el bus para ir a la tienda de [mad.nick]."
    lis "Bon, je dois y aller, je dois prendre le bus pour aller au magasin [mad.nick]."

# game/scripts/c27/c27.rpy:1603
translate french c27s002_LisShopping_aea36704:

    # mc "¿Vas a comprar más ropa? ¿No tienes suficientes con las cuatro maletas que trajiste?"
    mc "Tu vas acheter d'autres vêtements ? Les quatre valises que tu as apportées ne suffisent pas ?"

# game/scripts/c27/c27.rpy:1604
translate french c27s002_LisShopping_04d73e84:

    # mc "Mas todo lo que después trajeron los transportistas, claro. Tienes suerte de que tu habitación sea tan grande como la de [emm]."
    mc "Mais aussi tout ce que les livreurs ont apporté plus tard, bien sûr. Tu as de la chance que ta chambre soit aussi grande que celle de [emm]."

# game/scripts/c27/c27.rpy:1607
translate french c27s002_LisShopping_b5799758:

    # lis "*Risa* ¿Vas a decirle a tu princesa cuánta ropa tiene que tener?"
    lis "*Rires* Tu vas dire à ta princesse combien de vêtements elle doit avoir ?"

# game/scripts/c27/c27.rpy:1609
translate french c27s002_LisShopping_2e1ef9f2:

    # lis "*Risa* ¿Vas a decirle a una chica cuánta ropa tiene que tener?"
    lis "*Rires* Tu vas vraiment dire à une fille combien de vêtements elle devrait avoir ?"

# game/scripts/c27/c27.rpy:1610
translate french c27s002_LisShopping_b71b8e6f:

    # lis "Parece mentira que te hayas criado rodeado de mujeres."
    lis "C'est incroyable que tu aies grandi entourée de femmes."

# game/scripts/c27/c27.rpy:1611
translate french c27s002_LisShopping_e042d083:

    # mc "No me atrevería nunca a decir algo así. *Risa* Sólo preguntaba."
    mc "Je n'oserais jamais dire une chose pareille. *Rires* Je posais juste une question."

# game/scripts/c27/c27.rpy:1612
translate french c27s002_LisShopping_eb84c7af:

    # mc "Pero no hace falta que cojas el bus. Tengo que ir al centro a comprar unas cosas yo también."
    mc "Mais tu n'as pas besoin de prendre le bus. Je dois aussi aller en ville pour faire des courses."

# game/scripts/c27/c27.rpy:1613
translate french c27s002_LisShopping_08226d17:

    # mc "Las iba a comprar ayer, pero al encontrarme con Jamaal se me hizo tarde y me olvidé."
    mc "Je comptais les acheter hier, mais quand j'ai rencontré Jamaal, il s'est fait tard et j'ai oublié."

# game/scripts/c27/c27.rpy:1615
translate french c27s002_LisShopping_e8aab443:

    # lis "¡Genial! Voy a coger el bolso y te espero abajo."
    lis "Super ! Je prends mon sac et je t'attends en bas."

# game/scripts/c27/c27.rpy:1616
translate french c27s002_LisShopping_2cbcdd4a:

    # mc "¿Vas a ir así?"
    mc "Tu vas partir comme ça ?"

# game/scripts/c27/c27.rpy:1618
translate french c27s002_LisShopping_a4d0d076:

    # lis "¿No te gusta?"
    lis "Ça ne vous plaît pas ?"

# game/scripts/c27/c27.rpy:1619
translate french c27s002_LisShopping_fa5a65c6:

    # mc "¡Me encanta! Pero me sorprende que quieras ir así fuera de casa. Hace unas semanas te hubieras preocupado por si te veía algún conocido."
    mc "J'adore ! Mais je suis surprise que tu veuilles sortir comme ça. Il y a quelques semaines, tu aurais eu peur d'être vue par une connaissance."

# game/scripts/c27/c27.rpy:1621
translate french c27s002_LisShopping_d9877bfa:

    # lis "Hace unas semanas no sabía lo que era ser libre de todas esas tonterías."
    lis "Il y a quelques semaines, je ne savais pas ce que c'était que d'être libéré de toutes ces bêtises."

# game/scripts/c27/c27.rpy:1622
translate french c27s002_LisShopping_60799f78:

    # lis "No voy a renunciar a ello."
    lis "Je ne vais pas y renoncer."

# game/scripts/c27/c27.rpy:1627
translate french c27s002_LisShopping_fb4ba3d1:

    # lis "Hasta ahora mismo. No me canso de besarte."
    lis "Même maintenant. Je ne me lasse jamais de t'embrasser."

# game/scripts/c27/c27.rpy:1628
translate french c27s002_LisShopping_b93fdca1:

    # mc "Hasta ahora mismo. Espero que no lo hagas nunca."
    mc "Jusqu'à présent. J'espère que vous ne le ferez jamais."

# game/scripts/c27/c27.rpy:1630
translate french c27s002_LisShopping_a25a8417:

    # lis "Hasta ahora mismo."
    lis "Jusqu'à présent."

# game/scripts/c27/c27.rpy:1631
translate french c27s002_LisShopping_a11fc49b:

    # mc "Te veo en un momento."
    mc "Je te vois dans un instant."

# game/scripts/c27/c27.rpy:1634
translate french c27s002_LisShopping_c851925d:

    # "Conduces hasta la tienda de [mad.nick] y decides entrar a saludar."
    "Vous vous rendez en voiture au magasin [mad.nick] et décidez d'entrer et de dire bonjour."

# game/scripts/c27/c27.rpy:1637
translate french c27s002_LisShopping_0c800e50:

    # "Al llegar a la tienda, [mad.nick] está atendiendo a una clienta."
    "À son arrivée au magasin, [mad.nick] sert un client."

# game/scripts/c27/c27.rpy:1638
translate french c27s002_LisShopping_0db051fb:

    # mad "Buenas tardes, [lis] y [mc]. Dadme un segundo para que acabe una cosa."
    mad "Bonjour, [lis] et [mc]. Donnez-moi une seconde pour terminer quelque chose."

# game/scripts/c27/c27.rpy:1639
translate french c27s002_LisShopping_64f9baa0:

    # mc "No te preocupes."
    mc "Ne t'inquiète pas."

# game/scripts/c27/c27.rpy:1640
translate french c27s002_LisShopping_82c8f35a:

    # lis "Voy a ir mirando algo de ropa mientras acabas."
    lis "Je vais aller regarder des vêtements pendant que tu finis."

# game/scripts/c27/c27.rpy:1642
translate french c27s002_LisShopping_5b55aa52:

    # lis "Deberíamos haber venido antes. Cada vez que la madre de [mad.nick] viene, la pone de mal humor."
    lis "Nous aurions dû venir plus tôt. À chaque fois que la mère de [mad.nick] vient, elle la met de mauvaise humeur."

# game/scripts/c27/c27.rpy:1643
translate french c27s002_LisShopping_fa0df493:

    # mc "¿Es su madre?"
    mc "Est-ce votre mère ?"

# game/scripts/c27/c27.rpy:1645
translate french c27s002_LisShopping_9326a7d2:

    # lis "Sí, y su jefa. Tienen varias tiendas en el condado. Ella es la encargada de la tienda de Atascadero."
    lis "Oui, et son patron. Ils ont plusieurs magasins dans le comté. Elle gère celui d'Atascadero."

# game/scripts/c27/c27.rpy:1647
translate french c27s002_LisShopping_d8306e1e:

    # mcp "(Ahora entiendo por qué no quería que le mandara las pruebas del chantaje a su jefe.)"
    mcp "(Maintenant je comprends pourquoi il ne voulait pas que j'envoie les preuves de chantage à son patron.)"

# game/scripts/c27/c27.rpy:1648
translate french c27s002_LisShopping_9adfb6ba:

    # mcp "(Hubiera sido malo si sólo hubiera sido su jefe, pero si además es su madre...)"
    mcp "(Ce serait déjà grave si elle n'était que sa patronne, mais si elle est aussi sa mère...)"

# game/scripts/c27/c27.rpy:1649
translate french c27s002_LisShopping_de51f75b:

    # mc "No tenía ni idea."
    mc "Je n'en avais aucune idée."

# game/scripts/c27/c27.rpy:1651
translate french c27s002_LisShopping_7d909430:

    # lis "Cuando se trata de trabajo, la Sra. Chang no trata a [mad.nick] como a una hija sino como a una empleada."
    lis "En matière de travail, Mme Chang ne traite pas [mad.nick] comme une fille mais comme une employée."

# game/scripts/c27/c27.rpy:1652
translate french c27s002_LisShopping_a8f4664c:

    # lis "Y para dar ejemplo al resto de dependientas, es especialmente estricta con ella. Para que nadie la acuse de favoritismo."
    lis "Et pour donner l'exemple aux autres vendeuses, elle est particulièrement stricte avec elle. Ainsi, personne ne pourra l'accuser de favoritisme."

# game/scripts/c27/c27.rpy:1653
translate french c27s002_LisShopping_6f8e1b0f:

    # mc "Que la trate como a una empleada me parece lógico. Lo otro, no tanto."
    mc "La traiter comme une employée me semble logique. Le reste, beaucoup moins."

# game/scripts/c27/c27.rpy:1655
translate french c27s002_LisShopping_4b061d2f:

    # lis "Y si como jefa es mala, como madre es de las que están encima permanentemente."
    lis "Et si c'est une mauvaise patronne, en tant que mère, elle fait partie de celles qui sont constamment sur le dos de leurs enfants."

# game/scripts/c27/c27.rpy:1656
translate french c27s002_LisShopping_bbfccba4:

    # lis "Ella y su padre se mudaron a Atascadero hace unos años y [mad.nick] se quedó aquí. No les sentó bien."
    lis "Elle et son père ont déménagé à Atascadero il y a quelques années et y sont restés. Ils n'aimaient pas ça."

# game/scripts/c27/c27.rpy:1657
translate french c27s002_LisShopping_8edc108f:

    # lis "Desde entonces está encima de ella permanentemente. Intenta fiscalizar cómo vive, si tiene novio..."
    lis "Depuis, il la surveille constamment. Il essaie de contrôler sa vie, de savoir si elle a un petit ami…"

# game/scripts/c27/c27.rpy:1659
translate french c27s002_LisShopping_df7d90bf:

    # mc "Lo que me da a entender que no le ha dicho que estamos juntos."
    mc "Ce qui me laisse penser qu'il ne lui a pas dit que nous étions ensemble."

# game/scripts/c27/c27.rpy:1661
translate french c27s002_LisShopping_5a3493eb:

    # mc "Ni que hay un harén por en medio."
    mc "Non pas qu'il y ait un harem en jeu."

# game/scripts/c27/c27.rpy:1663
translate french c27s002_LisShopping_b14d78a4:

    # lis "Exacto. ¿Te imaginas contarle a alguien así que compartes novio con otras mujeres?"
    lis "Exactement. Imaginez dire à quelqu'un comme ça que vous partagez votre petit ami avec d'autres femmes ?"

# game/scripts/c27/c27.rpy:1665
translate french c27s002_LisShopping_ad103400:

    # mc "*Risa* Lo imagino perfectamente. Lo viví cuando Meemaw se enteró."
    mc "*Rires* Je peux tout à fait l'imaginer. Je l'ai vécu moi-même quand Mémé l'a découvert."

# game/scripts/c27/c27.rpy:1667
translate french c27s002_LisShopping_152bf4f7:

    # mc "*Risa* Es normal que quiera ocultárselo a su madre si es así."
    mc "*Rires* C'est normal qu'il veuille le cacher à sa mère si c'est le cas."

# game/scripts/c27/c27.rpy:1668
translate french c27s002_LisShopping_945a50b5:

    # lis "No todas las madres son como [mar]."
    lis "Toutes les mères ne sont pas comme [mar]."

# game/scripts/c27/c27.rpy:1671
translate french c27s002_LisShopping_3c1a0638:

    # lis "Exacto. Quiere ahorrarse las charlas. No todas las madres son como [mar]."
    lis "Exactement. Elle veut éviter les sermons. Toutes les mères ne sont pas comme ça."

# game/scripts/c27/c27.rpy:1672
translate french c27s002_LisShopping_43a9c5db:

    # lis "Si le dice que sale contigo, va a tener que pasar por un interrogatorio."
    lis "Si vous lui dites que vous sortez avec lui, il va devoir subir un interrogatoire."

# game/scripts/c27/c27.rpy:1674
translate french c27s002_LisShopping_8ec801d4:

    # mc "Y es normal que [mad.nick] no quiera decirle nada, supongo."
    mc "Et c'est normal que [mad.nick] ne veuille rien dire, je suppose."

# game/scripts/c27/c27.rpy:1676
translate french c27s002_LisShopping_fe35a080:

    # lis "Exacto. Cuanto más encima está de ella, más evita [mad.nick] decirle nada. No todas las madres son como [mar]."
    lis "Exactement. Plus il est collé à elle, moins elle lui adresse la parole. Toutes les mères ne sont pas comme ça."

# game/scripts/c27/c27.rpy:1678
translate french c27s002_LisShopping_2815e486:

    # lis "Ya sé que no es tu madre, pero es difícil verla de otra manera."
    lis "Je sais qu'elle n'est pas ta mère, mais j'ai du mal à la voir autrement."

# game/scripts/c27/c27.rpy:1679
translate french c27s002_LisShopping_a5a0c903:

    # mc "La verdad es que tengo mucha suerte."
    mc "La vérité, c'est que j'ai beaucoup de chance."

# game/scripts/c27/c27.rpy:1681
translate french c27s002_LisShopping_b5cfcca3:

    # mc "Hablando de madres... ¿Les has dicho algo a tus padres sobre nosotros?"
    mc "En parlant de mères… Avez-vous parlé de nous à vos parents ?"

# game/scripts/c27/c27.rpy:1683
translate french c27s002_LisShopping_951a1c91:

    # lis "Todavía no. Si lo hiciera, al día siguiente estarían aquí para conocerte. O en el mismo día, si se lo digo por la mañana."
    lis "Pas encore. Si je le faisais, ils seraient là pour vous accueillir le lendemain. Ou le jour même, si je leur disais le matin."

# game/scripts/c27/c27.rpy:1684
translate french c27s002_LisShopping_b0b7191c:

    # lis "No quiero ponerte en ese compromiso sin antes consultarlo contigo."
    lis "Je ne veux pas vous mettre dans cette situation sans vous consulter au préalable."

# game/scripts/c27/c27.rpy:1685
translate french c27s002_LisShopping_4de3387b:

    # mc "Si no te avergüenzas de mí o de nuestra relación, no tengo ningún problema en conocerlos."
    mc "Si vous n'avez pas honte de moi ni de notre relation, je n'ai aucun problème à les rencontrer."

# game/scripts/c27/c27.rpy:1687
translate french c27s002_LisShopping_7b42a386:

    # mc "Pero quedaría el tema de [deb.nick]. No sé si estarían muy contentos de que salga con sus dos princesas."
    mc "Mais il reste le problème de [deb.nick]. Je ne sais pas s'ils seraient très contents que je sorte avec leurs deux princesses."

# game/scripts/c27/c27.rpy:1689
translate french c27s002_LisShopping_86f99448:

    # lis "*Risa* Creía que la princesa era yo."
    lis "*Rires* Je me croyais la princesse."

# game/scripts/c27/c27.rpy:1690
translate french c27s002_LisShopping_d7ce8473:

    # mc "No sé si las dos sois sus princesas, pero las dos sois las mías."
    mc "Je ne sais pas si vous êtes toutes les deux ses princesses, mais vous êtes toutes les deux les miennes."

# game/scripts/c27/c27.rpy:1692
translate french c27s002_LisShopping_3bd9dca0:

    # lis "Seguramente si les dijéramos que las dos salimos contigo vendrían igual, pero con las escopetas de caza. *Risa*"
    lis "Je suis sûre que même si on leur disait qu'on était sortis tous les deux avec toi, ils viendraient quand même, mais avec des fusils de chasse. *Rires*"

# game/scripts/c27/c27.rpy:1693
translate french c27s002_LisShopping_2b3da418:

    # mc "Un enfrentamiento a tiros entre tus padres y [ama] y [eva]... *Risa* Interesante."
    mc "Une fusillade entre tes parents et [ama] et [eva]... *Rires* Intéressant."

# game/scripts/c27/c27.rpy:1695
translate french c27s002_LisShopping_0804bb63:

    # mc "Pero quedaría el tema del harén. No sé si estarían muy contentos de que salgas con alguien que sale con otras mujeres."
    mc "Mais il y a aussi la question du harem. Je ne sais pas s'ils seraient ravis que tu sortes avec quelqu'un qui fréquente d'autres femmes."

# game/scripts/c27/c27.rpy:1697
translate french c27s002_LisShopping_61fddefa:

    # lis "Seguramente si se lo dijera vendrían igual, pero con las escopetas de caza. *Risa*"
    lis "Je suis sûr que même si je leur disais, ils viendraient quand même, mais avec des fusils de chasse. *Rires*"

# game/scripts/c27/c27.rpy:1698
translate french c27s002_LisShopping_2b3da418_1:

    # mc "Un enfrentamiento a tiros entre tus padres y [ama] y [eva]... *Risa* Interesante."
    mc "Une fusillade entre tes parents et [ama] et [eva]... *Rires* Intéressant."

# game/scripts/c27/c27.rpy:1700
translate french c27s002_LisShopping_88a51c21:

    # lis "Pero, en serio, no me avergüenzo de nada, con lo que lo tendrán que aceptar. Pero prefiero dejar pasar un tiempo antes de decírselo."
    lis "Mais honnêtement, je n'ai honte de rien, alors ils devront l'accepter. Je préfère cependant attendre un peu avant de leur dire."

# game/scripts/c27/c27.rpy:1701
translate french c27s002_LisShopping_f8a615ba:

    # lis "Lo de 'Mamá, llevo tres semanas aquí y estoy saliendo con alguien' no quedaría muy bien a los ojos de mis padres."
    lis "Dire « Maman, je suis ici depuis trois semaines et je sors avec quelqu'un » ne serait pas très bien accueilli par mes parents."

# game/scripts/c27/c27.rpy:1702
translate french c27s002_LisShopping_e0425937:

    # mc "Se lo diremos cuando quieras. Cuenta conmigo para ello."
    mc "On lui dira quand tu seras prêt. Compte sur moi."

# game/scripts/c27/c27.rpy:1704
translate french c27s002_LisShopping_85e69441:

    # lis "Pienso que, como en el caso de [mad.nick], no tienen que tener voz ni voto en con quien salgo. Soy una adulta y es mi decisión."
    lis "Je pense que, comme dans le cas de [mad.nick], ils ne devraient pas avoir leur mot à dire sur les personnes que je fréquente. Je suis adulte et c'est ma décision."

# game/scripts/c27/c27.rpy:1705
translate french c27s002_LisShopping_312796d9:

    # mc "Estoy de acuerdo, pero supongo que quieren cuidar de ti y evitar que cometas errores."
    mc "Je suis d'accord, mais je suppose qu'ils veulent prendre soin de vous et vous éviter de faire des erreurs."

# game/scripts/c27/c27.rpy:1708
translate french c27s002_LisShopping_737cb19d:

    # mad "Ya hemos acabado, chicos. ¿En qué puedo ayudaros?"
    mad "C'est terminé, les gars. Comment puis-je vous aider ?"

# game/scripts/c27/c27.rpy:1710
translate french c27s002_LisShopping_38896d65:

    # mad "[mc], ven. Quiero presentarte a mi madre, Rose."
    mad "[mc], viens ici. Je veux te présenter ma mère, Rose."

# game/scripts/c27/c27.rpy:1712
translate french c27s002_LisShopping_8c8a1cab:

    # mc "Encantado de conocerla, Sra. Chang."
    mc "Enchantée de faire votre connaissance, Madame Chang."

# game/scripts/c27/c27.rpy:1713
translate french c27s002_LisShopping_e8bf7152:

    # "Sra. Chang" "Igualmente. ¿Eres amigo de mi hija?"
    "Sra. Chang" "De même. Êtes-vous une amie de ma fille ?"

# game/scripts/c27/c27.rpy:1714
translate french c27s002_LisShopping_bf617666:

    # mc "Sí, somos buenos amigos."
    mc "Oui, nous sommes de bons amis."

# game/scripts/c27/c27.rpy:1716
translate french c27s002_LisShopping_de7ec540:

    # "Sra. Chang" "Y no tendrás un amigo soltero, ¿verdad? Porque tú estás con [lis], ¿verdad?"
    "Sra. Chang" "Et tu n'auras pas un seul ami, n'est-ce pas ? Parce que tu es avec [lis], pas vrai ?"

# game/scripts/c27/c27.rpy:1717
translate french c27s002_LisShopping_71569921:

    # "Sra. Chang" "A este paso, [mad] va a parecer un meme. Llegará a los 30 sola y con su piso lleno de gatos. Ya ha empezado."
    "Sra. Chang" "À ce rythme, [mad] va devenir un mème. Elle aura 30 ans toute seule, avec son appartement rempli de chats. Ça a déjà commencé."

# game/scripts/c27/c27.rpy:1718
translate french c27s002_LisShopping_71b56c4c:

    # "Te cae mal inmediatamente. Sabes que [mad.nick] odia que la llamen [mad] y, pese a todo, su madre usa ese nombre. Te enfadas inmediatamente."
    "Vous la détestez immédiatement. Vous savez que [mad.nick] déteste qu'on l'appelle [mad], et pourtant sa mère utilise ce nom. Vous vous mettez immédiatement en colère."

# game/scripts/c27/c27.rpy:1719
translate french c27s002_LisShopping_219b4e47:

    # "Además, tiene una de esas sonrisas que no llegan a los ojos. Una sonrisa tan falsa como un billete naranja de 100 dólares."
    "En plus, elle a un de ces sourires qui n'atteignent pas ses yeux. Un sourire aussi faux qu'un billet de cent dollars."

# game/scripts/c27/c27.rpy:1720
translate french c27s002_LisShopping_c8725dbd:

    # mcp "(¿Quién eres tú para decidir cómo tiene que vivir su vida [mad.nick]?)"
    mcp "(Qui es-tu pour décider comment elle doit vivre sa vie [mad.nick] ?)"

# game/scripts/c27/c27.rpy:1721
translate french c27s002_LisShopping_fd49d41c:

    # mcp "(Si quiere tener diez gatos, ¿qué más da?)"
    mcp "(S'il veut avoir dix chats, quelle importance ?)"

# game/scripts/c27/c27.rpy:1722
translate french c27s002_LisShopping_cca94157:

    # "Tu enfado evita que pase por tu mente la idea de que, con diez gatos, vas a gastar un montón de dinero en camas."
    "Votre colère vous empêche de penser qu'avec dix chats, vous allez dépenser beaucoup d'argent en lits."

# game/scripts/c27/c27.rpy:1723
translate french c27s002_LisShopping_d2df6d5f:

    # mc "Tengo amigos solteros..."
    mc "J'ai des amis célibataires..."

# game/scripts/c27/c27.rpy:1724
translate french c27s002_LisShopping_1530b853:

    # "La sangre empieza a hervirte en las venas. Nunca has podido soportar este tipo de madre, y menos aún con lo que te ha dicho [lis]."
    "La colère vous monte au cœur. Vous n'avez jamais supporté ce genre de mère, et encore moins après ce que [lis] vous a dit."

# game/scripts/c27/c27.rpy:1727
translate french c27s002_LisShopping_6ab204f3:

    # "Miras a [mad.nick], que entiende tu pregunta y da su aprobación con un ligero asentimiento."
    "Vous regardez [mad.nick], qui comprend votre question et approuve d'un léger hochement de tête."

# game/scripts/c27/c27.rpy:1729
translate french c27s002_LisShopping_d92193b9:

    # mc "Pero no se preocupe. No va a llegar sola ni a los 30 ni a los 27."
    mc "Mais ne vous inquiétez pas. Elle n'atteindra pas 30 ou 27 ans toute seule."

# game/scripts/c27/c27.rpy:1733
translate french c27s002_LisShopping_41f36e33:

    # "Rodeas a la diminuta mujer pese a su cara de perplejidad y besas dulcemente a [mad.nick]."
    "Tu tournes autour de la petite femme malgré son expression perplexe et tu l'embrasses doucement [mad.nick]."

# game/scripts/c27/c27.rpy:1734
translate french c27s002_LisShopping_eaf682cd:

    # "Al principio se tensa un poco por la sorpresa, quizás has malinterpretado su asentimiento."
    "Surpris, il se raidit un peu ; vous avez peut-être mal interprété son hochement de tête."

# game/scripts/c27/c27.rpy:1735
translate french c27s002_LisShopping_aa25d2fb:

    # "No tarda en devolverte el beso. Abrazándote con fuerza. Como un náufrago agarrándose a una madera en medio de una tormenta."
    "Il n'hésite pas à lui rendre son baiser. Il te serre fort dans ses bras. Comme un naufragé s'accrochant à un morceau de bois au milieu d'une tempête."

# game/scripts/c27/c27.rpy:1737
translate french c27s002_LisShopping_7b9f2754:

    # "Cuando vuelves a mirar a la odiosa mujer, su cara de sorpresa es genuina. Ya no hay falsedad en ella."
    "Quand on regarde à nouveau cette femme odieuse, son expression de surprise est authentique. Il n'y a plus aucune feinte."

# game/scripts/c27/c27.rpy:1738
translate french c27s002_LisShopping_7d6cecab:

    # mc "Va a llegar a los 30, a los 60, o a los 90 conmigo, si ella quiere."
    mc "Elle atteindra 30, 60 ou même 90 ans avec moi, si elle le souhaite."

# game/scripts/c27/c27.rpy:1739
translate french c27s002_LisShopping_bb4942ae:

    # "Sra. Chang" "¿Qué? ¿Cuándo? ¿Desde cuándo?"
    "Sra. Chang" "Quoi ? Quand ? Depuis quand ?"

# game/scripts/c27/c27.rpy:1740
translate french c27s002_LisShopping_b58a242e:

    # "Sabes que enemistarte con tu futura suegra nada más conocerla no es una buena idea. Pero tienes que dejarle las cosas claras desde el principio."
    "Vous savez bien qu'il n'est pas judicieux de se mettre votre future belle-mère à dos dès la première rencontre. Mais il est important d'être clair avec elle dès le départ."

# game/scripts/c27/c27.rpy:1741
translate french c27s002_LisShopping_db7d7c16:

    # mc "Si [mad.nick] no se lo ha querido contar, pregúntese por qué."
    mc "Si [mad.nick] n'a pas voulu vous le dire, demandez-vous pourquoi."

# game/scripts/c27/c27.rpy:1742
translate french c27s002_LisShopping_fccbb515:

    # mc "Adiós, Sra. Chang. Yo que usted, empezaría a llamar a [mad.nick] por el nombre que ella prefiere."
    mc "Au revoir, Mme Chang. Si j'étais vous, j'appellerais [mad.nick] par le nom qu'elle préfère."

# game/scripts/c27/c27.rpy:1744
translate french c27s002_LisShopping_5fa20d9d:

    # mc "Te espero en el café en el que te esperé la primera vez que fuimos a tu piso."
    mc "Je t'attendrai au café où je t'ai attendu la première fois que nous sommes allés chez toi."

# game/scripts/c27/c27.rpy:1745
translate french c27s002_LisShopping_2aa284cc:

    # "Falta menos de una hora para que cierre la tienda."
    "Il reste moins d'une heure avant la fermeture du magasin."

# game/scripts/c27/c27.rpy:1746
translate french c27s002_LisShopping_fcab085b:

    # mad "Hasta luego, [mc]."
    mad "À plus tard, [mc]."

# game/scripts/c27/c27.rpy:1750
translate french c27s002_LisShopping_d3295029:

    # "Rodeas a la diminuta mujer pese a su cara de perplejidad y abrazas fuertemente a [mad.nick]."
    "Vous tournez autour de la petite femme malgré son expression perplexe et vous serrez [mad.nick] fort dans vos bras."

# game/scripts/c27/c27.rpy:1751
translate french c27s002_LisShopping_ecb4615c:

    # "Su sorpresa no evita que te devuelva el abrazo. Con fuerza. Como un náufrago agarrándose a una madera en medio de una tormenta."
    "Sa surprise ne l'empêche pas de lui rendre son étreinte. Fortement. Comme un naufragé agrippé à un morceau de bois flotté au milieu d'une tempête."

# game/scripts/c27/c27.rpy:1752
translate french c27s002_LisShopping_e1686f81:

    # mc "*Susurro* No estás sola."
    mc "*Chuchotement* Tu n'es pas seul."

# game/scripts/c27/c27.rpy:1754
translate french c27s002_LisShopping_7b9f2754_1:

    # "Cuando vuelves a mirar a la odiosa mujer, su cara de sorpresa es genuina. Ya no hay falsedad en ella."
    "Quand on regarde à nouveau cette femme odieuse, son expression de surprise est authentique. Il n'y a plus aucune feinte."

# game/scripts/c27/c27.rpy:1755
translate french c27s002_LisShopping_30bafe72:

    # mc "Va a llegar a los 30, a los 60, o a los 90 con una familia que no se mete en cómo vive su vida."
    mc "Il atteindra 30, 60 ou 90 ans avec une famille qui ne s'immisce pas dans sa vie privée."

# game/scripts/c27/c27.rpy:1756
translate french c27s002_LisShopping_48ffa719:

    # mcp "(Y si por eso entiendes que estamos juntos, es tu problema.)"
    mcp "(Et si cela vous laisse penser que nous sommes ensemble, c'est votre problème.)"

# game/scripts/c27/c27.rpy:1757
translate french c27s002_LisShopping_bb4942ae_1:

    # "Sra. Chang" "¿Qué? ¿Cuándo? ¿Desde cuándo?"
    "Sra. Chang" "Quoi ? Quand ? Depuis quand ?"

# game/scripts/c27/c27.rpy:1758
translate french c27s002_LisShopping_db7d7c16_1:

    # mc "Si [mad.nick] no se lo ha querido contar, pregúntese por qué."
    mc "Si [mad.nick] n'a pas voulu vous le dire, demandez-vous pourquoi."

# game/scripts/c27/c27.rpy:1759
translate french c27s002_LisShopping_fccbb515_1:

    # mc "Adiós, Sra. Chang. Yo que usted, empezaría a llamar a [mad.nick] por el nombre que ella prefiere."
    mc "Au revoir, Mme Chang. Si j'étais vous, j'appellerais [mad.nick] par le nom qu'elle préfère."

# game/scripts/c27/c27.rpy:1761
translate french c27s002_LisShopping_1eaba6f4:

    # mc "Te espero para tomar un café en las galerías cuando cierres, [mad.nick]."
    mc "Je t'attendrai pour prendre un café dans les galeries après la fermeture, [mad.nick]."

# game/scripts/c27/c27.rpy:1762
translate french c27s002_LisShopping_2aa284cc_1:

    # "Falta menos de una hora para que cierre la tienda."
    "Il reste moins d'une heure avant la fermeture du magasin."

# game/scripts/c27/c27.rpy:1763
translate french c27s002_LisShopping_2d9ac33c:

    # mad "Me parece una idea genial, [mc]."
    mad "Je pense que c'est une excellente idée, [mc]."

# game/scripts/c27/c27.rpy:1765
translate french c27s002_LisShopping_eeaa46a4:

    # "Te diriges a despedirte de [lis]."
    "Vous allez dire au revoir à [lis]."

# game/scripts/c27/c27.rpy:1767
translate french c27s002_LisShopping_89ccbad9:

    # "Hay algo en su mirada que te dice que no es buena idea besarla para despedirte."
    "Il y a dans son regard quelque chose qui vous dit que ce n'est pas une bonne idée de l'embrasser pour lui dire au revoir."

# game/scripts/c27/c27.rpy:1768
translate french c27s002_LisShopping_883f391b:

    # mc "¿Necesitas que te lleve a casa luego?"
    mc "Vous voulez que je vous raccompagne après ?"

# game/scripts/c27/c27.rpy:1769
translate french c27s002_LisShopping_4cab6c6e:

    # lis "*Susurrando* No hace falta, gracias. Voy a quedarme aquí hasta que [mad.nick] cierre para evitar que su madre la bombardee a preguntas."
    lis "*Chuchotant* Pas besoin, merci. Je resterai ici jusqu'à la fermeture de [mad.nick] pour éviter que sa mère ne l'assaille de questions."

# game/scripts/c27/c27.rpy:1771
translate french c27s002_LisShopping_2d45dde2:

    # lis "*Susurrando* Después cogeré un Under para volver a casa y os dejo solos tomando ese café."
    lis "*Chuchotant* Alors je vais prendre un Under pour rentrer chez moi et vous laisser tous les deux prendre votre café tranquillement."

# game/scripts/c27/c27.rpy:1773
translate french c27s002_LisShopping_57f7bd9a:

    # lis "*Susurrando* Después la acompañaré a ese café, si no te importa."
    lis "*Chuchotant* Je l'accompagnerai à ce café plus tard, si cela ne vous dérange pas."

# game/scripts/c27/c27.rpy:1774
translate french c27s002_LisShopping_82347b9c:

    # mc "Para nada. Eres bienvenida a ese café."
    mc "Pas du tout. Vous êtes le bienvenu dans ce café."

# game/scripts/c27/c27.rpy:1776
translate french c27s002_LisShopping_7b54a79b:

    # lis "*Susurrando* ¡Eso ha sido increíble!"
    lis "*Chuchotant* C'était incroyable !"

# game/scripts/c27/c27.rpy:1777
translate french c27s002_LisShopping_8deaffbb:

    # "No podías imaginar que [lis] pudiera saltar tanto."
    "Vous n'auriez jamais imaginé que [lis] puisse sauter aussi loin."

# game/scripts/c27/c27.rpy:1778
translate french c27s002_LisShopping_d8907418:

    # lis "*Susurrando* Cómo has dejado a su madre con la boca abierta... No mires, pero sigue con la boca abierta."
    lis "*Chuchotant* Comment as-tu laissé sa mère sans voix… Ne regarde pas, mais garde la bouche ouverte."

# game/scripts/c27/c27.rpy:1780
translate french c27s002_LisShopping_e18668d3:

    # lis "*Susurrando* Empiezo a estar un poco menos asustada porque conozcas a mis padres."
    lis "*À voix basse* Je commence à avoir un peu moins peur que tu rencontres mes parents."

# game/scripts/c27/c27.rpy:1781
translate french c27s002_LisShopping_bdfb1a38:

    # mc "*Susurrando* ¿Estabas asustada por mí? *Risa*"
    mc "*Chuchotant* Tu avais peur de moi ? *Rires*"

# game/scripts/c27/c27.rpy:1782
translate french c27s002_LisShopping_6223ac9c:

    # lis "*Susurrando* Un poco. Pero ahora empiezo a estar asustada por ellos. *Risa*"
    lis "*Chuchotant* Un peu. Mais maintenant, j'ai peur d'eux. *Rires*"

# game/scripts/c27/c27.rpy:1784
translate french c27s002_LisShopping_9d61532f:

    # mc "*Risa* Te veo en casa."
    mc "*Rires* On se voit à la maison."

# game/scripts/c27/c27.rpy:1786
translate french c27s002_LisShopping_ea439639:

    # mc "*Risa* Te veo en el café."
    mc "*Rires* On se voit au café."

# game/scripts/c27/c27.rpy:1788
translate french c27s002_LisShopping_de647f73:

    # "Te vas de la tienda sin una palabra más. Sintiéndote un como un personaje de una serie policiaca mala ambientada en Miami."
    "Vous quittez le magasin sans un mot de plus. Vous vous sentez comme un personnage d'une mauvaise série policière se déroulant à Miami."

# game/scripts/c27/c27.rpy:1789
translate french c27s002_LisShopping_fd996490:

    # "Sólo te falta ser pelirrojo y tener unas gafas de sol."
    "Il suffit d'être roux et d'avoir des lunettes de soleil."

# game/scripts/c27/c27.rpy:1791
translate french c27s002_LisShopping_4c5c7d99:

    # "Y una explosión detrás tuyo. Casi esperas escuchar la cabeza de la madre de [mad.nick] explotar en cualquier momento."
    "Et une explosion derrière vous. Vous vous attendez presque à entendre la tête de la mère de [mad.nick] exploser à tout moment."

# game/scripts/c27/c27.rpy:1797
translate french c27s002_AmaAtCollege2_1bb26e2a:

    # "Nada más salir de la tienda..."
    "Dès que j'ai quitté le magasin..."

# game/scripts/c27/c27.rpy:1799
translate french c27s002_AmaAtCollege2_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1802
translate french c27s002_AmaAtCollege2_3b5b6806:

    # mc "Hola, [ama]. ¿Algún problema en la universidad?"
    mc "Salut, [ama]. Des problèmes à l'université ?"

# game/scripts/c27/c27.rpy:1804
translate french c27s002_AmaAtCollege2_ef4f1672:

    # ama "Ya he hecho lo de [sim]. Pero hay un problema con lo de [eil]."
    ama "J'ai déjà fait la partie [sim]. Mais il y a un problème avec la partie [eil]."

# game/scripts/c27/c27.rpy:1805
translate french c27s002_AmaAtCollege2_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Ce qui s'est passé?"

# game/scripts/c27/c27.rpy:1807
translate french c27s002_AmaAtCollege2_93cc5a15:

    # ama "Alguien ha pagado su matrícula. Se te han adelantado."
    ama "Quelqu'un a déjà payé leurs frais de scolarité. Il vous a devancé."

# game/scripts/c27/c27.rpy:1808
translate french c27s002_AmaAtCollege2_087a9f9f:

    # mc "¿Quién ha sido? ¿Lo has podido averiguar?"
    mc "Qui était-ce ? Avez-vous pu le découvrir ?"

# game/scripts/c27/c27.rpy:1810
translate french c27s002_AmaAtCollege2_7f9e2ed4:

    # ama "Me ha atendido Anthony y no me ha querido decir quién lo ha hecho, pero me lo puedo imaginar. [lis] y [deb.nick]."
    ama "Anthony m'a aidé et n'a pas voulu me dire qui l'avait fait, mais je peux l'imaginer. [lis] et [deb.nick]."

# game/scripts/c27/c27.rpy:1811
translate french c27s002_AmaAtCollege2_06df0aab:

    # mc "Tiene lógica. Hasta ayer eran las únicas a las que les sobraba el dinero para hacerlo."
    mc "C'est logique. Jusqu'à hier, ils étaient les seuls à avoir les moyens de le faire."

# game/scripts/c27/c27.rpy:1812
translate french c27s002_AmaAtCollege2_c6a16c9b:

    # mc "Me extraña que no hayan hecho lo mismo con [sim]."
    mc "Je suis surpris qu'ils n'aient pas fait la même chose avec [sim]."

# game/scripts/c27/c27.rpy:1814
translate french c27s002_AmaAtCollege2_790b0888:

    # ama "Sobre eso, a Anthony se le ha escapado algo. Ha dicho, 'Ellas lo intentaron, pero no teníamos su expediente'."
    ama "Anthony a laissé échapper quelque chose à ce sujet. Il a dit : « Ils ont essayé, mais nous n'avions pas leur dossier. »"

# game/scripts/c27/c27.rpy:1815
translate french c27s002_AmaAtCollege2_21ef7a27:

    # ama "Ese 'Ellas' deja muy claro quiénes son."
    ama "Le fait qu'ils utilisent le pronom « Ils » indique très clairement de qui il s'agit."

# game/scripts/c27/c27.rpy:1816
translate french c27s002_AmaAtCollege2_14280410:

    # mc "*Risa* Por suerte no lo consiguieron, o te hubieras quedado sin los pierogis de agradecimiento."
    mc "*Rires* Heureusement qu'ils n'ont pas réussi, sinon vous auriez raté les pierogis de remerciement."

# game/scripts/c27/c27.rpy:1818
translate french c27s002_AmaAtCollege2_7137c4fb:

    # ama "*Risa* ¡No me hables de pierogis! Se me remueven en el estómago y a la vez tengo una sensación de antojo."
    ama "*Rires* Ne me parlez même pas de pierogi ! Ça me donne la nausée et j'en ai soudainement envie."

# game/scripts/c27/c27.rpy:1819
translate french c27s002_AmaAtCollege2_5c8c93f4:

    # mc "*Risa* ¿Sabes que cada vez estoy más orgulloso de todas vosotras?"
    mc "*Rires* Vous savez, je suis de plus en plus fier de vous tous ?"

# game/scripts/c27/c27.rpy:1821
translate french c27s002_AmaAtCollege2_61a8b7ac:

    # ama "¿Por hacer lo que ibas a hacer tú? ¿No te sientes cómo si te hubieran robado la oportunidad de hacer algo por [eil]?"
    ama "Pour avoir fait ce que vous aviez prévu de faire ? N'avez-vous pas l'impression qu'on vous a volé l'opportunité de faire quelque chose pour [eil] ?"

# game/scripts/c27/c27.rpy:1822
translate french c27s002_AmaAtCollege2_678d7865:

    # mc "No lo hacía por 'hacer algo por ella'. El objetivo era que ella volviera a estudiar, no que nadie me lo agradeciera."
    mc "Je ne le faisais pas pour « lui rendre service ». Le but était qu'elle reprenne ses études, pas que quiconque me remercie."

# game/scripts/c27/c27.rpy:1823
translate french c27s002_AmaAtCollege2_3d693cf9:

    # mc "Da lo mismo si el objetivo se ha cumplido gracias a las hermanas o a mí. Lo importante es que [eil] va a poder volver a la universidad."
    mc "Peu importe que cet objectif ait été atteint grâce aux sœurs ou à moi. L'important, c'est que [eil] puisse retourner à l'université."

# game/scripts/c27/c27.rpy:1825
translate french c27s002_AmaAtCollege2_f1f6e6e7:

    # ama "Al menos, a ti no te engordarán con una tonelada de pierogis."
    ama "Au moins, vous ne grossirez pas en mangeant des tonnes de pierogis."

# game/scripts/c27/c27.rpy:1826
translate french c27s002_AmaAtCollege2_8ae1333a:

    # mc "Tienes que aprender que incluso a [sam.nick] le puedes decir que no quieres más."
    mc "Tu dois apprendre que tu peux même dire [sam.nick] que tu n'en veux plus."

# game/scripts/c27/c27.rpy:1828
translate french c27s002_AmaAtCollege2_8c8535bb:

    # ama "Pero estaban tan buenos..."
    ama "Mais ils étaient tellement bons..."

# game/scripts/c27/c27.rpy:1829
translate french c27s002_AmaAtCollege2_cbf18df4:

    # mc "Y es agradable sentir el agradecimiento, ¿verdad?"
    mc "Et c'est agréable de ressentir cette gratitude, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1831
translate french c27s002_AmaAtCollege2_1d834f65:

    # ama "Es una pasada. No por el agradecimiento en sí, sino por lo bien que me estaba sintiendo yo por haber pensado en una forma de ayudar."
    ama "C'est incroyable. Non pas à cause de la gratitude en elle-même, mais à cause du bien-être que j'ai ressenti en ayant trouvé un moyen d'aider."

# game/scripts/c27/c27.rpy:1832
translate french c27s002_AmaAtCollege2_1308f261:

    # ama "Ver la alegría de [sim] porque por fin va a poder ir a la universidad ha sido increíble."
    ama "Voir la joie de [sim] parce qu'elle va enfin pouvoir aller à l'université a été incroyable."

# game/scripts/c27/c27.rpy:1833
translate french c27s002_AmaAtCollege2_fbe1e849:

    # ama "Saber que la idea que ha propiciado esa alegría ha sido mía... No sé... Produce una sensación de calor en el estómago."
    ama "Savoir que l'idée qui a provoqué cette joie était la mienne... Je ne sais pas... Cela me procure une sensation de chaleur dans le ventre."

# game/scripts/c27/c27.rpy:1834
translate french c27s002_AmaAtCollege2_24ef719a:

    # mc "*Risa* ¡Eso eran los pierogis!"
    mc "*Rires* C'est ça, les pierogis !"

# game/scripts/c27/c27.rpy:1836
translate french c27s002_AmaAtCollege2_7b8555d9:

    # ama "*Risa* ¡Capullo! ¡No voy a comer en dos días!"
    ama "*Rires* Espèce d'idiot ! Je ne vais pas manger pendant deux jours !"

# game/scripts/c27/c27.rpy:1837
translate french c27s002_AmaAtCollege2_d2e0dce1:

    # mc "¿No vienes a cenar a casa hoy?"
    mc "Tu ne viens pas dîner ce soir ?"

# game/scripts/c27/c27.rpy:1838
translate french c27s002_AmaAtCollege2_4dbefcfe:

    # ama "*Risa* Sí. Por eso no he dicho en qué dos días. Seguramente me ponga a dieta cuando lleguemos a Aruba."
    ama "*Rires* Oui. C'est pour ça que je n'ai pas précisé les deux jours. Je me mettrai probablement au régime une fois à Aruba."

# game/scripts/c27/c27.rpy:1839
translate french c27s002_AmaAtCollege2_f6149705:

    # mc "*Risa* ¿Entiendes ahora por qué estaba gordo?"
    mc "*Rires* Vous comprenez maintenant pourquoi j'étais gros ?"

# game/scripts/c27/c27.rpy:1841
translate french c27s002_AmaAtCollege2_cfacdf2c:

    # ama "Lo que no entiendo es cómo no te deprimiste cuando fuiste a Portland y tuviste que dejar de comer los platos de [mar], [nor], y [sam.nick]."
    ama "Ce que je ne comprends pas, c'est comment tu n'as pas déprimé quand tu es allé à Portland et que tu as dû arrêter de manger les plats de [mar], [nor] et [sam.nick]."

# game/scripts/c27/c27.rpy:1842
translate french c27s002_AmaAtCollege2_27082def:

    # mc "*Risa* Busqué un jefe que era un gourmet. Comer con él varios días por semana sirvió como sustituto."
    mc "*Rires* Je cherchais un patron qui soit un fin gourmet. Manger avec lui plusieurs fois par semaine faisait office de substitut."

# game/scripts/c27/c27.rpy:1844
translate french c27s002_AmaAtCollege2_f9d36ec2:

    # ama "Bueno, [mc]. Te voy a dejar. Quiero ir a la base a ducharme antes de ir a casa a cenar. ¿Te veo luego?"
    ama "D'accord, [mc]. Je te quitte. Je veux retourner à la base prendre une douche avant de rentrer dîner. À plus tard ?"

# game/scripts/c27/c27.rpy:1846
translate french c27s002_AmaAtCollege2_29bccd48:

    # mc "No lo sé. Acabo de salir de la tienda de [mad.nick] y he tenido un encontronazo con su madre."
    mc "Je ne sais pas. Je viens de sortir du magasin [mad.nick] et j'ai eu une altercation avec sa mère."

# game/scripts/c27/c27.rpy:1847
translate french c27s002_AmaAtCollege2_dd8fe5c9:

    # mc "Le he dicho que esperaré a que cierre para tomar un café. No sé qué haremos luego."
    mc "Je lui ai dit que j'attendrais la fermeture pour qu'on prenne un café. Je ne sais pas ce qu'on fera après."

# game/scripts/c27/c27.rpy:1849
translate french c27s002_AmaAtCollege2_b2f6b87d:

    # ama "Vete a cenar con ella. Por lo que he oído, la madre es una bruja y seguro que [mad.nick] necesita un poco de apoyo."
    ama "Va dîner avec elle. D'après ce que j'ai entendu, sa mère est une sorcière et elle a vraiment besoin de soutien."

# game/scripts/c27/c27.rpy:1850
translate french c27s002_AmaAtCollege2_409b418b:

    # ama "O tráela a cenar a casa y le damos apoyo todas."
    ama "Ou invitez-la à dîner à la maison et nous la soutiendrons tous."

# game/scripts/c27/c27.rpy:1851
translate french c27s002_AmaAtCollege2_a7082e58:

    # mc "Mi idea era ir a cenar. Hace días que no hemos tenido tiempo a solas y..."
    mc "Mon idée était d'aller dîner au restaurant. Ça fait des jours qu'on n'a pas eu de moments à deux et…"

# game/scripts/c27/c27.rpy:1853
translate french c27s002_AmaAtCollege2_ff878bcc:

    # ama "Hazlo. Le diré a [mar] que no vienes ni a cenar ni a dormir."
    ama "Fais-le. Je dirai à [mar] que tu ne viens ni dîner ni dormir."

# game/scripts/c27/c27.rpy:1854
translate french c27s002_AmaAtCollege2_9834909d:

    # mc "Yo no he dicho nada de no ir a dormir."
    mc "Je n'ai rien dit à propos de ne pas dormir."

# game/scripts/c27/c27.rpy:1856
translate french c27s002_AmaAtCollege2_82471ece:

    # ama "Bueno, esta vez soy yo la que toma la decisión por ti. ¿Cómo sienta cuando se cambian las tornas?"
    ama "Eh bien, cette fois, c'est moi qui décide pour toi. Qu'est-ce que ça fait quand les rôles sont inversés ?"

# game/scripts/c27/c27.rpy:1857
translate french c27s002_AmaAtCollege2_c1cd5e10:

    # mc "*Risa* Sienta genial. Te veo mañana, [ama]."
    mc "*Rires* C'est génial. À demain, [ama]."

# game/scripts/c27/c27.rpy:1858
translate french c27s002_AmaAtCollege2_185999e3:

    # ama "Te veo mañana. Pasáoslo bien."
    ama "À demain. Amuse-toi bien."

# game/scripts/c27/c27.rpy:1860
translate french c27s002_AmaAtCollege2_be5f40e8:

    # mc "Sí. Acabo de salir de la tienda de [mad.nick] y he tenido un encontronazo con su madre."
    mc "Oui. Je viens de quitter le magasin [mad.nick] et j'ai eu une altercation avec sa mère."

# game/scripts/c27/c27.rpy:1861
translate french c27s002_AmaAtCollege2_c824ab6a:

    # mc "Le he dicho que esperaré a que cierre para tomar un café. Después iré a casa."
    mc "Je lui ai dit que j'attendrais la fermeture pour prendre un café. Ensuite, je rentrerai chez moi."

# game/scripts/c27/c27.rpy:1863
translate french c27s002_AmaAtCollege2_a0692074:

    # ama "Parece una buena idea. Por lo que he oído, la madre es una bruja y seguro que [mad.nick] necesita un poco de apoyo."
    ama "Ça me paraît une bonne idée. D'après ce que j'ai entendu, la mère est une sorcière et elle a vraiment besoin d'aide."

# game/scripts/c27/c27.rpy:1864
translate french c27s002_AmaAtCollege2_409b418b_1:

    # ama "O tráela a cenar a casa y le damos apoyo todas."
    ama "Ou invitez-la à dîner à la maison et nous la soutiendrons tous."

# game/scripts/c27/c27.rpy:1865
translate french c27s002_AmaAtCollege2_d2a4b3c3:

    # mc "Se lo propondré, a ver qué le parece. Te veo luego."
    mc "Je lui en parlerai, on verra ce qu'il en pense. À plus tard."

# game/scripts/c27/c27.rpy:1866
translate french c27s002_AmaAtCollege2_fb8c89e8:

    # ama "Hasta luego, [mc]."
    ama "À plus tard, [mc]."

# game/scripts/c27/c27.rpy:1872
translate french c27s003_NoMad_7be8d16a:

    # "Llegas al café y, tras pedir un zumo de piña, juegas un rato a My Residence."
    "Vous arrivez au café et, après avoir commandé un jus d'ananas, vous jouez à My Residence pendant un moment."

# game/scripts/c27/c27.rpy:1873
translate french c27s003_NoMad_ed1bea5a:

    # "Tienes una tórrida escena con Dee-Dee en su piso."
    "Vous avez une scène torride avec Dee-Dee dans son appartement."

# game/scripts/c27/c27.rpy:1874
translate french c27s003_NoMad_554b84ed:

    # "Su perro no está en casa, con lo que, según el narrador, evitas tener que estar vigilando los muebles."
    "Son chien n'est pas à la maison, donc, d'après le narrateur, vous évitez d'avoir à surveiller les meubles."

# game/scripts/c27/c27.rpy:1875
translate french c27s003_NoMad_dd9f14bc:

    # mcp "(*Risa mental* ¡Ni que fuera Zeus!)"
    mcp "(*Rire intérieur* Comme si j'étais Zeus !)"

# game/scripts/c27/c27.rpy:1879
translate french c27s003_MadLis_25c8db59:

    # "La escena es más larga si no estás en ruta con [mad.nick]."
    "La scène est plus longue si vous n'êtes pas sur la route avec [mad.nick]."

# game/scripts/c27/c27.rpy:1884
translate french c27s003_MadLis_2d92c013:

    # "Llegas al café y, tras pedir un zumo de piña, pasas un rato leyendo noticias en el móvil."
    "Vous arrivez au café et, après avoir commandé un jus d'ananas, vous passez un peu de temps à lire les actualités sur votre téléphone portable."

# game/scripts/c27/c27.rpy:1886
translate french c27s003_MadLis_ec526522:

    # "Al cabo de un rato llegan las chicas."
    "Au bout d'un moment, les filles arrivent."

# game/scripts/c27/c27.rpy:1890
translate french c27s003_MadLis_ec0d1036:

    # "[mad.nick] es la primera en besarte."
    "[mad.nick] est le premier à t'embrasser."

# game/scripts/c27/c27.rpy:1892
translate french c27s003_MadLis_dab8c711:

    # mad "Gracias por lo que has hecho en la tienda."
    mad "Merci pour ce que vous avez fait dans le magasin."

# game/scripts/c27/c27.rpy:1893
translate french c27s003_MadLis_4d1b716b:

    # mc "¿Te ha bombardeado tu madre mucho a preguntas?"
    mc "Votre mère vous a-t-elle bombardé de questions ?"

# game/scripts/c27/c27.rpy:1894
translate french c27s003_MadLis_4c269159:

    # mad "No ha podido gracias a [lis]."
    mad "Il n'a pas pu le faire grâce à [lis]."

# game/scripts/c27/c27.rpy:1898
translate french c27s003_MadLis_30e728af:

    # "[lis] también quiere su beso. Te lo da en cuanto la dependienta se sienta."
    "[lis] veut aussi son baiser. Elle te le donne dès que la vendeuse s'assoit."

# game/scripts/c27/c27.rpy:1900
translate french c27s003_MadLis_802dc70a:

    # "[lis] te besa en cuanto la dependienta se sienta."
    "[lis] vous embrasse dès que le vendeur s'assoit."

# game/scripts/c27/c27.rpy:1902
translate french c27s003_MadLis_bf79a8ee:

    # lis "Puedo convertirme en una Karen en cualquier momento, y ese ha sido el momento perfecto."
    lis "Je peux devenir une Karen à tout moment, et c'était le moment idéal."

# game/scripts/c27/c27.rpy:1903
translate french c27s003_MadLis_063b558b:

    # lis "*Risa* Mi faceta de clienta odiosa que quiere que le enseñen todo puede ser muy útil."
    lis "*Rires* Mon côté cliente agaçante, qui veut tout voir, peut s'avérer très utile."

# game/scripts/c27/c27.rpy:1904
translate french c27s003_MadLis_0dd65c5f:

    # mc "*Risa* Y como la jefa ya estaba ahí, no podías pedir hablar con ella."
    mc "*Rires* Et comme la patronne était déjà là, vous ne pouviez pas demander à lui parler."

# game/scripts/c27/c27.rpy:1906
translate french c27s003_MadLis_8f7d65e4:

    # lis "Exacto, aparta y déjame sitio."
    lis "Exactement, écartez-vous et laissez-moi de l'espace."

# game/scripts/c27/c27.rpy:1907
translate french c27s003_MadLis_b8721c04:

    # mc "Lo hago porque te lo has ganado. *Risa*"
    mc "Je le fais parce que tu l'as mérité. *Rires*"

# game/scripts/c27/c27.rpy:1909
translate french c27s003_MadLis_3ca18231:

    # mad "La verdad es que hacía mucho que no veía a mi madre tan sorprendida. Normalmente todo el mundo hace lo que ella quiere."
    mad "À vrai dire, je n'avais pas vu ma mère aussi surprise depuis longtemps. D'habitude, elle fait toujours ce qu'elle veut."

# game/scripts/c27/c27.rpy:1911
translate french c27s003_MadLis_84f12b5c:

    # mc "Pues creo que, si alguna vez me invita a una reunión familiar, no voy a ser su yerno favorito."
    mc "Eh bien, je pense que si elle m'invite un jour à une réunion de famille, je ne serai pas son gendre préféré."

# game/scripts/c27/c27.rpy:1913
translate french c27s003_MadLis_00cb27fe:

    # mc "Pues creo que ha encontrado un rival en mí."
    mc "Eh bien, je crois qu'il a trouvé un rival en moi."

# game/scripts/c27/c27.rpy:1914
translate french c27s003_MadLis_bca0b992:

    # mc "No me estaba gustando cómo estaba hablando de ti con un tipo al que acaba de conocer. Ni que te llamara [mad], sabiendo lo poco que te gusta."
    mc "Je n'ai pas apprécié qu'elle parle de toi avec un type qu'elle venait de rencontrer. Ni qu'elle t'appelle [mad], sachant à quel point ça te déplaît."

# game/scripts/c27/c27.rpy:1916
translate french c27s003_MadLis_80683035:

    # mad "Lo de [mad] nunca me ha gustado, pero lo entiendo. Es el nombre con el que ella siempre ha pensado en mí."
    mad "Je n'ai jamais aimé ce truc avec « [mad] », mais je comprends. C'est le nom qu'elle a toujours utilisé pour me désigner."

# game/scripts/c27/c27.rpy:1917
translate french c27s003_MadLis_2bb432be:

    # mad "Pero no me gusta que quiera avergonzarme con lo de acabar siendo una solterona que acaba sola con la casa llena de gatos."
    mad "Mais je n'aime pas qu'elle veuille m'embarrasser en disant que je finirai vieille fille, seule avec une maison pleine de chats."

# game/scripts/c27/c27.rpy:1919
translate french c27s003_MadLis_a08a2d9a:

    # mc "Bueno, no vas a ser una solterona ni a estar sola. Y lo de los gatos... Si alguna vez tienes más de uno..."
    mc "Eh bien, vous ne serez ni vieille fille ni seule. Et pour ce qui est des chats… Si jamais vous en avez plus d'un…"

# game/scripts/c27/c27.rpy:1921
translate french c27s003_MadLis_d90d66e2:

    # mc "Bueno, no vas a estar sola. Y lo de los gatos... Si alguna vez tienes más de uno..."
    mc "Eh bien, vous ne serez pas seul. Et concernant les chats… Si jamais vous en avez plus d'un…"

# game/scripts/c27/c27.rpy:1923
translate french c27s003_MadLis_19da3e06:

    # lis "Evitaremos que entren en tu habitación. *Risa* Espero que esa cama dure mucho."
    lis "On les tiendra éloignés de ta chambre. *Rires* J'espère que ce lit durera longtemps."

# game/scripts/c27/c27.rpy:1924
translate french c27s003_MadLis_621dd6f9:

    # lis "La próxima vez tenemos que sustituir a Zeus por [mad.nick]."
    lis "La prochaine fois, nous devrons remplacer Zeus par [mad.nick]."

# game/scripts/c27/c27.rpy:1925
translate french c27s003_MadLis_b92bee6f:

    # mc "*Risa* Podemos poner una lata de una tonelada de atún al lado de la piscina para evitar que se mueva de ahí."
    mc "*Rires* On peut mettre une boîte de thon d'une tonne à côté de la piscine pour l'empêcher de bouger."

# game/scripts/c27/c27.rpy:1927
translate french c27s003_MadLis_64785b21:

    # mad "No os metáis con el pobre Zeus. Suficiente tiene con llevar dos días en el veterinario."
    mad "N'embêtez pas le pauvre Zeus. Il a déjà bien assez à faire après avoir passé deux jours chez le vétérinaire."

# game/scripts/c27/c27.rpy:1928
translate french c27s003_MadLis_bc09297b:

    # mc "¿Qué? ¿Qué le pasa?"
    mc "Quoi ? Qu'est-ce qui ne va pas chez lui ?"

# game/scripts/c27/c27.rpy:1930
translate french c27s003_MadLis_b5bbce20:

    # mad "Algunas de las chicas le dieron de comer más de lo debido y se ha puesto enfermo."
    mad "Certaines filles lui ont donné plus de nourriture qu'il n'aurait dû, et il est tombé malade."

# game/scripts/c27/c27.rpy:1931
translate french c27s003_MadLis_2b4af40a:

    # mad "Como, a pesar de eso, sigue siendo un comilón, el veterinario me sugirió que lo dejara allí, donde lo pueden controlar mejor."
    mad "Comme, malgré cela, il mange toujours beaucoup, le vétérinaire m'a suggéré de le laisser là-bas, où ils pourront mieux le surveiller."

# game/scripts/c27/c27.rpy:1933
translate french c27s003_MadLis_4c1b6750:

    # mad "Me paso el día fuera de casa y no podría controlar si abre algún armario para coger comida."
    mad "Je passe toute la journée loin de chez moi et je ne pourrais pas contrôler s'il ouvre les placards pour prendre de la nourriture."

# game/scripts/c27/c27.rpy:1934
translate french c27s003_MadLis_abc95beb:

    # mc "*Risa* Deberías poner candados en todas las puertas donde haya comida."
    mc "*Rires* Vous devriez mettre des verrous sur toutes les portes où il y a de la nourriture."

# game/scripts/c27/c27.rpy:1935
translate french c27s003_MadLis_92574c69:

    # mc "Aunque visto lo listo que es, sería capaz de aprender a usar una ganzúa."
    mc "Cependant, étant donné son intelligence, il serait capable d'apprendre à utiliser un crochet de serrurier."

# game/scripts/c27/c27.rpy:1937
translate french c27s003_MadLis_938f9629:

    # lis "[mad.nick], te aseguro que yo sólo le di un trozo pequeño de bacon."
    lis "[mad.nick], je vous assure que je ne lui ai donné qu'un petit morceau de bacon."

# game/scripts/c27/c27.rpy:1938
translate french c27s003_MadLis_3c14d331:

    # mc "Creo que el problema es que tú le diste bacon, [nor] salchichas, [dap] jamón, [eil] una lata de atún, [eri] varias latas..."
    mc "Je pense que le problème vient du fait que vous lui avez donné du bacon, des saucisses, du jambon, une boîte de thon, plusieurs boîtes..."

# game/scripts/c27/c27.rpy:1939
translate french c27s003_MadLis_08f64b1c:

    # mc "La próxima vez os deberíais poner de acuerdo en quién le da qué."
    mc "La prochaine fois, vous devriez vous mettre d'accord sur qui donne quoi."

# game/scripts/c27/c27.rpy:1941
translate french c27s003_MadLis_47650983:

    # mad "Bueno, creo que lo que ha pasado nos servirá de lección a todos. Zeus incluido. Ha aprendido que, si come mucho, se pone malo."
    mad "Eh bien, je pense que ce qui s'est passé nous servira de leçon à tous. À Zeus aussi. Il a appris que s'il mange trop, il tombe malade."

# game/scripts/c27/c27.rpy:1942
translate french c27s003_MadLis_fd9b3788:

    # mad "Solo faltará que lo recuerde la próxima vez que tenga comida delante."
    mad "Il ne lui reste plus qu'à s'en souvenir la prochaine fois qu'il aura de la nourriture devant lui."

# game/scripts/c27/c27.rpy:1943
translate french c27s003_MadLis_fbd300d8:

    # mc "Eso va a ser más difícil. Pese a que parece bastante listo, me da la impresión de que, cuando hay comida por en medio, no piensa demasiado."
    mc "Ça va être plus difficile. Bien qu'il paraisse assez intelligent, j'ai l'impression que lorsqu'il s'agit de nourriture, il manque de confiance en lui."

# game/scripts/c27/c27.rpy:1946
translate french c27s003_MadLis_a861bcf7:

    # lis "Bueno, parejita, yo os voy a dejar y voy a volver a casa."
    lis "Bon, vous deux, je vais vous quitter et rentrer chez moi."

# game/scripts/c27/c27.rpy:1947
translate french c27s003_MadLis_3ecea66a:

    # mc "¿Al final no has comprado nada? No veo bolsas..."
    mc "Vous n'avez donc rien acheté finalement ? Je ne vois aucun sac..."

# game/scripts/c27/c27.rpy:1949
translate french c27s003_MadLis_97038187:

    # lis "Sí que he comprado, pero [mad.nick] lo enviará a casa. No quería ir cargada en el Under."
    lis "Oui, je l'ai acheté, mais [mad.nick] va le faire livrer chez moi. Je ne voulais pas le transporter dans le sous-sol."

# game/scripts/c27/c27.rpy:1950
translate french c27s003_MadLis_89b0a1b8:

    # mc "*Risa* ¿Tanto has comprado?"
    mc "*Rires* Vous avez acheté autant ?"

# game/scripts/c27/c27.rpy:1952
translate french c27s003_MadLis_41fa6133:

    # mad "No lo quieras saber. *Risa* Creo que [lis] se ha convertido en una de mis mejores clientas en estas semanas."
    mad "Vous ne voulez pas savoir. *Rires* Je crois que [lis] est devenu l'un de mes meilleurs clients ces dernières semaines."

# game/scripts/c27/c27.rpy:1953
translate french c27s003_MadLis_fc692fce:

    # mc "*Risa* Al final va a tener que echar a [deb.nick] de la habitación para meter toda la ropa."
    mc "*Rires* Au final, il va devoir virer [deb.nick] de la pièce pour faire rentrer tous les vêtements."

# game/scripts/c27/c27.rpy:1957
translate french c27s003_MadLis_a85e51db:

    # lis "No hace falta echarla. *Risa* Con ocupar sus armarios tengo suficiente."
    lis "Pas besoin de la mettre à la porte. *Rires* Remplir ses placards me suffit amplement."

# game/scripts/c27/c27.rpy:1959
translate french c27s003_MadLis_4dea7428:

    # lis "Te veo en casa, [mc]. Hasta mañana, [mad.nick]."
    lis "À bientôt à la maison, [mc]. À demain, [mad.nick]."

# game/scripts/c27/c27.rpy:1962
translate french c27s003_MadLis_f6134b6e:

    # lis "¿No le vas a contar a [mc] la gran noticia, [mad.nick]?"
    lis "Tu ne vas pas annoncer la grande nouvelle à [mc], [mad.nick] ?"

# game/scripts/c27/c27.rpy:1963
translate french c27s003_MadLis_330754fc:

    # mc "¿Qué gran noticia? ¿Me he perdido algo?"
    mc "Quelle excellente nouvelle ! Ai-je raté quelque chose ?"

# game/scripts/c27/c27.rpy:1965
translate french c27s003_MadLis_458c8cb9:

    # mad "Bueno, la iba a contar la próxima vez que fuera a casa..."
    mad "Eh bien, j'allais te le dire la prochaine fois que je rentrerais chez moi..."

# game/scripts/c27/c27.rpy:1966
translate french c27s003_MadLis_c779c6c9:

    # mad "¡Mis diseños de vestidos han sido aceptados para el concurso al que los mandé! ¡Están en la fase final!"
    mad "Mes modèles de robes ont été acceptés au concours auquel je les ai soumis ! Ils sont en phase finale !"

# game/scripts/c27/c27.rpy:1967
translate french c27s003_MadLis_c97518fe:

    # mc "¡Eso es fantástico, [mad.nick]! ¿Cuándo sabrás si has ganado?"
    mc "C'est fantastique ! Quand sauras-tu si tu as gagné ?"

# game/scripts/c27/c27.rpy:1969
translate french c27s003_MadLis_98f13275:

    # mad "A finales del mes que viene. Tendré que ir a San Francisco un día para la gala de entrega de premios."
    mad "À la fin du mois prochain, je devrai aller à San Francisco pour une journée à l'occasion de la cérémonie de remise des prix."

# game/scripts/c27/c27.rpy:1970
translate french c27s003_MadLis_8713c2da:

    # mad "¡Estoy super nerviosa!"
    mad "Je suis super nerveuse !"

# game/scripts/c27/c27.rpy:1971
translate french c27s003_MadLis_11f71e6d:

    # mc "Me alegro muchísimo por ti."
    mc "Je suis tellement content pour toi."

# game/scripts/c27/c27.rpy:1973
translate french c27s003_MadLis_c617c737:

    # lis "Yo me he pedido acompañarla si le llega una invitación de 'Srta. Chang +1'."
    lis "J'ai demandé à l'accompagner si elle reçoit une invitation de « Mlle Chang +1 »."

# game/scripts/c27/c27.rpy:1974
translate french c27s003_MadLis_683b2274:

    # lis "Yo seré el +1. *Risita* Me encantan las entregas de premios. Sobre todo si gana una amiga."
    lis "Je serai l'invitée. *Rires* J'adore les remises de prix. Surtout si un ami gagne."

# game/scripts/c27/c27.rpy:1976
translate french c27s003_MadLis_92bcab57:

    # mad "Bueno, aún no sabemos si voy a ganar..."
    mad "Bon, on ne sait toujours pas si je vais gagner..."

# game/scripts/c27/c27.rpy:1977
translate french c27s003_MadLis_7bd92cbf:

    # mc "Llegar a la final ya es un paso muy importante, reconocen que tienes talento."
    mc "Arriver en finale est déjà une étape très importante ; cela prouve que vous avez du talent."

# game/scripts/c27/c27.rpy:1979
translate french c27s003_MadLis_fdc9d9a8:

    # lis "Bueno, deberíamos volver a casa, ¿no? Tengo ganas de ver las caras de las chicas cuando se enteren de lo de [mad.nick]."
    lis "Bon, on devrait rentrer, non ? J'ai hâte de voir la tête des filles quand elles apprendront pour [mad.nick]."

# game/scripts/c27/c27.rpy:1980
translate french c27s003_MadLis_3ecea66a_1:

    # mc "¿Al final no has comprado nada? No veo bolsas..."
    mc "Vous n'avez donc rien acheté finalement ? Je ne vois aucun sac..."

# game/scripts/c27/c27.rpy:1982
translate french c27s003_MadLis_2956d957:

    # lis "Sí que he comprado, pero [mad.nick] lo enviará a casa. No quería ir cargada."
    lis "Oui, je l'ai acheté, mais [mad.nick] me le fera livrer à domicile. Je ne voulais pas avoir à le transporter."

# game/scripts/c27/c27.rpy:1983
translate french c27s003_MadLis_89b0a1b8_1:

    # mc "*Risa* ¿Tanto has comprado?"
    mc "*Rires* Vous avez acheté autant ?"

# game/scripts/c27/c27.rpy:1985
translate french c27s003_MadLis_41fa6133_1:

    # mad "No lo quieras saber. *Risa* Creo que [lis] se ha convertido en una de mis mejores clientas en estas semanas."
    mad "Vous ne voulez pas savoir. *Rires* Je crois que [lis] est devenu l'un de mes meilleurs clients ces dernières semaines."

# game/scripts/c27/c27.rpy:1986
translate french c27s003_MadLis_fc692fce_1:

    # mc "*Risa* Al final va a tener que echar a [deb.nick] de la habitación para meter toda la ropa."
    mc "*Rires* Au final, il va devoir virer [deb.nick] de la pièce pour faire rentrer tous les vêtements."

# game/scripts/c27/c27.rpy:1988
translate french c27s003_MadLis_a85e51db_1:

    # lis "No hace falta echarla. *Risa* Con ocupar sus armarios tengo suficiente."
    lis "Pas besoin de la mettre à la porte. *Rires* Remplir ses placards me suffit amplement."

# game/scripts/c27/c27.rpy:1989
translate french c27s003_MadLis_d243e6e8:

    # lis "¿Nos vamos? [mad.nick] también viene a cenar, ¿verdad?"
    lis "On y va ? [mad.nick] Il vient dîner aussi, n'est-ce pas ?"

# game/scripts/c27/c27.rpy:1990
translate french c27s003_MadLis_16347631:

    # mc "Claro. Le tiene que dar la noticia al resto de la familia."
    mc "Bien sûr. Il doit l'annoncer au reste de la famille."

# game/scripts/c27/c27.rpy:1992
translate french c27s003_MadLis_8f7a6cb1:

    # mad "No sé, había sacado comida del congelador para hacerme esta noche..."
    mad "Je ne sais pas, j'avais sorti de la nourriture du congélateur pour me préparer à manger ce soir..."

# game/scripts/c27/c27.rpy:1993
translate french c27s003_MadLis_39e455e8:

    # mc "Y va a seguir estando ahí mañana, con lo que evitarás tener que sacarla."
    mc "Et il sera toujours là demain, vous n'aurez donc pas besoin de le sortir."

# game/scripts/c27/c27.rpy:1994
translate french c27s003_MadLis_16a93b4d:

    # mc "Mejor estar en casa que sola en tu apartamento, teniendo en cuenta que no está Zeus."
    mc "Il vaut mieux être chez soi que seul dans son appartement, étant donné que Zeus n'est pas dans les parages."

# game/scripts/c27/c27.rpy:1995
translate french c27s003_MadLis_805008b2:

    # mc "Además, deberías ser tú quién les cuente a las chicas lo del concurso. Todos sabemos que [lis] no es buena guardando secretos."
    mc "D'ailleurs, c'est à toi d'annoncer le concours aux filles. On sait tous que [lis] n'est pas douée pour garder les secrets."

# game/scripts/c27/c27.rpy:1996
translate french c27s003_MadLis_ff3e9756:

    # "Puedes oír cómo [lis] se remueve al lado tuyo. No te atreves a mirarla."
    "Tu entends [lis] remuer à côté de toi. Tu n'oses pas la regarder."

# game/scripts/c27/c27.rpy:1998
translate french c27s003_MadLis_596a0ed0:

    # mad "Me has convencido. Creo que voy a ir con vosotros."
    mad "Tu m'as convaincu. Je crois que je vais venir avec toi."

# game/scripts/c27/c27.rpy:2000
translate french c27s003_MadLis_12d99d03:

    # "Conduces a casa mientras las dos chicas empiezan a hablar de lo que se van a poner para la gala de entrega de premios."
    "Vous rentrez chez vous en voiture pendant que les deux filles commencent à parler de ce qu'elles vont porter à la cérémonie de remise des prix."

# game/scripts/c27/c27.rpy:2001
translate french c27s003_MadLis_8d4f05cb:

    # mcp "(¡Por el amor de Dios! ¡Quedan casi dos meses y ya están planificando el vestuario!)"
    mcp "(Pour l'amour du ciel ! Il reste presque deux mois et ils sont déjà en train de planifier les costumes !)"

# game/scripts/c27/c27.rpy:2003
translate french c27s003_MadLis_9534ce4f:

    # "Prefieres guardar silencio sobre el tema. Sabes que las dos van a lucir fantásticas lleven lo que lleven."
    "Vous préférez garder le silence sur ce sujet. Vous savez qu'elles seront toutes les deux magnifiques, quoi qu'elles portent."

# game/scripts/c27/c27.rpy:2006
translate french c27s003_MadLis_77f17d01:

    # "Al llegar a casa, la noticia de la visita de la madre de [mad.nick] ha corrido como la pólvora."
    "À son retour à la maison, la nouvelle de la visite de la mère de [mad.nick] s'était répandue comme une traînée de poudre."

# game/scripts/c27/c27.rpy:2007
translate french c27s003_MadLis_cf84d77b:

    # "Todo el mundo quiere apoyar a la dependienta."
    "Tout le monde souhaite soutenir le vendeur."

# game/scripts/c27/c27.rpy:2009
translate french c27s003_MadLis_6b52bcaa:

    # "No pasa mucho tiempo antes de que [lis] explique la lección que le has dado a la Sra. Chang. Entonces las felicitaciones son para ti."
    "Il ne faudra pas longtemps avant que [lis] n'explique la leçon que vous avez donnée à Mme Chang. Ensuite, toutes les félicitations vous reviendront."

# game/scripts/c27/c27.rpy:2010
translate french c27s003_MadLis_fd8f5ad8:

    # "[mee] descubre que su antigua versión se parece más a la Sra. Chang de lo que le gustaría aceptar."
    "[mee] découvre que son ancien moi ressemble plus à Mme Chang qu'elle ne voudrait l'admettre."

# game/scripts/c27/c27.rpy:2012
translate french c27s003_MadLis_77dd50cf:

    # "Cuando empieza la cena, después de llegar los Washington, [mad.nick] da las buenas noticias sobre el concurso."
    "Lorsque le dîner commence, après l'arrivée des Washington, [mad.nick] annonce la bonne nouvelle concernant le concours."

# game/scripts/c27/c27.rpy:2013
translate french c27s003_MadLis_c8e626a0:

    # "[emm] se siente un poco decepcionada por que [lis] haya pedido la plaza de acompañante. Ni siquiera saben si existe esa plaza."
    "[emm] est un peu déçu(e) que [lis] ait postulé pour le poste de compagnon. Il/Elle ignore même si ce poste existe."

# game/scripts/c27/c27.rpy:2015
translate french c27s003_MadLis_c6fe8333:

    # "Después de cenar, [eri] le propone a [mad.nick] que se quede a dormir en su habitación."
    "Après le dîner, [eri] suggère à [mad.nick] de passer la nuit dans sa chambre."

# game/scripts/c27/c27.rpy:2016
translate french c27s003_MadLis_f26994fb:

    # "Nadie quiere que la chica tenga que volver a su piso vacío."
    "Personne ne souhaite que la jeune fille retourne dans son appartement vide."

# game/scripts/c27/c27.rpy:2017
translate french c27s003_MadLis_798554c2:

    # "Rápidamente van a ponerse pijamas a juego."
    "Ils enfileront rapidement des pyjamas assortis."

# game/scripts/c27/c27.rpy:2019
translate french c27s003_MadLis_22acee05:

    # "[oma] estaba esperando para proponerle que fuera a dormir a su apartamento. Ella también va a pasar la noche sola."
    "J'attendais le moment de lui proposer de venir dormir chez lui. Elle va aussi passer la nuit seule."

# game/scripts/c27/c27.rpy:2023
translate french c27s003_MadLis_af0d03fd:

    # "Tú duermes solo."
    "Tu dors seul."

# game/scripts/c27/c27.rpy:2024
translate french c27s003_MadLis_e5e6c780:

    # centered "{size=+20}{b}DÍA 30 – MIÉRCOLES{/b}{/size}"
    centered "{size=+20}{b}JOUR 30 – MERCREDI{/b}{/size}"

# game/scripts/c27/c27.rpy:2030
translate french c27s003_AtHome_3e742448:

    # "Mientras tanto, en casa..."
    "Pendant ce temps, à la maison..."

# game/scripts/c27/c27.rpy:2031
translate french c27s003_AtHome_0210fa25:

    # "Durante la cena, [lis] explica el encontronazo que has tenido con la Sra. Chang."
    "Pendant le dîner, [lis] expliquez l'incident que vous avez eu avec Mme Chang."

# game/scripts/c27/c27.rpy:2032
translate french c27s003_AtHome_fd8f5ad8:

    # "[mee] descubre que su antigua versión se parece más a la Sra. Chang de lo que le gustaría aceptar."
    "[mee] découvre que son ancien moi ressemble plus à Mme Chang qu'elle ne voudrait l'admettre."

# game/scripts/c27/c27.rpy:2033
translate french c27s003_AtHome_65166fcc:

    # "[emm] se da cuenta por fin de lo afortunada que ha sido al crecer teniendo a alguien como [mar] cerca."
    "[emm] réalise enfin la chance qu'elle a eue de grandir avec quelqu'un comme [mar] à ses côtés."

# game/scripts/c27/c27.rpy:2035
translate french c27s003_AtHome_9b2026a8:

    # "Después de cenar, [oma] empieza a despedirse de todo el mundo, diciendo que vuelve a su apartamento."
    "Après le dîner, [oma] commence à dire au revoir à tout le monde, en disant qu'il retourne à son appartement."

# game/scripts/c27/c27.rpy:2036
translate french c27s003_AtHome_fa0340f2:

    # "[sai] interviene y le ofrece quedarse a dormir en su habitación. [eil] se apunta a dormir con ellas."
    "[sai] intervient et lui propose de dormir dans sa chambre. [eil] accepte de dormir avec eux."

# game/scripts/c27/c27.rpy:2038
translate french c27s003_AtHome_27ea4d62:

    # "[emm] le sugiere a [eva] que se quede a dormir en la suya, a lo que la pelirroja acepta con una sonrisa radiante."
    "[emm] suggère à [eva] de passer la nuit chez lui, ce que la rousse accepte avec un sourire radieux."

# game/scripts/c27/c27.rpy:2039
translate french c27s003_AtHome_2b3d603f:

    # "Y [mar] no pierde la oportunidad de proponérselo a [ama], con la excusa de que no debería pasar la noche sola en la base."
    "Et [mar] ne manque pas l'occasion de le proposer à [ama], en utilisant comme excuse qu'elle ne devrait pas passer la nuit seule à la base."

# game/scripts/c27/c27.rpy:2040
translate french c27s003_AtHome_0a26cc14:

    # "Ese tipo de rotaciones entre las habitaciones de las chicas se convertirá con el tiempo en una costumbre maravillosa que estrechará aún más los lazos de la familia."
    "Ce type de rotation entre les chambres des filles deviendra à terme une merveilleuse coutume qui renforcera encore davantage les liens familiaux."

# game/scripts/c27/c27.rpy:2058
translate french c27s003_MadLewd_248f3686:

    # mc "¿Quieres que vayamos a cenar a algún sitio?"
    mc "Tu veux aller dîner quelque part ?"

# game/scripts/c27/c27.rpy:2060
