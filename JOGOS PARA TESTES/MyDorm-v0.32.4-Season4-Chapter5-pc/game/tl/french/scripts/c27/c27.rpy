    # oma "¿Qué opinas de redefinir la frase 'Que le den a la policía'?"
    oma "Que pensez-vous de redéfinir l'expression « À bas la police » ?"

# game/scripts/c27/c27.rpy:3951
translate french c27s008_Oma_15bf9be2:

    # mc "*Risa* Que es un giro interesante de los acontecimientos."
    mc "*Rires* Voilà un tournant intéressant."

# game/scripts/c27/c27.rpy:3952
translate french c27s008_Oma_e00eed00:

    # "Mjolnir hace un rato que está preparado para el siguiente asalto."
