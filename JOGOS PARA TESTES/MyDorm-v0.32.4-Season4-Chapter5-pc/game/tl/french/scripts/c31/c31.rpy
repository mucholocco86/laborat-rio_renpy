# game/scripts/c31/c31.rpy:2492
translate french c31s002_farewell_5bc42aa0:

    # "The goodbye with [mar] feels too short. But there's a plane waiting."
    "Les adieux avec [mar] semblent trop courts. Mais il y a un avion qui attend."

# game/scripts/c31/c31.rpy:2502
translate french c31s004_flight1_5d631bde:

    # "A guy from the airport staff takes your bags and leads you to the plane, where a flight attendant is waiting for you."
    "Un gars du personnel de l'aéroport prend vos bagages et vous conduit à l'avion, où une hôtesse de l'air vous attend."

# game/scripts/c31/c31.rpy:2503
translate french c31s004_flight1_06190e71:

    # "You approach her while the guy loads your luggage. [ama] and [bet] packed relatively light."
    "Vous vous approchez d'elle pendant que le type charge vos bagages. [ama] et [bet] ont voyagé plutôt léger."

# game/scripts/c31/c31.rpy:2504
translate french c31s004_flight1_e099c1b3:

    # "But he's going to earn his day's pay with your luggage."
    "Mais il va bien mériter sa paye de la journée avec vos bagages."

# game/scripts/c31/c31.rpy:2506
translate french c31s004_flight1_f5b1b9f7:

    # alb "Good afternoon, Mr. Marks, Miss Cavendish. Hello, [ama]."
    alb "Bonjour, M. Marks, Mlle Cavendish. Bonjour, [ama]."

# game/scripts/c31/c31.rpy:2508
translate french c31s004_flight1_08093088:

    # "[bet] doesn't correct her by telling her she's no longer a 'Miss'."
    "[bet] ne la corrige pas en lui disant qu'elle n'est plus une 'Mademoiselle'."

# game/scripts/c31/c31.rpy:2509
translate french c31s004_flight1_412333a9:

    # alb "I'm [alb], and I'll be your flight attendant. I hope you have a pleasant trip."
    alb "Je suis [alb], et je serai votre hôtesse de l'air. J'espère que vous ferez un bon voyage."

# game/scripts/c31/c31.rpy:2510
translate french c31s004_flight1_7c16e55c:

    # mc "Thanks, [alb]. I see you know [ama]. Are you NTR staff?"
    mc "Merci, [alb]. Je vois que vous connaissez [ama]. Vous faites partie du personnel de NTR ?"

# game/scripts/c31/c31.rpy:2512
translate french c31s004_flight1_81e5c231:

    # alb "Yes, Mr. Marks. Both the pilots and I are part of the Support Department."
    alb "Oui, M. Marks. Les pilotes et moi-même faisons partie du Département de Soutien."

# game/scripts/c31/c31.rpy:2513
translate french c31s004_flight1_fccbe7c2:

    # alb "Before you ask, the pilots are... not clones."
    alb "Avant que vous ne posiez la question, les pilotes ne sont... pas des clones."

# game/scripts/c31/c31.rpy:2514
translate french c31s004_flight1_86ac42d1:

    # mc "I wasn't going to ask. If they do their job well, I don't think it matters."
    mc "Je n'allais pas demander. S'ils font bien leur travail, je ne pense pas que ça ait de l'importance."

# game/scripts/c31/c31.rpy:2516
translate french c31s004_flight1_df590dd6:

    # alb "If you'd like to board, the flight plan indicates we'll be taking off in a few minutes."
    alb "Si vous voulez bien embarquer, le plan de vol indique que nous décollerons dans quelques minutes."

# game/scripts/c31/c31.rpy:2517
translate french c31s004_flight1_e133b440:

    # alb "The flight will take us about six hours, so we'll arrive around 3:15 AM in Aruba, local time."
    alb "Le vol durera environ six heures, nous arriverons donc vers 3h15 à Aruba, heure locale."

# game/scripts/c31/c31.rpy:2518
translate french c31s004_flight1_debba945:

    # mc "Perfect. Let's board."
    mc "Parfait. On embarque."

# game/scripts/c31/c31.rpy:2521
translate french c31s004_flight1_13da10ce:

    # "Once on the plane, [alb] guides you to your seats and tells you to prepare for takeoff, which happens a few minutes later."
    "Une fois dans l'avion, [alb] vous guide vers vos sièges et vous dit de vous préparer pour le décollage, qui a lieu quelques minutes plus tard."

# game/scripts/c31/c31.rpy:2522
translate french c31s004_flight1_26bcab8d:

    # mc "[alb] said something... 'the pilots are...', but she didn't finish the sentence. She changed the end mid-sentence to 'not clones.'"
    mc "[alb] a dit un truc... 'les pilotes sont...', mais elle n'a pas fini sa phrase. Elle a changé la fin au milieu pour dire 'pas des clones'."

# game/scripts/c31/c31.rpy:2523
translate french c31s004_flight1_ff922d40:

    # mc "Do you know what she meant?"
    mc "Tu sais ce qu'elle voulait dire ?"

# game/scripts/c31/c31.rpy:2524
translate french c31s004_flight1_97d39f90:

    # ama "She was probably going to say 'human' or 'normal'. She must have changed the end of the sentence because she doesn't know what you think of clones."
    ama "Elle allait probablement dire 'humains' ou 'normaux'. Elle a dû changer la fin de sa phrase parce qu'elle ne sait pas ce que tu penses des clones."

# game/scripts/c31/c31.rpy:2525
translate french c31s004_flight1_b321445a:

    # ama "And now you're the big boss. Get used to people walking on eggshells around you."
    ama "Et maintenant, tu es le grand patron. Habitue-toi à ce que les gens marchent sur des œufs autour de toi."

# game/scripts/c31/c31.rpy:2527
translate french c31s004_flight1_e59b2a38:

    # mc "That's unacceptable! You and [eva] are just as normal or human as she is."
    mc "C'est inacceptable ! Toi et [eva] êtes tout aussi normales ou humaines qu'elle."

# game/scripts/c31/c31.rpy:2529
translate french c31s004_flight1_5b8d657d:

    # mc "That's unacceptable! [eri], [dap], or [emm] are just as normal or human as she is."
    mc "C'est inacceptable ! [eri], [dap] ou [emm] sont tout aussi normales ou humaines qu'elle."

# game/scripts/c31/c31.rpy:2531
translate french c31s004_flight1_e8c48027:

    # ama "*Laugh* I hope not. [alb] is a bit of an airhead. But she's not a bad girl."
    ama "*Rires* J'espère que non. [alb] est un peu une tête en l'air. Mais ce n'est pas une mauvaise fille."

# game/scripts/c31/c31.rpy:2533
translate french c31s004_flight1_b5529fa2:

    # ama "But seriously, some of the cross-departmental staff think that about clones."
    ama "Mais sérieusement, une partie du personnel interservices pense ça des clones."

# game/scripts/c31/c31.rpy:2535
translate french c31s004_flight1_fc13afce:

    # ama "They think we're a product, that we aren't complete people."
    ama "Ils pensent qu'on est un produit, qu'on n'est pas des personnes à part entière."

# game/scripts/c31/c31.rpy:2537
translate french c31s004_flight1_6dcdd2e6:

    # ama "They think they're a product, that they aren't complete people."
    ama "Ils pensent qu'ils sont un produit, qu'ils ne sont pas des personnes à part entière."

# game/scripts/c31/c31.rpy:2538
translate french c31s004_flight1_5c8035dc:

    # mc "I'll talk to her after takeoff. It's one of the things we need to change."
    mc "Je lui parlerai après le décollage. C'est l'une des choses que nous devons changer."

# game/scripts/c31/c31.rpy:2540
translate french c31s004_flight1_074add6d:

    # bet "I don't think you should. It's not the time to try and change someone's mind, because you won't succeed."
    bet "Je ne pense pas que tu devrais. Ce n'est pas le moment d'essayer de faire changer d'avis quelqu'un, car tu n'y arriveras pas."

# game/scripts/c31/c31.rpy:2541
translate french c31s004_flight1_b7312607:

    # bet "You have to show that you see clones as people, but you have to show it with actions, not words."
    bet "Tu dois montrer que tu considères les clones comme des personnes, mais tu dois le montrer par des actes, pas par des mots."

# game/scripts/c31/c31.rpy:2542
translate french c31s004_flight1_45192528:

    # bet "And it won't do any good to have the girl worrying the whole trip about whether you're going to fire her for a slip-up she corrected in time."
    bet "Et ça ne servira à rien que la fille s'inquiète tout le voyage de savoir si tu vas la virer pour une gaffe qu'elle a corrigée à temps."

# game/scripts/c31/c31.rpy:2543
translate french c31s004_flight1_cbe66f7a:

    # mc "You're right, I can't tell her off for something she didn't actually say."
    mc "Tu as raison, je ne peux pas l'engueuler pour quelque chose qu'elle n'a pas vraiment dit."

# game/scripts/c31/c31.rpy:2545
translate french c31s004_flight1_c4422946:

    # ama "Besides, it wouldn't do any good. People who hold that opinion aren't going to change it just because of what you say to them."
    ama "En plus, ça ne servirait à rien. Les gens qui ont cette opinion ne vont pas en changer juste à cause de ce que tu leur dis."

# game/scripts/c31/c31.rpy:2546
translate french c31s004_flight1_c864fea1:

    # ama "If they see clones as disposable tools, they'll only change their minds when you make changes that prove otherwise."
    ama "S'ils voient les clones comme des outils jetables, ils ne changeront d'avis que lorsque tu feras des changements qui prouvent le contraire."

# game/scripts/c31/c31.rpy:2547
translate french c31s004_flight1_d767ced3:

    # mc "Well, we'll have to start looking into what measures we can take in that regard."
    mc "Eh bien, nous allons devoir commencer à examiner quelles mesures nous pouvons prendre à ce sujet."

# game/scripts/c31/c31.rpy:2548
translate french c31s004_flight1_898cbc62:

    # mc "We have six hours ahead of us to start making plans."
    mc "Nous avons six heures devant nous pour commencer à faire des plans."

# game/scripts/c31/c31.rpy:2550
translate french c31s004_flight1_bea35b7e:

    # bet "While you guys work, I'm going to take the opportunity to take a nap on that couch back there."
    bet "Pendant que vous bossez, je vais en profiter pour faire une sieste sur ce canapé là-bas."

# game/scripts/c31/c31.rpy:2551
translate french c31s004_flight1_ee53125c:

    # bet "If we get to Aruba at 3 AM, and we have to wake up early tomorrow, I'd rather get some sleep ahead of time."
    bet "Si on arrive à Aruba à 3 heures du mat' et qu'on doit se lever tôt demain, je préfère prendre un peu d'avance sur mon sommeil."

# game/scripts/c31/c31.rpy:2552
translate french c31s004_flight1_fe3c9d06:

    # mc "I hadn't thought about that. We're going to get very little sleep tonight."
    mc "Je n'y avais pas pensé. On va très peu dormir cette nuit."

# game/scripts/c31/c31.rpy:2554
translate french c31s004_flight1_574bd71a:

    # mc "Do you want to get some sleep too?"
    mc "Tu veux dormir un peu aussi ?"

# game/scripts/c31/c31.rpy:2555
translate french c31s004_flight1_b61f2ea5:

    # ama "I'm not sleepy at all right now. Working for a bit sounds like a good idea."
    ama "Je n'ai pas du tout sommeil pour le moment. Travailler un peu me semble être une bonne idée."

# game/scripts/c31/c31.rpy:2556
translate french c31s004_flight1_fd576e9e:

    # mc "Then let's brainstorm on what we can do over the next few days."
    mc "Alors réfléchissons à ce qu'on peut faire ces prochains jours."

# game/scripts/c31/c31.rpy:2558
translate french c31s004_flight1_b2209ad3:

    # "While you and [ama] work for the next three hours, [bet] sleeps quietly on the couch behind you."
    "Pendant que vous et [ama] travaillez pendant les trois prochaines heures, [bet] dort tranquillement sur le canapé derrière vous."

# game/scripts/c31/c31.rpy:2559
translate french c31s004_flight1_1a7868ba:

    # "She once told you that, during her time in Africa, she learned to fall asleep whenever she had the chance."
    "Elle vous a dit un jour que, pendant son séjour en Afrique, elle a appris à s'endormir dès qu'elle en avait l'occasion."

# game/scripts/c31/c31.rpy:2560
translate french c31s004_flight1_b4f0434d:

    # "She never knew when an emergency would come up that would keep her awake for hours."
    "Elle ne savait jamais quand une urgence surviendrait et la tiendrait éveillée pendant des heures."

# game/scripts/c31/c31.rpy:2561
translate french c31s004_flight1_e34443db:

    # "A lot of interesting ideas come up while talking with [ama] about the things you can do once you get to Aruba."
    "Beaucoup d'idées intéressantes surgissent en discutant avec [ama] des choses que vous pouvez faire une fois arrivés à Aruba."

# game/scripts/c31/c31.rpy:2562
translate french c31s004_flight1_b2e6d814:

    # "But you need more information on how to carry them out."
    "Mais vous avez besoin de plus d'informations sur la façon de les réaliser."

# game/scripts/c31/c31.rpy:2567
translate french c31s004_noMileHighClub_5b587eeb:

    # "In the dead of night, while flying over the Gulf of Mexico..."
    "Au cœur de la nuit, en survolant le golfe du Mexique..."

# game/scripts/c31/c31.rpy:2568
translate french c31s004_noMileHighClub_1fda0035:

    # bet "*Laugh*"
    bet "*Rire*"

# game/scripts/c31/c31.rpy:2569
translate french c31s004_noMileHighClub_fd186e08:

    # ama "I thought you were sleeping, Aunt [bet]."
    ama "Je croyais que tu dormais, Tante [bet]."

# game/scripts/c31/c31.rpy:2570
translate french c31s004_noMileHighClub_feeabc39:

    # mc "We thought you were going to sleep through the whole trip."
    mc "On pensait que tu allais dormir pendant tout le voyage."

# game/scripts/c31/c31.rpy:2573
translate french c31s004_noMileHighClub_b432c3c6:

    # bet "This flight is taking forever. I guess Aruba is still far away. How long have I been asleep?"
    bet "Ce vol n'en finit pas. J'imagine qu'Aruba est encore loin. Ça fait combien de temps que je dors ?"

# game/scripts/c31/c31.rpy:2574
translate french c31s004_noMileHighClub_fe45e54d:

    # mc "About three hours. We've already left the US."
    mc "Environ trois heures. On a déjà quitté les États-Unis."

# game/scripts/c31/c31.rpy:2576
translate french c31s004_noMileHighClub_2558f871:

    # ama "There's still about another three hours left. Relax, [bet]."
    ama "Il reste encore environ trois heures. Détends-toi, [bet]."

# game/scripts/c31/c31.rpy:2577
translate french c31s004_noMileHighClub_bc0ea06c:

    # mc "*Laugh* That gives you time to take another nap."
    mc "*Rire* Ça te laisse le temps de faire une autre sieste."

# game/scripts/c31/c31.rpy:2579
translate french c31s004_noMileHighClub_f9014de1:

    # mc "What were you laughing at?"
    mc "Qu'est-ce qui te faisait rire ?"

# game/scripts/c31/c31.rpy:2580
translate french c31s004_noMileHighClub_baa4f3ac:

    # bet "I woke up a few minutes ago and, since I didn't want to bother you guys, I was watching some MeTube videos [emm] sent to me."
    bet "Je me suis réveillée il y a quelques minutes et, comme je ne voulais pas vous déranger, je regardais des vidéos MeTube que [emm] m'a envoyées."

# game/scripts/c31/c31.rpy:2581
translate french c31s004_noMileHighClub_88c7be4d:

    # bet "One of them was about a nun getting caught having sex on a plane. Though you could tell it was a set."
    bet "L'une d'elles montrait une nonne surprise en train de baiser dans un avion. Même si on voyait bien que c'était un décor."

# game/scripts/c31/c31.rpy:2583
translate french c31s004_noMileHighClub_693f9c70:

    # ama "The Mile High Club. It's a classic."
    ama "Le Mile High Club. C'est un classique."

# game/scripts/c31/c31.rpy:2584
translate french c31s004_noMileHighClub_0a74f4ca:

    # mc "I've never found it that interesting. An airplane restroom is way too small."
    mc "Je n'ai jamais trouvé ça si intéressant. Les toilettes d'un avion sont beaucoup trop petites."

# game/scripts/c31/c31.rpy:2586
translate french c31s004_noMileHighClub_38b0078e:

    # ama "*Laugh* A space where whoever is in there has to get along VERY well."
    ama "*Rire* Un espace où ceux qui s'y trouvent doivent TRÈS bien s'entendre."

# game/scripts/c31/c31.rpy:2587
translate french c31s004_noMileHighClub_fba7313c:

    # mc "*Laugh* If you put it that way..."
    mc "*Rire* Vu comme ça..."

# game/scripts/c31/c31.rpy:2589
translate french c31s004_noMileHighClub_4531727b:

    # bet "*Laugh* I've always imagined what it must be like to have sex on a plane during turbulence."
    bet "*Rire* J'ai toujours imaginé ce que ça devait être de baiser dans un avion pendant des turbulences."

# game/scripts/c31/c31.rpy:2590
translate french c31s004_noMileHighClub_66938e53:

    # mc "*Laugh* Bumpy sex."
    mc "*Rire* Une baise mouvementée."

# game/scripts/c31/c31.rpy:2592
translate french c31s004_noMileHighClub_c181b602:

    # ama "It would be easier on this plane. The back restroom is big. And behind the last bulkhead there's a bed."
    ama "Ce serait plus facile dans cet avion. Les toilettes à l'arrière sont grandes. Et derrière la dernière cloison, il y a un lit."

# game/scripts/c31/c31.rpy:2593
translate french c31s004_noMileHighClub_d6342b7a:

    # mc "There's a bed and [bet] is sleeping on the couch?"
    mc "Il y a un lit et [bet] dort sur le canapé ?"

# game/scripts/c31/c31.rpy:2595
translate french c31s004_noMileHighClub_2733f5f3:

    # bet "*Laugh* Don't mess with my couch. It's super comfortable."
    bet "*Rire* Touche pas à mon canapé. Il est super confortable."

# game/scripts/c31/c31.rpy:2596
translate french c31s004_noMileHighClub_a1fffaa8:

    # bet "And I'm going back to it right now. I'll let you guys keep working."
    bet "Et j'y retourne tout de suite. Je vous laisse continuer à travailler."

# game/scripts/c31/c31.rpy:2597
translate french c31s004_noMileHighClub_7950c729:

    # bet "Wake me up when we get to Aruba."
    bet "Réveillez-moi quand on arrivera à Aruba."

# game/scripts/c31/c31.rpy:2598
translate french c31s004_noMileHighClub_aaa1b5a2:

    # mc "Good night, Aunt [bet]."
    mc "Bonne nuit, Tante [bet]."

# game/scripts/c31/c31.rpy:2605
translate french c31s004_mileHighClub_5bacb60d:

    # "When you are flying over the Gulf of Mexico..."
    "Quand vous survolez le golfe du Mexique..."

# game/scripts/c31/c31.rpy:2606
translate french c31s004_mileHighClub_b432c3c6:

    # bet "This flight is taking forever. I guess Aruba is still a ways off. How long did I sleep?"
    bet "Ce vol n'en finit pas. J'imagine qu'Aruba est encore loin. Combien de temps j'ai dormi ?"

# game/scripts/c31/c31.rpy:2607
translate french c31s004_mileHighClub_fe45e54d:

    # mc "About three hours. We're already out of the US."
    mc "Environ trois heures. On a déjà quitté les États-Unis."

# game/scripts/c31/c31.rpy:2609
translate french c31s004_mileHighClub_2558f871:

    # ama "We still have about three more hours to go. Just relax, [bet]."
    ama "Il nous reste encore environ trois heures. Détends-toi, [bet]."

# game/scripts/c31/c31.rpy:2610
translate french c31s004_mileHighClub_bc0ea06c:

    # mc "*Laugh* That gives you time for another nap."
    mc "*Rires* Ça te laisse le temps pour une autre sieste."

# game/scripts/c31/c31.rpy:2612
translate french c31s004_mileHighClub_56084b84:

    # bet "Relax... yeah. Or do something more interesting."
    bet "Me détendre... ouais. Ou faire quelque chose de plus intéressant."

# game/scripts/c31/c31.rpy:2613
translate french c31s004_mileHighClub_041473fd:

    # bet "[ama]... do you mind if I steal your boss for a bit? I'm taking him to the restroom."
    bet "[ama]... ça te dérange si je t'emprunte ton patron un moment ? Je l'emmène aux toilettes."

# game/scripts/c31/c31.rpy:2615
translate french c31s004_mileHighClub_f4b5b85d:

    # ama "A private jet's restroom? Classic, from what I've read. You want to join the Mile High Club?"
    ama "Les toilettes d'un jet privé ? Un classique, d'après ce que j'ai lu. Tu veux rejoindre le Mile High Club ?"

# game/scripts/c31/c31.rpy:2617
translate french c31s004_mileHighClub_80463e18:

    # bet "I always thought it was a silly thing. Until I woke up and you guys told me we still have three hours left."
    bet "J'ai toujours pensé que c'était un truc stupide. Jusqu'à ce que je me réveille et que vous me disiez qu'il nous reste encore trois heures."

# game/scripts/c31/c31.rpy:2618
translate french c31s004_mileHighClub_4549df59:

    # mc "*Laugh* I think that's the least romantic reason I've ever been propositioned for sex."
    mc "*Rires* Je crois que c'est la raison la moins romantique pour laquelle on m'a proposé de baiser."

# game/scripts/c31/c31.rpy:2620
translate french c31s004_mileHighClub_e8a0b7b5:

    # ama "Go ahead. But don't take too long. I need to keep talking to him afterwards."
    ama "Allez-y. Mais ne soyez pas trop longs. J'ai besoin de continuer à lui parler après."

# game/scripts/c31/c31.rpy:2621
translate french c31s004_mileHighClub_7b11f280:

    # ama "And [bet]... try not to hurt yourself. Airplane restrooms are tiny."
    ama "Et [bet]... essaie de ne pas te blesser. Les toilettes d'avion sont minuscules."

# game/scripts/c31/c31.rpy:2623
translate french c31s004_mileHighClub_00cae64a:

    # bet "*Laugh* Do you think you are funny?"
    bet "*Rires* Tu te crois drôle ?"

# game/scripts/c31/c31.rpy:2624
translate french c31s004_mileHighClub_dff3a3cc:

    # mc "Is nobody going to ask me?"
    mc "Personne ne va me demander mon avis ?"

# game/scripts/c31/c31.rpy:2626
translate french c31s004_mileHighClub_7dab3510:

    # bet "No."
    bet "Non."

# game/scripts/c31/c31.rpy:2628
translate french c31s004_mileHighClub_11ebe623:

    # ama "No. We know what you'd answer, so... why bother?"
    ama "Non. On sait ce que tu répondrais, alors... pourquoi s'embêter ?"

# game/scripts/c31/c31.rpy:2629
translate french c31s004_mileHighClub_e8b80335:

    # ama "By the way, use the restroom in the back, it's bigger than the one in the front."
    ama "Au fait, utilisez les toilettes à l'arrière, elles sont plus grandes que celles à l'avant."

# game/scripts/c31/c31.rpy:2630
translate french c31s004_mileHighClub_66928687:

    # mc "*Laugh* Thanks, [ama]. I think [bet] will appreciate it."
    mc "*Rires* Merci, [ama]. Je pense que [bet] va apprécier."

# game/scripts/c31/c31.rpy:2632
translate french c31s004_mileHighClub_07ea0b32:

    # bet "Do you want to fuck or not? *Laugh* If you keep joking about this poor old lady, I might reconsider..."
    bet "Tu veux baiser ou pas ? *Rires* Si tu continues à te moquer de cette pauvre vieille dame, je pourrais changer d'avis..."

# game/scripts/c31/c31.rpy:2633
translate french c31s004_mileHighClub_0d098189:

