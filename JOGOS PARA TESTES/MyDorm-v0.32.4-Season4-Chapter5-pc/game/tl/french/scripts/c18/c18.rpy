

# game/scripts/c18/c18.rpy:278
translate french c18s001_Dinner_1a5439ac:

    # "El beso continúa unos segundos más antes de que Eva se separe."
    "Le baiser se poursuit pendant quelques secondes encore avant qu'Eva ne se retire."

# game/scripts/c18/c18.rpy:280
translate french c18s001_Dinner_2014e024:

    # mc "¿Sigues comprobando si voy a cortar el beso por ser demasiado largo? *Risa*"
    mc "Tu vérifies encore si je vais écourter le baiser parce qu'il est trop long ? *Rires*"

# game/scripts/c18/c18.rpy:281
translate french c18s001_Dinner_7bbe8b15:

    # eva "¿Yoooo? ¿Cómo puedes pensar eso de mí? *Risita*"
    eva "Moi ? Comment peux-tu penser ça de moi ? *Rires*"

# game/scripts/c18/c18.rpy:282
translate french c18s001_Dinner_acd60833:

    # mc "Porque es lo que haría [emm] *Risa*"
    mc "Parce que c'est ce que je ferais [emm] *Rires*"

# game/scripts/c18/c18.rpy:284
translate french c18s001_Dinner_6d83f316:

    # eva "Bueno... si Amanda puede darte besos largos, ¿por qué no voy a poder yo? ¿O para mí sí que hay una duración de besos marcada?"
    eva "Eh bien… si Amanda peut te donner de longs baisers, pourquoi pas moi ? Ou bien y a-t-il une durée limite pour les baisers, pour moi ?"

# game/scripts/c18/c18.rpy:285
translate french c18s001_Dinner_0b553d63:

    # eva "¿Ya es tu favorita?"
    eva "Est-ce déjà votre préféré ?"

# game/scripts/c18/c18.rpy:286
translate french c18s001_Dinner_b78de7ae:

    # mcp "(¿Estoy detectando una corriente de celos soterrada?)"
    mcp "(Serais-je en train de déceler une pointe de jalousie ?)"

# game/scripts/c18/c18.rpy:287
translate french c18s001_Dinner_d62e71aa:

    # mc "Eva, no hay ninguna duración de los besos, pero ese no es el espíritu. Es un saludo, no una competición."
    mc "Eva, il n'y a pas de limite de temps pour les baisers, mais là n'est pas la question. C'est une salutation, pas une compétition."

# game/scripts/c18/c18.rpy:289
translate french c18s001_Dinner_b8db1b05:

    # eva "Todo en este mundo es una competición, [mc]."
    eva "Tout dans ce monde est une compétition, [mc]."

# game/scripts/c18/c18.rpy:290
translate french c18s001_Dinner_179b2f81:

    # eva "¿Nos vamos? No quiero llegar tarde en mi primera cena."
    eva "On y va ? Je ne veux pas être en retard pour mon premier dîner."

# game/scripts/c18/c18.rpy:291
translate french c18s001_Dinner_e7f6c90f:

    # mc "Vamos. Llegamos con el tiempo un poco justo."
    mc "Allons-y. Nous sommes un peu pressés par le temps."

# game/scripts/c18/c18.rpy:293
translate french c18s001_Dinner_5680550e:

    # eva "Si me dejas conducir a mí, llegaremos a tiempo. Yo no conduzco como una abuela."
    eva "Si vous me laissez conduire, on arrivera à l'heure. Je ne conduis pas comme une grand-mère."

# game/scripts/c18/c18.rpy:294
translate french c18s001_Dinner_c459c8a2:

    # mc "Ni en broma. *Risa*"
    mc "Même pas pour rire. *Rires*"

# game/scripts/c18/c18.rpy:297
translate french c18s001_Dinner_332998d7:

    # "Llegáis justo a tiempo. No conduces tan lento como Eva ha insinuado."
    "Vous êtes parfaitement à l'heure. Vous ne conduisez pas aussi lentement qu'Eva le laissait entendre."

# game/scripts/c18/c18.rpy:300
translate french c18s001_Dinner_9758c43c:

    # "Las reacciones al ver entrar a Eva son de sorpresa absoluta."
    "Les réactions à l'arrivée d'Eva sont une surprise absolue."

# game/scripts/c18/c18.rpy:301
translate french c18s001_Dinner_1d672dcc:

    # "Todas las chicas se han arreglado, pero ninguna ha llegado al nivel de Eva."
    "Toutes les filles se sont mises sur leur trente-et-un, mais aucune n'a atteint le niveau d'Eva."

# game/scripts/c18/c18.rpy:303
translate french c18s001_Dinner_014cb3c8:

    # kat "¡Joder! Ahora sí que parezco una zarrapastrosa. Creo que me voy a ir a llorar a mi habitación. *Risa*"
    kat "Mince alors ! J'ai vraiment l'air d'un clochard. Je crois que je vais aller pleurer dans ma chambre. *Rires*"

# game/scripts/c18/c18.rpy:304
translate french c18s001_Dinner_f514d41e:

    # sai "Todas lo parecemos. Eva, estás fantástica."
    sai "On a tous cette allure. Eva, tu es magnifique."

# game/scripts/c18/c18.rpy:305
translate french c18s001_Dinner_80e195bb:

    # emm "No está fantástica. {b}Es fantástica{/b}."
    emm "Ce n'est pas fantastique. {b}C'est fantastique{/b}."

# game/scripts/c18/c18.rpy:306
translate french c18s001_Dinner_e6fbda22:

    # mcp "(Lo cual te convierte en fantástica a ti, ¿no? *Risa mental*)"
    mcp "(Ce qui vous rend fantastique, n'est-ce pas ? *Rires intérieurs*)"

# game/scripts/c18/c18.rpy:308
translate french c18s001_Dinner_6859f5bd:

    # kim "Estás guapísima, Eva."
    kim "Tu es magnifique, Eva."

# game/scripts/c18/c18.rpy:309
translate french c18s001_Dinner_797fbd0d:

    # ama "Te he dicho un vestido bonito, ¡no ESE vestido! Vamos a ir a bailar, no a una cena en una embajada."
    ama "Je t'ai dit une jolie robe, pas CETTE robe-là ! On va danser, pas dîner à l'ambassade."

# game/scripts/c18/c18.rpy:310
translate french c18s001_Dinner_d92aef96:

    # dap "No hagas caso, Eva. Vas a ser la sensación del... del sitio al que vamos a ir."
    dap "Ne les écoute pas, Eva. Tu vas faire parler de toi… à l’endroit où nous allons."

# game/scripts/c18/c18.rpy:311
translate french c18s001_Dinner_9eb841d6:

    # kim "Desde luego que sí. Lo serías incluso en la embajada de la que habla Amanda. *Risa*"
    kim "Absolument. Tu serais même à l'ambassade dont parle Amanda. *Rires*"

# game/scripts/c18/c18.rpy:313
translate french c18s001_Dinner_371afd3d:

    # eri "Pues ya estamos casi todas."
    eri "Eh bien, nous sommes presque tous là maintenant."

# game/scripts/c18/c18.rpy:314
translate french c18s001_Dinner_51ac705b:

    # mom "Sí, en cuanto lleguen el resto podemos empezar a cenar."
    mom "Oui, dès que les autres seront arrivés, nous pourrons commencer à dîner."

# game/scripts/c18/c18.rpy:315
translate french c18s001_Dinner_90e3203d:

    # nor "¡Qué envidia me dais las jóvenes!"
    nor "Je vous envie, jeunes femmes !"

# game/scripts/c18/c18.rpy:316
translate french c18s001_Dinner_9b26eadb:

    # mc "¿Vosotras no os habéis arreglado?"
    mc "Tu n'es pas prêt ?"

# game/scripts/c18/c18.rpy:318
translate french c18s001_Dinner_1b2f3b3c:

    # nor "No, hoy es un día para las chicas y para ti. Nosotras nos quedaremos en casa después de un par de días ajetreados."
    nor "Non, aujourd'hui, c'est une journée pour les filles et pour toi. On reste à la maison après deux jours bien remplis."

# game/scripts/c18/c18.rpy:320
translate french c18s001_Dinner_c2bc9d65:

    # mom "Yo aún tengo que acabar algunas cosas que quiero que reposen para la comida de mañana."
    mom "Il me reste encore quelques petites choses à terminer et que je veux préparer pour le déjeuner de demain."

# game/scripts/c18/c18.rpy:322
translate french c18s001_Dinner_24e9c147:

    # dap "Yo he intentado convencerlas, pero todas han puesto alguna excusa."
    dap "J'ai essayé de les convaincre, mais ils ont tous trouvé une excuse."

# game/scripts/c18/c18.rpy:324
translate french c18s001_Dinner_09375bce:

    # emm "Ya sabéis cómo es esto. Llegas a los 25 y ya no quieres salir a bailar."
    emm "Vous savez comment c'est. Vous atteignez 25 ans et vous n'avez plus envie d'aller danser."

# game/scripts/c18/c18.rpy:325
translate french c18s001_Dinner_ea0646d3:

    # emm "Aunque quizás la edad no tiene que ver. Ni siquiera Alexia o Simone han querido venir. Mañana tienen que madrugar las dos."
    emm "Mais l'âge n'est peut-être pas le problème. Ni Alexia ni Simone n'ont voulu venir. Elles doivent se lever tôt demain."

# game/scripts/c18/c18.rpy:327
translate french c18s001_Dinner_b0e5cf42:

    # dap "No es que no hayan querido. Lexi se ha pasado patrullando todo el día."
    dap "Ce n'est pas qu'ils ne voulaient pas. Lexi a patrouillé toute la journée."

# game/scripts/c18/c18.rpy:328
translate french c18s001_Dinner_68f8c0d3:

    # mcp "(¿Lexi? Eso es nuevo.)"
    mcp "(Lexi ? C'est nouveau.)"

# game/scripts/c18/c18.rpy:329
translate french c18s001_Dinner_dbf3a83b:

    # mc "Entonces, ¿quiénes vamos a ir a lo que sea que vayamos a ir?"
    mc "Alors, qui va nous accompagner à l'endroit où nous allons aller ?"

# game/scripts/c18/c18.rpy:331
translate french c18s001_Dinner_d685d370:

    # kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, yo y... y yo. A mí me cuento doble porque abulto por dos. *Risa*"
    kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, moi, et… et moi. Je me compte deux fois parce que je suis deux fois plus grosse. *Rires*"

# game/scripts/c18/c18.rpy:332
translate french c18s001_Dinner_94068f58:

    # kat "Eileen decidirá cuando acabe de trabajar, por si está muy cansada."
    kat "Eileen décidera elle-même de l'heure à laquelle elle aura fini de travailler, si elle est trop fatiguée."

# game/scripts/c18/c18.rpy:333
translate french c18s001_Dinner_cbbde96e:

    # mc "Somos doce o trece entonces. Necesitaremos los tres coches."
    mc "Nous serons donc douze ou treize. Il nous faudra les trois voitures."

# game/scripts/c18/c18.rpy:335
translate french c18s001_Dinner_e276d1ad:

    # ama "Yo puedo conducir uno de los coches, si queréis."
    ama "Je peux conduire une des voitures, si vous voulez."

# game/scripts/c18/c18.rpy:337
translate french c18s001_Dinner_de32ddfe:

    # eri "Yo conduciré el otro. Después de la última vez que salimos, hoy no pienso beber. *Risa*"
    eri "Je conduirai l'autre. Après notre dernière sortie, je ne bois pas ce soir. *Rires*"

# game/scripts/c18/c18.rpy:339
translate french c18s001_Dinner_15310c14:

    # eva "A veces me alegra que viváis en California. En cualquier otro estado solo [mc] y Eileen podrían beber."
    eva "Parfois, je suis content que vous habitiez en Californie. Dans n'importe quel autre État, seuls C4 et Eileen pourraient boire."

# game/scripts/c18/c18.rpy:340
translate french c18s001_Dinner_5068d387:

    # eva "Suerte que Arnold cambió esa ley absurda. Os podéis alistar en el ejército y matar gente en nombre de vuestro país con 18 pero no beber hasta los 21."
    eva "Heureusement qu'Arnold a abrogé cette loi absurde. On peut s'engager dans l'armée et tuer au nom de son pays à 18 ans, mais on ne peut pas boire avant 21 ans."

# game/scripts/c18/c18.rpy:342
translate french c18s001_Dinner_2c6c3e94:

    # ama "O conducir a los 16..."
    ama "Ou conduire à 16 ans..."

# game/scripts/c18/c18.rpy:344
translate french c18s001_Dinner_7e3da0f9:

    # kim "Hay muchas razones para eso, chicas..."
    kim "Il y a de nombreuses raisons à cela, les filles..."

# game/scripts/c18/c18.rpy:346
translate french c18s001_Dinner_f93664d8:

    # "Empieza una conversación sobre las implicaciones de beber alcohol a diversas edades que se alarga durante la cena."
    "Une conversation s'engage sur les conséquences de la consommation d'alcool à différents âges et se poursuit tout au long du dîner."

# game/scripts/c18/c18.rpy:347
translate french c18s001_Dinner_34df7fe0:

    # "[emm] ve bien que dejen beber a los 18. Si eres responsable para votar, también lo debes ser para beber. Ella nunca votaría a un gobernador que quisiera quitarle ese derecho."
    "Elle trouve bien qu'on autorise les jeunes de 18 ans à boire. Si on est assez responsable pour voter, on devrait aussi l'être pour boire. Elle ne voterait jamais pour un gouverneur qui voudrait lui retirer ce droit."

# game/scripts/c18/c18.rpy:348
translate french c18s001_Dinner_6b9a024e:

    # "[eri] es un poco más ambivalente. Su última experiencia con el alcohol le hace ser más prudente."
    "[eri] est un peu plus ambivalent. Sa dernière expérience avec l'alcool le rend plus prudent."

# game/scripts/c18/c18.rpy:349
translate french c18s001_Dinner_22e59bec:

    # "[mar] y [nor], y más tarde Meemaw y Kiara, creen que devolver la edad para beber a los 21 sería lo correcto."
    "[mar] et [nor], puis Meemaw et Kiara, pensent que le retour de l'âge légal pour boire à 21 ans serait la bonne chose à faire."

# game/scripts/c18/c18.rpy:350
translate french c18s001_Dinner_51783b5f:

    # "Ninguna de ellas pudo beber legalmente hasta los 21 y no creen que les haya perjudicado."
    "Aucun d'eux n'avait le droit de boire légalement avant l'âge de 21 ans et ils ne pensent pas que cela leur ait nui."

# game/scripts/c18/c18.rpy:351
translate french c18s001_Dinner_1cb834ff:

    # "Eva y Amanda hablan de cuando estuvieron en una misión en Burkina Faso con 14 años y pudieron beber alcohol con normalidad."
    "Eva et Amanda évoquent leur mission au Burkina Faso à l'âge de 14 ans, où elles pouvaient consommer de l'alcool normalement."

# game/scripts/c18/c18.rpy:352
translate french c18s001_Dinner_19bda271:

    # "Eva se emborrachó."
    "Eva s'est enivrée."

# game/scripts/c18/c18.rpy:353
translate french c18s001_Dinner_58751903:

    # "Pero lo consideran una buena experiencia que les permitió empezar a conocer sus límites."
    "Mais ils considèrent cela comme une bonne expérience qui leur a permis de commencer à connaître leurs limites."

# game/scripts/c18/c18.rpy:354
translate french c18s001_Dinner_8ddf32b1:

    # "Betty considera que 16 debería ser suficiente para empezar a beber cerveza y vino, y 18 para licores. Sus experiencias en África han moldeado sus opiniones."
    "Betty estime que l'âge légal pour commencer à boire de la bière et du vin est de 16 ans, et celui pour les spiritueux de 18 ans. Ses expériences en Afrique ont influencé ses opinions."

# game/scripts/c18/c18.rpy:355
translate french c18s001_Dinner_117dd69b:

    # "El resto de las chicas no tienen una opinión muy estricta en esto. Ven ventajas y desventajas en las diferentes edades."
    "Les autres filles n'ont pas d'avis très tranché sur la question. Elles voient des avantages et des inconvénients à chaque âge."

# game/scripts/c18/c18.rpy:356
translate french c18s001_Dinner_bd0bd8c0:

    # "Cuando ya no queda comida en los platos, el Under de Megan llega para llevarla al trabajo."
    "Quand il n'y a plus rien à manger dans les assiettes, Megan's Under arrive pour l'emmener au travail."

# game/scripts/c18/c18.rpy:357
translate french c18s001_Dinner_df7018af:

    # "Las diferentes conversaciones continúan durante poco menos de una hora más, hasta que llega Eileen, que dice estar muy cansada para ir a bailar."
    "Les différentes conversations se poursuivent pendant un peu moins d'une heure, jusqu'à l'arrivée d'Eileen qui déclare être trop fatiguée pour aller danser."

# game/scripts/c18/c18.rpy:359
translate french c18s001_Dinner_c3fc4b3d:

    # sai "Nos deberíamos ir yendo o se hará muy tarde, ¿no?"
    sai "On devrait commencer à partir sinon il va se faire très tard, non ?"

# game/scripts/c18/c18.rpy:360
translate french c18s001_Dinner_d45706dd:

    # mc "Cuando queráis. Pero me tendréis que decir dónde vamos, si tengo que conducir yo."
    mc "Quand tu veux. Mais il faudra me dire où on va si je dois conduire."

# game/scripts/c18/c18.rpy:362
translate french c18s001_Dinner_f2d7f480:

    # lis "Bueno, vamos a ir al Jazz Corner, donde trabaja Megan."
    lis "Très bien, allons à Jazz Corner, où travaille Megan."

# game/scripts/c18/c18.rpy:363
translate french c18s001_Dinner_16829b31:

    # mc "Ah, OK. Sé dónde está. ¿Y ese era todo el secretismo?"
    mc "Ah, d'accord. Je sais où c'est. Et c'était tout le secret ?"

# game/scripts/c18/c18.rpy:365
translate french c18s001_Dinner_1623422f:

    # dap "No es que fuera secretismo, es que queríamos atar un par de cosas antes de ir."
    dap "Ce n'était pas une question de secret, c'est juste que nous voulions régler quelques détails avant de partir."

# game/scripts/c18/c18.rpy:366
translate french c18s001_Dinner_3824888d:

    # dap "Nadie había reservado la sala anexa hoy, y Megan ha conseguido que nos la dejen para nosotros."
    dap "Personne n'avait réservé la chambre communicante aujourd'hui, et Megan a réussi à nous l'obtenir."

# game/scripts/c18/c18.rpy:367
translate french c18s001_Dinner_e0900dec:

    # dap "Si no hubiéramos podido cogerla, una mesa para doce o trece hubiera sido difícil de conseguir y hubiéramos ido al Twins."
    dap "Si nous n'avions pas pu l'obtenir, il aurait été difficile de trouver une table pour douze ou treize personnes et nous serions allés à Twins."

# game/scripts/c18/c18.rpy:368
translate french c18s001_Dinner_aa6fe3a4:

    # mc "Pero una sala para nosotros en un local así tiene que salir carísima, ¿no?"
    mc "Mais une chambre pour nous dans un endroit comme celui-là doit coûter une fortune, non ?"

# game/scripts/c18/c18.rpy:370
translate french c18s001_Dinner_9d8ff7a1:

    # emm "Son las ventajas de conocer a la cantante titular. *Risa* Nos la ha conseguido gratis, pero tendremos que ir a la barra de la sala principal a por las copas."
    emm "C'est l'un des avantages de connaître la chanteuse. *Rires* Elle l'a eue gratuitement, mais il faudra aller au bar de la salle principale pour prendre un verre."

# game/scripts/c18/c18.rpy:371
translate french c18s001_Dinner_84323f0a:

    # mc "Traducción: [mc], te va a tocar ir a por las copas."
    mc "Traduction : [mc], tu vas devoir aller chercher les tasses."

# game/scripts/c18/c18.rpy:373
translate french c18s001_Dinner_1f921612:

    # sca "¡Como siempre! *Risa* Pero ya te acompañaré yo, como la última vez."
    sca "Comme toujours ! *Rires* Mais je t'accompagnerai, comme la dernière fois."

# game/scripts/c18/c18.rpy:374
translate french c18s001_Dinner_fd746a20:

    # mc "Bueno, pues podemos irnos cuando queráis."
    mc "Eh bien, nous pouvons partir quand vous voulez."

# game/scripts/c18/c18.rpy:376
translate french c18s001_Dinner_c131f3f1:

    # "Os despedís de las mujeres que se quedan en casa y unos minutos después estáis en el Jazz Corner. Megan os acompaña a la sala anexa."
    "Vous dites au revoir aux femmes qui restent à la maison, et quelques minutes plus tard, vous êtes au Jazz Corner. Megan vous accompagne dans la pièce voisine."

# game/scripts/c18/c18.rpy:377
translate french c18s001_Dinner_02a98b0b:

    # "La sala es un poco más grande que la mitad de la sala principal y cuenta con su propio escenario y barra, aunque hoy no están en uso."
    "La salle est légèrement plus grande que la moitié de la salle principale et possède sa propre scène et son propre bar, bien que ceux-ci ne soient pas utilisés aujourd'hui."

# game/scripts/c18/c18.rpy:378
translate french c18s001_Dinner_2e0c3ba5:

    # "En el escenario hay una pantalla dónde proyectarán las actuaciones de Megan en la sala principal."
    "Sur scène, un écran diffusera les prestations de Megan dans la salle principale."

# game/scripts/c18/c18.rpy:385
translate french c18s001_Dinner_63f66d91:

    # "Amanda, con un vestido que le ha prestado [emm]. Ella había venido en shorts a casa."
    "Amanda portait une robe que [emm] lui avait prêtée. Elle était rentrée en short."

# game/scripts/c18/c18.rpy:389
translate french c18s001_Dinner_81ea5029:

    # "[dap], otra vez con el pelo suelto, como la noche del Twins."
    "[dap], à nouveau avec ses cheveux détachés, comme la nuit des Jumeaux."

# game/scripts/c18/c18.rpy:393
translate french c18s001_Dinner_c99372e2:

    # "Debbie. Parece que les ha cogido el gusto a los tops."
    "Debbie. Il semblerait qu'elle ait pris goût aux crop tops."

# game/scripts/c18/c18.rpy:397
translate french c18s001_Dinner_953e654f:

    # "[emm] con un vestido un poco osado que le ha prestado Kim."
    "[emm] portant une robe légèrement audacieuse que Kim lui a prêtée."

# game/scripts/c18/c18.rpy:401
translate french c18s001_Dinner_f204cdfa:

    # "[eri]. fiel a su estilo."
    "[eri]. Fidèle à lui-même."

# game/scripts/c18/c18.rpy:405
translate french c18s001_Dinner_fe85c8ee:

    # "Eva. Simplemente alucinante."
    "Eva. Tout simplement incroyable."

# game/scripts/c18/c18.rpy:409
translate french c18s001_Dinner_6547b59d:

    # "Kate, un vestido cómodo y sencillo, en su línea."
    "Kate, une robe confortable et simple, dans son style habituel."

# game/scripts/c18/c18.rpy:413
translate french c18s001_Dinner_1df18a38:

    # "Kim. Hablando de vestidos osados."
    "Kim. En parlant de robes audacieuses."

# game/scripts/c18/c18.rpy:417
translate french c18s001_Dinner_e92781d9:

    # "Lisa, también manteniendo su estilo. Si el vestido fuera más largo podría ir a la ópera con él."
    "Lisa, fidèle à son style. Si la robe était plus longue, elle pourrait aller à l'opéra avec."

# game/scripts/c18/c18.rpy:421
translate french c18s001_Dinner_6283af77:

    # "Megan. El vestuario que le eligen es espectacular."
    "Megan. La garde-robe qu'ils choisissent pour elle est spectaculaire."

# game/scripts/c18/c18.rpy:425
translate french c18s001_Dinner_ddaefe9e:

    # "Saira, extrañamente vestida de rojo."
    "Saira, étrangement vêtue de rouge."

# game/scripts/c18/c18.rpy:429
translate french c18s001_Dinner_b83f2f01:

    # "Scarlett, con otro vestido prestado por Kim."
    "Scarlett, portant une autre robe empruntée à Kim."

# game/scripts/c18/c18.rpy:434
translate french c18s001_Dinner_073ecb12:

    # meg "Y esta es la sala. Por aquella puerta podéis pasar a la sala principal a pedir las bebidas. Acordaos del código para poder volver a entrar."
    meg "Voici la salle. Vous pouvez passer cette porte pour accéder à la salle principale et commander des boissons. N'oubliez pas le code pour pouvoir y retourner."

# game/scripts/c18/c18.rpy:435
translate french c18s001_Dinner_47959051:

    # meg "Por aquella otra puerta tenéis los lavabos privados de esta sala."
    meg "Par cette autre porte, vous accédez aux toilettes privées de cette chambre."

# game/scripts/c18/c18.rpy:436
translate french c18s001_Dinner_4463222f:

    # meg "En esa pantalla veréis una versión gigante de mí. Por suerte sólo me cogen de cintura para arriba, con lo que los michelines no se ven mucho. *Risa*"
    meg "Sur cet écran, vous verrez une version géante de moi. Heureusement, on ne me voit que de la taille jusqu'en haut, donc mes poignées d'amour ne sont pas très visibles. *Rires*"

# game/scripts/c18/c18.rpy:438
translate french c18s001_Dinner_9370238d:

    # kat "¡Eres muy exagerada! Tú apenas tienes. *Risa* Yo necesitaría la pantalla gigante del Heins Stadium."
    kat "Tu exagères ! Tu n'en as presque pas. *Rires* Il me faudrait l'écran géant du stade Heins."

# game/scripts/c18/c18.rpy:439
translate french c18s001_Dinner_4000027e:

    # mc "Nunca he conocido una mujer que no se queje de que le sobran un par de kilos. *Risa* O de que le falten."
    mc "Je n'ai jamais rencontré une femme qui ne se plaigne pas d'avoir quelques kilos en trop. *Rires* Ou d'être trop maigre."

# game/scripts/c18/c18.rpy:441
translate french c18s001_Dinner_be5770f7:

    # meg "Yo os tengo que dejar, tengo que acabar de aclarar unas cosas con el jefe antes de la actuación."
    meg "Je dois vous quitter, je dois régler quelques détails avec le patron avant le spectacle."

# game/scripts/c18/c18.rpy:442
translate french c18s001_Dinner_8b0d388f:

    # meg "Volveré entre actuaciones. Os veo luego."
    meg "Je reviendrai entre deux spectacles. À plus tard."

# game/scripts/c18/c18.rpy:443
translate french c18s001_Dinner_da73a3e0:

    # todas "Hasta luego, Megan."
    todas "Au revoir, Megan."

# game/scripts/c18/c18.rpy:445
translate french c18s001_Dinner_82928684:

    # sca "Id pensando que queréis beber, ya me ocupo yo de tomar nota."
    sca "Commencez à réfléchir à ce que vous voulez boire, je m'occupe de prendre des notes."

# game/scripts/c18/c18.rpy:446
translate french c18s001_Dinner_05f3dd36:

    # "Scarlett toma nota en su móvil de las bebidas que quiere cada una y te da el móvil."
    "Scarlett note sur son téléphone les boissons que chacun de vous souhaite et vous rend son téléphone."

# game/scripts/c18/c18.rpy:448
translate french c18s001_Dinner_155a3fa5:

    # sca "Lisa y yo vamos al lavabo y te vemos en la barra. ¿Puedes ir pidiendo?"
    sca "Lisa et moi allons aux toilettes et nous vous voyons au bar. Pouvez-vous commencer à commander ?"

# game/scripts/c18/c18.rpy:449
translate french c18s001_Dinner_8e72b860:

    # lis "Viendo lo bonito que es el local tengo ganas de ver el lavabo. Este sitio tiene una imagen años 30 muy cuidada."
    lis "L'endroit est tellement beau que j'ai hâte de voir les toilettes. Le décor, inspiré des années 1930, est vraiment soigné."

# game/scripts/c18/c18.rpy:450
translate french c18s001_Dinner_47891da4:

    # mc "¿Vas a hacer turismo en el lavabo? *Risa*"
    mc "Tu fais du tourisme dans la salle de bain ? *Rires*"

# game/scripts/c18/c18.rpy:452
translate french c18s001_Dinner_f88b4eec:

    # lis "No solo turismo..."
    lis "Pas seulement le tourisme..."

# game/scripts/c18/c18.rpy:453
translate french c18s001_Dinner_ad7f4de5:

    # sca "*Risa* Esas cosas no se le preguntan a una dama, [mc]. *Risa*"
    sca "*Rires* On ne pose pas ce genre de questions à une dame, [mc]. *Rires*"

# game/scripts/c18/c18.rpy:454
translate french c18s001_Dinner_e639c88f:

    # mc "*Risa* No tardéis o empezará a fundirse el hielo."
    mc "*Rires* Ne tardez pas, sinon la glace va commencer à fondre."

# game/scripts/c18/c18.rpy:456
translate french c18s001_Dinner_41d2ad96:

    # sca "No tardamos nada. No es que Lisa les vaya a dejar un regalito apestoso. *Risa*"
    sca "On ne va pas tarder. Lisa ne va quand même pas te laisser un cadeau qui sent mauvais ! *Rires*"

# game/scripts/c18/c18.rpy:457
translate french c18s001_Dinner_ae703262:

    # lis "¡Scarlett! *Risa* Las señoritas no hacemos eso. Dejamos rosas y arcoíris. *Risa*"
    lis "Scarlett ! *Rires* Mesdames, ne faites pas ça. Nous laissons des roses et des arcs-en-ciel. *Rires*"

# game/scripts/c18/c18.rpy:458
translate french c18s001_Dinner_fc7f2961:

    # mc "Bueno, os espero en la barra. No voy a poder traer doce bebidas yo solo."
    mc "D'accord, je t'attendrai au bar. Je ne pourrai pas apporter douze verres moi-même."

# game/scripts/c18/c18.rpy:461
translate french c18s001_Dinner_2cd1b34c:

    # "En cuanto entras en la sala principal, te encuentras con una cara conocida."
    "Dès que vous entrerez dans la pièce principale, vous verrez un visage familier."

# game/scripts/c18/c18.rpy:463
translate french c18s001_Dinner_5c865492:

    # mc "¿Dra. Milk?"
    mc "Docteur Milk ?"

# game/scripts/c18/c18.rpy:465
translate french c18s001_Dinner_7c596da7:

    # hm "¡Oh, Sr. Marks! Puede llamarme Harley cuando no estoy en el hospital."
    hm "Oh, Monsieur Marks ! Vous pouvez m'appeler Harley quand je ne suis pas à l'hôpital."

# game/scripts/c18/c18.rpy:466
translate french c18s001_Dinner_20e77c57:

    # mc "Sólo si usted me llama [mc]."
    mc "Seulement si vous m'appelez [mc]."

# game/scripts/c18/c18.rpy:471
translate french c18s001_Dinner_382909a1:

    # har "De acuerdo, [mc]. ¿Qué tal los masajes con la Sra. Pitt?"
    har "D'accord, [mc]. Comment se sont passés les massages avec Mme Pitt ?"

# game/scripts/c18/c18.rpy:472
translate french c18s001_Dinner_66f69349:

    # mc "Bien, gracias. Hoy le he explicado a mi tía cómo hacerlos. Parece que han ido bien."
    mc "D'accord, merci. J'ai expliqué à ma tante comment les faire aujourd'hui. Apparemment, ça s'est bien passé."

# game/scripts/c18/c18.rpy:473
translate french c18s001_Dinner_914e290b:

    # mc "Un segundo, por favor."
    mc "Une seconde, s'il vous plaît."

# game/scripts/c18/c18.rpy:475
translate french c18s001_Dinner_acf64506:

    # "Le entregas el móvil de Scarlett al camarero con la lista de las bebidas."
    "Vous tendez le téléphone portable de Scarlett au serveur, qui lui présente la carte des boissons."

# game/scripts/c18/c18.rpy:476
translate french c18s001_Dinner_d5840e9d:

    # mc "¿Puede prepararme esto, por favor?"
    mc "Pouvez-vous me préparer ceci, s'il vous plaît ?"

# game/scripts/c18/c18.rpy:480
translate french c18s001_Dinner_c3fc428a:

    # bam "Sí, ahora mismo."
    bam "Oui, maintenant."

# game/scripts/c18/c18.rpy:482
translate french c18s001_Dinner_bc3f3dfe:

    # har "¿Ha venido solo?"
    har "Est-il venu seul ?"

# game/scripts/c18/c18.rpy:483
translate french c18s001_Dinner_2d8ebafa:

    # mc "No, con parte de la familia. ¿Y usted?"
    mc "Non, avec certains membres de ma famille. Et vous ?"

# game/scripts/c18/c18.rpy:485
translate french c18s001_Dinner_2c50782e:

    # har "Tampoco. He venido con mi marido, Jeff, y mi herm... ano."
    har "Non, je ne suis pas venue avec mon mari, Jeff, et mon frère."

# game/scripts/c18/c18.rpy:486
translate french c18s001_Dinner_a2a3934b:

    # mc "Ahora veo las tres bebidas. ¿Quiere que le ayude a llevárselas a la mesa mientras preparan mi pedido?"
    mc "Je vois les trois boissons. Voulez-vous que je vous aide à les apporter à table pendant qu'ils préparent ma commande ?"

# game/scripts/c18/c18.rpy:488
translate french c18s001_Dinner_8ee079a8:

    # har "No hace falta. Mi hermano ha ido al lavabo un momento y tiene que estar a punto de volver."
    har "Ce n'est pas nécessaire. Mon frère est allé aux toilettes un instant et ne devrait plus tarder."

# game/scripts/c18/c18.rpy:489
translate french c18s001_Dinner_d7c52f77:

    # har "Oh, hablando del Rey de Roma, por ahí viene."
    har "Ah, en parlant du loup, le voilà !"

# game/scripts/c18/c18.rpy:494
translate french c18s001_Dinner_979ef219:

    # har "[mc], te presento a mi hermano Anthony."
    har "[mc], je voudrais vous présenter mon frère Anthony."

# game/scripts/c18/c18.rpy:495
translate french c18s001_Dinner_ae996fcb:

    # ant "Ya nos conocemos, Harley. Es el casero de Lisa, del que te hablé."
    ant "On se connaît déjà, Harley. C'est le propriétaire de Lisa, celui dont je t'ai parlé."

# game/scripts/c18/c18.rpy:496
translate french c18s001_Dinner_6cdb73dc:

    # mc "Hola Anthony, ¿qué tal?"
    mc "Salut Anthony, comment vas-tu ?"

# game/scripts/c18/c18.rpy:498
translate french c18s001_Dinner_c35965dd:

    # ant "Hola, [mc], ¿Ha venido Lisa contigo?"
    ant "Salut, [mc], Lisa est venue avec toi ?"

# game/scripts/c18/c18.rpy:499
translate french c18s001_Dinner_b90af8a9:

    # mc "Sí, ahora vendrá a ayudarme a llevar las copas."
    mc "Oui, maintenant elle va venir m'aider à porter les lunettes."

# game/scripts/c18/c18.rpy:500
translate french c18s001_Dinner_fb962fee:

    # ant "Cuídala. Es una chica fantástica."
    ant "Prends soin d'elle. C'est une fille formidable."

# game/scripts/c18/c18.rpy:501
translate french c18s001_Dinner_5eb610ee:

    # mc "Sí que lo es."
    mc "Oui c'est le cas."

# game/scripts/c18/c18.rpy:503
translate french c18s001_Dinner_fabd217c:

    # lis "Hola, Anthony."
    lis "Bonjour Anthony."

# game/scripts/c18/c18.rpy:504
translate french c18s001_Dinner_a5356373:

    # "Se suceden las presentaciones al llegar las chicas."
    "Les présentations se succèdent à mesure que les filles arrivent."

# game/scripts/c18/c18.rpy:505
translate french c18s001_Dinner_2556ab00:

    # "La interacción entre Lisa y Anthony se ve más amistosa de lo que podrías haber esperado tras lo que te explicó Lisa ayer."
    "L'interaction entre Lisa et Anthony semble plus amicale que vous ne l'auriez imaginé après ce que Lisa vous a expliqué hier."

# game/scripts/c18/c18.rpy:507
translate french c18s001_Dinner_7a11e38a:

    # har "Yo voy a llevar las bebidas a la mesa. Jeff debe estar preguntándose por qué tardamos tanto."
    har "Je vais apporter les boissons à table. Jeff doit se demander pourquoi on met autant de temps."

# game/scripts/c18/c18.rpy:508
translate french c18s001_Dinner_3452f087:

    # har "Anthony, si te quieres quedar con tus amigos, por nosotros no hay problema."
    har "Anthony, si tu veux rester avec tes amis, ça nous convient parfaitement."

# game/scripts/c18/c18.rpy:509
translate french c18s001_Dinner_b5b30d3f:

    # ant "Bueno... creo que será lo mejor si me voy contigo. He venido con vosotros al fin y al cabo."
    ant "Bon... je pense qu'il vaut mieux que je vienne avec vous. Après tout, je suis venu avec vous."

# game/scripts/c18/c18.rpy:510
translate french c18s001_Dinner_af68f0d2:

    # mc "Si cambias de opinión, avisa a Lisa. Estamos en la sala privada y tendríamos que venir a buscarte."
    mc "Si vous changez d'avis, prévenez Lisa. Nous sommes dans la salle privée et nous devrons venir vous chercher."

# game/scripts/c18/c18.rpy:512
translate french c18s001_Dinner_158ff277:

    # lis "Sí, hazlo. Vamos cortas de chicos con los que bailar y las chicas van a querer conocerte."
    lis "Oui, vas-y. On manque de garçons pour danser, et les filles voudront te rencontrer."

# game/scripts/c18/c18.rpy:513
translate french c18s001_Dinner_2abefeef:

    # lis "Les he hablado mucho de ti."
    lis "Je leur ai beaucoup parlé de toi."

# game/scripts/c18/c18.rpy:514
translate french c18s001_Dinner_28083649:

    # sca "Y, antes de que preguntes, todo lo que ha dicho ha sido bueno."
    sca "Et, avant que vous ne posiez la question, tout ce qu'il a dit était pertinent."

# game/scripts/c18/c18.rpy:516
translate french c18s001_Dinner_09c04153:

    # ant "Bueno, hoy quería pasar un rato con mi hermana y mi cuñado. Hacía mucho que no salíamos."
    ant "Aujourd'hui, je voulais passer du temps avec ma sœur et mon beau-frère. Ça faisait longtemps qu'on n'était pas sortis."

# game/scripts/c18/c18.rpy:517
translate french c18s001_Dinner_e954b2bc:

    # har "Pero nosotros no estaremos mucho rato. Seguramente después de la primera actuación de Megan, la chica que canta, nos vayamos. Tiene una voz increíble."
    har "Mais nous ne resterons pas longtemps. Nous partirons probablement après la première prestation de Megan, la chanteuse. Elle a une voix incroyable."

# game/scripts/c18/c18.rpy:518
translate french c18s001_Dinner_3fe983af:

    # har "Con lo que os podemos prestar a Anthony después. *Risa* Así no se siente mal por habernos abandonado y pasa un rato con esas chicas que parecen tan ansiosas por conocerlo."
    har "Avec ce qu'on pourra te prêter, Anthony, plus tard. *Rires* Comme ça, il ne se sentira pas coupable de nous avoir laissés tomber et il pourra passer du temps avec ces filles qui ont l'air si impatientes de le rencontrer."

# game/scripts/c18/c18.rpy:519
translate french c18s001_Dinner_4c8c0375:

    # ant "Bueno, ya veremos..."
    ant "On verra bien..."

# game/scripts/c18/c18.rpy:521
translate french c18s001_Dinner_1ade258c:

    # sca "No vas a dejar a once damiselas en apuros con sólo un caballero con el que bailar, ¿no?"
    sca "Vous n'allez tout de même pas laisser onze demoiselles en détresse avec un seul gentleman pour danser, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:522
translate french c18s001_Dinner_96949d21:

    # lis "No te presionamos más. Tienes mi número. Mándame un mensaje o llámame si quieres venir. Me gustaría que lo hicieras."
    lis "On ne vous mettra plus la pression. Vous avez mon numéro. Envoyez-moi un SMS ou appelez-moi si vous voulez venir. J'aimerais beaucoup que vous veniez."

# game/scripts/c18/c18.rpy:523
translate french c18s001_Dinner_e46e5975:

    # mc "Anthony, no estás obligado. Ven sólo si quieres. Pero espero verte luego."
    mc "Anthony, tu n'es pas obligé. Viens seulement si tu le souhaites. Mais j'espère te revoir plus tard."

# game/scripts/c18/c18.rpy:525
translate french c18s001_Dinner_206dfa64:

    # ant "Bueno, si Harley y Jeff deciden irse pronto, te aviso."
    ant "Eh bien, si Harley et Jeff décident de partir bientôt, je vous le ferai savoir."

# game/scripts/c18/c18.rpy:526
translate french c18s001_Dinner_d42cd077:

    # lis "Espero tu mensaje."
    lis "J'attends votre message."

# game/scripts/c18/c18.rpy:527
translate french c18s001_Dinner_3ab75698:

    # mcp "(Este abrazo es mucho más cálido que el que se dieron cuando aún estaban descubriendo si querían salir juntos o no.)"
    mcp "(Cette étreinte est bien plus chaleureuse que celle qu'ils ont échangée lorsqu'ils hésitaient encore à se mettre en couple.)"

# game/scripts/c18/c18.rpy:529
translate french c18s001_Dinner_91156551:

    # har "Encantada de conoceros, chicas. Y de verte a ti otra vez, [mc]. Ahora nos tenemos que ir antes de que mi marido se preocupe."
    har "Ravie de vous rencontrer toutes, les filles. Et de vous revoir, [mc]. Il faut qu'on y aille avant que mon mari ne s'inquiète."

# game/scripts/c18/c18.rpy:530
translate french c18s001_Dinner_a98d298e:

    # mc "Igualmente, Harley."
    mc "De même, Harley."

# game/scripts/c18/c18.rpy:532
translate french c18s001_Dinner_7a374f64:

    # lis "¡Qué casualidad que la hermana de Anthony sea la médico de Olivia! Sabía que su hermana mayor era médico, pero esto es mucha casualidad."
    lis "Quelle coïncidence que la sœur d'Anthony soit le médecin d'Olivia ! Je savais que sa sœur aînée était médecin, mais c'est une sacrée coïncidence."

# game/scripts/c18/c18.rpy:534
translate french c18s001_Dinner_d0194107:

    # mc "Y por curiosidad, tiene otra hermana, ¿verdad?"
    mc "Et par curiosité, elle a une autre sœur, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:535
translate french c18s001_Dinner_59840597:

    # lis "¿Cómo lo sabes? Olga es un par de años más joven que Harley y un año mayor que Anthony. Es con quién más unido está."
    lis "Comment le sais-tu ? Olga a quelques années de moins qu'Harley et un an de plus qu'Anthony. C'est elle dont il est le plus proche."

# game/scripts/c18/c18.rpy:536
translate french c18s001_Dinner_892335e9:

    # mc "Has dicho su hermana mayor. He intuido que debía haber una intermedia."
    mc "Vous avez dit sa sœur aînée. J'avais le pressentiment qu'il devait y avoir une sœur cadette."

# game/scripts/c18/c18.rpy:537
translate french c18s001_Dinner_f6e26917:

    # lis "Se mudó a San Francisco hace un par de semanas, el mismo día que llegamos nosotras aquí. Antes vivía en Seattle."
    lis "Elle a déménagé à San Francisco il y a deux semaines, le jour même de notre arrivée. Avant, elle habitait à Seattle."

# game/scripts/c18/c18.rpy:538
translate french c18s001_Dinner_c8c9ae20:

    # mc "El mundo es un pañuelo..."
    mc "Le monde est petit..."

# game/scripts/c18/c18.rpy:540
translate french c18s001_Dinner_33310525:

    # "Volvéis con las bebidas a la sala privada. La seguridad con que Scarlett lleva la bandeja contrasta con lo torpes que os sentís Lisa y tú."
    "Vous retournez dans le salon privé avec les boissons. L'assurance avec laquelle Scarlett manipule le plateau contraste fortement avec le malaise que vous et Lisa ressentez."

# game/scripts/c18/c18.rpy:541
translate french c18s001_Dinner_14b65676:

    # "Suena música suave para entrar en ambiente antes de que la actuación de Megan comience."
    "Une douce musique est diffusée pour créer l'ambiance avant le début du spectacle de Megan."

# game/scripts/c18/c18.rpy:543
translate french c18s001_Dinner_6c5051cc:

    # sai "Un brindis por las chicas del cumpleaños."
    sai "Un toast aux filles qui fêtent leur anniversaire !"

# game/scripts/c18/c18.rpy:544
translate french c18s001_Dinner_fe38e22c:

    # todas "¡Sí!"
    todas "Ouais!"

# game/scripts/c18/c18.rpy:545
translate french c18s001_Dinner_8a435623:

    # sai "¡Brindo porque este año os traiga mucha felicidad!"
    sai "Je vous souhaite une année remplie de bonheur !"

# game/scripts/c18/c18.rpy:546
translate french c18s001_Dinner_f9d3ccfd:

    # todas "¡Salud!"
    todas "Santé!"

# game/scripts/c18/c18.rpy:548
translate french c18s001_Dinner_cb123a3b:

    # "Después de los brindis, todas empiezan a hablar con todas sobre los planes del próximo año."
    "Après les toasts, tout le monde se met à parler des projets pour l'année à venir."

# game/scripts/c18/c18.rpy:550
translate french c18s001_Dinner_2ccdce99:

    # "Casi parece que sea el cumpleaños de todas."
    "On dirait presque l'anniversaire de tout le monde."

# game/scripts/c18/c18.rpy:562
translate french c18s001_Scarlett_35d28430:

    # sca "¿Bailas? La última vez no pude bailar contigo por culpa de aquellos dos chicos."
    sca "Veux-tu danser ? La dernière fois, je n'ai pas pu danser avec toi à cause de ces deux garçons."

# game/scripts/c18/c18.rpy:563
translate french c18s001_Scarlett_f7744f06:

    # mc "¡Por supuesto!"
    mc "Bien sûr!"

# game/scripts/c18/c18.rpy:565
translate french c18s001_Scarlett_b6ef6e84:

    # "Os separáis un poco del grupo de chicas, para poder hablar en privado mientras bailáis."
    "Vous vous éloignez un peu du groupe de filles, afin de pouvoir discuter en privé tout en dansant."

# game/scripts/c18/c18.rpy:566
translate french c18s001_Scarlett_0d480b65:

    # sca "Están super emocionadas con lo de mañana."
    sca "Ils sont super excités à l'idée de demain."

# game/scripts/c18/c18.rpy:567
translate french c18s001_Scarlett_3a78b0cc:

    # mc "Es normal. Siempre se han puesto así en sus cumpleaños. Me fastidia no haber podido estar en los tres últimos."
    mc "C'est normal. Ils ont toujours été comme ça pour leurs anniversaires. Je regrette de ne pas avoir pu être là pour les trois derniers."

# game/scripts/c18/c18.rpy:569
translate french c18s001_Scarlett_36b988ac:

    # sca "No es eso. Desde lo que dijiste en la cena de ayer sobre Amanda formando parte de la familia, no hacen más que hablar de ello."
    sca "Ce n'est pas ça. Depuis ce que tu as dit hier soir à dîner, à propos d'Amanda qui fait partie de la famille, ils n'arrêtent pas d'en parler."

# game/scripts/c18/c18.rpy:570
translate french c18s001_Scarlett_4a09d2b2:

    # mc "No creo que dijera nada que no pensáramos todos. Y vuestras respuestas lo confirmaron."
    mc "Je ne crois pas avoir dit quoi que ce soit que nous ne pensions pas tous. Et vos réponses l'ont confirmé."

# game/scripts/c18/c18.rpy:572
translate french c18s001_Scarlett_7cdab485:

    # sca "Sí, tienes razón. Pero ninguna de nosotras lo había verbalizado previamente."
    sca "Oui, vous avez raison. Mais aucun de nous ne l'avait exprimé verbalement auparavant."

# game/scripts/c18/c18.rpy:573
translate french c18s001_Scarlett_5830ba57:

    # sca "Todas nos sentíamos parte de la familia, pero decirlo en alto y saber lo que pensaban las demás... ¡Phew!"
    sca "Nous nous sentions tous comme faisant partie de la famille, mais le dire à voix haute et savoir ce que les autres pensaient... Ouf !"

# game/scripts/c18/c18.rpy:575
translate french c18s001_Scarlett_4db29d44:

    # sca "Mientras hablabas con Amanda fuera, nosotras nos quedamos mirándonos las unas a las otras."
    sca "Pendant que tu parlais à Amanda dehors, nous sommes restés là à nous regarder."

# game/scripts/c18/c18.rpy:576
translate french c18s001_Scarlett_47d41948:

    # sca "Después vinieron un montón de abrazos. No era necesario decir nada. Lo habíamos dicho todas sobre Amanda."
    sca "Puis, ce fut une avalanche d'étreintes. Inutile de parler. Nous l'avions tous dit à propos d'Amanda."

# game/scripts/c18/c18.rpy:578
translate french c18s001_Scarlett_cb1ac273:

    # sca "Y en ese momento todas fuimos Amanda."
    sca "Et à ce moment-là, nous étions toutes Amanda."

# game/scripts/c18/c18.rpy:579
translate french c18s001_Scarlett_b983afd4:

    # sca "A algunas de nosotras se nos escaparon algunas lágrimas."
    sca "Certains d'entre nous ont versé quelques larmes."

# game/scripts/c18/c18.rpy:580
translate french c18s001_Scarlett_19b12ff6:

    # mc "Les tengo que pedir ese video a Amanda y a Eva. *Risa*"
    mc "Je dois demander cette vidéo à Amanda et Eva. *Rires*"

# game/scripts/c18/c18.rpy:582
translate french c18s001_Scarlett_2cdb75c3:

    # sca "Puedes reírte si quieres, pero fue muy emocionante. Y después Olivia dijo que sólo a ti se te podría ocurrir ponernos en esa situación."
    sca "Vous pouvez rire si vous voulez, mais c'était vraiment palpitant. Et puis Olivia a dit que seule toi pouvais avoir l'idée de nous mettre dans une telle situation."

# game/scripts/c18/c18.rpy:583
translate french c18s001_Scarlett_b1d47099:

    # sca "Y las caras de todas decían que pensaban que tenía razón."
    sca "Et tous leurs visages disaient qu'ils pensaient qu'il avait raison."

# game/scripts/c18/c18.rpy:584
translate french c18s001_Scarlett_61af3e7e:

    # mc "*Risa* ¡La culpa es de [mc]!"
    mc "*Rires* C'est la faute de <c4 !"

# game/scripts/c18/c18.rpy:586
translate french c18s001_Scarlett_cdf76c28:

    # sca "*Risa* No estaban buscando culpables. Cada una de nosotras estaba contenta sintiéndose parte de algo sin hablarlo con el resto."
    sca "*Rires* Ils ne cherchaient pas de coupable. Chacun de nous était heureux de se sentir partie prenante de quelque chose sans avoir à en parler aux autres."

# game/scripts/c18/c18.rpy:587
translate french c18s001_Scarlett_2edcdcf6:

    # sca "Gracias a ti, nos hemos dado cuenta de que el resto sienten lo mismo. Nadie te culpa. Todo el mundo te lo agradece."
    sca "Grâce à vous, nous avons compris que tout le monde partage ce sentiment. Personne ne vous en veut. Nous vous sommes tous reconnaissants."

# game/scripts/c18/c18.rpy:588
translate french c18s001_Scarlett_8c4a4cd4:

    # mc "Creo que te lo deberían agradecer a ti."
    mc "Je pense qu'ils devraient vous remercier."

# game/scripts/c18/c18.rpy:590
translate french c18s001_Scarlett_8135b027:

    # sca "¿A mí? ¿Qué he hecho yo ahora?"
    sca "Moi ? Qu'est-ce que j'ai encore fait ?"

# game/scripts/c18/c18.rpy:591
translate french c18s001_Scarlett_433961ca:

    # mc "Proponer la Navidad en la playa. Este sentimiento empezó allí."
    mc "Proposez un Noël sur la plage. C'est là que tout a commencé."

# game/scripts/c18/c18.rpy:593
translate french c18s001_Scarlett_90218ce0:

    # sca "Pero yo solo quise proponer algo divertido..."
    sca "Mais je voulais juste suggérer quelque chose d'amusant..."

# game/scripts/c18/c18.rpy:594
translate french c18s001_Scarlett_1ad2f5ca:

    # mc "Y fue divertido. Pero estar todos juntos también creó este sentimiento. Es tan culpa tuya como mía."
    mc "Et c'était amusant. Mais le fait d'être tous ensemble a aussi créé ce sentiment. C'est autant de ta faute que de la mienne."

# game/scripts/c18/c18.rpy:595
translate french c18s001_Scarlett_599c1cf9:

    # sca "No lo había visto así..."
    sca "Je n'y avais pas pensé de cette façon..."

# game/scripts/c18/c18.rpy:597
translate french c18s001_Scarlett_ce9dbd34:

    # sca "Pero cambiando de tema antes de que me ruborice... ¿Sabes que Eva y Amanda también usan lengua de signos?"
    sca "Mais changeons de sujet avant que je ne rougisse… Saviez-vous qu’Eva et Amanda utilisent aussi la langue des signes ?"

# game/scripts/c18/c18.rpy:598
translate french c18s001_Scarlett_a4c50100:

    # mc "No, no lo sabía. Supongo que tiene que ser útil para ellas poderse comunicar en silencio."
    mc "Non, je ne savais pas. J'imagine que la possibilité de communiquer silencieusement doit leur être utile."

# game/scripts/c18/c18.rpy:600
translate french c18s001_Scarlett_48a06b30:

    # sca "Supongo... no les entiendo la mayoría de lo que señalan, pero está claro que son gestos rápidos y deliberados."
    sca "Je suppose… Je ne comprends pas la plupart de ce qu’ils montrent du doigt, mais il est clair que ce sont des gestes rapides et délibérés."

# game/scripts/c18/c18.rpy:601
translate french c18s001_Scarlett_2d3d95bb:

    # sca "No mires, pero están discutiendo por algo."
    sca "Ne regardez pas, mais ils sont en train de se disputer."

# game/scripts/c18/c18.rpy:603
translate french c18s001_Scarlett_d9234634:

    # sca "Son gestos enfadados, y ni siquiera se están mirando directamente."
    sca "Ce sont des gestes de colère, et ils ne se regardent même pas directement."

# game/scripts/c18/c18.rpy:605
translate french c18s001_Scarlett_5050edf6:

    # sca "Deben usar un lenguaje diferente del ASL."
    sca "Ils doivent utiliser une langue autre que la LSF."

# game/scripts/c18/c18.rpy:606
translate french c18s001_Scarlett_f2821762:

    # mc "Bueno, se criaron en Aruba, no sé qué hablarán allí."
    mc "Eh bien, ils ont grandi à Aruba, je ne sais pas quelle langue ils parlent là-bas."

# game/scripts/c18/c18.rpy:608
translate french c18s001_Scarlett_b40818c2:

    # "Suena un móvil en algún sitio."
    "Un téléphone portable sonne quelque part."

# game/scripts/c18/c18.rpy:610
translate french c18s001_Scarlett_f71d8e27:

    # sca "Se lo puedes preguntar a Eva. Viene hacia aquí, creo que se ha acabado nuestro baile."
    sca "Tu peux demander à Eva. Elle arrive par ici ; je crois que notre danse est terminée."

# game/scripts/c18/c18.rpy:611
translate french c18s001_Scarlett_d0b7ddd8:

    # sca "Todas van a querer bailar contigo. Eres el único chico."
    sca "Toutes les filles voudront danser avec toi. Tu es le seul garçon."

# game/scripts/c18/c18.rpy:612
translate french c18s001_Scarlett_37c7001e:

    # mc "Bailamos luego otra vez. La noche es larga."
    mc "Nous avons dansé à nouveau plus tard. La nuit est longue."

# game/scripts/c18/c18.rpy:615
translate french c18s001_Scarlett_99def1ae:

    # "Scarlett te hace los gestos de \"Te Quiero\", pero lo hace diferente."
    "Scarlett fait des gestes pour dire « je t'aime », mais elle le fait différemment."

# game/scripts/c18/c18.rpy:616
translate french c18s001_Scarlett_2b5a9c81:

    # mc "Eso se ha visto diferente de como lo hice yo."
    mc "Cela était différent de la façon dont j'avais procédé."

# game/scripts/c18/c18.rpy:618
translate french c18s001_Scarlett_1cdb8ec2:

    # sca "*Risita* Es que no lo hiciste bien del todo. Mira, el \"Yo\" se hace así."
    sca "*Rires* Tu ne l'as pas fait tout à fait correctement. Regarde, le « I » se fait comme ça."

# game/scripts/c18/c18.rpy:622
translate french c18s001_Scarlett_2669ca66:

    # sca "Lo que tú hiciste se parece más a \"A mí\". Dijiste algo como \"A mí te quiero\"."
    sca "Ce que tu as fait, c'est plutôt « Pour moi ». Tu as dit quelque chose comme : « Je t'aime »."

# game/scripts/c18/c18.rpy:623
translate french c18s001_Scarlett_559d3b13:

    # mc "¿Por qué no me lo dijiste?"
    mc "Pourquoi ne me l'as-tu pas dit ?"

# game/scripts/c18/c18.rpy:625
translate french c18s001_Scarlett_bdd695b0:

    # sca "¿Y fastidiar el momento? ¡No!"
    sca "Et gâcher le moment ? Non !"

# game/scripts/c18/c18.rpy:626
translate french c18s001_Scarlett_5f29e1e4:

    # sca "Te tomaste el esfuerzo y entendí lo que querías decir. Era suficiente para mí. Era el gesto más bonito que habían hecho nunca por mí."
    sca "Vous avez fait l'effort, et j'ai compris ce que vous vouliez dire. Cela m'a suffi. C'était la plus belle chose qu'on m'ait jamais faite."

# game/scripts/c18/c18.rpy:627
translate french c18s001_Scarlett_6676f26b:

    # mc "Pero lo podía haber hecho mejor."
    mc "Mais il aurait pu faire mieux."

# game/scripts/c18/c18.rpy:629
translate french c18s001_Scarlett_988f984e:

    # sca "No, mi amor. No podías."
    sca "Non, mon amour. Tu ne pourrais pas."

# game/scripts/c18/c18.rpy:634
translate french c18s001_Eva_470231be:

    # eva "¿Interrumpo algo? ¿Puedo robarte a [mc] por una canción, Scarlett?"
    eva "Est-ce que je dérange ? Scarlett, je peux emprunter [mc] pour une chanson ?"

# game/scripts/c18/c18.rpy:637
translate french c18s001_Eva_5bc304ce:

    # sca "No interrumpes. Precisamente le estaba diciendo que todas íbamos a querer bailar con él."
    sca "Vous ne m'interrompez pas. Je lui disais simplement que nous aimerions tous danser avec lui."

# game/scripts/c18/c18.rpy:638
translate french c18s001_Eva_2d394a22:

    # sca "Pasáoslo bien."
    sca "Amusez-vous bien."

# game/scripts/c18/c18.rpy:640
translate french c18s001_Eva_3ddd83ca:

    # eva "Gracias, Scarlett."
    eva "Merci, Scarlett."

# game/scripts/c18/c18.rpy:641
translate french c18s001_Eva_a0458336:

    # sca "Lo que necesites, guapísima."
    sca "Tout ce dont tu as besoin, ma belle."

# game/scripts/c18/c18.rpy:643
translate french c18s001_Eva_09f04e38:

    # eva "Me encanta este sitio, pero tenías razón. Voy demasiado vestida para esto."
    eva "J'adore cet endroit, mais tu avais raison. Je suis trop bien habillée pour ça."

# game/scripts/c18/c18.rpy:644
translate french c18s001_Eva_3d6ea348:

    # mc "No creo. Ya te he dicho antes que estás preciosa. Puede que no sea una embajada, como ha dicho Amanda, pero si estás cómoda con ese vestido, nadie se va a quejar."
    mc "Je ne crois pas. Je t'ai déjà dit que tu es magnifique. Ce n'est peut-être pas une ambassade, comme l'a dit Amanda, mais si tu te sens à l'aise dans cette robe, personne ne s'en plaindra."

# game/scripts/c18/c18.rpy:645
translate french c18s001_Eva_96ee0478:

    # mc "¿De qué estabais discutiendo? ¿Hay algún problema entre vosotras?"
    mc "De quoi vous disputiez-vous ? Y a-t-il un problème entre vous deux ?"

# game/scripts/c18/c18.rpy:647
translate french c18s001_Eva_470c137b:

    # eva "¿Cómo sabes que estábamos discutiendo? Creía que solo sabias unas pocas palabras en lengua de signos."
    eva "Comment sais-tu que nous nous disputions ? Je croyais que tu ne connaissais que quelques mots de langue des signes."

# game/scripts/c18/c18.rpy:648
translate french c18s001_Eva_24b4818f:

    # mc "Me lo ha dicho Scarlett. No os entendía, pero por vuestros gestos dice que quedaba claro que era una discusión."
    mc "Scarlett me l'a dit. Elle ne vous comprenait pas, mais d'après vos gestes, il était clair qu'il s'agissait d'une dispute."

# game/scripts/c18/c18.rpy:650
translate french c18s001_Eva_e2fb139e:

    # eva "Me estaba acusando de algo y... la cosa se ha calentado..."
    eva "Il m'accusait de quelque chose et... la situation s'est envenimée..."

# game/scripts/c18/c18.rpy:651
translate french c18s001_Eva_ac64cb72:

    # mc "¿Puedo saber de qué te estaba acusando? ¿O es algo entre vosotras?"
    mc "Puis-je vous demander de quoi je vous accusais ? Ou est-ce une affaire entre vous deux ?"

# game/scripts/c18/c18.rpy:653
translate french c18s001_Eva_db7bd9f4:

    # eva "Ningún problema. Se está comportando como una niña celosa. Me acusaba de haberme puesto este vestido para ti."
    eva "Pas de problème. Elle se comporte juste comme une petite fille jalouse. Elle m'a accusée de porter cette robe pour toi."

# game/scripts/c18/c18.rpy:654
translate french c18s001_Eva_53534287:

    # eva "Como ella se ha tenido que poner uno de los vestidos de [emm]..."
    eva "Puisqu'elle devait porter une des robes de [emm]..."

# game/scripts/c18/c18.rpy:655
translate french c18s001_Eva_692ea280:

    # mc "¿Para mí? ¿Por qué?"
    mc "Pour moi ? Pourquoi ?"

# game/scripts/c18/c18.rpy:656
translate french c18s001_Eva_c7374d8d:

    # mc "¿Tiene algo que ver con que ayer la acusaras de flirtear conmigo?"
    mc "Est-ce que ça a un rapport avec le fait que tu l'aies accusée de flirter avec moi hier ?"

# game/scripts/c18/c18.rpy:658
translate french c18s001_Eva_0f9deee0:

    # eva "¡Chivata!"
    eva "Mouchard!"

# game/scripts/c18/c18.rpy:659
translate french c18s001_Eva_fb49920c:

    # mc "Igual de chivata que tú ahora mismo, Eva. *Risa*"
    mc "Tout aussi indiscrète que toi en ce moment, Eva. *Rires*"

# game/scripts/c18/c18.rpy:661
translate french c18s001_Eva_8fbb2f82:

    # eva "Tienes razón..."
    eva "Tu as raison..."

# game/scripts/c18/c18.rpy:662
translate french c18s001_Eva_5aab5dbc:

    # mc "Y... ¿realmente te lo has puesto para mí?"
    mc "Et... tu l'as vraiment porté pour moi ?"

# game/scripts/c18/c18.rpy:663
translate french c18s001_Eva_876fd190:

    # eva "Me lo he puesto porque quería estar guapa."
    eva "Je l'ai porté parce que je voulais être jolie."

# game/scripts/c18/c18.rpy:665
translate french c18s001_Eva_5003db39:

    # eva "Además, no tendría mucho sentido querer seducirte con un vestido si ya me has visto solo con las bragas... ¿no?"
    eva "D'ailleurs, ça n'aurait pas beaucoup de sens d'essayer de te séduire avec une robe si tu m'as déjà vue en culotte... n'est-ce pas ?"

# game/scripts/c18/c18.rpy:666
translate french c18s001_Eva_9632f557:

    # mc "*Risa* No me recuerdes ese día. No sabía que eras tú."
    mc "*Rires* Ne me rappelle pas ce jour-là. Je ne savais pas que c'était toi."

# game/scripts/c18/c18.rpy:667
translate french c18s001_Eva_505beb96:

    # mc "Pero creo que sabes poco de la mentalidad masculina. *Risa*"
    mc "Mais je crois que vous connaissez très peu la mentalité masculine. *Rires*"

# game/scripts/c18/c18.rpy:669
translate french c18s001_Eva_2283a464:

    # eva "¿A qué te refieres? ¿No te gusta el vestido?"
    eva "Que voulez-vous dire ? Vous n'aimez pas la robe ?"

# game/scripts/c18/c18.rpy:670
translate french c18s001_Eva_326e0be4:

    # mc "Me encanta."
    mc "Je l'aime."

# game/scripts/c18/c18.rpy:671
translate french c18s001_Eva_2640c7a4:

    # mc "Me refiero a que la mayoría de los hombres prefieren ganarse el derecho a ver una chica desnuda. Un poco de coqueteo, que te dejen queriendo más..."
    mc "Je veux dire, la plupart des hommes préfèrent mériter le droit de voir une femme nue. Un peu de flirt, et on en redemande…"

# game/scripts/c18/c18.rpy:672
translate french c18s001_Eva_631f85af:

    # mc "Si consiguen el premio sin esfuerzo, no le dan el valor que tiene. No digo que no lo valoren, pero no lo hacen lo suficiente."
    mc "S'ils obtiennent le prix sans effort, ils ne lui accordent pas la valeur qu'il mérite. Je ne dis pas qu'ils ne l'apprécient pas du tout, mais ils ne lui en accordent pas suffisamment."

# game/scripts/c18/c18.rpy:674
translate french c18s001_Eva_84a8b471:

    # eva "Mmmm... tomo nota. Es decir... si quiero algo con un chico... debería dejarle con ganas de más, ¿no?"
    eva "Mmm... J'y penserai. Enfin... si je veux quelque chose avec un garçon... je devrais le laisser sur sa faim, non ?"

# game/scripts/c18/c18.rpy:675
translate french c18s001_Eva_c21d463d:

    # mc "Sí, pero ve con cuidado. Si se lo haces muchas veces, puede pensar que eres una calienta pollas y perder el interés. Tienes que medir cuántas veces puedes o debes hacerlo."
    mc "Oui, mais attention. Si vous le faites trop souvent, il pourrait croire que vous le taquinez et se désintéresser. Il faut savoir doser la fréquence à laquelle vous pouvez ou devriez le faire."

# game/scripts/c18/c18.rpy:677
translate french c18s001_Eva_5c976d1f:

    # eva "OK. Primera vez."
    eva "OK. Première fois."

# game/scripts/c18/c18.rpy:678
translate french c18s001_Eva_a3db9a7f:

    # mc "¿Qué?"
    mc "Que?"

# game/scripts/c18/c18.rpy:680
translate french c18s001_Eva_f057ccd6:

    # mc "*Risa*"
    mc "*Rire*"

# game/scripts/c18/c18.rpy:681
translate french c18s001_Eva_ce10b6af:

    # mcp "(Tía Betty estaría orgullosa de mí ahora mismo. Esta vez no hace falta que le pregunte a Eva si el chico al que se refiere soy yo.)"
    mcp "(Tante Betty serait fière de moi en ce moment. Cette fois, je n'ai pas besoin de demander à Eva si le garçon dont elle parle, c'est moi.)"

# game/scripts/c18/c18.rpy:682
translate french c18s001_Eva_02bf18ee:

    # mcp "(Y sí, me ha dejado con ganas de más. ¿Qué voy a hacer con esta chica?)"
    mcp "(Et oui, elle m'a laissé sur ma faim. Que vais-je faire de cette fille ?)"

# game/scripts/c18/c18.rpy:694
translate french c18s001_Kate_7103f663:

    # "Te diriges a la mesa donde están las bebidas. Apenas has tenido tiempo de probar tu zumo de piña."
    "Vous vous dirigez vers la table où se trouvent les boissons. Vous avez à peine eu le temps de goûter votre jus d'ananas."

# game/scripts/c18/c18.rpy:696
translate french c18s001_Kate_9de0f56d:

    # mc "¿Qué tal, Kate? ¿No bailas?"
    mc "Salut Kate, comment ça va ? Tu ne danses pas ?"

# game/scripts/c18/c18.rpy:697
translate french c18s001_Kate_c6d1c6c8:

    # kat "No puedo bailar mientras te odio. *Risa*"
    kat "Je ne peux pas danser tant que je te déteste. *Rires*"

# game/scripts/c18/c18.rpy:698
translate french c18s001_Kate_e1dffb5b:

    # mc "¿Qué? ¿Por qué? ¿Qué he hecho yo ahora? ¿Puedo sentarme?"
    mc "Quoi ? Pourquoi ? Qu'est-ce que j'ai fait ? Je peux m'asseoir ?"

# game/scripts/c18/c18.rpy:700
translate french c18s001_Kate_58e58e6a:

    # kat "Convencerme para hacer más deporte. *Risa* Tengo agujetas en las agujetas."
    kat "Convainquez-moi de faire plus d'exercice. *Rires* J'ai des courbatures partout."

# game/scripts/c18/c18.rpy:701
translate french c18s001_Kate_c4cc1884:

    # kat "Yoga a primera hora, después Debbie me ha tenido media mañana nadando. Ayer Kim me sacó a correr 30 minutos por la carretera."
    kat "Yoga ce matin, puis Debbie m'a fait nager pendant une bonne partie de la matinée. Hier, Kim m'a emmenée courir 30 minutes sur la route."

# game/scripts/c18/c18.rpy:704
translate french c18s001_Kate_dfab0e8e:

    # kat "Y para ponerlo peor, me he tenido que retener de comer todas las cosas deliciosas que han preparado [mar] y [nor]."
    kat "Et pour couronner le tout, j'ai dû m'abstenir de manger toutes les délicieuses choses que [mar] et [nor] ont préparées."

# game/scripts/c18/c18.rpy:705
translate french c18s001_Kate_8720d35f:

    # kat "Y tengo que beber un cocktail sin alcohol. ¡Puagh! ¡Necesito mi azúcar intravenoso!"
    kat "Et je dois boire un cocktail sans alcool. Pfff ! J'ai besoin de ma perfusion de sucre !"

# game/scripts/c18/c18.rpy:706
translate french c18s001_Kate_23cbe36d:

    # mc "Comer saludable es bueno. [mar] y [nor] cocinan muy saludable, con lo que podrás comer de todo, pero quizás en menos cantidad de lo que lo hacías antes."
    mc "Bien manger, c'est bien. [mar] et [nor] cuisinent très sainement, donc vous pouvez tout manger, mais peut-être en plus petites quantités qu'avant."

# game/scripts/c18/c18.rpy:707
translate french c18s001_Kate_fae3d1b3:

    # mc "Piensa que es por tu bien. Y hacer deporte es bueno. Te dará más resistencia."
    mc "Voyez cela comme un acte bénéfique pour vous-même. Et faire du sport est excellent pour la santé. Cela vous donnera plus d'endurance."

# game/scripts/c18/c18.rpy:709
translate french c18s001_Kate_c586d63e:

    # kat "Lo sé, y todas me están ayudando mucho, pero duermo en la tercera planta."
    kat "Je sais, et ils m'aident tous beaucoup, mais je dors au troisième étage."

# game/scripts/c18/c18.rpy:710
translate french c18s001_Kate_7ebda716:

    # kat "Ayer casi tuve que subir el último tramo de escaleras a gatas. Las piernas se quejaban a cada escalón."
    kat "Hier, j'ai failli devoir ramper pour monter le dernier escalier. Mes jambes me faisaient souffrir à chaque marche."

# game/scripts/c18/c18.rpy:711
translate french c18s001_Kate_e1ccb57e:

    # mc "No hace falta que te esfuerces demasiado. Es mejor hacer las cosas bien y poco a poco que quemarte."
    mc "Inutile de trop vous surmener. Il vaut mieux bien faire les choses, petit à petit, que de s'épuiser."

# game/scripts/c18/c18.rpy:721
translate french c18s001_Kate_a7d6e7ab:

    # mc "Cuando hayas cogido un poco de resistencia, te llevaré a un lago precioso que hay en las colinas. Ya verás como vale la pena."
    mc "Une fois que tu auras repris des forces, je t'emmènerai à un magnifique lac dans les collines. Tu verras, ça vaut le détour."

# game/scripts/c18/c18.rpy:723
translate french c18s001_Kate_bf442a18:

    # kat "Oh, eso sería genial. Debbie y Kim me han dicho que es precioso."
    kat "Oh, ce serait formidable. Debbie et Kim m'ont dit que c'était magnifique."

# game/scripts/c18/c18.rpy:725
translate french c18s001_Kate_938700eb:

    # kat "Kim me ha dicho de subir un día corriendo al lago. Cuando haya conseguido que dar dos pasos no duela."
    kat "Kim m'a dit d'aller courir jusqu'au lac un jour. Quand j'aurai réussi à faire deux pas sans avoir mal."

# game/scripts/c18/c18.rpy:726
translate french c18s001_Kate_5c552fee:

    # mc "Cuando subáis avisadme y me apunto si puedo."
    mc "Préviens-moi quand tu y vas et je te rejoindrai si je peux."

# game/scripts/c18/c18.rpy:728
translate french c18s001_Kate_6418e5c1:

    # kat "Kim ya me ha dicho que las llevaste a ella y a Debbie y que es precioso."
    kat "Kim m'a déjà dit que tu les lui avais apportés, ainsi qu'à Debbie, et que c'était magnifique."

# game/scripts/c18/c18.rpy:730
translate french c18s001_Kate_9cd6998c:

    # kat "También has estado allí con Eileen y Alexia... y Eva..."
    kat "Tu étais aussi là avec Eileen et Alexia... et Eva..."

# game/scripts/c18/c18.rpy:732
translate french c18s001_Kate_c3b75b83:

    # kat "*Risa* ¡Y todas han estado contigo allí!"
    kat "*Rires* Et ils étaient tous là avec toi !"

# game/scripts/c18/c18.rpy:733
translate french c18s001_Kate_b86819b7:

    # kat "¿Es como tu terreno de caza particular? ¿El sitio donde llevas a las chicas para deslumbrarlas con la belleza del lugar?"
    kat "Est-ce comme votre terrain de chasse personnel ? L'endroit où vous emmenez les filles pour les éblouir par la beauté du lieu ?"

# game/scripts/c18/c18.rpy:734
translate french c18s001_Kate_e0e21fce:

    # mc "*Risa* No es eso, Kate."
    mc "*Rires* Ce n'est pas ça, Kate."

# game/scripts/c18/c18.rpy:744
translate french c18s001_Kate_abaf66fa:

    # mc "Pero si te llevase a ti, el deslumbrado sería el lago. Y sí, sé que suena cursi."
    mc "Mais si je t'emmenais, ce serait le lac qui serait ébloui. Et oui, je sais que ça fait un peu cliché."

# game/scripts/c18/c18.rpy:746
translate french c18s001_Kate_a56fa9d4:

    # kat "Y ahora quieres que me ruborice otra vez con tus piropos cursis."
    kat "Et maintenant, tu veux que je rougisse à nouveau avec tes compliments mielleux."

# game/scripts/c18/c18.rpy:747
translate french c18s001_Kate_6ce54d32:

    # mc "Ya te dije que, si querías, podía dejar de hacerlo."
    mc "Je vous ai déjà dit que, si vous le vouliez, je pouvais arrêter de le faire."

# game/scripts/c18/c18.rpy:749
translate french c18s001_Kate_9347f805:

    # kat "Y yo te dije ayer que no me molestan."
    kat "Et je vous ai dit hier qu'ils ne me dérangent pas."

# game/scripts/c18/c18.rpy:750
translate french c18s001_Kate_e27514af:

    # mc "Por lo que yo recuerdo, dijiste que no me atreviera a dejar de hacerlo. *Risa*"
    mc "Si je me souviens bien, tu as dit que je ne devais surtout pas arrêter. *Rires*"

# game/scripts/c18/c18.rpy:751
translate french c18s001_Kate_fc19720f:

    # kat "Es bonito que un chico me diga esas cosas de vez en cuando, aunque sea en broma."
    kat "C'est agréable quand un garçon me dit ce genre de choses de temps en temps, même si ce n'est qu'une blague."

# game/scripts/c18/c18.rpy:753
translate french c18s001_Kate_a9759c75:

    # "Suena un móvil, pero ella lo ignora."
    "Son téléphone portable sonne, mais elle l'ignore."

# game/scripts/c18/c18.rpy:754
translate french c18s001_Kate_57bc9e5a:

    # mc "¿Quién ha dicho que sea en broma?"
    mc "Qui a dit que c'était une blague ?"

# game/scripts/c18/c18.rpy:756
translate french c18s001_Kate_a0b49c3a:

    # kat "¿Qué? ¿Lo dices en serio?"
    kat "Quoi ? Vous êtes sérieux ?"

# game/scripts/c18/c18.rpy:759
translate french c18s001_Kate_e2994fbb:

    # "Suena un móvil."
    "Un téléphone portable sonne."

# game/scripts/c18/c18.rpy:762
translate french c18s001_Kate_7334a868:

    # emm "Hola, chicos. Kate, ¿te molesta que me lleve a mi hermano para bailar con él?"
    emm "Salut les gars. Kate, ça te dérange si j'amène mon frère pour danser avec lui ?"

# game/scripts/c18/c18.rpy:764
translate french c18s001_Kate_c00df548:

    # kat "No, para nada. Todo tuyo. Llévatelo o al final me va a convencer para ir a correr. *Risa*"
    kat "Non, pas du tout. C'est à toi. Prends-le, ou tu vas me convaincre de prendre mes jambes à mon cou. *Rires*"

# game/scripts/c18/c18.rpy:766
translate french c18s001_Kate_9ac5dc0a:

    # mc "Te veo luego, Kate, y, si quieres, seguimos la conversación. *Risa*"
    mc "À plus tard, Kate, et si tu veux, on peut continuer notre conversation. *Rires*"

# game/scripts/c18/c18.rpy:806
translate french c18s001_Emma_780c398b:

    # emm "Ha sido una gran idea venir aquí. Una sala solo para nosotros es genial. Sin problemas con idiotas como en el Twins."
    emm "C'était une excellente idée de venir ici. Avoir une chambre rien que pour nous, c'est fantastique. Aucun problème avec des imbéciles comme à Twins."

# game/scripts/c18/c18.rpy:807
translate french c18s001_Emma_21917f11:

    # mc "Y sin que todas me tengáis que besar para quitárnoslos de encima."
    mc "Et sans que vous ayez tous à m'embrasser pour qu'ils nous lâchent."

# game/scripts/c18/c18.rpy:809
translate french c18s001_Emma_62347b9d:

    # emm "Bueno... yo no tuve oportunidad de besarte."
    emm "Eh bien… je n’ai pas eu l’occasion de t’embrasser."

# game/scripts/c18/c18.rpy:810
translate french c18s001_Emma_ca2fd263:

    # mc "Pero lo hiciste luego en mi habitación."
    mc "Mais tu l'as fait plus tard dans ma chambre."

# game/scripts/c18/c18.rpy:813
translate french c18s001_Emma_f6d7a818:

    # emm "Y me muero de ganas de hacerlo aquí ahora. Pero, por una vez, no quiero ser el centro de atención."
    emm "Et j'ai tellement envie de le faire ici et maintenant. Mais, pour une fois, je ne veux pas être au centre de l'attention."

# game/scripts/c18/c18.rpy:814
translate french c18s001_Emma_b92bbdee:

    # emm "[eri] lo sabe, pero [dap] no. También es su cumpleaños y no me gustaría que se sintiera mal."
    emm "[eri] le sait, mais [dap] ne le sait pas. C'est aussi son anniversaire, et je ne voudrais pas qu'elle se sente mal."

# game/scripts/c18/c18.rpy:815
translate french c18s001_Emma_7405b48f:

    # mc "¿Por qué iba a sentirse mal?"
    mc "Pourquoi se sentirait-elle mal ?"

# game/scripts/c18/c18.rpy:818
translate french c18s001_Emma_71cbd563:

    # emm "Creo que a ella también le gustas, y no me refiero como primo."
    emm "Je pense qu'elle t'apprécie aussi, et je ne parle pas d'une relation cousin-cousine."

# game/scripts/c18/c18.rpy:819
translate french c18s001_Emma_3bb7dffc:

    # emm "Besarte aquí sería restregarle por la cara que yo estoy contigo y ella no."
    emm "T'embrasser ici reviendrait à lui faire comprendre que je suis avec toi et pas elle."

# game/scripts/c18/c18.rpy:821
translate french c18s001_Emma_211c0cea:

    # mcp "(Tu memoria es muy interesante, [emm]. Ya no recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que salía con alguien.)"
    mcp "(Votre mémoire est très intéressante, [emm]. Vous ne vous souvenez plus que, lors du premier repas avec Meemaw et tante Betty, elle a dit qu'elle voyait quelqu'un.)"

# game/scripts/c18/c18.rpy:823
translate french c18s001_Emma_5262424c:

    # mcp "(Eres muy lista, [emm]. Seguro que recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que había un chico que le interesaba y seguro que lo has relacionado conmigo.)"
    mcp "(Tu es très intelligent, [emm]. Je suis sûr que tu te souviens que, lors du premier repas avec Meemaw et tante Betty, elle a dit qu'il y avait un garçon qui l'intéressait, et je suis sûr que tu l'as associé à moi.)"

# game/scripts/c18/c18.rpy:824
translate french c18s001_Emma_3ac08a88:

    # mc "Si no te equivocas, y es un \"si\" muy grande, tienes razón. La harías sentir mal. Es el problema de no querer hacerlo público, [emm]."
    mc "Si je ne me trompe pas — et c'est un grand « oui » —, vous avez raison. Vous la feriez se sentir mal. C'est le problème quand on ne veut pas rendre cela public."

# game/scripts/c18/c18.rpy:827
translate french c18s001_Emma_c580d8ea:

    # emm "No creo que me equivoque. Ni siquiera [eri] le ha dicho que estáis juntos. Supongo que será porque ella también lo ha notado."
    emm "Je ne crois pas me tromper. Elle ne lui a même pas dit que vous étiez ensemble. J'imagine que c'est parce qu'elle l'a remarqué aussi."

# game/scripts/c18/c18.rpy:828
translate french c18s001_Emma_0f7534a6:

    # mc "O porque quiere dejar pasar los cumpleaños para hacer el anuncio a toda la familia."
    mc "Ou parce qu'il veut attendre après les anniversaires pour faire l'annonce à toute la famille."

# game/scripts/c18/c18.rpy:829
translate french c18s001_Emma_03d2c26a:

    # mc "Pero deberíamos empezar a pensar cuándo quieres hacer público lo tuyo y lo mío."
    mc "Mais nous devrions commencer à réfléchir au moment où vous voudrez rendre vos choses et les miennes publiques."

# game/scripts/c18/c18.rpy:832
translate french c18s001_Emma_a989a2a8:

    # emm "También es su fin de semana y sería un bombazo para todo el mundo."
    emm "C'est aussi leur week-end et ce serait un événement majeur pour tout le monde."

# game/scripts/c18/c18.rpy:834
translate french c18s001_Emma_78568af6:

    # emm "Y si [eri] también lo hiciera público..."
    emm "Et si [eri] le rendait également public..."

# game/scripts/c18/c18.rpy:835
translate french c18s001_Emma_bb143c4c:

    # mc "Tienes razón. Deberíamos pensar en cuándo quieres hacerlo público."
    mc "Vous avez raison. Nous devrions réfléchir au moment où vous voudrez le rendre public."

# game/scripts/c18/c18.rpy:837
translate french c18s001_Emma_b1e4ce5f:

    # mc "Mamá, [eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "Maman, [eri] et Eileen sont déjà au courant. C'est à toi de décider quand tu veux l'annoncer aux autres."

# game/scripts/c18/c18.rpy:839
translate french c18s001_Emma_88c6df49:

    # mc "[eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "[eri], et Eileen est déjà au courant. C'est à toi de décider quand tu veux le dire aux autres."

# game/scripts/c18/c18.rpy:841
translate french c18s001_Emma_01c142b5:

    # emm "¿Prometes no enfadarte?"
    emm "Promettez-vous de ne pas vous mettre en colère ?"

# game/scripts/c18/c18.rpy:842
translate french c18s001_Emma_1742a8e9:

    # mc "¿Qué has hecho ahora? ¿Delante de quién más se te ha escapado?"
    mc "Qu'as-tu encore fait ? Devant qui d'autre l'a-t-il laissé échapper ?"

# game/scripts/c18/c18.rpy:843
translate french c18s001_Emma_78aa2d2f:

    # emm "No es eso... Hoy me he levantado con nauseas. No sé si es porque ayer comí como una cerda o... Hace nueve días de nuestra primera vez, y si estuviera embarazada..."
    emm "Ce n'est pas ça… Je me suis réveillée avec des nausées aujourd'hui. Je ne sais pas si c'est parce que j'ai trop mangé hier ou… Ça fait neuf jours depuis notre première fois, et si j'étais enceinte…"

# game/scripts/c18/c18.rpy:845
translate french c18s001_Emma_21f4ac1e:

    # emm "El fin de semana que viene podría hacerme una prueba de embarazo."
    emm "Je pourrais faire un test de grossesse le week-end prochain."

# game/scripts/c18/c18.rpy:846
translate french c18s001_Emma_26027b19:

    # mc "¡Oh, mierda!"
    mc "Oh merde!"

# game/scripts/c18/c18.rpy:848
translate french c18s001_Emma_64a6cd98:

    # emm "¿Qué pasa? ¿No quieres tener un hijo conmigo?"
    emm "Qu'est-ce qui ne va pas ? Tu ne veux pas avoir un enfant avec moi ?"

# game/scripts/c18/c18.rpy:849
translate french c18s001_Emma_ea1a62df:

    # "Le explicas lo de las pruebas rápidas de embarazo."
    "Vous lui expliquez le principe des tests de grossesse rapides."

# game/scripts/c18/c18.rpy:851
translate french c18s001_Emma_d18754b4:

    # emm "¿Por qué no me lo habías dicho antes?"
    emm "Pourquoi ne me l'as-tu pas dit avant ?"

# game/scripts/c18/c18.rpy:852
translate french c18s001_Emma_f96b81cf:

    # mc "Estabas tan enfadada el día de la comida con Eva que... me olvidé. Creía habértelo dicho."
    mc "Tu étais tellement en colère contre Eva le jour du déjeuner que… j’ai oublié. Je croyais te l’avoir dit."

# game/scripts/c18/c18.rpy:854
translate french c18s001_Emma_fc57eead:

    # emm "En cuanto lleguemos a casa me la hago. Cubrirá nuestras dos veces y mañana lo podríamos saber."
    emm "Je le prendrai dès notre retour à la maison. Ça couvrira nos deux cycles, et on devrait avoir les résultats demain."

# game/scripts/c18/c18.rpy:855
translate french c18s001_Emma_b656199d:

    # mc "24 horas después de hacer la prueba estaremos jugando a DnD. ¿Serás capaz de aguantar sin mirarlo hasta que acabe la partida?"
    mc "24 heures après avoir passé le test, nous jouerons à Donjons et Dragons. Pourrez-vous résister à la tentation de le regarder jusqu'à la fin de la partie ?"

# game/scripts/c18/c18.rpy:857
translate french c18s001_Emma_882c93d1:

    # emm "Mierda, tienes razón. Y decirles a las chicas que nos tenemos que ir los dos a la vez... mejor no."
    emm "Mince, t'as raison. Et dire aux filles qu'on doit partir toutes les deux en même temps… vaut mieux pas."

# game/scripts/c18/c18.rpy:858
translate french c18s001_Emma_8c761108:

    # emm "Mejor la hacemos mañana por la mañana y lo sabremos el lunes."
    emm "Il vaudrait mieux le faire demain matin et nous le saurons lundi."

# game/scripts/c18/c18.rpy:859
translate french c18s001_Emma_349c7006:

    # mc "Me parece una buena idea. Me paso por tu habitación cuando me despierte."
    mc "Ça me paraît une bonne idée. Je passerai dans ta chambre en me réveillant."

# game/scripts/c18/c18.rpy:862
translate french c18s001_Emma_29ab53e7:

    # emm "No me lo recuerdes... ¡Qué vergüenza!"
    emm "Ne m'en parlez pas... Quelle honte !"

# game/scripts/c18/c18.rpy:863
translate french c18s001_Emma_9da35e94:

    # mc "No pasa nada. Ya lo hablamos y todo quedó aclarado."
    mc "C'est bon. On en a déjà parlé et tout est rentré dans l'ordre."

# game/scripts/c18/c18.rpy:865
translate french c18s001_Emma_6c33ef89:

    # "Suena un móvil justo en el momento en que se enciende el proyector y aparece Megan en la pantalla gigante."
    "Un téléphone portable sonne juste au moment où le projecteur s'allume et que Megan apparaît sur l'écran géant."

# game/scripts/c18/c18.rpy:868
translate french c18s001_Emma_530f61fd:

    # meg "Buenas noches a todos. Voy a empezar con mi primera actuación de la noche."
    meg "Bonsoir à tous. Je vais commencer par ma première prestation de la soirée."

# game/scripts/c18/c18.rpy:869
translate french c18s001_Emma_9c1b3477:

    # meg "Esta noche tengo a un grupo de amigos... a mi familia... en el local, con lo que hoy es muy emotivo para mí."
    meg "Ce soir, j'ai un groupe d'amis... ma famille... sur place, donc aujourd'hui est une journée très émouvante pour moi."

# game/scripts/c18/c18.rpy:870
translate french c18s001_Emma_6b288041:

    # meg "Tan solo espero que disfrutéis estas canciones. ¡Vamos allá!"
    meg "J'espère que vous apprécierez ces chansons. C'est parti !"

# game/scripts/c18/c18.rpy:888
translate french c18s001_Saira_c73c0060:

    # sai "Creo que es mi turno de un baile contigo, ¿no?"
    sai "Je crois que c'est à mon tour de danser avec vous, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:889
translate french c18s001_Saira_affd4dab:

    # mc "Por supuesto, además esta canción me encanta."
    mc "Bien sûr, j'adore aussi cette chanson."

# game/scripts/c18/c18.rpy:891
translate french c18s001_Saira_792c3b3e:

    # mc "¿Qué tal te lo estás pasando?"
    mc "Comment vous amusez-vous ?"

# game/scripts/c18/c18.rpy:892
translate french c18s001_Saira_9955125c:

    # sai "Genial, la sala privada está muy bien y podemos bailar sin tener que luchar por el espacio."
    sai "Super, la salle privée est très agréable et nous pouvons danser sans avoir à nous disputer l'espace."

# game/scripts/c18/c18.rpy:893
translate french c18s001_Saira_f7d55e1d:

    # sai "Ni siquiera tenemos que luchar por ti..."
    sai "Nous n'avons même pas besoin de nous battre pour vous..."

# game/scripts/c18/c18.rpy:894
translate french c18s001_Saira_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c18/c18.rpy:896
translate french c18s001_Saira_5519520e:

    # sai "A que [dap] es muy lista. Eres el único chico que hay, con lo que todas vamos a bailar contigo."
    sai "Je parie que [dap] est vraiment intelligent. Tu es le seul garçon du coin, alors on va tous danser avec toi."

# game/scripts/c18/c18.rpy:897
translate french c18s001_Saira_bb8c4abd:

    # sai "En vez de pelearnos por ver a quién le toca, ha montado un sistema de turnos."
    sai "Au lieu de se disputer pour savoir à qui le tour, il a mis en place un système de roulement."

# game/scripts/c18/c18.rpy:898
translate french c18s001_Saira_1048adb6:

    # mc "*Risa* Algo así sólo se le podía haber ocurrido a [dap]."
    mc "*Rires* Seul [dap] aurait pu inventer une chose pareille."

# game/scripts/c18/c18.rpy:900
translate french c18s001_Saira_5fe1c336:

    # sai "Scarlett también participó haciendo la app que cada una tenemos en el móvil."
    sai "Scarlett a également participé en créant l'application que nous avons tous sur nos téléphones portables."

# game/scripts/c18/c18.rpy:901
translate french c18s001_Saira_e10704bc:

    # mc "¿Qué? ¿Tenéis una app para saber cuándo os toca bailar conmigo?"
    mc "Quoi ? Tu as une application pour savoir quand c'est ton tour de danser avec moi ?"

# game/scripts/c18/c18.rpy:903
translate french c18s001_Saira_b626d4a0:

    # sai "*Risa* Sí, pero no me mires así, Scarlett tenía la app medio hecha para otra cosa y la ha adaptado para esta noche."
    sai "*Rires* Oui, mais ne me regardez pas comme ça, Scarlett avait commencé l'application pour autre chose et elle l'a adaptée pour ce soir."

# game/scripts/c18/c18.rpy:904
translate french c18s001_Saira_9315f609:

    # mc "¿Cómo ha funcionado cuando he ido a hablar con Kate?"
    mc "Comment ça s'est passé quand je suis allée parler à Kate ?"

# game/scripts/c18/c18.rpy:906
translate french c18s001_Saira_e84a1e7f:

    # sai "Scarlett y [dap] te conocen muy bien y sabían que pasaría algo así. Tienen una opción para mover los turnos. Pero sólo los pueden mover ellas"
    sai "Scarlett et [dap] vous connaissent très bien et savaient que quelque chose comme ça arriverait. Elles ont la possibilité de modifier le tour, mais elles seules peuvent le faire."

# game/scripts/c18/c18.rpy:907
translate french c18s001_Saira_80f41837:

    # mc "*Risa* Y todas vosotras confiáis de ellas para que los muevan sin hacer trampas, ¿no?"
    mc "*Rires* Et vous leur faites tous confiance pour les déplacer sans tricher, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:909
translate french c18s001_Saira_4534c409:

    # sai "También han pensado en eso. Nos llega una notificación a todas con los cambios. No pueden moverlos sin que nos enteremos."
    sai "Ils y ont pensé aussi. Nous recevons tous une notification concernant les changements. Ils ne peuvent pas les effectuer sans que nous le sachions."

# game/scripts/c18/c18.rpy:910
translate french c18s001_Saira_1f7ef1eb:

    # sai "Así se fomenta la confianza, ¿no? *Risa*"
    sai "C'est comme ça qu'on instaure la confiance, non ? *Rires*"

# game/scripts/c18/c18.rpy:911
translate french c18s001_Saira_6ebc3eab:

    # mc "*Risa* Sois tremendas."
    mc "*Rires* Vous êtes formidables !"

# game/scripts/c18/c18.rpy:914
translate french c18s001_Saira_7e6135bc:

    # sai "Estoy pensando en que deberíamos montar algo parecido a esta app para saber cuándo podemos tener tiempo a solas contigo cada una de las chicas de tu harén. *Risa*"
    sai "Je me disais qu'on devrait créer une appli similaire à celle-ci pour que chacune des filles de ton harem sache quand on peut passer un moment en tête-à-tête avec toi. *Rires*"

# game/scripts/c18/c18.rpy:916
translate french c18s001_Saira_c7df6ada:

    # sai "Estoy pensando en pedirle que haga una adaptación de la app para saber cuándo estás libre para tener tiempo a solas contigo. *Risa*"
    sai "Je pense lui demander de modifier l'appli pour que je sache quand tu es disponible pour avoir un peu de temps pour toi. *Rires*"

# game/scripts/c18/c18.rpy:918
translate french c18s001_Saira_f0d9c50c:

    # sai "Si hubiéramos vuelto a lo que teníamos en Portland, hubiese sido algo muy útil. Especialmente si estás con otras mujeres."
    sai "Si nous étions revenues à ce que nous avions à Portland, cela aurait été très utile. Surtout si vous êtes avec d'autres femmes."

# game/scripts/c18/c18.rpy:919
translate french c18s001_Saira_a60320f7:

    # mc "Sí, no hubiera estado mal tener algo así. *Risa*"
    mc "Oui, ça n'aurait pas été désagréable d'avoir quelque chose comme ça. *Rires*"

# game/scripts/c18/c18.rpy:920
translate french c18s001_Saira_e5903d6d:

    # mc "Aunque habría que poner algún botón para imprevistos que me llenasen la agenda por un par de días porque nadie más quiere o puede resolverlos."
    mc "Je devrais peut-être ajouter un bouton pour les événements imprévus qui remplissent mon agenda pendant quelques jours parce que personne d'autre ne veut ou ne peut s'en occuper."

# game/scripts/c18/c18.rpy:922
translate french c18s001_Saira_6ef7dc9d:

    # mc "*Risa* No creo que sea tan difícil tener tiempo a solas conmigo, ¿no?"
    mc "*Rires* Je ne pense pas que ce soit si difficile de passer un peu de temps seul avec moi, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:924
translate french c18s001_Saira_7397e24e:

    # sai "¿Lo estás diciendo en serio? ¡Llevo cuatro días aquí y me están saliendo telarañas esperándote! *Risa*"
    sai "Tu plaisantes ? Ça fait quatre jours que je suis là et je m'ennuie à mourir à t'attendre ! *Rires*"

# game/scripts/c18/c18.rpy:925
translate french c18s001_Saira_d890795a:

    # mc "*Risa* Sabes que no hace falta que me esperes y que tú puedes tomar la iniciativa cuando quieras, ¿no?"
    mc "*Rires* Tu sais que tu n'es pas obligé de m'attendre et que tu peux prendre l'initiative quand tu veux, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:926
translate french c18s001_Saira_af651527:

    # mc "No es que estemos en los 70 o en una película. Las chicas podéis decidir pasar a la acción y nadie os va a juzgar. *Risa*"
    mc "On n'est plus dans les années 70 ni dans un film. Mesdames, vous pouvez décider d'agir et personne ne vous jugera. *Rires*"

# game/scripts/c18/c18.rpy:927
translate french c18s001_Saira_29cab2db:

    # mc "Además, somos tú y yo. Nunca has estado esperando a que yo actuara."
    mc "D'ailleurs, il n'y a que toi et moi. Tu n'as jamais attendu que j'agisse."

# game/scripts/c18/c18.rpy:929
translate french c18s001_Saira_ae40e5f5:

    # sai "Mmmm... Tienes razón. Lo pensaré... "
    sai "Mmm... Tu as raison. J'y réfléchirai..."

# game/scripts/c18/c18.rpy:930
translate french c18s001_Saira_5b4dd07e:

    # mc "Una vez pase esta locura de fin de semana estaré mucho más libre. Al menos hasta que surja el siguiente problema que nadie más que yo pueda resolver. *Risa*"
    mc "Une fois ce week-end de folie terminé, j'aurai beaucoup plus de temps libre. Du moins, jusqu'au prochain problème que je serai la seule à pouvoir résoudre. *Rires*"

# game/scripts/c18/c18.rpy:932
translate french c18s001_Saira_a39cdc47:

    # sai "Te estamos exigiendo mucho entre todas, ¿no?"
    sai "On vous en demande tous beaucoup, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:933
translate french c18s001_Saira_b4d27d30:

    # mc "No, Saira. Eso es lo mejor de todo. No exigís nada. Lo hago todo porque me apetece y me siento a gusto haciéndolo por vosotras."
    mc "Non, Saira. C'est ça le mieux. Tu ne demandes rien. Je fais tout ça parce que j'en ai envie et que ça me fait du bien de le faire pour toi."

# game/scripts/c18/c18.rpy:934
translate french c18s001_Saira_7df3672e:

    # mc "Pero sois un montón, y siempre hay una urgencia, a alguien a quien llevar a algún sitio, algo que comprar, o algo en lo que ayudar."
    mc "Mais vous êtes tellement nombreux, et il y a toujours une urgence, quelqu'un à emmener quelque part, quelque chose à acheter ou quelque chose pour lequel apporter son aide."

# game/scripts/c18/c18.rpy:936
translate french c18s001_Saira_4d932e57:

    # sai "Sabes que casi todas tenemos carnet de conducir, ¿verdad? Las labores de taxista nos las podemos repartir entre nosotras y así tendrás más tiempo libre."
    sai "Vous savez que presque tous, nous avons le permis de conduire, n'est-ce pas ? Nous pouvons nous répartir les tâches de chauffeur de taxi, et ainsi vous aurez plus de temps libre."

# game/scripts/c18/c18.rpy:937
translate french c18s001_Saira_9a2f5a3b:

    # mc "Lo sé, pero si me pides que te lleve a algún sitio, lo voy a hacer. No te voy a decir \"toma las llaves del coche y ve tú sola\"."
    mc "Je sais, mais si tu me demandes de t'emmener quelque part, je le ferai. Je ne vais pas te dire : « Tiens, voilà les clés de la voiture, vas-y tout seul. »"

# game/scripts/c18/c18.rpy:938
translate french c18s001_Saira_dfb23f1f:

    # mc "Además, ya te digo que disfruto haciéndolo. Hacer cosas con y para vosotras es pasar tiempo con vosotras."
    mc "De plus, je peux vous dire que j'aime le faire. Faire des choses avec et pour vous, c'est passer du temps avec vous."

# game/scripts/c18/c18.rpy:940
translate french c18s001_Saira_1b4c9e02:

    # "Suena un móvil en algún lugar."
    "Un téléphone portable sonne quelque part."

# game/scripts/c18/c18.rpy:942
translate french c18s001_Saira_32ad5170:

    # sai "Mi turno ha acabado. Te dejo en buenas manos."
    sai "Mon service est terminé. Je vous laisse entre de bonnes mains."

# game/scripts/c18/c18.rpy:944
translate french c18s001_Saira_e202c819:

    # mc "*Risa* ¿Ves lo que te decía? Al final decidís mi agenda por mí."
    mc "*Rires* Tu vois ce que je te disais ? Au final, c'est toi qui décides de mon emploi du temps."

# game/scripts/c18/c18.rpy:1013
translate french c18s001_Erika_fa2c8d21:

    # eri "¿Bailas?"
    eri "Dansez-vous ?"

# game/scripts/c18/c18.rpy:1014
translate french c18s001_Erika_54ccd33d:

    # mc "Claro, es tu turno, ¿no? *Risa*"
    mc "Bien sûr, c'est à ton tour, n'est-ce pas ? *Rires*"

# game/scripts/c18/c18.rpy:1016
translate french c18s001_Erika_400259f7:

    # eri "*Risa* Sí, ahora me toca a mí."
    eri "*Rires* Oui, maintenant c'est mon tour."

# game/scripts/c18/c18.rpy:1017
translate french c18s001_Erika_917019cb:

    # eri "¿Quién te lo ha dicho?"
    eri "Qui t'a dit ça ?"

# game/scripts/c18/c18.rpy:1018
translate french c18s001_Erika_164415bf:

    # mc "Se dice el pecado, pero no el pecador."
    mc "Le péché est mentionné, mais pas le pécheur."

# game/scripts/c18/c18.rpy:1020
translate french c18s001_Erika_7a1bda8d:

    # eri "Tampoco importa. No es que lo quisiéramos guardar en secreto."
    eri "Ça n'a pas d'importance. Ce n'est pas comme si nous voulions le garder secret."

# game/scripts/c18/c18.rpy:1021
translate french c18s001_Erika_450f1508:

    # eri "Pero ha sido una buena idea por parte de [dap] y Scarlett."
    eri "Mais c'était une bonne idée de la part de [dap] et Scarlett."

# game/scripts/c18/c18.rpy:1022
translate french c18s001_Erika_00e0e961:

    # eri "Si te tenemos que compartir, mejor hacerlo de forma ordenada."
    eri "S'il nous faut partager quelque chose avec vous, autant le faire de manière organisée."

# game/scripts/c18/c18.rpy:1023
translate french c18s001_Erika_ef96eebc:

    # mc "Ha sido una buena idea, pero con fallos. ¿Qué pasaría si quiero bailar cuatro canciones seguidas contigo?"
    mc "C'était une bonne idée, mais elle n'était pas sans défauts. Et si j'ai envie de danser quatre chansons d'affilée avec toi ?"

# game/scripts/c18/c18.rpy:1025
translate french c18s001_Erika_2eb52358:

    # eri "*Risa* Me vería obligada a rechazarte durante el resto de la noche."
    eri "*Rires* Je serais obligé de te refuser pour le reste de la soirée."

# game/scripts/c18/c18.rpy:1026
translate french c18s001_Erika_cb8060d2:

    # eri "Pero todas sabemos que no lo harás. No querrías que el resto de las chicas se sintieran mal."
    eri "Mais on sait tous que tu ne le feras pas. Tu ne voudrais pas que les autres filles se sentent mal."

# game/scripts/c18/c18.rpy:1027
translate french c18s001_Erika_f490b78b:

    # mc "¡Joder, [eri]! *Risa* Me conocéis demasiado bien."
    mc "Mince alors, [eri] ! *Rires* Tu me connais trop bien."

# game/scripts/c18/c18.rpy:1029
translate french c18s001_Erika_6da28eef:

    # eri "No se lo digas a nadie, pero creo que mi hermana y Scarlett están haciendo un experimento social contigo. *Risa*"
    eri "Ne le dis à personne, mais je crois que ma sœur et Scarlett font une expérience sociale sur toi. *Rires*"

# game/scripts/c18/c18.rpy:1031
translate french c18s001_Erika_cf8c89f2:

    # eri "Bueno... mi hermana desde siempre... ahora tengo otra."
    eri "Eh bien… ma sœur a toujours été là… maintenant j’en ai une autre."

# game/scripts/c18/c18.rpy:1032
translate french c18s001_Erika_d77c1542:

    # eri "Y Scarlett casi lo es también."
    eri "Et Scarlett l'est presque aussi."

# game/scripts/c18/c18.rpy:1034
translate french c18s001_Erika_b5f98137:

    # mcp "(No vas desencaminada, pero creo que, como mucho, será prima)"
    mcp "(Vous n'êtes pas loin de la vérité, mais je pense qu'il s'agira tout au plus d'une cousine.)"

# game/scripts/c18/c18.rpy:1036
translate french c18s001_Erika_eb1f4371:

    # eri "Y el resto de las chicas... en un par de semanas nos vamos a empezar a llamar \"hermana\" las unas a las otras."
    eri "Et les autres filles... dans quelques semaines, on va commencer à s'appeler \"sœur\"."

# game/scripts/c18/c18.rpy:1037
translate french c18s001_Erika_a2e6cde6:

    # eri "Antes Kim estaba hablando con Tía Betty y con Kiara. Ya es normal que la llamen \"Tía Betty\", pero es que ha llamado a Kiara \"Tía Kiara\"."
    eri "Plus tôt, Kim parlait à tante Betty et à Kiara. Il est normal que les gens l'appellent « tante Betty », mais elle appelait Kiara « tante Kiara »."

# game/scripts/c18/c18.rpy:1038
translate french c18s001_Erika_043f8beb:

    # mc "¿Se nos está yendo de las manos?"
    mc "La situation est-elle en train de dégénérer ?"

# game/scripts/c18/c18.rpy:1040
translate french c18s001_Erika_821c56f5:

    # eri "No, justo lo contrario. Es fantástico. Cuando mi madre me dijo que íbamos a tener chicas en casa, nunca me podría haber imaginado esto."
    eri "Non, tout au contraire. C'est fantastique. Quand ma mère m'a annoncé que nous allions avoir des filles, je n'aurais jamais pu imaginer ça."

# game/scripts/c18/c18.rpy:1042
translate french c18s001_Erika_e2977d0a:

    # eri "Si ese test sale positivo... Hope va a tener muchas más tías de lo que podría haber esperado."
    eri "Si le test est positif… Hope va avoir beaucoup plus de tantes qu’elle n’aurait jamais pu l’imaginer."

# game/scripts/c18/c18.rpy:1043
translate french c18s001_Erika_514c80bf:

    # mc "Seguro que se pelean por cambiarle los pañales. *Risa* Y eso nos dejará tiempo libre para nosotros."
    mc "Ils vont sûrement se disputer pour savoir qui va lui changer sa couche. *Rires* Et ça nous laissera du temps libre."

# game/scripts/c18/c18.rpy:1046
translate french c18s001_Erika_e127d7bd:

    # eri "Eso teniendo en cuenta que alguna de ellas tenga sus propios hijos."
    eri "Cela suppose que certains d'entre eux aient des enfants."

# game/scripts/c18/c18.rpy:1047
translate french c18s001_Erika_036d1fa2:

    # mc "Entonces dejaremos que Meemaw cambie los pañales de todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Alors on laissera Mémé changer les couches de tout le monde. *Rires* Tu sais bien qu'elle rêve d'avoir des arrière-petits-enfants."

# game/scripts/c18/c18.rpy:1049
translate french c18s001_Erika_c5327877:

    # eri "Podemos usar la app de Scarlett para que se organicen los turnos de cambio pañales. *Risa*"
    eri "On peut utiliser l'appli de Scarlett pour organiser les horaires de change. *Rires*"

# game/scripts/c18/c18.rpy:1050
translate french c18s001_Erika_ac53c2f1:

    # mc "Meemaw va a querer cambiarlos todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Mémé va vouloir tous les changer. *Rires* Tu sais qu'elle demande des arrière-petits-enfants."

# game/scripts/c18/c18.rpy:1051
translate french c18s001_Erika_95703ae4:

    # mc "Si los pide, debe tomar responsabilidad sobre ellos."
    mc "Si vous les demandez, vous devez en assumer la responsabilité."

# game/scripts/c18/c18.rpy:1053
translate french c18s001_Erika_c3606cad:

    # eri "Solo de pensar que vamos a tener que decírselo... me da miedo cómo se lo va a tomar. Esté embarazada o no lo esté."
    eri "Rien que d'y penser, j'ai peur de sa réaction. Qu'elle soit enceinte ou non."

# game/scripts/c18/c18.rpy:1055
translate french c18s001_Erika_99c24a15:

    # mc "Ya sabe que estoy con tu madre. Ladró un poco, pero tuvo que aceptarlo."
    mc "Il sait déjà que je suis avec ta mère. Il a aboyé un peu, mais il a dû s'y faire."

# game/scripts/c18/c18.rpy:1057
translate french c18s001_Erika_5e6fedba:

    # eri "¿Qué? ¿Cuándo?"
    eri "Quoi ? Quand ?"

# game/scripts/c18/c18.rpy:1059
translate french c18s001_Erika_10043148:

    # mc "Ya sabe que estoy con alguien de la familia. Ladró un poco, pero tuvo que aceptarlo."
    mc "Il sait déjà que je suis avec un membre de ma famille. Il a aboyé un peu, mais il a dû s'y faire."

# game/scripts/c18/c18.rpy:1062
translate french c18s001_Erika_d08fb9a3:

    # eri "¿Qué? ¿Cuándo? No sabía que a [emm] también se le hubiera escapado con ella."
    eri "Quoi ? Quand ? Je ne savais pas que [emm] avait aussi laissé échapper ça avec elle."

# game/scripts/c18/c18.rpy:1064
translate french c18s001_Erika_039eb2b1:

    # eri "¿Qué? ¿Cuándo? No voy a preguntar con quién..."
    eri "Quoi ? Quand ? Je ne vais pas demander à qui…"

# game/scripts/c18/c18.rpy:1067
translate french c18s001_Erika_320b1b0a:

    # mc "El día que fuimos a la playa para la comida navideña."
    mc "Le jour où nous sommes allés à la plage pour le déjeuner de Noël."

# game/scripts/c18/c18.rpy:1069
translate french c18s001_Erika_183071b5:

    # mc "El día que tuvimos la reunión con Aaron, Amanda, y Eva."
    mc "Le jour où nous avons eu la réunion avec Aaron, Amanda et Eva."

# game/scripts/c18/c18.rpy:1071
translate french c18s001_Erika_36163494:

    # eri "Entonces creo que estoy preparada para hacerlo público. El martes sería un buen día."
    eri "Je pense donc être prête à le rendre public. Mardi serait un bon jour."

# game/scripts/c18/c18.rpy:1073
translate french c18s001_Erika_68bc9a3f:

    # mc "Sigo pensando que le tenéis demasiado miedo. ¿Qué va a hacer? Ladrar un poco y aceptar lo que es un hecho sobre el que no tiene ningún control."
    mc "Je pense toujours que vous avez tous trop peur de lui. Que va-t-il faire ? Aboyer un peu et accepter un fait sur lequel il n’a aucune prise."

# game/scripts/c18/c18.rpy:1075
translate french c18s001_Erika_5d30da47:

    # eri "Tienes razón. Creo que estoy preparada para hacerlo público. El martes sería un buen día."
    eri "Vous avez raison. Je pense être prêt à le rendre public. Mardi serait un bon jour."

# game/scripts/c18/c18.rpy:1076
translate french c18s001_Erika_1c58d10f:

    # eri "Y si ese test sale positivo, soltamos las dos cosas a la vez."
    eri "Et si ce test s'avère positif, nous libérerons les deux produits simultanément."

# game/scripts/c18/c18.rpy:1077
translate french c18s001_Erika_84ab91bc:

    # mc "Me parece una buena idea. *Risa* No le habrá dado tiempo de recuperarse de las emociones de los cumpleaños."
    mc "Ça me paraît une bonne idée. *Rires* Elle n'a probablement pas eu le temps de se remettre de l'excitation de son anniversaire."

# game/scripts/c18/c18.rpy:1079
translate french c18s001_Erika_1647a260:

    # eri "Olvida lo del martes..."
    eri "Oubliez mardi..."

# game/scripts/c18/c18.rpy:1080
translate french c18s001_Erika_c5659800:

    # eri "Mejor no pongamos fecha o estaré nerviosa hasta que llegue."
    eri "Ne fixons pas de date, sinon je serai nerveuse jusqu'à son arrivée."

# game/scripts/c18/c18.rpy:1081
translate french c18s001_Erika_f85633ad:

    # mc "No hay ningún problema. Solo una pregunta. ¿Se lo quieres decir solo a la familia o a todas las chicas?"
    mc "Pas de problème. Juste une question. Tu veux le dire seulement à ta famille ou à toutes les filles ?"

# game/scripts/c18/c18.rpy:1083
translate french c18s001_Erika_1d26f527:

    # eri "A la familia. Y eso incluye a todas las chicas."
    eri "À la famille. Et cela inclut toutes les filles."

# game/scripts/c18/c18.rpy:1085
translate french c18s001_Erika_f85d43cd:

    # mc "Hemos ampliado la familia sin darnos cuenta."
    mc "Notre famille s'est agrandie sans même que nous nous en rendions compte."

# game/scripts/c18/c18.rpy:1086
translate french c18s001_Erika_7f5b4071:

    # eri "Desde luego."
    eri "Bien sûr."

# game/scripts/c18/c18.rpy:1088
translate french c18s001_Erika_6a17a408:

    # "Bailáis mientras charláis de cómo la llegada de las estudiantes y de Eva y Amanda ha cambiado vuestras vidas."
    "Vous dansez tout en discutant de la façon dont l'arrivée des élèves, d'Eva et d'Amanda, a changé vos vies."

# game/scripts/c18/c18.rpy:1090
translate french c18s001_Erika_e2994fbb:

    # "Suena un móvil."
    "Un téléphone portable sonne."

# game/scripts/c18/c18.rpy:1092
translate french c18s001_Erika_35f8cdd2:

    # eri "Mi turno ha acabado. No recuerdo a quién le tocaba ahora."
    eri "Mon service est terminé. Je ne me souviens plus à qui c'est le tour maintenant."

# game/scripts/c18/c18.rpy:1093
translate french c18s001_Erika_97ae267e:

    # mc "Dile a quien sea que le toque que me espere. Tengo que ir al lavabo un momento."
    mc "Dites à la personne dont c'est le tour de m'attendre. Je dois aller aux toilettes un instant."

# game/scripts/c18/c18.rpy:1094
translate french c18s001_Erika_1cb71367:

    # eri "De acuerdo. No tardes o se van a acabar las canciones para bailar pegados."
    eri "D'accord. Ne tardez pas, sinon nous n'aurons plus de chansons pour danser jusqu'au bout."

# game/scripts/c18/c18.rpy:1096
translate french c18s001_Erika_bbcbf13f:

    # mc "Hasta ahora."
    mc "Jusqu'à maintenant."

# game/scripts/c18/c18.rpy:1114
translate french c18s001_Debbie_c46379db:

    # mcp "(Ciertamente Lisa tenía razón. Un baño acorde con el local, con una bonita antesala que parece ser que se usa también como guardarropía cuando alquilan la sala anexa.)"
    mcp "(Lisa avait tout à fait raison. Une salle de bains en accord avec le style des lieux, avec une jolie antichambre qui sert apparemment aussi de vestiaire lorsque la chambre attenante est louée.)"

# game/scripts/c18/c18.rpy:1115
translate french c18s001_Debbie_99775246:

    # mcp "(Los lavabos de la sala principal no tienen una antesala como esta. Tampoco necesitan un guardarropía.)"
    mcp "(Les toilettes du hall principal ne disposent pas d'un sas comme celui-ci. Elles n'ont pas non plus besoin de vestiaire.)"

# game/scripts/c18/c18.rpy:1116
translate french c18s001_Debbie_9af7b28f:

    # mcp "(Hora de mear.)"
    mcp "(Il est temps d'aller aux toilettes.)"

# game/scripts/c18/c18.rpy:1118
translate french c18s001_Debbie_e41987e0:

    # "Un momento después..."
    "Un instant plus tard..."

# game/scripts/c18/c18.rpy:1119
translate french c18s001_Debbie_ab845631:

