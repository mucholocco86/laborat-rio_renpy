    deb "Je sais, mais je préfère en parler et clarifier les choses."

# game/scripts/c18/c18.rpy:1253
translate french c18s001_Debbie_bea7c623:

    # deb "Te veo luego. {size=20}Te quiero.{/size}"
    deb "À plus tard. Je t'aime."

# game/scripts/c18/c18.rpy:1254
translate french c18s001_Debbie_b93f4732:

    # mc "¿Qué has dicho? No te he oído bien."
    mc "Qu'avez-vous dit ? Je n'ai pas bien entendu."

# game/scripts/c18/c18.rpy:1256
translate french c18s001_Debbie_628a9937:

    # deb "Que te veo luego."
    deb "À plus tard."

# game/scripts/c18/c18.rpy:1257
translate french c18s001_Debbie_5fb46756:

    # deb "Si quieres seguir el orden de turnos, te toca bailar con Amanda. Es la siguiente en la lista."
    deb "Si tu veux respecter l'ordre des tours, c'est à ton tour de danser avec Amanda. Elle est la prochaine sur la liste."

# game/scripts/c18/c18.rpy:1259
translate french c18s001_Debbie_df551a8d:

    # mc "*Risa* No es lo que me ha parecido oír."
    mc "*Rires* Ce n'est pas ce que j'ai cru entendre."

# game/scripts/c18/c18.rpy:1261
translate french c18s001_Debbie_90ab1a2d:

    # mcp "(De vuelta al resto de chicas.)"
    mcp "(Retour aux autres filles.)"

# game/scripts/c18/c18.rpy:1263
translate french c18s001_Debbie_f33c4a4f:

    # deb "No, era mi turno de bailar contigo y, como tú has desaparecido, voy a aprovechar para hacer una visita que sólo yo puedo hacer. *Risita*"
    deb "Non, c'était à mon tour de danser avec toi, et puisque tu as disparu, je vais en profiter pour te rendre une visite que seule moi peux faire. *Rires*"

# game/scripts/c18/c18.rpy:1264
translate french c18s001_Debbie_bb596aed:

    # mc "¿Quieres que te espere para ese baile?"
    mc "Veux-tu que je t'attende pour cette danse ?"

# game/scripts/c18/c18.rpy:1266
translate french c18s001_Debbie_dde2c0e1:

    # deb "No hace falta. Ve a bailar con Amanda, si quieres, es la siguiente en la lista."
    deb "Ce n'est pas nécessaire. Va danser avec Amanda si tu veux ; c'est la prochaine sur la liste."

# game/scripts/c18/c18.rpy:1267
translate french c18s001_Debbie_abce1cc3:

    # mc "OK. Hasta ahora."
    mc "OK. Jusqu'ici."

# game/scripts/c18/c18.rpy:1269
translate french c18s001_Debbie_8f83e065:

    # deb "Hasta ahora."
    deb "Jusqu'à maintenant."

# game/scripts/c18/c18.rpy:1274
translate french c18s001_Amanda_655a1500:

    # "Vuelves a la sala y te diriges a Amanda."
    "Vous retournez dans la pièce et vous approchez d'Amanda."

# game/scripts/c18/c18.rpy:1276
translate french c18s001_Amanda_aa295703:

    # mc "Amanda, ¿te apetece bailar?"
    mc "Amanda, as-tu envie de danser ?"

# game/scripts/c18/c18.rpy:1277
translate french c18s001_Amanda_a3df03fb:

    # ama "Pero no es mi turno..."
    ama "Mais ce n'est pas mon tour..."

# game/scripts/c18/c18.rpy:1278
translate french c18s001_Amanda_53e219f7:

    # mc "No te preocupes por eso. Ya lo he hablado con Debbie."
    mc "Ne t'en fais pas. J'en ai déjà parlé à Debbie."

# game/scripts/c18/c18.rpy:1280
translate french c18s001_Amanda_90bb5c7a:

    # ama "Entonces, encantada de bailar contigo. Es la última canción de Megan antes de su descanso."
    ama "Alors, j'adorerais danser avec toi. C'est la dernière chanson de Megan avant sa pause."

# game/scripts/c18/c18.rpy:1281
translate french c18s001_Amanda_5fb383ee:

    # mc "Aprovechémosla entonces."
    mc "Profitons-en alors."

# game/scripts/c18/c18.rpy:1283
translate french c18s001_Amanda_cf96a5c9:

    # mc "¿Qué tal os lo estáis pasando?"
    mc "Comment allez-vous tous ?"

# game/scripts/c18/c18.rpy:1284
translate french c18s001_Amanda_49610271:

    # ama "¡Genial! Estar aquí con las chicas y tener más rato para conocernos es muy divertido."
    ama "Génial ! Être ici avec les filles et avoir plus de temps pour apprendre à se connaître, c'est vraiment super."

# game/scripts/c18/c18.rpy:1285
translate french c18s001_Amanda_aa41ce78:

    # mc "*Risa* Las conoces más que de sobras."
    mc "*Rires* Vous les connaissez mieux que quiconque."

# game/scripts/c18/c18.rpy:1287
translate french c18s001_Amanda_2beedcb0:

    # ama "Yo las conozco. Ellas aún no saben cómo soy. Al menos ya se están acabando las preguntas... raras."
    ama "Je les connais. Ils ne me connaissent pas encore. Au moins, les questions bizarres commencent à se raréfier."

# game/scripts/c18/c18.rpy:1288
translate french c18s001_Amanda_44b08d8e:

    # mc "¿Os han hecho muchas? ¿Me puedes poner un ejemplo de una de esas preguntas raras?"
    mc "Vous a-t-on souvent posé ce genre de questions ? Pourriez-vous me donner un exemple de l’une de ces questions étranges ?"

# game/scripts/c18/c18.rpy:1290
translate french c18s001_Amanda_2945c2c8:

    # ama "La más rara hasta ahora ha sido sobre si teníamos sexo con los clones XY."
    ama "La plus étrange jusqu'à présent concernait la question de savoir si nous avions eu des relations sexuelles avec les clones XY."

# game/scripts/c18/c18.rpy:1291
translate french c18s001_Amanda_49a8fb26:

    # mc "*Risa* Esa ha sido [emm], seguro. No sé si quiero saber la respuesta."
    mc "*Rires* C'était [emm], c'est sûr. Je ne sais pas si je veux connaître la réponse."

# game/scripts/c18/c18.rpy:1293
translate french c18s001_Amanda_bf4cd3cc:

    # ama "¿No saber la respuesta a si ha sido [emm] o a la pregunta? *Risa*"
    ama "Ne pas savoir si c'était [emm] ou la réponse à la question ? *Rires*"

# game/scripts/c18/c18.rpy:1294
translate french c18s001_Amanda_2068deef:

    # mc "A la pregunta."
    mc "Pour répondre à la question."

# game/scripts/c18/c18.rpy:1295
translate french c18s001_Amanda_af5c850c:

    # ama "Entonces te alegrará saber que no ha sido [emm]. Y la respuesta ha sido No. Pero no me preguntes quién ha sido. Era una conversación de chicas."
    ama "Alors tu seras content(e) d'apprendre que ce n'était pas [emm]. Et la réponse était non. Mais ne me demande pas qui c'était. C'était une conversation entre filles."

# game/scripts/c18/c18.rpy:1296
translate french c18s001_Amanda_360abff9:

    # mc "*Risa* Voy a empezar a recortar el tiempo que pasas con ellas, si empezáis a tener secretos."
    mc "*Rires* Je vais commencer à réduire le temps que tu passes avec eux si tu commences à leur cacher des choses."

# game/scripts/c18/c18.rpy:1298
translate french c18s001_Amanda_1acf09ab:

    # ama "Atrévete si no valoras tu vida. Y no es que vayamos a matarte ni Eva ni yo, sino ellas. *Risa*"
    ama "Vas-y, si tu ne tiens pas à ta vie. Et ce n'est pas comme si Eva ou moi allions te tuer, c'est eux. *Rires*"

# game/scripts/c18/c18.rpy:1299
translate french c18s001_Amanda_684f7eb4:

    # mc "Me lo creo. Ahora que os habéis encontrado os vais a hacer inseparables."
    mc "J'y crois. Maintenant que vous vous êtes trouvés, vous allez être inséparables."

# game/scripts/c18/c18.rpy:1300
translate french c18s001_Amanda_d7a83adb:

    # mc "Cambiando de tema y hablando de preguntas raras. ¿Quién es mayor? ¿Eva o tú?"
    mc "Changeons de sujet et parlons de questions bizarres. Qui est l'aîné(e) ? Eva ou toi ?"

# game/scripts/c18/c18.rpy:1303
translate french c18s001_Amanda_c188efa5:

    # ama "Yo. El grupo A salimos del tanque antes que el grupo B. Técnicamente \"nací\" dos días antes que Eva."
    ama "Moi. Le groupe A a quitté le bassin avant le groupe B. Techniquement, je suis « né » deux jours avant Ève."

# game/scripts/c18/c18.rpy:1305
translate french c18s001_Amanda_63ded428:

    # ama "Yo. Por dos días."
    ama "Moi. Pendant deux jours."

# game/scripts/c18/c18.rpy:1306
translate french c18s001_Amanda_6a5cc27f:

    # ama "Siempre le ha desagradado ser la más pequeña."
    ama "Elle a toujours détesté être la plus jeune."

# game/scripts/c18/c18.rpy:1308
translate french c18s001_Amanda_5fc9da8b:

    # ama "... desde que murió Fiona."
    ama "...depuis la mort de Fiona."

# game/scripts/c18/c18.rpy:1309
translate french c18s001_Amanda_2a3b7b3d:

    # mc "Espera... ¿Fiona era la más joven?"
    mc "Attendez… Fiona était la plus jeune ?"

# game/scripts/c18/c18.rpy:1310
translate french c18s001_Amanda_f181a472:

    # ama "Sí..."
    ama "Ouais..."

# game/scripts/c18/c18.rpy:1311
translate french c18s001_Amanda_44693662:

    # mc "Vuestros nombres entonces... ¿son por orden alfabético?"
    mc "Vos noms... sont-ils par ordre alphabétique ?"

# game/scripts/c18/c18.rpy:1313
translate french c18s001_Amanda_8738a641:

    # ama "Sí, nos los pusieron Aaron y Arnau. Hasta entonces éramos los sujetos A, B, C, D, E, y F."
    ama "Oui, Aaron et Arnau nous les ont donnés. Jusque-là, nous étions les sujets A, B, C, D, E et F."

# game/scripts/c18/c18.rpy:1314
translate french c18s001_Amanda_65481d7a:

    # mc "NTR os estaba deshumanizando..."
    mc "NTR vous déshumanisait..."

# game/scripts/c18/c18.rpy:1316
translate french c18s001_Amanda_0c2b58ea:

    # mc "Supongo que era más fácil para ellos hacerlo así que veros como personas. Como clones de su propia familia."
    mc "J'imagine que c'était plus facile pour eux de procéder ainsi que de vous considérer comme des personnes. Comme des clones de leur propre famille."

# game/scripts/c18/c18.rpy:1319
translate french c18s001_Amanda_b5da0eb9:

    # mc "Sin embargo, les pusieron nombres a [emm], [dap], y [eri]."
    mc "Cependant, ils ont donné des noms à [emm], [dap] et [eri]."

# game/scripts/c18/c18.rpy:1321
translate french c18s001_Amanda_435f2653:

    # ama "Los nombres se los pusieron cuando las sacaron del laboratorio. No podían presentarle a [mar] una niña y decirle que se llamaba Experimento XX-0-A. Prefirieron llamarla [emm]."
    ama "Ils leur ont donné des noms lorsqu'ils les ont sortis du laboratoire. Ils ne pouvaient pas présenter [mar] à une fille et lui dire qu'elle s'appelait Expérience XX-0-A. Ils préféraient l'appeler [emm]."

# game/scripts/c18/c18.rpy:1322
translate french c18s001_Amanda_f588893a:

    # ama "Querían estudiar cómo ellas y nosotras nos desarrollábamos diferente al estar en la base o el mundo exterior, con una familia normal."
    ama "Ils voulaient étudier comment eux et nous avions évolué différemment selon que nous étions sur la base ou dans le monde extérieur, au sein d'une famille normale."

# game/scripts/c18/c18.rpy:1323
translate french c18s001_Amanda_a7ea8669:

    # mc "¿Normal? Creo que somos cualquier cosa menos normal."
    mc "Normal ? Je pense que nous sommes tout sauf normaux."

# game/scripts/c18/c18.rpy:1324
translate french c18s001_Amanda_f0a1a1ef:

    # mc "Pero me alegra joderles el experimento."
    mc "Mais je suis ravi d'avoir ruiné leur expérience."

# game/scripts/c18/c18.rpy:1326
translate french c18s001_Amanda_0f46ae83:

    # ama "¿A qué te refieres con joderles el experimento? El experimento acabó con el accidente de avión."
    ama "Que voulez-vous dire par « ruiner leur expérience » ? L'expérience s'est terminée par le crash de l'avion."

# game/scripts/c18/c18.rpy:1327
translate french c18s001_Amanda_0763a07c:

    # mc "Bueno, de todas formas no podría continuar. Ahora vosotras también estáis en la misma familia. Aunque cada vez es menos normal. Ya no habría nada que estudiar."
    mc "Enfin bref, je ne pouvais pas continuer. Maintenant, vous faites tous partie de la même famille. Même si cela devient de moins en moins normal. Il n'y aurait plus rien à étudier."

# game/scripts/c18/c18.rpy:1328
translate french c18s001_Amanda_c077657c:

    # mc "Y si no hay experimento que joder, igualmente me alegra que estéis aquí. Sólo espero que entrar en la familia no estropee la relación entre Eva y tú."
    mc "Et même s'il n'y a pas d'expérience à perturber, je suis quand même content que tu sois là. J'espère juste que ton intégration dans la famille ne gâchera pas ta relation avec Eva."

# game/scripts/c18/c18.rpy:1329
translate french c18s001_Amanda_fe7bc238:

    # mc "Antes os he visto discutir."
    mc "Je vous ai vus vous disputer tout à l'heure."

# game/scripts/c18/c18.rpy:1331
translate french c18s001_Amanda_26640daa:

    # ama "Eva sigue dándole vueltas al beso de anoche. Pero se le pasará."
    ama "Eva repense encore au baiser d'hier soir. Mais elle finira par l'oublier."

# game/scripts/c18/c18.rpy:1332
translate french c18s001_Amanda_39401294:

    # mc "Y tú no la ayudas a olvidarlo acusándola de ponerse ese vestido por mí."
    mc "Et vous ne l'aidez pas à oublier en l'accusant d'avoir porté cette robe à cause de moi."

# game/scripts/c18/c18.rpy:1334
translate french c18s001_Amanda_d1473d1b:

    # ama "¿Te lo ha dicho? ¡Chivata!"
    ama "Il te l'a dit ? Balance !"

# game/scripts/c18/c18.rpy:1335
translate french c18s001_Amanda_9c9410e3:

    # mc "*Risa* Las dos habéis dicho lo mismo de la otra. ¿Te das cuenta de lo ridículo que suena?"
    mc "*Rires* Vous avez tous les deux dit la même chose l'un sur l'autre. Vous vous rendez compte à quel point c'est ridicule ?"

# game/scripts/c18/c18.rpy:1337
translate french c18s001_Amanda_b4199019:

    # ama "Ahora que lo has dicho... sí. Nos estamos comportando como niñas pequeñas. Todo esto es nuevo para nosotras..."
    ama "Maintenant que tu le dis… oui. On se comporte comme des gamines. Tout ça est nouveau pour nous…"

# game/scripts/c18/c18.rpy:1338
translate french c18s001_Amanda_3ed72d83:

    # mc "No pasa nada, Amanda. Pero no dejéis que os separe."
    mc "Ça va aller, Amanda. Mais ne laisse pas ça vous séparer."

# game/scripts/c18/c18.rpy:1339
translate french c18s001_Amanda_85ef00a7:

    # mc "Además..."
    mc "En plus..."

# game/scripts/c18/c18.rpy:1341
translate french c18s001_Amanda_9725d714:

    # mc "*Susurrando* Tú también estás preciosa con ese vestido."
    mc "*Chuchotant* Tu es magnifique dans cette robe aussi."

# game/scripts/c18/c18.rpy:1343
translate french c18s001_Amanda_6efc6087:

    # ama "¿De verdad lo crees? Gracias... Me lo ha prestado [emm], usamos casi la misma talla... *Risa* Lógicamente."
    ama "Tu crois vraiment ? Merci… [emm] me l’a prêté, on fait presque la même taille… *Rires* Bien sûr."

# game/scripts/c18/c18.rpy:1344
translate french c18s001_Amanda_256a28c5:

    # mc "Aunque sea un vestido prestado estás tan bonita como cualquier otra chica esta noche. No puedo esperar a verte con un vestido elegido por ti."
    mc "Même si c'est une robe empruntée, tu es aussi belle que n'importe quelle autre fille ce soir. J'ai hâte de te voir dans une robe que tu auras choisie toi-même."

# game/scripts/c18/c18.rpy:1346
translate french c18s001_Amanda_7447d7c3:

    # ama "Me vas a hacer ruborizar."
    ama "Tu vas me faire rougir."

# game/scripts/c18/c18.rpy:1347
translate french c18s001_Amanda_6f9744b0:

    # mc "Bueno, el estilo de Eva es el de una espía devora hombres. Quiero saber cuál es el tuyo. Seguro que estarás preciosa."
    mc "Le style d'Eva, c'est celui d'une espionne dévoreuse d'hommes. Et le vôtre ? Je suis sûre que vous serez magnifique."

# game/scripts/c18/c18.rpy:1349
translate french c18s001_Amanda_9225161a:

    # ama "¿Crees que debería ir a hablar con Eva? ¿Dejar las cosas claras?"
    ama "Tu crois que je devrais aller parler à Eva ? Mettre les choses au clair ?"

# game/scripts/c18/c18.rpy:1350
translate french c18s001_Amanda_a6f7a5dd:

    # mc "No lo sé. Tú la conoces mejor que yo. Si fuera [emm] yo lo haría."
    mc "Je ne sais pas. Tu la connais mieux que moi. Si j'étais [emm], je le ferais."

# game/scripts/c18/c18.rpy:1351
translate french c18s001_Amanda_34a79bc4:

    # ama "Es que es la primera vez que estamos en esta situación. Nunca nos hemos peleado por un chico."
    ama "C'est la première fois que nous nous trouvons dans cette situation. Nous ne nous sommes jamais disputées pour un garçon auparavant."

# game/scripts/c18/c18.rpy:1353
translate french c18s001_Amanda_6a4462aa:

    # ama "¡Oh! ¡Mierda! ¡Olvida lo que he dicho!"
    ama "Oh ! Merde ! Oubliez ce que j'ai dit !"

# game/scripts/c18/c18.rpy:1354
translate french c18s001_Amanda_d9be5c9f:

    # mc "No he oído nada."
    mc "Je n'ai rien entendu."

# game/scripts/c18/c18.rpy:1355
translate french c18s001_Amanda_b9270f79:

    # mcp "(Pero supongo que lo que no he oído responde a mi pregunta sobre si estabas flirteando conmigo.)"
    mcp "(Mais je suppose que ce que je n'ai pas entendu répond à ma question : est-ce que vous flirtez avec moi ?)"

# game/scripts/c18/c18.rpy:1357
translate french c18s001_Amanda_e5fd1794:

    # ama "Creo que voy a hablar con ella. Lisa es la siguiente."
    ama "Je crois que je vais lui parler. Lisa est la prochaine."

# game/scripts/c18/c18.rpy:1358
translate french c18s001_Amanda_1f4f4bb7:

    # mc "Arregladlo antes de que se enquiste. Voy a ver a Lisa."
    mc "Il faut régler le problème avant qu'il ne s'aggrave. Je vais voir Lisa."

# game/scripts/c18/c18.rpy:1360
translate french c18s001_Amanda_05648a53:

    # ama "{i}(¿Cómo puedo haber sido tan tonta como para que se me escape? Al menos ahora la pelota está en tu tejado, [mc].){/i}"
    ama "{i}(Comment ai-je pu être aussi stupide et laisser filer cette opportunité ? Au moins, maintenant, c'est à toi de jouer, [mc].){/i}"

# game/scripts/c18/c18.rpy:1388
translate french c18s001_Lisa_35e16f45:

    # mcp "(Lisa me cae bien, pero yo a ella no. ¿Debería sacarla a bailar?)"
    mcp "(J'aime bien Lisa, mais elle ne m'aime pas. Devrais-je l'inviter à danser ?)"

# game/scripts/c18/c18.rpy:1390
translate french c18s001_Lisa_9396281d:

    # mcp "(Quizás sea una oportunidad para conocernos mejor.)"
    mcp "(C’est peut-être l’occasion pour nous de mieux nous connaître.)"

# game/scripts/c18/c18.rpy:1400
translate french c18s001_Lisa_a6f47669:

    # mcp "(No quiero que se sienta mal porque no la saque a bailar en su turno.)"
    mcp "(Je ne veux pas qu'elle se sente mal parce que je ne lui ai pas demandé de danser à son tour.)"

# game/scripts/c18/c18.rpy:1402
translate french c18s001_Lisa_2ee04643:

    # mc "Lisa, ¿te apetece bailar?"
    mc "Lisa, as-tu envie de danser ?"

# game/scripts/c18/c18.rpy:1403
translate french c18s001_Lisa_ea9e4818:

    # lis "Por supuesto. Te veo luego, [dap]."
    lis "Bien sûr. À plus tard, [dap]."

# game/scripts/c18/c18.rpy:1405
translate french c18s001_Lisa_5f65dd86:

    # lis "{i}(No quiero que se sienta mal porque yo sea la única que la rechaza.){/i}"
    lis "{i}(Je ne veux pas qu'elle se sente mal parce que je suis le seul à la rejeter.){/i}"

# game/scripts/c18/c18.rpy:1407
translate french c18s001_Lisa_8353e812:

    # lis "{i}(No es tan mal chico como parecía al principio. Quizás me equivoqué juzgándolo.){/i}"
    lis "{i}(Il n'est pas aussi mauvais qu'il en avait l'air au premier abord. Je me suis peut-être trompé en le jugeant.){/i}"

# game/scripts/c18/c18.rpy:1409
translate french c18s001_Lisa_79fa0866:

    # lis "{i}(Además está con Debbie. Quizás sea buen momento para conocerlo mejor.){/i}"
    lis "{i}(En plus, il est avec Debbie. C'est peut-être le bon moment pour mieux le connaître.){/i}"

# game/scripts/c18/c18.rpy:1412
translate french c18s001_Lisa_93e3b3d3:

    # mcp "(No quiero que se sienta obligada a bailar conmigo exclusivamente porque lo dice una app.)"
    mcp "(Je ne veux pas qu'elle se sente obligée de danser exclusivement avec moi simplement parce qu'une application l'exige.)"

# game/scripts/c18/c18.rpy:1413
translate french c18s001_Lisa_3f196423:

    # mcp "(Mejor voy a por otro zumo.)"
    mcp "(Je ferais mieux de prendre un autre jus.)"

# game/scripts/c18/c18.rpy:1420
translate french c18s001_Lisa_ddaccb9f:

    # lis "Creo que me toca a mí bailar con el chico de la noche, ¿no?"
    lis "Je crois que c'est à mon tour de danser avec ce garçon ce soir, tu ne crois pas ?"

# game/scripts/c18/c18.rpy:1422
translate french c18s001_Lisa_83b3e321:

    # mc "Eso me han dicho. Pero si no te apetece..."
    mc "C'est ce qu'on m'a dit. Mais si tu n'en as pas envie..."

# game/scripts/c18/c18.rpy:1423
translate french c18s001_Lisa_9e25c035:

    # lis "No te preocupes, me apetece."
    lis "Ne t'inquiète pas, j'en ai envie."

# game/scripts/c18/c18.rpy:1424
translate french c18s001_Lisa_91b5562f:

    # lis "{i}(Además estás con Debbie. Quizás sea buen momento para conocerte mejor.){/i}"
    lis "{i}(En plus, tu es avec Debbie. C'est peut-être le bon moment pour mieux te connaître.){/i}"

# game/scripts/c18/c18.rpy:1426
translate french c18s001_Lisa_583254e8:

    # lis "No soy muy buena bailarina. Me vas a tener que llevar tú."
    lis "Je ne suis pas très douée en danse. Vous devrez me prendre."

# game/scripts/c18/c18.rpy:1427
translate french c18s001_Lisa_a7aa7709:

    # mc "*Risa* Si le preguntas a [emm], descubrirás que yo tampoco lo soy."
    mc "*Rires* Si vous demandez à [emm], vous découvrirez que moi non plus."

# game/scripts/c18/c18.rpy:1428
translate french c18s001_Lisa_cdc622c7:

    # mc "Pero me extraña tanto que chicas de clase alta no hayáis tomado clases de baile. Es lo que se ve en las películas. Danza, piano, y cosas por el estilo."
    mc "Mais je suis tellement surprise que les filles de la haute société n'aient pas pris de cours de danse. C'est ce qu'on voit dans les films : la danse, le piano, et tout ça."

# game/scripts/c18/c18.rpy:1430
translate french c18s001_Lisa_b5221f89:

    # mc "Debbie también me ha dicho que era mala bailarina, aunque no me ha pisado ni una vez. *Risa*"
    mc "Debbie m'a aussi dit que je dansais mal, même si elle ne m'a jamais marché sur les pieds. *Rires*"

# game/scripts/c18/c18.rpy:1432
translate french c18s001_Lisa_7b5b9ebe:

    # lis "¿Eh? No os he visto bailar... Me extraña tanto que mi hermana baile con un chico... Me hubiera gustado verlo."
    lis "Hein ? Je ne t'ai pas vue danser… Je suis tellement surprise que ma sœur ait dansé avec un garçon… J'aurais bien aimé voir ça."

# game/scripts/c18/c18.rpy:1433
translate french c18s001_Lisa_909eac03:

    # mc "Nos hemos cruzado en el guardarropía y hemos bailado allí."
    mc "Nous nous sommes retrouvés au vestiaire et nous avons dansé là."

# game/scripts/c18/c18.rpy:1434
translate french c18s001_Lisa_7ad9dbc1:

    # lis "Ah, OK. Un baile privado. Que romántico..."
    lis "Ah, d'accord. Une danse privée. Quel romantisme…"

# game/scripts/c18/c18.rpy:1436
translate french c18s001_Lisa_214b9b1b:

    # lis "Sobre las clases de baile... Ni Debbie ni yo estábamos interesadas. Mis padres lo intentaron, pero nosotras nos negamos."
    lis "Concernant les cours de danse… Ni Debbie ni moi n’étions intéressées. Mes parents ont essayé, mais nous avons refusé."

# game/scripts/c18/c18.rpy:1437
translate french c18s001_Lisa_ddafb0d3:

    # lis "Yo por rebeldía tonta y Debbie porque nunca estuvo interesada. Siempre le interesaron más otras actividades."
    lis "Je suis partie par pure rébellion, et Debbie est partie parce que ça ne l'a jamais intéressée. Elle a toujours préféré d'autres activités."

# game/scripts/c18/c18.rpy:1438
translate french c18s001_Lisa_557bdbe7:

    # mc "Lo de la rebeldía te pega. *Risa* Y a Debbie lo de estar interesada en los deportes en vez de en la danza."
    mc "Ce côté rebelle te va bien. *Rires* Et l'intérêt de Debbie pour le sport plutôt que pour la danse."

# game/scripts/c18/c18.rpy:1440
translate french c18s001_Lisa_7b1be3a0:

    # lis "*Risa* Sí, la verdad es que no quería ser un cliché de chica de clase alta y acabé siéndolo."
    lis "*Rires* Oui, la vérité c'est que je ne voulais pas être une fille de la haute société cliché et que j'ai fini par l'être."

# game/scripts/c18/c18.rpy:1441
translate french c18s001_Lisa_49779e7e:

    # lis "La chica blanca rica que va a manifestaciones de pro veganas y a protestas climáticas."
    lis "La riche fille blanche qui participe à des manifestations pro-véganes et à des protestations pour le climat."

# game/scripts/c18/c18.rpy:1442
translate french c18s001_Lisa_6a0756a0:

    # mc "Bueno, me parecen buenas causas."
    mc "Eh bien, je pense que ce sont de bonnes causes."

# game/scripts/c18/c18.rpy:1444
translate french c18s001_Lisa_5459d6e9:

    # lis "Lo son. Pero, en la mayoría de los casos, sirven de muy poco y sólo a nivel local. Alguien debería hacer algo en las esferas políticas."
    lis "Oui, elles existent. Mais dans la plupart des cas, elles sont peu utiles et efficaces uniquement au niveau local. Il faudrait que quelqu'un prenne des mesures sur le plan politique."

# game/scripts/c18/c18.rpy:1445
translate french c18s001_Lisa_9c56984a:

    # mc "El problema es encontrar a ese alguien, ¿no? La clase política suele tener demasiados intereses cruzados y estar atada a demasiados lobbies."
    mc "Le problème, c'est de trouver cette personne, n'est-ce pas ? La classe politique a généralement trop d'intérêts conflictuels et est liée à trop de groupes de pression."

# game/scripts/c18/c18.rpy:1447
translate french c18s001_Lisa_06944f43:

    # lis "Sí, y la mayoría de gente concienciada también está muy politizada. El establishment los tacha de comunistas, con lo que es difícil que alguna vez tengan poder."
    lis "Oui, et la plupart des personnes politiquement conscientes sont aussi très politisées. Le pouvoir en place les qualifie de communistes, il est donc peu probable qu'elles accèdent un jour au pouvoir."

# game/scripts/c18/c18.rpy:1448
translate french c18s001_Lisa_4f27d2d4:

    # mc "Y los que no estáis politizados, la base de esos movimientos, no estáis interesados en entrar en política. Tú estudias Arte, por ejemplo."
    mc "Et vous qui n'êtes pas politiquement actifs, la base de ces mouvements, ne souhaitez pas vous engager en politique. Vous étudiez l'art, par exemple."

# game/scripts/c18/c18.rpy:1450
translate french c18s001_Lisa_f800ee59:

    # lis "*Risa* ¿Me ves como alcaldesa de un pueblo? No es algo para mí."
    lis "*Rires* Vous me voyez comme maire d'une ville ? Ce n'est pas pour moi."

# game/scripts/c18/c18.rpy:1451
translate french c18s001_Lisa_213b30da:

    # mc "¿Por qué no? ¿Demasiadas responsabilidades? Al menos nadie te podría tachar de comunista."
    mc "Pourquoi pas ? Trop de responsabilités ? Au moins, personne ne pourrait vous accuser d'être communiste."

# game/scripts/c18/c18.rpy:1461
translate french c18s001_Lisa_0692a1e1:

    # mc "Dependiendo de tu programa, obviamente. Sé que, al menos, serías honesta."
    mc "Cela dépend évidemment de votre programme. Je sais qu'au moins, vous seriez honnête."

# game/scripts/c18/c18.rpy:1463
translate french c18s001_Lisa_260b12e0:

    # lis "¡Wow! Eso no me lo esperaba."
    lis "Waouh ! Je ne m'y attendais pas."

# game/scripts/c18/c18.rpy:1464
translate french c18s001_Lisa_ae28686e:

    # mc "¿Por qué no? Ahora que te conozco mejor, creo que podrías hacer un buen trabajo como alcaldesa de donde sea."
    mc "Pourquoi pas ? Maintenant que je vous connais mieux, je pense que vous feriez un excellent maire n'importe où."

# game/scripts/c18/c18.rpy:1466
translate french c18s001_Lisa_21301555:

    # lis "No es eso. No me veo ejerciendo la política. ¿Crees que alguien me votaría?"
    lis "Non, ce n'est pas ça. Je ne me vois pas faire de la politique. Croyez-vous que quelqu'un voterait pour moi ?"

# game/scripts/c18/c18.rpy:1468
translate french c18s001_Lisa_754ea9de:

    # mc "No hubiera votado por la Lisa que conocí en el aeropuerto. Pero sí por la que está bailando conmigo ahora mismo."
    mc "Je n'aurais pas voté pour la Lisa rencontrée à l'aéroport. Mais j'aurais voté pour celle qui danse avec moi en ce moment."

# game/scripts/c18/c18.rpy:1470
translate french c18s001_Lisa_763c6fa5:

    # lis "Me comporté como una imbécil, ¿verdad?"
    lis "J'ai agi comme un idiot, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:1471
translate french c18s001_Lisa_2854b7e8:

    # mc "Yo no diría eso, pero no fue demasiado agradable conocerte aquel día."
    mc "Je ne dirais pas ça, mais ce n'était pas très agréable de vous rencontrer ce jour-là."

# game/scripts/c18/c18.rpy:1472
translate french c18s001_Lisa_e92b2438:

    # lis "Lo siento..."
    lis "Je suis désolé..."

# game/scripts/c18/c18.rpy:1473
translate french c18s001_Lisa_18193b19:

    # mc "Un mal día lo tiene cualquiera. Nos has demostrado a todos que aquella Lisa no eras tú."
    mc "Tout le monde a des mauvais jours de temps en temps. Tu nous as tous prouvé que Lisa, ce n'était pas toi."

# game/scripts/c18/c18.rpy:1474
translate french c18s001_Lisa_be61b8d6:

    # mc "Si dejas que la gente te conozca, ¿por qué no te van a votar?"
    mc "Si vous laissez les gens apprendre à vous connaître, pourquoi ne voteraient-ils pas pour vous ?"

# game/scripts/c18/c18.rpy:1476
translate french c18s001_Lisa_16a151df:

    # lis "Se necesitan muchas cosas que no tengo. Carisma, contactos, pertenecer a un partido... Además, como has dicho, estudio Arte. No una carrera que tenga que ver con la política."
    lis "Il y a beaucoup de choses dont vous avez besoin et que je n'ai pas : du charisme, des relations, l'appartenance à un parti politique… De plus, comme vous l'avez dit, j'étudie l'art, pas la politique."

# game/scripts/c18/c18.rpy:1477
translate french c18s001_Lisa_eeedd398:

    # mc "Tuvimos a Arnold como gobernador aquí. *Risa* No estoy seguro de que estudiara algo relacionado con la política."
    mc "Nous avons eu Arnold comme gouverneur ici. *Rires* Je ne suis pas sûr qu'il ait fait des études en sciences politiques."

# game/scripts/c18/c18.rpy:1479
translate french c18s001_Lisa_949c3047:

    # lis "*Risa* Es verdad, los californianos sois raros. Elegís a un actor como gobernador."
    lis "*Rires* C'est vrai, vous autres Californiens êtes bizarres. Vous élisez un acteur comme gouverneur."

# game/scripts/c18/c18.rpy:1480
translate french c18s001_Lisa_1e9b5f62:

    # mc "*Risa* Los americanos somos raros. Elegimos a un actor como presidente... *Risa* Un actor que antes fue gobernador de California."
    mc "*Rires* Nous autres Américains, on est bizarres. On a élu un acteur comme président… *Rires* Un acteur qui a été gouverneur de Californie."

# game/scripts/c18/c18.rpy:1481
translate french c18s001_Lisa_918bef6f:

    # lis "*Risa* Es verdad. Al menos él ganó la Guerra Fría. ¿Qué hizo Arnold?"
    lis "*Rires* C'est vrai. Au moins, il a gagné la Guerre froide. Et Arnold, qu'a-t-il fait ?"

# game/scripts/c18/c18.rpy:1482
translate french c18s001_Lisa_dc7175bc:

    # mc "Permitirte beber alcohol esta noche. *Risa*"
    mc "Permets-toi de boire de l'alcool ce soir. *Rires*"

# game/scripts/c18/c18.rpy:1483
translate french c18s001_Lisa_3382fe0e:

    # lis "*Risa* Punto para Arnold."
    lis "*Rires* Point pour Arnold."

# game/scripts/c18/c18.rpy:1486
translate french c18s001_Lisa_236c7e34:

    # lis "Sé que esto va a sonarte raro, pero ¿podemos hablar de Debbie?"
    lis "Je sais que ça va paraître bizarre, mais est-ce qu'on peut parler de Debbie ?"

# game/scripts/c18/c18.rpy:1487
translate french c18s001_Lisa_81e2e7ad:

    # mc "Lo que quieras. Es tu hermana y tienes todo el derecho a hablar de ella."
    mc "Fais ce que tu veux. C'est ta sœur et tu as parfaitement le droit de parler d'elle."

# game/scripts/c18/c18.rpy:1489
translate french c18s001_Lisa_6b37feed:

    # lis "Me preocupa cómo se siente. Cómo la haces sentir."
    lis "Je m'inquiète de ce qu'elle ressent. De ce que tu lui fais ressentir."

# game/scripts/c18/c18.rpy:1490
translate french c18s001_Lisa_d13e97a4:

    # mc "Ya te dije que no tengo intención de hacerle daño."
    mc "Je vous ai déjà dit que je n'ai aucune intention de lui faire du mal."

# game/scripts/c18/c18.rpy:1492
translate french c18s001_Lisa_61450eff:

    # lis "Lo sé. Pero ayer, mientras me explicaba lo del lago... Nunca la había visto... la palabra que me viene a la cabeza es \"brillar\"... tanto como anoche."
    lis "Je sais. Mais hier, pendant qu'elle m'expliquait le lac… je ne l'avais jamais vu auparavant… le mot qui me vient à l'esprit est « briller »… autant que la nuit dernière."

# game/scripts/c18/c18.rpy:1493
translate french c18s001_Lisa_e5462fe1:

    # lis "Está muy ilusionada. Yo estoy muy contenta por ella, pero..."
    lis "Elle est très enthousiaste. Je suis très content pour elle, mais…"

# game/scripts/c18/c18.rpy:1494
translate french c18s001_Lisa_3a0ccfb7:

    # mc "Y te preocupa que acabe desilusionándola."
    mc "Et vous craignez que cela finisse par la décevoir."

# game/scripts/c18/c18.rpy:1497
translate french c18s001_Lisa_1138990b:

    # lis "Me ha dicho que estás saliendo con más chicas aparte de ella. Eso de por sí me desconcertó. Que lo hagas y que ella lo acepte me desconcierta aún más."
    lis "Elle m'a dit que tu voyais d'autres filles. Rien que ça, ça m'a perturbée. Le fait que tu le fasses et qu'elle trouve ça normal me perturbe encore plus."

# game/scripts/c18/c18.rpy:1498
translate french c18s001_Lisa_b04b9f66:

    # mc "Sí, estoy saliendo con más chicas. Pero no engaño a nadie. Para mí, cada una de ellas es igual de importante."
    mc "Oui, je vois plus de filles. Mais je ne trompe personne. Pour moi, elles sont toutes aussi importantes les unes que les autres."

# game/scripts/c18/c18.rpy:1500
translate french c18s001_Lisa_04b2decd:

    # lis "Me preocupa que puedas acabar haciéndole daño sin querer. Sé que no vas a hacerlo a propósito."
    lis "J'ai peur que tu ne le blesses accidentellement. Je sais que tu ne le ferais pas exprès."

# game/scripts/c18/c18.rpy:1501
translate french c18s001_Lisa_493919a2:

    # mc "Te prometo que voy a ir con todo el cuidado posible para evitar que eso pase."
    mc "Je promets de faire tout mon possible pour éviter que cela ne se produise."

# game/scripts/c18/c18.rpy:1502
translate french c18s001_Lisa_3e206ce6:

    # mc "Debbie es muy especial y la voy a tratar como se merece."
    mc "Debbie est très spéciale et je vais la traiter comme elle le mérite."

# game/scripts/c18/c18.rpy:1505
translate french c18s001_Lisa_fe0ef7cc:

    # lis "¿Puedo preguntar cómo funciona eso de salir con más de una chica?"
    lis "Puis-je vous demander comment ça marche de sortir avec plusieurs filles ?"

# game/scripts/c18/c18.rpy:1506
translate french c18s001_Lisa_4ecac2b6:

    # mc "Es muy fácil. Yo soy capaz de amar a diversas chicas a la vez. Pero cuando estoy con cualquiera de ellas, el resto no existe."
    mc "C'est très simple. Je suis capable d'aimer plusieurs filles à la fois. Mais quand je suis avec l'une d'elles, les autres n'existent plus."

# game/scripts/c18/c18.rpy:1507
translate french c18s001_Lisa_ae0e301e:

    # mc "Cuando estaba con tu hermana en guardarropía, no importaba si salía con alguna de las chicas que había aquí fuera, en casa, o en cualquier otro lado."
    mc "Quand j'étais avec ta sœur dans le vestiaire, peu m'importait que je sorte avec une des filles d'ici, de chez moi ou d'ailleurs."

# game/scripts/c18/c18.rpy:1509
translate french c18s001_Lisa_ec3019a0:

    # lis "*Risa* Lo has dicho de una forma en que es imposible saber con quién más sales."
    lis "*Rires* Tu l'as dit d'une manière qui rend impossible de savoir avec qui d'autre tu sors."

# game/scripts/c18/c18.rpy:1510
translate french c18s001_Lisa_e9242c3f:

    # mc "Cumplir con sus deseos es una forma de cuidarlas, Lisa."
    mc "Répondre à leurs souhaits est une façon de prendre soin d'eux, Lisa."

# game/scripts/c18/c18.rpy:1511
translate french c18s001_Lisa_4f04432e:

    # mc "Y ahora mismo, ninguna, incluyendo a Debbie, quiere hacer público lo nuestro."
    mc "Et pour l'instant, aucun d'eux, y compris Debbie, ne souhaite rendre notre relation publique."

# game/scripts/c18/c18.rpy:1512
translate french c18s001_Lisa_df133572:

    # mc "Pero, sin querer molestarte, creo que tu pregunta va más allá... como si hubiera una cuestión personal tuya."
    mc "Mais, sans vouloir vous offenser, je pense que votre question va plus loin… comme s’il s’agissait d’un problème personnel."

# game/scripts/c18/c18.rpy:1515
translate french c18s001_Lisa_cf614b5d:

    # lis "¿Puedo preguntar si eres totalmente monógamo? Después de haber oído sobre tu relación con Saira..."
    lis "Puis-je vous demander si vous êtes totalement monogame ? Après avoir entendu parler de votre relation avec Saira…"

# game/scripts/c18/c18.rpy:1516
translate french c18s001_Lisa_5125e112:

    # mc "Por el momento lo soy. Estoy con Debbie y con nadie más. Pero no le hemos puesto ninguna etiqueta todavía."
    mc "Pour l'instant, oui. Je suis avec Debbie et personne d'autre. Mais on n'a encore rien officialisé."

# game/scripts/c18/c18.rpy:1517
translate french c18s001_Lisa_503485a3:

    # mc "Si me enamorara de otra persona, y esa persona quisiera estar conmigo, tendría que hablarlo con Debbie a ver cómo lo resolvemos."
    mc "Si je tombais amoureuse de quelqu'un d'autre, et que cette personne voulait être avec moi, je devrais en parler à Debbie et voir comment nous pourrions nous arranger."

# game/scripts/c18/c18.rpy:1519
translate french c18s001_Lisa_dc57d66c:

    # lis "*Risa* Las famosas charlas de [mc], quien todo lo resuelve hablando."
    lis "*Rires* Les fameuses discussions de [mc], qui résout tout en parlant."

# game/scripts/c18/c18.rpy:1520
translate french c18s001_Lisa_9f980c2f:

    # mc "Creo que hablar las cosas es la mejor forma de no hacer daño a nadie."
    mc "Je crois que la discussion est la meilleure façon d'éviter de blesser qui que ce soit."

# game/scripts/c18/c18.rpy:1521
translate french c18s001_Lisa_bd7be2d1:

    # mc "Pero, sin querer molestarte, lo preguntas como si quisieras que no fuera monógamo... por una cuestión tuya personal."
    mc "Mais, sans vouloir vous contrarier, vous posez la question comme si vous souhaitiez qu'il ne soit pas monogame… pour une raison personnelle."

# game/scripts/c18/c18.rpy:1522
translate french c18s001_Lisa_0fde96b3:

    # mcp "(La conversación con Betty me está haciendo ver fantasmas donde quizás no los haya.)"
    mcp "(Cette conversation avec Betty me fait voir des fantômes là où il n'y en a peut-être pas.)"

# game/scripts/c18/c18.rpy:1524
translate french c18s001_Lisa_c10d232a:

    # lis "¿Qué? ¡No! Sales con mi hermana... No podría salir contigo."
    lis "Quoi ? Non ! Tu sors avec ma sœur… Je ne pourrais pas sortir avec toi."

# game/scripts/c18/c18.rpy:1525
translate french c18s001_Lisa_1a14bbca:

    # mc "Nadie ha dicho nada de salir juntos tú y yo, pero..."
    mc "Personne n'a rien dit sur le fait que nous sortions ensemble, mais..."

# game/scripts/c18/c18.rpy:1526
translate french c18s001_Lisa_3ae0e593:

    # mc "¿Me estás diciendo que si no saliera con Debbie te lo plantearías?"
    mc "Tu es en train de me dire que si je ne sortais pas avec Debbie, tu reconsidérerais ta position ?"

# game/scripts/c18/c18.rpy:1528
translate french c18s001_Lisa_9efbf727:

    # lis "Eso es algo que nunca sabremos, ¿no?"
    lis "C'est quelque chose que nous ne saurons jamais, n'est-ce pas ?"

# game/scripts/c18/c18.rpy:1531
translate french c18s001_Lisa_83575dba:

    # kim "Lisa, tu móvil está sonando. Es Anthony."
    kim "Lisa, ton téléphone sonne. C'est Anthony."

# game/scripts/c18/c18.rpy:1533
translate french c18s001_Lisa_56122fef:

    # lis "Tengo que cogerlo, [mc]. Seguimos hablando luego."
    lis "Je dois aller le chercher, [mc]. On se reparle plus tard."

# game/scripts/c18/c18.rpy:1534
translate french c18s001_Lisa_c7ee6dc6:

    # mc "OK. ¿Podéis decirle a quién le toque ahora que voy a por un zumo a la barra? Vuelvo en un momento."
    mc "OK. Peux-tu dire à la personne à qui c'est maintenant que je vais chercher un jus au bar ? Je reviens tout de suite."

# game/scripts/c18/c18.rpy:1535
translate french c18s001_Lisa_f2589d54:

    # lis "Le toca a [dap], pero no la veo por aquí. Estará en el lavabo. Pero ve, nosotras la avisamos."
    lis "C'est au tour de [dap], mais je ne la vois pas. Elle est probablement aux toilettes. Mais vas-y, on la préviendra."

# game/scripts/c18/c18.rpy:1579
translate french c18s001_Daphne_b010d53c:

    # "Al volver con el zumo descubres que Anthony se ha unido a la fiesta y Lisa se lo está presentando al resto de chicas."
    "À votre retour avec le jus, vous découvrez qu'Anthony s'est joint à la fête et que Lisa le présente aux autres filles."

# game/scripts/c18/c18.rpy:1585
translate french c18s001_Daphne_cd12b144:

    # dap "Me han dicho que has desaparecido en el turno de Lisa. Voy a avisarla."
    dap "On m'a dit que tu avais disparu pendant le service de Lisa. Je vais la prévenir."

# game/scripts/c18/c18.rpy:1586
translate french c18s001_Daphne_7e8e3321:

    # mc "Mejor no. Está presentando a Anthony al resto de chicas. ¿A quién le toca ahora?"
    mc "Il vaut mieux éviter. Elle présente Anthony aux autres filles. À qui le tour maintenant ?"

# game/scripts/c18/c18.rpy:1587
translate french c18s001_Daphne_a258ee24:

    # dap "A mí."
    dap "Moi."

# game/scripts/c18/c18.rpy:1589
translate french c18s001_Daphne_3e3645fd:

    # dap "Es mi turno ahora, si no estás demasiado cansado."
    dap "À mon tour maintenant, si vous n'êtes pas trop fatigué."

# game/scripts/c18/c18.rpy:1590
translate french c18s001_Daphne_4f29a179:

    # mc "Para ti nunca lo estoy."
    mc "Je ne suis jamais là pour toi."

# game/scripts/c18/c18.rpy:1592
translate french c18s001_Daphne_38877ed9:

    # mc "¿Qué tal te lo estás pasando en tu fiesta de cumpleaños?"
    mc "Comment se passe ta fête d'anniversaire ?"

# game/scripts/c18/c18.rpy:1593
translate french c18s001_Daphne_49bb4323:

    # dap "Genial, pero la fiesta es mañana. Falta demasiada gente hoy y no me parece una fiesta de verdad."
    dap "Super, mais la fête est demain. Il manque trop de monde aujourd'hui, et ça ne ressemble pas vraiment à une fête."

# game/scripts/c18/c18.rpy:1594
translate french c18s001_Daphne_6e1a4b42:

    # mc "*Risa* Somos trece. Si cuentas a Anthony, catorce. La última vez que salimos éramos cinco."
    mc "*Rires* Nous sommes treize. Si on compte Anthony, ça fait quatorze. La dernière fois qu'on est sortis, on était cinq."

# game/scripts/c18/c18.rpy:1596
translate french c18s001_Daphne_27d5fb13:

    # dap "¡Las cosas han cambiado mucho en dos semanas! Y después de mañana... creo que nunca más sentiremos que una fiesta está completa a menos que estemos todas las chicas."
    dap "Les choses ont tellement changé en deux semaines ! Et après demain… je crois qu’on n’aura plus jamais l’impression qu’une fête est réussie sans la présence de toutes les filles."

# game/scripts/c18/c18.rpy:1597
translate french c18s001_Daphne_023d41a0:

    # mc "¿Las chicas? ¿Eso me deja fuera? *Risa*"
    mc "Les filles ? Ça m'exclut ? *Rires*"

# game/scripts/c18/c18.rpy:1599
translate french c18s001_Daphne_60dfb32c:

    # dap "Nunca te dejaría fuera. *Risa* Pero tú siempre estás para nosotras. No sé cómo puedes con todo."
    dap "Je ne t'oublierais jamais. *Rires* Mais tu es toujours là pour nous. Je ne sais pas comment tu fais pour tout gérer."

# game/scripts/c18/c18.rpy:1600
translate french c18s001_Daphne_6fb03db4:

    # mc "Dividiendo el tiempo en pequeñas porciones. *Risa*"
    mc "Découper le temps en petites portions. *Rires*"

# game/scripts/c18/c18.rpy:1601
translate french c18s001_Daphne_89353138:

    # mc "Con esa app que habéis hecho Scarlett y tú puede ser más fácil."
    mc "Avec cette application que vous avez créée avec Scarlett, ce sera plus facile."

# game/scripts/c18/c18.rpy:1604
translate french c18s001_Daphne_d2e70ab9:

    # dap "La hicimos para dividirnos tu tiempo entre nosotras de tal forma que nunca discutiéramos. Solo ha habido que adaptarla."
    dap "Nous avons trouvé un système pour répartir notre temps de manière à ne jamais nous disputer. Il a simplement fallu l'adapter."

# game/scripts/c18/c18.rpy:1608
translate french c18s001_Daphne_c06f43b1:

    # dap "La hicimos para que pudieras dividir tu tiempo entre el harén sin que nadie discutiera. Solo ha habido que adaptarla."
    dap "Nous l'avons conçu pour que vous puissiez partager votre temps entre les membres du harem sans que personne ne se dispute. Il fallait juste quelques ajustements."

# game/scripts/c18/c18.rpy:1614
translate french c18s001_Daphne_0a1ebcec:

    # mc "Ha sido una buena idea."
    mc "C'était une bonne idée."

# game/scripts/c18/c18.rpy:1616
translate french c18s001_Daphne_47281d94:

    # mc "Sobre el elefante en la habitación..."
    mc "À propos du sujet tabou..."

# game/scripts/c18/c18.rpy:1618
translate french c18s001_Daphne_798aa071:

    # dap "¿Debbie? No pasa nada. Me alegro mucho por vosotros. Es una chica genial."
    dap "Debbie ? C'est bon. Je suis tellement contente pour vous deux. C'est une fille formidable."

# game/scripts/c18/c18.rpy:1620
translate french c18s001_Daphne_d18826bf:

    # dap "Hemos estado hablando en el lavabo. Ahora las dos sabemos que estás con la otra y a ninguna nos importa."
    dap "On discutait dans la salle de bain. Maintenant, on sait toutes les deux que tu es avec l'autre femme, et on ne compte plus pour rien."

# game/scripts/c18/c18.rpy:1622
translate french c18s001_Daphne_cb97d2cf:

    # dap "Se me hace extraño saber de otra chica aparte de Scarlett, pero me alegra poder hablar de ello con Debbie."
    dap "C'est étrange d'entendre parler d'une autre fille que Scarlett, mais je suis contente de pouvoir en parler avec Debbie."

# game/scripts/c18/c18.rpy:1624
translate french c18s001_Daphne_37a1cab8:

    # dap "Se me hace extraño saber de otra chica del harén, pero me alegra poder hablar de ello con Debbie."
    dap "C'est étrange d'entendre parler d'une autre fille dans le harem, mais je suis contente de pouvoir en parler avec Debbie."

# game/scripts/c18/c18.rpy:1626
translate french c18s001_Daphne_f348fc9d:

    # dap "Hemos estado hablando en el lavabo. Me ha pedido que guarde el secreto, que solo lo sabemos Lisa y yo."
    dap "Nous discutions dans la salle de bain. Elle m'a demandé de garder le secret, que seules Lisa et moi le savions."

# game/scripts/c18/c18.rpy:1628
translate french c18s001_Daphne_8219e201:

    # dap "Se me hace extraño saber que estás con otra chica aparte de Scarlett, pero me alegra que sea Debbie."
    dap "C'est bizarre de savoir que tu es avec une autre fille que Scarlett, mais je suis content que ce soit Debbie."

# game/scripts/c18/c18.rpy:1629
translate french c18s001_Daphne_299f601d:

    # mc "Gracias por entenderlo. Se ha puesto muy nerviosa por un momento."
    mc "Merci de votre compréhension. Elle a été très nerveuse pendant un instant."

# game/scripts/c18/c18.rpy:1631
translate french c18s001_Daphne_98a1e6e5:

    # dap "¿Alguna chica más de la que tenga que saber? *Risa*"
    dap "D'autres filles à connaître ? *Rires*"

# game/scripts/c18/c18.rpy:1632
translate french c18s001_Daphne_5e8a0a54:

    # mc "Todas las chicas tenéis vuestros secretos, y no soy nadie para desvelarlos. *Risa*"
    mc "Toutes les filles ont leurs secrets, et je ne suis personne pour les révéler. *Rires*"

# game/scripts/c18/c18.rpy:1633
translate french c18s001_Daphne_4d648f2d:

    # dap "Tienes razón. *Risa* Seguramente te mataríamos entre todas si empiezas a hacerlo."
    dap "Tu as raison. *Rires* On te tuerait probablement tous si tu commençais à faire ça."

# game/scripts/c18/c18.rpy:1636
translate french c18s001_Daphne_3d4521da:

    # dap "¿Sabes que estoy nerviosa por lo de mañana?"
    dap "Tu sais que je suis nerveuse pour demain ?"

# game/scripts/c18/c18.rpy:1637
translate french c18s001_Daphne_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c18/c18.rpy:1639
translate french c18s001_Daphne_700474e4:

    # dap "A la prueba de embarazo. Si sale positivo, me moriría de ganas por hacerlo público mañana mismo."
    dap "Je fais un test de grossesse. S'il est positif, je serais impatiente de l'annoncer demain."

# game/scripts/c18/c18.rpy:1640
translate french c18s001_Daphne_28244d0a:

    # dap "Y sería injusto para [eri] y [emm]. Voy a tener que guardar el secreto un par de días."
    dap "Et ce serait injuste envers [eri] et [emm]. Je dois garder le secret pendant quelques jours."

# game/scripts/c18/c18.rpy:1641
translate french c18s001_Daphne_80c47845:

    # mc "¿Y si sale negativo? ¿Te fastidiaría el cumpleaños?"
    mc "Et si le test est négatif ? Est-ce que ça gâcherait ton anniversaire ?"

# game/scripts/c18/c18.rpy:1643
translate french c18s001_Daphne_6670c182:

    # dap "No, si sale negativo no pasa nada. Nunca pensé que me quedaría embarazada a los 18. Ni siquiera antes de los 25."
    dap "Non, si le test est négatif, ce n'est pas grave. Je n'aurais jamais cru tomber enceinte à 18 ans. Pas même avant 25 ans."

# game/scripts/c18/c18.rpy:1644
translate french c18s001_Daphne_24d10ac0:

    # dap "Quiero tener a Maeve, pero no tengo demasiada prisa. No todas las chicas sueñan con quedarse embarazadas en su primera vez."
    dap "Je veux avoir Maeve, mais je ne suis pas pressée. Toutes les filles ne rêvent pas de tomber enceintes dès le premier amour."

# game/scripts/c18/c18.rpy:1645
translate french c18s001_Daphne_991bcf0c:

    # mc "Esa debe ser la actitud."
    mc "Voilà l'attitude à adopter."

# game/scripts/c18/c18.rpy:1647
translate french c18s001_Daphne_56861b01:

    # dap "¿Quién crees que va a hacer topless mañana?"
    dap "Qui pensez-vous qui sera seins nus demain ?"

# game/scripts/c18/c18.rpy:1648
translate french c18s001_Daphne_b73bb878:

    # mc "Estoy casi seguro de que tu madre, [emm], y [eri]. Del resto no tengo ni idea. Quizás Sam y Eileen."
    mc "Je suis presque certain qu'il s'agit de ta mère, [emm], et [eri]. Je n'ai aucune idée pour les autres. Peut-être Sam et Eileen."

# game/scripts/c18/c18.rpy:1650
translate french c18s001_Daphne_fd7b762c:

    # dap "¿[eri]? Estás loco."
    dap "[eri]? Tu es fou."

# game/scripts/c18/c18.rpy:1651
translate french c18s001_Daphne_1d300b52:

    # mc "Ella lo ha pedido para tu madre y va a querer apoyarla. Pero creía que ya se lo habrías preguntado a las chicas. Al menos a las que están aquí."
    mc "Elle l'a demandé pour ta mère et voudra la soutenir. Mais je pensais que tu avais déjà demandé aux filles. Du moins à celles qui sont là."

# game/scripts/c18/c18.rpy:1653
translate french c18s001_Daphne_fa6af6d1:

    # dap "Nadie se ha atrevido a sacar el tema. Incluso Scarlett ha cambiado de tema cuando he intentado dirigir la conversación hacia mañana."
    dap "Personne n'a osé aborder le sujet. Même Scarlett a changé de sujet quand j'ai essayé d'orienter la conversation vers demain."

# game/scripts/c18/c18.rpy:1654
translate french c18s001_Daphne_6c3f12bb:

    # dap "Creo que la presencia de Jamaal las cohíbe un poco a todas. No lo conocen tanto como nosotros."
    dap "Je pense que la présence de Jamaal les rend tous un peu timides. Ils ne le connaissent pas aussi bien que nous."

# game/scripts/c18/c18.rpy:1655
translate french c18s001_Daphne_80d95190:

    # mc "¿Jamaal? Creo que los únicos pezones que le podrían interesar de los que hay aquí serían los de Anthony y no sé si Anthony estaría interesado. *Risa*"
    mc "Jamaal ? Je pense que les seuls tétons qui l'intéresseraient ici seraient ceux d'Anthony, et je ne sais pas si Anthony serait intéressé. *Rires*"

# game/scripts/c18/c18.rpy:1657
translate french c18s001_Daphne_33a41986:

    # dap "¿Los tuyos no? *Risa*"
    dap "Pas le vôtre ? *Rires*"

# game/scripts/c18/c18.rpy:1658
translate french c18s001_Daphne_b26929b6:

    # mc "Jamaal sabe que no me van los tíos igual que yo sé que no le van las chicas. Nunca me vería así. Es como mi hermano."
    mc "Jamaal sait que je ne suis pas attirée par les garçons, tout comme je sais qu'il ne l'est pas par les filles. Il ne me verrait jamais de cette façon. C'est comme un frère pour moi."

# game/scripts/c18/c18.rpy:1661
translate french c18s001_Daphne_b4454935:

    # dap "*Risa* Y yo soy tu prima. Y eso no nos ha importado."
    dap "*Rires* Et je suis ta cousine. Et ça ne nous a jamais dérangés."

# game/scripts/c18/c18.rpy:1663
translate french c18s001_Daphne_82a3cad3:

    # dap "*Risa* ¿Estás seguro? Piensa que nadie elige de quién se enamora."
    dap "*Rires* Tu es sûr ? N'oublie pas, personne ne choisit de qui il tombe amoureux."

# game/scripts/c18/c18.rpy:1664
translate french c18s001_Daphne_116fee64:

    # mc "No me refiero a eso, sino a que SOLO me ve como a su hermano, no como un objetivo."
    mc "Je ne fais pas référence à cela, mais plutôt au fait qu'il me voit UNIQUEMENT comme son frère, et non comme une cible."

# game/scripts/c18/c18.rpy:1666
translate french c18s001_Daphne_5c637db6:

    # dap "¿Y tú? ¿Estás interesado en algunos pezones?"
    dap "Et vous ? Ça vous intéresse, les tétons ?"

# game/scripts/c18/c18.rpy:1668
translate french c18s001_Daphne_dff57b21:

    # mc "Principalmente en volver a ver los tuyos. Pero preferentemente en privado."
    mc "Principalement pour revoir vos proches. Mais de préférence en privé."

# game/scripts/c18/c18.rpy:1670
translate french c18s001_Daphne_0d6962ed:

    # mc "Soy un hombre de 21 años. *Risa* En todos. Es broma."
    mc "Je suis un homme de 21 ans. *Rires* Dans toutes ces photos. Je plaisante."

# game/scripts/c18/c18.rpy:1671
translate french c18s001_Daphne_b55546d0:

    # dap "*Tsk* Sí, sí. Pero ¿alguna chica en particular mañana? Siempre has tenido un crush con Samantha."
    dap "*Tsk* Ouais, ouais. Mais une fille en particulier demain ? Tu as toujours eu un faible pour Samantha."

# game/scripts/c18/c18.rpy:1672
translate french c18s001_Daphne_571d1add:

    # mc "Nadie en particular. Creo que no hay que sexualizar algo así. Es algo que [eri] pidió por [nor], para ir acostumbrando a la abuela."
    mc "Personne en particulier. Je ne pense pas qu'il faille sexualiser ce genre de chose. C'est une demande de [eri] à cause de [nor], pour habituer Grand-mère à ça."

# game/scripts/c18/c18.rpy:1674
translate french c18s001_Daphne_57f3a4ca:

    # dap "Me extraña tanto que la abuela no haya protestado. No me la imagino enseñando las tetas delante tuyo, pero tampoco aceptando que otras chicas lo hagan."
    dap "Je suis tellement surprise que grand-mère n'ait pas protesté. Je n'imagine pas qu'elle puisse montrer ses seins devant toi, mais je n'imagine pas non plus qu'elle l'accepte quand d'autres filles le font."

# game/scripts/c18/c18.rpy:1675
translate french c18s001_Daphne_6d5e1919:

    # dap "Por no hablar de Tía Betty. Es más cool de lo que recordaba, pero..."
    dap "Sans parler de tante Betty. Elle est plus cool que dans mes souvenirs, mais…"

# game/scripts/c18/c18.rpy:1676
translate french c18s001_Daphne_f1d7d53c:

    # mc "Tía Betty se apuntaría a cualquier cosa que incomodara a Meemaw. *Risa* Si cree que la va a sacar de sus casillas, es capaz de hacer topless mañana."
    mc "Tante Betty ferait n'importe quoi pour énerver Mémé. *Rires* Si elle pense pouvoir l'agacer, elle est capable de se mettre seins nus demain."

# game/scripts/c18/c18.rpy:1678
translate french c18s001_Daphne_3917d012:

    # dap "En eso tienes razón. Parece que siempre están discutiendo."
    dap "Vous avez raison. Ils ont toujours l'air de se disputer."

# game/scripts/c18/c18.rpy:1679
translate french c18s001_Daphne_215f54e1:

    # mc "Tienen formas diferentes de ver las cosas, aunque Meemaw cada vez ladra menos."
    mc "Ils ont des façons différentes de voir les choses, même si Mémé aboie de moins en moins."

# game/scripts/c18/c18.rpy:1681
translate french c18s001_Daphne_90d788b9:

    # "Un móvil suena en alguna parte."
    "Un téléphone portable sonne quelque part."

# game/scripts/c18/c18.rpy:1683
translate french c18s001_Daphne_4aa6c206:

    # dap "Creo que con esto acaba mi tiempo. Te veo en la segunda ronda. Te toca con Megan. La habíamos programado para su descanso."
    dap "Je crois que c'est tout pour moi. On se retrouve au deuxième tour. Tu affronteras Megan. On avait prévu qu'elle prenne son jour de repos."

# game/scripts/c18/c18.rpy:1685
translate french c18s001_Daphne_48afae88:

    # mc "Te veo luego."
    mc "À plus tard."

# game/scripts/c18/c18.rpy:1688
translate french c18s001_app1_da1193af:

    # dap "La teníamos hecha para distribuirnos el tiempo de laboratorio en el instituto. Solo ha habido que adaptarla."
    dap "Nous l'avions déjà prêt à l'emploi pour la répartition du temps de laboratoire à l'institut. Il ne nous restait plus qu'à l'adapter."

# game/scripts/c18/c18.rpy:1691
translate french c18s001_app2_cc152883:

    # dap "Queríamos enseñártela cuando estuviera acabada, aún le quedan unos retoques, pero para esta noche ya nos servía."
    dap "Nous voulions vous le montrer une fois terminé ; il a encore besoin de quelques retouches, mais c'était suffisant pour ce soir."

# game/scripts/c18/c18.rpy:1714
translate french c18s001_Kim_238a3a31:

    # "Buscas a Megan por la sala y no está en ningún sitio."
    "Vous cherchez Megan dans la pièce, mais elle est introuvable."

# game/scripts/c18/c18.rpy:1716
translate french c18s001_Kim_f2cabb37:

    # kim "Megan se ha tenido que ir, con lo que ahora es mi turno, si aún te quedan ganas de bailar."
    kim "Megan a dû partir, alors maintenant c'est à mon tour, si vous avez encore envie de danser."

# game/scripts/c18/c18.rpy:1718
translate french c18s001_Kim_f05c8ea4:

    # mc "Perfecto. Tenemos que continuar la conversación de anoche."
    mc "Parfait. Il nous faut poursuivre la conversation d'hier soir."

# game/scripts/c18/c18.rpy:1732
translate french c18s001_Kim_35a36254:

    # mc "Creo que voy a ir a sentarme un rato."
    mc "Je crois que je vais aller m'asseoir un moment."

# game/scripts/c18/c18.rpy:1733
translate french c18s001_Kim_0482234a:

    # kim "Es normal. Llevas toda la noche de chica en chica."
    kim "C'est normal. Tu as enchaîné les conquêtes toute la nuit."

# game/scripts/c18/c18.rpy:1739
translate french c18s001_Kim_88e51aa7:

    # kim "Ya te dije que no había nada de lo que hablar."
    kim "Je vous ai déjà dit qu'il n'y avait rien à dire."

# game/scripts/c18/c18.rpy:1740
translate french c18s001_Kim_cf573686:

    # mc "Y dijiste que esto de estar formando una familia podría evitar que tú y yo... y ahí lo dejaste."
    mc "Et tu as dit que toute cette histoire de fonder une famille pourrait nous empêcher, toi et moi, de... et tu n'as rien ajouté."

# game/scripts/c18/c18.rpy:1742
translate french c18s001_Kim_e397ee2f:

    # kim "No debería haberlo dicho."
    kim "Je n'aurais pas dû dire ça."

# game/scripts/c18/c18.rpy:1743
translate french c18s001_Kim_d2970102:

    # mc "Sabes que, aunque estemos formando una familia, los típicos tabús familiares no se nos aplican, ¿verdad? A ti y a mí."
    mc "Tu sais bien que, même si nous fondons une famille, les tabous familiaux habituels ne s'appliquent pas à nous, n'est-ce pas ? À toi et à moi."

# game/scripts/c18/c18.rpy:1745
translate french c18s001_Kim_92cf4f70:

    # mc "Con el beso de la playa dijiste que te sentías atraída por mí."
    mc "Avec ce baiser sur la plage, tu as dit que j'avais un faible pour toi."

# game/scripts/c18/c18.rpy:1747
translate french c18s001_Kim_b7e481bc:

    # mc "Y con mi beso te dije que yo me sentía atraído por ti."
    mc "Et par mon baiser, je t'ai dit que j'étais attirée par toi."

# game/scripts/c18/c18.rpy:1748
translate french c18s001_Kim_62e3685a:

    # mc "¿Dónde ves el problema?"
    mc "Où voyez-vous le problème ?"

# game/scripts/c18/c18.rpy:1750
translate french c18s001_Kim_19acc9d3:

    # kim "El problema lo veo en que estamos formando una familia. No voy a decir que te vea como a un hermano ni nada por el estilo."
    kim "Le problème, à mon avis, c'est que nous fondons une famille. Je ne vais pas dire que je te considère comme un frère ou quoi que ce soit de ce genre."

# game/scripts/c18/c18.rpy:1751
translate french c18s001_Kim_b6abdbc2:

    # kim "Eres... un miembro más de la familia. Pero también lo es [mar], y no sé cómo vería que me liara con su hijo."
    kim "Tu es… un autre membre de la famille. Mais [mar] l’est aussi, et je ne sais pas comment il réagirait si je m’impliquais avec son fils."

# game/scripts/c18/c18.rpy:1752
translate french c18s001_Kim_24cf8761:

    # mc "No creo que la opinión de mi madre tenga que influir en lo que hagamos tú y yo."
    mc "Je ne pense pas que l'opinion de ma mère devrait influencer ce que nous faisons, toi et moi."

# game/scripts/c18/c18.rpy:1754
translate french c18s001_Kim_92949965:

    # kim "No lo entiendes. Pero influye."
    kim "Vous ne le comprenez pas. Mais cela a un impact."

# game/scripts/c18/c18.rpy:1756
translate french c18s001_Kim_d2c28201:

    # kim "Me gustas, pero tengo que pensar si debo actuar sobre esos sentimientos."
    kim "Je t'apprécie, mais je dois réfléchir avant de donner suite à ces sentiments."

# game/scripts/c18/c18.rpy:1758
translate french c18s001_Kim_825a6cec:

    # kim "Aún no sé si me gustas o me caes mal. Depende del día... pero tengo que pensar si debo actuar sobre esos sentimientos, si es que los tengo."
    kim "Je ne sais toujours pas si je t'aime bien ou pas. Ça dépend des jours… mais je dois réfléchir à la question de savoir si je devrais donner suite à ces sentiments, si tant est que j'en aie."

# game/scripts/c18/c18.rpy:1759
translate french c18s001_Kim_24be633e:

    # mc "Lo entiendo. Una cosa es lo que crea yo y otra diferente lo que creas tú."
    mc "Je comprends. Ce que je crois est une chose, et ce que vous croyez en est une autre."

# game/scripts/c18/c18.rpy:1760
translate french c18s001_Kim_f20f6b5e:

    # kim "¿Podemos cambiar de tema?"
    kim "Peut-on changer de sujet ?"

# game/scripts/c18/c18.rpy:1761
translate french c18s001_Kim_890c041b:

    # mc "Por supuesto."
    mc "Bien sûr."

# game/scripts/c18/c18.rpy:1763
translate french c18s001_Kim_e99bebcc:

    # mc "Mañana es el fin de la locura. No me malinterpretes, adoro los cumpleaños de las chicas, especialmente después de haberme perdido los últimos tres..."
    mc "Demain, c'est la fin de cette folie. Comprenez-moi bien, j'adore les anniversaires des filles, surtout après en avoir raté trois…"

# game/scripts/c18/c18.rpy:1764
translate french c18s001_Kim_458fe098:

    # kim "*Risa* Pero es agotador. Los últimos dos días parece que la vida en casa ha girado en torno a [emm], [eri], [dap] y sus cumpleaños."
    kim "*Rires* Mais c'est épuisant. Ces deux derniers jours, on dirait que la vie à la maison a tourné autour de [emm], [eri], [dap] et de leurs anniversaires."

# game/scripts/c18/c18.rpy:1765
translate french c18s001_Kim_99ce5ea2:

    # kim "Incluso la llegada de Eva y Amanda parecía un regalo anticipado para ellas."
    kim "L'arrivée d'Eva et d'Amanda leur semblait déjà un cadeau avant l'heure."

# game/scripts/c18/c18.rpy:1766
translate french c18s001_Kim_cb38f586:

    # mc "Siempre ha sido un fin de semana especial. Pero este año todo parece sobredimensionado."
    mc "Ce week-end a toujours été spécial. Mais cette année, tout semble excessif."

# game/scripts/c18/c18.rpy:1768
translate french c18s001_Kim_6c3ad41b:

    # kim "Yo las entiendo. Este año estás tú. Están Amanda y Eva. Están Olivia y Betty. Estamos nosotras. Y son el centro de atención de todas."
    kim "Je les comprends. Cette année, il y a toi. Il y a Amanda et Eva. Il y a Olivia et Betty. Il y a nous. Et nous sommes au centre de toutes les attentions."

# game/scripts/c18/c18.rpy:1769
translate french c18s001_Kim_075a4b95:

    # kim "Es como sus cumpleaños de siempre pero hasta las cejas de esteroides."
    kim "C'est comme leurs anniversaires habituels, mais dopé aux stéroïdes."

# game/scripts/c18/c18.rpy:1770
translate french c18s001_Kim_cbd9ac9f:

    # mc "*Risa* Creo que no lo habría podido expresar mejor."
    mc "*Rires* Je ne pense pas que j'aurais pu mieux l'exprimer."

# game/scripts/c18/c18.rpy:1772
translate french c18s001_Kim_0cdbb488:

    # kim "Espero haber acertado con los regalos. Es complicado acertar... y no podía gastar mucho hasta que no me paguen por el trabajo de la semana que viene."
    kim "J'espère avoir fait les bons choix de cadeaux. C'est difficile de trouver les bons… et je ne peux pas dépenser beaucoup avant d'être payée la semaine prochaine."

# game/scripts/c18/c18.rpy:1773
translate french c18s001_Kim_bfa186e6:

    # mc "No creo que miren el valor sino la intención."
    mc "Je ne pense pas qu'ils s'intéressent à la valeur, mais à l'intention."

# game/scripts/c18/c18.rpy:1774
translate french c18s001_Kim_f6767f19:

    # kim "Eso espero..."
    kim "Je l'espère..."

# game/scripts/c18/c18.rpy:1776
translate french c18s001_Kim_30fbdc48:

    # kim "¡Oh! Acabo de darme cuenta... ¿También son los cumpleaños de Eva y Amanda?"
    kim "Oh ! Je viens de réaliser… Ce sont aussi les anniversaires d'Eva et d'Amanda ?"

# game/scripts/c18/c18.rpy:1777
translate french c18s001_Kim_143cc74d:

    # mc "No, fueron hace un mes más o menos."
    mc "Non, c'était il y a environ un mois."

# game/scripts/c18/c18.rpy:1779
translate french c18s001_Kim_ec50ffca:

    # kim "Menos mal... no les había comprado nada."
    kim "Dieu merci… je n’avais rien acheté chez eux."

# game/scripts/c18/c18.rpy:1780
translate french c18s001_Kim_ab87e77f:

    # mc "Aunque fueran sus cumpleaños, lo entenderían. Las conociste ayer. Pero no te preocupes. Solo son tres cumpleaños. Solo."
    mc "Même si c'était leur anniversaire, ils comprendraient. Tu les as rencontrés hier. Mais ne t'inquiète pas. Ce ne sont que trois anniversaires. Seulement trois."

# game/scripts/c18/c18.rpy:1782
translate french c18s001_Kim_502b2abc:

    # kim "Ayer... parece que ha pasado una vida entera, pero ayer hizo una semana que llegamos."
    kim "Hier… cela semble remonter à une éternité, mais hier marquait une semaine depuis notre arrivée."

# game/scripts/c18/c18.rpy:1783
translate french c18s001_Kim_f43ae440:

    # kim "Mudarme a Newport es la mejor decisión que he tomado en mucho tiempo."
    kim "Déménager à Newport est la meilleure décision que j'aie prise depuis longtemps."

# game/scripts/c18/c18.rpy:1784
translate french c18s001_Kim_18670915:

    # kim "Vine por el calor y he encontrado el calor de una familia."
    kim "Je suis venu chercher de la chaleur humaine et j'ai trouvé la chaleur d'une famille."

# game/scripts/c18/c18.rpy:1785
translate french c18s001_Kim_9f4e825f:

    # mc "Eso te ha quedado... casi poético. Me alegra que te sientas así."
    mc "C'est sorti comme ça... presque poétique. Je suis content que tu le penses."

# game/scripts/c18/c18.rpy:1786
translate french c18s001_Kim_5eeaf5f0:

    # mc "Tu familia de Cleveland... ¿has hablado con ellos?"
    mc "Votre famille à Cleveland... leur avez-vous parlé ?"

# game/scripts/c18/c18.rpy:1788
translate french c18s001_Kim_8092e0f5:

    # kim "Hablo todos los días y se lo he explicado todo... bueno, menos La Clonversación... y alguna cosa más."
    kim "Je lui parle tous les jours et je lui ai tout expliqué... enfin, sauf la conversation sur Clon... et quelques autres choses."

# game/scripts/c18/c18.rpy:1789
translate french c18s001_Kim_b5ad180f:

    # kim "Alucinan cuando les hablo de la familia. Dicen que nunca me habían visto adaptándome tan rápido a un sitio."
    kim "Ils sont stupéfaits quand je leur parle de ma famille. Ils disent ne m'avoir jamais vu m'adapter aussi vite à un endroit."

# game/scripts/c18/c18.rpy:1790
translate french c18s001_Kim_27b9cbcf:

    # mc "¿Te costaba adaptarte? No lo entiendo, eres muy sociable."
    mc "Avez-vous eu du mal à vous adapter ? Je ne comprends pas, vous êtes très sociable."

# game/scripts/c18/c18.rpy:1792
translate french c18s001_Kim_90e3b17d:

    # kim "Soy muy sociable porque lo ponéis muy fácil. Nadie juzga a nadie... bueno, quizás Olivia un poco."
    kim "Je suis très sociable parce que tu me facilites la tâche. Personne ne juge personne… enfin, peut-être un peu Olivia."

# game/scripts/c18/c18.rpy:1793
translate french c18s001_Kim_e9496f0f:

    # kim "Nadie hace comentarios para hacer daño a nadie. Todo el mundo ayuda a todo el mundo en lo que puede."
    kim "Personne ne fait de commentaires pour blesser qui que ce soit. Chacun s'entraide du mieux qu'il peut."

# game/scripts/c18/c18.rpy:1794
translate french c18s001_Kim_087f7674:

    # kim "Y después estás tú. Parece que estás en todos sitios cuando alguna de nosotras te necesitamos."
    kim "Et puis il y a toi. On dirait que tu es partout quand on a besoin de toi."

# game/scripts/c18/c18.rpy:1795
translate french c18s001_Kim_a13ee82f:

    # mc "Era una de mis funciones cuando erais solo clientas... eso ha sonado muy mal. *Risa*"
    mc "C'était l'une de mes tâches lorsque vous étiez de simples clients... dit comme ça, ça sonne vraiment mal. *Rires*"

# game/scripts/c18/c18.rpy:1796
translate french c18s001_Kim_143dc688:

    # mc "Ahora, además, lo hago por pasar tiempo con vosotras."
    mc "Maintenant, je le fais aussi pour passer du temps avec vous tous."

# game/scripts/c18/c18.rpy:1798
translate french c18s001_Kim_fd10106e:

    # kim "Y nosotras te lo agradecemos. Mucho."
    kim "Et nous vous en remercions. Beaucoup."

# game/scripts/c18/c18.rpy:1799
translate french c18s001_Kim_271c2c3d:

    # kim "Es difícil tener una conversación con cualquiera de las chicas en la que no se hable de ti tarde o temprano."
    kim "Il est difficile d'avoir une conversation avec l'une de ces filles sans que votre nom ne soit évoqué tôt ou tard."

# game/scripts/c18/c18.rpy:1800
translate french c18s001_Kim_10832dd0:

    # kim "No es que seas el centro de cada conversación, aún estamos en ese momento en que nos quedan planes y sueños que compartir, pero sueles aparecer en muchas de ellas."
    kim "Ce n'est pas que tu sois au centre de toutes les conversations ; nous en sommes encore au stade où nous avons des projets et des rêves à partager, mais tu as tendance à apparaître dans beaucoup d'entre eux."

# game/scripts/c18/c18.rpy:1801
translate french c18s001_Kim_c436991a:

    # mc "*Risa* No sé si sentirme halagado o estudiado."
    mc "*Rires* Je ne sais pas si je dois me sentir flattée ou observée."

# game/scripts/c18/c18.rpy:1803
translate french c18s001_Kim_6e76ae0b:

    # kim "*Risa* Halagado, por supuesto. Eres el único chico en una familia de mujeres."
    kim "*Rires* Flatté, bien sûr. Tu es le seul garçon dans une famille de femmes."

# game/scripts/c18/c18.rpy:1804
translate french c18s001_Kim_e0a38ae3:

    # kim "Tengo ganas de conocer al tal Jamaal mañana, aunque puede cohibir a alguna de las chicas para ir en topless... o desnudas en el jacuzzi. Más incluso de lo que las cohíbes tú."
    kim "J'ai hâte de rencontrer Jamaal demain, même s'il risque de gêner certaines filles à l'idée d'être seins nus… ou nues dans le jacuzzi. Encore plus que toi."

# game/scripts/c18/c18.rpy:1805
translate french c18s001_Kim_01fba5e8:

    # mc "Jamaal es muy buen tío, pero no va a estar interesado en vosotras. Se pasará el día comiendo y metiéndose conmigo. Además, no puede subir las escaleras del jacuzzi. *Risa*"
    mc "Jamaal est vraiment un type sympa, mais vous les filles, il ne s'intéressera pas à lui. Il passera sa journée à manger et à me taquiner. En plus, il est incapable de monter les escaliers depuis le jacuzzi. *Rires*"

# game/scripts/c18/c18.rpy:1806
translate french c18s001_Kim_0e10ac56:

    # mc "¿Y yo os cohíbo? No lo había pensado."
    mc "Et c'est moi qui te retiens ? Je n'y avais pas pensé."

# game/scripts/c18/c18.rpy:1808
translate french c18s001_Kim_71cb6066:

    # kim "Algunas de nosotras somos conscientes de nuestro aspecto. No te voy a decir quiénes."
    kim "Certains d'entre nous sont complexés par leur apparence. Je ne vous dirai pas qui."

# game/scripts/c18/c18.rpy:1809
translate french c18s001_Kim_a919805d:

    # kim "Desnudarse, aunque sea parcialmente delante de un chico, siempre es un paso importante. Especialmente si ese chico te gusta."
    kim "Se déshabiller, même partiellement, devant un garçon est toujours un grand pas. Surtout si ce garçon vous plaît."

# game/scripts/c18/c18.rpy:1810
translate french c18s001_Kim_07a2818b:

    # mc "Bueno, si ese chico le gusta a alguien, todo el mundo sabe que a ese chico le gusta hablar las cosas. Especialmente si eso supone un problema."
    mc "Eh bien, si quelqu'un apprécie ce type, tout le monde sait qu'il aime bien discuter. Surtout si cela crée des problèmes."

# game/scripts/c18/c18.rpy:1812
translate french c18s001_Kim_e15856aa:

    # kim "Quizás demasiado. A veces muy poco."
    kim "Peut-être trop. Parfois pas assez."

# game/scripts/c18/c18.rpy:1813
translate french c18s001_Kim_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "De quoi parles-tu?"

# game/scripts/c18/c18.rpy:1815
translate french c18s001_Kim_fe9f7327:

    # "Un móvil suena en algún sitio."
    "Un téléphone portable sonne quelque part."

# game/scripts/c18/c18.rpy:1823
translate french c18s001_Kim_91f374f0:

    # kim "Te he dicho que me gustas y me has dejado cambiar de tema."
    kim "Je t'ai dit que je t'aimais bien et tu m'as laissé changer de sujet."

# game/scripts/c18/c18.rpy:1824
translate french c18s001_Kim_69706e4b:

    # mc "Me lo has pedido tú."
    mc "Vous me l'avez demandé."

# game/scripts/c18/c18.rpy:1826
translate french c18s001_Kim_1f0fd4d5:

    # kim "Lo sé. Pero casi esperaba que siguieras hablando... que me intentaras convencer para que tomara una decisión..."
    kim "Je sais. Mais je m'attendais presque à ce que tu continues à parler… à essayer de me convaincre de prendre une décision…"

# game/scripts/c18/c18.rpy:1827
translate french c18s001_Kim_ce2d76a2:

    # kim "Ahora ha pasado el momento, pero en ese momento lo esperaba."
    kim "Le temps a passé, mais à ce moment-là, je l'attendais."

# game/scripts/c18/c18.rpy:1828
translate french c18s001_Kim_992a26ad:

    # mc "No voy a forzarte a tomar una decisión, Kim. Es algo que tienes que pensar tú y llegar a tus propias conclusiones."
    mc "Je ne vais pas te forcer à prendre une décision, Kim. C'est quelque chose que tu dois réfléchir et dont tu dois tirer tes propres conclusions."

# game/scripts/c18/c18.rpy:1830
translate french c18s001_Kim_5bf97fc7:

    # kim "Ni siquiera me has dicho que yo también te gusto..."
    kim "Tu ne m'as même pas dit que tu m'aimais bien aussi..."

# game/scripts/c18/c18.rpy:1832
translate french c18s001_Kim_6978ba63:

    # mc "Creo que ya te lo demostré en la playa."
    mc "Je crois te l'avoir déjà prouvé sur la plage."

# game/scripts/c18/c18.rpy:1834
translate french c18s001_Kim_6d41a4ae:

    # mc "Eres preciosa, Kim."
    mc "Tu es magnifique, Kim."

# game/scripts/c18/c18.rpy:1835
translate french c18s001_Kim_029a6582:

    # mc "Pero yo tampoco he decidido si siento algo por ti más allá de... eso. Tan solo pensaba que debíamos hablarlo."
    mc "Mais je n'ai pas encore décidé si j'éprouve quoi que ce soit d'autre pour toi... Je pensais simplement qu'on devrait en parler."

# game/scripts/c18/c18.rpy:1838
translate french c18s001_Kim_1df2fe9f:

    # kim "A nada... "
    kim "Rien..."

# game/scripts/c18/c18.rpy:1839
translate french c18s001_Kim_dd5b7480:

    # mc "A algo te tienes que estar refiriendo..."
    mc "Vous faites sans doute référence à quelque chose..."

# game/scripts/c18/c18.rpy:1841
translate french c18s001_Kim_3623b69b:

    # kat "Creo que es mi turno, Kim."
    kat "Je crois que c'est mon tour, Kim."

# game/scripts/c18/c18.rpy:1843
translate french c18s001_Kim_ac397e61:

    # kim "Todo para ti, Kate."
    kim "Tout pour toi, Kate."

# game/scripts/c18/c18.rpy:1844
translate french c18s001_Kim_a06f15b8:

    # kim "Te veo en mi siguiente turno, [mc]."
    kim "À bientôt lors de mon prochain quart de travail, [mc]."

# game/scripts/c18/c18.rpy:1845
translate french c18s001_Kim_43b28d10:

    # mc "Hasta ahora, Kim."
    mc "Jusqu'ici, Kim."

# game/scripts/c18/c18.rpy:1859
translate french c18s001_Common_2e047454:

    # "La noche continua con diversos bailes y conversaciones."
    "La soirée se poursuit avec diverses danses et conversations."

# game/scripts/c18/c18.rpy:1861
translate french c18s001_Common_1d07b342:

    # "Pierdes la cuenta de cuántas veces has bailado con cada una de ellas y de los bailes en grupo que habéis hecho."
    "On ne compte plus le nombre de fois où l'on a dansé avec chacun d'eux et le nombre de danses de groupe que l'on a faites."

# game/scripts/c18/c18.rpy:1862
translate french c18s001_Common_e822f724:

    # "Pero el cansancio va haciendo mella en algunas de las chicas y decidís retiraros antes de que el Jazz Corner cierre."
    "Mais la fatigue commence à se faire sentir chez certaines filles et vous décidez de partir avant la fermeture du Jazz Corner."

# game/scripts/c18/c18.rpy:1864
translate french c18s001_Common_2bc5173d:

    # "Os despedís de Megan y de Anthony y volvéis a casa."
    "Vous dites au revoir à Megan et Anthony et vous rentrez chez vous."

# game/scripts/c18/c18.rpy:1866
translate french c18s001_Common_83134abb:

    # "Llegáis a casa para dejar a las chicas y el coche que conduce Amanda."
    "Vous rentrez chez vous pour déposer les filles et la voiture qu'Amanda conduit."

# game/scripts/c18/c18.rpy:1868
translate french c18s001_Common_90f4e1ee:

    # "Continuáis con una larga despedida."
    "Vous poursuivez par de longs adieux."

# game/scripts/c18/c18.rpy:1869
translate french c18s001_Common_08486c9b:

    # "Todas las chicas se abrazan mientras otras esperan su turno para darte el beso de buenas noches."
    "Toutes les filles s'enlacent tandis que les autres attendent leur tour pour te donner un baiser de bonne nuit."

# game/scripts/c18/c18.rpy:1871
translate french c18s001_Common_1d13c602:

    # "Amanda y Eva se suben a tu pick up y las llevas a la base."
    "Amanda et Eva montent dans votre pick-up et vous les emmenez à la base."

# game/scripts/c18/c18.rpy:1872
translate french c18s001_Common_006c8ddc:

    # "Casi estabas seguro de que se iban a pelear por quién se sienta delante."
    "Vous étiez presque certain qu'ils allaient se disputer pour savoir qui s'assiérait devant."

# game/scripts/c18/c18.rpy:1873
translate french c18s001_Common_2cac4a93:

    # "Para tu sorpresa, no lo hacen y Amanda se sienta en el asiento delantero."
    "À votre grande surprise, ils ne le font pas, et Amanda s'assoit sur le siège avant."

# game/scripts/c18/c18.rpy:1876
translate french c18s001_Common_41d397cb:

    # "Unos minutos después..."
    "Quelques minutes plus tard..."

# game/scripts/c18/c18.rpy:1878
translate french c18s001_Common_754189e3:

    # mc "Bueno, aquí ha acabado la noche. Nos vemos mañana."
    mc "Voilà, c'est tout pour ce soir. À demain !"

# game/scripts/c18/c18.rpy:1879
translate french c18s001_Common_ff43bd63:

    # ama "¿No tenemos beso de buenas noches?"
    ama "N'avons-nous pas un bisou pour nous dire bonne nuit ?"

# game/scripts/c18/c18.rpy:1880
translate french c18s001_Common_7a8e19b1:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1881
translate french c18s001_Common_e20c92f6:

    # eva "Todas lo han tenido..." (multiple=2)
    eva "Ils l'ont tous eu..." (multiple=2)

# game/scripts/c18/c18.rpy:1882
translate french c18s001_Common_76737ff5:

    # mc "Escuchad. No quiero ser la causa de un problema entre vosotras. O entre vosotras y el resto de las chicas."
    mc "Écoute. Je ne veux pas créer de problèmes entre vous. Ni entre toi et les autres filles."

# game/scripts/c18/c18.rpy:1883
translate french c18s001_Common_53931e64:

    # mc "Sé que esto es nuevo para vosotras y también lo es para mí."
    mc "Je sais que c'est nouveau pour vous, et c'est nouveau pour moi aussi."

# game/scripts/c18/c18.rpy:1884
translate french c18s001_Common_f2567306:

    # mc "Creo que tenéis que hablar y marcar unos límites que las dos vayáis a respetar."
    mc "Je pense que vous devriez discuter et fixer des limites que vous respecterez tous les deux."

# game/scripts/c18/c18.rpy:1886
translate french c18s001_Common_9cc93f29:

    # eva "¿A qué clase de límites te refieres?"
    eva "À quel genre de limites faites-vous référence ?"

# game/scripts/c18/c18.rpy:1887
translate french c18s001_Common_dccc4e63:

    # mc "No te puedes enfadar porque Amanda me dé un beso una décima de segundo más largo que el tuyo."
    mc "Tu ne peux pas te fâcher parce qu'Amanda me donne un baiser qui dure un dixième de seconde de plus que le tien."

# game/scripts/c18/c18.rpy:1889
translate french c18s001_Common_725c10c0:

    # mc "Y tú no puedes echarle en cara a tu {b}hermana{/b} que se haya puesto un vestido precioso."
    mc "Et vous ne pouvez pas reprocher à votre sœur de porter une belle robe."

# game/scripts/c18/c18.rpy:1890
translate french c18s001_Common_a7810a76:

    # ama "Lo sé..."
    ama "Je sais..."

# game/scripts/c18/c18.rpy:1891
translate french c18s001_Common_ff2c8c19:

    # mc "Sé que os gusto... al menos físicamente. Pero {b}nunca{/b} os peleéis por un chico. Ni por nadie."
    mc "Je sais que tu m'aimes bien… du moins physiquement. Mais on ne se dispute jamais pour un garçon. Ni pour qui que ce soit."

# game/scripts/c18/c18.rpy:1892
translate french c18s001_Common_2b344f0a:

    # mc "No vale la pena perder lo que tenéis por nada ni por nadie. Mucho menos por mí."
    mc "Ça ne vaut pas la peine de perdre ce que l'on possède pour quoi que ce soit ou pour qui que ce soit. Encore moins pour moi."

# game/scripts/c18/c18.rpy:1894
translate french c18s001_Common_794897d7:

    # ama "Hemos hablado en el Jazz Corner..."
    ama "Nous avons discuté au Jazz Corner..."

# game/scripts/c18/c18.rpy:1895
translate french c18s001_Common_7a8e19b1_1:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1896
translate french c18s001_Common_c39e3eee:

    # eva "Aún tenemos que pulir unos temas..." (multiple=2)
    eva "Il nous reste encore quelques détails à régler..." (multiple=2)

# game/scripts/c18/c18.rpy:1897
translate french c18s001_Common_9aae8e13:

    # ama "Pero tienes razón..."
    ama "Mais vous avez raison..."

# game/scripts/c18/c18.rpy:1898
translate french c18s001_Common_7a8e19b1_2:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1899
translate french c18s001_Common_5071a624:

    # eva "No vamos a volver a discutir por ti..." (multiple=2)
    eva "Nous n'allons plus nous disputer à ton sujet..." (multiple=2)

# game/scripts/c18/c18.rpy:1900
