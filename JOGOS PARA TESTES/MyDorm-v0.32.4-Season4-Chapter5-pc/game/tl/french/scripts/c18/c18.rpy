# game/scripts/c18/c18.rpy:2530
translate french c18s003_Daphne_6f53ba35:

    # mc "Scarlett, te nombro cambiadora de pañales oficial de Maeve. *Risa*"
    mc "Scarlett, je te nomme officiellement changeuse de couches de Maeve. *Rires*"

# game/scripts/c18/c18.rpy:2532
translate french c18s003_Daphne_c0aa63d4:

    # sca "¡Puagh! Yo haré la app, pero para instalarla en el móvil de Olivia y que los cambie ella. *Risa*"
    sca "Pff ! Je vais créer l'appli, mais je l'installerai sur le téléphone d'Olivia pour qu'elle puisse les changer elle-même. *Rires*"

# game/scripts/c18/c18.rpy:2533
translate french c18s003_Daphne_cad21f54:

    # sca "Me quedo con el título de Gestora de Cambios de Pañal. *Risa*"
    sca "Je préfère garder le titre de Responsable du change des couches. *Rires*"

# game/scripts/c18/c18.rpy:2534
translate french c18s003_Daphne_791949b7:

    # mc "Nos sirve, ¿verdad, [dap]?"
    mc "Ça nous convient, n'est-ce pas, [dap] ?"

# game/scripts/c18/c18.rpy:2536
translate french c18s003_Daphne_809dd707:

    # dap "¡Por supuesto! Ven aquí, Scarlett. Únete al abrazo. Sin tu idea de las lecciones esto no hubiera pasado."
    dap "Bien sûr ! Viens ici, Scarlett. Rejoins-moi dans les bras de quelqu'un. Sans ton idée pour les cours, rien de tout cela n'aurait été possible."

# game/scripts/c18/c18.rpy:2537
translate french c18s003_Daphne_5b454c6a:

    # mc "Sí, Tía Scarlett, ven aquí."
    mc "Oui, tante Scarlett, venez ici."

# game/scripts/c18/c18.rpy:2539
translate french c18s003_Daphne_d9344989:

    # "Scarlett se une al abrazo. Contenta por su nueva sobrina."
    "Scarlett se joint à l'étreinte. Ravie pour sa nouvelle nièce."

# game/scripts/c18/c18.rpy:2540
translate french c18s003_Daphne_2fbca90c:

    # sca "Ahora hay que planificar el viaje a Aruba."
    sca "Il nous faut maintenant organiser le voyage à Aruba."

# game/scripts/c18/c18.rpy:2541
translate french c18s003_Daphne_deea06af:

    # mc "¿Aruba? ¿Por qué?"
    mc "Aruba ? Pourquoi ?"

# game/scripts/c18/c18.rpy:2544
translate french c18s003_Daphne_34bf169a:

    # dap "Somos primos y en Aruba hay una empresa de ingeniería genética que clona bebés. Creo que es el mejor sitio para comprobar que no hay ningún problema."
    dap "Nous sommes cousins, et il y a une entreprise de génie génétique à Aruba qui clone des bébés. Je pense que c'est le meilleur endroit pour vérifier qu'il n'y a pas de problème."

# game/scripts/c18/c18.rpy:2545
translate french c18s003_Daphne_a7ed2bb8:

    # dap "Aunque la endogamia entre primos tiene un riesgo negligible, prefiero estar segura."
    dap "Bien que la consanguinité entre cousins comporte un risque négligeable, je préfère être prudent."

# game/scripts/c18/c18.rpy:2547
translate french c18s003_Daphne_51ead11d_1:

    # dap "Soy un clon de Eva. No sé cómo eso puede afectar a nuestro bebé."
    dap "Je suis un clone d'Ève. Je ne sais pas comment cela pourrait affecter notre bébé."

# game/scripts/c18/c18.rpy:2548
translate french c18s003_Daphne_1cf30409:

    # dap "En Aruba hay una empresa de ingeniería genética que clona bebés. Creo que es el mejor sitio para comprobar que no hay ningún problema."
    dap "Il y a une entreprise de génie génétique à Aruba qui clone des bébés. Je pense que c'est le meilleur endroit pour vérifier qu'il n'y a pas de problème."

# game/scripts/c18/c18.rpy:2550
translate french c18s003_Daphne_92487e72:

    # dap "Además, no creerás que te vas a librar de mis antojos, ¿verdad? *Risa*"
    dap "Et puis, tu ne crois pas pouvoir échapper à mes envies, n'est-ce pas ? *Rires*"

# game/scripts/c18/c18.rpy:2551
translate french c18s003_Daphne_f24b12c9:

    # mc "No tengo intención de hacerlo. *Risa*"
    mc "Je n'ai aucune intention de le faire. *Rires*"

# game/scripts/c18/c18.rpy:2553
translate french c18s003_Daphne_9c02d355:

    # sca "Si no os molesta, yo os acompañaré. Mientras la ballena se hace las pruebas, yo podre lucir tipito en una playa caribeña. *Risa*"
    sca "Si ça ne vous dérange pas, je viendrai avec vous. Pendant que la baleine passe ses examens, je pourrai exhiber ma silhouette sur une plage des Caraïbes. *Rires*"

# game/scripts/c18/c18.rpy:2554
translate french c18s003_Daphne_07f0ea1c:

    # mc "Eres bienvenida, pero no te recomiendo llamar ballena a una mujer embarazada. *Risa*"
    mc "De rien, mais je ne vous conseillerais pas de traiter une femme enceinte de baleine. *Rires*"

# game/scripts/c18/c18.rpy:2556
translate french c18s003_Daphne_e07eddda_1:

    # "Os volvéis a abrazar los tres. El día ha empezado bien para [dap]."
    "Vous vous enlacez à nouveau tous les trois. La journée a bien commencé pour [dap]."

# game/scripts/c18/c18.rpy:2559
translate french c18s003_Daphne_18850f16_1:

    # dap "Negativo."
    dap "Négatif."

# game/scripts/c18/c18.rpy:2560
translate french c18s003_Daphne_7cf3844e:

    # mc "¿Decepcionada?"
    mc "Déçu?"

# game/scripts/c18/c18.rpy:2562
translate french c18s003_Daphne_46e31e90:

    # dap "Para nada. Ya te dije ayer que nunca había pensado en quedarme embarazada a los 18."
    dap "Pas du tout. Je vous ai déjà dit hier que je n'avais jamais envisagé de tomber enceinte à 18 ans."

# game/scripts/c18/c18.rpy:2563
translate french c18s003_Daphne_7ab3155e:

    # dap "Mañana es otra cosa, ya tendré 19. *Risa* Y si llega a los 20 o a los 23 da lo mismo. Lo divertido son los intentos."
    dap "Demain, ce sera une autre histoire, j'aurai 19 ans à ce moment-là. *Rires* Et que j'aie 20 ou 23 ans, peu importe. Le plus important, c'est d'essayer."

# game/scripts/c18/c18.rpy:2564
translate french c18s003_Daphne_5a2bb053:

    # mc "Esa es la actitud."
    mc "Voilà l'état d'esprit."

# game/scripts/c18/c18.rpy:2566
translate french c18s003_Daphne_116c78a0:

    # sca "Al menos no serás una ballena cuando vayamos a Aruba."
    sca "Au moins, tu ne seras pas une baleine quand nous irons à Aruba."

# game/scripts/c18/c18.rpy:2567
translate french c18s003_Daphne_a3b677a8:

    # mc "¿Aruba?"
    mc "Aruba ?"

# game/scripts/c18/c18.rpy:2569
translate french c18s003_Daphne_f03fc7c0:

    # dap "Ya te dijimos que queríamos trabajar allí. Es muy pronto aún, tenemos que acabar las carreras... empezarlas para ser más exactos."
    dap "On vous a déjà dit qu'on voulait y travailler. C'est encore trop tôt ; il faut qu'on termine nos études… ou plutôt, qu'on les commence."

# game/scripts/c18/c18.rpy:2570
translate french c18s003_Daphne_f7efe4f0:

    # dap "Pero queremos acompañarte cuando vayas, para ver las instalaciones, empezar a aprender cómo funciona todo y aprovechar el verano."
    dap "Mais nous voulons vous accompagner sur place, pour vous faire découvrir les installations, vous familiariser avec leur fonctionnement et vous permettre de profiter pleinement de l'été."

# game/scripts/c18/c18.rpy:2572
translate french c18s003_Daphne_3f0d013b:

    # sca "No tenemos mucho que hacer hasta que no empiece el curso, con lo que nos ha parecido una buena idea."
    sca "Nous n'avons pas grand-chose à faire avant le début du cours, alors nous avons pensé que c'était une bonne idée."

# game/scripts/c18/c18.rpy:2573
translate french c18s003_Daphne_272eb721:

    # sca "Al menos pasar unos días allí hasta que te asientes. No te sentirás tan solo."
    sca "Passez-y au moins quelques jours pour vous installer. Vous vous sentirez moins seul."

# game/scripts/c18/c18.rpy:2574
translate french c18s003_Daphne_caa7b151:

    # mc "Me parece genial. Habría que hablarlo con Amanda y Eva, pero no creo que haya ningún problema. Pero ahora quiero un abrazo."
    mc "Ça a l'air super. Il faudrait en parler à Amanda et Eva, mais je ne pense pas qu'il y aura de problème. Mais là, j'ai juste envie d'un câlin."

# game/scripts/c18/c18.rpy:2576
translate french c18s003_Daphne_46c2079e:

    # "Los tres os fundís en un abrazo que inicia [dap] y al que se une Scarlett."
    "Vous vous enlacez tous les trois dans une étreinte qui commence [dap] et à laquelle Scarlett se joint."

# game/scripts/c18/c18.rpy:2580
translate french c18s003_Scarlett_96aa7fa7:

    # sca "¿Ha sido el mío? Me da miedo mirar..."
    sca "Était-ce le mien ? J'ai peur de regarder..."

# game/scripts/c18/c18.rpy:2581
translate french c18s003_Scarlett_87d401ed:

    # mc "Sabes que no hay una sola oportunidad, ¿verdad? Si no sale positivo a la primera..."
    mc "Tu sais qu'il n'y a qu'une seule chance, n'est-ce pas ? Si ça ne marche pas du premier coup..."

# game/scripts/c18/c18.rpy:2585
translate french c18s003_Scarlett_98a5fb30:

    # sca "¡Positivo!"
    sca "Positif!"

# game/scripts/c18/c18.rpy:2586
translate french c18s003_Scarlett_a60fd8f1:

    # mc "¡Ven aquí, Mamá!"
    mc "Viens ici, maman !"

# game/scripts/c18/c18.rpy:2590
translate french c18s003_Scarlett_d2ac3aee:

    # mc "¿Pasa algo, mi amor? ¿No estás contenta?"
    mc "Quelque chose ne va pas, mon amour ? N'es-tu pas heureuse ?"

# game/scripts/c18/c18.rpy:2591
translate french c18s003_Scarlett_38e664b6:

    # sca "No es eso..."
    sca "Ce n'est pas ça..."

# game/scripts/c18/c18.rpy:2594
translate french c18s003_Scarlett_bed9a5e7:

    # sca "No me malinterpretes... estoy contenta de llevar a nuestro hijo dentro..."
    sca "Ne vous méprenez pas… Je suis heureuse de porter notre enfant…"

# game/scripts/c18/c18.rpy:2595
translate french c18s003_Scarlett_4c103678:

    # mc "Nadie lo podría adivinar, Scarlett. Parece que la noticia no te ha gustado."
    mc "Personne n'aurait pu le deviner, Scarlett. Il semblerait que la nouvelle ne vous ait pas plu."

# game/scripts/c18/c18.rpy:2598
translate french c18s003_Scarlett_5ab2cc5d:

    # sca "Es posible que seamos hermanos y que este hijo sea endogámico. Me preocupa..."
    sca "Il est possible que nous soyons frère et sœur et que cet enfant soit issu d'une consanguinité. Je suis inquiet(ète)..."

# game/scripts/c18/c18.rpy:2602
translate french c18s003_Scarlett_63768574:

    # sca "Sé que [mar] va a estar ahí para nuestro bebé, y que [nor] va a actuar también de abuela. Y que va a tener muchas tías."
    sca "Je sais que [mar] sera là pour notre bébé, et que [nor] jouera aussi le rôle d'une grand-mère. Et qu'elle aura beaucoup de tantes."

# game/scripts/c18/c18.rpy:2603
translate french c18s003_Scarlett_a0938342:

    # mc "Y no te olvides de Meemaw y Tía Betty. Van a ser unas bisabuelas fantásticas."
    mc "Et n'oubliez pas Mémé et Tante Betty. Elles seront des arrière-grands-mères formidables."

# game/scripts/c18/c18.rpy:2604
translate french c18s003_Scarlett_00cc1e5f:

    # mc "Al menos cuando no estén en Florida."
    mc "Du moins, quand ils ne sont pas en Floride."

# game/scripts/c18/c18.rpy:2606
translate french c18s003_Scarlett_ffad69a8:

    # sca "Pero... me gustaría que... en algún momento se lo pudiéramos decir a mi madre."
    sca "Mais... j'aimerais... qu'à un moment donné on puisse le dire à ma mère."

# game/scripts/c18/c18.rpy:2607
translate french c18s003_Scarlett_6418d1c9:

    # mc "¿Qué? ¿Tal como te ha tratado?"
    mc "Quoi ? La façon dont il t'a traitée ?"

# game/scripts/c18/c18.rpy:2609
translate french c18s003_Scarlett_82a96e43:

    # dap "[mc], es su madre. ¿No se lo vas a contar a Tío Edmund, por muy mal que se haya portado?"
    dap "[mc], c'est sa mère. Tu ne vas pas le dire à l'oncle Edmund, même s'il s'est très mal comporté ?"

# game/scripts/c18/c18.rpy:2612
translate french c18s003_Scarlett_3a161190:

    # mc "Si por mí fuera, esperaría como mínimo a tener los resultados del test de ADN."
    mc "Si cela ne tenait qu'à moi, j'attendrais au moins d'avoir les résultats du test ADN."

# game/scripts/c18/c18.rpy:2614
translate french c18s003_Scarlett_865718ea:

    # mc "Si por mí fuera, esperaría un tiempo antes de decírselo, a que se calmen las aguas."
    mc "Si cela ne tenait qu'à moi, j'attendrais un peu avant de lui dire, le temps que les choses se calment."

# game/scripts/c18/c18.rpy:2617
translate french c18s003_Scarlett_736e64cc:

    # sca "Me parece una buena idea. Si somos medio hermanos... creo que podría decir cosas muy feas. Al menos iremos preparados. Y no es que tenga ganas de verla ahora mismo."
    sca "Ça me paraît une bonne idée. Si on est demi-frère et sœur… je pense qu'elle pourrait dire des choses vraiment méchantes. Au moins, on sera préparés. Et puis, ce n'est pas comme si j'avais très envie de la voir en ce moment."

# game/scripts/c18/c18.rpy:2619
translate french c18s003_Scarlett_2574a128:

    # sca "Me parece una buena idea. No tengo ganas de verla ahora mismo."
    sca "Ça me paraît une bonne idée. Je n'ai pas envie de le regarder maintenant."

# game/scripts/c18/c18.rpy:2620
translate french c18s003_Scarlett_f24e11ee:

    # sca "De todas formas, no tenía intención de contárselo enseguida. Primero se lo quiero contar a nuestra familia."
    sca "De toute façon, je ne comptais pas lui dire tout de suite. Je veux d'abord l'annoncer à notre famille."

# game/scripts/c18/c18.rpy:2622
translate french c18s003_Scarlett_87c40627:

    # mc "Ya te lo he dicho. Si quieres contárselo, no voy a poner ningún impedimento."
    mc "Je te l'ai déjà dit. Si tu veux lui dire, je ne t'en empêcherai pas."

# game/scripts/c18/c18.rpy:2625
translate french c18s003_Scarlett_7324dc5d:

    # dap "¿Puede Tía [dap] pedir un abrazo de los futuros padres?"
    dap "La tante [dap] peut-elle demander un câlin aux futurs parents ?"

# game/scripts/c18/c18.rpy:2628
translate french c18s003_Scarlett_53e40ed6:

    # sca "Ahora solo falta ver el de [dap]. Yo también quiero ser tía."
    sca "Il ne me reste plus qu'à voir les enfants de [dap]. Je veux être tante aussi."

# game/scripts/c18/c18.rpy:2629
translate french c18s003_Scarlett_31214d4f:

    # dap "No tengo prisa en que pite. Se está muy bien aquí. Ese test de embarazo va a ser el mejor regalo de cumpleaños que voy a recibir hoy."
    dap "Je ne suis pas pressée qu'il sonne. Il fait très bon ici. Ce test de grossesse sera le plus beau cadeau d'anniversaire que je recevrai aujourd'hui."

# game/scripts/c18/c18.rpy:2631
translate french c18s003_Scarlett_35f100d5:

    # dap "A veces me dais mucha envidia. Después pienso en que voy a poder jugar con el bebé y se me pasa."
    dap "Parfois, je vous envie vraiment. Puis je pense à la façon dont je vais pouvoir jouer avec le bébé et ça passe."

# game/scripts/c18/c18.rpy:2632
translate french c18s003_Scarlett_da69abcb:

    # dap "Ese test de embarazo va a ser el mejor regalo de cumpleaños que voy a recibir hoy."
    dap "Ce test de grossesse sera le plus beau cadeau d'anniversaire que je recevrai aujourd'hui."

# game/scripts/c18/c18.rpy:2633
translate french c18s003_Scarlett_974421d2:

    # mc "*Risa* Espero que no, pero ya tenemos una voluntaria para cambiar pañales, Scarlett."
    mc "*Rires* J'espère que non, mais nous avons déjà une volontaire pour changer les couches, Scarlett."

# game/scripts/c18/c18.rpy:2634
translate french c18s003_Scarlett_3f97664c:

    # sca "*Risa* Creo que [dap] será la primera persona del mundo que se lea en profundidad el manual de los pañales y lo modifique para hacerlo más eficiente."
    sca "*Rires* Je pense que [dap] sera la première personne au monde à lire le manuel des couches en détail et à le modifier pour le rendre plus efficace."

# game/scripts/c18/c18.rpy:2635
translate french c18s003_Scarlett_8843c9a6:

    # dap "¡Puagh! Quiero jugar con el bebé. *Risa* Los pañales son cosa vuestra. Pero sí que me leeré el manual."
    dap "Pff ! J'ai envie de jouer avec le bébé. *Rires* Les couches, c'est ta responsabilité. Mais je lirai la notice."

# game/scripts/c18/c18.rpy:2638
translate french c18s003_Scarlett_2ed5da58:

    # sca "¡Negativo!"
    sca "Négatif!"

# game/scripts/c18/c18.rpy:2639
translate french c18s003_Scarlett_ce105bff:

    # mc "Ven aquí. Dame un abrazo y un beso."
    mc "Viens ici. Fais-moi un câlin et un bisou."

# game/scripts/c18/c18.rpy:2643
translate french c18s003_Scarlett_db1134ff:

    # mc "No te pongas triste, habrá más oportunidades."
    mc "Ne sois pas triste, d'autres opportunités se présenteront."

# game/scripts/c18/c18.rpy:2644
translate french c18s003_Scarlett_38e664b6_1:

    # sca "No es eso..."
    sca "Ce n'est pas ça..."

# game/scripts/c18/c18.rpy:2647
translate french c18s003_Scarlett_aeda7f1c:

    # sca "No me malinterpretes, me hubiera gustado quedarme embarazada... pero casi prefiero que no haya pasado."
    sca "Ne vous méprenez pas, j'aurais aimé tomber enceinte... mais je préfère presque que cela ne se soit pas produit."

# game/scripts/c18/c18.rpy:2648
translate french c18s003_Scarlett_ba5aaef9:

    # mc "¿Por qué? ¿Hay algo que deba saber?"
    mc "Pourquoi ? Y a-t-il quelque chose que je devrais savoir ?"

# game/scripts/c18/c18.rpy:2651
translate french c18s003_Scarlett_0a15ad94:

    # sca "Aún no sabemos los resultados del test de ADN. Es posible que este bebé hubiera sido endogámico."
    sca "Nous ne connaissons pas encore les résultats du test ADN. Il est possible que ce bébé soit issu d'une consanguinité."

# game/scripts/c18/c18.rpy:2655
translate french c18s003_Scarlett_2d41f174:

    # sca "Sé que [mar] estaría ahí para nuestro bebé, y que [nor] actuaría también de abuela. Y que tendría muchas tías."
    sca "Je sais que [mar] serait là pour notre bébé, et que [nor] jouerait aussi le rôle d'une grand-mère. Et que j'aurais beaucoup de tantes."

# game/scripts/c18/c18.rpy:2656
translate french c18s003_Scarlett_e99a63f0:

    # mc "Y no te olvides de Meemaw y Tía Betty. Serían unas bisabuelas fantásticas."
    mc "Et n'oublions pas Mémé et Tante Betty. Elles feraient de formidables arrière-grands-mères."

# game/scripts/c18/c18.rpy:2657
translate french c18s003_Scarlett_00cc1e5f_1:

    # mc "Al menos cuando no estén en Florida."
    mc "Du moins, quand ils ne sont pas en Floride."

# game/scripts/c18/c18.rpy:2659
translate french c18s003_Scarlett_15a556d7:

    # sca "Pero... me gustaría que... si en algún momento pasa, se lo pudiéramos decir a mi madre."
    sca "Mais... j'aimerais... si jamais ça arrive, on pourrait le dire à ma mère."

# game/scripts/c18/c18.rpy:2660
translate french c18s003_Scarlett_6418d1c9_1:

    # mc "¿Qué? ¿Tal como te ha tratado?"
    mc "Quoi ? La façon dont il t'a traitée ?"

# game/scripts/c18/c18.rpy:2662
translate french c18s003_Scarlett_7cf92379:

    # dap "[mc], es su madre. ¿No se lo contarías a Tío Edmund, por muy mal que se haya portado?"
    dap "[mc], c'est sa mère. Tu ne le dirais pas à l'oncle Edmund, même s'il s'est très mal comporté ?"

# game/scripts/c18/c18.rpy:2665
translate french c18s003_Scarlett_0d19a8e7:

    # mc "Pero si hubiera salido positivo hoy, esperaría como mínimo a tener los resultados del test de ADN."
    mc "Mais si le test avait été positif aujourd'hui, j'aurais au moins attendu les résultats du test ADN."

# game/scripts/c18/c18.rpy:2667
translate french c18s003_Scarlett_de601e4a:

    # mc "Pero si hubiera salido positivo hoy, esperaría un tiempo antes de decírselo, a que se calmen las aguas."
    mc "Mais si j'avais été testé positif aujourd'hui, j'attendrais un peu avant de lui dire, le temps que les choses se calment."

# game/scripts/c18/c18.rpy:2670
translate french c18s003_Scarlett_7f007538:

    # sca "Me parece una buena idea. Si somos medio hermanos... creo que podría decir cosas muy feas. Al menos iríamos preparados."
    sca "Ça me paraît une bonne idée. Si on est demi-frères et sœurs… je crois que je dirais des choses vraiment méchantes. Au moins, on serait préparés."

# game/scripts/c18/c18.rpy:2672
translate french c18s003_Scarlett_2574a128_1:

    # sca "Me parece una buena idea. No tengo ganas de verla ahora mismo."
    sca "Ça me paraît une bonne idée. Je n'ai pas envie de le regarder maintenant."

# game/scripts/c18/c18.rpy:2673
translate french c18s003_Scarlett_6c0c04ea:

    # sca "De todas formas, no tenía intención de contárselo enseguida. Primero se lo hubiera querido contar a nuestra familia."
    sca "De toute façon, je n'avais pas l'intention de lui dire tout de suite. J'aurais préféré l'annoncer d'abord à notre famille."

# game/scripts/c18/c18.rpy:2675
translate french c18s003_Scarlett_1a6a26a4:

    # mc "Ya te lo he dicho. Si, cuando pase, quieres contárselo, no voy a poner ningún impedimento."
    mc "Je te l'ai déjà dit. Si, le moment venu, tu veux lui en parler, je ne l'en empêcherai pas."

# game/scripts/c18/c18.rpy:2678
translate french c18s003_Scarlett_70a401d3:

    # dap "¿Puede la futura Tía [dap] pedir un abrazo de los futuros padres?"
    dap "La future tante [dap] peut-elle demander un câlin aux futurs parents ?"

# game/scripts/c18/c18.rpy:2681
translate french c18s003_Scarlett_94124824:

    # sca "Ahora solo falta ver el de [dap]. A mí me gustaría saber hoy que voy a ser tía."
    sca "Il ne me reste plus qu'à attendre la nouvelle de [dap]. J'aimerais tellement savoir aujourd'hui que je vais être tante."

# game/scripts/c18/c18.rpy:2682
translate french c18s003_Scarlett_118ef7b0:

    # dap "No tengo prisa en que pite. Se está muy bien aquí. Ese test de embarazo podría haber sido el mejor regalo de cumpleaños que iba a recibir hoy."
    dap "Je ne suis pas pressée qu'il sonne. Il fait très bon ici. Ce test de grossesse aurait pu être le plus beau cadeau d'anniversaire que j'aurais pu recevoir aujourd'hui."

# game/scripts/c18/c18.rpy:2683
translate french c18s003_Scarlett_0096e533:

    # dap "Veros superar las dudas han superado a cualquier posible positivo. Y ese bebé llegará tarde o temprano."
    dap "Te voir surmonter tes doutes a été plus fort que n'importe quel résultat positif. Et ce bébé arrivera tôt ou tard."

# game/scripts/c18/c18.rpy:2685
translate french c18s003_Scarlett_12f7b571:

    # dap "A veces me dais mucha envidia. Después pienso en que voy a poder jugar con el bebé cuando [mc] apunte bien con sus soldaditos y se me pasa."
    dap "Parfois, vous me rendez vraiment jaloux. Puis je pense à la façon dont je pourrai jouer avec le bébé quand [mc] visera correctement avec ses petits soldats, et ça me passe."

# game/scripts/c18/c18.rpy:2686
translate french c18s003_Scarlett_73953127:

    # dap "Ese test de embarazo podría haber sido el mejor regalo de cumpleaños que iba a recibir hoy."
    dap "Ce test de grossesse aurait pu être le plus beau cadeau d'anniversaire que j'allais recevoir aujourd'hui."

# game/scripts/c18/c18.rpy:2687
translate french c18s003_Scarlett_fdd4419b:

    # mc "*Risa* Espero que no, pero ya tenemos una voluntaria para cambiar pañales cuando llegue el bebé, Scarlett."
    mc "*Rires* J'espère que non, mais nous avons déjà une volontaire pour changer les couches à l'arrivée du bébé, Scarlett."

# game/scripts/c18/c18.rpy:2688
translate french c18s003_Scarlett_3f97664c_1:

    # sca "*Risa* Creo que [dap] será la primera persona del mundo que se lea en profundidad el manual de los pañales y lo modifique para hacerlo más eficiente."
    sca "*Rires* Je pense que [dap] sera la première personne au monde à lire en détail le manuel des couches et à le modifier pour le rendre plus efficace."

# game/scripts/c18/c18.rpy:2689
translate french c18s003_Scarlett_d0714078:

    # dap "¡Puagh! He dicho jugar con el bebé. *Risa* Los pañales son cosa vuestra. Pero sí que me leeré el manual."
    dap "Pff ! J'ai dit de jouer avec le bébé. *Rires* Les couches, c'est ta responsabilité. Mais je lirai le mode d'emploi."

# game/scripts/c18/c18.rpy:2693
translate french c18s003_convScar1_b2dbd1ed:

    # "Os fundís en un abrazo y un beso..."
    "Vous vous laissez aller à une étreinte et à un baiser..."

# game/scripts/c18/c18.rpy:2695
translate french c18s003_convScar1_3527cb31:

    # "Pero es un beso dubitativo. Algo le pasa a Scarlett."
    "Mais c'est un baiser hésitant. Il y a quelque chose qui cloche chez Scarlett."

# game/scripts/c18/c18.rpy:2699
translate french c18s003_convScar2_744507d3:

    # dap "Díselo. Lo va a entender."
    dap "Dis-le-lui. Il comprendra."

# game/scripts/c18/c18.rpy:2700
translate french c18s003_convScar2_eb04d957:

    # mc "¿Qué me estáis ocultando? Habíamos quedado en hablarlo todo, ¿no?"
    mc "Que me caches-tu ? Nous avions convenu de tout mettre à plat, non ?"

# game/scripts/c18/c18.rpy:2704
translate french c18s003_convScar3_9ed741bb:

    # sca "[dap] y yo hemos estado hablando sobre qué pasaría si salía positivo..."
    sca "[dap] et moi avons parlé de ce qui se passerait si j'étais testé positif..."

# game/scripts/c18/c18.rpy:2708
translate french c18s003_convScar4_6c7fc95b:

    # dap "Yo le he dicho que la endogamia en primera generación no tiene prácticamente riesgos."
    dap "Je lui ai dit que la consanguinité en première génération ne présente pratiquement aucun risque."

# game/scripts/c18/c18.rpy:2709
translate french c18s003_convScar4_cefa98c1:

    # mc "¿De qué riesgos estamos hablando?"
    mc "De quels risques parle-t-on ?"

# game/scripts/c18/c18.rpy:2711
translate french c18s003_convScar4_046926f6:

    # dap "Negligibles. Los riesgos aumentan a partir de la tercera generación endogámica."
    dap "Négligeable. Les risques augmentent à partir de la troisième génération consanguine."

# game/scripts/c18/c18.rpy:2712
translate french c18s003_convScar4_ec7530ee:

    # dap "Cuarta en vuestro caso ya que solo seríais medio hermanos. Si es que lo sois."
    dap "Quatrièmement dans votre cas, puisque vous ne seriez que demi-frères et sœurs. Si c'est bien le cas."

# game/scripts/c18/c18.rpy:2714
translate french c18s003_convScar4_4299d6b8:

    # sca "Lo sé, pero eso no hace que me vaya a preocupar menos..."
    sca "Je sais, mais cela ne me rassure pas du tout..."

# game/scripts/c18/c18.rpy:2715
translate french c18s003_convScar4_03de3da7:

    # mc "¿No crees que vas un poco rápido con las preocupaciones?"
    mc "Ne penses-tu pas que tu t'inquiètes un peu trop ?"

# game/scripts/c18/c18.rpy:2717
translate french c18s003_convScar4_aad0753a:

    # sca "¿A qué te refieres?"
    sca "De quoi parles-tu?"

# game/scripts/c18/c18.rpy:2718
translate french c18s003_convScar4_de74ba43:

    # mc "A que aún no sabemos si somos medio hermanos. Creo que no vale la pena preocuparse por los \"qué pasaría si...?\" hasta que no tengamos los resultados."
    mc "Je parie qu'on ne sait toujours pas si on est demi-frères et sœurs. Je ne pense pas que ça serve à grand-chose de se poser des questions avant d'avoir les résultats."

# game/scripts/c18/c18.rpy:2720
translate french c18s003_convScar4_597f5b22:

    # sca "Tienes razón... pero hay otro tema."
    sca "Vous avez raison… mais il y a un autre problème."

# game/scripts/c18/c18.rpy:2721
translate french c18s003_convScar4_3b916da8:

    # mc "¿Qué pasa?"
    mc "Ce qui se passe?"

# game/scripts/c18/c18.rpy:2725
translate french c18s003_convScar5_d66f3c0c:

    # dap "No te enfades. Ponte en su situación e intenta entenderlo."
    dap "Ne vous mettez pas en colère. Mettez-vous à leur place et essayez de les comprendre."

# game/scripts/c18/c18.rpy:2726
translate french c18s003_convScar5_8f035388:

    # mc "Me estáis preocupando."
    mc "Tu m'inquiètes."

# game/scripts/c18/c18.rpy:2728
translate french c18s003_convScar5_bd72010a:

    # sca "Yo he crecido sin padre. Sé que tú no vas a ser un padre ausente."
    sca "J'ai grandi sans père. Je sais que tu ne seras pas un père absent."

# game/scripts/c18/c18.rpy:2729
translate french c18s003_convScar5_f5e0ccce:

    # mc "No tengo intención de serlo."
    mc "Je n'ai aucune intention d'en être un."

# game/scripts/c18/c18.rpy:2731
translate french c18s003_convScar5_6d33c75d:

    # sca "También he crecido prácticamente sin mis abuelos. Vosotros teníais a Olivia."
    sca "J'ai moi aussi grandi pratiquement sans mes grands-parents. Vous, vous aviez Olivia."

# game/scripts/c18/c18.rpy:2732
translate french c18s003_convScar5_65f9676b:

    # mc "Sí..."
    mc "Ouais..."

# game/scripts/c18/c18.rpy:2736
translate french c18s003_convScar6_7ee326ec:

    # mc "¿Te das cuenta de lo complicado que sería eso si somos medio hermanos?"
    mc "Tu te rends compte à quel point ce serait compliqué si nous étions demi-frères et sœurs ?"

# game/scripts/c18/c18.rpy:2737
translate french c18s003_convScar6_585decf3:

    # mc "Papá, tu hija y yo vamos a tener un hijo juntos. Cuando nos acostamos no sabíamos que éramos hermanos porque eres un pedazo de mierda que guardó el secreto."
    mc "Papa, ta fille et moi allons avoir un enfant ensemble. Quand on a couché ensemble, on ne savait pas qu'on était frère et sœur parce que tu es un salaud qui a gardé le secret."

# game/scripts/c18/c18.rpy:2739
translate french c18s003_convScar6_36bbd1de:

    # mc "Para eso debería saber cómo contactar con él."
    mc "Pour cela, il me faudrait savoir comment le contacter."

# game/scripts/c18/c18.rpy:2740
translate french c18s003_convScar6_46f8fa92:

    # mc "Pero sí. Lo entiendo."
    mc "Mais oui, je comprends."

# game/scripts/c18/c18.rpy:2742
translate french c18s003_convScar6_a73a3968:

    # sca "Entonces... ¿no te importaría decírselo a mi madre?"
    sca "Alors… ça ne vous dérangerait pas de le dire à ma mère ?"

# game/scripts/c18/c18.rpy:2743
translate french c18s003_convScar6_b849e252:

    # mc "Es tu madre. Haremos con ella lo que creas conveniente."
    mc "C'est ta mère. On fera avec elle ce que tu jugeras bon."

# game/scripts/c18/c18.rpy:2746
translate french c18s003_convScar7_8b5854e6:

    # mc "Creo que después de la interpretación de Amanda en tu antigua casa, deberíamos esperar un tiempo antes de ver a tu madre y a Kevin."
    mc "Je pense qu'après le spectacle d'Amanda dans votre ancienne maison, nous devrions attendre un peu avant de revoir votre mère et Kevin."

# game/scripts/c18/c18.rpy:2747
translate french c18s003_convScar7_31debc5f:

    # mc "Ellos creen que se me llevó detenido."
    mc "Ils pensent que j'ai été placé en garde à vue."

# game/scripts/c18/c18.rpy:2749
translate french c18s003_convScar7_11ab8539:

    # "Scarlett se lanza a tus brazos de nuevo. Esta vez, las dudas han desaparecido."
    "Scarlett se jette à nouveau dans vos bras. Cette fois, les doutes se sont dissipés."

# game/scripts/c18/c18.rpy:2751
translate french c18s003_convScar7_12572bd7:

    # sca "Gracias por ser comprensivo, mi amor. Sé que no se lo merece, pero es mi madre al fin y al cabo."
    sca "Merci de ta compréhension, mon amour. Je sais qu'elle ne le mérite pas, mais c'est ma mère après tout."

# game/scripts/c18/c18.rpy:2755
translate french c18s003_convScar8_1515fd35:

    # mc "Pero si aparece Kevin no puedo asegurar que no le vaya a volver a pegar."
    mc "Mais si Kevin se présente, je ne peux pas garantir qu'il ne le frappera pas à nouveau."

# game/scripts/c18/c18.rpy:2758
translate french c18s003_convScar8_2579666c:

    # sca "*Risa* Siempre podemos mandar a Amanda para que lo detenga antes de reunirnos con mi madre."
    sca "*Rires* On peut toujours envoyer Amanda l'arrêter avant de rencontrer ma mère."

# game/scripts/c18/c18.rpy:2759
translate french c18s003_convScar8_53608814:

    # mc "*Risa* No estaría mal. Nada mal."
    mc "*Rires* Ce ne serait pas mal. Pas mal du tout."

# game/scripts/c18/c18.rpy:2761
translate french c18s003_convScar8_d898854b:

    # dap "Ahora que todo está resuelto y os volvéis a reír... ¿puedo decir algo?"
    dap "Maintenant que tout est rentré dans l'ordre et que vous riez tous à nouveau... puis-je dire quelque chose ?"

# game/scripts/c18/c18.rpy:2762
translate french c18s003_convScar8_bafc5879:

    # mc "Claro que sí, [dap]."
    mc "Bien sûr, [dap]."

# game/scripts/c18/c18.rpy:2765
translate french c18s003_convScar9_b3b94564:

    # todas "*Risa*"
    todas "*Rire*"

# game/scripts/c18/c18.rpy:2766
translate french c18s003_convScar9_35b894b1:

    # mc "Ven aquí, Tía [dap]."
    mc "Viens ici, tante [dap]."

# game/scripts/c18/c18.rpy:2768
translate french c18s003_convScar9_1ecfcb46:

    # "Los tres os fundís en un abrazo de alegría compartida."
    "Vous vous fondez tous les trois dans une étreinte de joie partagée."

# game/scripts/c18/c18.rpy:2811
translate french c18s004_Meemaw_9e8c0dca:

    # "Al volver a tu habitación te encuentras con Olivia esperándote."
    "À votre retour dans votre chambre, vous trouvez Olivia qui vous attend."

# game/scripts/c18/c18.rpy:2812
translate french c18s004_Meemaw_b94bea67:

    # "Tiene mejor aspecto que estos últimos días. Supones que los efectos de la quimio están desapareciendo, aún le queda un poco para volver a ser ella misma."
    "Elle a meilleure mine qu'au cours des derniers jours. J'imagine que les effets de la chimio s'estompent, mais il lui faudra encore un peu de temps avant de retrouver sa forme d'avant."

# game/scripts/c18/c18.rpy:2813
translate french c18s004_Meemaw_d43a9ef9:

    # mc "Buenos días, Meemaw."
    mc "Bonjour, Meemaw."

# game/scripts/c18/c18.rpy:2814
translate french c18s004_Meemaw_b864994b:

    # mee "¿No tengo beso de buenos días hoy?"
    mee "Je n'ai pas droit à un bisou du matin aujourd'hui ?"

# game/scripts/c18/c18.rpy:2815
translate french c18s004_Meemaw_2ffe26d0:

    # mc "No hace falta que lo pidas, puedes darlo tú si quieres."
    mc "Vous n'avez pas besoin de le demander, vous pouvez le donner si vous le souhaitez."

# game/scripts/c18/c18.rpy:2817
translate french c18s004_Meemaw_1d9369de:

    # mee "Buenos días, [mc]."
    mee "Bonjour, [mc]."

# game/scripts/c18/c18.rpy:2818
translate french c18s004_Meemaw_47d83ec6:

    # mc "Buenos días, Meemaw. ¿Puedo ayudarte en algo?"
    mc "Bonjour Meemaw. Puis-je vous aider ?"

# game/scripts/c18/c18.rpy:2820
translate french c18s004_Meemaw_497799c5:

    # mee "Si tienes un rato libre..."
    mee "Si vous avez du temps libre..."

# game/scripts/c18/c18.rpy:2821
translate french c18s004_Meemaw_a1d53a70:

    # mc "Siempre tengo tiempo libre para ti."
    mc "J'ai toujours du temps libre pour toi."

# game/scripts/c18/c18.rpy:2823
translate french c18s004_Meemaw_dcfc3356:

    # mee "¿Puedes ayudarme con el masaje hoy?"
    mee "Pouvez-vous me masser aujourd'hui ?"

# game/scripts/c18/c18.rpy:2824
translate french c18s004_Meemaw_e67314ce:

    # mc "¿No te gustó cómo lo hizo Tía Betty ayer?"
    mc "Tu n'as pas aimé la façon dont tante Betty s'est comportée hier ?"

# game/scripts/c18/c18.rpy:2826
translate french c18s004_Meemaw_214d3a01:

    # mee "No es por eso. Hoy es domingo y ha ido a misa. Además tenía que hablar con el cura de algo, la llamó ayer."
    mee "Ce n'est pas ça. Aujourd'hui, c'est dimanche et elle est allée à la messe. De plus, elle devait parler au prêtre ; il l'a appelée hier."

# game/scripts/c18/c18.rpy:2827
translate french c18s004_Meemaw_a6010a83:

    # mc "Ah, OK. Perfecto. ¿Dónde lo quieres hacer? ¿Aquí?"
    mc "Ah, d'accord. Parfait. Où voulez-vous le faire ? Ici ?"

# game/scripts/c18/c18.rpy:2830
translate french c18s004_Meemaw_c83f66de:

    # mee "Sí, aquí mismo va bien. Me he extraído la leche en casa de [nor] hace un momento."
    mee "Oui, ça fonctionne parfaitement ici. Je viens de faire le plein chez [nor] il y a un instant."

# game/scripts/c18/c18.rpy:2832
translate french c18s004_Meemaw_b911d7d9:

    # "Haces el masaje a Olivia tal y como te enseñó la Doctora Milk y vuelve a su habitación. Cada vez está más cómoda a tu alrededor con poca ropa."
    "Vous massez Olivia exactement comme le docteur Milk vous l'a appris, et elle retourne dans sa chambre. Elle se sent de plus en plus à l'aise en votre présence, vêtue de très peu de vêtements."

# game/scripts/c18/c18.rpy:2835
translate french c18s004_Meemaw_034a5c81:

    # mee "Creo que el mejor sitio sería un baño. Por si... ya sabes."
    mee "Je pense que le meilleur endroit serait une salle de bain. On ne sait jamais... vous voyez."

# game/scripts/c18/c18.rpy:2836
translate french c18s004_Meemaw_2d1f65ab:

    # mc "Bueno, parece que sólo pasó en la consulta de la Doctora Milk. Ayer, mientras le enseñaba a Tía Betty, no pasó nada."
    mc "Eh bien, il semblerait que cela ne se soit produit qu'au cabinet du Dr Milk. Hier, pendant que je donnais un cours à tante Betty, rien ne s'est passé."

# game/scripts/c18/c18.rpy:2837
translate french c18s004_Meemaw_fc673ed5:

    # mc "¿Te volvió a pasar cuando me fui y la dejé haciéndote el masaje?"
    mc "Est-ce que cela s'est reproduit lorsque je suis partie et qu'elle vous massait ?"

# game/scripts/c18/c18.rpy:2839
translate french c18s004_Meemaw_8479a78d:

    # mee "No, no... no pasó nada. Estoy empezando a pensar que quizás la Doctora no extrajo toda la leche."
    mee "Non, non… il ne s'est rien passé. Je commence à me demander si le médecin n'a pas réussi à tirer tout le lait."

# game/scripts/c18/c18.rpy:2840
translate french c18s004_Meemaw_cf2d905d:

    # mc "Meemaw... yo creo que sí que lo hizo bien. Una de las razones que dio para que pasara lo que pasó es que hubiera excitación sexual."
    mc "Meemaw… Je pense qu’il a bien fait. Il a notamment expliqué ce qui s’est passé par une excitation sexuelle."

# game/scripts/c18/c18.rpy:2841
translate french c18s004_Meemaw_acc44f73:

    # mc "Y los dos sabemos que la hubo."
    mc "Et nous savons tous les deux qu'il y en avait un."

# game/scripts/c18/c18.rpy:2843
translate french c18s004_Meemaw_80bc16e1:

    # mee "No me lo recuerdes... ¡Qué vergüenza! Tener un orgasmo mientras mi nieto me masajeaba los pechos..."
    mee "N'en parlons pas... Quelle honte ! Avoir un orgasme pendant que mon petit-fils me massait les seins..."

# game/scripts/c18/c18.rpy:2844
translate french c18s004_Meemaw_d8e0a824:

    # mc "No le des más importancia de la que tiene. Pasó y ya está. Ayer no pasó, con lo que lo podemos dejar como un incidente aislado."
    mc "N'en faites pas toute une histoire. C'est arrivé, c'est tout. Ce n'est pas arrivé hier, donc on peut considérer ça comme un incident isolé."

# game/scripts/c18/c18.rpy:2845
translate french c18s004_Meemaw_27208654:

    # mc "Supongo que no volverá a pasar lo mismo, con lo que no hay peligro para el parqué."
    mc "Je suppose que la même chose ne se reproduira pas, donc il n'y a aucun danger pour le marché."

# game/scripts/c18/c18.rpy:2847
translate french c18s004_Meemaw_35ee814b:

    # mee "Cómo quieras, pero no te quejes si después tienes que fregar tu habitación. *Risa*"
    mee "Fais ce que tu veux, mais ne te plains pas si tu dois nettoyer ta chambre après. *Rires*"

# game/scripts/c18/c18.rpy:2848
translate french c18s004_Meemaw_f8254cc8:

    # mc "*Risa* Si tengo que fregar la habitación significará que lo has disfrutado, con lo que no me quejaré."
    mc "*Rires* Si je dois nettoyer la chambre, c'est que vous avez apprécié, alors je ne vais pas me plaindre."

# game/scripts/c18/c18.rpy:2850
translate french c18s004_Meemaw_e10117ec:

    # mee "¡[mc]!"
    mee "[mc]!"

# game/scripts/c18/c18.rpy:2851
translate french c18s004_Meemaw_827bfdfa:

    # mc "¿Qué? Si vuelve a pasar lo mismo..."
    mc "Et si la même chose se reproduit…"

# game/scripts/c18/c18.rpy:2853
translate french c18s004_Meemaw_e8829b92:

    # mee "No va a pasar. Punto."
    mee "Ça n'arrivera pas. Point final."

# game/scripts/c18/c18.rpy:2854
translate french c18s004_Meemaw_4aa3eb3f:

    # mc "OK. Déjame quitarme la ropa... tan solo para prevenir. Puedes dejar el albornoz en la silla."
    mc "D'accord. Je vais me déshabiller… par précaution. Vous pouvez laisser votre peignoir sur la chaise."

# game/scripts/c18/c18.rpy:2856
translate french c18s004_Meemaw_7e971260:

    # mee "{b}¿Qué?{/b} ¿Vas a desnudarte?"
    mee "{b}Quoi ?{/b} Tu vas te déshabiller ?"

# game/scripts/c18/c18.rpy:2857
translate french c18s004_Meemaw_e9694807:

    # mc "No, Meemaw, sólo voy a quitarme los pantalones y la camiseta. Ya te digo que es solo para prevenir."
    mc "Non, grand-mère, j'enlève juste mon pantalon et ma chemise. Comme je l'ai dit, c'est par précaution."

# game/scripts/c18/c18.rpy:2858
translate french c18s004_Meemaw_3ef8b6a8:

    # mc "Tengo que ir a buscar a Maddie cuando acabemos con esto, y no quiero ir con manchas lácteas. *Risa*"
