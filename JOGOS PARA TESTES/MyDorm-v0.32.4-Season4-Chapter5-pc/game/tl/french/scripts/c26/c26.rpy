

# game/scripts/c26/c26.rpy:60
translate french c26s001_MeeDate_e99f27ed:

    # mc "¡Estás guapísima!"
    mc "Tu es magnifique !"

# game/scripts/c26/c26.rpy:61
translate french c26s001_MeeDate_ba895501:

    # mee "Bueno, una chica tiene que arreglarse para una cita, ¿no? *Risita*"
    mee "Eh bien, une fille doit bien s'habiller pour un rendez-vous, non ? *Rires*"

# game/scripts/c26/c26.rpy:62
translate french c26s001_MeeDate_0d115086:

    # mc "Creía que no era una cita. O que decidirías luego si era una cita."
    mc "Je croyais que ce n'était pas un rendez-vous. Ou que tu déciderais plus tard si c'en était un."

# game/scripts/c26/c26.rpy:64
translate french c26s001_MeeDate_e3bc7b7a:

    # mee "Bueno, pues una mujer tiene que arreglarse cuando va a cenar con su nieto."
    mee "Eh bien, une femme se doit de s'habiller élégamment lorsqu'elle va dîner avec son petit-fils."

# game/scripts/c26/c26.rpy:65
translate french c26s001_MeeDate_2e05c372:

    # mee "Ya decidiremos luego si ha sido una cita o no."
    mee "Nous déciderons plus tard s'il s'agissait d'un rendez-vous ou non."

# game/scripts/c26/c26.rpy:66
translate french c26s001_MeeDate_5f06014d:

    # mc "Sea lo que sea, te aseguro que, en el restaurante, todos los clientes me van a mirar preguntándose cómo puedo ir con una mujer tan guapa."
    mc "Quoi qu'il en soit, je vous assure qu'au restaurant, tous les clients me regarderont en se demandant comment je peux être avec une si belle femme."

# game/scripts/c26/c26.rpy:68
translate french c26s001_MeeDate_459bf8be:

    # mee "No te va a mirar nadie preguntándose eso mientras cenamos. *Risa*"
    mee "Personne ne te regardera en se demandant ça pendant qu'on dîne. *Rires*"

# game/scripts/c26/c26.rpy:69
translate french c26s001_MeeDate_881dfb18:

    # mc "¿Quieres apostar?"
    mc "Envie de parier ?"

# game/scripts/c26/c26.rpy:70
translate french c26s001_MeeDate_d11d3718:

    # mee "Vale. ¿Qué quieres apostar?"
    mee "D'accord. Que voulez-vous parier ?"

# game/scripts/c26/c26.rpy:71
translate french c26s001_MeeDate_8d6c7502:

    # mc "Si me miran al menos cinco clientes... y decides que es una cita... hoy duermes en mi habitación."
    mc "Si au moins cinq clients me regardent... et que vous décidez que c'est un rendez-vous... vous dormirez dans ma chambre ce soir."

# game/scripts/c26/c26.rpy:72
translate french c26s001_MeeDate_1813fcb9:

    # mc "Aunque mi cama ha sufrido un pequeño accidente por culpa de un gato."
    mc "Bien que mon lit ait subi un petit accident à cause d'un chat."

# game/scripts/c26/c26.rpy:74
translate french c26s001_MeeDate_9be46529:

    # mee "*Risa* Lo sé, me lo ha contado [nor]."
    mee "*Rires* Je sais, [nor] me l'a dit."

# game/scripts/c26/c26.rpy:75
translate french c26s001_MeeDate_28bf38f2:

    # mee "La apuesta me parece bien, pero ¿y si no te mira nadie?"
    mee "L'idée me paraît bonne, mais que se passera-t-il si personne ne regarde ?"

# game/scripts/c26/c26.rpy:76
translate french c26s001_MeeDate_efcb438e:

    # mc "No sé. Decide tú."
    mc "Je ne sais pas. À vous de décider."

# game/scripts/c26/c26.rpy:77
translate french c26s001_MeeDate_72d55a83:

    # mee "Si no te mira nadie, tú duermes en la mía. Si decidimos que es una cita, claro. *Risita* Al menos la mía tiene una cama en buen estado."
    mee "Si personne ne regarde, tu peux dormir chez moi. Si on décide que c'est un rendez-vous, bien sûr. *Rires* Au moins, chez moi, j'ai un lit correct."

# game/scripts/c26/c26.rpy:78
translate french c26s001_MeeDate_996f86d2:

    # mc "Parece un buen plan. *Risa* Sea como sea, hoy dormiremos juntos. Si {b}decides{/b} que es una cita."
    mc "Ça me paraît une bonne idée. *Rires* Bref, on dort ensemble ce soir. Si tu considères ça comme un rendez-vous."

# game/scripts/c26/c26.rpy:80
translate french c26s001_MeeDate_1a6fe4e8:

    # mee "[mc]..."
    mee "[mc]..."

# game/scripts/c26/c26.rpy:81
translate french c26s001_MeeDate_b9ae80eb:

    # mc "¿Pasa algo, Meemaw?"
    mc "Quelque chose ne va pas, Mémé ?"

# game/scripts/c26/c26.rpy:83
translate french c26s001_MeeDate_7dde478e:

    # mee "¿Podemos dejar de fingir que esto no es una cita?"
    mee "Peut-on arrêter de faire comme si ce n'était pas un rendez-vous ?"

# game/scripts/c26/c26.rpy:84
translate french c26s001_MeeDate_1da4a18b:

    # mee "Hace días que decidí que lo sería, y me muero por besarte..."
    mee "J'ai pris cette décision il y a quelques jours, et j'ai tellement envie de t'embrasser..."

# game/scripts/c26/c26.rpy:86
translate french c26s001_MeeDate_e2be6ff0:

    # "No tienes que responder. Al menos no con palabras. Tus labios besan los de [mee] con dulzura."
    "Tu n'es pas obligé de répondre. Du moins pas avec des mots. Tes lèvres embrassent doucement celles de [mee]."

# game/scripts/c26/c26.rpy:87
translate french c26s001_MeeDate_672bd482:

    # "Su cuerpo tiembla bajo tu tacto hasta que se separa reluctantemente de tus labios."
    "Son corps tremble sous votre contact jusqu'à ce qu'elle se détache à contrecœur de vos lèvres."

# game/scripts/c26/c26.rpy:89
translate french c26s001_MeeDate_bf01fb4d:

    # mee "*Respirando pesadamente* Creo que como aperitivo hay suficiente."
    mee "*Respiration haletante* Je pense que c'est suffisant comme entrée."

# game/scripts/c26/c26.rpy:90
translate french c26s001_MeeDate_7ee46f6f:

    # mc "Hay que dejar más besos para después de la cena, ¿no?"
    mc "On devrait garder les baisers pour après le dîner, non ?"

# game/scripts/c26/c26.rpy:91
translate french c26s001_MeeDate_dc680032:

    # mc "Por cierto, ¿dónde vamos a ir?"
    mc "Au fait, où allons-nous ?"

# game/scripts/c26/c26.rpy:93
translate french c26s001_MeeDate_91f1b43e:

    # mee "He alquilado un sitio en San Luis."
    mee "J'ai loué un logement à San Luis."

# game/scripts/c26/c26.rpy:94
translate french c26s001_MeeDate_9413e0d6:

    # mc "¿Alquilado? Querrás decir reservado, ¿no?"
    mc "Loué ? Vous voulez dire réservé, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:95
translate french c26s001_MeeDate_95b80b24:

    # mee "Lo tendrás que descubrir cuando lleguemos."
    mee "Vous le découvrirez une fois sur place."

# game/scripts/c26/c26.rpy:97
translate french c26s001_MeeDate_057020cc:

    # "[mee] introduce la dirección en el GPS. Llegaréis en unos 30 minutos."
    "Entrez l'adresse dans votre GPS. Vous arriverez dans environ 30 minutes."

# game/scripts/c26/c26.rpy:98
translate french c26s001_MeeDate_0bc6dfbf:

    # "Cuando faltan unos minutos para llegar, hace una llamada, indicando que estáis a menos de cinco minutos."
    "Quand il ne reste que quelques minutes avant votre arrivée, il vous appelle pour vous indiquer que vous êtes à moins de cinq minutes."

# game/scripts/c26/c26.rpy:99
translate french c26s001_MeeDate_6a7ea241:

    # "Parece que le dan unas indicaciones con las que te guía hasta una rotonda desde la que salen varios caminos empedrados que se adentran en el bosque."
    "Il semblerait qu'ils vous donnent des indications qui vous mènent à un rond-point d'où partent plusieurs chemins pavés qui s'enfoncent dans la forêt."

# game/scripts/c26/c26.rpy:101
translate french c26s001_MeeDate_455e492e:

    # "Aparcas la camioneta en el lugar que te indica [mee] y camináis unos minutos por uno de los caminos rodeado de árboles."
    "Vous garez le fourgon à l'endroit indiqué par [mee] et marchez pendant quelques minutes le long de l'un des chemins entourés d'arbres."

# game/scripts/c26/c26.rpy:103
translate french c26s001_MeeDate_ab3a7912:

    # "Al girar por una de las curvas del camino, aparece una visión de cuento en medio de un claro en el bosque."
    "Au détour d'un virage, un spectacle féerique apparaît au milieu d'une clairière."

# game/scripts/c26/c26.rpy:105
translate french c26s001_MeeDate_7f6a5a0f:

    # mc "¡Wow, Meemaw! ¡Es precioso!"
    mc "Waouh, Meemaw ! C'est magnifique !"

# game/scripts/c26/c26.rpy:106
translate french c26s001_MeeDate_4b08a348:

    # mee "¿Te gusta? No mucha gente conoce este sitio."
    mee "Vous aimez ? Peu de gens connaissent cet endroit."

# game/scripts/c26/c26.rpy:107
translate french c26s001_MeeDate_cbb0a18f:

    # mc "Es increíble. ¿Cómo es que tú lo conoces?"
    mc "C'est incroyable ! Comment le connaissez-vous ?"

# game/scripts/c26/c26.rpy:109
translate french c26s001_MeeDate_7cab5fb6:

    # mee "Vendí estos terrenos unos años antes de que nacieras."
    mee "J'ai vendu ce terrain quelques années avant ta naissance."

# game/scripts/c26/c26.rpy:110
translate french c26s001_MeeDate_9f3b7009:

    # mee "Iban a construir un hotel también, pero al final no lo hicieron y sólo construyeron el restaurante."
    mee "Ils avaient prévu de construire un hôtel aussi, mais finalement ils n'ont construit que le restaurant."

# game/scripts/c26/c26.rpy:111
translate french c26s001_MeeDate_1723bb21:

    # mc "¿Dónde están los camareros? Si tienen que venir por el camino empedrado más les vale ir en patinete."
    mc "Où sont les serveurs ? S'ils doivent passer par le chemin pavé, ils feraient mieux de prendre un scooter."

# game/scripts/c26/c26.rpy:113
translate french c26s001_MeeDate_d63bcc5f:

    # mee "*Risa* Este sitio no funciona así, cariño. Pedí la comida cuando lo alquilé."
    mee "*Rires* Ça ne marche pas comme ça ici, chérie. J'ai commandé à manger quand j'ai loué l'appartement."

# game/scripts/c26/c26.rpy:114
translate french c26s001_MeeDate_99282fef:

    # mee "Lo han preparado todo en el gazebo cuando he llamado."
    mee "Tout était prêt dans le kiosque quand j'ai appelé."

# game/scripts/c26/c26.rpy:115
translate french c26s001_MeeDate_8aa83788:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c26/c26.rpy:117
translate french c26s001_MeeDate_173a4dc2:

    # mee "¿Qué tal si respondo a tus preguntas allí? *Risa* Parecemos dos idiotas en medio del bosque."
    mee "Et si je répondais à vos questions là-bas ? *Rires* On a l'air de deux idiots en pleine forêt."

# game/scripts/c26/c26.rpy:118
translate french c26s001_MeeDate_6d7821fa:

    # mc "*Risa* Tienes razón. Te sigo."
    mc "*Rires* Tu as raison. Je te suivrai."

# game/scripts/c26/c26.rpy:120
translate french c26s001_MeeDate_f6d4cb0b:

    # mee "¿Ves? Detrás tuyo tienes los cortes fríos y aquí la comida caliente."
    mee "Vous voyez ? Derrière vous, ce sont les charcuteries et ici, les plats chauds."

# game/scripts/c26/c26.rpy:121
translate french c26s001_MeeDate_52b33d7d:

    # mc "Incluso tiene un sofá. Es un sitio genial. Muy romántico."
    mc "Il y a même un canapé. C'est un endroit formidable. Très romantique."

# game/scripts/c26/c26.rpy:123
translate french c26s001_MeeDate_b9260d76:

    # mee "Nunca más vamos a tener una primera cita, con lo que quería que fuera especial."
    mee "Nous n'aurons plus jamais de premier rendez-vous, alors je voulais que celui-ci soit spécial."

# game/scripts/c26/c26.rpy:124
translate french c26s001_MeeDate_5ebadfc3:

    # mc "Lo has conseguido. Es precioso."
    mc "Tu l'as fait. C'est magnifique."

# game/scripts/c26/c26.rpy:126
translate french c26s001_MeeDate_f21303a6:

    # mee "Y, como puedes ver, ningún cliente te va a mirar preguntándose nada. *Risa*"
    mee "Et, comme vous pouvez le constater, aucun client ne vous regardera en se demandant quoi que ce soit. *Rires*"

# game/scripts/c26/c26.rpy:127
translate french c26s001_MeeDate_17501436:

    # mee "Hoy duermes en mi habitación."
    mee "Tu dors dans ma chambre ce soir."

# game/scripts/c26/c26.rpy:128
translate french c26s001_MeeDate_0cf017ca:

    # mc "*Risa* Eso es trampa. Tú sabías que habías ganado la apuesta antes de hacerla."
    mc "*Rires* C'est de la triche. Tu savais que tu avais gagné le pari avant même de le faire."

# game/scripts/c26/c26.rpy:130
translate french c26s001_MeeDate_b614db1b:

    # mee "*Risa* Nunca apuestes a ciegas, cielo."
    mee "*Rires* Ne pariez jamais à l'aveuglette, chérie."

# game/scripts/c26/c26.rpy:131
translate french c26s001_MeeDate_402e9590:

    # mee "Además, no quieres que una pobre anciana duerma en un colchón en el suelo."
    mee "De plus, vous ne voulez pas qu'une pauvre vieille dame dorme sur un matelas à même le sol."

# game/scripts/c26/c26.rpy:132
translate french c26s001_MeeDate_2b8fc357:

    # mc "*Risa* En este caso, es una apuesta que no me importa perder."
    mc "*Rires* Dans ce cas précis, c'est un pari que je ne crains pas de perdre."

# game/scripts/c26/c26.rpy:133
translate french c26s001_MeeDate_9f69baf8:

    # mee "Coge la comida que quieras. No sabía qué te apetecería y he pedido muchísima comida."
    mee "Servez-vous comme vous le souhaitez. Je ne savais pas ce qui vous plairait, alors j'ai commandé beaucoup de choses."

# game/scripts/c26/c26.rpy:135
translate french c26s001_MeeDate_9a3a27e0:

    # "[mee] no miente. Hay comida para alimentar a la mitad de la familia. Especialmente si dentro de esa mitad no está Jamaal."
    "[mee] Il ne ment pas. Il y a assez à manger pour nourrir la moitié de la famille. Surtout si Jamaal n'en fait pas partie."

# game/scripts/c26/c26.rpy:137
translate french c26s001_MeeDate_d9243e15:

    # mc "Tenías razón. Has pedido demasiada comida. ¡Pero si hay incluso bacon canadiense!"
    mc "Tu avais raison. Tu as commandé beaucoup trop à manger. Il y a même du bacon canadien !"

# game/scripts/c26/c26.rpy:138
translate french c26s001_MeeDate_e3bdc460:

    # mee "*Risa* Ese es para mí. Ya sé que no te gusta, pero para mí es un placer culpable."
    mee "*Rires* Celle-là, c'est pour moi. Je sais que tu n'aimes pas ça, mais moi, c'est un plaisir coupable."

# game/scripts/c26/c26.rpy:139
translate french c26s001_MeeDate_7ecfb6d9:

    # mc "*Risa* ¿Qué va a ser lo siguiente? ¿Pizza con cosas raras?"
    mc "*Rires* Et après ? Une pizza avec des trucs bizarres ?"

# game/scripts/c26/c26.rpy:141
translate french c26s001_MeeDate_8e5336a4:

    # mee "*Risa* No, eso se lo dejo a [bet]. Creo que si pones un bisonte entero encima de una base de pizza sería capaz de comérselo."
    mee "*Rires* Non, je laisse ça à [bet]. Je pense que si on mettait un bison entier sur une pâte à pizza, il pourrait la manger."

# game/scripts/c26/c26.rpy:142
translate french c26s001_MeeDate_cca5d0e0:

    # mc "*Risa* Me lo creo."
    mc "*Rires* J'y crois."

# game/scripts/c26/c26.rpy:143
translate french c26s001_MeeDate_8d4dc8e7:

    # mc "Pero explícame la historia de este sitio. Parece un sitio muy especial."
    mc "Mais racontez-moi l'histoire de cet endroit. Il semble très spécial."

# game/scripts/c26/c26.rpy:145
translate french c26s001_MeeDate_750f1bd5:

    # mee "Lo es. Querían construir un complejo de lujo para famosos que huyeran de L.A. Por eso los gazebos están escondidos, para darles intimidad."
    mee "C'est exact. Ils voulaient construire un complexe hôtelier de luxe pour les célébrités fuyant Los Angeles. C'est pourquoi les pavillons sont dissimulés, pour préserver leur intimité."

# game/scripts/c26/c26.rpy:146
translate french c26s001_MeeDate_46edd6a8:

    # mee "Siempre pensé que estaba pensado para que pudieran venir aquí para escapar de los paparazzis."
    mee "J'ai toujours pensé que c'était fait exprès pour qu'ils puissent venir ici échapper aux paparazzis."

# game/scripts/c26/c26.rpy:147
translate french c26s001_MeeDate_7d596d39:

    # mc "Tiene lógica."
    mc "C'est logique."

# game/scripts/c26/c26.rpy:150
translate french c26s001_MeeDate_455c54e7:

    # mee "Yo vendí los terrenos y tu abuelo hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "J'ai vendu le terrain et votre grand-père a conçu le restaurant. C'était l'un de ses derniers projets."

# game/scripts/c26/c26.rpy:152
translate french c26s001_MeeDate_51144d46:

    # mee "Yo vendí los terrenos y John hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "J'ai vendu le terrain et John a conçu le restaurant. Ce fut l'un de ses derniers projets."

# game/scripts/c26/c26.rpy:153
translate french c26s001_MeeDate_5098616f:

    # mee "El hotel fue diseñado por un estudio de San Francisco. Una cosa muy lujosa. Y muy fea a mi parecer."
    mee "L'hôtel a été conçu par un studio de San Francisco. Très luxueux. Et très laid à mon avis."

# game/scripts/c26/c26.rpy:154
translate french c26s001_MeeDate_4ca75ceb:

    # mee "John no llegó a verlo completado, ni a saber que el hotel no se construiría."
    mee "John n'a pas vécu assez longtemps pour voir la construction achevée, ni pour savoir que l'hôtel ne serait jamais construit."

# game/scripts/c26/c26.rpy:155
translate french c26s001_MeeDate_4ce4b479:

    # mc "Creo que no deberíamos haber venido a este sitio, Meemaw. Te debe traer recuerdos dolorosos."
    mc "Je ne pense pas que nous aurions dû venir ici, Mémé. Cela doit raviver de douloureux souvenirs."

# game/scripts/c26/c26.rpy:157
translate french c26s001_MeeDate_7d1c8a20:

    # mee "Tan dolorosos como cualquier otro de sus edificios. Este no es más especial que otros."
    mee "Aussi pénible que n'importe lequel de ses autres bâtiments. Celui-ci n'a rien de plus exceptionnel que les autres."

# game/scripts/c26/c26.rpy:158
translate french c26s001_MeeDate_4a461efb:

    # mee "Además, para mí es un sitio nuevo. No estaba acabado cuando John murió y nunca vine después."
    mee "De plus, c'est un endroit nouveau pour moi. Il n'était pas terminé lorsque John est décédé, et je n'y suis jamais retourné depuis."

# game/scripts/c26/c26.rpy:159
translate french c26s001_MeeDate_8aa83788_1:

    # mc "Pero..."
    mc "Mais..."

# game/scripts/c26/c26.rpy:162
translate french c26s001_MeeDate_e33e7362:

    # mee "Cuando a tu abuelo le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Quand on a diagnostiqué un cancer à ton grand-père, il m'a fait promettre que je reconstruirais ma vie sans lui."

# game/scripts/c26/c26.rpy:164
translate french c26s001_MeeDate_4ca1d8d2:

    # mee "Cuando a John le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Quand on a diagnostiqué un cancer à John, il m'a fait promettre que je reconstruirais ma vie sans lui."

# game/scripts/c26/c26.rpy:165
translate french c26s001_MeeDate_5bea8fa1:

    # mee "He tardado 23 años. Y un sitio que diseñó él me parece un buen lugar para empezar."
    mee "Cela m'a pris 23 ans. Et un site qu'il a conçu me semble un bon point de départ."

# game/scripts/c26/c26.rpy:166
translate french c26s001_MeeDate_85439d39:

    # mc "No creo que hayas tardado 23 años. Has vivido una vida plena todos esos años."
    mc "Je ne crois pas que cela vous ait pris 23 ans. Vous avez vécu une vie bien remplie pendant toutes ces années."

# game/scripts/c26/c26.rpy:167
translate french c26s001_MeeDate_0a6f7cf6:

    # mc "Estar o no en una relación no debería ser la definición de reconstruir una vida."
    mc "Être en couple ou non ne devrait pas définir la reconstruction d'une vie."

# game/scripts/c26/c26.rpy:169
translate french c26s001_MeeDate_bd7cf37a:

    # mee "Ah, OK. Entonces ya nos podemos ir. *Risa*"
    mee "Ah, d'accord. Alors on peut y aller. *Rires*"

# game/scripts/c26/c26.rpy:170
translate french c26s001_MeeDate_5b15d382:

    # mc "Lo estoy diciendo en serio."
    mc "Je suis sérieux."

# game/scripts/c26/c26.rpy:172
translate french c26s001_MeeDate_0d8d6878:

    # mee "Yo también, [mc]. Hasta ahora había pensado que estaba viviendo una buena vida, pero estos últimos días..."
    mee "Moi aussi, [mc]. Jusqu'à présent, je pensais mener une belle vie, mais ces derniers jours..."

# game/scripts/c26/c26.rpy:173
translate french c26s001_MeeDate_0d9728e8:

    # mee "Me han hecho recuperar una ilusión que no recordaba, si es que alguna vez la he tenido."
    mee "Ils ont ravivé un espoir que j'avais oublié, si tant est que j'en aie jamais eu un."

# game/scripts/c26/c26.rpy:175
translate french c26s001_MeeDate_056ce8f9:

    # mc "Con el abuelo la tendrías, ¿no?"
    mc "Tu en aurais fait autant avec ton grand-père, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:177
translate french c26s001_MeeDate_6a446d59:

    # mc "Con John la tendrías, ¿no?"
    mc "Avec John, tu l'aurais, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:179
translate french c26s001_MeeDate_521da6e2:

    # mee "Era diferente. Todo se desarrolló muy rápido..."
    mee "C'était différent. Tout s'est développé très vite..."

# game/scripts/c26/c26.rpy:180
translate french c26s001_MeeDate_511397d9:

    # mee "[bet] me dijo que te explicó nuestra historia, con lo que ya lo sabes."
    mee "[bet] m'a dit qu'il t'avait expliqué notre histoire, donc tu le sais déjà."

# game/scripts/c26/c26.rpy:182
translate french c26s001_MeeDate_41f1f948:

    # mee "No había sentimiento de anticipación después del fin de semana en el que nos conocimos."
    mee "Il n'y avait aucun sentiment d'attente après le week-end où nous nous sommes rencontrés."

# game/scripts/c26/c26.rpy:184
translate french c26s001_MeeDate_e3224f3c:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener hijos..."
    mee "Tout semblait se dérouler naturellement. Se rencontrer, se marier, avoir des enfants…"

# game/scripts/c26/c26.rpy:186
translate french c26s001_MeeDate_45784042:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener a [nor]..."
    mee "Tout semblait se dérouler naturellement. Se rencontrer, se marier, avoir des enfants…"

# game/scripts/c26/c26.rpy:187
translate french c26s001_MeeDate_bf512acf:

    # mc "Y lo que está pasando ahora es diferente, ¿no?"
    mc "Et ce qui se passe maintenant est différent, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:189
translate french c26s001_MeeDate_30ccb98f:

    # mee "Lo es. Es muy diferente. No vamos a tener hijos. No creo que los quisiera a mi edad aunque pudiera."
    mee "Oui, c'est très différent. Nous n'aurons pas d'enfants. Je ne pense pas en vouloir à mon âge, même si je le pouvais."

# game/scripts/c26/c26.rpy:191
translate french c26s001_MeeDate_f83019ab:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que tu madre ahora!"
    mee "Je te connais depuis ta naissance. Nom de Dieu, j'étais plus vieux à ta naissance que ta mère ne l'est aujourd'hui !"

# game/scripts/c26/c26.rpy:193
translate french c26s001_MeeDate_d20de51a:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que [mar] ahora!"
    mee "Je te connais depuis ta naissance. Bon sang, j'étais plus vieux à ta naissance qu'aujourd'hui !"

# game/scripts/c26/c26.rpy:194
translate french c26s001_MeeDate_3283d3bc:

    # mc "Tenías la edad de [nor]..."
    mc "Tu avais l'âge de [nor]..."

# game/scripts/c26/c26.rpy:196
translate french c26s001_MeeDate_4cb3b6e2:

    # mee "Sí. Exactamente la misma edad que [nor] tiene ahora."
    mee "Oui. Exactement le même âge que [nor] actuellement."

# game/scripts/c26/c26.rpy:197
translate french c26s001_MeeDate_50252c25:

    # mee "Y no es... natural... que tú y yo estemos juntos."
    mee "Et ce n'est pas... naturel... pour toi et moi d'être ensemble."

# game/scripts/c26/c26.rpy:199
translate french c26s001_MeeDate_07ee4791:

    # mee "Aunque no renunciaría a ello por nada ni por nadie. Me da lo mismo lo que puedan pensar los demás."
    mee "Même si je ne l'échangerais pour rien au monde ni pour personne. Je me fiche de ce que les autres peuvent penser."

# game/scripts/c26/c26.rpy:200
translate french c26s001_MeeDate_ba3e2b07:

    # mc "Yo tampoco renunciaría a esto."
    mc "Je n'y renoncerais pas non plus."

# game/scripts/c26/c26.rpy:202
translate french c26s001_MeeDate_cd488b7f:

    # mee "*Risa* ¿Aunque me guste el bacon canadiense?"
    mee "*Rires* Même si j'aime le bacon canadien ?"

# game/scripts/c26/c26.rpy:203
translate french c26s001_MeeDate_c68ede67:

    # mc "*Risa* Aunque te guste el bacon canadiense."
    mc "*Rires* Même si vous aimez le bacon canadien."

# game/scripts/c26/c26.rpy:205
translate french c26s001_MeeDate_a143917f:

    # mee "Pero hablando en serio, me encanta lo que ha pasado entre nosotros en los últimos días."
    mee "Plus sérieusement, j'adore ce qui s'est passé entre nous ces derniers jours."

# game/scripts/c26/c26.rpy:206
translate french c26s001_MeeDate_14dd0f5d:

    # mee "Me encanta no saber qué va a pasar la siguiente vez que estemos juntos. Me encanta ese sentimiento de anticipación."
    mee "J'adore ne pas savoir ce qui va se passer la prochaine fois qu'on se verra. J'adore cette sensation d'anticipation."

# game/scripts/c26/c26.rpy:207
translate french c26s001_MeeDate_f9a83ae8:

    # mc "Pasará lo que queramos que pase. No hay nadie poniendo límites."
    mc "Tout ce que nous souhaitons se réalisera. Personne ne fixe de limites."

# game/scripts/c26/c26.rpy:209
translate french c26s001_MeeDate_1a6713c0:

    # mee "*Risa* Sí que lo hay. Yo. No quiero descubrir todo lo que somos capaces de hacer en nuestra primera noche."
    mee "*Rires* Oui, il y en a une. Moi. Je ne veux pas découvrir tout ce dont nous sommes capables dès notre première nuit."

# game/scripts/c26/c26.rpy:210
translate french c26s001_MeeDate_5771e687:

    # mee "No quiero que ese sentimiento de anticipación desaparezca."
    mee "Je ne veux pas que ce sentiment d'anticipation disparaisse."

# game/scripts/c26/c26.rpy:211
translate french c26s001_MeeDate_1d35912a:

    # mc "No tiene por qué desaparecer. Siempre podemos inventar cosas nuevas que hacer."
    mc "Cela n'a pas à disparaître. Nous pouvons toujours inventer de nouvelles choses à faire."

# game/scripts/c26/c26.rpy:213
translate french c26s001_MeeDate_b4196dd9:

    # mc "Por ejemplo, helado. Estaba bueno."
    mc "Par exemple, la glace. C'était bon."

# game/scripts/c26/c26.rpy:215
translate french c26s001_MeeDate_b74870ab:

    # mee "¿Ya lo has probado?"
    mee "L'avez-vous déjà essayé ?"

# game/scripts/c26/c26.rpy:216
translate french c26s001_MeeDate_ea9e253c:

    # mc "Justo antes de ir a buscarte. Era tentador."
    mc "Juste avant de venir te chercher. C'était tentant."

# game/scripts/c26/c26.rpy:217
translate french c26s001_MeeDate_35bd7889:

    # mee "¿Qué te ha parecido? ¿Te ha gustado? Esperaba ser la primera en hacerlo."
    mee "Qu'en avez-vous pensé ? Avez-vous aimé ? J'espérais être le premier à le faire."

# game/scripts/c26/c26.rpy:218
translate french c26s001_MeeDate_d91826e5:

    # mc "Estaba bueno. No he notado mucha diferencia con el helado normal."
    mc "C'était bon. Je n'ai pas remarqué de grande différence avec une glace classique."

# game/scripts/c26/c26.rpy:219
translate french c26s001_MeeDate_bdd5010c:

    # mc "Pero volviendo al sentimiento de anticipación..."
    mc "Mais revenons à ce sentiment d'anticipation..."

# game/scripts/c26/c26.rpy:221
translate french c26s001_MeeDate_e03cbced:

    # mee "¿Qué crees que pasará esta noche?"
    mee "À votre avis, que va-t-il se passer ce soir ?"

# game/scripts/c26/c26.rpy:222
translate french c26s001_MeeDate_2d8c85ca:

    # mc "¡Qué directa! *Risa*"
    mc "Quelle franchise ! *Rires*"

# game/scripts/c26/c26.rpy:223
translate french c26s001_MeeDate_0c2e6399:

    # mc "Creo que vamos a seguir disfrutando de una bonita cena."
    mc "Je pense que nous allons continuer à profiter d'un bon dîner."

# game/scripts/c26/c26.rpy:225
translate french c26s001_MeeDate_e0402574:

    # mee "¡No me refiero a eso! *Risa* Sabes a lo que me refiero."
    mee "Je ne veux pas dire ça ! *Rires* Vous savez ce que je veux dire."

# game/scripts/c26/c26.rpy:226
translate french c26s001_MeeDate_40fb7c8b:

    # mc "¿Te refieres a cuando me quede a dormir en tu habitación?"
    mc "Vous voulez dire quand j'ai passé la nuit dans votre chambre ?"

# game/scripts/c26/c26.rpy:227
translate french c26s001_MeeDate_446c0699:

    # mc "Pues que tendré que ir a por un pijama a la mía primero."
    mc "Bon, il faut d'abord que j'aille chercher un pyjama dans mon magasin."

# game/scripts/c26/c26.rpy:229
translate french c26s001_MeeDate_6a457054:

    # mee "Había oído que dormías desnudo..."
    mee "J'ai entendu dire que tu dormais nu..."

# game/scripts/c26/c26.rpy:230
translate french c26s001_MeeDate_c65cfc16:

    # mc "Por norma sí, pero no sé si querrás que lo haga."
    mc "En règle générale, oui, mais je ne sais pas si vous le souhaiteriez."

# game/scripts/c26/c26.rpy:231
translate french c26s001_MeeDate_287f90ba:

    # mee "Por mí no hace falta que duermas con más ropa de la que sueles usar."
    mee "Pour moi, il n'est pas nécessaire de dormir avec plus de vêtements que d'habitude."

# game/scripts/c26/c26.rpy:232
translate french c26s001_MeeDate_d2756205:

    # mc "¿Y tú? ¿Cómo duermes?"
    mc "Et vous ? Comment dormez-vous ?"

# game/scripts/c26/c26.rpy:234
translate french c26s001_MeeDate_b4b4ad67:

    # mee "Por norma con un pijama. Pero hoy... esperaba que me dieras calor suficiente como para no necesitarlo."
    mee "D'habitude, je porte un pyjama. Mais aujourd'hui... j'espérais que tu me tiendrais suffisamment chaud pour que je n'en aie pas besoin."

# game/scripts/c26/c26.rpy:235
translate french c26s001_MeeDate_038a732f:

    # mc "Me siento un hombre objeto usado como si fuera una mera bolsa de agua caliente. *Risa*"
    mc "J'ai l'impression d'être un homme objectifié, utilisé comme une simple bouillotte. *Rires*"

# game/scripts/c26/c26.rpy:236
translate french c26s001_MeeDate_ac2c5c33:

    # mc "Pero me parece una buena idea. No vamos a ver nada que no hayamos visto con anterioridad."
    mc "Mais je pense que c'est une bonne idée. On ne verra rien de nouveau."

# game/scripts/c26/c26.rpy:237
translate french c26s001_MeeDate_f2bafc07:

    # mc "¿Lado derecho o izquierdo de la cama?"
    mc "Côté droit ou côté gauche du lit ?"

# game/scripts/c26/c26.rpy:239
translate french c26s001_MeeDate_bb0d87ac:

    # mee "Derecho. Y no pienso ceder sobre eso, al menos en mi cama."
    mee "Exactement. Et je n'ai pas l'intention de céder là-dessus, du moins pas dans mon lit."

# game/scripts/c26/c26.rpy:240
translate french c26s001_MeeDate_6279dea7:

    # mc "*Risa* No hace falta que cedas. Yo duermo en el centro o en la izquierda."
    mc "*Rires* Tu n'es pas obligé de céder. Je dors au milieu ou à gauche."

# game/scripts/c26/c26.rpy:241
translate french c26s001_MeeDate_24a618e2:

    # mc "Nuestra primera discusión como pareja no va a ser sobre el lado de la cama en el que dormimos."
    mc "Notre première dispute de couple ne portera pas sur le côté du lit où nous dormons."

# game/scripts/c26/c26.rpy:243
translate french c26s001_MeeDate_385d9d9c:

    # mee "Pero sabes que llegará tarde o temprano, ¿verdad? Un día discutiremos."
    mee "Mais tu sais bien que ça arrivera tôt ou tard, n'est-ce pas ? On finira par se disputer."

# game/scripts/c26/c26.rpy:244
translate french c26s001_MeeDate_6d613ec8:

    # mc "Estoy seguro de que lo hará, pero ese puente habrá que cruzarlo en su momento. No es necesario pensar en ese puente cuando ni siquiera sabemos que río atraviesa."
    mc "J'en suis sûr, mais on verra bien. Inutile d'y penser maintenant qu'on ignore même de quel fleuve il s'agit."

# game/scripts/c26/c26.rpy:246
translate french c26s001_MeeDate_14d0ba4f:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde tu abuelo..."
    mee "Tu as raison. Je m'inquiète trop, mais je n'ai été avec personne depuis ton grand-père..."

# game/scripts/c26/c26.rpy:248
translate french c26s001_MeeDate_268b26d5:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde John..."
    mee "Tu as raison. Je m'inquiète trop, mais je n'ai été avec personne depuis John..."

# game/scripts/c26/c26.rpy:249
translate french c26s001_MeeDate_91f7a39a:

    # mc "Si te sirve de algo, Tía [bet] dijo que me parecía mucho a él. A lo mejor las discusiones son parecidas."
    mc "Si ça peut te rassurer, ma tante [bet] a dit que je lui ressemblais beaucoup. Nos disputes sont peut-être similaires."

# game/scripts/c26/c26.rpy:251
translate french c26s001_MeeDate_274a0851:

    # mee "*Risa* Te pareces a él en algunas cosas, pero hay más diferencias que similitudes."
    mee "*Rires* Tu lui ressembles par certains aspects, mais il y a plus de différences que de similitudes."

# game/scripts/c26/c26.rpy:252
translate french c26s001_MeeDate_ae926927:

    # mc "¿Por ejemplo?"
    mc "Par exemple?"

# game/scripts/c26/c26.rpy:254
translate french c26s001_MeeDate_20d01048:

    # mee "Tu eres más directo y asertivo cuando quieres algo. Él le daba vueltas y más vueltas hasta que ya no recordabas de quién había sido la idea original."
    mee "Tu es plus direct et affirmé quand tu veux quelque chose. Il tournait en rond jusqu'à ce que tu ne te souviennes même plus de qui avait eu l'idée au départ."

# game/scripts/c26/c26.rpy:255
translate french c26s001_MeeDate_c7669102:

    # mc "Bueno, creo que los rodeos innecesarios son... innecesarios."
    mc "Eh bien, je pense que les détours inutiles sont… inutiles."

# game/scripts/c26/c26.rpy:257
translate french c26s001_MeeDate_a54c5d48:

    # mee "Después está vuestro concepto de familia. Es muy diferente."
    mee "Et puis il y a votre conception de la famille. C'est très différent."

# game/scripts/c26/c26.rpy:258
translate french c26s001_MeeDate_1c8fc493:

    # mc "Tía [bet] me dijo lo contrario, que los dos aceptábamos a todo el mundo en la familia."
    mc "Ma tante [bet] m'a dit le contraire, que nous acceptions tous les deux tout le monde dans la famille."

# game/scripts/c26/c26.rpy:259
translate french c26s001_MeeDate_11873b42:

    # mee "Ahí está la diferencia. Tú aceptas a todo el mundo en la familia."
    mee "Voilà la différence. Vous acceptez tout le monde dans la famille."

# game/scripts/c26/c26.rpy:260
translate french c26s001_MeeDate_981a38ec:

    # mee "El daba la bienvenida a todo el mundo a {b}nuestra{/b} familia. Nosotros siempre íbamos a ser el centro de esa familia extendida."
    mee "Il a accueilli tout le monde dans notre famille. Nous serions toujours au centre de cette famille élargie."

# game/scripts/c26/c26.rpy:261
translate french c26s001_MeeDate_5b43c1a9:

    # mee "Quien quisiera unirse debía adaptarse a nosotros. Tú permites que cada cual siga siendo como es."
    mee "Quiconque souhaitait nous rejoindre devait s'adapter à nous. Vous permettez à chacun de rester tel qu'il est."

# game/scripts/c26/c26.rpy:262
translate french c26s001_MeeDate_40ddff33:

    # mc "Es que la familia no es mía. Es de todos. Los de siempre y los nuevos."
    mc "En fait, la famille n'appartient pas qu'à moi. Elle appartient à tous. À ceux qui ont toujours été là et à ceux qui sont arrivés récemment."

# game/scripts/c26/c26.rpy:264
translate french c26s001_MeeDate_a3d32e63:

    # mee "¿Puedes ver la diferencia? Tú no quieres ser el centro de la familia ni imponer normas."
    mee "Vous voyez la différence ? Vous ne voulez pas être le centre de la famille ni imposer des règles."

# game/scripts/c26/c26.rpy:265
translate french c26s001_MeeDate_64ee2e3f:

    # mee "Para él, la familia era nuestra, suya y mía."
    mee "Pour lui, la famille, c'était la nôtre, la sienne et la mienne."

# game/scripts/c26/c26.rpy:267
translate french c26s001_MeeDate_57807ca8:

    # mee "Y de nuestros hijos más tarde."
    mee "Et plus tard, nos enfants."

# game/scripts/c26/c26.rpy:269
translate french c26s001_MeeDate_2491ac7c:

    # mee "Y de [nor] más tarde."
    mee "Et à partir de [nor] plus tard."

# game/scripts/c26/c26.rpy:270
translate french c26s001_MeeDate_6a4e5029:

    # mee "Pero si alguien más quería ser parte de la familia, lo tenía que hacer bajo nuestras condiciones."
    mee "Mais si quelqu'un d'autre voulait faire partie de la famille, il devait le faire selon nos conditions."

# game/scripts/c26/c26.rpy:271
translate french c26s001_MeeDate_6e5d5b3a:

    # mc "Supongo que son otros tiempos y el concepto de familia ha cambiado. No hay que juzgarle en base a nuestros valores actuales."
    mc "J'imagine que les temps ont changé et que la notion de famille a évolué. Nous ne devrions pas le juger selon nos valeurs actuelles."

# game/scripts/c26/c26.rpy:273
translate french c26s001_MeeDate_4110b322:

    # mee "No le estoy juzgando, [mc]. Sólo digo que es un aspecto importante en el que sois diferentes. Ni mejores ni peores."
    mee "Je ne le juge pas, [mc]. Je dis simplement que c'est un point important sur lequel vous êtes différents. Ni meilleur ni pire."

# game/scripts/c26/c26.rpy:274
translate french c26s001_MeeDate_990d0171:

    # mee "Como has dicho, eran otros tiempos. El poliamor o los harenes eran cosas... raras."
    mee "Comme vous l'avez dit, c'était une autre époque. Le polyamour et les harems étaient… des choses étranges."

# game/scripts/c26/c26.rpy:276
translate french c26s001_MeeDate_f5eccc60:

    # mc "¿Cómo te sientes al formar parte de un harén? Supongo que no debe de ser fácil para ti."
    mc "Qu'est-ce que ça fait de faire partie d'un harem ? J'imagine que ça ne doit pas être facile pour vous."

# game/scripts/c26/c26.rpy:278
translate french c26s001_MeeDate_e4426ebc:

    # mee "No he pensado mucho en ello. Siempre me había parecido algo... tercermundista... con un macho dominante y unas mujeres sumisas, quizás contra su voluntad."
    mee "Je n'y ai pas vraiment réfléchi. Ça m'a toujours paru… digne du tiers-monde… avec un homme dominant et des femmes soumises, peut-être même contre leur gré."

# game/scripts/c26/c26.rpy:279
translate french c26s001_MeeDate_ef81bc07:

    # mee "Yo también soy de otros tiempos..."
    mee "Je viens d'une autre époque aussi..."

# game/scripts/c26/c26.rpy:280
translate french c26s001_MeeDate_868910ac:

    # mee "Pero lo que tú has construido no tiene nada que ver con eso. Se ha creado de una forma natural. Lo has hecho muy bien."
    mee "Mais ce que vous avez construit n'a rien à voir avec ça. C'est apparu naturellement. Vous avez fait un excellent travail."

# game/scripts/c26/c26.rpy:281
translate french c26s001_MeeDate_c6217544:

    # mc "Gracias, pero supongo que hay un 'pero'."
    mc "Merci, mais il y a un « mais »."

# game/scripts/c26/c26.rpy:305
translate french c26s001_MeeDate_d11b5e72:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hermana."
    mee "*Rires* C'est bizarre de partager un homme avec ma sœur."

# game/scripts/c26/c26.rpy:308
translate french c26s001_MeeDate_96313940:

    # mee "O con mis hijas..."
    mee "Ou avec mes filles..."

# game/scripts/c26/c26.rpy:310
translate french c26s001_MeeDate_2a85f530:

    # mee "O con una de mis hijas..."
    mee "Ou avec une de mes filles..."

# game/scripts/c26/c26.rpy:313
translate french c26s001_MeeDate_b9945fa1:

    # mee "O con mi hija..."
    mee "Ou avec ma fille..."

# game/scripts/c26/c26.rpy:315
translate french c26s001_MeeDate_2dd9104d:

    # mee "O con mis nietas..."
    mee "Ou avec mes petites-filles..."

# game/scripts/c26/c26.rpy:317
translate french c26s001_MeeDate_bfa3b927:

    # mee "O con una de mis nietas..."
    mee "Ou avec l'une de mes petites-filles..."

# game/scripts/c26/c26.rpy:322
translate french c26s001_MeeDate_48cebf41:

    # mee "*Risa* Se me hace extraño compartir hombre con mis hijas."
    mee "*Rires* C'est étrange de partager un homme avec mes filles."

# game/scripts/c26/c26.rpy:324
translate french c26s001_MeeDate_de2865f9:

    # mee "*Risa* Se me hace extraño compartir hombre con una de mis hijas."
    mee "*Rires* C'est bizarre de partager un homme avec une de mes filles."

# game/scripts/c26/c26.rpy:326
translate french c26s001_MeeDate_2dd9104d_1:

    # mee "O con mis nietas..."
    mee "Ou avec mes petites-filles..."

# game/scripts/c26/c26.rpy:328
translate french c26s001_MeeDate_bfa3b927_1:

    # mee "O con una de mis nietas..."
    mee "Ou avec l'une de mes petites-filles..."

# game/scripts/c26/c26.rpy:331
translate french c26s001_MeeDate_a96ad341:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hija."
    mee "*Rires* C'est bizarre de partager un homme avec ma fille."

# game/scripts/c26/c26.rpy:333
translate french c26s001_MeeDate_2dd9104d_2:

    # mee "O con mis nietas..."
    mee "Ou avec mes petites-filles..."

# game/scripts/c26/c26.rpy:335
translate french c26s001_MeeDate_bfa3b927_2:

    # mee "O con una de mis nietas..."
    mee "Ou avec l'une de mes petites-filles..."

# game/scripts/c26/c26.rpy:339
