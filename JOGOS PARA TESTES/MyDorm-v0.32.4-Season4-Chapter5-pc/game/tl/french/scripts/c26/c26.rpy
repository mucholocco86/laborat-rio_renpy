# game/scripts/c26/c26.rpy:1276
translate french c26s002_EriDapSca_364dd5da:

    # sca "Quiero contribuir en algo a la familia. Estoy aquí sin hacer nada hasta que empiecen las clases..."
    sca "Je veux contribuer aux finances de ma famille. Je reste là à ne rien faire en attendant la rentrée..."

# game/scripts/c26/c26.rpy:1277
translate french c26s002_EriDapSca_4648c288:

    # mc "Pero [dap] y tú ibais a venir a Aruba conmigo, ¿no?"
    mc "Mais [dap] et toi deviez venir à Aruba avec moi, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:1279
translate french c26s002_EriDapSca_f4920ea7:

    # sca "Si encuentro un trabajo, no podré ir. Ya habrá más oportunidades más tarde."
    sca "Si je trouve un emploi, je ne pourrai pas partir. Il y aura d'autres opportunités plus tard."

# game/scripts/c26/c26.rpy:1280
translate french c26s002_EriDapSca_be042856:

    # mc "No creo que sea necesario que contribuyas económicamente, [sca]."
    mc "Je ne pense pas qu'il soit nécessaire que vous contribuiez financièrement, [sca]."

# game/scripts/c26/c26.rpy:1281
translate french c26s002_EriDapSca_b1d2bfba:

    # mc "Eres de la familia y no tienes que pagar alquiler. Si [emm] no lo paga..."
    mc "Vous êtes de la famille et vous n'avez pas à payer de loyer. Si [emm] ne le paie pas..."

# game/scripts/c26/c26.rpy:1283
translate french c26s002_EriDapSca_c05896e6:

    # emm "*Risa* Ahora podría pagarlo."
    emm "*Rires* Maintenant, je pourrais me le permettre."

# game/scripts/c26/c26.rpy:1285
translate french c26s002_EriDapSca_52127a86:

    # emm "[lis], [deb.nick], [kat], [sai], y [kim] también son de la familia y pagan por su alojamiento." id c26s002_EriDapSca_52127a86
    emm "[lis], [deb.nick], [kat], [sai] et [kim] sont également de la famille et paient leur hébergement." id c26s002_EriDapSca_52127a86

# game/scripts/c26/c26.rpy:1286
translate french c26s002_EriDapSca_4cbc63a0:

    # emm "No sé si deberíamos hacer algo al respecto."
    emm "Je ne sais pas si nous devrions faire quelque chose à ce sujet."

# game/scripts/c26/c26.rpy:1287
translate french c26s002_EriDapSca_af63fdad:

    # mc "Creo que eso lo deberíamos comentar con Mamá y con Tía [nor]. La verdad es que es raro..."
    mc "Je pense qu'on devrait en parler à maman et à tante. C'est vraiment bizarre..."

# game/scripts/c26/c26.rpy:1289
translate french c26s002_EriDapSca_e954a25a:

    # eri "De todas formas, [sca], no voy a dejar el trabajo en el café hasta que empiecen las clases."
    eri "Bref, [sca], je ne vais pas laisser mon travail au café avant le début des cours."

# game/scripts/c26/c26.rpy:1290
translate french c26s002_EriDapSca_796b9b79:

    # mc "¿Por qué? Ahora no necesitas el dinero..."
    mc "Pourquoi ? Tu n'as pas besoin d'argent maintenant..."

# game/scripts/c26/c26.rpy:1292
translate french c26s002_EriDapSca_8cca8bf3:

    # eri "Creo que ya sé en qué voy a gastar ese dinero, con lo que voy a estar en la misma situación."
    eri "Je pense savoir déjà comment je vais dépenser cet argent, donc je serai dans la même situation."

# game/scripts/c26/c26.rpy:1293
translate french c26s002_EriDapSca_9bd83e03:

    # mc "¿En qué?"
    mc "Dans quoi ?"

# game/scripts/c26/c26.rpy:1294
translate french c26s002_EriDapSca_e3047add:

    # eri "Lo tengo que confirmar todavía. Pero, de momento, no voy a dejar mi trabajo."
    eri "Je dois encore le confirmer. Mais pour l'instant, je ne vais pas démissionner."

# game/scripts/c26/c26.rpy:1296
translate french c26s002_EriDapSca_2996b4c3:

    # eri "[sca], igualmente le puedo decir a mi jefe que buscas trabajo para un mes. El chico que contrató para sustituir a Jack no está funcionando bien."
    eri "[sca], je peux aussi dire à mon patron que tu cherches un emploi d'un mois. Le type qu'il a embauché pour remplacer Jack n'est pas performant."

# game/scripts/c26/c26.rpy:1297
translate french c26s002_EriDapSca_31fc7bbf:

    # eri "Si al final lo despide, podríamos trabajar juntas [eil], tú, y yo."
    eri "S'il finit par le licencier, on pourrait travailler ensemble [eil], toi et moi."

# game/scripts/c26/c26.rpy:1299
translate french c26s002_EriDapSca_b11f4e4e:

    # sca "¡Oh! ¡Eso sería fantástico!"
    sca "Oh ! Ce serait fantastique !"

# game/scripts/c26/c26.rpy:1301
translate french c26s002_EriDapSca_07a07b95:

    # sca "Bueno, no por el pobre chico, pero..."
    sca "Enfin, pas pour le bien de ce pauvre enfant, mais..."

# game/scripts/c26/c26.rpy:1302
translate french c26s002_EriDapSca_6d1b050d:

    # mc "*Risa* Creo que te hemos entendido."
    mc "*Rires* Je crois que nous vous comprenons."

# game/scripts/c26/c26.rpy:1304
translate french c26s002_EriDapSca_af5d598b:

    # dap "¿Crees que podemos gastar algo de ese dinero, [mc]?"
    dap "Penses-tu que nous pourrions dépenser une partie de cet argent, [mc] ?"

# game/scripts/c26/c26.rpy:1305
translate french c26s002_EriDapSca_48644824:

    # mc "Una vez que [ama] ha confirmado que viene de NTR, creo que sí. Pero no os lo gastéis todo."
    mc "Une fois que [ama] a confirmé que ça vient de NTR, je le pense aussi. Mais ne dépense pas tout."

# game/scripts/c26/c26.rpy:1306
translate french c26s002_EriDapSca_99e2867d:

    # mc "Es un pago anual, con lo que os lo vais a tener que administrar durante un año."
    mc "Il s'agit d'un paiement annuel, vous devrez donc le gérer pendant un an."

# game/scripts/c26/c26.rpy:1308
translate french c26s002_EriDapSca_9b64bd31:

    # emm "¿Quieres decir que Mamá dejará de darme la paga semanal?"
    emm "Tu veux dire que maman va arrêter de me donner mon argent de poche hebdomadaire ?"

# game/scripts/c26/c26.rpy:1309
translate french c26s002_EriDapSca_e30ad040:

    # mc "No es que lo crea. Le voy a proponer que deje de hacerlo. Ahora tienes tu propio dinero y tienes que aprender a administrarlo."
    mc "Ce n'est pas que j'y croie. Je te suggère simplement d'arrêter. Maintenant, tu as ton propre argent et tu dois apprendre à le gérer."

# game/scripts/c26/c26.rpy:1311
translate french c26s002_EriDapSca_5b2e29e9:

    # emm "¡Pero eso es injusto! Ella seguramente también lo ha cobrado..."
    emm "Mais c'est injuste ! Elle a probablement été payée aussi..."

# game/scripts/c26/c26.rpy:1312
translate french c26s002_EriDapSca_b29874c5:

    # mc "Y ella se ocupa de todos los gastos de la casa. No seas egoísta, [emm]."
    mc "Et elle prend en charge toutes les dépenses du ménage. Ne sois pas égoïste."

# game/scripts/c26/c26.rpy:1314
translate french c26s002_EriDapSca_f8be4405:

    # emm "Tienes razón. Le preguntaré si necesita algo..."
    emm "Vous avez raison. Je lui demanderai s'il a besoin de quelque chose..."

# game/scripts/c26/c26.rpy:1315
translate french c26s002_EriDapSca_ebd8fc29:

    # emm "Voy a buscarla para darle la noticia."
    emm "Je vais la retrouver pour lui annoncer la nouvelle."

# game/scripts/c26/c26.rpy:1317
translate french c26s002_EriDapSca_53462aa3:

    # dap "[sca], vamos a nuestra habitación. Creo que tenemos que renovar tu portátil."
    dap "[sca], allons dans notre chambre. Je pense qu'il faut mettre à jour ton ordinateur portable."

# game/scripts/c26/c26.rpy:1318
translate french c26s002_EriDapSca_e03687a5:

    # mcp "(La primera compra que hace es para [sca]. [dap] es maravillosa.)"
    mcp "(Son premier achat concerne [sca]. [dap] est merveilleux.)"

# game/scripts/c26/c26.rpy:1320
translate french c26s002_EriDapSca_c6c43322:

    # sca "¿Qué? ¿Por qué? El mío aún puede durar..."
    sca "Quoi ? Pourquoi ? Le mien peut encore durer..."

# game/scripts/c26/c26.rpy:1321
translate french c26s002_EriDapSca_e050b987:

    # mc "[sca], tu portátil todavía tiene Doors 8. Creo que ya es hora de jubilarlo, y no digas que no a un regalo."
    mc "[sca], ton ordinateur portable a encore Doors 8. Je pense qu'il est temps de le remplacer, et ne refuse pas un cadeau."

# game/scripts/c26/c26.rpy:1322
translate french c26s002_EriDapSca_d29d73d6:

    # mc "Creo que le va a hacer más ilusión a [dap] comprártelo que a ti recibirlo."
    mc "Je pense que [dap] sera plus enthousiaste à l'idée de vous l'acheter que vous ne le serez à l'idée de le recevoir."

# game/scripts/c26/c26.rpy:1324
translate french c26s002_EriDapSca_bafa982c:

    # eri "Yo voy a hablar con Tía [bet] sobre unas cosas..."
    eri "Je vais parler à tante [bet] de certaines choses..."

# game/scripts/c26/c26.rpy:1326
translate french c26s002_EriDapSca_2ad05f94:

    # "Todas desaparecen y te quedas solo en la cocina."
    "Ils disparaissent tous et vous vous retrouvez seul dans la cuisine."

# game/scripts/c26/c26.rpy:1327
translate french c26s002_EriDapSca_e290d77b:

    # "Solo con tu hambre. Aún no has desayunado."
    "C'est simplement la faim. Vous n'avez pas encore pris votre petit-déjeuner."

# game/scripts/c26/c26.rpy:1329
translate french c26s002_EriDapSca_adf250ce:

    # "Pones remedio a esa situación."
    "Vous remédiez à cette situation."

# game/scripts/c26/c26.rpy:1338
translate french c26s003_Sai_2736c66c:

    # "Al acabar de desayunar, de camino a tu habitación."
    "Après le petit-déjeuner, en route vers votre chambre."

# game/scripts/c26/c26.rpy:1339
translate french c26s003_Sai_aef5aca0:

    # mc "Hola, [sai], ¿qué haces tan sola?"
    mc "Salut, [sai], que fais-tu tout seul ?"

# game/scripts/c26/c26.rpy:1340
translate french c26s003_Sai_4be64632:

    # sai "Les he mandado a mis padres unas fotos de la clase de tiro de ayer y estábamos chateando."
    sai "J'ai envoyé à mes parents quelques photos du cours de tir d'hier et nous avons discuté."

# game/scripts/c26/c26.rpy:1341
translate french c26s003_Sai_9a12bdab:

    # sai "Tenías que haber venido. Fue muy divertido."
    sai "Tu aurais dû venir. C'était tellement amusant."

# game/scripts/c26/c26.rpy:1342
translate french c26s003_Sai_31a2af1a:

    # mc "Me tienes que enseñar esas fotos."
    mc "Vous devez me montrer ces photos."

# game/scripts/c26/c26.rpy:1344
translate french c26s003_Sai_88877976:

    # sai "Siéntate conmigo un momento y te las enseño."
    sai "Asseyez-vous avec moi un instant et je vous les montrerai."

# game/scripts/c26/c26.rpy:1345
translate french c26s003_Sai_872c8558:

    # mc "¿No estabas chateando con tus padres?"
    mc "Tu n'étais pas en train de discuter avec tes parents ?"

# game/scripts/c26/c26.rpy:1347
translate french c26s003_Sai_6f0d13aa:

    # sai "Me había despedido justo antes de que llegaras."
    sai "Je vous avais dit au revoir juste avant votre arrivée."

# game/scripts/c26/c26.rpy:1348
translate french c26s003_Sai_7ca76543:

    # mc "Enséñame esas fotos, entonces."
    mc "Alors, montrez-moi ces photos."

# game/scripts/c26/c26.rpy:1350
translate french c26s003_Sai_a2fe9454:

    # sai "Mira, aquí estamos disparando las del primer turno. [eva] fue super estricta con la seguridad."
    sai "Regardez, on tire ici sur les photos du premier tour. [eva] était extrêmement strict en matière de sécurité."

# game/scripts/c26/c26.rpy:1351
translate french c26s003_Sai_0c7c59e8:

    # mc "Sí que lo es. Es parte de su entrenamiento. Al menos no os hizo poneros trajes raros como a mí."
    mc "Oui, c'est ça. Ça fait partie de son entraînement. Au moins, il ne vous a pas fait porter des tenues bizarres comme il me l'a fait."

# game/scripts/c26/c26.rpy:1353
translate french c26s003_Sai_7188f673:

    # sai "¿Cómo tuviste que vestirte?"
    sai "Qu'est-ce que tu devais porter ?"

# game/scripts/c26/c26.rpy:1354
translate french c26s003_Sai_3ddc6c80:

    # mc "Me llevó en la moto y me hizo ponerme un traje de skydiving. Era bastante incómodo."
    mc "Il m'a emmené sur sa moto et m'a fait enfiler une combinaison de parachutisme. C'était plutôt inconfortable."

# game/scripts/c26/c26.rpy:1356
translate french c26s003_Sai_45b01f20:

    # sai "*Risa* Lástima que no haya fotos de eso. Nosotras disparamos con la ropa que llevábamos."
    sai "*Rires* C'est dommage qu'il n'y ait pas de photos de ça. On a pris les photos avec les vêtements qu'on portait."

# game/scripts/c26/c26.rpy:1357
translate french c26s003_Sai_a427effe:

    # mc "No sé si os gustaría verme con ese traje. *Risa* A menos que fuera para reíros de mí, claro."
    mc "Je ne sais pas si vous aimeriez me voir dans ce costume. *Rires* À moins que ce soit pour se moquer de moi, bien sûr."

# game/scripts/c26/c26.rpy:1358
translate french c26s003_Sai_3f66c9f4:

    # mc "Vosotras estáis mucho mejor. Pero quiero ver más fotos."
    mc "Vous avez tous bien meilleure mine. Mais j'aimerais voir plus de photos."

# game/scripts/c26/c26.rpy:1360
translate french c26s003_Sai_35b1678f:

    # sai "Estas son las del segundo turno. Había seis puestos de tiro, y éramos diez, más [ama] y [eva], con lo que dos turnos fueron bien."
    sai "Voici les résultats du deuxième tour. Il y avait six positions de tir, et nous étions dix, plus [ama] et [eva], donc les deux premiers tours se sont bien déroulés."

# game/scripts/c26/c26.rpy:1361
translate french c26s003_Sai_c0ee93f2:

    # mc "¿Competíais entre vosotras?"
    mc "Étiez-vous en compétition l'un contre l'autre ?"

# game/scripts/c26/c26.rpy:1363
translate french c26s003_Sai_30964fc6:

    # sai "Quisimos hacerlo. [ama] dijo que no estaba bien para la primera lección, que era para aprender."
    sai "Nous voulions le faire. [ama] a dit que ce n'était pas approprié pour la première leçon, qui était consacrée à l'apprentissage."

# game/scripts/c26/c26.rpy:1364
translate french c26s003_Sai_a85d5a98:

    # sai "[emm] y yo insistimos, que era competir solo por diversión entre la familia."
    sai "[emm] et j'ai insisté sur le fait qu'il s'agissait simplement d'une compétition amicale en famille."

# game/scripts/c26/c26.rpy:1365
translate french c26s003_Sai_ecc79721:

    # sai "[eva] fue al último puesto de tiro, disparó siete veces, y dijo algo como '¿Estáis seguras de que queréis competir?'"
    sai "[eva] s'est rendu à la dernière position de tir, a tiré sept fois et a dit quelque chose comme : « Êtes-vous sûr de vouloir participer ? »"

# game/scripts/c26/c26.rpy:1366
translate french c26s003_Sai_942f5934:

    # mc "*Risa* Y se acabó la discusión."
    mc "*Rires* Et la discussion s'est arrêtée là."

# game/scripts/c26/c26.rpy:1368
translate french c26s003_Sai_aef86f6a:

    # sai "*Risa* Seis tiros dieron en el 10 y uno en el 9. 69 puntos."
    sai "*Rires* Six tirs ont atteint le 10 et un a atteint le 9. 69 points."

# game/scripts/c26/c26.rpy:1369
translate french c26s003_Sai_28be29c9:

    # mc "Es extraño que fallara uno."
    mc "C'est étrange que l'un d'eux ait échoué."

# game/scripts/c26/c26.rpy:1371
translate french c26s003_Sai_c58cbc6d:

    # sai "[ama] nos dijo luego que lo había hecho a propósito. Así, si alguien quería competir, tendría una oportunidad de superarla."
    sai "[ama] nous a avoué plus tard qu'elle l'avait fait exprès. Ainsi, si quelqu'un voulait la défier, il aurait une chance de la battre."

# game/scripts/c26/c26.rpy:1372
translate french c26s003_Sai_c2df0add:

    # mc "*Risa* Eso suena tan a... [eva]..."
    mc "*Rires* Ça a l'air tellement... [eva]..."

# game/scripts/c26/c26.rpy:1374
translate french c26s003_Sai_2b19abc7:

    # sai "Totalmente [eva]. Dejó clara su posición, pero dejó margen por si alguien quería competir de verdad."
    sai "Absolument. Il a clairement exprimé sa position, tout en laissant la porte ouverte à une éventuelle compétition."

# game/scripts/c26/c26.rpy:1375
translate french c26s003_Sai_9784ae30:

    # sai "Las que más se aceraron a su puntuación fueron [sam] y [kat], con 51 y 54 puntos. Ya habían disparado antes. Son muy buenas."
    sai "Les coups qui se sont le plus rapprochés de leur score étaient [sam] et [kat], avec respectivement 51 et 54 points. Ils avaient déjà été joués. Ils sont excellents."

# game/scripts/c26/c26.rpy:1376
translate french c26s003_Sai_dfd35ebf:

    # mc "¿Cuál fue tu puntuación?"
    mc "Quel était votre score ?"

# game/scripts/c26/c26.rpy:1378
translate french c26s003_Sai_364cea9c:

    # sai "*Risa* Unos horribles 23 puntos con siete disparos en mi mejor ronda. Y no fui la peor, pero no te diré quién fue."
    sai "*Rires* Un horrible 23 points avec sept coups lors de ma meilleure partie. Et je n'étais pas le pire, mais je ne vous dirai pas qui l'était."

# game/scripts/c26/c26.rpy:1379
translate french c26s003_Sai_4cd5359e:

    # mc "*Risa* Deberías decírmelo, para salir corriendo si alguna vez la veo con un arma."
    mc "*Rires* Tu devrais me le dire, comme ça je pourrai m'enfuir si jamais je la vois avec une arme."

# game/scripts/c26/c26.rpy:1381
translate french c26s003_Sai_fd7bd295:

    # sai "Mira, esta es la última foto, cuando habíamos acabado."
    sai "Regardez, voici la dernière photo, prise une fois que nous avons terminé."

# game/scripts/c26/c26.rpy:1382
translate french c26s003_Sai_6259fe7c:

    # mc "Me extraña mucho que [eva] y [ama] os dejaran posar con las pistolas..."
    mc "Je suis très surpris que [eva] et [ama] permettent de poser avec les pistolets..."

# game/scripts/c26/c26.rpy:1383
translate french c26s003_Sai_de78cf99:

    # sai "[emm] y [dap] querían que nos hiciéramos una foto en plan malotas. Tu madre insistió en que [ama] y [eva] revisaran todas las armas antes de la foto."
    sai "[emm] et [dap] voulaient qu'on prenne une photo en faisant les durs. Ta mère a insisté pour que [ama] et [eva] vérifient toutes les armes avant la photo."

# game/scripts/c26/c26.rpy:1384
translate french c26s003_Sai_1d1ba706:

    # mc "Pero no parecéis malotas. Estáis sonriendo todas. Quizás tú eres la que pareces más seria."
    mc "Mais vous n'avez pas l'air de mauvaises filles. Vous souriez toutes. Peut-être êtes-vous celle qui a l'air la plus sérieuse."

# game/scripts/c26/c26.rpy:1386
translate french c26s003_Sai_67daa2f2:

    # sai "*Risa* Eso es porque en la foto en plan malotas... parecíamos unas drogadictas con el mono."
    sai "*Rires* C'est parce que sur la photo, avec notre air dur... on ressemblait à des toxicomanes en plein sevrage."

# game/scripts/c26/c26.rpy:1387
translate french c26s003_Sai_acd3668e:

    # sai "Las únicas que quedaron bien fueron [kim] y [lis]. Es imposible que esas chicas queden mal en ninguna foto."
    sai "Les seules qui étaient belles étaient [kim] et [lis]. Impossible pour ces filles d'être laides sur une photo."

# game/scripts/c26/c26.rpy:1388
translate french c26s003_Sai_d4533b0a:

    # mc "*Risa* Quiero verla."
    mc "*Rires* Je veux la voir."

# game/scripts/c26/c26.rpy:1390
translate french c26s003_Sai_9684e979:

    # sai "*Risa* ¿No nos conoces aún? Esa foto fue borrada una milésima de segundo después de verla."
    sai "*Rires* Vous ne nous connaissez pas encore ? Cette photo a été supprimée une milliseconde après que nous l'ayons vue."

# game/scripts/c26/c26.rpy:1391
translate french c26s003_Sai_e7b1479f:

    # sai "Somos mujeres. No vamos a conservar una foto en la que salimos mal. Ni siquiera [lis] o [kim] la quisieron conservar."
    sai "Nous sommes des femmes. Nous n'allons pas garder une photo où nous avons mauvaise mine. Même [lis] et [kim] n'ont pas voulu la garder."

# game/scripts/c26/c26.rpy:1392
translate french c26s003_Sai_bb21b568:

    # mc "¡Qué consideradas! *Risa* Les tendré que preguntar a [ama] y a [eva] si había cámaras de seguridad."
    mc "Quelle délicatesse ! *Rires* Je vais devoir demander à [ama] et [eva] s'il y avait des caméras de sécurité."

# game/scripts/c26/c26.rpy:1394
translate french c26s003_Sai_9ed8bf3d:

    # sai "Aunque las hubiera, no te enseñarían las grabaciones."
    sai "Même si elles existaient, ils ne vous montreraient pas les enregistrements."

# game/scripts/c26/c26.rpy:1395
translate french c26s003_Sai_b3961c59:

    # mc "¿Por qué?"
    mc "Parce que?"

# game/scripts/c26/c26.rpy:1397
translate french c26s003_Sai_7f6d57b6:

    # sai "Primero porque era una cosa entre chicas. Segundo porque protegernos incluye destruir cualquier prueba de la existencia de esa foto. *Risa*"
    sai "Premièrement, parce que c'était un truc de filles. Deuxièmement, parce que se protéger, c'est aussi détruire toute preuve de l'existence de cette photo. *Rires*"

# game/scripts/c26/c26.rpy:1398
translate french c26s003_Sai_4a345483:

    # sai "Y, por último, porque ellas también quedaron mal. Pueden dar miedo cuando se ponen serias, pero cuando {b}fingen{/b} ser malotas... Quedaron horribles."
    sai "Enfin, ils ont aussi donné une mauvaise impression. Ils peuvent être intimidants quand ils sont sérieux, mais quand ils font semblant d'être durs… Ils étaient affreux."

# game/scripts/c26/c26.rpy:1399
translate french c26s003_Sai_6dab2001:

    # mc "*Risa* Lo entiendo."
    mc "*Rires* Je comprends."

# game/scripts/c26/c26.rpy:1401
translate french c26s003_Sai_5fe243aa:

    # sai "Seguramente hace una semana no les hubiera importado. ¿Ahora? Se están volviendo tan femeninas como el resto."
    sai "Il y a une semaine, cela leur aurait probablement été égal. Maintenant ? Elles deviennent aussi féminines que tout le monde."

# game/scripts/c26/c26.rpy:1402
translate french c26s003_Sai_d20aaa59:

    # sai "[eva] incluso está empezando a pedir consejos de belleza, aunque no los necesite. Me encanta esa evolución."
    sai "[eva] Elle commence même à demander des conseils beauté, alors qu'elle n'en a pas besoin. J'adore cette évolution."

# game/scripts/c26/c26.rpy:1403
translate french c26s003_Sai_b225fbf4:

    # mc "Es cierto. Sentirse arropadas por todas vosotras está haciendo que se abran más."
    mc "C'est vrai. Le fait de se sentir soutenus par vous tous les encourage à s'ouvrir davantage."

# game/scripts/c26/c26.rpy:1405
translate french c26s003_Sai_10a6266c:

    # "Te diriges a la cámara que sabes que una de las dos está mirando ahora mismo."
    "Vous vous dirigez vers la caméra que vous savez que l'un des deux regarde en ce moment même."

# game/scripts/c26/c26.rpy:1406
translate french c26s003_Sai_62d979c0:

    # mc "Bien hecho, chicas. Estoy orgulloso de vosotras."
    mc "Bravo les filles ! Je suis fière de vous."

# game/scripts/c26/c26.rpy:1407
translate french c26s003_Sai_6aba5db1:

    # "Te puedes imaginar que, en algún lugar de la base, suena una risita."
    "On peut imaginer que, quelque part dans les profondeurs de la base, un petit rire se fait entendre."

# game/scripts/c26/c26.rpy:1409
translate french c26s003_Sai_a0e077e5:

    # sai "A veces me olvido de que ven y escuchan todo lo que hacemos fuera de las habitaciones y los baños."
    sai "Parfois, j'oublie qu'ils voient et entendent tout ce que nous faisons en dehors des chambres et des salles de bains."

# game/scripts/c26/c26.rpy:1410
translate french c26s003_Sai_38d5c048:

    # mc "Es fácil olvidarse. Pero de todas formas, no importa. Creo que, cuando nos escuchan hablar de ellas, tienen que pasar la mitad del tiempo ruborizándose."
    mc "C'est facile à oublier. Mais bon, peu importe. Je pense que quand ils nous entendent parler d'eux, ils doivent passer la moitié du temps à rougir."

# game/scripts/c26/c26.rpy:1411
translate french c26s003_Sai_06cb7834:

    # mc "Aún no he oído a nadie decir nada malo de ellas."
    mc "Je n'ai encore entendu personne dire du mal d'eux."

# game/scripts/c26/c26.rpy:1413
translate french c26s003_Sai_2f99dfee:

    # sai "Si alguien dijera algo malo de ellas, no sobreviviría hasta que llegaran a casa para vengarse."
    sai "Si quelqu'un disait du mal d'eux, ils ne survivraient pas jusqu'à leur retour chez eux pour se venger."

# game/scripts/c26/c26.rpy:1414
translate french c26s003_Sai_c3830c33:

    # sai "Destrozaríamos entre todas a quien osara decir algo de nuestras chicas."
    sai "Nous déchirerions tous quiconque oserait dire quoi que ce soit sur nos filles."

# game/scripts/c26/c26.rpy:1416
translate french c26s003_Sai_2124d16f:

    # "Ahora es cuando [sai] se dirige a la cámara."
    "C’est maintenant que [sai] s’adresse à la caméra."

# game/scripts/c26/c26.rpy:1417
translate french c26s003_Sai_8ae61518:

    # sai "Y sabéis que lo digo en serio. Todas os queremos."
    sai "Et vous savez que je le pense vraiment. Nous vous aimons tous."

# game/scripts/c26/c26.rpy:1418
translate french c26s003_Sai_4eaf4fb0:

    # "Estás seguro de que quien esté escuchando se habrá ruborizado, o quizás se le hayan saltado unas lágrimas. No están muy acostumbradas a recibir cariño."
    "Vous êtes certain que la personne qui écoutait a rougi, voire versé quelques larmes. Elle n'a pas l'habitude de recevoir de l'affection."

# game/scripts/c26/c26.rpy:1419
translate french c26s003_Sai_52810f24:

    # "Se van a acostumbrar muy rápido."
    "Ils s'y habitueront très vite."

# game/scripts/c26/c26.rpy:1421
translate french c26s003_Sai_8de79da5:

    # mc "¿Vais a hacer más lecciones de tiro?"
    mc "Allez-vous prendre d'autres cours de tir ?"

# game/scripts/c26/c26.rpy:1422
translate french c26s003_Sai_47238ed4:

    # sai "[eri] tiene que hacer una, pero será en el bosque. Creo que [eil] también se apuntará, y alguna de las de ayer también."
    sai "[eri] doit en faire un, mais ce sera dans les bois. Je pense que [eil] s'inscrira aussi, ainsi que certains de ceux d'hier."

# game/scripts/c26/c26.rpy:1423
translate french c26s003_Sai_04baaa1b:

    # sai "Fue muy divertido, y queremos repetirlo. Además, algunas queremos aprender a disparar con otras armas."
    sai "C'était très amusant et nous voulons recommencer. De plus, certains d'entre nous aimeraient apprendre à tirer avec d'autres armes."

# game/scripts/c26/c26.rpy:1424
translate french c26s003_Sai_9c72feea:

    # mc "Además es una actividad en grupo para estrechar lazos entre vosotras."
    mc "C'est aussi une activité de groupe pour renforcer les liens entre vous."

# game/scripts/c26/c26.rpy:1426
translate french c26s003_Sai_072d9792:

    # sai "*Risa* ¿Estrechar lazos aún más? Vamos a parecer piezas de un corsé a este paso."
    sai "*Rires* Renforcer encore les liens ? À ce rythme, on va ressembler à des morceaux de corset."

# game/scripts/c26/c26.rpy:1428
translate french c26s003_Sai_511e6c4d:

    # sai "En dos semanas aquí he estrechado más lazos de lo que hice el primer año en Portland, cuando vivía en el dormitorio."
    sai "En deux semaines ici, j'ai tissé des liens plus étroits que lors de ma première année à Portland, quand je vivais en résidence universitaire."

# game/scripts/c26/c26.rpy:1429
translate french c26s003_Sai_14fc3e69:

    # sai "Incluso con las chicas que no viven en casa, como [sam], [meg], o [oma]."
    sai "Même avec les filles qui ne vivent pas chez elles, comme [sam], [meg] ou [oma]."

# game/scripts/c26/c26.rpy:1430
translate french c26s003_Sai_91ffeca8:

    # mc "Entonces, ¿no te arrepientes de haber venido?"
    mc "Vous ne regrettez donc pas d'être venu ?"

# game/scripts/c26/c26.rpy:1433
translate french c26s003_Sai_5c77a558:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hubiéramos vuelto a estar juntos, hubiera valido la pena por las chicas."
    sai "Je ne le regrette absolument pas. Je suis venu pour toi, mais même si nous ne nous étions pas remis ensemble, cela en aurait valu la peine pour les filles."

# game/scripts/c26/c26.rpy:1434
translate french c26s003_Sai_db77d33c:

    # sai "Aunque no hubiera salido bien lo nuestro, la convivencia con esas chicas me hubiera hecho quedarme."
    sai "Même si ça n'avait pas marché entre nous, vivre avec ces filles m'aurait donné envie de rester."

# game/scripts/c26/c26.rpy:1436
translate french c26s003_Sai_d3dd32b2:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hemos vuelto a estar juntos, vale la pena por las chicas."
    sai "Je ne le regrette absolument pas. Je suis venu pour toi, mais même si nous ne nous sommes pas revus depuis, ça en valait la peine pour les filles."

# game/scripts/c26/c26.rpy:1437
translate french c26s003_Sai_433d5145:

    # sai "Tenías razón cuando me dijiste que no centrara mi vida en ti cuando no volvimos juntos, tenía que probar la convivencia con esas chicas para entenderlo."
    sai "Tu avais raison quand tu m'as dit de ne pas centrer ma vie sur toi quand on ne s'est pas remis ensemble ; il fallait que je vive avec ces filles pour le comprendre."

# game/scripts/c26/c26.rpy:1438
translate french c26s003_Sai_8c61827e:

    # mc "Me alegra mucho que seas feliz aquí."
    mc "Je suis si heureuse que tu sois heureuse ici."

# game/scripts/c26/c26.rpy:1440
translate french c26s003_Sai_153f750d:

    # sai "Lo soy. Mucho. Cuando en Portland me hablabas de tu familia no me podía imaginar algo así. Creía que exagerabas y resulta que te quedabas corto."
    sai "Oui, tout à fait. Quand vous me parliez de votre famille à Portland, je n'aurais jamais imaginé une chose pareille. Je pensais que vous exagériez, mais en fait, vous minimisiez la situation."

# game/scripts/c26/c26.rpy:1441
translate french c26s003_Sai_f22ce30f:

    # mc "*Risa* Yo tampoco me podía imaginar algo así. No era así cuando me marché, pero me alegra que lo sea ahora."
    mc "*Rires* Je n'aurais pas pu imaginer ça non plus. Ce n'était pas comme ça quand je suis partie, mais je suis contente que ce soit le cas maintenant."

# game/scripts/c26/c26.rpy:1442
translate french c26s003_Sai_815f4a4e:

    # mc "¿Y qué tal con [meg]? A veces me sabe mal haberte pedido que compartas tu habitación con ella."
    mc "Et [meg] ? Parfois, je me sens mal de te demander de partager ta chambre avec elle."

# game/scripts/c26/c26.rpy:1444
translate french c26s003_Sai_40d3ff6c:

    # sai "Me lo pediste la semana pasada y no hubo ningún problema. Esta semana ya tiene el coche arreglado y quería volver a su piso después de trabajar."
    sai "Vous m'avez posé la question la semaine dernière et il n'y avait aucun problème. Cette semaine, il a fait réparer sa voiture et voulait rentrer chez lui après le travail."

# game/scripts/c26/c26.rpy:1445
translate french c26s003_Sai_e81e5b4e:

    # sai "No le dejé hacerlo. Para mí, es una más y no me importa compartir la habitación con ella tres días por semana."
    sai "Je ne l'ai pas laissée faire. Pour moi, c'est juste une fille comme les autres, et ça ne me dérange pas de partager une chambre avec elle trois jours par semaine."

# game/scripts/c26/c26.rpy:1446
translate french c26s003_Sai_6b2bb13f:

    # sai "O aunque fueran todos los días. Es un cielo y si volviera a su piso después de trabajar seguramente no vendría a las comidas. Y no hubiera conocido a Zeus."
    sai "Même si c'était tous les jours. C'est un ange, et si elle rentrait chez elle après le travail, elle ne viendrait certainement pas aux repas. Et elle n'aurait jamais rencontré Zeus."

# game/scripts/c26/c26.rpy:1447
translate french c26s003_Sai_7c54ac31:

    # mc "*Risa* Te estás convirtiendo en una Marks por derecho propio."
    mc "*Rires* Tu deviens un Marks à part entière."

# game/scripts/c26/c26.rpy:1449
translate french c26s003_Sai_8e4c9f11:

    # sai "*Risa* He sonado como [eri], ¿verdad?"
    sai "*Rires* J'avais l'air de [eri], pas vrai ?"

# game/scripts/c26/c26.rpy:1450
translate french c26s003_Sai_88166954:

    # mc "*Risa* Un poco."
    mc "*Rires* Un peu."

# game/scripts/c26/c26.rpy:1451
translate french c26s003_Sai_3adc1161:

    # sai "Es un ejemplo que deberíamos seguir todas. Creo que es la persona menos egoísta que he conocido en mi vida."
    sai "Elle est un exemple à suivre. Je pense que c'est la personne la moins égoïste que j'aie jamais rencontrée."

# game/scripts/c26/c26.rpy:1452
translate french c26s003_Sai_77f618f8:

    # mc "Tienes razón. Creo que esa sería una buena definición de [eri]."
    mc "Vous avez raison. Je pense que ce serait une bonne définition de [eri]."

# game/scripts/c26/c26.rpy:1454
translate french c26s003_Sai_0d9207df:

    # sai "Tener a personas como ella alrededor hace que el resto queramos ser mejores personas."
    sai "Côtoyer des personnes comme elle nous donne envie d'être meilleurs."

# game/scripts/c26/c26.rpy:1455
translate french c26s003_Sai_9d236609:

    # mc "Será mejor que ella no te oiga decir eso o empezará a justificarse diciendo que lo que ella hace es lo normal en una familia."
    mc "Il vaut mieux qu'elle ne vous entende pas dire ça, sinon elle commencera à se justifier en disant que ce qu'elle fait est normal dans une famille."

# game/scripts/c26/c26.rpy:1457
translate french c26s003_Sai_05050b7a:

    # "En ese momento sale [meg] de la habitación que comparte con [sai]."
    "À ce moment-là, [meg] quitte la pièce qu'il partage avec [sai]."

# game/scripts/c26/c26.rpy:1458
translate french c26s003_Sai_57953a1b:

    # meg "Bueno, ya he recogido todo y he cambiado las sábanas."
    meg "Eh bien, j'ai déjà tout rangé et changé les draps."

# game/scripts/c26/c26.rpy:1460
translate french c26s003_Sai_7b197454:

    # sai "No hacía falta que lo hicieras. Me podía ocupar yo de todo."
    sai "Tu n'avais pas besoin de le faire. Je pouvais m'occuper de tout."

# game/scripts/c26/c26.rpy:1461
translate french c26s003_Sai_5d9bb139:

    # mc "¿Ya vuelves a casa?"
    mc "Tu rentres déjà chez toi ?"

# game/scripts/c26/c26.rpy:1463
translate french c26s003_Sai_a3f0c0f9:

    # meg "Ya sabes, hoy es mi día libre y tengo que hacer la colada para que los vestidos estén listos para mañana."
    meg "Tu sais, aujourd'hui c'est mon jour de congé et je dois faire la lessive pour que les robes soient prêtes pour demain."

# game/scripts/c26/c26.rpy:1464
translate french c26s003_Sai_ad4e91da:

    # mc "Déjame llevarte la maleta hasta el coche."
    mc "Laissez-moi porter votre valise jusqu'à la voiture."

# game/scripts/c26/c26.rpy:1466
translate french c26s003_Sai_ea69b5c5:

    # meg "No hace falta. No pesa demasiado."
    meg "Ce n'est pas nécessaire. Ça ne pèse pas trop."

# game/scripts/c26/c26.rpy:1467
translate french c26s003_Sai_3b674b4d:

    # mc "Insisto. ¿Lo tienes en el garaje de [nor]?"
    mc "J'insiste. L'avez-vous dans le garage [nor] ?"

# game/scripts/c26/c26.rpy:1468
translate french c26s003_Sai_f51e1f39:

    # meg "Sí, y gracias."
    meg "Oui, et merci."

# game/scripts/c26/c26.rpy:1471
translate french c26s003_Sai_65478830:

    # sai "Cuando dejes la maleta de [meg], ¿podrías venir a mi habitación? Necesito tu ayuda con algo."
    sai "Lorsque vous aurez déposé la valise de [meg], pourriez-vous passer dans ma chambre ? J’ai besoin de votre aide."

# game/scripts/c26/c26.rpy:1472
translate french c26s003_Sai_07d76d02:

    # mc "Ningún problema. En unos minutos paso a verte."
    mc "Pas de problème. Je viendrai te voir dans quelques minutes."

# game/scripts/c26/c26.rpy:1474
translate french c26s003_Sai_7609062c:

    # meg "Chicos, puedo bajar la maleta yo sola. Tú tienes que ir a clase en un par de horas y..."
    meg "Les gars, je peux descendre la valise tout seul. Vous devez aller en cours dans quelques heures et..."

# game/scripts/c26/c26.rpy:1475
translate french c26s003_Sai_be286a38:

    # mc "[meg], no creo que a [sai] le venga de cinco minutos, ¿verdad?"
    mc "[meg], je ne pense pas que cinq minutes suffiront [sai], n'est-ce pas ?"

# game/scripts/c26/c26.rpy:1477
translate french c26s003_Sai_a1ef25a1:

    # sai "Ni de cinco ni de diez. No hay prisa."
    sai "Ni cinq, ni dix. Il n'y a pas d'urgence."

# game/scripts/c26/c26.rpy:1478
translate french c26s003_Sai_b8d733a1:

    # mc "¿Ves?"
    mc "Voir?"

# game/scripts/c26/c26.rpy:1481
translate french c26s003_Sai_9a580e0c:

    # "Las chicas se despiden con un abrazo y acompañas a [meg] hasta el garaje de [nor]."
    "Les filles se disent au revoir avec un câlin et tu accompagnes [meg] au garage de [nor]."

# game/scripts/c26/c26.rpy:1482
translate french c26s003_Sai_6db0a5fe:

    # "Los abrazos se repiten con cada chica que os encontráis por el camino."
    "Les câlins se répètent avec chaque fille rencontrée en chemin."

# game/scripts/c26/c26.rpy:1489
translate french c26s003_Sai2_930cdfaf:

    # "Al llegar al garaje de [nor], una vez metida la maleta de [meg] en su coche."
    "En arrivant au garage de [nor], une fois que la valise de [meg] était dans sa voiture."

# game/scripts/c26/c26.rpy:1490
translate french c26s003_Sai2_9a071f80:

    # mc "¿Te lo has pasado bien el fin de semana?"
    mc "Avez-vous passé un bon week-end ?"

# game/scripts/c26/c26.rpy:1491
translate french c26s003_Sai2_16039695:

    # meg "Ha sido fantástico. Con Zeus me reí muchísimo ayer."
    meg "C'était fantastique. J'ai tellement ri avec Zeus hier."

# game/scripts/c26/c26.rpy:1492
translate french c26s003_Sai2_d6c49a42:

    # mc "*Risa* No me hables del gato destructor de camas."
    mc "*Rires* Ne me parlez pas du chat qui détruit le lit."

# game/scripts/c26/c26.rpy:1494
translate french c26s003_Sai2_d4660c91:

    # meg "*Risa* No le eches la culpa al pobre gato. Me han dicho que estabais ocho personas en esa cama."
    meg "*Rires* Ne blâmez pas le pauvre chat. J'ai entendu dire que vous étiez huit dans ce lit."

# game/scripts/c26/c26.rpy:1495
translate french c26s003_Sai2_18754fc0:

    # mc "Sí, pero aguantó bien y no se rompió hasta que no subió Zeus."
    mc "Oui, mais il a bien résisté et ne s'est cassé que lorsque Zeus est monté dessus."

# game/scripts/c26/c26.rpy:1500
translate french c26s003_Sai2_243c2fa6:

    # meg "Bueno, me tengo que ir. Debo hacer la colada e ir al supermercado."
    meg "Bon, je dois y aller. Je dois faire la lessive et aller au supermarché."

# game/scripts/c26/c26.rpy:1501
translate french c26s003_Sai2_fc6ca869:

    # mc "Creo que deberías dejar ropa aquí la próxima vez que vengas. No me refiero a los vestidos para el trabajo, pero algo de ropa casual."
    mc "Je pense que tu devrais laisser quelques vêtements ici la prochaine fois que tu viendras. Je ne parle pas de robes de travail, mais de vêtements décontractés."

# game/scripts/c26/c26.rpy:1502
translate french c26s003_Sai2_102a9a67:

    # mc "Cuando vuelvas la semana siguiente, estará limpia, y así sólo necesitas ir y venir con lo que necesites para trabajar."
    mc "À votre retour la semaine suivante, tout sera propre, vous n'aurez donc qu'à faire des allers-retours avec ce dont vous avez besoin pour le travail."

# game/scripts/c26/c26.rpy:1504
translate french c26s003_Sai2_85793322:

    # meg "[mar] me dijo lo mismo, pero no quiero darle más trabajo del necesario."
    meg "[mar] m'a dit la même chose, mais je ne veux pas lui donner plus de travail que nécessaire."

# game/scripts/c26/c26.rpy:1505
translate french c26s003_Sai2_3709b1e4:

    # mc "Si ella te lo propuso, es porque no le importa. Piénsalo."
    mc "Si elle l'a suggéré, c'est que ça ne la dérange pas. Réfléchissez-y."

# game/scripts/c26/c26.rpy:1508
translate french c26s003_Sai2_ea0b53a4:

    # meg "Lo pensaré. Si decido hacerlo antes de que vengas a verme a Westport, quizá te dé un poco de ropa para que la traigas."
    meg "J'y réfléchirai. Si je me décide avant votre venue à Westport, je vous donnerai peut-être des vêtements à emporter."

# game/scripts/c26/c26.rpy:1509
translate french c26s003_Sai2_17c67712:

    # meg "Así podré venir con una maleta más pequeña, solo con los vestidos. Y no tendrás que cargarla arriba y abajo."
    meg "Ainsi, je pourrai venir avec une valise plus petite, juste avec les robes. Et vous n'aurez pas à la porter."

# game/scripts/c26/c26.rpy:1511
translate french c26s003_Sai2_c03768b0:

    # meg "Lo pensaré. Si decido hacerlo, podré venir con una maleta más pequeña dentro de dos semanas, solo con los vestidos."
    meg "J'y réfléchirai. Si je me décide, je pourrai revenir dans deux semaines avec une valise plus petite, juste avec les robes."

# game/scripts/c26/c26.rpy:1512
translate french c26s003_Sai2_3b48fe12:

    # meg "Y no tendrás que ir arriba y abajo con ella."
    meg "Et vous n'aurez pas à monter et descendre avec elle."

# game/scripts/c26/c26.rpy:1513
translate french c26s003_Sai2_f5271567:

    # mc "Me parece una buena idea."
    mc "Je pense que c'est une bonne idée."

# game/scripts/c26/c26.rpy:1516
translate french c26s003_Sai2_0045e65e:

    # meg "Te veo el fin de semana, o cuando quieras pasar por mi apartamento."
    meg "Je te verrai ce week-end, ou quand tu voudras passer à mon appartement."

# game/scripts/c26/c26.rpy:1518
translate french c26s003_Sai2_6f25a080:

    # meg "Te veo el fin de semana que viene."
    meg "Je te verrai le week-end prochain."

# game/scripts/c26/c26.rpy:1519
translate french c26s003_Sai2_f19a724f:

    # mc "Conduce con cuidado."
    mc "Conduisez prudemment."

# game/scripts/c26/c26.rpy:1522
translate french c26s003_Sai2_4abe6172:

    # "Os dais un abrazo de despedida antes de que suba al coche."
    "Vous vous faites une accolade d'adieu avant que je ne monte dans la voiture."

# game/scripts/c26/c26.rpy:1533
translate french c26s002_Solomon_64a1454b:

    # "Mientras [sai] te enseñaba las fotos, en la comisaría..."
    "Pendant que [sai] vous montrait les photos, au poste de police..."

# game/scripts/c26/c26.rpy:1535
translate french c26s002_Solomon_9175ac4f:

    # sol "Buenos días, Agente. Le traigo lo que me pidió."
    sol "Bonjour, agent. Je vous ai apporté ce que vous avez demandé."

# game/scripts/c26/c26.rpy:1537
translate french c26s002_Solomon_eec332cc:

    # oma "Bien. Se ha tomado su tiempo. Ha tardado una semana entera."
    oma "Bien. Ça a pris son temps. Une semaine entière."

# game/scripts/c26/c26.rpy:1539
translate french c26s002_Solomon_22b132fb:

    # sol "Lo siento... No me lo han entregado hasta hoy. No he podido hacerlo antes."
    sol "Je suis désolé… Je ne l'ai reçu qu'aujourd'hui. Je n'avais pas pu le faire auparavant."

# game/scripts/c26/c26.rpy:1541
translate french c26s002_Solomon_1e87be37:

    # oma "Bueno, vamos a ir a entregarlo."
    oma "D'accord, allons-y, livrons-le."

# game/scripts/c26/c26.rpy:1543
translate french c26s002_Solomon_3ebb979f:

    # oma "¡Schrute! Sustitúyeme en el mostrador. Tengo que acompañar a este señor a un sitio."
    oma "Schrute ! Prends ma place au comptoir. Je dois accompagner ce monsieur quelque part."

# game/scripts/c26/c26.rpy:1544
translate french c26s002_Solomon_285a9ffa:

    # "Schrute" "*Desde la parte de atrás* No te preocupes, ahora voy."
    "Schrute" "*De l'arrière* Ne vous inquiétez pas, j'arrive."

# game/scripts/c26/c26.rpy:1546
translate french c26s002_Solomon_67f955f6:

    # sol "¿Vamos a ir ahora? ¿Tengo que ir yo también?"
    sol "On y va maintenant ? Je dois y aller aussi ?"

# game/scripts/c26/c26.rpy:1548
translate french c26s002_Solomon_5f4f5eb1:

    # oma "Sí, tiene que venir. Aunque sea tan solo por una vez en su vida, compórtese como un hombre."
    oma "Oui, il doit venir. Même si ce n'est qu'une fois dans sa vie, qu'il se comporte en homme."

# game/scripts/c26/c26.rpy:1549
translate french c26s002_Solomon_ca3bdd91:

    # oma "Si quiere comportarse como una damisela asustada, puedo llamar a mi hermana la rubia para que le... 'ayude'... a encontrar sus cojones."
    oma "Si tu veux jouer les demoiselles en détresse apeurées, je peux appeler ma sœur blonde pour... t'« aider »... à retrouver tes couilles."

# game/scripts/c26/c26.rpy:1551
translate french c26s002_Solomon_77044a79:

    # sol "¡Vale, vale! Vamos..."
    sol "D'accord, d'accord ! Allons-y..."

# game/scripts/c26/c26.rpy:1553
translate french c26s002_Solomon_9e3b875d:

    # "Un par de minutos después, en la puerta de la biblioteca..."
    "Quelques minutes plus tard, à la porte de la bibliothèque..."

# game/scripts/c26/c26.rpy:1554
translate french c26s002_Solomon_e5fa05fa:

    # sol "¿Estoy bien?"
    sol "Je vais bien?"

# game/scripts/c26/c26.rpy:1556
translate french c26s002_Solomon_6c4d82a9:

    # oma "No creo que hayas estado bien en tu vida, [sol]."
    oma "Je ne pense pas que tu aies été bien dans ta vie, [sol]."

# game/scripts/c26/c26.rpy:1557
translate french c26s002_Solomon_736e3492:

    # oma "Además, no te iba a servir de mucho. No va a volver contigo aunque ella quisiera."
    oma "D'ailleurs, ça ne te servirait pas à grand-chose. Elle ne reviendra pas vers toi, même si elle le voulait."

# game/scripts/c26/c26.rpy:1559
translate french c26s002_Solomon_62ca9c3d:

    # sol "¿Aunque ella quisiera? ¿Significa eso que hay una oportunidad?"
    sol "Même si elle le voulait ? Cela signifie-t-il qu'il y a une chance ?"

# game/scripts/c26/c26.rpy:1561
translate french c26s002_Solomon_b6bf24d4:

    # oma "No. Significa que si, por alguna razón desconocida, quisiera volver contigo, haría lo posible para que la encerraran en un psiquiátrico antes de dejarle hacerlo."
    oma "Non. Cela signifie que si, pour une raison inconnue, elle voulait revenir vers vous, je ferais tout mon possible pour la faire interner dans un hôpital psychiatrique avant de la laisser faire."

# game/scripts/c26/c26.rpy:1562
translate french c26s002_Solomon_2404cc94:

    # oma "Pero no te preocupes. No tienes ninguna oportunidad. Por primera vez es libre y está descubriendo lo que es vivir. Sin ti."
    oma "Mais ne t'inquiète pas. Tu n'as aucune chance. Pour la première fois, elle est libre et découvre ce que signifie vivre. Sans toi."

# game/scripts/c26/c26.rpy:1564
translate french c26s002_Solomon_01e35e09:

    # sol "No he sido tan malo... Los hay peores."
    sol "Je n'ai pas été si mauvais... Il y a pire."

# game/scripts/c26/c26.rpy:1566
translate french c26s002_Solomon_6675abed:

    # oma "Sí, los hay que asesinan a sus mujeres porque dicen que las quieren. Creo que es la única categoría peor que tú."
    oma "Oui, il y a des hommes qui assassinent leur femme parce qu'ils disent les aimer. Je crois que c'est la seule catégorie pire que la vôtre."

# game/scripts/c26/c26.rpy:1567
translate french c26s002_Solomon_918ecc60:

    # oma "Además, tú eres más patético."
    oma "En plus, tu es encore plus pathétique."

# game/scripts/c26/c26.rpy:1568
translate french c26s002_Solomon_35e4180c:

    # oma "Vamos dentro antes de que vomite del asco que me das."
    oma "Entrons avant que je ne vomisse tellement vous me dégoûtez."

# game/scripts/c26/c26.rpy:1570
translate french c26s002_Solomon_da133d0a:

    # kia "¡[sol]! ¿Qué haces aquí? ¿Y tú, [oma]?"
    kia "[sol]! Que fais-tu ici ? Et toi, [oma] ?"

# game/scripts/c26/c26.rpy:1572
translate french c26s002_Solomon_d20d4b90:

    # oma "No te preocupes, ha sido idea mía. Y le acompaño para que no intente nada raro."
    oma "Ne t'inquiète pas, c'était mon idée. Et je l'accompagne pour qu'il ne fasse rien de bizarre."

# game/scripts/c26/c26.rpy:1573
translate french c26s002_Solomon_45bdb1a3:

    # oma "[sol], di lo que tengas que decir."
    oma "[sol], dis ce que tu as à dire."

# game/scripts/c26/c26.rpy:1575
translate french c26s002_Solomon_6a84d3e4:

    # sol "Venía a entregarte esto... pero sólo si quieres..."
    sol "Je suis venu te donner ceci... mais seulement si tu le veux..."

# game/scripts/c26/c26.rpy:1576
translate french c26s002_Solomon_3d2cabb8:

    # sol "Si quieres... puedes volver a casa..."
    sol "Si vous voulez... vous pouvez rentrer chez vous..."

# game/scripts/c26/c26.rpy:1578
translate french c26s002_Solomon_948c80e0:

    # kia "¿Qué es?"
    kia "Qu'est-ce que c'est?"

# game/scripts/c26/c26.rpy:1581
translate french c26s002_Solomon_d72cf8d8:

    # oma "Ábrelo, [kia]. Por temas legales, digamos que te lo he entregado yo."
    oma "Ouvre-le, [kia]. Pour des raisons légales, disons que je te l'ai donné."

# game/scripts/c26/c26.rpy:1584
translate french c26s002_Solomon_536d5186:

    # kia "¿El divorcio? ¿Me estás pidiendo el divorcio?"
    kia "Le divorce ? Vous me demandez de divorcer ?"

# game/scripts/c26/c26.rpy:1586
translate french c26s002_Solomon_c9e2029a:

    # sol "No es que yo quiera, pero..."
    sol "Ce n'est pas que je le veuille, mais..."

# game/scripts/c26/c26.rpy:1588
translate french c26s002_Solomon_6199a8c7:

    # oma "[sol], ya te puedes ir. Ni siquiera deberías estar aquí para entregar los papeles."
    oma "[sol], vous pouvez partir maintenant. Vous n'auriez même pas dû être là pour remettre les documents."

# game/scripts/c26/c26.rpy:1589
translate french c26s002_Solomon_a4ad4d00:

    # oma "Eso va en contra de las condiciones con las que has pedido el divorcio."
    oma "Cela contrevient aux conditions dans lesquelles vous avez déposé une demande de divorce."

# game/scripts/c26/c26.rpy:1591
translate french c26s002_Solomon_ba65e4e8:

    # sol "¡Pero ha sido usted quien me ha dicho que debía venir yo!"
    sol "Mais c'est toi qui m'as dit que je devais venir !"

# game/scripts/c26/c26.rpy:1593
translate french c26s002_Solomon_66adef48:

    # oma "No quería perderme ver cómo lloriqueabas hasta el último momento."
    oma "Je ne voulais pas rater le moment où tu te plaindras."

# game/scripts/c26/c26.rpy:1595
translate french c26s002_Solomon_592217a4:

    # kia "Espera un momento, [oma]."
    kia "Attendez un instant, [oma]."

# game/scripts/c26/c26.rpy:1596
translate french c26s002_Solomon_d523cf11:

    # kia "Aquí pone que me cedes la casa... Bueno, tu mitad de la casa."
    kia "Il est écrit ici que vous me donnez la maison... Enfin, votre moitié de la maison."

# game/scripts/c26/c26.rpy:1598
translate french c26s002_Solomon_dcf9ebe3:

    # sol "Es lo que me dijo la Agente Martinez. Además, sin trabajo no puedo pagar la hipoteca y la acabaría perdiendo."
    sol "C'est ce que m'a dit l'agent Martinez. De plus, sans emploi, je ne peux pas rembourser mon prêt immobilier et je finirais par le perdre."

# game/scripts/c26/c26.rpy:1599
translate french c26s002_Solomon_be90933b:

    # sol "Me iré a vivir con un amigo de mi antiguo trabajo y con su novia hasta que encuentre algo."
    sol "Je vais vivre chez un ami de mon ancien travail et sa copine jusqu'à ce que je trouve quelque chose."

# game/scripts/c26/c26.rpy:1601
translate french c26s002_Solomon_64f1345d:

    # kia "¿También me das los ahorros?"
    kia "Me donnerez-vous aussi les économies ?"

# game/scripts/c26/c26.rpy:1603
translate french c26s002_Solomon_5922a6da:

    # sol "La Agente Martinez..."
    sol "Agent Martinez..."

# game/scripts/c26/c26.rpy:1605
translate french c26s002_Solomon_277d44cf:

    # kia "Los ahorros te los puedes quedar para empezar de nuevo. No hay mucho y el valor de la casa es mayor, con lo que me parece justo."
    kia "Vous pouvez garder vos économies pour repartir à zéro. Il n'y a pas grand-chose, et la maison vaut plus, alors je pense que c'est juste."

# game/scripts/c26/c26.rpy:1607
translate french c26s002_Solomon_0f1615a5:

    # oma "[kia], esto no lo tenéis que discutir ahora. Te hemos... te he entregado los papeles y ahora tienes 30 días para responder a la petición."
    oma "[kia], inutile d'en discuter maintenant. Je vous ai remis les documents et vous disposez de 30 jours pour répondre à la demande."

# game/scripts/c26/c26.rpy:1608
translate french c26s002_Solomon_459c0397:

    # oma "La división de bienes puede venir después, y lo ideal sería que fuera con ayuda de un abogado. Hay que hacer una Declaración de Bienes y otras cosas."
    oma "Le partage des biens peut intervenir ultérieurement et, idéalement, il devrait être effectué avec l'aide d'un avocat. Une déclaration de patrimoine et d'autres documents devront être établis."

# game/scripts/c26/c26.rpy:1610
translate french c26s002_Solomon_24b820e7:

    # kia "Lo entiendo... Creía que... En las películas..."
    kia "Je comprends... Je pensais que... Dans les films..."

# game/scripts/c26/c26.rpy:1612
translate french c26s002_Solomon_2161c1e0:

    # oma "No te preocupes, no es complicado. Te ayudaremos con lo que necesites."
    oma "Ne vous inquiétez pas, ce n'est pas compliqué. Nous vous aiderons pour tout ce dont vous aurez besoin."

# game/scripts/c26/c26.rpy:1613
translate french c26s002_Solomon_724e39f9:

    # oma "Tienes que firmar el recibo como que te he entregado los papeles y dármelo. No tienes que firmar los papeles aún."
    oma "Vous devez signer le reçu attestant que je vous ai remis les documents et me le rendre. Vous n'avez pas besoin de signer les documents pour l'instant."

# game/scripts/c26/c26.rpy:1615
translate french c26s002_Solomon_7b347fac:

    # oma "[sol], te puedes marchar."
    oma "[sol], vous pouvez partir."

# game/scripts/c26/c26.rpy:1617
translate french c26s002_Solomon_61eeb2e4:

    # sol "Aún podemos arreglarlo..."
    sol "Nous pouvons encore y remédier..."

# game/scripts/c26/c26.rpy:1619
translate french c26s002_Solomon_72628501:

    # oma "[sol], vete antes de que me arrepienta de haberte dado esta oportunidad."
    oma "[sol], pars avant que je regrette de t'avoir donné cette opportunité."

# game/scripts/c26/c26.rpy:1621
translate french c26s002_Solomon_db74d5b2:

    # "[sol] se va inmediatamente."
    "[sol] part immédiatement."

# game/scripts/c26/c26.rpy:1622
translate french c26s002_Solomon_65cd5ea3:

    # "[kia] firma el recibo y se lo entrega a [oma]..."
    "[kia] signe le reçu et le remet à [oma]..."

# game/scripts/c26/c26.rpy:1623
translate french c26s002_Solomon_8d6dc5e2:

    # kia "¿Le has obligado a hacer esto? ¿Cómo?"
    kia "L'avez-vous forcé à faire cela ? Comment ?"

# game/scripts/c26/c26.rpy:1625
translate french c26s002_Solomon_9acdbcd0:

    # oma "Vino a comisaría a poner una denuncia falsa contra [mc] por lo que pasó en la fiesta de cumpleaños. Ese día estaba yo en el mostrador."
    oma "Elle est venue au poste de police pour déposer une fausse plainte contre [mc] concernant ce qui s'est passé à la fête d'anniversaire. J'étais derrière le guichet ce jour-là."

# game/scripts/c26/c26.rpy:1626
translate french c26s002_Solomon_9cf2e232:

    # oma "Le di a elegir entre la cárcel y pedirte el divorcio. Lloriqueó un poco con lo de ser católico antes de aceptar."
    oma "Je lui ai laissé le choix entre la prison et le divorce. Il a un peu râlé sur sa foi catholique avant d'accepter."

# game/scripts/c26/c26.rpy:1627
translate french c26s002_Solomon_b4dff185:

    # oma "Supongo que sus convicciones religiosas no son tan fuertes como su miedo a acabar en prisión."
    oma "J'imagine que ses convictions religieuses ne sont pas aussi fortes que sa peur de finir en prison."

# game/scripts/c26/c26.rpy:1628
translate french c26s002_Solomon_83846a8a:

    # oma "Por lo que pudiera ser, le he dicho que no se acercara a menos de un metro del mostrador. No me fío de él."
    oma "Par précaution, je lui ai dit de ne pas s'approcher à moins d'un mètre du comptoir. Je ne lui fais pas confiance."

# game/scripts/c26/c26.rpy:1630
translate french c26s002_Solomon_79803981:

    # kia "Siempre ha sido un cobarde y un mentiroso..."
    kia "Il a toujours été un lâche et un menteur..."

# game/scripts/c26/c26.rpy:1636
translate french c26s002_Solomon_98004f52:

    # kia "Gracias, [oma]. Nunca lo habría logrado sin ti."
    kia "Merci, [oma]. Je n'y serais jamais arrivé sans toi."

# game/scripts/c26/c26.rpy:1637
translate french c26s002_Solomon_4ca9cb59:

    # oma "No tienes por qué darme las gracias. En esta familia estamos para ayudarnos entre nosotras, ¿no?"
    oma "Tu n'as pas à me remercier. Dans cette famille, on est là pour s'entraider, n'est-ce pas ?"

# game/scripts/c26/c26.rpy:1639
translate french c26s002_Solomon_7135fc61:

    # oma "Me sentí muy mal cuando fuimos a tu antigua casa y me tuve que ir poco antes de que [sol] llegara. Afortunadamente, [mc] estaba allí."
    oma "Je me suis sentie très mal quand nous sommes allés à ton ancienne maison et que j'ai dû partir peu de temps avant l'arrivée de [sol]. Heureusement, [mc] était là."

# game/scripts/c26/c26.rpy:1640
translate french c26s002_Solomon_c7cf9799:

    # oma "Esta vez, he podido ayudar sin tener que depender de que él haga algo."
    oma "Cette fois-ci, j'ai pu l'aider sans avoir à dépendre de lui."

# game/scripts/c26/c26.rpy:1642
translate french c26s002_Solomon_3f03771a:

    # kia "No tienes que sentirte mal, [oma]. No podéis estar todo el día para protegerme de [sol]."
    kia "Tu n'as pas à t'en faire, [oma]. Tu ne peux pas rester ici toute la journée pour me protéger de [sol]."

# game/scripts/c26/c26.rpy:1644
translate french c26s002_Solomon_54cf5776:

    # oma "Parece que, con un poco de suerte, ya no será necesario."
    oma "Il semblerait qu'avec un peu de chance, ce ne soit plus nécessaire."

# game/scripts/c26/c26.rpy:1646
translate french c26s002_Solomon_1c3c6881:

    # kia "Gracias a ti."
    kia "Merci à vous."

# game/scripts/c26/c26.rpy:1649
translate french c26s002_Solomon_976ea1f8:

    # oma "Hablando de [mc]..."
    oma "À propos de [mc]..."

# game/scripts/c26/c26.rpy:1651
translate french c26s002_Solomon_dc2d7156:

    # kia "*Risa* Me parece que nos pasamos la vida hablando de él."
    kia "*Rires* J'ai l'impression qu'on passe notre vie à parler de lui."

# game/scripts/c26/c26.rpy:1653
translate french c26s002_Solomon_4a8c1eb8:

    # oma "*Risa* Tienes razón. Todo esto es muy nuevo..."
    oma "*Rires* Vous avez raison. Tout cela est très nouveau..."

# game/scripts/c26/c26.rpy:1656
translate french c26s002_Solomon_85c6b010:

    # kia "Para ti, pero también para mí..."
    kia "Pour toi, mais aussi pour moi..."

# game/scripts/c26/c26.rpy:1658
translate french c26s002_Solomon_432ae35c:

    # kia "Para ti, para mí, y para todas nosotras..."
    kia "Pour toi, pour moi, et pour nous tous..."

# game/scripts/c26/c26.rpy:1659
translate french c26s002_Solomon_a00f1c75:

    # kia "Pero dime, ¿de qué querías hablar sobre él?"
    kia "Mais dites-moi, de quoi vouliez-vous parler à son sujet ?"

# game/scripts/c26/c26.rpy:1661
translate french c26s002_Solomon_0f2e3311:

    # oma "Es sobre el anillo que te dio..."
    oma "Il s'agit de la bague qu'il t'a offerte..."

# game/scripts/c26/c26.rpy:1663
translate french c26s002_Solomon_454b18fb:

    # oma "He pensado que..."
    oma "J'y pensais justement..."

# game/scripts/c26/c26.rpy:1665
translate french c26s002_Solomon_7e75581a:

    # oma "Lo estuvimos hablando el otro día con..."
    oma "Nous en parlions l'autre jour avec..."

# game/scripts/c26/c26.rpy:1667
translate french c26s002_Solomon_b37123a8:

    # oma "He hablado con las chicas y..."
    oma "J'ai parlé aux filles et..."

# game/scripts/c26/c26.rpy:1669
translate french c26s002_Solomon_b76c7896:

    # "Las dos mujeres pasan un rato hablando y haciendo planes, hasta que cada una tiene que volver a sus obligaciones."
    "Les deux femmes passent un certain temps à discuter et à faire des projets, jusqu'à ce que chacune doive retourner à ses obligations."

# game/scripts/c26/c26.rpy:1671
translate french c26s002_Solomon_b176f897:

    # "Las dos mujeres pasan un rato abrazadas hasta que cada una tiene que volver a sus obligaciones."
    "Les deux femmes passent un moment à s'enlacer avant de devoir reprendre leurs fonctions."

# game/scripts/c26/c26.rpy:1708
translate french c26s003_SaiSex_aeab1d05:

    # "Cuando llegas a la planta de las estudiantes, [sai] ya no está en el sofá."
    "Lorsque vous arrivez à l'étage des étudiants, [sai] n'est plus sur le canapé."

# game/scripts/c26/c26.rpy:1711
translate french c26s003_SaiSex_dd0461ef:

    # "*Knock-Knock*"
    "*Toc-Toc*"

# game/scripts/c26/c26.rpy:1712
translate french c26s003_SaiSex_4d7ca4ce:

    # mc "[sai], soy yo. ¿Puedo pasar?"
    mc "[sai], c'est moi. Puis-je entrer ?"

# game/scripts/c26/c26.rpy:1713
translate french c26s003_SaiSex_f6f5690c:

    # sai "*A través de la puerta* Dame un minuto para que acabe con una cosa."
    sai "*Par la porte* Donnez-moi une minute pour finir une chose."

# game/scripts/c26/c26.rpy:1714
translate french c26s003_SaiSex_62ea61d3:

    # "Esperas un par de minutos."
    "Vous attendez quelques minutes."

# game/scripts/c26/c26.rpy:1716
translate french c26s003_SaiSex_8b865fdd:

    # sai "*A través de la puerta* Ya puedes pasar."
    sai "*Par la porte* Vous pouvez entrer maintenant."

# game/scripts/c26/c26.rpy:1717
translate french c26s003_SaiSex_ac121f82:

    # "Por suerte los minutos de [sai] solo duran el doble de los de la mayoría de los hombres."
    "Heureusement, les minutes de [sai] ne durent que deux fois plus longtemps que celles de la plupart des hommes."

# game/scripts/c26/c26.rpy:1724
translate french c26s003_SaiSex_2dc9bcad:

    # mc "¡Por el amor de Dios, [sai]! ¡Estás increíble!"
    mc "Oh mon Dieu, [sai]! Tu es magnifique !"

# game/scripts/c26/c26.rpy:1726
translate french c26s003_SaiSex_69985c3e:

    # sai "Gracias. Me alegra que te guste."
    sai "Merci. Je suis content que ça vous plaise."

# game/scripts/c26/c26.rpy:1727
