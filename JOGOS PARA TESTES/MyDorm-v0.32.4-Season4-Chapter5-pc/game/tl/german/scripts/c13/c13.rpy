    nor "Scarlett, du kommst schon seit Jahren zu uns nach Hause. Jetzt gehört es auch dir."

# game/scripts/c13/c13.rpy:1625
translate german qKissSairaArrival_a9271edf:

    # mc "Ahora que ha acabado la ronda de abrazos. ¿Subimos las cosas de Scarlett entre todos?"
