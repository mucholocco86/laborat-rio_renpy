    sca "Nicht einmal für alles Gold der Welt!" (multiple=2)

# game/scripts/c13/c13.rpy:1613
translate german qKissSairaArrival_6e02fda0:

    # mc "*Risa* Parece que el color del pelo no se toca. Seréis una rubia, una pelirroja y una morena."
    mc "*lacht* Anscheinend kann man die Haarfarbe nicht ändern. Man ist blond, rothaarig oder brünett."

# game/scripts/c13/c13.rpy:1615
