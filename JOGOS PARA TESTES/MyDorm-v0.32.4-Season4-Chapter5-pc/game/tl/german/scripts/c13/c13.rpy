# game/scripts/c13/c13.rpy:1619
translate german qKissSairaArrival_db68648a:

    # mcp "(O incluso a mi medio hermana, si mis sospechas son correctas.)"
    mcp "(Oder sogar meine Halbschwester, wenn meine Vermutung stimmt.)"

# game/scripts/c13/c13.rpy:1621
translate german qKissSairaArrival_6ecadac4:

    # sca "Al final me vais a hacer llorar. No esperaba esta recepción..."
    sca "Du bringst mich noch zum Weinen. Mit so einem Empfang hatte ich nicht gerechnet..."

# game/scripts/c13/c13.rpy:1622
translate german qKissSairaArrival_1180c57e:

    # emm "*Susurrando* Si quieres hacerlo, no te cortes, estás en familia."
    emm "*Flüsternd* Wenn du es tun willst, dann halte dich nicht zurück, du bist ja bei deiner Familie."

# game/scripts/c13/c13.rpy:1624
translate german qKissSairaArrival_de3d4712:

