

# game/scripts/c13/c13.rpy:47
translate german c13s001_KiaraEileen_c6c4326a:

    # mc "¿Qué ha pasado, Eileen?"
    mc "Was ist passiert, Eileen?"

# game/scripts/c13/c13.rpy:48
translate german c13s001_KiaraEileen_c274c946:

    # eil "Lo de siempre. Mi padre bebió demasiado y empezó a gritarle a mi madre por alguna tontería."
    eil "Das Übliche. Mein Vater hatte zu viel getrunken und fing an, meine Mutter wegen einer Kleinigkeit anzuschreien."

# game/scripts/c13/c13.rpy:49
translate german c13s001_KiaraEileen_9fb18d51:

    # eil "Esta vez la agarró del brazo y empezó a arrastrarla por la casa. En ese momento llegué yo."
    eil "Diesmal packte er ihren Arm und zerrte sie durchs Haus. Da kam ich an."

# game/scripts/c13/c13.rpy:51
translate german c13s001_KiaraEileen_21bb27f9:

    # mc "¿Estás bien, Kiara?"
    mc "Alles in Ordnung, Kiara?"

# game/scripts/c13/c13.rpy:52
translate german c13s001_KiaraEileen_c906d645:

    # kia "Sí, no ha sido tanto como Eileen dice. Me ha hecho un poco de daño y..."
    kia "Ja, es war nicht so schlimm, wie Eileen sagt. Es hat mir ein bisschen wehgetan und..."

# game/scripts/c13/c13.rpy:53
translate german c13s001_KiaraEileen_6c0ef233:

    # kia "¿Podemos esperar a llegar a tu casa para seguir hablando de esto? Es raro hablar con dos cogotes..."
    kia "Können wir warten, bis wir bei dir zu Hause sind, um weiter darüber zu reden? Es ist komisch, mit zwei Männern zu reden..."

# game/scripts/c13/c13.rpy:54
translate german c13s001_KiaraEileen_f52820f5:

    # mc "Ningún problema, Kiara."
    mc "Kein Problem, Kiara."

# game/scripts/c13/c13.rpy:56
translate german c13s001_KiaraEileen_719b4668:

    # mc "Hoy dormiréis en mi habitación. Todo el mundo está durmiendo ahora mismo y sería complicado habilitaros otra habitación."
    mc "Du wirst heute Nacht in meinem Zimmer schlafen. Alle schlafen jetzt schon, und es wäre schwierig, ein anderes Zimmer für dich zu finden."

# game/scripts/c13/c13.rpy:57
translate german c13s001_KiaraEileen_72f9361b:

    # eil "¿Dónde vas a dormir tú?"
    eil "Wo wirst du schlafen?"

# game/scripts/c13/c13.rpy:58
translate german c13s001_KiaraEileen_3cf765c4:

    # mc "Con vosotras, por supuesto. Es mi habitación."
    mc "Mit dir natürlich. Es ist mein Zimmer."

# game/scripts/c13/c13.rpy:60
translate german c13s001_KiaraEileen_6e57607b:

    # eil "¡[mc]! No puedo dejar que duermas con mi madre..."
    eil "[mc]! Ich kann nicht zulassen, dass du mit meiner Mutter schläfst..."

# game/scripts/c13/c13.rpy:61
translate german c13s001_KiaraEileen_329a3c4e:

    # mc "Eile, es broma. Buscaré algún sitio donde dormir sin molestar a nadie."
    mc "Eile, ich mache nur Spaß. Ich finde schon einen Schlafplatz, ohne jemanden zu stören."

# game/scripts/c13/c13.rpy:63
translate german c13s001_KiaraEileen_05d083a2:

    # eil "Lo siento, no tengo el ánimo para bromas ahora mismo."
    eil "Tut mir leid, ich bin gerade nicht in der Stimmung für Witze."

# game/scripts/c13/c13.rpy:64
translate german c13s001_KiaraEileen_1519018b:

    # mc "No te preocupes. Quizás no era el momento más adecuado para bromas."
    mc "Keine Sorge. Vielleicht war es nicht der beste Zeitpunkt für Witze."

# game/scripts/c13/c13.rpy:66
translate german c13s001_KiaraEileen_e5d14762:

    # "Continúas conduciendo hacia casa. Ahora en silencio. El camino parece eterno una vez la adrenalina que te ha traído aquí volando desaparece."
    "Du fährst weiter nach Hause. Jetzt in Stille. Die Straße scheint endlos, nachdem der Adrenalinrausch, der dich hierhergebracht hat, nachgelassen hat."

# game/scripts/c13/c13.rpy:69
translate german c13s001_KiaraEileen_e220be2f:

    # mc "Pues esta es mi habitación, Kiara. Hay un baño con ducha justo pasar el gimnasio. Eileen conoce la casa, con lo que cualquier duda se la puedes preguntar."
    mc "Das ist mein Zimmer, Kiara. Gleich hinter dem Fitnessraum ist ein Badezimmer mit Dusche. Eileen kennt sich im Haus aus, du kannst sie also fragen, wenn du Fragen hast."

# game/scripts/c13/c13.rpy:71
translate german c13s001_KiaraEileen_03e86018:

    # mc "Si necesitáis cualquier cosa, estaré durmiendo en los sofás que acabamos de pasar en la planta debajo de esta."
    mc "Falls du etwas brauchst, ich schlafe auf den Sofas, an denen wir gerade vorbeigegangen sind, im Stockwerk darunter."

# game/scripts/c13/c13.rpy:72
translate german c13s001_KiaraEileen_3f24f32d:

    # kia "Gracias, [mc], me sabe mal que tengas que dormir en un sofá por nuestra culpa."
    kia "Danke, [mc], es tut mir leid, dass du wegen uns auf einem Sofa schlafen musst."

# game/scripts/c13/c13.rpy:73
translate german c13s001_KiaraEileen_c2022b3a:

    # eil "Podrías dormir en este sofá si quieres. No queremos echarte de tu habitación."
    eil "Du kannst gerne auf diesem Sofa schlafen. Wir wollen dich ja nicht aus deinem Zimmer werfen."

# game/scripts/c13/c13.rpy:75
translate german c13s001_KiaraEileen_769a90f0:

    # kia "O mejor aún, dormimos nosotras en esos sofás y tu duermes en tu cama como debería ser."
    kia "Oder noch besser: Wir schlafen auf diesen Sofas und du schläfst in deinem Bett, wie es sich gehört."

# game/scripts/c13/c13.rpy:76
translate german c13s001_KiaraEileen_7395a30e:

    # mc "Eso no puedo permitirlo. Sois mis invitadas y vais a dormir en una cama."
    mc "Das kann ich nicht zulassen. Sie sind meine Gäste und werden in einem Bett schlafen."

# game/scripts/c13/c13.rpy:78
translate german c13s001_KiaraEileen_87bd263e:

    # eil "Mamá... ¿no has metido pijamas en la bolsa?"
    eil "Mama... hast du den Schlafanzug nicht in die Tasche gepackt?"

# game/scripts/c13/c13.rpy:80
translate german c13s001_KiaraEileen_444f4618:

    # kia "¡Oops! No. Me he despistado. Con las prisas he pensado en ropa, artículos de higiene... pero no en los pijamas."
    kia "Ups! Nein. Ich war in Gedanken versunken. In meiner Eile dachte ich an Kleidung, Toilettenartikel... aber nicht an Pyjamas."

# game/scripts/c13/c13.rpy:81
translate german c13s001_KiaraEileen_c1783558:

    # mc "No os preocupéis. Podéis coger camisetas o pijamas míos para dormir. Eileen sabe donde están."
    mc "Keine Sorge. Du kannst jedes meiner T-Shirts oder meinen Schlafanzug zum Schlafen mitnehmen. Eileen weiß, wo sie sind."

# game/scripts/c13/c13.rpy:83
translate german c13s001_KiaraEileen_9a4121a2:

    # kia "Se me hace raro que Eileen sepa más de una casa que yo. *Risa* Pero después de tantos años juntos es normal."
    kia "Es ist schon seltsam, dass Eileen sich besser mit Häusern auskennt als ich. *lacht* Aber nach so vielen gemeinsamen Jahren ist das normal."

# game/scripts/c13/c13.rpy:84
translate german c13s001_KiaraEileen_be191e95:

    # kia "Es una lástima que lo dejáseis cuando estabas en Portland. Pensaba que volveriais a estar juntos cuando volvieras de la universidad."
    kia "Schade, dass ihr euch getrennt habt, als ihr in Portland wart. Ich dachte, ihr würdet wieder zusammenkommen, wenn ihr vom College zurückkommt."

# game/scripts/c13/c13.rpy:85
translate german c13s001_KiaraEileen_4d6b542d:

    # mc "Bueno, no funcionaba a distancia."
    mc "Nun ja, aus der Ferne hat es nicht funktioniert."

# game/scripts/c13/c13.rpy:88
translate german c13s001_KiaraEileen_1d7f0a08:

    # "Eileen te mira interrogativamente, como si te pidiera permiso para desvelar la noticia a su madre."
    "Eileen schaut dich fragend an, als wolle sie dich um Erlaubnis bitten, ihrer Mutter die Neuigkeit zu erzählen."

# game/scripts/c13/c13.rpy:89
translate german c13s001_KiaraEileen_c95b64af:

    # "Asientes."
    "Du nickst."

# game/scripts/c13/c13.rpy:91
translate german c13s001_KiaraEileen_f98ceeb9:

    # eil "Mamá, volvemos a estar juntos."
    eil "Mama, wir sind wieder zusammen."

# game/scripts/c13/c13.rpy:93
translate german c13s001_KiaraEileen_e045b18f:

    # eil "No de la misma forma que antes, pero volvemos a estarlo."
    eil "Nicht mehr so wie früher, aber wir sind zurück."

# game/scripts/c13/c13.rpy:95
translate german c13s001_KiaraEileen_6901d4af:

    # kia "¡Eso es fantástico! Me alegro mucho por vosotros."
    kia "Das ist fantastisch! Ich freue mich so für dich."

# game/scripts/c13/c13.rpy:96
translate german c13s001_KiaraEileen_887f84c9:

    # mc "Gracias, Kiara."
    mc "Danke, Kiara."

# game/scripts/c13/c13.rpy:99
translate german c13s001_KiaraEileen_bd6a288c:

    # eil "Además, ahora somos buenos amigos. Lo importante es que no hemos perdido la relación."
    eil "Außerdem sind wir mittlerweile gute Freunde. Hauptsache ist, dass wir den Kontakt nicht verloren haben."

# game/scripts/c13/c13.rpy:101
translate german c13s001_KiaraEileen_18f876c1:

    # mc "Voy a dejar que os cambiéis y os acostéis. Mañana hablaremos de cómo nos organizamos y de lo que ha pasado esta noche."
    mc "Du kannst dich jetzt umziehen und ins Bett gehen. Morgen besprechen wir, wie wir alles organisieren und was heute Abend passiert ist."

# game/scripts/c13/c13.rpy:102
translate german c13s001_KiaraEileen_cb206701:

    # kia "Gracias, [mc]."
    kia "Vielen Dank, [mc]."

# game/scripts/c13/c13.rpy:103
translate german c13s001_KiaraEileen_565a3cb6:

    # eil "Gracias. Por todo."
    eil "Vielen Dank für alles."

# game/scripts/c13/c13.rpy:105
translate german c13s001_KiaraEileen_a17f0e80:

    # "Bajas a la planta de las estudiantes. Parece mentira que Kim te despertara en este mismo sofá hace menos de 24 horas."
    "Du gehst hinunter ins Studentengeschoss. Kaum zu glauben, dass Kim dich vor weniger als 24 Stunden auf genau diesem Sofa geweckt hat."

# game/scripts/c13/c13.rpy:106
translate german c13s001_KiaraEileen_dcce7ba5:

    # mcp "{i}(Soy idiota. Les he dicho que cogieran mis pijamas y no he cogido uno para mí. Ni siquiera unos shorts.){/i}"
    mcp "{i}(Ich bin ein Idiot. Ich habe ihnen gesagt, sie sollen meinen Schlafanzug mitnehmen, aber ich habe selbst keinen mitgenommen. Nicht mal Shorts.){/i}"

# game/scripts/c13/c13.rpy:107
translate german c13s001_KiaraEileen_6ff3efb4:

    # mcp "{i}(*Risa mental* Dormir en pelotas en el sofá no sería muy adecuado si alguna de las estudiantes se despierta antes que yo.){/i}"
    mcp "{i}(*Innerliches Lachen* Nackt auf dem Sofa zu schlafen wäre nicht sehr angebracht, falls einer der Schüler vor mir aufwacht.){/i}"

# game/scripts/c13/c13.rpy:108
translate german c13s001_KiaraEileen_2f20ab6f:

    # "Vuelves a tu habitación."
    "Du gehst zurück in dein Zimmer."

# game/scripts/c13/c13.rpy:111
translate german c13s001_KiaraEileen_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c13/c13.rpy:112
translate german c13s001_KiaraEileen_ff300ecf:

    # mc "¿Puedo entrar? No he cogido nada para mí, para dormir."
    mc "Darf ich hereinkommen? Ich habe nichts für mich mitgenommen, zum Schlafen."

# game/scripts/c13/c13.rpy:113
translate german c13s001_KiaraEileen_f2e14fc9:

    # eil "*A través de la puerta* Espera un segundo, por favor."
    eil "*Durch die Tür* Einen Moment bitte."

# game/scripts/c13/c13.rpy:114
translate german c13s001_KiaraEileen_124fea52:

    # "Al cabo de unos segundos..."
    "Nach ein paar Sekunden..."

# game/scripts/c13/c13.rpy:115
translate german c13s001_KiaraEileen_87c5147b:

    # kia "*A través de la puerta* Puedes pasar."
    kia "Sie können durch die Tür gehen."

# game/scripts/c13/c13.rpy:117
translate german c13s001_KiaraEileen_d6dbf9c6:

    # mc "Disculpad, pero es que no he cogido mi propio pijama."
    mc "Entschuldigen Sie, aber ich habe meinen Schlafanzug nicht mitgebracht."

# game/scripts/c13/c13.rpy:118
translate german c13s001_KiaraEileen_6a638103:

    # mc "Aunque viendo que a vosotras os queda mejor mi ropa que a mí..."
    mc "Obwohl meine Kleidung an dir besser aussieht als an mir..."

# game/scripts/c13/c13.rpy:120
translate german c13s001_KiaraEileen_2aff138e:

    # eil "*Risa* ¿Ya estás diciendo payasadas? ¿Tú no ibas a dormir?"
    eil "*Lacht* Redest du schon wieder Unsinn? Wolltest du denn nicht schlafen gehen?"

# game/scripts/c13/c13.rpy:121
translate german c13s001_KiaraEileen_2164d99f:

    # mc "¿Payasadas? {b}¿Yo?{/b} ¡Qué va! Tenéis un espejo en ese armario si queréis, en el interior de la puerta."
    mc "Alberne Witze? {b}Ich?{/b} Auf keinen Fall! Da ist ein Spiegel in dem Schrank, falls du willst, an der Innenseite der Tür."

# game/scripts/c13/c13.rpy:122
translate german c13s001_KiaraEileen_f013a839:

    # mc "Y sobre lo de dormir... demasiados nervios para dormir ahora mismo."
    mc "Und was das Schlafen angeht... Ich bin im Moment zu nervös, um zu schlafen."

# game/scripts/c13/c13.rpy:124
translate german c13s001_KiaraEileen_cad26fba:

    # mc "¿Eso es lo que te ha hecho Solomon? Parece un hematoma importante, deberíamos ir al hospital a mirarlo."
    mc "Hat Salomo dir das angetan? Das sieht nach einem heftigen Bluterguss aus; wir sollten ins Krankenhaus gehen, um das untersuchen zu lassen."

# game/scripts/c13/c13.rpy:126
translate german c13s001_KiaraEileen_5b6d23f3:

    # kia "No hace falta, tan solo es un morado. No es la primera vez..."
    kia "Das ist nicht nötig, es ist halt lila. Es ist nicht das erste Mal..."

# game/scripts/c13/c13.rpy:127
translate german c13s001_KiaraEileen_0c3d2244:

    # mc "Espero que sea la última."
    mc "Ich hoffe, es ist das letzte Mal."

# game/scripts/c13/c13.rpy:128
translate german c13s001_KiaraEileen_03d83403:

    # mc "Pero de todas formas, habría que mirarlo. Sin dejar pasar muchos días."
    mc "Wir sollten der Sache aber trotzdem nachgehen. Und zwar ohne zu viele Tage verstreichen zu lassen."

# game/scripts/c13/c13.rpy:129
translate german c13s001_KiaraEileen_6b4a4f4c:

    # mc "¿Quieres hablar sobre lo que ha pasado?"
    mc "Möchtest du darüber sprechen, was passiert ist?"

# game/scripts/c13/c13.rpy:131
translate german c13s001_KiaraEileen_a5db2430:

    # kia "Nosotras tampoco vamos a poder dormir, si quieres te lo explico ahora antes de que se nos olviden los detalles."
    kia "Wir werden auch nicht schlafen können. Wenn du willst, kann ich es dir jetzt erklären, bevor wir die Details vergessen."

# game/scripts/c13/c13.rpy:132
translate german c13s001_KiaraEileen_a1ae72c2:

    # kia "Es lo menos que te debo..."
    kia "Das ist das Mindeste, was ich dir schulde..."

# game/scripts/c13/c13.rpy:133
translate german c13s001_KiaraEileen_59a61feb:

    # mc "Kiara, no me debes nada. Es más, no tienes que explicarme nada de lo que ha pasado."
    mc "Kiara, du schuldest mir gar nichts. Außerdem musst du mir nichts darüber erklären, was passiert ist."

# game/scripts/c13/c13.rpy:134
translate german c13s001_KiaraEileen_60f198fe:

    # mc "Lo decía porque en mi familia acostumbramos a hablarlo todo para quitarnos el peso de encima."
    mc "Ich sagte das, weil wir in meiner Familie normalerweise über alles reden, um die Last loszuwerden."

# game/scripts/c13/c13.rpy:136
translate german c13s001_KiaraEileen_3910ebcb:

    # eil "Es una buena costumbre, Mamá. Deberíamos aplicarla en casa."
    eil "Das ist eine gute Angewohnheit, Mama. Die sollten wir zu Hause übernehmen."

# game/scripts/c13/c13.rpy:137
translate german c13s001_KiaraEileen_25f21628:

    # eil "¿Nos sentamos?"
    eil "Sollen wir uns setzen?"

# game/scripts/c13/c13.rpy:138
translate german c13s001_KiaraEileen_bf5931c4:

    # mc "Sólo si tu madre quiere."
    mc "Nur wenn deine Mutter es will."

# game/scripts/c13/c13.rpy:140
translate german c13s001_KiaraEileen_34940787:

    # kia "Sí, probemos esa costumbre familiar vuestra. Está claro que las costumbres de mi familia no son las mejores."
    kia "Ja, lass uns eure Familientradition ausprobieren. Es ist klar, dass die Traditionen meiner Familie nicht die besten sind."

# game/scripts/c13/c13.rpy:141
translate german c13s001_KiaraEileen_db4aa0ed:

    # mc "No te machaques ahora. Eileen ha salido muy bien. Y tú también."
    mc "Mach dir jetzt keine Vorwürfe. Eileen hat das toll gemacht. Und du auch."

# game/scripts/c13/c13.rpy:143
translate german c13s001_KiaraEileen_bbb21deb:

    # mc "¿Por dónde quieres empezar, Kiara?"
    mc "Wo möchtest du anfangen, Kiara?"

# game/scripts/c13/c13.rpy:144
translate german c13s001_KiaraEileen_820962d4:

    # kia "Es difícil decidirlo. ¿Cuánto sabes? ¿Te pongo en antecedentes?"
    kia "Das ist eine schwierige Entscheidung. Wie viel wissen Sie darüber? Soll ich Ihnen einige Hintergrundinformationen geben?"

# game/scripts/c13/c13.rpy:145
translate german c13s001_KiaraEileen_20801f23:

    # eil "Mamá, [mc] sabe lo que pasaba cuando Papá bebía... cuando aún estábamos en el instituto."
    eil "Mama weiß, was passiert ist, wenn Papa getrunken hat... damals, als wir noch in der High School waren."

# game/scripts/c13/c13.rpy:147
translate german c13s001_KiaraEileen_2bc0a856:

    # kia "Entonces... esta noche..."
    kia "Also... heute Abend..."

# game/scripts/c13/c13.rpy:148
translate german c13s001_KiaraEileen_a3b26a54:

    # kia "Desde que Solomon ha vuelto a beber, no se había puesto violento ninguna vez, esta es la primera."
    kia "Seit Solomon wieder angefangen hat zu trinken, war er überhaupt nicht gewalttätig gewesen; dies ist das erste Mal."

# game/scripts/c13/c13.rpy:149
translate german c13s001_KiaraEileen_b6173fef:

    # mc "Eso es una vez más de las necesarias."
    mc "Das ist wiederum eine der notwendigen Maßnahmen."

# game/scripts/c13/c13.rpy:151
translate german c13s001_KiaraEileen_e6a3af03:

    # kia "Lo sé. Cuando dejó de beber lo hizo, entre otras razones, por que le amenacé con dejarle si me volvía a poner la mano encima."
    kia "Ich weiß. Als er mit dem Trinken aufhörte, lag das unter anderem daran, dass ich ihm gedroht hatte, ihn zu verlassen, falls er mich jemals wieder anfassen sollte."

# game/scripts/c13/c13.rpy:152
translate german c13s001_KiaraEileen_3c1001c8:

    # kia "Todo fue bien durante dos años, y después volvió a beber."
    kia "Zwei Jahre lang lief alles gut, dann fing er wieder an zu trinken."

# game/scripts/c13/c13.rpy:153
translate german c13s001_KiaraEileen_a262e0ac:

    # mc "Lo sé, Eileen me lo explicó. ¿Sabéis por qué volvió?"
    mc "Ich weiß, Eileen hat es mir erklärt. Weißt du, warum sie zurückgekommen ist?"

# game/scripts/c13/c13.rpy:155
translate german c13s001_KiaraEileen_f19c05de:

    # eil "No. Ya te dije que empezó a beber una cerveza al salir del trabajo, con los compañeros. Le dijimos que no lo hiciera, pero no nos hizo caso."
    eil "Nein. Ich habe Ihnen doch schon gesagt, dass er nach der Arbeit mit seinen Kollegen Bier trinkt. Wir haben ihm gesagt, er soll es lassen, aber er hat nicht auf uns gehört."

# game/scripts/c13/c13.rpy:156
translate german c13s001_KiaraEileen_b5fe506f:

    # eil "\"Sólo es una cerveza un día a la semana\" decía. Como te dije, de ahí pasó varias cervezas, a un whisky, a varios whiskys..."
    eil "„Es war nur ein Bier einmal die Woche“, sagte er. Wie ich Ihnen schon sagte, dann wurden es mehrere Biere, ein Whiskey, dann mehrere Whiskeys …"

# game/scripts/c13/c13.rpy:157
translate german c13s001_KiaraEileen_aefac422:

    # mc "Pero no estaba violento hasta hoy, ¿qué ha pasado hoy?"
    mc "Aber er war bis heute nicht gewalttätig, was ist heute passiert?"

# game/scripts/c13/c13.rpy:159
translate german c13s001_KiaraEileen_4b05b630:

    # kia "Cuando he llegado de trabajar estaba muy borracho."
    kia "Als ich von der Arbeit nach Hause kam, war ich total betrunken."

# game/scripts/c13/c13.rpy:160
translate german c13s001_KiaraEileen_6715e9d6:

    # kia "Se enfadó mucho cuando le dije que tardaría 30 minutos en preparar la cena."
    kia "Sie wurde sehr wütend, als ich ihr sagte, dass ich 30 Minuten brauchen würde, um das Abendessen zuzubereiten."

# game/scripts/c13/c13.rpy:161
translate german c13s001_KiaraEileen_8af27441:

    # mc "Acababas de llegar, ¿cuando quería que la preparases?"
    mc "Sie waren ja gerade erst angekommen, wann sollte ich es vorbereiten?"

# game/scripts/c13/c13.rpy:163
translate german c13s001_KiaraEileen_642ec6d5:

    # eil "Cuando está borracho el alcohol sustituye a la lógica."
    eil "Im betrunkenen Zustand verdrängt der Alkohol die Logik."

# game/scripts/c13/c13.rpy:164
translate german c13s001_KiaraEileen_5b86879b:

    # eil "Puede quejarse de cualquier cosa, tenga razón o no. Y si le llevas la contraria se enfada más todavía. No se puede razonar con él."
    eil "Er beschwert sich über alles, egal ob er Recht hat oder nicht. Und wenn man ihm widerspricht, wird er noch wütender. Mit ihm kann man nicht vernünftig reden."

# game/scripts/c13/c13.rpy:165
translate german c13s001_KiaraEileen_a78c46ec:

    # mc "Tú aún estabas en el trabajo, ¿no?"
    mc "Du warst noch bei der Arbeit, nicht wahr?"

# game/scripts/c13/c13.rpy:167
translate german c13s001_KiaraEileen_453f64ce:

    # eil "Sí, ayer... hoy... tenía que cerrar el café y hacer la caja. A los temporales como [eri] no les dejan hacerla."
    eil "Ja, gestern... heute... musste ich das Café schließen und an der Kasse arbeiten. Aushilfskräfte wie [eri] dürfen das nicht."

# game/scripts/c13/c13.rpy:168
translate german c13s001_KiaraEileen_d05e3112:

    # eil "Si hubiera estado ahí..."
    eil "Wenn ich dabei gewesen wäre..."

# game/scripts/c13/c13.rpy:169
translate german c13s001_KiaraEileen_019b6db4:

    # mc "No es culpa tuya. Estabas trabajando. Dejaste la universidad para ayudar económicamente en casa porque tu padre perdió el trabajo. No se te puede exigir más."
    mc "Es ist nicht deine Schuld. Du hast gearbeitet. Du hast dein Studium abgebrochen, um zu Hause zu helfen, weil dein Vater seine Arbeit verloren hat. Man kann nicht erwarten, dass du noch mehr tust."

# game/scripts/c13/c13.rpy:170
translate german c13s001_KiaraEileen_b4bd6d48:

    # eil "Lo sé, pero..."
    eil "Ich weiß, aber..."

# game/scripts/c13/c13.rpy:172
translate german c13s001_KiaraEileen_a2860f19:

    # kia "[mc] tiene razón. No es culpa tuya. Ya haces demasiado. Pero mejor que siga..."
    kia "[mc] hat Recht. Es ist nicht deine Schuld. Du übernimmst schon viel zu viel. Aber ich sollte besser fortfahren..."

# game/scripts/c13/c13.rpy:173
translate german c13s001_KiaraEileen_34d9eddc:

    # kia "Durante la cena estuvo gruñón, quejándose de la limpieza, de cenar tarde, y de... de otras cosas..."
    kia "Beim Abendessen war er mürrisch und beschwerte sich über die Sauberkeit, darüber, dass er spät gegessen hatte, und über... über andere Dinge..."

# game/scripts/c13/c13.rpy:174
translate german c13s001_KiaraEileen_da1a67d5:

    # mc "No hace falta que me expliques todo si no quieres..."
    mc "Du musst mir nicht alles erklären, wenn du nicht willst..."

# game/scripts/c13/c13.rpy:176
translate german c13s001_KiaraEileen_8d3c8ff4:

    # kia "No es eso... es que son temas de pareja..."
    kia "Das ist es nicht... es sind einfach Beziehungsprobleme..."

# game/scripts/c13/c13.rpy:177
translate german c13s001_KiaraEileen_c2d6cb37:

    # mc "Entonces no me hace falta saberlo."
    mc "Dann brauche ich es nicht zu wissen."

# game/scripts/c13/c13.rpy:178
translate german c13s001_KiaraEileen_b059fe3d:

    # kia "Es que... si no te lo explico... no vas a poder entender el resto..."
    kia "Es ist nur so... wenn ich es dir nicht erkläre... wirst du den Rest nicht verstehen können..."

# game/scripts/c13/c13.rpy:179
translate german c13s001_KiaraEileen_18cb3e2c:

    # mc "Como quieras, pero te puedo asegurar que lo que me digas no va a salir de esta habitación."
    mc "Was immer Sie wollen, aber ich kann Ihnen versichern, dass das, was Sie mir erzählen, diesen Raum nicht verlassen wird."

# game/scripts/c13/c13.rpy:181
translate german c13s001_KiaraEileen_eaf933e8:

    # kia "Se quejaba de que ya no tenemos sexo nunca. ¡Hale, ya lo he dicho! ¡Ufff! Realmente va bien esto de hablar las cosas..."
    kia "Sie hat sich beschwert, dass wir nie mehr Sex haben. So, jetzt hab ich's gesagt! Puh! Reden hilft wirklich..."

# game/scripts/c13/c13.rpy:182
translate german c13s001_KiaraEileen_1a94dda9:

    # kia "Desde que empezó a beber, el no... no funciona bien... no le funciona bien su..."
    kia "Seit er angefangen hat zu trinken, funktioniert er nicht mehr richtig... seine..."

# game/scripts/c13/c13.rpy:183
translate german c13s001_KiaraEileen_2abb1f51:

    # mc "Vale, lo entiendo. No tiene erecciones."
    mc "Okay, ich verstehe. Er bekommt keine Erektionen."

# game/scripts/c13/c13.rpy:185
translate german c13s001_KiaraEileen_3da85f71:

    # kia "Sí que las tiene. Pero duran segundos. Y no vuelven a subir. Hace meses que no... que no tenemos relaciones."
    kia "Ja, ich habe sie. Aber sie dauern nur Sekunden. Und sie kommen nicht wieder. Es ist schon Monate her, seit wir das letzte Mal Sex hatten."

# game/scripts/c13/c13.rpy:186
translate german c13s001_KiaraEileen_051ea5fd:

    # mc "El alcohol puede tener ese efecto."
    mc "Alkohol kann diese Wirkung haben."

# game/scripts/c13/c13.rpy:188
translate german c13s001_KiaraEileen_d0ea90e7:

    # kia "Pues después de cenar dijo que quería sexo. Había estado bebiendo cerveza durante la cena, y mientras esperaba a que la hiciera, añadiendo aún más alcohol al que llevaba cuando llegué."
    kia "Nun ja, nach dem Abendessen sagte sie, sie wolle Sex. Sie hatte während des Essens Bier getrunken, und während ich darauf wartete, dass sie es zubereitete, schüttete sie immer mehr Alkohol nach, zu dem, was sie schon getrunken hatte, als ich ankam."

# game/scripts/c13/c13.rpy:189
translate german c13s001_KiaraEileen_731cbece:

    # kia "No me apetecía nada. En ese momento estaba frustrada y enfadada. Se lo dije."
    kia "Ich hatte überhaupt keine Lust dazu. In dem Moment war ich frustriert und wütend. Das habe ich ihm auch gesagt."

# game/scripts/c13/c13.rpy:190
translate german c13s001_KiaraEileen_c32c4117:

    # mc "Y se puso violento."
    mc "Und er wurde gewalttätig."

# game/scripts/c13/c13.rpy:192
translate german c13s001_KiaraEileen_546b4da9:

    # kia "Levantó la mano para darme una bofetada, pero se paró a tiempo."
    kia "Er hob die Hand, um mich zu schlagen, hielt aber rechtzeitig inne."

# game/scripts/c13/c13.rpy:193
translate german c13s001_KiaraEileen_4dc08df1:

    # kia "Me entró miedo."
    kia "Ich bekam Angst."

# game/scripts/c13/c13.rpy:194
translate german c13s001_KiaraEileen_7d291a03:

    # kia "Le seguí a la habitación."
    kia "Ich folgte ihm ins Zimmer."

# game/scripts/c13/c13.rpy:196
translate german c13s001_KiaraEileen_bad62e5e:

    # kia "Se desnudó y aquello estaba fláccido. No iba a subir..."
    kia "Er zog sich aus, und sein Penis war schlaff. Er würde nicht mehr hart werden..."

# game/scripts/c13/c13.rpy:197
translate german c13s001_KiaraEileen_4c73c4a8:

    # kia "Y se enfadó aún más."
    kia "Und er wurde noch wütender."

# game/scripts/c13/c13.rpy:198
translate german c13s001_KiaraEileen_1403f12b:

    # kia "Empezó a culparme a mí. Dijo que ya no me vestía sexy para él nunca. Que ya no le excitaba. Que se iba a buscar una más joven que yo."
    kia "Er fing an, mir die Schuld zu geben. Er sagte, ich würde mich nie mehr sexy für ihn kleiden. Dass ich ihn nicht mehr anmache. Dass er sich jemand Jüngeren suchen würde."

# game/scripts/c13/c13.rpy:199
translate german c13s001_KiaraEileen_38f84272:

    # mc "*Entre dientes* ¡Capullo!"
    mc "*Zähneknirschend* Idiot!"

# game/scripts/c13/c13.rpy:201
translate german c13s001_KiaraEileen_27afa0b2:

    # kia "Me cogió por el brazo y empezó a llevarme de habitación en habitación. Enseñándome todo lo que según él estaba mal."
    kia "Er packte meinen Arm und führte mich von Zimmer zu Zimmer, wobei er mir alles zeigte, was seiner Meinung nach falsch war."

# game/scripts/c13/c13.rpy:202
translate german c13s001_KiaraEileen_2ec72b42:

    # kia "Platos por fregar... los de {b}SU{/b} comida y los de la cena..."
    kia "Geschirr abzuwaschen... das von seinem Mittagessen und das vom Abendessen..."

# game/scripts/c13/c13.rpy:203
translate german c13s001_KiaraEileen_0f44a1cc:

    # kia "Alguna ventana no estaba del todo limpia... la compra que habían entregado ese día estaba por guardar... había ropa por poner en la lavadora..."
    kia "Manche Fenster waren noch nicht ganz sauber... die an diesem Tag gelieferten Lebensmittel mussten noch weggeräumt werden... es gab Wäsche, die in die Waschmaschine musste..."

# game/scripts/c13/c13.rpy:205
translate german c13s001_KiaraEileen_f627363a:

    # eil "Ahí es donde llegué yo... el espectáculo era dantesco. Mi padre en pelotas arrastrando a mi madre, vestida, del brazo por el suelo en la sala de la lavadora..."
    eil "Da kam ich ins Spiel... die Szene war entsetzlich. Mein Vater, splitternackt, zerrte meine Mutter, die vollständig bekleidet war, am Arm über den Boden der Waschküche..."

# game/scripts/c13/c13.rpy:206
translate german c13s001_KiaraEileen_5ce2593c:

    # eil "Había ropa para poner una lavadora a lo sumo. Mi ropa de correr de la mañana, una muda de mi madre y ropa de mi padre. Olía a vómito."
    eil "Es war Wäsche, höchstens für eine Ladung. Meine Laufkleidung vom Morgen, ein paar Kleidungsstücke meiner Mutter und ein paar Sachen meines Vaters. Es roch nach Erbrochenem."

# game/scripts/c13/c13.rpy:207
translate german c13s001_KiaraEileen_9e333d94:

    # mc "¿Él no tiene manos? ¿No puede poner la lavadora mientras las dos estáis trabajando?"
    mc "Hat er denn keine Hände? Kann er nicht die Wäsche waschen, während ihr beide arbeitet?"

# game/scripts/c13/c13.rpy:209
translate german c13s001_KiaraEileen_037532b9:

    # eil "Eso sería muy degradante para él. ¿Cómo quieres que limpie o ponga a lavar la ropa si tiene a dos mujeres en casa?"
    eil "Das wäre sehr erniedrigend für ihn. Wie soll er denn putzen oder Wäsche waschen, wenn zwei Frauen im Haus sind?"

# game/scripts/c13/c13.rpy:210
translate german c13s001_KiaraEileen_a94fa32a:

    # eil "Es mejor estar todo el día en el sofá, viendo la tele y bebiendo, y después quejarse de que no hay nada hecho en casa."
    eil "Es ist besser, den ganzen Tag auf dem Sofa zu verbringen, fernzusehen und zu trinken, und sich dann zu beschweren, dass zu Hause nichts erledigt wird."

# game/scripts/c13/c13.rpy:211
translate german c13s001_KiaraEileen_42e46ebe:

    # mc "¿Entonces fue cuando os fuisteis?"
    mc "Das war also der Zeitpunkt, an dem Sie gegangen sind?"

# game/scripts/c13/c13.rpy:213
translate german c13s001_KiaraEileen_466c8b2b:

    # eil "Entonces es cuando a él le entraron las arcadas. No solo es un borracho. Es un mal bebedor con poco aguante."
    eil "Da fing er an zu würgen. Er ist nicht einfach nur ein Trinker. Er ist ein schlechter Trinker mit einer sehr geringen Toleranz."

# game/scripts/c13/c13.rpy:214
translate german c13s001_KiaraEileen_1bfe4335:

    # eil "Salió corriendo hacia el baño para vomitar."
    eil "Sie rannte ins Badezimmer, um sich zu übergeben."

# game/scripts/c13/c13.rpy:216
translate german c13s001_KiaraEileen_a0b345bb:

    # kia "Y se quedó dormido encima de la taza del wáter después de hacerlo."
    kia "Und danach schlief er auf der Toilettenschüssel ein."

# game/scripts/c13/c13.rpy:217
translate german c13s001_KiaraEileen_5a8eb6b5:

    # kia "En ese momento Eileen me convenció para irnos. Cuando se despertara, iba a ser peor."
    kia "In diesem Moment überzeugte mich Eileen zum Gehen. Wenn sie aufwachte, würde es noch schlimmer sein."

# game/scripts/c13/c13.rpy:219
translate german c13s001_KiaraEileen_499d7503:

    # kia "Metí algo de ropa en la bolsa de viaje, los cepillos de dientes y nos fuimos."
    kia "Ich packte ein paar Kleidungsstücke und die Zahnbürsten in die Reisetasche, und wir fuhren los."

# game/scripts/c13/c13.rpy:220
translate german c13s001_KiaraEileen_25565407:

    # kia "Eileen llamó a su amiga, la policía..."
    kia "Eileen rief ihre Freundin an, die Polizei..."

# game/scripts/c13/c13.rpy:222
translate german c13s001_KiaraEileen_09f97d02:

    # kia "Aunque le dije que no quería poner una denuncia..."
    kia "Obwohl ich ihm gesagt habe, dass ich keine Anzeige erstatten will..."

# game/scripts/c13/c13.rpy:224
translate german c13s001_KiaraEileen_1b2ac818:

    # eil "La llamaba para saber si podíamos quedarnos en su casa, no para poner una denuncia. Su abuelo se iba hoy y sabía que tendría una habitación libre."
    eil "Ich rief an, um zu fragen, ob wir bei ihr übernachten könnten, nicht um eine Beschwerde einzureichen. Ihr Großvater reiste heute ab, und sie wusste, dass sie ein Gästezimmer frei hätte."

# game/scripts/c13/c13.rpy:225
translate german c13s001_KiaraEileen_47d710b1:

    # eil "Pero está en San Diego con sus padres. No le he dicho por qué la llamaba, no quería preocuparla."
    eil "Aber sie ist bei ihren Eltern in San Diego. Ich habe ihr nicht gesagt, warum ich angerufen habe; ich wollte sie nicht beunruhigen."

# game/scripts/c13/c13.rpy:226
translate german c13s001_KiaraEileen_0506f6c5:

    # eil "Y entonces te he llamado a ti. No es que fueras la segunda opción, pero creía que..."
    eil "Und dann habe ich dich angerufen. Nicht, dass du meine zweite Wahl gewesen wärst, aber ich dachte..."

# game/scripts/c13/c13.rpy:227
translate german c13s001_KiaraEileen_cfde5b02:

    # mc "Que si tu madre hablaba con una policía, Alexia la convencería para poner la denuncia."
    mc "Wenn deine Mutter mit einem Polizisten sprechen würde, würde Alexia sie davon überzeugen, Anzeige zu erstatten."

# game/scripts/c13/c13.rpy:229
translate german c13s001_KiaraEileen_7cb453b2:

    # eil "Al menos la haría entrar en razón. En ese momento mi madre estaba diciendo que buscásemos algún sitio donde pasar esta noche."
    eil "Zumindest würde es sie zur Vernunft bringen. In dem Moment meinte meine Mutter, wir sollten uns eine Unterkunft für die Nacht suchen."

# game/scripts/c13/c13.rpy:230
translate german c13s001_KiaraEileen_0dce7da8:

    # eil "Sólo esta noche..."
    eil "Nur heute Abend..."

# game/scripts/c13/c13.rpy:232
translate german c13s001_KiaraEileen_5863b783:

    # kia "¿Qué querías que hiciera? ¿Que abandonase a mi marido y mi casa? Todos los matrimonios tienen problemas..."
    kia "Was sollte ich denn tun? Meinen Mann und mein Zuhause verlassen? Jede Ehe hat Probleme..."

# game/scripts/c13/c13.rpy:233
translate german c13s001_KiaraEileen_ab6bae3b:

    # mc "Creo que es lo mejor, al menos por unos días. Que le vea las orejas al lobo."
    mc "Ich denke, es ist das Beste so, zumindest für ein paar Tage. Er soll die drohende Gefahr erkennen."

# game/scripts/c13/c13.rpy:234
translate german c13s001_KiaraEileen_72b0ae97:

    # mc "A lo mejor reacciona y vuelve a dejar la bebida..."
    mc "Vielleicht kommt er ja zur Vernunft und hört wieder mit dem Trinken auf..."

# game/scripts/c13/c13.rpy:236
translate german c13s001_KiaraEileen_11435d8b:

    # eil "Es lo que le he dicho. Una semana como mínimo. Al final ha aceptado. Mañana buscaremos un hotel."
    eil "Das habe ich ihm auch gesagt. Mindestens eine Woche. Schließlich hat er zugestimmt. Wir suchen morgen ein Hotel."

# game/scripts/c13/c13.rpy:237
translate german c13s001_KiaraEileen_f27e6e78:

    # mc "No hace falta. Tenéis esta habitación para vosotras todo el tiempo que queráis."
    mc "Das ist nicht nötig. Ihr habt das Zimmer so lange für euch allein, wie ihr wollt."

# game/scripts/c13/c13.rpy:239
translate german c13s001_KiaraEileen_405969b9:

    # kia "No podemos hacerte eso. No podemos echarte de tu habitación durante una semana. Mañana buscamos un hotel o algo donde quedarnos unos días."
    kia "Das können wir dir nicht antun. Wir können dich nicht für eine Woche aus deinem Zimmer werfen. Morgen suchen wir ein Hotel oder eine andere Unterkunft für ein paar Tage."

# game/scripts/c13/c13.rpy:240
translate german c13s001_KiaraEileen_278fe9f3:

    # mc "Entonces, en casa de [nor] hay una habitación vacía. Es para las estudiantes que llegan en otoño. Al menos hasta entonces la podéis usar."
    mc "Im Haus von [nor] ist ein Zimmer frei. Es ist für die Studenten, die im Herbst ankommen. Du kannst es zumindest bis dahin nutzen."

# game/scripts/c13/c13.rpy:241
translate german c13s001_KiaraEileen_f61f3aa7:

    # mc "A [nor] no le va a importar en el momento en que sepa vuestra situación, os lo aseguro. Al menos la situación que queráis explicarle."
    mc "[nor] wird es egal sein, sobald er deine Situation kennt, das versichere ich dir. Zumindest nicht die Situation, die du ihm erklären willst."

# game/scripts/c13/c13.rpy:243
translate german c13s001_KiaraEileen_668d609e:

    # eil "¿De verdad crees que nos va a dejar dormir en su casa?"
    eil "Glaubst du wirklich, er lässt uns bei sich übernachten?"

# game/scripts/c13/c13.rpy:244
translate german c13s001_KiaraEileen_ff59411a:

    # mc "Eile, a [nor] siempre le has gustado. No va a tener ningún problema con ello. ¿Cuánto hace que no la ves?"
    mc "Eile, [nor] mochte dich schon immer. Sie wird kein Problem damit haben. Wie lange ist es her, dass du sie gesehen hast?"

# game/scripts/c13/c13.rpy:246
translate german c13s001_KiaraEileen_85f495a6:

    # eil "Mucho. No tengo ni idea de cuanto... ¿un año? ¿dos? Al contrario que tú, cuando ella lleva a [eri] al trabajo, no entra a tomarse ni siquiera un café."
    eil "Sehr lange. Ich habe keine Ahnung, wie lange... ein Jahr? Zwei? Anders als du geht sie, wenn sie [eri] mit zur Arbeit nimmt, nicht mal auf einen Kaffee."

# game/scripts/c13/c13.rpy:247
translate german c13s001_KiaraEileen_d46540c0:

    # mc "Entonces no te diré nada. Por la mañana te llevarás una pequeña sorpresa."
    mc "Dann werde ich dir nichts verraten. Du wirst morgen früh eine kleine Überraschung erleben."

# game/scripts/c13/c13.rpy:248
translate german c13s001_KiaraEileen_b94084a4:

    # mc "Creo que con esto está todo arreglado, al menos el alojamiento. ¿Necesitáis algo más?"
    mc "Ich denke, das deckt alles ab, zumindest die Unterkunft. Benötigen Sie sonst noch etwas?"

# game/scripts/c13/c13.rpy:250
translate german c13s001_KiaraEileen_80032951:

    # kia "Si nos vamos a quedar una semana, deberíamos pasar por casa a buscar más ropa. Metí ropa para un par de días en la bolsa. Y ni siquiera los pijamas..."
    kia "Wenn wir eine Woche bleiben, sollten wir vorher noch mal nach Hause fahren, um mehr Kleidung zu holen. Ich habe nur genug für ein paar Tage eingepackt. Und nicht mal einen Schlafanzug..."

# game/scripts/c13/c13.rpy:251
translate german c13s001_KiaraEileen_d2d77d32:

    # mc "Yo de vosotras no iría mientras Solomon esté allí, o al menos no solas. Si queréis os acompaño."
    mc "Ich würde an deiner Stelle nicht hingehen, solange Salomo da ist, oder zumindest nicht allein. Wenn du möchtest, kann ich dich begleiten."

# game/scripts/c13/c13.rpy:253
translate german c13s001_KiaraEileen_d58ee944:

    # eil "Yo puedo aguantar dos o tres días perfectamente. Los jueves por la noche mi padre se va de copas con sus amigos y podríamos ir a casa."
    eil "Zwei oder drei Tage schaffe ich problemlos. Donnerstagsabends geht mein Vater mit seinen Freunden etwas trinken, und wir könnten zu ihm nach Hause gehen."

# game/scripts/c13/c13.rpy:254
translate german c13s001_KiaraEileen_4e4e6a42:

    # mc "Kiara, ¿tú tienes ropa para aguantar hasta el jueves? Si no, habiendo 11 mujeres en casa, seguro que alguna os puede dejar ropa. O podéis coger mis camisetas; os quedan geniales."
    mc "Kiara, hast du genug Kleidung bis Donnerstag? Falls nicht, bei elf Frauen im Haus findet sich bestimmt eine, die dir etwas leihen kann. Oder du nimmst meine T-Shirts; die stehen dir super."

# game/scripts/c13/c13.rpy:255
translate german c13s001_KiaraEileen_ad312c1d:

    # mc "Además, aunque vivamos en medio de la nada, también tenemos lavadoras. *Risa*"
    mc "Und obwohl wir mitten im Nirgendwo wohnen, haben wir auch Waschmaschinen. *lacht*"

# game/scripts/c13/c13.rpy:257
translate german c13s001_KiaraEileen_814c0592:

    # kia "No te preocupes, cogí mi ropa de trabajo y dos uniformes para Eileen, eso es lo más importante. El resto se puede comprar o lavar hasta que el jueves podamos volver."
    kia "Keine Sorge, ich habe meine Arbeitskleidung und zwei Uniformen für Eileen eingepackt; das ist das Wichtigste. Den Rest können wir kaufen oder waschen, bis wir am Donnerstag zurückfahren können."

# game/scripts/c13/c13.rpy:258
translate german c13s001_KiaraEileen_9445b609:

    # mc "Ahora que pienso, el miércoles vuelve Alexia, con lo que también nos podría acompañar el jueves si fuera necesario. Tener una policía cerca impone."
    mc "Jetzt, wo ich darüber nachdenke, kommt Alexia am Mittwoch zurück, also könnte sie notfalls auch am Donnerstag zu uns stoßen. Die Anwesenheit eines Polizisten in der Nähe ist beängstigend."

# game/scripts/c13/c13.rpy:259
translate german c13s001_KiaraEileen_8ea7b98f:

    # mc "Y, una vez aclarado todo esto, os voy a dejar dormir."
    mc "Und wenn das alles geklärt ist, lasse ich dich schlafen."

# game/scripts/c13/c13.rpy:261
translate german c13s001_KiaraEileen_416c371b:

    # mc "¿Puedo hablar un momento en privado contigo, Eileen?"
    mc "Darf ich Sie kurz unter vier Augen sprechen, Eileen?"

# game/scripts/c13/c13.rpy:263
translate german c13s001_KiaraEileen_7afdc227:

    # eil "Sí, vamos fuera. Ahora vuelvo, Mamá."
    eil "Ja, lass uns nach draußen gehen. Ich bin gleich wieder da, Mama."

# game/scripts/c13/c13.rpy:265
translate german c13s001_KiaraEileen_05097a2b:

    # kia "No es necesario. Voy al lavabo y os dejo un poco de privacidad. ¿Cuánto tiempo necesitáis?"
    kia "Das ist nicht nötig. Ich gehe kurz auf die Toilette und lasse Sie dann in Ruhe. Wie viel Zeit benötigen Sie?"

# game/scripts/c13/c13.rpy:266
translate german c13s001_KiaraEileen_8572b191:

    # mc "*Risa* No es eso, Kiara. No vamos a enrollarnos aquí... al menos no hoy. *Risa*"
    mc "*Lacht* So ist es nicht, Kiara. Wir werden uns da nicht einmischen... zumindest nicht heute. *Lacht*"

# game/scripts/c13/c13.rpy:267
translate german c13s001_KiaraEileen_1f6f2478:

    # kia "*Risa* Vale, pues vuelvo en cinco minutos. ¿Tendrás suficiente?"
    kia "*lacht* Okay, ich bin in fünf Minuten wieder da. Reicht das?"

# game/scripts/c13/c13.rpy:268
translate german c13s001_KiaraEileen_53c320af:

    # mc "Sí, por supuesto. La primera puerta a la izquierda una vez pases el gimnasio."
    mc "Ja, natürlich. Die erste Tür links, sobald man am Fitnessstudio vorbeigegangen ist."

# game/scripts/c13/c13.rpy:270
translate german c13s001_KiaraEileen_3c732c7a:

    # eil "¿De qué querías hablar que no pudieras hablar delante de mi madre?"
    eil "Worüber wolltest du sprechen, worüber du nicht vor meiner Mutter sprechen konntest?"

# game/scripts/c13/c13.rpy:273
translate german c13s001_KiaraEileen_e87a4a31:

    # mc "Ya sabes que estoy con [eri]. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Du weißt, dass ich auf der Seite von [eri] stehe. Ich möchte nur, dass Kiara sich bewusst ist, dass sie Dinge sehen könnte, die sie überraschen, und ich möchte nicht, dass sie denkt, ich würde dich täuschen."

# game/scripts/c13/c13.rpy:275
translate german c13s001_KiaraEileen_4cf7ce64:

    # mc "Ya sabes que estoy con Alexia. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Du weißt, dass ich mit Alexia zusammen bin. Ich möchte nur, dass Kiara weiß, dass sie vielleicht Dinge sieht, die sie überraschen, und ich möchte nicht, dass sie denkt, ich betrüge dich."

# game/scripts/c13/c13.rpy:277
translate german c13s001_KiaraEileen_9b77594e:

    # mc "Ya sabes que estoy con alguien más. Solo me gustaría que Kiara estuviera sobreaviso de que puede ver cosas que le sorprendan, y no quiero que piense que te estoy engañando."
    mc "Du weißt doch, dass ich jemand anderen treffe. Ich möchte nur, dass Kiara weiß, dass sie vielleicht Dinge sieht, die sie überraschen, und ich möchte nicht, dass sie denkt, ich betrüge dich."

# game/scripts/c13/c13.rpy:279
translate german c13s001_KiaraEileen_e8ce2c07:

    # eil "Tienes razón, no había caído en eso. Le diré lo especial de nuestra relación para que no te saque los ojos si te ve en los brazos de otra."
    eil "Du hast recht, daran hatte ich gar nicht gedacht. Ich werde ihm sagen, wie besonders unsere Beziehung ist, damit er dir nicht die Augen aussticht, wenn er dich in den Armen eines anderen sieht."

# game/scripts/c13/c13.rpy:280
translate german c13s001_KiaraEileen_85ef00a7:

    # mc "Además..."
    mc "Außerdem..."

# game/scripts/c13/c13.rpy:282
translate german c13s001_KiaraEileen_7435106d:

    # mc "Me moría por besarte antes de ir a dormir."
    mc "Ich wollte dich unbedingt küssen, bevor ich einschlafe."

# game/scripts/c13/c13.rpy:285
translate german c13s001_KiaraEileen_ab44b008:

    # mc "Tan solo me moría por besarte antes de ir a dormir."
    mc "Ich wollte dich unbedingt küssen, bevor ich einschlafe."

# game/scripts/c13/c13.rpy:286
translate german c13s001_KiaraEileen_b919e696:

    # eil "No te tienes que esconder de mi madre para besarme. Ni de mi madre ni de nadie. Soy una adulta y puedo besar a quien quiera. Y al único que quiero besar es a ti."
    eil "Du musst dich nicht vor meiner Mutter verstecken, um mich zu küssen. Nicht vor meiner Mutter, vor niemandem. Ich bin erwachsen und kann küssen, wen ich will. Und die einzige Person, die ich küssen will, bist du."

# game/scripts/c13/c13.rpy:287
translate german c13s001_KiaraEileen_a4eab181:

    # eil "Si necesitas decirle a alguien que salimos juntos, puedes hacerlo. Yo tampoco me tengo que esconder."
    eil "Wenn du jemandem erzählen willst, dass wir zusammen sind, kannst du das tun. Ich muss es auch nicht verheimlichen."

# game/scripts/c13/c13.rpy:288
translate german c13s001_KiaraEileen_1c7cd109:

    # mc "Entonces no me esconderé. Me voy a ir a mi sofá y os voy a dejar descansar... Un poco más y me olvido de coger la ropa."
    mc "Dann verstecke ich mich nicht. Ich gehe jetzt auf mein Sofa und lasse euch alle ausruhen... Ich hätte beinahe vergessen, mich anzuziehen."

# game/scripts/c13/c13.rpy:290
translate german c13s001_KiaraEileen_50dfb39e:

    # mc "Hasta mañana, mi amor."
    mc "Bis morgen, meine Liebe."

# game/scripts/c13/c13.rpy:291
translate german c13s001_KiaraEileen_73d51b30:

    # eil "Hasta mañana, mi vida. Te quiero."
    eil "Bis morgen, mein Schatz. Ich liebe dich."

# game/scripts/c13/c13.rpy:292
translate german c13s001_KiaraEileen_90083b80:

    # mc "Y yo a ti."
    mc "Und ich dich."

# game/scripts/c13/c13.rpy:295
translate german c13s001_KiaraEileen_b47b16b6:

    # kia "¿Dónde has dicho que estaba el lavabo?"
    kia "Wo genau soll das Waschbecken sein?"

# game/scripts/c13/c13.rpy:296
translate german c13s001_KiaraEileen_f445e6ec:

    # mc "La primera puerta a la izquierda una vez pases el gimnasio."
    mc "Die erste Tür links, sobald man am Fitnessstudio vorbeigegangen ist."

# game/scripts/c13/c13.rpy:298
translate german c13s001_KiaraEileen_f364d0f9:

    # eil "Gracias por todo, [mc]. No sé qué hubiéramos hecho sin ti hoy."
    eil "Vielen Dank für alles, [mc]. Ich weiß nicht, was wir heute ohne dich gemacht hätten."

# game/scripts/c13/c13.rpy:299
translate german c13s001_KiaraEileen_e53ba6e2:

    # mc "Para eso estamos los amigos. Ya sabes que puedes contar conmigo para lo que necesites."
    mc "Dafür sind Freunde da. Du weißt, dass du dich in allen Belangen auf mich verlassen kannst."

# game/scripts/c13/c13.rpy:301
translate german c13s001_KiaraEileen_c4cd41ac:

    # eil "Cuánto te he echado de menos estos tres años. No hay hombres como tú."
    eil "Wie sehr ich dich in den letzten drei Jahren vermisst habe. Es gibt keine Männer wie dich."

# game/scripts/c13/c13.rpy:302
translate german c13s001_KiaraEileen_8193145e:

    # mc "¿Como yo? Espera... ¿cómo me llamabas cuando salíamos juntos? ¿Cabeza hueca?"
    mc "Wie du mich? Warte mal... wie hast du mich genannt, als wir zusammen waren? Luftikus?"

# game/scripts/c13/c13.rpy:304
translate german c13s001_KiaraEileen_8f3c4879:

    # eil "No, eso era lo que tú llamabas me llamabas a mí cuando empezamos a salir. *Risa*"
    eil "Nein, so hast du mich immer genannt, als wir angefangen haben, uns zu treffen. *lacht*"

# game/scripts/c13/c13.rpy:305
translate german c13s001_KiaraEileen_cdd0ac73:

    # mc "Bueno, te voy a dejar descansar. Tienes que estar agotada después de trabajar y todo el problema que te has encontrado al llegar a casa."
    mc "Okay, ich lasse dich jetzt ausruhen. Du musst nach der Arbeit und all den Problemen, die du zu Hause hattest, total erschöpft sein."

# game/scripts/c13/c13.rpy:306
translate german c13s001_KiaraEileen_41ad32af:

    # mc "Hasta mañana, Eile."
    mc "Bis morgen, Eile."

# game/scripts/c13/c13.rpy:307
translate german c13s001_KiaraEileen_3fd283cd:

    # eil "Hasta mañana, [mc]."
    eil "Bis morgen, [mc]."

# game/scripts/c13/c13.rpy:309
translate german c13s001_KiaraEileen_3523084d:

    # kia "¿Ya te marchas?"
    kia "Gehst du schon?"

# game/scripts/c13/c13.rpy:310
translate german c13s001_KiaraEileen_2821dae0:

    # mc "Sí, es tarde y tenéis que descansar. Mañana tengo que ir a un par de sitios, pero si te despiertas pronto puedo llevarte al hospital."
    mc "Ja, es ist spät und du musst dich ausruhen. Ich muss morgen noch ein paar Termine wahrnehmen, aber wenn du früh aufstehst, kann ich dich ins Krankenhaus bringen."

# game/scripts/c13/c13.rpy:312
translate german c13s001_KiaraEileen_4630e054:

    # kia "[mc], ya te he dicho que no quería poner una denuncia..."
    kia "[mc], ich habe Ihnen doch bereits gesagt, dass ich keine Beschwerde einreichen möchte..."

# game/scripts/c13/c13.rpy:313
translate german c13s001_KiaraEileen_59f239a8:

    # mc "Te dejaré en manos de una enfermera que es buena amiga también. Si no quieres poner denuncia, no te va a obligar, pero al menos verá como está ese hematoma."
    mc "Ich überlasse Ihnen eine Krankenschwester, die gleichzeitig eine gute Freundin ist. Wenn Sie keine Anzeige erstatten möchten, wird sie Sie nicht dazu zwingen, aber zumindest wird sie sich den blauen Fleck ansehen."

# game/scripts/c13/c13.rpy:315
translate german c13s001_KiaraEileen_2066e28b:

    # "Kiara te abraza con fuerza. Es un abrazo que dice a gritos que está herida, más allá de las heridas físicas, que es vulnerable, y que necesita esa curación que dice que tus abrazos ofrecen."
    "Kiara umarmt dich fest. Es ist eine Umarmung, die deutlich macht, dass sie leidet, über die körperlichen Wunden hinaus, dass sie verletzlich ist und dass sie die Heilung braucht, die deine Umarmungen ihr ihrer Meinung nach bieten."

# game/scripts/c13/c13.rpy:316
translate german c13s001_KiaraEileen_cd4373aa:

    # kia "Gracias, [mc]. Por darnos un techo y por entender mi decisión sobre la denuncia."
    kia "Vielen Dank, [mc]. Dafür, dass Sie uns ein Dach über dem Kopf gegeben und meine Entscheidung, die Beschwerde einzureichen, verstanden haben."

# game/scripts/c13/c13.rpy:317
translate german c13s001_KiaraEileen_c06cd2f2:

    # mc "No la comparto ni la comprendo, pero tengo que respetarla. No puedo obligarte a presentar una denuncia si no quieres."
    mc "Ich stimme dem nicht zu und verstehe es auch nicht, aber ich muss es respektieren. Ich kann Sie nicht zwingen, eine Beschwerde einzureichen, wenn Sie das nicht wollen."

# game/scripts/c13/c13.rpy:318
translate german c13s001_KiaraEileen_d4dbd92c:

    # "Pasáis unos minutos en silencio, disfrutando del abrazo. Kiara se separa de ti reluctantemente."
    "Ihr verbringt einige Minuten in Stille und genießt die Umarmung. Kiara löst sich widerwillig von dir."

# game/scripts/c13/c13.rpy:320
translate german c13s001_KiaraEileen_fa9f4ae1:

    # kia "Buenas noches, [mc]. Que descanses bien."
    kia "Gute Nacht, [mc]. Schlaf gut."

# game/scripts/c13/c13.rpy:321
translate german c13s001_KiaraEileen_556ca554:

    # mc "Buenas noches, Kiara. Duerme todo lo que puedas."
    mc "Gute Nacht, Kiara. Schlaf so viel du kannst."

# game/scripts/c13/c13.rpy:348
translate german c13s001_SleepingInTheCouch_c4d9422a:

    # "Vuelves a la tercera planta después de cambiarte a algo más cómodo para dormir."
    "Sie kehren in den dritten Stock zurück, nachdem Sie sich in bequemere Schlafkleidung umgezogen haben."

# game/scripts/c13/c13.rpy:349
translate german c13s001_SleepingInTheCouch_e2a8a1db:

    # "Nunca pensaste que echarías de menos a Lisa en ese sofá."
    "Du hättest nie gedacht, dass du Lisa auf diesem Sofa vermissen würdest."

# game/scripts/c13/c13.rpy:351
translate german c13s001_SleepingInTheCouch_4f7bd40e:

    # "Te tumbas mirando al techo. Sabes que te va a costar dormirte después de los eventos de la noc...zzzz"
    "Du liegst da und starrst an die Decke. Du weißt, dass es nach den Ereignissen der Nacht schwer werden wird, einzuschlafen…zzzz"

# game/scripts/c13/c13.rpy:353
translate german c13s001_SleepingInTheCouch_83246def:

    # centered "{size=+20}{b}DIA 15 - MARTES \n 6:13{/b}{/size}"
    centered "{size=+20}{b}TAG 15 - DIENSTAG \n 6:13{/b}{/size}"

# game/scripts/c13/c13.rpy:354
translate german c13s001_SleepingInTheCouch_bc02ef79:

    # "Te despiertan unos pasos y la puerta del baño que se cierra."
    "Sie werden durch Schritte und das Zuschlagen der Badezimmertür geweckt."

# game/scripts/c13/c13.rpy:356
translate german c13s001_SleepingInTheCouch_22bfb38d:

    # "Miras el reloj del móvil. Las 6:13. Difícilmente vas a poder volver a dormirte. Ya ha amanecido."
    "Du schaust auf die Uhr deines Handys. 6:13 Uhr. An Wiedereinschlafen ist nicht mehr zu denken. Es dämmert bereits."

# game/scripts/c13/c13.rpy:359
translate german c13s001_SleepingInTheCouch_a44d8959:

    # kat "Buenos días, [mc]. ¿Qué haces aquí? ¿Esperando a Lisa?"
    kat "Guten Morgen, [mc]. Was machst du hier? Wartest du auf Lisa?"

# game/scripts/c13/c13.rpy:360
translate german c13s001_SleepingInTheCouch_c20e358c:

    # mc "No, hay dos chicas en mi habitación y quería dejarlas dormir tranquilamente."
    mc "Nein, es sind zwei Mädchen in meinem Zimmer und ich wollte, dass sie in Ruhe schlafen."

# game/scripts/c13/c13.rpy:362
translate german c13s001_SleepingInTheCouch_688fa6ff:

    # kat "¿Dos chicas en tu habitación? ¡Tenemos un macho en la casa!"
    kat "Zwei Mädchen in deinem Zimmer? Wir haben einen Mann im Haus!"

# game/scripts/c13/c13.rpy:363
translate german c13s001_SleepingInTheCouch_a34a775e:

    # mc "*Risa* No, no va por ahí. Son dos amigas que necesitaban un sitio donde pasar la noche. Les he prestado mi cama."
    mc "*Lacht* Nein, so ist es nicht. Es sind zwei Freunde, die eine Unterkunft für die Nacht brauchten. Ich habe ihnen mein Bett geliehen."

# game/scripts/c13/c13.rpy:365
translate german c13s001_SleepingInTheCouch_620057e0:

    # kat "Entonces no es un macho, es un caballero. Podemos hacer un intercambio. Subo yo a tu habitación y tu duermes en mi cama. *Risa*"
    kat "Er ist also kein Macho, sondern ein Gentleman. Wir können einen Tausch aushandeln. Ich gehe in dein Zimmer und du schläfst in meinem Bett. *Lacht*"

# game/scripts/c13/c13.rpy:366
translate german c13s001_SleepingInTheCouch_0ed05e30:

    # mc "*Risa* Creo que os lo podríais pasar muy bien juntas, pero creo que no como tú esperarías."
    mc "*Lacht* Ich glaube, ihr zwei könntet eine tolle Zeit zusammen haben, aber nicht so, wie ihr es erwarten würdet."

# game/scripts/c13/c13.rpy:367
translate german c13s001_SleepingInTheCouch_07a63ac4:

    # mc "Una era mi novia en el instituto y la otra es su madre. Casada. Con un hombre."
    mc "Die eine war meine Freundin aus der Highschool, die andere ist ihre Mutter. Verheiratet. Mit einem Mann."

# game/scripts/c13/c13.rpy:369
translate german c13s001_SleepingInTheCouch_5ade8e4a:

    # kat "*Risa* Entonces no te cambio la cama. Además, Kim se podría asustar si se despierta y te ve a ti en vez de a mí."
    kat "*Lacht* Dann werde ich dein Bett nicht wechseln. Außerdem könnte Kim sich erschrecken, wenn sie aufwacht und dich statt mir sieht."

# game/scripts/c13/c13.rpy:371
translate german c13s001_SleepingInTheCouch_0f251b26:

    # kat "Después de lo que le dijiste ayer del mapa de su piel... creo que la hiciste feliz por todo el día."
    kat "Nach dem, was du ihr gestern über die Karte ihrer Haut erzählt hast... glaube ich, dass du sie den ganzen Tag glücklich gemacht hast."

# game/scripts/c13/c13.rpy:372
translate german c13s001_SleepingInTheCouch_bb4228c0:

    # mc "*Risa* Lo más divertido de todo es que no lo dije sobre ella en concreto, sino que lo dije en un hipotético caso. Además sonó muy cursi."
    mc "*lacht* Das Lustigste ist, dass ich es nicht über sie persönlich gesagt habe, sondern nur in einem hypothetischen Szenario. Es klang auch total kitschig."

# game/scripts/c13/c13.rpy:374
translate german c13s001_SleepingInTheCouch_3b9a9045:

    # kat "Después de lo que le dijiste ayer sobre su piel... creo que aún está enfadada contigo."
    kat "Nach dem, was du gestern über ihre Haut zu ihr gesagt hast... glaube ich, dass sie immer noch sauer auf dich ist."

# game/scripts/c13/c13.rpy:375
translate german c13s001_SleepingInTheCouch_0c54b117:

    # mc "Bueno, no era mi intención enfadarla, tan solo es que... creo que tenía razón si tanto le molesta llamar la atención."
    mc "Nun ja, ich wollte sie nicht verärgern, es ist nur so... Ich denke, sie hatte Recht, wenn es sie so sehr stört, im Mittelpunkt der Aufmerksamkeit zu stehen."

# game/scripts/c13/c13.rpy:377
translate german c13s001_SleepingInTheCouch_eaf840b2:

    # kat "¿Te importa que me siente?"
    kat "Darf ich mich setzen?"

# game/scripts/c13/c13.rpy:378
translate german c13s001_SleepingInTheCouch_c87da1de:

    # mc "Por supuesto que no. Soy yo quien ha invadido vuestra planta."
    mc "Natürlich nicht. Ich bin es, der in deine Pflanze eingedrungen ist."

# game/scripts/c13/c13.rpy:379
translate german c13s001_SleepingInTheCouch_8cd07e23:

    # kat "Y nosotras hemos invadido tu casa. Lo podríamos llamar un empate."
    kat "Und wir sind in dein Haus eingedrungen. Man könnte es ein Unentschieden nennen."

# game/scripts/c13/c13.rpy:380
translate german c13s001_SleepingInTheCouch_31ab9b11:

    # mc "¿Qué tal la adaptación a la nueva casa y a la nueva universidad?"
    mc "Wie läuft die Eingewöhnung im neuen Haus und an der neuen Universität?"

# game/scripts/c13/c13.rpy:382
translate german c13s001_SleepingInTheCouch_a9cde451:

    # kat "La universidad está genial. Tiene un muy buen programa de oceanografía y está cerca del mar. Estudiar en Phoenix sobre acuarios no tiene el mismo valor."
    kat "Die Universität ist großartig. Sie hat ein sehr gutes Ozeanographie-Programm und liegt in unmittelbarer Nähe zum Meer. Aquarienforschung in Phoenix hat nicht denselben Wert."

# game/scripts/c13/c13.rpy:383
translate german c13s001_SleepingInTheCouch_5aa8514f:

    # mc "Está bien, es una universidad relativamente pequeña, pero de muy buen nivel."
    mc "Das ist in Ordnung, es ist eine relativ kleine Universität, aber von sehr hohem Standard."

# game/scripts/c13/c13.rpy:384
translate german c13s001_SleepingInTheCouch_f4b5c5b2:

    # mc "¿Y la casa? ¿Algún problema hasta ahora?"
    mc "Und das Haus? Gab es bisher irgendwelche Probleme?"

# game/scripts/c13/c13.rpy:386
translate german c13s001_SleepingInTheCouch_138040f8:

    # kat "La casa es impresionante. Creía que siendo tan pocas podía haber problemas entre nosotras. Ya sabes... ser la primera gallina del corral y esas cosas."
    kat "Das Haus ist fantastisch. Ich dachte, mit so wenigen Leuten könnte es Probleme geben. Man kennt das ja... man ist schließlich das erste Huhn im Hühnerstall."

# game/scripts/c13/c13.rpy:387
translate german c13s001_SleepingInTheCouch_f34c0968:

    # kat "Además, ya conocía a Lisa y me imaginaba que iba a luchar por esa posición. Pero me está sorprendiendo mucho. Parece una mujer diferente de la de Phoenix."
    kat "Außerdem kannte ich Lisa ja schon und hatte mir vorgestellt, dass sie um die Position kämpfen würde. Aber sie überrascht mich wirklich. Sie wirkt wie eine ganz andere Frau als die in Phoenix."

# game/scripts/c13/c13.rpy:388
translate german c13s001_SleepingInTheCouch_a3db4774:

    # mc "Parece incluso una mujer diferente de la que llegó el viernes al aeropuerto."
    mc "Sie sieht sogar aus wie eine andere Frau als die, die am Freitag am Flughafen ankam."

# game/scripts/c13/c13.rpy:390
translate german c13s001_SleepingInTheCouch_4cc0eb54:

    # kat "No sé que le dais de comer, pero seguid haciéndolo. Me gusta más esta Lisa."
    kat "Ich weiß nicht, was du ihr fütterst, aber mach weiter so. Mir gefällt diese Lisa besser."

# game/scripts/c13/c13.rpy:391
translate german c13s001_SleepingInTheCouch_3bf2b707:

    # mc "A mí también. Hoy llega la última chica. Saira, de India."
    mc "Ich auch. Heute kommt das letzte Mädchen an. Saira, aus Indien."

# game/scripts/c13/c13.rpy:393
translate german c13s001_SleepingInTheCouch_62533d58:

    # kat "¡Oh! ¿Una belleza exótica?"
    kat "Oh! Eine exotische Schönheit?"

# game/scripts/c13/c13.rpy:394
translate german c13s001_SleepingInTheCouch_7e936e1f:

    # mc "Sí, lo es. Es una preciosidad. Nos conocemos de Portland."
    mc "Ja, das stimmt. Es ist wunderschön. Wir kennen uns aus Portland."

# game/scripts/c13/c13.rpy:395
translate german c13s001_SleepingInTheCouch_f08cc311:

    # kat "¿Otra ex-novia?"
    kat "Noch eine Ex-Freundin?"

# game/scripts/c13/c13.rpy:396
translate german c13s001_SleepingInTheCouch_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Ja, warum fragen Sie?"

# game/scripts/c13/c13.rpy:398
translate german c13s001_SleepingInTheCouch_1bfae0f9:

    # kat "Tienes a tu ex-novia del instituto durmiendo en tu habitación y vas a tener a tu ex-novia de la universidad durmiendo justo debajo."
    kat "Deine Ex-Freundin aus der Highschool schläft in deinem Zimmer und deine Ex-Freundin aus dem College schläft demnächst direkt unter dir."

# game/scripts/c13/c13.rpy:399
translate german c13s001_SleepingInTheCouch_d3afcc31:

    # kat "¿Tú has oido la expresión \"Pelea de Gatas\"?"
    kat "Haben Sie schon einmal den Ausdruck „Zickenkrieg“ gehört?"

# game/scripts/c13/c13.rpy:400
translate german c13s001_SleepingInTheCouch_57a8f307:

    # mc "Ni Eileen ni Saira son así."
    mc "Weder Eileen noch Saira sind so."

# game/scripts/c13/c13.rpy:402
translate german c13s001_SleepingInTheCouch_58666c43:

    # kat "¿Eileen? ¿Pelirroja? ¿Guapísima? ¿Ojos azules? ¿Compañera de trabajo de [eri]?"
    kat "Eileen? Rothaarig? Wunderschön? Blaue Augen? [eri]s Kollegin?"

# game/scripts/c13/c13.rpy:403
translate german c13s001_SleepingInTheCouch_3f08eb51:

    # mc "Sí, ¿por qué?"
    mc "Ja, warum?"

# game/scripts/c13/c13.rpy:405
translate german c13s001_SleepingInTheCouch_39339162:

    # kat "¡Eres mi héroe! Si estando tan gordo como estabas en el instituto conseguiste que esa belleza se fijara en ti, hay esperanzas para el resto de nosotras."
    kat "Du bist mein Held! Wenn du es geschafft hast, dass diese Schönheit dich bemerkt hat, als du noch so dick warst wie in der High School, dann gibt es Hoffnung für uns alle."

# game/scripts/c13/c13.rpy:412
translate german c13s001_SleepingInTheCouch_6bb56f62:

    # mc "Y no solo a cualquier chica. A cualquier persona. Eres divertida, inteligente, guapa..."
    mc "Und das nicht nur zu irgendeinem Mädchen. Zu jedem. Du bist witzig, klug, wunderschön..."

# game/scripts/c13/c13.rpy:414
translate german c13s001_SleepingInTheCouch_f8619787:

    # kat "[mc], ¿me estás tirando los trastos? *Risa* Por si no lo recuerdas, no me interesan los hombres... desde hace mucho."
    kat "[mc], machst du mich etwa an? *Lacht* Falls du es vergessen hast: Ich bin schon lange nicht mehr an Männern interessiert."

# game/scripts/c13/c13.rpy:415
translate german c13s001_SleepingInTheCouch_0c9edb7a:

    # mc "{b}¿Qué? ¡No!{/b} * Risa* Eres de las pocas mujeres a quien le puedo decir que es guapa y que no se lo tomen como que quiero algo con ellas. No te estoy tirando los trastos, pero podría hacerlo."
    mc "{b}Was? Nein!{/b} *Lacht* Du bist eine der wenigen Frauen, bei denen ich ihre Schönheit erkennen kann, ohne dass sie es so auffassen, als ob ich etwas von ihnen wollte. Ich mache dich nicht an, aber ich könnte."

# game/scripts/c13/c13.rpy:417
translate german c13s001_SleepingInTheCouch_216fab8c:

    # kat "¿A qué te refieres exactamente?"
    kat "Was genau meinen Sie?"

# game/scripts/c13/c13.rpy:418
translate german c13s001_SleepingInTheCouch_d5332a23:

    # mc "Me caes muy bien. Ya te he dicho que eres divertida, inteligente, guapa... podría seguir con que tienes un gran sentido del humor, que no te dejas avasallar, que no tienes complejos..."
    mc "Ich mag dich sehr. Ich habe dir ja schon gesagt, dass du witzig, intelligent und wunderschön bist... Ich könnte noch so viel mehr darüber erzählen, wie toll dein Humor ist, wie du dich nicht einschüchtern lässt und wie unkompliziert du bist..."

# game/scripts/c13/c13.rpy:420
translate german c13s001_SleepingInTheCouch_87ddd219:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Du hast eine bezaubernde Persönlichkeit, und wenn du auf Männer stehen würdest, würde ich dich wahrscheinlich ansprechen. Ich glaube, du magst mich auch."

# game/scripts/c13/c13.rpy:422
translate german c13s001_SleepingInTheCouch_7b43f6fb:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Du hast eine faszinierende Persönlichkeit, und wenn du auf Männer stehst, würde ich dich vielleicht ansprechen. Ich bin mir aber immer noch nicht sicher, ob du mich auch mögen würdest."

# game/scripts/c13/c13.rpy:424
translate german c13s001_SleepingInTheCouch_92bb93f5:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Du hast eine faszinierende Persönlichkeit, und wenn du auf Männer stehst, würde ich vielleicht versuchen, dich anzusprechen. Aber ich bezweifle, dass es klappen würde. Ich glaube nicht, dass du mich mögen würdest."

# game/scripts/c13/c13.rpy:427
translate german c13s001_SleepingInTheCouch_ac349b40:

    # mc "Estuve en el lugar correcto en el momento correcto. Dudo que alguien como yo era entonces pudiera conseguir a alguien como Eileen en circunstancias normales."
    mc "Ich war zur richtigen Zeit am richtigen Ort. Ich bezweifle, dass jemand wie ich damals unter normalen Umständen jemanden wie Eileen hätte bekommen können."

# game/scripts/c13/c13.rpy:429
translate german c13s001_SleepingInTheCouch_f66b080e:

    # kat "Eso quiere decir que, según tú yo no podría conseguir estar con alguien como Kim o a alguien como tú si me interesaran los hombres, ¿no? Suerte que no me interesan... desde hace mucho."
    kat "Wenn ich also, deiner Meinung nach, an Männern interessiert wäre, könnte ich nicht mit jemandem wie Kim oder jemandem wie dir zusammen sein, richtig? Zum Glück bin ich schon lange nicht mehr an Männern interessiert."

# game/scripts/c13/c13.rpy:430
translate german c13s001_SleepingInTheCouch_39c6d0f0:

    # mc "Dependería mucho de la otra persona."
    mc "Das würde stark von der anderen Person abhängen."

# game/scripts/c13/c13.rpy:432
translate german c13s001_SleepingInTheCouch_216fab8c_1:

    # kat "¿A qué te refieres exactamente?"
    kat "Was genau meinen Sie?"

# game/scripts/c13/c13.rpy:433
translate german c13s001_SleepingInTheCouch_6beb8512:

    # mc "A mí me caes muy bien. Eres divertida, inteligente, guapa, tienes un gran sentido del humor, no te dejas avasallar, no tienes complejos..."
    mc "Ich mag dich sehr. Du bist witzig, intelligent, wunderschön, hast einen tollen Sinn für Humor, lässt dich nicht einschüchtern und bist völlig unkompliziert."

# game/scripts/c13/c13.rpy:435
translate german c13s001_SleepingInTheCouch_87ddd219_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es probable que te tirase los trastos. Creo que yo también te caigo bien."
    mc "Du hast eine bezaubernde Persönlichkeit, und wenn du auf Männer stehen würdest, würde ich dich wahrscheinlich ansprechen. Ich glaube, du magst mich auch."

# game/scripts/c13/c13.rpy:437
translate german c13s001_SleepingInTheCouch_7b43f6fb_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, es posible que te tirase los trastos. Aún no estoy seguro de que te caiga bien."
    mc "Du hast eine faszinierende Persönlichkeit, und wenn du auf Männer stehst, würde ich vielleicht versuchen, dich anzusprechen. Ich bin mir aber immer noch nicht sicher, ob du mich auch mögen würdest."

# game/scripts/c13/c13.rpy:439
translate german c13s001_SleepingInTheCouch_92bb93f5_1:

    # mc "Tienes una personalidad arrolladora y, si te interesaran los hombres, existe alguna posibilidad de que te tirase los trastos. Pero dudo que saliera bien. No creo que te caiga bien."
    mc "Du hast eine faszinierende Persönlichkeit, und wenn du auf Männer stehst, würde ich vielleicht versuchen, dich anzusprechen. Aber ich bezweifle, dass es klappen würde. Ich glaube nicht, dass du mich mögen würdest."

# game/scripts/c13/c13.rpy:440
translate german c13s001_SleepingInTheCouch_88e95bfb:

    # mc "Pero lo tendrías más difícil con personas a las que le interesara más el físico perfecto que la personalidad."
    mc "Schwieriger wäre es jedoch bei Menschen, die mehr an einem perfekten Körperbau als an der Persönlichkeit interessiert sind."

# game/scripts/c13/c13.rpy:443
translate german c13s001_SleepingInTheCouch_0f60830f:

    # kat "¡Wow! Eso me pasa por preguntar."
    kat "Wow! Das kommt davon, wenn man fragt."

# game/scripts/c13/c13.rpy:444
translate german c13s001_SleepingInTheCouch_62a18f55:

    # mc "Y ya que yo he respondido, ¿puedo hacer una pregunta?"
    mc "Und da ich nun geantwortet habe, darf ich eine Frage stellen?"

# game/scripts/c13/c13.rpy:446
translate german c13s001_SleepingInTheCouch_73c1b90a:

    # kat "Sería justo que te dejara hacerla. No puedo asegurar que responda."
    kat "Es wäre fair, wenn ich es dir überlasse. Ich kann dir allerdings nicht garantieren, dass ich antworte."

# game/scripts/c13/c13.rpy:447
translate german c13s001_SleepingInTheCouch_501de8c1:

    # mc "¿Has dicho que no te interesan los hombres desde hace mucho?"
    mc "Hast du gesagt, dass du schon lange kein Interesse mehr an Männern hast?"

# game/scripts/c13/c13.rpy:449
translate german c13s001_SleepingInTheCouch_84745afb:

    # kat "*Risa* Uff, creía que sería una pregunta más complicada o comprometedora. Sí, lo he dicho."
    kat "*lacht* Puh, ich dachte, es wäre eine kompliziertere oder heiklere Frage. Ja, ich habe es gesagt."

# game/scripts/c13/c13.rpy:450
translate german c13s001_SleepingInTheCouch_3133bb2f:

    # mc "No me refería a eso, la pregunta sería ¿qué pasó para que dejaran de interesarte?"
    mc "Das meinte ich nicht; die Frage sollte lauten: Was ist passiert, dass Sie das Interesse verloren haben?"

# game/scripts/c13/c13.rpy:452
translate german c13s001_SleepingInTheCouch_2d87f6a7:

    # kat "*Risa* Eso sería una segunda pregunta."
    kat "*Lacht* Das wäre eine zweite Frage."

# game/scripts/c13/c13.rpy:453
translate german c13s001_SleepingInTheCouch_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c13/c13.rpy:454
translate german c13s001_SleepingInTheCouch_f937556d:

    # kat "*Risa* No tengo la culpa de que no prestases atención a lo que decía y hayas gastado tu primera pregunta."
    kat "*Lacht* Es ist nicht meine Schuld, dass du nicht aufgepasst hast, was ich gesagt habe, und deine erste Frage verschwendet hast."

# game/scripts/c13/c13.rpy:455
translate german c13s001_SleepingInTheCouch_f52554b8:

    # mc "*Risa* Vale, me estás tomando el pelo, ya lo pillo."
    mc "*Lacht* Okay, du willst mich veräppeln, jetzt hab ich's kapiert."

# game/scripts/c13/c13.rpy:458
translate german c13s001_SleepingInTheCouch_4ec76d27:

    # kat "Por supuesto que te estoy tomando el pelo. Eres divertido y sabes encajarlo. *Risa*"
    kat "Natürlich necke ich dich nur. Du bist witzig und kannst damit umgehen. *lacht*"

# game/scripts/c13/c13.rpy:459
translate german c13s001_SleepingInTheCouch_e2aeb02c:

    # mc "Entonces... ¿contestas la pregunta?"
    mc "Also... beantworten Sie die Frage?"

# game/scripts/c13/c13.rpy:462
translate german c13s001_SleepingInTheCouch_35b64111:

    # kat "Es fácil. Solo he tenido una cita con un chico. Yo tenía 15 años y Isaac, el chico más popular de mi curso, me invitó a ir a cenar."
    kat "Das ist einfach. Ich war erst einmal mit einem Jungen auf einem Date. Ich war 15 Jahre alt und Isaac, der beliebteste Junge meines Jahrgangs, hat mich zum Abendessen eingeladen."

# game/scripts/c13/c13.rpy:463
translate german c13s001_SleepingInTheCouch_1d54b66e:

    # mc "Y algo salió mal."
    mc "Und irgendetwas ging schief."

# game/scripts/c13/c13.rpy:465
translate german c13s001_SleepingInTheCouch_d17eafc6:

    # kat "Sí, que había una voz en off que no me dejaba explicarme. *Risa*"
    kat "Ja, da war eine Stimme aus dem Off, die mich nicht erklären ließ. *lacht*"

# game/scripts/c13/c13.rpy:466
translate german c13s001_SleepingInTheCouch_a9f7b463:

    # mc "Vale, ya me callo. *Risa*"
    mc "Okay, ich halte jetzt den Mund. *lacht*"

# game/scripts/c13/c13.rpy:468
translate german c13s001_SleepingInTheCouch_46204cb0:

    # kat "Imagínate, la ballena del instituto saliendo con el chico más popular de mi clase. Era un sueño hecho realidad."
    kat "Stell dir vor, der Schulschwarm war mit dem beliebtesten Jungen meiner Klasse zusammen. Ein Traum wurde wahr."

# game/scripts/c13/c13.rpy:470
translate german c13s001_SleepingInTheCouch_52fe00cd:

    # kat "Y como te puedes imaginar, yo me emperifollé toda, pedí a mis padres que me compraran un vestido nuevo, llegué al lugar de la cita y allí estaba él, guapísimo."
    kat "Und wie Sie sich vorstellen können, habe ich mich extra schick gemacht, meine Eltern gebeten, mir ein neues Kleid zu kaufen, bin am Treffpunkt angekommen und da war er, und er sah umwerfend aus."

# game/scripts/c13/c13.rpy:472
translate german c13s001_SleepingInTheCouch_324cce21:

    # kat "Rodeado de todos sus amigos y amigas... riéndose de mí. Algo sacado de una película mala de instituto donde todos los populares son gilipollas y se ríen de la perdedora."
    kat "Umgeben von all seinen Freunden... die mich auslachen. Wie in einem schlechten Highschool-Film, in dem die beliebten Kids Idioten sind und den Loser auslachen."

# game/scripts/c13/c13.rpy:473
translate german c13s001_SleepingInTheCouch_5672dac6:

    # mc "Lo siento, Kate."
    mc "Es tut mir leid, Kate."

# game/scripts/c13/c13.rpy:475
translate german c13s001_SleepingInTheCouch_5297c865:

    # kat "Besó a una de las animadoras, tan solo para demostrar que podía besar a quien quisiera y que no lo iba a hacer conmigo."
    kat "Er küsste eine der Cheerleaderinnen, nur um zu zeigen, dass er küssen konnte, wen er wollte, und dass er es nicht mit mir tun würde."

# game/scripts/c13/c13.rpy:476
translate german c13s001_SleepingInTheCouch_bc67a668:

    # mc "Ese crío era un capullo. Los hay en todos los institutos."
    mc "Der Junge war ein Idiot. Solche Leute gibt es an jeder Schule."

# game/scripts/c13/c13.rpy:478
translate german c13s001_SleepingInTheCouch_36762656:

    # kat "Pero como en todas las películas malas, la perdedora acabó ganando. Dos meses después estaba saliendo con esa misma animadora. Jennifer. Fue mi primera novia."
    kat "Aber wie in allen schlechten Filmen gewann am Ende der Außenseiter. Zwei Monate später war ich mit derselben Cheerleaderin zusammen. Jennifer. Sie war meine erste Freundin."

# game/scripts/c13/c13.rpy:479
translate german c13s001_SleepingInTheCouch_6605351c:

    # kat "Ella me enseñó que no necesitaba a un chico para ser feliz, para sentirme querida y especial."
    kat "Sie hat mir beigebracht, dass ich keinen Jungen brauche, um glücklich zu sein, um mich geliebt und besonders zu fühlen."

# game/scripts/c13/c13.rpy:480
translate german c13s001_SleepingInTheCouch_46a729b1:

    # mc "¿Cómo se lo tomó aquel chico?"
    mc "Wie hat der Junge das aufgenommen?"

# game/scripts/c13/c13.rpy:482
translate german c13s001_SleepingInTheCouch_318df991:

    # kat "No le dió importancia hasta que Jennifer colgó una foto en InstaPic de nosotras dos besándonos."
    kat "Ich habe mir nichts weiter dabei gedacht, bis Jennifer ein Foto von uns beiden beim Küssen auf InstaPic gepostet hat."

# game/scripts/c13/c13.rpy:483
translate german c13s001_SleepingInTheCouch_1158143d:

    # kat "El texto decía \"Me ha costado dos meses quitarme el mal sabor de boca de un beso horrible de Isaac. Besa tan mal que me ha vuelto lesbiana.\" Como te puedes imaginar, ella siempre lo había sido."
    kat "In der Nachricht stand: „Ich brauchte zwei Monate, um den bitteren Geschmack von Isaacs schrecklichem Kuss loszuwerden. Er küsst so schlecht, dass ich lesbisch geworden bin.“ Wie man sich vorstellen kann, war sie es schon immer gewesen."

# game/scripts/c13/c13.rpy:484
translate german c13s001_SleepingInTheCouch_7aad78cf:

    # mc "¡Bien por Jennifer!"
    mc "Gut gemacht, Jennifer!"

# game/scripts/c13/c13.rpy:486
translate german c13s001_SleepingInTheCouch_4800ba71:

    # kat "Y esa es la historia de por qué solo salgo con chicas. Sigo apreciando el aspecto de un chico guapo, pero no voy a dejar que me hagan daño otra vez."
    kat "Und das ist der Grund, warum ich nur mit Frauen ausgehe. Ich schätze zwar immer noch das Aussehen eines gutaussehenden Mannes, aber ich lasse mich nicht noch einmal verletzen."

# game/scripts/c13/c13.rpy:487
translate german c13s001_SleepingInTheCouch_e3841a2a:

    # kat "Pero que un chico como tú se planteara tirarme los trastos... me sorprende."
    kat "Aber dass ein Typ wie du überhaupt in Erwägung zieht, mich anzubaggern... das überrascht mich."

# game/scripts/c13/c13.rpy:488
translate german c13s001_SleepingInTheCouch_f28d45d9:

    # mc "¿Un chico como yo? Kate, ¿me estás tirando los trastos? *Risa*"
    mc "Ein Typ wie ich? Kate, machst du mich etwa an? *lacht*"

# game/scripts/c13/c13.rpy:490
translate german c13s001_SleepingInTheCouch_a31dfe94:

    # kat "*Risa* No solo es guapo y sabe encajar las bromas, también sabe devolverlas."
    kat "*Lacht* Er ist nicht nur gutaussehend und kann über Witze lachen, er weiß auch, wie man sie erwidert."

# game/scripts/c13/c13.rpy:491
translate german c13s001_SleepingInTheCouch_e5f90eb8:

    # mc "¿Dónde estaría lo divertido si sólo recibiera uno?"
    mc "Wo bliebe denn der Spaß, wenn ich nur einen bekäme?"

# game/scripts/c13/c13.rpy:493
translate german c13s001_SleepingInTheCouch_4ae2fa75:

    # "Justo en ese momento escuchas pasos en la escalera."
    "Genau in diesem Moment hörst du Schritte auf der Treppe."

# game/scripts/c13/c13.rpy:495
translate german c13s001_SleepingInTheCouch_ad0c015f:

    # mom "¿Qué hacéis aquí tan temprano? ¿Le has pillado el gusto a dormir en el sofá, [mc]? *Risa* ¿Hoy has cambiado a Lisa por Kate?"
    mom "Was machst du denn so früh hier? Hast du etwa Gefallen daran gefunden, auf dem Sofa zu schlafen, [mc]? *Lacht* Hast du Lisa heute gegen Kate getauscht?"

# game/scripts/c13/c13.rpy:496
translate german c13s001_SleepingInTheCouch_57eee0fd:

    # mc "¿Cómo sabes tú eso?"
    mc "Woher weißt du das?"

# game/scripts/c13/c13.rpy:498
translate german c13s001_SleepingInTheCouch_22add2b2:

    # kat "Ayer Lisa lo comentó varias veces. Por lo visto hablar contigo le ayudó mucho... en algo."
    kat "Lisa hat es gestern mehrmals erwähnt. Offenbar hat ihr das Gespräch mit dir sehr geholfen... in irgendeiner Weise."

# game/scripts/c13/c13.rpy:499
translate german c13s001_SleepingInTheCouch_790fd913:

    # mc "Ah, vale."
    mc "Ah, okay."

# game/scripts/c13/c13.rpy:501
translate german c13s001_SleepingInTheCouch_e6a7f6fd:

    # kat "Pero no te preocupes, [mar]. Esta vez lo he encontrado yo durmiendo en el sofá."
    kat "Aber keine Sorge, [mar]. Diesmal fand ich ihn schlafend auf dem Sofa vor."

# game/scripts/c13/c13.rpy:503
translate german c13s001_SleepingInTheCouch_c770cb25:

    # mom "¿Ha pasado algo en tu habitación?"
    mom "Ist etwas in deinem Zimmer passiert?"

# game/scripts/c13/c13.rpy:504
translate german c13s001_SleepingInTheCouch_710fb6f5:

    # mc "Algo. Tenemos que hablar."
    mc "Etwas. Wir müssen reden."

# game/scripts/c13/c13.rpy:506
translate german c13s001_SleepingInTheCouch_09809368:

    # kat "Yo voy a darme una ducha. Os dejo hablar tranquilos."
    kat "Ich gehe duschen. Ich lasse euch zwei allein, damit ihr euch unterhalten könnt."

# game/scripts/c13/c13.rpy:507
translate german c13s001_SleepingInTheCouch_f090d085:

    # mc "Nosotros vamos a bajar a la sala de abajo, es el sitio más alejado de cualquier habitación."
    mc "Wir gehen in den Raum darunter; er ist der am weitesten von allen anderen Räumen entfernte Ort."

# game/scripts/c13/c13.rpy:540
translate german c13s002_TalkToTheFamily_5d815bcc:

    # mom "¿Qué ha pasado?"
    mom "Was ist passiert?"

# game/scripts/c13/c13.rpy:543
translate german c13s002_TalkToTheFamily_7e70543d:

    # mc "Ahora te lo explico, pero antes quiero un beso."
    mc "Ich erkläre es dir jetzt, aber zuerst möchte ich einen Kuss."

# game/scripts/c13/c13.rpy:545
translate german c13s002_TalkToTheFamily_ef8d8600:

    # mom "Mmmmm... subía a ver si estabas despierto para besarte antes de que todo el mundo se despertara. Verte con Kate ha hecho que me despiste."
    mom "Mmm... Ich bin hochgekommen, um nachzusehen, ob du schon wach bist, damit ich dich küssen kann, bevor alle anderen aufwachen. Dich mit Kate zu sehen, hat mich ganz durcheinandergebracht."

# game/scripts/c13/c13.rpy:546
translate german c13s002_TalkToTheFamily_e45119d0:

    # mc "Problema resuelto. *Risa* Sobre lo que ha pasado..."
    mc "Problem gelöst. *Gelächter* Über das, was passiert ist..."

# game/scripts/c13/c13.rpy:547
translate german c13s002_TalkToTheFamily_f3c32356:

    # mc "Eileen y su madre están durmiendo en mi habitación"
    mc "Eileen und ihre Mutter schlafen in meinem Zimmer."

# game/scripts/c13/c13.rpy:549
translate german c13s002_TalkToTheFamily_efa5675d:

    # mom "{b}¿Qué?{/b} ¿Por qué?"
    mom "{b}Was?{/b}Warum?"

# game/scripts/c13/c13.rpy:551
translate german c13s002_TalkToTheFamily_587cf335:

    # mom "Tu y ellas..."
    mom "Du und sie..."

# game/scripts/c13/c13.rpy:552
translate german c13s002_TalkToTheFamily_45958c14:

    # mc "No, no es eso, no te preocupes."
    mc "Nein, das ist es nicht, keine Sorge."

# game/scripts/c13/c13.rpy:553
translate german c13s002_TalkToTheFamily_8b27aefd:

    # mc "Solomon se puso violento ayer con Kiara."
    mc "Solomon ist gestern gegenüber Kiara gewalttätig geworden."

# game/scripts/c13/c13.rpy:555
translate german c13s002_TalkToTheFamily_fa919086:

    # mom "{b}¿Qué?{/b} ¿Kiara está bien?"
    mom "{b}Was?{/b} Geht es Kiara gut?"

# game/scripts/c13/c13.rpy:556
translate german c13s002_TalkToTheFamily_f36f5c8c:

    # mc "Tiene un hematoma gigante en el antebrazo. Por el resto parece estar bien... físicamente."
    mc "Er hat einen riesigen Bluterguss am Unterarm. Ansonsten scheint es ihm körperlich gut zu gehen."

# game/scripts/c13/c13.rpy:557
translate german c13s002_TalkToTheFamily_ee742ba8:

    # mc "Cuando se despierte quiero llevarla al hospital a que vea a Samantha."
    mc "Wenn sie aufwacht, möchte ich sie ins Krankenhaus bringen, um Samantha zu sehen."

# game/scripts/c13/c13.rpy:559
translate german c13s002_TalkToTheFamily_d4314175:

    # mom "Sí, es lo mejor. Así tendrá un informe para presentar a la policía."
    mom "Ja, das ist das Beste, was Sie tun können. So haben Sie einen Bericht für die Polizei."

# game/scripts/c13/c13.rpy:560
translate german c13s002_TalkToTheFamily_71334393:

    # mc "No quiere presentar denuncia. Ni siquiera quiere ir al hospital."
    mc "Sie will keine Anzeige erstatten. Sie will nicht einmal ins Krankenhaus gehen."

# game/scripts/c13/c13.rpy:561
translate german c13s002_TalkToTheFamily_66e101df:

    # mc "Quería volver a casa mañana... la he convencido para que pase unos días en casa. Todavía hay una habitación libre en casa de [nor]. No sé si me he tomado muchas libertades..."
    mc "Sie wollte morgen nach Hause... Ich habe sie überredet, noch ein paar Tage zu bleiben. Bei [nor] ist noch ein Zimmer frei. Ich weiß nicht, ob ich mir zu viele Freiheiten herausgenommen habe..."

# game/scripts/c13/c13.rpy:563
translate german c13s002_TalkToTheFamily_6e36c916:

    # mom "No, para nada. Si alguien tiene problemas, debemos que ayudarlo. Tenemos una habitación libre hasta que lleguen las otras estudiantes, no creo que haya mejor forma de usarla."
    mom "Nein, überhaupt nicht. Wenn jemand Probleme hat, sollten wir ihm helfen. Wir haben ein freies Zimmer, bis die anderen Studenten eintreffen; ich glaube, es gibt keine bessere Möglichkeit, es zu nutzen."

# game/scripts/c13/c13.rpy:564
translate german c13s002_TalkToTheFamily_34e25155:

    # mc "De todas formas creo que debería haberlo consultado con [nor], pero era pasada la medianoche cuando hemos llegado a casa."
    mc "Ich hätte wohl besser bei [nor] nachgefragt, aber es war schon nach Mitternacht, als wir nach Hause kamen."

# game/scripts/c13/c13.rpy:566
translate german c13s002_TalkToTheFamily_a871a070:

    # mom "Llámala y dile que venga. Ya debe estar despierta. Yo no he bajado el móvil."
    mom "Ruf sie an und sag ihr, sie soll vorbeikommen. Sie muss jetzt wach sein. Ich habe mein Handy nicht weggelegt."

# game/scripts/c13/c13.rpy:567
translate german c13s002_TalkToTheFamily_62d7ae47:

    # mc "OK, dáme un segundo."
    mc "Okay, einen Moment bitte."

# game/scripts/c13/c13.rpy:569
translate german c13s002_TalkToTheFamily_33abc69f:

    # "Unos minutos después, una vez habéis puesto a [nor] al corriente..."
    "Ein paar Minuten später, sobald Sie [nor] ausgefüllt haben..."

# game/scripts/c13/c13.rpy:571
translate german c13s002_TalkToTheFamily_b86cc6bb:

    # mc "Espero no haberme extralimitado diciéndoles que se pueden quedar una semana en tu casa."
    mc "Ich hoffe, ich bin nicht zu weit gegangen, als ich ihnen gesagt habe, dass sie eine Woche lang bei mir wohnen können."

# game/scripts/c13/c13.rpy:572
translate german c13s002_TalkToTheFamily_7069f4cf:

    # nor "¿Una semana? ¡Se pueden quedar todo el tiempo que quieran! Mientras no lleguen las estudiantes en otoño, esa habitación es suya si la quieren."
    nor "Eine Woche? Sie können so lange bleiben, wie sie wollen! Solange die Studenten nicht im Herbst ankommen, steht ihnen das Zimmer zur Verfügung, wenn sie es wünschen."

# game/scripts/c13/c13.rpy:573
translate german c13s002_TalkToTheFamily_cbf508e3:

    # mc "Gracias, [nor]. Entre Meemaw, Tía Betty, y ahora Kiara y Eileen, casi es como si tuvieras a las estudiantes."
    mc "Danke, [nor]. Zwischen Meemaw, Tante Betty und jetzt Kiara und Eileen hast du ja fast die Schülerinnen unter dir."

# game/scripts/c13/c13.rpy:575
translate german c13s002_TalkToTheFamily_98dcd74f:

    # nor "Me servirá de entrenamiento. *Risa* Scarlett se queda a dormir la mitad de los días. Cuando coincidan todas tendré cinco huespedes."
    nor "Das wird eine gute Übung. *lacht* Scarlett bleibt mehr als die Hälfte der Zeit. Wenn alle da sind, habe ich fünf Gäste."

# game/scripts/c13/c13.rpy:577
translate german c13s002_TalkToTheFamily_14d1dee3:

    # mom "A mí me llega hoy la quinta. Por cierto, [mc], tienes que ir a buscarla al aeropuerto. Llega a las 2 PM."
    mom "Mein fünftes Exemplar kommt heute an. Übrigens, [mc], du musst es am Flughafen abholen. Es kommt um 14 Uhr an."

# game/scripts/c13/c13.rpy:578
translate german c13s002_TalkToTheFamily_f443373a:

    # mc "Sí, lo sé. Me lo dijo [nor] ayer. Parece que iba a ser una sorpresa para mí..."
    mc "Ja, ich weiß. Er hat es mir gestern gesagt. Es sollte wohl eine Überraschung für mich werden..."

# game/scripts/c13/c13.rpy:580
translate german c13s002_TalkToTheFamily_60d7c644:

    # mom "¿Sorpresa? ¿Qué sorpresa?"
    mom "Überraschung? Welche Überraschung?"

# game/scripts/c13/c13.rpy:581
translate german c13s002_TalkToTheFamily_970f2e18:

    # mc "¿Te acuerdas de la chica India con la que salía en Portland? Estoy 99%% seguro de que es ella."
    mc "Erinnerst du dich an das indische Mädchen, mit dem ich in Portland zusammen war? Ich bin mir zu 99%% sicher, dass sie es ist."

# game/scripts/c13/c13.rpy:596
translate german c13s002_TalkToTheFamily_0dcdc47b:

    # mom "¿Te ha seguido desde Portland? ¿Sin decírtelo?"
    mom "Hat er Sie von Portland aus verfolgt? Ohne Ihnen Bescheid zu sagen?"

# game/scripts/c13/c13.rpy:597
translate german c13s002_TalkToTheFamily_8a456377:

    # nor "Super romántico, ¿verdad? Estoy segura de que quiere volver con él."
    nor "So romantisch, nicht wahr? Ich bin mir sicher, dass sie wieder mit ihm zusammenkommen möchte."

# game/scripts/c13/c13.rpy:598
translate german c13s002_TalkToTheFamily_75baeb1e:

    # mc "No estoy seguro, pero si no fuera así ¿por qué el secretismo? ¿Por qué se ha transferido a Newport?"
    mc "Ich bin mir nicht sicher, aber wenn das nicht der Fall wäre, warum dann die Geheimhaltung? Warum wurde es nach Newport verlegt?"

# game/scripts/c13/c13.rpy:600
translate german c13s002_TalkToTheFamily_f215b9b6:

    # mom "¿Tú quieres volver con ella?"
    mom "Möchtest du wieder mit ihr zusammenkommen?"

# game/scripts/c13/c13.rpy:602
translate german c13s002_TalkToTheFamily_61e910c3:

    # mc "Mi situación es diferente de cuando estaba en Portland. Tengo que hablar con ella."
    mc "Meine Situation ist anders als damals in Portland. Ich muss mit ihr sprechen."

# game/scripts/c13/c13.rpy:604
translate german c13s002_TalkToTheFamily_bb05ad6e:

    # mc "Hay muchas cosas que hacer en casa y no tengo demasiado tiempo para empezar o reanudar una relación. Tengo que hablar con ella."
    mc "Zuhause gibt es viel zu tun, und ich habe kaum Zeit, eine Beziehung anzufangen oder wiederzubeleben. Ich muss mit ihr reden."

# game/scripts/c13/c13.rpy:605
translate german c13s002_TalkToTheFamily_24b973a2:

    # mc "Pero volviendo al tema del día. Deberiais hablar con Eileen y Kiara. Les dije que os comentaría lo de la habitación y..."
    mc "Aber zurück zum heutigen Thema. Du solltest mit Eileen und Kiara sprechen. Ich habe ihnen gesagt, dass ich dir Bescheid geben würde wegen des Zimmers und..."

# game/scripts/c13/c13.rpy:607
translate german c13s002_TalkToTheFamily_e020d34a:

    # nor "No hay nada que comentar. La habitación es suya por el tiempo que quieran."
    nor "Es gibt nichts hinzuzufügen. Das Zimmer gehört Ihnen, solange Sie möchten."

# game/scripts/c13/c13.rpy:608
translate german c13s002_TalkToTheFamily_495fef7c:

    # mc "Pero eso se les debería decir a ellas, no a mí. Yo ya sabía que no las íbamos a dejar en la estacada."
    mc "Aber das solltest du ihnen sagen, nicht mir. Ich wusste ja schon, dass wir sie nicht im Stich lassen würden."

# game/scripts/c13/c13.rpy:610
translate german c13s002_TalkToTheFamily_cc8a4499:

    # nor "¿Están despiertas?"
    nor "Sind sie wach?"

# game/scripts/c13/c13.rpy:611
translate german c13s002_TalkToTheFamily_d74bb287:

    # mc "No lo sé, se acostaron tarde... Yo debería entrar para coger ropa y vestirme."
    mc "Ich weiß nicht, sie sind spät ins Bett gegangen... Ich sollte reingehen, mir Kleidung holen und mich anziehen."

# game/scripts/c13/c13.rpy:612
translate german c13s002_TalkToTheFamily_942c2998:

    # nor "Probemos entonces..."
    nor "Dann versuchen wir es mal..."

# game/scripts/c13/c13.rpy:615
translate german c13s002_TalkToTheFamily_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c13/c13.rpy:616
translate german c13s002_TalkToTheFamily_25c2df4d:

    # mc "Soy yo."
    mc "Da ich bin."

# game/scripts/c13/c13.rpy:617
translate german c13s002_TalkToTheFamily_27e3a2b0:

    # kia "Entra, [mc]."
    kia "Geben Sie [mc] ein."

# game/scripts/c13/c13.rpy:619
translate german c13s002_TalkToTheFamily_699dfc7a:

    # mc "Buenos días, Kiara. ¿Habéis dormido bien?"
    mc "Guten Morgen, Kiara. Hast du gut geschlafen?"

# game/scripts/c13/c13.rpy:620
translate german c13s002_TalkToTheFamily_aaa33533:

    # kia "Sí, hemos dormido genial. Hacía tiempo que Eile y yo no compartíamos cama. Gracias por dejarnos tu habitación."
    kia "Ja, wir haben wunderbar geschlafen. Es war schon eine Weile her, dass Eile und ich zusammen in einem Bett geschlafen hatten. Danke, dass wir dein Zimmer benutzen durften."

# game/scripts/c13/c13.rpy:622
translate german c13s002_TalkToTheFamily_03e1bae3:

    # mc "No se si recuerdas a mi madre y a mi tía."
    mc "Ich weiß nicht, ob du dich an meine Mutter und meine Tante erinnerst."

# game/scripts/c13/c13.rpy:623
translate german c13s002_TalkToTheFamily_38d0cbc6:

    # mom "Bienvenida a casa, Kiara. ¿Donde está Eileen? Hace siglos que no la veo. Siento mucho lo que te ha pasado. Lo que os ha pasado a las dos."
    mom "Willkommen zu Hause, Kiara. Wo ist Eileen? Ich habe sie schon ewig nicht mehr gesehen. Es tut mir so leid, was dir passiert ist. Was euch beiden passiert ist."

# game/scripts/c13/c13.rpy:624
translate german c13s002_TalkToTheFamily_84aeac3b:

    # nor "Hoy moveremos vuestras cosas a una habitación en mi casa, así [mc] puede recuperar la suya. Estaréis más cómodas allí, hay dos camas. Sentimos no poderos ofrecer más."
    nor "Heute bringen wir deine Sachen in ein Zimmer in meinem Haus, damit [mc] ihre zurückbekommt. Dort wirst du es bequemer haben; es gibt zwei Betten. Es tut uns leid, dass wir dir nicht mehr anbieten können."

# game/scripts/c13/c13.rpy:626
translate german c13s002_TalkToTheFamily_6265f88a:

    # kia "Gracias por acogernos, [mar] y [nor]. O lo que queda de ti, [nor]. Creo que si te viera por la calle no te reconocería. Nos conformamos con poco, solo serán unos días. No queremos molestar."
    kia "Vielen Dank für die Gastfreundschaft, [mar] und [nor]. Oder was von dir übrig ist, [nor]. Ich glaube, ich würde dich auf der Straße nicht wiedererkennen. Wir brauchen nicht viel; es dauert ja nur ein paar Tage. Wir wollen euch nicht stören."

# game/scripts/c13/c13.rpy:627
translate german c13s002_TalkToTheFamily_add25c43:

    # kia "Eileen está en la ducha. Hoy empieza pronto en el trabajo y no cogió su bici. Tendrá que coger el autobús."
    kia "Eileen duscht gerade. Sie hat heute früh angefangen zu arbeiten und ihr Fahrrad nicht mitgenommen. Sie muss den Bus nehmen."

# game/scripts/c13/c13.rpy:628
translate german c13s002_TalkToTheFamily_063f51fb:

    # mc "No te preocupes por eso. El café está de camino al hospital y la puedo llevar yo."
    mc "Mach dir darüber keine Sorgen. Der Kaffee ist auf dem Weg ins Krankenhaus, und ich kann ihn selbst mitnehmen."

# game/scripts/c13/c13.rpy:630
translate german c13s002_TalkToTheFamily_0033c727:

    # kia "[mc], ya hablamos de eso anoche. No es necesario ir al hospital."
    kia "[mc], das haben wir gestern Abend schon besprochen. Es besteht keine Notwendigkeit, ins Krankenhaus zu gehen."

# game/scripts/c13/c13.rpy:631
translate german c13s002_TalkToTheFamily_603a3173:

    # mc "No es necesario, pero sí recomendable. ¿Tienes algo mejor que hacer esta mañana? ¿A qué hora entras a trabajar?"
    mc "Es ist nicht notwendig, aber empfehlenswert. Hast du heute Morgen etwas Besseres vor? Wann fängst du mit der Arbeit an?"

# game/scripts/c13/c13.rpy:633
translate german c13s002_TalkToTheFamily_8db5c596:

    # kia "A la 1 PM. Voy a tener que mover nuestras cosas a la nueva habitación..."
    kia "Um 13 Uhr. Ich muss unsere Sachen in das neue Zimmer bringen..."

# game/scripts/c13/c13.rpy:634
translate german c13s002_TalkToTheFamily_44c676ad:

    # mc "Las cosas son una bolsa de viaje tan solo, Kiara. La puedo llevar yo en cuanto Eileen salga de la ducha."
    mc "Es handelt sich lediglich um eine Reisetasche, Kiara. Ich kann sie mitnehmen, sobald Eileen aus der Dusche kommt."

# game/scripts/c13/c13.rpy:635
translate german c13s002_TalkToTheFamily_dcf18cd2:

    # mc "A las 10 AM tengo que estar en un sitio, a las 2 PM tengo que estar en el aeropuerto, tu trabajo me pilla de camino entre el hospital y el aeropuerto."
    mc "Um 10 Uhr morgens muss ich irgendwo sein, um 14 Uhr muss ich am Flughafen sein, Ihr Job liegt auf meinem Weg zwischen Krankenhaus und Flughafen."

# game/scripts/c13/c13.rpy:636
translate german c13s002_TalkToTheFamily_5d6577a8:

    # mc "Dejamos a Eileen en el café, vamos al hospital, me acompañas a lo que tengo que hacer a las 10, y te llevo al trabajo. Si tenemos tiempo, te invito a comer."
    mc "Wir bringen Eileen zum Café, fahren dann ins Krankenhaus, du kannst mich um 10 Uhr zu meinem Termin begleiten, und danach bringe ich dich zur Arbeit. Wenn wir noch Zeit haben, lade ich dich zum Mittagessen ein."

# game/scripts/c13/c13.rpy:638
translate german c13s002_TalkToTheFamily_1778adbb:

    # mom "[mc] me ha dicho lo que ha pasado. Samantha Washington es una amiga, no va a hacer nada que tu no quieras hacer."
    mom "[mc] Sie hat mir erzählt, was passiert ist. Samantha Washington ist eine Freundin; sie wird nichts tun, was du nicht willst."

# game/scripts/c13/c13.rpy:639
translate german c13s002_TalkToTheFamily_e75bcff9:

    # mom "Si no quieres presentar la denuncia, no te va a obligar."
    mom "Wenn Sie keine Beschwerde einreichen wollen, werden sie Sie nicht dazu zwingen."

# game/scripts/c13/c13.rpy:641
translate german c13s002_TalkToTheFamily_ca34ffb5:

    # kia "¿Samantha Washington? ¿La madre del chico en... del chico que estudiaba en el mismo curso que Eileen y [mc]?"
    kia "Samantha Washington? Die Mutter des Jungen in... dem Jungen, der in derselben Klasse wie Eileen und [mc] war?"

# game/scripts/c13/c13.rpy:642
translate german c13s002_TalkToTheFamily_5ce8450e:

    # mc "Sí, la madre de Jamaal."
    mc "Ja, Jamaals Mutter."

# game/scripts/c13/c13.rpy:643
translate german c13s002_TalkToTheFamily_034bdae1:

    # kia "Sí, eso, Jamaal. No he hablado más que un par de veces con ella..."
    kia "Ja, genau, Jamaal. Ich habe erst ein paar Mal mit ihr gesprochen..."

# game/scripts/c13/c13.rpy:645
translate german c13s002_TalkToTheFamily_e364c13f:

    # nor "Pero es amiga de la familia. Y tú también. Si [mc] le pide algo..."
    nor "Aber sie ist eine Freundin der Familie. Und du auch. Wenn [mc] sie um etwas bittet..."

# game/scripts/c13/c13.rpy:646
translate german c13s002_TalkToTheFamily_8ba27ce0:

    # mc "Entonces decidido, voy a ducharme y nos vamos cuando queráis."
    mc "Also, es ist beschlossen, ich werde duschen und wir fahren los, wann immer du willst."

# game/scripts/c13/c13.rpy:648
translate german c13s002_TalkToTheFamily_4c813a90:

    # eil "¿[nor]? ¡Estás fantástica!"
    eil "[nor]? Du siehst fantastisch aus!"

# game/scripts/c13/c13.rpy:649
translate german c13s002_TalkToTheFamily_ba74b1db:

    # eil "Tu también, [mar]."
    eil "Du auch, [mar]."

# game/scripts/c13/c13.rpy:651
translate german c13s002_TalkToTheFamily_6423aeba:

    # mom "Bienvenida a casa, Eileen. Sabía que tarde o temprano te mudarías aquí, pero esperaba que fuera en otras circunstancias."
    mom "Willkommen zurück, Eileen. Ich wusste, dass du früher oder später hierher ziehen würdest, aber ich hatte gehofft, es würde unter anderen Umständen geschehen."

# game/scripts/c13/c13.rpy:652
translate german c13s002_TalkToTheFamily_5b7e94be:

    # eil "Gracias, [mar]. Yo también lo esperaba."
    eil "Danke, [mar]. Das hatte ich auch erwartet."

# game/scripts/c13/c13.rpy:654
translate german c13s002_TalkToTheFamily_b68411ed:

    # eil "Me parece increíble que haya pasado tanto tiempo sin veros. Tienes que entrar en el café cuando traigas a [eri] y lucir ese tipito."
    eil "Ich kann es kaum glauben, dass ich dich schon so lange nicht mehr gesehen habe. Du musst unbedingt mit [eri] ins Café kommen und deine Figur präsentieren."

# game/scripts/c13/c13.rpy:655
translate german c13s002_TalkToTheFamily_ba290689:

    # eil "¡Estás increíble! Me tienes que decir como has perdido tanto peso. No me iría mal a mí también."
    eil "Du siehst fantastisch aus! Du musst mir unbedingt verraten, wie du so viel abgenommen hast. Ich könnte da auch etwas Hilfe gebrauchen."

# game/scripts/c13/c13.rpy:656
translate german c13s002_TalkToTheFamily_e4c672a7:

    # nor "Gracias, Eileen, pero tú no lo necesitas, a menos que quieras disfrazarte de esqueleto en Halloween. *Risa*"
    nor "Danke, Eileen, aber du brauchst es nicht, es sei denn, du willst dich an Halloween als Skelett verkleiden. *lacht*"

# game/scripts/c13/c13.rpy:658
translate german c13s002_TalkToTheFamily_556e6162:

    # mom "Entonces, ¿vamos a desayunar mientras [mc] se ducha? Parece que va a tener un día ocupado"
    mom "Sollen wir frühstücken, während [mc] duscht? Sieht so aus, als ob sie einen anstrengenden Tag vor sich hat."

# game/scripts/c13/c13.rpy:659
translate german c13s002_TalkToTheFamily_dcc24a9d:

    # mc "A mí también me gustaría desayunar..."
    mc "Ich möchte auch frühstücken..."

# game/scripts/c13/c13.rpy:661
translate german c13s002_TalkToTheFamily_ca074c8d:

    # nor "No te preocupes, te dejaremos algo para que desayunes. Ve a ducharte, ya llevaré yo la bolsa de Kiara y Eileen a casa."
    nor "Keine Sorge, wir stellen euch etwas zum Frühstück bereit. Geh duschen; ich bringe Kiaras und Eileens Tasche nach Hause."

# game/scripts/c13/c13.rpy:663
translate german c13s002_TalkToTheFamily_b2a78d67:

    # nor "Si necesitáis algo de ropa, no dudéis en pedírnoslo a nosotras o a cualquiera de las chicas."
    nor "Falls Sie Kleidung benötigen, zögern Sie nicht, uns oder eines der Mädchen zu fragen."

# game/scripts/c13/c13.rpy:665
translate german c13s002_TalkToTheFamily_9687e0a2:

    # kia "No te preocupes, podemos aguantar dos o tres días con lo que hemos traído. El jueves mi hija quiere ir a casa a coger más ropa."
    kia "Keine Sorge, wir kommen mit dem, was wir mitgebracht haben, zwei oder drei Tage zurecht. Meine Tochter möchte am Donnerstag nach Hause kommen, um weitere Kleidung zu holen."

# game/scripts/c13/c13.rpy:666
translate german c13s002_TalkToTheFamily_1f1380fa:

    # mc "El jueves por la noche no estará Solomon. Y esperamos poder llevar a Alexia... a la Agente Martínez por si se tuercen los planes."
    mc "Solomon wird am Donnerstagabend nicht da sein. Und wir hoffen, Alexia zu Agent Martinez bringen zu können, falls etwas schiefgeht."

# game/scripts/c13/c13.rpy:668
translate german c13s002_TalkToTheFamily_00d473fe:

    # mom "Ve a ducharte o llegaréis tarde. Nosotras vamos a seguir charlando en la cocina mientras preparamos el desayuno."
    mom "Geh duschen, sonst kommst du zu spät. Wir unterhalten uns noch ein bisschen in der Küche, während wir das Frühstück zubereiten."

# game/scripts/c13/c13.rpy:670
translate german c13s002_TalkToTheFamily_98b2ba8e:

    # mc "OK, os veo en la cocina."
    mc "Okay, wir sehen uns in der Küche."

# game/scripts/c13/c13.rpy:681
translate german c13s002_TheHospital_342c3ec7:

    # "Después de desayunar, llevas a Eileen al café y vas al hospital. Aparcas en la zona de visitantes."
    "Nach dem Frühstück bringst du Eileen ins Café und fährst dann ins Krankenhaus. Du parkst auf dem Besucherparkplatz."

# game/scripts/c13/c13.rpy:684
translate german c13s002_TheHospital_d3f5ff6a:

    # kia "[mc], de verdad que esto no es necesario. Tan solo es un hematoma."
    kia "[mc], das ist wirklich nicht nötig. Es ist nur ein blauer Fleck."

# game/scripts/c13/c13.rpy:685
translate german c13s002_TheHospital_f29c0ae1:

    # mc "No hace mucho que yo tuve unos hematomas y me dijeron que podían ser peligrosos si no se trataban correctamente."
    mc "Ich hatte vor Kurzem ein paar Prellungen und mir wurde gesagt, dass diese gefährlich werden könnten, wenn sie nicht richtig behandelt würden."

# game/scripts/c13/c13.rpy:686
translate german c13s002_TheHospital_02ce349c:

    # mc "No nos podemos arriesgar a que te pase nada, ¿verdad?"
    mc "Wir können es nicht riskieren, dass Ihnen etwas passiert, oder?"

# game/scripts/c13/c13.rpy:688
translate german c13s002_TheHospital_184d888d:

    # kia "Te conozco desde que tenías 15 años. Casi no reconozco a aquel chico tímido en este hombre que tengo ahora delante."
    kia "Ich kenne dich, seit du 15 warst. Ich kann den schüchternen Jungen von damals in dem Mann, der jetzt vor mir steht, kaum wiedererkennen."

# game/scripts/c13/c13.rpy:689
translate german c13s002_TheHospital_8d3cff4b:

    # mc "Kiara, sigo siendo yo. Tan solo he crecido y he adelgazado."
    mc "Kiara, ich bin immer noch ich. Ich bin nur größer geworden und habe abgenommen."

# game/scripts/c13/c13.rpy:691
translate german c13s002_TheHospital_0c59923f:

    # kia "No me refiero a eso, [mc]. No quiero que te ofendas, pero al principio de salir con mi Eile me parecías un pusilánime."
    kia "Darum geht es mir nicht, [mc]. Ich will dich nicht beleidigen, aber als ich Eile kennengelernt habe, dachte ich, du wärst ein Weichei."

# game/scripts/c13/c13.rpy:692
translate german c13s002_TheHospital_34cf5b5c:

    # kia "No sé dónde tenías escondido a este hombre que toma las riendas de las situaciones."
    kia "Ich weiß nicht, wo Sie diesen Mann versteckt hatten, der in solchen Situationen die Kontrolle übernimmt."

# game/scripts/c13/c13.rpy:693
translate german c13s002_TheHospital_176ea40b:

    # mc "Creo que me lo había comido. *Risa*"
    mc "Ich glaube, ich habe es gegessen. *lacht*"

# game/scripts/c13/c13.rpy:695
translate german c13s002_TheHospital_fe4e84d0:

    # kia "*Risa* Eso no lo has perdido. Me sigues haciendo reír."
    kia "*lacht* Das hast du nicht verloren. Du bringst mich immer noch zum Lachen."

# game/scripts/c13/c13.rpy:696
translate german c13s002_TheHospital_7682a1e6:

    # mc "¿Te parecía tan malo como dices?"
    mc "Fandest du es wirklich so schlimm, wie du sagst?"

# game/scripts/c13/c13.rpy:698
translate german c13s002_TheHospital_61516d06:

    # kia "Al principio sí. No me gustabas, pero la hacías feliz y por eso nunca me opuse a vuestra relación. Nunca le dije nada a ella."
    kia "Anfangs ja. Ich mochte dich nicht, aber du hast sie glücklich gemacht, und deshalb habe ich nie etwas gegen eure Beziehung einzuwenden gehabt. Ich habe ihr gegenüber nie etwas gesagt."

# game/scripts/c13/c13.rpy:699
translate german c13s002_TheHospital_47c4bba0:

    # mc "Gracias. ¿Y después?"
    mc "Danke. Und was dann?"

# game/scripts/c13/c13.rpy:701
translate german c13s002_TheHospital_67377fac:

    # kia "Después evolucionasteis los dos. Ella dejó de querer ser el centro de atención. Maduró gracias a ti."
    kia "Dann habt ihr euch beide weiterentwickelt. Sie wollte nicht mehr im Mittelpunkt stehen. Dank dir ist sie reifer geworden."

# game/scripts/c13/c13.rpy:702
translate german c13s002_TheHospital_32efa1d7:

    # kia "Tu dejaste de ser tan pusilánime, no encuentro una palabra mejor, pero sin perder tu esencia. Sacábais lo mejor del otro y hacíais que el otro enterrase lo peor de sí mismo."
    kia "Du hast deine Schüchternheit abgelegt – ich finde kein besseres Wort dafür –, ohne dabei dein Wesen zu verlieren. Ihr habt das Beste ineinander hervorgebracht und euch gegenseitig geholfen, das Schlechteste in euch zu überwinden."

# game/scripts/c13/c13.rpy:703
translate german c13s002_TheHospital_21480074:

    # mc "No éramos una pareja para ser los reyes del baile, pero no nos iba mal. Nadie hubiera votado por mí como rey del baile entonces."
    mc "Wir waren zwar kein Paar, das für den Titel des Ballkönigs und der Ballkönigin bestimmt war, aber wir schlugen uns gar nicht so schlecht. Niemand hätte mich damals zum Ballkönig gewählt."

# game/scripts/c13/c13.rpy:705
translate german c13s002_TheHospital_387b6b7f:

    # kia "No necesitabais serlo. Solomon y yo lo fuimos, y ya ves..."
    kia "Das war nicht nötig. Salomo und ich waren es, und schau uns jetzt an..."

# game/scripts/c13/c13.rpy:706
translate german c13s002_TheHospital_c48f9602:

    # mc "No te preocupes, Kiara. Si no quieres, no tienes que volver a verlo, y si quieres..."
    mc "Keine Sorge, Kiara. Wenn du nicht willst, musst du ihn nicht wiedersehen, und wenn doch …"

# game/scripts/c13/c13.rpy:708
translate german c13s002_TheHospital_e8bbc76e:

    # kia "¡No! No voy a denunciarlo. Si no fuera por todo lo que me habéis dicho, no estaría aquí ni siquiera."
    kia "Nein! Ich werde es nicht melden. Ohne all das, was du mir erzählt hast, wäre ich gar nicht hier."

# game/scripts/c13/c13.rpy:709
translate german c13s002_TheHospital_5f32c172:

    # mc "No te iba a decir eso. Es tu decisión y, aunque no la comparta, tengo que respetarlo. Es tu familia."
    mc "Das wollte ich nicht sagen. Es ist deine Entscheidung, und auch wenn ich nicht damit einverstanden bin, muss ich sie respektieren. Es ist deine Familie."

# game/scripts/c13/c13.rpy:710
translate german c13s002_TheHospital_bfacd2fd:

    # mc "Iba a decirte que si querías podías quedarte en casa todo el tiempo que necesitaras."
    mc "Ich wollte dir sagen, dass du, wenn du möchtest, so lange zu Hause bleiben kannst, wie du es brauchst."

# game/scripts/c13/c13.rpy:711
translate german c13s002_TheHospital_108d37e9:

    # mc "Hasta otoño tenéis disponible la habitación que ocuparéis. Y después podéis volver a dormir en mi cama."
    mc "Du hast das Zimmer bis zum Herbst. Danach kannst du zurückkommen und in meinem Bett schlafen."

# game/scripts/c13/c13.rpy:713
translate german c13s002_TheHospital_cda822c9:

    # kia "*Risa* Cualquiera que te oyera pensaría que hoy hemos dormido en tu cama contigo dentro. *Risa*"
    kia "*Lacht* Jeder, der dich hört, würde denken, wir hätten mit dir in deinem Bett geschlafen. *Lacht*"

# game/scripts/c13/c13.rpy:714
translate german c13s002_TheHospital_f0c2fba7:

    # mc "Bueno, en esa cama hemos dormido tres personas confortablemente. *Risa*"
    mc "Nun ja, drei Personen haben in diesem Bett gut geschlafen. *lacht*"

# game/scripts/c13/c13.rpy:715
translate german c13s002_TheHospital_059e8b1f:

    # mc "La entrada está ahí mismo. ¿Preparada?"
    mc "Der Eingang ist gleich dort. Bereit?"

# game/scripts/c13/c13.rpy:717
translate german c13s002_TheHospital_405b7f9b:

    # kia "Sí. ¿Me aseguras que esa enfermera es de confianza? ¿No va a dar parte a la policía?"
    kia "Ja. Können Sie mir versichern, dass die Krankenschwester vertrauenswürdig ist? Dass sie es nicht der Polizei meldet?"

# game/scripts/c13/c13.rpy:718
translate german c13s002_TheHospital_d2670ae0:

    # mc "Kiara, Samantha es como una segunda madre para mí. No va a hacer nada que tu no quieras, pero me gustaría que comprobara como está ese brazo."
    mc "Kiara, Samantha ist wie eine zweite Mutter für mich. Sie würde nichts tun, was du nicht willst, aber ich möchte, dass sie mal nach deinem Arm sieht."

# game/scripts/c13/c13.rpy:719
translate german c13s002_TheHospital_1e67f23d:

    # mc "Y si hace un informe que puedas usar si cambias de opinión, mejor."
    mc "Und wenn Sie einen Bericht erstellen, den Sie auch dann verwenden können, wenn Sie Ihre Meinung ändern, umso besser."

# game/scripts/c13/c13.rpy:721
translate german c13s002_TheHospital_94d3a0e5:

    # kia "Vamos allá, entonces."
    kia "Na dann los."

# game/scripts/c13/c13.rpy:724
translate german c13s002_TheHospital_84bf76e9:

    # mc "Buenos días, Sam. Esta es Kiara, la madre de Eileen, no sé si la recuerdas."
    mc "Guten Morgen, Sam. Hier spricht Kiara, Eileens Mutter. Ich weiß nicht, ob du dich an sie erinnerst."

# game/scripts/c13/c13.rpy:725
translate german c13s002_TheHospital_01349ba5:

    # sam "Hola, [mc]. Encantada de volver a verte, Kiara. Hacía años que no coincidíamos. Voy a ser tu enfermera hoy."
    sam "Hallo, [mc]. Schön, dich wiederzusehen, Kiara. Es ist schon ewig her, seit wir uns das letzte Mal getroffen haben. Ich bin heute deine Krankenschwester."

# game/scripts/c13/c13.rpy:727
translate german c13s002_TheHospital_0f9fa27a:

    # kia "Hola, Samantha. No es nada grave, de verdad. [mc] está exagerando."
    kia "Hallo Samantha. Es ist wirklich nichts Ernstes. [mc] Sie übertreibt."

# game/scripts/c13/c13.rpy:728
translate german c13s002_TheHospital_5e3ef571:

    # mc "No exagero, tan solo soy precavido. Y ya has escuchado a Eileen, [nor] y [mar]."
    mc "Ich übertreibe nicht, ich bin nur vorsichtig. Und du hast Eileen, [nor] und [mar] ja schon gehört."

# game/scripts/c13/c13.rpy:730
translate german c13s002_TheHospital_9c807472:

    # sam "Un hematoma puede ser algo importante, más de lo que se piensa, no está de más echarle un ojo."
    sam "Ein blauer Fleck kann etwas Wichtiges sein, wichtiger als man denkt; es lohnt sich immer, ihn genauer anzusehen."

# game/scripts/c13/c13.rpy:731
translate german c13s002_TheHospital_58787efe:

    # sam "Acompáñame, Kiara. Tú quédate aquí, [mc]. No eres familia y no puedes pasar. Normas del hospital."
    sam "Komm mit mir, Kiara. Du bleibst hier, [mc]. Du gehörst nicht zur Familie und darfst nicht rein. Krankenhausregeln."

# game/scripts/c13/c13.rpy:732
translate german c13s002_TheHospital_98debacd:

    # mc "¿Para cuanto rato tenéis? Tengo que estar en otro sitio a las 10."
    mc "Wie viel Zeit haben Sie? Ich muss um 10 Uhr woanders sein."

# game/scripts/c13/c13.rpy:734
translate german c13s002_TheHospital_e773f8c7:

    # sam "Déjame echarle una ojeada y salgo a decírtelo."
    sam "Ich schaue mal nach und komme dann raus und sage Ihnen Bescheid."

# game/scripts/c13/c13.rpy:735
translate german c13s002_TheHospital_22274886:

    # mc "Perfecto. Os espero aquí."
    mc "Perfekt. Ich warte hier auf dich."

# game/scripts/c13/c13.rpy:737
translate german c13s002_TheHospital_f02d5296:

    # kia "Una vez más, gracias, [mc]."
    kia "Nochmals vielen Dank, [mc]."

# game/scripts/c13/c13.rpy:738
translate german c13s002_TheHospital_e7dbd164:

    # mc "Una vez más, no es necesario. Si me tengo que ir mientras estás con Samantha, te escribo o te llamo."
    mc "Nochmals, es ist nicht nötig. Falls ich weg muss, während du mit Samantha zusammen bist, schreibe ich dir eine SMS oder rufe dich an."

# game/scripts/c13/c13.rpy:740
translate german c13s002_TheHospital_820a6af0:

    # "Unos interminables minutos después..."
    "Ein paar endlos scheinende Minuten später..."

# game/scripts/c13/c13.rpy:741
translate german c13s002_TheHospital_38b199fb:

    # sam "El brazo tiene mala pinta y quiero que la vea un doctor y que ordene una radiografía, pero ahora mismo están muy ocupados. Se va a quedar un rato. Calcula un par de horas."
    sam "Ihr Arm sieht schlimm aus, und ich möchte, dass ihn ein Arzt untersucht und ein Röntgenbild anordnet, aber die Praxis ist gerade sehr ausgelastet. Sie wird noch eine Weile hier sein. Rechnen Sie mit einer Wartezeit von ein paar Stunden."

# game/scripts/c13/c13.rpy:742
translate german c13s002_TheHospital_60c5fa7b:

    # mc "Vale, entonces voy a ir hacer unas cosas y vuelvo luego a buscarla."
    mc "Okay, dann werde ich jetzt ein paar Dinge erledigen und später wiederkommen, um nach ihr zu suchen."

# game/scripts/c13/c13.rpy:744
translate german c13s002_TheHospital_ba851d07:

    # sam "Perfecto. Le diré que la has abandonado en un hospital y que no volverás a buscarla. *Risa*"
    sam "Perfekt. Ich werde ihr sagen, dass du sie im Krankenhaus zurückgelassen hast und nicht wiederkommen wirst. *Lacht*"

# game/scripts/c13/c13.rpy:746
translate german c13s002_TheHospital_74ed76d7:

    # mc "*Risa* Supongo que no me vas a dejar besarte aquí, ¿verdad?"
    mc "*Lacht* Ich nehme an, du lässt dich hier nicht von mir küssen, oder?"

# game/scripts/c13/c13.rpy:748
translate german c13s002_TheHospital_1f2507c5:

    # sam "Supones bien. Aún no estoy preparada para que nadie del trabajo sepa lo nuestro."
    sam "Du hast Recht. Ich bin noch nicht bereit, dass irgendjemand auf der Arbeit von uns erfährt."

# game/scripts/c13/c13.rpy:749
translate german c13s002_TheHospital_6d255a72:

    # mc "Gracias, Sam. Trátala bien, por favor. Lo ha pasado mal"
    mc "Danke, Sam. Bitte behandle sie gut. Sie hat viel durchgemacht."

# game/scripts/c13/c13.rpy:751
translate german c13s002_TheHospital_5463b54e:

    # sam "Yo siempre trato bien a mis pacientes, [mc]. *Risa* Ya lo sabes."
    sam "Ich behandle meine Patienten immer gut, [mc]. *Lacht* Das weißt du doch."

# game/scripts/c13/c13.rpy:752
translate german c13s002_TheHospital_e2248a1c:

    # mc "Y por cierto, Sam, perdón por el plantón de ayer."
    mc "Und übrigens, Sam, tut mir leid, dass ich mich gestern versetzt habe."

# game/scripts/c13/c13.rpy:754
translate german c13s002_TheHospital_6d8a5bae:

    # sam "No te preocupes. Jamaal lo agradeció, pero aún quedaron pastas si quieres venir esta tarde. Salgo a las 13:00, puedes venir a comer si quieres."
    sam "Keine Sorge. Jamaal hat sich gefreut, aber es ist noch Pasta da, falls du heute Nachmittag vorbeikommen möchtest. Ich fahre um 13:00 Uhr, du kannst also gerne zum Mittagessen kommen."

# game/scripts/c13/c13.rpy:755
translate german c13s002_TheHospital_4bf1bc5c:

    # mc "Imposible, tengo que recoger a la última estudiante en el aeropuerto. Pero intentaré pasar por la tarde."
    mc "Unmöglich, ich muss den letzten Schüler am Flughafen abholen. Aber ich versuche, heute Nachmittag vorbeizukommen."

# game/scripts/c13/c13.rpy:757
translate german c13s002_TheHospital_219452a4:

    # sam "Genial, te esperaré."
    sam "Wunderbar, ich warte auf dich."

# game/scripts/c13/c13.rpy:759
translate german c13s002_TheHospital_b956b59d:

    # mc "Hasta dentro de un rato, Sam."
    mc "Bis gleich, Sam."

# game/scripts/c13/c13.rpy:776
translate german c13s003_ScarlettHouse_d5785649:

    # "Aparcas delante de casa de Scarlett y le mandas un mensaje. Has pasado el video a una tablet para que sea más cómodo enseñárselo a su madre."
    "Du parkst vor Scarletts Haus und schickst ihr eine Nachricht. Du hast das Video auf ein Tablet übertragen, damit du es ihrer Mutter leichter zeigen kannst."

# game/scripts/c13/c13.rpy:777
translate german c13s003_ScarlettHouse_76d06bb6:

    # "Scarlett sale de su casa y entra en la camioneta."
    "Scarlett verlässt ihr Haus und steigt in den Lastwagen."

# game/scripts/c13/c13.rpy:781
translate german c13s003_ScarlettHouse_c084bbf6:

    # sca "Hola, cariño, me muero por besarte, pero no puedo aquí. Si mi madre nos ve..."
    sca "Hallo Liebling, ich würde dich so gern küssen, aber das geht hier nicht. Wenn meine Mutter uns sieht..."

# game/scripts/c13/c13.rpy:782
translate german c13s003_ScarlettHouse_712d4745:

    # mc "Lo entiendo. Te avergüenzas de mí."
    mc "Ich verstehe. Du schämst dich für mich."

# game/scripts/c13/c13.rpy:784
translate german c13s003_ScarlettHouse_23f27e3b:

    # sca "Estoy castigada un día sin salir por quemar una olla haciendo{b}me{/b} espaguetis. Si mi madre se entera de que los hice para mi novio, estaré una semana."
    sca "Ich habe einen Tag Hausarrest, weil ich beim Spaghettikochen den Topf anbrennen ließ. Wenn meine Mutter herausfindet, dass ich die Spaghetti für meinen Freund gekocht habe, bekomme ich eine ganze Woche Hausarrest."

# game/scripts/c13/c13.rpy:785
translate german c13s003_ScarlettHouse_ea248428:

    # sca "Y si descubre que acabamos pidiendo pizza, seguramente me castigue un mes. ¿Has traído el video?"
    sca "Und wenn er herausfindet, dass wir am Ende Pizza bestellt haben, kriege ich wahrscheinlich einen Monat Hausarrest. Hast du das Video mitgebracht?"

# game/scripts/c13/c13.rpy:787
translate german c13s003_ScarlettHouse_d1162091:

    # sca "Hola, [mc]. ¿Has traído el video ese?"
    sca "Hallo [mc]. Hast du das Video mitgebracht?"

# game/scripts/c13/c13.rpy:788
translate german c13s003_ScarlettHouse_5e05c1e2:

    # mc "Sí, lo he pasado a una tablet para que le sea más cómodo leer los subtítulos que en el móvil."
    mc "Ja, ich habe auf ein Tablet umgestellt, damit er die Untertitel leichter lesen kann als auf seinem Handy."

# game/scripts/c13/c13.rpy:790
translate german c13s003_ScarlettHouse_868701f2:

    # sca "¿Puedo verlo?"
    sca "Kann ich es sehen?"

# game/scripts/c13/c13.rpy:791
translate german c13s003_ScarlettHouse_6d74797e:

    # mc "Por supuesto. Aquí tienes la tablet."
    mc "Selbstverständlich. Hier ist das Tablet."

# game/scripts/c13/c13.rpy:793
translate german c13s003_ScarlettHouse_119cd6aa:

    # "Scarlett permanece en silencio durante todo el video. Tan solo con la boca abierta en una expresión de sorpresa."
    "Scarlett bleibt während des gesamten Videos stumm, ihr Mund steht vor Überraschung einfach offen."

# game/scripts/c13/c13.rpy:795
translate german c13s003_ScarlettHouse_222c5534:

    # sca "Hay que enseñárselo a mi madre. Con esto tendrá que creer que todas las veces que le he dicho que Kevin me acosaba era cierto."
    sca "Ich muss das meiner Mutter zeigen. Dann wird sie mir glauben, dass es stimmte, als ich ihr erzählt habe, dass Kevin mich belästigt."

# game/scripts/c13/c13.rpy:796
translate german c13s003_ScarlettHouse_ef1ef17d:

    # mc "Sí, no hay forma de negarlo. Está claro cuales son sus intenciones."
    mc "Ja, das lässt sich nicht leugnen. Ihre Absichten sind klar."

# game/scripts/c13/c13.rpy:797
translate german c13s003_ScarlettHouse_7086eea4:

    # sca "Vamos dentro a enseñárselo..."
    sca "Lass uns hineingehen und es ihm zeigen..."

# game/scripts/c13/c13.rpy:799
translate german c13s003_ScarlettHouse_e49a2d90:

    # sca "¡Mierda! Hay un problema."
    sca "Verdammt! Da gibt es ein Problem."

# game/scripts/c13/c13.rpy:800
translate german c13s003_ScarlettHouse_3b916da8:

    # mc "¿Qué pasa?"
    mc "Was passiert?"

# game/scripts/c13/c13.rpy:801
translate german c13s003_ScarlettHouse_9adecb95:

    # sca "¿De dónde le decimos que lo hemos sacado?"
    sca "Wo sollen wir ihm sagen, woher wir es haben?"

# game/scripts/c13/c13.rpy:802
translate german c13s003_ScarlettHouse_7885187f:

    # mc "No había pensado en eso... ¿Siempre te ha acosado en tu habitación?"
    mc "Daran hatte ich noch gar nicht gedacht... Hat er dich schon immer in deinem Zimmer verfolgt?"

# game/scripts/c13/c13.rpy:804
translate german c13s003_ScarlettHouse_20c3efd6:

    # sca "No, en cualquier sitio de casa, pero la mayoría de veces ha sido en mi habitación."
    sca "Nein, überall im Haus, aber die meiste Zeit war es in meinem Zimmer."

# game/scripts/c13/c13.rpy:805
translate german c13s003_ScarlettHouse_4b4421fe:

    # mc "Puedes decir que me pediste que instalara esa cámara ya que ella no te creía. Así también tienes una razón para que lo haya traído yo en vez de enseñárselo tú ayer."
    mc "Du kannst sagen, du hättest mich gebeten, die Kamera zu installieren, weil sie dir nicht geglaubt hat. Das erklärt auch, warum ich sie ihr gestern gebracht habe, anstatt sie ihr zu zeigen."

# game/scripts/c13/c13.rpy:807
translate german c13s003_ScarlettHouse_c8d6a682:

    # sca "Puede ser una buena idea. Eso le da más plausibilidad. Vamos"
    sca "Das könnte eine gute Idee sein. Das macht es plausibler. Los geht's."

# game/scripts/c13/c13.rpy:809
translate german c13s003_ScarlettHouse_ebd70d04:

    # "Al bajar de la camioneta Scarlett saca el móvil mientras os dirigís a la puerta. Te mira con nerviosismo."
    "Als du aus dem Truck steigst, holt Scarlett ihr Handy heraus, während du zur Tür gehst. Sie sieht dich nervös an."

# game/scripts/c13/c13.rpy:810
translate german c13s003_ScarlettHouse_74b5d1dd:

    # sca "Truco de sordos. Le mando un mensaje a mi madre por la aplicación del timbre, diciéndole que voy a entrar."
    sca "Ein Trick für Gehörlose. Ich schicke meiner Mutter über die Türklingel-App eine Nachricht, dass ich komme."

# game/scripts/c13/c13.rpy:811
translate german c13s003_ScarlettHouse_c28919a2:

    # sca "No puede oír ni el timbre ni la puerta, así está sobreaviso de que hay alguien más en casa."
    sca "Da er weder die Türklingel noch die Tür selbst hört, ist er sich stets bewusst, dass jemand anderes zu Hause ist."

# game/scripts/c13/c13.rpy:813
translate german c13s003_ScarlettHouse_ef708947:

    # mc "Compraremos una cosa así si algún día es necesaria."
    mc "Wir würden so etwas kaufen, falls es jemals nötig sein sollte."

# game/scripts/c13/c13.rpy:815
translate german c13s003_ScarlettHouse_0e0d595e:

    # sca "No puedes saber lo que llego a quererte por cosas como estas."
    sca "Wegen solcher Dinge kannst du nicht wissen, wie sehr ich dich liebe."

# game/scripts/c13/c13.rpy:817
translate german c13s003_ScarlettHouse_33b096ee:

    # "Entraís en casa y Scarlett hace las presentaciones. Te presenta como un amigo."
    "Du betrittst das Haus und Scarlett stellt dich vor. Sie stellt dich als Freundin vor."

# game/scripts/c13/c13.rpy:818
translate german c13s003_ScarlettHouse_1091cbb7:

    # "Te imaginabas que iba a ser una conversación a través de lengua de signos, pero la Señora Russell habla perfectamente, con ese deje especial que tienen las personas que no pueden escucharse."
    "Sie hatten sich vorgestellt, es würde sich um ein Gespräch in Gebärdensprache handeln, aber Frau Russell spricht perfekt, mit diesem besonderen Klang, den Menschen haben, die einander nicht hören können."

# game/scripts/c13/c13.rpy:819
translate german c13s003_ScarlettHouse_070426e2:

    # "Scarlett explica la excusa que habéis inventado para tener el video, sin contarle el contenido."
    "Scarlett erklärt die Ausrede, die du dir ausgedacht hast, um an das Video zu kommen, ohne ihr den Inhalt zu verraten."

# game/scripts/c13/c13.rpy:820
translate german c13s003_ScarlettHouse_a60b0594:

    # "A la Señora Russell no le gusta mucho la idea."
    "Frau Russell ist von der Idee nicht besonders angetan."

# game/scripts/c13/c13.rpy:823
translate german c13s003_ScarlettHouse_452cd8c9:

    # mj "¿Has puesto cámaras en mi casa? ¿Por qué no me has pedido autorización?"
    mj "Haben Sie Kameras in meinem Haus installiert? Warum haben Sie mich nicht um Erlaubnis gefragt?"

# game/scripts/c13/c13.rpy:826
translate german c13s003_ScarlettHouse_0af5e0d8:

    # sca "Mamá, no estabas. No te podía mandar un mensaje por si lo leía Kevin. Tomé la decisión, es mi habitación al fin y al cabo."
    sca "Mama, du warst nicht da. Ich konnte dir keine SMS schreiben, falls Kevin es gesehen hätte. Ich habe meine Entscheidung getroffen; es ist schließlich mein Zimmer."

# game/scripts/c13/c13.rpy:828
translate german c13s003_ScarlettHouse_88202063:

    # mj "Pero está en mi casa. Tendrías que habérmelo dicho."
    mj "Aber es ist in meinem Haus. Du hättest es mir sagen sollen."

# game/scripts/c13/c13.rpy:830
translate german c13s003_ScarlettHouse_cb2497de:

    # sca "Si te lo hubiera dicho me las hubieras hecho quitar y seguiríamos estando igual."
    sca "Hätte ich es dir gesagt, hättest du mich gezwungen, sie auszuziehen, und wir wären immer noch in der gleichen Situation."

# game/scripts/c13/c13.rpy:831
translate german c13s003_ScarlettHouse_33640c56:

    # mc "Cuanta menos gente sepa estas cosas, suele ser mejor, Señora Russell."
    mc "Je weniger Menschen diese Dinge wissen, desto besser, Mrs. Russell."

# game/scripts/c13/c13.rpy:833
translate german c13s003_ScarlettHouse_60acdc76:

    # mj "¿Qué has dicho?"
    mj "Was hast du gesagt?"

# game/scripts/c13/c13.rpy:835
translate german c13s003_ScarlettHouse_ea711448:

    # sca "Mírala de frente cuando hables con ella, [mc]. De esa forma puede leerte los labios."
    sca "Schau ihr direkt in die Augen, wenn du mit ihr sprichst, [mc]. So kann sie deine Lippen lesen."

# game/scripts/c13/c13.rpy:837
translate german c13s003_ScarlettHouse_9d4b4d76:

    # mc "Perdón, Señora Russell, decía que cuanta menos gente sepa estas cosas, suele ser mejor."
    mc "Entschuldigen Sie, Frau Russell, ich meinte, je weniger Menschen diese Dinge wissen, desto besser."

# game/scripts/c13/c13.rpy:838
translate german c13s003_ScarlettHouse_451365d1:

    # mc "Además, si nadie hace nada inapropiado en la habitación de Scarlett, no pasa nada, ¿no?"
    mc "Und solange niemand in Scarletts Zimmer etwas Unangemessenes tut, passiert ja auch nichts, richtig?"

# game/scripts/c13/c13.rpy:839
translate german c13s003_ScarlettHouse_76cff8e4:

    # mj "Si tú tienes acceso a ese video, podrías ver a mi hija desnuda."
    mj "Wenn Sie Zugriff auf dieses Video haben, könnten Sie meine Tochter nackt sehen."

# game/scripts/c13/c13.rpy:841
translate german c13s003_ScarlettHouse_9067efd5:

    # sca "Mamá, hay ángulos muertos, yo sé dónde están y la cama no es visible en el video. Nadie va a verme desnuda."
    sca "Mama, es gibt tote Winkel, ich weiß, wo die sind, und das Bett ist im Video nicht zu sehen. Niemand wird mich nackt sehen."

# game/scripts/c13/c13.rpy:842
translate german c13s003_ScarlettHouse_f4b5029f:

    # sca "Compruébalo tu misma mirando el video."
    sca "Überzeugen Sie sich selbst, indem Sie sich das Video ansehen."

# game/scripts/c13/c13.rpy:844
translate german c13s003_ScarlettHouse_067f0102:

    # "El video comienza con Scarlett en su habitación."
    "Das Video beginnt damit, dass Scarlett in ihrem Zimmer ist."

# game/scripts/c13/c13.rpy:846
translate german c13s003_ScarlettHouse_33e39d1a:

    # kev "Hola Scarlett, ¿Me has echado de menos?"
    kev "Hallo Scarlett, hast du mich vermisst?"

# game/scripts/c13/c13.rpy:847
translate german c13s003_ScarlettHouse_41bf2d96:

    # scav "¡Kevin! Te he dicho mil veces que no entres en mi habitación sin llamar. ¡Podría estar cambiándome!"
    scav "Kevin! Ich hab dir schon tausendmal gesagt, dass du nicht ohne anzuklopfen in mein Zimmer kommen sollst. Ich könnte mich gerade umziehen!"

# game/scripts/c13/c13.rpy:848
translate german c13s003_ScarlettHouse_a0283cf6:

    # mj "¿Entró sin llamar?"
    mj "Ist er ohne anzuklopfen hereingekommen?"

# game/scripts/c13/c13.rpy:849
translate german c13s003_ScarlettHouse_90c56edb:

    # sca "Sí, Mamá, lo hace siempre. Ya le he dicho mil veces que no lo haga."
    sca "Ja, Mama, das macht sie ständig. Ich habe ihr schon tausendmal gesagt, dass sie es lassen soll."

# game/scripts/c13/c13.rpy:851
translate german c13s003_ScarlettHouse_bf4caf26:

    # kev "¿No he llamado? ¿Estás segura? Yo diría que sí. Deberías revisar si llevas bien ajustado tu audífono. *Risa*"
    kev "Ich habe nicht angerufen? Bist du sicher? Ich denke schon. Du solltest überprüfen, ob dein Hörgerät richtig eingestellt ist. *lacht*"

# game/scripts/c13/c13.rpy:852
translate german c13s003_ScarlettHouse_057b77ad:

    # mj "A lo mejor estabas despistada, cariño, y no lo oíste."
    mj "Vielleicht warst du abgelenkt, Liebling, und hast es nicht gehört."

# game/scripts/c13/c13.rpy:853
translate german c13s003_ScarlettHouse_cd766fbe:

    # scav "Idiota, era mi oído bueno el que estaba encarado a la puerta."
    scav "Du Idiot, mein gesundes Ohr zeigte zur Tür."

# game/scripts/c13/c13.rpy:855
translate german c13s003_ScarlettHouse_94f24f3d:

    # kev "Ya sabes que puedes perder el mundo de vista, cuando te pones a pensar en tus cosas y en ese chico que nunca te hará caso. *Risa cruel*"
    kev "Du kennst das ja, man verliert den Blick für die Welt, wenn man nur noch an sich selbst denkt und an diesen Jungen, der einem sowieso nie Beachtung schenken wird. *böses Lachen*"

# game/scripts/c13/c13.rpy:857
translate german c13s003_ScarlettHouse_cdf56ea0:

    # scav "Pues que sepas que estamos saliendo. Imbécil."
    scav "Nur damit du es weißt: Wir sind zusammen. Idiot."

# game/scripts/c13/c13.rpy:859
translate german c13s003_ScarlettHouse_d775c425:

    # scav "No es asunto tuyo si me hace caso o no. Imbécil."
    scav "Es geht dich nichts an, ob er auf mich hört oder nicht. Idiot."

# game/scripts/c13/c13.rpy:860
translate german c13s003_ScarlettHouse_d2e67295:

    # mj "Creo que te has pasado insultándole. Lo que ha dicho es verdad, cuando te pones a pensar en ese chico..."
    mj "Ich finde, du bist mit deinen Beleidigungen zu weit gegangen. Was er gesagt hat, stimmt, wenn man mal über den Kerl nachdenkt..."

# game/scripts/c13/c13.rpy:861
translate german c13s003_ScarlettHouse_e8bd6ad6:

    # sca "¡Mamá!"
    sca "Mutter!"

# game/scripts/c13/c13.rpy:862
translate german c13s003_ScarlettHouse_e15bb926:

    # kev "Pero aún no me has contestado ¿Me has echado de menos?"
    kev "Aber du hast mir immer noch nicht geantwortet. Hast du mich vermisst?"

# game/scripts/c13/c13.rpy:864
translate german c13s003_ScarlettHouse_eebb4602:

    # scav "Si crees que voy a echar de menos a alguien que entra en mi habitación sin autorización y sin llamar, estás muy equivocado."
    scav "Wenn du glaubst, ich würde jemanden vermissen, der ohne Erlaubnis und ohne anzuklopfen mein Zimmer betritt, dann irrst du dich gewaltig."

# game/scripts/c13/c13.rpy:865
translate german c13s003_ScarlettHouse_11f9ffa6:

    # kev "Ya te he dicho que he llamado. A ver si voy a tener que poner cámaras para grabar nuestras conversaciones y cada vez que entro en tu habitación. *Risa*"
    kev "Ich hab dir doch schon gesagt, dass ich angerufen habe. Ich muss wohl Kameras installieren, um unsere Gespräche und jeden Besuch in deinem Zimmer aufzuzeichnen. *lacht*"

# game/scripts/c13/c13.rpy:866
translate german c13s003_ScarlettHouse_b1fa78e1:

    # mj "Alguien las puso..."
    mj "Jemand hat sie dort hingestellt..."

# game/scripts/c13/c13.rpy:868
translate german c13s003_ScarlettHouse_2a7ba7a6:

    # scav "¿Para qué? ¿Para pajearte mientras me cambio?"
    scav "Warum? Damit du dir einen runterholen kannst, während ich mich umziehe?"

# game/scripts/c13/c13.rpy:869
translate german c13s003_ScarlettHouse_33d2ab2a:

    # mj "¡Scarlett!"
    mj "Scarlett!"

# game/scripts/c13/c13.rpy:870
translate german c13s003_ScarlettHouse_548965d0:

    # sca "Espera y lee lo que dice ahora..."
    sca "Warten Sie ab und lesen Sie, was jetzt darin steht..."

# game/scripts/c13/c13.rpy:871
translate german c13s003_ScarlettHouse_b6d075ee:

    # kev "Mira, niña, sería una buena paja. Y después pensaría en ello mientras tu madre me chupa la polla."
    kev "Hör mal, Mädel, das wäre ein geiler Wichser. Und dann würde ich darüber nachdenken, während deine Mutter mir einen bläst."

# game/scripts/c13/c13.rpy:873
translate german c13s003_ScarlettHouse_fc3c8a8c:

    # mj "Es imposible que haya dicho eso... No habéis manipulado los subtítulos, ¿verdad?"
    mj "Das kann unmöglich sein, dass er das gesagt hat... Du hast doch nicht etwa die Untertitel manipuliert?"

# game/scripts/c13/c13.rpy:874
translate german c13s003_ScarlettHouse_8bce374d:

    # mc "No, Señora Russell. Lo que usted lee y lo que oímos nosotros es lo mismo."
    mc "Nein, Frau Russell. Was Sie lesen und was wir hören, ist dasselbe."

# game/scripts/c13/c13.rpy:875
translate german c13s003_ScarlettHouse_0c531c95:

    # sca "Espera, que ahora viene lo peor..."
    sca "Moment mal, das Schlimmste kommt erst noch..."

# game/scripts/c13/c13.rpy:877
translate german c13s003_ScarlettHouse_a3f22826:

    # kev "Y mañana tu madre tiene turno de noche y la he convencido para que te castigue por lo de la olla. No vas a poder fugarte a casa de tu amiguita."
    kev "Und morgen hat deine Mutter Nachtschicht, und ich habe sie überredet, dich für den Vorfall mit dem Marihuana zu bestrafen. Du kannst also nicht zu deinem Freund weglaufen."

# game/scripts/c13/c13.rpy:878
translate german c13s003_ScarlettHouse_c5ef0d82:

    # kev "Eres una inútil que no sirve ni para cocinar unos putos espaguetis."
    kev "Du bist ein nutzloser Mensch, der nicht mal verdammte Spaghetti kochen kann."

# game/scripts/c13/c13.rpy:879
translate german c13s003_ScarlettHouse_21b48917:

    # kev "Por primera vez en meses vamos a estar solos en casa. A lo mejor puedo darte unas lecciones de como chupar una polla, por si ese chico algún día se decide..."
    kev "Zum ersten Mal seit Monaten sind wir allein zu Hause. Vielleicht kann ich dir ein paar Tipps geben, wie man einen Schwanz lutscht, falls der Typ jemals dazu aufkommt..."

# game/scripts/c13/c13.rpy:884
translate german c13s003_ScarlettHouse_5c4ae1ac:

    # scav "Ni se te ocurra acercarte, cabrón."
    scav "Wage es ja nicht, mir zu nahe zu kommen, du Mistkerl."

# game/scripts/c13/c13.rpy:885
translate german c13s003_ScarlettHouse_33d2ab2a_1:

    # mj "¡Scarlett!"
    mj "Scarlett!"

# game/scripts/c13/c13.rpy:887
translate german c13s003_ScarlettHouse_79f1b411:

    # kev "Mejor que guardes esa furia para mañana. Me gustará más así."
    kev "Du solltest dir deinen Ärger lieber für morgen aufheben. Das ist mir lieber."

# game/scripts/c13/c13.rpy:890
translate german c13s003_ScarlettHouse_d35b8ffd:

    # "*Portazo*"
    "*Knall*"

# game/scripts/c13/c13.rpy:892
translate german c13s003_ScarlettHouse_40b82663:

    # mj "Esto no puede ser real. Sé que lo que decía Scarlett coincidía con los subtítulos, puedo leerle los labios en la mayoría del video, pero no me puedo creer que Kevin dijera eso."
    mj "Das kann doch nicht wahr sein. Ich weiß, dass das, was Scarlett gesagt hat, mit den Untertiteln übereinstimmt; ich kann in fast dem ganzen Video ihre Lippen lesen, aber ich kann einfach nicht glauben, dass Kevin das gesagt hat."

# game/scripts/c13/c13.rpy:893
translate german c13s003_ScarlettHouse_ca7013a1:

    # mc "Señora Rusell, es lo que hay en el video, se lo aseguro."
    mc "Frau Russell, genau das ist im Video zu sehen, das versichere ich Ihnen."

# game/scripts/c13/c13.rpy:896
translate german c13s003_ScarlettHouse_502c4e9a:

    # sca "Mamá, [mc] dice la verdad. Kevin me dijo esas cosas."
    sca "Mama, [mc] sagt die Wahrheit. Kevin hat mir das erzählt."

# game/scripts/c13/c13.rpy:898
translate german c13s003_ScarlettHouse_a1f7480b:

    # mj "¿Por qué no me lo dijiste ayer?"
    mj "Warum hast du mir das nicht gestern gesagt?"

# game/scripts/c13/c13.rpy:901
translate german c13s003_ScarlettHouse_da739ef1:

    # sca "Te intenté decir hace unas semanas que se estaba propasando y no me creíste. Esperaba que [mc] viniera con pruebas para poder enseñártelas."
    sca "Ich habe dir schon vor ein paar Wochen versucht zu sagen, dass er Grenzen überschreitet, aber du hast mir nicht geglaubt. Ich hatte gehofft, er würde mit Beweisen kommen, damit ich sie dir zeigen könnte."

# game/scripts/c13/c13.rpy:903
translate german c13s003_ScarlettHouse_adbb64e3:

    # "En ese momento la Señora Russell deja de hablar con su voz y pasa a hacerlo con sus manos. Queda claro que quiere que sea una discusión entre madre e hija."
    "In diesem Moment hört Mrs. Russell auf zu sprechen und beginnt, mit den Händen zu gestikulieren. Es ist klar, dass sie ein Gespräch zwischen Mutter und Tochter führen möchte."

# game/scripts/c13/c13.rpy:904
translate german c13s003_ScarlettHouse_0b6bb391:

    # "Scarlett no traduce."
    "Scarlett lässt sich nicht übersetzen."

# game/scripts/c13/c13.rpy:906
translate german c13s003_ScarlettHouse_c9a30579:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si una de tus chicas acosara a tu hijo, si alguna vez lo tienes."
    "Der Gesichtsausdruck seiner Mutter verrät ihren Zorn; Sie wären auch wütend, wenn eine Ihrer Töchter Ihren Sohn belästigen würde, falls Sie jemals eine hätten."

# game/scripts/c13/c13.rpy:908
translate german c13s003_ScarlettHouse_44a27d8d:

    # "El gesto en la cara de su madre muestra su enfado, tú también lo estarías si tu pareja acosara a tu hijo, si alguna vez lo tienes."
    "Der Gesichtsausdruck seiner Mutter verrät ihren Zorn; Sie wären auch wütend, wenn Ihr Partner Ihr Kind belästigen würde, falls Sie jemals eines haben sollten."

# game/scripts/c13/c13.rpy:910
translate german c13s003_ScarlettHouse_e7673eea:

    # "Solo conoces una frase en lenguaje de signos. Esa frase aparece varias veces. Siempre en manos de Scarlett, nunca de su madre."
    "Du kennst nur einen einzigen Satz in Gebärdensprache. Dieser Satz taucht mehrmals auf. Immer in Scarletts Händen, nie in denen ihrer Mutter."

# game/scripts/c13/c13.rpy:911
translate german c13s003_ScarlettHouse_72ac1e36:

    # "La conversación acaba abruptamente. Las dos están claramente enfadadas. Supones que con Kevin, pero mejor no preguntar."
    "Das Gespräch bricht abrupt ab. Beide sind sichtlich wütend. Du nimmst an, es liegt an Kevin, aber frag lieber nicht nach."

# game/scripts/c13/c13.rpy:913
translate german c13s003_ScarlettHouse_d67c0f6f:

    # sca "Ya está. Dice que Kevin va a tardar poco en volver a casa y le preguntará sobre el video."
    sca "Das war's. Sie sagt, Kevin werde bald nach Hause kommen und sie nach dem Video fragen."

# game/scripts/c13/c13.rpy:914
translate german c13s003_ScarlettHouse_8be7e284:

    # mc "¿Le va a dar la oportunidad de negarlo?"
    mc "Wirst du ihm die Gelegenheit geben, es zu leugnen?"

# game/scripts/c13/c13.rpy:915
translate german c13s003_ScarlettHouse_59f6b087:

    # sca "Sí. Vamos a sentarnos a esperarlo."
    sca "Ja. Setzen wir uns hin und warten wir auf ihn."

# game/scripts/c13/c13.rpy:918
translate german c13s003_ScarlettHouse_9317aa29:

    # "Está claro que durante la conversación las cosas se han caldeado entre madre e hija y ha acabado en enfado. Está claro que ninguna de las dos va a decir una palabra más."
    "Es ist offensichtlich, dass das Gespräch zwischen Mutter und Tochter hitzig wurde und im Streit endete. Es ist klar, dass keine von beiden mehr ein Wort sagen wird."

# game/scripts/c13/c13.rpy:919
translate german c13s003_ScarlettHouse_d82fa969:

    # "Va a ser un silencio muy incómodo hasta que vuelva Kevin."
    "Bis Kevin zurückkommt, wird eine sehr unangenehme Stille herrschen."

# game/scripts/c13/c13.rpy:921
translate german c13s003_ScarlettHouse_d87a05b3:

    # "Por suerte, al cabo de unos minutos el móvil de la Señora Russell vibra."
    "Zum Glück vibriert Frau Russells Handy nach ein paar Minuten."

# game/scripts/c13/c13.rpy:922
translate german c13s003_ScarlettHouse_f10289eb:

    # "Lo mira y su cara se ilumina con una sonrisa."
    "Sie blickt ihn an und ihr Gesicht erstrahlt vor Lächeln."

# game/scripts/c13/c13.rpy:923
translate german c13s003_ScarlettHouse_96d0411e:

    # "No es buena señal."
    "Das ist kein gutes Zeichen."

# game/scripts/c13/c13.rpy:926
translate german c13s003_ScarlettHouse_b5beb2e5:

    # kev "Hola, mi amor. Veo que tenemos visita."
    kev "Hallo, mein Schatz. Ich sehe, wir haben Besuch."

# game/scripts/c13/c13.rpy:928
translate german c13s003_ScarlettHouse_d65b6379:

    # kev "Hola, soy Kevin Cameron. La pareja de esta preciosidad. Y prácticamente el padrastro de la otra belleza."
    kev "Hallo, ich bin Kevin Cameron. Der Partner dieser Schönheit. Und praktisch der Stiefvater der anderen Schönheit."

# game/scripts/c13/c13.rpy:929
translate german c13s003_ScarlettHouse_0e1968fd:

    # "No te levantas. No piensas estrechar su mano."
    "Du stehst nicht auf. Du hast nicht die Absicht, ihm die Hand zu geben."

# game/scripts/c13/c13.rpy:930
translate german c13s003_ScarlettHouse_b80feb7a:

    # "Lo que te apetecería hacer sería meter esos dientes perfectos en su estómago de un puñetazo y dejar su cara hecha pulpa por tus puños."
    "Am liebsten würdest du ihm mit einem einzigen Schlag deine perfekten Zähne in den Magen rammen und sein Gesicht von deinen Fäusten zerfetzen."

# game/scripts/c13/c13.rpy:931
translate german c13s003_ScarlettHouse_70c8ad0c:

    # "Te cuesta retenerte de empezar a hacer zumo con sus ojos. Calma."
    "Du kannst dich kaum beherrschen und willst ihr nicht in die Augen spritzen. Beruhig dich."

# game/scripts/c13/c13.rpy:932
translate german c13s003_ScarlettHouse_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c13/c13.rpy:934
translate german c13s003_ScarlettHouse_26927463:

    # kev "¿Ha pasado algo, cariño?"
    kev "Ist etwas passiert, Liebling?"

# game/scripts/c13/c13.rpy:936
translate german c13s003_ScarlettHouse_fab451ab:

    # mj "Mira este video, mi amor, por favor. Dime que no es cierto."
    mj "Schau dir bitte dieses Video an, mein Schatz. Sag mir, dass es nicht wahr ist."

# game/scripts/c13/c13.rpy:938
translate german c13s003_ScarlettHouse_cfbdaf44:

    # kev "¿De qué va esto, mi vida?"
    kev "Worum geht es hier eigentlich, meine Liebe?"

# game/scripts/c13/c13.rpy:939
translate german c13s003_ScarlettHouse_207f5f72:

    # mj "Míralo, por favor."
    mj "Schauen Sie es sich bitte an."

# game/scripts/c13/c13.rpy:940
translate german c13s003_ScarlettHouse_8ca34c39:

    # "Kevin empieza a mirar el video con una cara de perplejidad."
    "Kevin beginnt, das Video mit einem verdutzten Gesichtsausdruck anzusehen."

# game/scripts/c13/c13.rpy:942
translate german c13s003_ScarlettHouse_9d2a21fc:

    # "Su expresión cambia a sorpresa absoluta tal como pasan los segundos."
    "Sein Gesichtsausdruck wandelt sich mit jeder Sekunde, die vergeht, zu absoluter Überraschung."

# game/scripts/c13/c13.rpy:944
translate german c13s003_ScarlettHouse_d4774db5:

    # "Casi al final del video la sonrisa vuelve a su cara."
    "Gegen Ende des Videos kehrt das Lächeln auf ihr Gesicht zurück."

# game/scripts/c13/c13.rpy:945
translate german c13s003_ScarlettHouse_96d0411e_1:

    # "No es buena señal."
    "Das ist kein gutes Zeichen."

# game/scripts/c13/c13.rpy:947
translate german c13s003_ScarlettHouse_fe059065:

    # kev "*Risa* Está muy bien hecho, pero como broma es un poco pesada."
    kev "*lacht* Es ist sehr gut gemacht, aber als Witz ist es etwas übertrieben."

# game/scripts/c13/c13.rpy:948
translate german c13s003_ScarlettHouse_b3ba264f:

    # mcp "{i}(¿Que?){/i}"
    mcp "{i}(Was?){/i}"

# game/scripts/c13/c13.rpy:949
translate german c13s003_ScarlettHouse_898117f5:

    # kev "Además, este tipo tiene acento de Alabama, y ya sabes que yo soy de Tejas, cariño. No es mi voz."
    kev "Außerdem hat der Typ einen Alabama-Akzent, und du weißt doch, dass ich aus Texas komme, Liebes. Das ist nicht meine Stimme."

# game/scripts/c13/c13.rpy:950
translate german c13s003_ScarlettHouse_26b6669f:

    # "Tu perplejidad no hace más que aumentar. Es cláramente su voz y su acento. Tus ganas de machacarle la cara aumentan. Una bestia empieza a despertarse en tu interior. Calma."
    "Deine Verwirrung wächst. Es ist eindeutig seine Stimme und sein Akzent. Dein Drang, ihm ins Gesicht zu schlagen, wird immer stärker. Ein wildes Tier erwacht in dir. Beruhige dich."

# game/scripts/c13/c13.rpy:951
translate german c13s003_ScarlettHouse_697275cf:

    # kev "*Risa* Lo que estos chicos son capaces de hacer con inteligencia artificial..."
    kev "*Gelächter* Was diese Leute mit künstlicher Intelligenz alles anstellen können..."

# game/scripts/c13/c13.rpy:953
translate german c13s003_ScarlettHouse_d14e9945:

    # mj "¿Entonces no es cierto? ¿Me lo juras?"
    mj "Das stimmt also nicht? Schwörst du es mir?"

# game/scripts/c13/c13.rpy:954
translate german c13s003_ScarlettHouse_0042774a:

    # kev "Por supuesto que te lo juro."
    kev "Natürlich schwöre ich es dir."

# game/scripts/c13/c13.rpy:956
translate german c13s003_ScarlettHouse_b2a49335:

    # mj "¡Lo sabía! No serías capaz de decir esas cosas."
    mj "Ich wusste es! Du würdest solche Dinge nicht sagen können."

# game/scripts/c13/c13.rpy:957
translate german c13s003_ScarlettHouse_278b8aca:

    # kev "Por supuesto que no, cielo. Ya sabes que yo solo tengo ojos para ti."
    kev "Natürlich nicht, Liebling. Du weißt doch, dass ich nur Augen für dich habe."

# game/scripts/c13/c13.rpy:959
translate german c13s003_ScarlettHouse_dc0184ed:

    # mj "Señor Marks, no sé lo que esperaba conseguir con esta broma, pero no ha tenido ninguna gracia. Por favor, márchese de mi casa."
    mj "Herr Marks, ich weiß nicht, was Sie mit diesem Witz bezwecken wollten, aber er war überhaupt nicht lustig. Bitte verlassen Sie mein Haus."

# game/scripts/c13/c13.rpy:960
translate german c13s003_ScarlettHouse_22450a82:

    # mc "Pero Señora Russell, le está mintiendo."
    mc "Aber Frau Russell, er lügt Sie an."

# game/scripts/c13/c13.rpy:961
translate german c13s003_ScarlettHouse_7a8d87e1:

    # mj "Cállese y váyase, por favor."
    mj "Halt den Mund und geh bitte."

# game/scripts/c13/c13.rpy:963
translate german c13s003_ScarlettHouse_be008068:

    # mj "Tú y yo vamos a tener una larga conversación, niña."
    mj "Wir beide werden ein langes Gespräch führen, Mädchen."

# game/scripts/c13/c13.rpy:964
translate german c13s003_ScarlettHouse_2d80d38b:

    # mc "*Susurrando* ¿Qué hago?"
    mc "*Flüsternd* Was soll ich tun?"

# game/scripts/c13/c13.rpy:966
translate german c13s003_ScarlettHouse_7cd63c8c:

    # sca "Vete, [mc]. Ya lo intentaré arreglar... como sea."
    sca "Verschwinde, [mc]. Ich versuche, es irgendwie zu reparieren."

# game/scripts/c13/c13.rpy:968
translate german c13s003_ScarlettHouse_0ba03c0e:

    # kev "Ya te acompaño yo a la puerta, muchacho."
    kev "Ich bringe dich zur Tür, Kleiner."

# game/scripts/c13/c13.rpy:969
translate german c13s003_ScarlettHouse_d99273bb:

    # "La palabra \"muchacho\" va cargada de ironía. Te está diciendo que eres un niño que se ha metido en un juego de adultos al que no pertenece."
    "Das Wort „Junge“ ist voller Ironie. Es sagt dir, dass du ein Kind bist, das in ein Spiel der Erwachsenen geraten ist, in das es nicht gehört."

# game/scripts/c13/c13.rpy:970
translate german c13s003_ScarlettHouse_973610e2:

    # "Te cuesta mucho no dejar salir la bestia que está creciendo dentro de ti. Calma."
    "Es fällt dir sehr schwer, das Biest in dir zu unterdrücken. Beruhige dich."

# game/scripts/c13/c13.rpy:972
translate german c13s003_ScarlettHouse_0bf90338:

    # "Desde la puerta puedes ver cómo madre e hija discuten. Lo surrealista de la situación hace que casi sea gracioso ver a dos personas gritándose en silencio."
    "Vom Türrahmen aus kann man Mutter und Tochter beim Streiten beobachten. Die surreale Situation macht es fast komisch, den beiden beim stummen Anschreien zuzusehen."

# game/scripts/c13/c13.rpy:973
translate german c13s003_ScarlettHouse_928dc63c:

    # kev "Mira, hijo, creía que solo iba a tener una noche a solas con esa putilla. Es demasiado perfecta para que la castiguen a menudo."
    kev "Hör mal, mein Junge, ich dachte, ich hätte nur eine Nacht allein mit dieser kleinen Schlampe. Sie ist zu perfekt, als dass man sie oft bestrafen könnte."

# game/scripts/c13/c13.rpy:974
translate german c13s003_ScarlettHouse_9ac9e45d:

    # kev "Ahora, gracias a ti, me parece que voy a tener muchas noches a solas con ella. La próxima vez que la veas será toda una mujer."
    kev "Dank dir werde ich wohl viele Nächte allein mit ihr verbringen. Wenn du sie das nächste Mal siehst, ist sie eine erwachsene Frau."

# game/scripts/c13/c13.rpy:975
translate german c13s003_ScarlettHouse_01a34171:

    # "Lisa estaría orgullosa de ti. Una bestia a la que has estado a punto de llevar a la extinción aparece con toda la furia de un animal aprisionado."
    "Lisa wäre stolz auf dich. Ein Ungeheuer, das du beinahe ausgerottet hättest, ist mit der ganzen Wut eines eingesperrten Tieres wieder aufgetaucht."

# game/scripts/c13/c13.rpy:978
translate german c13s003_ScarlettHouse_56735bfc:

    # "Tu puño sale disparado hacia la boca de Kevin. No es un rodillo, pero hace el mismo efecto. No saltan dientes."
    "Deine Faust fliegt auf Kevins Mund zu. Sie ist zwar kein Nudelholz, aber der Effekt ist derselbe. Es fliegen keine Zähne heraus."

# game/scripts/c13/c13.rpy:980
translate german c13s003_ScarlettHouse_310a016f:

    # "Scarlett y la Señora Rusell paran la discusión y os miran mientras Kevin cae al suelo."
    "Scarlett und Mrs. Russell beenden den Streit und sehen dich an, während Kevin zu Boden fällt."

# game/scripts/c13/c13.rpy:981
translate german c13s003_ScarlettHouse_f677d9f2:

    # mc "Scarlett, haz las maletas si quieres puedes venir a casa. No voy a dejarte con este cerdo."
    mc "Scarlett, pack deine Sachen. Wenn du willst, kannst du nach Hause kommen. Ich lasse dich doch nicht mit diesem Schwein allein."

# game/scripts/c13/c13.rpy:983
translate german c13s003_ScarlettHouse_25247a8f:

    # kev "¡Te voy a denunciar, hijo de puta! ¡Sé tu nombre!"
    kev "Ich werde dich anzeigen, du Hurensohn! Ich kenne deinen Namen!"

# game/scripts/c13/c13.rpy:985
translate german c13s003_ScarlettHouse_cc6f8065:

    # mj "¡Haz tus maletas y vete de mi casa, Scarlett!"
    mj "Pack deine Koffer und verschwinde aus meinem Haus, Scarlett!"

# game/scripts/c13/c13.rpy:986
translate german c13s003_ScarlettHouse_e44811be:

    # mj "¡No te quiero volver a ver en esta casa!"
    mj "Ich will dich nie wieder in diesem Haus sehen!"

# game/scripts/c13/c13.rpy:987
translate german c13s003_ScarlettHouse_92dacd4e:

    # sca "¿Qué?"
    sca "Das?"

# game/scripts/c13/c13.rpy:988
translate german c13s003_ScarlettHouse_36b09a89:

    # "Nada está saliendo como habías planeado..."
    "Nichts läuft wie geplant..."

# game/scripts/c13/c13.rpy:990
translate german c13s003_ScarlettHouse_04a98fcd:

    # mj "¡Lo que has oído! ¡Primero me destrozas la vida!"
    mj "Du hast mich richtig verstanden! Erst ruinierst du mein Leben!"

# game/scripts/c13/c13.rpy:991
translate german c13s003_ScarlettHouse_2a04d9fb:

    # mj "¡Después tu padre deja de mandarme dinero!"
    mj "Dann hört dein Vater auf, mir Geld zu schicken!"

# game/scripts/c13/c13.rpy:992
translate german c13s003_ScarlettHouse_14f46e82:

    # mj "¡Ahora traes a tu amigo para que apalice a Kevin, con lo bueno que ha sido con nosotras! ¡Fuera de aquí!"
    mj "Jetzt bringst du deinen Freund mit, um Kevin zu verprügeln, nachdem er so nett zu uns war! Verschwinde!"

# game/scripts/c13/c13.rpy:993
translate german c13s003_ScarlettHouse_23c9d6e2:

    # sca "¿Qué estás diciendo? ¿Has estado recibiendo dinero de mi padre todos estos años?"
    sca "Was redest du da? Hast du all die Jahre Geld von meinem Vater bekommen?"

# game/scripts/c13/c13.rpy:994
translate german c13s003_ScarlettHouse_4fec626a:

    # "El tiempo parece haberse detenido para Kevin y para ti. Seguir la pelea hubiera sido lógico. Observar a las dos mujeres gritarse es más interesante."
    "Die Zeit scheint für Kevin und dich stillzustehen. Es wäre logisch gewesen, den Streit zu verfolgen. Doch den beiden Frauen beim Schreien zuzusehen, ist viel interessanter."

# game/scripts/c13/c13.rpy:996
translate german c13s003_ScarlettHouse_65aed982:

    # mj "¡Sí! ¡Y me alegra habértelo ocultado! No te mereces nada."
    mj "Ja! Und ich bin froh, dass ich es dir verschwiegen habe! Du verdienst gar nichts."

# game/scripts/c13/c13.rpy:997
translate german c13s003_ScarlettHouse_a7e99f3c:

    # sca "¡Pues lo buscaré e iré con él! Seguro que estaré mejor con él que contigo. Siempre pensando solo en el dinero y creyendo antes a Kevin que a tu hija."
    sca "Na gut, ich werde ihn finden und mit ihm gehen! Ich bin sicher, mit ihm geht es mir besser als mit dir. Du denkst immer nur ans Geld und glaubst Kevin mehr als deiner Tochter."

# game/scripts/c13/c13.rpy:999
translate german c13s003_ScarlettHouse_3c731fe7:

    # mj "Suerte con eso. Me escribió hace unos días. Como ya tienes 18, no va a mandar más dinero."
    mj "Viel Glück dabei. Er hat mir vor ein paar Tagen geschrieben. Da du jetzt 18 bist, wird er dir kein Geld mehr schicken."

# game/scripts/c13/c13.rpy:1000
translate german c13s003_ScarlettHouse_e11e2a40:

    # mj "Eso es lo que te quiere y se preocupa por ti, mientras yo he sacrificado mi vida por tenerte."
    mj "Das ist es, was er will und worauf es ihm ankommt, während ich mein Leben geopfert habe, um dich zu bekommen."

# game/scripts/c13/c13.rpy:1002
translate german c13s003_ScarlettHouse_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1004
translate german c13s003_ScarlettHouse_3ce3d494:

    # "El móvil de la Señora Russell vuelve a vibrar. El timbre os paraliza a todos durante unos segundos."
    "Frau Russells Telefon vibriert erneut. Der Klingelton lässt euch alle für ein paar Sekunden innehalten."

# game/scripts/c13/c13.rpy:1006
translate german c13s003_ScarlettHouse_6092ea65_1:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1008
translate german c13s003_ScarlettHouse_6092ea65_2:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c13/c13.rpy:1010
translate german c13s003_ScarlettHouse_f326ad6a:

    # "La Señora Russell va a abrir la puerta. Esquiva el cuerpo de Kevin en el suelo. Si no fuera por eso, parecería que no ha pasado nada para ella. "
    "Mrs. Russell will die Tür öffnen. Sie weicht Kevins Leiche auf dem Boden aus. Ohne dieses Vorgehen würde es so aussehen, als sei ihr nichts zugestoßen."

# game/scripts/c13/c13.rpy:1011
translate german c13s003_ScarlettHouse_1795085c:

    # "La persona más inesperada está fuera."
    "Die unerwartetste Person befindet sich draußen."

# game/scripts/c13/c13.rpy:1013
translate german c13s003_ScarlettHouse_475ffd53:

    # ama "FBI. Apártese, Señora Russell."
    ama "FBI. Treten Sie beiseite, Mrs. Russell."

# game/scripts/c13/c13.rpy:1014
translate german c13s003_ScarlettHouse_388905bb:

    # ama "¡[mc] Marks, queda detenido por infracciones contra la Ley de Pivacidad en el Hogar!"
    ama "[mc] Marks, Sie sind wegen Verstößen gegen das Gesetz zur Wahrung der Privatsphäre im Inland verhaftet!"

# game/scripts/c13/c13.rpy:1015
translate german c13s003_ScarlettHouse_bb4742bf:

    # mcp "{i}(No puede ser. Es igualita que [emm]... si no fuera por el pelo... y por que se la ve mucho más adulta que a [emm]...){/i}"
    mcp "{i}(Das kann nicht sein. Sie sieht genauso aus wie [emm]... wenn da nicht die Haare wären... und weil sie viel älter aussieht als [emm]...){/i}"

# game/scripts/c13/c13.rpy:1016
translate german c13s003_ScarlettHouse_8920c9e4:

    # mc "Ama..."
    mc "Liebe..."

# game/scripts/c13/c13.rpy:1017
translate german c13s003_ScarlettHouse_e24ee8e5:

    # ama "¡Silencio! De rodillas. ¡Las manos detras de la espalda!"
    ama "Ruhe! Auf die Knie! Hände hinter den Rücken!"

# game/scripts/c13/c13.rpy:1018
translate german c13s003_ScarlettHouse_8a825d46:

    # "Sigues sus instrucciones. No sabes de qué va esto."
    "Du folgst seinen Anweisungen. Du hast keine Ahnung, worum es geht."

# game/scripts/c13/c13.rpy:1020
translate german c13s003_ScarlettHouse_6cbf7c7c:

    # "Mientras Amanda te esposa..."
    "Während Amanda dir Handschellen anlegt..."

# game/scripts/c13/c13.rpy:1021
translate german c13s003_ScarlettHouse_7a1b5cd4:

    # ama "*Susurrando* No te preocupes..."
    ama "*Flüsternd* Keine Sorge..."

# game/scripts/c13/c13.rpy:1022
translate german c13s003_ScarlettHouse_65204ccf:

    # kev "También me ha agredido..."
    kev "Er hat mich auch angegriffen..."

# game/scripts/c13/c13.rpy:1024
translate german c13s003_ScarlettHouse_50dcfcc7:

    # ama "Eso se sumará a la lista de cargos. Acompáñeme junto con la Señora Russell, por favor. Tengo que tomarles declaración."
    ama "Das wird der Anklage hinzugefügt. Bitte kommen Sie mit mir und Frau Russell. Ich muss Ihre Aussagen aufnehmen."

# game/scripts/c13/c13.rpy:1026
translate german c13s003_ScarlettHouse_47a4ca7e:

    # "Amanda desaparece con la Señora Russell y Kevin. Ambos están en shock."
    "Amanda verschwindet zusammen mit Mrs. Russell und Kevin. Beide stehen unter Schock."

# game/scripts/c13/c13.rpy:1027
translate german c13s003_ScarlettHouse_6b90c0b1:

    # sca "¿Esa era... [emm]?"
    sca "War das... [emm]?"

# game/scripts/c13/c13.rpy:1028
translate german c13s003_ScarlettHouse_a00cff2a:

    # mc "No, pero ahora no te lo puedo explicar. Ayúdame con las esposas."
    mc "Nein, aber ich kann es dir jetzt nicht erklären. Hilf mir mit den Handschellen."

# game/scripts/c13/c13.rpy:1030
translate german c13s003_ScarlettHouse_cc394469:

    # sca "No tengo ni idea de como abrirlas... "
    sca "Ich habe keine Ahnung, wie man sie öffnet..."

# game/scripts/c13/c13.rpy:1031
translate german c13s003_ScarlettHouse_4277e4fe:

    # mc "No te preocupes, Ama... la falsa [emm] va a volver ahora... está de nuestra... de mi parte. Ayúdame a levantarme."
    mc "Keine Sorge, Ama... die falsche kommt jetzt zurück... sie ist auf unserer Seite... auf meiner Seite. Hilf mir auf."

# game/scripts/c13/c13.rpy:1033
translate german c13s003_ScarlettHouse_78d87fc9:

    # ama "Scarlett, ve a hacer las maletas. Tienes un par de horas. No creo que pueda entretenerlos mucho más antes de que empiecen a sospechar."
    ama "Scarlett, pack deine Sachen. Du hast noch ein paar Stunden. Ich glaube nicht, dass ich sie noch lange behalten kann, bevor sie Verdacht schöpfen."

# game/scripts/c13/c13.rpy:1034
translate german c13s003_ScarlettHouse_cfe0f18d:

    # "Su voz transpira autoridad. Pero Scarlett ya no es la niña tímida de hace dos semanas. Algo ha cambiado en ella."
    "Ihre Stimme strahlt Autorität aus. Doch Scarlett ist nicht mehr das schüchterne Mädchen von vor zwei Wochen. Irgendetwas hat sich in ihr verändert."

# game/scripts/c13/c13.rpy:1036
translate german c13s003_ScarlettHouse_9037a408:

    # sca "¿Por qué? ¿Y quién eres? Tienes la cara de [emm], pero ahí acaba el parecido."
    sca "Warum? Und wer bist du? Du hast das Gesicht von [emm], aber da enden die Ähnlichkeiten auch schon."

# game/scripts/c13/c13.rpy:1037
translate german c13s003_ScarlettHouse_ad5f40e7:

    # mc "Scarlett, ya te he dicho que no te lo podía explicar ahora..."
    mc "Scarlett, ich habe dir doch schon gesagt, dass ich es dir jetzt nicht erklären kann..."

# game/scripts/c13/c13.rpy:1040
translate german c13s003_ScarlettHouse_82bd4e59:

    # ama "Será mejor que hagas caso a tu novio, Scarlett."
    ama "Du solltest besser auf deinen Freund hören, Scarlett."

# game/scripts/c13/c13.rpy:1042
translate german c13s003_ScarlettHouse_529e2605:

    # ama "Será mejor que hagas caso a [mc], Scarlett."
    ama "Du solltest besser auf [mc] hören, Scarlett."

# game/scripts/c13/c13.rpy:1043
translate german c13s003_ScarlettHouse_e520b6e2:

    # ama "Si dejo a tu madre y a Kevin mucho rato solos saldrán del estado de shock y empezarán a notar que hay cosas que no cuadran."
    ama "Wenn ich deine Mutter und Kevin für längere Zeit allein lasse, werden sie ihren Schock überwinden und anfangen zu bemerken, dass einige Dinge nicht stimmen."

# game/scripts/c13/c13.rpy:1045
translate german c13s003_ScarlettHouse_27bcf464:

    # sca "Tienes razón. Los agentes del FBI siempre van por parejas en las películas, y has dejado a un sospechoso sin vigilancia. Mi madre no es tonta y lo notará."
    sca "Du hast recht. FBI-Agenten arbeiten in Filmen immer zu zweit, und du hast einen Verdächtigen unbewacht gelassen. Meine Mutter ist nicht dumm, sie wird es merken."

# game/scripts/c13/c13.rpy:1046
translate german c13s003_ScarlettHouse_2f91c156:

    # sca "Voy a hacer las maletas y ahora vuelvo."
    sca "Ich packe jetzt meine Koffer und bin gleich wieder da."

# game/scripts/c13/c13.rpy:1048
translate german c13s003_ScarlettHouse_2e295c3e:

    # "Un minuto después, una vez retiradas las esposas..."
    "Eine Minute später, nachdem die Handschellen abgenommen worden waren..."

# game/scripts/c13/c13.rpy:1049
translate german c13s003_ScarlettHouse_7049495e:

    # ama "¡Joder! Cuando te mandamos el video creíamos que ibas a usar a Jamaal para hacerlo viral en MeTube o llevárselo a Alexia. No esto."
    ama "Verdammt! Als wir dir das Video geschickt haben, dachten wir, du würdest Jamaal benutzen, um es auf MeTube viral gehen zu lassen oder es Alexia zeigen. Nicht so."

# game/scripts/c13/c13.rpy:1050
translate german c13s003_ScarlettHouse_947cf5cd:

    # ama "He venido en cuanto he deducido que tu plan no iba a funcionar."
    ama "Ich kam, sobald mir klar wurde, dass dein Plan nicht funktionieren würde."

# game/scripts/c13/c13.rpy:1051
translate german c13s003_ScarlettHouse_805f55e4:

    # mc "Creía que esto podía solucionarlo todo... Al menos hoy te ha dado tiempo de quitarte el mono de mecánico..."
    mc "Ich dachte, das könnte alles lösen... Wenigstens hattest du heute Zeit, deinen Mechanikeroverall auszuziehen..."

# game/scripts/c13/c13.rpy:1052
translate german c13s003_ScarlettHouse_36417800:

    # mc "¿Desde cuándo tenéis cámaras en casa de Scarlett? ¿Hay otros videos donde se vea la cara de Kevin y la Señora Russell pueda leer sus labios?"
    mc "Seit wann gibt es Kameras in Scarletts Haus? Gibt es weitere Videos, in denen Kevins Gesicht zu sehen ist und Mrs. Russell seine Lippen lesen kann?"

# game/scripts/c13/c13.rpy:1054
translate german c13s003_ScarlettHouse_24b0910e:

    # ama "No, lo siento. Las pusimos el domingo, cuando Scarlett fue a comprar al supermercado..."
    ama "Nein, tut mir leid. Wir haben sie am Sonntag aufgehängt, als Scarlett im Supermarkt einkaufen war..."

# game/scripts/c13/c13.rpy:1056
translate german c13s003_ScarlettHouse_b609be58:

    # mc "Entonces tenéis grabado..."
    mc "Sie haben es also aufgenommen..."

# game/scripts/c13/c13.rpy:1057
translate german c13s003_ScarlettHouse_a62755ee:

    # ama "Sí, pero destruímos todo lo que no es importante para la misión..."
    ama "Ja, aber wir zerstören alles, was für die Mission nicht wichtig ist..."

# game/scripts/c13/c13.rpy:1059
translate german c13s003_ScarlettHouse_424ad18e:

    # mc "Lástima... pero ¿por qué vigilar la casa de Scarlett?"
    mc "Schade... aber warum sollte man Scarletts Haus beobachten?"

# game/scripts/c13/c13.rpy:1060
translate german c13s003_ScarlettHouse_f2975f2e:

    # ama "Podía ser importante para la misión... y destruimos lo que no es importante."
    ama "Es könnte für die Mission wichtig sein... und wir zerstören, was nicht wichtig ist."

# game/scripts/c13/c13.rpy:1061
translate german c13s003_ScarlettHouse_ae4af940:

    # ama "{i}(O lo copiamos a discos privados.){/i}"
    ama "{i}(Oder wir kopieren es auf private Festplatten.){/i}"

# game/scripts/c13/c13.rpy:1062
translate german c13s003_ScarlettHouse_3fddcc67:

    # mc "Y no me vas a decir cual es esa misión, ¿verdad? ¿Tiene algo que ver con la cláusula NG?"
    mc "Und Sie werden mir nun nicht verraten, worum es bei dieser Mission geht, oder? Hat sie etwas mit der NG-Klausel zu tun?"

# game/scripts/c13/c13.rpy:1064
translate german c13s003_ScarlettHouse_76e960e9:

    # ama "{b}¿Qué?{/b} ¿Dónde has oído eso? "
    ama "{b}Was?{/b} Wo hast du das gehört?"

# game/scripts/c13/c13.rpy:1065
translate german c13s003_ScarlettHouse_d881f221:

    # mc "Vosotras tenéis vuestros secretos y yo los míos. Cuando quieras intercambiamos información."
    mc "Du hast deine Geheimnisse und ich habe meine. Wir können uns austauschen, wann immer du willst."

# game/scripts/c13/c13.rpy:1066
translate german c13s003_ScarlettHouse_39cc3e0d:

    # mc "{i}(OK. No tienen acceso a mi ordenador o no son capaces de romper el cifrado de Jamaal.){/i}"
    mc "{i}(OK. Entweder haben sie keinen Zugriff auf meinen Computer oder sie können Jamaals Verschlüsselung nicht knacken.){/i}"

# game/scripts/c13/c13.rpy:1068
translate german c13s003_ScarlettHouse_01ede65e:

    # ama "Me parece justo. Mañana o pasado nos pondremos en contacto con vosotros para hablar."
    ama "Das erscheint mir fair. Wir melden uns morgen oder übermorgen bei Ihnen, um das zu besprechen."

# game/scripts/c13/c13.rpy:1069
translate german c13s003_ScarlettHouse_65abb11e:

    # ama "Voy a llevarme a la Señora Russell y a Kevin o van a empezar a sospechar. Les voy a decir que estás detenido, con lo que mejor que no pases por este barrio en unos días."
    ama "Ich nehme Mrs. Russell und Kevin mit, sonst werden sie misstrauisch. Ich werde ihnen sagen, dass Sie verhaftet sind, und dass Sie sich deshalb die nächsten Tage von dieser Gegend fernhalten sollten."

# game/scripts/c13/c13.rpy:1070
translate german c13s003_ScarlettHouse_776dbc69:

    # mc "Sólo una pregunta más. ¿Por qué me habéis enviado el video? Scarlett no tiene nada que ver con NTR o con GILF."
    mc "Nur noch eine Frage. Warum hast du mir das Video geschickt? Scarlett hat nichts mit NTR oder MILF zu tun."

# game/scripts/c13/c13.rpy:1072
translate german c13s003_ScarlettHouse_1a22ac27:

    # ama "Porque pensamos que podía ser importante. Especialmente para ti... y para [dap]... aunque no tenga nada que ver con la misión. Y porque Kevin es un cerdo."
    ama "Weil wir dachten, es könnte wichtig sein. Besonders für dich … und für [dap] … obwohl es nichts mit der Mission zu tun hat. Und weil Kevin ein Schwein ist."

# game/scripts/c13/c13.rpy:1073
translate german c13s003_ScarlettHouse_b2516466:

    # mc "Gracias."
    mc "Danke schön."

# game/scripts/c13/c13.rpy:1075
translate german c13s003_ScarlettHouse_514c8615:

    # ama "No tienes que darlas. Saca a Scarlett de aquí en cuanto puedas."
    ama "Du musst sie nicht aufgeben. Bring Scarlett so schnell wie möglich hier weg."

# game/scripts/c13/c13.rpy:1076
translate german c13s003_ScarlettHouse_b69bbafa:

    # ama "No sabía lo del dinero de su padre, pero parece que era una de las razones por la que la Señora Russell no la ha echado antes."
    ama "Ich wusste nichts von dem Geld ihres Vaters, aber anscheinend war das einer der Gründe, warum Mrs. Russell sie nicht schon früher entlassen hatte."

# game/scripts/c13/c13.rpy:1077
translate german c13s003_ScarlettHouse_318d4368:

    # ama "Nos veremos pronto. Buen puñetazo, por cierto."
    ama "Bis bald. Übrigens, leckerer Punsch."

# game/scripts/c13/c13.rpy:1080
translate german c13s003_ScarlettHouse_0f479e29:

    # "Haces una llamada a [nor] y, después de confirmar la que pensabas que sería su respuesta, vas a la habitación de Scarlett."
    "Du rufst [nor] an und gehst, nachdem du ihre erwartete Antwort bestätigt hast, zu Scarletts Zimmer."

# game/scripts/c13/c13.rpy:1083
translate german c13s003_ScarlettHouse_6d700f97:

    # mc "¿Necesitas ayuda?"
    mc "Benötigen Sie Hilfe?"

# game/scripts/c13/c13.rpy:1084
translate german c13s003_ScarlettHouse_ac751ecc:

    # sca "No sé por donde empezar. He cogido la ropa... y... y..."
    sca "Ich weiß gar nicht, wo ich anfangen soll. Ich habe die Kleidung aufgesammelt... und... und..."

# game/scripts/c13/c13.rpy:1085
translate german c13s003_ScarlettHouse_b3df5efd:

    # mc "Ven aquí."
    mc "Komm her."

# game/scripts/c13/c13.rpy:1087
translate german c13s003_ScarlettHouse_e808086f:

    # sca "No tengo ni idea de qué voy a hacer... de dónde voy a vivir... estoy sin blanca..."
    sca "Ich habe keine Ahnung, was ich tun soll... wo ich wohnen soll... Ich bin pleite..."

# game/scripts/c13/c13.rpy:1088
translate german c13s003_ScarlettHouse_1d01af04:

    # mc "No te preocupes por eso. Acabo de hablar con [nor] y con [dap]. Les he explicado lo que ha pasado... al menos parte. He obviado lo del video."
    mc "Mach dir keine Sorgen. Ich habe gerade mit [nor] und [dap] gesprochen. Ich habe ihnen erklärt, was passiert ist … zumindest teilweise. Den Teil mit dem Video habe ich weggelassen."

# game/scripts/c13/c13.rpy:1089
translate german c13s003_ScarlettHouse_8b4e277b:

    # mc "Puedes vivir en casa de [nor], si no te importa compartir habitacion con [dap]."
    mc "Du kannst bei [nor] wohnen, wenn es dir nichts ausmacht, ein Zimmer mit [dap] zu teilen."

# game/scripts/c13/c13.rpy:1091
translate german c13s003_ScarlettHouse_de3bf20f:

    # sca "¿Que has hecho {b}qué{/b}?"
    sca "Was haben Sie getan?"

# game/scripts/c13/c13.rpy:1092
translate german c13s003_ScarlettHouse_226564a3:

    # mc "Sí, Scarlett. No tienes que preocuparte de dónde vas a vivir. Casi eres parte de la familia..."
    mc "Ja, Scarlett. Du brauchst dir keine Sorgen um deine Wohnung zu machen. Du gehörst ja quasi zur Familie..."

# game/scripts/c13/c13.rpy:1095
translate german c13s003_ScarlettHouse_9f2f97ad:

    # sca "Te quiero. Gracias."
    sca "Ich liebe dich. Danke."

# game/scripts/c13/c13.rpy:1096
translate german c13s003_ScarlettHouse_95625d17:

    # mc "Y yo a ti. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "Und ich liebe dich auch. Früher hast du die Hälfte deiner Nächte dort verbracht. Jetzt wirst du jede Nacht dort sein."

# game/scripts/c13/c13.rpy:1099
translate german c13s003_ScarlettHouse_2a24d1ed:

    # sca "Gracias, [mc]."
    sca "Vielen Dank, [mc]."

# game/scripts/c13/c13.rpy:1100
translate german c13s003_ScarlettHouse_9b5f1825:

    # mc "No tienes por que darlas. Pasabas la mitad de las noches allí. Ahora serán todas."
    mc "Du musst sie nicht aufgeben. Früher hast du die Hälfte der Nächte dort verbracht. Jetzt wirst du jede Nacht dort sein."

# game/scripts/c13/c13.rpy:1101
translate german c13s003_ScarlettHouse_04554e14:

    # mc "Vamos a acabar de recoger tus cosas y las llevamos a la camioneta."
    mc "Wir werden nun Ihre Sachen einsammeln und sie zum Lieferwagen bringen."

# game/scripts/c13/c13.rpy:1103
translate german c13s003_ScarlettHouse_f65fe139:

    # sca "Pero ¿qué me llevo? Toda mi vida está en esta habitación..."
    sca "Aber was nehme ich mit? Mein ganzes Leben ist in diesem Zimmer..."

# game/scripts/c13/c13.rpy:1104
translate german c13s003_ScarlettHouse_7db5c2cf:

    # mc "Todo lo que quieras conservar."
    mc "Alles, was Sie behalten möchten."

# game/scripts/c13/c13.rpy:1106
translate german c13s003_ScarlettHouse_e16aa35c:

    # mc "Todo lo que quieras llevarte de esta vida a la que vas a empezar en casa."
    mc "Alles, was du aus diesem Leben mitnehmen möchtest, das du nun zu Hause beginnen wirst."

# game/scripts/c13/c13.rpy:1108
translate german c13s003_ScarlettHouse_a1efddeb:

    # mc "Tus fotos y pósters..."
    mc "Ihre Fotos und Poster..."

# game/scripts/c13/c13.rpy:1110
translate german c13s003_ScarlettHouse_bd3a184f:

    # mc "Discos, libros..."
    mc "Schallplatten, Bücher..."

# game/scripts/c13/c13.rpy:1111
translate german c13s003_ScarlettHouse_200e44b7:

    # mc "Cualquier cosa que quieras conservar. La parte de atrás de la camioneta está vacía. Voy a ir llevando el tocadiscos mientras decides que llevar."
    mc "Nimm, was du behalten möchtest. Die Ladefläche des LKW ist leer. Ich nehme den Plattenspieler mit, während du überlegst, was du mitnehmen willst."

# game/scripts/c13/c13.rpy:1114
translate german c13s003_ScarlettHouse_6aba73a2:

    # "Una hora después, tras varios viajes a la camioneta y una llamada de teléfono..."
    "Eine Stunde später, nach mehreren Gängen zum LKW und einem Telefonat..."

# game/scripts/c13/c13.rpy:1115
translate german c13s003_ScarlettHouse_3201de0e:

    # sca "Ya está todo. Nos podemos ir."
    sca "Das war's. Wir können gehen."

# game/scripts/c13/c13.rpy:1116
translate german c13s003_ScarlettHouse_4dab87e9:

    # mc "Despídete de esta casa, Scarlett. ¿Lo llevamos todo?"
    mc "Verabschiede dich von diesem Haus, Scarlett. Sollen wir alles mitnehmen?"

# game/scripts/c13/c13.rpy:1119
translate german c13s003_ScarlettHouse_74dca989:

    # sca "Sí, no queda nada ahí que quiera conservar. Una parte de mí la va a echar de menos. Otra parte mayor... no."
    sca "Ja, da ist nichts mehr, was ich behalten möchte. Ein Teil von mir wird es vermissen. Ein größerer Teil aber nicht."

# game/scripts/c13/c13.rpy:1120
translate german c13s003_ScarlettHouse_7aa1096f:

    # sca "Saber que mi madre me ha estado ocultando cosas, que ha estado en contacto con mi padre todo este tiempo... que ha creído a Kevin antes que a mí..."
    sca "Zu wissen, dass meine Mutter mir Dinge verheimlicht hat, dass sie die ganze Zeit mit meinem Vater in Kontakt stand... dass sie Kevin mehr geglaubt hat als mir..."

# game/scripts/c13/c13.rpy:1121
translate german c13s003_ScarlettHouse_bdab500e:

    # mc "Sé que es difícil de digerir, pero vas a vivir con nosotros. Te vamos a ayudar entre todos."
    mc "Ich weiß, es ist schwer zu akzeptieren, aber du wirst bei uns wohnen. Wir werden dir alle helfen."

# game/scripts/c13/c13.rpy:1123
translate german c13s003_ScarlettHouse_000e092e:

    # sca "Gracias, [mc], una vez más."
    sca "Vielen Dank, [mc], noch einmal."

# game/scripts/c13/c13.rpy:1124
translate german c13s003_ScarlettHouse_978ec110:

    # mc "No tienes por qué darlas. Pero nos tenemos que ir. Las nuevas inquilinas nos estarán esperando."
    mc "Sie müssen sie nicht geben. Aber wir müssen gehen. Die neuen Mieter werden auf uns warten."

# game/scripts/c13/c13.rpy:1126
translate german c13s003_ScarlettHouse_89ac21b9:

    # sca "Es verdad, hoy llegaba la última estudiante del verano."
    sca "Ganz genau, heute ist der letzte Schüler des Sommers angekommen."

# game/scripts/c13/c13.rpy:1127
translate german c13s003_ScarlettHouse_e944ed7a:

    # mc "Sí, pasamos por el hospital a recoger a Kiara y vamos al aeropuerto a buscarla. Su vuelo llega en una hora."
    mc "Ja, wir fahren ins Krankenhaus, um Kiara abzuholen, und dann zum Flughafen, um sie in Empfang zu nehmen. Ihr Flug landet in einer Stunde."

# game/scripts/c13/c13.rpy:1129
translate german c13s003_ScarlettHouse_ad060bf5:

    # sca "¿Kiara?"
    sca "Kiara?"

# game/scripts/c13/c13.rpy:1130
translate german c13s003_ScarlettHouse_b1268ea3:

    # mc "Ahora la conocerás. Creo que te va a gustar."
    mc "Du wirst sie jetzt kennenlernen. Ich glaube, sie wird dir gefallen."

# game/scripts/c13/c13.rpy:1163
translate german c13s004_KiaraAndScarlett_5ef2e59f:

    # sca "¿Quién es? ¿La conozco? No me suena el nombre."
    sca "Wer ist sie? Kenne ich sie? Der Name sagt mir nichts."

# game/scripts/c13/c13.rpy:1164
translate german c13s004_KiaraAndScarlett_b6297da9:

    # mc "Es la madre de Eileen. Va a vivir unos días con vosotras, en casa de [nor]."
    mc "Sie ist Eileens Mutter. Sie wird ein paar Tage bei dir im Haus von [nor] wohnen."

# game/scripts/c13/c13.rpy:1166
translate german c13s004_KiaraAndScarlett_e8600231:

    # sca "¿Eileen también?"
    sca "Auch Eileen?"

# game/scripts/c13/c13.rpy:1167
translate german c13s004_KiaraAndScarlett_157800dc:

    # mc "Sí, ¿por qué lo preguntas?"
    mc "Ja, warum fragen Sie?"

# game/scripts/c13/c13.rpy:1170
translate german c13s004_KiaraAndScarlett_a7826cfb:

    # sca "Tan solo por curiosidad. Hace un tiempo me hubiera puesto celosa por saber que Eileen iba a vivir en tu casa... más o menos..."
    sca "Nur mal so aus Neugier. Vor einer Weile wäre ich neidisch gewesen, wenn ich gewusst hätte, dass Eileen in dein Haus einziehen würde... irgendwie..."

# game/scripts/c13/c13.rpy:1172
translate german c13s004_KiaraAndScarlett_b0adc982:

    # sca "Ahora que sé que estás saliendo con otras chicas, casi me alegraría que Eileen fuera una de ellas... y no, no estoy preguntando si lo es."
    sca "Jetzt, wo ich weiß, dass du auch andere Mädchen triffst, wäre ich fast froh, wenn Eileen eine von ihnen wäre... und nein, ich frage nicht, ob sie es ist."

# game/scripts/c13/c13.rpy:1173
translate german c13s004_KiaraAndScarlett_51746308:

    # mc "Eso se lo tendrás que preguntar a ella. A ser posible conmigo delante. *Risa* Su cara puede ser muy divertida {b}si{/b} no estoy con ella."
    mc "Das musst du sie fragen. Am besten, wenn ich dabei bin. *lacht* Ihr Gesicht kann urkomisch sein, wenn ich nicht dabei bin."

# game/scripts/c13/c13.rpy:1175
translate german c13s004_KiaraAndScarlett_c76f8262:

    # sca "Ahora que estás saliendo conmigo, me da lo mismo quien viva contigo... con nosotros..."
    sca "Jetzt, wo du mit mir zusammen bist, ist es mir egal, wer mit dir... mit uns... zusammenlebt."

# game/scripts/c13/c13.rpy:1176
translate german c13s004_KiaraAndScarlett_32afb495:

    # mc "Scarlett, ahora mismo solo me importas tú. No me importa quién viva en casa."
    mc "Scarlett, im Moment bist du alles, was mir wichtig ist. Mir ist egal, wer zu Hause wohnt."

# game/scripts/c13/c13.rpy:1179
translate german c13s004_KiaraAndScarlett_44fd8b13:

    # sca "Tan solo por curiosidad. Tú y yo no vamos a estar juntos nunca, con lo que no debo ponerme celosa por que tu ex viva en tu casa... más o menos..."
    sca "Nur mal so aus Neugier. Du und ich werden ja nie zusammen sein, also sollte ich nicht eifersüchtig sein, dass dein Ex in deinem Haus wohnt... irgendwie schon..."

# game/scripts/c13/c13.rpy:1180
translate german c13s004_KiaraAndScarlett_efc8d372:

    # mc "Scarlett, ya lo hemos hablado. No sería justo para ninguno de los dos, lo único que harías es hacerte daño."
    mc "Scarlett, wir haben das doch schon besprochen. Es wäre uns beiden gegenüber unfair; du würdest dir damit nur selbst schaden."

# game/scripts/c13/c13.rpy:1181
translate german c13s004_KiaraAndScarlett_476b8ad5:

    # sca "Lo sé, pero no por ello es más fácil."
    sca "Ich weiß, aber das macht es nicht einfacher."

# game/scripts/c13/c13.rpy:1183
translate german c13s004_KiaraAndScarlett_d2307d68:

    # sca "Si puedo preguntar, ¿por qué se han mudado a casa de [nor]?"
    sca "Darf ich fragen, warum Sie in das Haus von [nor] gezogen sind?"

# game/scripts/c13/c13.rpy:1184
translate german c13s004_KiaraAndScarlett_e3304c3c:

    # mc "Por la misma razón que tú. Han tenido problemas en casa, y les hemos ofrecido un sitio donde quedarse. De momento se quedarán una semana."
    mc "Aus demselben Grund wie du. Sie hatten Probleme zu Hause, und wir haben ihnen eine Unterkunft angeboten. Sie werden vorerst eine Woche hier bleiben."

# game/scripts/c13/c13.rpy:1185
translate german c13s004_KiaraAndScarlett_643a6609:

    # sca "Supongo que no vas a entrar en detalles igual que no entrarías si alguien te preguntará por qué me he mudado yo."
    sca "Ich nehme an, Sie werden nicht ins Detail gehen, genau wie Sie es nicht tun würden, wenn Sie jemand fragen würde, warum ich umgezogen bin."

# game/scripts/c13/c13.rpy:1186
translate german c13s004_KiaraAndScarlett_a4c22620:

    # mc "Exacto. Creo que cada una de vosotras tiene derecho a explicar lo que quiera a quién quiera."
    mc "Genau. Ich glaube, dass jeder von Ihnen das Recht hat, wem auch immer er oder sie will, alles zu erklären."

# game/scripts/c13/c13.rpy:1188
translate german c13s004_KiaraAndScarlett_a843553c:

    # sca "Y cambiando de tema... ¿quién es la falsa [emm]?"
    sca "Und nun zu einem anderen Thema... wer ist der falsche [emm]?"

# game/scripts/c13/c13.rpy:1189
translate german c13s004_KiaraAndScarlett_85a9d95c:

    # mc "Aún no estoy muy seguro. De momento te puedo decir que las dos veces que la he visto ha aparecido para ayudar. Fue ella la que mandó el video."
    mc "Ich bin mir noch nicht ganz sicher. Im Moment kann ich Ihnen aber sagen, dass sie mir beide Male, als ich sie gesehen habe, geholfen hat. Sie war es, die das Video geschickt hat."

# game/scripts/c13/c13.rpy:1190
translate german c13s004_KiaraAndScarlett_036ff51c:

    # mc "Me ha dicho que en uno o dos días se pondrá en contacto con la familia para aclarar las cosas... supongo..."
    mc "Er sagte mir, er würde sich in ein oder zwei Tagen mit der Familie in Verbindung setzen, um die Sache zu klären... nehme ich an..."

# game/scripts/c13/c13.rpy:1192
translate german c13s004_KiaraAndScarlett_de8df744:

    # sca "¿Cómo sabía lo que estaba pasando? ¿También hay cámaras en el salón?"
    sca "Woher wusste er, was vor sich ging? Gibt es auch im Wohnzimmer Kameras?"

# game/scripts/c13/c13.rpy:1193
translate german c13s004_KiaraAndScarlett_af4565c7:

    # mc "Creo que la casa de tu madre tiene cámaras por todos lados..."
    mc "Ich glaube, im Haus deiner Mutter sind überall Kameras..."

# game/scripts/c13/c13.rpy:1195
translate german c13s004_KiaraAndScarlett_cfc8099c:

    # mcp "{i}(Mejor no decirle que nos grabaron el domingo. Si han destruído el video, no hay de qué preocuparse.){/i}"
    mcp "{i}(Am besten erzählen wir ihnen nicht, dass wir am Sonntag aufgenommen wurden. Falls sie das Video vernichtet haben, besteht kein Grund zur Sorge.){/i}"

# game/scripts/c13/c13.rpy:1196
translate german c13s004_KiaraAndScarlett_ce92fc45:

    # mc "Ya estamos llegando al hospital. Ahora te presento a Kiara y vamos a comer."
    mc "Wir sind fast im Krankenhaus. Jetzt stelle ich Ihnen Kiara vor und dann essen wir zu Mittag."

# game/scripts/c13/c13.rpy:1198
translate german c13s004_KiaraAndScarlett_b831fce0:

    # mc "Hola, Kiara. Sube."
    mc "Hallo Kiara. Komm hoch."

# game/scripts/c13/c13.rpy:1200
translate german c13s004_KiaraAndScarlett_58b194a6:

    # mc "¿Cómo ha ido? ¿Qué tal te ha tratado Sam?"
    mc "Wie ist es gelaufen? Wie hat Sam dich behandelt?"

# game/scripts/c13/c13.rpy:1201
translate german c13s004_KiaraAndScarlett_358f76fc:

    # kia "Mal y bien. El hematoma es señal de un pequeño desgarro muscular. Samantha ha sido un cielo, me ha dado un ungüento."
    kia "Gut und schlecht. Der Bluterguss deutet auf einen kleinen Muskelfaserriss hin. Samantha war wunderbar; sie hat mir eine Salbe gegeben."

# game/scripts/c13/c13.rpy:1202
translate german c13s004_KiaraAndScarlett_2893d567:

    # mc "Por cierto, Scarlett - Kiara, Kiara - Scarlett."
    mc "Übrigens, Scarlett - Kiara, Kiara - Scarlett."

# game/scripts/c13/c13.rpy:1203
translate german c13s004_KiaraAndScarlett_32eb5c67:

    # kia "Encantada, Scarlett."
    kia "Schön, dich kennenzulernen, Scarlett."

# game/scripts/c13/c13.rpy:1205
translate german c13s004_KiaraAndScarlett_a1ed0ab0:

    # sca "Igualmente, Kiara. Me ha dicho [mc] que somos las nuevas inquilinas. Yo también me mudo hoy."
    sca "Genauso wie Kiara. Sie hat mir gesagt, dass wir die neuen Mieter sind. Ich ziehe heute auch ein."

# game/scripts/c13/c13.rpy:1207
translate german c13s004_KiaraAndScarlett_5287ccd9:

    # kia "¡Oh! ¿Eres la nueva estudiante? Creía que tu vuelo llegaba más tarde..."
    kia "Oh! Bist du der neue Student? Ich dachte, dein Flug wäre später angekommen..."

# game/scripts/c13/c13.rpy:1208
translate german c13s004_KiaraAndScarlett_7bd44854:

    # mc "No, Scarlett es una amiga de la familia. Se va a mudar a la habitación de [dap]. A la estudiante la irémos a buscar después de dejarte en el trabajo."
    mc "Nein, Scarlett ist eine Freundin der Familie. Sie zieht in Zimmer [dap]. Wir holen sie ab, nachdem wir dich zur Arbeit gebracht haben."

# game/scripts/c13/c13.rpy:1210
translate german c13s004_KiaraAndScarlett_20e889df:

    # kia "Genial, me extrañaba que hubiera volado con tantas cajas."
    kia "Großartig, ich war überrascht, dass es mit so vielen Kisten geflogen ist."

# game/scripts/c13/c13.rpy:1211
translate german c13s004_KiaraAndScarlett_0d285e83:

    # kia "No me va a dar tiempo de comer con vosotros. Voy a llegar un poco justa."
    kia "Ich werde leider keine Zeit haben, mit dir zu essen. Ich bin etwas in Eile."

# game/scripts/c13/c13.rpy:1212
translate german c13s004_KiaraAndScarlett_7f73e754:

    # mc "Aún nos queda un rato. Conozco un sitio al lado de tu trabajo. O conocía antes de ir a la universidad... no sé si el puesto de perritos seguirá ahí."
    mc "Wir haben noch etwas Zeit. Ich kenne da einen Laden in der Nähe deiner Arbeit. Oder besser gesagt, ich kannte ihn, bevor ich an die Uni ging... Ich weiß nicht, ob der Hotdog-Stand noch da ist."

# game/scripts/c13/c13.rpy:1214
translate german c13s004_KiaraAndScarlett_7e424464:

    # kia "Sí, sigue ahí. Dejadme invitaros a comer."
    kia "Ja, es ist noch da. Darf ich Sie zum Mittagessen einladen?"

# game/scripts/c13/c13.rpy:1215
translate german c13s004_KiaraAndScarlett_0e6f0b92:

    # mc "He sido yo quién te ha dicho que te invitaría a comer, con lo que no voy a aceptar que pagues tú."
    mc "Ich war es, die dir gesagt hat, dass ich dich zum Mittagessen einladen würde, also werde ich nicht akzeptieren, dass du bezahlst."

# game/scripts/c13/c13.rpy:1216
translate german c13s004_KiaraAndScarlett_db027e54:

    # mc "Scarlett, ¿te gustan los perritos?"
    mc "Scarlett, magst du Welpen?"

# game/scripts/c13/c13.rpy:1218
translate german c13s004_KiaraAndScarlett_5233075e:

    # sca "¡Me encantan!"
    sca "Ich liebe sie!"

# game/scripts/c13/c13.rpy:1219
translate german c13s004_KiaraAndScarlett_8758fbc0:

    # mc "Entonces no se hable más. Perritos para todos."
    mc "Damit ist die Sache entschieden. Welpen für alle."

# game/scripts/c13/c13.rpy:1222
translate german c13s004_KiaraAndScarlett_a94a922f:

    # "Unos perritos después..."
    "Ein paar Welpen später..."

# game/scripts/c13/c13.rpy:1224
translate german c13s004_KiaraAndScarlett_e4c4cefc:

    # sca "Y esa es mi historia y por qué de me estoy mudando..."
    sca "Und das ist meine Geschichte und der Grund, warum ich umziehe..."

# game/scripts/c13/c13.rpy:1225
translate german c13s004_KiaraAndScarlett_06996d74:

    # mcp "{i}(Has hecho bien en omitir lo del video. Habría que dar muchas explicaciones a Kiara y querría hablar con Amanda antes. O con Eva.){/i}"
    mcp "{i}(Es war gut, dass du das Video weggelassen hast. Ich müsste Kiara einiges erklären und möchte zuerst mit Amanda sprechen. Oder mit Eva.){/i}"

# game/scripts/c13/c13.rpy:1227
translate german c13s004_KiaraAndScarlett_8453653e:

    # kia "Lo siento mucho, Scarlett. Yo creía que lo mío era malo, pero lo tuyo es horrible."
    kia "Es tut mir so leid, Scarlett. Ich dachte, was ich habe, wäre schlimm, aber was du hast, ist furchtbar."

# game/scripts/c13/c13.rpy:1228
translate german c13s004_KiaraAndScarlett_360b7833:

    # kia "No sé si es peor lo de Kevin o que te haya ocultado que ha estado en contacto con tu padre."
    kia "Ich weiß nicht, was schlimmer ist, was mit Kevin passiert ist, oder dass er dir verschwiegen hat, dass er Kontakt zu deinem Vater hatte."

# game/scripts/c13/c13.rpy:1229
translate german c13s004_KiaraAndScarlett_2cf9c70c:

    # mcp "(Es sorprendente lo rápido que han encajado estas dos. Las dos lo han pasado mal y a Kiara le ha salido la vena maternal y protectora en cuanto se han explicado sus historias.)"
    mcp "(Es ist überraschend, wie schnell die beiden eine Bindung aufgebaut haben. Sie hatten beide eine schwere Zeit durchgemacht, aber Kiaras mütterliche und beschützende Seite kam sofort zum Vorschein, als sie ihre Geschichten austauschten.)"

# game/scripts/c13/c13.rpy:1231
translate german c13s004_KiaraAndScarlett_14d8115c:

    # sca "Lo más peligroso ha sido lo de Kevin. Lo que más me ha dolido ha sido lo de mi padre."
    sca "Das Gefährlichste war, was Kevin widerfahren ist. Am meisten schmerzte mich jedoch, was meinem Vater zugestoßen ist."

# game/scripts/c13/c13.rpy:1232
translate german c13s004_KiaraAndScarlett_a1e52128:

    # sca "Ella sabe lo importante que ha sido para mí saber quién es durante todos estos años. Ocultarmelo ha sido... doloroso."
    sca "Sie weiß, wie wichtig es mir all die Jahre war, zu wissen, wer sie ist. Es vor mir zu verbergen, war... schmerzhaft."

# game/scripts/c13/c13.rpy:1234
translate german c13s004_KiaraAndScarlett_354746d2:

    # mcp "{i}(Si mis sospechas son ciertas, no tendrás que esperar mucho para saberlo, aunque sea un saco de mierda.){/i}"
    mcp "(Wenn meine Vermutungen stimmen, wirst du es nicht lange warten müssen, selbst wenn es sich um einen Haufen Mist handelt.)"

# game/scripts/c13/c13.rpy:1236
translate german c13s004_KiaraAndScarlett_dd9e5fa2:

    # kia "Yo podría hacer algo al respecto si la cosa se pusiera fea, pero tú lo tienes más complicado con lo de Kevin. Sin pruebas..."
    kia "Ich könnte etwas unternehmen, falls die Sache brenzlig wird, aber deine Situation mit Kevin ist komplizierter. Ohne Beweise..."

# game/scripts/c13/c13.rpy:1237
translate german c13s004_KiaraAndScarlett_3222cbfa:

    # mc "Ahora solo hace falta que quieras hacerlo antes de que se ponga demasiado fea."
    mc "Jetzt musst du es nur noch wirklich wollen, bevor es zu schlimm wird."

# game/scripts/c13/c13.rpy:1239
translate german c13s004_KiaraAndScarlett_fb4a8f13:

    # kia "No insistas, [mc]. No quiero poner la denuncia. Ha sido la primera vez en 3 años, creo que se va a asustar lo suficiente con que nos hayamos marchado como para repetirlo."
    kia "Hör auf, [mc]. Ich will keine Anzeige erstatten. Es war das erste Mal seit drei Jahren; ich denke, er wird durch unseren Weggang genug Angst haben, es nicht wieder zu tun."

# game/scripts/c13/c13.rpy:1240
translate german c13s004_KiaraAndScarlett_ff89f607:

    # mc "No estoy insistiendo, Kiara. Al menos ahora tienes un informe médico por si cambias de opinión. Espero que no lo hagas demasiado tarde."
    mc "Ich will dich nicht unter Druck setzen, Kiara. Aber jetzt hast du wenigstens einen ärztlichen Bericht, falls du deine Meinung änderst. Ich hoffe, es ist nicht zu spät."

# game/scripts/c13/c13.rpy:1242
translate german c13s004_KiaraAndScarlett_c023c137:

    # sca "Creo que te equivocas, [mc]. Si fuera yo, presentaría la denuncia, pero Kiara tiene razón."
    sca "Ich glaube, du irrst dich, [mc]. An deiner Stelle würde ich Anzeige erstatten, aber Kiara hat Recht."

# game/scripts/c13/c13.rpy:1243
translate german c13s004_KiaraAndScarlett_3c49f85a:

    # sca "Pero quien pega a una mujer por norma es un cobarde. Kiara y Eileen lo han abandonado, aunque sea temporalmente, y eso le hará recapacitar."
    sca "Aber ein Mann, der regelmäßig eine Frau schlägt, ist ein Feigling. Kiara und Eileen haben ihn verlassen, wenn auch nur vorübergehend, und das wird ihn zum Umdenken bringen."

# game/scripts/c13/c13.rpy:1244
translate german c13s004_KiaraAndScarlett_def014f3:

    # mc "Espero que tengas razón. Que la tengáis las dos."
    mc "Ich hoffe, du hast recht. Ich hoffe, ihr habt beide recht."

# game/scripts/c13/c13.rpy:1246
translate german c13s004_KiaraAndScarlett_f1d8bdfe:

    # kia "Yo sé que la tenemos, y lo verás la semana que viene cuando volvamos a casa."
    kia "Ich weiß, wir haben es, und du wirst es nächste Woche sehen, wenn wir wieder zu Hause sind."

# game/scripts/c13/c13.rpy:1247
translate german c13s004_KiaraAndScarlett_5e10232b:

    # kia "Ahora debería ir a trabajar si no quiero llegar tarde. Muchas gracias por todo, [mc]."
    kia "Ich sollte jetzt zur Arbeit gehen, wenn ich nicht zu spät kommen will. Vielen Dank für alles, [mc]."

# game/scripts/c13/c13.rpy:1248
translate german c13s004_KiaraAndScarlett_b94a64b5:

    # mc "¿Quieres que pase a buscarte cuando salgas del trabajo?"
    mc "Soll ich dich abholen, wenn du Feierabend hast?"

# game/scripts/c13/c13.rpy:1250
translate german c13s004_KiaraAndScarlett_60042da8:

    # kia "No hace falta, cogeré el autobús. Saldré tarde hoy."
    kia "Das ist nicht nötig, ich nehme den Bus. Ich fahre heute spät los."

# game/scripts/c13/c13.rpy:1251
translate german c13s004_KiaraAndScarlett_b3a301a0:

    # kia "Nos vemos en casa de [nor], Scarlett. Hasta luego, [mc]."
    kia "Wir sehen uns bei [nor], Scarlett. Bis später, [mc]."

# game/scripts/c13/c13.rpy:1252
translate german c13s004_KiaraAndScarlett_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Auf Wiedersehen, Kiara."

# game/scripts/c13/c13.rpy:1254
translate german c13s004_KiaraAndScarlett_3218746c:

    # sca "Nos vemos en casa, Kiara."
    sca "Wir sehen uns zu Hause, Kiara."

# game/scripts/c13/c13.rpy:1255
translate german c13s004_KiaraAndScarlett_3a775a62:

    # mcp "{i}(Enorme diferencia en la misma frase. Para Scarlett ya es su casa. Kiara lógicamente se siente como una invitada. No me importaría que se quedaran. Estarían más seguras.){/i}"
    mcp "{i}(Ein gewaltiger Unterschied im selben Satz. Für Scarlett ist es bereits ihr Zuhause. Kiara fühlt sich verständlicherweise wie eine Gästin. Ich hätte nichts dagegen, wenn sie blieben. Sie wären sicherer.){/i}"

# game/scripts/c13/c13.rpy:1256
translate german c13s004_KiaraAndScarlett_54150ef5:

    # mc "Siguiente parada, el aeropuerto para recoger a Saira"
    mc "Nächster Halt: der Flughafen, um Saira abzuholen."

# game/scripts/c13/c13.rpy:1258
translate german c13s004_KiaraAndScarlett_b9d51006:

    # sca "¿Saira? ¿No se llamaba así tu novia de Portland? Bueno... novia... la chica con la que tenías una relación abierta..."
    sca "Saira? War das nicht der Name deiner Freundin aus Portland? Na ja... Freundin... das Mädchen, mit dem du eine offene Beziehung hattest..."

# game/scripts/c13/c13.rpy:1259
translate german c13s004_KiaraAndScarlett_06eb7682:

    # mc "Sí, estoy seguro de que es ella. Solo me falta confirmarlo."
    mc "Ja, ich bin mir sicher, dass sie es ist. Ich muss es nur noch bestätigen."

# game/scripts/c13/c13.rpy:1261
translate german c13s004_KiaraAndScarlett_cb35737c:

    # sca "¿Querrías que fuera ella?"
    sca "Möchtest du, dass sie es ist?"

# game/scripts/c13/c13.rpy:1262
translate german c13s004_KiaraAndScarlett_a84177cf:

    # mc "Por una parte no estoy seguro. Por otra, sí, lo querría. Si no fuera ella no la reconocería y me he dejado el cartel con su nombre en casa. *Risa*"
    mc "Einerseits bin ich mir nicht sicher. Andererseits, ja, das würde ich. Wenn sie es nicht gewesen wäre, hätte ich sie nicht erkannt, und ich habe das Schild mit ihrem Namen zu Hause gelassen. *Lacht*"

# game/scripts/c13/c13.rpy:1264
translate german c13s004_KiaraAndScarlett_7e338ccc:

    # mc "¿Te molestaría que fuera ella?"
    mc "Würde es dich stören, wenn sie es wäre?"

# game/scripts/c13/c13.rpy:1266
translate german c13s004_KiaraAndScarlett_abb3b810:

    # sca "Por una parte sí. No saber si viene a recuperarte o no... me pondría nerviosa."
    sca "In gewisser Hinsicht, ja. Die Ungewissheit, ob er zurückkommt, um dich abzuholen oder nicht... würde mich nervös machen."

# game/scripts/c13/c13.rpy:1267
translate german c13s004_KiaraAndScarlett_1b73f7b4:

    # sca "Por otra parte, le debo estar agradecida."
    sca "Andererseits bin ich ihr zu Dank verpflichtet."

# game/scripts/c13/c13.rpy:1268
translate german c13s004_KiaraAndScarlett_ce705018:

    # mc "¿Qué? ¿Por qué?"
    mc "Was? Warum?"

# game/scripts/c13/c13.rpy:1271
translate german c13s004_KiaraAndScarlett_82bd8710:

    # sca "Por meterte en esa cabezota tuya la idea de las relaciones abiertas o con más de una chica."
    sca "Weil du dir die Idee von offenen Beziehungen oder Beziehungen mit mehr als einem Mädchen in den Kopf gesetzt hast."

# game/scripts/c13/c13.rpy:1273
translate german c13s004_KiaraAndScarlett_17f694d7:

    # sca "No me gustaría tener que competir con [dap] por la exclusividad."
    sca "Ich möchte nicht mit [dap] um Exklusivität konkurrieren müssen."

# game/scripts/c13/c13.rpy:1275
translate german c13s004_KiaraAndScarlett_75d06d6d:

    # sca "Si solo quisieras estar con una chica yo tendría menos oportunidades de ser la elegida."
    sca "Wenn du nur mit einem Mädchen zusammen sein wolltest, hätte ich geringere Chancen, die Auserwählte zu sein."

# game/scripts/c13/c13.rpy:1277
translate german c13s004_KiaraAndScarlett_69fa4c89:

    # sca "Por dejarte marchar sin asegurar la relación. Si no fuera por eso, difícilmente estaríamos juntos ahora."
    sca "Dafür, dass ich dich gehen ließ, ohne die Beziehung zu sichern. Ohne das wären wir jetzt wohl kaum zusammen."

# game/scripts/c13/c13.rpy:1278
translate german c13s004_KiaraAndScarlett_deb508bd:

    # mc "Tienes razón. La situación sería muy diferente si no fuera por ella."
    mc "Du hast Recht. Ohne sie wäre die Situation ganz anders."

# game/scripts/c13/c13.rpy:1279
translate german c13s004_KiaraAndScarlett_425e57ba:

    # mc "Ya que estamos hablando de Saira, ¿cómo quieres que te presente? ¿Amiga? ¿Novia?"
    mc "Da wir gerade von Saira sprechen, wie soll ich dich vorstellen? Freundin? Freundin?"

# game/scripts/c13/c13.rpy:1281
translate german c13s004_KiaraAndScarlett_739cb058:

    # sca "¡Novia, por supuesto! Si quieres hacerlo público claro..."
    sca "Freundin, natürlich! Wenn du es öffentlich machen willst, klar..."

# game/scripts/c13/c13.rpy:1282
translate german c13s004_KiaraAndScarlett_c38fe74d:

    # mc "Entonces será novia."
    mc "Dann wird sie meine Freundin sein."

# game/scripts/c13/c13.rpy:1285
translate german c13s004_KiaraAndScarlett_b5aa0bb2:

    # sca "¿Vamos? Tengo ganas de conocerla."
    sca "Sollen wir gehen? Ich würde sie sehr gerne kennenlernen."

# game/scripts/c13/c13.rpy:1327
translate german c13s004_GetSaira_581ae97d:

    # mc "Vamos a quedarnos sentados aquí un momento, Scarlett. Hay un tema que quiero hablar contigo."
    mc "Lass uns einen Moment hier sitzen, Scarlett. Ich möchte mit dir über etwas sprechen."

# game/scripts/c13/c13.rpy:1328
translate german c13s004_GetSaira_5cc848a0:

    # sca "De golpe estás sonando muy serio, [mc]. ¿Pasa algo?"
    sca "Du klingst plötzlich sehr ernst, [mc]. Ist etwas nicht in Ordnung?"

# game/scripts/c13/c13.rpy:1329
translate german c13s004_GetSaira_c84d738d:

    # mc "Bueno, hay algo que quiero comentarte."
    mc "Also, ich möchte dir etwas sagen."

# game/scripts/c13/c13.rpy:1331
translate german c13s004_GetSaira_1729258b:

    # sca "Me estás preocupando. ¿He hecho algo malo?"
    sca "Du machst mir Sorgen. Habe ich etwas falsch gemacht?"

# game/scripts/c13/c13.rpy:1332
translate german c13s004_GetSaira_354b54b1:

    # mc "¿Tú? ¡No! Quiero hacerte unas preguntas sobre el tema de tu padre."
    mc "Du? Nein! Ich möchte dir ein paar Fragen über deinen Vater stellen."

# game/scripts/c13/c13.rpy:1334
translate german c13s004_GetSaira_b56d3f60:

    # sca "Bueno, después de lo que me ha dicho mi madre esta mañana, dudo que nunca le saque la verdad sobre quién es."
    sca "Nach dem, was meine Mutter mir heute Morgen erzählt hat, bezweifle ich, dass ich jemals die Wahrheit über ihre Identität von ihr erfahren werde."

# game/scripts/c13/c13.rpy:1335
translate german c13s004_GetSaira_8dd63e25:

    # sca "¿Puedes creerte que ha estado en contacto con él todo este tiempo? ¿Recibiendo dinero de él? ¿Y ocultándomelo?"
    sca "Kannst du dir vorstellen, dass sie die ganze Zeit mit ihm in Kontakt stand? Geld von ihm bekommen hat? Und es vor mir verheimlicht hat?"

# game/scripts/c13/c13.rpy:1336
translate german c13s004_GetSaira_bd5ea149:

    # mc "Tu madre me ha parecido un poco... no quiero ser ofensivo ni molestarte, al fin y al cabo es tu madre."
    mc "Deine Mutter wirkte etwas... Ich möchte dich nicht beleidigen oder verärgern, schließlich ist sie deine Mutter."

# game/scripts/c13/c13.rpy:1338
translate german c13s004_GetSaira_a383464e:

    # sca "Puedes decir lo que quieras. No me voy a ofender aunque la llames despreciable. Ahora mismo es la palabra que me viene a la mente. Estoy muy enfadada con ella."
    sca "Du kannst sagen, was du willst. Ich bin nicht beleidigt, selbst wenn du sie als abscheulich bezeichnest. Das ist das Wort, das mir im Moment in den Sinn kommt. Ich bin sehr wütend auf sie."

# game/scripts/c13/c13.rpy:1339
translate german c13s004_GetSaira_5e488d70:

    # mc "Me ha parecido muy fuerte que dijera que le habías destrozado la vida, y que lo siguiente de lo que hablara fuera del dinero de tu padre..."
    mc "Ich fand es sehr verstörend, dass sie sagte, Sie hätten ihr Leben ruiniert, und dann als Nächstes über das Geld Ihres Vaters sprach..."

# game/scripts/c13/c13.rpy:1341
translate german c13s004_GetSaira_725ec96e:

    # sca "Aunque no tiene disculpa, casi la entiendo. Para ella el dinero es muy importante. Mis abuelos no quisieron ayudarla cuando se quedó embarazada de mí."
    sca "Obwohl sie keine Entschuldigung hat, kann ich sie fast verstehen. Geld ist ihr sehr wichtig. Meine Großeltern weigerten sich, ihr zu helfen, als sie mit mir schwanger wurde."

# game/scripts/c13/c13.rpy:1342
translate german c13s004_GetSaira_edc402e2:

    # sca "Pasó de estar a punto de ir a Yale con una beca a tener que irse de casa y buscarse la vida trabajando de camarera en un bar cutre, viviendo de las propinas..."
    sca "Sie stand kurz davor, mit einem Stipendium nach Yale zu gehen, und musste nun ihr Zuhause verlassen und ihren Lebensunterhalt als Kellnerin in einer heruntergekommenen Bar verdienen, wobei sie von Trinkgeldern lebte..."

# game/scripts/c13/c13.rpy:1343
translate german c13s004_GetSaira_9836f015:

    # sca "Mis abuelos cambiaron de opinión cuando nací, pero ella no quiso volver. La relación ya estaba muy dañada entre ellos. Solo veía a mis abuelos en los cumpleaños, Acción de Gracias, Navidad..."
    sca "Meine Großeltern änderten ihre Meinung, als ich geboren wurde, aber sie wollte nicht zurückkommen. Ihr Verhältnis war bereits schwer angespannt. Ich sah meine Großeltern nur noch an Geburtstagen, Thanksgiving und Weihnachten."

# game/scripts/c13/c13.rpy:1344
translate german c13s004_GetSaira_829877c6:

    # mc "Pero parece que no vivía solo de las propinas, sino también del dinero que tu padre le enviaba."
    mc "Aber anscheinend lebte er nicht nur von Trinkgeldern, sondern auch von dem Geld, das ihm Ihr Vater geschickt hat."

# game/scripts/c13/c13.rpy:1346
translate german c13s004_GetSaira_e0feaea1:

    # sca "Sí, eso parece. Una mentira más que sumar a la larga lista de mentiras que ha contado sobre él. Si al menos supiera quién es..."
    sca "Ja, so scheint es. Nur eine weitere Lüge in der langen Liste der Lügen, die sie über ihn erzählt hat. Wenn ich nur wüsste, wer er wirklich ist …"

# game/scripts/c13/c13.rpy:1347
translate german c13s004_GetSaira_b524c179:

    # mc "Me parece que ha dicho alguna mentira más sobre el tema, como que ha dejado de mandar dinero por que ya tenías 18."
    mc "Ich glaube, er hat in dieser Angelegenheit noch einige andere Lügen erzählt, zum Beispiel, dass er aufgehört habe, Geld zu schicken, weil du bereits 18 Jahre alt warst."

# game/scripts/c13/c13.rpy:1349
translate german c13s004_GetSaira_6be23cd0:

    # sca "¿Por qué dices eso?"
    sca "Warum sagst du das?"

# game/scripts/c13/c13.rpy:1350
translate german c13s004_GetSaira_8ab0fcb9:

    # mc "Si te dijera que es posible que tenga una pista, que podrías encontrar a tu otra familia... ¿querrías seguirla?"
    mc "Wenn ich Ihnen sagen würde, dass ich möglicherweise eine Spur habe, mit der Sie Ihre andere Familie finden könnten... würden Sie dieser Spur folgen wollen?"

# game/scripts/c13/c13.rpy:1352
translate german c13s004_GetSaira_8060518a:

    # sca "{b}¿Qué?{/b} ¡Por supuesto que querría!"
    sca "{b}Was?{/b} Natürlich würde ich das!"

# game/scripts/c13/c13.rpy:1353
translate german c13s004_GetSaira_07bd5463:

    # sca "¿De dónde has sacado la información?"
    sca "Woher haben Sie die Information?"

# game/scripts/c13/c13.rpy:1354
translate german c13s004_GetSaira_b5ca3c26:

    # mc "Antes de responderte, déjame darte algunos datos. No es tan sencillo."
    mc "Bevor ich Ihre Frage beantworte, möchte ich Ihnen einige Informationen geben. Es ist nicht so einfach."

# game/scripts/c13/c13.rpy:1356
translate german c13s004_GetSaira_51d8a628:

    # sca "¿Que puede haber de complicado? Una prueba de ADN resolvería las dudas..."
    sca "Was könnte daran so kompliziert sein? Ein DNA-Test würde alle Zweifel ausräumen..."

# game/scripts/c13/c13.rpy:1357
translate german c13s004_GetSaira_bbde9e61:

    # mc "Lo complicado es que tu posible padre no está disponible para hacer una prueba de ADN. Pero déjame explicarte lo que sé."
    mc "Das Problem ist, dass Ihr potenzieller Vater für einen DNA-Test nicht zur Verfügung steht. Aber lassen Sie mich Ihnen erklären, was ich weiß."

# game/scripts/c13/c13.rpy:1359
translate german c13s004_GetSaira_d376aa84:

    # "Explicas a Scarlett la conversación de ayer con tu padre, sin decirle que es tu padre, y las pistas que dejó caer sobre la identidad de tu medio hermana."
    "Du erklärst Scarlett das gestrige Gespräch mit deinem Vater, ohne ihr zu sagen, dass er dein Vater ist, und die Hinweise, die er über die Identität deiner Halbschwester gegeben hat."

# game/scripts/c13/c13.rpy:1360
translate german c13s004_GetSaira_e1e23ff8:

    # mc "Y eso es todo lo que sé."
    mc "Und das ist alles, was ich weiß."

# game/scripts/c13/c13.rpy:1361
translate german c13s004_GetSaira_1b7cc215:

    # sca "Tengo que ser yo. 18 años, segunda de mi clase, empiezo medicina en la NWU, la matrícula está pagada, y ha enviado dinero a mi madre."
    sca "Das muss ich sein. Ich bin 18 Jahre alt, Zweitbeste meines Jahrgangs, beginne mein Medizinstudium an der NWU, die Studiengebühren sind bezahlt und ich habe meiner Mutter Geld geschickt."

# game/scripts/c13/c13.rpy:1362
translate german c13s004_GetSaira_7c813b7c:

    # mc "Ese último dato es el que me ha hecho atar cabos. Estaba bastante seguro de que podías ser tú, pero al decir tu madre lo del dinero casi ha confirmado mis sospechas."
    mc "Diese letzte Information hat mich schließlich zum Nachdenken gebracht. Ich war mir ziemlich sicher, dass du es sein könntest, aber als deine Mutter das Geld erwähnte, bestätigte das fast meinen Verdacht."

# game/scripts/c13/c13.rpy:1364
translate german c13s004_GetSaira_99b10dd5:

    # sca "Pero hay una cosa que no entiendo. ¿Por qué ese hombre, mi posible padre, te lo contó a ti?"
    sca "Aber eines verstehe ich nicht. Warum hat dieser Mann, mein möglicher Vater, Ihnen das erzählt?"

# game/scripts/c13/c13.rpy:1366
translate german c13s004_GetSaira_081cc96b:

    # sca "A menos que..."
    sca "Es sei denn..."

# game/scripts/c13/c13.rpy:1369
translate german c13s004_GetSaira_5a3e2bb4:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano... no ahora..."
    sca "Das kann doch nicht sein, oder? Du bist nicht mein Halbbruder... nicht jetzt..."

# game/scripts/c13/c13.rpy:1371
translate german c13s004_GetSaira_fa962ca9:

    # sca "No puede ser, ¿verdad? No eres mi medio hermano..."
    sca "Das kann doch nicht sein, oder? Du bist doch nicht mein Halbbruder..."

# game/scripts/c13/c13.rpy:1372
translate german c13s004_GetSaira_7caf724b:

    # mc "Podría ser. Engañó a mi madre y las fechas coinciden, pero deberíamos confirmarlo antes de..."
    mc "Das könnte sein. Er hat meine Mutter getäuscht, und die Daten passen, aber wir sollten es vorher noch einmal bestätigen."

# game/scripts/c13/c13.rpy:1374
translate german c13s004_GetSaira_d697b07d:

    # sca "¡Eres mi hermano!"
    sca "Du bist mein Bruder!"

# game/scripts/c13/c13.rpy:1375
translate german c13s004_GetSaira_83726347:

    # mc "Scarlett, no. No lo sabemos todavía. Podría ser una chica de Westport que estudie medicina en la NWU. Tenemos que confirmarlo antes..."
    mc "Scarlett, nein. Wir wissen es noch nicht. Es könnte ein Mädchen aus Westport sein, das an der NWU Medizin studiert. Das müssen wir erst bestätigen."

# game/scripts/c13/c13.rpy:1377
translate german c13s004_GetSaira_923be1b9:

    # sca "Tienes razón. Siempre pensé que quería encontrar a mi padre. Mi madre me dijo que estaba casado, pero ha mentido tanto que nunca pensé en si tendría hermanos."
    sca "Du hast recht. Ich wollte immer meinen Vater finden. Meine Mutter sagte, er sei verheiratet, aber sie hat so viel gelogen, dass ich nie darüber nachgedacht habe, ob ich Geschwister habe."

# game/scripts/c13/c13.rpy:1378
translate german c13s004_GetSaira_376156d1:

    # mc "O primas... si mis sospechas son ciertas puede que tengas una gran familia."
    mc "Oh, ihr Lieben... wenn meine Vermutung stimmt, habt ihr vielleicht eine große Familie."

# game/scripts/c13/c13.rpy:1381
translate german c13s004_GetSaira_fce75663:

    # sca "Y esto... ¿cómo nos deja a nosotros?"
    sca "Und wie steht es nun um uns?"

# game/scripts/c13/c13.rpy:1382
translate german c13s004_GetSaira_c8070494:

    # mc "Hasta que no tengamos confirmación, igual que estamos. No quiero actuar en base a suposiciones."
    mc "Bis wir eine Bestätigung haben, lassen wir alles beim Alten. Ich möchte nicht aufgrund von Annahmen handeln."

# game/scripts/c13/c13.rpy:1384
translate german c13s004_GetSaira_17ac4da4:

    # sca "Pero... ¿Y si somos...?"
    sca "Aber... was, wenn wir es sind...?"

# game/scripts/c13/c13.rpy:1385
translate german c13s004_GetSaira_0a02d0f5:

    # mc "¿Y si no somos...?"
    mc "Was, wenn wir es nicht sind...?"

# game/scripts/c13/c13.rpy:1386
translate german c13s004_GetSaira_98e2c246:

    # mc "Acabamos de empezar a salir. No pienso romper contigo porque tengamos sospechas de que eres mi hermana."
    mc "Wir sind doch erst seit Kurzem zusammen. Ich werde nicht mit dir Schluss machen, nur weil wir vermuten, dass du meine Schwester bist."

# game/scripts/c13/c13.rpy:1388
translate german c13s004_GetSaira_c2d875b1:

    # mc "Y aunque lo seas, tampoco pienso hacerlo."
    mc "Und selbst wenn du es wärst, hätte ich es trotzdem nicht vor."

# game/scripts/c13/c13.rpy:1390
translate german c13s004_GetSaira_435afb91:

    # mc "Y si lo eres, ya hablaremos de ello."
    mc "Und falls ja, sprechen wir später darüber."

# game/scripts/c13/c13.rpy:1393
translate german c13s004_GetSaira_bb4b8800:

    # sca "Suponía que esas cosas no te importaban... también sales con [dap]."
    sca "Ich nahm an, dass dir diese Dinge egal wären... du gehst ja auch mit [dap] aus."

# game/scripts/c13/c13.rpy:1394
translate german c13s004_GetSaira_fc6ab40b:

    # mc "Bueno, sobre eso es algo que deberemos hablar [dap] y yo. A ella parece no importarle y..."
    mc "Nun, darüber müssen [dap] und ich reden. Sie scheint nichts dagegen zu haben und..."

# game/scripts/c13/c13.rpy:1396
translate german c13s004_GetSaira_bd91776e:

    # sca "A mí tampoco me importaría..."
    sca "Mir wäre auch nichts auszumachen..."

# game/scripts/c13/c13.rpy:1399
translate german c13s004_GetSaira_d264df90:

    # sca "A mí no me importaría..."
    sca "Das würde mich nicht stören..."

# game/scripts/c13/c13.rpy:1400
translate german c13s004_GetSaira_cf7e0ea3:

    # mc "Entonces ya lo hablaremos si tenemos confirmación positiva. Y si es negativa, no habrá nada de lo que hablar. Primero habrá que confirmar si somos familia."
    mc "Dann besprechen wir es, falls wir eine positive Bestätigung erhalten. Und falls sie negativ ausfällt, gibt es nichts zu besprechen. Zuerst müssen wir aber klären, ob wir verwandt sind."

# game/scripts/c13/c13.rpy:1403
translate german c13s004_GetSaira_72180089:

    # sca "¿Te imaginas que [dap] y yo fueramos primas? Ya casi es como una hermana para mí y..."
    sca "Könnt ihr euch vorstellen, wenn [dap] und ich Cousinen wären? Sie ist mir mittlerweile fast wie eine Schwester und..."

# game/scripts/c13/c13.rpy:1405
translate german c13s004_GetSaira_8077d522:

    # sca "¡[emm] sería mi hermana también!"
    sca "Sie wäre auch meine Schwester!"

# game/scripts/c13/c13.rpy:1406
translate german c13s004_GetSaira_b39954e4:

    # mc "Supongo que debes estar en shock ahora mismo. *Risa* No es típico de ti tardar tanto en darte cuenta de algo."
    mc "Du stehst bestimmt gerade unter Schock. *lacht* Es ist gar nicht deine Art, so lange zu brauchen, um etwas zu begreifen."

# game/scripts/c13/c13.rpy:1408
translate german c13s004_GetSaira_46981cf6:

    # sca "Son muchas cosas que asimilar..."
    sca "Es gibt viel zu bedenken..."

# game/scripts/c13/c13.rpy:1409
translate german c13s004_GetSaira_a8a85577:

    # mc "Es normal, Scarlett. Ayer yo estaba igual que tú ahora mismo."
    mc "Das ist normal, Scarlett. Gestern war ich genau wie du jetzt."

# game/scripts/c13/c13.rpy:1410
translate german c13s004_GetSaira_ebdb400b:

    # mc "Escucha, creo que deberías tomarte un tiempo para pensar. El vuelo de Saira llega en un rato y deberíamos ir al aeropuerto."
    mc "Hör zu, ich glaube, du solltest dir etwas Zeit zum Nachdenken nehmen. Sairas Flug landet in Kürze, und wir sollten zum Flughafen fahren."

# game/scripts/c13/c13.rpy:1412
translate german c13s004_GetSaira_6ac64992:

    # sca "Entonces vamos a por ella. Creo que tenemos que hablar de esto sin interrupciones cuando haya tenido tiempo de asimilarlo y..."
    sca "Dann lasst uns loslegen. Ich denke, wir sollten darüber ungestört sprechen, sobald ich Zeit hatte, das Ganze zu verarbeiten und..."

# game/scripts/c13/c13.rpy:1413
translate german c13s004_GetSaira_dee69572:

    # mc "Solo una cosa más, Scarlett. De momento no se lo digas a nadie. Nadie sabe que he estado hablando con mi padre ni lo que me ha dicho. Me gustaría explicarlo cuando sea el momento."
    mc "Nur noch eine Sache, Scarlett. Erzähl es vorerst niemandem. Niemand weiß, dass ich mit meinem Vater gesprochen habe oder was er gesagt hat. Ich möchte es erklären, wenn der richtige Zeitpunkt gekommen ist."

# game/scripts/c13/c13.rpy:1414
translate german c13s004_GetSaira_b581a03d:

    # sca "Lo entiendo, aunque me moriré de ganas de decírselo a [dap]."
    sca "Ich verstehe, obwohl ich [dap] am liebsten sofort Bescheid sagen würde."

# game/scripts/c13/c13.rpy:1417
translate german c13s004_GetSaira_63cd8ebd:

    # mc "Vamos."
    mc "Aufleuchten."

# game/scripts/c13/c13.rpy:1419
translate german c13s004_GetSaira_f645e946:

    # "Llegáis al aeropuerto justo a tiempo después de pillar un pequeño atasco. Los carteles indican que el vuelo de Saira ha aterrizado hace unos minutos."
    "Sie erreichen den Flughafen gerade noch rechtzeitig, nachdem Sie in einen kurzen Stau geraten sind. Die Schilder zeigen an, dass Sairas Flug vor wenigen Minuten gelandet ist."

# game/scripts/c13/c13.rpy:1426
translate german c13s004_GetSaira_dc468c0e:

    # "Unos minutos después aparece Saira y te levantas a recibirla."
    "Ein paar Minuten später erscheint Saira und du stehst auf, um sie zu begrüßen."

# game/scripts/c13/c13.rpy:1427
translate german c13s004_GetSaira_70587128:

    # sai "¡Sorpresa! *Risa*"
    sai "Überraschung! *Gelächter*"

# game/scripts/c13/c13.rpy:1428
translate german c13s004_GetSaira_1b2b8d9e:

    # mc "*Risa* Casi... la estropeaste al no colgar la video conferencia."
    mc "*lacht* Du hättest es beinahe... ruiniert, indem du die Videokonferenz nicht beendet hast."

# game/scripts/c13/c13.rpy:1430
translate german c13s004_GetSaira_7e60ab7b:

    # sai "Maldición... ¿cuanto oíste?"
    sai "Verdammt... wie viel hast du gehört?"

# game/scripts/c13/c13.rpy:1431
translate german c13s004_GetSaira_7d42c0a8:

    # mc "Todo hasta que colgaste."
    mc "Alles bis zum Auflegen."

# game/scripts/c13/c13.rpy:1433
translate german c13s004_GetSaira_6226e373:

    # sai "No pienses mal, no pienso todo lo que dije..."
    sai "Versteh mich nicht falsch, ich meine nicht alles, was ich gesagt habe..."

# game/scripts/c13/c13.rpy:1434
translate german c13s004_GetSaira_4319860b:

    # mc "No te preocupes, sé que puedes ser más ladradora que mordedora."
    mc "Keine Sorge, ich weiß, dass du mehr bellst als beißt."

# game/scripts/c13/c13.rpy:1436
translate german c13s004_GetSaira_6e42d010:

    # sai "¿No me vas a dar un beso de bienvenida?"
    sai "Wirst du mir keinen Begrüßungskuss geben?"

# game/scripts/c13/c13.rpy:1450
translate german qKissSairaArrival_06face9f:

    # "Vuestros labios se juntan en un beso que tiene mucha inseguridad detrás. Ninguno de los dos sabe cómo va a reaccionar el otro."
    "Eure Lippen treffen sich zu einem Kuss, der voller Ungewissheit ist. Keiner von euch weiß, wie der andere reagieren wird."

# game/scripts/c13/c13.rpy:1452
translate german qKissSairaArrival_16332bdc:

    # "El beso dura un segundo, es tiempo más que suficiente para borrar el mes y medio que habéis estado separados y dejaros donde estábais... casi."
    "Der Kuss dauert nur eine Sekunde, das ist mehr als genug Zeit, um die anderthalb Monate, die ihr getrennt wart, auszulöschen und euch wieder dort zurückzulassen, wo ihr wart... fast."

# game/scripts/c13/c13.rpy:1454
translate german qKissSairaArrival_b4b72dc3:

    # "El beso dura un segundo, es tiempo más que suficiente para borrar el mes y medio que habéis estado separados y dejaros donde estábais."
    "Der Kuss dauert nur eine Sekunde, das ist mehr als genug Zeit, um die anderthalb Monate, die ihr getrennt wart, auszulöschen und euch wieder dort zurückzulassen, wo ihr wart."

# game/scripts/c13/c13.rpy:1457
translate german qKissSairaArrival_14f7cf78:

    # sca "¡Ejem!"
    sca "Hm!"

# game/scripts/c13/c13.rpy:1460
translate german qKissSairaArrival_c7def988:

    # "No es el beso que Saira espera y su cuerpo se tensa por un momento. Tienes que hablar con ella antes de pensar en retomar lo vuestro."
    "Es ist nicht der Kuss, den Saira erwartet hat, und ihr Körper spannt sich einen Moment lang an. Du musst mit ihr reden, bevor du überhaupt daran denkst, wieder mit ihr zusammenzukommen."

# game/scripts/c13/c13.rpy:1462
translate german qKissSairaArrival_58642bce:

    # "Vuestra relación abierta sería mucho más abierta ahora. Tiene que saberlo antes de que piense que vuelves a ser suyo en exclusiva."
    "Eure offene Beziehung wäre jetzt viel offener. Er muss das wissen, bevor er wieder denkt, dass du exklusiv ihm gehörst."

# game/scripts/c13/c13.rpy:1465
translate german qKissSairaArrival_14f7cf78_1:

    # sca "¡Ejem!"
    sca "Hm!"

# game/scripts/c13/c13.rpy:1466
translate german qKissSairaArrival_9e1cfa9a:

    # mc "Ven, Saira, voy a presentarte a..."
    mc "Komm, Saira, ich werde dich vorstellen..."

# game/scripts/c13/c13.rpy:1468
translate german qKissSairaArrival_af2a5db8:

    # sai "¿Esa es Eileen? Creía que era pelirroja..."
    sai "Ist das Eileen? Ich dachte, sie wäre rothaarig..."

# game/scripts/c13/c13.rpy:1469
translate german qKissSairaArrival_044428f8:

    # mc "No, no es Eileen. A Eileen la conocerás hoy. Está viviendo en casa."
    mc "Nein, es ist nicht Eileen. Du wirst Eileen heute kennenlernen. Sie wohnt noch zu Hause."

# game/scripts/c13/c13.rpy:1471
translate german qKissSairaArrival_7ec8ff1d:

    # sai "{b}¿QUÉ?{/b}"
    sai "{b}WAS?{/b}"

# game/scripts/c13/c13.rpy:1472
translate german qKissSairaArrival_5f7bfb38:

    # mc "Es largo de contar, ven."
    mc "Das ist eine lange Geschichte, komm schon."

# game/scripts/c13/c13.rpy:1479
translate german qKissSairaArrival_316bd3d0:

    # mc "Saira, esta es Scarlett, una de las chicas con las que salgo."
    mc "Saira, das ist Scarlett, eine der Frauen, mit denen ich ausgehe."

# game/scripts/c13/c13.rpy:1481
translate german qKissSairaArrival_199e2902:

    # mc "Saira, esta es Scarlett. Mi otra novia, aparte de ti, si es que quieres volver conmigo, claro."
    mc "Saira, das ist Scarlett. Meine andere Freundin, neben dir, falls du natürlich wieder mit mir zusammenkommen willst."

# game/scripts/c13/c13.rpy:1483
translate german qKissSairaArrival_a7ade38d:

    # mc "Saira, esta es Scarlett. Mi novia."
    mc "Saira, das ist Scarlett. Meine Freundin."

# game/scripts/c13/c13.rpy:1484
translate german qKissSairaArrival_54656e74:

    # mc "Hoy se muda a casa también."
    mc "Heute zieht sie auch wieder nach Hause."

# game/scripts/c13/c13.rpy:1485
translate german qKissSairaArrival_5052557b:

    # sca "Encantada, Saira."
    sca "Schön, dich kennenzulernen, Saira."

# game/scripts/c13/c13.rpy:1487
translate german qKissSairaArrival_53597df5:

    # sai "¿Qué? ¿Estás saliendo con... con... ella?"
    sai "Was? Bist du mit ihr zusammen?"

# game/scripts/c13/c13.rpy:1488
translate german qKissSairaArrival_379a2e0c:

    # sai "¿Y Eileen?"
    sai "Und Eileen?"

# game/scripts/c13/c13.rpy:1490
translate german qKissSairaArrival_03867090:

    # mc "Sí, con Eileen también."
    mc "Ja, auch bei Eileen."

# game/scripts/c13/c13.rpy:1492
translate german qKissSairaArrival_2879c609:

    # sca "¿Qué? ¿Sales con Eileen?" (multiple=2)
    sca "Was? Bist du mit Eileen zusammen?" (multiple=2)

# game/scripts/c13/c13.rpy:1493
translate german qKissSairaArrival_cf5bc89f:

    # sai "¿Qué? ¿Ya has vuelto con ella?" (multiple=2)
    sai "Was? Du bist schon wieder mit ihr zusammen?" (multiple=2)

# game/scripts/c13/c13.rpy:1494
translate german qKissSairaArrival_401e46a3:

    # mc "Sí. No te sorprendas tanto, Scarlett. Tengo su autorización para hacerlo público."
    mc "Ja. Sei nicht so überrascht, Scarlett. Ich habe ihre Erlaubnis, es zu veröffentlichen."

# game/scripts/c13/c13.rpy:1495
translate german qKissSairaArrival_201ed9a3:

    # mc "Saira, tú y yo teníamos una relación abierta que no lo era en la práctica. Ahora tengo una que lo es."
    mc "Saira, wir hatten eine offene Beziehung, die in der Praxis aber nicht wirklich offen war. Jetzt habe ich eine, die es ist."

# game/scripts/c13/c13.rpy:1497
translate german qKissSairaArrival_5eb913b8:

    # sai "Pero... pero... yo me he transferido por ti..."
    sai "Aber... aber... ich habe wegen dir gewechselt..."

# game/scripts/c13/c13.rpy:1498
translate german qKissSairaArrival_bf5788bd:

    # mc "No creo que sea el mejor momento para hablarlo, Saira. Creo que te lo tengo que explicar en privado."
    mc "Ich glaube nicht, dass jetzt der beste Zeitpunkt ist, darüber zu sprechen, Saira. Ich denke, ich muss es dir unter vier Augen erklären."

# game/scripts/c13/c13.rpy:1499
translate german qKissSairaArrival_f80cfb49:

    # mc "No te ofendas, Scarlett."
    mc "Sei nicht beleidigt, Scarlett."

# game/scripts/c13/c13.rpy:1501
translate german qKissSairaArrival_694f0dbc:

    # sca "No, no me ofendo. Ahora mismo estoy demasiado flipada..."
    sca "Nein, ich bin nicht beleidigt. Ich bin einfach nur viel zu aufgeregt im Moment..."

# game/scripts/c13/c13.rpy:1503
translate german qKissSairaArrival_f470a308:

    # mc "No, Eileen y yo solo somos buenos amigos."
    mc "Nein, Eileen und ich sind nur gute Freundinnen."

# game/scripts/c13/c13.rpy:1505
translate german qKissSairaArrival_cb2c5f5f:

    # mc "Saira, esta es Scarlett, una amiga. También va a vivir en casa."
    mc "Saira, das ist Scarlett, eine Freundin. Sie wird auch bei uns wohnen."

# game/scripts/c13/c13.rpy:1506
translate german qKissSairaArrival_a1f01b1d:

    # sca "Un placer conocerte, Saira."
    sca "Es freut mich, Sie kennenzulernen, Saira."

# game/scripts/c13/c13.rpy:1508
translate german qKissSairaArrival_c1265b7a:

    # sai "Igualmente, Scarlett. Por un momento he pensado que eras Eileen."
    sai "Ebenso, Scarlett. Einen Moment lang dachte ich, du wärst Eileen."

# game/scripts/c13/c13.rpy:1509
translate german qKissSairaArrival_f69671ca:

    # sai "Por suerte, [mc] tiene el suficiente tacto como para no venir con su {b}ex{/b}-novia del instituto a buscar a su novia de la universidad."
    sai "Zum Glück ist [mc] taktvoll genug, nicht mit seiner {b}Ex-{/b}-Freundin aus der Highschool zu kommen, um nach seiner College-Freundin zu suchen."

# game/scripts/c13/c13.rpy:1511
translate german qKissSairaArrival_73039573:

    # mc "Bueno, Eileen ya no es una ex-novia."
    mc "Nun ja, Eileen ist keine Ex-Freundin mehr."

