

# game/scripts/c13/startS3.rpy:5
translate german startS3_8b60ce73:

    # "Jamaal" "Veo que quieres empezar una partida nueva. Pero esto es la Temporada 4 de My Dorm." id startS3_8b60ce73
    "Jamaal" "Ich sehe, du willst ein neues Spiel starten. Aber das hier ist My Dorm Staffel 4." id startS3_8b60ce73

# game/scripts/c13/startS3.rpy:7
translate german startS3_7f917222:

    # "Jamaal" "Hay un cuestionario que vas a tener que rellenar, pero no es la mejor opción."
    "Jamaal" "Es gibt einen Fragebogen, den Sie ausfüllen müssen, aber das ist nicht die beste Option."

# game/scripts/c13/startS3.rpy:8
translate german startS3_fd712d46:

    # "Jamaal" "Tropecita y yo creemos que no vas a disfrutar el juego si no has jugado las temporadas previas, ya que no vas a conocer a los personajes."
    "Jamaal" "Tropecita und ich glauben, dass man das Spiel nicht genießen wird, wenn man die vorherigen Staffeln nicht gespielt hat, da man die Charaktere dann nicht kennt."

# game/scripts/c13/startS3.rpy:10
translate german startS3_2738f278:

    # "Jamaal" "Si quieres jugar la Temporada 4, lo ideal es haber jugado previamente, como mínimo, la Temporada 3 hasta el final." id startS3_2738f278
    "Jamaal" "Wenn Sie Staffel 4 spielen möchten, sollten Sie idealerweise zuvor mindestens Staffel 3 bis zum Ende gespielt haben." id startS3_2738f278

# game/scripts/c13/startS3.rpy:11
translate german startS3_017758e4:

    # "Jamaal" "Aunque yo recomiendo que empieces desde el principio. Verás mi bonita cara mucho en las temporadas previas."
    "Jamaal" "Ich empfehle Ihnen jedoch, von Anfang an zu schauen. Sie werden mein hübsches Gesicht in den früheren Staffeln häufig sehen."

# game/scripts/c13/startS3.rpy:13
translate german startS3_534d9fa7:

    # "Jamaal" "Puedes bajar las Temporadas 1 y 2 en los sitios habituales (Patreon, Subscribestar, y Discord)."
    "Jamaal" "Die Staffeln 1 und 2 können auf den üblichen Plattformen (Patreon, Subscribestar und Discord) heruntergeladen werden."

# game/scripts/c13/startS3.rpy:14
translate german startS3_fbcd1a72:

    # "Jamaal" "Encontrarás los enlaces en el menú principal, en la parte inferior izquierda."
    "Jamaal" "Die Links finden Sie im Hauptmenü unten links."

# game/scripts/c13/startS3.rpy:16
translate german startS3_e2947f50:

    # "Jamaal" "¡Nos vemos en alguna de las temporadas anteriores! O en esta si no sigues mi consejo."
    "Jamaal" "Wir sehen uns in einer der vorherigen Staffeln! Oder in dieser, falls du meinen Rat nicht befolgst."

# game/scripts/c13/startS3.rpy:18
translate german startS3_5120be79:

    # "Jamaal" "¡Oh! Y no te preocupes. No soy el personaje principal de este juego. No es tan guapo como yo, pero no es mal tipo."
    "Jamaal" "Oh! Und keine Sorge. Ich bin nicht die Hauptfigur in diesem Spiel. Er ist zwar nicht so gutaussehend wie ich, aber er ist kein schlechter Kerl."

