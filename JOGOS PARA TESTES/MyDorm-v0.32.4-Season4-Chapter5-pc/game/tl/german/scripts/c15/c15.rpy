translate german c15s005_BeforeAaronVisit_deb9c693:

    # mom "¿Qué? ¿Desde cuándo?" (multiple=2)
    mom "Was? Seit wann?" (multiple=2)

# game/scripts/c15/c15.rpy:2345
translate german c15s005_BeforeAaronVisit_b37a6db8:

    # mom "No, Tía Betty. [mc] y yo estamos juntos."
    mom "Nein, Tante Betty. [mc] und ich sind zusammen."

# game/scripts/c15/c15.rpy:2347
translate german c15s005_BeforeAaronVisit_c66ac25d:

    # mom "Ya está, ya lo he dicho... se acabó el secreto..."
    mom "So, jetzt hab ich's gesagt... das Geheimnis ist gelüftet..."

# game/scripts/c15/c15.rpy:2349
translate german c15s005_BeforeAaronVisit_68d9c1c2_1:

    # bet "¡Lo sabía!" (multiple=2)
    bet "Ich wusste es!" (multiple=2)

# game/scripts/c15/c15.rpy:2350
translate german c15s005_BeforeAaronVisit_c885dba8:

    # nor "¿Qué? ¿Desde cuándo?" (multiple=2)
    nor "Was? Seit wann?" (multiple=2)

# game/scripts/c15/c15.rpy:2351
translate german c15s005_BeforeAaronVisit_ac0f8328:

    # mee "¿Estáis locos?"
    mee "Bist du verrückt?"

# game/scripts/c15/c15.rpy:2355
translate german c15s005_BeforeAaronVisit_7c5885e4:

    # mee "¡Es tu sobrino, por el amor de Dios!"
    mee "Er ist dein Neffe, um Himmels willen!"

# game/scripts/c15/c15.rpy:2357
translate german c15s005_BeforeAaronVisit_4ddadc7a:

    # mee "¡Es prácticamente tu sobrino, por el amor de Dios!"
    mee "Er ist ja praktisch dein Neffe, um Himmels willen!"

# game/scripts/c15/c15.rpy:2360
translate german c15s005_BeforeAaronVisit_2ad1ae22:

    # mee "¡Es tu hijo, por el amor de Dios!"
    mee "Er ist doch dein Sohn, um Himmels willen!"

# game/scripts/c15/c15.rpy:2362
translate german c15s005_BeforeAaronVisit_7a0202ce:

    # mee "¡Lo has criado como a tu propio hijo, por el amor de Dios!"
    mee "Du hast ihn wie deinen eigenen Sohn erzogen, um Himmels willen!"

# game/scripts/c15/c15.rpy:2363
translate german c15s005_BeforeAaronVisit_4f1c9c44:

    # mee "¡Y le doblas la edad!"
    mee "Und du bist doppelt so alt wie er!"

# game/scripts/c15/c15.rpy:2368
translate german c15s005_BeforeAaronVisit_3147f855:

    # mom "También es mi hijo, Mamá, y también le doblo la edad... casi..."
    mom "Er ist auch mein Sohn, Mama, und ich bin fast doppelt so alt wie er..."

# game/scripts/c15/c15.rpy:2370
translate german c15s005_BeforeAaronVisit_929de12f:

    # mom "También es prácticamente mi hijo, Olivia, y también le doblo la edad... casi..."
    mom "Olivia ist praktisch auch mein Sohn, und ich bin fast doppelt so alt wie er..."

# game/scripts/c15/c15.rpy:2372
translate german c15s005_BeforeAaronVisit_55bad67e:

    # mee "¿Qué?"
    mee "Das?"

# game/scripts/c15/c15.rpy:2374
translate german c15s005_BeforeAaronVisit_0012104a:

    # mom "¿Preparado?"
    mom "Vorbereitet?"

# game/scripts/c15/c15.rpy:2375
translate german c15s005_BeforeAaronVisit_be6d1522:

    # mc "Nunca lo he estado más."
    mc "Das war ich noch nie so sehr."

# game/scripts/c15/c15.rpy:2377
