# game/scripts/c15/c15.rpy:2137
translate german c15s005_LisaDate_582183b8:

    # lis "Sí, claro... \"Chicas, esperad un momento porque tengo que hablar con Debbie sobre si le doy su primer beso o no\". ¿Te das cuenta de que con eso la avergonzarías aún más?"
    lis "Ja, genau… „Mädels, wartet mal kurz, ich muss mit Debbie darüber reden, ob ich ihr ihren ersten Kuss geben soll oder nicht.“ Ist euch klar, dass sie sich dadurch nur noch mehr blamieren würde?"

# game/scripts/c15/c15.rpy:2138
translate german c15s005_LisaDate_a1e0b617:

    # mc "Por supuesto. Pero al no tener la información... cuando la tuve... no sé... me pareció lo mejor continuar."
    mc "Natürlich. Aber da ich die Informationen nicht hatte... als ich sie dann endlich bekam... ich weiß nicht... schien es am besten, weiterzumachen."

# game/scripts/c15/c15.rpy:2140
translate german c15s005_LisaDate_c84fb19a:

    # lis "¡Obviamente! Una vez estabas en esa situación solo podías continuar..."
    lis "Natürlich! Sobald man sich in dieser Situation befand, konnte man nur noch so weitermachen..."

# game/scripts/c15/c15.rpy:2142
translate german c15s005_LisaDate_406dd1be:

    # lis "Pero ve con cuidado con ella, por favor. Es muy sensible..."
    lis "Aber bitte seien Sie vorsichtig mit ihr. Sie ist sehr sensibel..."

# game/scripts/c15/c15.rpy:2143
translate german c15s005_LisaDate_598c9b21:

    # mc "Hablaré con ella si es lo que quieres, o si crees que es lo mejor."
    mc "Ich werde mit ihr sprechen, wenn du das möchtest oder wenn du denkst, dass es das Beste ist."

# game/scripts/c15/c15.rpy:2145
translate german c15s005_LisaDate_96ce9c1a:

    # lis "Todo depende de lo que vayas a decirle..."
    lis "Es kommt ganz darauf an, was du ihm sagen wirst..."

# game/scripts/c15/c15.rpy:2146
translate german c15s005_LisaDate_d13ab617:

    # mc "No sé lo que voy a decirle, pero con lo que me acabas de decir, creo que sería bueno que habláramos."
    mc "Ich weiß nicht, was ich ihr sagen soll, aber nach dem, was du mir gerade erzählt hast, denke ich, es wäre gut, wenn wir miteinander reden würden."

# game/scripts/c15/c15.rpy:2147
translate german c15s005_LisaDate_f407db1f:

    # lis "Yo también lo creo."
    lis "Das glaube ich auch."

# game/scripts/c15/c15.rpy:2148
translate german c15s005_LisaDate_a8b5f0d9:

    # "Justo en ese momento se oye el motor de un coche en la lejanía."
    "In diesem Moment ist in der Ferne das Geräusch eines Automotors zu hören."

# game/scripts/c15/c15.rpy:2150
translate german c15s005_LisaDate_d1a12a8a:

    # lis "Ahí llega Anthony con su contaminante coche."
    lis "Da kommt Anthony in seinem umweltschädlichen Auto."

# game/scripts/c15/c15.rpy:2151
translate german c15s005_LisaDate_64bb5442:

    # mc "Pasáoslo bien en el cine. ¿Cenarás en casa o cenarás con él?"
    mc "Viel Spaß im Kino! Wirst du zu Hause oder mit ihm zu Abend essen?"

# game/scripts/c15/c15.rpy:2153
translate german c15s005_LisaDate_52a8b269:

    # lis "*Risa* ¿Celoso?"
    lis "*lacht* Eifersüchtig?"

# game/scripts/c15/c15.rpy:2154
translate german c15s005_LisaDate_1f19368c:

    # mc "Nope. *Risa* Es para decirle a mi madre para cuantas personas tiene que preparar cena."
    mc "Nein. *lacht* Ich sage meiner Mutter damit, für wie viele Personen sie das Abendessen kochen muss."

# game/scripts/c15/c15.rpy:2156
translate german c15s005_LisaDate_1c566556:

    # lis "¡Oops! *Risa* Eso me pasa por intentar hacerme la graciosa. Cenaré en casa seguramente. Si al final decidimos quedarnos a cenar fuera, ya avisaré a [mar]."
    lis "Ups! *lacht* Das kommt davon, wenn man versucht, witzig zu sein. Ich werde wahrscheinlich zu Hause zu Abend essen. Falls wir doch auswärts essen gehen, sage ich [mar] Bescheid."

# game/scripts/c15/c15.rpy:2157
translate german c15s005_LisaDate_50651db3:

    # mc "Perfecto entonces. Nos vemos, Lisa."
    mc "Perfekt. Bis dann, Lisa."

# game/scripts/c15/c15.rpy:2158
translate german c15s005_LisaDate_0ff9f10b:

    # lis "Hasta luego, [mc]."
    lis "Bis später, [mc]."

# game/scripts/c15/c15.rpy:2160
translate german c15s005_LisaDate_5ecbacce:

    # "Anthony recoge a Lisa y tú te diriges a casa de [nor] para hablar con ella y [mar] sobre la reunión con Aaron."
    "Anthony holt Lisa ab und ihr geht zu [nor]s Haus, um mit ihr und [mar] über das Treffen mit Aaron zu sprechen."

# game/scripts/c15/c15.rpy:2163
translate german c15s005_LisaDate_43d6c65c:

    # "Tendrás que hablar con Debbie, y no es una conversación que estés ansioso por tener. No tienes ni idea de hacia dónde puede evolucionar esa conversación."
    "Du musst mit Debbie reden, und es ist kein Gespräch, auf das du dich freust. Du hast keine Ahnung, wohin dieses Gespräch führen könnte."

# game/scripts/c15/c15.rpy:2165
translate german c15s005_LisaDate_4a6218b6:

    # "Especialmente después de que te pillara con [dap] esta mañana."
    "Vor allem nachdem ich dich heute Morgen mit [dap] erwischt habe."

# game/scripts/c15/c15.rpy:2169
translate german c15s005_Anthony_2eab13d5:

    # lis "Y antes de que preguntes, eso no significa que a Anthony le dejase hacerlo, claro... cada vez estoy más segura de que... solo vamos a ser amigos..."
    lis "Und bevor ihr fragt: Das heißt natürlich nicht, dass ich es Anthony erlauben würde... Ich bin mir immer sicherer, dass... wir einfach nur Freunde bleiben werden..."

# game/scripts/c15/c15.rpy:2170
translate german c15s005_Anthony_6841bb13:

    # lis "No siento lo mismo por él que por... no siento por Anthony lo que debería sentir para empezar una relación con él."
    lis "Ich empfinde für ihn nicht dasselbe wie für... Ich empfinde für Anthony nicht das, was ich empfinden sollte, um eine Beziehung mit ihm einzugehen."

# game/scripts/c15/c15.rpy:2171
translate german c15s005_Anthony_5df0d087:

    # mc "Parece buen chico... quizás aclararlo sea lo mejor, si no te sientes atraída por él."
    mc "Er scheint ein netter Kerl zu sein... vielleicht ist es am besten, das klarzustellen, falls du dich nicht zu ihm hingezogen fühlst."

# game/scripts/c15/c15.rpy:2173
translate german c15s005_Anthony_38058c35:

    # mcp "(Y si el del restaurante era él, parece que es mutuo.)"
    mcp "(Und falls er derjenige im Restaurant war, scheint das Gefühl auf Gegenseitigkeit zu beruhen.)"

# game/scripts/c15/c15.rpy:2175
translate german c15s005_Anthony_1ad89788:

    # lis "No piensas que haya coqueteado con él o que le haya dado falsas esperanzas, ¿verdad?"
    lis "Du glaubst doch nicht, dass sie mit ihm geflirtet oder ihm falsche Hoffnungen gemacht hat, oder?"

# game/scripts/c15/c15.rpy:2176
translate german c15s005_Anthony_7e3c74e1:

    # mc "No, Lisa. Os conocisteis por internet. Te mudaste aquí y cuando os habéis conocido la chispa no ha saltado. Nadie te puede acusar de nada."
    mc "Nein, Lisa. Ihr habt euch online kennengelernt. Du bist hierhergezogen, und als ihr euch persönlich getroffen habt, hat es einfach nicht gefunkt. Niemand kann dir etwas vorwerfen."

# game/scripts/c15/c15.rpy:2237
translate german c15s005_BeforeAaronVisit_b7ccf855:

    # "En la cocina de [nor]..."
    "In der Küche von [nor]..."

# game/scripts/c15/c15.rpy:2244
translate german c15s005_BeforeAaronVisit_8b7ed0db:

    # mc "Hola, Tía [nor]. ¡Qué elegante!"
    mc "Hallo, Tante [nor]. Wie elegant!"

# game/scripts/c15/c15.rpy:2249
translate german c15s005_BeforeAaronVisit_1dfd5f92:

    # nor "El tal Aaron va a llegar en un rato. No quieres que me pasee en ropa interior delante de él, ¿verdad?"
    nor "Aaron wird jeden Moment da sein. Du willst doch nicht, dass ich in Unterwäsche vor ihm herumlaufe, oder?"

# game/scripts/c15/c15.rpy:2250
translate german c15s005_BeforeAaronVisit_ad581e68:

    # mc "Por mí no habría ningún problema, pero supongo que el pobre chico no podría concentrarse. *Risa*"
    mc "Ich hätte damit kein Problem, aber ich nehme an, der arme Kerl könnte sich dann nicht konzentrieren. *lacht*"

# game/scripts/c15/c15.rpy:2254
translate german c15s005_BeforeAaronVisit_4a3ff56a:

    # mc "Hola, Mamá. ¡Qué elegante!"
    mc "Hallo Mama. Wie elegant!"

# game/scripts/c15/c15.rpy:2256
translate german c15s005_BeforeAaronVisit_3c2d5805:

    # mc "Hola, [mar!t]. ¡Qué elegante!"
    mc "Hallo, [mar!t]. Wie elegant!"

# game/scripts/c15/c15.rpy:2257
translate german c15s005_BeforeAaronVisit_6d330332:

    # mom "El tal Aaron va a llegar en un rato. Hay que ser mínimamente profesional, ¿verdad? No sabemos de lo que quiere hablarnos."
    mom "Aaron wird in Kürze eintreffen. Wir sollten uns zumindest einigermaßen professionell verhalten, oder? Wir wissen ja nicht, worüber er mit uns sprechen möchte."

# game/scripts/c15/c15.rpy:2258
translate german c15s005_BeforeAaronVisit_55b0b7b2:

    # mc "Espero que Tía [nor] también se vista profesional, o el pobre chico no va a poder concentrarse si ella baja en ropa interior."
    mc "Ich hoffe, Tante [nor] kleidet sich auch professionell, sonst kann sich der arme Kerl nicht konzentrieren, wenn sie in Unterwäsche herunterkommt."

# game/scripts/c15/c15.rpy:2261
translate german c15s005_BeforeAaronVisit_043bc5d4:

    # nor "¿Chico? ¿Qué edad tiene?"
    nor "Junge? Wie alt ist er?"

# game/scripts/c15/c15.rpy:2264
translate german c15s005_BeforeAaronVisit_7f4f78a8:

    # mom "¿Chico? ¿Qué edad tiene?"
    mom "Junge? Wie alt ist er?"

# game/scripts/c15/c15.rpy:2265
translate german c15s005_BeforeAaronVisit_c0412ab0:

    # mc "Si lo que he deducido de la información que me envió Jamaal es cierto, debe ser algo más joven que yo."
    mc "Wenn das, was ich aus den mir von Jamaal zugesandten Informationen abgeleitet habe, stimmt, muss er etwas jünger sein als ich."

# game/scripts/c15/c15.rpy:2268
translate german c15s005_BeforeAaronVisit_c719db55:

    # nor "No encaja. Erik le llamó \"el viejo\" cuando habló de que habían intentado matarlo..."
    nor "Das passt nicht. Erik nannte ihn „den alten Mann“, als er darüber sprach, wie sie versucht hatten, ihn zu töten..."

# game/scripts/c15/c15.rpy:2271
translate german c15s005_BeforeAaronVisit_ca05a31d:

    # mom "Por lo que había dicho [nor], creía que sería más mayor."
    mom "Nach dem, was [nor] gesagt hatte, dachte ich, er wäre älter."

# game/scripts/c15/c15.rpy:2272
translate german c15s005_BeforeAaronVisit_86c3ea17:

    # mc "También podría ser que la información de Jamaal, o lo que yo saqué de ella, no sea del todo correcta."
    mc "Es könnte auch sein, dass Jamaals Informationen, oder das, was ich daraus abgeleitet habe, nicht ganz korrekt sind."

# game/scripts/c15/c15.rpy:2274
translate german c15s005_BeforeAaronVisit_79eead61:

    # mc "Pero lo descubriremos en breve. Ahora quiero un beso..."
    mc "Aber wir werden es bald erfahren. Jetzt will ich einen Kuss..."

# game/scripts/c15/c15.rpy:2277
translate german c15s005_BeforeAaronVisit_3ac5e0e7:

    # nor "¿Aquí? ¿Ahora? ¡La casa está llena de gente! ¿Tú quieres que le dé un infarto a mi madre?"
    nor "Hier? Jetzt? Das Haus ist voller Leute! Wollen Sie meiner Mutter einen Herzinfarkt verpassen?"

# game/scripts/c15/c15.rpy:2280
translate german c15s005_BeforeAaronVisit_973395fc:

    # nor "¿Aquí? ¿Ahora? ¡La casa está llena de gente! ¿Tú quieres que le dé un infarto a mi madre? ¿O que continúe la discusión de ayer?"
    nor "Hier? Jetzt? Das Haus ist voller Leute! Willst du, dass meine Mutter einen Herzinfarkt bekommt? Oder dass wir den Streit von gestern fortsetzen?"

# game/scripts/c15/c15.rpy:2284
translate german c15s005_BeforeAaronVisit_8ac66cfc:

    # mom "¿Aquí? ¿Ahora? ¡La casa está llena de gente! ¿Tú quieres que le dé un infarto a mi madre?"
    mom "Hier? Jetzt? Das Haus ist voller Leute! Wollen Sie meiner Mutter einen Herzinfarkt verpassen?"

# game/scripts/c15/c15.rpy:2286
translate german c15s005_BeforeAaronVisit_6f009264:

    # mom "¿Aquí? ¿Ahora? ¡La casa está llena de gente! ¿Tú quieres que le dé un infarto a Olivia?"
    mom "Hier? Jetzt? Das Haus ist voller Leute! Willst du Olivia einen Herzinfarkt verpassen?"

# game/scripts/c15/c15.rpy:2290
translate german c15s005_BeforeAaronVisit_c06bb218:

    # mom "¿Aquí? ¿Ahora? ¿Tú quieres que nos pille mi madre y que continúe la bronca de ayer en la playa?"
    mom "Hier? Jetzt? Willst du, dass meine Mutter uns erwischt und der Streit von gestern am Strand weitergeht?"

# game/scripts/c15/c15.rpy:2292
translate german c15s005_BeforeAaronVisit_785497b8:

    # mom "¿Aquí? ¿Ahora? ¿Tú quieres que nos pille Olivia y que continúe la bronca de ayer en la playa?"
    mom "Hier? Jetzt? Wollt ihr, dass Olivia uns erwischt und der gestrige Streit am Strand weitergeht?"

# game/scripts/c15/c15.rpy:2293
translate german c15s005_BeforeAaronVisit_2b73bd71:

    # mc "Me da lo mismo lo que piense Meemaw. Estoy harto de esconderme."
    mc "Mir ist egal, was Oma denkt. Ich habe es satt, mich zu verstecken."

# game/scripts/c15/c15.rpy:2296
translate german c15s005_BeforeAaronVisit_55c16924:

    # nor "Yo también. Lo de la piscina de anteayer es una demostración de que tenemos que hacerlo público cuanto antes."
    nor "Ich auch. Was vorgestern im Schwimmbad passiert ist, beweist, dass wir das so schnell wie möglich öffentlich machen müssen."

# game/scripts/c15/c15.rpy:2298
translate german c15s005_BeforeAaronVisit_d765e7a4:

    # mc "¿Quieres incluir a alguien más en lo que pasó con [eri]?"
    mc "Möchten Sie noch jemanden in die Geschehnisse um [eri] einbeziehen?"

# game/scripts/c15/c15.rpy:2300
translate german c15s005_BeforeAaronVisit_70f6f6db:

    # nor "¿Qué? ¡No!... o sí... no sé... pero me refiero a que... sentí una conexión preciosa con una de mis hijas que no había sentido nunca."
    nor "Was? Nein!... oder doch... ich weiß es nicht... aber ich meine... ich habe eine wunderschöne Verbindung zu einer meiner Töchter gespürt, die ich vorher noch nie empfunden hatte."

# game/scripts/c15/c15.rpy:2303
translate german c15s005_BeforeAaronVisit_2d24070b:

    # nor "Si [dap] no saliera con nadie... casi te pediría que empezaras a salir con ella para poder compartir lo mismo que hice con [eri]."
    nor "Wenn [dap] mit niemandem zusammen wäre... würde ich dich fast bitten, mit ihr auszugehen, damit wir die gleichen Dinge miteinander teilen könnten, die ich mit [eri] geteilt habe."

# game/scripts/c15/c15.rpy:2304
translate german c15s005_BeforeAaronVisit_0d9725e4:

    # nor "A menos que..."
    nor "Es sei denn..."

# game/scripts/c15/c15.rpy:2306
translate german c15s005_BeforeAaronVisit_27d0d8b4:

    # nor "Estoy casi tentada de pedirte que empieces a salir con [dap] para poder compartir lo mismo que hice con [eri]. *Risa*"
    nor "Ich bin fast versucht, dich zu fragen, ob du mit [dap] ausgehen möchtest, damit wir das Gleiche erleben können, was ich mit [eri] erlebt habe. *Lacht*"

# game/scripts/c15/c15.rpy:2308
translate german c15s005_BeforeAaronVisit_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c15/c15.rpy:2310
translate german c15s005_BeforeAaronVisit_a9e2bc6f:

    # nor "A que [eri] nos dejó solos porque sabe lo nuestro... si ella no lo hubiera sabido..."
    nor "Sie hat uns allein gelassen, weil sie etwas über uns weiß... wenn sie es nicht gewusst hätte..."

# game/scripts/c15/c15.rpy:2314
translate german c15s005_BeforeAaronVisit_e874fb2d:

    # mom "Yo también. Tengo muchas ganas de contárselo a [emm] y..."
    mom "Ich auch. Ich freue mich schon sehr darauf, [emm] und... davon zu erzählen."

# game/scripts/c15/c15.rpy:2316
translate german c15s005_BeforeAaronVisit_2e7fefbd:

    # mom "Lo de ayer fue un paso... pero hay que dar más. Tengo ganas de contárselo a [emm] y..."
    mom "Gestern war ein Schritt nach vorn … aber wir müssen noch mehr tun. Ich freue mich darauf, [emm] und … darüber zu berichten."

# game/scripts/c15/c15.rpy:2317
translate german c15s005_BeforeAaronVisit_a5e3c199:

    # mc "Ven aquí..."
    mc "Komm her..."

# game/scripts/c15/c15.rpy:2323
translate german c15s005_BeforeAaronVisit_ab281ec1:

    # "Vuestros labios se juntan en un beso más tierno que sensual, un beso que confirma que ambos estáis en la misma página."
    "Eure Lippen treffen sich zu einem Kuss, der eher zärtlich als sinnlich ist, ein Kuss, der bestätigt, dass ihr beide einer Meinung seid."

# game/scripts/c15/c15.rpy:2329
translate german c15s005_BeforeAaronVisit_e005532d:

    # "Como no podía ser de otra forma, justo en ese momento tenía que aparecer alguien."
    "Wie erwartet, musste genau in diesem Moment jemand auftauchen."

# game/scripts/c15/c15.rpy:2331
translate german c15s005_BeforeAaronVisit_6d953712:

    # mee "¿Qué está pasando aquí?"
    mee "Was ist hier los?"

# game/scripts/c15/c15.rpy:2334
translate german c15s005_BeforeAaronVisit_4c6a83ca:

    # bet "Ermmm... Ya sabes que se saludan así en casa..."
    bet "Ähm... Du weißt doch, dass sie sich zu Hause so begrüßen..."

# game/scripts/c15/c15.rpy:2337
translate german c15s005_BeforeAaronVisit_bb7412f3:

    # nor "No, Tía Betty. [mc] y yo estamos juntos."
    nor "Nein, Tante Betty. [mc] und ich sind zusammen."

# game/scripts/c15/c15.rpy:2339
translate german c15s005_BeforeAaronVisit_518ba60b:

    # nor "Ya está, ya lo he dicho... se acabó el secreto..."
    nor "So, jetzt hab ich's gesagt... das Geheimnis ist gelüftet..."

# game/scripts/c15/c15.rpy:2341
translate german c15s005_BeforeAaronVisit_68d9c1c2:

    # bet "¡Lo sabía!" (multiple=2)
    bet "Ich wusste es!" (multiple=2)

