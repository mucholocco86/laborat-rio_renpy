    # mc "Si te hago reír, bienvenido sea."
    mc "Wenn ich dich zum Lachen bringe, umso besser."

# game/scripts/c15/c15.rpy:2443
translate german c15s005_BeforeAaronVisit_32282c7a:

    # mc "Hablando de Kiara, por ahí viene."
    mc "Wo wir gerade von Kiara sprechen, da kommt sie ja schon."

# game/scripts/c15/c15.rpy:2511
