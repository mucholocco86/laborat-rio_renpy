

# game/scripts/c15/c15.rpy:209
translate german c15s001_DapDate_9988d3d9:

    # "[dap] introduce en el GPS la dirección del restaurante y conduces hasta allí. Está a poco menos de 20 minutos de la tienda de Maddie."
    "Geben Sie die Adresse des Restaurants in Ihr Navigationsgerät ein und fahren Sie dorthin. Es ist knapp 20 Minuten von Maddies Laden entfernt."

# game/scripts/c15/c15.rpy:212
translate german c15s001_DapDate_ffd0c998:

    # dap "Ya hemos llegado. No te sorprendas por lo que veas ahí dentro..."
    dap "Wir sind angekommen. Wundern Sie sich nicht über das, was Sie drinnen sehen..."

# game/scripts/c15/c15.rpy:213
translate german c15s001_DapDate_2eb99d0b:

    # dap "O mejor aún, sorpréndete."
    dap "Oder noch besser: Lassen Sie sich überraschen."

# game/scripts/c15/c15.rpy:214
translate german c15s001_DapDate_34550ae0:

    # mc "Ya estoy sorprendido. Esto antes era un gimnasio, ¿no? ¿Ahora es un restaurante?"
    mc "Ich bin schon überrascht. Das war doch früher ein Fitnessstudio, oder? Und jetzt ist es ein Restaurant?"

# game/scripts/c15/c15.rpy:216
translate german c15s001_DapDate_f0a216c1:

    # dap "Son unos cuantos restaurantes... y algo más. Lo abrieron hace unos meses. Tenía ganas de venir, pero no tenía nadie con quién venir hasta que... tú y yo... ya sabes..."
    dap "Es sind ein paar Restaurants … und noch etwas. Sie haben vor ein paar Monaten eröffnet. Ich wollte schon lange mal hin, aber ich hatte niemanden, mit dem ich gehen konnte, bis … du und ich … du weißt schon …"

# game/scripts/c15/c15.rpy:217
translate german c15s001_DapDate_267e2c14:

    # mc "[dap], puedes decir hasta que empezamos a salir."
    mc "[dap], kann man sagen, bis wir angefangen haben, uns zu treffen."

# game/scripts/c15/c15.rpy:218
translate german c15s001_DapDate_6df6d6d0:

    # dap "Lo sé, pero se me hace raro decirlo."
    dap "Ich weiß, aber es fühlt sich komisch an, es auszusprechen."

# game/scripts/c15/c15.rpy:220
translate german c15s001_DapDate_5c7d5522:

    # dap "Pues ya estamos aquí."
    dap "Nun, da sind wir also."

# game/scripts/c15/c15.rpy:221
translate german c15s001_DapDate_b14bd407:

    # mc "¿Black Crow? Suena bien, debería haber mirado la página web. Pero es un poco pronto para ir a cenar, ¿no?"
    mc "Black Crow? Klingt gut, ich hätte mal deren Website besuchen sollen. Aber es ist noch etwas früh fürs Abendessen, oder?"

# game/scripts/c15/c15.rpy:222
translate german c15s001_DapDate_09756934:

    # dap "No creas. Tenemos que ducharnos y pasar por la peluquería. Al menos yo. Contigo no van a poder hacer gran cosa."
    dap "Keine Sorge. Wir müssen duschen und zum Friseur. Ich zumindest. Bei dir können sie sowieso nicht viel machen."

# game/scripts/c15/c15.rpy:223
translate german c15s001_DapDate_b69e38e4:

    # mc "¿Peluquería? *Risa* ¿Dónde me has traído?"
    mc "Friseurin? *lacht* Wo hast du mich denn hingebracht?"

# game/scripts/c15/c15.rpy:224
translate german c15s001_DapDate_99c55155:

    # dap "Entremos y lo verás."
    dap "Komm, wir gehen hinein, dann wirst du sehen."

# game/scripts/c15/c15.rpy:226
translate german c15s001_DapDate_117275b9:

    # _("Recepcionista") "Buenas tardes, ¿tienen reserva?"
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:227
translate german c15s001_DapDate_0eaa88ba:

    # mc "Sí, a nombre de Marks."
    mc "Ja, im Namen von Marks."

# game/scripts/c15/c15.rpy:229
translate german c15s001_DapDate_420fa7af:

    # dap "¡[mc] Marks!"
    dap "Noten!"

# game/scripts/c15/c15.rpy:231
translate german c15s001_DapDate_bf0b72ec:

    # _("Recepcionista") "Ah, vale, perfecto. Tienen reserva en el restaurante Black Crow."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:232
translate german c15s001_DapDate_1ce75b02:

    # mc "Exacto."
    mc "Genau."

# game/scripts/c15/c15.rpy:233
translate german c15s001_DapDate_6a4c1705:

    # _("Recepcionista") "Entonces, subiendo por estas escaleras encontrarán el vestuario donde les atenderán mis compañeros."
    _("Recepcionista") ""

# game/scripts/c15/c15.rpy:234
translate german c15s001_DapDate_b2516466:

    # mc "Gracias."
    mc "Danke schön."

# game/scripts/c15/c15.rpy:236
translate german c15s001_DapDate_8bec7690:

    # mc "¿Vestuario? Ahí es donde nos podremos duchar, supongo."
    mc "Umkleidekabine? Dort können wir wohl duschen."

# game/scripts/c15/c15.rpy:237
translate german c15s001_DapDate_a768d130:

    # dap "Y cambiarnos. Vas a poder elegir a tu gusto. Tan solo recuerda esto. 14. Para ir a juego."
    dap "Und ändern Sie es. Sie können wählen, wie Sie möchten. Merken Sie sich einfach Folgendes: 14. Passend."

# game/scripts/c15/c15.rpy:238
translate german c15s001_DapDate_0f97df03:

    # mc "Estás siendo muy misteriosa."
    mc "Du tust sehr geheimnisvoll."

# game/scripts/c15/c15.rpy:240
translate german c15s001_DapDate_a11aa689:

    # dap "¿Quieres que te lo cuente todo y estropee la sorpresa?"
    dap "Soll ich dir alles erzählen und die Überraschung verderben?"

# game/scripts/c15/c15.rpy:241
translate german c15s001_DapDate_4a5ebed8:

    # mc "No, prefiero que me sorprendas, pero sigo pensando que es un poco pronto para cenar."
    mc "Nein, ich würde mich lieber überraschen lassen, aber ich finde es trotzdem noch etwas früh fürs Abendessen."

# game/scripts/c15/c15.rpy:242
translate german c15s001_DapDate_90d35b9d:

    # dap "No te preocupes, entre ducha, cambiarme, y peluquería yo voy a tardar cerca de una hora."
    dap "Keine Sorge, zwischen Duschen, Umziehen und dem Besuch beim Friseur brauche ich ungefähr eine Stunde."

# game/scripts/c15/c15.rpy:243
translate german c15s001_DapDate_c476ef12:

    # mc "¿Qué? ¿Una hora?"
    mc "Was? Eine Stunde?"

# game/scripts/c15/c15.rpy:245
translate german c15s001_DapDate_faf803d9:

    # dap "Querrás que tu novia esté guapa en nuestra primera cita, ¿verdad?"
    dap "Du willst doch, dass deine Freundin bei unserem ersten Date wunderschön aussieht, oder?"

# game/scripts/c15/c15.rpy:246
translate german c15s001_DapDate_742b9e83:

    # mc "[dap], tú estás guapa siempre, pero esperaré. Cada vez siento más curiosidad."
    mc "[dap], du siehst immer wunderschön aus, aber ich warte. Ich werde immer neugieriger."

# game/scripts/c15/c15.rpy:247
translate german c15s001_DapDate_89e81213:

    # dap "Bueno, la curiosidad se acabará en cuanto entres por esa puerta. Nos vemos en una hora."
    dap "Nun, Ihre Neugier wird gestillt sein, sobald Sie durch diese Tür gehen. Wir sehen uns in einer Stunde."

# game/scripts/c15/c15.rpy:249
translate german c15s001_DapDate_bcb25274:

    # "Es el momento de saber a qué viene tanto secretismo."
    "Es ist an der Zeit, herauszufinden, worum es bei all der Geheimniskrämerei geht."

# game/scripts/c15/c15.rpy:251
translate german c15s001_DapDate_02f50975:

    # "Entras en el vestuario y te está esperando alguien de la plantilla vestido como la recepcionista."
    "Sie betreten den Umkleideraum und dort erwartet Sie bereits ein Mitarbeiter, der als Rezeptionist verkleidet ist."

# game/scripts/c15/c15.rpy:252
translate german c15s001_DapDate_1c1c93b1:

    # "Elliot" "Buenas tardes, Sr. Marks. Soy Elliot y seré su Ayudante de Vestuario."
    "Elliot" "Guten Tag, Herr Marks. Mein Name ist Elliot und ich werde Ihr Garderobenassistent sein."

# game/scripts/c15/c15.rpy:253
translate german c15s001_DapDate_14dedc8d:

    # "Elliot" "Tiene las duchas al fondo. Recomendamos su uso antes de cambiarse."
    "Elliot" "Die Duschen befinden sich im hinteren Bereich. Wir empfehlen, diese vor dem Umziehen zu benutzen."

# game/scripts/c15/c15.rpy:254
translate german c15s001_DapDate_4a8bf992:

    # mc "Perfecto. Venimos de la playa y necesito una ducha. Pero no he traído ropa."
    mc "Perfekt. Wir kommen gerade vom Strand und ich brauche dringend eine Dusche. Aber ich habe keine Kleidung mitgenommen."

# game/scripts/c15/c15.rpy:255
translate german c15s001_DapDate_b8a43021:

    # "Elliot" "Veo que es su primera vez en nuestras instalaciones. ¿Quiere que le explique cómo funciona?"
    "Elliot" "Ich sehe, Sie sind zum ersten Mal bei uns. Soll ich Ihnen erklären, wie es funktioniert?"

# game/scripts/c15/c15.rpy:256
translate german c15s001_DapDate_890c041b:

    # mc "Por supuesto."
    mc "Natürlich."

# game/scripts/c15/c15.rpy:258
translate german c15s001_DapDate_4f648d8a:

    # "Elliot" "Lo primero que me tiene que decir es de qué siglo se quiere vestir. Puede ser XIV, XVI, o XVIII. Eso nos ayuda a que las salas sean más homogéneas y a la inmersión de los clientes."
    "Elliot" "Als Erstes müssen Sie mir mitteilen, aus welchem Jahrhundert Sie sich kleiden möchten. Das kann das 14., 16. oder 18. Jahrhundert sein. Dies hilft uns, stimmigere Räume zu gestalten und das Besuchererlebnis zu verbessern."

# game/scripts/c15/c15.rpy:259
translate german c15s001_DapDate_58e3f529:

    # mc "Mi novia me ha dicho que recuerde el número 14. Supongo que se refería a esto. No sabía que era un restaurante temático."
    mc "Meine Freundin sagte mir, ich solle mir die Zahl 14 merken. Ich nehme an, sie meinte das hier. Ich wusste nicht, dass es ein Themenrestaurant war."

# game/scripts/c15/c15.rpy:260
translate german c15s001_DapDate_72269408:

    # "Elliot" "Perfecto. Siendo el Siglo XIV puede escoger entre vestirse de caballero, cortesano, o pícaro. Teníamos un disfraz de campesino, pero no triunfó demasiado."
    "Elliot" "Perfekt. Da wir uns im 14. Jahrhundert befinden, kann man sich als Ritter, Höfling oder Schurke verkleiden. Wir hatten zwar auch ein Bauernkostüm, aber das war nicht sehr beliebt."

# game/scripts/c15/c15.rpy:261
translate german c15s001_DapDate_4a851eec:

    # mc "¿Caballero con armadura, espada y esas cosas?"
    mc "Ein Ritter in Rüstung, mit Schwert und allem Drum und Dran?"

# game/scripts/c15/c15.rpy:263
translate german c15s001_DapDate_52998d60:

    # "Elliot" "Sí a la armadura, no a la espada. No proporcionamos armas, lo siento. Pese a que es uno de los más populares, le tengo que avisar que no es el más cómodo."
    "Elliot" "Ja zu Rüstungen, nein zu Schwertern. Wir stellen leider keine Waffen zur Verfügung. Obwohl sie sehr beliebt ist, muss ich Sie warnen, dass sie nicht die bequemste ist."

# game/scripts/c15/c15.rpy:264
translate german c15s001_DapDate_2d013c95:

    # "Elliot" "Estar cenando con armadura, aunque sea falsa, puede resultar un poco incómodo si no está acostumbrado."
    "Elliot" "In einer Rüstung zu Abend zu essen, selbst wenn sie nur unecht ist, kann etwas unangenehm sein, wenn man es nicht gewohnt ist."

# game/scripts/c15/c15.rpy:265
translate german c15s001_DapDate_d4e39871:

    # mc "¿Podría probarme los tres y decidir?"
    mc "Könnte ich alle drei anprobieren und mich dann entscheiden?"

# game/scripts/c15/c15.rpy:266
translate german c15s001_DapDate_aa2be2e3:

    # "Elliot" "No lo podemos permitir por un tema de higiene. Todos nuestros disfraces se envían a la lavandería después de cada uso."
    "Elliot" "Aus hygienischen Gründen ist dies nicht möglich. Alle unsere Kostüme werden nach jedem Gebrauch in die Reinigung gegeben."

# game/scripts/c15/c15.rpy:267
translate german c15s001_DapDate_605879ae:

    # mc "Entonces me disfrazaré de..."
    mc "Dann werde ich mich als... verkleiden."

# game/scripts/c15/c15.rpy:276
translate german c15s001_DapDate_12d962b0:

    # "Elliot" "Perfecto. Pues si quiere pasar a la ducha y le preparo su ropa. Se la dejaré en la taquilla. Aquí tiene la llave. Número 93. La combinación es 23129. Supongo que no quiere servicio de peluquería."
    "Elliot" "Perfekt. Wenn Sie duschen möchten, bereite ich Ihre Kleidung vor. Ich lege sie in Ihren Spind. Hier ist der Schlüssel. Nummer 93. Die Kombination lautet 23129. Ich nehme an, Sie möchten keinen Friseurbesuch."

# game/scripts/c15/c15.rpy:277
translate german c15s001_DapDate_447ba67f:

    # mc "No, no es necesario. ¿Por qué lo dice?"
    mc "Nein, das ist nicht notwendig. Warum sagst du das?"

# game/scripts/c15/c15.rpy:278
translate german c15s001_DapDate_9cc3265b:

    # "Elliot" "Normalmente los clientes masculinos suelen rechazarlo a menos que lleven el pelo largo."
    "Elliot" "Männliche Kunden lehnen es in der Regel ab, es sei denn, sie haben lange Haare."

# game/scripts/c15/c15.rpy:279
translate german c15s001_DapDate_6464cdcf:

    # mc "Entonces seré como el resto. *Risa* Rechazaré el servicio de peluquería."
    mc "Dann mache ich es wie alle anderen. *lacht* Ich lehne den Friseurbesuch ab."

# game/scripts/c15/c15.rpy:280
translate german c15s001_DapDate_99dbf3ae:

    # "Elliot" "Perfecto. Cuando esté listo, o si necesita ayuda para vestirse, llame a aquel timbre y volveré para acompañarle a la sala de espera."
    "Elliot" "Perfekt. Wenn Sie bereit sind oder Hilfe beim Anziehen benötigen, klingeln Sie bitte, und ich komme zurück, um Sie ins Wartezimmer zu begleiten."

# game/scripts/c15/c15.rpy:282
translate german c15s001_DapDate_12356f46:

    # "Después de darle tu talla, pasas a la ducha. Está claro que han mantenido las instalaciones del antiguo gimnasio."
    "Nachdem man seine Größe ermittelt hat, geht man duschen. Offensichtlich wurden die Einrichtungen aus dem alten Fitnessstudio beibehalten."

# game/scripts/c15/c15.rpy:283
translate german c15s001_DapDate_fb07d82b:

    # "Al volver tienes tu disfraz en la taquilla. Tienes curiosidad por saber cómo te va a quedar. Y especialmente tienes curiosidad sobre cómo se va a vestir [dap]. Esperas haber acertado."
    "Als du zurückkommst, hängt dein Kostüm in deinem Spind. Du bist gespannt, wie es an dir aussehen wird. Und besonders neugierig bist du darauf, was [dap] tragen wird. Du hoffst, die richtige Wahl getroffen zu haben."

# game/scripts/c15/c15.rpy:286
translate german c15s001_DapDate_1b8f0299:

    # mc "No quedo mal de caballero. Aunque el escudero tenía razón. No es muy cómodo. *Risa* Escudero... ya me estoy metiendo en el papel."
    mc "Ich sehe als Ritter gar nicht so schlecht aus. Obwohl der Knappe recht hatte. Es ist nicht sehr bequem. *lacht* Knappe... Ich schlüpfe jetzt in meine Rolle."

# game/scripts/c15/c15.rpy:289
translate german c15s001_DapDate_c35f0399:

    # mc "El disfraz de cortesano es chulo. El tacto es suave. Me alegra haber hecho caso al sirviente y no haber cogido el de caballero. *Risa* Sirviente... ya me estoy metiendo en el papel."
    mc "Das Kostüm des Höflings ist cool. Es fühlt sich weich an. Gut, dass ich auf den Diener gehört und nicht das des Ritters genommen habe. *Lacht* Diener... Ich bin schon ganz in meiner Rolle."

# game/scripts/c15/c15.rpy:292
translate german c15s001_DapDate_2a2c73a7:

    # mc "Creo que Vilfredo vestirá así en la partida de DnD. Me alegra haber hecho caso al tabernero y no haber cogido el de caballero. *Risa* Tabernero... ya me estoy metiendo en el papel."
    mc "Ich glaube, Vilfredo wird sich im D&D-Spiel so kleiden. Gut, dass ich auf den Wirt gehört und mich nicht für das Ritterkostüm entschieden habe. *lacht* Wirt … Ich bin schon ganz in meiner Rolle."

# game/scripts/c15/c15.rpy:294
translate german c15s001_DapDate_ee7db50a:

    # "Justo cuando vas a pulsar el timbre para llamar a Elliot, te das cuenta de que no estás solo en el vestuario."
    "Gerade als du den Summer drücken willst, um Elliot anzurufen, merkst du, dass du nicht allein in der Umkleidekabine bist."

# game/scripts/c15/c15.rpy:295
translate german c15s001_DapDate_e6341375:

    # _("Hombre") "Buenas tardes. ¿Siglo XIV?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:296
translate german c15s001_DapDate_fa27330b:

    # mc "Hola, buenas tardes. Sí."
    mc "Hallo, guten Tag. Ja."

# game/scripts/c15/c15.rpy:297
translate german c15s001_DapDate_30081bbe:

    # _("Hombre") "Nosotros estuvimos la semana pasada. Hoy toca cenar en el Siglo XXXII. Lo han abierto esta semana. Supongo que mi mujer se disfrazará de Princesa Laia. ¿De qué se disfrazará su esposa?"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:298
translate german c15s001_DapDate_9ccdfc53:

    # mc "Mi novia. No lo sé, es la primera vez que venimos y yo ni siquiera sabía qué tipo de restaurante era."
    mc "Meine Freundin. Ich weiß nicht, wir sind zum ersten Mal hier und ich wusste nicht einmal, was für ein Restaurant das ist."

# game/scripts/c15/c15.rpy:300
translate german c15s001_DapDate_20d0961c:

    # _("Hombre") "Si es la primera vez, prepárate para esperar. A nosotros nos dan tres o cuatro opciones, dependiendo del restaurante. A ellas les dan seis o siete."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:301
translate german c15s001_DapDate_9353de80:

    # mc "Pero no pudiéndoselos probar, no tardarán tanto, ¿no?"
    mc "Aber da sie sie nicht anprobieren können, wird es nicht so lange dauern, oder?"

# game/scripts/c15/c15.rpy:303
translate german c15s001_DapDate_a3241e0f:

    # _("Hombre") "No se los pueden probar, pero pueden verlos en la percha. Mi mujer se pasó 20 minutos intentando decidir entre siete vestidos la semana pasada."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:304
translate german c15s001_DapDate_2ef2849b:

    # _("Hombre") "Y obviamente, una vez deciden el vestido, tienen que decidir qué peinado le pega mejor a ese estilo. Media hora más. Espero que tengas batería en el móvil. *Risa*"
    _("Hombre") ""

# game/scripts/c15/c15.rpy:305
translate german c15s001_DapDate_0b486eb8:

    # mc "*Risa* Sí, por suerte voy servido de batería."
    mc "*Lacht* Ja, zum Glück habe ich noch genug Akku."

# game/scripts/c15/c15.rpy:307
translate german c15s001_DapDate_3659900c:

    # _("Hombre") "Bueno, te dejo con tu espera. Ahí viene mi copiloto."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:308
translate german c15s001_DapDate_021a7a94:

    # mc "Que pase una buena noche."
    mc "Gute Nacht."

# game/scripts/c15/c15.rpy:309
translate german c15s001_DapDate_00c9df17:

    # _("Hombre") "Igualmente, hijo."
    _("Hombre") ""

# game/scripts/c15/c15.rpy:311
translate german c15s001_DapDate_6397acfa:

    # "Elliot os lleva a diferentes salas de espera y te sientas a hacer tiempo hasta que [dap] esté preparada. Por lo que ha dicho el hombre en el vestuario, te tocará esperar un rato."
    "Elliot führt dich in verschiedene Warteräume, wo du die Zeit vertreibst, bis [dap] bereit ist. Dem Mann in der Umkleidekabine nach zu urteilen, wirst du noch eine Weile warten müssen."

# game/scripts/c15/c15.rpy:313
translate german c15s001_DapDate_82ffc13f:

    # "Cuando ya has leído todas las noticias locales, internacionales, sobre videojuegos, e incluso sobre la vida de los famosos..."
    "Wenn man bereits alle lokalen und internationalen Nachrichten über Videospiele und sogar über das Leben von Prominenten gelesen hat..."

# game/scripts/c15/c15.rpy:315
translate german c15s001_DapDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:316
translate german c15s001_DapDate_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Versteckte Nummer?)"

# game/scripts/c15/c15.rpy:330
translate german c15s001_DapDate_27e07c02:

    # "Justo al colgar, oyes pasos en las escaleras por las que has bajado."
    "Gerade als du auflegst, hörst du Schritte auf der Treppe, die du heruntergekommen bist."

# game/scripts/c15/c15.rpy:332
translate german c15s001_DapDate_4c40f33f:

    # dap "¿Llevas mucho tiempo esperándome?"
    dap "Hast du schon lange auf mich gewartet?"

# game/scripts/c15/c15.rpy:342
translate german c15s001_DapDate_f4004887:

    # mc "¡Wow, [dap]! ¡Pareces salida de un cuento de hadas! Estás preciosa."
    mc "Wow, [dap]! Du siehst aus wie direkt einem Märchen entsprungen! Du bist wunderschön."

# game/scripts/c15/c15.rpy:343
translate german c15s001_DapDate_4d29251f:

    # dap "¡Gracias, [mc]! Me preocupaba quedar ridícula."
    dap "Vielen Dank, [mc]! Ich hatte Angst, dass ich lächerlich aussehen würde."

# game/scripts/c15/c15.rpy:345
translate german c15s001_DapDate_76a5d3f6:

    # dap "Tú también estás muy guapo, pero no sé si va a ser cómodo cenar con la armadura."
    dap "Du siehst auch sehr gut aus, aber ich weiß nicht, ob es bequem sein wird, in der Rüstung zu Abend zu essen."

# game/scripts/c15/c15.rpy:346
translate german c15s001_DapDate_8d6b7b9b:

    # mc "Me lo ha comentado el ayudante del vestuario, pero no podía dejarlo pasar."
    mc "Der Assistent in der Umkleidekabine hat es mir erzählt, aber ich konnte es nicht dabei belassen."

# game/scripts/c15/c15.rpy:348
translate german c15s001_DapDate_343db1df:

    # dap "Lástima que no hayas hecho a Vilfredo un guerrero o un paladín. Me hubiera gustado imaginarte así en la partida."
    dap "Schade, dass du Vilfredo nicht als Krieger oder Paladin gestaltet hast. Ich hätte mir gerne vorgestellt, wie du ihn im Spiel so spielst."

# game/scripts/c15/c15.rpy:350
translate german c15s001_DapDate_48b8e592:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿príncipe?"
    dap "Du siehst auch sehr gut aus, der Prinzenlook steht dir ausgezeichnet..."

# game/scripts/c15/c15.rpy:351
translate german c15s001_DapDate_d6612785:

    # mc "Oficialmente cortesano, pero si quieres que sea tu príncipe solo tienes que pedirlo."
    mc "Offiziell ist er ein Höfling, aber wenn Sie ihn als Ihren Prinzen haben möchten, fragen Sie ihn einfach."

# game/scripts/c15/c15.rpy:353
translate german c15s001_DapDate_9cc03b0f:

    # dap "Lástima que no hayas hecho a Vilfredo noble. Me hubiera gustado imaginarte así en la partida."
    dap "Schade, dass du Vilfredo nicht zum Adligen gemacht hast. Ich hätte mir dich im Spiel gern so vorgestellt."

# game/scripts/c15/c15.rpy:355
translate german c15s001_DapDate_ea236d73:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿espadachín?"
    dap "Du siehst auch sehr gut aus, der Schwertkämpfer-Look steht dir ausgezeichnet...?"

# game/scripts/c15/c15.rpy:356
translate german c15s001_DapDate_994e2502:

    # mc "Me lo han ofrecido como pícaro y, después de generar el personaje de Vilfredo, no podía dejarlo pasar. Quiero que vista parecido a esto, si es posible."
    mc "Sie boten es mir als Schurken an, und nachdem ich die Figur Vilfredo erschaffen hatte, konnte ich nicht widerstehen. Ich möchte, dass er sich, wenn möglich, ähnlich kleidet."

# game/scripts/c15/c15.rpy:358
translate german c15s001_DapDate_93c0bc47:

    # dap "Ningún problema. No me perdería un pícaro tan guapo por nada del mundo."
    dap "Kein Problem. So einen feschen Schurken würde ich mir um nichts in der Welt entgehen lassen."

# game/scripts/c15/c15.rpy:359
translate german c15s001_DapDate_e5242538:

    # mc "Vas a hacer que este pobre pícaro se ruborice. *Risa*"
    mc "Du bringst den armen Kerl noch zum Erröten. *lacht*"

# game/scripts/c15/c15.rpy:361
translate german c15s001_DapDate_ec28650e:

    # dap "¿Pasamos a cenar? Tengo ganas de ver el restaurante."
    dap "Sollen wir zum Abendessen gehen? Ich würde das Restaurant gerne sehen."

# game/scripts/c15/c15.rpy:362
translate german c15s001_DapDate_c996350e:

    # mc "Cuando quieras. A mí me ha entrado hambre mientras esperaba. Pero la espera ha valido la pena."
    mc "Wann immer du willst. Ich bekam Hunger, während ich wartete. Aber das Warten hat sich gelohnt."

# game/scripts/c15/c15.rpy:365
translate german c15s001_DapDate_08921eec:

    # dap "Gracias, mi amable caballero."
    dap "Vielen Dank, mein lieber Herr."

# game/scripts/c15/c15.rpy:368
translate german c15s001_DapDate_6cada05b:

    # dap "Gracias, mi apuesto príncipe."
    dap "Danke, mein schöner Prinz."

# game/scripts/c15/c15.rpy:371
translate german c15s001_DapDate_dbf1df63:

    # dap "Gracias, mi pícaro seductor."
    dap "Danke, mein gerissener Verführer."

# game/scripts/c15/c15.rpy:373
translate german c15s001_DapDate_607ded3e:

    # "Llamáis al timbre y aparece alguien nuevo del personal."
    "Sie klingeln an der Tür und ein neuer Mitarbeiter erscheint."

# game/scripts/c15/c15.rpy:374
translate german c15s001_DapDate_d17bca35:

    # "Mathilda" "Buenas tardes les de Dios a vuesas mercedes. Mi nombre es Mathilda. Si tienen el placer de acompañarme, les guiaré a su mesa para que puedan disfrutar del yantar."
    "Mathilda" "Guten Tag, Gott segne Sie. Mein Name ist Mathilda. Wenn Sie sich zu mir setzen möchten, leite ich Sie gerne zu Ihrem Tisch, damit Sie Ihr Essen genießen können."

# game/scripts/c15/c15.rpy:376
translate german c15s001_DapDate_e3023a37:

    # dap "Cuando quiera. Estamos listos."
    dap "Wann immer Sie bereit sind. Wir sind bereit."

# game/scripts/c15/c15.rpy:377
translate german c15s001_DapDate_23a0c42a:

    # mc "*Susurrando* Ahora pillo lo del acento raro del tipo que me cogió el teléfono. Era este falso acento medieval."
    mc "*flüstert* Jetzt verstehe ich den seltsamen Akzent des Mannes, der ans Telefon gegangen ist. Es war so ein aufgesetzter mittelalterlicher Akzent."

# game/scripts/c15/c15.rpy:379
translate german c15s001_DapDate_f92c238c:

    # dap "De momento me está gustando, y eso que aún no hemos visto el restaurante."
    dap "Bis jetzt gefällt es mir gut, obwohl wir das Restaurant noch nicht gesehen haben."

# game/scripts/c15/c15.rpy:380
translate german c15s001_DapDate_35cd64fb:

    # mc "El vestido te queda increíble, y el peinado te hace preciosa... más preciosa de lo habitual."
    mc "Das Kleid steht dir fantastisch, und deine Frisur lässt dich umwerfend aussehen... sogar noch umwerfender als sonst."

# game/scripts/c15/c15.rpy:382
translate german c15s001_DapDate_08e27722:

    # dap "Gracias, pero debería haberme quedado con mi trenza. También pega con el vestido y hubiera estado más cómoda. No me siento demasiado confortable con esto."
    dap "Danke, aber ich hätte meinen Zopf behalten sollen. Er passt auch besser zum Kleid, und ich hätte mich wohler gefühlt. So fühle ich mich nicht besonders wohl."

# game/scripts/c15/c15.rpy:383
translate german c15s001_DapDate_b7322079:

    # mc "Bueno, cuando volvamos al vestuario tendrás que devolver todo, incluidos los anillos del pelo. Solo será una hora o dos, ¿no?"
    mc "Okay, wenn wir zurück in der Umkleidekabine sind, musst du alles zurückgeben, auch die Haarringe. Das dauert doch nur ein oder zwei Stunden, oder?"

# game/scripts/c15/c15.rpy:385
translate german c15s001_DapDate_b001bca2:

    # "Atravesáis todo el restaurante y Mathilda os lleva a una zona que parece tranquila. El restaurante parece salido de una película. Al menos es una de aquellas películas donde todo está limpio."
    "Man durchquert das gesamte Restaurant, und Mathilda führt einen in einen ruhigen Bereich. Das Restaurant sieht aus wie aus einem Film. Zumindest ist es einer dieser Filme, in denen alles blitzblank ist."

# game/scripts/c15/c15.rpy:387
translate german c15s001_DapDate_f87f2ef8:

    # "Mathilda" "Hoy está bastante vacío, y esta es la zona más resguardada de miradas ajenas. ¿Les va bien sentarse aquí?"
    "Mathilda" "Es ist heute ziemlich leer, und dies ist der abgelegenste Bereich. Wäre es für Sie in Ordnung, wenn Sie sich hier hinsetzen?"

# game/scripts/c15/c15.rpy:388
translate german c15s001_DapDate_39d84591:

    # mc "Gracias, Mathilda, es perfecto."
    mc "Danke, Mathilda, es ist perfekt."

# game/scripts/c15/c15.rpy:389
translate german c15s001_DapDate_a8caf72d:

    # "Mathilda" "¿Saben cómo funciona el menú? Si quieren se lo explico."
    "Mathilda" "Wissen Sie, wie die Speisekarte funktioniert? Wenn Sie möchten, kann ich es Ihnen erklären."

# game/scripts/c15/c15.rpy:390
translate german c15s001_DapDate_8b13deee:

    # mc "Sí, por favor."
    mc "Ja, bitte."

# game/scripts/c15/c15.rpy:391
translate german c15s001_DapDate_a1ac9ffa:

    # "Mathilda" "Nuestros platos son típicos de la Europa medieval, pero con un toque moderno, con lo que pueden encontrar ingredientes como patata o maíz, que no estaban disponibles en la época."
    "Mathilda" "Unsere Gerichte sind typisch für das mittelalterliche Europa, aber mit einem modernen Touch, daher finden Sie bei uns Zutaten wie Kartoffeln oder Mais, die damals nicht verfügbar waren."

# game/scripts/c15/c15.rpy:392
translate german c15s001_DapDate_72902248:

    # "Mathilda" "Nosotros recomendamos el menú degustación mixto, de carne, o de pescado, donde podrán disfrutar de algunas de nuestras especialidades. También pueden pedir platos individuales."
    "Mathilda" "Wir empfehlen Ihnen das gemischte Degustationsmenü mit Fleisch oder Fisch, bei dem Sie einige unserer Spezialitäten genießen können. Sie können aber auch einzelne Gerichte bestellen."

# game/scripts/c15/c15.rpy:394
translate german c15s001_DapDate_9603f8f9:

    # dap "Yo querré el menú degustación mixto. Y cerveza tostada para beber."
    dap "Ich nehme das gemischte Degustationsmenü. Und dazu ein dunkles Bier."

# game/scripts/c15/c15.rpy:395
translate german c15s001_DapDate_33d9f672:

    # mc "¿Qué platos individuales tienen? Cosas con carne, por favor."
    mc "Welche Einzelgerichte haben Sie? Bitte Gerichte mit Fleisch."

# game/scripts/c15/c15.rpy:397
translate german c15s001_DapDate_8f5494fa:

    # "Mathilda" "Tenemos asado del pastor, que lleva patata sustituyendo al nabo, cazuela del granjero, que lleva maíz para sustituir a la avena, chuletas con salsa de calabaza, o albóndigas de ternera."
    "Mathilda" "Wir haben Shepherd's Roast, bei dem Kartoffeln statt Steckrüben verwendet werden, Farmer's Casserole, bei dem Mais statt Haferflocken verwendet wird, Koteletts mit Kürbissoße oder Rindfleischbällchen."

# game/scripts/c15/c15.rpy:398
translate german c15s001_DapDate_a9336dad:

    # "Mathilda" "El menú degustación de carne consiste en asado del pastor, cazuela del granjero y las albóndigas de ternera. Normalmente lo recomendamos para compartir entre dos personas."
    "Mathilda" "Das Fleisch-Degustationsmenü besteht aus Shepherd's Roast, Bauernauflauf und Rindfleischbällchen. Wir empfehlen es üblicherweise zum Teilen für zwei Personen."

# game/scripts/c15/c15.rpy:399
translate german c15s001_DapDate_841d565c:

    # "Mathilda" "Con una ensalada o unas verduras para compartir como complemento."
    "Mathilda" "Dazu gibt es einen Salat oder etwas Gemüse zum Teilen."

# game/scripts/c15/c15.rpy:400
translate german c15s001_DapDate_044c02a7:

    # mc "¿Ensalada? ¿Verduras? *Risa* Esa es la comida de mi comida... Siempre he querido decir esa frase."
    mc "Salat? Gemüse? *lacht* Das ist mein Essen... Ich wollte das schon immer mal sagen."

# game/scripts/c15/c15.rpy:412
translate german c15s001_DapDate_d26cabd8:

    # mc "Pero si algún plato lleva brócoli, no lo ponga, por favor. Soy alérgico."
    mc "Sollte ein Gericht Brokkoli enthalten, lassen Sie ihn bitte weg. Ich bin allergisch."

# game/scripts/c15/c15.rpy:413
translate german c15s001_DapDate_0b9b511f:

    # "Mathilda" "Como vuesa merced desee. ¿Para beber, señor?"
    "Mathilda" "Wie Sie wünschen. Zum Trinken, mein Herr?"

# game/scripts/c15/c15.rpy:414
translate german c15s001_DapDate_40c4e7c6:

    # mc "Agua. Tengo que conducir luego."
    mc "Wasser. Ich muss später fahren."

# game/scripts/c15/c15.rpy:416
translate german c15s001_DapDate_f4abf09d:

    # dap "Tráigale una cerveza tostada también a él. Vamos a tardar mucho en coger el coche."
    dap "Bring ihm auch ein dunkles Bier mit. Es wird eine Weile dauern, bis wir zum Auto kommen."

# game/scripts/c15/c15.rpy:418
translate german c15s001_DapDate_5663e49e:

    # "Mathilda" "Perfecto. Voy a cursar su pedido y ahora mismo les traigo la bebida."
    "Mathilda" "Perfekt. Ich kümmere mich um Ihre Bestellung und bringe Ihnen die Getränke sofort."

# game/scripts/c15/c15.rpy:420
translate german c15s001_DapDate_ec98a50b:

    # dap "¿Desde cuándo eres alérgico al brócoli? No lo sabía."
    dap "Seit wann bist du denn allergisch gegen Brokkoli? Das wusste ich nicht."

# game/scripts/c15/c15.rpy:421
translate german c15s001_DapDate_f6a5786d:

    # mc "*Risa* No soy alérgico, pero para mí estropea cualquier comida. Siempre digo \"si lleva brócoli no lo pongan\" y la mitad de las veces se olvidan."
    mc "*lacht* Ich bin zwar nicht allergisch, aber für mich verdirbt es jedes Essen. Ich sage immer: „Wenn Brokkoli drin ist, lasst ihn weg“, und meistens vergessen sie es trotzdem."

# game/scripts/c15/c15.rpy:422
translate german c15s001_DapDate_4db266ee:

    # mc "Diciendo que soy alérgico, van con cuidado de no ponerlo. No se han olvidado ni una sola vez."
    mc "Weil ich sage, dass ich allergisch bin, achten sie darauf, es nicht aufzutragen. Das haben sie noch kein einziges Mal vergessen."

# game/scripts/c15/c15.rpy:423
translate german c15s001_DapDate_de7990a8:

    # dap "Es una buena idea. Poco honesta, pero buena idea. Aunque si pidiéndolo correctamente no te hacen caso, es la única forma que te queda de hacerlo."
    dap "Das ist eine gute Idee. Ein bisschen unehrlich, aber eine gute Idee. Wenn sie aber nicht zuhören, wenn man sie ordentlich fragt, ist es wohl der einzige Weg."

# game/scripts/c15/c15.rpy:425
translate german c15s001_DapDate_0799ddb5:

    # dap "Cambiando de tema, ¿qué te parece el sitio? Es original, ¿verdad?"
    dap "Um das Thema zu wechseln: Was hältst du von der Website? Sie ist originell, nicht wahr?"

# game/scripts/c15/c15.rpy:426
translate german c15s001_DapDate_71dbec9b:

    # mc "Es muy original, e ir así vestidos le da un giro interesante, es como si tuvieras una inmersión total."
    mc "Es ist sehr originell, und so gekleidet zu sein, verleiht dem Ganzen eine interessante Note; es ist, als ob man völlig in die Welt der Dinge eintaucht."

# game/scripts/c15/c15.rpy:427
translate german c15s001_DapDate_6ef36d5e:

    # dap "Yo siempre he querido probar algo así, sentirte dentro de una partida de DnD, aunque solo sea durante la cena."
    dap "Ich wollte schon immer mal so etwas ausprobieren, mich wie in einem Dungeons & Dragons-Spiel fühlen, und sei es auch nur beim Abendessen."

# game/scripts/c15/c15.rpy:428
translate german c15s001_DapDate_4951d89e:

    # mc "Si en la partida visitamos una taberna o una posada, será difícil imaginársela diferente a esto."
    mc "Wenn wir im Spiel eine Taverne oder ein Gasthaus besuchen, wird es schwer sein, sich das anders vorzustellen."

# game/scripts/c15/c15.rpy:430
translate german c15s001_DapDate_4bc16d01:

    # dap "Esa era una de las razones para traerte aquí. *Risa* Quiero que sepas qué cosas me gustan. No hemos tenido mucho tiempo de hablar de hobbies y nimiedades."
    dap "Das war einer der Gründe, warum ich dich hierhergebracht habe. *lacht* Ich möchte, dass du weißt, was ich mag. Wir hatten bisher nicht viel Zeit, über Hobbys und Belanglosigkeiten zu reden."

# game/scripts/c15/c15.rpy:431
translate german c15s001_DapDate_40e70b21:

    # mc "Bueno, sé que te gusta estudiar, leer y aprender, los videojuegos, los juegos de rol... ¿la música pop?"
    mc "Nun, ich weiß, dass du gerne studierst, liest und lernst, Videospiele spielst, Rollenspiele magst... und Popmusik hörst du auch gerne?"

# game/scripts/c15/c15.rpy:432
translate german c15s001_DapDate_f77f275c:

    # dap "*Risa* Sí, la música pop. Si llegas a fallar en eso... Te hubiera torturado con los peores discos de Taylor Shift. *Risa*"
    dap "*Lacht* Ja, Popmusik. Wenn du da versagt hättest … hätte ich dich mit den schlechtesten Alben von Taylor Swift gequält. *Lacht*"

# game/scripts/c15/c15.rpy:434
translate german c15s001_DapDate_0ae8448f:

    # dap "Pero a lo que me refiero es a que me encanta este ambiente. Hacer cosas diferentes. No soy tan aventurera como [emm], pero en un sitio así me siento... especial."
    dap "Aber was ich eigentlich sagen will, ist, dass ich diese Atmosphäre liebe. Die Abwechslung. Ich bin zwar nicht so abenteuerlustig wie [emm], aber an einem Ort wie diesem fühle ich mich... besonders."

# game/scripts/c15/c15.rpy:435
translate german c15s001_DapDate_70fffa0f:

    # mc "[dap], tú eres especial. Nunca se me hubiera ocurrido venir a un restaurante así, con lo que la noche ya es diferente."
    mc "[dap], du bist etwas Besonderes. Ich wäre nie auf die Idee gekommen, in so ein Restaurant zu gehen, deshalb ist der Abend jetzt schon anders."

# game/scripts/c15/c15.rpy:436
translate german c15s001_DapDate_251aa2ff:

    # mc "Pasarla contigo, vestida así, la hace verdaderamente especial."
    mc "Es mit dir zu verbringen, so angezogen, macht es zu etwas ganz Besonderem."

# game/scripts/c15/c15.rpy:438
translate german c15s001_DapDate_7937683b:

    # dap "No creía que vestirme de molinera para una cita fuera lo mejor, lo mismo que de tabernera. Imagínate que las otras mesas empiezan a pedirme cosas. *Risa*"
    dap "Ich fand es weder die beste Idee, mich für ein Date als Müllersfrau noch als Wirtin zu verkleiden. Stellt euch vor, die anderen Gäste würden mich plötzlich um etwas bitten! *lacht*"

# game/scripts/c15/c15.rpy:439
translate german c15s001_DapDate_5e2c75b5:

    # mc "Vestida de tabernera seguro que estabas monísima, pero no puedo imaginarme a una molinera sexy. *Risa* Ni siquiera a ti."
    mc "Als Wirtin verkleidet sahst du bestimmt entzückend aus, aber ich kann mir eine sexy Müllersfrau gar nicht vorstellen. *Lacht* Nicht mal du."

# game/scripts/c15/c15.rpy:440
translate german c15s001_DapDate_51b8bcd3:

    # dap "Había un disfraz de guerrera, pero seguía la norma de Hollywood para las armaduras femeninas de que cuanto menos cubra más protege. *Risa*"
    dap "Es gab zwar ein Kriegerkostüm, aber es folgte der Hollywood-Regel für weibliche Rüstungen: Je weniger es bedeckt, desto besser schützt es. *lacht*"

# game/scripts/c15/c15.rpy:441
translate german c15s001_DapDate_f95f3509:

    # mc "Interesante. No me hubiera importado verte así. *Risa*"
    mc "Interessant. Ich hätte nichts dagegen gehabt, dich so zu sehen. *lacht*"

# game/scripts/c15/c15.rpy:442
translate german c15s001_DapDate_0c601860:

    # dap "No seas impaciente. *Risa* Me verás con menos cobertura hoy... si quieres..."
    dap "Nur Geduld. *lacht* Ihr werdet mich heute mit weniger Kleidung sehen... wenn ihr wollt..."

# game/scripts/c15/c15.rpy:443
translate german c15s001_DapDate_a49f5d57:

    # mc "Por supuesto que quiero, si es lo que quieres tú."
    mc "Natürlich möchte ich das, wenn du das möchtest."

# game/scripts/c15/c15.rpy:445
translate german c15s001_DapDate_8433b02a:

    # dap "Llevo deseándolo desde nuestra segunda lección. Con lo que sí. Es lo que quiero."
    dap "Ich wünsche mir das schon seit unserer zweiten Stunde. Also ja. Genau das will ich."

# game/scripts/c15/c15.rpy:446
translate german c15s001_DapDate_7e494062:

    # mc "Yo también llevo tiempo deseándolo."
    mc "Ich wünsche es mir auch schon eine Weile."

# game/scripts/c15/c15.rpy:447
translate german c15s001_DapDate_9a30c032:

    # "Justo en ese momento, Mathilda trae las cervezas."
    "Genau in diesem Moment bringt Mathilda das Bier."

# game/scripts/c15/c15.rpy:449
translate german c15s001_DapDate_849e9eb6:

    # dap "Por una noche especial con mi novio. Mi primer novio."
    dap "Für einen besonderen Abend mit meinem Freund. Meinem ersten Freund."

# game/scripts/c15/c15.rpy:450
translate german c15s001_DapDate_4fab5f29:

    # mc "Por la chica más especial de la noche."
    mc "Für das außergewöhnlichste Mädchen der Nacht."

# game/scripts/c15/c15.rpy:452
translate german c15s001_DapDate_f9c75c73:

    # dap "¡Está buenísima!"
    dap "Es ist köstlich!"

# game/scripts/c15/c15.rpy:453
translate german c15s001_DapDate_f057ccd6:

    # mc "*Risa*"
    mc "*Lachen*"

# game/scripts/c15/c15.rpy:455
translate german c15s001_DapDate_a147bdfe:

    # dap "¿Qué pasa?"
    dap "Was passiert?"

# game/scripts/c15/c15.rpy:456
translate german c15s001_DapDate_adaea1c1:

    # mc "Que estás super graciosa con el bigote de espuma, aunque no te pega con el vestido. *Risa* Te pegaría más con un uniforme de fontanero y una gorra roja."
    mc "Du siehst mit dem Schaumstoffschnurrbart so komisch aus, obwohl er nicht wirklich zum Kleid passt. *lacht* Eine Klempneruniform und eine rote Mütze würden dir besser stehen."

# game/scripts/c15/c15.rpy:458
translate german c15s001_DapDate_55ee868d:

    # dap "¡Oops, perdón! *Risa* Tendré que beber como una princesita."
    dap "Oh, Entschuldigung! *lacht* Dann muss ich wohl wie eine Prinzessin trinken."

# game/scripts/c15/c15.rpy:459
translate german c15s001_DapDate_536b041f:

    # mc "*Risa*. Ya te he dicho que estabas muy graciosa."
    mc "*Lacht*. Ich habe dir doch schon gesagt, dass du sehr lustig bist."

# game/scripts/c15/c15.rpy:461
translate german c15s001_DapDate_2be763cd:

    # dap "Pero no quiero estar graciosa. Quiero estar guapa y sexy para ti en nuestra primera cita."
    dap "Aber ich möchte nicht niedlich aussehen. Ich möchte bei unserem ersten Date schön und sexy für dich aussehen."

# game/scripts/c15/c15.rpy:462
translate german c15s001_DapDate_9b23af18:

    # mc "[dap], ya te he dicho que estabas preciosa. Y lo de estar sexy lo llevas dentro, no tienes que hacer nada especial para estarlo."
    mc "[dap], ich habe dir doch schon gesagt, dass du umwerfend aussiehst. Und du bist von Natur aus sexy, du musst nichts Besonderes tun, um sexy zu sein."

# game/scripts/c15/c15.rpy:464
translate german c15s001_DapDate_7a902e65:

    # dap "Entonces, ¿me harías el amor esta noche, aunque no llevase este vestido?"
    dap "Würdest du heute Nacht mit mir schlafen, auch wenn ich dieses Kleid nicht tragen würde?"

# game/scripts/c15/c15.rpy:465
translate german c15s001_DapDate_87bc4363:

    # mc "Espero que cuando hagamos el amor no lo lleves. *Risa* Pero sí, te haría el amor aunque fueras con un saco de patatas en vez de con ese vestido."
    mc "Hoffentlich trägst du das nicht, wenn wir miteinander schlafen. *Lacht* Aber ja, ich würde auch mit dir schlafen, wenn du statt dieses Kleides einen Kartoffelsack tragen würdest."

# game/scripts/c15/c15.rpy:467
translate german c15s001_DapDate_b4286511:

    # dap "Perfecto, porque no pienso dejarte escapar esta noche."
    dap "Perfekt, denn ich habe nicht vor, dich heute Abend entkommen zu lassen."

# game/scripts/c15/c15.rpy:468
translate german c15s001_DapDate_c00e8be0:

    # mc "No tengo intención de escaparme. Esta noche soy todo para ti."
    mc "Ich habe nicht die Absicht, wegzulaufen. Heute Nacht gehöre ich ganz dir."

# game/scripts/c15/c15.rpy:470
translate german c15s001_DapDate_5661754e:

    # dap "Sabes que, si seguimos hablando de esto, voy a estar pensando en lo que pasará después toda la cena, ¿verdad?"
    dap "Du weißt doch, dass ich, wenn wir weiter darüber reden, den ganzen Abend lang darüber nachdenken werde, was als Nächstes passieren wird, oder?"

# game/scripts/c15/c15.rpy:471
translate german c15s001_DapDate_1c835586:

    # mc "¿Quieres cambiar de tema?"
    mc "Möchten Sie das Thema wechseln?"

# game/scripts/c15/c15.rpy:473
translate german c15s001_DapDate_402ecb75:

    # dap "El problema es que ahora mismo solo me apetece hablar sobre nosotros y de nuestra relación."
    dap "Das Problem ist, dass ich im Moment einfach nur über uns und unsere Beziehung sprechen möchte."

# game/scripts/c15/c15.rpy:474
translate german c15s001_DapDate_f01e22f5:

    # dap "Sobre qué piensas que va a pasar con nosotros... somos primos..."
    dap "Was glaubst du, wird mit uns passieren... wir sind Cousins..."

# game/scripts/c15/c15.rpy:475
translate german c15s001_DapDate_8e9f18ea:

    # mc "Me da lo mismo que lo seamos, [dap]."
    mc "Mir ist es egal, ob wir es sind, [dap]."

# game/scripts/c15/c15.rpy:477
translate german c15s001_DapDate_81e21e06:

    # mc "Y más teniendo en cuenta que los dos sabemos que no lo somos."
    mc "Und das gilt umso mehr, als wir beide wissen, dass wir es nicht sind."

# game/scripts/c15/c15.rpy:479
translate german c15s001_DapDate_15000879:

    # dap "Lo sé, pero todo el mundo piensa que sí. Bueno, todo el mundo no. Mi madre lo sabe y lógicamente la tuya también... y la abuela... y Tía Betty, supongo... Y a Scarlett se lo dije yo."
    dap "Ich weiß, aber das denken ja alle. Na ja, nicht alle. Meine Mutter weiß es, und deine wahrscheinlich auch... und Oma... und Tante Betty, nehme ich an... Und ich habe es Scarlett erzählt."

# game/scripts/c15/c15.rpy:482
translate german c15s001_DapDate_cbdc2f5d:

    # dap "Pero ¿qué pensará la gente si lo hacemos público? ¿Mi hermana o la tuya? ¿Eileen o Jamaal? Ya viste las caras de las estudiantes cuando me besaste durante el juego."
    dap "Aber was werden die Leute denken, wenn wir das öffentlich machen? Meine Schwester oder deine? Eileen oder Jamaal? Du hast die Gesichter der Schüler gesehen, als du mich während des Spiels geküsst hast."

# game/scripts/c15/c15.rpy:483
translate german c15s001_DapDate_ec193f05:

    # mc "¿Te soy sincero? No me importa lo que piensen. Lo único que deben pensar es que estoy con una chica maravillosa que me hace feliz."
    mc "Ehrlich gesagt ist mir egal, was sie denken. Sie sollten nur denken, dass ich mit einem wundervollen Mädchen zusammen bin, das mich glücklich macht."

# game/scripts/c15/c15.rpy:484
translate german c15s001_DapDate_4b28ab0d:

    # mc "Quiero pasar el resto de mi vida contigo, [dap]. Quiero que envejezcamos juntos. Quiero que sepas lo importante que eres para mí. Y quiero que todo el mundo lo sepa también."
    mc "Ich möchte den Rest meines Lebens mit dir verbringen. Ich möchte, dass wir zusammen alt werden. Ich möchte, dass du weißt, wie wichtig du mir bist. Und ich möchte, dass es alle anderen auch wissen."

# game/scripts/c15/c15.rpy:485
translate german c15s001_DapDate_6e91adb8:

    # mc "¿Y a ti? ¿Te importa lo que piensen los demás?"
    mc "Und du? Ist dir die Meinung anderer Leute wichtig?"

# game/scripts/c15/c15.rpy:487
translate german c15s001_DapDate_b25e09cd:

    # dap "Después de lo que acabas de decir... no debería decir que me importe... pero me importa. No sé cómo decírselo a mi hermana. O al resto de la familia."
    dap "Nach dem, was du gerade gesagt hast … ich sollte nicht sagen, dass es mich kümmert … aber es tut es. Ich weiß nicht, wie ich es meiner Schwester beibringen soll. Oder dem Rest der Familie."

# game/scripts/c15/c15.rpy:488
translate german c15s001_DapDate_da0cbb2a:

    # dap "Quiero hacerlo, pero no sé cómo... cualquier escenario que en el que puedo pensar acaba en discusión... con mi madre, con la tuya, con la abuela..."
    dap "Ich möchte es tun, aber ich weiß nicht wie... jedes Szenario, das mir einfällt, endet in einem Streit... mit meiner Mutter, mit deiner, mit deiner Großmutter..."

# game/scripts/c15/c15.rpy:489
translate german c15s001_DapDate_0962fc03:

    # mc "Se lo puedes decir con un beso..."
    mc "Du kannst es ihm/ihr mit einem Kuss sagen..."

# game/scripts/c15/c15.rpy:491
translate german c15s001_DapDate_5d11e3dd:

    # dap "¡[mc]! ¡Ya te dije que no beso a chicas! ¡Lo de Scarlett fue solo para aprender!"
    dap "[mc]! Ich hab dir doch schon gesagt, dass ich keine Mädchen küsse! Was ich mit Scarlett gemacht hab, war nur zum Lernen!"

# game/scripts/c15/c15.rpy:492
translate german c15s001_DapDate_56c18a7f:

    # mc "*Risa* No me refería a que las besaras a ellas, sino a que me besaras a mí delante de ellas."
    mc "*Lacht* Ich wollte nicht, dass du sie küsst, sondern dass du mich vor ihnen küsst."

# game/scripts/c15/c15.rpy:494
translate german c15s001_DapDate_7d70a208:

    # "La conversación es interrumpida por Mathilda, que llega con la comida."
    "Das Gespräch wird von Mathilda unterbrochen, die mit dem Essen eintrifft."

# game/scripts/c15/c15.rpy:495
translate german c15s001_DapDate_c957812e:

    # "Mathilda" "Aquí traigo su yantar. Disfruten de nuestros manjares. ¿Puedo ofrecerles algo más a vuesas mercedes?"
    "Mathilda" "Hier ist Ihr Essen. Guten Appetit! Kann ich Ihnen sonst noch etwas anbieten?"

# game/scripts/c15/c15.rpy:497
translate german c15s001_DapDate_370648d3:

    # dap "Por mí no, gracias. Esto tiene una pinta deliciosa."
    dap "Nein, danke, nichts für mich. Das sieht aber lecker aus."

# game/scripts/c15/c15.rpy:498
translate german c15s001_DapDate_7abb4579:

    # mc "Por mí tampoco, gracias."
    mc "Ich auch nicht, danke."

# game/scripts/c15/c15.rpy:500
translate german c15s001_DapDate_0871ec30:

    # dap "Esto tiene una pinta excelente. ¿Qué tal lo tuyo?"
    dap "Das sieht toll aus. Wie läuft es bei dir?"

# game/scripts/c15/c15.rpy:511
translate german c15s001_DapDate_3d866d0f:

    # mc "Tiene muy buena pinta. Cuidan hasta el mínimo detalle, fíjate en los platos."
    mc "Es sieht wirklich gut aus. Sie achten selbst auf kleinste Details, man muss sich nur das Geschirr ansehen."

# game/scripts/c15/c15.rpy:513
translate german c15s001_DapDate_e06be625:

    # dap "Ya te he dicho que tenía ganas de venir. Los comentarios en ThreeSquare eran muy buenos para un sitio que lleva tan poco tiempo abierto. ¿Empezamos?"
    dap "Ich hatte dir ja schon gesagt, dass ich mich darauf freue. Die Bewertungen auf Threesquare waren echt gut für ein Lokal, das erst seit Kurzem geöffnet ist. Wollen wir anfangen?"

# game/scripts/c15/c15.rpy:514
translate german c15s001_DapDate_e8380814:

    # mc "Sí, pero estábamos hablando de hacer público lo nuestro."
    mc "Ja, aber wir sprachen darüber, unsere Beziehung öffentlich zu machen."

# game/scripts/c15/c15.rpy:516
translate german c15s001_DapDate_8dc912e1:

    # dap "Sí, y tú has dicho que te bese delante de mi madre o de [eri]. *Risa* Estás loco. ¿O crees que soy tonta?"
    dap "Ja, und du meintest, ich solle dich vor meiner Mutter küssen oder [eri]. *Lacht* Du spinnst wohl. Oder hältst du mich für dumm?"

# game/scripts/c15/c15.rpy:518
translate german c15s001_DapDate_ac41c310:

    # mc "No es tan mala idea. Ha funcionado con anterioridad."
    mc "Das ist keine schlechte Idee. Es hat schon einmal funktioniert."

# game/scripts/c15/c15.rpy:520
translate german c15s001_DapDate_1faf8f84:

    # dap "{b}¿Qué? ¿Quién? ¿Cuándo?{/b} ¿Cómo se lo tomaron?"
    dap "{b}Was? Wer? Wann?{/b} Wie haben sie es aufgenommen?"

# game/scripts/c15/c15.rpy:521
translate german c15s001_DapDate_6f4149b0:

    # mc "Sigo vivo, con lo que la cosa no acabó mal. *Risa*"
    mc "Ich lebe noch, also ist es nicht so schlimm ausgegangen. *lacht*"

# game/scripts/c15/c15.rpy:523
translate german c15s001_DapDate_9273e56e:

    # mc "No me parece una mala idea. Eres tú quien tiene que decidir si quieres que lo sepan y cuando quieres que lo sepan."
    mc "Ich finde das keine schlechte Idee. Es liegt an dir zu entscheiden, ob und wann du sie darüber informieren möchtest."

# game/scripts/c15/c15.rpy:525
translate german c15s001_DapDate_f6f171e5:

    # dap "Yo no podría hacerlo. Sabes que soy más de hablar que de actuar."
    dap "Ich konnte es nicht. Du weißt ja, ich bin eher ein Redner als ein Macher."

# game/scripts/c15/c15.rpy:526
translate german c15s001_DapDate_8adad7a1:

    # mc "Entonces tendremos que buscar el momento correcto para explicarlo. O puedo besarte yo."
    mc "Dann müssen wir den richtigen Moment finden, um es dir zu erklären. Oder ich kann dich küssen."

# game/scripts/c15/c15.rpy:527
translate german c15s001_DapDate_f1a13d58:

    # dap "Prefiero hablarlo, a ser posible de una en una. Primero [eri], después mi madre. Con un poco de suerte cuando le toque a la abuela ya estará de nuevo en Florida."
    dap "Ich spreche lieber darüber, wenn möglich der Reihe nach. Zuerst mit meiner Mutter, dann mit meiner Großmutter. Mit etwas Glück ist meine Großmutter bis dahin wieder in Florida."

# game/scripts/c15/c15.rpy:528
translate german c15s001_DapDate_2ee09558:

    # mc "¡Cuánto miedo le tenéis todas a Meemaw!"
    mc "Wie sehr ihr euch doch alle vor Meemaw fürchtet!"

# game/scripts/c15/c15.rpy:530
translate german c15s001_DapDate_fcd16a07:

    # dap "¿Le tenemos? ¿Todas? ¿Quién más?"
    dap "Haben wir sie? Alle? Wer noch?"

# game/scripts/c15/c15.rpy:531
translate german c15s001_DapDate_9eeedcfb:

    # mc "Ermmm... tu madre, por ejemplo. Desde que sabemos que venía, ha estado preocupada sobre lo que diría sobre la casa... y esas cosas..."
    mc "Ähm... deine Mutter zum Beispiel. Seit wir wissen, dass sie kommt, macht sie sich Sorgen darüber, was sie über das Haus sagen würde... und solche Sachen..."

# game/scripts/c15/c15.rpy:533
translate german c15s001_DapDate_743b8e3d:

    # dap "Ah, vale, te refieres a eso. ¡Qué susto! Creía que te referías a que estabas con alguien más de la familia... y no estoy preguntando porque sé que no vas a contestar."
    dap "Ah, okay, das meinst du also. Was für ein Schreck! Ich dachte, du meintest, du wärst mit jemand anderem aus der Familie zusammen... und ich frage gar nicht erst, weil ich weiß, dass du sowieso nicht antworten wirst."

# game/scripts/c15/c15.rpy:535
translate german c15s001_DapDate_6b4a6a87:

    # dap "Pero volviendo al tema encima de la mesa. Tú querrías hacerlo público y yo no estoy preparada. ¿Te importa que nos lo tomemos con calma?"
    dap "Aber zurück zum Thema. Sie möchten es öffentlich machen, und ich bin noch nicht so weit. Hätten Sie etwas dagegen, wenn wir es langsam angehen?"

# game/scripts/c15/c15.rpy:536
translate german c15s001_DapDate_a38cc4aa:

    # mc "Mientras me sigas dejando disfrutar de tu compañía, mientras me dejes seguir besándote y acariciándote, no me importa quién lo sepa."
    mc "Solange du mir erlaubst, deine Gesellschaft zu genießen, solange du mich dich weiter küssen und streicheln lässt, ist es mir egal, wer es weiß."

# game/scripts/c15/c15.rpy:537
translate german c15s001_DapDate_f8bd74f2:

    # mc "¿Preferiría poder llegar a casa y decírselo a todo el mundo? Por supuesto, pero no te voy a forzar a ello."
    mc "Möchtest du lieber nach Hause gehen und es allen erzählen? Natürlich, aber ich werde dich nicht dazu zwingen."

# game/scripts/c15/c15.rpy:539
translate german c15s001_DapDate_4816d419:

    # dap "Gracias, [mc]."
    dap "Vielen Dank, [mc]."

# game/scripts/c15/c15.rpy:540
translate german c15s001_DapDate_6811d74a:

    # dap "Cambiando de tema, ¿cómo nos ves en cinco años?"
    dap "Um auf ein anderes Thema zurückzukommen: Wie sehen Sie uns in fünf Jahren?"

# game/scripts/c15/c15.rpy:541
translate german c15s001_DapDate_66e93671:

    # mc "Eso es más una pregunta para una entrevista de trabajo que para una cita. *Risa* Pero es fácil de contestar."
    mc "Das ist eher eine Frage aus einem Vorstellungsgespräch als eine Frage für ein Date. *lacht* Aber sie ist leicht zu beantworten."

# game/scripts/c15/c15.rpy:544
translate german c15s001_DapDate_58ea6be9:

    # mc "Me gustaría tener, como mínimo, una pequeña [dap] correteando por casa."
    mc "Ich hätte gerne zumindest einen kleinen [dap], der im Haus herumläuft."

# game/scripts/c15/c15.rpy:545
translate german c15s001_DapDate_8513a3d6:

    # mc "Me gustaría que hubieras acabado tus estudios y encontrases algún trabajo que te llenara en un sitio donde pudiéramos estar juntos."
    mc "Ich wünschte, du hättest dein Studium abgeschlossen und einen erfüllenden Job an einem Ort gefunden, an dem wir zusammen sein könnten."

# game/scripts/c15/c15.rpy:547
translate german c15s001_DapDate_a91faff1:

    # mc "Me gustaría que mirásemos hacia atrás, a esta noche, y pensáramos \"¿Ya han pasado cinco años?\" y nos sorprendiéramos."
    mc "Ich wünsche mir, dass wir auf diese Nacht zurückblicken und uns fragen: „Sind wirklich schon fünf Jahre vergangen?“ und überrascht sind."

# game/scripts/c15/c15.rpy:549
translate german c15s001_DapDate_664e0fa8:

    # mc "Me gustaría que de lo único que nos arrepintiéramos fuera de no haber empezado antes, de haber desperdiciado unos preciosos días juntos."
    mc "Ich wünsche mir, dass unser einziges Bedauern darin bestünde, nicht früher angefangen zu haben und dadurch einige kostbare gemeinsame Tage vergeudet zu haben."

# game/scripts/c15/c15.rpy:551
translate german c15s001_DapDate_7928fb23:

    # dap "¡Joder, [mc]! ¡No podías haber dicho algo más bonito!"
    dap "Verdammt, [mc]! Das hättest du nicht netter sagen können!"

# game/scripts/c15/c15.rpy:552
translate german c15s001_DapDate_00a4148f:

    # mc "No se lo podía haber dicho a alguien más bonita."
    mc "Ich hätte es keiner hübscheren Person sagen können."

# game/scripts/c15/c15.rpy:554
translate german c15s001_DapDate_ff938204:

    # dap "¡Un brindis porque todo lo que has dicho se cumpla!"
    dap "Ich freue mich darauf, dass all deine Worte in Erfüllung gehen!"

# game/scripts/c15/c15.rpy:555
translate german c15s001_DapDate_299c3501:

    # mc "¡Brindo por ello!"
    mc "Darauf ein Hoch!"

# game/scripts/c15/c15.rpy:557
translate german c15s001_DapDate_4f20587c:

    # dap "Veo que lo de beber como una princesa no se me da bien. A lo mejor puedo trabajar aquí de tabernera. *Risa*"
    dap "Ich schätze, wie eine Prinzessin zu trinken, ist nicht so mein Ding. Vielleicht könnte ich hier als Bardame arbeiten. *lacht*"

# game/scripts/c15/c15.rpy:558
translate german c15s001_DapDate_c5a66d6b:

    # mc "Es posible. *Risa* Pero siempre serás mi princesa. Tengo una duda."
    mc "Das ist möglich. *lacht* Aber du wirst immer meine Prinzessin bleiben. Ich habe eine Frage."

# game/scripts/c15/c15.rpy:559
translate german c15s001_DapDate_031bfa8a:

    # dap "Dime."
    dap "Sag mir."

# game/scripts/c15/c15.rpy:561
translate german c15s001_DapDate_3b5ddfbc:

    # mc "Has brindado por que se cumpla todo. ¿Todo? ¿Incluida la pequeña [dap]?"
    mc "Du hast darauf angestoßen, dass all deine Wünsche in Erfüllung gehen. Alle? Auch die des Kleinen?"

# game/scripts/c15/c15.rpy:563
translate german c15s001_DapDate_80f8b652:

    # dap "*Susurrando* ¿Tú has traído condones? Porque yo no estoy con la pastilla, nunca la he necesitado, y no voy a empezar ahora."
    dap "*Flüsternd* Hast du Kondome mitgebracht? Ich nehme nämlich nicht die Pille, habe sie nie gebraucht und werde jetzt auch nicht damit anfangen."

# game/scripts/c15/c15.rpy:564
translate german c15s001_DapDate_d1122d1c:

    # mc "No, no he traído."
    mc "Nein, ich habe keine mitgebracht."

# game/scripts/c15/c15.rpy:566
translate german c15s001_DapDate_31abef77:

    # dap "Entonces podemos ir a comprarlos cuando acabemos de cenar, o podemos hacer el primer intento de hacer a la pequeña [dap]."
    dap "Dann können wir sie kaufen gehen, wenn wir mit dem Abendessen fertig sind, oder wir können den ersten Versuch unternehmen, das kleine [dap] herzustellen."

# game/scripts/c15/c15.rpy:567
translate german c15s001_DapDate_d61cf959:

    # dap "Hoy quiero hacer el amor contigo, si quieres con condón, si quieres sin. No me da miedo quedarme embarazada. Sé que voy a pasar el resto de mi vida contigo."
    dap "Heute möchte ich mit dir schlafen, mit Kondom, wenn du möchtest, oder ohne, wenn du es lieber magst. Ich habe keine Angst vor einer Schwangerschaft. Ich weiß, dass ich den Rest meines Lebens mit dir verbringen werde."

# game/scripts/c15/c15.rpy:568
translate german c15s001_DapDate_774417e9:

    # dap "Y no quiero que, dentro de cinco años, cuando miremos hacia atrás, a esta noche, nos arrepintamos de no haberlo hecho."
    dap "Und ich möchte nicht, dass wir in fünf Jahren auf diese Nacht zurückblicken und es bereuen, es nicht getan zu haben."

# game/scripts/c15/c15.rpy:569
translate german c15s001_DapDate_81d9ec17:

    # dap "La pequeña [dap] va a tener una gran familia. Quiero que la disfrute el máximo de tiempo posible."
    dap "Die kleine [dap] wird eine große Familie haben. Ich möchte, dass sie das so lange wie möglich genießt."

# game/scripts/c15/c15.rpy:570
translate german c15s001_DapDate_cb2a79b5:

    # mc "Sabes que ahora mismo me podría levantar y besarte, ¿verdad?"
    mc "Du weißt, ich könnte jetzt aufstehen und dich küssen, oder?"

# game/scripts/c15/c15.rpy:572
translate german c15s001_DapDate_9f80b391:

    # dap "Después del discurso que acabo de soltar, me están temblando las piernas. Pero si te levantas y me besas, nos vamos a tener que ir sin acabar de cenar. Dudo que pudiera parar."
    dap "Nach meiner Rede zittern mir die Beine. Aber wenn du aufstehst und mich küsst, müssen wir leider gehen, ohne zu Abend zu essen. Ich bezweifle, dass ich mich beherrschen könnte."

# game/scripts/c15/c15.rpy:573
translate german c15s001_DapDate_14cf106f:

    # dap "Mejor guarda esos besos para cuando estemos solos. Los vas a necesitar."
    dap "Heb dir die Küsse für die Zeit auf, wenn wir allein sind. Du wirst sie brauchen."

# game/scripts/c15/c15.rpy:574
translate german c15s001_DapDate_f393e816:

    # mc "No te preocupes, no se agotan."
    mc "Keine Sorge, sie gehen nicht aus."

# game/scripts/c15/c15.rpy:575
translate german c15s001_DapDate_02d88677:

    # mc "¿Tienes pensado algún nombre para la pequeña [dap]?"
    mc "Haben Sie sich schon einen Namen für das Kleine überlegt?"

# game/scripts/c15/c15.rpy:577
translate german c15s001_DapDate_a53f9b89:

    # dap "Sí. Me gustan Maeve y Claire. También me gusta Hope, pero es un nombre que [eri] siempre ha querido ponerle a nuestra hermana, si mi madre encontraba a alguien."
    dap "Ja. Ich mag Maeve und Claire. Hope gefällt mir auch, aber das ist ein Name, den [eri] unserer Schwester schon immer geben wollte, falls meine Mutter jemals jemanden finden sollte."

# game/scripts/c15/c15.rpy:578
translate german c15s001_DapDate_995bee38:

    # dap "Supongo que con la edad que tiene mi madre, ese nombre pasará a la hija de [eri] cuando ella encuentre un chico que valga la mitad de lo que vales tú."
    dap "Ich nehme an, dass bei dem Alter meiner Mutter dieser Name an [eri]s Tochter weitergegeben wird, wenn sie einen Jungen findet, der nur halb so viel wert ist wie du."

# game/scripts/c15/c15.rpy:579
translate german c15s001_DapDate_5c01de9c:

    # mc "Me gustan los dos nombres. *Risa* Podemos seguir tu tradición familiar y tener gemelas."
    mc "Mir gefallen beide Namen. *lacht* Wir können eurer Familientradition folgen und Zwillinge bekommen."

# game/scripts/c15/c15.rpy:581
translate german c15s001_DapDate_f9bc189f:

    # dap "Si pudiera elegirlo, las tendría. *Risa* Pero no es algo que se elija."
    dap "Wenn ich es mir aussuchen könnte, würde ich sie nehmen. *lacht* Aber das ist keine Sache, die man sich aussucht."

# game/scripts/c15/c15.rpy:582
translate german c15s001_DapDate_33851ada:

    # mc "Lo sé, pero sería bonito tener dos pequeñas [dap] correteando por casa en vez de solo una."
    mc "Ich weiß, aber es wäre schön, zwei kleine Kinder im Haus herumtoben zu haben, anstatt nur eines."

# game/scripts/c15/c15.rpy:583
translate german c15s001_DapDate_d208f71f:

    # dap "Sí, sería bonito... pero todo se andará."
    dap "Ja, das wäre schön... aber es wird sich alles zum Guten wenden."

# game/scripts/c15/c15.rpy:584
translate german c15s001_DapDate_cb7cbdfc:

    # mc "Sobre lo del trabajo, sé que vas a estudiar Química. ¿De qué quieres trabajar? ¿Qué posibilidades laborales tienes en Newport?"
    mc "Was deine berufliche Zukunft angeht, ich weiß, dass du Chemie studieren wirst. Welche Art von Arbeit möchtest du später machen? Welche Jobaussichten gibt es in Newport?"

# game/scripts/c15/c15.rpy:586
translate german c15s001_DapDate_3e2a869e:

    # dap "Enseñar en la NWU o en algún instituto. O investigación, que es lo que me gustaría, en la NWU o en la Cal Poly."
    dap "Ich würde gerne an der NWU oder einem anderen Institut unterrichten. Oder, was ich bevorzugen würde, an der NWU oder Cal Poly forschen."

# game/scripts/c15/c15.rpy:587
translate german c15s001_DapDate_0d6cc6bb:

    # dap "En San Luís, en Paso Robles, o en Atascadero hay algunas empresas donde también podría trabajar. Pero vete a saber cómo estará el tema laboral en cuatro años."
    dap "In San Luis, Paso Robles oder Atascadero gäbe es einige Unternehmen, bei denen ich ebenfalls arbeiten könnte. Aber wer weiß schon, wie der Arbeitsmarkt in vier Jahren aussehen wird."

# game/scripts/c15/c15.rpy:588
translate german c15s001_DapDate_b1336de6:

    # mc "Con lo que podrías seguir viviendo en Newport, ¿no?"
    mc "Sie könnten also weiterhin in Newport wohnen, richtig?"

# game/scripts/c15/c15.rpy:590
translate german c15s001_DapDate_96e39944:

    # dap "No lo sé. Me tendrían que contratar en alguno de esos sitios. Pero nunca había pensado en mudarme. Me gustaría vivir en Newport siempre. ¿Qué opinas?"
    dap "Ich weiß nicht. Ich müsste erst mal bei einem dieser Läden einen Job finden. Aber ich habe noch nie ans Umziehen gedacht. Ich würde am liebsten für immer in Newport wohnen. Was meinst du?"

# game/scripts/c15/c15.rpy:591
translate german c15s001_DapDate_09dc82f3:

    # mc "Que me da lo mismo donde vivamos. Pero a mí también me gustaría quedarme en Newport."
    mc "Mir ist es egal, wo wir wohnen. Aber ich würde auch gerne in Newport bleiben."

# game/scripts/c15/c15.rpy:592
translate german c15s001_DapDate_d5379c54:

    # dap "¿Y tú? ¿Qué planes tienes para el futuro? Una vez el Dormitorio esté totalmente en marcha, vas a tener muy poco trabajo."
    dap "Und Sie? Was sind Ihre Zukunftspläne? Sobald das Wohnheim vollständig in Betrieb ist, werden Sie kaum noch etwas zu tun haben."

# game/scripts/c15/c15.rpy:593
translate german c15s001_DapDate_5bfdc0cd:

    # mc "He estado haciendo números, y no pintan bien. Con lo que pagan 12 chicas, y una vez se acabe la subvención extra que nos da la NWU, los números salen muy justos."
    mc "Ich habe die Zahlen durchgerechnet, und sie sehen nicht gut aus. Angesichts der Kosten für zwölf Mädchen und dem Auslaufen des zusätzlichen Zuschusses der NWU wird es finanziell sehr knapp."

# game/scripts/c15/c15.rpy:595
translate german c15s001_DapDate_e871c428:

    # dap "¿Tan mal estamos?"
    dap "Ist die Lage wirklich so schlimm?"

# game/scripts/c15/c15.rpy:596
translate german c15s001_DapDate_263a5054:

    # mc "Entre impuestos y los costes operativos estimados, quedarán un par de sueldos medianos. Somos tres personas trabajando, con lo que seguramente tendré que buscar algo. En Newport o alrededores."
    mc "Nach Abzug von Steuern und geschätzten Betriebskosten bleiben wohl nur noch ein paar durchschnittliche Gehälter übrig. Wir sind zu dritt berufstätig, daher muss ich mir wohl etwas anderes suchen. In Newport oder Umgebung."

# game/scripts/c15/c15.rpy:597
translate german c15s001_DapDate_f9099e9b:

    # mc "La NWU nos subvenciona este año y el que viene, con lo que tengo tiempo para buscar algo."
    mc "Die NWU subventioniert uns dieses und nächstes Jahr, daher habe ich Zeit, nach etwas zu suchen."

# game/scripts/c15/c15.rpy:599
translate german c15s001_DapDate_62428f0a:

    # dap "Mierda. Si fueran cuatro años, yo podría aportar mis ingresos en vez de generar gastos, pero en dos años..."
    dap "Verdammt. Wenn es vier Jahre wären, könnte ich mein Einkommen einbringen, anstatt Ausgaben zu verursachen, aber in zwei Jahren..."

# game/scripts/c15/c15.rpy:600
translate german c15s001_DapDate_a790315f:

    # mc "No es una noche para que te preocupes, cielo. Los dos primeros años estaremos bien, y después ya se verá. Pero no tendré problemas en encontrar trabajo en Newport o los alrededores."
    mc "Heute Abend brauchst du dir keine Sorgen zu machen, Schatz. Die ersten zwei Jahre kommen wir gut zurecht, und dann sehen wir weiter. Aber ich werde sicher keine Probleme haben, in oder um Newport einen Job zu finden."

# game/scripts/c15/c15.rpy:602
translate german c15s001_DapDate_36bb7a11:

    # "En ese momento llega Mathilda..."
    "In diesem Moment trifft Mathilda ein..."

# game/scripts/c15/c15.rpy:603
translate german c15s001_DapDate_2918b3d8:

    # "Mathilda" "¿Han disfrutado de la comida? ¿Puedo ofrecerles algún dulce?"
    "Mathilda" "Hat Ihnen das Essen geschmeckt? Darf ich Ihnen etwas Süßes anbieten?"

# game/scripts/c15/c15.rpy:604
translate german c15s001_DapDate_d2efded5:

    # mc "Estaba todo muy bueno, pero yo voy a tener que renunciar al postre."
    mc "Es war alles sehr gut, aber auf den Nachtisch muss ich verzichten."

# game/scripts/c15/c15.rpy:606
translate german c15s001_DapDate_46f7365e:

    # dap "Todo estaba exquisito, pero yo también voy a pasar. ¿Nos puede cargar la cuenta a la habitación?"
    dap "Es war alles sehr lecker, aber ich verzichte trotzdem darauf. Können Sie die Rechnung auf unser Zimmer buchen lassen?"

# game/scripts/c15/c15.rpy:607
translate german c15s001_DapDate_26666239:

    # mc "¿Qué habitación?"
    mc "Welches Zimmer?"

# game/scripts/c15/c15.rpy:609
translate german c15s001_DapDate_2419419d:

    # dap "¡Hush, [mc]!"
    dap "Pst, [mc]!"

# game/scripts/c15/c15.rpy:610
translate german c15s001_DapDate_3bb8e5d7:

    # dap "La habitación está a nombre de Marks, [dap] Marks."
    dap "Das Zimmer ist auf den Namen Marks, [dap] Marks, eingetragen."

# game/scripts/c15/c15.rpy:612
translate german c15s001_DapDate_d994c62a:

    # "Mathilda" "Sin ningún problema. No olviden recoger sus cosas de los vestuarios, por la mañana estarán cerrados. Los disfraces los pueden dejar en la habitación."
    "Mathilda" "Kein Problem. Denken Sie daran, Ihre Sachen aus den Umkleidekabinen zu holen; diese sind morgen früh geschlossen. Ihre Kostüme können Sie im Zimmer lassen."

# game/scripts/c15/c15.rpy:613
translate german c15s001_DapDate_eb5b17f9:

    # "Mathilda" "Esperamos verles de nuevo en nuestras instalaciones."
    "Mathilda" "Wir hoffen, Sie bald wieder in unseren Einrichtungen begrüßen zu dürfen."

# game/scripts/c15/c15.rpy:614
translate german c15s001_DapDate_ef11e901:

    # mc "Gracias, Mathilda. Creo que volveremos."
    mc "Danke, Mathilda. Ich denke, wir kommen wieder."

# game/scripts/c15/c15.rpy:616
translate german c15s001_DapDate_381c9caa:

    # dap "Es probable que volvamos. Ha sido una experiencia muy buena. Gracias, Mathilda."
    dap "Wir kommen bestimmt wieder. Es war ein tolles Erlebnis. Danke, Mathilda."

# game/scripts/c15/c15.rpy:618
translate german c15s001_DapDate_8594335b:

    # dap "¿Vamos?"
    dap "Aufleuchten?"

# game/scripts/c15/c15.rpy:619
translate german c15s001_DapDate_81d08733:

    # mc "¿Qué es eso de la habitación?"
    mc "Was ist das Besondere an diesem Zimmer?"

# game/scripts/c15/c15.rpy:620
translate german c15s001_DapDate_4fa2926c:

    # dap "Ya te he dicho que había varios restaurantes. El Black Crow es éste, el Pitch Raven es el de ciencia ficción, y el Nigrum Corvus es el de la era clásica, romanos, griegos, y esas cosas."
    dap "Ich hatte Ihnen ja bereits gesagt, dass es mehrere Restaurants gibt. Dies ist das Black Crow, das Pitch Raven ist das Science-Fiction-Restaurant und das Nigrum Corvus ist das Restaurant der Antike, Römer, Griechen und so weiter."

# game/scripts/c15/c15.rpy:621
translate german c15s001_DapDate_e7b6e193:

    # dap "Y después tienen la Red Crow Inn, con habitaciones temáticas. Tenemos una habitación medieval, aunque seguramente no se parezca en nada a como dormían entonces."
    dap "Und dann gibt es noch das Gasthaus „Zum Roten Raben“ mit seinen Themenzimmern. Wir haben ein mittelalterliches Zimmer, obwohl es wahrscheinlich nicht im Entferntesten dem entspricht, wie die Menschen damals geschlafen haben."

# game/scripts/c15/c15.rpy:622
translate german c15s001_DapDate_dd6716bd:

    # mc "Así que la otra reserva a nombre de \"otros\" Marks era tuya, ¿no?"
    mc "Die andere Reservierung auf den Namen „anderer“ Marks war also Ihre, richtig?"

# game/scripts/c15/c15.rpy:624
translate german c15s001_DapDate_d9aef484:

    # dap "Sí. Te hice reservar el restaurante por si querías meterte en la web y cambiar la época. La habitación la tenía elegida yo. Me parece más romántica la medieval que la de ciencia ficción."
    dap "Ja. Ich habe Sie das Restaurant reservieren lassen, falls Sie online den Zeitraum ändern möchten. Das Zimmer hatte ich bereits ausgesucht. Ich finde das mittelalterliche Zimmer romantischer als das Science-Fiction-Zimmer."

# game/scripts/c15/c15.rpy:625
translate german c15s001_DapDate_82d9a650:

    # mc "Me ha encantado el Black Crow, con lo que me alegro de no haberlo hecho. La próxima vez, podemos probar uno de los otros."
    mc "Ich fand den Black Crow super, deshalb bin ich froh, dass ich ihn nicht bestellt habe. Nächstes Mal können wir einen der anderen probieren."

# game/scripts/c15/c15.rpy:627
translate german c15s001_DapDate_42533991:

    # dap "Mejor no..."
    dap "Besser nicht..."

# game/scripts/c15/c15.rpy:628
translate german c15s001_DapDate_90696e73:

    # mc "¿Pasa algo, [dap]?"
    mc "Ist etwas nicht in Ordnung, [dap]?"

# game/scripts/c15/c15.rpy:629
translate german c15s001_DapDate_d46383ba:

    # dap "Si estamos mal de dinero, me conformo con que la próxima vez sea en un Burger Prince y durmamos en un motel. Si es contigo, me da lo mismo el sitio."
    dap "Wenn wir knapp bei Kasse sind, ist es mir recht, wenn wir nächstes Mal zu Burger Prince gehen und in einem Motel übernachten. Wenn du dabei bist, ist mir der Ort egal."

# game/scripts/c15/c15.rpy:630
translate german c15s001_DapDate_66412d2f:

    # mc "Es caro, ¿verdad?"
    mc "Das ist teuer, nicht wahr?"

# game/scripts/c15/c15.rpy:631
translate german c15s001_DapDate_32ccc251:

    # dap "Un poco, pero no te preocupes. La habitación ya está pagada. Solo me falta pagar la cena."
    dap "Ein bisschen, aber keine Sorge. Das Zimmer ist schon bezahlt. Ich muss nur noch das Abendessen bezahlen."

# game/scripts/c15/c15.rpy:632
translate german c15s001_DapDate_818816ed:

    # mc "¿De dónde has sacado el dinero, [dap]?"
    mc "Woher hast du das Geld, [dap]?"

# game/scripts/c15/c15.rpy:634
translate german c15s001_DapDate_36039b3d:

    # dap "Había estado ahorrando la paga para comprarme un nuevo portátil gaming. He invertido parte de ese dinero en la habitación y en la cena."
    dap "Ich hatte mein Taschengeld gespart, um mir einen neuen Gaming-Laptop zu kaufen. Einen Teil des Geldes habe ich für das Zimmer und das Abendessen ausgegeben."

# game/scripts/c15/c15.rpy:635
translate german c15s001_DapDate_03ebce68:

    # mc "De eso nada, cielo. No puedo hacer nada con la habitación, pero no voy a permitirte pagar la cena. Igual que tú no vas a permitirme devolverte el dinero de la habitación, ¿verdad?"
    mc "Auf keinen Fall, Schatz. Ich kann wegen des Zimmers nichts machen, aber ich lasse dich das Abendessen nicht bezahlen. Genauso wenig, wie du dir das Zimmer zurückerstatten lassen willst, oder?"

# game/scripts/c15/c15.rpy:637
translate german c15s001_DapDate_aa71adc3:

    # dap "¡Ni de coña! Ha sido elección mía y lo pago yo todo."
    dap "Auf keinen Fall! Es war meine Entscheidung und ich bezahle alles."

# game/scripts/c15/c15.rpy:638
translate german c15s001_DapDate_51cd79e3:

    # mc "Eso no va a pasar. La cena corre de mi cuenta. Tú has ahorrado para ese portátil y te lo mereces."
    mc "Das wird nicht passieren. Ich lade dich zum Essen ein. Du hast für den Laptop gespart und hast ihn dir verdient."

# game/scripts/c15/c15.rpy:640
translate german c15s001_DapDate_767f581f:

    # dap "Bueno, ya lo hablaremos mañana. Es el momento de ver la habitación."
    dap "Okay, wir reden morgen darüber. Jetzt ist es Zeit, sich das Zimmer anzusehen."

# game/scripts/c15/c15.rpy:641
translate german c15s001_DapDate_57d4b6c8:

    # mc "¡Vamos!"
    mc "Aufleuchten!"

# game/scripts/c15/c15.rpy:663
translate german c15s001_AmandaCall_76586480:

    # mc "¿Hola? ¿Quién es?"
    mc "Hallo? Wer ist da?"

# game/scripts/c15/c15.rpy:667
translate german c15s001_AmandaCall_09b3092f:

    # ama "Hola, [mc]. No quiero molestarte demasiado."
    ama "Hallo, [mc]. Ich möchte dich nicht zu sehr belästigen."

# game/scripts/c15/c15.rpy:668
translate german c15s001_AmandaCall_25bb6224:

    # mc "No molestas, Amanda. ¿Puedo ayudarte en algo?"
    mc "Du störst mich nicht, Amanda. Kann ich dir irgendwie helfen?"

# game/scripts/c15/c15.rpy:671
translate german c15s001_AmandaCall_2d2c711f:

    # ama "Me iba a acostar cuando he recibido una llamada y te tenía que avisar."
    ama "Ich wollte gerade ins Bett gehen, als ich einen Anruf bekam, und ich musste es dir unbedingt mitteilen."

# game/scripts/c15/c15.rpy:672
translate german c15s001_AmandaCall_1b04504d:

    # ama "Aaron, nuestro supervisor, llega mañana por la mañana y él querría reunirse con vosotros por la tarde para explicaros la situación."
    ama "Aaron, unser Vorgesetzter, trifft morgen früh ein und möchte sich am Nachmittag mit Ihnen treffen, um Ihnen die Situation zu erläutern."

# game/scripts/c15/c15.rpy:674
translate german c15s001_AmandaCall_88603816:

    # ama "Me acaban de despertar con una llamada y te tenía que avisar."
    ama "Ich bin gerade durch einen Anruf geweckt worden und musste dir Bescheid geben."

# game/scripts/c15/c15.rpy:675
translate german c15s001_AmandaCall_e6912b06:

    # ama "Aaron, nuestro supervisor, acaba de aterrizar y él querría reunirse con vosotros esta tarde para explicaros la situación."
    ama "Aaron, unser Vorgesetzter, ist soeben gelandet und möchte sich heute Nachmittag mit Ihnen treffen, um Ihnen die Situation zu erläutern."

# game/scripts/c15/c15.rpy:676
translate german c15s001_AmandaCall_1cb46252:

    # mc "¿Nosotros? ¿[mar], [nor], [emm], [eri], [dap] y yo?"
    mc "Wir? [mar], [nor], [emm], [eri], [dap] und ich?"

# game/scripts/c15/c15.rpy:678
translate german c15s001_AmandaCall_3e162582:

    # ama "De momento solo con [mar], [nor] y contigo. Eva y yo también vamos a estar ahí, y las chicas podrían flipar un poco."
    ama "Im Moment sind nur [mar], [nor] und du dabei. Eva und ich werden auch da sein, und die Mädchen könnten etwas ausflippen."

# game/scripts/c15/c15.rpy:679
translate german c15s001_AmandaCall_12d46e7b:

    # ama "Además, no es cosa nuestra decirles la verdad, sino de sus madres."
    ama "Außerdem ist es nicht unsere Aufgabe, ihnen die Wahrheit zu sagen, sondern die ihrer Mütter."

# game/scripts/c15/c15.rpy:681
translate german c15s001_AmandaCall_8f92426d:

    # ama "Y tuya."
    ama "Und deins."

# game/scripts/c15/c15.rpy:682
translate german c15s001_AmandaCall_c431475a:

    # mc "Lo entiendo. No me gusta ocultarles la verdad, pero hablaré con [mar] y con [nor]. ¿A qué hora os esperamos?"
    mc "Ich verstehe. Es tut mir leid, Ihnen die Wahrheit verheimlichen zu müssen, aber ich werde mit [mar] und [nor] sprechen. Wann können wir Sie erwarten?"

# game/scripts/c15/c15.rpy:684
translate german c15s001_AmandaCall_095f53d4:

    # ama "A las 1700. Aaron volará fuera del país por la noche."
    ama "Um 17:00 Uhr. Aaron fliegt heute Abend aus dem Land."

# game/scripts/c15/c15.rpy:685
translate german c15s001_AmandaCall_a022ff35:

    # mc "Intentaré que las chicas no estén en casa a esa hora. ¿Cuánto tiempo necesitáis que estén fuera?"
    mc "Ich werde versuchen, dafür zu sorgen, dass die Mädchen um diese Zeit nicht zu Hause sind. Wie lange sollen sie denn weg sein?"

# game/scripts/c15/c15.rpy:687
translate german c15s001_AmandaCall_90a0d55c:

    # ama "No más de una hora, supongo. Depende de las preguntas que tengáis. Por eso es mejor que sólo estéis [nor], [mar], y tú. Nada de Olivia o Betty."
    ama "Nicht länger als eine Stunde, schätze ich. Es kommt auf Ihre Fragen an. Deshalb ist es am besten, wenn nur Sie, [nor] und [mar] dabei sind. Keine Olivia oder Betty."

# game/scripts/c15/c15.rpy:688
translate german c15s001_AmandaCall_3fbaf73d:

    # mc "Van a querer estar. También sufrieron el... *Susurro* secuestro."
    mc "Sie werden dort sein wollen. Auch sie wurden entführt... *Flüstern*"

# game/scripts/c15/c15.rpy:690
translate german c15s001_AmandaCall_aa3f445e:

    # ama "Es posible que sea la última vez que nos veamos. Nuestra misión con vosotros ya está acabando."
    ama "Dies könnte das letzte Mal sein, dass wir uns sehen. Unsere gemeinsame Mission mit Ihnen neigt sich dem Ende zu."

# game/scripts/c15/c15.rpy:691
translate german c15s001_AmandaCall_14a8e762:

    # mc "¿Aaron se os va a llevar? ¿A alguna base de NTR?"
    mc "Wird Aaron dich mitnehmen? Zu irgendeiner NTR-Basis?"

# game/scripts/c15/c15.rpy:693
translate german c15s001_AmandaCall_4b11cc55:

    # ama "Aaron solo quiere hablar con vosotros de momento. El resto ya se verá."
    ama "Aaron möchte jetzt nur mit dir sprechen. Wir sehen dann weiter."

# game/scripts/c15/c15.rpy:694
translate german c15s001_AmandaCall_5493f95e:

    # ama "Por cierto, deberíais informar a [mar] de lo que pasó el lunes con Eric y los demás. Nos ahorraremos preguntas incómodas."
    ama "Übrigens solltest du [mar] erzählen, was am Montag mit Eric und den anderen passiert ist. Das erspart uns unangenehme Fragen."

# game/scripts/c15/c15.rpy:695
translate german c15s001_AmandaCall_f53c18eb:

    # mc "No te preocupes, hablaré con ella antes de que lleguéis."
    mc "Keine Sorge, ich werde mit ihr sprechen, bevor du ankommst."

# game/scripts/c15/c15.rpy:698
translate german c15s001_AmandaCall_9fe47f69:

    # ama "Perfecto. Entonces nos vemos mañana por la tarde. Feliz Navidad de nuevo, [mc]."
    ama "Perfekt. Dann sehen wir uns morgen Nachmittag. Nochmals frohe Weihnachten, [mc]."

# game/scripts/c15/c15.rpy:699
translate german c15s001_AmandaCall_4bb39419:

    # mc "Hasta mañana. No sé si es un poco tarde para seguir celebrando la Navidad, pero Feliz Navidad de nuevo, Amanda."
    mc "Wir sehen uns morgen. Ich weiß nicht, ob es schon etwas spät ist, noch Weihnachten zu feiern, aber nochmals frohe Weihnachten, Amanda."

# game/scripts/c15/c15.rpy:701
translate german c15s001_AmandaCall_a8d9df18:

    # ama "Perfecto. Entonces nos vemos esta tarde. A las 1700."
    ama "Perfekt. Dann sehen wir uns heute Nachmittag um 17:00 Uhr."

# game/scripts/c15/c15.rpy:702
translate german c15s001_AmandaCall_f2240889:

    # mc "Hasta luego, Amanda."
    mc "Auf Wiedersehen, Amanda."

# game/scripts/c15/c15.rpy:706
translate german c15s001_WakeUp_7ea49a16:

    # centered "{size=+20}{b}DÍA 17 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}TAG 17 – DONNERSTAG{/b}{/size}"

# game/scripts/c15/c15.rpy:708
translate german c15s001_WakeUp_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:709
translate german c15s001_WakeUp_0e03d86c:

    # "Suena el teléfono y te saca de tus sueños, si es que los has tenido. Despertarse tan de golpe ha hecho que olvides lo que estabas soñando."
    "Das Telefon klingelt und reißt dich aus deinen Träumen, falls du überhaupt geträumt hast. Durch das plötzliche Aufwachen hast du vergessen, wovon du geträumt hast."

# game/scripts/c15/c15.rpy:710
translate german c15s001_WakeUp_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Versteckte Nummer?)"

# game/scripts/c15/c15.rpy:714
translate german c15s001_WakeUp_032240cf:

    # "Cuando cuelgas te das cuenta de que has dormido hasta tarde. Casi no vale la pena bajar a desayunar."
    "Als du auflegst, merkst du, dass du verschlafen hast. Da lohnt es sich kaum noch, zum Frühstück runterzugehen."

# game/scripts/c15/c15.rpy:716
translate german c15s001_WakeUp_ff52f651:

    # "Decides jugar un rato a My Residence, El MC por fin lleva a Laura a una cita, aunque es ella la que elige restaurante."
    "Du beschließt, eine Weile My Residence zu spielen. Der Protagonist lädt Laura schließlich zu einem Date ein, obwohl sie das Restaurant aussucht."

# game/scripts/c15/c15.rpy:717
translate german c15s001_WakeUp_e049b78d:

    # "Como ella es fan de las novelas de fantasía, elige un restaurante temático medieval en el que pueden disfrazarse. Laura cada vez te recuerda más a [dap]."
    "Da sie ein Fan von Fantasy-Romanen ist, wählt sie ein Restaurant im mittelalterlichen Stil, wo man sich verkleiden kann. Laura erinnert immer mehr an [dap]."

# game/scripts/c15/c15.rpy:746
translate german c15s002_DapLewd_4d952482:

    # dap "¡Es fantástica! ¡Está muy bien hecha! Quizás algún detalle aquí y allí está fuera de lugar, pero por el resto está muy bien."
    dap "Es ist fantastisch! Es ist sehr gut verarbeitet! Vielleicht wirkt hier und da ein Detail etwas deplatziert, aber ansonsten ist es sehr gut."

# game/scripts/c15/c15.rpy:747
translate german c15s002_DapLewd_2a83610e:

    # dap "Después de encontrar patatas, maíz, y pimiento en el menú, no me voy a quejar. Esperaba algo más... turístico."
    dap "Nachdem ich Kartoffeln, Mais und Paprika auf der Speisekarte entdeckt habe, will ich mich nicht beschweren. Ich hatte etwas... Touristischeres erwartet."

# game/scripts/c15/c15.rpy:748
translate german c15s002_DapLewd_0d7a13a6:

    # mc "A mí me parece muy lograda. Parece sacada de una película."
    mc "Ich finde es sehr gut gemacht. Es sieht aus wie aus einem Film."

# game/scripts/c15/c15.rpy:750
translate german c15s002_DapLewd_2578fdd3:

    # dap "A eso me refiero. Está muy bien para una película, pero no para una recreación histórica. Las camas eran mucho más cortas, dormían semisentados, especialmente los nobles."
    dap "Genau das meine ich. Für einen Film mag das in Ordnung sein, aber nicht für eine historische Nachstellung. Die Betten waren viel kürzer, und die Menschen schliefen halb sitzend, insbesondere der Adel."

# game/scripts/c15/c15.rpy:751
translate german c15s002_DapLewd_ba1f57d4:

    # mc "[dap], es un hotel..."
    mc "[dap], es ist ein Hotel..."

# game/scripts/c15/c15.rpy:753
translate german c15s002_DapLewd_dfd551be:

    # dap "Técnicamente una posada."
    dap "Genau genommen ein Gasthaus."

# game/scripts/c15/c15.rpy:754
translate german c15s002_DapLewd_5305b9a4:

    # mc "Vale. Es una posada. No es la habitación de un castillo. Aquí la gente viene a pasárselo bien por una noche, no a hacer un análisis historiográfico de la habitación."
    mc "Okay. Es ist ein Gasthaus. Kein Schlosszimmer. Die Leute kommen hierher, um eine schöne Nacht zu verbringen, nicht um eine geschichtswissenschaftliche Analyse des Zimmers durchzuführen."

# game/scripts/c15/c15.rpy:755
translate german c15s002_DapLewd_ef59d060:

    # mc "Los castillos no tenían jacuzzi. Y además han tenido el detalle de llenárnoslo cuando han encendido las velas."
    mc "Die Schlösser hatten keine Whirlpools. Und sie hatten sogar die nette Geste, sie für uns zu füllen, als sie die Kerzen anzündeten."

# game/scripts/c15/c15.rpy:757
translate german c15s002_DapLewd_143f9960:

    # dap "Son velas de gas. Se encienden con el interruptor. Sería prohibitivamente caro tener velas de verdad, y un peligro de incendio para el hotel."
    dap "Es handelt sich um Gaskerzen. Sie werden mit einem Schalter eingeschaltet. Echte Kerzen wären viel zu teuer und stellten zudem eine Brandgefahr für das Hotel dar."

# game/scripts/c15/c15.rpy:758
translate german c15s002_DapLewd_d8765cd1:

    # mc "Posada. *Risa*"
    mc "Gasthaus. *Gelächter*"

# game/scripts/c15/c15.rpy:760
translate german c15s002_DapLewd_3eb39c24:

    # dap "Vale, un peligro para la posada. *Risa* ¿Vamos a los vestuarios a por nuestras cosas?"
    dap "Okay, eine Gefahr für das Gasthaus. *lacht* Sollen wir in die Umkleidekabinen gehen, um unsere Sachen zu holen?"

# game/scripts/c15/c15.rpy:761
translate german c15s002_DapLewd_cece4ff8:

    # mc "No. Todavía no."
    mc "Nein. Noch nicht."

# game/scripts/c15/c15.rpy:763
translate german c15s002_DapLewd_67385428:

    # dap "¿Por qué? Recuerda que nos han dicho que cierran los vestuarios por la noche."
    dap "Warum? Erinnern Sie sich: Uns wurde gesagt, dass die Umkleidekabinen nachts schließen."

# game/scripts/c15/c15.rpy:764
translate german c15s002_DapLewd_149bf3e2:

    # mc "Lo sé, pero quiero besar a mi princesa antes de cambiarnos de ropa."
    mc "Ich weiß, aber ich möchte meine Prinzessin küssen, bevor wir uns umziehen."

# game/scripts/c15/c15.rpy:771
translate german c15s002_DapLewd_7e79760b:

    # dap "*Risita nerviosa* Si es por eso... "
    dap "*Nervöses Kichern* Wenn das der Grund ist..."

# game/scripts/c15/c15.rpy:778
translate german c15s002_DapLewd_d77a5094:

    # "Vuestros labios se juntan en un largo beso. Vuestras lenguas se buscan en un juego que ambos conocéis bien."
    "Eure Lippen treffen sich in einem langen Kuss. Eure Zungen suchen einander in einem Spiel, das ihr beide gut kennt."

# game/scripts/c15/c15.rpy:779
translate german c15s002_DapLewd_bb58dea1:

    # "Pero hay algo que no funciona en ese beso. Algo que está fuera de lugar."
    "Aber irgendetwas stimmt mit diesem Kuss nicht. Irgendetwas ist fehl am Platz."

# game/scripts/c15/c15.rpy:781
translate german c15s002_DapLewd_658e87ca:

    # mc "[dap], ¿pasa algo?"
    mc "[dap], stimmt etwas nicht?"

# game/scripts/c15/c15.rpy:782
translate german c15s002_DapLewd_7fc06c09:

    # dap "Lo has notado, ¿verdad?"
    dap "Das ist Ihnen doch auch aufgefallen, nicht wahr?"

# game/scripts/c15/c15.rpy:783
translate german c15s002_DapLewd_6ca122a2:

    # mc "Sí, es la primera vez que no pones el alma en un beso. ¿Estás nerviosa?"
    mc "Ja, es ist das erste Mal, dass du nicht dein ganzes Herzblut in einen Kuss gelegt hast. Bist du nervös?"

# game/scripts/c15/c15.rpy:785
translate german c15s002_DapLewd_7462826d:

    # dap "Un poco... Estamos aquí... en la habitación de un hotel... posada... y sé que va a pasar. Sé que tiene que pasar.... pero parece demasiado real ahora mismo."
    dap "Ein bisschen... Wir sind hier... in einem Hotelzimmer... und ich weiß, es wird passieren. Ich weiß, es muss passieren... aber es fühlt sich gerade zu real an."

# game/scripts/c15/c15.rpy:786
translate german c15s002_DapLewd_36dd2d8e:

    # mc "[dap], no hace falta que hagamos nada si no quieres. O que vayamos más allá de donde hemos ido hasta ahora. Si crees que no estás preparada..."
    mc "[dap], wir müssen nichts tun, wenn du das nicht willst. Oder weiter gehen als bisher. Wenn du glaubst, dass du noch nicht bereit bist …"

# game/scripts/c15/c15.rpy:788
translate german c15s002_DapLewd_9cd26950:

    # dap "¿Qué? ¡No! Sí que estoy preparada, pero sé que no voy a estar a la altura de lo que esperas... tú has estado con otras chicas antes y para mí va a ser la primera vez..."
    dap "Was? Nein! Ja, ich bin bereit, aber ich weiß, dass ich deinen Erwartungen nicht gerecht werden kann... du warst schon mit anderen Mädchen zusammen, und es wird mein erstes Mal sein..."

# game/scripts/c15/c15.rpy:790
translate german c15s002_DapLewd_446b594a:

    # dap "Eileen, Saira, Scarlett... y vete a saber cuántas más..."
    dap "Eileen, Saira, Scarlett... und wer weiß, wie viele noch..."

# game/scripts/c15/c15.rpy:792
translate german c15s002_DapLewd_62902aed:

    # dap "Eileen, Saira... y vete a saber cuántas más..."
    dap "Eileen, Saira... und wer weiß, wie viele noch..."

# game/scripts/c15/c15.rpy:793
translate german c15s002_DapLewd_04d41722:

    # mc "¿Eso es importante para ti? ¿Que yo tenga más experiencia que tú?"
    mc "Ist Ihnen das wichtig? Dass ich mehr Erfahrung habe als Sie?"

# game/scripts/c15/c15.rpy:795
translate german c15s002_DapLewd_653eff4c:

    # dap "Un poco... Sé que es bueno, que no hay nadie en el mundo con el que quiera aprender más que contigo, pero sabes que odio no hacer las cosas bien..."
    dap "Ein bisschen... Ich weiß, es ist gut, dass ich von niemandem auf der Welt mehr lernen möchte als von dir, aber du weißt, ich hasse es, Dinge nicht richtig zu machen..."

# game/scripts/c15/c15.rpy:796
translate german c15s002_DapLewd_34ab93af:

    # mc "Te acuerdas de la primera lección de besos, ¿verdad?"
    mc "Du erinnerst dich doch noch an die erste Kussstunde, oder?"

# game/scripts/c15/c15.rpy:797
translate german c15s002_DapLewd_07faeb67:

    # dap "Sí..."
    dap "Ja..."

# game/scripts/c15/c15.rpy:798
translate german c15s002_DapLewd_d7d4c964:

    # mc "El primer beso, el que me diste tú, ¿cómo fue?"
    mc "Dein erster Kuss, der, den du mir gegeben hast, wie war der?"

# game/scripts/c15/c15.rpy:799
translate german c15s002_DapLewd_218be9bd:

    # dap "Patético... es a lo que me refiero..."
    dap "Erbärmlich... genau das meine ich..."

# game/scripts/c15/c15.rpy:800
translate german c15s002_DapLewd_b339f2cd:

    # mc "Y el segundo beso, un minuto después, ¿cómo fue?"
    mc "Und wie war der zweite Kuss, eine Minute später?"

# game/scripts/c15/c15.rpy:801
translate german c15s002_DapLewd_4db3bb0b:

    # dap "Alucinante... pero me gustaría que nuestra primera vez fuera igual de alucinante que nuestro segundo beso."
    dap "Unglaublich... aber ich wünschte, unser erstes Mal wäre genauso unglaublich gewesen wie unser zweiter Kuss."

# game/scripts/c15/c15.rpy:803
translate german c15s002_DapLewd_65e223b9:

    # mc "[dap], mírame."
    mc "[dap], schau mich an."

# game/scripts/c15/c15.rpy:805
translate german c15s002_DapLewd_c410f0bf:

    # mc "Lo va a ser. Voy a ir con todo el cuidado posible. Y estoy con la chica más lista del mundo, con lo que vas a aprender muy rápido."
    mc "Das wird schon. Ich werde so vorsichtig wie möglich sein. Und ich bin mit dem klügsten Mädchen der Welt zusammen, also wirst du sehr schnell lernen."

# game/scripts/c15/c15.rpy:806
translate german c15s002_DapLewd_06b00441:

    # dap "¿Estás seguro?"
    dap "Bist du sicher?"

# game/scripts/c15/c15.rpy:807
translate german c15s002_DapLewd_bcf4691e:

    # mc "Lo estoy."
    mc "Ich bin."

# game/scripts/c15/c15.rpy:809
translate german c15s002_DapLewd_38d0a293:

    # dap "¡Entonces vamos a por nuestras cosas!"
    dap "Dann lasst uns unsere Sachen holen!"

# game/scripts/c15/c15.rpy:810
translate german c15s002_DapLewd_de22a26b:

    # mc "No, todavía no. Quiero un beso de verdad y antes de irnos."
    mc "Nein, noch nicht. Ich möchte einen richtigen Kuss, und zwar bevor wir gehen."

# game/scripts/c15/c15.rpy:813
translate german c15s002_DapLewd_22224e6d:

    # dap "Ven aquí, mi caballero. Ojalá fuera tan valiente como tú."
    dap "Komm her, mein Ritter. Ich wünschte, ich wäre so mutig wie du."

# game/scripts/c15/c15.rpy:816
translate german c15s002_DapLewd_12e9fd52:

    # dap "Ven aquí, mi príncipe. El rey de mis sueños."
    dap "Komm her, mein Prinz. Der König meiner Träume."

# game/scripts/c15/c15.rpy:819
translate german c15s002_DapLewd_f1bd8009:

    # dap "Ven aquí, mi pícaro. El que ha robado mi corazón."
    dap "Komm her, mein Schlingel. Derjenige, der mein Herz gestohlen hat."

# game/scripts/c15/c15.rpy:826
translate german c15s002_DapLewd_81d03db8:

    # "Vuestros labios se vuelven a juntar otra vez. Esta vez con menos dudas, con más pasión. Con más alma."
    "Eure Lippen berühren sich wieder. Diesmal mit weniger Zweifel, mit mehr Leidenschaft. Mit mehr Gefühl."

# game/scripts/c15/c15.rpy:828
translate german c15s002_DapLewd_426df223:

    # mc "Ahora sí. Ahora podemos ir a por nuestras cosas."
    mc "Jetzt können wir unsere Sachen holen."

# game/scripts/c15/c15.rpy:829
translate german c15s002_DapLewd_1782f23b:

    # dap "Te libras por eso. En mitad del beso he tenido unas ganas enormes de tirarte en la cama y empezar a desnudarte..."
    dap "Dafür bist du aus dem Schneider. Mitten im Kuss hatte ich plötzlich den unbändigen Drang, dich aufs Bett zu werfen und dich auszuziehen..."

# game/scripts/c15/c15.rpy:830
translate german c15s002_DapLewd_f16d26cf:

    # mc "*Risa* Habrá tiempo para eso, no te preocupes."
    mc "*Lacht* Dafür wird es noch Zeit geben, keine Sorge."

# game/scripts/c15/c15.rpy:832
translate german c15s002_DapLewd_a729cf64:

    # dap "Vamos. Espérame en el jacuzzi cuando vengas. Yo voy a tardar un poco más que tú."
    dap "Komm schon. Warte im Whirlpool auf mich, wenn du kommst. Ich brauche etwas länger als du."

# game/scripts/c15/c15.rpy:833
translate german c15s002_DapLewd_994bc3cb:

    # mc "¿Alguna sorpresa más para mí?"
    mc "Gibt es noch weitere Überraschungen für mich?"

# game/scripts/c15/c15.rpy:834
translate german c15s002_DapLewd_4f46bfc6:

    # dap "No, no es ninguna sorpresa. Tan solo algo que quiero hacer. Tendrás que verlo cuando vuelva."
    dap "Nein, das ist keine Überraschung. Ich möchte das einfach mal machen. Du wirst es sehen müssen, wenn ich zurück bin."

# game/scripts/c15/c15.rpy:835
translate german c15s002_DapLewd_dd819fac:

    # mc "Entonces vamos."
    mc "Dann los!"

# game/scripts/c15/c15.rpy:837
translate german c15s002_DapLewd_d6379b30:

    # dap "Déjame las llaves del coche. Tengo que coger una cosa que me he dejado."
    dap "Gib mir die Autoschlüssel. Ich muss etwas holen, das ich hier vergessen habe."

# game/scripts/c15/c15.rpy:838
translate german c15s002_DapLewd_ff0f72cd:

    # mc "¿El qué?"
    mc "Die Tatsache, dass?"

# game/scripts/c15/c15.rpy:839
translate german c15s002_DapLewd_aaf3c8ef:

    # dap "Esta vez sí. Sorpresa..."
    dap "Diesmal ja. Überraschung..."

# game/scripts/c15/c15.rpy:840
translate german c15s002_DapLewd_16f073ff:

    # mc "De momento me están encantando todas las sorpresas de la noche. Ahora te las doy en el vestuario."
    mc "Bis jetzt gefallen mir all die Überraschungen des Abends sehr. Ich erzähle dir davon in der Garderobe."

# game/scripts/c15/c15.rpy:842
translate german c15s002_DapLewd_10ab9d4f:

    # "Vas a buscar tus cosas al vestuario y vuelves a la habitación. La idea de [dap] de empezar en el jacuzzi parece prometedora."
    "Sie gehen in die Umkleidekabine, um Ihre Sachen zu holen, und kehren dann in Ihr Zimmer zurück. Die Idee, den Tag im Whirlpool zu beginnen, klingt vielversprechend."

# game/scripts/c15/c15.rpy:844
translate german c15s002_DapLewd_6b9fcfdf:

    # mcp "(Esto es fantástico... Hay que usar más el jacuzzi de casa de [nor].)"
    mcp "(Das ist fantastisch... Wir müssen den Whirlpool bei [nor] öfter benutzen.)"

# game/scripts/c15/c15.rpy:845
translate german c15s002_DapLewd_39f5e12d:

    # "Pasa un rato antes de que [dap] vuelva de los vestuarios."
    "Es vergeht eine Weile, bis [dap] aus der Umkleidekabine zurückkehrt."

# game/scripts/c15/c15.rpy:847
translate german c15s002_DapLewd_72f4b510:

    # dap "Hola, cielo, ya estoy aquí. ¿Qué tal el jacuzzi? Pareces salido de \"The Warlock\" ahora mismo."
    dap "Hallo Schatz, ich bin da. Wie ist der Whirlpool? Du siehst gerade aus, als wärst du direkt aus „The Warlock“ entsprungen."

# game/scripts/c15/c15.rpy:848
translate german c15s002_DapLewd_7adfc410:

    # mc "¡El jacuzzi está genial! ¿Qué le ha pasado a tu pelo? ¿Qué le ha pasado a tu peinado medieval?"
    mc "Der Whirlpool ist toll! Was ist denn mit deinen Haaren passiert? Was ist aus deiner mittelalterlichen Frisur geworden?"

# game/scripts/c15/c15.rpy:850
translate german c15s002_DapLewd_ab909b1d:

    # dap "¿No te gusta mi trenza?"
    dap "Gefällt dir mein Zopf nicht?"

# game/scripts/c15/c15.rpy:851
translate german c15s002_DapLewd_0de9d437:

    # mc "Me encanta, eres más tú."
    mc "Ich liebe es, es passt besser zu dir."

# game/scripts/c15/c15.rpy:853
translate german c15s002_DapLewd_c398f5dc:

    # dap "Esa es una de las razones por las que me lo he cambiado... quiero recordar mi primera vez siendo yo misma, no una [dap] disfrazada."
    dap "Das ist einer der Gründe, warum ich es geändert habe... Ich möchte mich daran erinnern, wie ich zum ersten Mal ich selbst war, nicht ein [dap] in Verkleidung."

# game/scripts/c15/c15.rpy:854
translate german c15s002_DapLewd_b83b19f0:

    # mc "Me parece una razón increíblemente buena. De todas formas, me gustas más así. Así eres tú."
    mc "Das ist ein unglaublich guter Grund. Mir gefällt du so sowieso besser. So bist du eben."

# game/scripts/c15/c15.rpy:855
translate german c15s002_DapLewd_24c7b021:

    # mc "¿Y las otras razones?"
    mc "Und die anderen Gründe?"

# game/scripts/c15/c15.rpy:857
translate german c15s002_DapLewd_b63ff641:

    # dap "No quería sacarte un ojo con los anillos de la trenza. *Risa*"
    dap "Ich wollte dir mit den Ringen im Zopf nicht ins Auge stechen. *lacht*"

# game/scripts/c15/c15.rpy:858
translate german c15s002_DapLewd_35cdc994:

    # mc "Esa es una razón aún mejor. *Risa*"
    mc "Das ist ein noch besserer Grund. *lacht*"

# game/scripts/c15/c15.rpy:859
translate german c15s002_DapLewd_93a5152c:

    # mc "¿Vienes?"
    mc "Kommst du?"

# game/scripts/c15/c15.rpy:861
translate german c15s002_DapLewd_2fbd52fb:

    # dap "Dame un segundo que me quite el vestido y voy... ahora es cuando viene la sorpresa..."
    dap "Einen Moment bitte, ich ziehe schnell mein Kleid aus, dann bin ich weg... und jetzt kommt die Überraschung..."

# game/scripts/c15/c15.rpy:862
translate german c15s002_DapLewd_5e7fbc14:

    # mc "¿Necesitas ayuda para quitártelo?"
    mc "Benötigen Sie Hilfe beim Entfernen?"

# game/scripts/c15/c15.rpy:863
translate german c15s002_DapLewd_17aeab5f:

    # dap "No, tranquilo. Además, si vinieras... no ibas a volver al jacuzzi una vez me desnudara."
    dap "Nein, keine Sorge. Außerdem, wenn du gekommen wärst... würdest du ja nicht mehr in den Whirlpool zurückkommen, sobald ich mich ausgezogen habe."

# game/scripts/c15/c15.rpy:865
translate german c15s002_DapLewd_c24cb8ab:

    # mc "Entonces te espero aquí."
    mc "Dann warte ich hier auf dich."

# game/scripts/c15/c15.rpy:868
translate german c15s002_DapLewd_7e7c3389:

    # mc "¿Te vas a dejar puesta la joyería?"
    mc "Wirst du deinen Schmuck anbehalten?"

# game/scripts/c15/c15.rpy:869
translate german c15s002_DapLewd_bacb23b7:

    # dap "Pensaba quitármela. No sé si le va a ir bien mojarse en el jacuzzi."
    dap "Ich hatte überlegt, es abzunehmen. Ich weiß nicht, ob es in Ordnung ist, wenn es im Whirlpool nass wird."

# game/scripts/c15/c15.rpy:870
translate german c15s002_DapLewd_9fe04145:

    # mc "Yo creo que no le va a pasar nada. Seguramente sea bisutería de todas formas. No te van a dejar piedras preciosas para un disfraz."
    mc "Ich glaube nicht, dass ihr etwas passieren wird. Es ist wahrscheinlich sowieso nur Modeschmuck. Man leiht einem ja keine Edelsteine für ein Kostüm."

# game/scripts/c15/c15.rpy:871
translate german c15s002_DapLewd_0135a9f5:

    # dap "Entonces sí que me la dejaré, si te gustan."
    dap "Dann behalte ich es, wenn es dir gefällt."

# game/scripts/c15/c15.rpy:872
translate german c15s002_DapLewd_d08359b9:

    # mc "Se está muy solo aquí. ¿Te falta mucho o tengo que ir a buscarte? *Risa*"
    mc "Es ist so einsam hier. Bist du bald da, oder muss ich dich abholen? *lacht*"

# game/scripts/c15/c15.rpy:873
