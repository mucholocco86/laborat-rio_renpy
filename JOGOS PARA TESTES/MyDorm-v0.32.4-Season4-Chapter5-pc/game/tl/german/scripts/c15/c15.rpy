translate german c15s005_MeemawDiscussion_51c9f87c:

    # kia "Espera... ¿No lo sabíais? Me parece que he metido la pata..."
    kia "Moment mal... Wusstest du das nicht? Ich glaube, ich habe ins Fettnäpfchen getreten..."

# game/scripts/c15/c15.rpy:2565
translate german c15s005_MeemawDiscussion_85bb0f69:

    # nor "¿Qué? ¿También está con Eileen?"
    nor "Was? Ist er auch mit Eileen zusammen?"

# game/scripts/c15/c15.rpy:2567
translate german c15s005_MeemawDiscussion_c29abf3e:

    # kia "Espera... ¿No lo sabías? Me parece que he metido la pata..."
    kia "Moment mal... Das wusstest du nicht? Ich glaube, ich habe ins Fettnäpfchen getreten..."

# game/scripts/c15/c15.rpy:2570
translate german c15s005_MeemawDiscussion_7acf9c20:

    # mom "¿Qué? ¿También está con Eileen?"
    mom "Was? Ist er auch mit Eileen zusammen?"

# game/scripts/c15/c15.rpy:2572
translate german c15s005_MeemawDiscussion_c29abf3e_1:

    # kia "Espera... ¿No lo sabías? Me parece que he metido la pata..."
    kia "Moment mal... Das wusstest du nicht? Ich glaube, ich habe ins Fettnäpfchen getreten..."

# game/scripts/c15/c15.rpy:2573
translate german c15s005_MeemawDiscussion_086de174:

    # mc "No pasa nada, Kiara. Eileen me autorizó a hacerlo público si lo consideraba necesario, y estaba esperando el momento adecuado... continúa, Kiara, por favor."
    mc "Schon gut, Kiara. Eileen hat mir die Erlaubnis gegeben, es öffentlich zu machen, wenn ich es für nötig halte, und ich habe auf den richtigen Moment gewartet... bitte fahre fort, Kiara."

# game/scripts/c15/c15.rpy:2576
translate german c15s005_MeemawDiscussion_591ab8f2:

    # nor "No pasa nada, pero..." (multiple=2)
    nor "Das ist schon okay, aber..." (multiple=2)

# game/scripts/c15/c15.rpy:2577
translate german c15s005_MeemawDiscussion_4f99f261:

    # mom "Vamos a tener que hablar de esto." (multiple=2)
    mom "Wir müssen darüber reden." (multiple=2)

# game/scripts/c15/c15.rpy:2580
translate german c15s005_MeemawDiscussion_a208423d:

    # nor "No pasa nada, pero tú y yo vamos a tener que hablar de esto."
    nor "Das ist schon okay, aber wir beide müssen darüber reden."

# game/scripts/c15/c15.rpy:2583
translate german c15s005_MeemawDiscussion_30707794:

    # mom "No pasa nada, pero tú y yo vamos a tener que hablar de esto."
    mom "Das ist schon okay, aber wir beide müssen darüber reden."

# game/scripts/c15/c15.rpy:2585
translate german c15s005_MeemawDiscussion_316cb967:

    # kia "Lo que quería decir es que no me podía imaginar que estabas con miembros de tu familia también..."
    kia "Ich meinte damit, dass ich mir nicht vorstellen konnte, dass Sie auch mit Familienmitgliedern zusammen waren..."

# game/scripts/c15/c15.rpy:2588
translate german c15s005_MeemawDiscussion_43de86a3:

    # kia "Lo siguiente es que, nunca me hubiera podido imaginar que salieras con miembros de tu propia familia..."
    kia "Und dann wäre da noch die Sache, die ich mir nie hätte vorstellen können: dass du mit Mitgliedern deiner eigenen Familie ausgehst..."

# game/scripts/c15/c15.rpy:2589
translate german c15s005_MeemawDiscussion_21273e99:

    # kia "¿Sorprendente e inesperado? Sí. Pero si estamos en una sociedad donde la gente se casa con sus almohadas o se enamora de personajes de dibujos animados, ya nada me parece raro..."
    kia "Überraschend und unerwartet? Ja. Aber wenn wir in einer Gesellschaft leben, in der Menschen ihre Kissen heiraten oder sich in Zeichentrickfiguren verlieben, erscheint mir nichts mehr seltsam..."

# game/scripts/c15/c15.rpy:2590
translate german c15s005_MeemawDiscussion_9310e15c:

    # mc "Kiara, no es lo mismo..."
    mc "Kiara, es ist nicht dasselbe..."

# game/scripts/c15/c15.rpy:2592
translate german c15s005_MeemawDiscussion_229d76f0:

    # kia "Lo sé... a lo que me refiero es a que si eso se empieza a ver normal... ¿por qué no vuestra relación?"
    kia "Ich weiß... was ich meine ist, wenn das als normal angesehen wird... warum nicht auch eure Beziehung?"

# game/scripts/c15/c15.rpy:2593
translate german c15s005_MeemawDiscussion_b2439eb8:

    # mc "Ah, OK. No te había entendido."
    mc "Ah, okay. Ich habe dich nicht verstanden."

# game/scripts/c15/c15.rpy:2595
translate german c15s005_MeemawDiscussion_755eae6b:

    # kia "En esta familia se respira amor... un amor diferente del que he conocido en cualquier otra familia."
    kia "In dieser Familie liegt Liebe in der Luft... eine ganz andere Art von Liebe, als ich sie je in irgendeiner anderen Familie erlebt habe."

# game/scripts/c15/c15.rpy:2596
translate german c15s005_MeemawDiscussion_3ab4e439:

    # kia "No sé... no me extraña que el siguiente paso sea que se creen parejas... lo veo casi normal."
    kia "Ich weiß nicht... es überrascht mich nicht, dass der nächste Schritt die Bildung von Paarbeziehungen ist... ich sehe das als fast normal an."

# game/scripts/c15/c15.rpy:2598
translate german c15s005_MeemawDiscussion_c4e98c0f:

    # mee "¿Pero tú estás loca? ¿Estás diciendo que verías normal que [mc] saliera con su hermana? ¿O con mi hermana para el caso?"
    mee "Bist du verrückt? Willst du etwa sagen, du fändest es normal, wenn [mc] mit seiner Schwester ausginge? Oder mit meiner Schwester, um genau zu sein?"

# game/scripts/c15/c15.rpy:2599
translate german c15s005_MeemawDiscussion_1d5aa3c9:

    # mee "¡Que nos queramos no significa que tengamos que montar una orgía de todos revueltos, joder!"
    mee "Nur weil wir uns lieben, heißt das verdammt nochmal nicht, dass wir eine ausgewachsene Orgie veranstalten müssen!"

# game/scripts/c15/c15.rpy:2600
translate german c15s005_MeemawDiscussion_2b7554d7:

    # mc "Meemaw, creo que no se refiere a eso..."
    mc "Meemaw, ich glaube nicht, dass er das so gemeint hat..."

# game/scripts/c15/c15.rpy:2602
translate german c15s005_MeemawDiscussion_34fd887b:

    # kia "No me refiero a eso, pero no ando muy lejos... Leí sobre una tribu donde la gente se casa con familiares directos. Obviamente, sin nuestra medicina, tienen todos los problemas de la endogamia..."
    kia "Ich meine das nicht, aber es kommt dem schon recht nahe… Ich habe von einem Stamm gelesen, in dem die Menschen enge Verwandte heiraten. Ohne unsere Medizin hätten sie natürlich alle Probleme der Inzucht…"

# game/scripts/c15/c15.rpy:2603
translate german c15s005_MeemawDiscussion_6e3ef5bb:

    # kia "Pero si ellos lo pueden hacer, ¿por qué no vosotros? Aquí tienen acceso a medicina moderna..."
    kia "Aber wenn die es können, warum nicht auch Sie? Hier haben Sie Zugang zu moderner Medizin..."

# game/scripts/c15/c15.rpy:2604
translate german c15s005_MeemawDiscussion_142689c5:

    # mc "¿Ves, Meemaw? Y te lo está diciendo, posiblemente, la persona de la casa que más ha leído, con permiso de [dap] y Scarlett."
    mc "Siehst du, Meemaw? Und das wird dir von der Person im Haus erzählt, die möglicherweise am meisten gelesen hat, mit der Erlaubnis von [dap] und Scarlett."

# game/scripts/c15/c15.rpy:2606
translate german c15s005_MeemawDiscussion_121b9dd6:

    # mee "¿Estáis todos locos? ¿Qué será lo siguiente? ¿Vas a empezar a tirarle los trastos a tu hermana? ¿A tus primas? ¿A Betty?"
    mee "Seid ihr alle verrückt? Was kommt als Nächstes? Fangt ihr jetzt an, eure Schwester anzubaggern? Eure Cousinen? Betty?"

# game/scripts/c15/c15.rpy:2608
translate german c15s005_MeemawDiscussion_ec8349cd:

    # mc "No es eso y lo sabes, Meemaw."
    mc "Das ist es nicht, und das weißt du auch, Meemaw."

# game/scripts/c15/c15.rpy:2611
translate german c15s005_MeemawDiscussion_c1b9b198:

    # bet "Olivia Lena Pitt. ¿Tú sabes cuál es mi mayor hobby?"
    bet "Olivia Lena Pitt. Wissen Sie, was mein größtes Hobby ist?"

# game/scripts/c15/c15.rpy:2613
translate german c15s005_MeemawDiscussion_85e390f5:

    # mee "¡Zampar! Pero no veo qué tiene que ver eso con todo esto."
    mee "Sich den Bauch vollzuschlagen! Aber ich verstehe nicht, was das damit zu tun hat."

# game/scripts/c15/c15.rpy:2615
translate german c15s005_MeemawDiscussion_31dc5b33:

    # bet "No, ese es el segundo mayor. Mi mayor hobby es y siempre ha sido tocarte los huevos."
    bet "Nein, das ist das zweitgrößte. Mein größtes Hobby ist und war schon immer, dich zu ärgern."

# game/scripts/c15/c15.rpy:2617
translate german c15s005_MeemawDiscussion_d0b59685:

    # bet "¿Me puedo unir a los saludos con besos, [mc]?"
    bet "Darf ich mich den Küsschengrüßen anschließen, [mc]?"

# game/scripts/c15/c15.rpy:2621
translate german c15s005_MeemawDiscussion_51ad8de0:

    # bet "Bueno, contigo no tiene mucho mérito sabiendo que salís juntos..."
    bet "Nun ja, für dich ist es keine große Leistung, da du ja in einer Beziehung bist..."

# game/scripts/c15/c15.rpy:2623
translate german c15s005_MeemawDiscussion_34757dc9:

    # eil "¿Qué?"
    eil "Das?"

# game/scripts/c15/c15.rpy:2624
translate german c15s005_MeemawDiscussion_7bdc1140:

    # mc "A tu madre se le ha escapado..."
    mc "Deine Mutter hat es versehentlich verraten..."

# game/scripts/c15/c15.rpy:2626
translate german c15s005_MeemawDiscussion_bfcaaf8a:

    # eil "¡Mamaaaa!"
    eil "Mama!"

# game/scripts/c15/c15.rpy:2628
translate german c15s005_MeemawDiscussion_51b2e441:

    # kia "Perdón... creía que..."
    kia "Entschuldigung... ich dachte, dass..."

# game/scripts/c15/c15.rpy:2629
translate german c15s005_MeemawDiscussion_c8928e2b:

    # mc "Ya te he dicho que no pasa nada..."
    mc "Ich habe dir doch schon gesagt, dass alles in Ordnung ist..."

# game/scripts/c15/c15.rpy:2632
translate german c15s005_MeemawDiscussion_5a8defe8_1:

    # kia "¿Puedo hablar contigo un momento?"
    kia "Kann ich Sie kurz sprechen?"

# game/scripts/c15/c15.rpy:2633
translate german c15s005_MeemawDiscussion_651048c0_1:

    # mc "Sí, claro."
    mc "Ja natürlich."

# game/scripts/c15/c15.rpy:2635
translate german c15s005_MeemawDiscussion_dd303cd1:

    # kia "*Susurrando* Me ha dicho Eileen que necesitabais la casa vacía, y me he ofrecido a enseñarles a Kate y Kim a la biblioteca municipal, pero necesitaré un coche."
    kia "*flüsternd* Eileen sagte mir, dass du das Haus leer haben musst, und ich habe angeboten, Kate und Kim zur Stadtbibliothek zu begleiten, aber ich brauche ein Auto."

# game/scripts/c15/c15.rpy:2636
translate german c15s005_MeemawDiscussion_1e9f4983_1:

    # mc "Gracias, Kiara. Puedes coger el de mi madre. El de [nor] no es muy fiable. Acompáñame a casa y te doy las llaves, y así me cambio de ropa."
    mc "Danke, Kiara. Du kannst das Auto meiner Mutter nehmen. Das von [nor] ist nicht sehr zuverlässig. Komm mit mir nach Hause, dann gebe ich dir die Schlüssel und kann mich umziehen."

# game/scripts/c15/c15.rpy:2638
translate german c15s005_MeemawDiscussion_9af73762:

    # nor "¡Hey, os estoy oyendo! Mi coche es muy fiable. Te puedes fiar de que se va a estropear en el momento menos adecuado. *Risa*"
    nor "Hey, ich kann dich hören! Mein Auto ist sehr zuverlässig. Du kannst sicher sein, dass es im ungünstigsten Moment kaputtgeht. *lacht*"

# game/scripts/c15/c15.rpy:2639
translate german c15s005_MeemawDiscussion_d86804a1:

    # mc "Por eso es mejor que se lleve el coche de Mamá. *Risa*"
    mc "Deshalb ist es besser, wenn er Mamas Auto nimmt. *Gelächter*"

# game/scripts/c15/c15.rpy:2640
translate german c15s005_MeemawDiscussion_2fb31299:

    # mc "Voy a darle las llaves a Kiara y a cambiarme. Ahora vuelvo."
    mc "Ich gebe Kiara die Schlüssel und ziehe mich um. Ich bin gleich wieder da."

# game/scripts/c15/c15.rpy:2643
translate german c15s005_MeemawDiscussion_4c135b68:

    # "Acompañas a Kiara a casa y le entregas las llaves."
    "Du begleitest Kiara nach Hause und gibst ihr die Schlüssel."

# game/scripts/c15/c15.rpy:2645
translate german c15s005_MeemawDiscussion_ded38673:

    # "Decidís, tácitamente, no comentar nada sobre lo que acaba de pasar en la cocina."
    "Sie beschließen stillschweigend, das Geschehene in der Küche nicht zu kommentieren."

# game/scripts/c15/c15.rpy:2646
translate german c15s005_MeemawDiscussion_e80a28e1:

    # "Se despide de ti con otro beso, esta vez sin agresividad, tan solo un beso de despedida. Ya no tiene que demostrar nada a nadie."
    "Er verabschiedet sich mit einem weiteren Kuss, diesmal ohne Aggression, nur ein Abschiedskuss. Er muss niemandem mehr etwas beweisen."

# game/scripts/c15/c15.rpy:2647
translate german c15s005_MeemawDiscussion_e988c970:

    # "Después pasas por tu habitación a darte una ducha y ponerte un traje."
    "Dann gehst du auf dein Zimmer, um zu duschen und einen Anzug anzuziehen."

# game/scripts/c15/c15.rpy:2650
translate german c15s005_kisses_9cfbab6a:

    # mc "¿Qué? Sí... bueno... pero... eso ya había acabado... era por un reto en un juego y duró solo una semana."
    mc "Was? Ja... nun ja... aber... das war doch schon vorbei... es war eine Herausforderung in einem Spiel und hat nur eine Woche gedauert."

# game/scripts/c15/c15.rpy:2652
translate german c15s005_kisses_5309a579:

    # bet "Pues te reto a que lo reanudes. Y ya sé que el juego no funciona así. Pero te reto."
    bet "Nun, ich fordere dich heraus, es fortzusetzen. Und ich weiß, dass das Spiel nicht so funktioniert. Aber ich fordere dich trotzdem heraus."

# game/scripts/c15/c15.rpy:2653
translate german c15s005_kisses_75ad14fd:

    # bet "Si besas a toda la familia como saludo, mi retrógrada hermana no podrá escandalizarse... demasiado... si te ve besar a [eri], a [dap] o a [emm]... o a cualquier otra chica de la familia."
    bet "Wenn du zur Begrüßung die ganze Familie küsst, wird meine etwas eigenwillige Schwester nicht allzu sehr schockiert sein, wenn sie dich [eri], [dap] oder [emm] oder irgendein anderes Mädchen in der Familie küssen sieht."

# game/scripts/c15/c15.rpy:2654
translate german c15s005_kisses_bfcf5355:

    # bet "¿Aceptas el reto?"
    bet "Nimmst du die Herausforderung an?"

# game/scripts/c15/c15.rpy:2655
translate german c15s005_kisses_f7744f06:

    # mc "¡Por supuesto!"
    mc "Natürlich!"

# game/scripts/c15/c15.rpy:2657
translate german c15s005_kisses_5d19825a:

    # mee "¿Habéis perdido la cordura?"
    mee "Habt ihr den Verstand verloren?"

# game/scripts/c15/c15.rpy:2659
translate german c15s005_kisses_8387ef50:

    # bet "No le hagas caso. Tiene la tensión baja, con lo que no le va a dar un jamacuco."
    bet "Ignoriere ihn einfach. Er hat niedrigen Blutdruck, also wird er keinen Herzinfarkt bekommen."

# game/scripts/c15/c15.rpy:2660
translate german c15s005_kisses_8d61b0ee:

    # bet "Pues puedes empezar conmigo... si quieres..."
    bet "Nun, Sie können mit mir anfangen... wenn Sie möchten..."

# game/scripts/c15/c15.rpy:2662
translate german c15s005_kisses_3783c075:

    # "Vuestros labios se juntan en un breve beso que tiene mucho de cariño, un poco de pillería, y nada de pasión."
    "Eure Lippen berühren sich zu einem kurzen Kuss, der viel Zuneigung, ein wenig Schalk und keinerlei Leidenschaft in sich birgt."

# game/scripts/c15/c15.rpy:2663
translate german c15s005_kisses_6dabed0a:

    # bet "Gracias, [mc]. Creo que le podría pillar el gusto a esto..."
    bet "Danke, [mc]. Ich glaube, das könnte mir gefallen..."

# game/scripts/c15/c15.rpy:2665
translate german c15s005_kisses_1fca8d8a:

    # mee "¡Eres una jodida monja! ¡No deberías poder hacer eso!"
    mee "Du bist verdammt nochmal eine Nonne! Das solltest du nicht dürfen!"

# game/scripts/c15/c15.rpy:2667
translate german c15s005_kisses_8cad4051:

    # nor "No le hagas ni caso. Yo también me apunto."
    nor "Beachte ihn nicht. Ich bin auch dabei."

# game/scripts/c15/c15.rpy:2668
translate german c15s005_kisses_5b84328b:

    # mee "Pero... pero..."
    mee "Aber... aber..."

# game/scripts/c15/c15.rpy:2670
translate german c15s005_kisses_0581dfce:

    # mom "Y yo."
    mom "Ich auch."

# game/scripts/c15/c15.rpy:2671
translate german c15s005_kisses_81a58c12:

    # mee "¿Vais a parar de una vez con las tonterías?"
    mee "Hörst du jetzt endlich mit diesem Unsinn auf?"

# game/scripts/c15/c15.rpy:2673
translate german c15s005_kisses_49431722:

    # bet "¿Ya estás contenta? ¿No eres capaz de ver que cada vez que te pones cabezona acabas perdiendo? Acuérdate de la conversación de la desnudez."
    bet "Bist du jetzt zufrieden? Siehst du denn nicht, dass du jedes Mal verlierst, wenn du stur bist? Denk an das Gespräch über Nacktheit."

# game/scripts/c15/c15.rpy:2674
translate german c15s005_kisses_75f486ac:

    # bet "Cuando esta familia se une no hay nada que no podamos conseguir, y sacarte de quicio es una de las cosas que a mí, personalmente, me encanta hacer."
    bet "Wenn diese Familie zusammenhält, ist nichts unerreichbar, und dich in den Wahnsinn zu treiben, ist eine der Dinge, die ich persönlich sehr gerne tue."

# game/scripts/c15/c15.rpy:2676
translate german c15s005_kisses_ac1eabf4:

    # "En ese momento aparece Eileen en la cocina."
    "In diesem Moment erscheint Eileen in der Küche."

# game/scripts/c15/c15.rpy:2677
translate german c15s005_kisses_3f1d6d9e:

    # eil "Ya he hablado con Alexia para esta tarde. Nos podemos ir cuando queráis..."
    eil "Ich habe bereits mit Alexia über den Nachmittag gesprochen. Wir können losfahren, wann immer du willst."

# game/scripts/c15/c15.rpy:2679
translate german c15s005_kisses_0b99dc2b:

    # eil "¿Pasa algo, Olivia? Pareces enfadada... ¿No te apetece venir de compras?"
    eil "Ist etwas nicht in Ordnung, Olivia? Du wirkst verärgert... Hast du keine Lust, einkaufen zu gehen?"

# game/scripts/c15/c15.rpy:2681
translate german c15s005_kisses_7810ecea:

    # bet "Lo que le pasa es que tiene mal perder. *Risa*"
    bet "Sein Problem ist, dass er ein schlechter Verlierer ist. *lacht*"

# game/scripts/c15/c15.rpy:2682
translate german c15s005_kisses_26913b1a:

    # mc "No hurgues en la herida, Tía Betty..."
    mc "Streu nicht Salz in die Wunde, Tante Betty..."

# game/scripts/c15/c15.rpy:2684
translate german c15s005_kisses_031b89c5:

    # mee "Lo que me pasa es que mi familia se ha vuelto loca... han decidido saludar a [mc] con un beso en la boca."
    mee "Was mir passiert, ist, dass meine Familie verrückt geworden ist... sie haben beschlossen, [mc] mit einem Kuss auf den Mund zu begrüßen."

# game/scripts/c15/c15.rpy:2686
translate german c15s005_kisses_57737953:

    # eil "Genial, me apunto... pero es nuestra familia."
    eil "Super, ich bin dabei... aber es geht um unsere Familie."

# game/scripts/c15/c15.rpy:2690
translate german c15s005_kisses2_b157e1e9:

    # bet "Ahora solo faltan Kiara y mi hermana..."
    bet "Jetzt fehlen nur noch Kiara und meine Schwester..."

# game/scripts/c15/c15.rpy:2692
translate german c15s005_kisses2_985a8f90:

    # eil "¿Mi madre? Realmente habéis perdido el juicio... *Risa*"
    eil "Meine Mutter? Ihr seid ja alle völlig verrückt geworden... *Gelächter*"

# game/scripts/c15/c15.rpy:2694
translate german c15s005_kisses2_55054e75:

    # bet "Pertenece a la familia, igual que tu o yo. Si quiere hacerlo puede, pero nadie la va a obligar."
    bet "Sie gehört zur Familie, genau wie du und ich. Wenn sie es tun möchte, kann sie es tun, aber niemand wird sie dazu zwingen."

# game/scripts/c15/c15.rpy:2696
translate german c15s005_kisses2_f4cab8a8:

    # eil "Os conocéis poco todavía, Betty. *Risa* Mi madre nunca se atrevería a..."
    eil "Ihr kennt euch noch nicht so gut, Betty. *lacht* Meine Mutter würde sich das nie trauen..."

# game/scripts/c15/c15.rpy:2698
translate german c15s005_kisses2_0d04a574:

    # kia "¿Puedo?"
    kia "Dürfen?"

# game/scripts/c15/c15.rpy:2699
translate german c15s005_kisses2_1391d2e1:

    # mc "Sólo si quieres. Como ha dicho Betty, no tienes ninguna obligación."
    mc "Nur wenn du willst. Wie Betty schon sagte, bist du zu nichts verpflichtet."

# game/scripts/c15/c15.rpy:2701
translate german c15s005_kisses2_7b1c647f:

    # "El beso dura más que un simple saludo. Donde tú esperabas un beso tímido, por compromiso, te encuentras con un beso agresivo. Sin pasión, pero agresivo. Tan solo labios presionados con fuerza."
    "Der Kuss dauert länger als eine bloße Begrüßung. Wo du einen schüchternen, pflichtgemäßen Kuss erwartet hast, bekommst du einen leidenschaftlichen. Ohne Leidenschaft, aber dennoch leidenschaftlich. Nur Lippen, die fest aufeinandergepresst werden."

# game/scripts/c15/c15.rpy:2702
translate german c15s005_kisses2_df47b1ce:

    # "Kiara tan solo le está demostrando a su hija que está equivocada."
    "Kiara beweist ihrer Tochter einfach nur das Gegenteil."

# game/scripts/c15/c15.rpy:2704
translate german c15s005_kisses2_3874fc8c:

    # kia "¡Nadie llama cobarde ni loca a Kiara Lamb!"
    kia "Niemand nennt Kiara Lamb eine Feigling oder verrückt!"

# game/scripts/c15/c15.rpy:2706
translate german c15s005_kisses2_46cc48b4:

    # eil "¡Mamá! No me refería a eso."
    eil "Mama! So meinte ich das nicht."

# game/scripts/c15/c15.rpy:2708
translate german c15s005_kisses2_a7ef9792:

    # kia "Lo sé, pero has dicho que no me atrevería... Y sabes que la mejor forma de meter 300 irlandeses en un coche es decirles que no caben."
    kia "Ich weiß, aber du hast gesagt, ich würde mich das nicht trauen... Und du weißt, dass man 300 Iren am besten in ein Auto quetscht, indem man ihnen sagt, dass kein Platz mehr ist."

# game/scripts/c15/c15.rpy:2712
translate german c15s005_kisses3_4b19f362:

    # bet "Olivia, tu nieto se va. ¿No vas a despedirte? Nosotras nos vamos con Eileen y no lo vas a ver hasta la noche..."
    bet "Olivia, dein Enkel reist ab. Willst du dich nicht verabschieden? Wir fahren mit Eileen, und du wirst ihn erst heute Abend wiedersehen."

# game/scripts/c15/c15.rpy:2714
translate german c15s005_kisses3_2720ff25:

    # mee "Me puede dar un beso en la mejilla como ha hecho siempre..."
    mee "Kannst du mir einen Kuss auf die Wange geben, wie du es immer getan hast?"

# game/scripts/c15/c15.rpy:2715
translate german c15s005_kisses3_65a69294:

    # mc "O puedo decirte un simple \"Hasta luego\", Meemaw."
    mc "Oder ich kann einfach sagen: „Bis später“, Meemaw."

# game/scripts/c15/c15.rpy:2716
translate german c15s005_kisses3_53c3cfba:

    # mee "*Grrrr* Adiós, [mc]."
    mee "*Grrrr* Auf Wiedersehen, [mc]."

# game/scripts/c15/c15.rpy:2718
translate german c15s005_kisses3_1927dd96:

    # bet "*Risa* ¿Sabes que estás monísima cuando te enfadas? Eres como un Minioff al que le han quitado su banana. *Risa*"
    bet "*Lacht* Weißt du, wie süß du aussiehst, wenn du wütend bist? Du bist wie ein Minioff, dem man seine Banane weggenommen hat. *Lacht*"

# game/scripts/c15/c15.rpy:2719
translate german c15s005_kisses3_2d058096:

    # bet "¿Vas a ser la única que no lo despida con un beso en toda la familia? Después dices que es tu favorito..."
    bet "Wirst du die Einzige in der ganzen Familie sein, die ihn nicht zum Abschied küsst? Und dann sagst du noch, er sei dein Liebling..."

# game/scripts/c15/c15.rpy:2721
translate german c15s005_kisses3_3420d034:

    # "Olivia se levanta y te da un beso rápido. Sabe que ha perdido la batalla, pero se niega a creer que haya perdido la guerra."
    "Olivia steht auf und gibt dir einen schnellen Kuss. Sie weiß, dass sie die Schlacht verloren hat, aber sie weigert sich zu glauben, dass sie den Krieg verloren hat."

# game/scripts/c15/c15.rpy:2722
translate german c15s005_kisses3_ad92d196:

    # mee "Ya está. ¿Estás contenta?"
    mee "Das war’s. Bist du zufrieden?"

# game/scripts/c15/c15.rpy:2723
translate german c15s005_kisses3_12cafde4:

    # mc "No sé ella, pero yo sí."
    mc "Ich weiß nicht, wie es ihr geht, aber ich schon."

# game/scripts/c15/c15.rpy:2725
translate german c15s005_kisses3_84ee6431:

    # bet "Sí, estoy contenta. Bienvenida de nuevo a la familia, hermanita."
    bet "Ja, ich freue mich. Willkommen zurück in der Familie, kleine Schwester."

# game/scripts/c15/c15.rpy:2727
translate german c15s005_kisses3_712d1e84:

    # mee "¿Hermanita? ¡Soy la mayor!"
    mee "Kleine Schwester? Ich bin die Älteste!"

# game/scripts/c15/c15.rpy:2729
translate german c15s005_kisses3_06df4f8a:

    # bet "Pues empieza a comportarte como tal."
    bet "Dann fang an, dich auch so zu benehmen."

# game/scripts/c15/c15.rpy:2807
translate german c15s006_AaronVisit_64ec5175:

    # "Cuando estás volviendo a casa de [nor], unos minutos antes de las 5:00 PM, un elegante coche para delante de la puerta."
    "Wenn Sie kurz vor 17:00 Uhr von [nor] nach Hause kommen, hält ein schickes Auto vor der Tür."

# game/scripts/c15/c15.rpy:2809
translate german c15s006_AaronVisit_091775fb:

    # ama "Buenas tardes, [mc]. ¿Podemos meter el coche en el garaje de tu casa? Está vacío..."
    ama "Guten Tag, [mc]. Können wir das Auto in Ihrer Garage parken? Sie ist leer..."

# game/scripts/c15/c15.rpy:2810
translate german c15s006_AaronVisit_b224beab:

    # mc "Sí, os abro la cancela y el garaje."
    mc "Ja, ich werde Ihnen das Tor und die Garage öffnen."

# game/scripts/c15/c15.rpy:2811
translate german c15s006_AaronVisit_6990ae61:

    # mcp "(No me acostumbro a que sepan todo lo que pasa en la casa)"
    mcp "(Ich kann mich nicht daran gewöhnen, dass sie alles wissen, was im Haus passiert.)"

# game/scripts/c15/c15.rpy:2813
translate german c15s006_AaronVisit_7f863c91:

    # mcp "(Todo...)"
    mcp "(Alle...)"

# game/scripts/c15/c15.rpy:2815
translate german c15s006_AaronVisit_9b6f3fb5:

    # mc "Buenas tardes, Amanda, Eva."
    mc "Guten Tag, Amanda, Eva."

# game/scripts/c15/c15.rpy:2816
translate german c15s006_AaronVisit_8de7eb2f:

    # mc "Aaron, supongo."
    mc "Aaron, nehme ich an."

# game/scripts/c15/c15.rpy:2817
translate german c15s006_AaronVisit_21586050:

    # mcp "(Esperaba que fuera mucho más joven. Supongo que hay dos Aaron en NTR-GILF. Diferentes personas con el mismo nombre.)"
    mcp "(Ich hatte ihn viel jünger erwartet. Anscheinend gibt es zwei Aarons bei NTR-GILF. Verschiedene Personen mit demselben Namen.)"

# game/scripts/c15/c15.rpy:2818
translate german c15s006_AaronVisit_f23253d7:

    # eva "Buenas tardes, [mc]."
    eva "Guten Tag, [mc]."

# game/scripts/c15/c15.rpy:2819
translate german c15s006_AaronVisit_291dfa20:

    # ama "Aaron, [mc]. [mc], Aaron."
    ama "Aaron, [mc]. [mc], Aaron."

# game/scripts/c15/c15.rpy:2823
translate german c15s006_AaronVisit_3261a642:

    # aar "Encantado de conocerte, [mc]. Tenía muchas ganas de conocerte por fin."
    aar "Schön, dich kennenzulernen, [mc]. Ich habe mich schon sehr darauf gefreut, dich endlich zu treffen."

# game/scripts/c15/c15.rpy:2824
translate german c15s006_AaronVisit_0a90d00b:

    # mc "Igualmente. Yo tenía ganas de que nos expliquéis que está pasando. Mi madre y mi tía nos están esperando."
    mc "Ebenso. Ich war gespannt darauf, was Sie mir erklären würden. Meine Mutter und meine Tante warten schon auf uns."

# game/scripts/c15/c15.rpy:2827
translate german c15s006_AaronVisit_ae33e7f9:

    # aar "¿Su madre? ¿No lo sabe? Eso va a complicar mucho las explicaciones..."
    aar "Seine Mutter? Weiß sie denn nichts davon? Das wird die Sache erheblich verkomplizieren..."

# game/scripts/c15/c15.rpy:2828
translate german c15s006_AaronVisit_4bbbd4c8:

    # mc "¿Saber qué?"
    mc "Weißt du was?"

# game/scripts/c15/c15.rpy:2830
translate german c15s006_AaronVisit_d311fab0:

    # ama "Sí que lo sabe. Se comportan como si [mar] fuera su madre y [nor] su tía para guardar las apariencias de cara a las chicas y proteger sus identidades."
    ama "Ja, sie wissen es. Sie tun so, als wären [mar] ihre Mutter und [nor] ihre Tante, um den Schein gegenüber den Mädchen zu wahren und ihre Identität zu schützen."

# game/scripts/c15/c15.rpy:2831
translate german c15s006_AaronVisit_7b8baca9:

    # mc "¡Ah! ¿Eso? Sí, soy consciente de que mi madre murió."
    mc "Oh! Das? Ja, ich weiß, dass meine Mutter gestorben ist."

# game/scripts/c15/c15.rpy:2833
translate german c15s006_AaronVisit_c471daa0:

    # aar "Mis condolencias, aunque lleguen 16 años tarde. Era una gran mujer."
    aar "Mein Beileid, auch wenn es 16 Jahre zu spät kommt. Sie war eine großartige Frau."

# game/scripts/c15/c15.rpy:2834
translate german c15s006_AaronVisit_729ef1da:

    # mc "¿La conociste?"
    mc "Hast du sie getroffen?"

# game/scripts/c15/c15.rpy:2835
translate german c15s006_AaronVisit_5720edde:

    # aar "Sí, la conocí brevemente."
    aar "Ja, ich habe sie kurz getroffen."

# game/scripts/c15/c15.rpy:2837
translate german c15s006_AaronVisit_28301b6f:

    # ama "¿Pasamos a la casa? [nor] y [mar] nos deben estar esperando..."
    ama "Sollen wir ins Haus gehen? [nor] und [mar] müssen auf uns warten..."

# game/scripts/c15/c15.rpy:2838
translate german c15s006_AaronVisit_4a8e56a9:

    # mc "Nos están esperando en el salón de [nor]... pero supongo que ya lo sabéis..."
    mc "Sie warten in der [nor] Lounge auf uns... aber ich nehme an, das wissen Sie bereits..."

# game/scripts/c15/c15.rpy:2841
translate german c15s006_AaronVisit_abe79fc7:

    # mc "[mar], [nor], estos son Amanda, Eva, y Aaron. [mar], mi madre, y [nor], mi tía."
    mc "[mar], [nor], das sind Amanda, Eva und Aaron. [mar], meine Mutter, und [nor], meine Tante."

# game/scripts/c15/c15.rpy:2843
translate german c15s006_AaronVisit_0d5ce2bb:

    # mc "[mar], [nor], estos son Amanda, Eva, y Aaron. [mar] y [nor]."
    mc "[mar], [nor], das sind Amanda, Eva und Aaron. [mar] und [nor]."

# game/scripts/c15/c15.rpy:2844
translate german c15s006_AaronVisit_d3d3c9a5:

    # mom "¡Oh, Dios mío!" (multiple=2)
    mom "Oh mein Gott!" (multiple=2)

# game/scripts/c15/c15.rpy:2845
translate german c15s006_AaronVisit_8df826fa:

    # nor "Son casi iguales..." (multiple=2)
    nor "Sie sind fast identisch..." (multiple=2)

# game/scripts/c15/c15.rpy:2847
translate german c15s006_AaronVisit_057de2a7:

    # mom "¿Sí?" (multiple=2)
    mom "Ja?" (multiple=2)

# game/scripts/c15/c15.rpy:2848
translate german c15s006_AaronVisit_bb0200d1:

    # nor "¡Sí!" (multiple=2)
    nor "Ja!" (multiple=2)

# game/scripts/c15/c15.rpy:2850
translate german c15s006_AaronVisit_e75411ca:

    # mom "¡Bienvenidas!" (multiple=2)
    mom "Willkommen!" (multiple=2)

# game/scripts/c15/c15.rpy:2851
translate german c15s006_AaronVisit_f5efe7ab:

    # nor "¡Sentíos como en casa!" (multiple=2)
    nor "Fühlt euch wie zu Hause!" (multiple=2)

# game/scripts/c15/c15.rpy:2852
translate german c15s006_AaronVisit_bd13b94c:

    # ama "*Suspiro* Gracias, [mar]." (multiple=2)
    ama "*Seufz* Danke, [mar]." (multiple=2)

# game/scripts/c15/c15.rpy:2853
translate german c15s006_AaronVisit_7b20eb74:

    # eva "*Jadeo* Gracias... supongo..." (multiple=2)
    eva "*Schnappatmung* Danke... nehme ich an..." (multiple=2)

# game/scripts/c15/c15.rpy:2855
translate german c15s006_AaronVisit_27e5987f:

    # mom "Te queda genial el rubio, Amanda... aunque no le digas a [emm] que te lo he dicho..."
    mom "Blond steht dir super, Amanda... aber sag es bloß nicht weiter..."

# game/scripts/c15/c15.rpy:2856
translate german c15s006_AaronVisit_4056cfd6:

    # ama "Gracias, [mar]. Es un cambio que he hecho hace poco tiempo. Y no te preocupes, no creo que tenga oportunidad de decírselo."
    ama "Danke, [mar]. Das habe ich erst vor Kurzem geändert. Und keine Sorge, ich glaube nicht, dass ich Gelegenheit haben werde, es ihm zu sagen."

# game/scripts/c15/c15.rpy:2858
translate german c15s006_AaronVisit_890a73d0:

    # nor "Te miro a los ojos y no puedo dejar de ver a mis niñas, pero está claro que nadie os podría confundir."
    nor "Wenn ich dir in die Augen schaue, sehe ich unweigerlich meine Töchter, aber es ist klar, dass dich niemand mit ihnen verwechseln könnte."

# game/scripts/c15/c15.rpy:2860
translate german c15s006_AaronVisit_5f1c0d0f:

    # eva "No, seguramente solo un tonto nos confundiría..."
    eva "Nein, nur ein Narr würde uns verwirren..."

# game/scripts/c15/c15.rpy:2861
translate german c15s006_AaronVisit_178bfedd:

    # mcp "(Mierda, la [eri] de los tatuajes que se corrían... ¡El tonto soy yo!)"
    mcp "(Verdammt, die [eri]-Tattoos, die da rumliefen... Ich bin der Idiot!)"

# game/scripts/c15/c15.rpy:2863
translate german c15s006_AaronVisit_1317e58f:

    # mc "Aaron, ¿quieres sentarte? Dejemos un poco de tiempo para que se acostumbren. Mi madre y mi tía, me refiero."
    mc "Aaron, möchtest du dich setzen? Geben wir ihnen etwas Zeit, sich daran zu gewöhnen. Ich meine meine Mutter und meine Tante."

# game/scripts/c15/c15.rpy:2864
translate german c15s006_AaronVisit_8f8992ca:

    # aar "Sí, será mejor que nos sentemos y les demos un poco de espacio, aunque tenemos un tiempo limitado y os tengo que explicar muchas cosas."
    aar "Ja, es wäre am besten, wenn wir uns hinsetzten und ihnen etwas Freiraum gäben, obwohl wir nur begrenzt Zeit haben und ich Ihnen noch vieles zu erklären habe."

# game/scripts/c15/c15.rpy:2865
translate german c15s006_AaronVisit_af0e4cb7:

    # mc "¿Quieres beber algo? ¿Café, una copa de algo?"
    mc "Möchten Sie etwas trinken? Kaffee, ein Glas von irgendetwas?"

# game/scripts/c15/c15.rpy:2866
translate german c15s006_AaronVisit_3d25cc0e:

    # aar "Un vaso de agua, por favor. Voy a tener que hablar mucho."
    aar "Ein Glas Wasser, bitte. Ich habe viel zu sagen."

# game/scripts/c15/c15.rpy:2867
translate german c15s006_AaronVisit_7bce90a4:

    # mc "Ahora vuelvo."
    mc "Ich bin gleich wieder da."

# game/scripts/c15/c15.rpy:2869
translate german c15s006_AaronVisit_96009662:

    # mc "Una pregunta, Aaron. ¿Nos hemos visto? Tu cara me resulta familiar. ¿Viniste a casa alguna vez antes del accidente, cuando yo era niño?"
    mc "Eine Frage, Aaron. Kennen wir uns? Dein Gesicht kommt mir bekannt vor. Warst du vor dem Unfall, als ich noch ein Kind war, jemals bei uns zu Hause?"

# game/scripts/c15/c15.rpy:2870
translate german c15s006_AaronVisit_3d7b5e6f:

    # aar "No, tú y yo no nos hemos visto nunca en persona, pero mejor os explico todo cuando las chicas hayan acabado con las presentaciones."
    aar "Nein, wir beide haben uns noch nie persönlich getroffen, aber ich werde alles erklären, sobald die Mädchen mit den Vorstellungen fertig sind."

# game/scripts/c15/c15.rpy:2871
translate german c15s006_AaronVisit_a23381e1:

    # mc "¿Qué me puedes contar de ellas? ¿De Amanda y Eva?"
    mc "Was können Sie mir über sie erzählen? Über Amanda und Eva?"

# game/scripts/c15/c15.rpy:2873
translate german c15s006_AaronVisit_309108da:

    # aar "Aparte de que son unas de las mejores agentes con las que he trabajado nunca, no creo que pueda contarte demasiado. O al menos no demasiado que te interese."
    aar "Abgesehen davon, dass sie zu den besten Maklern gehören, mit denen ich je zusammengearbeitet habe, kann ich Ihnen nicht viel erzählen. Oder zumindest nichts, was Sie interessieren würde."

# game/scripts/c15/c15.rpy:2874
translate german c15s006_AaronVisit_ba48432d:

    # mc "Eso ya lo veremos..."
    mc "Das werden wir sehen..."

# game/scripts/c15/c15.rpy:2876
translate german c15s006_AaronVisit_bbb5cb4f:

    # eva "Creo que la reunión debe empezar ya... *Mascullando* Yo puedo aguantar un número de abrazos limitado."
    eva "Ich denke, das Treffen sollte jetzt beginnen... *Gemurmel* Ich kann nur eine begrenzte Anzahl von Umarmungen vertragen."

# game/scripts/c15/c15.rpy:2877
translate german c15s006_AaronVisit_5ec9c01b:

    # ama "Sí, empecemos ya o no va a dar tiempo de explicároslo todo."
    ama "Ja, fangen wir jetzt an, sonst haben wir keine Zeit mehr, Ihnen alles zu erklären."

# game/scripts/c15/c15.rpy:2878
translate german c15s006_AaronVisit_bbe94d2d:

    # mc "¿Os sentáis?"
    mc "Sitzt du?"

# game/scripts/c15/c15.rpy:2879
translate german c15s006_AaronVisit_82842932:

    # eva "Yo prefiero continuar de pie... para... para poder contrarrestar cualquier amenaza..."
    eva "Ich ziehe es vor, stehen zu bleiben, um jeder Bedrohung begegnen zu können."

# game/scripts/c15/c15.rpy:2881
translate german c15s006_AaronVisit_17bf61a3:

    # nor "Siéntate al lado de Amanda, Eva, por favor. Yo me sentaré a tu lado."
    nor "Eva, setzt euch bitte neben Amanda. Ich setze mich neben euch."

# game/scripts/c15/c15.rpy:2882
translate german c15s006_AaronVisit_1b44d8be:

    # eva "Mmmm... OK."
    eva "Mmm... OK."

# game/scripts/c15/c15.rpy:2884
translate german c15s006_AaronVisit_1498326d:

    # mc "Explícanos, Aaron. ¿Qué es tan importante?"
    mc "Erkläre es uns, Aaron. Was ist so wichtig?"

# game/scripts/c15/c15.rpy:2885
translate german c15s006_AaronVisit_e51a58e2:

    # aar "¿Qué sabéis de NTR y de GILF?"
    aar "Was wissen Sie über NTR und GILF?"

# game/scripts/c15/c15.rpy:2887
translate german c15s006_AaronVisit_ba1749c2:

    # mc "Que fue fundada por mis tíos y que ahora, debido a un extraño testamento, somos prácticamente los dueños."
    mc "Es wurde von meinen Onkeln gegründet und jetzt, aufgrund eines seltsamen Willens, sind wir praktisch die Eigentümer."

# game/scripts/c15/c15.rpy:2889
translate german c15s006_AaronVisit_ea3fd0d6:

    # mc "Que fue fundada por mi madre, mi tío y por Dominic Andersen. Y que ahora, debido a un extraño testamento, somos prácticamente los dueños."
    mc "Es wurde von meiner Mutter, meinem Onkel und Dominic Andersen gegründet. Und nun, aufgrund eines seltsamen Testaments, sind wir praktisch die Eigentümer."

# game/scripts/c15/c15.rpy:2890
translate german c15s006_AaronVisit_9fdc7264:

    # aar "Exacto. Prácticamente. Vuestra familia tiene el 75%% del accionariado. La mía el 25%% restante."
    aar "Genau. Praktisch gesehen. Ihre Familie besitzt 75%% der Anteile. Meine besitzt die restlichen 25%%."

# game/scripts/c15/c15.rpy:2892
translate german c15s006_AaronVisit_195d2a73:

    # nor "¿La tuya?"
    nor "Dein?"

# game/scripts/c15/c15.rpy:2893
translate german c15s006_AaronVisit_d17fb48f:

    # mc "¿Nos puedes explicar eso? Por lo que sé el 25%% restante lo heredaban la Serie XY-A y la Serie XX a partes iguales."
    mc "Können Sie uns das erklären? Meines Wissens wurden die verbleibenden 25%% zu gleichen Teilen von der XY-A-Serie und der XX-Serie übernommen."

# game/scripts/c15/c15.rpy:2894
translate german c15s006_AaronVisit_4ef4cab8:

    # mc "Hemos descubierto que Eva y Amanda son XX. Pero tú no puedes ser Serie A."
    mc "Wir haben herausgefunden, dass Eva und Amanda XX sind. Aber man kann nicht Serie A sein."

# game/scripts/c15/c15.rpy:2896
translate german c15s006_AaronVisit_d54ab48b:

    # ama "Quizás sería bueno que empezases por el principio, Aaron."
    ama "Vielleicht wäre es gut, wenn du von vorne anfangen würdest, Aaron."

# game/scripts/c15/c15.rpy:2903
translate german c15s006_AaronVisit_312d0efb:

    # mc "Es decir, somos los dueños de una empresa millonaria que se dedica a trabajar como mercenarios."
    mc "Anders ausgedrückt: Wir sind die Eigentümer eines Unternehmens mit einem Wert von mehreren Millionen Dollar, das als Söldner arbeitet."

# game/scripts/c15/c15.rpy:2904
translate german c15s006_AaronVisit_a8337876:

    # aar "Sí, esa es la actividad económica principal. La secundaria es la investigación y diseño de dispositivos de medicina avanzada."
    aar "Ja, das ist die primäre wirtschaftliche Tätigkeit. Die sekundäre Tätigkeit ist die Forschung und Entwicklung fortschrittlicher Medizinprodukte."

# game/scripts/c15/c15.rpy:2905
translate german c15s006_AaronVisit_37a3d752:

    # mc "Vale, ¿y ahora qué?"
    mc "Okay, und was nun?"

# game/scripts/c15/c15.rpy:2907
translate german c15s006_AaronVisit_1f65be02:

    # aar "Ahora tenéis que tomar una decisión sobre qué queréis hacer con la empresa. Podéis venderla, mantenerla o cambiarla."
    aar "Nun müssen Sie entscheiden, was Sie mit dem Unternehmen tun möchten. Sie können es verkaufen, behalten oder verändern."

# game/scripts/c15/c15.rpy:2908
translate german c15s006_AaronVisit_8c794037:

    # aar "No hace falta que toméis la decisión ahora. Antes deberíais decirle la verdad a [emm], [dap] y [eri]. Ellas también tienen voto. Igual que nosotros."
    aar "Du musst die Entscheidung nicht jetzt treffen. Zuerst solltest du [emm], [dap] und [eri] die Wahrheit sagen. Sie haben auch ein Stimmrecht. Genau wie wir."

# game/scripts/c15/c15.rpy:2910
translate german c15s006_AaronVisit_34321809:

    # mc "¿Y mi padre?"
    mc "Und mein Vater?"

# game/scripts/c15/c15.rpy:2912
translate german c15s006_AaronVisit_dc7bae01:

    # aar "¿Tu padre? ¿Qué tiene que ver Edmund en todo esto?"
    aar "Dein Vater? Was hat Edmund mit all dem zu tun?"

# game/scripts/c15/c15.rpy:2913
translate german c15s006_AaronVisit_1a9a442f:

    # mc "Le perseguíais... o le perseguían... aquí en Newport. Cuando se fugó también le persiguieron..."
    mc "Du hast ihn gejagt... oder sie haben ihn gejagt... hier in Newport. Als er entkam, haben sie ihn auch dann gejagt..."

# game/scripts/c15/c15.rpy:2915
translate german c15s006_AaronVisit_541b2858:

    # mom "¿Qué? ¿Has estado en contacto con tu padre? ¿Has hablado con él?"
    mom "Was? Hattest du Kontakt zu deinem Vater? Hast du mit ihm gesprochen?"

# game/scripts/c15/c15.rpy:2916
translate german c15s006_AaronVisit_dd2ee5e5:

    # mc "Sí, Mamá. Te lo explico luego."
    mc "Ja, Mama. Ich erkläre es dir später."

# game/scripts/c15/c15.rpy:2918
translate german c15s006_AaronVisit_79ef2db6:

    # aar "Tu padre no ha sido un objetivo nunca. No soy consciente de que nadie le haya seguido a ningún sitio o de que le estén vigilando."
    aar "Ihr Vater war nie ein Ziel. Mir ist nicht bekannt, dass ihn irgendjemand irgendwohin verfolgt oder beobachtet."

# game/scripts/c15/c15.rpy:2919
translate german c15s006_AaronVisit_52160b59:

    # mc "Vuestros Serie G le siguieron hasta Aruba..."
    mc "Ihre G-Serie folgte ihm nach Aruba..."

# game/scripts/c15/c15.rpy:2921
translate german c15s006_AaronVisit_cc928158:

    # aar "¿Aruba? *Risa* ¿Tu padre se fugó a Aruba?"
    aar "Aruba? *lacht* Ist dein Vater nach Aruba durchgebrannt?"

# game/scripts/c15/c15.rpy:2922
translate german c15s006_AaronVisit_5f18d335:

    # mc "Sí... no entiendo qué tiene de gracioso..."
    mc "Ja... ich verstehe nicht, was daran so lustig sein soll..."

# game/scripts/c15/c15.rpy:2924
translate german c15s006_AaronVisit_ecde917c:

    # aar "¿Te acuerdas que te he dicho que NTR compró laboratorios en el extranjero? El laboratorio principal está en Aruba."
    aar "Erinnerst du dich, als ich dir erzählt habe, dass NTR Labore im Ausland gekauft hat? Das Hauptlabor befindet sich in Aruba."

# game/scripts/c15/c15.rpy:2925
translate german c15s006_AaronVisit_4300af04:

    # aar "Nadie le vigilaba y nadie le siguió... *Risa* Fue él quien se metió en la boca del lobo..."
    aar "Niemand beobachtete ihn und niemand folgte ihm... *Gelächter* Er ging direkt in die Höhle des Löwen..."

# game/scripts/c15/c15.rpy:2926
translate german c15s006_AaronVisit_628c5930:

    # aar "Si decidís mantener la empresa, uno de vosotros debería venir a Aruba con nosotros en unas semanas, una vez se calmen las aguas."
    aar "Falls Sie sich dazu entschließen, das Unternehmen weiterzuführen, sollte einer von Ihnen in ein paar Wochen, wenn sich die Lage beruhigt hat, mit uns nach Aruba kommen."

# game/scripts/c15/c15.rpy:2927
translate german c15s006_AaronVisit_65c4b1d4:

    # mc "¿Para qué?"
    mc "So dass?"

# game/scripts/c15/c15.rpy:2929
translate german c15s006_AaronVisit_3fd69b48:

    # aar "Ahora mismo la empresa está sin liderazgo. Con Xabier apartado de su puesto, GILF desaparecerá y todo el personal será absorbido por NTR."
    aar "Das Unternehmen ist derzeit führungslos. Mit Xabiers Absetzung wird GILF aufgelöst und alle Mitarbeiter werden von NTR übernommen."

# game/scripts/c15/c15.rpy:2930
translate german c15s006_AaronVisit_0d720591:

    # aar "Alguien debe dirigir ese cambio y decidir el rumbo que queréis... queremos darle a la empresa, sea para mantenerlo o cambiarlo."
    aar "Jemand muss diesen Wandel anführen und entscheiden, in welche Richtung wir das Unternehmen entwickeln wollen, ob wir es beibehalten oder verändern."

# game/scripts/c15/c15.rpy:2931
translate german c15s006_AaronVisit_074dd798:

    # mc "Ninguno de nosotros sabe nada de operaciones encubiertas, clonación, o medicina..."
    mc "Keiner von uns weiß etwas über verdeckte Operationen, Klonen oder Medizin..."

# game/scripts/c15/c15.rpy:2933
translate german c15s006_AaronVisit_5b630dd0:

    # nor "Pero tú sabes cómo dirigir una empresa. Es lo que has estudiado."
    nor "Aber Sie wissen, wie man ein Unternehmen führt. Das haben Sie ja studiert."

# game/scripts/c15/c15.rpy:2934
translate german c15s006_AaronVisit_2c5471cc:

    # mc "Tú también... y yo solo he estudiado. No tendría ni idea de por dónde empezar..."
    mc "Du auch... und ich habe nur studiert. Ich hätte keine Ahnung, wo ich anfangen sollte..."

# game/scripts/c15/c15.rpy:2935
translate german c15s006_AaronVisit_40badfe1:

    # nor "Yo sufro para administrar el Dormitorio... estoy demasiado oxidada..."
    nor "Ich habe Schwierigkeiten, mich im Wohnheim zurechtzufinden... Ich bin zu eingerostet..."

# game/scripts/c15/c15.rpy:2937
translate german c15s006_AaronVisit_12742e75:

    # aar "Yo podría ayudarte en eso... si quieres."
    aar "Ich könnte Ihnen dabei helfen... wenn Sie möchten."

# game/scripts/c15/c15.rpy:2938
translate german c15s006_AaronVisit_de7691c5:

    # mc "¿Y por qué no la diriges tú? También eres accionista..."
    mc "Und warum leiten Sie es nicht? Sie sind ja auch Anteilseigner..."

# game/scripts/c15/c15.rpy:2939
translate german c15s006_AaronVisit_8ed5b5bb:

    # aar "Hay demasiada mala sangre ahora mismo como para que yo tome el poder. Además, tu familia tiene la mayoría de las acciones..."
    aar "Die Stimmung ist momentan zu angespannt, als dass ich die Macht übernehmen könnte. Außerdem besitzt Ihre Familie die meisten Aktien..."

# game/scripts/c15/c15.rpy:2940
translate german c15s006_AaronVisit_8b1f69e9:

    # aar "Puedo dirigir el proceso de transición, pero no puedo hacerme cargo de la empresa."
    aar "Ich kann den Übergangsprozess steuern, aber ich kann das Unternehmen nicht übernehmen."

# game/scripts/c15/c15.rpy:2941
translate german c15s006_AaronVisit_2a5a1ac4:

    # mc "¿Y Amanda y Eva?"
    mc "Und Amanda und Eva?"

# game/scripts/c15/c15.rpy:2943
translate german c15s006_AaronVisit_d77a0a89:

    # ama "Si tú no sabes por dónde empezar, imagínate nosotras... y estamos en la misma posición que Aaron. Hay gente que no lo aceptaría. Volveremos a la base hoy con Aaron para allanarte el camino."
    ama "Wenn Sie nicht wissen, wo Sie anfangen sollen, stellen Sie sich vor, wie wir uns fühlen … und wir sind in der gleichen Lage wie Aaron. Manche würden das nicht akzeptieren. Wir kehren heute mit Aaron zurück, um Ihnen den Weg zu ebnen."

# game/scripts/c15/c15.rpy:2944
translate german c15s006_AaronVisit_51bbbf53:

    # ama "Además, sólo serían unos meses. Una vez toméis la decisión sobre qué hacer con la empresa, una vez aprendas en quién puedes delegar, podrás dirigirlo todo desde aquí."
    ama "Außerdem wären es nur ein paar Monate. Sobald Sie entschieden haben, was Sie mit dem Unternehmen machen wollen und wissen, an wen Sie Aufgaben delegieren können, werden Sie von da an alles selbst in der Hand haben."

# game/scripts/c15/c15.rpy:2945
translate german c15s006_AaronVisit_ce7ece0f:

    # mc "¿Meses? ¡No puedo irme meses!"
    mc "Monate? Ich kann nicht monatelang weg sein!"

# game/scripts/c15/c15.rpy:2947
translate german c15s006_AaronVisit_0f161008:

    # eva "¿No te puedes separar de tu familia? Si decidís mantener la empresa y no venderla, sabes que es lo mejor."
    eva "Kannst du nicht von deiner Familie getrennt sein? Wenn du dich entscheidest, das Unternehmen zu behalten und nicht zu verkaufen, weißt du, dass es das Beste ist."

# game/scripts/c15/c15.rpy:2948
translate german c15s006_AaronVisit_47f99024:

    # eva "Ayer se te llenaba la boca con la palabra familia. Hoy parece que no estás dispuesto a sacrificar unos meses por su bien."
    eva "Gestern hast du noch voller Reden über die Familie gewesen. Heute scheinst du nicht bereit zu sein, ein paar Monate ihretwegen zu opfern."

# game/scripts/c15/c15.rpy:2949
translate german c15s006_AaronVisit_bfbfe313:

    # mc "Espera... ¿tenemos la oportunidad de venderla? ¿Hay compradores? ¿Qué valor tiene?"
    mc "Moment mal... haben wir eine Chance, es zu verkaufen? Gibt es überhaupt Käufer? Was ist es wert?"

# game/scripts/c15/c15.rpy:2951
translate german c15s006_AaronVisit_f00a197d:

    # aar "No hemos calculado el valor todavía. Pero bastante. Seguramente diez u once cifras. No creíamos que quisierais poner en venta la empresa familiar."
    aar "Wir haben den Wert noch nicht berechnet. Aber er ist ziemlich hoch. Wahrscheinlich zehn- oder elfstellig. Wir dachten nicht, dass Sie das Familienunternehmen verkaufen möchten."

# game/scripts/c15/c15.rpy:2952
translate german c15s006_AaronVisit_d8922672:

    # mc "¡Wow! Es para pensarlo..."
    mc "Wow! Darüber sollte man mal nachdenken..."

# game/scripts/c15/c15.rpy:2954
translate german c15s006_AaronVisit_c3e497ce:

    # aar "Es posible que en las próximas semanas os hagan alguna oferta. Va a ser difícil que vuestra identidad no se filtre en algunos círculos."
    aar "Möglicherweise erhalten Sie in den kommenden Wochen ein Angebot. Es wird schwierig sein, Ihre Identität in bestimmten Kreisen geheim zu halten."

# game/scripts/c15/c15.rpy:2955
translate german c15s006_AaronVisit_cd53b7f0:

    # aar "Si decidís venderla, nos gustaría pediros un favor. Dadnos la oportunidad de comprar vuestra parte."
    aar "Falls Sie sich zum Verkauf entscheiden, hätten wir eine Bitte an Sie. Geben Sie uns bitte die Gelegenheit, Ihre Anteile zu erwerben."

# game/scripts/c15/c15.rpy:2956
translate german c15s006_AaronVisit_8120dd94:

    # aar "O al menos lo suficiente para tener el control de la empresa. No queremos que caiga en manos equivocadas."
    aar "Oder zumindest genug, um die Kontrolle über das Unternehmen zu haben. Wir wollen nicht, dass es in die falschen Hände gerät."

# game/scripts/c15/c15.rpy:2958
translate german c15s006_AaronVisit_ccb7b165:

    # nor "De momento me parecería buena idea no venderla hasta no saber más, y si decidimos hacerlo, creo que os debemos el derecho de tanteo."
    nor "Ich denke, es wäre vorerst ratsam, es nicht zu verkaufen, bis wir mehr wissen. Sollten wir uns dennoch dafür entscheiden, schulden wir Ihnen meiner Meinung nach das Vorkaufsrecht."

# game/scripts/c15/c15.rpy:2959
translate german c15s006_AaronVisit_53fef2fa:

    # "En ese momento te das cuenta de que [nor] y [mar] han estado usando sus teléfonos los últimos minutos. Estabas demasiado concentrado en la conversación para notarlo."
    "In diesem Moment wird dir klar, dass [nor] und [mar] seit einigen Minuten ihre Handys benutzen. Du warst zu sehr in das Gespräch vertieft, um es zu bemerken."

# game/scripts/c15/c15.rpy:2960
translate german c15s006_AaronVisit_bf424847:

    # nor "Pero nosotras también queremos algo a cambio. Al menos hasta que [mc] decida si va a Aruba en unas semanas."
    nor "Aber wir wollen auch etwas im Gegenzug. Zumindest bis [mc] in ein paar Wochen entscheidet, ob sie nach Aruba fahren."

# game/scripts/c15/c15.rpy:2962
translate german c15s006_AaronVisit_1b61ee21:

    # mom "Queremos que Amanda y Eva se queden en Newport durante ese tiempo."
    mom "Wir möchten, dass Amanda und Eva während dieser Zeit in Newport bleiben."

# game/scripts/c15/c15.rpy:2963
translate german c15s006_AaronVisit_eb701fd5:

    # "Y ahora entiendes qué hacían con los teléfonos. Estaban creando su propia estrategia de negociación."
    "Und jetzt versteht ihr, was sie mit den Telefonen gemacht haben. Sie haben ihre eigene Verhandlungsstrategie entwickelt."

# game/scripts/c15/c15.rpy:2965
translate german c15s006_AaronVisit_7c4d48bc:

    # ama "¡Sí!... Digo... ¿Qué?" (multiple=2)
    ama "Ja!... Ich meine... Was?" (multiple=2)

# game/scripts/c15/c15.rpy:2966
translate german c15s006_AaronVisit_f537aa30:

    # eva "¿Por qué nosotras?" (multiple=2)
    eva "Warum wir?" (multiple=2)

# game/scripts/c15/c15.rpy:2968
translate german c15s006_AaronVisit_ec319464:

    # aar "Eso no va a ser posible..."
    aar "Das wird nicht möglich sein..."

# game/scripts/c15/c15.rpy:2970
translate german c15s006_AaronVisit_2e543abb:

    # mom "Aaron, déjame hablar."
    mom "Aaron, lass mich sprechen."

# game/scripts/c15/c15.rpy:2971
translate german c15s006_AaronVisit_791a3641:

    # mom "Queremos que se queden por varias razones. La primera es que queremos conocerlas mejor."
    mom "Wir möchten, dass sie bleiben, und zwar aus mehreren Gründen. Der erste ist, dass wir sie besser kennenlernen möchten."

# game/scripts/c15/c15.rpy:2973
translate german c15s006_AaronVisit_05ac2f66:

    # mom "También queremos que conozcan a las chicas. Creemos que las cinco tienen el derecho a conocerse."
    mom "Wir möchten auch, dass sie die Mädchen kennenlernen. Wir glauben, dass alle fünf das Recht haben, einander kennenzulernen."

# game/scripts/c15/c15.rpy:2975
translate german c15s006_AaronVisit_e8fbeb86:

    # nor "Habrá que dar muchas explicaciones... pero..."
    nor "Es wird viel zu erklären geben... aber..."

# game/scripts/c15/c15.rpy:2976
translate german c15s006_AaronVisit_a1007f8f:

    # nor "Queremos que pasen tiempo en casa una vez se lo hayamos contado a las chicas. Una comida o una cena cada día. Se pueden turnar."
    nor "Wir möchten, dass sie Zeit zu Hause verbringen, sobald wir es den Mädchen gesagt haben. Einmal täglich ein Mittag- oder Abendessen. Sie können sich abwechseln."

# game/scripts/c15/c15.rpy:2977
translate german c15s006_AaronVisit_9c03d934:

    # nor "Obviamente, solo si ellas quieren. Así podrán conocer a toda la familia."
    nor "Natürlich nur, wenn sie das auch möchten. So können sie die ganze Familie kennenlernen."

# game/scripts/c15/c15.rpy:2979
translate german c15s006_AaronVisit_2b800b5f:

    # nor "Nos habéis dicho que hay agentes a los que todavía no les habéis cancelado las órdenes, y no creemos que haya nadie mejor para protegernos."
    nor "Sie haben uns mitgeteilt, dass es Agenten gibt, deren Aufträge Sie noch nicht storniert haben, und wir glauben nicht, dass es jemanden gibt, der uns besser schützen könnte."

# game/scripts/c15/c15.rpy:2981
translate german c15s006_AaronVisit_5c76298d:

    # aar "Eso va a ser muy complicado, no podemos..."
    aar "Das wird sehr kompliziert, das können wir nicht..."

# game/scripts/c15/c15.rpy:2982
translate german c15s006_AaronVisit_8ac0354b:

    # mc "Creo que tienes la batalla perdida, Aaron."
    mc "Ich glaube, du hast die Schlacht verloren, Aaron."

# game/scripts/c15/c15.rpy:2983
translate german c15s006_AaronVisit_f3cfad35:

    # mc "Yo también tengo un par de condiciones si queréis el derecho a tanteo. Serían tres, pero con una se me han adelantado."
    mc "Ich habe außerdem ein paar Bedingungen für das Vorkaufsrecht. Es wären drei, aber eine davon wurde bereits vereinbart."

# game/scripts/c15/c15.rpy:2985
translate german c15s006_AaronVisit_ab7b8520:

    # ama "¿Qué condiciones, [mc]?"
    ama "Welche Bedingungen, [mc]?"

# game/scripts/c15/c15.rpy:2986
translate german c15s006_AaronVisit_5525bc3c:

    # mc "Quiero que me enseñéis a disparar. No quiero volver a sentirme tan indefenso como me sentí con Eric el otro día."
    mc "Ich möchte, dass du mir das Schießen beibringst. Ich will mich nicht wieder so hilflos fühlen wie neulich mit Eric."

# game/scripts/c15/c15.rpy:2987
translate german c15s006_AaronVisit_307728bf:

    # mc "Y quiero que me enseñen Eva y Amanda, con lo que la condición de que se queden es indispensable."
    mc "Und ich möchte, dass Eva und Amanda mir etwas beibringen, daher ist es unerlässlich, dass sie bleiben."

# game/scripts/c15/c15.rpy:2989
translate german c15s006_AaronVisit_e4d66cae:

    # eva "¡De eso me ocupo yo!... Si no le importa a Amanda..."
    eva "Ich kümmere mich darum!... Wenn Amanda nichts dagegen hat..."

# game/scripts/c15/c15.rpy:2990
translate german c15s006_AaronVisit_afe403e9:

    # mc "Y quiero que retiréis las cámaras de los espacios privados de la casa. Habitaciones, baños..."
    mc "Und ich möchte, dass Sie die Kameras aus den privaten Bereichen des Hauses entfernen. Schlafzimmer, Badezimmer..."

# game/scripts/c15/c15.rpy:2992
translate german c15s006_AaronVisit_b16d4240:

    # mom "¿De qué estás hablando?" (multiple=2)
    mom "Worüber redest du?" (multiple=2)

# game/scripts/c15/c15.rpy:2993
translate german c15s006_AaronVisit_9dae3966:

    # nor "¿Nos han grabado en las habitaciones?" (multiple=2)
    nor "Wurden wir in den Zimmern gefilmt?" (multiple=2)

# game/scripts/c15/c15.rpy:2994
translate german c15s006_AaronVisit_5f14fd9d:

    # mc "Sí, y eso se acaba hoy."
    mc "Ja, und damit ist heute Schluss."

# game/scripts/c15/c15.rpy:2996
translate german c15s006_AaronVisit_c3c94543:

    # ama "Eso va a hacer más complicado protegeros. Si se infiltra alguien y no sabemos dónde está..."
    ama "Das wird euren Schutz erschweren. Wenn jemand eindringt und wir nicht wissen, wo er sich befindet..."

# game/scripts/c15/c15.rpy:2997
translate german c15s006_AaronVisit_54f928f5:

    # mc "Podéis revisar los pasillos y las zonas comunes. Pero se acabó grabarnos... durmiendo o duchándonos."
    mc "Sie können die Flure und Gemeinschaftsräume kontrollieren. Aber bitte filmen Sie uns nicht mehr – weder beim Schlafen noch beim Duschen."

# game/scripts/c15/c15.rpy:2999
translate german c15s006_AaronVisit_a37e3844:

    # eva "Vale... no me gusta la idea, pero lo entiendo..."
    eva "Okay... Die Idee gefällt mir nicht, aber ich verstehe sie..."

# game/scripts/c15/c15.rpy:3000
translate german c15s006_AaronVisit_e06f882a:

    # mc "Perfecto. ¿Mañana empezamos las lecciones sobre armas de fuego?"
    mc "Perfekt. Sollen wir morgen mit dem Schießtraining beginnen?"

# game/scripts/c15/c15.rpy:3002
translate german c15s006_AaronVisit_c6eb1aae:

    # eva "¡Sí!"
    eva "Ja!"

# game/scripts/c15/c15.rpy:3004
translate german c15s006_AaronVisit_a48835b3:

    # eva "Digo... sí. Ya que es tu condición, podemos hacerlo a mediodía si te va bien. En el lago."
    eva "Ich meine... ja. Da das Ihre Situation ist, könnten wir es mittags machen, wenn Ihnen das passt. Am See."

# game/scripts/c15/c15.rpy:3005
translate german c15s006_AaronVisit_2a22efe0:

    # mc "Genial. Entonces todo está aclarado."
    mc "Großartig. Dann ist alles klar."

# game/scripts/c15/c15.rpy:3007
translate german c15s006_AaronVisit_3884d4c1:

    # aar "Nosotros nos vamos a tener que ir ya. Nuestro... mi vuelo sale en menos de dos horas."
    aar "Wir müssen jetzt los. Mein Flug geht in weniger als zwei Stunden."

# game/scripts/c15/c15.rpy:3033
translate german c15s006_AaronVisit_e78b50ef:

    # eva "¡Mierda! ¡Me he dejado la caja en el coche!"
    eva "Verdammt! Ich habe die Schachtel im Auto gelassen!"

# game/scripts/c15/c15.rpy:3034
translate german c15s006_AaronVisit_ee341e90:

    # mc "¿Qué caja?"
    mc "Welche Box?"

# game/scripts/c15/c15.rpy:3035
translate german c15s006_AaronVisit_b662f280:

    # eva "Dame las llaves del garaje y ahora la traigo... que te lo vaya explicando Aaron..."
    eva "Gib mir die Garagenschlüssel, dann bringe ich sie... Aaron wird es dir erklären..."

# game/scripts/c15/c15.rpy:3036
translate german c15s006_AaronVisit_059dc465:

    # mc "Tranquila, cuando os acompañe al coche la cogeré yo. ¿Qué es?"
    mc "Keine Sorge, ich hole es, wenn ich dich zum Auto begleite. Was ist es?"

# game/scripts/c15/c15.rpy:3038
translate german c15s006_AaronVisit_5a3a37fe:

    # aar "Es uno de los últimos productos de NTR. Un test de embarazo rápido. Todavía no está aprobado por la FDA, pero las chicas me pidieron que trajera una caja."
    aar "Es handelt sich um eines der neuesten Produkte von NTR: einen Schwangerschaftsschnelltest. Er ist noch nicht von der FDA zugelassen, aber die Mädchen baten mich, einen mitzubringen."

# game/scripts/c15/c15.rpy:3039
translate german c15s006_AaronVisit_3d20d171:

    # mc "¿Rápido? ¿15 segundos? Los normales tardan cinco minutos..."
    mc "Schnell? 15 Sekunden? Die normalen dauern fünf Minuten..."

# game/scripts/c15/c15.rpy:3040
translate german c15s006_AaronVisit_52fde766:

    # aar "No me refiero a eso. Es un test que se puede hacer 48 horas después de tener relaciones. Solo necesita una gota de sangre y en 24 horas el resultado es 99.9%% preciso."
    aar "Das meine ich nicht. Es handelt sich um einen Test, der 48 Stunden nach dem Geschlechtsverkehr durchgeführt werden kann. Man benötigt nur einen Tropfen Blut, und das Ergebnis ist innerhalb von 24 Stunden zu 99,9%% zuverlässig."

# game/scripts/c15/c15.rpy:3051
translate german c15s006_AaronVisit_cdcbc3f6:

    # aar "Las chicas me dijeron que tú sabrías qué hacer con los tests... hay 50. Espero que sean suficientes."
    aar "Die Mädchen meinten, du wüsstest, was mit den Tests zu tun ist... es sind 50. Ich hoffe, das reicht."

# game/scripts/c15/c15.rpy:3053
translate german c15s006_AaronVisit_84885411:

    # aar "Bueno, creo que con esto acaba esta reunión. Nos veremos en unas semanas, espero, si no tengo que volver antes."
    aar "Damit wäre dieses Treffen wohl beendet. Ich hoffe, wir sehen uns in ein paar Wochen wieder, es sei denn, ich muss früher zurückkommen."

# game/scripts/c15/c15.rpy:3054
translate german c15s006_AaronVisit_8de2db0e:

    # mc "Encantado de haberte conocido, Aaron."
    mc "Schön, dich kennenzulernen, Aaron."

# game/scripts/c15/c15.rpy:3056
translate german c15s006_AaronVisit_83e99fc2:

    # nor "Me ha gustado mucho conocerte, Eva. ¿Por qué no vienes a comer mañana después de las lecciones con [mc]?"
    nor "Es war wirklich schön, dich kennenzulernen, Eva. Komm doch morgen nach deinem Unterricht mit [mc] zum Mittagessen vorbei!"

# game/scripts/c15/c15.rpy:3057
translate german c15s006_AaronVisit_45252bbd:

    # nor "Mientras estáis fuera, les contaremos la verdad a las chicas y al resto de la familia."
    nor "Während du weg bist, werden wir den Mädchen und dem Rest der Familie die Wahrheit sagen."

# game/scripts/c15/c15.rpy:3058
translate german c15s006_AaronVisit_d12b9728:

    # eva "Si no hay más remedio... es una de las condiciones que habéis puesto."
    eva "Wenn es keine andere Möglichkeit gibt... dann ist es eine der Bedingungen, die Sie selbst festgelegt haben."

# game/scripts/c15/c15.rpy:3060
translate german c15s006_AaronVisit_2f3e7864:

    # nor "Sólo si quieres. No quiero que te sientas obligada."
    nor "Nur wenn du möchtest. Ich möchte nicht, dass du dich dazu verpflichtet fühlst."

# game/scripts/c15/c15.rpy:3061
translate german c15s006_AaronVisit_3ed3cf5c:

    # eva "No, no... lo habéis pedido y vendré, no es justo que os echéis atrás ahora. Cuenta conmigo para comer. Por la tarde retiraré las cámaras de las habitaciones."
    eva "Nein, nein … du hast es so gewollt, also komme ich. Jetzt einen Rückzieher zu machen, wäre unfair. Ich bin zum Mittagessen dabei. Ich werde die Kameras heute Nachmittag aus den Zimmern entfernen."

# game/scripts/c15/c15.rpy:3063
translate german c15s006_AaronVisit_a23e326b:

    # mom "Eso te deja a ti para cenar, Amanda. ¿Te apetece?"
    mom "Dann bist du fürs Abendessen übrig, Amanda. Möchtest du auch etwas?"

# game/scripts/c15/c15.rpy:3064
translate german c15s006_AaronVisit_26baa1a8:

    # ama "Me muero de ganas."
    ama "Ich würde es wahnsinnig gerne tun."

# game/scripts/c15/c15.rpy:3066
translate german c15s006_AaronVisit_6eaf2b59:

    # mom "[emm] te va a caer muy bien, estoy segura."
    mom "[emm] Es wird dir bestimmt sehr gut gefallen."

# game/scripts/c15/c15.rpy:3067
translate german c15s006_AaronVisit_06a2c2b7:

    # ama "Lo sé. Tengo experiencia tratando con... alguien parecido. *Risita*"
    ama "Ich weiß. Ich habe Erfahrung im Umgang mit... solchen Leuten. *Kichert*"

# game/scripts/c15/c15.rpy:3069
translate german c15s006_AaronVisit_1d21ebb8:

    # aar "*Susurrando* Me gustaría tener una conversación privada contigo en unos días. ¿Puedo llamarte?"
    aar "*Flüsternd* Ich würde in ein paar Tagen gern ein privates Gespräch mit dir führen. Darf ich dich anrufen?"

# game/scripts/c15/c15.rpy:3070
translate german c15s006_AaronVisit_b8472ded:

    # mc "Por supuesto. ¿Sobre qué?"
    mc "Natürlich. Worüber denn?"

# game/scripts/c15/c15.rpy:3071
translate german c15s006_AaronVisit_38c631f6:

    # aar "*Susurrando* Entre otras cosas, sobre dónde me has visto con anterioridad. Recuerda que éramos tres. Pero ahora no es el momento."
    aar "*Flüsternd* Unter anderem darüber, wo du mich schon einmal gesehen hast. Erinnerst du dich, wir waren zu dritt? Aber jetzt ist nicht der richtige Zeitpunkt."

# game/scripts/c15/c15.rpy:3073
translate german c15s006_AaronVisit_9e633314:

    # mom "Eva, estoy deseando que vengas a comer mañana y tener más tiempo para conocernos, si las chicas te dejan un minuto."
    mom "Eva, ich freue mich schon sehr darauf, dass du morgen zum Mittagessen kommst und wir mehr Zeit haben, uns kennenzulernen, falls die Mädchen dir kurz Zeit geben."

# game/scripts/c15/c15.rpy:3074
translate german c15s006_AaronVisit_88319b2f:

    # eva "Seguro que sí... no suelo ser muy sociable... y se van a aburrir de mí enseguida."
    eva "Ich bin mir sicher, dass sie das tun werden... Ich bin normalerweise nicht sehr gesellig... und sie werden sich schnell an mir sattsehen."

# game/scripts/c15/c15.rpy:3075
translate german c15s006_AaronVisit_77253fee:

    # mom "*Risa* Lo dudo, pero ya lo veremos mañana."
    mom "*Lacht* Ich bezweifle es, aber wir werden morgen sehen."

# game/scripts/c15/c15.rpy:3077
translate german c15s006_AaronVisit_4a071ec3:

    # nor "Gracias por lo del otro día, Amanda. Tengo muchas ganas de conocerte mejor."
    nor "Danke für neulich, Amanda. Ich freue mich schon sehr darauf, dich besser kennenzulernen."

# game/scripts/c15/c15.rpy:3078
translate german c15s006_AaronVisit_1109e5d4:

    # ama "Yo también... a todas. Observándoos a distancia parecéis una familia... muy interesante."
    ama "Ich auch... an euch alle. Wenn ich euch aus der Ferne beobachte, wirkt ihr wie eine Familie... sehr interessant."

# game/scripts/c15/c15.rpy:3079
translate german c15s006_AaronVisit_ed609ed6:

    # nor "No sé lo que habrás visto... quizás sí que somos un poco diferentes de lo normal..."
    nor "Ich weiß nicht, was Sie gesehen haben... vielleicht sind wir wirklich ein bisschen anders als die Norm..."

# game/scripts/c15/c15.rpy:3080
translate german c15s006_AaronVisit_5a0794bd:

    # mc "¡Ejem! Creo que es momento de acabar con los abrazos. El vuelo de Aaron no va a esperar."
    mc "Ähm! Ich glaube, es ist Zeit, mit den Umarmungen aufzuhören. Aarons Flug wartet nicht."

# game/scripts/c15/c15.rpy:3082
translate german c15s006_AaronVisit_7b7499f5:

    # mc "¡Vale, vale! No hace falta que me miréis como si yo fuera el enemigo. Os vais a ver mañana..."
    mc "Okay, okay! Du musst mich nicht so ansehen, als wäre ich dein Feind. Wir sehen uns morgen wieder..."

# game/scripts/c15/c15.rpy:3083
translate german c15s006_AaronVisit_07e65a90:

    # mc "Os acompaño al coche."
    mc "Ich begleite Sie zum Auto."

# game/scripts/c15/c15.rpy:3085
translate german c15s006_AaronVisit_ca487079:

    # "Después de despedirte de Aaron..."
    "Nachdem ich mich von Aaron verabschiedet hatte..."

# game/scripts/c15/c15.rpy:3086
translate german c15s006_AaronVisit_44e10fe8:

    # mc "Bueno, chicas, nos veremos mañana. Eva, a mediodía en el lago, ¿OK?"
    mc "Okay, Mädels, wir sehen uns morgen. Eva, mittags am See, okay?"

# game/scripts/c15/c15.rpy:3088
translate german c15s006_AaronVisit_388fd1ad:

    # eva "Sí, a mediodía... y gracias..."
    eva "Ja, mittags... und danke..."

# game/scripts/c15/c15.rpy:3089
translate german c15s006_AaronVisit_8ee6cc36:

    # mc "No sé por qué, pero no hay de qué..."
    mc "Ich weiß nicht warum, aber gern geschehen..."

# game/scripts/c15/c15.rpy:3090
translate german c15s006_AaronVisit_e514a195:

    # eva "Por convencer a [mar] y [nor] de que nos aceptaran... ha sido intenso..."
    eva "Es war sehr anstrengend, [mar] und [nor] davon zu überzeugen, uns zu akzeptieren..."

# game/scripts/c15/c15.rpy:3091
translate german c15s006_AaronVisit_a9428d84:

    # mc "Yo no..."
    mc "Ich tu nicht..."

# game/scripts/c15/c15.rpy:3093
translate german c15s006_AaronVisit_817cd02b:

    # ama "No lo niegues, [mc]... ha quedado muy claro que lo de pedir que nos quedáramos lo teníais pactado."
    ama "Leugne es nicht, [mc]... es ist ganz klar geworden, dass du zugestimmt hast, uns zum Bleiben aufzufordern."

# game/scripts/c15/c15.rpy:3094
translate german c15s006_AaronVisit_d85f17d1:

    # mc "Ha sido cosa de ellas, te aseguro que no he tenido nada que ver. No quiero un mérito que no es mío. Aunque yo también lo iba a pedir."
    mc "Das war deren Werk, ich versichere Ihnen, ich hatte damit nichts zu tun. Ich will keine Anerkennung für etwas, das mir nicht zusteht. Obwohl ich sie auch einfordern wollte."

# game/scripts/c15/c15.rpy:3095
translate german c15s006_AaronVisit_4917fad3:

    # mc "Pero me alegra que os hayáis sentido así."
    mc "Aber ich bin froh, dass Sie das so empfunden haben."

# game/scripts/c15/c15.rpy:3096
translate german c15s006_AaronVisit_bcb467c7:

    # ama "A ver si Eva me deja despedirme."
    ama "Mal sehen, ob Eva mich verabschieden lässt."

# game/scripts/c15/c15.rpy:3098
translate german c15s006_AaronVisit_085ba100:

    # eva "Solo un minuto más..."
    eva "Nur noch eine Minute..."

# game/scripts/c15/c15.rpy:3099
translate german c15s006_AaronVisit_41f840aa:

    # aar "Chicas, el plan de vuelo..."
    aar "Mädels, der Flugplan..."

# game/scripts/c15/c15.rpy:3100
translate german c15s006_AaronVisit_f2f2e83b:

    # eva "Vaaale..."
    eva "Okay..."

# game/scripts/c15/c15.rpy:3102
translate german c15s006_AaronVisit_62f8c090:

    # ama "Gracias, [mc]. Ha sido casi como sentirse parte de la familia por un momento."
    ama "Vielen Dank, [mc]. Es war fast so, als ob ich mich für einen Moment als Teil der Familie gefühlt hätte."

# game/scripts/c15/c15.rpy:3103
translate german c15s006_AaronVisit_790380f1:

    # ama "Me costaba creerte ayer, cuando hablabas de la familia... pero después de esto... tengo muchas ganas de cenar mañana."
    ama "Gestern fiel es mir schwer, dir zu glauben, als du über Familie gesprochen hast... aber nach dem, was du gesagt hast... freue ich mich schon sehr auf das Abendessen morgen."

# game/scripts/c15/c15.rpy:3104
translate german c15s006_AaronVisit_960b0d54:

    # mc "Me temo que se te pasarán en cuanto llegues. Ser el centro de atención puede ser complicado en esta familia. Ármate de paciencia."
    mc "Ich fürchte, sie werden vorbeigehen, sobald Sie ankommen. Im Mittelpunkt zu stehen, kann in dieser Familie schwierig sein. Haben Sie Geduld."

# game/scripts/c15/c15.rpy:3108
translate german c15s006_AaronVisit_c062ae71:

    # "Tras la segunda queja de Aaron sobre el plan de vuelo, te entregan la caja y se marchan a regañadientes."
    "Nach Aarons zweiter Beschwerde über den Flugplan übergeben sie ihm die Kiste und gehen widerwillig."

# game/scripts/c15/c15.rpy:3110
translate german c15s006_AaronVisit_27422f28:

    # "Tras la segunda queja de Aaron sobre el plan de vuelo, se marchan a regañadientes."
    "Nach Aarons zweiter Beschwerde über den Flugplan brechen sie widerwillig auf."

# game/scripts/c15/c15.rpy:3113
translate german c15s006_AaronVisit_250687f0:

    # mc "Ya se han ido. ¿Qué os ha parecido la reunión?"
    mc "Sie sind schon weg. Wie hat Ihnen das Treffen gefallen?"

# game/scripts/c15/c15.rpy:3114
translate german c15s006_AaronVisit_120bb197:

    # mom "Extraño... tener a una [emm] que no es nuestra [emm] delante, ha sido extraño... Si no fuera por el pelo..."
    mom "Seltsam... es war schon seltsam, jemanden, der nicht zu uns gehört, vor uns zu haben... Wenn da nicht die Haare wären..."

# game/scripts/c15/c15.rpy:3115
translate german c15s006_AaronVisit_08fd2832:

    # nor "Eva me ha parecido... encantadora de una forma rara... al principio estaba distante, pero después... no sé... creo que al final no quería irse."
    nor "Eva wirkte auf mich... auf eine seltsame Art charmant... zuerst war sie distanziert, aber dann... ich weiß nicht... ich glaube, am Ende wollte sie nicht weg."

# game/scripts/c15/c15.rpy:3116
translate german c15s006_AaronVisit_dc245214:

    # mc "Ninguna de las dos quería irse. Ayer estuve hablando con las dos, en la playa..."
    mc "Keiner von beiden wollte gehen. Ich habe gestern am Strand mit beiden gesprochen..."

# game/scripts/c15/c15.rpy:3118
translate german c15s006_AaronVisit_498f76f2:

    # mom "¿Estaban en la playa?" (multiple=2)
    mom "Waren sie am Strand?" (multiple=2)

# game/scripts/c15/c15.rpy:3119
translate german c15s006_AaronVisit_4598e340:

    # nor "¿Por qué no les dijiste que se unieran?" (multiple=2)
    nor "Warum hast du ihnen nicht gesagt, sie sollen mitmachen?" (multiple=2)

# game/scripts/c15/c15.rpy:3120
translate german c15s006_AaronVisit_d25fc767:

    # mc "Sólo Eva estaba en la playa, vigilándonos. Amanda estaba en su base."
    mc "Nur Eva war am Strand und wachte über uns. Amanda war in ihrem Hauptquartier."

# game/scripts/c15/c15.rpy:3121
translate german c15s006_AaronVisit_5471076d:

    # mc "Y decirles que se unieran podría haber sido complicado sin que nuestras chicas supieran de su existencia. Ni nuestras chicas ni el resto, claro."
    mc "Und sie zum Mitmachen zu bewegen, hätte kompliziert werden können, ohne dass unsere Mädchen davon wussten. Weder unsere Mädchen noch die anderen natürlich."

# game/scripts/c15/c15.rpy:3123
translate german c15s006_AaronVisit_e29a0f0c:

    # nor "Tienes razón. Solo nosotros, Betty y tu abuela saben de su existencia. Demasiadas explicaciones."
    nor "Du hast recht. Nur Betty, deine Großmutter, und wir wissen davon. Zu viele Erklärungen."

# game/scripts/c15/c15.rpy:3124
translate german c15s006_AaronVisit_eb746bde:

    # nor "Y esas explicaciones habrá que darlas mañana. Realmente me da miedo la reacción de las chicas..."
    nor "Und diese Erklärungen müssen morgen erfolgen. Ich habe wirklich Angst vor der Reaktion der Mädchen..."

# game/scripts/c15/c15.rpy:3125
translate german c15s006_AaronVisit_8931b604:

    # mc "Aprovechad mientras Eva me enseña a disparar. Creo que es una cosa que cada una de vosotras tiene que hacer con sus hijas. Y no es que me esté escaqueando."
    mc "Nutze die Gelegenheit, während Eva mir das Schießen beibringt. Ich finde, das sollte jede von euch mit ihren Töchtern machen. Und es ist nicht so, als würde ich mich vor meinen Pflichten drücken."

# game/scripts/c15/c15.rpy:3127
translate german c15s006_AaronVisit_ee1d1851:

    # mom "Yo también lo creo. Prefiero explicárselo a [emm] a solas."
    mom "Ich denke auch. Ich erkläre es lieber [emm] allein."

# game/scripts/c15/c15.rpy:3128
translate german c15s006_AaronVisit_e26bbebf:

    # mom "Pero ¿qué hacemos con el resto? Si Scarlett o las estudiantes... o Kiara y Eileen... ven a Eva con [dap] y [eri], o a Amanda con [emm]..."
    mom "Aber was machen wir mit dem Rest? Wenn Scarlett oder die Schüler... oder Kiara und Eileen... Eva mit [dap] und [eri] sehen, oder Amanda mit [emm]..."

# game/scripts/c15/c15.rpy:3129
translate german c15s006_AaronVisit_5bc1056f:

    # mc "¡Uff! No había pensado en eso. Yo confío en que Eileen y Saira podrán guardar el secreto..."
    mc "Puh! Daran hatte ich gar nicht gedacht. Ich vertraue darauf, dass Eileen und Saira das Geheimnis bewahren können."

# game/scripts/c15/c15.rpy:3131
translate german c15s006_AaronVisit_d73d6923:

    # nor "Yo pondría la mano en el fuego por Kiara... Supongo que es mejor explicarles algo al resto de las estudiantes antes de que lo descubran ellas."
    nor "Ich würde für Kiara bürgen... Ich denke, es ist besser, den anderen Schülern etwas zu erklären, bevor sie es selbst herausfinden."

# game/scripts/c15/c15.rpy:3132
translate german c15s006_AaronVisit_e487bdc0:

    # nor "Podemos decir que son... unas primas que viven lejos..."
    nor "Man könnte sagen, sie sind... Cousins, die weit voneinander entfernt leben..."

# game/scripts/c15/c15.rpy:3133
translate german c15s006_AaronVisit_b0356c07:

    # mc "¿Más mentiras, [nor]? Creo que nadie de los que estuvieron ayer en la playa va a hacer nada que pueda perjudicar a las chicas... a ninguna de las cinco."
    mc "Noch mehr Lügen, [nor]? Ich glaube nicht, dass irgendjemand, der gestern am Strand war, etwas tun wird, was den Mädchen schaden könnte... irgendeiner der fünf."

# game/scripts/c15/c15.rpy:3135
translate german c15s006_AaronVisit_5a0ce203:

    # mom "Estoy de acuerdo contigo. Y eso incluye a Samantha, Simone, Alexia... y también a Jamaal. Creo que no nos dejamos a nadie."
    mom "Ich stimme dir zu. Und das schließt Samantha, Simone, Alexia und auch Jamaal mit ein. Ich glaube, wir haben alle berücksichtigt."

# game/scripts/c15/c15.rpy:3137
translate german c15s006_AaronVisit_5de91de3:

    # mc "Tan solo a Megan... la invitaste a dormir en casa el fin de semana... va a ver a las chicas juntas."
    mc "Nur Megan... du hast sie eingeladen, übers Wochenende bei dir zu übernachten... sie wird die Mädchen zusammen sehen."

# game/scripts/c15/c15.rpy:3139
translate german c15s006_AaronVisit_d8aad798:

    # mc "Tan solo a Megan, una amiga... la invité a dormir en casa el fin de semana... va a ver a las chicas juntas."
    mc "Ich habe nur Megan, eine Freundin, eingeladen, das Wochenende bei mir zu übernachten... sie wird die Mädchen zusammen treffen."

# game/scripts/c15/c15.rpy:3140
translate german c15s006_AaronVisit_28e839c3:

    # mom "¿Confías en ella?"
    mom "Vertraust du ihr?"

# game/scripts/c15/c15.rpy:3141
translate german c15s006_AaronVisit_edb89c5b:

    # mc "Sí. Además, también es amiga de Saira, con lo que es mejor que se lo cuente yo antes de que se entere por otros medios."
    mc "Ja. Außerdem ist sie ja auch Sairas Freundin, deshalb ist es besser, ich sage es ihr, bevor sie es auf anderem Wege erfährt."

# game/scripts/c15/c15.rpy:3142
translate german c15s006_AaronVisit_4760328a:

    # mc "¡Joder! Tantos años guardando el secreto y ahora lo destapamos a lo grande..."
    mc "Verdammt! So viele Jahre haben wir das Geheimnis gehütet und jetzt enthüllen wir es auf so große Art und Weise..."

# game/scripts/c15/c15.rpy:3143
translate german c15s006_AaronVisit_f360ee27:

    # mc "Un tema aclarado. ¿Qué opináis del tema de la empresa? ¿Qué hacemos?"
    mc "Diese Angelegenheit wurde geklärt. Was denken Sie über die Situation im Unternehmen? Was sollten wir tun?"

# game/scripts/c15/c15.rpy:3145
translate german c15s006_AaronVisit_e81ed396:

    # nor "Mientras despedías a Eva y a Amanda, hemos decidido que primero hay que explicárselo a nuestras chicas. Ellas también tienen que decidir."
    nor "Während du dich von Eva und Amanda verabschiedet hast, haben wir beschlossen, dass wir das zuerst unseren Mädchen erklären müssen. Auch sie müssen eine Entscheidung treffen."

# game/scripts/c15/c15.rpy:3146
translate german c15s006_AaronVisit_ff0e29d7:

    # nor "La empresa es tan suya como nuestra, o de Aaron, Eva y Amanda, y a lo mejor tienen ideas diferentes sobre qué hacer a las que podamos tener nosotras."
    nor "Das Unternehmen gehört genauso ihnen wie uns, oder Aaron, Eva und Amanda, da sie möglicherweise andere Vorstellungen davon haben, was zu tun ist, als wir."

# game/scripts/c15/c15.rpy:3147
translate german c15s006_AaronVisit_a37abb9b:

    # mc "Me parece lo más correcto."
    mc "Ich denke, es ist das Richtige."

# game/scripts/c15/c15.rpy:3150
translate german c15s006_AaronVisit_4e552617:

    # mom "Cambiando de tema... ¿Qué has hecho con la caja? ¿La de los tests?"
    mom "Um mal das Thema zu wechseln... Was hast du mit der Kiste gemacht? Mit der, in der die Tests waren?"

# game/scripts/c15/c15.rpy:3153
translate german c15s006_AaronVisit_551b52c3:

    # nor "Cambiando de tema... ¿Qué has hecho con la caja? ¿La de los tests?"
    nor "Um mal das Thema zu wechseln... Was hast du mit der Kiste gemacht? Mit der, in der die Tests waren?"

# game/scripts/c15/c15.rpy:3155
translate german c15s006_AaronVisit_d321a2ef:

    # mc "La he dejado en el recibidor."
    mc "Ich habe es im Flur liegen lassen."

# game/scripts/c15/c15.rpy:3163
translate german c15s006_AaronVisit_7df20501:

    # mcp "(No creo que venga de un minuto. Hay que esperar 24 horas para saber los resultados. *Risa mental*)"
    mcp "(Ich glaube nicht, dass es in einer Minute so weit ist. Wir müssen 24 Stunden auf die Ergebnisse warten. *Innerliches Lachen*)"

# game/scripts/c15/c15.rpy:3166
translate german c15s006_AaronVisit_100bf87f:

    # "Hacéis las pruebas de embarazo. Son tan sencillas como poner una gota de sangre en una tira de plástico y ponerla dentro de una pequeña máquina."
    "Man macht Schwangerschaftstests. Die sind ganz einfach: Man gibt einen Tropfen Blut auf einen Plastikstreifen und führt diesen in ein kleines Gerät ein."

# game/scripts/c15/c15.rpy:3167
translate german c15s006_AaronVisit_d5786b61:

    # "Etiquetáis las pruebas con el nombre de [nor] y [mar] y las guardáis en lugar seguro, en la habitación de [nor]."
    "Sie kennzeichnen die Beweismittel mit den Namen [nor] und [mar] und bewahren sie an einem sicheren Ort in [nor]s Zimmer auf."

# game/scripts/c15/c15.rpy:3169
translate german c15s006_AaronVisit_74934509:

    # "Hacéis la prueba de embarazo. Es tan sencilla como poner una gota de sangre en una tira de plástico y ponerla dentro de una pequeña máquina. La guardáis en lugar seguro."
    "Sie machen einen Schwangerschaftstest. Das ist ganz einfach: Sie geben einen Tropfen Blut auf einen Plastikstreifen und führen diesen in ein kleines Gerät ein. Anschließend bewahren Sie ihn an einem sicheren Ort auf."

# game/scripts/c15/c15.rpy:3171
translate german c15s006_AaronVisit_e0220bc1:

    # "Continuáis hablando sobre la reunión un rato, antes de que empiecen a volver las chicas que han ido a la ciudad."
    "Ihr unterhaltet euch noch eine Weile über das Treffen, bevor die Mädchen, die in die Stadt gefahren waren, zurückkehren."

# game/scripts/c15/c15.rpy:3174
translate german c15s006_AaronVisit_977d1c5d:

    # "Te llevas la caja con las otras 48 pruebas a tu habitación. Esperas tener suficientes para el resto de tu vida."
    "Du nimmst die Schachtel mit den anderen 48 Tests mit auf dein Zimmer. Du hoffst, genug für den Rest deines Lebens zu haben."

# game/scripts/c15/c15.rpy:3176
translate german c15s006_AaronVisit_2fd66ddd:

    # "Te llevas la caja con las 50 pruebas de embarazo a tu habitación. Esperas tener suficientes para el resto de tu vida."
    "Du nimmst die Packung mit 50 Schwangerschaftstests mit auf dein Zimmer. Du hoffst, genug für den Rest deines Lebens zu haben."

# game/scripts/c15/c15.rpy:3181
translate german c15s006_Story_2e4e4045:

    # aar "OK. Ya sabéis quién fundó NTR. Tenéis que entender que eran unos genios."
    aar "Okay. Du weißt ja bereits, wer NTR gegründet hat. Du musst verstehen, dass sie Genies waren."

# game/scripts/c15/c15.rpy:3184
translate german c15s006_Story_0986c2d4:

    # aar "OK. Ya sabéis quién fundó NTR. Tienes que saber que tu madre era un genio, [mc]. Todos lo eran."
    aar "Okay. Du weißt, wer NTR gegründet hat. Du musst wissen, dass deine Mutter ein Genie war, [mc]. Sie waren es alle."

# game/scripts/c15/c15.rpy:3185
translate german c15s006_Story_88dfca2e:

    # aar "Empezaron estudiando árboles genealógicos basándose en el ADN. Pero hicieron un descubrimiento rompedor."
    aar "Sie begannen mit der Untersuchung von Stammbäumen auf der Grundlage von DNA. Doch dann machten sie eine bahnbrechende Entdeckung."

# game/scripts/c15/c15.rpy:3186
translate german c15s006_Story_fe83aec9:

    # aar "Ya se habían hecho clonaciones anteriormente de animales. Todos recordamos a Dolly."
    aar "Es gab schon früher Klonierungen von Tieren. Wir alle erinnern uns an Dolly."

# game/scripts/c15/c15.rpy:3187
translate german c15s006_Story_bec1f593:

    # aar "Pero ellos descubrieron como hacer clonaciones aceleradas. De embrión a individuo viable en un tercio del tiempo de gestación."
    aar "Doch sie entdeckten, wie man beschleunigtes Klonen durchführt. Vom Embryo zum lebensfähigen Individuum in einem Drittel der üblichen Schwangerschaftszeit."

# game/scripts/c15/c15.rpy:3189
translate german c15s006_Story_7c1c7aca:

    # aar "Daniel era la gran mente detrás de ello."
    aar "Daniel war der geniale Kopf dahinter."

# game/scripts/c15/c15.rpy:3191
translate german c15s006_Story_c2848b1c:

    # aar "Anna era la gran mente detrás de ello."
    aar "Anna war die geniale Kopf hinter dieser Idee."

# game/scripts/c15/c15.rpy:3193
translate german c15s006_Story_39cd7c12:

    # aar "Empezaron clonando animales... ovejas, cerdos..."
    aar "Sie begannen damit, Tiere zu klonen... Schafe, Schweine..."

# game/scripts/c15/c15.rpy:3194
translate german c15s006_Story_17d1281c:

    # aar "Pero Dominic convenció al resto para que probasen la clonación humana. Ahí es donde estaría el dinero de verdad. Imaginaros tener un clon humano en solo tres meses."
    aar "Dominic überzeugte die anderen jedoch, das Klonen von Menschen zu versuchen. Damit ließ sich das große Geld verdienen. Stellen Sie sich vor, Sie hätten in nur drei Monaten einen menschlichen Klon."

# game/scripts/c15/c15.rpy:3195
translate german c15s006_Story_4a1d0b10:

    # aar "Obviamente en los Estados Unidos era ilegal, con lo que compraron laboratorios en un par de países donde la legislación era poco clara al respecto."
    aar "In den Vereinigten Staaten war das natürlich illegal, also kauften sie Labore in einigen Ländern, in denen die Gesetzeslage unklar war."

# game/scripts/c15/c15.rpy:3196
translate german c15s006_Story_53280390:

    # aar "Después de varios experimentos en el extranjero consiguen la primera clonación más o menos correcta. La Serie A. Yo y mis dos hermanos. Alfred y Arnau."
    aar "Nach mehreren Versuchen im Ausland gelang ihnen die erste mehr oder weniger erfolgreiche Klonung. Serie A. Ich und meine beiden Brüder. Alfred und Arnau."

# game/scripts/c15/c15.rpy:3198
translate german c15s006_Story_0a2a7e26:

    # mc "Espera... has dicho que eso pasó hace 20 o 21 años. ¿Cómo puedes ser tú?"
    mc "Moment mal... du sagtest, das sei vor 20 oder 21 Jahren passiert. Wie kann das bei dir der Fall gewesen sein?"

# game/scripts/c15/c15.rpy:3199
translate german c15s006_Story_ba72dc5e:

    # aar "Porque yo tengo 21 años. No solo se triplicaba la velocidad de gestación. El envejecimiento no se paraba al \"nacer\"."
    aar "Weil ich 21 Jahre alt bin. Nicht nur hat sich die Schwangerschaftsrate verdreifacht, sondern auch der Alterungsprozess hat mit der Geburt nicht aufgehört."

# game/scripts/c15/c15.rpy:3200
translate german c15s006_Story_5dce615d:

    # aar "Además, el material genético inicial... Bueno, eso es para otro día... hoy no hay tiempo."
    aar "Und was das ursprüngliche genetische Material angeht... Nun, das ist ein Thema für einen anderen Tag... heute fehlt die Zeit."

# game/scripts/c15/c15.rpy:3201
translate german c15s006_Story_e218d169:

    # mc "¡Joder! Entonces..."
    mc "Verdammt! Also..."

# game/scripts/c15/c15.rpy:3203
translate german c15s006_Story_f1ce2633:

    # aar "Sí, mi cuerpo tiene más de 60. Pero no estamos aquí para hablar de mí."
    aar "Ja, mein Körper ist über 60. Aber wir sind nicht hier, um über mich zu reden."

# game/scripts/c15/c15.rpy:3204
translate german c15s006_Story_110a83f1:

    # aar "Después llegó la Serie B. Brandon, Bryce, Brady, Benito, y Bart. Los chicos no salieron bien."
    aar "Dann kam Serie B. Brandon, Bryce, Brady, Benito und Bart. Die Jungs hatten kein Glück."

# game/scripts/c15/c15.rpy:3205
translate german c15s006_Story_784d8983:

    # aar "Intentaron controlar el envejecimiento una vez fuera de los tubos, pero no funcionó. El resultado fue inverso. A los 10 años estaban peor que yo ahora."
    aar "Sie versuchten, den Alterungsprozess nach dem Verlassen der Röhren aufzuhalten, aber es funktionierte nicht. Das Ergebnis war das Gegenteil. Mit 10 Jahren waren sie in einem schlechteren Zustand als ich jetzt."

# game/scripts/c15/c15.rpy:3208
translate german c15s006_Story_392aaa06:

    # aar "Para la tercera serie, Daniel decidió probar otra cosa. Clonar chicas introduciendo algunos cambios."
    aar "Für die dritte Staffel beschloss Daniel, etwas anderes auszuprobieren: Mädchen klonen, allerdings mit einigen Modifikationen."

# game/scripts/c15/c15.rpy:3209
translate german c15s006_Story_87f5648a:

    # mc "Y aparecen Amanda y Eva, ¿no?"
    mc "Und Amanda und Eva tauchen auf, richtig?"

# game/scripts/c15/c15.rpy:3210
translate german c15s006_Story_479d6206:

    # aar "Exacto."
    aar "Genau."

# game/scripts/c15/c15.rpy:3212
translate german c15s006_Story_2812f62f:

    # eva "También Beatrice, Claire, y Diana... y Fiona..."
    eva "Beatrice, Claire und Diana auch... und Fiona..."

# game/scripts/c15/c15.rpy:3214
translate german c15s006_Story_a75c0ec1:

    # nor "Pero ¿De dónde sacaron el material?"
    nor "Aber woher hatten sie das Material?"

# game/scripts/c15/c15.rpy:3215
translate german c15s006_Story_4d81478d:

    # mom "Nunca perdí a [emm] de vista. Nunca se quedó sola cuando íbamos al médico."
    mom "Ich habe [emm] nie aus den Augen verloren. Sie war nie allein, wenn wir zum Arzt gingen."

# game/scripts/c15/c15.rpy:3217
translate german c15s006_Story_28e6945d:

    # aar "Estabais embarazadas a la vez. A Daniel se le ocurrió la idea de extraer células de los fetos."
    aar "Ihr wart beide gleichzeitig schwanger. Daniel hatte die Idee, Zellen aus den Föten zu entnehmen."

# game/scripts/c15/c15.rpy:3218
translate german c15s006_Story_c7952ef3:

    # aar "En algún momento os debieron llevar engañadas a las instalaciones de NTR a haceros algunas pruebas y aprovecharon para extraer el material genético."
    aar "Irgendwann müssen Sie unter einem Vorwand in die Einrichtungen von NTR gelockt worden sein, um sich dort einigen Tests zu unterziehen, und diese nutzten die Gelegenheit, um Ihr genetisches Material zu extrahieren."

# game/scripts/c15/c15.rpy:3220
translate german c15s006_Story_b349305b:

    # mom "¿Sin nuestro consentimiento? ¿Cómo pudieron hacernos eso?"
    mom "Ohne unsere Zustimmung? Wie konnten sie uns das antun?"

# game/scripts/c15/c15.rpy:3222
translate german c15s006_Story_11a6de7c:

    # nor "¡Qué hijos de puta! ¿Cómo pudo Mike aceptar hacer eso con sus propias hijas?"
    nor "Diese Mistkerle! Wie konnte Mike nur zustimmen, seinen eigenen Töchtern so etwas anzutun?"

# game/scripts/c15/c15.rpy:3224
translate german c15s006_Story_98b6c55b:

    # mom "No te lo tomes mal, cielo... esto es nuevo para nosotras... me alegra que estéis aquí ahora."
    mom "Versteh mich nicht falsch, Liebling... das ist neu für uns... Ich bin froh, dass du jetzt hier bist."

# game/scripts/c15/c15.rpy:3225
translate german c15s006_Story_ccc0dba7:

    # ama "Gracias, [mar]..."
    ama "Vielen Dank, [mar]..."

# game/scripts/c15/c15.rpy:3227
translate german c15s006_Story_3e69544b:

    # nor "Sí, vosotras no tenéis la culpa... pero si Mike no estuviera muerto... lo volvería a matar yo ahora mismo."
    nor "Ja, es ist nicht deine Schuld... aber wenn Mike nicht tot wäre... würde ich ihn jetzt sofort wieder töten."

# game/scripts/c15/c15.rpy:3228
translate german c15s006_Story_35c1ea13:

    # eva "Me gusta como piensas. Yo seguramente haría lo mismo."
    eva "Mir gefällt deine Denkweise. Ich würde wahrscheinlich genauso handeln."

# game/scripts/c15/c15.rpy:3230
translate german c15s006_Story_591209eb:

    # aar "El experimento XX fue todo un éxito como podéis ver. Solucionaron el problema de los telómeros cortos y..."
    aar "Experiment XX war, wie Sie sehen können, ein voller Erfolg. Sie haben das Problem der kurzen Telomere gelöst und..."

# game/scripts/c15/c15.rpy:3231
translate german c15s006_Story_6e399718:

    # mc "¿Telo-qué?"
    mc "Telo-was?"

# game/scripts/c15/c15.rpy:3232
translate german c15s006_Story_4485fc64:

    # aar "Telómeros. Es lo que produce el envejecimiento acelerado. Como podéis ver, Eva y Amanda no parecen mayores que [emm], [eri], o [dap]."
    aar "Telomere. Sie sind die Ursache für beschleunigtes Altern. Wie Sie sehen können, wirken Eva und Amanda nicht älter als [emm], [eri] oder [dap]."

# game/scripts/c15/c15.rpy:3233
translate german c15s006_Story_85db7d6a:

    # mc "Ah, OK."
    mc "Ah, okay."

# game/scripts/c15/c15.rpy:3234
translate german c15s006_Story_cbc25f4f:

    # mcp "(Necesitaríamos que [dap] estuviera aquí para que nos tradujese la jerga científica.)"
    mcp "(Wir bräuchten hier [dap], um den wissenschaftlichen Fachjargon für uns zu übersetzen.)"

# game/scripts/c15/c15.rpy:3235
translate german c15s006_Story_ce50c030:

    # mc "Pero habéis nombrado a seis chicas, y solo había dos embarazos... o tres si contáis que [nor] tenía gemelas... ¿Quiénes eran las otras...? ¿Donantes?"
    mc "Aber Sie haben sechs Mädchen genannt, und es gab nur zwei Schwangerschaften... oder drei, wenn man die Zwillingsschwangerschaft von [nor] mitzählt... Wer waren die anderen...? Spenderinnen?"

# game/scripts/c15/c15.rpy:3237
translate german c15s006_Story_9c193365:

    # ama "No había más donantes. Los sujetos A, B, y C, Beatrice, Claire y yo, nacimos de material genético de [emm]. D, E, y F, Diana, Eva, y Fiona, del de [dap] o [eri]."
    ama "Es gab keine weiteren Spender. Die Probanden A, B und C, Beatrice, Claire und ich, stammen aus dem genetischen Material von [emm]. D, E und F, Diana, Eva und Fiona, stammen aus dem genetischen Material von [dap] oder [eri]."

# game/scripts/c15/c15.rpy:3238
translate german c15s006_Story_301d0456:

    # mc "Ah, vale... tres clones por cada chica."
    mc "Ah, okay... drei Klone für jedes Mädchen."

# game/scripts/c15/c15.rpy:3240
translate german c15s006_Story_56c4dc33:

    # eva "Sí. La idea era que sirviéramos como \"material de repuesto\" por si alguna vez necesitaban un trasplante."
    eva "Ja. Die Idee war, dass wir als „Ersatzmaterial“ dienen würden, falls sie jemals eine Transplantation benötigen sollten."

# game/scripts/c15/c15.rpy:3241
translate german c15s006_Story_f0baba46:

    # mc "¡Pero eso es inhumano! ¡Sois personas! No podían pensar en sacrificaros si [dap] hubiera necesitado... yo que sé... un pulmón..."
    mc "Aber das ist unmenschlich! Ihr seid doch Menschen! Sie wären doch nicht im Traum daran gekommen, euch zu opfern, wenn [dap]... ich weiß nicht... eine Lunge gebraucht hätte..."

# game/scripts/c15/c15.rpy:3242
translate german c15s006_Story_d41e55ac:

    # eva "Sí, lo es. Y sí, lo pensaban hacer. A ellos les daba lo mismo en ese momento. Solo éramos experimentos."
    eva "Ja, das stimmt. Und ja, sie hatten es vor. Damals war es ihnen egal. Wir waren nur Versuchsobjekte."

# game/scripts/c15/c15.rpy:3244
translate german c15s006_Story_93eae1e7:

    # aar "Y ahí es cuando empezó a torcerse la cosa. Si puedes crear clones y usarlos como repositorio de órganos de cara al futuro..."
    aar "Und da fingen die Probleme an. Wenn man Klone erschaffen und sie als Organvorrat für die Zukunft nutzen kann..."

# game/scripts/c15/c15.rpy:3245
translate german c15s006_Story_7e521a9a:

    # mc "Los billonarios se volverían locos por tener eso para sus hijos."
    mc "Milliardäre würden verrückt werden, wenn sie das für ihre Kinder hätten."

# game/scripts/c15/c15.rpy:3246
translate german c15s006_Story_c4f8d22a:

    # aar "Exacto. Mis chicas nacieron antes que las vuestras. Y se comprobó que el envejecimiento no continuaba una vez fuera del tanque."
    aar "Genau. Meine Töchter wurden vor deinen geboren. Und es wurde bewiesen, dass der Alterungsprozess nicht weiterging, sobald sie aus dem Aquarium waren."

# game/scripts/c15/c15.rpy:3248
translate german c15s006_Story_a6f80731:

    # aar "Para la tercera serie, Anna decidió probar otra cosa. Clonar chicas introduciendo algunos cambios."
    aar "Für die dritte Staffel beschloss Anna, etwas anderes auszuprobieren: Mädchen klonen, allerdings mit einigen Modifikationen."

# game/scripts/c15/c15.rpy:3249
translate german c15s006_Story_20f8a1d8:

    # mc "Y aparecen [emm], [eri] y [dap], ¿no?"
    mc "Und [emm], [eri] und [dap] erscheinen, richtig?"

# game/scripts/c15/c15.rpy:3250
translate german c15s006_Story_479d6206_1:

    # aar "Exacto."
    aar "Genau."

# game/scripts/c15/c15.rpy:3252
translate german c15s006_Story_63f39f20:

    # nor "Pero ¿De dónde sacaron el material genético?"
    nor "Aber woher hatten sie das genetische Material?"

# game/scripts/c15/c15.rpy:3253
translate german c15s006_Story_12addd33:

    # mom "Mike y Dominic nunca nos lo contaron."
    mom "Mike und Dominic haben es uns nie erzählt."

# game/scripts/c15/c15.rpy:3255
translate german c15s006_Story_a377904d:

    # aar "Se pagó a mujeres embarazadas que querían dar sus bebés en adopción. NTR los adoptaría a cambio de hacer unas pruebas con los fetos."
    aar "Schwangere Frauen, die ihre Babys zur Adoption freigeben wollten, erhielten eine Entschädigung. NTR adoptierte die Babys im Gegenzug für die Durchführung von Tests an den Föten."

# game/scripts/c15/c15.rpy:3256
translate german c15s006_Story_09c7b928:

    # aar "En total había seis chicas."
    aar "Es waren insgesamt sechs Mädchen."

# game/scripts/c15/c15.rpy:3257
translate german c15s006_Story_0cf76729:

    # mc "Amanda, Eva, y ¿quién más?"
    mc "Amanda, Eva und wer noch?"

# game/scripts/c15/c15.rpy:3259
translate german c15s006_Story_5559fa61:

    # eva "También Beatrice, Claire, y Diana... y Fiona... Ninguna de ellas está entre nosotras a día de hoy."
    eva "Auch Beatrice, Claire und Diana... und Fiona... Keine von ihnen ist heute bei uns."

# game/scripts/c15/c15.rpy:3260
translate german c15s006_Story_7a2f7317:

    # mc "Lo siento..."
    mc "Es tut mir Leid..."

# game/scripts/c15/c15.rpy:3262
translate german c15s006_Story_591209eb_1:

    # aar "El experimento XX fue todo un éxito como podéis ver. Solucionaron el problema de los telómeros cortos y..."
    aar "Experiment XX war, wie Sie sehen können, ein voller Erfolg. Sie haben das Problem der kurzen Telomere gelöst und..."

# game/scripts/c15/c15.rpy:3263
translate german c15s006_Story_6e399718_1:

    # mc "¿Telo-qué?"
    mc "Telo-was?"

# game/scripts/c15/c15.rpy:3264
translate german c15s006_Story_d246e0ec:

    # aar "Telómeros. Es lo que produce el envejecimiento acelerado. Como podéis ver, [emm], [eri], o [dap] no parecen mayores que Eva y Amanda."
    aar "Telomere. Sie sind die Ursache für beschleunigtes Altern. Wie Sie sehen können, sehen [emm], [eri] und [dap] nicht älter aus als Eva und Amanda."

# game/scripts/c15/c15.rpy:3265
translate german c15s006_Story_85db7d6a_1:

    # mc "Ah, OK."
    mc "Ah, okay."

# game/scripts/c15/c15.rpy:3266
translate german c15s006_Story_cbc25f4f_1:

    # mcp "(Necesitaríamos que [dap] estuviera aquí para que nos tradujese la jerga científica.)"
    mcp "(Wir bräuchten hier [dap], um den wissenschaftlichen Fachjargon für uns zu übersetzen.)"

# game/scripts/c15/c15.rpy:3267
translate german c15s006_Story_9cd3f61e:

    # mc "Pero habéis nombrado a seis chicas, y solo acaba por haber tres clones... o dos si contamos a [eri] y [dap] como uno."
    mc "Aber du hast sechs Mädchen genannt, und am Ende gibt es nur drei Klone... oder zwei, wenn wir [eri] und [dap] als einen zählen."

# game/scripts/c15/c15.rpy:3269
translate german c15s006_Story_9834d149:

    # ama "Los clones de Beatrice, Claire, Diana, y Fiona no fueron viables. Dos no llegaron a nacer y otros dos murieron a los pocos días."
    ama "Die Klone von Beatrice, Claire, Diana und Fiona waren nicht lebensfähig. Zwei schlüpften nicht, und zwei weitere starben innerhalb weniger Tage."

# game/scripts/c15/c15.rpy:3270
translate german c15s006_Story_9f6b6fd0:

    # mom "Eso es muy triste..."
    mom "Das ist sehr traurig..."

# game/scripts/c15/c15.rpy:3272
translate german c15s006_Story_3d41feca:

    # nor "¡Qué hijos de puta! ¿Cómo pudo Mike experimentar así con niñas pequeñas?"
    nor "Diese Mistkerle! Wie konnte Mike nur an kleinen Mädchen solche Experimente durchführen?"

# game/scripts/c15/c15.rpy:3274
translate german c15s006_Story_77996f81:

    # mom "No te lo tomes mal, cielo... esto es nuevo para nosotras... me alegra que estés aquí ahora."
    mom "Versteh mich nicht falsch, Liebling... das ist neu für uns... Ich bin froh, dass du jetzt hier bist."

# game/scripts/c15/c15.rpy:3275
translate german c15s006_Story_ccc0dba7_1:

    # ama "Gracias, [mar]..."
    ama "Vielen Dank, [mar]..."

# game/scripts/c15/c15.rpy:3277
translate german c15s006_Story_3e69544b_1:

    # nor "Sí, vosotras no tenéis la culpa... pero si Mike no estuviera muerto... lo volvería a matar yo ahora mismo."
    nor "Ja, es ist nicht deine Schuld... aber wenn Mike nicht tot wäre... würde ich ihn jetzt sofort wieder töten."

# game/scripts/c15/c15.rpy:3278
translate german c15s006_Story_35c1ea13_1:

    # eva "Me gusta como piensas. Yo seguramente haría lo mismo."
    eva "Mir gefällt deine Denkweise. Ich würde wahrscheinlich genauso handeln."

# game/scripts/c15/c15.rpy:3280
translate german c15s006_Story_e6e4453b:

    # aar "Y ahí es cuando empezó a torcerse la cosa. Si puedes crear clones que envejezcan a la vez que sus donantes y usarlos como repositorio de órganos de cara al futuro..."
    aar "Und da fingen die Probleme an. Wenn man Klone erschaffen kann, die genauso schnell altern wie ihre Spender, und sie als zukünftige Organbank nutzen kann …"

# game/scripts/c15/c15.rpy:3281
translate german c15s006_Story_7e521a9a_1:

    # mc "Los billonarios se volverían locos por tener eso para sus hijos."
    mc "Milliardäre würden verrückt werden, wenn sie das für ihre Kinder hätten."

# game/scripts/c15/c15.rpy:3282
translate german c15s006_Story_4cbe5d92:

    # aar "Exacto. Cuando vuestras chicas nacieron, se comprobó que el envejecimiento no continuaba una vez fuera del tanque."
    aar "Genau. Als Ihre Mädchen geboren wurden, war bereits bewiesen, dass der Alterungsprozess nicht weiterging, sobald sie das Aquarium verließen."

# game/scripts/c15/c15.rpy:3283
translate german c15s006_Story_11e815f4:

    # aar "Dominic hizo contactos con un tipo muy rico. Había mucho dinero en juego."
    aar "Dominic nahm Kontakt zu einem sehr reichen Mann auf. Es ging um viel Geld."

# game/scripts/c15/c15.rpy:3285
translate german c15s006_Story_b740950d:

    # aar "Y entoces, llegó el accidente de avión. Se sospechó de un sabotaje, pero no se pudo probar nada."
    aar "Und dann geschah der Flugzeugabsturz. Sabotage wurde vermutet, aber es konnte nichts bewiesen werden."

# game/scripts/c15/c15.rpy:3286
translate german c15s006_Story_19fe89de:

    # aar "Después de la reestructuración de NTR y GILF, se intentó llevar a cabo la primera clonación del hijo de un millonario."
    aar "Nach der Umstrukturierung von NTR und GILF wurde der erste Versuch unternommen, den Sohn eines Millionärs zu klonen."

# game/scripts/c15/c15.rpy:3288
translate german c15s006_Story_f1b6d097:

    # aar "No funcionó. Creemos que una parte fundamental del trabajo en parar el envejecimiento estaba en alguno de los portátiles que se destruyeron en el accidente."
    aar "Es hat nicht funktioniert. Wir glauben, dass ein entscheidender Teil der Arbeit zur Aufhaltung des Alterungsprozesses in einem der Laptops enthalten war, die bei dem Unfall zerstört wurden."

# game/scripts/c15/c15.rpy:3289
translate german c15s006_Story_cec9ae65:

    # aar "Faltaban datos en los servidores de NTR. Se redujo el ratio de envejecimiento. Primero a 2.8, 2.5, 2... pero nunca han conseguido que sea inferior a 1.7."
    aar "Auf den Servern von NTR fehlten Daten. Die Alterungsrate wurde reduziert, zunächst auf 2,8, dann auf 2,5, schließlich auf 2… aber es gelang nie, sie unter 1,7 zu senken."

# game/scripts/c15/c15.rpy:3290
translate german c15s006_Story_fd8b467e:

    # mc "¿Qué pasó con esos clones fallidos?"
    mc "Was geschah mit den fehlgeschlagenen Klonen?"

# game/scripts/c15/c15.rpy:3292
translate german c15s006_Story_9f9374c8:

    # aar "Si no puedes utilizarlos como repositorio de órganos para sus donantes millonarios, ¿qué puedes hacer con unos clones que a los 6 años tienen el cuerpo de alguien de 18?"
    aar "Wenn man sie nicht als Organspender für ihre millionenschweren Spender nutzen kann, was kann man dann mit Klonen anfangen, die im Alter von 6 Jahren den Körper eines 18-Jährigen haben?"

# game/scripts/c15/c15.rpy:3293
translate german c15s006_Story_e7141d72:

    # aar "Con la capacidad de aprendizaje de un niño pequeño, pero con la fuerza y la agilidad de un adulto."
    aar "Mit der Lernfähigkeit eines Kleinkindes, aber mit der Kraft und Beweglichkeit eines Erwachsenen."

# game/scripts/c15/c15.rpy:3294
translate german c15s006_Story_0ca5cad8:

    # mc "Un ejército de clones."
    mc "Eine Armee von Klonen."

# game/scripts/c15/c15.rpy:3296
translate german c15s006_Story_8df4e326:

    # aar "Exacto. Los entrenas para realizar operaciones encubiertas y los alquilas al mejor postor."
    aar "Genau. Man bildet sie für verdeckte Operationen aus und vermietet sie dann an den Meistbietenden."

# game/scripts/c15/c15.rpy:3297
translate german c15s006_Story_63b919cf:

    # mc "No es justo. Seguían... seguíais siendo niños..."
    mc "Das ist nicht fair. Ihr wart doch noch... ihr wart doch noch Kinder..."

# game/scripts/c15/c15.rpy:3299
translate german c15s006_Story_77c9af73:

    # ama "Si y no. Eric solo tiene 15 años aunque su cuerpo ronde los 30. Pero ya has visto como puede ser..."
    ama "Ja und nein. Eric ist erst 15 Jahre alt, obwohl sein Körper aussieht, als gehöre er jemandem in den Dreißigern. Aber du hast ja gesehen, wie das sein kann..."

# game/scripts/c15/c15.rpy:3300
translate german c15s006_Story_9ff9cb54:

    # mc "Lo había leído, pero las edades reales y aparentes no encajaban."
    mc "Ich hatte es gelesen, aber das tatsächliche und das angegebene Alter stimmten nicht überein."

# game/scripts/c15/c15.rpy:3302
translate german c15s006_Story_2d96ce22:

    # eva "Y no le hubiera importado mataros si hubiera sido necesario, si no hubierais querido firmar... al menos a uno de vosotros, para forzar a los demás."
    eva "Und er hätte nicht gezögert, dich notfalls zu töten, wenn du nicht gewollt hättest... zumindest einer von euch, um die anderen dazu zu zwingen."

# game/scripts/c15/c15.rpy:3303
translate german c15s006_Story_96945c8f:

    # mc "¿Iba en serio lo de matarnos?"
    mc "Meinten sie es ernst damit, uns zu töten?"

# game/scripts/c15/c15.rpy:3305
translate german c15s006_Story_7e100c10:

    # aar "Ya llegaremos al tema de los asesinatos más tarde..."
    aar "Wir werden später auf das Thema der Morde zurückkommen..."

# game/scripts/c15/c15.rpy:3306
translate german c15s006_Story_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c15/c15.rpy:3307
translate german c15s006_Story_9cf5b234:

    # aar "Mas tarde, [mc]."
    aar "Später, [mc]."

# game/scripts/c15/c15.rpy:3309
translate german c15s006_Story_82aff823:

    # aar "En definitiva, en pocos años NTR y GILF tuvieron un pequeño ejército de clones entrenados. Cuando los A teníamos 8 años empezamos a hacer misiones."
    aar "Kurz gesagt, innerhalb weniger Jahre verfügten NTR und GILF über eine kleine Armee trainierter Klone. Als wir 8 Jahre alt waren, begannen wir mit unseren Missionen."

# game/scripts/c15/c15.rpy:3310
translate german c15s006_Story_ad275ac8:

    # aar "Después se unieron los C, los D... Había gobiernos, como el vuestro, que pagaban muy bien por un equipo de mercenarios que no se pudiera relacionar con ellos."
    aar "Dann schlossen sich die C's und die D's an... Es gab Regierungen wie Ihre, die sehr gut für ein Söldnerteam bezahlten, das nicht mit ihnen in Verbindung gebracht werden durfte."

# game/scripts/c15/c15.rpy:3311
translate german c15s006_Story_e24de9ea:

    # aar "Las chicas empezaron con sus misiones hace cuatro años, cuando cumplieron 14. Menos Fiona, que había muerto en un accidente durante el entrenamiento."
    aar "Die Mädchen begannen ihre Missionen vor vier Jahren, als sie 14 Jahre alt wurden. Nur Fiona starb bei einem Unfall während des Trainings."

# game/scripts/c15/c15.rpy:3313
translate german c15s006_Story_3a26c691:

    # mom "Lo siento mucho, Amanda... supongo que... debía ser como una hermana para vosotras."
    mom "Es tut mir so leid, Amanda... Ich glaube... ich sollte wie eine Schwester für dich sein."

# game/scripts/c15/c15.rpy:3314
translate german c15s006_Story_cf031570:

    # ama "No como una hermana... era una hermana de verdad..."
    ama "Nicht wie eine Schwester... sie war eine richtige Schwester..."

# game/scripts/c15/c15.rpy:3316
translate german c15s006_Story_c39c3603:

    # nor "Debió de ser duro para vosotras."
    nor "Das muss schwer für dich gewesen sein."

# game/scripts/c15/c15.rpy:3317
translate german c15s006_Story_21d2693c:

    # eva "Fue la primera en morir. Es un golpe duro cuando ves morir a tu hermana a los 12 años en una explosión."
    eva "Sie starb als Erste. Es ist ein verheerender Schlag, wenn man seine 12-jährige Schwester bei einer Explosion sterben sieht."

# game/scripts/c15/c15.rpy:3318
translate german c15s006_Story_4e64105c:

    # mc "¿12 años? ¡Joder! ¿Cuándo empezasteis a entrenar?"
    mc "12 Jahre alt? Krass! Wann habt ihr denn mit dem Training angefangen?"

# game/scripts/c15/c15.rpy:3320
translate german c15s006_Story_3ce96331:

    # aar "Las chicas empezaron a entrenar a los 6 años. Tenían el cuerpo de una niña de 6 años, pero cuando todo lo que haces es entrenar... te conviertes en bueno. Y ellas son muy buenas."
    aar "Die Mädchen begannen mit sechs Jahren zu trainieren. Sie hatten die Körper von Sechsjährigen, aber wenn man nichts anderes tut, wird man gut. Und sie sind sehr gut."

# game/scripts/c15/c15.rpy:3321
translate german c15s006_Story_e84add3c:

    # mcp "(No puedo evitar imaginarme a [emm] o [dap] con una metralleta con 6 años. Es una imagen ridícula. No puedo imaginar por lo que han pasado Eva y Amanda.)"
    mcp "(Ich kann mir [emm] oder [dap] mit einem Maschinengewehr im Alter von 6 Jahren einfach nicht vorstellen. Es ist ein absurdes Bild. Ich kann mir nicht vorstellen, was Eva und Amanda durchgemacht haben.)"

# game/scripts/c15/c15.rpy:3323
translate german c15s006_Story_04cda04d:

    # aar "Con un suministro cada vez mayor de agentes, NTR creció mucho."
    aar "Dank eines stetig wachsenden Angebots an Agenten konnte NTR stark zulegen."

# game/scripts/c15/c15.rpy:3324
translate german c15s006_Story_da6d06a8:

    # aar "El director de GILF, Richard, sabía que eso podría funcionar por un tiempo limitado, conocía el testamento de los fundadores y sabía que heredaríais... heredaríamos la empresa."
    aar "Richard, der Geschäftsführer von GILF, wusste, dass dies nur für eine begrenzte Zeit funktionieren würde; er kannte den Willen der Gründer und er wusste, dass ihr erben würdet... wir würden das Unternehmen erben."

# game/scripts/c15/c15.rpy:3325
translate german c15s006_Story_4c8cf79a:

    # mc "Y no podía saber qué haríamos con ella o si estaríamos de acuerdo con la forma de operarla."
    mc "Und ich konnte nicht wissen, was wir damit anfangen würden oder ob wir mit der Art und Weise, wie wir es betrieben hatten, noch einverstanden sein würden."

# game/scripts/c15/c15.rpy:3327
translate german c15s006_Story_6d1ab377:

    # aar "Exacto. Pero Richard había sido amigo y compañero de los Fundadores desde el principio y estaba dispuesto a cumplir su última voluntad."
    aar "Genau. Aber Richard war von Anfang an ein Freund und Kollege der Gründer gewesen und war bereit, ihren letzten Wunsch zu erfüllen."

# game/scripts/c15/c15.rpy:3328
translate german c15s006_Story_429f5091:

    # aar "Pero Richard murió hace unos meses. Causas naturales. Su segundo, Xabier, tomó el mando y descubrió el testamento."
    aar "Richard ist jedoch vor einigen Monaten verstorben. Eines natürlichen Todes. Sein Stellvertreter Xabier übernahm die Leitung und entdeckte das Testament."

# game/scripts/c15/c15.rpy:3329
translate german c15s006_Story_efe17ca5:

    # mc "Y él no estaba dispuesto a cumplir con las condiciones."
    mc "Und er war nicht bereit, die Bedingungen zu erfüllen."

# game/scripts/c15/c15.rpy:3331
translate german c15s006_Story_8e805ceb:

    # aar "Exacto. Si moríais antes de que la última cláusula del testamento entrara en vigor, la propiedad de NTR pasaba definitivamente a GILF."
    aar "Das ist richtig. Sollten Sie vor Inkrafttreten der letzten Klausel des Testaments versterben, würde das Eigentum an NTR dauerhaft an GILF übergehen."

# game/scripts/c15/c15.rpy:3332
translate german c15s006_Story_b7be54a4:

    # aar "Se ordenó a la serie XX asesinaros. A todos."
    aar "Die XX-Serie hatte den Befehl, euch alle zu ermorden."

# game/scripts/c15/c15.rpy:3333
translate german c15s006_Story_55a2b5a8:

    # mc "{b}¿Qué?{/b} ¡Nos han estado defendiendo!"
    mc "{b}Was?{/b} Sie haben uns verteidigt!"

# game/scripts/c15/c15.rpy:3335
translate german c15s006_Story_91acd48b:

    # mom "¿Nos iban a matar por una empresa?" (multiple=2)
    mom "Wollten sie uns etwa für ein Unternehmen umbringen?" (multiple=2)

# game/scripts/c15/c15.rpy:3336
translate german c15s006_Story_b1c8da99:

    # nor "¿Tan importante es?" (multiple=2)
    nor "Ist es wirklich so wichtig?" (multiple=2)

# game/scripts/c15/c15.rpy:3338
translate german c15s006_Story_e9cea5ee:

    # eva "No seáis inocentes. La mayoría de los asesinatos tienen que ver con dinero o con poder. Y NTR vale MUCHO dinero, y los propietarios de NTR pueden tener MUCHO poder."
    eva "Sei nicht naiv. Bei den meisten Morden geht es um Geld oder Macht. Und NTR ist sehr viel Geld wert, und NTR-Besitzer können sehr viel Macht haben."

# game/scripts/c15/c15.rpy:3339
translate german c15s006_Story_ee93f2ac:

    # eva "La orden de asesinato tenía una parte oculta. La que nos llegó a nosotras decía que cuando acabáramos con vosotros teníamos que matar también a los A."
    eva "Der Mordauftrag enthielt eine versteckte Klausel. In der uns vorliegenden stand, dass wir, sobald wir mit euch fertig seien, auch die A's töten müssten."

# game/scripts/c15/c15.rpy:3341
translate german c15s006_Story_9fb6de33:

    # ama "Erais unos civiles, con lo que no se dedicaron muchos recursos. Cinco agentes a la caza de seis civiles. Una misión fácil."
    ama "Da Sie Zivilisten waren, wurden nicht viele Ressourcen dafür eingesetzt. Fünf Agenten jagten sechs Zivilisten. Eine einfache Mission."

# game/scripts/c15/c15.rpy:3343
translate german c15s006_Story_45cf3476:

    # aar "Cuando las chicas recibieron las órdenes, vinieron a vernos a Arnau y a mí a explicarnos las órdenes que habían recibido respecto a nosotros."
    aar "Als die Mädchen die Befehle erhielten, kamen sie zu Arnau und mir, um uns die Befehle zu erklären, die sie bezüglich uns erhalten hatten."

# game/scripts/c15/c15.rpy:3344
translate german c15s006_Story_0ef75901:

    # aar "Debía tratarse de un error. Arnau fue a hablar con Xabier para aclararlo y nunca volvió. Nosotros nos fuimos de la base. Pudimos huir por los pelos."
    aar "Das muss ein Irrtum gewesen sein. Arnau ging zu Xabier, um die Sache aufzuklären, und kam nie zurück. Wir verließen die Basis. Wir sind nur knapp entkommen."

# game/scripts/c15/c15.rpy:3345
translate german c15s006_Story_305abcf0:

    # mc "Y fue cuando decidisteis protegernos, ¿no?"
    mc "Und genau da hast du beschlossen, uns zu beschützen, richtig?"

# game/scripts/c15/c15.rpy:3347
translate german c15s006_Story_7a277806:

    # eva "Ya sabes... el enemigo de mi enemigo... Si os querían muertos sería por algo y nosotros aún no sabíamos por qué."
    eva "Weißt du... der Feind meines Feindes... Wenn sie dich tot sehen wollten, musste es dafür einen Grund gegeben haben, und wir wussten immer noch nicht, warum."

# game/scripts/c15/c15.rpy:3349
translate german c15s006_Story_cb647f23:

    # ama "Aaron y Claire investigaron y descubrieron la cláusula del testamento mientras Eva y yo protegíamos a la familia en Newport, y Beatrice y Diana te protegían a ti en Portland."
    ama "Aaron und Claire ermittelten und entdeckten die Klausel im Testament, während Eva und ich die Familie in Newport beschützten und Beatrice und Diana dich in Portland beschützten."

# game/scripts/c15/c15.rpy:3350
translate german c15s006_Story_1a127223:

    # ama "Como es normal en estos casos, la información fluía entre nosotros, con lo que, cuando llegaste a Newport, sabíamos mucho de ti."
    ama "Wie in solchen Fällen üblich, flossen Informationen zwischen uns, sodass wir bei Ihrer Ankunft in Newport bereits viel über Sie wussten."

# game/scripts/c15/c15.rpy:3352
translate german c15s006_Story_6e917ecd:

    # aar "Decidimos que, si queríamos sobrevivir, erais nuestra mejor opción. Además, lo que hacía Xabier iba en contra de la voluntad de los Fundadores."
    aar "Wir kamen zu dem Schluss, dass Sie unsere beste Option waren, wenn wir überleben wollten. Außerdem widersprach Xabiers Vorgehen den Wünschen der Gründer."

# game/scripts/c15/c15.rpy:3353
translate german c15s006_Story_fd9977e5:

    # aar "Pero la mayoría de los agentes, menos los G, son buenos. Nos acabaron encontrando."
    aar "Aber die meisten Agenten, außer den Gs, sind gut. Sie haben uns schließlich gefunden."

# game/scripts/c15/c15.rpy:3354
translate german c15s006_Story_4df10028:

    # aar "Primero murió Claire, después Beatrice y Diana. Ahora solo quedamos nosotros tres."
    aar "Zuerst starb Claire, dann Beatrice und Diana. Jetzt sind nur noch wir drei übrig."

# game/scripts/c15/c15.rpy:3355
translate german c15s006_Story_0801f748:

    # mc "¿Y qué va a pasar ahora? ¿Van a seguir intentando asesinarnos?"
    mc "Und was wird nun geschehen? Werden sie weiterhin versuchen, uns zu töten?"

# game/scripts/c15/c15.rpy:3357
translate german c15s006_Story_a13e8619:

    # ama "No. Una vez entró en vigor la cláusula, mataros no tiene sentido. Por eso Eric quería que firmarais el traspaso de acciones."
    ama "Nein. Sobald die Klausel in Kraft trat, ist es sinnlos, dich zu töten. Deshalb wollte Eric, dass du den Aktienübertragungsvertrag unterschreibst."

# game/scripts/c15/c15.rpy:3358
translate german c15s006_Story_8f638558:

    # ama "Tampoco tiene sentido que nos den caza a nosotros. Ya tenemos el control de NTR y Aaron ha cancelado las órdenes."
    ama "Es macht auch für sie keinen Sinn, uns zu jagen. Wir haben NTR bereits unter Kontrolle, und Aaron hat die Befehle storniert."

# game/scripts/c15/c15.rpy:3360
translate german c15s006_Story_ee3f23fd:

    # eva "Hemos tenido que falsificar alguna de vuestras firmas... *Risita*"
    eva "Wir mussten einige Ihrer Unterschriften fälschen... *Kichert*"

# game/scripts/c15/c15.rpy:3362
translate german c15s006_Story_0bbb8565:

    # aar "Xabier ha sido apartado de su puesto y ahora está todo bajo control... más o menos."
    aar "Xabier wurde von seinem Posten entfernt und jetzt ist alles mehr oder weniger unter Kontrolle."

# game/scripts/c15/c15.rpy:3363
translate german c15s006_Story_9c1a047c:

    # mc "¿Más o menos?"
    mc "Mehr oder weniger?"

# game/scripts/c15/c15.rpy:3364
translate german c15s006_Story_ec76c9ea:

    # aar "Hay todavía algún agente con el que no hemos logrado contactar para anular sus órdenes, pero estará resuelto en los próximos días."
    aar "Es gibt noch einige Agenten, die wir nicht erreichen konnten, um ihre Bestellungen zu stornieren, aber das wird sich in den nächsten Tagen klären."

# game/scripts/c15/c15.rpy:3404
translate german c15s007_KiaraHouse_35660b71:

    # "Por fin llega la hora de ir a casa de Eileen y Kiara a buscar sus cosas. Esperas que Solomon no esté allí."
    "Endlich ist es soweit, wir fahren zu Eileen und Kiara, um ihre Sachen zu holen. Hoffentlich ist Solomon nicht da."

# game/scripts/c15/c15.rpy:3405
translate german c15s007_KiaraHouse_d9eadcbf:

    # "Llamas a Alexia y quedáis en la puerta. Está a punto de terminar su turno y os acompañará antes de volver a la comisaría."
    "Du rufst Alexia an und verabredest dich mit ihr an der Tür. Sie hat gerade Feierabend und wird dich begleiten, bevor sie zur Polizeiwache zurückkehrt."

# game/scripts/c15/c15.rpy:3408
translate german c15s007_KiaraHouse_8de98c3a:

    # "Antes de salir le das a Eileen una de las pruebas de embarazo de Aaron, ponéis la gota de sangre y la guarda en su habitación."
    "Bevor du gehst, gibst du Eileen einen von Aarons Schwangerschaftstests, gibst den Tropfen Blut darauf und sie bewahrt ihn in ihrem Zimmer auf."

# game/scripts/c15/c15.rpy:3409
translate german c15s007_KiaraHouse_742d918d:

    # "Explicarle de dónde ha salido ha sido difícil. Contarle la verdad sobre [eri], [emm] y [dap] ha sido una odisea."
    "Es war schwierig zu erklären, woher es kam. Ihm die Wahrheit über [eri], [emm] und [dap] zu sagen, war eine Tortur."

# game/scripts/c15/c15.rpy:3411
translate german c15s007_KiaraHouse_0c5702e1:

    # "Coges otra prueba para Alexia."
    "Du holst einen weiteren Test für Alexia ab."

# game/scripts/c15/c15.rpy:3413
translate german c15s007_KiaraHouse_55b681dd:

    # "Antes de salir coges una de las pruebas de embarazo de Aaron para dársela a Alexia. Tendrás que explicarle de dónde ha salido."
    "Bevor du gehst, nimmst du einen von Aarons Schwangerschaftstests mit, um ihn Alexia zu geben. Du musst ihr erklären, woher er stammt."

# game/scripts/c15/c15.rpy:3415
translate german c15s007_KiaraHouse_48823e75:

    # "Aprovechas el viaje para explicarle también a Kiara la situación de [eri], [emm], [dap], Amanda y Eva."
    "Du nutzt die Reise auch, um Kiara die Situation von [eri], [emm], [dap], Amanda und Eva zu erklären."

# game/scripts/c15/c15.rpy:3417
translate german c15s007_KiaraHouse_0af164cc:

    # "Aprovechas el viaje para explicarles a Eileen y a Kiara la situación de [eri], [emm], [dap], Amanda y Eva."
    "Du nutzt die Reise, um Eileen und Kiara die Situation von [eri], [emm], [dap], Amanda und Eva zu erklären."

# game/scripts/c15/c15.rpy:3418
translate german c15s007_KiaraHouse_e9358946:

    # "Lo vas a llamar La Conversación de los Clones. O simplemente \"La Conversación\". La vas a tener mucho en los próximos días."
    "Sie werden es „Das Klon-Gespräch“ nennen. Oder einfach „Das Gespräch“. Sie werden es in den kommenden Tagen oft hören."

# game/scripts/c15/c15.rpy:3419
translate german c15s007_KiaraHouse_193cf1fe:

    # "Flipan. Hablan entre ellas. Prometen guardar el secreto. Caen en un silencio pensativo hasta estar cerca de su casa."
    "Sie sind verblüfft. Sie tuscheln untereinander. Sie versprechen, es geheim zu halten. Sie verfallen in nachdenkliches Schweigen, bis sie fast zu Hause sind."

# game/scripts/c15/c15.rpy:3422
translate german c15s007_KiaraHouse_505890c5:

    # mc "¿Nerviosas?"
    mc "Nervös?"

# game/scripts/c15/c15.rpy:3423
translate german c15s007_KiaraHouse_299e1217:

    # eil "No deberíamos estarlo. Tan solo volvemos a casa a por unas cosas, pero..."
    eil "Eigentlich sollten wir das nicht. Wir fahren nur kurz nach Hause, um ein paar Sachen zu holen, aber..."

# game/scripts/c15/c15.rpy:3425
translate german c15s007_KiaraHouse_af3c5ba5:

    # kia "Pero parece que volvamos como unas ladronas... es una sensación rara..."
    kia "Aber es fühlt sich an, als würden wir wie Diebe zurückkehren... es ist ein seltsames Gefühl..."

# game/scripts/c15/c15.rpy:3426
translate german c15s007_KiaraHouse_e2538f64:

    # kia "He llamado a mi vecina y me ha dicho que Solomon no está en casa, con lo que no debería haber problemas."
    kia "Ich habe meine Nachbarin angerufen und sie sagte, Solomon sei nicht zu Hause, also sollte es keine Probleme geben."

# game/scripts/c15/c15.rpy:3427
translate german c15s007_KiaraHouse_cdc1add0:

    # mc "Bueno, cojamos las cosas antes de que vuelva y no tendremos ningún problema. Alexia ya debe estar allí."
    mc "Okay, packen wir unsere Sachen, bevor sie zurückkommt, dann gibt es keine Probleme. Alexia müsste schon da sein."

# game/scripts/c15/c15.rpy:3430
translate german c15s007_KiaraHouse_e9cda0cf:

    # mc "Gracias por venir, Alexia."
    mc "Danke fürs Kommen, Alexia."

# game/scripts/c15/c15.rpy:3432
translate german c15s007_KiaraHouse_3d306583:

    # oma "Es lo menos que podía hacer, ¿no? Para eso estamos las amigas"
    oma "Das ist doch das Mindeste, was ich tun kann, oder? Dafür sind Freunde schließlich da."

# game/scripts/c15/c15.rpy:3433
translate german c15s007_KiaraHouse_b618bf92:

    # mc "Tengo que hablar contigo un momento."
    mc "Ich muss kurz mit dir sprechen."

# game/scripts/c15/c15.rpy:3435
translate german c15s007_KiaraHouse_df29e7bd:

    # kia "Os dejamos que habléis mientras vamos trayendo cosas. Supongo que vas a tener \"La Conversación\"."
    kia "Wir lassen euch zwei jetzt allein, während wir die Sachen hereinbringen. Ich nehme an, ihr werdet „das Gespräch“ führen."

# game/scripts/c15/c15.rpy:3436
translate german c15s007_KiaraHouse_8013bb0b:

    # mc "Sí, es algo que quiero que sepa toda la familia lo antes posible."
    mc "Ja, ich möchte, dass die ganze Familie das so schnell wie möglich erfährt."

# game/scripts/c15/c15.rpy:3438
translate german c15s007_KiaraHouse_3f1adecd:

    # oma "¿Que es eso de La Conversación? Casi se podían escuchar las mayúsculas."
    oma "Was hat es mit „The Conversation“ auf sich? Man konnte die Großbuchstaben fast hören."

# game/scripts/c15/c15.rpy:3439
translate german c15s007_KiaraHouse_e13243d4:

    # mc "Te acuerdas de que te llamé el lunes mientras llevabas a tu abuelo a San Diego, ¿verdad?"
    mc "Du erinnerst dich doch, dass ich dich am Montag angerufen habe, als du deinen Großvater nach San Diego gebracht hast, richtig?"

# game/scripts/c15/c15.rpy:3441
translate german c15s007_KiaraHouse_45c4f46b:

    # "Le explicas el secuestro, por qué la llamaste ese día mientras conducía a San Diego, y todo lo que ha pasado desde entonces."
    "Sie erklären die Entführung, warum Sie sie an jenem Tag während der Fahrt nach San Diego angerufen haben und alles, was seitdem geschehen ist."

# game/scripts/c15/c15.rpy:3442
translate german c15s007_KiaraHouse_1a5d58e4:

    # "También todo lo que va a pasar a partir de ahora y el secreto familiar."
    "Außerdem alles, was von nun an geschehen wird, und das Familiengeheimnis."

# game/scripts/c15/c15.rpy:3444
translate german c15s007_KiaraHouse_0e6979b3:

    # oma "Es alucinante... parece sacado de una novela mala de ciencia ficción y espionaje escrita por un escritor tarado..."
    oma "Es ist unfassbar... es wirkt wie aus einem schlechten Science-Fiction-Spionageroman, geschrieben von einem geistesgestörten Autor..."

# game/scripts/c15/c15.rpy:3445
translate german c15s007_KiaraHouse_968dde08:

    # mc "Yo he pensado lo mismo cuando nos han dicho que sobre el accidente hubo sospechas de sabotaje."
    mc "Ich dachte dasselbe, als uns mitgeteilt wurde, dass der Verdacht auf Sabotage im Zusammenhang mit dem Unfall bestehe."

# game/scripts/c15/c15.rpy:3447
translate german c15s007_KiaraHouse_4fb1e461:

    # oma "Gracias por confiar en mí, [mc]... supongo que también tendré que agradecérselo a [mar] y [nor]."
    oma "Vielen Dank für Ihr Vertrauen, [mc]... Ich nehme an, ich muss mich auch bei [mar] und [nor] bedanken."

# game/scripts/c15/c15.rpy:3449
translate german c15s007_KiaraHouse_cda2c728:

    # mc "¿Cómo querías que no confiara en mi novia? Te confiaría mi vida."
    mc "Wie konntest du erwarten, dass ich meiner Freundin nicht vertraue? Dir würde ich mein Leben anvertrauen."

# game/scripts/c15/c15.rpy:3451
translate german c15s007_KiaraHouse_f99c9cfc:

    # mc "¿Cómo querías que no confiara en ti? Te confiaría mi vida."
    mc "Wie konntest du erwarten, dass ich dir nicht vertraue? Ich würde dir mein Leben anvertrauen."

# game/scripts/c15/c15.rpy:3452
translate german c15s007_KiaraHouse_5a1ff281:

    # oma "Pero... no sé... después de lo de ayer... ahora esto... ¿me podéis adoptar?"
    oma "Aber... ich weiß nicht... nach dem, was gestern passiert ist... und jetzt das... könnt ihr mich adoptieren?"

# game/scripts/c15/c15.rpy:3453
translate german c15s007_KiaraHouse_9ae2b2cf:

    # mc "Yo creía que ya lo habíamos hecho. *Risa*"
    mc "Ich dachte, wir hätten das schon hinter uns. *lacht*"

# game/scripts/c15/c15.rpy:3456
translate german c15s007_KiaraHouse_2e616ea7:

    # oma "Genial, pero... ¿cuánto vas a tardar en darme el test? Me muero de ganas por saberlo."
    oma "Super, aber... wie lange dauert es, bis ich den Test bekomme? Ich bin schon ganz gespannt."

# game/scripts/c15/c15.rpy:3457
translate german c15s007_KiaraHouse_a5ae2e37:

    # mc "Alexia, el test tarda 24 horas en dar el resultado. ¿No querrías hacerlo en casa, más tranquila?"
    mc "Alexia, das Testergebnis liegt erst nach 24 Stunden vor. Wäre es dir nicht lieber, den Test zu Hause zu machen, wo du dich entspannen kannst?"

# game/scripts/c15/c15.rpy:3459
translate german c15s007_KiaraHouse_80c99b29:

    # oma "Soy la primera latina en tu vida, ¿verdad?"
    oma "Ich bin die erste Latina in deinem Leben, richtig?"

# game/scripts/c15/c15.rpy:3460
translate german c15s007_KiaraHouse_22367688:

    # oma "¡Lo quiero ahora! *Risa* No me hagas cometer un delito y robártelo."
    oma "Ich will es jetzt! *lacht* Bring mich nicht dazu, ein Verbrechen zu begehen und es dir zu stehlen."

# game/scripts/c15/c15.rpy:3461
translate german c15s007_KiaraHouse_caf77453:

    # mc "Vale, vale. Ahora te lo doy."
    mc "Okay, okay. Ich gebe es dir jetzt."

# game/scripts/c15/c15.rpy:3463
translate german c15s007_KiaraHouse_438aa405:

    # "Coges el test de la guantera y lo abres. Buscas un sitio donde hacerlo y no encuentras ninguno mejor que el asiento del copiloto."
    "Du nimmst den Test aus dem Handschuhfach und öffnest es. Du suchst nach einem geeigneten Platz dafür und findest keinen besseren als den Beifahrersitz."

# game/scripts/c15/c15.rpy:3464
translate german c15s007_KiaraHouse_5ddf1c56:

    # "Sacáis una gota de sangre del dedo de Alexia, la ponéis en la tira de plástico, y la introducís en la máquina. Se enciende una luz roja."
    "Man nimmt einen Tropfen Blut von Alexias Finger, gibt ihn auf den Plastikstreifen und führt diesen in das Gerät ein. Eine rote Lampe leuchtet auf."

# game/scripts/c15/c15.rpy:3466
translate german c15s007_KiaraHouse_f0fdd940:

    # oma "¿Qué es esa luz roja? ¿Significa que no estoy embarazada? ¿O que lo estoy?"
    oma "Was bedeutet dieses rote Licht? Heißt es, dass ich nicht schwanger bin? Oder dass ich es bin?"

# game/scripts/c15/c15.rpy:3467
translate german c15s007_KiaraHouse_912d48a3:

    # mc "Significa que ha reconocido la tira de plástico y que hay sangre dentro. Se pondrá verde cuando tenga el resultado mañana a esta hora."
    mc "Das bedeutet, dass der Teststreifen erkannt wurde und sich Blut darin befindet. Er wird grün leuchten, wenn ich morgen um diese Zeit das Ergebnis erhalte."

# game/scripts/c15/c15.rpy:3468
translate german c15s007_KiaraHouse_e3b61f66:

    # mc "La otra luz se pondrá verde si el resultado es positivo y roja si es negativo."
    mc "Die andere Lampe leuchtet grün, wenn das Ergebnis positiv ist, und rot, wenn es negativ ist."

# game/scripts/c15/c15.rpy:3470
translate german c15s007_KiaraHouse_68ac5c07:

    # oma "¿Y si se queda sin batería?"
    oma "Was passiert, wenn der Akku leer ist?"

# game/scripts/c15/c15.rpy:3471
translate german c15s007_KiaraHouse_d6fd4739:

    # mc "Alexia, es una empresa de tecnología punta que hace clones. Creo que habrán pensado en ponerle la batería suficiente para que pueda funcionar durante 24 horas."
    mc "Alexia ist ein innovatives Technologieunternehmen, das Klone herstellt. Ich denke, sie haben sicherlich darüber nachgedacht, einen Akku einzubauen, der für 24 Stunden Laufzeit ausreicht."

# game/scripts/c15/c15.rpy:3472
translate german c15s007_KiaraHouse_ceb1c2d3:

    # oma "Tienes razón... es que estoy muy nerviosa... es la primera vez que quiero estar embarazada en mi vida..."
    oma "Du hast recht... Ich bin einfach so nervös... Es ist das erste Mal, dass ich mir wünsche, schwanger zu sein..."

# game/scripts/c15/c15.rpy:3473
translate german c15s007_KiaraHouse_bf1793d4:

    # mc "Mañana sabremos si lo estás. ¿Te lo quieres llevar?"
    mc "Wir wissen morgen, ob du es bist. Möchtest du es nehmen?"

# game/scripts/c15/c15.rpy:3475
translate german c15s007_KiaraHouse_3009562d:

    # oma "No, mejor llévatelo tú. Imagínate que me lo dejo en el coche patrulla y lo coge otro compañero sin saber qué es."
    oma "Nein, du solltest es nehmen. Stell dir vor, ich ließe es im Streifenwagen liegen und ein anderer Beamter nähme es mit, ohne zu wissen, was es ist."

# game/scripts/c15/c15.rpy:3476
translate german c15s007_KiaraHouse_f2e15f15:

    # mc "Vale, lo meteré en la guantera y al llegar a casa..."
    mc "Okay, ich lege es ins Handschuhfach und wenn ich nach Hause komme..."

# game/scripts/c15/c15.rpy:3478
translate german c15s007_KiaraHouse_f3c00517:

    # eil "Aquí está la bici. Mi madre está llenando sus maletas. Ahora voy a llenar yo las mías."
    eil "Hier ist das Fahrrad. Meine Mutter packt ihre Koffer. Jetzt packe ich meine."

# game/scripts/c15/c15.rpy:3479
translate german c15s007_KiaraHouse_657d8c2b:

    # mc "¿Necesitáis ayuda?"
    mc "Benötigen Sie Hilfe?"

# game/scripts/c15/c15.rpy:3481
translate german c15s007_KiaraHouse_6cefec08:

    # eil "Gracias, pero no. No te quiero ver revolviendo entre mi ropa. *Risa*"
    eil "Danke, aber nein. Ich möchte nicht, dass du in meinen Kleidern herumwühlst. *lacht*"

# game/scripts/c15/c15.rpy:3482
translate german c15s007_KiaraHouse_891de431:

    # mc "Yo tenía pensado robarte el uniforme de animadora. *Risa*"
    mc "Ich hatte vor, deine Cheerleader-Uniform zu klauen. *lacht*"

# game/scripts/c15/c15.rpy:3483
translate german c15s007_KiaraHouse_784e493f:

    # eil "Voy a empezar a recoger la ropa. Os dejo con La Conversación."
    eil "Ich fange jetzt an, die Kleidung wegzuräumen. Zum Schluss noch „The Conversation“."

# game/scripts/c15/c15.rpy:3485
translate german c15s007_KiaraHouse_cc7205ff:

    # oma "Ya la hemos tenido. Es totalmente increíble."
    oma "Wir haben es schon erlebt. Es ist absolut unglaublich."

# game/scripts/c15/c15.rpy:3487
translate german c15s007_KiaraHouse_058208ae:

    # oma "Y ya hemos hecho el test también."
    oma "Und wir haben den Test auch schon durchgeführt."

# game/scripts/c15/c15.rpy:3488
translate german c15s007_KiaraHouse_e0828f32:

    # mc "Ahora solo falta esperar las 24 horas para saber el resultado."
    mc "Jetzt müssen wir nur noch 24 Stunden warten, um das Ergebnis zu erfahren."

# game/scripts/c15/c15.rpy:3491
translate german c15s007_KiaraHouse_c381f290:

    # eil "El tuyo y el mío darán el resultado con una hora de diferencia..."
    eil "Deine und meine Messung liefern das Ergebnis im Abstand von einer Stunde..."

# game/scripts/c15/c15.rpy:3492
translate german c15s007_KiaraHouse_081330e5:

    # eil "¿Quieres que los miremos juntas? Yo estaré en el trabajo cuando pasen las 24 horas del mío."
    eil "Wollen wir sie zusammen anschauen? Ich bin auf der Arbeit, wenn meine 24-Stunden-Schicht endet."

# game/scripts/c15/c15.rpy:3494
translate german c15s007_KiaraHouse_e60f6be0:

    # oma "Te paso a buscar mañana por el trabajo y vamos a casa de [mc]. Así los podremos mirar juntas, no te preocupes."
    oma "Ich hole dich morgen von der Arbeit ab und wir fahren zu [mc] nach Hause. Dann können wir sie uns zusammen ansehen, keine Sorge."

# game/scripts/c15/c15.rpy:3495
translate german c15s007_KiaraHouse_3f262791:

    # oma "Ahora hay que convencer a éste de que no los mire sin nosotras allí."
    oma "Jetzt müssen wir ihn davon überzeugen, dass er sie nicht ohne uns anschaut."

# game/scripts/c15/c15.rpy:3496
translate german c15s007_KiaraHouse_9de3276e:

    # mc "¡Hey! ¡Estoy aquí! Tranquilas, no lo voy a mirar sin vosotras delante."
    mc "Hey! Ich bin da! Keine Sorge, ich werde es mir nicht ansehen, ohne dass ihr dabei seid."

# game/scripts/c15/c15.rpy:3497
translate german c15s007_KiaraHouse_89338246:

    # mc "Eileen, hay unas maletas esperándote. ¿Podemos hablar luego del tema? No me gustaría que tu padre llegara y nos pillara aquí."
    mc "Eileen, da warten ein paar Koffer auf dich. Können wir später darüber reden? Ich möchte nicht, dass dein Vater kommt und uns hier erwischt."

# game/scripts/c15/c15.rpy:3499
translate german c15s007_KiaraHouse_ba97cdcc:

    # eil "Tranquilo, no volverá hasta medianoche, pero tienes razón, voy a llenar las maletas. Hasta ahora."
    eil "Keine Sorge, er kommt erst um Mitternacht zurück, aber du hast recht, ich packe jetzt meine Sachen. Bis später."

# game/scripts/c15/c15.rpy:3500
translate german c15s007_KiaraHouse_4996e67f:

    # mc "Te esperamos aquí."
    mc "Wir erwarten Sie hier."

# game/scripts/c15/c15.rpy:3502
translate german c15s007_KiaraHouse_600034e3:

    # mc "La situación de Eileen y Kiara es muy jodida."
    mc "Die Situation zwischen Eileen und Kiara ist wirklich verfahren."

# game/scripts/c15/c15.rpy:3503
translate german c15s007_KiaraHouse_20bbc1e1:

    # oma "Sí que lo es. Si Kiara no quiere denunciar, no podemos hacer nada si no lo pillamos in fraganti."
    oma "Ja, das stimmt. Wenn Kiara es nicht melden will, können wir nichts tun, außer wir ertappen ihn auf frischer Tat."

# game/scripts/c15/c15.rpy:3504
translate german c15s007_KiaraHouse_43c63566:

    # mc "¿Ni siquiera con el testimonio de Eileen?"
    mc "Nicht einmal Eileens Aussage?"

# game/scripts/c15/c15.rpy:3506
translate german c15s007_KiaraHouse_ab10cb2a:

    # oma "Es complicado. Cuando se produjo la agresión, Eileen no estaba. Cuando llegó no hubo más violencia, y la violencia de hace años no nos sirve de nada ahora."
    oma "Es ist kompliziert. Eileen war nicht da, als der Angriff geschah. Als sie ankam, gab es keine Gewalt mehr, und die Gewalt von damals nützt uns jetzt nichts mehr."

# game/scripts/c15/c15.rpy:3507
translate german c15s007_KiaraHouse_3c0d9d26:

    # mc "Por suerte ahora están a salvo en casa de [nor]."
    mc "Zum Glück sind sie jetzt in Sicherheit im Haus von [nor]."

# game/scripts/c15/c15.rpy:3508
translate german c15s007_KiaraHouse_b5ce8526:

    # oma "Sí, pero ¿qué pasará cuando vuelvan aquí la semana que viene?"
    oma "Ja, aber was passiert, wenn sie nächste Woche wiederkommen?"

# game/scripts/c15/c15.rpy:3509
translate german c15s007_KiaraHouse_ae2d41ee:

    # mc "Si Solomon es inteligente, las tratará como reinas porque debe estar acojonado ahora mismo."
    mc "Wenn Salomo klug ist, wird er sie wie Königinnen behandeln, denn er muss jetzt entsetzt sein."

# game/scripts/c15/c15.rpy:3511
translate german c15s007_KiaraHouse_2d3b1c23:

    # oma "¡Venga ya! Si fuera inteligente no habría hecho lo que ha hecho. Además, ese tipo de personas difícilmente cambian."
    oma "Ach komm schon! Wenn sie klug wäre, hätte sie das nicht getan. Außerdem ändern sich solche Leute selten."

# game/scripts/c15/c15.rpy:3512
translate german c15s007_KiaraHouse_81876fb1:

    # mc "Es lo que le dije a Kiara..."
    mc "Das habe ich Kiara gesagt..."

# game/scripts/c15/c15.rpy:3513
translate german c15s007_KiaraHouse_164c2a16:

    # oma "El mayor problema es que no tienen donde ir... o no quieren tener donde ir. Yo les he ofrecido mi casa..."
    oma "Das größte Problem ist, dass sie nirgendwo hin können... oder nirgendwo hin wollen. Ich habe ihnen mein Haus angeboten..."

# game/scripts/c15/c15.rpy:3514
translate german c15s007_KiaraHouse_e90670f1:

    # mc "Y en mi casa se pueden quedar tanto tiempo como quieran, pero Kiara tiene prisa en volver a la suya."
    mc "Sie können so lange bei mir bleiben, wie sie wollen, aber Kiara hat es eilig, wieder in ihr Haus zurückzukehren."

# game/scripts/c15/c15.rpy:3516
translate german c15s007_KiaraHouse_a93e5aab:

    # oma "¿No la tendrías tú? En tu casa son invitadas, pero su casa es esta. No es un hogar, pero es su casa."
    oma "Würdest du das nicht auch wollen? Sie sind zwar Gäste in deinem Haus, aber es ist ihr Zuhause. Es ist kein Zuhause, sondern ihr Haus."

# game/scripts/c15/c15.rpy:3517
translate german c15s007_KiaraHouse_ad6ac7ea:

    # mc "Lo entiendo, pero ¿y si la próxima vez Solomon no se contenta con hacerle unos hematomas?"
    mc "Ich verstehe, aber was ist, wenn Solomon sich beim nächsten Mal nicht damit zufriedengibt, ihm nur blaue Flecken zuzufügen?"

# game/scripts/c15/c15.rpy:3518
translate german c15s007_KiaraHouse_68527cba:

    # oma "Entonces tendrá que denunciar, o irse, o..."
    oma "Dann muss er es melden, oder gehen, oder..."

# game/scripts/c15/c15.rpy:3520
translate german c15s007_KiaraHouse_0d05effb:

    # "Radio" "Martínez, ¿estás operativa todavía? Todavía veo la chatarra de tu coche en el aparcamiento."
    "Radio" "Martinez, arbeiten Sie noch? Ich sehe immer noch das Wrack Ihres Wagens auf dem Parkplatz."

# game/scripts/c15/c15.rpy:3522
translate german c15s007_KiaraHouse_55f41ab6:

    # oma "Sí, Schrute. He acabado mi turno, pero estoy haciendo un último servicio. Dime."
    oma "Ja, Schrute. Meine Schicht ist vorbei, aber ich mache noch einen letzten Anruf. Sag mir Bescheid."

# game/scripts/c15/c15.rpy:3526
translate german c15s007_KiaraHouse_4975e053:

    # sch "Ha habido un accidente en Mill Road. ¿Te puedes acercar?"
    sch "Auf der Mill Road hat sich ein Unfall ereignet. Können Sie kommen?"

# game/scripts/c15/c15.rpy:3527
translate german c15s007_KiaraHouse_00e4560a:

    # oma "¿No pueden ir Jones o Garcia? Hace una hora que han empezado su turno."
    oma "Können Jones oder Garcia nicht gehen? Sie haben ihre Schicht vor einer Stunde begonnen."

# game/scripts/c15/c15.rpy:3528
translate german c15s007_KiaraHouse_4cb0461b:

    # sch "Ahí está el problema. El accidente lo ha tenido Jones contra un civil. Él está bien, pero su coche no. El civil necesitará atención. Ya he enviado la grúa y la ambulancia."
    sch "Das ist das Problem. Jones hatte einen Unfall mit einem Zivilisten. Ihm geht es gut, aber sein Auto ist beschädigt. Der Zivilist benötigt medizinische Versorgung. Ich habe bereits den Abschleppwagen und den Krankenwagen geschickt."

# game/scripts/c15/c15.rpy:3529
translate german c15s007_KiaraHouse_2633fd2e:

    # sch "Y antes de que preguntes, Garcia está en un servicio, esta vez no se está escaqueando."
    sch "Und bevor Sie fragen: Garcia ist im Dienst, dieses Mal drückt er sich nicht vor seinen Pflichten."

# game/scripts/c15/c15.rpy:3530
translate german c15s007_KiaraHouse_aba38a4c:

    # oma "Lo entiendo. Voy para allá."
    oma "Ich verstehe. Ich bin unterwegs."

# game/scripts/c15/c15.rpy:3531
translate german c15s007_KiaraHouse_2c87ba1a:

    # sch "Gracias, preciosa. Trae a Jones aquí. Le tendrás que dejar tu coche patrulla para esta noche."
    sch "Danke, Liebling. Bring Jones her. Du musst ihm heute Abend deinen Streifenwagen überlassen."

# game/scripts/c15/c15.rpy:3532
translate german c15s007_KiaraHouse_060e0583:

    # oma "Corto y cierro."
    oma "Ich bin fertig."

# game/scripts/c15/c15.rpy:3534
translate german c15s007_KiaraHouse_723ab410:

    # oma "Ya lo has oído, me tengo que ir."
    oma "Ihr habt mich schon gehört, ich muss los."

# game/scripts/c15/c15.rpy:3535
translate german c15s007_KiaraHouse_dd3faeed:

    # mc "Ya, el deber es lo primero. No te preocupes, ya me quedo yo con Kiara y Eileen."
    mc "Ja, die Pflicht geht vor. Keine Sorge, ich kümmere mich um Kiara und Eileen."

# game/scripts/c15/c15.rpy:3536
translate german c15s007_KiaraHouse_29c7394c:

    # oma "Llámame si hay algún problema. En cuanto acabe vendré, no me debería llevar más de 30 o 40 minutos..."
    oma "Rufen Sie mich an, falls es Probleme gibt. Ich komme, sobald ich fertig bin; es sollte nicht länger als 30 oder 40 Minuten dauern."

# game/scripts/c15/c15.rpy:3537
translate german c15s007_KiaraHouse_d441cc08:

    # mc "En 30 minutos ya no deberíamos estar aquí, no te preocupes. Y ya has oído a Eileen, su padre no volverá hasta medianoche."
    mc "Wir sollten nicht in 30 Minuten hier sein, keine Sorge. Und du hast Eileen gehört, ihr Vater kommt erst um Mitternacht zurück."

# game/scripts/c15/c15.rpy:3538
translate german c15s007_KiaraHouse_31fcb459:

    # oma "De todas formas, llámame o escríbeme cuando estéis en casa. Me quedaré más tranquila. Yo te llamaré cuando acabe, por si aún estáis aquí."
    oma "Ruf mich an oder schreib mir eine SMS, wenn du zu Hause bist. Das würde mir guttun. Ich melde mich, wenn ich fertig bin, nur für den Fall, dass du noch da bist."

# game/scripts/c15/c15.rpy:3541
translate german c15s007_KiaraHouse_e3496bc5:

    # oma "Te quiero."
    oma "Ich liebe dich."

# game/scripts/c15/c15.rpy:3542
translate german c15s007_KiaraHouse_6616e794:

    # mc "Yo también te quiero."
    mc "Ich liebe dich auch."

# game/scripts/c15/c15.rpy:3545
translate german c15s007_KiaraHouse_046d047e:

    # mc "Perfecto, te llamo luego."
    mc "Perfekt, ich rufe dich später an."

# game/scripts/c15/c15.rpy:3546
translate german c15s007_KiaraHouse_56a81578:

    # oma "Hasta luego."
    oma "Bis später."

# game/scripts/c15/c15.rpy:3549
translate german c15s007_KiaraHouse_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c15/c15.rpy:3551
translate german c15s007_KiaraHouse_4734d7b5:

    # eil "¿Dónde está Alexia?"
    eil "Wo ist Alexia?"

# game/scripts/c15/c15.rpy:3552
translate german c15s007_KiaraHouse_ba6bbf0d:

    # mc "La han llamado para un servicio de urgencia. Si no habéis terminado cuando lo acabe, volverá."
    mc "Sie wurde zu einem Notfalleinsatz gerufen. Falls Sie bis dahin noch nicht fertig sind, kommt sie zurück."

# game/scripts/c15/c15.rpy:3554
translate german c15s007_KiaraHouse_600cdfd6:

    # mc "Una maleta hecha. ¿Os queda mucho?"
    mc "Der Koffer ist gepackt. Bist du bald da?"

# game/scripts/c15/c15.rpy:3555
translate german c15s007_KiaraHouse_62eaf6c6:

    # eil "Yo casi he acabado, mi otra maleta ya está hecha y solo me falta cerrarla. Voy a ayudar a mi madre con las suyas."
    eil "Ich bin fast fertig; mein anderer Koffer ist gepackt und ich muss ihn nur noch schließen. Ich werde meiner Mutter mit ihrem helfen."

# game/scripts/c15/c15.rpy:3556
translate german c15s007_KiaraHouse_75d335e2:

    # mc "¿Queréis ayuda?"
    mc "Benötigen Sie Hilfe?"

# game/scripts/c15/c15.rpy:3558
translate german c15s007_KiaraHouse_2c55182e:

    # eil "No te preocupes, entre las dos acabaremos rápido. No creo que a mi madre le gustara que hurgaras entre su ropa interior."
    eil "Keine Sorge, wir sind zu zweit schnell fertig. Ich glaube nicht, dass meine Mutter es gutheißen würde, wenn du in ihrer Unterwäsche herumwühlst."

# game/scripts/c15/c15.rpy:3559
translate german c15s007_KiaraHouse_923db28a:

    # mc "Ermmm..."
    mc "Ähm..."

# game/scripts/c15/c15.rpy:3561
translate german c15s007_KiaraHouse_ecdeef43:

    # eil "*Risa* ¡Y no hagas ninguna broma sobre meterte en sus bragas, que te conozco!"
    eil "*Lacht* Und mach bloß keine Witze darüber, dass du in ihre Höschen kommst, ich kenne dich!"

# game/scripts/c15/c15.rpy:3562
translate german c15s007_KiaraHouse_ef344348:

    # mc "Maleta cargada. Solo quedan tres más."
    mc "Koffer voll. Nur noch drei."

# game/scripts/c15/c15.rpy:3563
translate german c15s007_KiaraHouse_20af0adf:

    # mc "No iba a hacer ninguna broma... Y no me des ideas. *Risa*"
    mc "Ich hatte nicht vor, Witze zu machen... Und bring mich bloß nicht auf dumme Gedanken. *lacht*"

# game/scripts/c15/c15.rpy:3565
translate german c15s007_KiaraHouse_f296a3d2:

    # eil "¿Lo estás diciendo en serio?"
    eil "Meinst du das ernst?"

# game/scripts/c15/c15.rpy:3566
translate german c15s007_KiaraHouse_7c61d712:

    # mc "Por supuesto, que sí."
    mc "Natürlich."

# game/scripts/c15/c15.rpy:3567
translate german c15s007_KiaraHouse_116e1bbc:

    # mc "No iba a hacer ninguna broma. *Risa*"
    mc "Ich hatte gar nicht vor, Witze zu machen. *lacht*"

# game/scripts/c15/c15.rpy:3569
translate german c15s007_KiaraHouse_d9f8a862:

    # eil "No, idiota. Estoy hablando en serio. Lo de tener ideas con mi madre."
    eil "Nein, du Idiot. Ich meine es ernst. Es geht darum, Ideen mit meiner Mutter auszutauschen."

# game/scripts/c15/c15.rpy:3570
translate german c15s007_KiaraHouse_563efdbb:

    # mc "¿Qué? ¡No! No se me ha ocurrido nunca. Tan solo te seguía la broma."
    mc "Was? Nein! Daran habe ich gar nicht gedacht. Ich habe nur bei deinem Scherz mitgespielt."

# game/scripts/c15/c15.rpy:3572
translate german c15s007_KiaraHouse_c175e4d2:

    # eil "Casi me habías asustado... después del beso de antes..."
    eil "Du hast mich fast erschreckt... nach dem Kuss vorhin..."

# game/scripts/c15/c15.rpy:3573
translate german c15s007_KiaraHouse_2958262e:

    # mc "Me ha besado porque la has puesto entre la espada y la pared, no porque quisiera."
    mc "Sie hat mich geküsst, weil du sie in die Enge getrieben hast, nicht weil sie es wollte."

# game/scripts/c15/c15.rpy:3574
translate german c15s007_KiaraHouse_250e2188:

    # mc "Y ha sido el beso menos sensual que me han dado nunca... hasta el de Tía Betty ha sido mejor. *Risa*"
    mc "Und es war der unsexyeste Kuss, den ich je bekommen habe... selbst der von Tante Betty war besser. *lacht*"

# game/scripts/c15/c15.rpy:3576
translate german c15s007_KiaraHouse_41ab5b18:

    # kia "¿Hasta una monja besa mejor que yo? Tendré que mejorar eso. *Risa* ¿Y por qué te has asustado, Eile? Solo ha sido un beso."
    kia "Sogar eine Nonne küsst besser als ich? Daran muss ich noch arbeiten. *lacht* Und warum hattest du Angst, Eile? Es war doch nur ein Kuss."

# game/scripts/c15/c15.rpy:3578
translate german c15s007_KiaraHouse_5344fdd4:

    # eil "Por nada... [mc] ha hecho una broma sobre tu ropa interior y..."
    eil "Gern geschehen... [mc] hat einen Witz über deine Unterwäsche gemacht und..."

# game/scripts/c15/c15.rpy:3579
translate german c15s007_KiaraHouse_8e155502:

    # mc "¡Pero si yo no he llegado a decir nada!"
    mc "Aber ich habe kein Wort gesagt!"

# game/scripts/c15/c15.rpy:3581
translate german c15s007_KiaraHouse_6926ab84:

    # eil "¡Vale, tú no has dicho nada! Me he montado yo sola la película en la cabeza... Pero imaginaros juntos..."
    eil "Okay, du hast ja gar nichts gesagt! Ich habe mir das ganze Szenario einfach ausgedacht... Aber stell dir mal vor, ihr zwei wärt zusammen..."

# game/scripts/c15/c15.rpy:3583
translate german c15s007_KiaraHouse_878dee2e:

    # kia "*Risa* ¿Qué? ¿[mc] y yo juntos? ¡Después la loca soy yo! *Risa* Espero que no me estés retando como con el beso."
    kia "*Lacht* Was? [mc] und ich zusammen? Dann bin ich ja die Verrückte! *Lacht* Hoffentlich forderst du mich nicht wieder so heraus wie mit dem Kuss."

# game/scripts/c15/c15.rpy:3584
translate german c15s007_KiaraHouse_83156cd5:

    # mc "*Risa* No sé si sentirme ofendido ahora mismo."
    mc "*lacht* Ich weiß im Moment nicht, ob ich mich beleidigt fühlen soll."

# game/scripts/c15/c15.rpy:3586
translate german c15s007_KiaraHouse_c5acc1c8:

    # kia "No me refiero a eso, cielo. ¿Qué ibas a hacer tú con una mujer como yo, con todos los problemas que hay en mi vida ahora mismo? *Risa*"
    kia "So meine ich das nicht, Schatz. Was würdest du denn mit einer Frau wie mir anfangen, mit all den Problemen, die ich gerade im Leben habe? *lacht*"

# game/scripts/c15/c15.rpy:3587
translate german c15s007_KiaraHouse_fd47b3ec:

    # mc "Ayudarte a resolverlos, por supuesto. *Risa*"
    mc "Ich helfe Ihnen natürlich bei der Lösung. *lacht*"

# game/scripts/c15/c15.rpy:3590
translate german c15s007_KiaraHouse_bfff1ac2:

    # kia "No me extraña que le echaras el lazo en cuanto volvió, Eile. Siempre tiene la respuesta adecuada para todo."
    kia "Es wundert mich nicht, dass du ihn dir gleich nach seiner Rückkehr geschnappt hast, Eile. Er hat immer die richtige Antwort auf alles."

# game/scripts/c15/c15.rpy:3592
translate german c15s007_KiaraHouse_d7f0cc96:

    # kia "Es una lástima que no le echaras el lazo en cuanto volvió, Eile. Siempre tiene la respuesta adecuada para todo."
    kia "Schade, dass du ihn nicht gleich nach seiner Rückkehr gepackt hast, Eile. Er hat immer die richtige Antwort auf alles."

# game/scripts/c15/c15.rpy:3593
translate german c15s007_KiaraHouse_214c0463:

    # mc "Eso no es verdad, pero sabes que estoy para ayudarte en cualquier cosa que necesites. Que necesitéis las dos."
    mc "Das stimmt nicht, aber du weißt ja, dass ich dir bei allem, was du brauchst, gerne helfe. Bei allem, was ihr beide braucht."

# game/scripts/c15/c15.rpy:3596
translate german c15s007_KiaraHouse_c9219344:

    # kia "Eile, si alguna vez te cansas de él, me lo pido para mí. *Risa*"
    kia "Eile, falls du es jemals satt hast, nehme ich es selbst. *lacht*"

# game/scripts/c15/c15.rpy:3598
translate german c15s007_KiaraHouse_b59c4edf:

    # kia "Estoy por pedírmelo para mí ahora que no lo tendría que compartir contigo, Eile. *Risa*"
    kia "Ich überlege, es mir jetzt selbst zu bestellen, damit ich es nicht mehr mit dir teilen muss, Eile. *lacht*"

# game/scripts/c15/c15.rpy:3599
translate german c15s007_KiaraHouse_893f3ba7:

    # mc "Yo estoy abierto a ser compartido. *Risa*"
    mc "Ich bin offen dafür, geteilt zu werden. *lacht*"

# game/scripts/c15/c15.rpy:3600
translate german c15s007_KiaraHouse_0e8ac2f3:

    # kia "Si tuviera 25 años menos y estuviera soltera... *Risa*"
    kia "Wenn ich 25 Jahre jünger und Single wäre... *lacht*"

# game/scripts/c15/c15.rpy:3602
translate german c15s007_KiaraHouse_e721f458:

    # eil "¿Ves? ¡A eso me refiero! Empezáis con las bromas, los abrazos y los besos y acabáis..."
    eil "Siehst du? Genau das meine ich! Man fängt mit Witzen, Umarmungen und Küssen an und am Ende..."

# game/scripts/c15/c15.rpy:3604
translate german c15s007_KiaraHouse_908d8ff1:

    # mc "Eile, ¿en serio te preocupa que tu madre y yo acabemos juntos?"
    mc "Eile, machst du dir ernsthaft Sorgen, dass deine Mutter und ich am Ende zusammenkommen?"

# game/scripts/c15/c15.rpy:3610
translate german c15s007_KiaraHouse_deadd5c9:

    # sol "*Voz de borracho* A ella quizás no, pero a mí sí. *Hic* ¡Quítale las manos de encima a mi mujer!"
    sol "*Betrunkene Stimme* Vielleicht nicht sie, aber ich. *Hicks* Finger weg von meiner Frau!"

# game/scripts/c15/c15.rpy:3612
translate german c15s007_KiaraHouse_eee087a9:

    # kia "¡Solomon! ¡No es lo que pueda parecerte! ¿Qué haces aquí?"
    kia "Salomo! Es ist nicht so, wie es aussieht! Was machst du hier?"

# game/scripts/c15/c15.rpy:3614
translate german c15s007_KiaraHouse_5da65093:

    # sol "*Voz de borracho* ¿Qué hago aquí? ¡Es mi puta casa! *Hic* Un amigo me ha llamado para decirme que la policía estaba en la puerta de casa."
    sol "*Betrunkene Stimme* Was mache ich hier? Das ist verdammt nochmal mein Haus! *Hicks* Ein Freund rief an und sagte, die Polizei sei vor meiner Tür."

# game/scripts/c15/c15.rpy:3615
translate german c15s007_KiaraHouse_6d2f572d:

    # sol "*Voz de borracho* Y llego para ver que mi propia mujer me está robando y está *Hic* en los brazos de otro hombre! ¡De un niñato!"
    sol "*Betrunkene Stimme* Und ich komme nach Hause und erwische meine eigene Frau dabei, wie sie mich bestiehlt und *Hicks* in den Armen eines anderen Mannes liegt! Eines Kindes!"

# game/scripts/c15/c15.rpy:3617
translate german c15s007_KiaraHouse_d3f4ddda:

    # kia "No estamos robando, hemos venido a por algo de ropa. Nuestra ropa. Y..."
    kia "Wir stehlen nichts, wir sind nur wegen Kleidung gekommen. Unserer Kleidung. Und..."

# game/scripts/c15/c15.rpy:3619
translate german c15s007_KiaraHouse_7a4c5a2f:

    # sol "*Voz de borracho* Y a avergonzarme delante de todo el barrio *Hic* abrazando a otro delante de casa. ¡Además, al ex-novio de tu hija!"
    sol "*Betrunkene Stimme* Und mich vor der ganzen Nachbarschaft zu blamieren *Hicks*, indem ich jemanden vor meinem Haus umarme. Und als ob das nicht schon genug wäre, ist es auch noch der Ex-Freund deiner Tochter!"

# game/scripts/c15/c15.rpy:3620
translate german c15s007_KiaraHouse_a7717ec8:

    # mc "Solomon, no te acerques más. Solo era un abrazo."
    mc "Solomon, komm nicht näher. Es war doch nur eine Umarmung."

# game/scripts/c15/c15.rpy:3622
translate german c15s007_KiaraHouse_cf4bc285:

    # mc "Eileen, ve a buscar las maletas. Kiara, detrás de mí."
    mc "Eileen, hol bitte die Koffer. Kiara, hinter mir."

# game/scripts/c15/c15.rpy:3623
translate german c15s007_KiaraHouse_8ea34bcc:

    # eil "Voy."
    eil "Gehen."

# game/scripts/c15/c15.rpy:3625
translate german c15s007_KiaraHouse_59d54302:

    # sol "*Voz de borracho* ¿Ahora me das ordenes? *Hic* ¿Y también a tus putitas?"
    sol "*Betrunkene Stimme* Jetzt gibst du mir Befehle? *Hicks* Und deinen kleinen Huren auch noch?"

# game/scripts/c15/c15.rpy:3626
translate german c15s007_KiaraHouse_790048dd:

    # mc "No les faltes al respeto, Solomon. Estás borracho."
    mc "Sei nicht respektlos ihnen gegenüber, Solomon. Du bist betrunken."

# game/scripts/c15/c15.rpy:3628
translate german c15s007_KiaraHouse_c5b6263f:

    # kia "[mc] solo ha venido a ayudarnos y se lo estaba agradeciendo con un simple abrazo."
    kia "[mc] Er kam nur, um uns zu helfen, und ich dankte ihm mit einer einfachen Umarmung."

# game/scripts/c15/c15.rpy:3629
translate german c15s007_KiaraHouse_d3b76a72:

    # mc "Déjanos acabar de recoger lo que hemos venido a llevarnos y no habrá problemas, Solomon."
    mc "Lass uns erst einmal das einsammeln, was wir holen wollen, dann wird es keine Probleme geben, Salomo."

# game/scripts/c15/c15.rpy:3631
translate german c15s007_KiaraHouse_077feee2:

    # sol "*Voz de borracho* ¡Tú quieres robarme mi familia! *Hic* ¡Pero esta se queda aquí!"
    sol "*Betrunkene Stimme* Du willst meine Familie stehlen! *Hicks* Aber sie bleiben doch hier!"

# game/scripts/c15/c15.rpy:3633
translate german c15s007_KiaraHouse_9b9e2061:

    # mc "¡Te he dicho que no te acerques! ¿No tuviste suficiente con lo que le hiciste el otro día?"
    mc "Ich habe dir doch gesagt, du sollst ihr nicht zu nahe kommen! War das, was du ihr neulich angetan hast, nicht genug?"

# game/scripts/c15/c15.rpy:3635
translate german c15s007_KiaraHouse_c1c29318:

    # sol "*Voz de borracho* ¡No te entrometas en los asuntos de mi familia!"
    sol "*Betrunkene Stimme* Misch dich nicht in die Angelegenheiten meiner Familie ein!"

# game/scripts/c15/c15.rpy:3637
translate german c15s007_KiaraHouse_abbde0c3:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3640
translate german c15s007_KiaraHouse_ec3de842:

    # kia "¡Solomon! ¡Para ahora mismo! ¡Déjanos irnos con nuestras cosas!"
    kia "Salomo! Halt sofort an! Lass uns mit unseren Sachen gehen!"

# game/scripts/c15/c15.rpy:3641
translate german c15s007_KiaraHouse_fcc3b65f:

    # mc "Haz caso a tu mujer y vete, Solomon. No quiero hacerte daño."
    mc "Hör auf deine Frau und geh, Salomo. Ich will dich nicht verletzen."

# game/scripts/c15/c15.rpy:3643
translate german c15s007_KiaraHouse_971d4615:

    # sol "*Voz de borracho* ¡Pelea como un hombre!"
    sol "*Betrunkene Stimme* Kämpfe wie ein Mann!"

# game/scripts/c15/c15.rpy:3644
translate german c15s007_KiaraHouse_688798af:

    # mc "No quiero pelear contigo, Solomon."
    mc "Ich will nicht mit dir streiten, Salomo."

# game/scripts/c15/c15.rpy:3646
translate german c15s007_KiaraHouse_317a15ac:

    # sol "*Voz de borracho* ¡Hijo de puta!"
    sol "*Betrunkene Stimme* Du Hurensohn!"

# game/scripts/c15/c15.rpy:3648
translate german c15s007_KiaraHouse_abbde0c3_1:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3649
translate german c15s007_KiaraHouse_3cb40196:

    # mc "Quédate ahí, Solomon. No quiero pegarte delante de tu mujer, pero no dudaré en hacerlo si vuelves a intentar pegarme a mí."
    mc "Bleib genau da stehen, Solomon. Ich will dich nicht vor deiner Frau schlagen, aber ich werde nicht zögern, es zu tun, wenn du es noch einmal versuchst."

# game/scripts/c15/c15.rpy:3651
translate german c15s007_KiaraHouse_47381df1:

    # kia "No te levantes, por favor, Sol. No quiero que te hagan daño."
    kia "Steh bitte nicht auf, Sol. Ich möchte nicht, dass du dich verletzt."

# game/scripts/c15/c15.rpy:3652
translate german c15s007_KiaraHouse_e9057d29:

    # mc "Haz caso a Kiara. Kiara, sube al coche, por favor."
    mc "Hör auf Kiara. Kiara, steig bitte ins Auto."

# game/scripts/c15/c15.rpy:3654
translate german c15s007_KiaraHouse_e4f4810e:

    # mc "*Susurrando* Mira, puto desperdicio humano, no quiero que te vuelvas a acercar a Kiara o Eileen si no se acercan ellas primero."
    mc "*Flüsternd* Hör mal, du verdammter menschlicher Abschaum, ich will nicht, dass du dich Kiara oder Eileen jemals wieder näherst, es sei denn, sie kommen zuerst auf dich zu."

# game/scripts/c15/c15.rpy:3655
translate german c15s007_KiaraHouse_b004bac7:

    # mc "*Susurrando* Sólo he necesitado un pequeño empujón para que acabes en el suelo. Si se te ocurre tocarlas, a cualquiera de las dos, entonces vendré a por ti y no seré comprensivo. ¿Entendido?"
    mc "*Flüsternd* Ein kleiner Stoß genügte, um dich zu Boden zu werfen. Wenn du es auch nur wagst, sie anzufassen, egal welche, dann werde ich dich verfolgen, und zwar ohne Gnade. Verstanden?"

# game/scripts/c15/c15.rpy:3656
translate german c15s007_KiaraHouse_e445a441:

    # sol "¡Son mi mujer y mi hija! ¡Tú no eres nadie...!"
    sol "Das sind meine Frau und meine Tochter! Du bist niemand...!"

# game/scripts/c15/c15.rpy:3658
translate german c15s007_KiaraHouse_abbde0c3_2:

    # sol "¡Aaargh!"
    sol "Aaargh!"

# game/scripts/c15/c15.rpy:3659
translate german c15s007_KiaraHouse_1b8e8c72:

    # mc "¡Oops, qué asco! Me parece que he pisado una mierda de perro. Pero al menos así las dos manos te dolerán igual."
    mc "Oh, igitt! Ich glaube, ich bin in Hundekot getreten. Aber wenigstens tun dir jetzt beide Hände gleich weh."

# game/scripts/c15/c15.rpy:3660
translate german c15s007_KiaraHouse_06190750:

    # mc "Te he preguntado si me has entendido."
    mc "Ich habe dich gefragt, ob du mich verstanden hast."

# game/scripts/c15/c15.rpy:3661
translate german c15s007_KiaraHouse_68ffbd79:

    # sol "¡Sí, sí!"
    sol "Ja, ja!"

# game/scripts/c15/c15.rpy:3663
translate german c15s007_KiaraHouse_0ab3179f:

    # eil "Ya está, esto es lo último."
    eil "Das war's, das ist das letzte Mal."

# game/scripts/c15/c15.rpy:3665
translate german c15s007_KiaraHouse_8737adc7:

    # eil "¿Qué ha pasado? ¿Lo has tumbado?"
    eil "Was ist passiert? Hast du es umgestoßen?"

# game/scripts/c15/c15.rpy:3666
translate german c15s007_KiaraHouse_6d60bc3c:

    # mc "No, Eile, Se ha tumbado solo. Ha intentado pegarme y ha acabado con la cabeza en la camioneta. Está muy borracho."
    mc "Nein, Eile, er hat sich von selbst hingelegt. Er hat versucht, mich zu schlagen, und ist dann mit dem Kopf im LKW gelandet. Er ist total betrunken."

# game/scripts/c15/c15.rpy:3668
translate german c15s007_KiaraHouse_e23d4eaa:

    # sol "*Voz de borracho* Tu exnovio no pelea limpio. *Hic* Pero iré a buscaros cuando él no esté."
    sol "*Betrunkene Stimme* Dein Ex-Freund kämpft nicht fair. *Hicks* Aber ich werde dich suchen, wenn er nicht da ist."

# game/scripts/c15/c15.rpy:3670
translate german c15s007_KiaraHouse_55d1d921:

    # sol "¡Aaargh! ¡Hija de puta!"
    sol "Aaargh! Du Mistkerl!"

# game/scripts/c15/c15.rpy:3672
translate german c15s007_KiaraHouse_dce52b93:

    # eil "*Susurrando* Escuchame bien, saco de mierda. No te vas a volver a acercar a Mamá, ¿vale?"
    eil "*Flüsternd* Hör mir gut zu, du Dreckskerl. Du gehst nie wieder in die Nähe von Mama, verstanden?"

# game/scripts/c15/c15.rpy:3673
translate german c15s007_KiaraHouse_1b5df64c:

    # eil "*Susurrando* Voy a hacer todo lo posible para que no vuelva con una basura como tú."
    eil "*flüsternd* Ich werde alles daransetzen, dass sie nie wieder zu so einem Abschaum wie dir zurückfindet."

# game/scripts/c15/c15.rpy:3674
translate german c15s007_KiaraHouse_7ab896f7:

    # eil "*Susurrando* Si se te ocurre tocarla o, aunque sea, amenazarla, todo el mundo se va a enterar de que ya no eres un hombre. ¿Vale?"
    eil "*Flüsternd* Wenn du auch nur daran denkst, sie anzufassen oder sie gar zu bedrohen, wird jeder wissen, dass du kein Mann mehr bist. Verstanden?"

# game/scripts/c15/c15.rpy:3675
translate german c15s007_KiaraHouse_e0fc56bd:

    # eil "*Susurrando* A ver qué mote te sacan tus amigos cuando se enteren ¿Fideo? ¿Picha blanda?"
    eil "*Flüsternd* Mal sehen, welchen Spitznamen sich deine Freunde ausdenken, wenn sie es erfahren. Nudel? Weichei?"

# game/scripts/c15/c15.rpy:3676
translate german c15s007_KiaraHouse_3dff952e:

    # mc "Eileen, déjalo. Está tan borracho que mañana no se va a acordar de lo que le has dicho."
    mc "Eileen, lass ihn in Ruhe. Er ist so betrunken, dass er sich morgen nicht mehr daran erinnern wird, was du gesagt hast."

# game/scripts/c15/c15.rpy:3678
translate german c15s007_KiaraHouse_f96733b5:

    # eil "No, esto no se le va a olvidar. Cuando se pregunte por qué le duele la mano, lo recordará."
    eil "Nein, das wird er nicht vergessen. Wenn er sich wundert, warum seine Hand schmerzt, wird er sich daran erinnern."

# game/scripts/c15/c15.rpy:3679
translate german c15s007_KiaraHouse_cda2aaab:

    # mc "No te conviertas en lo que es él. No vale la pena."
    mc "Werde nicht so wie er. Es lohnt sich nicht."

# game/scripts/c15/c15.rpy:3681
translate german c15s007_KiaraHouse_18173db3:

    # eil "Tienes razón, no merece la pena... pero sienta tan bien... Es tan fácil convertirse en una mala persona..."
    eil "Du hast recht, es lohnt sich nicht... aber es fühlt sich so gut an... Es ist so leicht, ein schlechter Mensch zu werden..."

# game/scripts/c15/c15.rpy:3682
translate german c15s007_KiaraHouse_dab57d09:

    # mc "Vámonos, Eile."
    mc "Los geht's, Eile."

# game/scripts/c15/c15.rpy:3685
translate german c15s007_KiaraHouse_0594242f:

    # "Conduces en silencio durante unos minutos hasta que salís del barrio donde está la casa que tan malos recuerdos les trae ahora mismo."
    "Man fährt einige Minuten schweigend, bis man die Gegend verlässt, in der sich das Haus befindet, das so schlimme Erinnerungen weckt."

# game/scripts/c15/c15.rpy:3688
translate german c15s007_KiaraHouse_6024bbc3:

    # eil "¿Puedes parar un momento? Necesito estirar las piernas... me tiembla todo."
    eil "Könnten Sie kurz anhalten? Ich muss mir die Beine vertreten... Ich zittere am ganzen Körper."

# game/scripts/c15/c15.rpy:3689
translate german c15s007_KiaraHouse_490a5904:

    # mc "Eso es la adrenalina. Te has enfrentado a él por primera vez."
    mc "Das ist Adrenalin. Du bist ihm zum ersten Mal gegenübergetreten."

# game/scripts/c15/c15.rpy:3690
translate german c15s007_KiaraHouse_5e820541:

    # eil "También voy a necesitar un abrazo..."
    eil "Ich brauche auch eine Umarmung..."

# game/scripts/c15/c15.rpy:3692
translate german c15s007_KiaraHouse_83b332aa:

    # eil "Gracias, [mc]."
    eil "Vielen Dank, [mc]."

# game/scripts/c15/c15.rpy:3693
translate german c15s007_KiaraHouse_2ed9f919:

    # mc "No hace falta que las des. Me encanta abrazar."
    mc "Du brauchst sie nicht zu geben. Ich umarme sehr gerne."

# game/scripts/c15/c15.rpy:3694
translate german c15s007_KiaraHouse_45c28a94:

    # eil "¡Idiota! No me refería a eso y lo sabes."
    eil "Dummkopf! So habe ich das nicht gemeint, und das weißt du auch."

# game/scripts/c15/c15.rpy:3696
translate german c15s007_KiaraHouse_29d5100b:

    # kia "Gracias por como lo has tratado, [mc]... Cualquier otro le hubiera pegado... sé que se lo hubiera merecido... pero no deja de ser mi marido..."
    kia "Danke, wie du ihn behandelt hast, [mc]... Jeder andere hätte ihn geschlagen... Ich weiß, er hätte es verdient... aber er ist trotzdem mein Ehemann..."

# game/scripts/c15/c15.rpy:3697
translate german c15s007_KiaraHouse_598681bc:

    # mc "Ver en la piltrafa de hombre que se ha convertido me ha revuelto el estómago."
    mc "Der Anblick des jämmerlichen Mannes, der er geworden ist, hat mir Übelkeit verursacht."

# game/scripts/c15/c15.rpy:3698
translate german c15s007_KiaraHouse_3c1818df:

    # mc "Pegarle no hubiera mejorado nada, tan solo lo hubiera empeorado."
    mc "Ihn zu schlagen hätte nichts verbessert, sondern alles nur noch schlimmer gemacht."

# game/scripts/c15/c15.rpy:3700
translate german c15s007_KiaraHouse_7d20f598:

    # eil "Mamá, hay espacio aquí para ti también. Sé que te encantan los abrazos de [mc]."
    eil "Mama, hier ist auch Platz für dich. Ich weiß, du liebst Umarmungen."

# game/scripts/c15/c15.rpy:3702
translate german c15s007_KiaraHouse_8de6ffc6:

    # eil "Pero no tengas ideas raras con mi novio."
    eil "Aber macht euch bloß keine komischen Gedanken über meinen Freund."

# game/scripts/c15/c15.rpy:3704
translate german c15s007_KiaraHouse_f81c97e7:

    # eil "Pero no tengas ideas raras con mi ex-novio."
    eil "Aber macht euch bloß keine komischen Gedanken über meinen Ex-Freund."

# game/scripts/c15/c15.rpy:3705
translate german c15s007_KiaraHouse_62d4aaf0:

    # mc "Será mejor que no vuelvas a retar a tu madre, Eileen... ya has visto como ha ido con los besos. *Risa*"
    mc "Du solltest deine Mutter besser nicht noch einmal herausfordern, Eileen... du hast ja gesehen, wie das mit den Küssen ausgegangen ist. *lacht*"

# game/scripts/c15/c15.rpy:3707
translate german c15s007_KiaraHouse_555e84df:

    # eil "¿Qué? ¡No! ¡No te estoy retando, Mamá!"
    eil "Was? Nein! Ich fordere dich nicht heraus, Mama!"

# game/scripts/c15/c15.rpy:3708
translate german c15s007_KiaraHouse_42b2c0ff:

    # eil "Si te lo tomas como un reto... No creo que sea capaz de mantener sus manos alejadas de ti."
    eil "Wenn du es als Herausforderung siehst... ich glaube nicht, dass er die Finger von dir lassen kann."

# game/scripts/c15/c15.rpy:3710
translate german c15s007_KiaraHouse_cf9822ed:

    # kia "*Risa* No funciona así, cielo. No te preocupes, [mc] es un buen amigo, pero soy demasiado vieja para él."
    kia "*Lacht* So funktioniert das nicht, Liebes. Keine Sorge, [mc] ist ein guter Freund, aber ich bin zu alt für ihn."

# game/scripts/c15/c15.rpy:3712
translate german c15s007_KiaraHouse_45a8e18b:

    # kia "{i}(Aunque parece que a él la edad no le importa demasiado.){/i}"
    kia "{i}(Obwohl das Alter für ihn scheinbar keine große Rolle spielt.){/i}"

# game/scripts/c15/c15.rpy:3714
translate german c15s007_KiaraHouse_15e5bde7:

    # kia "{i}(¡No! ¡Eile tiene razón! Estos pensamientos son peligrosos y no debo tenerlos... y soy una mujer casada.){/i}"
    kia "{i}(Nein! Eile hat Recht! Diese Gedanken sind gefährlich und ich darf sie nicht haben... und ich bin eine verheiratete Frau.){/i}"

# game/scripts/c15/c15.rpy:3716
translate german c15s007_KiaraHouse_8178f3f3:

    # kia "{i}(Pero se está tan bien aquí... estos abrazos y los besos...){/i}"
    kia "{i}(Aber es ist so schön hier... diese Umarmungen und Küsse...){/i}"

# game/scripts/c15/c15.rpy:3718
translate german c15s007_KiaraHouse_f71f4962:

    # kia "{i}(¡Los besos! ¿Por qué he aceptado? ¿Cómo puedo ser tan fácil de manipular? ¿Me está manipulando Eileen?){/i}"
    kia "{i}(Die Küsse! Warum habe ich zugestimmt? Wie kann ich mich nur so leicht manipulieren lassen? Manipuliert mich Eileen etwa?){/i}"

# game/scripts/c15/c15.rpy:3720
translate german c15s007_KiaraHouse_e7da7f88:

    # "Cuando las chicas se calman del todo, pasáis a recoger a [eri] y volvéis a casa. Entre los cuatro subís sus maletas a su habitación."
    "Als die Mädchen sich vollständig beruhigt haben, nimmst du [eri] und gehst nach Hause. Ihr vier tragt ihre Koffer in ihr Zimmer."

# game/scripts/c15/c15.rpy:3785
translate german c15s007_Night_11553dbe:

    # "La noticia de que los saludos con besos se han reanudado ha corrido como la pólvora. [emm], [dap], [eri], y Scarlett se unen a la nueva costumbre sin hacer preguntas."
    "Die Nachricht, dass Begrüßungen mit Küssen wieder üblich sind, hat sich wie ein Lauffeuer verbreitet. [emm], [dap], [eri] und Scarlett machen ohne Fragen mit."

# game/scripts/c15/c15.rpy:3786
translate german c15s007_Night_6d229a41:

    # "[mar], [nor] y Betty continúan con ella. Incluso Olivia te saluda con un beso en los labios al llegar. Reluctantemente, pero menos que por la tarde."
    "[mar], [nor] und Betty fahren mit ihr fort. Sogar Olivia begrüßt dich bei deiner Ankunft mit einem Kuss auf die Lippen. Widerwillig, aber weniger als am Nachmittag."

# game/scripts/c15/c15.rpy:3787
translate german c15s007_Night_a7d29042:

    # "Después de cenar, Kiara se despide de ti con un beso, casi tan reluctante como el de Meemaw, lo cual te sorprende después del último beso de la tarde. El de Eileen es normal."
    "Nach dem Abendessen verabschiedet sich Kiara mit einem Kuss, fast so widerwillig wie Meemaw, was nach dem letzten Kuss des Abends überrascht. Eileens Kuss ist normal."

# game/scripts/c15/c15.rpy:3788
translate german c15s007_Night_c5de8e5b:

    # "Vuelves a casa después de un día lleno de emociones, pero escuchas risas en la sala nada más entrar."
    "Nach einem aufregenden Tag kommen Sie nach Hause, doch sobald Sie eintreten, hören Sie Gelächter aus dem Wohnzimmer."

# game/scripts/c15/c15.rpy:3791
translate german c15s007_Night_14b8b428:

    # mc "Buenas noches, chicas. ¿Parece que tenéis una fiesta hoy? Veo mucho vino ahí, y algunas botellas vacías."
    mc "Guten Abend, meine Damen. Sieht so aus, als ob Sie heute Abend eine Party feiern? Ich sehe dort jede Menge Wein und einige leere Flaschen."

# game/scripts/c15/c15.rpy:3792
translate german c15s007_Night_3c75717d:

    # kat "Es noche de chicas. Muchas confidencias que hacernos. *Risa*"
    kat "Es ist Mädelsabend. Viele Geheimnisse zu teilen. *lacht*"

# game/scripts/c15/c15.rpy:3793
translate german c15s007_Night_1f225020:

    # kim "No sabíamos que saliste con Saira en Portland."
    kim "Wir wussten nicht, dass du mit Saira in Portland ausgegangen bist."

# game/scripts/c15/c15.rpy:3794
translate german c15s007_Night_c79860bd:

    # sai "No salíamos... al menos no oficialmente."
    sai "Wir waren nicht zusammen... zumindest nicht offiziell."

# game/scripts/c15/c15.rpy:3795
translate german c15s007_Night_dc049906:

    # deb "Bueno, pero erais pareja, ¿no?"
    deb "Aber ihr wart doch ein Paar, oder?"

# game/scripts/c15/c15.rpy:3796
translate german c15s007_Night_2173493f:

    # lis "No, Deb, tenían una relación abierta, podrían haber salido con otras personas si hubieran querido. Lo ha explicado Saira cuando has ido al lavabo."
    lis "Nein, Deb, sie führten eine offene Beziehung; sie hätten sich mit anderen treffen können, wenn sie gewollt hätten. Saira hat es dir erklärt, als du auf der Toilette warst."

# game/scripts/c15/c15.rpy:3797
translate german c15s007_Night_a7bdb9e3:

    # mc "Supongo que no soy bienvenido a quedarme, ¿no?"
    mc "Ich bin wohl nicht willkommen, hier zu bleiben, oder?"

# game/scripts/c15/c15.rpy:3799
translate german c15s007_Night_c868fcce:

    # todas "¡No!"
    todas "NEIN!"

# game/scripts/c15/c15.rpy:3800
translate german c15s007_Night_521b6a53:

    # kim "Hemos dicho noche de chicas, y si estás delante, Saira no nos va a poder contar cosas sobre ti. *Risa*"
    kim "Wir haben gesagt, es ist Mädelsabend, und wenn du dabei bist, kann Saira uns nichts über dich erzählen. *lacht*"

# game/scripts/c15/c15.rpy:3802
translate german c15s007_Night_8d7fc1fa:

    # deb "Después de los besos de ayer en la playa, ya has aparecido en la conversación."
    deb "Nach den Küssen gestern am Strand bist du bereits Thema des Gesprächs."

# game/scripts/c15/c15.rpy:3803
translate german c15s007_Night_e73bdc90:

    # kat "Y queremos saber más *Risa*"
    kat "Und wir wollen mehr wissen *Gelächter*"

# game/scripts/c15/c15.rpy:3804
translate german c15s007_Night_978db81f:

    # lis "Aunque no solo hemos hablado de ti, ¿eh?"
    lis "Obwohl wir nicht nur über dich gesprochen haben, weißt du?"

# game/scripts/c15/c15.rpy:3805
translate german c15s007_Night_3585ba5d:

    # mc "*Sniff* Pues me voy desconsolado a mi habitación sintiéndome rechazado. *Risa*"
    mc "*Schnief* Na ja, ich gehe jetzt mit gebrochenem Herzen und dem Gefühl, zurückgewiesen worden zu sein, in mein Zimmer. *Lacht*"

# game/scripts/c15/c15.rpy:3806
translate german c15s007_Night_31685440:

    # sai "¿Puedo hablar contigo un momento antes de que te vayas?"
    sai "Kann ich Sie kurz sprechen, bevor Sie gehen?"

# game/scripts/c15/c15.rpy:3807
translate german c15s007_Night_890c041b:

    # mc "Por supuesto."
    mc "Natürlich."

# game/scripts/c15/c15.rpy:3809
translate german c15s007_Night_8d8742d1:

    # sai "[emm] nos ha contado lo de la nueva costumbre de saludos con besos. ¿Eso también nos incluye a nosotras? *Susurrando* ¿A mí?"
    sai "[emm] hat uns von dem neuen Brauch erzählt, sich mit Küssen zu begrüßen. Gilt das auch für uns? *flüstert* Ich?"

# game/scripts/c15/c15.rpy:3810
translate german c15s007_Night_b11f1345:

    # sai "Algunas queremos participar."
    sai "Einige von uns möchten teilnehmen."

# game/scripts/c15/c15.rpy:3811
translate german c15s007_Night_9cd5fa47:

    # kim "¡Di que sí, [mc]! Al menos con Saira..."
    kim "Sag ja, [mc]! Wenigstens bei Saira..."

# game/scripts/c15/c15.rpy:3813
translate german c15s007_Night_34139240:

    # sai "*Susurrando* Así podría robarte algunos besos sin que fuera sospechoso para estas chicas."
    sai "*flüstert* So könnte ich ein paar Küsse stehlen, ohne dass diese Mädchen etwas merken."

# game/scripts/c15/c15.rpy:3815
translate german c15s007_Night_1914eba4:

    # sai "*Susurrando* Así podría robarte algunos besos sin que fuera sospechoso para estas chicas, al menos hasta que decidamos que hacer con lo nuestro."
    sai "*flüstert* So könnte ich ein paar Küsse stehlen, ohne dass diese Mädchen etwas ahnen, zumindest bis wir entschieden haben, was wir mit uns anfangen sollen."

# game/scripts/c15/c15.rpy:3816
translate german c15s007_Night_6cfce5e6:

    # sai "*Susurrando* Y si las incluyes a ellas... mejor todavía."
    sai "*Flüsternd* Und wenn du sie mit einbeziehst... umso besser."

# game/scripts/c15/c15.rpy:3817
translate german c15s007_Night_a5d04d1b:

    # kat "¡Hey! ¡Nada de secretitos!"
    kat "Hey! Keine Geheimnisse!"

# game/scripts/c15/c15.rpy:3819
translate german c15s007_Night_1735b954:

    # sai "¡Calla, Kate! *Risa* ¡Estoy intentando negociar!"
    sai "Halt die Klappe, Kate! *lacht* Ich versuche zu verhandeln!"

# game/scripts/c15/c15.rpy:3821
translate german c15s007_Night_9240a19e:

    # sai "Si lo vas a hacer con toda la familia... queremos formar parte de la familia... Todas nos sentimos muy a gusto ayer."
    sai "Wenn man das mit der ganzen Familie macht... wollen wir auch Teil der Familie sein... Wir haben uns gestern alle sehr wohl gefühlt."

# game/scripts/c15/c15.rpy:3822
translate german c15s007_Night_327a2dfe:

    # deb "Sí, fue fantástico."
    deb "Ja, es war fantastisch."

# game/scripts/c15/c15.rpy:3824
translate german c15s007_Night_2bbafe99:

    # kat "¡Queremos besos para todas!"
    kat "Wir wollen Küsse für alle!"

# game/scripts/c15/c15.rpy:3825
translate german c15s007_Night_c3cc15c0:

    # kim "¡Besos! ¡Besos! ¡Besos!"
    kim "Küsse! Küsse! Küsse!"

# game/scripts/c15/c15.rpy:3827
translate german c15s007_Night_79abc93a:

    # kim "¡Las chicas queremos besos!"
    kim "Mädchen wollen Küsse!"

# game/scripts/c15/c15.rpy:3828
translate german c15s007_Night_3db4f64f:

    # mc "Chicas, ¿cuánto habéis bebido?"
    mc "Mädels, wie viel habt ihr getrunken?"

# game/scripts/c15/c15.rpy:3829
translate german c15s007_Night_3d722c14:

    # lis "Solo un par de botellas... por ahora..."
    lis "Nur ein paar Flaschen... vorerst..."

# game/scripts/c15/c15.rpy:3830
translate german c15s007_Night_7a80c8a7:

    # sai "Bueno, ¿qué dices? ¿podemos unirnos a la nueva costumbre?"
    sai "Nun, was sagen Sie dazu? Können wir uns dem neuen Brauch anschließen?"

# game/scripts/c15/c15.rpy:3831
translate german c15s007_Night_aed4d3df:

    # mc "Por supuesto, chicas. Pero recordad que es voluntario, no tenéis obligación de hacerlo."
    mc "Natürlich, Mädels. Aber denkt daran, es ist freiwillig; ihr seid zu nichts verpflichtet."

# game/scripts/c15/c15.rpy:3833
translate german c15s007_Night_2f9e2098:

    # sai "Pues buenas noches, [mc]."
    sai "Nun, gute Nacht, [mc]."

# game/scripts/c15/c15.rpy:3834
translate german c15s007_Night_793cbca9:

    # mc "Buenas noches, Saira."
    mc "Guten Abend, Saira."

# game/scripts/c15/c15.rpy:3835
translate german c15s007_Night_96c1ee5c:

    # "El beso de Saira es mucho más sensual de lo que deberían ser este tipo de saludos, pero no tienes ninguna queja sobre ello."
    "Sairas Kuss ist viel sinnlicher, als es bei solchen Begrüßungen sein sollte, aber du hast nichts dagegen."

# game/scripts/c15/c15.rpy:3836
translate german c15s007_Night_399d7539:

    # sai "Siguiente..."
    sai "Im Folgenden..."

# game/scripts/c15/c15.rpy:3837
translate german c15s007_Night_360a32b7:

    # "Saira vuelve a su sitio, dejándole espacio a Kate."
    "Saira kehrt an ihren Platz zurück und lässt Platz für Kate."

# game/scripts/c15/c15.rpy:3839
translate german c15s007_Night_843524dc:

    # kat "Buenas noches, besucón."
    kat "Gute Nacht, mein Schatz."

# game/scripts/c15/c15.rpy:3840
translate german c15s007_Night_6fd3bf68:

    # mc "Buenas noches, guapísima."
    mc "Gute Nacht, meine Schöne."

# game/scripts/c15/c15.rpy:3842
translate german c15s007_Night_ebdc4c1c:

    # "El beso de Kate es mucho más inseguro de lo que sus palabras risueñas dejan entrever. Sus labios saben a vino tinto."
    "Kates Kuss ist weitaus unsicherer, als ihre lächelnden Worte vermuten lassen. Ihre Lippen schmecken nach Rotwein."

# game/scripts/c15/c15.rpy:3844
translate german c15s007_Night_eb711a1b:

    # "El beso de Kate es un beso de una amiga, en consonancia con sus palabras risueñas. Sus labios saben a vino tinto."
    "Kates Kuss ist ein Freundschaftskuss, passend zu ihren fröhlichen Worten. Ihre Lippen schmecken nach Rotwein."

# game/scripts/c15/c15.rpy:3847
translate german c15s007_Night_682669fa:

    # kim "Buenas noches, guapo."
    kim "Gute Nacht, mein Hübscher."

# game/scripts/c15/c15.rpy:3848
translate german c15s007_Night_3f20630e:

    # mc "Buenas noches, preciosa."
    mc "Gute Nacht, meine Schöne."

# game/scripts/c15/c15.rpy:3849
translate german c15s007_Night_9d823c77:

    # "Kim te besa con seguridad, e incluso un poco de sensualidad. Puedes notar el sabor a alcohol mezclado con el de su pintalabios."
    "Kim küsst dich selbstbewusst, sogar mit einem Hauch von Sinnlichkeit. Du kannst den Alkohol in ihrem Lippenstift schmecken."

# game/scripts/c15/c15.rpy:3852
translate german c15s007_Night_19738ae3:

    # lis "Descansa, [mc]."
    lis "Ruhe, [mc]."

# game/scripts/c15/c15.rpy:3853
translate german c15s007_Night_ab1fd9ee:

    # mc "Tú también, Lisa."
    mc "Du auch, Lisa."

# game/scripts/c15/c15.rpy:3854
translate german c15s007_Night_15e9d1ee:

    # "Los labios de Lisa también saben a alcohol, pero su beso es inseguro, como si estuviera dudando sobre si debería hacerlo o no."
    "Auch Lisas Lippen schmecken nach Alkohol, aber ihr Kuss ist zögerlich, als ob sie zweifelte, ob sie ihn geben sollte oder nicht."

# game/scripts/c15/c15.rpy:3858
translate german c15s007_Night_1dc18d00:

    # "Debbie se ha levantado, dudando sobre si acercarse o no."
    "Debbie stand auf und zögerte, ob sie sich ihr nähern sollte oder nicht."

# game/scripts/c15/c15.rpy:3861
translate german c15s007_Night_53c27729:

    # lis "Debbie, solo es un beso, no implica nada. Y sólo tienes que hacerlo si quieres."
    lis "Debbie, es ist nur ein Kuss, er bedeutet nichts. Und du musst ihn nur geben, wenn du willst."

# game/scripts/c15/c15.rpy:3862
translate german c15s007_Night_391ee72b:

    # mc "No es una proposición de matrimonio, Debbie."
    mc "Das ist kein Heiratsantrag, Debbie."

# game/scripts/c15/c15.rpy:3864
translate german c15s007_Night_51cccc40:

    # deb "¿Puedo darte un beso de buenas noches?"
    deb "Darf ich dir einen Gutenachtkuss geben?"

# game/scripts/c15/c15.rpy:3865
translate german c15s007_Night_9766d4cc:

    # mc "Claro que sí, cielo."
    mc "Natürlich, Liebling."

# game/scripts/c15/c15.rpy:3867
translate german c15s007_Night_3c817d16:

    # deb "Buenas noches... [mc]."
    deb "Guten Abend... [mc]."

# game/scripts/c15/c15.rpy:3868
translate german c15s007_Night_641cde70:

    # mc "Buenas noches, Debbie."
    mc "Guten Abend, Debbie."

# game/scripts/c15/c15.rpy:3869
translate german c15s007_Night_0ae8be76:

    # "El beso de Debbie es increíblemente tímido, tierno y dulce. Es de esos besos que podrían matar a un diabético, pero en ningún momento hace contacto visual contigo"
    "Debbies Kuss ist unglaublich schüchtern, zärtlich und süß. Es ist einer dieser Küsse, die selbst einen Diabetiker umbringen könnten, doch sie vermeidet dabei jeglichen Augenkontakt."

# game/scripts/c15/c15.rpy:3870
translate german c15s007_Night_d31bbdbc:

    # mc "*Susurrando* Si tienes algo de lo que quieras hablar, podemos hacerlo mañana... hablar."
    mc "*Flüsternd* Wenn du etwas hast, worüber du reden möchtest, können wir morgen reden... reden."

# game/scripts/c15/c15.rpy:3872
translate german c15s007_Night_5d09d9e8:

    # deb "*Susurrando* No sé..."
    deb "*Flüsternd* Ich weiß es nicht..."

# game/scripts/c15/c15.rpy:3873
translate german c15s007_Night_10a5d785:

    # mc "*Susurrando* Si no hay nada de lo que hablar, no te preocupes, ha sido solo un beso."
    mc "*Flüsternd* Wenn es nichts zu besprechen gibt, keine Sorge, es war ja nur ein Kuss."

# game/scripts/c15/c15.rpy:3875
translate german c15s007_Night_68bd8e6e:

    # deb "*Susurrando* ¿Te gustaría que salieramos a correr mañana y hablamos?"
    deb "*Flüsternd* Hättest du Lust, morgen joggen zu gehen und dich dabei zu unterhalten?"

# game/scripts/c15/c15.rpy:3876
translate german c15s007_Night_e432d41d:

    # mc "*Susurrando* Genial. A mediodía tengo que estar en el lago, si no te importa tener que volver sola, podemos ir juntos y hablar por el camino."
    mc "*Flüsternd* Super. Ich muss mittags am See sein. Wenn es dir nichts ausmacht, alleine zurückzulaufen, können wir zusammen gehen und uns unterwegs unterhalten."

# game/scripts/c15/c15.rpy:3878
translate german c15s007_Night_6498e009:

    # deb "*Susurrando* Perfecto. Hasta mañana, [mc]."
    deb "*Flüsternd* Perfekt. Bis morgen, [mc]."

# game/scripts/c15/c15.rpy:3879
translate german c15s007_Night_75e5ba8e:

    # "Debbie te pilla por sorpresa con un segundo beso. Sigue siendo tan tierno y dulce como el anterior, pero mucho más seguro."
    "Debbie überrascht dich mit einem zweiten Kuss. Er ist immer noch genauso zärtlich und süß wie der erste, aber viel selbstbewusster."

# game/scripts/c15/c15.rpy:3880
translate german c15s007_Night_50db986e:

    # mc "Hasta mañana, Debbie."
    mc "Bis morgen, Debbie."

# game/scripts/c15/c15.rpy:3881
translate german c15s007_Night_271b1b00:

    # kim "¡Hey! Era un solo beso por chica. *Risa*"
    kim "Hey! Es gab einen Kuss pro Mädchen. *lacht*"

# game/scripts/c15/c15.rpy:3882
translate german c15s007_Night_a8953900:

    # kat "¡Si empezamos una segunda ronda de besos no vamos a continuar la noche de chicas! *Risa*"
    kat "Wenn wir jetzt noch eine Runde rumknutschen, können wir unseren Mädelsabend nicht fortsetzen! *lacht*"

# game/scripts/c15/c15.rpy:3883
translate german c15s007_Night_00d24ee8:

    # sai "A mi no me importaría una segunda ronda. *Risa*"
    sai "Ich hätte nichts gegen eine zweite Runde. *lacht*"

# game/scripts/c15/c15.rpy:3884
translate german c15s007_Night_a37824d6:

    # lis "¡Callaos, perras envidiosas! *Risa*"
    lis "Halt die Klappe, ihr neidischen Zicken! *Gelächter*"

# game/scripts/c15/c15.rpy:3886
translate german c15s007_Night_a7abb447:

    # mc "Bueno, chicas, ahora sí que os dejo. Pasadlo bien."
    mc "Okay Mädels, ich verabschiede mich jetzt. Viel Spaß!"

# game/scripts/c15/c15.rpy:3887
translate german c15s007_Night_efb81567:

    # todas "Buenas noches, [mc]."
    todas "Guten Abend, [mc]."

# game/scripts/c15/c15.rpy:3890
translate german c15s007_Night_92c75b97:

    # "Subes a tu habitación sin más encuentros."
    "Sie gehen ohne weitere Begegnungen in Ihr Zimmer."

# game/scripts/c15/c15.rpy:3894
translate german c15s007_Night_7a0e0fd7:

    # mc "¿Volvéis a dormir en mi habitación las dos? No es que no seáis bienvenidas... pero hacía varios días."
    mc "Wollt ihr beide wieder in meinem Zimmer schlafen? Nicht, dass ihr nicht willkommen wärt... aber es sind schon einige Tage vergangen."

# game/scripts/c15/c15.rpy:3895
translate german c15s007_Night_13e7ccbb:

    # mom "Te acuerdas de la idea que tuve sobre [emm] y su novio, ¿no?"
