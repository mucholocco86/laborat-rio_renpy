translate german c21s001_Foursome_26530bab:

    # "Todas las chicas te besan por turnos antes de meteros en la cama."
    "Bevor du ins Bett gehst, küssen dich die Mädchen nacheinander."

# game/scripts/c21/c21.rpy:1097
translate german c21s001_Foursome_d752a360:

    # "La logística de brazos y piernas es complicada durante un momento, hasta que cada uno encontráis vuestra posición."
    "Die Positionierung von Armen und Beinen gestaltet sich für einen Moment kompliziert, bis jeder von Ihnen seine Position gefunden hat."

# game/scripts/c21/c21.rpy:1098
translate german c21s001_Foursome_846e9aa9:

    # "No va a ser la noche más cómoda, pero todos vais a dormir como troncos. Estáis agotados."
    "Es wird keine besonders bequeme Nacht, aber ihr werdet alle wie Steine schlafen. Ihr seid total erschöpft."

# game/scripts/c21/c21.rpy:1099
translate german c21s001_Foursome_62b8d7ab:

    # mc "Buenas noches, chicas."
    mc "Guten Abend, Mädels."

# game/scripts/c21/c21.rpy:1100
translate german c21s001_Foursome_91b14c80:

    # emm "*Bostezo* Buenas noches, mi amor."
    emm "*Gähn* Gute Nacht, mein Schatz."

# game/scripts/c21/c21.rpy:1101
translate german c21s001_Foursome_35cf7969:

    # eri "Buenas noches, cielo. *Bostezo*"
    eri "Gute Nacht, Liebling. *Gähn*"

# game/scripts/c21/c21.rpy:1102
translate german c21s001_Foursome_c1f3ecb1:

    # dap "*Bostezo* Buenas noches, mi vida."
    dap "*Gähn* Gute Nacht, mein Schatz."

# game/scripts/c21/c21.rpy:1103
translate german c21s001_Foursome_283d8cfb:

    # mc "Os quiero."
    mc "Ich liebe euch alle."

# game/scripts/c21/c21.rpy:1106
translate german c21s001_Foursome_2ac3a499:

    # todas "Nosotras también te queremos."
    todas "Wir lieben dich auch."

# game/scripts/c21/c21.rpy:1112
translate german c21s002_PoliceStation_28c0c558:

    # "Por la mañana, en la comisaría de Policía..."
    "Am Morgen auf der Polizeiwache..."

# game/scripts/c21/c21.rpy:1115
translate german c21s002_PoliceStation_df96f71d:

    # "Un hombre sonriente entra en la comisaría."
    "Ein lächelnder Mann betritt die Polizeistation."

# game/scripts/c21/c21.rpy:1116
translate german c21s002_PoliceStation_9506f3a3:

    # sol "Buenos días, Agente. Mi nombre es Solomon Lamb y vengo a poner una denuncia."
    sol "Guten Morgen, Herr Wachtmeister. Mein Name ist Solomon Lamb und ich bin hier, um eine Beschwerde einzureichen."

# game/scripts/c21/c21.rpy:1118
translate german c21s002_PoliceStation_003228b3:

    # pol "Buenos días, Sr. Lamb. ¿En qué puedo ayudarle?"
    pol "Guten Morgen, Herr Lamb. Wie kann ich Ihnen helfen?"

# game/scripts/c21/c21.rpy:1120
translate german c21s002_PoliceStation_65709269:

    # sol "¿No deberíamos pasar a su despacho o algo así?"
    sol "Sollten wir nicht in sein Büro gehen oder so?"

# game/scripts/c21/c21.rpy:1121
translate german c21s002_PoliceStation_a74eee28:

    # pol "Indíqueme primero de qué se trata. La mayoría de las denuncias se toman en este mostrador, para eso está."
    pol "Bitte erklären Sie mir zunächst, worum es hier geht. Die meisten Beschwerden werden an diesem Schalter entgegengenommen; dafür ist er schließlich da."

# game/scripts/c21/c21.rpy:1122
translate german c21s002_PoliceStation_28bf9788:

    # pol "Esto no es Los Angeles ni una película. Nunca se fíe de las películas en cuanto a cómo funciona la Policía de verdad."
    pol "Das ist weder Los Angeles noch ein Film. Traue niemals Filmen, wenn es um die tatsächliche Arbeitsweise der Polizei geht."

# game/scripts/c21/c21.rpy:1123
translate german c21s002_PoliceStation_d4b6bb91:

    # sol "Ah, vale, perdón, es la primera vez que tengo que denunciar a alguien."
    sol "Oh, okay, tut mir leid, es ist das erste Mal, dass ich jemanden melden muss."

# game/scripts/c21/c21.rpy:1125
translate german c21s002_PoliceStation_89157959:

    # sol "Quiero denunciar a [mc] Marks."
    sol "Ich möchte [mc] Marks melden."

# game/scripts/c21/c21.rpy:1126
translate german c21s002_PoliceStation_285ae94a:

    # pol "Un segundo, voy a tomar nota... ¿Por qué quiere denunciarlo?"
    pol "Einen Moment bitte, ich muss mir das kurz notieren... Warum möchten Sie das melden?"

# game/scripts/c21/c21.rpy:1128
translate german c21s002_PoliceStation_05f288d2:

    # sol "Ayer me disparó."
    sol "Er hat mich gestern angeschossen."

# game/scripts/c21/c21.rpy:1130
translate german c21s002_PoliceStation_15b3b448:

    # pol "¿Qué? ¿Está usted herido?"
    pol "Was? Bist du verletzt?"

# game/scripts/c21/c21.rpy:1132
translate german c21s002_PoliceStation_b703678c:

    # sol "No, falló el disparo y no me dio."
    sol "Nein, er hat den Schuss verfehlt und mich nicht getroffen."

# game/scripts/c21/c21.rpy:1133
translate german c21s002_PoliceStation_8d9c9ee4:

    # pol "Eso es muy grave. ¿Dónde ocurrió el intento de asesinato?"
    pol "Das ist sehr ernst. Wo fand der Mordversuch statt?"

# game/scripts/c21/c21.rpy:1135
translate german c21s002_PoliceStation_0424410b:

    # sol "Mmmm... Intento de asesinato... Sí..."
    sol "Mmm... Mordversuch... Ja..."

# game/scripts/c21/c21.rpy:1137
translate german c21s002_PoliceStation_057f9cae:

    # sol "En su casa... bueno, no en su casa... fuera de su casa, en la calle..."
    sol "Zu Hause... nun ja, nicht zu Hause... vor seinem Haus, auf der Straße..."

# game/scripts/c21/c21.rpy:1138
translate german c21s002_PoliceStation_5f8c04af:

    # pol "Déjeme apuntarlo. El Sr. [mc] Marks disparó al Sr. Solomon Lamb en la vía pública."
    pol "Ich möchte Folgendes klarstellen: Herr [mc] Marks hat Herrn Solomon Lamb auf offener Straße erschossen."

# game/scripts/c21/c21.rpy:1139
translate german c21s002_PoliceStation_384fd0d1:

    # sol "Exacto... "
    sol "Genau..."

# game/scripts/c21/c21.rpy:1140
translate german c21s002_PoliceStation_26b542f2:

    # pol "Los moretones que tiene en la cara, ¿también se los hizo el Sr. Marks? ¿O son de un incidente separado?"
    pol "Hat Herr Marks ihm die Prellungen im Gesicht ebenfalls selbst zugefügt? Oder stammen sie von einem anderen Vorfall?"

# game/scripts/c21/c21.rpy:1142
translate german c21s002_PoliceStation_92d5df28:

    # sol "Sí, también. Fue antes de dispararme. En la puerta de su propiedad. Apúntelo."
    sol "Ja, das auch. Es war, bevor er mich erschossen hat. Am Tor seines Grundstücks. Schreib das auf."

# game/scripts/c21/c21.rpy:1143
translate german c21s002_PoliceStation_c6d94bf7:

    # pol "Es decir, estaba usted en su propiedad, ¿no?"
    pol "Mit anderen Worten, Sie befanden sich auf Ihrem Grundstück, richtig?"

# game/scripts/c21/c21.rpy:1145
translate german c21s002_PoliceStation_a841a495:

    # sol "No, no llegué a entrar. Estaba allí... por un tema personal... y me agredió sin venir a cuento ni entrar en su propiedad. Es un tipo muy agresivo."
    sol "Nein, ich bin gar nicht erst reingegangen. Ich war dort wegen einer privaten Angelegenheit, und er hat mich grundlos angegriffen, obwohl ich sein Grundstück noch gar nicht betreten hatte. Er ist ein sehr aggressiver Mann."

# game/scripts/c21/c21.rpy:1146
translate german c21s002_PoliceStation_c3039974:

    # pol "Perfecto, me hago una idea de lo que pasó. El Sr. Marks se ha visto envuelto en un par de incidentes violentos previamente."
    pol "Perfekt, ich habe eine Ahnung, was passiert ist. Herr Marks war bereits in einige gewalttätige Vorfälle verwickelt."

# game/scripts/c21/c21.rpy:1148
translate german c21s002_PoliceStation_97b140b7:

    # sol "¿De verdad? ¡No lo sabía! Teniendo antecedentes, lo detendrán en seguida, ¿verdad?"
    sol "Echt? Das wusste ich nicht! Bei seiner Vorstrafe werden sie ihn doch sofort verhaften, oder?"

# game/scripts/c21/c21.rpy:1149
translate german c21s002_PoliceStation_03a91296:

    # pol "Bueno, primero tenemos que aclarar algunas cosas que no acaban de encajarme."
    pol "Zunächst einmal müssen wir einige Dinge klären, die mir noch nicht ganz klar sind."

# game/scripts/c21/c21.rpy:1150
translate german c21s002_PoliceStation_d81967ce:

    # pol "¿En qué momento el Sr. Marks sacó el arma? ¿Antes o después de apalizarle a usted?"
    pol "Wann genau zog Herr Marks die Waffe? Vor oder nachdem er Sie verprügelt hatte?"

# game/scripts/c21/c21.rpy:1152
translate german c21s002_PoliceStation_c0edd10c:

    # sol "¡No me apalizó! ¡Él recibió tanto o más que yo!"
    sol "Er hat mich nicht verprügelt! Er hat genauso viel oder sogar mehr abbekommen als ich!"

# game/scripts/c21/c21.rpy:1153
translate german c21s002_PoliceStation_81e01352:

    # pol "Ah, entonces fue una pelea... justa... en la que usted iba ganando. ¿En qué momento sacó el arma?"
    pol "Ah, es war also ein fairer Kampf ... in dem Sie die Oberhand hatten. Wann genau haben Sie die Waffe gezogen?"

# game/scripts/c21/c21.rpy:1155
translate german c21s002_PoliceStation_f1c315ad:

    # sol "Bueno... no estoy seguro... supongo que fue cuando... lo dejé tirado en el suelo... yo ya me iba hacia mi camioneta cuando oí el disparo."
    sol "Nun ja... ich bin mir nicht sicher... ich glaube, es war, als... ich ihn am Boden liegen ließ... Ich war schon auf dem Weg zu meinem Truck, als ich den Schuss hörte."

# game/scripts/c21/c21.rpy:1156
translate german c21s002_PoliceStation_81b4bc1b:

    # pol "Entonces, ¿usted le dio la espalda al Sr. Marks y éste sacó un arma y le disparó?"
    pol "Sie drehten also Herrn Marks den Rücken zu, und er zog eine Pistole und erschoss Sie?"

# game/scripts/c21/c21.rpy:1158
translate german c21s002_PoliceStation_d9048d94:

    # sol "Exacto... supongo que fue entonces cuando sacó el arma. Hasta entonces fue una pelea justa entre hombres... o entre un hombre y un niñato."
    sol "Genau... Ich schätze, da hat er die Waffe gezogen. Bis dahin war es ein fairer Kampf zwischen Männern... oder zwischen einem Mann und einem Kind."

# game/scripts/c21/c21.rpy:1159
translate german c21s002_PoliceStation_2972f70c:

    # sol "Por eso no venía a denunciarlo por la agresión... sino por el intento de asesinato."
    sol "Deshalb bin ich nicht gekommen, um ihn wegen Körperverletzung anzuzeigen... sondern wegen versuchten Mordes."

# game/scripts/c21/c21.rpy:1161
translate german c21s002_PoliceStation_75123305:

    # sol "¡Pelea que, obviamente, no empecé yo! Nunca hubiera empezado una pelea con alguien como ese tipo, por mucho que se lo merezca. No hubiera sido justo para él."
    sol "Ein Streit, den ich ganz offensichtlich nicht angefangen habe! Ich hätte niemals einen Streit mit so einem Kerl angefangen, egal wie sehr er es verdient hätte. Das wäre ihm gegenüber unfair gewesen."

# game/scripts/c21/c21.rpy:1162
translate german c21s002_PoliceStation_d14e611f:

    # pol "Perfecto. ¿Hay algún testigo de los hechos?"
    pol "Perfekt. Gibt es Zeugen der Ereignisse?"

# game/scripts/c21/c21.rpy:1164
translate german c21s002_PoliceStation_59c0f692:

    # sol "En su casa había varias mujeres... creo que está formando algún tipo de secta... unas zorras que iban semidesnudas, con las tetas al aire."
    sol "In seinem Haus waren mehrere Frauen... Ich glaube, er gründet irgendeine Sekte... irgendwelche Schlampen, die halbnackt mit entblößten Brüsten herumliefen."

# game/scripts/c21/c21.rpy:1165
translate german c21s002_PoliceStation_037dd5ed:

    # sol "Pero supongo que mentirán para encubrirle."
    sol "Aber ich nehme an, sie werden lügen, um ihn zu decken."

# game/scripts/c21/c21.rpy:1167
translate german c21s002_PoliceStation_a321be9b:

    # sol "Incluso había una puta rubia que intentó pegarme después del disparo. Por suerte, fui rápido, me metí en mi camioneta y me fui."
    sol "Nach der Schießerei versuchte sogar eine blonde Prostituierte, mich zu schlagen. Zum Glück war ich schnell, stieg in meinen Truck und fuhr weg."

# game/scripts/c21/c21.rpy:1168
translate german c21s002_PoliceStation_084f4b16:

    # sol "Soy un caballero que nunca ha pegado a una mujer, pero si mi integridad física se viera amenazada..."
    sol "Ich bin ein Gentleman, der noch nie eine Frau geschlagen hat, aber wenn meine körperliche Unversehrtheit bedroht wäre..."

# game/scripts/c21/c21.rpy:1169
translate german c21s002_PoliceStation_cb8227f3:

    # pol "Perfecto. ¿De cuantas pulgadas era la llave Stilson?"
    pol "Perfekt. Welche Größe hatte der Stilson-Schraubenschlüssel?"

# game/scripts/c21/c21.rpy:1171
translate german c21s002_PoliceStation_f485a842:

    # sol "De 24 pulgadas."
    sol "24 Zoll."

# game/scripts/c21/c21.rpy:1173
translate german c21s002_PoliceStation_3de72a3d:

    # sol "¿Qué? ¿Qué llave?"
    sol "Was? Welche Taste?"

# game/scripts/c21/c21.rpy:1174
translate german c21s002_PoliceStation_16fb09f8:

    # pol "Con la que usted intentó abrirle el cráneo al Sr. Marks por la espalda, a traición."
    pol "Womit Sie versucht haben, Herrn Marks' Schädel von hinten heimtückisch zu öffnen."

# game/scripts/c21/c21.rpy:1175
translate german c21s002_PoliceStation_c309855b:

    # sol "¿Qué? ¡No! ¿Me ha denunciado con esa mentira para cubrirse?"
    sol "Was? Nein! Hat er mich mit dieser Lüge angezeigt, um sich selbst zu schützen?"

# game/scripts/c21/c21.rpy:1177
translate german c21s002_PoliceStation_e68892a6:

    # oma "No hacía falta que le denunciara. Yo estaba allí, no sé si me recuerda. Era una de las zorras con las tetas al aire."
    oma "Es gab keinen Grund, sie anzuzeigen. Ich war dabei, ich weiß nicht, ob sie sich an mich erinnert. Sie war eine von diesen Schlampen, die ihre Brüste entblößten."

# game/scripts/c21/c21.rpy:1178
translate german c21s002_PoliceStation_60a7a513:

    # oma "Con esto y las grabaciones de seguridad, tengo suficiente para arrestarlo por intentar poner una denuncia falsa."
    oma "Damit und mit dem Videomaterial der Überwachungskamera habe ich genug Beweismaterial, um ihn wegen des Versuchs, eine falsche Anzeige zu erstatten, zu verhaften."

# game/scripts/c21/c21.rpy:1179
translate german c21s002_PoliceStation_a111eaa3:

    # oma "Al menos de esta forma, si le meten en prisión, estará a salvo de mi hermana, la rubia que le atizó. Recuerde lo que le dijo sobre el bosque y sobre esconder cadáveres."
    oma "So ist er wenigstens vor meiner Schwester sicher, der Blondine, die ihn verprügelt hat, falls sie ihn ins Gefängnis stecken. Erinnerst du dich, was sie ihm über den Wald und die versteckten Leichen erzählt hat?"

# game/scripts/c21/c21.rpy:1181
translate german c21s002_PoliceStation_23f3db45:

    # sol "¡No, por favor! ¡No le diga nada!"
    sol "Nein, bitte! Sag ihm bloß nichts!"

# game/scripts/c21/c21.rpy:1182
translate german c21s002_PoliceStation_b5035175:

    # sol "Le juro que no intentaré poner una denuncia sobre ese... ese... sobre ese hombre nunca más."
    sol "Ich schwöre, ich werde nie wieder eine Beschwerde darüber einreichen... über diesen Mann."

# game/scripts/c21/c21.rpy:1184
translate german c21s002_PoliceStation_54567218:

    # oma "Sé que, aparte de un mentiroso, es usted un cobarde."
    oma "Ich weiß, dass du, abgesehen davon, dass du ein Lügner bist, auch ein Feigling bist."

# game/scripts/c21/c21.rpy:1185
translate german c21s002_PoliceStation_25c30343:

    # oma "Con lo que creo que es lo que más le conviene. Pero quiero algo a cambio."
    oma "Ich glaube, das ist das Beste für ihn. Aber ich möchte im Gegenzug etwas."

# game/scripts/c21/c21.rpy:1187
translate german c21s002_PoliceStation_2f897f89:

    # sol "¡No tengo dinero! La zorra de mi mujer..."
    sol "Ich habe kein Geld! Meine Frau ist eine Zicke..."

# game/scripts/c21/c21.rpy:1189
translate german c21s002_PoliceStation_ec663ce8:

    # oma "Como vuelva a insultar a alguien de mi familia, mi hermana, la rubia, se enterará de esto."
    oma "Wenn ich noch einmal jemanden in meiner Familie beleidige, wird meine blonde Schwester das herausfinden."

# game/scripts/c21/c21.rpy:1190
translate german c21s002_PoliceStation_673120a3:

    # oma "Y también [mc]. Ya vio lo que le pasó ayer por no parar de insultarlas."
    oma "Und außerdem [mc]. Du hast ja gesehen, was ihm gestern passiert ist, weil er nicht aufgehört hat, sie zu beleidigen."

# game/scripts/c21/c21.rpy:1192
translate german c21s002_PoliceStation_0a4499e8:

    # sol "¡Perdón! Dígame cuánto dinero quiere... haré lo que pueda por conseguirlo..."
    sol "Entschuldigen Sie! Sagen Sie mir, wie viel Geld Sie möchten... Ich werde mein Bestes tun, um es zu besorgen..."

# game/scripts/c21/c21.rpy:1195
translate german c21s002_PoliceStation_253a0e78:

    # oma "No quiero su dinero, pero quiero otras cosas de usted. Va a empezar por...."
    oma "Ich will nicht dein Geld, aber ich will andere Dinge von dir. Es fängt damit an..."

# game/scripts/c21/c21.rpy:1236
translate german c21s002_BettyMassageAndDrivingLicense_7228b7b0:

    # "Mientras tanto, en tu habitación..."
    "Währenddessen in deinem Zimmer..."

# game/scripts/c21/c21.rpy:1240
translate german c21s002_BettyMassageAndDrivingLicense_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c21/c21.rpy:1242
translate german c21s002_BettyMassageAndDrivingLicense_a56b75d9:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c21/c21.rpy:1243
translate german c21s002_BettyMassageAndDrivingLicense_f9c18ad4:

    # mc "Un momento, Tía [bet]."
    mc "Einen Moment bitte, Tante [bet]."

# game/scripts/c21/c21.rpy:1245
translate german c21s002_BettyMassageAndDrivingLicense_cf8cd174:

    # dap "*Susurrando* ¡Nos hemos quedado dormidas!"
    dap "*Flüsternd* Wir sind eingeschlafen!"

# game/scripts/c21/c21.rpy:1247
translate german c21s002_BettyMassageAndDrivingLicense_3fc27f7b:

    # eri "*Susurrando* Danos un momento para vestirnos."
    eri "*Flüsternd* Gebt uns einen Moment, um uns anzuziehen."

# game/scripts/c21/c21.rpy:1249
translate german c21s002_BettyMassageAndDrivingLicense_8208b241:

    # emm "Pasa, Tía [bet]."
    emm "Komm herein, Tante [bet]."

# game/scripts/c21/c21.rpy:1250
translate german c21s002_BettyMassageAndDrivingLicense_586a8abe:

    # emm "*Susurrando* ¿Creéis que aunque nos vistamos no va a saber lo que ha pasado?"
    emm "*Flüsternd* Glaubst du, selbst wenn wir uns anziehen, wird er nicht merken, was passiert ist?"

# game/scripts/c21/c21.rpy:1252
translate german c21s002_BettyMassageAndDrivingLicense_2f8f0326:

    # bet "*Suspiro de sorpresa* ¡Oh!"
    bet "*Überraschtes Seufzen* Oh!"

# game/scripts/c21/c21.rpy:1253
translate german c21s002_BettyMassageAndDrivingLicense_a089bd75:

    # mc "Buenos días, Tía [bet]. ¿Te puedo... te podemos ayudar en algo?"
    mc "Guten Morgen, Tante [bet]. Kann ich... können wir Ihnen irgendwie helfen?"

# game/scripts/c21/c21.rpy:1255
translate german c21s002_BettyMassageAndDrivingLicense_34482b3e:

    # bet "No... venía por lo del carnet de conducir, pero si estás... estáis ocupados... ya volveré más tarde."
    bet "Nein... Ich bin wegen des Führerscheins gekommen, aber wenn Sie beschäftigt sind... komme ich später wieder."

# game/scripts/c21/c21.rpy:1257
translate german c21s002_BettyMassageAndDrivingLicense_57c35b93:

    # eri "No te preocupes, Tía [bet]. Nosotras ya nos íbamos."
    eri "Keine Sorge, Tante [bet]. Wir wollten gerade gehen."

# game/scripts/c21/c21.rpy:1258
translate german c21s002_BettyMassageAndDrivingLicense_54c2425e:

    # mcp "(No se atreve a mirarla directamente. Pese a lo que ha dicho [emm] se tienen que sentir un poco avergonzadas.)"
    mcp "(Sie wagt es nicht, sie direkt anzusehen. Trotz ihrer Worte müssen sie sich ein wenig schämen.)"

# game/scripts/c21/c21.rpy:1259
translate german c21s002_BettyMassageAndDrivingLicense_8c898c2f:

    # mc "Siéntate un momento, Tía [bet]."
    mc "Setz dich einen Moment hin, Tante [bet]."

# game/scripts/c21/c21.rpy:1261
translate german c21s002_BettyMassageAndDrivingLicense_21057d78:

    # dap "Sí, quiero darme una ducha..."
    dap "Ja, ich möchte duschen..."

# game/scripts/c21/c21.rpy:1263
translate german c21s002_BettyMassageAndDrivingLicense_9f93c98b:

    # emm "*Risa* ¿Quieres quitarte todo el sudor de anoche?"
    emm "*Lacht* Möchtest du den ganzen Schweiß von letzter Nacht abwaschen?"

# game/scripts/c21/c21.rpy:1265
translate german c21s002_BettyMassageAndDrivingLicense_088efb80:

    # eri "Ya os dejamos solos, Tía [bet]."
    eri "Wir lassen dich jetzt allein, Tante [bet]."

# game/scripts/c21/c21.rpy:1266
translate german c21s002_BettyMassageAndDrivingLicense_f83f9f91:

    # dap "Si puedes... no se lo cuentes a nadie."
    dap "Wenn möglich... erzähle es niemandem."

# game/scripts/c21/c21.rpy:1267
translate german c21s002_BettyMassageAndDrivingLicense_9d188053:

    # mc "¿Vamos a volver a los secretos después de lo de ayer?"
    mc "Kehren wir nach den gestrigen Ereignissen etwa zu Geheimnissen zurück?"

# game/scripts/c21/c21.rpy:1268
translate german c21s002_BettyMassageAndDrivingLicense_af6c42bd:

    # emm "Por lo que a mí respecta, se lo puedes contar a quien quieras. Estoy orgullosa de que mi novio haya podido complacer a tres mujeres a la vez."
    emm "Mir ist es egal, wem du es erzählst. Ich bin stolz darauf, dass mein Freund drei Frauen gleichzeitig zufriedenstellen konnte."

# game/scripts/c21/c21.rpy:1270
translate german c21s002_BettyMassageAndDrivingLicense_c409a293:

    # emm "No sabes lo que te pierdes siendo monja. *Risa*"
    emm "Du weißt gar nicht, was dir entgeht, wenn du Nonne wirst. *lacht*"

# game/scripts/c21/c21.rpy:1272
translate german c21s002_BettyMassageAndDrivingLicense_6ae4d506:

    # bet "No era lo que esperaba encontrarme... Pero no os preocupéis. No es algo que salga en una conversación normal."
    bet "Das hatte ich nicht erwartet... Aber keine Sorge. So etwas kommt in einem normalen Gespräch nicht zur Sprache."

# game/scripts/c21/c21.rpy:1274
translate german c21s002_BettyMassageAndDrivingLicense_5c9f488e:

    # "Las chicas abandonan la habitación. Ninguna de ellas te da un beso de buenos días."
    "Die Mädchen verlassen den Raum. Keine von ihnen gibt dir einen Guten-Morgen-Kuss."

# game/scripts/c21/c21.rpy:1275
translate german c21s002_BettyMassageAndDrivingLicense_9be5cfb5:

    # bet "¿Te va bien que miremos lo del carnet de conducir ahora?"
    bet "Ist es in Ordnung, wenn wir uns jetzt den Führerschein ansehen?"

# game/scripts/c21/c21.rpy:1277
translate german c21s002_BettyMassageAndDrivingLicense_5066a30e:

    # mcp "(Es mejor que nos pongamos a hacer lo que ha venido a hacer antes de que quiera meter la nariz en lo que acaba de ver.)"
    mcp "(Wir sollten uns besser auf das konzentrieren, wozu sie hierhergekommen ist, bevor sie versucht, in das, was sie gerade gesehen hat, hineinzuschnüffeln.)"

# game/scripts/c21/c21.rpy:1281
translate german c21s002_BettyMassageAndDrivingLicense_dd0461ef_1:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c21/c21.rpy:1282
translate german c21s002_BettyMassageAndDrivingLicense_a56b75d9_1:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c21/c21.rpy:1283
translate german c21s002_BettyMassageAndDrivingLicense_6b5f1a00:

    # mc "Pasa, Tía [bet]."
    mc "Komm herein, Tante [bet]."

# game/scripts/c21/c21.rpy:1285
translate german c21s002_BettyMassageAndDrivingLicense_e24dad1b:

    # bet "Venía a ver si te iba bien que mirásemos lo del carnet de conducir."
    bet "Ich bin gekommen, um zu fragen, ob es für Sie in Ordnung wäre, wenn Sie sich den Führerschein ansehen würden."

# game/scripts/c21/c21.rpy:1286
translate german c21s002_BettyMassageAndDrivingLicense_b39b71f0:

    # mc "Siéntate, voy a coger el portátil."
    mc "Setz dich, ich hole meinen Laptop."

# game/scripts/c21/c21.rpy:1288
translate german c21s002_BettyMassageAndDrivingLicense_ba0312a1:

    # bet "Aunque supongo que no has desayunado aún."
    bet "Ich nehme an, Sie haben noch nicht gefrühstückt."

# game/scripts/c21/c21.rpy:1289
translate german c21s002_BettyMassageAndDrivingLicense_cc4bdecf:

    # mc "No hay ningún problema, hacemos esto y después voy a desayunar. No tengo demasiada hambre, y eso teniendo en cuenta que ayer no cené."
    mc "Kein Problem, wir machen das, und dann frühstücke ich. Ich habe nicht viel Hunger, vor allem, weil ich gestern Abend nichts gegessen habe."

# game/scripts/c21/c21.rpy:1291
translate german c21s002_BettyMassageAndDrivingLicense_10fae0aa:

    # bet "¿Te vas a poner algo de ropa?"
    bet "Wirst du dir etwas anziehen?"

# game/scripts/c21/c21.rpy:1292
translate german c21s002_BettyMassageAndDrivingLicense_fce2d567:

    # mc "No sabía que te molestara, después de lo de aquel día."
    mc "Ich wusste nicht, dass dich das so sehr belastete, nach dem, was an jenem Tag passiert war."

# game/scripts/c21/c21.rpy:1294
translate german c21s002_BettyMassageAndDrivingLicense_cfbf5915:

    # bet "Aquel día no tenías media erección matutina. Es un poco... desconcertante."
    bet "Du hattest an dem Tag nicht mal eine ansatzweise Erektion. Das ist etwas... beunruhigend."

# game/scripts/c21/c21.rpy:1295
translate german c21s002_BettyMassageAndDrivingLicense_7b5c86ed:

    # mc "Espérame un momento mientras me pongo unos shorts o algo."
    mc "Einen Moment bitte, ich ziehe mir schnell Shorts oder so an."

# game/scripts/c21/c21.rpy:1297
translate german c21s002_BettyMassageAndDrivingLicense_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c21/c21.rpy:1298
translate german c21s002_BettyMassageAndDrivingLicense_fe659aee:

    # mc "Pues ya hemos acabado. En una semana deberíamos ir a San Luis para recoger tu nuevo carnet."
    mc "So, wir sind fertig. Wir sollten in einer Woche nach San Luis fahren, um Ihren neuen Führerschein abzuholen."

# game/scripts/c21/c21.rpy:1299
translate german c21s002_BettyMassageAndDrivingLicense_a905b39e:

    # bet "Muchas gracias, [mc]. No hubiera sabido hacerlo si no me hubieras ayudado. No lo ponen fácil para los viejos."
    bet "Vielen Dank, [mc]. Ich hätte es ohne deine Hilfe nicht geschafft. Man macht es älteren Menschen nicht leicht."

# game/scripts/c21/c21.rpy:1300
translate german c21s002_BettyMassageAndDrivingLicense_6b879e9c:

    # mc "No eres vieja, Tía [bet]. *Risa* Eres vintage."
    mc "Du bist nicht alt, Tante [bet]. *Lacht* Du bist Vintage."

# game/scripts/c21/c21.rpy:1302
translate german c21s002_BettyMassageAndDrivingLicense_c45170b9:

    # bet "*Risa* ¡Sí, de la época hippy! Me tenías que haber visto con mi caravana rosa. Seguro que Olivia guarda alguna foto."
    bet "*Lacht* Ja, aus der Hippie-Ära! Du hättest mich mit meinem pinken Wohnwagen sehen sollen. Ich bin sicher, Olivia hat noch Fotos davon."

# game/scripts/c21/c21.rpy:1303
translate german c21s002_BettyMassageAndDrivingLicense_91bb1da6:

    # mc "¡Esas fotos quiero verlas! ¿Eran de cuando ibas a la universidad?"
    mc "Ich möchte diese Fotos sehen! Stammen sie aus deiner Studienzeit?"

# game/scripts/c21/c21.rpy:1305
translate german c21s002_BettyMassageAndDrivingLicense_feafc7ae:

    # bet "Sí, en vez de alquilar un piso o dormir en una residencia, compré una caravana destartalada que tenía \"Amor Libre\" pintado en un costado."
    bet "Ja, anstatt eine Wohnung zu mieten oder in einer Unterkunft zu schlafen, kaufte ich mir einen abgewrackten Wohnwagen, auf dessen einer Seite „Freie Liebe“ stand."

# game/scripts/c21/c21.rpy:1306
translate german c21s002_BettyMassageAndDrivingLicense_b4aa366f:

    # bet "Eran los 70 y la aparqué fuera del campus. No te puedes llegar a imaginar la de gente que llamaba a la puerta de la caravana. *Risa*"
    bet "Es war in den 70ern und ich habe den Wohnwagen außerhalb des Campus geparkt. Ihr könnt euch nicht vorstellen, wie viele Leute an die Tür geklopft haben. *lacht*"

# game/scripts/c21/c21.rpy:1307
translate german c21s002_BettyMassageAndDrivingLicense_660d29c9:

    # mc "La pregunta es si les abrías la puerta. *Risa*"
    mc "Die Frage ist, würdest du ihnen die Tür öffnen? *Gelächter*"

# game/scripts/c21/c21.rpy:1309
translate german c21s002_BettyMassageAndDrivingLicense_2318a23c:

    # bet "La dejé cerrada muchas más veces de las que la abrí. *Risa* Era una chica bastante decente... o bastante tonta."
    bet "Ich habe es viel öfter geschlossen gelassen als geöffnet. *lacht* Sie war ein ganz anständiges Mädchen ... oder ein ziemlich dummes."

# game/scripts/c21/c21.rpy:1310
translate german c21s002_BettyMassageAndDrivingLicense_335c1cad:

    # mc "*Risa* Hubiera sido irónico que durmieras en una residencia a los 18 y volvieras a hacerlo ahora."
    mc "*Lacht* Es wäre ironisch gewesen, wenn du mit 18 in einem Wohnheim geschlafen hättest und es jetzt wieder tun würdest."

# game/scripts/c21/c21.rpy:1313
translate german c21s002_BettyMassageAndDrivingLicense_7e909199:

    # bet "Tus bisabuelos estaban preocupados. Hacía poco que habían estrenado una película sobre universitarios que tenían sexo todo el día."
    bet "Deine Urgroßeltern waren besorgt. Vor kurzem war ein Film über College-Studenten erschienen, die den ganzen Tag Sex hatten."

# game/scripts/c21/c21.rpy:1315
translate german c21s002_BettyMassageAndDrivingLicense_57020f66:

    # bet "Mis padres estaban preocupados. Hacía poco que habían estrenado una película sobre universitarios que tenían sexo todo el día."
    bet "Meine Eltern waren besorgt. Vor kurzem war ein Film erschienen, in dem Studenten den ganzen Tag Sex hatten."

# game/scripts/c21/c21.rpy:1316
translate german c21s002_BettyMassageAndDrivingLicense_b99f4d8f:

    # bet "Todo el mundo pensaba que los dormitorios universitarios eran una orgía continua."
    bet "Alle dachten, in Studentenwohnheimen ginge es nur um eine einzige Orgie."

# game/scripts/c21/c21.rpy:1317
translate german c21s002_BettyMassageAndDrivingLicense_4a023661:

    # bet "No es que no lo fueran, pero es que la película ni siquiera iba de eso. Nunca me hubieran dado dinero para alojarme en un dormitorio."
    bet "Es ist nicht so, dass sie es nicht getan hätten, aber der Film handelte gar nicht davon. Sie hätten mir niemals Geld für ein Zimmer im Studentenwohnheim gegeben."

# game/scripts/c21/c21.rpy:1320
translate german c21s002_BettyMassageAndDrivingLicense_9549a3e5:

    # bet "Aunque si vieran este dormitorio deducirían que no se equivocaban demasiado."
    bet "Wenn sie dieses Schlafzimmer sähen, würden sie allerdings feststellen, dass sie gar nicht so falsch lagen."

# game/scripts/c21/c21.rpy:1322
translate german c21s002_BettyMassageAndDrivingLicense_e1a0bc28:

    # bet "Aunque si vieran lo que acabo de ver, deducirían que no se equivocaban demasiado."
    bet "Wenn sie aber sähen, was ich gerade gesehen habe, würden sie daraus schließen, dass sie gar nicht so weit daneben lagen."

# game/scripts/c21/c21.rpy:1325
translate german c21s002_BettyMassageAndDrivingLicense_e6e08c3b:

    # bet "No sé qué pensarían si supieran que sus nietas regentan un dormitorio."
    bet "Ich weiß nicht, was sie denken würden, wenn sie wüssten, dass ihre Enkelinnen ein Studentenwohnheim leiten."

# game/scripts/c21/c21.rpy:1327
translate german c21s002_BettyMassageAndDrivingLicense_86c5019c:

    # bet "No sé qué pensarían si supieran que su nieta regenta un dormitorio."
    bet "Ich weiß nicht, was sie denken würden, wenn sie wüssten, dass ihre Enkelin ein Studentenwohnheim leitet."

# game/scripts/c21/c21.rpy:1328
translate german c21s002_BettyMassageAndDrivingLicense_4f1990ab:

    # mc "Se darían cuenta de que tienen un montón de bisnietas nuevas. *Risa* Estamos creando una familia enorme."
    mc "Sie würden merken, dass sie plötzlich eine ganze Schar neuer Urenkelinnen haben. *lacht* Wir gründen eine riesige Familie."

# game/scripts/c21/c21.rpy:1330
translate german c21s002_BettyMassageAndDrivingLicense_204d9f2c:

    # mc "Pero volviendo a la caravana... ¿Cómo pasaste de una caravana en la que pone Amor Libre a un convento?"
    mc "Aber zurück zum Wohnwagen... Wie kam es, dass man von einem Wohnwagen mit der Aufschrift „Freie Liebe“ zu einem Kloster gelangte?"

# game/scripts/c21/c21.rpy:1333
translate german c21s002_BettyMassageAndDrivingLicense_d54bf5e6:

    # bet "Me enamoré de la persona equivocada en mi primer año. Estuve enamorada de él durante años."
    bet "Ich habe mich im ersten Studienjahr in den Falschen verliebt. Ich war jahrelang in ihn verliebt."

# game/scripts/c21/c21.rpy:1334
translate german c21s002_BettyMassageAndDrivingLicense_be500193:

    # bet "Cuando acabé la carrera, me metí en la iglesia. Acabé la especialización en neurocirugía allí."
    bet "Nach meinem Studienabschluss trat ich der Kirche bei. Dort absolvierte ich meine Facharztausbildung im Bereich Neurochirurgie."

# game/scripts/c21/c21.rpy:1335
translate german c21s002_BettyMassageAndDrivingLicense_a9b27d2b:

    # bet "Como no dejaba de... encontrármelo, era una forma de evitar las tentaciones y repetir errores."
    bet "Da ich ihm immer wieder begegnete, war das eine Möglichkeit, Versuchungen zu vermeiden und Fehler nicht zu wiederholen."

# game/scripts/c21/c21.rpy:1336
translate german c21s002_BettyMassageAndDrivingLicense_773a26a1:

    # bet "Tenía algo de vocación, pero seguramente no me hubiera hecho monja si no hubiera sido por él."
    bet "Ich hatte zwar eine gewisse Berufung, aber ohne ihn wäre ich sicherlich keine Nonne geworden."

# game/scripts/c21/c21.rpy:1337
translate german c21s002_BettyMassageAndDrivingLicense_486fb2f2:

    # mc "¿Te hizo daño?"
    mc "Hat es dir wehgetan?"

# game/scripts/c21/c21.rpy:1339
translate german c21s002_BettyMassageAndDrivingLicense_334e2e3c:

    # bet "No, [mc]. El daño me lo hice yo misma. Él siempre se comportó como la mejor persona que había conocido... hasta entonces."
    bet "Nein, [mc]. Ich habe mich selbst verletzt. Er war immer der beste Mensch, den ich je gekannt habe ... bis dahin."

# game/scripts/c21/c21.rpy:1340
translate german c21s002_BettyMassageAndDrivingLicense_59f034e6:

    # bet "Hubo un par de años después de conocerlo que fueron un desastre para mí a nivel personal."
    bet "Es folgten ein paar Jahre nach unserer Begegnung, die für mich persönlich eine Katastrophe waren."

# game/scripts/c21/c21.rpy:1341
translate german c21s002_BettyMassageAndDrivingLicense_4256b42e:

    # bet "Para intentar olvidarlo hice cosas de las que no me siento orgullosa. Y me junté con gente que no me hizo bien."
    bet "Um ihn zu vergessen, habe ich Dinge getan, auf die ich nicht stolz bin. Und ich habe Zeit mit Leuten verbracht, die mir nicht guttaten."

# game/scripts/c21/c21.rpy:1342
translate german c21s002_BettyMassageAndDrivingLicense_fa725485:

    # mc "¿Lo has vuelto a ver?"
    mc "Hast du ihn wiedergesehen?"

# game/scripts/c21/c21.rpy:1344
translate german c21s002_BettyMassageAndDrivingLicense_a35f4a5f:

    # bet "Sí... mmmm... nos seguimos viendo durante bastante tiempo, lo cual lo empeoraba todo."
    bet "Ja... mmm... wir haben uns noch eine ganze Weile getroffen, was alles nur noch schlimmer gemacht hat."

# game/scripts/c21/c21.rpy:1345
translate german c21s002_BettyMassageAndDrivingLicense_268d5c70:

    # bet "Acabé la residencia en el otro lado del país, trabajé en Luisiana un tiempo... no quería quedarme en California..."
    bet "Ich habe meine Facharztausbildung auf der anderen Seite des Landes abgeschlossen, eine Zeit lang in Louisiana gearbeitet... Ich wollte nicht in Kalifornien bleiben..."

# game/scripts/c21/c21.rpy:1346
translate german c21s002_BettyMassageAndDrivingLicense_d3ee8e00:

    # bet "Decidí pedir el traslado a Ghana cuando salió una plaza en un hospital de misioneros. De ahí a Angola, Sudán, Zaire... hasta acabar en Tanzania."
    bet "Als in einem Missionskrankenhaus eine Stelle frei wurde, beschloss ich, mich nach Ghana versetzen zu lassen. Von dort ging es weiter nach Angola, Sudan, Zaire… bis ich schließlich in Tansania landete."

# game/scripts/c21/c21.rpy:1347
translate german c21s002_BettyMassageAndDrivingLicense_c8f4743e:

    # mc "Tuvo que ser duro, irte tan lejos de la familia..."
    mc "Es muss schwer gewesen sein, so weit weg von der Familie zu sein..."

# game/scripts/c21/c21.rpy:1349
translate german c21s002_BettyMassageAndDrivingLicense_a3484d42:

    # bet "Al principio sí. Después se convirtió en una vida de aventuras, cambiando de país cada pocos años, conociendo sitios y gente nueva."
    bet "Zunächst ja. Dann wurde es ein Leben voller Abenteuer, in dem ich alle paar Jahre das Land wechselte und neue Orte und Menschen kennenlernte."

# game/scripts/c21/c21.rpy:1350
translate german c21s002_BettyMassageAndDrivingLicense_3d4c2966:

    # bet "No me arrepiento de haberlo hecho. He tenido una vida que mucha gente no puede ni siquiera soñar."
    bet "Ich bereue es nicht. Ich habe ein Leben geführt, von dem viele Menschen nicht einmal träumen können."

# game/scripts/c21/c21.rpy:1351
translate german c21s002_BettyMassageAndDrivingLicense_569e9dd5:

    # mc "Lejos de la familia y renunciando a muchas cosas..."
    mc "Weit weg von der Familie und mit dem Verzicht auf vieles..."

# game/scripts/c21/c21.rpy:1353
translate german c21s002_BettyMassageAndDrivingLicense_1283acb7:

    # bet "Todos renunciamos a cosas, [mc]. [mar] me dijo que renunciaste a una buena oferta de trabajo para venir aquí."
    bet "Wir alle geben Dinge auf, [mc]. [mar] hat mir erzählt, dass du ein gutes Jobangebot abgelehnt hast, um hierher zu kommen."

# game/scripts/c21/c21.rpy:1355
translate german c21s002_BettyMassageAndDrivingLicense_68bda792:

    # bet "[mar] renunció a su sueño de tener un restaurante propio cuando se casó con tu padre y llegaste tú."
    bet "[mar] gab ihren Traum, ein eigenes Restaurant zu besitzen, auf, als sie deinen Vater heiratete und du geboren wurdest."

# game/scripts/c21/c21.rpy:1357
translate german c21s002_BettyMassageAndDrivingLicense_5e6090bd:

    # bet "[mar] renunció a su sueño de tener un restaurante propio cuando murió Dominic y se vio sola con [emm]."
    bet "[mar] gab ihren Traum, ein eigenes Restaurant zu besitzen, auf, als Dominic starb, und sie fand sich allein mit [emm] wieder."

# game/scripts/c21/c21.rpy:1359
translate german c21s002_BettyMassageAndDrivingLicense_262b2ea7:

    # bet "¿Te arrepientes de haber vuelto a casa? ¿Crees que [mar] se arrepiente de haber renunciado a su restaurante?"
    bet "Bereust du deine Rückkehr nach Hause? Glaubst du, dass [mar] es bereut, ihr Restaurant aufgegeben zu haben?"

# game/scripts/c21/c21.rpy:1360
translate german c21s002_BettyMassageAndDrivingLicense_217b23fe:

    # mc "No, tienes razón. Renunciamos a cosas pero encontramos otras cosas que se convierten en nuestra vida gracias a ello."
    mc "Nein, du hast Recht. Wir geben zwar einiges auf, finden aber dadurch auch andere Dinge, die Teil unseres Lebens werden."

# game/scripts/c21/c21.rpy:1362
translate german c21s002_BettyMassageAndDrivingLicense_e4129e9f:

    # bet "Hasta que deciden apartarte..."
    bet "Bis sie beschließen, dich wegzustoßen..."

# game/scripts/c21/c21.rpy:1363
translate german c21s002_BettyMassageAndDrivingLicense_91de43a3:

    # mc "Aún no lo sabes, Tía [bet]. Esperemos a la visita a Monterey."
    mc "Du weißt es noch nicht, Tante [bet]. Warten wir bis zum Besuch in Monterey."

# game/scripts/c21/c21.rpy:1365
translate german c21s002_BettyMassageAndDrivingLicense_5bb7878d:

    # bet "Ayer estuve pensando sobre eso cuando me fui a la cama... antes de interrumpir vuestra partida."
    bet "Ich habe gestern darüber nachgedacht, als ich ins Bett ging... bevor ich dein Spiel unterbrach."

# game/scripts/c21/c21.rpy:1366
translate german c21s002_BettyMassageAndDrivingLicense_1e2b294d:

    # bet "Ya sabes que en esto soy como [dap]. Me gusta pensar todos los posibles escenarios."
    bet "Du weißt ja, dass ich da so bin wie [dap]. Ich denke gern über alle möglichen Szenarien nach."

# game/scripts/c21/c21.rpy:1367
translate german c21s002_BettyMassageAndDrivingLicense_2e8699da:

    # mc "No sirve de nada si no sabes qué te van a decir."
    mc "Es nützt nichts, wenn man nicht weiß, was sie sagen werden."

# game/scripts/c21/c21.rpy:1369
translate german c21s002_BettyMassageAndDrivingLicense_0d1a0514:

    # bet "Lo sé, puede que me esté haciendo un mundo y solo sea una visita de cortesía."
    bet "Ich weiß, vielleicht mache ich ein großes Drama daraus und es ist nur ein Höflichkeitsbesuch."

# game/scripts/c21/c21.rpy:1370
translate german c21s002_BettyMassageAndDrivingLicense_04e83abc:

    # bet "Pero para alguno de los posibles escenarios ya he tomado una decisión."
    bet "Aber für einige der möglichen Szenarien habe ich bereits eine Entscheidung getroffen."

# game/scripts/c21/c21.rpy:1371
translate german c21s002_BettyMassageAndDrivingLicense_1fec4f5f:

    # mc "¿Qué escenarios? ¿Qué decisiones?"
    mc "Welche Szenarien? Welche Entscheidungen?"

# game/scripts/c21/c21.rpy:1373
translate german c21s002_BettyMassageAndDrivingLicense_dae84818:

    # bet "No voy a dejar de ser cirujana. Me encanta mi trabajo. Si quieren apartarme o encerrarme, abandonaré la Iglesia y buscaré trabajo como... lego."
    bet "Ich werde nicht aufhören, Chirurg zu sein. Ich liebe meinen Beruf. Wenn sie mich entfernen oder einsperren wollen, verlasse ich die Kirche und suche mir eine Stelle als... Laie."

# game/scripts/c21/c21.rpy:1374
translate german c21s002_BettyMassageAndDrivingLicense_d43172d0:

    # bet "No sé si unirme a Doctores Sin Fronteras o algo así. He colaborado con ellos algunas veces. Sería una forma de poder volver a África."
    bet "Ich bin mir noch nicht sicher, ob ich mich Ärzte ohne Grenzen oder einer ähnlichen Organisation anschließen soll. Ich habe schon ein paar Mal mit ihnen zusammengearbeitet. Das wäre eine Möglichkeit für mich, nach Afrika zurückzukehren."

# game/scripts/c21/c21.rpy:1375
translate german c21s002_BettyMassageAndDrivingLicense_086c441b:

    # bet "Me tendría que volver a certificar, pero..."
    bet "Ich müsste mich neu zertifizieren lassen, aber..."

# game/scripts/c21/c21.rpy:1376
translate german c21s002_BettyMassageAndDrivingLicense_30d66849:

    # mc "Creo que no deberías tomar decisiones tan precipitadas, Tía [bet], y menos aún sin saber qué es lo que te van a decir."
    mc "Ich glaube, du solltest keine so überstürzten Entscheidungen treffen, Tante [bet], vor allem nicht, ohne zu wissen, was sie dir sagen werden."

# game/scripts/c21/c21.rpy:1377
translate german c21s002_BettyMassageAndDrivingLicense_dc220712:

    # mc "Y preferiría que no te fueras, si se diera el caso. Tienes aquí a tu familia, Meemaw se va a mudar también aquí."
    mc "Und ich würde es vorziehen, wenn du nicht weggehen würdest, falls das der Fall wäre. Deine Familie ist hier, und Meemaw zieht auch hierher."

# game/scripts/c21/c21.rpy:1378
translate german c21s002_BettyMassageAndDrivingLicense_8d419e89:

    # mc "Sé que te encanta África y no voy a pedirte que renuncies a ello, pero sí que voy a pedirte que lo pienses."
    mc "Ich weiß, dass du Afrika liebst, und ich werde dich nicht bitten, es aufzugeben, aber ich werde dich bitten, darüber nachzudenken."

# game/scripts/c21/c21.rpy:1380
translate german c21s002_BettyMassageAndDrivingLicense_f98aa382:

    # bet "Creo que tienes razón. Quizás me estoy adelantando demasiado."
    bet "Ich glaube, du hast recht. Vielleicht bin ich aber auch etwas voreilig."

# game/scripts/c21/c21.rpy:1382
translate german c21s002_BettyMassageAndDrivingLicense_50923333:

    # bet "Gracias por la conversación, me ha ayudado mucho. Te veo luego."
    bet "Danke für das Gespräch, es war sehr hilfreich. Bis später."

# game/scripts/c21/c21.rpy:1383
translate german c21s002_BettyMassageAndDrivingLicense_e337baaf:

    # bet "Voy a darle el masaje a Olivia antes de que se haga más tarde."
    bet "Ich werde Olivia noch eine Massage geben, bevor es zu spät wird."

# game/scripts/c21/c21.rpy:1386
translate german c21s002_BettyMassageAndDrivingLicense_031ca091:

    # bet "Cuando volví de misa no hacía más que hablar de lo bien que lo habías hecho."
    bet "Als ich von der Messe zurückkam, konnte ich an nichts anderes mehr denken als daran, wie gut du das gemacht hattest."

# game/scripts/c21/c21.rpy:1388
translate german c21s002_BettyMassageAndDrivingLicense_55955fea:

    # bet "Por un momento pensé que también iba a confesar que estaba contigo. *Risa*"
    bet "Einen Moment lang dachte ich, er würde gestehen, dass er auch mit dir zusammen war. *lacht*"

# game/scripts/c21/c21.rpy:1390
translate german c21s002_BettyMassageAndDrivingLicense_46534dd4:

    # bet "Por un momento pensé que iba a confesar que estaba contigo. *Risa*"
    bet "Einen Moment lang dachte ich, er würde gestehen, dass er mit dir zusammen war. *lacht*"

# game/scripts/c21/c21.rpy:1391
translate german c21s002_BettyMassageAndDrivingLicense_279bc220:

    # mc "*Risa* ¿Te imaginas la cara que hubierais puesto todas?"
    mc "*Gelächter* Könnt ihr euch eure Gesichter vorstellen?"

# game/scripts/c21/c21.rpy:1392
translate german c21s002_BettyMassageAndDrivingLicense_dfd5401b:

    # mc "Ve a darle el masaje antes de que se impaciente."
    mc "Gib ihm die Massage, bevor er ungeduldig wird."

# game/scripts/c21/c21.rpy:1394
translate german c21s002_BettyMassageAndDrivingLicense_fbcea2f0:

    # mc "Pero antes, ¿no tengo beso de buenos días?"
    mc "Aber bekomme ich nicht zuerst einen Guten-Morgen-Kuss?"

# game/scripts/c21/c21.rpy:1395
translate german c21s002_BettyMassageAndDrivingLicense_7fec4f33:

    # bet "Sobre eso... si no te importa... Sé que lo propuse yo, pero... preferiría dejar de hacerlo."
    bet "Was das betrifft... wenn es Ihnen nichts ausmacht... ich weiß, ich habe es vorgeschlagen, aber... ich würde es lieber lassen."

# game/scripts/c21/c21.rpy:1396
translate german c21s002_BettyMassageAndDrivingLicense_eeb3e37d:

    # mc "*Risa* ¿Beso demasiado bien y te vienen pensamientos demasiado impuros para una monja?"
    mc "*Lacht* Küsse ich etwa zu gut und du hast deshalb Gedanken, die für eine Nonne zu unrein sind?"

# game/scripts/c21/c21.rpy:1398
translate german c21s002_BettyMassageAndDrivingLicense_77afb663:

    # bet "*Risa* ¿Eso es lo que querrías? ¡Creía que eras un buen chico!"
    bet "*Lacht* War das dein Wunsch? Ich dachte, du wärst ein braver Junge!"

# game/scripts/c21/c21.rpy:1399
translate german c21s002_BettyMassageAndDrivingLicense_c3c47659:

    # mc "En serio, si te incomoda no hay ningún problema por dejar de hacerlo."
    mc "Ganz ehrlich, wenn es Ihnen unangenehm ist, ist es kein Problem, damit aufzuhören."

# game/scripts/c21/c21.rpy:1401
translate german c21s002_BettyMassageAndDrivingLicense_c87bee9f:

    # bet "¿Recuerdas por qué lo propuse?"
    bet "Erinnerst du dich, warum ich das vorgeschlagen habe?"

# game/scripts/c21/c21.rpy:1402
translate german c21s002_BettyMassageAndDrivingLicense_c5fbcc46:

    # mc "Para fastidiar a Meemaw."
    mc "Um Meemaw zu ärgern."

# game/scripts/c21/c21.rpy:1403
translate german c21s002_BettyMassageAndDrivingLicense_7afaff1c:

    # bet "Ahora que parece que ya no le importa, no hay razón para seguir haciéndolo."
    bet "Da es ihm anscheinend egal ist, gibt es keinen Grund mehr, damit weiterzumachen."

# game/scripts/c21/c21.rpy:1405
translate german c21s002_BettyMassageAndDrivingLicense_a8a6c874:

    # bet "No está bien que una monja haga eso. No creo que el Obispo lo aprobara, y menos aún en mi situación."
    bet "Das ist für eine Nonne nicht angemessen. Ich glaube nicht, dass der Bischof das gutheißen würde, vor allem nicht in meiner Situation."

# game/scripts/c21/c21.rpy:1406
translate german c21s002_BettyMassageAndDrivingLicense_16ea5513:

    # mc "Te entiendo. No te preocupes. No hay ningún problema en dejar de hacerlo, pero si alguna de las chicas pregunta, serás tú quien se lo explique."
    mc "Ich verstehe. Keine Sorge. Es ist kein Problem, damit aufzuhören, aber falls eines der Mädchen fragt, wirst du es ihnen erklären."

# game/scripts/c21/c21.rpy:1408
translate german c21s002_BettyMassageAndDrivingLicense_9cbb42fe:

    # bet "Me parece un trato justo. Te veo luego si no estás muy ocupado. Voy a darle ese masaje a Olivia antes de que se impaciente."
    bet "Das klingt fair. Wir sehen uns später, wenn du nicht zu beschäftigt bist. Ich massiere Olivia noch schnell, bevor sie ungeduldig wird."

# game/scripts/c21/c21.rpy:1409
translate german c21s002_BettyMassageAndDrivingLicense_05812d8f:

    # mc "Espera, Tía [bet]."
    mc "Warte, Tante [bet]."

# game/scripts/c21/c21.rpy:1411
translate german c21s002_BettyMassageAndDrivingLicense_f947d43b:

    # mc "Estoy dispuesto a dejar los besos de lado, pero no los abrazos."
    mc "Auf Küsse kann ich verzichten, auf Umarmungen aber nicht."

# game/scripts/c21/c21.rpy:1413
translate german c21s002_BettyMassageAndDrivingLicense_1577c66c:

    # bet "Nunca voy a permitirte que dejes de dármelos."
    bet "Ich werde niemals zulassen, dass du aufhörst, sie mir zu geben."

# game/scripts/c21/c21.rpy:1414
translate german c21s002_BettyMassageAndDrivingLicense_1738c3ad:

    # mc "Ahora ya puedes ir a masajear esas tetas."
    mc "Jetzt kannst du dir die Brüste massieren."

# game/scripts/c21/c21.rpy:1416
translate german c21s002_BettyMassageAndDrivingLicense_31fc745e:

    # bet "Olivia puede esperar un par de minutos más... se está muy bien aquí."
    bet "Olivia kann noch ein paar Minuten warten... es ist sehr schön hier."

# game/scripts/c21/c21.rpy:1417
translate german c21s002_BettyMassageAndDrivingLicense_dd201e21:

    # mc "Tantos minutos como necesites."
    mc "So viele Minuten, wie Sie benötigen."

# game/scripts/c21/c21.rpy:1420
translate german c21s002_BettyMassageAndDrivingLicense_6f8bfe7a:

    # "Casi diez minutos después, [bet] abandona tu habitación."
    "Fast zehn Minuten später [bet] verlassen Sie Ihr Zimmer."

# game/scripts/c21/c21.rpy:1426
translate german c21s002_AaronCall_4141d7ac:

    # "Bajas a desayunar, y al volver a tu habitación..."
    "Du gehst zum Frühstück nach unten, und wenn du in dein Zimmer zurückkehrst..."

# game/scripts/c21/c21.rpy:1428
translate german c21s002_AaronCall_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1429
translate german c21s002_AaronCall_9987422b:

    # mcp "(Videoconferencia de un número desconocido, pero el prefijo es de Aruba.)"
    mcp "(Videokonferenz von einer unbekannten Nummer, aber die Vorwahl stammt aus Aruba.)"

# game/scripts/c21/c21.rpy:1433
translate german c21s002_AaronCall_1c7111b2:

    # mc "Buenos días, [aar]"
    mc "Guten Morgen, [aar]"

# game/scripts/c21/c21.rpy:1434
translate german c21s002_AaronCall_c1e7a21d:

    # aar "Hola, [mc]. Te debía una llamada desde hace unos días. ¿Puedes hablar? ¿Estás solo?"
    aar "Hallo [mc]. Ich schulde dir noch einen Anruf von vor ein paar Tagen. Kannst du sprechen? Bist du allein?"

# game/scripts/c21/c21.rpy:1435
translate german c21s002_AaronCall_37be49c1:

    # mc "Sí, llevo varios días esperándola."
    mc "Ja, ich warte schon seit mehreren Tagen darauf."

# game/scripts/c21/c21.rpy:1437
translate german c21s002_AaronCall_20b8d4d3:

    # aar "¿Cómo se están portando mis dos chicas? Anoche hablé con ellas y estaban entusiasmadas con... unas muñecas..."
    aar "Wie benehmen sich meine beiden Mädchen? Ich habe gestern Abend mit ihnen gesprochen und sie waren ganz aufgeregt wegen... ein paar Puppen..."

# game/scripts/c21/c21.rpy:1438
translate german c21s002_AaronCall_e11ef6ad:

    # aar "No quisieron decirme a qué se referían. ¿Le han puesto un mote a alguna de tus chicas?"
    aar "Sie wollten mir nicht sagen, was sie damit meinten. Haben sie einer deiner Mädchen einen Spitznamen gegeben?"

# game/scripts/c21/c21.rpy:1439
translate german c21s002_AaronCall_87f7cf83:

    # mc "No, [aar], pero si no quisieron decirte de que iba el tema, no voy a ser yo quien lo haga."
    mc "Nein, [aar], aber wenn sie dir nicht sagen wollen, worum es geht, werde ich es nicht tun."

# game/scripts/c21/c21.rpy:1441
translate german c21s002_AaronCall_c819bfc5:

    # aar "Me parece bien. Pero, ¿cómo se están portando? No me has contestado."
    aar "Das klingt gut. Aber wie verhalten sie sich? Sie haben mir noch nicht geantwortet."

# game/scripts/c21/c21.rpy:1442
translate german c21s002_AaronCall_d8ceffa6:

    # mc "Muy bien. Se están integrando genial en la familia y todo el mundo las adora."
    mc "Sehr gut. Sie haben sich wunderbar in die Familie eingelebt und alle lieben sie."

# game/scripts/c21/c21.rpy:1444
translate german c21s002_AaronCall_0cf727f2:

    # aar "Por todo el mundo... te refieres a ti, a [mar] y a [nor], ¿verdad?"
    aar "Auf der ganzen Welt... du meinst wohl dich, [mar] und [nor], richtig?"

# game/scripts/c21/c21.rpy:1445
translate german c21s002_AaronCall_62e249b3:

    # mc "No, [aar], a toda la familia. ¿Qué crees que querían decir [mar] y [nor] cuando las invitaron a comer y a cenar a casa?"
    mc "Nein, [aar], die ganze Familie. Was meinten [mar] und [nor] wohl, als sie sie zum Mittag- und Abendessen nach Hause einluden?"

# game/scripts/c21/c21.rpy:1447
translate german c21s002_AaronCall_778fce69:

    # aar "Realmente no lo había pensado. Creía que iba a ser... no sé... para conocerse mejor. Algo privado de ellas cuatro."
    aar "Ich hatte mir darüber keine großen Gedanken gemacht. Ich dachte, es würde... ich weiß nicht... dazu dienen, sich besser kennenzulernen. Etwas Privates zwischen den vieren."

# game/scripts/c21/c21.rpy:1448
translate german c21s002_AaronCall_81e38309:

    # mc "[aar], creo que no entiendes a mi familia. Intentamos no guardar secretos, y en este estaban implicadas [eri], [dap], y [emm]."
    mc "[aar], Ich glaube, Sie verstehen meine Familie nicht. Wir versuchen, keine Geheimnisse zu haben, und [eri], [dap] und [emm] waren in diesen Fall verwickelt."

# game/scripts/c21/c21.rpy:1450
translate german c21s002_AaronCall_a3a825e3:

    # aar "Bueno, si es así, supongo que no hay ningún problema porque lo sepan. Ellas también son accionistas de La Compañía."
    aar "Nun, wenn das so ist, dürfte es wohl kein Problem sein, dass sie es wissen. Sie sind ja auch Aktionäre des Unternehmens."

# game/scripts/c21/c21.rpy:1451
translate german c21s002_AaronCall_ee28dc16:

    # mc "Sigues sin entenderlo. Lo sabe toda la familia. Ayer estuvieron en la fiesta de cumpleaños de las chicas. 25 personas."
    mc "Du verstehst es immer noch nicht. Die ganze Familie weiß es. Sie waren gestern auf der Geburtstagsfeier der Mädchen. 25 Personen."

# game/scripts/c21/c21.rpy:1453
translate german c21s002_AaronCall_681e2a3c:

    # aar "¿Qué? No me parece bien, [mc]. No están preparadas para eso y, si el secreto sale a la luz, pueden tener problemas."
    aar "Was? Ich glaube nicht, dass das richtig ist. Dafür sind sie noch nicht bereit, und wenn das Geheimnis ans Licht kommt, könnten sie in Schwierigkeiten geraten."

# game/scripts/c21/c21.rpy:1454
translate german c21s002_AaronCall_2c6f98cc:

    # aar "Tus chicas y las mías."
    aar "Deine und meine Mädchen."

# game/scripts/c21/c21.rpy:1455
translate german c21s002_AaronCall_e9d1a1ef:

    # mc "Sigues sin entenderlo. Tus chicas son mis chicas también. Nuestras chicas. De la familia."
    mc "Du verstehst es immer noch nicht. Deine Mädchen sind auch meine Mädchen. Unsere Mädchen. Familie."

# game/scripts/c21/c21.rpy:1456
translate german c21s002_AaronCall_ea0668be:

    # mc "Nadie va a hacer nada para perjudicarlas. Apostaría mi vida en ello."
    mc "Niemand wird ihnen etwas antun. Darauf würde ich wetten."

# game/scripts/c21/c21.rpy:1458
translate german c21s002_AaronCall_95c9301c:

    # aar "Pero no están preparadas para ese tipo de interacciones sociales... no tienen entrenamiento para eso."
    aar "Aber sie sind nicht auf solche sozialen Interaktionen vorbereitet... dafür haben sie keine Ausbildung."

# game/scripts/c21/c21.rpy:1459
translate german c21s002_AaronCall_b3d3453b:

    # mc "Pues, al no tener entrenamiento, usaron su instinto. Y se les dio bien. No debes sobreprotegerlas."
    mc "Da sie keine Ausbildung hatten, folgten sie ihren Instinkten. Und das haben sie gut gemacht. Man sollte sie nicht überbehüten."

# game/scripts/c21/c21.rpy:1460
translate german c21s002_AaronCall_60636dc3:

    # mcp "(De eso ya me ocuparé yo.)"
    mcp "(Ich kümmere mich darum.)"

# game/scripts/c21/c21.rpy:1462
translate german c21s002_AaronCall_1967bdf8:

    # aar "No me queda más remedio que confiar en ti, ¿no?"
    aar "Mir bleibt wohl nichts anderes übrig, als dir zu vertrauen, oder?"

# game/scripts/c21/c21.rpy:1463
translate german c21s002_AaronCall_3e5bfe1e:

    # mc "Esto es un camino en dos direcciones. Yo he confiado en ti, ahora te toca confiar en mí. Y en ellas. En todos nosotros."
    mc "Das beruht auf Gegenseitigkeit. Ich habe dir vertraut, jetzt bist du an der Reihe, mir zu vertrauen. Und ihnen. Uns allen."

# game/scripts/c21/c21.rpy:1464
translate german c21s002_AaronCall_593d6733:

    # mc "Pero supongo que no me llamabas solo por eso, ¿no?"
    mc "Aber ich nehme an, Sie haben mich nicht nur aus diesem Grund angerufen, oder?"

# game/scripts/c21/c21.rpy:1466
translate german c21s002_AaronCall_0ba84e38:

    # aar "No. Te llamaba porque ha habido una filtración durante el proceso de toma de poder."
    aar "Nein. Ich rufe an, weil es während des Machtübernahmeprozesses zu einem Leck gekommen ist."

# game/scripts/c21/c21.rpy:1467
translate german c21s002_AaronCall_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Was ist passiert?"

# game/scripts/c21/c21.rpy:1468
translate german c21s002_AaronCall_32fa659b:

    # aar "Una de las competidoras de NTR en el mundo de las... operaciones de seguridad... ha recibido información sobre el cambio de propietarios."
    aar "Einer der Konkurrenten von NTR im Bereich der Sicherheitsoperationen hat Informationen über den Eigentümerwechsel erhalten."

# game/scripts/c21/c21.rpy:1469
translate german c21s002_AaronCall_1e8a5b88:

    # mc "Eso es malo, ¿no? ¿Estamos en peligro otra vez? ¿También tienen clones?"
    mc "Das ist schlimm, nicht wahr? Sind wir wieder in Gefahr? Haben die etwa auch Klone?"

# game/scripts/c21/c21.rpy:1471
translate german c21s002_AaronCall_fab57a01:

    # aar "No, no es especialmente malo. No van a tomar ninguna acción violenta o ilegal. Y no, no tienen clones, actúan con personal exmilitar."
    aar "Nein, es ist nicht besonders schlimm. Sie werden keine gewalttätigen oder illegalen Maßnahmen ergreifen. Und nein, sie haben keine Klone; sie arbeiten mit ehemaligen Militärangehörigen."

# game/scripts/c21/c21.rpy:1472
translate german c21s002_AaronCall_6ba3a832:

    # aar "Quieren comprar NTR aprovechando lo que consideran una posición de debilidad. ¿Habéis hablado ya sobre si vais a vender vuestras acciones?"
    aar "Sie wollen NTR kaufen und dabei eine ihrer Ansicht nach schwache Position ausnutzen. Haben Sie bereits besprochen, ob Sie Ihre Aktien verkaufen werden?"

# game/scripts/c21/c21.rpy:1473
translate german c21s002_AaronCall_116344af:

    # mc "Yo no voy a venderlas y [dap] tampoco. Supongo que tú, [ama] y [eva] tampoco."
    mc "Ich werde sie nicht verkaufen, und [dap] auch nicht. Ich nehme an, du, [ama] und [eva] auch nicht."

# game/scripts/c21/c21.rpy:1475
translate german c21s002_AaronCall_2223e756:

    # aar "No, no vamos a vender, con lo que podrían hacerse con un 50%% de la compañía como máximo. No es malo del todo, pero tampoco bueno."
    aar "Nein, wir werden nicht verkaufen, daher könnten sie maximal 50%% der Firma erhalten. Es ist nicht alles schlecht, aber auch nicht optimal."

# game/scripts/c21/c21.rpy:1476
translate german c21s002_AaronCall_ea8b9317:

    # mc "No creo que [mar], [nor], [emm], o [eri] vayan a querer vender tampoco."
    mc "Ich glaube nicht, dass [mar], [nor], [emm] oder [eri] verkaufen wollen."

# game/scripts/c21/c21.rpy:1477
translate german c21s002_AaronCall_19f7739d:

    # aar "Eso es mejor todavía, pero deberíais concretarlo. Hoy."
    aar "Das ist sogar noch besser, aber du solltest es abschließen. Heute noch."

# game/scripts/c21/c21.rpy:1478
translate german c21s002_AaronCall_22910fb8:

    # mc "¿Hoy? ¿Por qué tanta prisa?"
    mc "Heute? Warum die Eile?"

# game/scripts/c21/c21.rpy:1480
translate german c21s002_AaronCall_b6f53ead:

    # aar "Uno de sus directivos está en San Diego reunido con vuestra Armada. No me extrañaría que se pusiera en contacto contigo para tener una reunión."
    aar "Einer ihrer Direktoren befindet sich in San Diego und trifft sich mit Vertretern Ihrer Marine. Es würde mich nicht wundern, wenn er Sie kontaktiert hätte, um ein Treffen zu vereinbaren."

# game/scripts/c21/c21.rpy:1481
translate german c21s002_AaronCall_5c70738c:

    # mc "¿Conmigo? ¿Por qué? ¿Por qué no con [mar] o [nor]?"
    mc "Mit mir? Warum? Warum nicht mit [mar] oder [nor]?"

# game/scripts/c21/c21.rpy:1482
translate german c21s002_AaronCall_f6925132:

    # aar "La información filtrada llevaba tu nombre como futuro CEO de la compañía representando al grupo mayoritario de accionistas."
    aar "Die durchgesickerten Informationen enthielten auch Ihren Namen als zukünftigen CEO des Unternehmens, der die Mehrheitsaktionärsgruppe vertritt."

# game/scripts/c21/c21.rpy:1483
translate german c21s002_AaronCall_f795a7f0:

    # mc "Vale, pues si se ponen en contacto, con decirle que no estamos interesados en vender hay suficiente, ¿no?"
    mc "Okay, wenn sie sich melden, reicht es also, ihnen einfach zu sagen, dass wir kein Interesse am Verkauf haben, richtig?"

# game/scripts/c21/c21.rpy:1485
translate german c21s002_AaronCall_f3896c95:

    # aar "Debería haber suficiente, pero tienes que hablarlo antes con tu familia. No puedes tomar una decisión por ellos."
    aar "Es sollte reichen, aber du musst zuerst mit deiner Familie sprechen. Du kannst diese Entscheidung nicht für sie treffen."

# game/scripts/c21/c21.rpy:1486
translate german c21s002_AaronCall_89f7514c:

    # aar "Incluso sería bueno que te reunieras con él, llevando a [ama] como guardaespaldas. Para saber qué intenciones tienen."
    aar "Es wäre sogar ratsam, wenn Sie sich mit ihm treffen und [ama] als Leibwächter mitbringen würden, um seine Absichten herauszufinden."

# game/scripts/c21/c21.rpy:1487
translate german c21s002_AaronCall_023dbd88:

    # mc "Si no vamos a vender, ¿qué más da las intenciones que tengan?"
    mc "Wenn wir nicht verkaufen, was spielt es dann für eine Rolle, welche Absichten sie haben?"

# game/scripts/c21/c21.rpy:1489
translate german c21s002_AaronCall_4d83f4ea:

    # aar "[mc], la información es poder en este mundo. No creo que seas capaz de sacarle nada, pero [ama] sí que puede conseguir algo de información."
    aar "[mc] Wissen ist Macht in dieser Welt. Ich glaube nicht, dass du ihm etwas entlocken kannst, aber [ama] er kann einige Informationen beschaffen."

# game/scripts/c21/c21.rpy:1490
translate german c21s002_AaronCall_e00384c4:

    # mc "No me hace ninguna gracia ir a una reunión con un tipo que seguramente sea peligroso sin tener ni idea de nada."
    mc "Ich habe überhaupt keine Lust, zu einem Treffen mit einem Typen zu gehen, der wahrscheinlich gefährlich ist, ohne auch nur die geringste Ahnung von irgendetwas zu haben."

# game/scripts/c21/c21.rpy:1492
translate german c21s002_AaronCall_56cd97e0:

    # aar "¿Crees que ese directivo va a ser más peligroso que [ama]? *Risa*"
    aar "Glaubst du, dass diese Führungskraft gefährlicher sein wird als [ama]? *lacht*"

# game/scripts/c21/c21.rpy:1493
translate german c21s002_AaronCall_261ccb82:

    # mc "*Risa* En eso tienes razón. No voy a estar más protegido con nadie mejor que con ella."
    mc "*Lacht* Da hast du recht. Bei niemand anderem wäre ich sicherer als bei ihr."

# game/scripts/c21/c21.rpy:1495
translate german c21s002_AaronCall_1d102f4f:

    # aar "*Risa* Que no te oiga [eva] decir eso."
    aar "*lacht* Sag das bloß nicht!"

# game/scripts/c21/c21.rpy:1496
translate german c21s002_AaronCall_b9e32a8d:

    # aar "Te la has terminado de ganar con el regalo de las muñecas. Un buen detalle. No la pierdas ahora."
    aar "Mit der Puppe hast du sie wirklich für dich gewonnen. Das war eine nette Geste. Verlier sie jetzt nicht!"

# game/scripts/c21/c21.rpy:1497
translate german c21s002_AaronCall_69ecb324:

    # mc "Espera. Habías dicho que no sabías de qué hablaban con lo de las muñecas."
    mc "Moment mal. Du sagtest doch, du wüsstest nicht, worüber sie mit den Puppen sprachen."

# game/scripts/c21/c21.rpy:1499
translate german c21s002_AaronCall_3a98564c:

    # aar "Quería comprobar lo leal que eras hacia ellas. Lo de las muñecas era algo simple sobre lo que quizás quisieras fanfarronear."
    aar "Ich wollte testen, wie loyal du ihnen gegenüber bist. Die Sache mit der Puppe war nur etwas Einfaches, mit dem du vielleicht prahlen wolltest."

# game/scripts/c21/c21.rpy:1500
translate german c21s002_AaronCall_acb236f1:

    # aar "Pero siendo algo que puede que para ti no sea importante has guardado lo que creías que era su secreto. Bien hecho."
    aar "Auch wenn es dir vielleicht nicht wichtig erscheint, hast du das, was du für ihr Geheimnis gehalten hast, bewahrt. Gut gemacht."

# game/scripts/c21/c21.rpy:1501
translate german c21s002_AaronCall_6f76af63:

    # mc "No me gustan estos juegos, [aar]."
    mc "Ich mag diese Spiele nicht, [aar]."

# game/scripts/c21/c21.rpy:1503
translate german c21s002_AaronCall_3da1a804:

    # aar "A mí tampoco, te lo aseguro. Pero no sé cuánto tiempo voy a poder seguir protegiéndolas. Necesito saber que tú y tu familia lo vais a hacer cuando yo no esté."
    aar "Ich auch nicht, das versichere ich Ihnen. Aber ich weiß nicht, wie lange ich sie noch beschützen kann. Ich muss wissen, dass Sie und Ihre Familie das auch weiterhin tun werden, wenn ich nicht mehr da bin."

# game/scripts/c21/c21.rpy:1504
translate german c21s002_AaronCall_d31034f7:

    # mc "Lo haremos, no te preocupes. ¿No hay nada que pueda frenar el envejecimiento acelerado?"
    mc "Wir schaffen das, keine Sorge. Gibt es denn gar nichts, was die beschleunigte Alterung verlangsamen kann?"

# game/scripts/c21/c21.rpy:1506
translate german c21s002_AaronCall_c3c0825a:

    # aar "No, no hay nada. No voy a durar diez años más. Quizás ni siquiera cinco."
    aar "Nein, da ist nichts. Ich werde keine zehn Jahre mehr durchhalten. Vielleicht nicht einmal fünf."

# game/scripts/c21/c21.rpy:1507
translate german c21s002_AaronCall_84ab57b7:

    # mc "Lo siento. No tengo palabras..."
    mc "Es tut mir leid. Ich bin sprachlos..."

# game/scripts/c21/c21.rpy:1508
translate german c21s002_AaronCall_fd33cf36:

    # aar "No te preocupes. Hace años que lo tengo asumido."
    aar "Keine Sorge. Ich habe das schon vor Jahren akzeptiert."

# game/scripts/c21/c21.rpy:1510
translate german c21s002_AaronCall_d08c7506:

    # aar "Volviendo al tema que nos ocupaba. Si se ponen en contacto contigo desde Iron Fist, la otra compañía, intenta tener una reunión en persona e informa a [ama]."
    aar "Zurück zum eigentlichen Thema. Falls Iron Fist, die andere Firma, Sie kontaktiert, versuchen Sie, ein persönliches Treffen zu vereinbaren und [ama] zu informieren."

# game/scripts/c21/c21.rpy:1511
translate german c21s002_AaronCall_10b09256:

    # mc "De acuerdo. ¿Alguna cosa más?"
    mc "Okay. Sonst noch etwas?"

# game/scripts/c21/c21.rpy:1513
translate german c21s002_AaronCall_34537b06:

    # aar "No, eso es todo. ¿Tienes alguna pregunta?"
    aar "Nein, das ist alles. Haben Sie noch Fragen?"

# game/scripts/c21/c21.rpy:1514
translate german c21s002_AaronCall_5a73e046:

    # mc "Sí. Me dijiste que me dirías de qué te conocía. O de qué me sonabas."
    mc "Ja. Du hast mir versprochen, mir zu sagen, woher ich dich kenne. Oder warum du mir so bekannt vorkamst."

# game/scripts/c21/c21.rpy:1516
translate german c21s002_AaronCall_62cf7be6:

    # aar "Supongo que ya lo has pensado, pero... ¿alguna vez te han dicho que pareces mayor de tu edad?"
    aar "Ich nehme an, Sie haben darüber bereits nachgedacht, aber... wurde Ihnen jemals gesagt, dass Sie älter aussehen, als Sie sind?"

# game/scripts/c21/c21.rpy:1517
translate german c21s002_AaronCall_75c3e23a:

    # mc "Sí. No me digas que yo también soy un clon que envejece más rápido."
    mc "Ja. Sag mir nicht, ich bin auch ein Klon, der schneller altert."

# game/scripts/c21/c21.rpy:1519
translate german c21s002_AaronCall_fca3faa7:

    # aar "No, no eres un clon. Arnau, Alfred, y yo somos clones tuyos." id c21s002_AaronCall_fca3faa7
    aar "Nein, du bist kein Klon. Arnau, Alfred und ich sind deine Klone." id c21s002_AaronCall_fca3faa7

# game/scripts/c21/c21.rpy:1521
translate german c21s002_AaronCall_bce8a29d:

    # aar "Tus tíos le sacaron células madre a [mar] durante su embarazo, con la excusa de hacer pruebas sobre enfermedades genéticas."
    aar "Ihre Onkel haben [mar] während ihrer Schwangerschaft Stammzellen entnommen, unter dem Vorwand, Tests auf genetische Krankheiten durchzuführen."

# game/scripts/c21/c21.rpy:1523
translate german c21s002_AaronCall_1e40d8c8:

    # aar "Ana se extrajo células madre durante su embarazo. Fuiste el primer sujeto al que lograron clonar."
    aar "Ana wurden während ihrer Schwangerschaft Stammzellen entnommen. Du warst die erste Person, die geklont werden konnte."

# game/scripts/c21/c21.rpy:1525
translate german c21s002_AaronCall_f3053091:

    # aar "No pareces sorprendido."
    aar "Du scheinst nicht überrascht zu sein."

# game/scripts/c21/c21.rpy:1526
translate german c21s002_AaronCall_c909980b:

    # mc "Veo una versión joven de tu cara cada día en el espejo. Desde que te conocí, era una de las opciones que barajaba."
    mc "Ich sehe jeden Tag eine jüngere Version deines Gesichts im Spiegel. Seit ich dich kenne, war das eine der Möglichkeiten, die ich in Betracht gezogen habe."

# game/scripts/c21/c21.rpy:1527
translate german c21s002_AaronCall_8cb11edb:

    # mc "¿Lo saben [ama] y [eva]?"
    mc "Wissen [ama] und [eva] es?"

# game/scripts/c21/c21.rpy:1529
translate german c21s002_AaronCall_780ec8d6:

    # aar "No, no lo saben. Y preferiría que no lo supieran. Aunque no me extrañaría que lo sospecharan. Seguramente recuerdan qué aspecto teníamos hace 13 o 14 años."
    aar "Nein, sie wissen es nicht. Und das wäre mir auch lieber so. Obwohl es mich nicht wundern würde, wenn sie es ahnen würden. Wahrscheinlich erinnern sie sich noch daran, wie wir vor 13 oder 14 Jahren aussahen."

# game/scripts/c21/c21.rpy:1530
translate german c21s002_AaronCall_efcb1f17:

    # aar "Nos parecíamos más a ti de lo que me parezco yo ahora. Un día atarán cabos, pero espero que tarden en hacerlo."
    aar "Wir waren damals mehr wie du als ich heute. Eines Tages werden sie den Zusammenhang erkennen, aber ich hoffe, es dauert noch eine Weile."

# game/scripts/c21/c21.rpy:1531
translate german c21s002_AaronCall_d0059116:

    # mc "No te preocupes, no se lo diré. Pero ahora que he confirmado mis sospechas... no sé cómo tratarte."
    mc "Keine Sorge, ich werde es ihm nicht erzählen. Aber jetzt, wo sich meine Vermutungen bestätigt haben … ich weiß nicht, wie ich mit dir umgehen soll."

# game/scripts/c21/c21.rpy:1533
translate german c21s002_AaronCall_aff66c1e:

    # aar "*Risa* Es por lo que no quiero que [ama] y [eva] lo sepan. Sería raro para ellas. Puedes tratarme como a un socio."
    aar "*Lacht* Deshalb möchte ich nicht, dass [ama] und [eva] es erfahren. Das wäre seltsam für sie. Du kannst mich wie einen Partner behandeln."

# game/scripts/c21/c21.rpy:1534
translate german c21s002_AaronCall_3f71da55:

    # aar "No nos vamos a convertir en familia por compartir ADN."
    aar "Wir werden nicht automatisch eine Familie, nur weil wir die gleiche DNA haben."

# game/scripts/c21/c21.rpy:1535
translate german c21s002_AaronCall_24f9d7c8:

    # mc "Me parece bien. Raro, pero bien."
    mc "Das klingt gut für mich. Seltsam, aber gut."

# game/scripts/c21/c21.rpy:1537
translate german c21s002_AaronCall_e7a7e5cf:

    # aar "Entonces te dejo. Tienes que hablar con tu familia sobre las acciones. Dile a cualquiera de mis chicas que me informe de vuestra decisión, por favor."
    aar "Dann verabschiede ich mich. Du musst mit deiner Familie über die Aktienoptionen sprechen. Bitte sag einer meiner Töchter, sie soll mir deine Entscheidung mitteilen."

# game/scripts/c21/c21.rpy:1538
translate german c21s002_AaronCall_14010c89:

    # mc "Lo haré. Pero son nuestras chicas."
    mc "Das werde ich. Aber es sind unsere Mädchen."

# game/scripts/c21/c21.rpy:1539
translate german c21s002_AaronCall_0639f7d8:

    # aar "La próxima vez que nos veamos, supongo que será aquí, en Aruba. En dos o tres semanas más o menos deberías venir."
    aar "Wenn wir uns das nächste Mal sehen, dann vermutlich hier in Aruba. Du solltest in etwa zwei oder drei Wochen kommen."

# game/scripts/c21/c21.rpy:1540
translate german c21s002_AaronCall_e226d49b:

    # mc "¿Sólo dos o tres semanas?"
    mc "Nur zwei oder drei Wochen?"

# game/scripts/c21/c21.rpy:1542
translate german c21s002_AaronCall_2b20622b:

    # aar "Más o menos. Hay mucho trabajo que hacer y cuanto antes haya una figura visible, mejor."
    aar "Mehr oder weniger. Es gibt noch viel zu tun, und je eher eine konkrete Zahl sichtbar ist, desto besser."

# game/scripts/c21/c21.rpy:1543
translate german c21s002_AaronCall_ca79b601:

    # mc "No me gusta la idea pero vale. Nos vemos en dos o tres semanas en Aruba."
    mc "Die Idee gefällt mir nicht, aber gut. Wir sehen uns in zwei oder drei Wochen in Aruba."

# game/scripts/c21/c21.rpy:1546
translate german c21s002_AaronCall_5b29d98b:

    # "Tras las despedidas, vuelves a bajar a la cocina. Tienes que hablar con [mar]."
    "Nachdem du dich verabschiedet hast, gehst du wieder in die Küche. Du musst mit [mar] sprechen."

# game/scripts/c21/c21.rpy:1572
translate german c21s002_MarChat_d45b9216:

    # mc "Buenos días, Mamá. ¿Tienes un momento?"
    mc "Guten Morgen, Mama. Hast du einen Moment Zeit?"

# game/scripts/c21/c21.rpy:1574
translate german c21s002_MarChat_152657e0:

    # mc "Buenos días, [mar]. ¿Tienes un momento?"
    mc "Guten Morgen, [mar]. Hätten Sie einen Moment Zeit?"

# game/scripts/c21/c21.rpy:1575
translate german c21s002_MarChat_889efd17:

    # mom "Sí, claro. Pareces preocupado. Siéntate conmigo, me estaba preparando un café."
    mom "Ja, natürlich. Du scheinst besorgt zu sein. Setz dich zu mir, ich habe mir gerade einen Kaffee gemacht."

# game/scripts/c21/c21.rpy:1577
translate german c21s002_MarChat_e64d9ff2:

    # "Tras explicarle lo que has hablado con [aar] sobre la venta..."
    "Nachdem Sie erklärt hatten, was Sie mit [aar] über den Verkauf besprochen hatten..."

# game/scripts/c21/c21.rpy:1578
translate german c21s002_MarChat_84a6ec42:

    # mom "Ni [nor], ni [eri], ni yo vamos a vender. Ya lo hemos hablado. [emm] todavía no ha dicho nada, pero dudo que quiera vender."
    mom "Weder [nor] noch [eri] noch ich werden verkaufen. Wir haben das bereits besprochen. [emm] hat noch nichts gesagt, aber ich bezweifle, dass er verkaufen will."

# game/scripts/c21/c21.rpy:1579
translate german c21s002_MarChat_f33fcc5d:

    # mom "Para ella es más lógico ser una accionista con ingresos continuos que volverse rica de un día para otro."
    mom "Für sie macht es mehr Sinn, Aktionärin mit einem regelmäßigen Einkommen zu sein, als über Nacht reich zu werden."

# game/scripts/c21/c21.rpy:1580
translate german c21s002_MarChat_ed54918d:

    # mc "Deberíamos hablarlo con ella. Como ha dicho [aar], no puedo tomar decisiones sobre sus acciones."
    mc "Wir sollten mit ihr darüber reden. Wie [aar] schon sagte, kann ich keine Entscheidungen über ihr Handeln treffen."

# game/scripts/c21/c21.rpy:1582
translate german c21s002_MarChat_d0611e7a:

    # mom "No te preocupes, hablaré con ella hoy mismo."
    mom "Keine Sorge, ich werde heute mit ihr sprechen."

# game/scripts/c21/c21.rpy:1584
translate german c21s002_MarChat_eaef52fa:

    # mc "Gracias, Mamá."
    mc "Danke, Mama."

# game/scripts/c21/c21.rpy:1586
translate german c21s002_MarChat_73d262ed:

    # mc "Gracias, [mar]."
    mc "Vielen Dank, [mar]."

# game/scripts/c21/c21.rpy:1588
translate german c21s002_MarChat_fc444a05:

    # mom "¿Sabes cuándo se van a poner en contacto con nosotros?"
    mom "Wissen Sie, wann sie sich mit uns in Verbindung setzen werden?"

# game/scripts/c21/c21.rpy:1589
translate german c21s002_MarChat_c380efeb:

    # mc "Ni idea, pero si el tipo está en San Diego y [aar] quiere que tomemos la decisión hoy, supongo que será en breve."
    mc "Ich habe keine Ahnung, aber wenn der Typ in San Diego ist und will, dass wir heute noch eine Entscheidung treffen, dann wird es wohl bald so weit sein."

# game/scripts/c21/c21.rpy:1590
translate german c21s002_MarChat_ef7c7929:

    # mc "Mientras no interfiera con lo de [emm] en Monterey... Ese tipo no sabe lo que es enfrentarse a [emm] enfadada."
    mc "Solange es die Geschehnisse in Monterey nicht beeinträchtigt... Der Typ weiß nicht, wie es ist, einer wütenden Frau gegenüberzustehen."

# game/scripts/c21/c21.rpy:1592
translate german c21s002_MarChat_77c4bbb4:

    # mom "*Risa* En ese caso, se enterarían de que [ama] es un corderito sobre el que no hay nada que temer."
    mom "*Gelächter* Dann würden sie feststellen, dass [ama] ein kleines Lamm ist, vor dem man nichts zu fürchten hat."

# game/scripts/c21/c21.rpy:1593
translate german c21s002_MarChat_f23a0bc9:

    # mc "Bueno, pues te voy a dejar. Tengo que llevar a [meg] a la estación de autobuses."
    mc "Okay, ich verabschiede mich jetzt. Ich muss [meg] zum Busbahnhof bringen."

# game/scripts/c21/c21.rpy:1596
translate german c21s002_MarChat_30ab2cd5:

    # mom "Antes de que te vayas..."
    mom "Bevor Sie gehen..."

# game/scripts/c21/c21.rpy:1597
translate german c21s002_MarChat_c3861053:

    # mc "¿Qué ha pasado ahora? *Risa*"
    mc "Was ist denn jetzt schon wieder passiert? *Gelächter*"

# game/scripts/c21/c21.rpy:1599
translate german c21s002_MarChat_df11d1b2:

    # mom "No, no ha pasado nada... ahora."
    mom "Nein, es ist noch nichts passiert."

# game/scripts/c21/c21.rpy:1600
translate german c21s002_MarChat_bd6d4dd1:

    # mom "Ayer, cuando estuve en tu habitación... con [sam]..."
    mom "Gestern, als ich in deinem Zimmer war... mit [sam]..."

# game/scripts/c21/c21.rpy:1601
translate german c21s002_MarChat_f79a7e43:

    # mc "¿Te molestó vernos allí a los dos?"
    mc "Hat es dich gestört, uns beide dort zu sehen?"

# game/scripts/c21/c21.rpy:1603
translate german c21s002_MarChat_131d701e:

    # mom "¿Qué? ¡No! Me alegra mucho que estés con [sam]. Es una mujer fantástica."
    mom "Was? Nein! Ich bin so froh, dass du mit [sam] zusammen bist. Sie ist eine fantastische Frau."

# game/scripts/c21/c21.rpy:1604
translate german c21s002_MarChat_8606410d:

    # mc "¿Entonces cuál es el problema?"
    mc "Wo liegt also das Problem?"

# game/scripts/c21/c21.rpy:1606
translate german c21s002_MarChat_7fac0b6b:

    # mom "No es que haya ningún problema... durante la fiesta estuvimos hablando..."
    mom "Es gibt kein Problem... wir haben uns während der Party unterhalten..."

# game/scripts/c21/c21.rpy:1607
translate german c21s002_MarChat_78f12039:

    # mom "Sabes que todo esto empezó con una broma sobre compartirte..."
    mom "Weißt du, das alles fing mit einem Witz darüber an, dich zu teilen..."

# game/scripts/c21/c21.rpy:1608
translate german c21s002_MarChat_65f9676b:

    # mc "Sí..."
    mc "Ja..."

# game/scripts/c21/c21.rpy:1611
translate german c21s002_MarChat_99ed1929:

    # mom "Después de lo que pasó con [emm]..."
    mom "Nach dem, was mit [emm] passiert ist..."

# game/scripts/c21/c21.rpy:1612
translate german c21s002_MarChat_c23a761d:

    # mom "Y sabes que [sam] es mi mejor amiga..."
    mom "Und du weißt ja, dass [sam] mein bester Freund ist..."

# game/scripts/c21/c21.rpy:1613
translate german c21s002_MarChat_bc25888e:

    # mc "Me gusta a donde va esto..."
    mc "Mir gefällt, wohin das führt..."

# game/scripts/c21/c21.rpy:1615
translate german c21s002_MarChat_13ca5fec:

    # mom "¿Me vas a hacer decirlo?"
    mom "Willst du mich etwa dazu zwingen, es auszusprechen?"

# game/scripts/c21/c21.rpy:1616
translate german c21s002_MarChat_b52cc728:

    # mc "*Risa* ¿A qué te refieres? Siempre dices que soy un chico muy inocente que no capta las indirectas."
    mc "*Lacht* Was meinst du? Du sagst doch immer, ich sei ein sehr unschuldiger Junge, der die Andeutungen nicht versteht."

# game/scripts/c21/c21.rpy:1618
translate german c21s002_MarChat_db2cd72a:

    # mom "*Risa* Y un poco capullo también."
    mom "*Lacht* Und ein ziemlicher Idiot noch dazu."

# game/scripts/c21/c21.rpy:1619
translate german c21s002_MarChat_26548d8c:

    # mc "*Risa* Sí, sí. Soy un capullo. Pero decías que [sam.nick] es tu mejor amiga..."
    mc "*Lacht* Ja, ja. Ich bin ein Idiot. Aber du hast doch gesagt, dass [sam.nick] dein bester Freund ist..."

# game/scripts/c21/c21.rpy:1621
translate german c21s002_MarChat_3a1c51e7:

    # mom "Vale... estuvimos hablando..."
    mom "Okay... wir haben uns unterhalten..."

# game/scripts/c21/c21.rpy:1622
translate german c21s002_MarChat_4b206a4c:

    # mom "Y nos gustaría compartirte de verdad en el futuro..."
    mom "Und wir würden Ihnen in Zukunft sehr gerne mehr darüber erzählen..."

# game/scripts/c21/c21.rpy:1624
translate german c21s002_MarChat_026f4984:

    # mom "Como hicimos [emm] y yo. Aunque [sam] aún no sabe nada sobre eso."
    mom "So wie [emm] und ich es getan haben. Obwohl [sam] davon noch nichts weiß."

# game/scripts/c21/c21.rpy:1625
translate german c21s002_MarChat_7859df39:

    # mc "Creo que puedo liberar las próximas semanas de mi agenda y haceros un hueco. *Risa* Excepto por lo de [emm] en Monterey, claro."
    mc "Ich denke, ich kann die nächsten Wochen in meinem Terminkalender freimachen und dir Zeit geben. *Lacht* Außer natürlich bei der Sache mit dem [emm] in Monterey."

# game/scripts/c21/c21.rpy:1626
translate german c21s002_MarChat_03b9a4c4:

    # mc "Hablando en serio. Me encantaría, pero solo si las dos lo queréis de verdad."
    mc "Im Ernst. Ich würde es sehr gerne tun, aber nur, wenn ihr es beide wirklich wollt."

# game/scripts/c21/c21.rpy:1628
translate german c21s002_MarChat_0c3a8aeb:

    # mom "No estamos diciendo de hacerlo inmediatamente. Quizás cuando vuelvas de Aruba. Las dos queremos tenerte para nosotras solas unas cuantas veces más antes de hacer algo así."
    mom "Wir meinen nicht, dass ihr es sofort tun sollt. Vielleicht, wenn ihr von Aruba zurück seid. Wir möchten euch beide erst noch ein paar Mal ganz für uns allein haben, bevor wir so etwas unternehmen."

# game/scripts/c21/c21.rpy:1629
translate german c21s002_MarChat_f834aa1a:

    # mom "Pero queríamos saber si te gustaría... hacer un trío con las dos."
    mom "Aber wir wollten wissen, ob Sie Lust hätten, einen Dreier mit beiden zu haben."

# game/scripts/c21/c21.rpy:1630
translate german c21s002_MarChat_f052f0b9:

    # mc "Si alguna vez digo que no me apetece algo así, llévame al médico. *Risa* Algo no funcionará en mi cerebro."
    mc "Wenn ich jemals sage, dass ich keine Lust auf so etwas habe, bringt mich zum Arzt. *lacht* Irgendwas stimmt nicht mit meinem Gehirn."

# game/scripts/c21/c21.rpy:1632
translate german c21s002_MarChat_b218ef31:

    # mom "Gracias, mi amor. Si hubieras dicho que no, me hubiera sentido estúpida."
    mom "Danke, mein Schatz. Hättest du Nein gesagt, hätte ich mich dumm gefühlt."

# game/scripts/c21/c21.rpy:1633
translate german c21s002_MarChat_2b012876:

    # mc "No podría haber rechazado algo así nunca."
    mc "So etwas hätte ich niemals ablehnen können."

# game/scripts/c21/c21.rpy:1634
translate german c21s002_MarChat_066b0a75:

    # mc "Pero ahora en serio, tengo que ir a llevar a [meg]."
    mc "Aber im Ernst, ich muss jetzt los, [meg] nehmen."

# game/scripts/c21/c21.rpy:1636
translate german c21s002_MarChat_f7535321:

    # mom "Una última cosa..."
    mom "Noch eine letzte Sache..."

# game/scripts/c21/c21.rpy:1637
translate german c21s002_MarChat_1afe9f90:

    # mc "Dime."
    mc "Sag mir."

# game/scripts/c21/c21.rpy:1638
translate german c21s002_MarChat_bb2f6982:

    # mom "¿Qué opinas de [kim]?"
    mom "Was halten Sie von [kim]?"

# game/scripts/c21/c21.rpy:1639
translate german c21s002_MarChat_929758f7:

    # mc "Me parece que es una chica fantástica, y parece que se está integrando muy bien."
    mc "Ich finde, sie ist ein fantastisches Mädchen, und sie scheint sich sehr gut einzuleben."

# game/scripts/c21/c21.rpy:1640
translate german c21s002_MarChat_1014758b:

    # mc "Diría que, además, se lleva muy bien contigo."
    mc "Ich würde auch sagen, dass er sich sehr gut mit Ihnen versteht."

# game/scripts/c21/c21.rpy:1642
translate german c21s002_MarChat_4c342753:

    # mom "Sí, creo que en su caso no eres el favorito, sino que me ha tocado a mí. *Risa*"
    mom "Ja, ich glaube, in seinem Fall bist nicht du der Favorit, sondern eher ich wurde auserwählt. *lacht*"

# game/scripts/c21/c21.rpy:1644
translate german c21s002_MarChat_c1b8f8c0:

    # mom "¡Y no es que tenga ninguna queja sobre ello! No me malinterpretes."
    mom "Und ich habe absolut nichts daran auszusetzen! Versteht mich nicht falsch."

# game/scripts/c21/c21.rpy:1645
translate german c21s002_MarChat_c1b00533:

    # mc "Me lo imagino, pero ¿por qué lo preguntabas?"
    mc "Das kann ich mir vorstellen, aber warum hast du gefragt?"

# game/scripts/c21/c21.rpy:1647
translate german c21s002_MarChat_ea65733b:

    # mom "Es una chica muy sensible, y ayer intentó hablarme de ti un par de veces, pero nos interrumpieron y no quiso seguir hablando del tema."
    mom "Sie ist ein sehr sensibles Mädchen, und gestern hat sie ein paar Mal versucht, mit mir über dich zu sprechen, aber wir wurden unterbrochen und sie wollte nicht weiter darüber reden."

# game/scripts/c21/c21.rpy:1648
translate german c21s002_MarChat_6e3b3c2b:

    # mom "¿Sabes de qué va?"
    mom "Weißt du, worum es geht?"

# game/scripts/c21/c21.rpy:1649
translate german c21s002_MarChat_40a0fdc0:

    # mc "Tengo alguna idea sobre ello, pero creo que, si lo quería hablar contigo, debes hablarlo con ella."
    mc "Ich habe eine ungefähre Vorstellung davon, aber ich denke, wenn sie mit dir darüber sprechen möchte, solltest du mit ihr sprechen."

# game/scripts/c21/c21.rpy:1650
translate german c21s002_MarChat_f5447a9c:

    # mc "Podría estar equivocado y que quisiera hablar de cualquier otra cosa."
    mc "Ich könnte mich irren und er möchte vielleicht über etwas anderes sprechen."

# game/scripts/c21/c21.rpy:1652
translate german c21s002_MarChat_2f33f3bd:

    # mom "Creo que tienes razón. No debería habértelo preguntado a ti, sino a ella."
    mom "Ich glaube, du hast recht. Ich hätte nicht dich fragen sollen, sondern sie."

# game/scripts/c21/c21.rpy:1653
translate german c21s002_MarChat_b4d1f2ec:

    # mom "Ahora deberías irte a buscar a [meg] o vais a llegar tarde."
    mom "Jetzt solltest du [meg] suchen, sonst kommst du zu spät."

# game/scripts/c21/c21.rpy:1657
translate german c21s002_MarChat_61ac67b1:

    # mom "Hasta luego, mi amor."
    mom "Wir sehen uns später, mein Schatz."

# game/scripts/c21/c21.rpy:1659
translate german c21s002_MarChat_c966101d:

    # mc "Hasta luego, Mamá."
    mc "Bis später, Mama."

# game/scripts/c21/c21.rpy:1662
translate german c21s002_MarChat_fd0b2265:

    # mc "Hasta luego, mi vida."
    mc "Leb wohl, meine Liebe."

# game/scripts/c21/c21.rpy:1664
translate german c21s002_MarChat_5aec6711:

    # mc "Hasta luego, [mar]."
    mc "Bis später, [mar]."

# game/scripts/c21/c21.rpy:1677
translate german c21s002_Megan_04fc0305:

    # "Después de recoger a [meg] en su habitación y llevarla a la estación de autobuses..."
    "Nachdem ich [meg] aus ihrem Zimmer abgeholt und sie zum Busbahnhof gebracht hatte..."

# game/scripts/c21/c21.rpy:1678
translate german c21s002_Megan_3c65a76f:

    # mc "¿Qué tal lo has pasado el fin de semana?"
    mc "Wie war dein Wochenende?"

# game/scripts/c21/c21.rpy:1679
translate german c21s002_Megan_d15af0eb:

    # meg "Ha sido genial. Me lo he pasado muy bien y ha sido fantástico conocer a todo el mundo."
    meg "Es war toll. Ich hatte eine wirklich schöne Zeit und es war fantastisch, alle kennenzulernen."

# game/scripts/c21/c21.rpy:1680
translate german c21s002_Megan_c24435be:

    # mc "¿Te sientes más a gusto ahora, después de la fiesta de cumpleaños?"
    mc "Fühlst du dich jetzt, nach der Geburtstagsfeier, wohler?"

# game/scripts/c21/c21.rpy:1682
translate german c21s002_Megan_bd07e85a:

    # meg "No me la imaginaba así. Con lo locos que estáis todos, esperaba algo más salvaje. Fue bastante tranquila."
    meg "So hatte ich mir das nicht vorgestellt. Bei eurer Verrücktheit hatte ich etwas Wilderes erwartet. Es war ziemlich ruhig."

# game/scripts/c21/c21.rpy:1683
translate german c21s002_Megan_3567414e:

    # mc "Creo que la parte más salvaje estuvo en el jacuzzi. Las chicas se lo pasaron muy bien."
    mc "Ich glaube, das Aufregendste war im Whirlpool. Die Mädchen hatten einen Riesenspaß."

# game/scripts/c21/c21.rpy:1685
translate german c21s002_Megan_6fcafd80:

    # meg "Bueno, Jamaal también se puso muy salvaje cuando tú te fuiste. *Risa* Y no me refiero solo a su capacidad para comer."
    meg "Jamaal ist auch ziemlich ausgeflippt, als du weg warst. *lacht* Und ich meine damit nicht nur seinen Appetit."

# game/scripts/c21/c21.rpy:1686
translate german c21s002_Megan_03b871f3:

    # meg "Empezó a contar chistes sobre todo el mundo, menos [mad.nick] y las estudiantes. Supongo que aún no tiene suficiente material."
    meg "Er fing an, Witze über alle außer [mad.nick] und den Schülern zu erzählen. Ich schätze, ihm fehlt noch das Material."

# game/scripts/c21/c21.rpy:1687
translate german c21s002_Megan_1fee9104:

    # mc "Es un monologuista frustrado. *Risa* Por eso le dejo hablar solo muchas veces."
    mc "Er ist ein frustrierter Stand-up-Comedian. *Lacht* Deshalb lasse ich ihn oft mit sich selbst reden."

# game/scripts/c21/c21.rpy:1689
translate german c21s002_Megan_388d91bd:

    # meg "*Risa* Sois tal para cual. Me encanta cómo os metéis el uno con el otro. Se nota que os queréis."
    meg "*lacht* Ihr zwei passt perfekt zusammen. Ich liebe es, wie ihr euch gegenseitig neckt. Man merkt, dass ihr euch gern habt."

# game/scripts/c21/c21.rpy:1690
translate german c21s002_Megan_08b7f981:

    # mc "Ya sabes que es el deber de cualquier amo querer a su mascota. *Risa*"
    mc "Du weißt doch, dass es die Pflicht jedes Tierbesitzers ist, sein Haustier zu lieben. *lacht*"

# game/scripts/c21/c21.rpy:1692
translate german c21s002_Megan_a92ae0ce:

    # meg "¿Ves? A eso me refiero. *Risa*"
    meg "Siehst du? Genau das meine ich. *lacht*"

# game/scripts/c21/c21.rpy:1693
translate german c21s002_Megan_cfc7a130:

    # mc "Hablando de cosas más serias. ¿Cuándo vuelves? ¿Vendrás el próximo fin de semana también?"
    mc "Und nun im Ernst: Wann kommst du wieder? Bist du nächstes Wochenende auch hier?"

# game/scripts/c21/c21.rpy:1695
translate german c21s002_Megan_d5787976:

    # meg "Trabajo hasta el miércoles en Westport y empiezo el viernes aquí de nuevo."
    meg "Ich arbeite bis Mittwoch in Westport und fange am Freitag wieder hier an."

# game/scripts/c21/c21.rpy:1696
translate german c21s002_Megan_481ae79b:

    # meg "[mar] me ha dicho que venga el jueves, pero no estoy segura. Normalmente los jueves los aprovecho para hacer la limpieza en casa."
    meg "[mar] Sie hat mir gesagt, ich solle am Donnerstag kommen, aber ich bin mir nicht sicher. Normalerweise putze ich donnerstags das Haus."

# game/scripts/c21/c21.rpy:1697
translate german c21s002_Megan_052760bc:

    # mc "*Risa* Si no estás en casa no verás si está sucia, y se ensuciará menos."
    mc "*Gelächter* Wenn man nicht zu Hause ist, sieht man nicht, ob es schmutzig ist, und es wird weniger schmutzig."

# game/scripts/c21/c21.rpy:1699
translate german c21s002_Megan_5a02c626:

    # meg "*Risa* ¡Hombres!"
    meg "*Gelächter* Männer!"

# game/scripts/c21/c21.rpy:1701
translate german c21s002_Megan_71dc5177:

    # meg "Ya veremos. El jueves o el viernes estaré de nuevo aquí. Además ya tendré el coche arreglado."
    meg "Wir werden sehen. Ich bin am Donnerstag oder Freitag wieder da. Außerdem ist mein Auto bis dahin repariert."

# game/scripts/c21/c21.rpy:1702
translate german c21s002_Megan_e1b0ccdd:

    # mc "Entonces espero verte el jueves."
    mc "Dann hoffe ich, Sie am Donnerstag zu sehen."

# game/scripts/c21/c21.rpy:1705
translate german c21s002_Megan_486a9a17:

    # meg "Tú también puedes venir a mi casa, si quieres. Sólo está a 35 minutos."
    meg "Du kannst auch gerne zu mir kommen. Es ist nur 35 Minuten entfernt."

# game/scripts/c21/c21.rpy:1706
translate german c21s002_Megan_34c0c949:

    # mc "Si puedo lo haré."
    mc "Wenn ich kann, werde ich es tun."

# game/scripts/c21/c21.rpy:1707
translate german c21s002_Megan_a08a7190:

    # mc "Esta semana va a ser complicada."
    mc "Diese Woche wird kompliziert werden."

# game/scripts/c21/c21.rpy:1709
translate german c21s002_Megan_bbdca4c9:

    # meg "Lo sé. Tienes lo de [emm] entre las otras miles de cosas que tienes que hacer."
    meg "Ich weiß. Du hast die Sache mit dem [emm] unter Tausenden anderen Dingen, die du erledigen musst."

# game/scripts/c21/c21.rpy:1711
translate german c21s002_Megan_051cbb70:

    # meg "Por allí llega mi autobús."
    meg "Mein Bus kommt so an."

# game/scripts/c21/c21.rpy:1716
translate german c21s002_Megan_ab1de559:

    # meg "Te veo el jueves o el viernes. Seguramente el jueves por la noche."
    meg "Wir sehen uns am Donnerstag oder Freitag. Wahrscheinlich Donnerstagabend."

# game/scripts/c21/c21.rpy:1717
translate german c21s002_Megan_afd5ac81:

    # mc "Hasta el jueves, [meg]."
    mc "Bis Donnerstag, [meg]."

# game/scripts/c21/c21.rpy:1719
translate german c21s002_Megan_00700b65:

    # "[meg] desaparece en el interior del autobús."
    "[meg] verschwindet im Bus."

# game/scripts/c21/c21.rpy:1721
translate german c21s002_Megan_51ef8b47:

    # "Te acabas de dar cuenta de que no lleva la maleta que trajo. ¿Ha dejado ropa en casa?"
    "Dir ist gerade aufgefallen, dass sie ihren mitgebrachten Koffer nicht dabei hat. Hat sie etwa Kleidung zu Hause vergessen?"

# game/scripts/c21/c21.rpy:1725
translate german c21s003_NoKiaraDate_79f93db8:

    # "Justo al irse el autobús..."
    "Gerade als der Bus abfuhr..."

# game/scripts/c21/c21.rpy:1727
translate german c21s003_NoKiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1731
translate german c21s003_NoKiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Hallo [ama]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c21/c21.rpy:1733
translate german c21s003_NoKiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Ich wollte dich nur daran erinnern, dass wir uns heute auf einen Kaffee treffen wollten, um meine Ideen zu NTR zu besprechen. Wann würde es dir passen?"

# game/scripts/c21/c21.rpy:1734
translate german c21s003_NoKiaraDate_2e084d07:

    # mc "Estoy en la estación de autobuses ahora mismo. Como algo rápido y podemos quedar. ¿En 30 minutos te va bien?"
    mc "Ich bin gerade am Busbahnhof. Hol dir schnell was zu essen, dann können wir uns treffen. Passen dir 30 Minuten?"

# game/scripts/c21/c21.rpy:1736
translate german c21s003_NoKiaraDate_ed11e94d:

    # ama "Perfecto. Te mando la dirección de un café que tienes cerca y podemos quedar allí."
    ama "Perfekt. Ich schicke dir die Adresse eines Cafés in deiner Nähe, und wir können uns dort treffen."

# game/scripts/c21/c21.rpy:1737
translate german c21s003_NoKiaraDate_2a5423d0:

    # mc "Genial. Te veo en 30 minutos. Hasta ahora."
    mc "Super. Wir sehen uns in 30 Minuten. Bis dann."

# game/scripts/c21/c21.rpy:1738
translate german c21s003_NoKiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Bis jetzt, [mc]."

# game/scripts/c21/c21.rpy:1766
translate german c21s003_KiaraDate_7386f7a4:

    # "Llegas a la biblioteca unos minutos antes de la hora a la que has quedado con [kia]."
    "Sie kommen einige Minuten vor dem vereinbarten Treffpunkt in der Bibliothek an [kia]."

# game/scripts/c21/c21.rpy:1767
translate german c21s003_KiaraDate_9ae42375:

    # "Pasaste mucho tiempo en tu época del instituto en este edificio."
    "Du hast während deiner Schulzeit viel Zeit in diesem Gebäude verbracht."

# game/scripts/c21/c21.rpy:1768
translate german c21s003_KiaraDate_b594cfce:

    # "Por un momento dudas si debes entrar o no a buscarla. Decides hacerlo."
    "Einen Moment lang zögerst du, ob du hineingehen und nach ihr suchen sollst. Du beschließt, es zu tun."

# game/scripts/c21/c21.rpy:1770
translate german c21s003_KiaraDate_11283da7:

    # mcp "(Allí está. Se ha cambiado el peinado y se ha puesto un vestido precioso. Creo que el premio a la elegancia de hoy ya tiene dueño.)"
    mcp "(Da ist sie ja. Sie hat ihre Frisur geändert und ein wunderschönes Kleid angezogen. Ich glaube, der Eleganzpreis für heute ist schon vergeben.)"

# game/scripts/c21/c21.rpy:1771
translate german c21s003_KiaraDate_6c3c6634:

    # mcp "(Y no soy yo.)"
    mcp "(Und ich bin es nicht.)"

# game/scripts/c21/c21.rpy:1773
translate german c21s003_KiaraDate_898d49a2:

    # "Te acercas tímidamente al mostrador donde está hablando con la Srta. Walker, la bibliotecaria canadiense de tu época de instituto. De Montreal, crees recordar."
    "Du näherst dich schüchtern dem Tresen, wo er sich mit Frau Walker unterhält, der kanadischen Bibliothekarin aus deiner Schulzeit. Aus Montreal, so glaubst du dich zu erinnern."

# game/scripts/c21/c21.rpy:1774
translate german c21s003_KiaraDate_634d1076:

    # "No sabes cuánto sabe sobre vuestra relación, si es que sabe algo. O de la situación con Solomon."
    "Du weißt nicht, wie viel er über eure Beziehung weiß, wenn überhaupt etwas. Oder über die Situation mit Solomon."

# game/scripts/c21/c21.rpy:1775
translate german c21s003_KiaraDate_68ffd690:

    # mc "Hola, [kia]. Hola..."
    mc "Hallo, [kia]. Hallo..."

# game/scripts/c21/c21.rpy:1776
translate german c21s003_KiaraDate_e8747f1d:

    # kia "Hola, [mc]. Te presento a Geneviève, mi jefa. Gen, este es [mc], el sobrino de [nor], de quien te he hablado."
    kia "Hallo, [mc]. Hier spricht Geneviève, meine Chefin. Gen, das ist [mc], der Neffe von [nor], von dem ich dir erzählt habe."

# game/scripts/c21/c21.rpy:1778
translate german c21s003_KiaraDate_934429e1:

    # gen "Encantada de conocerte, [mc]."
    gen "Schön, dich kennenzulernen, [mc]."

# game/scripts/c21/c21.rpy:1779
translate german c21s003_KiaraDate_2c25e289:

    # mc "Igualmente, Geneviève."
    mc "Ebenso Geneviève."

# game/scripts/c21/c21.rpy:1780
translate german c21s003_KiaraDate_29d3b3f0:

    # gen "Puedes llamarme Gen."
    gen "Sie können mich General nennen."

# game/scripts/c21/c21.rpy:1782
translate german c21s003_KiaraDate_a6907f6d:

    # mc "¿Estás lista para irnos?"
    mc "Bist du bereit loszulegen?"

# game/scripts/c21/c21.rpy:1783
translate german c21s003_KiaraDate_53dcdf3b:

    # kia "Sí, dame un momento que vaya a por el bolso."
    kia "Ja, geben Sie mir einen Moment, ich hole schnell meine Tasche."

# game/scripts/c21/c21.rpy:1784
translate german c21s003_KiaraDate_8b397a73:

    # mc "Perfecto, te espero aquí."
    mc "Perfekt, ich warte hier auf dich."

# game/scripts/c21/c21.rpy:1785
translate german c21s003_KiaraDate_b4418a13:

    # kia "Será solo un segundo."
    kia "Es dauert nur eine Sekunde."

# game/scripts/c21/c21.rpy:1787
translate german c21s003_KiaraDate_7cae2efd:

    # gen "Así que [kia] y [eil] se están alojando en tu casa mientras acaban con el problema de termitas, ¿no?"
    gen "[kia] und [eil] wohnen also bei Ihnen, während sie sich um das Termitenproblem kümmern, richtig?"

# game/scripts/c21/c21.rpy:1788
translate german c21s003_KiaraDate_3a42f87c:

    # gen "Les estáis haciendo un favor muy grande."
    gen "Du tust ihnen damit einen riesigen Gefallen."

# game/scripts/c21/c21.rpy:1789
translate german c21s003_KiaraDate_7a642010:

    # mcp "(¿Termitas? Está claro que no le ha contado lo de Solomon.)"
    mcp "(Termiten? Offenbar hat er ihr nichts von Salomo erzählt.)"

# game/scripts/c21/c21.rpy:1790
translate german c21s003_KiaraDate_cfd7f90b:

    # mc "Bueno, no se aloja en mi casa, sino en la de mi tía, [nor]."
    mc "Nun ja, er wohnt nicht bei mir, sondern bei meiner Tante, [nor]."

# game/scripts/c21/c21.rpy:1792
translate german c21s003_KiaraDate_12ae6060:

    # gen "Tú y yo nos conocemos, ¿verdad?"
    gen "Du und ich kennen uns, nicht wahr?"

# game/scripts/c21/c21.rpy:1793
translate german c21s003_KiaraDate_e8944aa2:

    # mc "Pasaba mucho tiempo aquí cuando iba al instituto."
    mc "Früher habe ich hier viel Zeit verbracht, als ich noch zur High School ging."

# game/scripts/c21/c21.rpy:1795
translate german c21s003_KiaraDate_74fc50ac:

    # gen "*Risa* ¡No llevo tanto tiempo trabajando aquí! Sólo llevo ocho años."
    gen "*Lacht* Ich arbeite noch gar nicht so lange hier! Ich bin erst seit acht Jahren hier."

# game/scripts/c21/c21.rpy:1796
translate german c21s003_KiaraDate_1752be01:

    # mc "Y hace cuatro yo estudiaba en el instituto de Newport, Srta. Walker. Es posible que no me reconozca."
    mc "Und vor vier Jahren war ich Schülerin an der Newport High School, Miss Walker. Sie würden mich vielleicht nicht wiedererkennen."

# game/scripts/c21/c21.rpy:1797
translate german c21s003_KiaraDate_7b7a8bca:

    # mc "Pasado de peso, con la nariz metida en un libro, con un amigo en silla de ruedas..."
    mc "Übergewichtig, vertieft in ein Buch, mit einem Freund im Rollstuhl..."

# game/scripts/c21/c21.rpy:1799
translate german c21s003_KiaraDate_aa0f87b2:

    # gen "¿Marks? ¿[mc] Marks? ¡No puede ser!"
    gen "Noten? [mc] Noten? Auf keinen Fall!"

# game/scripts/c21/c21.rpy:1800
translate german c21s003_KiaraDate_72f95f2a:

    # mc "Puede ser. Supongo que no me dejé ningún libro por devolver cuando me fui a la universidad. *Risa*"
    mc "Vielleicht. Ich glaube, ich habe kein einziges Buch nicht zurückgegeben, als ich an die Uni ging. *lacht*"

# game/scripts/c21/c21.rpy:1802
translate german c21s003_KiaraDate_35b065bd:

    # gen "Estoy sorprendida... Un gran cambio..."
    gen "Ich bin überrascht... Eine große Veränderung..."

# game/scripts/c21/c21.rpy:1803
translate german c21s003_KiaraDate_817b71b9:

    # gen "Y ya no soy la Srta. Walker. Ahora soy la Sra. Sky."
    gen "Und ich bin nicht länger Miss Walker. Jetzt bin ich Mrs. Sky."

# game/scripts/c21/c21.rpy:1804
translate german c21s003_KiaraDate_3e97c86b:

    # mc "Felicidades, Sra. Sky."
    mc "Herzlichen Glückwunsch, Frau Sky."

# game/scripts/c21/c21.rpy:1806
translate german c21s003_KiaraDate_76b619e2:

    # gen "Puedes seguir llamándome Gen. Ya no eres un adolescente."
    gen "Du kannst mich weiterhin Gen nennen. Du bist ja kein Teenager mehr."

# game/scripts/c21/c21.rpy:1807
translate german c21s003_KiaraDate_4003899d:

    # mc "Felicidades, Gen, entonces."
    mc "Herzlichen Glückwunsch, Gen."

# game/scripts/c21/c21.rpy:1809
translate german c21s003_KiaraDate_efa2a30a:

    # kia "Ya nos podemos ir, [mc]. No lo entretengas, Gen, o tendré que tomarme más tiempo para comer."
    kia "Wir können jetzt gehen, [mc]. Halt ihn nicht auf, Gen, sonst brauche ich länger zum Essen."

# game/scripts/c21/c21.rpy:1810
translate german c21s003_KiaraDate_f9fc42cb:

    # mc "Nos estábamos poniendo al día. Gen y yo nos conocíamos de mi época de rata de biblioteca."
    mc "Wir haben uns ausgetauscht. Gen und ich kannten uns noch aus meiner Zeit als Bücherwurm."

# game/scripts/c21/c21.rpy:1812
translate german c21s003_KiaraDate_e60a6b7c:

    # mc "Hasta otra, Gen."
    mc "Bis zum nächsten Mal, Gen."

# game/scripts/c21/c21.rpy:1813
translate german c21s003_KiaraDate_3357fab1:

    # gen "Hasta otra, [mc]."
    gen "Bis zum nächsten Mal, [mc]."

# game/scripts/c21/c21.rpy:1815
translate german c21s003_KiaraDate_9af56f4c:

    # kia "Vuelvo en una hora... más o menos."
    kia "Ich bin in einer Stunde wieder da... ungefähr."

# game/scripts/c21/c21.rpy:1817
translate german c21s003_KiaraDate_ff564463:

    # kia "¿Dónde has decidido que vayamos a comer?"
    kia "Wo sollen wir deiner Meinung nach essen gehen?"

# game/scripts/c21/c21.rpy:1818
translate german c21s003_KiaraDate_b2e3f62c:

    # mc "Un restaurante que me ha recomendado Tía [bet]. Es sorprendente que en una semana conozca tantos restaurantes."
    mc "Ein Restaurant, das mir Tante [bet] empfohlen hat. Unglaublich, dass ich in nur einer Woche so viele Restaurants besucht habe."

# game/scripts/c21/c21.rpy:1819
translate german c21s003_KiaraDate_a85a021e:

    # mc "Pero... ¿no hay beso para mí?"
    mc "Aber... gibt es denn keinen Kuss für mich?"

# game/scripts/c21/c21.rpy:1821
translate german c21s003_KiaraDate_2b7a744e:

    # kia "¿Delante de la biblioteca? Es mi puesto de trabajo... Y Gen conoce a Solomon... y..."
    kia "Vor der Bibliothek? Das ist mein Arbeitsplatz... Und Gen kennt Solomon... und..."

# game/scripts/c21/c21.rpy:1822
translate german c21s003_KiaraDate_24a6a742:

    # mc "No te preocupes. Será duro, pero lo entiendo y puedo esperar a cuando llegues a casa."
    mc "Keine Sorge. Es wird schwer, aber ich verstehe das und ich kann warten, bis du wieder zu Hause bist."

# game/scripts/c21/c21.rpy:1823
translate german c21s003_KiaraDate_ab0752d3:

    # mc "No me gustan los secretos, pero entiendo que no quieras hacer público lo nuestro aún, hasta que se resuelva lo de Solomon."
    mc "Ich mag keine Geheimnisse, aber ich verstehe, dass du unsere Beziehung noch nicht öffentlich machen willst, bis die Angelegenheit mit Solomon geklärt ist."

# game/scripts/c21/c21.rpy:1825
translate german c21s003_KiaraDate_f0fc850c:

    # kia "No es que no quiera hacerlo público. Me da lo mismo que la gente sepa que Solomon y yo hemos roto. No voy a volver con él nunca."
    kia "Es ist nicht so, dass ich es nicht öffentlich machen will. Es ist mir egal, ob die Leute wissen, dass Solomon und ich uns getrennt haben. Ich werde nie wieder mit ihm zusammenkommen."

# game/scripts/c21/c21.rpy:1826
translate german c21s003_KiaraDate_cce4706b:

    # kia "Pero hace una semana estaba con él y ahora estoy contigo... todo el mundo va a pensar que soy... una zorra que se ha ido con un hombre más joven."
    kia "Aber vor einer Woche war ich noch mit ihm zusammen und jetzt bin ich mit dir... alle werden denken, ich sei... eine Schlampe, die mit einem jüngeren Mann durchgebrannt ist."

# game/scripts/c21/c21.rpy:1828
translate german c21s003_KiaraDate_0efd211a:

    # mc "[kia], escúchame. En casa podremos repetir lo de anoche si quieres. Te dije que no teníamos que hacer nada que no quisieras hacer"
    mc "[kia], hör mir zu. Wir können das, was wir gestern Abend gemacht haben, zu Hause wiederholen, wenn du willst. Ich habe dir doch gesagt, dass wir nichts tun müssen, was du nicht willst."

# game/scripts/c21/c21.rpy:1829
translate german c21s003_KiaraDate_d1a401c8:

    # mc "Y si una de las cosas que no quieres hacer es que te bese delante de la biblioteca, no hay ningún problema."
    mc "Und wenn eines der Dinge, die du auf keinen Fall möchtest, ist, dass er dich vor der Bibliothek küsst, ist das völlig in Ordnung."

# game/scripts/c21/c21.rpy:1831
translate german c21s003_KiaraDate_63650acf:

    # mc "No quiero estropear nuestra primera... o segunda cita... por una nimiedad como esta."
    mc "Ich möchte unser erstes... oder zweites Date... nicht wegen so einer Kleinigkeit ruinieren."

# game/scripts/c21/c21.rpy:1832
translate german c21s003_KiaraDate_e36381cf:

    # mc "Estás preciosa, me encanta lo que te has hecho en el pelo y ese color de pintalabios te favorece mucho."
    mc "Du siehst umwerfend aus, ich liebe deine neue Frisur und die Lippenstiftfarbe steht dir wirklich gut."

# game/scripts/c21/c21.rpy:1833
translate german c21s003_KiaraDate_eabac296:

    # mc "Voy a tener muchas ocasiones de comerme ese pintalabios, pero sólo si no lo estropeamos hoy."
    mc "Ich werde noch viele Gelegenheiten haben, diesen Lippenstift zu essen, aber nur, wenn wir ihn heute nicht ruinieren."

# game/scripts/c21/c21.rpy:1835
translate german c21s003_KiaraDate_60bfadf0:

    # mc "¿Te parece bien si vamos a comer? Mi idea de una cita no es discutir con una preciosa mujer en la calle ni hacerla sentir mal."
    mc "Hättest du Lust, mit mir essen zu gehen? Meine Vorstellung von einem Date ist nicht, mit einer schönen Frau auf der Straße zu streiten oder ihr ein schlechtes Gefühl zu geben."

# game/scripts/c21/c21.rpy:1836
translate german c21s003_KiaraDate_7e6a20e0:

    # kia "Vamos... pero no creas que te va a ser fácil estropear hoy. Y menos si, como {b}casi{/b} siempre, aciertas en lo que tienes que decir."
    kia "Na los … aber glaub ja nicht, dass du heute so leicht etwas falsch machen kannst. Vor allem, wenn du, wie {b}fast{/b} immer, mit dem, was du zu sagen hast, ins Schwarze triffst."

# game/scripts/c21/c21.rpy:1837
translate german c21s003_KiaraDate_f4d8ef39:

    # mc "*Risa* Es un defecto con el que tendrás que lidiar. No acierto siempre, pero sí las suficientes veces."
    mc "*lacht* Das ist ein Fehler, mit dem du leben musst. Ich mache es auch nicht immer richtig, aber oft genug."

# game/scripts/c21/c21.rpy:1839
translate german c21s003_KiaraDate_44d2b74e:

    # mc "Vamos antes de que se haga más tarde."
    mc "Lasst uns gehen, bevor es zu spät wird."

# game/scripts/c21/c21.rpy:1842
translate german c21s003_KiaraDate_040b5c5b:

    # mc "No sé por qué no me imaginé que sería una pizzería, habiéndolo recomendado Tía [bet]."
    mc "Ich weiß nicht, warum ich nicht an eine Pizzeria gedacht habe, nachdem sie mir von Tante [bet] empfohlen wurde."

# game/scripts/c21/c21.rpy:1843
translate german c21s003_KiaraDate_86dbd28c:

    # kia "*Risa* ¿De verdad es tan adicta a la pizza?"
    kia "*lacht* Ist sie wirklich so süchtig nach Pizza?"

# game/scripts/c21/c21.rpy:1844
translate german c21s003_KiaraDate_fb71eec9:

    # mc "*Risa* Supongo que la gula es el único pecado que se permite. ¿Y qué mejor que cometerlo con pizza?"
    mc "*lacht* Ich schätze, Völlerei ist die einzige erlaubte Sünde. Und wie könnte man besser schlemmen als mit Pizza?"

# game/scripts/c21/c21.rpy:1846
translate german c21s003_KiaraDate_b424f89a:

    # "Después de que el camarero os siente en una mesa no tan apartada como te hubiera gustado..."
    "Nachdem der Kellner Sie an einen Tisch geführt hat, der nicht so abgelegen ist, wie Sie es sich gewünscht hätten..."

# game/scripts/c21/c21.rpy:1847
translate german c21s003_KiaraDate_2095de9e:

    # mc "¿Qué te apetece comer?"
    mc "Worauf hast du Appetit?"

# game/scripts/c21/c21.rpy:1848
translate german c21s003_KiaraDate_2061c43f:

    # kia "Si por mí fuera, haría como [bet] y pediría una pizza, pero entre el tiempo que van a tardar y lo lenta que soy comiendo, la cita no daría para nada más."
    kia "Wenn es nach mir ginge, würde ich es wie [bet] machen und eine Pizza bestellen, aber angesichts der Zeit, die es in Anspruch nehmen würde, und meiner langsamen Essgewohnheiten würde das Date nichts anderes zulassen."

# game/scripts/c21/c21.rpy:1849
translate german c21s003_KiaraDate_c5db446e:

    # kia "Con lo que creo que pediré esta ensalada. Tiene buena pinta."
    kia "Ich glaube, ich bestelle diesen Salat. Er sieht gut aus."

# game/scripts/c21/c21.rpy:1850
translate german c21s003_KiaraDate_977aa4a9:

    # mc "¿Tienes algún plan para después de comer?"
    mc "Hast du schon Pläne für nach dem Mittagessen?"

# game/scripts/c21/c21.rpy:1854
translate german c21s003_KiaraDate_c279c58a:

    # kia "Había pensado en dar un paseo antes de volver a la biblioteca... si te apetece."
    kia "Ich hatte überlegt, vor dem Rückweg zur Bibliothek noch einen Spaziergang zu machen... wenn du möchtest."

# game/scripts/c21/c21.rpy:1855
translate german c21s003_KiaraDate_9d638618:

    # mc "Me encantan los paseos contigo. *Risa* Pero no podremos hacer tantas pausas como anoche."
    mc "Ich liebe Spaziergänge mit dir. *lacht* Aber wir werden nicht so viele Pausen machen können wie gestern Abend."

# game/scripts/c21/c21.rpy:1857
translate german c21s003_KiaraDate_4cb0af9f:

    # kia "*Risa* No me refería a ese tipo de paseo."
    kia "*lacht* Ich meinte nicht diese Art zu gehen."

# game/scripts/c21/c21.rpy:1858
translate german c21s003_KiaraDate_4db7ab3b:

    # mc "Lo sé. *Risa* Que sean dos ensaladas, pero no le digas a [mar] que he pedido una ensalada en un restaurante."
    mc "Ich weiß. *lacht* Es sollen zwei Salate sein, aber sag [mar] bloß nicht, dass ich im Restaurant einen Salat bestellt habe."

# game/scripts/c21/c21.rpy:1860
translate german c21s003_KiaraDate_974b0be7:

    # kia "*Risa* ¿Por qué?"
    kia "*Lachen* Warum?"

# game/scripts/c21/c21.rpy:1861
translate german c21s003_KiaraDate_46df123c:

    # mc "No te creería. *Risa* ¿Pagar por algo verde? Orégano o albahaca, sí. Lechuga, quizás, dentro de una hamburguesa. Broccoli, nunca."
    mc "Das würde ich dir nicht glauben. *lacht* Für etwas Grünes bezahlen? Oregano oder Basilikum, ja. Salat vielleicht, im Burger. Brokkoli, niemals."

# game/scripts/c21/c21.rpy:1863
translate german c21s003_KiaraDate_75b5078a:

    # kia "*Risa* Si fueras hijo mío comerías de todo."
    kia "*Lacht* Wenn du mein Sohn wärst, würdest du alles essen."

# game/scripts/c21/c21.rpy:1864
translate german c21s003_KiaraDate_9bf7c2c9:

    # mc "*Risa* Prefiero ser tu novio y olvidarme del broccoli."
    mc "*Lacht* Ich wäre lieber dein Freund und würde den Brokkoli vergessen."

# game/scripts/c21/c21.rpy:1866
translate german c21s003_KiaraDate_890574b6:

    # kia "Yo también... A lo del novio. No tengo ningún problema con el broccoli."
    kia "Ich auch... Was meinen Freund angeht: Ich habe kein Problem mit Brokkoli."

# game/scripts/c21/c21.rpy:1868
translate german c21s003_KiaraDate_bae6e3a4:

    # mc "Te cedo mi parte de la producción mundial de broccoli. *Risa* Para que veas que tienes un novio generoso."
    mc "Ich gebe dir meinen Anteil an der weltweiten Brokkoliproduktion. *Lacht* Damit du siehst, dass du einen großzügigen Freund hast."

# game/scripts/c21/c21.rpy:1870
translate german c21s003_KiaraDate_6c944c47:

    # kia "*Risa* Es super generoso de tu parte."
    kia "*lacht* Das ist wirklich sehr großzügig von dir."

# game/scripts/c21/c21.rpy:1871
translate german c21s003_KiaraDate_13c4ada8:

    # mc "¿Sabes que me encanta verte reír?"
    mc "Weißt du, dass ich es liebe, dich lachen zu sehen?"

# game/scripts/c21/c21.rpy:1873
translate german c21s003_KiaraDate_1fa740fc:

    # kia "Gracias, pero ¿sabes que [eil] me habló de tu costumbre de intentar ruborizarla?"
    kia "Danke, aber weißt du, dass [eil] mir von deiner Angewohnheit erzählt hat, sie zum Erröten zu bringen?"

# game/scripts/c21/c21.rpy:1874
translate german c21s003_KiaraDate_ed8042b5:

    # mc "*Risa* ¡Maldita chivata!"
    mc "*Lacht* Verdammter Petzer!"

# game/scripts/c21/c21.rpy:1876
translate german c21s003_KiaraDate_31f7727d:

    # kia "¡Devuelve esa mano ahí ahora mismo!"
    kia "Gib die Hand sofort zurück!"

# game/scripts/c21/c21.rpy:1877
translate german c21s003_KiaraDate_66e26340:

    # mc "*Risa* ¡A tus órdenes!"
    mc "*Gelächter* Zu Ihren Diensten!"

# game/scripts/c21/c21.rpy:1880
translate german c21s003_KiaraDate_82e507c2:

    # kia "*Risa* Ahora que las dos salimos contigo, me ha dado algunos consejos. Y me ha explicado algunos de tus trucos para hacerla sentir bien."
    kia "*Lacht* Jetzt, wo wir beide mit dir zusammen sind, hat sie mir ein paar Ratschläge gegeben. Und sie hat mir einige deiner Tricks verraten, wie ich ihr ein gutes Gefühl geben kann."

# game/scripts/c21/c21.rpy:1882
translate german c21s003_KiaraDate_04b2472b:

    # kia "*Risa* Me ha explicado muchas cosas de cuando salíais juntos. Supongo que quería ponerme en sobre aviso sobre tus viejos trucos para hacerla sentir bien."
    kia "*Lacht* Sie hat mir so einiges aus eurer gemeinsamen Zeit erzählt. Ich glaube, sie wollte mich vor deinen alten Tricks warnen, mit denen du ihr ein gutes Gefühl gegeben hast."

# game/scripts/c21/c21.rpy:1883
translate german c21s003_KiaraDate_44dc4434:

    # mc "*Risa* Tendré que encontrar trucos nuevos, entonces. La compañía los merece."
    mc "*Lacht* Dann muss ich mir wohl ein paar neue Tricks einfallen lassen. Die Firma hat sie verdient."

# game/scripts/c21/c21.rpy:1885
translate german c21s003_KiaraDate_1432e0f3:

    # kia "¿Puedo serte sincera?"
    kia "Darf ich ehrlich zu Ihnen sein?"

# game/scripts/c21/c21.rpy:1886
translate german c21s003_KiaraDate_28927394:

    # mc "Siempre."
    mc "Stets."

# game/scripts/c21/c21.rpy:1888
translate german c21s003_KiaraDate_0578fcb0:

    # kia "Si lo que dices es sincero, no me importa que se lo hayas dicho con anterioridad a mi hija. O a otras mujeres."
    kia "Wenn das, was du sagst, ehrlich gemeint ist, stört es mich nicht, dass du das schon einmal zu meiner Tochter gesagt hast. Oder zu anderen Frauen."

# game/scripts/c21/c21.rpy:1889
translate german c21s003_KiaraDate_4ab6eb4e:

    # kia "No quiero que digas cosas que no sientes sólo para hacerme sentir bien, pero tampoco necesito que inventes frases bonitas cada día."
    kia "Ich möchte nicht, dass du Dinge sagst, die du nicht so meinst, nur um mir ein gutes Gefühl zu geben, aber ich brauche auch nicht, dass du dir jeden Tag schöne Phrasen ausdenkst."

# game/scripts/c21/c21.rpy:1890
translate german c21s003_KiaraDate_abe63749:

    # kia "Si sientes realmente lo que dices, me va a gustar igualmente."
    kia "Wenn du es wirklich so meinst, gefällt es mir trotzdem."

# game/scripts/c21/c21.rpy:1891
translate german c21s003_KiaraDate_95e51857:

    # mc "Entendido. Entonces... ¿Sabes que me encanta verte reír? *Risa*"
    mc "Verstanden. Also … du weißt ja, dass ich es liebe, dich lachen zu sehen? *lacht*"

# game/scripts/c21/c21.rpy:1893
translate german c21s003_KiaraDate_1e2e1528:

    # kia "*Risa* ¡Idiota!"
    kia "*Gelächter* Idiot!"

# game/scripts/c21/c21.rpy:1894
translate german c21s003_KiaraDate_a77e5548:

    # mc "*Risa* ¡Hey! Has dicho que podía repetir cosas si era sincero. Y lo he sido. Me encanta verte reír."
    mc "*Lacht* Hey! Du hast gesagt, ich darf Dinge wiederholen, wenn ich es ehrlich meine. Und das habe ich getan. Ich freue mich immer, dich lachen zu sehen."

# game/scripts/c21/c21.rpy:1896
translate german c21s003_KiaraDate_12adb927:

    # kia "Y a mí me encanta que me hagas reír..."
    kia "Und ich liebe es, wenn du mich zum Lachen bringst..."

# game/scripts/c21/c21.rpy:1898
translate german c21s003_KiaraDate_b85e53b2:

    # kia "Es tan diferente a cuando iba a comer con Solomon..."
    kia "Das ist so anders als früher, als ich mit Solomon essen ging..."

# game/scripts/c21/c21.rpy:1899
translate german c21s003_KiaraDate_04f1bee2:

    # mc "¿Solomon? ¿Quién es Solomon? El nombre me suena. Algo de partir un bebé por la mitad, ¿no?"
    mc "Salomo? Wer ist Salomo? Der Name kommt mir bekannt vor. Irgendwas mit einem Baby, das man in zwei Hälften teilt, oder?"

# game/scripts/c21/c21.rpy:1900
translate german c21s003_KiaraDate_0e916f4b:

    # mc "Pero no eres tan mayor como para haber ido a comer con él... *Risa*"
    mc "Aber du bist noch nicht alt genug, um mit ihm zu Mittag gegessen zu haben... *lacht*"

# game/scripts/c21/c21.rpy:1902
translate german c21s003_KiaraDate_0c1f5e70:

    # kia "*Risa* Realmente eres idiota. Me acabas de llamar vieja en nuestra segunda cita."
    kia "*lacht* Du bist echt ein Idiot. Du hast mich schon beim zweiten Date alt genannt."

# game/scripts/c21/c21.rpy:1903
translate german c21s003_KiaraDate_0f5ad404:

    # mc "¡Oops! El chiste se me ha ido de las manos."
    mc "Ups! Dieser Witz ist außer Kontrolle geraten."

# game/scripts/c21/c21.rpy:1905
translate german c21s003_KiaraDate_c96dfcd9:

    # kia "Sé que no está bien que hable de él en una cita contigo y prometo que será la última vez que lo haga."
    kia "Ich weiß, es ist nicht richtig, bei einem Date mit dir über ihn zu reden, und ich verspreche dir, dass es das letzte Mal sein wird."

# game/scripts/c21/c21.rpy:1906
translate german c21s003_KiaraDate_04e443a7:

    # kia "Con él siempre tenía que estar alerta para no decir algo que le molestara."
    kia "Bei ihm musste ich immer auf der Hut sein, um nichts zu sagen, was ihn verärgern könnte."

# game/scripts/c21/c21.rpy:1907
translate german c21s003_KiaraDate_98d3c2c0:

    # kia "Para que no bebiera demasiado."
    kia "Damit er nicht zu viel trinkt."

# game/scripts/c21/c21.rpy:1908
translate german c21s003_KiaraDate_f8e57f27:

    # kia "Para que no montara un espectáculo si algún hombre me miraba..."
    kia "Damit ich keine Szene mache, falls mich ein Mann ansieht..."

# game/scripts/c21/c21.rpy:1909
translate german c21s003_KiaraDate_ed80e219:

    # mc "Lo entiendo, no tenía que ser cómodo."
    mc "Ich verstehe, es musste nicht bequem sein."

# game/scripts/c21/c21.rpy:1911
translate german c21s003_KiaraDate_3bb71433:

    # kia "No, no lo era. Y a eso me refiero con que esto es diferente."
    kia "Nein, das war es nicht. Und genau das meine ich, wenn ich sage, dass es hier anders ist."

# game/scripts/c21/c21.rpy:1912
translate german c21s003_KiaraDate_655cfbf9:

    # kia "Contigo, lo único que tengo que temer es no poder resistir las ganas de besarte en medio del restaurante."
    kia "Bei dir ist das Einzige, was ich zu befürchten habe, der Drang zu sein, dich mitten im Restaurant zu küssen."

# game/scripts/c21/c21.rpy:1913
translate german c21s003_KiaraDate_4613651e:

    # kia "Me haces sentir... relajada."
    kia "Du gibst mir ein Gefühl von... Entspannung."

# game/scripts/c21/c21.rpy:1914
translate german c21s003_KiaraDate_15014567:

    # mc "Solomon es una de las personas a las que no me gustaría parecerme. Si alguna vez empiezo a comportarme como él, avísame para dejar de hacerlo."
    mc "Solomon ist einer der Menschen, denen ich nicht nacheifern möchte. Falls ich jemals anfange, mich so zu verhalten wie er, sag mir Bescheid, damit ich damit aufhören kann."

# game/scripts/c21/c21.rpy:1916
translate german c21s003_KiaraDate_dcfcb449:

    # kia "Los dos respiráis. *Risa* Creo que ahí acaban las similitudes."
    kia "Ihr atmet beide. *lacht* Ich glaube, da enden die Gemeinsamkeiten."

# game/scripts/c21/c21.rpy:1917
translate german c21s003_KiaraDate_726e8e80:

    # mc "*Risa* Y, en mi caso, no lo considero un desperdicio de oxígeno."
    mc "*Lacht* Und in meinem Fall betrachte ich es nicht als Verschwendung von Sauerstoff."

# game/scripts/c21/c21.rpy:1918
translate german c21s003_KiaraDate_5b0f932d:

    # kia "*Risa* No, no lo es."
    kia "*Lacht* Nein, ist es nicht."

# game/scripts/c21/c21.rpy:1920
translate german c21s003_KiaraDate_d84d6fa3:

    # mc "¿Puedes pedir la ensalada de pasta y un agua con gas para mí? Tengo que ir al lavabo."
    mc "Könnten Sie mir bitte den Nudelsalat und ein Mineralwasser bestellen? Ich muss kurz auf die Toilette."

# game/scripts/c21/c21.rpy:1921
translate german c21s003_KiaraDate_fae66d88:

    # kia "¿Ensalada de pasta? Habías dicho algo verde..."
    kia "Nudelsalat? Du hast doch etwas Grünes gesagt..."

# game/scripts/c21/c21.rpy:1922
translate german c21s003_KiaraDate_9ae059ac:

    # mc "La pasta en la ensalada es verde, roja, y blanca. *Risa* No esperabas que pidiera lechuga o endivias, ¿verdad?"
    mc "Die Nudeln im Salat sind grün, rot und weiß. *Lacht* Du hast doch nicht etwa erwartet, dass ich Kopfsalat oder Endivien bestelle, oder?"

# game/scripts/c21/c21.rpy:1923
translate german c21s003_KiaraDate_d93fd5d3:

    # mc "Paso a paso..."
    mc "Schritt für Schritt..."

# game/scripts/c21/c21.rpy:1925
translate german c21s003_KiaraDate_4bb7ff47:

    # kia "*Risa* Vale, aceptaré pasta verde como ensalada. Creo que lleva una ínfima porción de espinacas."
    kia "*lacht* Okay, grüne Nudeln akzeptiere ich als Salat. Ich glaube, da ist ein bisschen Spinat drin."

# game/scripts/c21/c21.rpy:1926
translate german c21s003_KiaraDate_802c91c8:

    # mc "Suficiente para mí."
    mc "Das genügt mir."

# game/scripts/c21/c21.rpy:1928
translate german c21s003_KiaraDate_c65d2a7d:

    # "Sorprendes a [kia] con un beso antes de ir al lavabo. La sorpresa inicial pasa en seguida."
    "Du überraschst [kia] mit einem Kuss, bevor du ins Badezimmer gehst. Die anfängliche Überraschung verfliegt schnell."

# game/scripts/c21/c21.rpy:1930
translate german c21s003_KiaraDate_f74dc452:

    # kia "Pero..."
    kia "Aber..."

# game/scripts/c21/c21.rpy:1931
translate german c21s003_KiaraDate_423d8675:

    # mc "Luego, cielo. *Risa* Tengo que ir al lavabo."
    mc "Dann, Schatz. *lacht* Ich muss mal aufs Klo."

# game/scripts/c21/c21.rpy:1932
translate german c21s003_KiaraDate_debea350:

    # mc "Y esto no es la puerta de la biblioteca."
    mc "Und das ist nicht die Bibliothekstür."

# game/scripts/c21/c21.rpy:1934
translate german c21s003_KiaraDate_8365c687:

    # mc "Ya estoy de vuelta. ¿Han tomado nota?"
    mc "Ich bin zurück. Haben Sie es bemerkt?"

# game/scripts/c21/c21.rpy:1935
translate german c21s003_KiaraDate_45d0364b:

    # kia "Sí. No tenían la ensalada de pasta y te he pedido un combo de lechugas y espinacas."
    kia "Ja. Sie hatten keinen Nudelsalat, deshalb habe ich Sie nach einer Mischung aus Kopfsalat und Spinat gefragt."

# game/scripts/c21/c21.rpy:1936
translate german c21s003_KiaraDate_27c68bcf:

    # mc "*Risa* Un restaurante italiano sin pasta. ¿Se está acabando el mundo?"
    mc "*Gelächter* Ein italienisches Restaurant ohne Pasta. Geht die Welt unter?"

# game/scripts/c21/c21.rpy:1938
translate german c21s003_KiaraDate_9acb8625:

    # kia "*Risa* Estoy bromeando. He pedido tu ensalada rebosante de calorías."
    kia "*Lacht* Ich mache nur Spaß. Ich habe Ihren kalorienreichen Salat bestellt."

# game/scripts/c21/c21.rpy:1939
translate german c21s003_KiaraDate_7cb16a11:

    # kia "Pero te hubieras merecido la lechuga por ese beso a traición. *Risa*"
    kia "Aber für diesen heimlichen Kuss hast du dir den Salat verdient. *lacht*"

# game/scripts/c21/c21.rpy:1940
translate german c21s003_KiaraDate_e24315f5:

    # mc "Era para que pudieras soportar mejor las ganas de besarme en medio del restaurante. Ahora te puedes relajar aún más."
    mc "Das war so gedacht, damit du der Versuchung besser widerstehen konntest, mich mitten im Restaurant zu küssen. Jetzt kannst du dich noch mehr entspannen."

# game/scripts/c21/c21.rpy:1942
translate german c21s003_KiaraDate_a982092f:

    # kia "A ti nadie te ha dicho nunca que besas muy bien, ¿verdad?"
    kia "Dir hat noch nie jemand gesagt, dass du toll küssen kannst, oder?"

# game/scripts/c21/c21.rpy:1943
translate german c21s003_KiaraDate_640090e0:

    # mc "Si te soy sincero, me lo han dicho alguna vez. No preguntes quién."
    mc "Ehrlich gesagt, das habe ich schon öfter gehört. Frag nicht, von wem."

# game/scripts/c21/c21.rpy:1945
translate german c21s003_KiaraDate_3718abcf:

    # kia "*Risa* Era una pregunta retórica, idiota. Sé que [eil] te lo ha dicho muchas veces. Alguna vez incluso la oí decírtelo."
    kia "*Lacht* Das war eine rhetorische Frage, du Idiot. Ich weiß, dass [eil] dir das schon oft gesagt hat. Ich habe sie es sogar einmal zu dir sagen hören."

# game/scripts/c21/c21.rpy:1947
translate german c21s003_KiaraDate_7bf62b15:

    # kia "¿Tú crees que un beso como ese va a quitarme las ganas de darte más?"
    kia "Glaubst du, ein Kuss wie dieser wird mir den Wunsch nehmen, dir mehr zu geben?"

# game/scripts/c21/c21.rpy:1948
translate german c21s003_KiaraDate_99ca66d3:

    # mc "Espero que no. Me gusta el sabor de ese pintalabios."
    mc "Hoffentlich nicht. Mir gefällt der Geschmack dieses Lippenstifts."

# game/scripts/c21/c21.rpy:1950
translate german c21s003_KiaraDate_5b59703b:

    # kia "¡Dios mío! ¿Qué he hecho yo para merecer un idiota como este?"
    kia "Oh mein Gott! Was habe ich getan, um so einen Idioten zu verdienen?"

# game/scripts/c21/c21.rpy:1951
translate german c21s003_KiaraDate_c1c083cd:

    # mc "Soy el premio por ser una mujer maravillosa. *Risa* Y no se aceptan devoluciones."
    mc "Ich bin der Preis dafür, eine wundervolle Frau zu sein. *Lacht* Und keine Rückerstattung."

# game/scripts/c21/c21.rpy:1953
translate german c21s003_KiaraDate_4feb9baa:

    # kia "*Risa* No pensaba devolverte a fábrica. No eres {b}tan{/b} defectuoso."
    kia "*Lacht* Ich hatte nicht vor, dich zurück ins Werk zu schicken. So defekt bist du ja gar nicht."

# game/scripts/c21/c21.rpy:1954
translate german c21s003_KiaraDate_ca2064ab:

    # mc "*Risa* No sé si ofenderme o tomármelo como un cumplido..."
    mc "*lacht* Ich weiß nicht, ob ich mich beleidigt fühlen oder es als Kompliment auffassen soll..."

# game/scripts/c21/c21.rpy:1956
translate german c21s003_KiaraDate_37786e99:

    # "Cuando traen vuestras dos ensaladas (y sí, una ensalada de pasta {b}es{/b} una ensalada) empieza una comida llena de risas."
    "Wenn sie eure beiden Salate bringen (und ja, ein Nudelsalat {b}ist{/b} ein Salat), beginnt ein Essen voller Gelächter."

# game/scripts/c21/c21.rpy:1957
translate german c21s003_KiaraDate_5eb6f5b9:

    # "[kia] está relajada y os lo pasáis bien. Habláis de todo y de nada."
    "[kia] ist entspannt und ihr habt eine gute Zeit. Ihr redet über alles und nichts."

# game/scripts/c21/c21.rpy:1958
translate german c21s003_KiaraDate_6638e4f2:

    # "Habláis de su trabajo, del dormitorio, y de NTR."
    "Du sprichst über seinen Job, das Schlafzimmer und NTR."

# game/scripts/c21/c21.rpy:1959
translate german c21s003_KiaraDate_38379001:

    # "Charláis sobre [eil] y del resto de las mujeres de la familia."
    "Ihr unterhaltet euch über [eil] und die übrigen Frauen der Familie."

# game/scripts/c21/c21.rpy:1960
translate german c21s003_KiaraDate_3bff8f4a:

    # "Habláis de vosotros."
    "Ihr redet über euch selbst."

# game/scripts/c21/c21.rpy:1961
translate german c21s003_KiaraDate_f44433f0:

    # "Pero, sobre todo, os reís mucho. Os reís de todo. De ti y de ella. Del mundo."
    "Aber vor allem lachst du viel. Du lachst über alles. Über dich und sie. Über die Welt."

# game/scripts/c21/c21.rpy:1963
translate german c21s003_KiaraDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c21/c21.rpy:1964
translate german c21s003_KiaraDate_7a14f67a:

    # mc "Tengo que cogerlo, [kia]. Es [ama]. Dame un segundo."
    mc "Ich muss es holen, [kia]. Es ist [ama]. Einen Moment bitte."

# game/scripts/c21/c21.rpy:1965
translate german c21s003_KiaraDate_5b2bdc80:

    # kia "Todo el tiempo que necesites."
    kia "Alle Zeit, die Sie brauchen."

# game/scripts/c21/c21.rpy:1966
translate german c21s003_KiaraDate_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Hallo [ama]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c21/c21.rpy:1968
translate german c21s003_KiaraDate_ff033294:

    # ama "Solo quería recordarte que hoy habíamos quedado para tomar un café y hablar de mis ideas sobre NTR. ¿A qué hora te iría bien?"
    ama "Ich wollte dich nur daran erinnern, dass wir uns heute auf einen Kaffee treffen wollten, um meine Ideen zu NTR zu besprechen. Wann würde es dir passen?"

# game/scripts/c21/c21.rpy:1969
translate german c21s003_KiaraDate_dabe8d4e:

    # mc "Estoy comiendo con [kia]. ¿En una hora y media te va bien?"
    mc "Ich esse mit [kia] zu Mittag. Wären anderthalb Stunden für Sie in Ordnung?"

# game/scripts/c21/c21.rpy:1970
translate german c21s003_KiaraDate_7df02780:

    # kia "Puedes quedar antes. En 30 minutos tengo que estar de vuelta en la biblioteca."
    kia "Wir können uns auch früher treffen. Ich muss in 30 Minuten wieder in der Bibliothek sein."

# game/scripts/c21/c21.rpy:1972
translate german c21s003_KiaraDate_aa011d24:

    # ama "La he escuchado. Te mando la dirección de un café que tienes cerca y podemos quedar allí. ¿En una hora?"
    ama "Ich habe sie gehört. Ich schicke dir die Adresse eines Cafés in deiner Nähe, und wir können uns dort treffen. In einer Stunde?"

# game/scripts/c21/c21.rpy:1973
translate german c21s003_KiaraDate_4890fe3f:

    # mc "Genial. Te veo en una hora. Hasta dentro de un rato."
    mc "Super. Wir sehen uns in einer Stunde. Bis später."

# game/scripts/c21/c21.rpy:1974
translate german c21s003_KiaraDate_347719c3:

    # ama "Hasta ahora, [mc]."
    ama "Bis jetzt, [mc]."

# game/scripts/c21/c21.rpy:1976
translate german c21s003_KiaraDate_f8b86bf9:

    # mc "¿Por dónde íbamos?"
    mc "Wo waren wir stehen geblieben?"

# game/scripts/c21/c21.rpy:1977
translate german c21s003_KiaraDate_e9290c40:

    # kia "Íbamos por el momento en que pido la cuenta y nos vamos a dar ese paseo antes de que se haga más tarde."
    kia "Wir waren an dem Punkt angelangt, an dem ich nach der Rechnung fragte, und wir machten noch diesen Spaziergang, bevor es zu spät wurde."

# game/scripts/c21/c21.rpy:1978
translate german c21s003_KiaraDate_dfdeb562:

    # mc "De acuerdo, pero la cuenta la pido yo. Fui yo quien te invitó a comer. Pago yo."
    mc "Okay, aber ich bitte um die Rechnung. Ich habe dich zum Mittagessen eingeladen. Ich bezahle."

# game/scripts/c21/c21.rpy:1980
translate german c21s003_KiaraDate_f74dc452_1:

    # kia "Pero..."
    kia "Aber..."

# game/scripts/c21/c21.rpy:1981
translate german c21s003_KiaraDate_41aa0cb0:

    # mc "Si quieres pagar tú, vas a tener que invitarme tú a comer. Un trato es un trato."
    mc "Wenn du zahlen willst, musst du mich zum Mittagessen einladen. Abgemacht ist abgemacht."

# game/scripts/c21/c21.rpy:1982
translate german c21s003_KiaraDate_23f26bfb:

    # mc "Y así es como se consigue una tercera cita. *Risa*"
    mc "Und so bekommt man ein drittes Date. *lacht*"

# game/scripts/c21/c21.rpy:1984
translate german c21s003_KiaraDate_9a370fb8:

    # kia "Vale, pero la próxima vez será para cenar. Tener que volver al trabajo con prisa no es lo mejor... para una tercera cita."
    kia "Okay, aber nächstes Mal gehen wir zum Abendessen. Nach einem dritten Date wieder schnell zur Arbeit zu müssen, ist nicht ideal."

# game/scripts/c21/c21.rpy:1985
translate german c21s003_KiaraDate_ce722ab8:

    # mc "Aún tenemos tiempo para ese paseo. Has dicho que tienes que volver en 30 minutos. Que ya deben ser 28."
    mc "Wir haben noch Zeit für den Spaziergang. Du sagtest, du müsstest in 30 Minuten zurück sein. Es müssen jetzt 28 Minuten sein."

# game/scripts/c21/c21.rpy:1986
translate german c21s003_KiaraDate_15e51949:

    # mc "Déjame ir al mostrador a pagar, así ganaremos un par de minutos."
    mc "Ich gehe zur Kasse, um zu bezahlen, so sparen wir ein paar Minuten."

# game/scripts/c21/c21.rpy:1988
translate german c21s003_KiaraDate_6bc7f6ee:

    # "Menos de diez minutos después, en un parque cercano..."
    "Weniger als zehn Minuten später, in einem nahegelegenen Park..."

# game/scripts/c21/c21.rpy:1989
translate german c21s003_KiaraDate_15fe2d35:

    # kia "Y aquí es dónde vengo a comerme los perritos calientes cuando tengo que comer sola. Un libro y mi perrito."
    kia "Und hierher komme ich, um Hotdogs zu essen, wenn ich alleine essen muss. Mit einem Buch und meinem kleinen Hund."

# game/scripts/c21/c21.rpy:1990
translate german c21s003_KiaraDate_893e09f7:

    # mc "Lo sé. Vinimos con [sca], en vuestro primer día en casa."
    mc "Ich weiß. Wir kamen mit [sca], an deinem ersten Tag zu Hause."

# game/scripts/c21/c21.rpy:1992
translate german c21s003_KiaraDate_6ca23feb:

    # kia "¡Es verdad! ¡Parece que hace un mes!"
    kia "Das stimmt! Es kommt mir vor, als wäre es erst einen Monat her!"

# game/scripts/c21/c21.rpy:1993
translate german c21s003_KiaraDate_a5e89514:

    # mc "Mañana hace una semana, [kia]."
    mc "Morgen ist es eine Woche her, [kia]."

# game/scripts/c21/c21.rpy:1995
translate german c21s003_KiaraDate_f4962993:

    # kia "Lo sé. Parece increíble que en una semana mi vida haya dado este vuelco."
    kia "Ich weiß. Es erscheint unglaublich, dass sich mein Leben innerhalb einer Woche so verändert hat."

# game/scripts/c21/c21.rpy:1996
translate german c21s003_KiaraDate_073db8a4:

    # mc "Pero ¿estás contenta de que lo haya dado?"
    mc "Aber freust du dich darüber, dass er es aufgegeben hat?"

# game/scripts/c21/c21.rpy:1998
translate german c21s003_KiaraDate_a9728b22:

    # kia "No te puedes imaginar cuánto. Y no me refiero sólo a estar contigo. Es todo. Me siento libre por primera vez en años."
    kia "Du kannst dir nicht vorstellen, wie viel es mir bedeutet. Und ich meine damit nicht nur, mit dir zusammen zu sein. Es ist einfach alles. Ich fühle mich zum ersten Mal seit Jahren wieder frei."

# game/scripts/c21/c21.rpy:1999
translate german c21s003_KiaraDate_30454c6e:

    # kia "¿Te acuerdas hace unos días, cuando te dije que teníais un castillo precioso como hogar y todas esas tonterías?"
    kia "Erinnerst du dich noch, als ich dir vor ein paar Tagen erzählt habe, dass du ein wunderschönes Schloss als Zuhause hättest und all diesen Unsinn?"

# game/scripts/c21/c21.rpy:2000
translate german c21s003_KiaraDate_924e117b:

    # mc "Fue ayer, [kia]. Estábamos en la piscina, durante la fiesta de cumpleaños."
    mc "Es war gestern, [kia]. Wir waren am Pool, während der Geburtstagsfeier."

# game/scripts/c21/c21.rpy:2002
translate german c21s003_KiaraDate_fb9a12a4:

    # kia "¿Ayer? ¿No te lo dije durante la comida con [ama]? Se me mezclan los días... todo ha sido tan intenso..."
    kia "Gestern? Habe ich dir das nicht beim Mittagessen mit [ama] erzählt? Ich bin ganz durcheinander... es war alles so intensiv..."

# game/scripts/c21/c21.rpy:2003
translate german c21s003_KiaraDate_4c34fbdb:

    # mc "*Risa* Durante la comida con [ama] es cuando saliste corriendo. Eso fue anteayer."
    mc "*Lacht* Du bist beim Mittagessen mit [ama] abgehauen. Das war vorgestern."

# game/scripts/c21/c21.rpy:2004
translate german c21s003_KiaraDate_5de9aba8:

    # kia "Me estoy volviendo loca. Todo parece que haya pasado hace muchísimo..."
    kia "Ich werde noch verrückt. Es kommt mir alles vor, als wäre es ewig her..."

# game/scripts/c21/c21.rpy:2006
translate german c21s003_KiaraDate_c4f7488d:

    # kia "Sentirme aceptada por la familia, besarte ayer... por la tarde... hablar con todas las chicas después de eso... y lo que pasó por la noche..."
    kia "Das Gefühl, von der Familie akzeptiert zu werden, dich gestern Nachmittag geküsst zu haben... danach mit allen Mädchen gesprochen zu haben... und was letzte Nacht passiert ist..."

# game/scripts/c21/c21.rpy:2007
translate german c21s003_KiaraDate_392d8bed:

    # kia "Yo llevaba una vida aburrida donde todos los días eran iguales..."
    kia "Ich führte ein langweiliges Leben, in dem jeder Tag gleich war..."

# game/scripts/c21/c21.rpy:2008
translate german c21s003_KiaraDate_bf02bf81:

    # mc "En casa nunca hay tiempo para aburrirse. Te adaptaste a la familia. También te adaptarás a esto."
    mc "Zu Hause kommt nie Langeweile auf. Du hast dich an die Familie angepasst. Du wirst dich auch daran gewöhnen."

# game/scripts/c21/c21.rpy:2010
translate german c21s003_KiaraDate_50f0c08d:

    # kia "Lo sé, pero ahora mismo, la última semana es un torbellino de recuerdos."
    kia "Ich weiß, aber im Moment ist die letzte Woche ein Wirbelwind von Erinnerungen."

# game/scripts/c21/c21.rpy:2011
translate german c21s003_KiaraDate_b1e79ea5:

    # kia "Llegar a casa, la fiesta en la playa, cuando fuimos a mi antigua casa, intentar evitarte, la fiesta de cumpleaños... el beso... y lo de anoche."
    kia "Die Heimkehr, die Strandparty, der Besuch in meinem alten Haus, der Versuch, dir aus dem Weg zu gehen, die Geburtstagsfeier... der Kuss... und die letzte Nacht."

# game/scripts/c21/c21.rpy:2013
translate german c21s003_KiaraDate_5c0849e7:

    # kia "Que voy a ser abuela..."
    kia "Ich werde Großmutter..."

# game/scripts/c21/c21.rpy:2014
translate german c21s003_KiaraDate_3f92739f:

    # kia "Casi no puedo poner los recuerdos en el orden correcto."
    kia "Ich schaffe es kaum, die Erinnerungen in die richtige Reihenfolge zu bringen."

# game/scripts/c21/c21.rpy:2016
translate german c21s003_KiaraDate_3a5e5d9b:

    # kia "Y ni siquiera hace una semana..."
    kia "Und es ist noch nicht einmal eine Woche vergangen..."

# game/scripts/c21/c21.rpy:2017
translate german c21s003_KiaraDate_d584132f:

    # mc "Te han pasado muchas cosas importantes en esta semana. Es normal. A veces a mí también me cuesta."
    mc "Dir sind diese Woche viele wichtige Dinge passiert. Das ist normal. Manchmal habe ich damit auch zu kämpfen."

# game/scripts/c21/c21.rpy:2018
translate german c21s003_KiaraDate_afe9bcb6:

    # mc "Pero tengo una pregunta... Después del beso de ayer por la tarde, las chicas te secuestraron durante un buen rato. ¿Qué te dijeron?"
    mc "Aber ich habe eine Frage... Nach dem Kuss gestern Nachmittag haben dich die Mädchen eine ganze Weile festgehalten. Was haben sie dir erzählt?"

# game/scripts/c21/c21.rpy:2020
translate german c21s003_KiaraDate_eb884940:

    # kia "*Risa* ¡Es una cosa entre chicas! Te puedo decir que todas me felicitaron por haber dejado atrás el pasado."
    kia "*Lacht* Typisch Frau! Ich kann euch sagen, dass sie mir alle dazu gratuliert haben, die Vergangenheit hinter mir gelassen zu haben."

# game/scripts/c21/c21.rpy:2021
translate german c21s003_KiaraDate_86d4bac7:

    # kia "Algunas, aunque no te voy a decir quienes, me dieron consejos sobre ti."
    kia "Einige Leute, obwohl ich Ihnen nicht sagen werde, wer, haben mir Ratschläge über Sie gegeben."

# game/scripts/c21/c21.rpy:2022
translate german c21s003_KiaraDate_944522a8:

    # mc "*Risa* ¡Eso es injusto! ¿Habláis de mi a mis espaldas?"
    mc "*lacht* Das ist unfair! Redest du etwa hinter meinem Rücken über mich?"

# game/scripts/c21/c21.rpy:2024
translate german c21s003_KiaraDate_aafa9a2f:

    # kia "*Risa* Obviamente. Y duermo con [eil], que es quien más tiempo ha salido contigo."
    kia "*Lacht* Na klar. Und ich schlafe mit [eil], derjenigen, die am längsten mit dir zusammen ist."

# game/scripts/c21/c21.rpy:2025
translate german c21s003_KiaraDate_2505296a:

    # kia "Ya te dije que se pasó buena parte de la noche hablándome de ti e intentando convencerme para..."
    kia "Ich habe dir ja schon erzählt, dass er einen Großteil der Nacht damit verbracht hat, mit mir über dich zu reden und zu versuchen, mich zu überzeugen..."

# game/scripts/c21/c21.rpy:2026
translate german c21s003_KiaraDate_03f9afb6:

    # mc "Tengo que hablar con ella. No es lo que quería decir cuando le pedía ayuda."
    mc "Ich muss mit ihr reden. Das meinte ich nicht, als ich sie um Hilfe bat."

# game/scripts/c21/c21.rpy:2028
translate german c21s003_KiaraDate_14d72b5c:

    # kia "Sin su insistencia, no hubiéramos hablado anoche en el pasillo ni en la piscina, ni hubiéramos paseado después. Ni estaríamos aquí hoy."
    kia "Ohne sein Drängen hätten wir uns gestern Abend weder im Flur noch am Pool unterhalten, noch wären wir anschließend spazieren gegangen. Und wir wären heute auch nicht hier."

# game/scripts/c21/c21.rpy:2029
translate german c21s003_KiaraDate_333bdd8e:

    # kia "Ni podría hacer esto."
    kia "Ich könnte das auch nicht."

# game/scripts/c21/c21.rpy:2031
translate german c21s003_KiaraDate_791a31f8:

    # "[kia] te sorprende con un beso en los labios. Tierno y pasional a partes iguales."
    "[kia] überrascht dich mit einem Kuss auf die Lippen. Zärtlich und leidenschaftlich zugleich."

# game/scripts/c21/c21.rpy:2032
translate german c21s003_KiaraDate_21d044b8:

    # "No es muy largo, pero puedes leer muchas cosas en él. Alivio, felicidad, esperanza..."
    "Es ist nicht sehr lang, aber man kann viel darin lesen. Erleichterung, Glück, Hoffnung..."

# game/scripts/c21/c21.rpy:2034
translate german c21s003_KiaraDate_c8dc03e3:

    # kia "Ya no aguantaba más."
    kia "Ich konnte es nicht mehr ertragen."

# game/scripts/c21/c21.rpy:2035
translate german c21s003_KiaraDate_e60234c7:

    # mc "¡Wow!"
    mc "Wow!"

# game/scripts/c21/c21.rpy:2037
translate german c21s003_KiaraDate_a888af23:

    # kia "¿Quieres quitar esa sonrisa de tu cara? ¡La gente va a empezar a mirarnos!"
    kia "Wollt ihr euch das Lächeln etwa wieder verkneifen? Die Leute werden uns anstarren!"

# game/scripts/c21/c21.rpy:2038
translate german c21s003_KiaraDate_e60234c7_1:

    # mc "¡Wow!"
    mc "Wow!"

# game/scripts/c21/c21.rpy:2040
translate german c21s003_KiaraDate_8a485d4c:

    # kia "¡[mc], por favor! ¡Deja de hacer el tonto!"
    kia "[mc], bitte! Hör auf, dich albern zu benehmen!"

# game/scripts/c21/c21.rpy:2041
translate german c21s003_KiaraDate_42931d20:

    # mc "¡Wow! *Risa* Me acabo de enamorar del sabor de aguacate mezclado con tu pintalabios."
    mc "Wow! *lacht* Ich bin total begeistert vom Geschmack der Avocado in Kombination mit deinem Lippenstift."

# game/scripts/c21/c21.rpy:2043
translate german c21s003_KiaraDate_d98ac0e5:

    # kia "*Risa* ¿Todavía tengo sabor a aguacate?"
    kia "*lacht* Schmecke ich immer noch nach Avocado?"

# game/scripts/c21/c21.rpy:2044
translate german c21s003_KiaraDate_b1b8b40a:

    # mc "Muy ligero, pero todavía se nota. *Risa* Creo que puedo añadir otra cosa verde al menú. Pero lo tendré que comer de tus labios."
    mc "Sehr subtil, aber dennoch erkennbar. *Lacht* Ich glaube, ich kann noch etwas Grünes auf die Speisekarte setzen. Aber das muss ich dir dann von den Lippen essen."

# game/scripts/c21/c21.rpy:2046
translate german c21s003_KiaraDate_6c92bb1c:

    # "La bibliotecaria pelirroja atrae tu cabeza hasta su altura y vuelve a besarte de una forma que las bibliotecarias deberían tener prohibida."
    "Die rothaarige Bibliothekarin zieht deinen Kopf auf ihre Höhe und küsst dich erneut auf eine Weise, die Bibliothekarinnen eigentlich verboten sein sollte."

# game/scripts/c21/c21.rpy:2047
translate german c21s003_KiaraDate_24e1f98a:

    # "Esta vez es todo pasión, sin rastro de ternura. Pasea su lengua por tus encías, la entrelaza con la tuya, recorre toda tu boca... Te deja sin aliento."
    "Diesmal ist es pure Leidenschaft, ohne jede Spur von Zärtlichkeit. Er streicht mit der Zunge über dein Zahnfleisch, verschränkt sie mit deiner, erkundet deinen ganzen Mund … Er raubt dir den Atem."

# game/scripts/c21/c21.rpy:2048
translate german c21s003_KiaraDate_37461727:

    # "Bendito aguacate."
    "Gesegnete Avocado."

# game/scripts/c21/c21.rpy:2050
translate german c21s003_KiaraDate_e60234c7_2:

    # mc "¡Wow!"
    mc "Wow!"

# game/scripts/c21/c21.rpy:2051
translate german c21s003_KiaraDate_d5771a00:

    # kia "*Respiración entrecortada* ¡Wow! *Risa* Tenía que colaborar con que lleves una dieta saludable."
    kia "*Keucht nach Luft* Wow! *Lacht* Ich musste dir ja helfen, dich gesund zu ernähren."

# game/scripts/c21/c21.rpy:2052
translate german c21s003_KiaraDate_0655365d:

    # kia "Me podría pasar horas aquí haciendo esto y diciendo Wow. Pero, desafortunadamente, tengo que volver al trabajo."
    kia "Ich könnte hier Stunden verbringen und immer wieder „Wow“ sagen. Aber leider muss ich wieder an die Arbeit."

# game/scripts/c21/c21.rpy:2053
translate german c21s003_KiaraDate_298eab58:

    # mc "Entonces vamos. No quiero que llegues tarde."
    mc "Dann los. Ich möchte nicht, dass du zu spät kommst."

# game/scripts/c21/c21.rpy:2055
translate german c21s003_KiaraDate_a05e80ee:

    # kia "Y tú has quedado con [ama]..."
    kia "Und Sie haben sich mit [ama] verabredet..."

# game/scripts/c21/c21.rpy:2056
translate german c21s003_KiaraDate_8fdac1cc:

    # mc "Sí, me quiere comentar sus ideas sobre la empresa."
    mc "Ja, er möchte seine Ideen zum Unternehmen mit mir teilen."

# game/scripts/c21/c21.rpy:2058
translate german c21s003_KiaraDate_ef05061a:

    # kia "*Risa* No estaba interrogándote. Sé que no estás con ella. Al menos aún..."
    kia "*lacht* Ich habe dich nicht infrage gestellt. Ich weiß, dass du nicht mit ihr zusammen bist. Zumindest noch nicht..."

# game/scripts/c21/c21.rpy:2059
translate german c21s003_KiaraDate_d66fabe3:

    # mc "*Risa* Lo sé. Después de lo de ayer, no tengo secretos y no quiero tenerlos."
    mc "*Lacht* Ich weiß. Nach dem, was gestern passiert ist, habe ich keine Geheimnisse mehr und will auch keine mehr haben."

# game/scripts/c21/c21.rpy:2061
translate german c21s003_KiaraDate_c6ec59ab:

    # mc "¿Vamos?"
    mc "Aufleuchten?"

# game/scripts/c21/c21.rpy:2064
translate german c21s003_KiaraDate_b60c23b3:

    # "Unos minutos después, en la biblioteca, justo a la hora en que [kia] tenía que volver..."
    "Wenige Minuten später, in der Bibliothek, genau zu dem Zeitpunkt, als [kia] zurück sein sollte..."

# game/scripts/c21/c21.rpy:2065
translate german c21s003_KiaraDate_8b2f8fdb:

    # kia "Ya estoy aquí, Gen. Puedes hacer tu pausa para la comida cuando quieras."
    kia "Ich bin da, General. Sie können Ihre Mittagspause machen, wann immer Sie wollen."

# game/scripts/c21/c21.rpy:2066
translate german c21s003_KiaraDate_1edb4e6e:

    # mc "Hola de nuevo, Gen."
    mc "Hallo nochmal, Gen."

# game/scripts/c21/c21.rpy:2067
translate german c21s003_KiaraDate_29a64304:

    # gen "Justo a tiempo, me estaba muriendo de hambre. La biblioteca está vacía, no queda nada pendiente."
    gen "Gerade noch rechtzeitig, ich war total ausgehungert. Die Bibliothek ist leer, es gibt nichts mehr zu tun."

# game/scripts/c21/c21.rpy:2069
translate german c21s003_KiaraDate_a31f8e02:

    # kia "Pues el puesto de perritos calientes tiene bastante cola ahora. Si necesitas más tiempo no hay ningún problema."
    kia "Am Hotdog-Stand ist gerade eine ziemlich lange Schlange. Falls Sie mehr Zeit brauchen, ist das kein Problem."

# game/scripts/c21/c21.rpy:2070
translate german c21s003_KiaraDate_0ed3ff23:

    # gen "[kia]... ¿dónde está tu bolso?"
    gen "[kia]... Wo ist deine Tasche?"

# game/scripts/c21/c21.rpy:2072
translate german c21s003_KiaraDate_21ee7fe8:

    # kia "¡Mierda! Me lo he dejado en el restaurante."
    kia "Verdammt! Ich habe es im Restaurant vergessen."

# game/scripts/c21/c21.rpy:2074
translate german c21s003_KiaraDate_ee87a7da:

    # kia "¿Puedes cubrirme diez minutos mientras voy a buscarlo?"
    kia "Könntest du mich für zehn Minuten vertreten, während ich es hole?"

# game/scripts/c21/c21.rpy:2075
translate german c21s003_KiaraDate_40554669:

    # gen "Ningún problema. Ve a ver si lo han encontrado antes de que desaparezca."
    gen "Kein Problem. Schau nach, ob sie es gefunden haben, bevor es verschwindet."

# game/scripts/c21/c21.rpy:2076
translate german c21s003_KiaraDate_962e9524:

    # mc "No os preocupéis, voy a llamarles y voy a buscarlo, voy a llegar más rápido que tú con los tacones. Ahora lo traigo."
    mc "Keine Sorge, ich rufe an und hole es. Ich bin schneller da als du in High Heels. Ich bringe es sofort."

# game/scripts/c21/c21.rpy:2077
translate german c21s003_KiaraDate_7d70251d:

    # mcp "(Espero que siga allí o que lo haya encontrado el camarero cuando nos hemos ido.)"
    mcp "(Ich hoffe, es ist noch da, oder dass der Kellner es gefunden hat, nachdem wir gegangen sind.)"

# game/scripts/c21/c21.rpy:2079
translate german c21s003_KiaraDate_2a1b37fd:

    # kia "Gracias, [mc]. ¿Aviso a [ama] de que vas a llegar tarde?"
    kia "Danke, [mc]. Soll ich [ama] Bescheid geben, dass du dich verspätest?"

# game/scripts/c21/c21.rpy:2080
translate german c21s003_KiaraDate_8b13deee:

    # mc "Sí, por favor."
    mc "Ja, bitte."

# game/scripts/c21/c21.rpy:2082
translate german c21s003_KiaraDate_82c139e0:

    # "Sales de la biblioteca y empiezas a correr hacia el restaurante mientras les llamas. No cogen el teléfono."
    "Du verlässt die Bibliothek und rennst zum Restaurant, während du dort anrufst. Sie gehen nicht ans Telefon."

# game/scripts/c21/c21.rpy:2083
translate german c21s003_KiaraDate_28f6b659:

    # "Llegas un par de minutos después. Nunca habías corrido tan rápido en tu vida."
    "Du kommst ein paar Minuten später an. So schnell bist du noch nie in deinem Leben gerannt."

# game/scripts/c21/c21.rpy:2085
translate german c21s003_KiaraDate_ddd4ef24:

    # "El camarero saca el bolso de la barra antes de que puedas recuperar el aliento para pedírselo."
    "Der Kellner zieht die Tüte von der Theke, bevor Sie überhaupt Luft holen und danach fragen können."

# game/scripts/c21/c21.rpy:2086
translate german c21s003_KiaraDate_61bec498:

    # "Hubiera sido una forma horrible de acabar la segunda cita si [kia] hubiera perdido el bolso."
    "Es wäre ein schreckliches Ende für das zweite Date gewesen, wenn [kia] ihre Handtasche verloren hätte."

# game/scripts/c21/c21.rpy:2088
translate german c21s003_KiaraDate_f8948cde:

    # "Vuelves corriendo a la biblioteca. No quieres que [kia] se preocupe por su bolso más de lo necesario. Corres un poco más lento."
    "Du rennst zurück zur Bibliothek. Du willst nicht, dass [kia] sich unnötig Sorgen um ihre Tasche macht. Du läufst etwas langsamer."

# game/scripts/c21/c21.rpy:2089
translate german c21s003_KiaraDate_7ec444f4:

    # "Quieres mantener un poco de dignidad cuando llegues, y fregar la biblioteca con la lengua no es la mejor forma de hacerlo."
    "Sie möchten bei Ihrer Ankunft Ihre Würde bewahren, und die Bibliothek mit der Zunge zu schrubben, ist nicht der beste Weg, dies zu erreichen."

# game/scripts/c21/c21.rpy:2092
translate german c21s003_KiaraDate_41e727be:

    # "Cuando estás a punto de entrar, oyes voces..."
    "Gerade als du hineingehen willst, hörst du Stimmen..."

# game/scripts/c21/c21.rpy:2094
translate german c21s003_KiaraDate_12932815:

    # kia "...¡Me da lo mismo que tenga edad para ser mi hijo!"
    kia "Mir ist sein Alter völlig egal, er ist mein Sohn!"

# game/scripts/c21/c21.rpy:2095
translate german c21s003_KiaraDate_a9cc36f2:

    # gen "[kia], lo digo por tu bien. Los chavales como él sólo quieren una cosa en una mujer de tu edad..."
    gen "[kia], ich sage das nur zu deinem Besten. Typen wie er wollen von einer Frau in deinem Alter nur das Eine..."

# game/scripts/c21/c21.rpy:2096
translate german c21s003_KiaraDate_5751ce07:

    # kia "Él es diferente..."
    kia "Er ist anders..."

# game/scripts/c21/c21.rpy:2097
translate german c21s003_KiaraDate_31d65093:

    # gen "Si supieras las veces que he oído eso..."
    gen "Wenn du nur wüsstest, wie oft ich das schon gehört habe..."

# game/scripts/c21/c21.rpy:2098
translate german c21s003_KiaraDate_f46409ae:

    # mcp "(Es el momento de intervenir.)"
    mcp "(Es ist Zeit einzugreifen.)"

# game/scripts/c21/c21.rpy:2100
translate german c21s003_KiaraDate_a641d824:

    # mc "Hola, [kia], Sra. Sky. Vengo con el bolso. Lo había recogido el camarero en cuanto nos hemos ido."
    mc "Guten Tag, Frau Sky. Ich habe Ihre Tasche mitgenommen. Der Kellner hat sie gleich nach unserer Abreise abgeholt."

# game/scripts/c21/c21.rpy:2101
translate german c21s003_KiaraDate_0d7b308b:

    # kia "¡Gracias a Dios!"
    kia "Gott sei Dank!"

# game/scripts/c21/c21.rpy:2102
translate german c21s003_KiaraDate_5e5e2a04:

    # gen "Gracias, [mc]. [kia] estaba muy preocupada. Y puedes seguir llamándome Gen..."
    gen "Danke, [mc]. [kia] Ich war wirklich besorgt. Und du kannst mich weiterhin Gen nennen..."

# game/scripts/c21/c21.rpy:2104
translate german c21s003_KiaraDate_ef1dcc07:

    # "Ignoras a Geneviève y te arrodillas a los pies de [kia], poniendo el bolso en el suelo."
    "Du ignorierst Geneviève und kniest vor [kia] nieder, wobei du deine Tasche auf den Boden stellst."

# game/scripts/c21/c21.rpy:2106
translate german c21s003_KiaraDate_3c0703f5:

    # kia "¿Qué haces, [mc]?"
    kia "Was machst du da, [mc]?"

# game/scripts/c21/c21.rpy:2107
translate german c21s003_KiaraDate_51b3fcab:

    # mc "He oído como la Sra. Sky decía que los chavales como yo sólo queremos una cosa con mujeres como tú."
    mc "Ich habe Frau Sky sagen hören, dass Typen wie ich bei Frauen wie Ihnen nur eines wollen."

# game/scripts/c21/c21.rpy:2109
translate german c21s003_KiaraDate_2d0d83f0:

    # mc "No sé lo que quieren otros chavales como yo."
    mc "Ich weiß nicht, was andere Kinder wie ich wollen."

# game/scripts/c21/c21.rpy:2111
translate german c21s003_KiaraDate_6e1b5cf3:

    # mc "Yo lo único que quiero es poner el mundo a tus pies, [kia]. Empiezo con un bolso."
    mc "Ich möchte dir die Welt zu Füßen legen, [kia]. Ich fange mit einer Handtasche an."

# game/scripts/c21/c21.rpy:2112
translate german c21s003_KiaraDate_6b53cf56:

    # mc "Y también quiero callar a quien opina sobre nosotros sin saber nada sobre lo que hemos pasado."
    mc "Und ich möchte auch diejenigen zum Schweigen bringen, die über uns urteilen, ohne etwas über das zu wissen, was wir durchgemacht haben."

# game/scripts/c21/c21.rpy:2113
translate german c21s003_KiaraDate_c3f1b5be:

    # kia "Gracias, [mc], pero... ¿puedes levantarte?"
    kia "Danke, [mc], aber... kannst du aufstehen?"

# game/scripts/c21/c21.rpy:2116
translate german c21s003_KiaraDate_8ee06496:

    # "Estás enfadado. Mucho. Sabes que tus relaciones pueden hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Du bist wütend. Sehr wütend. Du weißt, dass deine Beziehungen für Verwunderung sorgen könnten. Aber darauf warst du nicht vorbereitet."

# game/scripts/c21/c21.rpy:2118
translate german c21s003_KiaraDate_5c20a138:

    # "Estás enfadado. Mucho. Sabes que tu relación con [kia] puede hacer que se levante más de una ceja. Pero no estabas preparado para esto."
    "Du bist wütend. Sehr wütend. Du weißt, dass deine Beziehung zu [kia] für Verwunderung sorgen könnte. Aber darauf warst du nicht vorbereitet."

# game/scripts/c21/c21.rpy:2119
translate german c21s003_KiaraDate_83eb79b0:

    # mc "¿Has podido llamar a [ama]?"
    mc "Konnten Sie [ama] anrufen?"

# game/scripts/c21/c21.rpy:2120
translate german c21s003_KiaraDate_ecb11950:

    # kia "Mi móvil estaba en el bolso... ni siquiera he pensado en ello, y no me he aprendido su número."
    kia "Mein Handy war in meiner Tasche... Ich habe gar nicht darüber nachgedacht und ihre Nummer nicht herausgefunden."

# game/scripts/c21/c21.rpy:2121
translate german c21s003_KiaraDate_7d61ae16:

    # mc "Entonces no te preocupes. Aún llego a tiempo."
    mc "Dann mach dir keine Sorgen. Ich werde trotzdem rechtzeitig da sein."

# game/scripts/c21/c21.rpy:2123
translate german c21s003_KiaraDate_45d03ede:

    # gen "Siento si te he ofendido, [mc]. Sólo intentaba proteger a [kia]."
    gen "Es tut mir leid, falls ich dich beleidigt habe, [mc]. Ich wollte nur [kia] beschützen."

# game/scripts/c21/c21.rpy:2124
translate german c21s003_KiaraDate_4ab0c2c3:

    # "Está nerviosa. Sabe que ha metido la pata. Se le nota más aún el acento francés."
    "Sie ist nervös. Sie weiß, dass sie Mist gebaut hat. Ihr französischer Akzent ist dadurch noch auffälliger."

# game/scripts/c21/c21.rpy:2125
translate german c21s003_KiaraDate_4bed652a:

    # mc "Me parece loable, pero debería informarse sobre lo que habla antes de decir algo de lo que pueda arrepentirse, Sra. Sky."
    mc "Ich finde das lobenswert, aber Sie sollten sich erst informieren, worüber Sie sprechen, bevor Sie etwas sagen, das Sie später bereuen könnten, Frau Sky."

# game/scripts/c21/c21.rpy:2126
translate german c21s003_KiaraDate_6547ca29:

    # "Tu tono es cortante. Ahora mismo no quieres dar explicaciones ni hablar con esta mujer."
    "Dein Tonfall ist kurz angebunden. Du willst im Moment weder Erklärungen abgeben noch mit dieser Frau sprechen."

# game/scripts/c21/c21.rpy:2127
translate german c21s003_KiaraDate_9e5bf2a2:

    # gen "Gen..."
    gen "Gen..."

# game/scripts/c21/c21.rpy:2128
translate german c21s003_KiaraDate_557ac246:

    # mc "Sólo acorto los nombres de mis amigos, Geneviève."
    mc "Ich kürze einfach die Namen meiner Freunde ab, Geneviève."

# game/scripts/c21/c21.rpy:2130
translate german c21s003_KiaraDate_56a4311f:

    # "Dulcificas tu tono cuando te diriges a [kia]."
    "Sie wandeln Ihren Tonfall, wenn Sie [kia] ansprechen."

# game/scripts/c21/c21.rpy:2131
translate german c21s003_KiaraDate_47c19fca:

    # mc "Voy a ir a lo de [ama] antes de que se haga tarde."
    mc "Ich gehe zu [ama], bevor es zu spät wird."

# game/scripts/c21/c21.rpy:2132
translate german c21s003_KiaraDate_1ac8e5cc:

    # kia "Gracias de nuevo, [mc]."
    kia "Nochmals vielen Dank, [mc]."

# game/scripts/c21/c21.rpy:2133
translate german c21s003_KiaraDate_8b0e91b1:

    # mc "Te veo en casa, cielo."
    mc "Wir sehen uns zu Hause, Schatz."

# game/scripts/c21/c21.rpy:2135
translate german c21s003_KiaraDate_da634e8e:

    # kia "Espera un momento..."
    kia "Einen Moment bitte..."

# game/scripts/c21/c21.rpy:2136
translate german c21s003_KiaraDate_5c6b8bd7:

    # mc "¿Falta algo en el bolso?"
    mc "Fehlt etwas in der Tasche?"

# game/scripts/c21/c21.rpy:2137
translate german c21s003_KiaraDate_da7da0b6:

    # kia "Ni lo sé ni me importa."
    kia "Ich weiß es weder, noch interessiert es mich."

# game/scripts/c21/c21.rpy:2138
translate german c21s003_KiaraDate_9493c8fc:

    # "El bolso continúa en el suelo, donde los has dejado."
    "Die Tasche steht noch immer auf dem Boden, genau da, wo du sie gelassen hast."

# game/scripts/c21/c21.rpy:2140
translate german c21s003_KiaraDate_6a149303:

    # "[kia] se lanza a tus labios para sorpresa tuya y de Geneviève. Tú has defendido vuestra relación a tu manera."
    "[kia] stürzt sich, zu eurer und Genevièves Überraschung, auf deine Lippen. Du hast eure Beziehung auf deine Weise verteidigt."

# game/scripts/c21/c21.rpy:2141
translate german c21s003_KiaraDate_5781450e:

    # "Ella la defiende a la suya."
    "Sie verteidigt die Ihren."

# game/scripts/c21/c21.rpy:2142
translate german c21s003_KiaraDate_f42e6c2d:

    # "Demostrándole a Geneviève que sus palabras no han conseguido sembrar ninguna duda."
    "Sie wollte Geneviève beweisen, dass ihre Worte keinerlei Zweifel gesät hatten."

# game/scripts/c21/c21.rpy:2143
translate german c21s003_KiaraDate_8800b7ec:

    # "También te lo quiere demostrar a ti."
    "Er will es auch dir beweisen."

# game/scripts/c21/c21.rpy:2144
translate german c21s003_KiaraDate_319ad8f0:

    # "Todavía sabe a aguacate."
    "Es schmeckt immer noch nach Avocado."

# game/scripts/c21/c21.rpy:2146
translate german c21s003_KiaraDate_e03f835c:

    # kia "¡Wow! *Risa*"
    kia "Wow! *lacht*"

# game/scripts/c21/c21.rpy:2147
translate german c21s003_KiaraDate_9a736d83:

    # mc "¡Wow! *Risa*"
    mc "Wow! *lacht*"

# game/scripts/c21/c21.rpy:2149
translate german c21s003_KiaraDate_a7d06318:

    # kia "Gracias por todo, cielo."
    kia "Danke für alles, Schatz."

# game/scripts/c21/c21.rpy:2150
translate german c21s003_KiaraDate_01b1a236:

    # "Ese \"por todo\" incluye dar la cara por ella. Quizás por primera vez en su vida alguien lo ha hecho."
    "Dieses „für alles“ schließt auch ein, für sie einzustehen. Vielleicht hat das zum ersten Mal in ihrem Leben jemand getan."

# game/scripts/c21/c21.rpy:2151
translate german c21s003_KiaraDate_e2d67541:

    # mc "Te veo en casa, preciosa."
    mc "Wir sehen uns zu Hause, meine Schöne."

# game/scripts/c21/c21.rpy:2153
translate german c21s003_KiaraDate_54905dfa:

    # mc "Adiós, Geneviève."
    mc "Auf Wiedersehen, Geneviève."

# game/scripts/c21/c21.rpy:2155
translate german c21s003_KiaraDate_e5568ef5:

    # "Te marchas mientras escuchas la despedida murmurada de Geneviève."
    "Du gehst, während du Genevièves gemurmelten Abschied hörst."

# game/scripts/c21/c21.rpy:2168
translate german c21s004_AmandaCoffee_73df7f5a:

    # "Llegas al café donde has quedado con [ama]. Era un sitio que no habías visitado nunca anteriormente, pero has venido varias veces en las últimas semanas."
    "Du kommst in dem Café an, in dem du dich mit [ama] triffst. Es ist ein Ort, den du noch nie zuvor besucht hast, aber du warst in den letzten Wochen schon mehrmals dort."

# game/scripts/c21/c21.rpy:2170
translate german c21s004_AmandaCoffee_142dc0f7:

    # "[ama] ya está allí, con un café y un portátil sobre la mesa."
    "[ama] ist schon da, mit einer Tasse Kaffee und einem Laptop auf dem Tisch."

# game/scripts/c21/c21.rpy:2172
translate german c21s004_AmandaCoffee_db15f581:

    # mc "Hola, [ama]. No te levantes. ¿Llevas mucho esperando? No llego tarde, ¿verdad?"
    mc "Hallo, [ama]. Bleib sitzen. Wartest du schon lange? Ich bin doch nicht zu spät, oder?"

# game/scripts/c21/c21.rpy:2173
translate german c21s004_AmandaCoffee_5e28640c:

    # ama "No te preocupes, llevo diez minutos aquí tan solo. He llegado antes de la hora. Y tú llegas super puntual."
    ama "Keine Sorge, ich bin erst seit zehn Minuten hier. Ich bin früh angekommen. Und du bist super pünktlich."

# game/scripts/c21/c21.rpy:2174
translate german c21s004_AmandaCoffee_ed741d2f:

    # mc "Nunca me ha parecido bien hacer esperar a nadie. Lo considero una falta de respeto hacia el tiempo de los demás."
    mc "Ich habe es noch nie für richtig gehalten, jemanden warten zu lassen. Ich betrachte es als mangelnden Respekt vor der Zeit anderer."

# game/scripts/c21/c21.rpy:2176
translate german c21s004_AmandaCoffee_4a9e8483:

    # ama "No sé cómo lo consigues. Los civiles tenéis unas vidas muy complicadas con un montón de cosas por hacer que se solapan."
    ama "Ich weiß nicht, wie ihr das schafft. Ihr Zivilisten habt ein sehr kompliziertes Leben mit vielen sich überschneidenden Aufgaben."

# game/scripts/c21/c21.rpy:2178
translate german c21s004_AmandaCoffee_30339c94:

    # ama "Casi echo de menos la vida organizada de la base en la que siempre sabes qué tienes que hacer a qué hora. Solo casi."
    ama "Ich vermisse fast das geordnete Leben auf dem Stützpunkt, wo man immer wusste, was man wann zu tun hatte. Nur fast."

# game/scripts/c21/c21.rpy:2179
translate german c21s004_AmandaCoffee_1043c8a0:

    # mc "Yo estoy pensando en fichar una secretaria. *Risa*"
    mc "Ich überlege, eine Sekretärin einzustellen. *lacht*"

# game/scripts/c21/c21.rpy:2181
translate german c21s004_AmandaCoffee_6f095e24:

    # ama "¿Más mujeres a tu alrededor? *Risa* ¿No tienes suficientes?"
    ama "Mehr Frauen um dich herum? *lacht* Hast du nicht genug?"

# game/scripts/c21/c21.rpy:2182
translate german c21s004_AmandaCoffee_1759b4a8:

    # mc "*Risa* Estaba pensando en fichar a Meemaw para eso. *Risa* Al menos se mantendría activa y se sentiría útil."
    mc "*Lacht* Ich hatte überlegt, Meemaw dafür anzuwerben. *Lacht* Wenigstens bliebe sie aktiv und hätte das Gefühl, nützlich zu sein."

# game/scripts/c21/c21.rpy:2183
translate german c21s004_AmandaCoffee_8c8428b9:

    # mc "Además, evitaría tener que informar a más personas de los secretos familiares."
    mc "Außerdem würde es vermeiden, mehr Menschen über Familiengeheimnisse zu informieren."

# game/scripts/c21/c21.rpy:2185
translate german c21s004_AmandaCoffee_a0fef5fc:

    # ama "Los secretos parece que van a dejar de serlos. He hablado con [aar] esta mañana. ¿Ha conseguido contactar contigo?"
    ama "Die Geheimnisse scheinen nun ans Licht zu kommen. Ich habe heute Morgen mit [aar] gesprochen. Konnte er dich erreichen?"

# game/scripts/c21/c21.rpy:2186
translate german c21s004_AmandaCoffee_7ff06615:

    # mc "Sí, hemos estado hablando sobre la compañía que quiere comprar NTR... ¿Iron Fist se llamaban?"
    mc "Ja, wir haben über die Firma gesprochen, die NTR kaufen will... Hieß sie Iron Fist?"

# game/scripts/c21/c21.rpy:2188
translate german c21s004_AmandaCoffee_f7182efb:

    # ama "Sí, son unos capullos, aunque efectivos."
    ama "Ja, sie sind Idioten, aber effektiv."

# game/scripts/c21/c21.rpy:2189
translate german c21s004_AmandaCoffee_8b2a1015:

    # ama "Su concepto de operaciones encubiertas es que si no hay supervivientes nadie puede informar. Tienen la sutileza de un ariete... o de [emm]."
    ama "Ihr Konzept für verdeckte Operationen beruht darauf, dass niemand etwas melden kann, wenn es keine Überlebenden gibt. Sie sind so subtil wie ein Rammbock … oder ein C2-Zünder."

# game/scripts/c21/c21.rpy:2190
translate german c21s004_AmandaCoffee_a53a432a:

    # mc "*Risa* No es la primera vez que comparan la sutileza de [emm] con un ariete."
    mc "*Gelächter* Es ist nicht das erste Mal, dass sie die Subtilität von [emm] mit einem Rammbock verglichen haben."

# game/scripts/c21/c21.rpy:2191
translate german c21s004_AmandaCoffee_82069f6e:

    # mc "Pero hablando de Iron Fist, tienen que ser enormes si pueden pagar los nueve o diez dígitos que [aar] dijo que valía NTR."
    mc "Aber wo wir gerade von Iron Fist sprechen, die müssen ja riesig sein, wenn sie die neun- oder zehnstelligen Beträge zahlen können, die [aar] laut NTR verlangt."

# game/scripts/c21/c21.rpy:2193
translate german c21s004_AmandaCoffee_136c728f:

    # ama "No, no lo son. Son grandes, pero más pequeños que nosotros. Quieren aprovechar el vacío de poder para comprar NTR por una fracción de su valor."
    ama "Nein, das sind sie nicht. Sie sind zwar groß, aber kleiner als wir. Sie wollen das Machtvakuum ausnutzen, um NTR für einen Bruchteil seines Wertes zu kaufen."

# game/scripts/c21/c21.rpy:2194
translate german c21s004_AmandaCoffee_ae964a75:

    # ama "Comprarnos casi triplicaría su cifra de negocio y les proporcionaría contratos a los que no tienen acceso ahora mismo."
    ama "Durch den Kauf von uns würde sich ihr Umsatz fast verdreifachen und sie würden Zugang zu Verträgen erhalten, die ihnen derzeit nicht zur Verfügung stehen."

# game/scripts/c21/c21.rpy:2195
translate german c21s004_AmandaCoffee_4929bee7:

    # ama "Su negocio de operaciones especiales es algo menos de la mitad del nuestro. Y estamos hablando de cientos de millones."
    ama "Ihr Spezialoperationsgeschäft ist etwas weniger als halb so groß wie unseres. Und wir sprechen hier von Hunderten von Millionen."

# game/scripts/c21/c21.rpy:2196
translate german c21s004_AmandaCoffee_2e7db18d:

    # mc "Eso es un montón de dinero. ¿Tantas operaciones especiales se hacen?"
    mc "Das ist eine Menge Geld. Wurden so viele Spezialoperationen durchgeführt?"

# game/scripts/c21/c21.rpy:2198
translate german c21s004_AmandaCoffee_a148b45a:

    # ama "Se hacen muchas. Y son caras. Iron Fist trabaja mucho con los gobiernos de países que Estados Unidos no considera amigables."
    ama "Viele werden hergestellt. Und sie sind teuer. Iron Fist arbeitet eng mit den Regierungen von Ländern zusammen, die die Vereinigten Staaten nicht als freundlich gesinnt betrachten."

# game/scripts/c21/c21.rpy:2199
translate german c21s004_AmandaCoffee_19c56fe5:

    # ama "Por eso no tienen acceso a algunos contratos."
    ama "Deshalb haben sie keinen Zugriff auf einige Verträge."

# game/scripts/c21/c21.rpy:2201
translate german c21s004_AmandaCoffee_54f98cb9:

    # ama "Los clientes principales de NTR son precisamente Estados Unidos y otros países occidentales que no se quieren manchar las manos haciendo algunas cosas."
    ama "Die Hauptkunden von NTR sind genau die Vereinigten Staaten und andere westliche Länder, die sich bei bestimmten Dingen nicht die Hände schmutzig machen wollen."

# game/scripts/c21/c21.rpy:2202
translate german c21s004_AmandaCoffee_0c7e8fb7:

    # ama "Pagan MUY bien por evitar salir en la prensa si algo sale mal."
    ama "Sie zahlen SEHR viel, um im Falle eines Fehlers nicht in der Presse aufzutauchen."

# game/scripts/c21/c21.rpy:2203
translate german c21s004_AmandaCoffee_01b2a114:

    # mc "Lo entiendo. Como una misión en Burkina Faso donde envían a dos niñas de 14 años. Quedaría mal en la prensa si se emborrachan."
    mc "Ich verstehe. Wie bei einer Mission in Burkina Faso, wo man zwei 14-jährige Mädchen hinschickt. Es käme in der Presse schlecht weg, wenn sie sich betrinken würden."

# game/scripts/c21/c21.rpy:2205
translate german c21s004_AmandaCoffee_6298a0d4:

    # ama "Sí, a eso me refiero. Esa misión no la podían hacer los Navy SEAL. *Risa* Y no solo porque Burkina no tenga mar."
    ama "Ja, genau das meine ich. Diese Mission hätten die Navy SEALs niemals durchführen können. *lacht* Und das nicht nur, weil Burkina Faso kein Meer hat."

# game/scripts/c21/c21.rpy:2206
translate german c21s004_AmandaCoffee_2534901f:

    # ama "Y por eso quería hablar contigo sobre el futuro de NTR. He hecho algunos números con la información que me ha enviado [aar]..."
    ama "Und deshalb wollte ich mit Ihnen über die Zukunft von NTR sprechen. Ich habe anhand der Informationen, die Sie mir geschickt haben, einige Berechnungen angestellt [aar]..."

# game/scripts/c21/c21.rpy:2207
translate german c21s004_AmandaCoffee_98fe2261:

    # mc "Déjame pedir un café y me lo explicas."
    mc "Ich bestelle mir einen Kaffee, dann kannst du es mir erklären."

# game/scripts/c21/c21.rpy:2209
translate german c21s004_AmandaCoffee_86475cc1:

    # "[ama] pasa unos 20 minutos explicándote la situación del negocio, hasta que llega a la parte más interesante. El dinero."
    "[ama] verbringt etwa 20 Minuten damit, die geschäftliche Situation zu erläutern, bis er zum interessantesten Teil kommt: dem Geld."

# game/scripts/c21/c21.rpy:2211
translate german c21s004_AmandaCoffee_472a8405:

    # ama "La parte médica de la compañía es el 12%% de la facturación global de NTR. El 71%% de la facturación proviene de operaciones de Seguridad."
    ama "Die Medizinsparte des Unternehmens trägt 12%% zum weltweiten Umsatz von NTR bei. 71%% des Umsatzes stammen aus dem Bereich Sicherheitsdienstleistungen."

# game/scripts/c21/c21.rpy:2212
translate german c21s004_AmandaCoffee_6b6de5d5:

    # ama "Puedes ver aquí la mala noticia. La parte médica es la que menos dinero da. Es imposible basar la compañía sólo en eso ahora mismo."
    ama "Hier sehen Sie die schlechten Nachrichten. Der medizinische Bereich ist am wenigsten profitabel. Es ist unmöglich, das Unternehmen derzeit allein darauf zu stützen."

# game/scripts/c21/c21.rpy:2213
translate german c21s004_AmandaCoffee_1ada89a7:

    # mc "¿Qué es ese concepto? ¿Servicios de Apoyo?"
    mc "Was ist das für ein Konzept? Unterstützungsdienste?"

# game/scripts/c21/c21.rpy:2215
translate german c21s004_AmandaCoffee_4f41ba3a:

    # ama "Alquiler de Equipos y Soporte Logístico, básicamente. A otras compañías como NTR, pero más pequeñas. Transporte de operativos, alquiler de equipos, etc."
    ama "Wir bieten hauptsächlich Geräteverleih und logistische Unterstützung an. Auch andere Unternehmen wie NTR unterstützen wir, allerdings in kleinerem Umfang. Dazu gehören Personaltransporte, Geräteverleih usw."

# game/scripts/c21/c21.rpy:2216
translate german c21s004_AmandaCoffee_c15671a1:

    # mc "¿Podríamos mantener esa parte de la Compañía? No nos involucraríamos en Operaciones Especiales con eso, ¿no?"
    mc "Könnten wir diesen Teil des Unternehmens behalten? Wir würden uns damit nicht in Sondereinsätze verwickeln, oder?"

# game/scripts/c21/c21.rpy:2218
translate german c21s004_AmandaCoffee_0e46556c:

    # ama "Déjame mirar una cosa..."
    ama "Lassen Sie mich eine Sache betrachten..."

# game/scripts/c21/c21.rpy:2219
translate german c21s004_AmandaCoffee_467f4d49:

    # ama "No sería difícil de hacer. Tenemos los contactos y, si dejamos de ser su competencia, otras compañías podrían requerir nuestros servicios."
    ama "Das wäre nicht schwierig. Wir haben die Kontakte, und wenn wir aufhören, ihre Konkurrenz zu sein, könnten andere Unternehmen unsere Dienste in Anspruch nehmen."

# game/scripts/c21/c21.rpy:2221
translate german c21s004_AmandaCoffee_e03e8c16:

    # ama "Bien pensado, pero habría que estudiarlo bien. Y no, no nos involucramos en las operaciones de otras compañías. Solo les damos apoyo."
    ama "Das ist eine gute Idee, müsste aber gründlich geprüft werden. Und nein, wir mischen uns nicht in die Geschäfte anderer Unternehmen ein. Wir bieten ihnen lediglich Unterstützung an."

# game/scripts/c21/c21.rpy:2222
translate german c21s004_AmandaCoffee_992f61f5:

    # mc "Dale trabajo a [aar]. *Risa* Creo que, de momento, sería bueno mantener esa fuente de ingresos."
    mc "Gib [aar] einen Job. *Lacht* Ich denke, es wäre vorerst gut, diese Einkommensquelle aufrechtzuerhalten."

# game/scripts/c21/c21.rpy:2223
translate german c21s004_AmandaCoffee_bc05e904:

    # mc "Has dicho que es la mala noticia. ¿Hay una buena?"
    mc "Du sagtest, das seien die schlechten Nachrichten. Gibt es denn auch gute Nachrichten?"

# game/scripts/c21/c21.rpy:2225
translate german c21s004_AmandaCoffee_5d5c4dac:

    # ama "Sí, esta. Y con lo que acabas de decir de mantener los Servicios de Apoyo, es incluso mejor."
    ama "Ja, genau dieser. Und angesichts dessen, was Sie eben über die Aufrechterhaltung der Supportdienste gesagt haben, ist er sogar noch besser."

# game/scripts/c21/c21.rpy:2226
translate german c21s004_AmandaCoffee_b76726e1:

    # ama "La facturación crece en las tres áreas cada año, pero el crecimiento en el área de Seguridad es casi residual, entre un 2%% y un 5%%."
    ama "Der Umsatz steigt in allen drei Bereichen jährlich, im Bereich Sicherheit ist das Wachstum jedoch mit 2%% bis 5%% Prozent nahezu vernachlässigbar."

# game/scripts/c21/c21.rpy:2227
translate german c21s004_AmandaCoffee_c9bfcae3:

    # ama "El crecimiento en los Servicios de Apoyo es de entre un 15%% y un 18%% anual."
    ama "Das Wachstum im Bereich der Unterstützungsdienstleistungen liegt jährlich zwischen 15%% und 18%%."

# game/scripts/c21/c21.rpy:2228
translate german c21s004_AmandaCoffee_5ac46d50:

    # mc "Eso es una barbaridad de crecimiento."
    mc "Das ist ein unglaubliches Wachstum."

# game/scripts/c21/c21.rpy:2230
translate german c21s004_AmandaCoffee_f4f742b4:

    # ama "La facturación de la parte médica crece entre el 50%% y el 60%%. Y acelerando. Hemos empezado muy abajo y es fácil crecer."
    ama "Der Umsatz des medizinischen Bereichs wächst um 50%% bis 60%% Prozent. Und das Wachstum beschleunigt sich. Wir haben von einer sehr kleinen Basis aus begonnen, und es ist leicht, zu wachsen."

# game/scripts/c21/c21.rpy:2231
translate german c21s004_AmandaCoffee_b400262a:

    # ama "Es la partida más pequeña, pero el año que viene seguramente superará a los Servicios de Apoyo."
    ama "Es ist zwar das kleinste Element, aber nächstes Jahr wird es die Supportleistungen sicherlich übertreffen."

# game/scripts/c21/c21.rpy:2232
translate german c21s004_AmandaCoffee_0bbcecef:

    # mc "Déjame hacer unos cálculos..."
    mc "Ich muss ein paar Berechnungen anstellen..."

# game/scripts/c21/c21.rpy:2234
translate german c21s004_AmandaCoffee_72a4dfa7:

    # mc "En cinco años, con ese ritmo de crecimiento, podría ser la principal área de negocio."
    mc "Bei diesem Wachstumstempo könnte es in fünf Jahren der wichtigste Geschäftsbereich sein."

# game/scripts/c21/c21.rpy:2235
translate german c21s004_AmandaCoffee_6a6d173c:

    # ama "Y en dos años, combinada con los Servicios de Apoyo, superarían al área de Seguridad. Yo también he hecho los cálculos."
    ama "Und in zwei Jahren würden sie, zusammen mit den Supportleistungen, den Sicherheitsbereich übertreffen. Ich habe das auch durchgerechnet."

# game/scripts/c21/c21.rpy:2237
translate german c21s004_AmandaCoffee_e0adb9a3:

    # "[ama] pasa los siguientes minutos explicándote todos los cálculos que ha hecho y cómo su plan puede ser realizable."
    "[ama] verbringt die nächsten Minuten damit, alle seine Berechnungen zu erläutern und zu erklären, wie sein Plan umgesetzt werden kann."

# game/scripts/c21/c21.rpy:2238
translate german c21s004_AmandaCoffee_27e2028b:

    # "A veces tiene que parar para hacer algún cálculo nuevo debido a la posibilidad de mantener los Servicios de Apoyo."
    "Manchmal muss der Vorgang aufgrund der möglichen Aufrechterhaltung der Supportdienste unterbrochen werden, um neue Berechnungen durchzuführen."

# game/scripts/c21/c21.rpy:2239
translate german c21s004_AmandaCoffee_cf440c51:

    # "Son cálculos que aburrirían a cualquiera que no fuera un empollón. Por suerte ambos lo sois."
    "Das sind Berechnungen, die jeden langweilen würden, der kein Nerd ist. Zum Glück seid ihr beide welche."

# game/scripts/c21/c21.rpy:2241
translate german c21s004_AmandaCoffee_36ef2119:

    # ama "Y eso sería todo. Creo que, económicamente, el plan es realizable."
    ama "Und das wäre alles. Ich glaube, der Plan ist wirtschaftlich realisierbar."

# game/scripts/c21/c21.rpy:2242
translate german c21s004_AmandaCoffee_44943cd0:

    # mc "Le veo un problema. ¿Qué hacemos con vosotras? ¿Y con los XY?"
    mc "Ich sehe ein Problem. Was machen wir mit Ihnen? Und mit den XY-Typen?"

# game/scripts/c21/c21.rpy:2244
translate german c21s004_AmandaCoffee_a5795415:

    # ama "También he pensado en eso, pero necesito modificarlo."
    ama "Ich habe darüber auch schon nachgedacht, aber ich muss es noch anpassen."

# game/scripts/c21/c21.rpy:2245
translate german c21s004_AmandaCoffee_e53d4110:

    # ama "No estoy segura de que todos los XY quieran abandonar la vida que llevan. Las misiones dan mucha adrenalina, son como una droga."
    ama "Ich bin mir nicht sicher, ob alle XYs ihr jetziges Leben aufgeben wollen. Die Missionen sind ein enormer Adrenalinrausch, wie eine Droge."

# game/scripts/c21/c21.rpy:2246
translate german c21s004_AmandaCoffee_e342d899:

    # mc "Pero vosotras sí que queréis dejar esas misiones."
    mc "Aber du willst diese Missionen ja verlassen."

# game/scripts/c21/c21.rpy:2248
translate german c21s004_AmandaCoffee_10dcc7de:

    # ama "Nosotras somos diferentes. Envejecemos a un ritmo normal. Ellos saben que tienen una juventud limitada y querrán sacarle el máximo partido."
    ama "Wir sind anders. Wir altern in normalem Tempo. Sie wissen, dass ihre Jugend begrenzt ist und wollen sie bestmöglich nutzen."

# game/scripts/c21/c21.rpy:2249
translate german c21s004_AmandaCoffee_55c23b04:

    # ama "[eva] y yo nos conformaríamos con un trabajo normal."
    ama "[eva] und ich wäre auch mit einem normalen Job zufrieden."

# game/scripts/c21/c21.rpy:2250
translate german c21s004_AmandaCoffee_dda27f5f:

    # mc "¿Como jefas de seguridad de la base, por ejemplo? Había pensado en eso como opción. En el fondo, la empresa también es vuestra."
    mc "Zum Beispiel als Sicherheitschef auf dem Stützpunkt? Das hatte ich auch schon in Erwägung gezogen. Letztendlich gehört das Unternehmen auch Ihnen."

# game/scripts/c21/c21.rpy:2252
translate german c21s004_AmandaCoffee_99e64c93:

    # ama "¿Qué? ¡No! ¿Por qué quieres hacernos esto?"
    ama "Was? Nein! Warum wollt ihr uns das antun?"

# game/scripts/c21/c21.rpy:2253
translate german c21s004_AmandaCoffee_44b2bddf:

    # mc "¿Qué? ¿Haceros qué?"
    mc "Was? Was soll ich tun?"

# game/scripts/c21/c21.rpy:2255
translate german c21s004_AmandaCoffee_4254531d:

    # ama "¡Mandarnos lejos!"
    ama "Schickt uns weg!"

# game/scripts/c21/c21.rpy:2256
translate german c21s004_AmandaCoffee_7e3a8c72:

    # ama "¡Os acabamos de encontrar!"
    ama "Wir haben dich gefunden!"

# game/scripts/c21/c21.rpy:2258
translate german c21s004_AmandaCoffee_3a65f1d9:

    # ama "¡[eva] y yo incluso hemos resuelto nuestras diferencias respecto a ti!"
    ama "[eva] und ich haben sogar unsere Differenzen bezüglich dir beigelegt!"

# game/scripts/c21/c21.rpy:2259
translate german c21s004_AmandaCoffee_1024c403:

    # mc "No os quiero mandar lejos, [ama]. Yo también voy a ir a Aruba."
    mc "Ich will dich nicht weit wegschicken, [ama]. Ich fahre auch nach Aruba."

# game/scripts/c21/c21.rpy:2261
translate german c21s004_AmandaCoffee_44557789:

    # ama "Pero tu volverás... y nosotras, si somos las jefas de seguridad, nos tendremos que quedar allí..."
    ama "Aber Sie werden zurückkommen... und wir, wenn wir für die Sicherheit verantwortlich sind, müssen dort bleiben..."

# game/scripts/c21/c21.rpy:2274
translate german c21s004_AmandaCoffee_532effae:

    # mc "También necesitaremos a alguien que proteja a los accionistas, ¿no?"
    mc "Wir brauchen auch jemanden, der die Aktionäre schützt, nicht wahr?"

# game/scripts/c21/c21.rpy:2275
translate german c21s004_AmandaCoffee_87cbbccf:

    # mc "Y no se me ocurre nadie mejor que vosotras. Podéis turnaros, no sé... ¿Una semana cada una en Aruba mientras la otra está aquí con la familia?"
    mc "Und mir fällt niemand Besseres ein als euch beide. Ihr könntet euch abwechseln, ich weiß nicht … Jede eine Woche in Aruba, während die andere hier bei der Familie ist?"

# game/scripts/c21/c21.rpy:2278
translate german c21s004_AmandaCoffee_fb44ec1f:

    # ama "Espera... has dicho que me quieres cerca de ti... ¿Significa eso que...?"
    ama "Moment mal... du sagtest, du willst mich in deiner Nähe haben... Bedeutet das...?"

# game/scripts/c21/c21.rpy:2279
translate german c21s004_AmandaCoffee_c1ad7533:

    # mc "Sí, [ama]. Significa que, si quieres, me encantaría salir contigo."
    mc "Ja, [ama]. Das bedeutet, dass ich, wenn du möchtest, sehr gerne mit dir ausgehen würde."

# game/scripts/c21/c21.rpy:2280
translate german c21s004_AmandaCoffee_ffd67f7e:

    # mc "Sólo estaba esperando a que [eva] y tú aclararais las cosas para decírtelo."
    mc "Ich habe nur darauf gewartet, dass du und [eva] die Sache aufklärt, damit ich es dir sagen kann."

# game/scripts/c21/c21.rpy:2282
translate german c21s004_AmandaCoffee_79933eac:

    # ama "¿Decírmelo? ¿Sólo a mí? ¿No quieres estar con [eva]?"
    ama "Sag mir? Nur mir? Willst du nicht mit [eva] zusammen sein?"

# game/scripts/c21/c21.rpy:2283
translate german c21s004_AmandaCoffee_f87257ab:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "Das ist etwas, worüber [eva] und ich reden müssen. Unter vier Augen. Nur wir beide. Unabhängig davon, ob ich mit ihr zusammen sein will oder nicht."

# game/scripts/c21/c21.rpy:2284
translate german c21s004_AmandaCoffee_0d111a06:

    # ama "Lo entiendo..."
    ama "Ich verstehe..."

# game/scripts/c21/c21.rpy:2286
translate german c21s004_AmandaCoffee_bb3a07dc:

    # ama "¿Significa eso que... puedo besarte?"
    ama "Heißt das... dass ich dich küssen darf?"

# game/scripts/c21/c21.rpy:2287
translate german c21s004_AmandaCoffee_4b26efe4:

    # mc "No, significa que ahora vamos a tirar las tazas al suelo y vamos a follar encima de la mesa. *Risa*"
    mc "Nein, es bedeutet, dass wir die Becher auf den Boden werfen und auf dem Tisch vögeln werden. *lacht*"

# game/scripts/c21/c21.rpy:2289
translate german c21s004_AmandaCoffee_08e8d48b:

    # ama "¿Qué? ¿Ahora? ¿Aquí?"
    ama "Was? Jetzt? Hier?"

# game/scripts/c21/c21.rpy:2290
translate german c21s004_AmandaCoffee_f67c14de:

    # mc "*Risa* Tenemos que trabajar en tu detección del sarcasmo."
    mc "*Gelächter* Wir müssen an deiner Fähigkeit arbeiten, Sarkasmus zu erkennen."

# game/scripts/c21/c21.rpy:2292
translate german c21s004_AmandaCoffee_e0b1a77f:

    # mc "Claro que vamos a besarnos. ¿Me permites?"
    mc "Natürlich werden wir uns küssen. Darf ich?"

# game/scripts/c21/c21.rpy:2295
translate german c21s004_AmandaCoffee_a122784e:

    # "[ama] se levanta como impulsada por un muelle y ataca tus labios con furia."
    "[ama] steigt empor wie von einer Feder angetrieben und attackiert deine Lippen mit Wut."

# game/scripts/c21/c21.rpy:2296
translate german c21s004_AmandaCoffee_97e8eb5a:

    # "\"Atacar\" es la palabra adecuada."
    "„Angriff“ ist das richtige Wort."

# game/scripts/c21/c21.rpy:2297
translate german c21s004_AmandaCoffee_36b607be:

    # "Hay furia y pasión en su beso. Creías que iba a ser un beso tímido, pero no podías estar más equivocado."
    "In ihrem Kuss lag Wut und Leidenschaft. Du dachtest, es würde ein schüchterner Kuss werden, aber du hättest dich nicht mehr irren können."

# game/scripts/c21/c21.rpy:2298
translate german c21s004_AmandaCoffee_e5708729:

    # "Sólo se separa de tus labios cuando le falta el aire."
    "Es löst sich erst von deinen Lippen, wenn ihm die Luft ausgeht."

# game/scripts/c21/c21.rpy:2301
translate german c21s004_AmandaCoffee_e8e43958:

    # ama "¡Wow!"
    ama "Wow!"

# game/scripts/c21/c21.rpy:2302
translate german c21s004_AmandaCoffee_08f7d3ff:

    # mc "*Risa* Estoy de acuerdo. ¡Wow!"
    mc "*lacht* Da stimme ich zu. Wow!"

# game/scripts/c21/c21.rpy:2304
translate german c21s004_AmandaCoffee_c89321d1:

    # ama "*Risa* No te rías de mí. Llevo días queriendo hacer esto..."
    ama "*lacht* Lacht mich nicht aus. Ich wollte das schon seit Tagen machen..."

# game/scripts/c21/c21.rpy:2306
translate german c21s004_AmandaCoffee_21ef5df9:

    # ama "¿Sabes cuando quieres algo durante mucho tiempo y lo consigues...? ¿Ese sentimiento de decepción? ¿De vacío al cumplir el objetivo?"
    ama "Kennst du das Gefühl, wenn man sich etwas schon lange gewünscht hat und es endlich bekommt...? Dieses Gefühl der Enttäuschung? Dieses Gefühl der Leere, wenn man sein Ziel erreicht hat?"

# game/scripts/c21/c21.rpy:2307
translate german c21s004_AmandaCoffee_d5415aec:

    # mc "Sí, conozco ese sentimiento. ¿Decepcionada?"
    mc "Ja, ich kenne das Gefühl. Enttäuscht?"

# game/scripts/c21/c21.rpy:2309
translate german c21s004_AmandaCoffee_f6769de9:

    # ama "*Risa* Tenemos que trabajar en tu costumbre de interrumpir a la gente cuando habla."
    ama "*Gelächter* Wir müssen an deiner Angewohnheit arbeiten, Leute beim Sprechen zu unterbrechen."

# game/scripts/c21/c21.rpy:2310
translate german c21s004_AmandaCoffee_6eb8b13a:

    # ama "Quería decir que esperaba ese sentimiento, pero no se ha dado. *Risa* Al revés. Tengo ganas de ignorar tu sarcasmo y tirar las tazas al suelo."
    ama "Ich wollte eigentlich sagen, dass ich dieses Gefühl erwartet hatte, aber es ist nicht eingetreten. *lacht* Ganz im Gegenteil. Ich habe Lust, deinen Sarkasmus zu ignorieren und die Becher auf den Boden zu werfen."

# game/scripts/c21/c21.rpy:2311
translate german c21s004_AmandaCoffee_2612622a:

    # mc "*Risa* Tengo que ser una bestia besando."
    mc "*lacht* Ich muss ein Küssgenie sein."

# game/scripts/c21/c21.rpy:2313
translate german c21s004_AmandaCoffee_a565ca82:

    # ama "*Risa* No voy a decir ni que sí ni que no. No quiero alimentar tu ego más de lo que ya lo está."
    ama "*Lacht* Ich werde weder Ja noch Nein sagen. Ich will dein Ego nicht noch mehr aufpolieren, als es ohnehin schon ist."

# game/scripts/c21/c21.rpy:2315
translate german c21s004_AmandaCoffee_6c486a00:

    # "Te da un rápido beso."
    "Er gibt dir einen schnellen Kuss."

# game/scripts/c21/c21.rpy:2316
translate german c21s004_AmandaCoffee_69881554:

    # ama "Siéntate donde estabas, voy al lavabo un momento y seguimos con la reunión."
    ama "Setzen Sie sich wieder hin, wo Sie waren, ich gehe kurz auf die Toilette und dann setzen wir die Besprechung fort."

# game/scripts/c21/c21.rpy:2317
translate german c21s004_AmandaCoffee_3e89e8ed:

    # mc "¿No quieres que me siente a tu lado?"
    mc "Möchtest du nicht, dass ich mich neben dich setze?"

# game/scripts/c21/c21.rpy:2318
translate german c21s004_AmandaCoffee_3d50c3d3:

    # ama "Sí, pero si lo haces no vamos a poder acabar con lo que hemos venido a hacer. Si hay una mesa entre los dos puedo mantener la cabeza centrada en la reunión."
    ama "Ja, aber dann können wir unsere Aufgabe nicht mehr erledigen. Wenn ein Tisch zwischen uns steht, kann ich mich besser auf das Meeting konzentrieren."

# game/scripts/c21/c21.rpy:2320
translate german c21s004_AmandaCoffee_412cc044:

    # ama "Más o menos."
    ama "Mehr oder weniger."

# game/scripts/c21/c21.rpy:2323
translate german c21s004_AmandaCoffee_23c48176:

    # ama "Espera... Has dicho que quieres que forme parte de la familia, pero no has dicho nada de nosotros."
    ama "Moment mal... Du hast gesagt, du willst, dass ich zur Familie gehöre, aber du hast nichts über uns gesagt."

# game/scripts/c21/c21.rpy:2324
translate german c21s004_AmandaCoffee_3289a10b:

    # ama "¿Significa eso que tú y yo...?"
    ama "Heißt das, dass du und ich...?"

# game/scripts/c21/c21.rpy:2325
translate german c21s004_AmandaCoffee_d27eeaf8:

    # mc "Significa que quiero que formes parte de nuestras vidas. Me caes muy bien, [ama], pero a diferencia de ti, te conozco tan solo desde hace unos días."
    mc "Es bedeutet, dass ich möchte, dass du ein Teil unseres Lebens bist. Ich mag dich sehr, [ama], aber im Gegensatz zu dir kenne ich dich erst seit ein paar Tagen."

# game/scripts/c21/c21.rpy:2327
translate german c21s004_AmandaCoffee_eb151802:

    # mc "No he tenido tiempo de desarrollar sentimientos por ti, y... no creo que lo haga en el futuro. Al menos no como tú quieres."
    mc "Ich hatte keine Zeit, Gefühle für dich zu entwickeln, und... ich glaube auch nicht, dass ich das in Zukunft tun werde. Zumindest nicht so, wie du es dir wünschst."

# game/scripts/c21/c21.rpy:2328
translate german c21s004_AmandaCoffee_c6d41377:

    # mc "Despiertas en mí un sentimiento de protección, pero no uno romántico."
    mc "Du weckst in mir ein Gefühl des Schutzes, aber kein romantisches."

# game/scripts/c21/c21.rpy:2329
translate german c21s004_AmandaCoffee_59e887db:

    # mc "No quiero darte falsas esperanzas. Creo que tengo que ser sincero sobre eso."
    mc "Ich möchte dir keine falschen Hoffnungen machen. Ich glaube, ich muss diesbezüglich ehrlich sein."

# game/scripts/c21/c21.rpy:2330
translate german c21s004_AmandaCoffee_a242232e:

    # mc "Que [eva] y tú hayáis tardado tanto en resolver vuestras diferencias, me ha dado tiempo a mí para examinar lo que siento hacia vosotras."
    mc "Die Tatsache, dass [eva] und Sie so lange gebraucht haben, um Ihre Differenzen beizulegen, hat mir Zeit gegeben, meine Gefühle Ihnen gegenüber zu hinterfragen."

# game/scripts/c21/c21.rpy:2332
translate german c21s004_AmandaCoffee_f63e1d87:

    # ama "Lo entiendo y te agradezco la sinceridad..."
    ama "Ich verstehe und schätze Ihre Ehrlichkeit..."

# game/scripts/c21/c21.rpy:2333
translate german c21s004_AmandaCoffee_6c772ee3:

    # ama "¿Te pasa lo mismo con [eva]? No sé si te va a arrancar la cabeza si le dices algo así."
    ama "Hast du dasselbe Problem mit [eva]? Ich weiß nicht, ob er dir den Kopf abreißen wird, wenn du so etwas zu ihm sagst."

# game/scripts/c21/c21.rpy:2334
translate german c21s004_AmandaCoffee_f87257ab_1:

    # mc "Eso es algo que [eva] y yo tenemos que hablar. A solas. Los dos. Independientemente de si quiero estar con ella o no."
    mc "Das ist etwas, worüber [eva] und ich reden müssen. Unter vier Augen. Nur wir beide. Unabhängig davon, ob ich mit ihr zusammen sein will oder nicht."

# game/scripts/c21/c21.rpy:2336
translate german c21s004_AmandaCoffee_5d7ed353:

    # ama "Tienes razón, no debería inmiscuirme."
    ama "Du hast recht, ich sollte mich da nicht einmischen."

# game/scripts/c21/c21.rpy:2337
translate german c21s004_AmandaCoffee_4a3807a0:

    # ama "Dame un segundo, voy al lavabo."
    ama "Einen Moment bitte, ich gehe kurz auf die Toilette."

# game/scripts/c21/c21.rpy:2338
translate german c21s004_AmandaCoffee_3c72afc8:

    # mc "El tiempo que necesites."
    mc "Alle Zeit, die Sie brauchen."

# game/scripts/c21/c21.rpy:2340
translate german c21s004_AmandaCoffee_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c21/c21.rpy:2341
translate german c21s004_AmandaCoffee_11e8caa8:

    # ama "Volviendo al tema de los XY..."
    ama "Um auf das Thema XY zurückzukommen..."

# game/scripts/c21/c21.rpy:2342
translate german c21s004_AmandaCoffee_2bc208ce:

    # mc "¿No quieres hablar de lo que acaba de pasar?"
    mc "Möchtest du nicht über das sprechen, was gerade passiert ist?"

# game/scripts/c21/c21.rpy:2344
translate german c21s004_AmandaCoffee_2e791067:

    # ama "Prefiero no hacerlo ahora. Tenemos que acabar esto y tengo que relevar a [eva]."
    ama "Ich würde es lieber jetzt nicht tun. Wir müssen das hier beenden, und ich muss [eva] ablösen."

# game/scripts/c21/c21.rpy:2346
translate german c21s004_AmandaCoffee_434b87cf:

    # ama "Si empiezo a hablar de lo que ha pasado, no vamos a parar y voy a pasarme horas besándote."
    ama "Wenn ich erst einmal anfange, über das Geschehene zu sprechen, hören wir nicht mehr auf und ich werde dich stundenlang küssen."

# game/scripts/c21/c21.rpy:2347
translate german c21s004_AmandaCoffee_38c8e290:

    # ama "Tendremos mucho tiempo para hablar cuando llegue el momento. Ahora tenemos una reunión que terminar."
    ama "Wir werden zu gegebener Zeit ausreichend Zeit zum Reden haben. Jetzt müssen wir aber erst einmal unser Meeting beenden."

# game/scripts/c21/c21.rpy:2349
translate german c21s004_AmandaCoffee_13d3336d:

    # ama "No tiene sentido hablarlo. Sentimos cosas diferentes por el otro, pero ni quiero ni puedo forzarte a sentir lo que siento yo."
    ama "Es hat keinen Sinn, darüber zu reden. Wir empfinden unterschiedliche Dinge füreinander, aber ich will dich weder zwingen noch kann ich dich dazu bringen, das zu empfinden, was ich empfinde."

# game/scripts/c21/c21.rpy:2350
translate german c21s004_AmandaCoffee_815b5864:

    # ama "No me debes ninguna explicación ni yo la quiero, pero tenemos una reunión que terminar."
    ama "Sie sind mir keine Erklärung schuldig, und ich will auch keine, aber wir müssen unser Meeting beenden."

# game/scripts/c21/c21.rpy:2351
translate german c21s004_AmandaCoffee_3aff1176:

    # mc "De acuerdo, sigamos entonces."
    mc "Okay, dann machen wir weiter."

# game/scripts/c21/c21.rpy:2353
translate german c21s004_AmandaCoffee_87d6d455:

    # ama "Contamos con 109 efectivos XY operativos ahora mismo. Aparte de eso hay 19 inoperativos."
    ama "Wir haben derzeit 109 einsatzfähige XY-Mitarbeiter. Darüber hinaus gibt es 19 nicht einsatzfähige Mitarbeiter."

# game/scripts/c21/c21.rpy:2354
translate german c21s004_AmandaCoffee_b23bbd8c:

    # ama "En los próximos diez años, 461 más completarán su crecimiento y formación."
    ama "In den nächsten zehn Jahren werden weitere 461 ihre Ausbildung abschließen."

# game/scripts/c21/c21.rpy:2355
translate german c21s004_AmandaCoffee_29bf8ed0:

    # mcp "(Acaba de aparecer la [ama] fría y profesional para separarse emocionalmente de lo que acaba de pasar.)"
    mcp "(Ihr kühles, professionelles Auftreten zeugt davon, dass sie sich emotional von dem Geschehenen distanziert hat.)"

# game/scripts/c21/c21.rpy:2357
translate german c21s004_AmandaCoffee_aa1e9894:

    # ama "Como ya te he dicho, si les damos opciones, no todos van a querer abandonar las Operaciones Especiales."
    ama "Wie ich Ihnen bereits gesagt habe, werden nicht alle die Spezialeinheiten verlassen wollen, wenn wir ihnen Alternativen bieten."

# game/scripts/c21/c21.rpy:2358
translate german c21s004_AmandaCoffee_b86fa212:

    # ama "Pero podremos reubicar a la mayoría en operaciones de Apoyo o en seguridad de la base, especialmente a los nuevos."
    ama "Aber wir werden in der Lage sein, die meisten von ihnen in den Bereich Unterstützungsoperationen oder Basissicherheit zu versetzen, insbesondere die neuen."

# game/scripts/c21/c21.rpy:2359
translate german c21s004_AmandaCoffee_e578e9b6:

    # mc "Creo que tenemos que darles la opción de decidir. Tienen tanto derecho como tú o como yo."
    mc "Ich denke, wir müssen ihnen die Möglichkeit geben, selbst zu entscheiden. Sie haben genauso viel Recht dazu wie du oder ich."

# game/scripts/c21/c21.rpy:2360
translate german c21s004_AmandaCoffee_a917d171:

    # mc "Incluso si quieren desvincularse totalmente de NTR deberíamos aceptarlo."
    mc "Selbst wenn sie sich komplett von NTR distanzieren wollen, sollten wir das akzeptieren."

# game/scripts/c21/c21.rpy:2361
translate german c21s004_AmandaCoffee_843a0f18:

    # mc "¿Cuánta seguridad necesitamos en la base?"
    mc "Wie viel Sicherheitsaufwand benötigen wir auf dem Stützpunkt?"

# game/scripts/c21/c21.rpy:2363
translate german c21s004_AmandaCoffee_7824fc7a:

    # ama "Ahora mismo hay 36 en tres turnos. Casi todos de las Series J y K, la última y la próxima en ser considerada operativa. Les sirve como entrenamiento."
    ama "Aktuell sind 36 Maschinen in drei Schichten im Einsatz. Fast alle gehören zur J- und K-Serie, den neuesten und als nächstes einsatzbereiten Flugzeugtypen. Die Übung dient ihnen als Schulung."

# game/scripts/c21/c21.rpy:2365
translate german c21s004_AmandaCoffee_c2659771:

    # ama "Aquí puedes ver las estadísticas por series. De la K a la T todavía están en crecimiento y formación."
    ama "Hier sehen Sie die Statistiken nach Serien. Die Serien K bis T befinden sich noch in der Entwicklung und wachsen stetig."

# game/scripts/c21/c21.rpy:2366
translate german c21s004_AmandaCoffee_42975966:

    # mc "Hay mucho rojo, incluso entre las series que no han entrado en servicio. Demasiado rojo."
    mc "Es gibt viel zu viel Rot, sogar bei den Serien, die noch nicht im Einsatz sind. Zu viel Rot."

# game/scripts/c21/c21.rpy:2367
translate german c21s004_AmandaCoffee_deb35d10:

    # ama "Alrededor del 7%% son bajas durante el entrenamiento, como Fiona. El resto son bajas operativas. Sumadas al entrenamiento, alrededor del 32%% son bajas."
    ama "Etwa 7%% der Opfer, wie Fiona, verunglücken während Übungen. Die übrigen Opfer sind Einsatzopfer. Einschließlich der Übungsopfer beläuft sich die Gesamtzahl der Opfer auf etwa 32%%."

# game/scripts/c21/c21.rpy:2368
translate german c21s004_AmandaCoffee_d26ea785:

    # mc "Si seguimos con el entrenamiento, hay que cambiar los métodos. No quiero que niños pequeños mueran jugando con explosivos."
    mc "Wenn wir diese Ausbildung fortsetzen, müssen wir die Methoden ändern. Ich will nicht, dass kleine Kinder beim Spielen mit Sprengstoff sterben."

# game/scripts/c21/c21.rpy:2369
translate german c21s004_AmandaCoffee_5f5b1891:

    # mc "Y me da lo mismo que tengan cuerpos de adultos. No quiero. Punto."
    mc "Und es ist mir egal, ob sie erwachsene Körper haben. Ich will sie nicht. Punkt."

# game/scripts/c21/c21.rpy:2371
translate german c21s004_AmandaCoffee_a5965deb:

    # ama "Me sorprende la empatía que tienes hacia gente que no conoces."
    ama "Ich bin überrascht von dem Einfühlungsvermögen, das du gegenüber Menschen hast, die du nicht kennst."

# game/scripts/c21/c21.rpy:2372
translate german c21s004_AmandaCoffee_dede75a0:

    # mc "Os conozco a [eva] y a ti. Y a [aar], aunque sea poco. Tengo suficiente."
    mc "Ich kenne dich und [eva]. Und [aar], wenn auch nur ein wenig. Ich habe genug."

# game/scripts/c21/c21.rpy:2373
translate german c21s004_AmandaCoffee_d91b722c:

    # mc "¿Quién se encarga del entrenamiento ahora mismo?"
    mc "Wer ist momentan für das Training zuständig?"

# game/scripts/c21/c21.rpy:2375
translate german c21s004_AmandaCoffee_949531d5:

    # ama "Los C y los D, principalmente. Los entrenan como fueron entrenados ellos. Como fuimos entrenadas nosotras."
    ama "Hauptsächlich die Gruppen C und D. Sie werden so ausgebildet, wie sie selbst ausgebildet wurden. So, wie wir ausgebildet wurden."

# game/scripts/c21/c21.rpy:2376
translate german c21s004_AmandaCoffee_a4bf90de:

    # mc "Lo primero que quiero hacer cuando llegue a Aruba, entonces, es reunirme con los C y los D. Y quiero sus nombres. No quiero pensar en ellos como letras."
    mc "Das Erste, was ich tun möchte, wenn ich in Aruba ankomme, ist, die C's und die D's kennenzulernen. Und ich möchte ihre Namen wissen. Ich möchte sie nicht nur als Buchstaben sehen."

# game/scripts/c21/c21.rpy:2378
translate german c21s004_AmandaCoffee_c07cbb22:

    # "Pasáis los siguientes minutos haciendo planes y números, modificando las ideas de [ama], ampliando la información que tienes sobre la empresa. Tomando más cafés."
    "Die nächsten Minuten verbringst du damit, Pläne zu schmieden und Zahlen zu analysieren, die Ideen von [ama] zu überarbeiten und dein Wissen über das Unternehmen zu erweitern. Und du trinkst noch mehr Kaffee."

# game/scripts/c21/c21.rpy:2379
translate german c21s004_AmandaCoffee_337e57f0:

    # "Al cabo casi una hora, suena una alarma en el móvil de [ama]."
    "Nach fast einer Stunde ertönt ein Alarm auf dem Handy von [ama]."

# game/scripts/c21/c21.rpy:2381
translate german c21s004_AmandaCoffee_c36b8809:

    # ama "Voy a tener que irme. Me toca relevar a [eva]. Lleva casi 30 horas sin dormir."
    ama "Ich muss jetzt gehen. Ich bin an der Reihe, [eva] abzulösen. Er ist schon fast 30 Stunden wach."

# game/scripts/c21/c21.rpy:2382
translate german c21s004_AmandaCoffee_7a628fb8:

    # ama "Recopilaré todos los datos y te los mando. Supongo que en un par de días los tendré hechos."
    ama "Ich werde alle Daten zusammentragen und Ihnen zusenden. Ich gehe davon aus, dass ich damit in ein paar Tagen fertig bin."

# game/scripts/c21/c21.rpy:2383
translate german c21s004_AmandaCoffee_7b2c571d:

    # mc "Genial. ¿Vais a venir a casa a cenar esta noche?"
    mc "Super. Kommst du heute Abend zum Abendessen vorbei?"

# game/scripts/c21/c21.rpy:2385
translate german c21s004_AmandaCoffee_45b1f444:

    # ama "Sí, hemos ido a comer, pero no estabas."
    ama "Ja, wir sind essen gegangen, aber du warst nicht dabei."

# game/scripts/c21/c21.rpy:2387
translate german c21s004_AmandaCoffee_250366b8:

    # mc "Ya sabes que había quedado para comer con [kia]."
    mc "Du weißt ja, dass ich mich mit [kia] zum Mittagessen verabredet hatte."

# game/scripts/c21/c21.rpy:2389
translate german c21s004_AmandaCoffee_debde37a:

    # mc "Ya sabes que tenía que llevar a [meg] a la estación de autobuses."
    mc "Du weißt ja, dass ich [meg] zum Busbahnhof nehmen musste."

# game/scripts/c21/c21.rpy:2390
translate german c21s004_AmandaCoffee_a7810a76:

    # ama "Lo sé..."
    ama "Ich weiß..."

# game/scripts/c21/c21.rpy:2392
translate german c21s004_AmandaCoffee_97d1780f:

    # ama "Entonces te veo esta noche."
    ama "Dann sehen wir uns heute Abend."

# game/scripts/c21/c21.rpy:2395
translate german c21s004_AmandaCoffee_f80d270f:

    # "[ama] se vuelve a lanzar a tus labios, esta vez sin el ansia del beso anterior. Sabe que vendrán más."
    "[ama] Er stürzt sich erneut auf deine Lippen, diesmal ohne die Gier des vorherigen Kusses. Er weiß, dass noch mehr folgen wird."

# game/scripts/c21/c21.rpy:2398
translate german c21s004_AmandaCoffee_b7bb21ab:

    # "Os dais un abrazo de despedida. Tácitamente, sin necesidad de palabras, habéis decidido que los besos de despedida están de más ahora que habéis aclarado que no estaréis juntos."
    "Ihr umarmt euch zum Abschied. Stillschweigend, ohne Worte, habt ihr beschlossen, dass Abschiedsküsse überflüssig sind, nachdem ihr klargestellt habt, dass ihr nicht mehr zusammen sein werdet."

# game/scripts/c21/c21.rpy:2400
translate german c21s004_AmandaCoffee_705a5ed1:

    # ama "Hasta la noche, [mc]."
    ama "Bis heute Abend, [mc]."

# game/scripts/c21/c21.rpy:2402
translate german c21s004_AmandaCoffee_70d3a368:

    # mc "Hasta la noche, [ama]."
    mc "Bis heute Abend, [ama]."

# game/scripts/c21/c21.rpy:2445
translate german c21s005_DebRun_f640654f:

    # "Al llegar a casa te encuentras con [deb.nick] en la puerta."
    "Wenn du nach Hause kommst, findest du [deb.nick] an der Tür."

# game/scripts/c21/c21.rpy:2447
translate german c21s005_DebRun_d207482f:

    # deb "Buenas tardes, [mc]."
    deb "Guten Tag, [mc]."

# game/scripts/c21/c21.rpy:2450
translate german c21s005_DebRun_b822a602:

    # mc "Buenas tardes, cielo."
    mc "Guten Tag, Liebling."

# game/scripts/c21/c21.rpy:2452
translate german c21s005_DebRun_52bcb279:

    # mc "Buenas tardes, [deb.nick]."
    mc "Guten Tag, [deb.nick]."

# game/scripts/c21/c21.rpy:2453
translate german c21s005_DebRun_b6945ea0:

    # mc "¿Sales a correr o vuelves ahora?"
    mc "Gehst du joggen oder kommst du jetzt zurück?"

# game/scripts/c21/c21.rpy:2455
translate german c21s005_DebRun_d567ddad:

    # deb "Salgo ahora. Iba a ir al lago. [kim] y [kat] han salido hace un rato."
    deb "Ich gehe jetzt. Ich wollte zum See fahren. [kim] und [kat] sind schon vor einer Weile gegangen."

# game/scripts/c21/c21.rpy:2456
translate german c21s005_DebRun_54fd321b:

    # mc "Si me das cinco minutos para cambiarme, te acompaño."
    mc "Wenn Sie mir fünf Minuten zum Umziehen geben, komme ich mit."

# game/scripts/c21/c21.rpy:2457
translate german c21s005_DebRun_289bde06:

    # deb "¡Genial! Te espero en la piscina. [lis] está allí."
    deb "Super! Ich warte am Pool auf dich. [lis] ist dort."

# game/scripts/c21/c21.rpy:2460
translate german c21s005_DebRun_bbcbf13f:

    # mc "Hasta ahora."
    mc "Bisher."

# game/scripts/c21/c21.rpy:2462
translate german c21s005_DebRun_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c21/c21.rpy:2463
translate german c21s005_DebRun_c68b29c7:

    # mc "Hola, [lis]."
    mc "Hallo, [lis]."

# game/scripts/c21/c21.rpy:2464
translate german c21s005_DebRun_1e28d7f9:

    # lis "Hola, [mc]. No contéis conmigo para ir a correr. [deb.nick] estaba intentando convencerme."
    lis "Hallo, [mc]. Ich bin nicht dabei. [deb.nick] versuchte mich zu überzeugen."

# game/scripts/c21/c21.rpy:2474
translate german c21s005_DebRun_19916109:

    # deb "[lis] prefiere quedarse leyendo y tomando el sol. *Risa*"
    deb "[lis] bleibt am liebsten zu Hause, liest und sonnt sich. *Lacht*"

# game/scripts/c21/c21.rpy:2475
translate german c21s005_DebRun_0981270f:

    # mc "¿Qué estás leyendo?"
    mc "Was liest du gerade?"

# game/scripts/c21/c21.rpy:2477
translate german c21s005_DebRun_be0e08a0:

    # lis "Teoría política. Alguien me hizo pensar el otro día en el Jazz Corner y lo he cogido de la biblioteca de la universidad."
    lis "Politische Theorie. Jemand hat mich neulich an Jazz Corner erinnert, und ich habe es mir aus der Universitätsbibliothek ausgeliehen."

# game/scripts/c21/c21.rpy:2478
translate german c21s005_DebRun_ba8ee9ad:

    # mc "Siempre es bueno ampliar horizontes."
    mc "Es ist immer gut, seinen Horizont zu erweitern."

# game/scripts/c21/c21.rpy:2479
translate german c21s005_DebRun_53c92852:

    # lis "No sé si me llevará a algo, pero al menos estoy leyendo información de la que no sabía nada."
    lis "Ich weiß nicht, ob mich das irgendwohin führen wird, aber zumindest lese ich Informationen, von denen ich vorher nichts wusste."

# game/scripts/c21/c21.rpy:2481
translate german c21s005_DebRun_4d359ce3:

    # deb "[lis] for President! *Risa* Nuestro ejército sería el mejor vestido del mundo. ¡Giovanni Armani para todos!"
    deb "Für den Präsidenten! *Gelächter* Unsere Armee wäre die bestgekleidete der Welt. Giovanni Armani für alle!"

# game/scripts/c21/c21.rpy:2482
translate german c21s005_DebRun_9cfe95ac:

    # mc "*Risa* Puede sonar a broma, pero posiblemente la votara dependiendo de su programa."
    mc "*lacht* Das klingt vielleicht wie ein Witz, aber je nach ihrem Programm würde ich sie vielleicht wählen."

# game/scripts/c21/c21.rpy:2484
translate german c21s005_DebRun_0cf4a507:

    # lis "*Risa* Mi hermana no confiaría en mí ni como delegada de clase."
    lis "*lacht* Meine Schwester würde mir nicht einmal als Klassensprecherin vertrauen."

# game/scripts/c21/c21.rpy:2485
translate german c21s005_DebRun_e5c6e98f:

    # lis "Iros a correr antes de que se os haga más tarde. [kim] y [kat] ya deben estar allí."
    lis "Geh noch schnell laufen, bevor es zu spät ist. [kim] und [kat] sollten schon da sein."

# game/scripts/c21/c21.rpy:2486
translate german c21s005_DebRun_59f6c03a:

    # mc "Hasta luego, [lis]."
    mc "Bis später, [lis]."

# game/scripts/c21/c21.rpy:2488
translate german c21s005_DebRun_f597b9c6:

    # mc "Me acabo de dar cuenta de que no llevas mochila hoy. ¿No llevas toalla para bañarte en el lago después de subir corriendo?"
    mc "Mir ist gerade aufgefallen, dass du heute keinen Rucksack dabei hast. Nimmst du kein Handtuch mit, um nach dem Anlauf im See zu schwimmen?"

# game/scripts/c21/c21.rpy:2489
translate german c21s005_DebRun_772928e7:

    # mc "Yo la he cogido, y también el bañador."
    mc "Ich habe es genommen, und den Badeanzug auch."

# game/scripts/c21/c21.rpy:2490
translate german c21s005_DebRun_3057bb86:

    # deb "Mi toalla y el bikini van camino del lago. Lo hemos metido todo en la mochila de [kat] para que suba hasta allí con más peso."
    deb "Mein Handtuch und mein Bikini sind auf dem Weg zum See. Wir haben alles in [kat]s Rucksack gepackt, deshalb ist er schwerer zu tragen."

# game/scripts/c21/c21.rpy:2491
translate german c21s005_DebRun_bcc02742:

    # deb "Si la hacemos correr con la mochila, con algo de peso, quemará más azúcar."
    deb "Wenn wir sie mit dem Rucksack und etwas Gewicht laufen lassen, verbrennt sie mehr Zucker."

# game/scripts/c21/c21.rpy:2492
translate german c21s005_DebRun_82f306a3:

    # mc "La estáis ayudando mucho por lo que me dijo el otro día."
    mc "Du hilfst ihr sehr, wie sie mir neulich erzählt hat."

# game/scripts/c21/c21.rpy:2494
translate german c21s005_DebRun_9ea6c534:

    # deb "[kim] se ocupa de hacerle correr, y yo de hacerle nadar."
    deb "[kim] Er kümmert sich darum, dass er rennt, und ich kümmere mich darum, dass er schwimmt."

# game/scripts/c21/c21.rpy:2496
translate german c21s005_DebRun_a09924a6:

    # deb "Si alguien se ocupara de hacerle comer sano, podríamos hacer una atleta de ella."
    deb "Wenn sich jemand die Mühe machen würde, sie zu einer gesunden Ernährung zu bewegen, könnten wir aus ihr eine Athletin machen."

# game/scripts/c21/c21.rpy:2498
translate german c21s005_DebRun_44db888a:

    # deb "Y como [mar] se ocupa de que coma sano, acabará perdiendo mucho peso en los próximos meses."
    deb "Und da [mar] darauf achtet, sich gesund zu ernähren, wird er in den kommenden Monaten viel Gewicht verlieren."

# game/scripts/c21/c21.rpy:2499
translate german c21s005_DebRun_582d7184:

    # mc "No sé si me puedo imaginar a una [kat] atlética. *Risa* A menos que hayan hecho olímpico el levantamiento de pizza."
    mc "Ich weiß nicht, ob ich mir einen sportlichen [kat] vorstellen kann. *lacht* Es sei denn, sie haben Pizzaheben zu einer olympischen Disziplin gemacht."

# game/scripts/c21/c21.rpy:2501
translate german c21s005_DebRun_f6cc8381:

    # deb "Si lo hicieran, Tía [bet] seguro que se llevaba una medalla. *Risa*"
    deb "Wenn sie das täten, würde Tante [bet] ganz bestimmt eine Medaille bekommen. *lacht*"

# game/scripts/c21/c21.rpy:2503
translate german c21s005_DebRun_bc003bb0:

    # deb "Y la pobre [kat] se moriría de envidia. Lleva casi una semana comiendo más sano. Pero aún mira las pizzas de Tía [bet] con envidia."
    deb "Und die arme Tante wäre vor Neid grün im Gesicht. Sie ernährt sich jetzt schon fast eine Woche gesünder. Aber sie schaut immer noch neidisch auf Tantes Pizzen."

# game/scripts/c21/c21.rpy:2505
translate german c21s005_DebRun_84821f04:

    # deb "[kat] está comiendo algo más sano, pero todavía no es capaz de resistirse a la pizza, o a los croissants... o a los donuts."
    deb "[kat] isst etwas Gesünderes, kann aber trotzdem Pizza, Croissants oder Donuts nicht widerstehen."

# game/scripts/c21/c21.rpy:2506
translate german c21s005_DebRun_1170b2ed:

    # mc "Resistirse a la pizza es muy duro. *Risa*"
    mc "Pizza zu widerstehen ist echt schwer. *lacht*"

# game/scripts/c21/c21.rpy:2509
translate german c21s005_DebRun_e72c2fee:

    # deb "¿Y tú? ¿Vas a unirte a alguno de nuestras sesiones de deporte?"
    deb "Und du? Wirst du an einer unserer Sporteinheiten teilnehmen?"

# game/scripts/c21/c21.rpy:2510
translate german c21s005_DebRun_6349c9be:

    # mc "Me gustaría hacerlo más regularmente, pero es casi imposible. Cuando no es una cosa es otra la que me mantiene ocupado."
    mc "Ich würde es gern regelmäßiger tun, aber es ist fast unmöglich. Wenn ich nicht gerade das eine mache, hält mich schon wieder etwas anderes auf Trab."

# game/scripts/c21/c21.rpy:2511
translate german c21s005_DebRun_230064bf:

    # mc "Pero ahora estoy aquí, con lo que podemos contar esto como unirme, ¿no?"
    mc "Aber jetzt bin ich hier, also können wir das als Beitritt werten, oder?"

# game/scripts/c21/c21.rpy:2512
translate german c21s005_DebRun_7413b16b:

    # deb "Sí, pero estoy segura de que todo el mundo te daría la bienvenida si te unieras a las sesiones de yoga."
    deb "Ja, aber ich bin mir sicher, dass dich alle herzlich willkommen heißen würden, wenn du an den Yoga-Stunden teilnehmen würdest."

# game/scripts/c21/c21.rpy:2513
translate german c21s005_DebRun_ce3facd8:

    # mc "*Risa* Me uní una vez, y no soy demasiado flexible. Fue divertido y hacía mucho que no salía a la terraza."
    mc "*Lacht* Ich war einmal dabei, und ich bin nicht besonders gelenkig. Es hat Spaß gemacht, und es war schon lange her, dass ich auf der Terrasse war."

# game/scripts/c21/c21.rpy:2514
translate german c21s005_DebRun_11530359:

    # deb "Ahora lo hacemos en la piscina. La terraza estaba demasiado atestada en cuanto nos unimos [kim], [lis], Tía [bet], y yo."
    deb "Jetzt machen wir es im Pool. Die Terrasse war schon zu voll, als [kim], [lis], Tante [bet] und ich dazukamen."

# game/scripts/c21/c21.rpy:2515
translate german c21s005_DebRun_8d84308a:

    # mc "Quizás un día me una, si me levanto pronto y tengo ganas de que os riais de mí."
    mc "Vielleicht mache ich ja eines Tages mit, wenn ich früh aufwache und Lust habe, dich zum Lachen zu bringen."

# game/scripts/c21/c21.rpy:2518
translate german c21s005_DebRun_d216ebda:

    # mc "¿Pasa algo? ¿Por qué te paras? ¿Te has hecho daño?"
    mc "Ist etwas nicht in Ordnung? Warum halten Sie an? Sind Sie verletzt?"

# game/scripts/c21/c21.rpy:2519
translate german c21s005_DebRun_d6dc7b98:

    # deb "No es eso... estamos a punto de llegar, y... quería besarte antes de hacerlo. No sé si me atreveré delante de las chicas."
    deb "Nein, darum geht es nicht... wir sind fast soweit, und... ich wollte dich vorher noch küssen. Ich weiß nicht, ob ich mich traue, das vor den Mädchen zu tun."

# game/scripts/c21/c21.rpy:2520
translate german c21s005_DebRun_f372944f:

    # mc "Saben que estamos juntos, con lo que no debería importarles."
    mc "Sie wissen, dass wir zusammen sind, also sollte es ihnen egal sein."

# game/scripts/c21/c21.rpy:2521
translate german c21s005_DebRun_ceb5a9bd:

    # mc "Pero nunca voy a rechazar un beso tuyo, aunque sigan siendo a escondidas. Ven aquí abajo."
    mc "Aber ich werde dir niemals einen Kuss verweigern, selbst wenn er noch geheim ist. Komm herunter."

# game/scripts/c21/c21.rpy:2523
translate german c21s005_DebRun_a6d86538:

    # "Los labios de [deb.nick] recorren los tuyos con tranquilidad. Su lengua es más ansiosa recorriendo tu boca."
    "[deb.nick]s Lippen umspielen sanft deine. Seine Zunge ist umso begieriger, als sie deinen Mund erkundet."

# game/scripts/c21/c21.rpy:2524
translate german c21s005_DebRun_bdfdc7da:

    # "Es una lástima que, debido a su timidez, no vaya a repetirlo una vez lleguéis al lago."
    "Schade, dass er es aufgrund seiner Schüchternheit nicht wiederholt, sobald man am See ist."

# game/scripts/c21/c21.rpy:2526
translate german c21s005_DebRun_7e5c740b:

    # deb "Besarte se ha convertido en mi vicio favorito..."
    deb "Dich zu küssen ist zu meiner liebsten Laster geworden..."

# game/scripts/c21/c21.rpy:2527
translate german c21s005_DebRun_21bcf63e:

    # mc "*Risa* Yo creía que eras una chica sin vicios, [deb.nick] Selden."
    mc "*Lacht* Ich dachte, du wärst ein Mädchen ohne Laster, [deb.nick] Selden."

# game/scripts/c21/c21.rpy:2529
translate german c21s005_DebRun_af65446e:

    # deb "Mis vicios sólo son con cosas sanas. *Risa*"
    deb "Meine einzigen Laster sind gesunde Dinge. *lacht*"

# game/scripts/c21/c21.rpy:2530
translate german c21s005_DebRun_9b57f319:

    # deb "Vamos antes de que piensen que me ha pasado algo. No saben que he tenido que esperar a que te cambiaras."
    deb "Lass uns gehen, bevor sie denken, mir sei etwas zugestoßen. Sie wissen ja nicht, dass ich warten musste, bis du dich umgezogen hast."

# game/scripts/c21/c21.rpy:2531
translate german c21s005_DebRun_63cd8ebd:

    # mc "Vamos."
    mc "Aufleuchten."

# game/scripts/c21/c21.rpy:2533
translate german c21s005_DebRun_41d397cb_1:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c21/c21.rpy:2534
translate german c21s005_DebRun_31fa08de:

    # deb "[kat] ha subido más rápido de lo que pensaba. Me imaginaba que las pillaríamos por el camino."
    deb "[kat] ist schneller gestiegen, als ich dachte. Ich dachte, wir würden sie unterwegs einholen."

# game/scripts/c21/c21.rpy:2535
translate german c21s005_DebRun_00d7fa27:

    # mc "Es su primera visita al lago, ¿verdad?"
    mc "Das ist Ihr erster Besuch am See, nicht wahr?"

# game/scripts/c21/c21.rpy:2537
translate german c21s005_DebRun_61721cdd:

    # deb "Sí, desde que le hablaste de él en el Jazz Corner quería subir aquí."
    deb "Ja, seitdem du ihm im Jazz Corner davon erzählt hast, wollte er unbedingt hierherkommen."

# game/scripts/c21/c21.rpy:2538
translate german c21s005_DebRun_41ce4059:

    # deb "Hoy [kim] ha pensado que, como no hacía demasiado calor, sería un buen día para hacerlo."
    deb "Heute dachte [kim], da es nicht zu heiß sei, wäre es ein guter Tag dafür."

# game/scripts/c21/c21.rpy:2539
translate german c21s005_DebRun_07096da6:

    # mc "Ha sido una buena idea. ¿Vamos antes de que se haga más tarde? Aún nos tenemos que cambiar."
    mc "Das war eine gute Idee. Sollen wir gehen, bevor es zu spät ist? Wir müssen uns noch verändern."

# game/scripts/c21/c21.rpy:2541
translate german c21s005_DebRun_07cb8136:

    # deb "¡Vamos! Te echo una carrera."
    deb "Na los! Ich fordere dich zu einem Wettlauf heraus."

# game/scripts/c21/c21.rpy:2543
translate german c21s005_DebRun_0935a578:

    # "[deb.nick] sale disparada sin esperar tu respuesta. Corre como una gacela con esas larguísimas piernas."
    "[deb.nick] Sie rennt los, ohne deine Antwort abzuwarten. Mit ihren unglaublich langen Beinen rennt sie wie eine Gazelle."

# game/scripts/c21/c21.rpy:2544
translate german c21s005_DebRun_8c899cc0:

    # "Bajas trotando, sabes que eres incapaz de pillarla antes de que llegue al lago."
    "Du joggst los, wohl wissend, dass du sie nicht mehr einholen kannst, bevor sie den See erreicht."

# game/scripts/c21/c21.rpy:2545
translate german c21s005_DebRun_fba703fd:

    # "Cuando llegas, ella ya se ha metido tras los arbustos para cambiarse."
    "Als du ankommst, ist sie bereits hinter die Büsche gegangen, um sich umzuziehen."

# game/scripts/c21/c21.rpy:2547
translate german c21s005_DebRun_fa1760b5:

    # kat "¡Hola, [mc]! Veo que [deb.nick] te ha engañado de alguna forma para que subas hasta aquí. *Risa*"
    kat "Hallo, [mc]! Ich sehe, [deb.nick] hat dich irgendwie hierhergelockt. *Lacht*"

# game/scripts/c21/c21.rpy:2548
translate german c21s005_DebRun_88e41e44:

    # kim "Hola, [mc]."
    kim "Hallo, [mc]."

# game/scripts/c21/c21.rpy:2549
translate german c21s005_DebRun_8d6c7fa2:

    # mc "Hola, chicas. Fui yo quien les enseñó este lago, [kat]. Siempre me ha gustado mucho subir aquí."
    mc "Hallo Mädels. Ich war es, die euch diesen See gezeigt hat, [kat]. Ich bin immer wieder gerne hierher gekommen."

# game/scripts/c21/c21.rpy:2550
translate german c21s005_DebRun_0391cac9:

    # mc "Voy a cambiarme, ahora vuelvo."
    mc "Ich werde mich umziehen, bin gleich wieder da."

# game/scripts/c21/c21.rpy:2554
translate german c21s005_DebRun_fcd878b0:

    # mc "Ya estoy. ¿[deb.nick] no ha terminado de cambiarse?"
    mc "Ich bin da. [deb.nick] Bist du noch nicht fertig mit dem Umziehen?"

# game/scripts/c21/c21.rpy:2556
translate german c21s005_DebRun_3bb56ed8:

    # kim "No..."
    kim "NEIN..."

# game/scripts/c21/c21.rpy:2557
translate german c21s005_DebRun_54875bb4:

    # kat "Seguramente estará pensando qué bikini ponerse. Con lo que pesaba la mochila, debía llevar 100 o 200. Algunos de ellos hechos de plomo."
    kat "Sie überlegte wahrscheinlich gerade, welchen Bikini sie anziehen sollte. Angesichts des Gewichts ihres Rucksacks musste sie 100 oder 200 Stück dabei haben. Einige davon aus Blei."

# game/scripts/c21/c21.rpy:2559
translate german c21s005_DebRun_8f412537:

    # kim "¡Eres una exagerada! *Risa* La mochila no llevaba tantas cosas. Tres toallas, dos bikinis y tu bañador."
    kim "Du übertreibst! *lacht* Im Rucksack war gar nicht so viel drin. Drei Handtücher, zwei Bikinis und dein Badeanzug."

# game/scripts/c21/c21.rpy:2560
translate german c21s005_DebRun_22fb6f5c:

    # kim "Y el agua... y la crema solar..."
    kim "Und Wasser... und Sonnencreme..."

# game/scripts/c21/c21.rpy:2562
translate german c21s005_DebRun_71e361f8:

    # kat "Entonces es que la mochila está hecha de plomo. *Risa*"
    kat "Der Rucksack ist also aus Blei. *lacht*"

# game/scripts/c21/c21.rpy:2563
translate german c21s005_DebRun_333b2085:

    # mc "Con lo bien que te están entrenando estas chicas, no vas a tardar mucho en poder subir aquí sin darte cuenta de si la mochila pesa mucho."
    mc "Bei der guten Ausbildung durch diese Mädchen wird es nicht lange dauern, bis du hier hochklettern kannst, ohne zu merken, wie schwer dein Rucksack ist."

# game/scripts/c21/c21.rpy:2565
translate german c21s005_DebRun_0cdf3f59:

    # kim "Lo está haciendo muy bien. El primer día no fue capaz de correr más de unos centenares de metros."
    kim "Es geht ihm sehr gut. Am ersten Tag konnte er nicht mehr als ein paar hundert Meter laufen."

# game/scripts/c21/c21.rpy:2566
translate german c21s005_DebRun_b2ca06b1:

    # kim "El plan de entrenamiento de [deb.nick] está dando resultados."
    kim "Der Trainingsplan von [deb.nick] zahlt sich aus."

# game/scripts/c21/c21.rpy:2568
translate german c21s005_DebRun_bdaf874d:

    # kat "Un día nadar, otro correr, otro descanso. Mi vida es un infierno dos días de cada tres."
    kat "An einem Tag schwimme ich, am nächsten laufe ich, am übernächsten ruhe ich mich aus. Zwei von drei Tagen ist die Hölle auf Erden."

