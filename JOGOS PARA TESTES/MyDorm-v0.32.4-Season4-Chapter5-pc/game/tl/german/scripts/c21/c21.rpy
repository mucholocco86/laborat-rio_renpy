    # deb "*Risa* Hoy no. Tenemos que volver a casa y aún noto las piernas como si fueran de gelatina del primero."
    deb "*Lacht* Nicht heute. Wir müssen nach Hause und meine Beine fühlen sich immer noch wie Wackelpudding an vom ersten Mal."

# game/scripts/c21/c21.rpy:3222
translate german c21s005_DebLake_e4f65b8a:

    # deb "Lo que me ha sorprendido ha sido el sabor. Siempre he leído en internet que tenía un sabor desagradable, pero no es verdad."
    deb "Was mich überrascht hat, war der Geschmack. Ich hatte online immer gelesen, dass es unangenehm schmeckt, aber das stimmt nicht."

# game/scripts/c21/c21.rpy:3223
translate german c21s005_DebLake_792aeca5:

    # mc "Supongo que depende de cada persona."
    mc "Ich denke, das kommt auf die jeweilige Person an."

# game/scripts/c21/c21.rpy:3225
translate german c21s005_DebLake_5eb5f3c4:

    # deb "Aunque deja un regusto especialmente salado... voy a darme un baño y a enjuagarme en el lago."
    deb "Obwohl es einen besonders salzigen Nachgeschmack hinterlässt... werde ich baden und mich im See abspülen."

# game/scripts/c21/c21.rpy:3226
translate german c21s005_DebLake_f5b80ac7:

    # deb "No me atrevo a besarte con este sabor en la boca."
    deb "Mit diesem Geschmack im Mund wage ich es nicht, dich zu küssen."

# game/scripts/c21/c21.rpy:3227
translate german c21s005_DebLake_a8ab29d5:

    # mc "No hay problema, cielo."
    mc "Kein Problem, Schatz."

# game/scripts/c21/c21.rpy:3229
translate german c21s005_DebLake_fb164090:

    # deb "Ve vistiéndote mientras me bebo medio lago. Se está haciendo tarde y vamos a tener que bajar a casa."
    deb "Zieh dich schon mal an, während ich einen halben See austrinke. Es wird spät und wir müssen nach Hause."

# game/scripts/c21/c21.rpy:3230
translate german c21s005_DebLake_c5592cce:

    # mc "*Risa* A tus órdenes."
    mc "*Gelächter* Zu Ihren Diensten."

# game/scripts/c21/c21.rpy:3232
translate german c21s005_DebLake_cdb2baa8:

    # "[deb.nick] sale corriendo hacia el lago y se zambulle en el agua de un salto."
    "[deb.nick] rennt auf den See zu und springt mit einem Satz ins Wasser."

# game/scripts/c21/c21.rpy:3233
translate german c21s005_DebLake_0d5a7715:

    # "Es una visión preciosa."
    "Es ist ein wunderschöner Anblick."

# game/scripts/c21/c21.rpy:3235
translate german c21s005_DebLake_c0228616:

    # "No tiene sentido que empieces a cambiarte si después vas a tener que esperar a que se cambie la sirena."
    "Es macht keinen Sinn, mit dem Umbau zu beginnen, wenn man dann warten muss, bis die Sirene ausgetauscht ist."

# game/scripts/c21/c21.rpy:3236
translate german c21s005_DebLake_1ba67f1a:

    # "Pasas unos momentos observándola en el agua. Desde luego parece un segundo hogar para ella."
    "Sie beobachten sie einige Augenblicke lang im Wasser. Es scheint ihr tatsächlich ein zweites Zuhause zu sein."

# game/scripts/c21/c21.rpy:3237
translate german c21s005_DebLake_2169950f:

    # "Aprovechas para limpiarte la polla de los últimos restos de tu corrida antes de que la chica salga del agua."
    "Du nutzt die Gelegenheit, deinen Schwanz von den letzten Spuren deines Spermas zu befreien, bevor das Mädchen aus dem Wasser kommt."

# game/scripts/c21/c21.rpy:3248
translate german c21s005_DebLake_338c9a48:

    # deb "¿No ibas a cambiarte?"
    deb "Wolltest du dich nicht ändern?"

# game/scripts/c21/c21.rpy:3249
translate german c21s005_DebLake_39259e89:

    # mc "He preferido mirarte. Me encanta lo que veo."
    mc "Ich habe es vorgezogen, dich anzusehen. Ich liebe, was ich sehe."

# game/scripts/c21/c21.rpy:3251
translate german c21s005_DebLake_afa54773:

    # deb "Me encanta tu respuesta. Ahora ya puedo besarte después de quitarme el sabor a ti."
    deb "Deine Antwort gefällt mir. Jetzt kann ich dich küssen, nachdem ich deinen Geschmack losgeworden bin."

# game/scripts/c21/c21.rpy:3252
translate german c21s005_DebLake_1a1eda06:

    # mc "*Risa* Nunca voy a decir que no a eso."
    mc "*lacht* Dazu sage ich niemals nein."

# game/scripts/c21/c21.rpy:3254
translate german c21s005_DebLake_8a39f889:

    # "Solo hay un rastro del frescor del lago en sus labios. Ningún sabor que no pertenezca a [deb.nick]."
    "Nur ein Hauch der Kühle des Sees liegt auf ihren Lippen. Kein Geschmack, der nicht zu [deb.nick] gehört."

# game/scripts/c21/c21.rpy:3255
translate german c21s005_DebLake_b95b749b:

    # "Vuestros labios se vuelven a rozar, mientras compartís vuestros alientos."
    "Eure Lippen berühren sich wieder, während ihr den Atem teilt."

# game/scripts/c21/c21.rpy:3257
translate german c21s005_DebLake_00fccc3a:

    # deb "Será mejor que paremos o no vamos a llegar a tiempo a casa para la cena."
    deb "Wir sollten besser anhalten, sonst kommen wir nicht rechtzeitig zum Abendessen nach Hause."

# game/scripts/c21/c21.rpy:3258
translate german c21s005_DebLake_e9eadd07:

    # mc "No me importaría renunciar a la cena por un segundo round. *Risa*"
    mc "Für eine zweite Runde würde ich sogar auf das Abendessen verzichten. *lacht*"

# game/scripts/c21/c21.rpy:3260
translate german c21s005_DebLake_a02195c7:

    # deb "No será hoy. *Risa* ¡Tengo hambre!"
    deb "Nicht heute. *lacht* Ich habe Hunger!"

# game/scripts/c21/c21.rpy:3261
translate german c21s005_DebLake_3dd8cd2a:

    # mc "*Risa* El sexo da hambre a mi fierecilla."
    mc "*lacht* Sex macht mein kleines wildes Ding hungrig."

# game/scripts/c21/c21.rpy:3263
translate german c21s005_DebLake_e2b2494a:

    # "Descubrís que [kat] se ha llevado la toalla de [deb.nick], con lo que compartís la tuya. Por suerte, no se ha llevado también su ropa."
    "Du stellst fest, dass [kat] das Handtuch von [deb.nick] genommen hat, also teilst du deins mit ihm. Zum Glück haben sie ihre Kleidung nicht auch noch mitgenommen."

# game/scripts/c21/c21.rpy:3264
translate german c21s005_DebLake_0ee24cbc:

    # "Interrumpís el vestiros con besos, risas, y caricias. Pero finalmente acabáis vestidos. La tarde ya toca a su fin."
    "Du unterbrichst dein Anziehen mit Küssen, Lachen und Zärtlichkeiten. Doch schließlich bist du angezogen. Der Nachmittag neigt sich dem Ende zu."

# game/scripts/c21/c21.rpy:3266
translate german c21s005_DebLake_208d556e:

    # mc "Bueno, creo que toca volver a casa."
    mc "Nun, ich denke, es ist Zeit, nach Hause zu gehen."

# game/scripts/c21/c21.rpy:3267
translate german c21s005_DebLake_44d9699d:

    # deb "Sí. Me da pena irme de aquí, nos lo hemos pasado muy bien hoy."
    deb "Ja. Ich bin traurig, dass wir hier wegfahren müssen, wir hatten heute einen tollen Tag."

# game/scripts/c21/c21.rpy:3268
translate german c21s005_DebLake_57c7bb62:

    # mc "Podemos volver cuando quieras."
    mc "Wir können jederzeit wiederkommen, wann immer Sie möchten."

# game/scripts/c21/c21.rpy:3270
translate german c21s005_DebLake_8ab4c3ea:

    # deb "La próxima vez quiero que sea en una cama."
    deb "Nächstes Mal möchte ich es in einem Bett haben."

# game/scripts/c21/c21.rpy:3271
translate german c21s005_DebLake_9a09cad8:

    # mc "Hay una cama muy grande en mi habitación."
    mc "In meinem Zimmer steht ein sehr großes Bett."

# game/scripts/c21/c21.rpy:3273
translate german c21s005_DebLake_9aecbdc0:

    # deb "Y quiero... llegar hasta el final... si crees que estoy preparada."
    deb "Und ich möchte... bis zum Ende gehen... wenn du denkst, dass ich bereit bin."

# game/scripts/c21/c21.rpy:3274
translate german c21s005_DebLake_ae6bc43e:

    # mc "Si crees que lo estás, significa que lo estás."
    mc "Wenn du glaubst, dass du es bist, dann bist du es auch."

# game/scripts/c21/c21.rpy:3276
translate german c21s005_DebLake_c704286c:

    # deb "Dame unos días para pensar un par de cosas que quiero hablar contigo antes."
    deb "Gib mir ein paar Tage Zeit, um über ein paar Dinge nachzudenken, über die ich zuerst mit dir sprechen möchte."

# game/scripts/c21/c21.rpy:3277
translate german c21s005_DebLake_a1aa434a:

    # mc "Todo el tiempo que necesites, y puedes hablar conmigo de cualquier cosa que necesites."
    mc "Du hast so viel Zeit, wie du brauchst, und kannst mit mir über alles reden, was dich beschäftigt."

# game/scripts/c21/c21.rpy:3279
translate german c21s005_DebLake_15213cf1:

    # deb "Entonces, ya nos podemos ir. Pero antes..."
    deb "Dann können wir los. Aber vorher..."

# game/scripts/c21/c21.rpy:3281
translate german c21s005_DebLake_34381cbc:

    # "Su beso sabe a despedida."
    "Sein Kuss schmeckt nach Abschied."

# game/scripts/c21/c21.rpy:3282
translate german c21s005_DebLake_a0de7194:

    # "Sabes que, pese a que todo el mundo sepa que estáis juntos, no va a besarte así en casa."
    "Du weißt doch, dass er dich zu Hause nicht so küssen wird, obwohl alle wissen, dass ihr zusammen seid."

# game/scripts/c21/c21.rpy:3283
translate german c21s005_DebLake_35075453:

    # "Al menos por un tiempo, aunque no entiendas por qué."
    "Zumindest für eine Weile, auch wenn du nicht verstehst, warum."

# game/scripts/c21/c21.rpy:3286
translate german c21s005_DebLake_d270ce06:

    # "Al cabo de unos minutos emprendéis el camino a casa."
    "Nach wenigen Minuten treten Sie Ihre Heimreise an."

# game/scripts/c21/c21.rpy:3287
translate german c21s005_DebLake_c360a1cc:

    # "De camino a casa intentas sonsacarle el porqué de la timidez de los besos en casa. No obtienes respuestas."
    "Auf dem Heimweg versuchst du, ihr zu entlocken, warum sie zu Hause so schüchtern beim Küssen ist. Du bekommst keine Antwort."

# game/scripts/c21/c21.rpy:3288
translate german c21s005_DebLake_61dbc307:

    # "Llegáis con tiempo suficiente para ducharos antes de cenar."
    "Sie kommen rechtzeitig an, um vor dem Abendessen zu duschen."

# game/scripts/c21/c21.rpy:3292
translate german c21s006_Nor_85a5dca5:

    # "La cena pasa sin ningún evento reseñable, muchas risas, muchas anécdotas sobre la fiesta del día anterior que te perdiste por no estar en el sitio adecuado."
    "Das Abendessen verläuft ohne nennenswerte Ereignisse, es wird viel gelacht und es gibt viele Anekdoten über die Party vom Vortag, die man verpasst hat, weil man nicht am richtigen Ort war."

# game/scripts/c21/c21.rpy:3293
translate german c21s006_Nor_72be6aaf:

    # "Era imposible estar en todos sitios, y las chicas tienen muchas cosas que contarse unas a otras."
    "Es war unmöglich, überall zu sein, und die Mädchen hatten einander viel zu erzählen."

# game/scripts/c21/c21.rpy:3294
translate german c21s006_Nor_88570f07:

    # "Todas guardan silencio sobre lo que pasó en el jacuzzi."
    "Sie alle schweigen weiterhin darüber, was im Whirlpool passiert ist."

# game/scripts/c21/c21.rpy:3295
translate german c21s006_Nor_da5560f9:

    # "[eva] y [ama] no vienen a cenar. [ama] llama para decir que no se encuentran bien. Nada de lo que preocuparse, pero prefieren quedarse en la base."
    "[eva] und [ama] kommen nicht zum Abendessen. [ama] ruft an und sagt, dass es ihnen nicht gut geht. Kein Grund zur Sorge, aber sie bleiben lieber auf dem Stützpunkt."

# game/scripts/c21/c21.rpy:3302
translate german c21s006_Teaser_a7a419ea:

    # "Al final de la noche, cuando estás ayudando a [nor] a recoger los platos..."
    "Am Ende des Abends, wenn du [nor] beim Abräumen hilfst..."

# game/scripts/c21/c21.rpy:3303
translate german c21s006_Teaser_3642816b:

    # nor "¿Te apetece subir a mi habitación cuando acabemos? Parece que hace siglos que no estamos a solas."
    nor "Möchtest du mit in mein Zimmer kommen, wenn wir fertig sind? Es fühlt sich an, als wäre es eine Ewigkeit her, seit wir das letzte Mal allein zusammen waren."

# game/scripts/c21/c21.rpy:3304
translate german c21s006_Teaser_df96d4a7:

    # mc "Me apetece siempre. Tú también podrías venir a mi habitación."
    mc "Ich bin immer dabei. Du könntest auch in mein Zimmer kommen."

# game/scripts/c21/c21.rpy:3306
translate german c21s006_Teaser_101752c9:

    # nor "Podría, pero hay menos posibilidades de que alguien nos interrumpa en la mía."
    nor "Ich könnte, aber bei mir ist die Wahrscheinlichkeit geringer, dass uns jemand unterbricht."

# game/scripts/c21/c21.rpy:3307
translate german c21s006_Teaser_85785e06:

    # mc "*Risa* Tienes razón. Mi habitación parece un aeropuerto últimamente, con tantas entradas y salidas."
    mc "*Lacht* Du hast recht. Mein Zimmer fühlt sich in letzter Zeit an wie ein Flughafen, bei all dem Kommen und Gehen."

# game/scripts/c21/c21.rpy:3309
translate german c21s006_Teaser_80d73381:

    # nor "*Susurrando* ¿Acabas tú de recoger mientras yo subo y me voy poniendo guapa para ti?"
    nor "*Flüsternd* Hast du gerade mit dem Aufräumen fertig geworden, während ich nach oben gegangen bin und mich für dich fertig gemacht habe?"

# game/scripts/c21/c21.rpy:3310
translate german c21s006_Teaser_c17bfb64:

    # mc "Ya estás guapa para mí, mi amor. Pero ve subiendo si quieres. En cinco minutos estoy allí."
    mc "Du siehst wunderschön aus, meine Liebe. Aber komm ruhig nach oben, wenn du möchtest. Ich bin in fünf Minuten da."

# game/scripts/c21/c21.rpy:3311
translate german c21s006_Teaser_3a494236:

    # nor "Que sean diez."
    nor "Es sollen zehn sein."

# game/scripts/c21/c21.rpy:3313
translate german c21s006_Teaser_20acc60e:

    # "Diez minutos después..."
    "Zehn Minuten später..."

# game/scripts/c21/c21.rpy:3314
translate german c21s006_Teaser_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c21/c21.rpy:3315
translate german c21s006_Teaser_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "Ich bin's. Darf ich hereinkommen?"

# game/scripts/c21/c21.rpy:3316
translate german c21s006_Teaser_846dc0f1:

    # nor "*A través de la puerta* Pasa, mi amor."
    nor "*Durch die Tür* Komm herein, meine Liebe."

# game/scripts/c21/c21.rpy:3322
translate german c21s006_Teaser_80385b21:

    # nor "Espero que te guste esto. Lo he comprado hoy en la tienda de [mad.nick]."
    nor "Ich hoffe, es gefällt dir. Ich habe es heute im [mad.nick]-Shop gekauft."

# game/scripts/c21/c21.rpy:3324
