

# game/scripts/c21/c21.rpy:24
translate german c21s001_FoursomeWhatIf_d6b32481:

    # "Hay una escena con [eri], [dap], y [emm], pero no estás en ruta con las tres simultáneamente."
    "Es gibt eine Szene mit [eri], [dap] und [emm], aber Sie befinden sich nicht gleichzeitig mit allen dreien auf dem Weg."

# game/scripts/c21/c21.rpy:127
translate german c21s001_Foursome_ffbf891b:

    # "Al volver a tu habitación..."
    "Wenn Sie in Ihr Zimmer zurückkehren..."

# game/scripts/c21/c21.rpy:129
translate german c21s001_Foursome_d72364f0:

    # emm "¡Has tardado muchísimo en volver!"
    emm "Du hast ewig gebraucht, um zurückzukommen!"

# game/scripts/c21/c21.rpy:130
translate german c21s001_Foursome_433f4a0f:

    # dap "Estábamos a punto de irnos. Menos mal que has llegado ahora."
    dap "Wir wollten gerade abreisen. Zum Glück sind Sie jetzt angekommen."

# game/scripts/c21/c21.rpy:132
translate german c21s001_Foursome_54f0ebc1:

    # eri "Creíamos que te ibas a quedar a dormir en casa de [mad.nick]."
    eri "Wir dachten, du würdest bei [mad.nick] übernachten."

# game/scripts/c21/c21.rpy:134
translate german c21s001_Foursome_37fa3aff:

    # eri "O de llamarte para saber si te había pasado algo."
    eri "Oder um Sie anzurufen und sich zu erkundigen, ob Ihnen etwas zugestoßen ist."

# game/scripts/c21/c21.rpy:137
translate german c21s001_Foursome_b90d68d2:

    # emm "Veníamos a por nuestros regalos de cumpleaños, pero has tardado tanto que se nos han pasado las ganas."
    emm "Wir sind gekommen, um unsere Geburtstagsgeschenke abzuholen, aber es hat so lange gedauert, dass wir das Interesse verloren haben."

# game/scripts/c21/c21.rpy:139
translate german c21s001_Foursome_b8113d19:

    # eri "Las tres nos habíamos comprado esta lencería tan bonita para darte una sorpresa..."
    eri "Wir drei hatten diese wunderschöne Lingerie gekauft, um dich zu überraschen..."

# game/scripts/c21/c21.rpy:141
translate german c21s001_Foursome_c5491be0:

    # dap "Pero después de una hora esperándote... mejor nos vamos..."
    dap "Aber nachdem wir eine Stunde auf dich gewartet haben... sollten wir besser gehen..."

# game/scripts/c21/c21.rpy:142
translate german c21s001_Foursome_d9f214b9:

    # mc "Chicas, tenía que llevar a [mad.nick]..."
    mc "Mädels, ich musste [mad.nick]... nehmen."

# game/scripts/c21/c21.rpy:144
translate german c21s001_Foursome_309e5c9d:

    # mc "Y al volver me he encontrado con [kia] abajo..."
    mc "Und als ich zurückkam, fand ich [kia] unten vor..."

# game/scripts/c21/c21.rpy:147
translate german c21s001_Foursome_d04b2885:

    # emm "Es decir, tus otras novias antes que nosotras, ¿no?"
    emm "Also, deine anderen Freundinnen vor uns, richtig?"

# game/scripts/c21/c21.rpy:149
translate german c21s001_Foursome_609962f8:

    # emm "Es decir, el resto de las chicas antes que nosotras, ¿no?"
    emm "Also, die anderen Mädchen vor uns, richtig?"

# game/scripts/c21/c21.rpy:150
translate german c21s001_Foursome_398bcaed:

    # eri "Esperábamos más de ti, [mc]."
    eri "Wir hatten mehr von dir erwartet, [mc]."

# game/scripts/c21/c21.rpy:151
translate german c21s001_Foursome_e3a61a1a:

    # dap "Nos has decepcionado."
    dap "Sie haben uns enttäuscht."

# game/scripts/c21/c21.rpy:152
translate german c21s001_Foursome_deff457d:

    # mc "¡Pero si ni siquiera sabía que estabais aquí!"
    mc "Aber ich wusste gar nicht, dass du hier bist!"

# game/scripts/c21/c21.rpy:155
translate german c21s001_Foursome_6e734612:

    # "*Blam*"
    "*Bumm*"

# game/scripts/c21/c21.rpy:156
translate german c21s001_Foursome_d1199fbd:

    # mcp "(¡Son casi las 2:00 AM! Cuidado con la puerta o vais a despertar a alguien.)"
    mcp "(Es ist fast 2 Uhr morgens! Sei vorsichtig mit der Tür, sonst weckst du jemanden auf.)"

# game/scripts/c21/c21.rpy:157
translate german c21s001_Foursome_c5efcdc6:

    # eri "*A través de la puerta* *Susurrando* ¡[emm]! ¡Vas a despertar a [sai] y a [meg]!"
    eri "*Durch die Tür* *Flüsternd* [emm]! Du wirst [sai] aufwecken [meg]!"

# game/scripts/c21/c21.rpy:158
translate german c21s001_Foursome_9bc4801a:

    # emm "*A través de la puerta* *Susurrando* Lo siento... me he metido demasiado en mi papel. *Risita*"
    emm "*Durch die Tür* *Flüsternd* Tut mir leid... ich bin etwas zu sehr in meine Rolle hineingerutscht. *Kichert*"

# game/scripts/c21/c21.rpy:159
translate german c21s001_Foursome_3dd07e34:

    # dap "*A través de la puerta* *Susurrando* Chicas, ¿creéis que se lo ha creído?"
    dap "*Durch die Tür* *Flüsternd* Mädels, glaubt ihr, er hat es geglaubt?"

# game/scripts/c21/c21.rpy:160
translate german c21s001_Foursome_b9031dcc:

    # mcp "(En cinco minutos están de vuelta... como mucho cinco minutos. Voy a ir desnudándome.)"
    mcp "(Sie sind in fünf Minuten zurück... höchstens in fünf Minuten. Ich fange jetzt an, mich auszuziehen.)"

# game/scripts/c21/c21.rpy:161
translate german c21s001_Foursome_bdf9f113:

    # emm "*A través de la puerta* *Susurrando* ¡Por supuesto! En diez segundos abrirá la puerta para venir a buscarnos."
    emm "*Durch die Tür* *Flüsternd* Natürlich! In zehn Sekunden öffnet er die Tür und kommt, um uns zu holen."

# game/scripts/c21/c21.rpy:162
translate german c21s001_Foursome_62228065:

    # eri "*A través de la puerta* *Susurrando* No estoy segura. Ya han pasado diez segundos. Creo que sabe que estábamos de broma."
    eri "*Durch die Tür* *Flüsternd* Ich bin mir nicht sicher. Es sind schon zehn Sekunden vergangen. Ich glaube, er weiß, dass wir nur gescherzt haben."

# game/scripts/c21/c21.rpy:163
translate german c21s001_Foursome_28ac3415:

    # dap "*A través de la puerta* *Susurrando* Eso nos pasa por hacer caso a los planes de [emm]. Ya os he dicho que era un plan de mierda. Debe estar muy cansado."
    dap "*Durch die Tür* *Flüsternd* Das kommt davon, wenn man sich [emm]s Pläne anhört. Ich hab's dir doch schon gesagt, dass das ein beschissener Plan war. Er muss total fertig sein."

# game/scripts/c21/c21.rpy:164
translate german c21s001_Foursome_9502c5d8:

    # emm "*A través de la puerta* *Susurrando* ¡Hey! El plan era bueno... ¿Habéis visto la cara que ha puesto?"
    emm "*Durch die Tür* *Flüsternd* Hey! Der Plan war gut... Hast du seinen Gesichtsausdruck gesehen?"

# game/scripts/c21/c21.rpy:165
translate german c21s001_Foursome_7d7341c2:

    # dap "*A través de la puerta* *Susurrando* Imaginaos que decide darnos tiempo para que se nos pase el \"enfado\". Sería muy típico de él."
    dap "*Durch die Tür* *Flüsternd* Stellt euch vor, er gibt uns Zeit, uns zu beruhigen. Das wäre typisch für ihn."

# game/scripts/c21/c21.rpy:166
translate german c21s001_Foursome_60605bc9:

    # emm "*A través de la puerta* *Susurrando* ¿Volvemos?"
    emm "*Durch die Tür* *Flüsternd* Sollen wir zurückgehen?"

# game/scripts/c21/c21.rpy:167
translate german c21s001_Foursome_39f3b792:

    # eri "*A través de la puerta* *Susurrando* Vamos antes de que se duerma."
    eri "*Durch die Tür* *Flüsternd* Lass uns gehen, bevor sie einschläft."

# game/scripts/c21/c21.rpy:169
translate german c21s001_Foursome_cc59538f:

    # mc "Hola de nuevo, chicas. *Risa*"
    mc "Hallo nochmal, Mädels. *lacht*"

# game/scripts/c21/c21.rpy:171
translate german c21s001_Foursome_5095615f:

    # emm "¿Sabías que íbamos a volver?"
    emm "Wusstest du, dass wir zurückkommen würden?"

# game/scripts/c21/c21.rpy:172
translate german c21s001_Foursome_54eb101d:

    # mc "¡Por supuesto! Dudo que hayáis venido vestidas así todo el camino atravesando la planta de las estudiantes."
    mc "Natürlich! Ich bezweifle, dass Sie so gekleidet den ganzen Weg durch das Studentengebäude gegangen sind."

# game/scripts/c21/c21.rpy:173
translate german c21s001_Foursome_1ba58714:

    # mc "Y dudo que fuerais a volver a vuestras habitaciones así."
    mc "Und ich bezweifle, dass Sie so in Ihre Zimmer zurückgekehrt sind."

# game/scripts/c21/c21.rpy:175
translate german c21s001_Foursome_1ed30e3d:

    # eri "Es cierto, no habíamos contado con eso. Las batas están en el armario."
    eri "Stimmt, damit hatten wir nicht gerechnet. Die Bademäntel sind im Schrank."

# game/scripts/c21/c21.rpy:176
translate german c21s001_Foursome_6f14276a:

    # mc "Además, creo que han escuchado vuestros susurros desde San Francisco. *Risa*"
    mc "Ich glaube, sie haben deine Gerüchte bis nach San Francisco gehört. *lacht*"

# game/scripts/c21/c21.rpy:178
translate german c21s001_Foursome_deef0111:

    # dap "¡No hablábamos tan alto! Y si nos escuchabas, ¿por qué no has salido a buscarnos?"
    dap "Wir haben doch gar nicht so laut gesprochen! Und wenn du uns hören konntest, warum bist du dann nicht herausgekommen, um nach uns zu suchen?"

# game/scripts/c21/c21.rpy:179
translate german c21s001_Foursome_60d8fbac:

    # mc "Me estaba preparando para cuando volvierais. *Risa*"
    mc "Ich habe mich schon auf deine Rückkehr vorbereitet. *lacht*"

# game/scripts/c21/c21.rpy:181
translate german c21s001_Foursome_fb5a2e67:

    # eri "Y no nos has dejado abrir nuestro regalo como castigo, ¿no? *Risa*"
    eri "Und du hast uns zur Strafe nicht erlaubt, unser Geschenk zu öffnen, oder? *lacht*"

# game/scripts/c21/c21.rpy:182
translate german c21s001_Foursome_8c28168a:

    # mc "Nunca os castigaría por intentar hacer una broma. Ni por ninguna otra cosa, para ser sincero. Tan solo os he ahorrado tiempo. *Risa*"
    mc "Ich würde dich niemals bestrafen, weil du versucht hast, mir einen Streich zu spielen. Oder für irgendetwas anderes, um ehrlich zu sein. Ich habe dir nur etwas Zeit erspart. *lacht*"

# game/scripts/c21/c21.rpy:184
translate german c21s001_Foursome_a2f3101f:

    # dap "Sobre el papel, lo de plantarnos las tres en tu habitación parecía una buena idea, pero ahora no sé por dónde empezar..."
    dap "Auf dem Papier klang die Idee, dass wir drei in deinem Zimmer auftauchen, gut, aber jetzt weiß ich nicht, wo ich anfangen soll..."

# game/scripts/c21/c21.rpy:185
translate german c21s001_Foursome_8c649f98:

    # mc "¿Qué tal si venís aquí y vamos descubriéndolo?"
    mc "Wie wäre es, wenn du herkommst und wir es herausfinden?"

# game/scripts/c21/c21.rpy:186
translate german c21s001_Foursome_70e29f35:

    # mc "Me ha sorprendido un poco veros aquí, pero es casi un sueño hecho realidad."
    mc "Ich war etwas überrascht, Sie hier zu sehen, aber es ist fast wie ein wahr gewordener Traum."

# game/scripts/c21/c21.rpy:189
translate german c21s001_Foursome_259c23ba:

    # dap "Después de lo que ha pasado en la partida de DnD... tú ponías caras, pero nosotras nos podíamos imaginar..."
    dap "Nach dem, was im D&D-Spiel passiert ist... hast du zwar Grimassen geschnitten, aber wir konnten es uns ja vorstellen..."

# game/scripts/c21/c21.rpy:191
translate german c21s001_Foursome_c453c2b1:

    # dap "Al menos en mi cabeza, el trío con Aelia, Vilfredo, y Paula ha sido super caliente."
    dap "Zumindest in meiner Vorstellung war der Dreier mit Aelia, Vilfredo und Paula superheiß."

# game/scripts/c21/c21.rpy:192
translate german c21s001_Foursome_d00e1eab:

    # mc "Os entiendo. A mí me ha pasado lo mismo."
    mc "Ich verstehe. Mir ist dasselbe passiert."

# game/scripts/c21/c21.rpy:195
translate german c21s001_Foursome_c353d4c9:

    # dap "Después de lo que ha pasado en la partida de DnD... de haber rechazado a Beagan..."
    dap "Nach dem, was im D&D-Spiel passiert ist... nachdem Beagan zurückgewiesen wurde..."

# game/scripts/c21/c21.rpy:196
translate german c21s001_Foursome_083d2918:

    # dap "Hemos pensado que si no lo hubieras hecho, quizás hubiera acabado con las cuatro en la cama de Vilfredo."
    dap "Wir dachten, wenn du es nicht getan hättest, wären wir vielleicht alle vier in Vilfredos Bett gelandet."

# game/scripts/c21/c21.rpy:198
translate german c21s001_Foursome_43f2fa1c:

    # emm "Para que después digan que DnD no sirve de nada. *Risa*"
    emm "Und dann behaupten sie, D&D sei nutzlos. *lacht*"

# game/scripts/c21/c21.rpy:199
translate german c21s001_Foursome_af076395:

    # emm "Cuando te has ido a llevar a [mad.nick], casi nos hemos peleado por quién venía a verte. *Risita*"
    emm "Als du [mad.nick] abgeholt hast, haben wir uns fast darum gestritten, wer dich sehen durfte. *Kichert*"

# game/scripts/c21/c21.rpy:201
translate german c21s001_Foursome_fcace866:

    # eri "Si no hubiera sido por la partida, lo hubiéramos echado a suertes, pero después de jugar... hemos decidido venir las tres."
    eri "Ohne das Spiel hätten wir das Los geworfen, aber nach dem Spielen... haben wir beschlossen, dass wir drei kommen."

# game/scripts/c21/c21.rpy:203
translate german c21s001_Foursome_7bcff052:

    # mc "No quiero sonar desagradecido o avaricioso, pero ¿[sca] no se ha querido unir?"
    mc "Ich will nicht undankbar oder gierig klingen, aber wolltest du denn nicht mitmachen?"

# game/scripts/c21/c21.rpy:205
translate german c21s001_Foursome_558c177b:

    # dap "Se lo hemos propuesto, pero ha dicho que era nuestro cumpleaños..."
    dap "Wir haben es ihm vorgeschlagen, aber er meinte, es sei unser Geburtstag..."

# game/scripts/c21/c21.rpy:207
translate german c21s001_Foursome_c59c26f9:

    # dap "Y que quiere mantener las distancias hasta el martes."
    dap "Und dass er die soziale Distanzierung bis Dienstag aufrechterhalten möchte."

# game/scripts/c21/c21.rpy:209
translate german c21s001_Foursome_dd893afc:

    # emm "No lo he entendido. ¿Qué pasa el martes?"
    emm "Ich habe es nicht verstanden. Was passiert am Dienstag?"

# game/scripts/c21/c21.rpy:210
translate german c21s001_Foursome_fc1578f6:

    # mcp "(Que llegan los resultados del test de ADN.)"
    mcp "(Die Ergebnisse des DNA-Tests treffen ein.)"

# game/scripts/c21/c21.rpy:213
translate german c21s001_Foursome_c79b9725:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Doch Mitternacht ist vorbei, die Geburtstagsfeier ist zu Ende."

# game/scripts/c21/c21.rpy:216
translate german c21s001_Foursome_9f91f5c6:

    # dap "Sexo de cumpleaños, y esas cosas. *Risita*"
    dap "Geburtstagssex und so was. *Kichert*"

# game/scripts/c21/c21.rpy:218
translate german c21s001_Foursome_c79b9725_1:

    # emm "Pero ya ha pasado la medianoche, ya ha acabado el cumpleaños."
    emm "Doch Mitternacht ist vorbei, die Geburtstagsfeier ist zu Ende."

# game/scripts/c21/c21.rpy:220
translate german c21s001_Foursome_c82eb9fb:

    # eri "Hoy, aunque sea lunes, todavía es nuestro cumpleaños, al menos el de [dap] y el mío."
    eri "Heute ist zwar Montag, aber trotzdem haben wir Geburtstag, zumindest [dap] und ich."

# game/scripts/c21/c21.rpy:222
translate german c21s001_Foursome_4b42ed68:

    # emm "Lo siento, chicas, a veces me olvido... especialmente cuando vuestro cumpleaños es después del domingo de la fiesta."
    emm "Tut mir leid, Mädels, ich vergesse das manchmal... besonders wenn euer Geburtstag nach der Party am Sonntag ist."

# game/scripts/c21/c21.rpy:223
translate german c21s001_Foursome_e5270572:

    # mc "No le des más vueltas, [emm]. Son cosas que pasan. Le dais tanta importancia a la fiesta del domingo que olvidáis cuándo son los cumpleaños oficiales."
    mc "Mach dir nicht so viele Gedanken. Sowas kommt vor. Du machst so ein großes Aufhebens um die Party am Sonntag, dass du ganz vergisst, wann die Geburtstage eigentlich sind."

# game/scripts/c21/c21.rpy:226
translate german c21s001_Foursome_1033a870:

    # eri "Sobre eso... sabes que me han encantado los pendientes, pero quiero mi regalo de cumpleaños de verdad."
    eri "Apropos... du weißt ja, dass ich die Ohrringe toll fand, aber ich möchte mein eigentliches Geburtstagsgeschenk."

# game/scripts/c21/c21.rpy:228
translate german c21s001_Foursome_273c7378:

    # mc "*Risa* No sé a lo que te refieres... pero veo que no llevas los pendientes."
    mc "*Lacht* Ich weiß nicht, was Sie meinen... aber ich sehe, dass Sie keine Ohrringe tragen."

# game/scripts/c21/c21.rpy:233
translate german c21s001_Foursome_b9731cb0:

    # eri "No estoy acostumbrada a llevarlos aún. Después de cambiarme me los he quitado."
    eri "Ich bin es noch nicht gewohnt, sie zu tragen. Ich habe sie nach dem Umziehen ausgezogen."

# game/scripts/c21/c21.rpy:234
translate german c21s001_Foursome_fcc40a71:

    # emm "¡Ve a por él, [eri]!"
    emm "Nur zu, [eri]!"

# game/scripts/c21/c21.rpy:235
translate german c21s001_Foursome_b36f1535:

    # "Después de un largo día, los ojos te pican un poco y las luces te molestan. Esperas que no vaya a ser un problema para disfrutar de la noche."
    "Nach einem langen Tag jucken deine Augen ein wenig und das Licht blendet dich. Du hoffst, dass es dich nicht daran hindert, den Abend zu genießen."

# game/scripts/c21/c21.rpy:238
translate german c21s001_Foursome_06999336:

    # eri "Y en cuanto a mi regalo, me refiero a esto..."
    eri "Und was mein Geschenk betrifft, so meine ich Folgendes..."

# game/scripts/c21/c21.rpy:241
translate german c21s001_Foursome_c734993d:

    # "[eri] se sienta a horcajadas en tu regazo y empieza un maravilloso beso."
    "[eri] setzt sich rittlings auf deinen Schoß und beginnt einen wundervollen Kuss."

# game/scripts/c21/c21.rpy:242
translate german c21s001_Foursome_9dbf5877:

    # "El tiempo de los besos a escondidas ha pasado después de la Gran Revelación y los dos os sentís liberados de la presión de mantener el secreto."
    "Nach der großen Offenbarung ist die Zeit für heimliche Küsse vorbei und ihr fühlt euch beide befreit vom Druck, das Geheimnis bewahren zu müssen."

# game/scripts/c21/c21.rpy:243
translate german c21s001_Foursome_96bcc3e2:

    # "Vuestros labios se rozan, vuestras lenguas se entrelazan, vuestros alientos se entremezclan."
    "Eure Lippen berühren sich, eure Zungen verschmelzen, eure Atemzüge vermischen sich."

# game/scripts/c21/c21.rpy:246
translate german c21s001_Foursome_58c5e4a6:

    # emm "Nosotras también queremos nuestra ración de [mc]."
    emm "Wir wollen auch unseren Anteil an [mc]."

# game/scripts/c21/c21.rpy:248
translate german c21s001_Foursome_2761fc71:

    # dap "No seas impaciente, [emm]. Tenemos toda la noche para compartir a [mc]."
    dap "Sei nicht ungeduldig, [emm]. Wir haben die ganze Nacht Zeit, [mc] zu verbringen."

# game/scripts/c21/c21.rpy:250
translate german c21s001_Foursome_93d797d6:

    # eri "Todo vuestro, al menos durante un rato. *Risa* Voy a querer más."
    eri "Ganz dein, zumindest für eine Weile. *lacht* Ich will mehr."

# game/scripts/c21/c21.rpy:252
translate german c21s001_Foursome_11a6afa6:

    # "[emm] te tumba en la cama y empieza un delicioso beso"
    "[emm] Er legt dich auf das Bett und beginnt einen leidenschaftlichen Kuss"

# game/scripts/c21/c21.rpy:254
translate german c21s001_Foursome_79ef90b6:

    # "Al que no tarda en unirse [dap]."
    "Bald darauf gesellt sich [dap] hinzu."

# game/scripts/c21/c21.rpy:256
translate german c21s001_Foursome_77b9c9b2:

    # "Ambas se van turnando, en un baile casi sincronizado, por una vez sin discutir entre ellas."
    "Sie tanzen abwechselnd, fast synchron, und ausnahmsweise streiten sie nicht miteinander."

# game/scripts/c21/c21.rpy:257
translate german c21s001_Foursome_6b92b5b5:

    # "Un baile complicado donde sus cabezas están a punto de chocar más de una vez entre ellas."
    "Ein komplizierter Tanz, bei dem ihre Köpfe mehr als einmal zusammenzustoßen drohen."

# game/scripts/c21/c21.rpy:260
translate german c21s001_Foursome_c0ad023a:

    # "Puedes notar cómo [eri] no se queda inactiva mientras su hermana y su prima te besan."
    "Man kann erkennen, dass [eri] nicht inaktiv bleibt, während ihre Schwester und ihre Cousine dich küssen."

# game/scripts/c21/c21.rpy:262
translate german c21s001_Foursome_f156274e:

    # "Puedes notar cómo [eri] no se queda inactiva mientras las otras dos mujeres te besan."
    "Man kann erkennen, dass [eri] nicht inaktiv bleibt, während die anderen beiden Frauen dich küssen."

# game/scripts/c21/c21.rpy:263
translate german c21s001_Foursome_0d9b1752:

    # eri "Tu pierna me molesta, [emm]. Creo que vuestros besos lo han dejado preparado para nosotras."
