    # mc "No empieces a gastar el dinero antes de saber de dónde viene."
    mc "Gib kein Geld aus, bevor du weißt, woher es kommt."

# game/scripts/c26/c26.rpy:1264
translate german c26s002_EriDapSca_0318ce09:

    # eri "Voy a llamar a [ama]. Es posible que venga de NTR. Si lo hemos recibido [emm], [dap], y yo, pero no [sca]..."
    eri "Ich rufe [ama] an. Es könnte von NTR kommen. Wenn [emm], [dap], und ich es erhalten habe, aber nicht [sca]..."

# game/scripts/c26/c26.rpy:1265
translate german c26s002_EriDapSca_5ae3a440:

    # mc "Sí, hazlo, por favor. Yo tengo el móvil en la habitación."
    mc "Ja, bitte tun Sie es. Mein Handy ist im Zimmer."

# game/scripts/c26/c26.rpy:1267
translate german c26s002_EriDapSca_dec27729:

    # "Un minuto después..."
    "Eine Minute später..."

# game/scripts/c26/c26.rpy:1268
translate german c26s002_EriDapSca_2dc356de:

    # eri "Sí, es de NTR. Es nuestra parte de los beneficios, por las acciones..."
    eri "Ja, es stammt von NTR. Es ist unser Anteil am Gewinn aus den Aktien..."

# game/scripts/c26/c26.rpy:1269
translate german c26s002_EriDapSca_f5eaf0e9:

    # mc "Bueno, ahora somos accionistas de una empresa millonaria. Hay que enterarse bien de cómo funciona."
    mc "Nun sind wir Anteilseigner eines Unternehmens mit einem Wert von mehreren Millionen Dollar. Wir müssen herausfinden, wie genau es funktioniert."

# game/scripts/c26/c26.rpy:1270
translate german c26s002_EriDapSca_ae41bba9:

    # eri "[ama] me ha dicho que es un pago anual."
    eri "[ama] sagte mir, es handele sich um eine jährliche Zahlung."

# game/scripts/c26/c26.rpy:1272
translate german c26s002_EriDapSca_9cd46d22:

    # sca "Entonces, ya no necesitarás trabajar en el café, ¿verdad?"
    sca "Du brauchst also nicht mehr im Café zu arbeiten, richtig?"

# game/scripts/c26/c26.rpy:1273
translate german c26s002_EriDapSca_290c19e8:

    # sca "¿Podrías recomendarme para coger tu puesto?"
    sca "Könnten Sie mich für Ihre Position empfehlen?"

# game/scripts/c26/c26.rpy:1274
translate german c26s002_EriDapSca_2be61814:

    # mc "¿Quieres trabajar en el café, [sca]?"
    mc "Möchtest du im Café arbeiten, [sca]?"

# game/scripts/c26/c26.rpy:1276
translate german c26s002_EriDapSca_364dd5da:

    # sca "Quiero contribuir en algo a la familia. Estoy aquí sin hacer nada hasta que empiecen las clases..."
    sca "Ich möchte etwas zum Familieneinkommen beitragen. Ich sitze hier nur herum und tue nichts, bis der Unterricht wieder beginnt..."

# game/scripts/c26/c26.rpy:1277
translate german c26s002_EriDapSca_4648c288:

    # mc "Pero [dap] y tú ibais a venir a Aruba conmigo, ¿no?"
    mc "Aber [dap] und du wolltet doch mit mir nach Aruba kommen, nicht wahr?"

# game/scripts/c26/c26.rpy:1279
translate german c26s002_EriDapSca_f4920ea7:

    # sca "Si encuentro un trabajo, no podré ir. Ya habrá más oportunidades más tarde."
    sca "Wenn ich einen Job finde, kann ich nicht mitfahren. Später werden sich weitere Möglichkeiten ergeben."

# game/scripts/c26/c26.rpy:1280
translate german c26s002_EriDapSca_be042856:

    # mc "No creo que sea necesario que contribuyas económicamente, [sca]."
    mc "Ich glaube nicht, dass ein finanzieller Beitrag Ihrerseits erforderlich ist, [sca]."

# game/scripts/c26/c26.rpy:1281
translate german c26s002_EriDapSca_b1d2bfba:

    # mc "Eres de la familia y no tienes que pagar alquiler. Si [emm] no lo paga..."
    mc "Du gehörst zur Familie und musst keine Miete zahlen. Wenn [emm] nicht zahlt..."

# game/scripts/c26/c26.rpy:1283
translate german c26s002_EriDapSca_c05896e6:

    # emm "*Risa* Ahora podría pagarlo."
    emm "*Lacht* Jetzt könnte ich es mir leisten."

# game/scripts/c26/c26.rpy:1285
translate german c26s002_EriDapSca_52127a86:

    # emm "[lis], [deb.nick], [kat], [sai], y [kim] también son de la familia y pagan por su alojamiento." id c26s002_EriDapSca_52127a86
    emm "[lis], [deb.nick], [kat], [sai] und [kim] sind ebenfalls Familienmitglieder und bezahlen ihre Unterkunft selbst." id c26s002_EriDapSca_52127a86

# game/scripts/c26/c26.rpy:1286
translate german c26s002_EriDapSca_4cbc63a0:

    # emm "No sé si deberíamos hacer algo al respecto."
    emm "Ich weiß nicht, ob wir etwas dagegen unternehmen sollten."

# game/scripts/c26/c26.rpy:1287
translate german c26s002_EriDapSca_af63fdad:

    # mc "Creo que eso lo deberíamos comentar con Mamá y con Tía [nor]. La verdad es que es raro..."
    mc "Ich glaube, wir sollten mit Mama und Tante darüber reden. Es ist wirklich seltsam..."

# game/scripts/c26/c26.rpy:1289
translate german c26s002_EriDapSca_e954a25a:

    # eri "De todas formas, [sca], no voy a dejar el trabajo en el café hasta que empiecen las clases."
    eri "Jedenfalls, [sca], werde ich meine Arbeit im Café nicht unterbrechen, bis der Unterricht beginnt."

# game/scripts/c26/c26.rpy:1290
translate german c26s002_EriDapSca_796b9b79:

    # mc "¿Por qué? Ahora no necesitas el dinero..."
    mc "Warum? Du brauchst das Geld jetzt nicht..."

# game/scripts/c26/c26.rpy:1292
translate german c26s002_EriDapSca_8cca8bf3:

    # eri "Creo que ya sé en qué voy a gastar ese dinero, con lo que voy a estar en la misma situación."
    eri "Ich glaube, ich weiß schon, wofür ich das Geld ausgeben werde, also werde ich in der gleichen Situation sein."

# game/scripts/c26/c26.rpy:1293
translate german c26s002_EriDapSca_9bd83e03:

    # mc "¿En qué?"
    mc "In welchem Bereich?"

# game/scripts/c26/c26.rpy:1294
translate german c26s002_EriDapSca_e3047add:

    # eri "Lo tengo que confirmar todavía. Pero, de momento, no voy a dejar mi trabajo."
    eri "Das muss ich noch bestätigen. Aber vorerst werde ich meinen Job nicht kündigen."

# game/scripts/c26/c26.rpy:1296
translate german c26s002_EriDapSca_2996b4c3:

    # eri "[sca], igualmente le puedo decir a mi jefe que buscas trabajo para un mes. El chico que contrató para sustituir a Jack no está funcionando bien."
    eri "[sca], ich kann meinem Chef auch sagen, dass Sie einen einmonatigen Job suchen. Der Mann, den er als Jacks Nachfolger eingestellt hat, leistet keine gute Arbeit."

# game/scripts/c26/c26.rpy:1297
translate german c26s002_EriDapSca_31fc7bbf:

    # eri "Si al final lo despide, podríamos trabajar juntas [eil], tú, y yo."
    eri "Falls er ihn am Ende feuert, könnten wir zusammenarbeiten, du und ich."

# game/scripts/c26/c26.rpy:1299
translate german c26s002_EriDapSca_b11f4e4e:

    # sca "¡Oh! ¡Eso sería fantástico!"
    sca "Oh! Das wäre fantastisch!"

# game/scripts/c26/c26.rpy:1301
translate german c26s002_EriDapSca_07a07b95:

    # sca "Bueno, no por el pobre chico, pero..."
    sca "Nun ja, nicht etwa dem armen Jungen zuliebe, aber..."

# game/scripts/c26/c26.rpy:1302
translate german c26s002_EriDapSca_6d1b050d:

    # mc "*Risa* Creo que te hemos entendido."
    mc "*lacht* Ich glaube, wir verstehen dich."

# game/scripts/c26/c26.rpy:1304
translate german c26s002_EriDapSca_af5d598b:

    # dap "¿Crees que podemos gastar algo de ese dinero, [mc]?"
    dap "Glaubst du, wir können einen Teil dieses Geldes ausgeben, [mc]?"

# game/scripts/c26/c26.rpy:1305
translate german c26s002_EriDapSca_48644824:

    # mc "Una vez que [ama] ha confirmado que viene de NTR, creo que sí. Pero no os lo gastéis todo."
    mc "Sobald [ama] bestätigt hat, dass es von NTR stammt, denke ich schon. Aber gib nicht alles aus."

# game/scripts/c26/c26.rpy:1306
translate german c26s002_EriDapSca_99e2867d:

    # mc "Es un pago anual, con lo que os lo vais a tener que administrar durante un año."
    mc "Es handelt sich um eine jährliche Zahlung, daher müssen Sie sich ein Jahr lang darum kümmern."

# game/scripts/c26/c26.rpy:1308
translate german c26s002_EriDapSca_9b64bd31:

    # emm "¿Quieres decir que Mamá dejará de darme la paga semanal?"
    emm "Meinst du, Mama wird mir mein wöchentliches Taschengeld nicht mehr geben?"

# game/scripts/c26/c26.rpy:1309
translate german c26s002_EriDapSca_e30ad040:

    # mc "No es que lo crea. Le voy a proponer que deje de hacerlo. Ahora tienes tu propio dinero y tienes que aprender a administrarlo."
    mc "Ich glaube das nicht. Ich rate Ihnen aber, damit aufzuhören. Jetzt haben Sie Ihr eigenes Geld und müssen lernen, damit umzugehen."

# game/scripts/c26/c26.rpy:1311
translate german c26s002_EriDapSca_5b2e29e9:

    # emm "¡Pero eso es injusto! Ella seguramente también lo ha cobrado..."
    emm "Aber das ist unfair! Wahrscheinlich wurde sie auch bezahlt..."

# game/scripts/c26/c26.rpy:1312
translate german c26s002_EriDapSca_b29874c5:

    # mc "Y ella se ocupa de todos los gastos de la casa. No seas egoísta, [emm]."
    mc "Und sie kümmert sich um alle Haushaltskosten. Sei nicht egoistisch."

# game/scripts/c26/c26.rpy:1314
translate german c26s002_EriDapSca_f8be4405:

    # emm "Tienes razón. Le preguntaré si necesita algo..."
    emm "Du hast Recht. Ich frage ihn, ob er etwas braucht..."

# game/scripts/c26/c26.rpy:1315
translate german c26s002_EriDapSca_ebd8fc29:

    # emm "Voy a buscarla para darle la noticia."
    emm "Ich werde sie suchen, um ihr die Nachricht zu überbringen."

# game/scripts/c26/c26.rpy:1317
translate german c26s002_EriDapSca_53462aa3:

    # dap "[sca], vamos a nuestra habitación. Creo que tenemos que renovar tu portátil."
    dap "[sca], lass uns in unser Zimmer gehen. Ich glaube, wir müssen deinen Laptop aufrüsten."

# game/scripts/c26/c26.rpy:1318
translate german c26s002_EriDapSca_e03687a5:

    # mcp "(La primera compra que hace es para [sca]. [dap] es maravillosa.)"
    mcp "(Ihr erster Kauf gilt [sca]. [dap] ist wunderbar.)"

# game/scripts/c26/c26.rpy:1320
translate german c26s002_EriDapSca_c6c43322:

    # sca "¿Qué? ¿Por qué? El mío aún puede durar..."
    sca "Was? Warum? Meins hält doch noch..."

# game/scripts/c26/c26.rpy:1321
translate german c26s002_EriDapSca_e050b987:

    # mc "[sca], tu portátil todavía tiene Doors 8. Creo que ya es hora de jubilarlo, y no digas que no a un regalo."
    mc "[sca], auf deinem Laptop ist immer noch Doors 8 installiert. Ich denke, es ist Zeit, ihn in Rente zu schicken, und sag nicht Nein zu einem Geschenk."

# game/scripts/c26/c26.rpy:1322
translate german c26s002_EriDapSca_d29d73d6:

    # mc "Creo que le va a hacer más ilusión a [dap] comprártelo que a ti recibirlo."
    mc "Ich glaube, [dap] wird sich mehr darüber freuen, es für dich zu kaufen, als du dich darüber freuen wirst, es zu erhalten."

# game/scripts/c26/c26.rpy:1324
translate german c26s002_EriDapSca_bafa982c:

    # eri "Yo voy a hablar con Tía [bet] sobre unas cosas..."
    eri "Ich werde mit Tante [bet] über ein paar Dinge sprechen..."

# game/scripts/c26/c26.rpy:1326
translate german c26s002_EriDapSca_2ad05f94:

    # "Todas desaparecen y te quedas solo en la cocina."
    "Sie verschwinden alle und du bleibst allein in der Küche zurück."

# game/scripts/c26/c26.rpy:1327
translate german c26s002_EriDapSca_e290d77b:

    # "Solo con tu hambre. Aún no has desayunado."
    "Einfach nur Hunger. Du hast noch nicht gefrühstückt."

# game/scripts/c26/c26.rpy:1329
translate german c26s002_EriDapSca_adf250ce:

    # "Pones remedio a esa situación."
    "Sie beheben diesen Zustand."

# game/scripts/c26/c26.rpy:1338
translate german c26s003_Sai_2736c66c:

    # "Al acabar de desayunar, de camino a tu habitación."
    "Nach dem Frühstück auf dem Weg zu Ihrem Zimmer."

# game/scripts/c26/c26.rpy:1339
translate german c26s003_Sai_aef5aca0:

    # mc "Hola, [sai], ¿qué haces tan sola?"
    mc "Hallo [sai], was machst du denn ganz allein?"

# game/scripts/c26/c26.rpy:1340
translate german c26s003_Sai_4be64632:

    # sai "Les he mandado a mis padres unas fotos de la clase de tiro de ayer y estábamos chateando."
    sai "Ich habe meinen Eltern ein paar Fotos vom gestrigen Fotokurs geschickt und wir haben uns darüber unterhalten."

# game/scripts/c26/c26.rpy:1341
translate german c26s003_Sai_9a12bdab:

    # sai "Tenías que haber venido. Fue muy divertido."
    sai "Du hättest mitkommen sollen. Es hat so viel Spaß gemacht."

# game/scripts/c26/c26.rpy:1342
translate german c26s003_Sai_31a2af1a:

    # mc "Me tienes que enseñar esas fotos."
    mc "Du musst mir diese Fotos zeigen."

# game/scripts/c26/c26.rpy:1344
translate german c26s003_Sai_88877976:

    # sai "Siéntate conmigo un momento y te las enseño."
    sai "Setzen Sie sich einen Moment zu mir, und ich zeige sie Ihnen."

# game/scripts/c26/c26.rpy:1345
translate german c26s003_Sai_872c8558:

    # mc "¿No estabas chateando con tus padres?"
    mc "Hast du dich nicht mit deinen Eltern unterhalten?"

# game/scripts/c26/c26.rpy:1347
translate german c26s003_Sai_6f0d13aa:

    # sai "Me había despedido justo antes de que llegaras."
    sai "Ich hatte mich kurz vor deiner Ankunft verabschiedet."

# game/scripts/c26/c26.rpy:1348
translate german c26s003_Sai_7ca76543:

    # mc "Enséñame esas fotos, entonces."
    mc "Dann zeig mir doch mal die Fotos."

# game/scripts/c26/c26.rpy:1350
translate german c26s003_Sai_a2fe9454:

    # sai "Mira, aquí estamos disparando las del primer turno. [eva] fue super estricta con la seguridad."
    sai "Seht her, hier filmen wir die aus der ersten Runde. [eva] war extrem streng mit den Sicherheitsvorkehrungen."

# game/scripts/c26/c26.rpy:1351
translate german c26s003_Sai_0c7c59e8:

    # mc "Sí que lo es. Es parte de su entrenamiento. Al menos no os hizo poneros trajes raros como a mí."
    mc "Ja, das ist es. Es gehört zu seinem Training. Wenigstens hat er euch nicht gezwungen, so komische Outfits zu tragen wie mich."

# game/scripts/c26/c26.rpy:1353
translate german c26s003_Sai_7188f673:

    # sai "¿Cómo tuviste que vestirte?"
    sai "Was musstest du anziehen?"

# game/scripts/c26/c26.rpy:1354
translate german c26s003_Sai_3ddc6c80:

    # mc "Me llevó en la moto y me hizo ponerme un traje de skydiving. Era bastante incómodo."
    mc "Er nahm mich auf seinem Motorrad mit und zwang mich, einen Fallschirmspringeranzug anzuziehen. Es war ziemlich unbequem."

# game/scripts/c26/c26.rpy:1356
translate german c26s003_Sai_45b01f20:

    # sai "*Risa* Lástima que no haya fotos de eso. Nosotras disparamos con la ropa que llevábamos."
    sai "*lacht* Schade, dass es davon keine Fotos gibt. Wir haben die Fotos in den Klamotten gemacht, die wir gerade trugen."

# game/scripts/c26/c26.rpy:1357
translate german c26s003_Sai_a427effe:

    # mc "No sé si os gustaría verme con ese traje. *Risa* A menos que fuera para reíros de mí, claro."
    mc "Ich weiß nicht, ob du mich in dem Anzug sehen willst. *lacht* Es sei denn, du willst dich natürlich über mich lustig machen."

# game/scripts/c26/c26.rpy:1358
translate german c26s003_Sai_3f66c9f4:

    # mc "Vosotras estáis mucho mejor. Pero quiero ver más fotos."
    mc "Ihr seht alle viel besser aus. Aber ich möchte noch mehr Fotos sehen."

# game/scripts/c26/c26.rpy:1360
translate german c26s003_Sai_35b1678f:

    # sai "Estas son las del segundo turno. Había seis puestos de tiro, y éramos diez, más [ama] y [eva], con lo que dos turnos fueron bien."
    sai "Das sind die Ergebnisse der zweiten Runde. Es gab sechs Schusspositionen, und wir waren zehn Mann, plus [ama] und [eva], also verliefen die beiden Runden gut."

# game/scripts/c26/c26.rpy:1361
translate german c26s003_Sai_c0ee93f2:

    # mc "¿Competíais entre vosotras?"
    mc "Standen Sie im Wettbewerb zueinander?"

# game/scripts/c26/c26.rpy:1363
translate german c26s003_Sai_30964fc6:

    # sai "Quisimos hacerlo. [ama] dijo que no estaba bien para la primera lección, que era para aprender."
    sai "Wir wollten es tun. [ama] sagte, es sei nicht angebracht für die erste Stunde, die dem Lernen diente."

# game/scripts/c26/c26.rpy:1364
translate german c26s003_Sai_a85d5a98:

    # sai "[emm] y yo insistimos, que era competir solo por diversión entre la familia."
    sai "[emm] und ich bestand darauf, dass es sich nur um einen spaßigen Wettstreit innerhalb der Familie handelte."

# game/scripts/c26/c26.rpy:1365
translate german c26s003_Sai_ecc79721:

    # sai "[eva] fue al último puesto de tiro, disparó siete veces, y dijo algo como '¿Estáis seguras de que queréis competir?'"
    sai "[eva] ging zum letzten Schießstand, feuerte sieben Mal und sagte so etwas wie: „Bist du sicher, dass du teilnehmen willst?“"

# game/scripts/c26/c26.rpy:1366
translate german c26s003_Sai_942f5934:

    # mc "*Risa* Y se acabó la discusión."
    mc "*Gelächter* Und damit war die Diskussion beendet."

# game/scripts/c26/c26.rpy:1368
translate german c26s003_Sai_aef86f6a:

    # sai "*Risa* Seis tiros dieron en el 10 y uno en el 9. 69 puntos."
    sai "*Gelächter* Sechs Schüsse trafen die 10 und einer die 9. 69 Punkte."

# game/scripts/c26/c26.rpy:1369
translate german c26s003_Sai_28be29c9:

    # mc "Es extraño que fallara uno."
    mc "Es ist seltsam, dass einer davon fehlgeschlagen ist."

# game/scripts/c26/c26.rpy:1371
translate german c26s003_Sai_c58cbc6d:

    # sai "[ama] nos dijo luego que lo había hecho a propósito. Así, si alguien quería competir, tendría una oportunidad de superarla."
    sai "[ama] erzählte uns später, dass sie das absichtlich getan hatte. So hätte jeder, der gegen sie antreten wollte, eine Chance, sie zu schlagen."

# game/scripts/c26/c26.rpy:1372
translate german c26s003_Sai_c2df0add:

    # mc "*Risa* Eso suena tan a... [eva]..."
    mc "*lacht* Das klingt so... [eva]..."

# game/scripts/c26/c26.rpy:1374
translate german c26s003_Sai_2b19abc7:

    # sai "Totalmente [eva]. Dejó clara su posición, pero dejó margen por si alguien quería competir de verdad."
    sai "Absolut. Er hat seine Position klar gemacht, aber Raum gelassen, falls jemand wirklich konkurrieren wollte."

# game/scripts/c26/c26.rpy:1375
translate german c26s003_Sai_9784ae30:

    # sai "Las que más se aceraron a su puntuación fueron [sam] y [kat], con 51 y 54 puntos. Ya habían disparado antes. Son muy buenas."
    sai "Die Züge, die ihrer Punktzahl am nächsten kamen, waren [sam] und [kat] mit 51 bzw. 54 Punkten. Sie wurden bereits zuvor gespielt. Sie sind sehr gut."

# game/scripts/c26/c26.rpy:1376
translate german c26s003_Sai_dfd35ebf:

    # mc "¿Cuál fue tu puntuación?"
    mc "Wie hoch war Ihr Ergebnis?"

# game/scripts/c26/c26.rpy:1378
translate german c26s003_Sai_364cea9c:

    # sai "*Risa* Unos horribles 23 puntos con siete disparos en mi mejor ronda. Y no fui la peor, pero no te diré quién fue."
    sai "*lacht* Schreckliche 23 Punkte mit sieben Schüssen in meiner besten Runde. Und ich war nicht der Schlechteste, aber ich verrate euch nicht, wer es war."

# game/scripts/c26/c26.rpy:1379
translate german c26s003_Sai_4cd5359e:

    # mc "*Risa* Deberías decírmelo, para salir corriendo si alguna vez la veo con un arma."
    mc "*Lacht* Du solltest es mir sagen, damit ich weglaufen kann, falls ich sie jemals mit einer Waffe sehe."

# game/scripts/c26/c26.rpy:1381
translate german c26s003_Sai_fd7bd295:

    # sai "Mira, esta es la última foto, cuando habíamos acabado."
    sai "Seht her, das ist das letzte Foto, als wir fertig waren."

# game/scripts/c26/c26.rpy:1382
translate german c26s003_Sai_6259fe7c:

    # mc "Me extraña mucho que [eva] y [ama] os dejaran posar con las pistolas..."
    mc "Ich bin sehr überrascht, dass man mit [eva] und [ama] mit den Pistolen posieren kann..."

# game/scripts/c26/c26.rpy:1383
translate german c26s003_Sai_de78cf99:

    # sai "[emm] y [dap] querían que nos hiciéramos una foto en plan malotas. Tu madre insistió en que [ama] y [eva] revisaran todas las armas antes de la foto."
    sai "[emm] und [dap] wollten, dass wir ein Foto machen, auf dem wir cool aussehen. Deine Mutter bestand darauf, dass [ama] und [eva] vor dem Foto alle Waffen überprüfen."

# game/scripts/c26/c26.rpy:1384
translate german c26s003_Sai_1d1ba706:

    # mc "Pero no parecéis malotas. Estáis sonriendo todas. Quizás tú eres la que pareces más seria."
    mc "Aber ihr seht nicht wie böse Mädchen aus. Ihr lächelt alle. Vielleicht bist du diejenige, die am ernstesten aussieht."

# game/scripts/c26/c26.rpy:1386
translate german c26s003_Sai_67daa2f2:

    # sai "*Risa* Eso es porque en la foto en plan malotas... parecíamos unas drogadictas con el mono."
    sai "*lacht* Das liegt daran, dass wir auf dem Foto, so cool wie möglich aussahen... wie Drogenabhängige im Entzug."

# game/scripts/c26/c26.rpy:1387
translate german c26s003_Sai_acd3668e:

    # sai "Las únicas que quedaron bien fueron [kim] y [lis]. Es imposible que esas chicas queden mal en ninguna foto."
    sai "Die einzigen, die gut aussahen, waren [kim] und [lis]. Es ist unmöglich, dass diese Mädchen auf irgendeinem Foto schlecht aussehen."

# game/scripts/c26/c26.rpy:1388
translate german c26s003_Sai_d4533b0a:

    # mc "*Risa* Quiero verla."
    mc "*lacht* Ich möchte sie sehen."

# game/scripts/c26/c26.rpy:1390
translate german c26s003_Sai_9684e979:

    # sai "*Risa* ¿No nos conoces aún? Esa foto fue borrada una milésima de segundo después de verla."
    sai "*Lacht* Kennt ihr uns denn noch nicht? Das Foto wurde eine Millisekunde, nachdem wir es gesehen hatten, gelöscht."

# game/scripts/c26/c26.rpy:1391
translate german c26s003_Sai_e7b1479f:

    # sai "Somos mujeres. No vamos a conservar una foto en la que salimos mal. Ni siquiera [lis] o [kim] la quisieron conservar."
    sai "Wir sind Frauen. Wir werden kein Foto aufbewahren, auf dem wir schlecht aussehen. Nicht einmal [lis] oder [kim] wollten es behalten."

# game/scripts/c26/c26.rpy:1392
translate german c26s003_Sai_bb21b568:

    # mc "¡Qué consideradas! *Risa* Les tendré que preguntar a [ama] y a [eva] si había cámaras de seguridad."
    mc "Wie rücksichtsvoll! *lacht* Ich muss mal [ama] und [eva] fragen, ob es Überwachungskameras gibt."

# game/scripts/c26/c26.rpy:1394
translate german c26s003_Sai_9ed8bf3d:

    # sai "Aunque las hubiera, no te enseñarían las grabaciones."
    sai "Selbst wenn es sie gäbe, würden sie Ihnen die Aufnahmen nicht zeigen."

# game/scripts/c26/c26.rpy:1395
translate german c26s003_Sai_b3961c59:

    # mc "¿Por qué?"
    mc "Weil?"

# game/scripts/c26/c26.rpy:1397
translate german c26s003_Sai_7f6d57b6:

    # sai "Primero porque era una cosa entre chicas. Segundo porque protegernos incluye destruir cualquier prueba de la existencia de esa foto. *Risa*"
    sai "Erstens, weil es typisch Mädchensache war. Zweitens, weil es zu unserem Selbstschutz gehört, jegliche Spuren dieses Fotos zu vernichten. *lacht*"

# game/scripts/c26/c26.rpy:1398
translate german c26s003_Sai_4a345483:

    # sai "Y, por último, porque ellas también quedaron mal. Pueden dar miedo cuando se ponen serias, pero cuando {b}fingen{/b} ser malotas... Quedaron horribles."
    sai "Und schließlich, weil sie auch einen schlechten Eindruck machten. Sie können einschüchternd wirken, wenn sie ernst meinen, aber wenn sie den Harten spielen... dann sahen sie furchtbar aus."

# game/scripts/c26/c26.rpy:1399
translate german c26s003_Sai_6dab2001:

    # mc "*Risa* Lo entiendo."
    mc "*Lacht* Ich verstehe."

# game/scripts/c26/c26.rpy:1401
translate german c26s003_Sai_5fe243aa:

    # sai "Seguramente hace una semana no les hubiera importado. ¿Ahora? Se están volviendo tan femeninas como el resto."
    sai "Vor einer Woche hätte es sie wahrscheinlich nicht gekümmert. Und jetzt? Jetzt werden sie genauso feminin wie alle anderen."

# game/scripts/c26/c26.rpy:1402
translate german c26s003_Sai_d20aaa59:

    # sai "[eva] incluso está empezando a pedir consejos de belleza, aunque no los necesite. Me encanta esa evolución."
    sai "[eva] Sie fragt sogar schon nach Beauty-Tipps, obwohl sie die gar nicht braucht. Ich finde diese Entwicklung toll."

# game/scripts/c26/c26.rpy:1403
translate german c26s003_Sai_b225fbf4:

    # mc "Es cierto. Sentirse arropadas por todas vosotras está haciendo que se abran más."
    mc "Das stimmt. Das Gefühl, von euch allen unterstützt zu werden, führt dazu, dass sie sich mehr öffnen."

# game/scripts/c26/c26.rpy:1405
translate german c26s003_Sai_10a6266c:

    # "Te diriges a la cámara que sabes que una de las dos está mirando ahora mismo."
    "Du gehst auf die Kamera zu, von der du weißt, dass einer der beiden gerade hineinschaut."

# game/scripts/c26/c26.rpy:1406
translate german c26s003_Sai_62d979c0:

    # mc "Bien hecho, chicas. Estoy orgulloso de vosotras."
    mc "Gut gemacht, Mädels. Ich bin stolz auf euch."

# game/scripts/c26/c26.rpy:1407
translate german c26s003_Sai_6aba5db1:

    # "Te puedes imaginar que, en algún lugar de la base, suena una risita."
    "Man kann sich vorstellen, dass irgendwo in der Basis ein Kichern zu hören ist."

# game/scripts/c26/c26.rpy:1409
translate german c26s003_Sai_a0e077e5:

    # sai "A veces me olvido de que ven y escuchan todo lo que hacemos fuera de las habitaciones y los baños."
    sai "Manchmal vergesse ich, dass sie alles sehen und hören, was wir außerhalb der Schlafzimmer und Badezimmer tun."

# game/scripts/c26/c26.rpy:1410
translate german c26s003_Sai_38d5c048:

    # mc "Es fácil olvidarse. Pero de todas formas, no importa. Creo que, cuando nos escuchan hablar de ellas, tienen que pasar la mitad del tiempo ruborizándose."
    mc "Man vergisst das leicht. Aber egal, es spielt keine Rolle. Ich glaube, wenn sie uns über sie reden hören, erröten sie die Hälfte der Zeit."

# game/scripts/c26/c26.rpy:1411
translate german c26s003_Sai_06cb7834:

    # mc "Aún no he oído a nadie decir nada malo de ellas."
    mc "Ich habe noch niemanden etwas Schlechtes über sie sagen hören."

# game/scripts/c26/c26.rpy:1413
translate german c26s003_Sai_2f99dfee:

    # sai "Si alguien dijera algo malo de ellas, no sobreviviría hasta que llegaran a casa para vengarse."
    sai "Wenn jemand etwas Schlechtes über sie sagte, würden sie es nicht überleben, bis sie nach Hause kämen, um Rache zu nehmen."

# game/scripts/c26/c26.rpy:1414
translate german c26s003_Sai_c3830c33:

    # sai "Destrozaríamos entre todas a quien osara decir algo de nuestras chicas."
    sai "Wir würden jeden in Stücke reißen, der es wagen würde, irgendetwas über unsere Mädchen zu sagen."

# game/scripts/c26/c26.rpy:1416
translate german c26s003_Sai_2124d16f:

    # "Ahora es cuando [sai] se dirige a la cámara."
    "Jetzt wendet sich [sai] an die Kamera."

# game/scripts/c26/c26.rpy:1417
translate german c26s003_Sai_8ae61518:

    # sai "Y sabéis que lo digo en serio. Todas os queremos."
    sai "Und du weißt, dass ich es ernst meine. Wir alle lieben dich."

# game/scripts/c26/c26.rpy:1418
translate german c26s003_Sai_4eaf4fb0:

    # "Estás seguro de que quien esté escuchando se habrá ruborizado, o quizás se le hayan saltado unas lágrimas. No están muy acostumbradas a recibir cariño."
    "Du bist dir sicher, dass derjenige, der zugehört hat, rot geworden ist oder vielleicht sogar ein paar Tränen vergossen hat. Sie sind es nicht gewohnt, Zuneigung zu erfahren."

# game/scripts/c26/c26.rpy:1419
translate german c26s003_Sai_52810f24:

    # "Se van a acostumbrar muy rápido."
    "Sie werden sich sehr schnell daran gewöhnen."

# game/scripts/c26/c26.rpy:1421
translate german c26s003_Sai_8de79da5:

    # mc "¿Vais a hacer más lecciones de tiro?"
    mc "Wirst du weitere Schießstunden nehmen?"

# game/scripts/c26/c26.rpy:1422
translate german c26s003_Sai_47238ed4:

    # sai "[eri] tiene que hacer una, pero será en el bosque. Creo que [eil] también se apuntará, y alguna de las de ayer también."
    sai "[eri] muss auch einen Zug machen, aber der wird im Wald stattfinden. Ich glaube, [eil] wird sich auch anmelden, und einige der Figuren von gestern ebenfalls."

# game/scripts/c26/c26.rpy:1423
translate german c26s003_Sai_04baaa1b:

    # sai "Fue muy divertido, y queremos repetirlo. Además, algunas queremos aprender a disparar con otras armas."
    sai "Es hat riesigen Spaß gemacht, und wir wollen es unbedingt wiederholen. Außerdem möchten einige von uns lernen, mit anderen Waffen umzugehen."

# game/scripts/c26/c26.rpy:1424
translate german c26s003_Sai_9c72feea:

    # mc "Además es una actividad en grupo para estrechar lazos entre vosotras."
    mc "Es ist außerdem eine Gruppenaktivität, um die Bindungen zwischen euch zu stärken."

# game/scripts/c26/c26.rpy:1426
translate german c26s003_Sai_072d9792:

    # sai "*Risa* ¿Estrechar lazos aún más? Vamos a parecer piezas de un corsé a este paso."
    sai "*Gelächter* Die Bindungen noch weiter stärken? Bei dem Tempo sehen wir bald aus wie Teile eines Korsetts."

# game/scripts/c26/c26.rpy:1428
translate german c26s003_Sai_511e6c4d:

    # sai "En dos semanas aquí he estrechado más lazos de lo que hice el primer año en Portland, cuando vivía en el dormitorio."
    sai "In den zwei Wochen hier habe ich engere Bindungen geknüpft als in meinem ersten Jahr in Portland, als ich im Studentenwohnheim wohnte."

# game/scripts/c26/c26.rpy:1429
translate german c26s003_Sai_14fc3e69:

    # sai "Incluso con las chicas que no viven en casa, como [sam], [meg], o [oma]."
    sai "Auch bei Mädchen, die nicht mehr zu Hause wohnen, wie [sam], [meg] oder [oma]."

# game/scripts/c26/c26.rpy:1430
translate german c26s003_Sai_91ffeca8:

    # mc "Entonces, ¿no te arrepientes de haber venido?"
    mc "Du bereust deine Teilnahme also nicht?"

# game/scripts/c26/c26.rpy:1433
translate german c26s003_Sai_5c77a558:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hubiéramos vuelto a estar juntos, hubiera valido la pena por las chicas."
    sai "Ich bereue es überhaupt nicht. Ich bin deinetwegen gekommen, aber selbst wenn wir nicht wieder zusammengekommen wären, hätte es sich für die Mädchen gelohnt."

# game/scripts/c26/c26.rpy:1434
translate german c26s003_Sai_db77d33c:

    # sai "Aunque no hubiera salido bien lo nuestro, la convivencia con esas chicas me hubiera hecho quedarme."
    sai "Selbst wenn es zwischen uns nicht geklappt hätte, hätte mich das Zusammenleben mit diesen Mädchen dazu gebracht, bleiben zu wollen."

# game/scripts/c26/c26.rpy:1436
translate german c26s003_Sai_d3dd32b2:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hemos vuelto a estar juntos, vale la pena por las chicas."
    sai "Ich bereue es überhaupt nicht. Ich bin wegen dir gekommen, und auch wenn wir seitdem nicht wieder zusammen waren, hat es sich für die Mädchen gelohnt."

# game/scripts/c26/c26.rpy:1437
translate german c26s003_Sai_433d5145:

    # sai "Tenías razón cuando me dijiste que no centrara mi vida en ti cuando no volvimos juntos, tenía que probar la convivencia con esas chicas para entenderlo."
    sai "Du hattest Recht, als du mir sagtest, ich solle mein Leben nicht auf dich ausrichten, wenn wir nicht wieder zusammenkommen; ich musste erst die Erfahrung machen, mit diesen Mädchen zusammenzuleben, um das zu verstehen."

# game/scripts/c26/c26.rpy:1438
translate german c26s003_Sai_8c61827e:

    # mc "Me alegra mucho que seas feliz aquí."
    mc "Ich bin so froh, dass du hier glücklich bist."

# game/scripts/c26/c26.rpy:1440
translate german c26s003_Sai_153f750d:

    # sai "Lo soy. Mucho. Cuando en Portland me hablabas de tu familia no me podía imaginar algo así. Creía que exagerabas y resulta que te quedabas corto."
    sai "Ja, absolut. Als du mir von deiner Familie in Portland erzählt hast, hätte ich mir so etwas nie vorstellen können. Ich dachte, du übertreibst, aber es stellte sich heraus, dass du es eher untertrieben hast."

# game/scripts/c26/c26.rpy:1441
translate german c26s003_Sai_f22ce30f:

    # mc "*Risa* Yo tampoco me podía imaginar algo así. No era así cuando me marché, pero me alegra que lo sea ahora."
    mc "*Lacht* So etwas hätte ich mir auch nicht vorstellen können. Als ich wegging, war es nicht so, aber ich bin froh, dass es jetzt so ist."

# game/scripts/c26/c26.rpy:1442
translate german c26s003_Sai_815f4a4e:

    # mc "¿Y qué tal con [meg]? A veces me sabe mal haberte pedido que compartas tu habitación con ella."
    mc "Und was ist mit [meg]? Manchmal tut es mir leid, dass ich dich gebeten habe, dein Zimmer mit ihr zu teilen."

# game/scripts/c26/c26.rpy:1444
translate german c26s003_Sai_40d3ff6c:

    # sai "Me lo pediste la semana pasada y no hubo ningún problema. Esta semana ya tiene el coche arreglado y quería volver a su piso después de trabajar."
    sai "Du hast mich letzte Woche gefragt, und da gab es kein Problem. Diese Woche hat er sein Auto reparieren lassen und wollte nach der Arbeit zurück in seine Wohnung."

# game/scripts/c26/c26.rpy:1445
translate german c26s003_Sai_e81e5b4e:

    # sai "No le dejé hacerlo. Para mí, es una más y no me importa compartir la habitación con ella tres días por semana."
    sai "Ich habe es ihr nicht erlaubt. Für mich ist sie einfach ein Mädchen wie jedes andere, und es stört mich nicht, drei Tage die Woche mit ihr ein Zimmer zu teilen."

# game/scripts/c26/c26.rpy:1446
translate german c26s003_Sai_6b2bb13f:

    # sai "O aunque fueran todos los días. Es un cielo y si volviera a su piso después de trabajar seguramente no vendría a las comidas. Y no hubiera conocido a Zeus."
    sai "Selbst wenn es jeden Tag so wäre. Sie ist ein Engel, und wenn sie nach der Arbeit in ihre Wohnung zurückginge, würde sie ganz sicher nicht zu den Mahlzeiten kommen. Und sie hätte Zeus nicht kennengelernt."

# game/scripts/c26/c26.rpy:1447
translate german c26s003_Sai_7c54ac31:

    # mc "*Risa* Te estás convirtiendo en una Marks por derecho propio."
    mc "*lacht* Du entwickelst dich ja selbst zu einem Marks."

# game/scripts/c26/c26.rpy:1449
translate german c26s003_Sai_8e4c9f11:

    # sai "*Risa* He sonado como [eri], ¿verdad?"
    sai "*Lacht* Ich klang wie [eri], nicht wahr?"

# game/scripts/c26/c26.rpy:1450
translate german c26s003_Sai_88166954:

    # mc "*Risa* Un poco."
    mc "*Lacht* Ein bisschen."

# game/scripts/c26/c26.rpy:1451
translate german c26s003_Sai_3adc1161:

    # sai "Es un ejemplo que deberíamos seguir todas. Creo que es la persona menos egoísta que he conocido en mi vida."
    sai "Sie ist ein Vorbild, dem wir alle folgen sollten. Ich glaube, sie ist der uneigennützigste Mensch, den ich je kennengelernt habe."

# game/scripts/c26/c26.rpy:1452
translate german c26s003_Sai_77f618f8:

    # mc "Tienes razón. Creo que esa sería una buena definición de [eri]."
    mc "Du hast Recht. Ich denke, das wäre eine gute Definition von [eri]."

# game/scripts/c26/c26.rpy:1454
translate german c26s003_Sai_0d9207df:

    # sai "Tener a personas como ella alrededor hace que el resto queramos ser mejores personas."
    sai "Menschen wie sie in unserer Umgebung motivieren uns alle, bessere Menschen zu werden."

# game/scripts/c26/c26.rpy:1455
translate german c26s003_Sai_9d236609:

    # mc "Será mejor que ella no te oiga decir eso o empezará a justificarse diciendo que lo que ella hace es lo normal en una familia."
    mc "Am besten ist es, wenn sie das nicht hört, sonst fängt sie an, sich damit zu rechtfertigen, dass ihr Verhalten in einer Familie normal sei."

# game/scripts/c26/c26.rpy:1457
translate german c26s003_Sai_05050b7a:

    # "En ese momento sale [meg] de la habitación que comparte con [sai]."
    "In diesem Moment verlässt [meg] den Raum, den er mit [sai] teilt."

# game/scripts/c26/c26.rpy:1458
translate german c26s003_Sai_57953a1b:

    # meg "Bueno, ya he recogido todo y he cambiado las sábanas."
    meg "Nun ja, ich habe bereits alles aufgeräumt und die Bettwäsche gewechselt."

# game/scripts/c26/c26.rpy:1460
translate german c26s003_Sai_7b197454:

    # sai "No hacía falta que lo hicieras. Me podía ocupar yo de todo."
    sai "Das hättest du nicht tun müssen. Ich hätte mich um alles kümmern können."

# game/scripts/c26/c26.rpy:1461
translate german c26s003_Sai_5d9bb139:

    # mc "¿Ya vuelves a casa?"
    mc "Gehst du schon nach Hause?"

# game/scripts/c26/c26.rpy:1463
translate german c26s003_Sai_a3f0c0f9:

    # meg "Ya sabes, hoy es mi día libre y tengo que hacer la colada para que los vestidos estén listos para mañana."
    meg "Weißt du, heute habe ich frei und ich muss die Wäsche waschen, damit die Kleider morgen fertig sind."

# game/scripts/c26/c26.rpy:1464
translate german c26s003_Sai_ad4e91da:

    # mc "Déjame llevarte la maleta hasta el coche."
    mc "Ich bringe Ihnen Ihren Koffer zum Auto."

# game/scripts/c26/c26.rpy:1466
translate german c26s003_Sai_ea69b5c5:

    # meg "No hace falta. No pesa demasiado."
    meg "Das ist nicht nötig. Es wiegt nicht viel."

# game/scripts/c26/c26.rpy:1467
translate german c26s003_Sai_3b674b4d:

    # mc "Insisto. ¿Lo tienes en el garaje de [nor]?"
    mc "Ich bestehe darauf. Haben Sie es in der [nor]-Garage?"

# game/scripts/c26/c26.rpy:1468
translate german c26s003_Sai_f51e1f39:

    # meg "Sí, y gracias."
    meg "Ja, und vielen Dank."

# game/scripts/c26/c26.rpy:1471
translate german c26s003_Sai_65478830:

    # sai "Cuando dejes la maleta de [meg], ¿podrías venir a mi habitación? Necesito tu ayuda con algo."
    sai "Könntest du bitte in mein Zimmer kommen, wenn du den Koffer von [meg] abgeliefert hast? Ich brauche deine Hilfe."

# game/scripts/c26/c26.rpy:1472
translate german c26s003_Sai_07d76d02:

    # mc "Ningún problema. En unos minutos paso a verte."
    mc "Kein Problem. Ich komme in ein paar Minuten zu dir."

# game/scripts/c26/c26.rpy:1474
translate german c26s003_Sai_7609062c:

    # meg "Chicos, puedo bajar la maleta yo sola. Tú tienes que ir a clase en un par de horas y..."
    meg "Leute, ich kann den Koffer alleine runtertragen. Ihr müsst in ein paar Stunden zur Vorlesung und..."

# game/scripts/c26/c26.rpy:1475
translate german c26s003_Sai_be286a38:

    # mc "[meg], no creo que a [sai] le venga de cinco minutos, ¿verdad?"
    mc "[meg], Ich glaube nicht, dass fünf Minuten helfen werden, [sai] oder?"

# game/scripts/c26/c26.rpy:1477
translate german c26s003_Sai_a1ef25a1:

    # sai "Ni de cinco ni de diez. No hay prisa."
    sai "Nicht fünf, nicht zehn. Es gibt keine Eile."

# game/scripts/c26/c26.rpy:1478
translate german c26s003_Sai_b8d733a1:

    # mc "¿Ves?"
    mc "Sehen?"

# game/scripts/c26/c26.rpy:1481
translate german c26s003_Sai_9a580e0c:

    # "Las chicas se despiden con un abrazo y acompañas a [meg] hasta el garaje de [nor]."
    "Die Mädchen verabschieden sich mit einer Umarmung und du begleitest [meg] zu [nor]s Garage."

# game/scripts/c26/c26.rpy:1482
translate german c26s003_Sai_6db0a5fe:

    # "Los abrazos se repiten con cada chica que os encontráis por el camino."
    "Die Umarmungen werden mit jedem Mädchen wiederholt, dem man unterwegs begegnet."

# game/scripts/c26/c26.rpy:1489
translate german c26s003_Sai2_930cdfaf:

    # "Al llegar al garaje de [nor], una vez metida la maleta de [meg] en su coche."
    "Als er in der Garage von [nor] ankam, war der Koffer von [meg] bereits in seinem Auto."

# game/scripts/c26/c26.rpy:1490
translate german c26s003_Sai2_9a071f80:

    # mc "¿Te lo has pasado bien el fin de semana?"
    mc "Hattest du ein schönes Wochenende?"

# game/scripts/c26/c26.rpy:1491
translate german c26s003_Sai2_16039695:

    # meg "Ha sido fantástico. Con Zeus me reí muchísimo ayer."
    meg "Es war fantastisch. Ich habe gestern so viel mit Zeus gelacht."

# game/scripts/c26/c26.rpy:1492
translate german c26s003_Sai2_d6c49a42:

    # mc "*Risa* No me hables del gato destructor de camas."
    mc "*Lacht* Erzähl mir bloß nichts von der bettzerstörenden Katze."

# game/scripts/c26/c26.rpy:1494
translate german c26s003_Sai2_d4660c91:

    # meg "*Risa* No le eches la culpa al pobre gato. Me han dicho que estabais ocho personas en esa cama."
    meg "*lacht* Gebt nicht der armen Katze die Schuld. Ich habe gehört, ihr wart zu acht in dem Bett."

# game/scripts/c26/c26.rpy:1495
translate german c26s003_Sai2_18754fc0:

    # mc "Sí, pero aguantó bien y no se rompió hasta que no subió Zeus."
    mc "Ja, aber es hat gut gehalten und ist erst kaputt gegangen, als Zeus hinaufstieg."

# game/scripts/c26/c26.rpy:1500
translate german c26s003_Sai2_243c2fa6:

    # meg "Bueno, me tengo que ir. Debo hacer la colada e ir al supermercado."
    meg "So, ich muss jetzt los. Ich muss noch Wäsche waschen und zum Supermarkt fahren."

# game/scripts/c26/c26.rpy:1501
translate german c26s003_Sai2_fc6ca869:

    # mc "Creo que deberías dejar ropa aquí la próxima vez que vengas. No me refiero a los vestidos para el trabajo, pero algo de ropa casual."
    mc "Ich denke, Sie sollten beim nächsten Mal ein paar Kleidungsstücke hier lassen. Ich meine keine Kleider für die Arbeit, sondern eher Freizeitkleidung."

# game/scripts/c26/c26.rpy:1502
translate german c26s003_Sai2_102a9a67:

    # mc "Cuando vuelvas la semana siguiente, estará limpia, y así sólo necesitas ir y venir con lo que necesites para trabajar."
    mc "Wenn Sie in der darauffolgenden Woche wiederkommen, ist alles sauber, sodass Sie nur noch mit dem, was Sie für die Arbeit benötigen, hin und her gehen müssen."

# game/scripts/c26/c26.rpy:1504
translate german c26s003_Sai2_85793322:

    # meg "[mar] me dijo lo mismo, pero no quiero darle más trabajo del necesario."
    meg "[mar] hat mir dasselbe gesagt, aber ich möchte ihm nicht mehr Arbeit machen als nötig."

# game/scripts/c26/c26.rpy:1505
translate german c26s003_Sai2_3709b1e4:

    # mc "Si ella te lo propuso, es porque no le importa. Piénsalo."
    mc "Wenn sie es vorgeschlagen hat, dann deshalb, weil es ihr nichts ausmacht. Denk mal darüber nach."

# game/scripts/c26/c26.rpy:1508
translate german c26s003_Sai2_ea0b53a4:

    # meg "Lo pensaré. Si decido hacerlo antes de que vengas a verme a Westport, quizá te dé un poco de ropa para que la traigas."
    meg "Ich werde darüber nachdenken. Falls ich mich dazu entscheide, bevor du mich in Westport besuchst, gebe ich dir vielleicht ein paar Kleidungsstücke mit, die du mitbringen kannst."

# game/scripts/c26/c26.rpy:1509
translate german c26s003_Sai2_17c67712:

    # meg "Así podré venir con una maleta más pequeña, solo con los vestidos. Y no tendrás que cargarla arriba y abajo."
    meg "So kann ich mit einem kleineren Koffer kommen, nur mit den Kleidern. Und du musst ihn nicht ständig rauf und runter tragen."

# game/scripts/c26/c26.rpy:1511
translate german c26s003_Sai2_c03768b0:

    # meg "Lo pensaré. Si decido hacerlo, podré venir con una maleta más pequeña dentro de dos semanas, solo con los vestidos."
    meg "Ich werde darüber nachdenken. Wenn ich mich dafür entscheide, kann ich in zwei Wochen mit einem kleineren Koffer zurückkommen, nur mit den Kleidern."

# game/scripts/c26/c26.rpy:1512
translate german c26s003_Sai2_3b48fe12:

    # meg "Y no tendrás que ir arriba y abajo con ella."
    meg "Und du musst nicht mehr mit ihr rauf und runter gehen."

# game/scripts/c26/c26.rpy:1513
translate german c26s003_Sai2_f5271567:

    # mc "Me parece una buena idea."
    mc "Ich finde das eine gute Idee."

# game/scripts/c26/c26.rpy:1516
translate german c26s003_Sai2_0045e65e:

    # meg "Te veo el fin de semana, o cuando quieras pasar por mi apartamento."
    meg "Wir sehen uns am Wochenende, oder wann immer du in meiner Wohnung vorbeikommen möchtest."

# game/scripts/c26/c26.rpy:1518
translate german c26s003_Sai2_6f25a080:

    # meg "Te veo el fin de semana que viene."
    meg "Wir sehen uns nächstes Wochenende."

# game/scripts/c26/c26.rpy:1519
translate german c26s003_Sai2_f19a724f:

    # mc "Conduce con cuidado."
    mc "Fahre vorsichtig."

# game/scripts/c26/c26.rpy:1522
translate german c26s003_Sai2_4abe6172:

    # "Os dais un abrazo de despedida antes de que suba al coche."
    "Bevor ich ins Auto steige, umarmen wir uns zum Abschied."

# game/scripts/c26/c26.rpy:1533
translate german c26s002_Solomon_64a1454b:

    # "Mientras [sai] te enseñaba las fotos, en la comisaría..."
    "Während [sai] Ihnen die Fotos zeigte, auf der Polizeiwache..."

# game/scripts/c26/c26.rpy:1535
translate german c26s002_Solomon_9175ac4f:

    # sol "Buenos días, Agente. Le traigo lo que me pidió."
    sol "Guten Morgen, Agent. Ich habe Ihnen gebracht, was Sie bestellt haben."

# game/scripts/c26/c26.rpy:1537
translate german c26s002_Solomon_eec332cc:

    # oma "Bien. Se ha tomado su tiempo. Ha tardado una semana entera."
    oma "Gut. Es hat seine Zeit gebraucht. Es hat eine ganze Woche gedauert."

# game/scripts/c26/c26.rpy:1539
translate german c26s002_Solomon_22b132fb:

    # sol "Lo siento... No me lo han entregado hasta hoy. No he podido hacerlo antes."
    sol "Es tut mir leid... Ich habe es erst heute erhalten. Vorher war es mir nicht möglich."

# game/scripts/c26/c26.rpy:1541
translate german c26s002_Solomon_1e87be37:

    # oma "Bueno, vamos a ir a entregarlo."
    oma "Okay, dann lasst es uns ausliefern."

# game/scripts/c26/c26.rpy:1543
translate german c26s002_Solomon_3ebb979f:

    # oma "¡Schrute! Sustitúyeme en el mostrador. Tengo que acompañar a este señor a un sitio."
    oma "Schrute! Nimm meinen Platz am Tresen ein. Ich muss diesen Herrn irgendwohin begleiten."

# game/scripts/c26/c26.rpy:1544
translate german c26s002_Solomon_285a9ffa:

    # "Schrute" "*Desde la parte de atrás* No te preocupes, ahora voy."
    "Schrute" "*Von hinten* Keine Sorge, ich komme jetzt."

# game/scripts/c26/c26.rpy:1546
translate german c26s002_Solomon_67f955f6:

    # sol "¿Vamos a ir ahora? ¿Tengo que ir yo también?"
    sol "Fahren wir jetzt? Muss ich auch mitkommen?"

# game/scripts/c26/c26.rpy:1548
translate german c26s002_Solomon_5f4f5eb1:

    # oma "Sí, tiene que venir. Aunque sea tan solo por una vez en su vida, compórtese como un hombre."
    oma "Ja, er muss kommen. Selbst wenn es nur dieses eine Mal in seinem Leben ist, soll er sich wie ein Mann benehmen."

# game/scripts/c26/c26.rpy:1549
translate german c26s002_Solomon_ca3bdd91:

    # oma "Si quiere comportarse como una damisela asustada, puedo llamar a mi hermana la rubia para que le... 'ayude'... a encontrar sus cojones."
    oma "Wenn du dich wie ein verängstigtes, hilfloses Mädchen benehmen willst, kann ich meine blonde Schwester anrufen, um dir zu helfen, deine Eier wiederzufinden."

# game/scripts/c26/c26.rpy:1551
translate german c26s002_Solomon_77044a79:

    # sol "¡Vale, vale! Vamos..."
    sol "Okay, okay! Los geht's..."

# game/scripts/c26/c26.rpy:1553
translate german c26s002_Solomon_9e3b875d:

    # "Un par de minutos después, en la puerta de la biblioteca..."
    "Ein paar Minuten später, an der Bibliothekstür..."

# game/scripts/c26/c26.rpy:1554
translate german c26s002_Solomon_e5fa05fa:

    # sol "¿Estoy bien?"
    sol "Mir geht es gut?"

# game/scripts/c26/c26.rpy:1556
translate german c26s002_Solomon_6c4d82a9:

    # oma "No creo que hayas estado bien en tu vida, [sol]."
    oma "Ich glaube nicht, dass es dir in deinem Leben gut ging, [sol]."

# game/scripts/c26/c26.rpy:1557
translate german c26s002_Solomon_736e3492:

    # oma "Además, no te iba a servir de mucho. No va a volver contigo aunque ella quisiera."
    oma "Außerdem würde es dir nicht viel nützen. Sie käme sowieso nicht zu dir zurück, selbst wenn sie wollte."

# game/scripts/c26/c26.rpy:1559
translate german c26s002_Solomon_62ca9c3d:

    # sol "¿Aunque ella quisiera? ¿Significa eso que hay una oportunidad?"
    sol "Selbst wenn sie es wollte? Bedeutet das, dass eine Chance besteht?"

# game/scripts/c26/c26.rpy:1561
translate german c26s002_Solomon_b6bf24d4:

    # oma "No. Significa que si, por alguna razón desconocida, quisiera volver contigo, haría lo posible para que la encerraran en un psiquiátrico antes de dejarle hacerlo."
    oma "Nein. Es bedeutet, dass ich, falls sie aus irgendeinem unbekannten Grund zu dir zurückkommen wollte, alles daransetzen würde, sie in eine psychiatrische Klinik einweisen zu lassen, bevor ich sie das tun ließe."

# game/scripts/c26/c26.rpy:1562
translate german c26s002_Solomon_2404cc94:

    # oma "Pero no te preocupes. No tienes ninguna oportunidad. Por primera vez es libre y está descubriendo lo que es vivir. Sin ti."
    oma "Aber keine Sorge. Du hast keine Chance. Zum ersten Mal ist sie frei und entdeckt, was es heißt zu leben. Ohne dich."

# game/scripts/c26/c26.rpy:1564
translate german c26s002_Solomon_01e35e09:

    # sol "No he sido tan malo... Los hay peores."
    sol "So schlimm war ich gar nicht... Es gibt Schlimmeres."

# game/scripts/c26/c26.rpy:1566
translate german c26s002_Solomon_6675abed:

    # oma "Sí, los hay que asesinan a sus mujeres porque dicen que las quieren. Creo que es la única categoría peor que tú."
    oma "Ja, es gibt Männer, die ihre Frauen ermorden, weil sie behaupten, sie zu lieben. Ich glaube, das ist die einzige Kategorie, die noch schlimmer ist als du."

# game/scripts/c26/c26.rpy:1567
translate german c26s002_Solomon_918ecc60:

    # oma "Además, tú eres más patético."
    oma "Außerdem bist du noch viel erbärmlicher."

# game/scripts/c26/c26.rpy:1568
translate german c26s002_Solomon_35e4180c:

    # oma "Vamos dentro antes de que vomite del asco que me das."
    oma "Lass uns reingehen, bevor ich mich vor lauter Ekel vor dir übergeben muss."

# game/scripts/c26/c26.rpy:1570
translate german c26s002_Solomon_da133d0a:

    # kia "¡[sol]! ¿Qué haces aquí? ¿Y tú, [oma]?"
    kia "[sol]! Was machst du hier? Und du, [oma]?"

# game/scripts/c26/c26.rpy:1572
translate german c26s002_Solomon_d20d4b90:

    # oma "No te preocupes, ha sido idea mía. Y le acompaño para que no intente nada raro."
    oma "Keine Sorge, es war meine Idee. Und ich begleite ihn, damit er nichts Seltsames versucht."

# game/scripts/c26/c26.rpy:1573
translate german c26s002_Solomon_45bdb1a3:

    # oma "[sol], di lo que tengas que decir."
    oma "[sol], sag, was du zu sagen hast."

# game/scripts/c26/c26.rpy:1575
translate german c26s002_Solomon_6a84d3e4:

    # sol "Venía a entregarte esto... pero sólo si quieres..."
    sol "Ich bin gekommen, um dir das zu geben... aber nur, wenn du es willst..."

# game/scripts/c26/c26.rpy:1576
translate german c26s002_Solomon_3d2cabb8:

    # sol "Si quieres... puedes volver a casa..."
    sol "Wenn du willst, kannst du nach Hause zurückkehren..."

# game/scripts/c26/c26.rpy:1578
translate german c26s002_Solomon_948c80e0:

    # kia "¿Qué es?"
    kia "Was ist das?"

# game/scripts/c26/c26.rpy:1581
translate german c26s002_Solomon_d72cf8d8:

    # oma "Ábrelo, [kia]. Por temas legales, digamos que te lo he entregado yo."
    oma "Öffne es, [kia]. Aus rechtlichen Gründen sagen wir einfach, ich hätte es dir gegeben."

# game/scripts/c26/c26.rpy:1584
translate german c26s002_Solomon_536d5186:

    # kia "¿El divorcio? ¿Me estás pidiendo el divorcio?"
    kia "Scheidung? Willst du mich etwa scheiden lassen?"

# game/scripts/c26/c26.rpy:1586
translate german c26s002_Solomon_c9e2029a:

    # sol "No es que yo quiera, pero..."
    sol "Nicht, dass ich das wollte, aber..."

# game/scripts/c26/c26.rpy:1588
translate german c26s002_Solomon_6199a8c7:

    # oma "[sol], ya te puedes ir. Ni siquiera deberías estar aquí para entregar los papeles."
    oma "[sol], Sie können jetzt gehen. Sie müssten gar nicht hier sein, um die Unterlagen abzugeben."

# game/scripts/c26/c26.rpy:1589
translate german c26s002_Solomon_a4ad4d00:

    # oma "Eso va en contra de las condiciones con las que has pedido el divorcio."
    oma "Das widerspricht den Umständen, unter denen Sie die Scheidung eingereicht haben."

# game/scripts/c26/c26.rpy:1591
translate german c26s002_Solomon_ba65e4e8:

    # sol "¡Pero ha sido usted quien me ha dicho que debía venir yo!"
    sol "Aber du warst es doch, der mir gesagt hat, dass ich kommen muss!"

# game/scripts/c26/c26.rpy:1593
translate german c26s002_Solomon_66adef48:

    # oma "No quería perderme ver cómo lloriqueabas hasta el último momento."
    oma "Ich wollte es mir nicht entgehen lassen, dich bis zum allerletzten Moment jammern zu sehen."

# game/scripts/c26/c26.rpy:1595
translate german c26s002_Solomon_592217a4:

    # kia "Espera un momento, [oma]."
    kia "Einen Moment bitte, [oma]."

# game/scripts/c26/c26.rpy:1596
translate german c26s002_Solomon_d523cf11:

    # kia "Aquí pone que me cedes la casa... Bueno, tu mitad de la casa."
    kia "Hier steht, dass du mir das Haus gibst... Na ja, deine Hälfte des Hauses."

# game/scripts/c26/c26.rpy:1598
translate german c26s002_Solomon_dcf9ebe3:

    # sol "Es lo que me dijo la Agente Martinez. Además, sin trabajo no puedo pagar la hipoteca y la acabaría perdiendo."
    sol "Das hat mir Agent Martinez gesagt. Außerdem kann ich ohne Job die Hypothek nicht bezahlen und würde sie am Ende verlieren."

# game/scripts/c26/c26.rpy:1599
translate german c26s002_Solomon_be90933b:

    # sol "Me iré a vivir con un amigo de mi antiguo trabajo y con su novia hasta que encuentre algo."
    sol "Ich werde vorübergehend bei einem Freund aus meiner alten Arbeitsstelle und seiner Freundin wohnen, bis ich etwas finde."

# game/scripts/c26/c26.rpy:1601
translate german c26s002_Solomon_64f1345d:

    # kia "¿También me das los ahorros?"
    kia "Gibst du mir auch die Ersparnisse?"

# game/scripts/c26/c26.rpy:1603
translate german c26s002_Solomon_5922a6da:

    # sol "La Agente Martinez..."
    sol "Agent Martinez..."

# game/scripts/c26/c26.rpy:1605
translate german c26s002_Solomon_277d44cf:

    # kia "Los ahorros te los puedes quedar para empezar de nuevo. No hay mucho y el valor de la casa es mayor, con lo que me parece justo."
    kia "Du kannst deine Ersparnisse behalten und neu anfangen. Es ist nicht viel, und das Haus ist mehr wert, daher finde ich es fair."

# game/scripts/c26/c26.rpy:1607
translate german c26s002_Solomon_0f1615a5:

    # oma "[kia], esto no lo tenéis que discutir ahora. Te hemos... te he entregado los papeles y ahora tienes 30 días para responder a la petición."
    oma "[kia], Sie brauchen das jetzt nicht zu besprechen. Wir haben... Ich habe Ihnen die Unterlagen gegeben, und Sie haben nun 30 Tage Zeit, auf die Anfrage zu antworten."

# game/scripts/c26/c26.rpy:1608
translate german c26s002_Solomon_459c0397:

    # oma "La división de bienes puede venir después, y lo ideal sería que fuera con ayuda de un abogado. Hay que hacer una Declaración de Bienes y otras cosas."
    oma "Die Aufteilung des Vermögens kann später erfolgen und sollte idealerweise mit Unterstützung eines Anwalts durchgeführt werden. Eine Vermögensaufstellung und weitere Dokumente müssen erstellt werden."

# game/scripts/c26/c26.rpy:1610
translate german c26s002_Solomon_24b820e7:

    # kia "Lo entiendo... Creía que... En las películas..."
    kia "Ich verstehe... Ich dachte, das wäre... In den Filmen..."

# game/scripts/c26/c26.rpy:1612
translate german c26s002_Solomon_2161c1e0:

    # oma "No te preocupes, no es complicado. Te ayudaremos con lo que necesites."
    oma "Keine Sorge, es ist nicht kompliziert. Wir helfen Ihnen bei allem, was Sie brauchen."

# game/scripts/c26/c26.rpy:1613
translate german c26s002_Solomon_724e39f9:

    # oma "Tienes que firmar el recibo como que te he entregado los papeles y dármelo. No tienes que firmar los papeles aún."
    oma "Sie müssen die Empfangsbestätigung unterschreiben, um zu bestätigen, dass ich Ihnen die Unterlagen ausgehändigt habe, und sie mir zurückgeben. Sie müssen die Unterlagen noch nicht unterschreiben."

# game/scripts/c26/c26.rpy:1615
translate german c26s002_Solomon_7b347fac:

    # oma "[sol], te puedes marchar."
    oma "[sol], du kannst gehen."

# game/scripts/c26/c26.rpy:1617
translate german c26s002_Solomon_61eeb2e4:

    # sol "Aún podemos arreglarlo..."
    sol "Wir können es noch reparieren..."

# game/scripts/c26/c26.rpy:1619
translate german c26s002_Solomon_72628501:

    # oma "[sol], vete antes de que me arrepienta de haberte dado esta oportunidad."
    oma "[sol], geh, bevor ich es bereue, dir diese Gelegenheit gegeben zu haben."

# game/scripts/c26/c26.rpy:1621
translate german c26s002_Solomon_db74d5b2:

    # "[sol] se va inmediatamente."
    "[sol] verlässt das Haus sofort."

# game/scripts/c26/c26.rpy:1622
translate german c26s002_Solomon_65cd5ea3:

    # "[kia] firma el recibo y se lo entrega a [oma]..."
    "[kia] unterschreibt die Quittung und übergibt sie [oma]..."

# game/scripts/c26/c26.rpy:1623
translate german c26s002_Solomon_8d6dc5e2:

    # kia "¿Le has obligado a hacer esto? ¿Cómo?"
    kia "Hast du ihn dazu gezwungen? Wie?"

# game/scripts/c26/c26.rpy:1625
translate german c26s002_Solomon_9acdbcd0:

    # oma "Vino a comisaría a poner una denuncia falsa contra [mc] por lo que pasó en la fiesta de cumpleaños. Ese día estaba yo en el mostrador."
    oma "Sie kam zur Polizeiwache, um eine falsche Anzeige gegen [mc] wegen des Vorfalls auf der Geburtstagsfeier zu erstatten. Ich war an dem Tag am Schalter."

# game/scripts/c26/c26.rpy:1626
translate german c26s002_Solomon_9cf2e232:

    # oma "Le di a elegir entre la cárcel y pedirte el divorcio. Lloriqueó un poco con lo de ser católico antes de aceptar."
    oma "Ich stellte ihn vor die Wahl zwischen Gefängnis und Scheidung. Er jammerte kurz über seinen katholischen Glauben, bevor er einwilligte."

# game/scripts/c26/c26.rpy:1627
translate german c26s002_Solomon_b4dff185:

    # oma "Supongo que sus convicciones religiosas no son tan fuertes como su miedo a acabar en prisión."
    oma "Ich vermute, seine religiösen Überzeugungen sind nicht so stark ausgeprägt wie seine Angst, im Gefängnis zu landen."

# game/scripts/c26/c26.rpy:1628
translate german c26s002_Solomon_83846a8a:

    # oma "Por lo que pudiera ser, le he dicho que no se acercara a menos de un metro del mostrador. No me fío de él."
    oma "Sicherheitshalber habe ich ihm gesagt, er solle sich dem Tresen nicht auf weniger als einen Meter nähern. Ich traue ihm nicht."

# game/scripts/c26/c26.rpy:1630
translate german c26s002_Solomon_79803981:

    # kia "Siempre ha sido un cobarde y un mentiroso..."
    kia "Er war schon immer ein Feigling und ein Lügner..."

# game/scripts/c26/c26.rpy:1636
translate german c26s002_Solomon_98004f52:

    # kia "Gracias, [oma]. Nunca lo habría logrado sin ti."
    kia "Vielen Dank, [oma]. Ohne dich hätte ich es nie geschafft."

# game/scripts/c26/c26.rpy:1637
translate german c26s002_Solomon_4ca9cb59:

    # oma "No tienes por qué darme las gracias. En esta familia estamos para ayudarnos entre nosotras, ¿no?"
    oma "Du brauchst mir nicht zu danken. In dieser Familie helfen wir uns gegenseitig, nicht wahr?"

# game/scripts/c26/c26.rpy:1639
translate german c26s002_Solomon_7135fc61:

    # oma "Me sentí muy mal cuando fuimos a tu antigua casa y me tuve que ir poco antes de que [sol] llegara. Afortunadamente, [mc] estaba allí."
    oma "Es tat mir wirklich leid, als wir zu deinem alten Haus fuhren und ich kurz vor [sol]s Ankunft gehen musste. Zum Glück war [mc] da."

# game/scripts/c26/c26.rpy:1640
translate german c26s002_Solomon_c7cf9799:

    # oma "Esta vez, he podido ayudar sin tener que depender de que él haga algo."
    oma "Diesmal konnte ich helfen, ohne auf seine Hilfe angewiesen zu sein."

# game/scripts/c26/c26.rpy:1642
translate german c26s002_Solomon_3f03771a:

    # kia "No tienes que sentirte mal, [oma]. No podéis estar todo el día para protegerme de [sol]."
    kia "Du musst dich nicht schlecht fühlen, [oma]. Du kannst nicht den ganzen Tag hier sein, um mich vor [sol] zu beschützen."

# game/scripts/c26/c26.rpy:1644
translate german c26s002_Solomon_54cf5776:

    # oma "Parece que, con un poco de suerte, ya no será necesario."
    oma "Mit ein bisschen Glück wird es dann wohl nicht mehr nötig sein."

# game/scripts/c26/c26.rpy:1646
translate german c26s002_Solomon_1c3c6881:

    # kia "Gracias a ti."
    kia "Vielen Dank."

# game/scripts/c26/c26.rpy:1649
translate german c26s002_Solomon_976ea1f8:

    # oma "Hablando de [mc]..."
    oma "Apropos [mc]..."

# game/scripts/c26/c26.rpy:1651
translate german c26s002_Solomon_dc2d7156:

    # kia "*Risa* Me parece que nos pasamos la vida hablando de él."
    kia "*lacht* Ich habe das Gefühl, wir verbringen unser ganzes Leben damit, über ihn zu reden."

# game/scripts/c26/c26.rpy:1653
translate german c26s002_Solomon_4a8c1eb8:

    # oma "*Risa* Tienes razón. Todo esto es muy nuevo..."
    oma "*lacht* Stimmt. Das ist alles ganz neu..."

# game/scripts/c26/c26.rpy:1656
