

# game/scripts/c26/c26.rpy:60
translate german c26s001_MeeDate_e99f27ed:

    # mc "¡Estás guapísima!"
    mc "Du siehst umwerfend aus!"

# game/scripts/c26/c26.rpy:61
translate german c26s001_MeeDate_ba895501:

    # mee "Bueno, una chica tiene que arreglarse para una cita, ¿no? *Risita*"
    mee "Na ja, ein Mädchen muss sich für ein Date ja schließlich schick machen, oder? *Kichert*"

# game/scripts/c26/c26.rpy:62
translate german c26s001_MeeDate_0d115086:

    # mc "Creía que no era una cita. O que decidirías luego si era una cita."
    mc "Ich dachte, es wäre kein Date. Oder dass du später entscheiden würdest, ob es ein Date ist."

# game/scripts/c26/c26.rpy:64
translate german c26s001_MeeDate_e3bc7b7a:

    # mee "Bueno, pues una mujer tiene que arreglarse cuando va a cenar con su nieto."
    mee "Nun ja, eine Frau muss sich schick anziehen, wenn sie mit ihrem Enkel zu Abend isst."

# game/scripts/c26/c26.rpy:65
translate german c26s001_MeeDate_2e05c372:

    # mee "Ya decidiremos luego si ha sido una cita o no."
    mee "Ob es ein Date war oder nicht, entscheiden wir später."

# game/scripts/c26/c26.rpy:66
translate german c26s001_MeeDate_5f06014d:

    # mc "Sea lo que sea, te aseguro que, en el restaurante, todos los clientes me van a mirar preguntándose cómo puedo ir con una mujer tan guapa."
    mc "Was auch immer es ist, ich versichere Ihnen, dass im Restaurant alle Gäste mich ansehen und sich fragen werden, wie ich mit einer so schönen Frau zusammen sein kann."

# game/scripts/c26/c26.rpy:68
translate german c26s001_MeeDate_459bf8be:

    # mee "No te va a mirar nadie preguntándose eso mientras cenamos. *Risa*"
    mee "Niemand wird dich beim Abendessen fragen, ob du das weißt. *lacht*"

# game/scripts/c26/c26.rpy:69
translate german c26s001_MeeDate_881dfb18:

    # mc "¿Quieres apostar?"
    mc "Willst du wetten?"

# game/scripts/c26/c26.rpy:70
translate german c26s001_MeeDate_d11d3718:

    # mee "Vale. ¿Qué quieres apostar?"
    mee "Okay. Worauf möchten Sie wetten?"

# game/scripts/c26/c26.rpy:71
translate german c26s001_MeeDate_8d6c7502:

    # mc "Si me miran al menos cinco clientes... y decides que es una cita... hoy duermes en mi habitación."
    mc "Wenn mich mindestens fünf Kunden ansehen... und du dich für ein Date entscheidest... dann schläfst du heute Nacht in meinem Zimmer."

# game/scripts/c26/c26.rpy:72
translate german c26s001_MeeDate_1813fcb9:

    # mc "Aunque mi cama ha sufrido un pequeño accidente por culpa de un gato."
    mc "Obwohl mein Bett durch eine Katze einen kleinen Unfall erlitten hat."

# game/scripts/c26/c26.rpy:74
translate german c26s001_MeeDate_9be46529:

    # mee "*Risa* Lo sé, me lo ha contado [nor]."
    mee "*Lacht* Ich weiß, [nor] hat es mir erzählt."

# game/scripts/c26/c26.rpy:75
translate german c26s001_MeeDate_28bf38f2:

    # mee "La apuesta me parece bien, pero ¿y si no te mira nadie?"
    mee "Die Idee klingt gut, aber was, wenn niemand zuschaut?"

# game/scripts/c26/c26.rpy:76
translate german c26s001_MeeDate_efcb438e:

    # mc "No sé. Decide tú."
    mc "Ich weiß es nicht. Entscheide du."

# game/scripts/c26/c26.rpy:77
translate german c26s001_MeeDate_72d55a83:

    # mee "Si no te mira nadie, tú duermes en la mía. Si decidimos que es una cita, claro. *Risita* Al menos la mía tiene una cama en buen estado."
    mee "Wenn keiner zuschaut, kannst du bei mir schlafen. Natürlich nur, wenn wir uns verabreden. *Kichert* Mein Bett ist wenigstens anständig."

# game/scripts/c26/c26.rpy:78
translate german c26s001_MeeDate_996f86d2:

    # mc "Parece un buen plan. *Risa* Sea como sea, hoy dormiremos juntos. Si {b}decides{/b} que es una cita."
    mc "Klingt nach einem guten Plan. *lacht* Jedenfalls schlafen wir heute Nacht zusammen. Falls du es als Date bezeichnest."

# game/scripts/c26/c26.rpy:80
translate german c26s001_MeeDate_1a6fe4e8:

    # mee "[mc]..."
    mee "[mc]..."

# game/scripts/c26/c26.rpy:81
translate german c26s001_MeeDate_b9ae80eb:

    # mc "¿Pasa algo, Meemaw?"
    mc "Ist etwas nicht in Ordnung, Meemaw?"

# game/scripts/c26/c26.rpy:83
translate german c26s001_MeeDate_7dde478e:

    # mee "¿Podemos dejar de fingir que esto no es una cita?"
    mee "Können wir endlich aufhören so zu tun, als wäre das kein Date?"

# game/scripts/c26/c26.rpy:84
translate german c26s001_MeeDate_1da4a18b:

    # mee "Hace días que decidí que lo sería, y me muero por besarte..."
    mee "Ich habe es schon vor Tagen beschlossen, und ich kann es kaum erwarten, dich zu küssen..."

# game/scripts/c26/c26.rpy:86
translate german c26s001_MeeDate_e2be6ff0:

    # "No tienes que responder. Al menos no con palabras. Tus labios besan los de [mee] con dulzura."
    "Du musst nicht antworten. Zumindest nicht mit Worten. Deine Lippen küssen sanft [mee]."

# game/scripts/c26/c26.rpy:87
translate german c26s001_MeeDate_672bd482:

    # "Su cuerpo tiembla bajo tu tacto hasta que se separa reluctantemente de tus labios."
    "Ihr Körper zittert unter deiner Berührung, bis sie sich widerwillig von deinen Lippen löst."

# game/scripts/c26/c26.rpy:89
translate german c26s001_MeeDate_bf01fb4d:

    # mee "*Respirando pesadamente* Creo que como aperitivo hay suficiente."
    mee "*Schwer atmend* Ich glaube, das reicht als Vorspeise."

# game/scripts/c26/c26.rpy:90
translate german c26s001_MeeDate_7ee46f6f:

    # mc "Hay que dejar más besos para después de la cena, ¿no?"
    mc "Die Küsse sollten wir uns für nach dem Abendessen aufheben, nicht wahr?"

# game/scripts/c26/c26.rpy:91
translate german c26s001_MeeDate_dc680032:

    # mc "Por cierto, ¿dónde vamos a ir?"
    mc "Übrigens, wohin fahren wir?"

# game/scripts/c26/c26.rpy:93
translate german c26s001_MeeDate_91f1b43e:

    # mee "He alquilado un sitio en San Luis."
    mee "Ich habe mir eine Wohnung in San Luis gemietet."

# game/scripts/c26/c26.rpy:94
translate german c26s001_MeeDate_9413e0d6:

    # mc "¿Alquilado? Querrás decir reservado, ¿no?"
    mc "Gemietet? Du meinst reserviert, oder?"

# game/scripts/c26/c26.rpy:95
translate german c26s001_MeeDate_95b80b24:

    # mee "Lo tendrás que descubrir cuando lleguemos."
    mee "Das wirst du erfahren, wenn wir dort ankommen."

# game/scripts/c26/c26.rpy:97
translate german c26s001_MeeDate_057020cc:

    # "[mee] introduce la dirección en el GPS. Llegaréis en unos 30 minutos."
    "Geben Sie die Adresse in Ihr Navigationsgerät ein. Sie werden in etwa 30 Minuten ankommen."

# game/scripts/c26/c26.rpy:98
translate german c26s001_MeeDate_0bc6dfbf:

    # "Cuando faltan unos minutos para llegar, hace una llamada, indicando que estáis a menos de cinco minutos."
    "Wenn nur noch wenige Minuten bis zur Ankunft verbleiben, ruft er an und signalisiert, dass Sie in weniger als fünf Minuten da sind."

# game/scripts/c26/c26.rpy:99
translate german c26s001_MeeDate_6a7ea241:

    # "Parece que le dan unas indicaciones con las que te guía hasta una rotonda desde la que salen varios caminos empedrados que se adentran en el bosque."
    "Anscheinend erhält man eine Wegbeschreibung, die zu einem Kreisverkehr führt, von dem aus mehrere gepflasterte Wege in den Wald abzweigen."

# game/scripts/c26/c26.rpy:101
translate german c26s001_MeeDate_455e492e:

    # "Aparcas la camioneta en el lugar que te indica [mee] y camináis unos minutos por uno de los caminos rodeado de árboles."
    "Sie parken den Lieferwagen an der mit [mee] gekennzeichneten Stelle und gehen einige Minuten auf einem der von Bäumen gesäumten Wege entlang."

# game/scripts/c26/c26.rpy:103
translate german c26s001_MeeDate_ab3a7912:

    # "Al girar por una de las curvas del camino, aparece una visión de cuento en medio de un claro en el bosque."
    "Wenn man eine der Kurven der Straße durchfährt, erscheint mitten auf einer Lichtung im Wald eine märchenhafte Vision."

# game/scripts/c26/c26.rpy:105
translate german c26s001_MeeDate_7f6a5a0f:

    # mc "¡Wow, Meemaw! ¡Es precioso!"
    mc "Wow, Oma! Es ist wunderschön!"

# game/scripts/c26/c26.rpy:106
translate german c26s001_MeeDate_4b08a348:

    # mee "¿Te gusta? No mucha gente conoce este sitio."
    mee "Gefällt es dir? Nicht viele Leute kennen diesen Ort."

# game/scripts/c26/c26.rpy:107
translate german c26s001_MeeDate_cbb0a18f:

    # mc "Es increíble. ¿Cómo es que tú lo conoces?"
    mc "Das ist unglaublich. Woher kennst du ihn?"

# game/scripts/c26/c26.rpy:109
translate german c26s001_MeeDate_7cab5fb6:

    # mee "Vendí estos terrenos unos años antes de que nacieras."
    mee "Ich habe dieses Grundstück einige Jahre vor deiner Geburt verkauft."

# game/scripts/c26/c26.rpy:110
translate german c26s001_MeeDate_9f3b7009:

    # mee "Iban a construir un hotel también, pero al final no lo hicieron y sólo construyeron el restaurante."
    mee "Sie wollten auch ein Hotel bauen, haben es dann aber doch nicht getan und nur das Restaurant gebaut."

# game/scripts/c26/c26.rpy:111
translate german c26s001_MeeDate_1723bb21:

    # mc "¿Dónde están los camareros? Si tienen que venir por el camino empedrado más les vale ir en patinete."
    mc "Wo sind die Kellner? Wenn sie schon über den Kopfsteinpflasterweg kommen müssen, sollten sie besser mit dem Roller fahren."

# game/scripts/c26/c26.rpy:113
translate german c26s001_MeeDate_d63bcc5f:

    # mee "*Risa* Este sitio no funciona así, cariño. Pedí la comida cuando lo alquilé."
    mee "*Lacht* So läuft das hier nicht, Schatz. Ich habe das Essen bestellt, als ich das Haus gemietet habe."

# game/scripts/c26/c26.rpy:114
translate german c26s001_MeeDate_99282fef:

    # mee "Lo han preparado todo en el gazebo cuando he llamado."
    mee "Als ich anrief, war im Pavillon schon alles vorbereitet."

# game/scripts/c26/c26.rpy:115
translate german c26s001_MeeDate_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c26/c26.rpy:117
translate german c26s001_MeeDate_173a4dc2:

    # mee "¿Qué tal si respondo a tus preguntas allí? *Risa* Parecemos dos idiotas en medio del bosque."
    mee "Wie wäre es, wenn ich Ihre Fragen dort beantworte? *lacht* Wir sehen aus wie zwei Idioten mitten im Wald."

# game/scripts/c26/c26.rpy:118
translate german c26s001_MeeDate_6d7821fa:

    # mc "*Risa* Tienes razón. Te sigo."
    mc "*Lacht* Du hast recht. Ich folge dir."

# game/scripts/c26/c26.rpy:120
translate german c26s001_MeeDate_f6d4cb0b:

    # mee "¿Ves? Detrás tuyo tienes los cortes fríos y aquí la comida caliente."
    mee "Sehen Sie? Hinter Ihnen befindet sich der Aufschnitt und hier drüben das warme Essen."

# game/scripts/c26/c26.rpy:121
translate german c26s001_MeeDate_52b33d7d:

    # mc "Incluso tiene un sofá. Es un sitio genial. Muy romántico."
    mc "Es gibt dort sogar ein Sofa. Ein toller Ort. Sehr romantisch."

# game/scripts/c26/c26.rpy:123
translate german c26s001_MeeDate_b9260d76:

    # mee "Nunca más vamos a tener una primera cita, con lo que quería que fuera especial."
    mee "Wir werden nie wieder ein erstes Date haben, deshalb wollte ich, dass es etwas Besonderes wird."

# game/scripts/c26/c26.rpy:124
translate german c26s001_MeeDate_5ebadfc3:

    # mc "Lo has conseguido. Es precioso."
    mc "Du hast es geschafft. Es ist wunderschön."

# game/scripts/c26/c26.rpy:126
translate german c26s001_MeeDate_f21303a6:

    # mee "Y, como puedes ver, ningún cliente te va a mirar preguntándose nada. *Risa*"
    mee "Und wie Sie sehen, wird kein Kunde Sie fragend ansehen. *lacht*"

# game/scripts/c26/c26.rpy:127
translate german c26s001_MeeDate_17501436:

    # mee "Hoy duermes en mi habitación."
    mee "Du schläfst heute Nacht in meinem Zimmer."

# game/scripts/c26/c26.rpy:128
translate german c26s001_MeeDate_0cf017ca:

    # mc "*Risa* Eso es trampa. Tú sabías que habías ganado la apuesta antes de hacerla."
    mc "*Lacht* Das ist Betrug. Du wusstest schon vor der Wette, dass du gewonnen hast."

# game/scripts/c26/c26.rpy:130
translate german c26s001_MeeDate_b614db1b:

    # mee "*Risa* Nunca apuestes a ciegas, cielo."
    mee "*lacht* Man sollte niemals blindlings wetten, Liebling."

# game/scripts/c26/c26.rpy:131
translate german c26s001_MeeDate_402e9590:

    # mee "Además, no quieres que una pobre anciana duerma en un colchón en el suelo."
    mee "Außerdem möchte man ja nicht, dass eine arme, alte Frau auf einer Matratze auf dem Boden schläft."

# game/scripts/c26/c26.rpy:132
translate german c26s001_MeeDate_2b8fc357:

    # mc "*Risa* En este caso, es una apuesta que no me importa perder."
    mc "*Lacht* In diesem Fall ist es eine Wette, die ich gerne verliere."

# game/scripts/c26/c26.rpy:133
translate german c26s001_MeeDate_9f69baf8:

    # mee "Coge la comida que quieras. No sabía qué te apetecería y he pedido muchísima comida."
    mee "Nimm dir, was du essen möchtest. Ich wusste nicht, was du möchtest, deshalb habe ich viel Essen bestellt."

# game/scripts/c26/c26.rpy:135
translate german c26s001_MeeDate_9a3a27e0:

    # "[mee] no miente. Hay comida para alimentar a la mitad de la familia. Especialmente si dentro de esa mitad no está Jamaal."
    "[mee] Er lügt nicht. Es ist genug Essen da, um die halbe Familie zu ernähren. Vor allem, wenn Jamaal nicht zu dieser Hälfte gehört."

# game/scripts/c26/c26.rpy:137
translate german c26s001_MeeDate_d9243e15:

    # mc "Tenías razón. Has pedido demasiada comida. ¡Pero si hay incluso bacon canadiense!"
    mc "Du hattest recht. Du hast zu viel bestellt. Es gibt sogar kanadischen Speck!"

# game/scripts/c26/c26.rpy:138
translate german c26s001_MeeDate_e3bdc460:

    # mee "*Risa* Ese es para mí. Ya sé que no te gusta, pero para mí es un placer culpable."
    mee "*Lacht* Das ist für mich. Ich weiß, du magst es nicht, aber für mich ist es ein heimliches Vergnügen."

# game/scripts/c26/c26.rpy:139
translate german c26s001_MeeDate_7ecfb6d9:

    # mc "*Risa* ¿Qué va a ser lo siguiente? ¿Pizza con cosas raras?"
    mc "*lacht* Was kommt als Nächstes? Pizza mit seltsamen Zutaten?"

# game/scripts/c26/c26.rpy:141
translate german c26s001_MeeDate_8e5336a4:

    # mee "*Risa* No, eso se lo dejo a [bet]. Creo que si pones un bisonte entero encima de una base de pizza sería capaz de comérselo."
    mee "*Lacht* Nein, das überlasse ich [bet]. Ich glaube, wenn man einen ganzen Bison auf einen Pizzaboden legt, könnte er ihn aufessen."

# game/scripts/c26/c26.rpy:142
translate german c26s001_MeeDate_cca5d0e0:

    # mc "*Risa* Me lo creo."
    mc "*lacht* Ich glaube es."

# game/scripts/c26/c26.rpy:143
translate german c26s001_MeeDate_8d4dc8e7:

    # mc "Pero explícame la historia de este sitio. Parece un sitio muy especial."
    mc "Aber erzähl mir die Geschichte dieses Ortes. Er scheint ein ganz besonderer Ort zu sein."

# game/scripts/c26/c26.rpy:145
translate german c26s001_MeeDate_750f1bd5:

    # mee "Lo es. Querían construir un complejo de lujo para famosos que huyeran de L.A. Por eso los gazebos están escondidos, para darles intimidad."
    mee "Ja, das stimmt. Sie wollten ein Luxusresort für Prominente bauen, die aus Los Angeles fliehen. Deshalb sind die Pavillons versteckt, um ihnen Privatsphäre zu gewähren."

# game/scripts/c26/c26.rpy:146
translate german c26s001_MeeDate_46edd6a8:

    # mee "Siempre pensé que estaba pensado para que pudieran venir aquí para escapar de los paparazzis."
    mee "Ich dachte immer, es sei so gedacht, damit sie hierherkommen können, um den Paparazzi zu entkommen."

# game/scripts/c26/c26.rpy:147
translate german c26s001_MeeDate_7d596d39:

    # mc "Tiene lógica."
    mc "Das macht Sinn."

# game/scripts/c26/c26.rpy:150
translate german c26s001_MeeDate_455c54e7:

    # mee "Yo vendí los terrenos y tu abuelo hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "Ich verkaufte das Grundstück, und Ihr Großvater entwarf das Restaurant. Es war eines seiner letzten Projekte."

# game/scripts/c26/c26.rpy:152
translate german c26s001_MeeDate_51144d46:

    # mee "Yo vendí los terrenos y John hizo el proyecto del restaurante. Fue uno de sus últimos trabajos."
    mee "Ich verkaufte das Grundstück und John entwarf das Restaurant. Es war eines seiner letzten Projekte."

# game/scripts/c26/c26.rpy:153
translate german c26s001_MeeDate_5098616f:

    # mee "El hotel fue diseñado por un estudio de San Francisco. Una cosa muy lujosa. Y muy fea a mi parecer."
    mee "Das Hotel wurde von einem Studio aus San Francisco entworfen. Sehr luxuriös. Und meiner Meinung nach sehr hässlich."

# game/scripts/c26/c26.rpy:154
translate german c26s001_MeeDate_4ca75ceb:

    # mee "John no llegó a verlo completado, ni a saber que el hotel no se construiría."
    mee "John erlebte weder die Fertigstellung noch die Erkenntnis, dass das Hotel nicht gebaut werden würde."

# game/scripts/c26/c26.rpy:155
translate german c26s001_MeeDate_4ce4b479:

    # mc "Creo que no deberíamos haber venido a este sitio, Meemaw. Te debe traer recuerdos dolorosos."
    mc "Ich glaube nicht, dass wir hierher hätten kommen sollen, Meemaw. Das muss schmerzhafte Erinnerungen wecken."

# game/scripts/c26/c26.rpy:157
translate german c26s001_MeeDate_7d1c8a20:

    # mee "Tan dolorosos como cualquier otro de sus edificios. Este no es más especial que otros."
    mee "Genauso schmerzhaft wie alle seine anderen Gebäude. Dieses ist nicht besonderer als die anderen."

# game/scripts/c26/c26.rpy:158
translate german c26s001_MeeDate_4a461efb:

    # mee "Además, para mí es un sitio nuevo. No estaba acabado cuando John murió y nunca vine después."
    mee "Außerdem ist es ein neuer Ort für mich. Er war noch nicht fertig, als John starb, und ich bin danach nie wieder zurückgekehrt."

# game/scripts/c26/c26.rpy:159
translate german c26s001_MeeDate_8aa83788_1:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c26/c26.rpy:162
translate german c26s001_MeeDate_e33e7362:

    # mee "Cuando a tu abuelo le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Als bei deinem Großvater Krebs diagnostiziert wurde, ließ er mich ihm versprechen, dass ich mein Leben ohne ihn neu aufbauen würde."

# game/scripts/c26/c26.rpy:164
translate german c26s001_MeeDate_4ca1d8d2:

    # mee "Cuando a John le diagnosticaron el cáncer, me obligó a prometerle que reconstruiría mi vida sin él."
    mee "Als bei John Krebs diagnostiziert wurde, ließ er mich ihm versprechen, dass ich mein Leben ohne ihn neu aufbauen würde."

# game/scripts/c26/c26.rpy:165
translate german c26s001_MeeDate_5bea8fa1:

    # mee "He tardado 23 años. Y un sitio que diseñó él me parece un buen lugar para empezar."
    mee "Ich habe 23 Jahre gebraucht. Und eine von ihm entworfene Website scheint ein guter Ausgangspunkt zu sein."

# game/scripts/c26/c26.rpy:166
translate german c26s001_MeeDate_85439d39:

    # mc "No creo que hayas tardado 23 años. Has vivido una vida plena todos esos años."
    mc "Ich glaube nicht, dass du 23 Jahre gebraucht hast. Du hast all die Jahre ein erfülltes Leben gelebt."

# game/scripts/c26/c26.rpy:167
translate german c26s001_MeeDate_0a6f7cf6:

    # mc "Estar o no en una relación no debería ser la definición de reconstruir una vida."
    mc "Ob man in einer Beziehung ist oder nicht, sollte nicht darüber entscheiden, wie man sich ein neues Leben aufbaut."

# game/scripts/c26/c26.rpy:169
translate german c26s001_MeeDate_bd7cf37a:

    # mee "Ah, OK. Entonces ya nos podemos ir. *Risa*"
    mee "Ah, okay. Dann können wir gehen. *lacht*"

# game/scripts/c26/c26.rpy:170
translate german c26s001_MeeDate_5b15d382:

    # mc "Lo estoy diciendo en serio."
    mc "Ich meine es ernst."

# game/scripts/c26/c26.rpy:172
translate german c26s001_MeeDate_0d8d6878:

    # mee "Yo también, [mc]. Hasta ahora había pensado que estaba viviendo una buena vida, pero estos últimos días..."
    mee "Ich auch, [mc]. Bis jetzt dachte ich, ich hätte ein gutes Leben, aber die letzten Tage..."

# game/scripts/c26/c26.rpy:173
translate german c26s001_MeeDate_0d9728e8:

    # mee "Me han hecho recuperar una ilusión que no recordaba, si es que alguna vez la he tenido."
    mee "Sie haben in mir ein Gefühl der Hoffnung wiedererweckt, das ich vergessen hatte, falls ich überhaupt jemals eines besessen hatte."

# game/scripts/c26/c26.rpy:175
translate german c26s001_MeeDate_056ce8f9:

    # mc "Con el abuelo la tendrías, ¿no?"
    mc "Das würdest du auch mit deinem Großvater machen, nicht wahr?"

# game/scripts/c26/c26.rpy:177
translate german c26s001_MeeDate_6a446d59:

    # mc "Con John la tendrías, ¿no?"
    mc "Mit John hättest du es geschafft, oder?"

# game/scripts/c26/c26.rpy:179
translate german c26s001_MeeDate_521da6e2:

    # mee "Era diferente. Todo se desarrolló muy rápido..."
    mee "Es war anders. Alles entwickelte sich sehr schnell..."

# game/scripts/c26/c26.rpy:180
translate german c26s001_MeeDate_511397d9:

    # mee "[bet] me dijo que te explicó nuestra historia, con lo que ya lo sabes."
    mee "[bet] sagte mir, er habe dir unsere Geschichte erklärt, du kennst sie also schon."

# game/scripts/c26/c26.rpy:182
translate german c26s001_MeeDate_41f1f948:

    # mee "No había sentimiento de anticipación después del fin de semana en el que nos conocimos."
    mee "Nach dem Wochenende, an dem wir uns trafen, gab es keinerlei Vorfreude."

# game/scripts/c26/c26.rpy:184
translate german c26s001_MeeDate_e3224f3c:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener hijos..."
    mee "Alles schien sich ganz natürlich zu entwickeln. Kennenlernen, Heiraten, Kinder bekommen..."

# game/scripts/c26/c26.rpy:186
translate german c26s001_MeeDate_45784042:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener a [nor]..."
    mee "Alles schien sich ganz natürlich zu entwickeln. Kennenlernen, Heiraten, Kinder bekommen..."

# game/scripts/c26/c26.rpy:187
translate german c26s001_MeeDate_bf512acf:

    # mc "Y lo que está pasando ahora es diferente, ¿no?"
    mc "Und was jetzt geschieht, ist anders, nicht wahr?"

# game/scripts/c26/c26.rpy:189
translate german c26s001_MeeDate_30ccb98f:

    # mee "Lo es. Es muy diferente. No vamos a tener hijos. No creo que los quisiera a mi edad aunque pudiera."
    mee "Ja, das stimmt. Es ist ganz anders. Wir werden keine Kinder haben. Ich glaube auch nicht, dass ich in meinem Alter noch welche haben möchte, selbst wenn ich könnte."

# game/scripts/c26/c26.rpy:191
translate german c26s001_MeeDate_f83019ab:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que tu madre ahora!"
    mee "Ich kenne dich seit deiner Geburt. Verdammt, ich war älter, als deine Mutter jetzt ist!"

# game/scripts/c26/c26.rpy:193
translate german c26s001_MeeDate_d20de51a:

    # mee "Te conozco desde que naciste. ¡Mierda, era más mayor cuando naciste que [mar] ahora!"
    mee "Ich kenne dich seit deiner Geburt. Verdammt, ich war älter, als du geboren wurdest, als ich jetzt bin!"

# game/scripts/c26/c26.rpy:194
translate german c26s001_MeeDate_3283d3bc:

    # mc "Tenías la edad de [nor]..."
    mc "Du warst im Alter von [nor]..."

# game/scripts/c26/c26.rpy:196
translate german c26s001_MeeDate_4cb3b6e2:

    # mee "Sí. Exactamente la misma edad que [nor] tiene ahora."
    mee "Ja. Genau so alt wie [nor] jetzt ist."

# game/scripts/c26/c26.rpy:197
translate german c26s001_MeeDate_50252c25:

    # mee "Y no es... natural... que tú y yo estemos juntos."
    mee "Und es ist nicht... natürlich..., dass du und ich zusammen sind."

# game/scripts/c26/c26.rpy:199
translate german c26s001_MeeDate_07ee4791:

    # mee "Aunque no renunciaría a ello por nada ni por nadie. Me da lo mismo lo que puedan pensar los demás."
    mee "Ich würde es zwar für nichts und niemanden aufgeben, aber mir ist egal, was andere denken."

# game/scripts/c26/c26.rpy:200
translate german c26s001_MeeDate_ba3e2b07:

    # mc "Yo tampoco renunciaría a esto."
    mc "Das würde ich auch nicht aufgeben."

# game/scripts/c26/c26.rpy:202
translate german c26s001_MeeDate_cd488b7f:

    # mee "*Risa* ¿Aunque me guste el bacon canadiense?"
    mee "*lacht* Obwohl ich kanadischen Speck mag?"

# game/scripts/c26/c26.rpy:203
translate german c26s001_MeeDate_c68ede67:

    # mc "*Risa* Aunque te guste el bacon canadiense."
    mc "*Lacht* Selbst wenn man kanadischen Speck mag."

# game/scripts/c26/c26.rpy:205
translate german c26s001_MeeDate_a143917f:

    # mee "Pero hablando en serio, me encanta lo que ha pasado entre nosotros en los últimos días."
    mee "Aber im Ernst, ich liebe, was in den letzten Tagen zwischen uns passiert ist."

# game/scripts/c26/c26.rpy:206
translate german c26s001_MeeDate_14dd0f5d:

    # mee "Me encanta no saber qué va a pasar la siguiente vez que estemos juntos. Me encanta ese sentimiento de anticipación."
    mee "Ich liebe es, nicht zu wissen, was beim nächsten Treffen passieren wird. Ich liebe dieses Gefühl der Vorfreude."

# game/scripts/c26/c26.rpy:207
translate german c26s001_MeeDate_f9a83ae8:

    # mc "Pasará lo que queramos que pase. No hay nadie poniendo límites."
    mc "Was immer wir wollen, wird geschehen. Niemand setzt uns Grenzen."

# game/scripts/c26/c26.rpy:209
translate german c26s001_MeeDate_1a6713c0:

    # mee "*Risa* Sí que lo hay. Yo. No quiero descubrir todo lo que somos capaces de hacer en nuestra primera noche."
    mee "*Lacht* Ja, da bin ich. Ich will nicht gleich in der ersten Nacht alles entdecken, wozu wir fähig sind."

# game/scripts/c26/c26.rpy:210
translate german c26s001_MeeDate_5771e687:

    # mee "No quiero que ese sentimiento de anticipación desaparezca."
    mee "Ich möchte nicht, dass dieses Gefühl der Vorfreude verschwindet."

# game/scripts/c26/c26.rpy:211
translate german c26s001_MeeDate_1d35912a:

    # mc "No tiene por qué desaparecer. Siempre podemos inventar cosas nuevas que hacer."
    mc "Es muss nicht verschwinden. Wir können immer wieder neue Dinge erfinden, die wir tun können."

# game/scripts/c26/c26.rpy:213
translate german c26s001_MeeDate_b4196dd9:

    # mc "Por ejemplo, helado. Estaba bueno."
    mc "Zum Beispiel Eiscreme. Die war gut."

# game/scripts/c26/c26.rpy:215
translate german c26s001_MeeDate_b74870ab:

    # mee "¿Ya lo has probado?"
    mee "Hast du es schon ausprobiert?"

# game/scripts/c26/c26.rpy:216
translate german c26s001_MeeDate_ea9e253c:

    # mc "Justo antes de ir a buscarte. Era tentador."
    mc "Kurz bevor ich dich abgeholt habe. Es war verlockend."

# game/scripts/c26/c26.rpy:217
translate german c26s001_MeeDate_35bd7889:

    # mee "¿Qué te ha parecido? ¿Te ha gustado? Esperaba ser la primera en hacerlo."
    mee "Was war dein Eindruck? Hat es dir gefallen? Ich hatte gehofft, die Erste zu sein, die das tut."

# game/scripts/c26/c26.rpy:218
translate german c26s001_MeeDate_d91826e5:

    # mc "Estaba bueno. No he notado mucha diferencia con el helado normal."
    mc "Es war gut. Ich habe keinen großen Unterschied zu normalem Eis bemerkt."

# game/scripts/c26/c26.rpy:219
translate german c26s001_MeeDate_bdd5010c:

    # mc "Pero volviendo al sentimiento de anticipación..."
    mc "Doch zurück zum Gefühl der Vorfreude..."

# game/scripts/c26/c26.rpy:221
translate german c26s001_MeeDate_e03cbced:

    # mee "¿Qué crees que pasará esta noche?"
    mee "Was glaubst du, wird heute Abend passieren?"

# game/scripts/c26/c26.rpy:222
translate german c26s001_MeeDate_2d8c85ca:

    # mc "¡Qué directa! *Risa*"
    mc "Wie direkt! *lacht*"

# game/scripts/c26/c26.rpy:223
translate german c26s001_MeeDate_0c2e6399:

    # mc "Creo que vamos a seguir disfrutando de una bonita cena."
    mc "Ich denke, wir werden weiterhin ein schönes Abendessen genießen."

# game/scripts/c26/c26.rpy:225
translate german c26s001_MeeDate_e0402574:

    # mee "¡No me refiero a eso! *Risa* Sabes a lo que me refiero."
    mee "Das meine ich nicht! *lacht* Du weißt, was ich meine."

# game/scripts/c26/c26.rpy:226
translate german c26s001_MeeDate_40fb7c8b:

    # mc "¿Te refieres a cuando me quede a dormir en tu habitación?"
    mc "Meinst du, als ich in deinem Zimmer übernachtet habe?"

# game/scripts/c26/c26.rpy:227
translate german c26s001_MeeDate_446c0699:

    # mc "Pues que tendré que ir a por un pijama a la mía primero."
    mc "Nun, ich muss mir erst einen Pyjama aus meinem Laden holen."

# game/scripts/c26/c26.rpy:229
translate german c26s001_MeeDate_6a457054:

    # mee "Había oído que dormías desnudo..."
    mee "Ich habe gehört, du schläfst nackt..."

# game/scripts/c26/c26.rpy:230
translate german c26s001_MeeDate_c65cfc16:

    # mc "Por norma sí, pero no sé si querrás que lo haga."
    mc "Grundsätzlich ja, aber ich weiß nicht, ob Sie das möchten."

# game/scripts/c26/c26.rpy:231
translate german c26s001_MeeDate_287f90ba:

    # mee "Por mí no hace falta que duermas con más ropa de la que sueles usar."
    mee "Meiner Meinung nach brauchst du zum Schlafen nicht mehr Kleidung zu tragen als sonst."

# game/scripts/c26/c26.rpy:232
translate german c26s001_MeeDate_d2756205:

    # mc "¿Y tú? ¿Cómo duermes?"
    mc "Und du? Wie schläfst du?"

# game/scripts/c26/c26.rpy:234
translate german c26s001_MeeDate_b4b4ad67:

    # mee "Por norma con un pijama. Pero hoy... esperaba que me dieras calor suficiente como para no necesitarlo."
    mee "Normalerweise trage ich einen Schlafanzug. Aber heute... hatte ich gehofft, du würdest mich so warm halten, dass ich ihn nicht bräuchte."

# game/scripts/c26/c26.rpy:235
translate german c26s001_MeeDate_038a732f:

    # mc "Me siento un hombre objeto usado como si fuera una mera bolsa de agua caliente. *Risa*"
    mc "Ich fühle mich wie ein Mann, der zum Objekt degradiert und wie eine Wärmflasche benutzt wird. *lacht*"

# game/scripts/c26/c26.rpy:236
translate german c26s001_MeeDate_ac2c5c33:

    # mc "Pero me parece una buena idea. No vamos a ver nada que no hayamos visto con anterioridad."
    mc "Aber ich halte es für eine gute Idee. Wir werden nichts sehen, was wir nicht schon kennen."

# game/scripts/c26/c26.rpy:237
translate german c26s001_MeeDate_f2bafc07:

    # mc "¿Lado derecho o izquierdo de la cama?"
    mc "Rechte oder linke Seite des Bettes?"

# game/scripts/c26/c26.rpy:239
translate german c26s001_MeeDate_bb0d87ac:

    # mee "Derecho. Y no pienso ceder sobre eso, al menos en mi cama."
    mee "Genau. Und ich habe nicht vor, dem nachzugeben, zumindest nicht in meinem Bett."

# game/scripts/c26/c26.rpy:240
translate german c26s001_MeeDate_6279dea7:

    # mc "*Risa* No hace falta que cedas. Yo duermo en el centro o en la izquierda."
    mc "*Lacht* Du musst nicht nachgeben. Ich schlafe in der Mitte oder links."

# game/scripts/c26/c26.rpy:241
translate german c26s001_MeeDate_24a618e2:

    # mc "Nuestra primera discusión como pareja no va a ser sobre el lado de la cama en el que dormimos."
    mc "Unser erster Streit als Paar wird sich nicht darum drehen, auf welcher Seite des Bettes wir schlafen."

# game/scripts/c26/c26.rpy:243
translate german c26s001_MeeDate_385d9d9c:

    # mee "Pero sabes que llegará tarde o temprano, ¿verdad? Un día discutiremos."
    mee "Aber du weißt doch, dass es früher oder später passieren wird, oder? Wir werden uns eines Tages streiten."

# game/scripts/c26/c26.rpy:244
translate german c26s001_MeeDate_6d613ec8:

    # mc "Estoy seguro de que lo hará, pero ese puente habrá que cruzarlo en su momento. No es necesario pensar en ese puente cuando ni siquiera sabemos que río atraviesa."
    mc "Ich bin sicher, er wird es tun, aber diese Hürde muss zu gegebener Zeit überwunden werden. Es bringt nichts, über diese Hürde nachzudenken, solange wir nicht einmal wissen, welchen Fluss sie überspannt."

# game/scripts/c26/c26.rpy:246
translate german c26s001_MeeDate_14d0ba4f:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde tu abuelo..."
    mee "Du hast recht. Ich mache mir zu viele Sorgen, aber ich war seit deinem Großvater mit niemandem mehr zusammen..."

# game/scripts/c26/c26.rpy:248
translate german c26s001_MeeDate_268b26d5:

    # mee "Tienes razón. Me preocupo demasiado, pero es que no he estado con nadie desde John..."
    mee "Du hast recht. Ich mache mir zu viele Sorgen, aber ich war seit John mit niemandem mehr zusammen..."

# game/scripts/c26/c26.rpy:249
translate german c26s001_MeeDate_91f7a39a:

    # mc "Si te sirve de algo, Tía [bet] dijo que me parecía mucho a él. A lo mejor las discusiones son parecidas."
    mc "Falls es hilft: Tante [bet] meinte, ich sähe ihm sehr ähnlich. Vielleicht ähneln sich unsere Streitereien ja."

# game/scripts/c26/c26.rpy:251
translate german c26s001_MeeDate_274a0851:

    # mee "*Risa* Te pareces a él en algunas cosas, pero hay más diferencias que similitudes."
    mee "*Lacht* In mancher Hinsicht bist du ihm ähnlich, aber es gibt mehr Unterschiede als Gemeinsamkeiten."

# game/scripts/c26/c26.rpy:252
translate german c26s001_MeeDate_ae926927:

    # mc "¿Por ejemplo?"
    mc "Zum Beispiel?"

# game/scripts/c26/c26.rpy:254
translate german c26s001_MeeDate_20d01048:

    # mee "Tu eres más directo y asertivo cuando quieres algo. Él le daba vueltas y más vueltas hasta que ya no recordabas de quién había sido la idea original."
    mee "Du bist direkter und durchsetzungsfähiger, wenn du etwas willst. Er drehte sich immer weiter im Kreis, bis man sich gar nicht mehr erinnern konnte, wessen ursprüngliche Idee es gewesen war."

# game/scripts/c26/c26.rpy:255
translate german c26s001_MeeDate_c7669102:

    # mc "Bueno, creo que los rodeos innecesarios son... innecesarios."
    mc "Nun ja, ich denke, unnötige Umwege sind... unnötig."

# game/scripts/c26/c26.rpy:257
translate german c26s001_MeeDate_a54c5d48:

    # mee "Después está vuestro concepto de familia. Es muy diferente."
    mee "Und dann ist da noch dein Familienbegriff. Der ist ganz anders."

# game/scripts/c26/c26.rpy:258
translate german c26s001_MeeDate_1c8fc493:

    # mc "Tía [bet] me dijo lo contrario, que los dos aceptábamos a todo el mundo en la familia."
    mc "Tante [bet] sagte mir das Gegenteil, dass wir beide jeden in die Familie aufgenommen hätten."

# game/scripts/c26/c26.rpy:259
translate german c26s001_MeeDate_11873b42:

    # mee "Ahí está la diferencia. Tú aceptas a todo el mundo en la familia."
    mee "Das ist der Unterschied. Man nimmt jeden in die Familie auf."

# game/scripts/c26/c26.rpy:260
translate german c26s001_MeeDate_981a38ec:

    # mee "El daba la bienvenida a todo el mundo a {b}nuestra{/b} familia. Nosotros siempre íbamos a ser el centro de esa familia extendida."
    mee "Er hat jeden in unsere Familie aufgenommen. Wir sollten immer der Mittelpunkt dieser Großfamilie sein."

# game/scripts/c26/c26.rpy:261
translate german c26s001_MeeDate_5b43c1a9:

    # mee "Quien quisiera unirse debía adaptarse a nosotros. Tú permites que cada cual siga siendo como es."
    mee "Wer mitmachen wollte, musste sich an uns anpassen. Ihr erlaubt es jedem, so zu bleiben, wie er ist."

# game/scripts/c26/c26.rpy:262
translate german c26s001_MeeDate_40ddff33:

    # mc "Es que la familia no es mía. Es de todos. Los de siempre y los nuevos."
    mc "Die Sache ist die: Familie gehört nicht nur mir. Sie gehört allen. Denen, die schon immer da waren, und den Neuen."

# game/scripts/c26/c26.rpy:264
translate german c26s001_MeeDate_a3d32e63:

    # mee "¿Puedes ver la diferencia? Tú no quieres ser el centro de la familia ni imponer normas."
    mee "Siehst du den Unterschied? Du willst nicht der Mittelpunkt der Familie sein oder Regeln auferlegen."

# game/scripts/c26/c26.rpy:265
translate german c26s001_MeeDate_64ee2e3f:

    # mee "Para él, la familia era nuestra, suya y mía."
    mee "Für ihn war Familie unsere, seine und meine."

# game/scripts/c26/c26.rpy:267
translate german c26s001_MeeDate_57807ca8:

    # mee "Y de nuestros hijos más tarde."
    mee "Und später unsere Kinder."

# game/scripts/c26/c26.rpy:269
translate german c26s001_MeeDate_2491ac7c:

    # mee "Y de [nor] más tarde."
    mee "Und ab [nor] später."

# game/scripts/c26/c26.rpy:270
translate german c26s001_MeeDate_6a4e5029:

    # mee "Pero si alguien más quería ser parte de la familia, lo tenía que hacer bajo nuestras condiciones."
    mee "Aber wenn jemand anderes Teil der Familie werden wollte, musste er das zu unseren Bedingungen tun."

# game/scripts/c26/c26.rpy:271
translate german c26s001_MeeDate_6e5d5b3a:

    # mc "Supongo que son otros tiempos y el concepto de familia ha cambiado. No hay que juzgarle en base a nuestros valores actuales."
    mc "Ich denke, die Zeiten haben sich geändert, und das Familienverständnis hat sich weiterentwickelt. Wir sollten ihn nicht nach unseren heutigen Wertvorstellungen beurteilen."

# game/scripts/c26/c26.rpy:273
translate german c26s001_MeeDate_4110b322:

    # mee "No le estoy juzgando, [mc]. Sólo digo que es un aspecto importante en el que sois diferentes. Ni mejores ni peores."
    mee "Ich verurteile ihn nicht, [mc]. Ich sage nur, dass es ein wichtiger Aspekt ist, in dem ihr beide euch unterscheidet. Weder besser noch schlechter."

# game/scripts/c26/c26.rpy:274
translate german c26s001_MeeDate_990d0171:

    # mee "Como has dicho, eran otros tiempos. El poliamor o los harenes eran cosas... raras."
    mee "Wie du schon sagtest, das waren andere Zeiten. Polyamorie und Harems waren... seltsame Dinge."

# game/scripts/c26/c26.rpy:276
translate german c26s001_MeeDate_f5eccc60:

    # mc "¿Cómo te sientes al formar parte de un harén? Supongo que no debe de ser fácil para ti."
    mc "Wie fühlt es sich an, Teil eines Harems zu sein? Ich kann mir vorstellen, dass es nicht einfach für dich ist."

# game/scripts/c26/c26.rpy:278
translate german c26s001_MeeDate_e4426ebc:

    # mee "No he pensado mucho en ello. Siempre me había parecido algo... tercermundista... con un macho dominante y unas mujeres sumisas, quizás contra su voluntad."
    mee "Ich habe mir darüber nicht viele Gedanken gemacht. Es wirkte auf mich immer... wie aus der Dritten Welt... mit einem dominanten Mann und unterwürfigen Frauen, vielleicht gegen ihren Willen."

# game/scripts/c26/c26.rpy:279
translate german c26s001_MeeDate_ef81bc07:

    # mee "Yo también soy de otros tiempos..."
    mee "Ich stamme auch aus einer anderen Zeit..."

# game/scripts/c26/c26.rpy:280
translate german c26s001_MeeDate_868910ac:

    # mee "Pero lo que tú has construido no tiene nada que ver con eso. Se ha creado de una forma natural. Lo has hecho muy bien."
    mee "Aber was du geschaffen hast, hat damit nichts zu tun. Es ist ganz natürlich entstanden. Du hast großartige Arbeit geleistet."

# game/scripts/c26/c26.rpy:281
translate german c26s001_MeeDate_c6217544:

    # mc "Gracias, pero supongo que hay un 'pero'."
    mc "Danke, aber ich nehme an, es gibt ein „Aber“."

# game/scripts/c26/c26.rpy:305
translate german c26s001_MeeDate_d11b5e72:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hermana."
    mee "*lacht* Es fühlt sich komisch an, einen Mann mit meiner Schwester zu teilen."

# game/scripts/c26/c26.rpy:308
translate german c26s001_MeeDate_96313940:

    # mee "O con mis hijas..."
    mee "Oder mit meinen Töchtern..."

# game/scripts/c26/c26.rpy:310
translate german c26s001_MeeDate_2a85f530:

    # mee "O con una de mis hijas..."
    mee "Oder mit einer meiner Töchter..."

# game/scripts/c26/c26.rpy:313
translate german c26s001_MeeDate_b9945fa1:

    # mee "O con mi hija..."
    mee "Oder mit meiner Tochter..."

# game/scripts/c26/c26.rpy:315
translate german c26s001_MeeDate_2dd9104d:

    # mee "O con mis nietas..."
    mee "Oder mit meinen Enkelinnen..."

# game/scripts/c26/c26.rpy:317
translate german c26s001_MeeDate_bfa3b927:

    # mee "O con una de mis nietas..."
    mee "Oder mit einer meiner Enkelinnen..."

# game/scripts/c26/c26.rpy:322
translate german c26s001_MeeDate_48cebf41:

    # mee "*Risa* Se me hace extraño compartir hombre con mis hijas."
    mee "*lacht* Es fühlt sich komisch an, einen Mann mit meinen Töchtern zu teilen."

# game/scripts/c26/c26.rpy:324
translate german c26s001_MeeDate_de2865f9:

    # mee "*Risa* Se me hace extraño compartir hombre con una de mis hijas."
    mee "*lacht* Es fühlt sich komisch an, einen Mann mit einer meiner Töchter zu teilen."

# game/scripts/c26/c26.rpy:326
translate german c26s001_MeeDate_2dd9104d_1:

    # mee "O con mis nietas..."
    mee "Oder mit meinen Enkelinnen..."

# game/scripts/c26/c26.rpy:328
translate german c26s001_MeeDate_bfa3b927_1:

    # mee "O con una de mis nietas..."
    mee "Oder mit einer meiner Enkelinnen..."

# game/scripts/c26/c26.rpy:331
translate german c26s001_MeeDate_a96ad341:

    # mee "*Risa* Se me hace extraño compartir hombre con mi hija."
    mee "*lacht* Es fühlt sich komisch an, einen Mann mit meiner Tochter zu teilen."

