    mee "Aber ich mache es gerne."

# game/scripts/c26/c26.rpy:346
translate german c26s001_MeeDate_7dcc0eba:

    # mc "*Risa* Creo que te acostumbrarás muy rápido."
    mc "*Lacht* Ich glaube, du wirst dich sehr schnell daran gewöhnen."

# game/scripts/c26/c26.rpy:347
translate german c26s001_MeeDate_8c3965bb:

    # mc "Especialmente en cuanto les comuniques a todas que formas parte del harén."
    mc "Vor allem, wenn du ihnen allen erzählst, dass du Teil des Harems bist."

# game/scripts/c26/c26.rpy:349
translate german c26s001_MeeDate_0575cde3:

    # mee "Eso es lo que más me asusta."
    mee "Das ist es, was mir am meisten Angst macht."

# game/scripts/c26/c26.rpy:352
translate german c26s001_MeeDate_38e3f536:

    # mee "Y ahora le tengo que comunicar al resto de chicas que estamos juntos. Eso es lo que más me asusta."
    mee "Und jetzt muss ich den anderen Mädchen sagen, dass wir zusammen sind. Das ist es, was mir am meisten Angst macht."

# game/scripts/c26/c26.rpy:353
translate german c26s001_MeeDate_e28fed60:

