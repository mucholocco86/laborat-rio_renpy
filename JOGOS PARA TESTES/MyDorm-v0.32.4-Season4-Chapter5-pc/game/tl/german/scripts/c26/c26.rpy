    mc "Bereits?"

# game/scripts/c26/c26.rpy:486
translate german c26s001_MeeSex_84567245:

    # mee "Desde la cena... Me haces pensar en cosas en las que no debería pensar mientras estoy comiendo."
    mee "Seit dem Abendessen... bringst du mich dazu, über Dinge nachzudenken, über die ich beim Essen nicht nachdenken sollte."

# game/scripts/c26/c26.rpy:487
translate german c26s001_MeeSex_b5d5200c:

    # mc "*Risa* Aún queda el postre..."
    mc "*Gelächter* Es gibt noch Nachtisch..."

# game/scripts/c26/c26.rpy:492
translate german c26s001_MeeSex_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c26/c26.rpy:493
translate german c26s001_MeeSex_41a0c2e3:

    # mee "¡Esperaba que estuvieras tapado en la cama! ¡Vas a coger frío!"
    mee "Ich hatte gehofft, du wärst schon im Bett! Du wirst dich noch erkälten!"

# game/scripts/c26/c26.rpy:494
translate german c26s001_MeeSex_b72494bc:

    # mc "No te preocupes, me he secado bien. Y una lluvia de verano no va a hacerme coger frío. Tu pelo mojado, sin embargo..."
    mc "Keine Sorge, ich bin abgetrocknet. Und ein Sommerregen wird mir nicht kalt machen. Deine nassen Haare hingegen schon..."

# game/scripts/c26/c26.rpy:499
translate german c26s001_MeeSex_f7c43031:

    # mee "No voy a esperar a que se seque, ni a pasarme media hora en el baño con el secador."
    mee "Ich werde nicht warten, bis es trocken ist, oder eine halbe Stunde im Badezimmer mit dem Föhn verbringen."

# game/scripts/c26/c26.rpy:500
translate german c26s001_MeeSex_44288bea:

