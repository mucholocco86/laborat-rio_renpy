    mee "Ich will meinen Nachtisch!"

# game/scripts/c26/c26.rpy:501
translate german c26s001_MeeSex_b345beaa:

    # mc "Entonces ven aquí."
    mc "Dann komm her."

# game/scripts/c26/c26.rpy:504
translate german c26s001_MeeSex_df3bda68:

    # mc "Veo que el mío ya está preparado."
    mc "Ich sehe, dass meiner schon vorbereitet ist."

# game/scripts/c26/c26.rpy:505
translate german c26s001_MeeSex_8eecaa3c:

    # mee "Llevo un rato pensando en lo que vamos a hacer y... ya sabes lo que me pasa..."
    mee "Ich habe schon eine Weile darüber nachgedacht, was wir tun werden, und... du weißt ja, wie das bei mir ist..."

# game/scripts/c26/c26.rpy:510
translate german c26s001_MeeSex_e12d4839:

    # "[mee] se sienta a horcajadas encima de tus piernas y empieza a besarte con pasión e impaciencia."
    "[mee] Er setzt sich rittlings auf deine Beine und beginnt, dich leidenschaftlich und ungeduldig zu küssen."

# game/scripts/c26/c26.rpy:513
translate german c26s001_MeeSex_13048085:

    # "Puedes notar el calor que emana de su entrepierna encima de Mjolnir y como sus húmedos pezones rozan sobre tu pecho."
    "Du kannst die Hitze spüren, die von ihrem Schritt über Mjölnir ausgeht, und wie ihre feuchten Brustwarzen deine Brust streifen."

# game/scripts/c26/c26.rpy:515
translate german c26s001_MeeSex_eddf9c22:

    # "Puedes notar el calor que emana de su entrepierna encima de Mjolnir."
    "Man kann die Hitze spüren, die von seinem Schritt über Mjölnir ausgeht."

# game/scripts/c26/c26.rpy:517
translate german c26s001_MeeSex_82e2c83b:

    # "Los besos continúan, en una lucha por saber quién besa más apasionadamente."
    "Die Küsse gehen weiter, ein Wettstreit darum, wer leidenschaftlicher küsst."

# game/scripts/c26/c26.rpy:518
translate german c26s001_MeeSex_d2960e92:

    # "A ninguno de los dos os importa. Ni siquiera sabéis que estáis luchando por ello."
    "Es ist euch beiden egal. Ihr wisst nicht einmal, dass ihr darum kämpft."

# game/scripts/c26/c26.rpy:520
translate german c26s001_MeeSex_28dacd32:

    # "Cambiáis de posición diversas veces, dejándote guiar por la diminuta mujer."
    "Du wechselst mehrmals die Position und lässt dich von der kleinen Frau leiten."

# game/scripts/c26/c26.rpy:521
translate german c26s001_MeeSex_75d7e556:

