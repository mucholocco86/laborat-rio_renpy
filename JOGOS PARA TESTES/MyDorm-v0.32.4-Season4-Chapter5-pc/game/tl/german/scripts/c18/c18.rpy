    mc "Worüber habe ich gelogen? Ich lüge nie, Debbie."

# game/scripts/c18/c18.rpy:1188
translate german c18s001_Debbie_8a1524d3:

    # deb "Conozco mi cuerpo... A todos los chicos os gustan las tetas... y las mías... son inexistentes..."
    deb "Ich kenne meinen Körper... Alle Männer stehen auf Brüste... und meine... sind nicht vorhanden..."

# game/scripts/c18/c18.rpy:1189
translate german c18s001_Debbie_698cec4c:

    # mc "Entonces, si no existen..."
    mc "Wenn sie also nicht existieren..."

# game/scripts/c18/c18.rpy:1191
translate german c18s001_Debbie_92aff942:

    # mc "... no me puedes decir nada por NO tocarlas, como estoy haciendo ahora."
    mc "...du kannst mir nichts vorwerfen, wenn ich sie NICHT berühre, so wie ich es jetzt tue."

# game/scripts/c18/c18.rpy:1192
