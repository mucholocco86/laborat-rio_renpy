# game/scripts/c18/c18.rpy:1186
translate german c18s001_Debbie_105b2567:

    # deb "No me mientas, [mc]. Me gusta que me digas cosas bonitas, pero no que me mientas."
    deb "Lüg mich nicht an, [mc]. Ich mag es, wenn du nette Dinge zu mir sagst, aber nicht, wenn du mich anlügst."

# game/scripts/c18/c18.rpy:1187
