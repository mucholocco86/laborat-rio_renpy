translate german c18s001_Debbie_06ef0d74:

    # dap "No os preocupéis por mí. Solo iba al lavabo. Seguid a lo vuestro."
    dap "Mach dir keine Sorgen um mich. Ich war nur kurz auf der Toilette. Mach einfach weiter, was du getan hast."

# game/scripts/c18/c18.rpy:1239
translate german c18s001_Debbie_20c4e937:

    # dap "Ah, y felicidades. Me alegro mucho por vosotros."
    dap "Oh, und herzlichen Glückwunsch! Ich freue mich so sehr für euch beide."

# game/scripts/c18/c18.rpy:1241
translate german c18s001_Debbie_8d1c094b:

    # dap "La primera chica del harén que conozco. *Risita*"
    dap "Das erste Harem-Mädchen, das ich getroffen habe. *Kichert*"

# game/scripts/c18/c18.rpy:1245
translate german c18s001_Debbie_2573625e:

    # deb "Tengo que ir a hablar con ella."
    deb "Ich muss mit ihr reden."

# game/scripts/c18/c18.rpy:1247
translate german c18s001_Debbie_3bfc1f52:

    # deb "Suerte que la casa es de [mar] y no de Olivia. Si no, esto parecería una AVN, incluso sé el título que tendría."
    deb "Zum Glück gehört das Haus [mar] und nicht Olivia. Sonst sähe das aus wie ein AVN-Video; ich wüsste sogar schon den Titel."

# game/scripts/c18/c18.rpy:1248
translate german c18s001_Debbie_a275bbce:

    # mc "Ve a hablar con ella si quieres, ahora compartís un secreto en los dos sentidos."
    mc "Wenn du willst, kannst du mit ihr reden; jetzt teilt ihr ein Geheimnis in beide Richtungen."

# game/scripts/c18/c18.rpy:1250
translate german c18s001_Debbie_67d27716:

    # mc "Ve a hablar con ella si quieres, pero si [dap] dice que no le importa, es que no le importa."
    mc "Wenn du willst, kannst du mit ihr reden, aber wenn [dap] sagt, dass es ihr egal ist, dann ist es ihr auch egal."

# game/scripts/c18/c18.rpy:1252
translate german c18s001_Debbie_bab9d40b:

    # deb "Lo sé, pero prefiero hablar y aclarar las cosas."
    deb "Ich weiß, aber ich ziehe es vor, miteinander zu reden und die Dinge zu klären."

# game/scripts/c18/c18.rpy:1253
translate german c18s001_Debbie_bea7c623:

    # deb "Te veo luego. {size=20}Te quiero.{/size}"
    deb "Bis später. Ich liebe dich."

# game/scripts/c18/c18.rpy:1254
translate german c18s001_Debbie_b93f4732:

    # mc "¿Qué has dicho? No te he oído bien."
    mc "Was hast du gesagt? Ich habe dich nicht richtig verstanden."

# game/scripts/c18/c18.rpy:1256
translate german c18s001_Debbie_628a9937:

    # deb "Que te veo luego."
    deb "Bis später."

# game/scripts/c18/c18.rpy:1257
translate german c18s001_Debbie_5fb46756:

    # deb "Si quieres seguir el orden de turnos, te toca bailar con Amanda. Es la siguiente en la lista."
    deb "Wenn du die Reihenfolge der Tanzschritte einhalten möchtest, bist du jetzt an der Reihe, mit Amanda zu tanzen. Sie ist als Nächste an der Reihe."

# game/scripts/c18/c18.rpy:1259
translate german c18s001_Debbie_df551a8d:

    # mc "*Risa* No es lo que me ha parecido oír."
    mc "*Gelächter* Das hatte ich nicht gehört."

# game/scripts/c18/c18.rpy:1261
translate german c18s001_Debbie_90ab1a2d:

    # mcp "(De vuelta al resto de chicas.)"
    mcp "(Zurück zu den anderen Mädchen.)"

# game/scripts/c18/c18.rpy:1263
translate german c18s001_Debbie_f33c4a4f:

    # deb "No, era mi turno de bailar contigo y, como tú has desaparecido, voy a aprovechar para hacer una visita que sólo yo puedo hacer. *Risita*"
    deb "Nein, ich war an der Reihe, mit dir zu tanzen, und da du verschwunden bist, werde ich die Gelegenheit nutzen, um dir einen Besuch abzustatten, den nur ich abstatten kann. *Kichern*"

# game/scripts/c18/c18.rpy:1264
translate german c18s001_Debbie_bb596aed:

    # mc "¿Quieres que te espere para ese baile?"
    mc "Soll ich für den Tanz auf dich warten?"

# game/scripts/c18/c18.rpy:1266
translate german c18s001_Debbie_dde2c0e1:

    # deb "No hace falta. Ve a bailar con Amanda, si quieres, es la siguiente en la lista."
    deb "Das ist nicht nötig. Tanz ruhig mit Amanda, wenn du willst; sie ist die Nächste auf der Liste."

# game/scripts/c18/c18.rpy:1267
translate german c18s001_Debbie_abce1cc3:

    # mc "OK. Hasta ahora."
    mc "Okay. Bis jetzt."

# game/scripts/c18/c18.rpy:1269
translate german c18s001_Debbie_8f83e065:

    # deb "Hasta ahora."
    deb "Bisher."

# game/scripts/c18/c18.rpy:1274
translate german c18s001_Amanda_655a1500:

    # "Vuelves a la sala y te diriges a Amanda."
    "Du kehrst ins Zimmer zurück und gehst auf Amanda zu."

# game/scripts/c18/c18.rpy:1276
translate german c18s001_Amanda_aa295703:

    # mc "Amanda, ¿te apetece bailar?"
    mc "Amanda, hast du Lust zu tanzen?"

# game/scripts/c18/c18.rpy:1277
translate german c18s001_Amanda_a3df03fb:

    # ama "Pero no es mi turno..."
    ama "Aber ich bin noch nicht an der Reihe..."

# game/scripts/c18/c18.rpy:1278
translate german c18s001_Amanda_53e219f7:

    # mc "No te preocupes por eso. Ya lo he hablado con Debbie."
    mc "Mach dir keine Sorgen. Ich habe bereits mit Debbie darüber gesprochen."

# game/scripts/c18/c18.rpy:1280
translate german c18s001_Amanda_90bb5c7a:

    # ama "Entonces, encantada de bailar contigo. Es la última canción de Megan antes de su descanso."
    ama "Dann würde ich sehr gerne mit dir tanzen. Es ist Megans letztes Lied vor ihrer Pause."

# game/scripts/c18/c18.rpy:1281
translate german c18s001_Amanda_5fb383ee:

    # mc "Aprovechémosla entonces."
    mc "Dann lasst uns das ausnutzen."

# game/scripts/c18/c18.rpy:1283
translate german c18s001_Amanda_cf96a5c9:

    # mc "¿Qué tal os lo estáis pasando?"
    mc "Wie geht es euch allen?"

# game/scripts/c18/c18.rpy:1284
translate german c18s001_Amanda_49610271:

    # ama "¡Genial! Estar aquí con las chicas y tener más rato para conocernos es muy divertido."
    ama "Super! Es macht so viel Spaß, hier mit den Mädels zu sein und mehr Zeit zu haben, uns besser kennenzulernen."

# game/scripts/c18/c18.rpy:1285
translate german c18s001_Amanda_aa41ce78:

    # mc "*Risa* Las conoces más que de sobras."
    mc "*Lacht* Du kennst sie besser als jeder andere."

# game/scripts/c18/c18.rpy:1287
translate german c18s001_Amanda_2beedcb0:

    # ama "Yo las conozco. Ellas aún no saben cómo soy. Al menos ya se están acabando las preguntas... raras."
    ama "Ich kenne sie. Sie wissen noch nicht, wie ich bin. Zumindest hören die seltsamen Fragen langsam auf."

# game/scripts/c18/c18.rpy:1288
translate german c18s001_Amanda_44b08d8e:

    # mc "¿Os han hecho muchas? ¿Me puedes poner un ejemplo de una de esas preguntas raras?"
    mc "Wurden Ihnen schon viele solcher Fragen gestellt? Können Sie mir ein Beispiel für eine dieser seltsamen Fragen nennen?"

# game/scripts/c18/c18.rpy:1290
translate german c18s001_Amanda_2945c2c8:

    # ama "La más rara hasta ahora ha sido sobre si teníamos sexo con los clones XY."
    ama "Die bisher seltsamste Frage betraf die Frage, ob wir Sex mit den XY-Klonen hatten."

# game/scripts/c18/c18.rpy:1291
translate german c18s001_Amanda_49a8fb26:

    # mc "*Risa* Esa ha sido [emm], seguro. No sé si quiero saber la respuesta."
    mc "*Lacht* Das war definitiv [emm]. Ich weiß nicht, ob ich die Antwort wissen will."

# game/scripts/c18/c18.rpy:1293
translate german c18s001_Amanda_bf4cd3cc:

    # ama "¿No saber la respuesta a si ha sido [emm] o a la pregunta? *Risa*"
    ama "Die Antwort auf die Frage, ob es [emm] ist, oder auf die Frage selbst nicht zu kennen? *lacht*"

# game/scripts/c18/c18.rpy:1294
translate german c18s001_Amanda_2068deef:

    # mc "A la pregunta."
    mc "Zur Frage."

# game/scripts/c18/c18.rpy:1295
translate german c18s001_Amanda_af5c850c:

    # ama "Entonces te alegrará saber que no ha sido [emm]. Y la respuesta ha sido No. Pero no me preguntes quién ha sido. Era una conversación de chicas."
    ama "Dann wirst du froh sein zu hören, dass es nicht [emm] war. Und die Antwort war nein. Aber frag mich nicht, wer es war. Das war ein Gespräch unter Freundinnen."

# game/scripts/c18/c18.rpy:1296
translate german c18s001_Amanda_360abff9:

    # mc "*Risa* Voy a empezar a recortar el tiempo que pasas con ellas, si empezáis a tener secretos."
    mc "*Lacht* Ich werde anfangen, die Zeit, die du mit ihnen verbringst, einzuschränken, wenn du anfängst, Geheimnisse vor ihnen zu haben."

# game/scripts/c18/c18.rpy:1298
translate german c18s001_Amanda_1acf09ab:

    # ama "Atrévete si no valoras tu vida. Y no es que vayamos a matarte ni Eva ni yo, sino ellas. *Risa*"
    ama "Nur zu, wenn dir dein Leben egal ist. Und es ist ja nicht so, als würden Eva oder ich dich umbringen, das tun sie. *Gelächter*"

# game/scripts/c18/c18.rpy:1299
translate german c18s001_Amanda_684f7eb4:

    # mc "Me lo creo. Ahora que os habéis encontrado os vais a hacer inseparables."
    mc "Ich glaube es. Jetzt, wo ihr euch gefunden habt, werdet ihr unzertrennlich sein."

# game/scripts/c18/c18.rpy:1300
translate german c18s001_Amanda_d7a83adb:

    # mc "Cambiando de tema y hablando de preguntas raras. ¿Quién es mayor? ¿Eva o tú?"
    mc "Wir wechseln das Thema und reden über seltsame Fragen. Wer ist älter? Eva oder du?"

# game/scripts/c18/c18.rpy:1303
translate german c18s001_Amanda_c188efa5:

    # ama "Yo. El grupo A salimos del tanque antes que el grupo B. Técnicamente \"nací\" dos días antes que Eva."
    ama "Ich. Gruppe A verließ den Tank vor Gruppe B. Genau genommen wurde ich zwei Tage vor Eva \"geboren\"."

# game/scripts/c18/c18.rpy:1305
translate german c18s001_Amanda_63ded428:

    # ama "Yo. Por dos días."
    ama "Ich. Zwei Tage lang."

# game/scripts/c18/c18.rpy:1306
translate german c18s001_Amanda_6a5cc27f:

    # ama "Siempre le ha desagradado ser la más pequeña."
    ama "Sie hat es immer gehasst, die Jüngste zu sein."

# game/scripts/c18/c18.rpy:1308
translate german c18s001_Amanda_5fc9da8b:

    # ama "... desde que murió Fiona."
    ama "...seit Fionas Tod."

# game/scripts/c18/c18.rpy:1309
translate german c18s001_Amanda_2a3b7b3d:

    # mc "Espera... ¿Fiona era la más joven?"
    mc "Moment mal... Fiona war die Jüngste?"

# game/scripts/c18/c18.rpy:1310
translate german c18s001_Amanda_f181a472:

    # ama "Sí..."
    ama "Ja..."

# game/scripts/c18/c18.rpy:1311
translate german c18s001_Amanda_44693662:

    # mc "Vuestros nombres entonces... ¿son por orden alfabético?"
    mc "Sind Ihre Namen also in alphabetischer Reihenfolge?"

# game/scripts/c18/c18.rpy:1313
translate german c18s001_Amanda_8738a641:

    # ama "Sí, nos los pusieron Aaron y Arnau. Hasta entonces éramos los sujetos A, B, C, D, E, y F."
    ama "Ja, Aaron und Arnau haben sie uns gegeben. Bis dahin waren wir die Probanden A, B, C, D, E und F."

# game/scripts/c18/c18.rpy:1314
translate german c18s001_Amanda_65481d7a:

    # mc "NTR os estaba deshumanizando..."
    mc "NTR hat dich entmenschlicht..."

# game/scripts/c18/c18.rpy:1316
translate german c18s001_Amanda_0c2b58ea:

    # mc "Supongo que era más fácil para ellos hacerlo así que veros como personas. Como clones de su propia familia."
    mc "Ich nehme an, es war für sie einfacher, es so zu machen, als euch als Menschen zu sehen. Als Klone ihrer eigenen Familie."

# game/scripts/c18/c18.rpy:1319
translate german c18s001_Amanda_b5da0eb9:

    # mc "Sin embargo, les pusieron nombres a [emm], [dap], y [eri]."
    mc "Sie gaben jedoch [emm], [dap] und [eri] Namen."

# game/scripts/c18/c18.rpy:1321
translate german c18s001_Amanda_435f2653:

    # ama "Los nombres se los pusieron cuando las sacaron del laboratorio. No podían presentarle a [mar] una niña y decirle que se llamaba Experimento XX-0-A. Prefirieron llamarla [emm]."
    ama "Sie gaben ihnen Namen, als sie sie aus dem Labor holten. Sie konnten [mar] nicht einem Mädchen vorstellen und ihr sagen, ihr Name sei Experiment XX-0-A. Sie nannten sie lieber [emm]."

# game/scripts/c18/c18.rpy:1322
translate german c18s001_Amanda_f588893a:

    # ama "Querían estudiar cómo ellas y nosotras nos desarrollábamos diferente al estar en la base o el mundo exterior, con una familia normal."
    ama "Sie wollten untersuchen, wie sie und wir uns unterschiedlich entwickelten, wenn wir auf dem Stützpunkt oder in der Außenwelt mit einer normalen Familie lebten."

# game/scripts/c18/c18.rpy:1323
translate german c18s001_Amanda_a7ea8669:

    # mc "¿Normal? Creo que somos cualquier cosa menos normal."
    mc "Normal? Ich glaube, wir sind alles andere als normal."

# game/scripts/c18/c18.rpy:1324
translate german c18s001_Amanda_f0a1a1ef:

    # mc "Pero me alegra joderles el experimento."
    mc "Aber ich bin froh, ihr Experiment zu ruinieren."

# game/scripts/c18/c18.rpy:1326
translate german c18s001_Amanda_0f46ae83:

    # ama "¿A qué te refieres con joderles el experimento? El experimento acabó con el accidente de avión."
    ama "Was meinen Sie mit „ihr Experiment ruiniert“? Das Experiment endete mit dem Flugzeugabsturz."

# game/scripts/c18/c18.rpy:1327
translate german c18s001_Amanda_0763a07c:

    # mc "Bueno, de todas formas no podría continuar. Ahora vosotras también estáis en la misma familia. Aunque cada vez es menos normal. Ya no habría nada que estudiar."
    mc "Nun ja, ich konnte einfach nicht mehr weitermachen. Jetzt gehört ihr alle auch zur selben Familie. Obwohl es immer weniger normal wird. Es gäbe ja nichts mehr zu studieren."

# game/scripts/c18/c18.rpy:1328
translate german c18s001_Amanda_c077657c:

    # mc "Y si no hay experimento que joder, igualmente me alegra que estéis aquí. Sólo espero que entrar en la familia no estropee la relación entre Eva y tú."
    mc "Und selbst wenn es kein Experiment gibt, an dem man herumfummeln könnte, bin ich trotzdem froh, dass du da bist. Ich hoffe nur, dass der Beitritt zur Familie die Beziehung zwischen dir und Eva nicht belastet."

# game/scripts/c18/c18.rpy:1329
translate german c18s001_Amanda_fe7bc238:

    # mc "Antes os he visto discutir."
    mc "Ich habe euch vorhin streiten sehen."

# game/scripts/c18/c18.rpy:1331
translate german c18s001_Amanda_26640daa:

    # ama "Eva sigue dándole vueltas al beso de anoche. Pero se le pasará."
    ama "Eva denkt immer noch an den Kuss von letzter Nacht. Aber sie wird darüber hinwegkommen."

# game/scripts/c18/c18.rpy:1332
translate german c18s001_Amanda_39401294:

    # mc "Y tú no la ayudas a olvidarlo acusándola de ponerse ese vestido por mí."
    mc "Und du hilfst ihr nicht dabei, das zu vergessen, indem du ihr vorwirfst, das Kleid wegen mir getragen zu haben."

# game/scripts/c18/c18.rpy:1334
translate german c18s001_Amanda_d1473d1b:

    # ama "¿Te lo ha dicho? ¡Chivata!"
    ama "Hat er es dir erzählt? Petze!"

# game/scripts/c18/c18.rpy:1335
translate german c18s001_Amanda_9c9410e3:

    # mc "*Risa* Las dos habéis dicho lo mismo de la otra. ¿Te das cuenta de lo ridículo que suena?"
    mc "*lacht* Ihr habt beide dasselbe übereinander gesagt. Ist euch eigentlich klar, wie absurd das klingt?"

# game/scripts/c18/c18.rpy:1337
translate german c18s001_Amanda_b4199019:

    # ama "Ahora que lo has dicho... sí. Nos estamos comportando como niñas pequeñas. Todo esto es nuevo para nosotras..."
    ama "Jetzt, wo du es sagst... ja. Wir benehmen uns wie kleine Mädchen. Das ist alles neu für uns..."

# game/scripts/c18/c18.rpy:1338
translate german c18s001_Amanda_3ed72d83:

    # mc "No pasa nada, Amanda. Pero no dejéis que os separe."
    mc "Das ist schon okay, Amanda. Aber lasst euch dadurch nicht entzweien."

# game/scripts/c18/c18.rpy:1339
translate german c18s001_Amanda_85ef00a7:

    # mc "Además..."
    mc "Außerdem..."

# game/scripts/c18/c18.rpy:1341
translate german c18s001_Amanda_9725d714:

    # mc "*Susurrando* Tú también estás preciosa con ese vestido."
    mc "*flüstert* Du siehst auch in dem Kleid wunderschön aus."

# game/scripts/c18/c18.rpy:1343
translate german c18s001_Amanda_6efc6087:

    # ama "¿De verdad lo crees? Gracias... Me lo ha prestado [emm], usamos casi la misma talla... *Risa* Lógicamente."
    ama "Meinst du das wirklich? Danke... [emm] hat es mir geliehen, wir haben fast die gleiche Größe... *Lacht* Natürlich."

# game/scripts/c18/c18.rpy:1344
translate german c18s001_Amanda_256a28c5:

    # mc "Aunque sea un vestido prestado estás tan bonita como cualquier otra chica esta noche. No puedo esperar a verte con un vestido elegido por ti."
    mc "Auch wenn es ein geliehenes Kleid ist, siehst du heute Abend genauso schön aus wie jedes andere Mädchen. Ich freue mich schon sehr darauf, dich in einem Kleid zu sehen, das du selbst ausgesucht hast."

# game/scripts/c18/c18.rpy:1346
translate german c18s001_Amanda_7447d7c3:

    # ama "Me vas a hacer ruborizar."
    ama "Du bringst mich noch zum Erröten."

# game/scripts/c18/c18.rpy:1347
translate german c18s001_Amanda_6f9744b0:

    # mc "Bueno, el estilo de Eva es el de una espía devora hombres. Quiero saber cuál es el tuyo. Seguro que estarás preciosa."
    mc "Evas Stil ist der einer männerfressenden Spionin. Ich möchte wissen, wie deiner ist. Ich bin sicher, du wirst umwerfend aussehen."

# game/scripts/c18/c18.rpy:1349
translate german c18s001_Amanda_9225161a:

    # ama "¿Crees que debería ir a hablar con Eva? ¿Dejar las cosas claras?"
    ama "Meinst du, ich sollte mit Eva reden? Um die Sache zu klären?"

# game/scripts/c18/c18.rpy:1350
translate german c18s001_Amanda_a6f7a5dd:

    # mc "No lo sé. Tú la conoces mejor que yo. Si fuera [emm] yo lo haría."
    mc "Ich weiß es nicht. Du kennst sie besser als ich. Wenn ich [emm] wäre, würde ich es tun."

# game/scripts/c18/c18.rpy:1351
translate german c18s001_Amanda_34a79bc4:

    # ama "Es que es la primera vez que estamos en esta situación. Nunca nos hemos peleado por un chico."
    ama "Das ist das erste Mal, dass wir in dieser Situation sind. Wir haben noch nie wegen eines Jungen gestritten."

# game/scripts/c18/c18.rpy:1353
translate german c18s001_Amanda_6a4462aa:

    # ama "¡Oh! ¡Mierda! ¡Olvida lo que he dicho!"
    ama "Oh! Scheiße! Vergiss, was ich gesagt habe!"

# game/scripts/c18/c18.rpy:1354
translate german c18s001_Amanda_d9be5c9f:

    # mc "No he oído nada."
    mc "Ich habe nichts gehört."

# game/scripts/c18/c18.rpy:1355
translate german c18s001_Amanda_b9270f79:

    # mcp "(Pero supongo que lo que no he oído responde a mi pregunta sobre si estabas flirteando conmigo.)"
    mcp "(Aber ich nehme an, das, was ich nicht gehört habe, beantwortet meine Frage, ob du mit mir geflirtet hast.)"

# game/scripts/c18/c18.rpy:1357
translate german c18s001_Amanda_e5fd1794:

    # ama "Creo que voy a hablar con ella. Lisa es la siguiente."
    ama "Ich glaube, ich werde mit ihr reden. Lisa ist als Nächste dran."

# game/scripts/c18/c18.rpy:1358
translate german c18s001_Amanda_1f4f4bb7:

    # mc "Arregladlo antes de que se enquiste. Voy a ver a Lisa."
    mc "Repariere es, bevor es schlimmer wird. Ich gehe zu Lisa."

# game/scripts/c18/c18.rpy:1360
translate german c18s001_Amanda_05648a53:

    # ama "{i}(¿Cómo puedo haber sido tan tonta como para que se me escape? Al menos ahora la pelota está en tu tejado, [mc].){/i}"
    ama "{i}(Wie konnte ich nur so dumm sein und mir das entgehen lassen? Jetzt bist du am Zug, [mc].){/i}"

# game/scripts/c18/c18.rpy:1388
translate german c18s001_Lisa_35e16f45:

    # mcp "(Lisa me cae bien, pero yo a ella no. ¿Debería sacarla a bailar?)"
    mcp "(Ich mag Lisa, aber sie mag mich nicht. Soll ich sie zum Tanzen auffordern?)"

# game/scripts/c18/c18.rpy:1390
translate german c18s001_Lisa_9396281d:

    # mcp "(Quizás sea una oportunidad para conocernos mejor.)"
    mcp "(Vielleicht ist das eine Gelegenheit für uns, uns besser kennenzulernen.)"

# game/scripts/c18/c18.rpy:1400
translate german c18s001_Lisa_a6f47669:

    # mcp "(No quiero que se sienta mal porque no la saque a bailar en su turno.)"
    mcp "(Ich möchte nicht, dass sie sich schlecht fühlt, weil ich sie bei ihrer Gelegenheit nicht zum Tanzen aufgefordert habe.)"

# game/scripts/c18/c18.rpy:1402
translate german c18s001_Lisa_2ee04643:

    # mc "Lisa, ¿te apetece bailar?"
    mc "Lisa, hast du Lust zu tanzen?"

# game/scripts/c18/c18.rpy:1403
translate german c18s001_Lisa_ea9e4818:

    # lis "Por supuesto. Te veo luego, [dap]."
    lis "Natürlich. Bis später, [dap]."

# game/scripts/c18/c18.rpy:1405
translate german c18s001_Lisa_5f65dd86:

    # lis "{i}(No quiero que se sienta mal porque yo sea la única que la rechaza.){/i}"
    lis "{i}(Ich möchte nicht, dass sie sich schlecht fühlt, weil ich die Einzige bin, die sie ablehnt.){/i}"

# game/scripts/c18/c18.rpy:1407
translate german c18s001_Lisa_8353e812:

    # lis "{i}(No es tan mal chico como parecía al principio. Quizás me equivoqué juzgándolo.){/i}"
    lis "{i}(Er ist gar nicht so ein schlechter Kerl, wie er anfangs schien. Vielleicht habe ich ihn falsch eingeschätzt.){/i}"

# game/scripts/c18/c18.rpy:1409
translate german c18s001_Lisa_79fa0866:

    # lis "{i}(Además está con Debbie. Quizás sea buen momento para conocerlo mejor.){/i}"
    lis "{i}(Außerdem ist er mit Debbie zusammen. Vielleicht ist es ein guter Zeitpunkt, ihn besser kennenzulernen.){/i}"

# game/scripts/c18/c18.rpy:1412
translate german c18s001_Lisa_93e3b3d3:

    # mcp "(No quiero que se sienta obligada a bailar conmigo exclusivamente porque lo dice una app.)"
    mcp "(Ich möchte nicht, dass sie sich verpflichtet fühlt, ausschließlich mit mir zu tanzen, nur weil eine App das vorgibt.)"

# game/scripts/c18/c18.rpy:1413
translate german c18s001_Lisa_3f196423:

    # mcp "(Mejor voy a por otro zumo.)"
    mcp "(Ich sollte mir besser noch einen Saft holen.)"

# game/scripts/c18/c18.rpy:1420
translate german c18s001_Lisa_ddaccb9f:

    # lis "Creo que me toca a mí bailar con el chico de la noche, ¿no?"
    lis "Ich glaube, heute Abend bin ich an der Reihe, mit dem Kerl zu tanzen, findest du nicht auch?"

# game/scripts/c18/c18.rpy:1422
translate german c18s001_Lisa_83b3e321:

    # mc "Eso me han dicho. Pero si no te apetece..."
    mc "So wurde es mir gesagt. Aber wenn du keine Lust dazu hast..."

# game/scripts/c18/c18.rpy:1423
translate german c18s001_Lisa_9e25c035:

    # lis "No te preocupes, me apetece."
    lis "Keine Sorge, ich habe Lust dazu."

# game/scripts/c18/c18.rpy:1424
translate german c18s001_Lisa_91b5562f:

    # lis "{i}(Además estás con Debbie. Quizás sea buen momento para conocerte mejor.){/i}"
    lis "{i}(Außerdem bist du ja mit Debbie zusammen. Vielleicht ist es ein guter Zeitpunkt, dich besser kennenzulernen.){/i}"

# game/scripts/c18/c18.rpy:1426
translate german c18s001_Lisa_583254e8:

    # lis "No soy muy buena bailarina. Me vas a tener que llevar tú."
    lis "Ich bin keine besonders gute Tänzerin. Du musst mich mitnehmen."

# game/scripts/c18/c18.rpy:1427
translate german c18s001_Lisa_a7aa7709:

    # mc "*Risa* Si le preguntas a [emm], descubrirás que yo tampoco lo soy."
    mc "*Lacht* Wenn du [emm] fragst, wirst du feststellen, dass ich es auch nicht bin."

# game/scripts/c18/c18.rpy:1428
translate german c18s001_Lisa_cdc622c7:

    # mc "Pero me extraña tanto que chicas de clase alta no hayáis tomado clases de baile. Es lo que se ve en las películas. Danza, piano, y cosas por el estilo."
    mc "Aber ich bin so überrascht, dass Mädchen aus der Oberschicht keine Tanzkurse besuchen. Das sieht man doch immer in Filmen: Tanzen, Klavier und so weiter."

# game/scripts/c18/c18.rpy:1430
translate german c18s001_Lisa_b5221f89:

    # mc "Debbie también me ha dicho que era mala bailarina, aunque no me ha pisado ni una vez. *Risa*"
    mc "Debbie meinte auch, ich sei eine schlechte Tänzerin, obwohl sie mir nie auf die Zehen getreten ist. *lacht*"

# game/scripts/c18/c18.rpy:1432
translate german c18s001_Lisa_7b5b9ebe:

    # lis "¿Eh? No os he visto bailar... Me extraña tanto que mi hermana baile con un chico... Me hubiera gustado verlo."
    lis "Hä? Ich habe dich gar nicht tanzen sehen... Ich bin so überrascht, dass meine Schwester mit einem Jungen getanzt hat... Ich hätte es gern gesehen."

# game/scripts/c18/c18.rpy:1433
translate german c18s001_Lisa_909eac03:

    # mc "Nos hemos cruzado en el guardarropía y hemos bailado allí."
    mc "Wir trafen uns in der Garderobe und tanzten dort."

# game/scripts/c18/c18.rpy:1434
translate german c18s001_Lisa_7ad9dbc1:

    # lis "Ah, OK. Un baile privado. Que romántico..."
    lis "Ah, okay. Ein privater Tanz. Wie romantisch..."

# game/scripts/c18/c18.rpy:1436
translate german c18s001_Lisa_214b9b1b:

    # lis "Sobre las clases de baile... Ni Debbie ni yo estábamos interesadas. Mis padres lo intentaron, pero nosotras nos negamos."
    lis "Was die Tanzkurse angeht … Weder Debbie noch ich hatten Interesse. Meine Eltern haben es versucht, aber wir haben abgelehnt."

# game/scripts/c18/c18.rpy:1437
translate german c18s001_Lisa_ddafb0d3:

    # lis "Yo por rebeldía tonta y Debbie porque nunca estuvo interesada. Siempre le interesaron más otras actividades."
    lis "Ich bin aus einer albernen Rebellion gegangen, und Debbie ist gegangen, weil sie nie Interesse hatte. Sie war immer mehr an anderen Aktivitäten interessiert."

# game/scripts/c18/c18.rpy:1438
translate german c18s001_Lisa_557bdbe7:

    # mc "Lo de la rebeldía te pega. *Risa* Y a Debbie lo de estar interesada en los deportes en vez de en la danza."
    mc "Deine rebellische Ader steht dir gut. *lacht* Und Debbies Interesse an Sport statt Tanzen."

# game/scripts/c18/c18.rpy:1440
translate german c18s001_Lisa_7b1be3a0:

    # lis "*Risa* Sí, la verdad es que no quería ser un cliché de chica de clase alta y acabé siéndolo."
    lis "*Lacht* Ja, die Wahrheit ist, dass ich kein klischeehaftes Mädchen aus der Oberschicht sein wollte und am Ende genau das geworden bin."

# game/scripts/c18/c18.rpy:1441
translate german c18s001_Lisa_49779e7e:

    # lis "La chica blanca rica que va a manifestaciones de pro veganas y a protestas climáticas."
    lis "Das reiche weiße Mädchen, das zu Pro-Vegan-Demonstrationen und Klimaprotesten geht."

# game/scripts/c18/c18.rpy:1442
translate german c18s001_Lisa_6a0756a0:

    # mc "Bueno, me parecen buenas causas."
    mc "Ich denke, das sind gute Anliegen."

# game/scripts/c18/c18.rpy:1444
translate german c18s001_Lisa_5459d6e9:

    # lis "Lo son. Pero, en la mayoría de los casos, sirven de muy poco y sólo a nivel local. Alguien debería hacer algo en las esferas políticas."
    lis "Das stimmt. Doch in den meisten Fällen sind sie wenig hilfreich und nur auf lokaler Ebene wirksam. Jemand sollte im politischen Bereich etwas unternehmen."

# game/scripts/c18/c18.rpy:1445
translate german c18s001_Lisa_9c56984a:

    # mc "El problema es encontrar a ese alguien, ¿no? La clase política suele tener demasiados intereses cruzados y estar atada a demasiados lobbies."
    mc "Das Problem ist, diese Person zu finden, nicht wahr? Die politische Klasse hat in der Regel zu viele widerstreitende Interessen und ist mit zu vielen Lobbygruppen verstrickt."

# game/scripts/c18/c18.rpy:1447
translate german c18s001_Lisa_06944f43:

    # lis "Sí, y la mayoría de gente concienciada también está muy politizada. El establishment los tacha de comunistas, con lo que es difícil que alguna vez tengan poder."
    lis "Ja, und die meisten politisch bewussten Menschen sind auch sehr politisiert. Das Establishment bezeichnet sie als Kommunisten, daher ist es unwahrscheinlich, dass sie jemals an die Macht kommen werden."

# game/scripts/c18/c18.rpy:1448
translate german c18s001_Lisa_4f27d2d4:

    # mc "Y los que no estáis politizados, la base de esos movimientos, no estáis interesados en entrar en política. Tú estudias Arte, por ejemplo."
    mc "Und diejenigen unter Ihnen, die nicht politisch aktiv sind – die Basis dieser Bewegungen –, die kein Interesse daran haben, in die Politik zu gehen. Sie studieren beispielsweise Kunst."

# game/scripts/c18/c18.rpy:1450
translate german c18s001_Lisa_f800ee59:

    # lis "*Risa* ¿Me ves como alcaldesa de un pueblo? No es algo para mí."
    lis "*Lacht* Können Sie sich vorstellen, dass ich Bürgermeister einer Stadt werde? Das ist nichts für mich."

# game/scripts/c18/c18.rpy:1451
translate german c18s001_Lisa_213b30da:

    # mc "¿Por qué no? ¿Demasiadas responsabilidades? Al menos nadie te podría tachar de comunista."
    mc "Warum nicht? Zu viele Verpflichtungen? Wenigstens könnte dich niemand beschuldigen, ein Kommunist zu sein."

# game/scripts/c18/c18.rpy:1461
translate german c18s001_Lisa_0692a1e1:

    # mc "Dependiendo de tu programa, obviamente. Sé que, al menos, serías honesta."
    mc "Das hängt natürlich vom jeweiligen Studiengang ab. Ich weiß aber, dass du zumindest ehrlich wärst."

# game/scripts/c18/c18.rpy:1463
translate german c18s001_Lisa_260b12e0:

    # lis "¡Wow! Eso no me lo esperaba."
    lis "Wow! Damit hatte ich nicht gerechnet."

# game/scripts/c18/c18.rpy:1464
translate german c18s001_Lisa_ae28686e:

    # mc "¿Por qué no? Ahora que te conozco mejor, creo que podrías hacer un buen trabajo como alcaldesa de donde sea."
    mc "Warum nicht? Jetzt, wo ich dich besser kenne, glaube ich, dass du überall ein hervorragender Bürgermeister wärst."

# game/scripts/c18/c18.rpy:1466
translate german c18s001_Lisa_21301555:

    # lis "No es eso. No me veo ejerciendo la política. ¿Crees que alguien me votaría?"
    lis "Nein, das ist es nicht. Ich sehe mich nicht in der Politik. Glauben Sie, irgendjemand würde mich wählen?"

# game/scripts/c18/c18.rpy:1468
translate german c18s001_Lisa_754ea9de:

    # mc "No hubiera votado por la Lisa que conocí en el aeropuerto. Pero sí por la que está bailando conmigo ahora mismo."
    mc "Ich hätte nicht für die Lisa gestimmt, die ich am Flughafen getroffen habe. Aber ich hätte für die gestimmt, die jetzt mit mir tanzt."

# game/scripts/c18/c18.rpy:1470
translate german c18s001_Lisa_763c6fa5:

    # lis "Me comporté como una imbécil, ¿verdad?"
    lis "Ich habe mich wie ein Idiot benommen, nicht wahr?"

# game/scripts/c18/c18.rpy:1471
translate german c18s001_Lisa_2854b7e8:

    # mc "Yo no diría eso, pero no fue demasiado agradable conocerte aquel día."
    mc "Das würde ich nicht sagen, aber es war nicht sehr angenehm, Sie an diesem Tag zu treffen."

# game/scripts/c18/c18.rpy:1472
translate german c18s001_Lisa_e92b2438:

    # lis "Lo siento..."
    lis "Es tut mir Leid..."

# game/scripts/c18/c18.rpy:1473
translate german c18s001_Lisa_18193b19:

    # mc "Un mal día lo tiene cualquiera. Nos has demostrado a todos que aquella Lisa no eras tú."
    mc "Jeder hat mal einen schlechten Tag. Du hast uns allen gezeigt, dass Lisa nicht du warst."

# game/scripts/c18/c18.rpy:1474
translate german c18s001_Lisa_be61b8d6:

    # mc "Si dejas que la gente te conozca, ¿por qué no te van a votar?"
    mc "Wenn man sich den Leuten öffnet, warum sollten sie einen dann nicht wählen?"

# game/scripts/c18/c18.rpy:1476
translate german c18s001_Lisa_16a151df:

    # lis "Se necesitan muchas cosas que no tengo. Carisma, contactos, pertenecer a un partido... Además, como has dicho, estudio Arte. No una carrera que tenga que ver con la política."
    lis "Es gibt viele Dinge, die du brauchst, die ich nicht habe. Charisma, Kontakte, Parteizugehörigkeit … Außerdem studiere ich, wie du schon sagtest, Kunst. Kein Studium mit Bezug zur Politik."

# game/scripts/c18/c18.rpy:1477
translate german c18s001_Lisa_eeedd398:

    # mc "Tuvimos a Arnold como gobernador aquí. *Risa* No estoy seguro de que estudiara algo relacionado con la política."
    mc "Wir hatten hier Arnold als Gouverneur. *lacht* Ich bin mir nicht sicher, ob er irgendetwas Politikwissenschaftliches studiert hat."

# game/scripts/c18/c18.rpy:1479
translate german c18s001_Lisa_949c3047:

    # lis "*Risa* Es verdad, los californianos sois raros. Elegís a un actor como gobernador."
    lis "*lacht* Stimmt schon, ihr Kalifornier seid seltsam. Ihr wählt einen Schauspieler zum Gouverneur."

# game/scripts/c18/c18.rpy:1480
translate german c18s001_Lisa_1e9b5f62:

    # mc "*Risa* Los americanos somos raros. Elegimos a un actor como presidente... *Risa* Un actor que antes fue gobernador de California."
    mc "*Lacht* Wir Amerikaner sind schon komisch. Wir haben einen Schauspieler zum Präsidenten gewählt... *Lacht* Einen Schauspieler, der früher Gouverneur von Kalifornien war."

# game/scripts/c18/c18.rpy:1481
translate german c18s001_Lisa_918bef6f:

    # lis "*Risa* Es verdad. Al menos él ganó la Guerra Fría. ¿Qué hizo Arnold?"
    lis "*lacht* Stimmt. Wenigstens hat er den Kalten Krieg gewonnen. Was hat Arnold denn gemacht?"

# game/scripts/c18/c18.rpy:1482
translate german c18s001_Lisa_dc7175bc:

    # mc "Permitirte beber alcohol esta noche. *Risa*"
    mc "Erlaube dir heute Abend Alkohol. *lacht*"

# game/scripts/c18/c18.rpy:1483
translate german c18s001_Lisa_3382fe0e:

    # lis "*Risa* Punto para Arnold."
    lis "*lacht* Punkt für Arnold."

# game/scripts/c18/c18.rpy:1486
translate german c18s001_Lisa_236c7e34:

    # lis "Sé que esto va a sonarte raro, pero ¿podemos hablar de Debbie?"
    lis "Ich weiß, das klingt jetzt komisch, aber können wir über Debbie reden?"

# game/scripts/c18/c18.rpy:1487
translate german c18s001_Lisa_81e2e7ad:

    # mc "Lo que quieras. Es tu hermana y tienes todo el derecho a hablar de ella."
    mc "Ganz wie du willst. Sie ist deine Schwester und du hast jedes Recht, über sie zu reden."

# game/scripts/c18/c18.rpy:1489
translate german c18s001_Lisa_6b37feed:

    # lis "Me preocupa cómo se siente. Cómo la haces sentir."
    lis "Ich mache mir Sorgen darüber, wie sie sich fühlt. Wie du sie fühlen lässt."

# game/scripts/c18/c18.rpy:1490
translate german c18s001_Lisa_d13e97a4:

    # mc "Ya te dije que no tengo intención de hacerle daño."
    mc "Ich habe dir doch schon gesagt, dass ich keinerlei Absicht habe, ihn zu verletzen."

# game/scripts/c18/c18.rpy:1492
translate german c18s001_Lisa_61450eff:

    # lis "Lo sé. Pero ayer, mientras me explicaba lo del lago... Nunca la había visto... la palabra que me viene a la cabeza es \"brillar\"... tanto como anoche."
    lis "Ich weiß. Aber gestern, als sie mir den See erklärte... ich hatte ihn noch nie zuvor gesehen... das Wort, das mir in den Sinn kommt, ist „glänzen“... genau wie letzte Nacht."

# game/scripts/c18/c18.rpy:1493
translate german c18s001_Lisa_e5462fe1:

    # lis "Está muy ilusionada. Yo estoy muy contenta por ella, pero..."
    lis "Sie ist total aufgeregt. Ich freue mich sehr für sie, aber..."

# game/scripts/c18/c18.rpy:1494
translate german c18s001_Lisa_3a0ccfb7:

    # mc "Y te preocupa que acabe desilusionándola."
    mc "Und du befürchtest, dass es sie am Ende enttäuschen wird."

# game/scripts/c18/c18.rpy:1497
translate german c18s001_Lisa_1138990b:

    # lis "Me ha dicho que estás saliendo con más chicas aparte de ella. Eso de por sí me desconcertó. Que lo hagas y que ella lo acepte me desconcierta aún más."
    lis "Sie hat mir erzählt, dass du dich neben ihr auch mit anderen Mädchen triffst. Das allein hat mich schon verwirrt. Die Tatsache, dass du es tust und sie damit einverstanden ist, verwirrt mich noch mehr."

# game/scripts/c18/c18.rpy:1498
translate german c18s001_Lisa_b04b9f66:

    # mc "Sí, estoy saliendo con más chicas. Pero no engaño a nadie. Para mí, cada una de ellas es igual de importante."
    mc "Ja, ich treffe mich mit mehreren Frauen. Aber ich betrüge niemanden. Jede einzelne ist mir gleich wichtig."

# game/scripts/c18/c18.rpy:1500
translate german c18s001_Lisa_04b2decd:

    # lis "Me preocupa que puedas acabar haciéndole daño sin querer. Sé que no vas a hacerlo a propósito."
    lis "Ich mache mir Sorgen, dass du ihn versehentlich verletzen könntest. Ich weiß, dass du es nicht absichtlich tun würdest."

# game/scripts/c18/c18.rpy:1501
translate german c18s001_Lisa_493919a2:

    # mc "Te prometo que voy a ir con todo el cuidado posible para evitar que eso pase."
    mc "Ich verspreche, dass ich alles tun werde, um das zu verhindern."

# game/scripts/c18/c18.rpy:1502
translate german c18s001_Lisa_3e206ce6:

    # mc "Debbie es muy especial y la voy a tratar como se merece."
    mc "Debbie ist etwas ganz Besonderes und ich werde sie so behandeln, wie sie es verdient."

# game/scripts/c18/c18.rpy:1505
translate german c18s001_Lisa_fe0ef7cc:

    # lis "¿Puedo preguntar cómo funciona eso de salir con más de una chica?"
    lis "Darf ich fragen, wie das mit mehreren Frauen gleichzeitig funktioniert?"

# game/scripts/c18/c18.rpy:1506
translate german c18s001_Lisa_4ecac2b6:

    # mc "Es muy fácil. Yo soy capaz de amar a diversas chicas a la vez. Pero cuando estoy con cualquiera de ellas, el resto no existe."
    mc "Es ist ganz einfach. Ich kann mehrere Mädchen gleichzeitig lieben. Aber wenn ich mit einer von ihnen zusammen bin, existieren die anderen nicht."

# game/scripts/c18/c18.rpy:1507
translate german c18s001_Lisa_ae0e301e:

    # mc "Cuando estaba con tu hermana en guardarropía, no importaba si salía con alguna de las chicas que había aquí fuera, en casa, o en cualquier otro lado."
    mc "Als ich mit deiner Schwester in der Garderobe war, spielte es keine Rolle, ob ich mit irgendeinem der Mädchen hier draußen, zu Hause oder irgendwo anders ausging."

# game/scripts/c18/c18.rpy:1509
translate german c18s001_Lisa_ec3019a0:

    # lis "*Risa* Lo has dicho de una forma en que es imposible saber con quién más sales."
    lis "*Lacht* Du hast es so formuliert, dass man unmöglich wissen kann, mit wem du sonst noch ausgehst."

# game/scripts/c18/c18.rpy:1510
translate german c18s001_Lisa_e9242c3f:

    # mc "Cumplir con sus deseos es una forma de cuidarlas, Lisa."
    mc "Lisa, indem du ihre Wünsche erfüllst, kümmerst du dich um sie."

# game/scripts/c18/c18.rpy:1511
translate german c18s001_Lisa_4f04432e:

    # mc "Y ahora mismo, ninguna, incluyendo a Debbie, quiere hacer público lo nuestro."
    mc "Und im Moment möchte keiner von ihnen, auch nicht Debbie, unsere Beziehung öffentlich machen."

# game/scripts/c18/c18.rpy:1512
translate german c18s001_Lisa_df133572:

    # mc "Pero, sin querer molestarte, creo que tu pregunta va más allá... como si hubiera una cuestión personal tuya."
    mc "Aber ohne Sie beleidigen zu wollen, glaube ich, dass Ihre Frage noch weiter geht... als ob es sich um ein persönliches Problem von Ihnen handeln würde."

# game/scripts/c18/c18.rpy:1515
translate german c18s001_Lisa_cf614b5d:

    # lis "¿Puedo preguntar si eres totalmente monógamo? Después de haber oído sobre tu relación con Saira..."
    lis "Darf ich fragen, ob Sie absolut monogam leben? Nachdem ich von Ihrer Beziehung zu Saira gehört habe..."

# game/scripts/c18/c18.rpy:1516
translate german c18s001_Lisa_5125e112:

    # mc "Por el momento lo soy. Estoy con Debbie y con nadie más. Pero no le hemos puesto ninguna etiqueta todavía."
    mc "Im Moment ja. Ich bin mit Debbie zusammen und mit niemand anderem. Aber wir haben unserer Beziehung noch keinen Namen gegeben."

# game/scripts/c18/c18.rpy:1517
translate german c18s001_Lisa_503485a3:

    # mc "Si me enamorara de otra persona, y esa persona quisiera estar conmigo, tendría que hablarlo con Debbie a ver cómo lo resolvemos."
    mc "Wenn ich mich in jemand anderen verlieben würde und diese Person mit mir zusammen sein wollte, müsste ich mit Debbie darüber sprechen und sehen, wie wir das regeln könnten."

# game/scripts/c18/c18.rpy:1519
translate german c18s001_Lisa_dc57d66c:

    # lis "*Risa* Las famosas charlas de [mc], quien todo lo resuelve hablando."
    lis "*Gelächter* Die berühmten Sprüche von [mc], der alles durch Reden löst."

# game/scripts/c18/c18.rpy:1520
translate german c18s001_Lisa_9f980c2f:

    # mc "Creo que hablar las cosas es la mejor forma de no hacer daño a nadie."
    mc "Ich glaube, dass ein offenes Gespräch der beste Weg ist, niemanden zu verletzen."

# game/scripts/c18/c18.rpy:1521
translate german c18s001_Lisa_bd7be2d1:

    # mc "Pero, sin querer molestarte, lo preguntas como si quisieras que no fuera monógamo... por una cuestión tuya personal."
    mc "Aber ohne dich verletzen zu wollen, fragst du so, als ob du dir wünschtest, er wäre nicht monogam... aus einem persönlichen Grund."

# game/scripts/c18/c18.rpy:1522
translate german c18s001_Lisa_0fde96b3:

    # mcp "(La conversación con Betty me está haciendo ver fantasmas donde quizás no los haya.)"
    mcp "(Das Gespräch mit Betty lässt mich Geister sehen, wo vielleicht gar keine sind.)"

# game/scripts/c18/c18.rpy:1524
translate german c18s001_Lisa_c10d232a:

    # lis "¿Qué? ¡No! Sales con mi hermana... No podría salir contigo."
    lis "Was? Nein! Du bist mit meiner Schwester zusammen... Ich könnte nicht mit dir zusammen sein."

# game/scripts/c18/c18.rpy:1525
translate german c18s001_Lisa_1a14bbca:

    # mc "Nadie ha dicho nada de salir juntos tú y yo, pero..."
    mc "Niemand hat etwas davon gesagt, dass wir beide zusammen ausgehen würden, aber..."

# game/scripts/c18/c18.rpy:1526
translate german c18s001_Lisa_3ae0e593:

    # mc "¿Me estás diciendo que si no saliera con Debbie te lo plantearías?"
    mc "Willst du mir etwa sagen, dass du es dir anders überlegen würdest, wenn ich nicht mit Debbie zusammen wäre?"

# game/scripts/c18/c18.rpy:1528
translate german c18s001_Lisa_9efbf727:

    # lis "Eso es algo que nunca sabremos, ¿no?"
    lis "Das werden wir wohl nie erfahren, oder?"

# game/scripts/c18/c18.rpy:1531
translate german c18s001_Lisa_83575dba:

    # kim "Lisa, tu móvil está sonando. Es Anthony."
    kim "Lisa, dein Telefon klingelt. Es ist Anthony."

# game/scripts/c18/c18.rpy:1533
translate german c18s001_Lisa_56122fef:

    # lis "Tengo que cogerlo, [mc]. Seguimos hablando luego."
    lis "Ich muss es abholen, [mc]. Wir sprechen später."

# game/scripts/c18/c18.rpy:1534
translate german c18s001_Lisa_c7ee6dc6:

    # mc "OK. ¿Podéis decirle a quién le toque ahora que voy a por un zumo a la barra? Vuelvo en un momento."
    mc "Okay. Könntest du demjenigen, der jetzt dran ist, Bescheid geben, dass ich mir kurz einen Saft an der Bar hole? Ich bin gleich wieder da."

# game/scripts/c18/c18.rpy:1535
translate german c18s001_Lisa_f2589d54:

    # lis "Le toca a [dap], pero no la veo por aquí. Estará en el lavabo. Pero ve, nosotras la avisamos."
    lis "[dap] ist an der Reihe, aber ich sehe sie nirgends. Wahrscheinlich ist sie im Badezimmer. Aber keine Sorge, wir sagen ihr Bescheid."

# game/scripts/c18/c18.rpy:1579
translate german c18s001_Daphne_b010d53c:

    # "Al volver con el zumo descubres que Anthony se ha unido a la fiesta y Lisa se lo está presentando al resto de chicas."
    "Als du mit dem Saft zurückkommst, stellst du fest, dass Anthony zur Party dazugestoßen ist und Lisa ihn den anderen Mädchen vorstellt."

# game/scripts/c18/c18.rpy:1585
translate german c18s001_Daphne_cd12b144:

    # dap "Me han dicho que has desaparecido en el turno de Lisa. Voy a avisarla."
    dap "Mir wurde gesagt, dass du während Lisas Schicht verschwunden bist. Ich werde es ihr ausrichten."

# game/scripts/c18/c18.rpy:1586
translate german c18s001_Daphne_7e8e3321:

    # mc "Mejor no. Está presentando a Anthony al resto de chicas. ¿A quién le toca ahora?"
    mc "Besser nicht. Sie stellt Anthony den anderen Mädchen vor. Wer ist jetzt an der Reihe?"

# game/scripts/c18/c18.rpy:1587
translate german c18s001_Daphne_a258ee24:

    # dap "A mí."
    dap "Mich."

# game/scripts/c18/c18.rpy:1589
translate german c18s001_Daphne_3e3645fd:

    # dap "Es mi turno ahora, si no estás demasiado cansado."
    dap "Wenn du nicht zu müde bist, bin ich jetzt an der Reihe."

# game/scripts/c18/c18.rpy:1590
translate german c18s001_Daphne_4f29a179:

    # mc "Para ti nunca lo estoy."
    mc "Ich bin nie für dich da."

# game/scripts/c18/c18.rpy:1592
translate german c18s001_Daphne_38877ed9:

    # mc "¿Qué tal te lo estás pasando en tu fiesta de cumpleaños?"
    mc "Wie gefällt dir deine Geburtstagsfeier?"

# game/scripts/c18/c18.rpy:1593
translate german c18s001_Daphne_49bb4323:

    # dap "Genial, pero la fiesta es mañana. Falta demasiada gente hoy y no me parece una fiesta de verdad."
    dap "Schön und gut, aber die Party ist erst morgen. Heute fehlen zu viele Leute, und es fühlt sich nicht wie eine richtige Party an."

# game/scripts/c18/c18.rpy:1594
translate german c18s001_Daphne_6e1a4b42:

    # mc "*Risa* Somos trece. Si cuentas a Anthony, catorce. La última vez que salimos éramos cinco."
    mc "*lacht* Wir sind dreizehn. Wenn man Anthony mitzählt, vierzehn. Beim letzten Mal waren wir nur zu fünft."

# game/scripts/c18/c18.rpy:1596
translate german c18s001_Daphne_27d5fb13:

    # dap "¡Las cosas han cambiado mucho en dos semanas! Y después de mañana... creo que nunca más sentiremos que una fiesta está completa a menos que estemos todas las chicas."
    dap "In zwei Wochen hat sich so viel verändert! Und nach morgen... ich glaube, wir werden nie wieder das Gefühl haben, dass eine Party komplett ist, wenn nicht alle Mädels da sind."

# game/scripts/c18/c18.rpy:1597
translate german c18s001_Daphne_023d41a0:

    # mc "¿Las chicas? ¿Eso me deja fuera? *Risa*"
    mc "Die Mädchen? Bin ich da etwa ausgeschlossen? *lacht*"

# game/scripts/c18/c18.rpy:1599
translate german c18s001_Daphne_60dfb32c:

    # dap "Nunca te dejaría fuera. *Risa* Pero tú siempre estás para nosotras. No sé cómo puedes con todo."
    dap "Ich würde dich niemals ausschließen. *lacht* Aber du bist immer für uns da. Ich weiß nicht, wie du das alles schaffst."

# game/scripts/c18/c18.rpy:1600
translate german c18s001_Daphne_6fb03db4:

    # mc "Dividiendo el tiempo en pequeñas porciones. *Risa*"
    mc "Die Zeit in kleine Abschnitte unterteilen. *Gelächter*"

# game/scripts/c18/c18.rpy:1601
translate german c18s001_Daphne_89353138:

    # mc "Con esa app que habéis hecho Scarlett y tú puede ser más fácil."
    mc "Mit der App, die du und Scarlett entwickelt habt, kann es einfacher werden."

# game/scripts/c18/c18.rpy:1604
translate german c18s001_Daphne_d2e70ab9:

    # dap "La hicimos para dividirnos tu tiempo entre nosotras de tal forma que nunca discutiéramos. Solo ha habido que adaptarla."
    dap "Wir haben es so eingerichtet, dass wir unsere Zeit so aufteilen konnten, dass wir nie streiten würden. Wir mussten uns nur daran gewöhnen."

# game/scripts/c18/c18.rpy:1608
translate german c18s001_Daphne_c06f43b1:

    # dap "La hicimos para que pudieras dividir tu tiempo entre el harén sin que nadie discutiera. Solo ha habido que adaptarla."
    dap "Wir haben es so konzipiert, dass Sie Ihre Zeit zwischen den Mitgliedern des Harems aufteilen können, ohne dass es zu Streit kommt. Es waren lediglich einige Anpassungen nötig."

# game/scripts/c18/c18.rpy:1614
translate german c18s001_Daphne_0a1ebcec:

    # mc "Ha sido una buena idea."
    mc "Das war eine gute Idee."

# game/scripts/c18/c18.rpy:1616
translate german c18s001_Daphne_47281d94:

    # mc "Sobre el elefante en la habitación..."
    mc "Nun zum Elefanten im Raum..."

# game/scripts/c18/c18.rpy:1618
translate german c18s001_Daphne_798aa071:

    # dap "¿Debbie? No pasa nada. Me alegro mucho por vosotros. Es una chica genial."
    dap "Debbie? Alles gut. Ich freue mich so sehr für euch beide. Sie ist ein tolles Mädchen."

# game/scripts/c18/c18.rpy:1620
translate german c18s001_Daphne_d18826bf:

    # dap "Hemos estado hablando en el lavabo. Ahora las dos sabemos que estás con la otra y a ninguna nos importa."
    dap "Wir haben uns im Badezimmer unterhalten. Jetzt wissen wir beide, dass du mit der anderen Frau zusammen bist, und keiner von uns beiden ist mehr wichtig."

# game/scripts/c18/c18.rpy:1622
translate german c18s001_Daphne_cb97d2cf:

    # dap "Se me hace extraño saber de otra chica aparte de Scarlett, pero me alegra poder hablar de ello con Debbie."
    dap "Es fühlt sich seltsam an, von einem anderen Mädchen als Scarlett zu hören, aber ich bin froh, dass ich mit Debbie darüber reden kann."

# game/scripts/c18/c18.rpy:1624
translate german c18s001_Daphne_37a1cab8:

    # dap "Se me hace extraño saber de otra chica del harén, pero me alegra poder hablar de ello con Debbie."
    dap "Es fühlt sich seltsam an, von einem anderen Mädchen im Harem zu hören, aber ich bin froh, dass ich mit Debbie darüber reden kann."

# game/scripts/c18/c18.rpy:1626
translate german c18s001_Daphne_f348fc9d:

    # dap "Hemos estado hablando en el lavabo. Me ha pedido que guarde el secreto, que solo lo sabemos Lisa y yo."
    dap "Wir unterhielten uns im Badezimmer. Sie bat mich, es geheim zu halten, dass nur Lisa und ich davon wissen."

# game/scripts/c18/c18.rpy:1628
translate german c18s001_Daphne_8219e201:

    # dap "Se me hace extraño saber que estás con otra chica aparte de Scarlett, pero me alegra que sea Debbie."
    dap "Es fühlt sich komisch an zu wissen, dass du mit einem anderen Mädchen als Scarlett zusammen bist, aber ich bin froh, dass es Debbie ist."

# game/scripts/c18/c18.rpy:1629
translate german c18s001_Daphne_299f601d:

    # mc "Gracias por entenderlo. Se ha puesto muy nerviosa por un momento."
    mc "Danke für Ihr Verständnis. Sie war einen Moment lang sehr nervös."

# game/scripts/c18/c18.rpy:1631
translate german c18s001_Daphne_98a1e6e5:

    # dap "¿Alguna chica más de la que tenga que saber? *Risa*"
    dap "Gibt es sonst noch Mädchen, die ich kennen sollte? *lacht*"

# game/scripts/c18/c18.rpy:1632
translate german c18s001_Daphne_5e8a0a54:

    # mc "Todas las chicas tenéis vuestros secretos, y no soy nadie para desvelarlos. *Risa*"
    mc "Alle Mädchen haben ihre Geheimnisse, und ich bin niemand, der sie verraten sollte. *lacht*"

# game/scripts/c18/c18.rpy:1633
translate german c18s001_Daphne_4d648f2d:

    # dap "Tienes razón. *Risa* Seguramente te mataríamos entre todas si empiezas a hacerlo."
    dap "Du hast recht. *lacht* Wir würden dich wahrscheinlich alle umbringen, wenn du damit anfangen würdest."

# game/scripts/c18/c18.rpy:1636
translate german c18s001_Daphne_3d4521da:

    # dap "¿Sabes que estoy nerviosa por lo de mañana?"
    dap "Weißt du, dass ich wegen morgen nervös bin?"

# game/scripts/c18/c18.rpy:1637
translate german c18s001_Daphne_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c18/c18.rpy:1639
translate german c18s001_Daphne_700474e4:

    # dap "A la prueba de embarazo. Si sale positivo, me moriría de ganas por hacerlo público mañana mismo."
    dap "Ich mache einen Schwangerschaftstest. Wenn er positiv ist, würde ich es am liebsten sofort morgen verkünden."

# game/scripts/c18/c18.rpy:1640
translate german c18s001_Daphne_28244d0a:

    # dap "Y sería injusto para [eri] y [emm]. Voy a tener que guardar el secreto un par de días."
    dap "Und es wäre unfair gegenüber [eri] und [emm]. Ich muss es ein paar Tage lang geheim halten."

# game/scripts/c18/c18.rpy:1641
translate german c18s001_Daphne_80c47845:

    # mc "¿Y si sale negativo? ¿Te fastidiaría el cumpleaños?"
    mc "Was, wenn der Test negativ ausfällt? Würde das deinen Geburtstag ruinieren?"

# game/scripts/c18/c18.rpy:1643
translate german c18s001_Daphne_6670c182:

    # dap "No, si sale negativo no pasa nada. Nunca pensé que me quedaría embarazada a los 18. Ni siquiera antes de los 25."
    dap "Nein, wenn der Test negativ ist, ist das nicht so schlimm. Ich hätte nie gedacht, dass ich mit 18 schwanger werden würde. Nicht mal vor meinem 25. Lebensjahr."

# game/scripts/c18/c18.rpy:1644
translate german c18s001_Daphne_24d10ac0:

    # dap "Quiero tener a Maeve, pero no tengo demasiada prisa. No todas las chicas sueñan con quedarse embarazadas en su primera vez."
    dap "Ich wünsche mir ein Kind mit Maeve, aber ich habe es nicht eilig. Nicht jedes Mädchen träumt davon, gleich beim ersten Mal schwanger zu werden."

# game/scripts/c18/c18.rpy:1645
translate german c18s001_Daphne_991bcf0c:

    # mc "Esa debe ser la actitud."
    mc "Das sollte die Einstellung sein."

# game/scripts/c18/c18.rpy:1647
translate german c18s001_Daphne_56861b01:

    # dap "¿Quién crees que va a hacer topless mañana?"
    dap "Wer wird wohl morgen oben ohne gehen?"

# game/scripts/c18/c18.rpy:1648
translate german c18s001_Daphne_b73bb878:

    # mc "Estoy casi seguro de que tu madre, [emm], y [eri]. Del resto no tengo ni idea. Quizás Sam y Eileen."
    mc "Ich bin mir fast sicher, dass es deine Mutter, [emm] und [eri] sind. Von den anderen habe ich keine Ahnung. Vielleicht Sam und Eileen."

# game/scripts/c18/c18.rpy:1650
translate german c18s001_Daphne_fd7b762c:

    # dap "¿[eri]? Estás loco."
    dap "[eri]? Du spinnst wohl."

# game/scripts/c18/c18.rpy:1651
translate german c18s001_Daphne_1d300b52:

    # mc "Ella lo ha pedido para tu madre y va a querer apoyarla. Pero creía que ya se lo habrías preguntado a las chicas. Al menos a las que están aquí."
    mc "Sie hat es für deine Mutter angefragt und möchte sie unterstützen. Aber ich dachte, du hättest die Mädchen schon gefragt. Zumindest die, die hier sind."

# game/scripts/c18/c18.rpy:1653
translate german c18s001_Daphne_fa6af6d1:

    # dap "Nadie se ha atrevido a sacar el tema. Incluso Scarlett ha cambiado de tema cuando he intentado dirigir la conversación hacia mañana."
    dap "Niemand hat es gewagt, das Thema anzusprechen. Selbst Scarlett wechselte das Thema, als ich versuchte, das Gespräch auf morgen zu lenken."

# game/scripts/c18/c18.rpy:1654
translate german c18s001_Daphne_6c3f12bb:

    # dap "Creo que la presencia de Jamaal las cohíbe un poco a todas. No lo conocen tanto como nosotros."
    dap "Ich glaube, Jamaals Anwesenheit macht sie alle etwas verunsichert. Sie kennen ihn nicht so gut wie wir."

# game/scripts/c18/c18.rpy:1655
translate german c18s001_Daphne_80d95190:

    # mc "¿Jamaal? Creo que los únicos pezones que le podrían interesar de los que hay aquí serían los de Anthony y no sé si Anthony estaría interesado. *Risa*"
    mc "Jamaal? Ich glaube, die einzigen Nippel, die ihn hier interessieren würden, wären Anthonys, und ich weiß nicht, ob Anthony daran interessiert wäre. *lacht*"

# game/scripts/c18/c18.rpy:1657
translate german c18s001_Daphne_33a41986:

    # dap "¿Los tuyos no? *Risa*"
    dap "Nicht deins? *lacht*"

# game/scripts/c18/c18.rpy:1658
translate german c18s001_Daphne_b26929b6:

    # mc "Jamaal sabe que no me van los tíos igual que yo sé que no le van las chicas. Nunca me vería así. Es como mi hermano."
    mc "Jamaal weiß, dass ich nicht auf Jungs stehe, genau wie ich weiß, dass er nicht auf Mädchen steht. Er würde mich niemals so sehen. Er ist wie ein Bruder für mich."

# game/scripts/c18/c18.rpy:1661
translate german c18s001_Daphne_b4454935:

    # dap "*Risa* Y yo soy tu prima. Y eso no nos ha importado."
    dap "*Lacht* Und ich bin dein Cousin. Und das hat uns nie gekümmert."

# game/scripts/c18/c18.rpy:1663
translate german c18s001_Daphne_82a3cad3:

    # dap "*Risa* ¿Estás seguro? Piensa que nadie elige de quién se enamora."
    dap "*Lacht* Bist du dir sicher? Denk dran, niemand sucht sich aus, in wen er sich verliebt."

# game/scripts/c18/c18.rpy:1664
translate german c18s001_Daphne_116fee64:

    # mc "No me refiero a eso, sino a que SOLO me ve como a su hermano, no como un objetivo."
    mc "Ich meine nicht das, sondern vielmehr, dass er mich NUR als seinen Bruder sieht, nicht als Zielscheibe."

# game/scripts/c18/c18.rpy:1666
translate german c18s001_Daphne_5c637db6:

    # dap "¿Y tú? ¿Estás interesado en algunos pezones?"
    dap "Und du? Hättest du Interesse an ein paar Nippeln?"

# game/scripts/c18/c18.rpy:1668
translate german c18s001_Daphne_dff57b21:

    # mc "Principalmente en volver a ver los tuyos. Pero preferentemente en privado."
    mc "Vor allem, um seine Lieben wiederzusehen. Aber am liebsten unter vier Augen."

# game/scripts/c18/c18.rpy:1670
translate german c18s001_Daphne_0d6962ed:

    # mc "Soy un hombre de 21 años. *Risa* En todos. Es broma."
    mc "Ich bin ein 21-jähriger Mann. *Lacht* In allen. Nur Spaß."

# game/scripts/c18/c18.rpy:1671
translate german c18s001_Daphne_b55546d0:

    # dap "*Tsk* Sí, sí. Pero ¿alguna chica en particular mañana? Siempre has tenido un crush con Samantha."
    dap "*Tsk* Ja, ja. Aber wen denn morgen? Du bist doch schon immer in Samantha verknallt."

# game/scripts/c18/c18.rpy:1672
translate german c18s001_Daphne_571d1add:

    # mc "Nadie en particular. Creo que no hay que sexualizar algo así. Es algo que [eri] pidió por [nor], para ir acostumbrando a la abuela."
    mc "Niemand Bestimmtes. Ich finde, wir sollten so etwas nicht sexualisieren. [eri] hat darum gebeten, weil [nor] das wollte, damit Oma sich daran gewöhnt."

# game/scripts/c18/c18.rpy:1674
translate german c18s001_Daphne_57f3a4ca:

    # dap "Me extraña tanto que la abuela no haya protestado. No me la imagino enseñando las tetas delante tuyo, pero tampoco aceptando que otras chicas lo hagan."
    dap "Ich bin total überrascht, dass Oma nicht protestiert hat. Ich kann mir nicht vorstellen, dass sie vor dir ihre Brüste entblößen würde, aber ich kann mir auch nicht vorstellen, dass sie es hinnehmen würde, wenn andere Mädchen es tun."

# game/scripts/c18/c18.rpy:1675
translate german c18s001_Daphne_6d5e1919:

    # dap "Por no hablar de Tía Betty. Es más cool de lo que recordaba, pero..."
    dap "Ganz zu schweigen von Tante Betty. Sie ist cooler, als ich sie in Erinnerung hatte, aber..."

# game/scripts/c18/c18.rpy:1676
translate german c18s001_Daphne_f1d7d53c:

    # mc "Tía Betty se apuntaría a cualquier cosa que incomodara a Meemaw. *Risa* Si cree que la va a sacar de sus casillas, es capaz de hacer topless mañana."
    mc "Tante Betty würde alles tun, um Meemaw zu ärgern. *lacht* Wenn sie glaubt, sie damit auf die Palme zu bringen, könnte sie morgen sogar oben ohne herumlaufen."

# game/scripts/c18/c18.rpy:1678
translate german c18s001_Daphne_3917d012:

    # dap "En eso tienes razón. Parece que siempre están discutiendo."
    dap "Da hast du recht. Sie scheinen sich ständig zu streiten."

# game/scripts/c18/c18.rpy:1679
translate german c18s001_Daphne_215f54e1:

    # mc "Tienen formas diferentes de ver las cosas, aunque Meemaw cada vez ladra menos."
    mc "Sie haben unterschiedliche Sichtweisen, obwohl Meemaw immer weniger bellt."

# game/scripts/c18/c18.rpy:1681
translate german c18s001_Daphne_90d788b9:

    # "Un móvil suena en alguna parte."
    "Irgendwo klingelt ein Handy."

# game/scripts/c18/c18.rpy:1683
translate german c18s001_Daphne_4aa6c206:

    # dap "Creo que con esto acaba mi tiempo. Te veo en la segunda ronda. Te toca con Megan. La habíamos programado para su descanso."
    dap "Ich glaube, das war's für mich. Wir sehen uns in der zweiten Runde. Du spielst gegen Megan. Wir hatten ihren Ruhetag eingeplant."

# game/scripts/c18/c18.rpy:1685
translate german c18s001_Daphne_48afae88:

    # mc "Te veo luego."
    mc "Bis später."

# game/scripts/c18/c18.rpy:1688
translate german c18s001_app1_da1193af:

    # dap "La teníamos hecha para distribuirnos el tiempo de laboratorio en el instituto. Solo ha habido que adaptarla."
    dap "Wir hatten es bereits zur Verteilung der Laborzeiten am Institut vorbereitet. Wir mussten es nur noch anpassen."

# game/scripts/c18/c18.rpy:1691
translate german c18s001_app2_cc152883:

    # dap "Queríamos enseñártela cuando estuviera acabada, aún le quedan unos retoques, pero para esta noche ya nos servía."
    dap "Wir wollten es Ihnen erst zeigen, wenn es fertig ist; es braucht noch ein paar Nachbesserungen, aber für heute Abend war es gut genug."

# game/scripts/c18/c18.rpy:1714
translate german c18s001_Kim_238a3a31:

    # "Buscas a Megan por la sala y no está en ningún sitio."
    "Du suchst Megan im Raum, aber sie ist nirgends zu sehen."

# game/scripts/c18/c18.rpy:1716
translate german c18s001_Kim_f2cabb37:

    # kim "Megan se ha tenido que ir, con lo que ahora es mi turno, si aún te quedan ganas de bailar."
    kim "Megan musste gehen, also bin ich jetzt an der Reihe, falls du noch Lust zum Tanzen hast."

# game/scripts/c18/c18.rpy:1718
translate german c18s001_Kim_f05c8ea4:

    # mc "Perfecto. Tenemos que continuar la conversación de anoche."
    mc "Perfekt. Wir müssen das Gespräch von gestern Abend fortsetzen."

# game/scripts/c18/c18.rpy:1732
translate german c18s001_Kim_35a36254:

    # mc "Creo que voy a ir a sentarme un rato."
    mc "Ich glaube, ich werde mich erst einmal hinsetzen."

# game/scripts/c18/c18.rpy:1733
translate german c18s001_Kim_0482234a:

    # kim "Es normal. Llevas toda la noche de chica en chica."
    kim "Das ist normal. Du bist die ganze Nacht von einem Mädchen zum anderen gegangen."

# game/scripts/c18/c18.rpy:1739
translate german c18s001_Kim_88e51aa7:

    # kim "Ya te dije que no había nada de lo que hablar."
    kim "Ich habe dir doch schon gesagt, dass es nichts zu besprechen gibt."

# game/scripts/c18/c18.rpy:1740
translate german c18s001_Kim_cf573686:

    # mc "Y dijiste que esto de estar formando una familia podría evitar que tú y yo... y ahí lo dejaste."
    mc "Und du sagtest, dass diese ganze Sache mit der Familiengründung uns daran hindern könnte... und dabei beließest du es."

# game/scripts/c18/c18.rpy:1742
translate german c18s001_Kim_e397ee2f:

    # kim "No debería haberlo dicho."
    kim "Das hätte ich nicht sagen sollen."

# game/scripts/c18/c18.rpy:1743
translate german c18s001_Kim_d2970102:

    # mc "Sabes que, aunque estemos formando una familia, los típicos tabús familiares no se nos aplican, ¿verdad? A ti y a mí."
    mc "Du weißt doch, dass die typischen Familientabus für uns nicht gelten, auch wenn wir eine Familie gründen, oder? Für dich und mich."

# game/scripts/c18/c18.rpy:1745
translate german c18s001_Kim_92cf4f70:

    # mc "Con el beso de la playa dijiste que te sentías atraída por mí."
    mc "Mit dem Kuss am Strand hast du gezeigt, dass du dich zu mir hingezogen fühlst."

# game/scripts/c18/c18.rpy:1747
translate german c18s001_Kim_b7e481bc:

    # mc "Y con mi beso te dije que yo me sentía atraído por ti."
    mc "Und mit meinem Kuss habe ich dir gesagt, dass ich mich zu dir hingezogen fühle."

# game/scripts/c18/c18.rpy:1748
translate german c18s001_Kim_62e3685a:

    # mc "¿Dónde ves el problema?"
    mc "Wo sehen Sie das Problem?"

# game/scripts/c18/c18.rpy:1750
translate german c18s001_Kim_19acc9d3:

    # kim "El problema lo veo en que estamos formando una familia. No voy a decir que te vea como a un hermano ni nada por el estilo."
    kim "Das Problem ist meiner Meinung nach, dass wir eine Familie gründen. Ich werde jetzt nicht sagen, dass ich dich als Bruder sehe oder so etwas."

# game/scripts/c18/c18.rpy:1751
translate german c18s001_Kim_b6abdbc2:

    # kim "Eres... un miembro más de la familia. Pero también lo es [mar], y no sé cómo vería que me liara con su hijo."
    kim "Du bist... auch ein Familienmitglied. Aber [mar] ist es auch, und ich weiß nicht, wie er es fände, wenn ich mich in die Angelegenheiten seines Sohnes einmischen würde."

# game/scripts/c18/c18.rpy:1752
translate german c18s001_Kim_24cf8761:

    # mc "No creo que la opinión de mi madre tenga que influir en lo que hagamos tú y yo."
    mc "Ich finde nicht, dass die Meinung meiner Mutter Einfluss auf unser Handeln haben sollte."

# game/scripts/c18/c18.rpy:1754
translate german c18s001_Kim_92949965:

    # kim "No lo entiendes. Pero influye."
    kim "Du verstehst es nicht. Aber es hat Auswirkungen."

# game/scripts/c18/c18.rpy:1756
translate german c18s001_Kim_d2c28201:

    # kim "Me gustas, pero tengo que pensar si debo actuar sobre esos sentimientos."
    kim "Ich mag dich, aber ich muss darüber nachdenken, ob ich diesen Gefühlen nachgeben sollte."

# game/scripts/c18/c18.rpy:1758
translate german c18s001_Kim_825a6cec:

    # kim "Aún no sé si me gustas o me caes mal. Depende del día... pero tengo que pensar si debo actuar sobre esos sentimientos, si es que los tengo."
    kim "Ich weiß immer noch nicht, ob ich dich mag oder nicht. Es kommt auf den Tag an… aber ich muss darüber nachdenken, ob ich diesen Gefühlen nachgeben sollte, falls ich sie überhaupt habe."

# game/scripts/c18/c18.rpy:1759
translate german c18s001_Kim_24be633e:

    # mc "Lo entiendo. Una cosa es lo que crea yo y otra diferente lo que creas tú."
    mc "Ich verstehe. Was ich glaube, ist das eine, und was du glaubst, ist etwas anderes."

# game/scripts/c18/c18.rpy:1760
translate german c18s001_Kim_f20f6b5e:

    # kim "¿Podemos cambiar de tema?"
    kim "Können wir das Thema wechseln?"

# game/scripts/c18/c18.rpy:1761
translate german c18s001_Kim_890c041b:

    # mc "Por supuesto."
    mc "Natürlich."

# game/scripts/c18/c18.rpy:1763
translate german c18s001_Kim_e99bebcc:

    # mc "Mañana es el fin de la locura. No me malinterpretes, adoro los cumpleaños de las chicas, especialmente después de haberme perdido los últimos tres..."
    mc "Morgen ist der Wahnsinn endlich vorbei. Versteht mich nicht falsch, ich liebe Mädchengeburtstage, besonders nachdem ich die letzten drei verpasst habe…"

# game/scripts/c18/c18.rpy:1764
translate german c18s001_Kim_458fe098:

    # kim "*Risa* Pero es agotador. Los últimos dos días parece que la vida en casa ha girado en torno a [emm], [eri], [dap] y sus cumpleaños."
    kim "*Lacht* Aber es ist anstrengend. Die letzten zwei Tage drehte sich zu Hause scheinbar alles nur noch um [emm], [eri], [dap] und deren Geburtstage."

# game/scripts/c18/c18.rpy:1765
translate german c18s001_Kim_99ce5ea2:

    # kim "Incluso la llegada de Eva y Amanda parecía un regalo anticipado para ellas."
    kim "Schon die Ankunft von Eva und Amanda schien für sie ein vorgezogenes Geschenk zu sein."

# game/scripts/c18/c18.rpy:1766
translate german c18s001_Kim_cb38f586:

    # mc "Siempre ha sido un fin de semana especial. Pero este año todo parece sobredimensionado."
    mc "Es war immer ein besonderes Wochenende. Aber dieses Jahr wirkt alles übertrieben."

# game/scripts/c18/c18.rpy:1768
translate german c18s001_Kim_6c3ad41b:

    # kim "Yo las entiendo. Este año estás tú. Están Amanda y Eva. Están Olivia y Betty. Estamos nosotras. Y son el centro de atención de todas."
    kim "Ich verstehe sie. Dieses Jahr gibt es euch. Es gibt Amanda und Eva. Es gibt Olivia und Betty. Es gibt uns. Und sie stehen im Mittelpunkt der Aufmerksamkeit."

# game/scripts/c18/c18.rpy:1769
translate german c18s001_Kim_075a4b95:

    # kim "Es como sus cumpleaños de siempre pero hasta las cejas de esteroides."
    kim "Es ist wie ihre üblichen Geburtstage, nur vollgepumpt mit Steroiden."

# game/scripts/c18/c18.rpy:1770
translate german c18s001_Kim_cbd9ac9f:

    # mc "*Risa* Creo que no lo habría podido expresar mejor."
    mc "*lacht* Ich glaube, ich hätte es nicht besser ausdrücken können."

# game/scripts/c18/c18.rpy:1772
translate german c18s001_Kim_0cdbb488:

    # kim "Espero haber acertado con los regalos. Es complicado acertar... y no podía gastar mucho hasta que no me paguen por el trabajo de la semana que viene."
    kim "Ich hoffe, ich habe die richtigen Geschenke ausgesucht. Es ist gar nicht so einfach, die richtigen zu finden... und ich konnte nicht viel ausgeben, bis ich nächste Woche mein Gehalt bekomme."

# game/scripts/c18/c18.rpy:1773
translate german c18s001_Kim_bfa186e6:

    # mc "No creo que miren el valor sino la intención."
    mc "Ich glaube nicht, dass sie auf den Wert achten, sondern auf die Absicht."

# game/scripts/c18/c18.rpy:1774
translate german c18s001_Kim_f6767f19:

    # kim "Eso espero..."
    kim "Ich hoffe es..."

# game/scripts/c18/c18.rpy:1776
translate german c18s001_Kim_30fbdc48:

    # kim "¡Oh! Acabo de darme cuenta... ¿También son los cumpleaños de Eva y Amanda?"
    kim "Oh! Mir ist gerade aufgefallen... Sind das auch die Geburtstage von Eva und Amanda?"

# game/scripts/c18/c18.rpy:1777
translate german c18s001_Kim_143cc74d:

    # mc "No, fueron hace un mes más o menos."
    mc "Nein, das war vor etwa einem Monat."

# game/scripts/c18/c18.rpy:1779
translate german c18s001_Kim_ec50ffca:

    # kim "Menos mal... no les había comprado nada."
    kim "Gott sei Dank... ich hatte nichts bei ihnen gekauft."

# game/scripts/c18/c18.rpy:1780
translate german c18s001_Kim_ab87e77f:

    # mc "Aunque fueran sus cumpleaños, lo entenderían. Las conociste ayer. Pero no te preocupes. Solo son tres cumpleaños. Solo."
    mc "Selbst wenn sie Geburtstag hätten, würden sie es verstehen. Du hast sie ja erst gestern kennengelernt. Aber keine Sorge. Es sind ja nur drei Geburtstage. Wirklich nur drei."

# game/scripts/c18/c18.rpy:1782
translate german c18s001_Kim_502b2abc:

    # kim "Ayer... parece que ha pasado una vida entera, pero ayer hizo una semana que llegamos."
    kim "Gestern... es kommt mir vor wie eine Ewigkeit her, aber gestern war es genau eine Woche her, seit wir angekommen sind."

# game/scripts/c18/c18.rpy:1783
translate german c18s001_Kim_f43ae440:

    # kim "Mudarme a Newport es la mejor decisión que he tomado en mucho tiempo."
    kim "Der Umzug nach Newport war die beste Entscheidung, die ich seit Langem getroffen habe."

# game/scripts/c18/c18.rpy:1784
translate german c18s001_Kim_18670915:

    # kim "Vine por el calor y he encontrado el calor de una familia."
    kim "Ich kam auf der Suche nach Wärme und habe die Wärme einer Familie gefunden."

# game/scripts/c18/c18.rpy:1785
translate german c18s001_Kim_9f4e825f:

    # mc "Eso te ha quedado... casi poético. Me alegra que te sientas así."
    mc "Das klang... fast poetisch. Ich freue mich, dass du das so empfindest."

# game/scripts/c18/c18.rpy:1786
translate german c18s001_Kim_5eeaf5f0:

    # mc "Tu familia de Cleveland... ¿has hablado con ellos?"
    mc "Deine Familie in Cleveland... hast du mit ihnen gesprochen?"

# game/scripts/c18/c18.rpy:1788
translate german c18s001_Kim_8092e0f5:

    # kim "Hablo todos los días y se lo he explicado todo... bueno, menos La Clonversación... y alguna cosa más."
    kim "Ich spreche jeden Tag mit ihm und habe ihm alles erklärt... nun ja, bis auf das Klongespräch... und ein paar andere Dinge."

# game/scripts/c18/c18.rpy:1789
translate german c18s001_Kim_b5ad180f:

    # kim "Alucinan cuando les hablo de la familia. Dicen que nunca me habían visto adaptándome tan rápido a un sitio."
    kim "Sie sind immer wieder erstaunt, wenn ich ihnen von meiner Familie erzähle. Sie sagen, sie hätten mich noch nie so schnell an einen Ort einleben sehen."

# game/scripts/c18/c18.rpy:1790
translate german c18s001_Kim_27b9cbcf:

    # mc "¿Te costaba adaptarte? No lo entiendo, eres muy sociable."
    mc "Fiel es dir schwer, dich anzupassen? Ich verstehe das nicht, du bist doch sehr gesellig."

# game/scripts/c18/c18.rpy:1792
translate german c18s001_Kim_90e3b17d:

    # kim "Soy muy sociable porque lo ponéis muy fácil. Nadie juzga a nadie... bueno, quizás Olivia un poco."
    kim "Ich bin sehr gesellig, weil du es mir so leicht machst. Niemand verurteilt irgendjemanden... na ja, vielleicht Olivia ein bisschen."

# game/scripts/c18/c18.rpy:1793
translate german c18s001_Kim_e9496f0f:

    # kim "Nadie hace comentarios para hacer daño a nadie. Todo el mundo ayuda a todo el mundo en lo que puede."
    kim "Niemand äußert Kommentare, um jemanden zu verletzen. Jeder hilft jedem, so gut er kann."

# game/scripts/c18/c18.rpy:1794
translate german c18s001_Kim_087f7674:

    # kim "Y después estás tú. Parece que estás en todos sitios cuando alguna de nosotras te necesitamos."
    kim "Und dann bist da noch du. Es scheint, als wärst du immer dann da, wenn wir dich brauchen."

# game/scripts/c18/c18.rpy:1795
translate german c18s001_Kim_a13ee82f:

    # mc "Era una de mis funciones cuando erais solo clientas... eso ha sonado muy mal. *Risa*"
    mc "Das gehörte zu meinen Aufgaben, als Sie noch Kunden waren... das klang wirklich blöd. *lacht*"

# game/scripts/c18/c18.rpy:1796
translate german c18s001_Kim_143dc688:

    # mc "Ahora, además, lo hago por pasar tiempo con vosotras."
    mc "Ich mache das jetzt auch, um Zeit mit euch allen zu verbringen."

# game/scripts/c18/c18.rpy:1798
translate german c18s001_Kim_fd10106e:

    # kim "Y nosotras te lo agradecemos. Mucho."
    kim "Und dafür danken wir Ihnen sehr."

# game/scripts/c18/c18.rpy:1799
translate german c18s001_Kim_271c2c3d:

    # kim "Es difícil tener una conversación con cualquiera de las chicas en la que no se hable de ti tarde o temprano."
    kim "Es ist schwierig, sich mit einem der Mädchen zu unterhalten, ohne dass man früher oder später zur Sprache kommt."

# game/scripts/c18/c18.rpy:1800
translate german c18s001_Kim_10832dd0:

    # kim "No es que seas el centro de cada conversación, aún estamos en ese momento en que nos quedan planes y sueños que compartir, pero sueles aparecer en muchas de ellas."
    kim "Es ist nicht so, dass du im Mittelpunkt jedes Gesprächs stehst; wir sind noch in der Phase, in der wir Pläne und Träume teilen, aber du tauchst in vielen davon auf."

# game/scripts/c18/c18.rpy:1801
translate german c18s001_Kim_c436991a:

    # mc "*Risa* No sé si sentirme halagado o estudiado."
    mc "*lacht* Ich weiß nicht, ob ich mich geschmeichelt fühlen oder mich beobachtet fühlen soll."

# game/scripts/c18/c18.rpy:1803
translate german c18s001_Kim_6e76ae0b:

    # kim "*Risa* Halagado, por supuesto. Eres el único chico en una familia de mujeres."
    kim "*Lacht* Natürlich fühle ich mich geschmeichelt. Du bist der einzige Junge in einer Familie voller Frauen."

# game/scripts/c18/c18.rpy:1804
translate german c18s001_Kim_e0a38ae3:

    # kim "Tengo ganas de conocer al tal Jamaal mañana, aunque puede cohibir a alguna de las chicas para ir en topless... o desnudas en el jacuzzi. Más incluso de lo que las cohíbes tú."
    kim "Ich freue mich schon darauf, Jamaal morgen zu treffen, obwohl er vielleicht einige der Mädchen verunsichern wird, wenn sie oben ohne oder nackt im Whirlpool sind. Noch mehr, als du sie verunsichern würdest."

# game/scripts/c18/c18.rpy:1805
translate german c18s001_Kim_01fba5e8:

    # mc "Jamaal es muy buen tío, pero no va a estar interesado en vosotras. Se pasará el día comiendo y metiéndose conmigo. Además, no puede subir las escaleras del jacuzzi. *Risa*"
    mc "Jamaal ist echt ein netter Kerl, aber er wird sich nicht für euch Mädels interessieren. Er wird den ganzen Tag essen und mich necken. Außerdem kommt er ja nicht mal die Treppe vom Whirlpool hoch. *lacht*"

# game/scripts/c18/c18.rpy:1806
translate german c18s001_Kim_0e10ac56:

    # mc "¿Y yo os cohíbo? No lo había pensado."
    mc "Und ich halte dich zurück? Daran hatte ich noch gar nicht gedacht."

# game/scripts/c18/c18.rpy:1808
translate german c18s001_Kim_71cb6066:

    # kim "Algunas de nosotras somos conscientes de nuestro aspecto. No te voy a decir quiénes."
    kim "Manche von uns sind unsicher, was ihr Aussehen angeht. Ich werde Ihnen nicht sagen, wer."

# game/scripts/c18/c18.rpy:1809
translate german c18s001_Kim_a919805d:

    # kim "Desnudarse, aunque sea parcialmente delante de un chico, siempre es un paso importante. Especialmente si ese chico te gusta."
    kim "Sich vor einem Mann auszuziehen, selbst nur teilweise, ist immer ein großer Schritt. Besonders, wenn man diesen Mann mag."

# game/scripts/c18/c18.rpy:1810
translate german c18s001_Kim_07a2818b:

    # mc "Bueno, si ese chico le gusta a alguien, todo el mundo sabe que a ese chico le gusta hablar las cosas. Especialmente si eso supone un problema."
    mc "Nun, wenn jemand diesen Kerl mag, weiß jeder, dass er gerne Dinge ausdiskutiert. Besonders dann, wenn es Probleme verursacht."

# game/scripts/c18/c18.rpy:1812
translate german c18s001_Kim_e15856aa:

    # kim "Quizás demasiado. A veces muy poco."
    kim "Vielleicht zu viel. Manchmal zu wenig."

# game/scripts/c18/c18.rpy:1813
translate german c18s001_Kim_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c18/c18.rpy:1815
translate german c18s001_Kim_fe9f7327:

    # "Un móvil suena en algún sitio."
    "Irgendwo klingelt ein Handy."

# game/scripts/c18/c18.rpy:1823
translate german c18s001_Kim_91f374f0:

    # kim "Te he dicho que me gustas y me has dejado cambiar de tema."
    kim "Ich habe dir gesagt, dass ich dich mag, und du hast mich das Thema wechseln lassen."

# game/scripts/c18/c18.rpy:1824
translate german c18s001_Kim_69706e4b:

    # mc "Me lo has pedido tú."
    mc "Du hast mich darum gebeten."

# game/scripts/c18/c18.rpy:1826
translate german c18s001_Kim_1f0fd4d5:

    # kim "Lo sé. Pero casi esperaba que siguieras hablando... que me intentaras convencer para que tomara una decisión..."
    kim "Ich weiß. Aber ich hatte fast erwartet, dass du weiterredest... um zu versuchen, mich zu einer Entscheidung zu bewegen..."

# game/scripts/c18/c18.rpy:1827
translate german c18s001_Kim_ce2d76a2:

    # kim "Ahora ha pasado el momento, pero en ese momento lo esperaba."
    kim "Die Zeit ist nun vergangen, aber damals habe ich darauf gewartet."

# game/scripts/c18/c18.rpy:1828
translate german c18s001_Kim_992a26ad:

    # mc "No voy a forzarte a tomar una decisión, Kim. Es algo que tienes que pensar tú y llegar a tus propias conclusiones."
    mc "Ich werde dich nicht zu einer Entscheidung zwingen, Kim. Du musst darüber nachdenken und zu deinen eigenen Schlüssen kommen."

# game/scripts/c18/c18.rpy:1830
translate german c18s001_Kim_5bf97fc7:

    # kim "Ni siquiera me has dicho que yo también te gusto..."
    kim "Du hast mir noch nicht einmal gesagt, dass du mich auch magst..."

# game/scripts/c18/c18.rpy:1832
translate german c18s001_Kim_6978ba63:

    # mc "Creo que ya te lo demostré en la playa."
    mc "Ich glaube, das habe ich dir am Strand schon bewiesen."

# game/scripts/c18/c18.rpy:1834
translate german c18s001_Kim_6d41a4ae:

    # mc "Eres preciosa, Kim."
    mc "Du bist wunderschön, Kim."

# game/scripts/c18/c18.rpy:1835
translate german c18s001_Kim_029a6582:

    # mc "Pero yo tampoco he decidido si siento algo por ti más allá de... eso. Tan solo pensaba que debíamos hablarlo."
    mc "Aber ich bin mir auch noch nicht sicher, ob ich darüber hinaus noch etwas für dich empfinde. Ich dachte nur, wir sollten darüber reden."

# game/scripts/c18/c18.rpy:1838
translate german c18s001_Kim_1df2fe9f:

    # kim "A nada... "
    kim "Nichts..."

# game/scripts/c18/c18.rpy:1839
translate german c18s001_Kim_dd5b7480:

    # mc "A algo te tienes que estar refiriendo..."
    mc "Du musst auf etwas anspielen..."

# game/scripts/c18/c18.rpy:1841
translate german c18s001_Kim_3623b69b:

    # kat "Creo que es mi turno, Kim."
    kat "Ich glaube, jetzt bin ich an der Reihe, Kim."

# game/scripts/c18/c18.rpy:1843
translate german c18s001_Kim_ac397e61:

    # kim "Todo para ti, Kate."
    kim "Alles für dich, Kate."

# game/scripts/c18/c18.rpy:1844
translate german c18s001_Kim_a06f15b8:

    # kim "Te veo en mi siguiente turno, [mc]."
    kim "Wir sehen uns bei meiner nächsten Schicht, [mc]."

# game/scripts/c18/c18.rpy:1845
translate german c18s001_Kim_43b28d10:

    # mc "Hasta ahora, Kim."
    mc "Bis jetzt, Kim."

# game/scripts/c18/c18.rpy:1859
translate german c18s001_Common_2e047454:

    # "La noche continua con diversos bailes y conversaciones."
    "Die Nacht geht weiter mit verschiedenen Tänzen und Gesprächen."

# game/scripts/c18/c18.rpy:1861
translate german c18s001_Common_1d07b342:

    # "Pierdes la cuenta de cuántas veces has bailado con cada una de ellas y de los bailes en grupo que habéis hecho."
    "Man verliert irgendwann den Überblick darüber, wie oft man mit jedem Einzelnen getanzt hat und wie viele Gruppentänze man insgesamt schon gemacht hat."

# game/scripts/c18/c18.rpy:1862
translate german c18s001_Common_e822f724:

    # "Pero el cansancio va haciendo mella en algunas de las chicas y decidís retiraros antes de que el Jazz Corner cierre."
    "Doch die Erschöpfung macht sich bei einigen Mädchen bemerkbar, und du beschließt, vor Schließung des Jazz Corner zu gehen."

# game/scripts/c18/c18.rpy:1864
translate german c18s001_Common_2bc5173d:

    # "Os despedís de Megan y de Anthony y volvéis a casa."
    "Du verabschiedest dich von Megan und Anthony und fährst nach Hause."

# game/scripts/c18/c18.rpy:1866
translate german c18s001_Common_83134abb:

    # "Llegáis a casa para dejar a las chicas y el coche que conduce Amanda."
    "Du kommst nach Hause, um die Mädchen und das Auto, das Amanda fährt, abzusetzen."

# game/scripts/c18/c18.rpy:1868
translate german c18s001_Common_90f4e1ee:

    # "Continuáis con una larga despedida."
    "Sie fahren mit einem langen Abschied fort."

# game/scripts/c18/c18.rpy:1869
translate german c18s001_Common_08486c9b:

    # "Todas las chicas se abrazan mientras otras esperan su turno para darte el beso de buenas noches."
    "Alle Mädchen umarmen sich gegenseitig, während andere darauf warten, dir einen Gutenachtkuss zu geben."

# game/scripts/c18/c18.rpy:1871
translate german c18s001_Common_1d13c602:

    # "Amanda y Eva se suben a tu pick up y las llevas a la base."
    "Amanda und Eva steigen in Ihren Pickup-Truck und Sie bringen sie zur Basis."

# game/scripts/c18/c18.rpy:1872
translate german c18s001_Common_006c8ddc:

    # "Casi estabas seguro de que se iban a pelear por quién se sienta delante."
    "Man war sich fast sicher, dass sie sich darum streiten würden, wer vorne sitzen sollte."

# game/scripts/c18/c18.rpy:1873
translate german c18s001_Common_2cac4a93:

    # "Para tu sorpresa, no lo hacen y Amanda se sienta en el asiento delantero."
    "Zu Ihrer Überraschung ist das nicht der Fall, und Amanda sitzt auf dem Beifahrersitz."

# game/scripts/c18/c18.rpy:1876
translate german c18s001_Common_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c18/c18.rpy:1878
translate german c18s001_Common_754189e3:

    # mc "Bueno, aquí ha acabado la noche. Nos vemos mañana."
    mc "So, das war's für heute Abend. Bis morgen."

# game/scripts/c18/c18.rpy:1879
translate german c18s001_Common_ff43bd63:

    # ama "¿No tenemos beso de buenas noches?"
    ama "Gibt es denn keinen Gute-Nacht-Kuss?"

# game/scripts/c18/c18.rpy:1880
translate german c18s001_Common_7a8e19b1:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1881
translate german c18s001_Common_e20c92f6:

    # eva "Todas lo han tenido..." (multiple=2)
    eva "Sie hatten es alle..." (multiple=2)

# game/scripts/c18/c18.rpy:1882
translate german c18s001_Common_76737ff5:

    # mc "Escuchad. No quiero ser la causa de un problema entre vosotras. O entre vosotras y el resto de las chicas."
    mc "Hör zu. Ich will keine Probleme zwischen euch verursachen. Oder zwischen dir und den anderen Mädchen."

# game/scripts/c18/c18.rpy:1883
translate german c18s001_Common_53931e64:

    # mc "Sé que esto es nuevo para vosotras y también lo es para mí."
    mc "Ich weiß, das ist neu für dich, und für mich ist es auch neu."

# game/scripts/c18/c18.rpy:1884
translate german c18s001_Common_f2567306:

    # mc "Creo que tenéis que hablar y marcar unos límites que las dos vayáis a respetar."
    mc "Ich denke, ihr müsst miteinander reden und ein paar Grenzen festlegen, die ihr beide respektieren werdet."

# game/scripts/c18/c18.rpy:1886
translate german c18s001_Common_9cc93f29:

    # eva "¿A qué clase de límites te refieres?"
    eva "Auf welche Art von Beschränkungen beziehen Sie sich?"

# game/scripts/c18/c18.rpy:1887
translate german c18s001_Common_dccc4e63:

    # mc "No te puedes enfadar porque Amanda me dé un beso una décima de segundo más largo que el tuyo."
    mc "Du kannst nicht wütend sein, weil Amandas Kuss eine Zehntelsekunde länger ist als deiner."

# game/scripts/c18/c18.rpy:1889
translate german c18s001_Common_725c10c0:

    # mc "Y tú no puedes echarle en cara a tu {b}hermana{/b} que se haya puesto un vestido precioso."
    mc "Und du kannst deiner Schwester keinen Vorwurf machen, wenn sie ein schönes Kleid trägt."

# game/scripts/c18/c18.rpy:1890
translate german c18s001_Common_a7810a76:

    # ama "Lo sé..."
    ama "Ich weiß..."

# game/scripts/c18/c18.rpy:1891
translate german c18s001_Common_ff2c8c19:

    # mc "Sé que os gusto... al menos físicamente. Pero {b}nunca{/b} os peleéis por un chico. Ni por nadie."
    mc "Ich weiß, du magst mich... zumindest körperlich. Aber streite dich nie wegen eines Jungen. Oder wegen irgendjemandem."

# game/scripts/c18/c18.rpy:1892
translate german c18s001_Common_2b344f0a:

    # mc "No vale la pena perder lo que tenéis por nada ni por nadie. Mucho menos por mí."
    mc "Es lohnt sich nicht, das, was man hat, für irgendetwas oder irgendjemanden zu verlieren. Schon gar nicht für mich."

# game/scripts/c18/c18.rpy:1894
translate german c18s001_Common_794897d7:

    # ama "Hemos hablado en el Jazz Corner..."
    ama "Wir haben uns im Jazz Corner unterhalten..."

# game/scripts/c18/c18.rpy:1895
translate german c18s001_Common_7a8e19b1_1:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1896
translate german c18s001_Common_c39e3eee:

    # eva "Aún tenemos que pulir unos temas..." (multiple=2)
    eva "Ein paar Dinge müssen wir noch klären..." (multiple=2)

# game/scripts/c18/c18.rpy:1897
translate german c18s001_Common_9aae8e13:

    # ama "Pero tienes razón..."
    ama "Aber du hast Recht..."

# game/scripts/c18/c18.rpy:1898
translate german c18s001_Common_7a8e19b1_2:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1899
translate german c18s001_Common_5071a624:

    # eva "No vamos a volver a discutir por ti..." (multiple=2)
    eva "Wir werden nicht noch einmal über dich streiten..." (multiple=2)

# game/scripts/c18/c18.rpy:1900
translate german c18s001_Common_0174b09c:

    # mc "Ni por nadie."
    mc "Nicht für irgendjemanden."

# game/scripts/c18/c18.rpy:1902
translate german c18s001_Common_9a77b51c:

    # ama "Ni por nadie..." (multiple=2)
    ama "Nicht für jedermann geeignet..." (multiple=2)

# game/scripts/c18/c18.rpy:1903
translate german c18s001_Common_3d573abe:

    # eva "Ni por nadie..." (multiple=2)
    eva "Nicht für jedermann geeignet..." (multiple=2)

# game/scripts/c18/c18.rpy:1905
translate german c18s001_Common_de2b9aa1:

    # ama "Las dos queremos estar contigo. Pero yo no quiero perder a mi hermana."
    ama "Wir beide wollen mit dir zusammen sein. Aber ich will meine Schwester nicht verlieren."

# game/scripts/c18/c18.rpy:1906
translate german c18s001_Common_d20f4a7b:

    # ama "No te ofendas, pero prefiero estar sin ti que sin Eva."
    ama "Nimm es mir nicht übel, aber ich wäre lieber ohne dich als ohne Eva."

# game/scripts/c18/c18.rpy:1907
translate german c18s001_Common_ba5c1ec9:

    # mc "No me puedo ofender por eso. Es lógico."
    mc "Ich kann mich davon nicht beleidigt fühlen. Das ist logisch."

# game/scripts/c18/c18.rpy:1909
translate german c18s001_Common_2fcd7aee:

    # eva "A mí me pasa lo mismo. Me puedo imaginar una vida sin ti, pero no sin Amanda."
    eva "Mir geht es genauso. Ich kann mir ein Leben ohne dich vorstellen, aber nicht ohne Amanda."

# game/scripts/c18/c18.rpy:1911
translate german c18s001_Common_d8e48fa3:

    # eva "Sabemos que, con tu harén, esto no es un problema para ti, pero es nuevo para nosotras."
    eva "Wir wissen, dass das für Sie mit Ihrem Harem kein Problem darstellt, aber für uns ist es neu."

# game/scripts/c18/c18.rpy:1913
translate german c18s001_Common_ec0963d5:

    # eva "Sabemos que estás con alguien y no vemos cómo podemos encajar o incluso si podemos. Como has dicho, esto es nuevo para nosotras."
    eva "Wir wissen, dass du in einer Beziehung bist, und wir können uns nicht vorstellen, wie wir da reinpassen könnten, oder ob das überhaupt möglich wäre. Wie du schon sagtest, ist das alles neu für uns."

# game/scripts/c18/c18.rpy:1915
translate german c18s001_Common_71068c65:

    # eva "Sabemos la relación que tenías con Saira en Portland y no sabemos si podríamos tener algo así. Como has dicho, esto es nuevo para nosotras."
    eva "Wir wissen von Ihrer Beziehung zu Saira in Portland und wissen nicht, ob wir so etwas aufbauen könnten. Wie Sie schon sagten, ist das neu für uns."

# game/scripts/c18/c18.rpy:1916
translate german c18s001_Common_0f3d1c29:

    # eva "Ni siquiera sabemos si tú quieres tener algo con alguna de nosotras... o con las dos... No contestes."
    eva "Wir wissen ja noch gar nicht, ob du mit einem von uns oder mit uns beiden etwas anfangen willst... Antworte nicht."

# game/scripts/c18/c18.rpy:1918
translate german c18s001_Common_4e522b56:

    # ama "Se nos han ocurrido un par de ideas. A las dos nos gustas... y no sólo físicamente."
    ama "Wir haben uns ein paar Ideen überlegt. Wir mögen dich beide... und nicht nur körperlich."

# game/scripts/c18/c18.rpy:1919
translate german c18s001_Common_c5cf5fa9:

    # ama "Tenemos que hablar entre nosotras a ver cómo actuamos sobre ello. Pero no va a haber más discusiones."
    ama "Wir müssen untereinander besprechen, wie wir damit umgehen. Aber es wird keine Streitereien mehr geben."

# game/scripts/c18/c18.rpy:1920
translate german c18s001_Common_6fddac9c:

    # mc "Me parece una buena idea, ya sabéis que..."
    mc "Ich finde das eine gute Idee, du weißt ja, wie das ist..."

# game/scripts/c18/c18.rpy:1922
translate german c18s001_Common_41c8c6c1:

    # ama "Hay que hablarlo todo. *Risa*" (multiple=2)
    ama "Wir müssen über alles reden. *lacht*" (multiple=2)

# game/scripts/c18/c18.rpy:1923
translate german c18s001_Common_fcc12059:

    # eva "El método [mc]. *Risa*" (multiple=2)
    eva "Die [mc]-Methode. *Gelächter*" (multiple=2)

# game/scripts/c18/c18.rpy:1924
translate german c18s001_Common_bd747909:

    # mc "*Risa* Sí, exactamente."
    mc "*Lacht* Ja, genau."

# game/scripts/c18/c18.rpy:1925
translate german c18s001_Common_f3bade94:

    # mc "Os voy a dejar hablar sobre lo que tengáis que hablar. Vamos con esos besos."
    mc "Ich lasse dich über alles reden, worüber du reden musst. Jetzt aber zu den Küssen."

# game/scripts/c18/c18.rpy:1927
translate german c18s001_Common_471531e1:

    # ama "Empieza tú, Eva."
    ama "Du fängst an, Eva."

# game/scripts/c18/c18.rpy:1928
translate german c18s001_Common_7a8e19b1_3:

    # "" (multiple=2)
    "" (multiple=2)

# game/scripts/c18/c18.rpy:1929
translate german c18s001_Common_57dbe6bc:

    # eva "No, no, empieza tú." (multiple=2)
    eva "Nein, nein, du fängst an." (multiple=2)

# game/scripts/c18/c18.rpy:1931
translate german c18s001_Common_6012d416:

    # "Coges a Eva de los hombros y la giras hacia ti."
    "Du packst Eva an den Schultern und drehst sie zu dir um."

# game/scripts/c18/c18.rpy:1933
translate german c18s001_Common_27e920b0:

    # mc "Buenas noches, Eva."
    mc "Guten Abend, Eva."

# game/scripts/c18/c18.rpy:1934
translate german c18s001_Common_908189e8:

    # eva "Buenas noches, [mc]."
    eva "Guten Abend, [mc]."

# game/scripts/c18/c18.rpy:1936
translate german c18s001_Common_61333a4b:

    # mc "Buenas noches, Amanda."
    mc "Guten Abend, Amanda."

# game/scripts/c18/c18.rpy:1937
translate german c18s001_Common_3ab2b35f:

    # ama "Buenas noches, [mc]."
    ama "Guten Abend, [mc]."

# game/scripts/c18/c18.rpy:1939
translate german c18s001_Common_b6f52099:

    # eva "*Susurrando* ¡Ha empezado por mí!"
    eva "*Flüsternd* Es begann mit mir!"

# game/scripts/c18/c18.rpy:1940
translate german c18s001_Common_3972a2d6:

    # ama "*Susurrando* ¡Ha dejado lo mejor para el final!"
    ama "*Flüsternd* Er hat sich das Beste bis zum Schluss aufgehoben!"

# game/scripts/c18/c18.rpy:1942
translate german c18s001_Common_8d4f83d5:

    # mcp "(*Risa mental* Lo de estás chicas es increíble. Pueden ser todo un problema.)"
    mcp "(*Innerliches Lachen* Diese Mädchen sind unglaublich. Die könnten echt ein Problem werden.)"

# game/scripts/c18/c18.rpy:1943
translate german c18s001_Common_756f3d38:

    # mcp "(Tan solo espero que cumplan lo que han dicho y dejen de discutir.)"
    mcp "(Ich hoffe nur, dass sie ihr Wort halten und aufhören zu streiten.)"

# game/scripts/c18/c18.rpy:1945
translate german c18s001_Common_a51c77ce:

    # "Vuelves a casa y subes a tu habitación sin encender las luces. Es tarde y no quieres despertar a nadie."
    "Du gehst nach Hause und in dein Zimmer, ohne das Licht anzuschalten. Es ist spät und du willst niemanden wecken."

# game/scripts/c18/c18.rpy:1950
translate german c18s002_NoSaira_f81ffc99:

    # "Llegas sin sueño a tu habitación y decides jugar un rato a My Residence."
    "Du kommst übermüdet nach Hause und beschließt, eine Weile My Residence zu spielen."

# game/scripts/c18/c18.rpy:1951
translate german c18s002_NoSaira_9d26d0ce:

    # "Hoy toca una escena con Aishwarya."
    "Heute drehen wir eine Szene mit Aishwarya."

# game/scripts/c18/c18.rpy:1979
translate german c18s002_Saira_24a9d99e:

    # "Al entrar en tu habitación te encuentras con que hay alguien en tu cama."
    "Als du dein Zimmer betrittst, stellst du fest, dass jemand in deinem Bett liegt."

# game/scripts/c18/c18.rpy:1980
translate german c18s002_Saira_a0759cf2:

    # mcp "(¿Saira? ¿Qué hace aquí? ¿Está dormida?)"
    mcp "(Saira? Was macht sie denn hier? Schläft sie?)"

# game/scripts/c18/c18.rpy:1981
translate german c18s002_Saira_d015ed1c:

    # mcp "(¿Cama o sofá? Si se ha quedado dormida no quiero despertarla.)"
    mcp "(Bett oder Sofa? Wenn sie eingeschlafen ist, möchte ich sie nicht wecken.)"

# game/scripts/c18/c18.rpy:1983
translate german c18s002_Saira_5a932ed0:

    # "Empiezas a desnudarte, intentando ser lo más silencioso posible."
    "Du beginnst dich auszuziehen und versuchst dabei, so leise wie möglich zu sein."

# game/scripts/c18/c18.rpy:1984
translate german c18s002_Saira_a55a43ea:

    # "Ha dejado su vestido y joyería en el sofá."
    "Sie ließ ihr Kleid und ihren Schmuck auf dem Sofa zurück."

# game/scripts/c18/c18.rpy:1985
translate german c18s002_Saira_feabdc9a:

    # mcp "(Pues va a ser cama. Si empiezo a mover todo esto, es probable que alguna de sus pulseras acabe cayendo al suelo y despertándola.)"
    mcp "(So, es wird bald Schlafenszeit. Wenn ich jetzt anfange, das alles umzuräumen, fällt ihr wahrscheinlich eines ihrer Armbänder auf den Boden und weckt sie auf.)"

# game/scripts/c18/c18.rpy:1986
translate german c18s002_Saira_4a112d12:

    # "Cuando ya te has desnudado..."
    "Sobald Sie sich ausgezogen haben..."

# game/scripts/c18/c18.rpy:1988
translate german c18s002_Saira_9508cfe9:

    # sai "*Susurrando* ¿[mc]? Has tardado mucho en volver... me he quedado dormida..."
    sai "*Flüsternd* Was? Du hast so lange gebraucht, um zurückzukommen... Ich bin eingeschlafen..."

# game/scripts/c18/c18.rpy:1989
translate german c18s002_Saira_fbcc63af:

    # mc "*Susurrando* Las cosas se han complicado con Eva y Amanda. Vuelve a dormir."
    mc "*Flüsternd* Die Lage zwischen Eva und Amanda ist kompliziert geworden. Schlaf wieder."

# game/scripts/c18/c18.rpy:1990
translate german c18s002_Saira_2a442ed6:

    # sai "*Susurrando* No, enciende una luz... me has dicho que tomara la iniciativa y es lo que voy a hacer."
    sai "*Flüsternd* Nein, mach das Licht an... du hast mir gesagt, ich soll die Initiative ergreifen, und genau das werde ich tun."

# game/scripts/c18/c18.rpy:1993
translate german c18s002_Saira_83ff589c:

    # mc "*Susurrando* Dijiste que no querías hacer nada con las otras chicas en la casa..."
    mc "*Flüsternd* Du hast gesagt, du wolltest nichts mit den anderen Mädchen im Haus anfangen..."

# game/scripts/c18/c18.rpy:1994
translate german c18s002_Saira_2d7df520:

    # sai "*Susurrando* Eso fue antes de esta noche. Bailar contigo, tenerte entre mis brazos... No hay nadie durmiendo debajo hasta que vuelva Megan."
    sai "*Flüsternd* Das war vor heute Abend. Mit dir tanzen, dich in meinen Armen halten... Niemand schläft unten, bis Megan zurückkommt."

# game/scripts/c18/c18.rpy:1995
translate german c18s002_Saira_18957408:

    # sai "*Susurrando* Nadie se va a enterar si no me haces gritar demasiado fuerte."
    sai "*flüstert* Niemand wird es herausfinden, es sei denn, du bringst mich zum Schreien."

# game/scripts/c18/c18.rpy:1996
translate german c18s002_Saira_f29e210c:

    # mc "*Susurrando* No puedo prometer nada. *Risa*"
    mc "*flüstert* Ich kann nichts versprechen. *lacht*"

# game/scripts/c18/c18.rpy:1998
translate german c18s002_Saira_a758da44:

    # sai "*Susurrando* Ven aquí. Hace mucho que no compartimos cama..."
    sai "*Flüsternd* Komm her. Es ist schon lange her, dass wir zusammen im Bett geschlafen haben..."

# game/scripts/c18/c18.rpy:1999
translate german c18s002_Saira_e01ad07f:

    # mc "*Susurrando* Esa es una oferta que no voy a poder rechazar."
    mc "*flüstert* Das ist ein Angebot, das ich nicht ablehnen kann."

# game/scripts/c18/c18.rpy:2001
translate german c18s002_Saira_e0a043a5:

    # sai "*Susurrando* Entonces no te lo pienses más. Te estoy esperando."
    sai "*Flüsternd* Dann denk nicht mehr darüber nach. Ich warte auf dich."

# game/scripts/c18/c18.rpy:2004
translate german c18s002_Saira_c6f3b074:

    # "Vuestros labios se juntan ansiosos, mientras vuestras manos recorren vuestros cuerpos con la misma o más ansia."
    "Eure Lippen treffen sich voller Sehnsucht, während eure Hände mit der gleichen oder sogar noch größeren Sehnsucht über die Körper des anderen wandern."

# game/scripts/c18/c18.rpy:2005
translate german c18s002_Saira_4e2b5a07:

    # "Las manos quieren su ración de piel. Los labios se han encontrado con anterioridad."
    "Die Hände wollen ihren Anteil an Haut. Die Lippen haben sich schon einmal berührt."

# game/scripts/c18/c18.rpy:2006
translate german c18s002_Saira_678cbd81:

    # "Los dedos hacen meses que no tocan la piel del otro."
    "Ihre Finger haben sich seit Monaten nicht mehr berührt."

# game/scripts/c18/c18.rpy:2010
translate german c18s002_Saira_c433971c:

    # "Puedes notar como sus enormes tetas de pezones erectos se frotan levemente contra tu pecho en los suaves movimientos del prolongado beso."
    "Du kannst spüren, wie ihre riesigen Brüste mit den steifen Brustwarzen bei den sanften Bewegungen des lang anhaltenden Kusses leicht an deiner Brust reiben."

# game/scripts/c18/c18.rpy:2011
translate german c18s002_Saira_1ec0d1c2:

    # "No tardas en sentir cómo tu erección empieza a crecer. Volver a tener el cuerpo de Saira entre tus brazos es maravilloso."
    "Du spürst, wie deine Erektion wächst. Sairas Körper wieder in deinen Armen zu halten, ist wundervoll."

# game/scripts/c18/c18.rpy:2012
translate german c18s002_Saira_a753a26e:

    # sai "*Gemido*"
    sai "*Stöhnen*"

# game/scripts/c18/c18.rpy:2016
translate german c18s002_Saira_931684b7:

    # "Introduces tu muslo entre los suyos, presionando su entrepierna y notando el calor que sale de ella."
    "Du schiebst deinen Oberschenkel zwischen ihre, drückst gegen ihren Schritt und spürst die Hitze, die von ihr ausgeht."

# game/scripts/c18/c18.rpy:2017
translate german c18s002_Saira_5dfb6d13:

    # sai "*Jadeo*"
    sai "*Keuchend*"

# game/scripts/c18/c18.rpy:2018
translate german c18s002_Saira_2599bcb1:

    # "También puedes notar lo húmeda que está. No eres el único que se ha puesto cachondo con el roce de vuestras manos."
    "Man kann auch spüren, wie feucht es ist. Du bist nicht der Einzige, der durch die Berührung deiner Hände erregt wurde."

# game/scripts/c18/c18.rpy:2021
translate german c18s002_Saira_58fc3c40:

    # sai "*Susurrando* He echado mucho de menos esto. *Gemido* Sigues siendo tan bueno como siempre."
    sai "*Flüsternd* Ich habe das so sehr vermisst. *Stöhnend* Du bist immer noch so gut wie eh und je."

# game/scripts/c18/c18.rpy:2022
translate german c18s002_Saira_73f76c67:

    # mc "*Susurrando* Tú tampoco has perdido un ápice de tus talentos con esa lengua. *Risa*"
    mc "*flüstert* Du hast mit deiner Zunge kein bisschen von deinem Talent eingebüßt. *lacht*"

# game/scripts/c18/c18.rpy:2023
translate german c18s002_Saira_dce73306:

    # sai "*Susurrando* Y puedo notar en mi estómago que ya estás preparado para mí."
    sai "*Flüsternd* Und ich spüre es in meinem Bauch, dass du bereit für mich bist."

# game/scripts/c18/c18.rpy:2025
translate german c18s002_Saira_9258b632:

    # sai "*Susurrando* ¿Te importa si pasamos de los preliminares?"
    sai "*Flüsternd* Hätten Sie etwas dagegen, wenn wir die Vorrunden überspringen?"

# game/scripts/c18/c18.rpy:2026
translate german c18s002_Saira_6aca143b:

    # sai "*Susurrando* También he echado de menos a mi bebé."
    sai "*flüsternd* Ich habe mein Baby auch vermisst."

# game/scripts/c18/c18.rpy:2027
translate german c18s002_Saira_caf517b5:

    # mc "*Susurrando* Creo que es la primera vez que quieres saltarte los juegos previos. Siempre te han encantado."
    mc "*Flüsternd* Ich glaube, das ist das erste Mal, dass du auf das Vorspiel verzichten willst. Du hast es doch immer geliebt."

# game/scripts/c18/c18.rpy:2029
translate german c18s002_Saira_4bfc6df8:

    # sai "*Susurrando* Es la primera vez que tengo que volver a mi cama antes de que mi compañera de habitación vuelva de trabajar. *Risita*"
    sai "*Flüsternd* Das ist das erste Mal, dass ich zurück in mein Bett musste, bevor meine Mitbewohnerin von der Arbeit kommt. *Kichert*"

# game/scripts/c18/c18.rpy:2030
translate german c18s002_Saira_f4fc4c21:

    # mc "*Susurrando* Me parece una buena razón."
    mc "*Flüsternd* Das klingt nach einem guten Grund."

# game/scripts/c18/c18.rpy:2031
translate german c18s002_Saira_8529b2e9:

    # sai "*Susurrando* Déjame darme la vuelta..."
    sai "*Flüsternd* Lass mich mich umdrehen..."

# game/scripts/c18/c18.rpy:2033
translate german c18s002_Saira_80891580:

    # "Saira se tumba en su posición favorita, apoyando su espalda en tu pecho."
    "Saira legt sich in ihrer Lieblingsposition hin und lehnt ihren Rücken an deine Brust."

# game/scripts/c18/c18.rpy:2034
translate german c18s002_Saira_5c1724bd:

    # "Tu glande apuntando a su entrada."
    "Deine Eichel zeigt auf ihren Eingang."

# game/scripts/c18/c18.rpy:2035
translate german c18s002_Saira_e1035647:

    # mc "*Susurrando* ¿Preparada?"
    mc "*Flüsternd* Bereit?"

# game/scripts/c18/c18.rpy:2036
translate german c18s002_Saira_7eaf5a46:

    # sai "*Susurrando* Cuando quieras..."
    sai "*Flüsternd* Wann immer du willst..."

