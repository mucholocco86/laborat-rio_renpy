

# game/scripts/c18/c18.rpy:278
translate german c18s001_Dinner_1a5439ac:

    # "El beso continúa unos segundos más antes de que Eva se separe."
    "Der Kuss dauert noch einige Sekunden an, bevor Eva sich löst."

# game/scripts/c18/c18.rpy:280
translate german c18s001_Dinner_2014e024:

    # mc "¿Sigues comprobando si voy a cortar el beso por ser demasiado largo? *Risa*"
    mc "Überprüfst du immer noch, ob ich den Kuss abbreche, weil er zu lang ist? *lacht*"

# game/scripts/c18/c18.rpy:281
translate german c18s001_Dinner_7bbe8b15:

    # eva "¿Yoooo? ¿Cómo puedes pensar eso de mí? *Risita*"
    eva "Ich? Wie konntest du nur so etwas über mich denken? *Kichert*"

# game/scripts/c18/c18.rpy:282
translate german c18s001_Dinner_acd60833:

    # mc "Porque es lo que haría [emm] *Risa*"
    mc "Denn genau das würde ich tun. [emm] *lacht*"

# game/scripts/c18/c18.rpy:284
translate german c18s001_Dinner_6d83f316:

    # eva "Bueno... si Amanda puede darte besos largos, ¿por qué no voy a poder yo? ¿O para mí sí que hay una duración de besos marcada?"
    eva "Nun ja... wenn Amanda dir lange Küsse geben kann, warum kann ich das nicht? Oder gibt es für mich eine festgelegte Dauer für Küsse?"

# game/scripts/c18/c18.rpy:285
translate german c18s001_Dinner_0b553d63:

    # eva "¿Ya es tu favorita?"
    eva "Ist es schon dein Lieblingsspiel?"

# game/scripts/c18/c18.rpy:286
translate german c18s001_Dinner_b78de7ae:

    # mcp "(¿Estoy detectando una corriente de celos soterrada?)"
    mcp "(Spüre ich da etwa eine unterschwellige Eifersucht?)"

# game/scripts/c18/c18.rpy:287
translate german c18s001_Dinner_d62e71aa:

    # mc "Eva, no hay ninguna duración de los besos, pero ese no es el espíritu. Es un saludo, no una competición."
    mc "Eva, es gibt keine festgelegte Zeitbegrenzung für Küsse, aber darum geht es nicht. Es ist eine Begrüßung, kein Wettbewerb."

# game/scripts/c18/c18.rpy:289
translate german c18s001_Dinner_b8db1b05:

    # eva "Todo en este mundo es una competición, [mc]."
    eva "Alles auf der Welt ist ein Wettbewerb, [mc]."

# game/scripts/c18/c18.rpy:290
translate german c18s001_Dinner_179b2f81:

    # eva "¿Nos vamos? No quiero llegar tarde en mi primera cena."
    eva "Sollen wir gehen? Ich möchte nicht zu spät zu meinem ersten Abendessen kommen."

# game/scripts/c18/c18.rpy:291
translate german c18s001_Dinner_e7f6c90f:

    # mc "Vamos. Llegamos con el tiempo un poco justo."
    mc "Los geht's. Wir sind etwas im Verzug."

# game/scripts/c18/c18.rpy:293
translate german c18s001_Dinner_5680550e:

    # eva "Si me dejas conducir a mí, llegaremos a tiempo. Yo no conduzco como una abuela."
    eva "Wenn du mich fahren lässt, kommen wir pünktlich an. Ich fahre nicht wie eine Oma."

# game/scripts/c18/c18.rpy:294
translate german c18s001_Dinner_c459c8a2:

    # mc "Ni en broma. *Risa*"
    mc "Nicht mal im Scherz. *lacht*"

# game/scripts/c18/c18.rpy:297
translate german c18s001_Dinner_332998d7:

    # "Llegáis justo a tiempo. No conduces tan lento como Eva ha insinuado."
    "Du bist genau pünktlich. Du fährst nicht so langsam, wie Eva angedeutet hat."

# game/scripts/c18/c18.rpy:300
translate german c18s001_Dinner_9758c43c:

    # "Las reacciones al ver entrar a Eva son de sorpresa absoluta."
    "Die Reaktionen beim Erscheinen von Eva sind absolute Überraschung."

# game/scripts/c18/c18.rpy:301
translate german c18s001_Dinner_1d672dcc:

    # "Todas las chicas se han arreglado, pero ninguna ha llegado al nivel de Eva."
    "Alle Mädchen haben sich herausgeputzt, aber keine hat Evas Niveau erreicht."

# game/scripts/c18/c18.rpy:303
translate german c18s001_Dinner_014cb3c8:

    # kat "¡Joder! Ahora sí que parezco una zarrapastrosa. Creo que me voy a ir a llorar a mi habitación. *Risa*"
    kat "Verdammt! Jetzt sehe ich wirklich aus wie ein Lumpenhaufen. Ich glaube, ich gehe jetzt in mein Zimmer und weine. *lacht*"

# game/scripts/c18/c18.rpy:304
translate german c18s001_Dinner_f514d41e:

    # sai "Todas lo parecemos. Eva, estás fantástica."
    sai "Wir sehen alle so aus. Eva, du siehst fantastisch aus."

# game/scripts/c18/c18.rpy:305
translate german c18s001_Dinner_80e195bb:

    # emm "No está fantástica. {b}Es fantástica{/b}."
    emm "Es ist nicht fantastisch. {b}Es ist fantastisch.{/b}"

# game/scripts/c18/c18.rpy:306
translate german c18s001_Dinner_e6fbda22:

    # mcp "(Lo cual te convierte en fantástica a ti, ¿no? *Risa mental*)"
    mcp "(Was dich fantastisch macht, nicht wahr? *Innerliches Lachen*)"

# game/scripts/c18/c18.rpy:308
translate german c18s001_Dinner_6859f5bd:

    # kim "Estás guapísima, Eva."
    kim "Du siehst umwerfend aus, Eva."

# game/scripts/c18/c18.rpy:309
translate german c18s001_Dinner_797fbd0d:

    # ama "Te he dicho un vestido bonito, ¡no ESE vestido! Vamos a ir a bailar, no a una cena en una embajada."
    ama "Ich habe dir gesagt, ein schönes Kleid, nicht DIESES Kleid! Wir gehen tanzen, nicht zu einem Abendessen in einer Botschaft."

# game/scripts/c18/c18.rpy:310
translate german c18s001_Dinner_d92aef96:

    # dap "No hagas caso, Eva. Vas a ser la sensación del... del sitio al que vamos a ir."
    dap "Hör nicht auf sie, Eva. Du wirst in aller Munde sein... in dem Ort, wo wir hinfahren."

# game/scripts/c18/c18.rpy:311
translate german c18s001_Dinner_9eb841d6:

    # kim "Desde luego que sí. Lo serías incluso en la embajada de la que habla Amanda. *Risa*"
    kim "Absolut. Du wärst sogar in der Botschaft, von der Amanda spricht, eine davon. *lacht*"

# game/scripts/c18/c18.rpy:313
translate german c18s001_Dinner_371afd3d:

    # eri "Pues ya estamos casi todas."
    eri "Nun sind fast alle von uns hier."

# game/scripts/c18/c18.rpy:314
translate german c18s001_Dinner_51ac705b:

    # mom "Sí, en cuanto lleguen el resto podemos empezar a cenar."
    mom "Ja, sobald die anderen eintreffen, können wir mit dem Abendessen beginnen."

# game/scripts/c18/c18.rpy:315
translate german c18s001_Dinner_90e3203d:

    # nor "¡Qué envidia me dais las jóvenes!"
    nor "Ich beneide euch, junge Frauen!"

# game/scripts/c18/c18.rpy:316
translate german c18s001_Dinner_9b26eadb:

    # mc "¿Vosotras no os habéis arreglado?"
    mc "Bist du noch nicht fertig?"

# game/scripts/c18/c18.rpy:318
translate german c18s001_Dinner_1b2f3b3c:

    # nor "No, hoy es un día para las chicas y para ti. Nosotras nos quedaremos en casa después de un par de días ajetreados."
    nor "Nein, heute ist ein Tag für die Mädchen und für dich. Wir bleiben nach den letzten anstrengenden Tagen zu Hause."

# game/scripts/c18/c18.rpy:320
translate german c18s001_Dinner_c2bc9d65:

    # mom "Yo aún tengo que acabar algunas cosas que quiero que reposen para la comida de mañana."
    mom "Ich habe noch ein paar Dinge zu erledigen, die ich bis zum morgigen Mittagessen fertig haben möchte."

# game/scripts/c18/c18.rpy:322
translate german c18s001_Dinner_24e9c147:

    # dap "Yo he intentado convencerlas, pero todas han puesto alguna excusa."
    dap "Ich habe versucht, sie zu überzeugen, aber sie haben alle irgendeine Ausrede gefunden."

# game/scripts/c18/c18.rpy:324
translate german c18s001_Dinner_09375bce:

    # emm "Ya sabéis cómo es esto. Llegas a los 25 y ya no quieres salir a bailar."
    emm "Du kennst das ja. Mit 25 hat man keine Lust mehr, tanzen zu gehen."

# game/scripts/c18/c18.rpy:325
translate german c18s001_Dinner_ea0646d3:

    # emm "Aunque quizás la edad no tiene que ver. Ni siquiera Alexia o Simone han querido venir. Mañana tienen que madrugar las dos."
    emm "Vielleicht liegt es aber gar nicht am Alter. Nicht einmal Alexia oder Simone wollten mitkommen. Beide müssen morgen früh aufstehen."

# game/scripts/c18/c18.rpy:327
translate german c18s001_Dinner_b0e5cf42:

    # dap "No es que no hayan querido. Lexi se ha pasado patrullando todo el día."
    dap "Es liegt nicht daran, dass sie nicht wollten. Lexi patrouilliert schon den ganzen Tag."

# game/scripts/c18/c18.rpy:328
translate german c18s001_Dinner_68f8c0d3:

    # mcp "(¿Lexi? Eso es nuevo.)"
    mcp "(Lexi? Das ist neu.)"

# game/scripts/c18/c18.rpy:329
translate german c18s001_Dinner_dbf3a83b:

    # mc "Entonces, ¿quiénes vamos a ir a lo que sea que vayamos a ir?"
    mc "Also, wer wird zu dieser Veranstaltung gehen?"

# game/scripts/c18/c18.rpy:331
translate german c18s001_Dinner_d685d370:

    # kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, yo y... y yo. A mí me cuento doble porque abulto por dos. *Risa*"
    kat "Amanda, Eva, Kim, Debbie, Lisa, Saira, Erika, Daphne, Scarlett, Emma, ich und... und ich. Ich zähle mich doppelt, weil ich doppelt so groß bin. *lacht*"

# game/scripts/c18/c18.rpy:332
translate german c18s001_Dinner_94068f58:

    # kat "Eileen decidirá cuando acabe de trabajar, por si está muy cansada."
    kat "Eileen wird selbst entscheiden, wann sie mit der Arbeit fertig ist, falls sie zu müde sein sollte."

# game/scripts/c18/c18.rpy:333
translate german c18s001_Dinner_cbbde96e:

    # mc "Somos doce o trece entonces. Necesitaremos los tres coches."
    mc "Dann sind wir zwölf oder dreizehn. Wir brauchen alle drei Autos."

# game/scripts/c18/c18.rpy:335
translate german c18s001_Dinner_e276d1ad:

    # ama "Yo puedo conducir uno de los coches, si queréis."
    ama "Ich kann eines der Autos fahren, wenn Sie möchten."

# game/scripts/c18/c18.rpy:337
translate german c18s001_Dinner_de32ddfe:

    # eri "Yo conduciré el otro. Después de la última vez que salimos, hoy no pienso beber. *Risa*"
    eri "Ich fahre den anderen. Nach unserem letzten Ausflug trinke ich heute Abend keinen Alkohol. *lacht*"

# game/scripts/c18/c18.rpy:339
translate german c18s001_Dinner_15310c14:

    # eva "A veces me alegra que viváis en California. En cualquier otro estado solo [mc] y Eileen podrían beber."
    eva "Manchmal bin ich froh, dass ihr in Kalifornien lebt. In jedem anderen Bundesstaat dürften nur C4 und Eileen trinken."

# game/scripts/c18/c18.rpy:340
translate german c18s001_Dinner_5068d387:

    # eva "Suerte que Arnold cambió esa ley absurda. Os podéis alistar en el ejército y matar gente en nombre de vuestro país con 18 pero no beber hasta los 21."
    eva "Gott sei Dank hat Arnold dieses absurde Gesetz geändert. Mit 18 kann man sich zur Armee melden und im Namen seines Landes töten, aber Alkohol darf man erst ab 21 trinken."

# game/scripts/c18/c18.rpy:342
translate german c18s001_Dinner_2c6c3e94:

    # ama "O conducir a los 16..."
    ama "Oder mit 16 Auto fahren..."

# game/scripts/c18/c18.rpy:344
translate german c18s001_Dinner_7e3da0f9:

    # kim "Hay muchas razones para eso, chicas..."
    kim "Dafür gibt es viele Gründe, Mädels..."

# game/scripts/c18/c18.rpy:346
translate german c18s001_Dinner_f93664d8:

    # "Empieza una conversación sobre las implicaciones de beber alcohol a diversas edades que se alarga durante la cena."
    "Es entwickelt sich ein Gespräch über die Folgen des Alkoholkonsums in verschiedenen Altersgruppen, das sich bis zum Ende des Abendessens fortsetzt."

# game/scripts/c18/c18.rpy:347
translate german c18s001_Dinner_34df7fe0:

    # "[emm] ve bien que dejen beber a los 18. Si eres responsable para votar, también lo debes ser para beber. Ella nunca votaría a un gobernador que quisiera quitarle ese derecho."
    "Sie findet es gut, dass 18-Jährige Alkohol trinken dürfen. Wer verantwortungsbewusst genug ist zu wählen, sollte auch verantwortungsbewusst genug sein, Alkohol zu trinken. Sie würde niemals für einen Gouverneur stimmen, der ihr dieses Recht nehmen wollte."

# game/scripts/c18/c18.rpy:348
translate german c18s001_Dinner_6b9a024e:

    # "[eri] es un poco más ambivalente. Su última experiencia con el alcohol le hace ser más prudente."
    "[eri] ist etwas ambivalenter. Seine letzte Erfahrung mit Alkohol macht ihn vorsichtiger."

# game/scripts/c18/c18.rpy:349
translate german c18s001_Dinner_22e59bec:

    # "[mar] y [nor], y más tarde Meemaw y Kiara, creen que devolver la edad para beber a los 21 sería lo correcto."
    "[mar] und [nor], und später Meemaw und Kiara, glauben, dass die Wiedereinführung des Mindestalters für Alkoholkonsum auf 21 Jahre das Richtige wäre."

# game/scripts/c18/c18.rpy:350
translate german c18s001_Dinner_51783b5f:

    # "Ninguna de ellas pudo beber legalmente hasta los 21 y no creen que les haya perjudicado."
    "Keiner von ihnen durfte vor dem 21. Lebensjahr legal Alkohol trinken, und sie glauben nicht, dass es ihnen geschadet hat."

# game/scripts/c18/c18.rpy:351
translate german c18s001_Dinner_1cb834ff:

    # "Eva y Amanda hablan de cuando estuvieron en una misión en Burkina Faso con 14 años y pudieron beber alcohol con normalidad."
    "Eva und Amanda erzählen von ihrer Zeit als Missionarin in Burkina Faso, als sie 14 Jahre alt waren und dort ganz normal Alkohol trinken konnten."

# game/scripts/c18/c18.rpy:352
translate german c18s001_Dinner_19bda271:

    # "Eva se emborrachó."
    "Eva hat sich betrunken."

# game/scripts/c18/c18.rpy:353
translate german c18s001_Dinner_58751903:

    # "Pero lo consideran una buena experiencia que les permitió empezar a conocer sus límites."
    "Sie betrachten es aber als eine gute Erfahrung, die es ihnen ermöglichte, ihre Grenzen kennenzulernen."

# game/scripts/c18/c18.rpy:354
translate german c18s001_Dinner_8ddf32b1:

    # "Betty considera que 16 debería ser suficiente para empezar a beber cerveza y vino, y 18 para licores. Sus experiencias en África han moldeado sus opiniones."
    "Betty ist der Ansicht, dass man mit 16 Jahren Bier und Wein trinken sollte, mit 18 aber erst Spirituosen. Ihre Erfahrungen in Afrika haben ihre Meinung geprägt."

# game/scripts/c18/c18.rpy:355
translate german c18s001_Dinner_117dd69b:

    # "El resto de las chicas no tienen una opinión muy estricta en esto. Ven ventajas y desventajas en las diferentes edades."
    "Die anderen Mädchen haben dazu keine sehr strikte Meinung. Sie sehen Vor- und Nachteile in den verschiedenen Altersgruppen."

# game/scripts/c18/c18.rpy:356
translate german c18s001_Dinner_bd0bd8c0:

    # "Cuando ya no queda comida en los platos, el Under de Megan llega para llevarla al trabajo."
    "Wenn die Teller leer sind, kommt Megans Under, um sie zur Arbeit zu bringen."

# game/scripts/c18/c18.rpy:357
translate german c18s001_Dinner_df7018af:

    # "Las diferentes conversaciones continúan durante poco menos de una hora más, hasta que llega Eileen, que dice estar muy cansada para ir a bailar."
    "Die verschiedenen Gespräche dauern noch knapp eine Stunde an, bis Eileen eintrifft und sagt, sie sei zu müde zum Tanzen."

# game/scripts/c18/c18.rpy:359
translate german c18s001_Dinner_c3fc4b3d:

    # sai "Nos deberíamos ir yendo o se hará muy tarde, ¿no?"
    sai "Wir sollten jetzt losfahren, sonst wird es sehr spät, oder?"

# game/scripts/c18/c18.rpy:360
translate german c18s001_Dinner_d45706dd:

    # mc "Cuando queráis. Pero me tendréis que decir dónde vamos, si tengo que conducir yo."
    mc "Wann immer du willst. Aber du musst mir sagen, wohin wir fahren, wenn ich fahren muss."

# game/scripts/c18/c18.rpy:362
translate german c18s001_Dinner_f2d7f480:

    # lis "Bueno, vamos a ir al Jazz Corner, donde trabaja Megan."
    lis "Okay, lasst uns ins Jazz Corner gehen, wo Megan arbeitet."

# game/scripts/c18/c18.rpy:363
translate german c18s001_Dinner_16829b31:

    # mc "Ah, OK. Sé dónde está. ¿Y ese era todo el secretismo?"
    mc "Ah, okay. Ich weiß, wo es ist. Und das war die ganze Geheimhaltung?"

# game/scripts/c18/c18.rpy:365
translate german c18s001_Dinner_1623422f:

    # dap "No es que fuera secretismo, es que queríamos atar un par de cosas antes de ir."
    dap "Es ging nicht um Geheimhaltung, wir wollten einfach nur noch ein paar Dinge erledigen, bevor wir losfuhren."

# game/scripts/c18/c18.rpy:366
translate german c18s001_Dinner_3824888d:

    # dap "Nadie había reservado la sala anexa hoy, y Megan ha conseguido que nos la dejen para nosotros."
    dap "Niemand hatte heute das angrenzende Zimmer gebucht, und Megan hat es geschafft, es für uns zu bekommen."

# game/scripts/c18/c18.rpy:367
translate german c18s001_Dinner_e0900dec:

    # dap "Si no hubiéramos podido cogerla, una mesa para doce o trece hubiera sido difícil de conseguir y hubiéramos ido al Twins."
    dap "Wenn wir keinen Tisch bekommen hätten, wäre es schwierig gewesen, einen Tisch für zwölf oder dreizehn Personen zu bekommen, und wir wären ins Twins gegangen."

# game/scripts/c18/c18.rpy:368
translate german c18s001_Dinner_aa6fe3a4:

    # mc "Pero una sala para nosotros en un local así tiene que salir carísima, ¿no?"
    mc "Aber ein Zimmer für uns an so einem Ort muss unglaublich teuer sein, oder?"

# game/scripts/c18/c18.rpy:370
translate german c18s001_Dinner_9d8ff7a1:

    # emm "Son las ventajas de conocer a la cantante titular. *Risa* Nos la ha conseguido gratis, pero tendremos que ir a la barra de la sala principal a por las copas."
    emm "Das ist einer der Vorteile, wenn man die Leadsängerin kennt. *lacht* Sie hat sie umsonst bekommen, aber wir müssen wohl in die Bar im Hauptraum gehen, um etwas zu trinken."

# game/scripts/c18/c18.rpy:371
translate german c18s001_Dinner_84323f0a:

    # mc "Traducción: [mc], te va a tocar ir a por las copas."
    mc "Übersetzung: [mc], du musst die Tassen holen gehen."

# game/scripts/c18/c18.rpy:373
translate german c18s001_Dinner_1f921612:

    # sca "¡Como siempre! *Risa* Pero ya te acompañaré yo, como la última vez."
    sca "Wie immer! *lacht* Aber ich werde dich begleiten, wie letztes Mal."

# game/scripts/c18/c18.rpy:374
translate german c18s001_Dinner_fd746a20:

    # mc "Bueno, pues podemos irnos cuando queráis."
    mc "Nun, wir können gehen, wann immer Sie wollen."

# game/scripts/c18/c18.rpy:376
translate german c18s001_Dinner_c131f3f1:

    # "Os despedís de las mujeres que se quedan en casa y unos minutos después estáis en el Jazz Corner. Megan os acompaña a la sala anexa."
    "Du verabschiedest dich von den Frauen, die zu Hause bleiben, und ein paar Minuten später bist du im Jazz Corner. Megan begleitet dich in den Nebenraum."

# game/scripts/c18/c18.rpy:377
translate german c18s001_Dinner_02a98b0b:

    # "La sala es un poco más grande que la mitad de la sala principal y cuenta con su propio escenario y barra, aunque hoy no están en uso."
    "Der Raum ist etwas größer als die Hälfte der Größe des Hauptsaals und verfügt über eine eigene Bühne und Bar, die jedoch heute nicht in Betrieb sind."

# game/scripts/c18/c18.rpy:378
translate german c18s001_Dinner_2e0c3ba5:

    # "En el escenario hay una pantalla dónde proyectarán las actuaciones de Megan en la sala principal."
    "Auf der Bühne befindet sich eine Leinwand, auf die Megans Auftritte im Hauptsaal projiziert werden."

# game/scripts/c18/c18.rpy:385
translate german c18s001_Dinner_63f66d91:

    # "Amanda, con un vestido que le ha prestado [emm]. Ella había venido en shorts a casa."
    "Amanda trug ein Kleid, das ihr [emm] geliehen hatte. Sie war in Shorts nach Hause gekommen."

# game/scripts/c18/c18.rpy:389
translate german c18s001_Dinner_81ea5029:

    # "[dap], otra vez con el pelo suelto, como la noche del Twins."
    "[dap], wieder mit offenem Haar, wie in der Nacht der Zwillinge."

# game/scripts/c18/c18.rpy:393
translate german c18s001_Dinner_c99372e2:

    # "Debbie. Parece que les ha cogido el gusto a los tops."
    "Debbie. Scheinbar hat sie eine Vorliebe für bauchfreie Tops entwickelt."

# game/scripts/c18/c18.rpy:397
translate german c18s001_Dinner_953e654f:

    # "[emm] con un vestido un poco osado que le ha prestado Kim."
    "[emm] Sie trug ein etwas gewagtes Kleid, das Kim ihr geliehen hatte."

# game/scripts/c18/c18.rpy:401
translate german c18s001_Dinner_f204cdfa:

    # "[eri]. fiel a su estilo."
    "[eri]. Formtreu."

# game/scripts/c18/c18.rpy:405
translate german c18s001_Dinner_fe85c8ee:

    # "Eva. Simplemente alucinante."
    "Eva. Einfach unglaublich."

# game/scripts/c18/c18.rpy:409
translate german c18s001_Dinner_6547b59d:

    # "Kate, un vestido cómodo y sencillo, en su línea."
    "Kate, ein bequemes und schlichtes Kleid, ganz in ihrem gewohnten Stil."

# game/scripts/c18/c18.rpy:413
translate german c18s001_Dinner_1df18a38:

    # "Kim. Hablando de vestidos osados."
    "Kim. Apropos gewagte Kleider."

# game/scripts/c18/c18.rpy:417
translate german c18s001_Dinner_e92781d9:

    # "Lisa, también manteniendo su estilo. Si el vestido fuera más largo podría ir a la ópera con él."
    "Lisa behält auch ihren Stil bei. Wäre das Kleid länger, könnte sie damit in die Oper gehen."

# game/scripts/c18/c18.rpy:421
translate german c18s001_Dinner_6283af77:

    # "Megan. El vestuario que le eligen es espectacular."
    "Megan. Die Garderobe, die sie für sie aussuchen, ist spektakulär."

# game/scripts/c18/c18.rpy:425
translate german c18s001_Dinner_ddaefe9e:

    # "Saira, extrañamente vestida de rojo."
    "Saira, seltsamerweise in Rot gekleidet."

# game/scripts/c18/c18.rpy:429
translate german c18s001_Dinner_b83f2f01:

    # "Scarlett, con otro vestido prestado por Kim."
    "Scarlett trug ein weiteres Kleid, das sie sich von Kim geliehen hatte."

# game/scripts/c18/c18.rpy:434
translate german c18s001_Dinner_073ecb12:

    # meg "Y esta es la sala. Por aquella puerta podéis pasar a la sala principal a pedir las bebidas. Acordaos del código para poder volver a entrar."
    meg "Und das ist der Raum. Durch diese Tür gelangen Sie in den Hauptraum, um Getränke zu bestellen. Merken Sie sich den Code, damit Sie wieder hineinkommen."

# game/scripts/c18/c18.rpy:435
translate german c18s001_Dinner_47959051:

    # meg "Por aquella otra puerta tenéis los lavabos privados de esta sala."
    meg "Durch die andere Tür gelangt man zu den privaten Toiletten dieses Zimmers."

# game/scripts/c18/c18.rpy:436
translate german c18s001_Dinner_4463222f:

    # meg "En esa pantalla veréis una versión gigante de mí. Por suerte sólo me cogen de cintura para arriba, con lo que los michelines no se ven mucho. *Risa*"
    meg "Auf dem Bildschirm seht ihr mich in Riesengröße. Zum Glück sieht man mich nur von der Hüfte aufwärts, meine kleinen Pölsterchen sind also nicht so auffällig. *lacht*"

# game/scripts/c18/c18.rpy:438
translate german c18s001_Dinner_9370238d:

    # kat "¡Eres muy exagerada! Tú apenas tienes. *Risa* Yo necesitaría la pantalla gigante del Heins Stadium."
    kat "Du übertreibst! Du hast ja kaum welche. *lacht* Ich bräuchte die riesige Leinwand im Heins Stadium."

# game/scripts/c18/c18.rpy:439
translate german c18s001_Dinner_4000027e:

    # mc "Nunca he conocido una mujer que no se queje de que le sobran un par de kilos. *Risa* O de que le falten."
    mc "Ich kenne keine Frau, die sich nicht darüber beklagt, ein paar Kilo zu viel zu haben. *Lacht* Oder über Untergewicht."

# game/scripts/c18/c18.rpy:441
translate german c18s001_Dinner_be5770f7:

    # meg "Yo os tengo que dejar, tengo que acabar de aclarar unas cosas con el jefe antes de la actuación."
    meg "Ich muss Sie verlassen, ich muss vor der Vorstellung noch ein paar Dinge mit dem Chef klären."

# game/scripts/c18/c18.rpy:442
translate german c18s001_Dinner_8b0d388f:

    # meg "Volveré entre actuaciones. Os veo luego."
    meg "Ich bin zwischen den Vorstellungen wieder da. Bis später."

# game/scripts/c18/c18.rpy:443
translate german c18s001_Dinner_da73a3e0:

    # todas "Hasta luego, Megan."
    todas "Auf Wiedersehen, Megan."

# game/scripts/c18/c18.rpy:445
translate german c18s001_Dinner_82928684:

    # sca "Id pensando que queréis beber, ya me ocupo yo de tomar nota."
    sca "Überlegt euch schon mal, was ihr trinken wollt, ich kümmere mich ums Notieren."

# game/scripts/c18/c18.rpy:446
translate german c18s001_Dinner_05f3dd36:

    # "Scarlett toma nota en su móvil de las bebidas que quiere cada una y te da el móvil."
    "Scarlett notiert auf ihrem Handy, welche Getränke jeder von euch möchte, und gibt euch das Handy."

# game/scripts/c18/c18.rpy:448
translate german c18s001_Dinner_155a3fa5:

    # sca "Lisa y yo vamos al lavabo y te vemos en la barra. ¿Puedes ir pidiendo?"
    sca "Lisa und ich gehen kurz auf die Toilette und sehen dich an der Bar. Kannst du schon mal bestellen?"

# game/scripts/c18/c18.rpy:449
translate german c18s001_Dinner_8e72b860:

    # lis "Viendo lo bonito que es el local tengo ganas de ver el lavabo. Este sitio tiene una imagen años 30 muy cuidada."
    lis "Da es hier so schön ist, bin ich gespannt auf die Toilette. Der Ort hat einen sehr liebevoll gestalteten Look im Stil der 1930er Jahre."

# game/scripts/c18/c18.rpy:450
translate german c18s001_Dinner_47891da4:

    # mc "¿Vas a hacer turismo en el lavabo? *Risa*"
    mc "Gehst du etwa auf Sightseeing-Tour im Badezimmer? *lacht*"

# game/scripts/c18/c18.rpy:452
translate german c18s001_Dinner_f88b4eec:

    # lis "No solo turismo..."
    lis "Nicht nur Tourismus..."

# game/scripts/c18/c18.rpy:453
translate german c18s001_Dinner_ad7f4de5:

    # sca "*Risa* Esas cosas no se le preguntan a una dama, [mc]. *Risa*"
    sca "*Lacht* Solche Fragen stellt man einer Dame nicht, [mc]. *Lacht*"

# game/scripts/c18/c18.rpy:454
translate german c18s001_Dinner_e639c88f:

    # mc "*Risa* No tardéis o empezará a fundirse el hielo."
    mc "*Gelächter* Beeil dich, sonst fängt das Eis an zu schmelzen."

# game/scripts/c18/c18.rpy:456
translate german c18s001_Dinner_41d2ad96:

    # sca "No tardamos nada. No es que Lisa les vaya a dejar un regalito apestoso. *Risa*"
    sca "Wir sind gleich wieder da. Lisa wird dir bestimmt kein stinkendes Geschenk hinterlassen. *lacht*"

# game/scripts/c18/c18.rpy:457
translate german c18s001_Dinner_ae703262:

    # lis "¡Scarlett! *Risa* Las señoritas no hacemos eso. Dejamos rosas y arcoíris. *Risa*"
    lis "Scarlett! *lacht* Damen tun so etwas nicht. Wir hinterlassen Rosen und Regenbögen. *lacht*"

# game/scripts/c18/c18.rpy:458
translate german c18s001_Dinner_fc7f2961:

    # mc "Bueno, os espero en la barra. No voy a poder traer doce bebidas yo solo."
    mc "Okay, ich warte an der Bar auf dich. Ich kann leider keine zwölf Getränke selbst mitbringen."

# game/scripts/c18/c18.rpy:461
translate german c18s001_Dinner_2cd1b34c:

    # "En cuanto entras en la sala principal, te encuentras con una cara conocida."
    "Sobald Sie den Hauptraum betreten, werden Sie ein bekanntes Gesicht sehen."

# game/scripts/c18/c18.rpy:463
translate german c18s001_Dinner_5c865492:

    # mc "¿Dra. Milk?"
    mc "Dr. Milk?"

# game/scripts/c18/c18.rpy:465
translate german c18s001_Dinner_7c596da7:

    # hm "¡Oh, Sr. Marks! Puede llamarme Harley cuando no estoy en el hospital."
    hm "Oh, Herr Marks! Sie können mich Harley nennen, wenn ich nicht im Krankenhaus bin."

# game/scripts/c18/c18.rpy:466
translate german c18s001_Dinner_20e77c57:

    # mc "Sólo si usted me llama [mc]."
    mc "Nur wenn du mich [mc] nennst."

# game/scripts/c18/c18.rpy:471
translate german c18s001_Dinner_382909a1:

    # har "De acuerdo, [mc]. ¿Qué tal los masajes con la Sra. Pitt?"
    har "Okay, [mc]. Wie sind die Massagen bei Mrs. Pitt?"

# game/scripts/c18/c18.rpy:472
translate german c18s001_Dinner_66f69349:

    # mc "Bien, gracias. Hoy le he explicado a mi tía cómo hacerlos. Parece que han ido bien."
    mc "Okay, danke. Ich habe meiner Tante heute erklärt, wie man sie macht. Sie scheinen gut geklappt zu haben."

# game/scripts/c18/c18.rpy:473
translate german c18s001_Dinner_914e290b:

    # mc "Un segundo, por favor."
    mc "Einen Moment bitte."

# game/scripts/c18/c18.rpy:475
translate german c18s001_Dinner_acf64506:

    # "Le entregas el móvil de Scarlett al camarero con la lista de las bebidas."
    "Du gibst Scarletts Handy dem Kellner mit der Getränkekarte."

# game/scripts/c18/c18.rpy:476
translate german c18s001_Dinner_d5840e9d:

    # mc "¿Puede prepararme esto, por favor?"
    mc "Könnten Sie das bitte für mich vorbereiten?"

# game/scripts/c18/c18.rpy:480
translate german c18s001_Dinner_c3fc428a:

    # bam "Sí, ahora mismo."
    bam "Ja, genau jetzt."

# game/scripts/c18/c18.rpy:482
translate german c18s001_Dinner_bc3f3dfe:

    # har "¿Ha venido solo?"
    har "Kam er allein?"

# game/scripts/c18/c18.rpy:483
translate german c18s001_Dinner_2d8ebafa:

    # mc "No, con parte de la familia. ¿Y usted?"
    mc "Nein, mit einigen meiner Familienmitglieder. Und du?"

# game/scripts/c18/c18.rpy:485
translate german c18s001_Dinner_2c50782e:

    # har "Tampoco. He venido con mi marido, Jeff, y mi herm... ano."
    har "Nein, ich bin nicht mit meinem Mann Jeff und meinem Bruder gekommen."

# game/scripts/c18/c18.rpy:486
translate german c18s001_Dinner_a2a3934b:

    # mc "Ahora veo las tres bebidas. ¿Quiere que le ayude a llevárselas a la mesa mientras preparan mi pedido?"
    mc "Ich sehe jetzt die drei Getränke. Soll ich Ihnen helfen, sie zum Tisch zu bringen, während meine Bestellung zubereitet wird?"

# game/scripts/c18/c18.rpy:488
translate german c18s001_Dinner_8ee079a8:

    # har "No hace falta. Mi hermano ha ido al lavabo un momento y tiene que estar a punto de volver."
    har "Das ist nicht nötig. Mein Bruder ist kurz auf der Toilette und müsste jeden Moment zurück sein."

# game/scripts/c18/c18.rpy:489
translate german c18s001_Dinner_d7c52f77:

    # har "Oh, hablando del Rey de Roma, por ahí viene."
    har "Oh, wenn man vom Teufel spricht, da kommt er ja schon."

# game/scripts/c18/c18.rpy:494
translate german c18s001_Dinner_979ef219:

    # har "[mc], te presento a mi hermano Anthony."
    har "[mc], ich möchte Ihnen meinen Bruder Anthony vorstellen."

# game/scripts/c18/c18.rpy:495
translate german c18s001_Dinner_ae996fcb:

    # ant "Ya nos conocemos, Harley. Es el casero de Lisa, del que te hablé."
    ant "Wir kennen uns schon, Harley. Er ist Lisas Vermieter, der, von dem ich dir erzählt habe."

# game/scripts/c18/c18.rpy:496
translate german c18s001_Dinner_6cdb73dc:

    # mc "Hola Anthony, ¿qué tal?"
    mc "Hallo Anthony, wie geht es dir?"

# game/scripts/c18/c18.rpy:498
translate german c18s001_Dinner_c35965dd:

    # ant "Hola, [mc], ¿Ha venido Lisa contigo?"
    ant "Hallo [mc], ist Lisa mitgekommen?"

# game/scripts/c18/c18.rpy:499
translate german c18s001_Dinner_b90af8a9:

    # mc "Sí, ahora vendrá a ayudarme a llevar las copas."
    mc "Ja, jetzt kommt sie und hilft mir, die Brille zu tragen."

# game/scripts/c18/c18.rpy:500
translate german c18s001_Dinner_fb962fee:

    # ant "Cuídala. Es una chica fantástica."
    ant "Kümmert euch gut um sie. Sie ist ein fantastisches Mädchen."

# game/scripts/c18/c18.rpy:501
translate german c18s001_Dinner_5eb610ee:

    # mc "Sí que lo es."
    mc "Ja, das ist es."

# game/scripts/c18/c18.rpy:503
translate german c18s001_Dinner_fabd217c:

    # lis "Hola, Anthony."
    lis "Hallo Anthony."

# game/scripts/c18/c18.rpy:504
translate german c18s001_Dinner_a5356373:

    # "Se suceden las presentaciones al llegar las chicas."
    "Die Vorstellungsrunden folgen einander, als die Mädchen eintreffen."

# game/scripts/c18/c18.rpy:505
translate german c18s001_Dinner_2556ab00:

    # "La interacción entre Lisa y Anthony se ve más amistosa de lo que podrías haber esperado tras lo que te explicó Lisa ayer."
    "Die Interaktion zwischen Lisa und Anthony wirkt freundlicher, als Sie vielleicht nach Lisas gestriger Erklärung erwartet hätten."

# game/scripts/c18/c18.rpy:507
translate german c18s001_Dinner_7a11e38a:

    # har "Yo voy a llevar las bebidas a la mesa. Jeff debe estar preguntándose por qué tardamos tanto."
    har "Ich bringe die Getränke an den Tisch. Jeff fragt sich bestimmt schon, warum wir so lange brauchen."

# game/scripts/c18/c18.rpy:508
translate german c18s001_Dinner_3452f087:

    # har "Anthony, si te quieres quedar con tus amigos, por nosotros no hay problema."
    har "Anthony, wenn du bei deinen Freunden bleiben möchtest, ist das für uns in Ordnung."

# game/scripts/c18/c18.rpy:509
translate german c18s001_Dinner_b5b30d3f:

    # ant "Bueno... creo que será lo mejor si me voy contigo. He venido con vosotros al fin y al cabo."
    ant "Nun ja … ich denke, es ist am besten, wenn ich mitkomme. Schließlich bin ich ja mit euch hierhergekommen."

# game/scripts/c18/c18.rpy:510
translate german c18s001_Dinner_af68f0d2:

    # mc "Si cambias de opinión, avisa a Lisa. Estamos en la sala privada y tendríamos que venir a buscarte."
    mc "Falls du es dir anders überlegst, sag Lisa Bescheid. Wir sind im Privatraum und müssten dich dann abholen."

# game/scripts/c18/c18.rpy:512
translate german c18s001_Dinner_158ff277:

    # lis "Sí, hazlo. Vamos cortas de chicos con los que bailar y las chicas van a querer conocerte."
    lis "Ja, mach es. Uns fehlen Tanzpartner, und die Mädchen werden dich gerne kennenlernen."

# game/scripts/c18/c18.rpy:513
translate german c18s001_Dinner_2abefeef:

    # lis "Les he hablado mucho de ti."
    lis "Ich habe ihnen viel über dich erzählt."

# game/scripts/c18/c18.rpy:514
translate german c18s001_Dinner_28083649:

    # sca "Y, antes de que preguntes, todo lo que ha dicho ha sido bueno."
    sca "Und bevor Sie fragen: Alles, was er gesagt hat, war gut."

# game/scripts/c18/c18.rpy:516
translate german c18s001_Dinner_09c04153:

    # ant "Bueno, hoy quería pasar un rato con mi hermana y mi cuñado. Hacía mucho que no salíamos."
    ant "Heute wollte ich etwas Zeit mit meiner Schwester und meinem Schwager verbringen. Es war schon lange her, dass wir zusammen ausgegangen waren."

# game/scripts/c18/c18.rpy:517
translate german c18s001_Dinner_e954b2bc:

    # har "Pero nosotros no estaremos mucho rato. Seguramente después de la primera actuación de Megan, la chica que canta, nos vayamos. Tiene una voz increíble."
    har "Aber wir werden nicht lange hier sein. Wir werden wahrscheinlich nach Megans erstem Auftritt, dem singenden Mädchen, abreisen. Sie hat eine unglaubliche Stimme."

# game/scripts/c18/c18.rpy:518
translate german c18s001_Dinner_3fe983af:

    # har "Con lo que os podemos prestar a Anthony después. *Risa* Así no se siente mal por habernos abandonado y pasa un rato con esas chicas que parecen tan ansiosas por conocerlo."
    har "Mit dem, was wir dir später leihen können, Anthony. *Lacht* So hat er kein schlechtes Gewissen, uns im Stich zu lassen, und er kann etwas Zeit mit den Mädchen verbringen, die ihn so gern kennenlernen möchten."

# game/scripts/c18/c18.rpy:519
translate german c18s001_Dinner_4c8c0375:

    # ant "Bueno, ya veremos..."
    ant "Nun, wir werden sehen..."

# game/scripts/c18/c18.rpy:521
translate german c18s001_Dinner_1ade258c:

    # sca "No vas a dejar a once damiselas en apuros con sólo un caballero con el que bailar, ¿no?"
    sca "Du wirst doch nicht elf hilflose Jungfrauen mit nur einem einzigen Gentleman zum Tanzen zurücklassen, oder?"

# game/scripts/c18/c18.rpy:522
translate german c18s001_Dinner_96949d21:

    # lis "No te presionamos más. Tienes mi número. Mándame un mensaje o llámame si quieres venir. Me gustaría que lo hicieras."
    lis "Wir werden dich nicht mehr unter Druck setzen. Du hast meine Nummer. Schreib mir oder ruf mich an, wenn du kommen willst. Ich würde mich freuen."

# game/scripts/c18/c18.rpy:523
translate german c18s001_Dinner_e46e5975:

    # mc "Anthony, no estás obligado. Ven sólo si quieres. Pero espero verte luego."
    mc "Anthony, du bist nicht verpflichtet. Komm nur, wenn du möchtest. Aber ich hoffe, dich später zu sehen."

# game/scripts/c18/c18.rpy:525
translate german c18s001_Dinner_206dfa64:

    # ant "Bueno, si Harley y Jeff deciden irse pronto, te aviso."
    ant "Nun, falls Harley und Jeff sich bald zum Weggang entschließen, werde ich euch Bescheid geben."

# game/scripts/c18/c18.rpy:526
translate german c18s001_Dinner_d42cd077:

    # lis "Espero tu mensaje."
    lis "Ich warte auf Ihre Nachricht."

# game/scripts/c18/c18.rpy:527
translate german c18s001_Dinner_3ab75698:

    # mcp "(Este abrazo es mucho más cálido que el que se dieron cuando aún estaban descubriendo si querían salir juntos o no.)"
    mcp "(Diese Umarmung ist viel herzlicher als die, die sie austauschten, als sie noch überlegten, ob sie ein Paar werden wollten oder nicht.)"

# game/scripts/c18/c18.rpy:529
translate german c18s001_Dinner_91156551:

    # har "Encantada de conoceros, chicas. Y de verte a ti otra vez, [mc]. Ahora nos tenemos que ir antes de que mi marido se preocupe."
    har "Schön, euch alle kennenzulernen, Mädels. Und schön, euch wiederzusehen, [mc]. Jetzt müssen wir los, bevor mein Mann sich Sorgen macht."

# game/scripts/c18/c18.rpy:530
translate german c18s001_Dinner_a98d298e:

    # mc "Igualmente, Harley."
    mc "Ebenso Harley."

# game/scripts/c18/c18.rpy:532
translate german c18s001_Dinner_7a374f64:

    # lis "¡Qué casualidad que la hermana de Anthony sea la médico de Olivia! Sabía que su hermana mayor era médico, pero esto es mucha casualidad."
    lis "Was für ein Zufall, dass Anthonys Schwester Olivias Ärztin ist! Ich wusste zwar, dass ihre ältere Schwester Ärztin ist, aber das ist schon ein ziemlicher Zufall."

# game/scripts/c18/c18.rpy:534
translate german c18s001_Dinner_d0194107:

    # mc "Y por curiosidad, tiene otra hermana, ¿verdad?"
    mc "Und aus Neugier: Sie hat noch eine Schwester, richtig?"

# game/scripts/c18/c18.rpy:535
translate german c18s001_Dinner_59840597:

    # lis "¿Cómo lo sabes? Olga es un par de años más joven que Harley y un año mayor que Anthony. Es con quién más unido está."
    lis "Woher weißt du das? Olga ist ein paar Jahre jünger als Harley und ein Jahr älter als Anthony. Sie ist diejenige, zu der er das engste Verhältnis hat."

# game/scripts/c18/c18.rpy:536
translate german c18s001_Dinner_892335e9:

    # mc "Has dicho su hermana mayor. He intuido que debía haber una intermedia."
    mc "Du sagtest, es sei ihre ältere Schwester. Ich hatte das Gefühl, es müsse noch eine mittlere Schwester geben."

# game/scripts/c18/c18.rpy:537
translate german c18s001_Dinner_f6e26917:

    # lis "Se mudó a San Francisco hace un par de semanas, el mismo día que llegamos nosotras aquí. Antes vivía en Seattle."
    lis "Sie ist vor ein paar Wochen nach San Francisco gezogen, am selben Tag, an dem wir hier angekommen sind. Zuvor hat sie in Seattle gewohnt."

# game/scripts/c18/c18.rpy:538
translate german c18s001_Dinner_c8c9ae20:

    # mc "El mundo es un pañuelo..."
    mc "Die Welt ist klein..."

# game/scripts/c18/c18.rpy:540
translate german c18s001_Dinner_33310525:

    # "Volvéis con las bebidas a la sala privada. La seguridad con que Scarlett lleva la bandeja contrasta con lo torpes que os sentís Lisa y tú."
    "Du kehrst mit den Getränken in den privaten Raum zurück. Scarletts selbstsicherer Umgang mit dem Tablett steht in starkem Kontrast zu der unbehaglichen Stimmung, die du und Lisa empfinden."

# game/scripts/c18/c18.rpy:541
translate german c18s001_Dinner_14b65676:

    # "Suena música suave para entrar en ambiente antes de que la actuación de Megan comience."
    "Sanfte Musik sorgt für die richtige Stimmung, bevor Megans Auftritt beginnt."

# game/scripts/c18/c18.rpy:543
translate german c18s001_Dinner_6c5051cc:

    # sai "Un brindis por las chicas del cumpleaños."
    sai "Ein Hoch auf die Geburtstagskinder!"

# game/scripts/c18/c18.rpy:544
translate german c18s001_Dinner_fe38e22c:

    # todas "¡Sí!"
    todas "Ja!"

# game/scripts/c18/c18.rpy:545
translate german c18s001_Dinner_8a435623:

    # sai "¡Brindo porque este año os traiga mucha felicidad!"
    sai "Auf ein Jahr voller Glück!"

# game/scripts/c18/c18.rpy:546
translate german c18s001_Dinner_f9d3ccfd:

    # todas "¡Salud!"
    todas "Gesundheit!"

# game/scripts/c18/c18.rpy:548
translate german c18s001_Dinner_cb123a3b:

    # "Después de los brindis, todas empiezan a hablar con todas sobre los planes del próximo año."
    "Nach den Trinksprüchen kommen alle miteinander ins Gespräch über ihre Pläne für das kommende Jahr."

# game/scripts/c18/c18.rpy:550
translate german c18s001_Dinner_2ccdce99:

    # "Casi parece que sea el cumpleaños de todas."
    "Es fühlt sich fast so an, als ob jeder Geburtstag hätte."

# game/scripts/c18/c18.rpy:562
translate german c18s001_Scarlett_35d28430:

    # sca "¿Bailas? La última vez no pude bailar contigo por culpa de aquellos dos chicos."
    sca "Möchtest du tanzen? Letztes Mal konnte ich wegen der beiden Jungen nicht mit dir tanzen."

# game/scripts/c18/c18.rpy:563
translate german c18s001_Scarlett_f7744f06:

    # mc "¡Por supuesto!"
    mc "Natürlich!"

# game/scripts/c18/c18.rpy:565
translate german c18s001_Scarlett_b6ef6e84:

    # "Os separáis un poco del grupo de chicas, para poder hablar en privado mientras bailáis."
    "Ihr entfernt euch ein wenig von der Mädchengruppe, um euch beim Tanzen ungestört unterhalten zu können."

# game/scripts/c18/c18.rpy:566
translate german c18s001_Scarlett_0d480b65:

    # sca "Están super emocionadas con lo de mañana."
    sca "Sie freuen sich riesig auf morgen."

# game/scripts/c18/c18.rpy:567
translate german c18s001_Scarlett_3a78b0cc:

    # mc "Es normal. Siempre se han puesto así en sus cumpleaños. Me fastidia no haber podido estar en los tres últimos."
    mc "Das ist normal. Sie haben sich an ihren Geburtstagen immer so verhalten. Ich ärgere mich, dass ich die letzten drei Male nicht dabei sein konnte."

# game/scripts/c18/c18.rpy:569
translate german c18s001_Scarlett_36b988ac:

    # sca "No es eso. Desde lo que dijiste en la cena de ayer sobre Amanda formando parte de la familia, no hacen más que hablar de ello."
    sca "Das ist es nicht. Seitdem du gestern beim Abendessen gesagt hast, dass Amanda zur Familie gehört, reden sie ununterbrochen darüber."

# game/scripts/c18/c18.rpy:570
translate german c18s001_Scarlett_4a09d2b2:

    # mc "No creo que dijera nada que no pensáramos todos. Y vuestras respuestas lo confirmaron."
    mc "Ich glaube nicht, dass ich etwas gesagt habe, was wir nicht alle gedacht haben. Und eure Reaktionen haben es bestätigt."

# game/scripts/c18/c18.rpy:572
translate german c18s001_Scarlett_7cdab485:

    # sca "Sí, tienes razón. Pero ninguna de nosotras lo había verbalizado previamente."
    sca "Ja, da hast du recht. Aber keiner von uns hatte es vorher ausgesprochen."

# game/scripts/c18/c18.rpy:573
translate german c18s001_Scarlett_5830ba57:

    # sca "Todas nos sentíamos parte de la familia, pero decirlo en alto y saber lo que pensaban las demás... ¡Phew!"
    sca "Wir fühlten uns alle wie ein Teil der Familie, aber es laut auszusprechen und zu wissen, was die anderen dachten... Puh!"

# game/scripts/c18/c18.rpy:575
translate german c18s001_Scarlett_4db29d44:

    # sca "Mientras hablabas con Amanda fuera, nosotras nos quedamos mirándonos las unas a las otras."
    sca "Während du draußen mit Amanda gesprochen hast, standen wir einfach nur da und sahen uns an."

# game/scripts/c18/c18.rpy:576
translate german c18s001_Scarlett_47d41948:

    # sca "Después vinieron un montón de abrazos. No era necesario decir nada. Lo habíamos dicho todas sobre Amanda."
    sca "Dann folgten viele Umarmungen. Es gab keinen Grund, etwas zu sagen. Wir hatten es ja alle schon über Amanda gesagt."

# game/scripts/c18/c18.rpy:578
translate german c18s001_Scarlett_cb1ac273:

    # sca "Y en ese momento todas fuimos Amanda."
    sca "Und in diesem Moment waren wir alle Amanda."

# game/scripts/c18/c18.rpy:579
translate german c18s001_Scarlett_b983afd4:

    # sca "A algunas de nosotras se nos escaparon algunas lágrimas."
    sca "Manche von uns vergossen ein paar Tränen."

# game/scripts/c18/c18.rpy:580
translate german c18s001_Scarlett_19b12ff6:

    # mc "Les tengo que pedir ese video a Amanda y a Eva. *Risa*"
    mc "Ich muss Amanda und Eva nach dem Video fragen. *lacht*"

# game/scripts/c18/c18.rpy:582
translate german c18s001_Scarlett_2cdb75c3:

    # sca "Puedes reírte si quieres, pero fue muy emocionante. Y después Olivia dijo que sólo a ti se te podría ocurrir ponernos en esa situación."
    sca "Ihr könnt lachen, wenn ihr wollt, aber es war sehr aufregend. Und dann sagte Olivia, dass nur du auf die Idee kommen könntest, uns in diese Situation zu bringen."

# game/scripts/c18/c18.rpy:583
translate german c18s001_Scarlett_b1d47099:

    # sca "Y las caras de todas decían que pensaban que tenía razón."
    sca "Und ihre Gesichtsausdrücke verrieten, dass sie ihm zustimmten."

# game/scripts/c18/c18.rpy:584
translate german c18s001_Scarlett_61af3e7e:

    # mc "*Risa* ¡La culpa es de [mc]!"
    mc "*Gelächter* Es ist <c4s Schuld!"

# game/scripts/c18/c18.rpy:586
translate german c18s001_Scarlett_cdf76c28:

    # sca "*Risa* No estaban buscando culpables. Cada una de nosotras estaba contenta sintiéndose parte de algo sin hablarlo con el resto."
    sca "*Gelächter* Sie suchten keinen Schuldigen. Jeder von uns war glücklich, sich als Teil von etwas zu fühlen, ohne mit den anderen darüber reden zu müssen."

# game/scripts/c18/c18.rpy:587
translate german c18s001_Scarlett_2edcdcf6:

    # sca "Gracias a ti, nos hemos dado cuenta de que el resto sienten lo mismo. Nadie te culpa. Todo el mundo te lo agradece."
    sca "Dank Ihnen haben wir erkannt, dass alle anderen genauso empfinden. Niemand macht Ihnen Vorwürfe. Alle sind Ihnen dankbar."

# game/scripts/c18/c18.rpy:588
translate german c18s001_Scarlett_8c4a4cd4:

    # mc "Creo que te lo deberían agradecer a ti."
    mc "Ich finde, sie sollten Ihnen danken."

# game/scripts/c18/c18.rpy:590
translate german c18s001_Scarlett_8135b027:

    # sca "¿A mí? ¿Qué he hecho yo ahora?"
    sca "Ich? Was habe ich denn jetzt schon wieder getan?"

# game/scripts/c18/c18.rpy:591
translate german c18s001_Scarlett_433961ca:

    # mc "Proponer la Navidad en la playa. Este sentimiento empezó allí."
    mc "Ich schlage Weihnachten am Strand vor. Dieses Gefühl hat dort seinen Ursprung."

# game/scripts/c18/c18.rpy:593
translate german c18s001_Scarlett_90218ce0:

    # sca "Pero yo solo quise proponer algo divertido..."
    sca "Ich wollte nur etwas Lustiges vorschlagen..."

# game/scripts/c18/c18.rpy:594
translate german c18s001_Scarlett_1ad2f5ca:

    # mc "Y fue divertido. Pero estar todos juntos también creó este sentimiento. Es tan culpa tuya como mía."
    mc "Es hat Spaß gemacht. Aber das Zusammensein hat auch dieses Gefühl ausgelöst. Es ist genauso deine Schuld wie meine."

# game/scripts/c18/c18.rpy:595
translate german c18s001_Scarlett_599c1cf9:

    # sca "No lo había visto así..."
    sca "So hatte ich das noch nicht betrachtet..."

# game/scripts/c18/c18.rpy:597
translate german c18s001_Scarlett_ce9dbd34:

    # sca "Pero cambiando de tema antes de que me ruborice... ¿Sabes que Eva y Amanda también usan lengua de signos?"
    sca "Aber bevor ich rot werde, möchte ich das Thema wechseln... Wusstest du, dass Eva und Amanda auch Gebärdensprache verwenden?"

# game/scripts/c18/c18.rpy:598
translate german c18s001_Scarlett_a4c50100:

    # mc "No, no lo sabía. Supongo que tiene que ser útil para ellas poderse comunicar en silencio."
    mc "Nein, das wusste ich nicht. Ich nehme an, es muss für sie nützlich sein, sich lautlos verständigen zu können."

# game/scripts/c18/c18.rpy:600
translate german c18s001_Scarlett_48a06b30:

    # sca "Supongo... no les entiendo la mayoría de lo que señalan, pero está claro que son gestos rápidos y deliberados."
    sca "Ich nehme an... ich verstehe das meiste von dem, worauf sie hinweisen, nicht, aber es ist klar, dass es sich um schnelle und bewusste Gesten handelt."

# game/scripts/c18/c18.rpy:601
translate german c18s001_Scarlett_2d3d95bb:

    # sca "No mires, pero están discutiendo por algo."
    sca "Schau nicht hin, aber sie streiten sich über etwas."

# game/scripts/c18/c18.rpy:603
translate german c18s001_Scarlett_d9234634:

    # sca "Son gestos enfadados, y ni siquiera se están mirando directamente."
    sca "Es sind wütende Gesten, und sie schauen sich nicht einmal direkt an."

# game/scripts/c18/c18.rpy:605
translate german c18s001_Scarlett_5050edf6:

    # sca "Deben usar un lenguaje diferente del ASL."
    sca "Sie müssen eine andere Sprache als ASL verwenden."

# game/scripts/c18/c18.rpy:606
translate german c18s001_Scarlett_f2821762:

    # mc "Bueno, se criaron en Aruba, no sé qué hablarán allí."
    mc "Nun ja, sie sind in Aruba aufgewachsen, ich weiß nicht, welche Sprache man dort spricht."

# game/scripts/c18/c18.rpy:608
translate german c18s001_Scarlett_b40818c2:

    # "Suena un móvil en algún sitio."
    "Irgendwo klingelt ein Handy."

# game/scripts/c18/c18.rpy:610
translate german c18s001_Scarlett_f71d8e27:

    # sca "Se lo puedes preguntar a Eva. Viene hacia aquí, creo que se ha acabado nuestro baile."
    sca "Du kannst Eva fragen. Sie kommt gleich her; ich glaube, unser Tanz ist vorbei."

# game/scripts/c18/c18.rpy:611
translate german c18s001_Scarlett_d0b7ddd8:

    # sca "Todas van a querer bailar contigo. Eres el único chico."
    sca "Alle Mädchen werden mit dir tanzen wollen. Du bist der einzige Junge."

# game/scripts/c18/c18.rpy:612
translate german c18s001_Scarlett_37c7001e:

    # mc "Bailamos luego otra vez. La noche es larga."
    mc "Wir tanzten später noch einmal. Die Nacht ist lang."

# game/scripts/c18/c18.rpy:615
translate german c18s001_Scarlett_99def1ae:

    # "Scarlett te hace los gestos de \"Te Quiero\", pero lo hace diferente."
    "Scarlett macht „Ich liebe dich“-Gesten, aber sie tut es auf eine andere Art und Weise."

# game/scripts/c18/c18.rpy:616
translate german c18s001_Scarlett_2b5a9c81:

    # mc "Eso se ha visto diferente de como lo hice yo."
    mc "Das sah anders aus als meine Vorgehensweise."

# game/scripts/c18/c18.rpy:618
translate german c18s001_Scarlett_1cdb8ec2:

    # sca "*Risita* Es que no lo hiciste bien del todo. Mira, el \"Yo\" se hace así."
    sca "*Kichert* Das hast du nicht ganz richtig gemacht. Schau, das „I“ wird so geschrieben."

# game/scripts/c18/c18.rpy:622
translate german c18s001_Scarlett_2669ca66:

    # sca "Lo que tú hiciste se parece más a \"A mí\". Dijiste algo como \"A mí te quiero\"."
    sca "Was du getan hast, war eher so etwas wie „Zu mir“. Du hast so etwas gesagt wie: „Ich liebe dich.“"

# game/scripts/c18/c18.rpy:623
translate german c18s001_Scarlett_559d3b13:

    # mc "¿Por qué no me lo dijiste?"
    mc "Warum hast du es mir nicht gesagt?"

# game/scripts/c18/c18.rpy:625
translate german c18s001_Scarlett_bdd695b0:

    # sca "¿Y fastidiar el momento? ¡No!"
    sca "Und den Moment verderben? Nein!"

# game/scripts/c18/c18.rpy:626
translate german c18s001_Scarlett_5f29e1e4:

    # sca "Te tomaste el esfuerzo y entendí lo que querías decir. Era suficiente para mí. Era el gesto más bonito que habían hecho nunca por mí."
    sca "Du hast dir Mühe gegeben, und ich habe verstanden, was du meintest. Das hat mir genügt. Es war das Schönste, was jemals jemand für mich getan hat."

# game/scripts/c18/c18.rpy:627
translate german c18s001_Scarlett_6676f26b:

    # mc "Pero lo podía haber hecho mejor."
    mc "Aber er hätte es besser machen können."

# game/scripts/c18/c18.rpy:629
translate german c18s001_Scarlett_988f984e:

    # sca "No, mi amor. No podías."
    sca "Nein, mein Schatz. Das könntest du nicht."

# game/scripts/c18/c18.rpy:634
translate german c18s001_Eva_470231be:

    # eva "¿Interrumpo algo? ¿Puedo robarte a [mc] por una canción, Scarlett?"
    eva "Störe ich gerade? Darf ich [mc] für ein Lied ausleihen, Scarlett?"

# game/scripts/c18/c18.rpy:637
translate german c18s001_Eva_5bc304ce:

    # sca "No interrumpes. Precisamente le estaba diciendo que todas íbamos a querer bailar con él."
    sca "Du unterbrichst mich nicht. Ich habe ihm gerade gesagt, dass wir alle gerne mit ihm tanzen würden."

# game/scripts/c18/c18.rpy:638
translate german c18s001_Eva_2d394a22:

    # sca "Pasáoslo bien."
    sca "Sich amüsieren."

# game/scripts/c18/c18.rpy:640
translate german c18s001_Eva_3ddd83ca:

    # eva "Gracias, Scarlett."
    eva "Danke, Scarlett."

# game/scripts/c18/c18.rpy:641
translate german c18s001_Eva_a0458336:

    # sca "Lo que necesites, guapísima."
    sca "Was immer du brauchst, wunderschön."

# game/scripts/c18/c18.rpy:643
translate german c18s001_Eva_09f04e38:

    # eva "Me encanta este sitio, pero tenías razón. Voy demasiado vestida para esto."
    eva "Ich liebe diesen Ort, aber du hattest recht. Ich bin dafür zu schick angezogen."

# game/scripts/c18/c18.rpy:644
translate german c18s001_Eva_3d6ea348:

    # mc "No creo. Ya te he dicho antes que estás preciosa. Puede que no sea una embajada, como ha dicho Amanda, pero si estás cómoda con ese vestido, nadie se va a quejar."
    mc "Ich glaube nicht. Ich habe dir doch schon gesagt, dass du wunderschön aussiehst. Es ist zwar keine Botschaft, wie Amanda meinte, aber wenn du dich in dem Kleid wohlfühlst, wird sich niemand beschweren."

# game/scripts/c18/c18.rpy:645
translate german c18s001_Eva_96ee0478:

    # mc "¿De qué estabais discutiendo? ¿Hay algún problema entre vosotras?"
    mc "Worüber habt ihr gestritten? Gibt es ein Problem zwischen euch beiden?"

# game/scripts/c18/c18.rpy:647
translate german c18s001_Eva_470c137b:

    # eva "¿Cómo sabes que estábamos discutiendo? Creía que solo sabias unas pocas palabras en lengua de signos."
    eva "Woher weißt du, dass wir gestritten haben? Ich dachte, du kennst nur ein paar Gebärden."

# game/scripts/c18/c18.rpy:648
translate german c18s001_Eva_24b4818f:

    # mc "Me lo ha dicho Scarlett. No os entendía, pero por vuestros gestos dice que quedaba claro que era una discusión."
    mc "Scarlett hat es mir erzählt. Sie konnte dich nicht verstehen, aber an deinen Gesten war ihr klar, dass es ein Streit war."

# game/scripts/c18/c18.rpy:650
translate german c18s001_Eva_e2fb139e:

    # eva "Me estaba acusando de algo y... la cosa se ha calentado..."
    eva "Er beschuldigte mich einer Sache und... die Situation eskalierte..."

# game/scripts/c18/c18.rpy:651
translate german c18s001_Eva_ac64cb72:

    # mc "¿Puedo saber de qué te estaba acusando? ¿O es algo entre vosotras?"
    mc "Darf ich fragen, wessen ich Sie beschuldigt habe? Oder ist das etwas zwischen Ihnen beiden?"

# game/scripts/c18/c18.rpy:653
translate german c18s001_Eva_db7bd9f4:

    # eva "Ningún problema. Se está comportando como una niña celosa. Me acusaba de haberme puesto este vestido para ti."
    eva "Kein Problem. Sie benimmt sich nur wie ein eifersüchtiges kleines Mädchen. Sie hat mir vorgeworfen, dieses Kleid für dich zu tragen."

# game/scripts/c18/c18.rpy:654
translate german c18s001_Eva_53534287:

    # eva "Como ella se ha tenido que poner uno de los vestidos de [emm]..."
    eva "Da sie eines der Kleider aus [emm] tragen musste..."

# game/scripts/c18/c18.rpy:655
translate german c18s001_Eva_692ea280:

    # mc "¿Para mí? ¿Por qué?"
    mc "Für mich? Warum?"

# game/scripts/c18/c18.rpy:656
translate german c18s001_Eva_c7374d8d:

    # mc "¿Tiene algo que ver con que ayer la acusaras de flirtear conmigo?"
    mc "Hat das irgendetwas damit zu tun, dass du sie gestern beschuldigt hast, mit mir geflirtet zu haben?"

# game/scripts/c18/c18.rpy:658
translate german c18s001_Eva_0f9deee0:

    # eva "¡Chivata!"
    eva "Spitzel!"

# game/scripts/c18/c18.rpy:659
translate german c18s001_Eva_fb49920c:

    # mc "Igual de chivata que tú ahora mismo, Eva. *Risa*"
    mc "Genauso eine Petze wie du gerade, Eva. *lacht*"

# game/scripts/c18/c18.rpy:661
translate german c18s001_Eva_8fbb2f82:

    # eva "Tienes razón..."
    eva "Sie haben Recht..."

# game/scripts/c18/c18.rpy:662
translate german c18s001_Eva_5aab5dbc:

    # mc "Y... ¿realmente te lo has puesto para mí?"
    mc "Und... hast du es wirklich für mich getragen?"

# game/scripts/c18/c18.rpy:663
translate german c18s001_Eva_876fd190:

    # eva "Me lo he puesto porque quería estar guapa."
    eva "Ich habe es getragen, weil ich hübsch aussehen wollte."

# game/scripts/c18/c18.rpy:665
translate german c18s001_Eva_5003db39:

    # eva "Además, no tendría mucho sentido querer seducirte con un vestido si ya me has visto solo con las bragas... ¿no?"
    eva "Außerdem würde es wenig Sinn machen, dich mit einem Kleid verführen zu wollen, wenn du mich schon in Höschen gesehen hast... oder?"

# game/scripts/c18/c18.rpy:666
translate german c18s001_Eva_9632f557:

    # mc "*Risa* No me recuerdes ese día. No sabía que eras tú."
    mc "*lacht* Erinnere mich nicht an diesen Tag. Ich wusste nicht, dass du es warst."

# game/scripts/c18/c18.rpy:667
translate german c18s001_Eva_505beb96:

    # mc "Pero creo que sabes poco de la mentalidad masculina. *Risa*"
    mc "Aber ich glaube, Sie wissen sehr wenig über die männliche Denkweise. *lacht*"

# game/scripts/c18/c18.rpy:669
translate german c18s001_Eva_2283a464:

    # eva "¿A qué te refieres? ¿No te gusta el vestido?"
    eva "Was meinst du? Gefällt dir das Kleid nicht?"

# game/scripts/c18/c18.rpy:670
translate german c18s001_Eva_326e0be4:

    # mc "Me encanta."
    mc "Ich liebe es."

# game/scripts/c18/c18.rpy:671
translate german c18s001_Eva_2640c7a4:

    # mc "Me refiero a que la mayoría de los hombres prefieren ganarse el derecho a ver una chica desnuda. Un poco de coqueteo, que te dejen queriendo más..."
    mc "Ich meine, die meisten Männer ziehen es vor, sich das Recht zu verdienen, eine nackte Frau zu sehen. Ein bisschen Flirten, das Lust auf mehr macht..."

# game/scripts/c18/c18.rpy:672
translate german c18s001_Eva_631f85af:

    # mc "Si consiguen el premio sin esfuerzo, no le dan el valor que tiene. No digo que no lo valoren, pero no lo hacen lo suficiente."
    mc "Wenn sie den Preis ohne Anstrengung erhalten, schätzen sie ihn nicht so sehr, wie sie sollten. Ich sage nicht, dass sie ihn gar nicht wertschätzen, aber sie schätzen ihn nicht genug."

# game/scripts/c18/c18.rpy:674
translate german c18s001_Eva_84a8b471:

    # eva "Mmmm... tomo nota. Es decir... si quiero algo con un chico... debería dejarle con ganas de más, ¿no?"
    eva "Hmm... das werde ich mir merken. Ich meine... wenn ich etwas mit einem Mann will... sollte ich ihn doch mit dem Wunsch nach mehr zurücklassen, oder?"

# game/scripts/c18/c18.rpy:675
translate german c18s001_Eva_c21d463d:

    # mc "Sí, pero ve con cuidado. Si se lo haces muchas veces, puede pensar que eres una calienta pollas y perder el interés. Tienes que medir cuántas veces puedes o debes hacerlo."
    mc "Ja, aber sei vorsichtig. Wenn du es zu oft tust, könnte er denken, du willst ihn nur necken, und das Interesse verlieren. Du musst einschätzen, wie oft du es tun kannst oder solltest."

# game/scripts/c18/c18.rpy:677
translate german c18s001_Eva_5c976d1f:

    # eva "OK. Primera vez."
    eva "Okay. Das erste Mal."

# game/scripts/c18/c18.rpy:678
translate german c18s001_Eva_a3db9a7f:

    # mc "¿Qué?"
    mc "Das?"

# game/scripts/c18/c18.rpy:680
translate german c18s001_Eva_f057ccd6:

    # mc "*Risa*"
    mc "*Lachen*"

# game/scripts/c18/c18.rpy:681
translate german c18s001_Eva_ce10b6af:

    # mcp "(Tía Betty estaría orgullosa de mí ahora mismo. Esta vez no hace falta que le pregunte a Eva si el chico al que se refiere soy yo.)"
    mcp "(Tante Betty wäre jetzt stolz auf mich. Diesmal muss ich Eva nicht fragen, ob der Junge, von dem sie spricht, ich bin.)"

# game/scripts/c18/c18.rpy:682
translate german c18s001_Eva_02bf18ee:

    # mcp "(Y sí, me ha dejado con ganas de más. ¿Qué voy a hacer con esta chica?)"
    mcp "(Und ja, ich will mehr. Was soll ich nur mit diesem Mädchen anfangen?)"

# game/scripts/c18/c18.rpy:694
translate german c18s001_Kate_7103f663:

    # "Te diriges a la mesa donde están las bebidas. Apenas has tenido tiempo de probar tu zumo de piña."
    "Du gehst zu dem Tisch, an dem die Getränke stehen. Du hattest kaum Zeit, deinen Ananassaft zu probieren."

# game/scripts/c18/c18.rpy:696
translate german c18s001_Kate_9de0f56d:

    # mc "¿Qué tal, Kate? ¿No bailas?"
    mc "Hey Kate, wie geht's? Tanzt du denn nicht?"

# game/scripts/c18/c18.rpy:697
translate german c18s001_Kate_c6d1c6c8:

    # kat "No puedo bailar mientras te odio. *Risa*"
    kat "Ich kann nicht tanzen, solange ich dich hasse. *lacht*"

# game/scripts/c18/c18.rpy:698
translate german c18s001_Kate_e1dffb5b:

    # mc "¿Qué? ¿Por qué? ¿Qué he hecho yo ahora? ¿Puedo sentarme?"
    mc "Was? Warum? Was habe ich denn jetzt schon wieder getan? Kann ich mich setzen?"

# game/scripts/c18/c18.rpy:700
translate german c18s001_Kate_58e58e6a:

    # kat "Convencerme para hacer más deporte. *Risa* Tengo agujetas en las agujetas."
    kat "Überzeugt mich, mehr Sport zu treiben. *lacht* Ich habe überall Muskelkater."

# game/scripts/c18/c18.rpy:701
translate german c18s001_Kate_c4cc1884:

    # kat "Yoga a primera hora, después Debbie me ha tenido media mañana nadando. Ayer Kim me sacó a correr 30 minutos por la carretera."
    kat "Heute Morgen stand Yoga auf dem Programm, danach war ich mit Debbie den halben Vormittag schwimmen. Gestern nahm mich Kim zu einem 30-minütigen Lauf entlang der Straße mit."

# game/scripts/c18/c18.rpy:704
translate german c18s001_Kate_dfab0e8e:

    # kat "Y para ponerlo peor, me he tenido que retener de comer todas las cosas deliciosas que han preparado [mar] y [nor]."
    kat "Und als ob das nicht schon schlimm genug wäre, musste ich auch noch darauf verzichten, all die leckeren Sachen zu essen, die [mar] und [nor] zubereitet hatten."

# game/scripts/c18/c18.rpy:705
translate german c18s001_Kate_8720d35f:

    # kat "Y tengo que beber un cocktail sin alcohol. ¡Puagh! ¡Necesito mi azúcar intravenoso!"
    kat "Und ich muss einen alkoholfreien Cocktail trinken. Ätzend! Ich brauche meinen Zucker per Infusion!"

# game/scripts/c18/c18.rpy:706
translate german c18s001_Kate_23cbe36d:

    # mc "Comer saludable es bueno. [mar] y [nor] cocinan muy saludable, con lo que podrás comer de todo, pero quizás en menos cantidad de lo que lo hacías antes."
    mc "Gesunde Ernährung ist gut. [mar] und [nor] kochen sehr gesund, sodass man alles essen kann, nur vielleicht in kleineren Portionen als zuvor."

# game/scripts/c18/c18.rpy:707
translate german c18s001_Kate_fae3d1b3:

    # mc "Piensa que es por tu bien. Y hacer deporte es bueno. Te dará más resistencia."
    mc "Betrachte es als etwas, das dir selbst guttut. Und Sport ist gut. Er wird deine Ausdauer steigern."

# game/scripts/c18/c18.rpy:709
translate german c18s001_Kate_c586d63e:

    # kat "Lo sé, y todas me están ayudando mucho, pero duermo en la tercera planta."
    kat "Ich weiß, und sie helfen mir alle sehr, aber ich schlafe im dritten Stock."

# game/scripts/c18/c18.rpy:710
translate german c18s001_Kate_7ebda716:

    # kat "Ayer casi tuve que subir el último tramo de escaleras a gatas. Las piernas se quejaban a cada escalón."
    kat "Gestern musste ich die letzte Treppe fast hochkriechen. Meine Beine schmerzten bei jedem Schritt."

# game/scripts/c18/c18.rpy:711
translate german c18s001_Kate_e1ccb57e:

    # mc "No hace falta que te esfuerces demasiado. Es mejor hacer las cosas bien y poco a poco que quemarte."
    mc "Du musst dich nicht zu sehr anstrengen. Es ist besser, die Dinge gut und nach und nach zu erledigen, als sich völlig zu verausgaben."

# game/scripts/c18/c18.rpy:721
translate german c18s001_Kate_a7d6e7ab:

    # mc "Cuando hayas cogido un poco de resistencia, te llevaré a un lago precioso que hay en las colinas. Ya verás como vale la pena."
    mc "Sobald du etwas Ausdauer aufgebaut hast, bringe ich dich zu einem wunderschönen See in den Bergen. Du wirst sehen, es lohnt sich."

# game/scripts/c18/c18.rpy:723
translate german c18s001_Kate_bf442a18:

    # kat "Oh, eso sería genial. Debbie y Kim me han dicho que es precioso."
    kat "Oh, das wäre toll. Debbie und Kim haben mir gesagt, es sei wunderschön."

# game/scripts/c18/c18.rpy:725
translate german c18s001_Kate_938700eb:

    # kat "Kim me ha dicho de subir un día corriendo al lago. Cuando haya conseguido que dar dos pasos no duela."
    kat "Kim hat mir gesagt, ich solle eines Tages zum See rennen. Wenn ich es geschafft habe, zwei Schritte zu gehen, ohne dass es weh tut."

# game/scripts/c18/c18.rpy:726
translate german c18s001_Kate_5c552fee:

    # mc "Cuando subáis avisadme y me apunto si puedo."
    mc "Sag mir Bescheid, wenn du hochgehst, und ich komme mit, wenn ich kann."

# game/scripts/c18/c18.rpy:728
translate german c18s001_Kate_6418e5c1:

    # kat "Kim ya me ha dicho que las llevaste a ella y a Debbie y que es precioso."
    kat "Kim hat mir schon erzählt, dass du sie ihr und Debbie gezeigt hast und dass es wunderschön ist."

# game/scripts/c18/c18.rpy:730
translate german c18s001_Kate_9cd6998c:

    # kat "También has estado allí con Eileen y Alexia... y Eva..."
    kat "Du warst auch mit Eileen und Alexia da... und Eva..."

# game/scripts/c18/c18.rpy:732
translate german c18s001_Kate_c3b75b83:

    # kat "*Risa* ¡Y todas han estado contigo allí!"
    kat "*Lacht* Und sie alle waren schon mal mit dir dort!"

# game/scripts/c18/c18.rpy:733
translate german c18s001_Kate_b86819b7:

    # kat "¿Es como tu terreno de caza particular? ¿El sitio donde llevas a las chicas para deslumbrarlas con la belleza del lugar?"
    kat "Ist es so etwas wie dein ganz persönliches Jagdrevier? Der Ort, an den du Mädchen mitnimmst, um sie mit der Schönheit des Ortes zu beeindrucken?"

# game/scripts/c18/c18.rpy:734
translate german c18s001_Kate_e0e21fce:

    # mc "*Risa* No es eso, Kate."
    mc "*lacht* Das ist es nicht, Kate."

# game/scripts/c18/c18.rpy:744
translate german c18s001_Kate_abaf66fa:

    # mc "Pero si te llevase a ti, el deslumbrado sería el lago. Y sí, sé que suena cursi."
    mc "Aber wenn ich dich mitnehmen würde, wäre der See derjenige, der verzaubert wäre. Und ja, ich weiß, es klingt kitschig."

# game/scripts/c18/c18.rpy:746
translate german c18s001_Kate_a56fa9d4:

    # kat "Y ahora quieres que me ruborice otra vez con tus piropos cursis."
    kat "Und jetzt willst du mich mit deinen kitschigen Komplimenten schon wieder zum Erröten bringen?"

# game/scripts/c18/c18.rpy:747
translate german c18s001_Kate_6ce54d32:

    # mc "Ya te dije que, si querías, podía dejar de hacerlo."
    mc "Ich habe dir doch schon gesagt, dass ich damit aufhören könnte, wenn du es wünschst."

# game/scripts/c18/c18.rpy:749
translate german c18s001_Kate_9347f805:

    # kat "Y yo te dije ayer que no me molestan."
    kat "Und ich habe Ihnen gestern schon gesagt, dass sie mich nicht stören."

# game/scripts/c18/c18.rpy:750
translate german c18s001_Kate_e27514af:

    # mc "Por lo que yo recuerdo, dijiste que no me atreviera a dejar de hacerlo. *Risa*"
    mc "Wenn ich mich recht erinnere, hast du gesagt, ich solle bloß nicht damit aufhören. *lacht*"

# game/scripts/c18/c18.rpy:751
translate german c18s001_Kate_fc19720f:

    # kat "Es bonito que un chico me diga esas cosas de vez en cuando, aunque sea en broma."
    kat "Es ist schön, wenn mir ein Mann ab und zu solche Dinge sagt, selbst wenn es nur ein Witz ist."

# game/scripts/c18/c18.rpy:753
translate german c18s001_Kate_a9759c75:

    # "Suena un móvil, pero ella lo ignora."
    "Ein Handy klingelt, aber sie ignoriert es."

# game/scripts/c18/c18.rpy:754
translate german c18s001_Kate_57bc9e5a:

    # mc "¿Quién ha dicho que sea en broma?"
    mc "Wer hat gesagt, dass es ein Witz war?"

# game/scripts/c18/c18.rpy:756
translate german c18s001_Kate_a0b49c3a:

    # kat "¿Qué? ¿Lo dices en serio?"
    kat "Was? Ist das dein Ernst?"

# game/scripts/c18/c18.rpy:759
translate german c18s001_Kate_e2994fbb:

    # "Suena un móvil."
    "Ein Handy klingelt."

# game/scripts/c18/c18.rpy:762
translate german c18s001_Kate_7334a868:

    # emm "Hola, chicos. Kate, ¿te molesta que me lleve a mi hermano para bailar con él?"
    emm "Hey Leute. Kate, hättest du etwas dagegen, wenn ich meinen Bruder mitbringe, damit er mit ihm tanzen kann?"

# game/scripts/c18/c18.rpy:764
translate german c18s001_Kate_c00df548:

    # kat "No, para nada. Todo tuyo. Llévatelo o al final me va a convencer para ir a correr. *Risa*"
    kat "Nein, überhaupt nicht. Es gehört dir. Nimm es, oder du überredest mich noch zum Joggen. *lacht*"

# game/scripts/c18/c18.rpy:766
translate german c18s001_Kate_9ac5dc0a:

    # mc "Te veo luego, Kate, y, si quieres, seguimos la conversación. *Risa*"
    mc "Wir sehen uns später, Kate, und wenn du möchtest, können wir unser Gespräch fortsetzen. *lacht*"

# game/scripts/c18/c18.rpy:806
translate german c18s001_Emma_780c398b:

    # emm "Ha sido una gran idea venir aquí. Una sala solo para nosotros es genial. Sin problemas con idiotas como en el Twins."
    emm "Es war eine super Idee, hierherzukommen. Ein eigenes Zimmer zu haben, ist fantastisch. Keine Probleme mit Idioten wie bei Twins."

# game/scripts/c18/c18.rpy:807
translate german c18s001_Emma_21917f11:

    # mc "Y sin que todas me tengáis que besar para quitárnoslos de encima."
    mc "Und das, ohne dass ihr mich alle küssen müsst, um sie von uns loszuwerden."

# game/scripts/c18/c18.rpy:809
translate german c18s001_Emma_62347b9d:

    # emm "Bueno... yo no tuve oportunidad de besarte."
    emm "Nun ja... ich hatte keine Gelegenheit, dich zu küssen."

# game/scripts/c18/c18.rpy:810
translate german c18s001_Emma_ca2fd263:

    # mc "Pero lo hiciste luego en mi habitación."
    mc "Aber du hast es später in meinem Zimmer getan."

# game/scripts/c18/c18.rpy:813
translate german c18s001_Emma_f6d7a818:

    # emm "Y me muero de ganas de hacerlo aquí ahora. Pero, por una vez, no quiero ser el centro de atención."
    emm "Und ich würde es am liebsten sofort tun. Aber ausnahmsweise möchte ich nicht im Mittelpunkt stehen."

# game/scripts/c18/c18.rpy:814
translate german c18s001_Emma_b92bbdee:

    # emm "[eri] lo sabe, pero [dap] no. También es su cumpleaños y no me gustaría que se sintiera mal."
    emm "[eri] weiß es, aber [dap] nicht. Außerdem hat sie Geburtstag, und ich möchte nicht, dass sie sich schlecht fühlt."

# game/scripts/c18/c18.rpy:815
translate german c18s001_Emma_7405b48f:

    # mc "¿Por qué iba a sentirse mal?"
    mc "Warum sollte sie sich schlecht fühlen?"

# game/scripts/c18/c18.rpy:818
translate german c18s001_Emma_71cbd563:

    # emm "Creo que a ella también le gustas, y no me refiero como primo."
    emm "Ich glaube, sie mag dich auch, und ich meine das nicht als Cousin."

# game/scripts/c18/c18.rpy:819
translate german c18s001_Emma_3bb7dffc:

    # emm "Besarte aquí sería restregarle por la cara que yo estoy contigo y ella no."
    emm "Dich hier zu küssen, hieße, ihr unter die Nase zu reiben, dass ich mit dir zusammen bin und sie nicht."

# game/scripts/c18/c18.rpy:821
translate german c18s001_Emma_211c0cea:

    # mcp "(Tu memoria es muy interesante, [emm]. Ya no recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que salía con alguien.)"
    mcp "(Dein Gedächtnis ist ja interessant, [emm]. Du erinnerst dich nicht mehr daran, dass Meemaw und Tante Betty beim ersten gemeinsamen Essen gesagt haben, sie sei in einer Beziehung.)"

# game/scripts/c18/c18.rpy:823
translate german c18s001_Emma_5262424c:

    # mcp "(Eres muy lista, [emm]. Seguro que recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que había un chico que le interesaba y seguro que lo has relacionado conmigo.)"
    mcp "(Du bist sehr klug, [emm]. Ich bin sicher, du erinnerst dich daran, dass Meemaw bei unserem ersten gemeinsamen Essen mit Tante Betty sagte, es gäbe einen Jungen, an dem sie interessiert sei, und ich bin sicher, du hast ihn mit mir in Verbindung gebracht.)"

# game/scripts/c18/c18.rpy:824
translate german c18s001_Emma_3ac08a88:

    # mc "Si no te equivocas, y es un \"si\" muy grande, tienes razón. La harías sentir mal. Es el problema de no querer hacerlo público, [emm]."
    mc "Wenn du dich nicht irrst – und das ist ein klares „Ja“ –, hast du recht. Du würdest sie verletzen. Genau das ist das Problem, wenn man es nicht öffentlich machen will."

# game/scripts/c18/c18.rpy:827
translate german c18s001_Emma_c580d8ea:

    # emm "No creo que me equivoque. Ni siquiera [eri] le ha dicho que estáis juntos. Supongo que será porque ella también lo ha notado."
    emm "Ich glaube nicht, dass ich mich irre. Sie hat ihm noch nicht einmal gesagt, dass ihr zwei zusammen seid. Ich schätze, das liegt daran, dass es ihr auch schon aufgefallen ist."

# game/scripts/c18/c18.rpy:828
translate german c18s001_Emma_0f7534a6:

    # mc "O porque quiere dejar pasar los cumpleaños para hacer el anuncio a toda la familia."
    mc "Oder weil er bis nach den Geburtstagen warten möchte, um die Neuigkeit der ganzen Familie mitzuteilen."

# game/scripts/c18/c18.rpy:829
translate german c18s001_Emma_03d2c26a:

    # mc "Pero deberíamos empezar a pensar cuándo quieres hacer público lo tuyo y lo mío."
    mc "Aber wir sollten uns Gedanken darüber machen, wann du deine und meine Sachen öffentlich machen willst."

# game/scripts/c18/c18.rpy:832
translate german c18s001_Emma_a989a2a8:

    # emm "También es su fin de semana y sería un bombazo para todo el mundo."
    emm "Es ist auch ihr Wochenende und es wäre für alle ein riesiges Ereignis."

# game/scripts/c18/c18.rpy:834
translate german c18s001_Emma_78568af6:

    # emm "Y si [eri] también lo hiciera público..."
    emm "Und wenn [eri] es auch öffentlich gemacht hätte..."

# game/scripts/c18/c18.rpy:835
translate german c18s001_Emma_bb143c4c:

    # mc "Tienes razón. Deberíamos pensar en cuándo quieres hacerlo público."
    mc "Du hast Recht. Wir sollten darüber nachdenken, wann du es veröffentlichen möchtest."

# game/scripts/c18/c18.rpy:837
translate german c18s001_Emma_b1e4ce5f:

    # mc "Mamá, [eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "Mama, [eri] und Eileen wissen es schon. Du musst entscheiden, wann du es den anderen erzählen willst."

# game/scripts/c18/c18.rpy:839
translate german c18s001_Emma_88c6df49:

    # mc "[eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "[eri], und Eileen weiß es bereits. Du musst entscheiden, wann du es den anderen sagen willst."

# game/scripts/c18/c18.rpy:841
translate german c18s001_Emma_01c142b5:

    # emm "¿Prometes no enfadarte?"
    emm "Versprichst du, nicht wütend zu werden?"

# game/scripts/c18/c18.rpy:842
translate german c18s001_Emma_1742a8e9:

    # mc "¿Qué has hecho ahora? ¿Delante de quién más se te ha escapado?"
    mc "Was hast du jetzt schon wieder angestellt? Wem ist es denn noch entwischt?"

# game/scripts/c18/c18.rpy:843
translate german c18s001_Emma_78aa2d2f:

    # emm "No es eso... Hoy me he levantado con nauseas. No sé si es porque ayer comí como una cerda o... Hace nueve días de nuestra primera vez, y si estuviera embarazada..."
    emm "Es ist nicht so... Mir ist heute Morgen übel. Ich weiß nicht, ob es daran liegt, dass ich gestern so viel gegessen habe oder... Es sind neun Tage seit unserem ersten Mal vergangen, und was, wenn ich schwanger wäre..."

# game/scripts/c18/c18.rpy:845
translate german c18s001_Emma_21f4ac1e:

    # emm "El fin de semana que viene podría hacerme una prueba de embarazo."
    emm "Ich könnte nächstes Wochenende einen Schwangerschaftstest machen."

# game/scripts/c18/c18.rpy:846
translate german c18s001_Emma_26027b19:

    # mc "¡Oh, mierda!"
    mc "Oh Scheiße!"

# game/scripts/c18/c18.rpy:848
translate german c18s001_Emma_64a6cd98:

    # emm "¿Qué pasa? ¿No quieres tener un hijo conmigo?"
    emm "Was ist los? Willst du kein Kind mit mir haben?"

# game/scripts/c18/c18.rpy:849
translate german c18s001_Emma_ea1a62df:

    # "Le explicas lo de las pruebas rápidas de embarazo."
    "Du erklärst ihr die Schnelltests für Schwangerschaften."

# game/scripts/c18/c18.rpy:851
translate german c18s001_Emma_d18754b4:

    # emm "¿Por qué no me lo habías dicho antes?"
    emm "Warum hast du mir das nicht vorher gesagt?"

# game/scripts/c18/c18.rpy:852
translate german c18s001_Emma_f96b81cf:

    # mc "Estabas tan enfadada el día de la comida con Eva que... me olvidé. Creía habértelo dicho."
    mc "Du warst am Tag des Mittagessens so wütend auf Eva, dass... ich es vergessen habe. Ich dachte, ich hätte es dir erzählt."

# game/scripts/c18/c18.rpy:854
translate german c18s001_Emma_fc57eead:

    # emm "En cuanto lleguemos a casa me la hago. Cubrirá nuestras dos veces y mañana lo podríamos saber."
    emm "Ich nehme es, sobald wir zu Hause sind. Es deckt unsere beider Perioden ab, und wir sollten morgen Bescheid wissen."

# game/scripts/c18/c18.rpy:855
translate german c18s001_Emma_b656199d:

    # mc "24 horas después de hacer la prueba estaremos jugando a DnD. ¿Serás capaz de aguantar sin mirarlo hasta que acabe la partida?"
    mc "24 Stunden nach dem Test spielen wir Dungeons & Dragons. Wirst du es schaffen, nicht darauf zu schauen, bis das Spiel vorbei ist?"

# game/scripts/c18/c18.rpy:857
translate german c18s001_Emma_882c93d1:

    # emm "Mierda, tienes razón. Y decirles a las chicas que nos tenemos que ir los dos a la vez... mejor no."
    emm "Verdammt, du hast recht. Und den Mädels zu sagen, dass wir beide gleichzeitig gehen müssen... besser nicht."

# game/scripts/c18/c18.rpy:858
translate german c18s001_Emma_8c761108:

    # emm "Mejor la hacemos mañana por la mañana y lo sabremos el lunes."
    emm "Wir sollten es am besten morgen früh erledigen, dann wissen wir am Montag mehr."

# game/scripts/c18/c18.rpy:859
translate german c18s001_Emma_349c7006:

    # mc "Me parece una buena idea. Me paso por tu habitación cuando me despierte."
    mc "Das klingt nach einer guten Idee. Ich komme gleich nach dem Aufwachen in deinem Zimmer vorbei."

# game/scripts/c18/c18.rpy:862
translate german c18s001_Emma_29ab53e7:

    # emm "No me lo recuerdes... ¡Qué vergüenza!"
    emm "Erinnere mich bloß nicht daran... Wie peinlich!"

# game/scripts/c18/c18.rpy:863
translate german c18s001_Emma_9da35e94:

    # mc "No pasa nada. Ya lo hablamos y todo quedó aclarado."
    mc "Alles in Ordnung. Wir haben das schon besprochen und alles ist geklärt."

# game/scripts/c18/c18.rpy:865
translate german c18s001_Emma_6c33ef89:

    # "Suena un móvil justo en el momento en que se enciende el proyector y aparece Megan en la pantalla gigante."
    "Ein Handy klingelt, genau in dem Moment, als der Projektor eingeschaltet wird und Megan auf der riesigen Leinwand erscheint."

# game/scripts/c18/c18.rpy:868
translate german c18s001_Emma_530f61fd:

    # meg "Buenas noches a todos. Voy a empezar con mi primera actuación de la noche."
    meg "Guten Abend allerseits. Ich beginne mit meinem ersten Auftritt des Abends."

# game/scripts/c18/c18.rpy:869
translate german c18s001_Emma_9c1b3477:

    # meg "Esta noche tengo a un grupo de amigos... a mi familia... en el local, con lo que hoy es muy emotivo para mí."
    meg "Heute Abend sind viele Freunde und meine Familie vor Ort, deshalb ist der Tag für mich sehr emotional."

# game/scripts/c18/c18.rpy:870
translate german c18s001_Emma_6b288041:

    # meg "Tan solo espero que disfrutéis estas canciones. ¡Vamos allá!"
    meg "Ich hoffe einfach, dass euch diese Lieder gefallen. Los geht's!"

# game/scripts/c18/c18.rpy:888
translate german c18s001_Saira_c73c0060:

    # sai "Creo que es mi turno de un baile contigo, ¿no?"
    sai "Ich glaube, jetzt bin ich an der Reihe, mit dir zu tanzen, oder nicht?"

# game/scripts/c18/c18.rpy:889
translate german c18s001_Saira_affd4dab:

    # mc "Por supuesto, además esta canción me encanta."
    mc "Natürlich liebe ich dieses Lied auch."

# game/scripts/c18/c18.rpy:891
translate german c18s001_Saira_792c3b3e:

    # mc "¿Qué tal te lo estás pasando?"
    mc "Wie gefällt es Ihnen?"

# game/scripts/c18/c18.rpy:892
translate german c18s001_Saira_9955125c:

    # sai "Genial, la sala privada está muy bien y podemos bailar sin tener que luchar por el espacio."
    sai "Großartig, der private Raum ist sehr schön und wir können tanzen, ohne um Platz kämpfen zu müssen."

# game/scripts/c18/c18.rpy:893
translate german c18s001_Saira_f7d55e1d:

    # sai "Ni siquiera tenemos que luchar por ti..."
    sai "Wir müssen nicht einmal für dich kämpfen..."

# game/scripts/c18/c18.rpy:894
translate german c18s001_Saira_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c18/c18.rpy:896
translate german c18s001_Saira_5519520e:

    # sai "A que [dap] es muy lista. Eres el único chico que hay, con lo que todas vamos a bailar contigo."
    sai "Ich wette, [dap] ist richtig schlau. Du bist der Einzige hier, also tanzen wir alle mit dir."

# game/scripts/c18/c18.rpy:897
translate german c18s001_Saira_bb8c4abd:

    # sai "En vez de pelearnos por ver a quién le toca, ha montado un sistema de turnos."
    sai "Anstatt sich darüber zu streiten, wer an der Reihe ist, hat er ein Schichtsystem eingeführt."

# game/scripts/c18/c18.rpy:898
translate german c18s001_Saira_1048adb6:

    # mc "*Risa* Algo así sólo se le podía haber ocurrido a [dap]."
    mc "*Gelächter* Nur [dap] konnte sich so etwas ausdenken."

# game/scripts/c18/c18.rpy:900
translate german c18s001_Saira_5fe1c336:

    # sai "Scarlett también participó haciendo la app que cada una tenemos en el móvil."
    sai "Scarlett hat sich ebenfalls beteiligt, indem sie die App entwickelt hat, die wir alle auf unseren Mobiltelefonen haben."

# game/scripts/c18/c18.rpy:901
translate german c18s001_Saira_e10704bc:

    # mc "¿Qué? ¿Tenéis una app para saber cuándo os toca bailar conmigo?"
    mc "Was? Hast du eine App, die dir sagt, wann du mit mir tanzen sollst?"

# game/scripts/c18/c18.rpy:903
translate german c18s001_Saira_b626d4a0:

    # sai "*Risa* Sí, pero no me mires así, Scarlett tenía la app medio hecha para otra cosa y la ha adaptado para esta noche."
    sai "*Lacht* Ja, aber schau mich nicht so an, Scarlett hatte die App halbfertig für etwas anderes und hat sie für heute Abend angepasst."

# game/scripts/c18/c18.rpy:904
translate german c18s001_Saira_9315f609:

    # mc "¿Cómo ha funcionado cuando he ido a hablar con Kate?"
    mc "Wie ist es gelaufen, als ich mit Kate gesprochen habe?"

# game/scripts/c18/c18.rpy:906
translate german c18s001_Saira_e84a1e7f:

    # sai "Scarlett y [dap] te conocen muy bien y sabían que pasaría algo así. Tienen una opción para mover los turnos. Pero sólo los pueden mover ellas"
    sai "Scarlett und [dap] kennen dich sehr gut und wussten, dass so etwas passieren würde. Sie haben die Möglichkeit, die Spielzüge zu verschieben. Aber nur sie können das."

# game/scripts/c18/c18.rpy:907
translate german c18s001_Saira_80f41837:

    # mc "*Risa* Y todas vosotras confiáis de ellas para que los muevan sin hacer trampas, ¿no?"
    mc "*Gelächter* Und ihr vertraut alle darauf, dass sie die Sachen ohne Betrug bewegen, richtig?"

# game/scripts/c18/c18.rpy:909
translate german c18s001_Saira_4534c409:

    # sai "También han pensado en eso. Nos llega una notificación a todas con los cambios. No pueden moverlos sin que nos enteremos."
    sai "Auch daran haben sie gedacht. Wir alle erhalten eine Benachrichtigung über die Änderungen. Sie können sie nicht ohne unser Wissen vornehmen."

# game/scripts/c18/c18.rpy:910
translate german c18s001_Saira_1f7ef1eb:

    # sai "Así se fomenta la confianza, ¿no? *Risa*"
    sai "So baut man Vertrauen auf, nicht wahr? *lacht*"

# game/scripts/c18/c18.rpy:911
translate german c18s001_Saira_6ebc3eab:

    # mc "*Risa* Sois tremendas."
    mc "*Gelächter* Ihr seid der Wahnsinn!"

# game/scripts/c18/c18.rpy:914
translate german c18s001_Saira_7e6135bc:

    # sai "Estoy pensando en que deberíamos montar algo parecido a esta app para saber cuándo podemos tener tiempo a solas contigo cada una de las chicas de tu harén. *Risa*"
    sai "Ich denke, wir sollten etwas Ähnliches wie diese App entwickeln, damit jedes der Mädchen in deinem Harem weiß, wann wir etwas Zeit allein mit dir verbringen können. *Lacht*"

# game/scripts/c18/c18.rpy:916
translate german c18s001_Saira_c7df6ada:

    # sai "Estoy pensando en pedirle que haga una adaptación de la app para saber cuándo estás libre para tener tiempo a solas contigo. *Risa*"
    sai "Ich überlege, ihn zu bitten, die App so anzupassen, dass ich weiß, wann du Zeit für dich hast. *lacht*"

# game/scripts/c18/c18.rpy:918
translate german c18s001_Saira_f0d9c50c:

    # sai "Si hubiéramos vuelto a lo que teníamos en Portland, hubiese sido algo muy útil. Especialmente si estás con otras mujeres."
    sai "Wenn wir zu dem zurückgekehrt wären, was wir in Portland hatten, wäre das sehr hilfreich gewesen. Besonders, wenn man mit anderen Frauen zusammen ist."

# game/scripts/c18/c18.rpy:919
translate german c18s001_Saira_a60320f7:

    # mc "Sí, no hubiera estado mal tener algo así. *Risa*"
    mc "Ja, so etwas wäre nicht schlecht gewesen. *lacht*"

# game/scripts/c18/c18.rpy:920
translate german c18s001_Saira_e5903d6d:

    # mc "Aunque habría que poner algún botón para imprevistos que me llenasen la agenda por un par de días porque nadie más quiere o puede resolverlos."
    mc "Ich sollte allerdings einen Button für unerwartete Ereignisse hinzufügen, die meinen Terminkalender für ein paar Tage füllen, weil sonst niemand sie übernehmen will oder kann."

# game/scripts/c18/c18.rpy:922
translate german c18s001_Saira_6ef7dc9d:

    # mc "*Risa* No creo que sea tan difícil tener tiempo a solas conmigo, ¿no?"
    mc "*Lacht* Ich glaube nicht, dass es so schwer ist, etwas Zeit allein mit mir zu verbringen, oder?"

# game/scripts/c18/c18.rpy:924
translate german c18s001_Saira_7397e24e:

    # sai "¿Lo estás diciendo en serio? ¡Llevo cuatro días aquí y me están saliendo telarañas esperándote! *Risa*"
    sai "Ist das dein Ernst? Ich bin schon seit vier Tagen hier und mir wachsen fast Spinnweben, nur weil ich auf dich gewartet habe! *lacht*"

# game/scripts/c18/c18.rpy:925
translate german c18s001_Saira_d890795a:

    # mc "*Risa* Sabes que no hace falta que me esperes y que tú puedes tomar la iniciativa cuando quieras, ¿no?"
    mc "*Lacht* Du weißt doch, dass du nicht auf mich warten musst und jederzeit die Initiative ergreifen kannst, oder?"

# game/scripts/c18/c18.rpy:926
translate german c18s001_Saira_af651527:

    # mc "No es que estemos en los 70 o en una película. Las chicas podéis decidir pasar a la acción y nadie os va a juzgar. *Risa*"
    mc "Wir leben ja nicht in den 70ern oder in einem Film. Mädels, ihr könnt selbst aktiv werden, und niemand wird euch verurteilen. *lacht*"

# game/scripts/c18/c18.rpy:927
translate german c18s001_Saira_29cab2db:

    # mc "Además, somos tú y yo. Nunca has estado esperando a que yo actuara."
    mc "Außerdem sind wir doch nur zu zweit. Du hast nie darauf gewartet, dass ich handle."

# game/scripts/c18/c18.rpy:929
translate german c18s001_Saira_ae40e5f5:

    # sai "Mmmm... Tienes razón. Lo pensaré... "
    sai "Mmm... Du hast recht. Ich werde darüber nachdenken..."

# game/scripts/c18/c18.rpy:930
translate german c18s001_Saira_5b4dd07e:

    # mc "Una vez pase esta locura de fin de semana estaré mucho más libre. Al menos hasta que surja el siguiente problema que nadie más que yo pueda resolver. *Risa*"
    mc "Sobald dieses verrückte Wochenende vorbei ist, habe ich viel mehr Freizeit. Zumindest bis das nächste Problem auftaucht, das nur ich lösen kann. *lacht*"

# game/scripts/c18/c18.rpy:932
translate german c18s001_Saira_a39cdc47:

    # sai "Te estamos exigiendo mucho entre todas, ¿no?"
    sai "Wir alle legen viel Druck auf dich aus, nicht wahr?"

# game/scripts/c18/c18.rpy:933
translate german c18s001_Saira_b4d27d30:

    # mc "No, Saira. Eso es lo mejor de todo. No exigís nada. Lo hago todo porque me apetece y me siento a gusto haciéndolo por vosotras."
    mc "Nein, Saira. Das ist ja das Beste daran. Du verlangst nichts. Ich mache alles, weil ich es will und weil es mir guttut, es für dich zu tun."

# game/scripts/c18/c18.rpy:934
translate german c18s001_Saira_7df3672e:

    # mc "Pero sois un montón, y siempre hay una urgencia, a alguien a quien llevar a algún sitio, algo que comprar, o algo en lo que ayudar."
    mc "Aber ihr seid so viele, und es gibt immer einen Notfall, jemanden, den man irgendwohin bringen muss, etwas, das man kaufen muss, oder etwas, bei dem man helfen muss."

# game/scripts/c18/c18.rpy:936
translate german c18s001_Saira_4d932e57:

    # sai "Sabes que casi todas tenemos carnet de conducir, ¿verdad? Las labores de taxista nos las podemos repartir entre nosotras y así tendrás más tiempo libre."
    sai "Du weißt doch, dass fast alle von uns einen Führerschein haben, oder? Wir können die Taxifahrten unter uns aufteilen, und so hast du mehr Freizeit."

# game/scripts/c18/c18.rpy:937
translate german c18s001_Saira_9a2f5a3b:

    # mc "Lo sé, pero si me pides que te lleve a algún sitio, lo voy a hacer. No te voy a decir \"toma las llaves del coche y ve tú sola\"."
    mc "Ich weiß, aber wenn du mich bittest, dich irgendwohin zu fahren, mache ich das. Ich werde ja nicht sagen: „Hier sind die Autoschlüssel, fahr allein.“"

# game/scripts/c18/c18.rpy:938
translate german c18s001_Saira_dfb23f1f:

    # mc "Además, ya te digo que disfruto haciéndolo. Hacer cosas con y para vosotras es pasar tiempo con vosotras."
    mc "Außerdem kann ich dir sagen, dass es mir Spaß macht. Dinge mit und für dich zu unternehmen, bedeutet, Zeit mit dir zu verbringen."

# game/scripts/c18/c18.rpy:940
translate german c18s001_Saira_1b4c9e02:

    # "Suena un móvil en algún lugar."
    "Irgendwo klingelt ein Handy."

# game/scripts/c18/c18.rpy:942
translate german c18s001_Saira_32ad5170:

    # sai "Mi turno ha acabado. Te dejo en buenas manos."
    sai "Meine Schicht ist vorbei. Sie sind in guten Händen."

# game/scripts/c18/c18.rpy:944
translate german c18s001_Saira_e202c819:

    # mc "*Risa* ¿Ves lo que te decía? Al final decidís mi agenda por mí."
    mc "*Lacht* Siehst du, was ich dir gesagt habe? Am Ende bestimmst du meinen Zeitplan für mich."

# game/scripts/c18/c18.rpy:1013
translate german c18s001_Erika_fa2c8d21:

    # eri "¿Bailas?"
    eri "Tanzt du?"

# game/scripts/c18/c18.rpy:1014
translate german c18s001_Erika_54ccd33d:

    # mc "Claro, es tu turno, ¿no? *Risa*"
    mc "Na klar, du bist dran, oder? *lacht*"

# game/scripts/c18/c18.rpy:1016
translate german c18s001_Erika_400259f7:

    # eri "*Risa* Sí, ahora me toca a mí."
    eri "*Lacht* Ja, jetzt bin ich an der Reihe."

# game/scripts/c18/c18.rpy:1017
translate german c18s001_Erika_917019cb:

    # eri "¿Quién te lo ha dicho?"
    eri "Wer hat dir das erzählt?"

# game/scripts/c18/c18.rpy:1018
translate german c18s001_Erika_164415bf:

    # mc "Se dice el pecado, pero no el pecador."
    mc "Die Sünde wird erwähnt, nicht aber der Sünder."

# game/scripts/c18/c18.rpy:1020
translate german c18s001_Erika_7a1bda8d:

    # eri "Tampoco importa. No es que lo quisiéramos guardar en secreto."
    eri "Das spielt keine Rolle. Es ist ja nicht so, als ob wir es geheim halten wollten."

# game/scripts/c18/c18.rpy:1021
translate german c18s001_Erika_450f1508:

    # eri "Pero ha sido una buena idea por parte de [dap] y Scarlett."
    eri "Aber es war eine gute Idee von [dap] und Scarlett."

# game/scripts/c18/c18.rpy:1022
translate german c18s001_Erika_00e0e961:

    # eri "Si te tenemos que compartir, mejor hacerlo de forma ordenada."
    eri "Wenn wir etwas mit Ihnen teilen müssen, tun wir es am besten auf organisierte Weise."

# game/scripts/c18/c18.rpy:1023
translate german c18s001_Erika_ef96eebc:

    # mc "Ha sido una buena idea, pero con fallos. ¿Qué pasaría si quiero bailar cuatro canciones seguidas contigo?"
    mc "Es war eine gute Idee, aber mit Schwächen. Was, wenn ich vier Lieder hintereinander mit dir tanzen möchte?"

# game/scripts/c18/c18.rpy:1025
translate german c18s001_Erika_2eb52358:

    # eri "*Risa* Me vería obligada a rechazarte durante el resto de la noche."
    eri "*Lacht* Ich wäre gezwungen, dich für den Rest der Nacht abzuweisen."

# game/scripts/c18/c18.rpy:1026
translate german c18s001_Erika_cb8060d2:

    # eri "Pero todas sabemos que no lo harás. No querrías que el resto de las chicas se sintieran mal."
    eri "Aber wir wissen alle, dass du es nicht tun wirst. Du willst ja nicht, dass sich die anderen Mädchen schlecht fühlen."

# game/scripts/c18/c18.rpy:1027
translate german c18s001_Erika_f490b78b:

    # mc "¡Joder, [eri]! *Risa* Me conocéis demasiado bien."
    mc "Verdammt, [eri]! *Lacht* Du kennst mich zu gut."

# game/scripts/c18/c18.rpy:1029
translate german c18s001_Erika_6da28eef:

    # eri "No se lo digas a nadie, pero creo que mi hermana y Scarlett están haciendo un experimento social contigo. *Risa*"
    eri "Sag's bloß niemandem, aber ich glaube, meine Schwester und Scarlett machen ein soziales Experiment mit dir. *lacht*"

# game/scripts/c18/c18.rpy:1031
translate german c18s001_Erika_cf8c89f2:

    # eri "Bueno... mi hermana desde siempre... ahora tengo otra."
    eri "Nun ja... meine Schwester war immer für mich da... jetzt habe ich noch eine."

# game/scripts/c18/c18.rpy:1032
translate german c18s001_Erika_d77c1542:

    # eri "Y Scarlett casi lo es también."
    eri "Und Scarlett ist es fast auch."

# game/scripts/c18/c18.rpy:1034
translate german c18s001_Erika_b5f98137:

    # mcp "(No vas desencaminada, pero creo que, como mucho, será prima)"
    mcp "(Du liegst nicht ganz falsch, aber ich denke, sie wird höchstens eine Cousine sein.)"

# game/scripts/c18/c18.rpy:1036
translate german c18s001_Erika_eb1f4371:

    # eri "Y el resto de las chicas... en un par de semanas nos vamos a empezar a llamar \"hermana\" las unas a las otras."
    eri "Und der Rest der Mädchen... in ein paar Wochen werden wir uns gegenseitig \"Schwester\" nennen."

# game/scripts/c18/c18.rpy:1037
translate german c18s001_Erika_a2e6cde6:

    # eri "Antes Kim estaba hablando con Tía Betty y con Kiara. Ya es normal que la llamen \"Tía Betty\", pero es que ha llamado a Kiara \"Tía Kiara\"."
    eri "Zuvor hatte Kim mit Tante Betty und Kiara gesprochen. Normalerweise nennt man sie „Tante Betty“, aber sie nannte Kiara „Tante Kiara“."

# game/scripts/c18/c18.rpy:1038
translate german c18s001_Erika_043f8beb:

    # mc "¿Se nos está yendo de las manos?"
    mc "Geraten wir außer Kontrolle?"

# game/scripts/c18/c18.rpy:1040
translate german c18s001_Erika_821c56f5:

    # eri "No, justo lo contrario. Es fantástico. Cuando mi madre me dijo que íbamos a tener chicas en casa, nunca me podría haber imaginado esto."
    eri "Nein, ganz im Gegenteil. Es ist fantastisch. Als meine Mutter mir sagte, dass wir Mädchen zu Hause bekommen würden, hätte ich mir das niemals vorstellen können."

# game/scripts/c18/c18.rpy:1042
translate german c18s001_Erika_e2977d0a:

    # eri "Si ese test sale positivo... Hope va a tener muchas más tías de lo que podría haber esperado."
    eri "Wenn dieser Test positiv ausfällt... wird Hope viel mehr Tanten haben, als sie jemals erwartet hätte."

# game/scripts/c18/c18.rpy:1043
translate german c18s001_Erika_514c80bf:

    # mc "Seguro que se pelean por cambiarle los pañales. *Risa* Y eso nos dejará tiempo libre para nosotros."
    mc "Wahrscheinlich streiten sie sich darum, wer ihm die Windeln wechseln darf. *lacht* Und das verschafft uns etwas Freizeit."

# game/scripts/c18/c18.rpy:1046
translate german c18s001_Erika_e127d7bd:

    # eri "Eso teniendo en cuenta que alguna de ellas tenga sus propios hijos."
    eri "Das setzt voraus, dass einige von ihnen selbst Kinder haben."

# game/scripts/c18/c18.rpy:1047
translate german c18s001_Erika_036d1fa2:

    # mc "Entonces dejaremos que Meemaw cambie los pañales de todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Dann darf Oma die Windeln wechseln. *lacht* Du weißt doch, dass sie sich Urenkel wünscht."

# game/scripts/c18/c18.rpy:1049
translate german c18s001_Erika_c5327877:

    # eri "Podemos usar la app de Scarlett para que se organicen los turnos de cambio pañales. *Risa*"
    eri "Wir können Scarletts App nutzen, um die Windelwechselzeiten zu organisieren. *lacht*"

# game/scripts/c18/c18.rpy:1050
translate german c18s001_Erika_ac53c2f1:

    # mc "Meemaw va a querer cambiarlos todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Meemaw wird sie alle umtauschen wollen. *lacht* Du weißt doch, dass sie sich Urenkel wünscht."

# game/scripts/c18/c18.rpy:1051
translate german c18s001_Erika_95703ae4:

    # mc "Si los pide, debe tomar responsabilidad sobre ellos."
    mc "Wer sie verlangt, muss auch die Verantwortung dafür übernehmen."

# game/scripts/c18/c18.rpy:1053
translate german c18s001_Erika_c3606cad:

    # eri "Solo de pensar que vamos a tener que decírselo... me da miedo cómo se lo va a tomar. Esté embarazada o no lo esté."
    eri "Allein der Gedanke daran, es ihr sagen zu müssen... Ich habe Angst davor, wie sie reagieren wird. Egal, ob sie schwanger ist oder nicht."

# game/scripts/c18/c18.rpy:1055
translate german c18s001_Erika_99c24a15:

    # mc "Ya sabe que estoy con tu madre. Ladró un poco, pero tuvo que aceptarlo."
    mc "Er weiß schon, dass ich bei deiner Mutter bin. Er hat ein bisschen gebellt, aber er musste es akzeptieren."

# game/scripts/c18/c18.rpy:1057
translate german c18s001_Erika_5e6fedba:

    # eri "¿Qué? ¿Cuándo?"
    eri "Was? Wann?"

# game/scripts/c18/c18.rpy:1059
translate german c18s001_Erika_10043148:

    # mc "Ya sabe que estoy con alguien de la familia. Ladró un poco, pero tuvo que aceptarlo."
    mc "Er weiß schon, dass ich mit einem Familienmitglied zusammen bin. Er hat ein bisschen gebellt, aber er musste es akzeptieren."

# game/scripts/c18/c18.rpy:1062
translate german c18s001_Erika_d08fb9a3:

    # eri "¿Qué? ¿Cuándo? No sabía que a [emm] también se le hubiera escapado con ella."
    eri "Was? Wann? Ich wusste nicht, dass [emm] es ihr gegenüber auch ausgeplaudert hatte."

# game/scripts/c18/c18.rpy:1064
translate german c18s001_Erika_039eb2b1:

    # eri "¿Qué? ¿Cuándo? No voy a preguntar con quién..."
    eri "Was? Wann? Ich werde nicht fragen, mit wem..."

# game/scripts/c18/c18.rpy:1067
translate german c18s001_Erika_320b1b0a:

    # mc "El día que fuimos a la playa para la comida navideña."
    mc "An dem Tag, als wir zum Weihnachtsmittagessen an den Strand fuhren."

# game/scripts/c18/c18.rpy:1069
translate german c18s001_Erika_183071b5:

    # mc "El día que tuvimos la reunión con Aaron, Amanda, y Eva."
    mc "An dem Tag, an dem wir das Treffen mit Aaron, Amanda und Eva hatten."

# game/scripts/c18/c18.rpy:1071
translate german c18s001_Erika_36163494:

    # eri "Entonces creo que estoy preparada para hacerlo público. El martes sería un buen día."
    eri "Ich glaube also, ich bin bereit, es öffentlich zu machen. Dienstag wäre ein guter Tag."

# game/scripts/c18/c18.rpy:1073
translate german c18s001_Erika_68bc9a3f:

    # mc "Sigo pensando que le tenéis demasiado miedo. ¿Qué va a hacer? Ladrar un poco y aceptar lo que es un hecho sobre el que no tiene ningún control."
    mc "Ich glaube immer noch, ihr habt alle zu viel Angst vor ihm. Was soll er denn schon tun? Ein bisschen bellen und die Tatsache akzeptieren, dass er keine Kontrolle darüber hat."

# game/scripts/c18/c18.rpy:1075
translate german c18s001_Erika_5d30da47:

    # eri "Tienes razón. Creo que estoy preparada para hacerlo público. El martes sería un buen día."
    eri "Du hast recht. Ich glaube, ich bin bereit, es öffentlich zu machen. Dienstag wäre ein guter Tag."

# game/scripts/c18/c18.rpy:1076
translate german c18s001_Erika_1c58d10f:

    # eri "Y si ese test sale positivo, soltamos las dos cosas a la vez."
    eri "Und falls dieser Test positiv ausfällt, geben wir beides gleichzeitig frei."

# game/scripts/c18/c18.rpy:1077
translate german c18s001_Erika_84ab91bc:

    # mc "Me parece una buena idea. *Risa* No le habrá dado tiempo de recuperarse de las emociones de los cumpleaños."
    mc "Das klingt nach einer guten Idee. *lacht* Wahrscheinlich hatte sie noch gar keine Zeit, sich von der Geburtstagsaufregung zu erholen."

# game/scripts/c18/c18.rpy:1079
translate german c18s001_Erika_1647a260:

    # eri "Olvida lo del martes..."
    eri "Vergiss den Dienstag..."

# game/scripts/c18/c18.rpy:1080
translate german c18s001_Erika_c5659800:

    # eri "Mejor no pongamos fecha o estaré nerviosa hasta que llegue."
    eri "Lass uns kein Datum festlegen, sonst werde ich nervös, bis es da ist."

# game/scripts/c18/c18.rpy:1081
translate german c18s001_Erika_f85633ad:

    # mc "No hay ningún problema. Solo una pregunta. ¿Se lo quieres decir solo a la familia o a todas las chicas?"
    mc "Kein Problem. Nur eine Frage. Möchtest du es nur deiner Familie erzählen oder allen Mädchen?"

# game/scripts/c18/c18.rpy:1083
translate german c18s001_Erika_1d26f527:

    # eri "A la familia. Y eso incluye a todas las chicas."
    eri "An die Familie. Und dazu gehören auch alle Mädchen."

# game/scripts/c18/c18.rpy:1085
translate german c18s001_Erika_f85d43cd:

    # mc "Hemos ampliado la familia sin darnos cuenta."
    mc "Wir haben unsere Familie vergrößert, ohne es überhaupt zu merken."

# game/scripts/c18/c18.rpy:1086
translate german c18s001_Erika_7f5b4071:

    # eri "Desde luego."
    eri "Natürlich."

# game/scripts/c18/c18.rpy:1088
translate german c18s001_Erika_6a17a408:

    # "Bailáis mientras charláis de cómo la llegada de las estudiantes y de Eva y Amanda ha cambiado vuestras vidas."
    "Ihr tanzt, während ihr darüber plaudert, wie die Ankunft der Schüler und von Eva und Amanda euer Leben verändert hat."

# game/scripts/c18/c18.rpy:1090
translate german c18s001_Erika_e2994fbb:

    # "Suena un móvil."
    "Ein Handy klingelt."

# game/scripts/c18/c18.rpy:1092
translate german c18s001_Erika_35f8cdd2:

    # eri "Mi turno ha acabado. No recuerdo a quién le tocaba ahora."
    eri "Meine Schicht ist vorbei. Ich weiß nicht mehr, wer jetzt dran ist."

# game/scripts/c18/c18.rpy:1093
translate german c18s001_Erika_97ae267e:

    # mc "Dile a quien sea que le toque que me espere. Tengo que ir al lavabo un momento."
    mc "Sag demjenigen, der an der Reihe ist, er soll auf mich warten. Ich muss kurz auf die Toilette."

# game/scripts/c18/c18.rpy:1094
translate german c18s001_Erika_1cb71367:

