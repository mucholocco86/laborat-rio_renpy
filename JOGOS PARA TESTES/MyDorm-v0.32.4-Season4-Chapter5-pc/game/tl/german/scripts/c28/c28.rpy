    sim "Nach dem, was mit [mad.nick] passiert ist, hatte ich erwartet, als Nächster dran zu sein. Ich möchte lieber nicht warten." id c28s003_SimLewd_82d35bc7

# game/scripts/c28/c28.rpy:1248
translate german c28s003_SimLewd_3fa62a19:

