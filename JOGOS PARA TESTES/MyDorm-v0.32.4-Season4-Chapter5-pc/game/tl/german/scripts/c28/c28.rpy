    mc "Einfach nur schlafen?"

# game/scripts/c28/c28.rpy:1211
translate german c28s003_SimLewd_d476434c:

    # "La chica no contesta. Al menos no con palabras, aunque sus labios no se mantienen cerrados durante mucho tiempo."
    "Das Mädchen antwortet nicht. Zumindest nicht mit Worten, obwohl ihre Lippen nicht lange geschlossen bleiben."

