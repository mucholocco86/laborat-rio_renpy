    # mc "Creo que me estoy volviendo demasiado previsible. *Risa*"
    mc "Ich glaube, ich werde zu berechenbar. *lacht*"

# game/scripts/c28/c28.rpy:1936
translate german c28s004_ScaGetsJob_76d00537:

    # dap "¿Con un dónut? Es un poco cutre, ¿no?"
    dap "Mit einem Donut? Das ist doch etwas geschmacklos, oder?"

# game/scripts/c28/c28.rpy:1938
translate german c28s004_ScaGetsJob_8e18d505:

    # sca "No le hagas caso. Yo creo que es super dulce."
    sca "Beachte ihn nicht. Ich finde ihn total lieb."

# game/scripts/c28/c28.rpy:1939
translate german c28s004_ScaGetsJob_8227305e:

    # sca "¡Felicidades! Supongo que ha dicho que sí, viendo su reacción con el dónut."
    sca "Herzlichen Glückwunsch! Wenn man ihre Reaktion auf den Donut betrachtet, nehme ich an, sie hat Ja gesagt."

# game/scripts/c28/c28.rpy:1940
translate german c28s004_ScaGetsJob_1eaf07be:

    # mc "Sí, ha dicho que sí."
    mc "Ja, sie hat Ja gesagt."

# game/scripts/c28/c28.rpy:1942
translate german c28s004_ScaGetsJob_4fc35d44:

    # dap "*Risa* Yo creía que Tía [mar] era la lista de la familia."
    dap "*Lacht* Ich dachte, Tante [mar] wäre die Kluge in der Familie."

# game/scripts/c28/c28.rpy:1944
translate german c28s004_ScaGetsJob_bc779088:

    # mc "*Risa* Supongo que eso quiere decir que no quieres que te lo pida a ti cuando tenga la ocasión."
    mc "*Lacht* Ich nehme an, das bedeutet, dass du nicht willst, dass ich dich frage, wenn ich die Gelegenheit dazu habe."

# game/scripts/c28/c28.rpy:1946
translate german c28s004_ScaGetsJob_215596e5:

    # dap "*Risa* Si soy la única a la que no se lo pides, tu personaje de DnD tendrá una vida muuuuy corta."
    dap "*Lacht* Wenn ich der Einzige bin, den du nicht fragst, wird dein D&D-Charakter ein sehr kurzes Leben haben."

# game/scripts/c28/c28.rpy:1947
translate german c28s004_ScaGetsJob_6b29ff29:

    # dap "Ya sabes... un rayo que cae en tu saco de dormir, una caída que acaba con tu propia daga en tu garganta... Esas cosas que pasan cuando no le pides matrimonio al DM..."
    dap "Du weißt schon... wenn der Blitz in deinen Schlafsack einschlägt, wenn du stürzt und dir dein eigener Dolch an die Kehle hältst... Solche Dinge passieren, wenn man dem Spielleiter keinen Heiratsantrag macht..."

# game/scripts/c28/c28.rpy:1949
translate german c28s004_ScaGetsJob_0c9c70d0:

    # mc "*Risa* Precisamente porque es la lista de la familia es por lo que ha aceptado."
    mc "*Gelächter* Genau weil es die Familienliste ist, hat sie zugesagt."

# game/scripts/c28/c28.rpy:1950
translate german c28s004_ScaGetsJob_8b79702b:

    # dap "Felicidades a los dos."
    dap "Herzlichen Glückwunsch euch beiden."

# game/scripts/c28/c28.rpy:1953
translate german c28s004_ScaGetsJob_853b8c27:

    # sca "Pero, después de lo de [mad.nick] yo creía que..."
    sca "Aber nach dem, was mit [mad.nick] passiert ist, dachte ich, dass..."

# game/scripts/c28/c28.rpy:1955
translate german c28s004_ScaGetsJob_3a22d173:

    # mar "¡Hush!" (multiple=2)
    mar "Stille!" (multiple=2)

# game/scripts/c28/c28.rpy:1956
translate german c28s004_ScaGetsJob_cd09f94e:

    # dap "¡[sca]!" (multiple=2)
    dap "[sca]!" (multiple=2)

# game/scripts/c28/c28.rpy:1958
translate german c28s004_ScaGetsJob_87511055:

    # sca "¡Oops! Perdón..."
    sca "Ups! Entschuldigung..."

# game/scripts/c28/c28.rpy:1959
translate german c28s004_ScaGetsJob_3b916da8:

    # mc "¿Qué pasa?"
    mc "Was passiert?"

# game/scripts/c28/c28.rpy:1961
translate german c28s004_ScaGetsJob_cc10cf6f:

    # todas "Nada, nada. No te preocupes."
    todas "Nichts, gar nichts. Keine Sorge."

# game/scripts/c28/c28.rpy:1962
translate german c28s004_ScaGetsJob_e3d0f55a:

    # mc "*Risa* Eso casi me preocupa más que si no hubierais dicho nada."
    mc "*Lacht* Das beunruhigt mich fast mehr, als wenn du gar nichts gesagt hättest."

# game/scripts/c28/c28.rpy:1963
translate german c28s004_ScaGetsJob_6a3745ed:

    # mc "Pero supongo que no os voy a sacar ninguna información."
    mc "Aber ich nehme an, ich werde von Ihnen keine Informationen erhalten."

# game/scripts/c28/c28.rpy:1964
translate german c28s004_ScaGetsJob_3b1f156c:

    # todas "Ni una palabra."
    todas "Kein Wort."

# game/scripts/c28/c28.rpy:1967
translate german c28s004_ScaGetsJob_40a14f2d:

    # mom "Sí, coge los que quieras."
    mom "Ja, nimm so viele, wie du möchtest."

# game/scripts/c28/c28.rpy:1969
translate german c28s004_ScaGetsJob_02533cd2:

    # mc "Por cierto, ¿por qué vais disfrazadas?"
    mc "Übrigens, warum seid ihr alle verkleidet?"

# game/scripts/c28/c28.rpy:1970
translate german c28s004_ScaGetsJob_dc53d40d:

    # dap "Nos estábamos probando ropa cuando [sca] ha recibido la llamada." id c28s004_ScaGetsJob_dc53d40d
    dap "Wir waren gerade dabei, Kleidung anzuprobieren, als [sca] den Anruf erhielt." id c28s004_ScaGetsJob_dc53d40d

# game/scripts/c28/c28.rpy:1971
translate german c28s004_ScaGetsJob_cc1dd83f:

    # sca "Queríamos hacer unas fotos de cosplay para subirlas a InstaPic."
    sca "Wir wollten ein paar Cosplay-Fotos machen, um sie auf InstaPic hochzuladen."

# game/scripts/c28/c28.rpy:1974
translate german c28s004_ScaGetsJob_df0910b6:

    # "Después de eso, pasáis un rato charlando de la propuesta de matrimonio y del trabajo de [sca]."
    "Danach unterhält man sich eine Weile über den Heiratsantrag und [sca]s Job."

# game/scripts/c28/c28.rpy:1976
translate german c28s004_ScaGetsJob_018726bd:

    # "Obviamente, lo que fuera a escapársele a [sca] no vuelve a hacer su aparición en la conversación."
    "Offensichtlich taucht das, was [sca] ausgelassen hat, nicht wieder in der Konversation auf."

# game/scripts/c28/c28.rpy:1978
translate german c28s004_ScaGetsJob_5dc0265d:

    # "Pasáis un rato charlando del trabajo de [sca], intentando sin éxito quitarle los nervios."
    "Sie unterhalten sich eine Weile über die Arbeit von [sca] und versuchen dabei vergeblich, ihn zu beruhigen."

# game/scripts/c28/c28.rpy:1979
translate german c28s004_ScaGetsJob_9327230f:

    # "Al cabo de un rato las chicas deciden seguir visitando a todo el mundo para dar la noticia. Hay una nueva camarera en la familia."
    "Nach einiger Zeit beschließen die Mädchen, weiterhin alle zu besuchen, um die Neuigkeiten zu verkünden. Es gibt eine neue Kellnerin in der Familie."

# game/scripts/c28/c28.rpy:1982
translate german c28s004_ScaGetsJob_3431064b:

    # "Tú vuelves a tu habitación. Estás seguro de que Aaron te habrá mandado dos o tres correos a estas horas."
    "Du gehst zurück in dein Zimmer. Du bist dir sicher, dass Aaron dir inzwischen zwei oder drei E-Mails geschickt hat."

# game/scripts/c28/c28.rpy:1997
translate german c28s004_DebKiaraTalk_7d80596c:

    # kia "Ahora te busco ese libro. Me extraña que no tengan las memorias de Dana Torres en la universidad."
    kia "Ich werde für dich nach dem Buch suchen. Es wundert mich, dass die Memoiren von Dana Torres nicht an der Universität verfügbar sind."

# game/scripts/c28/c28.rpy:1998
translate german c28s004_DebKiaraTalk_5914091b:

    # deb "No es que no lo tengan. Es que solo tienen un ejemplar y alguien lo ha cogido justo hoy."
    deb "Es ist nicht so, dass sie es nicht hätten. Es ist vielmehr so, dass sie nur ein Exemplar besitzen, und jemand hat es erst heute in die Hände bekommen."

# game/scripts/c28/c28.rpy:1999
translate german c28s004_DebKiaraTalk_985b03a9:

    # deb "Tengo ganas de leerlo y no quiero esperar a que lo devuelvan."
    deb "Ich freue mich darauf, es zu lesen, und möchte nicht auf die Rückgabe warten."

# game/scripts/c28/c28.rpy:2001
translate german c28s004_DebKiaraTalk_cfb21edb:

    # kia "¿Por eso has pensado en mí?"
    kia "Ist das der Grund, warum du an mich gedacht hast?"

# game/scripts/c28/c28.rpy:2002
translate german c28s004_DebKiaraTalk_ce20af47:

    # kia "*Risa* Solo me quieres por mis libros..."
    kia "*lacht* Du willst mich nur wegen meiner Bücher..."

# game/scripts/c28/c28.rpy:2004
translate german c28s004_DebKiaraTalk_f99561bb:

    # deb "*Risa* Sabes que no es verdad. Te quiero por muchas más cosas. Pero adoro tus libros y que nos podamos sentar en la piscina a hablar de ellos."
    deb "*Lacht* Du weißt, dass das nicht stimmt. Ich liebe dich für so vieles mehr. Aber ich liebe deine Bücher und es ist toll, dass wir am Pool sitzen und darüber reden können."

# game/scripts/c28/c28.rpy:2005
translate german c28s004_DebKiaraTalk_d974cf2b:

    # deb "No hay mucha gente en casa con quien hablar de algunos libros."
    deb "Es gibt nicht viele Leute zu Hause, mit denen ich über manche Bücher sprechen kann."

# game/scripts/c28/c28.rpy:2007
translate german c28s004_DebKiaraTalk_9dfce8ea:

    # kia "Tienes razón. No hay muchos fans de Jane Austen en casa."
    kia "Du hast recht. Es gibt nicht viele Jane-Austen-Fans zu Hause."

# game/scripts/c28/c28.rpy:2008
translate german c28s004_DebKiaraTalk_a70f3e8e:

    # kia "¿Quieres llevarte algún libro más?"
    kia "Möchten Sie noch weitere Bücher mitnehmen?"

# game/scripts/c28/c28.rpy:2010
translate german c28s004_DebKiaraTalk_dd8e9a89:

    # deb "Sí. Mira a ver si tenéis '¿Por qué Tía [kia] no nos ha dicho que ayer fue su cumpleaños?'"
    deb "Ja. Schau mal, ob du die Frage „Warum hat Tante [kia] uns nicht gesagt, dass gestern ihr Geburtstag war?“ hast."

# game/scripts/c28/c28.rpy:2011
translate german c28s004_DebKiaraTalk_30c9a8e8:

    # deb "Dicen que es un clásico sobre la gente que cree que no tiene nada que celebrar."
    deb "Man sagt, es sei ein Klassiker über Menschen, die meinen, sie hätten nichts zu feiern."

# game/scripts/c28/c28.rpy:2013
translate german c28s004_DebKiaraTalk_f184a36d:

    # kia "¿Me vas a echar la bronca por no celebrar mi cumpleaños?"
    kia "Wirst du mich etwa dafür ausschimpfen, dass ich meinen Geburtstag nicht gefeiert habe?"

# game/scripts/c28/c28.rpy:2015
translate german c28s004_DebKiaraTalk_e58d1bf5:

    # deb "Esa era una de mis ideas cuando venía hacia aquí. [eil] nos lo ha dicho esta mañana."
    deb "Das war einer meiner Gedanken auf dem Weg hierher. [eil] hat uns das heute Morgen erzählt."

# game/scripts/c28/c28.rpy:2016
translate german c28s004_DebKiaraTalk_b0572988:

    # deb "Primero le hemos echado la bronca a ella por no decírnoslo antes para prepararte una fiesta sorpresa."
    deb "Zuerst haben wir sie ausgeschimpft, weil sie uns nicht früher Bescheid gesagt hat, damit wir eine Überraschungsparty für dich vorbereiten konnten."

# game/scripts/c28/c28.rpy:2018
translate german c28s004_DebKiaraTalk_9f0693f3:

    # kia "No me gustan las fiestas sorpresa, y no me gusta celebrar mi cumpleaños."
    kia "Ich mag keine Überraschungspartys und ich feiere meinen Geburtstag auch nicht gern."

# game/scripts/c28/c28.rpy:2019
translate german c28s004_DebKiaraTalk_cf466563:

    # kia "Con lo que es mejor que [eil] os lo haya dicho cuando ya ha pasado. De todas formas, le echaré bronca por decíroslo." id c28s004_DebKiaraTalk_cf466563
    kia "Es ist also besser, dass [eil] es dir erst nach dem Vorfall erzählt hat. Jedenfalls werde ich ihm meine Meinung dazu sagen, weil er es dir erzählt hat." id c28s004_DebKiaraTalk_cf466563

# game/scripts/c28/c28.rpy:2021
translate german c28s004_DebKiaraTalk_442ec956:

    # deb "Se le ha escapado. Estábamos tomando el sol y [sca] ha venido preguntando las fechas de nacimiento."
    deb "Es ist uns rausgerutscht. Wir haben uns gerade gesonnt und [sca] kam und fragte nach Geburtsdaten."

# game/scripts/c28/c28.rpy:2022
translate german c28s004_DebKiaraTalk_4c09976b:

    # deb "Quiere hacer algo con una app para que no se nos olvide nunca felicitarnos entre nosotras."
    deb "Sie möchte mit einer App etwas entwickeln, damit wir nie vergessen, uns gegenseitig zu gratulieren."

# game/scripts/c28/c28.rpy:2023
translate german c28s004_DebKiaraTalk_411d97f9:

    # deb "[eil] ha dicho su fecha de nacimiento y la tuya. Todas hemos flipado cuando nos hemos dado cuenta de que tu cumpleaños fue ayer."
    deb "[eil] nannte ihr und dein Geburtsdatum. Wir waren alle geschockt, als wir merkten, dass du gestern Geburtstag hattest."

# game/scripts/c28/c28.rpy:2025
translate german c28s004_DebKiaraTalk_1adbd33d:

    # kia "¿[eil] no os ha dicho por qué no lo celebro?"
    kia "[eil] Hat er dir nicht gesagt, warum ich nicht feiere?"

# game/scripts/c28/c28.rpy:2027
translate german c28s004_DebKiaraTalk_3602b04a:

    # deb "Nos ha dicho que no te gusta hacerlo, pero no nos ha querido contar por qué." id c28s004_DebKiaraTalk_3602b04a
    deb "Sie sagte uns, dass sie es nicht gerne macht, wollte uns aber nicht sagen, warum." id c28s004_DebKiaraTalk_3602b04a

# game/scripts/c28/c28.rpy:2029
translate german c28s004_DebKiaraTalk_58e825de:

    # kia "Mis cumpleaños dejaron de ser importantes cuando nació ella. No porque naciera ella, claro."
    kia "Meine Geburtstage verloren an Bedeutung, als sie geboren wurde. Nicht etwa, weil sie geboren wurde, natürlich."

# game/scripts/c28/c28.rpy:2030
translate german c28s004_DebKiaraTalk_4d5b1087:

    # kia "Pero es cuando todo se empezó a ir a la mierda con Solomon."
    kia "Aber genau da fing alles an, mit Solomon den Bach runterzugehen."

# game/scripts/c28/c28.rpy:2032
translate german c28s004_DebKiaraTalk_5dd4bae7:

    # kia "Cada vez tenía menos ganas de celebrar nada que no tuviera que ver directamente con [eil]."
    kia "Ich war zunehmend weniger geneigt, irgendetwas zu feiern, was nicht in direktem Zusammenhang mit [eil] stand."

# game/scripts/c28/c28.rpy:2033
translate german c28s004_DebKiaraTalk_4f89a79a:

    # kia "Ella no tenía que pagar las consecuencias de un matrimonio infeliz."
    kia "Sie musste nicht die Folgen einer unglücklichen Ehe tragen."

# game/scripts/c28/c28.rpy:2035
translate german c28s004_DebKiaraTalk_df9c82cd:

    # kia "Y celebrar mi cumpleaños era un recordatorio de que... no sé..."
    kia "Und die Feier meines Geburtstags erinnerte mich daran, dass... ich weiß nicht..."

# game/scripts/c28/c28.rpy:2036
translate german c28s004_DebKiaraTalk_afea7ea1:

    # kia "Cuando Solomon empezó a olvidarlos casi me alegré. Se convirtió en una costumbre no celebrarlos. Porque no había nada que celebrar."
    kia "Als Salomo anfing, sie zu vergessen, war ich fast froh. Es wurde zur Gewohnheit, sie nicht mehr zu feiern. Denn es gab nichts zu feiern."

# game/scripts/c28/c28.rpy:2038
translate german c28s004_DebKiaraTalk_54288c34:

    # deb "Pero ahora Solomon no está, con lo que sería un buen momento para volver a celebrarlos."
    deb "Aber nun ist Salomo nicht mehr da, daher wäre es ein guter Zeitpunkt, sie noch einmal zu feiern."

# game/scripts/c28/c28.rpy:2039
translate german c28s004_DebKiaraTalk_925d495a:

    # deb "No te vas a librar. Recuerda lo bien que estuvo la fiesta de las chicas."
    deb "So kommst du nicht damit durch. Erinnerst du dich noch, wie toll die Mädelsparty war?"

# game/scripts/c28/c28.rpy:2041
translate german c28s004_DebKiaraTalk_096eee75:

    # kia "*Risa* Ellas cumplían 19. ¡Yo cumpliré 48 en mi próximo cumpleaños!"
    kia "*Lacht* Sie wurden 19. Ich werde an meinem nächsten Geburtstag 48!"

# game/scripts/c28/c28.rpy:2042
translate german c28s004_DebKiaraTalk_96c2dd60:

    # kia "*Risa* No creo que sea algo para celebrar."
    kia "*Lacht* Ich glaube nicht, dass das etwas zum Feiern ist."

# game/scripts/c28/c28.rpy:2045
translate german c28s004_DebKiaraTalk_448f7aea:

    # deb "Pues celebremos el primer año sin Solomon el día de tu cumpleaños."
    deb "Lasst uns also an deinem Geburtstag das erste Jahr ohne Salomo feiern."

# game/scripts/c28/c28.rpy:2047
translate german c28s004_DebKiaraTalk_3e9bea39:

    # deb "Y tu primer año con [mc]."
    deb "Und dein erstes Jahr bei [mc]."

# game/scripts/c28/c28.rpy:2048
translate german c28s004_DebKiaraTalk_ca4e1fb3:

    # deb "Al menos así no coincidirá con el cumpleaños de las chicas. Y si no quieres, te haremos una fiesta sorpresa."
    deb "So fällt es wenigstens nicht mit dem Geburtstag der Mädchen zusammen. Und wenn ihr das nicht wollt, organisieren wir euch eine Überraschungsparty."

# game/scripts/c28/c28.rpy:2050
translate german c28s004_DebKiaraTalk_90b2d3df:

    # kia "*Risa* Las fiestas sorpresa las odiaba antes de conocer a Solomon. Ni se os ocurra hacerme una si no queréis verme enfadada de verdad."
    kia "*Lacht* Bevor ich Solomon kennengelernt habe, habe ich Überraschungspartys gehasst. Denk gar nicht erst daran, eine für mich zu veranstalten, wenn du mich nicht richtig wütend erleben willst."

# game/scripts/c28/c28.rpy:2051
translate german c28s004_DebKiaraTalk_0e83532a:

    # kia "Voy a buscarte ese libro antes de que llegue más gente."
    kia "Ich besorge dir das Buch, bevor noch mehr Leute eintreffen."

# game/scripts/c28/c28.rpy:2053
translate german c28s004_DebKiaraTalk_5a865f4a:

    # deb "*Escribiendo en el grupo de WhatsUp 'Fiesta sorpresa para [kia]'* Chicas, fiesta sorpresa de mañana anulada. Parece que realmente no le gustan." id c28s004_DebKiaraTalk_5a865f4a
    deb "*Schreibt in der WhatsApp-Gruppe „Überraschungsparty für [kia]“* Mädels, die morgige Überraschungsparty fällt aus. Anscheinend mag sie die beiden wirklich nicht." id c28s004_DebKiaraTalk_5a865f4a

# game/scripts/c28/c28.rpy:2054
translate german c28s004_DebKiaraTalk_867f7d97:

    # eil "*En el grupo de WhatsUp* Os lo he dicho. Sé cómo es mi madre..."
    eil "*In der WhatsApp-Gruppe* habe ich es dir ja erzählt. Ich weiß, wie meine Mutter so ist..."

# game/scripts/c28/c28.rpy:2055
translate german c28s004_DebKiaraTalk_35a5a348:

    # sca "*En el grupo de WhatsUp* Mañana preguntaré en el grupo general a quién le gustan las fiestas sorpresa. Así [kia] puede decir que a ella no."
    sca "*In der WhatsApp-Gruppe* Morgen frage ich in der allgemeinen Gruppe, wer Überraschungspartys mag. Dann kann [kia] sagen, dass sie keine mag."

# game/scripts/c28/c28.rpy:2056
translate german c28s004_DebKiaraTalk_6b349194:

    # sca "*En el grupo de WhatsUp* Lo añadiré a la ficha de cada una en la app."
    sca "*In der WhatsApp-Gruppe* werde ich es jedem Profil in der App hinzufügen."

# game/scripts/c28/c28.rpy:2057
translate german c28s004_DebKiaraTalk_3a6fe0b3:

    # sai "*En el grupo de WhatsUp* Eso le quitará algo de sorpresa a las fiestas. Pero puedes apuntar que a mí no me desagradan."
    sai "*In der WhatsApp-Gruppe* Das nimmt den Partys etwas von ihrem Überraschungseffekt. Du kannst aber erwähnen, dass sie mir nichts ausmachen."

# game/scripts/c28/c28.rpy:2061
translate german c28s004_DebKiaraTalk_172f8095:

    # "Un par de minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c28/c28.rpy:2062
translate german c28s004_DebKiaraTalk_e304f6eb:

    # kia "Aquí tienes el libro. ¿Necesitas alguna cosa más?"
    kia "Hier ist das Buch. Brauchen Sie sonst noch etwas?"

# game/scripts/c28/c28.rpy:2065
translate german c28s004_DebKiaraTalk_f5e21b63:

    # deb "Como tu fuiste la primera..."
    deb "Da du der Erste warst..."

# game/scripts/c28/c28.rpy:2066
translate german c28s004_DebKiaraTalk_e30e4f8e:

    # deb "¿Quería preguntarte qué te parece la idea de [mad.nick] sobre los anillos?"
    deb "Ich wollte Sie fragen, was Sie von [mad.nick]s Idee bezüglich der Ringe halten?"

# game/scripts/c28/c28.rpy:2067
translate german c28s004_DebKiaraTalk_22c689f3:

    # deb "Creo que resolvería el problema del que se estuvo hablando el otro día en el grupo de WhatsUp."
    deb "Ich glaube, das würde das Problem lösen, das neulich in der WhatsApp-Gruppe besprochen wurde."

# game/scripts/c28/c28.rpy:2069
translate german c28s004_DebKiaraTalk_9a1ce82b:

    # kia "A mí me parece una idea buenísima. Ponerse de acuerdo iba a ser muy difícil."
    kia "Ich finde das eine großartige Idee. Eine Einigung zu erzielen, wäre sehr schwierig gewesen."

# game/scripts/c28/c28.rpy:2071
translate german c28s004_DebKiaraTalk_61e819b4:

    # kia "Yo ya tengo mi anillo y tenía pensado hacer uno de verdad con la misma forma, pero..."
    kia "Ich besitze bereits meinen Ring und hatte vor, einen echten in der gleichen Form anfertigen zu lassen, aber..."

# game/scripts/c28/c28.rpy:2073
translate german c28s004_DebKiaraTalk_2a02b7ca:

    # deb "Yo creo que iba a ser imposible ponerse de acuerdo."
    deb "Ich glaube, es wäre unmöglich gewesen, eine Einigung zu erzielen."

# game/scripts/c28/c28.rpy:2074
translate german c28s004_DebKiaraTalk_7d8483cc:

    # deb "Ya sabes, diferentes gustos y diferentes expectativas..."
    deb "Sie wissen ja, unterschiedliche Geschmäcker und unterschiedliche Erwartungen..."

# game/scripts/c28/c28.rpy:2077
translate german c28s004_DebKiaraTalk_04241428:

    # kia "Y después de lo de [mar] de hoy... Creo que no se puede ser más original."
    kia "Und nach dem, was heute mit [mar] passiert ist... ich glaube nicht, dass es noch origineller geht."

# game/scripts/c28/c28.rpy:2078
translate german c28s004_DebKiaraTalk_3cb371e4:

    # kia "Ya me dirás tú dónde podría encontrar [mar] un anillo con forma de dónut."
    kia "Sag mir, wo ich einen ringförmigen Donut finden könnte."

# game/scripts/c28/c28.rpy:2079
translate german c28s004_DebKiaraTalk_8ea7861b:

    # kia "Además, creo que lo de [mad.nick] con el post-it es casi insuperable."
    kia "Außerdem halte ich den Post-it-Zettel-Trick von [mad.nick] für nahezu unschlagbar."

# game/scripts/c28/c28.rpy:2081
translate german c28s004_DebKiaraTalk_dc185753:

    # deb "La verdad es que ya empiezo a tener ganas de que llegue el día..."
    deb "Ehrlich gesagt freue ich mich schon jetzt auf den Tag..."

# game/scripts/c28/c28.rpy:2083
translate german c28s004_DebKiaraTalk_ee7f31df:

    # deb "Aunque no vaya a participar, me encantaría estar ahí cuando suceda."
    deb "Auch wenn ich nicht teilnehmen werde, wäre ich sehr gerne dabei, wenn es soweit ist."

# game/scripts/c28/c28.rpy:2085
translate german c28s004_DebKiaraTalk_5ea0d84c:

    # kia "[mad.nick] decía que no hay demasiada prisa, pero creo tampoco hay demasiado tiempo."
    kia "[mad.nick] Ich sagte, es sei nicht allzu eilig, aber ich glaube auch nicht, dass zu viel Zeit bleibt."

# game/scripts/c28/c28.rpy:2086
translate german c28s004_DebKiaraTalk_1926dc87:

    # kia "La semana que viene se irá a Aruba, y la idea de [mad.nick] era para hacerla antes de que se fuera."
    kia "Nächste Woche fährt sie nach Aruba, und die Idee von [mad.nick] war, das vor ihrer Abreise zu erledigen."

# game/scripts/c28/c28.rpy:2088
translate german c28s004_DebKiaraTalk_39b5cd68:

    # kia "Las chicas van a tener que darse prisa."
    kia "Die Mädchen müssen sich beeilen."

# game/scripts/c28/c28.rpy:2090
translate german c28s004_DebKiaraTalk_f2160220:

    # kia "Vais a tener que daros un poco de prisa."
    kia "Du musst dich etwas beeilen."

# game/scripts/c28/c28.rpy:2092
translate german c28s004_DebKiaraTalk_afa0faa9:

    # kia "Vamos a tener que darnos prisa."
    kia "Wir müssen uns beeilen."

# game/scripts/c28/c28.rpy:2095
translate german c28s004_DebKiaraTalk_119b056a:

    # deb "Hay que esperar a que vuelvan las Chicas de Oro. No se puede hacer nada antes de que regresen."
    deb "Wir müssen auf die Rückkehr der Golden Girls warten. Bis dahin können wir nichts tun."

# game/scripts/c28/c28.rpy:2097
translate german c28s004_DebKiaraTalk_9f569263:

    # deb "Aunque las Chicas de Oro no estén implicadas, creo que habría que esperar a que estén aquí para hacerlo."
    deb "Auch wenn die Golden Girls nicht dabei sind, sollten wir meiner Meinung nach warten, bis sie da sind, um es zu tun."

# game/scripts/c28/c28.rpy:2099
translate german c28s004_DebKiaraTalk_400f1ae5:

    # deb "Y [meg] tendrá que venir también... Tienes razón, no hay muchos días en que lo podamos hacer..."
    deb "Und [meg] muss auch kommen... Du hast recht, es gibt nicht viele Tage, an denen wir das machen können..."

# game/scripts/c28/c28.rpy:2101
translate german c28s004_DebKiaraTalk_310db826:

    # "Las dos mujeres continúan charlando un rato, haciendo planes sobre la idea de [mad.nick]."
    "Die beiden Frauen unterhalten sich noch eine Weile und schmieden Pläne bezüglich der Idee von [mad.nick]."

# game/scripts/c28/c28.rpy:2102
translate german c28s004_DebKiaraTalk_353533ed:

    # "¿Quién podía pensar que un post-it cambiaría el futuro de la familia?"
    "Wer hätte ahnen können, dass ein Post-it-Zettel die Zukunft der Familie verändern würde?"

# game/scripts/c28/c28.rpy:2112
translate german c28s005_EriNor_64380619:

    # "Pasas toda la mañana leyendo los informes de Aaron. Te inunda con tanta información que te sientes sobrepasado."
    "Du verbringst den ganzen Vormittag damit, Aarons Berichte zu lesen. Er überhäuft dich mit so vielen Informationen, dass du dich völlig überfordert fühlst."

# game/scripts/c28/c28.rpy:2114
translate german c28s005_EriNor_079208aa:

    # "Desde informes financieros, pasando por listas de compras e inventarios, a los informes detallados de todas las misiones que NTR ha hecho en los últimos años."
    "Von Finanzberichten über Einkaufslisten und Inventarlisten bis hin zu detaillierten Berichten über alle Missionen, die NTR in den letzten Jahren durchgeführt hat."

# game/scripts/c28/c28.rpy:2115
translate german c28s005_EriNor_c87d3bcf:

    # "Te detienes especialmente en los informes de las misiones que han hecho [eva] y [ama], sorprendiéndote por las muchas cosas que han hecho."
    "Du verweilst besonders bei den Einsatzberichten, die [eva] und [ama] verfasst haben, und bist überrascht von der Vielzahl der Dinge, die sie getan haben."

# game/scripts/c28/c28.rpy:2116
translate german c28s005_EriNor_cd3ff40a:

    # "También lees los informes de las misiones de Beatrice, Claire, y Diana. Es una forma de saber más sobre las chicas que nunca conocerás. No hay informes sobre Fiona."
    "Du liest auch die Missionsberichte von Beatrice, Claire und Diana. So erfährst du mehr über die Mädchen, die du nie kennenlernen wirst. Über Fiona gibt es keine Berichte."

# game/scripts/c28/c28.rpy:2117
translate german c28s005_EriNor_efc585b4:

    # "Hay muchos informes que descartas o lees tan solo por encima. No crees que tu trabajo como CEO incluya saber cuántos rollos de papel higiénico se gastan mensualmente en la base."
    "Es gibt viele Berichte, die Sie ignorieren oder nur überfliegen. Sie glauben nicht, dass es zu Ihren Aufgaben als CEO gehört, zu wissen, wie viele Rollen Toilettenpapier monatlich auf dem Stützpunkt verbraucht werden."

# game/scripts/c28/c28.rpy:2118
translate german c28s005_EriNor_0795de50:

    # "Tienes que decirle a Aaron que sólo te envíe la documentación relevante o no vas a poder leerlo todo antes de ir a Aruba."
    "Sie müssen Aaron bitten, Ihnen nur die relevanten Unterlagen zuzusenden, sonst können Sie diese nicht vollständig lesen, bevor Sie zu Aruba fahren."

# game/scripts/c28/c28.rpy:2119
translate german c28s005_EriNor_e38938f9:

    # "Después de comer, encuentras un informe financiero que llama tu atención. No acabas de entenderlo y decides ir a consultarlo con [nor]."
    "Nach dem Mittagessen stoßen Sie auf einen Finanzbericht, der Ihre Aufmerksamkeit erregt. Sie verstehen ihn nicht ganz und beschließen, sich mit [nor] zu beraten."

# game/scripts/c28/c28.rpy:2120
translate german c28s005_EriNor_109f06c6:

    # "Desde el desayuno solo has salido de tu habitación para comer. Ir a ver a [nor] servirá para despejar la cabeza después de tantas horas leyendo documentación."
    "Seit dem Frühstück haben Sie Ihr Zimmer nur zum Essen verlassen. Ein Besuch im [nor] wird Ihnen helfen, nach so vielen Stunden des Dokumentenlesens den Kopf freizubekommen."

# game/scripts/c28/c28.rpy:2162
translate german c28s005_EriNor_110e5f73:

    # "Al llegar a la cocina de [nor]..."
    "Bei Ankunft in der Küche von [nor]..."

# game/scripts/c28/c28.rpy:2164
translate german c28s005_EriNor_49426654:

    # eri "¡Esta es preciosa!"
    eri "Das ist wunderschön!"

# game/scripts/c28/c28.rpy:2165
translate german c28s005_EriNor_f8b7ead8:

    # nor "Todas lo son. *Risa* Parece que en la universidad hicieron un cásting para enviarnos a las chicas más guapas."
    nor "Das sind sie alle. *lacht* Es scheint, als hätte die Uni ein Casting veranstaltet, um uns die hübschesten Mädchen zu schicken."

# game/scripts/c28/c28.rpy:2167
translate german c28s005_EriNor_9d725932:

    # eri "*Risa* Tienes razón."
    eri "*Lacht* Du hast Recht."

# game/scripts/c28/c28.rpy:2168
translate german c28s005_EriNor_1a3670eb:

    # nor "Aunque las más guapas ya estaban aquí. Nadie supera a mis dos niñas."
    nor "Obwohl die schönsten schon da waren. Niemand kann meine beiden Mädchen übertreffen."

# game/scripts/c28/c28.rpy:2169
translate german c28s005_EriNor_7612ebb8:

    # eri "*Risa* ¡Mamá!"
    eri "*Lachen* Mama!"

# game/scripts/c28/c28.rpy:2170
translate german c28s005_EriNor_4a194945:

    # mc "Hola, chicas. ¿Qué hacéis?"
    mc "Hey Mädels. Was macht ihr so?"

# game/scripts/c28/c28.rpy:2172
translate german c28s005_EriNor_23475f52:

    # nor "Hola, [mc]. Han llegado las fotos de las nuevas estudiantes."
    nor "Hallo, [mc]. Die Fotos der neuen Schüler sind angekommen."

# game/scripts/c28/c28.rpy:2173
translate german c28s005_EriNor_f47010ba:

    # mc "¿Para los expedientes? Ya teníamos esas fotos, ¿no?"
    mc "Für die Dateien? Die Fotos hatten wir doch schon, oder?"

# game/scripts/c28/c28.rpy:2175
translate german c28s005_EriNor_d929966e:

    # mc "Vi la foto de [pat]..."
    mc "Ich habe das Foto von [pat] gesehen..."

# game/scripts/c28/c28.rpy:2176
translate german c28s005_EriNor_b984b454:

    # eri "No, ha sido una idea que ha tenido [kal.nick], la prima de [sai]. Debían hacerse una foto a la vez, estuvieran donde estuvieran." id c28s005_EriNor_b984b454
    eri "Nein, es war die Idee von [kal.nick], dem Cousin von [sai]. Sie mussten unbedingt gleichzeitig ein Foto machen, egal wo sie gerade waren." id c28s005_EriNor_b984b454

# game/scripts/c28/c28.rpy:2177
translate german c28s005_EriNor_de5b68b9:

    # mc "*Risa* Espero que no hubiera ninguna en el lavabo."
    mc "*lacht* Hoffentlich waren keine im Spülbecken."

# game/scripts/c28/c28.rpy:2180
translate german c28s005_EriNor_7df73a03:

    # nor "*Risa* ¡Qué bruto eres! Supongo que, en ese caso, la hubieran enviado más tarde."
    nor "*Lacht* Du bist so begriffsstutzig! Ich nehme an, in dem Fall hätten sie es später geschickt."

# game/scripts/c28/c28.rpy:2181
translate german c28s005_EriNor_852f820d:

    # nor "No creo que una foto sentada en el retrete sea la mejor presentación, pero con las chicas jóvenes nunca lo puedes saber."
    nor "Ich glaube nicht, dass ein Foto von ihr auf der Toilette die beste Art ist, sich zu präsentieren, aber bei jungen Mädchen kann man sich nie sicher sein."

# game/scripts/c28/c28.rpy:2183
translate german c28s005_EriNor_63423b12:

    # eri "¡Mamá! ¡No todas nos tomamos fotos cada vez que respiramos!"
    eri "Mama! Nicht jeder von uns macht jedes Mal ein Foto, wenn er atmet!"

# game/scripts/c28/c28.rpy:2184
translate german c28s005_EriNor_8eb0eeca:

    # eri "Hasta ahora no hemos tenido ninguna selfie-adicta."
    eri "Bislang hatten wir noch keine Selfie-Süchtigen."

# game/scripts/c28/c28.rpy:2185
translate german c28s005_EriNor_e7935ec9:

    # mc "Recuerda el meme. Neil Armstrong fue a la luna y tomó tres fotos. Ashley fue al lavabo y tomó 45."
    mc "Kennt ihr noch das Meme? Neil Armstrong flog zum Mond und machte drei Fotos. Ashley ging aufs Klo und machte 45."

# game/scripts/c28/c28.rpy:2187
translate german c28s005_EriNor_2584a64f:

    # eri "*Risa* Eres un capullo. Y tú también perteneces a la generación selfie."
    eri "*Lacht* Du bist ein Idiot. Und du gehörst auch zur Selfie-Generation."

# game/scripts/c28/c28.rpy:2188
translate german c28s005_EriNor_689998e0:

    # mc "*Risa* Sí, pero yo soy feo, con lo que no me saco fotos."
    mc "*Lacht* Ja, aber ich bin hässlich, deshalb mache ich keine Fotos von mir."

# game/scripts/c28/c28.rpy:2189
translate german c28s005_EriNor_46ca3edd:

    # mc "A ver esas fotos de las chicas nuevas."
    mc "Zeigen wir mal die Bilder der neuen Mädchen."

# game/scripts/c28/c28.rpy:2191
translate german c28s005_EriNor_d17145a4:

    # nor "*Risa* Sabía que no te ibas a poder resistir. Y eso que no sabes que algunas están en bikini."
    nor "*lacht* Ich wusste, du könntest nicht widerstehen. Und du weißt ja nicht mal, dass manche von ihnen Bikinis tragen."

# game/scripts/c28/c28.rpy:2193
translate german c28s005_EriNor_d7ba6a78:

    # mc "*Risa* Bueno, ya he visto fotos de [kal] y de [pat]. Me faltan las otras cuatro. No quiero discriminar a nadie."
    mc "*lacht* Also, ich habe schon Fotos von [kal] und [pat] gesehen. Die anderen vier fehlen mir noch. Ich will niemanden diskriminieren."

# game/scripts/c28/c28.rpy:2195
translate german c28s005_EriNor_c981aab1:

    # mc "*Risa* Bueno, ya he visto fotos de [kal]. Me faltan las otras cinco. No quiero discriminar a nadie."
    mc "*lacht* Also, ich habe schon Fotos von [kal] gesehen. Die anderen fünf fehlen mir noch. Ich will niemanden diskriminieren."

# game/scripts/c28/c28.rpy:2197
translate german c28s005_EriNor_cdc0fb39:

    # eri "Hay una que no ha enviado la foto todavía. A lo mejor no lo hace. Era opcional, aunque las indicaciones de [kal.nick] eran que tenían que hacerlas hace un par de horas." id c28s005_EriNor_cdc0fb39
    eri "Eine von ihnen hat das Foto noch nicht geschickt. Vielleicht will sie es auch nicht mehr. Es war zwar optional, aber in den Anweisungen von [kal.nick] stand, dass die Fotos schon vor ein paar Stunden gemacht sein mussten." id c28s005_EriNor_cdc0fb39

# game/scripts/c28/c28.rpy:2198
translate german c28s005_EriNor_d48681d3:

    # mc "Bueno, pues enseñadme las fotos de las otras. Empiezo a tener curiosidad por cómo son."
    mc "Okay, dann zeig mir die Bilder von den anderen. Ich bin langsam neugierig, wie sie aussehen."

# game/scripts/c28/c28.rpy:2200
translate german c28s005_EriNor_aa5bf397:

    # nor "Esta es [kal.nick], pero ya lo sabes por las fotos que te había enseñado [sai]." id c28s005_EriNor_aa5bf397
    nor "Das ist [kal.nick], aber das wissen Sie ja schon von den Fotos, die ich Ihnen gezeigt habe [sai]." id c28s005_EriNor_aa5bf397

# game/scripts/c28/c28.rpy:2201
translate german c28s005_EriNor_f7a11f20:

    # mc "¿Sigue de vacaciones por Europa? Eso no parece la India."
    mc "Bist du noch im Urlaub in Europa? Das sieht nicht nach Indien aus."

# game/scripts/c28/c28.rpy:2202
translate german c28s005_EriNor_b3a7f8e2:

    # nor "Sí, en el correo dice que está en Alemania ahora."
    nor "Ja, in der E-Mail steht, dass er sich jetzt in Deutschland befindet."

# game/scripts/c28/c28.rpy:2203
translate german c28s005_EriNor_e0fb7aac:

    # eri "Es guapísima. No sé si me parece más guapa ella o [sai]."
    eri "Sie ist umwerfend. Ich weiß nicht, ob ich sie hübscher finde oder [sai]."

# game/scripts/c28/c28.rpy:2204
translate german c28s005_EriNor_92e6ac56:

    # mc "[sai] siempre habla de ella como 'mi prima la guapa'. *Risa* A lo mejor el resto de sus primas son horribles."
    mc "[sai] Sie spricht immer von ihr als „meiner hübschen Cousine“. *Lacht* Vielleicht sind ihre anderen Cousins ja furchtbar."

# game/scripts/c28/c28.rpy:2206
translate german c28s005_EriNor_4bafba38:

    # eri "Maldición, hasta yo la llamaría 'mi prima la guapa'. *Risa* Aunque [emm] se enfadaría si me oyera."
    eri "Verdammt, selbst ich würde sie „meine hübsche Cousine“ nennen. *lacht* Obwohl [emm] sauer werden würde, wenn sie mich hören würde."

# game/scripts/c28/c28.rpy:2207
translate german c28s005_EriNor_9a3980e1:

    # mc "*Risa* Puedo imaginarme a [emm] entrando en modo asesina psicópata si te oye decir algo como eso."
    mc "*Lacht* Ich kann mir vorstellen, dass [emm] in den Psychokiller-Modus verfällt, wenn sie so etwas hört."

# game/scripts/c28/c28.rpy:2209
translate german c28s005_EriNor_2654ef1a:

    # nor "Esta es... ¿cómo se llamaba esta, [eri]?"
    nor "Das ist... wie hieß das noch gleich, [eri]?"

# game/scripts/c28/c28.rpy:2213
translate german c28s005_EriNor_19a37ef8:

    # eri "[nia] Serrat. Es de Nueva York."
    eri "[nia] Serrat. Er kommt aus New York."

# game/scripts/c28/c28.rpy:2214
translate german c28s005_EriNor_c84ce105:

    # mc "¿Otra deportista? ¿Viene becada?"
    mc "Noch eine Sportlerin? Hat sie ein Stipendium?"

# game/scripts/c28/c28.rpy:2216
translate german c28s005_EriNor_a637e0e1:

    # nor "En su expediente no pone nada sobre deporte. Estudia Administración de Empresas. Supongo que tan solo estaba jugando un partido de voleibol cuando tocó hacer la foto."
    nor "Seine Studienleistungen lassen nichts über Sport erkennen. Er studiert Betriebswirtschaftslehre. Ich nehme an, er spielte gerade Volleyball, als das Foto gemacht wurde."

# game/scripts/c28/c28.rpy:2217
translate german c28s005_EriNor_a65d80f9:

    # mc "Pues al fotógrafo le ha quedado una foto fantástica. A ver la siguiente..."
    mc "Der Fotograf hat ein fantastisches Foto gemacht. Mal sehen, wie das nächste aussieht..."

# game/scripts/c28/c28.rpy:2219
translate german c28s005_EriNor_2322cfa9:

    # eri "Esta es... espera que mire el nombre..."
    eri "Das ist... Moment, lass mich den Namen ansehen..."

# game/scripts/c28/c28.rpy:2223
translate german c28s005_EriNor_c03ad76d:

    # eri "[hai] Jenkinson. De Verbena, Alabama. Estudia trabajo social."
    eri "[hai] Jenkinson. Aus Verbena, Alabama. Studiert Sozialarbeit."

# game/scripts/c28/c28.rpy:2224
translate german c28s005_EriNor_9a565357:

    # mc "Me recuerda a alguien y no sé a quién."
    mc "Es erinnert mich an jemanden, aber ich weiß nicht, an wen."

# game/scripts/c28/c28.rpy:2226
translate german c28s005_EriNor_758320a1:

    # eri "A mí me ha pasado lo mismo."
    eri "Mir geht es genauso."

# game/scripts/c28/c28.rpy:2227
translate german c28s005_EriNor_c4f32212:

    # eri "Mi madre dice que se parece a una chica en una vieja peli, en que está montada en un caballo de esos para niños que les echas una moneda."
    eri "Meine Mutter sagt, sie sehe aus wie ein Mädchen in einem alten Film, so eins, das auf einem dieser Kinderpferde reitet, in die man eine Münze wirft."

# game/scripts/c28/c28.rpy:2228
translate german c28s005_EriNor_7dc96144:

    # mc "¡Maldición! Es verdad. Recuerdo esa peli."
    mc "Verdammt! Das stimmt. Ich erinnere mich an den Film."

# game/scripts/c28/c28.rpy:2230
translate german c28s005_EriNor_87c8e2b9:

    # nor "¡Hey! *Risa* ¡La peli no es tan vieja! Debía tener 12 o 14 años cuando la vi por primera vez."
    nor "Hey! *lacht* Der Film ist doch gar nicht so alt! Ich muss so 12 oder 14 gewesen sein, als ich ihn zum ersten Mal gesehen habe."

# game/scripts/c28/c28.rpy:2231
translate german c28s005_EriNor_77b11ed9:

    # mc "*Levanta una ceja*"
    mc "*Zieht eine Augenbraue hoch*"

# game/scripts/c28/c28.rpy:2232
translate german c28s005_EriNor_4a7c5060:

    # nor "*Risa* Vale, sí. Es una peli vieja. Veamos la siguiente foto antes de que tenga que ir a cambiarme los pañales de anciana."
    nor "*Lacht* Okay, ja. Das ist ein alter Film. Schauen wir uns das nächste Bild an, bevor ich meine Windeln wechseln muss."

# game/scripts/c28/c28.rpy:2233
translate german c28s005_EriNor_d837cf5b:

    # mc "*Risa* La peli es vieja. Tú eres solo una veterana. Pero sí, siguiente foto."
    mc "*Lacht* Der Film ist alt. Du bist halt ein alter Hase. Aber ja, nächstes Bild."

# game/scripts/c28/c28.rpy:2237
translate german c28s005_EriNor_0411c690:

    # eri "Esta es [pat], pero prefiere que la llamemos [pat.nick]. Es la más joven de todas."
    eri "Das ist [pat], aber sie bevorzugt es, wenn wir sie [pat.nick] nennen. Sie ist die Jüngste von allen."

# game/scripts/c28/c28.rpy:2239
translate german c28s005_EriNor_7a1b3546:

    # eri "Va a estudiar medicina, con lo que es probable que vaya a clases con [sca]."
    eri "Sie wird Medizin studieren, daher ist es wahrscheinlich, dass sie mit [sca] in Kursen sein wird."

# game/scripts/c28/c28.rpy:2241
translate german c28s005_EriNor_e0065075:

    # eri "Pero eso ya lo sabes, miraste su expediente."
    eri "Aber das wissen Sie ja schon, Sie haben ja seine Akte eingesehen."

# game/scripts/c28/c28.rpy:2242
translate german c28s005_EriNor_0caa3bad:

    # mc "No sé por qué, pero me suena de algo."
    mc "Ich weiß nicht warum, aber es klingt bekannt."

# game/scripts/c28/c28.rpy:2244
translate german c28s005_EriNor_8c19f855:

    # eri "¿No la recuerdas?"
    eri "Erinnerst du dich nicht an sie?"

# game/scripts/c28/c28.rpy:2245
translate german c28s005_EriNor_146caaa6:

    # mc "¿Debería?"
    mc "Sollte?"

# game/scripts/c28/c28.rpy:2247
translate german c28s005_EriNor_da86c9ea:

    # nor "¿Te acuerdas de cuando [dap] y [sca] no eran amigas aún porque se consideraban rivales por ser la que sacaba mejores notas?"
    nor "Erinnerst du dich noch daran, als [dap] und [sca] noch nicht befreundet waren, weil sie sich gegenseitig als Rivalen um bessere Noten betrachteten?"

# game/scripts/c28/c28.rpy:2248
translate german c28s005_EriNor_84010e4e:

    # mc "Sí, pero de eso hace muchísimo. Son amigas desde... ¿que tenían diez u once?"
    mc "Ja, aber das ist schon ewig her. Sie sind schon befreundet, seit sie... zehn oder elf Jahre alt waren?"

# game/scripts/c28/c28.rpy:2250
translate german c28s005_EriNor_8daf7f9d:

    # eri "Sí, desde que tuvieron que hacer un trabajo en parejas y se dieron cuenta de que podían ser aliadas. Yo lo hice con [emm]."
    eri "Ja, seitdem sie ein Gruppenprojekt machen mussten und merkten, dass sie Verbündete sein könnten. Ich habe es mit [emm] gemacht."

# game/scripts/c28/c28.rpy:2251
translate german c28s005_EriNor_2ff893af:

    # eri "[pat.nick] y Patricia eran las mejores amigas de [sca] por entonces. [pat.nick] vivía aquí, en Newport, hasta que sus padres se mudaron de vuelta a Charlotte."
    eri "[pat.nick] und Patricia waren damals [sca]s beste Freundinnen. [pat.nick] lebte hier in Newport, bis ihre Eltern zurück nach Charlotte zogen."

# game/scripts/c28/c28.rpy:2252
translate german c28s005_EriNor_c52dae0b:

    # eri "Vino a casa un par de veces."
    eri "Er war ein paar Mal bei mir zu Hause."

# game/scripts/c28/c28.rpy:2253
translate german c28s005_EriNor_9cfd53b5:

    # mc "Debe ser de eso que me suena, pero no soy capaz de recordarla."
    mc "Es muss etwas sein, das mir bekannt vorkommt, aber ich kann es nicht genau zuordnen."

# game/scripts/c28/c28.rpy:2255
translate german c28s005_EriNor_9bdc357f:

    # nor "Era una niña y ahora es una mujer. No me extraña que no seas capaz de reconocerla."
    nor "Sie war ein Mädchen, und jetzt ist sie eine Frau. Kein Wunder, dass du sie nicht wiedererkennst."

# game/scripts/c28/c28.rpy:2256
translate german c28s005_EriNor_50009e7f:

    # mc "Me parece que le pasaría lo mismo a cualquiera que me hubiera conocido hace diez años y viera una foto mía actual."
    mc "Ich glaube, dasselbe würde jedem passieren, der mich vor zehn Jahren kannte und jetzt ein aktuelles Foto von mir sieht."

# game/scripts/c28/c28.rpy:2258
translate german c28s005_EriNor_0f282a8e:

    # nor "*Risa* Casi te pasó a ti cuando me viste al volver de la universidad, y yo no era una foto."
    nor "*Lacht* Das wäre dir beinahe auch passiert, als du mich von der Uni zurückkommen sahst und ich kein Foto davon war."

# game/scripts/c28/c28.rpy:2259
translate german c28s005_EriNor_d8dc30a0:

    # mc "*Risa* Es que faltaba la mitad de mi Tía [nor] cuando volví."
    mc "*Lacht* Es ist nur so, dass die Hälfte meiner Tante [nor] fehlte, als ich zurückkam."

# game/scripts/c28/c28.rpy:2260
translate german c28s005_EriNor_65ef0603:

    # mc "Pero sigamos con las fotos. Queda otra, ¿no?"
    mc "Aber zurück zu den Fotos. Da ist noch eins, nicht wahr?"

# game/scripts/c28/c28.rpy:2262
translate german c28s005_EriNor_1c5cd3a1:

    # nor "Sí, también está en una playa o algo así."
    nor "Ja, es liegt auch an einem Strand oder so etwas Ähnliches."

# game/scripts/c28/c28.rpy:2264
translate german c28s005_EriNor_60a12c9c:

    # nor "Pero prefiere que la llamen por el diminutivo..."
    nor "Aber sie bevorzugt es, mit ihrem Kosenamen angesprochen zu werden..."

# game/scripts/c28/c28.rpy:2269
translate german c28s005_EriNor_e447ca61:

    # mc "*Risa* Parece que esta no quería que le sacaran la foto."
    mc "*Gelächter* Anscheinend wollte sie nicht fotografiert werden."

# game/scripts/c28/c28.rpy:2271
translate german c28s005_EriNor_d18a1db1:

    # eri "*Risa* Tienes razón. Nos ha dicho que se la ha sacado su padre por sorpresa."
    eri "*lacht* Stimmt. Sie erzählte uns, ihr Vater habe sie damit überrascht."

# game/scripts/c28/c28.rpy:2272
translate german c28s005_EriNor_2ad36efa:

    # eri "Dice que una foto es solo una imagen que no refleja su personalidad y que no iba a enviarla, pero que su padre ha insistido."
    eri "Sie sagt, ein Foto sei nur ein Bild, das ihre Persönlichkeit nicht widerspiegele, und sie habe es auch nicht abschicken wollen, aber ihr Vater habe darauf bestanden."

# game/scripts/c28/c28.rpy:2273
translate german c28s005_EriNor_a7c41a78:

    # mc "¡Ufff! ¿Es de esas? Es una simple foto..."
    mc "Puh! Ist es so eins? Es ist nur ein Foto..."

# game/scripts/c28/c28.rpy:2275
translate german c28s005_EriNor_1c54be5b:

    # nor "Ya sabes cómo son algunas chicas a esta edad. Algunas son muy vehementes en sus creencias."
    nor "Du weißt ja, wie manche Mädchen in diesem Alter sind. Manche vertreten ihre Überzeugungen sehr vehement."

# game/scripts/c28/c28.rpy:2276
translate german c28s005_EriNor_98c5f0ad:

    # nor "Y otras están muy inseguras de su físico como para que una foto sea su presentación."
    nor "Und andere sind zu unsicher wegen ihres Aussehens, um ein Foto als Vorstellung zu verwenden."

# game/scripts/c28/c28.rpy:2278
translate german c28s005_EriNor_bc35f4a1:

    # eri "No todas somos así, Mamá."
    eri "Nicht alle von uns sind so, Mama."

# game/scripts/c28/c28.rpy:2279
translate german c28s005_EriNor_f3d7674d:

    # mc "Creo que se refiere a las chicas 'normales'. Por suerte tú eres especial."
    mc "Ich glaube, sie meint „normale“ Mädchen. Zum Glück bist du etwas Besonderes."

# game/scripts/c28/c28.rpy:2281
translate german c28s005_EriNor_60333264:

    # nor "Ayer mismo, hablando de esta iniciativa de [kal.nick], [kim] dijo que hubiera venido insegura si hubiera visto fotos de [lis], [deb.nick], [sai], y [kat]."
    nor "Erst gestern sagte [kim] über diese Initiative von [kal.nick], dass sie sich unsicher gefühlt hätte, wenn sie Fotos von [lis], [deb.nick], [sai] und [kat] gesehen hätte."

# game/scripts/c28/c28.rpy:2282
translate german c28s005_EriNor_c32ff48d:

    # nor "Creo que seríamos el resto las que hubiéramos estado inseguras si ella nos hubiera mandado una foto como estas."
    nor "Ich glaube, wir anderen hätten uns alle unsicher gefühlt, wenn sie uns so ein Foto geschickt hätte."

# game/scripts/c28/c28.rpy:2283
translate german c28s005_EriNor_f865c597:

    # mc "No tenéis que estarlo. Sabéis que todas tenéis un tipo de belleza diferente, pero eso no os hace menos hermosas que las otras, ¿no?"
    mc "Das musst du nicht. Du weißt doch, dass jeder Mensch eine andere Art von Schönheit hat, aber das macht dich nicht weniger schön als irgendjemand anderes, oder?"

# game/scripts/c28/c28.rpy:2285
translate german c28s005_EriNor_e2acb78c:

    # eri "Las mujeres somos así, [mc]. Lo raro es que no hayan aparecido envidias entre nosotras..."
    eri "So sind Frauen eben, [mc]. Seltsam ist nur, dass wir keinerlei Neid verspürt haben..."

# game/scripts/c28/c28.rpy:2286
translate german c28s005_EriNor_939c8095:

    # eri "Creo que, si no se hubiera creado el sentimiento de pertenencia a algo mayor, sí que hubieran aparecido."
    eri "Ich glaube, dass sie erschienen wären, wenn nicht das Gefühl der Zugehörigkeit zu etwas Größerem geschaffen worden wäre."

# game/scripts/c28/c28.rpy:2287
translate german c28s005_EriNor_0a78fcc5:

    # mc "Entonces me alegro de que el sentimiento de familia esté ahí. Podríais convertir la casa en un infierno si empezáis con las envidias."
    mc "Dann bin ich froh, dass dieses familiäre Gefühl da ist. Man könnte das Haus in die Hölle verwandeln, wenn man mit Neid anfängt."

# game/scripts/c28/c28.rpy:2288
translate german c28s005_EriNor_fdd050da:

    # mc "¿Qué estudia [cri]?"
    mc "Was erforscht [cri]?"

# game/scripts/c28/c28.rpy:2290
translate german c28s005_EriNor_68117965:

    # nor "Una doble licenciatura en Leyes y Estudios de Género."
    nor "Ein Doppelabschluss in Rechtswissenschaften und Gender Studies."

# game/scripts/c28/c28.rpy:2291
translate german c28s005_EriNor_3ccbca07:

    # mc "La segunda carrera y el pelo verde explica lo de que la foto es solo una imagen y blah blah blah."
    mc "Das zweite Rennen und die grünen Haare erklären die Sache mit dem Foto, das nur ein Bild ist, und so weiter."

# game/scripts/c28/c28.rpy:2293
translate german c28s005_EriNor_ec0dd466:

    # eri "No empieces a juzgarlas antes de que lleguen."
    eri "Urteile nicht über sie, bevor sie angekommen sind."

# game/scripts/c28/c28.rpy:2294
translate german c28s005_EriNor_b8efa8ee:

    # mc "No sé por qué, pero esa chica creo que puede ser problemática..."
    mc "Ich weiß nicht warum, aber ich glaube, dieses Mädchen könnte Ärger machen..."

# game/scripts/c28/c28.rpy:2295
translate german c28s005_EriNor_1a15013e:

    # eri "Creo que será mejor esperar a conocerla para sacar conclusiones, ¿no?"
    eri "Ich denke, es ist am besten, mit irgendwelchen Schlussfolgerungen zu warten, bis wir sie persönlich kennengelernt haben, findest du nicht auch?"

# game/scripts/c28/c28.rpy:2296
translate german c28s005_EriNor_818f4f04:

    # mc "Tienes razón... a lo mejor es como lo de [lis] con el veganismo y el ecologismo. Pasados los primeros días no ha dado ningún problema."
    mc "Du hast recht … vielleicht ist es ähnlich wie bei [lis] und Veganismus und Umweltschutz. Nach den ersten paar Tagen gab es keine Probleme."

# game/scripts/c28/c28.rpy:2297
translate german c28s005_EriNor_32e589c4:

    # mc "Pero... ¿podéis volver a enseñarme las fotos de las chicas en bikini?"
    mc "Aber... könnten Sie mir die Fotos der Mädchen in Bikinis noch einmal zeigen?"

# game/scripts/c28/c28.rpy:2299
translate german c28s005_EriNor_3c428cd6:

    # nor "*Risa* ¿Estás empezando a babear?"
    nor "*lacht* Läuft dir schon das Wasser im Mund zusammen?"

# game/scripts/c28/c28.rpy:2301
translate german c28s005_EriNor_9e3a8736:

    # nor "¿O es que estás pensando en meterlas en el harén?"
    nor "Oder denkst du daran, sie in den Harem aufzunehmen?"

# game/scripts/c28/c28.rpy:2302
translate german c28s005_EriNor_ff9941d3:

    # mc "*Risa* No es eso. Es que me ha parecido ver algo, pero no estoy seguro."
    mc "*Lacht* Das ist es nicht. Ich dachte, ich hätte etwas gesehen, aber ich bin mir nicht sicher."

# game/scripts/c28/c28.rpy:2304
translate german c28s005_EriNor_4002b7ac:

    # nor "Aquí las tienes. ¿Qué has visto?"
    nor "Hier sind sie. Was hast du gesehen?"

# game/scripts/c28/c28.rpy:2305
translate german c28s005_EriNor_9182df16:

    # mc "Dame un segundo..."
    mc "Einen Moment bitte..."

# game/scripts/c28/c28.rpy:2306
translate german c28s005_EriNor_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c28/c28.rpy:2308
translate german c28s005_EriNor_ce2dfdb2:

    # mc "Ahí está. ¿Sabéis si se conocen? ¿Han ido juntas a Aruba?"
    mc "Da ist sie ja. Weißt du, ob sie sich kennen? Waren sie schon mal zusammen auf Aruba?"

# game/scripts/c28/c28.rpy:2310
translate german c28s005_EriNor_4cc1d72e:

    # eri "¿Cómo sabes que es Aruba?" (multiple=2)
    eri "Woran erkennt man, dass es Aruba ist?" (multiple=2)

# game/scripts/c28/c28.rpy:2311
translate german c28s005_EriNor_c14e315a:

    # nor "¿Qué?" (multiple=2)
    nor "Das?" (multiple=2)

# game/scripts/c28/c28.rpy:2313
translate german c28s005_EriNor_ad35e74b:

    # mc "Mira ahí. Los dos tíos paseando por la playa. Uno es Aaron y va con un clon de la Serie G."
    mc "Schau mal da. Die beiden Männer schlendern am Strand entlang. Einer ist Aaron, und er hat einen G-Series-Klon dabei."

# game/scripts/c28/c28.rpy:2314
translate german c28s005_EriNor_8a6640c1:

    # nor "No me había dado cuenta..."
    nor "Mir war das nicht bewusst gewesen..."

# game/scripts/c28/c28.rpy:2315
translate german c28s005_EriNor_e89fb7fa:

    # eri "Estábamos mirando a [nia]..."
    eri "Wir haben [nia] geschaut..."

# game/scripts/c28/c28.rpy:2316
translate german c28s005_EriNor_483f83cb:

    # nor "¿Cómo sabes que es Aaron? No se le ve la cara..."
    nor "Woher weißt du, dass es Aaron ist? Du kannst sein Gesicht doch gar nicht sehen..."

# game/scripts/c28/c28.rpy:2317
translate german c28s005_EriNor_851b7c09:

    # mc "Mira la foto de [pat]..."
    mc "Schau dir das Foto von [pat] an..."

# game/scripts/c28/c28.rpy:2319
translate german c28s005_EriNor_19e25719:

    # mc "En esta foto se ve también a Aaron y al G. Incluso a [nia] saltando en su partido de volleyball."
    mc "Dieses Foto zeigt auch Aaron und G. Even [nia] beim Springen in seinem Volleyballspiel."

# game/scripts/c28/c28.rpy:2320
translate german c28s005_EriNor_6760b8ba:

    # nor "¡Qué vista tienes!"
    nor "Was für eine Aussicht!"

# game/scripts/c28/c28.rpy:2321
translate german c28s005_EriNor_a9f26d22:

    # eri "*Risa* Que hayas visto a Aaron teniendo en cuenta que está encima del culo de [pat.nick]..."
    eri "*Lacht* Dass du Aaron gesehen hast, wenn man bedenkt, dass er auf <l2s Hintern sitzt..."

# game/scripts/c28/c28.rpy:2322
translate german c28s005_EriNor_353939e1:

    # mc "*Risa* Por eso no lo he visto la primera vez..."
    mc "*lacht* Deshalb habe ich es beim ersten Mal nicht gesehen..."

# game/scripts/c28/c28.rpy:2323
translate german c28s005_EriNor_4ec3b027:

    # mc "Tampoco me he fijado en que el bikini y la funda del móvil la van a convertir en amiga de [emm]. *Risa*"
    mc "Mir ist auch nicht aufgefallen, dass sie sich mit dem Bikini und der Handyhülle bei [emm] anfreunden wird. *lacht*"

# game/scripts/c28/c28.rpy:2325
translate german c28s005_EriNor_e948ab4b:

    # nor "*Risa* Yo sí que me había fijado en eso. No es exactamente rosa, sino coral oscuro, pero a [emm] le va a encantar."
    nor "*Lacht* Das ist mir auch aufgefallen. Es ist nicht wirklich rosa, eher ein dunkles Korallenrot, aber [emm] wird es lieben."

# game/scripts/c28/c28.rpy:2326
translate german c28s005_EriNor_aa7c5597:

    # mc "Rosa, coral, fucsia... Sabéis que soy un tío, ¿verdad? *Risa* Sólo hay seis colores en el mundo. Diez a lo sumo. El resto son tonos de esos colores."
    mc "Pink, Koralle, Fuchsia … Du weißt doch, dass ich ein Mann bin, oder? *lacht* Es gibt nur sechs Farben auf der Welt. Höchstens zehn. Der Rest sind Nuancen dieser Farben."

# game/scripts/c28/c28.rpy:2327
translate german c28s005_EriNor_31025de6:

    # eri "*Risa* A veces me sorprende que te aguantemos..."
    eri "*lacht* Manchmal bin ich überrascht, dass wir dich ertragen..."

# game/scripts/c28/c28.rpy:2328
translate german c28s005_EriNor_ff36450e:

    # eri "¿Pero [cri.nick]? ¿Por qué crees que también está en Aruba?"
    eri "Aber [cri.nick]? Warum glaubst du, dass es auch in Aruba ist?"

# game/scripts/c28/c28.rpy:2330
translate german c28s005_EriNor_a7961206:

    # mc "Porque [pat] está detrás. Fíjate en la rubia con el móvil rosa... coral... detrás de [cri]. Lleva el mismo bikini."
    mc "Weil [pat] hinten ist. Schau dir die Blondine mit dem pinken... korallenfarbenen... Handy hinter [cri] an. Sie trägt denselben Bikini."

# game/scripts/c28/c28.rpy:2331
translate german c28s005_EriNor_c8c59824:

    # mc "Y el colchón de la tumbona es igual, y a la siguiente tumbona le falta el colchón. ¿Cuántas probabilidades hay de que sea otra chica en otro sitio?"
    mc "Die Matratze der Sonnenliege ist dieselbe, aber die Matratze der nächsten Sonnenliege fehlt. Wie wahrscheinlich ist es, dass es sich um ein anderes Mädchen an einem anderen Ort handelt?"

# game/scripts/c28/c28.rpy:2332
translate german c28s005_EriNor_0d5902f5:

    # eri "¡Es verdad! ¡Es ella!"
    eri "Es stimmt! Sie ist es!"

# game/scripts/c28/c28.rpy:2333
translate german c28s005_EriNor_040ecad8:

    # nor "Y [cri.nick] está en una posición en la que tapa a quienquiera que estuviese sacando la foto de [pat.nick]."
    nor "Und [cri.nick] befindet sich in einer Position, in der es denjenigen verdeckt, der das Foto von [pat.nick] gemacht hat."

# game/scripts/c28/c28.rpy:2335
translate german c28s005_EriNor_4963481b:

    # eri "Si no han ido juntas, se van a llevar una sorpresa cuando vean las fotos."
    eri "Wenn sie nicht zusammen hingegangen sind, werden sie überrascht sein, wenn sie die Fotos sehen."

# game/scripts/c28/c28.rpy:2336
translate german c28s005_EriNor_c13eca9f:

    # eri "Ellas van a reconocer el sitio sin fijarse en cosas como las tumbonas o Aaron."
    eri "Sie werden den Ort wiedererkennen, ohne Dinge wie die Sonnenliegen oder Aaron zu bemerken."

# game/scripts/c28/c28.rpy:2337
translate german c28s005_EriNor_7a841944:

    # mc "Pueden empezar a crear lazos allí en vez de esperar a llegar aquí. ¿Cuándo llegan?"
    mc "Sie können schon dort Beziehungen aufbauen, anstatt darauf zu warten, hierher zu kommen. Wann kommen sie an?"

# game/scripts/c28/c28.rpy:2339
translate german c28s005_EriNor_a270dd63:

    # nor "Entre el 2 y el 4 de septiembre. La primera en llegar será [kal.nick]."
    nor "Zwischen dem 2. und 4. September. Als erstes wird [kal.nick] eintreffen."

# game/scripts/c28/c28.rpy:2340
translate german c28s005_EriNor_da7e61a0:

    # mc "¿Os dais cuenta de que ya las estáis llamando por los diminutivos?"
    mc "Ist dir bewusst, dass du sie bereits mit ihren Spitznamen ansprichst?"

# game/scripts/c28/c28.rpy:2342
translate german c28s005_EriNor_ef85aba9:

    # eri "Es mejor que empecemos a pensar en ellas de la forma en que prefieren que las llamen."
    eri "Am besten wäre es, wenn wir anfangen, sie so zu nennen, wie sie es vorziehen, bezeichnet zu werden."

# game/scripts/c28/c28.rpy:2343
translate german c28s005_EriNor_515ffaea:

    # eri "No queremos que les pase como a [mad.nick] con su madre."
    eri "Wir wollen nicht, dass ihnen das passiert, was [mad.nick] mit seiner Mutter passiert ist."

# game/scripts/c28/c28.rpy:2344
translate german c28s005_EriNor_8e21ead2:

    # mc "Tienes razón, no lo había pensado."
    mc "Stimmt, daran hatte ich nicht gedacht."

# game/scripts/c28/c28.rpy:2346
