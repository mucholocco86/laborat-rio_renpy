translate german c28s005_GavCall_377bd95e:

    # aar "Bueno, llevamos varios días hablando. No lo conocía demasiado, pero es buen chico."
    aar "Wir haben uns nun schon seit einigen Tagen unterhalten. Ich kannte ihn vorher nicht besonders gut, aber er ist ein netter Kerl."

# game/scripts/c28/c28.rpy:2629
translate german c28s005_GavCall_ce6225f6:

    # mc "¿Cuándo habéis estado paseando por la playa?"
    mc "Wann waren Sie das letzte Mal am Strand spazieren?"

# game/scripts/c28/c28.rpy:2632
translate german c28s005_GavCall_e6e985b6:

    # aar "¿Tienes a gente espiándome? ¿No te fías de mí?"
    aar "Lässt du mich ausspionieren? Vertraust du mir nicht?"

# game/scripts/c28/c28.rpy:2633
translate german c28s005_GavCall_23c40331:

    # mc "No, Aaron. No es mi estilo. Alguien nos ha mandado una foto desde Aruba y te he visto."
    mc "Nein, Aaron. Das ist nicht mein Stil. Jemand hat uns ein Foto aus Aruba geschickt, und da habe ich dich gesehen."

# game/scripts/c28/c28.rpy:2634
translate german c28s005_GavCall_b5becebb:

    # mc "Para ser más exactos, he descubierto que era Aruba porque tú salías en la foto."
    mc "Um es genauer zu sagen: Ich habe herausgefunden, dass es Aruba war, weil du auf dem Foto warst."

# game/scripts/c28/c28.rpy:2636
translate german c28s005_GavCall_6ae1d6b4:

    # aar "Disculpa, supongo que es la costumbre de desconfiar de todo el mundo."
    aar "Entschuldigen Sie, ich schätze, es ist einfach eine Angewohnheit, jedem zu misstrauen."

# game/scripts/c28/c28.rpy:2637
translate german c28s005_GavCall_01059510:

    # mc "No te preocupes. No sabía que con quien paseabas fuera Gavin... Únicamente sabía que era un G."
    mc "Keine Sorge. Ich wusste nicht, dass die Person, mit der du unterwegs warst, Gavin war... Ich wusste nur, dass er ein G war."

# game/scripts/c28/c28.rpy:2638
translate german c28s005_GavCall_8d59341d:

    # mc "Aunque ahora que sé que es el, me doy cuenta de que había notado algo raro en sus brazos... como si le faltara uno."
    mc "Obwohl ich jetzt weiß, dass er es ist, merke ich, dass mir etwas Seltsames an seinen Armen aufgefallen war... als ob ihm einer fehlen würde."

# game/scripts/c28/c28.rpy:2640
translate german c28s005_GavCall_d9516baf:

    # aar "Bueno, distinguir a los clones es difícil. *Risa* A veces me cuesta incluso a mí."
    aar "Nun ja, Klone zu unterscheiden ist schwierig. *lacht* Manchmal fällt es sogar mir schwer."

# game/scripts/c28/c28.rpy:2641
translate german c28s005_GavCall_8ddf76b8:

    # aar "Supongo que va en lo de ser clones."
    aar "Ich schätze, es hat damit zu tun, dass wir Klone sind."

# game/scripts/c28/c28.rpy:2642
translate german c28s005_GavCall_593ad66f:

    # mc "El otro día [eva] intentó disfrazarse de [dap] y las distinguí perfectamente."
    mc "Neulich versuchte [eva] sich als [dap] auszugeben, und ich konnte sie perfekt unterscheiden."

# game/scripts/c28/c28.rpy:2643
translate german c28s005_GavCall_a14d96d6:

    # mc "Para mí es fácil con ellas. Las veo todos los días."
    mc "Mit ihnen habe ich es leicht. Ich sehe sie ja jeden Tag."

# game/scripts/c28/c28.rpy:2645
translate german c28s005_GavCall_1aa8ccfc:

    # aar "Supongo que, con el tiempo, acabarás distinguiendo al resto de series. Pero lleva tiempo, especialmente con gente con la que no has tratado mucho."
    aar "Ich nehme an, Sie werden die anderen Serien irgendwann unterscheiden können. Aber das braucht Zeit, besonders bei Leuten, mit denen man bisher wenig Kontakt hatte."

# game/scripts/c28/c28.rpy:2646
translate german c28s005_GavCall_9a4a893c:

    # aar "¿Le puedo decir a Gavin que pase?"
    aar "Kann ich Gavin bitten, hereinzukommen?"

# game/scripts/c28/c28.rpy:2648
translate german c28s005_GavCall_f3c8c6da:

    # mc "Sí, sí, por supuesto."
    mc "Ja, ja, natürlich."

# game/scripts/c28/c28.rpy:2653
translate german c28s005_GavCall_b43efe1d:

    # gav "Buenas tardes, Señor."
    gav "Guten Tag, mein Herr."

# game/scripts/c28/c28.rpy:2654
translate german c28s005_GavCall_b8032aec:

    # mc "Buenas tardes, Gavin. Llámame [mc]. ¿De qué querías hablar conmigo?"
    mc "Guten Tag, Gavin. Nennen Sie mich [mc]. Worüber wollten Sie mit mir sprechen?"

# game/scripts/c28/c28.rpy:2655
translate german c28s005_GavCall_a6922e9a:

    # mc "¿Cómo estás del... brazo?"
    mc "Wie geht es deinem... Arm?"

# game/scripts/c28/c28.rpy:2657
translate german c28s005_GavCall_7f9add48:

    # gav "El brazo... o la queda de él... va bien, de momento."
    gav "Dem Arm... oder dem, was davon übrig ist... geht es im Moment gut."

# game/scripts/c28/c28.rpy:2658
translate german c28s005_GavCall_7cd7f82b:

    # gav "Los médicos me empiezan a dejar hacer vida normal. Esperan que en menos de un mes pueda volver a los entrenamientos."
    gav "Die Ärzte erlauben mir allmählich, wieder ein normales Leben zu führen. Sie gehen davon aus, dass ich in weniger als einem Monat wieder mit dem Training beginnen kann."

# game/scripts/c28/c28.rpy:2659
translate german c28s005_GavCall_425a5b6e:

    # gav "Dependiendo de cómo vaya la próxima operación, claro."
    gav "Abhängig davon, wie die nächste Operation verläuft, natürlich."

# game/scripts/c28/c28.rpy:2660
translate german c28s005_GavCall_5bbe538c:

    # mc "¿No es demasiado pronto?"
    mc "Ist es nicht noch zu früh?"

# game/scripts/c28/c28.rpy:2662
translate german c28s005_GavCall_57f48ceb:

    # gav "No debería serlo. Pero debo mantener el brazo izquierdo y las piernas en forma."
    gav "Das sollte eigentlich nicht so sein. Aber ich muss meinen linken Arm und meine Beine fit halten."

# game/scripts/c28/c28.rpy:2663
translate german c28s005_GavCall_e8afb69f:

    # mc "Bueno, los médicos saben mucho más de eso que yo."
    mc "Nun, Ärzte wissen darüber viel mehr als ich."

# game/scripts/c28/c28.rpy:2664
translate german c28s005_GavCall_3953ab2b:

    # mc "Pero supongo que no querías hablar conmigo de tu herida."
    mc "Aber ich nehme an, Sie wollten nicht mit mir über Ihre Verletzung sprechen."

# game/scripts/c28/c28.rpy:2666
translate german c28s005_GavCall_2a4e279a:

    # gav "No, Señor. Sólo quería pedirle disculpas a usted y a su familia por lo que pasó aquel día."
    gav "Nein, Sir. Ich wollte mich lediglich bei Ihnen und Ihrer Familie für das entschuldigen, was an jenem Tag geschehen ist."

# game/scripts/c28/c28.rpy:2667
translate german c28s005_GavCall_7c50392a:

    # gav "Yo sólo cumplía órdenes. Ninguno sabíamos las implicaciones de lo que estábamos haciendo allí, excepto Eric."
    gav "Ich habe nur Befehle befolgt. Keiner von uns, außer Eric, ahnte die Tragweite unseres Handelns."

# game/scripts/c28/c28.rpy:2668
translate german c28s005_GavCall_d56b9c53:

    # mc "Lo entiendo."
    mc "Ich verstehe."

# game/scripts/c28/c28.rpy:2670
translate german c28s005_GavCall_9cb8b5f3:

    # gav "No, Señor. No lo entiende. Fuimos engañados. Eric nos dijo que ustedes eran una amenaza para NTR."
    gav "Nein, Sir. Sie verstehen das nicht. Wir wurden getäuscht. Eric sagte uns, Sie seien eine Bedrohung für NTR."

# game/scripts/c28/c28.rpy:2671
translate german c28s005_GavCall_a04e793d:

    # gav "Tan sólo defendíamos a nuestra familia. Nuestro hogar."
    gav "Wir haben lediglich unsere Familie verteidigt. Unser Zuhause."

# game/scripts/c28/c28.rpy:2673
translate german c28s005_GavCall_a7548688:

    # gav "Hasta que Aaron nos explicó todo lo que había pasado y lo que estaba en juego no comprendimos lo engañados que estuvimos."
    gav "Erst als Aaron uns alles erklärte, was geschehen war und was auf dem Spiel stand, wurde uns klar, wie sehr wir getäuscht worden waren."

# game/scripts/c28/c28.rpy:2674
translate german c28s005_GavCall_1dd8c3ad:

    # gav "Por suerte, en nuestra operación no murió nadie, pero..."
    gav "Zum Glück gab es bei unserem Einsatz keine Todesopfer, aber..."

# game/scripts/c28/c28.rpy:2675
translate german c28s005_GavCall_e774dfab:

    # mc "Pero tú perdiste un brazo. Debe ser duro..."
    mc "Aber du hast einen Arm verloren. Das muss hart sein..."

# game/scripts/c28/c28.rpy:2677
translate german c28s005_GavCall_4d0a6ca1:

    # gav "No me refiero a eso. En la otra operación..."
    gav "Das meine ich nicht. Bei dem anderen Vorgang..."

# game/scripts/c28/c28.rpy:2678
translate german c28s005_GavCall_427e14bf:

    # mc "En la que murieron Beatrice, Claire, y Diana..."
    mc "In der Beatrice, Claire und Diana starben..."

# game/scripts/c28/c28.rpy:2680
translate german c28s005_GavCall_0159ebab:

    # gav "Exacto. Frederic está en una depresión constante desde que se enteró de que no tenía que haber muerto nadie."
    gav "Genau. Frederic befindet sich in einer anhaltenden Depression, seit er erfahren hat, dass eigentlich niemand hätte sterben sollen."

# game/scripts/c28/c28.rpy:2681
translate german c28s005_GavCall_0e9c6cb3:

    # gav "Ellos estaban igual de engañados por Enzo que nosotros por Eric."
    gav "Sie wurden von Enzo genauso getäuscht wie wir von Eric."

# game/scripts/c28/c28.rpy:2682
translate german c28s005_GavCall_0d2a3081:

    # mc "No tenéis por qué sentiros culpables. Como dices, os engañaron."
    mc "Du hast keinen Grund, dich schuldig zu fühlen. Wie du schon sagst, wurdest du getäuscht."

# game/scripts/c28/c28.rpy:2684
translate german c28s005_GavCall_b95fc16c:

    # gav "Pero es algo que no podemos evitar, Señor. Por eso le pido disculpas. Principalmente en mi nombre, pero también en nombre de todos los que participamos."
    gav "Aber das lässt sich nicht vermeiden, Sir. Deshalb entschuldige ich mich. In erster Linie in meinem eigenen Namen, aber auch im Namen aller Beteiligten."

# game/scripts/c28/c28.rpy:2685
translate german c28s005_GavCall_58d63438:

    # mc "Aunque no sea necesario, disculpas aceptadas."
    mc "Auch wenn es nicht nötig ist, werden Entschuldigungen angenommen."

# game/scripts/c28/c28.rpy:2687
translate german c28s005_GavCall_36e4cbcc:

    # gav "También querría pedirle que, si la operación va bien, me permita ser útil a su familia."
    gav "Ich möchte Sie außerdem bitten, mir im Falle eines erfolgreichen Operationsverlaufs zu erlauben, Ihrer Familie behilflich zu sein."

# game/scripts/c28/c28.rpy:2688
translate german c28s005_GavCall_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c28/c28.rpy:2690
translate german c28s005_GavCall_3dc2a047:

    # gav "Aaron me ha dicho que [ama] y [eva] se turnarán entre aquí y protegiendo a su familia, Señor."
    gav "Aaron sagte mir, dass [ama] und [eva] sich zwischen dem Hier und dem Schutz seiner Familie abwechseln werden, Sir."

# game/scripts/c28/c28.rpy:2691
translate german c28s005_GavCall_1fefd548:

    # gav "Si todo va bien, me gustaría ir con [ama] cuando ella vuelva a Newport. No puede estar despierta las 24 horas y..."
    gav "Wenn alles gut geht, würde ich gerne mit [ama] gehen, wenn sie nach Newport zurückkehrt. Sie kann ja nicht 24 Stunden am Tag wach sein und..."

# game/scripts/c28/c28.rpy:2692
translate german c28s005_GavCall_17e75f70:

    # mc "Para, para. ¿Quieres convertirte en el guardaespaldas de mi familia?"
    mc "Halt, halt. Willst du der Leibwächter meiner Familie werden?"

# game/scripts/c28/c28.rpy:2694
translate german c28s005_GavCall_f4414fdd:

    # gav "Sí, Señor. Es una forma de compensarles por lo que me Eric me obligó a hacer."
    gav "Ja, Sir. Es ist meine Art, es ihnen wiedergutzumachen für das, wozu Eric mich gezwungen hat."

# game/scripts/c28/c28.rpy:2695
translate german c28s005_GavCall_2c16abb3:

    # mc "Gavin, creo que es demasiado pronto para tomar esa decisión. Debería hablarlo con [ama] y [eva] y..."
    mc "Gavin, ich glaube, es ist noch zu früh für diese Entscheidung. Ich sollte mit [ama] und [eva] sprechen und..."

# game/scripts/c28/c28.rpy:2697
translate german c28s005_GavCall_14cfe0fd:

    # gav "Incluso, si la operación no sale bien, podría monitorizar las cámaras desde la base y..."
    gav "Selbst wenn die Operation nicht gut verläuft, könnte er die Kameras von der Basis aus überwachen und..."

# game/scripts/c28/c28.rpy:2698
translate german c28s005_GavCall_1d611470:

    # mc "Gavin, [ama] y [eva] tienen poder de decisión sobre eso."
    mc "Gavin, [ama] und [eva] haben darüber die Entscheidungsgewalt."

# game/scripts/c28/c28.rpy:2700
translate german c28s005_GavCall_50c45cd9:

    # gav "Pero Aaron nos dijo que podríamos dedicarnos a lo que quisiéramos cuando se acaben los contratos pendientes..."
    gav "Aaron sagte uns aber, wir könnten machen, was wir wollten, sobald unsere laufenden Verträge ausgelaufen seien..."

# game/scripts/c28/c28.rpy:2701
translate german c28s005_GavCall_ac512e98:

    # mc "Y es cierto, pero..."
    mc "Das stimmt, aber..."

# game/scripts/c28/c28.rpy:2702
translate german c28s005_GavCall_00052e0b:

    # gav "Pues yo quiero dedicarme a asegurarme de que nadie más ataca a su familia. Creo que se lo debo..."
    gav "Ich möchte alles daransetzen, dass niemand mehr seine Familie angreift. Ich denke, das bin ich ihm schuldig..."

# game/scripts/c28/c28.rpy:2703
translate german c28s005_GavCall_56e93eaf:

    # gav "Creo que se lo debemos a [ama] y a [eva]."
    gav "Ich denke, das verdanken wir [ama] und [eva]."

# game/scripts/c28/c28.rpy:2704
translate german c28s005_GavCall_048a79a2:

    # mcp "(Cuesta estar hablando con él y recordar que tiene la edad mental de un adolescente.)"
    mcp "(Es ist schwierig, sich mit ihm zu unterhalten und dabei zu bedenken, dass er geistig auf dem Stand eines Teenagers ist.)"

# game/scripts/c28/c28.rpy:2705
translate german c28s005_GavCall_c9c5dcf2:

    # mcp "(Se siente culpable y está sobrerreaccionando.)"
    mcp "(Sie fühlt sich schuldig und überreagiert.)"

# game/scripts/c28/c28.rpy:2706
translate german c28s005_GavCall_ae0c763d:

    # mc "Hablaré con ellas, no te preocupes."
    mc "Ich werde mit ihnen reden, keine Sorge."

# game/scripts/c28/c28.rpy:2708
translate german c28s005_GavCall_176a7000:

    # gav "Gracias, Señor."
    gav "Danke, Herr."

# game/scripts/c28/c28.rpy:2709
translate german c28s005_GavCall_b8711362:

    # "En ese momento te das cuenta de que ha estado llamándote 'Señor' toda la conversación."
    "In diesem Moment wird Ihnen klar, dass er Sie während des gesamten Gesprächs mit „Sir“ angesprochen hat."

# game/scripts/c28/c28.rpy:2710
translate german c28s005_GavCall_18504d7c:

    # mcp "(Supongo que algunas costumbres pueden tardar en cambiar.)"
    mcp "(Ich nehme an, manche Bräuche brauchen Zeit, um sich zu ändern.)"

# game/scripts/c28/c28.rpy:2711
translate german c28s005_GavCall_887d5ffa:

    # gav "Solo era eso, Señor. Muchas gracias, Señor. No quiero entretenerle más, Señor."
    gav "Das war alles, mein Herr. Vielen Dank, mein Herr. Ich möchte Sie nicht länger aufhalten, mein Herr."

# game/scripts/c28/c28.rpy:2714
translate german c28s005_GavCall_066c6425:

    # "Y con eso desaparece de la pantalla."
    "Und damit verschwindet er vom Bildschirm."

# game/scripts/c28/c28.rpy:2718
translate german c28s005_GavCall_aae4a488:

    # aar "Es un poco... vehemente. Pero es buen chico."
    aar "Er ist etwas... vehement. Aber er ist ein guter Junge."

# game/scripts/c28/c28.rpy:2719
translate german c28s005_GavCall_9791486a:

    # mc "No lo pongo en duda, pero eso ha sido casi una trampa, Aaron."
    mc "Ich zweifle nicht daran, aber das war beinahe eine Falle, Aaron."

# game/scripts/c28/c28.rpy:2721
translate german c28s005_GavCall_1f705152:

    # aar "No te has comprometido a nada, sólo a hablar con [ama] y [eva]."
    aar "Du hast dich zu nichts verpflichtet, außer mit [ama] und [eva] zu sprechen."

# game/scripts/c28/c28.rpy:2722
translate german c28s005_GavCall_c1c20309:

    # aar "Esa era mi idea. Si se lo propongo yo por video conferencia se van a sentir mal. Casi obligadas a aceptar."
    aar "Das war meine Idee. Wenn ich es per Videokonferenz vorschlage, werden sie sich unwohl fühlen. Fast so, als wären sie verpflichtet, zuzustimmen."

# game/scripts/c28/c28.rpy:2723
translate german c28s005_GavCall_7463c183:

    # aar "Si se lo dices tú en persona..."
    aar "Wenn du es ihm persönlich sagst..."

# game/scripts/c28/c28.rpy:2724
translate german c28s005_GavCall_416d56c2:

    # mc "Entiendo. Hablaré con ellas. Pero la próxima vez, avísame de qué va esto."
    mc "Ich verstehe. Ich werde mit ihnen sprechen. Aber sag mir nächstes Mal bitte, worum es geht."

# game/scripts/c28/c28.rpy:2726
translate german c28s005_GavCall_9c5170ae:

    # aar "*Risa* Señor. Sí, Señor."
    aar "*Gelächter* Sir. Jawohl, Sir."

# game/scripts/c28/c28.rpy:2728
translate german c28s005_GavCall_bf822fb0:

    # mcp "(Será cabrón. *Risa* ¡Ha colgado!)"
    mcp "(Er ist ein Idiot. *lacht* Er hat einfach aufgelegt!)"

# game/scripts/c28/c28.rpy:2729
translate german c28s005_GavCall_13bee13b:

    # mcp "(También debo recordar que Aaron no tiene una edad mental de 60 y pico de años...)"
    mcp "(Ich möchte außerdem darauf hinweisen, dass Aaron nicht das geistige Alter eines über 60-Jährigen hat...)"

# game/scripts/c28/c28.rpy:2730
translate german c28s005_GavCall_fcb66a46:

    # mcp "(Tengo que hablar con las chicas. Creo que [eva] especialmente estará interesada, dependiendo de los plazos.)"
    mcp "(Ich muss mit den Mädchen sprechen. Ich denke, [eva] wird besonders interessiert sein, je nach Zeitplan.)"

# game/scripts/c28/c28.rpy:2731
translate german c28s005_GavCall_e6147c42:

    # mcp "(Si Gavin puede volver aquí con [ama], [eva] evitaría verlo hasta después de su primera rotación en Aruba.)"
    mcp "(Falls Gavin mit [ama] hierher zurückkehren kann, würde [eva] ihn daran hindern, ihn vor seiner ersten Rotation in Aruba zu sehen.)"

# game/scripts/c28/c28.rpy:2732
translate german c28s005_GavCall_c69d46b4:

    # mcp "(Voy a beber algo en la cocina mientras maduro la idea.)"
    mcp "(Ich werde mir in der Küche einen Drink gönnen, während ich über die Idee nachdenke.)"

# game/scripts/c28/c28.rpy:2736
translate german c28s005_GavCall_a2d41786:

    # "Cuando pasas por la planta de las estudiantes ves a [eva] y [emm]."
    "Wenn Sie am Studentengeschoss vorbeigehen, sehen Sie [eva] und [emm]."

# game/scripts/c28/c28.rpy:2737
translate german c28s005_GavCall_0ad2d414:

    # emm "¡Esos vestidos son una pasada! Lástima del color y de que algunos no eran adecuados para una fiesta."
    emm "Die Kleider sind fantastisch! Schade nur um die Farbe und dass einige nicht für eine Party geeignet waren."

# game/scripts/c28/c28.rpy:2738
translate german c28s005_GavCall_6859b075:

    # eva "Le quedan muy bien, y tiene muy buen gusto. Incluso para el color."
    eva "Sie sehen toll an ihr aus, und sie hat einen ausgezeichneten Geschmack. Auch was die Farbe angeht."

# game/scripts/c28/c28.rpy:2739
translate german c28s005_GavCall_8661b425:

    # mc "Hola, chicas. ¿Qué hacéis aquí?" id c28s005_GavCall_8661b425
    mc "Hallo Mädels. Was macht ihr denn hier?" id c28s005_GavCall_8661b425

# game/scripts/c28/c28.rpy:2742
translate german c28s005_GavCall_2daee48c:

    # emm "Estábamos ayudando a [lis] a elegir..."
    emm "Wir halfen [lis] bei der Auswahl..."

# game/scripts/c28/c28.rpy:2743
translate german c28s005_GavCall_87b76b23:

    # eva "¡Hush, [emm]!"
    eva "Pst, [emm]!"

# game/scripts/c28/c28.rpy:2744
translate german c28s005_GavCall_c230bf0d:

    # mc "¿A elegir vestidos para la fiesta de esta noche?"
    mc "Kleider für die heutige Party aussuchen?"

# game/scripts/c28/c28.rpy:2746
translate german c28s005_GavCall_64231028:

    # emm "Sí..."
    emm "Ja..."

# game/scripts/c28/c28.rpy:2747
translate german c28s005_GavCall_b2d01325:

    # eva "*Entre dientes* Bocazas... Al menos no has dicho nada de la lencería..."
    eva "*Zähneknirschend* Große Klappe... Wenigstens hast du nichts über die Dessous gesagt..."

# game/scripts/c28/c28.rpy:2750
translate german c28s005_GavCall_151aac74:

    # emm "Estábamos ayudando a [lis] a elegir vestidos."
    emm "Wir halfen [lis] bei der Kleiderauswahl."

# game/scripts/c28/c28.rpy:2751
translate german c28s005_GavCall_57770059:

    # eva "Se va a una fiesta a Los Angeles esta noche."
    eva "Sie geht heute Abend auf eine Party in Los Angeles."

# game/scripts/c28/c28.rpy:2752
translate german c28s005_GavCall_3b52c005:

    # mc "Está bien que la ayudéis. Espero que no hayas insistido demasiado en que se vista de rosa, [emm]."
    mc "Es ist gut, dass du ihr hilfst. Ich hoffe, du hast sie nicht zu sehr dazu gedrängt, Rosa zu tragen."

# game/scripts/c28/c28.rpy:2754
translate german c28s005_GavCall_a6659234:

    # eva "*Risa* Sí que ha insistido, pero [lis] no le ha hecho ni caso. Al menos con el color."
    eva "*Lacht* Ja, er hat darauf bestanden, aber [lis] hat ihm keine Beachtung geschenkt. Zumindest nicht, was die Farbe betraf."

# game/scripts/c28/c28.rpy:2755
translate german c28s005_GavCall_bbc755cb:

    # mc "¿Puedo hablar un rato a solas contigo, [eva]?"
    mc "Kann ich kurz mit dir allein sprechen, [eva]?"

# game/scripts/c28/c28.rpy:2756
translate german c28s005_GavCall_5d5810fd:

    # emm "Yo os dejo para que habléis. Si me quedo seguro que me criticáis por algo."
    emm "Ich überlasse euch nun euren Ausführungen. Wenn ich bleibe, bin ich mir sicher, dass ihr mich für irgendetwas kritisieren werdet."

# game/scripts/c28/c28.rpy:2758
translate german c28s005_GavCall_51f7b8ac:

    # eva "¿Conmigo? Sí, por supuesto."
    eva "Mit mir? Ja, natürlich."

# game/scripts/c28/c28.rpy:2759
translate german c28s005_GavCall_a4fbae2b:

    # mc "¿Sabes dónde está [ama]?"
    mc "Wissen Sie, wo sich [ama] befindet?"

# game/scripts/c28/c28.rpy:2760
translate german c28s005_GavCall_a893e211:

    # eva "Ha ido al centro a comprar unas cosas..."
    eva "Sie ging in die Innenstadt, um ein paar Dinge einzukaufen..."

# game/scripts/c28/c28.rpy:2762
translate german c28s005_GavCall_a815d8b3:

    # mc "Bueno, ya hablaré con ella más tarde, entonces. Siéntate conmigo y hablemos."
    mc "Okay, dann spreche ich später mit ihr. Setz dich zu mir, dann reden wir."

# game/scripts/c28/c28.rpy:2774
translate german c28s005_AmaMad_d4c8ac67:

    # "Mientras tanto, en la tienda de [mad.nick]..."
    "Unterdessen im [mad.nick]-Laden..."

# game/scripts/c28/c28.rpy:2775
translate german c28s005_AmaMad_fe1162d0:

    # mad "¿Qué es lo que necesitas exactamente?"
    mad "Was genau benötigen Sie?"

# game/scripts/c28/c28.rpy:2776
translate german c28s005_AmaMad_a72f3a33:

    # ama "Trajes para ir a la oficina. Si voy a actuar como jefa de seguridad quiero vestirme como una jefa."
    ama "Anzüge fürs Büro. Wenn ich die Rolle des Sicherheitschefs übernehme, möchte ich mich auch wie ein Chef kleiden."

# game/scripts/c28/c28.rpy:2777
translate german c28s005_AmaMad_fa40eb06:

    # ama "Allí todo el mundo está acostumbrado a verme con ropa de entrenamiento. Así marcaré una diferencia en el rol con la vestimenta."
    ama "Alle dort sind es gewohnt, mich in Sportkleidung zu sehen. So werde ich in der Rolle durch meine Kleidung einen Unterschied machen."

# game/scripts/c28/c28.rpy:2779
translate german c28s005_AmaMad_e8ac9f84:

    # mad "Si cambias el aspecto al que están acostumbrados, cambiarás la percepción que tienen de ti. Bien pensado."
    mad "Wenn du die Art und Weise änderst, wie sie dich gewohnt sind zu sehen, veränderst du auch ihre Wahrnehmung von dir. Gut durchdacht."

# game/scripts/c28/c28.rpy:2780
translate german c28s005_AmaMad_68036bb8:

    # mad "¿Algo más?"
    mad "Irgendetwas anderes?"

# game/scripts/c28/c28.rpy:2784
translate german c28s005_AmaMad_3e5631ee:

    # ama "No, nada más. Creo que voy a estar muy ocupada para necesitar algo más."
    ama "Nein, sonst nichts. Ich glaube, ich werde zu beschäftigt sein, um noch etwas anderes zu brauchen."

# game/scripts/c28/c28.rpy:2786
translate german c28s005_AmaMad_909d80e4:

    # mad "OK. Déjame ver qué tengo para ti."
    mad "Okay. Mal sehen, was ich für Sie habe."

# game/scripts/c28/c28.rpy:2788
translate german c28s005_AmaMad_2708337b:

    # ama "Vestidos. Sexys, a ser posible."
    ama "Kleider. Wenn möglich, sexy."

# game/scripts/c28/c28.rpy:2790
translate german c28s005_AmaMad_1a51964a:

    # mad "*Risa* Si vas a tener a [mc] para ti sola durante un mes puede ser que necesites MUCHOS vestidos."
    mad "*Lacht* Wenn du [mc] einen Monat lang ganz für dich allein hast, brauchst du vielleicht eine MENGE Kleider."

# game/scripts/c28/c28.rpy:2791
translate german c28s005_AmaMad_e35876b8:

    # mad "¿Busco también lencería sexy?"
    mad "Suche ich auch nach sexy Dessous?"

# game/scripts/c28/c28.rpy:2793
translate german c28s005_AmaMad_00bb37fe:

    # ama "Nunca le he encontrado el sentido a la lencería..."
    ama "Ich habe den Sinn von Dessous nie verstanden..."

# game/scripts/c28/c28.rpy:2794
translate german c28s005_AmaMad_a3eeeeb2:

    # ama "Supongo que te la pones para impresionar, pero en cuanto te ven debes querer quitártela..."
    ama "Ich nehme an, du trägst es, um Eindruck zu schinden, aber sobald dich Leute sehen, willst du es bestimmt wieder ausziehen..."

# game/scripts/c28/c28.rpy:2796
translate german c28s005_AmaMad_d5cb5e64:

    # mad "*Risa* O que te la quiten."
    mad "*Gelächter* Oder sie nehmen es dir weg."

# game/scripts/c28/c28.rpy:2797
translate german c28s005_AmaMad_760bfa28:

    # mad "Pero a la mayoría de los chicos les gusta."
    mad "Aber den meisten Jungen gefällt es."

# game/scripts/c28/c28.rpy:2800
translate german c28s005_AmaMad_d4d14070:

    # ama "¿Sabes si a [mc] le gusta? ¿Has usado alguna vez con él? ¿Cuál ha sido su reacción?"
    ama "Weißt du, ob [mc] es mag? Hast du es schon mal mit ihm benutzt? Wie war seine Reaktion?"

# game/scripts/c28/c28.rpy:2802
translate german c28s005_AmaMad_0e64a7bb:

    # mad "Sí, le gusta. Sí, he usado. *Risa* ¿Babear?"
    mad "Ja, er mag es. Ja, ich habe es benutzt. *Lacht* Sabbern?"

# game/scripts/c28/c28.rpy:2803
translate german c28s005_AmaMad_ea5bd130:

    # mad "¿Estás nerviosa por ese tiempo que vas a pasar a solas con él?"
    mad "Bist du nervös wegen der Zeit, die du allein mit ihm verbringen wirst?"

# game/scripts/c28/c28.rpy:2805
translate german c28s005_AmaMad_03acd779:

    # ama "Creo que la palabra nerviosa no llega a describir cómo me siento."
    ama "Ich glaube nicht, dass das Wort „nervös“ auch nur annähernd beschreibt, wie ich mich fühle."

# game/scripts/c28/c28.rpy:2806
translate german c28s005_AmaMad_823b7528:

    # ama "Quiero hacerlo, pero tengo miedo... Va a ser mi primera vez."
    ama "Ich möchte es tun, aber ich habe Angst... Es wird mein erstes Mal sein."

# game/scripts/c28/c28.rpy:2808
translate german c28s005_AmaMad_ed053baf:

    # mad "Ya has oído lo que dicen las chicas. Es súper tierno, especialmente en las primeras veces."
    mad "Du hast ja gehört, was die Mädchen sagen. Es ist total süß, besonders die ersten paar Male."

# game/scripts/c28/c28.rpy:2810
translate german c28s005_AmaMad_cc96dfe3:

    # mad "Oyéndolas hablar, me hubiera gustado perder la virginidad con él."
    mad "Als ich sie reden hörte, hätte ich gern meine Jungfräulichkeit an ihn verloren."

# game/scripts/c28/c28.rpy:2811
translate german c28s005_AmaMad_0ea61e2d:

    # mad "Creo que no debes preocuparte por nada."
    mad "Ich glaube, du solltest dir um nichts Sorgen machen."

# game/scripts/c28/c28.rpy:2813
translate german c28s005_AmaMad_509fadd8:

    # ama "No me da miedo por él, sino por mí. No sé cómo me voy a sentir... durante o después."
    ama "Ich habe keine Angst um ihn, sondern um mich selbst. Ich weiß nicht, wie ich mich fühlen werde... währenddessen oder danach."

# game/scripts/c28/c28.rpy:2815
translate german c28s005_AmaMad_c5dd16f3:

    # mad "Mira, [ama]. Mi experiencia dice que la primera vez es una mierda. No sabes qué hacer ni cómo ponerte para estar cómoda."
    mad "Hör mal, [ama]. Meine Erfahrung sagt mir, dass das erste Mal furchtbar ist. Man weiß nicht, was man tun soll oder wie man sich am besten positioniert, um es bequem zu haben."

# game/scripts/c28/c28.rpy:2816
translate german c28s005_AmaMad_426d7499:

    # mad "Además, estás super nerviosa y da lo mismo que sepas que te tienes que relajar. No puedes hacerlo. Las expectativas son altísimas."
    mad "Außerdem bist du unglaublich nervös, und es spielt keine Rolle, dass du weißt, dass du dich entspannen musst. Du kannst es einfach nicht. Die Erwartungen sind enorm hoch."

# game/scripts/c28/c28.rpy:2817
translate german c28s005_AmaMad_662a8cc3:

    # mad "Y sobre cómo te vas a sentir después, es fácil. Dolorida."
    mad "Und wie Sie sich danach fühlen werden? Ganz einfach: Muskelkater."

# game/scripts/c28/c28.rpy:2819
translate german c28s005_AmaMad_9ecdf0dc:

    # mad "Pero oyes lo que cuentan las chicas y parece que [mc] tenga una polla mágica que no hace daño."
    mad "Aber wenn man hört, was die Mädchen sagen, scheint es, als hätte [mc] einen magischen Penis, der nicht weh tut."

# game/scripts/c28/c28.rpy:2821
translate german c28s005_AmaMad_e17b32dd:

    # mad "Que sí, que estoy de acuerdo en que Mjolnir es mágico, pero..."
    mad "Ja, ich stimme zu, dass Mjölnir magisch ist, aber..."

# game/scripts/c28/c28.rpy:2822
translate german c28s005_AmaMad_499eca96:

    # mad "Lo mejor que puedes hacer es no crearte expectativas. Vas a estar un mes allí con él."
    mad "Am besten ist es, wenn du dir keine allzu großen Hoffnungen machst. Du wirst einen Monat lang mit ihm dort sein."

# game/scripts/c28/c28.rpy:2823
translate german c28s005_AmaMad_e78f64bf:

    # mad "Si la primera vez no es tan buena como esperabas, seguro que alguna de las otras 29 lo serán. Posiblemente la segunda o la tercera."
    mad "Wenn es beim ersten Mal nicht so gut läuft wie erhofft, wird es bestimmt bei einem der anderen 29 Versuche klappen. Vielleicht beim zweiten oder dritten."

# game/scripts/c28/c28.rpy:2825
translate german c28s005_AmaMad_41d3b27a:

    # ama "*Risa* Lo dices como si fuéramos a hacerlo todos los días..."
    ama "*lacht* Du sagst das so, als ob wir das jeden Tag machen würden..."

# game/scripts/c28/c28.rpy:2826
translate german c28s005_AmaMad_2970494f:

    # ama "Eso sería casi como si fuera adicta al sexo, ¿no?"
    ama "Das wäre ja fast so, als wäre man sexsüchtig, nicht wahr?"

# game/scripts/c28/c28.rpy:2828
translate german c28s005_AmaMad_4ef7b1fe:

    # mad "*Risa* ¿Eso es lo que te preocupa? No, mi niña. Eso sería lo más normal."
    mad "*Lacht* Ist das Ihre Sorge? Nein, mein Lieber. Das wäre das Normalste der Welt."

# game/scripts/c28/c28.rpy:2830
translate german c28s005_AmaMad_672b91c3:

    # mad "¿Un mes a solas con nuestro novio sin tener que compartirlo con nadie? ¿Dónde tengo que firmar?"
    mad "Einen Monat lang nur mit unserem Freund, ohne ihn mit jemandem teilen zu müssen? Wo kann ich unterschreiben?"

# game/scripts/c28/c28.rpy:2832
translate german c28s005_AmaMad_b27eb2fa:

    # mad "¿Un mes a solas con tu novio sin tener que compartirlo con el resto del harén? Si yo fuera tú, firmaría ahora mismo."
    mad "Einen Monat lang allein mit deinem Freund, ohne ihn mit dem Rest des Harems teilen zu müssen? An deiner Stelle würde ich mich sofort anmelden."

# game/scripts/c28/c28.rpy:2834
translate german c28s005_AmaMad_232e4a4d:

    # mad "¿Un mes a solas con tu novio con el que estás empezando? Si yo fuera tú, firmaría ahora mismo."
    mad "Einen Monat allein mit deinem Freund, mit dem du gerade erst zusammen bist? An deiner Stelle würde ich mich sofort anmelden."

# game/scripts/c28/c28.rpy:2835
translate german c28s005_AmaMad_4321983d:

    # mad "Quizás no todos los días, porque tendrás que descansar uno o dos días después de la primera vez, pero después..."
    mad "Vielleicht nicht jeden Tag, denn nach dem ersten Mal brauchen Sie ein oder zwei Tage Ruhe, aber danach..."

# game/scripts/c28/c28.rpy:2837
translate german c28s005_AmaMad_299e700d:

    # ama "Me quitas un peso de encima... creía que... no sé... tengo tantas cosas que aprender..."
    ama "Du hast mir eine Last von den Schultern genommen... Ich dachte,... ich weiß nicht... ich habe noch so viel zu lernen..."

# game/scripts/c28/c28.rpy:2839
translate german c28s005_AmaMad_ea998e09:

    # mad "Tendrás tiempo para aprender lo que necesites. Y ya conoces a [mc]. Tiene mucha paciencia con todo."
    mad "Du wirst Zeit haben, alles Nötige zu lernen. Und du weißt ja bereits, dass er sehr geduldig ist."

# game/scripts/c28/c28.rpy:2840
translate german c28s005_AmaMad_99ffd67b:

    # mad "Yo no tengo tanta paciencia, con lo que lo primero que vas a aprender es qué vestidos te gustan."
    mad "Ich habe nicht so viel Geduld, deshalb wirst du als Erstes lernen, welche Kleider dir gefallen."

# game/scripts/c28/c28.rpy:2842
translate german c28s005_AmaMad_34fabdeb:

    # mad "Voy a coger algunos trajes para que te los pruebes mientras busco vestidos que puedan ir con tu estilo." id c28s005_AmaMad_34fabdeb
    mad "Ich werde Ihnen ein paar Anzüge zum Anprobieren heraussuchen, während ich nach Kleidern suche, die vielleicht zu Ihrem Stil passen." id c28s005_AmaMad_34fabdeb

# game/scripts/c28/c28.rpy:2844
translate german c28s005_AmaMad_c82394af:

    # ama "*Risita* Y no te olvides de la lencería..."
    ama "*Kichern* Und vergiss die Dessous nicht..."

# game/scripts/c28/c28.rpy:2846
translate german c28s005_AmaMad_e9c8979d:

    # ama "Y, cuando acabemos, me gustaría hablar de tu idea sobre los anillos..."
    ama "Und wenn wir fertig sind, möchte ich gerne über Ihre Idee bezüglich der Ringe sprechen..."

# game/scripts/c28/c28.rpy:2848
translate german c28s005_AmaMad_83533506:

    # "[ama] acabó comprando mucho más de lo que esperaba. También pasa mucho más tiempo en la tienda de [mad.nick] del que tenía pensado."
    "[ama] kaufte schließlich viel mehr, als sie erwartet hatte. Sie verbringt auch viel mehr Zeit in [mad.nick]s Laden, als sie geplant hatte."

# game/scripts/c28/c28.rpy:2849
translate german c28s005_AmaMad_b77b9251:

    # "Los trajes para la oficina van a ser una sorpresa para quién ha visto a [ama] sólo con ropa militar."
    "Die Büroanzüge werden für jeden eine Überraschung sein, der [ama] bisher nur in Militärkleidung gesehen hat."

# game/scripts/c28/c28.rpy:2852
translate german c28s005_AmaMad_da03fdda:

    # "Los vestidos y la lencería van a ser una bonita sorpresa para alguien durante el primer mes en Aruba."
    "Kleider und Dessous sind eine schöne Überraschung für jemanden im ersten Monat auf Aruba."

# game/scripts/c28/c28.rpy:2859
translate german c28s006_Kim_db4fa19c:

    # "Después de la llamada a traición con Aaron, sigues leyendo los nuevos documentos que te ha enviado al acabar la reunión."
    "Nach dem verräterischen Telefonat mit Aaron lesen Sie weiter die neuen Dokumente, die er Ihnen nach dem Ende des Treffens geschickt hat."

# game/scripts/c28/c28.rpy:2861
translate german c28s006_Kim_125dad34:

    # "Hace calor y te quitas la camiseta mientras lees. No quieres poner el aire acondicionado para el poco rato que vas a estar leyendo."
    "Es ist heiß, deshalb ziehst du dein Hemd aus, während du liest. Du willst die Klimaanlage ja nicht für die kurze Zeit einschalten, die du liest."

# game/scripts/c28/c28.rpy:2862
translate german c28s006_Kim_54811ec2:

    # "¿Te está empezando a influenciar [lis] con su concepto del ahorro energético?"
    "Beginnen Sie, sich von [lis]s Konzept der Energieeinsparung beeinflussen zu lassen?"

# game/scripts/c28/c28.rpy:2864
translate german c28s006_Kim_67ea73ab:

    # "Cuando acabas de leer el último informe del día..."
    "Wenn Sie gerade den neuesten Tagesbericht gelesen haben..."

# game/scripts/c28/c28.rpy:2866
translate german c28s006_Kim_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c28/c28.rpy:2867
translate german c28s006_Kim_2a71ad67:

    # kim "*A través de la puerta* Soy yo, ¿puedo pasar?"
    kim "*Durch die Tür* Ich bin's, darf ich hereinkommen?"

# game/scripts/c28/c28.rpy:2868
translate german c28s006_Kim_a688a39f:

    # mc "Sí, pasa, [kim]."
    mc "Ja, das kommt vor, [kim]."

# game/scripts/c28/c28.rpy:2870
translate german c28s006_Kim_6842348b:

    # mc "Hola, [kim], ¿te puedo ayudar en algo?"
    mc "Hallo [kim], kann ich Ihnen irgendwie helfen?"

# game/scripts/c28/c28.rpy:2879
translate german c28s006_KimOnKate_746b167a:

    # kim "Ayer me preguntaste si a [kat] le pasa algo desde vuestra no-cita."
    kim "Gestern hast du mich gefragt, ob mit [kat] etwas nicht stimmt, da dein Date nicht da ist."

# game/scripts/c28/c28.rpy:2880
translate german c28s006_KimOnKate_6c348a1c:

    # kim "¿Aún lo quieres saber?"
    kim "Möchtest du es immer noch wissen?"

# game/scripts/c28/c28.rpy:2882
translate german c28s006_KimOnKate_d0dac0dd:

    # mc "Por supuesto. Ayer [sai] dijo algo que me sorprendió y he estado atando algunos cabos, pero necesito confirmación antes decidir que paso dar."
    mc "Natürlich. Gestern sagte [sai] etwas, das mich überrascht hat, und ich habe versucht, einige Puzzleteile zusammenzusetzen, aber ich brauche eine Bestätigung, bevor ich entscheide, wie es weitergeht."

# game/scripts/c28/c28.rpy:2884
translate german c28s006_KimOnKate_4b31ad11:

    # mc "Por supuesto. Últimamente he estado atando algunos cabos, pero necesito confirmación antes decidir que paso dar."
    mc "Natürlich. Ich habe in letzter Zeit einige offene Fragen geklärt, aber ich brauche eine Bestätigung, bevor ich über den nächsten Schritt entscheide."

# game/scripts/c28/c28.rpy:2889
translate german c28s006_KimOnKate_061dcc4a:

    # kim "*Risa* Es una posición muy cómoda para ti. No te arriesgas..."
    kim "*Gelächter* Das ist eine sehr bequeme Position für Sie. Sie gehen ja kein Risiko ein..."

# game/scripts/c28/c28.rpy:2890
translate german c28s006_KimOnKate_77f0858e:

    # mc "[kat] es una chica compleja y lo que menos querría es que nuestra amistad sufriera porque yo he malinterpretado las señales."
    mc "[kat] ist ein komplexes Mädchen, und das Letzte, was ich möchte, ist, dass unsere Freundschaft darunter leidet, weil ich die Signale falsch interpretiert habe."

# game/scripts/c28/c28.rpy:2891
translate german c28s006_KimOnKate_05c5df0a:

    # mc "Y sabiendo su relación pasada con algunos tipos, lo que menos querría sería hacerle daño de alguna manera por estar equivocado."
    mc "Und da ich ihre früheren Beziehungen zu einigen Männern kenne, wäre das Letzte, was ich tun möchte, sie in irgendeiner Weise zu verletzen, indem ich mich irre."

# game/scripts/c28/c28.rpy:2896
translate german c28s006_KimOnKate_039dee72:

    # kim "A veces olvido lo considerado que eres."
    kim "Manchmal vergesse ich, wie aufmerksam du bist."

# game/scripts/c28/c28.rpy:2897
translate german c28s006_KimOnKate_7649a9aa:

    # kim "La mayoría de los hombres que conozco intentarían follarse a una mujer tan guapa como [kat] sin pensar en sus sentimientos."
    kim "Die meisten Männer, die ich kenne, würden versuchen, mit einer so schönen Frau wie [kat] Sex zu haben, ohne an ihre Gefühle zu denken."

# game/scripts/c28/c28.rpy:2898
translate german c28s006_KimOnKate_972349e3:

    # kim "Tú intentas saber cuáles son esos sentimientos antes de hacer nada. Muy encomiable por tu parte."
    kim "Du versuchst, diese Gefühle zu verstehen, bevor du irgendetwas tust. Das ist sehr lobenswert von dir."

# game/scripts/c28/c28.rpy:2899
translate german c28s006_KimOnKate_7bfebbd8:

    # mc "Hacer daño a alguien gratuitamente es una de las cosas que más odio."
    mc "Jemanden grundlos zu verletzen, ist eines der Dinge, die ich am meisten hasse."

# game/scripts/c28/c28.rpy:2904
translate german c28s006_KimOnKate_0b07b60c:

    # kim "Lo entiendo."
    kim "Ich verstehe."

# game/scripts/c28/c28.rpy:2905
translate german c28s006_KimOnKate_d3a6c09e:

    # kim "[kat] está en una encrucijada emocional ahora mismo. Se ha pasado años construyendo un castillo anti-hombres alrededor de sus sentimientos."
    kim "[kat] befindet sich gerade an einem emotionalen Wendepunkt. Sie hat jahrelang eine Art Männerburg um ihre Gefühle errichtet."

# game/scripts/c28/c28.rpy:2906
translate german c28s006_KimOnKate_be3da2dc:

    # kim "Y has llegado tú y has abierto una brecha en las murallas con gestos amables y tratándola como si fuera una chica normal."
    kim "Und dann kamst du und hast mit freundlichen Gesten und indem du sie wie ein normales Mädchen behandelt hast, diese Mauern durchbrochen."

# game/scripts/c28/c28.rpy:2907
translate german c28s006_KimOnKate_3fee3191:

    # mc "Es una chica normal..."
    mc "Sie ist ein ganz normales Mädchen..."

# game/scripts/c28/c28.rpy:2912
translate german c28s006_KimOnKate_305867b0:

    # kim "Ella no es normal; es especial. Detrás de ese sentido del humor caustico hay una chica muy sensible."
    kim "Sie ist nicht normal; sie ist besonders. Hinter ihrem bissigen Humor verbirgt sich ein sehr sensibles Mädchen."

