    mom "Du weißt ja, dass <c4 diese Angewohnheit hat, alles anzufassen..."

# game/scripts/c28/c28.rpy:1931
translate german c28s004_ScaGetsJob_ad4d9d5e:

    # sca "¿Ha usado ese dónut como anillo de compromiso?"
    sca "Hat sie den Donut als Verlobungsring benutzt?"

# game/scripts/c28/c28.rpy:1933
translate german c28s004_ScaGetsJob_2fa788e8:

