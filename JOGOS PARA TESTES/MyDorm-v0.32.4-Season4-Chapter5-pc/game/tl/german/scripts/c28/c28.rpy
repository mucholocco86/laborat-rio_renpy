    sim "Marks. Willst du mich heiraten? Ich habe im Moment keinen Ring, den ich dir geben könnte, aber ich wollte es gern."

# game/scripts/c28/c28.rpy:1230
translate german c28s003_SimLewd_2a3c2631:

    # mc "¿Qué? ¿De verdad? ¿No debería hacer eso yo?"
    mc "Was? Wirklich? Sollte ich das nicht tun?"

# game/scripts/c28/c28.rpy:1234
translate german c28s003_SimLewd_bdab4527:

    # sim "No es necesario, no tienes que pedírnoslo tú a todas."
    sim "Das ist nicht nötig, Sie müssen nicht jeden von uns fragen."

# game/scripts/c28/c28.rpy:1236
translate german c28s003_SimLewd_7fb9c4f7:

    # sim "Llevas dos, y dicen que el tres es un número muy importante, ¿no?"
    sim "Du hast zwei, und man sagt, drei sei eine sehr wichtige Zahl, richtig?"

# game/scripts/c28/c28.rpy:1239
translate german c28s003_SimLewd_e0b3fdae:

    # sim "Después de lo de [kia], esperaba que me lo pidieras tarde o temprano. Prefiero no esperar."
    sim "Nach dem, was mit [kia] passiert ist, habe ich erwartet, dass du mich früher oder später fragen würdest. Ich möchte lieber nicht warten."

# game/scripts/c28/c28.rpy:1241
translate german c28s003_SimLewd_c2b5ecb2:

