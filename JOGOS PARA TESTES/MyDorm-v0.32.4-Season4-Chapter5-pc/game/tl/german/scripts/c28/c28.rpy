

# game/scripts/c28/c28.rpy:44
translate german c28s001_foursome_337cb758:

    # mc "No dudéis ni por un momento que esos regalos se vayan a quedar sin abrir."
    mc "Zweifeln Sie nicht einen Moment daran, dass diese Geschenke ungeöffnet bleiben werden."

# game/scripts/c28/c28.rpy:46
translate german c28s001_foursome_33108e94:

    # "Te acercas a [sai] y la besas apasionadamente. Su cuerpo vibra bajo tus manos."
    "Du näherst dich ihr und küsst sie leidenschaftlich. Ihr Körper zittert unter deinen Händen."

# game/scripts/c28/c28.rpy:47
translate german c28s001_foursome_4d2b9ef6:

    # "Sabes que está excitada por lo que está a punto de pasar. Hablasteis varias veces de hacer un trío mientras estabais en Portland."
    "Du weißt, dass sie sich auf das freut, was gleich passieren wird. Ihr habt mehrmals darüber gesprochen, einen Dreier zu haben, als ihr in Portland wart."

# game/scripts/c28/c28.rpy:48
translate german c28s001_foursome_d1741da1:

    # "Nunca surgió la oportunidad o nunca encontrasteis a la chica adecuada. Nunca se planteó hacer un trío con un chico."
    "Es ergab sich nie die Gelegenheit, oder du hast nie die Richtige gefunden. Die Idee eines Dreiers mit einem Mann kam dir gar nicht in den Sinn."

# game/scripts/c28/c28.rpy:49
translate german c28s001_foursome_cf3c7d87:

    # "Ahora, su primera experiencia de sexo en grupo va a ser con dos mujeres a las que ha empezado a considerar más que amigas."
    "Nun wird sein erstes Gruppensex-Erlebnis mit zwei Frauen stattfinden, die er mittlerweile als mehr als nur Freundinnen betrachtet."

# game/scripts/c28/c28.rpy:51
translate german c28s001_foursome_12a1ca43:

    # sai "Creo que hay una perra pelirroja esperando su beso. *Risa*"
    sai "Ich glaube, da wartet eine rothaarige Zicke auf ihren Kuss. *lacht*"

# game/scripts/c28/c28.rpy:52
translate german c28s001_foursome_18cfed98:

    # sai "*Risa* Después de las bromas que hemos hecho sobre sacarle los ojos, no quiero que use mis ideas contra mí."
    sai "*Lacht* Nach den Witzen, die wir darüber gemacht haben, ihm die Augen auszustechen, will ich nicht, dass er meine Ideen gegen mich verwendet."

# game/scripts/c28/c28.rpy:53
translate german c28s001_foursome_0dede26d:

    # mc "No queremos que esos preciosos ojos oscuros acaben en un tarro, ¿no?"
    mc "Wir wollen doch nicht, dass diese kostbaren dunklen Augen am Ende in einem Glas landen, oder?"

# game/scripts/c28/c28.rpy:55
translate german c28s001_foursome_036484d0:

    # eil "No se los sacaría a ella. *Risa* Recuerda que soy la Primera Concubina del harén."
    eil "Ich würde sie ihr nicht wegnehmen. *lacht* Vergiss nicht, ich bin die Erste Konkubine des Harems."

# game/scripts/c28/c28.rpy:56
translate german c28s001_foursome_f79a4b9d:

    # eil "*Risa* Si no soy importante para el sultán, quizás sean sus ojos los que acaben en un tarro."
    eil "*Lacht* Wenn ich dem Sultan nicht wichtig bin, landen vielleicht seine Augen am Ende in einem Einmachglas."

# game/scripts/c28/c28.rpy:57
translate german c28s001_foursome_5422e68e:

    # mc "¡Vamos, [eil]! Te juro que, en este momento, lo significas todo."
    mc "Komm schon, [eil]! Ich schwöre, du bedeutest mir gerade alles."

# game/scripts/c28/c28.rpy:58
translate german c28s001_foursome_93048d5f:

    # mc "Las tres lo significáis todo."
    mc "Ihr drei bedeutet mir alles."

# game/scripts/c28/c28.rpy:60
translate german c28s001_foursome_0fef0510:

    # oma "*Risa* ¿Y tus pensamientos se vuelven impuros al verla vestida así?"
    oma "*lacht* Und werden Ihre Gedanken unrein, wenn Sie sie so gekleidet sehen?"

# game/scripts/c28/c28.rpy:61
translate german c28s001_foursome_433125eb:

    # mc "*Risa* Al veros a las tres. Pero dame un momento antes de que la Primera Concubina me saque los ojos."
    mc "*Gelächter* Euch drei zu sehen, ist ja herrlich. Aber gebt mir einen Moment, bevor mir die erste Konkubine die Augen aussticht."

# game/scripts/c28/c28.rpy:63
translate german c28s001_foursome_35737497:

    # "Coges a la hermosa pelirroja entre tus brazos y tus labios encuentran los suyos, entreabiertos para recibir tu lengua."
    "Du nimmst die schöne Rothaarige in deine Arme und deine Lippen finden ihre, die sich leicht öffnen, um deine Zunge aufzunehmen."

# game/scripts/c28/c28.rpy:64
translate german c28s001_foursome_f82359bd:

    # "Su respiración transmite tanta excitación como los temblores de [sai]. No eres el único que está excitado por lo que va a pasar."
    "Sein Atem verrät genauso viel Aufregung wie [sai]s Zittern. Du bist nicht der Einzige, der gespannt auf das ist, was gleich passieren wird."

# game/scripts/c28/c28.rpy:65
translate german c28s001_foursome_fec024e6:

    # "Va a ser su segundo sexo en grupo después de estar con [oma] en el bosque. Se pasó días hablando de aquel trío." id c28s001_foursome_fec024e6
    "Es wird ihre zweite Gruppensex-Session sein, nachdem sie mit [oma] im Wald war. Sie hat tagelang über diesen Dreier gesprochen." id c28s001_foursome_fec024e6

# game/scripts/c28/c28.rpy:66
translate german c28s001_foursome_2899cfe0:

    # "Aquello lo propició ella, y esto parece que también. Adoras a [eil]."
    "Das hat sie verursacht, und anscheinend auch das. Du liebst [eil]."

# game/scripts/c28/c28.rpy:68
translate german c28s001_foursome_b13c298f:

    # eil "Creo que es el momento de que beses a nuestra policía o es capaz de arrestarnos a todos."
    eil "Ich glaube, es wird Zeit, dass du unsere Polizisten küsst, sonst sind sie noch in der Lage, uns alle zu verhaften."

# game/scripts/c28/c28.rpy:69
translate german c28s001_foursome_cdc0b5f4:

    # mc "Yo no lo recomiendo. Las esposas son bastante incómodas."
    mc "Ich kann es nicht empfehlen. Die Handschellen sind ziemlich unbequem."

# game/scripts/c28/c28.rpy:71
translate german c28s001_foursome_7e9b4743:

    # oma "*Risa* Sabes que te las puedes quitar cuando quieras, ¿verdad?"
    oma "*lacht* Du weißt schon, dass du sie jederzeit ausziehen kannst, oder?"

# game/scripts/c28/c28.rpy:72
translate german c28s001_foursome_3054f9de:

    # mc "*Risa* Esperaba a que me dieras permiso para hacerlo. Decidimos probar y no es lo mío."
    mc "*Lacht* Ich habe auf deine Erlaubnis gewartet. Wir haben beschlossen, es auszuprobieren, aber es ist nicht so mein Ding."

# game/scripts/c28/c28.rpy:73
translate german c28s001_foursome_d8eac6ef:

    # oma "Tampoco lo mío. Prefiero sentir tus manos recorriendo mi piel."
    oma "Das ist auch nichts für mich. Ich spüre lieber deine Hände auf meiner Haut."

# game/scripts/c28/c28.rpy:75
translate german c28s001_foursome_2c5be866:

    # "Después de quitarte las esposas, abrazas fuertemente a [oma] mientras vuestros labios se unen otra vez."
    "Nachdem du deine Handschellen abgenommen hast, umarmst du [oma] fest, und eure Lippen berühren sich wieder."

# game/scripts/c28/c28.rpy:76
translate german c28s001_foursome_11c8dab9:

    # "Hace diez minutos que la tenías entre tus brazos y hace nueve que la echabas de menos."
    "Vor zehn Minuten hattest du sie noch in deinen Armen, und vor neun Minuten hast du sie schon vermisst."

# game/scripts/c28/c28.rpy:77
translate german c28s001_foursome_18befd20:

    # "Su cuerpo reacciona diferente a las otras dos mujeres, más tranquila después de haberte tenido para ella sola hace un rato."
    "Ihr Körper reagiert anders auf die anderen beiden Frauen, ruhiger, nachdem sie dich vor einer Weile ganz für sich allein hatte."

# game/scripts/c28/c28.rpy:79
translate german c28s001_foursome_6958b37c:

    # sai "¿Vamos a caber todos en esa cama? Me parece un poco pequeña, ¿no?"
    sai "Passen wir alle in dieses Bett? Es scheint etwas klein zu sein, nicht wahr?"

# game/scripts/c28/c28.rpy:80
translate german c28s001_foursome_c447616a:

    # mc "No te preocupes, encontraremos la forma de hacerlo."
    mc "Keine Sorge, wir finden einen Weg."

# game/scripts/c28/c28.rpy:82
translate german c28s001_foursome_c4df37b5:

    # oma "Creo que [sai] tiene razón. Id ocupándoos de nuestro invitado mientras yo hago algo."
    oma "Ich glaube, [sai] hat Recht. Kümmert euch alle um unseren Gast, während ich etwas erledige."

# game/scripts/c28/c28.rpy:83
translate german c28s001_foursome_e13094b8:

    # mc "¿Qué vas a hacer?"
    mc "Was werden Sie tun?"

# game/scripts/c28/c28.rpy:84
translate german c28s001_foursome_3e896faf:

    # oma "Voy a probar algo. Intenta no correrte antes de que vuelva."
    oma "Ich werde etwas versuchen. Komm bitte nicht, bevor ich zurück bin."

# game/scripts/c28/c28.rpy:85
translate german c28s001_foursome_22294bf2:

    # mc "Creo que va a ser complicado con las dos fierecillas."
    mc "Ich glaube, mit den beiden kleinen Wildfängen wird es kompliziert werden."

# game/scripts/c28/c28.rpy:87
translate german c28s001_foursome_14a0ac8a:

    # eil "No prometemos nada, pero, de momento, túmbate. Mjolnir ya está preparado para nosotras."
    eil "Wir versprechen nichts, aber legt euch jetzt erst einmal hin. Mjölnir ist bereit für uns."

# game/scripts/c28/c28.rpy:88
translate german c28s001_foursome_70b1251d:

    # mc "*Risa* ¿No puedo desenvolver mis regalos?"
    mc "*lacht* Darf ich meine Geschenke nicht auspacken?"

# game/scripts/c28/c28.rpy:90
translate german c28s001_foursome_44bec75e:

    # sai "Habrá tiempo para eso. Pero nuestro regalo ya está desenvuelto y no queremos desaprovecharlo."
    sai "Dafür wird es noch Zeit geben. Aber unser Geschenk ist bereits ausgepackt, und wir wollen es nicht vergeuden."

# game/scripts/c28/c28.rpy:91
translate german c28s001_foursome_f8da55b5:

    # sai "Por una vez, te toca obedecer órdenes y estar calladito."
    sai "Diesmal bist du an der Reihe, Befehle zu befolgen und still zu sein."

# game/scripts/c28/c28.rpy:92
translate german c28s001_foursome_84d5be27:

    # mc "Entonces me tendré que tumbar. ¿De verdad tengo que estar callado?"
    mc "Dann muss ich mich hinlegen. Muss ich wirklich leise sein?"

# game/scripts/c28/c28.rpy:95
translate german c28s001_foursome_31502197:

    # sai "Y no empieces a discutir." (multiple=2)
    sai "Und fangt bloß nicht an zu streiten." (multiple=2)

# game/scripts/c28/c28.rpy:96
translate german c28s001_foursome_d7dcc00f:

    # eil "Puedes hablar, pero poco." (multiple=2)
    eil "Man kann reden, aber nicht viel." (multiple=2)

# game/scripts/c28/c28.rpy:98
translate german c28s001_foursome_51368258:

    # mc "Vale. Hablar poco y no discutir. Creo que puedo hacerlo."
    mc "Okay. Wenig reden und nicht streiten. Ich denke, das schaffe ich."

# game/scripts/c28/c28.rpy:101
translate german c28s001_foursome_bb5392c0:

    # sai "¿Qué le hacemos?"
    sai "Was können wir dagegen tun?"

# game/scripts/c28/c28.rpy:102
translate german c28s001_foursome_4beb54ea:

    # eil "Creo que lo que hablamos anoche estaría bien para empezar. Aunque falte [oma.nick]..."
    eil "Ich denke, unser gestriges Gespräch wäre ein guter Ausgangspunkt. Auch wenn [oma.nick] fehlt..."

# game/scripts/c28/c28.rpy:103
translate german c28s001_foursome_c46edd51:

    # mc "¿Habláis de lo que me vais a hacer cuando compartís habitación?"
    mc "Meinst du, was du mit mir anstellen wirst, wenn wir uns ein Zimmer teilen?"

# game/scripts/c28/c28.rpy:105
translate german c28s001_foursome_6f0a3e5c:

    # sai "¡Por supuesto! Entre otras muchas cosas." (multiple=2)
    sai "Selbstverständlich! Unter anderem." (multiple=2)

# game/scripts/c28/c28.rpy:106
translate german c28s001_foursome_0d0ccedb:

    # eil "¿Qué te hemos dicho de estar callado?" (multiple=2)
    eil "Was haben wir Ihnen über das Schweigen gesagt?" (multiple=2)

# game/scripts/c28/c28.rpy:107
translate german c28s001_foursome_e2011828:

    # mc "Pero me parece un tema muy interesante... Mis chicas hablando de mí..."
    mc "Aber ich finde das ein sehr interessantes Thema... Meine Töchter reden über mich..."

# game/scripts/c28/c28.rpy:109
translate german c28s001_foursome_53460904:

    # sai "No hablamos sólo de ti, pero cuando [eil] propuso hacer esto, empezamos a fantasear..."
    sai "Wir sprachen nicht nur über dich, aber als [eil] das vorschlug, fingen wir an zu fantasieren..."

# game/scripts/c28/c28.rpy:110
translate german c28s001_foursome_724d119b:

    # eil "No esperábamos que la oportunidad llegara tan pronto, con lo que los planes son un poco... vagos."
    eil "Wir hatten nicht erwartet, dass sich diese Gelegenheit so schnell ergeben würde, daher sind die Pläne noch etwas... vage."

# game/scripts/c28/c28.rpy:111
translate german c28s001_foursome_ea009b6c:

    # mc "*Risa* Estoy seguro de que no me voy a quejar por ello."
    mc "*Lacht* Ich bin mir sicher, dass ich mich darüber nicht beschweren werde."

# game/scripts/c28/c28.rpy:114
translate german c28s001_foursome_74467882:

    # eil "Eso espero. Esto siempre te encantó, pero me faltaban manos."
    eil "Ich hoffe es. Du hast das immer geliebt, aber mir fehlten die Hände."

# game/scripts/c28/c28.rpy:115
translate german c28s001_foursome_02775026:

    # "Mientras [sai] te masturba y te acaricia los huevos, [eil] se dedica a acariciarte y a excitar tu glande con sus dedos."
    "Während [sai] dich masturbiert und deine Hoden streichelt, ist [eil] damit beschäftigt, deine Eichel mit seinen Fingern zu streicheln und zu erregen."

# game/scripts/c28/c28.rpy:116
translate german c28s001_foursome_493e96c9:

    # sai "A mí me pasaba lo mismo. Soy India, pero no soy Kali."
    sai "Mir ist dasselbe passiert. Ich bin Inderin, aber ich bin nicht Kali."

# game/scripts/c28/c28.rpy:117
translate german c28s001_foursome_19d1a60f:

    # "Notar las cuatro manos de las dos mujeres recorriendo tu cuerpo a la vez es una sensación increíble."
    "Das Gefühl, gleichzeitig die vier Hände zweier Frauen über den eigenen Körper streichen zu spüren, ist ein unglaubliches Erlebnis."

# game/scripts/c28/c28.rpy:118
translate german c28s001_foursome_db1dbd6d:

    # mc "¿Qué tiene que ver tu prima en esto?"
    mc "Was hat dein Cousin damit zu tun?"

# game/scripts/c28/c28.rpy:119
translate german c28s001_foursome_18c65b38:

    # sai "He dicho Kali, no [kal.nick]."
    sai "Ich sagte Kali, nicht [kal.nick]."

# game/scripts/c28/c28.rpy:120
translate german c28s001_foursome_350ff9b9:

    # "No notas la diferencia en la pronunciación. Pero en ese momento te da lo mismo."
    "Man bemerkt den Unterschied in der Aussprache nicht. Aber in diesem Moment spielt das keine Rolle."

# game/scripts/c28/c28.rpy:125
translate german c28s001_foursome_4229e796:

    # "En ese momento lo que echas de menos es un espejo en el techo y poder observar los cuerpos de las dos mujeres."
    "Was Ihnen in diesem Moment fehlt, ist ein Spiegel an der Decke, in dem Sie die Körper der beiden Frauen betrachten könnten."

# game/scripts/c28/c28.rpy:126
translate german c28s001_foursome_91c5f63a:

    # "Cuerpos muy diferentes, pero los dos preciosos. Los conoces a la perfección, pero nunca te cansarás de ellos."
    "Ganz unterschiedliche Körper, aber beide wunderschön. Du kennst sie in- und auswendig, aber du wirst dich nie an ihnen sattsehen."

# game/scripts/c28/c28.rpy:127
translate german c28s001_foursome_053be75c:

    # eil "¿Qué tal? ¿Cómo te sientes manoseado por dos mujeres a la vez?"
    eil "Wie läuft's? Wie fühlt es sich an, von zwei Frauen gleichzeitig begrapscht zu werden?"

# game/scripts/c28/c28.rpy:128
translate german c28s001_foursome_2b35b6fe:

    # mc "..."
    mc "..."

# game/scripts/c28/c28.rpy:129
translate german c28s001_foursome_cfaeb64e:

    # sai "*Risa* Le hemos dicho que esté callado y creo que nos va a hacer caso. Puedes contestar."
    sai "*Gelächter* Wir haben ihm gesagt, er soll leise sein, und ich glaube, er wird darauf hören. Du kannst antworten."

# game/scripts/c28/c28.rpy:130
translate german c28s001_foursome_7f5b67a9:

    # mc "¿Mi ex-novia del instituto y mi ex-no-novia de la universidad jugando con Mjolnir? Creo que hay pocas cosas mejores. Al menos hasta que se una [oma]."
    mc "Meine Ex-Freundin aus der Highschool und meine damalige Nicht-Freundin aus dem College spielen mit Mjölnir? Ich glaube, es gibt wenige Dinge, die schöner sind. Zumindest bis zu einem [oma]."

# game/scripts/c28/c28.rpy:131
translate german c28s001_foursome_14362538:

    # sai "¡No me recuerdes lo tonta que fui! Y menos ahora que yo tengo el poder."
    sai "Erinnere mich nicht daran, wie dumm ich war! Vor allem nicht jetzt, wo ich die Macht habe."

# game/scripts/c28/c28.rpy:132
translate german c28s001_foursome_32a534d6:

    # "[sai] aprieta tus huevos entre sus dedos en un gesto juguetón. Lejos de ser doloroso, es sólo un pequeño aviso de que no te metas con ella."
    "[sai] Sie drückt spielerisch deine Hoden zwischen ihren Fingern. Es ist keineswegs schmerzhaft, sondern nur eine sanfte Warnung, sich nicht mit ihr anzulegen."

# game/scripts/c28/c28.rpy:133
translate german c28s001_foursome_3b4e2eca:

    # "Siempre le ha gustado tener el poder. O al menos una ilusión de poder que nunca ha utilizado."
    "Er hat Macht schon immer gemocht. Oder zumindest eine Illusion von Macht, die er nie ausgeübt hat."

# game/scripts/c28/c28.rpy:137
translate german c28s001_foursome_d9ae582f:

    # eil "Bueno, ahora las dos somos tus novias y no vamos a cometer los mismos errores que cometimos, ni siquiera cuando te marches."
    eil "Nun sind wir beide deine Freundinnen und wir werden nicht dieselben Fehler machen wie wir, auch nicht, wenn du gehst."

# game/scripts/c28/c28.rpy:138
translate german c28s001_foursome_ffb2f160:

    # "Tienen más en común de lo que les hubiera gustado aceptar hace unas semanas. Tu relación a distancia con [eil] no funcionó."
    "Sie haben mehr gemeinsam, als sie vor ein paar Wochen noch zugeben wollten. Deine Fernbeziehung mit [eil] hat nicht funktioniert."

# game/scripts/c28/c28.rpy:139
translate german c28s001_foursome_80c693c2:

    # "La de [sai] no llegó a existir por su miedo a una relación a distancia. Ahora pasaréis meses separados, pero esta vez no habrá rupturas."
    "Die Beziehung mit [sai] kam nie zustande, weil sie Angst vor einer Fernbeziehung hatte. Jetzt werdet ihr monatelang getrennt sein, aber dieses Mal wird es keine Trennung geben."

# game/scripts/c28/c28.rpy:140
translate german c28s001_foursome_319131b9:

    # sai "¡Céntrate, [eil]! ¡No hables de cosas tristes! Y tú no contestes. Relájate y disfruta."
    sai "Konzentrier dich, [eil]! Sprich nicht über traurige Dinge! Und antworte nicht. Entspann dich und genieße es."

# game/scripts/c28/c28.rpy:141
translate german c28s001_foursome_7b55e9fd:

    # "No pensabas contestar. Tener a las dos mujeres produciendo sensaciones increíbles en tu polla no te deja mucho espacio para pensar en una respuesta ingeniosa."
    "Du hattest nicht vor zu antworten. Da beide Frauen unglaubliche Empfindungen an deinem Penis auslösten, blieb dir kaum Zeit, dir eine geistreiche Antwort auszudenken."

# game/scripts/c28/c28.rpy:142
translate german c28s001_foursome_dc34ba8e:

    # "Prefieres disfrutar de cada roce de sus dedos y mantenerte callado."
    "Du genießt jede Berührung ihrer Finger und bleibst still."

# game/scripts/c28/c28.rpy:145
translate german c28s001_foursome_06a8f39d:

    # oma "Ya está. Ya podéis venir."
    oma "Das war's. Du kannst jetzt kommen."

# game/scripts/c28/c28.rpy:146
translate german c28s001_foursome_8a7b9a6f:

    # mc "¿A dónde? ¿Qué has hecho?"
    mc "Wohin? Was hast du getan?"

# game/scripts/c28/c28.rpy:147
translate german c28s001_foursome_4922e44b:

    # oma "Ya lo verás. Chicas, dejad a Mjolnir un rato."
    oma "Ihr werdet schon sehen. Mädels, lasst Mjölnir erstmal in Ruhe."

# game/scripts/c28/c28.rpy:149
translate german c28s001_foursome_468046f0:

    # eil "Has aguantado como un campeón sin correrte."
    eil "Du hast wie ein Champion durchgehalten, ohne überhaupt anzutreten."

# game/scripts/c28/c28.rpy:150
translate german c28s001_foursome_7043cf46:

    # sai "*Risita* Me ha costado mantener el ritmo lento. Hubiera sido egoísta por nuestra parte hacer que te corrieras antes de que volviera [oma]."
    sai "*Kichern* Es war schwer, das langsame Tempo durchzuhalten. Es wäre egoistisch von uns gewesen, dich kommen zu lassen, bevor ich zurück bin."

# game/scripts/c28/c28.rpy:151
translate german c28s001_foursome_9b2a6dbd:

    # mc "*Risa* Sabéis que sois unas perras malas, ¿verdad?"
    mc "*lacht* Ihr wisst schon, dass ihr coole Weiber seid, oder?"

# game/scripts/c28/c28.rpy:153
translate german c28s001_foursome_a1dfcffe:

    # eil "*Risa* Yo sí. [sai] me lo recuerda cada día."
