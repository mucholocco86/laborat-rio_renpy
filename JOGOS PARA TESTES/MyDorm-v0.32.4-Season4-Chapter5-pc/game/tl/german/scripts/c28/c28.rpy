    mc "So dumm kann er ja nicht sein, wenn er dich heiraten will, oder?"

# game/scripts/c28/c28.rpy:1223
translate german c28s003_SimLewd_fad6969a:

    # sim "Creo que me he adelantado y no te he dejado pedírmelo."
    sim "Ich glaube, ich bin voreilig gewesen und habe dich nicht fragen lassen."

# game/scripts/c28/c28.rpy:1224
translate german c28s003_SimLewd_93313e24:

