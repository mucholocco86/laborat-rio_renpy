    dap "Hast du Donuts gebacken, Tante [mar]? Darf ich einen haben?"

# game/scripts/c28/c28.rpy:1922
translate german c28s004_ScaGetsJob_4b47a0bd:

    # mom "¡No! ¡Ese no!"
    mom "Nein! Nicht der!"

# game/scripts/c28/c28.rpy:1924
translate german c28s004_ScaGetsJob_4b174f98:

    # dap "¿Qué le pasa a este dónut?"
    dap "Was stimmt mit diesem Donut nicht?"

# game/scripts/c28/c28.rpy:1925
