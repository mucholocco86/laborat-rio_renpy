    eil "*Stöhn* Das war unglaublich... *Schnapp* Bei dir ist es immer unglaublich..."

# game/scripts/c28/c28.rpy:985
translate german c28s001_analEil_a4be01f3:

    # eil "*Jadeo* Voy a necesitar algo con lo que limpiarme o se va a salir todo cuando me levante... Y voy a inundar el edredón."
    eil "*Schnappatmung* Ich brauche etwas, um mich zu reinigen, sonst kommt alles wieder raus, wenn ich aufstehe... Und ich werde die Bettdecke einweichen."

# game/scripts/c28/c28.rpy:987
translate german c28s001_analEil_bb5b7194:

    # mc "Chicas, ¿podéis traer algo para limpiarnos, por favor?"
    mc "Mädchen, könntet ihr uns bitte etwas zum Aufräumen bringen?"

# game/scripts/c28/c28.rpy:988
translate german c28s001_analEil_3e10341c:

    # sai "¡Voy!"
    sai "Gehen!"

# game/scripts/c28/c28.rpy:989
translate german c28s001_analEil_5f113aa8:

    # oma "Hay servilletas de papel en la cocina."
    oma "In der Küche liegen Papierservietten bereit."

# game/scripts/c28/c28.rpy:993
translate german c28s001_vaginalEil_6082d9cb:

    # mc "¡Mpfft!"
    mc "Mpfft!"

# game/scripts/c28/c28.rpy:994
translate german c28s001_vaginalEil_4477732b:

    # "Explotas dentro del coño de [eil], llenándole el estrecho agujero con tu leche. Sorprendido de la cantidad que aún eres capaz de eyacular." id c28s001_vaginalEil_4477732b
    "Du ejakulierst in [eil]s Vagina und füllst ihr enges Loch mit deinem Sperma. Du bist überrascht, wie viel du noch ejakulieren kannst." id c28s001_vaginalEil_4477732b

# game/scripts/c28/c28.rpy:995
translate german c28s001_vaginalEil_3d8f181c:

    # eil "*GEMIDO* ¡SÍ! *JADEO* ¡DÁMELA TODA! *GEMIDO* ¡LLÉNAME! *JADEO*"
    eil "*STÖH* JA! *KEUCHEND* GIB MIR ALLES! *STÖHND* FÜLL MICH! *KEUCHEND*"

# game/scripts/c28/c28.rpy:996
translate german c28s001_vaginalEil_e2f8a4a8:

    # "Y la llenas. Hasta que algo se escapa a través de su estrecho coño y de Mjolnir actuando como tapón." id c28s001_vaginalEil_e2f8a4a8
    "Und du füllst sie auf. Bis etwas durch ihre enge Muschi austritt und Mjölnir als Stopfen dient." id c28s001_vaginalEil_e2f8a4a8

# game/scripts/c28/c28.rpy:998
translate german c28s001_vaginalEil_2ec6cef1:

    # eil "*Gemido* Ha sido increíble... *Jadeo* Siempre es increíble contigo..."
    eil "*Stöhn* Das war unglaublich... *Schnapp* Bei dir ist es immer unglaublich..."

# game/scripts/c28/c28.rpy:999
translate german c28s001_vaginalEil_a4be01f3:

    # eil "*Jadeo* Voy a necesitar algo con lo que limpiarme o se va a salir todo cuando me levante... Y voy a inundar el edredón."
    eil "*Schnappatmung* Ich brauche etwas, um mich zu reinigen, sonst kommt alles wieder raus, wenn ich aufstehe... Und ich werde die Bettdecke einweichen."

# game/scripts/c28/c28.rpy:1001
translate german c28s001_vaginalEil_bb5b7194:

    # mc "Chicas, ¿podéis traer algo para limpiarnos, por favor?"
    mc "Mädchen, könntet ihr uns bitte etwas zum Aufräumen bringen?"

# game/scripts/c28/c28.rpy:1002
translate german c28s001_vaginalEil_3e10341c:

    # sai "¡Voy!"
    sai "Gehen!"

# game/scripts/c28/c28.rpy:1003
translate german c28s001_vaginalEil_5f113aa8:

    # oma "Hay servilletas de papel en la cocina."
    oma "In der Küche liegen Papierservietten bereit."

# game/scripts/c28/c28.rpy:1007
translate german c28s001_noFoursome_fe27b9a3:

    # "Al volver a casa, [eil] te dice que la entrevista de [sca] ha ido bien. Mañana le dirán algo sobre el trabajo."
    "Nach ihrer Rückkehr nach Hause teilt [eil] Ihnen mit, dass das Vorstellungsgespräch von [sca] gut verlaufen ist. Sie werden morgen etwas über die Stelle erfahren."

# game/scripts/c28/c28.rpy:1009
translate german c28s001_noFoursome_21f6375b:

    # "Subes a tu habitación y juegas un rato a My Residence antes de cenar."
    "Du gehst auf dein Zimmer und spielst vor dem Abendessen noch eine Weile My Residence."

# game/scripts/c28/c28.rpy:1010
translate german c28s001_noFoursome_b909fe44:

    # "Tienes una tórrida escena de sexo en grupo con Aishwarya, Alejandra, y Laoise."
    "Es gibt eine heiße Gruppensexszene mit Aishwarya, Alejandra und Laoise."

# game/scripts/c28/c28.rpy:1011
translate german c28s001_noFoursome_4aae1ba2:

    # "Aishwarya y Laoise no intentan sacarse los ojos la una a la otra."
    "Aishwarya und Laoise versuchen nicht, sich gegenseitig die Augen auszustechen."

# game/scripts/c28/c28.rpy:1012
translate german c28s001_noFoursome_b52c336b:

    # "Laoise incluso acaba descubriendo que tiene cierta curiosidad por cómo sabe el coño de su amiga."
    "Laoise entdeckt schließlich sogar, dass sie ein wenig neugierig darauf ist, wie die Vagina ihrer Freundin schmeckt."

# game/scripts/c28/c28.rpy:1021
translate german c28s002_Kim_0b13330a:

    # "Después de cenar, tras ayudar a [nor] a recoger la cocina, mientras vuelves hacia tu habitación..."
    "Nach dem Abendessen, nachdem du [nor] beim Aufräumen der Küche geholfen hast, gehst du zurück in dein Zimmer..."

# game/scripts/c28/c28.rpy:1022
translate german c28s002_Kim_a601a6ca:

    # mc "Hey, [kim]. ¿Qué haces aquí?"
    mc "Hey, [kim]. Was machst du hier?"

# game/scripts/c28/c28.rpy:1023
translate german c28s002_Kim_2369d178:

    # kim "Estoy esperando a las chicas. Vamos a dar un paseo por la carretera para bajar la cena."
    kim "Ich warte auf die Mädchen. Wir machen einen Spaziergang die Straße entlang, um unser Abendessen zu verdauen."

# game/scripts/c28/c28.rpy:1024
translate german c28s002_Kim_baebb2a0:

    # kim "Han ido a ponerse calzado cómodo."
    kim "Sie gingen, um bequeme Schuhe anzuziehen."

# game/scripts/c28/c28.rpy:1025
translate german c28s002_Kim_28a0b0ab:

    # mc "¿Una nueva costumbre?"
    mc "Ein neuer Brauch?"

# game/scripts/c28/c28.rpy:1027
translate german c28s002_Kim_d265cee6:

    # kim "*Risa* Todas nos hemos engordado un par de libras como mínimo desde que llegamos."
    kim "*Gelächter* Wir haben alle mindestens ein paar Pfund zugenommen, seit wir angekommen sind."

# game/scripts/c28/c28.rpy:1029
translate german c28s002_Kim_8600849f:

    # kim "Todas menos [kat], claro."
    kim "Alle außer [kat], natürlich."

# game/scripts/c28/c28.rpy:1030
translate german c28s002_Kim_8149f8bb:

    # kim "Hoy hemos decidido que daremos un paseo cada noche. [kat] es la única que ha decidido no apuntarse."
    kim "Heute haben wir beschlossen, jeden Abend spazieren zu gehen. [kat] ist die einzige Person, die sich entschieden hat, nicht mitzukommen."

# game/scripts/c28/c28.rpy:1031
translate german c28s002_Kim_5458bceb:

    # mc "*Risa* Comer todos los días la comida de [mar] y [nor] tiene efectos secundarios."
    mc "*Lachen* Der tägliche Verzehr von [mar] und [nor]'s Essen hat Nebenwirkungen."

# game/scripts/c28/c28.rpy:1032
translate german c28s002_Kim_95d5c3d9:

    # mc "Hablando de [kat], ¿sabes si está enfadada conmigo? Lleva evitándome desde la no-cita."
    mc "Wo wir gerade von [kat] sprechen, weißt du, ob sie sauer auf mich ist? Sie geht mir aus dem Weg, seit das Date geplatzt ist."

# game/scripts/c28/c28.rpy:1034
translate german c28s002_Kim_c4248889:

    # kim "*Susurrando* Ahora no es un buen momento para hablar de eso, [mc]. Podría estar detrás de la puerta esperando al resto de las chicas."
    kim "*Flüsternd* Jetzt ist kein guter Zeitpunkt, darüber zu reden, [mc]. Sie könnte hinter der Tür auf die anderen Mädchen warten."

# game/scripts/c28/c28.rpy:1035
translate german c28s002_Kim_7522274c:

    # mc "Eso que estás diciendo significa que algo pasa, ¿no?"
    mc "Was du sagst, deutet darauf hin, dass etwas nicht stimmt, richtig?"

# game/scripts/c28/c28.rpy:1036
translate german c28s002_Kim_20e20485:

    # kim "*Susurrando* Sí, pero será mejor que lo hablemos mañana."
    kim "*Flüsternd* Ja, aber es ist besser, wenn wir morgen darüber reden."

# game/scripts/c28/c28.rpy:1037
translate german c28s002_Kim_f5271567:

    # mc "Me parece una buena idea."
    mc "Ich finde das eine gute Idee."

# game/scripts/c28/c28.rpy:1041
translate german c28s002_Kim_99ac3d3d:

    # kim "Cambiando de tema, te invito a comer el viernes. Acabo las clases a mediodía y podríamos hacer algo."
    kim "Um das Thema zu wechseln: Ich möchte Sie am Freitag zum Mittagessen einladen. Meine Vorlesungen enden um 12 Uhr, und wir könnten etwas zusammen unternehmen."

# game/scripts/c28/c28.rpy:1042
translate german c28s002_Kim_2b1b6541:

    # mc "¿Algo en plan cita?"
    mc "So etwas wie ein Date?"

# game/scripts/c28/c28.rpy:1044
translate german c28s002_Kim_1f428758:

    # kim "Yo había pensado en algo más informal que una cita."
    kim "Ich hatte an etwas Informelleres als ein Date gedacht."

# game/scripts/c28/c28.rpy:1045
translate german c28s002_Kim_02857be4:

    # kim "Después de lo que pasó en el barco de Iron Fist, creo que invertir parte de mi sueldo de esa noche en invitarte a comer estaría bien."
    kim "Nach dem, was auf dem Schiff Iron Fist passiert ist, halte ich es für eine gute Idee, einen Teil meines Gehalts an diesem Abend in ein Abendessen mit dir zu investieren."

# game/scripts/c28/c28.rpy:1046
translate german c28s002_Kim_0ccde321:

    # mc "Sabes que no hace falta, ¿verdad?"
    mc "Du weißt doch, dass es nicht nötig ist, oder?"

# game/scripts/c28/c28.rpy:1048
translate german c28s002_Kim_5ea97489:

    # kim "Lo sé, pero quiero hacerlo. Cuesta tanto tener tiempo a solas contigo..."
    kim "Ich weiß, aber ich möchte es. Es ist so schwer, Zeit allein mit dir zu finden..."

# game/scripts/c28/c28.rpy:1049
translate german c28s002_Kim_a2c86fb5:

    # mc "Lo siento, [kim]. Últimamente he estado muy ocupado preparando el viaje a Aruba."
    mc "Tut mir leid, [kim]. Ich war in letzter Zeit sehr beschäftigt mit den Vorbereitungen für die Reise nach Aruba."

# game/scripts/c28/c28.rpy:1050
translate german c28s002_Kim_9fafd7cd:

    # mc "Me da la impresión de que me paso el día leyendo informes."
    mc "Ich habe den Eindruck, dass ich den ganzen Tag damit verbringe, Berichte zu lesen."

# game/scripts/c28/c28.rpy:1052
translate german c28s002_Kim_a1ae8809:

    # kim "Entonces, ¿eso es un sí?"
    kim "Also, ist das ein Ja?"

# game/scripts/c28/c28.rpy:1053
translate german c28s002_Kim_7eb31e98:

    # mc "Sí, claro que es un sí. ¿Quieres que busque algún sitio para ir a comer?"
    mc "Ja, natürlich ist es ein Ja. Soll ich uns ein Restaurant suchen?"

# game/scripts/c28/c28.rpy:1055
translate german c28s002_Kim_a57b7044:

    # "La preciosa modelo te besa con alegría. Aquella noche en el barco de Iron Fist cambió muchas cosas en ella."
    "Das wunderschöne Model küsst dich voller Freude. Diese Nacht auf Iron Fists Boot veränderte vieles für sie."

# game/scripts/c28/c28.rpy:1056
translate german c28s002_Kim_f3f74e1c:

    # "Le dio una seguridad en sí misma que no tenía anteriormente. La [kim] de antes no hubiera tomado la iniciativa para invitarte a comer."
    "Es gab ihr ein Selbstvertrauen, das sie vorher nicht besessen hatte. Früher hätte sie nie die Initiative ergriffen, dich zum Mittagessen einzuladen."

# game/scripts/c28/c28.rpy:1057
translate german c28s002_Kim_4fb211f3:

    # "Si no odiaras tanto a Ichigo, casi le tendrías que estar agradecido."
    "Wenn du Ichigo nicht so sehr hassen würdest, müsstest du ihm fast dankbar sein."

# game/scripts/c28/c28.rpy:1059
translate german c28s002_Kim_34de37af:

    # kim "Invito yo, con lo que buscaré algún sitio. No es una cita, no va a ser ningún sitio romántico ni nada por el estilo."
    kim "Ich lade ein, also suche ich mir einen Platz. Es ist kein Date, es wird kein romantischer Ort oder so etwas sein."

# game/scripts/c28/c28.rpy:1060
translate german c28s002_Kim_9e8ff537:

    # kim "Sólo quiero pasar un rato a solas con mi novio."
    kim "Ich möchte einfach nur etwas Zeit allein mit meinem Freund verbringen."

# game/scripts/c28/c28.rpy:1061
translate german c28s002_Kim_1c55f897:

    # mc "Me parece una idea estupenda."
    mc "Ich finde das eine großartige Idee."

# game/scripts/c28/c28.rpy:1063
translate german c28s002_Kim_6486bfca:

    # kim "Cuando lo tenga decidido te aviso, no sea que no te guste el sitio..."
    kim "Ich sage dir Bescheid, sobald ich mich entschieden habe, nur für den Fall, dass dir der Ort nicht gefällt..."

# game/scripts/c28/c28.rpy:1064
translate german c28s002_Kim_1e31a2ef:

    # mc "No te preocupes, mientras tengan un plato sin brócoli no va a haber ningún problema."
    mc "Keine Sorge, solange es ein Gericht ohne Brokkoli gibt, wird es kein Problem geben."

# game/scripts/c28/c28.rpy:1066
translate german c28s002_Kim_2d7d5ca4:

    # kim "*Risa* ¿Incluso si el único plato sin brócoli es una pizza con piña?"
    kim "*Lacht* Selbst wenn das einzige Gericht ohne Brokkoli eine Ananas-Pizza ist?"

# game/scripts/c28/c28.rpy:1067
translate german c28s002_Kim_2e988f6a:

    # mc "No voy a responder a esa pregunta. *Risa* Ese tema podría ser motivo de ruptura para algunas parejas."
    mc "Ich werde diese Frage nicht beantworten. *lacht* Dieses Thema könnte für manche Paare ein Trennungsgrund sein."

# game/scripts/c28/c28.rpy:1069
translate german c28s002_Kim_44a29aed:

    # kim "Si sirve de algo, nunca la pediría, pero no tengo ningún problema en comerla si es una pizza para compartir."
    kim "Zur Info: Ich würde sie nie bestellen, aber ich habe kein Problem damit, sie zu essen, wenn es eine Pizza zum Teilen ist."

# game/scripts/c28/c28.rpy:1070
translate german c28s002_Kim_51d374a2:

    # kim "No es mi favorita ni mucho menos, pero no me resulta desagradable."
    kim "Es ist bei Weitem nicht mein Favorit, aber ich finde es nicht unangenehm."

# game/scripts/c28/c28.rpy:1071
translate german c28s002_Kim_d605a170:

    # kim "La que no soporto es la pizza con kiwi."
    kim "Was ich gar nicht ausstehen kann, ist Pizza mit Kiwi."

# game/scripts/c28/c28.rpy:1072
translate german c28s002_Kim_2262a25d:

    # mc "*Risa* Creo que el tipo que inventó la pizza con kiwi quería convertirse en el más odiado de la humanidad. Por suerte, no se ha hecho popular."
    mc "*lacht* Ich glaube, der Erfinder der Kiwi-Pizza wollte der meistgehasste Mensch der Welt werden. Zum Glück hat sich das nicht durchgesetzt."

# game/scripts/c28/c28.rpy:1074
translate german c28s002_Kim_a58eff80:

    # kim "¿Cuánto se puede tardar en cambiarse de zapatos?"
    kim "Wie lange dauert es, die Schuhe zu wechseln?"

# game/scripts/c28/c28.rpy:1076
translate german c28s002_Kim_868fb842:

    # mc "*Risa* Para querer pasar tiempo a solas conmigo, tienes muchas ganas de irte con las chicas ahora que estamos a solas..."
    mc "*Lacht* Für jemanden, der Zeit allein mit mir verbringen möchte, bist du aber ganz schön scharf darauf, jetzt, wo wir allein sind, mit den Mädels wegzugehen..."

# game/scripts/c28/c28.rpy:1078
translate german c28s002_Kim_e9cd26e9:

    # mc "*Risa* Pareces un chico esperando a su cita."
    mc "*lacht* Du siehst aus wie ein Typ, der auf sein Date wartet."

# game/scripts/c28/c28.rpy:1080
translate german c28s002_Kim_519db893:

    # kim "¡Oh! *Risa* ¡No lo decía por eso! Es que a veces entiendo cuando los chicos os quejáis de lo que tardamos las mujeres en estar listas."
    kim "Oh! *lacht* So meinte ich das nicht! Ich verstehe nur manchmal, wenn sich Männer darüber beschweren, wie lange wir Frauen zum Fertigmachen brauchen."

# game/scripts/c28/c28.rpy:1081
translate german c28s002_Kim_698a2f68:

    # kim "¡Es sólo cambiarse unos zapatos! ¡No tienen que maquillarse ni probarse ropa nueva!"
    kim "Es geht nur darum, die Schuhe zu wechseln! Sie müssen sich weder schminken noch neue Kleidung anprobieren!"

# game/scripts/c28/c28.rpy:1082
translate german c28s002_Kim_1dc34f98:

    # mc "*Risa* Bienvenida al mundo de los hombres."
    mc "*Gelächter* Willkommen in der Welt der Männer."

# game/scripts/c28/c28.rpy:1085
translate german c28s002_Kim_63bcf9a3:

    # "En ese momento se abre la puerta."
    "In diesem Moment öffnet sich die Tür."

# game/scripts/c28/c28.rpy:1087
translate german c28s002_Kim_a363811b:

    # deb "¿De qué os estáis riendo?"
    deb "Worüber lachst du?"

# game/scripts/c28/c28.rpy:1088
translate german c28s002_Kim_31a04b39:

    # mc "Mejor no lo quieras saber. *Risa*"
    mc "Das solltest du besser nicht wissen. *lacht*"

# game/scripts/c28/c28.rpy:1089
translate german c28s002_Kim_bc69fc2c:

    # lis "No hemos tardado mucho, ¿verdad?"
    lis "Das ging ja schnell, oder?"

# game/scripts/c28/c28.rpy:1090
translate german c28s002_Kim_c93c4533:

    # kim "Precisamente de eso nos estábamos riendo."
    kim "Genau darüber haben wir gelacht."

# game/scripts/c28/c28.rpy:1091
translate german c28s002_Kim_f3d65716:

    # sai "[lis] ha tenido que ir al lavabo."
    sai "[lis] musste auf die Toilette."

# game/scripts/c28/c28.rpy:1093
translate german c28s002_Kim_5c6e4704:

    # lis "¡[sai]!"
    lis "[sai]!"

# game/scripts/c28/c28.rpy:1094
translate german c28s002_Kim_dbc76063:

    # sai "¿Qué? Podías haber ido a lavarte los dientes. Yo lo he hecho mientras te esperábamos."
    sai "Was? Du hättest dir doch die Zähne putzen können. Ich hab's gemacht, während wir auf dich gewartet haben."

# game/scripts/c28/c28.rpy:1095
translate german c28s002_Kim_b0ef1f77:

    # sai "*Risa* Ahora todo el mundo sabe a lo que has ido."
    sai "*Lacht* Jetzt weiß jeder, warum du gekommen bist."

# game/scripts/c28/c28.rpy:1096
translate german c28s002_Kim_a329b8df:

    # deb "[lis] cree que el resto de los mortales pensamos que las princesas no cagan. *Risa*"
    deb "[lis] glaubt wohl, wir Normalsterblichen glauben, Prinzessinnen müssten nicht aufs Klo. *lacht*"

# game/scripts/c28/c28.rpy:1097
translate german c28s002_Kim_0feba2ca:

    # lis "¡[deb.nick]!"
    lis "[deb.nick]!"

# game/scripts/c28/c28.rpy:1098
translate german c28s002_Kim_b44f5814:

    # kim "Chicas, vámonos antes de que acabemos de hacer la digestión... *Risa* Aunque [lis] parece que ya la ha hecho."
    kim "Mädels, lasst uns gehen, bevor wir fertig verdaut haben... *lacht* Obwohl [lis] anscheinend schon verdaut hat."

# game/scripts/c28/c28.rpy:1100
translate german c28s002_Kim_0e50168c:

    # lis "*Risa* ¡Os odio!"
    lis "*Lacht* Ich hasse euch alle!"

# game/scripts/c28/c28.rpy:1101
translate german c28s002_Kim_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c28/c28.rpy:1102
translate german c28s002_Kim_8489236f:

    # mc "Que vaya bien el paseo, chicas."
    mc "Schönen Spaziergang, Mädels."

# game/scripts/c28/c28.rpy:1104
translate german c28s002_Kim_383cd8ec:

    # todas "Hasta mañana, [mc]."
    todas "Bis morgen, [mc]."

# game/scripts/c28/c28.rpy:1106
translate german c28s002_Kim_d9a16ac4:

    # "Te sientes tentado de llamar a la puerta de la habitación que [kim] y [kat] comparten aprovechando que estará sola."
    "Du verspürst die Versuchung, an die Tür des Zimmers zu klopfen, das sich [kim] und [kat] teilen, und nutzt die Tatsache aus, dass es leer sein wird."

# game/scripts/c28/c28.rpy:1108
translate german c28s002_Kim_30fa4e80:

    # "Lo piensas mejor y decides esperar a tener toda la información después de hablar con [kim] mañana."
    "Du denkst darüber nach und beschließt, zu warten, bis du nach dem Gespräch mit [kim] morgen alle Informationen hast."

# game/scripts/c28/c28.rpy:1115
translate german c28s002_SimGrateful_f1bce70a:

    # "Al llegar a tu habitación..."
    "Wenn Sie Ihr Zimmer erreichen..."

# game/scripts/c28/c28.rpy:1117
translate german c28s002_SimGrateful_a23925e4:

    # mc "Hola, [sim]. ¿Puedo ayudarte en algo?"
    mc "Hallo [sim]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c28/c28.rpy:1118
translate german c28s002_SimGrateful_ee2bcfe1:

    # sim "Venía tan solo a darte las gracias por lo que hicisteis [ama] y tú."
    sim "Ich wollte mich nur für das bedanken, was wir beide getan haben."

# game/scripts/c28/c28.rpy:1119
translate german c28s002_SimGrateful_d0655e4f:

    # mc "Yo no tuve nada que ver, [sim]. Fue idea de [ama]. Yo solo firmé el papeleo."
    mc "Ich hatte damit nichts zu tun, [sim]. Es war [ama]s Idee. Ich habe nur die Unterlagen unterschrieben."

# game/scripts/c28/c28.rpy:1121
translate german c28s002_SimGrateful_99b3a6e2:

    # sim "Bueno, si no lo hubieras firmado, [ama] no podría haberlo hecho."
    sim "Nun ja, wenn Sie es nicht unterschrieben hätten, hätte ich es nicht tun können."

# game/scripts/c28/c28.rpy:1122
translate german c28s002_SimGrateful_5a69f4be:

    # mc "Estoy seguro de que hubiera encontrado la manera de hacerlo. Se preocupa mucho por todas vosotras."
    mc "Ich bin sicher, sie hätte einen Weg gefunden. Ihr liegt sehr viel an euch allen."

# game/scripts/c28/c28.rpy:1124
translate german c28s002_SimGrateful_8d200725:

    # sim "¿Puedo decirte una cosa? Llevo desde el cumpleaños de las chicas queriéndome quitar el peso de encima..."
    sim "Darf ich Ihnen etwas erzählen? Seit dem Geburtstag der Mädchen möchte ich diese Last von meinen Schultern nehmen..."

# game/scripts/c28/c28.rpy:1125
translate german c28s002_SimGrateful_57496572:

    # mc "Lo que quieras. ¿Es tan grave?"
    mc "Ganz wie du willst. Ist es wirklich so ernst?"

# game/scripts/c28/c28.rpy:1127
translate german c28s002_SimGrateful_7b7ac8ea:

    # sim "No sé si es grave. Y decírtelo ahora puede parecer que es por las razones equivocadas, pero me siento súper culpable..."
    sim "Ich weiß nicht, ob es ernst ist. Und es mag so aussehen, als ob ich es dir jetzt aus den falschen Gründen sage, aber ich fühle mich unglaublich schuldig..."

# game/scripts/c28/c28.rpy:1128
translate german c28s002_SimGrateful_4bfa24fc:

    # mc "¿Qué has hecho para sentirte culpable, [sim]?"
    mc "Was hast du getan, um dich schuldig zu fühlen, [sim]?"

# game/scripts/c28/c28.rpy:1129
translate german c28s002_SimGrateful_270232c0:

    # mc "¿Tiene algo que ver con la beca?"
    mc "Hat das etwas mit dem Stipendium zu tun?"

# game/scripts/c28/c28.rpy:1131
translate german c28s002_SimGrateful_89f00b40:

    # sim "No, no. No tiene nada que ver con la beca... Tiene que ver con [ama] y [eva]..."
    sim "Nein, nein. Es hat nichts mit dem Stipendium zu tun... Es hat mit [ama] und [eva] zu tun..."

# game/scripts/c28/c28.rpy:1132
translate german c28s002_SimGrateful_80a5b1ff:

    # mc "¿Qué pasa con ellas? ¿Han hecho algo? Me estás empezando a preocupar."
    mc "Was ist denn mit denen los? Haben sie etwas angestellt? Du machst mir langsam Sorgen."

# game/scripts/c28/c28.rpy:1134
translate german c28s002_SimGrateful_e047aac5:

    # sim "No han sido ellas. Fui yo..."
    sim "Sie waren es nicht. Ich war es..."

# game/scripts/c28/c28.rpy:1135
translate german c28s002_SimGrateful_9157256e:

    # mc "¿Qué hiciste?"
    mc "Was hast du gemacht?"

# game/scripts/c28/c28.rpy:1136
translate german c28s002_SimGrateful_ea60ddee:

    # sim "Las prejuzgue. Cuando mi madre me habló de ellas por primera vez... No me parecía normal. Ni siquiera bien."
    sim "Ich habe sie verurteilt. Als meine Mutter mir das erste Mal davon erzählte … kam es mir nicht normal vor. Nicht einmal gut."

# game/scripts/c28/c28.rpy:1138
translate german c28s002_SimGrateful_2a226678:

    # sim "Clones de mis amigas, unas asesinas, se iban a unir a la familia..."
    sim "Klone meiner Freunde, einige von ihnen Mörder, sollten der Familie beitreten..."

# game/scripts/c28/c28.rpy:1140
translate german c28s002_SimGrateful_7d71f376:

    # sim "Mis amigas eran clones y ahora las chicas de las que eran clones, unas asesinas, se iban a unir a la familia..."
    sim "Meine Freunde waren Klone, und nun würden die Mädchen, deren Klone sie waren – Mörderinnen –, ebenfalls Teil der Familie werden…"

# game/scripts/c28/c28.rpy:1141
translate german c28s002_SimGrateful_abe41cd3:

    # sim "No era natural... No quería ni tan solo conocerlas..."
    sim "Es war nicht natürlich... Ich wollte sie gar nicht treffen..."

# game/scripts/c28/c28.rpy:1142
translate german c28s002_SimGrateful_2a819095:

    # mc "Hasta que las conociste."
    mc "Bis du ihnen begegnet bist."

# game/scripts/c28/c28.rpy:1144
translate german c28s002_SimGrateful_6abf5714:

    # sim "Hasta que [emm] estuvo hablando de ellas sin parar en la fiesta de cumpleaños, antes de que llegaran."
    sim "Bis [emm] auf der Geburtstagsfeier ununterbrochen von ihnen sprach, noch bevor sie überhaupt ankamen."

# game/scripts/c28/c28.rpy:1145
translate german c28s002_SimGrateful_8fe78a61:

    # sim "Si [emm] las podía aceptar y sentirse ilusionada con ellas, teniendo en cuenta que a ella le afectaba más que a mí, ¿quién era yo para no hacerlo?"
    sim "Wenn [emm] sie akzeptieren und sich darüber freuen konnte, wo es sie doch mehr betraf als mich, wer war ich dann, es nicht zu tun?"

# game/scripts/c28/c28.rpy:1146
translate german c28s002_SimGrateful_c2861c4f:

    # sim "Y después las conocí y todas las barreras mentales que tenía desaparecieron."
    sim "Und dann begegnete ich ihnen, und alle meine mentalen Barrieren verschwanden."

# game/scripts/c28/c28.rpy:1147
translate german c28s002_SimGrateful_a5ceab8e:

    # mc "A todos nos costó un poco aceptar su existencia. No es algo que pase normalmente."
    mc "Es dauerte eine Weile, bis wir seine Existenz akzeptierten. So etwas passiert nicht jeden Tag."

# game/scripts/c28/c28.rpy:1149
translate german c28s002_SimGrateful_b68e332a:

    # sim "Pero parece ser que yo fui la única que las prejuzgué. El resto las aceptasteis enseguida. Yo tuve que esperar a conocerlas."
    sim "Aber anscheinend war ich die Einzige, die sie verurteilt hat. Ihr anderen habt sie sofort akzeptiert. Ich musste erst einmal abwarten, bis ich sie kennengelernt hatte."

# game/scripts/c28/c28.rpy:1150
translate german c28s002_SimGrateful_f31f4788:

    # sim "Y desde entonces me siento culpable por haber reaccionado así."
    sim "Und seitdem plagen mich Schuldgefühle, weil ich so reagiert habe."

# game/scripts/c28/c28.rpy:1151
translate german c28s002_SimGrateful_1c3c3ddc:

    # mc "No tienes por qué hacerlo. Lo que es extraño es que todo el mundo las aceptase tan rápido."
    mc "Du musst es nicht tun. Seltsam ist nur, dass sie von allen so schnell akzeptiert wurden."

# game/scripts/c28/c28.rpy:1152
translate german c28s002_SimGrateful_b483301a:

    # mc "La mayoría de las chicas tuvo un baño de realidad inmediato. Se enteraron de su existencia el mismo día que las conocieron."
    mc "Die meisten Mädchen wurden sofort mit der Realität konfrontiert. Sie erfuhren noch am selben Tag, an dem sie ihnen begegneten, von ihrer Existenz."

# game/scripts/c28/c28.rpy:1153
translate german c28s002_SimGrateful_21b87fd0:

    # mc "En tu caso..."
    mc "In Ihrem Fall..."

# game/scripts/c28/c28.rpy:1155
translate german c28s002_SimGrateful_8be6cab0:

    # sim "En mi caso tuve tiempo de darle vueltas a la cabeza. Pero se las di en el sentido equivocado. No quería que unas asesinas formaran parte de la familia..."
    sim "In meinem Fall hatte ich Zeit, darüber nachzudenken. Aber ich habe es falsch angegangen. Ich wollte keine Mörder in der Familie haben…"

# game/scripts/c28/c28.rpy:1156
translate german c28s002_SimGrateful_a2e5973d:

    # sim "Sé que no tengo derecho a decidir quién forma parte de la familia, pero es como me sentía. Y me siento culpable por haberme sentido así."
    sim "Ich weiß, ich habe nicht das Recht zu entscheiden, wer zur Familie gehört, aber so habe ich es empfunden. Und ich fühle mich schuldig deswegen."

# game/scripts/c28/c28.rpy:1157
translate german c28s002_SimGrateful_f24017d3:

    # mc "No le des más vueltas. Supongo que, en el momento en que las conociste, esos prejuicios desaparecieron."
    mc "Mach dir nicht so viele Gedanken. Ich nehme an, diese Vorurteile verschwanden in dem Moment, als du ihnen begegnet bist."

# game/scripts/c28/c28.rpy:1160
translate german c28s002_SimGrateful_5bf080ce:

    # sim "¡Claro! Pasaron a ser dos personas en vez de dos conceptos. Verlas con la mirada ilusionada por formar parte de algo como esta familia..."
    sim "Natürlich! Aus zwei Konzepten wurden zwei Menschen. Sie mit der Begeisterung zu sehen, Teil einer solchen Familie zu sein …"

# game/scripts/c28/c28.rpy:1161
translate german c28s002_SimGrateful_db0a503c:

    # sim "Las tenías que haber visto en el jacuzzi... Eran como dos niñas pequeñas... Como si también fuera su cumpleaños y esta familia fuera su regalo..."
    sim "Du hättest sie im Whirlpool sehen sollen... Sie waren wie zwei kleine Mädchen... Als ob auch sie Geburtstag hätten und diese Familie ihr Geschenk wäre..."

# game/scripts/c28/c28.rpy:1162
translate german c28s002_SimGrateful_e17ed30a:

    # mc "No te equivocas demasiado. Lo han pasado mal y aquel día fue importante para ellas."
    mc "Du liegst nicht ganz falsch. Sie haben eine schwere Zeit durchgemacht, und dieser Tag war wichtig für sie."

# game/scripts/c28/c28.rpy:1163
translate german c28s002_SimGrateful_7e639235:

    # mc "Creo que tenían un poco de miedo a cómo las recibiríais las que aún no las conocíais."
    mc "Ich glaube, sie hatten ein bisschen Angst davor, wie diejenigen von Ihnen, die sie noch nicht kannten, sie aufnehmen würden."

# game/scripts/c28/c28.rpy:1165
translate german c28s002_SimGrateful_9ebe2e5f:

    # sim "Por eso necesitaba contárselo a alguien. Me comporté mal con ellas antes de conocerlas..."
    sim "Deshalb musste ich es jemandem erzählen. Ich habe sie schlecht behandelt, bevor ich sie überhaupt kennengelernt habe..."

# game/scripts/c28/c28.rpy:1166
translate german c28s002_SimGrateful_88de8ad2:

    # mc "A mí no me parece algo de lo que te debas preocupar pero, si te vas a quedar más tranquila, creo que deberías hablar con ellas."
    mc "Ich glaube nicht, dass du dir darüber Sorgen machen solltest, aber wenn es dich beruhigt, solltest du mit ihnen sprechen."

# game/scripts/c28/c28.rpy:1167
translate german c28s002_SimGrateful_475b961d:

    # mc "Creo que incluso les podría gustar tener esa conversación contigo."
    mc "Ich glaube, ihnen würde das Gespräch mit Ihnen sogar Freude bereiten."

# game/scripts/c28/c28.rpy:1169
translate german c28s002_SimGrateful_1a40d0e2:

    # sim "¿Qué? ¿Confesarles que las prejuzgué? ¡Pensarán que soy idiota!"
    sim "Was? Gestehen, dass ich sie verurteilt habe? Die werden mich für einen Idioten halten!"

# game/scripts/c28/c28.rpy:1170
translate german c28s002_SimGrateful_749e231f:

    # mc "Es posible, pero también se darán cuenta de que dejaste de hacerlo en el momento en que les pusiste cara... aunque ya sabías qué cara tendrían..."
    mc "Das ist möglich, aber sie werden auch merken, dass du aufgehört hast, sobald du ihre Gesichter gesehen hast... obwohl du ja schon wusstest, wie sie aussehen würden..."

# game/scripts/c28/c28.rpy:1171
translate german c28s002_SimGrateful_41f1f5e8:

    # mc "Digamos que en el momento en que las individualizaste. Como has dicho, cuando se convirtieron en personas en vez de conceptos."
    mc "Sagen wir, es war der Moment, als Sie sie individualisiert haben. Wie Sie sagten, als sie zu Personen wurden, anstatt nur Konzepte zu sein."

# game/scripts/c28/c28.rpy:1172
translate german c28s002_SimGrateful_06b5d016:

    # mc "Eso les va a gustar. Sabes que siempre buscan individualizarse, sobre todo [eva], y que les expliques lo que me has explicado a mí..." id c28s002_SimGrateful_06b5d016
    mc "Das wird ihnen gefallen. Du weißt ja, dass sie immer versuchen, sie selbst zu sein, besonders [eva], und es wird ihnen gefallen, wenn du ihnen erklärst, was du mir erklärt hast..." id c28s002_SimGrateful_06b5d016

# game/scripts/c28/c28.rpy:1175
translate german c28s002_SimGrateful_5c489bd5:

    # sim "¡Tienes razón! ¡Hablaré mañana con ellas en el desayuno!"
    sim "Du hast Recht! Ich werde morgen beim Frühstück mit ihnen sprechen!"

# game/scripts/c28/c28.rpy:1177
translate german c28s002_SimGrateful_176858a7:

    # sim "¡Tienes razón! ¡Voy a hablar con ellas antes de que se acuesten!"
    sim "Du hast Recht! Ich werde mit ihnen sprechen, bevor sie ins Bett gehen!"

# game/scripts/c28/c28.rpy:1178
translate german c28s002_SimGrateful_502c0790:

    # mc "¿Dónde dormían hoy? Al final no me he enterado porque he empezado a recoger los platos."
    mc "Wo haben sie heute Nacht geschlafen? Ich habe es am Ende nicht herausgefunden, weil ich angefangen habe, das Geschirr abzuräumen."

# game/scripts/c28/c28.rpy:1179
translate german c28s002_SimGrateful_5defc53d:

    # sim "[ama] con [emm] y [eva] con [nor]."
    sim "[ama] mit [emm] und [eva] mit [nor]."

# game/scripts/c28/c28.rpy:1181
translate german c28s002_SimGrateful_4d909a7e:

    # sim "Yo duermo en la habitación de [eri] hoy, con lo que empezaré con [ama]."
