    sim "Das ist nicht nötig, ich möchte deine erste Verlobte sein, auch wenn wir nie heiraten können."

# game/scripts/c28/c28.rpy:1249
translate german c28s003_SimLewd_7f77d47b:

    # sim "No voy a esperar que se lo pidas antes a otra."
    sim "Ich werde nicht warten, bis du erst jemand anderen fragst."

# game/scripts/c28/c28.rpy:1251
translate german c28s003_SimLewd_016034bd:

    # sim "Creo que es el próximo paso, ¿no?"
    sim "Ich denke, das ist der nächste Schritt, oder nicht?"

# game/scripts/c28/c28.rpy:1252
translate german c28s003_SimLewd_b48ce70e:

    # sim "Con lo que te costó empezar a salir conmigo, no quiero que pasen años antes de que me pidas que nos casemos."
    sim "Angesichts dessen, wie schwer es für dich war, mit mir auszugehen, möchte ich nicht, dass Jahre vergehen, bevor du mir einen Heiratsantrag machst."

# game/scripts/c28/c28.rpy:1254
