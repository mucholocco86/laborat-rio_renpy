# game/scripts/c28/c28.rpy:1183
translate german c28s002_SimGrateful_5196d003:

    # sim "Gracias por la conversación. Me he quitado un peso de encima."
    sim "Danke für das Gespräch. Das ist eine Erleichterung."

# game/scripts/c28/c28.rpy:1184
translate german c28s002_SimGrateful_e92882e3:

