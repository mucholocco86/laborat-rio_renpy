# game/scripts/c17/c17.rpy:2479
translate german c17s002_MaddieRomance_b93f7a3c:

    # mad "Hasta el domingo, [mc]."
    mad "Bis Sonntag, [mc]."

# game/scripts/c17/c17.rpy:2496
translate german c17s002_InterludeRomDom_19118a59:

    # mad "¿Vas a quedarte en la cama mientras me limpio o vas a cotillear?"
    mad "Bleibst du im Bett, während ich aufräume, oder willst du tratschen?"

# game/scripts/c17/c17.rpy:2497
translate german c17s002_InterludeRomDom_00515c06:

    # mc "Se está demasiado solo en esta cama sin hacer nada. *Risa*"
    mc "Es ist zu einsam, hier im Bett zu liegen und nichts zu tun. *lacht*"

# game/scripts/c17/c17.rpy:2498
translate german c17s002_InterludeRomDom_066e7751:

    # mad "Pues eso. *Risa*"
    mad "Das war's. *lacht*"

# game/scripts/c17/c17.rpy:2500
translate german c17s002_InterludeRomDom_da7af71e:

    # mc "No me había fijado antes. También tienes decoración y libros sobre gatos. No haré la pregunta tonta de si te gustan los gatos."
    mc "Das war mir vorher gar nicht aufgefallen. Du hast ja auch Dekoartikel und Bücher über Katzen. Ich werde jetzt nicht die blöde Frage stellen, ob du Katzen magst."

# game/scripts/c17/c17.rpy:2502
translate german c17s002_InterludeRomDom_e735d6b3:

    # zeu "¡Miau! (¿A qué te gustan las estatuas que hacen de mí? ¡Somos vuestros dioses!)"
    zeu "Miau! (Gefallen euch die Statuen, die sie von mir machen, nicht? Wir sind eure Götter!)"

# game/scripts/c17/c17.rpy:2503
translate german c17s002_InterludeRomDom_4798e632:

    # mad "*Desde el baño* Me encantan. Zeus es el primero que tengo y quería aprenderlo todo sobre ellos."
    mad "*Aus dem Badezimmer* Ich liebe sie. Zeus ist der erste, den ich hatte, und ich wollte alles über sie erfahren."

# game/scripts/c17/c17.rpy:2505
translate german c17s002_InterludeRomDom_969c9daa:

    # zeu "¡Miau! (¿Tengo? Maddie, aún no sabes cómo funciona esto de adorar a un gato, ¿verdad?)"
    zeu "Miau! (Habe ich eine? Maddie, du weißt immer noch nicht, wie diese Katzenverehrung funktioniert, oder?)"

# game/scripts/c17/c17.rpy:2507
translate german c17s002_InterludeRomDom_fb8e52fa:

    # mc "Estos dibujos de vestidos... ¿son tuyos? Son muy chulos..."
    mc "Diese Kleiderzeichnungen... sind die von dir? Die sind echt cool..."

# game/scripts/c17/c17.rpy:2508
translate german c17s002_InterludeRomDom_73a55a85:

    # mad "*Desde el baño* Son para un concurso. Es a lo que me quiero dedicar en un futuro, pero es un mercado muy duro."
    mad "*Aus dem Badezimmer* Die sind für einen Wettbewerb. Das möchte ich in Zukunft auch machen, aber es ist ein sehr hart umkämpfter Markt."

# game/scripts/c17/c17.rpy:2509
translate german c17s002_InterludeRomDom_3d2c4ea5:

    # mc "Pues me encantan, son muy elegantes."
    mc "Ich finde sie wunderschön, sie sind sehr elegant."

# game/scripts/c17/c17.rpy:2510
translate german c17s002_InterludeRomDom_eeaa2805:

    # mad "*Desde el baño* Es de lo que va el concurso. Pedían diseños de vestidos de ese tipo."
    mad "*Aus dem Badezimmer* Genau darum geht es bei dem Wettbewerb. Sie haben nach Kleiderentwürfen wie diesem gefragt."

# game/scripts/c17/c17.rpy:2512
translate german c17s002_InterludeRomDom_684eaf5e:

    # mc "¿Te has dado cuenta de que el cuadro tiene una mancha de café?"
    mc "Ist Ihnen aufgefallen, dass das Gemälde einen Kaffeefleck hat?"

# game/scripts/c17/c17.rpy:2513
translate german c17s002_InterludeRomDom_2541f4eb:

    # mad "*Desde el baño* Sí, lo sé. Siempre compro los lienzos defectuosos... salen más baratos."
    mad "*Aus dem Badezimmer* Ja, ich weiß. Ich kaufe immer die fehlerhaften Leinwände... die sind billiger."

# game/scripts/c17/c17.rpy:2514
translate german c17s002_InterludeRomDom_1f7f3e3d:

    # mad "*Desde el baño* Sé que no está bien, siendo para un regalo, pero no tenía tiempo de comprar lienzos nuevos."
    mad "*Aus dem Badezimmer* Ich weiß, es ist nicht richtig, da es ein Geschenk sein soll, aber ich hatte keine Zeit, neue Leinwände zu kaufen."

# game/scripts/c17/c17.rpy:2532
translate german c17s002_ZeusArrival_0843fc7e:

    # zeu "¡Miau! (¿Vas a ignorarme después de lo que hice por ti el otro día?)"
    zeu "Miau! (Wirst du mich jetzt etwa ignorieren, nach dem, was ich neulich für dich getan habe?)"

# game/scripts/c17/c17.rpy:2533
translate german c17s002_ZeusArrival_d6ca9f3f:

    # mc "¡Hola, Zeus! ¿Me has echado de menos?"
    mc "Hallo Zeus! Hast du mich vermisst?"

# game/scripts/c17/c17.rpy:2548
translate german c17s002_ZeusArrival_a92f9f77:

    # mc "¿Cómo está mi peludo amigo?"
    mc "Wie geht es meinem pelzigen Freund?"

# game/scripts/c17/c17.rpy:2550
translate german c17s002_ZeusArrival_d9f4d597:

    # zeu "¡Miau! (Hubiera preferido una latita de atuncito, pero hoy te paso que solo sean caricias. Estás siendo una buena mascota.)"
    zeu "Miau! (Ich hätte ja lieber eine Dose Thunfisch gehabt, aber heute lasse ich es auch mit Streicheln gut sein. Du bist ein braves Haustier.)"

# game/scripts/c17/c17.rpy:2551
translate german c17s002_ZeusArrival_972232bc:

    # mc "¿Me lo parece a mí o estás más cariñoso que el otro día?"
    mc "Bilde ich mir das nur ein, oder bist du in letzter Zeit zärtlicher als neulich?"

# game/scripts/c17/c17.rpy:2552
translate german c17s002_ZeusArrival_ec175848:

    # mad "Nunca lo he visto pedir caricias como te las pide a ti. Cuando vienen mis amigas se mete en mi habitación para no verlas. *Risa*"
    mad "Ich habe ihn noch nie so um Zuneigung bitten sehen wie bei dir. Wenn meine Freunde zu Besuch kommen, geht er in mein Zimmer, damit er sie nicht sehen muss. *Lacht*"

# game/scripts/c17/c17.rpy:2554
translate german c17s002_ZeusArrival_97a8ac23:

    # zeu "¡Miau! (Tus amigas son como gallinas cuando se ríen. Este tipo te hace sonreír a ti. Hay que cuidarlo aunque no me traiga comida.)"
    zeu "Miau! (Deine Freunde lachen wie Hühner. Dieser Kerl bringt dich zum Lächeln. Wir müssen uns um ihn kümmern, auch wenn er mir kein Futter bringt.)"

# game/scripts/c17/c17.rpy:2569
translate german c17s002_ZeusArrival_022da4c5:

    # mad "¿Qué quieres, Zeus? ¿Quieres que le enseñe la habitación? ¿Quieres ser la estrella?"
    mad "Was willst du, Zeus? Soll ich ihr das Zimmer zeigen? Willst du der Star sein?"

# game/scripts/c17/c17.rpy:2571
translate german c17s002_ZeusArrival_8d53909c:

    # zeu "¡Miau! (¡Ya soy la estrella! Y lo verá en cuanto entre en la habitación.)"
    zeu "Miau! (Ich bin jetzt der Star! Und das wirst du sofort sehen, sobald du den Raum betrittst.)"

# game/scripts/c17/c17.rpy:2572
translate german c17s002_ZeusArrival_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c17/c17.rpy:2573
translate german c17s002_ZeusArrival_aee85687:

    # mad "Mejor que te lo enseñe. No te rías de mí."
    mad "Ich zeig's dir besser. Lach mich nicht aus."

# game/scripts/c17/c17.rpy:2576
translate german c17s002_ZeusArrival_2acd21c9:

    # cat "¡Miau! (¡Vamos! ¡Entrad! ¡Que me vea en toda mi gloria!)"
    cat "Miau! (Komm schon! Komm herein! Lass ihn mich in meiner ganzen Pracht sehen!)"

# game/scripts/c17/c17.rpy:2579
translate german c17s002_ZeusArrival_bc8da879:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Ich hatte nicht erwartet, dass wir so schnell ins Schlafzimmer gehen würden, aber... Zeus besteht darauf."

# game/scripts/c17/c17.rpy:2581
translate german c17s002_ZeusArrival_e74ede7b:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Ich dachte nicht, dass du wolltest, dass wir so schnell ins Schlafzimmer gehen, aber wenn Zeus darauf besteht..."

# game/scripts/c17/c17.rpy:2583
translate german c17s002_ZeusArrival_a7b673c1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Ich hatte eigentlich nicht vor, dich so schnell ins Zimmer zu bringen, aber Zeus besteht darauf. Und ich auch."

# game/scripts/c17/c17.rpy:2586
translate german c17s002_ZeusArrival_bc8da879_1:

    # mad "No pensaba en que pasáramos tan pronto a la habitación, pero... Zeus insiste."
    mad "Ich hatte nicht erwartet, dass wir so schnell ins Schlafzimmer gehen würden, aber... Zeus besteht darauf."

# game/scripts/c17/c17.rpy:2588
translate german c17s002_ZeusArrival_e74ede7b_1:

    # mad "No creía que quisieras que pasáramos tan pronto a la habitación, pero si Zeus insiste..."
    mad "Ich dachte nicht, dass du wolltest, dass wir so schnell ins Schlafzimmer gehen, aber wenn Zeus darauf besteht..."

# game/scripts/c17/c17.rpy:2590
translate german c17s002_ZeusArrival_a7b673c1_1:

    # mad "No tenía intención de llevarte tan pronto a la habitación, pero Zeus insiste. Y yo también."
    mad "Ich hatte eigentlich nicht vor, dich so schnell ins Zimmer zu bringen, aber Zeus besteht darauf. Und ich auch."

# game/scripts/c17/c17.rpy:2591
translate german c17s002_ZeusArrival_27c93be3:

    # mc "Mejor no llevarle la contraria, entonces."
    mc "Dann ist es am besten, ihm nicht zu widersprechen."

# game/scripts/c17/c17.rpy:2593
translate german c17s002_ZeusArrival_dbc10c1d:

    # mc "¡Wow, Maddie! ¡No sabía que pintabas! Parece un templo dedicado a Zeus."
    mc "Wow, Maddie! Ich wusste gar nicht, dass du malst! Es sieht aus wie ein Zeus geweihter Tempel."

# game/scripts/c17/c17.rpy:2595
translate german c17s002_ZeusArrival_8a744446:

    # zeu "¡Miau! (¿Sólo lo parece? Maddie, vas a tener que esforzarte más.)"
    zeu "Miau! (Sieht es nur so aus? Maddie, du musst dich mehr anstrengen.)"

# game/scripts/c17/c17.rpy:2596
translate german c17s002_ZeusArrival_a0536e0b:

    # mad "Solo pinto como hobby. Esa es la pared de la fantasía. Gírate."
    mad "Ich male nur als Hobby. Das ist die Fantasiewand. Dreh dich um."

# game/scripts/c17/c17.rpy:2598
translate german c17s002_ZeusArrival_f26c6b98:

    # mc "*Risa* Me encantan todas, pero especialmente la del rockero."
    mc "*Lacht* Ich liebe sie alle, aber besonders den Rocker."

# game/scripts/c17/c17.rpy:2599
translate german c17s002_ZeusArrival_22c4f4c3:

    # mad "Me divertí mucho pintando esa. Y la que está como un tigre, la pinté el día que lo adopté."
    mad "Das Malen hat mir viel Spaß gemacht. Und das, das wie ein Tiger aussieht, habe ich an dem Tag gemalt, an dem ich ihn adoptiert habe."

# game/scripts/c17/c17.rpy:2601
translate german c17s002_ZeusArrival_0fd1a789:

    # zeu "¡Miau! (Ahí estaba yo, apuntando maneras y siendo fiero.)"
    zeu "Miau! (Da war ich also, zeigte mein wahres Gesicht und war richtig wild.)"

# game/scripts/c17/c17.rpy:2616
translate german c17s002_ZeusArrival_4ec8d291:

    # mc "¿Y ese cuadro? ¿Es en lo que estás trabajando ahora?"
    mc "Und dieses Gemälde? Ist das das, woran Sie gerade arbeiten?"

# game/scripts/c17/c17.rpy:2618
translate german c17s002_ZeusArrival_7344a38d:

    # zeu "¡Miau! (¡Super-michi!)"
    zeu "Miau! (Superkätzchen!)"

# game/scripts/c17/c17.rpy:2619
translate german c17s002_ZeusArrival_2ebbe23f:

    # mad "[dap] me dijo que el domingo es su cumpleaños, el de [eri], y el de [emm]."
    mad "[dap] sagte mir, dass Sonntag sein Geburtstag, der Geburtstag von [eri] und der Geburtstag von [emm] ist."

# game/scripts/c17/c17.rpy:2620
translate german c17s002_ZeusArrival_d4b8601b:

    # mad "Le pregunté si le gustaría un cuadro y me dijo que sí. Este es para ella. Decidí hacerles un cuadro para cada una."
    mad "Ich fragte sie, ob sie ein Bild haben möchte, und sie sagte ja. Dieses hier ist für sie. Ich beschloss, für jeden von ihnen ein Bild zu malen."

# game/scripts/c17/c17.rpy:2622
translate german c17s002_ZeusArrival_36aeb1de:

    # zeu "*Grrr* ¡Miau! (Y con el de [emm] me dieron ganas de cagarme en tu almohada.)"
    zeu "*Grrr* Miau! (Und bei dem mit [emm] hätte ich am liebsten auf dein Kissen gekackt.)"

# game/scripts/c17/c17.rpy:2623
translate german c17s002_ZeusArrival_b4a6ec6f:

    # mc "Supongo que te ha invitado a la comida del domingo, ¿no?"
    mc "Ich nehme an, er hat Sie am Sonntag zum Mittagessen eingeladen, nicht wahr?"

# game/scripts/c17/c17.rpy:2638
translate german c17s002_ZeusArrival_8991d72d:

    # mad "Sí, me dijo que fuera a comer y me quedara para la partida de DnD. ¿Por qué?"
    mad "Ja, er hat mir gesagt, ich solle essen gehen und dann zum D&D-Spiel bleiben. Warum?"

# game/scripts/c17/c17.rpy:2639
translate german c17s002_ZeusArrival_040470f4:

    # mc "Entonces tengo que contarte una cosa. Siéntate, por favor."
    mc "Dann muss ich Ihnen etwas sagen. Bitte setzen Sie sich."

# game/scripts/c17/c17.rpy:2654
translate german c17s002_ZeusArrival_5f74a1af:

    # "Después de La Clonversación..."
    "Nach dem Klon-Gespräch..."

# game/scripts/c17/c17.rpy:2655
translate german c17s002_ZeusArrival_7863e2a8:

    # mad "Es increíble. Pero me parece que tomáis demasiados riesgos explicándoselo a tanta gente. Yo incluida."
    mad "Es ist unglaublich. Aber ich glaube, du gehst zu viele Risiken ein, wenn du es so vielen Leuten erklärst. Mir eingeschlossen."

# game/scripts/c17/c17.rpy:2672
translate german c17s002_Rom1_4be7d4ea:

    # mc "Bueno... tú y yo aún no hemos hablado de lo que somos, pero creo que vamos hacia algún sitio donde la confianza es indispensable."
    mc "Nun ja... wir beide haben noch nicht darüber gesprochen, was wir sind, aber ich denke, wir bewegen uns auf etwas zu, wo Vertrauen unerlässlich ist."

# game/scripts/c17/c17.rpy:2674
translate german c17s002_Rom1_df81dc24:

    # mad "Gracias, [mc]. Creo que tenemos muchas cosas de las que hablar... después de que retrasaras la cita..."
    mad "Danke, [mc]. Ich denke, wir haben einiges zu besprechen... nachdem du den Termin verschoben hast..."

# game/scripts/c17/c17.rpy:2676
translate german c17s002_Rom1_a337f597:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. He pensado que... que era porque intenté chantajearte."
    mad "Einen Moment lang dachte ich, du wolltest es absagen, anstatt es zu verschieben. Ich dachte... dass es daran lag, dass ich versucht hätte, dich zu erpressen."

# game/scripts/c17/c17.rpy:2677
translate german c17s002_Rom1_535d5ef9:

    # mad "He empezado a montarme películas en mi mente diciéndome que la había cagado por intentarlo... que quizás lo habías pensado mejor y no querías estar conmigo..."
    mad "Ich habe angefangen, mir die tollsten Dinge auszumalen und mir einzureden, dass ich alles vermasselt habe, indem ich es versucht habe... dass du vielleicht deine Meinung geändert hast und nicht mehr mit mir zusammen sein willst..."

# game/scripts/c17/c17.rpy:2678
translate german c17s002_Rom1_0e471ac5:

    # mc "No, Maddie. Empezamos esto de una forma que no me gustó, pero me está gustando a dónde va."
    mc "Nein, Maddie. Wir haben das Ganze auf eine Art und Weise begonnen, die mir nicht gefallen hat, aber mir gefällt, wohin es sich entwickelt."

# game/scripts/c17/c17.rpy:2680
translate german c17s002_Rom1_e27df326:

    # mad "Por un momento he pensado que querías cancelarla, en vez de retrasarla. Que no querías que nos viéramos."
    mad "Einen Moment lang dachte ich, du wolltest es absagen, statt es zu verschieben. Dass du nicht wolltest, dass wir uns sehen."

# game/scripts/c17/c17.rpy:2681
translate german c17s002_Rom1_425bf1d8:

    # mc "No, Maddie. Cuando fui a comprarte el disfraz, no tenía intención de empezar nada contigo, pero ahora me está gustando a dónde va esto."
    mc "Nein, Maddie. Als ich dir das Kostüm gekauft habe, hatte ich nicht die Absicht, irgendetwas mit dir anzufangen, aber jetzt gefällt mir, wohin das führt."

# game/scripts/c17/c17.rpy:2682
translate german c17s002_Rom1_1af405b2:

    # mc "Y creo que es el momento de comprobarlo, ¿no?"
    mc "Und ich denke, es ist an der Zeit, das herauszufinden, finden Sie nicht auch?"

# game/scripts/c17/c17.rpy:2685
translate german c17s002_Sub1_f1949ecd:

    # mc "Bueno, no creo que mi gatita vaya a hacer nada que me perjudique. A mí o a mi familia."
    mc "Ich glaube nicht, dass mein Kätzchen mir oder meiner Familie etwas antun wird."

# game/scripts/c17/c17.rpy:2686
translate german c17s002_Sub1_76b2116f:

    # mc "Sabes que espié a [mar] en el probador y has guardado el secreto. No por voluntad propia, pero lo has hecho."
    mc "Du weißt, dass ich [mar] in der Umkleidekabine beobachtet habe und du es für dich behalten hast. Nicht freiwillig, aber du hast es getan."

# game/scripts/c17/c17.rpy:2687
translate german c17s002_Sub1_94622999:

    # mc "Y no creo que lo revelaras aunque te liberase de sea lo que sea lo que es esto."
    mc "Und ich glaube nicht, dass du es verraten würdest, selbst wenn es dich von dem befreien würde, was auch immer das ist."

# game/scripts/c17/c17.rpy:2689
translate german c17s002_Sub1_b864f71d:

    # mad "Nunca haría algo que os perjudique. Cuando has llamado para retrasar la cita... por un momento he pensado que querías cancelarla."
    mad "Ich würde dir niemals etwas antun. Als du angerufen hast, um den Termin zu verschieben, dachte ich einen Moment lang, du wolltest ihn absagen."

# game/scripts/c17/c17.rpy:2690
translate german c17s002_Sub1_95b557c6:

    # mad "El corazón me ha dado un vuelco y he descubierto que me gusta lo que tenemos. Que quiero más."
    mad "Mein Herz setzte einen Schlag aus, und mir wurde klar, dass ich mag, was wir haben. Dass ich mehr will."

# game/scripts/c17/c17.rpy:2691
translate german c17s002_Sub1_b4c822bc:

    # mad "Me acabas de llamar gatita y he notado mariposas en el estómago. Quiero ser tu gatita, [mc]. Me gusta sentirme indefensa en tus brazos."
    mad "Du hast mich gerade Kätzchen genannt und ich hatte Schmetterlinge im Bauch. Ich möchte dein Kätzchen sein, [mc]. Ich mag es, mich in deinen Armen hilflos zu fühlen."

# game/scripts/c17/c17.rpy:2692
translate german c17s002_Sub1_d82d413c:

    # mc "Eres mi gatita, pero no consiste en que estés indefensa. Consiste en que nos lo pasemos bien los dos, no sólo yo."
    mc "Du bist zwar mein Kätzchen, aber das heißt nicht, dass du wehrlos bist. Es bedeutet, dass wir beide Spaß haben, nicht nur ich."

# game/scripts/c17/c17.rpy:2693
translate german c17s002_Sub1_efdb86d5:

    # mc "Y creo que es el momento de empezar a hacerlo."
    mc "Und ich denke, es ist an der Zeit, damit anzufangen."

# game/scripts/c17/c17.rpy:2696
translate german c17s002_Dom1_28ef5b11:

    # mc "Creo que es algo que debes saber. Sabes que espié a [mar] en el probador y has guardado el secreto."
    mc "Ich finde, das solltest du wissen. Du weißt doch, dass ich [mar] in der Umkleidekabine beobachtet habe und du es für dich behalten hast."

# game/scripts/c17/c17.rpy:2697
translate german c17s002_Dom1_4258d6c5:

    # mc "Forzándome a esta relación, pero lo has hecho."
    mc "Du hast mich in diese Beziehung gezwungen, aber du hast es getan."

# game/scripts/c17/c17.rpy:2698
translate german c17s002_Dom1_4c56a055:

    # mc "Y estoy seguro de que, si dejásemos esta relación, seguirías guardándolo."
    mc "Und ich bin mir sicher, dass du es auch dann behalten würdest, wenn wir diese Beziehung beenden würden."

# game/scripts/c17/c17.rpy:2700
translate german c17s002_Dom1_eb23b7db:

    # mad "No tengo intención de hacer nada que te perjudique. Si acabarais todos en prisión me quedaría sin mi juguete."
    mad "Ich habe keinerlei Absicht, euch zu schaden. Wenn ihr alle im Gefängnis landen würdet, hätte ich mein Spielzeug verloren."

# game/scripts/c17/c17.rpy:2701
translate german c17s002_Dom1_b7b1e079:

    # mad "Y sí, puedo guardar los secretos que sean necesarios. Me gusta tenerte. Poseerte. ¿Quién sabe si algún día algo más?"
    mad "Und ja, ich kann alle notwendigen Geheimnisse bewahren. Ich genieße es, dich zu haben. Dich zu besitzen. Wer weiß, vielleicht wird ja eines Tages mehr daraus?"

# game/scripts/c17/c17.rpy:2702
translate german c17s002_Dom1_939762a1:

    # mad "Cuándo has llamado para retrasar la cita por un momento he pensado en qué haría si, en vez de retrasarla, la quisieras cancelar."
    mad "Als Sie anriefen, um den Termin zu verschieben, fragte ich mich kurz, was ich tun würde, wenn Sie ihn statt zu verschieben, absagen wollten."

# game/scripts/c17/c17.rpy:2703
translate german c17s002_Dom1_a9161cd3:

    # mad "¿Contarle el secreto a [mar] o no? He decidido que no lo haría. Quiero que seas mi juguete, pero quiero que lo seas por voluntad propia, no porque te sientas obligado."
    mad "Soll ich [mar] das Geheimnis verraten oder nicht? Ich habe mich dagegen entschieden. Ich möchte, dass du mein Spielzeug bist, aber ich möchte, dass du es freiwillig tust, nicht weil du dich dazu verpflichtet fühlst."

# game/scripts/c17/c17.rpy:2704
translate german c17s002_Dom1_eb3149a8:

    # mc "Un día, cuando esté autorizado para hacerlo, te contaré otro secreto. Uno que te demostrará que, si estoy aquí, es porque quiero."
    mc "Eines Tages, wenn ich die Erlaubnis dazu habe, werde ich Ihnen ein weiteres Geheimnis verraten. Eines, das Ihnen beweisen wird, dass ich nur hier bin, weil ich es so will."

# game/scripts/c17/c17.rpy:2706
translate german c17s002_Dom1_c018a585:

    # mad "Pues, como premio por ello y por la confianza, y sabiendo que te gusta, te voy a permitir de nuevo que me comas. Lo hiciste muy bien el otro día."
    mad "Nun, als Belohnung dafür und für dein Vertrauen, und weil ich weiß, dass es dir gefällt, lasse ich dich mich wieder essen. Du hast dich neulich sehr gut benommen."

# game/scripts/c17/c17.rpy:2707
translate german c17s002_Dom1_d0ff99b0:

    # mc "Como mi ama desee. Déjame que te libere de ese mono."
    mc "Wie meine Herrin wünscht. Lass mich dich von diesem Affen befreien."

