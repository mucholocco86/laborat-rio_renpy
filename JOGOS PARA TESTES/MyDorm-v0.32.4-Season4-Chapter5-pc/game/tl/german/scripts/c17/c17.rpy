    kia "Tut mir leid, ich dachte, das wüsste jeder... es ist doch so offensichtlich..."

# game/scripts/c17/c17.rpy:3002
translate german c17s003_TellKiara_0d0b1786:

    # mc "Por eso Eileen te está avisando con antelación. Eres la primera que lo va a saber."
    mc "Deshalb warnt Eileen dich im Voraus. Du bist die Erste, die es erfahren wird."

# game/scripts/c17/c17.rpy:3004
translate german c17s003_TellKiara_e7171578:

    # kia "Vaaale... lo prometo."
    kia "Okay... ich verspreche es."

# game/scripts/c17/c17.rpy:3007
translate german c17s003_TellKiara_aabf3ab2:

    # eil "No voy a volver a casa cuando acabe la semana que nos dimos de plazo."
    eil "Ich werde nicht nach Hause zurückkehren, wenn die Woche, die wir uns selbst gegeben haben, vorbei ist."

# game/scripts/c17/c17.rpy:3009
translate german c17s003_TellKiara_98c2a602:

    # kia "¿Por qué? ¿Voy a tener que volver sola?"
    kia "Warum? Muss ich etwa alleine zurückgehen?"

# game/scripts/c17/c17.rpy:3010
translate german c17s003_TellKiara_db032f60:

    # mcp "(Esto no es lo que esperaba.)"
    mcp "(Das hatte ich nicht erwartet.)"

# game/scripts/c17/c17.rpy:3012
translate german c17s003_TellKiara_7ce9d463:

    # eil "Creo que tú tampoco deberías volver. Con tu sueldo y el mío podemos buscar un sitio para las dos."
    eil "Ich finde, du solltest auch nicht zurückkommen. Mit unserem Gehalt finden wir bestimmt eine Wohnung für uns beide."

# game/scripts/c17/c17.rpy:3013
translate german c17s003_TellKiara_7fc969ec:

    # mc "No hace falta que os vayáis, Eile."
    mc "Du brauchst nicht zu gehen, Eile."

# game/scripts/c17/c17.rpy:3015
translate german c17s003_TellKiara_6932f62f:

    # kia "Pero ¿por qué no quieres volver a casa?"
    kia "Aber warum willst du nicht nach Hause?"

# game/scripts/c17/c17.rpy:3017
translate german c17s003_TellKiara_b79246e8:

    # eil "Primero porque anoche te oí llorar. Como haces todas las noches desde que estamos aquí cuando crees que me he quedado dormida."
    eil "Erstens, weil ich dich letzte Nacht weinen gehört habe. Wie du es jede Nacht tust, seit wir hier sind, wenn du denkst, ich sei eingeschlafen."

# game/scripts/c17/c17.rpy:3018
translate german c17s003_TellKiara_da0a6fd7:

    # eil "Tú tampoco quieres volver, pero aún no lo has aceptado."
    eil "Du willst auch nicht zurück, aber du hast es noch nicht akzeptiert."

# game/scripts/c17/c17.rpy:3020
translate german c17s003_TellKiara_e0663997:

    # kia "Es que no lo entiendes... es mi casa... nuestra casa..."
    kia "Du verstehst es einfach nicht... es ist mein Haus... unser Haus..."

# game/scripts/c17/c17.rpy:3022
translate german c17s003_TellKiara_0e5299b0:

    # eil "Lo sé. Es nuestra casa, pero no es nuestro hogar. Lo vi claro anoche con Amanda."
    eil "Ich weiß. Es ist zwar unser Haus, aber nicht unser Zuhause. Das habe ich gestern Abend bei Amanda ganz deutlich gesehen."

# game/scripts/c17/c17.rpy:3023
translate german c17s003_TellKiara_eea0ede9:

    # eil "Estás más a gusto aquí de lo que nunca has estado en casa. Y más segura."
    eil "Sie fühlen sich hier so wohl wie nie zuvor zu Hause. Und sicherer."

# game/scripts/c17/c17.rpy:3024
translate german c17s003_TellKiara_a1ea320a:

    # eil "Si no quieres que nos quedemos, no nos quedaremos. No tenemos que imponerles nada."
    eil "Wenn ihr nicht wollt, dass wir bleiben, bleiben wir nicht. Wir müssen euch zu nichts zwingen."

# game/scripts/c17/c17.rpy:3025
translate german c17s003_TellKiara_4344be04:

    # mc "No nos estáis imponiendo nada, Eileen."
    mc "Du zwingst uns gar nichts auf, Eileen."

# game/scripts/c17/c17.rpy:3027
translate german c17s003_TellKiara_fbceb62c:

    # eil "¡Calla! Estoy hablando con mi madre."
    eil "Sei leise! Ich spreche gerade mit meiner Mutter."

# game/scripts/c17/c17.rpy:3029
translate german c17s003_TellKiara_b97e40e3:

    # eil "He visto cómo te llevas con todo el mundo. Todo el mundo te quiere y tú empiezas a quererlos."
    eil "Ich habe gesehen, wie gut du mit allen auskommst. Alle mögen dich, und du fängst an, sie auch zu mögen."

# game/scripts/c17/c17.rpy:3030
translate german c17s003_TellKiara_609f5156:

    # eil "No voy a volver a lo que teníamos en nuestra casa."
    eil "Ich werde nicht zu dem zurückkehren, was wir in unserem Haus hatten."

# game/scripts/c17/c17.rpy:3032
translate german c17s003_TellKiara_bbef0246:

    # kia "Vale... ya hablaremos de eso... No es algo con lo que tengamos que molestar a [mc], discutiéndolo delante de él.."
    kia "Okay... darüber reden wir später... Es ist nichts, womit wir uns [mc] beschäftigen sollten, wenn wir es vor ihm besprechen."

# game/scripts/c17/c17.rpy:3033
translate german c17s003_TellKiara_a3b9d63c:

    # kia "Pero has dicho \"Primero\". Significa que hay más cosas."
    kia "Aber du hast „Erstens“ gesagt. Das bedeutet, dass es noch mehr Dinge gibt."

# game/scripts/c17/c17.rpy:3035
translate german c17s003_TellKiara_6e83eb7e:

    # eil "Sí, Mamá, aunque está relacionado."
    eil "Ja, Mama, obwohl es damit zusammenhängt."

# game/scripts/c17/c17.rpy:3036
translate german c17s003_TellKiara_c218d82f:

    # eil "Tú eres mi familia."
    eil "Du bist meine Familie."

# game/scripts/c17/c17.rpy:3037
translate german c17s003_TellKiara_2905013b:

    # eil "También lo es ese hombretón de ahí que me está mirando como si no entendiera nada."
    eil "Und das ist auch der große Mann da drüben, der mich so anschaut, als ob er gar nichts verstehen würde."

# game/scripts/c17/c17.rpy:3038
translate german c17s003_TellKiara_0483aa66:

    # eil "Y también lo son las chicas."
    eil "Und die Mädchen auch."

# game/scripts/c17/c17.rpy:3040
translate german c17s003_TellKiara_752a0f56:

    # eil "Quién no es mi familia es Papá."
    eil "Mein Vater gehört nicht zu meiner Familie."

# game/scripts/c17/c17.rpy:3042
translate german c17s003_TellKiara_90e815b3:

    # kia "Pero es tu padre..."
    kia "Aber er ist doch dein Vater..."

# game/scripts/c17/c17.rpy:3044
translate german c17s003_TellKiara_a85e276c:

    # eil "¿Crees que [mc] sería un buen padre, Mamá?"
    eil "Glaubst du, [mc] wäre ein guter Vater, Mama?"

# game/scripts/c17/c17.rpy:3046
translate german c17s003_TellKiara_9ad11d18:

    # kia "Claro. Ya sabes que lo quiero mucho. Y no lo querría si no pensara que es bueno."
    kia "Natürlich. Du weißt doch, dass ich ihn sehr liebe. Und ich würde ihn nicht lieben, wenn ich ihn nicht für einen guten Menschen hielte."

# game/scripts/c17/c17.rpy:3047
translate german c17s003_TellKiara_9b89d860:

    # mcp "(Aunque llevas un par de días distante conmigo.)"
    mcp "(Obwohl du dich mir gegenüber in den letzten paar Tagen distanziert verhalten hast.)"

# game/scripts/c17/c17.rpy:3049
translate german c17s003_TellKiara_057728d8:

    # eil "¿Crees que alguna vez me haría un morado como el que llevas en el brazo?"
    eil "Glaubst du, ich würde jemals so einen blauen Fleck bekommen wie du an deinem Arm?"

# game/scripts/c17/c17.rpy:3051
translate german c17s003_TellKiara_267d1553:

    # kia "No..."
    kia "NEIN..."

# game/scripts/c17/c17.rpy:3053
translate german c17s003_TellKiara_7697d4c3:

    # eil "¿Crees que alguna vez me haría desear irme de casa? ¿Con mi hija?"
    eil "Glaubst du, ich würde jemals von zu Hause weg wollen? Mit meiner Tochter?"

# game/scripts/c17/c17.rpy:3055
translate german c17s003_TellKiara_267d1553_1:

    # kia "No..."
    kia "NEIN..."

# game/scripts/c17/c17.rpy:3057
translate german c17s003_TellKiara_de91c1a8:

    # eil "Y ¿crees que nuestra hija tendrá miedo de verlo cuando esté embarazada?"
    eil "Und glaubst du, unsere Tochter wird Angst davor haben, ihn zu sehen, wenn sie schwanger ist?"

# game/scripts/c17/c17.rpy:3058
translate german c17s003_TellKiara_bf236e97:

    # eil "¿Que ella tendrá miedo de que le dé una paliza que le haga perder el bebé?"
    eil "Wird sie Angst haben, dass er sie so schlimm schlägt, dass sie das Baby verliert?"

# game/scripts/c17/c17.rpy:3060
translate german c17s003_TellKiara_1311138e:

    # kia "¡Por supuesto que no! Ya te he dicho..."
    kia "Natürlich nicht! Ich habe es dir doch schon gesagt..."

# game/scripts/c17/c17.rpy:3063
translate german c17s003_TellKiara_af04ff79:

    # kia "... que es..."
    kia "... was ist es..."

# game/scripts/c17/c17.rpy:3065
translate german c17s003_TellKiara_996415d1:

    # kia "... un buen hombre."
    kia "...ein guter Mann."

# game/scripts/c17/c17.rpy:3068
translate german c17s003_TellKiara_81602856:

    # kia "¡No puede ser! ¿Estás embarazada?"
    kia "Auf keinen Fall! Bist du schwanger?"

# game/scripts/c17/c17.rpy:3070
translate german c17s003_TellKiara_28947d76:

    # eil "Sí, Mamá. Estamos embarazados."
    eil "Ja, Mama. Wir sind schwanger."

# game/scripts/c17/c17.rpy:3072
translate german c17s003_TellKiara_a026f41b:

    # kia "¡Felicidades, cielo!"
    kia "Herzlichen Glückwunsch, Liebling!"

# game/scripts/c17/c17.rpy:3073
translate german c17s003_TellKiara_9b348af2:

    # eil "Gracias, Mamá. Estamos muy ilusionados."
    eil "Danke, Mama. Wir freuen uns riesig."

# game/scripts/c17/c17.rpy:3075
translate german c17s003_TellKiara_608976be:

    # kia "Felicidades a ti también, Papá."
    kia "Herzlichen Glückwunsch auch an dich, Papa."

# game/scripts/c17/c17.rpy:3076
translate german c17s003_TellKiara_b2a43c7a:

    # mcp "(Ahora entiendo lo de \"más frío que el abrazo de una suegra\".)"
    mcp "(Jetzt verstehe ich, was mit „kälter als die Umarmung einer Schwiegermutter“ gemeint ist.)"

# game/scripts/c17/c17.rpy:3077
translate german c17s003_TellKiara_887f84c9:

    # mc "Gracias, Kiara."
    mc "Danke, Kiara."

# game/scripts/c17/c17.rpy:3079
translate german c17s003_TellKiara_c0dccabd:

    # kia "¿Ya habéis pensado en nombres?"
    kia "Habt ihr euch schon Namen überlegt?"

# game/scripts/c17/c17.rpy:3081
translate german c17s003_TellKiara_f2bbe5f0:

    # eil "No, aún no pero..."
    eil "Nein, noch nicht, aber..."

# game/scripts/c17/c17.rpy:3082
translate german c17s003_TellKiara_b9a0ee5e:

    # "A partir de ese momento empieza una larga conversación sobre nombres de bebé, consejos sobre cómo llevar el embarazo, qué hacer y qué no hacer, el trabajo de Eileen..."
    "Von diesem Moment an beginnt ein langes Gespräch über Babynamen, Ratschläge zum Umgang mit der Schwangerschaft, Gebote und Verbote, Eileens Job..."

# game/scripts/c17/c17.rpy:3083
translate german c17s003_TellKiara_cdd77395:

    # "Kiara dice un montón de cosas en las que no habías pensado y otras que con un poco de sentido común cualquiera podría deducir."
    "Kiara sagt viele Dinge, an die man selbst noch nicht gedacht hat, und andere, die jeder mit ein bisschen gesundem Menschenverstand erschließen könnte."

# game/scripts/c17/c17.rpy:3084
translate german c17s003_TellKiara_5afbf202:

    # "Crees que vas a comprarte un libro de esos sobre bebés."
    "Du denkst, du kaufst dir eines dieser Bücher über Babys."

# game/scripts/c17/c17.rpy:3086
translate german c17s003_TellKiara_8e5da9c6:

    # eil "Deberíamos ir bajando para ayudar con la comida. Amanda tiene que estar a punto de llegar."
    eil "Wir sollten nach unten gehen und beim Essen helfen. Amanda müsste jeden Moment eintreffen."

# game/scripts/c17/c17.rpy:3087
translate german c17s003_TellKiara_6527cbbe:

    # mc "Podéis quedaros aquí un rato más hablando de esas cosas que no se habla delante del padre. Ya voy yo a ver si necesitan ayuda."
    mc "Du kannst noch ein bisschen hierbleiben und mit mir über die Dinge reden, über die du nicht vor deinem Vater sprichst. Ich gehe mal nachsehen, ob du Hilfe brauchst."

# game/scripts/c17/c17.rpy:3089
translate german c17s003_TellKiara_f79ec32b:

    # eil "Vale, mi amor. Te veo abajo en un rato."
    eil "Okay, mein Schatz. Wir sehen uns gleich unten."

# game/scripts/c17/c17.rpy:3090
translate german c17s003_TellKiara_fb559340:

    # mc "Hasta ahora, mi vida. Te quiero."
    mc "Bis jetzt, meine Liebe. Ich liebe dich."

# game/scripts/c17/c17.rpy:3091
translate german c17s003_TellKiara_9c439131:

    # eil "Yo también."
    eil "Ich auch."

# game/scripts/c17/c17.rpy:3093
translate german c17s003_TellKiara_b0624b53:

    # kia "Si necesitáis ayuda, avisadnos."
    kia "Wenn Sie Hilfe benötigen, lassen Sie es uns wissen."

# game/scripts/c17/c17.rpy:3094
translate german c17s003_TellKiara_006e759d:

    # mc "Tranquila, bajad en 20 minutos más o menos."
    mc "Keine Sorge, Sie sind in etwa 20 Minuten unten."

# game/scripts/c17/c17.rpy:3137
translate german c17s003_AmandaLunch_a30e4a01:

    # "Cuando llegas a la cocina, ya está casi todo hecho. Ayudas haciendo el all i oli y preparas las bebidas."
    "Wenn du in die Küche kommst, ist fast alles schon vorbereitet. Du hilfst, indem du die Aioli zubereitest und die Getränke vorbereitest."

# game/scripts/c17/c17.rpy:3144
translate german c17s003_AmandaLunch_4d213cf7:

    # "Al poco rato llega Amanda. Esta vez ha venido en la moto de Eva."
    "Amanda trifft kurz darauf ein. Diesmal ist sie mit Evas Motorrad gekommen."

# game/scripts/c17/c17.rpy:3149
translate german c17s003_AmandaLunch_ce547223:

    # ama "No sé si llego demasiado pronto..."
    ama "Ich weiß nicht, ob ich zu früh ankomme..."

# game/scripts/c17/c17.rpy:3150
translate german c17s003_AmandaLunch_3c5d873e:

    # mc "No te preocupes. Llegas justo a tiempo."
    mc "Keine Sorge. Du bist genau pünktlich."

# game/scripts/c17/c17.rpy:3152
translate german c17s003_AmandaLunch_9e70d621:

    # ama "Buenos días, [mc]."
    ama "Guten Morgen, [mc]."

# game/scripts/c17/c17.rpy:3153
translate german c17s003_AmandaLunch_194f0505:

    # mc "Buenos días, Amanda. Pasa, te están esperando."
    mc "Guten Morgen, Amanda. Komm herein, sie warten auf dich."

# game/scripts/c17/c17.rpy:3155
translate german c17s003_AmandaLunch_c030015f:

    # "La comida sigue la misma dinámica que la cena, aunque esta vez nadie hace llorar a Amanda."
    "Das Mittagessen verläuft nach dem gleichen Muster wie das Abendessen, nur dass diesmal niemand Amanda zum Weinen bringt."

# game/scripts/c17/c17.rpy:3156
translate german c17s003_AmandaLunch_317792d2:

    # "Echas de menos aquellos días en los que comíais sentados, pero le estás cogiendo el gusto a estas comidas de pie."
    "Du vermisst die Zeiten, als du noch im Sitzen gegessen hast, aber du gewöhnst dich an diese Mahlzeiten im Stehen."

# game/scripts/c17/c17.rpy:3158
translate german c17s003_AmandaLunch_962d0e9f:

    # "Puedes ver que Megan y [mar] tienen una larga conversación entre ellas, apartadas de todo el mundo."
    "Man kann sehen, wie Megan und [mar] ein langes Gespräch unter sich führen, abseits von allen anderen."

# game/scripts/c17/c17.rpy:3160
translate german c17s003_AmandaLunch_06b98e14:

    # "Amanda pasa más tiempo con las mujeres esta vez. Ayer se retuvieron un poco, pero hoy quieren su ración de la nueva incorporación a la familia."
    "Amanda verbringt diesmal mehr Zeit mit den Frauen. Gestern hielten sie sich noch etwas zurück, aber heute wollen sie ihren Anteil am neuesten Familienmitglied haben."

# game/scripts/c17/c17.rpy:3161
translate german c17s003_AmandaLunch_6a455a9d:

    # "Amanda tardará un poco en dejar de sentirse como un animal exhibido."
    "Es wird eine Weile dauern, bis Amanda aufhört, sich wie ein ausgestelltes Tier zu fühlen."

# game/scripts/c17/c17.rpy:3163
translate german c17s003_AmandaLunch_a3ab48a9:

    # "Esta vez las chicas tienen una nueva presa. Megan."
    "Diesmal haben die Mädchen eine neue Beute. Megan."

# game/scripts/c17/c17.rpy:3165
translate german c17s003_AmandaLunch_5afeb14d:

    # nor "Amanda nos ha contado las noticias. Ya no corremos peligro."
    nor "Amanda hat uns die Neuigkeiten mitgeteilt. Wir sind nicht mehr in Gefahr."

# game/scripts/c17/c17.rpy:3166
translate german c17s003_AmandaLunch_1ad31beb:

    # mc "Son grandes noticias. Aaron parece estar haciendo un trabajo fantástico."
    mc "Das sind großartige Neuigkeiten. Aaron scheint eine fantastische Arbeit zu leisten."

# game/scripts/c17/c17.rpy:3167
translate german c17s003_AmandaLunch_1709dc65:

    # mc "Aún estoy dudando de si debería aceptar el trabajo en Aruba... eso si no vendemos, claro. No sé si estaré a la altura."
    mc "Ich bin mir noch nicht sicher, ob ich den Job in Aruba annehmen soll… vorausgesetzt, wir verkaufen nicht. Ich weiß nicht, ob ich der Aufgabe gewachsen bin."

# game/scripts/c17/c17.rpy:3169
translate german c17s003_AmandaLunch_9e14d892:

    # nor "[mar] y yo no queremos vender la empresa."
    nor "[mar] und ich möchte das Unternehmen nicht verkaufen."

# game/scripts/c17/c17.rpy:3170
translate german c17s003_AmandaLunch_6a6a997a:

    # nor "Hacerlo significaría que habrá más chicas como Eva y Amanda. Mas niñas como Fiona."
    nor "Das würde bedeuten, dass es mehr Mädchen wie Eva und Amanda gäbe. Mehr Mädchen wie Fiona."

# game/scripts/c17/c17.rpy:3171
translate german c17s003_AmandaLunch_d1cc2333:

    # mc "Yo también creo que deberíamos mantenerla en manos de la familia."
    mc "Ich bin außerdem der Meinung, dass wir es in den Händen der Familie belassen sollten."

# game/scripts/c17/c17.rpy:3173
translate german c17s003_AmandaLunch_7c22c332:

    # nor "Y cuando te refieres a familia, también te refieres a Eva y a Amanda, ¿no?"
    nor "Und wenn Sie von Familie sprechen, meinen Sie auch Eva und Amanda, richtig?"

# game/scripts/c17/c17.rpy:3174
translate german c17s003_AmandaLunch_6f883578:

    # mc "Para mí, ellas son las principales víctimas de NTR. No sólo ellas. También Aaron y el resto de los clones masculinos. Incluidos los que entraron en casa."
    mc "Meiner Meinung nach sind sie die Hauptopfer von NTR. Nicht nur sie, sondern auch Aaron und die übrigen männlichen Klone, einschließlich derer, die in das Haus eingebrochen sind."

# game/scripts/c17/c17.rpy:3175
translate german c17s003_AmandaLunch_9dc882bc:

    # mc "Y, obviamente, ellas son familia. Ya viste cómo se puso Amanda ayer cuando se sintió aceptada. No quiero que nadie les robe eso. Ya le han robado su infancia."
    mc "Und natürlich sind sie Familie. Du hast ja gesehen, wie Amanda gestern reagiert hat, als sie sich akzeptiert fühlte. Ich will nicht, dass ihnen das jemand nimmt. Sie haben ihnen schon ihre Kindheit geraubt."

# game/scripts/c17/c17.rpy:3177
translate german c17s003_AmandaLunch_7c4baacf:

    # nor "[dap] y [eri] tampoco quieren vender. Estoy muy orgullosa de ellas."
    nor "[dap] und [eri] wollen auch nicht verkaufen. Ich bin sehr stolz auf sie."

# game/scripts/c17/c17.rpy:3178
translate german c17s003_AmandaLunch_c934662b:

    # nor "[emm] dice que tiene dudas, pero no ha dicho sobre qué."
    nor "[emm] sagt, er habe Zweifel, hat aber nicht gesagt, woran."

# game/scripts/c17/c17.rpy:3179
translate german c17s003_AmandaLunch_a97a789f:

    # mc "Hablaré con [emm] sobre ello. Ayer ya quería gastarse el dinero en un coche deportivo... rosa."
    mc "Ich werde mit [emm] darüber sprechen. Gestern wollte er das Geld schon für einen pinkfarbenen Sportwagen ausgeben."

# game/scripts/c17/c17.rpy:3180
translate german c17s003_AmandaLunch_2f1c36fd:

    # mc "Ya sabes que a veces necesita un empujón en la dirección correcta."
    mc "Du weißt ja, dass er manchmal einen kleinen Anstoß in die richtige Richtung braucht."

# game/scripts/c17/c17.rpy:3181
translate german c17s003_AmandaLunch_190da926:

    # mc "Ahora te voy a dejar un momento. Tengo que hablar con Kiara y quiero aprovechar ahora que se ha quedado sola."
    mc "Ich lasse dich kurz allein. Ich muss mit Kiara sprechen und möchte die Gelegenheit nutzen, dass sie jetzt allein ist."

# game/scripts/c17/c17.rpy:3183
translate german c17s003_AmandaLunch_b028b239:

    # nor "Ve. Es casi tan popular como Amanda y Eva. Es difícil que esté sola más de unos minutos. También es novedad, parece mentira que sólo sea su cuarto día en casa."
    nor "Schau mal! Sie ist fast so beliebt wie Amanda und Eva. Man sieht sie selten länger als ein paar Minuten allein. Es ist auch etwas Besonderes; man kann kaum glauben, dass sie erst seit vier Tagen wieder zu Hause ist."

# game/scripts/c17/c17.rpy:3187
translate german c17s003_AmandaLunch_e6e912ec:

    # mc "¿Qué tal, Kiara?"
    mc "Wie geht es dir, Kiara?"

# game/scripts/c17/c17.rpy:3189
translate german c17s003_AmandaLunch_1b271947:

    # kia "Muy contenta con las noticias de antes. *Susurrando* Aunque ser abuela me haga sentir vieja."
    kia "Ich freue mich so über die Nachricht von vorhin. *flüstert* Auch wenn ich mich als Großmutter alt fühle."

# game/scripts/c17/c17.rpy:3190
translate german c17s003_AmandaLunch_62e5c781:

    # kia "Y alucinando con lo rápido que se está integrando todo el mundo."
    kia "Und ich bin erstaunt darüber, wie schnell sich alle integrieren."

# game/scripts/c17/c17.rpy:3192
translate german c17s003_AmandaLunch_933ac119:

    # kia "Alucinando con lo rápido que se está integrando todo el mundo."
    kia "Ich bin erstaunt, wie schnell sich alle integrieren."

# game/scripts/c17/c17.rpy:3193
translate german c17s003_AmandaLunch_3737e771:

    # mc "¿Y tú? ¿Qué tal llevas la integración?"
    mc "Und Sie? Wie empfinden Sie den Integrationsprozess?"

# game/scripts/c17/c17.rpy:3195
translate german c17s003_AmandaLunch_802b957c:

    # kia "Genial. Me siento muy a gusto aquí, con vosotros."
    kia "Großartig. Ich fühle mich hier bei euch allen sehr wohl."

# game/scripts/c17/c17.rpy:3196
translate german c17s003_AmandaLunch_eb881cfe:

    # kia "Te tengo que dejar. Tenía que comentarle algo a Betty."
    kia "Ich muss los. Ich musste Betty etwas sagen."

# game/scripts/c17/c17.rpy:3197
translate german c17s003_AmandaLunch_ec12d61d:

    # mc "¿He hecho algo malo, Kiara?"
    mc "Habe ich etwas falsch gemacht, Kiara?"

# game/scripts/c17/c17.rpy:3199
translate german c17s003_AmandaLunch_36159e09:

    # kia "¿Por qué dices eso?"
    kia "Warum sagst du das?"

# game/scripts/c17/c17.rpy:3200
translate german c17s003_AmandaLunch_4c4ce05e:

    # mc "Me da la impresión de que me estás evitando desde hace un par de días."
    mc "Ich habe den Eindruck, dass du mich die letzten paar Tage gemieden hast."

# game/scripts/c17/c17.rpy:3201
translate german c17s003_AmandaLunch_30fd5f10:

    # kia "No... no te estoy evitando."
    kia "Nein... ich gehe dir nicht aus dem Weg."

# game/scripts/c17/c17.rpy:3202
translate german c17s003_AmandaLunch_d4d39668:

    # mc "¿Entonces qué pasa? Desde que fuimos a tu casa parece que no estás cómoda cuando yo estoy alrededor."
    mc "Was ist denn los? Seit wir bei dir zu Hause waren, scheinst du dich in meiner Gegenwart nicht wohlzufühlen."

# game/scripts/c17/c17.rpy:3204
translate german c17s003_AmandaLunch_e01c898b:

    # mc "¿Es por lo que pasó en la cocina? ¿Por mis relaciones? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Liegt es an dem, was in der Küche passiert ist? An meinen Beziehungen? An den Küssen? An dem, was bei dir zu Hause mit Solomon passiert ist?"

# game/scripts/c17/c17.rpy:3206
translate german c17s003_AmandaLunch_810f89d7:

    # mc "¿Es porque estoy con Eileen? ¿Por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Liegt es daran, dass ich mit Eileen zusammen bin? An den Küssen? An dem, was bei dir zu Hause mit Solomon passiert ist?"

# game/scripts/c17/c17.rpy:3208
translate german c17s003_AmandaLunch_5db4f1fd:

    # mc "¿Es por los besos? ¿Por lo que pasó en tu casa con Solomon?"
    mc "Liegt es an den Küssen? An dem, was bei dir zu Hause mit Solomon passiert ist?"

# game/scripts/c17/c17.rpy:3210
translate german c17s003_AmandaLunch_85f5d6ea:

    # kia "No es que esté incómoda a tu alrededor..."
    kia "Es ist nicht so, dass ich mich in deiner Gegenwart unwohl fühle..."

# game/scripts/c17/c17.rpy:3211
translate german c17s003_AmandaLunch_e6e4d5d1:

    # kia "No estoy acostumbrada a que nadie, excepto Eileen, me defienda como hiciste tú en casa."
    kia "Ich bin es nicht gewohnt, dass mich jemand, außer Eileen, so verteidigt, wie du es zu Hause getan hast."

# game/scripts/c17/c17.rpy:3213
translate german c17s003_AmandaLunch_adcd819b:

    # kia "Por un momento me sentí como se deben sentir las princesas en los cuentos de hadas. Protegida. Segura."
    kia "Einen Moment lang fühlte ich mich wie Prinzessinnen in Märchen. Beschützt. Geborgen."

# game/scripts/c17/c17.rpy:3219
translate german c17s003_AmandaLunch_4fc78872:

    # kia "Después... cuando nos abrazamos los tres en el parque... me sentí rara."
    kia "Danach... als wir drei uns im Park umarmten... fühlte ich mich seltsam."

# game/scripts/c17/c17.rpy:3220
translate german c17s003_AmandaLunch_d18e63c2:

    # mc "¿Rara? ¿Por qué? Sólo fue un abrazo. Siempre te han gustado mis abrazos."
    mc "Komisch? Warum? Es war doch nur eine Umarmung. Du hast meine Umarmungen doch immer gemocht."

# game/scripts/c17/c17.rpy:3222
translate german c17s003_AmandaLunch_963696e9:

    # kia "Si te lo explicara no lo entenderías. Y además me sentiría estúpida explicándotelo."
    kia "Wenn ich es dir erklären würde, würdest du es nicht verstehen. Und außerdem käme es mir blöd vor, es dir zu erklären."

# game/scripts/c17/c17.rpy:3223
translate german c17s003_AmandaLunch_bd357dbf:

    # mc "Puedes probar a hacerlo. Hay gente que dice que no soy tan tonto como parezco."
    mc "Du kannst es ja mal versuchen. Manche Leute sagen, ich sei nicht so dumm, wie es scheint."

# game/scripts/c17/c17.rpy:3224
translate german c17s003_AmandaLunch_ffbec445:

    # kia "No es eso. Pero no te preocupes. No es que hayas hecho nada... malo."
    kia "Das ist es nicht. Aber keine Sorge. Du hast ja nichts... falsch gemacht."

# game/scripts/c17/c17.rpy:3226
translate german c17s003_AmandaLunch_820442c5:

    # "Kiara empieza a comprobar la cocina, claramente buscando a alguien con quien hablar para librarse de ti."
    "Kiara beginnt, die Küche zu durchsuchen, offensichtlich auf der Suche nach jemandem, mit dem sie reden kann, um dich loszuwerden."

# game/scripts/c17/c17.rpy:3228
translate german c17s003_AmandaLunch_c1437193:

    # kia "Debería ir a hablar con..."
    kia "Ich sollte mit... reden gehen."

# game/scripts/c17/c17.rpy:3230
translate german c17s003_AmandaLunch_a636911b:

    # mc "Ve con Betty si tienes que ir, pero no huyas de mí, por favor. No huyas de nosotros."
    mc "Geh notfalls mit Betty, aber lauf bitte nicht vor mir weg. Lauf nicht vor uns weg."

# game/scripts/c17/c17.rpy:3232
translate german c17s003_AmandaLunch_8f0de41c:

    # kia "No quiero huir, [mc]."
    kia "Ich will nicht weglaufen, [mc]."

# game/scripts/c17/c17.rpy:3233
translate german c17s003_AmandaLunch_67d1140b:

    # kia "Es... es... complicado..."
    kia "Es ist... es ist... kompliziert..."

# game/scripts/c17/c17.rpy:3237
translate german c17s003_AmandaLunch_b68a7078:

    # kia "¡No! ¡No es complicado!"
    kia "Nein! Es ist nicht kompliziert!"

# game/scripts/c17/c17.rpy:3239
translate german c17s003_AmandaLunch_9f178ca7:

    # kia "*Susurrando* ¡Vas a ser el padre de mis nietos!"
    kia "*Flüsternd* Du wirst der Vater meiner Enkelkinder sein!"

# game/scripts/c17/c17.rpy:3241
translate german c17s003_AmandaLunch_be9da35d:

    # kia "*Susurrando* ¡Estás con mi hija!"
    kia "*Flüsternd* Du bist mit meiner Tochter zusammen!"

# game/scripts/c17/c17.rpy:3242
translate german c17s003_AmandaLunch_979136c5:

    # kia "¡Soy una mujer casada!"
    kia "Ich bin eine verheiratete Frau!"

# game/scripts/c17/c17.rpy:3243
translate german c17s003_AmandaLunch_ae009029:

    # mc "¿Qué? ¿Qué tiene que ver eso?"
    mc "Was? Was hat das denn damit zu tun?"

# game/scripts/c17/c17.rpy:3245
translate german c17s003_AmandaLunch_d5ea279d:

    # kia "Ya te he dicho que no lo entenderías si te lo explicaba."
    kia "Ich habe dir doch schon gesagt, dass du es nicht verstehen würdest, wenn ich es dir erklären würde."

# game/scripts/c17/c17.rpy:3246
translate german c17s003_AmandaLunch_8064e907:

    # mc "Pero no me has explicado nada..."
    mc "Aber du hast mir gar nichts erklärt..."

# game/scripts/c17/c17.rpy:3248
translate german c17s003_AmandaLunch_4431a7d9:

    # mc "¿Qué me he perdido?"
    mc "Was habe ich übersehen?"

# game/scripts/c17/c17.rpy:3250
translate german c17s003_AmandaLunch_3a905abb:

    # bet "Al final resultará que no eres tan listo como yo pensaba."
    bet "Am Ende wird sich herausstellen, dass du nicht so schlau bist, wie ich dachte."

# game/scripts/c17/c17.rpy:3252
translate german c17s003_AmandaLunch_7e715a92:

    # mc "Hola, Tía Betty. ¿Qué quieres decir?"
    mc "Hallo, Tante Betty. Was meinst du?"

# game/scripts/c17/c17.rpy:3253
translate german c17s003_AmandaLunch_a58eca9e:

    # bet "No eres capaz de descubrir lo que le pasa a Kiara por ti mismo, ¿verdad?"
    bet "Du kannst nicht selbst herausfinden, was mit Kiara los ist, oder?"

# game/scripts/c17/c17.rpy:3254
translate german c17s003_AmandaLunch_def038df:

    # mc "¿Sinceramente? No tengo ni idea de lo que está pasando ni de a qué te refieres."
    mc "Ganz ehrlich? Ich habe keine Ahnung, was hier vor sich geht oder wovon du redest."

# game/scripts/c17/c17.rpy:3256
translate german c17s003_AmandaLunch_982f271f:

    # bet "¿Quieres que te dibuje un plano o prefieres ir a ciegas?"
    bet "Soll ich Ihnen einen Plan entwerfen oder möchten Sie lieber unvorbereitet vorgehen?"

# game/scripts/c17/c17.rpy:3257
translate german c17s003_AmandaLunch_5e22a342:

    # mc "Una cosa es ir a ciegas, pero ahora voy sin plano, sin linterna, de noche, con los ojos vendados y las manos atadas."
    mc "Erblinden ist eine Sache, aber jetzt muss ich ohne Karte, ohne Taschenlampe, nachts, mit verbundenen Augen und gefesselten Händen unterwegs sein."

# game/scripts/c17/c17.rpy:3258
translate german c17s003_AmandaLunch_f594e452:

    # bet "Ven conmigo detrás de la isla. Podremos hablar más tranquilos allí."
    bet "Komm mit mir hinter die Insel. Dort können wir uns in Ruhe unterhalten."

# game/scripts/c17/c17.rpy:3260
translate german c17s003_AmandaLunch_2e2d7e07:

    # bet "¿Qué crees que le pasa a Kiara?"
    bet "Was ist deiner Meinung nach mit Kiara nicht in Ordnung?"

# game/scripts/c17/c17.rpy:3261
translate german c17s003_AmandaLunch_0c1070b9:

    # mc "No tengo ni idea. Todo iba genial hasta el día que fuimos a su casa. Con lo que lo único que se me ocurre es que fuera por lo que pasó con Solomon."
    mc "Ich habe keine Ahnung. Alles lief wunderbar, bis wir zu ihr nach Hause fuhren. Ich kann mir daher nur vorstellen, dass es mit dem Vorfall mit Solomon zusammenhing."

# game/scripts/c17/c17.rpy:3262
translate german c17s003_AmandaLunch_2f111123:

    # bet "Estamos hablando del mismo día en que empezamos los saludos con besos otra vez, ¿no? Culpa mía."
    bet "Wir sprechen vom selben Tag, an dem wir wieder angefangen haben, uns mit Küssen zu begrüßen, richtig? Mein Fehler."

# game/scripts/c17/c17.rpy:3263
translate german c17s003_AmandaLunch_00e8602f:

    # mc "Sí, claro. Fue el mismo día."
    mc "Ja, natürlich. Es war derselbe Tag."

# game/scripts/c17/c17.rpy:3265
translate german c17s003_AmandaLunch_3898f5d9:

    # bet "Después de lo que pasó en la cocina."
    bet "Nach dem, was in der Küche passiert ist."

# game/scripts/c17/c17.rpy:3267
translate german c17s003_AmandaLunch_df1b9f4a:

    # bet "Y de que descubriera que estás con Samantha."
    bet "Und dass er herausgefunden hat, dass du mit Samantha zusammen bist."

# game/scripts/c17/c17.rpy:3268
translate german c17s003_AmandaLunch_4a80ff50:

    # mc "Sí, pero sigo sin ver que tiene que ver eso. Hasta que llegamos a su casa todo iba bien. Cuando nos fuimos también."
    mc "Ja, aber ich verstehe immer noch nicht, was das damit zu tun hat. Bis wir zu ihrem Haus kamen, war alles in Ordnung. Und auch beim Weggehen war alles in Ordnung."

# game/scripts/c17/c17.rpy:3269
translate german c17s003_AmandaLunch_c0a91882:

    # mc "Pero desde que volvimos a casa está distante conmigo. No entiendo ese cambio en los diez minutos que hay de su casa a aquí."
    mc "Aber seit wir wieder zu Hause sind, ist er distanziert zu mir. Ich verstehe diese Veränderung nicht, die sich in den zehn Minuten, die wir von seinem Haus bis hierher brauchen, so stark bemerkbar macht."

# game/scripts/c17/c17.rpy:3271
translate german c17s003_AmandaLunch_9f95f68a:

    # bet "¿Te apetece jugar a un juego?"
    bet "Möchtest du ein Spiel spielen?"

# game/scripts/c17/c17.rpy:3272
translate german c17s003_AmandaLunch_02614fa0:

    # mc "Preferiría que me dijeras que crees que le pasa."
    mc "Ich würde es vorziehen, wenn Sie mir sagen würden, was Ihrer Meinung nach mit ihm nicht stimmt."

# game/scripts/c17/c17.rpy:3274
translate german c17s003_AmandaLunch_546dfd31:

    # bet "No te lo voy a decir. Podría haber sacado conclusiones equivocadas. Este juego lo inventó Olivia para [emm], pero también puede servir para ti."
    bet "Ich werde es dir nicht verraten. Vielleicht habe ich voreilige Schlüsse gezogen. Olivia hat dieses Spiel für [emm] entwickelt, aber es könnte auch für dich funktionieren."

# game/scripts/c17/c17.rpy:3275
translate german c17s003_AmandaLunch_598ca576:

    # mc "Adelante. Juguemos. Explícame las normas."
    mc "Na los. Lass uns spielen. Erkläre mir die Regeln."

# game/scripts/c17/c17.rpy:3276
translate german c17s003_AmandaLunch_2e734c76:

    # bet "Las normas son fáciles. Yo hago preguntas y tú respondes tras pensar cinco segundos."
    bet "Die Regeln sind einfach. Ich stelle Fragen und Sie antworten, nachdem Sie fünf Sekunden lang nachgedacht haben."

# game/scripts/c17/c17.rpy:3277
translate german c17s003_AmandaLunch_1efa927c:

    # mc "*Risa* Ahora entiendo por qué Meemaw lo inventó para [emm]. Adelante."
    mc "*Lacht* Jetzt verstehe ich, warum Meemaw es für [emm] erfunden hat. Nur zu."

# game/scripts/c17/c17.rpy:3279
translate german c17s003_AmandaLunch_54e5419f:

    # bet "Fuiste al rescate de Kiara y Eileen el día que abandonaron su casa, ¿verdad?"
    bet "Du bist also losgezogen, um Kiara und Eileen zu retten, als sie ihr Zuhause verlassen haben, richtig?"

# game/scripts/c17/c17.rpy:3280
translate german c17s003_AmandaLunch_809797bc:

    # mc "Sí. Para eso no necesito pensar cinco segundos."
    mc "Ja. Dafür muss ich keine fünf Sekunden nachdenken."

# game/scripts/c17/c17.rpy:3281
translate german c17s003_AmandaLunch_64969848:

    # bet "Cierto. La defendiste cuando apareció Solomon. ¿Cómo crees que se debe sentir después de que la rescataras y la defendieras?"
    bet "Das stimmt. Du hast sie verteidigt, als Salomo auftauchte. Wie muss sie sich wohl fühlen, nachdem du sie gerettet und verteidigt hast?"

# game/scripts/c17/c17.rpy:3282
translate german c17s003_AmandaLunch_7fe66ad7:

    # mc "Para esta tampoco tengo que pensar. Me lo ha dicho ella. Protegida y segura."
    mc "Auch darüber muss ich mir keine Gedanken machen. Sie hat es mir gesagt. Beschützt und sicher."

# game/scripts/c17/c17.rpy:3285
translate german c17s003_AmandaLunch_2db649db:

    # bet "¿Qué crees que debe pensar de tus relaciones?"
    bet "Was denkst du, was er über eure Beziehungen denken sollte?"

# game/scripts/c17/c17.rpy:3287
translate german c17s003_AmandaLunch_0fd388f1:

    # bet "¿Y de que, además, estés con su hija?"
    bet "Und was ist mit der Tatsache, dass du auch mit seiner Tochter zusammen bist?"

# game/scripts/c17/c17.rpy:3288
translate german c17s003_AmandaLunch_7758f356:

    # mc "No me lo he planteado. No tiene por qué pensar nada."
    mc "Ich habe darüber nicht nachgedacht. Du musst über gar nichts nachdenken."

# game/scripts/c17/c17.rpy:3290
translate german c17s003_AmandaLunch_ad5c65c9:

    # bet "Yo en su lugar pensaría que no te importa la edad que tengan las mujeres con las que sales."
    bet "Wenn ich du wäre, würde ich denken, dass dir das Alter der Frauen, mit denen du ausgehst, egal ist."

# game/scripts/c17/c17.rpy:3291
translate german c17s003_AmandaLunch_8cb31597:

    # mc "Y acertarías. La edad es sólo un número y no le presto atención en absoluto."
    mc "Und da hätten Sie Recht. Alter ist nur eine Zahl, und ich achte überhaupt nicht darauf."

# game/scripts/c17/c17.rpy:3293
translate german c17s003_AmandaLunch_fe4a498a:

    # bet "No hagas público eso o todas las abuelas de California empezarán a perseguirte. *Risa*"
    bet "Mach das bloß nicht öffentlich, sonst kriegst du Ärger mit allen Omas in Kalifornien. *lacht*"

# game/scripts/c17/c17.rpy:3294
translate german c17s003_AmandaLunch_74ec8853:

    # mc "¿Todas? ¿Tú también? *Risa*"
    mc "Alle? Du auch? *lacht*"

# game/scripts/c17/c17.rpy:3295
translate german c17s003_AmandaLunch_2e83fd20:

    # bet "*Risa* Yo no soy abuela. Solo vieja."
    bet "*lacht* Ich bin keine Großmutter. Nur alt."

# game/scripts/c17/c17.rpy:3297
translate german c17s003_AmandaLunch_09676202:

    # bet "Pero volvamos a Kiara antes de que digas algo inapropiado."
    bet "Aber lass uns lieber zu Kiara zurückkehren, bevor du etwas Unpassendes sagst."

# game/scripts/c17/c17.rpy:3298
translate german c17s003_AmandaLunch_1dbb2843:

    # bet "Un muchacho la rescata dos veces de su marido y la hace sentir protegida y segura. Un muchacho a quien le da lo mismo la edad de su pareja."
    bet "Ein junger Mann rettet sie zweimal vor ihrem Ehemann und gibt ihr ein Gefühl von Schutz und Geborgenheit. Ein junger Mann, dem das Alter seiner Partnerin egal ist."

# game/scripts/c17/c17.rpy:3301
translate german c17s003_AmandaLunch_6a3f24fc:

    # bet "Entonces tenemos a un muchacho que la ha rescatado dos veces de su marido y que la hace sentir protegida y segura."
    bet "Da ist also ein Junge, der sie schon zweimal vor ihrem Ehemann gerettet hat und der ihr ein Gefühl von Schutz und Geborgenheit gibt."

# game/scripts/c17/c17.rpy:3303
translate german c17s003_AmandaLunch_3f3d0a2c:

    # bet "Y que, para ella, es lo suficientemente bueno como para estar con su hija. Eso es importante y lo tienes que ver con mentalidad de madre."
    bet "Und für sie ist er gut genug, um mit ihrer Tochter zusammen zu sein. Das ist wichtig, und man muss es aus der Perspektive einer Mutter sehen."

# game/scripts/c17/c17.rpy:3317
translate german c17s003_AmandaLunch_bb31baa0:

    # bet "Ese muchacho sale con varias mujeres a la vez por lo que ella sabe."
    bet "Soweit sie weiß, trifft sich der Typ gleichzeitig mit mehreren Frauen."

# game/scripts/c17/c17.rpy:3319
translate german c17s003_AmandaLunch_623275ee:

    # bet "Ese muchacho está libre como un pájaro."
    bet "Dieser Junge ist so frei wie ein Vogel."

# game/scripts/c17/c17.rpy:3321
translate german c17s003_AmandaLunch_4a91fc4f:

    # bet "Pero la novia de ese muchacho es su hija."
    bet "Aber die Freundin des Jungen ist seine Tochter."

# game/scripts/c17/c17.rpy:3323
translate german c17s003_AmandaLunch_11e3bbf0:

    # bet "Suma a todo eso que te encanta dar abrazos y a ella le encanta que se los des."
    bet "Hinzu kommt noch, dass du gerne Umarmungen gibst und sie es liebt, wenn du sie umarmst."

# game/scripts/c17/c17.rpy:3324
translate german c17s003_AmandaLunch_e2a743f5:

    # bet "Añade los saludos con besos y... ¡Boom!"
    bet "Füge noch Begrüßungen mit Küssen hinzu und... Bumm!"

# game/scripts/c17/c17.rpy:3325
translate german c17s003_AmandaLunch_9cdd2fe5:

    # mc "¿A qué te refieres con \"Boom\"?"
    mc "Was meinen Sie mit „Boom“?"

# game/scripts/c17/c17.rpy:3327
translate german c17s003_AmandaLunch_85f307e2:

    # bet "Me estás tomando el pelo, ¿no? No puede ser que no lo estés pillando."
    bet "Du willst mich doch veräppeln, oder? Das verstehst du doch ganz bestimmt."

# game/scripts/c17/c17.rpy:3328
translate german c17s003_AmandaLunch_95b302bf:

    # mc "No, en serio."
    mc "Nein, im Ernst."

# game/scripts/c17/c17.rpy:3330
translate german c17s003_AmandaLunch_edd2c8f1:

    # bet "Vamos a ver si cambiando la perspectiva lo pillas."
    bet "Mal sehen, ob ein Perspektivenwechsel Ihnen zum Verständnis verhilft."

# game/scripts/c17/c17.rpy:3331
translate german c17s003_AmandaLunch_6297f023:

    # bet "Imagínate que conoces a una mujer más mayor que tú, fuerte, guapa, sexy y adorable. Pongamos que tiene el físico de Kiara. Además, te hace sentir apreciado."
