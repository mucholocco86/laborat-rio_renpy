    # "Se oyen sus pasos bajando las escaleras. Ha sido una mañana fantástica."
    "Ich höre ihre Schritte die Treppe herunterkommen. Es war ein fantastischer Morgen."

# game/scripts/c23/c23.rpy:587
translate german c23s002_SaiPregnancy_56bb8438:

    # "Bajas a desayunar y, por una vez, no hay nadie en la cocina."
    "Du gehst zum Frühstück nach unten und – ausnahmsweise – ist niemand in der Küche."

# game/scripts/c23/c23.rpy:588
translate german c23s002_SaiPregnancy_b40a9cec:

    # "Preparas un café y coges un trozo pequeño de pastel."
    "Du machst dir einen Kaffee und nimmst ein kleines Stück Kuchen."

# game/scripts/c23/c23.rpy:590
translate german c23s002_SaiPregnancy_9e188d5b:

    # "A los pocos minutos aparece [sai]."
    "Wenige Minuten später erscheint [sai]."

# game/scripts/c23/c23.rpy:591
translate german c23s002_SaiPregnancy_f200ce13:

    # sai "Hola, [mc]. Qué raro ver la cocina tan vacía."
    sai "Hallo, [mc]. Wie seltsam, die Küche so leer zu sehen."

# game/scripts/c23/c23.rpy:594
translate german c23s002_SaiPregnancy_b7d10e84:

    # mc "Hola, cielo."
    mc "Hallo Schatz."

# game/scripts/c23/c23.rpy:595
translate german c23s002_SaiPregnancy_8dfe7662:

    # mc "Creo que todo el mundo está haciendo yoga ahora mismo o preparándose para ir a clase."
    mc "Ich glaube, entweder macht gerade jeder Yoga oder bereitet sich auf den Kurs vor."

# game/scripts/c23/c23.rpy:597
translate german c23s002_SaiPregnancy_7844caef:

    # sai "Tienes razón. Hoy es más tarde que ayer. No tengo clase esta mañana."
    sai "Du hast Recht. Es ist heute später als gestern. Ich habe heute Vormittag keine Vorlesung."

# game/scripts/c23/c23.rpy:598
translate german c23s002_SaiPregnancy_48f80515:

    # sai "Tan solo tengo que acabar un estudio sobre Maria Montessori."
    sai "Ich muss nur noch eine Studie über Maria Montessori fertigstellen."

# game/scripts/c23/c23.rpy:599
translate german c23s002_SaiPregnancy_9319a8a3:

    # mc "No tengo ni idea de quién es."
    mc "Ich habe keine Ahnung, wer sie ist."

# game/scripts/c23/c23.rpy:602
translate german c23s002_SaiPregnancy_502d27d9:

    # "Para cuando acaba, tú has terminado tu trozo de pastel, quizás demasiado pequeño, y subes a tu habitación."
    "Wenn es vorbei ist, hast du dein Stück Kuchen aufgegessen, das vielleicht zu klein war, und gehst hinauf in dein Zimmer."

# game/scripts/c23/c23.rpy:606
translate german c23s002_SaiPregnancy_b6c6519b:

    # sai "Era una profesora italiana que..."
    sai "Sie war eine italienische Lehrerin, die..."

# game/scripts/c23/c23.rpy:609
translate german c23s002_SaiPregnancy_5e9d0ebe:

    # mc "Parece interesante."
    mc "Das sieht interessant aus."

# game/scripts/c23/c23.rpy:610
translate german c23s002_SaiPregnancy_d1b6da3b:

    # sai "Lo es. Pero ¿sabes qué sería interesante también?"
    sai "Das stimmt. Aber wissen Sie, was auch interessant wäre?"

# game/scripts/c23/c23.rpy:611
translate german c23s002_SaiPregnancy_a02421db:

    # mc "*Risa* Muchas cosas. Es una pregunta imposible de acertar."
    mc "*Lacht* Jede Menge Dinge. Es ist unmöglich, diese Frage richtig zu beantworten."

# game/scripts/c23/c23.rpy:613
translate german c23s002_SaiPregnancy_ed23f690:

    # sai "Tienes razón. *Risa* Sin saber en lo que estoy pensando es imposible que lo aciertes."
    sai "Du hast recht. *lacht* Ohne zu wissen, was ich denke, ist es für dich unmöglich, es zu erraten."

# game/scripts/c23/c23.rpy:614
translate german c23s002_SaiPregnancy_1b6c05eb:

    # mc "Dame alguna pista..."
    mc "Gib mir einen Hinweis..."

# game/scripts/c23/c23.rpy:616
translate german c23s002_SaiPregnancy_3ceb6b04:

    # sai "Hablando de Montessori he empezado a pensar en niños..."
    sai "Das Thema Montessori hat mich zum Nachdenken über Kinder angeregt..."

# game/scripts/c23/c23.rpy:617
translate german c23s002_SaiPregnancy_669007dc:

    # mc "Y quieres saber el resultado de la prueba de embarazo."
    mc "Und Sie möchten das Ergebnis des Schwangerschaftstests erfahren."

# game/scripts/c23/c23.rpy:619
translate german c23s002_SaiPregnancy_933d228c:

    # sai "Me conoces demasiado. ¿Te importa si subimos ya? Puedo desayunar más tarde."
    sai "Du kennst mich zu gut. Hättest du etwas dagegen, wenn wir jetzt nach oben gehen? Ich kann später frühstücken."

# game/scripts/c23/c23.rpy:620
translate german c23s002_SaiPregnancy_ed63e57f:

    # mc "Si, por mí perfecto. Cuanto antes lo sepamos, mejor. Vamos."
    mc "Ja, das passt mir perfekt. Je eher wir es wissen, desto besser. Los geht's."

# game/scripts/c23/c23.rpy:623
translate german c23s002_SaiPregnancy_f3a408c1:

    # sai "*Risa* Pobre [sca]. Con lo poco que le gusta el deporte, y ha tenido que subir hasta la azotea para nada."
    sai "*Lacht* Die Arme [sca]. Sie mag Sport nicht besonders und musste umsonst bis aufs Dach klettern."

# game/scripts/c23/c23.rpy:624
translate german c23s002_SaiPregnancy_07355acc:

    # mc "*Risa* Y ahora bajar corriendo a la piscina. Va a llegar agotada."
    mc "*lacht* Und jetzt muss sie noch schnell zum Pool runterrennen. Bis dahin wird sie total erschöpft sein."

# game/scripts/c23/c23.rpy:626
translate german c23s002_SaiPregnancy_28c4ed1c:

    # sai "¿Continuamos a tu habitación?"
    sai "Sollen wir zu Ihrem Zimmer weitergehen?"

# game/scripts/c23/c23.rpy:627
translate german c23s002_SaiPregnancy_63cd8ebd:

    # mc "Vamos."
    mc "Aufleuchten."

# game/scripts/c23/c23.rpy:629
translate german c23s002_SaiPregnancy_b95a4741:

    # mc "Lo puedes coger tú misma si quieres. Está en el armario."
    mc "Du kannst es dir selbst holen, wenn du willst. Es ist im Schrank."

# game/scripts/c23/c23.rpy:630
translate german c23s002_SaiPregnancy_b8617989:

    # sai "Mejor míralo tú primero. Estoy un poco nerviosa."
    sai "Du solltest es dir zuerst ansehen. Ich bin etwas nervös."

# game/scripts/c23/c23.rpy:631
translate german c23s002_SaiPregnancy_0e4115b6:

    # mc "¿Te da miedo estar embarazada?"
    mc "Hast du Angst davor, schwanger zu sein?"

# game/scripts/c23/c23.rpy:633
translate german c23s002_SaiPregnancy_5c972d3b:

    # sai "Por un lado no. Quiero tener un par de críos correteando por casa lo antes posible. Me da lo mismo si son niños o niñas."
    sai "Einerseits nein. Ich möchte so schnell wie möglich ein paar Kinder im Haus herumtoben haben. Mir ist es egal, ob es Jungen oder Mädchen sind."

# game/scripts/c23/c23.rpy:634
translate german c23s002_SaiPregnancy_7ff3a75e:

    # sai "Por otro lado... creo que es demasiado pronto... aún no he acabado la carrera y nunca me había planteado tener hijos tan joven..."
    sai "Andererseits... ich glaube, es ist noch zu früh... Ich habe mein Studium noch nicht abgeschlossen und habe nie darüber nachgedacht, so jung Kinder zu bekommen..."

# game/scripts/c23/c23.rpy:635
translate german c23s002_SaiPregnancy_88c6d337:

    # mc "Bueno, si estás embarazada, no hay mucho que podamos hacer, pero si no lo estás, si quieres puedes volver a tomar anticonceptivos."
    mc "Nun ja, wenn Sie schwanger sind, können wir nicht viel tun, aber wenn Sie nicht schwanger sind, können Sie, wenn Sie möchten, wieder mit der Verhütung beginnen."

# game/scripts/c23/c23.rpy:636
translate german c23s002_SaiPregnancy_7c8ba9d4:

    # mc "Tenemos mucho tiempo para tener ese par de niños."
    mc "Wir haben noch genügend Zeit, um diese beiden Kinder zu bekommen."

# game/scripts/c23/c23.rpy:638
translate german c23s002_SaiPregnancy_e13264a4:

    # sai "No pienso tomar anticonceptivos. Cuando el destino decida que tienen que llegar, llegarán."
    sai "Ich habe nicht vor, die Pille zu nehmen. Wenn das Schicksal es so will, dann wird es so sein."

# game/scripts/c23/c23.rpy:639
translate german c23s002_SaiPregnancy_6a559599:

    # sai "Y míralo ya antes de que me ponga más nerviosa."
    sai "Und schau es dir jetzt an, bevor ich noch nervöser werde."

# game/scripts/c23/c23.rpy:655
translate german c23s002_ScaYoga_6b530c5d:

    # "Al salir al comedor te encuentras con [sca] con pinta de estar perdida."
    "Beim Betreten des Speisesaals begegnen Sie [sca], der/die anscheinend die Orientierung verloren hat."

# game/scripts/c23/c23.rpy:656
translate german c23s002_ScaYoga_c8e9c7f8:

    # mc "¿Buscas algo, [sca]?"
    mc "Suchst du etwas, [sca]?"

# game/scripts/c23/c23.rpy:657
translate german c23s002_ScaYoga_4fd9952d:

    # sca "Creo que he llegado tarde a la sesión de yoga."
    sca "Ich glaube, ich bin zu spät zum Yoga."

# game/scripts/c23/c23.rpy:659
translate german c23s002_ScaYoga_212eb0dc:

    # mc "¿Has decidido apuntarte? Eso es nuevo."
    mc "Hast du dich entschieden, dich anzumelden? Das ist neu."

# game/scripts/c23/c23.rpy:660
translate german c23s002_ScaYoga_bc90664b:

    # sca "Bueno, después de lo de ayer, quiero hacer aún más cosas con las chicas."
    sca "Nach dem, was gestern passiert ist, möchte ich noch mehr mit den Mädchen unternehmen."

# game/scripts/c23/c23.rpy:661
translate german c23s002_ScaYoga_cc3dd443:

    # sca "Pero acabo de ir a la terraza y parece que ya han acabado."
    sca "Aber ich bin gerade auf die Terrasse gegangen und es sieht so aus, als wären sie fertig."

# game/scripts/c23/c23.rpy:662
translate german c23s002_ScaYoga_709d1211:

    # mc "Oh, ¿nadie te ha dicho que han movido las sesiones de yoga a la piscina?"
    mc "Oh, hat dir denn niemand gesagt, dass die Yoga-Stunden jetzt am Pool stattfinden?"

# game/scripts/c23/c23.rpy:664
translate german c23s002_ScaYoga_9c5d3a71:

    # sca "¿Qué? ¡No! Nadie me lo había dicho."
    sca "Was? Nein! Niemand hatte mir etwas gesagt."

# game/scripts/c23/c23.rpy:665
translate german c23s002_ScaYoga_7763df00:

    # sca "¡Me voy antes de que acaben!"
    sca "Ich gehe, bevor sie fertig sind!"

# game/scripts/c23/c23.rpy:667
translate german c23s002_ScaYoga_e4aaf8ac:

    # mc "Hasta luego, [sca]."
    mc "Bis später, [sca]."

# game/scripts/c23/c23.rpy:669
translate german c23s002_ScaYoga_12242b08:

    # sai "Adiós, [sca]."
    sai "Auf Wiedersehen, [sca]."

# game/scripts/c23/c23.rpy:670
translate german c23s002_ScaYoga_06da67ce:

    # sca "Hasta luego..."
    sca "Bis später..."

# game/scripts/c23/c23.rpy:673
translate german c23s002_ScaYoga_3cbfaa21:

    # sca "Ahora sí. Hasta luego."
    sca "Okay, dann. Bis später."

# game/scripts/c23/c23.rpy:677
translate german c23s002_Montessori_b75a7dd9:

    # "[sai] pasa los siguientes minutos explicándote la biografía de la pedagoga. Por lo visto hizo cosas revolucionarias para su época."
    "[sai] verbringt die nächsten Minuten damit, die Biografie der Pädagogin zu erläutern. Offenbar hat sie für ihre Zeit revolutionäre Dinge getan."

# game/scripts/c23/c23.rpy:678
translate german c23s002_Montessori_01d25fc0:

    # "Pero es una historia en la que se entrevén muchos grises."
    "Aber es ist eine Geschichte, in der viele Grautöne zu erkennen sind."

# game/scripts/c23/c23.rpy:682
translate german c23s002_SaiPregnant_a5389849:

    # mc "¡Verde. Vamos a tener un bebé!"
    mc "Green. Wir bekommen ein Baby!"

# game/scripts/c23/c23.rpy:684
translate german c23s002_SaiPregnant_b0eb6df2:

    # sai "Felicidades, cielo. Sé que te hacía ilusión."
    sai "Herzlichen Glückwunsch, Liebling. Ich weiß, du hast dich sehr darauf gefreut."

# game/scripts/c23/c23.rpy:685
translate german c23s002_SaiPregnant_0b584a5b:

    # mc "No suenas muy contenta."
    mc "Du klingst nicht sehr glücklich."

# game/scripts/c23/c23.rpy:687
translate german c23s002_SaiPregnant_2d6f41fa:

    # sai "Estoy contenta, pero preocupada."
    sai "Ich bin glücklich, aber besorgt."

# game/scripts/c23/c23.rpy:688
translate german c23s002_SaiPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Für das Rennen? Wir helfen Ihnen, wo wir können."

# game/scripts/c23/c23.rpy:690
translate german c23s002_SaiPregnant_f2f8f8f9:

    # sai "No, la carrera no me preocupa demasiado. Me parece raro tener un bebé antes de acabarla, pero ya está."
    sai "Nein, mein Studium bereitet mir keine großen Sorgen. Es fühlt sich zwar komisch an, vor dem Abschluss ein Baby zu bekommen, aber das ist auch schon alles."

# game/scripts/c23/c23.rpy:691
translate german c23s002_SaiPregnant_7ddf9ba8:

    # sai "Me preocupa decírselo a mis padres."
    sai "Ich habe Angst, es meinen Eltern zu erzählen."

# game/scripts/c23/c23.rpy:692
translate german c23s002_SaiPregnant_0cabfb10:

    # mc "¿Cómo se lo van a tomar?"
    mc "Wie werden sie das aufnehmen?"

# game/scripts/c23/c23.rpy:694
translate german c23s002_SaiPregnant_2c5430c4:

    # mc "Bueno, si quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Also gut, wenn du willst, dass ich es ihm sage, bin ich dabei..."

# game/scripts/c23/c23.rpy:696
translate german c23s002_SaiPregnant_1219b8ff:

    # sai "No te preocupes. No se lo voy a decir todavía."
    sai "Keine Sorge. Ich werde es ihm noch nicht sagen."

# game/scripts/c23/c23.rpy:697
translate german c23s002_SaiPregnant_038560de:

    # mc "¿Por qué? ¿Cuánto quieres esperar?"
    mc "Warum? Wie lange möchten Sie warten?"

# game/scripts/c23/c23.rpy:699
translate german c23s002_SaiPregnant_c5240d56:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les digo que me he quedado embarazada del dueño de la residencia, no le van a dejar venir."
    sai "Zumindest solange, bis Kaly da ist. Wenn ich ihnen sage, dass ich vom Hausbesitzer schwanger bin, lassen sie sie nicht kommen."

# game/scripts/c23/c23.rpy:700
translate german c23s002_SaiPregnant_4244b12a:

    # sai "Van a pensar que la vas a dejar embarazada en cuanto llegue..."
    sai "Sie werden denken, dass du sie schwängern willst, sobald sie da ist..."

# game/scripts/c23/c23.rpy:702
translate german c23s002_SaiPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "Und das alles ohne Ihren Ruf als Vater von Kindern, die Indien erreichen."

# game/scripts/c23/c23.rpy:703
translate german c23s002_SaiPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Ich habe keinerlei Absicht, irgendetwas mit Kalyani zu haben, [sai]."

# game/scripts/c23/c23.rpy:705
translate german c23s002_SaiPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Lacht* Sobald du diese großen Augen auf deinem Gesicht blinzeln siehst, wirst du es mir bestätigen."

# game/scripts/c23/c23.rpy:706
translate german c23s002_SaiPregnant_5aacd3bb:

    # mc "Bueno, pero aparte de lo de tus padres, ¿cómo estás tú?"
    mc "Okay, aber abgesehen von deinen Eltern, wie geht es dir?"

# game/scripts/c23/c23.rpy:708
translate german c23s002_SaiPregnant_a7bc00ad:

    # sai "Ya te digo que estoy contenta, aunque..."
    sai "Ich sage Ihnen, ich bin glücklich, obwohl..."

# game/scripts/c23/c23.rpy:709
translate german c23s002_SaiPregnant_3b916da8:

    # mc "¿Qué pasa?"
    mc "Was passiert?"

# game/scripts/c23/c23.rpy:711
translate german c23s002_SaiPregnant_ed7721cb:

    # sai "No voy a poder volverme a poner este top en cuanto éstas empiecen a crecer. Voy a tener que cambiar el vestuario."
    sai "Ich werde dieses Oberteil nicht mehr tragen können, sobald meine Brüste wachsen. Ich muss meine Garderobe umstellen."

# game/scripts/c23/c23.rpy:712
translate german c23s002_SaiPregnant_29681486:

    # mc "*Risa* Vas a estar guapísima lleves lo que lleves."
    mc "*lacht* Du wirst in allem umwerfend aussehen."

# game/scripts/c23/c23.rpy:714
translate german c23s002_SaiPregnant_5b606ea9:

    # sai "No es cómo esperaba que pasara, pero estoy más contenta de lo que parezco. Tan solo me siento rara de tener que ocultárselo a mis padres."
    sai "So hatte ich es mir nicht vorgestellt, aber ich bin glücklicher, als es aussieht. Es fühlt sich nur komisch an, es vor meinen Eltern verheimlichen zu müssen."

# game/scripts/c23/c23.rpy:715
translate german c23s002_SaiPregnant_490a5817:

    # mc "No se lo ocultas, retrasas la noticia tan solo."
    mc "Du verheimlichst es ihm nicht, du verzögerst die Nachricht nur."

# game/scripts/c23/c23.rpy:717
translate german c23s002_SaiPregnant_50ec1616:

    # sai "¡Vamos a la piscina! Quiero darles la noticia al resto de las chicas. Después lo publicaré en el grupo de WhatsUp."
    sai "Lasst uns zum Schwimmbad gehen! Ich möchte es den anderen Mädchen sagen. Ich poste es später in der WhatsApp-Gruppe."

# game/scripts/c23/c23.rpy:718
translate german c23s002_SaiPregnant_c884d001:

    # mc "¿En el que estoy yo o en el que no estoy?"
    mc "In der, in der ich bin, oder in der, in der ich nicht bin?"

# game/scripts/c23/c23.rpy:720
translate german c23s002_SaiPregnant_f50b3bac:

    # sai "En los dos. En el tuyo no contestará casi nadie, pero lo publicaré por si alguien quiere felicitarte a ti."
    sai "In beiden Fällen. Wahrscheinlich wird kaum jemand auf deinen Beitrag antworten, aber ich poste ihn trotzdem, falls dir jemand gratulieren möchte."

# game/scripts/c23/c23.rpy:721
translate german c23s002_SaiPregnant_831b697a:

    # mc "*Risa* A veces os odio. Vamos."
    mc "*lacht* Manchmal hasse ich euch. Na los."

# game/scripts/c23/c23.rpy:725
translate german c23s002_parents_7589d59f:

    # sai "Imagínate enviar a tu hija al extranjero a estudiar y que antes de que acabe la carrera se quede embarazada."
    sai "Stellen Sie sich vor, Sie schicken Ihre Tochter zum Studieren ins Ausland und sie wird schwanger, bevor sie ihr Studium abgeschlossen hat."

# game/scripts/c23/c23.rpy:726
translate german c23s002_parents_f5a86a18:

    # sai "Y del dueño de la residencia de estudiantes nada menos... Y sin estar casados..."
    sai "Und das vom Besitzer des Studentenwohnheims, wohlgemerkt... Und das, obwohl er nicht verheiratet ist..."

# game/scripts/c23/c23.rpy:727
translate german c23s002_parents_3c948955:

    # mc "Me lo puedo imaginar. Ya me dijiste que eran muy tradicionales."
    mc "Das kann ich mir vorstellen. Du hast mir ja schon gesagt, dass sie sehr traditionell sind."

# game/scripts/c23/c23.rpy:729
translate german c23s002_parents_0da23dec:

    # sai "*Risa triste* ¿Tradicionales? Une a eso retrógrados y te acercarás a una versión modernizada de mis padres."
    sai "*Trauriges Lachen* Traditionell? Füge dem noch „rückständig“ hinzu, und du hast so etwas wie eine modernisierte Version meiner Eltern."

# game/scripts/c23/c23.rpy:730
translate german c23s002_parents_1b3c77e8:

    # sai "A veces parece que vivan en el Siglo XIX o el XX."
    sai "Manchmal hat man den Eindruck, sie lebten im 19. oder 20. Jahrhundert."

# game/scripts/c23/c23.rpy:734
translate german c23s002_SaiNotPregnant_26eea004:

    # mc "Rojo. No vamos a tener un bebé aún."
    mc "Rot. Wir bekommen noch kein Baby."

# game/scripts/c23/c23.rpy:736
translate german c23s002_SaiNotPregnant_d975b988:

    # sai "Bueno, otra vez será. No tenemos prisa."
    sai "Na ja, vielleicht beim nächsten Mal. Wir haben es ja nicht eilig."

# game/scripts/c23/c23.rpy:737
translate german c23s002_SaiNotPregnant_2537456b:

    # mc "No suenas muy decepcionada. Eso es bueno."
    mc "Du klingst nicht sehr enttäuscht. Das ist gut."

# game/scripts/c23/c23.rpy:739
translate german c23s002_SaiNotPregnant_e6495c22:

    # sai "Estoy decepcionada, pero, por otro lado, estoy aliviada."
    sai "Ich bin enttäuscht, aber andererseits auch erleichtert."

# game/scripts/c23/c23.rpy:740
translate german c23s002_SaiNotPregnant_851b9294:

    # mc "¿Por la carrera? Te ayudaremos en todo lo que podamos."
    mc "Für das Rennen? Wir helfen Ihnen, wo wir können."

# game/scripts/c23/c23.rpy:742
translate german c23s002_SaiNotPregnant_b6444778:

    # sai "No, la carrera no me preocupa demasiado. Me hubiera parecido raro tener un bebé antes de acabarla, pero ya está."
    sai "Nein, mein Studium bereitet mir keine großen Sorgen. Es wäre zwar seltsam gewesen, vor dem Abschluss ein Kind zu bekommen, aber so ist es nun mal."

# game/scripts/c23/c23.rpy:743
translate german c23s002_SaiNotPregnant_4b9b2f05:

    # sai "Me preocupaba decírselo a mis padres."
    sai "Ich hatte Angst, es meinen Eltern zu erzählen."

# game/scripts/c23/c23.rpy:744
translate german c23s002_SaiNotPregnant_0beea497:

    # mc "¿Cómo se lo iban a tomar?"
    mc "Wie würden sie das aufnehmen?"

# game/scripts/c23/c23.rpy:746
translate german c23s002_SaiNotPregnant_7eec1ef5:

    # mc "Bueno, si, cuando te quedes embarazada, quieres que esté ahí para decírselo, cuenta conmigo..."
    mc "Also, wenn du möchtest, dass ich ihm Bescheid sage, wenn du schwanger bist, bin ich dabei..."

# game/scripts/c23/c23.rpy:748
translate german c23s002_SaiNotPregnant_e4455855:

    # sai "No te preocupes. No se lo pensaba decir aunque me hubiera quedado embarazada ahora."
    sai "Keine Sorge. Ich hätte es ihm sowieso nicht gesagt, selbst wenn ich jetzt schwanger wäre."

# game/scripts/c23/c23.rpy:749
translate german c23s002_SaiNotPregnant_d9f65540:

    # mc "¿Por qué? ¿Cuánto hubieras querido esperar?"
    mc "Warum? Wie lange hätten Sie gerne gewartet?"

# game/scripts/c23/c23.rpy:751
translate german c23s002_SaiNotPregnant_6016f36c:

    # sai "Como mínimo, hasta que Kaly esté aquí. Si les hubiera dicho que me he quedado embarazada del dueño de la residencia, no le iban a dejar venir."
    sai "Zumindest bis Kaly da ist. Hätte ich ihnen gesagt, dass ich vom Hausbesitzer schwanger bin, hätten sie sie nicht kommen lassen."

# game/scripts/c23/c23.rpy:752
translate german c23s002_SaiNotPregnant_e27513d6:

    # sai "Iban a pensar que la ibas a dejar embarazada en cuanto llegara..."
    sai "Sie würden denken, dass du sie schwängern würdest, sobald sie ankommt..."

# game/scripts/c23/c23.rpy:754
translate german c23s002_SaiNotPregnant_b7a9c78c:

    # sai "Y eso que tu fama de embarazador no ha llegado aún hasta India."
    sai "Und das alles ohne Ihren Ruf als Vater von Kindern, die Indien erreichen."

# game/scripts/c23/c23.rpy:755
translate german c23s002_SaiNotPregnant_3f1f807c:

    # mc "No tengo intención de tener nada con Kalyani, [sai]."
    mc "Ich habe keinerlei Absicht, irgendetwas mit Kalyani zu haben, [sai]."

# game/scripts/c23/c23.rpy:757
translate german c23s002_SaiNotPregnant_8e90b55d:

    # sai "*Risa* En cuanto veas esos grandes ojos parpadeando en tu cara, me lo confirmas."
    sai "*Lacht* Sobald du diese großen Augen auf deinem Gesicht blinzeln siehst, wirst du es mir bestätigen."

# game/scripts/c23/c23.rpy:758
translate german c23s002_SaiNotPregnant_79b68995:

    # mc "*Risa* No me tientes, sabes que unos ojos bonitos son mi perdición."
    mc "*Lacht* Versuch mich nicht in Versuchung zu führen, du weißt doch, dass schöne Augen mein Verhängnis sind."

# game/scripts/c23/c23.rpy:759
translate german c23s002_SaiNotPregnant_b22bd2d7:

    # mc "Pero volviendo a tus padres, la parte buena es que no tienes que ocultarles nada."
    mc "Aber um auf deine Eltern zurückzukommen: Das Gute daran ist, dass du vor ihnen nichts verheimlichen musst."

# game/scripts/c23/c23.rpy:761
translate german c23s002_SaiNotPregnant_7bc4da83:

    # sai "Sí, y al menos no tendré que cambiar de vestuario."
    sai "Ja, und wenigstens muss ich mein Outfit nicht wechseln."

# game/scripts/c23/c23.rpy:762
translate german c23s002_SaiNotPregnant_b3961c59:

    # mc "¿Por qué?"
    mc "Weil?"

# game/scripts/c23/c23.rpy:764
translate german c23s002_SaiNotPregnant_f3513bd4:

    # sai "Si me hubiera quedado embarazada no hubiera podido volver a ponerme este top en cuanto éstas empezaran a crecer."
    sai "Wenn ich schwanger geworden wäre, hätte ich dieses Oberteil nicht mehr tragen können, sobald meine Brüste zu wachsen begonnen hätten."

# game/scripts/c23/c23.rpy:765
translate german c23s002_SaiNotPregnant_5f5a76d1:

    # mc "*Risa* Ibas a estar guapísima llevaras lo que llevaras."
    mc "*lacht* Du hättest in jedem Outfit umwerfend ausgesehen."

# game/scripts/c23/c23.rpy:767
translate german c23s002_SaiNotPregnant_15a7439e:

    # sai "Voy a ir a la piscina a decirle a [mar] y a [emm] que el test ha salido negativo."
    sai "Ich gehe zum Schwimmbad, um [mar] und [emm] zu sagen, dass der Test negativ ausgefallen ist."

# game/scripts/c23/c23.rpy:768
translate german c23s002_SaiNotPregnant_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Soll ich dich begleiten?"

# game/scripts/c23/c23.rpy:770
translate german c23s002_SaiNotPregnant_f0467d0d:

    # sai "No hace falta. Me van a querer dar abrazos para consolarme, aunque no sean necesarios. *Risa* Quiero esos abrazos solo para mí."
    sai "Das ist nicht nötig. Sie werden mich tröstend umarmen wollen, obwohl ich das gar nicht brauche. *Lacht* Ich will diese Umarmungen ganz für mich allein."

# game/scripts/c23/c23.rpy:771
translate german c23s002_SaiNotPregnant_91dba7af:

    # mc "*Risa* A veces os odio. Te veo luego."
    mc "*lacht* Manchmal hasse ich euch. Bis später."

# game/scripts/c23/c23.rpy:781
translate german c23s002_Lugagge_75bb8a0c:

    # "Vas al lavabo y vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Du gehst auf die Toilette und kehrst in dein Zimmer zurück, um für die morgige Reise einen Rucksack mit Wechselkleidung zu packen."

# game/scripts/c23/c23.rpy:783
translate german c23s002_Lugagge_ecee5073:

    # "Después de pasar por la piscina, vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Nach dem Besuch im Schwimmbad kehrst du in dein Zimmer zurück, um für den morgigen Ausflug einen Rucksack mit Wechselkleidung zu packen."

# game/scripts/c23/c23.rpy:785
translate german c23s002_Lugagge_c1485301:

    # "Vuelves a tu habitación a meter una muda de ropa en una mochila para el viaje de mañana."
    "Du gehst zurück in dein Zimmer, um für die morgige Reise einen Rucksack mit Wechselkleidung zu packen."

# game/scripts/c23/c23.rpy:786
translate german c23s002_Lugagge_12d1537c:

    # "Cuando casi has acabado..."
    "Wenn du fast fertig bist..."

# game/scripts/c23/c23.rpy:789
translate german c23s002_Lugagge_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c23/c23.rpy:791
translate german c23s002_Lugagge_bb9c1f60:

    # mom "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mom "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c23/c23.rpy:792
translate german c23s002_Lugagge_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c23/c23.rpy:797
translate german c23s002_Lugagge_9bbf8b8f:

    # mom "Venía a ver si querías que te ayudara a hacer la maleta para mañana."
    mom "Ich bin gekommen, um zu fragen, ob ich Ihnen beim Packen Ihres Koffers für morgen helfen soll."

# game/scripts/c23/c23.rpy:798
translate german c23s002_Lugagge_88471209:

    # mc "*Risa* ¿Maleta? Con una mochila tengo suficiente. Una muda de ropa y artículos de higiene."
    mc "*Lacht* Koffer? Ein Rucksack reicht. Wechselkleidung und Toilettenartikel."

# game/scripts/c23/c23.rpy:800
translate german c23s002_Lugagge_7a59eeaa:

    # mom "¿Sólo eso?"
    mom "Das ist alles?"

# game/scripts/c23/c23.rpy:801
translate german c23s002_Lugagge_d157fcf1:

    # mc "No necesito más. Es solo una noche."
    mc "Mehr brauche ich nicht. Es ist ja nur eine Nacht."

# game/scripts/c23/c23.rpy:802
translate german c23s002_Lugagge_0299b411:

    # mom "¿Y si llueve? ¿O si hace frío? Deberías coger una chaqueta."
    mom "Was ist, wenn es regnet? Oder wenn es kalt ist? Dann sollten Sie eine Jacke mitnehmen."

# game/scripts/c23/c23.rpy:807
translate german c23s002_Lugagge_54eacab5:

    # mc "[Mom], he mirado las temperaturas en el móvil, y se espera que haga buen día."
    mc "[Mom], Ich habe die Temperaturen auf meinem Handy überprüft, und es soll ein schöner Tag werden."

# game/scripts/c23/c23.rpy:809
translate german c23s002_Lugagge_c95214f0:

    # mom "Nunca te puedes fiar de esas aplicaciones, cielo. Acuérdate de cuando fuimos a Fresno. La app decía que iba a hacer sol y llovió."
    mom "Auf diese Apps kann man sich nie verlassen, Schatz. Weißt du noch, als wir in Fresno waren? Die App sagte Sonnenschein, und es hat geregnet."

# game/scripts/c23/c23.rpy:810
translate german c23s002_Lugagge_623d3f2f:

    # mc "De eso hace casi diez años, [Mom]. Las aplicaciones son mucho más fiables ahora."
    mc "Das war vor fast zehn Jahren, [Mom]. Anwendungen sind heute wesentlich zuverlässiger."

# game/scripts/c23/c23.rpy:812
translate german c23s002_Lugagge_56eefaa0:

    # mom "Bueno, pero llévate una chaqueta por lo que pueda ser. ¿Qué camisas te vas a llevar?"
    mom "Okay, aber nimm vorsichtshalber eine Jacke mit. Welche Hemden nimmst du mit?"

# game/scripts/c23/c23.rpy:813
translate german c23s002_Lugagge_6690c782:

    # mc "Una camiseta. Nada de camisas. Van a llegar arrugadas."
    mc "Ein T-Shirt. Keine Hemden. Die kommen zerknittert an."

# game/scripts/c23/c23.rpy:815
translate german c23s002_Lugagge_9939e1dd:

    # mom "Deberías llevarte la camisa azul. Tienes que ir bien vestido si vas a reunirte con el obispo, y esa camisa te queda muy bien."
    mom "Du solltest das blaue Hemd nehmen. Du musst dich gut kleiden, wenn du den Bischof triffst, und das Hemd steht dir sehr gut."

# game/scripts/c23/c23.rpy:816
translate german c23s002_Lugagge_4eddcb7c:

    # mc "*Risa* No soy yo quien se reúne con el obispo, es Tía [bet]. Por una vez sólo hago de chófer, no tengo que resolver nada."
    mc "*Lacht* Ich treffe nicht den Bischof, sondern Tante [bet]. Ausnahmsweise bin ich nur der Chauffeur, ich muss nichts klären."

# game/scripts/c23/c23.rpy:817
translate german c23s002_Lugagge_f5adc8f7:

    # mc "Y la reunión ni siquiera es con el obispo, es con un secretario."
    mc "Und das Treffen findet nicht einmal mit dem Bischof statt, sondern mit einer Sekretärin."

# game/scripts/c23/c23.rpy:819
translate german c23s002_Lugagge_0cff2902:

    # mom "Pero la acompañarás, ¿verdad? Está muy nerviosa."
    mom "Aber du gehst doch mit ihr, oder? Sie ist sehr nervös."

# game/scripts/c23/c23.rpy:820
translate german c23s002_Lugagge_5f6d22fc:

    # mc "No creo que quiera que la acompañe a la reunión. La llevaré a las oficinas de la diócesis, pero no creo que entrar con ella sea lo mejor."
    mc "Ich glaube nicht, dass sie möchte, dass ich sie zu dem Treffen begleite. Ich werde sie zum Diözesanbüro bringen, aber ich denke nicht, dass es eine gute Idee ist, mit ihr hineinzugehen."

# game/scripts/c23/c23.rpy:821
translate german c23s002_Lugagge_d91007c6:

    # mc "De todas formas, le preguntaré, pero dudo que quiera que esté en esa reunión."
    mc "Ich werde ihn trotzdem fragen, aber ich bezweifle, dass er mich bei diesem Treffen dabei haben will."

# game/scripts/c23/c23.rpy:823
translate german c23s002_Lugagge_98e60a1c:

    # mom "Bueno, pues mete la camisa azul por si acaso la tienes que acompañar."
    mom "Packen Sie das blaue Hemd vorsichtshalber ein, falls Sie es dabei haben möchten."

# game/scripts/c23/c23.rpy:824
translate german c23s002_Lugagge_4d2532ae:

    # mom "Siempre tienes que llevar algo de ropa correcta por si surge un imprevisto."
    mom "Sie sollten stets angemessene Kleidung bei sich tragen, falls etwas Unerwartetes passiert."

# game/scripts/c23/c23.rpy:825
translate german c23s002_Lugagge_fa56d19b:

    # mc "La eché a lavar ayer o anteayer. No la he visto en el armario."
    mc "Ich habe es gestern oder vorgestern in die Waschmaschine getan. Ich habe es nicht im Schrank gesehen."

# game/scripts/c23/c23.rpy:827
translate german c23s002_Lugagge_8fff1679:

    # mom "Tienes razón, creo que la lavé ayer. Tengo que plancharla."
    mom "Du hast recht, ich glaube, ich habe es gestern gewaschen. Ich muss es bügeln."

# game/scripts/c23/c23.rpy:828
translate german c23s002_Lugagge_213e7078:

    # mc "No te molestes, [Mom], con una camiseta también voy bien. Además, se va a arrugar en la mochila."
    mc "Keine Sorge, [Mom], ein T-Shirt geht auch. Außerdem würde es in meinem Rucksack knittern."

# game/scripts/c23/c23.rpy:830
translate german c23s002_Lugagge_8d3d8ca3:

    # mom "No te preocupes. La meteré en una de las maletas de [emm]. Luego le tengo que ayudar a hacerlas."
    mom "Keine Sorge. Ich packe es in einen von [emm]s Koffern. Dann muss ich ihr beim Packen helfen."

# game/scripts/c23/c23.rpy:831
translate german c23s002_Lugagge_8c11638b:

    # mc "Espera. ¿Has dicho una de las maletas? ¿Cuántas lleva?"
    mc "Moment mal. Hast du gesagt, einer der Koffer? Wie viele hat sie denn?"

# game/scripts/c23/c23.rpy:833
translate german c23s002_Lugagge_275536a9:

    # mom "La he visto subir con dos maletas del sótano."
    mom "Ich sah sie mit zwei Koffern aus dem Keller kommen."

# game/scripts/c23/c23.rpy:834
translate german c23s002_Lugagge_2b7ff2c2:

    # mc "¿Para una noche?"
    mc "Für eine Nacht?"

# game/scripts/c23/c23.rpy:836
translate german c23s002_Lugagge_7c82fa6b:

    # mom "Es [emm]..."
    mom "Es ist [emm]..."

# game/scripts/c23/c23.rpy:840
translate german c23s002_Lugagge_dd0461ef_1:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c23/c23.rpy:841
translate german c23s002_Lugagge_fda8aa56:

    # emm "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    emm "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c23/c23.rpy:843
translate german c23s002_Lugagge_4d601f0e_1:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c23/c23.rpy:845
translate german c23s002_Lugagge_09daa09b:

    # emm "Mamá, ¿crees que esto será suficiente para mañana?"
    emm "Mama, meinst du, das reicht für morgen?"

# game/scripts/c23/c23.rpy:846
translate german c23s002_Lugagge_50a76aac:

    # mc "¿Dónde crees que vas con eso, [emm]?"
    mc "Was glaubst du, worauf du hinauswillst, [emm]?"

# game/scripts/c23/c23.rpy:848
translate german c23s002_Lugagge_bc6e01fa:

    # emm "Vamos al norte. Hará más frío que aquí, y ya sabes que yo tengo frío en seguida..."
    emm "Lass uns nach Norden fahren. Dort ist es kälter als hier, und du weißt ja, wie schnell ich friere..."

# game/scripts/c23/c23.rpy:849
translate german c23s002_Lugagge_9e86e008:

    # mc "Vamos 200 Km al norte. No nos vamos a Alaska..."
    mc "Wir fahren 200 km nach Norden. Wir fahren nicht nach Alaska..."

# game/scripts/c23/c23.rpy:851
translate german c23s002_Lugagge_b6d431b2:

    # mom "Te he dicho una chaqueta, [emm], no que te vistas de invierno."
    mom "Ich habe dir gesagt, du sollst dir eine Jacke besorgen, nicht dich winterlich kleiden."

# game/scripts/c23/c23.rpy:853
translate german c23s002_Lugagge_75c72859:

    # emm "Pero el Ferrarini será descapotable y hará frío..."
    emm "Aber der Ferrarini wird ein Cabriolet sein und es wird kalt sein..."

# game/scripts/c23/c23.rpy:854
translate german c23s002_Lugagge_de0cbafe:

    # mc "No, [emm], el coche no es descapotable. Además, ¿crees que vas a poder conducir con eso puesto?"
    mc "Nein, [emm], das Auto ist kein Cabrio. Glaubst du außerdem, du könntest damit fahren?"

# game/scripts/c23/c23.rpy:856
translate german c23s002_Lugagge_44c92de4:

    # emm "Tienes razón. Sería muy incómodo."
    emm "Du hast Recht. Das wäre sehr unangenehm."

# game/scripts/c23/c23.rpy:857
translate german c23s002_Lugagge_e9df9ef7:

    # emm "Mamá, ¿me ayudas a escoger una chaqueta adecuada?"
    emm "Mama, kannst du mir helfen, eine passende Jacke auszusuchen?"

# game/scripts/c23/c23.rpy:859
translate german c23s002_Lugagge_a67edac7:

    # mom "Sí, te acompaño. Después tengo que ir a planchar. Deja un hueco en una de tus maletas para una camisa de [mc]."
    mom "Ja, ich komme mit. Ich muss danach noch bügeln. Lass bitte in einem deiner Koffer Platz für ein [mc]-Hemd."

# game/scripts/c23/c23.rpy:864
translate german c23s002_Lugagge_1cdac493:

    # mom "Hasta luego, [mc]."
    mom "Bis später, [mc]."

# game/scripts/c23/c23.rpy:869
translate german c23s002_Lugagge_1f4e85f3:

    # emm "Te vemos luego. Voy a tener que añadir otra maleta por lo de tu camisa."
    emm "Bis später. Wegen deines Hemdes muss ich noch einen Koffer mitnehmen."

# game/scripts/c23/c23.rpy:871
translate german c23s002_Lugagge_41c98829:

    # mcp "(¿Otra maleta por una camisa? Creo que es una excusa para poder llevarse más ropa.)"
    mcp "(Noch ein Koffer für ein Hemd? Ich glaube, das ist nur eine Ausrede, um mehr Kleidung mitnehmen zu können.)"

# game/scripts/c23/c23.rpy:873
translate german c23s002_Lugagge_884ef907:

    # mcp "(No me extrañaría que se llevara un traje de buzo por si hay una inundación. Mujeres...)"
    mcp "(Es würde mich nicht wundern, wenn sie für den Fall einer Überschwemmung einen Neoprenanzug mitgebracht hätte. Frauen eben...)"

# game/scripts/c23/c23.rpy:883
translate german c23s002_NoPatty_21994c80:

    # "Cuando acabas de preparar la mochila, trabajas un rato en la contabilidad del dormitorio y después bajas a la cocina a comer algo."
    "Wenn du deinen Rucksack gepackt hast, arbeitest du eine Weile an der Buchhaltung des Wohnheims und gehst dann in die Küche, um etwas zu essen."

# game/scripts/c23/c23.rpy:885
translate german c23s002_NoPatty_1bf6c7ed:

    # "El trozo de pastel era demasiado pequeño."
    "Das Stück Kuchen war zu klein."

# game/scripts/c23/c23.rpy:887
translate german c23s002_NoPatty_3df9d16d:

    # "[nor] aparece al cabo de unos minutos."
    "[nor] erscheint nach einigen Minuten."

# game/scripts/c23/c23.rpy:888
translate german c23s002_NoPatty_77ad9ccc:

    # nor "Hola, [mc]. ¿No está [mar]?"
    nor "Hallo, [mc]. Ist [mar] nicht da?"

# game/scripts/c23/c23.rpy:895
translate german c23s002_NoPatty_b7d10e84:

    # mc "Hola, cielo."
    mc "Hallo Schatz."

# game/scripts/c23/c23.rpy:897
translate german c23s002_NoPatty_2f11503d:

    # mc "Hola, [Aunt!t][nor]."
    mc "Hallo, [Aunt!t][nor]."

# game/scripts/c23/c23.rpy:898
translate german c23s002_NoPatty_25f01a6b:

    # mc "Si no está en la habitación de [emm], está en el sótano, planchando. Se ha empeñado en que me lleve la camisa azul mañana a Monterey."
    mc "Wenn sie nicht in Zimmer [emm] ist, bügelt sie im Keller. Sie hat darauf bestanden, dass ich das blaue Hemd morgen mit nach Monterey nehme."

# game/scripts/c23/c23.rpy:899
translate german c23s002_NoPatty_8c75a300:

    # mc "Ni que me fuera una semana. Si por ella fuera, me tendría que llevar tres maletas para pasar una noche fuera."
    mc "Ich fahre ja nicht gleich eine Woche weg. Wenn es nach ihr ginge, müsste ich drei Koffer mitnehmen, nur um eine Nacht weg zu sein."

# game/scripts/c23/c23.rpy:901
translate german c23s002_NoPatty_f4b434c3:

    # nor "Es que esa camisa te queda muy bien. Y nunca lo entenderás."
    nor "Das Hemd steht dir ausgezeichnet. Und du wirst es nie verstehen."

# game/scripts/c23/c23.rpy:902
translate german c23s002_NoPatty_80f3e399:

    # nor "Las mujeres nos solemos llevar mucha ropa a cualquier sitio. *Risa* Casi puedo apostar a que [emm] va a llevar tres maletas."
    nor "Frauen nehmen ja bekanntlich immer Unmengen an Kleidung mit, egal wohin wir gehen. *lacht* Ich wette fast, [emm] wird drei Koffer mitnehmen."

# game/scripts/c23/c23.rpy:903
translate german c23s002_NoPatty_3d0d59aa:

    # mc "*Risa* ¿Sólo tres? Ha dicho que iba a añadir otra maleta porque tenía que meter mi camisa."
