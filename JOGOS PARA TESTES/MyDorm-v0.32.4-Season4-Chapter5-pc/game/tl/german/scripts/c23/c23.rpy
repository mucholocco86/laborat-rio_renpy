# game/scripts/c23/c23.rpy:3370
translate german c23s007_SleepingArrangements_c43baea5:

    # "Una vez movidas las maletas..."
    "Nachdem die Koffer weggebracht worden waren..."

# game/scripts/c23/c23.rpy:3371
translate german c23s007_SleepingArrangements_b7167afb:

    # emm "Descansa, que mañana quiero hacer turismo. Podemos dejar el Ferrarini aquí e ir con tu coche. O incluso devolverlo antes."
    emm "Ruh dich aus, ich möchte morgen ein paar Sehenswürdigkeiten besichtigen. Wir können den Ferrarini hier lassen und mit deinem Auto fahren. Oder ihn sogar früher zurückgeben."

# game/scripts/c23/c23.rpy:3372
translate german c23s007_SleepingArrangements_bae81fae:

