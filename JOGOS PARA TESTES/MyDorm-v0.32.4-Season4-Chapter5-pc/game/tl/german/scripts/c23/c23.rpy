translate german c23s003_Eil_39ee77a0:

    # eil "Si hubiera pensado que te pareces lo más mínimo a él, no hubiera aceptado tu invitación a comer."
    eil "Hätte ich gedacht, dass du ihm auch nur entfernt ähnlich siehst, hätte ich deine Einladung zum Mittagessen nicht angenommen."

# game/scripts/c23/c23.rpy:1079
translate german c23s003_Eil_59b1e58d:

    # eil "Ni te hubiera besado el domingo."
    eil "Ich hätte dich am Sonntag nicht einmal geküsst."

# game/scripts/c23/c23.rpy:1080
translate german c23s003_Eil_b50cc62e:

    # mc "Me tranquiliza escuchar eso. Por un momento había creído que [kia] pensaba que todos los hombres nos parecemos y la vamos a tratar como tu padre."
    mc "Das ist beruhigend. Einen Moment lang hatte ich gedacht, [kia] glaubte, alle Männer seien gleich und wir würden sie wie deinen Vater behandeln."

# game/scripts/c23/c23.rpy:1082
translate german c23s003_Eil_e2d56724:

    # eil "No le preocupa como sean el resto de los hombres. Sabe que tú eres tan diferente a mi padre como pueden serlo la noche y el día."
    eil "Es ist ihm egal, wie andere Männer sind. Er weiß, dass du so unterschiedlich von meinem Vater bist wie Tag und Nacht."

# game/scripts/c23/c23.rpy:1083
translate german c23s003_Eil_3ac99e66:

    # eil "Y, con la ilusión que habla desde vuestra comida, no creo que vaya a tener la intención de probar nada con ningún hombre que no seas tú."
    eil "Und angesichts der Begeisterung, die dein Essen mit sich bringt, glaube ich nicht, dass ich die Absicht haben werde, irgendetwas mit einem anderen Mann als dir auszuprobieren."

# game/scripts/c23/c23.rpy:1084
translate german c23s003_Eil_fbcdd72d:

    # mc "Yo también estoy ilusionado, [eil]. Tu madre me parece una mujer maravillosa."
    mc "Ich freue mich auch, [eil]. Ich finde, deine Mutter ist eine wundervolle Frau."

# game/scripts/c23/c23.rpy:1086
translate german c23s003_Eil_beb3e020:

    # eil "Ahora ya solo falta que os acostéis juntos. *Risa* ¿Ya has planeado cuándo?"
    eil "Jetzt müsst ihr nur noch miteinander schlafen. *lacht* Habt ihr schon einen Termin geplant?"

# game/scripts/c23/c23.rpy:1087
translate german c23s003_Eil_bd29e889:

    # mc "*Risa* Veo que no te lo ha explicado todo."
    mc "*lacht* Ich sehe, er hat dir nicht alles erklärt."

# game/scripts/c23/c23.rpy:1089
translate german c23s003_Eil_fdbb68b7:

    # eil "¿QUÉ? ¿Ya te has acostado con ella? ¿Cuándo? ¿Dónde? ¿Cuándo lo planeaste?"
    eil "WAS? Du hast schon mit ihr geschlafen? Wann? Wo? Wann habt ihr das geplant?"

# game/scripts/c23/c23.rpy:1090
translate german c23s003_Eil_8499ad18:

    # mc "*Risa* No voy a confirmar ni a desmentir nada. Sólo te digo que [kia] no te lo ha explicado todo."
    mc "*Lacht* Ich werde weder etwas bestätigen noch dementieren. Ich sage dir nur, dass [kia] dir nicht alles erklärt hat."

# game/scripts/c23/c23.rpy:1092
translate german c23s003_Eil_488be4ff:

    # eil "¡Joder, [mc]! *Risa* ¡Ahora no voy a poder pensar en otra cosa!"
    eil "Verdammt, [mc]! *lacht* Jetzt kann ich an nichts anderes mehr denken!"

# game/scripts/c23/c23.rpy:1095
translate german c23s003_Eil_cee85389:

    # eil "*Risa* Al menos ella está protegida contra tus encantos."
    eil "*Lacht* Wenigstens ist sie vor deinen Reizen geschützt."

# game/scripts/c23/c23.rpy:1096
translate german c23s003_Eil_604ec47f:

    # mc "¡Hey! ¡No tengo intención de salir con cada chica que viva en casa!"
    mc "Hey! Ich habe nicht vor, mit jedem Mädchen, das in diesem Haus wohnt, auszugehen!"

# game/scripts/c23/c23.rpy:1098
translate german c23s003_Eil_25c4b897:

    # eil "¡Joder, [mc]! *Risa* ¡Ahora no voy a poder pensar en otra cosa que en [kat], [kim] y tú en la misma cama!"
    eil "Verdammt, [mc]! *Lacht* Jetzt kann ich an nichts anderes mehr denken als an [kat], [kim] und dich im selben Bett!"

# game/scripts/c23/c23.rpy:1102
translate german c23s003_Eil_72773080:

    # "Pasáis un rato charlando y riéndoos de los viejos tiempos y de las nuevas situaciones."
    "Man verbringt einige Zeit damit, sich angeregt zu unterhalten und über alte Zeiten und neue Situationen zu lachen."

# game/scripts/c23/c23.rpy:1104
translate german c23s003_Eil_67e15c78:

    # mc "Bueno, yo puedo darte otras cosas en las que pensar. Ese uniforme me trae recuerdos..."
    mc "Nun, ich kann Ihnen noch andere Denkanstöße geben. Diese Uniform weckt Erinnerungen..."

# game/scripts/c23/c23.rpy:1106
translate german c23s003_Eil_16d8d713:

    # eil "¿Me vas a levantar la falda como hacías debajo de las gradas?"
    eil "Wirst du mir den Rock hochheben, so wie du es früher unter der Tribüne getan hast?"

# game/scripts/c23/c23.rpy:1107
translate german c23s003_Eil_7ab0bf57:

    # mc "Creo que ya somos mayorcitos para eso, [eil.nick]."
    mc "Ich denke, dafür sind wir alt genug, [eil.nick]."

# game/scripts/c23/c23.rpy:1108
translate german c23s003_Eil_0875fcb6:

    # mc "Ahora quiero el plato completo."
    mc "Jetzt möchte ich den ganzen Teller."

# game/scripts/c23/c23.rpy:1110
translate german c23s003_Eil_f77d35c4:

    # eil "El plato completo lo has tenido siempre. *Risa* No sé a lo que te refieres."
    eil "Du hattest schon immer alle Hände voll zu tun. *lacht* Ich weiß nicht, was du meinst."

# game/scripts/c23/c23.rpy:1111
translate german c23s003_Eil_b9751d8f:

    # mc "*Risa* El papel de animadora tonta no te pega, [eil]."
    mc "*Lacht* Die Rolle einer naiven Cheerleaderin passt nicht zu dir, [eil]."

# game/scripts/c23/c23.rpy:1113
translate german c23s003_Eil_4822e992:

    # eil "No sé... dijiste que era una animadora cliché."
    eil "Ich weiß nicht... du hast gesagt, sie sei eine klischeehafte Cheerleaderin."

# game/scripts/c23/c23.rpy:1114
translate german c23s003_Eil_886501e4:

    # mc "Pero no en ese sentido. Eras un poco abusona con el resto de las chicas, y un poco mandona conmigo, pero nunca has sido tonta."
    mc "Aber nicht so. Du warst zwar ein bisschen gemein zu den anderen Mädchen und auch mir gegenüber etwas herrisch, aber dumm warst du nie."

# game/scripts/c23/c23.rpy:1115
translate german c23s003_Eil_45083f10:

    # mc "Te importaban las apariencias, pero no igual que a otras de las chicas del equipo."
    mc "Äußeres war dir wichtig, aber nicht so wichtig wie einigen anderen Mädchen im Team."

# game/scripts/c23/c23.rpy:1117
translate german c23s003_Eil_9f521164:

    # eil "Si me hubieran importado las apariencias no hubiera salido contigo. *Risa*"
    eil "Wenn mir Äußerlichkeiten wichtig wären, wäre ich nicht mit dir ausgegangen. *lacht*"

# game/scripts/c23/c23.rpy:1118
translate german c23s003_Eil_3d892330:

    # mc "*Risa* Si hubieras sido la animadora cliché, hubiera sido yo quien no hubiera salido contigo."
    mc "*Lacht* Wenn du so eine typische Cheerleaderin gewesen wärst, wäre ich diejenige gewesen, die nicht mit dir ausgegangen wäre."

# game/scripts/c23/c23.rpy:1120
translate german c23s003_Eil_dd684338:

    # eil "..."
    eil "..."

# game/scripts/c23/c23.rpy:1121
translate german c23s003_Eil_f06e1c2c:

    # mc "*Risa* Vale, sí. Hubiera salido contigo si se hubiera dado la oportunidad."
    mc "*Lacht* Okay, ja. Ich wäre mit dir ausgegangen, wenn sich die Gelegenheit ergeben hätte."

# game/scripts/c23/c23.rpy:1122
translate german c23s003_Eil_29bc2134:

    # mc "Pero hubiera salido contigo a desgana. *Risa*"
    mc "Aber ich wäre nur widerwillig mit dir ausgegangen. *lacht*"

# game/scripts/c23/c23.rpy:1124
translate german c23s003_Eil_4892aa82:

    # eil "Seguramente hasta que vieras a estas dos..."
    eil "Vermutlich erst, wenn Sie diese beiden gesehen haben..."

# game/scripts/c23/c23.rpy:1126
translate german c23s003_Eil_5adf5ab7:

    # eil "*Risa* Y pusieras esa cara, como si los ojos se te fueran a salir de las órbitas."
    eil "*Lacht* Und du hast so ein Gesicht gemacht, als ob dir die Augen gleich aus den Höhlen springen würden."

# game/scripts/c23/c23.rpy:1127
translate german c23s003_Eil_7f96be62:

    # mc "*Risa* Creo que, en el momento en que las viera por primera vez, me daría lo mismo si eras superficial o una animadora cliché."
    mc "*Lacht* Ich glaube, in dem Moment, als ich dich zum ersten Mal sah, wäre es mir egal gewesen, ob du oberflächlich oder eine klischeehafte Cheerleaderin wärst."

# game/scripts/c23/c23.rpy:1129
translate german c23s003_Eil_17617a59:

    # eil "*Risa* ¿Sabes una cosa que me encanta y nunca te he dicho?"
    eil "*lacht* Weißt du, was ich liebe, dir aber noch nie erzählt habe?"

# game/scripts/c23/c23.rpy:1130
translate german c23s003_Eil_0f275edd:

    # mc "*Risa* No sé, ¿la pizza con piña?"
    mc "*Lacht* Keine Ahnung, Pizza mit Ananas?"

# game/scripts/c23/c23.rpy:1132
translate german c23s003_Eil_582e858e:

    # eil "*Risa* No, idiota."
    eil "*Lacht* Nein, Idiot."

# game/scripts/c23/c23.rpy:1133
translate german c23s003_Eil_a440f7a8:

    # eil "Me encanta que todavía las miras con la misma cara que las miraste la primera vez."
    eil "Ich finde es toll, dass du sie immer noch mit demselben Ausdruck anschaust wie beim ersten Mal."

# game/scripts/c23/c23.rpy:1134
translate german c23s003_Eil_9d3074f4:

    # mc "¿Qué cara puse?"
    mc "Welches Gesicht habe ich gemacht?"

# game/scripts/c23/c23.rpy:1136
translate german c23s003_Eil_2854282b:

    # eil "La misma que pones ahora. No sé, como preguntándote si son de verdad y si voy a dejarte tocarlas."
    eil "Denselben, den du jetzt trägst. Ich weiß nicht, ich frage dich quasi, ob sie echt sind und ob ich dich sie anfassen lasse."

# game/scripts/c23/c23.rpy:1137
translate german c23s003_Eil_0b49afb5:

    # eil "Como si todavía fuera la primera vez que las vieras."
    eil "Als ob du sie noch zum ersten Mal sehen würdest."

# game/scripts/c23/c23.rpy:1138
translate german c23s003_Eil_ab7de288:

    # mc "Es que siguen tan perfectas como la primera vez que las vi."
    mc "Sie sind immer noch so perfekt wie beim ersten Mal, als ich sie sah."

# game/scripts/c23/c23.rpy:1139
translate german c23s003_Eil_89579ae2:

    # mc "Pero no sabía que recordaras la cara que puse aquel día."
    mc "Aber ich wusste nicht, dass du dich an meinen Gesichtsausdruck von damals erinnerst."

# game/scripts/c23/c23.rpy:1141
translate german c23s003_Eil_dac7a9d1:

    # eil "Estaba tan nerviosa como tú. Eras el primer chico que las veía."
    eil "Ich war genauso nervös wie du. Du warst der erste Junge, der sie je gesehen hatte."

# game/scripts/c23/c23.rpy:1142
translate german c23s003_Eil_38407610:

    # eil "Siempre me han parecido pequeñas y no sabía si te iban a gustar."
    eil "Ich fand sie immer zu klein und war mir nicht sicher, ob sie dir gefallen würden."

# game/scripts/c23/c23.rpy:1143
translate german c23s003_Eil_0eaa0bd0:

    # mc "Tienen el tamaño perfecto, [eil.nick]. Y lo siguen teniendo aunque hayan crecido un poco. Siempre te lo he dicho."
    mc "Sie haben die perfekte Größe, [eil.nick]. Und das haben sie immer noch, obwohl sie etwas gewachsen sind. Das habe ich dir doch immer gesagt."

# game/scripts/c23/c23.rpy:1145
translate german c23s003_Eil_b28347cd:

    # eil "Ahora lo sé. *Risa* Lo supe desde que las viste por primera vez y empezaste a babear."
    eil "Jetzt weiß ich's. *lacht* Ich wusste es schon, als du sie das erste Mal gesehen und angefangen hast zu sabbern."

# game/scripts/c23/c23.rpy:1147
translate german c23s003_Eil_da1c5685:

    # eil "Pero aquel día estaba más nerviosa de lo que había estado nunca."
    eil "Doch an diesem Tag war sie nervöser als je zuvor."

# game/scripts/c23/c23.rpy:1148
translate german c23s003_Eil_7e866252:

    # eil "Estaba más nerviosa incluso de lo que estuve cuando, meses después, perdimos la virginidad juntos."
    eil "Ich war noch nervöser als Monate später, als wir gemeinsam unsere Jungfräulichkeit verloren."

# game/scripts/c23/c23.rpy:1149
translate german c23s003_Eil_7e75c465:

    # mc "Yo estaba histérico la primera vez que nos acostamos juntos."
    mc "Ich war völlig hysterisch, als wir das erste Mal miteinander schliefen."

# game/scripts/c23/c23.rpy:1151
translate german c23s003_Eil_8d8684d2:

    # eil "Yo también, pero estaba mucho más segura de nuestra relación. Era una evolución natural..."
    eil "Ich auch, aber ich fühlte mich in unserer Beziehung viel sicherer. Es war eine natürliche Entwicklung..."

# game/scripts/c23/c23.rpy:1152
translate german c23s003_Eil_2304f2c3:

    # mc "Ven aquí, cielo."
    mc "Komm her, meine Liebe."

# game/scripts/c23/c23.rpy:1154
translate german c23s003_Eil_69390b2b:

    # eil "Lo siento..."
    eil "Es tut mir Leid..."

# game/scripts/c23/c23.rpy:1155
translate german c23s003_Eil_45169581:

    # mc "¿El qué? ¿Qué ha pasado?"
    mc "Was? Was ist passiert?"

# game/scripts/c23/c23.rpy:1157
translate german c23s003_Eil_dd0fb9dc:

    # eil "A veces me pongo demasiado sentimental recordando aquellos tiempos. Cuando todo empezaba y teníamos todo por descubrir todavía."
    eil "Manchmal werde ich zu sentimental, wenn ich an diese Zeiten zurückdenke. Als alles noch in den Kinderschuhen steckte und wir noch so viel zu entdecken hatten."

# game/scripts/c23/c23.rpy:1158
translate german c23s003_Eil_935fbc10:

    # eil "Cuando te tenía para mí todo el día..."
    eil "Als ich dich den ganzen Tag für mich allein hatte..."

# game/scripts/c23/c23.rpy:1160
translate german c23s003_Eil_2993678a:

    # mc "[eil.nick], mírame."
    mc "[eil.nick], schau mich an."

# game/scripts/c23/c23.rpy:1162
translate german c23s003_Eil_681ada2a:

    # eil "Lo sé, soy una tonta..."
    eil "Ich weiß, ich bin ein Narr..."

# game/scripts/c23/c23.rpy:1163
translate german c23s003_Eil_90c944e2:

    # mc "¿Te molesta que salga con alguien más aparte de ti?"
    mc "Stört es dich, dass ich mit jemand anderem als dir zusammen bin?"

# game/scripts/c23/c23.rpy:1165
translate german c23s003_Eil_5a8e00e1:

    # eil "¿Qué? ¡No! ¡No lo decía por eso!"
    eil "Was? Nein! So habe ich das nicht gemeint!"

# game/scripts/c23/c23.rpy:1166
translate german c23s003_Eil_b3212f38:

    # mc "Entonces me he perdido algo. No te entiendo."
    mc "Dann habe ich etwas verpasst. Ich verstehe dich nicht."

# game/scripts/c23/c23.rpy:1168
translate german c23s003_Eil_0d8f988a:

    # eil "La idea de que tuvieras un harén fue mía. Tú no lo hubieras hecho nunca."
    eil "Die Idee, dass du einen Harem hast, stammte von mir. Du hättest das nie getan."

# game/scripts/c23/c23.rpy:1169
translate german c23s003_Eil_45f9819a:

    # eil "Es imposible que me moleste que me hayas hecho caso, idiota."
    eil "Es ist mir unmöglich, verärgert darüber zu sein, dass du mir zugehört hast, du Idiot."

# game/scripts/c23/c23.rpy:1170
translate german c23s003_Eil_e10ce01f:

    # mc "Entonces, ¿a qué te referías?"
    mc "Was meintest du damit?"

# game/scripts/c23/c23.rpy:1172
translate german c23s003_Eil_389b8025:

    # eil "Entonces pasábamos todo el día juntos. En el instituto y al acabar las clases. Íbamos a la biblioteca juntos..."
    eil "Wir haben früher den ganzen Tag zusammen verbracht. In der Schule und nach dem Unterricht. Wir sind zusammen in die Bibliothek gegangen..."

# game/scripts/c23/c23.rpy:1173
translate german c23s003_Eil_dc7b1653:

    # mc "Aunque a veces se apuntara Jam. *Risa*"
    mc "Obwohl Jam sich manchmal angemeldet hat. *Gelächter*"

# game/scripts/c23/c23.rpy:1175
translate german c23s003_Eil_0680b7c6:

    # eil "*Risa* Sí, le costó entender que ya no le pertenecías sólo a él y que tenía que compartirte conmigo."
    eil "*Gelächter* Ja, es dauerte eine Weile, bis er begriff, dass du nicht mehr nur ihm gehörst und dass er dich mit mir teilen muss."

# game/scripts/c23/c23.rpy:1176
translate german c23s003_Eil_bdd97f32:

    # mc "*Risa* Creo que eso ha sonado mejor en tu cabeza..."
    mc "*lacht* Ich glaube, das klang in deinem Kopf besser..."

# game/scripts/c23/c23.rpy:1178
translate german c23s003_Eil_7e68bd73:

    # eil "Es posible, pero a lo que me refiero es que, por entonces, nos veíamos todos los días, a todas horas."
    eil "Das ist möglich, aber ich meine damit, dass wir uns damals jeden Tag, ständig gesehen haben."

# game/scripts/c23/c23.rpy:1179
translate german c23s003_Eil_aa31270f:

    # eil "Ahora hay días en los que apenas te veo si no es en la comida o en la cena. Echo de menos cosas de aquellos días."
    eil "Es gibt Tage, an denen ich dich kaum sehe, außer zum Mittag- oder Abendessen. Ich vermisse die Zeit von damals."

# game/scripts/c23/c23.rpy:1180
translate german c23s003_Eil_b246d242:

    # mc "Lo entiendo, a mí me pasa lo mismo. Pero también hay cosas que no echo de menos."
    mc "Ich verstehe das, mir geht es genauso. Aber es gibt auch Dinge, die ich nicht vermisse."

# game/scripts/c23/c23.rpy:1182
translate german c23s003_Eil_870df98e:

    # eil "¡Por supuesto! *Risa* No echo de menos mi acné ni tu barriga."
    eil "Na klar! *lacht* Ich vermisse weder meine Akne noch deinen Bauch."

# game/scripts/c23/c23.rpy:1183
translate german c23s003_Eil_6b86a11e:

    # eil "Ni los exámenes. Ni siquiera echo de menos al equipo de animadoras."
    eil "Nicht die Prüfungen. Ich vermisse nicht einmal die Cheerleader-Gruppe."

# game/scripts/c23/c23.rpy:1185
translate german c23s003_Eil_08fdf29e:

    # eil "Pero, sobre todo, no echo de menos tener que ver a mi padre al llegar a casa."
    eil "Aber vor allem vermisse ich es nicht, meinen Vater zu sehen, wenn ich nach Hause komme."

# game/scripts/c23/c23.rpy:1186
translate german c23s003_Eil_8a34d84b:

    # eil "No echo de menos vivir en un ambiente tóxico."
    eil "Ich vermisse es nicht, in einem toxischen Umfeld zu leben."

# game/scripts/c23/c23.rpy:1188
translate german c23s003_Eil_22d1dce2:

    # eil "Sabía que vivir con vosotros iba a ser increíble. Os había visto como la familia que hubiera querido tener."
    eil "Ich wusste, dass das Zusammenleben mit dir wundervoll werden würde. Ich sah dich als die Familie, die ich mir immer gewünscht hätte."

# game/scripts/c23/c23.rpy:1189
translate german c23s003_Eil_20ea217e:

    # eil "Estaba equivocada."
    eil "Ich habe mich geirrt."

# game/scripts/c23/c23.rpy:1190
translate german c23s003_Eil_df124971:

    # mc "¿Tan malos somos?"
    mc "Sind wir wirklich so schlecht?"

# game/scripts/c23/c23.rpy:1192
translate german c23s003_Eil_980d3fdf:

    # eil "Lo que se ve desde fuera es increíble. Vivirlo desde dentro es indescriptible."
    eil "Was man von außen sieht, ist unglaublich. Es von innen zu erleben, ist unbeschreiblich."

# game/scripts/c23/c23.rpy:1193
translate german c23s003_Eil_ee0ad3f2:

    # eil "Y las cosas han cambiado mucho desde que tú y yo íbamos al instituto. Ahora son incluso mejores."
    eil "Und seit unserer gemeinsamen Schulzeit hat sich vieles verändert. Jetzt ist alles noch besser."

# game/scripts/c23/c23.rpy:1194
translate german c23s003_Eil_1a784cb7:

    # mc "Es lo que tiene tener un padre de mierda y que haya desaparecido."
    mc "So etwas passiert, wenn man einen beschissenen Vater hat, der verschwunden ist."

# game/scripts/c23/c23.rpy:1195
translate german c23s003_Eil_53f781a9:

    # mc "Nunca creí que mi padre fuera tan malo como el tuyo, pero su marcha ha hecho que todo el mundo se sienta liberado hasta cierto punto."
    mc "Ich habe nie gedacht, dass mein Vater so schlimm war wie deiner, aber sein Tod hat bei allen ein gewisses Maß an Befreiung ausgelöst."

# game/scripts/c23/c23.rpy:1197
translate german c23s003_Eil_8601f987:

    # eil "Bueno, los dos nos hemos librado de nuestra mierda de padres."
    eil "Nun ja, wir haben unsere beschissenen Eltern beide losgeworden."

# game/scripts/c23/c23.rpy:1199
translate german c23s003_Eil_49cfce84:

    # eil "Y ahora vamos a ser padres nosotros..."
    eil "Und jetzt werden wir Eltern..."

# game/scripts/c23/c23.rpy:1200
translate german c23s003_Eil_4cd16acc:

    # mc "Espero ser mejor que ellos."
    mc "Ich hoffe, besser zu sein als sie."

# game/scripts/c23/c23.rpy:1201
translate german c23s003_Eil_925d8a02:

    # eil "Lo serás."
    eil "Du wirst sein."

# game/scripts/c23/c23.rpy:1203
