translate german c23s003_Eil_0d4f16ff:

    # mc "¿Qué pasa? ¿He dicho algo malo?"
    mc "Was ist los? Habe ich etwas Falsches gesagt?"

# game/scripts/c23/c23.rpy:1446
translate german c23s003_Eil_64b899f4:

    # eil "No. Es por lo que he dicho yo antes sobre que eres el mejor amante que nadie podría imaginar..."
    eil "Nein. Es liegt an dem, was ich vorhin gesagt habe: dass du der beste Liebhaber bist, den man sich vorstellen kann..."

# game/scripts/c23/c23.rpy:1447
translate german c23s003_Eil_b1f95808:

    # mc "¿Qué pasa con eso?"
    mc "Und was ist damit?"

# game/scripts/c23/c23.rpy:1449
translate german c23s003_Eil_fe57f36a:

    # eil "Sabes que soy una bocazas y sé que nunca me lo vas a preguntar por no ponerme en una situación incómoda..."
    eil "Du weißt, dass ich eine Plaudertasche bin, und ich weiß, dass du mich nie fragen wirst, weil du mich nicht in eine unangenehme Situation bringen willst..."

# game/scripts/c23/c23.rpy:1450
translate german c23s003_Eil_26dc87e4:

    # mc "¿Preguntarte qué? No te entiendo."
    mc "Was soll ich dich fragen? Ich verstehe das nicht."

# game/scripts/c23/c23.rpy:1452
translate german c23s003_Eil_af98db33:

    # eil "El día que volviste... bueno, el primer día que nos vimos en el café... te dije que..."
    eil "An dem Tag, als du zurückkamst... nun ja, an dem Tag, als wir uns das erste Mal im Café sahen... das habe ich dir doch gesagt..."

# game/scripts/c23/c23.rpy:1453
translate german c23s003_Eil_b19ac7d6:

    # mc "Que habías tenido algunas citas una vez rompimos, lo sé. Y sabes que no me importa. Yo también tuve algunas citas."
    mc "Ich weiß, dass du nach unserer Trennung ein paar Dates hattest. Und weißt du was? Das ist mir egal. Ich hatte auch ein paar Dates."

# game/scripts/c23/c23.rpy:1455
translate german c23s003_Eil_eca9fa9b:

    # eil "Lo que quiero decir es que no tengo con quién compararte como amante. Ninguna de esas citas pasó de una cena o de ir al cine."
    eil "Ich meine damit, dass ich niemanden habe, mit dem ich dich als Partner vergleichen könnte. Keines unserer Dates ging über ein Abendessen oder einen Kinobesuch hinaus."

# game/scripts/c23/c23.rpy:1456
translate german c23s003_Eil_1a554488:

    # eil "No me acosté con ninguno de esos chicos."
    eil "Ich habe mit keinem dieser Typen geschlafen."

# game/scripts/c23/c23.rpy:1458
translate german c23s003_Eil_c8d25e30:

    # eil "Ninguno de aquellos chicos eras tú."
    eil "Keiner dieser Jungen warst du."

# game/scripts/c23/c23.rpy:1459
translate german c23s003_Eil_7b06167a:

    # mc "Me lo imagino. Si hubiera yo hubiera sido uno de ellos, lo recordaría."
    mc "Das kann ich mir vorstellen. Wenn ich einer von ihnen gewesen wäre, würde ich mich daran erinnern."

# game/scripts/c23/c23.rpy:1461
translate german c23s003_Eil_7c792f56:

    # eil "¡Idiota! ¡Estoy hablando en serio!"
    eil "Dummkopf! Ich meine es ernst!"

# game/scripts/c23/c23.rpy:1462
translate german c23s003_Eil_e108b29c:

    # mc "Y yo también. ¿Crees que me importaría si te hubieras acostado con alguno de ellos?"
    mc "Ich auch. Glaubst du, es würde mich kümmern, wenn du mit einem von ihnen geschlafen hättest?"

# game/scripts/c23/c23.rpy:1463
translate german c23s003_Eil_ea8e1c3f:

    # mc "¿Te importa a ti que saliera y me acostara con [sai] mientras tú y yo no estábamos juntos?"
    mc "Ist es dir wichtig, dass ich mit [sai] geschlafen habe, während wir nicht zusammen waren?"

# game/scripts/c23/c23.rpy:1465
translate german c23s003_Eil_bed78a97:

    # eil "No. Y no. Pero con las mujeres es diferente..."
    eil "Nein. Und nochmal nein. Aber bei Frauen ist es anders..."

# game/scripts/c23/c23.rpy:1466
translate german c23s003_Eil_d5fb6099:

    # eil "Si un hombre se acuesta con diez mujeres diferentes es un macho."
    eil "Wenn ein Mann mit zehn verschiedenen Frauen schläft, ist er ein Hengst."

# game/scripts/c23/c23.rpy:1467
translate german c23s003_Eil_69d7a2f3:

    # eil "Si una mujer se acuesta con tres hombres, es una puta para muchos hombres."
    eil "Wenn eine Frau mit drei Männern schläft, ist sie eine Hure für viele Männer."

# game/scripts/c23/c23.rpy:1468
translate german c23s003_Eil_e8be8f2f:

    # mc "Son esos hombres los que tienen un problema, no la mujer. Sabes que yo no pienso así."
    mc "Es sind die Männer, die ein Problem haben, nicht die Frau. Du weißt, dass ich das nicht so sehe."

# game/scripts/c23/c23.rpy:1469
translate german c23s003_Eil_c9d46b3a:

    # mc "Además, no lo hiciste, con lo que no hay más de que hablar."
    mc "Außerdem hast du es nicht getan, also gibt es nichts mehr zu besprechen."

# game/scripts/c23/c23.rpy:1471
translate german c23s003_Eil_36321820:

    # eil "Son por estas cosas por las que te quiero. Lo sabes, ¿verdad?"
    eil "Aus diesen Gründen liebe ich dich. Das weißt du doch, oder?"

# game/scripts/c23/c23.rpy:1472
translate german c23s003_Eil_656b4a49:

    # mc "Yo creía que sólo me querías porque soy el mejor amante que nadie pueda imaginar. *Risa*"
    mc "Ich dachte, du liebst mich nur, weil ich der beste Liebhaber bin, den man sich vorstellen kann. *lacht*"

# game/scripts/c23/c23.rpy:1474
translate german c23s003_Eil_f6938275:

    # eil "A veces eres idiota. Estoy hablando en serio, [mc]."
    eil "Manchmal bist du ein Idiot. Ich meine es ernst, [mc]."

# game/scripts/c23/c23.rpy:1475
translate german c23s003_Eil_daa9aca1:

    # eil "Si fueras diferente no me atrevería a hablarte de todo."
    eil "Wenn du anders wärst, würde ich mich nicht trauen, mit dir über alles zu reden."

# game/scripts/c23/c23.rpy:1476
translate german c23s003_Eil_b8dd6aac:

    # mc "Lo sé. Yo también te quiero, [eil.nick]. Eres una mujer maravillosa."
    mc "Ich weiß. Ich liebe dich auch, [eil.nick]. Du bist eine wundervolle Frau."

# game/scripts/c23/c23.rpy:1478
translate german c23s003_Eil_efa06021:

    # eil "Pues ahora esta mujer maravillosa se va a tener que ir. Me quiero dar una ducha rápida antes de ir a trabajar."
    eil "Nun muss diese wundervolle Frau leider gehen. Ich möchte noch schnell duschen, bevor ich zur Arbeit gehe."

# game/scripts/c23/c23.rpy:1479
translate german c23s003_Eil_74edfffa:

    # mc "Puedes coger mi albornoz si quieres y ducharte aquí."
    mc "Sie können gerne meinen Bademantel nehmen und hier duschen."

# game/scripts/c23/c23.rpy:1481
translate german c23s003_Eil_ed09d202:

    # eil "No hace falta. Me vuelvo a poner el uniforme y voy a casa. Tengo tiempo."
    eil "Das ist nicht nötig. Ich ziehe meine Uniform wieder an und gehe nach Hause. Ich habe Zeit."

# game/scripts/c23/c23.rpy:1482
translate german c23s003_Eil_8a4b213f:

    # mc "Como desees."
    mc "Wie Sie möchten."

# game/scripts/c23/c23.rpy:1484
translate german c23s003_Eil_a882f7fe:

    # "Una vez los dos os habéis vestido..."
    "Sobald ihr beide angezogen seid..."

# game/scripts/c23/c23.rpy:1485
translate german c23s003_Eil_7b478453:

    # eil "Me voy a ir ya. Gracias por ser como eres."
    eil "Ich werde jetzt gehen. Danke, dass es dich gibt."

# game/scripts/c23/c23.rpy:1486
translate german c23s003_Eil_2a5242a9:

    # mc "Gracias a ti por hacerme como soy."
    mc "Danke, dass du mich zu dem gemacht hast, der ich bin."

# game/scripts/c23/c23.rpy:1488
translate german c23s003_Eil_4092f2d3:

    # eil "¡Oh! ¡Eso es muy bonito! No me lo habías dicho nunca."
    eil "Oh! Das ist sehr nett! Das hast du mir vorher noch nie erzählt."

# game/scripts/c23/c23.rpy:1490
translate german c23s003_Eil_460ad180:

    # mc "Pero te lo he demostrado muchas veces."
    mc "Aber ich habe es dir schon viele Male bewiesen."

# game/scripts/c23/c23.rpy:1498
translate german c23s004_Kia_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c23/c23.rpy:1499
translate german c23s004_Kia_999e0f29:

    # kia "*A través de la puerta* [mc], ¿estás ahí? ¿Puedo pasar?"
    kia "*Durch die Tür* [mc], bist du da? Darf ich hereinkommen?"

# game/scripts/c23/c23.rpy:1500
translate german c23s004_Kia_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c23/c23.rpy:1503
translate german c23s004_Kia_dd2620e4:

    # kia "¡Oh! No sabía que estabas aquí, [eil.nick]. Precisamente venía a preguntarle a [mc] si te había visto."
    kia "Oh! Ich wusste gar nicht, dass du hier bist, [eil.nick]. Ich wollte gerade [mc] fragen, ob sie dich gesehen hat."

# game/scripts/c23/c23.rpy:1505
translate german c23s004_Kia_f92d1814:

    # eil "Llevo un rato aquí, hemos estado... charlando."
    eil "Ich bin schon eine Weile hier, wir haben uns unterhalten."

# game/scripts/c23/c23.rpy:1506
translate german c23s004_Kia_fd36aada:

    # mc "¿No estabas trabajando?"
    mc "Hast du nicht gearbeitet?"

# game/scripts/c23/c23.rpy:1508
translate german c23s004_Kia_59b23038:

    # kia "Hoy empiezo a mediodía. Por eso estaba buscando a [eil]."
    kia "Ich fange heute um 12 Uhr an. Deshalb habe ich nach [eil] gesucht."

# game/scripts/c23/c23.rpy:1509
translate german c23s004_Kia_8fe2bb9b:

    # kia "Me ha llamado [oma]. Va a venir a recogerme para llevarme al trabajo, por si querías venir tú también y te dejamos en el café."
    kia "[oma] hat mich angerufen. Er holt mich ab, um mich zur Arbeit zu fahren. Falls du auch mitkommen möchtest, könnten wir dich am Café absetzen."

# game/scripts/c23/c23.rpy:1511
translate german c23s004_Kia_62fd67d7:

    # eil "¡Oh, eso sería fantástico! ¡Voy a cambiarme!"
    eil "Oh, das wäre fantastisch! Ich werde mich umziehen!"

# game/scripts/c23/c23.rpy:1514
translate german c23s004_Kia_84ff7fc5:

    # eil "Por cierto, Mamá, sabes que puedes besar a [mc] aunque yo esté delante, ¿verdad?"
    eil "Übrigens, Mama, du weißt, dass du mich auch küssen kannst, wenn ich daneben stehe, oder?"

# game/scripts/c23/c23.rpy:1515
translate german c23s004_Kia_945c30b7:

    # mc "[eil], no tienes que presionarla."
    mc "[eil], Sie müssen es nicht drücken."

# game/scripts/c23/c23.rpy:1517
translate german c23s004_Kia_6b45fe62:

    # kia "*Risa* No me siento presionada, pero prefiero hacerlo cuando te hayas ido."
    kia "*Lacht* Ich fühle mich nicht unter Druck gesetzt, aber ich würde es lieber tun, wenn du weg bist."

# game/scripts/c23/c23.rpy:1519
translate german c23s004_Kia_c2a7821f:

    # eil "Pues me voy y os dejo que os beséis con tranquilidad."
    eil "Nun gut, ich lasse euch zwei jetzt allein, damit ihr euch in Ruhe küssen könnt."

# game/scripts/c23/c23.rpy:1522
translate german c23s004_Kia_59fe7813:

    # kia "Esta chica..."
    kia "Dieses Mädchen..."

# game/scripts/c23/c23.rpy:1523
translate german c23s004_Kia_9fcd8d5a:

    # mc "Creo que tenías un beso para mí..."
    mc "Ich glaube, du hattest einen Kuss für mich..."

# game/scripts/c23/c23.rpy:1525
translate german c23s004_Kia_d243bc2f:

    # "Sin decir una palabra, sus dulces labios buscan los tuyos."
    "Ohne ein Wort zu sagen, suchen ihre süßen Lippen deine."

# game/scripts/c23/c23.rpy:1526
translate german c23s004_Kia_c1e0c57d:

    # "Hoy no saben a aguacate, pero no por ello son menos deliciosos."
    "Sie schmecken heute nicht mehr nach Avocado, aber das macht sie nicht weniger lecker."

# game/scripts/c23/c23.rpy:1527
translate german c23s004_Kia_5c482df3:

    # "Como siempre, os separáis para recuperar el aliento. Demasiado pronto."
    "Wie immer trennt ihr euch, um kurz durchzuatmen. Zu früh."

# game/scripts/c23/c23.rpy:1530
translate german c23s004_Kia_e1381dbf:

    # kia "*Respiración entrecortada* ¡Phew! Y por esto prefiero besarte en privado. *Risa*"
    kia "*Keucht* Puh! Und deshalb küsse ich dich lieber unter vier Augen. *Lacht*"

# game/scripts/c23/c23.rpy:1531
translate german c23s004_Kia_b9a14b7b:

    # mc "Llamaremos a estos besos Darth Bader. *Risa* Cada vez que nos separamos respiramos como él."
    mc "Wir nennen diese Küsse Darth Babble. *lacht* Jedes Mal, wenn wir uns trennen, atmen wir wie er."

# game/scripts/c23/c23.rpy:1533
translate german c23s004_Kia_9b46c866:

    # kia "*Risa* A veces me extraña que algo tan de mi época lo hayáis adoptado los jóvenes."
    kia "*lacht* Manchmal überrascht es mich, dass etwas so aus meiner Zeit stammt, von jungen Leuten übernommen wurde."

# game/scripts/c23/c23.rpy:1534
translate german c23s004_Kia_248258de:

    # mc "*Risa* Con la cantidad de spin offs que han hecho, creo que es de todas las épocas."
    mc "*Lacht* Bei der Anzahl der Spin-offs, die sie gemacht haben, denke ich, dass sie aus allen Epochen stammen."

# game/scripts/c23/c23.rpy:1536
translate german c23s004_Kia_c37a601b:

    # kia "*Risa* Tienes razón, han encontrado la gallina de los huevos de oro y no pararán hasta que la maten."
    kia "*Gelächter* Stimmt, sie haben die Gans gefunden, die goldene Eier legt, und sie werden nicht aufhören, bis sie sie getötet haben."

# game/scripts/c23/c23.rpy:1537
translate german c23s004_Kia_1d1af333:

    # mc "Cambiando de tema, ¿hoy no hay vestido morado?"
    mc "Um das Thema zu wechseln: Gibt es heute kein lila Kleid?"

# game/scripts/c23/c23.rpy:1539
translate german c23s004_Kia_60fbe70c:

    # kia "Hoy no he quedado para comer con ningún chico guapo, con lo que no hay nadie a quien impresionar."
    kia "Ich treffe heute keinen netten Kerl zum Mittagessen, also gibt es niemanden, den ich beeindrucken müsste."

# game/scripts/c23/c23.rpy:1540
translate german c23s004_Kia_c5e92548:

    # mc "Tú impresionarías a ese chico afortunado llevaras lo que llevaras, o aunque no llevaras nada..."
    mc "Du würdest diesen Glückspilz beeindrucken, egal was du tragen würdest, oder sogar, wenn du gar nichts tragen würdest..."

# game/scripts/c23/c23.rpy:1541
translate german c23s004_Kia_d5096617:

    # mc "Eso ha sonado mejor en mi cabeza..."
    mc "Das klang in meinem Kopf besser..."

# game/scripts/c23/c23.rpy:1543
translate german c23s004_Kia_f6aedbdd:

    # kia "Bueno, espero, si no impresionarte, al menos no decepcionarte cuando no lleve nada."
    kia "Nun, ich hoffe, wenn ich dich schon nicht beeindrucken kann, dann zumindest nicht zu enttäuschen, wenn ich nichts trage."

# game/scripts/c23/c23.rpy:1544
translate german c23s004_Kia_2321c125:

    # mc "No me podrías decepcionar nunca, [kia]. Estoy deseando poder demostrártelo."
    mc "Du könntest mich niemals enttäuschen, [kia]. Ich kann es kaum erwarten, es dir zu beweisen."

# game/scripts/c23/c23.rpy:1546
translate german c23s004_Kia_d6ca2621:

    # kia "Si no fuera porque mañana tienes que levantarte temprano... Tenemos una cena pendiente."
    kia "Wenn du morgen nicht so früh aufstehen müsstest... Wir haben ein Abendessen verabredet."

# game/scripts/c23/c23.rpy:1547
translate german c23s004_Kia_a377bd3d:

    # kia "¿Cuándo vuelves? ¿El viernes?"
    kia "Wann kommst du zurück? Am Freitag?"

# game/scripts/c23/c23.rpy:1548
translate german c23s004_Kia_1da55bc6:

    # mc "Sí, el viernes por la tarde espero estar de vuelta."
    mc "Ja, ich gehe davon aus, am Freitagnachmittag wieder da zu sein."

# game/scripts/c23/c23.rpy:1550
translate german c23s004_Kia_94beec8a:

    # kia "¿Te apetece que vayamos a cenar? Si no estás muy cansado cuando vuelvas, claro."
    kia "Hättest du Lust, mit mir essen zu gehen? Natürlich nur, wenn du nicht zu müde bist, wenn du zurückkommst."

# game/scripts/c23/c23.rpy:1551
translate german c23s004_Kia_8d395c57:

    # mc "Apúntalo en la agenda. *Risa* Son poco más de dos horas conduciendo, no voy a estar cansado."
    mc "Trage es in deinen Kalender ein. *Lacht* Es sind nur etwas über zwei Stunden Fahrt, ich werde nicht müde sein."

# game/scripts/c23/c23.rpy:1553
translate german c23s004_Kia_acfffe06:

    # kia "Entonces el viernes. Me apetece mucho tener nuestra tercera cita."
    kia "Also, am Freitag. Ich freue mich schon sehr auf unser drittes Date."

# game/scripts/c23/c23.rpy:1554
translate german c23s004_Kia_5daa83ad:

    # mc "A mí también. Me encanta pasar tiempo contigo."
    mc "Ich auch. Ich verbringe sehr gerne Zeit mit dir."

# game/scripts/c23/c23.rpy:1556
translate german c23s004_Kia_6dc9d2f6:

    # kia "Eres tan dulce... Pero debería bajar antes de que llegue [oma]."
    kia "Du bist so lieb... Aber ich sollte nach unten gehen, bevor [oma] ankommt."

# game/scripts/c23/c23.rpy:1560
translate german c23s004_Kia_dd9d5367:

    # kia "Debería bajar por si [oma] llega pronto."
    kia "Ich sollte runtergehen, falls [oma] bald eintrifft."

# game/scripts/c23/c23.rpy:1561
translate german c23s004_Kia_615ebbcf:

    # mc "Vamos. Te acompaño. No he visto a [oma] desde la fiesta de la piscina."
    mc "Komm schon. Ich komme mit. Ich habe [oma] seit der Poolparty nicht mehr gesehen."

# game/scripts/c23/c23.rpy:1563
translate german c23s004_Kia_590abfbf:

    # mc "Por cierto, sólo te había visto con las gafas en el restaurante."
    mc "Übrigens habe ich Sie nur im Restaurant mit der Brille gesehen."

# game/scripts/c23/c23.rpy:1565
translate german c23s004_Kia_bcd2c2af:

    # mc "Por cierto, hacía mucho tiempo que no te veía con gafas."
    mc "Übrigens, es ist schon lange her, dass ich dich mit Brille gesehen habe."

# game/scripts/c23/c23.rpy:1567
translate german c23s004_Kia_0f258b53:

    # kia "Me las pongo para leer y trabajar. Estas son las de reserva y no tienen funda, con lo que no las quiero llevar sueltas en el bolso para evitar rayarlas."
    kia "Ich trage sie zum Lesen und Arbeiten. Das sind meine Ersatzbrillen, und da sie keine Hüllen haben, möchte ich sie nicht lose in meiner Tasche transportieren, um Kratzer zu vermeiden."

# game/scripts/c23/c23.rpy:1568
translate german c23s004_Kia_fe9e1f12:

    # kia "No sé dónde he dejado las otras gafas. A lo mejor las dejé en la biblioteca."
    kia "Ich weiß nicht, wo ich meine andere Brille gelassen habe. Vielleicht habe ich sie in der Bibliothek vergessen."

# game/scripts/c23/c23.rpy:1569
translate german c23s004_Kia_7992e3ae:

    # mc "Si quieres le puedo pedir una funda a [mar] o a [kim]. Seguro que tienen de sobras."
    mc "Wenn Sie möchten, kann ich nach [mar] oder [kim] für ein Gehäuse fragen. Ich bin sicher, dass sie genügend haben."

# game/scripts/c23/c23.rpy:1571
translate german c23s004_Kia_7557bf5a:

    # kia "No hace falta, son progresivas, puedo ver bien con ellas en cualquier circunstancia. Ya encontraré la funda."
    kia "Das ist nicht nötig, es sind Gleitsichtgläser, damit sehe ich in jeder Situation gut. Ich werde ein Etui besorgen."

# game/scripts/c23/c23.rpy:1572
translate german c23s004_Kia_e67890ae:

    # mc "Como quieras. Vamos entonces."
    mc "Ganz wie du willst. Dann los."

# game/scripts/c23/c23.rpy:1575
translate german c23s004_Kia_8ef4ccaf:

    # mc "De todas formas, estás guapísima con ellas."
    mc "Jedenfalls siehst du darin umwerfend aus."

# game/scripts/c23/c23.rpy:1577
translate german c23s004_Kia_5a3d2aba:

    # kia "Vamos antes de que te tenga que besar otra vez. *Risa*"
    kia "Lass uns gehen, bevor ich dich wieder küssen muss. *lacht*"

# game/scripts/c23/c23.rpy:1582
translate german c23s004_EilKiss_d5eece30:

    # eil "Hasta luego, cielo."
    eil "Bis später, Liebling."

# game/scripts/c23/c23.rpy:1585
translate german c23s004_EilKiss_6e734612:

    # "*Blam*"
    "*Bumm*"

# game/scripts/c23/c23.rpy:1586
translate german c23s004_EilKiss_c8213c6a:

    # eil "*A través de la puerta* Date prisa, Mamá. En menos de diez minutos estaré lista."
    eil "*Durch die Tür* Beeil dich, Mama. Ich bin in weniger als zehn Minuten fertig."

# game/scripts/c23/c23.rpy:1600
translate german c23s004_Oma_79acbd77:

    # "Cuando llegáis abajo, [oma] ya está esperando a [kia]."
    "Wenn du ganz unten angekommen bist, wartet [oma] bereits auf [kia]."

# game/scripts/c23/c23.rpy:1603
translate german c23s004_Oma_14a2700e:

    # oma "Hola, cielo."
    oma "Hallo Schatz."

# game/scripts/c23/c23.rpy:1604
translate german c23s004_Oma_86b43a6a:

    # mc "Hola, preciosa. ¿No trabajas hoy?"
    mc "Hallo, Schöne. Arbeitest du heute nicht?"

# game/scripts/c23/c23.rpy:1607
translate german c23s004_Oma_c63c3e9c:

    # oma "Hola, [kia] y [mc]."
    oma "Hallo, [kia] und [mc]."

# game/scripts/c23/c23.rpy:1608
translate german c23s004_Oma_45b32b95:

    # mc "Hola, [oma]. ¿No trabajas hoy?"
    mc "Hallo [oma]. Arbeitest du heute nicht?"

# game/scripts/c23/c23.rpy:1610
translate german c23s004_Oma_025afa94:

    # oma "Acabo de salir. Llevo toda la semana cubriendo el primer turno. Schrute está enfermo y estoy en el mostrador de la comisaría."
    oma "Ich habe gerade Feierabend. Ich habe die ganze Woche Frühschicht gehabt. Schrute ist krank, und ich bin am Schalter der Polizeiwache."

# game/scripts/c23/c23.rpy:1611
translate german c23s004_Oma_4e4ad102:

    # mc "Ufff. Yo odiaría tener que madrugar tanto."
    mc "Oh je. Ich würde es hassen, so früh aufstehen zu müssen."

# game/scripts/c23/c23.rpy:1613
translate german c23s004_Oma_e6ca9f9a:

    # kia "*Risa* Todo el mundo sabe que te gusta dormir hasta tarde."
    kia "*lacht* Jeder weiß, dass du gerne ausschläfst."

# game/scripts/c23/c23.rpy:1614
translate german c23s004_Oma_50206f78:

    # mc "¡Hey! ¡A primera hora de la mañana no tengo nada que hacer!"
    mc "Hey! Ich habe gleich morgens nichts zu tun!"

# game/scripts/c23/c23.rpy:1616
translate german c23s004_Oma_5dd58847:

    # oma "Podrías venir a correr conmigo, al menos cuando tengo turno normal."
    oma "Du könntest mit mir joggen gehen, zumindest wenn ich eine normale Schicht habe."

# game/scripts/c23/c23.rpy:1618
translate german c23s004_Oma_15d6cb33:

    # kia "O hacer yoga con las chicas. Me han dicho que lo probaste una vez y no has vuelto."
    kia "Oder mach Yoga mit den Mädels. Ich hab gehört, du hast es mal probiert und bist nicht wieder hingegangen."

# game/scripts/c23/c23.rpy:1619
translate german c23s004_Oma_1cfafede:

    # mc "*Risa* ¿Os dais cuenta de que lo único que proponéis es que haga más ejercicio?"
    mc "*Gelächter* Ist dir eigentlich klar, dass du mir lediglich vorschlägst, mehr Sport zu treiben?"

# game/scripts/c23/c23.rpy:1620
translate german c23s004_Oma_36ca33fd:

    # mc "*Risa* ¿Me estáis soltando indirectas de que me estoy engordando?"
    mc "*Lacht* Wollt ihr etwa andeuten, dass ich zunehme?"

# game/scripts/c23/c23.rpy:1623
translate german c23s004_Oma_1640c236:

    # oma "No, sabemos que vas a correr al lago a menudo. *Risita* No necesitas más ejercicio."
    oma "Nein, wir wissen, dass du oft zum See läufst. *Kichert* Du brauchst keine zusätzliche Bewegung."

# game/scripts/c23/c23.rpy:1625
translate german c23s004_Oma_11b1b1a1:

    # oma "No, sabemos que vas a correr al lago a menudo. No necesitas más ejercicio."
    oma "Nein, wir wissen, dass du oft zum See joggst. Du brauchst keine zusätzliche Bewegung."

# game/scripts/c23/c23.rpy:1626
translate german c23s004_Oma_7b373f76:

    # oma "Pero has dicho que no tienes nada que hacer por las mañanas. *Risa* Sólo te estamos dando opciones."
    oma "Aber du sagtest doch, du hättest morgens nichts vor. *lacht* Wir bieten dir nur ein paar Alternativen an."

# game/scripts/c23/c23.rpy:1627
translate german c23s004_Oma_5dedd215:

    # mc "Ya, pero lo del yoga... Ufff..."
    mc "Ja, aber Yoga... Ächz..."

# game/scripts/c23/c23.rpy:1629
translate german c23s004_Oma_cd68c1c0:

    # kia "Yo quiero apuntarme algún día. Quizás el domingo. ¿Por qué no vienes, [oma]?"
    kia "Ich möchte mich irgendwann anmelden. Vielleicht am Sonntag. Warum kommst du nicht mit, [oma]?"

# game/scripts/c23/c23.rpy:1631
translate german c23s004_Oma_ee8a7892:

    # oma "El domingo lo tengo libre. A lo mejor me apunto también. Solo lo he probado una vez, hace años, pero me gustó."
    oma "Ich habe am Sonntag Zeit. Vielleicht mache ich auch mit. Ich habe es nur einmal vor Jahren ausprobiert, aber es hat mir gefallen."

# game/scripts/c23/c23.rpy:1633
translate german c23s004_Oma_d512827e:

    # eil "¿Qué pasa el domingo?"
    eil "Was passiert am Sonntag?"

# game/scripts/c23/c23.rpy:1635
translate german c23s004_Oma_0fe0c027:

    # kia "Estábamos diciendo de apuntarnos a una sesión de yoga con las chicas."
    kia "Wir sprachen darüber, uns mit den Mädchen für einen Yoga-Kurs anzumelden."

# game/scripts/c23/c23.rpy:1636
translate german c23s004_Oma_e83a65fa:

    # kia "A ver si así convencemos a [mc] de que se apunte también."
    kia "Mal sehen, ob wir [mc] auch zur Teilnahme bewegen können."

# game/scripts/c23/c23.rpy:1638
translate german c23s004_Oma_3a16bc45:

    # eil "¡Contad conmigo! Creo que estoy perdiendo algo de flexibilidad."
    eil "Ich bin dabei! Ich glaube, ich verliere etwas an Flexibilität."

# game/scripts/c23/c23.rpy:1639
translate german c23s004_Oma_c2d9c488:

    # mc "Sabéis que no me vais a convencer, ¿verdad?"
    mc "Du weißt doch, dass du mich nicht überzeugen wirst, oder?"

# game/scripts/c23/c23.rpy:1641
translate german c23s004_Oma_d0553f4e:

    # oma "No estés tan seguro. Con todas las chicas haciéndote bullying para que te apuntes, dudo que puedas resistirte."
    oma "Sei dir da nicht so sicher. Bei all den Mädchen, die dich zur Anmeldung drängen, bezweifle ich, dass du widerstehen kannst."

# game/scripts/c23/c23.rpy:1642
translate german c23s004_Oma_483a9cb6:

    # mc "Ya veremos, pero no estéis tan seguras."
    mc "Wir werden sehen, aber sei dir da nicht so sicher."

# game/scripts/c23/c23.rpy:1647
translate german c23s004_Oma_e5c65855:

    # oma "Bueno, ya veremos. Me llevo a estas dos chicas antes de que se haga más tarde. Espero verte el domingo con mallas."
    oma "Na ja, wir werden sehen. Ich nehme die beiden Mädels noch mit, bevor es zu spät ist. Hoffentlich sehen wir uns am Sonntag in Strumpfhosen."

# game/scripts/c23/c23.rpy:1648
translate german c23s004_Oma_6546857c:

    # mc "No me vuelvo a poner las mallas de Tío Mike en mi vida. *Risa*"
    mc "Ich werde Onkel Mikes Strumpfhose nie wieder tragen. *lacht*"

# game/scripts/c23/c23.rpy:1653
translate german c23s004_Oma_06f8ca53:

    # kia "*Risa* Nos hablaron de lo anticuadas que se veían."
    kia "*Gelächter* Sie erzählten uns, wie altmodisch sie aussahen."

# game/scripts/c23/c23.rpy:1654
translate german c23s004_Oma_9ca7d97f:

    # mc "*Risa* Deben tener 20 años por lo menos."
    mc "*Gelächter* Sie müssen mindestens 20 Jahre alt sein."

# game/scripts/c23/c23.rpy:1659
translate german c23s004_Oma_38329130:

    # eil "Le preguntaremos a [mad.nick] si tiene unas más modernas para regalártelas. Así no podrás negarte. *Risa* No vas a despreciar nuestro regalo."
    eil "Wir fragen [mad.nick], ob sie neuere für dich hat. Dann kannst du nicht ablehnen. *Lacht* Du wirst unser Geschenk doch nicht ausschlagen."

# game/scripts/c23/c23.rpy:1660
translate german c23s004_Oma_85eddbf0:

    # mc "*Risa* Sois malvadas..."
    mc "*Gelächter* Du bist böse..."

# game/scripts/c23/c23.rpy:1661
translate german c23s004_Oma_df14b767:

    # mc "Iros antes de que me convenzáis de irme a Aruba antes de que llegue el domingo."
    mc "Verschwinde, bevor du mich überredet hast, vor Sonntag nach Aruba zu fahren."

# game/scripts/c23/c23.rpy:1663
translate german c23s004_Oma_d6430870:

    # todas "Hasta luego, [mc]."
    todas "Bis später, [mc]."

# game/scripts/c23/c23.rpy:1665
translate german c23s004_Oma_ddf0c1b3:

    # oma "Por cierto, os tengo que contar algo que pasó el lunes."
    oma "Übrigens muss ich dir etwas erzählen, das am Montag passiert ist."

# game/scripts/c23/c23.rpy:1667
translate german c23s004_Oma_b6374b4b:

    # oma "Ahora os lo explico en el coche."
    oma "Ich erkläre es dir im Auto."

# game/scripts/c23/c23.rpy:1671
translate german c23s004_Kim_2754a701:

    # "Pasas un rato después de comer leyendo los expedientes que [ama] y [jam] te han enviado sobre Iron Fist."
    "Du verbringst nach dem Mittagessen etwas Zeit damit, die Dateien zu lesen, die dir [ama] und [jam] über Iron Fist geschickt haben."

# game/scripts/c23/c23.rpy:1673
translate german c23s004_Kim_1ab19608:

    # "Bajas a media tarde a la cocina a por un vaso de agua. Tienes que comprarte una nevera para tu habitación."
    "Du gehst am Nachmittag in die Küche, um dir ein Glas Wasser zu holen. Du solltest dir einen Kühlschrank für dein Zimmer kaufen."

# game/scripts/c23/c23.rpy:1674
translate german c23s004_Kim_91d604d7:

    # "[oma] y [kia] no contaban con la cantidad de escaleras que subes y bajas al cabo del día cuando hablaban del ejercicio que haces."
    "Die Autoren [oma] und [kia] haben bei der Beschreibung Ihrer sportlichen Betätigung nicht berücksichtigt, wie viele Treppen Sie im Laufe des Tages auf- und absteigen."

# game/scripts/c23/c23.rpy:1680
translate german c23s004_Kim_3bce768b:

    # "Al pasar por la planta de las estudiantes te encuentras con [kim], que baja de tu planta."
    "Als du am Studentengeschoss vorbeigehst, begegnest du [kim], der gerade von deinem Stockwerk herunterkommt."

# game/scripts/c23/c23.rpy:1682
translate german c23s004_Kim_d4f784dc:

    # kim "Hola, [mc]. He pasado a verte por tu habitación."
    kim "Hallo, [mc]. Ich bin gekommen, um dich in deinem Zimmer zu besuchen."

# game/scripts/c23/c23.rpy:1683
translate german c23s004_Kim_8b63b330:

    # mc "¡Wow! ¿Dónde vas así vestida? Pareces una cazavampiros."
    mc "Wow! Wohin gehst du denn so angezogen? Du siehst aus wie ein Vampirjäger."

# game/scripts/c23/c23.rpy:1685
translate german c23s004_Kim_742bca56:

    # kim "¿Te has olvidado?"
    kim "Hast du es vergessen?"

# game/scripts/c23/c23.rpy:1695
translate german c23s004_Kim_81b0bcd4:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Aber ich wusste nicht, dass man sich so kleiden muss. Du hast mir gesagt, es sei ein Job als Flugbegleiterin und du könntest als Spionin durchgehen, genau wie [eva] und [ama]."

# game/scripts/c23/c23.rpy:1697
translate german c23s004_Kim_8475a636:

    # kim "¡Sabía que no te olvidarías!"
    kim "Ich wusste, dass du es nicht vergessen würdest!"

# game/scripts/c23/c23.rpy:1700
translate german c23s004_Kim_b94cca21:

    # mc "¿Tenía que hacer algo? No soy capaz de acordarme."
    mc "Musste ich etwas tun? Ich kann mich nicht erinnern."

# game/scripts/c23/c23.rpy:1702
translate german c23s004_Kim_7883c373:

    # kim "Te pedí que me llevaras al puerto para el trabajo que tengo esta tarde..."
    kim "Ich habe Sie gebeten, mich zum Hafen zu fahren, da ich heute Nachmittag dort Arbeit habe..."

# game/scripts/c23/c23.rpy:1703
translate german c23s004_Kim_39884136:

    # mc "¡Es verdad! ¡No me acordaba!"
    mc "Stimmt! Das hatte ich vergessen!"

# game/scripts/c23/c23.rpy:1704
translate german c23s004_Kim_81b0bcd4_1:

    # mc "Pero no sabía que tenías que ir vestida así. Me dijiste que era un trabajo de azafata y podrías pasar por una espía como [eva] y [ama]."
    mc "Aber ich wusste nicht, dass man sich so kleiden muss. Du hast mir gesagt, es sei ein Job als Flugbegleiterin und du könntest als Spionin durchgehen, genau wie [eva] und [ama]."

# game/scripts/c23/c23.rpy:1707
translate german c23s004_Kim_3898579d:

    # kim "Me han enviado el uniforme con una nota de que tengo que llegar vestida."
    kim "Sie schickten mir die Uniform mit einem Hinweis, dass ich bereits in Uniform erscheinen müsse."

# game/scripts/c23/c23.rpy:1708
translate german c23s004_Kim_afd55317:

    # kim "Por lo visto no hay espacio suficiente para cambiarse en el evento."
    kim "Offenbar gibt es bei der Veranstaltung nicht genügend Platz zum Umziehen."

# game/scripts/c23/c23.rpy:1709
translate german c23s004_Kim_1e4949d6:

    # mc "Ah, OK. ¿Cuándo quieres que vayamos?"
    mc "Ah, okay. Wann sollen wir los?"

# game/scripts/c23/c23.rpy:1711
translate german c23s004_Kim_3833d28d:

    # kim "Debería estar allí en una hora, pero, si te va bien, me gustaría salir antes. No me gusta llegar con el tiempo justo a los sitios."
    kim "Ich sollte in einer Stunde da sein, aber wenn es Ihnen passt, würde ich gerne früher losfahren. Ich mag es nicht, in letzter Minute irgendwo anzukommen."

# game/scripts/c23/c23.rpy:1712
translate german c23s004_Kim_ce457f98:

    # mc "*Risa* Ningún problema. Pero deberías dar clases de puntualidad al resto de las chicas. Lo de llegar con tiempo no se les suele dar bien."
    mc "*Lacht* Kein Problem. Aber du solltest den anderen Mädchen mal Nachhilfe in Pünktlichkeit geben. Pünktlichkeit gehört normalerweise nicht zu ihren Stärken."

# game/scripts/c23/c23.rpy:1713
translate german c23s004_Kim_f18b0b21:

    # mc "Déjame coger las llaves y la cartera, y nos podemos ir."
    mc "Ich hole schnell die Schlüssel und die Geldbörse, dann können wir los."

# game/scripts/c23/c23.rpy:1715
translate german c23s004_Kim_473af28b:

    # "Unos minutos después, en el coche..."
    "Ein paar Minuten später, im Auto..."

# game/scripts/c23/c23.rpy:1716
translate german c23s004_Kim_22885cfa:

    # mc "Ese evento, ¿es algo de ciencia ficción o de espías? Podrías salir en una peli de ciencia ficción con ese atuendo."
    mc "Stammt das aus einem Science-Fiction-Film oder einem Spionagefilm? Mit diesem Outfit könntest du glatt in einem Science-Fiction-Film mitspielen."

# game/scripts/c23/c23.rpy:1717
translate german c23s004_Kim_64bf16da:

    # kim "No tengo ni idea. No me ha contratado el cliente final, sino la agencia de la que te hablé."
    kim "Ich habe keine Ahnung. Ich wurde nicht vom Endkunden, sondern von der Agentur engagiert, von der ich Ihnen erzählt habe."

# game/scripts/c23/c23.rpy:1718
translate german c23s004_Kim_c94679bc:

    # mc "Pero ¿no deberías saber qué tienes que hacer?"
    mc "Aber sollten Sie nicht wissen, was Sie zu tun haben?"

# game/scripts/c23/c23.rpy:1720
translate german c23s004_Kim_00dde143:

    # kim "Bueno, es un trabajo de azafata. Recibir a los asistentes al evento, estar por allí en caso de que alguien necesite ayuda."
    kim "Nun ja, es ist die Aufgabe einer Gastgeberin. Die Teilnehmer der Veranstaltung begrüßen und für alle Fälle zur Verfügung stehen, in denen Hilfe benötigt wird."

# game/scripts/c23/c23.rpy:1721
translate german c23s004_Kim_f172c3df:

    # kim "En algunos de esos eventos, incluso nos toca pasear con bandejas de comida. Odio esa parte."
    kim "Bei manchen dieser Veranstaltungen müssen wir sogar Tabletts mit Essen herumtragen. Ich hasse diesen Teil."

# game/scripts/c23/c23.rpy:1722
translate german c23s004_Kim_27cd09c9:

    # mc "¿Por qué? Tiene que ser más divertido que quedarse en la puerta esperando que lleguen asistentes con retraso."
    mc "Warum? Das muss doch mehr Spaß machen, als an der Tür zu stehen und auf verspätete Teilnehmer zu warten."

# game/scripts/c23/c23.rpy:1724
translate german c23s004_Kim_041f33bd:

    # kim "*Risa* ¿No me conoces aún? Aeropuerto, bosque... Tengo cierta tendencia a tropezar."
    kim "*Lacht* Kennst du mich etwa noch nicht? Flughafen, Wald... Ich neige dazu, zu stolpern."

# game/scripts/c23/c23.rpy:1725
translate german c23s004_Kim_34ecb851:

    # kim "Imagina esos tropiezos con una bandeja llena de canapés. *Risa* Canapés voladores..."
    kim "Stell dir vor, du stolperst über ein Tablett voller Canapés. *Gelächter* Fliegende Canapés..."

# game/scripts/c23/c23.rpy:1726
translate german c23s004_Kim_2974ddbd:

    # mc "Y el CEO de una compañía acaba con caviar en la corbata."
    mc "Und der Vorstandsvorsitzende eines Unternehmens hat am Ende Kaviar auf seiner Krawatte."

# game/scripts/c23/c23.rpy:1728
translate german c23s004_Kim_97a08e5a:

    # kim "Más o menos. *Risa* O Dwayne Johnston con un canapé de salmón y dos de queso en la calva."
    kim "Mehr oder weniger. *Lacht* Oder Dwayne Johnston mit einem Lachs-Canapé und zwei Käse-Canapés auf seinem kahlen Kopf."

# game/scripts/c23/c23.rpy:1729
translate german c23s004_Kim_578f7d1d:

    # mc "*Risa* ¿Te pasó eso?"
    mc "*lacht* Ist dir das auch schon passiert?"

# game/scripts/c23/c23.rpy:1731
translate german c23s004_Kim_03094166:

    # kim "*Risa* Sí. No sabía dónde meterme. Era el primer evento que hacía con gente famosa."
    kim "*Lacht* Ja. Ich wusste gar nicht, wo ich mich verstecken sollte. Es war die erste Veranstaltung, an der ich je mit berühmten Leuten teilgenommen habe."

# game/scripts/c23/c23.rpy:1732
translate german c23s004_Kim_655c0f4d:

    # mc "¿Qué pasó?"
    mc "Was ist passiert?"

# game/scripts/c23/c23.rpy:1734
translate german c23s004_Kim_8ece0b8c:

    # kim "El Sr. Johnston fue muy amable... después de lanzarme una mirada asesina. Me ayudó a levantarme y me preguntó si me había hecho daño."
    kim "Herr Johnston war sehr freundlich … nachdem er mich einen mörderischen Blick zugeworfen hatte. Er half mir auf und fragte, ob ich verletzt sei."

# game/scripts/c23/c23.rpy:1735
translate german c23s004_Kim_fd2a107a:

    # kim "Después se rio mucho cuando me ruboricé mientras le pedía disculpas. Por suerte solo le manché la cabeza y no el traje."
    kim "Er lachte laut, als ich rot wurde und mich entschuldigte. Zum Glück landete es nur auf seinem Kopf und nicht auf seinem Anzug."

# game/scripts/c23/c23.rpy:1736
translate german c23s004_Kim_3d98e978:

    # mc "Con un tipo tan enorme mirándome con ganas de asesinarme, seguramente me hubiera escondido debajo de una mesa. *Risa*"
    mc "Wenn mich so ein riesiger Kerl so angestarrt hätte, als wollte er mich umbringen, hätte ich mich wahrscheinlich unter einem Tisch versteckt. *lacht*"

# game/scripts/c23/c23.rpy:1738
translate german c23s004_Kim_9a184fb3:

    # kim "*Risa* Te aseguro que es lo primero que se me pasó por la cabeza. Hacer como el actor ese pequeñito que hace pelis con él y salir de allí gateando."
    kim "*Lacht* Ich versichere Ihnen, das war auch mein erster Gedanke. So zu sein wie dieser kleine Schauspieler, der damit Filme macht, und da rauszukriechen."

# game/scripts/c23/c23.rpy:1739
translate german c23s004_Kim_f81bda84:

    # mc "¿Kevin Heart?"
    mc "Kevin Heart?"

# game/scripts/c23/c23.rpy:1740
translate german c23s004_Kim_3a463a4e:

    # kim "Sí, ese. ¡Me encanta ese tío! ¡Es super gracioso!"
    kim "Ja, genau der. Ich liebe diesen Kerl! Er ist total witzig!"

# game/scripts/c23/c23.rpy:1741
translate german c23s004_Kim_8c1dc6b4:

    # mc "Y sobre el evento, ¿conoces a alguna de las otra chicas? Si os ha contratado la misma agencia..."
    mc "Und was die Veranstaltung angeht, kennen Sie irgendwelche der anderen Mädchen? Falls Sie von derselben Agentur engagiert wurden..."

# game/scripts/c23/c23.rpy:1743
translate german c23s004_Kim_aef6db14:

    # kim "A una de ellas, Adeline. Hemos coincidido en la agencia, pero no he trabajado nunca con ella. Va a ser la jefa esta noche."
    kim "Eine von ihnen ist Adeline. Wir haben uns in der Agentur kennengelernt, aber ich habe noch nie mit ihr zusammengearbeitet. Sie wird heute Abend die Chefin sein."

# game/scripts/c23/c23.rpy:1744
translate german c23s004_Kim_8dd56270:

    # mc "Bueno, al menos tendrás una cara conocida. Supongo que siempre es bueno."
    mc "Nun ja, zumindest triffst du dort auf ein bekanntes Gesicht. Das ist wohl immer gut."

# game/scripts/c23/c23.rpy:1746
translate german c23s004_Kim_4ae755b4:

    # kim "Depende a quién pertenezca esa cara. *Risa* En este mundillo hay muchas perras."
    kim "Das kommt darauf an, wessen Gesicht das ist. *lacht* In diesem Geschäft gibt es viele Zicken."

# game/scripts/c23/c23.rpy:1747
translate german c23s004_Kim_ba1a071a:

    # kim "Y en el mundo de las modelos es peor todavía."
    kim "Und in der Welt der Models ist es noch schlimmer."

# game/scripts/c23/c23.rpy:1748
translate german c23s004_Kim_4ca7ba1b:

    # mc "Me tienes que contar cómo empezaste en lo de trabajar de modelo."
    mc "Du musst mir erzählen, wie du zum Modeln gekommen bist."

# game/scripts/c23/c23.rpy:1750
translate german c23s004_Kim_ffce8934:

    # kim "Todo empezó cuando Winnie Carlow saltó a la fama. Los cazatalentos empezaron a visitar escuelas y..."
    kim "Alles begann mit dem Aufstieg von Winnie Carlow. Talentscouts begannen, Schulen zu besuchen und..."

# game/scripts/c23/c23.rpy:1752
translate german c23s004_Kim_beddfb92:

    # "[kim] te explica todo lo que tuvo que aprender en las escuelas de modelos, sus primeros trabajos, sus primeros éxitos y fracasos..."
    "[kim] erklärt alles, was sie in Modelschulen lernen musste, ihre ersten Jobs, ihre ersten Erfolge und Misserfolge..."

# game/scripts/c23/c23.rpy:1753
translate german c23s004_Kim_ab5d1645:

    # "Se nota que adora su trabajo por la ilusión con la que habla de ello."
    "Man merkt ihr an, wie sehr sie ihren Job liebt, an der Begeisterung, mit der sie darüber spricht."

# game/scripts/c23/c23.rpy:1754
translate german c23s004_Kim_a076c416:

    # "La conversación es tan amena que casi no te das cuenta de que ya habéis llegado al puerto, donde hay otras chicas vestidas como [kim]."
    "Das Gespräch ist so angenehm, dass man kaum merkt, dass man schon im Hafen angekommen ist, wo sich andere Mädchen befinden, die als [kim] verkleidet sind."

# game/scripts/c23/c23.rpy:1756
translate german c23s004_Kim_b0dea2ba:

    # mc "Pues ya hemos llegado. ¿Quieres que te acompañe?"
    mc "Wir sind angekommen. Soll ich Sie begleiten?"

# game/scripts/c23/c23.rpy:1757
translate german c23s004_Kim_7d98cdb5:

    # kim "Gracias, pero no hace falta."
    kim "Danke, aber das ist nicht nötig."

# game/scripts/c23/c23.rpy:1759
translate german c23s004_Kim_d4ea101b:

    # kim "Aquella rubia es Adeline. De la que te he hablado antes. Mi jefa por esta noche."
    kim "Das ist Adeline, die, von der ich dir vorhin erzählt habe. Meine Chefin für heute Abend."

# game/scripts/c23/c23.rpy:1760
translate german c23s004_Kim_68afdd7b:

    # kim "Iré a presentarme al resto de chicas, y si me acompañas sería como mostrar inseguridad."
    kim "Ich werde mich den anderen Mädchen vorstellen, und wenn du mitkommst, würde das wie Unsicherheit wirken."

# game/scripts/c23/c23.rpy:1761
translate german c23s004_Kim_1a6ba295:

    # mc "Como desees. ¿Los dos tipos que parecen guardaespaldas también pertenecen al evento?"
    mc "Wie Sie wünschen. Gehören die beiden Männer, die wie Bodyguards aussehen, auch zu der Veranstaltung?"

# game/scripts/c23/c23.rpy:1763
translate german c23s004_Kim_bbeda5a9:

    # kim "No lo sé. Por lo que sé, somos cinco azafatas y otras dos chicas para otros servicios. No me han dicho nada de chicos."
    kim "Ich weiß es nicht. Soweit ich weiß, sind wir fünf Flugbegleiterinnen und zwei weitere Mädchen für andere Dienste. Von Jungen wurde nichts erwähnt."

# game/scripts/c23/c23.rpy:1764
translate german c23s004_Kim_81f6d6f7:

    # kim "A lo mejor son los porteros y los han contratado en otra agencia. No tengo ni idea."
    kim "Vielleicht sind es die Torhüter und sie wurden über eine andere Agentur engagiert. Ich habe keine Ahnung."

# game/scripts/c23/c23.rpy:1765
translate german c23s004_Kim_7cd995a2:

    # mc "Pues eres la cuarta en llegar. Falta una cazavampiros y las dos chicas de los otros... servicios."
    mc "Nun, Sie sind der Vierte, der ankommt. Wir warten noch auf einen Vampirjäger und die beiden Mädchen von den anderen... Diensten."

# game/scripts/c23/c23.rpy:1767
translate german c23s004_Kim_051f4639:

    # kim "*Risa* Has dicho lo de servicios como si te sonara sospechoso."
    kim "*lacht* Du hast „Dienstleistungen“ gesagt, als ob es dir verdächtig vorkäme."

# game/scripts/c23/c23.rpy:1768
translate german c23s004_Kim_1f1e79c0:

    # kim "Se suele llamar así a la gente del cátering, de la limpieza, etc."
    kim "So werden üblicherweise Mitarbeiter aus den Bereichen Catering, Reinigung usw. bezeichnet."

# game/scripts/c23/c23.rpy:1769
translate german c23s004_Kim_76125965:

    # mc "Ah, OK. Al decirlo así ha sonado... *Risa* sospechoso."
    mc "Ah, okay. So formuliert klang es... *lacht* verdächtig."

# game/scripts/c23/c23.rpy:1770
translate german c23s004_Kim_73a9eea1:

    # mc "¿Quieres que te venga a buscar cuando acabes?"
    mc "Soll ich dich abholen, wenn du fertig bist?"

# game/scripts/c23/c23.rpy:1772
translate german c23s004_Kim_c4904bff:

    # kim "No hace falta. Acabará tarde y no quiero molestarte."
    kim "Das ist nicht nötig. Es wird spät sein und ich möchte dich nicht stören."

# game/scripts/c23/c23.rpy:1773
translate german c23s004_Kim_5ad080fa:

    # mc "No es molestia. ¿Cómo volverás a casa si nadie viene a buscarte?"
    mc "Kein Problem. Wie kommst du denn nach Hause, wenn dich niemand abholt?"

# game/scripts/c23/c23.rpy:1775
translate german c23s004_Kim_f82ff79f:

    # kim "Pediré un Under o a lo mejor alguna de las chicas puede llevarme."
    kim "Ich bestelle ein Under oder vielleicht kann mich eines der Mädchen mitnehmen."

# game/scripts/c23/c23.rpy:1776
translate german c23s004_Kim_c31e85f0:

    # mc "Si tienes algún problema, no dudes en llamarme. Sea la hora que sea."
    mc "Sollten Sie Probleme haben, zögern Sie nicht, mich anzurufen. Egal zu welcher Uhrzeit."

# game/scripts/c23/c23.rpy:1778
translate german c23s004_Kim_3225c954:

    # kim "Gracias de nuevo, [mc]. Pero no te preocupes. Si tengo algún problema, te llamaré."
    kim "Vielen Dank nochmal, [mc]. Aber keine Sorge. Falls ich irgendwelche Probleme habe, melde ich mich bei dir."

# game/scripts/c23/c23.rpy:1780
translate german c23s004_Kim_81b83644:

    # kim "Ahora tengo que irme, antes de que llegue la última cazavampiros."
    kim "Ich muss jetzt gehen, bevor der letzte Vampirjäger eintrifft."

# game/scripts/c23/c23.rpy:1781
translate german c23s004_Kim_5d67085f:

    # mc "Suerte con el trabajo y, si te hacen pasear bandejas, que sean de canapés y no de copas de champán. *Risa*"
    mc "Viel Glück im Job! Und falls du Tabletts herumtragen musst, achte darauf, dass es Tabletts mit Canapés und nicht mit Champagnergläsern sind. *lacht*"

# game/scripts/c23/c23.rpy:1783
translate german c23s004_Kim_cb4717cc:

    # kim "Muy gracioso... *Risa*"
    kim "Sehr witzig... *lacht*"

# game/scripts/c23/c23.rpy:1784
translate german c23s004_Kim_98cbe997:

    # kim "Te veo mañana en casa."
    kim "Wir sehen uns morgen zu Hause."

# game/scripts/c23/c23.rpy:1785
translate german c23s004_Kim_1171553f:

    # mc "Hasta mañana, [kim]."
    mc "Bis morgen, [kim]."

# game/scripts/c23/c23.rpy:1790
translate german c23s004_Kim_022da978:

    # "[kim] se aleja del coche con paso seguro, pasando de largo de los porteros y dirigiéndose a las cazavampiros."
    "[kim] verlässt das Auto mit selbstsicheren Schritten, geht an den Türstehern vorbei und steuert auf die Vampirjäger zu."

# game/scripts/c23/c23.rpy:1791
translate german c23s004_Kim_39b267af:

    # "Por primera vez, te la puedes imaginar caminando por una pasarela. Los porteros parecen tener otros pensamientos."
    "Zum ersten Mal kann man sich vorstellen, wie sie über einen Laufsteg schreitet. Die Türsteher scheinen da anderer Meinung zu sein."

# game/scripts/c23/c23.rpy:1795
translate german c23s004_Kim_cd871e42:

    # "Vuelves a casa y cenas con las chicas. El tema de conversación se centra en el viaje de [bet] a Monterey."
    "Du gehst nach Hause und isst mit den Mädels zu Abend. Das Gespräch kommt auf [bet]s Reise nach Monterey."

# game/scripts/c23/c23.rpy:1796
translate german c23s004_Kim_bb870621:

    # "Que seas tú quien conduce o que [emm] vaya a cumplir su sueño de conducir un Ferrarini rosa casi no se comenta."
    "Ob Sie selbst am Steuer sitzen oder ob [emm] sich seinen Traum vom Fahren eines pinkfarbenen Ferraris erfüllen wird, wird kaum kommentiert."

# game/scripts/c23/c23.rpy:1797
translate german c23s004_Kim_0bae2113:

    # "Todo el mundo está preocupado con lo que pueda pasar en la reunión de [bet]."
    "Alle sind besorgt darüber, was bei dem [bet]-Treffen passieren könnte."

# game/scripts/c23/c23.rpy:1811
translate german c23s005_MarVisit_d348568e:

    # "Después de cenar te das una ducha y bajas a la habitación de [mar]."
    "Nach dem Abendessen duschen Sie und gehen dann in Zimmer [mar]."

# game/scripts/c23/c23.rpy:1815
translate german c23s005_MarVisit_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c23/c23.rpy:1816
translate german c23s005_MarVisit_70439077:

    # mc "Soy yo, ¿puedo entrar?"
    mc "Ich bin's, darf ich hereinkommen?"

# game/scripts/c23/c23.rpy:1817
translate german c23s005_MarVisit_3e92d953:

    # mar "*A través de la puerta* Sí, entra."
    mar "*Durch die Tür* Ja, kommen Sie herein."

# game/scripts/c23/c23.rpy:1819
translate german c23s005_MarVisit_564f71da:

    # mc "Quería preguntarte por la camisa azul. ¿La has encontrado?"
    mc "Ich wollte Sie wegen des blauen Hemdes fragen. Haben Sie es gefunden?"

# game/scripts/c23/c23.rpy:1820
translate german c23s005_MarVisit_fd0098b2:

    # mom "Sí, la he metido en la maleta de [emm]. En una de las maletas."
    mom "Ja, ich habe es in [emm]s Koffer gelegt. In einen der Koffer."

# game/scripts/c23/c23.rpy:1821
translate german c23s005_MarVisit_d2a50ced:

    # mc "*Risa* ¿Cuántas se lleva al final?"
    mc "*Gelächter* Wie viele nimmt sie am Ende?"

# game/scripts/c23/c23.rpy:1822
translate german c23s005_MarVisit_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Darf ich mich setzen?"

# game/scripts/c23/c23.rpy:1824
translate german c23s005_MarVisit_731a1635:

    # mom "*Risa* Eso es algo que tendrás que descubrir mañana."
    mom "*Lacht* Das musst du morgen herausfinden."

# game/scripts/c23/c23.rpy:1825
translate german c23s005_MarVisit_d8845d26:

    # mc "Dame sólo una pista. Si fuéramos en tu coche en vez de con la pick up, ¿cabrían?"
    mc "Gib mir nur einen Hinweis. Würden sie in dein Auto passen, anstatt in den Pickup?"

# game/scripts/c23/c23.rpy:1827
translate german c23s005_MarVisit_70ce664e:

    # mom "No. *Risa* Seguramente deberíais dejar a Tía [bet] aquí."
    mom "Nein. *Lacht* Du solltest Tante [bet] wohl besser hier lassen."

# game/scripts/c23/c23.rpy:1828
translate german c23s005_MarVisit_943171d1:

    # mc "Vale, me hago una idea."
    mc "Okay, ich verstehe."

# game/scripts/c23/c23.rpy:1829
translate german c23s005_MarVisit_9ad77aff:

    # mc "Por cierto, ¿qué estás leyendo? No sabía que te gustaban los cómics."
    mc "Übrigens, was liest du gerade? Ich wusste gar nicht, dass du Comics magst."

# game/scripts/c23/c23.rpy:1831
translate german c23s005_MarVisit_852f836e:

    # mom "Creía que era una revista. Se llama Días de Dormitorio."
    mom "Ich dachte, es wäre eine Zeitschrift. Sie heißt Dormitory Days."

# game/scripts/c23/c23.rpy:1832
translate german c23s005_MarVisit_c76428d1:

    # mom "Pero creo que es de [kat]."
    mom "Aber ich glaube, es stammt von [kat]."

# game/scripts/c23/c23.rpy:1834
translate german c23s005_MarVisit_7af44f31:

    # mom "Un grupo de chicas en un dormitorio femenino. Ellas no tienen la suerte de tenerte a ti para ayudarlas, aunque tampoco parecen necesitarlo."
    mom "Eine Gruppe Mädchen in einem Frauenschlafsaal. Sie haben nicht das Glück, dass du ihnen hilfst, obwohl sie es scheinbar auch nicht brauchen."

# game/scripts/c23/c23.rpy:1835
translate german c23s005_MarVisit_195caa06:

    # mom "Y... ya sabes..."
    mom "Und... Sie wissen schon..."

# game/scripts/c23/c23.rpy:1836
translate german c23s005_MarVisit_044bf7d6:

    # mc "Vale, un cómic lésbico."
    mc "Okay, ein Lesben-Comic."

# game/scripts/c23/c23.rpy:1838
translate german c23s005_MarVisit_c8aea4db:

    # mc "Quizás se lo pida para echarle un vistazo."
    mc "Vielleicht bitte ich ihn, einen Blick darauf zu werfen."

# game/scripts/c23/c23.rpy:1840
translate german c23s005_MarVisit_1f11f99c:

    # mom "Aparte de hablar de mis gustos literarios... *Risa* ¿Querías algo más?"
    mom "Abgesehen von meinem literarischen Geschmack... *lacht* Wolltest du noch etwas anderes?"

# game/scripts/c23/c23.rpy:1841
translate german c23s005_MarVisit_b3f442bd:

    # mc "No, sólo venía por lo de la camisa. No es que tenga intención de ponérmela, pero..."
    mc "Nein, ich bin nur wegen des Hemdes hier. Ich habe nicht vor, es zu tragen, aber..."

# game/scripts/c23/c23.rpy:1844
translate german c23s005_MarVisit_0e04b775:

    # mom "Pero hoy ya has perdido una camisa y no quieres perder más. *Risa*"
    mom "Aber du hast heute schon ein Hemd verloren und willst kein weiteres mehr verlieren. *lacht*"

# game/scripts/c23/c23.rpy:1845
translate german c23s005_MarVisit_0151713c:

    # mc "*Risa* Exacto."
    mc "*Lacht* Genau."

# game/scripts/c23/c23.rpy:1846
translate german c23s005_MarVisit_f67bb261:

    # mom "No te preocupes, está en la maleta de [emm]. En una de sus maletas."
    mom "Keine Sorge, es ist in [emm]s Koffer. In einem seiner Koffer."

# game/scripts/c23/c23.rpy:1853
translate german c23s005_NoMar_3ee1513b:

    # mc "Bueno, entonces me voy a dormir ya. Mañana nos levantamos temprano."
    mc "Okay, dann gehe ich jetzt schlafen. Wir müssen morgen früh aufstehen."

# game/scripts/c23/c23.rpy:1854
translate german c23s005_NoMar_3d6e8676:

    # mc "Te veo el viernes."
    mc "Wir sehen uns am Freitag."

# game/scripts/c23/c23.rpy:1856
translate german c23s005_NoMar_45dc9a44:

    # mom "No, me levantaré para haceros el desayuno antes de que salgáis."
    mom "Nein, ich stehe auf und mache dir Frühstück, bevor du gehst."

# game/scripts/c23/c23.rpy:1857
translate german c23s005_NoMar_2c3b5aa8:

    # mc "No te tienes que preocupar por eso."
    mc "Darüber brauchst du dir keine Sorgen zu machen."

# game/scripts/c23/c23.rpy:1859
translate german c23s005_NoMar_e70b3cce:

    # mom "He dicho que me levantaré y lo pienso hacer. No voy a dejar que conduzcas tres horas con el estómago vacío."
    mom "Ich habe gesagt, ich stehe auf, und das habe ich auch vor. Ich lasse dich nicht drei Stunden mit leerem Magen fahren."

# game/scripts/c23/c23.rpy:1860
translate german c23s005_NoMar_e4aa384c:

    # mc "Sabes que soy capaz de prepararme un café y cortarme un trozo de tarta, ¿verdad?"
    mc "Du weißt doch, dass ich mir selbst einen Kaffee machen und mir ein Stück Kuchen abschneiden kann, oder?"

# game/scripts/c23/c23.rpy:1861
translate german c23s005_NoMar_ac66e14c:

    # mc "Pero bueno, no te voy a convencer de que no lo hagas. Te veo mañana."
    mc "Aber ich werde dich trotzdem nicht davon abbringen. Bis morgen."

# game/scripts/c23/c23.rpy:1862
translate german c23s005_NoMar_f617ec24:

    # mom "Hasta mañana."
    mom "Bis morgen."

# game/scripts/c23/c23.rpy:1865
translate german c23s005_NoMar_554a793f:

    # "Subes a tu habitación y duermes toda la noche sin soñar..."
    "Du gehst in dein Zimmer und schläfst die ganze Nacht, ohne zu träumen..."

# game/scripts/c23/c23.rpy:1866
translate german c23s005_NoMar_b3f31ca1:

    # centered "{size=+20}{b}DÍA 24 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}TAG 24 – DONNERSTAG{/b}{/size}"

# game/scripts/c23/c23.rpy:1869
translate german c23s005_NoMar_ec286efa:

    # "... Hasta que la puerta se abre de golpe y alguien enciende la luz."
    "...Bis die Tür aufspringt und jemand das Licht anknipst."

# game/scripts/c23/c23.rpy:1870
translate german c23s005_NoMar_35ad285c:

    # emm "¡Despierta! ¡Nos tenemos que ir!"
    emm "Aufwachen! Wir müssen los!"

# game/scripts/c23/c23.rpy:1871
translate german c23s005_NoMar_4102bb2b:

    # "OK. Ya estás despierto. Y sobresaltado."
    "Okay. Du bist jetzt wach. Und erschrocken."

# game/scripts/c23/c23.rpy:1872
translate german c23s005_NoMar_d525fe1d:

    # mc "¿Qué hora es, [emm]? No he oído el despertador."
    mc "Wie spät ist es, [emm]? Ich habe den Wecker nicht gehört."

# game/scripts/c23/c23.rpy:1874
translate german c23s005_NoMar_2060c21e:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a buscarte."
    emm "Es ist 6:00 Uhr morgens. Ich bin schon über eine Stunde wach und habe mich davon abgehalten, nach oben zu gehen und nach dir zu suchen."

# game/scripts/c23/c23.rpy:1875
translate german c23s005_NoMar_e6da23ea:

    # emm "Pero si no te levantas ya, se va a hacer tarde."
    emm "Aber wenn du jetzt nicht aufstehst, wird es spät."

# game/scripts/c23/c23.rpy:1876
translate german c23s005_NoMar_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], wir hatten gesagt, wir würden um 8:00 Uhr von hier abfahren. Ich hatte meinen Wecker auf 7:15 Uhr gestellt."

# game/scripts/c23/c23.rpy:1878
translate german c23s005_NoMar_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "Und in 45 Minuten wolltest du duschen gehen..."

# game/scripts/c23/c23.rpy:1879
translate german c23s005_NoMar_f4b84d41:

    # mc "Me duché anoche..."
    mc "Ich habe gestern Abend geduscht..."

# game/scripts/c23/c23.rpy:1880
translate german c23s005_NoMar_d664759d:

    # emm "A vestirte..."
    emm "Zieh dich an..."

# game/scripts/c23/c23.rpy:1881
translate german c23s005_NoMar_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Ich bin ein Mann. Ich brauche weniger als fünf Minuten. Fünf echte Minuten..."

# game/scripts/c23/c23.rpy:1882
translate german c23s005_NoMar_d6f2a180:

    # emm "Y a desayunar..."
    emm "Und Zeit fürs Frühstück..."

# game/scripts/c23/c23.rpy:1883
translate german c23s005_NoMar_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Dafür waren 30 der 45 Minuten gedacht. *Gelächter*"

# game/scripts/c23/c23.rpy:1884
translate german c23s005_NoMar_d48c1dce:

    # mc "Puedes ir preparando el café, si quieres ir avanzando. Mamá dijo que se levantaría para hacer el desayuno."
    mc "Du kannst schon mal mit dem Kaffee anfangen, wenn du schon mal da sein willst. Mama meinte, sie würde aufstehen, um Frühstück zu machen."

# game/scripts/c23/c23.rpy:1886
translate german c23s005_NoMar_ea722677:

    # emm "Mamá ya está en la cocina horneando algo. El olor es lo que me ha convencido de que ya era hora de despertarte."
    emm "Mama ist schon in der Küche und backt etwas. Der Duft hat mich überzeugt, dass es Zeit war, dich zu wecken."

# game/scripts/c23/c23.rpy:1887
translate german c23s005_NoMar_37ec136f:

    # mc "Vale... ¿Tía [bet] ya está despierta?"
    mc "Okay... Ist Tante [bet] schon wach?"

# game/scripts/c23/c23.rpy:1889
translate german c23s005_NoMar_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Ich weiß es nicht! Ich habe sie noch nicht besucht!"

# game/scripts/c23/c23.rpy:1890
translate german c23s005_NoMar_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "Worauf wartest du noch? Sie ist eine Frau und braucht länger zum Anziehen als ich."

# game/scripts/c23/c23.rpy:1891
translate german c23s005_NoMar_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Du hast recht! Ich gehe!"

# game/scripts/c23/c23.rpy:1894
translate german c23s005_NoMar_6e734612:

    # "*Blam*"
    "*Bumm*"

# game/scripts/c23/c23.rpy:1895
translate german c23s005_NoMar_6713e858:

    # emm "*A través de la puerta* Todo lo tengo que hacer yo en esta casa..."
    emm "*Durch die Tür* Ich muss in diesem Haus alles erledigen..."

# game/scripts/c23/c23.rpy:1897
translate german c23s005_NoMar_efe2aa2c:

    # mcp "(Y se fue. Bajaré a la cocina a ayudar a [mar] a preparar el desayuno.)"
    mcp "(Und sie ging. Ich gehe in die Küche, um [mar] beim Frühstückszubereiten zu helfen.)"

# game/scripts/c23/c23.rpy:1901
translate german c23s005_Mar_82ff8c0e:

    # mom "¿Quieres quedarte a dormir?"
    mom "Möchten Sie übernachten?"

# game/scripts/c23/c23.rpy:1902
translate german c23s005_Mar_ec063b6b:

    # mc "*Risa* Creía que no me lo ibas a pedir."
    mc "*Lacht* Ich dachte schon, du würdest mich nicht fragen."

# game/scripts/c23/c23.rpy:1904
translate german c23s005_Mar_e4a23ead:

    # mom "¿De verdad lo creías? Venir a preguntar por la camisa, cuando no tienes interés en ella, es la peor excusa que se te podía haber ocurrido."
    mom "Hast du das wirklich geglaubt? Hierher zu kommen und nach dem Hemd zu fragen, obwohl du gar kein Interesse daran hast, ist die schlechteste Ausrede, die du dir hättest einfallen lassen können."

# game/scripts/c23/c23.rpy:1905
translate german c23s005_Mar_0374b3a7:

    # mom "Y saber que vas a estar dos días fuera cuando apenas acabas de volver de la universidad..."
    mom "Und zu wissen, dass man zwei Tage weg sein wird, obwohl man gerade erst von der Uni zurückgekommen ist..."

# game/scripts/c23/c23.rpy:1906
translate german c23s005_Mar_2125c473:

    # mc "Hace más de tres semanas que volví. Y no son dos días. Sólo es una noche."
    mc "Ich bin seit über drei Wochen wieder zurück. Und es sind nicht nur zwei Tage. Es ist nur eine Nacht."

# game/scripts/c23/c23.rpy:1908
translate german c23s005_Mar_9c8bbee0:

    # mom "Bueno, lo que sea. A una madre no le gusta perder de vista a sus polluelos aunque sea sólo por una noche."
    mom "Nun ja, wie auch immer. Eine Mutter verliert ihre Küken nicht gern aus den Augen, selbst wenn es nur für eine Nacht ist."

# game/scripts/c23/c23.rpy:1909
translate german c23s005_Mar_8bfb55eb:

    # mc "*Risa* Y estoy seguro de que me dirás que conduzca con cuidado y que no corra por la autopista."
    mc "*Lacht* Und ich bin mir sicher, Sie werden mir sagen, ich solle vorsichtig fahren und auf der Autobahn nicht zu schnell fahren."

# game/scripts/c23/c23.rpy:1911
translate german c23s005_Mar_65ccc2dd:

    # mom "¡Por supuesto! *Risa* ¡Y me levantaré temprano para prepararos el desayuno!"
    mom "Na klar! *lacht* Und ich stehe extra früh auf, um dir Frühstück zu machen!"

# game/scripts/c23/c23.rpy:1912
translate german c23s005_Mar_bdcf4cd9:

    # mc "No hace falta, sé preparar café y coger un trozo de tarta."
    mc "Das ist nicht nötig, ich weiß, wie man Kaffee kocht und ein Stück Kuchen isst."

# game/scripts/c23/c23.rpy:1914
translate german c23s005_Mar_86e6ca78:

    # mom "Me da lo mismo. Mis dos niños se van a pasar la noche fuera y no pienso dejar que os vayáis con el estómago vacío."
    mom "Das ist mir egal. Meine beiden Kinder sind heute Abend unterwegs, und ich lasse dich nicht mit leerem Magen gehen."

# game/scripts/c23/c23.rpy:1915
translate german c23s005_Mar_281c7abb:

    # mc "Lo haces para sentirte mejor, ¿no?"
    mc "Du tust es, um dich besser zu fühlen, nicht wahr?"

# game/scripts/c23/c23.rpy:1917
translate german c23s005_Mar_e77b74f5:

    # mom "Entre otras cosas..."
    mom "Unter anderem..."

# game/scripts/c23/c23.rpy:1918
translate german c23s005_Mar_d961e82b:

    # mc "Entonces estaré encantado de que nos prepares el desayuno."
    mc "Dann würde ich mich sehr freuen, wenn Sie uns das Frühstück zubereiten würden."

# game/scripts/c23/c23.rpy:1920
translate german c23s005_Mar_81e58346:

    # mom "¿Por qué no te pones cómodo mientras yo guardo el cómic?"
    mom "Mach es dir doch bequem, während ich den Comic wegräume."

# game/scripts/c23/c23.rpy:1921
translate german c23s005_Mar_bc03d346:

    # mc "¿Guardarlo? ¿Por qué no lo dejas en la mesilla de noche?"
    mc "Wegräumen? Warum nicht auf dem Nachttisch lassen?"

# game/scripts/c23/c23.rpy:1923
translate german c23s005_Mar_f95c1578:

    # mom "Estoy casi segura de que [emm] vendrá aquí si se despierta antes que yo, y no quiero que tenga ninguna idea rara."
    mom "Ich bin mir fast sicher, dass [emm] hierherkommen wird, wenn er vor mir aufwacht, und ich möchte nicht, dass er auf irgendwelche komischen Ideen kommt."

# game/scripts/c23/c23.rpy:1925
translate german c23s005_Mar_83323914:

    # mom "Últimamente la he visto queriendo probar cosas nuevas..."
    mom "Mir ist in letzter Zeit aufgefallen, dass sie gerne neue Dinge ausprobiert..."

# game/scripts/c23/c23.rpy:1926
translate german c23s005_Mar_d2d9d612:

    # mc "Si me encuentra durmiendo aquí, en lo que menos se va a fijar será en un cómic lésbico encima de tu mesilla."
    mc "Wenn er mich hier schlafend vorfindet, wird er als Letztes einen Lesbencomic auf meinem Nachttisch bemerken."

# game/scripts/c23/c23.rpy:1927
translate german c23s005_Mar_09f08358:

    # mc "Además, con lo excitada que estará, no creo que se fije ni siquiera en si estoy yo. *Risa*"
    mc "Außerdem wird sie sich so freuen, dass sie mich wahrscheinlich gar nicht bemerken wird. *lacht*"

# game/scripts/c23/c23.rpy:1929
translate german c23s005_Mar_540fe0fa:

    # mom "Bueno, de todas formas voy a guardarlo. No voy a leer nada más esta noche..."
    mom "Nun ja, ich speichere es trotzdem. Ich werde heute Abend nichts mehr lesen..."

# game/scripts/c23/c23.rpy:1930
translate german c23s005_Mar_0ea7bcf6:

    # mom "Hay cosas que me apetecen más hacer que leer."
    mom "Es gibt Dinge, die ich lieber tue, als zu lesen."

# game/scripts/c23/c23.rpy:1931
translate german c23s005_Mar_f9788a14:

    # mc "Me parece una idea prometedora... Voy a hacerte caso y a ponerme cómodo."
    mc "Das klingt nach einer vielversprechenden Idee... Ich werde deinen Rat befolgen und es mir bequem machen."

# game/scripts/c23/c23.rpy:1933
translate german c23s005_Mar_c350f7d3:

    # mom "Yo también voy a ponerme cómoda."
    mom "Ich werde es mir auch gemütlich machen."

# game/scripts/c23/c23.rpy:1934
translate german c23s005_Mar_41efa3af:

    # mc "Déjate puesto el collar, si no te importa. Me encanta cómo te queda."
    mc "Wenn es Ihnen nichts ausmacht, können Sie die Kette gerne anlassen. Sie steht Ihnen ausgezeichnet."

# game/scripts/c23/c23.rpy:1936
translate german c23s005_Mar_2fd6017d:

    # mom "¿Sólo el collar?"
    mom "Nur die Halskette?"

# game/scripts/c23/c23.rpy:1938
translate german c23s005_Mar_55410cb7:

    # mc "Solo el collar."
    mc "Nur das Halsband."

# game/scripts/c23/c23.rpy:1941
translate german c23s005_Mar_172f8095:

    # "Un par de minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c23/c23.rpy:1942
translate german c23s005_Mar_1ecafe17:

    # mom "Aquí estamos... Solo con el collar..."
    mom "Da sind wir also... Nur mit dem Halsband..."

# game/scripts/c23/c23.rpy:1943
translate german c23s005_Mar_e9a384b1:

    # mc "Es un collar precioso, pero me gusta mucho más el resto de ti."
    mc "Die Halskette ist wunderschön, aber der Rest von dir gefällt mir viel besser."

# game/scripts/c23/c23.rpy:1945
translate german c23s005_Mar_e7446202:

    # mom "Te va a parecer una tontería..."
    mom "Du wirst es für albern halten..."

# game/scripts/c23/c23.rpy:1946
translate german c23s005_Mar_ff0f72cd:

    # mc "¿El qué?"
    mc "Die Tatsache, dass?"

# game/scripts/c23/c23.rpy:1948
translate german c23s005_Mar_c37b1656:

    # mom "Quiero hacer el amor contigo esta noche..."
    mom "Ich möchte heute Nacht mit dir schlafen..."

# game/scripts/c23/c23.rpy:1949
translate german c23s005_Mar_3d47e4df:

    # mc "*Risa* No, no me parece una tontería."
    mc "*lacht* Nein, ich finde das nicht albern."

# game/scripts/c23/c23.rpy:1951
translate german c23s005_Mar_e8a84b31:

    # mom "*Risa* Calla y escucha..."
    mom "*Gelächter* Seid still und hört zu..."

# game/scripts/c23/c23.rpy:1953
translate german c23s005_Mar_6415efb1:

    # mom "Cuando lo hicimos la primera vez, era como la culminación de una noche perfecta y fue mágico..."
    mom "Als wir es das erste Mal taten, war es wie der Höhepunkt einer perfekten Nacht und es war magisch..."

# game/scripts/c23/c23.rpy:1954
translate german c23s005_Mar_dc9bf552:

    # mom "Hoy somos como una pareja normal... no sé cómo hacerlo sin que se pierda la magia."
    mom "Heute sind wir wie ein ganz normales Paar... Ich weiß nicht, wie ich das schaffen soll, ohne den Zauber zu verlieren."

# game/scripts/c23/c23.rpy:1955
translate german c23s005_Mar_4ce30d57:

    # mom "Sin que parezca algo programado..."
    mom "Ohne dass es so aussah, als wäre etwas geplant gewesen..."

# game/scripts/c23/c23.rpy:1956
translate german c23s005_Mar_fb980dbe:

    # mc "Bueno, creo que lo de pareja normal no se nos aplica demasiado."
    mc "Nun ja, ich glaube nicht, dass der Begriff „normales Paar“ wirklich auf uns zutrifft."

# game/scripts/c23/c23.rpy:1959
translate german c23s005_Mar_712254c7:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con mi hijo, pero me da lo mismo."
    mom "*Lacht* Du hast recht. Niemand würde es gutheißen, wenn ich mit meinem Sohn schlafen würde, aber das ist mir egal."

# game/scripts/c23/c23.rpy:1961
translate german c23s005_Mar_fd1ecd9f:

    # mom "*Risa* Tienes razón. Nadie vería bien que me acostara con el chico a quién he criado, pero me da lo mismo."
    mom "*Lacht* Du hast recht. Niemand würde es gutheißen, wenn ich mit dem Jungen schlafen würde, den ich großgezogen habe, aber das ist mir egal."

# game/scripts/c23/c23.rpy:1962
translate german c23s005_Mar_609eeb6e:

    # mc "No me refiero sólo a eso. ¿Crees que las parejas normales se plantean estas cosas tan pronto?"
    mc "Ich meine nicht nur das. Glaubst du, dass normale Paare solche Dinge schon so früh bedenken?"

# game/scripts/c23/c23.rpy:1963
translate german c23s005_Mar_54d66051:

    # mc "¿Que hablan en su segunda vez sobre no perder la magia?"
    mc "Worüber sprechen sie beim zweiten Mal, darüber, den Zauber nicht zu verlieren?"

# game/scripts/c23/c23.rpy:1965
translate german c23s005_Mar_470249da:

    # mom "Me preocupo demasiado, ¿verdad?"
    mom "Ich mache mir zu viele Sorgen, nicht wahr?"

# game/scripts/c23/c23.rpy:1966
translate german c23s005_Mar_54eef042:

    # mc "Un poco..."
    mc "Ein bisschen..."

# game/scripts/c23/c23.rpy:1967
translate german c23s005_Mar_92da2253:

    # mom "Es que no quiero que se convierta en algo rutinario, en plan \"Es sábado y toca sexo\"."
    mom "Ich möchte einfach nicht, dass es zur Routine wird, so nach dem Motto: „Es ist Samstag, Zeit für Sex.“"

# game/scripts/c23/c23.rpy:1968
translate german c23s005_Mar_6637b5c0:

    # mc "Si no lleváramos una vida tan ajetreada, seguramente sería \"Es una noche cualquiera y toca sexo\"."
    mc "Wenn wir nicht so ein geschäftiges Leben führen würden, hieße es wahrscheinlich: „Es ist nur eine weitere Nacht und es ist Zeit für Sex.“"

# game/scripts/c23/c23.rpy:1969
translate german c23s005_Mar_07e123ca:

    # mc "Llevo días queriendo bajar a dormir contigo, pero cuando no pasa una cosa, pasa otra."
    mc "Ich möchte schon seit Tagen zu dir runterkommen und mit dir schlafen, aber wenn das eine nicht klappt, passiert etwas anderes."

# game/scripts/c23/c23.rpy:1971
translate german c23s005_Mar_f9164bb5:

    # mc "O te veo cansada durante el día y quiero que tengas una buena noche de descanso."
    mc "Oder ich sehe, dass du tagsüber müde bist und möchte, dass du eine gute Nachtruhe hast."

# game/scripts/c23/c23.rpy:1972
translate german c23s005_Mar_862a3f45:

    # mom "Lo sé. Yo también he estado a punto de pedirte varias veces que vengas."
    mom "Ich weiß. Ich war auch schon mehrmals kurz davor, dich einzuladen."

# game/scripts/c23/c23.rpy:1973
translate german c23s005_Mar_46a99c1c:

    # mom "Ayer iba a subir a tu habitación pero..."
    mom "Ich wollte gestern eigentlich in dein Zimmer gehen, aber..."

# game/scripts/c23/c23.rpy:1975
translate german c23s005_Mar_9189a531:

    # mom "Me crucé con [sca] que iba a tu habitación en pijama."
    mom "Ich bin [sca] begegnet, der in seinem Schlafanzug auf dem Weg zu deinem Zimmer war."

# game/scripts/c23/c23.rpy:1977
translate german c23s005_Mar_694b034f:

    # mom "No podía hacer el esfuerzo de subir las escaleras."
    mom "Ich konnte mich nicht dazu aufraffen, die Treppe hinaufzusteigen."

# game/scripts/c23/c23.rpy:1978
translate german c23s005_Mar_5718e506:

    # mc "Bueno, hoy estamos aquí y nadie nos va a molestar."
    mc "Nun, wir sind heute hier und niemand wird uns stören."

# game/scripts/c23/c23.rpy:1981
translate german c23s005_Mar_ba39104e:

    # mc "Y hay mucha piel pidiendo ser acariciada..."
    mc "Und da ist so viel Haut, die nur darauf wartet, gestreichelt zu werden..."

# game/scripts/c23/c23.rpy:1982
translate german c23s005_Mar_a96da54c:

    # "En cuanto empiezas a recorrer su costado, apenas rozándola, puedes notar en la yema de tus dedos cómo a [mar] se le pone la piel de gallina."
    "Sobald du anfängst, mit den Fingern sanft über ihre Seite zu streichen, ohne sie auch nur leicht zu berühren, spürst du, wie sich [mar]s Haut mit Gänsehaut überzieht."

# game/scripts/c23/c23.rpy:1983
translate german c23s005_Mar_774e7cb8:

    # mom "Me encanta eso..."
    mom "Ich liebe das..."

# game/scripts/c23/c23.rpy:1985
translate german c23s005_Mar_6d7f7dc8:

    # "Tu madre se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "Deine Mutter schaudert jedes Mal, wenn du mit den Fingern über die Rundung ihrer Hüfte streichst oder wenn du mit den Fingern ihren Bauch bis zu ihrem Rücken entlangfährst."

# game/scripts/c23/c23.rpy:1987
translate german c23s005_Mar_3a9a845d:

    # "[mar] se estremece cada vez que pasas tus dedos por la curva de su cadera o cuando recorres su estómago en el camino de subida a su espalda."
    "[mar] Sie zuckt jedes Mal zusammen, wenn du mit den Fingern über die Rundung ihrer Hüfte fährst oder wenn du mit den Fingern ihren Bauch bis zu ihrem Rücken entlangfährst."

# game/scripts/c23/c23.rpy:1988
translate german c23s005_Mar_ef24df22:

    # mc "Lo estoy notando. Aquella noche no tuve mucho tiempo para explorar, quiero conocer cada rincón de tu piel."
    mc "Mir fällt es auf. In jener Nacht hatte ich nicht viel Zeit zum Erkunden; ich möchte jeden Zentimeter deiner Haut kennenlernen."

# game/scripts/c23/c23.rpy:1989
translate german c23s005_Mar_e4ba915d:

    # "Un estremecimiento vuelve a recorrer el cuerpo de la hermosa mujer, esta vez provocado por tus palabras en vez de por tus dedos."
    "Ein Schauer durchfährt erneut den Körper der schönen Frau, diesmal ausgelöst durch deine Worte statt durch deine Finger."

# game/scripts/c23/c23.rpy:1993
translate german c23s005_Mar_e236bd13:

    # mom "Me encanta que seas tan delicado siempre... Bueno, siempre que tienes que serlo."
    mom "Ich liebe es, dass du immer so sanft bist... Na ja, immer dann, wenn es nötig ist."

# game/scripts/c23/c23.rpy:1994
translate german c23s005_Mar_c5991eda:

    # "Su mirada se vuelve felina por momentos, empiezas a sentirte como se debe sentir la presa de un puma. Una presa voluntaria."
    "Sein Blick wird manchmal katzenhaft; man beginnt zu ahnen, wie es sich anfühlen muss, Beute eines Pumas zu sein. Willige Beute."

# game/scripts/c23/c23.rpy:1995
translate german c23s005_Mar_82eabf47:

    # mc "Tan solo soy tan delicado como mereces en cada momento. Ni un poco más ni un poco menos."
    mc "Ich bin genau so sanft, wie du es in jedem Augenblick verdienst. Nicht ein bisschen mehr, nicht ein bisschen weniger."

# game/scripts/c23/c23.rpy:1996
translate german c23s005_Mar_31801a03:

    # "Otro estremecimiento recorre su cuerpo, deseoso de caricias. Deseoso de delicadeza."
    "Ein weiterer Schauer durchfährt ihren Körper, Sehnsucht nach Liebkosungen. Sehnsucht nach Zärtlichkeit."

# game/scripts/c23/c23.rpy:1997
translate german c23s005_Mar_35bc0097:

    # mom "*Gemido* Pero todavía tienes mucha piel que conocer, no solo ese costado."
    mom "*Stöhn* Aber du hast noch viel Haut zu entdecken, nicht nur diese Seite."

# game/scripts/c23/c23.rpy:1998
translate german c23s005_Mar_8f53ac06:

    # mc "¿Ya te has cansado de mis caricias?"
    mc "Bist du meiner Liebkosungen schon überdrüssig geworden?"

# game/scripts/c23/c23.rpy:2001
translate german c23s005_Mar_71571ec5:

    # mom "No, hijo mío, pero yo también quiero que acaricies toda mi piel."
    mom "Nein, mein Sohn, aber ich möchte auch, dass du meine ganze Haut streichelst."

# game/scripts/c23/c23.rpy:2003
translate german c23s005_Mar_df3b1392:

    # mom "No, mi amor, pero yo también quiero que acaricies toda mi piel."
    mom "Nein, mein Schatz, aber ich möchte auch, dass du meine ganze Haut streichelst."

# game/scripts/c23/c23.rpy:2004
translate german c23s005_Mar_e07511f8:

    # mom "*Gemido* Si no lo haces tú, tendré que empezar yo a descubrir cada rincón de la tuya."
    mom "*Stöhn* Wenn du das nicht tust, muss ich wohl anfangen, jeden Winkel deines Hauses zu erkunden."

# game/scripts/c23/c23.rpy:2005
translate german c23s005_Mar_90d70d9d:

    # mc "*Risa* Hoy estás teniendo unas ideas excelentes, pero me parece que voy a seguir yo con mi exploración."
    mc "*Lacht* Du hast heute ein paar hervorragende Ideen, aber ich denke, ich werde meine Erkundungen fortsetzen."

# game/scripts/c23/c23.rpy:2006
translate german c23s005_Mar_79488545:

    # "Otro estremecimiento más. Esta vez producido por la anticipación."
    "Ein weiterer Schauer. Diesmal ausgelöst durch Vorfreude."

# game/scripts/c23/c23.rpy:2008
translate german c23s005_Mar_7f85be74:

    # "Tumbándola de espaldas, empiezas a recorrer su cuerpo con tu boca, tal como has prometido que harías."
    "Du legst sie auf den Rücken und beginnst, ihren Körper mit deinem Mund zu erkunden, genau wie du es ihr versprochen hast."

# game/scripts/c23/c23.rpy:2009
translate german c23s005_Mar_0d3a73f5:

    # mom "*Gemido* Me encanta sentir tus labios sobre mi piel. *Jadeo*"
    mom "*Stöhnen* Ich liebe es, deine Lippen auf meiner Haut zu spüren. *Keuchen*"

# game/scripts/c23/c23.rpy:2010
translate german c23s005_Mar_048a3dcc:

    # "Y tú disfrutas explorando cada rincón de su cuerpo. Cada lugar es un nuevo descubrimiento que atesoras para más tarde."
    "Und du genießt es, jeden Zentimeter ihres Körpers zu erkunden. Jeder Ort ist eine neue Entdeckung, die du für später in Ehren hältst."

# game/scripts/c23/c23.rpy:2011
translate german c23s005_Mar_8d6c0127:

    # mc "*Smooch* Una piel fantástica que no me voy a cansar de recorrer."
    mc "*Schmatz* Ein fantastischer Skin, den ich immer wieder gerne erkunde."

# game/scripts/c23/c23.rpy:2012
translate german c23s005_Mar_ae01bd62:

    # "Tomas notas mentales sobre qué zonas son más sensitivas para ella, es un conocimiento al que sacarás partido durante años."
    "Sie merken sich, welche Bereiche bei ihr am empfindlichsten sind; dieses Wissen wird Ihnen jahrelang zugutekommen."

# game/scripts/c23/c23.rpy:2014
translate german c23s005_Mar_5c66f73f:

    # "No sólo tus labios recorren su cuerpo, sino que tus manos también lo hacen al mismo tiempo."
    "Nicht nur deine Lippen wandern über ihren Körper, sondern gleichzeitig tun es auch deine Hände."

# game/scripts/c23/c23.rpy:2015
translate german c23s005_Mar_efca7294:

    # mom "*Jadeo* Me estás volviendo loca... *Gemido* Y aún no has tocado lo más sensible. *Jadeo*"
    mom "*Keuchen* Du machst mich wahnsinnig... *Stöhnen* Und du hast noch nicht mal die empfindlichste Stelle berührt. *Keuchen*"

# game/scripts/c23/c23.rpy:2016
translate german c23s005_Mar_a444c619:

    # "Miente. Cada trozo de su piel es más sensible que el anterior. Cada estremecimiento es mayor que el que la ha recorrido un segundo antes."
    "Sie lügt. Jede Stelle ihrer Haut ist empfindlicher als die vorherige. Jeder Schauer ist stärker als der, der sie eine Sekunde zuvor durchfuhr."

# game/scripts/c23/c23.rpy:2017
translate german c23s005_Mar_7d703def:

    # mom "*Gemido* Voy a necesitarte dentro... *Jadeo* No puedo aguantar más. *Gemido*"
    mom "*Stöhnen* Ich brauche dich in mir... *Keuchen* Ich kann nicht länger an mich halten. *Stöhnen*"

# game/scripts/c23/c23.rpy:2018
translate german c23s005_Mar_d65c5420:

    # "Todo lo bueno se acaba. Lo mejor está por llegar."
    "Alles Schöne hat ein Ende. Das Beste kommt erst noch."

# game/scripts/c23/c23.rpy:2020
translate german c23s005_Mar_ae412d67:

    # "[mar] te da la vuelta sin saber muy bien cómo lo ha hecho. Te tumba de espaldas y se sienta encima tuyo."
    "[mar] Er dreht dich um, ohne genau zu wissen, wie er es angestellt hat. Er legt dich auf den Rücken und setzt sich auf dich."

# game/scripts/c23/c23.rpy:2021
translate german c23s005_Mar_f6f48287:

    # mom "*Risita* Estar cachonda me da fuerzas. No creía que pudiera tumbarte así."
    mom "*Kichert* Meine Geilheit gibt mir Kraft. Ich hätte nicht gedacht, dass ich dich so umhauen könnte."

# game/scripts/c23/c23.rpy:2022
translate german c23s005_Mar_c3157580:

