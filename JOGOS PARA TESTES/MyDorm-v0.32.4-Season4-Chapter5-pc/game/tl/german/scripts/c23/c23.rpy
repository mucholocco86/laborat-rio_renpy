# game/scripts/c23/c23.rpy:1217
translate german c23s003_Eil_2a56a4fa:

    # mc "O te la quitas tú o te la quito yo. *Risa* Puedes elegir."
    mc "Entweder du ziehst es aus oder ich ziehe es aus. *Lacht* Du hast die Wahl."

# game/scripts/c23/c23.rpy:1218
translate german c23s003_Eil_4007b016:

