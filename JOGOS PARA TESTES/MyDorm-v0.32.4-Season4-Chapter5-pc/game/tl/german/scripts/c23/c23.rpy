# game/scripts/c23/c23.rpy:2448
translate german c23s005_sleep_3841ab1d:

    # mom "Se hace tarde y estoy un poco cansada. ¿Me abrazas un rato y dormimos? Aunque digas que no es necesario, tú tienes que dormir."
    mom "Es wird spät und ich bin etwas müde. Willst du mich noch ein bisschen in den Arm nehmen und mit mir schlafen? Auch wenn du sagst, es sei nicht nötig, du musst schlafen."

# game/scripts/c23/c23.rpy:2449
translate german c23s005_sleep_d486a74d:

    # mc "Sí, no tengo sueño, pero estoy seguro de que yo también me dormiré en cuanto te duermas tú."
    mc "Ja, ich bin noch nicht müde, aber ich bin sicher, dass ich einschlafen werde, sobald du einschläfst."

# game/scripts/c23/c23.rpy:2450
translate german c23s005_sleep_8b301607:

    # mc "Después de mirarte un rato, claro. Estás preciosa mientras duermes."
    mc "Nachdem ich dich eine Weile betrachtet habe, natürlich. Du siehst wunderschön aus, selbst im Schlaf."

# game/scripts/c23/c23.rpy:2452
translate german c23s005_sleep_07f9dcda:

    # mom "{b}¿Me miras mientras duermo? ¡Qué vergüenza!{/b}"
    mom "{b}Beobachtest du mich etwa beim Schlafen? Wie peinlich!{/b}"

# game/scripts/c23/c23.rpy:2453
translate german c23s005_sleep_d9e2c790:

    # mom "Seguro que pongo caras raras y se me cae la baba."
    mom "Ich werde bestimmt komische Grimassen schneiden und sabbern."

# game/scripts/c23/c23.rpy:2454
translate german c23s005_sleep_fca11622:

    # mc "No te preocupes. Te acabo de decir que estás preciosa mientras duermes. Y no se te cae la baba. *Risa*"
    mc "Keine Sorge. Ich hab dir doch gerade gesagt, dass du im Schlaf wunderschön aussiehst. Und du sabberst nicht. *lacht*"

# game/scripts/c23/c23.rpy:2456
translate german c23s005_sleep_7b4a143c:

    # mom "Vale, te creo. ¿Puedo quitarme el collar ya?"
    mom "Okay, ich glaube dir. Darf ich das Halsband jetzt abnehmen?"

# game/scripts/c23/c23.rpy:2457
translate german c23s005_sleep_b41300ea:

    # mc "Sí, no se vaya a romper, o a clavártelo mientras duermes."
    mc "Ja, damit es nicht kaputt geht oder dich im Schlaf durchbohrt."

# game/scripts/c23/c23.rpy:2459
translate german c23s005_sleep_624a2e97:

    # "Unos minutos después, tras pasar por el baño..."
    "Ein paar Minuten später, nachdem ich auf der Toilette war..."

# game/scripts/c23/c23.rpy:2460
translate german c23s005_sleep_1161a6bb:

    # mom "Buenas noches, mi amor."
    mom "Gute Nacht, mein Schatz."

# game/scripts/c23/c23.rpy:2462
translate german c23s005_sleep_3fa2fdd3:

    # mc "Buenas noches, Mamá."
    mc "Gute Nacht, Mama."

# game/scripts/c23/c23.rpy:2464
translate german c23s005_sleep_f5d6526d:

    # mc "Buenas noches, [mar.name.lewd]."
    mc "Guten Abend, [mar.name.lewd]."

# game/scripts/c23/c23.rpy:2466
translate german c23s005_sleep_faee5269:

    # "Vuestros labios se unen en un dulce beso de buenas noches que cierra con un broche dorado una noche perfecta."
    "Eure Lippen treffen sich zu einem süßen Gute-Nacht-Kuss, der eine perfekte Nacht mit einem goldenen Hauch abrundet."

# game/scripts/c23/c23.rpy:2467
translate german c23s005_sleep_2d3205c3:

    # "Ahora te toca una de las mejores partes. Dormir abrazado a la mujer más maravillosa del mundo. Porque no hay otra mujer en el mundo."
    "Und nun kommt der schönste Teil: In den Armen der wundervollsten Frau der Welt einzuschlafen. Denn es gibt keine andere Frau auf der Welt."

# game/scripts/c23/c23.rpy:2469
translate german c23s005_sleep_2bd7f903:

    # "Apagáis la luz y os tumbáis a dormir. Tal como has dicho, [mar] está preciosa mientras duerme."
    "Du schaltest das Licht aus und legst dich schlafen. Genau wie du gesagt hast, ist [mar] wunderschön, während sie schläft."

# game/scripts/c23/c23.rpy:2470
translate german c23s005_sleep_408c669c:

    # mom "*Voz adormilada* No me mires..."
    mom "*Verschlafene Stimme* Schau mich nicht an..."

# game/scripts/c23/c23.rpy:2471
translate german c23s005_sleep_b87815ac:

    # "No le piensas hacer caso. Es una visión que quieres grabar en tus retinas."
    "Du wirst ihm nicht zuhören. Es ist ein Anblick, den du dir für immer einprägen willst."

# game/scripts/c23/c23.rpy:2473
translate german c23s005_sleep_fbe5dfe9:

    # "La miras hasta que, sin darte cuenta, se te cierran los ojos."
    "Du schaust sie an, bis sich deine Augen, ohne dass du es merkst, schließen."

# game/scripts/c23/c23.rpy:2475
translate german c23s005_sleep_e0bf00dc:

    # "Duermes plácidamente toda la noche sin recordar tus sueños..."
    "Du schläfst die ganze Nacht friedlich, ohne dich an deine Träume zu erinnern..."

# game/scripts/c23/c23.rpy:2478
translate german c23s005_Emm_b3f31ca1:

    # centered "{size=+20}{b}DÍA 24 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}TAG 24 – DONNERSTAG{/b}{/size}"

# game/scripts/c23/c23.rpy:2480
translate german c23s005_Emm_ec286efa:

    # "... Hasta que la puerta se abre de golpe y alguien enciende la luz."
    "...Bis die Tür aufspringt und jemand das Licht anknipst."

# game/scripts/c23/c23.rpy:2482
translate german c23s005_Emm_58e0ed1f:

    # emm "¡Despertad! ¡Nos tenemos que ir!"
    emm "Aufwachen! Wir müssen los!"

# game/scripts/c23/c23.rpy:2483
translate german c23s005_Emm_4102bb2b:

    # "OK. Ya estás despierto. Y sobresaltado."
    "Okay. Du bist jetzt wach. Und erschrocken."

# game/scripts/c23/c23.rpy:2485
translate german c23s005_Emm_731dbbe0:

    # mom "¿Qué hora es, [emm]? No he oído el despertador."
    mom "Wie spät ist es, [emm]? Ich habe den Wecker nicht gehört."

# game/scripts/c23/c23.rpy:2486
translate german c23s005_Emm_01b992b8:

    # "En algún momento, durante la noche, [mar] se ha tapado con el edredón."
    "Irgendwann in der Nacht deckte sich [mar] mit der Bettdecke zu."

# game/scripts/c23/c23.rpy:2488
translate german c23s005_Emm_1b146ec7:

    # emm "Las 6:00 AM. Llevo más de una hora despierta conteniéndome para no subir a la habitación de [mc]. Y resulta que estaba aquí."
    emm "6:00 Uhr morgens. Ich bin schon über eine Stunde wach und habe mich zurückgehalten, zu [mc]s Zimmer hochzugehen. Und siehe da, er war hier."

# game/scripts/c23/c23.rpy:2491
translate german c23s005_Emm_18ac9830:

    # emm "¡Y no me habéis invitado! Pero os lo perdono porque hoy estoy emocionada con el viaje."
    emm "Und du hast mich nicht eingeladen! Aber ich verzeihe dir, weil ich mich so sehr auf den heutigen Ausflug freue."

# game/scripts/c23/c23.rpy:2492
translate german c23s005_Emm_8f31b5b2:

    # emm "Pero si no os levantáis ya, se va a hacer tarde."
    emm "Aber wenn du jetzt nicht aufstehst, wird es spät."

# game/scripts/c23/c23.rpy:2493
translate german c23s005_Emm_8e3d2868:

    # mc "[emm], dijimos que saldríamos de aquí a las 8:00. Había puesto el despertador a las 7:15."
    mc "[emm], wir hatten gesagt, wir würden um 8:00 Uhr von hier abfahren. Ich hatte meinen Wecker auf 7:15 Uhr gestellt."

# game/scripts/c23/c23.rpy:2495
translate german c23s005_Emm_cbf421e0:

    # emm "Y en 45 minutos ibas a ducharte..."
    emm "Und in 45 Minuten wolltest du duschen gehen..."

# game/scripts/c23/c23.rpy:2496
translate german c23s005_Emm_f4b84d41:

    # mc "Me duché anoche..."
    mc "Ich habe gestern Abend geduscht..."

# game/scripts/c23/c23.rpy:2497
translate german c23s005_Emm_d664759d:

    # emm "A vestirte..."
    emm "Zieh dich an..."

# game/scripts/c23/c23.rpy:2498
translate german c23s005_Emm_82b3011a:

    # mc "Soy un hombre. Necesito menos de cinco minutos. Cinco minutos reales..."
    mc "Ich bin ein Mann. Ich brauche weniger als fünf Minuten. Fünf echte Minuten..."

# game/scripts/c23/c23.rpy:2499
translate german c23s005_Emm_d6f2a180:

    # emm "Y a desayunar..."
    emm "Und Zeit fürs Frühstück..."

# game/scripts/c23/c23.rpy:2500
translate german c23s005_Emm_9d17b426:

    # mc "Para eso eran 30 de los 45 minutos. *Risa*"
    mc "Dafür waren 30 der 45 Minuten gedacht. *Gelächter*"

# game/scripts/c23/c23.rpy:2501
translate german c23s005_Emm_711c7675:

    # mc "Puedes ir preparando el café, si quieres ir avanzando."
    mc "Wenn Sie loslegen möchten, können Sie schon mal mit der Kaffeezubereitung beginnen."

# game/scripts/c23/c23.rpy:2503
translate german c23s005_Emm_54e1c1b6:

    # mom "No os preocupéis por el desayuno. Ya lo preparo yo mientras te vistes."
    mom "Mach dir keine Sorgen ums Frühstück. Ich bereite es vor, während du dich anziehst."

# game/scripts/c23/c23.rpy:2504
translate german c23s005_Emm_e3ab73bc:

    # mom "De todas formas mi despertador iba a sonar en 15 minutos para prepararlo."
    mom "Jedenfalls sollte mein Wecker in 15 Minuten klingeln, damit ich mich fertig machen konnte."

# game/scripts/c23/c23.rpy:2506
translate german c23s005_Emm_15b05d64:

    # emm "Mamá, eres la mejor. Sabía que no ibas a dejar que nos fuéramos con sólo un trozo de tarta de ayer en el estómago."
    emm "Mama, du bist die Beste. Ich wusste, du würdest uns nicht mit nur einem Stück Kuchen von gestern im Bauch gehen lassen."

# game/scripts/c23/c23.rpy:2507
translate german c23s005_Emm_e096a202:

    # mc "Vale, [emm]... ¿Tía [bet] ya está despierta?"
    mc "Okay, [emm]... Ist Tante [bet] schon wach?"

# game/scripts/c23/c23.rpy:2509
translate german c23s005_Emm_4cd12029:

    # emm "¡No lo sé! ¡Aún no he ido a verla!"
    emm "Ich weiß es nicht! Ich habe sie noch nicht besucht!"

# game/scripts/c23/c23.rpy:2510
translate german c23s005_Emm_3a7569c9:

    # mc "¿A qué esperas? Es una mujer y va a tardar más en vestirse que yo."
    mc "Worauf wartest du noch? Sie ist eine Frau und braucht länger zum Anziehen als ich."

# game/scripts/c23/c23.rpy:2511
translate german c23s005_Emm_ec138f56:

    # emm "¡Tienes razón! ¡Me voy!"
    emm "Du hast recht! Ich gehe!"

# game/scripts/c23/c23.rpy:2514
translate german c23s005_Emm_6e734612:

    # "*Blam*"
    "*Bumm*"

# game/scripts/c23/c23.rpy:2516
translate german c23s005_Emm_80ab0291:

    # emm "*A través de la puerta* ¡Lo tengo que hacer todo yo!"
    emm "*Durch die Tür* Ich muss alles selbst machen!"

# game/scripts/c23/c23.rpy:2518
translate german c23s005_Emm_f7f4d563:

    # mc "Y se fue. Voy a vestirme y a ayudarte a preparar el desayuno."
    mc "Und sie ging. Ich werde mich anziehen und dir beim Frühstückmachen helfen."

# game/scripts/c23/c23.rpy:2520
translate german c23s005_Emm_232a26e2:

    # mom "No es necesario, puedes dormir un rato más, si quieres. ¿Te levanto dentro de 30 minutos?"
    mom "Das ist nicht nötig, du kannst gerne noch etwas länger schlafen. Soll ich dich in 30 Minuten wecken?"

# game/scripts/c23/c23.rpy:2521
translate german c23s005_Emm_beeb27c0:

    # mc "No voy a poder dormirme otra vez si no estás aquí."
    mc "Ich werde nicht wieder einschlafen können, wenn du nicht da bist."

# game/scripts/c23/c23.rpy:2522
translate german c23s005_Emm_f104feef:

    # mc "Me va a faltar tu peso sobre mi pecho."
    mc "Ich werde dein Gewicht auf meiner Brust vermissen."

# game/scripts/c23/c23.rpy:2524
translate german c23s005_Emm_7b679049:

    # "[mar] te besa apasionadamente por sorpresa. Te podrías acostumbrar a despertarte así todos los días."
    "[mar] Er küsst dich leidenschaftlich und unerwartet. Du könntest dich daran gewöhnen, jeden Tag so aufzuwachen."

# game/scripts/c23/c23.rpy:2526
translate german c23s005_Emm_e4df2143:

    # mom "Entonces sube a vestirte y ven a la cocina."
    mom "Dann geh nach oben, zieh dich an und komm in die Küche."

# game/scripts/c23/c23.rpy:2542
translate german c23s006_AfterBreakfastBetConfession_6b8dfbb6:

    # "Después de desayunar bajas las {b}tres{/b} maletas de [emm] a la camioneta."
    "Nach dem Frühstück bringst du die drei Koffer von C2 zum Van."

# game/scripts/c23/c23.rpy:2543
translate german c23s006_AfterBreakfastBetConfession_79e3a8e3:

    # "[bet] solo lleva una maleta pequeña, donde lleva el hábito y otras cosas más normales."
    "[bet] Sie trägt nur einen kleinen Koffer bei sich, in dem sie ihre Gewohnheit und andere alltägliche Dinge aufbewahrt."

# game/scripts/c23/c23.rpy:2544
translate german c23s006_AfterBreakfastBetConfession_a6fd427d:

    # "Tú sólo llevas tu mochila."
    "Du trägst nur deinen Rucksack."

# game/scripts/c23/c23.rpy:2547
translate german c23s006_AfterBreakfastBetConfession_22f01abd:

    # mom "No corras. Conduce con cuidado. Haz un par de paradas a medio camino para descansar..."
    mom "Fahren Sie nicht zu schnell. Fahren Sie vorsichtig. Machen Sie unterwegs ein paar Pausen, um sich auszuruhen..."

# game/scripts/c23/c23.rpy:2548
translate german c23s006_AfterBreakfastBetConfession_32ff118e:

    # mc "No te preocupes, en cuanto lleguemos te llamo para decirte que hemos llegado bien. Espera la llamada alrededor de la hora de comer."
    mc "Keine Sorge, ich rufe dich an, sobald wir angekommen sind, um dir Bescheid zu geben, dass wir sicher angekommen sind. Du kannst mit dem Anruf gegen Mittag rechnen."

# game/scripts/c23/c23.rpy:2550
translate german c23s006_AfterBreakfastBetConfession_a2652fb6:

    # mom "¿Tan tarde?"
    mom "So spät?"

# game/scripts/c23/c23.rpy:2551
translate german c23s006_AfterBreakfastBetConfession_c2eaf91d:

    # mc "Cuando lleguemos tenemos que ir a alquilar el coche y después tengo que llevar a Tía [bet]."
    mc "Wenn wir ankommen, müssen wir das Auto mieten und dann muss ich Tante [bet] mitnehmen."

# game/scripts/c23/c23.rpy:2552
translate german c23s006_AfterBreakfastBetConfession_fa66d2bd:

    # mc "Mejor que la esperes tarde y te llame antes, a que la esperes pronto y me retrase."
    mc "Es ist besser, wenn du sie verspätest und sie dich früher anruft, als dass du sie früh erwartest und ich mich verspäte."

# game/scripts/c23/c23.rpy:2555
translate german c23s006_AfterBreakfastBetConfession_e0795c02:

    # mom "Hasta mañana, mi amor."
    mom "Bis morgen, meine Liebe."

# game/scripts/c23/c23.rpy:2558
translate german c23s006_AfterBreakfastBetConfession_58ac1d50:

    # mom "Hasta mañana, [mc]."
    mom "Bis morgen, [mc]."

# game/scripts/c23/c23.rpy:2559
translate german c23s006_AfterBreakfastBetConfession_6bb4321b:

    # mc "No te preocupes por nada. Vamos dos adultos... y [emm]. Hasta mañana."
    mc "Mach dir keine Sorgen. Da sind zwei Erwachsene... und [emm]. Bis morgen."

# game/scripts/c23/c23.rpy:2562
translate german c23s006_AfterBreakfastBetConfession_b53a8c44:

    # "Al cabo de unos minutos, sospechosamente cuando todas las maletas ya están cargadas, aparece [emm]."
    "Nach ein paar Minuten, verdächtigerweise wenn alle Koffer bereits verladen sind, erscheint [emm]."

# game/scripts/c23/c23.rpy:2564
translate german c23s006_AfterBreakfastBetConfession_98dad1eb:

    # emm "¡Me pido el asiento de atrás! Así podré echar una cabezada por el camino."
    emm "Ich nehme den Rücksitz! So kann ich unterwegs ein Nickerchen machen."

# game/scripts/c23/c23.rpy:2565
translate german c23s006_AfterBreakfastBetConfession_ad278a8e:

    # mc "No esperarás ir tumbada, ¿verdad?"
    mc "Du erwartest doch nicht, dass du dich einfach hinlegen kannst, oder?"

# game/scripts/c23/c23.rpy:2567
translate german c23s006_AfterBreakfastBetConfession_2f1b87bd:

    # emm "Claro que sí. He dormido muy poco..."
    emm "Natürlich. Ich habe sehr wenig geschlafen..."

# game/scripts/c23/c23.rpy:2568
translate german c23s006_AfterBreakfastBetConfession_1baf40e6:

    # mcp "(Y has dejado dormir poco a los demás.)"
    mcp "(Und du hast den anderen sehr wenig Schlaf gegönnt.)"

# game/scripts/c23/c23.rpy:2569
translate german c23s006_AfterBreakfastBetConfession_f7a399a1:

    # emm "Y no me vengas con que si frenas de golpe me voy a caer del asiento. Conduces como una abuelita."
    emm "Und sag mir nicht, dass ich aus dem Sitz falle, wenn du plötzlich bremst. Du fährst wie eine Oma."

# game/scripts/c23/c23.rpy:2570
translate german c23s006_AfterBreakfastBetConfession_5ddd15d0:

    # mc "Era precisamente lo que te iba a decir. *Risa* Bueno, excepto lo de la abuelita."
    mc "Das wollte ich dir auch gerade erzählen. *lacht* Na ja, bis auf die Sache mit Oma."

# game/scripts/c23/c23.rpy:2572
translate german c23s006_AfterBreakfastBetConfession_8e89c4e6:

    # emm "¡Pero no puedo dormir sentada! ¡Siempre acabo con dolor de cuello y de mal humor!"
    emm "Aber ich kann nicht im Sitzen schlafen! Ich bekomme dann immer Nackenschmerzen und bin schlecht gelaunt!"

# game/scripts/c23/c23.rpy:2573
translate german c23s006_AfterBreakfastBetConfession_a041378f:

    # emm "Y eso me va a estropear el día."
    emm "Und das wird mir den Tag verderben."

# game/scripts/c23/c23.rpy:2574
translate german c23s006_AfterBreakfastBetConfession_191006ce:

    # mc "Lo que me extraña es que no estés de mal humor por haber tenido que levantarte temprano. *Risa*"
    mc "Mich überrascht, dass du nicht schlecht gelaunt bist, weil du früh aufstehen musst. *lacht*"

# game/scripts/c23/c23.rpy:2576
translate german c23s006_AfterBreakfastBetConfession_e6d83b0e:

    # emm "¡Hoy había una buena razón para hacerlo!"
    emm "Heute gab es dafür einen guten Grund!"

# game/scripts/c23/c23.rpy:2577
translate german c23s006_AfterBreakfastBetConfession_6a65be27:

    # mc "Bueno, por ahí viene Tía [bet]. Ya nos podemos ir."
    mc "Okay, da kommt Tante [bet]. Wir können jetzt gehen."

# game/scripts/c23/c23.rpy:2579
translate german c23s006_AfterBreakfastBetConfession_60cd69d7:

    # "Tras unas cuantas despedidas más, por fin os ponéis en camino."
    "Nach ein paar weiteren Abschieden brachen Sie schließlich auf."

# game/scripts/c23/c23.rpy:2580
translate german c23s006_AfterBreakfastBetConfession_acd46f2a:

    # "Por suerte habéis salido con tiempo. Había unas obras en la carretera antes de llegar a Atascadero que os han retrasado un poco."
    "Zum Glück sind Sie mit genügend Zeit losgefahren. Vor Atascadero gab es Straßenbauarbeiten, die Ihre Fahrt etwas verzögert haben."

# game/scripts/c23/c23.rpy:2582
translate german c23s006_AfterBreakfastBetConfession_a38307b1:

    # "Aún vais bien de tiempo."
    "Sie haben noch ausreichend Zeit."

# game/scripts/c23/c23.rpy:2585
translate german c23s006_AfterBreakfastBetConfession_75d8b8da:

    # emm "¿Cómo estás, Tía [bet]? ¿Nerviosa?"
    emm "Wie geht es dir, Tante [bet]? Nervös?"

# game/scripts/c23/c23.rpy:2587
translate german c23s006_AfterBreakfastBetConfession_f3201952:

    # mcp "(Extrañamente [emm] se preocupa por otras personas en un día importante para ella. ¿Habrá entendido lo que significa la empatía?)"
    mcp "(Seltsamerweise macht sich [emm] an einem für sie wichtigen Tag Sorgen um andere Menschen. Hat sie endlich die Bedeutung von Empathie begriffen?)"

# game/scripts/c23/c23.rpy:2589
translate german c23s006_AfterBreakfastBetConfession_9823ca60:

    # bet "Sí, estoy nerviosa. No tengo ni idea de qué va a pasar en esa reunión, pero no soy capaz de encontrar ningún escenario bueno para mí."
    bet "Ja, ich bin nervös. Ich habe keine Ahnung, was bei diesem Treffen passieren wird, aber ich kann mir kein Szenario vorstellen, das für mich gut wäre."

# game/scripts/c23/c23.rpy:2590
translate german c23s006_AfterBreakfastBetConfession_6d5eb0ec:

    # mc "El mejor escenario para ti sería que te destinasen a otro hospital en África, en otro país, ¿no?"
    mc "Das beste Szenario für Sie wäre eine Versetzung in ein anderes Krankenhaus in Afrika, in ein anderes Land, nicht wahr?"

# game/scripts/c23/c23.rpy:2592
translate german c23s006_AfterBreakfastBetConfession_5d599fd4:

    # emm "Eso no, Tía. Nadie quiere que te vayas ahora que te conocemos mejor y que la abuela se va a mudar aquí."
    emm "Nein, Tante. Niemand möchte, dass du gehst, jetzt, wo wir dich besser kennen und Oma hierher zieht."

# game/scripts/c23/c23.rpy:2593
translate german c23s006_AfterBreakfastBetConfession_65730c64:

    # mc "Pero no tenemos que ser egoístas, [emm]. Yo tampoco quiero que se vaya, pero si es lo que quiere ella..."
    mc "Aber wir müssen nicht egoistisch sein. Ich möchte auch nicht, dass sie geht, aber wenn sie das möchte …"

# game/scripts/c23/c23.rpy:2595
translate german c23s006_AfterBreakfastBetConfession_17d2fc40:

    # bet "Gracias, chicos. Realmente aún no sé lo que quiero. Me gustaría volver a África."
    bet "Danke euch. Ich weiß noch nicht genau, was ich will. Ich würde gerne nach Afrika zurückkehren."

# game/scripts/c23/c23.rpy:2596
translate german c23s006_AfterBreakfastBetConfession_9408a313:

    # bet "Pero también me gustaría quedarme por aquí y trabajar en algún hospital que me permita veros más a menudo."
    bet "Ich würde aber auch gerne hierbleiben und in einem Krankenhaus arbeiten, das es mir ermöglichen würde, Sie öfter zu sehen."

# game/scripts/c23/c23.rpy:2597
translate german c23s006_AfterBreakfastBetConfession_a8285983:

    # bet "Incluso hay un par de hospitales católicos cerca de casa donde podría trabajar sin mudarme de Newport."
    bet "Es gibt sogar ein paar katholische Krankenhäuser in der Nähe meines Wohnorts, wo ich arbeiten könnte, ohne Newport verlassen zu müssen."

# game/scripts/c23/c23.rpy:2598
translate german c23s006_AfterBreakfastBetConfession_7409e022:

    # mc "Eso sería fantástico. Nadie quiere que te vayas de casa, pero todos lo entenderíamos si decidieras volver a África."
    mc "Das wäre fantastisch. Niemand möchte, dass du dein Zuhause verlässt, aber wir würden es alle verstehen, wenn du dich entscheiden würdest, nach Afrika zurückzukehren."

# game/scripts/c23/c23.rpy:2599
translate german c23s006_AfterBreakfastBetConfession_927f1ed8:

    # mc "Bueno, quizás todos menos [emm]. *Risa*"
    mc "Nun ja, vielleicht alle außer [emm]. *lacht*"

# game/scripts/c23/c23.rpy:2601
translate german c23s006_AfterBreakfastBetConfession_219cca74:

    # emm "*Risa* Ni siquiera que gastes bromas sobre mí va a poder estropearme el día."
    emm "*Lacht* Nicht mal deine Witze über mich werden mir den Tag verderben."

# game/scripts/c23/c23.rpy:2602
translate german c23s006_AfterBreakfastBetConfession_6b3f5e74:

    # mc "Nunca querría estropearte el día, hermanita. Además, tengo una sorpresa para ti, para cuando lleguemos a Monterey."
    mc "Ich möchte dir niemals den Tag verderben, kleine Schwester. Außerdem habe ich eine Überraschung für dich, wenn wir in Monterey ankommen."

# game/scripts/c23/c23.rpy:2604
translate german c23s006_AfterBreakfastBetConfession_5ffbefca:

    # emm "¿Qué es?"
    emm "Was ist das?"

# game/scripts/c23/c23.rpy:2605
translate german c23s006_AfterBreakfastBetConfession_67e6de57:

    # mc "No te lo voy a decir. Si te lo dijera, ya no sería una sorpresa."
    mc "Ich werde es dir nicht sagen. Wenn ich es täte, wäre es ja keine Überraschung mehr."

# game/scripts/c23/c23.rpy:2607
translate german c23s006_AfterBreakfastBetConfession_44cef866:

    # emm "Decirme que tienes una sorpresa para mí y no decirme qué es... Eso sí que podría estropearme el día..."
    emm "Mir zu sagen, dass du eine Überraschung für mich hast, und mir dann nicht zu sagen, was es ist... Das könnte mir echt den Tag verderben..."

# game/scripts/c23/c23.rpy:2608
translate german c23s006_AfterBreakfastBetConfession_d51f57a2:

    # mc "Los chantajes emocionales no sirven conmigo, [emm]."
    mc "Emotionale Erpressung funktioniert bei mir nicht, [emm]."

# game/scripts/c23/c23.rpy:2610
translate german c23s006_AfterBreakfastBetConfession_b8004bc0:

    # bet "Pero la chica lo tenía que intentar. *Risa*"
    bet "Aber das Mädchen musste es versuchen. *lacht*"

# game/scripts/c23/c23.rpy:2613
translate german c23s006_AfterBreakfastBetConfession_ddf38903:

    # bet "Si eso no funciona, siempre puedes amenazarle con castigarle sin sexo. *Risa* A otras mujeres les funciona."
    bet "Wenn das nicht hilft, kannst du ihm immer noch drohen, ihn mit Sexentzug zu bestrafen. *lacht* Bei anderen Frauen klappt's ja auch."

# game/scripts/c23/c23.rpy:2615
translate german c23s006_AfterBreakfastBetConfession_7a2d7a04:

    # emm "¡Eso no! ¡Eso sería más castigo para mí que para él!"
    emm "Nein! Das wäre eher eine Strafe für mich als für ihn!"

# game/scripts/c23/c23.rpy:2616
translate german c23s006_AfterBreakfastBetConfession_f92c1d53:

    # mc "*Risa* Además, tampoco funcionaría."
    mc "*Gelächter* Außerdem würde es auch nicht funktionieren."

# game/scripts/c23/c23.rpy:2618
translate german c23s006_AfterBreakfastBetConfession_69504a21:

    # bet "¿Y tú que quieres hacer con el coche? ¿Quieres ir a algún sitio en particular o sólo conducir donde la carretera te lleve?"
    bet "Und was möchten Sie mit dem Auto unternehmen? Wollen Sie irgendwohin fahren oder einfach ziellos umherirren?"

# game/scripts/c23/c23.rpy:2620
translate german c23s006_AfterBreakfastBetConfession_5f56d875:

    # emm "Había pensado en ir a ver Carmel, he leído que es bonito, y me gustaría hacer unas fotos."
    emm "Ich hatte überlegt, nach Carmel zu fahren; ich habe gelesen, dass es wunderschön ist, und ich würde gerne ein paar Fotos machen."

# game/scripts/c23/c23.rpy:2621
translate german c23s006_AfterBreakfastBetConfession_990a559a:

    # mc "Creo que hoy no tendremos mucho tiempo para hacer turismo."
    mc "Ich glaube nicht, dass wir heute viel Zeit für Besichtigungen haben werden."

# game/scripts/c23/c23.rpy:2623
translate german c23s006_AfterBreakfastBetConfession_37ddc11a:

    # emm "Lo sé. Y mañana tampoco si tenemos que devolver el coche a mediodía."
    emm "Ich weiß. Und auch nicht morgen, wenn wir den Wagen mittags zurückgeben müssen."

# game/scripts/c23/c23.rpy:2624
translate german c23s006_AfterBreakfastBetConfession_1f4d80be:

    # mc "Bueno, si no podemos ir a Carmel, te prometo que te llevaré un día cuando vuelva de Aruba."
    mc "Nun, wenn wir nicht nach Carmel fahren können, verspreche ich dir, dass ich dich eines Tages dorthin mitnehme, wenn ich von Aruba zurückkomme."

# game/scripts/c23/c23.rpy:2625
translate german c23s006_AfterBreakfastBetConfession_62ca9199:

    # emm "Me parece bien. Y ahora voy a dormir un poco."
    emm "Das klingt gut. Und jetzt werde ich schlafen gehen."

# game/scripts/c23/c23.rpy:2626
translate german c23s006_AfterBreakfastBetConfession_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c23/c23.rpy:2628
translate german c23s006_AfterBreakfastBetConfession_0740b24c:

    # bet "No la pongas de mal humor discutiendo con ella por una causa perdida, [mc]."
    bet "Verärgere sie nicht, indem du mit ihr über eine aussichtslose Sache streitest, [mc]."

# game/scripts/c23/c23.rpy:2629
translate german c23s006_AfterBreakfastBetConfession_6c170086:

    # mc "Tienes razón. Va a hacer lo que quiera..."
    mc "Du hast Recht. Er wird tun, was er will..."

# game/scripts/c23/c23.rpy:2631
translate german c23s006_AfterBreakfastBetConfession_ae119aa5:

    # emm "Exacto. *Risita* Pero te haré caso y no me tumbaré. Si das un frenazo, voy a acabar con mi cara en el culo de Tía [bet]."
    emm "Genau. *Kichert* Aber ich höre auf dich und lege mich nicht hin. Wenn du voll in die Bremsen trittst, lande ich mit dem Gesicht in Tante Tantes Hintern [bet]."

# game/scripts/c23/c23.rpy:2632
translate german c23s006_AfterBreakfastBetConfession_423c7e85:

    # emm "Despertadme antes de llegar, o si paramos para tomar un café."
    emm "Weck mich, bevor wir ankommen, oder falls wir einen Kaffeestopp einlegen."

# game/scripts/c23/c23.rpy:2633
translate german c23s006_AfterBreakfastBetConfession_7bf3a265:

    # mc "¿No vas a tener que parar para hacer pis? Siempre teníamos que parar por ti cada pocos kilómetros."
    mc "Musst du nicht zwischendurch anhalten, um zu pinkeln? Wir mussten für dich immer alle paar Kilometer anhalten."

# game/scripts/c23/c23.rpy:2635
translate german c23s006_AfterBreakfastBetConfession_c77f999d:

    # emm "Si estoy durmiendo, no sabré si me estoy meando. *Risa* Con lo que os hago un favor echándome una siesta."
    emm "Wenn ich schlafe, merke ich nicht, wenn ich pinkeln muss. *Lacht* Deshalb tue ich euch allen einen Gefallen, indem ich ein Nickerchen mache."

# game/scripts/c23/c23.rpy:2636
translate german c23s006_AfterBreakfastBetConfession_75a9a3a3:

    # mc "Estás aprendiendo a tener respuestas para todo."
    mc "Du lernst, auf alles eine Antwort zu haben."

# game/scripts/c23/c23.rpy:2638
translate german c23s006_AfterBreakfastBetConfession_18ce4a7a:

    # "[bet] y tú charláis durante unos minutos hasta que os dais cuenta de que [emm] ya no hace ningún comentario."
    "[bet] und ihr unterhaltet euch ein paar Minuten, bis ihr merkt, dass [emm] keine Kommentare mehr abgibt."

# game/scripts/c23/c23.rpy:2639
translate german c23s006_AfterBreakfastBetConfession_c09ba386:

    # mc "Ya se ha dormido, ¿no? ¡[emm.nick] mira, un tractor rosa!"
    mc "Er schläft schon, nicht wahr? Schau mal, ein rosa Traktor!"

# game/scripts/c23/c23.rpy:2640
translate german c23s006_AfterBreakfastBetConfession_26d40720:

    # bet "No reacciona. Está durmiendo como un tronco."
    bet "Er reagiert nicht. Er schläft wie ein Stein."

# game/scripts/c23/c23.rpy:2641
translate german c23s006_AfterBreakfastBetConfession_6548d336:

    # mc "Entonces ahora podemos hablar tú y yo. No puedes huir de mí como has hecho los últimos dos días"
    mc "So, jetzt können wir reden, du und ich. Du kannst nicht mehr vor mir weglaufen, wie du es die letzten zwei Tage getan hast."

# game/scripts/c23/c23.rpy:2643
translate german c23s006_AfterBreakfastBetConfession_37b36e4d:

    # bet "No he huido de ti. Tenía muchas cosas que hacer..."
    bet "Ich bin nicht vor dir weggelaufen. Ich hatte viel zu tun..."

# game/scripts/c23/c23.rpy:2644
translate german c23s006_AfterBreakfastBetConfession_e2fb14cc:

    # mc "Y una de ellas era esquivarme. Es culpa tuya que me haya dado cuenta."
    mc "Und einer von ihnen mied mich. Dass ich das bemerkt habe, ist deine Schuld."

# game/scripts/c23/c23.rpy:2646
translate german c23s006_AfterBreakfastBetConfession_d05d7981:

    # bet "¿Mía? ¿Por qué? ¿Qué he hecho yo?"
    bet "Meins? Warum? Was habe ich getan?"

# game/scripts/c23/c23.rpy:2647
translate german c23s006_AfterBreakfastBetConfession_acf5c598:

    # mc "Me enseñaste a reconocer los síntomas cuando alguien me esquiva. Como pasó con [kia]. Como está pasando contigo."
    mc "Du hast mir beigebracht, die Anzeichen zu erkennen, wenn mich jemand meidet. So wie es mit [kia] passiert ist. So wie es jetzt mit dir passiert."

# game/scripts/c23/c23.rpy:2648
translate german c23s006_AfterBreakfastBetConfession_5f814bcd:

    # mc "Desde el incidente con Meemaw me estás evitando."
    mc "Seit dem Vorfall mit Meemaw gehst du mir aus dem Weg."

# game/scripts/c23/c23.rpy:2651
translate german c23s006_AfterBreakfastBetConfession_bbca009a:

    # bet "Bueno... fue un malentendido... "
    bet "Nun ja... es war ein Missverständnis..."

# game/scripts/c23/c23.rpy:2654
translate german c23s006_AfterBreakfastBetConfession_fec0dede:

    # bet "Veros como os vi... me sorprendió mucho..."
    bet "Dich so zu sehen, wie ich dich sah... hat mich sehr überrascht..."

# game/scripts/c23/c23.rpy:2655
translate german c23s006_AfterBreakfastBetConfession_ab7f2a20:

    # mc "Me di cuenta."
    mc "Mir wurde es klar."

# game/scripts/c23/c23.rpy:2657
translate german c23s006_AfterBreakfastBetConfession_d704a074:

    # bet "Pero no creo que sea el mejor momento para hablar de esto, con [emm] ahí atrás."
    bet "Aber ich glaube nicht, dass dies der beste Zeitpunkt ist, um darüber zu sprechen, da [emm] dort hinten ist."

# game/scripts/c23/c23.rpy:2658
translate german c23s006_AfterBreakfastBetConfession_0cab0d04:

    # mc "Está dormida como un tronco. Lo acabas de decir."
    mc "Sie schläft wie ein Stein. Das hast du doch selbst gesagt."

# game/scripts/c23/c23.rpy:2659
translate german c23s006_AfterBreakfastBetConfession_914f0da8:

    # mc "Y si me sigues evitando, nunca podemos hablarlo. Creo que en estos dos días nuestra relación ha dado un paso atrás, como si hubieras perdido confianza en mí."
    mc "Und wenn du mich weiterhin meidest, werden wir nie darüber reden können. Ich glaube, unsere Beziehung hat sich in den letzten zwei Tagen verschlechtert, als hättest du das Vertrauen in mich verloren."

# game/scripts/c23/c23.rpy:2661
translate german c23s006_AfterBreakfastBetConfession_55e4dd28:

    # bet "No es eso, cariño. No puedo perder la confianza en ti, no has hecho nada merecedor de ello."
    bet "Nein, Liebling, das ist es nicht. Ich kann das Vertrauen in dich nicht verlieren; du hast nichts getan, um es zu verdienen."

# game/scripts/c23/c23.rpy:2662
translate german c23s006_AfterBreakfastBetConfession_561f604b:

    # mc "Entonces explícamelo. No entiendo tu actitud de los últimos días, ni qué fue aquello de \"otra vez\" que dijiste en el baño."
    mc "Dann erkläre es mir. Ich verstehe dein Verhalten der letzten Tage nicht, und auch nicht, was du mit „schon wieder“ im Badezimmer gemeint hast."

# game/scripts/c23/c23.rpy:2664
translate german c23s006_AfterBreakfastBetConfession_894b0d96:

    # bet "¿Qué sabes de tu abuelo?"
    bet "Was wissen Sie über Ihren Großvater?"

# game/scripts/c23/c23.rpy:2666
translate german c23s006_AfterBreakfastBetConfession_5fe65bdf:

    # bet "¿Qué sabes de John, el marido de [mee]?"
    bet "Was wissen Sie über John, den Ehemann von [mee]?"

# game/scripts/c23/c23.rpy:2667
translate german c23s006_AfterBreakfastBetConfession_6992db62:

    # mc "¿Qué tiene que ver él en esto? Ahora estoy confundido."
    mc "Was hat er damit zu tun? Jetzt bin ich verwirrt."

# game/scripts/c23/c23.rpy:2668
translate german c23s006_AfterBreakfastBetConfession_9bd43ffa:

    # bet "¿Qué sabes de él?"
    bet "Was wissen Sie über ihn?"

# game/scripts/c23/c23.rpy:2670
translate german c23s006_AfterBreakfastBetConfession_5ea31eda:

    # mc "Lo que me han explicado Meemaw, mi madre, y [nor]. Se conocieron en la universidad, amor a primera vista, y un matrimonio feliz que acabó demasiado pronto."
    mc "Was mir Meemaw, meine Mutter, und [nor] erklärt haben. Sie lernten sich an der Universität kennen, es war Liebe auf den ersten Blick, und eine glückliche Ehe endete viel zu früh."

# game/scripts/c23/c23.rpy:2672
translate german c23s006_AfterBreakfastBetConfession_c5149e5a:

    # mc "Lo que me han explicado Meemaw y [nor]. Se conocieron en la universidad, amor a primera vista, y un matrimonio feliz que acabó demasiado pronto."
    mc "Was Meemaw und [nor] mir erklärt haben. Sie lernten sich an der Universität kennen, es war Liebe auf den ersten Blick, und eine glückliche Ehe endete viel zu früh."

# game/scripts/c23/c23.rpy:2673
translate german c23s006_AfterBreakfastBetConfession_f856635d:

    # mc "Y que parece que todo lo hacía bien y nunca se equivocaba en nada. Pero eso supongo que se debe a que ya no está entre nosotros."
    mc "Und es scheint, als hätte er alles richtig gemacht und nie einen Fehler begangen. Aber ich nehme an, das liegt daran, dass er nicht mehr unter uns weilt."

# game/scripts/c23/c23.rpy:2675
translate german c23s006_AfterBreakfastBetConfession_e62be100:

    # bet "Sí y no. Hacía muchas cosas bien, pero también se equivocaba en muchas otras."
    bet "Ja und nein. Er hat vieles gut gemacht, aber auch viele Fehler."

# game/scripts/c23/c23.rpy:2676
translate german c23s006_AfterBreakfastBetConfession_a6bdd1ff:

    # bet "No, no era perfecto."
    bet "Nein, es war nicht perfekt."

# game/scripts/c23/c23.rpy:2677
translate german c23s006_AfterBreakfastBetConfession_1b377091:

    # mc "Bueno, nadie lo es. Pero una vez alguien se muere, normalmente se olvidan las cosas malas que hizo. A menos que fuera un hijo de puta."
    mc "Nun ja, das ist niemand. Aber sobald jemand stirbt, werden die schlechten Dinge, die er getan hat, meist vergessen. Es sei denn, er war ein richtiges Miststück."

# game/scripts/c23/c23.rpy:2678
translate german c23s006_AfterBreakfastBetConfession_526ca8a7:

    # mc "Entonces se olvidan las buenas, si es que hizo alguna."
    mc "Dann geraten die guten Dinge in Vergessenheit, falls er überhaupt welche getan hat."

# game/scripts/c23/c23.rpy:2680
translate german c23s006_AfterBreakfastBetConfession_7f0c7e18:

    # bet "No, con John no era así. De sus equivocaciones te olvidabas a los cinco minutos."
    bet "Nein, bei John war das nicht so. Seine Fehler hatte man innerhalb von fünf Minuten vergessen."

# game/scripts/c23/c23.rpy:2681
translate german c23s006_AfterBreakfastBetConfession_edf7a302:

    # bet "Tenía un don para que sus aciertos y éxitos pesaran mucho más que sus fallos y sus fracasos."
    bet "Er hatte ein besonderes Talent dafür, seine Erfolge und Errungenschaften seine Misserfolge und Fehler bei Weitem überwiegen zu lassen."

# game/scripts/c23/c23.rpy:2683
translate german c23s006_AfterBreakfastBetConfession_2b3e9541:

    # bet "Tenía un carisma especial para hacer que ni te fijaras en sus carencias o en lo que hacía mal."
    bet "Er besaß eine besondere Ausstrahlung, die dafür sorgte, dass man seine Schwächen oder seine Fehler gar nicht bemerkte."

# game/scripts/c23/c23.rpy:2684
translate german c23s006_AfterBreakfastBetConfession_4fd6f76e:

    # bet "Como siempre estaba haciendo cosas por los demás, todo el mundo pensaba que él no tenía problemas propios."
    bet "Weil er immer alles für andere tat, dachten alle, er hätte selbst keine Probleme."

# game/scripts/c23/c23.rpy:2685
translate german c23s006_AfterBreakfastBetConfession_477e8157:

    # bet "Tú te pareces mucho a él. Más de lo que incluso [mee] ha descubierto."
    bet "Du siehst ihm sehr ähnlich. Mehr als selbst [mee] bemerkt hat."

# game/scripts/c23/c23.rpy:2686
translate german c23s006_AfterBreakfastBetConfession_45f202a6:

    # mc "Gracias, supongo. A veces lo describís como si meara whisky y sus pedos fueran arcoíris."
    mc "Danke, nehme ich an. Manchmal beschreibst du ihn so, als ob er Whiskey pinkelt und seine Fürze Regenbögen sind."

# game/scripts/c23/c23.rpy:2688
translate german c23s006_AfterBreakfastBetConfession_c5817933:

    # bet "*Risa* Te puedo asegurar que sus pedos NO eran arcoíris. Sabías que había estado en una habitación horas después de que se fuera."
    bet "*lacht* Ich kann dir versichern, dass seine Fürze keine Regenbögen waren. Man merkte ihm an, dass er noch Stunden nach seinem Weggang in einem Zimmer gewesen war."

# game/scripts/c23/c23.rpy:2689
translate german c23s006_AfterBreakfastBetConfession_49aba72c:

    # bet "Bromeábamos con que no fue a Vietnam porque se le consideraba un arma química con piernas. *Risa*"
    bet "Wir scherzten, dass er nicht nach Vietnam gegangen sei, weil er dort als wandelnde Chemiewaffe galt. *Gelächter*"

# game/scripts/c23/c23.rpy:2690
translate german c23s006_AfterBreakfastBetConfession_44f9ad22:

    # mc "*Risa* Bueno, al menos en eso no me parezco a él... creo."
    mc "*Lacht* Nun ja, zumindest bin ich nicht wie er... glaube ich."

# game/scripts/c23/c23.rpy:2692
translate german c23s006_AfterBreakfastBetConfession_331c1e76:

    # bet "Sobre el resto, como resumen está bien. Se conocieron cuando [mee] iba a la universidad. John ya había acabado."
    bet "Im Übrigen ist es eine gute Zusammenfassung. Sie lernten sich kennen, als [mee] an der Universität war. John hatte sein Studium bereits abgeschlossen."

# game/scripts/c23/c23.rpy:2693
translate german c23s006_AfterBreakfastBetConfession_b8677642:

    # bet "[mee] estaba en su tercer año en San Luis Obispo y yo acababa de empezar en Stanford."
    bet "[mee] war im dritten Jahr an der San Luis Obispo und ich hatte gerade erst an der Stanford angefangen."

# game/scripts/c23/c23.rpy:2694
translate german c23s006_AfterBreakfastBetConfession_396c3c56:

    # bet "John estaba trabajando en un pequeño estudio de arquitectura en San Francisco."
    bet "John arbeitete in einem kleinen Architekturbüro in San Francisco."

# game/scripts/c23/c23.rpy:2696
translate german c23s006_AfterBreakfastBetConfession_39888221:

    # mc "Sigo sin entender qué tiene que ver el abuelo en todo esto."
    mc "Ich verstehe immer noch nicht, was der Großvater mit all dem zu tun hat."

# game/scripts/c23/c23.rpy:2698
translate german c23s006_AfterBreakfastBetConfession_c44ca57b:

    # mc "Sigo sin entender qué tiene que ver John en todo esto."
    mc "Ich verstehe immer noch nicht, was John mit all dem zu tun hat."

# game/scripts/c23/c23.rpy:2700
translate german c23s006_AfterBreakfastBetConfession_68f149a5:

    # bet "Déjame continuar y lo entenderás."
    bet "Lassen Sie mich fortfahren, dann werden Sie es verstehen."

# game/scripts/c23/c23.rpy:2701
translate german c23s006_AfterBreakfastBetConfession_67102796:

    # bet "Yo conocí a John antes que [mee]. Me lo presentó un amigo común."
    bet "Ich habe John vor [mee] kennengelernt. Ein gemeinsamer Freund hat uns einander vorgestellt."

# game/scripts/c23/c23.rpy:2702
translate german c23s006_AfterBreakfastBetConfession_9f83902b:

    # mc "¿Os llevabais bien?"
    mc "Habt ihr euch gut verstanden?"

# game/scripts/c23/c23.rpy:2704
translate german c23s006_AfterBreakfastBetConfession_325bf1ea:

    # bet "Nos hicimos amigos en seguida."
    bet "Wir haben uns auf Anhieb angefreundet."

# game/scripts/c23/c23.rpy:2705
translate german c23s006_AfterBreakfastBetConfession_baea9b98:

    # bet "Teníamos un sentido del humor muy parecido, a los dos nos gustaba pasear, y salía con mi grupo de amigos los fines de semana."
    bet "Wir hatten einen sehr ähnlichen Sinn für Humor, wir gingen beide gerne spazieren, und ich unternahm an den Wochenenden etwas mit meiner Freundesgruppe."

# game/scripts/c23/c23.rpy:2706
translate german c23s006_AfterBreakfastBetConfession_8516836a:

    # bet "Era el mayor de todos nosotros, pero eso era bueno. Arnold no había sido gobernador y la edad para beber eran 21 todavía."
    bet "Er war der Älteste von uns allen, aber das war gut so. Arnold war noch nicht Gouverneur, und das gesetzliche Mindestalter für Alkoholkonsum lag noch bei 21 Jahren."

# game/scripts/c23/c23.rpy:2707
translate german c23s006_AfterBreakfastBetConfession_9494eba4:

    # mc "¿Lo llevabais para que os comprara alcohol? *Risa*"
    mc "Hast du ihn mitgebracht, damit er dir Alkohol kauft? *lacht*"

# game/scripts/c23/c23.rpy:2709
translate german c23s006_AfterBreakfastBetConfession_ad5fa407:

    # bet "Eran los setenta... conseguir alcohol... y otras cosas... era fácil. *Risa* Pero sí, él nos compraba las bebidas."
    bet "Es waren die Siebziger... Alkohol und andere Dinge zu bekommen war einfach. *lacht* Aber ja, er hat uns Getränke spendiert."

# game/scripts/c23/c23.rpy:2710
translate german c23s006_AfterBreakfastBetConfession_20ab19b8:

    # mc "*Risa* Tía [bet] en plan malota, bebiendo... y haciendo otras cosas... ilegalmente. Me hubiera gustado conocerte en aquella época."
    mc "*Lacht* Tante [bet] hat sich total cool aufgeführt, getrunken... und andere Dinge... illegal gemacht. Ich wünschte, ich hätte dich damals kennengelernt."

# game/scripts/c23/c23.rpy:2712
translate german c23s006_AfterBreakfastBetConfession_60943014:

    # bet "*Risa* Yo era una chiquilla divertida en aquella época. Creo que nos hubiéramos llevado bien."
    bet "*lacht* Ich war damals ein lebenslustiges Kind. Ich glaube, wir hätten uns gut verstanden."

# game/scripts/c23/c23.rpy:2713
translate german c23s006_AfterBreakfastBetConfession_f51ac469:

    # mc "Sigues siendo divertida y nos llevamos bien. No ha cambiado nada."
    mc "Du bist immer noch lustig und wir verstehen uns gut. Nichts hat sich geändert."

# game/scripts/c23/c23.rpy:2715
translate german c23s006_AfterBreakfastBetConfession_55459c89:

    # bet "Excepto que tengo 46 años más que entonces..."
    bet "Nur dass ich 46 Jahre älter bin als damals..."

# game/scripts/c23/c23.rpy:2716
translate german c23s006_AfterBreakfastBetConfession_395d9e0e:

    # mc "Bueno, la edad sólo es un número. Si te sientes joven eres joven."
    mc "Nun ja, Alter ist nur eine Zahl. Wer sich jung fühlt, ist jung."

# game/scripts/c23/c23.rpy:2718
translate german c23s006_AfterBreakfastBetConfession_1bb5e936:

    # bet "¡Qué fácil parece todo a tu edad!"
    bet "In deinem Alter scheint alles so einfach!"

# game/scripts/c23/c23.rpy:2719
translate german c23s006_AfterBreakfastBetConfession_6e1125b6:

    # bet "Pero volviendo a John..."
    bet "Aber zurück zu John..."

# game/scripts/c23/c23.rpy:2720
translate german c23s006_AfterBreakfastBetConfession_720e0757:

    # bet "Nos llevábamos tan bien que empecé a ver cosas dónde no las había."
    bet "Wir haben uns so gut verstanden, dass ich anfing, Dinge zu sehen, wo keine waren."

# game/scripts/c23/c23.rpy:2721
translate german c23s006_AfterBreakfastBetConfession_e3c28eeb:

    # bet "Me hacía la encontradiza con él para verlo, paseaba cerca de su trabajo, de su casa..."
    bet "Ich würde versuchen, ihm zufällig zu begegnen, um ihn zu sehen, ich würde in der Nähe seines Arbeitsplatzes, in der Nähe seines Hauses spazieren gehen..."

# game/scripts/c23/c23.rpy:2722
translate german c23s006_AfterBreakfastBetConfession_83728b01:

    # mc "Vaya, que te enamoraste como una adolescente."
    mc "Wow, du hast dich verliebt wie ein Teenager."

# game/scripts/c23/c23.rpy:2724
translate german c23s006_AfterBreakfastBetConfession_de131cf3:

    # bet "*Risa triste* ¡Era una adolescente!"
    bet "*Trauriges Lachen* Sie war ein Teenager!"

# game/scripts/c23/c23.rpy:2725
translate german c23s006_AfterBreakfastBetConfession_c9cdb920:

    # bet "Pero sí, enamorada hasta las trancas. Y un poco acosadora."
    bet "Aber ja, bis über beide Ohren verliebt. Und ein bisschen ein Stalker."

# game/scripts/c23/c23.rpy:2726
translate german c23s006_AfterBreakfastBetConfession_bfcfc81c:

    # mc "Esas cosas pasan cuando eres joven."
    mc "Solche Dinge passieren, wenn man jung ist."

# game/scripts/c23/c23.rpy:2728
translate german c23s006_AfterBreakfastBetConfession_90cc7385:

    # bet "Ya te dije que yo vivía en una caravana cerca del campus, ¿no?"
    bet "Ich hatte dir doch schon erzählt, dass ich in einem Wohnwagen in der Nähe des Campus wohne, oder?"

# game/scripts/c23/c23.rpy:2729
translate german c23s006_AfterBreakfastBetConfession_0e7ce500:

    # mc "Sí, la caravana rosa de la que [emm] estaría orgullosa."
    mc "Ja, der rosafarbene Wohnwagen, auf den [emm] stolz wäre."

# game/scripts/c23/c23.rpy:2731
translate german c23s006_AfterBreakfastBetConfession_5e564651:

    # bet "Pues [mee] vino a visitarme un fin de semana, se iba a quedar a dormir en la caravana el viernes y el sábado."
    bet "Nun, [mee] kam mich für ein Wochenende besuchen, er wollte am Freitag und Samstag im Wohnwagen übernachten."

# game/scripts/c23/c23.rpy:2733
translate german c23s006_AfterBreakfastBetConfession_83578eae:

    # mc "Y conoció al abuelo."
    mc "Und er traf seinen Großvater."

# game/scripts/c23/c23.rpy:2735
translate german c23s006_AfterBreakfastBetConfession_f0d2d10b:

    # mc "Y conoció a John."
    mc "Und sie lernte John kennen."

# game/scripts/c23/c23.rpy:2737
translate german c23s006_AfterBreakfastBetConfession_9c437df7:

    # bet "Exacto. La llevé a una bar, donde había quedado con mi grupo de amigos y se la presenté a todo el mundo."
    bet "Genau. Ich nahm sie mit in eine Bar, wo ich mich mit meiner Clique traf, und stellte sie allen vor."

# game/scripts/c23/c23.rpy:2738
translate german c23s006_AfterBreakfastBetConfession_aff28618:

    # bet "Y ahí entra lo que tú conoces. Amor a primera vista."
    bet "Und da kommt das ins Spiel, was du weißt. Liebe auf den ersten Blick."

# game/scripts/c23/c23.rpy:2739
translate german c23s006_AfterBreakfastBetConfession_907e6dd5:

    # bet "Él arquitecto. Ella estudiando arquitectura. Empezaron a charlar y encajaron."
    bet "Er war Architekt. Sie studierte Architektur. Sie kamen ins Gespräch und verstanden sich auf Anhieb."

# game/scripts/c23/c23.rpy:2741
translate german c23s006_AfterBreakfastBetConfession_ea724bd7:

    # bet "Parecía que el resto del mundo no existía para ellos, como si fuéramos estatuas decorativas del bar."
    bet "Es schien, als existiere der Rest der Welt für sie nicht, als wären wir dekorative Statuen in der Bar."

# game/scripts/c23/c23.rpy:2742
translate german c23s006_AfterBreakfastBetConfession_fabb8ff0:

    # bet "Se pasaron toda la noche juntos, charlando y riendo. Conociéndose."
    bet "Sie verbrachten die ganze Nacht zusammen, unterhielten sich und lachten. Sie lernten sich kennen."

# game/scripts/c23/c23.rpy:2743
translate german c23s006_AfterBreakfastBetConfession_a5680026:

    # mc "Y tú te sentiste fatal."
    mc "Und du hast dich furchtbar gefühlt."

# game/scripts/c23/c23.rpy:2745
translate german c23s006_AfterBreakfastBetConfession_2d672509:

    # bet "Sí. No quiero endulzarlo. *Risa* Me comporté como una niña celosa de mi propia hermana."
    bet "Ja. Ich will nichts beschönigen. *lacht* Ich habe mich meiner eigenen Schwester gegenüber wie ein eifersüchtiges kleines Mädchen verhalten."

# game/scripts/c23/c23.rpy:2746
translate german c23s006_AfterBreakfastBetConfession_8afc0df8:

    # bet "*Risa* Me pasé toda la noche pensando en mil formas de asesinar a [mee] cuando fuéramos a la caravana a dormir."
    bet "*Lacht* Ich habe die ganze Nacht über tausend Möglichkeiten nachgedacht, jemanden umzubringen, wenn wir zum Wohnwagen zum Schlafen gehen."

# game/scripts/c23/c23.rpy:2747
translate german c23s006_AfterBreakfastBetConfession_8411fb7d:

    # mc "Pero no lo hiciste. *Risa* Si todos los asesinatos mentales sucedieran, no quedaría nadie en el mundo."
    mc "Aber das hast du nicht getan. *Lacht* Wenn alle psychischen Morde geschehen würden, gäbe es niemanden mehr auf der Welt."

# game/scripts/c23/c23.rpy:2749
translate german c23s006_AfterBreakfastBetConfession_ba3e7d41:

    # bet "No lo hice porque [mee] no vino a dormir a la caravana ninguna de las dos noches."
    bet "Ich habe es nicht getan, weil [mee] in keiner der beiden Nächte im Wohnwagen zum Schlafen gekommen ist."

# game/scripts/c23/c23.rpy:2750
translate german c23s006_AfterBreakfastBetConfession_e04a5c20:

    # mc "Eso es sorprendente, viniendo de Meemaw."
    mc "Das ist überraschend, vor allem von Meemaw."

# game/scripts/c23/c23.rpy:2752
translate german c23s006_AfterBreakfastBetConfession_bb687e89:

    # bet "Ella también era joven entonces. *Risa* Y recuerda lo del amor a primera vista."
    bet "Sie war damals auch noch jung. *lacht* Und erinnerst du dich an die Liebe auf den ersten Blick?"

# game/scripts/c23/c23.rpy:2753
translate german c23s006_AfterBreakfastBetConfession_7c5b2432:

    # mc "Amor a primera vista y sexo a primer parpadeo. *Risa* Pero sigo sin entender qué tiene que ver eso con lo que pasó el otro día."
    mc "Liebe auf den ersten Blick und Sex auf den ersten Blick. *lacht* Aber ich verstehe immer noch nicht, was das mit dem zu tun hat, was neulich passiert ist."

# game/scripts/c23/c23.rpy:2755
translate german c23s006_AfterBreakfastBetConfession_77c5b7ce:

    # bet "Ni [mee] ni John sabían lo que yo sentía por él. Con lo que di un paso a un lado y empecé mi descenso a los infiernos."
    bet "Weder [mee] noch John wussten, was ich für ihn empfand. Also trat ich beiseite und begann meinen Abstieg in die Hölle."

# game/scripts/c23/c23.rpy:2756
translate german c23s006_AfterBreakfastBetConfession_ba4ae07c:

    # mc "Así que John es quien, sin saberlo, te empujó a frecuentar esas compañías inadecuadas de las que hablaste."
    mc "John war also derjenige, der Sie, ohne es zu wissen, dazu gedrängt hat, die von Ihnen erwähnten ungeeigneten Unternehmen aufzusuchen."

# game/scripts/c23/c23.rpy:2757
translate german c23s006_AfterBreakfastBetConfession_2b019f8b:

    # mc "Y finalmente hacerte monja..."
    mc "Und schließlich, werde Nonne..."

# game/scripts/c23/c23.rpy:2759
translate german c23s006_AfterBreakfastBetConfession_433c9882:

    # bet "No, no me empujó él. Me empujó el no saber gestionar mis emociones."
    bet "Nein, er hat mich nicht geschubst. Meine Unfähigkeit, meine Gefühle zu kontrollieren, hat mich geschubst."

# game/scripts/c23/c23.rpy:2760
translate german c23s006_AfterBreakfastBetConfession_ab94bc8b:

    # bet "Era una niña imbécil que no podía soportar ver al hombre del que me había enamorado con otra."
    bet "Ich war ein dummes Mädchen, das es nicht ertragen konnte, den Mann, in den ich mich verliebt hatte, mit einer anderen Frau zu sehen."

# game/scripts/c23/c23.rpy:2761
translate german c23s006_AfterBreakfastBetConfession_dd5d1635:

    # bet "Y menos aún con mi hermana."
    bet "Und bei meiner Schwester ist das noch viel weniger der Fall."

# game/scripts/c23/c23.rpy:2763
translate german c23s006_AfterBreakfastBetConfession_e194d768:

    # bet "Sentía como si [mee] me lo hubiera robado. *Risa triste* No me podía robar algo que nunca fue mío, pero era como me sentía."
    bet "Ich hatte das Gefühl, [mee] hätte es mir gestohlen. *Trauriges Lachen* Ich konnte ja nichts stehlen, was mir nie gehört hatte, aber so fühlte es sich an."

# game/scripts/c23/c23.rpy:2764
translate german c23s006_AfterBreakfastBetConfession_55a20160:

    # mc "Te entiendo. Las comidas familiares tuvieron que ser una pesadilla para ti."
    mc "Ich verstehe. Familienmahlzeiten müssen für Sie ein Albtraum gewesen sein."

# game/scripts/c23/c23.rpy:2766
translate german c23s006_AfterBreakfastBetConfession_d4ba9580:

    # bet "Lo fueron durante un tiempo, la boda de [mee] incluida. Después ya no."
    bet "Eine Zeit lang waren sie es, auch bei der Hochzeit von [mee]. Dann nicht mehr."

# game/scripts/c23/c23.rpy:2767
translate german c23s006_AfterBreakfastBetConfession_636b4824:

    # bet "Me alegré mucho por ellos, pero dejé de ir a esas comidas. Siempre buscaba una excusa para quedarme en Stanford."
    bet "Ich habe mich sehr für sie gefreut, aber ich bin nicht mehr zu diesen Mahlzeiten gegangen. Ich habe immer nach einem Vorwand gesucht, um in Stanford zu bleiben."

# game/scripts/c23/c23.rpy:2769
translate german c23s006_AfterBreakfastBetConfession_e4232a8c:

    # bet "Eso me distanció de [mee] y de tus bisabuelos. Me sentí muy sola durante años."
    bet "Das entfremdete mich von [mee] und deinen Urgroßeltern. Ich fühlte mich jahrelang sehr einsam."

# game/scripts/c23/c23.rpy:2771
translate german c23s006_AfterBreakfastBetConfession_a13fabc5:

    # bet "Eso me distanció de [mee] y de mis padres. Me sentí muy sola durante años"
    bet "Das entfremdete mich von [mee] und meinen Eltern. Ich fühlte mich jahrelang sehr einsam."

# game/scripts/c23/c23.rpy:2772
translate german c23s006_AfterBreakfastBetConfession_5e2cf973:

    # mc "Y encontraste a la iglesia que llenó ese vacío."
    mc "Und du hast die Kirche gefunden, die diese Leere füllte."

# game/scripts/c23/c23.rpy:2774
translate german c23s006_AfterBreakfastBetConfession_23b458a9:

    # bet "Sí, pero fue mucho más tarde. Me volqué en estudiar primero y en trabajar después."
    bet "Ja, aber das war viel später. Ich habe mich zuerst auf mein Studium konzentriert und erst später gearbeitet."

# game/scripts/c23/c23.rpy:2775
translate german c23s006_AfterBreakfastBetConfession_2fb56829:

    # bet "Cuando acabé la carrera, mientras hacía la residencia en San José descubrí que la religión ayudaba a muchas personas a superar sus pérdidas."
    bet "Als ich mein Studium abschloss und während meiner Facharztausbildung in San Jose, entdeckte ich, dass die Religion vielen Menschen half, ihre Verluste zu überwinden."

# game/scripts/c23/c23.rpy:2777
translate german c23s006_AfterBreakfastBetConfession_3f08b0e8:

    # bet "Empecé a ir a la iglesia y poco tiempo después lo dejé todo atrás y me hice monja. El resto ya lo sabes."
    bet "Ich fing an, in die Kirche zu gehen, und kurze Zeit später gab ich alles auf und wurde Nonne. Den Rest kennst du ja."

# game/scripts/c23/c23.rpy:2779
translate german c23s006_AfterBreakfastBetConfession_f8cafc43:

    # mc "Y todo ese tiempo estuviste enamorada del abuelo, ¿no? ¿Hasta que murió?"
    mc "Und du warst die ganze Zeit in deinen Großvater verliebt, nicht wahr? Bis zu seinem Tod?"

# game/scripts/c23/c23.rpy:2781
translate german c23s006_AfterBreakfastBetConfession_14e82712:

    # mc "Y todo ese tiempo estuviste enamorada de John, ¿no? ¿Hasta que murió?"
    mc "Und du warst die ganze Zeit in John verliebt, nicht wahr? Bis zu seinem Tod?"

# game/scripts/c23/c23.rpy:2783
translate german c23s006_AfterBreakfastBetConfession_979cf0f8:

    # bet "No tanto, pero lo estuve durante mucho tiempo."
    bet "Nicht so sehr, aber ich war es lange Zeit."

# game/scripts/c23/c23.rpy:2784
translate german c23s006_AfterBreakfastBetConfession_0f4baa8f:

    # bet "Hasta que, a principios de los 90, me fui a África y descubrí que mis problemas eran nimiedades comparados con los del resto del mundo."
    bet "Bis ich Anfang der 90er Jahre nach Afrika reiste und feststellte, dass meine Probleme im Vergleich zu denen des Rests der Welt trivial waren."

# game/scripts/c23/c23.rpy:2785
translate german c23s006_AfterBreakfastBetConfession_e649715c:

    # bet "Una historia de amor no correspondido que duró más de 10 años, y en la que no hay culpables aparte de mí."
    bet "Eine Geschichte unerwiderter Liebe, die mehr als 10 Jahre andauerte und in der es außer mir selbst keine Schuldigen gibt."

# game/scripts/c23/c23.rpy:2786
translate german c23s006_AfterBreakfastBetConfession_d12f1b69:

    # mc "No creo que haya culpables, ni siquiera tú. Te enamoraste y lo guardaste en silencio. Otra mujer se llevó al chico."
    mc "Ich glaube nicht, dass irgendjemand die Schuld trägt, nicht einmal du. Du hast dich verliebt und es für dich behalten. Eine andere Frau hat dir den Jungen weggenommen."

# game/scripts/c23/c23.rpy:2788
translate german c23s006_AfterBreakfastBetConfession_d68451be:

    # bet "Por eso es por lo que más culpable me sentí todos esos años. Mi cabeza estaba llena de escenarios que no pasaron."
    bet "Deshalb plagten mich all die Jahre die größten Schuldgefühle. Mein Kopf war voll von Szenarien, die nicht eintraten."

# game/scripts/c23/c23.rpy:2789
translate german c23s006_AfterBreakfastBetConfession_b10aa4ec:

    # bet "¿Qué hubiera pasado si le hubiera dicho a John lo que sentía por él antes de presentarle a [mee]?"
    bet "Was wäre passiert, wenn ich John meine Gefühle für ihn gestanden hätte, bevor ich ihn [mee] vorgestellt habe?"

# game/scripts/c23/c23.rpy:2790
translate german c23s006_AfterBreakfastBetConfession_360a42cb:

    # bet "¿Hubiera sido correspondida? ¿Hubiéramos durado? ¿Hubiera sido un matrimonio tan bonito como el que tuvo [mee]?"
    bet "Wären meine Gefühle erwidert worden? Hätte unsere Ehe gehalten? Wäre es eine ebenso schöne Ehe geworden wie die von [mee]?"

# game/scripts/c23/c23.rpy:2791
translate german c23s006_AfterBreakfastBetConfession_3d127226:

    # mc "Son cosas que no puedes saber, con lo que no tienes que pensar en eso. Solo te harás daño."
    mc "Das sind Dinge, die du nicht wissen kannst, also solltest du nicht darüber grübeln. Du schadest dir damit nur selbst."

# game/scripts/c23/c23.rpy:2793
translate german c23s006_AfterBreakfastBetConfession_c05bd513:

    # bet "Hacía años que no pensaba en eso. Hasta que pasó lo del otro día."
    bet "Daran hatte ich jahrelang nicht gedacht. Bis zu dem, was neulich passiert ist."

# game/scripts/c23/c23.rpy:2794
translate german c23s006_AfterBreakfastBetConfession_e266889c:

    # mc "Y ahí vino el \"Otra vez\". Estabas viviendo otra vez lo mismo, con la misma persona."
    mc "Und dann kam das \"Schon wieder\". Man machte dasselbe noch einmal durch, mit derselben Person."

# game/scripts/c23/c23.rpy:2796
translate german c23s006_AfterBreakfastBetConfession_e608e602:

    # mc "Pero esta vez era yo en vez del abuelo."
    mc "Doch diesmal war ich es anstelle von Opa."

# game/scripts/c23/c23.rpy:2798
translate german c23s006_AfterBreakfastBetConfession_5ac837c0:

    # mc "Pero esta vez era yo en vez de John."
    mc "Doch diesmal war ich es anstelle von John."

# game/scripts/c23/c23.rpy:2800
translate german c23s006_AfterBreakfastBetConfession_5d2be7a8:

    # bet "No pareces sorprendido."
    bet "Du scheinst nicht überrascht zu sein."

# game/scripts/c23/c23.rpy:2801
translate german c23s006_AfterBreakfastBetConfession_22eb8a58:

    # mc "No lo estoy. Empecé a sospecharlo aquel día en el que hablamos de por qué [kia] me estaba evitando."
    mc "Nein, bin ich nicht. Ich fing an, es zu vermuten, als wir an dem Tag darüber sprachen, warum [kia] mich mied."

# game/scripts/c23/c23.rpy:2802
translate german c23s006_AfterBreakfastBetConfession_4a03f641:

    # mc "Después de lo que pasó en el baño, has sido tú la que me evitabas."
    mc "Nach dem Vorfall im Badezimmer warst du es, die mich gemieden hat."

# game/scripts/c23/c23.rpy:2803
translate german c23s006_AfterBreakfastBetConfession_dc27d420:

    # mc "Y tu historia me ha dado el contexto para entender el \"Otra vez\", que era la única pieza que me faltaba."
    mc "Und Ihre Geschichte hat mir den Kontext gegeben, um das „Nochmal“ zu verstehen, das das einzige fehlende Puzzleteil war."

# game/scripts/c23/c23.rpy:2805
translate german c23s006_AfterBreakfastBetConfession_eaa2602f:

    # bet "Pues ahora lo entiendes todo. Me siento estúpida."
    bet "Jetzt verstehst du alles. Ich fühle mich dumm."

# game/scripts/c23/c23.rpy:2806
translate german c23s006_AfterBreakfastBetConfession_b3961c59:

    # mc "¿Por qué?"
    mc "Weil?"

# game/scripts/c23/c23.rpy:2808
translate german c23s006_AfterBreakfastBetConfession_dc1ef5d1:

    # bet "Por mil razones. Porque me he vuelto a enamorar de una persona que no debo."
    bet "Aus tausend Gründen. Weil ich mich wieder in jemanden verliebt habe, in den ich mich nicht verlieben sollte."

# game/scripts/c23/c23.rpy:2810
translate german c23s006_AfterBreakfastBetConfession_92d4465f:

    # bet "Porque esa persona es mi sobrino nieto."
    bet "Weil diese Person mein Großneffe ist."

# game/scripts/c23/c23.rpy:2811
translate german c23s006_AfterBreakfastBetConfession_0e60839f:

    # bet "Porque soy 1,000 años mayor que él."
    bet "Weil ich 1000 Jahre älter bin als er."

# game/scripts/c23/c23.rpy:2812
translate german c23s006_AfterBreakfastBetConfession_03e19a9b:

    # bet "Porque, aunque existiera la remota posibilidad de que quisieras estar conmigo, yo no podría porque soy monja."
    bet "Denn selbst wenn es eine entfernte Möglichkeit gäbe, dass du mit mir zusammen sein wolltest, könnte ich das nicht, weil ich eine Nonne bin."

# game/scripts/c23/c23.rpy:2813
translate german c23s006_AfterBreakfastBetConfession_8949cccb:

    # bet "Porque soy una vieja estúpida..."
    bet "Weil ich eine dumme alte Frau bin..."

# game/scripts/c23/c23.rpy:2814
translate german c23s006_AfterBreakfastBetConfession_ad386c7e:

    # mc "Te voy a hacer dos preguntas, que es lo único que no he entendido."
    mc "Ich werde Ihnen zwei Fragen stellen, das ist das Einzige, was ich nicht verstanden habe."

# game/scripts/c23/c23.rpy:2815
translate german c23s006_AfterBreakfastBetConfession_269ca14d:

    # bet "Dime..."
    bet "Sag mir..."

# game/scripts/c23/c23.rpy:2817
translate german c23s006_AfterBreakfastBetConfession_93174448:

    # mc "¿Te has enamorado de mí o del reflejo que ves del abuelo en mí?"
    mc "Hast du dich in mich verliebt oder in das Spiegelbild deines Großvaters in mir?"

# game/scripts/c23/c23.rpy:2819
translate german c23s006_AfterBreakfastBetConfession_025c7aa9:

    # mc "¿Te has enamorado de mí o del reflejo que ves de John en mí?"
    mc "Hast du dich in mich verliebt oder in das Spiegelbild von John in mir?"

# game/scripts/c23/c23.rpy:2821
translate german c23s006_AfterBreakfastBetConfession_0d0dbd6c:

    # bet "¿Cuándo te has vuelto así?"
    bet "Wann bist du so geworden?"

# game/scripts/c23/c23.rpy:2822
translate german c23s006_AfterBreakfastBetConfession_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c23/c23.rpy:2823
translate german c23s006_AfterBreakfastBetConfession_3551d6e0:

    # bet "Hace dos semanas no hubieras preguntado eso. No te hubieras ni siquiera dado cuenta. Ni te lo hubieras planteado."
    bet "Vor zwei Wochen hättest du das nicht gefragt. Du hättest es nicht einmal bemerkt. Du hättest es nicht einmal in Erwägung gezogen."

# game/scripts/c23/c23.rpy:2824
translate german c23s006_AfterBreakfastBetConfession_e6c9391d:

    # mc "He tenido una buena maestra a la hora de observar cosas. No he pasado tanto tiempo contigo como me gustaría, pero el suficiente para aprender algunos trucos."
    mc "Ich hatte einen guten Lehrmeister, was das Beobachten von Dingen angeht. Ich habe leider nicht so viel Zeit mit dir verbracht, wie ich gerne würde, aber genug, um mir ein paar Tricks anzueignen."

# game/scripts/c23/c23.rpy:2826
translate german c23s006_AfterBreakfastBetConfession_1c7cf176:

    # bet "Empecé en pensar en ti de una forma inapropiada porque me recordabas a John."
    bet "Ich habe angefangen, auf unangemessene Weise an dich zu denken, weil du mich an John erinnert hast."

# game/scripts/c23/c23.rpy:2827
translate german c23s006_AfterBreakfastBetConfession_0df00951:

    # bet "Pero me he dado cuenta de que lo que me gusta de ti son las cosas que te hacen diferente a él."
    bet "Aber mir ist klar geworden, dass ich an dir gerade die Dinge mag, die dich von ihm unterscheiden."

# game/scripts/c23/c23.rpy:2828
translate german c23s006_AfterBreakfastBetConfession_f47f1290:

    # mc "Lo que significa que no era tan perfecto... pedos aparte."
    mc "Das heißt, es war nicht ganz so perfekt... mal abgesehen von den Fürzen."

# game/scripts/c23/c23.rpy:2830
translate german c23s006_AfterBreakfastBetConfession_f0e80352:

    # bet "*Risa* No era perfecto. Y tú tampoco lo eres, no empieces a buscar un pedestal al que subirte."
    bet "*lacht* Er war nicht perfekt. Und du bist es auch nicht, also such dir bloß keinen Sockel, auf den du klettern kannst."

# game/scripts/c23/c23.rpy:2831
translate german c23s006_AfterBreakfastBetConfession_83479e7a:

    # bet "Pero tú tienes virtudes que él no tenía, y algunas que él tenía son más grandes en ti. Pero lo mismo pasa con los defectos."
    bet "Aber du besitzt Tugenden, die er nicht hatte, und manche seiner Tugenden sind bei dir sogar noch ausgeprägter. Dasselbe gilt aber auch für deine Schwächen."

# game/scripts/c23/c23.rpy:2833
translate german c23s006_AfterBreakfastBetConfession_ccd78334:

    # bet "Tan solo es que... tu combinación de virtudes y defectos es diferente..."
    bet "Es ist einfach so, dass... Ihre Kombination aus Stärken und Schwächen anders ist..."

# game/scripts/c23/c23.rpy:2834
translate german c23s006_AfterBreakfastBetConfession_e0946371:

    # bet "Me recuerdas mucho a él. También a [mee] se lo recuerdas. Pero no sois la misma persona."
    bet "Du erinnerst mich sehr an ihn. Du erinnerst [mee] auch an ihn. Aber du bist nicht dieselbe Person."

# game/scripts/c23/c23.rpy:2835
translate german c23s006_AfterBreakfastBetConfession_d89a9f1a:

    # bet "Pero hay una segunda pregunta..."
    bet "Aber es gibt noch eine zweite Frage..."

# game/scripts/c23/c23.rpy:2836
translate german c23s006_AfterBreakfastBetConfession_a896bf5b:

    # mc "Y esa va a ser la más complicada."
    mc "Und das wird die komplizierteste Aufgabe sein."

# game/scripts/c23/c23.rpy:2837
translate german c23s006_AfterBreakfastBetConfession_116a5016:

    # mc "¿Cómo querrías que acabara esto? Como has dicho, eres monja."
    mc "Wie soll das enden? Wie du schon sagtest, bist du eine Nonne."

# game/scripts/c23/c23.rpy:2839
translate german c23s006_AfterBreakfastBetConfession_81fa4560:

    # bet "No tengo una respuesta para esa pregunta. Y no es la pregunta que me esperaba."
    bet "Ich habe keine Antwort auf diese Frage. Und es ist nicht die Frage, die ich erwartet hatte."

# game/scripts/c23/c23.rpy:2840
translate german c23s006_AfterBreakfastBetConfession_abc02a0b:

    # mc "¿Qué pregunta esperabas?"
    mc "Welche Frage hatten Sie erwartet?"

# game/scripts/c23/c23.rpy:2842
translate german c23s006_AfterBreakfastBetConfession_9d736f53:

    # bet "No sé, algo en plan \"¿Te has vuelto loca, Tía [bet]?\" *Risa*"
    bet "Ich weiß nicht, sowas wie: „Bist du verrückt geworden, Tante [bet]?“ *lacht*"

# game/scripts/c23/c23.rpy:2843
translate german c23s006_AfterBreakfastBetConfession_48662069:

    # mc "¿Por qué iba a preguntarte algo así?"
    mc "Warum sollte ich Sie so etwas fragen?"

# game/scripts/c23/c23.rpy:2846
translate german c23s006_AfterBreakfastBetConfession_69825cdc:

    # bet "Porque es una locura."
    bet "Weil es verrückt ist."

# game/scripts/c23/c23.rpy:2847
translate german c23s006_AfterBreakfastBetConfession_2acee1f5:

    # bet "Que yo sienta esto y que tengamos esta conversación precisamente hoy."
    bet "Dass ich so empfinde und dass wir dieses Gespräch heute führen."

# game/scripts/c23/c23.rpy:2863
translate german c23s006_AfterBreakfastBetConfession_e87268ed:

    # bet "Lo sé. Entre la edad, ser monja, y ni siquiera saber lo que quiero..."
    bet "Ich weiß. Zwischen meinem Alter, meinem Dasein als Nonne und der Tatsache, dass ich nicht einmal weiß, was ich will..."

# game/scripts/c23/c23.rpy:2864
translate german c23s006_AfterBreakfastBetConfession_52142a7a:

    # mc "Principalmente la última razón. Creo que tienes la cabeza hecha un lío ahora mismo."
    mc "Hauptsächlich der letzte Grund. Ich glaube, du bist momentan völlig durcheinander."

# game/scripts/c23/c23.rpy:2865
translate german c23s006_AfterBreakfastBetConfession_98030007:

    # mc "Estás muy presionada con esta visita y me parece que estás buscando experiencias que viviste antes de ser monja por si tienes que dejar de serlo."
    mc "Sie stehen bei diesem Besuch unter großem Druck, und mir scheint, Sie suchen nach Erfahrungen, die Sie vor Ihrem Eintritt ins Kloster gemacht haben, für den Fall, dass Sie das Klosterleben wieder verlassen müssen."

# game/scripts/c23/c23.rpy:2867
translate german c23s006_AfterBreakfastBetConfession_19d38509:

    # bet "Empecé a sentir algo por ti antes de saber nada de esta visita..."
    bet "Ich habe schon Gefühle für dich entwickelt, bevor ich überhaupt etwas von diesem Besuch wusste..."

# game/scripts/c23/c23.rpy:2868
translate german c23s006_AfterBreakfastBetConfession_b986d233:

    # mc "Pero esos sentimientos han crecido desde que lo sabes, ¿verdad?"
    mc "Aber diese Gefühle haben sich seit deiner Entdeckung verstärkt, nicht wahr?"

# game/scripts/c23/c23.rpy:2869
translate german c23s006_AfterBreakfastBetConfession_726b97aa:

    # bet "Sí..."
    bet "Ja..."

# game/scripts/c23/c23.rpy:2870
translate german c23s006_AfterBreakfastBetConfession_8955be1d:

    # mc "Hagamos un trato. Resolvamos lo de la visita al obispado y después volvemos a hablar sobre cómo te sientes. ¿Te parece bien?"
    mc "Lass uns eine Abmachung treffen. Wir klären den Besuch im Bischofsbüro, und dann sprechen wir noch einmal darüber, wie es dir geht. Klingt das gut?"

# game/scripts/c23/c23.rpy:2871
translate german c23s006_AfterBreakfastBetConfession_de7d5078:

    # mc "De esa forma sabrás hacia dónde va tu vida y qué quieres hacer con ella."
    mc "So weißt du, wohin dein Leben führt und was du daraus machen willst."

# game/scripts/c23/c23.rpy:2873
translate german c23s006_AfterBreakfastBetConfession_df3e1714:

    # bet "Me parece un buen plan. Creo que tienes razón y que la incertidumbre de este viaje me está afectando más de lo que debería."
    bet "Das klingt nach einem guten Plan. Ich glaube, du hast recht, und die Ungewissheit bezüglich dieser Reise belastet mich mehr, als sie sollte."

# game/scripts/c23/c23.rpy:2876
translate german c23s006_AfterBreakfastBetConfession_90897d00:

    # bet "¿Qué? Ahora el que estás loco eres tú."
    bet "Was? Jetzt bist du derjenige, der verrückt ist."

# game/scripts/c23/c23.rpy:2877
translate german c23s006_AfterBreakfastBetConfession_3ce076c4:

    # mc "No quiero influir en tu decisión sobre qué hacer hoy pero, de todos los impedimentos que has puesto, es el único que veo insalvable."
    mc "Ich möchte Ihre Entscheidung, was Sie heute tun, nicht beeinflussen, aber von allen Hindernissen, die Sie sich in den Weg gelegt haben, ist dies das einzige, das ich als unüberwindbar ansehe."

# game/scripts/c23/c23.rpy:2878
translate german c23s006_AfterBreakfastBetConfession_1910dd40:

    # mc "Quiero que la decisión que tomes, la tomes por ti, no por mí. No tengo ningún derecho a pedirte que dejes de ser monja y no lo voy a hacer."
    mc "Ich möchte, dass du diese Entscheidung selbst triffst, nicht für mich. Ich habe kein Recht, dich aufzufordern, das Klosterleben aufzugeben, und ich werde es auch nicht tun."

# game/scripts/c23/c23.rpy:2880
translate german c23s006_AfterBreakfastBetConfession_55466a06:

    # bet "¿Me estás diciendo que, si no fuera monja, estarías conmigo?"
    bet "Willst du mir etwa sagen, dass du mit mir zusammen wärst, wenn ich keine Nonne wäre?"

# game/scripts/c23/c23.rpy:2881
translate german c23s006_AfterBreakfastBetConfession_4cecda61:

    # mc "Te estoy diciendo que, si no fueras monja, tendríamos una posibilidad de estar juntos."
    mc "Ich sage dir, wenn du keine Nonne wärst, hätten wir eine Chance, zusammen zu sein."

# game/scripts/c23/c23.rpy:2882
translate german c23s006_AfterBreakfastBetConfession_2e5cde8c:

    # mc "Sé que no estarías a gusto si pasara mientras aún lo eres. Y no quiero que esto pese en tu decisión de qué hacer hoy."
    mc "Ich weiß, dass es dir unangenehm wäre, wenn das passieren würde, solange du noch jung bist. Und ich möchte nicht, dass dies deine heutige Entscheidung beeinflusst."

# game/scripts/c23/c23.rpy:2884
translate german c23s006_AfterBreakfastBetConfession_844e3a3d:

    # bet "Pero no me puedes pedir eso..."
    bet "Aber das kannst du mich nicht fragen..."

# game/scripts/c23/c23.rpy:2885
translate german c23s006_AfterBreakfastBetConfession_8354474c:

    # mc "Exacto. NO te lo estoy pidiendo."
    mc "Genau. Ich bitte dich nicht darum."

# game/scripts/c23/c23.rpy:2886
translate german c23s006_AfterBreakfastBetConfession_a57d3d10:

    # mc "Cuando ese secretario te diga qué opciones tienes, deberás decidir qué quieres hacer con tu vida."
    mc "Wenn Ihnen die Sekretärin Ihre Optionen aufzeigt, müssen Sie entscheiden, was Sie mit Ihrem Leben anfangen wollen."

# game/scripts/c23/c23.rpy:2887
translate german c23s006_AfterBreakfastBetConfession_1440bb4c:

    # mc "Decidas lo que decidas, yo voy a apoyarte."
    mc "Was auch immer du entscheidest, ich werde dich unterstützen."

# game/scripts/c23/c23.rpy:2888
translate german c23s006_AfterBreakfastBetConfession_158f2936:

    # mc "Y no quiero que esa decisión tenga nada que ver con esta conversación. Lo tienes que decidir por lo que quieres tú."
    mc "Und ich möchte nicht, dass diese Entscheidung etwas mit diesem Gespräch zu tun hat. Du musst selbst entscheiden, was du willst."

# game/scripts/c23/c23.rpy:2890
translate german c23s006_AfterBreakfastBetConfession_24a83dd2:

    # bet "Estás pidiendo un imposible. ¿Cómo no voy a tener en cuenta lo que has dicho?"
    bet "Du verlangst das Unmögliche. Wie könnte ich deine Worte ignorieren?"

# game/scripts/c23/c23.rpy:2891
translate german c23s006_AfterBreakfastBetConfession_b6788258:

    # mc "Porque primero tienes que saber lo que te dicen. Después tienes que decidir qué quieres."
    mc "Denn zuerst müssen Sie wissen, was sie Ihnen sagen. Dann müssen Sie entscheiden, was Sie wollen."

# game/scripts/c23/c23.rpy:2892
translate german c23s006_AfterBreakfastBetConfession_30cf15e2:

    # mc "Si te dicen que puedes volver a África, ¿lo dejarías correr y dejarías de ser monja?"
    mc "Wenn man Ihnen die Möglichkeit gäbe, nach Afrika zurückzukehren, würden Sie diese Chance nutzen und Ihr Klosterleben aufgeben?"

# game/scripts/c23/c23.rpy:2894
translate german c23s006_AfterBreakfastBetConfession_690d08fe:

    # bet "Seguramente me arrepentiría si lo hiciera..."
    bet "Ich würde es wahrscheinlich bereuen, wenn ich es täte..."

# game/scripts/c23/c23.rpy:2895
translate german c23s006_AfterBreakfastBetConfession_36abd58f:

    # mc "Por eso tienes que decidir una vez sepas que opciones tienes. No en base a esta conversación, sino en base a lo que tú quieres hacer."
    mc "Deshalb müssen Sie erst dann eine Entscheidung treffen, wenn Sie Ihre Optionen kennen. Nicht basierend auf diesem Gespräch, sondern basierend auf Ihren eigenen Wünschen."

# game/scripts/c23/c23.rpy:2896
translate german c23s006_AfterBreakfastBetConfession_c27ce51f:

    # mc "Pero si decides dejar de ser monja, porque tú quieres dejar de serlo, me gustaría que tuviéramos una oportunidad."
    mc "Aber wenn du dich entscheidest, keine Nonne mehr zu sein, weil du es wirklich nicht mehr willst, würde ich mir wünschen, dass wir eine Chance bekommen."

# game/scripts/c23/c23.rpy:2898
translate german c23s006_AfterBreakfastBetConfession_4293882f:

    # mc "¿Y sabes una cosa, Tía [bet]? Pase lo que pase hoy, decidas lo que decidas, te voy a seguir queriendo. Todos lo vamos a hacer."
    mc "Und weißt du was, Tante? Was auch immer heute passiert, was auch immer du entscheidest, ich werde dich weiterhin lieben. Wir alle werden das."

# game/scripts/c23/c23.rpy:2900
translate german c23s006_AfterBreakfastBetConfession_c7e0f64c:

    # bet "Gracias, [mc]. Nadie podría pedir una familia mejor."
    bet "Vielen Dank, [mc]. Niemand könnte sich eine bessere Familie wünschen."

# game/scripts/c23/c23.rpy:2901
translate german c23s006_AfterBreakfastBetConfession_c8acdb43:

    # bet "Y sobre la familia..."
    bet "Und was die Familie betrifft..."

# game/scripts/c23/c23.rpy:2903
translate german c23s006_AfterBreakfastBetConfession_f63b975f:

    # "Pasáis los siguientes 40 minutos charlando de cómo ha cambiado la familia en los días que hace que llegaron las estudiantes, [bet] y [mee]."
    "Die nächsten 40 Minuten verbringt ihr damit, darüber zu plaudern, wie sich die Familie in den Tagen seit der Ankunft der Schüler [bet] und [mee] verändert hat."

# game/scripts/c23/c23.rpy:2904
translate german c23s006_AfterBreakfastBetConfession_53deecef:

    # "Ninguno de vosotros podría imaginar cómo iba a evolucionar. Los dos estáis contentos de cómo lo ha hecho."
    "Keiner von euch beiden hätte sich vorstellen können, wie es ausgehen würde. Ihr seid beide zufrieden damit, wie es gelaufen ist."

# game/scripts/c23/c23.rpy:2906
translate german c23s006_AfterBreakfastBetConfession_9abf102f:

    # "Dejáis la conversación aparcada para más adelante."
    "Du verschiebst das Gespräch auf später."

# game/scripts/c23/c23.rpy:2908
translate german c23s006_AfterBreakfastBetConfession_098d5e8b:

    # "Cuando estáis a mitad de la ruta..."
    "Wenn Sie die Hälfte der Strecke zurückgelegt haben..."

# game/scripts/c23/c23.rpy:2910
translate german c23s006_AfterBreakfastBetConfession_5e1f901f:

    # emm "*Bostezo* ¿Falta mucho? ¡Me estoy meando!"
    emm "*Gähn* Sind wir bald da? Ich muss mal dringend pinkeln!"

# game/scripts/c23/c23.rpy:2911
translate german c23s006_AfterBreakfastBetConfession_905c0ea0:

    # mc "*Risa* La Bella Durmiente se ha despertado y se ha convertido en La Bella Meona."
    mc "*Gelächter* Dornröschen ist aufgewacht und hat sich in die pinkelnde Schönheit verwandelt."

# game/scripts/c23/c23.rpy:2912
translate german c23s006_AfterBreakfastBetConfession_adb3d7ff:

    # mc "Queda poco más de una hora."
    mc "Es bleibt noch etwas mehr als eine Stunde."

# game/scripts/c23/c23.rpy:2914
translate german c23s006_AfterBreakfastBetConfession_5ce2ed8e:

    # emm "¿Podemos parar en algún bar de carretera? Os invito a desayunar de nuevo y así voy al lavabo."
    emm "Können wir an einer Raststätte anhalten? Ich lade dich wieder zum Frühstück ein, und dann kann ich die Toilette benutzen."

# game/scripts/c23/c23.rpy:2915
translate german c23s006_AfterBreakfastBetConfession_47b16007:

    # mc "*Risa* ¿Segundo desayuno? ¿Has comprobado si tienes los pies peludos?"
    mc "*Lacht* Zweites Frühstück? Hast du schon mal nachgeschaut, ob du behaarte Füße hast?"

# game/scripts/c23/c23.rpy:2917
translate german c23s006_AfterBreakfastBetConfession_98d377a6:

    # bet "Creo que [emm] no va a pillar la referencia."
    bet "Ich glaube nicht, dass [emm] die Referenz erkennen wird."

# game/scripts/c23/c23.rpy:2918
translate german c23s006_AfterBreakfastBetConfession_835c8bda:

    # mc "Yo creo que sí. Le gustan las películas de fantasía."
    mc "Ich glaube schon. Er mag Fantasyfilme."

# game/scripts/c23/c23.rpy:2920
translate german c23s006_AfterBreakfastBetConfession_2c8220af:

    # emm "¡Claro que lo he pillado! Es de El Señor de los Pendientes. No es tan buena como La Novia Princesa, pero no está mal."
    emm "Natürlich habe ich es! Es stammt aus „Der Herr der Ohrringe“. Es ist nicht so gut wie „Die Brautprinzessin“, aber auch nicht schlecht."

# game/scripts/c23/c23.rpy:2921
translate german c23s006_AfterBreakfastBetConfession_e116c8b7:

    # emm "Y me estoy meando."
    emm "Und ich muss gleich pinkeln."

# game/scripts/c23/c23.rpy:2922
translate german c23s006_AfterBreakfastBetConfession_4bdcfd18:

    # mc "*Risa* En cinco minutos pasaremos por King City. Hay varios sitios para comer allí."
    mc "*lacht* In fünf Minuten fahren wir durch King City. Dort gibt es mehrere Restaurants."

# game/scripts/c23/c23.rpy:2925
translate german c23s006_AfterBreakfastBetConfession_456d7e0d:

    # "Paráis a desayunar de nuevo en King City. [emm] apenas llega al lavabo."
    "Ihr macht in King City wieder Frühstückspause. [emm] Er schafft es gerade noch rechtzeitig zur Toilette."

# game/scripts/c23/c23.rpy:2926
translate german c23s006_AfterBreakfastBetConfession_7777aded:

    # "La única que pide un desayuno completo es [bet]. Ni siquiera la preocupación por la reunión le quita el hambre."
    "Die Einzige, die ein komplettes Frühstück verlangt, ist [bet]. Nicht einmal die Sorge um das Meeting nimmt ihr den Hunger."

# game/scripts/c23/c23.rpy:2933
translate german c23s006_Rent_0c456281:

    # "Finalmente llegáis a la agencia de alquiler de coches..."
    "Endlich erreichen Sie die Autovermietung..."

# game/scripts/c23/c23.rpy:2935
translate german c23s006_Rent_665081d0:

    # emm "¡Es precioso! ¡Pink Dreams! ¡Es un sueño hecho realidad!"
    emm "Es ist wunderschön! Pinke Träume! Ein Traum wird wahr!"

# game/scripts/c23/c23.rpy:2936
translate german c23s006_Rent_2000b3ce:

    # mc "Vamos antes de que me empiecen a sangrar los ojos con tanto rosa."
    mc "Lasst uns gehen, bevor mir von all dem Rosa die Augen bluten."

# game/scripts/c23/c23.rpy:2937
translate german c23s006_Rent_adfcaa2c:

    # emm "¡Qué poco gusto!"
    emm "Wie geschmacklos!"

# game/scripts/c23/c23.rpy:2939
translate german c23s006_Rent_48260182:

    # "Amber" "Hola, buenos días, soy Amber. ¿En qué puedo ayudarles?"
    "Amber" "Hallo, guten Morgen, ich bin Amber. Wie kann ich Ihnen helfen?"

# game/scripts/c23/c23.rpy:2940
translate german c23s006_Rent_6f08a874:

    # mc "Teníamos una reserva para un Ferrarini rosa. A nombre de [mc] Marks."
    mc "Wir hatten einen rosa Ferrarini reserviert. Auf den Namen von [mc] Marks."

# game/scripts/c23/c23.rpy:2941
translate german c23s006_Rent_91e507dd:

    # mcp "(¡Qué forma de destrozar esos coches pintándolos de rosa!)"
    mcp "(Was für eine Art, diese Autos zu ruinieren, indem man sie rosa lackiert!)"

# game/scripts/c23/c23.rpy:2943
translate german c23s006_Rent_c455070a:

    # "Amber mira directamente a [bet]."
    "Amber schaut direkt auf [bet]."

# game/scripts/c23/c23.rpy:2944
translate german c23s006_Rent_a2e96bfc:

    # "Amber" "He mirado el expediente y he visto que también ha contratado las clases de conducción segura para deportivos con nuestro instructor Chad."
    "Amber" "Ich habe mir die Akte angesehen und festgestellt, dass er auch Fahrstunden für sicheres Fahren mit Sportwagen bei unserem Fahrlehrer Chad gebucht hat."

# game/scripts/c23/c23.rpy:2945
translate german c23s006_Rent_9c578732:

    # "Amber" "En breve estará aquí. Justo a tiempo para que, cuando acabemos el papeleo, la pueda llevar a comer. La comida está incluida en el curso."
    "Amber" "Sie kommt gleich. Genau rechtzeitig, damit ich sie, sobald wir die Formalitäten erledigt haben, zum Mittagessen einladen kann. Das Mittagessen ist in der Kursgebühr enthalten."

# game/scripts/c23/c23.rpy:2947
translate german c23s006_Rent_75933c3b:

    # emm "¿Unas clases de conducción de deportivos? ¿Esa era la sorpresa? ¡Eres el mejor hermano del mundo!"
    emm "Fahrstunden mit einem Sportwagen? War das die Überraschung? Du bist der beste Bruder der Welt!"

# game/scripts/c23/c23.rpy:2948
translate german c23s006_Rent_fb5e1891:

    # mc "Conducción {b}segura{/b} de deportivos."
    mc "Sicheres Fahren von Sportwagen."

# game/scripts/c23/c23.rpy:2950
translate german c23s006_Rent_92805b84:

    # "Amber mira alternativamente a [emm] y a [bet] como si no entendiera nada."
    "Amber blickt abwechselnd auf [emm] und [bet], als ob sie gar nichts verstünde."

# game/scripts/c23/c23.rpy:2951
translate german c23s006_Rent_8755467d:

    # "Amber" "Perdón por la confusión. Esas clases las suelen contratar señoras... más maduras. Muchas de ellas repiten el curso."
    "Amber" "Entschuldigung für die Verwirrung. Diese Kurse werden üblicherweise von älteren Frauen besucht. Viele von ihnen wiederholen den Kurs."

# game/scripts/c23/c23.rpy:2952
translate german c23s006_Rent_faabfd68:

    # mc "En este caso, las lecciones son un regalo para mi hermana."
    mc "In diesem Fall sind die Lektionen ein Geschenk für meine Schwester."

# game/scripts/c23/c23.rpy:2954
translate german c23s006_Rent_e818b96a:

    # emm "No veo el Ferrarini aquí. ¿Dónde está? ¿Qué modelo es? ¿Podemos ir a verlo?"
    emm "Ich sehe den Ferrarini hier nicht. Wo ist er? Welches Modell ist es? Können wir ihn uns ansehen?"

# game/scripts/c23/c23.rpy:2955
translate german c23s006_Rent_d8ef348f:

    # mc "Veo que estás impaciente."
    mc "Ich sehe, du bist ungeduldig."

# game/scripts/c23/c23.rpy:2957
translate german c23s006_Rent_6805dc70:

    # "Amber" "Sí, podemos ir a verlo antes de hacer el papeleo. Sígame por aquí."
    "Amber" "Ja, wir können es uns ansehen, bevor wir die Unterlagen ausfüllen. Folgen Sie mir hier."

# game/scripts/c23/c23.rpy:2958
translate german c23s006_Rent_b26d677c:

    # "Amber" "Es nuestro modelo más valioso y lo tenemos apartado del resto."
    "Amber" "Es ist unser wertvollstes Modell und wir halten es von den übrigen Modellen getrennt."

# game/scripts/c23/c23.rpy:2960
translate german c23s006_Rent_26fcca02:

    # "Amber abre una puerta con un mando a distancia y allí está el peor atentado contra el buen gusto de la historia de la automoción."
    "Amber öffnet eine Tür mit einer Fernbedienung und da ist es, der schlimmste Affront gegen den guten Geschmack in der Geschichte des Automobils."

# game/scripts/c23/c23.rpy:2962
translate german c23s006_Rent_023fcdde:

    # emm "¡Oh! ¡Es el Ferrarini F69 de 2018! ¡Tiene 660 CV y puede llegar a 355 Km/h! ¡Me encanta este coche!"
    emm "Oh! Das ist der Ferrari F69 von 2018! Er hat 660 PS und erreicht eine Höchstgeschwindigkeit von 355 km/h! Ich liebe dieses Auto!"

# game/scripts/c23/c23.rpy:2964
translate german c23s006_Rent_d882cbb8:

    # emm "Pero este no se comercializó en ese color... Solo en rojo o en negro."
    emm "Dieses Modell wurde aber nicht in dieser Farbe verkauft... Nur in Rot oder Schwarz."

# game/scripts/c23/c23.rpy:2966
translate german c23s006_Rent_e89101dd:

    # "Amber" "Todos nuestros coches son pintados localmente para que proporcionen una experiencia más exclusiva."
    "Amber" "Alle unsere Fahrzeuge werden vor Ort lackiert, um ein exklusiveres Erlebnis zu bieten."

# game/scripts/c23/c23.rpy:2967
translate german c23s006_Rent_df9a0882:

    # "Amber" "Tenemos tres tonos de rosa dependiendo del tipo de coche."
    "Amber" "Wir haben drei Rosatöne, je nach Fahrzeugtyp."

# game/scripts/c23/c23.rpy:2969
translate german c23s006_Rent_f4a0d06c:

    # emm "¡Han hecho un trabajo exquisito! ¡Sácame una foto con el logo, [mc]!"
    emm "Das ist ihnen hervorragend gelungen! Mach ein Foto von mir mit dem Logo, [mc]!"

# game/scripts/c23/c23.rpy:2971
translate german c23s006_Rent_9ff5d38a:

    # emm "Que salga bien el Jaballino. Da lo mismo que no me encuadres bien a mí."
    emm "Ich hoffe, dem Wildschwein gelingt alles. Es ist egal, ob du mich richtig reinlegst."

# game/scripts/c23/c23.rpy:2972
translate german c23s006_Rent_2a0cfc61:

    # emm "Sí, ya sé que es Cinghialetto. Pero me gusta más como lo digo yo. Más fotos."
    emm "Ja, ich weiß, es heißt Cinghialetto. Aber mir gefällt meine Aussprache besser. Mehr Fotos."

# game/scripts/c23/c23.rpy:2973
translate german c23s006_Rent_a2af1c25:

    # mc "Creo que sería mejor fuera que en un garaje."
    mc "Ich denke, es wäre draußen besser als in einer Garage."

# game/scripts/c23/c23.rpy:2974
translate german c23s006_Rent_34c9d6a6:

    # emm "¡Ya habrá tiempo para eso! ¡Hazme un par de fotos ahora!"
    emm "Dafür ist später noch Zeit! Mach jetzt ein paar Fotos von mir!"

# game/scripts/c23/c23.rpy:2976
translate german c23s006_Rent_f8177bba:

    # "Tomas varias fotos de [emm] posando con el coche. Apenas se atreve a tocarlo."
    "Du machst mehrere Fotos von [emm], wie sie mit dem Auto posiert. Sie traut sich kaum, es zu berühren."

# game/scripts/c23/c23.rpy:2978
translate german c23s006_Rent_d7fbe99b:

    # "Amber" "Miren, por allí llega nuestro instructor Chad. Se ha adelantado."
    "Amber" "Seht mal, da kommt unser Ausbilder Chad. Er ist schon vorausgegangen."

# game/scripts/c23/c23.rpy:2979
translate german c23s006_Rent_229f631e:

    # "Amber" "Buenos días, Chad."
    "Amber" "Guten Morgen, Chad."

# game/scripts/c23/c23.rpy:2981
translate german c23s006_Rent_f5ba0928:

    # "Puedes entender por qué las señoras maduras contratan el curso de conducción."
    "Man kann verstehen, warum sich reifere Damen für den Fahrkurs anmelden."

# game/scripts/c23/c23.rpy:2982
translate german c23s006_Rent_b2741f27:

    # "Chad se dirige directamente a [bet]."
    "Chad geht direkt zu [bet]."

# game/scripts/c23/c23.rpy:2983
translate german c23s006_Rent_db84fff6:

    # "Chad" "Buenos días, señora. ¿Preparada para la mejor experiencia automovilística de su vida con Chad?"
    "Chad" "Guten Morgen, meine Dame. Sind Sie bereit für das beste Auto-Erlebnis Ihres Lebens mit Chad?"

# game/scripts/c23/c23.rpy:2985
translate german c23s006_Rent_aff2351e:

    # bet "*Risa* Creo que te equivocas, Chad."
    bet "*Lacht* Ich glaube, du irrst dich, Chad."

# game/scripts/c23/c23.rpy:2987
translate german c23s006_Rent_9409452e:

    # bet "Amber, ¿me puedes decir dónde está el lavabo? Voy a ir a cambiarme mientras le presenta a Chad a su clienta."
    bet "Amber, kannst du mir sagen, wo die Toilette ist? Ich ziehe mich um, während sie Chad ihrem Kunden vorstellt."

# game/scripts/c23/c23.rpy:2989
translate german c23s006_Rent_479bdf44:

    # "Unos minutos después, una vez acabadas las presentaciones y el papeleo..."
    "Ein paar Minuten später, nachdem die Begrüßung und der Papierkram erledigt waren..."

# game/scripts/c23/c23.rpy:2990
translate german c23s006_Rent_c060a39f:

    # emm "Entonces nos vemos aquí en tres horas, ¿no?"
    emm "Wir sehen uns also in drei Stunden hier, richtig?"

# game/scripts/c23/c23.rpy:2991
translate german c23s006_Rent_41170b53:

    # mc "Bueno, la reunión es en una hora y media. No sé cuánto durará."
    mc "Nun ja, das Treffen ist in anderthalb Stunden. Ich weiß nicht, wie lange es dauern wird."

# game/scripts/c23/c23.rpy:2992
translate german c23s006_Rent_847e04d9:

    # mc "El curso de conducción segura acaba en tres horas, con lo que seguramente nosotros acabaremos antes."
    mc "Der Fahrsicherheitskurs endet in drei Stunden, wir werden also wahrscheinlich vorher fertig sein."

# game/scripts/c23/c23.rpy:2994
translate german c23s006_Rent_2a10c184:

    # emm "Conducción segura {b}de deportivos{/b}. *Risa*"
    emm "Sicheres Fahren mit Sportwagen. *Gelächter*"

# game/scripts/c23/c23.rpy:2995
translate german c23s006_Rent_a0fc9c2e:

    # mc "Sí, vale. Te he mandado la dirección del motel en el que nos alojaremos, por si nos retrasamos y quieres ir a descansar."
    mc "Ja, okay. Ich habe dir die Adresse des Motels geschickt, in dem wir übernachten werden, falls wir uns verspäten und du dich ausruhen möchtest."

# game/scripts/c23/c23.rpy:2996
translate german c23s006_Rent_a0644686:

    # mc "En cuanto acabemos te llamo y quedamos en algún sitio."
    mc "Sobald wir fertig sind, rufe ich dich an und wir treffen uns irgendwo."

# game/scripts/c23/c23.rpy:2997
translate german c23s006_Rent_339f1f96:

    # emm "Perfecto."
    emm "Perfekt."

# game/scripts/c23/c23.rpy:3000
translate german c23s006_Rent_bd67ed74:

    # emm "*Susurrando* Te daría un beso, pero seguro que Amber se escandaliza después de decirle que eras mi hermano."
    emm "*flüsternd* Ich würde dich ja küssen, aber ich bin mir sicher, Amber wäre entsetzt, wenn ich ihr sagen würde, dass du mein Bruder bist."

# game/scripts/c23/c23.rpy:3001
translate german c23s006_Rent_6b4f6085:

    # mc "*Susurrando* No creo que se escandalice demasiado, teniendo en cuenta las señoras maduras que contratan a Chad. *Risa*"
    mc "*flüstert* Ich glaube nicht, dass sie allzu schockiert sein wird, wenn man bedenkt, welche reifen Damen Chad einstellen. *lacht*"

# game/scripts/c23/c23.rpy:3003
translate german c23s006_Rent_33a146cb:

    # emm "*Susurrando* Creo que el curso para señoras maduras con Chad debe incluir alguna cosa más que conducir, viendo su aspecto."
    emm "*flüstert* Wenn man sich Chads Kurs für reife Damen so ansieht, muss er wohl mehr als nur Autofahren beinhalten."

# game/scripts/c23/c23.rpy:3004
translate german c23s006_Rent_74a6046c:

    # mc "*Susurrando* Estoy seguro de ello."
    mc "*flüstert* Da bin ich mir sicher."

# game/scripts/c23/c23.rpy:3006
translate german c23s006_Rent_9fdb4cfa:

    # emm "*Susurrando* Pues que no espere nada conmigo. No es para nada mi tipo."
    emm "*flüstert* Nun, sie sollte nichts von mir erwarten. Sie ist überhaupt nicht mein Typ."

# game/scripts/c23/c23.rpy:3008
translate german c23s006_Rent_aa8ef0d9:

    # emm "*Susurrando* Me gustan más como tú."
    emm "*flüstert* Ich mag sie lieber so wie dich."

# game/scripts/c23/c23.rpy:3009
translate german c23s006_Rent_a2cc8b2a:

    # mc "*Risa* Te veo luego. [bet] ya está saliendo del lavabo."
    mc "*Lacht* Bis später. [bet] Sie kommt schon aus dem Badezimmer."

# game/scripts/c23/c23.rpy:3011
translate german c23s006_Rent_e7b71ffd:

    # bet "Disfruta del coche y no dejes que Chad haga nada que no debe, [emm]."
    bet "Genieß das Auto und lass Chad nichts tun, was er nicht tun sollte, [emm]."

# game/scripts/c23/c23.rpy:3012
translate german c23s006_Rent_a312c07f:

    # mc "*Risa* Precisamente estábamos hablando de eso."
    mc "*lacht* Genau darüber haben wir doch gerade gesprochen."

# game/scripts/c23/c23.rpy:3014
translate german c23s006_Rent_3a64c416:

    # bet "¿Nos vamos, entonces?"
    bet "Sollen wir dann gehen?"

# game/scripts/c23/c23.rpy:3015
translate german c23s006_Rent_ded19230:

    # mcp "(Claramente no tiene ganas de ir a esa reunión. Yo tampoco las tendría.)"
    mcp "(Offensichtlich möchte sie nicht zu diesem Treffen gehen. Ich auch nicht.)"

# game/scripts/c23/c23.rpy:3016
translate german c23s006_Rent_8fbff358:

    # mc "Sí, vámonos."
    mc "Ja, los geht's."

# game/scripts/c23/c23.rpy:3018
translate german c23s006_Rent_53d871ed:

    # emm "Suerte, Tía [bet]."
    emm "Viel Glück, Tante [bet]."

# game/scripts/c23/c23.rpy:3019
translate german c23s006_Rent_6a4fac72:

    # mcp "(A veces [emm] es sorprendentemente maravillosa.)"
    mcp "(Manchmal ist [emm] überraschend wunderbar.)"

# game/scripts/c23/c23.rpy:3021
translate german c23s006_Rent_303d6258:

    # bet "Gracias, cielo."
    bet "Danke, Schatz."

# game/scripts/c23/c23.rpy:3026
translate german c23s006_RideBetChurch_f874252a:

    # "Después de una comida en la que intentas levantarle los ánimos sin éxito, llevas a [bet] a la catedral de Monterey."
    "Nach einer Mahlzeit, bei der du erfolglos versuchst, ihn aufzuheitern, nimmst du [bet] mit zur Kathedrale von Monterey."

# game/scripts/c23/c23.rpy:3027
translate german c23s006_RideBetChurch_7b15b09b:

    # "La reunión tendrá lugar en un edificio cercano a la catedral."
    "Das Treffen findet in einem Gebäude in der Nähe der Kathedrale statt."

# game/scripts/c23/c23.rpy:3028
translate german c23s006_RideBetChurch_b5b10e17:

    # bet "Aquí estamos..."
    bet "Da sind wir also..."

# game/scripts/c23/c23.rpy:3029
translate german c23s006_RideBetChurch_dd568640:

    # mc "No tienes ganas de entrar, ¿verdad?"
    mc "Du hast keine Lust, hineinzugehen, oder?"

# game/scripts/c23/c23.rpy:3031
translate german c23s006_RideBetChurch_2beddb44:

    # bet "Ahora mismo me apetecería más pegarme un martillazo en el pie que entrar ahí."
    bet "Im Moment würde ich mir lieber mit dem Hammer auf den Fuß schlagen, als da reinzugehen."

# game/scripts/c23/c23.rpy:3032
translate german c23s006_RideBetChurch_cdb4a5bb:

    # mc "Te entiendo. Pero ¿sabes qué me decía [nor] cuando no quería hacer algo de niño?"
    mc "Ich verstehe. Aber weißt du, was [nor] mir immer gesagt hat, wenn ich etwas Kindisches nicht tun wollte?"

# game/scripts/c23/c23.rpy:3034
translate german c23s006_RideBetChurch_46d10b95:

    # bet "Que cuanto antes lo hicieras, antes podrías dedicarte a otras cosas que te gustan más."
    bet "Je eher du es tust, desto eher kannst du dich anderen Dingen widmen, die dir mehr Spaß machen."

# game/scripts/c23/c23.rpy:3035
translate german c23s006_RideBetChurch_9ef0b9a7:

    # mc "Veo que la frase tiene raíces profundas en la familia. Son exactamente las mismas palabras."
    mc "Ich sehe, dass der Ausdruck tiefe Wurzeln in der Familie hat. Es sind genau die gleichen Worte."

# game/scripts/c23/c23.rpy:3037
translate german c23s006_RideBetChurch_86fa3e95:

    # bet "*Risa triste* Es una frase que nos decía mi abuela cuando íbamos a visitarla a Missouri."
    bet "*Trauriges Lachen* Das ist ein Satz, den meine Großmutter immer zu uns sagte, wenn wir sie in Missouri besuchten."

# game/scripts/c23/c23.rpy:3039
translate german c23s006_RideBetChurch_791a2692:

    # bet "Tu bisabuela se la decía a [nor] y a [mar]. Es una frase que suelen decir las abuelas de la familia."
    bet "Deine Urgroßmutter sagte das immer zu [nor] und [mar]. Das ist eine Redewendung, die Großmütter in der Familie oft benutzen."

# game/scripts/c23/c23.rpy:3041
translate german c23s006_RideBetChurch_78a73330:

    # bet "Mi madre se la decía a [nor]. Es una frase que suelen decir las abuelas de la familia."
    bet "Meine Mutter pflegte das zu sagen. Es ist eine Redewendung, die Großmütter in der Familie oft benutzen."

# game/scripts/c23/c23.rpy:3042
translate german c23s006_RideBetChurch_5435b956:

    # mc "Y ahora invertimos el proceso y te la digo yo, igual que [nor] me la dijo a mí."
    mc "Und nun kehren wir den Prozess um und ich werde es Ihnen genau so sagen, wie [nor] es mir gesagt hat."

# game/scripts/c23/c23.rpy:3043
translate german c23s006_RideBetChurch_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Soll ich dich begleiten?"

# game/scripts/c23/c23.rpy:3045
translate german c23s006_RideBetChurch_83e3f56b:

    # bet "Gracias, pero será mejor que entre sola. De todas formas, a la reunión no puedes asistir."
    bet "Danke, aber es wäre besser, wenn sie allein hineinginge. Sie können jedenfalls nicht an der Besprechung teilnehmen."

# game/scripts/c23/c23.rpy:3046
translate german c23s006_RideBetChurch_b6b048eb:

    # mc "Entonces iré al motel a dejar las maletas y vuelvo a buscarte. He visto un café en el que puedo esperarte."
    mc "Dann gehe ich ins Motel, um mein Gepäck abzustellen, und komme gleich wieder, um dich abzuholen. Ich habe ein Café gesehen, wo ich auf dich warten kann."

# game/scripts/c23/c23.rpy:3047
translate german c23s006_RideBetChurch_ef862ae9:

    # mc "Llámame cuando salgas y vengo en dos minutos."
    mc "Ruf mich an, wenn du gehst, und ich bin in zwei Minuten da."

# game/scripts/c23/c23.rpy:3049
translate german c23s006_RideBetChurch_854f9db8:

    # bet "Me parece perfecto. No sé cuánto voy a tardar y no quiero que te quedes en el coche todo este rato."
    bet "Das klingt perfekt. Ich weiß nicht, wie lange ich weg sein werde, und ich möchte nicht, dass du die ganze Zeit im Auto bleibst."

# game/scripts/c23/c23.rpy:3050
translate german c23s006_RideBetChurch_5155cd4f:

    # mc "¿Quieres un abrazo antes de ir?"
    mc "Möchtest du vor deiner Abreise noch eine Umarmung?"

# game/scripts/c23/c23.rpy:3052
translate german c23s006_RideBetChurch_7dc9295c:

    # bet "Me encantaría, pero mejor no. *Risa triste* Si me abrazas ahora no voy a querer ir."
    bet "Ich würde ja gern, aber vielleicht doch nicht. *Trauriges Lachen* Wenn du mich jetzt umarmst, will ich nicht mehr gehen."

# game/scripts/c23/c23.rpy:3053
translate german c23s006_RideBetChurch_6bc1a3fa:

    # mc "Entonces sin abrazos."
    mc "Also keine Umarmungen."

# game/scripts/c23/c23.rpy:3054
translate german c23s006_RideBetChurch_7a2874a6:

    # mc "Suerte, Tía [bet]."
    mc "Viel Glück, Tante [bet]."

# game/scripts/c23/c23.rpy:3056
translate german c23s006_RideBetChurch_303d6258:

    # bet "Gracias, cielo."
    bet "Danke, Schatz."

# game/scripts/c23/c23.rpy:3058
translate german c23s006_RideBetChurch_59dfcd2a:

    # "Puedes ver como Tía [bet] se dirige al edificio de oficinas de la diócesis con los hombros hundidos, como un fantasma azul."
    "Man kann Tante [bet] sehen, wie sie mit hängenden Schultern wie ein blauer Geist auf das Diözesanbürogebäude zugeht."

# game/scripts/c23/c23.rpy:3059
translate german c23s006_RideBetChurch_9d3303d5:

    # "La batalla que tenga que librar ahí dentro está perdida antes de empezar."
    "Der Kampf, den er dort ausfechten muss, ist schon verloren, bevor er überhaupt begonnen hat."

# game/scripts/c23/c23.rpy:3061
translate german c23s006_RideBetChurch_1635f2b6:

    # "Vas al motel a dejar las maletas de [bet] y [emm] en una habitación y tu mochila en otra."
    "Du gehst zum Motel, um die Koffer von [bet] und [emm] in einem Zimmer und deinen Rucksack in einem anderen zu deponieren."

# game/scripts/c23/c23.rpy:3062
translate german c23s006_RideBetChurch_ceec7348:

    # "[bet] ha dejado la ropa que llevaba puesta para el viaje en la camioneta. La dejas allí por si se quiere cambiar después."
    "[bet] Sie hat die Kleidung, die sie für die Reise trug, im Van gelassen. Man lässt sie dort, falls sie sich später umziehen möchte."

# game/scripts/c23/c23.rpy:3063
translate german c23s006_RideBetChurch_76d4436f:

    # "Vuelves al barrio de la catedral y te tomas un café en una heladería a tres minutos del edificio donde [bet] está teniendo la reunión."
    "Sie kehren ins Domviertel zurück und trinken einen Kaffee in einer Eisdiele, die drei Minuten von dem Gebäude entfernt ist, in dem [bet] die Sitzung abhält."

# game/scripts/c23/c23.rpy:3064
translate german c23s006_RideBetChurch_8b918e17:

    # "No disfrutas del café. Estás casi tan nervioso por el resultado como lo estaba [bet] al entrar."
    "Du genießt den Kaffee nicht. Du bist fast genauso nervös wegen des Ergebnisses wie ich es war, als ich reinkam."

# game/scripts/c23/c23.rpy:3070
translate german c23s006_FerrariniGirl_df34c2a7:

    # "La reunión se alarga tanto que [emm] te llama para decirte que ya ha acabado el curso."
    "Das Meeting zieht sich so lange hin, dass [emm] Sie anruft, um Ihnen mitzuteilen, dass der Kurs beendet ist."

# game/scripts/c23/c23.rpy:3072
translate german c23s006_FerrariniGirl_185cb950:

    # emm "Hey, [mc]. ¿Aún no habéis acabado la reunión?"
    emm "Hey, [mc]. Bist du mit dem Meeting noch nicht fertig?"

# game/scripts/c23/c23.rpy:3074
translate german c23s006_FerrariniGirl_41cb7534:

    # mc "No, estoy esperando a que Tía [bet] me llame para recogerla e ir a buscarte."
    mc "Nein, ich warte darauf, dass Tante [bet] mich anruft, damit ich sie abholen und dich holen kann."

# game/scripts/c23/c23.rpy:3076
translate german c23s006_FerrariniGirl_e6d88fd1:

    # emm "No te preocupes por mí. Ya he acabado el curso y voy a conducir un rato. ¡Este coche es increíble!"
    emm "Mach dir keine Sorgen um mich. Ich habe den Kurs beendet und fahre jetzt eine Runde. Dieses Auto ist der Wahnsinn!"

# game/scripts/c23/c23.rpy:3077
translate german c23s006_FerrariniGirl_b5b66e29:

    # mc "¿Qué tal el curso?"
    mc "Wie war der Kurs?"

# game/scripts/c23/c23.rpy:3079
translate german c23s006_FerrariniGirl_67eda2dc:

    # emm "¡Genial! Aunque estoy casi segura de que Chad se saca un extra como gigoló con las maduras, realmente es un profesional."
    emm "Großartig! Obwohl ich mir fast sicher bin, dass Chad sich als Gigolo mit älteren Frauen etwas dazuverdient, ist er ein echter Profi."

# game/scripts/c23/c23.rpy:3080
translate german c23s006_FerrariniGirl_80d5d336:

    # emm "Fue piloto de pruebas en un equipo de la WEC durante varios años."
    emm "Er war mehrere Jahre lang Testfahrer für ein WEC-Team."

# game/scripts/c23/c23.rpy:3081
translate german c23s006_FerrariniGirl_f4eba33d:

    # mc "¿WEC?"
    mc "WEC?"

# game/scripts/c23/c23.rpy:3083
translate german c23s006_FerrariniGirl_4977e205:

    # emm "El World Endurance Championship, el mundial de resistencia... 24 horas de Le Mans y ese tipo de carreras."
    emm "Die FIA Langstrecken-Weltmeisterschaft, die FIA Langstrecken-Weltmeisterschaft... die 24 Stunden von Le Mans und solche Rennen."

# game/scripts/c23/c23.rpy:3085
translate german c23s006_FerrariniGirl_6c6bc686:

    # emm "A veces parece que el hombre en esta relación sea yo. No sabes nada de coches."
    emm "Manchmal habe ich das Gefühl, ich bin der Mann in dieser Beziehung. Du hast keine Ahnung von Autos."

# game/scripts/c23/c23.rpy:3087
translate german c23s006_FerrariniGirl_38254f85:

    # emm "A veces parece que yo sea el hermano y tú la hermana. No sabes nada de coches."
    emm "Manchmal kommt es mir so vor, als wäre ich der Bruder und du die Schwester. Du hast überhaupt keine Ahnung von Autos."

# game/scripts/c23/c23.rpy:3089
translate german c23s006_FerrariniGirl_49730f47:

    # emm "¡Pero alquilas unos coches de puta madre!"
    emm "Aber ihr vermietet echt verdammt gute Autos!"

# game/scripts/c23/c23.rpy:3090
translate german c23s006_FerrariniGirl_ac6e7f7f:

    # mc "Me alegra que lo estés disfrutando. Me hubiera gustado estar contigo y que lo disfrutáramos juntos."
    mc "Es freut mich, dass es dir gefällt. Ich wäre so gerne dabei gewesen und wir hätten es gemeinsam genossen."

# game/scripts/c23/c23.rpy:3092
translate german c23s006_FerrariniGirl_ea46b0f5:

    # emm "A mí también me hubiera gustado, pero entiendo que no podemos dejar a Tía [bet] sola."
    emm "Ich hätte es auch gern getan, aber ich verstehe, dass wir Tante [bet] nicht allein lassen können."

# game/scripts/c23/c23.rpy:3093
translate german c23s006_FerrariniGirl_b635a88c:

    # mc "*Risa* Tu concepto de \"podemos\" es un poco especial. Yo estoy aquí y tú estás conduciendo un coche hortera."
    mc "*Lacht* Deine Vorstellung von „Wir können“ ist etwas seltsam. Ich bin hier und du fährst so ein protziges Auto."

# game/scripts/c23/c23.rpy:3095
translate german c23s006_FerrariniGirl_a9df7e34:

    # emm "*Risa* ¡Qué poco gusto tienes para los coches!"
    emm "*lacht* Du hast echt einen schlechten Geschmack bei Autos!"

# game/scripts/c23/c23.rpy:3096
translate german c23s006_FerrariniGirl_fe44a410:

    # mc "Eso es discutible. *Risa* Si no se comercializaba en rosa, por algo será..."
    mc "Darüber lässt sich streiten. *lacht* Wenn es nicht in Rosa verkauft wurde, muss das einen Grund haben..."

# game/scripts/c23/c23.rpy:3097
translate german c23s006_FerrariniGirl_1f2f1237:

    # mc "Por cierto, sabes que si te ponen una multa de velocidad me tocará pagarla a mí, ¿verdad?"
    mc "Übrigens, du weißt schon, dass ich den Strafzettel bezahlen muss, wenn du wegen Geschwindigkeitsübertretung erwischt wirst, oder?"

# game/scripts/c23/c23.rpy:3099
translate german c23s006_FerrariniGirl_7304d0d2:

    # mc "Aunque sea un coche de alquiler, las multas llegan igualmente. Y te las pienso pasar a ti para que las pagues."
    mc "Auch wenn es sich um einen Mietwagen handelt, fallen die Strafgebühren trotzdem an. Und ich werde sie Ihnen weiterleiten, damit Sie sie bezahlen können."

# game/scripts/c23/c23.rpy:3102
translate german c23s006_FerrariniGirl_507c29bd:

    # emm "¡Oops! No lo sabía. Pero no te preocupes... no estoy corriendo... {b}demasiado{/b}."
    emm "Ups! Das wusste ich nicht. Aber keine Sorge... ich renne nicht... zu viel."

# game/scripts/c23/c23.rpy:3103
translate german c23s006_FerrariniGirl_6f48d758:

    # mc "*Risa* Ese \"demasiado\" me da mucho miedo."
    mc "*lacht* Dieses \"zu viel\" macht mir große Angst."

# game/scripts/c23/c23.rpy:3105
translate german c23s006_FerrariniGirl_ff2af8d1:

    # emm "Una pregunta, ¿mi nombre está en algún sitio en el motel? Es decir... ¿puedo ir y pedir una llave de la habitación?"
    emm "Eine Frage: Steht mein Name irgendwo im Motel auf der Liste? Kann ich hingehen und nach einem Zimmerschlüssel fragen?"

# game/scripts/c23/c23.rpy:3106
translate german c23s006_FerrariniGirl_9188fde9:

    # mc "Sí, ya he avisado en la recepción que era posible que fueras y les pidieras una llave. Estás en la habitación número 6."
    mc "Ja, ich habe der Rezeption bereits Bescheid gegeben, dass Sie eventuell nach einem Schlüssel fragen möchten. Ihr Zimmer ist Nummer 6."

# game/scripts/c23/c23.rpy:3107
translate german c23s006_FerrariniGirl_9165b904:

    # mc "¿Por qué? ¿Estás cansada?"
    mc "Warum? Bist du müde?"

# game/scripts/c23/c23.rpy:3109
translate german c23s006_FerrariniGirl_bbed22e2:

    # emm "No, es que es posible que compre algunas cosas para las chicas y me gustaría dejarlas en la habitación en vez de llevarlas en el coche todo el día."
    emm "Nein, es ist nur so, dass ich vielleicht ein paar Sachen für die Mädchen kaufen möchte und sie lieber im Zimmer lassen würde, anstatt sie den ganzen Tag im Auto mit mir herumzutragen."

# game/scripts/c23/c23.rpy:3110
translate german c23s006_FerrariniGirl_2dd5ec5c:

    # mc "¿Has visto algún souvenir? *Risa* Solo espero que no necesites comprar una cuarta maleta para llevar los regalos."
    mc "Hast du schon Souvenirs gesehen? *lacht* Ich hoffe nur, du brauchst keinen vierten Koffer, um all die Geschenke zu transportieren."

# game/scripts/c23/c23.rpy:3112
translate german c23s006_FerrariniGirl_0a8e6cd1:

    # emm "Más o menos. *Risita* Te veo luego. Avísame cuando Tía [bet] acabe, a ver dónde estoy."
    emm "So ungefähr. *Kichern* Bis später. Sag mir Bescheid, wenn Tante [bet] fertig ist, damit ich weiß, wo ich bin."

# game/scripts/c23/c23.rpy:3113
translate german c23s006_FerrariniGirl_031b37f6:

    # mc "Si conduces demasiado, es posible que acabes en San Francisco... *Risa* con un montón de multas de velocidad."
    mc "Wer zu viel Auto fährt, landet am Ende vielleicht in San Francisco... *lacht* mit einer ganzen Reihe von Strafzetteln wegen Geschwindigkeitsübertretung."

# game/scripts/c23/c23.rpy:3114
translate german c23s006_FerrariniGirl_9c47d0e7:

    # emm "No te preocupes. *Risa* No voy a llegar tan lejos. Hasta luego."
    emm "Keine Sorge. *lacht* So weit gehe ich nicht. Bis später."

# game/scripts/c23/c23.rpy:3119
translate german c23s006_AfterTheMeeting_44117e4a:

    # "Media hora y dos cafés después, [bet] te avisa de que ya ha salido. Le propones ir a buscarla, pero cuando le dices dónde estás, decide unirse a ti en el café."
    "Eine halbe Stunde und zwei Tassen Kaffee später teilt dir [bet] mit, dass sie schon weg ist. Du schlägst vor, sie zu suchen, aber als du ihr sagst, wo du bist, beschließt sie, dich im Café zu begleiten."

# game/scripts/c23/c23.rpy:3120
translate german c23s006_AfterTheMeeting_7529841f:

    # "Avisas a [emm] de que [bet] ya está llegando y le mandas tu ubicación. Está en el motel y llegará en 15 minutos."
    "Sie benachrichtigen [emm], dass [bet] unterwegs ist, und senden ihm Ihren Standort. Er befindet sich im Motel und wird in 15 Minuten eintreffen."

# game/scripts/c23/c23.rpy:3121
translate german c23s006_AfterTheMeeting_54937a4c:

    # "La monja llega cinco minutos después y se va inmediatamente a poner la ropa que llevaba durante el viaje mientras llega la chica del Ferrarini."
    "Die Nonne trifft fünf Minuten später ein und zieht sich sofort die Kleidung an, die sie während der Reise getragen hat, während das Mädchen von Ferrarini eintrifft."

# game/scripts/c23/c23.rpy:3122
translate german c23s006_AfterTheMeeting_2f523696:

    # "[bet] no quiere empezar a explicarte cómo ha ido la reunión para tener que volver a hacerlo cuando llegue [emm]."
    "[bet] möchte nicht anfangen zu erklären, wie das Treffen verlaufen ist, nur um es dann noch einmal tun zu müssen, wenn [emm] eintrifft."

# game/scripts/c23/c23.rpy:3124
translate german c23s006_AfterTheMeeting_89a31f19:

    # "Cuando estáis los tres por fin sentados a la mesa..."
    "Wenn ihr drei endlich am Tisch sitzt..."

# game/scripts/c23/c23.rpy:3126
translate german c23s006_AfterTheMeeting_76548f66:

    # emm "Me muero de impaciencia, Tía [bet]. ¿Qué te han dicho?"
    emm "Ich sterbe vor Ungeduld, Tante [bet]. Was haben sie dir erzählt?"

# game/scripts/c23/c23.rpy:3128
translate german c23s006_AfterTheMeeting_140ce337:

    # bet "El secretario me ha dicho que hice bien en negarme a operar a aquel muchacho."
    bet "Die Sekretärin sagte mir, ich hätte richtig gehandelt, als ich die Operation des Jungen ablehnte."

# game/scripts/c23/c23.rpy:3129
translate german c23s006_AfterTheMeeting_1fd1471c:

    # mc "Eso es bueno, ¿no?"
    mc "Das ist gut, nicht wahr?"

# game/scripts/c23/c23.rpy:3130
translate german c23s006_AfterTheMeeting_fce9380f:

    # bet "Pero que hice mal en informar a su padre, el jefe tribal, de que el obispo Bakari le había engañado diciéndole que la homosexualidad se podía curar."
    bet "Aber ich habe mich geirrt, als ich seinem Vater, dem Stammeshäuptling, mitteilte, dass Bischof Bakari ihn getäuscht habe, indem er sagte, Homosexualität sei heilbar."

# game/scripts/c23/c23.rpy:3131
translate german c23s006_AfterTheMeeting_96743008:

    # bet "El obispo es una figura muy importante en la iglesia de Tanzania y... ha pedido mi cabeza."
    bet "Der Bischof ist eine sehr wichtige Persönlichkeit in der Kirche in Tansania und... er hat meinen Kopf gefordert."

# game/scripts/c23/c23.rpy:3133
translate german c23s006_AfterTheMeeting_63794710:

    # emm "¡Que hijo de puta! Supongo que se refiere a que no vuelvas a Tanzania, ¿no?"
    emm "Was für ein Mistkerl! Ich nehme an, er meint, man solle nicht nach Tansania zurückkehren, richtig?"

# game/scripts/c23/c23.rpy:3135
translate german c23s006_AfterTheMeeting_5d2c44a7:

    # bet "Ni a Tanzania ni a ningún otro lugar de África."
    bet "Nicht nach Tansania, noch an irgendeinen anderen Ort in Afrika."

# game/scripts/c23/c23.rpy:3136
translate german c23s006_AfterTheMeeting_34cb8151:

    # mc "Entonces solo te queda lo de trabajar en hospitales en California..."
    mc "Dann bleibt Ihnen nur noch die Möglichkeit, in Krankenhäusern in Kalifornien zu arbeiten..."

# game/scripts/c23/c23.rpy:3138
translate german c23s006_AfterTheMeeting_078df519:

    # bet "Eso tampoco."
    bet "Das auch nicht."

# game/scripts/c23/c23.rpy:3139
translate german c23s006_AfterTheMeeting_ae35ad01:

    # bet "La iglesia me da dos opciones. Entrar en un convento de clausura en los Estados Unidos o jubilación en otro convento de mi elección en Latinoamérica."
    bet "Die Kirche stellt mich vor die Wahl: entweder in ein Klausurkloster in den Vereinigten Staaten einzutreten oder mich in ein anderes Kloster meiner Wahl in Lateinamerika zurückzuziehen."

# game/scripts/c23/c23.rpy:3141
translate german c23s006_AfterTheMeeting_86c23442:

    # emm "¿Por qué? No lo entiendo. ¿Tú lo entiendes?"
    emm "Warum? Ich verstehe das nicht. Verstehst du das?"

# game/scripts/c23/c23.rpy:3142
translate german c23s006_AfterTheMeeting_2b63b98c:

    # mc "Si está aquí en un convento en el que pueda hablar con la prensa, podría liarla parda. Por eso aquí el convento es de clausura."
    mc "Wäre sie hier in einem Kloster, wo sie mit der Presse sprechen könnte, könnte sie ein riesiges Chaos anrichten. Deshalb ist dieses Kloster so abgeschottet."

# game/scripts/c23/c23.rpy:3143
translate german c23s006_AfterTheMeeting_0c2b8817:

    # mc "Si está jubilada en un convento en... yo qué sé... Nicaragua o Bolivia... La prensa de allí no le prestará atención."
    mc "Wenn sie sich in einem Kloster in... ich weiß nicht... Nicaragua oder Bolivien zur Ruhe gesetzt hat... wird die Presse dort ihr keine Beachtung schenken."

# game/scripts/c23/c23.rpy:3144
translate german c23s006_AfterTheMeeting_f27c25a1:

    # mc "Y si habla con la prensa, la iglesia puede decir que la jubilaron con antelación porque ya no pensaba con claridad."
    mc "Und wenn sie mit der Presse spricht, kann die Kirche sagen, dass sie vorzeitig in den Ruhestand versetzt wurde, weil sie nicht mehr klar denken konnte."

# game/scripts/c23/c23.rpy:3146
translate german c23s006_AfterTheMeeting_1c2fa445:

    # mc "¿Me equivoco?"
    mc "Liege ich falsch?"

# game/scripts/c23/c23.rpy:3147
translate german c23s006_AfterTheMeeting_28a3741f:

    # bet "No lo ha dicho así, pero tienes razón sobre sus motivos."
    bet "So hat er es zwar nicht ausgedrückt, aber du hast Recht, was seine Motive angeht."

# game/scripts/c23/c23.rpy:3148
translate german c23s006_AfterTheMeeting_e064dfa2:

    # bet "Sea como sea no volveré a ejercer en ningún hospital."
    bet "Wie dem auch sei, ich werde nie wieder in einem Krankenhaus arbeiten."

# game/scripts/c23/c23.rpy:3150
translate german c23s006_AfterTheMeeting_94f0859e:

    # emm "No volverás a ejercer si sigues siendo monja, ¿no?"
    emm "Sie werden Ihren Beruf nicht mehr ausüben können, wenn Sie Nonne bleiben, nicht wahr?"

# game/scripts/c23/c23.rpy:3151
translate german c23s006_AfterTheMeeting_6e09d1d7:

    # emm "Podrías dejar la iglesia y seguir trabajando. Problema resuelto."
    emm "Du könntest die Kirche verlassen und weiterarbeiten. Problem gelöst."

# game/scripts/c23/c23.rpy:3153
translate german c23s006_AfterTheMeeting_94c7a5e2:

    # bet "Me tendría que volver a certificar para poder ejercer de cirujana en los Estados Unidos."
    bet "Ich müsste mich erneut zertifizieren lassen, um in den Vereinigten Staaten als Chirurg praktizieren zu dürfen."

# game/scripts/c23/c23.rpy:3154
translate german c23s006_AfterTheMeeting_d0b6a0d2:

    # bet "Y eso vale dinero, no tengo ni idea de cuánto. En mi plan de trabajar en hospitales católicos, esa certificación la pagaba la iglesia..."
    bet "Und das kostet Geld, ich habe keine Ahnung, wie viel. In meinem Plan, in katholischen Krankenhäusern zu arbeiten, sollte die Kirche die Kosten für diese Zertifizierung übernehmen..."

# game/scripts/c23/c23.rpy:3155
translate german c23s006_AfterTheMeeting_e6940cd5:

    # mc "Por el dinero no te preocupes."
    mc "Mach dir keine Sorgen ums Geld."

# game/scripts/c23/c23.rpy:3157
translate german c23s006_AfterTheMeeting_050d8cb9:

    # emm "Tenemos una empresa millonaria. Podemos pagar tu certificación sin problemas."
    emm "Wir sind ein Unternehmen mit einem Umsatz in Millionenhöhe. Wir können Ihre Zertifizierung problemlos bezahlen."

# game/scripts/c23/c23.rpy:3158
translate german c23s006_AfterTheMeeting_0b57ea3e:

    # mc "Bueno, no con dinero de NTR. Sería un gasto injustificable."
    mc "Nun ja, nicht mit dem Geld von NTR. Das wäre eine nicht zu rechtfertigende Ausgabe."

# game/scripts/c23/c23.rpy:3159
translate german c23s006_AfterTheMeeting_6009a7e8:

    # mc "Pero yo puedo pedir un adelanto de mi sueldo para pagar por tu certificación. Y dudo que el CEO de NTR lo rechace."
    mc "Ich könnte aber einen Gehaltsvorschuss für Ihre Zertifizierung beantragen. Und ich bezweifle, dass der CEO von NTR das ablehnen würde."

# game/scripts/c23/c23.rpy:3161
translate german c23s006_AfterTheMeeting_55389b78:

    # bet "No os puedo pedir eso..."
    bet "Das kann ich dir nicht zumuten..."

# game/scripts/c23/c23.rpy:3162
translate german c23s006_AfterTheMeeting_99751757:

    # mc "No lo estás pidiendo. Lo estamos ofreciendo nosotros."
    mc "Sie fragen nicht danach. Wir bieten es an."

# game/scripts/c23/c23.rpy:3163
translate german c23s006_AfterTheMeeting_f0ef9c25:

    # mc "El sábado voy a actuar como CEO por primera vez, y pienso cobrar por ello. Ese dinero es tuyo para la certificación."
    mc "Am Samstag übernehme ich zum ersten Mal die Rolle des CEO und werde dafür bezahlt. Das Geld gehört Ihnen für die Zertifizierung."

# game/scripts/c23/c23.rpy:3165
translate german c23s006_AfterTheMeeting_82ed1e9d:

    # bet "..."
    bet "..."

# game/scripts/c23/c23.rpy:3166
translate german c23s006_AfterTheMeeting_f878632a:

    # mc "Tía [bet]... ¿Estás bien?"
    mc "Tante [bet]... Alles in Ordnung bei dir?"

# game/scripts/c23/c23.rpy:3168
translate german c23s006_AfterTheMeeting_b5b31101:

    # emm "¿Qué pasa, Tía?"
    emm "Was ist los, Tante?"

# game/scripts/c23/c23.rpy:3170
translate german c23s006_AfterTheMeeting_6423ffeb:

    # bet "No me merezco esta familia..."
    bet "Ich verdiene diese Familie nicht..."

# game/scripts/c23/c23.rpy:3171
translate german c23s006_AfterTheMeeting_3c3e34d0:

    # mc "Te mereces esto y más."
    mc "Du verdienst das und noch viel mehr."

# game/scripts/c23/c23.rpy:3173
translate german c23s006_AfterTheMeeting_0db44c4a:

    # emm "Estoy de acuerdo con [mc]. Todos querríamos ayudarte, y todo el mundo estaba muy preocupado por tu situación."
    emm "Ich stimme [mc] zu. Wir alle wollten dir helfen, und jeder war sehr besorgt um deine Situation."

# game/scripts/c23/c23.rpy:3174
translate german c23s006_AfterTheMeeting_54b45c27:

    # emm "Si [mc] se negara a sí mismo el adelanto de sueldo, estoy segura de que entre todas conseguiríamos el dinero para tu certificación."
    emm "Wenn [mc] seinen Gehaltsvorschuss ablehnen würde, bin ich sicher, dass wir gemeinsam das Geld für Ihre Zertifizierung aufbringen könnten."

# game/scripts/c23/c23.rpy:3176
translate german c23s006_AfterTheMeeting_93f90172:

    # emm "Seguro que para alguien como [lis] y [deb.nick], lo que cuesta la certificación es calderilla, y dijeron que podíamos contar con ellas para lo que necesitáramos."
    emm "Ich bin mir sicher, dass für jemanden wie [lis] und [deb.nick] die Zertifizierungskosten Peanuts sind, und sie sagten, wir könnten uns bei allem, was wir brauchen, auf sie verlassen."

# game/scripts/c23/c23.rpy:3177
translate german c23s006_AfterTheMeeting_e9157e62:

    # emm "Aunque no hablamos de dinero, claro, porque no sabíamos que eso podría ser el problema."
    emm "Über Geld haben wir natürlich nicht gesprochen, denn wir wussten ja nicht, dass das das Problem sein könnte."

# game/scripts/c23/c23.rpy:3179
translate german c23s006_AfterTheMeeting_55001268:

    # mc "Todo el mundo va a querer ayudarte. No te preocupes por eso."
    mc "Jeder wird dir helfen wollen. Mach dir darüber keine Sorgen."

# game/scripts/c23/c23.rpy:3180
translate german c23s006_AfterTheMeeting_761152f7:

    # bet "Pero..."
    bet "Aber..."

# game/scripts/c23/c23.rpy:3182
translate german c23s006_AfterTheMeeting_6819fc88:

    # emm "Y [dap] y [sca] te ayudarán a estudiar si es necesario... Hay que estudiar para la certificación, ¿no?"
    emm "Und [dap] und [sca] helfen Ihnen bei Bedarf beim Lernen... Sie müssen ja für die Zertifizierung lernen, richtig?"

# game/scripts/c23/c23.rpy:3183
translate german c23s006_AfterTheMeeting_f6ee4e4b:

    # emm "Yo también te ayudaría, pero no tengo ni idea de medicina."
    emm "Ich würde dir auch helfen, aber ich kenne mich überhaupt nicht mit Medizin aus."

# game/scripts/c23/c23.rpy:3185
translate german c23s006_AfterTheMeeting_597e2389:

    # bet "Chicos... me estáis emocionando..."
    bet "Leute... ihr bringt mich zum Weinen..."

# game/scripts/c23/c23.rpy:3186
translate german c23s006_AfterTheMeeting_a7073025:

    # mc "La familia está para eso, Tía [bet]. No sólo para cuando todo va bien, sino para apoyarnos cuando hay algún problema."
    mc "Dafür ist Familie da, Tante [bet]. Nicht nur, wenn alles gut läuft, sondern um uns zu unterstützen, wenn es ein Problem gibt."

# game/scripts/c23/c23.rpy:3187
translate german c23s006_AfterTheMeeting_9da09452:

    # mc "¿Cuándo les tienes que dar una respuesta?"
    mc "Wann müssen Sie ihnen antworten?"

# game/scripts/c23/c23.rpy:3189
translate german c23s006_AfterTheMeeting_cd37e247:

    # bet "Me han dado dos meses para pensármelo. Mañana tengo que pasar a recoger una documentación sobre los diferentes conventos que proponen."
    bet "Sie haben mir zwei Monate Bedenkzeit gegeben. Morgen muss ich mir Unterlagen zu den verschiedenen Klöstern besorgen, die sie vorschlagen."

# game/scripts/c23/c23.rpy:3190
translate german c23s006_AfterTheMeeting_21bc1964:

    # bet "Todo eso, obviamente, bajo la condición de que no hable con la prensa nunca."
    bet "All das natürlich unter der Bedingung, dass ich niemals mit der Presse spreche."

# game/scripts/c23/c23.rpy:3191
translate german c23s006_AfterTheMeeting_a57063ee:

    # mc "¿Qué te pueden hacer si hablas con la prensa?"
    mc "Was können sie Ihnen antun, wenn Sie mit der Presse sprechen?"

# game/scripts/c23/c23.rpy:3193
translate german c23s006_AfterTheMeeting_79da8654:

    # bet "Podrían eliminar la opción del convento en Latinoamérica, que era la menos mala."
    bet "Sie könnten die Klosteroption in Lateinamerika abschaffen, die die am wenigsten schlechte war."

# game/scripts/c23/c23.rpy:3194
translate german c23s006_AfterTheMeeting_c2fe0315:

    # bet "De todas formas, no pensaba hablar con la prensa. No serviría de nada. El obispo Bakari no se vería afectado."
    bet "Ich hatte ohnehin nicht vor, mit der Presse zu sprechen. Es hätte nichts gebracht. Bischof Bakari wäre davon nicht betroffen gewesen."

# game/scripts/c23/c23.rpy:3196
translate german c23s006_AfterTheMeeting_2dc9513a:

    # emm "Bueno, como no vas a hablar con la prensa ni vas a coger esa opción, no tenemos que hablar de eso ahora."
    emm "Da Sie nicht mit der Presse sprechen oder diese Option wählen werden, brauchen wir jetzt nicht darüber zu reden."

# game/scripts/c23/c23.rpy:3197
translate german c23s006_AfterTheMeeting_df7a30d6:

    # mc "Tienes razón, [emm]. Ahora hay dos meses para sopesar opciones y pensar en qué podemos hacer y cómo hacerlo."
    mc "Du hast Recht, [emm]. Jetzt haben wir zwei Monate Zeit, um die verschiedenen Optionen abzuwägen und darüber nachzudenken, was wir tun können und wie wir es tun können."

# game/scripts/c23/c23.rpy:3199
translate german c23s006_AfterTheMeeting_aa316288:

    # bet "No hay mucho que pensar. Si me prestáis el dinero..."
    bet "Da gibt es nicht viel zu überlegen. Wenn du mir das Geld leihst..."

# game/scripts/c23/c23.rpy:3200
translate german c23s006_AfterTheMeeting_33e8120e:

    # mc "No es un préstamo, es un regalo."
    mc "Es ist kein Darlehen, es ist ein Geschenk."

# game/scripts/c23/c23.rpy:3202
translate german c23s006_AfterTheMeeting_ae5cced6:

    # bet "{b}Si me prestáis el dinero{/b} para certificarme, creo que mi mejor opción sería abandonar la iglesia..."
    bet "Wenn Sie mir das Geld für die Zertifizierung leihen, wäre es meiner Meinung nach am besten, die Kirche zu verlassen..."

# game/scripts/c23/c23.rpy:3203
translate german c23s006_AfterTheMeeting_8f7740d3:

    # bet "Y empezar a buscar trabajo como cirujana... a mi edad... Ufff..."
    bet "Und jetzt, in meinem Alter, nach einem Job als Chirurg suchen zu müssen... Ach..."

# game/scripts/c23/c23.rpy:3204
translate german c23s006_AfterTheMeeting_b233d797:

    # mc "Bueno, si piensas que es la mejor opción no vamos a intentar convencerte de lo contrario. Tienes dos meses para pensártelo."
    mc "Wenn Sie der Meinung sind, dass dies die beste Option ist, werden wir nicht versuchen, Sie vom Gegenteil zu überzeugen. Sie haben zwei Monate Zeit, darüber nachzudenken."

# game/scripts/c23/c23.rpy:3206
translate german c23s006_AfterTheMeeting_c2e00819:

    # emm "Y para alegrarte un poco el día, hoy invito yo a pizza."
    emm "Und um Ihnen den Tag ein wenig zu verschönern, lade ich Sie heute auf eine Pizza ein."

# game/scripts/c23/c23.rpy:3207
translate german c23s006_AfterTheMeeting_462726fc:

    # emm "Por si estabas triste había buscado pizzerías con buenas reseñas."
    emm "Falls du dich niedergeschlagen fühlst, habe ich nach Pizzerien mit guten Bewertungen gesucht."

# game/scripts/c23/c23.rpy:3208
translate german c23s006_AfterTheMeeting_c25289da:

    # mc "A veces eres sorprendente, [emm]. Cada vez más."
    mc "Manchmal bist du einfach unglaublich, [emm]. Immer mehr."

# game/scripts/c23/c23.rpy:3210
translate german c23s006_AfterTheMeeting_64416a28:

    # bet "¿Crees que me puedes comprar con comida, [emm]?"
    bet "Glaubst du, du kannst mich mit Essen bestechen, [emm]?"

# game/scripts/c23/c23.rpy:3212
translate german c23s006_AfterTheMeeting_6010d2ad:

    # emm "No quería que sonara así, Tía... perdona..."
    emm "Ich wollte nicht, dass es so klingt, Tante... Es tut mir leid..."

# game/scripts/c23/c23.rpy:3214
translate german c23s006_AfterTheMeeting_40b9e80e:

    # bet "Porque si lo crees, tienes toda la razón. *Risa*"
    bet "Denn wenn du das glaubst, hast du absolut Recht. *lacht*"

# game/scripts/c23/c23.rpy:3215
translate german c23s006_AfterTheMeeting_db62733e:

    # mc "*Risa* Vamos al motel a ducharnos y vamos a ver qué pizzería ha encontrado [emm]."
    mc "*Lacht* Lass uns ins Motel gehen, duschen und mal sehen, was die Pizzeria [emm] gefunden hat."

# game/scripts/c23/c23.rpy:3218
translate german c23s006_AfterTheMeeting_afab1693:

    # "Ver que se han abierto más opciones de las que había planteado la iglesia ayuda a mejorar los ánimos."
    "Die Erkenntnis, dass sich mehr Optionen eröffnet haben als die von der Kirche vorgeschlagenen, trägt zur Stimmungsverbesserung bei."

# game/scripts/c23/c23.rpy:3219
translate german c23s006_AfterTheMeeting_8401a92d:

    # "Vais al motel a ducharos y cambiaros de ropa. Te pones la camisa azul."
    "Du gehst ins Motel, um zu duschen und dich umzuziehen. Du ziehst das blaue Hemd an."

# game/scripts/c23/c23.rpy:3228
translate german c23s007_AmaCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c23/c23.rpy:3229
translate german c23s007_AmaCalls_26e5f8ba:

    # "Suena tu teléfono, es [ama]."
    "Dein Telefon klingelt, es ist [ama]."

# game/scripts/c23/c23.rpy:3233
translate german c23s007_AmaCalls_b9b20d75:

    # mc "Hola, [ama]. ¿Puedo ayudarte en algo?"
    mc "Hallo [ama]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c23/c23.rpy:3235
translate german c23s007_AmaCalls_921677e6:

    # ama "Sólo llamábamos para saber cómo había ido la reunión de Tía [bet]. No queremos molestarla a ella."
    ama "Wir haben nur angerufen, um zu erfahren, wie Tantes Treffen verlaufen ist. Wir wollen sie nicht stören."

# game/scripts/c23/c23.rpy:3236
translate german c23s007_AmaCalls_d1e46081:

    # eva "Hubiéramos llamado antes, pero no sabíamos a qué hora iba a terminar la reunión."
    eva "Wir hätten früher angerufen, aber wir wussten nicht, wann das Treffen enden würde."

# game/scripts/c23/c23.rpy:3237
translate german c23s007_AmaCalls_8279e80c:

    # mc "Bueno, ha ido como uno de los peores escenarios que habíamos pensado."
    mc "Nun, es hat sich als eines der schlimmsten Szenarien, die wir uns ausgemalt hatten, erwiesen."

# game/scripts/c23/c23.rpy:3238
translate german c23s007_AmaCalls_8e598236:

    # mc "La propuesta de la iglesia es que se retire a un convento."
    mc "Die Kirche schlägt vor, dass sie sich in ein Kloster zurückzieht."

# game/scripts/c23/c23.rpy:3240
translate german c23s007_AmaCalls_d1718586:

    # eva "¡Putos cabrones! ¿Necesitas que hagamos una visita a ese obispo para convencerle... sutilmente?"
    eva "Ihr verdammten Bastarde! Sollen wir dem Bischof einen Besuch abstatten, um ihn... subtil zu überzeugen?"

# game/scripts/c23/c23.rpy:3241
translate german c23s007_AmaCalls_ba40ba01:

    # mc "No, [eva]. Tía [bet] tiene que darles una respuesta en dos meses, con lo que hay tiempo para pensar qué quiere hacer."
    mc "Nein, [eva]. Tante [bet] muss ihnen in zwei Monaten eine Antwort geben, also hat sie noch Zeit, darüber nachzudenken, was sie tun möchte."

# game/scripts/c23/c23.rpy:3243
translate german c23s007_AmaCalls_99d6c0b8:

    # ama "Si quieres... podemos buscar cosas sobre ese obispo, o sobre el de Tanzania, para poder hacer más presión y que cambien de opinión."
    ama "Wenn Sie möchten, können wir uns diesen Bischof oder den in Tansania genauer ansehen, um mehr Druck auf sie auszuüben und sie zum Umdenken zu bewegen."

# game/scripts/c23/c23.rpy:3244
translate german c23s007_AmaCalls_b04b3be0:

    # mc "Creo que Tía [bet] no querría eso. Ahora mismo se siente como que no pertenece a la Iglesia. Se siente traicionada."
    mc "Ich glaube nicht, dass Tante [bet] das wollen würde. Im Moment hat sie das Gefühl, nicht mehr in die Kirche zu gehören. Sie fühlt sich verraten."

# game/scripts/c23/c23.rpy:3245
translate german c23s007_AmaCalls_b86234e6:

    # mc "Por eso se tomará estos meses para sopesar dejar de ser monja. Casi lo ha decidido ya."
    mc "Deshalb nutzt sie diese Monate, um über einen Austritt aus dem Kloster nachzudenken. Sie hat sich fast schon entschieden."

# game/scripts/c23/c23.rpy:3247
translate german c23s007_AmaCalls_2dbe68e6:

    # ama "Es lógico. La quieren esconder después de lo de Tanzania, y eso es cruel."
    ama "Das ist verständlich. Sie wollen sie nach dem, was in Tansania passiert ist, verstecken, und das ist grausam."

# game/scripts/c23/c23.rpy:3248
translate german c23s007_AmaCalls_7cad4306:

    # mc "Por lo que me ha explicado, esa es exactamente su intención, que acabe sus días en un sitio donde no moleste."
    mc "Aus seinen Ausführungen geht hervor, dass genau dies seine Absicht ist: seine Tage an einem Ort zu verbringen, an dem er niemandem zur Last fällt."

# game/scripts/c23/c23.rpy:3249
translate german c23s007_AmaCalls_5d374c27:

    # mc "Y donde no pueda hablar con la prensa."
    mc "Und wo ich nicht mit der Presse sprechen kann."

# game/scripts/c23/c23.rpy:3251
translate german c23s007_AmaCalls_5f6a0907:

    # eva "¡Putos cabrones! Necesito dispararle a algo. Dale un abrazo de mi parte a Tía [bet]."
    eva "Ihr verdammten Mistkerle! Ich muss irgendwas erschießen. Umarmt Tante [bet] ganz lieb von mir."

# game/scripts/c23/c23.rpy:3252
translate german c23s007_AmaCalls_9fa74b4e:

    # mc "¡[eva]!"
    mc "[eva]!"

# game/scripts/c23/c23.rpy:3254
translate german c23s007_AmaCalls_7a9a2ae8:

    # ama "Ya se ha ido. Cuando se le desatan sentimientos que no puede controlar hace prácticas de tiro. Ya lo viste ayer."
    ama "Er ist weg. Wenn er Gefühle hat, die er nicht kontrollieren kann, geht er zum Schießtraining. Du hast ihn gestern gesehen."

# game/scripts/c23/c23.rpy:3255
translate german c23s007_AmaCalls_6991613d:

    # mc "Espero no enfadarla nunca..."
    mc "Ich hoffe, ich habe sie nie verärgert..."

# game/scripts/c23/c23.rpy:3258
translate german c23s007_AmaCalls_26a478e8:

    # ama "Hasta vuestra primera cita, como mínimo, estás seguro. *Risa*"
    ama "Bis zu eurem ersten Date bist du zumindest sicher. *lacht*"

# game/scripts/c23/c23.rpy:3259
translate german c23s007_AmaCalls_60db5d70:

    # mc "Entonces tendremos la primera cita dentro de muchos años. *Risa*"
    mc "Dann haben wir unser erstes Date seit vielen Jahren. *lacht*"

# game/scripts/c23/c23.rpy:3260
translate german c23s007_AmaCalls_a787076b:

    # ama "Si la retrasas mucho dejarás de estar seguro también. *Risa*"
    ama "Wenn du es zu lange hinauszögerst, wirst du dir auch nicht mehr sicher sein. *lacht*"

# game/scripts/c23/c23.rpy:3262
translate german c23s007_AmaCalls_06c6a38d:

    # ama "Si no te disparó ayer después de rechazarla, supongo que puedes considerarte seguro."
    ama "Wenn sie dich gestern nicht erschossen hat, nachdem du sie abgewiesen hast, kannst du dich wohl in Sicherheit wiegen."

# game/scripts/c23/c23.rpy:3263
translate german c23s007_AmaCalls_826e85ca:

    # mc "¿Necesitas algo más? Iba a llevar a las chicas a cenar..."
    mc "Brauchst du sonst noch etwas? Ich wollte eigentlich mit den Mädchen essen gehen..."

# game/scripts/c23/c23.rpy:3265
translate german c23s007_AmaCalls_4edac293:

    # ama "Solo una cosa más. Es una idea que se les ha ocurrido a Jamaal y a [nor], pero puede esperar si tienes prisa."
    ama "Nur noch eine Sache. Es ist eine Idee, die Jamaal schon hatte [nor], aber sie kann warten, wenn es eilt."

# game/scripts/c23/c23.rpy:3266
translate german c23s007_AmaCalls_a9665a34:

    # mc "No, tranquila, [emm] aún se está acabando de vestir. Dime."
    mc "Nein, keine Sorge, sie zieht sich noch an. Sag mir Bescheid."

# game/scripts/c23/c23.rpy:3268
translate german c23s007_AmaCalls_7762f7d9:

    # ama "Jamaal y yo estábamos hablando de lo de los asistentes a la fiesta del barco de Iron Fist cuando ha aparecido [nor]."
    ama "Jamaal und ich unterhielten uns gerade über die Teilnehmer der Iron Fist Bootsparty, als [nor] auftauchte."

# game/scripts/c23/c23.rpy:3269
translate german c23s007_AmaCalls_61d4ff67:

    # ama "[nor] es muy inteligente y ha estado pensando en que, si reconvertimos NTR en una empresa médica, el nombre puede ser un lastre."
    ama "[nor] ist sehr intelligent und hat darüber nachgedacht, dass der Name NTR ein Nachteil sein könnte, wenn wir ihn in ein Medizintechnikunternehmen umbenennen."

# game/scripts/c23/c23.rpy:3270
translate german c23s007_AmaCalls_e7d42cd0:

    # mc "*Risa* Ese nombre sería un lastre fuera como fuera."
    mc "*Gelächter* Dieser Name wäre so oder so eine Belastung."

# game/scripts/c23/c23.rpy:3272
translate german c23s007_AmaCalls_187a4d9b:

    # ama "Algo parecido ha dicho Jamaal, pero no entiendo por qué."
    ama "Jamaal hat etwas Ähnliches gesagt, aber ich verstehe nicht, warum."

# game/scripts/c23/c23.rpy:3273
translate german c23s007_AmaCalls_02086512:

    # ama "[nor] lo decía porque NTR tiene un pasado militar y, en este país, puede ser un problema."
    ama "[nor] Ich sagte das, weil NTR eine militärische Vergangenheit hat und das in diesem Land ein Problem darstellen kann."

# game/scripts/c23/c23.rpy:3274
translate german c23s007_AmaCalls_f594ed77:

    # mc "Tiene razón, pero no por el pasado militar, sino por las operaciones encubiertas. La gente desconfía de lo que se le oculta."
    mc "Er hat Recht, aber nicht aufgrund seiner militärischen Vergangenheit, sondern wegen der verdeckten Operationen. Die Menschen misstrauen dem, was ihnen verborgen bleibt."

# game/scripts/c23/c23.rpy:3275
translate german c23s007_AmaCalls_c2426e12:

    # mc "¿Ha propuesto cambiarle el nombre a la empresa?"
    mc "Haben Sie vorgeschlagen, den Firmennamen zu ändern?"

# game/scripts/c23/c23.rpy:3277
translate german c23s007_AmaCalls_06b509fe:

    # ama "Más que cambiarle el nombre, crear una empresa filial y traspasar toda la actividad médica allí. Al menos a nivel comercial."
    ama "Anstatt den Namen zu ändern, wäre es besser, eine Tochtergesellschaft zu gründen und alle medizinischen Aktivitäten dorthin zu verlagern. Zumindest auf kommerzieller Ebene."

# game/scripts/c23/c23.rpy:3278
translate german c23s007_AmaCalls_ac8b2401:

    # mc "Me parece bien. Así NTR quedará para soporte a otras empresas de operaciones encubiertas y la nueva empresa se ocupará de todo el tema médico."
    mc "Das klingt gut. So kann NTR auch andere Unternehmen für verdeckte Operationen unterstützen, und das neue Unternehmen übernimmt alle medizinischen Aspekte."

# game/scripts/c23/c23.rpy:3280
translate german c23s007_AmaCalls_a9164267:

    # ama "A Jamaal también le ha parecido una buena idea. Incluso se le ha ocurrido un nombre. Harnessing Advanced Research for Enhancing Medicine."
    ama "Jamaal fand die Idee ebenfalls gut. Er hatte sogar schon einen Namen dafür: „Fortschrittliche Forschung zur Verbesserung der Medizin nutzen“."

# game/scripts/c23/c23.rpy:3281
translate german c23s007_AmaCalls_0a88ead0:

    # ama "Aprovechar la investigación avanzada para mejorar la medicina. Aunque me parece un poco largo"
    ama "Die Nutzung fortschrittlicher Forschung zur Verbesserung der Medizin. Obwohl es mir etwas langatmig erscheint."

# game/scripts/c23/c23.rpy:3282
translate german c23s007_AmaCalls_72c20cb4:

    # mc "A mí me parece un buen nombre, podemos usar siglas como NTR..."
    mc "Ich finde, das ist ein guter Name; wir können Akronyme wie NTR verwenden..."

# game/scripts/c23/c23.rpy:3283
translate german c23s007_AmaCalls_5367af7b:

    # mc "Espera..."
    mc "Warten..."

# game/scripts/c23/c23.rpy:3284
translate german c23s007_AmaCalls_91f9fbdb:

    # mc "*Risa* Jamaal es un capullo."
    mc "*lacht* Jamaal ist ein Idiot."

# game/scripts/c23/c23.rpy:3286
translate german c23s007_AmaCalls_5dc56569:

    # ama "¿Qué pasa?"
    ama "Was passiert?"

# game/scripts/c23/c23.rpy:3287
translate german c23s007_AmaCalls_5ceedf9e:

    # mc "¿No te has dado cuenta de cuáles serían las siglas? H.A.R.E.M."
    mc "Ist dir nicht klar, wofür das Akronym steht? HAREM"

# game/scripts/c23/c23.rpy:3289
translate german c23s007_AmaCalls_18aedd9b:

    # ama "¡Me ha tomado el pelo! *Risa* Voy a decirle a [eva] que practique tiro contra sus ruedas."
    ama "Er hat mich veräppelt! *lacht* Ich werde [eva] sagen, er soll üben, auf seine eigenen Reifen zu schießen."

# game/scripts/c23/c23.rpy:3290
translate german c23s007_AmaCalls_2459552a:

    # mc "*Risa* Si Jamaal empieza a gastarte bromas, significa que está dejando de teneros miedo. Es su forma de daros la bienvenida a la familia."
    mc "*lacht* Wenn Jamaal anfängt, dich zu necken, bedeutet das, dass er seine Angst vor dir überwindet. Es ist seine Art, dich in der Familie willkommen zu heißen."

# game/scripts/c23/c23.rpy:3291
translate german c23s007_AmaCalls_4dfc6171:

    # mc "*Risa* Pero sigue pareciéndome un buen nombre. Sigue la línea de NTR y GILF."
    mc "*Lacht* Aber ich finde den Namen trotzdem gut. Er passt zum NTR- und GILF-Trend."

# game/scripts/c23/c23.rpy:3293
translate german c23s007_AmaCalls_f5d9ea6d:

    # ama "Continúo sin entender qué tiene de malo NTR."
    ama "Ich verstehe immer noch nicht, was an NTR so schlimm sein soll."

# game/scripts/c23/c23.rpy:3294
translate german c23s007_AmaCalls_290dcc15:

    # mc "Mucho, [ama]. Mucho."
    mc "Sehr viel, [ama]. Sehr viel."

# game/scripts/c23/c23.rpy:3296
translate german c23s007_AmaCalls_f3cd91b4:

    # mc "Puedes preguntárselo a [deb.nick] cuando la veas. *Risa*"
    mc "Du kannst sie fragen, wenn du sie siehst. *lacht*"

# game/scripts/c23/c23.rpy:3299
translate german c23s007_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c23/c23.rpy:3300
translate german c23s007_AmaCalls_6aeda812:

    # emm "*A través de la puerta* [mc], ya estamos listas. Te esperamos en el coche."
    emm "*Durch die Tür* [mc], wir sind bereit. Wir warten im Auto auf Sie."

# game/scripts/c23/c23.rpy:3301
translate german c23s007_AmaCalls_c02ac796:

    # mc "Ahora voy. Un segundo."
    mc "Ich komme. Einen Moment bitte."

# game/scripts/c23/c23.rpy:3303
translate german c23s007_AmaCalls_7bd50a56:

    # ama "Ve antes de que [emm] se impaciente. *Risa* No sé si ese hotel tiene tienda de regalos, pero podría empezar a comprar cosas rosas."
    ama "Geh, bevor [emm] ungeduldig wird. *Lacht* Ich weiß nicht, ob das Hotel einen Souvenirladen hat, aber ich könnte anfangen, pinke Sachen zu kaufen."

# game/scripts/c23/c23.rpy:3304
translate german c23s007_AmaCalls_a54e5e50:

    # mc "*Risa* No te preocupes, no hay tienda de regalos."
    mc "*Lacht* Keine Sorge, es gibt keinen Souvenirladen."

# game/scripts/c23/c23.rpy:3305
translate german c23s007_AmaCalls_cdc39172:

    # mc "Os mantengo informadas de cómo va lo de Tía [bet] mañana."
    mc "Ich halte dich morgen auf dem Laufenden, wie es Tante [bet] geht."

# game/scripts/c23/c23.rpy:3307
translate german c23s007_AmaCalls_a6bb3df2:

    # mc "Y has dicho que estaré seguro hasta la primera cita con [eva]. Tú y yo tenemos que planificar la nuestra también."
    mc "Und du sagtest, ich wäre bis zum ersten Date mit [eva] sicher. Wir beide müssen unseres auch planen."

# game/scripts/c23/c23.rpy:3309
translate german c23s007_AmaCalls_ac110be9:

    # mc "Y tú y yo tenemos una cita que planificar."
    mc "Und wir beide müssen einen Termin vereinbaren."

# game/scripts/c23/c23.rpy:3312
translate german c23s007_AmaCalls_13fd4da7:

    # ama "No te preocupes por eso. El otro día en el café cuenta como nuestra primera cita. Hubo besos. Suficiente para mí, al menos por ahora."
    ama "Mach dir keine Sorgen. Der Besuch im Café neulich zählt als unser erstes Date. Es gab Küsse. Das reicht mir, zumindest fürs Erste."

# game/scripts/c23/c23.rpy:3313
translate german c23s007_AmaCalls_1c86b48c:

    # ama "Y vete antes de que Tía [bet] empiece a tener hambre. *Risa* Hasta mañana, [mc]."
