    # alb "Sir, we are about to land. You should fasten your seatbelts."
    alb "Sir, wir landen gleich. Sie sollten sich anschnallen."

# game/scripts/c31/c31.rpy:2889
translate german c31s004_flight2_c55e0697:

    # mc "Thank you, [alb]. I'll wake up [ama] and Aunt [bet]."
    mc "Danke, [alb]. Ich wecke [ama] und Tante [bet] auf."

# game/scripts/c31/c31.rpy:2890
translate german c31s004_flight2_09940810:

    # alb "Thank you, Sir."
    alb "Danke, Sir."

# game/scripts/c31/c31.rpy:2892
translate german c31s004_flight2_762c74cc:

    # "You gently shake [ama]."
    "Du rüttelst sanft an [ama]."

# game/scripts/c31/c31.rpy:2894
translate german c31s004_flight2_81bedd53:

    # mc "Honey, wake up. We're about to land."
    mc "Schatz, wach auf. Wir landen gleich."

# game/scripts/c31/c31.rpy:2896
translate german c31s004_flight2_e815c473:

    # mc "[ama], wake up. We're about to land."
    mc "[ama], wach auf. Wir landen gleich."

# game/scripts/c31/c31.rpy:2898
translate german c31s004_flight2_36b1463a:

    # "Her waking up isn't what you expected."
    "Ihr Aufwachen verläuft anders, als du erwartet hast."

# game/scripts/c31/c31.rpy:2900
translate german c31s004_flight2_6df40afd:

    # ama "I'm sorry! Did I hurt you?"
    ama "Tut mir leid! Hab ich dir wehgetan?"

# game/scripts/c31/c31.rpy:2901
translate german c31s004_flight2_bd5b09f3:

    # "You don't want to make her feel bad, so you joke about it."
    "Du willst nicht, dass sie sich schlecht fühlt, also machst du einen Witz darüber."

# game/scripts/c31/c31.rpy:2902
translate german c31s004_flight2_40414d44:

    # mc "*Laugh* Nothing a week with my arm in a sling won't fix."
    mc "*Lacht* Nichts, was eine Woche mit dem Arm in der Schlinge nicht wieder richten würde."

# game/scripts/c31/c31.rpy:2903
translate german c31s004_flight2_7a6a5ad6:

    # mc "We're about to land. [alb] came to tell us to fasten our seatbelts."
    mc "Wir landen gleich. [alb] kam, um uns zu sagen, dass wir uns anschnallen sollen."

# game/scripts/c31/c31.rpy:2904
translate german c31s004_flight2_e14d9fb9:

    # mc "I'm going to wake [bet] up."
    mc "Ich werde [bet] wecken."

# game/scripts/c31/c31.rpy:2907
translate german c31s004_flight2_756e4c21:

    # "When you get up from your seat, [bet] is already stretching."
    "Als du von deinem Platz aufstehst, streckt sich [bet] bereits."

# game/scripts/c31/c31.rpy:2908
translate german c31s004_flight2_0052fdc2:

    # bet "No need to wake me. I fall asleep fast, and I wake up just as fast."
    bet "Kein Grund mich zu wecken. Ich schlafe schnell ein und wache genauso schnell wieder auf."

# game/scripts/c31/c31.rpy:2909
translate german c31s004_flight2_35b6e99e:

    # mc "Perfect. Are you coming to sit with us for the landing?"
    mc "Perfekt. Setzt du dich für die Landung zu uns?"

# game/scripts/c31/c31.rpy:2910
translate german c31s004_flight2_67bf9f80:

    # bet "I'm coming."
    bet "Ich komme."

# game/scripts/c31/c31.rpy:2912
translate german c31s004_flight2_576f047c:

    # mc "What's wrong, [ama]? You haven't broken any of my bones..."
    mc "Was ist los, [ama]? Du hast mir doch keine Knochen gebrochen..."

# game/scripts/c31/c31.rpy:2914
translate german c31s004_flight2_1ec78dc1:

    # ama "I could have. This trip is putting my nerves on edge. Going back to the base..."
    ama "Das hätte ich. Diese Reise zerrt an meinen Nerven. Zurück zur Basis zu gehen..."

# game/scripts/c31/c31.rpy:2915
translate german c31s004_flight2_06219e5b:

    # ama "I'm always going to be the same deranged person trained to kill..."
    ama "Ich werde immer dieselbe gestörte Person bleiben, die darauf trainiert wurde, zu töten..."

# game/scripts/c31/c31.rpy:2916
translate german c31s004_flight2_7e186494:

    # mc "If you take out 'the same' and 'deranged' from that sentence, I agree, but you're so much more."
    mc "Wenn du 'dieselbe' und 'gestörte' aus diesem Satz streichst, stimme ich zu, aber du bist so viel mehr."

# game/scripts/c31/c31.rpy:2917
translate german c31s004_flight2_fcb69b65:

    # mc "And you're not the same person who left Aruba months ago. You're not even the same person who came home with [aar]."
    mc "Und du bist nicht dieselbe Person, die Aruba vor Monaten verlassen hat. Du bist nicht einmal dieselbe Person, die mit [aar] nach Hause gekommen ist."

# game/scripts/c31/c31.rpy:2919
translate german c31s004_flight2_acc739f1:

    # bet "[mc] is right. How long have we known you? Three weeks?"
    bet "[mc] hat recht. Wie lange kennen wir dich jetzt? Drei Wochen?"

# game/scripts/c31/c31.rpy:2921
translate german c31s004_flight2_0894abb3:

    # ama "Yesterday marked three weeks since I met [mar] and [nor]. Today will be three weeks since I met the rest of you. Kidnappings aside, of course."
    ama "Gestern waren es drei Wochen, seit ich [mar] und [nor] kennengelernt habe. Heute sind es drei Wochen, seit ich den Rest von euch kennengelernt habe. Entführungen natürlich ausgenommen."

# game/scripts/c31/c31.rpy:2922
translate german c31s004_flight2_57347fd3:

    # ama "Because it's already tomorrow, right?"
    ama "Weil es schon morgen ist, oder?"

# game/scripts/c31/c31.rpy:2923
translate german c31s004_flight2_611aa062:

    # mc "Yeah, it's already tomorrow. Even at home."
    mc "Ja, es ist schon morgen. Sogar zu Hause."

# game/scripts/c31/c31.rpy:2925
translate german c31s004_flight2_44aa4327:

    # bet "Do you remember the girl who came to dinner that day? Because I sure do."
    bet "Erinnerst du dich an das Mädchen, das an jenem Tag zum Abendessen kam? Denn ich tue es auf jeden Fall."

# game/scripts/c31/c31.rpy:2926
translate german c31s004_flight2_888e7f80:

    # bet "You were shyer than you are today. More insecure. You were scared of us!"
    bet "Du warst schüchterner als heute. Unsicherer. Du hattest Angst vor uns!"

# game/scripts/c31/c31.rpy:2927
translate german c31s004_flight2_85630bf9:

    # mc "I'd be scared to meet a family like ours too."
    mc "Ich hätte auch Angst davor, eine Familie wie unsere kennenzulernen."

# game/scripts/c31/c31.rpy:2929
translate german c31s004_flight2_5d521af9:

    # mc "But now you're part of it. You've found new friends. Sisters. A new family that doesn't replace your old one."
    mc "Aber jetzt bist du ein Teil davon. Du hast neue Freunde gefunden. Schwestern. Eine neue Familie, die deine alte nicht ersetzt."

# game/scripts/c31/c31.rpy:2930
translate german c31s004_flight2_8512420b:

    # "After what happened with [eva], you prefer to clarify that accepting the new family doesn't mean betraying the old one."
    "Nach dem, was mit [eva] passiert ist, stellst du lieber klar, dass die neue Familie zu akzeptieren nicht bedeutet, die alte zu verraten."

# game/scripts/c31/c31.rpy:2931
translate german c31s004_flight2_58af43b9:

    # mc "You've grown as a person. As a woman."
    mc "Du bist als Person gewachsen. Als Frau."

# game/scripts/c31/c31.rpy:2933
translate german c31s004_flight2_2fa12777:

    # mc "You've even gotten married."
    mc "Du hast sogar geheiratet."

# game/scripts/c31/c31.rpy:2935
translate german c31s004_flight2_451ea7e1:

    # ama "*Laugh* I don't know if that's a good or a bad thing."
    ama "*Lacht* Ich weiß nicht, ob das etwas Gutes oder Schlechtes ist."

# game/scripts/c31/c31.rpy:2936
translate german c31s004_flight2_96825b34:

    # mc "Hey!"
    mc "Hey!"

# game/scripts/c31/c31.rpy:2938
translate german c31s004_flight2_ac50cdcf:

    # bet "*Laugh* We don't know what your taste in men was like before, so we can't know if you've evolved for better or worse."
    bet "*Lacht* Wir wissen nicht, wie dein Männergeschmack vorher war, also können wir nicht wissen, ob du dich zum Besseren oder Schlechteren entwickelt hast."

# game/scripts/c31/c31.rpy:2939
translate german c31s004_flight2_85e7ec37:

    # mc "Hey! I'm right here. You know that, right?"
    mc "Hey! Ich bin genau hier. Das wisst ihr, oder?"

# game/scripts/c31/c31.rpy:2941
translate german c31s004_flight2_9fbf1aa0:

    # bet "I mean, if she used to like Jason Moanoa and ended up marrying you..."
    bet "Ich meine, wenn sie früher auf Jason Moanoa stand und am Ende dich geheiratet hat..."

# game/scripts/c31/c31.rpy:2942
translate german c31s004_flight2_ffee94dd:

    # mc "*Laugh* If you take away Jason's fame, money, hair, beard, and muscles... What does he have that I don't?"
    mc "*Lacht* Wenn man Jasons Ruhm, Geld, Haare, Bart und Muskeln wegnimmt... Was hat er dann, was ich nicht habe?"

# game/scripts/c31/c31.rpy:2944
translate german c31s004_flight2_66ef0658:

    # bet "*Laugh* Nothing, nothing..." (multiple=2)
    bet "*Lacht* Nichts, nichts..." (multiple=2)

# game/scripts/c31/c31.rpy:2945
translate german c31s004_flight2_79b7f536:

    # ama "*Laugh* Acting talent?" (multiple=2)
    ama "*Lacht* Schauspieltalent?" (multiple=2)

# game/scripts/c31/c31.rpy:2946
translate german c31s004_flight2_3267f1ce:

    # mc "Stop this plane, I want to get off!"
    mc "Haltet dieses Flugzeug an, ich will aussteigen!"

# game/scripts/c31/c31.rpy:2948
translate german c31s004_flight2_e1ac6040:

    # bet "But seriously..."
    bet "Aber im Ernst..."

# game/scripts/c31/c31.rpy:2949
translate german c31s004_flight2_3ba4b337:

    # bet "What [mc] wanted to say, even though he likes to beat around the bush, is that you're not the same person we met three weeks ago."
    bet "Was [mc] sagen wollte, auch wenn er gerne um den heißen Brei herumredet, ist, dass du nicht mehr dieselbe Person bist, die wir vor drei Wochen getroffen haben."

# game/scripts/c31/c31.rpy:2952
translate german c31s004_flight2_e0f4645a:

    # bet "What [mc] means to say, even though he likes to beat around the bush, is that you're not the same person we met three weeks ago."
    bet "Was [mc] sagen will, auch wenn er gerne um den heißen Brei herumredet, ist, dass du nicht mehr dieselbe Person bist, die wir vor drei Wochen getroffen haben."

# game/scripts/c31/c31.rpy:2953
translate german c31s004_flight2_b36be703:

    # bet "It's no longer just you and [eva] against the world. Now you have us too."
    bet "Es heißt nicht mehr nur du und [eva] gegen den Rest der Welt. Jetzt hast du auch uns."

# game/scripts/c31/c31.rpy:2954
translate german c31s004_flight2_0ebf2174:

    # bet "Nobody messes with a Marks without 23 people jumping at their throat."
    bet "Niemand legt sich mit einer Marks an, ohne dass ihm 23 Leute an die Gurgel springen."

# game/scripts/c31/c31.rpy:2955
translate german c31s004_flight2_b547ee30:

    # mc "And if not, we can always send Jamaal to run them over. Even though he can't jump too high."
    mc "Und wenn nicht, können wir immer noch Jamaal schicken, um sie zu überfahren. Auch wenn er nicht allzu hoch springen kann."

# game/scripts/c31/c31.rpy:2957
translate german c31s004_flight2_736d580a:

    # ama "I couldn't do this without you guys. Thank you..."
    ama "Ich könnte das nicht ohne euch schaffen. Danke..."

# game/scripts/c31/c31.rpy:2959
translate german c31s004_flight2_520e658b:

    # ama "And about running someone over... *Giggles* I think when you meet a certain [dam], a D-series clone, you'll feel like doing it."
    ama "Und was das Überfahren angeht... *Kichert* Ich glaube, wenn ihr einen gewissen [dam] trefft, einen Klon der D-Serie, werdet ihr genau das tun wollen."

# game/scripts/c31/c31.rpy:2960
translate german c31s004_flight2_8c86aede:

    # alb "*PA system* We will be landing in a few minutes. Please remember to fasten your seatbelts."
    alb "*Lautsprecheranlage* Wir werden in wenigen Minuten landen. Bitte denken Sie daran, sich anzuschnallen."

# game/scripts/c31/c31.rpy:2961
translate german c31s004_flight2_1f8baac2:

    # mc "Well, I think the real trip starts now. It's nothing we can't do together."
    mc "Nun, ich denke, der wahre Trip beginnt jetzt. Es gibt nichts, was wir nicht zusammen schaffen können."

# game/scripts/c31/c31.rpy:2962
translate german c31s004_flight2_9584d0e2:

    # mc "And if we have to run over this [dam] guy, we'll run him over."
    mc "Und wenn wir diesen [dam] überfahren müssen, dann überfahren wir ihn."

# game/scripts/c31/c31.rpy:2969
translate german c31s005_AarPicksUp_62c3affa:

    # "Once the plane lands, it goes straight to what looks like a military hangar."
    "Sobald das Flugzeug landet, rollt es direkt zu etwas, das wie ein militärischer Hangar aussieht."

# game/scripts/c31/c31.rpy:2970
translate german c31s005_AarPicksUp_2ede401c:

    # "[aar] is waiting for you with a car inside the hangar."
    "[aar] wartet im Hangar mit einem Auto auf euch."

# game/scripts/c31/c31.rpy:2974
translate german c31s005_AarPicksUp_41b5383b:

    # "[ama]'s face lights up when she sees him through the window."
    "[ama]s Gesicht leuchtet auf, als sie ihn durch das Fenster sieht."

# game/scripts/c31/c31.rpy:2976
translate german c31s005_AarPicksUp_770cf792:

    # "And she does what you would never have expected from someone like [ama]."
    "Und sie tut etwas, das man von jemandem wie [ama] nie erwartet hätte."

# game/scripts/c31/c31.rpy:2977
translate german c31s005_AarPicksUp_350aa7cb:

    # "Judging by his surprised face, [aar] would never have expected it either."
    "Seinem überraschten Gesicht nach zu urteilen, hätte [aar] es auch nie erwartet."

# game/scripts/c31/c31.rpy:2979
translate german c31s005_AarPicksUp_dcb99871:

    # ama "You didn't have to bother coming."
    ama "Du hättest dir nicht die Mühe machen müssen, zu kommen."

# game/scripts/c31/c31.rpy:2980
translate german c31s005_AarPicksUp_06c41f7f:

    # aar "It was the least I could do..."
    aar "Das war das Mindeste, was ich tun konnte..."

# game/scripts/c31/c31.rpy:2982
translate german c31s005_AarPicksUp_3a4f68fa:

    # mc "[aar], it's a pleasure to see you in person instead of through a screen."
    mc "[aar], es ist mir eine Freude, dich persönlich zu sehen, anstatt nur über einen Bildschirm."

# game/scripts/c31/c31.rpy:2983
translate german c31s005_AarPicksUp_2e0531e7:

    # aar "Likewise, [mc]. I was looking forward to handing the CEO job over to you."
    aar "Ganz meinerseits, [mc]. Ich habe mich schon darauf gefreut, dir den CEO-Posten zu übergeben."

# game/scripts/c31/c31.rpy:2985
translate german c31s005_AarPicksUp_ba759fc9:

    # aar "*Whispering* What have you done to [ama]?"
    aar "*Flüsternd* Was hast du mit [ama] gemacht?"

# game/scripts/c31/c31.rpy:2986
translate german c31s005_AarPicksUp_5c450db9:

    # mc "*Laugh* We taught her to express what she feels. It's a good change."
    mc "*Lacht* Wir haben ihr beigebracht, auszudrücken, was sie fühlt. Es ist eine gute Veränderung."

# game/scripts/c31/c31.rpy:2988
translate german c31s005_AarPicksUp_39c9cc94:

    # ama "Jeetje mina*! [aar] is your clone! \n* 'Mother of mine!' in Dutch."
    ama "Jeetje mina*! [aar] ist dein Klon! \n* 'Meine Mutter!' auf Niederländisch."

# game/scripts/c31/c31.rpy:2990
translate german c31s005_AarPicksUp_a51b1017:

    # mc "I told you she'd figure it out the moment she saw us together."
    mc "Ich hab dir gesagt, sie würde es in dem Moment herausfinden, in dem sie uns zusammen sieht."

# game/scripts/c31/c31.rpy:2991
translate german c31s005_AarPicksUp_238515b8:

    # aar "I had to try."
    aar "Ich musste es versuchen."

# game/scripts/c31/c31.rpy:2993
translate german c31s005_AarPicksUp_211c275e:

    # ama "You knew? Why didn't you tell me?"
    ama "Du wusstest es? Warum hast du es mir nicht gesagt?"

# game/scripts/c31/c31.rpy:2994
translate german c31s005_AarPicksUp_6e71b403:

    # mc "I promised [aar]. He told me he wanted to tell you himself."
    mc "Ich habe es [aar] versprochen. Er sagte mir, er wollte es dir selbst sagen."

# game/scripts/c31/c31.rpy:2996
translate german c31s005_AarPicksUp_5d401034:

    # bet "If it was obvious over a video call, only a blind person wouldn't figure it out seeing you together."
    bet "Wenn es über einen Videoanruf schon offensichtlich war, würde es nur ein Blinder nicht merken, wenn er euch zusammen sieht."

# game/scripts/c31/c31.rpy:2997
translate german c31s005_AarPicksUp_8f5a1fb0:

    # mc "Yeah, that's what I thought."
    mc "Ja, das dachte ich mir auch."

# game/scripts/c31/c31.rpy:2999
translate german c31s005_AarPicksUp_1e2626b7:

    # ama "You knew too? Does [eva] know too? Am I the only idiot who didn't know?"
    ama "Du wusstest es auch? Weiß [eva] es auch? Bin ich der einzige Idiot, der es nicht wusste?"

# game/scripts/c31/c31.rpy:3000
translate german c31s005_AarPicksUp_aa6c3611:

    # mc "No, [ama]. [eva] doesn't know either. [aar] wanted to tell both of you in person."
    mc "Nein, [ama]. [eva] weiß es auch nicht. [aar] wollte es euch beiden persönlich sagen."

# game/scripts/c31/c31.rpy:3002
translate german c31s005_AarPicksUp_eb18b069:

    # aar "I think I was a bit naive."
    aar "Ich glaube, ich war ein bisschen naiv."

# game/scripts/c31/c31.rpy:3003
translate german c31s005_AarPicksUp_780c2b55:

    # mc "Just a bit?"
    mc "Nur ein bisschen?"

# game/scripts/c31/c31.rpy:3005
translate german c31s005_AarPicksUp_cc91dae0:

    # ama "Well, we knew you were someone's clone. We just didn't know whose."
    ama "Nun, wir wussten, dass du jemandes Klon bist. Wir wussten nur nicht, wessen."

# game/scripts/c31/c31.rpy:3006
translate german c31s005_AarPicksUp_28d13ec0:

    # ama "When did you find out? Why didn't you tell us anything?"
    ama "Wann hast du es herausgefunden? Warum hast du uns nichts gesagt?"

# game/scripts/c31/c31.rpy:3008
translate german c31s005_AarPicksUp_f3692149:

    # aar "I've known for a few months, since the Clone War started. But it wasn't the right time to say anything."
    aar "Ich weiß es seit ein paar Monaten, seit der Klonkrieg angefangen hat. Aber es war nicht der richtige Zeitpunkt, etwas zu sagen."

# game/scripts/c31/c31.rpy:3009
translate german c31s005_AarPicksUp_95ab0870:

    # aar "I was surprised you didn't say anything the day we met [mar] and [nor], so I thought it wasn't too obvious."
    aar "Ich war überrascht, dass ihr an dem Tag, als wir [mar] und [nor] getroffen haben, nichts gesagt habt, also dachte ich, es wäre nicht zu offensichtlich."

# game/scripts/c31/c31.rpy:3011
translate german c31s005_AarPicksUp_69720dec:

    # aar "I haven't looked like you for years, and I don't think the girls remember how I looked back then."
    aar "Ich sehe dir schon seit Jahren nicht mehr ähnlich, und ich glaube nicht, dass die Mädchen sich daran erinnern, wie ich damals aussah."

# game/scripts/c31/c31.rpy:3012
translate german c31s005_AarPicksUp_ca38fbc7:

    # mc "I think it has more to do with how shocked they were to meet [mar] and [nor]."
    mc "Ich glaube, es hat mehr damit zu tun, wie schockiert sie waren, [mar] und [nor] zu treffen."

# game/scripts/c31/c31.rpy:3013
translate german c31s005_AarPicksUp_fa493f58:

    # mc "I don't think they looked at us more than a couple of times."
    mc "Ich glaube nicht, dass sie uns mehr als ein paar Mal angesehen haben."

# game/scripts/c31/c31.rpy:3015
translate german c31s005_AarPicksUp_74cb3c6a:

    # ama "I guess that must be it. It took me less than a minute to see it now."
    ama "Ich schätze, das muss es sein. Jetzt habe ich weniger als eine Minute gebraucht, um es zu sehen."

# game/scripts/c31/c31.rpy:3016
translate german c31s005_AarPicksUp_c69d3bfc:

    # mc "It's normal that you only had eyes for [mar] and [nor] that day, sweetie."
    mc "Es ist normal, dass du an diesem Tag nur Augen für [mar] und [nor] hattest, Süße."

# game/scripts/c31/c31.rpy:3019
translate german c31s005_AarPicksUp_2a441c4a:

    # ama "*Laugh* At least I know my husband isn't going to go bald."
    ama "*Lacht* Zumindest weiß ich, dass mein Mann keine Glatze bekommen wird."

# game/scripts/c31/c31.rpy:3020
translate german c31s005_AarPicksUp_464ccb1b:

    # mc "*Laugh* I'm pretty happy about that too."
    mc "*Lacht* Darüber bin ich auch ziemlich froh."

# game/scripts/c31/c31.rpy:3021
translate german c31s005_AarPicksUp_7d031e06:

    # mc "Although I'd be a proud bald guy if it happened, the kind who shaves it all off. No wigs for me."
    mc "Obwohl ich ein stolzer Glatzkopf wäre, wenn es passieren würde, so einer, der sich alles abrasiert. Keine Perücken für mich."

# game/scripts/c31/c31.rpy:3023
translate german c31s005_AarPicksUp_0b43a49d:

    # aar "What? Husband? What's this about? Is it some kind of cover?"
    aar "Was? Mann? Worum geht es hier? Ist das irgendeine Art von Tarnung?"

# game/scripts/c31/c31.rpy:3024
translate german c31s005_AarPicksUp_6e4b6d37:

    # mc "I think [ama] has to explain some things to you, [aar]."
    mc "Ich glaube, [ama] muss dir ein paar Dinge erklären, [aar]."

# game/scripts/c31/c31.rpy:3026
translate german c31s005_AarPicksUp_4ca237a9:

    # ama "*Laugh* At least you know you're not going to go bald."
    ama "*Lacht* Zumindest weißt du, dass du keine Glatze bekommen wirst."

# game/scripts/c31/c31.rpy:3027
translate german c31s005_AarPicksUp_464ccb1b_1:

    # mc "*Laugh* I'm pretty happy about that too."
    mc "*Lacht* Darüber bin ich auch ziemlich froh."

# game/scripts/c31/c31.rpy:3028
translate german c31s005_AarPicksUp_7d031e06_1:

    # mc "Although I'd be a proud bald guy if it happened, the kind who shaves it all off. No wigs for me."
    mc "Obwohl ich ein stolzer Glatzkopf wäre, wenn es passieren würde, so einer, der sich alles abrasiert. Keine Perücken für mich."

# game/scripts/c31/c31.rpy:3030
translate german c31s005_AarPicksUp_48f1f471:

    # bet "Can we talk about baldness and whatever else you want on the way to the base?"
    bet "Können wir auf dem Weg zur Basis über Glatzen und was auch immer ihr wollt reden?"

# game/scripts/c31/c31.rpy:3031
translate german c31s005_AarPicksUp_de620dd9:

    # bet "It's late and we should get some rest before starting the day tomorrow."
    bet "Es ist spät und wir sollten uns etwas ausruhen, bevor morgen der Tag beginnt."

# game/scripts/c31/c31.rpy:3033
translate german c31s005_AarPicksUp_7a93eca1:

    # aar "You're not going to sleep at the base. I'm taking you to the CEO's House."
    aar "Ihr werdet nicht in der Basis schlafen. Ich bringe euch zum Haus des CEOs."

# game/scripts/c31/c31.rpy:3034
translate german c31s005_AarPicksUp_de627ecd:

    # mc "I thought the CEO's House was at the base..."
    mc "Ich dachte, das Haus des CEOs wäre auf der Basis..."

# game/scripts/c31/c31.rpy:3036
translate german c31s005_AarPicksUp_8c4b6f25:

    # aar "No. Neither Richards nor Daniels ever wanted to live at the base. The house is about fifteen kilometers away. About ten miles for you."
    aar "Nein. Weder Richards noch Daniels wollten jemals auf der Basis leben. Das Haus ist etwa fünfzehn Kilometer entfernt. Ungefähr zehn Meilen für dich."

# game/scripts/c31/c31.rpy:3037
translate german c31s005_AarPicksUp_6111ea36:

    # mc "Do you live there too? You've been acting CEO..."
    mc "Wohnst du auch dort? Du warst schließlich der amtierende CEO..."

# game/scripts/c31/c31.rpy:3038
translate german c31s005_AarPicksUp_7e28962c:

    # aar "I live at the base, with the rest of the guys. Nothing has changed regarding that."
    aar "Ich wohne auf der Basis, mit dem Rest der Jungs. Daran hat sich nichts geändert."

# game/scripts/c31/c31.rpy:3040
translate german c31s005_AarPicksUp_f47e96c8:

    # aar "By the way... welcome, [bet]. They didn't let me greet you."
    aar "Übrigens... willkommen, [bet]. Sie haben mich dich nicht begrüßen lassen."

# game/scripts/c31/c31.rpy:3041
translate german c31s005_AarPicksUp_1297831f:

    # mc "Get your surprised face ready, [aar]."
    mc "Mach dich auf eine Überraschung gefasst, [aar]."

# game/scripts/c31/c31.rpy:3043
translate german c31s005_AarPicksUp_ac1abe42:

    # aar "What do you mean?"
    aar "Was meinst du?"

# game/scripts/c31/c31.rpy:3046
translate german c31s005_AarPicksUp_e7633ab4:

    # bet "What's with holding out your hand? You're the clone of my great-nephew. You're family!"
    bet "Was soll das mit der ausgestreckten Hand? Du bist der Klon meines Großneffen. Du bist Familie!"

# game/scripts/c31/c31.rpy:3047
translate german c31s005_AarPicksUp_b15b59b5:

    # "[aar] realizes what you meant a second too late."
    "[aar] erkennt eine Sekunde zu spät, was du gemeint hast."

# game/scripts/c31/c31.rpy:3048
translate german c31s005_AarPicksUp_2941fcf9:

    # mc "*Laugh* I meant exactly that, [aar]."
    mc "*Lacht* Genau das meinte ich, [aar]."

# game/scripts/c31/c31.rpy:3049
translate german c31s005_AarPicksUp_26634e50:

    # mc "And [aar] doesn't think we're family because we share genes, {b}Aunt{/b} [bet]."
    mc "Und [aar] denkt nicht, dass wir Familie sind, nur weil wir Gene teilen, {b}Tante{/b} [bet]."

# game/scripts/c31/c31.rpy:3050
translate german c31s005_AarPicksUp_0d5b86d1:

    # "You emphasize the 'Aunt' to make it clear that you are family."
    "Du betonst das 'Tante', um klarzumachen, dass ihr Familie seid."

# game/scripts/c31/c31.rpy:3051
translate german c31s005_AarPicksUp_260cc0df:

    # bet "Nonsense!"
    bet "Unsinn!"

# game/scripts/c31/c31.rpy:3053
translate german c31s005_AarPicksUp_c70c8356:

    # "It doesn't matter that you and [bet] don't share genes. You're family because you choose to be."
    "Es spielt keine Rolle, dass du und [bet] keine gemeinsamen Gene habt. Ihr seid Familie, weil ihr euch dafür entschieden habt."

# game/scripts/c31/c31.rpy:3055
translate german c31s005_AarPicksUp_d10156a2:

    # "You also hope that, by emphasizing the 'Aunt', [bet] won't say anything about you two being married also."
    "Du hoffst auch, dass [bet] durch die Betonung von 'Tante' nichts darüber sagt, dass ihr beide auch verheiratet seid."

# game/scripts/c31/c31.rpy:3056
translate german c31s005_AarPicksUp_03b2ffbf:

    # "You don't want [aar]'s head to explode in the first ten minutes of meeting you. You wouldn't know how to get to the CEO's House. Maybe [ama] knows?"
    "Du willst nicht, dass [aar]s Kopf in den ersten zehn Minuten eures Treffens explodiert. Du wüsstest nicht, wie du zum Haus des CEOs kommen sollst. Vielleicht weiß [ama] es?"

# game/scripts/c31/c31.rpy:3058
translate german c31s005_AarPicksUp_5a7d2b7d:

    # "After a few uncomfortable seconds for [aar], [bet] lets him go and takes a couple of steps back."
    "Nach ein paar für [aar] unangenehmen Sekunden lässt [bet] ihn los und tritt ein paar Schritte zurück."

# game/scripts/c31/c31.rpy:3059
translate german c31s005_AarPicksUp_a93bced7:

    # bet "Well, we've done the introductions. Next time I expect you to hug me back, [aar]."
    bet "Nun, die Vorstellungen haben wir hinter uns. Nächstes Mal erwarte ich, dass du mich zurück umarmst, [aar]."

# game/scripts/c31/c31.rpy:3060
translate german c31s005_AarPicksUp_547c8a1f:

    # mc "Let his brain start working again before demanding things for next time."
    mc "Lass sein Gehirn erst wieder anfangen zu arbeiten, bevor du Dinge für das nächste Mal verlangst."

# game/scripts/c31/c31.rpy:3062
translate german c31s005_AarPicksUp_43cff04b:

    # aar "What? There's going to be a next time?"
    aar "Was? Es wird ein nächstes Mal geben?"

# game/scripts/c31/c31.rpy:3063
translate german c31s005_AarPicksUp_f982b868:

    # "The tough mercenary looks ridiculous, made uncomfortable by an old woman's hugs."
    "Der harte Söldner sieht lächerlich aus, unbehaglich gemacht durch die Umarmungen einer alten Frau."

# game/scripts/c31/c31.rpy:3064
translate german c31s005_AarPicksUp_81ba533a:

    # mc "*Laugh* You know nothing, [aar] Gilford."
    mc "*Lacht* Du weißt gar nichts, [aar] Gilford."

# game/scripts/c31/c31.rpy:3066
translate german c31s005_AarPicksUp_22d58535:

    # ama "That's from a TV show, [aar]."
    ama "Das ist aus einer Fernsehserie, [aar]."

# game/scripts/c31/c31.rpy:3067
translate german c31s005_AarPicksUp_1879d4b9:

    # ama "And yes. There are going to be a lot of next times. You'll get used to it."
    ama "Und ja. Es wird noch viele nächste Male geben. Du wirst dich daran gewöhnen."

# game/scripts/c31/c31.rpy:3068
translate german c31s005_AarPicksUp_c0280c35:

    # ama "We Marks are a family of huggers. We Gilfords should learn a lot from the Marks."
    ama "Wir Marks sind eine Familie, die sich gerne umarmt. Wir Gilfords sollten viel von den Marks lernen."

# game/scripts/c31/c31.rpy:3069
translate german c31s005_AarPicksUp_12da8da0:

    # "You love that she includes herself in both families in a single line."
    "Du liebst es, dass sie sich in einem einzigen Satz in beide Familien einbezieht."

# game/scripts/c31/c31.rpy:3070
translate german c31s005_AarPicksUp_7943f579:

    # mc "And now I think we should go before [aar] has a stroke."
    mc "Und jetzt denke ich, wir sollten los, bevor [aar] einen Schlaganfall bekommt."

# game/scripts/c31/c31.rpy:3072
translate german c31s005_AarPicksUp_ab32aab2:

    # "After saying goodbye to [alb] and the pilots, you get into the limo and begin the journey to what will be your home for the next few months."
    "Nachdem du dich von [alb] und den Piloten verabschiedet hast, steigst du in die Limo und beginnst die Reise zu dem Ort, der für die nächsten paar Monate dein Zuhause sein wird."

# game/scripts/c31/c31.rpy:3073
translate german c31s005_AarPicksUp_ea94d5cc:

    # "[aar] acts as chauffeur while [ama] sits next to him and explains everything that has happened since he returned to Aruba."
    "[aar] fungiert als Chauffeur, während [ama] neben ihm sitzt und alles erklärt, was passiert ist, seit er nach Aruba zurückgekehrt ist."

# game/scripts/c31/c31.rpy:3074
translate german c31s005_AarPicksUp_af4c1341:

    # "The beautiful woman's words and excitement resonate in the empty streets, lighting up the night with her smile."
    "Die Worte und die Aufregung der schönen Frau hallen in den leeren Straßen wider und erhellen die Nacht mit ihrem Lächeln."

# game/scripts/c31/c31.rpy:3075
translate german c31s005_AarPicksUp_8f198eeb:

    # "She doesn't talk about missions or surveillance devices. She talks about family. She recounts laughter and hugs. She talks about the girls and Jamaal."
    "Sie spricht nicht über Missionen oder Überwachungsgeräte. Sie spricht über Familie. Sie erzählt von Lachen und Umarmungen. Sie spricht über die Mädchen und Jamaal."

# game/scripts/c31/c31.rpy:3077
translate german c31s005_AarPicksUp_20404727:

    # "She talks about your wedding."
    "Sie spricht über eure Hochzeit."

# game/scripts/c31/c31.rpy:3078
translate german c31s005_AarPicksUp_9e5c9fc4:

    # "[bet] and you only intervene when [ama] leaves out some detail that you consider important."
    "[bet] und du greift nur ein, wenn [ama] ein Detail auslässt, das ihr für wichtig haltet."

# game/scripts/c31/c31.rpy:3079
translate german c31s005_AarPicksUp_6ec8d16d:

    # "Neither of you wants to interrupt the excitement with which the blonde mercenary is explaining her new life."
    "Keiner von euch möchte die Begeisterung unterbrechen, mit der die blonde Söldnerin ihr neues Leben erklärt."

# game/scripts/c31/c31.rpy:3080
translate german c31s005_AarPicksUp_9943de76:

    # "The [ama] that almost broke your arm on the plane has disappeared again, although you know she's still in there."
    "Die [ama], die dir im Flugzeug fast den Arm gebrochen hätte, ist wieder verschwunden, obwohl du weißt, dass sie noch da drin steckt."

# game/scripts/c31/c31.rpy:3081
translate german c31s005_AarPicksUp_91095358:

    # "[aar] survives the trip without strokes or heart attacks. Barely."
    "[aar] überlebt die Fahrt ohne Schlaganfälle oder Herzinfarkte. Gerade so."

# game/scripts/c31/c31.rpy:3082
translate german c31s005_AarPicksUp_b69dc59d:

    # "Which is lucky. He's the one driving."
    "Was ein Glück ist. Er ist derjenige, der fährt."

# game/scripts/c31/c31.rpy:3088
translate german c31s005_houseArrival_de4378fb:

    # "You arrive at the CEO's House around 4 AM. There are a couple of cars in the garage, apart from the limo you arrived in."
    "Ihr kommt gegen 4 Uhr morgens am Haus des CEOs an. In der Garage stehen ein paar Autos, abgesehen von der Limo, in der ihr angekommen seid."

# game/scripts/c31/c31.rpy:3089
translate german c31s005_houseArrival_0a13cb57:

    # "You had seen pictures of the interior, but something doesn't add up. What you've seen in the photos doesn't fit in that building."
    "Du hattest Bilder von der Inneneinrichtung gesehen, aber irgendwas passt nicht zusammen. Was du auf den Fotos gesehen hast, passt nicht in dieses Gebäude."

# game/scripts/c31/c31.rpy:3091
translate german c31s005_houseArrival_afcbb943:

    # bet "I thought it would be bigger..."
    bet "Ich dachte, es wäre größer..."

# game/scripts/c31/c31.rpy:3092
translate german c31s005_houseArrival_fc82af07:

    # bet "No offense, but it looks like a shack and a small building."
    bet "Nichts für ungut, aber es sieht aus wie eine Hütte und ein kleines Gebäude."

# game/scripts/c31/c31.rpy:3093
translate german c31s005_houseArrival_542448ce:

    # bet "Not that I'm complaining. The terrace on the shack looks impressive and I've lived in worse places."
    bet "Nicht, dass ich mich beschwere. Die Terrasse an der Hütte sieht beeindruckend aus und ich habe schon an schlimmeren Orten gelebt."

# game/scripts/c31/c31.rpy:3095
translate german c31s005_houseArrival_0dd8e3b2:

    # aar "The official name is A House on the Cliff. There are two floors below what you see."
    aar "Der offizielle Name ist 'A House on the Cliff'. Es gibt zwei Stockwerke unter dem, was du siehst."

# game/scripts/c31/c31.rpy:3096
translate german c31s005_houseArrival_05359c75:

    # aar "This is just the kitchen, the living room, and the terrace. The bedrooms are on the next floor."
    aar "Das hier ist nur die Küche, das Wohnzimmer und die Terrasse. Die Schlafzimmer sind im nächsten Stockwerk."

# game/scripts/c31/c31.rpy:3097
translate german c31s005_houseArrival_fda14927:

    # mc "And on the third floor?"
    mc "Und im dritten Stock?"

# game/scripts/c31/c31.rpy:3099
translate german c31s005_houseArrival_ee80499b:

    # aar "The panic room. Officially called The Bunker."
    aar "Der Panikraum. Offiziell wird er 'Der Bunker' genannt."

# game/scripts/c31/c31.rpy:3100
translate german c31s005_houseArrival_0dca65a0:

    # aar "There are secure communications with the base from that room, in case of an attack or if the CEO wants to follow an operation from here."
    aar "Von diesem Raum aus gibt es eine sichere Kommunikation zur Basis, im Falle eines Angriffs oder wenn der CEO eine Operation von hier aus verfolgen möchte."

# game/scripts/c31/c31.rpy:3101
translate german c31s005_houseArrival_e46ec2b8:

    # aar "There's also a small armory and the surveillance room."
    aar "Es gibt auch eine kleine Waffenkammer und den Überwachungsraum."

# game/scripts/c31/c31.rpy:3102
translate german c31s005_houseArrival_5809d825:

    # mc "Do we have security personnel?"
    mc "Haben wir Sicherheitspersonal?"

# game/scripts/c31/c31.rpy:3104
translate german c31s005_houseArrival_42d4edcb:

    # ama "No. I told [aar] it wasn't necessary for tonight."
    ama "Nein. Ich habe [aar] gesagt, dass es für heute Nacht nicht nötig ist."

# game/scripts/c31/c31.rpy:3105
translate german c31s005_houseArrival_6c1174f1:

    # ama "No one knows we were coming and the house has been empty for a few weeks, so we don't expect to need it."
    ama "Niemand weiß, dass wir kommen, und das Haus stand ein paar Wochen leer, also gehen wir nicht davon aus, dass wir es brauchen."

# game/scripts/c31/c31.rpy:3107
translate german c31s005_houseArrival_d1515b34:

    # ama "Besides, I didn't want you to run into any operatives until we know what to expect from each of them."
    ama "Außerdem wollte ich nicht, dass du irgendwelchen Agenten über den Weg läufst, bis wir wissen, was wir von jedem Einzelnen zu erwarten haben."

# game/scripts/c31/c31.rpy:3108
translate german c31s005_houseArrival_2af4d6d9:

    # mc "That sounds very smart."
    mc "Das klingt sehr klug."

# game/scripts/c31/c31.rpy:3110
translate german c31s005_houseArrival_178d9d9a:

    # aar "You should rest now. You're going to have a very long day tomorrow."
    aar "Du solltest dich jetzt ausruhen. Du wirst morgen einen sehr langen Tag haben."

# game/scripts/c31/c31.rpy:3111
translate german c31s005_houseArrival_4b98d4ab:

    # mc "I think you're right. See you tomorrow at the base?"
    mc "Ich glaube, du hast recht. Sehen wir uns morgen auf der Basis?"

# game/scripts/c31/c31.rpy:3113
translate german c31s005_houseArrival_a8133fae:

    # aar "Yeah, your first meeting is at 10 AM, with the department heads. I'll be there too."
    aar "Ja, dein erstes Meeting ist um 10 Uhr mit den Abteilungsleitern. Ich werde auch da sein."

# game/scripts/c31/c31.rpy:3114
translate german c31s005_houseArrival_f5044b8c:

    # aar "But before that, you're scheduled for a tour of the facilities, so you should be there around 8 AM."
    aar "Aber davor steht eine Führung durch die Einrichtungen auf dem Plan, du solltest also gegen 8 Uhr da sein."

# game/scripts/c31/c31.rpy:3115
translate german c31s005_houseArrival_0b03e858:

    # mc "Perfect. See you there then."
    mc "Perfekt. Wir sehen uns dann dort."

# game/scripts/c31/c31.rpy:3117
translate german c31s005_houseArrival_9afeb654:

    # "Both [bet] and [ama] say goodbye to [aar] with a hug after he helps you bring the luggage into the kitchen."
    "Sowohl [bet] als auch [ama] verabschieden sich mit einer Umarmung von [aar], nachdem er euch geholfen hat, das Gepäck in die Küche zu bringen."

# game/scripts/c31/c31.rpy:3118
translate german c31s005_houseArrival_b45d2904:

    # "At this rate, he's going to get used to the Marks' hugs very quickly, even if he doesn't want to be part of the family."
    "Wenn das so weitergeht, wird er sich sehr schnell an die Umarmungen der Marks gewöhnen, auch wenn er kein Teil der Familie sein will."

# game/scripts/c31/c31.rpy:3119
translate german c31s005_houseArrival_8fa90c79:

    # "All it will take is for [eva] and a couple more of the girls to come and hug him... He'll have no choice but to change his mind."
    "Es braucht nur noch [eva] und ein paar weitere der Mädchen, die kommen und ihn umarmen... Er wird keine andere Wahl haben, als seine Meinung zu ändern."

# game/scripts/c31/c31.rpy:3120
translate german c31s005_houseArrival_ca836ce4:

    # "In a weird way, he's your brother too."
    "Auf eine seltsame Art und Weise ist er auch dein Bruder."

# game/scripts/c31/c31.rpy:3121
translate german c31s005_houseArrival_9540a212:

    # "He drives off in the limo. For a moment you thought he'd leave the limo and take the Humvee."
    "Er fährt in der Limo davon. Für einen Moment dachtest du, er würde die Limo stehen lassen und den Humvee nehmen."

# game/scripts/c31/c31.rpy:3124
translate german c31s005_houseArrival_07d83ba2:

    # ama "I think we should go to sleep now. I'll show you your rooms."
    ama "Ich denke, wir sollten jetzt schlafen gehen. Ich zeige euch eure Zimmer."

# game/scripts/c31/c31.rpy:3125
translate german c31s005_houseArrival_cf2aa8fc:

    # mc "Have you been here before?"
    mc "Warst du schon mal hier?"

# game/scripts/c31/c31.rpy:3127
translate german c31s005_houseArrival_2f025de4:

    # ama "Never, but I know how to read a floor plan and I can guide you to the rooms [aar] has assigned you."
    ama "Noch nie, aber ich weiß, wie man einen Grundriss liest, und ich kann euch zu den Zimmern führen, die [aar] euch zugewiesen hat."

# game/scripts/c31/c31.rpy:3128
translate german c31s005_houseArrival_9c0fca5d:

    # ama "Neither Richards nor Daniels wanted us girls to be part of the mansion's security team."
    ama "Weder Richards noch Daniels wollten, dass wir Mädels Teil des Sicherheitsteams der Villa sind."

# game/scripts/c31/c31.rpy:3129
translate german c31s005_houseArrival_0510d4a5:

    # mc "Was there a reason for that?"
    mc "Gab es dafür einen Grund?"

# game/scripts/c31/c31.rpy:3131
translate german c31s005_houseArrival_e926464f:

    # ama "They said we could do more interesting things than stare at a monitor."
    ama "Sie sagten, wir könnten interessantere Dinge tun, als auf einen Monitor zu starren."

# game/scripts/c31/c31.rpy:3132
translate german c31s005_houseArrival_771f29b2:

    # mc "And they were right. Despite that, you've spent the last few months doing just that."
    mc "Und sie hatten recht. Trotzdem hast du die letzten Monate genau das getan."

# game/scripts/c31/c31.rpy:3134
translate german c31s005_houseArrival_ae617da5:

    # ama "*Laugh* And if it weren't for [emm] and [kat]... well, and the rest of you... it would have been really boring."
    ama "*Lacht* Und wenn [emm] und [kat] nicht gewesen wären... naja, und der Rest von euch... wäre es echt langweilig geworden."

# game/scripts/c31/c31.rpy:3135
translate german c31s005_houseArrival_48236755:

    # mc "I can't argue with that."
    mc "Da kann ich nicht widersprechen."

# game/scripts/c31/c31.rpy:3137
translate german c31s005_houseArrival_defe69fb:

    # bet "Guys, just a reminder that it's past 4. We need to get some sleep if we have to be at the base by 8 tomorrow."
    bet "Leute, nur zur Erinnerung, es ist nach 4. Wir müssen etwas schlafen, wenn wir morgen um 8 auf der Basis sein müssen."

# game/scripts/c31/c31.rpy:3138
translate german c31s005_houseArrival_337435f8:

    # mc "You're going to sleep more? You spent almost the whole flight sleeping!"
    mc "Du willst noch mehr schlafen? Du hast fast den ganzen Flug über geschlafen!"

# game/scripts/c31/c31.rpy:3140
translate german c31s005_houseArrival_ce05bbbe:

    # bet "*Laugh* At my age, a girl needs her beauty sleep."
    bet "*Lacht* In meinem Alter braucht ein Mädchen ihren Schönheitsschlaf."

# game/scripts/c31/c31.rpy:3142
translate german c31s005_houseArrival_823cdb3f:

    # ama "Leave the big suitcases in the kitchen. We'll sort everything out tomorrow. It's too late to start unpacking today."
    ama "Lasst die großen Koffer in der Küche. Wir kümmern uns morgen um alles. Es ist zu spät, um heute noch mit dem Auspacken anzufangen."

# game/scripts/c31/c31.rpy:3143
translate german c31s005_houseArrival_32d864f3:

    # ama "Grab the essentials for the night."
    ama "Nehmt euch nur das Nötigste für die Nacht."

# game/scripts/c31/c31.rpy:3144
translate german c31s005_houseArrival_dbe078ec:

    # mc "My toiletry bag and not much else."
    mc "Mein Kulturbeutel und sonst nicht viel."

# game/scripts/c31/c31.rpy:3146
translate german c31s005_houseArrival_bc145742:

    # "[ama] walks [bet] to her room first, before showing you to yours."
    "[ama] bringt [bet] zuerst auf ihr Zimmer, bevor sie dir deins zeigt."

# game/scripts/c31/c31.rpy:3147
translate german c31s005_houseArrival_de7cc760:

    # "It's exactly like the photos you saw, with spectacular views of the Caribbean."
    "Es ist genau wie auf den Fotos, die du gesehen hast, mit einem spektakulären Blick auf die Karibik."

# game/scripts/c31/c31.rpy:3149
translate german c31s005_houseArrival_97ff6797:

    # ama "This is the master bedroom. There's the restroom, and over there are the stairs down to the panic room."
    ama "Das ist das Hauptschlafzimmer. Da ist das Badezimmer und dort drüben ist die Treppe hinunter zum Panikraum."

# game/scripts/c31/c31.rpy:3150
translate german c31s005_houseArrival_dc2088e7:

    # mc "I hope I never have to use them."
    mc "Ich hoffe, ich muss sie nie benutzen."

# game/scripts/c31/c31.rpy:3151
translate german c31s005_houseArrival_afdf5be0:

    # ama "Me too. The house has never been attacked, so that room has only been used as a command and surveillance center."
    ama "Ich auch. Das Haus wurde noch nie angegriffen, also wurde dieser Raum bisher nur als Kommando- und Überwachungszentrum genutzt."

# game/scripts/c31/c31.rpy:3155
translate german c31s005_houseArrival_d259401b:

    # ama "Good night, [mc]. I'll see you tomorrow... Or in about two and a half hours."
    ama "Gute Nacht, [mc]. Wir sehen uns morgen... Oder in etwa zweieinhalb Stunden."

# game/scripts/c31/c31.rpy:3156
translate german c31s005_houseArrival_47450581:

    # mc "Good night, sweetheart. Get some rest."
    mc "Gute Nacht, Süße. Ruh dich etwas aus."

# game/scripts/c31/c31.rpy:3158
translate german c31s005_houseArrival_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."

# game/scripts/c31/c31.rpy:3160
translate german c31s005_houseArrival_09360d88:

    # ama "Yes...?"
    ama "Ja...?"

# game/scripts/c31/c31.rpy:3161
translate german c31s005_houseArrival_a17fb7e0:

    # mc "Are you going to be okay? If you want to stay the night, that bed is big."
    mc "Kommst du klar? Wenn du über Nacht bleiben willst, das Bett ist groß."

# game/scripts/c31/c31.rpy:3163
translate german c31s005_houseArrival_016fcb47:

    # ama "Don't worry about me. I'll be fine. But thanks anyway."
    ama "Mach dir keine Sorgen um mich. Mir wird es gut gehen. Aber trotzdem danke."

# game/scripts/c31/c31.rpy:3164
translate german c31s005_houseArrival_0307e973:

    # mc "If you need me, you know where I live. *Laugh*"
    mc "Wenn du mich brauchst, weißt du ja, wo ich wohne. *Lacht*"

# game/scripts/c31/c31.rpy:3165
translate german c31s005_houseArrival_5e0780c6:

    # ama "I'll keep that in mind. Get some rest."
    ama "Ich werde es mir merken. Ruh dich etwas aus."

# game/scripts/c31/c31.rpy:3167
translate german c31s005_houseArrival_d4e77122:

    # "You undress and freshen up. You leave your boxers on just in case one of the two women decides to make an appearance in the room."
    "Du ziehst dich aus und machst dich frisch. Du behältst deine Boxershorts an, nur für den Fall, dass eine der beiden Frauen beschließt, im Zimmer aufzutauchen."

# game/scripts/c31/c31.rpy:3168
translate german c31s005_houseArrival_fb690820:

    # "You're not sleepy after the time you spent sleeping on the plane."
    "Du bist nicht müde, nachdem du im Flugzeug geschlafen hast."

# game/scripts/c31/c31.rpy:3169
translate german c31s005_houseArrival_45763d5d:

    # mcp "(Tomorrow is going to be an interesting day.)"
    mcp "(Morgen wird ein interessanter Tag.)"

# game/scripts/c31/c31.rpy:3171
translate german c31s005_houseArrival_3b889a27:

    # "You pour yourself some pineapple juice and step out onto the room's balcony."
    "Du schenkst dir etwas Ananassaft ein und trittst auf den Balkon des Zimmers."

# game/scripts/c31/c31.rpy:3172
translate german c31s005_houseArrival_656c6488:

    # "The Caribbean shines beneath the stars."
    "Die Karibik erstrahlt unter den Sternen."

# game/scripts/c31/c31.rpy:3173
translate german c31s005_houseArrival_88d83a1b:

    # "If you haven't lost your sense of direction, you figure this balcony faces East, so the sun will wake you up when it rises."
    "Wenn du deinen Orientierungssinn nicht verloren hast, schätzt du, dass dieser Balkon nach Osten ausgerichtet ist, sodass dich die Sonne wecken wird, wenn sie aufgeht."

# game/scripts/c31/c31.rpy:3175
translate german c31s005_houseArrival_892927af:

    # "You can only imagine what the house would look like from a boat on the sea."
    "Du kannst dir nur vorstellen, wie das Haus von einem Boot auf dem Meer aussehen würde."

# game/scripts/c31/c31.rpy:3176
translate german c31s005_houseArrival_669c279f:

    # "It's probably just a dark mass against the starry sky right now. You'll have to see it during the day."
    "Im Moment ist es wahrscheinlich nur eine dunkle Masse gegen den Sternenhimmel. Du wirst es dir tagsüber ansehen müssen."

# game/scripts/c31/c31.rpy:3177
translate german c31s005_houseArrival_c34fa20d:

    # mcp "(I should go to sleep. It wouldn't make a very good impression if the CEO fell asleep in the middle of meetings on his first day.)"
    mcp "(Ich sollte schlafen gehen. Es würde keinen sehr guten Eindruck machen, wenn der CEO an seinem ersten Tag mitten in den Meetings einschläft.)"

# game/scripts/c31/c31.rpy:3179
translate german c31s005_houseArrival_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c31/c31.rpy:3180
translate german c31s005_houseArrival_ab770f08:

    # "A knock snaps you out of your daydreams. Some habits never change, even if you change countries."
    "Ein Klopfen reißt dich aus deinen Tagträumen. Manche Gewohnheiten ändern sich nie, selbst wenn man das Land wechselt."

# game/scripts/c31/c31.rpy:3181
translate german c31s005_houseArrival_2ffbba0b:

    # ama "*Through the door* It's me. Can I come in?"
    ama "*Durch die Tür* Ich bin's. Kann ich reinkommen?"

# game/scripts/c31/c31.rpy:3182
translate german c31s005_houseArrival_3b55a4ab:

    # mc "Yes, come in."
    mc "Ja, komm rein."

# game/scripts/c31/c31.rpy:3184
translate german c31s005_houseArrival_0269f882:

    # mc "Did you forget something?"
    mc "Hast du etwas vergessen?"

# game/scripts/c31/c31.rpy:3185
translate german c31s005_houseArrival_203fd4fe:

    # ama "To accept your offer to stay the night."
    ama "Dein Angebot anzunehmen, über Nacht zu bleiben."

# game/scripts/c31/c31.rpy:3186
translate german c31s005_houseArrival_98c81edc:

    # ama "I saw a light on your balcony and..."
    ama "Ich habe Licht auf deinem Balkon gesehen und..."

# game/scripts/c31/c31.rpy:3187
translate german c31s005_houseArrival_6e83634c:

    # mc "You don't have to explain yourself for accepting an offer I made you."
    mc "Du musst dich nicht dafür rechtfertigen, dass du ein Angebot annimmst, das ich dir gemacht habe."

# game/scripts/c31/c31.rpy:3189
translate german c31s005_houseArrival_5d454985:

    # ama "This is going to be really hard..."
    ama "Das wird wirklich schwer werden..."

# game/scripts/c31/c31.rpy:3190
translate german c31s005_houseArrival_96bd13db:

    # mc "Nothing we can't overcome together, [ama]."
    mc "Nichts, was wir nicht gemeinsam durchstehen können, [ama]."

# game/scripts/c31/c31.rpy:3191
translate german c31s005_houseArrival_b5587787:

    # mc "And you survived [emm]'s room without gouging your eyes out."
    mc "Und du hast [emm]s Zimmer überlebt, ohne dir die Augen auszukratzen."

# game/scripts/c31/c31.rpy:3192
translate german c31s005_houseArrival_06edb69f:

    # mc "I don't think a few clones will be able to defeat you."
    mc "Ich glaube nicht, dass ein paar Klone dich besiegen können."

# game/scripts/c31/c31.rpy:3194
translate german c31s005_houseArrival_f0ab3851:

    # ama "The problem isn't going to be the clones... Or at least they won't be the main problem."
    ama "Das Problem werden nicht die Klone sein... Oder zumindest werden sie nicht das Hauptproblem sein."

# game/scripts/c31/c31.rpy:3195
translate german c31s005_houseArrival_63f18179:

    # ama "I don't know how the rest of the staff will take the changes we want to make to the company."
    ama "Ich weiß nicht, wie der Rest der Belegschaft die Änderungen aufnehmen wird, die wir in der Firma vornehmen wollen."

# game/scripts/c31/c31.rpy:3196
translate german c31s005_houseArrival_74d2ffe2:

    # mc "Me neither, but you know what?"
    mc "Ich auch nicht, aber weißt du was?"

# game/scripts/c31/c31.rpy:3198
translate german c31s005_houseArrival_e44310b5:

    # ama "What?"
    ama "Was?"

# game/scripts/c31/c31.rpy:3199
translate german c31s005_houseArrival_58c4108e:

    # mc "That's something we'll start figuring out tomorrow. Let's not worry about it today."
    mc "Das ist etwas, womit wir uns ab morgen beschäftigen werden. Lass uns heute nicht darüber nachdenken."

# game/scripts/c31/c31.rpy:3201
translate german c31s005_houseArrival_c1cd90f3:

    # mc "Today all I want is to sleep with my wife. Even if it's only for two and a half hours."
    mc "Heute will ich nur noch mit meiner Frau schlafen. Auch wenn es nur für zweieinhalb Stunden ist."

# game/scripts/c31/c31.rpy:3203
translate german c31s005_houseArrival_86ee3907:

    # ama "Two and a quarter hours. But it's just going to be sleeping..."
    ama "Zweieinviertel Stunden. Aber es wird nur geschlafen..."

# game/scripts/c31/c31.rpy:3204
translate german c31s005_houseArrival_214247f0:

    # mc "Yeah, don't worry. I don't want our first time to be like this, or so rushed."
    mc "Ja, keine Sorge. Ich will nicht, dass unser erstes Mal so abläuft oder so überstürzt ist."

# game/scripts/c31/c31.rpy:3205
translate german c31s005_houseArrival_a73b2ab8:

    # mc "Besides, we're tired from the trip today."
    mc "Außerdem sind wir heute müde von der Reise."

# game/scripts/c31/c31.rpy:3207
translate german c31s005_houseArrival_69c786b7:

    # ama "You're right. And no. I'm not going to buy you that shirt."
    ama "Du hast recht. Und nein. Ich werde dir dieses Shirt nicht kaufen."

# game/scripts/c31/c31.rpy:3208
translate german c31s005_houseArrival_f7270242:

    # mc "*Laugh* I think I'll end up having to order it online."
    mc "*Lacht* Ich glaube, ich werde es am Ende online bestellen müssen."

# game/scripts/c31/c31.rpy:3212
translate german c31s005_houseArrival_bd33b22a:

    # ama "Then, let's go to bed."
    ama "Dann lass uns ins Bett gehen."

# game/scripts/c31/c31.rpy:3213
translate german c31s005_houseArrival_c898a30c:

    # mc "After you."
    mc "Nach dir."

# game/scripts/c31/c31.rpy:3215
translate german c31s005_houseArrival_28bd9c12:

    # ama "By the way... I heard you slept naked. I don't know whether to feel disappointed."
    ama "Übrigens... ich habe gehört, du schläfst nackt. Ich weiß nicht, ob ich enttäuscht sein soll."

# game/scripts/c31/c31.rpy:3216
translate german c31s005_houseArrival_f826b8e1:

    # mc "That's something I can fix, if you want."
    mc "Das kann ich ändern, wenn du willst."

# game/scripts/c31/c31.rpy:3217
translate german c31s005_houseArrival_7ed56edc:

    # ama "*Laugh* I don't think I want to."
    ama "*Lacht* Ich glaube nicht, dass ich das will."

# game/scripts/c31/c31.rpy:3219
translate german c31s005_houseArrival_f5187d42:

    # ama "At least, not today."
    ama "Zumindest nicht heute."

# game/scripts/c31/c31.rpy:3220
translate german c31s005_houseArrival_f4cc3d5f:

    # ama "Remember we had cameras in your room. I've already seen everything there is to see."
    ama "Denk dran, wir hatten Kameras in deinem Zimmer. Ich habe schon alles gesehen, was es zu sehen gibt."

# game/scripts/c31/c31.rpy:3221
translate german c31s005_houseArrival_f1c647f7:

    # mc "Changing the subject, I love the Zeus nightgown."
    mc "Um das Thema zu wechseln, ich liebe das Zeus-Nachthemd."

# game/scripts/c31/c31.rpy:3222
translate german c31s005_houseArrival_3fa66fd4:

    # ama "I bought it before I met him, so it was just a nightgown with a bunch of cats on it."
    ama "Ich habe es gekauft, bevor ich ihn kennengelernt habe, also war es nur ein Nachthemd mit einem Haufen Katzen drauf."

# game/scripts/c31/c31.rpy:3223
translate german c31s005_houseArrival_ada77496:

    # mc "Are you going to take long to get into bed?"
    mc "Brauchst du lange, um ins Bett zu kommen?"

# game/scripts/c31/c31.rpy:3224
translate german c31s005_houseArrival_0a2c7118:

    # ama "No..."
    ama "Nein..."

# game/scripts/c31/c31.rpy:3226
translate german c31s005_houseArrival_5f11d045:

    # "Finally, [ama] decides to turn off the lights and get into bed with you."
    "Schließlich beschließt [ama], das Licht auszuschalten und zu dir ins Bett zu kommen."

# game/scripts/c31/c31.rpy:3227
translate german c31s005_houseArrival_390ccea4:

    # "As soon as you settle into each other's arms, you fall asleep like dormice under the moonlight filtering through the large window."
    "Sobald ihr euch in die Arme des anderen kuschelt, schlaft ihr wie Murmeltiere im Mondlicht ein, das durch das große Fenster fällt."

# game/scripts/c31/c31.rpy:3228
translate german c31s005_houseArrival_1c43d281:

    # "The day has been longer than either of you expected, and exhaustion has taken its toll on you."
    "Der Tag war länger, als ihr beide erwartet hattet, und die Erschöpfung hat ihren Tribut gefordert."

# game/scripts/c31/c31.rpy:3230
translate german c31s005_houseArrival_f2ebf9cc:

    # "You sleep with your wife for the first time. Even if it's just for a little over two hours."
    "Du schläfst zum ersten Mal mit deiner Frau in einem Bett. Auch wenn es nur für etwas mehr als zwei Stunden ist."

# game/scripts/c31/c31.rpy:3231
translate german c31s005_houseArrival_bdb3931a:

    # "You're going to have a month to sleep with her plenty of nights."
    "Du wirst einen Monat Zeit haben, um viele Nächte neben ihr zu schlafen."

# game/scripts/c31/c31.rpy:3236
translate german c31s006_Caroline_1a10c5f8:

    # "After breakfast, [ama] drives you to the base. It's less than 30 minutes from the house."
    "Nach dem Frühstück fährt [ama] dich zur Basis. Sie ist weniger als 30 Minuten vom Haus entfernt."

# game/scripts/c31/c31.rpy:2451
translate german c31s006_Caroline_020a6dc8:

    # "After breakfast, [ama] takes you to the base. It's less than 15 minutes from the house."
    "Nach dem Frühstück bringt [ama] dich zur Basis. Sie ist weniger als 15 Minuten vom Haus entfernt."

# game/scripts/c31/c31.rpy:2452
translate german c31s006_Caroline_36340068:

    # ama "Well, here we are. This is NTR's main base."
    ama "Nun, da sind wir. Das ist die Hauptbasis von NTR."

# game/scripts/c31/c31.rpy:2453
translate german c31s006_Caroline_b8d84426:

    # mc "It's impressive. Although it looks more like a factory than what you'd imagine a military base to be."
    mc "Es ist beeindruckend. Obwohl es eher wie eine Fabrik aussieht als das, was man sich unter einer Militärbasis vorstellt."

# game/scripts/c31/c31.rpy:2455
translate german c31s006_Caroline_e6d884d4:

    # bet "It has acted as a factory of clones, death, and misery for a long time."
    bet "Es hat lange Zeit als Fabrik für Klone, Tod und Elend gedient."

# game/scripts/c31/c31.rpy:2456
translate german c31s006_Caroline_1e4592a3:

    # mc "You're right..."
    mc "Du hast recht..."

# game/scripts/c31/c31.rpy:2458
translate german c31s006_Caroline_0ac894ba:

    # ama "We're going to start the tour with the most important person you'll have to deal with in the coming months."
    ama "Wir beginnen den Rundgang mit der wichtigsten Person, mit der du in den kommenden Monaten zu tun haben wirst."

# game/scripts/c31/c31.rpy:2459
translate german c31s006_Caroline_263e99ec:

    # mc "[mael], the Head of the Science Department? Or [vin], from Accounting? I thought we had a meeting with them later."
    mc "[mael], der Leiter der Wissenschaftsabteilung? Oder [vin] aus der Buchhaltung? Ich dachte, wir hätten später ein Meeting mit ihnen."

# game/scripts/c31/c31.rpy:2461
translate german c31s006_Caroline_7619f015:

    # ama "[car], your secretary."
    ama "[car], deine Sekretärin."

# game/scripts/c31/c31.rpy:2462
translate german c31s006_Caroline_27bb2658:

    # "That index finger pointing to the sky is such a Marks pose... You haven't been here a day and you're already missing the family."
    "Dieser in den Himmel zeigende Zeigefinger ist so eine typische Marks-Pose... Du bist noch nicht mal einen Tag hier und vermisst schon die Familie."

# game/scripts/c31/c31.rpy:2463
translate german c31s006_Caroline_23850e58:

    # mc "I wasn't expecting that. I read her file... She was Daniels' secretary... And Richards' before him."
    mc "Das habe ich nicht erwartet. Ich habe ihre Akte gelesen... Sie war Daniels' Sekretärin... Und davor die von Richards."

# game/scripts/c31/c31.rpy:2464
translate german c31s006_Caroline_ef968228:

    # mc "And Uncle Mike's. She's been here since the company moved to Aruba."
    mc "Und die von Onkel Mike. Sie ist hier, seit die Firma nach Aruba gezogen ist."

# game/scripts/c31/c31.rpy:2465
translate german c31s006_Caroline_a78ce96d:

    # ama "She's loyal to the company, not the CEO of the moment. If you win her over, she'll be a great help to you."
    ama "Sie ist der Firma gegenüber loyal, nicht dem jeweiligen CEO. Wenn du sie für dich gewinnst, wird sie dir eine große Hilfe sein."

# game/scripts/c31/c31.rpy:2466
translate german c31s006_Caroline_759e31a4:

    # ama "You won't be able to make this work without her help. She knows everything and everyone."
    ama "Ohne ihre Hilfe wirst du das hier nicht wuppen können. Sie kennt alles und jeden."

# game/scripts/c31/c31.rpy:2467
translate german c31s006_Caroline_33ab9927:

    # ama "And don't let her looks fool you. She could chew bullets if she wanted to."
    ama "Und lass dich nicht von ihrem Aussehen täuschen. Sie könnte Kugeln kauen, wenn sie wollte."

# game/scripts/c31/c31.rpy:2469
translate german c31s006_Caroline_237d6a3c:

    # bet "A secretary can make your life very easy or very difficult."
    bet "Eine Sekretärin kann dir das Leben sehr leicht oder sehr schwer machen."

# game/scripts/c31/c31.rpy:2470
translate german c31s006_Caroline_7b639aef:

    # bet "I think [ama] is right that she should be the first person you meet."
    bet "Ich denke, [ama] hat recht, dass sie die erste Person sein sollte, die du triffst."

# game/scripts/c31/c31.rpy:2471
translate german c31s006_Caroline_3dc08b87:

    # bet "And remember, first impressions are important. Don't fuck it up."
    bet "Und denk dran, der erste Eindruck ist wichtig. Verkack es nicht."

# game/scripts/c31/c31.rpy:2472
translate german c31s006_Caroline_f02557ac:

    # mc "*Laughs* The confidence you place in me is reassuring."
    mc "*Lacht* Das Vertrauen, das du in mich setzt, ist beruhigend."

# game/scripts/c31/c31.rpy:2473
translate german c31s006_Caroline_ff41ca5a:

    # mc "Let's go meet the fearsome [car]."
    mc "Lass uns die furchteinflößende [car] treffen."

# game/scripts/c31/c31.rpy:2475
translate german c31s006_Caroline_b8f4b2ad:

    # ama "Caroline, meet [mc] Marks. The new CEO."
    ama "Caroline, das ist [mc] Marks. Der neue CEO."

# game/scripts/c31/c31.rpy:2476
translate german c31s006_Caroline_f4df7136:

    # ama "[bet] Cavendish is also here, the surgeon who's going to operate on [gav]."
    ama "[bet] Cavendish ist auch hier, die Chirurgin, die [gav] operieren wird."

# game/scripts/c31/c31.rpy:2477
translate german c31s006_Caroline_2e8abe0d:

    # car "Nice to meet you. I hope the house was to your liking, Mr. Marks."
    car "Schön, Sie kennenzulernen. Ich hoffe, das Haus war nach Ihrem Geschmack, Mr. Marks."

# game/scripts/c31/c31.rpy:2478
translate german c31s006_Caroline_d982c5ca:

    # mc "Likewise, [car]."
    mc "Ganz meinerseits, [car]."

# game/scripts/c31/c31.rpy:2479
translate german c31s006_Caroline_05f1df77:

    # mc "The house is impressive, thank you."
    mc "Das Haus ist beeindruckend, danke."

# game/scripts/c31/c31.rpy:2481
translate german c31s006_Caroline_a543b3ea:

    # car "You have a tight schedule today, Mr. Marks."
    car "Sie haben heute einen straffen Zeitplan, Mr. Marks."

# game/scripts/c31/c31.rpy:2482
translate german c31s006_Caroline_86007264:

    # mc "Call me [mc], please."
    mc "Nennen Sie mich bitte [mc]."

# game/scripts/c31/c31.rpy:2483
translate german c31s006_Caroline_4046077a:

    # car "First up is the sightseeing tour of the main base facilities."
    car "Als Erstes steht die Besichtigungstour der Einrichtungen der Hauptbasis an."

# game/scripts/c31/c31.rpy:2485
translate german c31s006_Caroline_aa575e46:

    # bet "*Laughs* The 'sightseeing tour' part sounded funny, [car]."
    bet "*Lacht* Der Teil mit der 'Besichtigungstour' klang lustig, [car]."

# game/scripts/c31/c31.rpy:2487
translate german c31s006_Caroline_f114ee19:

    # car "It's the first time we've had to show the facilities to a CEO. Until now, previous CEOs had risen through the ranks of the company."
    car "Es ist das erste Mal, dass wir einem CEO die Einrichtungen zeigen müssen. Bisher hatten sich die vorherigen CEOs durch die Ränge des Unternehmens hochgearbeitet."

# game/scripts/c31/c31.rpy:2488
translate german c31s006_Caroline_2210dd78:

    # car "They had earned the right to be here after years of service."
    car "Sie hatten sich das Recht, hier zu sein, nach jahrelangem Dienst verdient."

# game/scripts/c31/c31.rpy:2489
translate german c31s006_Caroline_1bf6c3c8:

    # mc "I hope I can earn that right."
    mc "Ich hoffe, ich kann mir dieses Recht verdienen."

# game/scripts/c31/c31.rpy:2491
translate german c31s006_Caroline_eae358d5:

    # car "I hope so too, Mr. Marks."
    car "Das hoffe ich auch, Mr. Marks."

# game/scripts/c31/c31.rpy:2492
translate german c31s006_Caroline_e2a2531e:

    # car "There's been a problem with David, the operative who was supposed to give you the tour."
    car "Es gab ein Problem mit David, dem Agenten, der Ihnen die Tour geben sollte."

# game/scripts/c31/c31.rpy:2494
translate german c31s006_Caroline_2c93df91:

    # ama "Is he okay?"
    ama "Geht es ihm gut?"

# game/scripts/c31/c31.rpy:2495
translate german c31s006_Caroline_ad909581:

    # car "Just a sprained ankle. I'm waiting for [aar] to tell me who's going to replace him for the tour."
    car "Nur ein verstauchter Knöchel. Ich warte darauf, dass [aar] mir sagt, wer ihn für die Tour ersetzen wird."

# game/scripts/c31/c31.rpy:2497
translate german c31s006_Caroline_232d656f:

    # ama "Don't worry about that. Tell [aar] that I'll show [mc] around the base."
    ama "Mach dir darüber keine Sorgen. Sag [aar], dass ich [mc] auf der Basis herumführen werde."

# game/scripts/c31/c31.rpy:2498
translate german c31s006_Caroline_d5aa9e6d:

    # car "Sounds like a good solution. If we have to wait for [aar], we'd probably have to cut the tour short."
    car "Klingt nach einer guten Lösung. Wenn wir auf [aar] warten müssen, müssten wir die Tour wahrscheinlich abkürzen."

# game/scripts/c31/c31.rpy:2499
translate german c31s006_Caroline_720cfcd9:

    # mc "So that's one problem solved. Anything else?"
    mc "Damit wäre ein Problem gelöst. Sonst noch was?"

# game/scripts/c31/c31.rpy:2501
translate german c31s006_Caroline_9d99232a:

    # car "After the tour, you have the meeting with the department heads. In two hours."
    car "Nach der Tour hast du das Meeting mit den Abteilungsleitern. In zwei Stunden."

# game/scripts/c31/c31.rpy:2502
translate german c31s006_Caroline_287f1372:

    # mc "Sweet, [car]."
    mc "Super, [car]."

# game/scripts/c31/c31.rpy:2505
translate german c31s006_Caroline_fa033f4c:

    # bet "Bam Bam Baa."
    bet "Bam Bam Baa."

# game/scripts/c31/c31.rpy:2507
translate german c31s006_Caroline_ebfa80d0:

    # car "..."
    car "..."

# game/scripts/c31/c31.rpy:2509
translate german c31s006_Caroline_103e00b6:

    # car "After that, you have a meeting with IT Support, where they'll give you a brief training on the company's software."
    car "Danach hast du ein Meeting mit dem IT-Support, wo sie dir eine kurze Schulung zur Unternehmenssoftware geben."

# game/scripts/c31/c31.rpy:2510
translate german c31s006_Caroline_0b829346:

    # car "And, whenever you have a moment, I need to give you the Employee Handbook, where you'll find all the information you need."
    car "Und sobald du einen Moment Zeit hast, muss ich dir das Mitarbeiterhandbuch geben, in dem du alle nötigen Informationen findest."

# game/scripts/c31/c31.rpy:2511
translate german c31s006_Caroline_9f74374e:

    # car "I've left enough time between both meetings so you won't be stressed for time on your first day."
    car "Ich habe genug Zeit zwischen beiden Meetings gelassen, damit du an deinem ersten Tag nicht in Zeitnot gerätst."

# game/scripts/c31/c31.rpy:2512
translate german c31s006_Caroline_da378e55:

    # mc "Thanks, [car]."
    mc "Danke, [car]."

# game/scripts/c31/c31.rpy:2516
translate german c31s006_Caroline_9402cb80:

    # car "In the afternoon, you have a meeting with [aar]. He will give you an {b}{u}exhaustive{/u}{/b} report on his management these past few days."
    car "Am Nachmittag hast du ein Meeting mit [aar]. Er wird dir einen {b}{u}umfassenden{/u}{/b} Bericht über seine Führung in den letzten Tagen geben."

# game/scripts/c31/c31.rpy:2517
translate german c31s006_Caroline_76404822:

    # mc "That sounds like you've suffered through [aar]'s reports too."
    mc "Klingt so, als hätten Sie auch schon unter [aar]s Berichten gelitten."

# game/scripts/c31/c31.rpy:2519
translate german c31s006_Caroline_49687396:

    # car "Executive reports should be concise, Mr. Marks."
    car "Managementberichte sollten prägnant sein, Mr. Marks."

# game/scripts/c31/c31.rpy:2520
translate german c31s006_Caroline_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c31/c31.rpy:2521
translate german c31s006_Caroline_4725d612:

    # car "You're not going to have time to worry about whether the ammo stock will last nine months and two days or only nine months."
    car "Sie werden keine Zeit haben, sich darüber den Kopf zu zerbrechen, ob der Munitionsvorrat neun Monate und zwei Tage oder nur neun Monate reicht."

# game/scripts/c31/c31.rpy:2522
translate german c31s006_Caroline_7f36e1a2:

    # mc "I agree."
    mc "Da stimme ich zu."

# game/scripts/c31/c31.rpy:2524
translate german c31s006_Caroline_d8af4fd3:

    # car "You should leave now if you don't want to cut the visit short. We'll talk later when the first meeting is over."
    car "Sie sollten jetzt gehen, wenn Sie den Besuch nicht abkürzen wollen. Wir sprechen später, wenn das erste Meeting vorbei ist."

# game/scripts/c31/c31.rpy:2525
translate german c31s006_Caroline_b3b3c37a:

    # mc "Perfect, [car]."
    mc "Perfekt, [car]."

# game/scripts/c31/c31.rpy:2527
translate german c31s006_Caroline_4f14db7a:

    # mc "[bet], I think you forgot about the first impression thing."
    mc "[bet], ich glaube, du hast die Sache mit dem ersten Eindruck vergessen."

# game/scripts/c31/c31.rpy:2528
translate german c31s006_Caroline_17051cf0:

    # bet "I didn't forget. But ever since I heard her name, I've had that song stuck in my head."
    bet "Hab ich nicht. Aber seit ich ihren Namen gehört habe, geht mir dieser Song nicht mehr aus dem Kopf."

# game/scripts/c31/c31.rpy:2529
translate german c31s006_Caroline_568bf98f:

    # bet "And if she focuses on the CEO's eccentric aunt, you'll look better by comparison."
    bet "Und wenn sie sich auf die exzentrische Tante des CEOs konzentriert, stehst du im Vergleich gleich viel besser da."

# game/scripts/c31/c31.rpy:2530
translate german c31s006_Caroline_941197f0:

    # ama "I don't know what song you're talking about, nor did I understand your gesture, Aunt [bet]."
    ama "Ich weiß nicht, von welchem Song du sprichst, und ich habe auch deine Geste nicht verstanden, Tante [bet]."

# game/scripts/c31/c31.rpy:2532
translate german c31s006_Caroline_1b5e90ca:

    # bet "We need to start working on your musical education, my girl. It's a classic from '69!"
    bet "Wir müssen anfangen, an deiner musikalischen Bildung zu arbeiten, mein Mädchen. Das ist ein Klassiker von '69!"

# game/scripts/c31/c31.rpy:2533
translate german c31s006_Caroline_7d262a9a:

    # ama "There will be time for that later. We should start the tour now."
    ama "Dafür ist später noch Zeit. Wir sollten jetzt mit der Führung beginnen."

# game/scripts/c31/c31.rpy:2534
translate german c31s006_Caroline_4f9d9d29:

    # mc "Whenever you're ready. I think I would've gotten lost a couple of times by now."
    mc "Wann immer du bereit bist. Ich glaube, ich hätte mich bis jetzt schon ein paar Mal verlaufen."

# game/scripts/c31/c31.rpy:3136
translate german c31s006_baseArrival_a0b85b73:

    # ama "This way. I'll try not to overwhelm you, but there's a lot to see."
    ama "Hier entlang. Ich werde versuchen, dich nicht zu überfordern, aber es gibt viel zu sehen."

# game/scripts/c31/c31.rpy:3137
translate german c31s006_baseArrival_4bb2aef5:

    # mc "Don't worry. I prefer to see everything at once and get a real feel for the place."
    mc "Keine Sorge. Ich bevorzuge es, alles auf einmal zu sehen und ein echtes Gefühl für den Ort zu bekommen."

# game/scripts/c31/c31.rpy:3138
translate german c31s006_baseArrival_0c5b78d4:

    # ama "As you wish. Let's start with the troop dorms."
    ama "Wie du wünschst. Fangen wir mit den Schlafsälen der Truppen an."

# game/scripts/c31/c31.rpy:3141
translate german c31s006_baseArrival_c5972219:

    # ama "The operatives sleep here. Bunk beds, individual lockers, common area at the back."
    ama "Die Einsatzkräfte schlafen hier. Etagenbetten, eigene Spinde, Gemeinschaftsbereich hinten."

# game/scripts/c31/c31.rpy:3142
translate german c31s006_baseArrival_744b9b50:

    # mc "It's... functional."
    mc "Es ist... zweckmäßig."

# game/scripts/c31/c31.rpy:3144
translate german c31s006_baseArrival_10e00322:

    # ama "That's the nicest thing you could say about it."
    ama "Das ist das Netteste, was man darüber sagen kann."

# game/scripts/c31/c31.rpy:3145
translate german c31s006_baseArrival_214be116:

    # mc "How many share a room?"
    mc "Wie viele teilen sich ein Zimmer?"

# game/scripts/c31/c31.rpy:3147
translate german c31s006_baseArrival_d9244d75:

    # ama "Sixteen per module. There are six modules in this block. There are six blocks."
    ama "Sechzehn pro Modul. Es gibt sechs Module in diesem Block. Es gibt sechs Blöcke."


# game/scripts/c31/c31.rpy:3148
translate german c31s006_baseArrival_620f54f4:

    # mc "And this hasn't changed in years?"
    mc "Und das hat sich seit Jahren nicht geändert?"

# game/scripts/c31/c31.rpy:3149
translate german c31s006_baseArrival_aa62e8ee:

    # ama "No. The previous management saw no reason to improve what they considered sufficient."
    ama "Nein. Das vorherige Management sah keinen Grund, etwas zu verbessern, das sie als ausreichend erachteten."

# game/scripts/c31/c31.rpy:3150
translate german c31s006_baseArrival_f985dcb7:

    # mc "Well, I do."
    mc "Nun, ich schon."

# game/scripts/c31/c31.rpy:3152
translate german c31s006_baseArrival_af45e037:

    # ama "I know."
    ama "Ich weiß."

# game/scripts/c31/c31.rpy:3150
translate german c31s006_baseArrival_1f2a88c0:

    # mc "Did you grow up here?"
    mc "Bist du hier aufgewachsen?"

# game/scripts/c31/c31.rpy:3152
translate german c31s006_baseArrival_a216b640:

    # ama "In a smaller module, just for the girls. It's basically the same, but our common area is bigger."
    ama "In einem kleineren Modul, nur für die Mädchen. Es ist im Grunde dasselbe, aber unser Gemeinschaftsbereich ist größer."

# game/scripts/c31/c31.rpy:3153
translate german c31s006_baseArrival_e71c5eb9:

    # ama "We had to specialize in more things, so we had to train with different devices."
    ama "Wir mussten uns auf mehr Dinge spezialisieren, also mussten wir mit verschiedenen Geräten trainieren."

# game/scripts/c31/c31.rpy:3154
translate german c31s006_baseArrival_d56b9c53:

    # mc "I get it."
    mc "Verstehe."

# game/scripts/c31/c31.rpy:3154
translate german c31s006_baseArrival_db787fdc:

    # bet "I'd say it smells like a gym locker room, but I don't want to be cruel... with gym locker rooms."
    bet "Ich würde sagen, es riecht wie eine Umkleidekabine im Fitnessstudio, aber ich will nicht grausam sein... zu Umkleidekabinen."

# game/scripts/c31/c31.rpy:3155
translate german c31s006_baseArrival_460a30af:

    # mc "You notice it too?"
    mc "Fällt dir das auch auf?"

# game/scripts/c31/c31.rpy:3156
translate german c31s006_baseArrival_2318742c:

    # bet "I've been here five minutes and I'm already getting used to it. That's scarier."
    bet "Ich bin erst fünf Minuten hier und gewöhne mich schon daran. Das ist noch gruseliger."

# game/scripts/c31/c31.rpy:3158
translate german c31s006_baseArrival_7bead8a2:

    # ama "Poor ventilation. It's been on the pending renovations list for two years."
    ama "Schlechte Belüftung. Steht seit zwei Jahren auf der Liste für anstehende Renovierungen."

# game/scripts/c31/c31.rpy:3159
translate german c31s006_baseArrival_fc784a98:

    # mc "Let me know when it moves to the top of that list."
    mc "Sag mir Bescheid, wenn es an die Spitze dieser Liste rückt."

# game/scripts/c31/c31.rpy:3160
translate german c31s006_baseArrival_53dd844a:

    # ama "Noted. Let's continue the visit."
    ama "Notiert. Setzen wir den Rundgang fort."

# game/scripts/c31/c31.rpy:3163
translate german c31s006_baseArrival_d4e96205:

    # ama "Main laboratory. Analysis, protocol development, applied research."
    ama "Hauptlabor. Analyse, Protokollentwicklung, angewandte Forschung."

# game/scripts/c31/c31.rpy:3164
translate german c31s006_baseArrival_772f75f4:

    # mc "Applied to what exactly?"
    mc "Angewandt worauf genau?"

# game/scripts/c31/c31.rpy:3165
translate german c31s006_baseArrival_8591b7a4:

    # ama "Physical performance enhancements, recovery treatments, field adaptations."
    ama "Körperliche Leistungssteigerungen, Erholungsbehandlungen, Feldanpassungen."

# game/scripts/c31/c31.rpy:3166
translate german c31s006_baseArrival_c102562d:

    # ama "And, obviously, improvements in cloning protocols."
    ama "Und natürlich Verbesserungen der Klonprotokolle."

# game/scripts/c31/c31.rpy:3168
translate german c31s006_baseArrival_3a86785f:

    # bet "This place is going to be a treat for [dap] and [sca]..."
    bet "Dieser Ort wird ein wahrer Leckerbissen für [dap] und [sca] sein..."

# game/scripts/c31/c31.rpy:3169
translate german c31s006_baseArrival_48cc3e9a:

    # mc "I don't understand what half the things I'm seeing are, but it all looks high-tech."
    mc "Ich verstehe zwar nicht, was die Hälfte der Dinge ist, die ich hier sehe, aber es sieht alles sehr nach High-Tech aus."

# game/scripts/c31/c31.rpy:3171
translate german c31s006_baseArrival_fe823e67:

    # ama "[mael], the head of the Science Department, has very refined tastes when it comes to ordering equipment."
    ama "[mael], der Leiter der Wissenschaftsabteilung, hat einen sehr erlesenen Geschmack, wenn es um die Bestellung von Ausrüstung geht."

# game/scripts/c31/c31.rpy:3172
translate german c31s006_baseArrival_f349d67a:

    # ama "And the most interesting part is what has been developed here, as proprietary technology."
    ama "Und der interessanteste Teil ist das, was hier als proprietäre Technologie entwickelt wurde."

# game/scripts/c31/c31.rpy:3173
translate german c31s006_baseArrival_4c9e2cef:

    # mc "That could be the cornerstone of what we want to do for the company's change in direction."
    mc "Das könnte der Grundstein für das sein, was wir für die Neuausrichtung des Unternehmens tun wollen."

# game/scripts/c31/c31.rpy:3175
translate german c31s006_baseArrival_4811af7c:

    # ama "I think we have a good foundation to start growing, but it will be clearer to you in the meeting in a little while."
    ama "Ich denke, wir haben ein gutes Fundament, um zu wachsen, aber das wird dir in der Besprechung nachher klarer werden."

# game/scripts/c31/c31.rpy:3176
translate german c31s006_baseArrival_eb9629cd:

    # mc "Was all this operational before I got the job?"
    mc "War das alles schon in Betrieb, bevor ich den Job bekommen habe?"

# game/scripts/c31/c31.rpy:3177
translate german c31s006_baseArrival_8be0bdfa:

    # ama "The lab, yes. Although some projects were put on hold with the change in management."
    ama "Das Labor, ja. Obwohl einige Projekte mit dem Führungswechsel auf Eis gelegt wurden."

# game/scripts/c31/c31.rpy:3178
translate german c31s006_baseArrival_276a0d79:

    # mc "Which ones?"
    mc "Welche?"

# game/scripts/c31/c31.rpy:3180
translate german c31s006_baseArrival_1d155b77:

    # ama "The ones that weren't profitable in the short term. Which coincidentally were the most interesting."
    ama "Diejenigen, die kurzfristig nicht profitabel waren. Die zufälligerweise die interessantesten waren."

# game/scripts/c31/c31.rpy:3181
translate german c31s006_baseArrival_5feeb067:

    # mc "Can I see what was put on hold?"
    mc "Kann ich sehen, was auf Eis gelegt wurde?"

# game/scripts/c31/c31.rpy:3182
translate german c31s006_baseArrival_6b7fdc17:

    # ama "I'll prepare a report for you. But let's keep moving for now."
    ama "Ich werde einen Bericht für dich vorbereiten. Aber lass uns erst mal weitergehen."

# game/scripts/c31/c31.rpy:3184
translate german c31s006_baseArrival_30a04035:

    # mc "Is no one working?"
    mc "Arbeitet hier niemand?"

# game/scripts/c31/c31.rpy:3185
translate german c31s006_baseArrival_b2e407c2:

    # ama "I think there are several team meetings going on, where they're finalizing the information they'll present to you shortly."
    ama "Ich glaube, es laufen gerade mehrere Teambesprechungen, in denen sie die Informationen fertigstellen, die sie dir gleich präsentieren werden."

# game/scripts/c31/c31.rpy:3186
translate german c31s006_baseArrival_8c0b8827:

    # ama "I get the feeling no one wanted to run into you before that meeting."
    ama "Ich habe das Gefühl, niemand wollte dir vor diesem Meeting über den Weg laufen."

# game/scripts/c31/c31.rpy:3187
translate german c31s006_baseArrival_3fac017b:

    # mc "I understand."
    mc "Ich verstehe."

# game/scripts/c31/c31.rpy:3190
translate german c31s006_baseArrival_18890a76:

    # ama "Cloning Room 1."
    ama "Klonraum 1."

# game/scripts/c31/c31.rpy:3193
translate german c31s006_baseArrival_437a7119:

    # mc "For God's sake!"
    mc "Um Himmels willen!"

# game/scripts/c31/c31.rpy:3191
translate german c31s006_baseArrival_0a835d55:

    # mc "For God's sake!"
    mc "Um Himmels willen!"

# game/scripts/c31/c31.rpy:3194
translate german c31s006_baseArrival_61ec9ea1:

    # ama "Yeah. [eva] and I were born in there."
    ama "Ja. [eva] und ich wurden dort geboren."

# game/scripts/c31/c31.rpy:3196
translate german c31s006_baseArrival_b55592fd:

    # ama "Yes. [eri], [dap], and [emm] were born in there."
    ama "Ja. [eri], [dap] und [emm] wurden dort geboren."

# game/scripts/c31/c31.rpy:3197
translate german c31s006_baseArrival_6109e69f:

    # ama "I haven't been here in years..."
    ama "Ich war seit Jahren nicht mehr hier..."

# game/scripts/c31/c31.rpy:3201
translate german c31s006_baseArrival_a1060dd4:

    # "You feel tempted to hug the mercenary, but the emotional weight in her voice tells you it's not the best time."
    "Du bist in Versuchung, die Söldnerin zu umarmen, aber die emotionale Schwere in ihrer Stimme verrät dir, dass es nicht der beste Zeitpunkt ist."

# game/scripts/c31/c31.rpy:3203
translate german c31s006_baseArrival_874cb6b0:

    # "The emotional weight in her voice tells you that, even though she wasn't born in this room, it's not a pleasant place for her."
    "Die emotionale Schwere in ihrer Stimme verrät dir, dass es kein angenehmer Ort für sie ist, auch wenn sie nicht in diesem Raum geboren wurde."

# game/scripts/c31/c31.rpy:3198
translate german c31s006_baseArrival_6c0f2e3f:

    # mc "Is it still active?"
    mc "Ist er noch aktiv?"

# game/scripts/c31/c31.rpy:3200
translate german c31s006_baseArrival_f0d573c0:

    # ama "Yes, all the cloning tubes are full. [mael] can give you the details on them."
    ama "Ja, alle Klonröhren sind voll. [mael] kann dir die Details dazu geben."

# game/scripts/c31/c31.rpy:3201
translate german c31s006_baseArrival_df3eb5ca:

    # ama "I'm not going to give you the numbers right now."
    ama "Ich werde dir die Zahlen jetzt noch nicht geben."

# game/scripts/c31/c31.rpy:3202
translate german c31s006_baseArrival_442d7fdf:

    # mc "Why not?"
    mc "Warum nicht?"

# game/scripts/c31/c31.rpy:3204
translate german c31s006_baseArrival_4b72efc3:

    # ama "Because we're on a tour and I prefer you go into today's meeting with a clear head."
    ama "Weil wir auf einer Tour sind und ich es vorziehe, dass du mit einem klaren Kopf in das heutige Meeting gehst."

# game/scripts/c31/c31.rpy:3206
translate german c31s006_baseArrival_973dfa6e:

    # bet "It's her way of saying they're impressive numbers."
    bet "Das ist ihre Art zu sagen, dass es beeindruckende Zahlen sind."

# game/scripts/c31/c31.rpy:3207
translate german c31s006_baseArrival_bf29b46d:

    # mc "Are they?"
    mc "Sind sie das?"

# game/scripts/c31/c31.rpy:3208
translate german c31s006_baseArrival_ce891c2e:

    # bet "Very. I've been talking to [mael] these past few days."
    bet "Sehr. Ich habe in den letzten Tagen mit [mael] gesprochen."

# game/scripts/c31/c31.rpy:3210
translate german c31s006_baseArrival_41618d42:

    # mc "What do we do with all this? With the room, with the equipment?"
    mc "Was machen wir mit all dem? Mit dem Raum, mit der Ausrüstung?"

# game/scripts/c31/c31.rpy:3211
translate german c31s006_baseArrival_5d21dd38:

    # ama "That's exactly the kind of question we need you to ask at the meeting. And answer it."
    ama "Das ist genau die Art von Frage, die du beim Meeting stellen musst. Und sie beantworten."

# game/scripts/c31/c31.rpy:3212
translate german c31s006_baseArrival_e6326af3:

    # mc "I don't have an answer yet."
    mc "Ich habe noch keine Antwort."

# game/scripts/c31/c31.rpy:3213
translate german c31s006_baseArrival_76b508e2:

    # ama "You don't need one today."
    ama "Du brauchst heute auch noch keine."

# game/scripts/c31/c31.rpy:3215
translate german c31s006_baseArrival_3a77c5a2:

    # mc "Can we go in? [bet] is going to smash her nose against the glass..."
    mc "Können wir reingehen? [bet] wird sich noch die Nase am Glas plattdrücken..."

# game/scripts/c31/c31.rpy:3216
translate german c31s006_baseArrival_5bc34429:

    # ama "Not in street clothes. We have to wear protective suits and go through a decontamination process first."
    ama "Nicht in Straßenkleidung. Wir müssen Schutzanzüge tragen und zuerst einen Dekontaminationsprozess durchlaufen."

# game/scripts/c31/c31.rpy:3223
translate german c31s006_baseArrival_714d05fb:

    # ama "You enter from the back. This door is only used when there's no cloning process underway and the room doesn't need to be sterile."
    ama "Man betritt ihn von hinten. Diese Tür wird nur benutzt, wenn kein Klonprozess im Gange ist und der Raum nicht steril sein muss."

# game/scripts/c31/c31.rpy:3217
translate german c31s006_baseArrival_19e1bb29:

    # mc "Makes sense."
    mc "Macht Sinn."

# game/scripts/c31/c31.rpy:3219
translate german c31s006_baseArrival_77840939:

    # bet "Some things take time to process. I think this is one of them."
    bet "Manche Dinge brauchen Zeit, um sie zu verarbeiten. Ich denke, das hier ist eines davon."

# game/scripts/c31/c31.rpy:3220
translate german c31s006_baseArrival_feaf16a6:

    # mc "How are you holding up? It's giving me the creeps."
    mc "Wie kommst du damit klar? Mir läuft es da eiskalt den Rücken runter."

# game/scripts/c31/c31.rpy:3221
translate german c31s006_baseArrival_7bccaec0:

    # bet "I'm going to focus on being useful. On doing what I know how to do."
    bet "Ich werde mich darauf konzentrieren, nützlich zu sein. Darauf, das zu tun, was ich kann."

# game/scripts/c31/c31.rpy:3226
translate german c31s006_baseArrival_c407e765:

    # bet "There are things that take time to digest. I think this room is one of them."
    bet "Es gibt Dinge, die Zeit brauchen, um sie zu verdauen. Ich glaube, dieser Raum gehört dazu."

# game/scripts/c31/c31.rpy:3229
translate german c31s006_baseArrival_801f91e4:

    # bet "I'm not going to judge what was done here previously. I'll judge if it doesn't stop."
    bet "Ich werde nicht darüber urteilen, was hier früher gemacht wurde. Ich werde urteilen, wenn es nicht aufhört."

# game/scripts/c31/c31.rpy:3224
translate german c31s006_baseArrival_5606b665:

    # ama "Medical facilities. Operating rooms, recovery, and consultation rooms."
    ama "Medizinische Einrichtungen. Operationssäle, Aufwach- und Sprechzimmer."

# game/scripts/c31/c31.rpy:3225
translate german c31s006_baseArrival_54346d53:

    # mc "Impressive. It's bigger than I expected."
    mc "Beeindruckend. Es ist größer, als ich erwartet habe."

# game/scripts/c31/c31.rpy:3227
translate german c31s006_baseArrival_cf26a2dc:

    # bet "I suppose a small hospital is needed in a place like this."
    bet "Ich nehme an, an einem Ort wie diesem braucht man ein kleines Krankenhaus."

# game/scripts/c31/c31.rpy:3228
translate german c31s006_baseArrival_ba9d6eb4:

    # bet "I imagine the injuries can be quite diverse, knowing what the company does."
    bet "Ich kann mir vorstellen, dass die Verletzungen ziemlich vielfältig sein können, wenn man weiß, was die Firma macht."

# game/scripts/c31/c31.rpy:3230
translate german c31s006_baseArrival_20b85ec0:

    # ama "Diverse is a very diplomatic word."
    ama "Vielfältig ist ein sehr diplomatisches Wort."

# game/scripts/c31/c31.rpy:3232
translate german c31s006_baseArrival_c15af9f7:

    # bet "I'm a doctor. Diplomacy is part of the job."
    bet "Ich bin Ärztin. Diplomatie gehört zum Job."

# game/scripts/c31/c31.rpy:3233
translate german c31s006_baseArrival_460bdb97:

    # mc "How many recovery beds are there?"
    mc "Wie viele Genesungsbetten gibt es hier?"

# game/scripts/c31/c31.rpy:3235
translate german c31s006_baseArrival_1f28ec2e:

    # ama "Twenty-four. Although we've had more occupancy than desirable."
    ama "Vierundzwanzig. Obwohl wir mehr Belegung hatten, als wünschenswert wäre."

# game/scripts/c31/c31.rpy:3236
translate german c31s006_baseArrival_716f5230:

    # mc "And right now?"
    mc "Und im Moment?"

# game/scripts/c31/c31.rpy:3238
translate german c31s006_baseArrival_93a1d949:

    # ama "Nine patients, from what I've read. Ranging from a flu to... [gav] and several wounded from the Clone War."
    ama "Neun Patienten, nach dem, was ich gelesen habe. Angefangen bei einer Grippe bis hin zu... [gav] und einigen Verwundeten aus dem Klonkrieg."

# game/scripts/c31/c31.rpy:3239
translate german c31s006_baseArrival_7c29365d:

    # mc "Is [gav] still here?"
    mc "Ist [gav] immer noch hier?"

# game/scripts/c31/c31.rpy:3241
translate german c31s006_baseArrival_d9d3c8b1:

    # bet "After talking to him, I thought it would be best if he stayed in a controlled environment."
    bet "Nachdem ich mit ihm gesprochen hatte, dachte ich, es wäre das Beste, wenn er in einer kontrollierten Umgebung bleibt."

# game/scripts/c31/c31.rpy:3242
translate german c31s006_baseArrival_2fd9fae1:

    # bet "He can leave his room and move around the base, but no more excursions to the beach for now."
    bet "Er kann sein Zimmer verlassen und sich auf der Basis bewegen, aber vorerst keine Ausflüge mehr zum Strand."

# game/scripts/c31/c31.rpy:3243
translate german c31s006_baseArrival_871edece:

    # mc "Is the arm thing going to work well?"
    mc "Wird die Sache mit dem Arm gut funktionieren?"

# game/scripts/c31/c31.rpy:3245
translate german c31s006_baseArrival_ac4a8c8b:

    # bet "It's going to work better than the original. That's no exaggeration, it's an engineering marvel."
    bet "Es wird besser funktionieren als das Original. Das ist keine Übertreibung, es ist ein technisches Wunderwerk."

# game/scripts/c31/c31.rpy:3246
translate german c31s006_baseArrival_918d07e8:

    # bet "I'm looking forward to seeing the real device. So far I've only seen photos and blueprints."
    bet "Ich freue mich darauf, das echte Gerät zu sehen. Bisher habe ich nur Fotos und Baupläne gesehen."

# game/scripts/c31/c31.rpy:3247
translate german c31s006_baseArrival_b1ec7853:

    # mc "When is the surgery?"
    mc "Wann ist die Operation?"

# game/scripts/c31/c31.rpy:3249
translate german c31s006_baseArrival_2a7468a5:

    # bet "On Sunday. If everything goes well, he'll be in physical therapy in two weeks."
    bet "Am Sonntag. Wenn alles gut geht, wird er in zwei Wochen in der Physiotherapie sein."

# game/scripts/c31/c31.rpy:3250
translate german c31s006_baseArrival_d88fdbbc:

    # mc "And does [gav] know how it's going to turn out?"
    mc "Und weiß [gav], wie es ausgehen wird?"

# game/scripts/c31/c31.rpy:3252
translate german c31s006_baseArrival_4f0709d4:

    # bet "I explained every step to him. He asked if he could go back to the field."
    bet "Ich habe ihm jeden Schritt erklärt. Er hat gefragt, ob er wieder in den Einsatz gehen kann."

# game/scripts/c31/c31.rpy:3253
translate german c31s006_baseArrival_5c602d0c:

    # mc "And?"
    mc "Und?"

# game/scripts/c31/c31.rpy:3254
translate german c31s006_baseArrival_ac93f27d:

    # bet "I told him probably yes. That the arm wasn't going to be his limit."
    bet "Ich habe ihm gesagt, wahrscheinlich ja. Dass der Arm nicht sein Limit sein wird."

# game/scripts/c31/c31.rpy:3255
translate german c31s006_baseArrival_457c1076:

    # mc "And how did he react?"
    mc "Und wie hat er reagiert?"

# game/scripts/c31/c31.rpy:3265
translate german c31s006_baseArrival_33cfb197:

    # ama "He must have been happy."
    ama "Er muss glücklich gewesen sein."

# game/scripts/c31/c31.rpy:3257
translate german c31s006_baseArrival_c759d1da:

    # bet "His face lit up. It was sweet."
    bet "Sein Gesicht leuchtete auf. Es war süß."

# game/scripts/c31/c31.rpy:3258
translate german c31s006_baseArrival_5e02bf30:

    # ama "You hadn't told me."
    ama "Das hast du mir nicht gesagt."

# game/scripts/c31/c31.rpy:3259
translate german c31s006_baseArrival_84c34bcb:

    # bet "Doctor-patient confidentiality..."
    bet "Ärztliche Schweigepflicht..."

# game/scripts/c31/c31.rpy:3260
translate german c31s006_baseArrival_0dd13cac:

    # mc "Thanks for doing this, really."
    ama "Danke, dass du das machst, wirklich."

# game/scripts/c31/c31.rpy:3261
translate german c31s006_baseArrival_323f3ee6:

    # bet "It's my job. But also... after talking to the kid... I care."
    bet "Es ist mein Job. Aber auch... nachdem ich mit dem Kind gesprochen habe... ist es mir wichtig."

# game/scripts/c31/c31.rpy:3263
translate german c31s006_baseArrival_391f88cf:

    # ama "We have to keep going. The hangar is waiting for us."
    ama "Wir müssen weiter. Der Hangar wartet auf uns."

# game/scripts/c31/c31.rpy:3264
translate german c31s006_baseArrival_46ba6c1e:

    # bet "I'm going to stay here. I have no interest in seeing weapons. Let's see if I can find someone to show me this in depth."
    bet "Ich bleibe hier. Ich habe kein Interesse daran, Waffen zu sehen. Mal sehen, ob ich jemanden finde, der mir das hier genauer zeigt."

# game/scripts/c31/c31.rpy:3265
translate german c31s006_baseArrival_aa2ffe0d:

    # ama "Will you know how to find the meeting room? We have one in forty minutes with the department heads."
    ama "Weißt du, wie du den Besprechungsraum findest? Wir haben in vierzig Minuten ein Meeting mit den Abteilungsleitern."

# game/scripts/c31/c31.rpy:3267
translate german c31s006_baseArrival_542718fc:

    # bet "I hadn't thought about that..."
    bet "Daran hatte ich nicht gedacht..."

# game/scripts/c31/c31.rpy:3268
translate german c31s006_baseArrival_b830a32c:

    # ama "Second door on the right from the elevator on the second floor."
    ama "Zweite Tür rechts vom Aufzug im zweiten Stock."

# game/scripts/c31/c31.rpy:3269
translate german c31s006_baseArrival_9eff3961:

    # bet "I'll find something resembling that and trust my intuition."
    bet "Ich werde etwas finden, das so aussieht, und auf meine Intuition vertrauen."

# game/scripts/c31/c31.rpy:3272
translate german c31s006_baseArrival_72521cef:

    # mc "How long have we been here? I don't want to be late for the meeting."
    mc "Wie lange sind wir schon hier? Ich will nicht zu spät zum Meeting kommen."

# game/scripts/c31/c31.rpy:3273
translate german c31s006_baseArrival_2bfccbf6:

    # ama "There are forty minutes left. We have some time."
    ama "Es bleiben noch vierzig Minuten. Wir haben etwas Zeit."

# game/scripts/c31/c31.rpy:3274
translate german c31s006_baseArrival_66b76905:

    # mc "What's in the hangar?"
    mc "Was ist im Hangar?"

# game/scripts/c31/c31.rpy:3275
translate german c31s006_baseArrival_c47cb59c:

    # ama "Operational vehicles. What we use on the training ground."
    ama "Einsatzfahrzeuge. Die, die wir auf dem Übungsgelände benutzen."

# game/scripts/c31/c31.rpy:3278
translate german c31s006_baseArrival_41701d6a:

    # ama "Main hangar. This is where we keep the vehicles in regular use."
    ama "Haupthangar. Hier bewahren wir die Fahrzeuge auf, die regelmäßig im Einsatz sind."

# game/scripts/c31/c31.rpy:3279
translate german c31s006_baseArrival_dd2ebd94:

    # mc "There are more than I thought."
    mc "Das sind mehr, als ich dachte."

# game/scripts/c31/c31.rpy:3280
translate german c31s006_baseArrival_bcc6af59:

    # ama "NTR operates in varied environments. We need versatility."
    ama "NTR operiert in unterschiedlichen Umgebungen. Wir brauchen Vielseitigkeit."

# game/scripts/c31/c31.rpy:3281
translate german c31s006_baseArrival_777b2cc3:

    # mc "Can you explain them to me?"
    mc "Kannst du sie mir erklären?"

# game/scripts/c31/c31.rpy:3283
translate german c31s006_baseArrival_14786c38:

    # ama "Light vehicles for recon and rapid deployment. Trucks for logistics and personnel."
    ama "Leichte Fahrzeuge für Aufklärung und schnelle Verlegung. LKWs für Logistik und Personal."

# game/scripts/c31/c31.rpy:3284
translate german c31s006_baseArrival_0a4a32b3:

    # ama "AFVs for areas with moderate resistance. And IFVs for direct combat operations."
    ama "AFVs für Gebiete mit moderatem Widerstand. Und IFVs für direkte Kampfeinsätze."

# game/scripts/c31/c31.rpy:3285
translate german c31s006_baseArrival_d4107052:

    # ama "Many of them are captures we've brought to the base so we can train with them and get to know different types of vehicles."
    ama "Viele davon sind Beutefahrzeuge, die wir zur Basis gebracht haben, damit wir mit ihnen trainieren und verschiedene Fahrzeugtypen kennenlernen können."

# game/scripts/c31/c31.rpy:3296
translate german c31s006_baseArrival_0ce93641:

    # "You follow her gestures with your eyes, trying to guess which vehicle corresponds to which acronym. You're only able to name the trucks."
    "Du folgst ihren Gesten mit den Augen und versuchst zu erraten, welches Fahrzeug zu welchem Akronym gehört. Du kannst nur die LKWs benennen."

# game/scripts/c31/c31.rpy:3286
translate german c31s006_baseArrival_18a46dcd:

    # mc "Are these the vehicles we rent out to other companies?"
    mc "Sind das die Fahrzeuge, die wir an andere Firmen vermieten?"

# game/scripts/c31/c31.rpy:3288
translate german c31s006_baseArrival_3a71b47d:

    # ama "Some of them. In most infiltration missions we don't use land vehicles, or they're provided for us at the destination."
    ama "Einige davon. Bei den meisten Infiltrationsmissionen benutzen wir keine Landfahrzeuge, oder sie werden uns am Zielort zur Verfügung gestellt."

# game/scripts/c31/c31.rpy:3289
translate german c31s006_baseArrival_734bc7f6:

    # ama "Most of them are used for training or transport."
    ama "Die meisten werden für Training oder Transport genutzt."

# game/scripts/c31/c31.rpy:3290
translate german c31s006_baseArrival_49346031:

    # mc "Wait. Is that a tank over there?"
    mc "Warte. Ist das da drüben ein Panzer?"

# game/scripts/c31/c31.rpy:3303
translate german c31s006_baseArrival_a17f9edc:

    # ama "That one?"
    ama "Der da?"

# game/scripts/c31/c31.rpy:3294
translate german c31s006_baseArrival_b5e6776f:

    # ama "No, that isn't a tank."
    ama "Nein, das ist kein Panzer."

# game/scripts/c31/c31.rpy:3295
translate german c31s006_baseArrival_27d7305e:

    # mc "It looks like a tank."
    mc "Er sieht aus wie ein Panzer."

# game/scripts/c31/c31.rpy:3296
translate german c31s006_baseArrival_f9bba86a:

    # ama "It has tracks, a turret, and a cannon. I get it. But it's not a tank."
    ama "Er hat Ketten, einen Turm und eine Kanone. Ich verstehe schon. Aber es ist kein Panzer."

# game/scripts/c31/c31.rpy:3308
translate german c31s006_baseArrival_535a70b6:

    # "She seems genuinely surprised that you don't know. To you, it still looks like a tank."
    "Sie scheint aufrichtig überrascht zu sein, dass du das nicht weißt. Für dich sieht es immer noch wie ein Panzer aus."

# game/scripts/c31/c31.rpy:4093
translate german c31s006_baseArrival_0b7ce2f7:

    # "She seems genuinely surprised that you don't know. It still looks like a tank to you."
    "Sie scheint aufrichtig überrascht zu sein, dass du das nicht weißt. Es sieht für dich immer noch wie ein Panzer aus."

# game/scripts/c31/c31.rpy:3297
translate german c31s006_baseArrival_65325c94:

    # mc "What is it then?"
    mc "Was ist es dann?"


# game/scripts/c31/c31.rpy:3298
translate german c31s006_baseArrival_3122cafb:

    # ama "An IFV. Infantry Fighting Vehicle. A Bradley, if you want the specific name."
    ama "Ein SPz. Schützenpanzer. Ein Bradley, wenn du den genauen Namen wissen willst."

# game/scripts/c31/c31.rpy:3299
translate german c31s006_baseArrival_9f66fff7:

    # ama "That one in particular came out of Lebanon a few years ago."
    ama "Der da im Speziellen kam vor ein paar Jahren aus dem Libanon."

# game/scripts/c31/c31.rpy:3300
translate german c31s006_baseArrival_2399641f:

    # mc "What's the difference between an IFV and a tank?"
    mc "Was ist der Unterschied zwischen einem SPz und einem Panzer?"

# game/scripts/c31/c31.rpy:3302
translate german c31s006_baseArrival_e8712b86:

    # ama "A tank is designed to destroy other armored vehicles and fortified positions."
    ama "Ein Panzer ist dafür ausgelegt, andere gepanzerte Fahrzeuge und befestigte Stellungen zu zerstören."

# game/scripts/c31/c31.rpy:3303
translate german c31s006_baseArrival_261cb618:

    # ama "The IFV carries infantry into combat and provides fire support. It's a different philosophy."
    ama "Der SPz bringt Infanterie in den Kampf und bietet Feuerunterstützung. Das ist eine andere Philosophie."

# game/scripts/c31/c31.rpy:3304
translate german c31s006_baseArrival_44e6c996:

    # mc "And NTR doesn't have tanks?"
    mc "Und NTR hat keine Panzer?"

# game/scripts/c31/c31.rpy:3306
translate german c31s006_baseArrival_fdb1c96e:

    # ama "No. We don't even need them."
    ama "Nein. Wir brauchen sie nicht einmal."

# game/scripts/c31/c31.rpy:3307
translate german c31s006_baseArrival_442d7fdf_1:

    # mc "Why not?"
    mc "Warum nicht?"

# game/scripts/c31/c31.rpy:3308
translate german c31s006_baseArrival_11187978:

    # ama "NTR doesn't do conventional warfare. We aren't an army. We do precision operations, espionage, extraction, elimination..."
    ama "NTR führt keine konventionelle Kriegsführung. Wir sind keine Armee. Wir machen Präzisionsoperationen, Spionage, Extraktionen, Eliminierungen..."

# game/scripts/c31/c31.rpy:3309
translate german c31s006_baseArrival_d4dcc286:

    # ama "A tank in that context is a huge logistical problem and a very visible signal."
    ama "Ein Panzer in diesem Kontext ist ein riesiges logistisches Problem und ein sehr sichtbares Signal."

# game/scripts/c31/c31.rpy:3310
translate german c31s006_baseArrival_ac15cdf7:

    # mc "We don't want visibility."
    mc "Wir wollen keine Sichtbarkeit."

# game/scripts/c31/c31.rpy:3312
translate german c31s006_baseArrival_58fb179c:

    # ama "Exactly. IFVs give us protection and firepower without announcing that we're coming."
    ama "Genau. Schützenpanzer geben uns Schutz und Feuerkraft, ohne gleich anzukündigen, dass wir im Anmarsch sind."

# game/scripts/c31/c31.rpy:3326
translate german c31s006_baseArrival_974c9428:

    # "Her smile tells you that you guessed right. She looks happy that you're starting to understand her world. A world that's going to be yours too."
    "Ihr Lächeln verrät dir, dass du richtig geraten hast. Sie sieht glücklich darüber aus, dass du anfängst, ihre Welt zu verstehen. Eine Welt, die auch deine sein wird."

# game/scripts/c31/c31.rpy:3313
translate german c31s006_baseArrival_d3b5cf1c:

    # ama "If one falls into our hands on a mission, we're trained to use it at a basic level, but it's not the norm."
    ama "Wenn uns auf einer Mission einer in die Hände fällt, sind wir darauf trainiert, ihn auf grundlegendem Niveau zu bedienen, aber das ist nicht die Norm."

# game/scripts/c31/c31.rpy:3314
translate german c31s006_baseArrival_67dcdea5:

    # mc "Makes sense."
    mc "Macht Sinn."

# game/scripts/c31/c31.rpy:3316
translate german c31s006_baseArrival_17a38d52:

    # ama "Besides, moving tanks, maintaining them, crewing them... requires infrastructure we don't have here."
    ama "Außerdem erfordert das Bewegen von Panzern, ihre Wartung, die Besatzung... eine Infrastruktur, die wir hier nicht haben."

# game/scripts/c31/c31.rpy:3317
translate german c31s006_baseArrival_ce77575f:

    # ama "And capturing a tank is much rarer, so we don't need that training."
    ama "Und einen Panzer zu erbeuten ist viel seltener, also brauchen wir dieses Training nicht."

# game/scripts/c31/c31.rpy:3318
translate german c31s006_baseArrival_f4f0bbbf:

    # mc "I see. How many IFVs do we have?"
    mc "Verstehe. Wie viele Schützenpanzer haben wir?"

# game/scripts/c31/c31.rpy:3320
translate german c31s006_baseArrival_62d67e93:

    # ama "Four operational ones of different models. A couple more are non-operational, but we also use them for training."
    ama "Vier einsatzbereite von verschiedenen Modellen. Ein paar weitere sind nicht einsatzbereit, aber die nutzen wir auch fürs Training."

# game/scripts/c31/c31.rpy:4120
translate german c31s006_baseArrival_092456e0:

    # ama "There are eight AFVs. They're like an IFV, but with wheels instead of tracks. In some places they're called the same thing."
    ama "Es gibt acht Radpanzer. Sie sind wie ein Schützenpanzer, aber mit Rädern statt Ketten. An manchen Orten werden sie gleich genannt."

# game/scripts/c31/c31.rpy:3321
translate german c31s006_baseArrival_4851b21c:

    # ama "There are eight AFVs. They're like an IFV but with wheels instead of tracks. In some places they're called the same thing."
    ama "Es gibt acht Radpanzer. Sie sind wie ein Schützenpanzer, aber mit Rädern statt Ketten. An manchen Orten werden sie gleich genannt."

# game/scripts/c31/c31.rpy:3322
translate german c31s006_baseArrival_c1661fd9:

    # mc "Does all of this fit in here?"
    mc "Passt das alles hier rein?"

# game/scripts/c31/c31.rpy:3324
translate german c31s006_baseArrival_314abfa6:

    # ama "This is the main hangar of the base. There's another one, even bigger, at the training facilities."
    ama "Das ist der Haupthangar der Basis. Es gibt noch einen, sogar noch größer, bei den Trainingseinrichtungen."

# game/scripts/c31/c31.rpy:3325
translate german c31s006_baseArrival_8f8a907a:

    # mc "What about the planes and helicopters?"
    mc "Was ist mit den Flugzeugen und Hubschraubern?"

# game/scripts/c31/c31.rpy:3326
translate german c31s006_baseArrival_a3430981:

    # ama "At the airport or the training facilities. They're a bit away from the base."
    ama "Am Flughafen oder bei den Trainingseinrichtungen. Sie sind ein Stück von der Basis entfernt."

# game/scripts/c31/c31.rpy:3327
translate german c31s006_baseArrival_73982012:

    # mc "How far are they?"
    mc "Wie weit sind sie weg?"

# game/scripts/c31/c31.rpy:3329
translate german c31s006_baseArrival_b637b71b:

    # ama "About three kilometers. Over there is the training ground, the weapons depots, the airstrip, the aircraft hangar, and the other vehicle hangar."
    ama "Etwa drei Kilometer. Dort drüben sind das Trainingsgelände, die Waffendepots, die Landebahn, der Flugzeughangar und der andere Fahrzeughangar."

# game/scripts/c31/c31.rpy:3330
translate german c31s006_baseArrival_c438ab01:

    # mc "Why are they separate?"
    mc "Warum sind sie getrennt?"

# game/scripts/c31/c31.rpy:3331
translate german c31s006_baseArrival_d531339f:

    # ama "Security and logistics. If something fails at one point, it doesn't compromise the other."
    ama "Sicherheit und Logistik. Wenn an einem Punkt etwas schiefgeht, gefährdet das nicht den anderen."

# game/scripts/c31/c31.rpy:3332
translate german c31s006_baseArrival_fb8daad5:

    # mc "Will we see it today?"
    mc "Werden wir das heute sehen?"

# game/scripts/c31/c31.rpy:3334
translate german c31s006_baseArrival_60167086:

    # ama "We don't have time before the meeting. I'll schedule it for tomorrow if you want."
    ama "Wir haben vor dem Meeting keine Zeit. Ich plane es für morgen ein, wenn du willst."

# game/scripts/c31/c31.rpy:3335
translate german c31s006_baseArrival_c9243ff0:

    # mc "Yes. I want to see everything."
    mc "Ja. Ich will alles sehen."

# game/scripts/c31/c31.rpy:3336
translate german c31s006_baseArrival_3d9906cf:

    # ama "I figured."
    ama "Dachte ich mir."

# game/scripts/c31/c31.rpy:3338
translate german c31s006_baseArrival_27f0abd1:

    # mc "Hey."
    mc "Hey."

# game/scripts/c31/c31.rpy:3339
translate german c31s006_baseArrival_45b012e8:

    # ama "Yeah?"
    ama "Ja?"

# game/scripts/c31/c31.rpy:3340
translate german c31s006_baseArrival_29e72cc7:

    # mc "This is really big."
    mc "Das ist wirklich groß."

# game/scripts/c31/c31.rpy:3341
translate german c31s006_baseArrival_af45e037_1:

    # ama "I know."
    ama "Ich weiß."

# game/scripts/c31/c31.rpy:3342
translate german c31s006_baseArrival_e39094cc:

    # mc "I don't mean it in a logistical sense, nor am I referring to the base. I mean it in the sense of... it's a lot of responsibility."
    mc "Ich meine das nicht im logistischen Sinne, und ich beziehe mich auch nicht auf die Basis. Ich meine es in dem Sinne, dass... es eine Menge Verantwortung ist."

# game/scripts/c31/c31.rpy:3343
translate german c31s006_baseArrival_c1fc5fcc:

    # mc "While we were at home everything was very abstract. Now I'm seeing that it's... real."
    mc "Als wir zu Hause waren, war alles sehr abstrakt. Jetzt sehe ich, dass es... real ist."

# game/scripts/c31/c31.rpy:3345
translate german c31s006_baseArrival_8f0140e6:

    # ama "I know that too."
    ama "Das weiß ich auch."

# game/scripts/c31/c31.rpy:3346
translate german c31s006_baseArrival_2437b094:

    # mc "And you think I can handle this?"
    mc "Und du glaubst, ich schaffe das?"

# game/scripts/c31/c31.rpy:3347
translate german c31s006_baseArrival_4f80d06f:

    # ama "I wouldn't have supported you if I didn't believe it."
    ama "Ich hätte dich nicht unterstützt, wenn ich nicht daran geglaubt hätte."

# game/scripts/c31/c31.rpy:3348
translate german c31s006_baseArrival_b2ff6979:

    # mc "That doesn't exactly answer my question."
    mc "Das beantwortet nicht gerade meine Frage."

# game/scripts/c31/c31.rpy:3350
translate german c31s006_baseArrival_64b655c1:

    # ama "*Laugh* Yes it does. You just have to listen carefully to the answer."
    ama "*Lacht* Doch, tut es. Du musst dir die Antwort nur genau anhören."

# game/scripts/c31/c31.rpy:3351
translate german c31s006_baseArrival_63fd57b4:

    # mc "You're very direct when you want to be."
    mc "Du bist sehr direkt, wenn du es sein willst."

# game/scripts/c31/c31.rpy:3352
translate german c31s006_baseArrival_18975b19:

    # ama "*Laugh* I'm always direct. The thing is, this place..."
    ama "*Lacht* Ich bin immer direkt. Die Sache ist, dieser Ort..."

# game/scripts/c31/c31.rpy:3353
translate german c31s006_baseArrival_51492c4a:

    # mc "Is coming back getting to you?"
    mc "Macht es dir zu schaffen, wieder hier zu sein?"

# game/scripts/c31/c31.rpy:3355
translate german c31s006_baseArrival_ca001451:

    # ama "A little. This company needed a real change, not a cosmetic one."
    ama "Ein bisschen. Diese Firma brauchte eine echte Veränderung, keine kosmetische."

# game/scripts/c31/c31.rpy:3356
translate german c31s006_baseArrival_7bf6aaa2:

    # ama "What you've planned for today, the meeting in a little while..."
    ama "Was du für heute geplant hast, das Meeting in Kürze..."

# game/scripts/c31/c31.rpy:3357
translate german c31s006_baseArrival_445ce296:

    # ama "That's not what the previous CEO did. Not at all."
    ama "Das ist nicht das, was der vorherige CEO getan hat. Ganz und gar nicht."

# game/scripts/c31/c31.rpy:3358
translate german c31s006_baseArrival_cfcb856a:

    # mc "The bar wasn't very high."
    mc "Die Messlatte lag auch nicht sehr hoch."

# game/scripts/c31/c31.rpy:3360
translate german c31s006_baseArrival_6517222d:

    # ama "No. But you raised it anyway. That matters. And you haven't even started working yet..."
    ama "Nein. Aber du hast sie trotzdem höher gelegt. Das zählt. Und du hast noch nicht einmal angefangen zu arbeiten..."

# game/scripts/c31/c31.rpy:3361
translate german c31s006_baseArrival_872828eb:

    # mc "Thanks, Amanda."
    mc "Danke, Amanda."

# game/scripts/c31/c31.rpy:3362
translate german c31s006_baseArrival_3330b244:

    # ama "Don't thank me yet. There's a lot of work left."
    ama "Bedank dich noch nicht. Es gibt noch viel zu tun."

# game/scripts/c31/c31.rpy:3363
translate german c31s006_baseArrival_50d8828a:

    # mc "I know."
    mc "Ich weiß."

# game/scripts/c31/c31.rpy:3365
translate german c31s006_baseArrival_93634100:

    # ama "We have twenty minutes left before the meeting. Do you have any questions before we go in?"
    ama "Wir haben noch zwanzig Minuten bis zum Meeting. Hast du noch Fragen, bevor wir reingehen?"

# game/scripts/c31/c31.rpy:3366
translate german c31s006_baseArrival_46661b66:

    # mc "Several. But they can wait."
    mc "Einige. Aber die können warten."

# game/scripts/c31/c31.rpy:3367
translate german c31s006_baseArrival_868eb3a1:

    # ama "Good. Oh, and one more thing."
    ama "Gut. Oh, und noch etwas."

# game/scripts/c31/c31.rpy:3368
translate german c31s006_baseArrival_a3db9a7f:

    # mc "What?"
    mc "Was?"

# game/scripts/c31/c31.rpy:3370
translate german c31s006_baseArrival_827244e5:

    # ama "If they ask something you don't know how to answer, don't pretend you do."
    ama "Wenn sie etwas fragen, worauf du keine Antwort weißt, tu nicht so, als ob."

# game/scripts/c31/c31.rpy:3385
translate german c31s006_baseArrival_6197c694:

    # "It seems the conversation about the not-tank right behind her has opened her eyes to the fact that you're a rookie at this."
    "Es scheint, als hätte ihr das Gespräch über den Nicht-Panzer direkt hinter ihr die Augen dafür geöffnet, dass du ein Anfänger darin bist."

# game/scripts/c31/c31.rpy:3371
translate german c31s006_baseArrival_aa3d4492:

    # mc "Does that happen a lot in these meetings?"
    mc "Passiert das oft in diesen Meetings?"

# game/scripts/c31/c31.rpy:3372
translate german c31s006_baseArrival_abe99241:

    # ama "With the department heads, always."
    ama "Bei den Abteilungsleitern, immer."

# game/scripts/c31/c31.rpy:3373
translate german c31s006_baseArrival_54ae708d:

    # mc "Advice noted."
    mc "Ratschlag zur Kenntnis genommen."

# game/scripts/c31/c31.rpy:3375
translate german c31s006_baseArrival_e9d0c3cc:

    # ama "They're good at what they do, but they haven't had to answer to anyone for years."
    ama "Sie sind gut in dem, was sie tun, aber sie mussten sich seit Jahren vor niemandem mehr verantworten."

# game/scripts/c31/c31.rpy:3376
translate german c31s006_baseArrival_dc214e2a:

    # mc "Is that a warning?"
    mc "Ist das eine Warnung?"

# game/scripts/c31/c31.rpy:3377
translate german c31s006_baseArrival_a65f3029:

    # ama "It's context. The warning is that some of them will try to confuse you with technicalities."
    ama "Es ist der Kontext. Die Warnung ist, dass einige von ihnen versuchen werden, dich mit technischen Details zu verwirren."

# game/scripts/c31/c31.rpy:3378
translate german c31s006_baseArrival_520db1fc:

    # mc "And what do I do?"
    mc "Und was soll ich tun?"

# game/scripts/c31/c31.rpy:3380
translate german c31s006_baseArrival_64550313:

    # ama "Listen. Ask questions. And don't sign anything you don't understand."
    ama "Zuhören. Fragen stellen. Und unterschreibe nichts, was du nicht verstehst."

# game/scripts/c31/c31.rpy:3381
translate german c31s006_baseArrival_daf55b5f:

    # mc "Has that happened before?"
    mc "Ist das schon mal passiert?"

# game/scripts/c31/c31.rpy:3382
translate german c31s006_baseArrival_b2952f57:

    # ama "With Daniels, yes. Several times. He let them do as they pleased as long as they met the objectives."
    ama "Bei Daniels, ja. Mehrmals. Er hat sie machen lassen, was sie wollten, solange sie die Ziele erreicht haben."

# game/scripts/c31/c31.rpy:3383
translate german c31s006_baseArrival_6ba3cf84:

    # mc "And how did that end?"
    mc "Und wie hat das geendet?"

# game/scripts/c31/c31.rpy:3385
translate german c31s006_baseArrival_d3b0eca8:

    # ama "You know how it ended. Badly. That's why I'm telling you now."
    ama "Du weißt, wie es geendet hat. Schlecht. Deshalb sage ich es dir jetzt."

# game/scripts/c31/c31.rpy:3386
translate german c31s006_baseArrival_035146fc:

    # mc "Are you going to be in the meeting?"
    mc "Wirst du bei dem Meeting dabei sein?"

# game/scripts/c31/c31.rpy:3387
translate german c31s006_baseArrival_0051c6a3:

    # ama "By your side. The whole time. I'm not going to leave you alone among the sharks."
    ama "An deiner Seite. Die ganze Zeit. Ich werde dich nicht allein unter den Haien lassen."

# game/scripts/c31/c31.rpy:3388
translate german c31s006_baseArrival_9a2a7c2b:

    # mc "Good."
    mc "Gut."

# game/scripts/c31/c31.rpy:3391
translate german c31s006_baseArrival_b5ecfb44:

    # "At the door of the meeting room, a few minutes later..."
    "An der Tür des Besprechungsraums, ein paar Minuten später..."

# game/scripts/c31/c31.rpy:3392
translate german c31s006_baseArrival_e7c0540e:

    # ama "Anything else before we go in?"
    ama "Noch etwas, bevor wir reingehen?"

# game/scripts/c31/c31.rpy:3393
translate german c31s006_baseArrival_5956fca8:

    # mc "Yeah. One thing."
    mc "Ja. Eine Sache."

# game/scripts/c31/c31.rpy:3394
translate german c31s006_baseArrival_ebe0f4ba:

    # ama "Tell me."
    ama "Sag schon."

# game/scripts/c31/c31.rpy:3395
translate german c31s006_baseArrival_8d0e1a50:

    # mc "I want to meet with the clones. With the operatives."
    mc "Ich möchte mich mit den Klonen treffen. Mit den Agenten."

# game/scripts/c31/c31.rpy:3397
translate german c31s006_baseArrival_63f13e2e:

    # ama "When? Today?"
    ama "Wann? Heute?"

# game/scripts/c31/c31.rpy:3398
translate german c31s006_baseArrival_9c149142:

    # mc "After the department heads meeting. If possible."
    mc "Nach dem Treffen der Abteilungsleiter. Wenn möglich."

# game/scripts/c31/c31.rpy:3400
translate german c31s006_baseArrival_5c8cd1b7:

    # ama "[aar] told me they've formed a committee. To talk to you in an organized manner."
    ama "[aar] hat mir gesagt, dass sie ein Komitee gebildet haben. Um auf organisierte Weise mit dir zu sprechen."

# game/scripts/c31/c31.rpy:3401
translate german c31s006_baseArrival_185554ac:

    # mc "Perfect. That's exactly what I want."
    mc "Perfekt. Das ist genau das, was ich will."

# game/scripts/c31/c31.rpy:3402
translate german c31s006_baseArrival_0b2f1aca:

    # ama "When do you suggest?"
    ama "Wann schlägst du vor?"

# game/scripts/c31/c31.rpy:3403
translate german c31s006_baseArrival_06d1e40e:

    # mc "An hour after we finish with the department heads. Is that doable?"
    mc "Eine Stunde nachdem wir mit den Abteilungsleitern fertig sind. Ist das machbar?"

# game/scripts/c31/c31.rpy:3419
translate german c31s006_baseArrival_c39437dd:

    # mc "I need to talk to [car] and IT Support. I can meet with the clones in between."
    mc "Ich muss mit [car] und dem IT-Support sprechen. Dazwischen kann ich mich mit den Klonen treffen."

# game/scripts/c31/c31.rpy:3405
translate german c31s006_baseArrival_30108ff2:

    # ama "I can set that up. Give me a second to let them know so they can be ready in a couple of hours."
    ama "Ich kann das arrangieren. Gib mir eine Sekunde, um ihnen Bescheid zu sagen, damit sie in ein paar Stunden bereit sind."

# game/scripts/c31/c31.rpy:3406
translate german c31s006_baseArrival_eca8e830:

    # mc "Good. I don't want it to seem like an imposition. I want them to know I'm the one asking."
    mc "Gut. Ich will nicht, dass es wie eine Zumutung wirkt. Ich möchte, dass sie wissen, dass ich derjenige bin, der fragt."

# game/scripts/c31/c31.rpy:3407
translate german c31s006_baseArrival_a647bd2d:

    # ama "I'll let them know."
    ama "Ich werde es ihnen sagen."

# game/scripts/c31/c31.rpy:3408
translate german c31s006_baseArrival_b2516466:

    # mc "Thanks."
    mc "Danke."

# game/scripts/c31/c31.rpy:3410
translate german c31s006_baseArrival_df4ae749:

    # ama "Do you know what you're going to say to them?"
    ama "Weißt du schon, was du zu ihnen sagen wirst?"

# game/scripts/c31/c31.rpy:3411
translate german c31s006_baseArrival_7bcfe1d1:

    # mc "Not yet. But I know I'm going to listen to them."
    mc "Noch nicht. Aber ich weiß, dass ich ihnen zuhören werde."

# game/scripts/c31/c31.rpy:3412
translate german c31s006_baseArrival_3a6c3597:

    # ama "That's enough to start with."
    ama "Das reicht für den Anfang."

# game/scripts/c31/c31.rpy:3413
translate german c31s006_baseArrival_31fd88d8:

    # mc "Do you think they'll trust me?"
    mc "Glaubst du, sie werden mir vertrauen?"

# game/scripts/c31/c31.rpy:3415
translate german c31s006_baseArrival_0969eb05:

    # ama "Some of them will. Others will need time. It's normal."
    ama "Einige von ihnen schon. Andere werden Zeit brauchen. Das ist normal."

# game/scripts/c31/c31.rpy:3416
translate german c31s006_baseArrival_e703eb26:

    # mc "And do you trust me?"
    mc "Und vertraust du mir?"

# game/scripts/c31/c31.rpy:3417
translate german c31s006_baseArrival_d3a517c8:

    # ama "I've told you before. There's no one I trust more than you when it comes to this."
    ama "Ich habe es dir schon mal gesagt. Es gibt niemanden, dem ich in dieser Sache mehr vertraue als dir."


# game/scripts/c31/c31.rpy:3418
translate german c31s006_baseArrival_a223bcfb:

    # mc "I know, but I like hearing it."
    mc "Ich weiß, aber ich höre es gerne."

# game/scripts/c31/c31.rpy:3420
translate german c31s006_baseArrival_0a05c01e:

    # ama "*Laugh* I'm not going to repeat it again or it'll end up going to your head."
    ama "*Lacht* Ich werde es nicht noch einmal wiederholen, sonst steigt es dir noch zu Kopf."

# game/scripts/c31/c31.rpy:3421
translate german c31s006_baseArrival_c03e6302:

    # mc "*Laugh* Alright. I had to try."
    mc "*Lacht* In Ordnung. Ich musste es versuchen."

# game/scripts/c31/c31.rpy:3422
translate german c31s006_baseArrival_3673040a:

    # ama "Come on. The meeting awaits us."
    ama "Komm schon. Das Meeting erwartet uns."

# game/scripts/c31/c31.rpy:3423
translate german c31s006_baseArrival_63cd8ebd:

    # mc "Let's go."
    mc "Lass uns gehen."

# game/scripts/c31/c31.rpy:3424
translate german c31s006_baseArrival_de79a378:

    # "[ama] sends a couple of text messages before going in."
    "[ama] verschickt ein paar Textnachrichten, bevor sie hineingeht."

# game/scripts/c31/c31.rpy:3425
translate german c31s006_baseArrival_1d1dfe8b:

    # "A chill runs down your spine."
    "Ein Schauer läuft dir über den Rücken."

# game/scripts/c31/c31.rpy:2869
translate german c31s006_departmentMeeting_23940c53:

    # "Upon entering the room, everyone sits down quickly. [gav]'s future arm looks impressive."
    "Beim Betreten des Raumes setzen sich alle schnell hin. [gav]s zukünftiger Arm sieht beeindruckend aus."

# game/scripts/c31/c31.rpy:2870
translate german c31s006_departmentMeeting_13f81308:

    # "You have to hold yourself back from going over to look at it in detail. It looks like something out of a sci-fi movie."
    "Du musst dich zurückhalten, nicht hinzugehen, um ihn dir im Detail anzusehen. Er sieht aus wie aus einem Sci-Fi-Film."

# game/scripts/c31/c31.rpy:2871
translate german c31s006_departmentMeeting_824948ce:

    # "You realize you're going to hate this room as soon as you walk in. It's dark and oppressive. Right in line with the company's image."
    "Du merkst, dass du diesen Raum hassen wirst, sobald du ihn betrittst. Er ist dunkel und bedrückend. Genau passend zum Image der Firma."

# game/scripts/c31/c31.rpy:2873
translate german c31s006_departmentMeeting_b5425eca:

    # "[aar] makes the introductions. Nobody stands up to shake your hand."
    "[aar] übernimmt die Vorstellungsrunde. Niemand steht auf, um dir die Hand zu geben."

# game/scripts/c31/c31.rpy:2874
translate german c31s006_departmentMeeting_68e75baa:

    # aar "[flo], Head of the Commercial Department."
    aar "[flo], Leiter der kaufmännischen Abteilung."

# game/scripts/c31/c31.rpy:2876
translate german c31s006_departmentMeeting_f7532d1f:

    # aar "[vin], Head of the Financial Department."
    aar "[vin], Leiter der Finanzabteilung."

# game/scripts/c31/c31.rpy:2878
translate german c31s006_departmentMeeting_3f0b9abf:

    # aar "[mael], Head of the Cloning and Medicine Department."
    aar "[mael], Leiter der Abteilung für Klonen und Medizin."

# game/scripts/c31/c31.rpy:2880
translate german c31s006_departmentMeeting_54f4ccaf:

    # aar "[cal], Cloning and Medicine Department."
    aar "[cal], Abteilung für Klonen und Medizin."

# game/scripts/c31/c31.rpy:2881
translate german c31s006_departmentMeeting_a694a0a1:

    # "You notice the absence of the title 'Head' when naming [cal]. He's the designer of the arm."
    "Du bemerkst das Fehlen des Titels 'Leiter' bei der Nennung von [cal]. Er ist der Konstrukteur des Arms."

# game/scripts/c31/c31.rpy:2883
translate german c31s006_departmentMeeting_4412ee22:

    # mc "Good. Thank you all for coming."
    mc "Gut. Danke, dass Sie alle gekommen sind."

# game/scripts/c31/c31.rpy:2885
translate german c31s006_departmentMeeting_6c0fdd61:

    # "You point to the electromechanical arm before continuing. You would have liked to examine it closely before starting the meeting."
    "Du zeigst auf den elektromechanischen Arm, bevor du fortfährst. Du hättest ihn gerne genauer untersucht, bevor du das Meeting beginnst."

# game/scripts/c31/c31.rpy:2886
translate german c31s006_departmentMeeting_e86b371d:

    # "Everyone looks at it, following the direction your hand is pointing."
    "Alle schauen ihn an und folgen der Richtung, in die deine Hand zeigt."

# game/scripts/c31/c31.rpy:2887
translate german c31s006_departmentMeeting_36cd575a:

    # mc "I know it's not the most conventional way to start a management meeting, but I wanted it here."
    mc "Ich weiß, es ist nicht die konventionellste Art, ein Management-Meeting zu beginnen, aber ich wollte ihn hier haben."

# game/scripts/c31/c31.rpy:2888
translate german c31s006_departmentMeeting_ad70f504:

    # mc "To remind myself, and to remind you, of what we're capable of when we look in the right direction."
    mc "Um mich selbst und um Sie daran zu erinnern, wozu wir fähig sind, wenn wir in die richtige Richtung schauen."

# game/scripts/c31/c31.rpy:2890
translate german c31s006_departmentMeeting_d321dd09:

    # mc "Before getting down to business, I'd like each of you to give me a summary of your area."
    mc "Bevor wir zur Sache kommen, möchte ich, dass jeder von Ihnen mir eine Zusammenfassung seines Bereichs gibt."

# game/scripts/c31/c31.rpy:2891
translate german c31s006_departmentMeeting_aa402515:

    # mc "What state is the company in? No sugarcoating. Let's start with you, [aar]."
    mc "In welchem Zustand befindet sich die Firma? Nichts beschönigen. Fangen wir mit dir an, [aar]."

# game/scripts/c31/c31.rpy:2893
translate german c31s006_departmentMeeting_233b51bd:

    # aar "Alright. The Operations Area is active and running at full capacity."
    aar "In Ordnung. Der Operationsbereich ist aktiv und läuft auf Hochtouren."

# game/scripts/c31/c31.rpy:2894
translate german c31s006_departmentMeeting_560d333d:

    # aar "We have signed commitments with several clients for the next two quarters: Colombia, the United States, the United Kingdom, and France."
    aar "Wir haben unterzeichnete Verpflichtungen mit mehreren Kunden für die nächsten zwei Quartale: Kolumbien, die USA, das Vereinigte Königreich und Frankreich."

# game/scripts/c31/c31.rpy:2895
translate german c31s006_departmentMeeting_2ff5a840:

    # aar "In total, there are seven contracts of varying scope, all in the execution or advanced preparation phase."
    aar "Insgesamt gibt es sieben Verträge unterschiedlichen Umfangs, die sich alle in der Ausführungs- oder fortgeschrittenen Vorbereitungsphase befinden."

# game/scripts/c31/c31.rpy:2896
translate german c31s006_departmentMeeting_70600eb1:

    # aar "The field teams are operational. There are no serious casualties at the moment, except for [gav]'s case, which you already know about."
    aar "Die Einsatzteams sind einsatzbereit. Es gibt im Moment keine ernsthaften Ausfälle, abgesehen von [gav]s Fall, von dem du bereits weißt."

# game/scripts/c31/c31.rpy:2898
translate german c31s006_departmentMeeting_96b7f82a:

    # aar "Apart from that, we have several support contracts with other PMCs. Iron Fist and Walküre are our main clients in that area."
    aar "Abgesehen davon haben wir mehrere Support-Verträge mit anderen PMCs. Iron Fist und Walküre sind unsere Hauptkunden in diesem Bereich."

# game/scripts/c31/c31.rpy:2899
translate german c31s006_departmentMeeting_0ba968c5:

    # aar "Atlas and Chimera are clients with smaller, but more continuous contracts. I sent you a detailed list of the rest of the clients."
    aar "Atlas und Chimera sind Kunden mit kleineren, aber kontinuierlicheren Verträgen. Ich habe dir eine detaillierte Liste der restlichen Kunden geschickt."

# game/scripts/c31/c31.rpy:2900
translate german c31s006_departmentMeeting_920a77d8:

    # mc "I know. I saw it. And I saw that it included clients we haven't worked with in ten years."
    mc "Ich weiß. Ich habe sie gesehen. Und ich habe gesehen, dass sie Kunden enthält, mit denen wir seit zehn Jahren nicht mehr zusammengearbeitet haben."

# game/scripts/c31/c31.rpy:2902
translate german c31s006_departmentMeeting_e085fbfc:

    # "[aar] turns a deaf ear to your veiled criticism before continuing."
    "[aar] überhört deine verschleierte Kritik geflissentlich, bevor er fortfährt."

# game/scripts/c31/c31.rpy:2903
translate german c31s006_departmentMeeting_646688bc:

    # aar "The problem is that all those contracts, both operations and support, have deadlines."
    aar "Das Problem ist, dass all diese Verträge, sowohl Operationen als auch Support, Fristen haben."

# game/scripts/c31/c31.rpy:2904
translate german c31s006_departmentMeeting_f55cc2c5:

    # aar "If we touch the operational structure, I need to know with enough time so we don't leave anyone stranded in the middle of a mission."
    aar "Wenn wir die operative Struktur antasten, muss ich das rechtzeitig wissen, damit wir niemanden mitten in einer Mission im Stich lassen."

# game/scripts/c31/c31.rpy:2905
translate german c31s006_departmentMeeting_962b4142:

    # mc "Understood."
    mc "Verstanden."

# game/scripts/c31/c31.rpy:2907
translate german c31s006_departmentMeeting_64d383ed:

    # mc "[flo], Commercial Department?"
    mc "[flo], Handelsabteilung?"

# game/scripts/c31/c31.rpy:2908
translate german c31s006_departmentMeeting_003a31f7:

    # flo "The outlook is interesting. We have open negotiations with the Colombian government for three medium-term covert operations."
    flo "Die Aussichten sind interessant. Wir führen offene Verhandlungen mit der kolumbianischen Regierung über drei mittelfristige verdeckte Operationen."

# game/scripts/c31/c31.rpy:2909
translate german c31s006_departmentMeeting_b4c7cb3e:

    # flo "With the United States, there are preliminary talks about six extra operations on top of the ones already contracted. Our contact with them is solid."
    flo "Mit den Vereinigten Staaten gibt es Vorgespräche über sechs zusätzliche Operationen zu den bereits vertraglich vereinbarten. Unser Kontakt zu ihnen ist solide."

# game/scripts/c31/c31.rpy:2910
translate german c31s006_departmentMeeting_d092d406:

    # flo "The UK and France each have one ongoing operation. I'm in negotiations with France to expand our area of operations to the Sahel."
    flo "Großbritannien und Frankreich haben jeweils eine laufende Operation. Ich stehe in Verhandlungen mit Frankreich, um unser Einsatzgebiet auf die Sahelzone auszuweiten."

# game/scripts/c31/c31.rpy:2911
translate german c31s006_departmentMeeting_a3167936:

    # flo "They're all high-paying, repeat clients."
    flo "Das sind alles gut zahlende Stammkunden."

# game/scripts/c31/c31.rpy:2913
translate german c31s006_departmentMeeting_d4bd0ba1:

    # flo "China and Israel have wanted to hire us on several occasions, but Richards never wanted to reach an agreement with them. They pay well."
    flo "China und Israel wollten uns schon bei mehreren Gelegenheiten anheuern, aber Richards wollte nie eine Einigung mit ihnen erzielen. Sie zahlen gut."

# game/scripts/c31/c31.rpy:2914
translate german c31s006_departmentMeeting_a75bc9e3:

    # flo "North Korea and Iran have reached out several times, but they were vetoed because it could cause us to lose contracts with other clients."
    flo "Nordkorea und der Iran haben sich mehrmals gemeldet, aber dagegen wurde ein Veto eingelegt, weil es dazu führen könnte, dass wir Verträge mit anderen Kunden verlieren."

# game/scripts/c31/c31.rpy:2916
translate german c31s006_departmentMeeting_128e5c09:

    # flo "That being said... and I know it might sound weird coming from me... I think there's a huge market waiting in the medical sector."
    flo "Davon abgesehen... und ich weiß, dass es aus meinem Mund vielleicht seltsam klingt... Ich glaube, im medizinischen Sektor wartet ein riesiger Markt auf uns."

# game/scripts/c31/c31.rpy:2917
translate german c31s006_departmentMeeting_5b9b1d71:

    # flo "High tech, hospital equipment, and consumer devices."
    flo "Hightech, Krankenhausausrüstung und Endverbrauchergeräte."

# game/scripts/c31/c31.rpy:2918
translate german c31s006_departmentMeeting_ee75ed15:

    # flo "If we pivot well, we could compete in a sector with very different margins and much less legal exposure."
    flo "Wenn wir uns gut umorientieren, könnten wir in einem Sektor mit ganz anderen Margen und viel geringerem rechtlichen Risiko konkurrieren."

# game/scripts/c31/c31.rpy:2919
translate german c31s006_departmentMeeting_f4046e66:

    # mc "That's exactly the direction I want us to think in. Thank you."
    mc "Das ist genau die Richtung, in die wir denken sollten. Danke."

# game/scripts/c31/c31.rpy:2921
translate german c31s006_departmentMeeting_6f9238d1:

    # mc "[vin], the numbers."
    mc "[vin], die Zahlen."

# game/scripts/c31/c31.rpy:2922
translate german c31s006_departmentMeeting_b7df0e0b:

    # vin "Yes, the numbers."
    vin "Ja, die Zahlen."

# game/scripts/c31/c31.rpy:2923
translate german c31s006_departmentMeeting_50a9e85e:

    # vin "Available funds: two hundred twelve million dollars. Monthly operating costs: twenty-six million."
    vin "Verfügbare Mittel: zweihundertzwölf Millionen Dollar. Monatliche Betriebskosten: sechsundzwanzig Millionen."

# game/scripts/c31/c31.rpy:2924
translate german c31s006_departmentMeeting_58c0faea:

    # vin "Which means that, without new income, we have a little over eight months before the situation gets... uncomfortable."
    vin "Was bedeutet, dass wir ohne neue Einnahmen etwas mehr als acht Monate haben, bevor die Situation... ungemütlich wird."

# game/scripts/c31/c31.rpy:2925
translate german c31s006_departmentMeeting_21c61ebd:

    # "He has one of those voices that makes continental drift seem fun to listen to."
    "Er hat eine dieser Stimmen, die selbst Kontinentaldrift spannend klingen lassen."

# game/scripts/c31/c31.rpy:2927
translate german c31s006_departmentMeeting_9665be25:

    # vin "However, in the next quarter we expect an influx of one hundred eighty-three million from operations already completed and pending collection."
    vin "Allerdings erwarten wir im nächsten Quartal einen Zufluss von einhundertdreiundachtzig Millionen aus bereits abgeschlossenen und noch ausstehenden Operationen."

# game/scripts/c31/c31.rpy:2928
translate german c31s006_departmentMeeting_0536ab7d:

    # vin "So, in strictly financial terms, we're good."
    vin "Also, rein finanziell gesehen, stehen wir gut da."

# game/scripts/c31/c31.rpy:2929
translate german c31s006_departmentMeeting_94125296:

    # mc "Good good, or good for now?"
    mc "Gut gut, oder vorerst gut?"

# game/scripts/c31/c31.rpy:2931
translate german c31s006_departmentMeeting_c626803d:

    # vin "Good for now, as always in this industry. But good."
    vin "Vorerst gut, wie immer in dieser Branche. Aber gut."

# game/scripts/c31/c31.rpy:2932
translate german c31s006_departmentMeeting_da6f08cb:

    # vin "The previous CEO, Daniels... was of the opinion that the numbers always added up if you knew where to look."
    vin "Der vorherige CEO, Daniels... war der Meinung, dass die Zahlen immer aufgehen, wenn man weiß, wo man suchen muss."

# game/scripts/c31/c31.rpy:2933
translate german c31s006_departmentMeeting_46424ae7:

    # mc "Daniels is in prison for things like that, [vin]."
    mc "Daniels sitzt wegen solcher Sachen im Gefängnis, [vin]."

# game/scripts/c31/c31.rpy:2935
translate german c31s006_departmentMeeting_9ee1c93a:

    # vin "Yes. I know."
    vin "Ja. Ich weiß."

# game/scripts/c31/c31.rpy:2936
translate german c31s006_departmentMeeting_bf1b3875:

    # "He pauses briefly before continuing."
    "Er hält kurz inne, bevor er fortfährt."

# game/scripts/c31/c31.rpy:2937
translate german c31s006_departmentMeeting_b4dedfd0:

    # vin "It was just a comment on his accounting philosophy. Not on his other... hobbies."
    vin "Das war nur eine Bemerkung zu seiner Buchhaltungsphilosophie. Nicht zu seinen anderen... Hobbys."

# game/scripts/c31/c31.rpy:2938
translate german c31s006_departmentMeeting_1b3e3cc3:

    # "You just realized that he has ridiculously small hands."
    "Dir fällt gerade auf, dass er lächerlich kleine Hände hat."

# game/scripts/c31/c31.rpy:2939
translate german c31s006_departmentMeeting_e2f3bb15:

    # "It takes a bit of effort to hold back your laughter imagining him counting bills with those hands."
    "Es kostet dich etwas Mühe, dein Lachen zurückzuhalten, wenn du dir vorstellst, wie er mit diesen Händen Geldscheine zählt."

# game/scripts/c31/c31.rpy:2941
translate german c31s006_departmentMeeting_157c1ec8:

    # mc "[mael], your turn."
    mc "[mael], du bist dran."

# game/scripts/c31/c31.rpy:2942
translate german c31s006_departmentMeeting_43daf923:

    # "[mael]'s attitude makes you uncomfortable."
    "[mael]s Haltung bereitet dir Unbehagen."

# game/scripts/c31/c31.rpy:2943
translate german c31s006_departmentMeeting_7319db52:

    # "It's the attitude of someone who has spent years waiting to be asked this so they can say exactly the opposite of what people want to hear."
    "Es ist die Haltung von jemandem, der jahrelang darauf gewartet hat, danach gefragt zu werden, um genau das Gegenteil von dem zu sagen, was die Leute hören wollen."

# game/scripts/c31/c31.rpy:2944
translate german c31s006_departmentMeeting_9001b5f1:

    # mael "The cloning and genetics department is the real technological core of this company."
    mael "Die Klon- und Genetikabteilung ist der wahre technologische Kern dieser Firma."

# game/scripts/c31/c31.rpy:2945
translate german c31s006_departmentMeeting_9f573c51:

    # mael "Everything else, the operations, the contracts, even that arm you have there on the table..."
    mael "Alles andere, die Operationen, die Verträge, sogar dieser Arm, den du da auf dem Tisch hast..."

# game/scripts/c31/c31.rpy:2947
translate german c31s006_departmentMeeting_a17cf71d:

    # mael "All of that exists because we've spent over 20 years pushing the limits of what biology and science allow."
    mael "All das existiert, weil wir über 20 Jahre damit verbracht haben, die Grenzen dessen zu verschieben, was Biologie und Wissenschaft zulassen."

# game/scripts/c31/c31.rpy:2948
translate german c31s006_departmentMeeting_4d7e8f81:

    # mael "We currently have forty-two subjects in advanced stages of gestation. They will be born in the coming weeks."
    mael "Wir haben derzeit zweiundvierzig Subjekte in fortgeschrittenen Stadien der Gestation. Sie werden in den kommenden Wochen geboren."

# game/scripts/c31/c31.rpy:2950
translate german c31s006_departmentMeeting_f33b7a5f:

    # mael "They are viable human beings, and we'll have to decide what to do with them regardless of any strategic decision."
    mael "Sie sind lebensfähige menschliche Wesen, und wir müssen entscheiden, was wir mit ihnen machen, unabhängig von jeglichen strategischen Entscheidungen."

# game/scripts/c31/c31.rpy:2951
translate german c31s006_departmentMeeting_4c67d937:

    # mael "[aar] said you want to shut down the Cloning Department. I think that's a mistake."
    mael "[aar] sagte, du willst die Klonabteilung schließen. Ich denke, das ist ein Fehler."

# game/scripts/c31/c31.rpy:2952
translate german c31s006_departmentMeeting_80b136cb:

    # mc "Why? If we stop producing clones? What exactly do we lose?"
    mc "Warum? Wenn wir aufhören, Klone zu produzieren? Was genau verlieren wir?"

# game/scripts/c31/c31.rpy:2954
translate german c31s006_departmentMeeting_d8f998f2:

    # mael "We lose living knowledge. Cloning isn't just a product, it's a process."
    mael "Wir verlieren lebendiges Wissen. Klonen ist nicht nur ein Produkt, es ist ein Prozess."

# game/scripts/c31/c31.rpy:2955
translate german c31s006_departmentMeeting_3c382f8c:

    # mael "Every batch teaches us something new about gene expression, about cellular differentiation, about the limits of embryonic development."
    mael "Jede Charge lehrt uns etwas Neues über Genexpression, über Zelldifferenzierung, über die Grenzen der Embryonalentwicklung."

# game/scripts/c31/c31.rpy:2956
translate german c31s006_departmentMeeting_60d48f74:

    # mael "If we turn off the tap, in five years we'll have lost technical capacity that took us decades to build."
    mael "Wenn wir den Hahn zudrehen, werden wir in fünf Jahren technische Kapazitäten verloren haben, für deren Aufbau wir Jahrzehnte gebraucht haben."

# game/scripts/c31/c31.rpy:2957
translate german c31s006_departmentMeeting_073cda67:

    # mc "I understand the logic. But... I don't know..."
    mc "Ich verstehe die Logik. Aber... ich weiß nicht..."

# game/scripts/c31/c31.rpy:2958
translate german c31s006_departmentMeeting_aa20c7a3:

    # mc "Couldn't we maintain that knowledge by making... I don't know... animal clones or something? Cloning a loose pancreas for transplants?"
    mc "Könnten wir dieses Wissen nicht aufrechterhalten, indem wir... ich weiß nicht... Tierklone oder so etwas machen? Eine einzelne Bauchspeicheldrüse für Transplantationen klonen?"

# game/scripts/c31/c31.rpy:2959
translate german c31s006_departmentMeeting_b5345e3d:

    # "You feel a bit stupid. You should have studied alternatives for NTR's central department."
    "Du kommst dir ein bisschen dumm vor. Du hättest Alternativen für die zentrale Abteilung von NTR studieren sollen."

# game/scripts/c31/c31.rpy:2960
translate german c31s006_departmentMeeting_8f120e10:

    # "You feel like you're just talking without knowing what you are talking about. You finally understand how [emm] feels a lot of the time."
    "Du hast das Gefühl, dass du einfach nur redest, ohne zu wissen, wovon du eigentlich sprichst. Du verstehst endlich, wie [emm] sich oft fühlen muss."

# game/scripts/c31/c31.rpy:2962
translate german c31s006_departmentMeeting_a69e0430:

    # mael "A loose pancreas?"
    mael "Eine lose Bauchspeicheldrüse?"

# game/scripts/c31/c31.rpy:2963
translate german c31s006_departmentMeeting_53b10eb4:

    # mc "Or whatever. A kidney. I'm just improvising, I'm not a biologist or a geneticist."
    mc "Oder was auch immer. Eine Niere. Ich improvisiere nur, ich bin kein Biologe oder Genetiker."

# game/scripts/c31/c31.rpy:2964
translate german c31s006_departmentMeeting_f52d080e:

    # mael "No, yeah... I can see you're improvising."
    mael "Nein, ja... Ich sehe, dass du improvisierst."

# game/scripts/c31/c31.rpy:2965
translate german c31s006_departmentMeeting_84fa2f30:

    # "His tone seems to say that if he had a gun in his hands right now, he'd rather pull the trigger than have to deal with you."
    "Sein Tonfall scheint zu sagen, dass er, wenn er jetzt eine Waffe in der Hand hätte, lieber abdrücken würde, als sich mit dir abgeben zu müssen."

# game/scripts/c31/c31.rpy:2967
translate german c31s006_departmentMeeting_60ddea4a:

    # "[mael] takes a deep breath before continuing, as if gathering the patience to explain something basic to a child."
    "[mael] holt tief Luft, bevor er fortfährt, als würde er die Geduld aufbringen, einem Kind etwas Grundlegendes zu erklären."

# game/scripts/c31/c31.rpy:2968
translate german c31s006_departmentMeeting_4809f22b:

    # mael "Animals would be viable, yes."
    mael "Tiere wären machbar, ja."

# game/scripts/c31/c31.rpy:2969
translate german c31s006_departmentMeeting_146d7360:

    # mael "There wouldn't be any legal problems in Aruba, and from a technical standpoint, it would allow us to maintain the team's skills and keep researching."
    mael "Auf Aruba gäbe es keine rechtlichen Probleme, und aus technischer Sicht würde es uns ermöglichen, die Fähigkeiten des Teams zu erhalten und weiterzuforschen."

# game/scripts/c31/c31.rpy:2970
translate german c31s006_departmentMeeting_78660419:

    # mael "Pigs, primates, even endangered animals if we want to give it a positive public image angle."
    mael "Schweine, Primaten, sogar gefährdete Tiere, wenn wir dem Ganzen einen positiven PR-Aspekt verleihen wollen."

# game/scripts/c31/c31.rpy:2972
translate german c31s006_departmentMeeting_0398d4eb:

    # mael "Isolated human organs are a different story."
    mael "Isolierte menschliche Organe sind eine andere Geschichte."

# game/scripts/c31/c31.rpy:2973
translate german c31s006_departmentMeeting_7e196cab:

    # mael "It's technically possible, but there are huge obstacles: vascularization, immune rejection, maturation outside of a complete organism. It hasn't been solved."
    mael "Es ist technisch möglich, aber es gibt riesige Hindernisse: Vaskularisierung, Immunabstoßung, Reifung außerhalb eines vollständigen Organismus. Das ist noch nicht gelöst."

# game/scripts/c31/c31.rpy:2974
translate german c31s006_departmentMeeting_e9a74422:

    # mael "It would be a research project, not a short-term product."
    mael "Es wäre ein Forschungsprojekt, kein kurzfristiges Produkt."

# game/scripts/c31/c31.rpy:2975
translate german c31s006_departmentMeeting_8941e2bd:

    # mc "But is it worth a try?"
    mc "Aber ist es einen Versuch wert?"

# game/scripts/c31/c31.rpy:2977
translate german c31s006_departmentMeeting_fc69572f:

    # mael "I need to study it in more detail before giving you an honest answer."
    mael "Ich muss es genauer studieren, bevor ich dir eine ehrliche Antwort geben kann."

# game/scripts/c31/c31.rpy:2978
translate german c31s006_departmentMeeting_89babaaa:

    # mael "What I can tell you is that the idea of keeping the department open with that direction... doesn't displease me. In fact, I like it."
    mael "Was ich dir sagen kann, ist, dass mir die Idee, die Abteilung mit dieser Ausrichtung offen zu halten... nicht missfällt. Tatsächlich gefällt sie mir."

# game/scripts/c31/c31.rpy:2979
translate german c31s006_departmentMeeting_cf1ffbc6:

    # "A slight feeling of surprise runs across the table. It seems no one expected [mael] to accept the change so easily."
    "Ein leichtes Gefühl der Überraschung geht durch die Runde. Es scheint, als hätte niemand erwartet, dass [mael] die Änderung so leicht akzeptiert."

# game/scripts/c31/c31.rpy:2981
translate german c31s006_departmentMeeting_af97d9fc:

    # mael "Most of the medical products that have come out of my department have been happy accidents."
    mael "Die meisten medizinischen Produkte, die aus meiner Abteilung hervorgegangen sind, waren glückliche Zufälle."

# game/scripts/c31/c31.rpy:2982
translate german c31s006_departmentMeeting_b4a35668:

    # mael "Side effects of research where we were heading in another direction. Do you know how our rapid pregnancy test came about?"
    mael "Nebenwirkungen von Forschungen, bei denen wir in eine andere Richtung unterwegs waren. Weißt du, wie unser Schwangerschaftsschnelltest entstanden ist?"

# game/scripts/c31/c31.rpy:2984
translate german c31s006_departmentMeeting_762a101a:

    # flo "The one we'll start marketing in the European Union next month?"
    flo "Der, den wir nächsten Monat in der Europäischen Union auf den Markt bringen werden?"

# game/scripts/c31/c31.rpy:2985
translate german c31s006_departmentMeeting_b415f974:

    # mael "Yes, that exact one."
    mael "Ja, genau der."

# game/scripts/c31/c31.rpy:2987
translate german c31s006_departmentMeeting_fd64c5fa:

    # mael "Well, it came about because we were studying molecular markers in early-stage embryos and one of my researchers detected something weird."
    mael "Nun, er entstand, weil wir molekulare Marker in Embryonen im Frühstadium untersuchten und einer meiner Forscher etwas Seltsames entdeckte."

# game/scripts/c31/c31.rpy:2988
translate german c31s006_departmentMeeting_1b694428:

    # mael "There was a molecule that the body produces long before hCG levels, the traditional pregnancy hormone, are detectable."
    mael "Es gab ein Molekül, das der Körper produziert, lange bevor hCG-Werte, das traditionelle Schwangerschaftshormon, nachweisbar sind."

# game/scripts/c31/c31.rpy:2989
translate german c31s006_departmentMeeting_e53d55a4:

    # mael "We detect pregnancies several weeks earlier than any test on the market."
    mael "Wir erkennen Schwangerschaften mehrere Wochen früher als jeder Test auf dem Markt."

# game/scripts/c31/c31.rpy:2991
translate german c31s006_departmentMeeting_b0910916:

    # mael "Were we looking for that? No. We were looking for something completely different."
    mael "Haben wir danach gesucht? Nein. Wir haben nach etwas völlig anderem gesucht."

# game/scripts/c31/c31.rpy:2992
translate german c31s006_departmentMeeting_03400293:

    # mael "But that's how frontier research works. If you close the lab, you also close doors you don't even know are there."
    mael "Aber so funktioniert Spitzenforschung. Wenn man das Labor schließt, schließt man auch Türen, von denen man nicht einmal weiß, dass sie da sind."

# game/scripts/c31/c31.rpy:2993
translate german c31s006_departmentMeeting_43446e1d:

    # mael "The doors might not even exist, or what's behind them might not be worth it, but sometimes..."
    mael "Die Türen existieren vielleicht nicht einmal, oder was dahinter liegt, ist es vielleicht nicht wert, aber manchmal..."

# game/scripts/c31/c31.rpy:2994
translate german c31s006_departmentMeeting_b6967b68:

    # mc "I get it..."
    mc "Ich verstehe..."

# game/scripts/c31/c31.rpy:2996
translate german c31s006_departmentMeeting_8e10ced4:

    # "[bet], who until that moment had been looking at the arm with the concentration of someone taking a patient's pulse, looks up."
    "[bet], die bis zu diesem Moment den Arm mit der Konzentration von jemandem betrachtet hatte, der den Puls eines Patienten fühlt, sieht auf."

# game/scripts/c31/c31.rpy:2997
translate german c31s006_departmentMeeting_152c853e:

    # bet "Sorry to interrupt... how many of those forty-two subjects have genetic anomalies detected at this stage?"
    bet "Entschuldigen Sie die Unterbrechung... bei wie vielen dieser zweiundvierzig Probanden wurden in diesem Stadium genetische Anomalien festgestellt?"

# game/scripts/c31/c31.rpy:2998
translate german c31s006_departmentMeeting_aa92ca51:

    # mael "None. Our clones are perfect within the parameters. Nothing we haven't handled before."
    mael "Bei keinem. Unsere Klone sind innerhalb der Parameter perfekt. Nichts, womit wir nicht schon vorher umgegangen wären."

# game/scripts/c31/c31.rpy:2999
translate german c31s006_departmentMeeting_c502921a:

    # bet "And the protocol if there are complications during... birth?"
    bet "Und das Protokoll, falls es Komplikationen bei der... Geburt gibt?"

# game/scripts/c31/c31.rpy:3000
translate german c31s006_departmentMeeting_bed15091:

    # mael "We have an internal medical team specialized in that."
    mael "Wir haben ein internes medizinisches Team, das darauf spezialisiert ist."

# game/scripts/c31/c31.rpy:3001
translate german c31s006_departmentMeeting_dfc3ea70:

    # bet "Neonatologists?"
    bet "Neonatologen?"

# game/scripts/c31/c31.rpy:3002
translate german c31s006_departmentMeeting_4ff43295:

    # mael "Hired externally when necessary."
    mael "Bei Bedarf extern angeheuert."

# game/scripts/c31/c31.rpy:3003
translate german c31s006_departmentMeeting_715b8968:

    # bet "Alright. Just asking."
    bet "Alles klar. Ich frag ja nur."

# game/scripts/c31/c31.rpy:3005
translate german c31s006_departmentMeeting_f82768d2:

    # "[bet] looks at the arm again. She doesn't seem entirely satisfied with the answer, but she doesn't push it."
    "[bet] sieht sich den Arm noch einmal an. Sie scheint mit der Antwort nicht ganz zufrieden zu sein, aber sie hakt nicht weiter nach."

# game/scripts/c31/c31.rpy:3006
translate german c31s006_departmentMeeting_0c5d71f1:

    # mc "Good. Let's move on. [cal]."
    mc "Gut. Machen wir weiter. [cal]."

# game/scripts/c31/c31.rpy:3008
translate german c31s006_departmentMeeting_41a92896:

    # "[cal] hasn't spoken until now. He has been looking at the arm, just like [bet], although with a very different expression."
    "[cal] hat bis jetzt noch nichts gesagt. Er hat den Arm genauso betrachtet wie [bet], wenn auch mit einem ganz anderen Gesichtsausdruck."

# game/scripts/c31/c31.rpy:3009
translate german c31s006_departmentMeeting_19d12001:

    # "That of someone looking proudly at something they built with their own hands because no one paid them enough attention."
    "Dem von jemandem, der stolz auf etwas blickt, das er mit seinen eigenen Händen gebaut hat, weil ihm niemand genug Aufmerksamkeit geschenkt hat."

# game/scripts/c31/c31.rpy:3010
translate german c31s006_departmentMeeting_92496b3f:

    # "He is one of the few clones who have left field operations and successfully retrained for other roles."
    "Er ist einer der wenigen Klone, die den Außeneinsatz verlassen haben und erfolgreich für andere Aufgaben umgeschult wurden."

# game/scripts/c31/c31.rpy:3011
translate german c31s006_departmentMeeting_dc816664:

    # cal "The arm is functional. All the tests we've been able to run without an actual implantation give results within the expected parameters."
    cal "Der Arm ist funktionsfähig. Alle Tests, die wir ohne eine tatsächliche Implantation durchführen konnten, liefern Ergebnisse innerhalb der erwarteten Parameter."

# game/scripts/c31/c31.rpy:3012
translate german c31s006_departmentMeeting_a453d02d:

    # cal "The neuromuscular integration system is the most delicate part."
    cal "Das neuromuskuläre Integrationssystem ist der heikelste Teil."

# game/scripts/c31/c31.rpy:3013
translate german c31s006_departmentMeeting_1898ae7a:

    # cal "Basically, we tell the peripheral nervous system that this piece of titanium and rubber is a limb, and we hope it believes it."
    cal "Im Grunde sagen wir dem peripheren Nervensystem, dass dieses Stück Titan und Gummi eine Gliedmaße ist, und hoffen, dass es das glaubt."

# game/scripts/c31/c31.rpy:3015
translate german c31s006_departmentMeeting_28871556:

    # flo "And does the peri... the nervous system believe it?"
    flo "Und glaubt das peri... das Nervensystem das?"

# game/scripts/c31/c31.rpy:3016
translate german c31s006_departmentMeeting_7aabb92b:

    # cal "The simulation models say yes. But until we do it on a real person, it's just theory."
    cal "Die Simulationsmodelle sagen ja. Aber bis wir es an einer echten Person durchführen, ist es nur Theorie."

# game/scripts/c31/c31.rpy:3017
translate german c31s006_departmentMeeting_e11cf90e:

    # flo "Right, right..."
    flo "Richtig, richtig..."

# game/scripts/c31/c31.rpy:3018
translate german c31s006_departmentMeeting_fe32cd00:

    # "[flo] nods with that kind of nod people do when they're actually thinking about something else. Maybe they're starting to think about where they can sell it."
    "[flo] nickt mit dieser Art von Nicken, das Leute machen, wenn sie eigentlich an etwas anderes denken. Vielleicht fängt er an darüber nachzudenken, wo er es verkaufen kann."

# game/scripts/c31/c31.rpy:3019
translate german c31s006_departmentMeeting_2a29672a:

    # mc "What can that arm do that a natural one can't?"
    mc "Was kann dieser Arm, was ein natürlicher nicht kann?"

# game/scripts/c31/c31.rpy:3021
translate german c31s006_departmentMeeting_514e0087:

    # cal "In terms of strength, quite a bit more. We're not going to turn [gav] into the Autumn Soldier, just to be clear."
    cal "In Bezug auf Kraft, ein ganzes Stück mehr. Wir werden [gav] nicht in den Autumn Soldier verwandeln, nur um das klarzustellen."

# game/scripts/c31/c31.rpy:3022
translate german c31s006_departmentMeeting_93ecd837:

    # cal "But he will have muscular strength in that arm equivalent to two to three times that of his original arm."
    cal "Aber er wird in diesem Arm eine Muskelkraft haben, die dem Zwei- bis Dreifachen seines ursprünglichen Arms entspricht."

# game/scripts/c31/c31.rpy:3024
translate german c31s006_departmentMeeting_466e155d:

    # cal "Fine motor control, precision tasks, that's going to require rehabilitation and time. It's a process."
    cal "Feinmotorik, Präzisionsaufgaben, das wird Reha und Zeit erfordern. Es ist ein Prozess."

# game/scripts/c31/c31.rpy:3025
translate german c31s006_departmentMeeting_1db19429:

    # cal "It's not an instant upgrade; it's a recovery with added perks."
    cal "Es ist kein sofortiges Upgrade; es ist eine Genesung mit zusätzlichen Vorteilen."

# game/scripts/c31/c31.rpy:3026
translate german c31s006_departmentMeeting_35859867:

    # mc "And could we do the same with other limbs? Legs, for example? Or hands...?"
    mc "Und könnten wir dasselbe mit anderen Gliedmaßen machen? Beinen zum Beispiel? Oder Händen...?"

# game/scripts/c31/c31.rpy:3028
translate german c31s006_departmentMeeting_bbb8fa51:

    # cal "In principle, the architecture can be extrapolated. Legs have more mass, more structural load, the balance system adds complexity..."
    cal "Im Prinzip lässt sich die Architektur extrapolieren. Beine haben mehr Masse, mehr strukturelle Belastung, das Gleichgewichtssystem bringt zusätzliche Komplexität..."

# game/scripts/c31/c31.rpy:3029
translate german c31s006_departmentMeeting_ae5be5b0:

    # cal "A hand or a forearm would be simple to design based on the arm. The problem would be the total weight and battery life."
    cal "Eine Hand oder ein Unterarm wäre auf Basis des Arms einfach zu entwerfen. Das Problem wäre das Gesamtgewicht und die Akkulaufzeit."

# game/scripts/c31/c31.rpy:3031
translate german c31s006_departmentMeeting_1b4c2492:

    # cal "But if [gav]'s surgery goes well, I don't see why not."
    cal "Aber wenn [gav]s Operation gut verläuft, wüsste ich nicht, warum nicht."

# game/scripts/c31/c31.rpy:3032
translate german c31s006_departmentMeeting_4c4d1ff4:

    # cal "It's work, not magic. And we've already done the hardest part."
    cal "Es ist Arbeit, keine Magie. Und den schwersten Teil haben wir bereits erledigt."

# game/scripts/c31/c31.rpy:3034
translate german c31s006_departmentMeeting_7554c245:

    # bet "How long have you been developing this?"
    bet "Wie lange entwickelst du das schon?"

# game/scripts/c31/c31.rpy:3035
translate german c31s006_departmentMeeting_9dd5abb2:

    # cal "Seven years. In my free time."
    cal "Sieben Jahre. In meiner Freizeit."

# game/scripts/c31/c31.rpy:3036
translate german c31s006_departmentMeeting_31e6f40a:

    # bet "In your free time?"
    bet "In deiner Freizeit?"

# game/scripts/c31/c31.rpy:3037
translate german c31s006_departmentMeeting_64d26b3a:

    # cal "The company didn't consider it a priority until I put the prototype on the table."
    cal "Die Firma sah darin keine Priorität, bis ich den Prototyp auf den Tisch gelegt habe."

# game/scripts/c31/c31.rpy:3039
translate german c31s006_departmentMeeting_9326bc02:

    # bet "And do you have...?"
    bet "Und hast du...?"

# game/scripts/c31/c31.rpy:3040
translate german c31s006_departmentMeeting_9296ded0:

    # cal "A mechanical hand? Me? No. I never made it that high up the priority list."
    cal "Eine mechanische Hand? Ich? Nein. Ich stand nie so weit oben auf der Prioritätenliste."

# game/scripts/c31/c31.rpy:3041
translate german c31s006_departmentMeeting_dbf775cd:

    # bet "Well, that's the first thing we should fix when we're done with [gav]."
    bet "Nun, das ist das Erste, worum wir uns kümmern sollten, wenn wir mit [gav] fertig sind."

# game/scripts/c31/c31.rpy:3043
translate german c31s006_departmentMeeting_a1aac41c:

    # "[bet] looks at you apologetically in case she overstepped."
    "[bet] sieht dich entschuldigend an, für den Fall, dass sie zu weit gegangen ist."

# game/scripts/c31/c31.rpy:3044
translate german c31s006_departmentMeeting_8e1a0aed:

    # "[cal] says nothing, but looks at you with a mix of anticipation and hope."
    "[cal] sagt nichts, sieht dich aber mit einer Mischung aus Erwartung und Hoffnung an."

# game/scripts/c31/c31.rpy:3045
translate german c31s006_departmentMeeting_8cbf93b6:

    # mc "I agree with that proposal."
    mc "Ich stimme diesem Vorschlag zu."

# game/scripts/c31/c31.rpy:3046
translate german c31s006_departmentMeeting_ad04ddba:

    # vin "From a budgetary standpoint, an additional unit of the prototype shouldn't be a..."
    vin "Aus budgetärer Sicht sollte eine zusätzliche Einheit des Prototyps kein..."

# game/scripts/c31/c31.rpy:3047
translate german c31s006_departmentMeeting_2ff084c3:

    # mc "[vin], it's not a budgetary decision. It's a debt."
    mc "[vin], das ist keine Budgetentscheidung. Es ist eine Schuld."

# game/scripts/c31/c31.rpy:3048
translate german c31s006_departmentMeeting_f8dca959:

    # vin "Understood."
    vin "Verstanden."

# game/scripts/c31/c31.rpy:3050
translate german c31s006_departmentMeeting_d1155cd4:

    # flo "If you'll allow me to get back to the commercial side for a moment..."
    flo "Wenn ihr mir erlaubt, für einen Moment auf die geschäftliche Seite zurückzukommen..."

# game/scripts/c31/c31.rpy:3051
translate german c31s006_departmentMeeting_590b3479:

    # flo "If [gav]'s operation is a success, and I'm convinced it will be, we're looking at something that doesn't exist anywhere else."
    flo "Wenn [gav]s Operation ein Erfolg wird, und davon bin ich überzeugt, haben wir hier etwas, das es sonst nirgendwo gibt."

# game/scripts/c31/c31.rpy:3053
translate german c31s006_departmentMeeting_8c744874:

    # flo "There is no prosthesis on the market with this level of neuromuscular integration."
    flo "Es gibt keine Prothese auf dem Markt mit diesem Grad an neuromuskulärer Integration."

# game/scripts/c31/c31.rpy:3054
translate german c31s006_departmentMeeting_82b40b02:

    # flo "None. I've studied it and the most advanced competitors are years away."
    flo "Keine einzige. Ich habe es studiert und die fortschrittlichsten Konkurrenten sind noch Jahre davon entfernt."

# game/scripts/c31/c31.rpy:3055
translate german c31s006_departmentMeeting_65a0f41a:

    # flo "The potential market is huge: military, civilians, elite athletes, workplace accidents, degenerative diseases..."
    flo "Der potenzielle Markt ist riesig: Militär, Zivilisten, Spitzensportler, Arbeitsunfälle, degenerative Krankheiten..."

# game/scripts/c31/c31.rpy:3056
translate german c31s006_departmentMeeting_788216b8:

    # flo "We could go from the premium hospital segment to medical insurance agreements. It's exactly the kind of high-tech product you were talking about, [mc]."
    flo "Wir könnten vom Premium-Krankenhaussegment zu Krankenversicherungsabkommen übergehen. Es ist genau die Art von High-Tech-Produkt, von der du gesprochen hast, [mc]."

# game/scripts/c31/c31.rpy:3057
translate german c31s006_departmentMeeting_0325cf8a:

    # mc "That's exactly it."
    mc "Ganz genau."

# game/scripts/c31/c31.rpy:3059
translate german c31s006_departmentMeeting_081f9d77:

    # ama "Although the patent issue would have to be resolved first. If this was developed inside the company in... free time, you said?"
    ama "Obwohl das Patentproblem zuerst gelöst werden müsste. Wenn das innerhalb der Firma in... der Freizeit entwickelt wurde, sagten Sie?"

# game/scripts/c31/c31.rpy:3060
translate german c31s006_departmentMeeting_4d33f325:

    # cal "Yes."
    cal "Ja."

# game/scripts/c31/c31.rpy:3061
translate german c31s006_departmentMeeting_5b5b1de6:

    # ama "That could create ambiguity in intellectual property. We'd need to clean that up before launching to market."
    ama "Das könnte zu Unklarheiten beim geistigen Eigentum führen. Das müssten wir klären, bevor wir auf den Markt gehen."

# game/scripts/c31/c31.rpy:3062
translate german c31s006_departmentMeeting_729cfafb:

    # cal "Whatever is necessary."
    cal "Was auch immer nötig ist."

# game/scripts/c31/c31.rpy:3063
translate german c31s006_departmentMeeting_8ef747fc:

    # mc "Good. Then let's recap what we have on the table, literally and metaphorically."
    mc "Gut. Dann fassen wir mal zusammen, was wir auf dem Tisch haben, im wörtlichen und im übertragenen Sinne."

# game/scripts/c31/c31.rpy:3065
translate german c31s006_departmentMeeting_b89df83f:

    # mc "The covert operations committed for the next two quarters will be carried out. [aar], we're not going to leave any contracts unfulfilled."
    mc "Die für die nächsten zwei Quartale zugesagten verdeckten Operationen werden durchgeführt. [aar], wir werden keine Verträge unerfüllt lassen."

# game/scripts/c31/c31.rpy:3066
translate german c31s006_departmentMeeting_99d46b80:

    # aar "Thank you."
    aar "Danke."

# game/scripts/c31/c31.rpy:3068
translate german c31s006_departmentMeeting_afbdee79:

    # mc "[flo], negotiations with Colombia and the United States are moving forward for now."
    mc "[flo], die Verhandlungen mit Kolumbien und den Vereinigten Staaten schreiten vorerst voran."

# game/scripts/c31/c31.rpy:3069
translate german c31s006_departmentMeeting_c8c77ded:

    # mc "China and Israel need to be studied carefully. North Korea and Iran remain banned, or we run the risk of sanctions."
    mc "China und Israel müssen sorgfältig geprüft werden. Nordkorea und der Iran bleiben tabu, sonst riskieren wir Sanktionen."

# game/scripts/c31/c31.rpy:3070
translate german c31s006_departmentMeeting_bc3fbb39:

    # mc "But I want you to start exploring contacts in the medical sector in parallel."
    mc "Aber ich möchte, dass Sie parallel dazu anfangen, Kontakte im medizinischen Sektor zu knüpfen."

# game/scripts/c31/c31.rpy:3071
translate german c31s006_departmentMeeting_79762cb3:

    # mc "Hospitals, insurance companies, healthcare investment funds. Not for tomorrow, but I want to know what's out there."
    mc "Krankenhäuser, Versicherungsgesellschaften, Investmentfonds im Gesundheitswesen. Nicht für morgen, aber ich will wissen, was es da draußen gibt."

# game/scripts/c31/c31.rpy:3072
translate german c31s006_departmentMeeting_e5df2b21:

    # mc "I also want to know what technologies we have that can be sold or manufactured, and whose commercial possibilities we haven't explored yet."
    mc "Ich möchte auch wissen, welche Technologien wir haben, die verkauft oder hergestellt werden können, und deren kommerzielle Möglichkeiten wir noch nicht ausgelotet haben."

# game/scripts/c31/c31.rpy:3073
translate german c31s006_departmentMeeting_605259e4:

    # flo "Consider it done."
    flo "Betrachte es als erledigt."

# game/scripts/c31/c31.rpy:3075
translate german c31s006_departmentMeeting_569c1da7:

    # mc "[mael], I want a report in two weeks on the real viability of keeping the cloning department focused on animals and organ research."
    mc "[mael], ich möchte in zwei Wochen einen Bericht über die tatsächliche Machbarkeit, die Klonabteilung auf Tiere und Organforschung zu konzentrieren."

# game/scripts/c31/c31.rpy:3076
translate german c31s006_departmentMeeting_00eb2451:

    # mc "No compromises, just data."
    mc "Keine Kompromisse, nur Daten."

# game/scripts/c31/c31.rpy:3077
translate german c31s006_departmentMeeting_d30b29a9:

    # mael "Two weeks. Understood."
    mael "Zwei Wochen. Verstanden."

# game/scripts/c31/c31.rpy:3078
translate german c31s006_departmentMeeting_0e2e7a77:

    # mc "The forty-two subjects currently in gestation... we're going to guarantee they get a proper welcome and are given a suitable outcome, whatever that may be."
    mc "Die zweiundvierzig Subjekte, die sich derzeit in der Reifungsphase befinden... wir werden garantieren, dass sie angemessen empfangen werden und ein passendes Ergebnis erhalten, was auch immer das sein mag."

# game/scripts/c31/c31.rpy:3079
translate german c31s006_departmentMeeting_84c837a9:

    # mc "We're not who we used to be. I don't think they'll become field operatives."
    mc "Wir sind nicht mehr die, die wir einmal waren. Ich glaube nicht, dass sie Feldagenten werden."

# game/scripts/c31/c31.rpy:3081
translate german c31s006_departmentMeeting_854445a9:

    # mc "[vin], I need you to prepare three financial scenarios for me."
    mc "[vin], ich brauche drei Finanzszenarien von dir."

# game/scripts/c31/c31.rpy:3082
translate german c31s006_departmentMeeting_e4d39871:

    # mc "One with the company as it is, one with the gradual shutdown of covert operations, and one with a serious investment in the medical division."
    mc "Eines mit dem Unternehmen, wie es jetzt ist, eines mit der schrittweisen Einstellung verdeckter Operationen und eines mit einer ernsthaften Investition in die medizinische Abteilung."

# game/scripts/c31/c31.rpy:3083
translate german c31s006_departmentMeeting_1d0a32fe:

    # mc "Real numbers, not optimistic projections."
    mc "Echte Zahlen, keine optimistischen Prognosen."

# game/scripts/c31/c31.rpy:3084
translate german c31s006_departmentMeeting_d267c4b5:

    # vin "When?"
    vin "Wann?"

# game/scripts/c31/c31.rpy:3085
translate german c31s006_departmentMeeting_b3e51eee:

    # mc "Next week."
    mc "Nächste Woche."

# game/scripts/c31/c31.rpy:3086
translate german c31s006_departmentMeeting_4783c894:

    # vin "Sure."
    vin "Klar."

# game/scripts/c31/c31.rpy:3088
translate german c31s006_departmentMeeting_85ec888d:

    # mc "[ama], operational security during the transition. I need no one on the outside to know we're changing course until we're ready to announce it ourselves."
    mc "[ama], operative Sicherheit während des Übergangs. Ich will, dass niemand außerhalb erfährt, dass wir den Kurs ändern, bis wir bereit sind, es selbst anzukündigen."

# game/scripts/c31/c31.rpy:3089
translate german c31s006_departmentMeeting_4a06d11e:

    # ama "Understood."
    ama "Verstanden."

# game/scripts/c31/c31.rpy:3091
translate german c31s006_departmentMeeting_11b93c94:

    # mc "And [cal]..."
    mc "Und [cal]..."

# game/scripts/c31/c31.rpy:3092
translate german c31s006_departmentMeeting_3a412510:

    # mc "What you and your team have done is extraordinary."
    mc "Was du und dein Team geleistet habt, ist außergewöhnlich."

# game/scripts/c31/c31.rpy:3093
translate german c31s006_departmentMeeting_f483d35b:

    # mc "I want [gav]'s operation to be a success, and I want you to have your hand."
    mc "Ich will, dass [gav]s Operation ein Erfolg wird, und ich will, dass du deine Hand bekommst."

# game/scripts/c31/c31.rpy:3094
translate german c31s006_departmentMeeting_6312b14e:

    # mc "In that order, but I want both."
    mc "In dieser Reihenfolge, aber ich will beides."

# game/scripts/c31/c31.rpy:3095
translate german c31s006_departmentMeeting_e4a4f714:

    # cal "Agreed."
    cal "Einverstanden."

# game/scripts/c31/c31.rpy:3097
translate german c31s006_departmentMeeting_80ede5b5:

    # bet "I've reviewed the implantation protocol three times and I have some suggestions for the procedure that I'd like to discuss with you, [cal], before going into surgery."
    bet "Ich habe das Implantationsprotokoll dreimal überprüft und habe einige Vorschläge für den Eingriff, die ich gerne mit dir besprechen würde, [cal], vor der Operation."

# game/scripts/c31/c31.rpy:3098
translate german c31s006_departmentMeeting_6e5a6591:

    # cal "Whenever you want."
    cal "Wann immer du willst."

# game/scripts/c31/c31.rpy:3099
translate german c31s006_departmentMeeting_1027abb3:

    # bet "This afternoon?"
    bet "Heute Nachmittag?"

# game/scripts/c31/c31.rpy:3100
translate german c31s006_departmentMeeting_4643f46b:

    # cal "This afternoon."
    cal "Heute Nachmittag."

# game/scripts/c31/c31.rpy:3102
translate german c31s006_departmentMeeting_ef97fcde:

    # flo "Do you know what would be a perfect marketing story?"
    flo "Wisst ihr, was eine perfekte Marketing-Story wäre?"

# game/scripts/c31/c31.rpy:3103
translate german c31s006_departmentMeeting_8ca89ddc:

    # flo "The engineer who designed the prosthesis because he needed it, receiving the prosthesis he designed. That's worth more than any ad campaign."
    flo "Der Ingenieur, der die Prothese entworfen hat, weil er sie brauchte, und der genau diese Prothese erhält. Das ist mehr wert als jede Werbekampagne."

# game/scripts/c31/c31.rpy:3104
translate german c31s006_departmentMeeting_e4888b9b:

    # cal "I'm not an ad campaign, [flo]."
    cal "Ich bin keine Werbekampagne, [flo]."

# game/scripts/c31/c31.rpy:3105
translate german c31s006_departmentMeeting_139e482b:

    # flo "I know. That's why it would work."
    flo "Ich weiß. Deshalb würde es ja funktionieren."

# game/scripts/c31/c31.rpy:3107
translate german c31s006_departmentMeeting_ee5012d9:

    # ama "[flo]..."
    ama "[flo]..."

# game/scripts/c31/c31.rpy:3108
translate german c31s006_departmentMeeting_1c50af4c:

    # flo "What? It's true."
    flo "Was denn? Es stimmt doch."

# game/scripts/c31/c31.rpy:3109
translate german c31s006_departmentMeeting_e25971c4:

    # ama "It is true. And even so..."
    ama "Es stimmt. Und trotzdem..."

# game/scripts/c31/c31.rpy:3110
translate german c31s006_departmentMeeting_1b9e71c5:

    # vin "If we're done with the emotional part... can we wrap up this meeting? I have to prepare three reports..."
    vin "Wenn wir mit dem emotionalen Teil fertig sind... können wir dieses Meeting beenden? Ich muss noch drei Berichte vorbereiten..."

# game/scripts/c31/c31.rpy:3111
translate german c31s006_departmentMeeting_4aab074c:

    # mc "I don't think there's anything else to talk about."
    mc "Ich glaube nicht, dass es noch etwas zu besprechen gibt."

# game/scripts/c31/c31.rpy:3113
translate german c31s006_departmentMeeting_271e4c07:

    # "People start getting up."
    "Die Leute fangen an, aufzustehen."

# game/scripts/c31/c31.rpy:3114
translate german c31s006_departmentMeeting_0fc156a4:

    # "[bet] slowly walks around the table and stops next to the electromechanical arm. She looks at it closely, without touching it, as if she were reading something written on it."
    "[bet] geht langsam um den Tisch herum und bleibt neben dem elektromechanischen Arm stehen. Sie sieht ihn sich genau an, ohne ihn zu berühren, als würde sie etwas lesen, das darauf geschrieben steht."

# game/scripts/c31/c31.rpy:3115
translate german c31s006_departmentMeeting_19d2a449:

    # bet "How much does it weigh? It looks heavier than in the specs you sent me."
    bet "Wie viel wiegt er? Er sieht schwerer aus als in den Spezifikationen, die du mir geschickt hast."

# game/scripts/c31/c31.rpy:3117
translate german c31s006_departmentMeeting_6be20864:

    # cal "This is the prototype. It weighs a little more than the one you'll implant. Four kilos, one hundred grams. And it doesn't have the batteries."
    cal "Das ist der Prototyp. Er wiegt ein bisschen mehr als der, den du implantieren wirst. Vier Kilo, einhundert Gramm. Und er hat noch keine Batterien."

# game/scripts/c31/c31.rpy:3118
translate german c31s006_departmentMeeting_87a6afc6:

    # cal "The one you'll put on [gav], three kilos, eight hundred grams in total."
    cal "Der, den du [gav] anbringen wirst, wiegt insgesamt drei Kilo, achthundert Gramm."

# game/scripts/c31/c31.rpy:3119
translate german c31s006_departmentMeeting_67a68b86:

    # "He sounds like a proud father."
    "Er klingt wie ein stolzer Vater."

# game/scripts/c31/c31.rpy:3121
translate german c31s006_departmentMeeting_9a8b8a88:

    # bet "Less than I expected."
    bet "Weniger als ich erwartet habe."

# game/scripts/c31/c31.rpy:3122
translate german c31s006_departmentMeeting_709652dc:

    # cal "It was a design requirement. If it weighs too much, the shoulder pays for it in the long run."
    cal "Das war eine Designvorgabe. Wenn er zu viel wiegt, leidet die Schulter auf lange Sicht darunter."

# game/scripts/c31/c31.rpy:3123
translate german c31s006_departmentMeeting_4328d08d:

    # bet "You thought of everything."
    bet "Du hast an alles gedacht."

# game/scripts/c31/c31.rpy:3124
translate german c31s006_departmentMeeting_2e29ef91:

    # cal "I had seven years to do it."
    cal "Ich hatte sieben Jahre Zeit dafür."

# game/scripts/c31/c31.rpy:3126
translate german c31s006_departmentMeeting_5e264f03:

    # vin "*Muttering to himself* Daniels also thought he had everything figured out."
    vin "*Murmelt vor sich hin* Daniels dachte auch, er hätte alles durchdacht."

# game/scripts/c31/c31.rpy:3127
translate german c31s006_departmentMeeting_0f8ef23c:

    # "You prefer not to answer and head with [ama] to your office to review the files of the clones you'll be meeting with in a little over an hour."
    "Du ziehst es vor, nicht zu antworten, und gehst mit [ama] in dein Büro, um die Akten der Klone durchzusehen, mit denen du dich in etwas mehr als einer Stunde treffen wirst."

# game/scripts/c31/c31.rpy:3129
translate german c31s006_departmentMeeting_31652e76:

    # "You stop for a moment in front of a window."
    "Du bleibst für einen Moment vor einem Fenster stehen."

# game/scripts/c31/c31.rpy:3130
translate german c31s006_departmentMeeting_017a6969:

    # "Outside, the Caribbean shines in the distance with that perfect indifference the sea has when it doesn't know someone is watching it."
    "Draußen glänzt die Karibik in der Ferne mit jener vollkommenen Gleichgültigkeit, die das Meer an sich hat, wenn es nicht weiß, dass jemand es beobachtet."

# game/scripts/c31/c31.rpy:3131
translate german c31s006_departmentMeeting_38152f55:

    # "Someone who has just inherited an illegal enterprise and who has the intention, still without a precise shape, to turn it into something different."
    "Jemand, der gerade ein illegales Unternehmen geerbt hat und die Absicht hegt, wenn auch noch ohne genaue Form, es in etwas anderes zu verwandeln."

# game/scripts/c31/c31.rpy:3132
translate german c31s006_departmentMeeting_d4666650:

    # "It's a good start. Or at least, it's a start."
    "Es ist ein guter Anfang. Oder zumindest ist es ein Anfang."

# game/scripts/c31/c31.rpy:2541
translate german c31s006_cloneMeeting_5d882aa2:

    # "Later, back in the meeting room and after the introductions..."
    "Später, zurück im Besprechungsraum und nach den Vorstellungen..."

# game/scripts/c31/c31.rpy:2542
translate german c31s006_cloneMeeting_d9a84e78:

    # mc "Thank you all for coming on such short notice. I know this is new for a lot of you."
    mc "Danke, dass ihr alle so kurzfristig gekommen seid. Ich weiß, das ist für viele von euch neu."

# game/scripts/c31/c31.rpy:2543
translate german c31s006_cloneMeeting_36093761:

    # mc "First of all, let me introduce myself. I'm [mc] Marks and I'm acting as the new CEO. This is as new to me as it is to you."
    mc "Zunächst einmal möchte ich mich vorstellen. Ich bin [mc] Marks und fungiere als der neue CEO. Das ist für mich genauso neu wie für euch."

# game/scripts/c31/c31.rpy:2544
translate german c31s006_cloneMeeting_92a548af:

    # mc "My intention is to listen to you. You have the floor to raise whatever you need."
    mc "Meine Absicht ist es, euch zuzuhören. Ihr habt das Wort, um alles vorzubringen, was ihr braucht."

# game/scripts/c31/c31.rpy:2546
translate german c31s006_cloneMeeting_40b3e942:

    # aar "We appreciate the gesture, [mc]. The guys have been wanting to talk to management for a while. They've never been given this opportunity before."
    aar "Wir wissen die Geste zu schätzen, [mc]. Die Jungs wollten schon länger mit der Geschäftsführung reden. Diese Gelegenheit hatten sie noch nie."

# game/scripts/c31/c31.rpy:2548
translate german c31s006_cloneMeeting_0a0a0928:

    # ama "[mc] wanted this meeting to be open and unfiltered. You can speak freely."
    ama "[mc] wollte, dass dieses Treffen offen und ungefiltert ist. Ihr könnt frei sprechen."

# game/scripts/c31/c31.rpy:2549
translate german c31s006_cloneMeeting_f2431388:

    # ama "[mc] is... different from the previous management."
    ama "[mc] ist... anders als die vorherige Geschäftsführung."

# game/scripts/c31/c31.rpy:2551
translate german c31s006_cloneMeeting_5920525f:

    # dam "Seriously? We can ask for whatever we want?"
    dam "Ernsthaft? Wir können verlangen, was wir wollen?"

# game/scripts/c31/c31.rpy:2552
translate german c31s006_cloneMeeting_52e3172c:

    # dam "Because I have a pretty interesting list..."
    dam "Weil ich da eine ziemlich interessante Liste habe..."

# game/scripts/c31/c31.rpy:2554
translate german c31s006_cloneMeeting_267a1e65:

    # gav "[dam], please. Let's start with what's important. We agreed on a series of points yesterday."
    gav "[dam], bitte. Lass uns mit dem Wichtigen anfangen. Wir haben uns gestern auf eine Reihe von Punkten geeinigt."

# game/scripts/c31/c31.rpy:2556
translate german c31s006_cloneMeeting_6545731e:

    # fred "[gav] is right. There are urgent matters on the table."
    fred "[gav] hat recht. Es liegen dringende Angelegenheiten auf dem Tisch."

# game/scripts/c31/c31.rpy:2558
translate german c31s006_cloneMeeting_d22e1119:

    # carl "I've prepared a summary of the requests we agreed on in the previous meeting."
    carl "Ich habe eine Zusammenfassung der Forderungen vorbereitet, auf die wir uns im vorherigen Meeting geeinigt haben."

# game/scripts/c31/c31.rpy:2559
translate german c31s006_cloneMeeting_b62c57a5:

    # carl "If it's alright with you, I'll go over them one by one."
    carl "Wenn es für euch in Ordnung ist, werde ich sie einzeln durchgehen."

# game/scripts/c31/c31.rpy:2560
translate german c31s006_cloneMeeting_bec1d115:

    # mc "Go ahead, Carl."
    mc "Mach weiter, Carl."

# game/scripts/c31/c31.rpy:2562
translate german c31s006_cloneMeeting_98cff6b5:

    # carl "The first request is of a personal nature. The operatives want to be able to grow beards, or change their haircuts. The current regulations prohibit it."
    carl "Die erste Forderung ist persönlicher Natur. Die Agenten wollen sich Bärte wachsen lassen oder ihre Frisuren ändern können. Die aktuellen Vorschriften verbieten das."

# game/scripts/c31/c31.rpy:2563
translate german c31s006_cloneMeeting_11aa53e4:

    # carl "[aar] is the only operative you'll see with a beard on base, and that's because he let it grow while he was... off duty."
    carl "[aar] ist der einzige Agent, den man auf der Basis mit einem Bart sieht, und das liegt daran, dass er ihn sich wachsen ließ, während er... außer Dienst war."

# game/scripts/c31/c31.rpy:2565
translate german c31s006_cloneMeeting_d3af2b5f:

    # dam "I've been wanting to grow a beard for two years. Two years!"
    dam "Ich will mir schon seit zwei Jahren einen Bart wachsen lassen. Zwei Jahre!"

# game/scripts/c31/c31.rpy:2567
translate german c31s006_cloneMeeting_1a59eca7:

    # gav "It's a matter of identity. For us... it means more than it seems."
    gav "Es ist eine Frage der Identität. Für uns... bedeutet es mehr, als es den Anschein hat."

# game/scripts/c31/c31.rpy:2568
translate german c31s006_cloneMeeting_a2603103:

    # mc "I understand. Is there any operational reason to keep that restriction, [ama]?"
    mc "Ich verstehe. Gibt es einen operativen Grund, diese Einschränkung beizubehalten, [ama]?"

# game/scripts/c31/c31.rpy:2570
translate german c31s006_cloneMeeting_5fe2c92c:

    # ama "None that I can see. In some infiltration missions it might be relevant, but that can be handled on a case-by-case basis."
    ama "Keinen, den ich erkennen kann. Bei einigen Infiltrationsmissionen könnte es relevant sein, aber das kann von Fall zu Fall entschieden werden."

# game/scripts/c31/c31.rpy:2571
translate german c31s006_cloneMeeting_012f0ad6:

    # ama "As long as it doesn't interfere with the equipment... gas masks, helmets, night vision goggles... I don't see a problem."
    ama "Solange es nicht mit der Ausrüstung kollidiert... Gasmasken, Helme, Nachtsichtgeräte... sehe ich da kein Problem."

# game/scripts/c31/c31.rpy:2572
translate german c31s006_cloneMeeting_70a1e99b:

    # mc "Alright. From now on, every operative can wear whatever personal style they prefer."
    mc "In Ordnung. Ab sofort kann jeder Agent den persönlichen Stil tragen, den er bevorzugt."

# game/scripts/c31/c31.rpy:2573
translate german c31s006_cloneMeeting_e379e758:

    # mc "If there's a mission that requires a specific look, you'll be notified in advance."
    mc "Sollte eine Mission einen bestimmten Look erfordern, werdet ihr im Voraus benachrichtigt."

# game/scripts/c31/c31.rpy:2575
translate german c31s006_cloneMeeting_350bba27:

    # gav "Thank you, [mc]. Really."
    gav "Danke, [mc]. Wirklich."

# game/scripts/c31/c31.rpy:2576
translate german c31s006_cloneMeeting_dafd1765:

    # fred "It was the bare minimum, but it's appreciated."
    fred "Das war das absolute Minimum, aber wir wissen es zu schätzen."

# game/scripts/c31/c31.rpy:2577
translate german c31s006_cloneMeeting_b7ad0f36:

    # dam "Finally! I'm going to grow some epic sideburns."
    dam "Endlich! Ich werde mir epische Koteletten wachsen lassen."

# game/scripts/c31/c31.rpy:2578
translate german c31s006_cloneMeeting_c9821169:

    # aar "[dam]..."
    aar "[dam]..."

# game/scripts/c31/c31.rpy:2580
translate german c31s006_cloneMeeting_6e6be4ea:

    # dam "What? It's legit!"
    dam "Was denn? Das ist völlig legitim!"

# game/scripts/c31/c31.rpy:2582
translate german c31s006_cloneMeeting_5edb2419:

    # "Carl decides to ignore his partner and continue with the requests."
    "Carl beschließt, seinen Partner zu ignorieren und mit den Anliegen fortzufahren."

# game/scripts/c31/c31.rpy:2583
translate german c31s006_cloneMeeting_6445500f:

    # carl "The second request is more delicate. It's about Eric."
    carl "Das zweite Anliegen ist heikler. Es geht um Eric."

# game/scripts/c31/c31.rpy:2584
translate german c31s006_cloneMeeting_443be3c6:

    # fred "Eric has been detained for a month, accused of treason."
    fred "Eric ist seit einem Monat inhaftiert, angeklagt wegen Verrats."

# game/scripts/c31/c31.rpy:2585
translate german c31s006_cloneMeeting_290f8b0f:

    # dam "I never liked him... I didn't like anyone from E, but it's unfair."
    dam "Ich mochte ihn nie... Ich mochte niemanden von E, aber es ist unfair."

# game/scripts/c31/c31.rpy:2586
translate german c31s006_cloneMeeting_09fdf597:

    # aar "He acted against the owners of the company, yes. But there's context."
    aar "Er hat gegen die Eigentümer der Firma gehandelt, ja. Aber es gibt einen Kontext."

# game/scripts/c31/c31.rpy:2587
translate german c31s006_cloneMeeting_19c6561a:

    # mc "I know. I was reviewing the file. He was following Daniels' orders. He was his superior..."
    mc "Ich weiß. Ich habe die Akte überprüft. Er hat Daniels' Befehle befolgt. Er war sein Vorgesetzter..."

# game/scripts/c31/c31.rpy:2589
translate german c31s006_cloneMeeting_ff5c7a7f:

    # ama "A superior who is now also under arrest, by the way."
    ama "Ein Vorgesetzter, der übrigens jetzt auch unter Arrest steht."

# game/scripts/c31/c31.rpy:2590
translate german c31s006_cloneMeeting_6054290a:

    # ama "A superior who ordered the murders of my sisters, the A's, and your family."
    ama "Ein Vorgesetzter, der die Morde an meinen Schwestern, den As, und deiner Familie befohlen hat."

# game/scripts/c31/c31.rpy:2592
translate german c31s006_cloneMeeting_43ce085f:

    # gav "Nobody is saying Eric is a good guy, far from it. But he was caught in the crossfire. He didn't have a real choice."
    gav "Niemand sagt, dass Eric ein guter Kerl ist, ganz und gar nicht. Aber er ist ins Kreuzfeuer geraten. Er hatte keine wirkliche Wahl."

# game/scripts/c31/c31.rpy:2594
translate german c31s006_cloneMeeting_97c7d6f5:

    # fred "We didn't have one either, back in those days. We did what we were told... Or there were consequences."
    fred "Wir hatten damals auch keine. Wir haben getan, was uns gesagt wurde... Oder es gab Konsequenzen."

# game/scripts/c31/c31.rpy:2595
translate german c31s006_cloneMeeting_ef160ee3:

    # fred "I was in the other operation at that time... We were misled, and if Eric should be arrested, [gav] or I should be too."
    fred "Ich war zu der Zeit in der anderen Operation... Wir wurden in die Irre geführt, und wenn Eric verhaftet werden sollte, sollten [gav] oder ich das auch."

# game/scripts/c31/c31.rpy:2596
translate german c31s006_cloneMeeting_a4e84d83:

    # mc "I'm aware of that. The previous structure left no room for disobedience."
    mc "Das ist mir bewusst. Die vorherige Struktur ließ keinen Raum für Ungehorsam."

# game/scripts/c31/c31.rpy:2598
translate german c31s006_cloneMeeting_d1d190a1:

    # fred "I'm sorry, [ama]..."
    fred "Es tut mir leid, [ama]..."

# game/scripts/c31/c31.rpy:2599
translate german c31s006_cloneMeeting_f9671a0f:

    # "[ama] doesn't bother to answer. Beatrice and Diana died at the hands of the group [fred] belonged to."
    "[ama] macht sich nicht die Mühe zu antworten. Beatrice und Diana starben durch die Hände der Gruppe, der [fred] angehörte."

# game/scripts/c31/c31.rpy:2601
translate german c31s006_cloneMeeting_a52d66e4:

    # dam "Eric is not a traitor. He's someone who survived however he could. He remained loyal to whoever was in command at the time."
    dam "Eric ist kein Verräter. Er ist jemand, der überlebt hat, wie auch immer er konnte. Er blieb demjenigen treu, der zu der Zeit das Kommando hatte."

# game/scripts/c31/c31.rpy:2603
translate german c31s006_cloneMeeting_a33e4933:

    # carl "The formal request is his immediate release and the dropping of the charges."
    carl "Die formelle Forderung ist seine sofortige Freilassung und die Einstellung der Anklage."

# game/scripts/c31/c31.rpy:2604
translate german c31s006_cloneMeeting_7218061a:

    # mc "I'm not going to make that decision lightly today. I need to review the whole case."
    mc "Ich werde diese Entscheidung heute nicht leichtfertig treffen. Ich muss den gesamten Fall überprüfen."

# game/scripts/c31/c31.rpy:2605
translate german c31s006_cloneMeeting_587a9a90:

    # mc "But I give you my word that I will look into it personally. Eric will have a fair review."
    mc "Aber ich gebe euch mein Wort, dass ich mich persönlich darum kümmern werde. Eric wird eine faire Anhörung bekommen."

# game/scripts/c31/c31.rpy:2606
translate german c31s006_cloneMeeting_defcc6d3:

    # carl "We'll settle for that. For now, sir."
    carl "Damit geben wir uns zufrieden. Vorerst, Sir."

# game/scripts/c31/c31.rpy:2607
translate german c31s006_cloneMeeting_e32a1a09:

    # "That 'sir' at the end of the sentence almost sounds like a challenge for you not to keep your word."
    "Das 'Sir' am Ende des Satzes klingt fast wie eine Herausforderung an dich, dein Wort nicht zu halten."

# game/scripts/c31/c31.rpy:2609
translate german c31s006_cloneMeeting_bd556b53:

    # carl "Third request: the operatives request a leave system to go off-base."
    carl "Dritte Forderung: Die Agenten fordern ein Urlaubssystem, um die Basis verlassen zu können."

# game/scripts/c31/c31.rpy:2610
translate german c31s006_cloneMeeting_bc448111:

    # carl "Currently, they cannot leave the perimeter without an active mission."
    carl "Derzeit können sie das Gelände ohne einen aktiven Einsatz nicht verlassen."

# game/scripts/c31/c31.rpy:2612
translate german c31s006_cloneMeeting_aa45883c:

    # fred "We've gone years without being able to go to a bar, to the movies, to see anyone."
    fred "Wir konnten jahrelang nicht in eine Bar oder ins Kino gehen oder irgendjemanden treffen."

# game/scripts/c31/c31.rpy:2613
translate german c31s006_cloneMeeting_e0add868:

    # dam "Without being able to get laid, let's get to the important stuff."
    dam "Ohne mal ficken zu können, kommen wir zu den wichtigen Dingen."

# game/scripts/c31/c31.rpy:2614
translate german c31s006_cloneMeeting_30c6f52e:

    # gav "Without being able to breathe any air other than this."
    gav "Ohne andere Luft atmen zu können als diese hier."

# game/scripts/c31/c31.rpy:2615
translate german c31s006_cloneMeeting_dd5407b0:

    # aar "It's one of the harshest restrictions. It keeps them isolated from the world."
    aar "Das ist eine der härtesten Einschränkungen. Es hält sie von der Welt isoliert."

# game/scripts/c31/c31.rpy:2616
translate german c31s006_cloneMeeting_c76ddba6:

    # mc "Is that literal? You can't leave under any circumstances?"
    mc "Ist das wörtlich gemeint? Ihr dürft unter keinen Umständen gehen?"

# game/scripts/c31/c31.rpy:2618
translate german c31s006_cloneMeeting_2da319ae:

    # ama "That was the rule, yes. Total movement control."
    ama "Das war die Regel, ja. Totale Bewegungskontrolle."

# game/scripts/c31/c31.rpy:2619
translate german c31s006_cloneMeeting_36e05359:

    # mc "That's... unacceptable. You aren't prisoners."
    mc "Das ist... inakzeptabel. Ihr seid keine Gefangenen."

# game/scripts/c31/c31.rpy:2621
translate german c31s006_cloneMeeting_17a3be4b:

    # fred "For years they treated us like we were."
    fred "Jahrelang haben sie uns so behandelt, als wären wir welche."

# game/scripts/c31/c31.rpy:2622
translate german c31s006_cloneMeeting_660a0965:

    # mc "That's over. We're going to establish a leave system immediately."
    mc "Damit ist jetzt Schluss. Wir werden sofort ein Ausgangssystem einführen."

# game/scripts/c31/c31.rpy:2623
translate german c31s006_cloneMeeting_653c9398:

    # mc "Individual outings with reasonable notice. No asking for permission like you're children."
    mc "Individuelle Ausflüge mit angemessener Vorankündigung. Kein Betteln um Erlaubnis, als wärt ihr Kinder."

# game/scripts/c31/c31.rpy:2625
translate german c31s006_cloneMeeting_11db2a81:

    # gav "Seriously?"
    gav "Ernsthaft?"

# game/scripts/c31/c31.rpy:2626
translate german c31s006_cloneMeeting_5f6a2c7a:

    # mc "Seriously. You're no longer slaves. You never should have been."
    mc "Ernsthaft. Ihr seid keine Sklaven mehr. Das hättet ihr nie sein dürfen."

# game/scripts/c31/c31.rpy:2627
translate german c31s006_cloneMeeting_c9bdddee:

    # aar "That... means a lot, [mc]. More than you can imagine."
    aar "Das... bedeutet uns viel, [mc]. Mehr als du dir vorstellen kannst."

# game/scripts/c31/c31.rpy:2628
translate german c31s006_cloneMeeting_6f54b9bc:

    # dam "Yeah! Freedom! First stop: anywhere but here!"
    dam "Yeah! Freiheit! Erster Halt: Überall, nur nicht hier!"


# game/scripts/c31/c31.rpy:2629
translate german c31s006_cloneMeeting_3df29d04:

    # fred "Thank you, [mc]."
    fred "Danke, [mc]."

# game/scripts/c31/c31.rpy:2631
translate german c31s006_cloneMeeting_50973adb:

    # "There's a brief silence in the room. Several of the clones exchange glances."
    "Es herrscht eine kurze Stille im Raum. Mehrere der Klone tauschen Blicke aus."

# game/scripts/c31/c31.rpy:2632
translate german c31s006_cloneMeeting_db0ff1e8:

    # "You don't know them well enough yet to interpret those glances, but you detect a hint of hope."
    "Du kennst sie noch nicht gut genug, um diese Blicke zu deuten, aber du erkennst einen Hauch von Hoffnung."

# game/scripts/c31/c31.rpy:2634
translate german c31s006_cloneMeeting_3a371344:

    # carl "The fourth request is related to [gav]."
    carl "Die vierte Bitte bezieht sich auf [gav]."

# game/scripts/c31/c31.rpy:2635
translate german c31s006_cloneMeeting_907ec0ae:

    # carl "The operatives want everyone who lost limbs or suffered serious injuries to receive the same treatment that has been approved for [gav]."
    carl "Die Agenten wollen, dass jeder, der Gliedmaßen verloren hat oder schwere Verletzungen erlitt, die gleiche Behandlung erhält, die für [gav] genehmigt wurde."

# game/scripts/c31/c31.rpy:2636
translate german c31s006_cloneMeeting_66a8af5e:

    # carl "Within what's possible and the availability of prosthetics and other devices, of course."
    carl "Im Rahmen des Möglichen und der Verfügbarkeit von Prothesen und anderen Hilfsmitteln natürlich."

# game/scripts/c31/c31.rpy:2638
translate german c31s006_cloneMeeting_003f416c:

    # gav "It doesn't seem fair that I get this opportunity and the others don't. There are several other guys with amputations. And others with permanent damage."
    gav "Es erscheint mir nicht fair, dass ich diese Chance bekomme und die anderen nicht. Es gibt noch einige andere Jungs mit Amputationen. Und andere mit bleibenden Schäden."

# game/scripts/c31/c31.rpy:2639
translate german c31s006_cloneMeeting_d8f8a3d1:

    # mc "How many operatives are in that situation?"
    mc "Wie viele Agenten sind in dieser Situation?"

# game/scripts/c31/c31.rpy:2641
translate german c31s006_cloneMeeting_e55778cc:

    # aar "With amputations, 19 counting [gav]. [gav] is the most... recent. And the only one we have a prosthesis ready for."
    aar "Mit Amputationen sind es 19, [gav] mitgezählt. [gav] ist der... jüngste Fall. Und der Einzige, für den wir eine Prothese bereit haben."

# game/scripts/c31/c31.rpy:2642
translate german c31s006_cloneMeeting_09d2579d:

    # aar "They were working on what's going to be his prosthesis before the... incident."
    aar "Sie haben vor dem... Vorfall an dem gearbeitet, was seine Prothese werden soll."

# game/scripts/c31/c31.rpy:2643
translate german c31s006_cloneMeeting_6e9ec8f2:

    # aar "With severe permanent injuries, another six or seven."
    aar "Mit schweren bleibenden Verletzungen noch mal sechs oder sieben."

# game/scripts/c31/c31.rpy:2644
translate german c31s006_cloneMeeting_d26e96d6:

    # aar "[carl] would fall into this category because of his eye, for example, but we don't have any device that can help him."
    aar "[carl] würde zum Beispiel wegen seines Auges in diese Kategorie fallen, aber wir haben kein Gerät, das ihm helfen kann."

# game/scripts/c31/c31.rpy:2646
translate german c31s006_cloneMeeting_3b3e3fd0:

    # ama "High-end prosthetics don't grow on trees. We'd have to look into the development costs."
    ama "High-End-Prothesen wachsen nicht auf Bäumen. Wir müssten uns die Entwicklungskosten ansehen."

# game/scripts/c31/c31.rpy:2647
translate german c31s006_cloneMeeting_09d3f3e7:

    # ama "I don't even know what we have available, apart from [gav]'s arm."
    ama "Ich weiß nicht einmal, was uns zur Verfügung steht, abgesehen von [gav]s Arm."

# game/scripts/c31/c31.rpy:2648
translate german c31s006_cloneMeeting_aa3483b3:

    # mc "I know. But it's the right thing to do. I can't look the other way."
    mc "Ich weiß. Aber es ist das Richtige. Ich kann nicht einfach wegsehen."

# game/scripts/c31/c31.rpy:2649
translate german c31s006_cloneMeeting_8ffdce37:

    # mc "I can't promise it'll be immediate, but it's on my list of real priorities."
    mc "Ich kann nicht versprechen, dass es sofort passiert, aber es steht auf meiner Liste der echten Prioritäten."

# game/scripts/c31/c31.rpy:2650
translate german c31s006_cloneMeeting_97f8a630:

    # mc "I'll talk to Caleb. If he could make the prototype in his free time..."
    mc "Ich werde mit Caleb reden. Wenn er den Prototyp in seiner Freizeit hätte bauen können..."

# game/scripts/c31/c31.rpy:2652
translate german c31s006_cloneMeeting_b503035e:

    # fred "That's good enough for us for now."
    fred "Das reicht uns fürs Erste."

# game/scripts/c31/c31.rpy:2653
translate german c31s006_cloneMeeting_4d7e5b76:

    # gav "Thank you, [mc]. For all of them."
    gav "Danke, [mc]. Für sie alle."

# game/scripts/c31/c31.rpy:2654
translate german c31s006_cloneMeeting_8be5769f:

    # dam "Hey, what if they give me a prosthetic arm even though I have both of mine..."
    dam "Hey, was ist, wenn sie mir eine Armprothese geben, obwohl ich beide Arme noch habe..."

# game/scripts/c31/c31.rpy:2655
translate german c31s006_cloneMeeting_732c07b7:

    # dam "Would I have three arms? Asking for scientific curiosity."
    dam "Hätte ich dann drei Arme? Ich frage nur aus wissenschaftlicher Neugier."

# game/scripts/c31/c31.rpy:2657
translate german c31s006_cloneMeeting_488b001f:

    # carl "[dam]..."
    carl "[dam]..."


# game/scripts/c31/c31.rpy:2658
translate german c31s006_cloneMeeting_7c5120c7:

    # dam "Just kidding. Mostly."
    dam "Nur ein Scherz. Größtenteils."

# game/scripts/c31/c31.rpy:2660
translate german c31s006_cloneMeeting_6b0ae0e2:

    # carl "Fifth request: Salary. The operatives feel that the compensation does not reflect the risk or the nature of their work."
    carl "Fünfte Forderung: Gehalt. Die Agenten haben das Gefühl, dass die Vergütung weder das Risiko noch die Art ihrer Arbeit widerspiegelt."

# game/scripts/c31/c31.rpy:2661
translate german c31s006_cloneMeeting_8f3e2338:

    # "At that moment, you realize what's weird every time [carl] speaks."
    "In diesem Moment wird dir klar, was jedes Mal seltsam ist, wenn [carl] spricht."

# game/scripts/c31/c31.rpy:2662
translate german c31s006_cloneMeeting_7dec5d66:

    # "He never says 'we' or 'the clones'. He always talks about 'the operatives', as if he wants to distance himself emotionally from the requests."
    "Er sagt nie 'wir' oder 'die Klone'. Er spricht immer von 'den Agenten', als wollte er sich emotional von den Forderungen distanzieren."

# game/scripts/c31/c31.rpy:2664
translate german c31s006_cloneMeeting_fd08ef19:

    # fred "We've gone years without any income... Just two things: room and board."
    fred "Wir waren jahrelang ohne jegliches Einkommen... Nur zwei Dinge: Kost und Logis."

# game/scripts/c31/c31.rpy:2665
translate german c31s006_cloneMeeting_51009217:

    # fred "You said we aren't slaves. But that sounds a lot like slavery. Without a salary, we'll remain so."
    fred "Du hast gesagt, wir sind keine Sklaven. Aber das klingt verdammt nach Sklaverei. Ohne Gehalt werden wir das auch bleiben."

# game/scripts/c31/c31.rpy:2666
translate german c31s006_cloneMeeting_f3d381eb:

    # mc "That's a reasonable request. I'm not going to say no."
    mc "Das ist eine vernünftige Forderung. Ich werde nicht nein sagen."

# game/scripts/c31/c31.rpy:2667
translate german c31s006_cloneMeeting_b0308632:

    # mc "But I need to sit down and review the numbers before committing to concrete figures."
    mc "Aber ich muss mich hinsetzen und die Zahlen prüfen, bevor ich mich auf konkrete Zahlen festlege."

# game/scripts/c31/c31.rpy:2669
translate german c31s006_cloneMeeting_96d356a7:

    # ama "NTR's finances aren't at their best after the last few months, [fred]."
    ama "Die Finanzen von NTR sind nach den letzten Monaten nicht gerade in Bestform, [fred]."

# game/scripts/c31/c31.rpy:2670
translate german c31s006_cloneMeeting_6e9d39d7:

    # mc "Even so, this has to change. The company owes it to you."
    mc "Trotzdem muss sich das ändern. Die Firma ist euch das schuldig."

# game/scripts/c31/c31.rpy:2672
translate german c31s006_cloneMeeting_1eb2cb12:

    # gav "No one expects you to solve it today, [mc]."
    gav "Niemand erwartet, dass du das heute löst, [mc]."

# game/scripts/c31/c31.rpy:2673
translate german c31s006_cloneMeeting_8209b7f8:

    # dam "I do, a little."
    dam "Ein bisschen schon."

# game/scripts/c31/c31.rpy:2674
translate german c31s006_cloneMeeting_1758e8bc:

    # fred "[dam]..."
    fred "[dam]..."

# game/scripts/c31/c31.rpy:2675
translate german c31s006_cloneMeeting_dac900f8:

    # dam "I'm kidding. Sort of."
    dam "War nur ein Witz. Mehr oder weniger."

# game/scripts/c31/c31.rpy:2676
translate german c31s006_cloneMeeting_25abb483:

    # dam "But I think a 40%% raise would be good."
    dam "Aber ich denke, 40%% mehr Gehalt wären gut."

# game/scripts/c31/c31.rpy:2678
translate german c31s006_cloneMeeting_885eaeec:

    # gav "You realize that 40%% of zero is still zero, right?"
    gav "Dir ist schon klar, dass 40%% von null immer noch null sind, oder?"

# game/scripts/c31/c31.rpy:2679
translate german c31s006_cloneMeeting_f5cd6f0f:

    # fred "Wasn't there another D that could come to this meeting?"
    fred "Gab es nicht noch einen anderen D, der zu diesem Meeting kommen konnte?"

# game/scripts/c31/c31.rpy:2680
translate german c31s006_cloneMeeting_2ebc5798:

    # carl "The Ds... There's not much to choose from..."
    carl "Die Ds... Da gibt es nicht viel Auswahl..."

# game/scripts/c31/c31.rpy:2681
translate german c31s006_cloneMeeting_6fae1d7d:

    # dam "Hey! We're the best..."
    dam "Hey! Wir sind die Besten..."

# game/scripts/c31/c31.rpy:2682
translate german c31s006_cloneMeeting_df3c1e0f:

    # aar "Yeah, at talking bullshit."
    aar "Ja, im Scheiße labern."

# game/scripts/c31/c31.rpy:2683
translate german c31s006_cloneMeeting_44a5e86c:

    # mc "Be patient. But know that I take it seriously."
    mc "Seid geduldig. Aber wisst, dass ich das ernst nehme."

# game/scripts/c31/c31.rpy:2685
translate german c31s006_cloneMeeting_f017a5ef:

    # dam "Speaking of compensation... I had another request that I don't think made it to the agenda."
    dam "Apropos Vergütung... Ich hatte noch eine andere Bitte, die es wohl nicht auf die Tagesordnung geschafft hat."

# game/scripts/c31/c31.rpy:2686
translate german c31s006_cloneMeeting_7798aff2:

    # dam "What about sports cars? One for each operative. At least for those of us old enough to drive..."
    dam "Wie wäre es mit Sportwagen? Einen für jeden Agenten. Zumindest für diejenigen von uns, die alt genug sind, um zu fahren..."

# game/scripts/c31/c31.rpy:2688
translate german c31s006_cloneMeeting_90cb4332:

    # carl "[dam], we already discussed that in the previous meeting. We ruled it out in the first five minutes."
    carl "[dam], das haben wir schon im letzten Meeting besprochen. Wir haben es in den ersten fünf Minuten ausgeschlossen."

# game/scripts/c31/c31.rpy:2690
translate german c31s006_cloneMeeting_55506672:

    # dam "Yeah, but it seems [mc] is open to things we thought he'd reject. Maybe he sees it differently."
    dam "Ja, aber es scheint, als wäre [mc] offen für Dinge, von denen wir dachten, er würde sie ablehnen. Vielleicht sieht er das anders."

# game/scripts/c31/c31.rpy:2691
translate german c31s006_cloneMeeting_a78db22b:

    # carl "He'll see it the same way we do. It's an absurd request. He's already used the excuse of funds..."
    carl "Er wird es genauso sehen wie wir. Das ist eine absurde Forderung. Er hat bereits die Ausrede mit den Finanzen benutzt..."

# game/scripts/c31/c31.rpy:2692
translate german c31s006_cloneMeeting_4d5c0c4f:

    # dam "It's a legitimate employee wellness request!"
    dam "Das ist eine legitime Forderung für Mitarbeiter-Wellness!"

# game/scripts/c31/c31.rpy:2693
translate german c31s006_cloneMeeting_bd3ad819:

    # carl "A Ferrarini isn't employee wellness, [dam]."
    carl "Ein Ferrarini ist keine Mitarbeiter-Wellness, [dam]."

# game/scripts/c31/c31.rpy:2694
translate german c31s006_cloneMeeting_e4a1a67c:

    # dam "And what do you know? Have you ever tried driving a Ferrarini?"
    dam "Und was weißt du schon? Hast du jemals versucht, einen Ferrarini zu fahren?"

# game/scripts/c31/c31.rpy:2695
translate german c31s006_cloneMeeting_8f6962fb:

    # gav "[dam], please..."
    gav "[dam], bitte..."

# game/scripts/c31/c31.rpy:2696
translate german c31s006_cloneMeeting_9e391f69:

    # mc "I appreciate the enthusiasm, [dam]. But I think we can focus the budget on other things."
    mc "Ich schätze den Enthusiasmus, [dam]. Aber ich denke, wir können das Budget auf andere Dinge konzentrieren."

# game/scripts/c31/c31.rpy:2698
translate german c31s006_cloneMeeting_d8f2cdcc:

    # ama "Much more urgent things."
    ama "Viel dringendere Dinge."

# game/scripts/c31/c31.rpy:2699
translate german c31s006_cloneMeeting_2f9869dc:

    # dam "Fine. But let the record show that I tried."
    dam "Na schön. Aber haltet im Protokoll fest, dass ich es versucht habe."

# game/scripts/c31/c31.rpy:2700
translate german c31s006_cloneMeeting_4ed99d1c:

    # aar "Noted, noted. Don't worry. I'm also going to put on the record that you're an idiot."
    aar "Notiert, notiert. Keine Sorge. Ich werde auch zu Protokoll geben, dass du ein Idiot bist."

# game/scripts/c31/c31.rpy:2702
translate german c31s006_cloneMeeting_ff0bb406:

    # carl "Getting back to the salaries. The request includes that the salary, if approved, be retroactive. Going back several years."
    carl "Zurück zu den Gehältern. Die Forderung beinhaltet, dass das Gehalt, falls es genehmigt wird, rückwirkend gezahlt wird. Mehrere Jahre zurück."

# game/scripts/c31/c31.rpy:2704
translate german c31s006_cloneMeeting_4cf65e13:

    # fred "We've been working for a long time without getting paid what we deserved. It's a real debt. And not just a financial one."
    fred "Wir arbeiten schon lange, ohne das zu bekommen, was wir verdienen. Es ist eine echte Schuld. Und nicht nur eine finanzielle."

# game/scripts/c31/c31.rpy:2705
translate german c31s006_cloneMeeting_c9697095:

    # fred "Starting to pay us now won't fix the historical injustice."
    fred "Jetzt damit anzufangen, uns zu bezahlen, wird die historische Ungerechtigkeit nicht wiedergutmachen."

# game/scripts/c31/c31.rpy:2706
translate german c31s006_cloneMeeting_45c8c975:

    # mc "I understand the logic. And you're right. Morally and legally."
    mc "Ich verstehe die Logik. Und ihr habt recht. Moralisch und rechtlich."

# game/scripts/c31/c31.rpy:2707
translate german c31s006_cloneMeeting_351a5f1f:

    # mc "The problem is that right now there aren't enough funds to cover that amount."
    mc "Das Problem ist, dass im Moment nicht genug Mittel da sind, um diesen Betrag zu decken."

# game/scripts/c31/c31.rpy:2709
translate german c31s006_cloneMeeting_ef2f9cea:

    # gav "How much are we talking about?"
    gav "Über wie viel reden wir hier?"

# game/scripts/c31/c31.rpy:2710
translate german c31s006_cloneMeeting_888f293b:

    # ama "With the accumulated years and the number of operatives, it would be a very substantial amount."
    ama "Mit den angesammelten Jahren und der Anzahl der Agenten wäre es ein sehr beträchtlicher Betrag."

# game/scripts/c31/c31.rpy:2711
translate german c31s006_cloneMeeting_76829767:

    # fred "We know. But that doesn't make the debt disappear."
    fred "Wir wissen das. Aber das lässt die Schulden nicht verschwinden."

# game/scripts/c31/c31.rpy:2712
translate german c31s006_cloneMeeting_d8b6fce0:

    # dam "Of course not. We work. We risk our lives. We deserve recognition."
    dam "Natürlich nicht. Wir arbeiten. Wir riskieren unser Leben. Wir verdienen Anerkennung."

# game/scripts/c31/c31.rpy:2713
translate german c31s006_cloneMeeting_c142e264:

    # mc "You're right. Completely. But if I promise something I can't deliver, I'll be failing you just like the previous management."
    mc "Ihr habt recht. Völlig. Aber wenn ich etwas verspreche, das ich nicht halten kann, lasse ich euch genauso im Stich wie die vorherige Führung."

# game/scripts/c31/c31.rpy:2714
translate german c31s006_cloneMeeting_0582f20e:

    # mc "I need to look into how to compensate you in another way."
    mc "Ich muss herausfinden, wie ich euch auf andere Weise entschädigen kann."

# game/scripts/c31/c31.rpy:2716
translate german c31s006_cloneMeeting_eb822c4e:

    # fred "In what way?"
    fred "Auf welche Weise?"

# game/scripts/c31/c31.rpy:2717
translate german c31s006_cloneMeeting_34d2d78e:

    # mc "I don't know yet. But I'll figure it out. I promise you."
    mc "Das weiß ich noch nicht. Aber ich werde es herausfinden. Das verspreche ich euch."

# game/scripts/c31/c31.rpy:2719
translate german c31s006_cloneMeeting_61d93fdf:

    # carl "With all due respect, [mc], we've heard promises before."
    carl "Bei allem Respekt, [mc], wir haben schon früher Versprechungen gehört."

# game/scripts/c31/c31.rpy:2720
translate german c31s006_cloneMeeting_40646422:

    # mc "I know, [carl]. And I understand that those promises don't mean much to you anymore."
    mc "Ich weiß, [carl]. Und ich verstehe, dass euch diese Versprechungen nicht mehr viel bedeuten."

# game/scripts/c31/c31.rpy:2721
translate german c31s006_cloneMeeting_f351a33a:

    # mc "I can only ask for time and prove it with actions."
    mc "Ich kann nur um Zeit bitten und es durch Taten beweisen."

# game/scripts/c31/c31.rpy:2723
translate german c31s006_cloneMeeting_75deed05:

    # gav "Listen to me for a moment. We've been in this meeting for half an hour."
    gav "Hört mir mal einen Moment zu. Wir sind jetzt seit einer halben Stunde in dieser Besprechung."

# game/scripts/c31/c31.rpy:2724
translate german c31s006_cloneMeeting_a4b4835f:

    # gav "We're talking about the promises that were made to us and weren't kept. And the best of those promises was improving the ranch."
    gav "Wir reden über die Versprechungen, die uns gemacht und nicht gehalten wurden. Und das beste dieser Versprechen war die Verbesserung der Ranch."

# game/scripts/c31/c31.rpy:2726
translate german c31s006_cloneMeeting_270d8286:

    # gav "[mc] said yes to the beards and the time off. He promised to look into Eric's situation, the prosthetics, and the wages."
    gav "[mc] hat den Bärten und der Freizeit zugestimmt. Er hat versprochen, sich um Erics Situation, die Prothesen und die Löhne zu kümmern."

# game/scripts/c31/c31.rpy:2727
translate german c31s006_cloneMeeting_5e468e30:

    # gav "Daniels wouldn't even let us in this room. And Richards, before him, wasn't much better at this."
    gav "Daniels hätte uns nicht einmal in diesen Raum gelassen. Und Richards vor ihm war darin auch nicht viel besser."

# game/scripts/c31/c31.rpy:2728
translate german c31s006_cloneMeeting_8247a637:

    # gav "Let's give him the benefit of the doubt. At least for a while..."
    gav "Geben wir ihm den Vertrauensvorschuss. Zumindest für eine Weile..."

# game/scripts/c31/c31.rpy:2730
translate german c31s006_cloneMeeting_3af2bc72:

    # fred "It's true. You're right."
    fred "Es ist wahr. Du hast recht."

# game/scripts/c31/c31.rpy:2731
translate german c31s006_cloneMeeting_7cf0ccd8:

    # dam "You're getting a new arm and he promised to take you with him to the States. It's normal for you to support him..."
    dam "Du bekommst einen neuen Arm und er hat versprochen, dich mit in die Staaten zu nehmen. Es ist normal, dass du ihn unterstützt..."

# game/scripts/c31/c31.rpy:2732
translate german c31s006_cloneMeeting_3698fcc9:

    # carl "I don't think [gav]'s support has anything to do with that."
    carl "Ich glaube nicht, dass [gav]s Unterstützung etwas damit zu tun hat."

# game/scripts/c31/c31.rpy:2734
translate german c31s006_cloneMeeting_1db3544a:

    # gav "It has nothing to do with that, [dam]. I promise you. I was there when... the Eric thing happened. Daniels would never have acted the way [mc] did."
    gav "Das hat nichts damit zu tun, [dam]. Das verspreche ich dir. Ich war dabei, als... die Sache mit Eric passiert ist. Daniels hätte nie so gehandelt wie [mc]."

# game/scripts/c31/c31.rpy:2735
translate german c31s006_cloneMeeting_6f6ba7bf:

    # gav "He probably would have ordered [ama] and [eva] to execute us all."
    gav "Er hätte [ama] und [eva] wahrscheinlich befohlen, uns alle hinzurichten."

# game/scripts/c31/c31.rpy:2736
translate german c31s006_cloneMeeting_e1f6efbe:

    # mcp "(At that time I didn't even know their names. It wouldn't have occurred to me to order them to do anything.)"
    mcp "(Damals kannte ich nicht einmal ihre Namen. Es wäre mir nicht in den Sinn gekommen, ihnen irgendwelche Befehle zu erteilen.)"

# game/scripts/c31/c31.rpy:2737
translate german c31s006_cloneMeeting_68908b9b:

    # mcp "(And having you killed wouldn't be among the orders I would have given them, if I could have given them any.)"
    mcp "(Und euch töten zu lassen, wäre nicht unter den Befehlen gewesen, die ich ihnen gegeben hätte, wenn ich ihnen überhaupt welche hätte geben können.)"

# game/scripts/c31/c31.rpy:2738
translate german c31s006_cloneMeeting_cf677da0:

    # gav "I'm not saying we should settle for crumbs. But we have to recognize the difference."
    gav "Ich sage nicht, dass wir uns mit Krümeln zufrieden geben sollten. Aber wir müssen den Unterschied erkennen."

# game/scripts/c31/c31.rpy:2739
translate german c31s006_cloneMeeting_d2466246:

    # gav "[mc] is listening. That's already something none of us expected a month ago... Or an hour ago."
    gav "[mc] hört zu. Das ist schon etwas, was keiner von uns vor einem Monat erwartet hätte... Oder vor einer Stunde."

# game/scripts/c31/c31.rpy:2741
translate german c31s006_cloneMeeting_64dd59a0:

    # dam "[gav] is right. And I, being the biggest complainer, admit it."
    dam "[gav] hat recht. Und ich, als der größte Nörgler, gebe es zu."

# game/scripts/c31/c31.rpy:2742
translate german c31s006_cloneMeeting_e3efb808:

    # aar "The kid's got a good head on his shoulders. I mean [gav], not [dam]..."
    aar "Der Junge hat was im Kopf. Ich meine [gav], nicht [dam]..."

# game/scripts/c31/c31.rpy:2743
translate german c31s006_cloneMeeting_38f4ac6a:

    # mc "Thanks, [gav]. That... means a lot."
    mc "Danke, [gav]. Das... bedeutet mir viel."

# game/scripts/c31/c31.rpy:2744
translate german c31s006_cloneMeeting_4ebd9be0:

    # ama "And they aren't just empty promises. [mc] has been working on this for days since he took over."
    ama "Und das sind nicht nur leere Versprechungen. [mc] arbeitet schon seit Tagen daran, seit er übernommen hat."

# game/scripts/c31/c31.rpy:2745
translate german c31s006_cloneMeeting_8d81aa3d:

    # ama "[aar] and I have flooded him with information. Think about it, it can't be easy for him either."
    ama "[aar] und ich haben ihn mit Informationen überflutet. Denkt mal drüber nach, es kann für ihn auch nicht leicht sein."

# game/scripts/c31/c31.rpy:2747
translate german c31s006_cloneMeeting_0ee149c1:

    # carl "I think we're demanding that [mc] take responsibility for the mistakes of the previous management. It's his first day here and so far he's listening to us."
    carl "Ich glaube, wir verlangen, dass [mc] die Verantwortung für die Fehler des vorherigen Managements übernimmt. Es ist sein erster Tag hier und bisher hört er uns zu."

# game/scripts/c31/c31.rpy:2748
translate german c31s006_cloneMeeting_708f9b21:

    # carl "I'm not saying we should give up on our demands, but I think we should give him the benefit of the doubt."
    carl "Ich sage nicht, dass wir unsere Forderungen aufgeben sollten, aber ich denke, wir sollten ihm einen Vertrauensvorschuss geben."

# game/scripts/c31/c31.rpy:2749
translate german c31s006_cloneMeeting_a4ba8285:

    # "Surprisingly, everyone nods. You realize you're starting to like [carl]. And you think he's starting to like you too."
    "Überraschenderweise nicken alle. Du merkst, dass du anfängst, [carl] zu mögen. Und du denkst, er fängt auch an, dich zu mögen."

# game/scripts/c31/c31.rpy:2751
translate german c31s006_cloneMeeting_e1766345:

    # carl "Let's continue, then. The next request is the most important one for many of us."
    carl "Lasst uns dann weitermachen. Die nächste Forderung ist für viele von uns die wichtigste."

# game/scripts/c31/c31.rpy:2752
translate german c31s006_cloneMeeting_260fe742:

    # carl "The operatives want to be able to choose their future. Their position within NTR. And, in the long term, to be able to terminate their contracts if they so decide."
    carl "Die Agenten wollen ihre Zukunft selbst wählen können. Ihre Position innerhalb von NTR. Und langfristig in der Lage sein, ihre Verträge aufzulösen, wenn sie sich dazu entscheiden."

# game/scripts/c31/c31.rpy:2754
translate german c31s006_cloneMeeting_cbc49dee:

    # "The room falls silent for a few seconds. It's the request they're most excited about of all the ones they've made. You can read it on their faces."
    "Der Raum wird für ein paar Sekunden still. Es ist die Forderung, auf die sie von allen gestellten am meisten gespannt sind. Man kann es an ihren Gesichtern ablesen."

# game/scripts/c31/c31.rpy:2755
translate german c31s006_cloneMeeting_3a9dd54b:

    # aar "This is the one that matters most to us. To all of us."
    aar "Das ist die, die uns am wichtigsten ist. Uns allen."

# game/scripts/c31/c31.rpy:2756
translate german c31s006_cloneMeeting_534c6c70:

    # fred "We don't want to be anyone's property. We were already the company's property once, and [aar] told us that it's not going to happen again."
    fred "Wir wollen niemandes Eigentum sein. Wir waren schon einmal das Eigentum der Firma, und [aar] hat uns gesagt, dass das nicht noch einmal passieren wird."

# game/scripts/c31/c31.rpy:2757
translate german c31s006_cloneMeeting_50d8828a:

    # mc "I know."
    mc "Ich weiß."

# game/scripts/c31/c31.rpy:2758
translate german c31s006_cloneMeeting_985d148b:

    # dam "We want to be able to say 'I want to leave' and have it be a real option. Not a sentence."
    dam "Wir wollen in der Lage sein zu sagen 'Ich will gehen' und dass es eine echte Option ist. Keine Strafe."

# game/scripts/c31/c31.rpy:2759
translate german c31s006_cloneMeeting_afd3c51c:

    # gav "Or stay. But let it be our choice."
    gav "Oder bleiben. Aber lasst es unsere Entscheidung sein."

# game/scripts/c31/c31.rpy:2760
translate german c31s006_cloneMeeting_45aef16d:

    # mc "I hear you. And I understand you."
    mc "Ich höre euch. Und ich verstehe euch."

# game/scripts/c31/c31.rpy:2761
translate german c31s006_cloneMeeting_42d9f9ce:

    # mc "Changing positions within the company: we can start structuring that shortly."
    mc "Positionswechsel innerhalb der Firma: Wir können in Kürze anfangen, das zu strukturieren."

# game/scripts/c31/c31.rpy:2762
translate german c31s006_cloneMeeting_417a1c7d:

    # mc "That everyone can apply for different roles, train, grow. Of course. As long as the person is qualified for that role."
    mc "Dass sich jeder für verschiedene Rollen bewerben, trainieren und wachsen kann. Natürlich. Solange die Person für diese Rolle qualifiziert ist."

# game/scripts/c31/c31.rpy:2764
translate german c31s006_cloneMeeting_f83340c0:

    # "None of them can hide their smile... Or their surprise."
    "Keiner von ihnen kann sein Lächeln verbergen... Oder seine Überraschung."

# game/scripts/c31/c31.rpy:2765
translate german c31s006_cloneMeeting_bfe72352:

    # ama "We'll have to create an internal promotion system, but it's viable."
    ama "Wir müssen ein internes Beförderungssystem schaffen, aber es ist machbar."

# game/scripts/c31/c31.rpy:2766
translate german c31s006_cloneMeeting_b4efce6e:

    # mc "As for terminating contracts... that's more complex."
    mc "Was die Kündigung von Verträgen angeht... das ist komplexer."

# game/scripts/c31/c31.rpy:2767
translate german c31s006_cloneMeeting_04621e4a:

    # mc "Not because I don't want to allow it, but because there are legal and security implications regarding your own origins."
    mc "Nicht, weil ich es nicht erlauben will, sondern weil es rechtliche und sicherheitstechnische Implikationen bezüglich eurer eigenen Herkunft gibt."

# game/scripts/c31/c31.rpy:2768
translate german c31s006_cloneMeeting_c60be5bb:

    # mc "You are people. You deserve to choose. But I have to make sure that leaving protects you."
    mc "Ihr seid Menschen. Ihr habt es verdient, selbst zu entscheiden. Aber ich muss sicherstellen, dass ein Weggang euch schützt."

# game/scripts/c31/c31.rpy:2769
translate german c31s006_cloneMeeting_aa2b0b0e:

    # mc "I don't want to sound patronizing, but I also don't want you to leave and have the outside world treat you worse than this place did."
    mc "Ich will nicht herablassend klingen, aber ich will auch nicht, dass ihr geht und die Außenwelt euch schlechter behandelt als dieser Ort hier."

# game/scripts/c31/c31.rpy:2771
translate german c31s006_cloneMeeting_f1fcd014:

    # fred "Is that a 'no'?"
    fred "Ist das ein 'Nein'?"

# game/scripts/c31/c31.rpy:2772
translate german c31s006_cloneMeeting_a81552cd:

    # mc "It's a 'we'll work together on it, so it's a yes in due time. Soon'."
    mc "Es ist ein 'Wir werden gemeinsam daran arbeiten, also ist es zu gegebener Zeit ein Ja. Bald'."

# game/scripts/c31/c31.rpy:2773
translate german c31s006_cloneMeeting_26733e06:

    # aar "I don't think we can expect a more positive answer on this matter."
    aar "Ich glaube nicht, dass wir in dieser Angelegenheit eine positivere Antwort erwarten können."

# game/scripts/c31/c31.rpy:2774
translate german c31s006_cloneMeeting_15a2dd8e:

    # gav "I'm staying. For the record. But I want to know that I could leave if I wanted to."
    gav "Ich bleibe. Nur fürs Protokoll. Aber ich möchte wissen, dass ich gehen könnte, wenn ich wollte."

# game/scripts/c31/c31.rpy:2775
translate german c31s006_cloneMeeting_265ba84f:

    # mc "That's exactly what we're going to guarantee. Not today, but we will."
    mc "Genau das werden wir garantieren. Nicht heute, aber wir werden es tun."

# game/scripts/c31/c31.rpy:2776
translate german c31s006_cloneMeeting_7c3256b6:

    # mc "And I want to work with you so that no one wants to terminate that contract."
    mc "Und ich möchte mit euch zusammenarbeiten, damit niemand diesen Vertrag kündigen will."

# game/scripts/c31/c31.rpy:2778
translate german c31s006_cloneMeeting_cb1f10de:

    # "[carl] has a smile on his face as he begins to speak. You're becoming more and more convinced that he likes what he's hearing in this meeting."
    "[carl] hat ein Lächeln im Gesicht, als er zu sprechen beginnt. Du bist mehr und mehr davon überzeugt, dass ihm gefällt, was er in diesem Meeting hört."

# game/scripts/c31/c31.rpy:2779
translate german c31s006_cloneMeeting_9b6d484d:

    # carl "Last request on the official list. We're requesting documentation with alternative identities."
    carl "Letzte Forderung auf der offiziellen Liste. Wir fordern Dokumente mit alternativen Identitäten."

# game/scripts/c31/c31.rpy:2780
translate german c31s006_cloneMeeting_2a81a620:

    # carl "Passports and other documentation with real names so we can move around the world with some degree of normalcy."
    carl "Reisepässe und andere Papiere mit echten Namen, damit wir uns mit einem gewissen Maß an Normalität in der Welt bewegen können."

# game/scripts/c31/c31.rpy:2781
translate german c31s006_cloneMeeting_2c7ff0f4:

    # mc "That's... illegal. And I wouldn't even know where to start. It's complicated territory..."
    mc "Das ist... illegal. Und ich wüsste nicht einmal, wo ich anfangen soll. Das ist ein kompliziertes Terrain..."

# game/scripts/c31/c31.rpy:2783
translate german c31s006_cloneMeeting_87443324:

    # fred "We're illegal clones of living people, [mc]. We're already in complicated territory."
    fred "Wir sind illegale Klone von lebenden Menschen, [mc]. Wir befinden uns bereits auf kompliziertem Terrain."

# game/scripts/c31/c31.rpy:2784
translate german c31s006_cloneMeeting_6cb0ef94:

    # aar "We don't have recognized identities. We don't exist to the official world."
    aar "Wir haben keine anerkannten Identitäten. Für die offizielle Welt existieren wir nicht."

# game/scripts/c31/c31.rpy:2785
translate german c31s006_cloneMeeting_b6aa904a:

    # gav "We can't take a commercial flight. We can't open a bank account. We can't exist outside these walls without being ghosts."
    gav "Wir können keinen kommerziellen Flug nehmen. Wir können kein Bankkonto eröffnen. Wir können außerhalb dieser Wände nicht existieren, ohne Geister zu sein."

# game/scripts/c31/c31.rpy:2786
translate german c31s006_cloneMeeting_70bd8a87:

    # dam "Or criminals. Even if we haven't done anything."
    dam "Oder Kriminelle. Auch wenn wir nichts getan haben."

# game/scripts/c31/c31.rpy:2789
translate german c31s006_cloneMeeting_fac812b0:

    # ama "They're right, [mc]. Our legal situation is... peculiar."
    ama "Sie haben recht, [mc]. Unsere rechtliche Situation ist... eigenartig."

# game/scripts/c31/c31.rpy:2791
translate german c31s006_cloneMeeting_5aa4184e:

    # ama "They're right, [mc]. Their legal situation is... peculiar."
    ama "Sie haben recht, [mc]. Ihre rechtliche Situation ist... eigenartig."

# game/scripts/c31/c31.rpy:2792
translate german c31s006_cloneMeeting_964a076b:

    # ama "Without that documentation, the promise of being able to leave the company would be an empty promise."
    ama "Ohne diese Papiere wäre das Versprechen, die Firma verlassen zu können, ein leeres Versprechen."

# game/scripts/c31/c31.rpy:2793
translate german c31s006_cloneMeeting_e07341a8:

    # mc "I know. And it's a real problem that needs a real solution."
    mc "Ich weiß. Und es ist ein echtes Problem, das eine echte Lösung braucht."

# game/scripts/c31/c31.rpy:2794
translate german c31s006_cloneMeeting_c41e143f:

    # mc "Alternative documentation isn't something I can approve right now. There's a significant logistical cost. And there are legal risks for NTR."
    mc "Alternative Papiere kann ich im Moment nicht genehmigen. Es gibt erhebliche logistische Kosten. Und es gibt rechtliche Risiken für NTR."

# game/scripts/c31/c31.rpy:2796
translate german c31s006_cloneMeeting_fbbc292e:

    # fred "More risks than the ones we take every day in the field?"
    fred "Mehr Risiken als die, die wir jeden Tag im Einsatz eingehen?"

# game/scripts/c31/c31.rpy:2797
translate german c31s006_cloneMeeting_e0b8fd70:

    # mc "No. You're right, [fred]."
    mc "Nein. Du hast recht, [fred]."

# game/scripts/c31/c31.rpy:2798
translate german c31s006_cloneMeeting_1ac0ae7d:

    # mc "I'm going to look into how much it would cost and how to do it as safely as possible."
    mc "Ich werde mich erkundigen, wie viel es kosten würde und wie man es so sicher wie möglich machen kann."

# game/scripts/c31/c31.rpy:2799
translate german c31s006_cloneMeeting_a7f7fa71:

    # mc "For you guys and for the company. I'm not saying no. I'm saying I need to think about it."
    mc "Für euch und für die Firma. Ich sage nicht nein. Ich sage nur, dass ich darüber nachdenken muss."

# game/scripts/c31/c31.rpy:2800
translate german c31s006_cloneMeeting_1a935044:

    # mc "I guess one of the governments we've worked with could help, but..."
    mc "Ich schätze, eine der Regierungen, mit denen wir zusammengearbeitet haben, könnte helfen, aber..."

# game/scripts/c31/c31.rpy:2802
translate german c31s006_cloneMeeting_bc4cee13:

    # aar "It's more than we expected."
    aar "Das ist mehr, als wir erwartet haben."

# game/scripts/c31/c31.rpy:2803
translate german c31s006_cloneMeeting_92be3381:

    # gav "That works for me."
    gav "Das passt für mich."

# game/scripts/c31/c31.rpy:2804
translate german c31s006_cloneMeeting_896fb231:

    # dam "I want a cool name. Something like... Dan Steel. Dan is dead. I can take his name."
    dam "Ich will einen coolen Namen. So etwas wie... Dan Steel. Dan ist tot. Ich kann seinen Namen annehmen."

# game/scripts/c31/c31.rpy:2806
translate german c31s006_cloneMeeting_d1d35694:

    # carl "[dam], for the love of..."
    carl "[dam], um Himmels willen..."

# game/scripts/c31/c31.rpy:2807
translate german c31s006_cloneMeeting_687be014:

    # dam "It's for the passport! We have to think about it ahead of time!"
    dam "Es ist für den Pass! Wir müssen uns rechtzeitig Gedanken darüber machen!"

# game/scripts/c31/c31.rpy:2808
translate german c31s006_cloneMeeting_c3c3efcd:

    # fred "Sometimes I wonder how he's survived so many missions."
    fred "Manchmal frage ich mich, wie er so viele Missionen überlebt hat."

# game/scripts/c31/c31.rpy:2809
translate german c31s006_cloneMeeting_ba4c8276:

    # dam "Charisma. Pure and simple."
    dam "Charisma. Schlicht und ergreifend."

# game/scripts/c31/c31.rpy:2811
translate german c31s006_cloneMeeting_60ee7b62:

    # "The initial tension has dissipated. The room now has a warmer atmosphere. As if they trust you."
    "Die anfängliche Anspannung hat sich aufgelöst. Der Raum hat jetzt eine wärmere Atmosphäre. Als ob sie dir vertrauen."

# game/scripts/c31/c31.rpy:2812
translate german c31s006_cloneMeeting_132a95ae:

    # "Not because of what [aar] has told them over the last few days, but because of what they've heard come out of your mouth."
    "Nicht wegen dem, was [aar] ihnen in den letzten Tagen erzählt hat, sondern wegen dem, was sie aus deinem Mund gehört haben."

# game/scripts/c31/c31.rpy:2813
translate german c31s006_cloneMeeting_2b614ac8:

    # "You look at everyone present before speaking."
    "Du siehst alle Anwesenden an, bevor du sprichst."

# game/scripts/c31/c31.rpy:2814
translate german c31s006_cloneMeeting_0087789a:

    # mc "Alright. I think, if you have no further requests, we've covered everything on the table."
    mc "Also gut. Ich denke, wenn ihr keine weiteren Anliegen habt, haben wir alles besprochen."

# game/scripts/c31/c31.rpy:2815
translate german c31s006_cloneMeeting_17b74da1:

    # mc "I want you to know that this isn't the last meeting. It's the first."
    mc "Ich möchte, dass ihr wisst, dass dies nicht das letzte Treffen ist. Es ist das erste."

# game/scripts/c31/c31.rpy:2816
translate german c31s006_cloneMeeting_6331ccac:

    # ama "[mc] plans to establish a direct channel so you can submit new requests."
    ama "[mc] plant, einen direkten Kanal einzurichten, damit ihr neue Anfragen einreichen könnt."

# game/scripts/c31/c31.rpy:2817
translate german c31s006_cloneMeeting_3a850659:

    # aar "That... has never existed before."
    aar "Das... gab es noch nie."

# game/scripts/c31/c31.rpy:2818
translate german c31s006_cloneMeeting_b3fbfa36:

    # mc "Well, it exists now. And I want you to use it."
    mc "Tja, jetzt gibt es ihn. Und ich möchte, dass ihr ihn nutzt."

# game/scripts/c31/c31.rpy:2819
translate german c31s006_cloneMeeting_d78b839c:

    # fred "When is the next meeting?"
    fred "Wann ist das nächste Treffen?"

# game/scripts/c31/c31.rpy:2820
translate german c31s006_cloneMeeting_3422f581:

    # mc "In a few weeks. I need time to make progress on the pending issues."
    mc "In ein paar Wochen. Ich brauche Zeit, um bei den anstehenden Angelegenheiten Fortschritte zu machen."

# game/scripts/c31/c31.rpy:2821
translate german c31s006_cloneMeeting_efafc640:

    # mc "I don't want to call a meeting until I have something concrete to offer you. Progress on what you asked for today."
    mc "Ich möchte kein Treffen einberufen, bis ich euch etwas Konkretes anbieten kann. Fortschritte bei dem, worum ihr heute gebeten habt."

# game/scripts/c31/c31.rpy:2822
translate german c31s006_cloneMeeting_a359479c:

    # gav "Sounds good to us."
    gav "Klingt gut für uns."

# game/scripts/c31/c31.rpy:2823
translate german c31s006_cloneMeeting_7fb9b9c6:

    # carl "I'll take note of the agreements reached and the issues pending resolution."
    carl "Ich werde mir die getroffenen Vereinbarungen und die noch offenen Punkte notieren."

# game/scripts/c31/c31.rpy:2824
translate german c31s006_cloneMeeting_8e87bc32:

    # dam "And I'll take note of the cool names in case there are passports."
    dam "Und ich notiere mir die coolen Namen, falls es Pässe gibt."

# game/scripts/c31/c31.rpy:2826
translate german c31s006_cloneMeeting_c9821169_1:

    # aar "[dam]..."
    aar "[dam]..."

# game/scripts/c31/c31.rpy:2827
translate german c31s006_cloneMeeting_e81182d9:

    # dam "*Laugh* I'm doing it for the team!"
    dam "*Lacht* Ich mache das fürs Team!"

# game/scripts/c31/c31.rpy:2828
translate german c31s006_cloneMeeting_e5663045:

    # "Some can't hide their smiles beneath the fuss caused by [dam]'s latest nonsense."
    "Einige können ihr Lächeln über den Aufruhr, den [dam]s neuester Unsinn verursacht, nicht verbergen."

# game/scripts/c31/c31.rpy:2829
translate german c31s006_cloneMeeting_32202f04:

    # "You think it's the first time that room has heard clones laughing."
    "Du denkst, es ist das erste Mal, dass in diesem Raum Klone lachen."

# game/scripts/c31/c31.rpy:2830
translate german c31s006_cloneMeeting_e660ffee:

    # mc "One more thing before you leave."
    mc "Noch eine Sache, bevor ihr geht."

# game/scripts/c31/c31.rpy:2832
translate german c31s006_cloneMeeting_a51d42fd:

    # "You stand up. Everyone looks at you for a moment before you start speaking. You know you have their attention."
    "Du stehst auf. Jeder sieht dich einen Moment lang an, bevor du anfängst zu sprechen. Du weißt, dass du ihre Aufmerksamkeit hast."

# game/scripts/c31/c31.rpy:2833
translate german c31s006_cloneMeeting_9dcc6b4d:

    # mc "I know what you've been through here. What they did to you. What they denied you. Though I'll never fully understand what you went through."
    mc "Ich weiß, was ihr hier durchgemacht habt. Was sie euch angetan haben. Was sie euch verwehrt haben. Auch wenn ich nie ganz verstehen werde, was ihr durchgemacht habt."

# game/scripts/c31/c31.rpy:2834
translate german c31s006_cloneMeeting_e4d2717b:

    # mc "But I can't change the past. All I can do is make sure the future is different."
    mc "Aber ich kann die Vergangenheit nicht ändern. Ich kann nur dafür sorgen, dass die Zukunft anders wird."

# game/scripts/c31/c31.rpy:2835
translate german c31s006_cloneMeeting_0a023c18:

    # mc "Not as a favor. As an obligation. This company owes it to you. I owe it to you."
    mc "Nicht als Gefallen. Als Verpflichtung. Diese Firma ist es euch schuldig. Ich bin es euch schuldig."


# game/scripts/c31/c31.rpy:2837
translate german c31s006_cloneMeeting_2c06cb3d:

    # "No one speaks for a moment as you sit back down. They look at each other before reacting."
    "Niemand spricht für einen Moment, als du dich wieder hinsetzt. Sie sehen sich an, bevor sie reagieren."

# game/scripts/c31/c31.rpy:2838
translate german c31s006_cloneMeeting_c6f6798b:

    # "Despite everything that's been said in the meeting, there's still surprise in their voices when they start speaking."
    "Trotz allem, was in der Besprechung gesagt wurde, schwingt immer noch Überraschung in ihren Stimmen mit, als sie anfangen zu sprechen."

# game/scripts/c31/c31.rpy:2839
translate german c31s006_cloneMeeting_c07c1cd5:

    # fred "It's the first time someone in that position has said something like that."
    fred "Es ist das erste Mal, dass jemand in dieser Position so etwas gesagt hat."

# game/scripts/c31/c31.rpy:2840
translate german c31s006_cloneMeeting_68bc852a:

    # carl "Or that someone in that position even bothers to listen to us."
    carl "Oder dass sich jemand in dieser Position überhaupt die Mühe macht, uns zuzuhören."

# game/scripts/c31/c31.rpy:2841
translate german c31s006_cloneMeeting_bf1248f6:

    # gav "And he means it. You can tell."
    gav "Und er meint es ernst. Das merkt man."

# game/scripts/c31/c31.rpy:2842
translate german c31s006_cloneMeeting_9c08ca87:

    # aar "Thank you, [mc]. On behalf of everyone. Including those who aren't here."
    aar "Danke, [mc]. Im Namen von allen. Einschließlich derer, die nicht hier sind."

# game/scripts/c31/c31.rpy:2843
translate german c31s006_cloneMeeting_6a1067c2:

    # ama "See you in a few weeks, then."
    ama "Wir sehen uns dann in ein paar Wochen."

# game/scripts/c31/c31.rpy:2845
translate german c31s006_cloneMeeting_51527a49:

    # carl "I think this meeting is over. We should leave [mc], [ama], and [aar] to discuss what we've talked about here."
    carl "Ich denke, diese Besprechung ist beendet. Wir sollten [mc], [ama] und [aar] in Ruhe lassen, damit sie besprechen können, worüber wir hier geredet haben."

# game/scripts/c31/c31.rpy:2847
translate german c31s006_cloneMeeting_45cd0cb2:

    # aar "I'm going to start preparing all the necessary documentation so you can make decisions having all the information."
    aar "Ich werde anfangen, alle notwendigen Unterlagen vorzubereiten, damit du Entscheidungen mit allen Informationen treffen kannst."

# game/scripts/c31/c31.rpy:2848
translate german c31s006_cloneMeeting_1f861dbf:

    # mc "All the {b}relevant{/b} information, [aar]. I don't need to know how much shaving cream we're going to save because they can grow a beard now."
    mc "Alle {b}relevanten{/b} Informationen, [aar]. Ich muss nicht wissen, wie viel Rasierschaum wir sparen werden, weil sie sich jetzt einen Bart wachsen lassen können."

# game/scripts/c31/c31.rpy:2850
translate german c31s006_cloneMeeting_7e991351:

    # aar "*Laugh* Am I too thorough in my reports?"
    aar "*Lacht* Bin ich zu gründlich in meinen Berichten?"

# game/scripts/c31/c31.rpy:2851
translate german c31s006_cloneMeeting_ebaf1abf:

    # mc "*Laugh* I wouldn't say that. I don't know what word could be used for 'three orders of magnitude above too thorough'."
    mc "*Lacht* Das würde ich nicht sagen. Ich weiß nicht, welches Wort man für 'drei Größenordnungen über zu gründlich' verwenden könnte."

# game/scripts/c31/c31.rpy:2852
translate german c31s006_cloneMeeting_69379918:

    # aar "*Laugh* Okay. No shaving cream or time we'll save at the barbershop."
    aar "*Lacht* Okay. Kein Rasierschaum oder Zeit, die wir beim Friseur sparen."

# game/scripts/c31/c31.rpy:2854
translate german c31s006_cloneMeeting_2714547c:

    # "The meeting slowly dissolves. The clones leave talking among themselves."
    "Das Treffen löst sich langsam auf. Die Klone gehen und unterhalten sich untereinander."

# game/scripts/c31/c31.rpy:2855
translate german c31s006_cloneMeeting_cd518edd:

    # "For the first time, there's something resembling hope at NTR headquarters. At least among the clones."
    "Zum ersten Mal gibt es so etwas wie Hoffnung im NTR-Hauptquartier. Zumindest unter den Klonen."

# game/scripts/c31/c31.rpy:2856
translate german c31s006_cloneMeeting_7e82245b:

    # dam "I'm already thinking about my sideburns. Maybe they're better than a beard..."
    dam "Ich denke schon über meine Koteletten nach. Vielleicht sind sie besser als ein Bart..."

# game/scripts/c31/c31.rpy:2857
translate german c31s006_cloneMeeting_a7101ebe:

    # gav "[dam], stop it."
    gav "[dam], hör auf damit."

# game/scripts/c31/c31.rpy:2858
translate german c31s006_cloneMeeting_24012bf9:

    # dam "They're a symbol of freedom!"
    dam "Sie sind ein Symbol der Freiheit!"

# game/scripts/c31/c31.rpy:2860
translate german c31s006_cloneMeeting_b391b72f:

    # mc "[ama]..."
    mc "[ama]..."

# game/scripts/c31/c31.rpy:2861
translate german c31s006_cloneMeeting_45b012e8:

    # ama "Yes?"
    ama "Ja?"

# game/scripts/c31/c31.rpy:2862
translate german c31s006_cloneMeeting_3bd14d0a:

    # mc "Do you think we'll do well?"
    mc "Glaubst du, wir werden uns gut schlagen?"

# game/scripts/c31/c31.rpy:2864
translate german c31s006_cloneMeeting_ae2832b2:

    # ama "I think you're already doing well."
    ama "Ich denke, ihr schlagt euch bereits gut."

# game/scripts/c31/c31.rpy:2865
translate german c31s006_cloneMeeting_28818800:

    # "You nod, thoughtful. There's a lot of work ahead. But today, at least, someone listened to the people who have suffered the most at NTR."
    "Du nickst nachdenklich. Es liegt viel Arbeit vor uns. Aber heute hat zumindest jemand den Menschen zugehört, die bei NTR am meisten gelitten haben."

# game/scripts/c31/c31.rpy:4233
translate german c31s006_DanielsFate_5bc3d28a:

    # "The rest of the day flies by."
    "Der Rest des Tages verfliegt."

# game/scripts/c31/c31.rpy:4234
translate german c31s006_DanielsFate_31873a0c:

    # "If the meeting room was oppressive, your office isn't much better. It looks like it's straight out of a 70s movie."
    "Wenn der Besprechungsraum schon beklemmend war, ist dein Büro nicht viel besser. Es sieht aus, als stamme es direkt aus einem 70er-Jahre-Film."

# game/scripts/c31/c31.rpy:4235
translate german c31s006_DanielsFate_ceae195a:

    # "[car] gives you the Employee Handbook. It's a huge book with a bunch of outdated concepts."
    "[car] gibt dir das Mitarbeiterhandbuch. Es ist ein riesiges Buch mit einem Haufen veralteter Konzepte."

# game/scripts/c31/c31.rpy:4236
translate german c31s006_DanielsFate_7ae54631:

    # "There isn't a single mention of clones in it. It's meant for staff in non-operations departments."
    "Klone werden darin nicht ein einziges Mal erwähnt. Es ist für Mitarbeiter in nicht-operativen Abteilungen gedacht."

# game/scripts/c31/c31.rpy:4237
translate german c31s006_DanielsFate_bbb50372:

    # "You leave it in a prominent place on your desk. Another thing for your to-do list."
    "Du legst es an einen gut sichtbaren Platz auf deinem Schreibtisch. Noch etwas für deine To-Do-Liste."

# game/scripts/c31/c31.rpy:4239
translate german c31s006_DanielsFate_4bce495a:

    # "You have a meeting with the head of the IT department, [geo]."
    "Du hast ein Meeting mit dem Leiter der IT-Abteilung, [geo]."

# game/scripts/c31/c31.rpy:4240
translate german c31s006_DanielsFate_81a7ccbb:

    # "He seems like a good guy, although he has a bit of a weird sense of humor, especially regarding his wardrobe choices."
    "Er scheint ein guter Kerl zu sein, obwohl er einen etwas seltsamen Sinn für Humor hat, besonders was seine Kleiderwahl angeht."

# game/scripts/c31/c31.rpy:4241
translate german c31s006_DanielsFate_84a9636e:

    # "The company's management application seems quite operational, although you see possible areas for improvement."
    "Die Management-Anwendung des Unternehmens scheint recht funktionsfähig zu sein, obwohl du mögliche Verbesserungsbereiche siehst."

# game/scripts/c31/c31.rpy:4242
translate german c31s006_DanielsFate_b3e74f2e:

    # "You think that, later on, you'll put [geo] in touch with Jamaal."
    "Du denkst dir, dass du [geo] später mit Jamaal in Kontakt bringen wirst."

# game/scripts/c31/c31.rpy:4243
translate german c31s006_DanielsFate_d187b752:

    # "If your favorite IT guy was able to hack NTR's database, tech security should be increased."
    "Wenn dein Lieblings-IT-Typ in der Lage war, die Datenbank von NTR zu hacken, sollte die technische Sicherheit erhöht werden."

# game/scripts/c31/c31.rpy:4244
translate german c31s006_DanielsFate_1a02dcb5:

    # "He leaves a folder with the IT systems manual on your desk. He also sends you the electronic version by email."
    "Er hinterlässt einen Ordner mit dem Handbuch für die IT-Systeme auf deinem Schreibtisch. Er schickt dir auch die elektronische Version per E-Mail."

# game/scripts/c31/c31.rpy:4247
translate german c31s006_DanielsFate_f5af9d6f:

    # "You receive three visits from [vin] throughout the day."
    "Du erhältst im Laufe des Tages drei Besuche von [vin]."

# game/scripts/c31/c31.rpy:4248
translate german c31s006_DanielsFate_285df287:

    # "He wants meticulous details about the reports you requested."
    "Er will akribische Details zu den Berichten, die du angefordert hast."

# game/scripts/c31/c31.rpy:4249
translate german c31s006_DanielsFate_015e3769:

    # "The only question of interest to you is whether you want the reports on 'Real Accounting' or 'Creative Accounting'."
    "Die einzige Frage, die für dich von Interesse ist, ist, ob du die Berichte über 'Echte Buchhaltung' oder 'Kreative Buchhaltung' haben willst."

# game/scripts/c31/c31.rpy:4250
translate german c31s006_DanielsFate_4cb0d9d4:

    # "You think you're going to hate [vin] and his tiny hands."
    "Du glaubst, du wirst [vin] und seine winzigen Hände hassen."

# game/scripts/c31/c31.rpy:4251
translate german c31s006_DanielsFate_5c08256c:

    # "After his last visit, you've lost track of how many coffees [car] has brought you."
    "Nach seinem letzten Besuch hast du den Überblick verloren, wie viele Kaffees [car] dir gebracht hat."

# game/scripts/c31/c31.rpy:4254
translate german c31s006_DanielsFate_b95aee08:

    # "Late in the afternoon, [aar] shows up at your office. You haven't left it since lunchtime."
    "Am späten Nachmittag taucht [aar] in deinem Büro auf. Du hast es seit der Mittagspause nicht mehr verlassen."

# game/scripts/c31/c31.rpy:4255
translate german c31s006_DanielsFate_fb3be0c9:

    # mc "Can I help you with anything, [aar]?"
    mc "Kann ich dir bei irgendetwas helfen, [aar]?"

# game/scripts/c31/c31.rpy:4256
translate german c31s006_DanielsFate_6729bbf0:

    # aar "I came to talk about Daniels."
    aar "Ich bin gekommen, um über Daniels zu reden."

# game/scripts/c31/c31.rpy:4257
translate german c31s006_DanielsFate_1afe9f90:

    # mc "Tell me."
    mc "Erzähl."

# game/scripts/c31/c31.rpy:4261
translate german c31s006_DanielsFate_e230c02e:

    # aar "You said you wanted to be part of whatever decision was made."
    aar "Du hast gesagt, du willst an jeder Entscheidung beteiligt sein, die getroffen wird."

# game/scripts/c31/c31.rpy:4263
translate german c31s006_DanielsFate_e6eb5187:

    # aar "I know you said you were leaving whatever decision was made in our hands."
    aar "Ich weiß, du hast gesagt, du überlässt uns die Entscheidung, wie auch immer sie ausfällt."

# game/scripts/c31/c31.rpy:4264
translate german c31s006_DanielsFate_30809b45:

    # mc "Is it necessary to do this on my first day here, [aar]? I'm still catching up on a thousand things..."
    mc "Ist es nötig, das an meinem ersten Tag hier zu tun, [aar]? Ich muss noch tausend Dinge aufarbeiten..."

# game/scripts/c31/c31.rpy:4266
translate german c31s006_DanielsFate_9fb22617:

    # aar "I think it'll be better to act as soon as possible... I haven't been able to find out if he still has supporters in the company and..."
    aar "Ich denke, es ist besser, so schnell wie möglich zu handeln... Ich konnte noch nicht herausfinden, ob er noch Unterstützer in der Firma hat und..."

# game/scripts/c31/c31.rpy:4267
translate german c31s006_DanielsFate_9632c43c:

    # mc "And I think we can't do anything until [eva] is here."
    mc "Und ich denke, wir können nichts tun, bis [eva] hier ist."

# game/scripts/c31/c31.rpy:4268
translate german c31s006_DanielsFate_f8fd0e7f:

    # mc "It's not something that can be done over a video call with someone like her."
    mc "Das ist nichts, was man über einen Videoanruf mit jemandem wie ihr klären kann."

# game/scripts/c31/c31.rpy:4270
translate german c31s006_DanielsFate_adbfb54e:

    # aar "What do you mean by 'someone like her'?"
    aar "Was meinst du mit 'jemandem wie ihr'?"

# game/scripts/c31/c31.rpy:4271
translate german c31s006_DanielsFate_7f8f069c:

    # mc "[eva] is impulsive and emotional. She's going to want to be here when the decision is made."
    mc "[eva] ist impulsiv und emotional. Sie wird hier sein wollen, wenn die Entscheidung getroffen wird."

# game/scripts/c31/c31.rpy:4273
translate german c31s006_DanielsFate_a1af67e0:

    # aar "Phew! You scared me for a second."
    aar "Puh! Du hast mich für eine Sekunde erschreckt."

# game/scripts/c31/c31.rpy:4274
translate german c31s006_DanielsFate_322d2ec8:

    # aar "I was starting to think you guys had changed [eva] as much as [ama]."
    aar "Ich dachte schon, ihr hättet [eva] genauso sehr verändert wie [ama]."

# game/scripts/c31/c31.rpy:4275
translate german c31s006_DanielsFate_1bfaba52:

    # mc "Maybe a bit more than her."
    mc "Vielleicht ein bisschen mehr als sie."

# game/scripts/c31/c31.rpy:4276
translate german c31s006_DanielsFate_3dc0f085:

    # mc "Have you noticed she's changed a lot?"
    mc "Ist dir aufgefallen, dass sie sich sehr verändert hat?"

# game/scripts/c31/c31.rpy:4278
translate german c31s006_DanielsFate_267ff005:

    # aar "Yesterday in the hangar... That was a surprise."
    aar "Gestern im Hangar... Das war eine Überraschung."

# game/scripts/c31/c31.rpy:4279
translate german c31s006_DanielsFate_b74dda34:

    # aar "But today I had a really long meeting with her and... She's different."
    aar "Aber heute hatte ich ein wirklich langes Meeting mit ihr und... Sie ist anders."

# game/scripts/c31/c31.rpy:4280
translate german c31s006_DanielsFate_615fa532:

    # mc "What did you notice?"
    mc "Was ist dir aufgefallen?"

# game/scripts/c31/c31.rpy:4282
translate german c31s006_DanielsFate_4cd641e2:

    # aar "She's more... assertive. More self-confident."
    aar "Sie ist... durchsetzungsfähiger. Selbstbewusster."

# game/scripts/c31/c31.rpy:4283
translate german c31s006_DanielsFate_445aac14:

    # aar "Before leaving her with your family, she would have accepted my orders without question. But now..."
    aar "Bevor ich sie bei deiner Familie gelassen habe, hätte sie meine Befehle ohne Frage akzeptiert. Aber jetzt..."

# game/scripts/c31/c31.rpy:4284
translate german c31s006_DanielsFate_351a34ca:

    # "You're not going to correct him to say that it's also [ama]'s family now."
    "Du wirst ihn nicht korrigieren und sagen, dass es jetzt auch [ama]s Familie ist."

# game/scripts/c31/c31.rpy:4285
translate german c31s006_DanielsFate_2b486b52:

    # mc "*Laugh* Did you try to give her orders? You're even more brave than you look."
    mc "*Lacht* Hast du versucht, ihr Befehle zu erteilen? Du bist noch mutiger, als du aussiehst."

# game/scripts/c31/c31.rpy:4286
translate german c31s006_DanielsFate_fc7f2958:

    # mc "She's no longer under your command. You're the head of the Operations Department. She's the head of Security."
    mc "Sie steht nicht mehr unter deinem Kommando. Du bist der Leiter der Operationsabteilung. Sie ist die Leiterin der Sicherheit."

# game/scripts/c31/c31.rpy:4288
translate german c31s006_DanielsFate_faefc4a8:

    # aar "I know, I know. But I expected... I don't know... I guess it's old habits."
    aar "Ich weiß, ich weiß. Aber ich habe erwartet... Ich weiß nicht... Ich schätze, das sind alte Gewohnheiten."

# game/scripts/c31/c31.rpy:4289
translate german c31s006_DanielsFate_e0a2d44b:

    # mc "Everyone changes, [aar]. Some faster than others."
    mc "Jeder verändert sich, [aar]. Manche schneller als andere."

# game/scripts/c31/c31.rpy:4290
translate german c31s006_DanielsFate_935b12ed:

    # mc "And getting back to Daniels... Where is he right now?"
    mc "Und um auf Daniels zurückzukommen... Wo ist er gerade?"

# game/scripts/c31/c31.rpy:4292
translate german c31s006_DanielsFate_224198b2:

    # aar "In a cell, isolated. Guarded by two operatives at all times."
    aar "In einer Zelle, isoliert. Rund um die Uhr von zwei Agenten bewacht."

# game/scripts/c31/c31.rpy:4293
translate german c31s006_DanielsFate_7cea5e69:

    # mc "Are they trustworthy?"
    mc "Sind sie vertrauenswürdig?"

# game/scripts/c31/c31.rpy:4294
translate german c31s006_DanielsFate_1f31b4f0:

    # aar "They do 8-hour shifts, which means there are six operatives involved in his surveillance."
    aar "Sie arbeiten in 8-Stunden-Schichten, was bedeutet, dass sechs Agenten an seiner Überwachung beteiligt sind."

# game/scripts/c31/c31.rpy:4295
translate german c31s006_DanielsFate_7d163951:

    # aar "I think so, they are trustworthy. But..."
    aar "Ich denke schon, sie sind vertrauenswürdig. Aber..."

# game/scripts/c31/c31.rpy:4296
translate german c31s006_DanielsFate_ad3deade:

    # mc "We have to trust our own men, [aar]."
    mc "Wir müssen unseren eigenen Leuten vertrauen, [aar]."

# game/scripts/c31/c31.rpy:4297
translate german c31s006_DanielsFate_68b5d643:

    # mc "If you think we can trust them, we can postpone the decision until [eva] arrives."
    mc "Wenn du denkst, dass wir ihnen vertrauen können, können wir die Entscheidung verschieben, bis [eva] eintrifft."

# game/scripts/c31/c31.rpy:4299
translate german c31s006_DanielsFate_4b956114:

    # aar "You surprise me... You... 'normals'... don't usually trust clones this much."
    aar "Du überraschst mich... Ihr... 'Normalen'... vertraut Klonen normalerweise nicht so sehr."

# game/scripts/c31/c31.rpy:4301
translate german c31s006_DanielsFate_040859a5:

    # mc "I've lived with [ama] and [eva] for three weeks."
    mc "Ich habe drei Wochen lang mit [ama] und [eva] zusammengelebt."

# game/scripts/c31/c31.rpy:4303
translate german c31s006_DanielsFate_e0030a5d:

    # mc "I've lived with [eri], [emm], and [dap] my whole life."
    mc "Ich habe mein ganzes Leben mit [eri], [emm] und [dap] zusammengelebt."

# game/scripts/c31/c31.rpy:4304
translate german c31s006_DanielsFate_3feae8d5:

    # mc "I'd trust them with my life without hesitation. I don't care if they're clones or... 'normals'."
    mc "Ich würde ihnen ohne Zögern mein Leben anvertrauen. Es ist mir egal, ob sie Klone oder... 'Normale' sind."

# game/scripts/c31/c31.rpy:4305
translate german c31s006_DanielsFate_20211331:

    # mc "I think I'm going to hate that word."
    mc "Ich glaube, ich werde dieses Wort hassen."

# game/scripts/c31/c31.rpy:4306
translate german c31s006_DanielsFate_2aebb2ac:

    # mc "They're just as human as me or [mael]. You trust people for who they are. Not for how they were born."
    mc "Sie sind genauso menschlich wie ich oder [mael]. Man vertraut Menschen für das, was sie sind. Nicht dafür, wie sie geboren wurden."

# game/scripts/c31/c31.rpy:4308
translate german c31s006_DanielsFate_56db95f1:

    # aar "I'll say it again. You surprise me."
    aar "Ich sage es noch einmal. Du überraschst mich."

# game/scripts/c31/c31.rpy:4309
translate german c31s006_DanielsFate_c7ee3827:

    # mc "Get ready for more surprises with the Marks, [aar]."
    mc "Mach dich auf weitere Überraschungen mit den Marks gefasst, [aar]."

# game/scripts/c31/c31.rpy:4311
translate german c31s006_DanielsFate_5c27be9e:

    # aar "About that..."
    aar "Was das angeht..."

# game/scripts/c31/c31.rpy:4312
translate german c31s006_DanielsFate_3b916da8:

    # mc "What's up?"
    mc "Was ist los?"

# game/scripts/c31/c31.rpy:4313
translate german c31s006_DanielsFate_82cb7a38:

    # aar "Could you tell [bet] to stop hugging me every time she sees me?"
    aar "Könntest du [bet] sagen, dass sie aufhören soll, mich jedes Mal zu umarmen, wenn sie mich sieht?"

# game/scripts/c31/c31.rpy:4314
translate german c31s006_DanielsFate_e7a4ddae:

    # mc "*Laugh* You're delusional if you think that's gonna happen."
    mc "*Lacht* Du machst dir was vor, wenn du glaubst, dass das passiert."

# game/scripts/c31/c31.rpy:4315
translate german c31s006_DanielsFate_b1e73e56:

    # mc "She's found a new great-nephew. Good luck getting her to stop hugging you."
    mc "Sie hat einen neuen Großneffen gefunden. Viel Glück dabei, sie davon abzuhalten, dich zu umarmen."

# game/scripts/c31/c31.rpy:4317
translate german c31s006_DanielsFate_719b1d35:

    # aar "I had to try..."
    aar "Ich musste es versuchen..."

# game/scripts/c31/c31.rpy:4318
translate german c31s006_DanielsFate_9aeb76ed:

    # mc "It's a losing battle, [aar]. But you can try telling her yourself."
    mc "Es ist ein aussichtsloser Kampf, [aar]. Aber du kannst versuchen, es ihr selbst zu sagen."

# game/scripts/c31/c31.rpy:4320
translate german c31s006_DanielsFate_474f4ce4:

    # aar "What? No! That woman scares me! I'm sure she'd treat me like a kid saying nonsense if I tried."
    aar "Was? Nein! Diese Frau macht mir Angst! Ich bin sicher, sie würde mich wie ein Kind behandeln, das Unsinn redet, wenn ich es versuche."

# game/scripts/c31/c31.rpy:4321
translate german c31s006_DanielsFate_14833ab2:

    # mc "*Laugh* That's probably exactly what she'd do."
    mc "*Lacht* Das ist wahrscheinlich genau das, was sie tun würde."

# game/scripts/c31/c31.rpy:4322
translate german c31s006_DanielsFate_2ce522b5:

    # mc "But you're right. Beneath that sweet old lady exterior, Aunt [bet] is really tough and can be scary."
    mc "Aber du hast recht. Unter dieser Fassade der süßen alten Dame ist Tante [bet] wirklich knallhart und kann furchteinflößend sein."

# game/scripts/c31/c31.rpy:4323
translate german c31s006_DanielsFate_7e5a79df:

    # mc "And she has a sixth sense for picking up on things."
    mc "Und sie hat einen sechsten Sinn dafür, Dinge mitzubekommen."

# game/scripts/c31/c31.rpy:4325
translate german c31s006_DanielsFate_26a131b5:

    # aar "Sixth sense like in 'I see dead people'?"
    aar "Sechster Sinn wie in 'Ich sehe tote Menschen'?"

# game/scripts/c31/c31.rpy:4326
translate german c31s006_DanielsFate_c976430b:

    # mc "*Laugh* No, but she can tell when someone is keeping a secret."
    mc "*Lacht* Nein, aber sie merkt, wenn jemand ein Geheimnis hat."

# game/scripts/c31/c31.rpy:4327
translate german c31s006_DanielsFate_ef9ea1d7:

    # mc "If she finds out you're afraid of her, you're a goner."
    mc "Wenn sie herausfindet, dass du Angst vor ihr hast, bist du geliefert."

# game/scripts/c31/c31.rpy:4329
translate german c31s006_DanielsFate_b3729bea:

    # aar "*Laugh* My fear level went up a couple of notches just now."
    aar "*Lacht* Mein Angstlevel ist gerade ein paar Stufen gestiegen."

# game/scripts/c31/c31.rpy:4330
translate german c31s006_DanielsFate_8edf7e93:

    # aar "See you tomorrow?"
    aar "Sehen wir uns morgen?"

# game/scripts/c31/c31.rpy:4331
translate german c31s006_DanielsFate_1035461a:

    # mc "Yeah, of course."
    mc "Ja, natürlich."

# game/scripts/c31/c31.rpy:4333
translate german c31s006_DanielsFate_e91e60c1:

    # "Half an hour after [aar] left..."
    "Eine halbe Stunde nachdem [aar] gegangen war..."

# game/scripts/c31/c31.rpy:4334
translate german c31s006_DanielsFate_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c31/c31.rpy:4335
translate german c31s006_DanielsFate_2a46e597:

    # car "*Through the door* May I come in, Sir?"
    car "*Durch die Tür* Darf ich reinkommen, Sir?"

# game/scripts/c31/c31.rpy:4336
translate german c31s006_DanielsFate_75e013e9:

    # mc "Come in, [car]."
    mc "Komm rein, [car]."

# game/scripts/c31/c31.rpy:4338
translate german c31s006_DanielsFate_0e603514:

    # car "I came to tell you that I'm going home."
    car "Ich wollte Ihnen nur sagen, dass ich nach Hause gehe."

# game/scripts/c31/c31.rpy:4339
translate german c31s006_DanielsFate_db660419:

    # mc "Perfect, [car], and thank you. See you on Monday."
    mc "Perfekt, [car], und danke. Wir sehen uns am Montag."

# game/scripts/c31/c31.rpy:4341
translate german c31s006_DanielsFate_b6221dd6:

    # car "Monday? Aren't you coming in tomorrow?"
    car "Montag? Kommen Sie morgen nicht rein?"

# game/scripts/c31/c31.rpy:4342
translate german c31s006_DanielsFate_bfc9ec9e:

    # mc "It's Saturday... Do you work on Saturdays?"
    mc "Es ist Samstag... Arbeitest du samstags?"

# game/scripts/c31/c31.rpy:4344
translate german c31s006_DanielsFate_83d0ff1c:

    # car "Almost all the staff works on Saturdays, Sir. The Company is open 365 days a year."
    car "Fast das gesamte Personal arbeitet samstags, Sir. Die Firma hat 365 Tage im Jahr geöffnet."

# game/scripts/c31/c31.rpy:4345
translate german c31s006_DanielsFate_5ad60fc8:

    # mc "How many days off do you get a week?"
    mc "Wie viele freie Tage hast du pro Woche?"

# game/scripts/c31/c31.rpy:4346
translate german c31s006_DanielsFate_312573f0:

    # car "Sundays and Mondays. On Sunday you'll meet [lar], the girl who covers for me when I have my days off."
    car "Sonntags und montags. Am Sonntag werden Sie [lar] kennenlernen, das Mädchen, das für mich einspringt, wenn ich frei habe."

# game/scripts/c31/c31.rpy:4347
translate german c31s006_DanielsFate_24d33c21:

    # car "Well, that's if you come to work on Sunday... It was Mr. Daniels' day off."
    car "Nun, das heißt, wenn Sie am Sonntag zur Arbeit kommen... Das war Mr. Daniels' freier Tag."

# game/scripts/c31/c31.rpy:4348
translate german c31s006_DanielsFate_f02e70cd:

    # mc "Yes, I'll come. At least this Sunday. It's [gav]'s surgery, and I want to be here."
    mc "Ja, ich werde kommen. Zumindest diesen Sonntag. Es ist [gav]s Operation, und ich möchte hier sein."

# game/scripts/c31/c31.rpy:4350
translate german c31s006_DanielsFate_48081ed2:

    # car "You are... different."
    car "Du bist... anders."

# game/scripts/c31/c31.rpy:4351
translate german c31s006_DanielsFate_9267f44a:

    # mc "If you mean different from Daniels, I'll take that as a compliment."
    mc "Wenn du meinst, anders als Daniels, nehme ich das als Kompliment."

# game/scripts/c31/c31.rpy:4353
translate german c31s006_DanielsFate_f95f1c9e:

    # car "Ms. [ama] told me she is waiting for you in the parking lot."
    car "Ms. [ama] sagte mir, dass sie auf dem Parkplatz auf dich wartet."

# game/scripts/c31/c31.rpy:4355
translate german c31s006_DanielsFate_8b0ed010:

    # "After that, she disappears without saying anything else."
    "Danach verschwindet sie, ohne noch etwas zu sagen."

# game/scripts/c31/c31.rpy:4357
translate german c31s006_DanielsFate_442334d0:

    # "When you get home, you have dinner with [bet] and [ama]."
    "Als du nach Hause kommst, isst du mit [bet] und [ama] zu Abend."

# game/scripts/c31/c31.rpy:4358
translate german c31s006_DanielsFate_bfdd6feb:

    # "Someone took care of sending catering to the house, which arrives 20 minutes after you do."
    "Jemand hat dafür gesorgt, dass ein Catering ins Haus geschickt wird, das 20 Minuten nach dir ankommt."

# game/scripts/c31/c31.rpy:4359
translate german c31s006_DanielsFate_8b9dbb6e:

    # "They hit the mark with your favorite dishes, although [bet] complains about the size of the pizza."
    "Sie haben mit deinen Lieblingsgerichten ins Schwarze getroffen, obwohl [bet] sich über die Größe der Pizza beschwert."

# game/scripts/c31/c31.rpy:4360
translate german c31s006_DanielsFate_73dd2286:

    # "No one complains about the desserts being too plentiful."
    "Niemand beschwert sich darüber, dass die Desserts zu reichlich sind."

# game/scripts/c31/c31.rpy:4361
translate german c31s006_DanielsFate_3ea72f07:

    # "You have to thank [car]."
    "Da musst du dich bei [car] bedanken."

# game/scripts/c31/c31.rpy:4362
translate german c31s006_DanielsFate_3b458c9c:

    # "You tell each other how your first and exhausting day at NTR went."
    "Ihr erzählt euch gegenseitig, wie euer erster und anstrengender Tag bei NTR gelaufen ist."

# game/scripts/c31/c31.rpy:4363
translate german c31s006_DanielsFate_1b388b6e:

    # "There are laughs and surprised comments. It was less tough for [ama] than she thought."
    "Es wird gelacht und es gibt überraschte Kommentare. Für [ama] war es weniger hart, als sie dachte."

# game/scripts/c31/c31.rpy:4365
translate german c31s006_DanielsFate_e4eddf89:

    # "You fall into bed exhausted once again."
    "Du fällst mal wieder erschöpft ins Bett."

# game/scripts/c31/c31.rpy:4366
translate german c31s006_DanielsFate_f7b1ca57:

    # "[ama] goes back to sleep in your bed. It's been a long day for her too."
    "[ama] schläft wieder in deinem Bett ein. Es war auch für sie ein langer Tag."

# game/scripts/c31/c31.rpy:4372
translate german c31s007_AmaTour_d6d5fd1a:

    # centered "{size=+20}{b}DAY 40 – SATURDAY{/b}{/size}"
    centered "{size=+20}{b}TAG 40 – SAMSTAG{/b}{/size}"

# game/scripts/c31/c31.rpy:4374
translate german c31s007_AmaTour_aea2d136:

    # "Your second morning as CEO follows the same pattern as the afternoon of the first."
    "Dein zweiter Morgen als CEO verläuft nach dem gleichen Muster wie der Nachmittag des ersten."

# game/scripts/c31/c31.rpy:4375
translate german c31s007_AmaTour_163c1808:

    # "The occasional visitor leaving a folder on your desk."
    "Gelegentlich kommt ein Besucher und legt eine Mappe auf deinen Schreibtisch."

# game/scripts/c31/c31.rpy:4376
translate german c31s007_AmaTour_64ffe962:

    # "If there are no visitors, it's [car] who hands you a new folder."
    "Wenn es keine Besucher gibt, ist es [car], die dir eine neue Mappe überreicht."

# game/scripts/c31/c31.rpy:4378
translate german c31s007_AmaTour_bafbf60f:

    # "After the last folder before lunchtime..."
    "Nach der letzten Mappe vor der Mittagspause..."

# game/scripts/c31/c31.rpy:4379
translate german c31s007_AmaTour_5c69a606:

    # mc "[car], one moment, please."
    mc "[car], einen Moment, bitte."

# game/scripts/c31/c31.rpy:4380
translate german c31s007_AmaTour_7a61fa95:

    # car "Yes, Sir?"
    car "Ja, Sir?"

# game/scripts/c31/c31.rpy:4381
translate german c31s007_AmaTour_87c206c0:

    # mc "Is there any reason why you're bringing me all the documentation on paper?"
    mc "Gibt es einen Grund, warum du mir die ganzen Unterlagen auf Papier bringst?"

# game/scripts/c31/c31.rpy:4382
translate german c31s007_AmaTour_2d96cacb:

    # mc "The only email I've received with documentation was from [geo]."
    mc "Die einzige E-Mail mit Unterlagen, die ich erhalten habe, war von [geo]."

# game/scripts/c31/c31.rpy:4384
translate german c31s007_AmaTour_12e83ca4:

    # car "Mr. Daniels liked printed documentation. That's why he has so many filing cabinets here."
    car "Mr. Daniels mochte gedruckte Unterlagen. Deshalb hat er hier so viele Aktenschränke."

# game/scripts/c31/c31.rpy:4385
translate german c31s007_AmaTour_465d1089:

    # mc "I feel... buried under all these folders and dossiers."
    mc "Ich fühle mich... begraben unter all diesen Ordnern und Dossiers."

# game/scripts/c31/c31.rpy:4387
translate german c31s007_AmaTour_0979b03b:

    # car "So... I don't need to print out your emails or attachments anymore?"
    car "Also... muss ich Ihre E-Mails oder Anhänge nicht mehr ausdrucken?"

# game/scripts/c31/c31.rpy:4388
translate german c31s007_AmaTour_3ca00806:

    # mc "I think you can just forward me whatever you think I should read."
    mc "Ich denke, Sie können mir einfach alles weiterleiten, was ich Ihrer Meinung nach lesen sollte."

# game/scripts/c31/c31.rpy:4389
translate german c31s007_AmaTour_9d943355:

    # mc "And printing an email? Never, please. It'll be easier for me to find them on my laptop than in the filing cabinets."
    mc "Und eine E-Mail ausdrucken? Bitte niemals. Es ist für mich einfacher, sie auf meinem Laptop zu finden als in den Aktenschränken."

# game/scripts/c31/c31.rpy:4391
translate german c31s007_AmaTour_272c00ba:

    # car "Understood, Sir."
    car "Verstanden, Sir."

# game/scripts/c31/c31.rpy:4392
translate german c31s007_AmaTour_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c31/c31.rpy:4393
translate german c31s007_AmaTour_154a2f8b:

    # car "At this rate, I wouldn't be able to see you over the folders."
    car "Wenn das so weitergeht, könnte ich Sie vor lauter Ordnern gar nicht mehr sehen."

# game/scripts/c31/c31.rpy:4394
translate german c31s007_AmaTour_f1c6d19f:

    # car "I'll let [lar] know not to print your messages."
    car "Ich werde [lar] Bescheid geben, dass sie Ihre Nachrichten nicht ausdrucken soll."

# game/scripts/c31/c31.rpy:4395
translate german c31s007_AmaTour_da378e55:

    # mc "Thanks, [car]."
    mc "Danke, [car]."

# game/scripts/c31/c31.rpy:4398
translate german c31s007_AmaTour_0c2f92fb:

    # "A few minutes later, [ama] walks in without knocking, holding a bag."
    "Ein paar Minuten später kommt [ama] ohne anzuklopfen herein und hält eine Tasche in der Hand."

# game/scripts/c31/c31.rpy:4399
translate german c31s007_AmaTour_729887b3:

    # ama "I need to get out of here."
    ama "Ich muss hier raus."

# game/scripts/c31/c31.rpy:4400
translate german c31s007_AmaTour_5d36d0c4:

    # mc "What's up? You told me you'd show me the training facilities today."
    mc "Was ist los? Du hast gesagt, du zeigst mir heute die Trainingseinrichtungen."

# game/scripts/c31/c31.rpy:4401
translate german c31s007_AmaTour_b38e7d1d:

    # mc "But I've had a... complicated day."
    mc "Aber ich hatte einen... komplizierten Tag."

# game/scripts/c31/c31.rpy:4403
translate german c31s007_AmaTour_8c64f585:

    # ama "Today is going to be impossible."
    ama "Heute wird das unmöglich."

# game/scripts/c31/c31.rpy:4404
translate german c31s007_AmaTour_22da587c:

    # ama "Word got out that we were going to create a surveillance team for Newport."
    ama "Es hat sich herumgesprochen, dass wir ein Überwachungsteam für Newport aufstellen."

# game/scripts/c31/c31.rpy:4405
translate german c31s007_AmaTour_cabb2e9e:

    # ama "I have over 90 applications to join. And I have to interview them all!"
    ama "Ich habe über 90 Bewerbungen. Und ich muss sie alle interviewen!"

# game/scripts/c31/c31.rpy:4406
translate german c31s007_AmaTour_0c1a63ae:

    # mc "I don't know how it could have leaked. We haven't made it public yet."
    mc "Ich weiß nicht, wie das durchsickern konnte. Wir haben es noch nicht öffentlich gemacht."

# game/scripts/c31/c31.rpy:4408
translate german c31s007_AmaTour_bfa06431:

    # ama "[dam]. His application was the first one. I told you we'd have to run him over."
    ama "[dam]. Seine Bewerbung war die erste. Ich hab dir gesagt, wir müssen ihn überfahren."

# game/scripts/c31/c31.rpy:4409
translate german c31s007_AmaTour_877bd78e:

    # mc "*Laugh* I felt like doing that yesterday. Taking the Not-Tank and running him over."
    mc "*Lacht* Danach war mir gestern auch. Den Nicht-Panzer nehmen und ihn überfahren."

# game/scripts/c31/c31.rpy:4411
translate german c31s007_AmaTour_7086b554:

    # ama "*Laugh* IFV. If you're going to run this, you have to learn the names of the vehicles and devices."
    ama "*Lacht* Schützenpanzer. Wenn du den Laden hier leiten willst, musst du die Namen der Fahrzeuge und Geräte lernen."

# game/scripts/c31/c31.rpy:4412
translate german c31s007_AmaTour_41d5fd3d:

    # mc "Somewhere among these folders is an inventory of everything we have. With pictures for dummies like me."
    mc "Irgendwo in diesen Ordnern ist ein Inventar von allem, was wir haben. Mit Bildern für Dummköpfe wie mich."

# game/scripts/c31/c31.rpy:4413
translate german c31s007_AmaTour_89ff149b:

    # mc "Someone thought it was a good idea to send it to me."
    mc "Jemand hielt es für eine gute Idee, es mir zu schicken."

# game/scripts/c31/c31.rpy:4415
translate german c31s007_AmaTour_fe3cc708:

    # ama "*Laugh* [aar]. And you can't run him over."
    ama "*Lacht* [aar]. Und du kannst ihn nicht überfahren."

# game/scripts/c31/c31.rpy:4416
translate german c31s007_AmaTour_53e3513d:

    # mc "*Laugh* That's the downside of him also being a shareholder."
    mc "*Lacht* Das ist der Nachteil daran, dass er auch Aktionär ist."

# game/scripts/c31/c31.rpy:4417
translate german c31s007_AmaTour_a961595d:

    # mc "But you told me you wanted to get out of here. Are you done with the interviews?"
    mc "Aber du hast mir gesagt, du willst hier raus. Bist du fertig mit den Interviews?"

# game/scripts/c31/c31.rpy:4419
translate german c31s007_AmaTour_cf83b6aa:

    # ama "No, but I have an hour and a half free for lunch. I want to show you something at the training ground."
    ama "Nein, aber ich habe anderthalb Stunden frei fürs Mittagessen. Ich will dir etwas auf dem Trainingsgelände zeigen."

# game/scripts/c31/c31.rpy:4420
translate german c31s007_AmaTour_127b916c:

    # ama "It's not going to be a sightseeing tour, but there's something I want you to see."
    ama "Es wird keine Sightseeing-Tour, aber es gibt etwas, das du sehen sollst."

# game/scripts/c31/c31.rpy:4421
translate german c31s007_AmaTour_3c59e95c:

    # mc "Is that why you're dressed like that instead of wearing a suit?"
    mc "Bist du deshalb so angezogen, anstatt einen Anzug zu tragen?"

# game/scripts/c31/c31.rpy:4423
translate german c31s007_AmaTour_83feee36:

    # ama "Yes, and there are clothes in the bag for you to change into as well."
    ama "Ja, und in der Tasche sind auch Klamotten für dich zum Umziehen."

# game/scripts/c31/c31.rpy:4424
translate german c31s007_AmaTour_09bd4eb0:

    # mc "I'm on it. Can you let [car] know that I'll be out for an hour and a half?"
    mc "Bin schon dabei. Kannst du [car] Bescheid sagen, dass ich für anderthalb Stunden weg bin?"

# game/scripts/c31/c31.rpy:4425
translate german c31s007_AmaTour_0a844e08:

    # mc "I don't have anything on my schedule, but..."
    mc "Ich habe zwar nichts auf meinem Terminplan, aber..."

# game/scripts/c31/c31.rpy:4426
translate german c31s007_AmaTour_b8895caf:

    # ama "I'm on it. Don't take too long."
    ama "Mache ich. Lass dir nicht zu viel Zeit."

# game/scripts/c31/c31.rpy:4427
translate german c31s007_AmaTour_ab9274b5:

    # mc "Five minutes. Five actual minutes."
    mc "Fünf Minuten. Fünf echte Minuten."

# game/scripts/c31/c31.rpy:4430
translate german c31s007_AmaTour_09f25124:

    # "It takes you four minutes. And four minutes later, you're in a military car on your way to the training camp."
    "Du brauchst vier Minuten. Und vier Minuten später sitzt du in einem Militärfahrzeug auf dem Weg zum Trainingslager."

# game/scripts/c31/c31.rpy:4431
translate german c31s007_AmaTour_11209234:

    # mc "What do you want to show me?"
    mc "Was willst du mir zeigen?"

# game/scripts/c31/c31.rpy:4432
translate german c31s007_AmaTour_9aea9237:

    # ama "Do you remember the day your bed broke?"
    ama "Erinnerst du dich an den Tag, an dem dein Bett kaputt ging?"

# game/scripts/c31/c31.rpy:4433
translate german c31s007_AmaTour_c587b003:

    # mc "Yeah, the day Zeus broke my bed."
    mc "Ja, der Tag, an dem Zeus mein Bett kaputt gemacht hat."

# game/scripts/c31/c31.rpy:4435
translate german c31s007_AmaTour_ff7a6680:

    # ama "I told you I'd show you my most prized possessions. I can't wait to show it to you anymore."
    ama "Ich habe dir gesagt, dass ich dir meine wertvollsten Besitztümer zeigen würde. Ich kann es nicht mehr abwarten, sie dir zu zeigen."

# game/scripts/c31/c31.rpy:4436
translate german c31s007_AmaTour_dcb682b5:

    # mc "You also told me you hoped I wouldn't consider you a psychopath."
    mc "Du hast mir auch gesagt, du hoffst, ich würde dich nicht für eine Psychopathin halten."

# game/scripts/c31/c31.rpy:4438
translate german c31s007_AmaTour_75a7f326:

    # ama "Well, my most prized possessions are next to... other things."
    ama "Nun, meine wertvollsten Besitztümer liegen neben... anderen Dingen."

# game/scripts/c31/c31.rpy:4440
translate german c31s007_AmaTour_299c84a1:

    # mc "Let's see what dark secrets my wife is hiding. I won't stop loving you because of it."
    mc "Mal sehen, welche dunklen Geheimnisse meine Frau verbirgt. Ich werde nicht aufhören, dich deswegen zu lieben."

# game/scripts/c31/c31.rpy:4442
translate german c31s007_AmaTour_d8a39aca:

    # mc "Let's see what dark secrets you're hiding. I won't stop loving you because of it."
    mc "Mal sehen, welche dunklen Geheimnisse du verbirgst. Ich werde nicht aufhören, dich deswegen zu lieben."

# game/scripts/c31/c31.rpy:4444
translate german c31s007_AmaTour_937ccf9d:

    # ama "*Laugh* I hope so. Don't expect me to keep the severed ears of everyone I've killed, either."
    ama "*Lacht* Das hoffe ich. Erwarte aber nicht, dass ich die abgetrennten Ohren von jedem aufbewahre, den ich getötet habe."

# game/scripts/c31/c31.rpy:4445
translate german c31s007_AmaTour_480f108c:

    # "The casual way she says it, between laughter, sends a shiver down your spine."
    "Die beiläufige Art, wie sie das zwischen dem Lachen sagt, jagt dir einen Schauer über den Rücken."

# game/scripts/c31/c31.rpy:4446
translate german c31s007_AmaTour_8d66038f:

    # "You will never be able to fully understand the blonde mercenary or her redheaded sister. That makes you feel a bit sad."
    "Du wirst die blonde Söldnerin oder ihre rothaarige Schwester nie ganz verstehen können. Das macht dich ein bisschen traurig."

# game/scripts/c31/c31.rpy:4447
translate german c31s007_AmaTour_5a740667:

    # "You decide to continue the conversation as if she were joking."
    "Du beschließt, das Gespräch fortzusetzen, als würde sie einen Witz machen."

# game/scripts/c31/c31.rpy:4448
translate german c31s007_AmaTour_e4406e69:

    # mc "*Fake laugh* At least a few teeth?"
    mc "*Gespieltes Lachen* Wenigstens ein paar Zähne?"

# game/scripts/c31/c31.rpy:4450
translate german c31s007_AmaTour_b982ed32:

    # ama "Movies lie about that. It's harder than it looks to pull a tooth. And it takes time that we usually don't have."
    ama "Filme lügen, was das angeht. Es ist schwerer als es aussieht, einen Zahn zu ziehen. Und es kostet Zeit, die wir normalerweise nicht haben."

# game/scripts/c31/c31.rpy:4451
translate german c31s007_AmaTour_33ef7237:

    # ama "Besides, it would be pretty disgusting to have a collection of teeth."
    ama "Außerdem wäre es ziemlich eklig, eine Sammlung von Zähnen zu haben."

# game/scripts/c31/c31.rpy:4452
translate german c31s007_AmaTour_acec8169:

    # mc "I totally agree."
    mc "Da stimme ich dir voll und ganz zu."

# game/scripts/c31/c31.rpy:4453
translate german c31s007_AmaTour_14e552be:

    # "You figure that, if she knows how long it takes to pull a tooth... You'd rather not ask."
    "Du denkst dir, wenn sie weiß, wie lange es dauert, einen Zahn zu ziehen... fragst du lieber nicht."

# game/scripts/c31/c31.rpy:4455
translate german c31s007_AmaTour_c0ed0383:

    # "You continue on your way for a few more minutes before [ama] stops the car."
    "Ihr fahrt noch ein paar Minuten weiter, bevor [ama] das Auto anhält."

# game/scripts/c31/c31.rpy:4456
translate german c31s007_AmaTour_74cd2940:

    # "You aren't following any path or road that you can see, but [ama] seems very sure of where she's driving."
    "Ihr folgt keinem Weg oder einer Straße, die du sehen kannst, aber [ama] scheint sich sehr sicher zu sein, wohin sie fährt."

# game/scripts/c31/c31.rpy:4459
translate german c31s007_AmaTour_ce0696f3:

    # "You stop next to a barbed wire fence."
    "Ihr haltet neben einem Stacheldrahtzaun."

# game/scripts/c31/c31.rpy:4460
translate german c31s007_AmaTour_b9e2c68b:

    # ama "Here we are. You can get out of the car now."
    ama "Da wären wir. Du kannst jetzt aus dem Auto aussteigen."

# game/scripts/c31/c31.rpy:4461
translate german c31s007_AmaTour_1de52e47:

    # mc "This isn't the training camp."
    mc "Das ist nicht das Trainingslager."

# game/scripts/c31/c31.rpy:4463
translate german c31s007_AmaTour_0c5e41c9:

    # ama "*Laugh* Do you want a prize for your observation skills?"
    ama "*Lacht* Willst du einen Preis für deine Beobachtungsgabe?"

# game/scripts/c31/c31.rpy:4464
translate german c31s007_AmaTour_6c2f2ec1:

    # ama "The training camp starts on the other side of the fence."
    ama "Das Trainingslager beginnt auf der anderen Seite des Zauns."

# game/scripts/c31/c31.rpy:4465
translate german c31s007_AmaTour_a2ac8600:

    # mc "Can we jump it?"
    mc "Können wir drüberspringen?"

# game/scripts/c31/c31.rpy:4467
translate german c31s007_AmaTour_c134d120:

    # ama "No need. We'll go under it."
    ama "Nicht nötig. Wir gehen untendurch."

# game/scripts/c31/c31.rpy:4468
translate german c31s007_AmaTour_08aa36f9:

    # mc "Lead the way."
    mc "Geh vor."

# game/scripts/c31/c31.rpy:4470
translate german c31s007_AmaTour_df1542f1:

    # "You walk about a hundred and fifty steps among small gullies created by rainwater runoff."
    "Du gehst etwa hundertfünfzig Schritte zwischen kleinen Rinnen, die durch abfließendes Regenwasser entstanden sind."

# game/scripts/c31/c31.rpy:4471
translate german c31s007_AmaTour_42ad5c91:

    # "You use one of those gullies to pass under the fence."
    "Du nutzt eine dieser Rinnen, um unter dem Zaun durchzugehen."

# game/scripts/c31/c31.rpy:4472
translate german c31s007_AmaTour_32ba3773:

    # "You only need to crouch. No crawling. You make a mental note that something needs to be done about the gullies."
    "Du musst dich nur ducken. Kein Kriechen. Du machst dir eine geistige Notiz, dass etwas gegen die Rinnen unternommen werden muss."

# game/scripts/c31/c31.rpy:4473
translate german c31s007_AmaTour_d52f7618:

    # "You walk about fifty more steps after crossing the fence."
    "Nachdem du den Zaun passiert hast, gehst du noch etwa fünfzig Schritte weiter."

# game/scripts/c31/c31.rpy:4476
translate german c31s007_AmaTour_db9b9307:

    # ama "Here it is."
    ama "Hier ist es."

# game/scripts/c31/c31.rpy:4477
translate german c31s007_AmaTour_5f4607c0:

    # mc "Here? But there's nothing here."
    mc "Hier? Aber hier ist doch gar nichts."

# game/scripts/c31/c31.rpy:4478
translate german c31s007_AmaTour_10a95077:

    # mc "It's exactly the same as thirty meters back there. I think I've seen that rock three times today."
    mc "Es sieht genauso aus wie dreißig Meter weiter hinten. Ich glaube, ich habe diesen Stein heute schon dreimal gesehen."

# game/scripts/c31/c31.rpy:4480
translate german c31s007_AmaTour_5967a00a:

    # "[ama] surprises you by dropping to the ground."
    "[ama] überrascht dich, indem sie sich auf den Boden fallen lässt."

# game/scripts/c31/c31.rpy:4481
translate german c31s007_AmaTour_690646ab:

    # ama "Except for this burrow... Just a moment... I almost have it."
    ama "Bis auf dieses Erdloch... Einen Moment... Ich hab's gleich."

# game/scripts/c31/c31.rpy:4482
translate german c31s007_AmaTour_4ec5b0f7:

    # ama "It has rained quite a bit since the last time I was here, and there's more dirt than I expected."
    ama "Es hat ziemlich viel geregnet, seit ich das letzte Mal hier war, und hier ist mehr Dreck, als ich erwartet habe."

# game/scripts/c31/c31.rpy:4484
translate german c31s007_AmaTour_7bbd55c5:

    # "After a while, [ama] pulls out a pretty dirty waterproof bag."
    "Nach einer Weile zieht [ama] eine ziemlich schmutzige wasserdichte Tasche heraus."

# game/scripts/c31/c31.rpy:4485
translate german c31s007_AmaTour_0028cf35:

    # "She tries to wipe it clean with her hand, without much success."
    "Sie versucht, sie mit der Hand abzuwischen, ohne großen Erfolg."

# game/scripts/c31/c31.rpy:4486
translate german c31s007_AmaTour_58a4054a:

    # mc "What's in there? It's not very big."
    mc "Was ist da drin? Sie ist nicht sehr groß."

# game/scripts/c31/c31.rpy:4488
translate german c31s007_AmaTour_031b17bd:

    # ama "I already told you, my most prized possessions. Sit down."
    ama "Ich hab's dir doch schon gesagt, meine wertvollsten Besitztümer. Setz dich."

# game/scripts/c31/c31.rpy:4489
translate german c31s007_AmaTour_4d4c7852:

    # "The sadness in her eyes is enough to make you sit down without opening your mouth."
    "Die Traurigkeit in ihren Augen reicht aus, dass du dich hinsetzt, ohne ein Wort zu sagen."

# game/scripts/c31/c31.rpy:4490
translate german c31s007_AmaTour_4a29174e:

    # "The bag is small. You expect something with sentimental value, but you can't imagine what it is."
    "Die Tasche ist klein. Du erwartest etwas mit sentimentalem Wert, aber du kannst dir nicht vorstellen, was es ist."

# game/scripts/c31/c31.rpy:4495
translate german c31s007_AmaTour_ae3e3856:

    # "[ama] takes a faded polaroid out of the bag. It shows a little girl in military gear that looks too big for her."
    "[ama] holt ein verblasstes Polaroid aus der Tasche. Es zeigt ein kleines Mädchen in militärischer Ausrüstung, die ihr zu groß zu sein scheint."

# game/scripts/c31/c31.rpy:4496
translate german c31s007_AmaTour_1519bf7e:

    # ama "Meet Fiona. It's the only existing picture of her."
    ama "Das ist Fiona. Es ist das einzige existierende Bild von ihr."

# game/scripts/c31/c31.rpy:4497
translate german c31s007_AmaTour_7a085a2a:

    # ama "It's from a training session a week before she died."
    ama "Es stammt von einer Trainingseinheit eine Woche vor ihrem Tod."

# game/scripts/c31/c31.rpy:4499
translate german c31s007_AmaTour_0e5674ee:

    # mc "She reminds me of young [eri] more than young [dap]."
    mc "Sie erinnert mich mehr an die junge [eri] als an die junge [dap]."

# game/scripts/c31/c31.rpy:4501
translate german c31s007_AmaTour_4f2aeb04:

    # mc "For some reason, I imagined a miniature [eva]. I guess because of the name she gave the doll."
    mc "Aus irgendeinem Grund habe ich mir eine Miniatur-[eva] vorgestellt. Ich schätze, wegen des Namens, den sie der Puppe gegeben hat."

# game/scripts/c31/c31.rpy:4502
translate german c31s007_AmaTour_17129545:

    # mc "But she reminds me more of young [eri] than [eva]."
    mc "Aber sie erinnert mich mehr an die junge [eri] als an [eva]."

# game/scripts/c31/c31.rpy:4504
translate german c31s007_AmaTour_4a0ca034:

    # ama "I think she would've liked to hear that. She was the most empathetic of all of us."
    ama "Ich glaube, das hätte sie gerne gehört. Sie war die einfühlsamste von uns allen."

# game/scripts/c31/c31.rpy:4505
translate german c31s007_AmaTour_043e1d38:

    # ama "I think you are right, she would've been like [eri] if she'd had the chance."
    ama "Ich glaube, du hast recht, sie wäre wie [eri] geworden, wenn sie die Chance gehabt hätte."

# game/scripts/c31/c31.rpy:4506
translate german c31s007_AmaTour_834e9fe5:

    # mc "I'm sorry, [ama]. I'm sorry for everything you guys had to go through."
    mc "Es tut mir leid, [ama]. Es tut mir leid für alles, was ihr durchmachen musstet."

# game/scripts/c31/c31.rpy:4507
translate german c31s007_AmaTour_6a5616d7:

    # mc "I'm sorry about Fiona. But also about Clarice, Beatrice, and Diana."
    mc "Es tut mir leid wegen Fiona. Aber auch wegen Clarice, Beatrice und Diana."

# game/scripts/c31/c31.rpy:4508
translate german c31s007_AmaTour_63223d14:

    # mc "I'm sorry I never got the chance to meet them."
    mc "Es tut mir leid, dass ich nie die Chance hatte, sie kennenzulernen."

# game/scripts/c31/c31.rpy:4511
translate german c31s007_AmaTour_f7321d28:

    # "You spend a while looking at the photo. You'd like to hug the woman you adore, but you know she's deep in thought."
    "Du verbringst eine Weile damit, das Foto zu betrachten. Du würdest die Frau, die du verehrst, gerne umarmen, aber du weißt, dass sie in Gedanken versunken ist."

# game/scripts/c31/c31.rpy:4513
translate german c31s007_AmaTour_a2a37865:

    # "You spend a while looking at the photo. You'd like to hug the sad mercenary, but you know she's deep in thought."
    "Du verbringst eine Weile damit, das Foto zu betrachten. Du würdest die traurige Söldnerin gerne umarmen, aber du weißt, dass sie in Gedanken versunken ist."

# game/scripts/c31/c31.rpy:4514
translate german c31s007_AmaTour_44855285:

    # "You hate Daniels for depriving you of the chance to meet Diana, Beatrice, and Clarice."
    "Du hasst Daniels dafür, dass er dir die Chance genommen hat, Diana, Beatrice und Clarice kennenzulernen."

# game/scripts/c31/c31.rpy:4515
translate german c31s007_AmaTour_40f021f2:

    # "You hate Richards, the CEO before Daniels, because Fiona's death happened under his watch."
    "Du hasst Richards, den CEO vor Daniels, weil Fionas Tod unter seiner Aufsicht geschah."

# game/scripts/c31/c31.rpy:4516
translate german c31s007_AmaTour_3007892c:

    # "But above all, you pity the girls. The living and the dead. For what they went through. For what they suffered."
    "Aber vor allem hast du Mitleid mit den Mädchen. Den Lebenden und den Toten. Für das, was sie durchgemacht haben. Für das, was sie erlitten haben."

# game/scripts/c31/c31.rpy:4518
translate german c31s007_AmaTour_7f74b570:

    # "And the rest of the clones, too. They went through the same thing."
    "Und auch mit dem Rest der Klone. Sie haben dasselbe durchgemacht."

# game/scripts/c31/c31.rpy:4520
translate german c31s007_AmaTour_ac792836:

    # "And the clones, too. They went through the same thing."
    "Und auch mit den Klonen. Sie haben dasselbe durchgemacht."

# game/scripts/c31/c31.rpy:4521
translate german c31s007_AmaTour_c0b79d13:

    # "None of them deserved it."
    "Keine von ihnen hat das verdient."

# game/scripts/c31/c31.rpy:4523
translate german c31s007_AmaTour_a8136d8d:

    # mc "Are you okay?"
    mc "Geht es dir gut?"

# game/scripts/c31/c31.rpy:4524
translate german c31s007_AmaTour_e5064004:

    # ama "No. But I wanted you to meet them."
    ama "Nein. Aber ich wollte, dass du sie kennenlernst."

# game/scripts/c31/c31.rpy:4525
translate german c31s007_AmaTour_c6c6b70c:

    # mc "Did you say 'them'?"
    mc "Hast du 'sie' gesagt?"

# game/scripts/c31/c31.rpy:4530
translate german c31s007_AmaTour_fef26734:

    # ama "These are the other girls. Well, we are..."
    ama "Das sind die anderen Mädchen. Naja, wir sind..."

# game/scripts/c31/c31.rpy:4531
translate german c31s007_AmaTour_be330c67:

    # ama "Diana, me, Beatrice, [eva], and Clarice."
    ama "Diana, ich, Beatrice, [eva] und Clarice."

# game/scripts/c31/c31.rpy:4532
translate german c31s007_AmaTour_3d2bf7e0:

    # mc "You're all so different from each other... And it's weird seeing you as a brunette."
    mc "Ihr seid alle so unterschiedlich... Und es ist seltsam, dich als Brünette zu sehen."

# game/scripts/c31/c31.rpy:4534
translate german c31s007_AmaTour_8b7fa035:

    # ama "We tried to maintain our individuality by dyeing our hair and wearing different makeup."
    ama "Wir haben versucht, unsere Individualität zu bewahren, indem wir unsere Haare gefärbt und unterschiedliches Make-up getragen haben."

# game/scripts/c31/c31.rpy:4535
translate german c31s007_AmaTour_7329578b:

    # ama "We were allowed to do that, unlike the rest of the clones."
    ama "Uns war das erlaubt, im Gegensatz zum Rest der Klone."

# game/scripts/c31/c31.rpy:4536
translate german c31s007_AmaTour_26f78c73:

    # ama "Diana was the prettiest of us. Her specialties were... seduction and assassination."
    ama "Diana war die Hübscheste von uns. Ihre Spezialgebiete waren... Verführung und Attentate."

# game/scripts/c31/c31.rpy:4537
translate german c31s007_AmaTour_f98baf20:

    # ama "Beatrice always liked being the strongest. She specialized in heavy weaponry and logistics."
    ama "Beatrice mochte es immer, die Stärkste zu sein. Sie war auf schwere Waffen und Logistik spezialisiert."

# game/scripts/c31/c31.rpy:4538
translate german c31s007_AmaTour_e409203c:

    # ama "Clarice was the most fragile of us all. She was sick when we were kids and... Well, she was the smallest along with Fiona."
    ama "Clarice war die Zerbrechlichste von uns allen. Sie war krank, als wir Kinder waren und... Naja, sie war zusammen mit Fiona die Kleinste."

# game/scripts/c31/c31.rpy:4539
translate german c31s007_AmaTour_0f21242b:

    # ama "She was the communications specialist. But she would have crushed anyone in a fight."
    ama "Sie war die Kommunikationsspezialistin. Aber sie hätte jeden in einem Kampf vernichtet."

# game/scripts/c31/c31.rpy:4540
translate german c31s007_AmaTour_9840f65d:

    # ama "And [eva] and me, you already know us."
    ama "Und [eva] und mich kennst du ja schon."

# game/scripts/c31/c31.rpy:4541
translate german c31s007_AmaTour_68830a2a:

    # mc "What was your specialty?"
    mc "Was war dein Spezialgebiet?"

# game/scripts/c31/c31.rpy:4543
translate german c31s007_AmaTour_90632b16:

    # ama "Mine was surveillance, interrogation, and espionage. I broke my leg when I was six and spent a month glued to the monitors."
    ama "Meins war Überwachung, Verhör und Spionage. Ich habe mir mit sechs das Bein gebrochen und einen Monat lang vor den Monitoren geklebt."

# game/scripts/c31/c31.rpy:4544
translate german c31s007_AmaTour_1cd31f0d:

    # ama "[eva]'s specialty was... is... infiltration and elimination."
    ama "[eva]s Spezialgebiet war... ist... Infiltration und Eliminierung."

# game/scripts/c31/c31.rpy:4545
translate german c31s007_AmaTour_9090a1f8:

    # ama "Fiona would have been our sniper."
    ama "Fiona wäre unsere Scharfschützin gewesen."

# game/scripts/c31/c31.rpy:4546
translate german c31s007_AmaTour_e178a7a4:

    # ama "But don't get me wrong. Any of us could do everything."
    ama "Aber versteh mich nicht falsch. Jede von uns konnte alles."

# game/scripts/c31/c31.rpy:4548
translate german c31s007_AmaTour_47b70cce:

    # ama "Well... maybe everything except the seduction part. Only Diana and Clarice did that."
    ama "Naja... vielleicht alles außer dem Verführungsteil. Das haben nur Diana und Clarice gemacht."

# game/scripts/c31/c31.rpy:4549
translate german c31s007_AmaTour_368fcaef:

    # mc "You told me."
    mc "Das hast du mir erzählt."

# game/scripts/c31/c31.rpy:4551
translate german c31s007_AmaTour_3c2aed6c:

    # ama "But as for the rest, any of us could use a grenade launcher or comms equipment."
    ama "Aber was den Rest angeht, konnte jede von uns einen Granatwerfer oder Kommunikationsausrüstung bedienen."

# game/scripts/c31/c31.rpy:4552
translate german c31s007_AmaTour_37eb576e:

    # ama "And, obviously, we could all beat anyone on the base at the shooting range with an M4A1 or a Glock."
    ama "Und offensichtlich konnten wir alle jeden auf der Basis auf dem Schießstand mit einer M4A1 oder einer Glock schlagen."

# game/scripts/c31/c31.rpy:4553
translate german c31s007_AmaTour_c90cfebc:

    # ama "And in hand-to-hand combat, we could compete with anyone."
    ama "Und im Nahkampf konnten wir es mit jedem aufnehmen."

# game/scripts/c31/c31.rpy:4554
translate german c31s007_AmaTour_1386d5a0:

    # mc "Sounds very strange to me... Specialists, but at the same time generalists."
    mc "Klingt für mich sehr seltsam... Spezialisten, aber gleichzeitig Generalisten."

# game/scripts/c31/c31.rpy:4556
translate german c31s007_AmaTour_5eef60ce:

    # ama "You never know what you're going to encounter on a mission. We all had to know how to do everything."
    ama "Man weiß nie, was man auf einer Mission antreffen wird. Wir alle mussten wissen, wie man alles macht."

# game/scripts/c31/c31.rpy:4557
translate german c31s007_AmaTour_53f9fb7c:

    # ama "Some of the other operatives are more specialized. The Ds are really good with heavy weapons. They're big guys."
    ama "Einige der anderen Agenten sind spezialisierter. Die Ds sind wirklich gut mit schweren Waffen. Sie sind große Kerle."

# game/scripts/c31/c31.rpy:4558
translate german c31s007_AmaTour_30a0ae8c:

    # ama "But they'll never be as good as Beatrice was."
    ama "Aber sie werden nie so gut sein, wie Beatrice es war."

# game/scripts/c31/c31.rpy:4559
translate german c31s007_AmaTour_d56b9c53:

    # mc "I get it."
    mc "Ich verstehe."

# game/scripts/c31/c31.rpy:4560
translate german c31s007_AmaTour_2280aea1:

    # mc "You said that was the only photo of Fiona. That's weird, right?"
    mc "Du meintest, das wäre das einzige Foto von Fiona. Das ist seltsam, oder?"

# game/scripts/c31/c31.rpy:4561
translate german c31s007_AmaTour_37550ed7:

    # mc "I guess there aren't many photos of all of you together either."
    mc "Ich schätze, es gibt auch nicht viele Fotos von euch allen zusammen."

# game/scripts/c31/c31.rpy:4566
translate german c31s007_AmaTour_692c7fce:

    # ama "This is the only one there is, as far as I know."
    ama "Das ist das einzige, das es gibt, soweit ich weiß."

# game/scripts/c31/c31.rpy:4567
translate german c31s007_AmaTour_d7520798:

    # ama "Photos are forbidden on the base, except when they want to make a promotional poster. And even then we wear masks."
    ama "Fotos sind auf der Basis verboten, es sei denn, sie wollen ein Werbeplakat machen. Und selbst dann tragen wir Masken."

# game/scripts/c31/c31.rpy:4568
translate german c31s007_AmaTour_72786cbc:

    # ama "Nobody wants a photo of 10 G-series clones circulating on the internet. Or a photo of six 6-year-old girls training."
    ama "Niemand will, dass ein Foto von 10 Klonen der G-Serie im Internet kursiert. Oder ein Foto von sechs trainierenden 6-jährigen Mädchen."

# game/scripts/c31/c31.rpy:4569
translate german c31s007_AmaTour_8dabad0f:

    # mc "I get it. So much secrecy..."
    mc "Ich verstehe. So viel Geheimniskrämerei..."

# game/scripts/c31/c31.rpy:4570
translate german c31s007_AmaTour_3c07ff49:

    # mc "I'm glad you showed me these photos. It makes me happy and sad at the same time."
    mc "Ich bin froh, dass du mir diese Fotos gezeigt hast. Es macht mich gleichzeitig glücklich und traurig."

# game/scripts/c31/c31.rpy:4572
translate german c31s007_AmaTour_76b8b592:

    # ama "Fiona's photo was taken by Arnau, one of [aar]'s brothers, with a smuggled camera."
    ama "Fionas Foto wurde von Arnau, einem von [aar]s Brüdern, mit einer geschmuggelten Kamera gemacht."

# game/scripts/c31/c31.rpy:4573
translate german c31s007_AmaTour_dc702d85:

    # ama "Ours was taken by [aar]. They found the camera and took it away."
    ama "Unseres wurde von [aar] gemacht. Sie haben die Kamera gefunden und weggenommen."

# game/scripts/c31/c31.rpy:4574
translate german c31s007_AmaTour_f26029ae:

    # ama "That's why I kept them here. It was my secret hiding spot. No one could take them from me here."
    ama "Deshalb habe ich sie hier aufbewahrt. Es war mein geheimes Versteck. Hier konnte sie mir niemand wegnehmen."

# game/scripts/c31/c31.rpy:4576
translate german c31s007_AmaTour_191509e1:

    # ama "The last time I was here, I didn't know that I'd never see my sisters alive again."
    ama "Als ich das letzte Mal hier war, wusste ich nicht, dass ich meine Schwestern nie wieder lebend sehen würde."

# game/scripts/c31/c31.rpy:4577
translate german c31s007_AmaTour_47b414f6:

    # ama "I wish you guys could have met them. And that they could have met you."
    ama "Ich wünschte, ihr hättet sie kennenlernen können. Und dass sie euch hätten kennenlernen können."

# game/scripts/c31/c31.rpy:4578
translate german c31s007_AmaTour_e8427a0e:

    # "You know she's trying to act tough. The [ama] from back home would probably be crying by now. Coming back to Aruba is changing her."
    "Du weißt, dass sie versucht, stark zu wirken. Die [ama] von zu Hause würde jetzt wahrscheinlich weinen. Die Rückkehr nach Aruba verändert sie."

# game/scripts/c31/c31.rpy:4579
translate german c31s007_AmaTour_8908deda:

    # mc "You don't need to hide them anymore. No one is ever going to take those photos from you."
    mc "Du musst sie nicht mehr verstecken. Niemand wird dir diese Fotos jemals wegnehmen."

# game/scripts/c31/c31.rpy:4580
translate german c31s007_AmaTour_844d759b:

    # mc "I'll take care of it if anyone tries."
    mc "Ich werde mich darum kümmern, falls es jemand versucht."

# game/scripts/c31/c31.rpy:4582
translate german c31s007_AmaTour_550cd2ea:

    # ama "Thanks, [mc]. Though I guess now that I own part of the company, no one would dare."
    ama "Danke, [mc]. Obwohl ich schätze, jetzt, wo mir ein Teil der Firma gehört, würde es niemand wagen."

# game/scripts/c31/c31.rpy:4583
translate german c31s007_AmaTour_d91cc20f:

    # mc "I guess not."
    mc "Ich schätze nicht."

# game/scripts/c31/c31.rpy:4584
translate german c31s007_AmaTour_863c2920:

    # mc "But I don't see anything that would make me call you a psychopath. Having photos of your sisters isn't it."
    mc "Aber ich sehe nichts, was mich dazu bringen würde, dich eine Psychopathin zu nennen. Fotos von deinen Schwestern zu haben, ist es jedenfalls nicht."

# game/scripts/c31/c31.rpy:4586
translate german c31s007_AmaTour_54748aeb:

    # ama "There's something else in the bag."
    ama "Da ist noch etwas in der Tasche."

# game/scripts/c31/c31.rpy:4588
translate german c31s007_AmaTour_c60ffa46:

    # "[ama] takes a piece of metal out of the bag and leaves it on her knee. You have no idea what it could be."
    "[ama] holt ein Stück Metall aus der Tasche und legt es auf ihr Knie. Du hast keine Ahnung, was es sein könnte."

# game/scripts/c31/c31.rpy:4589
translate german c31s007_AmaTour_81df295e:

    # ama "It's a piece of shrapnel from the device that killed Fiona."
    ama "Es ist ein Schrapnell von dem Sprengsatz, der Fiona getötet hat."

# game/scripts/c31/c31.rpy:4590
translate german c31s007_AmaTour_cda67e0f:

    # ama "Each of us kept a piece. I hid mine here and couldn't get it back when we had to leave."
    ama "Jede von uns hat ein Stück behalten. Ich habe meins hier versteckt und konnte es nicht mehr holen, als wir gehen mussten."

# game/scripts/c31/c31.rpy:4591
translate german c31s007_AmaTour_8149625e:

    # mc "What's wrong with that?"
    mc "Was ist daran so schlimm?"

# game/scripts/c31/c31.rpy:4593
translate german c31s007_AmaTour_65f7e344:

    # ama "Don't you think it's weird that we kept a piece of the thing that killed our sister?"
    ama "Findest du es nicht seltsam, dass wir ein Stück von dem Ding behalten haben, das unsere Schwester getötet hat?"

# game/scripts/c31/c31.rpy:4594
translate german c31s007_AmaTour_44e7274b:

    # mc "It's not common, but I've seen mothers wearing a lock of their dead child's hair around their necks and..."
    mc "Es ist nicht üblich, aber ich habe Mütter gesehen, die eine Locke ihres toten Kindes um den Hals tragen und..."

# game/scripts/c31/c31.rpy:4595
translate german c31s007_AmaTour_49ad248f:

    # mc "Wait... Show me the picture of the five of you again."
    mc "Warte... Zeig mir noch mal das Bild von euch fünfen."

# game/scripts/c31/c31.rpy:4600
translate german c31s007_AmaTour_bd368d65:

    # mc "The heart [eva] always wears around her neck... Is that her piece of the explosive?"
    mc "Das Herz, das [eva] immer um den Hals trägt... Ist das ihr Stück von dem Sprengsatz?"

# game/scripts/c31/c31.rpy:4602
translate german c31s007_AmaTour_22c2d107:

    # ama "Yes. It's the biggest piece. The one that killed her. She shaped it into a heart and made a pendant out of it."
    ama "Ja. Es ist das größte Stück. Das, was sie getötet hat. Sie hat es zu einem Herz geformt und einen Anhänger daraus gemacht."

# game/scripts/c31/c31.rpy:4603
translate german c31s007_AmaTour_4c4fe98d:

    # ama "That's why she always wears it. It's her way of letting Fiona... see the world she missed out on."
    ama "Deshalb trägt sie es immer. Es ist ihre Art, Fiona... die Welt sehen zu lassen, die sie verpasst hat."

# game/scripts/c31/c31.rpy:4604
translate german c31s007_AmaTour_655658b1:

    # ama "I know it might sound twisted to anyone other than her sisters, but..."
    ama "Ich weiß, für jeden außer ihren Schwestern mag es krank klingen, aber..."

# game/scripts/c31/c31.rpy:4605
translate german c31s007_AmaTour_03aed379:

    # mc "It's not twisted, [ama]. It's a very sweet gesture on [eva]'s part."
    mc "Es ist nicht krank, [ama]. Es ist eine sehr süße Geste von [eva]."

# game/scripts/c31/c31.rpy:4607
translate german c31s007_AmaTour_5d8674bc:

    # ama "Don't tell her I told you. Not even that you figured it out yourself."
    ama "Sag ihr nicht, dass ich es dir gesagt habe. Nicht einmal, dass du selbst darauf gekommen bist."

# game/scripts/c31/c31.rpy:4608
translate german c31s007_AmaTour_61af9c86:

    # ama "She'd probably kill me and then feel very lonely being the only one alive out of the six of us."
    ama "Sie würde mich wahrscheinlich umbringen und sich dann sehr einsam fühlen, als Einzige von uns sechs noch am Leben zu sein."

# game/scripts/c31/c31.rpy:4609
translate german c31s007_AmaTour_c77894c6:

    # mc "That would be very typical of [eva]. Don't worry, I won't say anything."
    mc "Das wäre sehr typisch für [eva]. Keine Sorge, ich sage nichts."

# game/scripts/c31/c31.rpy:4610
translate german c31s007_AmaTour_9122b12e:

    # mc "I asked her about the heart and she told me she'd tell me about it someday. I have to give her the chance to do that when she's ready."
    mc "Ich habe sie nach dem Herz gefragt und sie sagte, sie würde mir irgendwann davon erzählen. Ich muss ihr die Chance geben, das zu tun, wenn sie bereit ist."

# game/scripts/c31/c31.rpy:4613
translate german c31s007_AmaTour_ae79eb17:

    # "[ama] stands up after putting the photos and the fragment back into the bag."
    "[ama] steht auf, nachdem sie die Fotos und das Fragment zurück in die Tasche gelegt hat."

# game/scripts/c31/c31.rpy:4614
translate german c31s007_AmaTour_ef2df167:

    # "She doesn't put it back in the hiding spot, but instead puts it in one of her pants pockets."
    "Sie legt sie nicht zurück ins Versteck, sondern steckt sie in eine ihrer Hosentaschen."

# game/scripts/c31/c31.rpy:4615
translate german c31s007_AmaTour_168388e6:

    # ama "And now we should get going. Our hour and a half is almost up. I still have to interview several operatives today."
    ama "Und jetzt sollten wir los. Unsere anderthalb Stunden sind fast um. Ich muss heute noch mehrere Agenten befragen."

# game/scripts/c31/c31.rpy:4616
translate german c31s007_AmaTour_396d4bef:

    # ama "And [car] won't like it if you're late."
    ama "Und [car] wird es nicht gefallen, wenn du zu spät kommst."

# game/scripts/c31/c31.rpy:4617
translate german c31s007_AmaTour_9ec71eb9:

    # mc "Do we have time to do one thing?"
    mc "Haben wir noch Zeit für eine Sache?"

# game/scripts/c31/c31.rpy:4618
translate german c31s007_AmaTour_e474bb73:

    # ama "Depends. What do you want to do?"
    ama "Kommt drauf an. Was willst du tun?"

# game/scripts/c31/c31.rpy:4620
translate german c31s007_AmaTour_902b3dcc:

    # "You stand up and hug her. You have no words to express what you feel. Your arms around her body will have to convey the message."
    "Du stehst auf und umarmst sie. Du hast keine Worte, um auszudrücken, was du fühlst. Deine Arme um ihren Körper müssen die Botschaft übermitteln."

# game/scripts/c31/c31.rpy:4622
translate german c31s007_AmaTour_95ec8f3f:

    # "For the first time since she took the bag out of the hideout, [ama] lets her feelings flow."
    "Zum ersten Mal, seit sie die Tasche aus dem Versteck geholt hat, lässt [ama] ihren Gefühlen freien Lauf."

# game/scripts/c31/c31.rpy:4623
translate german c31s007_AmaTour_d5276be1:

    # "You hate making her cry, but these tears are also part of her healing process."
    "Du hasst es, sie zum Weinen zu bringen, aber diese Tränen sind auch Teil ihres Heilungsprozesses."

# game/scripts/c31/c31.rpy:4624
translate german c31s007_AmaTour_0bb7ae79:

    # "Neither of you cares about being a little late to the next appointment on your schedule."
    "Keinen von euch kümmert es, ein wenig zu spät zum nächsten Termin auf eurem Plan zu kommen."

# game/scripts/c31/c31.rpy:4628
translate german c31s007_surgery_ea02b104:

    # "The rest of the day passes with what seems to be the new normal."
    "Der Rest des Tages vergeht mit dem, was die neue Normalität zu sein scheint."

# game/scripts/c31/c31.rpy:4629
translate german c31s007_surgery_b69f9398:

    # "At least the folders stop piling up on your desk."
    "Wenigstens stapeln sich die Aktenordner nicht mehr auf deinem Schreibtisch."

# game/scripts/c31/c31.rpy:4631
translate german c31s007_surgery_50007757:

    # "Upon returning to the CEO's House, and after showering, you eat the catering that [car] ordered for dinner."
    "Nach der Rückkehr ins Haus des CEOs und nach dem Duschen isst du das Catering, das [car] zum Abendessen bestellt hat."

# game/scripts/c31/c31.rpy:4632
translate german c31s007_surgery_6f280d90:

    # "Once again she nailed it with dishes you like. You have to find out how she does it."
    "Wieder einmal hat sie mit Gerichten, die du magst, voll ins Schwarze getroffen. Du musst herausfinden, wie sie das macht."

# game/scripts/c31/c31.rpy:4633
translate german c31s007_surgery_8b9e4664:

    # "[bet] is a little nervous about the next day's surgery."
    "[bet] ist ein wenig nervös wegen der Operation am nächsten Tag."

# game/scripts/c31/c31.rpy:4634
translate german c31s007_surgery_91b38331:

    # "She has spent the last two days meeting with surgeons and engineers, and rehearsing the surgery."
    "Sie hat die letzten zwei Tage damit verbracht, sich mit Chirurgen und Ingenieuren zu treffen und die Operation zu proben."

# game/scripts/c31/c31.rpy:4635
translate german c31s007_surgery_f357ce29:

    # "She thinks it'll go well, but it's a surgery that has never been done before. There are too many things that could go wrong."
    "Sie denkt, es wird gut gehen, aber es ist eine Operation, die noch nie zuvor durchgeführt wurde. Es gibt zu viele Dinge, die schiefgehen könnten."

# game/scripts/c31/c31.rpy:4637
translate german c31s007_surgery_9117775c:

    # "This time, the two women decide to sleep with you."
    "Dieses Mal beschließen die beiden Frauen, bei dir zu schlafen."

# game/scripts/c31/c31.rpy:4638
translate german c31s007_surgery_117c5f6b:

    # "You go to bed early. [gav]'s surgery is scheduled for 10 AM."
    "Du gehst früh ins Bett. [gav]s Operation ist für 10 Uhr morgens angesetzt."

# game/scripts/c31/c31.rpy:4639
translate german c31s007_surgery_7ea9f7c2:

    # "The bed is big enough for the three of you."
    "Das Bett ist groß genug für euch drei."

# game/scripts/c31/c31.rpy:4641
translate german c31s007_surgery_66562efc:

    # centered "{size=+20}{b}DAY 41 – SUNDAY{/b}{/size}"
    centered "{size=+20}{b}TAG 41 – SONNTAG{/b}{/size}"

# game/scripts/c31/c31.rpy:4643
translate german c31s007_surgery_6ef2d0b1:

    # "In the morning, [bet] barely touches the freshly baked croissants that [car] sends every morning."
    "Am Morgen rührt [bet] die frisch gebackenen Croissants, die [car] jeden Morgen schickt, kaum an."

# game/scripts/c31/c31.rpy:4644
translate german c31s007_surgery_4cc9ee8e:

    # "If you needed any sign of how nervous she is, that's more than enough."
    "Wenn du ein Zeichen dafür brauchtest, wie nervös sie ist, ist das mehr als genug."

# game/scripts/c31/c31.rpy:4646
translate german c31s007_surgery_35bcb1b1:

    # "You arrive at your office a little before 8. It feels weird not seeing [car] when you arrive."
    "Du kommst kurz vor 8 Uhr in deinem Büro an. Es fühlt sich seltsam an, [car] bei deiner Ankunft nicht zu sehen."

# game/scripts/c31/c31.rpy:4647
translate german c31s007_surgery_19ad6719:

    # "The folders have disappeared from your desk and a bunch of emails have appeared in your inbox."
    "Die Ordner sind von deinem Schreibtisch verschwunden und ein Haufen E-Mails ist in deinem Posteingang aufgetaucht."

# game/scripts/c31/c31.rpy:4648
translate german c31s007_surgery_2e8b336a:

    # "There's a coffee waiting for you, which means [lar] is probably already in the building."
    "Ein Kaffee wartet auf dich, was bedeutet, dass [lar] wahrscheinlich schon im Gebäude ist."

# game/scripts/c31/c31.rpy:4649
translate german c31s007_surgery_6e2893d5:

    # "You think you're going to love [car]'s efficiency."
    "Du denkst, du wirst [car]s Effizienz lieben."

# game/scripts/c31/c31.rpy:4652
translate german c31s007_surgery_f00b0076:

    # "After a few minutes of reading emails..."
    "Nachdem ich ein paar Minuten E-Mails gelesen habe..."

# game/scripts/c31/c31.rpy:4653
translate german c31s007_surgery_26e21393:

    # lar "Oops! I didn't know you had arrived already."
    lar "Hoppla! Ich wusste nicht, dass Sie schon da sind."

# game/scripts/c31/c31.rpy:4654
translate german c31s007_surgery_293e4618:

    # mc "Good morning. I assume you're [lar]. I'm [mc]. Nice to meet you."
    mc "Guten Morgen. Ich nehme an, Sie sind [lar]. Ich bin [mc]. Freut mich, Sie kennenzulernen."

# game/scripts/c31/c31.rpy:4656
translate german c31s007_surgery_230e9949:

    # lar "Good morning, Mr. Marks. Yes, I'm [lar], your assistant on Sundays and Mondays."
    lar "Guten Morgen, Mr. Marks. Ja, ich bin [lar], Ihre Assistentin an Sonntagen und Montagen."

# game/scripts/c31/c31.rpy:4657
translate german c31s007_surgery_5f9e6b36:

    # mc "Nice to meet you, [lar]."
    mc "Freut mich, Sie kennenzulernen, [lar]."

# game/scripts/c31/c31.rpy:4659
translate german c31s007_surgery_f03da9f8:

    # lar "I've filed all the folders that [car] told me to. If you want to check them, they are in..."
    lar "Ich habe alle Ordner abgelegt, die [car] mir aufgetragen hat. Wenn Sie sie überprüfen möchten, sie sind in..."

# game/scripts/c31/c31.rpy:4660
translate german c31s007_surgery_892040b7:

    # mc "No need. I saw that [car] sent me emails with the documentation. I doubt I'll need the folders."
    mc "Nicht nötig. Ich habe gesehen, dass [car] mir E-Mails mit der Dokumentation geschickt hat. Ich bezweifle, dass ich die Ordner brauche."

# game/scripts/c31/c31.rpy:4661
translate german c31s007_surgery_0f24195a:

    # lar "Perfect, sir."
    lar "Perfekt, Sir."

# game/scripts/c31/c31.rpy:4663
translate german c31s007_surgery_70cc744a:

    # lar "If you need me, I'll be right outside."
    lar "Wenn Sie mich brauchen, ich bin gleich draußen."

# game/scripts/c31/c31.rpy:4664
translate german c31s007_surgery_4e5b80f5:

    # mc "Thank you, [lar]."
    mc "Danke, [lar]."

# game/scripts/c31/c31.rpy:4667
translate german c31s007_surgery_63f6a1b1:

    # "As the time for the surgery approaches..."
    "Als die Zeit für die Operation näher rückt..."

# game/scripts/c31/c31.rpy:4668
translate german c31s007_surgery_c5caecb7:

    # mc "[lar], I'm going to the medical facilities. If anything {b}urgent{/b} comes up, please let me know."
    mc "[lar], ich gehe in die medizinische Abteilung. Wenn etwas {b}Dringendes{/b} dazwischenkommt, sag mir bitte Bescheid."

# game/scripts/c31/c31.rpy:4669
translate german c31s007_surgery_54a5742e:

    # lar "I understand, Sir. Only what's truly urgent."
    lar "Ich verstehe, Sir. Nur was wirklich dringend ist."

# game/scripts/c31/c31.rpy:4670
translate german c31s007_surgery_ac67d23a:

    # mc "Today, the urgent thing is [gav]'s surgery. The rest can wait unless the sky falls on our heads."
    mc "Heute ist [gav]s Operation das Dringendste. Der Rest kann warten, es sei denn, uns fällt der Himmel auf den Kopf."

# game/scripts/c31/c31.rpy:4672
translate german c31s007_surgery_306f80db:

    # "[aar] is already there, next to a G you haven't met."
    "[aar] ist bereits dort, neben einem G, den du noch nicht kennengelernt hast."

# game/scripts/c31/c31.rpy:4673
translate german c31s007_surgery_6f5648e0:

    # mc "Good morning, [aar]. Good morning..."
    mc "Guten Morgen, [aar]. Guten Morgen ..."

# game/scripts/c31/c31.rpy:4674
translate german c31s007_surgery_1fa85298:

    # gid "[gid], Sir. Good morning."
    gid "[gid], Sir. Guten Morgen."

# game/scripts/c31/c31.rpy:4675
translate german c31s007_surgery_816e2552:

    # aar "Good morning, [mc]."
    aar "Guten Morgen, [mc]."

# game/scripts/c31/c31.rpy:4676
translate german c31s007_surgery_5434f45c:

    # mc "Is everything going according to plan?"
    mc "Läuft alles nach Plan?"

# game/scripts/c31/c31.rpy:4678
translate german c31s007_surgery_c43223f3:

    # aar "For now, yes. [bet] hasn't entered the operating room yet."
    aar "Bis jetzt ja. [bet] hat den Operationssaal noch nicht betreten."

# game/scripts/c31/c31.rpy:4679
translate german c31s007_surgery_d8e3f095:

    # mc "I imagined it like in the TV shows."
    mc "Ich habe mir das wie in den Fernsehserien vorgestellt."

# game/scripts/c31/c31.rpy:4680
translate german c31s007_surgery_d3807f28:

    # mc "I thought we could watch the operation live, from a balcony or something like that."
    mc "Ich dachte, wir könnten die Operation live von einem Balkon oder so beobachten."

# game/scripts/c31/c31.rpy:4681
translate german c31s007_surgery_72f81c55:

    # aar "We've never needed that kind of facility. That operating room is usually used to treat combat wounds."
    aar "Wir haben so eine Einrichtung noch nie gebraucht. Dieser Operationssaal wird normalerweise zur Behandlung von Kampfwunden genutzt."

# game/scripts/c31/c31.rpy:4682
translate german c31s007_surgery_d56b9c53:

    # mc "I get it."
    mc "Ich verstehe."

# game/scripts/c31/c31.rpy:4683
translate german c31s007_surgery_f5935eeb:

    # aar "One of [bet]'s assistants will bring us updates from time to time. If there's anything interesting to report."
    aar "Einer von [bet]s Assistenten wird uns von Zeit zu Zeit auf den neuesten Stand bringen. Falls es etwas Interessantes zu berichten gibt."

# game/scripts/c31/c31.rpy:4684
translate german c31s007_surgery_8f535801:

    # gid "If you'll excuse me, I'm going to take my leave. My shift starts in a few minutes."
    gid "Wenn Sie mich entschuldigen, ich werde mich zurückziehen. Meine Schicht beginnt in ein paar Minuten."

# game/scripts/c31/c31.rpy:4685
translate german c31s007_surgery_c7e29479:

    # mc "Of course, [gid]." (multiple=2)
    mc "Natürlich, [gid]." (multiple=2)

# game/scripts/c31/c31.rpy:4686
translate german c31s007_surgery_c62cdc45:

    # aar "Go ahead, [gid]." (multiple=2)
    aar "Gehen Sie nur, [gid]." (multiple=2)

# game/scripts/c31/c31.rpy:4687
translate german c31s007_surgery_4a4472e4:

    # "Neither of you knows who he was addressing. It doesn't matter."
    "Keiner von euch weiß, wen er angesprochen hat. Es spielt keine Rolle."

# game/scripts/c31/c31.rpy:4689
translate german c31s007_surgery_13e94e4b:

    # aar "How is [bet]?"
    aar "Wie geht es [bet]?"

# game/scripts/c31/c31.rpy:4690
translate german c31s007_surgery_b3f642c9:

    # mc "Nervous. I guess that's what comes with performing a unique surgery."
    mc "Nervös. Ich schätze, das bringt die Durchführung einer einzigartigen Operation so mit sich."

# game/scripts/c31/c31.rpy:4691
translate german c31s007_surgery_34a1e70a:

    # mc "I don't know if I could stay focused the entire time during a six-hour operation."
    mc "Ich weiß nicht, ob ich während einer sechsstündigen Operation die ganze Zeit konzentriert bleiben könnte."

# game/scripts/c31/c31.rpy:4692
translate german c31s007_surgery_b78f8095:

    # aar "Surgeons are cut from a different cloth. They know what a single slip-up can mean for their patients."
    aar "Chirurgen sind aus einem anderen Holz geschnitzt. Sie wissen, was ein einziger Ausrutscher für ihre Patienten bedeuten kann."

# game/scripts/c31/c31.rpy:4694
translate german c31s007_surgery_2a327b37:

    # "To your surprise, [car] appears in the waiting room. She sits in a lone chair."
    "Zu deiner Überraschung taucht [car] im Wartezimmer auf. Sie sitzt auf einem einsamen Stuhl."

# game/scripts/c31/c31.rpy:4696
translate german c31s007_surgery_bdeda2e4:

    # mc "[aar], I'm going to leave you for a moment. I want to talk to [car]."
    mc "[aar], ich lasse dich für einen Moment allein. Ich möchte mit [car] reden."

# game/scripts/c31/c31.rpy:4697
translate german c31s007_surgery_244012f6:

    # aar "No problem."
    aar "Kein Problem."

# game/scripts/c31/c31.rpy:4699
translate german c31s007_surgery_9d268e96:

    # mc "Good morning, [car]. I didn't expect to see you here."
    mc "Guten Morgen, [car]. Ich hätte nicht erwartet, dich hier zu sehen."

# game/scripts/c31/c31.rpy:4700
translate german c31s007_surgery_ef4f2a5e:

    # car "I've known [gav]... all these kids... since they were born."
    car "Ich kenne [gav]... all diese Kinder... seit sie geboren wurden."

# game/scripts/c31/c31.rpy:4701
translate german c31s007_surgery_20dbf9c5:

    # car "I don't think I could stay home during the surgery without going crazy."
    car "Ich glaube nicht, dass ich während der Operation zu Hause bleiben könnte, ohne verrückt zu werden."

# game/scripts/c31/c31.rpy:4702
translate german c31s007_surgery_cf9e99c3:

    # car "I didn't expect to see you here either, Sir."
    car "Ich hätte auch nicht erwartet, Sie hier zu sehen, Sir."

# game/scripts/c31/c31.rpy:4703
translate german c31s007_surgery_33778031:

    # mc "I told you I'd come today."
    mc "Ich habe dir gesagt, dass ich heute komme."

# game/scripts/c31/c31.rpy:4705
translate german c31s007_surgery_55552d4e:

    # car "I know. But I thought you'd wait for the results in your office. Mr. Richards and Mr. Daniels..."
    car "Ich weiß. Aber ich dachte, Sie würden in Ihrem Büro auf die Ergebnisse warten. Mr. Richards und Mr. Daniels..."

# game/scripts/c31/c31.rpy:4706
translate german c31s007_surgery_43265ac1:

    # mc "I'm neither Richards nor Daniels, [car]. Maybe my way of doing things isn't as efficient, but..."
    mc "Ich bin weder Richards noch Daniels, [car]. Vielleicht ist meine Art, die Dinge anzugehen, nicht so effizient, aber..."

# game/scripts/c31/c31.rpy:4707
translate german c31s007_surgery_90d11605:

    # mc "I care about [gav]'s surgery."
    mc "[gav]s Operation ist mir wichtig."

# game/scripts/c31/c31.rpy:4709
translate german c31s007_surgery_4e81318d:

    # car "I already told you that you were different, Sir."
    car "Ich habe Ihnen bereits gesagt, dass Sie anders sind, Sir."

# game/scripts/c31/c31.rpy:4710
translate german c31s007_surgery_d04eb723:

    # mc "And I told you I took it as a compliment."
    mc "Und ich habe dir gesagt, dass ich es als Kompliment auffasse."

# game/scripts/c31/c31.rpy:4711
translate german c31s007_surgery_d9330084:

    # car "In this case, it is."
    car "In diesem Fall ist es das auch."

# game/scripts/c31/c31.rpy:4713
translate german c31s007_surgery_7b9d0210:

    # "[ama] arrives along with [cal] a few minutes before the surgery starts."
    "[ama] kommt zusammen mit [cal] ein paar Minuten vor Beginn der Operation an."

# game/scripts/c31/c31.rpy:4715
translate german c31s007_surgery_e8de27bb:

    # "Time, rather than passing, crawls on the clocks the moment the operation begins."
    "Die Zeit vergeht nicht, sondern kriecht auf den Uhren, sobald die Operation beginnt."

# game/scripts/c31/c31.rpy:4716
translate german c31s007_surgery_44e060b7:

    # "Conversations die down at the same rate."
    "Die Gespräche verstummen im gleichen Tempo."

# game/scripts/c31/c31.rpy:4718
translate german c31s007_surgery_6933e30b:

    # "There is nothing to see in this room. And the door through which the assistant who is supposed to bring news should appear doesn't open."
    "In diesem Raum gibt es nichts zu sehen. Und die Tür, durch die der Assistent kommen sollte, um Neuigkeiten zu bringen, öffnet sich nicht."

# game/scripts/c31/c31.rpy:4720
translate german c31s007_surgery_24355797:

    # "You take it as a good sign. You have blind faith in [bet] as a surgeon."
    "Du nimmst es als gutes Zeichen. Du hast blindes Vertrauen in [bet] als Chirurgin."

# game/scripts/c31/c31.rpy:4722
translate german c31s007_surgery_d058b5bd:

    # "Some clones show up from time to time. They take a peek into the room before leaving again."
    "Ab und zu tauchen einige Klone auf. Sie werfen einen Blick in den Raum, bevor sie wieder gehen."

# game/scripts/c31/c31.rpy:4724
translate german c31s007_surgery_18b70d76:

    # "Every time one of them shows up, you get the feeling you're being watched."
    "Jedes Mal, wenn einer von ihnen auftaucht, hast du das Gefühl, beobachtet zu werden."

# game/scripts/c31/c31.rpy:4726
translate german c31s007_surgery_fde3c3ac:

    # "As if they want to make sure the new CEO is in the room, worrying about how the surgery of one of their own is going."
    "Als ob sie sichergehen wollen, dass der neue CEO im Raum ist und sich Sorgen darüber macht, wie die Operation einer der ihren verläuft."

# game/scripts/c31/c31.rpy:4728
translate german c31s007_surgery_a5f9d4a0:

    # "[mael] shows up towards the end of the operation. He is also interested in knowing how everything is going."
    "[mael] taucht gegen Ende der Operation auf. Er ist ebenfalls daran interessiert zu erfahren, wie alles läuft."

# game/scripts/c31/c31.rpy:4729
translate german c31s007_surgery_2856c1b6:

    # "Although perhaps his reasons are different from yours."
    "Obwohl seine Gründe vielleicht andere sind als deine."

# game/scripts/c31/c31.rpy:4731
translate german c31s007_surgery_8813668f:

    # "Six hours come and go. The damn assistant doesn't show up to give any explanation."
    "Sechs Stunden vergehen. Der verdammte Assistent taucht nicht auf, um irgendeine Erklärung abzugeben."

# game/scripts/c31/c31.rpy:4733
translate german c31s007_surgery_6eef5cfb:

    # "As the seventh hour of the surgery approaches, the door you've all been staring at for an hour finally opens."
    "Als die siebte Stunde der Operation näher rückt, öffnet sich endlich die Tür, auf die ihr alle seit einer Stunde gestarrt habt."

# game/scripts/c31/c31.rpy:4734
translate german c31s007_surgery_3d6be1e6:

    # ass "The operation was a success. Everything went as expected. The patient is under observation."
    ass "Die Operation war ein Erfolg. Alles verlief wie erwartet. Der Patient steht unter Beobachtung."

# game/scripts/c31/c31.rpy:4736
translate german c31s007_surgery_40ac48e0:

    # "You can see the emotions reflected on the faces of everyone present."
    "Du kannst die Emotionen auf den Gesichtern aller Anwesenden sehen."

# game/scripts/c31/c31.rpy:4737
translate german c31s007_surgery_662bdd9c:

    # "There is relief, joy, and even a calculating look or two."
    "Es gibt Erleichterung, Freude und sogar den ein oder anderen berechnenden Blick."

# game/scripts/c31/c31.rpy:4738
translate german c31s007_surgery_eb37aced:

    # "There are even some inquisitive eyes studying your reaction."
    "Es gibt sogar einige neugierige Augen, die deine Reaktion studieren."

# game/scripts/c31/c31.rpy:4740
translate german c31s007_surgery_7c16b76a:

    # "Everyone slowly leaves the room, leaving you alone with [ama]."
    "Alle verlassen langsam den Raum und lassen dich mit [ama] allein."

# game/scripts/c31/c31.rpy:4742
translate german c31s007_surgery_cb167bc5:

    # ama "Are you going to stay here?"
    ama "Wirst du hier bleiben?"

# game/scripts/c31/c31.rpy:4743
translate german c31s007_surgery_4a0e9d80:

    # mc "Yes. I want to talk to Aunt [bet] and have her explain how everything went. I know I won't understand half of what she tells me, but..."
    mc "Ja. Ich möchte mit Tante [bet] sprechen und mir von ihr erklären lassen, wie alles gelaufen ist. Ich weiß, dass ich die Hälfte von dem, was sie mir sagt, nicht verstehen werde, aber..."

# game/scripts/c31/c31.rpy:4744
translate german c31s007_surgery_682c1495:

    # ama "I understand. I have to go to my office for a moment, but I'll be back as soon as I can."
    ama "Ich verstehe. Ich muss für einen Moment in mein Büro, aber ich bin so schnell wie möglich wieder da."

# game/scripts/c31/c31.rpy:4745
translate german c31s007_surgery_b44d7909:

    # mc "More interviews?"
    mc "Noch mehr Interviews?"

# game/scripts/c31/c31.rpy:4747
translate german c31s007_surgery_b0f46c42:

    # ama "No. Nobody wanted to do an interview today. Everyone would be thinking about the surgery."
    ama "Nein. Niemand wollte heute ein Interview machen. Alle würden nur an die Operation denken."

# game/scripts/c31/c31.rpy:4748
translate german c31s007_surgery_f25da4af:

    # ama "Most people like [gav]."
    ama "Die meisten Leute mögen [gav]."

# game/scripts/c31/c31.rpy:4749
translate german c31s007_surgery_1d39dbd0:

    # ama "I just have to check the guard shift changes."
    ama "Ich muss nur die Schichtwechsel der Wachen überprüfen."

# game/scripts/c31/c31.rpy:4750
translate german c31s007_surgery_1da6a712:

    # mc "I get it. See you later."
    mc "Verstehe. Bis später."

# game/scripts/c31/c31.rpy:4752
translate german c31s007_surgery_11598801:

    # "You're left alone in the waiting room. There's nothing to see and no new news."
    "Du bist allein im Wartezimmer. Es gibt nichts zu sehen und keine neuen Nachrichten."

# game/scripts/c31/c31.rpy:4753
translate german c31s007_surgery_df85b949:

    # "Just waiting for Aunt [bet]. You spend a few minutes staring at the door."
    "Du wartest nur auf Tante [bet]. Du verbringst ein paar Minuten damit, die Tür anzustarren."

# game/scripts/c31/c31.rpy:4756
translate german c31s007_surgery_d45f3ced:

    # "She appears fifteen minutes later. Time has gone back to moving at its usual speed."
    "Sie taucht fünfzehn Minuten später auf. Die Zeit vergeht wieder in ihrem normalen Tempo."

# game/scripts/c31/c31.rpy:4757
translate german c31s007_surgery_2d81eaa5:

    # bet "I didn't expect anyone to still be here. I just came for a coffee."
    bet "Ich hätte nicht erwartet, dass noch jemand hier ist. Ich bin nur für einen Kaffee gekommen."

# game/scripts/c31/c31.rpy:4758
translate german c31s007_surgery_be261e8b:

    # mc "Everything okay with the surgery?"
    mc "Alles in Ordnung mit der Operation?"

# game/scripts/c31/c31.rpy:4760
translate german c31s007_surgery_c9b11614:

    # bet "Everything's perfect. Even better than perfect. The rest of the surgeons are very good at what they do."
    bet "Alles ist perfekt. Sogar besser als perfekt. Die anderen Chirurgen sind sehr gut in dem, was sie tun."

# game/scripts/c31/c31.rpy:4761
translate german c31s007_surgery_f27c6efb:

    # bet "The kid is going to recover from the surgery sooner than I expected."
    bet "Der Kleine wird sich schneller von der Operation erholen, als ich erwartet habe."

# game/scripts/c31/c31.rpy:4762
translate german c31s007_surgery_7762f78f:

    # mc "That's good. How did everything go? What's the next step?"
    mc "Das ist gut. Wie ist alles gelaufen? Was ist der nächste Schritt?"

# game/scripts/c31/c31.rpy:4764
translate german c31s007_surgery_12e96dec:

    # "She explains how the surgery went. As you imagined, you don't understand even a quarter of what she's explaining."
    "Sie erklärt, wie die Operation verlaufen ist. Wie du dir schon dachtest, verstehst du nicht einmal ein Viertel von dem, was sie erklärt."

# game/scripts/c31/c31.rpy:4765
translate german c31s007_surgery_5569ce06:

    # bet "We'll keep [gav] under observation for a few days. We don't want the wound to get infected."
    bet "Wir werden [gav] ein paar Tage unter Beobachtung halten. Wir wollen nicht, dass sich die Wunde infiziert."

# game/scripts/c31/c31.rpy:4766
translate german c31s007_surgery_6ff9db01:

    # bet "With a little luck, we'll be able to turn on the arm in a week and see how he reacts."
    bet "Mit etwas Glück können wir den Arm in einer Woche einschalten und sehen, wie er reagiert."

# game/scripts/c31/c31.rpy:4767
translate german c31s007_surgery_d3e1e5ee:

    # mc "Will I be able to be there when you do it?"
    mc "Kann ich dabei sein, wenn ihr das macht?"

# game/scripts/c31/c31.rpy:4769
translate german c31s007_surgery_d68d4772:

    # bet "I hadn't thought about it, but I think it's a good idea for you to be there when we do it."
    bet "Darüber hatte ich noch nicht nachgedacht, aber ich denke, es ist eine gute Idee, wenn du dabei bist, wenn wir es tun."

# game/scripts/c31/c31.rpy:4770
translate german c31s007_surgery_2eddb174:

    # bet "The fact that you're the last one left here shows how much you care about this."
    bet "Die Tatsache, dass du als Letzter hier geblieben bist, zeigt, wie sehr dir das am Herzen liegt."

# game/scripts/c31/c31.rpy:4771
translate german c31s007_surgery_fa39a046:

    # bet "Someone is probably talking about it right now around the base."
    bet "Wahrscheinlich redet gerade jemand in der Basis darüber."

# game/scripts/c31/c31.rpy:4772
translate german c31s007_surgery_43bd1d06:

    # mc "I don't really care about that right now."
    mc "Das ist mir im Moment eigentlich ziemlich egal."

# game/scripts/c31/c31.rpy:4773
translate german c31s007_surgery_875b4e55:

    # mc "How are you doing?"
    mc "Wie geht es dir?"

# game/scripts/c31/c31.rpy:4775
translate german c31s007_surgery_a860f15f:

    # bet "Exhausted. But very happy. There was a moment when I thought we wouldn't make it."
    bet "Erschöpft. Aber sehr glücklich. Es gab einen Moment, in dem ich dachte, wir schaffen es nicht."

# game/scripts/c31/c31.rpy:4776
translate german c31s007_surgery_dae02f71:

    # bet "But everything turned out fine in the end."
    bet "Aber am Ende ist alles gut gegangen."

# game/scripts/c31/c31.rpy:4777
translate german c31s007_surgery_b77a74c6:

    # bet "Now I just want to take a shower. I can still feel the sweat running down my back."
    bet "Jetzt will ich einfach nur duschen. Ich spüre immer noch den Schweiß, der mir den Rücken runterläuft."

# game/scripts/c31/c31.rpy:4778
translate german c31s007_surgery_b5bc5456:

    # mc "Then I won't keep you any longer. I'll see you later so we can go home."
    mc "Dann halte ich dich nicht länger auf. Wir sehen uns später, damit wir nach Hause fahren können."

# game/scripts/c31/c31.rpy:4780
translate german c31s007_surgery_3a86df9c:

    # bet "I'm not going home. I want to stay here for the night in case there are any complications."
    bet "Ich fahre nicht nach Hause. Ich möchte die Nacht über hier bleiben, falls es Komplikationen gibt."

# game/scripts/c31/c31.rpy:4781
translate german c31s007_surgery_9ff6f9b6:

    # mc "But you're exhausted..."
    mc "Aber du bist erschöpft..."

# game/scripts/c31/c31.rpy:4782
translate german c31s007_surgery_d99a2dda:

    # bet "The rest of the surgeons are just as exhausted as I am. But it's my surgery."
    bet "Die restlichen Chirurgen sind genauso erschöpft wie ich. Aber es ist meine Operation."

# game/scripts/c31/c31.rpy:4784
translate german c31s007_surgery_59c27817:

    # mc "Thanks for everything, Aunt [bet]."
    mc "Danke für alles, Tante [bet]."

# game/scripts/c31/c31.rpy:4785
translate german c31s007_surgery_dafd98c2:

    # bet "Thank you for giving me the chance to help the boy."
    bet "Ich danke dir, dass du mir die Chance gegeben hast, dem Jungen zu helfen."

# game/scripts/c31/c31.rpy:4787
translate german c31s007_surgery_5eedca3f:

    # "You go back to your office and give the news to [lar]. Obviously, she already knew."
    "Du gehst zurück in dein Büro und überbringst [lar] die Neuigkeiten. Offensichtlich wusste sie es bereits."

# game/scripts/c31/c31.rpy:4789
translate german c31s007_surgery_cb4e7a9f:

    # "You sit behind your desk and stare at the walls for a while."
    "Du sitzt hinter deinem Schreibtisch und starrst eine Weile die Wände an."

# game/scripts/c31/c31.rpy:4790
translate german c31s007_surgery_a849c7e5:

    # "Now the waiting game begins."
    "Jetzt beginnt das große Warten."

# game/scripts/c31/c31.rpy:4795
translate german c31s007_ama_5e64d07e:

    # "After about 40 minutes..."
    "Nach etwa 40 Minuten ..."

# game/scripts/c31/c31.rpy:4796
translate german c31s007_ama_56411a58:

    # ama "I just talked to Aunt [bet]. She explained everything about the surgery."
    ama "Ich habe gerade mit Tante [bet] gesprochen. Sie hat mir alles über die Operation erklärt."

# game/scripts/c31/c31.rpy:4797
translate german c31s007_ama_3df02708:

    # ama "It's great that everything went so well."
    ama "Es ist toll, dass alles so gut gelaufen ist."

# game/scripts/c31/c31.rpy:4798
translate german c31s007_ama_6580b0cb:

    # mc "Absolutely. [gav] deserves it, and [eva] doesn't deserve to carry that guilt."
    mc "Absolut. [gav] hat es verdient, und [eva] hat es nicht verdient, diese Schuld mit sich herumzutragen."

# game/scripts/c31/c31.rpy:4799
translate german c31s007_ama_29adea49:

    # ama "[eva] is going to be very happy."
    ama "[eva] wird sehr glücklich sein."

# game/scripts/c31/c31.rpy:4802
translate german c31s007_ama_d527c7c8:

    # ama "Aunt [bet] told me she's going to spend the night at the medical facilities..."
    ama "Tante [bet] hat mir gesagt, dass sie die Nacht in der medizinischen Einrichtung verbringen wird ..."

# game/scripts/c31/c31.rpy:4803
translate german c31s007_ama_5f57d6d8:

    # ama "Do you want to go out for dinner in Oranjestad? You haven't had the chance to visit it yet..."
    ama "Möchtest du in Oranjestad essen gehen? Du hattest noch nicht die Gelegenheit, es dir anzusehen ..."

# game/scripts/c31/c31.rpy:4804
translate german c31s007_ama_b68ffdd9:

    # mc "I'd love to. And if it's not in the city, I don't care if it's on the beach, as long as it's with you."
    mc "Sehr gerne. Und wenn es nicht in der Stadt ist, ist es mir auch egal, ob es am Strand ist, solange ich bei dir bin."

# game/scripts/c31/c31.rpy:4806
translate german c31s007_ama_b28bb679:

    # ama "Great! Tell [aar] to take you home. I'm leaving now. I have some things to do!"
    ama "Großartig! Sag [aar], dass er dich nach Hause bringen soll. Ich fahre jetzt. Ich habe noch einiges zu erledigen!"

# game/scripts/c31/c31.rpy:4808
translate german c31s007_ama_6e734612:

    # "*Blam*"
    "*Knall*"

# game/scripts/c31/c31.rpy:4809
translate german c31s007_ama_ecc08f69:

    # mcp "(I'll take that as this is going to be our first real date.)"
    mcp "(Das fasse ich mal so auf, dass das unser erstes richtiges Date wird.)"

# game/scripts/c31/c31.rpy:4810
translate german c31s007_ama_ba089e8c:

    # ama "*Through the door* [lar], do you know if there's an iron at the CEO's house?"
    ama "*Durch die Tür* [lar], weißt du, ob es im Haus des CEOs ein Bügeleisen gibt?"

# game/scripts/c31/c31.rpy:4812
translate german c31s007_ama_d6744449:

    # "Upon arriving home..."
    "Als du zu Hause ankommst..."

# game/scripts/c31/c31.rpy:4813
translate german c31s007_ama_814504cd:

    # mc "[ama]?"
    mc "[ama]?"

# game/scripts/c31/c31.rpy:4814
translate german c31s007_ama_7395eff6:

    # ama "*From downstairs* I'm just finishing getting ready. Go take a shower if you want."
    ama "*Von unten* Ich mache mich nur noch fertig. Geh duschen, wenn du willst."

# game/scripts/c31/c31.rpy:4816
translate german c31s007_ama_df6011ca:

    # "After your shower, you go back to the kitchen and still find it empty."
    "Nach dem Duschen gehst du zurück in die Küche und findest sie immer noch leer vor."

# game/scripts/c31/c31.rpy:4817
translate german c31s007_ama_1d47d51e:

    # "So empty that there's no catering today. You assume [ama] told [lar]."
    "So leer, dass es heute kein Catering gibt. Du gehst davon aus, dass [ama] [lar] Bescheid gesagt hat."

# game/scripts/c31/c31.rpy:4818
translate german c31s007_ama_814504cd_1:

    # mc "[ama]?"
    mc "[ama]?"

# game/scripts/c31/c31.rpy:4819
translate german c31s007_ama_518ce32b:

    # ama "I'm on the terrace."
    ama "Ich bin auf der Terrasse."

# game/scripts/c31/c31.rpy:4825
translate german c31s007_ama_89600869:

    # ama "We can leave whenever you want. You are the one driving today."
    ama "Wir können los, wann immer du willst. Du fährst heute."

# game/scripts/c31/c31.rpy:4826
translate german c31s007_ama_685bab2d:

    # mc "You look incredibly gorgeous."
    mc "Du siehst unglaublich hinreißend aus."

# game/scripts/c31/c31.rpy:4829
translate german c31s007_ama_46b42504:

    # ama "Well, I'll see you in a bit to head home."
    ama "Also gut, wir sehen uns dann gleich für den Heimweg."

# game/scripts/c31/c31.rpy:4830
translate german c31s007_ama_5e2b3b52:

    # mc "Perfect, [ama]."
    mc "Perfekt, [ama]."

translate german strings:

    # game/scripts/c31/c31.rpy:30
    old "Asistente"
    new "Assistent"
