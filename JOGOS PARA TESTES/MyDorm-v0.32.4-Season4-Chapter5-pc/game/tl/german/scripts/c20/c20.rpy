    # emmdd "¡Sí! ¡Dame toda tu leche!"
    emmdd "Ja! Gib mir deine ganze Milch!"

# game/scripts/c20/c20.rpy:2108
translate german c20s004_Faces_09febfda:

    # eridd "¡Cubre nuestras caras con tu semilla!"
    eridd "Bedeckt unsere Gesichter mit eurem Samen!"

# game/scripts/c20/c20.rpy:2110
translate german c20s004_Faces_b911ac06:

    # eridd "Ha sido fantástico, Vilfredo..."
    eridd "Es war fantastisch, Vilfredo..."

# game/scripts/c20/c20.rpy:2111
translate german c20s004_Faces_0b2eb5fd:

    # emmdd "Una de las mejores noches de nuestra vida."
    emmdd "Eine der schönsten Nächte unseres Lebens."

# game/scripts/c20/c20.rpy:2114
translate german c20s004_Faces_39ce8749:

    # "Sin que te sorprenda nada de estas dos mujeres, empiezan a lamerse todo tu semen de sus caras hasta no dejar ni una gota."
    "Nichts, was diese beiden Frauen tun, wird Sie überraschen; sie lecken sich Ihr gesamtes Sperma vom Gesicht, bis kein einziger Tropfen mehr übrig ist."

# game/scripts/c20/c20.rpy:2117
translate german c20s004_Faces_8cf5093c:

    # "Se dirigen al armario de al lado de la chimenea, donde Marzia te ha dicho que están guardadas las toallas, y se limpian el semen de sus caras."
    "Sie gehen zu dem Schrank neben dem Kamin, wo laut Marzia die Handtücher aufbewahrt werden, und wischen sich das Sperma aus dem Gesicht."

# game/scripts/c20/c20.rpy:2121
translate german c20s004_Tits_a4af3390:

    # mcdd "¡Mpfft!"
    mcdd "Mpfft!"

# game/scripts/c20/c20.rpy:2122
translate german c20s004_Tits_4d42103a:

    # "Explotas llenando sus tetas de semen alternativamente."
    "Du kommst zum Höhepunkt und füllst ihre Brüste abwechselnd mit Samen."

# game/scripts/c20/c20.rpy:2123
translate german c20s004_Tits_1929ea9e:

    # emmdd "¡Sí! ¡Dame toda tu leche!"
    emmdd "Ja! Gib mir deine ganze Milch!"

# game/scripts/c20/c20.rpy:2124
translate german c20s004_Tits_15986d89:

    # eridd "¡Cubre nuestras tetas con tu semilla!"
    eridd "Bedecke unsere Brüste mit deinem Samen!"

# game/scripts/c20/c20.rpy:2126
translate german c20s004_Tits_b911ac06:

    # eridd "Ha sido fantástico, Vilfredo..."
    eridd "Es war fantastisch, Vilfredo..."

# game/scripts/c20/c20.rpy:2127
translate german c20s004_Tits_0b2eb5fd:

    # emmdd "Una de las mejores noches de nuestra vida."
    emmdd "Eine der schönsten Nächte unseres Lebens."

# game/scripts/c20/c20.rpy:2130
translate german c20s004_Tits_0dc3a668:

    # "Sin que te sorprenda nada de estas dos mujeres, empiezan a lamerse todo tu semen de sus tetas hasta no dejar ni una gota."
    "Nichts, was diese beiden Frauen tun, wird Sie überraschen; sie lecken Ihr gesamtes Sperma von ihren Brüsten, bis kein einziger Tropfen mehr übrig ist."

# game/scripts/c20/c20.rpy:2133
translate german c20s004_Tits_8cf5093c:

    # "Se dirigen al armario de al lado de la chimenea, donde Marzia te ha dicho que están guardadas las toallas, y se limpian el semen de sus caras."
    "Sie gehen zu dem Schrank neben dem Kamin, wo laut Marzia die Handtücher aufbewahrt werden, und wischen sich das Sperma aus dem Gesicht."

# game/scripts/c20/c20.rpy:2153
translate german c20s004_Farewell_e700786c:

    # dap "Por la mañana canta un gallo."
    dap "Ein Hahn kräht am Morgen."

# game/scripts/c20/c20.rpy:2158
translate german c20s004_Farewell_7f98e678:

    # dap "Vilfredo se despierta solo en su cama."
    dap "Vilfredo wacht allein in seinem Bett auf."

# game/scripts/c20/c20.rpy:2161
translate german c20s004_Farewell_532c4579:

    # dap "Llaman a la puerta."
    dap "Es klopft an der Tür."

# game/scripts/c20/c20.rpy:2163
translate german c20s004_Farewell_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c20/c20.rpy:2164
translate german c20s004_Farewell_2bc4d699:

    # marziad "*A través de la puerta* Soy Marzia. ¿Puedo pasar?"
    marziad "*Durch die Tür* Ich bin's, Marzia. Darf ich hereinkommen?"

# game/scripts/c20/c20.rpy:2165
translate german c20s004_Farewell_47adf7d8:

    # mcd "Sí, pasa, por favor."
    mcd "Ja, bitte kommen Sie herein."

# game/scripts/c20/c20.rpy:2167
translate german c20s004_Farewell_d104f7f1:

    # marziad "Buenos días, Vilfredo. El desayuno está listo y os he preparado unas provisiones para vuestro viaje."
    marziad "Guten Morgen, Vilfredo. Das Frühstück ist fertig und ich habe einige Vorräte für deine Reise vorbereitet."

# game/scripts/c20/c20.rpy:2168
translate german c20s004_Farewell_d3d786de:

    # marziad "Pia me ha dicho que te las de a ti. No entiendo por qué. Las tienes abajo, al lado de la barra."
    marziad "Pia hat mir gesagt, ich soll sie dir geben. Ich verstehe nicht, warum. Sie sind unten, neben der Bar."

# game/scripts/c20/c20.rpy:2169
translate german c20s004_Farewell_845b9150:

    # mcd "Gracias, Marzia. Ahora me vestiré e iré a recogerlas."
    mcd "Danke, Marzia. Ich ziehe mich jetzt an und hole sie ab."

# game/scripts/c20/c20.rpy:2171
translate german c20s004_Farewell_c6264e7c:

    # dap "*En el mundo real* Vilfredo y Fang se reúnen en la sala común para desayunar antes de partir."
    dap "*In der realen Welt* treffen sich Vilfredo und Fang vor ihrer Abreise im Gemeinschaftsraum zum Frühstück."

# game/scripts/c20/c20.rpy:2172
translate german c20s004_Farewell_d6ecf2aa:

    # mcd "Marzia nos ha preparado unas provisiones para el viaje. Acuérdate de agradecérselo."
    mcd "Marzia hat für uns einige Vorräte für die Reise vorbereitet. Vergiss nicht, ihr zu danken."

# game/scripts/c20/c20.rpy:2173
translate german c20s004_Farewell_28f876f8:

    # madd "No lo dudes. Deberíamos acabar esto e irnos si no queremos que nos pille la lluvia en el camino. Lloverá hacia mediodía."
    madd "Zögere nicht. Wir sollten das hier beenden und losfahren, wenn wir nicht unterwegs in den Regen geraten wollen. Es wird gegen Mittag regnen."

# game/scripts/c20/c20.rpy:2174
translate german c20s004_Farewell_9bc9c65b:

    # mcd "Perfecto. ¿Tienes que coger algo de tu habitación? Yo lo he bajado todo ya."
    mcd "Perfekt. Brauchst du noch etwas aus deinem Zimmer? Ich habe schon alles runtergebracht."

# game/scripts/c20/c20.rpy:2176
translate german c20s004_Farewell_0184d086:

    # madd "Yo también. Júpiter está fuera guardando mis alforjas."
    madd "Ich auch. Jupiter bewacht draußen meine Satteltaschen."

# game/scripts/c20/c20.rpy:2177
translate german c20s004_Farewell_59d20dac:

    # mcdd "Pues cuando quieras, nos podemos ir."
    mcdd "Nun, wann immer du willst, können wir gehen."

# game/scripts/c20/c20.rpy:2179
translate german c20s004_Farewell_18598a42:

    # dap "*En el mundo real* Os despedís de Marzia..."
    dap "*In der realen Welt* verabschieden Sie sich von Marzia..."

# game/scripts/c20/c20.rpy:2180
translate german c20s004_Farewell_3e35ca29:

    # mad "*En el mundo real* Nos aseguramos de darle las gracias por las provisiones."
    mad "*In der Realität* haben wir uns natürlich für die Sachspenden bedankt."

# game/scripts/c20/c20.rpy:2182
translate german c20s004_Farewell_b032d0ca:

    # mad "*En el mundo real* También nos despedimos de Alba, la chica a la que gritó que se ocupara de los clientes cuando llegaron los BDSM. Supongo que debe ser su ayudante."
    mad "*In der realen Welt* verabschiedeten wir uns auch von Alba, dem Mädchen, das er angeschrien hatte, sie solle sich um die Kunden kümmern, als die BDSM-Typen eintrafen. Ich schätze, sie ist wohl seine Assistentin."

# game/scripts/c20/c20.rpy:2183
translate german c20s004_Farewell_d673b801:

    # mc "*En el mundo real* Ni siquiera me acordaba de ella... no hemos interactuado con ella para nada."
    mc "*In der Realität* konnte ich mich gar nicht an sie erinnern... wir hatten überhaupt keinen Kontakt zu ihr."

# game/scripts/c20/c20.rpy:2184
translate german c20s004_Farewell_c8543d85:

    # mad "*En el mundo real* Bueno, se supone que si es la camarera de la taberna, nos habrá traído comida o bebida."
    mad "*In der Realität* Nun ja, wenn sie die Kellnerin der Taverne ist, hätte sie uns Essen oder Getränke bringen sollen."

# game/scripts/c20/c20.rpy:2185
translate german c20s004_Farewell_b2ad90a0:

    # dap "*En el mundo real* Bien visto, Maddie. Scarlett, [eri], y [emm] casi siempre se olvidan de ella."
    dap "*In der realen Welt* Gut beobachtet, Maddie. Scarlett, [eri] und [emm] vergessen sie fast immer."

# game/scripts/c20/c20.rpy:2186
translate german c20s004_Farewell_785efda1:

    # dap "*En el mundo real* No hay rastro de Beagan, Aelia, Paula, o Pia."
    dap "*In der realen Welt* gibt es keine Spur von Beagan, Aelia, Paula oder Pia."

# game/scripts/c20/c20.rpy:2187
translate german c20s004_Farewell_11698653:

    # mc "*En el mundo real* Le pedimos a Marzia que nos despida de ellas y nos vamos a los establos. No olvido las provisiones."
    mc "*In der Realität* bitten wir Marzia, uns von ihnen zu verabschieden, und begeben uns zu den Ställen. Ich habe die Vorräte nicht vergessen."

# game/scripts/c20/c20.rpy:2189
translate german c20s004_Farewell_a38145c0:

    # dap "*En el mundo real* De camino a los establos veis a Thiel y el chico de la alabarda charlando, sentados en un banco."
    dap "*In der realen Welt* Auf dem Weg zu den Ställen sieht man Thiel und den Jungen mit der Hellebarde auf einer Bank sitzen und sich unterhalten."

# game/scripts/c20/c20.rpy:2191
translate german c20s004_Farewell_60a85db1:

    # dap "*En el mundo real* ¡Están cogidos de la mano! *Risa* Parece que tu fallo crítico ha creado una pareja en el pueblo."
    dap "*In der Realität* Sie halten Händchen! *Gelächter* Sieht so aus, als hätte dein verheerendes Versagen ein Pärchen in der Stadt hervorgebracht."

# game/scripts/c20/c20.rpy:2193
translate german c20s004_Farewell_885f9659:

    # mc "*En el mundo real* Me acerco a ellos para despedirnos... pero solo si no parece que vaya a interrumpir algo."
    mc "*In der realen Welt* gehe ich auf sie zu, um mich zu verabschieden... aber nur, wenn es nicht so aussieht, als würde ich etwas unterbrechen."

# game/scripts/c20/c20.rpy:2194
translate german c20s004_Farewell_166b13f1:

    # mad "*En el mundo real* Yo también me acerco. Quiero despedirme de los tortolitos."
    mad "*In der realen Welt* komme ich auch. Ich möchte mich von den Turteltauben verabschieden."

# game/scripts/c20/c20.rpy:2196
translate german c20s004_Farewell_87c418f9:

    # mcd "Thiel, [wil], nos vamos ya. Un placer haberos conocido."
    mcd "Thiel, wir verabschieden uns jetzt. Es war mir ein Vergnügen, Sie kennenzulernen."

# game/scripts/c20/c20.rpy:2197
translate german c20s004_Farewell_f149b226:

    # madd "Lo mismo digo, chicos."
    madd "Bei mir ist es genauso, Leute."

# game/scripts/c20/c20.rpy:2199
translate german c20s004_Farewell_360e7491:

    # thi "Muchas gracias por lo de ayer. Es una lástima que no se puedan quedar ustedes en el pueblo. La Señora Paula ya nos ha dicho que se tienen que marchar."
    thi "Vielen Dank für gestern. Schade, dass Sie nicht im Dorf bleiben können. Frau Paula hat uns bereits mitgeteilt, dass Sie abreisen müssen."

# game/scripts/c20/c20.rpy:2201
translate german c20s004_Farewell_c34ebee4:

    # madd "Sí, muchacha. Vamos a buscar trabajo a Vindobona."
    madd "Ja, Mädchen. Wir werden in Vindobona nach Arbeit suchen."

# game/scripts/c20/c20.rpy:2202
translate german c20s004_Farewell_fb4cbe08:

    # mcd "Nos han dicho que aquí no vamos a encontrar trabajo escoltando caravanas."
    mcd "Uns wurde gesagt, dass wir hier keine Arbeit als Wohnwagenbegleiter finden werden."

# game/scripts/c20/c20.rpy:2204
translate german c20s004_Farewell_27f53f3c:

    # wil "Pero aquí hay mucho trabajo si lo quieren, hay muchas granjas sin manos que las trabajen. O podrían trabajar para las Protectoras."
    wil "Aber es gibt hier genug Arbeit, wenn sie wollen; es gibt viele Bauernhöfe ohne Arbeitskräfte. Oder sie könnten in Tierheimen arbeiten."

# game/scripts/c20/c20.rpy:2205
translate german c20s004_Farewell_3dcff2aa:

    # mcd "Suena tentador, pero no es el tipo de trabajo que buscamos ahora mismo."
    mcd "Das klingt verlockend, aber es ist nicht die Art von Job, die wir momentan suchen."

# game/scripts/c20/c20.rpy:2207
translate german c20s004_Farewell_af9de7cd:

    # thi "Es una lástima. Echaré de menos a Júpiter, Señora. Me cae muy bien. Me ha pedido que le dé las gracias por lo de Capua. No me ha dicho de qué se trata."
    thi "Das ist schade. Ich werde Jupiter vermissen, Madam. Ich mochte ihn sehr. Er bat mich, Ihnen für Capua zu danken. Er hat mir nicht gesagt, worum es dabei ging."

# game/scripts/c20/c20.rpy:2209
translate german c20s004_Farewell_724d248b:

    # madd "¿Qué? ¿Puedes hablar con Júpiter?"
    madd "Was? Kann man mit Jupiter sprechen?"

# game/scripts/c20/c20.rpy:2211
translate german c20s004_Farewell_cdd8f6cd:

    # thi "Claro... Soy una chica gato, al fin y al cabo. Habla con un acento raro, pero nos entendemos."
    thi "Na klar... ich bin schließlich ein Katzenmädchen. Sie spricht mit einem komischen Akzent, aber wir verstehen uns."

# game/scripts/c20/c20.rpy:2212
translate german c20s004_Farewell_5e9087b4:

    # mcd "*Risa* Me parece la mejor explicación que he oído nunca."
    mcd "*lacht* Das ist die beste Erklärung, die ich je gehört habe."

# game/scripts/c20/c20.rpy:2213
translate german c20s004_Farewell_8a10a3d2:

    # thi "Él le entiende casi todo lo que dice, al menos cuando habla Latín, pero no puede contestarle."
    thi "Er versteht fast alles, was sie sagt, zumindest wenn sie Latein spricht, aber er kann ihr nicht antworten."

# game/scripts/c20/c20.rpy:2215
translate german c20s004_Farewell_d58e1c0c:

    # mad "*En el mundo real* Abrazo a Júpiter."
    mad "*In der realen Welt* umarme ich Jupiter."

# game/scripts/c20/c20.rpy:2216
translate german c20s004_Farewell_6f8bb913:

    # madd "Sabes que eres mi compañero, gatito."
    madd "Du weißt, dass du meine Partnerin bist, Kätzchen."

# game/scripts/c20/c20.rpy:2217
translate german c20s004_Farewell_3fb43df7:

    # jup "*Ronroneo*"
    jup "*Schnurren*"

# game/scripts/c20/c20.rpy:2218
translate german c20s004_Farewell_2d298b27:

    # thi "Dice que no podría tener una compañera mejor."
    thi "Er sagt, er könnte sich keinen besseren Partner wünschen."

# game/scripts/c20/c20.rpy:2220
translate german c20s004_Farewell_f5fac812:

    # mcd "Sólo queríamos despedirnos, chicos. Ha sido un placer conoceros."
    mcd "Wir wollten uns nur noch verabschieden, Leute. Es war uns ein Vergnügen, euch kennenzulernen."

# game/scripts/c20/c20.rpy:2222
translate german c20s004_Farewell_fd570581:

    # wil "Guardaré su moneda siempre, Señor. Muchas gracias."
    wil "Ich werde Ihre Münze für immer behalten, mein Herr. Vielen Dank."

# game/scripts/c20/c20.rpy:2223
translate german c20s004_Farewell_8d9f58ec:

    # mcd "*Susurrando* Si puedo darte un consejo, ponte un nombre más fácil de recordar, [wil]."
    mcd "*Flüsternd* Wenn ich Ihnen einen Rat geben darf: Wählen Sie einen Namen, den man sich leichter merken kann."

# game/scripts/c20/c20.rpy:2224
translate german c20s004_Farewell_e0e0f25c:

    # mc "*En el mundo real* *Risa*"
    mc "*In der realen Welt* *Lachen*"

# game/scripts/c20/c20.rpy:2226
translate german c20s004_Farewell_6cb39545:

    # wil "¡Oh, lo haré! Cuando tenga mi propia AVN."
    wil "Oh ja, das werde ich! Sobald ich meinen eigenen AVN-Kanal habe."

# game/scripts/c20/c20.rpy:2228
translate german c20s004_Farewell_ae66b4fc:

    # mc "*En el mundo real* ¿Qué? ¿AVN?" (multiple=2)
    mc "*In der realen Welt* Was? AVN?" (multiple=2)

# game/scripts/c20/c20.rpy:2229
translate german c20s004_Farewell_d1c1869d:

    # mcd "¿Qué quieres decir con AVN?" (multiple=2)
    mcd "Was verstehen Sie unter AVN?" (multiple=2)

# game/scripts/c20/c20.rpy:2231
translate german c20s004_Farewell_2f8db68f:

    # wil "Oh, sí, Señor. Agrum Vaccis Nostrum. Nuestro propio campo con vacas, para alimentar a mi familia."
    wil "Oh ja, Sir. Agrum Vaccis Nostrum. Unsere eigene Weide mit Kühen, um meine Familie zu ernähren."

# game/scripts/c20/c20.rpy:2232
translate german c20s004_Farewell_11ebef1d:

    # mcd "Me habías asustado, creía que te referías a otra cosa..."
    mcd "Du hast mich erschreckt, ich dachte, du meintest etwas anderes..."

# game/scripts/c20/c20.rpy:2233
translate german c20s004_Farewell_27c39f60:

    # dap "*En el mundo real* *Risa* Eso es porque tienes una mente traviesa."
    dap "*In der realen Welt* *lacht* Das liegt daran, dass du einen schelmischen Geist hast."

# game/scripts/c20/c20.rpy:2235
translate german c20s004_Farewell_b64267a5:

    # thi "No queremos entretenerles más, o si no van a llegar cuando las puertas de Vindobona ya estén cerradas."
    thi "Wir wollen Sie nicht länger aufhalten, sonst kommen Sie an, wenn die Türen von Vindobona bereits geschlossen sind."

# game/scripts/c20/c20.rpy:2236
translate german c20s004_Farewell_8da3180b:

    # mcd "Gracias, Thiel. Si volvemos a hacer esta ruta pararemos a saludaros."
    mcd "Danke, Thiel. Wenn wir diese Strecke noch einmal fahren, halten wir an, um dich zu begrüßen."

# game/scripts/c20/c20.rpy:2237
translate german c20s004_Farewell_7e1b4108:

    # madd "Cuidaos, chicos."
    madd "Passt auf euch auf, Jungs."

# game/scripts/c20/c20.rpy:2238
translate german c20s004_Farewell_93865483:

    # wil "Tengan cuidado ustedes en el camino. A veces... pasan cosas... y los viajeros desaparecen."
    wil "Seien Sie vorsichtig im Straßenverkehr. Manchmal passieren Dinge, und Reisende verschwinden spurlos."

# game/scripts/c20/c20.rpy:2240
translate german c20s004_Farewell_e7e1a826:

    # dap "*En el mundo real* Cuando llegáis a los establos, veis que Paula, Aelia, Beagan y Pia están allí. Esta vez sin armaduras."
    dap "*In der realen Welt* Als du die Ställe erreichst, siehst du, dass Paula, Aelia, Beagan und Pia dort sind. Diesmal ohne ihre Rüstungen."

# game/scripts/c20/c20.rpy:2242
translate german c20s004_Farewell_247c5474:

    # centered "{size=+20}{b}DÍA 21 – LUNES{/b}{/size}"
    centered "{size=+20}{b}TAG 21 – MONTAG{/b}{/size}"

# game/scripts/c20/c20.rpy:2244
translate german c20s004_Farewell_b7f824e7:

    # dapd "Creía que habíais decidido quedaros."
    dapd "Ich dachte, du hättest dich entschieden zu bleiben."

# game/scripts/c20/c20.rpy:2246
translate german c20s004_Farewell_3868638f:

    # erid "Si nosotras tuviéramos que ir a Vindobona, Pia nos hubiera hecho salir al amanecer."
    erid "Wenn wir nach Vindobona hätten fahren müssen, hätte Pia uns gezwungen, im Morgengrauen aufzubrechen."

# game/scripts/c20/c20.rpy:2248
translate german c20s004_Farewell_8a2eb5dd:

    # scad "Y se hubiera pasado el camino quejándose de que no había dormido suficiente."
    scad "Und er hätte die ganze Reise damit verbracht, sich darüber zu beklagen, dass er nicht genug geschlafen habe."

# game/scripts/c20/c20.rpy:2250
translate german c20s004_Farewell_2991cdd8:

    # emmd "No os metáis con Pia. Al menos nos evita tener que hacer todos los cálculos de las provisiones que necesitamos."
    emmd "Leg dich nicht mit Pia an. Wenigstens erspart sie uns die ganzen Berechnungen für die benötigten Vorräte."

# game/scripts/c20/c20.rpy:2252
translate german c20s004_Farewell_ef93e412:

    # mad "Muchas gracias por las cervezas de anoche, chicas."
    mad "Vielen Dank für die Biere gestern Abend, Mädels."

# game/scripts/c20/c20.rpy:2253
translate german c20s004_Farewell_24aa2dc7:

    # mcd "Y por lo de después... la cena... me refiero..."
    mcd "Und was danach geschah... beim Abendessen... ich meine..."

# game/scripts/c20/c20.rpy:2255
translate german c20s004_Farewell_5c3bfa02:

    # emmd "Hemos ensillado vuestros caballos..."
    emmd "Wir haben Ihre Pferde gesattelt..."

# game/scripts/c20/c20.rpy:2256
translate german c20s004_Farewell_fca62baf:

    # erid "Y os hemos puesto un par de mantas extra, en caso de que encontréis una caravana que vaya más al norte de Vindobona. Hace frío allí."
    erid "Und wir haben ein paar zusätzliche Decken für Sie eingepackt, falls Sie auf einen Wohnwagen treffen, der weiter nördlich von Vindobona unterwegs ist. Dort ist es kalt."

# game/scripts/c20/c20.rpy:2257
translate german c20s004_Farewell_9555181e:

    # dapd "Si volvéis a pasar por Novum Templum, no os olvidéis de parar a saludar."
    dapd "Sollten Sie einmal wieder einmal in der Nähe von Novum Templum sein, vergessen Sie nicht, anzuhalten und Hallo zu sagen."

# game/scripts/c20/c20.rpy:2258
translate german c20s004_Farewell_91d0d3fe:

    # scad "Y a traernos noticias de lo que pasa en el resto del Imperio. Casi no nos enteramos de nada aquí."
    scad "Und berichtet uns, was im Rest des Imperiums vor sich geht. Wir hören hier ja kaum etwas."

# game/scripts/c20/c20.rpy:2262
translate german c20s004_Farewell_5b196794:

    # mad "¿Queda mucho, [dap]? Mañana me tengo que levantar pronto para abrir la tienda."
    mad "Ist es viel länger, [dap]? Ich muss morgen früh aufstehen, um den Laden zu öffnen."

# game/scripts/c20/c20.rpy:2263
translate german c20s004_Farewell_2c223719:

    # mad "No quiero estropear la partida, pero si va a durar mucho más, ¿podríamos dejarlo para otro día?"
    mad "Ich möchte das Spiel nicht spoilern, aber falls es noch viel länger dauert, könnten wir es auf einen anderen Tag verschieben?"

# game/scripts/c20/c20.rpy:2265
translate german c20s004_Farewell_7e0c9c16:

    # dap "Solo quedan diez minutos a lo sumo. Vamos a acelerar un poco."
    dap "Es bleiben höchstens noch zehn Minuten. Lasst uns die Sache etwas beschleunigen."

# game/scripts/c20/c20.rpy:2266
translate german c20s004_Farewell_04496536:

    # dap "Acabáis las despedidas y emprendéis camino. Es un día soleado. Parece que la amenaza de lluvia va desapareciendo tal como vais hacia el norte."
    dap "Du verabschiedest dich und machst dich auf den Weg. Es ist ein sonniger Tag. Die Regenwahrscheinlichkeit scheint zu schwinden, je weiter du nach Norden fährst."

# game/scripts/c20/c20.rpy:2269
translate german c20s004_Farewell_03ac580c:

    # emm "Vaya, yo quería despedirme de Vilfredo como es debido."
    emm "Nun ja, ich wollte mich gebührend von Vilfredo verabschieden."

# game/scripts/c20/c20.rpy:2271
translate german c20s004_Farewell_6f17ff93:

    # eri "[emm], Maddie es la única aquí que tiene que madrugar. Tenemos que adaptar la partida a ella."
    eri "[emm], Maddie ist die Einzige hier, die früh aufstehen muss. Wir müssen das Spiel an sie anpassen."

# game/scripts/c20/c20.rpy:2272
translate german c20s004_Farewell_00b68d56:

    # eri "Y ni se te ocurra sentirte mal, Maddie. Lo hacemos encantadas."
    eri "Und mach dir bloß keine Sorgen, Maddie. Wir machen das gern."

# game/scripts/c20/c20.rpy:2274
translate german c20s004_Farewell_9780c57c:

    # mad "Gracias, [eri]."
    mad "Vielen Dank, [eri]."

# game/scripts/c20/c20.rpy:2276
translate german c20s004_Farewell_7109b629:

    # dap "Bueno, vamos a acelerar un poco."
    dap "Okay, lasst uns die Sache etwas beschleunigen."

# game/scripts/c20/c20.rpy:2277
translate german c20s004_Farewell_d1e6de3e:

    # dap "Cuando lleváis un par de horas cabalgando oís un ruido. Tirad por Percepción."
    dap "Nach ein paar Stunden Fahrt hörst du ein Geräusch. Würfle auf Wahrnehmung."

# game/scripts/c20/c20.rpy:2279
translate german c20s004_Farewell_b3015543:

    # mad "15. Con los bonos sumados, 18."
    mad "15. Mit den hinzugefügten Boni, 18."

# game/scripts/c20/c20.rpy:2280
translate german c20s004_Farewell_2012bbd5:

    # mc "12... ¿qué bonos había que sumar?... Ah, sí, Sabiduría. No tengo bono. 12."
    mc "12… Welche Boni musste ich hinzufügen?… Ach ja, Weisheit. Ich habe keinen Bonus. 12."

# game/scripts/c20/c20.rpy:2283
translate german c20s004_Farewell_32adb331:

    # dap "*En el mundo real* Miráis al cielo, hacia el Norte, y veis un dragón, rojo infernal, volando hacia el Oeste."
    dap "*In der realen Welt* blickst du zum Himmel, Richtung Norden, und siehst einen höllisch roten Drachen, der Richtung Westen fliegt."

# game/scripts/c20/c20.rpy:2284
translate german c20s004_Farewell_767472c8:

    # dap "*En el mundo real* Maddie, tu dirías que es un ejemplar muy viejo, y que llevaba algo en las garras, pero no puedes percibir qué es."
    dap "*In der realen Welt* Maddie, würdest du sagen, dass es sich um ein sehr altes Exemplar handelt, das etwas in seinen Klauen trägt, aber du kannst nicht erkennen, was es ist."

# game/scripts/c20/c20.rpy:2285
translate german c20s004_Farewell_52e72fa8:

    # dap "*En el mundo real* Además, ves al Noreste una pequeña columna de humo."
    dap "*In der Realität* sieht man außerdem eine kleine Rauchsäule im Nordosten."

# game/scripts/c20/c20.rpy:2287
translate german c20s004_Farewell_b69bc0a5:

    # madd "¿Has visto el dragón?"
    madd "Hast du den Drachen gesehen?"

# game/scripts/c20/c20.rpy:2288
translate german c20s004_Farewell_d8710b26:

    # mcd "Nunca había visto uno. Creo que será difícil olvidarlo..."
    mcd "Ich hatte noch nie zuvor einen gesehen. Ich glaube, ich werde ihn so schnell nicht vergessen..."

# game/scripts/c20/c20.rpy:2290
translate german c20s004_Farewell_919b1d43:

    # madd "Hay humo allí. Deberíamos acercarnos."
    madd "Da ist Rauch. Wir sollten näher herangehen."

# game/scripts/c20/c20.rpy:2291
translate german c20s004_Farewell_bfd38439:

    # mcd "Te sigo. A lo mejor alguien necesita ayuda."
    mcd "Ich folge dir. Vielleicht braucht jemand Hilfe."

# game/scripts/c20/c20.rpy:2293
translate german c20s004_Farewell_3dc7746f:

    # madd "Por aquí. Este camino parece llevar hacia el humo."
    madd "Hier entlang. Dieser Weg scheint zum Rauch zu führen."

# game/scripts/c20/c20.rpy:2295
translate german c20s004_Farewell_7007417b:

    # dap "*En el mundo real* Llegáis a un claro al lado del camino, donde alguien ha acampado para comer."
    dap "*In der realen Welt* Sie erreichen eine Lichtung am Straßenrand, wo jemand sein Lager aufgeschlagen hat, um zu essen."

# game/scripts/c20/c20.rpy:2296
translate german c20s004_Farewell_d3047ce0:

    # dap "*En el mundo real* No hay nadie, pero el fuego está encendido aún con carne en el espeto. Obiamente, la columna de humo salía de aquí."
    dap "*In der Realität* ist hier niemand, aber das Feuer brennt noch immer mit Fleisch am Spieß. Offensichtlich kam die Rauchsäule von hier."

# game/scripts/c20/c20.rpy:2297
translate german c20s004_Farewell_9bec8cf5:

    # mad "*En el mundo real* Busco huellas. 8+3. 11. No creo que encuentre nada demasiado interesante."
    mad "*In der realen Welt* suche ich nach Fußspuren. 8+3. 11. Ich glaube nicht, dass ich etwas besonders Interessantes finden werde."

# game/scripts/c20/c20.rpy:2298
translate german c20s004_Farewell_8d374f57:

    # dap "*En el mundo real* Ves huellas que van en varias direcciones. El grupo más numeroso va al Norte."
    dap "*In der realen Welt* sieht man Fußspuren in verschiedene Richtungen. Die größte Gruppe führt nach Norden."

# game/scripts/c20/c20.rpy:2300
translate german c20s004_Farewell_24c78b59:

    # madd "El grupo que había acampado aquí se ha separado. Vamos a seguir las huellas que van al Norte."
    madd "Die Gruppe, die hier ihr Lager aufgeschlagen hatte, hat sich aufgeteilt. Wir werden den Spuren folgen, die nach Norden führen."

# game/scripts/c20/c20.rpy:2301
translate german c20s004_Farewell_550def09:

    # mcd "Como quieras. Tu te mueves por los bosques mejor que yo."
    mcd "Ganz wie du willst. Du bewegst dich besser durch den Wald als ich."

# game/scripts/c20/c20.rpy:2303
translate german c20s004_Farewell_56891888:

    # dap "*En el mundo real* Llegáis a un claro en el que encontráis una escena dantesca. Hay un par de cadáveres quemados. Uno boca arriba y el otro boca abajo."
    dap "*In der realen Welt* Du erreichst eine Lichtung und findest dort einen grauenhaften Anblick vor. Zwei verbrannte Leichen liegen dort. Eine liegt mit dem Gesicht nach oben, die andere mit dem Gesicht nach unten."

# game/scripts/c20/c20.rpy:2304
translate german c20s004_Farewell_b1bfdb6e:

    # dap "*En el mundo real* No parecen haber sido atacados aquí, sino un poco antes, donde habéis visto hierba quemada. Parece que han corrido hasta aquí antes de morir."
    dap "*In der realen Welt* scheinen sie nicht hier, sondern etwas früher angegriffen worden zu sein, dort, wo du das verbrannte Gras gesehen hast. Anscheinend sind sie hierher geflohen, bevor sie starben."

# game/scripts/c20/c20.rpy:2305
translate german c20s004_Farewell_4a2eb8a8:

    # dap "*En el mundo real* Reconocéis la armadura que llevaban los alabarderos en uno de los cadáveres. No lleva la capa."
    dap "*In der realen Welt* erkennt man an einer der Leichen die Rüstung der Hellebardenträger. Er trägt keinen Umhang."

# game/scripts/c20/c20.rpy:2306
translate german c20s004_Farewell_5820e84c:

    # mc "*En el mundo real* Le doy la vuelta al otro."
    mc "*In der Realität* drehe ich die andere um."

# game/scripts/c20/c20.rpy:2308
translate german c20s004_Farewell_a9dc35cc:

    # dap "*En el mundo real* Incluso antes de darle la vuelta, reconoces la armadura. Es la misma que llevaba Euricus, aunque le faltan algunas piezas."
    dap "*In der realen Welt* Schon bevor man sie umdreht, erkennt man die Rüstung. Es ist dieselbe, die Euricus trug, obwohl einige Teile fehlen."

# game/scripts/c20/c20.rpy:2309
translate german c20s004_Farewell_48cc2da4:

    # dap "*En el mundo real* En el momento en que le das la vuelta, lo reconoces pese a que está bastante churruscado."
    dap "*In der Realität* Sobald man es umdreht, erkennt man es, obwohl es ziemlich verbrannt ist."

# game/scripts/c20/c20.rpy:2310
translate german c20s004_Farewell_cd7b56ba:

    # mad "*En el mundo real* ¿Está el cadáver de Solomon por algún lado?"
    mad "*In der realen Welt* Befindet sich Salomons Leiche irgendwo?"

# game/scripts/c20/c20.rpy:2311
translate german c20s004_Farewell_71b45c17:

    # dap "*En el mundo real* Tira por Inteligencia."
    dap "*In der realen Welt* Würfeln Sie auf Intelligenz."

# game/scripts/c20/c20.rpy:2312
translate german c20s004_Farewell_172177b2:

    # mad "*En el mundo real* ¡Sí! 20 natural. Pero le resto 1. Fang no es muy inteligente."
    mad "*In der realen Welt* Ja! 20 von Natur aus. Aber ich ziehe 1 ab. Fang ist nicht besonders schlau."

# game/scripts/c20/c20.rpy:2313
translate german c20s004_Farewell_169eaa96:

    # dap "*En el mundo real* Para nosotras, un 20 natural siempre es un éxito crítico. Así simplificamos las normas."
    dap "*In der Realität* ist eine natürliche 20 für uns immer ein absoluter Erfolg. So vereinfachen wir die Regeln."

# game/scripts/c20/c20.rpy:2315
translate german c20s004_Farewell_6553f9a6:

    # dap "*En el mundo real* Recuerdas la cosa negra que llevaba el dragón entre las garras. Crees que podría ser Solomon."
    dap "*In der realen Welt* Erinnerst du dich an das schwarze Ding, das der Drache in seinen Klauen trug? Du glaubst, es könnte Salomo sein."

# game/scripts/c20/c20.rpy:2316
translate german c20s004_Farewell_051216b6:

    # mad "*En el mundo real* ¡Sí! !Acabar como el almuerzo de un dragón! ¡Ahí tienes tu criatura roja infernal chupadora de almas! ¡Jódete, cabrón! ¡Uy, perdón!"
    mad "*In der realen Welt* Ja! Um als Drachenfutter zu enden! Da ist sie ja, diese seelenfressende, höllische rote Kreatur! Verdammt nochmal, du Mistkerl! Ups, Entschuldigung!"

# game/scripts/c20/c20.rpy:2317
translate german c20s004_Farewell_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c20/c20.rpy:2319
translate german c20s004_Farewell_a1798ea5:

    # madd "Creo que deberíamos volver a Novum Templum, Vilfredo. Deberíamos avisarles de que hay un dragón en las inmediaciones."
    madd "Ich denke, wir sollten nach Novum Templum zurückkehren, Vilfredo. Wir sollten sie warnen, dass sich ein Drache in der Nähe befindet."

# game/scripts/c20/c20.rpy:2320
translate german c20s004_Farewell_6fa26c98:

    # mcd "Me parece que no deben saberlo, o nos lo hubieran dicho. ¡Volvamos!"
    mcd "Ich glaube nicht, dass sie es wissen, sonst hätten sie es uns gesagt. Lasst uns zurückgehen!"

# game/scripts/c20/c20.rpy:2321
translate german c20s004_Farewell_4a222b01:

    # madd "Vamos. Vindobona tendrá que esperar."
    madd "Na los. Vindobona muss warten."

# game/scripts/c20/c20.rpy:2323
translate german c20s004_Farewell_449382bd:

    # mcd "Fang, presiento que este es el comienzo de una hermosa amistad."
    mcd "Fang, ich habe das Gefühl, das ist der Beginn einer wunderbaren Freundschaft."

# game/scripts/c20/c20.rpy:2327
translate german c20s004_Farewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "Damit ist die heutige Sitzung beendet. Ich hoffe, sie hat Ihnen gefallen."

# game/scripts/c20/c20.rpy:2353
translate german c20s005_EndGameFarewell_a5790ee4:

    # dap "Y con esto acaba la sesión de hoy. Espero que os haya gustado."
    dap "Damit ist die heutige Sitzung beendet. Ich hoffe, sie hat Ihnen gefallen."

# game/scripts/c20/c20.rpy:2356
translate german c20s005_EndGameFarewell_1a297f42:

    # mad "Como introducción al mundo y al grupo ha sido fantástico."
    mad "Als Einführung in die Welt und die Gruppe war es fantastisch."

# game/scripts/c20/c20.rpy:2357
translate german c20s005_EndGameFarewell_4ae9fcaa:

    # mad "No es la típica forma de introducir nuevos miembros en plan \"Os encontráis en una taberna y parecéis amigos de toda la vida\"."
    mad "Das ist nicht die typische Art, neue Mitglieder vorzustellen, etwa so: „Man lernt sich in einer Taverne kennen und scheint schon ewig befreundet zu sein.“"

# game/scripts/c20/c20.rpy:2360
translate german c20s005_EndGameFarewell_5625d6c4:

    # sca "Es más un \"Os encontráis en el foro y os folláis al Semielfo\". *Risa*"
    sca "Eher so: „Man lernt sich im Forum kennen und schläft mit dem Halbelfen.“ *Gelächter*"

# game/scripts/c20/c20.rpy:2361
translate german c20s005_EndGameFarewell_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c20/c20.rpy:2364
translate german c20s005_EndGameFarewell_7b8058c9:

    # emm "*Risa* Había que darle razones para volver, ¿no?"
    emm "*lacht* Wir mussten ihm Gründe geben, zurückzukommen, nicht wahr?"

# game/scripts/c20/c20.rpy:2365
translate german c20s005_EndGameFarewell_3eba9f66:

    # mc "*Risa* Creo que [dap] nos hubiera dado razones suficientes igualmente."
    mc "*Lacht* Ich glaube, [dap] hätte uns ohnehin genug Gründe genannt."

# game/scripts/c20/c20.rpy:2367
translate german c20s005_EndGameFarewell_c15b942d:

    # eri "Ahora hay que darle razones a [madd] para que se quede."
    eri "Nun müssen wir [madd] Gründe zum Bleiben liefern."

# game/scripts/c20/c20.rpy:2369
translate german c20s005_EndGameFarewell_6e4fee88:

    # dap "Por eso habéis conocido a unos enemigos comunes. Además, Vilfredo y Fang volverán para dar la noticia del dragón."
    dap "Deshalb seid ihr einigen gemeinsamen Feinden begegnet. Außerdem werden Vilfredo und Fang zurückkehren, um Neuigkeiten über den Drachen zu überbringen."

# game/scripts/c20/c20.rpy:2370
translate german c20s005_EndGameFarewell_9c2b3da1:

    # dap "Suma a eso que ahora Fang tiene una razón para quedarse. Tiene un intérprete para hablar con Júpiter."
    dap "Hinzu kommt, dass Fang nun einen Grund hat zu bleiben. Er hat einen Dolmetscher, um mit Jupiter zu sprechen."

# game/scripts/c20/c20.rpy:2373
translate german c20s005_EndGameFarewell_f359061e:

    # mad "Y visto lo que pasó anoche, quizás se plantee probar a Vilfredo. Aunque también podría haberlo hecho en Vindobona."
    mad "Und angesichts dessen, was gestern Abend passiert ist, werden sie vielleicht in Erwägung ziehen, es mit Vilfredo zu versuchen. Obwohl sie das auch in Vindobona hätten tun können."

# game/scripts/c20/c20.rpy:2376
translate german c20s005_EndGameFarewell_f8a96c09:

    # mad "*Risa* Es la única idiota que se fue a dormir y se quedó sin diversión."
    mad "*Gelächter* Sie ist die einzige Idiotin, die eingeschlafen ist und den Spaß verpasst hat."

# game/scripts/c20/c20.rpy:2378
translate german c20s005_EndGameFarewell_849e73e9:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas."
    bet "Ich fand es sehr interessant, diese Facetten meiner vier Nichten zu entdecken."

# game/scripts/c20/c20.rpy:2381
translate german c20s005_EndGameFarewell_4b8e0ca6:

    # bet "A mí me ha parecido muy interesante descubrir esas facetas de mis cuatro sobrinas, aunque [mc] las rechazara."
    bet "Ich fand es sehr interessant, diese Facetten meiner vier Nichten zu entdecken, obwohl ich sie abgelehnt hatte."

# game/scripts/c20/c20.rpy:2383
translate german c20s005_EndGameFarewell_240e4faf:

    # dap "¿Por qué no te unes, Tía Betty? Siempre hay espacio para más Clérigos en el grupo. Los hechizos de curación de Pia no son eternos y ahora somos más."
    dap "Warum schließt du dich uns nicht an, Tante Betty? In unserer Gruppe ist immer Platz für weitere Kleriker. Pias Heilzauber wirken nicht ewig, und jetzt sind wir mehr."

# game/scripts/c20/c20.rpy:2385
translate german c20s005_EndGameFarewell_7fccd2cc:

    # bet "*Risa* ¿Me estás diciendo que me una al grupo y me haga una monja curandera en vez de follarme al Semielfo?"
    bet "*Lacht* Willst du mir etwa sagen, ich solle mich der Gruppe anschließen und Heilernonne werden, anstatt mit dem Halbelfen zu schlafen?"

# game/scripts/c20/c20.rpy:2386
translate german c20s005_EndGameFarewell_c501fb12:

    # bet "¿Tú te das cuenta de la ironía de eso? *Risa* Me he pasado casi toda mi vida siendo precisamente una monja curandera."
    bet "Ist Ihnen die Ironie daran bewusst? *lacht* Ich habe fast mein ganzes Leben lang genau das getan: eine heilende Nonne sein."

# game/scripts/c20/c20.rpy:2388
translate german c20s005_EndGameFarewell_2ac73579:

    # sca "*Risa* Creo que [dap] no lo había pensado. Si quieres puedes jugar con un guerrero o un mago..."
    sca "*Lacht* Ich glaube nicht, dass [dap] daran gedacht hat. Wenn du willst, kannst du als Krieger oder Magier spielen..."

# game/scripts/c20/c20.rpy:2389
translate german c20s005_EndGameFarewell_1a93d918:

    # sca "Aunque te hagas una monja, te puedes follar a [mc] igualmente. *Risa*"
    sca "Selbst wenn du Nonne wirst, kannst du immer noch vögeln [mc]. *lacht*"

# game/scripts/c20/c20.rpy:2391
translate german c20s005_EndGameFarewell_1525074d:

    # sca "Sólo tienes que ver a [dap], la Semielfa putilla. *Risa*"
    sca "Man muss sich nur [dap] ansehen, diese kleine Halbelfenschlampe. *Lacht*"

# game/scripts/c20/c20.rpy:2393
translate german c20s005_EndGameFarewell_01267f8c:

    # bet "Me ha parecido que os lo pasabais muy bien. Podría ser divertido unirme, ahora que parece que no voy a volver a Florida."
    bet "Ihr hattet anscheinend eine tolle Zeit. Vielleicht macht es ja Spaß, mitzumachen, jetzt, wo es so aussieht, als würde ich nicht mehr nach Florida zurückfahren."

# game/scripts/c20/c20.rpy:2395
translate german c20s005_EndGameFarewell_d500f517:

    # bet "Pero dejadme pensarlo unos días..."
    bet "Aber ich muss ein paar Tage darüber nachdenken..."

# game/scripts/c20/c20.rpy:2396
translate german c20s005_EndGameFarewell_aac421b9:

    # mcp "(Al menos hasta la visita a Monterey, ¿no?)"
    mcp "(Zumindest bis zum Besuch in Monterey, oder?)"

# game/scripts/c20/c20.rpy:2398
translate german c20s005_EndGameFarewell_491b2c1b:

    # emm "No es que te quiera echar, Mads, pero ¿tú no tenías que madrugar?"
    emm "Ich will dich ja nicht rausschmeißen, Mads, aber solltest du nicht früh aufstehen?"

# game/scripts/c20/c20.rpy:2400
translate german c20s005_EndGameFarewell_eb79b050:

    # mad "Sí, pero una de las cosas más divertidas de las partidas es comentarlas luego... Estoy dispuesta a sacrificar una hora de sueño."
    mad "Ja, aber das Schönste an den Spielen ist die anschließende Diskussion darüber... Dafür bin ich sogar bereit, eine Stunde Schlaf zu opfern."

# game/scripts/c20/c20.rpy:2402
translate german c20s005_EndGameFarewell_6649c9db:

    # eri "No es necesario, Maddie. Mañana iremos todas a la tienda y comentaremos la partida si quieres. Así puedes dormir tranquilamente hoy."
    eri "Das ist nicht nötig, Maddie. Wir können morgen alle zusammen einkaufen gehen und dann über das Spiel reden, wenn du möchtest. Dann kannst du heute Nacht ruhig schlafen."

# game/scripts/c20/c20.rpy:2404
translate german c20s005_EndGameFarewell_8c0b47f6:

    # sca "Prometemos no comentar nada antes de ir, para que no te pierdas nada de la conversación."
    sca "Wir versprechen, vorher nichts zu sagen, damit Sie nichts vom Gespräch verpassen."

# game/scripts/c20/c20.rpy:2406
translate german c20s005_EndGameFarewell_56648120:

    # mad "Chicas, os lo agradezco. Ha sido un día largo y empiezo a estar cansada."
    mad "Mädels, vielen Dank. Es war ein langer Tag und ich werde langsam müde."

# game/scripts/c20/c20.rpy:2409
translate german c20s005_EndGameFarewell_9abc610e:

    # mad "Casi tanto como Vilfredo. *Risa*"
    mad "Fast so sehr wie Vilfredo. *Gelächter*"

# game/scripts/c20/c20.rpy:2410
translate german c20s005_EndGameFarewell_f7fd3149:

    # mc "¡Hey! El Semielfo ya ha recargado las baterías. Está listo para más rounds. *Risa*"
    mc "Hey! Der Halbelf hat seine Batterien wieder aufgeladen. Er ist bereit für weitere Runden. *lacht*"

# game/scripts/c20/c20.rpy:2412
translate german c20s005_EndGameFarewell_5d2e6c01:

    # dap "Entonces quedamos así. Mañana en la tienda. No te queremos entretener más y sentirnos culpables si te quedas dormida en un probador. *Risa*"
    dap "So, das wäre geklärt. Morgen im Laden. Wir wollen dich nicht länger aufhalten und uns schuldig fühlen, falls du in der Umkleidekabine einschläfst. *lacht*"

# game/scripts/c20/c20.rpy:2413
translate german c20s005_EndGameFarewell_b3b94564_1:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c20/c20.rpy:2415
translate german c20s005_EndGameFarewell_f5dbebe2:

    # mad "Gracias, chicas."
    mad "Danke, Mädels."

# game/scripts/c20/c20.rpy:2416
translate german c20s005_EndGameFarewell_6598ab25:

    # mc "Te llevo. ¿Tienes que coger alguna cosa?"
    mc "Ich fahre dich mit. Musst du etwas abholen?"

# game/scripts/c20/c20.rpy:2418
translate german c20s005_EndGameFarewell_9002c104:

    # mad "Tengo la mochila en la habitación de [eri]. Ahora bajo con ella. Las cajas de los cuadros ya están en la camioneta."
    mad "Mein Rucksack ist in [eri]s Zimmer. Ich bringe ihn jetzt nach unten. Die Kisten mit den Gemälden sind schon im Lieferwagen."

# game/scripts/c20/c20.rpy:2419
translate german c20s005_EndGameFarewell_e5a907d7:

    # mc "Perfecto entonces. Voy al lavabo y te veo en el garaje."
    mc "Dann ist alles perfekt. Ich gehe kurz aufs Klo und wir sehen uns in der Garage."

# game/scripts/c20/c20.rpy:2420
translate german c20s005_EndGameFarewell_df5c0f2c:

    # eri "Te acompaño, Maddie."
    eri "Ich komme mit, Maddie."

# game/scripts/c20/c20.rpy:2423
translate german c20s005_EndGameFarewell_ae82c249:

    # "Te despides de las chicas y de Tía Betty y vas al lavabo."
    "Du verabschiedest dich von den Mädchen und Tante Betty und gehst ins Badezimmer."

# game/scripts/c20/c20.rpy:2437
translate german c20s005_Kia_e56161b3:

    # "Al salir del lavabo, te encuentras con Kiara en el pasillo."
    "Als du das Badezimmer verlässt, triffst du im Flur auf Kiara."

# game/scripts/c20/c20.rpy:2438
translate german c20s005_Kia_15498345:

    # mc "¡Hola, Kiara! Perdón si te he despertado."
    mc "Hallo Kiara! Entschuldige, falls ich dich geweckt habe."

# game/scripts/c20/c20.rpy:2444
translate german c20s005_Kia_c2279c91:

    # kia "No te preocupes. No podía dormir y te he escuchado subir las escaleras. He venido a ver si tenías un momento para hablar."
    kia "Keine Sorge. Ich konnte nicht schlafen und habe dich die Treppe hochkommen hören. Ich wollte nur fragen, ob du kurz Zeit für ein Gespräch hättest."

# game/scripts/c20/c20.rpy:2445
translate german c20s005_Kia_b8414fd1:

    # mc "Ahora no es buen momento, Kiara. Tengo que llevar a Maddie a casa."
    mc "Jetzt ist kein guter Zeitpunkt, Kiara. Ich muss Maddie nach Hause bringen."

# game/scripts/c20/c20.rpy:2448
translate german c20s005_Kia_a4065204:

    # kia "¿Vas a volver a casa o te vas a quedar a dormir?"
    kia "Fährst du wieder nach Hause oder übernachtest du dort?"

# game/scripts/c20/c20.rpy:2450
translate german c20s005_Kia_7716d653:

    # kia "No te estoy fiscalizando... Es que me gustaría hablar contigo..."
    kia "Ich will dich nicht beäugen... Ich möchte mich einfach nur mit dir unterhalten..."

# game/scripts/c20/c20.rpy:2453
translate german c20s005_Kia_5a1fc550:

    # kia "¿Vas a tardar mucho? Me gustaría hablar contigo..."
    kia "Wirst du lange brauchen? Ich würde gerne mit dir sprechen..."

# game/scripts/c20/c20.rpy:2454
translate german c20s005_Kia_a4795cec:

    # mc "La llevo a casa y vuelvo en seguida. ¿Quieres que hablemos cuando vuelva?"
    mc "Ich bringe sie nach Hause und bin gleich wieder da. Möchtest du reden, wenn ich zurück bin?"

# game/scripts/c20/c20.rpy:2456
translate german c20s005_Kia_4e0d1f0f:

    # kia "Me parece fantástico. Te veo en un rato, entonces."
    kia "Das klingt fantastisch. Dann sehen wir uns gleich."

# game/scripts/c20/c20.rpy:2457
translate german c20s005_Kia_e4695014:

    # mc "¿No vas a darme un beso antes de irme?"
    mc "Wirst du mir nicht noch einen Kuss geben, bevor ich gehe?"

# game/scripts/c20/c20.rpy:2459
translate german c20s005_Kia_d4e8547d:

    # kia "Creía que era solamente en los buenos días y buenas noches..."
    kia "Ich dachte, das wäre nur für Guten Morgen und Gute Nacht..."

# game/scripts/c20/c20.rpy:2460
translate german c20s005_Kia_15557826:

    # mc "Así era antes de que tú y yo estuviéramos juntos."
    mc "So war es, bevor wir beide zusammen waren."

# game/scripts/c20/c20.rpy:2461
translate german c20s005_Kia_8da7fb88:

    # mc "Porque estamos juntos, ¿verdad?"
    mc "Weil wir zusammen sind, richtig?"

# game/scripts/c20/c20.rpy:2463
translate german c20s005_Kia_d82d5c59:

    # kia "De eso es de lo que quiero hablar contigo... Pero mejor luego, cuando vuelvas."
    kia "Genau darüber wollte ich mit dir sprechen... Aber es ist besser, das später zu tun, wenn du zurück bist."

# game/scripts/c20/c20.rpy:2464
translate german c20s005_Kia_8a4b213f:

    # mc "Como desees."
    mc "Wie Sie möchten."

# game/scripts/c20/c20.rpy:2466
translate german c20s005_Kia_96c2af65:

    # kia "Hasta dentro de un rato, [mc]."
    kia "Wir sehen uns in Kürze, [mc]."

# game/scripts/c20/c20.rpy:2468
translate german c20s005_Kia_933e9869:

    # mc "Hasta luego, Kiara."
    mc "Auf Wiedersehen, Kiara."

# game/scripts/c20/c20.rpy:2529
translate german c20s005_GivingMaddieARide_36ef4791:

    # "Unos minutos después, después de haber sacado la camioneta del garaje..."
    "Ein paar Minuten später, nachdem ich den Lkw aus der Garage gefahren hatte..."

# game/scripts/c20/c20.rpy:2530
translate german c20s005_GivingMaddieARide_16efac19:

    # mad "Ya nos podemos ir. Ya me he despedido de las chicas y de Betty."
    mad "Wir können jetzt gehen. Ich habe mich bereits von den Mädchen und Betty verabschiedet."

# game/scripts/c20/c20.rpy:2531
translate german c20s005_GivingMaddieARide_bbc35977:

    # mc "Cuando quieras podemos irnos, entonces."
    mc "Wir können dann jederzeit gehen, wann immer du willst."

# game/scripts/c20/c20.rpy:2533
translate german c20s005_GivingMaddieARide_da70b486:

    # "Al llegar al edificio de Maddie le ayudas a subir las cajas de los cuadros y te despides de ella."
    "Wenn du bei Maddie ankommst, hilfst du ihr, die Kisten mit den Gemälden nach oben zu tragen und verabschiedest dich von ihr."

# game/scripts/c20/c20.rpy:2534
translate german c20s005_GivingMaddieARide_a678922f:

    # mad "Muchas gracias por todo, [mc]. Ha sido un día fantástico."
    mad "Vielen Dank für alles, [mc]. Es war ein fantastischer Tag."

# game/scripts/c20/c20.rpy:2535
translate german c20s005_GivingMaddieARide_d8cf74d5:

    # mc "Bienvenida a la familia. Bienvenida a los Locos Marks. *Risa* Espero que, a partir de ahora vengas a casa más a menudo."
    mc "Willkommen in der Familie. Willkommen bei den Crazy Marks. *lacht* Ich hoffe, du kommst von nun an öfter vorbei."

# game/scripts/c20/c20.rpy:2538
translate german c20s005_GivingMaddieARide_c14779c4:

    # mad "Lo haré, no lo dudes. Ahora, si no te importa, debería irme a dormir."
    mad "Das werde ich, keine Sorge. Wenn es Ihnen nichts ausmacht, sollte ich jetzt schlafen gehen."

# game/scripts/c20/c20.rpy:2539
translate german c20s005_GivingMaddieARide_eba3cfdd:

    # mc "Ningún problema. ¿Zeus está durmiendo? Me gustaría conocerlo."
    mc "Kein Problem. Schläft Zeus? Ich würde ihn gern kennenlernen."

# game/scripts/c20/c20.rpy:2545
translate german c20s005_GivingMaddieARide_eb2c2306:

    # "Parece que el gato ha oído su nombre y aparece para saludar."
    "Es scheint, als hätte die Katze seinen Namen gehört und wolle ihn begrüßen."

# game/scripts/c20/c20.rpy:2546
translate german c20s005_GivingMaddieARide_fabc3ed0:

    # zeu "*Ronroneo* (¿Quién eres tú? ¿Vienes a acariciarme? ¡Bien hecho, humano!)"
    zeu "*Schnurr* (Wer bist du? Willst du mich streicheln? Bravo, Mensch!)"

# game/scripts/c20/c20.rpy:2547
translate german c20s005_GivingMaddieARide_7228dac7:

    # mc "*Risa* Parece que me ha oído."
    mc "*Gelächter* Es scheint, als hätte er mich gehört."

# game/scripts/c20/c20.rpy:2548
translate german c20s005_GivingMaddieARide_ade7fb2e:

    # mad "*Risa* En cuanto oye su nombre aparece como salido de la nada. Si son mis amigas se vuelve a esconder."
    mad "*Lacht* Sobald sie ihren Namen hört, taucht sie wie aus dem Nichts auf. Wenn es meine Freunde sind, versteckt sie sich wieder."

# game/scripts/c20/c20.rpy:2549
translate german c20s005_GivingMaddieARide_f5e03bef:

    # mad "Parece que contigo tiene curiosidad."
    mad "Er scheint neugierig auf dich zu sein."

# game/scripts/c20/c20.rpy:2551
translate german c20s005_GivingMaddieARide_4e4279df:

    # zeu "*Ronroneo* (Sus amigas son idiotas y se ríen como gallinas. Eres un humano que acaricia bien, me gustas.)"
    zeu "*Schnurr* (Ihre Freunde sind Idioten und lachen wie Hühner. Du bist ein Mensch, der gut streichelt, ich mag dich.)"

# game/scripts/c20/c20.rpy:2552
translate german c20s005_GivingMaddieARide_65826775:

    # mc "Encantado de conocerte por fin, Zeus. He visto unos cuadros fantásticos tuyos."
    mc "Es freut mich sehr, dich endlich kennenzulernen, Zeus. Ich habe einige deiner fantastischen Gemälde gesehen."

# game/scripts/c20/c20.rpy:2553
translate german c20s005_GivingMaddieARide_da4f0765:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Schnurr* (Ich bin sehr vielseitig. Goth und Wissenschaftlerin zugleich. Über das rosa Kleid reden wir nicht. Das ist nie passiert. Ich muss mit meinem Psychologen sprechen.)"

# game/scripts/c20/c20.rpy:2555
translate german c20s005_GivingMaddieARide_b2b41e5c:

    # mc "Bueno, Maddie, te dejo ir a acostarte. A ver si mañana puedo pasarme por la tienda con las chicas para comentar la partida."
    mc "Okay, Maddie, jetzt darfst du ins Bett gehen. Ich versuche morgen mit den Mädchen im Laden vorbeizuschauen, um über das Spiel zu reden."

# game/scripts/c20/c20.rpy:2556
translate german c20s005_GivingMaddieARide_7f43c3b1:

    # mad "OK. Hasta mañana, [mc]."
    mad "Okay. Bis morgen, [mc]."

# game/scripts/c20/c20.rpy:2559
translate german c20s005_GivingMaddieARide_a6cf6482:

    # "Te subes a la camioneta y emprendes el camino a casa."
    "Du steigst in den LKW und beginnst die Heimreise."

# game/scripts/c20/c20.rpy:2562
translate german c20s005_GivingMaddieARide_78d12f4c:

    # mad "Lo haré. No puedo dejar a Vilfredo solo en el bosque, habiendo un dragón rondando por ahí. *Risa*"
    mad "Ich werde es tun. Ich kann Vilfredo doch nicht allein im Wald lassen, wo doch ein Drache herumstreift. *lacht*"

# game/scripts/c20/c20.rpy:2563
translate german c20s005_GivingMaddieARide_f166ab00:

    # mc "No me refiero solo a las partidas de DnD. Me refiero a las actividades familiares."
    mc "Ich spreche nicht nur von D&D-Spielen. Ich spreche von Familienaktivitäten."

# game/scripts/c20/c20.rpy:2564
translate german c20s005_GivingMaddieARide_4dd3c1b8:

    # mc "Le has caído genial a todo el mundo que no te conocía, y ya les gustabas a las que te conocían."
    mc "Alle, die dich noch nicht kannten, waren von dir begeistert, und diejenigen, die dich kannten, mochten dich schon."

# game/scripts/c20/c20.rpy:2567
translate german c20s005_GivingMaddieARide_8baf9429:

    # mad "Sobre eso..."
    mad "Darüber..."

# game/scripts/c20/c20.rpy:2568
translate german c20s005_GivingMaddieARide_4f14a2cb:

    # mc "¿Qué pasa Maddie?"
    mc "Was ist los, Maddie?"

# game/scripts/c20/c20.rpy:2571
translate german c20s005_GivingMaddieARide_d6037b75:

    # mad "Me mentiste..."
    mad "Du hast mich angelogen..."

# game/scripts/c20/c20.rpy:2572
translate german c20s005_GivingMaddieARide_e73f25b2:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "Inwiefern? Ich verstehe das nicht. Ich habe dich nie angelogen."

# game/scripts/c20/c20.rpy:2574
translate german c20s005_GivingMaddieARide_75ada0a2:

    # mad "Estás saliendo con [mar]..."
    mad "Du bist mit [mar] zusammen..."

# game/scripts/c20/c20.rpy:2576
translate german c20s005_GivingMaddieARide_fbe6db5e:

    # mad "Incluso está embarazada..."
    mad "Sie ist sogar schwanger..."

# game/scripts/c20/c20.rpy:2577
translate german c20s005_GivingMaddieARide_e3bab36f:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Ich habe dir nie gesagt, dass ich es nicht tun würde..."

# game/scripts/c20/c20.rpy:2579
translate german c20s005_GivingMaddieARide_84ecc7e4:

    # mad "Pero aceptaste mi chantaje."
    mad "Aber Sie haben meine Erpressung akzeptiert."

# game/scripts/c20/c20.rpy:2580
translate german c20s005_GivingMaddieARide_6da9e9f8:

    # mc "Porque quería ver dónde iba. Quería probar como era sentirse dominado."
    mc "Weil er sehen wollte, wohin es führen würde. Er wollte erleben, wie es sich anfühlt, beherrscht zu werden."

# game/scripts/c20/c20.rpy:2582
translate german c20s005_GivingMaddieARide_027922b0:

    # mad "Me estás diciendo que nunca tuve poder sobre ti, ¿no?"
    mad "Du willst mir also sagen, dass ich nie Macht über dich hatte, nicht wahr?"

# game/scripts/c20/c20.rpy:2583
translate german c20s005_GivingMaddieARide_32b8280f:

    # mc "No es eso. Tenías poder sobre mí porque yo te lo dejaba tener. No porque el secreto que guardabas fuera a hacerme daño si lo revelabas."
    mc "Nein, das stimmt nicht. Du hattest Macht über mich, weil ich es dir erlaubt habe. Nicht, weil das Geheimnis, das du gehütet hast, mir schaden würde, wenn du es preisgeben würdest."

# game/scripts/c20/c20.rpy:2584
translate german c20s005_GivingMaddieARide_ed69ab30:

    # mc "Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Sie wäre sicherlich geschmeichelt, wenn Sie das täten."

# game/scripts/c20/c20.rpy:2586
translate german c20s005_GivingMaddieARide_1b34f9ba:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Ich bin froh, dass du es getan hast. Obwohl ich mich ein bisschen dumm gefühlt habe, als ich die Wahrheit erfahren habe."

# game/scripts/c20/c20.rpy:2587
translate german c20s005_GivingMaddieARide_d5002491:

    # mad "Y eso me lleva a otra pregunta..."
    mad "Und das führt mich zu einer weiteren Frage..."

# game/scripts/c20/c20.rpy:2588
translate german c20s005_GivingMaddieARide_185a3c0f:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Sag schon, Maddie. Du weißt, dass du mit mir über alles reden kannst."

# game/scripts/c20/c20.rpy:2590
translate german c20s005_GivingMaddieARide_17c8bf13:

    # mad "¿Quiere decir eso que estabas conmigo porque querías? ¿No porque yo te obligara?"
    mad "Heißt das, dass du mit mir zusammen warst, weil du es wolltest? Nicht, weil ich dich dazu gezwungen habe?"

# game/scripts/c20/c20.rpy:2591
translate german c20s005_GivingMaddieARide_20004a1b:

    # mc "Sí. Estaba contigo porque quería. No podías obligarme, Maddie. El secreto no tenía ningún poder sobre mí."
    mc "Ja. Ich war bei dir, weil ich es wollte. Du konntest mich nicht zwingen, Maddie. Das Geheimnis hatte keine Macht über mich."

# game/scripts/c20/c20.rpy:2593
translate german c20s005_GivingMaddieARide_c524525a:

    # mad "Entonces te libero. No quiero estar contigo así."
    mad "Dann lasse ich dich frei. Ich will so nicht mit dir zusammen sein."

# game/scripts/c20/c20.rpy:2596
translate german c20s005_GivingMaddieARide_d6037b75_1:

    # mad "Me mentiste..."
    mad "Du hast mich angelogen..."

# game/scripts/c20/c20.rpy:2597
translate german c20s005_GivingMaddieARide_e73f25b2_1:

    # mc "¿En qué? No lo entiendo. Nunca te he mentido."
    mc "Inwiefern? Ich verstehe das nicht. Ich habe dich nie angelogen."

# game/scripts/c20/c20.rpy:2599
translate german c20s005_GivingMaddieARide_75ada0a2_1:

    # mad "Estás saliendo con [mar]..."
    mad "Du bist mit [mar] zusammen..."

# game/scripts/c20/c20.rpy:2601
translate german c20s005_GivingMaddieARide_fbe6db5e_1:

    # mad "Incluso está embarazada..."
    mad "Sie ist sogar schwanger..."

# game/scripts/c20/c20.rpy:2602
translate german c20s005_GivingMaddieARide_e3bab36f_1:

    # mc "Nunca te dije que no lo estuviera haciendo..."
    mc "Ich habe dir nie gesagt, dass ich es nicht tun würde..."

# game/scripts/c20/c20.rpy:2604
translate german c20s005_GivingMaddieARide_6dd08023:

    # mad "Pero mi intento de chantaje..."
    mad "Aber mein Erpressungsversuch..."

# game/scripts/c20/c20.rpy:2605
translate german c20s005_GivingMaddieARide_753a680c:

    # mc "Tú intentaste chantajearme antes de que estuviéramos juntos. Nada cambia."
    mc "Du hast versucht, mich zu erpressen, noch bevor wir überhaupt zusammen waren. Nichts ändert sich."

# game/scripts/c20/c20.rpy:2607
translate german c20s005_GivingMaddieARide_f837d6fe:

    # mad "Me estás diciendo que, aunque hubiera salido bien nunca hubiera tenido poder sobre ti, ¿no?"
    mad "Du willst mir also sagen, dass ich selbst dann, wenn alles gut gelaufen wäre, niemals Macht über dich gehabt hätte, richtig?"

# game/scripts/c20/c20.rpy:2608
translate german c20s005_GivingMaddieARide_e2e209c3:

    # mc "Más o menos. A menos que yo te lo hubiera dejado tener. Seguramente [mar] se sentiría halagada si lo hicieras."
    mc "Mehr oder weniger. Es sei denn, ich hätte es dir überlassen. Ich bin sicher, [mar] wäre geschmeichelt, wenn du es tätest."

# game/scripts/c20/c20.rpy:2609
translate german c20s005_GivingMaddieARide_5519561f:

    # mc "Pero le dimos la vuelta y ahora soy yo el que tiene poder sobre ti, ¿no?"
    mc "Aber wir haben das Blatt gewendet und jetzt bin ich diejenige, die Macht über dich hat, richtig?"

# game/scripts/c20/c20.rpy:2611
translate german c20s005_GivingMaddieARide_1b34f9ba_1:

    # mad "Me alegro de que lo hicieras. Aunque me he sentido un poco idiota cuando he descubierto la verdad."
    mad "Ich bin froh, dass du es getan hast. Obwohl ich mich ein bisschen dumm gefühlt habe, als ich die Wahrheit erfahren habe."

# game/scripts/c20/c20.rpy:2612
translate german c20s005_GivingMaddieARide_d5002491_1:

    # mad "Y eso me lleva a otra pregunta..."
    mad "Und das führt mich zu einer weiteren Frage..."

# game/scripts/c20/c20.rpy:2613
translate german c20s005_GivingMaddieARide_185a3c0f_1:

    # mc "Dime, Maddie. Sabes que puedes hablar de cualquier cosa conmigo."
    mc "Sag schon, Maddie. Du weißt, dass du mit mir über alles reden kannst."

# game/scripts/c20/c20.rpy:2615
translate german c20s005_GivingMaddieARide_d3d03417:

    # mad "¿Quiere decir eso que estás conmigo sólo porque tienes poder sobre mí?"
    mad "Heißt das, dass du nur mit mir zusammen bist, weil du Macht über mich hast?"

# game/scripts/c20/c20.rpy:2616
translate german c20s005_GivingMaddieARide_48639672:

    # mc "No. Estoy contigo porque quiero estarlo. No esperaba estarlo en estas circunstancias, pero me gusta estar contigo."
    mc "Nein. Ich bin bei dir, weil ich es will. Ich hatte nicht erwartet, in diese Umstände zu geraten, aber ich bin gern bei dir."

# game/scripts/c20/c20.rpy:2618
translate german c20s005_GivingMaddieARide_38efc1b3:

    # mad "Entonces, si quieres, puedes denunciarme a mi jefe."
    mad "Wenn Sie wollen, können Sie mich also bei meinem Chef melden."

# game/scripts/c20/c20.rpy:2619
translate german c20s005_GivingMaddieARide_65b1fd2a:

    # mad "No quiero estar contigo así."
    mad "Ich möchte so nicht mit dir zusammen sein."

# game/scripts/c20/c20.rpy:2621
translate german c20s005_GivingMaddieARide_c05ecd45:

    # mc "{b}¿Qué?{/b} ¿Estás rompiendo conmigo?"
    mc "{b}Was?{/b} Machst du mit mir Schluss?"

# game/scripts/c20/c20.rpy:2623
translate german c20s005_GivingMaddieARide_e25417f1:

    # mad "Sí. Espérame aquí un momento. Ahora vuelvo."
    mad "Ja. Warten Sie einen Moment hier. Ich bin gleich wieder da."

# game/scripts/c20/c20.rpy:2624
translate german c20s005_GivingMaddieARide_704e54a3:

    # mc "¿Me he perdido algo? No te entiendo."
    mc "Habe ich etwas verpasst? Ich verstehe dich nicht."

# game/scripts/c20/c20.rpy:2626
translate german c20s005_GivingMaddieARide_db54acf2:

    # zeu "¡Miau! (¿Qué le has hecho ahora? ¡Me caías bien!)"
    zeu "Miau! (Was hast du ihm denn jetzt schon wieder angetan? Ich mochte dich!)"

# game/scripts/c20/c20.rpy:2627
translate german c20s005_GivingMaddieARide_1dee14f4:

    # mc "Hola, pequeñín. ¿Sabes que le ha pasado a Maddie? ¿Me has echado de menos?"
    mc "Hallo, mein Schatz. Weißt du, was mit Maddie passiert ist? Hast du mich vermisst?"

# game/scripts/c20/c20.rpy:2628
translate german c20s005_GivingMaddieARide_c3aae098:

    # zeu "¡Miau! (No tengo ni idea de qué le has hecho. Y sobre echarte de menos, depende. ¿Me has traído atún para una cena tardía?)"
    zeu "Miau! (Ich habe keine Ahnung, was du ihm angetan hast. Und ob ich dich vermisse, kommt darauf an. Hast du mir Thunfisch zum späten Abendessen mitgebracht?)"

# game/scripts/c20/c20.rpy:2630
translate german c20s005_GivingMaddieARide_9ee1b869:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Schnurr* (Okay, ich verzeihe dir... Aber lass es nicht wieder vorkommen.)"

# game/scripts/c20/c20.rpy:2631
translate german c20s005_GivingMaddieARide_f20a31cc:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Ich habe dich auch vermisst. Deine Gemälde waren ein großer Erfolg."

# game/scripts/c20/c20.rpy:2632
translate german c20s005_GivingMaddieARide_da4f0765_1:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Schnurr* (Ich bin sehr vielseitig. Goth und Wissenschaftlerin zugleich. Über das rosa Kleid reden wir nicht. Das ist nie passiert. Ich muss mit meinem Psychologen sprechen.)"

# game/scripts/c20/c20.rpy:2634
translate german c20s005_GivingMaddieARide_5708e270:

    # mad "Hola, [mc]. ¿Puedo ayudarte en algo?"
    mad "Hallo [mc]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c20/c20.rpy:2635
translate german c20s005_GivingMaddieARide_60c7fe73:

    # mc "Hola de nuevo, Maddie. ¿Esas gafas?"
    mc "Hallo nochmal, Maddie. Diese Brille?"

# game/scripts/c20/c20.rpy:2637
translate german c20s005_GivingMaddieARide_9bc8c161:

    # mad "Creo que te equivocas. Maddie vive aquí, pero no lleva gafas. Yo soy Madison... No... Claire... Kent."
    mad "Ich glaube, du irrst dich. Maddie wohnt hier, aber sie trägt keine Brille. Ich bin Madison... Nein... Claire... Kent."

# game/scripts/c20/c20.rpy:2638
translate german c20s005_GivingMaddieARide_9c84e9bf:

    # mcp "(OK. Sigamos el juego. Solo te falta una cabina de teléfono para cambiarte de vestimenta.)"
    mcp "(Okay, spielen wir mit. Alles, was du jetzt noch brauchst, ist eine Telefonzelle zum Umziehen.)"

# game/scripts/c20/c20.rpy:2639
translate german c20s005_GivingMaddieARide_2890b878:

    # mc "Perdón por la confusión. Mi amiga me ha dicho algo que no entiendo y se ha ido."
    mc "Entschuldigung für die Verwirrung. Mein Freund sagte etwas, das ich nicht verstanden habe, und ging dann weg."

# game/scripts/c20/c20.rpy:2641
translate german c20s005_GivingMaddieARide_59b0dbd7:

    # mad "Sí, ha roto contigo. No quiere seguir teniendo la relación que ha tenido hasta ahora."
    mad "Ja, sie hat mit dir Schluss gemacht. Sie möchte die Beziehung, die ihr bisher hattet, nicht fortsetzen."

# game/scripts/c20/c20.rpy:2642
translate german c20s005_GivingMaddieARide_b67fb6f4:

    # mad "Es una lástima... hacíais tan buena pareja..."
    mad "Es ist wirklich schade... ihr wart so ein schönes Paar..."

# game/scripts/c20/c20.rpy:2643
translate german c20s005_GivingMaddieARide_6b6a3698:

    # mc "Pero no lo entiendo..."
    mc "Aber ich verstehe es nicht..."

# game/scripts/c20/c20.rpy:2645
translate german c20s005_GivingMaddieARide_adff9d34:

    # mad "Es muy fácil de entender. Después de ver lo que puede ser tener una relación completa... romántica... contigo. No quiere tener un sucedáneo."
    mad "Das ist ganz einfach zu verstehen. Nachdem sie erlebt hat, wie eine vollständige, romantische Beziehung mit dir aussehen kann, will sie keinen Ersatz."

# game/scripts/c20/c20.rpy:2647
translate german c20s005_GivingMaddieARide_60be8291:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su trabajo a perder la oportunidad de tener algo más sincero contigo."
    mad "Sie sagt, es habe Spaß gemacht, aber es sei nichts für sie. Lieber würde sie ihren Job verlieren, als die Chance auf eine tiefere Beziehung mit dir zu verpassen."

# game/scripts/c20/c20.rpy:2649
translate german c20s005_GivingMaddieARide_7a79c608:

    # mad "Dice que fue divertido, pero que no es lo suyo. Prefiere perder su poder, si es que lo tenía, a perder la oportunidad de tener algo más sincero contigo."
    mad "Sie sagt, es habe Spaß gemacht, aber es sei nicht ihr Ding. Lieber würde sie ihre Macht – falls sie jemals welche besessen hat – verlieren, als die Chance auf etwas Echtes mit dir."

# game/scripts/c20/c20.rpy:2650
translate german c20s005_GivingMaddieARide_49c884ea:

    # mc "Yo pienso lo mismo. Tú no estabas hoy en mi casa, pero con todo el mundo tengo una relación basada en el respeto, no en guardar secretos."
    mc "Ich sehe das genauso. Du warst heute nicht bei mir, aber ich pflege zu allen Menschen ein Verhältnis, das auf Respekt basiert, nicht auf Geheimnissen."

# game/scripts/c20/c20.rpy:2651
translate german c20s005_GivingMaddieARide_5db10965:

    # mc "Yo esperaba que nuestra relación evolucionara hacia algo más romántico. Pero si ha roto conmigo, creo que debería irme..."
    mc "Ich hatte gehofft, unsere Beziehung würde sich zu etwas Romantischerem entwickeln. Aber wenn er mit mir Schluss gemacht hat, sollte ich ihn wohl verlassen."

# game/scripts/c20/c20.rpy:2653
translate german c20s005_GivingMaddieARide_748c3ccd:

    # mad "¿Qué? ¡No!"
    mad "NEIN!"

# game/scripts/c20/c20.rpy:2655
translate german c20s005_GivingMaddieARide_d8b39b3d:

    # mad "Digo..."
    mad "Sagen..."

# game/scripts/c20/c20.rpy:2656
translate german c20s005_GivingMaddieARide_31d5dd14:

    # mad "Puedo hacer que Maddie vuelva, si quieres. Estoy segura de que le gustaría oir lo que has dicho."
    mad "Ich kann Maddie zurückholen, wenn du willst. Ich bin sicher, sie würde gern hören, was du gesagt hast."

# game/scripts/c20/c20.rpy:2657
translate german c20s005_GivingMaddieARide_74bfce3d:

    # mc "Sí, por favor. Hazla volver."
    mc "Ja, bitte. Bringt sie zurück."

# game/scripts/c20/c20.rpy:2659
translate german c20s005_GivingMaddieARide_26028f2c:

    # mad "Un momento, por favor."
    mad "Einen Augenblick bitte."

# game/scripts/c20/c20.rpy:2661
translate german c20s005_GivingMaddieARide_9c1cced8:

    # mad "Me ha dicho Claire que quieres hablar conmigo. Sobre por qué he roto contigo."
    mad "Claire hat mir gesagt, dass du mit mir reden willst. Darüber, warum ich mit dir Schluss gemacht habe."

# game/scripts/c20/c20.rpy:2662
translate german c20s005_GivingMaddieARide_ae0a59dd:

    # mc "¿A qué viene esto, Maddie?"
    mc "Worum geht es hier eigentlich, Maddie?"

# game/scripts/c20/c20.rpy:2664
translate german c20s005_GivingMaddieARide_189eaa31:

    # mad "No sabía cómo decirte que quiero estar contigo... "
    mad "Ich wusste nicht, wie ich dir sagen sollte, dass ich mit dir zusammen sein möchte..."

# game/scripts/c20/c20.rpy:2666
translate german c20s005_GivingMaddieARide_2701d7a4:

    # mad "... como estás con [mar]..."
    mad "...wie geht es Ihnen mit [mar]..."

# game/scripts/c20/c20.rpy:2668
translate german c20s005_GivingMaddieARide_715ea0d0:

    # mad "... como estás con el resto de las chicas..."
    mad "...genau wie du mit den anderen Mädchen umgehst..."

# game/scripts/c20/c20.rpy:2669
translate german c20s005_GivingMaddieARide_7fecd2e0:

    # mad "Quiero una relación de verdad. Me gusta mucho lo que tenemos, pero... después de ver lo que podría tener... quiero más."
    mad "Ich wünsche mir eine richtige Beziehung. Mir gefällt, was wir haben, aber... nachdem ich gesehen habe, was ich haben könnte... möchte ich mehr."

# game/scripts/c20/c20.rpy:2670
translate german c20s005_GivingMaddieARide_05dbb4cf:

    # mc "Y se te ha ocurrido este juego."
    mc "Und du hast dieses Spiel erfunden."

# game/scripts/c20/c20.rpy:2672
translate german c20s005_GivingMaddieARide_61508003:

    # mad "Llevo desde la Gran Revelación pensando cómo hacerlo. Y al final no he usado ninguna de las ideas que tenía."
    mad "Ich habe seit der großen Offenbarung darüber nachgedacht, wie ich das anstellen könnte. Und letztendlich habe ich keine meiner Ideen umgesetzt."

# game/scripts/c20/c20.rpy:2673
translate german c20s005_GivingMaddieARide_574339e8:

    # mad "Quería hablarlo en la piscina, pero justo en ese momento ha llegado Debbie..."
    mad "Ich wollte darüber am Pool reden, aber genau in dem Moment kam Debbie an..."

# game/scripts/c20/c20.rpy:2674
translate german c20s005_GivingMaddieARide_c2ba7b18:

    # mad "Quiero olvidar lo que hemos hecho hasta ahora y empezar desde cero. ¿Crees que podríamos probarlo?"
    mad "Ich möchte alles, was wir bisher gemacht haben, vergessen und von vorne anfangen. Meinst du, wir könnten es versuchen?"

# game/scripts/c20/c20.rpy:2675
translate german c20s005_GivingMaddieARide_add99a6a:

    # mc "No. Lo siento, Maddie."
    mc "Nein. Tut mir leid, Maddie."

# game/scripts/c20/c20.rpy:2677
translate german c20s005_GivingMaddieARide_2215400f:

    # mad "Pero..."
    mad "Aber..."

# game/scripts/c20/c20.rpy:2678
translate german c20s005_GivingMaddieARide_8755a89a:

    # mc "Déjame hablar un momento."
    mc "Gebt mir einen Moment Zeit zum Sprechen."

# game/scripts/c20/c20.rpy:2679
translate german c20s005_GivingMaddieARide_b09238b8:

    # mc "No quiero olvidar lo que hemos hecho hasta ahora. Creo que la evolución natural de lo que estábamos haciendo es lo que vamos a hacer ahora."
    mc "Ich möchte nicht vergessen, was wir bisher erreicht haben. Ich glaube, dass wir die natürliche Weiterentwicklung dessen, was wir bisher getan haben, nun fortsetzen werden."

# game/scripts/c20/c20.rpy:2680
translate german c20s005_GivingMaddieARide_5d3aacf1:

    # mc "Pero eso no significa que no nos lo hayamos pasado bien."
    mc "Das heißt aber nicht, dass wir keinen Spaß hatten."

# game/scripts/c20/c20.rpy:2681
translate german c20s005_GivingMaddieARide_c3916d55:

    # mc "Podemos tener una relación de verdad, pero sin dejar de hacer las cosas divertidas que hemos hecho hasta ahora."
    mc "Wir können eine echte Beziehung führen, ohne dabei aufzuhören, die schönen Dinge zu tun, die wir bisher zusammen gemacht haben."

# game/scripts/c20/c20.rpy:2683
translate german c20s005_GivingMaddieARide_82109074:

    # mad "Me parece bien... ¿Significa que ahora soy una más de tus novias?"
    mad "Das klingt gut für mich... Heißt das, ich bin jetzt eine deiner Freundinnen?"

# game/scripts/c20/c20.rpy:2684
translate german c20s005_GivingMaddieARide_d124f304:

    # mc "No me gustan las etiquetas, pero si a ti te gustan, sí, eres una más."
    mc "Ich mag keine Etiketten, aber wenn du sie magst, dann ja, dann gehörst du dazu."

# game/scripts/c20/c20.rpy:2686
translate german c20s005_GivingMaddieARide_8d834bb4:

    # "Maddie se lanza a tus brazos buscando tus labios en un beso lleno de alivio."
    "Maddie wirft sich in deine Arme und sucht deine Lippen in einem Kuss voller Erleichterung."

# game/scripts/c20/c20.rpy:2687
translate german c20s005_GivingMaddieARide_7c7f289f:

    # "El beso dura unos segundos antes de que se separe de ti."
    "Der Kuss dauert nur wenige Sekunden, bevor er sich von dir löst."

# game/scripts/c20/c20.rpy:2689
translate german c20s005_GivingMaddieARide_9ca2ff4a:

    # mad "¡Gracias, [mc]! Estaba aterrorizada de planteártelo."
    mad "Vielen Dank, [mc]! Ich hatte große Angst, das Thema bei dir anzusprechen."

# game/scripts/c20/c20.rpy:2690
translate german c20s005_GivingMaddieARide_7217336c:

    # mc "No me des las gracias. Los dos ganamos con este cambio. Es lo que los dos queremos."
    mc "Du brauchst mir nicht zu danken. Wir profitieren beide von dieser Veränderung. Es ist das, was wir beide wollen."

# game/scripts/c20/c20.rpy:2692
translate german c20s005_GivingMaddieARide_bad70e44:

    # mc "Y nunca me pareció que estuvieras muy a gusto en el papel de dominatrix."
    mc "Und ich hatte nie den Eindruck, dass Sie sich in der Rolle der Domina besonders wohlgefühlt haben."

# game/scripts/c20/c20.rpy:2694
translate german c20s005_GivingMaddieARide_7e73f8d0:

    # mad "No, no lo estaba. Me gustó probarlo y tener el control... pensar que tenía el control..."
    mad "Nein, das war ich nicht. Mir gefiel es, es auszuprobieren und die Kontrolle zu haben … in dem Glauben, die Kontrolle zu haben …"

# game/scripts/c20/c20.rpy:2696
translate german c20s005_GivingMaddieARide_7412199c:

    # mc "Aunque me pareció que estabas muy a gusto en el papel de gatita sumisa."
    mc "Obwohl es mir so vorkam, als ob Sie sich in der Rolle des unterwürfigen Kätzchens sehr wohlfühlten."

# game/scripts/c20/c20.rpy:2698
translate german c20s005_GivingMaddieARide_046425b4:

    # mad "Si, lo estaba. Me gustó probarlo y saber que no tenía el control..."
    mad "Ja, das war ich. Mir gefiel es, es auszuprobieren und zu wissen, dass ich keine Kontrolle hatte..."

# game/scripts/c20/c20.rpy:2699
translate german c20s005_GivingMaddieARide_22dd7e9a:

    # mad "Pero no estoy hecha para eso. Soy demasiado... normal..."
    mad "Aber dafür bin ich nicht geschaffen. Ich bin zu... normal..."

# game/scripts/c20/c20.rpy:2701
translate german c20s005_GivingMaddieARide_ccb07a8b:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con otras mujeres."
    mc "*Lacht* Nein, Maddie. Du bist nicht normal. Ich glaube nicht, dass „normal“ bedeutet, seinen Freund mit anderen Frauen zu teilen."

# game/scripts/c20/c20.rpy:2703
translate german c20s005_GivingMaddieARide_57756bba:

    # mc "*Risa* No, Maddie. No eres normal. No creo que \"normal\" incluya compartir a su novio con su suegra."
    mc "*Lacht* Nein, Maddie. Du bist nicht normal. Ich glaube nicht, dass „normal“ bedeutet, seinen Freund mit seiner Schwiegermutter zu teilen."

# game/scripts/c20/c20.rpy:2704
translate german c20s005_GivingMaddieARide_30a2cede:

    # mc "Pero me encanta que no seamos normales en esto. Además, ¿quién define qué es normal y qué no?"
    mc "Aber ich finde es toll, dass wir in dieser Hinsicht nicht normal sind. Außerdem, wer definiert schon, was normal ist und was nicht?"

# game/scripts/c20/c20.rpy:2705
translate german c20s005_GivingMaddieARide_338ebfc4:

    # mc "Y la gente a la que le gusta la dominación también son normales. Con otros gustos, pero normales."
    mc "Und auch Menschen, die auf Dominanz stehen, sind normal. Sie haben unterschiedliche Vorlieben, aber sie sind normal."

# game/scripts/c20/c20.rpy:2707
translate german c20s005_GivingMaddieARide_3f0c4ec5:

    # mad "¿Quieres quedarte a dormir? Nuestra primera vez como pareja..."
    mad "Möchtest du übernachten? Es ist unser erstes Mal als Paar..."

# game/scripts/c20/c20.rpy:2708
translate german c20s005_GivingMaddieARide_656167a3:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Nein, Maddie. Es ist spät … schon seit ein paar Stunden spät … und du musst dich ausruhen. Du musst morgen früh aufstehen."

# game/scripts/c20/c20.rpy:2710
translate german c20s005_GivingMaddieARide_b70c6047:

    # mad "Tienes razón, es tardísimo. Nuestra primera vez tendrá que esperar."
    mad "Du hast recht, es ist viel zu spät. Unser erstes Mal muss warten."

# game/scripts/c20/c20.rpy:2711
translate german c20s005_GivingMaddieARide_7a0a6a47:

    # mc "Sólo te pido una cosa. Pídele a Claire las gafas para lo próxima vez. *Risa* Estaba super sexy."
    mc "Ich hätte da nur eine Bitte. Frag Claire nächstes Mal nach der Brille. *lacht* Sie sah super sexy aus."

# game/scripts/c20/c20.rpy:2713
translate german c20s005_GivingMaddieARide_18d5ae23:

    # mad "*Risa* Sólo las uso cuando estoy en el ordenador muchas horas y me quito las lentillas. Normalmente no las necesito."
    mad "*Lacht* Ich benutze sie nur, wenn ich viele Stunden am Computer sitze und meine Kontaktlinsen herausnehme. Normalerweise brauche ich sie nicht."

# game/scripts/c20/c20.rpy:2714
translate german c20s005_GivingMaddieARide_f0928b95:

    # mc "Pues creo que las vamos a usar lejos del ordenador también. Estás monísima con ellas."
    mc "Ich denke, wir werden sie auch abseits des Computers tragen. Sie stehen dir ausgezeichnet."

# game/scripts/c20/c20.rpy:2716
translate german c20s005_GivingMaddieARide_0371334c:

    # mad "*Risa* Eso tiene fácil arreglo."
    mad "*Gelächter* Das lässt sich leicht beheben."

# game/scripts/c20/c20.rpy:2719
translate german c20s005_GivingMaddieARide_f5267c98:

    # mad "Dame un segundo que me quite las lentillas. Los ojos me pican muchísimo."
    mad "Einen Moment bitte, ich muss meine Kontaktlinsen rausnehmen. Meine Augen jucken furchtbar."

# game/scripts/c20/c20.rpy:2720
translate german c20s005_GivingMaddieARide_5b2e4889:

    # mc "No sabía que llevaras lentillas... pero ve, no te preocupes."
    mc "Ich wusste gar nicht, dass du Kontaktlinsen trägst... aber nur zu, keine Sorge."

# game/scripts/c20/c20.rpy:2722
translate german c20s005_GivingMaddieARide_ab55b4b0:

    # zeu "¡Miau! (¡Has vuelto! ¡Espero que vengas dispuesto a acariciarme!)"
    zeu "Miau! (Du bist wieder da! Hoffentlich bist du bereit, mich zu streicheln!)"

# game/scripts/c20/c20.rpy:2723
translate german c20s005_GivingMaddieARide_b7d29416:

    # mc "Hola, pequeñín. ¿Me has echado de menos?"
    mc "Hallo, Kleiner. Hast du mich vermisst?"

# game/scripts/c20/c20.rpy:2724
translate german c20s005_GivingMaddieARide_85d29c04:

    # zeu "¡Miau! (¿Me has traído atún para una cena tardía esta vez?)"
    zeu "Miau! (Hast du mir diesmal Thunfisch zum späten Abendessen mitgebracht?)"

# game/scripts/c20/c20.rpy:2726
translate german c20s005_GivingMaddieARide_9ee1b869_1:

    # zeu "*Ronroneo* (Vale, te perdono... Pero que no se vuelva a repetir.)"
    zeu "*Schnurr* (Okay, ich verzeihe dir... Aber lass es nicht wieder vorkommen.)"

# game/scripts/c20/c20.rpy:2727
translate german c20s005_GivingMaddieARide_f20a31cc_1:

    # mc "Yo también te he echado de menos. Tus cuadros han triunfado mucho."
    mc "Ich habe dich auch vermisst. Deine Gemälde waren ein großer Erfolg."

# game/scripts/c20/c20.rpy:2728
translate german c20s005_GivingMaddieARide_da4f0765_2:

    # zeu "*Ronroneo* (Soy muy versátil. Gótico y Científico a la vez. No hablaremos del vestido rosa. Eso nunca pasó. Tengo que hablar con mi psicólogo.)"
    zeu "*Schnurr* (Ich bin sehr vielseitig. Goth und Wissenschaftlerin zugleich. Über das rosa Kleid reden wir nicht. Das ist nie passiert. Ich muss mit meinem Psychologen sprechen.)"

# game/scripts/c20/c20.rpy:2730
translate german c20s005_GivingMaddieARide_8e201dc2:

    # mad "Ya estoy."
    mad "Ich bin hier."

# game/scripts/c20/c20.rpy:2731
translate german c20s005_GivingMaddieARide_e5a0c6fa:

    # mc "¡Wow! Te quedan genial. Deberías llevarlas más a menudo."
    mc "Wow! Die stehen dir super. Du solltest sie öfter tragen."

# game/scripts/c20/c20.rpy:2733
translate german c20s005_GivingMaddieARide_c3f43795:

    # mad "Gracias. ¿Quieres quedarte a dormir?"
    mad "Vielen Dank. Möchten Sie über Nacht bleiben?"

# game/scripts/c20/c20.rpy:2734
translate german c20s005_GivingMaddieARide_656167a3_1:

    # mc "No, Maddie. Es tarde... hace ya un par de horas que es tarde... y tienes que descansar. Mañana madrugas."
    mc "Nein, Maddie. Es ist spät … schon seit ein paar Stunden spät … und du musst dich ausruhen. Du musst morgen früh aufstehen."

# game/scripts/c20/c20.rpy:2736
translate german c20s005_GivingMaddieARide_07711480:

    # mad "Tienes razón, es tardísimo. Espero que el día que te quedes llegue pronto."
    mad "Du hast recht, es ist schon sehr spät. Ich hoffe, der Tag, an dem du bleibst, kommt bald."

# game/scripts/c20/c20.rpy:2737
translate german c20s005_GivingMaddieARide_aa3251b4:

    # mc "No tardará, te lo prometo."
    mc "Es dauert nicht mehr lange, versprochen."

# game/scripts/c20/c20.rpy:2739
translate german c20s005_GivingMaddieARide_fe5338d9:

    # "Os dais un beso de buenas noches, sabiendo que el día siguiente os volveréis a ver en la tienda."
    "Ihr gebt euch einen Gutenachtkuss, im Wissen, dass ihr euch am nächsten Tag im Laden wiedersehen werdet."

# game/scripts/c20/c20.rpy:2741
translate german c20s005_GivingMaddieARide_98198ac8:

    # mad "¡Oh, mierda!"
    mad "Oh Scheiße!"

# game/scripts/c20/c20.rpy:2742
translate german c20s005_GivingMaddieARide_b85e5ed2:

    # mc "¿Qué pasa, Maddie?"
    mc "Was ist los, Maddie?"

# game/scripts/c20/c20.rpy:2744
translate german c20s005_GivingMaddieARide_b7486548:

    # mad "Habíamos dicho de hacer el test de embarazo al acabar la partida de DnD y nos hemos olvidado los dos."
    mad "Wir hatten vereinbart, nach unserer Dungeons & Dragons-Partie einen Schwangerschaftstest zu machen, und wir haben es beide vergessen."

# game/scripts/c20/c20.rpy:2745
translate german c20s005_GivingMaddieARide_31b35a13:

    # mc "¡Es verdad! No he pensado en el test en todo el día, lo siento. Mañana te lo llevo a la tienda. Aún estaremos dentro del plazo de las 120 horas para la píldora."
    mc "Stimmt! Ich habe den ganzen Tag nicht an den Test gedacht, tut mir leid. Ich bringe ihn morgen in die Apotheke. Wir sind dann noch innerhalb des 120-Stunden-Fensters für die Pille."

# game/scripts/c20/c20.rpy:2747
translate german c20s005_GivingMaddieARide_bbfef618:

    # mad "Sobre eso... Si no te importa... Preferiría no tomarla."
    mad "Dazu möchte ich noch etwas sagen... Wenn es Ihnen nichts ausmacht... ich würde es lieber nicht annehmen."

# game/scripts/c20/c20.rpy:2749
translate german c20s005_GivingMaddieARide_aea65c3d:

    # mad "Nuestra relación ha cambiado y..."
    mad "Unsere Beziehung hat sich verändert und..."

# game/scripts/c20/c20.rpy:2751
translate german c20s005_GivingMaddieARide_889469d9:

    # mad "Después de todo lo que ha pasado hoy..."
    mad "Nach allem, was heute passiert ist..."

# game/scripts/c20/c20.rpy:2752
translate german c20s005_GivingMaddieARide_a58a0df2:

    # mc "Te entiendo. Pero ¿quieres saber igualmente si estás embarazada?"
    mc "Ich verstehe. Aber möchten Sie trotzdem wissen, ob Sie schwanger sind?"

# game/scripts/c20/c20.rpy:2754
translate german c20s005_GivingMaddieARide_5f0f935a:

    # mad "No. Quiero tener la experiencia de novia normal. Quiero enterarme cuando tenga un retraso y poder llamarte emocionada sin saber si estoy embarazada o no."
    mad "Nein. Ich möchte eine normale Beziehungserfahrung haben. Ich möchte wissen, wann meine Periode überfällig ist und dich voller Vorfreude anrufen können, ohne zu wissen, ob ich schwanger bin oder nicht."

# game/scripts/c20/c20.rpy:2755
translate german c20s005_GivingMaddieARide_83770045:

    # mad "Si a ti te parece bien, claro."
    mad "Wenn das für Sie in Ordnung ist, natürlich."

# game/scripts/c20/c20.rpy:2756
translate german c20s005_GivingMaddieARide_670e0d91:

    # mc "Me parece perfecto, Maddie. Los tests rápidos son fantásticos, pero le quitan un poco de esa emoción de la que hablas."
    mc "Das klingt perfekt, Maddie. Schnelltests sind fantastisch, aber sie nehmen einem etwas von der Aufregung, die du erwähnt hast."

# game/scripts/c20/c20.rpy:2758
translate german c20s005_GivingMaddieARide_c180beb8:

    # mad "Y ahora te voy a echar de mi casa antes de que empiece a bostezar. No sería muy glamouroso que me vieras hasta la campanilla cuando bostece."
    mad "Und jetzt schmeiße ich dich aus meinem Haus, noch bevor ich überhaupt anfangen kann zu gähnen. Es wäre ja nicht gerade glamourös, wenn du mich beim Gähnen bis zum Gaumenzäpfchen sähest."

# game/scripts/c20/c20.rpy:2759
translate german c20s005_GivingMaddieARide_1f99d993:

    # mc "*Risa* No te preocupes. Descansa y nos vemos mañana."
    mc "*Lacht* Keine Sorge. Ruh dich aus, wir sehen uns morgen."

# game/scripts/c20/c20.rpy:2761
translate german c20s005_GivingMaddieARide_ef8997c2:

    # "Os volvéis a dar otro beso de buenas noches y te marchas a casa antes de volver a enzarzaros en otro tema de conversación."
    "Ihr gebt euch noch einen Gute-Nacht-Kuss und geht nach Hause, bevor ihr euch auf ein anderes Gesprächsthema einlasst."

# game/scripts/c20/c20.rpy:2766
translate german c20s006_ReturningHome_accc05d2:

    # "Cuando llegas a casa, ves a Kiara de pie, al lado del garaje. Se ha cambiado de ropa."
    "Als du nach Hause kommst, siehst du Kiara an der Garage stehen. Sie hat sich umgezogen."

# game/scripts/c20/c20.rpy:2769
translate german c20s006_ReturningHome_a09a1c32:

    # mc "Hola de nuevo, Kiara. Iba a ir a buscarte a tu habitación."
    mc "Hallo nochmal, Kiara. Ich wollte dich in deinem Zimmer besuchen."

# game/scripts/c20/c20.rpy:2770
translate german c20s006_ReturningHome_0dc1d7eb:

    # kia "Eileen está durmiendo. Es muy tarde y mañana trabaja por la mañana."
    kia "Eileen schläft. Es ist sehr spät und sie muss morgen früh arbeiten."

# game/scripts/c20/c20.rpy:2771
translate german c20s006_ReturningHome_fc68535a:

    # mc "Tú también. Quizás deberías estar durmiendo."
    mc "Du auch. Vielleicht solltest du schlafen."

# game/scripts/c20/c20.rpy:2773
translate german c20s006_ReturningHome_7059ec6f:

    # kia "Lo he intentado, pero no puedo pegar ojo. Por eso necesito hablar."
    kia "Ich habe es versucht, aber ich kann kein Auge zutun. Deshalb muss ich reden."

# game/scripts/c20/c20.rpy:2774
translate german c20s006_ReturningHome_9fcd01ba:

    # mc "¿Quieres que pasemos dentro y hablemos?"
    mc "Möchtest du hineingehen und reden?"

# game/scripts/c20/c20.rpy:2776
translate german c20s006_ReturningHome_9305a04d:

    # kia "Mejor vayamos a sentarnos en la piscina. Así no molestaremos a nadie."
    kia "Lass uns zum Pool gehen und uns hinsetzen. So stören wir niemanden."

# game/scripts/c20/c20.rpy:2777
translate german c20s006_ReturningHome_7f866e75:

    # mc "Y nadie nos oirá."
    mc "Und niemand wird uns hören."

# game/scripts/c20/c20.rpy:2778
translate german c20s006_ReturningHome_c4ae781b:

    # kia "Exacto."
    kia "Genau."

# game/scripts/c20/c20.rpy:2780
translate german c20s006_ReturningHome_8b317a75:

    # "Kiara anda el camino hacia las tumbonas en silencio, delante tuyo. Parece que está ordenando sus ideas, como si estuviera preparando un discurso."
    "Kiara geht schweigend vor dir her zu den Sonnenliegen. Sie scheint ihre Gedanken zu sammeln, als ob sie eine Rede vorbereitet."

# game/scripts/c20/c20.rpy:2782
translate german c20s006_ReturningHome_5deaa470:

    # "Solo hay un problema. No hay tumbonas al llegar. Las han recogido después de la fiesta."
    "Es gibt nur ein Problem: Bei Ihrer Ankunft sind keine Liegestühle mehr vorhanden. Sie wurden nach der Party entfernt."

# game/scripts/c20/c20.rpy:2783
translate german c20s006_ReturningHome_b0967ddd:

    # "Ninguno de los dos os habéis dado cuenta mientras andabais hacia donde suelen estar."
    "Keiner von euch beiden hat es bemerkt, als ihr auf den Ort zugingt, wo sie sich normalerweise aufhalten."

# game/scripts/c20/c20.rpy:2785
translate german c20s006_ReturningHome_74650567:

    # kia "Vaya, han recogido las tumbonas. Tendremos que ir dentro."
    kia "Oh je, die Liegestühle sind weggeräumt. Wir müssen wohl hineingehen."

# game/scripts/c20/c20.rpy:2786
translate german c20s006_ReturningHome_bd191e3f:

    # mc "Podemos sentarnos en el borde de la piscina, como hemos hecho antes."
    mc "Wir können am Beckenrand sitzen, wie wir es schon früher getan haben."

# game/scripts/c20/c20.rpy:2787
translate german c20s006_ReturningHome_b8e83a6c:

    # kia "Como quieras..."
    kia "Was immer du willst..."

# game/scripts/c20/c20.rpy:2789
translate german c20s006_ReturningHome_089feeb3:

    # "Una vez descalzos y sentados, con los pies en el agua, Kiara se mantiene en silencio."
    "Sobald Kiara barfuß sitzt und die Füße im Wasser hat, bleibt sie still."

# game/scripts/c20/c20.rpy:2791
translate german c20s006_ReturningHome_a5e044c3:

    # mc "Kiara, ¿de qué quieres hablar? Me estás preocupando."
    mc "Kiara, worüber möchtest du reden? Du machst mir Sorgen."

# game/scripts/c20/c20.rpy:2792
translate german c20s006_ReturningHome_c7523d18:

    # kia "De nosotros..."
    kia "Von uns..."

# game/scripts/c20/c20.rpy:2794
translate german c20s006_ReturningHome_e370d625:

    # kia "No estoy segura de que lo que he hecho esta tarde haya sido lo mejor que podría haber hecho."
    kia "Ich bin mir nicht sicher, ob das, was ich heute Nachmittag getan habe, das Beste war, was ich hätte tun können."

# game/scripts/c20/c20.rpy:2795
translate german c20s006_ReturningHome_a5df840b:

    # mc "¿Qué has hecho? ¿Besarme?"
    mc "Was hast du getan? Mich geküsst?"

# game/scripts/c20/c20.rpy:2797
translate german c20s006_ReturningHome_2b5a2645:

    # kia "Sí. Delante de todas las chicas..."
    kia "Ja. Vor all den Mädchen..."

# game/scripts/c20/c20.rpy:2798
translate german c20s006_ReturningHome_0469b98b:

    # mc "Y, por lo que me ha parecido, todas te han felicitado por dar el paso de dejar tu pasado atrás, ¿no?"
    mc "Und soweit ich das beurteilen kann, haben sie Ihnen alle dazu gratuliert, dass Sie den Schritt gewagt haben, Ihre Vergangenheit hinter sich zu lassen, richtig?"

# game/scripts/c20/c20.rpy:2799
translate german c20s006_ReturningHome_54747eb3:

    # mc "Precisamente el día en que han visto cómo era tu pasado..."
    mc "Genau an dem Tag, als sie sahen, wie deine Vergangenheit aussah..."

# game/scripts/c20/c20.rpy:2801
translate german c20s006_ReturningHome_4ae66f04:

    # kia "Sí... pero es mi vida, no la suya..."
    kia "Ja... aber es ist mein Leben, nicht deins..."

# game/scripts/c20/c20.rpy:2802
translate german c20s006_ReturningHome_7c906f37:

    # mc "Y ninguna de ellas te va a forzar a dar ningún paso que no quieras dar, Kiara."
    mc "Und keiner von ihnen wird dich zu irgendwelchen Schritten zwingen, die du nicht gehen willst, Kiara."

# game/scripts/c20/c20.rpy:2804
translate german c20s006_ReturningHome_738b57de:

    # kia "A eso me refiero... ahora que he recuperado un poco el control de mi vida..."
    kia "Genau das meine ich... jetzt, wo ich wieder ein bisschen Kontrolle über mein Leben gewonnen habe..."

# game/scripts/c20/c20.rpy:2805
translate german c20s006_ReturningHome_e0765801:

    # kia "No sé que se espera de mí..."
    kia "Ich weiß nicht, was von mir erwartet wird..."

# game/scripts/c20/c20.rpy:2806
translate german c20s006_ReturningHome_9226b533:

    # mc "Nadie espera nada de ti. Lo que esperamos todos, yo incluído, es que consigas ser feliz en esta familia como no lo fuiste en tu familia anterior."
    mc "Niemand erwartet etwas von dir. Was wir alle hoffen, mich eingeschlossen, ist, dass du in dieser Familie glücklich wirst, anders als in deiner vorherigen."

# game/scripts/c20/c20.rpy:2808
translate german c20s006_ReturningHome_0023fec3:

    # kia "No me digas que nadie espera que nos acostemos juntos hoy."
    kia "Sag mir nicht, dass niemand erwartet, dass wir heute Nacht zusammen schlafen."

# game/scripts/c20/c20.rpy:2809
translate german c20s006_ReturningHome_f04255d3:

    # mc "¿Qué? ¡No! ¡Eso no lo espero ni siquiera yo!"
    mc "Was? Nein! Nicht einmal ich hätte das erwartet!"

# game/scripts/c20/c20.rpy:2813
translate german c20s006_ReturningHome_49695eab:

    # kia "Me acabas de mirar las tetas..."
    kia "Du hast gerade meine Brüste angestarrt..."

# game/scripts/c20/c20.rpy:2814
translate german c20s006_ReturningHome_ef78b8c0:

    # mc "No me malinterpretes. Si me lo propusieras, no diría que no ni por todo el oro del mundo. Pero no creo que sea el momento correcto."
    mc "Versteh mich nicht falsch. Wenn du mich fragen würdest, würde ich selbst für alles Gold der Welt nicht Nein sagen. Aber ich glaube, es ist nicht der richtige Zeitpunkt."

# game/scripts/c20/c20.rpy:2816
translate german c20s006_ReturningHome_de0bcae3:

    # kia "Pues dile eso a mi hija... "
    kia "Nun, das solltest du meiner Tochter erzählen..."

# game/scripts/c20/c20.rpy:2817
translate german c20s006_ReturningHome_da03b963:

    # mc "¿Eileen? ¿Qué te ha dicho?"
    mc "Eileen? Was hat sie dir gesagt?"

# game/scripts/c20/c20.rpy:2819
translate german c20s006_ReturningHome_9615fb6d:

    # kia "Me ha intentado convencer de que fuera a tu habitación esta noche. Cuando le he dicho que no, me ha preguntado que cuánto voy a esperar para tener sexo contigo."
    kia "Er versuchte mich zu überreden, heute Abend in dein Zimmer zu kommen. Als ich ablehnte, fragte er mich, wie lange ich denn noch warten wolle, bis ich mit dir schlafe."

# game/scripts/c20/c20.rpy:2820
translate german c20s006_ReturningHome_272c4fa5:

    # mc "Kiara, ha sido un día muy largo y todo el mundo tiene mucho que procesar. Tú, Eileen, y yo."
    mc "Kiara, es war ein sehr langer Tag und wir alle haben viel zu verarbeiten. Du, Eileen und ich."

# game/scripts/c20/c20.rpy:2822
translate german c20s006_ReturningHome_da9a66ac:

    # kia "Lo sé, pero no lo entiendes... Soy una mujer que... no sé... Siempre han tomado decisiones por mí. Me las han impuesto."
    kia "Ich weiß, aber du verstehst es nicht... Ich bin eine Frau, die... ich weiß nicht... Entscheidungen wurden immer für mich getroffen. Sie wurden mir aufgezwungen."

# game/scripts/c20/c20.rpy:2823
translate german c20s006_ReturningHome_f2c76260:

    # kia "Y Eileen lo sabe. Ahora es ella la que intenta hacerlo."
    kia "Und Eileen weiß es. Jetzt ist sie an der Reihe, es zu versuchen."

# game/scripts/c20/c20.rpy:2824
translate german c20s006_ReturningHome_77e80691:

    # mc "Eileen es una persona muy sexual. Demuestra su amor con sexo, entre otras cosas."
    mc "Eileen ist eine sehr sexuelle Person. Sie drückt ihre Liebe unter anderem durch Sex aus."

# game/scripts/c20/c20.rpy:2826
translate german c20s006_ReturningHome_bcba7e8d:

    # kia "Lo sé..."
    kia "Ich weiß..."

# game/scripts/c20/c20.rpy:2827
translate german c20s006_ReturningHome_f823a140:

    # mc "Pero si le das un momento para pensar se dará cuenta de que tú no eres igual. O al menos no pareces serlo."
    mc "Aber wenn du ihm einen Moment zum Nachdenken gibst, wird er merken, dass ihr nicht gleich seid. Oder zumindest scheint es so."

# game/scripts/c20/c20.rpy:2829
translate german c20s006_ReturningHome_3621ae77:

    # kia "No, no lo soy... para mí el sexo... Siempre he oído que debería ser... no sé... especial. Y nunca lo ha sido..."
    kia "Nein, ich bin nicht... für mich ist Sex... ich habe immer gehört, er sollte... ich weiß nicht... etwas Besonderes sein. Und das war er nie..."

# game/scripts/c20/c20.rpy:2831
translate german c20s006_ReturningHome_48105419:

    # kia "El beso de esta tarde me ha erizado el pelo de sitios donde no sabía que tenía pelo."
    kia "Der Kuss heute Nachmittag hat mir an Stellen, von denen ich gar nicht wusste, dass ich Haare habe, die Haare zu Berge stehen lassen."

# game/scripts/c20/c20.rpy:2832
translate german c20s006_ReturningHome_5beff731:

    # kia "Pero no quiero pensar en nada más allá de ese beso... por ahora..."
    kia "Aber ich möchte im Moment an nichts anderes denken als an diesen Kuss..."

# game/scripts/c20/c20.rpy:2833
translate german c20s006_ReturningHome_62396cdf:

    # mc "No hay ningún problema con eso. No lo hay conmigo ni lo hay con nadie más. Porque nadie más que tú y yo decidiremos cuándo va a pasar."
    mc "Das ist kein Problem. Weder für mich noch für irgendjemand anderen. Denn nur du und ich entscheiden, wann es so weit ist."

# game/scripts/c20/c20.rpy:2835
translate german c20s006_ReturningHome_6bc1b511:

    # kia "Entonces... ¿no te importa ir paso a paso?"
    kia "Also... macht es Ihnen nichts aus, Schritt für Schritt vorzugehen?"

# game/scripts/c20/c20.rpy:2836
translate german c20s006_ReturningHome_d7cc3734:

    # mc "No, no me importa. Es más, mañana te voy a invitar a cenar, si quieres."
    mc "Nein, das macht mir nichts aus. Wenn du möchtest, lade ich dich morgen sogar zum Abendessen ein."

# game/scripts/c20/c20.rpy:2837
translate german c20s006_ReturningHome_d759bfe7:

    # mc "Quizás, si empezamos a salir como una pareja tradicional te sientas más cómoda. Pero sólamente si quieres ir a cenar conmigo. Nadie te puede forzar a ello."
    mc "Vielleicht würdest du dich wohler fühlen, wenn wir uns wie ein ganz normales Paar treffen würden. Aber nur, wenn du mit mir essen gehen möchtest. Niemand kann dich dazu zwingen."

# game/scripts/c20/c20.rpy:2839
translate german c20s006_ReturningHome_62832fad:

    # kia "Sí, quiero. Pero mejor a comer. Si salimos de noche, Eileen me va a interrogar cuando volvamos."
    kia "Ja, gern. Aber wir sollten vorher etwas essen gehen. Wenn wir abends ausgehen, wird Eileen mich bei unserer Rückkehr ausfragen."

# game/scripts/c20/c20.rpy:2840
translate german c20s006_ReturningHome_8b671804:

    # mc "Perfecto. Tenemos una cita para comer."
    mc "Perfekt. Wir haben ein Mittagessen verabredet."

# game/scripts/c20/c20.rpy:2841
translate german c20s006_ReturningHome_0139acbd:

    # mc "Y recuerda que, aunque Eileen te interrogue, no tienes porqué contarle nada que no quieras contarle."
    mc "Und denk daran: Selbst wenn Eileen dich ausfragt, musst du ihr nichts erzählen, was du ihr nicht erzählen willst."

# game/scripts/c20/c20.rpy:2843
translate german c20s006_ReturningHome_1e9ad038:

    # kia "Lo sé. Ni sentirme forzada a hacer lo que ella quiera que haga."
    kia "Ich weiß. Und ich fühle mich auch nicht gezwungen, das zu tun, was sie von mir will."

# game/scripts/c20/c20.rpy:2844
translate german c20s006_ReturningHome_1ce75b02:

    # mc "Exacto."
    mc "Genau."

# game/scripts/c20/c20.rpy:2846
translate german c20s006_ReturningHome_54968c6f:

    # kia "Aunque {b}tú{/b} la mandes a que me de la charla y me convenza de cosas, como has hecho esta tarde."
    kia "Selbst wenn Sie sie schicken, um mir einen Vortrag zu halten und mich von Dingen zu überzeugen, so wie Sie es heute Nachmittag getan haben."

# game/scripts/c20/c20.rpy:2847
translate german c20s006_ReturningHome_c582738d:

    # mc "No, Kiara. No la he mandado a que te convenciera de nada. Estabas preocupada por cómo se sentiría si tú y yo empezábamos algo."
    mc "Nein, Kiara. Ich habe sie nicht geschickt, um dich von irgendetwas zu überzeugen. Du hast dir Sorgen gemacht, wie sie sich fühlen würde, wenn wir beide etwas anfangen würden."

# game/scripts/c20/c20.rpy:2848
translate german c20s006_ReturningHome_3979befc:

    # mc "Sólo le he dicho que te dijera cómo se sentiría. No tenía que ir más allá."
    mc "Ich habe ihm lediglich gesagt, er solle Ihnen seine Gefühle mitteilen. Mehr musste er nicht sagen."

# game/scripts/c20/c20.rpy:2850
translate german c20s006_ReturningHome_8fe26f31:

    # kia "*Risa* ¿No conoces a mi hija? ¿Creías que iba a parar después de decírmelo?"
    kia "*lacht* Kennen Sie meine Tochter denn nicht? Dachten Sie etwa, ich würde aufhören, nachdem Sie es mir gesagt haben?"

# game/scripts/c20/c20.rpy:2851
translate german c20s006_ReturningHome_ba48a9df:

    # mc "En un principio, sí, era lo que esperaba."
    mc "Zunächst ja, das hatte ich auch erwartet."

# game/scripts/c20/c20.rpy:2852
translate german c20s006_ReturningHome_feac233e:

    # mc "Cuando he visto cómo ha reaccionado cuando... durante el incidente... Creo que estaba muy ansiosa de librarse de su padre."
    mc "Als ich sah, wie sie während des Vorfalls reagierte... glaube ich, dass sie ihren Vater unbedingt loswerden wollte."

# game/scripts/c20/c20.rpy:2854
translate german c20s006_ReturningHome_01979e1c:

    # kia "Es gracioso que digas \"su padre\" en vez de \"Solomon\" o \"tu marido\"."
    kia "Es ist witzig, dass du „ihr Vater“ sagst, anstatt „Salomo“ oder „deinen Ehemann“."

# game/scripts/c20/c20.rpy:2855
translate german c20s006_ReturningHome_b63ee2e1:

    # kia "Es como si no quisieras recordarme que estoy casada con el padre de Eileen."
    kia "Es ist, als wolltest du mich nicht daran erinnern, dass ich mit Eileens Vater verheiratet bin."

# game/scripts/c20/c20.rpy:2856
translate german c20s006_ReturningHome_aad7fbb8:

    # mc "Es que no quiero recordártelo. Estais casados sobre el papel, pero has dicho que no volverás con él nunca."
    mc "Ich will dich nicht daran erinnern. Ihr seid zwar auf dem Papier verheiratet, aber du hast gesagt, dass du nie wieder mit ihm zusammenkommen wirst."

# game/scripts/c20/c20.rpy:2857
translate german c20s006_ReturningHome_190f1f31:

    # mc "En este caso, vuestro matrimonio es únicamente una formalidad hasta que te divorcies."
    mc "In diesem Fall ist Ihre Ehe nur eine Formalität, bis Sie sich scheiden lassen."

# game/scripts/c20/c20.rpy:2859
translate german c20s006_ReturningHome_20889386:

    # kia "Sabes que somos católicos, ¿verdad? Solomon nunca me concederá el divorcio."
    kia "Du weißt doch, dass wir katholisch sind, oder? Salomo würde mir niemals die Scheidung gewähren."

# game/scripts/c20/c20.rpy:2860
translate german c20s006_ReturningHome_38c27be6:

    # mc "Pues tendremos que buscar alguna forma de adecuar nuestra relación a tus creencias religiosas."
    mc "Wir müssen also einen Weg finden, unsere Beziehung an Ihre religiösen Überzeugungen anzupassen."

# game/scripts/c20/c20.rpy:2861
translate german c20s006_ReturningHome_b20eb053:

    # mc "No tengo ni idea de como puede afectarte esto."
    mc "Ich habe keine Ahnung, wie sich das auf Sie auswirken könnte."

# game/scripts/c20/c20.rpy:2863
translate german c20s006_ReturningHome_bae4722e:

    # kia "Entonces todo arreglado. Mañana comemos juntos y ya veremos... A ver como evoluciona esto... ¿Nos vamos a dormir?"
    kia "Dann ist alles geklärt. Wir essen morgen zusammen zu Mittag und schauen, wie es läuft... Mal sehen, wie sich das entwickelt... Sollen wir schlafen gehen?"

# game/scripts/c20/c20.rpy:2864
translate german c20s006_ReturningHome_dbeedd01:

    # mc "Sólo tengo una pregunta antes de irnos."
    mc "Ich habe nur noch eine Frage, bevor wir gehen."

# game/scripts/c20/c20.rpy:2865
translate german c20s006_ReturningHome_7e031e08:

    # mc "El salto de cama que llevabas antes... ¿Ibas a ir a mi habitación? ¿Te había convencido Eileen?"
    mc "Das Nachthemd, das du vorhin getragen hast... Wolltest du in mein Zimmer? Hatte Eileen dich überredet?"

# game/scripts/c20/c20.rpy:2867
translate german c20s006_ReturningHome_31cf8c7e:

    # kia "Casi. Me había vestido así por si reunía el valor para hacerlo."
    kia "Fast. Ich hatte mich so angezogen, falls ich den Mut dazu aufbringen sollte."

# game/scripts/c20/c20.rpy:2868
translate german c20s006_ReturningHome_e643b0b5:

    # kia "Cuando te he oído subir las escaleras, he pensado que sería un buen momento para hablarlo en vez de plantarme en tu habitación como una buscona."
    kia "Als ich dich die Treppe hochkommen hörte, dachte ich, es wäre ein guter Zeitpunkt, darüber zu reden, anstatt wie eine Schlampe in deinem Zimmer aufzutauchen."

# game/scripts/c20/c20.rpy:2870
translate german c20s006_ReturningHome_76a469d6:

    # kia "Por lo que estaba diciendo Eile, tenías que estar ansioso por que lo hiciera."
    kia "Nach Eiles Schilderungen zu urteilen, musste man ihn förmlich dazu drängen, es zu tun."

# game/scripts/c20/c20.rpy:2871
translate german c20s006_ReturningHome_c3f188e0:

    # kia "Por suerte, tenías que llevar a Maddie a casa y eso me ha salvado de hacer algo de lo que después seguramente me hubiera arrepentido."
    kia "Zum Glück musstest du Maddie nach Hause bringen, und das hat mich davor bewahrt, etwas zu tun, was ich später wahrscheinlich bereut hätte."

# game/scripts/c20/c20.rpy:2873
translate german c20s006_ReturningHome_2fb66a60:

    # kia "*Risa* No se lo tengas en cuenta a la chica."
    kia "*lacht* Nimm es dem Mädchen nicht übel."

# game/scripts/c20/c20.rpy:2874
translate german c20s006_ReturningHome_6a7e8bf5:

    # mc "Creo que es al revés. Creo que le tenemos que agradecer a Maddie que nos podamos tomar nuestro tiempo y hacer las cosas a nuestro ritmo."
    mc "Ich glaube, es ist genau umgekehrt. Ich finde, wir sollten Maddie dafür danken, dass sie uns Zeit gelassen und uns erlaubt hat, die Dinge in unserem eigenen Tempo zu erledigen."

# game/scripts/c20/c20.rpy:2876
translate german c20s006_ReturningHome_07cf9117:

    # kia "Visto así... tienes razón."
    kia "So gesehen... hast du recht."

# game/scripts/c20/c20.rpy:2878
translate german c20s006_ReturningHome_1f0aa400:

    # "Kiara se calza y se levanta para irse. Haces lo mismo."
    "Kiara zieht ihre Schuhe an und steht auf, um zu gehen. Du tust dasselbe."

# game/scripts/c20/c20.rpy:2879
translate german c20s006_ReturningHome_fecf056e:

    # kia "¿Me acompañas a casa de [nor]?"
    kia "Kommst du mit mir zu [nor]s Haus?"

# game/scripts/c20/c20.rpy:2880
translate german c20s006_ReturningHome_48d5f2ce:

    # mc "Sólo si me prometes que esta vez habrá beso de despedida y que dejarás de llamarla casa de [nor]. También es tu casa ahora."
    mc "Nur wenn du mir versprichst, dass es diesmal einen Abschiedskuss gibt und dass du aufhörst, es [nor]s Haus zu nennen. Es ist jetzt auch dein Haus."

# game/scripts/c20/c20.rpy:2882
translate german c20s006_ReturningHome_272ebc82:

    # kia "*Risa* Me parece bien. ¿Me acompañas a casa?"
    kia "*Lacht* Das klingt gut. Begleitest du mich nach Hause?"

# game/scripts/c20/c20.rpy:2884
translate german c20s006_ReturningHome_997a1865:

    # mc "No has dicho nada del beso..."
    mc "Du hast nichts über den Kuss gesagt..."

# game/scripts/c20/c20.rpy:2887
translate german c20s006_ReturningHome_012de196:

    # "Kiara se lanza a por tus labios, con la misma dulzura y avidez que ha hecho por la tarde, sorprendiéndote con ambas."
    "Kiara stürzt sich mit derselben Süße und Begierde wie am Nachmittag auf deine Lippen und überrascht dich mit beidem."

# game/scripts/c20/c20.rpy:2889
translate german c20s006_ReturningHome_6bf383c5:

    # kia "¿Te parece suficiente promesa?"
    kia "Erscheint Ihnen das als ausreichendes Versprechen?"

# game/scripts/c20/c20.rpy:2890
translate german c20s006_ReturningHome_b32ecd82:

    # mc "Me parece perfecta."
    mc "Ich finde es perfekt."

# game/scripts/c20/c20.rpy:2892
translate german c20s006_ReturningHome_cf33bef7:

    # "El camino de la piscina hasta la casa de [nor], la casa de Kiara, no os debería llevar más de dos o tres minutos. Os lleva más de quince."
    "Der Fußweg vom Pool zu Kiaras Haus sollte nicht länger als zwei oder drei Minuten dauern. Er dauert aber mehr als fünfzehn Minuten."

# game/scripts/c20/c20.rpy:2894
translate german c20s006_ReturningHome_79a713f1:

    # "Os paráis cada pocos metros para volver a besaros."
    "Alle paar Meter bleibt ihr stehen, um euch erneut zu küssen."

# game/scripts/c20/c20.rpy:2896
translate german c20s006_ReturningHome_f6f158a0:

    # "Y esos pocos metros los recorréis, a paso lento, cogidos de la mano, intentando alargar la experiencia lo máximo posible."
    "Und ihr geht diese wenigen Meter langsam, Hand in Hand, und versucht, das Erlebnis so lange wie möglich hinauszuzögern."

# game/scripts/c20/c20.rpy:2898
translate german c20s006_ReturningHome_5fdefe13:

    # "Pero al final llegáis a la puerta principal. Un último beso antes de separaros."
    "Doch schließlich erreichst du die Haustür. Ein letzter Kuss, bevor sich eure Wege trennen."

# game/scripts/c20/c20.rpy:2900
translate german c20s006_ReturningHome_0dba28f7:

    # kia "Pues hasta aquí ha llegado nuestro paseo..."
    kia "Nun, hier endet unser Spaziergang..."

# game/scripts/c20/c20.rpy:2901
translate german c20s006_ReturningHome_ab22a5bd:

    # mc "Si por mí fuera, lo podríamos repetir todas las noches."
    mc "Wenn es nach mir ginge, könnten wir es jeden Abend wiederholen."

# game/scripts/c20/c20.rpy:2903
translate german c20s006_ReturningHome_63be4610:

    # kia "No creo que me sentara bien una ducha fría todas las noches a la 1:00 AM... o la hora que sea ya."
    kia "Ich glaube nicht, dass ich mit einer kalten Dusche jede Nacht um 1:00 Uhr morgens... oder wann auch immer es jetzt ist, glücklich wäre."

# game/scripts/c20/c20.rpy:2904
translate german c20s006_ReturningHome_5a9f0d9e:

    # mc "¿Vas a darte una ducha ahora?"
    mc "Wirst du jetzt duschen?"

# game/scripts/c20/c20.rpy:2906
translate german c20s006_ReturningHome_245e31b5:

    # kia "No preguntes lo que no quieras saber. Y no te ofrezcas a enjabonarme la espalda. *Risa*"
    kia "Frag nicht, was du nicht wissen willst. Und biete mir nicht an, mir den Rücken zu waschen. *lacht*"

# game/scripts/c20/c20.rpy:2907
translate german c20s006_ReturningHome_dde5cc42:

    # mc "*Risa* No lo voy a hacer. Seguramente no me conformaría con la espalda."
    mc "*Lacht* Das werde ich nicht tun. Ich wäre mit meinem Rücken allein ganz sicher nicht zufrieden."

# game/scripts/c20/c20.rpy:2909
translate german c20s006_ReturningHome_0268ab97:

    # kia "Entonces, hasta mañana a la hora de comer, ¿no?"
    kia "Dann sehen wir uns morgen zur Mittagszeit, ja?"

# game/scripts/c20/c20.rpy:2910
translate german c20s006_ReturningHome_f7213923:

    # mc "Sí, no creo que esté levantado cuando vayas a trabajar. ¿Quieres que te pase a buscar sobre la 1:00 PM?"
    mc "Ja, ich glaube nicht, dass ich wach sein werde, wenn du zur Arbeit gehst. Soll ich dich gegen 13:00 Uhr abholen?"

# game/scripts/c20/c20.rpy:2911
translate german c20s006_ReturningHome_375bdc59:

    # kia "Es una buena hora. Normalmente salgo entre la 1:00 y la 1:30 a comer. Tengo una hora de tiempo."
    kia "Das ist ein guter Zeitpunkt. Ich gehe normalerweise zwischen 13:00 und 13:30 Uhr zum Mittagessen. Ich habe eine Stunde Zeit."

# game/scripts/c20/c20.rpy:2912
translate german c20s006_ReturningHome_4b85b8a1:

    # mc "Buscaré algún sitio cerca de la biblioteca para ir a comer. Y no, no vamos a ir al puesto de los perritos calientes en nuestra primera cita."
    mc "Ich suche mir ein Lokal in der Nähe der Bibliothek. Und nein, wir gehen beim ersten Date nicht zum Hotdog-Stand."

# game/scripts/c20/c20.rpy:2914
translate german c20s006_ReturningHome_949e2cf6:

    # kia "*Risita* Me parece bien, aunque casi consideraría este paseo como nuestra primera cita."
    kia "*Kichern* Das klingt gut für mich, obwohl ich diesen Spaziergang fast schon als unser erstes Date betrachten würde."

# game/scripts/c20/c20.rpy:2915
translate german c20s006_ReturningHome_270bcedd:

    # mc "Lo será si acaba en beso."
    mc "Das wird der Fall sein, wenn es mit einem Kuss endet."

# game/scripts/c20/c20.rpy:2917
translate german c20s006_ReturningHome_08df730a:

    # "Acaba en beso. Un beso que dice que mañana habrá más. Un beso que sabe a despedida, aunque solo sea por doce horas."
    "Es endet mit einem Kuss. Ein Kuss, der sagt: Morgen gibt es mehr. Ein Kuss, der nach Abschied schmeckt, auch wenn es nur für zwölf Stunden ist."

# game/scripts/c20/c20.rpy:2918
translate german c20s006_ReturningHome_be90d0b8:

    # "Un beso en el que no hay dudas, que empieza a un ritmo suave y que acelera poco a poco. Como esperas que pase con vuestra relación."
    "Ein Kuss ohne Zweifel, der sanft beginnt und sich allmählich intensiviert. Genau so, wie man es sich für seine Beziehung wünscht."

# game/scripts/c20/c20.rpy:2920
translate german c20s006_ReturningHome_d2b8a5a5:

    # kia "Hasta mañana, [mc]. Esperaré ansiosa que vengas a buscarme."
    kia "Wir sehen uns morgen, [mc]. Ich freue mich schon darauf, dass du mich abholst."

# game/scripts/c20/c20.rpy:2921
translate german c20s006_ReturningHome_de54c180:

    # mc "Hasta mañana, Kiara. Yo estaré ansioso por ir."
    mc "Wir sehen uns morgen, Kiara. Ich freue mich schon sehr darauf."

# game/scripts/c20/c20.rpy:2922
translate german c20s006_ReturningHome_39c53149:

    # mc "*Risa* Y tampoco vamos a ir al puesto de los perritos calientes en nuestra segunda cita, ahora que ésta cuenta como la primera."
    mc "*Lacht* Und wir gehen auch bei unserem zweiten Date nicht zum Hotdog-Stand, jetzt, wo dieses hier als erstes zählt."

# game/scripts/c20/c20.rpy:2928
translate german c20s007_Teaser_ffbf891b:

    # "Al volver a tu habitación..."
    "Wenn Sie in Ihr Zimmer zurückkehren..."

# game/scripts/c20/c20.rpy:2930
translate german c20s007_Teaser_d72364f0:

    # emm "¡Has tardado muchísimo en volver!"
    emm "Du hast ewig gebraucht, um zurückzukommen!"

# game/scripts/c20/c20.rpy:2931
translate german c20s007_Teaser_433f4a0f:

    # dap "Estábamos a punto de irnos. Menos mal que has llegado ahora."
    dap "Wir wollten gerade abreisen. Zum Glück sind Sie jetzt angekommen."

# game/scripts/c20/c20.rpy:2933
translate german c20s007_Teaser_5dab658f:

    # eri "Creíamos que te ibas a quedar a dormir en casa de Maddie."
    eri "Wir dachten, du würdest bei Maddie übernachten."

# game/scripts/c20/c20.rpy:2935
translate german c20s007_Teaser_37fa3aff:

    # eri "O de llamarte para saber si te había pasado algo."
    eri "Oder um Sie anzurufen und sich zu erkundigen, ob Ihnen etwas zugestoßen ist."

