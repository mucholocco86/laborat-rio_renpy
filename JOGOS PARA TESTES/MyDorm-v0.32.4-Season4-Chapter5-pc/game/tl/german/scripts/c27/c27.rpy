

# game/scripts/c27/c27.rpy:40
translate german c27_0ae9bcd0:

    # ""
    ""

# game/scripts/c27/c27.rpy:55
translate german c27s001_DebDate_6e671808:

    # deb "Gracias, pero no intentes ruborizarme. Creo que ya lo has hecho suficiente con [kat] esta mañana."
    deb "Danke, aber versuch nicht, mich in Verlegenheit zu bringen. Ich denke, du hast heute Morgen schon genug mit [kat] angestellt."

# game/scripts/c27/c27.rpy:56
translate german c27s001_DebDate_0d4c2f91:

    # mc "No lo digo por ruborizarte, lo digo porque es verdad. Además, me encanta cómo te queda ese vestido."
    mc "Ich sage das nicht, um dich bloßzustellen, sondern weil es der Wahrheit entspricht. Außerdem finde ich, dass dir das Kleid hervorragend steht."

# game/scripts/c27/c27.rpy:58
translate german c27s001_DebDate_81172e04:

    # deb "[kim] me ha dicho que... como tengo las piernas tan largas... un vestido asimétrico las realzaría."
    deb "[kim] sagte mir, dass... da ich so lange Beine habe... ein asymmetrisches Kleid diese betonen würde."

# game/scripts/c27/c27.rpy:59
translate german c27s001_DebDate_51301f4a:

    # deb "No sé si creerla. Siempre he pensado que tengo las piernas {b}demasiado{/b} largas. No es una cosa que me guste realzar."
    deb "Ich weiß nicht, ob ich ihr glauben soll. Ich habe immer gedacht, meine Beine seien zu lang. Es ist nichts, was ich gern betone."

# game/scripts/c27/c27.rpy:60
translate german c27s001_DebDate_ef669374:

    # mc "Cielo, no existen 'piernas {b}demasiado{/b} largas'."
    mc "Schatz, es gibt keine „Beine, die {b}zu{/b}lang sind“."

# game/scripts/c27/c27.rpy:61
translate german c27s001_DebDate_20b041d4:

    # mc "Como se suele decir, las tuyas son tan largas que, al recorrerlas, apetece hacer un descanso a medio camino."
    mc "Wie man so schön sagt, deine sind so lang, dass man beim Gehen nach der Hälfte der Strecke am liebsten eine Pause einlegen möchte."

# game/scripts/c27/c27.rpy:63
translate german c27s001_DebDate_a513a08c:

    # deb "¡[mc]! ¡Eso ha sonado más travieso de lo que creo que querías sonar!"
    deb "[mc]! Das klang unanständiger, als du es wohl gemeint hast!"

# game/scripts/c27/c27.rpy:64
translate german c27s001_DebDate_442b68f3:

    # mc "*Risa* No te imaginas lo travieso que quería sonar."
    mc "*lacht* Du kannst dir nicht vorstellen, wie unanständig ich klingen wollte."

# game/scripts/c27/c27.rpy:65
translate german c27s001_DebDate_f5cc2b81:

    # mc "Pero, ¿puedo besar a mi cita?"
    mc "Aber darf ich mein Date küssen?"

# game/scripts/c27/c27.rpy:67
translate german c27s001_DebDate_a10869e9:

    # "La sirena no te contesta y toma la iniciativa por sí misma, besándote dulcemente. Los tacones y la diferencia de altura te hacen sentirte pequeño."
    "Die Meerjungfrau antwortet dir nicht und ergreift selbst die Initiative, indem sie dich zärtlich küsst. Die hohen Absätze und der Größenunterschied lassen dich klein fühlen."

# game/scripts/c27/c27.rpy:68
translate german c27s001_DebDate_72f51c6f:

    # "¡Cómo ha cambiado la nadadora! Ha pasado de inventarse juegos para robarte un beso a tomar la iniciativa."
    "Wie sich die Schwimmerin doch verändert hat! Früher hat sie sich Spiele ausgedacht, um einen Kuss zu stehlen, jetzt ergreift sie selbst die Initiative."

# game/scripts/c27/c27.rpy:69
translate german c27s001_DebDate_db44b796:

    # "Es un beso que te dejará con ganas de más cuando termine. Da lo mismo que dure un segundo o una hora."
    "Es ist ein Kuss, der dich nach mehr verlangen lässt, wenn er vorbei ist. Dabei spielt es keine Rolle, ob er eine Sekunde oder eine Stunde dauert."

# game/scripts/c27/c27.rpy:71
translate german c27s001_DebDate_4b388357:

    # "Cuando separa sus labios de los tuyos sientes una sensación de pérdida."
    "Als er seine Lippen von deinen löst, verspürst du ein Gefühl des Verlustes."

# game/scripts/c27/c27.rpy:72
translate german c27s001_DebDate_b763e483:

    # deb "Vámonos antes de que tenga que llevarte a tu habitación a probar esa cama nueva."
    deb "Lass uns gehen, bevor ich dich in dein Zimmer bringen muss, damit du das neue Bett ausprobieren kannst."

# game/scripts/c27/c27.rpy:73
translate german c27s001_DebDate_e4ee9aa0:

    # mc "*Risa* Ahora eres tú la que has sonado traviesa..."
    mc "*Gelächter* Jetzt klangst du aber unanständig..."

# game/scripts/c27/c27.rpy:75
translate german c27s001_DebDate_151de55f:

    # deb "*Risa* Pero no más de lo que quería sonar."
    deb "*lacht* Aber nicht mehr, als ich klingen wollte."

# game/scripts/c27/c27.rpy:76
translate german c27s001_DebDate_4730b6b0:

    # deb "Tengo intención de que me enseñes esa cama cuando volvamos de comer."
    deb "Ich möchte, dass du mir das Bett zeigst, wenn wir vom Essen zurückkommen."

# game/scripts/c27/c27.rpy:77
translate german c27s001_DebDate_9e51209c:

    # "Otra vez te maravillas de lo mucho que ha evolucionado la siempre tímida [deb.nick]."
    "Wieder einmal staunt man darüber, wie sehr sich das stets scheue [deb.nick] weiterentwickelt hat."

# game/scripts/c27/c27.rpy:78
translate german c27s001_DebDate_e9d72f3f:

    # mc "Entonces será mejor que nos vayamos. [emm] quería ser la primera en probar la cama."
    mc "Dann sollten wir besser gehen. [emm] Ich wollte die Erste sein, die das Bett ausprobiert."

# game/scripts/c27/c27.rpy:80
translate german c27s001_DebDate_e8b5c3db:

    # deb "Ya veremos..."
    deb "Wir werden sehen..."

# game/scripts/c27/c27.rpy:81
translate german c27s001_DebDate_04df0c90:

    # mc "Me gusta esa nueva [deb.nick]. Pero espera..."
    mc "Mir gefällt das neue [deb.nick]. Aber warte mal..."

# game/scripts/c27/c27.rpy:83
translate german c27s001_DebDate_9b1b27ed:

    # deb "¿Qué pasa?"
    deb "Was passiert?"

# game/scripts/c27/c27.rpy:84
translate german c27s001_DebDate_dc5fdda3:

    # mc "Quiero un beso antes de irnos."
    mc "Ich möchte einen Kuss, bevor wir gehen."

# game/scripts/c27/c27.rpy:86
translate german c27s001_DebDate_0d0a276b:

    # deb "¡Soy idiota! ¡Estaba tan nerviosa por si te gustaría el vestido que ni he pensado en el beso!"
    deb "Ich bin so ein Idiot! Ich war so nervös, ob dir das Kleid gefallen würde, dass ich gar nicht an den Kuss gedacht habe!"

# game/scripts/c27/c27.rpy:87
translate german c27s001_DebDate_29ea87c7:

    # mc "Y sigues nerviosa. Ya nos hemos besado."
    mc "Und du bist immer noch nervös. Wir haben uns doch schon geküsst."

# game/scripts/c27/c27.rpy:88
translate german c27s001_DebDate_8ca2a38c:

    # deb "¿Qué? ¿Cuándo?"
    deb "Was? Wann?"

# game/scripts/c27/c27.rpy:89
translate german c27s001_DebDate_e9fe48bf:

    # mc "*Risa* Hace un minuto. Ven aquí."
    mc "*Lacht* Vor einer Minute. Komm her."

# game/scripts/c27/c27.rpy:91
translate german c27s001_DebDate_e23c623f:

    # "Las tres pulgadas que [deb.nick] es más alta que tú, más los tacones suplen el escalón que ella está más abajo."
    "Die drei Zoll, um die [deb.nick] größer ist als du, plus die Absätze, gleichen den Unterschied aus, den sie kleiner ist."

# game/scripts/c27/c27.rpy:92
translate german c27s001_DebDate_792ce7a8:

    # "Por primera vez no tienes que inclinar tu cabeza hacia atrás para besarla. Lo echas de menos. Adoras la altura de la nadadora."
    "Zum ersten Mal musst du deinen Kopf nicht mehr in den Nacken legen, um sie zu küssen. Das hast du vermisst. Du liebst die Größe der Schwimmerin."

# game/scripts/c27/c27.rpy:94
translate german c27s001_DebDate_9cb06c4d:

    # deb "Si me besas así, se me van a pasar los nervios. Pero creo que entonces podré pasar de la comida e ir directamente a ver esa cama."
    deb "Wenn du mich so küsst, beruhige ich mich. Aber ich glaube, dann kann ich das Essen auslassen und direkt ins Bett gehen."

# game/scripts/c27/c27.rpy:95
translate german c27s001_DebDate_8cc92cfd:

    # mc "Entonces dejaré de besarte hasta que acabemos de comer. Tengo muchas ganas de ir a comer contigo."
    mc "Dann höre ich auf, dich zu küssen, bis wir mit dem Essen fertig sind. Ich freue mich schon sehr darauf, mit dir zu essen."

# game/scripts/c27/c27.rpy:97
translate german c27s001_DebDate_dc12975b:

    # deb "Besar o comer. *Risa* Me pones entre la espada y la pared. Vámonos antes de que haga una locura."
    deb "Küssen oder essen. *Lacht* Du hast mich in eine schwierige Lage gebracht. Lass uns gehen, bevor ich etwas Verrücktes anstelle."

# game/scripts/c27/c27.rpy:98
translate german c27s001_DebDate_765d6b56:

    # mc "Cualquier locura compartida me parecería bien. Pero podemos esperar a después de comer."
    mc "Jeglicher gemeinsamer Wahnsinn wäre mir recht. Aber wir können bis nach dem Mittagessen warten."

# game/scripts/c27/c27.rpy:101
translate german c27s001_DebDate_cec05883:

    # "Una vez llegáis al restaurante..."
    "Sobald Sie im Restaurant ankommen..."

# game/scripts/c27/c27.rpy:103
translate german c27s001_DebDate_2a2dd50a:

    # deb "Es bonito. Me recuerda a un sitio en el que estuvimos hace un par de años, en Verona."
    deb "Es ist wunderschön. Es erinnert mich an einen Ort, den wir vor ein paar Jahren in Verona besucht haben."

# game/scripts/c27/c27.rpy:104
translate german c27s001_DebDate_2c8bb01b:

    # deb "Se nota que es un decorado, pero está muy logrado."
    deb "Es ist eindeutig ein Set, aber es ist sehr gut gemacht."

# game/scripts/c27/c27.rpy:105
translate german c27s001_DebDate_9a611046:

    # mc "¿Has viajado mucho fuera de Estados Unidos?"
    mc "Sind Sie schon viel außerhalb der Vereinigten Staaten gereist?"

# game/scripts/c27/c27.rpy:107
translate german c27s001_DebDate_844704a1:

    # deb "Un poco. Creo que este año es el primer verano que recuerdo sin ningún viaje al extranjero en los últimos 13 o 14 años."
    deb "Ein bisschen. Ich glaube, dies ist der erste Sommer seit 13 oder 14 Jahren, an den ich mich erinnern kann, ohne ins Ausland gereist zu sein."

# game/scripts/c27/c27.rpy:108
translate german c27s001_DebDate_ebd54c03:

    # mc "¿En qué países has estado?"
    mc "In welchen Ländern waren Sie schon?"

# game/scripts/c27/c27.rpy:109
translate german c27s001_DebDate_eb037365:

    # deb "Italia, Reino Unido, Portugal, España, Francia, Dinamarca, Suecia, Noruega, Suiza, Alemania, Grecia, Turquía, Japón, China, Australia, Nueva Zelanda, India, Vietnam..."
    deb "Italien, Vereinigtes Königreich, Portugal, Spanien, Frankreich, Dänemark, Schweden, Norwegen, Schweiz, Deutschland, Griechenland, Türkei, Japan, China, Australien, Neuseeland, Indien, Vietnam..."

# game/scripts/c27/c27.rpy:111
translate german c27s001_DebDate_57e9a0d2:

    # deb "¿Cuánto rato me vas a seguir dejando decir países?"
    deb "Wie lange wollen Sie mir noch erlauben, Länder zu nennen?"

# game/scripts/c27/c27.rpy:112
translate german c27s001_DebDate_fb7527d3:

    # mc "Pensaba dejarte hasta que recorrieras la ONU al completo. *Risa*"
    mc "Ich hatte eigentlich vor, dich so lange allein zu lassen, bis du die gesamte UNO erkundet hättest. *lacht*"

# game/scripts/c27/c27.rpy:114
translate german c27s001_DebDate_ee968cba:

    # deb "*Risa* No, qué va. En África sólo he estado en Marruecos, Túnez y Egipto. En Latino América sólo en México, Perú, Guatemala, Ecuador, Brasil y Colombia."
    deb "*lacht* Nein, überhaupt nicht. In Afrika war ich bisher nur in Marokko, Tunesien und Ägypten. In Lateinamerika nur in Mexiko, Peru, Guatemala, Ecuador, Brasilien und Kolumbien."

# game/scripts/c27/c27.rpy:115
translate german c27s001_DebDate_79a6b884:

    # deb "La Unión Europea la he recorrido entera, y de Asia me quedaban por decir Camboya y Tailandia. Creo que no me dejo ningún país de la lista..."
    deb "Ich bin durch die gesamte Europäische Union gereist, und in Asien gab es noch Kambodscha und Thailand zu erwähnen. Ich glaube, ich habe kein Land auf der Liste vergessen…"

# game/scripts/c27/c27.rpy:116
translate german c27s001_DebDate_d5f11554:

    # mc "Es decir... unos 50 países en 13 o 14 años... es impresionante. Pero casi te daba tiempo a aterrizar y poco más, ¿no?"
    mc "Ich meine... etwa 50 Länder in 13 oder 14 Jahren... das ist beeindruckend. Aber du hattest ja kaum Zeit zum Landen und sonst nicht viel, richtig?"

# game/scripts/c27/c27.rpy:118
translate german c27s001_DebDate_02eeb9de:

    # deb "Bueno, en verano hacíamos viajes de un mes con mi madre cuando acababan las clases. Y después un par de semanas extras con mi padre en Agosto."
    deb "Nun ja, im Sommer unternahmen wir nach Semesterende immer einmonatige Reisen mit meiner Mutter. Und dann noch ein paar zusätzliche Wochen im August mit meinem Vater."

# game/scripts/c27/c27.rpy:119
translate german c27s001_DebDate_f42e0d10:

    # deb "Suma a eso Acción de Gracias, Navidad... Quizás eran un par de meses viajando cada año. Y no son 50 países, sólo 48."
    deb "Dazu kommen noch Thanksgiving, Weihnachten... Vielleicht waren das jedes Jahr ein paar Monate Reisezeit. Und es sind nicht 50 Länder, sondern nur 48."

# game/scripts/c27/c27.rpy:120
translate german c27s001_DebDate_96ed9f61:

    # mc "Sigue siendo impresionante."
    mc "Es ist immer noch beeindruckend."

# game/scripts/c27/c27.rpy:122
translate german c27s001_DebDate_e5b3767a:

    # deb "Hay países que me hubiera gustado ver más en profundidad. De algunos sólo he estado en una o dos ciudades."
    deb "Es gibt Länder, die ich gerne genauer erkundet hätte. In manchen habe ich nur ein oder zwei Städte besucht."

# game/scripts/c27/c27.rpy:123
translate german c27s001_DebDate_24a624ac:

    # deb "Y hay otros a los que he ido varias veces, como Italia, Francia, España, Canadá..."
    deb "Und es gibt noch andere Länder, die ich schon mehrmals besucht habe, wie Italien, Frankreich, Spanien, Kanada..."

# game/scripts/c27/c27.rpy:124
translate german c27s001_DebDate_9b15654d:

    # mc "¿Tienes algún país favorito?"
    mc "Hast du ein Lieblingsland?"

# game/scripts/c27/c27.rpy:126
translate german c27s001_DebDate_9ff5f84b:

    # deb "Muchos. No podría elegir uno. Cada país tiene su encanto, su cultura... Por norma mi país favorito es en el que estoy en ese momento."
    deb "Viele. Ich könnte mich nicht für nur eines entscheiden. Jedes Land hat seinen eigenen Charme, seine eigene Kultur... In der Regel ist mein Lieblingsland das, in dem ich mich gerade befinde."

# game/scripts/c27/c27.rpy:127
translate german c27s001_DebDate_0559c921:

    # deb "Si empiezas a pensar cosas como 'esto era más bonito, o estaba más bueno, en otro sitio' no disfrutas lo que estás viviendo."
    deb "Wenn man anfängt zu denken: „Das war woanders schöner oder besser“, dann kann man das, was man gerade erlebt, nicht mehr genießen."

# game/scripts/c27/c27.rpy:128
translate german c27s001_DebDate_5dc520e9:

    # deb "Me encanta viajar, y cuando estoy en un sitio sólo existe ese sitio. No puedo compararlo con otros."
    deb "Ich reise unheimlich gern, und wenn ich irgendwo bin, existiert nur dieser Ort für mich. Ich kann ihn mit keinem anderen vergleichen."

# game/scripts/c27/c27.rpy:129
translate german c27s001_DebDate_97045e27:

    # mc "Nunca lo había visto así. Siempre he oído a gente decir 'Estoy enamorado de Japón, Italia, o España'."
    mc "So hatte ich das noch nie betrachtet. Ich habe immer nur gehört: „Ich bin in Japan, Italien oder Spanien verliebt.“"

# game/scripts/c27/c27.rpy:130
translate german c27s001_DebDate_120ee616:

    # mc "Tiene mucha más lógica cómo lo dices tú."
    mc "So wie du es sagst, klingt es viel einleuchtender."

# game/scripts/c27/c27.rpy:132
translate german c27s001_DebDate_c9ea9070:

    # deb "¿Y tú? ¿En qué países has estado?"
    deb "Und du? In welchen Ländern warst du schon?"

# game/scripts/c27/c27.rpy:133
translate german c27s001_DebDate_2998f279:

    # mc "De toda tu lista, sólo en Canadá. Fui a un concierto en Vancouver cuando estaba en Portland, el primer año."
    mc "Von allem auf deiner Liste gibt es nur Kanada. Ich war in meinem ersten Jahr in Portland auf einem Konzert in Vancouver."

# game/scripts/c27/c27.rpy:134
translate german c27s001_DebDate_1eb823d3:

    # deb "¿Y sitios que no estén en mi lista?"
    deb "Und was ist mit Orten, die nicht auf meiner Liste stehen?"

# game/scripts/c27/c27.rpy:135
translate german c27s001_DebDate_dbbd4c94:

    # mc "*Risa* Ninguno. No hemos viajado mucho, ni dentro ni fuera de Estados Unidos."
    mc "*Lacht* Keine. Wir sind weder innerhalb noch außerhalb der Vereinigten Staaten viel gereist."

# game/scripts/c27/c27.rpy:136
translate german c27s001_DebDate_64d51d8f:

    # mc "Pero estaré en Aruba, que no está en tu lista. *Risa*"
    mc "Aber ich werde auf Aruba sein, das steht ja nicht auf deiner Liste. *lacht*"

# game/scripts/c27/c27.rpy:138
translate german c27s001_DebDate_2553ffcc:

    # deb "Bueno, el status de Aruba como país es diferente a lo que estamos acostumbrados los americanos."
    deb "Nun ja, der Status von Aruba als Land unterscheidet sich von dem, was wir Amerikaner gewohnt sind."

# game/scripts/c27/c27.rpy:139
translate german c27s001_DebDate_cd1fe8ab:

    # deb "Casi sería como hablar de un estado de los Países Bajos. Como si habláramos de Virginia respecto a Estados Unidos."
    deb "Das wäre fast so, als würde man über einen Bundesstaat der Niederlande sprechen. Oder als würde man Virginia im Verhältnis zu den Vereinigten Staaten vergleichen."

# game/scripts/c27/c27.rpy:140
translate german c27s001_DebDate_7b3ff11f:

    # mc "Siempre he pensado que era un país independiente."
    mc "Ich dachte immer, es sei ein unabhängiges Land."

# game/scripts/c27/c27.rpy:142
translate german c27s001_DebDate_c9eceb4a:

    # deb "Yo también. Nunca había leído nada sobre él hasta que decidiste irte allí."
    deb "Ich auch. Ich hatte nie etwas darüber gelesen, bis du dich entschieden hast, dorthin zu fahren."

# game/scripts/c27/c27.rpy:143
translate german c27s001_DebDate_e8dc22b4:

    # deb "Conozco gente que ha ido a hacer turismo, pero no sabía nada del país."
    deb "Ich kenne Leute, die als Touristen dort waren, aber ich wusste überhaupt nichts über das Land."

# game/scripts/c27/c27.rpy:144
translate german c27s001_DebDate_af3ebf53:

    # mc "Es conmovedor que te preocupes así por mí."
    mc "Es ist rührend, dass du dich so um mich sorgst."

# game/scripts/c27/c27.rpy:146
translate german c27s001_DebDate_7f378831:

    # deb "*Risa* Tenía que comprobar si iban a secuestrar a mi novio o algo así."
    deb "*lacht* Ich musste erst mal nachsehen, ob sie etwa meinen Freund entführen wollten oder so."

# game/scripts/c27/c27.rpy:147
translate german c27s001_DebDate_acd21027:

    # mc "Creo que el riesgo de secuestro es más alto por parte de la empresa que del país."
    mc "Ich glaube, das Risiko einer Entführung ist für das Unternehmen höher als für das Land."

# game/scripts/c27/c27.rpy:148
translate german c27s001_DebDate_43673dbb:

    # mc "*Risa* Y que me protejan de un posible secuestro también."
    mc "*Lacht* Und dass sie mich auch vor einer möglichen Entführung schützen."

# game/scripts/c27/c27.rpy:149
translate german c27s001_DebDate_a7f8dac3:

    # deb "*Risa* Tienes razón. Yo no intentaría secuestrarte con [ama] o [eva] cerca. *Susurrando* Y un ejército de clones."
    deb "*Lacht* Stimmt. Ich würde dich nicht entführen, wenn [ama] oder [eva] in der Nähe wären. *Flüstert* Und eine ganze Klonarmee."

# game/scripts/c27/c27.rpy:151
translate german c27s001_DebDate_69705291:

    # deb "Por suerte hoy no están en casa..."
    deb "Zum Glück sind sie heute nicht zu Hause..."

# game/scripts/c27/c27.rpy:152
translate german c27s001_DebDate_c5aaca27:

    # mc "Te noto muy traviesa hoy. *Risa* No me lo esperaba."
    mc "Du scheinst heute aber ganz schön schelmisch zu sein. *lacht* Das hatte ich nicht erwartet."

# game/scripts/c27/c27.rpy:154
translate german c27s001_DebDate_91aa1172:

    # deb "Empecé a hacer bromas con [lis] anoche para ocultar lo insegura que me sentía."
    deb "Ich habe gestern Abend angefangen, Witze mit [lis] zu machen, um zu verbergen, wie unsicher ich mich fühlte."

# game/scripts/c27/c27.rpy:155
translate german c27s001_DebDate_e927e82f:

    # deb "¿Sabes lo de fingir una sonrisa hasta que sea real? Pues con las bromas sobre sexo funcionó. Tras varias bromas, dejé de preocuparme."
    deb "Kennst du das mit dem Lächeln, das man so lange vortäuscht, bis es echt ist? Nun, bei Sexwitzen hat es funktioniert. Nach ein paar Witzen habe ich mir keine Sorgen mehr gemacht."

# game/scripts/c27/c27.rpy:156
translate german c27s001_DebDate_073c9c8e:

    # deb "Empecé a verlo como la continuación de lo que hicimos en el lago. Se que es un paso más, y un paso muy importante, pero..."
    deb "Ich begann, es als Fortsetzung dessen zu sehen, was wir am See gemacht hatten. Ich weiß, es ist ein weiterer Schritt, und ein sehr wichtiger, aber..."

# game/scripts/c27/c27.rpy:157
translate german c27s001_DebDate_c1a5986e:

    # mc "Pero lo ves natural ahora, ¿no?"
    mc "Aber Sie sehen es jetzt als etwas Natürliches an, nicht wahr?"

# game/scripts/c27/c27.rpy:159
translate german c27s001_DebDate_1fc4c21d:

    # deb "Lo veo el paso más natural del mundo. No es que no hayamos hecho cosas tórridas ya, con lo que el siguiente paso parece menos grande."
    deb "Ich sehe es als den natürlichsten Schritt überhaupt. Nicht, dass wir nicht schon einige heiße Dinge getan hätten, daher erscheint der nächste Schritt weniger beängstigend."

# game/scripts/c27/c27.rpy:160
translate german c27s001_DebDate_8244b8f2:

    # deb "Y bromear anoche... y seguir bromeando contigo, hace que dé menos miedo."
    deb "Und dass wir gestern Abend herumgealbert haben... und dass wir weiterhin mit dir herumalbern, macht es weniger beängstigend."

# game/scripts/c27/c27.rpy:161
translate german c27s001_DebDate_0b3f517b:

    # mc "Si tienes miedo..."
    mc "Wenn du Angst hast..."

# game/scripts/c27/c27.rpy:163
translate german c27s001_DebDate_00f1240c:

    # deb "De lo único que tengo miedo es de hacerte daño. *Risa* ¡Mis músculos son de acero!"
    deb "Das Einzige, wovor ich Angst habe, ist, dich zu verletzen. *lacht* Meine Muskeln sind aus Stahl!"

# game/scripts/c27/c27.rpy:164
translate german c27s001_DebDate_29b7bf87:

    # mc "Preciosos músculos, por cierto."
    mc "Schöne Muskeln übrigens."

# game/scripts/c27/c27.rpy:166
translate german c27s001_DebDate_1aa8bd84:

    # deb "Pero no adelantemos acontecimientos y sigamos como si fuera una cita normal. ¿Cuál es tu libro favorito?"
    deb "Aber eins nach dem anderen, machen wir einfach weiter, als wäre es ein normales Date. Was ist dein Lieblingsbuch?"

# game/scripts/c27/c27.rpy:167
translate german c27s001_DebDate_db8e0778:

    # mc "¡Ufff! Esa es una pregunta complicada. Hay muchísimos libros que me gustan, pero si tuviera que elegir un favorito..."
    mc "Uff! Das ist eine schwierige Frage. Es gibt so viele Bücher, die ich mag, aber wenn ich mich für ein Lieblingsbuch entscheiden müsste …"

# game/scripts/c27/c27.rpy:168
translate german c27s001_DebDate_38165e76:

    # mc "Seguramente sería el tercero del Círculo del Tiempo. ¿Y el tuyo?"
    mc "Es wäre vermutlich das dritte im Kreis der Zeit. Und deins?"

# game/scripts/c27/c27.rpy:170
translate german c27s001_DebDate_f9ee2129:

    # deb "Yo lo tengo muy fácil. Orgullo y Prejuicio. Es el libro que me hizo amar los libros. Y por eso empecé a estudiar Literatura Inglesa."
    deb "Ich habe es sehr leicht. Stolz und Vorurteil. Dieses Buch hat meine Liebe zu Büchern geweckt. Und deshalb habe ich angefangen, Anglistik zu studieren."

# game/scripts/c27/c27.rpy:171
translate german c27s001_DebDate_3e25f0ac:

    # deb "He leído libros mejores, pero Orgullo y Prejuicio siempre tendrá un lugar especial en mi cabeza."
    deb "Ich habe schon bessere Bücher gelesen, aber Stolz und Vorurteil wird immer einen besonderen Platz in meinem Herzen haben."

# game/scripts/c27/c27.rpy:172
translate german c27s001_DebDate_82b97cbd:

    # mc "Suena a una relación especial con un libro. Yo también tengo un libro así, pero en sentido opuesto."
    mc "Das klingt nach einer besonderen Beziehung zu einem Buch. Ich habe auch so ein Buch, aber im gegenteiligen Sinne."

# game/scripts/c27/c27.rpy:173
translate german c27s001_DebDate_7f2176e2:

    # mc "Estadística Avanzada (III) del último año de carrera. *Risa* Odié ese libro en cada una de sus páginas."
    mc "Fortgeschrittene Statistik (III) aus meinem letzten Studienjahr. *lacht* Ich habe dieses Buch auf jeder einzelnen Seite gehasst."

# game/scripts/c27/c27.rpy:175
translate german c27s001_DebDate_2ac0b655:

    # deb "*Risa* Puedo entenderlo. Hay libros académicos que parecen ser escritos para que odies cada momento que pasas estudiando esa asignatura."
    deb "*Lacht* Das kann ich verstehen. Es gibt Fachbücher, die scheinbar darauf ausgelegt sind, einem jede Minute, die man mit dem Studium des jeweiligen Themas verbringt, zu verleiden."

# game/scripts/c27/c27.rpy:176
translate german c27s001_DebDate_ec400438:

    # mc "Sí, hay profesores que deberían tener prohibido escribir libros."
    mc "Ja, es gibt Lehrer, denen das Schreiben von Büchern verboten werden sollte."

# game/scripts/c27/c27.rpy:177
translate german c27s001_DebDate_76358196:

    # mc "Pero hablando de estudios, ¿por qué elegiste Newport?"
    mc "Aber wo wir gerade von einem Studium sprechen, warum haben Sie sich für Newport entschieden?"

# game/scripts/c27/c27.rpy:179
translate german c27s001_DebDate_9cc8bb8e:

    # deb "Después de meses de chatear con Anthony, [lis] quería venir un fin de semana a conocerlo."
    deb "Nach monatelangen Gesprächen mit Anthony wollte [lis] ihn für ein Wochenende besuchen."

# game/scripts/c27/c27.rpy:180
translate german c27s001_DebDate_7acc7880:

    # deb "Cuando le dije que quería irme de Phoenix, empezó a planearlo todo para hacer el traslado aquí."
    deb "Als ich ihm sagte, dass ich Phoenix verlassen wolle, begann er, alles für den Umzug hierher zu planen."

# game/scripts/c27/c27.rpy:181
translate german c27s001_DebDate_ce183507:

    # deb "Tienen un buen programa de Literatura Inglesa y un entrenador conocido de natación, con lo que me pareció bien."
    deb "Sie haben ein gutes Englisch-Literaturprogramm und einen bekannten Schwimmtrainer, was mir gut gefiel."

# game/scripts/c27/c27.rpy:182
translate german c27s001_DebDate_3a584d81:

    # mc "¿Cambiasteis de universidad por Anthony?"
    mc "Hast du wegen Anthony die Universität gewechselt?"

# game/scripts/c27/c27.rpy:184
translate german c27s001_DebDate_18f5ef8b:

    # deb "No, Anthony fue lo que hizo que [lis] se interesara por la NWU. Es una universidad pequeña que ni siquiera conocíamos."
    deb "Nein, Anthony war es, der [lis] für die NWU begeistert hat. Es ist eine kleine Universität, von deren Existenz wir vorher gar nichts wussten."

# game/scripts/c27/c27.rpy:185
translate german c27s001_DebDate_e2c60607:

    # deb "Si no hubiera sido por él, habríamos acabado en alguna otra universidad. [lis] quería que estuviera en la costa."
    deb "Ohne ihn wären wir an einer anderen Universität gelandet. Er wollte, dass ich an der Küste studiere."

# game/scripts/c27/c27.rpy:186
translate german c27s001_DebDate_5f59394e:

    # deb "De todas formas, sólo nos matriculamos para el curso de verano, con lo que era una decisión poco arriesgada para probar."
    deb "Wir hatten uns ja nur für den Sommerkurs angemeldet, daher war es eine risikoarme Entscheidung, es einfach mal zu versuchen."

# game/scripts/c27/c27.rpy:187
translate german c27s001_DebDate_0e5eaaf0:

    # mc "¿Sólo el curso de verano? Creía que os quedabais en septiembre también."
    mc "Nur der Sommerkurs? Ich dachte, Sie würden auch im September bleiben."

# game/scripts/c27/c27.rpy:189
translate german c27s001_DebDate_2691dc9a:

    # deb "Nos quedamos. Pero queríamos probar la universidad antes de decidir."
    deb "Wir sind geblieben. Aber wir wollten erst einmal das Studium ausprobieren, bevor wir uns endgültig entscheiden."

# game/scripts/c27/c27.rpy:190
translate german c27s001_DebDate_eda4a3fc:

    # deb "La universidad nos ha convencido lo suficiente. Y de todas formas yo no querría irme. Al menos no para volver a Phoenix."
    deb "Die Universität hat uns überzeugt. Und außerdem möchte ich gar nicht weg. Zumindest nicht zurück nach Phoenix."

# game/scripts/c27/c27.rpy:191
translate german c27s001_DebDate_51bef97d:

    # mc "Si quería costa, ¿cómo acabasteis en Phoenix en primer lugar?"
    mc "Wenn du an die Küste wolltest, wie bist du dann überhaupt in Phoenix gelandet?"

# game/scripts/c27/c27.rpy:193
translate german c27s001_DebDate_cef27452:

    # deb "Ella quería una universidad lejos de casa, para poder vivir su vida lejos donde nadie la conociera y lejos de la influencia de mi padre."
    deb "Sie wollte an eine Universität weit weg von zu Hause, damit sie ihr Leben fernab von zu Hause verbringen konnte, wo sie niemand kannte und fernab vom Einfluss meines Vaters."

# game/scripts/c27/c27.rpy:194
translate german c27s001_DebDate_284c3d14:

    # deb "Cuando me tocó elegir universidad a mí, fui con ella."
    deb "Als ich an der Reihe war, mir eine Universität auszusuchen, bin ich mit ihr gegangen."

# game/scripts/c27/c27.rpy:195
translate german c27s001_DebDate_ff408941:

    # mc "Y después de un año, decidiste que querías irte de allí. ¿El clima?"
    mc "Und nach einem Jahr beschlossen Sie, wegzugehen. Das Wetter?"

# game/scripts/c27/c27.rpy:197
translate german c27s001_DebDate_4f5affb8:

    # deb "No, un asistente de entrenador... demasiado cariñoso. Yo me sentía muy incómoda con él."
    deb "Nein, ein Assistenztrainer... zu zärtlich. Ich fühlte mich in seiner Nähe sehr unwohl."

# game/scripts/c27/c27.rpy:198
translate german c27s001_DebDate_4a05a759:

    # deb "[lis] quería que lo denunciara, pero no tenía ninguna prueba, con lo que irme era lo mejor."
    deb "[lis] wollte, dass ich es melde, aber ich hatte keinen Beweis, also war Weggehen das Beste, was ich tun konnte."

# game/scripts/c27/c27.rpy:199
translate german c27s001_DebDate_bc5966e7:

    # mc "Cuando dices cariñoso..."
    mc "Wenn man liebevoll sagt..."

# game/scripts/c27/c27.rpy:201
translate german c27s001_DebDate_deabdb51:

    # deb "Una mano que se escapa y toca donde no debe a la hora de corregir una postura. Abrazos que duran demasiado para celebrar victorias..."
    deb "Eine Hand, die beim Korrigieren der Haltung unachtsam umherwandert und Dinge berührt, die sie nicht berühren sollte. Umarmungen, die zu lange dauern, um Siege zu feiern..."

# game/scripts/c27/c27.rpy:202
translate german c27s001_DebDate_2bc39e06:

    # deb "Cosas así. Cosas que, visto desde fuera, pueden parecer que no son nada, pero cuando las vas sumando... te hacen sentir incómoda."
    deb "Solche Dinge. Dinge, die von außen betrachtet unbedeutend erscheinen mögen, aber wenn man sie zusammenzählt... dann fühlen sie sich unangenehm an."

# game/scripts/c27/c27.rpy:203
translate german c27s001_DebDate_d19a604f:

    # mc "Es normal. ¿Cómo empezó? ¿Lo hacía con otras chicas también?"
    mc "Das ist normal. Wie hat es angefangen? Hat er das auch mit anderen Mädchen gemacht?"

# game/scripts/c27/c27.rpy:205
translate german c27s001_DebDate_e46d8acf:

    # deb "Cuando llegué, era muy simpático y me hizo sentir integrada en el equipo. Fue el primero que empezó a llamarme 'Deb'."
    deb "Als ich ankam, war er sehr freundlich und gab mir das Gefühl, zum Team zu gehören. Er war der Erste, der mich „Deb“ nannte."

# game/scripts/c27/c27.rpy:207
translate german c27s001_DebDate_ea46801a:

    # deb "Por eso me molestó cuando me lo llamaste tú. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_ea46801a
    deb "Deshalb hat es mich gestört, als du mich so genannt hast. Nur meine Großmutter und [lis] nennen mich so, und wenn es jemand anderes tut, werde ich es mit diesem Trainer in Verbindung bringen." id c27s001_DebDate_ea46801a

# game/scripts/c27/c27.rpy:209
translate german c27s001_DebDate_a42fff8c:

    # deb "Por eso no me gusta que me llamen así. Sólo mi abuela y [lis] me llaman así y, si alguien aparte de ellas lo hace, lo voy a asociar con ese entrenador." id c27s001_DebDate_a42fff8c
    deb "Deshalb mag ich es nicht, so genannt zu werden. Nur meine Großmutter und [lis] nennen mich so, und wenn es jemand anderes tut, werde ich es mit diesem Trainer in Verbindung bringen." id c27s001_DebDate_a42fff8c

# game/scripts/c27/c27.rpy:211
translate german c27s001_DebDate_554cc2f4:

    # deb "Poco a poco la cosa se fue poniendo más incómoda, pero como veía que con algunas de las otras chicas hacía lo mismo, pensé que era normal."
    deb "Nach und nach wurde die Situation immer unangenehmer, aber da ich sah, dass er das Gleiche auch mit einigen anderen Mädchen tat, dachte ich, es sei normal."

# game/scripts/c27/c27.rpy:212
translate german c27s001_DebDate_7148f2b7:

    # deb "A ellas no parecía importarles. Era guapo y ellas se lo consentían. Pero a mí me molestaba. Intenté hablarlo con él, pero negó estar haciendo nada incorrecto."
    deb "Es schien ihnen egal zu sein. Er war gutaussehend, und sie ließen ihn damit durchkommen. Aber mich störte es. Ich versuchte, mit ihm darüber zu reden, aber er stritt alles ab."

# game/scripts/c27/c27.rpy:213
translate german c27s001_DebDate_3dbcc7d5:

    # mc "Y decidiste irte. Si puedo hacer algo..."
    mc "Und du hast dich entschieden zu gehen. Falls ich irgendetwas für dich tun kann..."

# game/scripts/c27/c27.rpy:215
translate german c27s001_DebDate_7e4b3d06:

    # deb "Gracias, pero no. Yéndome ha quedado resuelto."
    deb "Danke, aber nein. Das Verlassen des Servers hat das Problem gelöst."

# game/scripts/c27/c27.rpy:216
translate german c27s001_DebDate_b9d7f0f7:

    # deb "Mis tiempos se resintieron. No iba a gusto a entrenar y se notaba. En dos años hay Juegos Olímpicos en París y me gustaría estar ahí."
    deb "Meine Zeiten litten. Ich hatte keinen Spaß mehr am Training, und das merkte man. Die Olympischen Spiele finden in zwei Jahren in Paris statt, und ich würde gerne dabei sein."

# game/scripts/c27/c27.rpy:217
translate german c27s001_DebDate_2faf6ea9:

    # deb "Al menos intentarlo. Si seguía en Phoenix no iba a poder hacerlo. Con lo que el cambio es bienvenido."
    deb "Ich habe es wenigstens versucht. Wäre ich in Phoenix geblieben, hätte ich das nicht gekonnt. Daher ist die Veränderung willkommen."

# game/scripts/c27/c27.rpy:218
translate german c27s001_DebDate_07b6ae05:

    # mc "¿Juegos Olímpicos? Entonces [sim] tenía razón. ¡Eres buenísima!"
    mc "Die Olympischen Spiele? Dann hatte [sim] recht. Du bist fantastisch!"

# game/scripts/c27/c27.rpy:220
translate german c27s001_DebDate_59776c96:

    # deb "Ahora mismo no me clasificaría, pero si trabajo duro... Tengo una posibilidad. Quedan casi dos años para los Trials y sólo necesitaría unos meses para ponerme en forma."
    deb "Im Moment würde ich mich noch nicht qualifizieren, aber wenn ich hart trainiere, habe ich eine Chance. Bis zu den Trials sind es noch fast zwei Jahre, und ich bräuchte nur ein paar Monate, um in Form zu kommen."

# game/scripts/c27/c27.rpy:221
translate german c27s001_DebDate_0cf8fd2b:

    # deb "Si Dara Vollmer y Dana Torres pudieron ganar medallas en las olimpiadas después de dar a luz... "
    deb "Wenn Dara Vollmer und Dana Torres nach der Geburt ihrer Kinder Medaillen bei den Olympischen Spielen gewinnen konnten..."

# game/scripts/c27/c27.rpy:222
translate german c27s001_DebDate_36a2a20e:

    # mc "No sé quiénes son. Supongo que nadadoras que han tenido hijos."
    mc "Ich weiß nicht, wer sie sind. Ich nehme an, es sind Schwimmerinnen, die Kinder bekommen haben."

# game/scripts/c27/c27.rpy:224
translate german c27s001_DebDate_921c2fc2:

    # deb "Sí, las dos compitieron después de sus embarazos y las dos ganaron medallas en las olimpiadas. En Pekín y en Rio."
    deb "Ja, beide nahmen nach ihrer Schwangerschaft an Wettkämpfen teil und gewannen olympische Medaillen. In Peking und in Rio."

# game/scripts/c27/c27.rpy:225
translate german c27s001_DebDate_6345e182:

    # deb "Pero claro, ellas eran mejores de lo que yo soy ahora antes de quedarse embarazadas..."
    deb "Aber natürlich ging es ihnen besser als mir jetzt, bevor sie schwanger wurden..."

# game/scripts/c27/c27.rpy:226
translate german c27s001_DebDate_a6de434a:

    # mc "Te iba a preguntar si querías tener hijos, pero viendo que has investigado..."
    mc "Ich wollte dich eigentlich fragen, ob du Kinder haben möchtest, aber da du dich ja bereits informiert hast..."

# game/scripts/c27/c27.rpy:231
translate german c27s001_DebDate_80342353:

    # deb "Todas las que se han hecho la prueba han salido positivas. Eso significa que quieres tener muchos hijos."
    deb "Alle Getesteten waren positiv. Das bedeutet, dass Sie viele Kinder haben möchten."

# game/scripts/c27/c27.rpy:232
translate german c27s001_DebDate_b32708d1:

    # deb "No me gustaría ser la única con la que no los tienes."
    deb "Ich möchte nicht die Einzige sein, mit der du sie nicht hast."

# game/scripts/c27/c27.rpy:234
translate german c27s001_DebDate_87cec64c:

    # deb "Sabiendo que quieres tener hijos, me gustaría que los tuviéramos."
    deb "Da ich weiß, dass du Kinder haben möchtest, wünsche ich mir, dass wir welche bekommen."

# game/scripts/c27/c27.rpy:236
translate german c27s001_DebDate_0ccba3b9:

    # deb "No sé si quieres tener hijos o no, pero a mí no me importaría."
    deb "Ich weiß nicht, ob du Kinder haben möchtest oder nicht, aber ich hätte nichts dagegen."

# game/scripts/c27/c27.rpy:237
translate german c27s001_DebDate_5e145226:

    # deb "Dentro de un año me afectaría más para mi carrera de nadadora. Si los quieres tener, ahora o justo después de unas olimpiadas serían los mejores momentos."
    deb "In einem Jahr würde es meine Schwimmkarriere stärker beeinflussen. Wenn du sie haben willst, wäre jetzt oder direkt nach den Olympischen Spielen der beste Zeitpunkt."

# game/scripts/c27/c27.rpy:238
translate german c27s001_DebDate_da88ba8b:

    # mc "No había pensado en cómo te podría afectar en tu carrera. Me gusta que lo hayas hecho tú por los dos."
    mc "Ich hatte gar nicht darüber nachgedacht, wie sich das auf deine Karriere auswirken könnte. Ich bin froh, dass du es für uns beide getan hast."

# game/scripts/c27/c27.rpy:240
translate german c27s001_DebDate_7b849e5f:

    # deb "Sé que quizás suene muy frío dicho así, pero uno de mis sueños es participar en unas olimpiadas. Y no quiero renunciar a él."
    deb "Ich weiß, es klingt vielleicht herzlos, wenn ich es so formuliere, aber einer meiner Träume ist die Teilnahme an den Olympischen Spielen. Und ich möchte ihn nicht aufgeben."

# game/scripts/c27/c27.rpy:241
translate german c27s001_DebDate_2c0460ba:

    # mc "No te preocupes. No me ha sonado frío. Son cosas en las que, los que sólo hacemos deporte en los videojuegos, no solemos pensar."
    mc "Keine Sorge. Mir kam es nicht kalt vor. Das sind Dinge, über die wir, die wir Sport nur in Videospielen spielen, normalerweise nicht nachdenken."

# game/scripts/c27/c27.rpy:242
translate german c27s001_DebDate_5543d3d8:

    # mc "Y, teniendo todo el tiempo del mundo para tener hijos, no tienes por qué renunciar a tus sueños."
    mc "Und da Sie alle Zeit der Welt haben, Kinder zu bekommen, müssen Sie Ihre Träume nicht aufgeben."

# game/scripts/c27/c27.rpy:243
translate german c27s001_DebDate_0d4449b2:

    # mc "Lo que me extraña es tu elección de estudios. ¿Literatura Inglesa en vez de algo relacionado con el deporte?"
    mc "Was mich überrascht, ist deine Studienwahl. Anglistik statt etwas Sportbezogenes?"

# game/scripts/c27/c27.rpy:245
translate german c27s001_DebDate_670ba289:

    # deb "Mi segunda opción era Ciencias del Deporte, pero no estaba segura de si querría dedicarme a entrenar a otras nadadoras cuando dejase de nadar."
    deb "Meine zweite Wahl wäre Sportwissenschaft gewesen, aber ich war mir nicht sicher, ob ich mich nach dem Ende meiner Schwimmkarriere dem Training anderer Schwimmer widmen wollen würde."

# game/scripts/c27/c27.rpy:246
translate german c27s001_DebDate_94666eeb:

    # deb "Sería una forma de seguir ligada al mundo de la natación, pero aún no estoy segura de querer hacerlo."
    deb "Es wäre eine Möglichkeit, mit der Welt des Schwimmens in Verbindung zu bleiben, aber ich bin mir immer noch nicht sicher, ob ich das wirklich will."

# game/scripts/c27/c27.rpy:247
translate german c27s001_DebDate_5fde71bc:

    # mc "¿Prefieres ser una profesora de literatura en un instituto?"
    mc "Würden Sie lieber als Literaturlehrer an einer High School arbeiten?"

# game/scripts/c27/c27.rpy:249
translate german c27s001_DebDate_7f8f4c84:

    # deb "*Risa* Dudo que alguna vez pueda ser profesora de instituto. Los alumnos me tomarían el pelo. Hay que ser más dura de lo que soy yo para manejar un grupo de 20 adolescentes."
    deb "*lacht* Ich bezweifle, dass ich jemals Gymnasiallehrer werden könnte. Die Schüler würden sich über mich lustig machen. Man muss schon viel härter im Nehmen sein als ich, um eine Gruppe von 20 Teenagern zu führen."

# game/scripts/c27/c27.rpy:250
translate german c27s001_DebDate_b197bbe0:

    # deb "Elegí la carrera porque me encanta la literatura, no para ejercer. Ya sabes..."
    deb "Ich habe diesen Studiengang gewählt, weil ich Literatur liebe, nicht um in diesem Bereich zu arbeiten. Verstehst du?"

# game/scripts/c27/c27.rpy:251
translate german c27s001_DebDate_6862479b:

    # mc "Sí, dinero viejo y falta de necesidad de trabajar."
    mc "Ja, altes Geld und keine Notwendigkeit zu arbeiten."

# game/scripts/c27/c27.rpy:253
translate german c27s001_DebDate_2575181e:

    # deb "Mas o menos. No somos dinero MUY viejo, pero lo suficiente. A principios del siglo pasado mi tatarabuelo era un pequeño granjero en Aurora."
    deb "So ungefähr. Wir sind zwar nicht sehr reich, aber alt genug. Anfang des letzten Jahrhunderts war mein Ururgroßvater ein Kleinbauer in Aurora."

# game/scripts/c27/c27.rpy:254
translate german c27s001_DebDate_06f581e8:

    # mc "De granjero a familia rica..."
    mc "Vom Bauern zur reichen Familie..."

# game/scripts/c27/c27.rpy:256
translate german c27s001_DebDate_989e8c07:

    # deb "En la Gran Depresión y durante el Dust Bowl compró un montón de tierras a bajo precio en Illinois y Missouri. También algunas minas de plomo."
    deb "Während der Großen Depression und der Staubstürme kaufte er in Illinois und Missouri viel Land zu niedrigen Preisen. Er kaufte auch einige Bleiminen."

# game/scripts/c27/c27.rpy:257
translate german c27s001_DebDate_3a0c2978:

    # deb "Él y mi bisabuelo diversificaron la fortuna durante la Segunda Guerra Mundial. Industria, investigación, contratos con el ejército..."
    deb "Er und mein Urgroßvater diversifizierten ihr Vermögen während des Zweiten Weltkriegs. Industrie, Forschung, Verträge mit dem Militär..."

# game/scripts/c27/c27.rpy:258
translate german c27s001_DebDate_98584c64:

    # deb "Nunca he sabido la lista completa de empresas en las que tenemos participación. Ni me interesa."
    deb "Ich kenne nie die vollständige Liste der Unternehmen, an denen wir beteiligt sind. Und ich bin auch nicht daran interessiert."

# game/scripts/c27/c27.rpy:259
translate german c27s001_DebDate_049fbf8d:

    # mc "Supongo que tiene que ser complicado."
    mc "Ich nehme an, es muss kompliziert sein."

# game/scripts/c27/c27.rpy:261
translate german c27s001_DebDate_8d14cd96:

    # deb "Complicado y aburrido. Nunca me ha interesado el dinero. Quizás porque nunca me ha faltado."
    deb "Kompliziert und langweilig. Geld hat mich nie interessiert. Vielleicht, weil ich nie welches hatte."

# game/scripts/c27/c27.rpy:262
translate german c27s001_DebDate_e38dd30a:

    # deb "A [lis], aunque tampoco le interese, siempre le ha gustado más todo lo que rodea el dinero. Alta sociedad, famosos, y todo eso."
    deb "A, obwohl er sich auch nicht dafür interessiert, hat schon immer alles gemocht, was mit Geld zu tun hat. Die High Society, Prominente und all das."

# game/scripts/c27/c27.rpy:263
translate german c27s001_DebDate_f43cd1ef:

    # deb "Pero a mí no. El dinero tiene que servir para cubrir las necesidades propias y de la familia."
    deb "Aber nicht für mich. Geld muss dazu verwendet werden, den eigenen Bedarf und den der Familie zu decken."

# game/scripts/c27/c27.rpy:264
translate german c27s001_DebDate_a94459db:

    # mc "Es normal. En el fondo es para lo único que sirve. Una vez cubiertas las necesidades, el resto son caprichos."
    mc "Das ist normal. Im Grunde ist es auch nur dafür gut. Sobald deine Bedürfnisse befriedigt sind, ist alles andere nur noch eine Laune."

# game/scripts/c27/c27.rpy:266
translate german c27s001_DebDate_de64881b:

    # deb "Por suerte, mis caprichos son relativamente baratos. *Risa* Libros, videojuegos, música..."
    deb "Zum Glück sind meine kleinen Genüsse relativ günstig. *lacht* Bücher, Videospiele, Musik..."

# game/scripts/c27/c27.rpy:267
translate german c27s001_DebDate_f92bf164:

    # mc "Hemos hablado de libros y videojuegos, pero nunca de música. ¿Qué música te gusta?"
    mc "Wir haben über Bücher und Videospiele gesprochen, aber noch nie über Musik. Welche Musik hörst du gern?"

# game/scripts/c27/c27.rpy:268
translate german c27s001_DebDate_02794b27:

    # deb "Tengo gustos muy variados y que [lis] dice que no pegan demasiado. Pop, Folk, Blues, Metal, Rock, Clásica..."
    deb "Ich habe einen sehr vielfältigen Musikgeschmack, und [lis] meint, die passen eigentlich nicht zusammen. Pop, Folk, Blues, Metal, Rock, Klassik..."

# game/scripts/c27/c27.rpy:269
translate german c27s001_DebDate_b12523bf:

    # mc "*Risa* Es cierto que no pegan demasiado."
    mc "*Gelächter* Es stimmt, dass sie nicht wirklich zusammenpassen."

# game/scripts/c27/c27.rpy:271
translate german c27s001_DebDate_549d5b2a:

    # deb "*Risa* Imagíname con una peluca barroca haciendo así. ¡Yeahhh!"
    deb "*lacht* Stellt euch vor, ich trage eine Barockperücke und mache das. Jaaaa!"

# game/scripts/c27/c27.rpy:272
translate german c27s001_DebDate_34fc4868:

    # mc "*Risa* Puedo hacerlo. Además, oliendo a pachuli, con un bolso de diseño y con una chaqueta de cuero."
    mc "*Lacht* Das kann ich. Außerdem, wenn ich nach Patschuli dufte, eine Designerhandtasche und eine Lederjacke trage."

# game/scripts/c27/c27.rpy:274
translate german c27s001_DebDate_b01b50cd:

    # deb "¡Ni siquiera yo iría así! *Risa* ¡[lis] no me dejaría salir de mi habitación! Bueno, de nuestra habitación."
    deb "Selbst ich würde so etwas nicht machen! *lacht* [lis] Er hat mich nicht aus meinem Zimmer gelassen! Na ja, aus unserem Zimmer."

# game/scripts/c27/c27.rpy:275
translate german c27s001_DebDate_d4dec132:

    # deb "Pero sea la música que sea, me gusta escucharla, no bailarla."
    deb "Aber egal, welche Musik es ist, ich höre sie mir lieber an, als dazu zu tanzen."

# game/scripts/c27/c27.rpy:276
translate german c27s001_DebDate_9ccbcedc:

    # mc "Bueno, en el Jazz Corner bailamos."
    mc "Wir haben im Jazz Corner getanzt."

# game/scripts/c27/c27.rpy:278
translate german c27s001_DebDate_c56d3f1b:

    # deb "No bailamos. Me hiciste volar."
    deb "Wir haben nicht getanzt. Du hast mir das Gefühl gegeben, zu fliegen."

# game/scripts/c27/c27.rpy:279
translate german c27s001_DebDate_6f9af9ef:

    # mc "La próxima vez te dejaré poner los pies en el suelo."
    mc "Nächstes Mal lasse ich dich wieder festen Boden unter den Füßen haben."

# game/scripts/c27/c27.rpy:280
translate german c27s001_DebDate_4c81d3ec:

    # deb "¿A riesgo de que te pise?"
    deb "Auf die Gefahr hin, zertreten zu werden?"

# game/scripts/c27/c27.rpy:281
translate german c27s001_DebDate_d65ffcb1:

    # mc "Aceptaré ese riesgo. Aunque dudo que lo hagas. Deberías tener más seguridad en ti misma."
    mc "Ich gehe das Risiko ein. Obwohl ich bezweifle, dass du es tun wirst. Du solltest mehr Selbstvertrauen haben."

# game/scripts/c27/c27.rpy:282
translate german c27s001_DebDate_047876a6:

    # mc "No eres [kim] y no vas a tropezarte con tus propios pies. Y ni siquiera ella me pisó."
    mc "Du bist nicht [kim] und du wirst nicht über deine eigenen Füße stolpern. Und sie ist mir nicht einmal auf den Fuß getreten."

# game/scripts/c27/c27.rpy:284
translate german c27s001_DebDate_0359da27:

    # deb "¡No te metas con [kim]! Yo sería incapaz de andar por una pasarela como lo hace ella."
    deb "Leg dich nicht mit [kim] an! Ich könnte nicht so elegant über den Laufsteg laufen wie sie."

# game/scripts/c27/c27.rpy:285
translate german c27s001_DebDate_98cbb0ea:

    # mc "No me estoy metiendo con ella. *Risa* Tan solo estoy haciendo una constatación de hechos."
    mc "Ich mache mich nicht über sie lustig. *lacht* Ich stelle nur eine Tatsache fest."

# game/scripts/c27/c27.rpy:287
translate german c27s001_DebDate_be4b8545:

    # deb "*Risita* Se puede tropezar con su sombra, ¿verdad?"
    deb "*Kichern* Man kann ja über seinen eigenen Schatten stolpern, nicht wahr?"

# game/scripts/c27/c27.rpy:288
translate german c27s001_DebDate_f0a2a5b5:

    # mc "*Risa* Aún no la he visto hacerlo, pero estoy seguro de que sería capaz."
    mc "*lacht* Ich habe sie das zwar noch nicht machen sehen, aber ich bin mir sicher, dass sie es könnte."

# game/scripts/c27/c27.rpy:289
translate german c27s001_DebDate_d9213a52:

    # mc "Tan solo estoy diciendo que si alguien como ella puede reunir la confianza para subirse a una pasarela, tu deberías reunirla para bailar."
    mc "Ich will damit nur sagen: Wenn jemand wie sie das Selbstvertrauen hat, über den Laufsteg zu gehen, dann solltest du auch das Selbstvertrauen haben, zu tanzen."

# game/scripts/c27/c27.rpy:290
translate german c27s001_DebDate_8a7979ea:

    # mc "Creo que tienes más miedo a lo que pensarán los que te vean que a pisarme."
    mc "Ich glaube, du hast mehr Angst davor, was die Leute denken, als davor, auf mich zu treten."

# game/scripts/c27/c27.rpy:292
translate german c27s001_DebDate_78d7344c:

    # deb "Un poco... No tengo demasiado ritmo..."
    deb "Ein bisschen... Ich habe nicht viel Rhythmusgefühl..."

# game/scripts/c27/c27.rpy:293
translate german c27s001_DebDate_ddc9e81a:

    # mc "Pues aprovechando que te gustan los libros. Mark Twain dijo algo de lo que puedes aprender."
    mc "Da du Bücher magst, hat Mark Twain etwas gesagt, woraus du lernen kannst."

# game/scripts/c27/c27.rpy:294
translate german c27s001_DebDate_0e187ff3:

    # mc "Tienes que bailar como si nadie te estuviera mirando, amar como si nunca te fueran a hacer daño, cantar como si nadie te estuviera escuchando y... algo más."
    mc "Du musst tanzen, als ob dich niemand beobachtet, lieben, als ob du niemals verletzt werden könntest, singen, als ob dich niemand hört und... noch etwas anderes."

# game/scripts/c27/c27.rpy:296
translate german c27s001_DebDate_2780dfb9:

    # deb "...y vivir como si estuvieras en el cielo."
    deb "...und lebe, als wärst du im Himmel."

# game/scripts/c27/c27.rpy:297
translate german c27s001_DebDate_6b540cb0:

    # deb "Lo segundo ya lo hago. Sé que no me vas a hacer daño. Lo del cielo... no soy creyente."
    deb "Das Zweite tue ich schon. Ich weiß, dass du mir nicht wehtun wirst. Was den Himmel angeht … ich glaube nicht daran."

# game/scripts/c27/c27.rpy:298
translate german c27s001_DebDate_a833f795:

    # mc "Pues hay que trabajar en el resto. Un día iremos tú y yo solos a bailar. A un sitio donde nadie te conozca."
    mc "Nun, den Rest müssen wir noch klären. Eines Tages werden wir beide tanzen gehen, nur wir beide. Irgendwo, wo dich niemand kennt."

# game/scripts/c27/c27.rpy:299
translate german c27s001_DebDate_4f2b6878:

    # mc "Así, aunque te miren, dará lo mismo. ¿Qué te importa lo que piensen personas a las que no conoces?"
    mc "Selbst wenn sie dich anstarren, ist das egal. Was kümmert es dich, was Fremde denken?"

# game/scripts/c27/c27.rpy:300
translate german c27s001_DebDate_ffaf1105:

    # mc "Yo estaré mirándote a los ojos, con lo que no sabré si bailas bien o mal. Ni me importará."
    mc "Ich werde dir in die Augen schauen, deshalb werde ich nicht wissen, ob du gut oder schlecht tanzt. Und das wird mir auch egal sein."

# game/scripts/c27/c27.rpy:302
translate german c27s001_DebDate_128a2e45:

    # deb "¿Dónde has estado toda mi vida, [mc]?"
    deb "Wo warst du mein ganzes Leben lang, [mc]?"

# game/scripts/c27/c27.rpy:303
translate german c27s001_DebDate_08f4e540:

    # mc "Esperando que vinieras a Newport."
    mc "Wir hoffen, Sie kommen nach Newport."

# game/scripts/c27/c27.rpy:304
translate german c27s001_DebDate_65c76376:

    # mc "Y cuando resolvamos lo de bailar, lo siguiente será un karaoke."
    mc "Und wenn wir das Tanzen erst einmal im Griff haben, ist Karaoke das nächste Projekt."

# game/scripts/c27/c27.rpy:306
translate german c27s001_DebDate_7e1a98b6:

    # deb "¡No! *Risa* ¡Eso no, por favor!"
    deb "Nein! *lacht* Nicht das, bitte!"

# game/scripts/c27/c27.rpy:307
translate german c27s001_DebDate_16262c90:

    # deb "Una cosa es que no me veas bailar si estás mirándome a los ojos. Pero no vas a poder evitar escuchar lo mal que canto si vamos a un karaoke."
    deb "Es ist eine Sache, wenn du mich nicht tanzen siehst, während du mir in die Augen schaust. Aber du wirst nicht umhinkommen, zu hören, wie schrecklich ich singe, wenn wir Karaoke singen gehen."

# game/scripts/c27/c27.rpy:308
translate german c27s001_DebDate_b77a7ca3:

    # mc "¿Tan mal cantas?"
    mc "Singst du so schlecht?"

# game/scripts/c27/c27.rpy:309
translate german c27s001_DebDate_78e4296c:

    # deb "Digamos que, si canto en la ducha, el champú se suicida. *Risa* No quiero torturar a nadie."
    deb "Sagen wir mal so, wenn ich unter der Dusche singe, begeht das Shampoo Selbstmord. *lacht* Ich will ja niemanden quälen."

# game/scripts/c27/c27.rpy:310
translate german c27s001_DebDate_f0a4f26d:

    # mc "Entonces tendremos que hablar con [meg] para que te dé clases de canto."
    mc "Dann müssen wir mit [meg] sprechen, damit er dir Gesangsunterricht geben kann."

# game/scripts/c27/c27.rpy:312
translate german c27s001_DebDate_c011313a:

    # deb "¿Sabes de lo que me acabo de dar cuenta?"
    deb "Weißt du, was mir gerade klar geworden ist?"

# game/scripts/c27/c27.rpy:313
translate german c27s001_DebDate_1a6ca3d7:

    # mc "¿De qué?"
    mc "Worum geht es?"

# game/scripts/c27/c27.rpy:314
translate german c27s001_DebDate_238eeee4:

    # deb "Esto no se parece a la típica cita de las películas."
    deb "Das ist kein typisches Filmzitat."

# game/scripts/c27/c27.rpy:315
translate german c27s001_DebDate_7cf3844e:

    # mc "¿Decepcionada?"
    mc "Enttäuscht?"

# game/scripts/c27/c27.rpy:317
translate german c27s001_DebDate_4889e93c:

    # deb "Todo lo contrario. Es mucho mejor. Estamos hablando de un montón de cosas y no estoy nada nerviosa."
    deb "Ganz im Gegenteil. Es ist viel besser. Wir unterhalten uns über viele Dinge und ich bin überhaupt nicht nervös."

# game/scripts/c27/c27.rpy:318
translate german c27s001_DebDate_5e890471:

    # mc "¿Por qué ibas a estar nerviosa? Tan solo estamos comiendo y charlando. Conociéndonos mejor."
    mc "Warum solltest du nervös sein? Wir essen und unterhalten uns doch nur. Wir lernen uns besser kennen."

# game/scripts/c27/c27.rpy:319
translate german c27s001_DebDate_0e6ff9a9:

    # deb "Precisamente por eso. Todo es muy natural. Creía que iba a ser una situación tensa... ya sabes... por lo que vendrá después."
    deb "Genau deshalb. Es ist alles ganz natürlich. Ich dachte, es würde eine angespannte Situation werden... Sie wissen schon... wegen dem, was als Nächstes passiert."

# game/scripts/c27/c27.rpy:320
translate german c27s001_DebDate_d4207e8d:

    # mc "No he pensado ni por un momento en lo que vendrá después, [deb.nick]. Estoy disfrutando de cada minuto de esta comida contigo."
    mc "Ich habe noch keinen Moment darüber nachgedacht, was als Nächstes kommt. Ich genieße jede Minute dieses Essens mit dir."

# game/scripts/c27/c27.rpy:322
translate german c27s001_DebDate_62daf288:

    # deb "Yo lo he pensado un par de veces, pero consigues que se me olvide. Es como estar comiendo... con un amigo..."
    deb "Ich habe schon ein paar Mal darüber nachgedacht, aber du lässt mich es vergessen. Es ist wie Essen... mit einem Freund..."

# game/scripts/c27/c27.rpy:323
translate german c27s001_DebDate_e89958f6:

    # mc "*Fingiendo sorpresa* ¿Ya no soy tu novio? *Risa*"
    mc "*Tut überrascht* Bin ich etwa nicht mehr dein Freund? *Lacht*"

# game/scripts/c27/c27.rpy:324
translate german c27s001_DebDate_acac9f02:

    # mc "Hablando en serio, en eso consiste una cita. Creo que fuimos amigos antes que pareja, y eso no se debe perder."
    mc "Ganz ehrlich, darum geht es doch bei einem Date. Ich glaube, wir waren Freunde, bevor wir ein Paar wurden, und das sollten wir nicht verlieren."

# game/scripts/c27/c27.rpy:325
translate german c27s001_DebDate_10fcd32c:

    # mc "No hay que estar hablando de amor y sentimientos todo el día, aunque suene poco romántico."
    mc "Man muss nicht den ganzen Tag über Liebe und Gefühle reden, auch wenn das unromantisch klingt."

# game/scripts/c27/c27.rpy:327
translate german c27s001_DebDate_65999903:

    # deb "Prefiero esto al romanticismo impostado. Para eso están los libros y los videojuegos."
    deb "Das ziehe ich gekünstelter Romantik vor. Dafür gibt es Bücher und Videospiele."

# game/scripts/c27/c27.rpy:328
translate german c27s001_DebDate_1bde9f70:

    # deb "Esto es más natural, más... auténtico. Pero no por ello menos sexy."
    deb "Das ist natürlicher, authentischer. Aber deshalb nicht weniger sexy."

# game/scripts/c27/c27.rpy:329
translate german c27s001_DebDate_8abd0f2e:

    # deb "En realidad has estado hablando de amor todo el rato, interesándote por mí, queriendo llevarme a bailar..."
    deb "Du hast die ganze Zeit von Liebe gesprochen, Interesse an mir gezeigt und wolltest mit mir tanzen gehen..."

# game/scripts/c27/c27.rpy:330
translate german c27s001_DebDate_8aba94ec:

    # deb "Si llevase bragas, las tendría mojadas después de todo lo que has dicho hoy."
    deb "Wenn ich Höschen tragen würde, wären sie nach allem, was du heute gesagt hast, nass."

# game/scripts/c27/c27.rpy:332
translate german c27s001_DebDate_c5a6879d:

    # mc "*Susurrando* ¿No llevas bragas? Antes has dicho que estabas en modo travieso. Ahora me lo creo del todo."
    mc "*Flüsternd* Trägst du keine Unterwäsche? Du hast doch vorhin gesagt, du wärst in Stimmung für etwas Unartiges. Jetzt glaube ich dir das voll und ganz."

# game/scripts/c27/c27.rpy:334
translate german c27s001_DebDate_ad38a363:

    # deb "Bueno, este vestido transparenta un poco dependiendo de cómo le dé la luz. [kim] y [lis] me han recomendado no llevarlas."
    deb "Nun ja, dieses Kleid ist je nach Lichteinfall etwas durchsichtig. [kim] und [lis] haben mir geraten, es nicht zu tragen."

# game/scripts/c27/c27.rpy:335
translate german c27s001_DebDate_391e4a3f:

    # deb "Además, han dicho que así habrá menos estorbos luego."
    deb "Außerdem sagten sie, dass dies später weniger Hindernisse schaffen werde."

# game/scripts/c27/c27.rpy:337
translate german c27s001_DebDate_3ccfc812:

    # deb "He estado de acuerdo con ellas. *Risita* Lo de no llevar sujetador ha sido idea mía."
    deb "Ich stimmte ihnen zu. *Kichern* Die Idee, keinen BH zu tragen, stammte von mir."

# game/scripts/c27/c27.rpy:338
translate german c27s001_DebDate_94f623d6:

    # mc "Es decir... ¿me estás diciendo que estás desnuda debajo de ese ligero vestido?"
    mc "Also... willst du mir damit sagen, dass du unter diesem leichten Kleid nackt bist?"

# game/scripts/c27/c27.rpy:339
translate german c27s001_DebDate_d913fd69:

    # mc "¿Sabes que ahora voy a ser yo el que no va a poder dejar de pensar en lo que pasará después?"
    mc "Weißt du, dass ich jetzt diejenige sein werde, die ständig darüber nachdenkt, was als Nächstes passieren wird?"

# game/scripts/c27/c27.rpy:341
translate german c27s001_DebDate_a5f63b9b:

    # deb "*Risa* Creo que ha sido un error decírtelo. Ahora no vamos a poder dejar de pensar ninguno de los dos en eso."
    deb "*lacht* Ich glaube, es war ein Fehler, es dir zu erzählen. Jetzt werden wir beide ständig daran denken müssen."

# game/scripts/c27/c27.rpy:342
translate german c27s001_DebDate_b4a350df:

    # mc "A menos que reconduzcamos la conversación."
    mc "Es sei denn, wir lenken das Gespräch in eine andere Richtung."

# game/scripts/c27/c27.rpy:344
translate german c27s001_DebDate_a2956840:

    # "[deb.nick] mira a todos lados para comprobar que nadie os está mirando."
    "[deb.nick] Schau dich um, um sicherzugehen, dass dich niemand beobachtet."

# game/scripts/c27/c27.rpy:346
translate german c27s001_DebDate_9702315b:

    # deb "¿Estás seguro de que quieres que reconduzcamos la conversación?"
    deb "Sind Sie sicher, dass wir das Gespräch in eine andere Richtung lenken sollen?"

# game/scripts/c27/c27.rpy:347
translate german c27s001_DebDate_dc44bf7c:

    # mc "¡Eso es injusto! *Risa* ¡Ahora voy a tener que pedir la cuenta y nos vamos a quedar sin postre!"
    mc "Das ist unfair! *lacht* Jetzt muss ich die Rechnung verlangen und wir verpassen den Nachtisch!"

# game/scripts/c27/c27.rpy:349
translate german c27s001_DebDate_c8dcb238:

    # deb "Nunca he sido de esas personas a las que les importa mucho el postre. Al menos hasta que empecé a probar los de [mar]."
    deb "Ich gehörte nie zu den Leuten, die sich groß für Desserts interessieren. Zumindest nicht, bis ich die im [mar] probiert habe."

# game/scripts/c27/c27.rpy:350
translate german c27s001_DebDate_38add229:

    # deb "Por muy buena que esté la comida aquí, creo que esa abuela italiana no está al mismo nivel que [mar]."
    deb "So gut das Essen hier auch ist, ich glaube nicht, dass die italienische Großmutter auf dem gleichen Niveau wie [mar] ist."

# game/scripts/c27/c27.rpy:352
translate german c27s001_DebDate_7a0e4b54:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que mi madre si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Lacht* Ich bezweifle, dass es viele Leute gibt, die in Sachen Desserts so gut sind wie meine Mutter. Nicht mal [sam] oder [nor], obwohl ich deren Desserts liebe."

# game/scripts/c27/c27.rpy:354
translate german c27s001_DebDate_e269bf6f:

    # mc "*Risa* Dudo que haya mucha gente al mismo nivel que [mar] si se trata de postres. Ni siquiera [sam] o [nor], pese a que me encantan sus postres."
    mc "*Lacht* Ich bezweifle, dass es viele Leute gibt, die in Sachen Desserts auf dem gleichen Niveau wie [mar] sind. Nicht einmal [sam] oder [nor], obwohl ich deren Desserts liebe."

# game/scripts/c27/c27.rpy:355
translate german c27s001_DebDate_6071fd30:

    # mc "¿Pido la cuenta, entonces?"
    mc "Soll ich dann nach dem Scheck fragen?"

# game/scripts/c27/c27.rpy:357
translate german c27s001_DebDate_b61664cf:

    # deb "Creía que ya la habrías pedido a estas alturas..."
    deb "Ich dachte, du hättest es inzwischen bestellt..."

# game/scripts/c27/c27.rpy:359
translate german c27s001_DebDate_d7e2a6ff:

    # "Pides la cuenta, que tardan lo que te parece una eternidad en traer."
    "Sie bitten um die Rechnung, deren Eintreffen Ihnen wie eine Ewigkeit vorkommt."

# game/scripts/c27/c27.rpy:360
translate german c27s001_DebDate_8c5b91a0:

    # "Por suerte, el camarero viene con el datáfono, ahorrándoos unos interminables segundos de espera por un segundo viaje."
