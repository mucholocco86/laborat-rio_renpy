# game/scripts/c27/c27.rpy:2959
translate german c27s004_KatBreakfast_13c0664e:

    # oma "Compartir cama con [sai] y [eil] es un poco complicado. *Risa* Creo que todas acabamos con pelo de las otras en la cara durante la noche."
    oma "Mit [sai] und [eil] in einem Bett zu schlafen, ist etwas kompliziert. *lacht* Ich glaube, wir haben nachts alle gegenseitig die Haare im Gesicht."

# game/scripts/c27/c27.rpy:2960
translate german c27s004_KatBreakfast_145009ff:

    # oma "Pero podría repetirlo en cualquier momento."
    oma "Aber er könnte es jederzeit wiederholen."

# game/scripts/c27/c27.rpy:2962
translate german c27s004_KatBreakfast_63008db6:

    # ama "Ha sido fantástico. Creo que yo también voy a repetir."
    ama "Es war fantastisch. Ich glaube, ich werde es auch wieder tun."

# game/scripts/c27/c27.rpy:2963
translate german c27s004_KatBreakfast_ac089c48:

    # ama "Antes de ir a dormir estuvimos en el comedor charlando con [kim], [deb.nick], y [lis]. [deb.nick] me prestó el pijama."
    ama "Vor dem Schlafengehen unterhielten wir uns im Esszimmer mit [kim], [deb.nick] und [lis]. [deb.nick] lieh mir ihren Pyjama."

# game/scripts/c27/c27.rpy:2965
translate german c27s004_KatBreakfast_84c43607:

    # mom "Les estaba diciendo que dejaran un par de pijamas aquí cada una. Así se pueden quedar sin planearlo y tendrán ropa aquí."
    mom "Ich habe ihnen gesagt, sie sollen jeweils einen Schlafanzug hier lassen. So können sie ohne Planung übernachten und haben dann Kleidung hier."

# game/scripts/c27/c27.rpy:2966
translate german c27s004_KatBreakfast_72802734:

    # mc "Me parece una muy buena idea. *Risa* Aunque ya sabéis que yo considero los pijamas un atuendo innecesario."
    mc "Ich finde das eine super Idee. *lacht* Obwohl du ja weißt, dass ich Pyjamas für überflüssig halte."

# game/scripts/c27/c27.rpy:2968
translate german c27s004_KatBreakfast_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c27/c27.rpy:2969
translate german c27s004_KatBreakfast_5b67a685:

    # mom "Creo que aún no hemos habilitado el interior de la casa como zona nudista. Ni creo que lo vayamos a hacer."
    mom "Ich glaube nicht, dass wir das Hausinnere bereits als FKK-Bereich ausgewiesen haben. Und ich glaube auch nicht, dass wir das tun werden."

# game/scripts/c27/c27.rpy:2970
translate german c27s004_KatBreakfast_c642d168:

    # oma "Es comprensible, [mar]. Quizás hubiera alguna chica que se sentiría incómoda."
    oma "Das ist verständlich, [mar]. Es gab vielleicht einige Mädchen, die sich unwohl gefühlt haben."

# game/scripts/c27/c27.rpy:2971
translate german c27s004_KatBreakfast_594dc14f:

    # eva "No entiendo por qué. Yo normalmente no uso."
    eva "Ich verstehe nicht, warum. Normalerweise benutze ich es nicht."

# game/scripts/c27/c27.rpy:2972
translate german c27s004_KatBreakfast_eb742a19:

    # ama "No a todas las mujeres les gusta que un hombre las vea desnudas. Imagínate a [kat] desnuda y cruzándose con [mc]."
    ama "Nicht alle Frauen mögen es, von einem Mann nackt gesehen zu werden. Stell dir vor, [kat] ist nackt und begegnet [mc]."

# game/scripts/c27/c27.rpy:2973
translate german c27s004_KatBreakfast_69fa338b:

    # emm "Además, ¿os imagináis la cara de [kat] cuando bajara a desayunar si estuviéramos todas desnudas? *Risa*"
    emm "Könnt ihr euch vorstellen, wie [kat] geguckt hätte, als sie zum Frühstück runterkam und wir alle nackt gewesen wären? *lacht*"

# game/scripts/c27/c27.rpy:2974
translate german c27s004_KatBreakfast_51131fb9:

    # mc "Por cierto, hablando de [kat]. ¿Sabéis si le pasa algo?"
    mc "Apropos [kat], wissen Sie, ob damit irgendetwas nicht stimmt?"

# game/scripts/c27/c27.rpy:2976
translate german c27s004_KatBreakfast_0ed1e7a0:

    # mom "No, ha bajado a desayunar, pero ha subido a buscar el móvil. Estará aquí en un minuto, supongo. ¿Por qué lo preguntas?"
    mom "Nein, sie ist zum Frühstück runtergegangen, kam aber gleich wieder hoch, um ihr Handy zu holen. Sie ist bestimmt gleich wieder da. Warum fragst du?"

# game/scripts/c27/c27.rpy:2977
translate german c27s004_KatBreakfast_49bc2670:

    # mc "La he visto en el descansillo y me ha dicho que se había olvidado algo. Se ha metido en su habitación como una exhalación."
    mc "Ich sah sie auf dem Treppenabsatz und sie sagte mir, sie hätte etwas vergessen. Sie stürmte wie ein Wirbelwind in ihr Zimmer."

# game/scripts/c27/c27.rpy:2978
translate german c27s004_KatBreakfast_2abd20b0:

    # mcp "(Pues parece que sí. Que sigue enfadada conmigo. No voy a decir que salía de su habitación con el móvil en la mano.)"
    mcp "(Nun ja, so scheint es. Sie ist immer noch sauer auf mich. Ich werde jetzt nicht behaupten, dass sie ihr Zimmer mit dem Handy in der Hand verlassen hat.)"

# game/scripts/c27/c27.rpy:2980
translate german c27s004_KatBreakfast_a0cc1a4f:

    # emm "El móvil, ¿no?"
    emm "Das Mobiltelefon, richtig?"

# game/scripts/c27/c27.rpy:2981
translate german c27s004_KatBreakfast_571ca948:

    # mc "Es posible..."
    mc "Es ist möglich..."

# game/scripts/c27/c27.rpy:2983
translate german c27s004_KatBreakfast_d114e5da:

    # "Pasas un rato hablando con las chicas mientras tomas un par de cafés y vuelves a tu habitación."
    "Du unterhältst dich eine Weile mit den Mädchen bei ein paar Kaffees und gehst dann zurück in dein Zimmer."

# game/scripts/c27/c27.rpy:2984
translate german c27s004_KatBreakfast_134f6f84:

    # "[kat] ha hecho muy buenas migas con [nor] y con [kim]. Quizás ellas sepan algo sobre lo que le pasa y por qué se enfadó."
    "[kat] versteht sich sehr gut mit [nor] und [kim]. Vielleicht wissen sie etwas darüber, was mit ihm los ist und warum er wütend wurde."

# game/scripts/c27/c27.rpy:2991
translate german c27s004_MeeBetFarewell_a7dd8ec0:

    # "Cuando aún queda un rato para que [nor] tenga que llevar a [mee] y a [bet] al aeropuerto, vas a sus habitaciones a bajar sus maletas."
    "Wenn noch etwas Zeit bleibt, bevor [nor] [mee] und [bet] zum Flughafen bringen muss, gehst du in ihre Zimmer, um ihre Koffer herunterzubringen."

# game/scripts/c27/c27.rpy:2994
translate german c27s004_MeeBetFarewell_f166efc0:

    # mc "Hola, Meemaw. ¿Necesitas ayuda con esa maleta?" id c27s004_MeeBetFarewell_f166efc0
    mc "Hallo Meemaw. Brauchst du Hilfe mit dem Koffer?" id c27s004_MeeBetFarewell_f166efc0

# game/scripts/c27/c27.rpy:2995
translate german c27s004_MeeBetFarewell_1999215b:

    # mee "Hola, [mc]. Ya casi está lista."
    mee "Hallo, [mc]. Es ist fast fertig."

# game/scripts/c27/c27.rpy:3002
translate german c27s004_MeeBetFarewell_bd4bc93d:

    # mee "Lo que sí que necesitaba era un beso."
    mee "Was ich wirklich brauchte, war ein Kuss."

# game/scripts/c27/c27.rpy:3003
translate german c27s004_MeeBetFarewell_4730f93b:

    # mc "No te preocupes, de esos tengo muchos para darte."
    mc "Keine Sorge, ich habe genug davon für dich."

# game/scripts/c27/c27.rpy:3005
translate german c27s004_MeeBetFarewell_ae942294:

    # mee "Se me va a hacer raro estar unos días fuera sin veros."
    mee "Es wird sich seltsam anfühlen, ein paar Tage weg zu sein, ohne euch alle zu sehen."

# game/scripts/c27/c27.rpy:3006
translate german c27s004_MeeBetFarewell_c2a22f07:

    # mc "Espero que estés de vuelta antes de que me vaya a Aruba."
    mc "Ich hoffe, du bist zurück, bevor ich nach Aruba fahre."

# game/scripts/c27/c27.rpy:3008
translate german c27s004_MeeBetFarewell_668080a6:

    # mee "Supongo que sí. Nunca he tenido demasiadas cosas en aquella casa, con lo que empaquetar será rápido con la ayuda de [bet]."
    mee "Das denke ich schon. Ich hatte in dem Haus nie viel Zeug, daher wird das Packen mit der Hilfe von [bet] schnell gehen."

# game/scripts/c27/c27.rpy:3009
translate german c27s004_MeeBetFarewell_c761ba23:

    # mee "Y ponerla a la venta también. He hecho algunas llamadas y el hijo de un conocido es agente inmobiliario."
    mee "Und ich habe es auch zum Verkauf angeboten. Ich habe schon ein paar Mal angerufen, und der Sohn eines Bekannten ist Immobilienmakler."

# game/scripts/c27/c27.rpy:3010
translate german c27s004_MeeBetFarewell_6265d664:

    # mc "Entonces podemos esperar que estés de vuelta para el fin de semana, ¿no? *Risa*"
    mc "Wir können also davon ausgehen, dass du am Wochenende wieder da bist, richtig? *lacht*"

# game/scripts/c27/c27.rpy:3012
translate german c27s004_MeeBetFarewell_cf09f774:

    # mee "*Risa* He dicho rápido, no inmediato. El chico ese pasará a ver la casa el viernes."
    mee "*lacht* Ich sagte schnell, nicht sofort. Der Typ kommt am Freitag, um sich das Haus anzusehen."

# game/scripts/c27/c27.rpy:3013
translate german c27s004_MeeBetFarewell_953ba648:

    # mee "Supongo que estaremos de vuelta en menos de una semana."
    mee "Ich nehme an, wir werden in weniger als einer Woche zurück sein."

# game/scripts/c27/c27.rpy:3014
translate german c27s004_MeeBetFarewell_5009f025:

    # mc "Eso será genial. Yo me voy a finales de la semana que viene si todo va bien."
    mc "Das wird super. Ich reise Ende nächster Woche ab, wenn alles gut geht."

# game/scripts/c27/c27.rpy:3016
translate german c27s004_MeeBetFarewell_d8ecc970:

    # mee "Te voy a echar mucho de menos."
    mee "Ich werde dich sehr vermissen."

# game/scripts/c27/c27.rpy:3017
translate german c27s004_MeeBetFarewell_218da6f6:

    # mc "Y yo a ti, Meemaw. Pero es menos de una semana."
    mc "Und ich liebe dich auch, Meemaw. Aber es ist noch nicht mal eine Woche."

# game/scripts/c27/c27.rpy:3019
translate german c27s004_MeeBetFarewell_e9e09cb5:

    # mee "No me refería a estos días. Cuando vuelva, tú te irás y estarás fuera meses."
    mee "Ich meinte nicht die heutigen Tage. Wenn ich zurückkomme, wirst du monatelang weg sein."

# game/scripts/c27/c27.rpy:3020
translate german c27s004_MeeBetFarewell_d4f6460f:

    # mc "Bueno, no sé si podré venir en Acción de Gracias o en Navidad."
    mc "Nun ja, ich weiß nicht, ob ich zu Thanksgiving oder Weihnachten kommen kann."

# game/scripts/c27/c27.rpy:3021
translate german c27s004_MeeBetFarewell_6d21c351:

    # mc "Pero de todas formas, también me puedes visitar en Aruba."
    mc "Aber du kannst mich ja auch in Aruba besuchen."

# game/scripts/c27/c27.rpy:3023
translate german c27s004_MeeBetFarewell_5ff0def3:

    # mee "¿Dónde vas a vivir allí? ¿En la base de NTR?"
    mee "Wo wirst du dort wohnen? Auf dem NTR-Stützpunkt?"

# game/scripts/c27/c27.rpy:3024
translate german c27s004_MeeBetFarewell_9ec155e3:

    # mc "No, hay una casa a disposición del CEO, en la costa. Aaron me mandó fotos y es chula."
    mc "Nein, für den CEO steht ein Haus an der Küste zur Verfügung. Aaron hat mir Bilder geschickt, und es ist schön."

# game/scripts/c27/c27.rpy:3025
translate german c27s004_MeeBetFarewell_1a0b0dd3:

    # mc "Pero me voy a sentir muy solo allí."
    mc "Aber ich werde mich dort sehr einsam fühlen."

# game/scripts/c27/c27.rpy:3027
translate german c27s004_MeeBetFarewell_2692e43f:

    # mee "Bueno, vas con [ama] y después irá [eva]. ¿Vivirán contigo?"
    mee "Okay, du spielst also [ama] und dann [eva]. Werden sie bei dir wohnen?"

# game/scripts/c27/c27.rpy:3028
translate german c27s004_MeeBetFarewell_f522f3b5:

    # mc "Aún no lo hemos hablado. Aaron también es su familia y él vive en la base. No sé qué querrán hacer ellas."
    mc "Wir haben noch nicht darüber gesprochen. Aaron gehört auch zur Familie und wohnt auf dem Stützpunkt. Ich weiß nicht, was sie vorhaben."

# game/scripts/c27/c27.rpy:3031
translate german c27s004_MeeBetFarewell_0e5a408f:

    # mee "Yo lo tendría clarísimo. ¿Cuántas camas hay en esa casa? Porque las querré probar todas cuando vaya a verte."
    mee "Ich wüsste genau, was zu tun ist. Wie viele Betten gibt es in dem Haus? Denn ich möchte sie alle ausprobieren, wenn ich dich besuche."

# game/scripts/c27/c27.rpy:3032
translate german c27s004_MeeBetFarewell_797a78c3:

    # mc "*Risa* Veo que alguien quiere recuperar el tiempo perdido."
    mc "*Gelächter* Da will wohl jemand die verlorene Zeit aufholen."

# game/scripts/c27/c27.rpy:3033
translate german c27s004_MeeBetFarewell_82c1f004:

    # mc "*Risa* En ese caso, sería mejor para tus planes que [ama] y [eva] durmieran en la base."
    mc "*Lacht* In diesem Fall wäre es für deine Pläne besser, wenn [ama] und [eva] an der Basis schlafen würden."

# game/scripts/c27/c27.rpy:3036
translate german c27s004_MeeBetFarewell_c59bd940:

    # mee "*Risa* Seguro que sí. Lo de decirles 'vete a dormir al sofá porque mi nieto y yo vamos a follar en tu cama' no parece diplomático."
    mee "*Lacht* Da bin ich mir sicher. Ihnen zu sagen: „Schlaft auf dem Sofa, denn mein Enkel und ich werden in eurem Bett Sex haben“, klingt nicht gerade diplomatisch."

# game/scripts/c27/c27.rpy:3038
translate german c27s004_MeeBetFarewell_916a31d2:

    # mee "*Risa* Seguro que sí. Lo de decirles 'vete a dormir al sofá porque [mc] y yo vamos a follar en tu cama' no parece diplomático."
    mee "*Lacht* Bestimmt. Ihnen zu sagen: „Geht auf der Couch schlafen, denn [mc] und ich werden in eurem Bett Sex haben“, klingt nicht gerade diplomatisch."

# game/scripts/c27/c27.rpy:3040
translate german c27s004_MeeBetFarewell_b76347d2:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que se quisieran unir, aunque en el caso de [ama] lo dudo."
    mc "*Lacht* Ich glaube nicht. Außerdem könnten sie ja ihre Kräfte bündeln wollen, obwohl ich das im Fall von [ama] bezweifle."

# game/scripts/c27/c27.rpy:3041
translate german c27s004_MeeBetFarewell_c044b689:

    # mc "Pero no me sorprendería que [eva] quisiera estrechar lazos contigo con un trío."
    mc "Aber es würde mich nicht wundern, wenn [eva] dir mit einem Dreier näherkommen wollte."

# game/scripts/c27/c27.rpy:3043
translate german c27s004_MeeBetFarewell_6fbad351:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que [ama] uniera, aunque lo dudo."
    mc "*Lacht* Ich glaube nicht. Außerdem ist es zwar möglich, dass sich [ama] vereint, aber ich bezweifle es."

# game/scripts/c27/c27.rpy:3045
translate german c27s004_MeeBetFarewell_ebb9d771:

    # mc "*Risa* Creo que no lo sería. Además podría pasar que [eva] se quisiera unir. No me sorprendería que quisiera estrechar lazos contigo con un trío."
    mc "*Lacht* Ich glaube nicht. Außerdem könnte [eva] ja mitmachen wollen. Es würde mich nicht wundern, wenn er dir in einem Dreier näherkommen wollte."

# game/scripts/c27/c27.rpy:3047
translate german c27s004_MeeBetFarewell_2850f646:

    # mc "*Risa* Creo que no lo sería."
    mc "*Lacht* Ich glaube nicht."

# game/scripts/c27/c27.rpy:3048
translate german c27s004_MeeBetFarewell_25c265ea:

    # mc "Pero podemos probar todas las camas no ocupadas."
    mc "Aber wir können alle freien Betten ausprobieren."

# game/scripts/c27/c27.rpy:3051
translate german c27s004_MeeBetFarewell_be8d3267:

    # "Tu abuela te da un beso como pocos nietos han recibido de sus abuelas."
    "Deine Großmutter gibt dir einen Kuss, wie ihn nur wenige Enkelkinder von ihren Großmüttern erhalten haben."

# game/scripts/c27/c27.rpy:3053
translate german c27s004_MeeBetFarewell_cae9380c:

    # "[mee] te da un beso como pocos nietos han recibido de sus abuelas. Da lo mismo que no estéis emparentados. Siempre será tu abuela."
    "Sie gibt dir einen Kuss, wie ihn nur wenige Enkelkinder von ihren Großmüttern bekommen. Es spielt keine Rolle, dass ihr nicht verwandt seid. Sie wird immer deine Großmutter sein."

# game/scripts/c27/c27.rpy:3054
translate german c27s004_MeeBetFarewell_f42214e9:

    # "Es un beso que sabe a despedida."
    "Es ist ein Kuss, der nach Abschied schmeckt."

# game/scripts/c27/c27.rpy:3056
translate german c27s004_MeeBetFarewell_afc77b99:

    # mee "Deberías bajar la maleta e ir a ver a [bet]. Es posible que ella también necesite ayuda."
    mee "Du solltest deinen Koffer mit nach unten nehmen und zu [bet] gehen. Sie könnte auch Hilfe benötigen."

# game/scripts/c27/c27.rpy:3057
translate german c27s004_MeeBetFarewell_36c3f932:

    # mee "Y no quiero alargar nuestra despedida más de lo necesario o me voy a poner triste antes de irme."
    mee "Und ich möchte unseren Abschied nicht länger als nötig hinauszögern, sonst werde ich traurig, bevor ich gehe."

# game/scripts/c27/c27.rpy:3058
translate german c27s004_MeeBetFarewell_8231049d:

    # mc "De acuerdo. Y no te pongas triste. Nos veremos en menos de una semana."
    mc "Okay. Und sei nicht traurig. Wir sehen uns in weniger als einer Woche wieder."

# game/scripts/c27/c27.rpy:3060
translate german c27s004_MeeBetFarewell_b511dc15:

    # mee "Hasta dentro de una semana, [mc]."
    mee "Wir sehen uns in einer Woche, [mc]."

# game/scripts/c27/c27.rpy:3061
translate german c27s004_MeeBetFarewell_d4b33b85:

    # mc "Hasta dentro de una semana, Meemaw."
    mc "Wir sehen uns in einer Woche, Meemaw."

# game/scripts/c27/c27.rpy:3064
translate german c27s004_MeeBetFarewell_a302fc1a:

    # "Bajas la maleta de [mee] a la planta baja y vas a ver a [bet]."
    "Du nimmst den Koffer von [mee] nach unten und gehst zu [bet]."

# game/scripts/c27/c27.rpy:3065
translate german c27s004_MeeBetFarewell_c6a7df6d:

    # mc "Hola, Tía [bet]. ¿Necesitas ayuda con las maletas?"
    mc "Hallo Tante [bet]. Brauchst du Hilfe mit deinen Koffern?"

# game/scripts/c27/c27.rpy:3066
translate german c27s004_MeeBetFarewell_67d948a9:

    # bet "No hace falta. Era solo una y la he bajado hace un rato. Ya está en el coche de [nor]."
    bet "Nicht nötig. Es war nur eins, und ich habe es vor einer Weile ausgebaut. Es ist bereits im Auto von [nor]."

# game/scripts/c27/c27.rpy:3067
translate german c27s004_MeeBetFarewell_feda2bd5:

    # mc "Perfecto, acabo de bajar la de Meemaw. Dejo que te acabes de vestir, entonces."
    mc "Perfekt, ich habe Meemaws Datei gerade heruntergeladen. Dann kannst du dich jetzt fertig anziehen."

# game/scripts/c27/c27.rpy:3069
translate german c27s004_MeeBetFarewell_71b37506:

    # bet "Te voy a echar mucho de menos."
    bet "Ich werde dich sehr vermissen."

# game/scripts/c27/c27.rpy:3070
translate german c27s004_MeeBetFarewell_94a17613:

    # mc "Y yo a ti, pero Meemaw me ha dicho que estaréis fuera menos de una semana."
    mc "Und ich liebe dich auch, aber Meemaw hat mir gesagt, dass du weniger als eine Woche weg sein wirst."

# game/scripts/c27/c27.rpy:3071
translate german c27s004_MeeBetFarewell_221f7234:

    # mc "Y después espero que vengas a Aruba conmigo para operar a Gavin."
    mc "Und dann hoffe ich, dass Sie mit mir nach Aruba kommen, um Gavin zu operieren."

# game/scripts/c27/c27.rpy:3073
translate german c27s004_MeeBetFarewell_2fd3634b:

    # bet "Aún tengo que acabar de estudiar la información que me ha mandado Aaron, pero creo que iré finalmente."
    bet "Ich muss die Informationen, die Aaron mir geschickt hat, noch vollständig durcharbeiten, aber ich denke, ich werde jetzt endlich gehen."

# game/scripts/c27/c27.rpy:3074
translate german c27s004_MeeBetFarewell_8603f6b3:

    # bet "La perspectiva de hacer una operación que no se ha hecho nunca es el sueño de cualquier cirujano."
    bet "Die Aussicht, eine Operation durchzuführen, die noch nie zuvor durchgeführt wurde, ist der Traum eines jeden Chirurgen."

# game/scripts/c27/c27.rpy:3075
translate german c27s004_MeeBetFarewell_d91b64eb:

    # mc "Entonces no tendrás mucho tiempo para echarme de menos."
    mc "Dann wirst du nicht viel Zeit haben, mich zu vermissen."

# game/scripts/c27/c27.rpy:3077
translate german c27s004_MeeBetFarewell_427bd3f8:

    # bet "Pero entonces echaré de menos a todas las chicas. Incluso a [mee]."
    bet "Aber dann werde ich all die Mädchen vermissen. Sogar [mee]."

# game/scripts/c27/c27.rpy:3078
translate german c27s004_MeeBetFarewell_5f0efc15:

    # mc "Sobre eso no puedo hacer mucho. Yo también las voy a echar de menos."
    mc "Da kann ich nicht viel machen. Ich werde sie auch vermissen."

# game/scripts/c27/c27.rpy:3081
translate german c27s004_MeeBetFarewell_9500ecfc:

    # bet "Bueno, vete ya antes de que se me salten las lágrimas. Tengo que acabar de vestirme."
    bet "Okay, geh jetzt, bevor ich anfange zu weinen. Ich muss mich noch fertig anziehen."

# game/scripts/c27/c27.rpy:3082
translate german c27s004_MeeBetFarewell_28ab7de5:

    # mc "OK. Te veo abajo."
    mc "Okay. Wir sehen uns unten."

# game/scripts/c27/c27.rpy:3085
translate german c27s004_MeeBetFarewell_a0b4fbbe:

    # "Al pasar por delante de la puerta de [mee] oyes voces en el interior."
    "Als du an der Tür von [mee] vorbeigehst, hörst du Stimmen von drinnen."

# game/scripts/c27/c27.rpy:3086
translate german c27s004_MeeBetFarewell_b3a82761:

    # mee "*A través de la puerta* Hola, [mad.nick], dime..."
    mee "*Durch die Tür* Hallo, [mad.nick], sag mir..."

# game/scripts/c27/c27.rpy:3089
translate german c27s004_MeeBetFarewell_9553287f:

    # bet "Por otro lado, tengo ganas de estar tiempo a solas contigo en Aruba."
    bet "Andererseits freue ich mich darauf, einige Zeit allein mit dir in Aruba zu verbringen."

# game/scripts/c27/c27.rpy:3090
translate german c27s004_MeeBetFarewell_be5410f6:

    # mc "No sé si vamos a tener mucho tiempo libre, pero lo pasaremos juntos."
    mc "Ich weiß nicht, ob wir viel Freizeit haben werden, aber wir werden sie zusammen verbringen."

# game/scripts/c27/c27.rpy:3092
translate german c27s004_MeeBetFarewell_08ca220d:

    # bet "*Risa* Si hacer esa operación imposible no fuera incentivo suficiente para ir, pasar tiempo contigo en un paraíso tropical sería un aliciente extra."
    bet "*lacht* Wenn die Durchführung dieser unmöglichen Operation nicht schon Anreiz genug wäre, dann wäre die Zeit, die ich mit dir in einem tropischen Paradies verbringe, ein zusätzlicher Anreiz."

# game/scripts/c27/c27.rpy:3093
translate german c27s004_MeeBetFarewell_0cc2bfc0:

    # mc "*Risa* A mí lo del paraíso tropical no me suena demasiado bien. Calor, humedad, mosquitos..."
    mc "*lacht* Das ganze Tropenparadies-Zeug klingt für mich nicht besonders verlockend. Hitze, Schwüle, Mücken..."

# game/scripts/c27/c27.rpy:3095
translate german c27s004_MeeBetFarewell_c78f41a4:

    # bet "*Risa* Entonces haremos el amor dentro de tu casa, bajo el aire acondicionado."
    bet "*Gelächter* Dann werden wir in deinem Haus Liebe machen, unter der Klimaanlage."

# game/scripts/c27/c27.rpy:3096
translate german c27s004_MeeBetFarewell_10a004f4:

    # mc "*Risa* Me parece una idea fantástica."
    mc "*lacht* Ich finde das eine fantastische Idee."

# game/scripts/c27/c27.rpy:3098
translate german c27s004_MeeBetFarewell_e19ccd08:

    # "La ex-monja te da un beso dulce en el que hay anticipación, pero también algo de tristeza por el tiempo que vais a pasar separados."
    "Die Ex-Nonne gibt dir einen süßen Kuss voller Vorfreude, aber auch mit einem Hauch von Traurigkeit über die Zeit, die ihr getrennt verbringen werdet."

# game/scripts/c27/c27.rpy:3099
translate german c27s004_MeeBetFarewell_d6b3a35e:

    # "No habéis tenido muchas oportunidades de pasar tiempo juntos desde el viaje a Monterey y ahora ella se tiene que ir."
    "Seit der Reise nach Monterey hattet ihr nicht viele Gelegenheiten, Zeit miteinander zu verbringen, und nun muss sie auch noch abreisen."

# game/scripts/c27/c27.rpy:3100
translate german c27s004_MeeBetFarewell_e170e6ec:

    # "Aún no sabes cuánto tiempo estará ella en Aruba para la operación, lo que sabes es que lo vais a aprovechar."
    "Sie wissen noch nicht, wie lange sie für die Operation in Aruba bleiben wird, aber Sie wissen, dass Sie die Zeit bestmöglich nutzen werden."

# game/scripts/c27/c27.rpy:3102
translate german c27s004_MeeBetFarewell_57ef5208:

    # bet "Deberías irte antes de que te tumbe en la cama o perderé el avión."
    bet "Du solltest gehen, bevor ich dich ins Bett schlage, sonst verpasse ich meinen Flug."

# game/scripts/c27/c27.rpy:3103
translate german c27s004_MeeBetFarewell_6d28a58f:

    # mc "*Risa* Entonces voy a dejar que te vistas. Te veo abajo, [bet]."
    mc "*Lacht* Dann lasse ich dich dich anziehen. Wir sehen uns unten, [bet]."

# game/scripts/c27/c27.rpy:3106
translate german c27s004_MeeBetFarewell_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:3107
translate german c27s004_MeeBetFarewell_a7399e02:

    # "Mientras te diriges a la puerta de su habitación, suena el teléfono de [bet]."
    "Als du dich der Tür seines Zimmers näherst, klingelt [bet]s Telefon."

# game/scripts/c27/c27.rpy:3108
translate german c27s004_MeeBetFarewell_81c9703e:

    # bet "Hola, [mad.nick], dime..."
    bet "Hallo, [mad.nick], sag mir..."

# game/scripts/c27/c27.rpy:3110
translate german c27s004_MeeBetFarewell_4371cdd5:

    # mcp "(Estoy super contento con las dinámicas que se están creando en la familia. Que [mad.nick] llame para despedirse es una muestra de ello.)"
    mcp "(Ich bin wirklich glücklich über die Dynamik, die sich in der Familie entwickelt. [mad.nick] Der Anruf zum Abschied ist der Beweis dafür.)"

# game/scripts/c27/c27.rpy:3112
translate german c27s004_MeeBetFarewell_46b5b83d:

    # "Bajas a la cocina a esperar a que las mujeres acaben de arreglarse y con la esperanza de poder preguntarle a [nor] o a [kim] sobre lo que le pasa a [kat]."
    "Du gehst in die Küche hinunter und wartest, bis die Frauen mit dem Fertigmachen fertig sind, in der Hoffnung, dass du fragen kannst, was mit [kat] los ist."

# game/scripts/c27/c27.rpy:3114
translate german c27s004_MeeBetFarewell_fe049a43:

    # "Por desgracia, preguntarles sobre [kat] con [kat] delante no es una opción."
    "Leider ist es keine Option, sie nach [kat] mit [kat] davor zu fragen."

# game/scripts/c27/c27.rpy:3115
translate german c27s004_MeeBetFarewell_96b1bfb2:

    # "Menos aún cuando [kat] rehúye tu mirada. Cada vez estás seguro de que le pasa algo."
    "Erst recht nicht, wenn [kat] deinen Blick meidet. Du bist dir immer sicherer, dass etwas mit ihr nicht stimmt."

# game/scripts/c27/c27.rpy:3117
translate german c27s004_MeeBetFarewell_c2cf213b:

    # "La despedida de las dos mujeres es demasiado triste."
    "Der Abschied zwischen den beiden Frauen ist zu traurig."

# game/scripts/c27/c27.rpy:3118
translate german c27s004_MeeBetFarewell_62fce943:

    # "Es la primera vez desde que se empezó a formar el sentimiento familiar que alguien va a estar fuera durante una semana."
    "Es ist das erste Mal seitdem sich dieses Familiengefühl herausgebildet hat, dass jemand für eine Woche abwesend sein wird."

# game/scripts/c27/c27.rpy:3119
translate german c27s004_MeeBetFarewell_939927ea:

    # "Se derraman algunas lágrimas, pero las chicas me han pedido que no diga quién lloró. Especialmente [eva]."
    "Ein paar Tränen flossen, aber die Mädchen baten mich, nicht zu verraten, wer geweint hat. Besonders [eva]."

# game/scripts/c27/c27.rpy:3120
translate german c27s004_MeeBetFarewell_3691ba7a:

    # "¡Oops! Me parezco a [lis] guardando secretos."
    "Ups! Ich klinge ja wie jemand, der Geheimnisse hütet."

# game/scripts/c27/c27.rpy:3122
translate german c27s004_MeeBetFarewell_8416b25b:

    # "Cuando se van, tampoco tienes la oportunidad de hablar con [kim]. Vuelve a casa charlando con [kat]."
    "Wenn sie gehen, hast du auch keine Gelegenheit, mit [kim] zu sprechen. Geh zurück nach Hause und unterhalte dich mit [kat]."

# game/scripts/c27/c27.rpy:3123
translate german c27s004_MeeBetFarewell_9c1c8d5a:

    # "Bueno, habrá tiempo para hablar. O incluso es posible que a [kat] se le pase lo que sea que le está pasando."
    "Nun, es wird noch Zeit zum Reden geben. Oder es ist sogar möglich, dass sich das Problem mit [kat] von selbst löst."

# game/scripts/c27/c27.rpy:3130
translate german c27s004_ScaInterview_7149bc57:

    # "Ayudas a [emm] a mover los trastos del sótano. Ha hecho un buen trabajo con las pegatinas rosas."
    "Du hilfst [emm] dabei, den Kram im Keller wegzuräumen. Sie hat die pinken Aufkleber gut angebracht."

# game/scripts/c27/c27.rpy:3131
translate german c27s004_ScaInterview_0c33a256:

    # "Todos los trastos que hay que tirar son fácilmente identificables."
    "Der gesamte Müll, der weggeworfen werden muss, ist leicht zu erkennen."

# game/scripts/c27/c27.rpy:3132
translate german c27s004_ScaInterview_1d1831fd:

    # "[emm] derrama algunas lágrimas cuando ve todas las pegatinas que ha perdido una vez subes las cosas a la camioneta."
    "[emm] Sie vergießt ein paar Tränen, als sie all die Aufkleber sieht, die sie verloren hat, nachdem du die Sachen in den Lieferwagen geladen hast."

# game/scripts/c27/c27.rpy:3133
translate german c27s004_ScaInterview_a7d3ec7e:

    # "Ha intentado recuperar las pegatinas sin éxito."
    "Er hat erfolglos versucht, die Aufkleber zurückzubekommen."

# game/scripts/c27/c27.rpy:3134
translate german c27s004_ScaInterview_e1793bd0:

    # "[oma] aprovecha su día de fiesta para ayudarte a llevar los trastos al chatarrero antes de comer."
    "[oma] Er nutzt seinen freien Tag, um dir zu helfen, den Schrott vor dem Mittagessen zum Schrotthändler zu bringen."

# game/scripts/c27/c27.rpy:3136
translate german c27s004_ScaInterview_732888d7:

    # "Después de comer las chicas van a la piscina y tú vuelves a tu habitación..."
    "Nach dem Mittagessen gehen die Mädchen zum Pool und du gehst zurück in dein Zimmer..."

# game/scripts/c27/c27.rpy:3138
translate german c27s004_ScaInterview_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c27/c27.rpy:3139
translate german c27s004_ScaInterview_941004dc:

    # eri "*A través de la puerta* Somos nosotras, ¿podemos pasar?"
    eri "*Durch die Tür* Wir sind es, dürfen wir hereinkommen?"

# game/scripts/c27/c27.rpy:3141
translate german c27s004_ScaInterview_157376e5:

    # mc "Adelante, tú y tu silenciosa compañera."
    mc "Nur zu, du und dein stiller Begleiter."

# game/scripts/c27/c27.rpy:3143
translate german c27s004_ScaInterview_9dbded77:

    # eri "*Risa* Mi silenciosa compañera es [sca]."
    eri "*Lacht* Mein stiller Begleiter ist [sca]."

# game/scripts/c27/c27.rpy:3144
translate german c27s004_ScaInterview_14ba5775:

    # sca "Hola, [mc]."
    sca "Hallo, [mc]."

# game/scripts/c27/c27.rpy:3145
translate german c27s004_ScaInterview_83848b48:

    # mc "¿Te pasa algo, [sca]?"
    mc "Ist etwas nicht in Ordnung, [sca]?"

# game/scripts/c27/c27.rpy:3147
translate german c27s004_ScaInterview_c819908b:

    # eri "Está nerviosa. [eil] me acaba de llamar para decirme que nuestro jefe quiere conocer a [sca]."
    eri "Sie ist nervös. [eil] hat mich gerade angerufen, um mir mitzuteilen, dass unser Chef [sca] treffen möchte."

# game/scripts/c27/c27.rpy:3148
translate german c27s004_ScaInterview_3af951a3:

    # eri "Ayer le hablamos de ella y hoy se pasará por el café. ¿Nos puedes llevar?"
    eri "Wir haben ihr gestern von ihr erzählt, und sie kommt heute im Café vorbei. Könntest du uns mitnehmen?"

# game/scripts/c27/c27.rpy:3149
translate german c27s004_ScaInterview_fb875d3b:

    # mc "Claro, ningún problema. ¿Cuándo os tengo que llevar?"
    mc "Klar, kein Problem. Wann soll ich Sie bringen?"

# game/scripts/c27/c27.rpy:3151
translate german c27s004_ScaInterview_264982e2:

    # eri "Yo empiezo mi turno en 50 minutos. Si nos llevas a las dos, [sca] puede esperar allí hasta que llegue mi jefe."
    eri "Meine Schicht beginnt in 50 Minuten. Wenn du uns beide mitnimmst, kann [sca] dort warten, bis mein Chef eintrifft."

# game/scripts/c27/c27.rpy:3152
translate german c27s004_ScaInterview_e3c40d2c:

    # mc "OK. Podríamos salir en 30 minutos y llegamos con tiempo antes de que empieces el turno."
    mc "Okay. Wir könnten in 30 Minuten losfahren und rechtzeitig vor Ihrem Schichtbeginn ankommen."

# game/scripts/c27/c27.rpy:3154
translate german c27s004_ScaInterview_cf1a89a2:

    # mc "No estés nerviosa, es sólo una entrevista de trabajo."
    mc "Keine Sorge, es ist nur ein Vorstellungsgespräch."

# game/scripts/c27/c27.rpy:3155
translate german c27s004_ScaInterview_6939201a:

    # sca "Es que va a ser mi primera entrevista. Mi madre no me dejaba trabajar, decía que me tenía que centrar en los estudios."
    sca "Das wird mein erstes Vorstellungsgespräch sein. Meine Mutter hat mir nicht erlaubt zu arbeiten; sie meinte, ich müsse mich auf mein Studium konzentrieren."

# game/scripts/c27/c27.rpy:3156
translate german c27s004_ScaInterview_19f45738:

    # mc "Eres lo suficientemente inteligente como para hacer las dos cosas, [sca]."
    mc "Du bist klug genug, beides zu tun, [sca]."

# game/scripts/c27/c27.rpy:3157
translate german c27s004_ScaInterview_a90a0a92:

    # mc "Además, estoy seguro de que tanto [eri] como [eil] te han dado consejos."
    mc "Außerdem bin ich mir sicher, dass sowohl [eri] als auch [eil] Ihnen einen Ratschlag gegeben haben."

# game/scripts/c27/c27.rpy:3159
translate german c27s004_ScaInterview_96554d74:

    # eri "Básicamente que se convierta en nuestra esclava mientras esté en el café. *Risa* Es broma."
    eri "Im Grunde wollen wir, dass sie während ihres Aufenthalts im Café unsere Sklavin wird. *lacht* Nur ein Scherz."

# game/scripts/c27/c27.rpy:3160
translate german c27s004_ScaInterview_3c01bec4:

    # eri "Mi jefe no es muy exigente y ella viene recomendada por nosotras, con lo que tiene muchas posibilidades de que la contrate."
    eri "Mein Chef ist nicht sehr anspruchsvoll, und sie wurde von uns empfohlen, daher stehen die Chancen gut, dass er sie einstellt."

# game/scripts/c27/c27.rpy:3162
translate german c27s004_ScaInterview_00b08729:

    # eri "Y una vez empiece a trabajar, [eil] y yo moveremos nuestros turnos para que una de las dos esté con ella cada día al menos las primeras semanas."
    eri "Und sobald sie anfängt zu arbeiten, werden [eil] und ich unsere Schichten tauschen, sodass einer von uns zumindest in den ersten Wochen jeden Tag bei ihr ist."

# game/scripts/c27/c27.rpy:3163
translate german c27s004_ScaInterview_73c8887a:

    # mc "Estoy seguro de que eso la ayudará mucho."
    mc "Ich bin sicher, das wird ihr sehr helfen."

# game/scripts/c27/c27.rpy:3165
translate german c27s004_ScaInterview_8b833349:

    # mc "¿Ves? No tienes que estar nerviosa. [eri] y [eil] lo tienen todo planificado."
    mc "Siehst du? Du brauchst nicht nervös zu sein. [eri] und [eil] haben alles durchdacht."

# game/scripts/c27/c27.rpy:3166
translate german c27s004_ScaInterview_acb4c634:

    # sca "Pero es que ya me conocéis. Soy tímida y me cuesta mucho hablar con desconocidos..."
    sca "Aber du kennst mich ja. Ich bin schüchtern und es fällt mir wirklich schwer, mit Fremden zu reden..."

# game/scripts/c27/c27.rpy:3167
translate german c27s004_ScaInterview_d45826f5:

    # sca "¿Y si empiezo a balbucear en la entrevista? ¿Y si me quedo en blanco?"
    sca "Was, wenn ich während des Vorstellungsgesprächs ins Stocken gerate? Was, wenn ich wie gelähmt bin?"

# game/scripts/c27/c27.rpy:3168
translate german c27s004_ScaInterview_99735a43:

    # mc "¿Y si se te escapa un eructo durante la entrevista?"
    mc "Was passiert, wenn man während des Vorstellungsgesprächs versehentlich rülpst?"

# game/scripts/c27/c27.rpy:3170
translate german c27s004_ScaInterview_92dacd4e:

    # sca "¿Qué?"
    sca "Das?"

# game/scripts/c27/c27.rpy:3171
translate german c27s004_ScaInterview_42f09261:

    # mc "Te estás poniendo nerviosa pensando en todo lo que puede salir mal. *Risa* Yo solo te doy un escenario nuevo en el que no habías pensado."
    mc "Du wirst nervös, weil du an all die Dinge denkst, die schiefgehen könnten. *lacht* Ich präsentiere dir nur ein neues Szenario, das du noch nicht in Betracht gezogen hast."

# game/scripts/c27/c27.rpy:3173
translate german c27s004_ScaInterview_b5c01fcd:

    # sca "¡Eres un capullo! ¡Eso no ayuda!"
    sca "Du bist ein Idiot! Das hilft nicht!"

# game/scripts/c27/c27.rpy:3174
translate german c27s004_ScaInterview_07f595b1:

    # mc "Sí que ayuda. *Risa* La [sca] tímida de hace un mes nunca me hubiera llamado capullo."
    mc "Das hilft wirklich. *lacht* Das schüchterne Mädchen von vor einem Monat hätte mich nie einen Idioten genannt."

# game/scripts/c27/c27.rpy:3175
translate german c27s004_ScaInterview_40ebeab9:

    # mc "Ya no eres la que eras. Desde que llegaron las chicas te has abierto mucho y has perdido la timidez. No tienes que temer nada en la entrevista."
    mc "Du bist nicht mehr dieselbe Person wie früher. Seit die Mädchen da sind, bist du viel offener geworden und hast deine Schüchternheit verloren. Du brauchst das Vorstellungsgespräch nicht zu fürchten."

# game/scripts/c27/c27.rpy:3177
translate german c27s004_ScaInterview_58df713d:

    # eri "¿Ves cómo hemos hecho bien en venir a ver a [mc]? Sabía que te quitaría los nervios."
    eri "Siehst du? Es war richtig, dass wir gekommen sind, um [mc] zu sehen. Ich wusste, es würde dich beruhigen."

# game/scripts/c27/c27.rpy:3178
translate german c27s004_ScaInterview_15e80be3:

    # mc "Veo que no vas con el uniforme. ¿Hablaste con tu jefe respecto a la taquillas de [eil]?"
    mc "Ich sehe, Sie tragen keine Uniform. Haben Sie mit Ihrem Chef über die Spinde bei [eil] gesprochen?"

# game/scripts/c27/c27.rpy:3180
translate german c27s004_ScaInterview_8c090681:

    # eri "Sí, y fue la cosa más tonta del mundo. Él creía que ya compartíamos taquilla porque somos amigas."
    eri "Ja, und es war das Dümmste überhaupt. Er dachte, wir würden uns bereits einen Spind teilen, weil wir befreundet sind."

# game/scripts/c27/c27.rpy:3181
translate german c27s004_ScaInterview_c7700068:

    # eri "Dijo que todo el mundo lo hace..."
    eri "Er sagte, das mache jeder..."

# game/scripts/c27/c27.rpy:3182
translate german c27s004_ScaInterview_b8183412:

    # mc "*Risa* Todo el mundo lo pensó menos vosotras. Sois demasiado legales."
    mc "*Gelächter* Alle dachten es, außer dir. Du bist zu gesetzestreu."

# game/scripts/c27/c27.rpy:3184
translate german c27s004_ScaInterview_91b2843c:

    # sca "Pues voy a cambiarme de ropa para la entrevista. No creo que ir así sea lo mejor..."
    sca "Ich werde mich für das Vorstellungsgespräch umziehen. So hinzugehen ist keine gute Idee..."

# game/scripts/c27/c27.rpy:3185
translate german c27s004_ScaInterview_069acffe:

    # mc "Nope. En eso tienes razón. *Risa* Aunque yo te contrataría."
    mc "Nein. Da hast du recht. *lacht* Obwohl ich dich einstellen würde."

# game/scripts/c27/c27.rpy:3187
translate german c27s004_ScaInterview_bb6d2873:

    # "Las dos chicas se van y te dejan solo en la habitación."
    "Die beiden Mädchen gehen und lassen dich allein im Zimmer zurück."

# game/scripts/c27/c27.rpy:3189
translate german c27s004_ScaInterview_f92ce853:

    # "Bajas a sacar la camioneta del garaje unos minutos antes de lo acordado."
    "Du gehst ein paar Minuten früher als vereinbart runter, um den LKW aus der Garage zu holen."

# game/scripts/c27/c27.rpy:3191
translate german c27s004_ScaInterview_bd1ed2d9:

    # "[eri] y [sca] ya te están esperando. Los nervios no han desaparecido del todo."
    "[eri] und [sca] warten schon auf dich. Die Nervosität ist noch nicht ganz verschwunden."

# game/scripts/c27/c27.rpy:3193
translate german c27s004_ScaInterview_f85205d9:

    # "Durante el trayecto [sca] hace mil preguntas a [eri]. Quiere saber cómo funciona todo antes de la entrevista."
    "Während der Fahrt stellt [sca] [eri] tausend Fragen. Er möchte vor dem Vorstellungsgespräch wissen, wie alles funktioniert."

# game/scripts/c27/c27.rpy:3195
translate german c27s004_ScaInterview_3055ef57:

    # "Al llegar al café, [eri] sustituye a [eil], que se sienta a tomar un café con [sca] y contigo."
    "Bei der Ankunft im Café ersetzt [eri] [eil], der sich zu [sca] und Ihnen hinsetzt, um einen Kaffee zu trinken."

# game/scripts/c27/c27.rpy:3196
translate german c27s004_ScaInterview_a65a65bb:

    # "El bombardeo de preguntas se dirige a la pelirroja ahora."
    "Die Flut von Fragen richtet sich nun an die Rothaarige."

# game/scripts/c27/c27.rpy:3198
translate german c27s004_ScaInterview_8d5eabbe:

    # "La llegada de [oma] salva tu salud mental. A la vigésima pregunta sobre la cafetera, tu cerebro se ha desconectado."
    "Die Ankunft von [oma] rettet Ihre geistige Gesundheit. Spätestens bei der zwanzigsten Frage zur Kaffeemaschine schaltet Ihr Gehirn ab."

# game/scripts/c27/c27.rpy:3199
translate german c27s004_ScaInterview_c200dcae:

    # oma "¿Qué tal? ¿Ya ha tenido la entrevista?"
    oma "Wie geht es Ihnen? Hatten Sie schon das Vorstellungsgespräch?"

# game/scripts/c27/c27.rpy:3200
translate german c27s004_ScaInterview_2f9620ba:

    # mc "No, aún no. El jefe llegará en una hora más o menos."
    mc "Nein, noch nicht. Der Chef kommt in etwa einer Stunde."

# game/scripts/c27/c27.rpy:3201
translate german c27s004_ScaInterview_043d7282:

    # oma "¿Te vas a quedar hasta que acabe la entrevista?"
    oma "Werden Sie bis zum Ende des Vorstellungsgesprächs bleiben?"

# game/scripts/c27/c27.rpy:3202
translate german c27s004_ScaInterview_43567b9e:

    # mc "Sí, entonces la llevaré a ella y a [eil] a casa. Quiero saber si le han dado el trabajo."
    mc "Ja, dann bringe ich sie jetzt nach Hause. Ich möchte wissen, ob sie die Stelle bekommen hat."

# game/scripts/c27/c27.rpy:3204
translate german c27s004_ScaInterview_8f0f2c6c:

    # eil "No lo sabrá hoy. Hay un par de chicas más que vienen a hacer entrevistas después de ella."
    eil "Sie wird es heute nicht erfahren. Nach ihr kommen noch ein paar andere Mädchen zu Vorstellungsgesprächen."

# game/scripts/c27/c27.rpy:3205
translate german c27s004_ScaInterview_116e0b4a:

    # eil "Lo más probable es que mi jefe avise a la chica que contrate mañana."
    eil "Mein Chef wird das Mädchen, das er einstellt, höchstwahrscheinlich morgen benachrichtigen."

# game/scripts/c27/c27.rpy:3206
translate german c27s004_ScaInterview_eb12d7be:

    # mc "De todas formas esperaré para llevaros a casa."
    mc "Jedenfalls warte ich, bis ich dich nach Hause bringe."

# game/scripts/c27/c27.rpy:3208
translate german c27s004_ScaInterview_44cb32fb:

    # eil "No hace falta. Puedes llevar a [oma] y que ella me deje su coche y yo llevo a [sca]."
    eil "Das ist nicht nötig. Du kannst [oma] nehmen, sie kann mir ihr Auto leihen und ich nehme [sca]."

# game/scripts/c27/c27.rpy:3209
translate german c27s004_ScaInterview_e36f2161:

    # eil "*Risa* De todas formas vamos a seguir ignorándote."
    eil "*lacht* Wie dem auch sei, wir werden dich weiterhin ignorieren."

# game/scripts/c27/c27.rpy:3210
translate german c27s004_ScaInterview_a8c4b70f:

    # mc "*Risa* Creo que puedo nombrar 17 partes de la cafetera ahora mismo. Y seis tipos de pastas que vendéis."
    mc "*lacht* Ich glaube, ich kann jetzt auf Anhieb 17 Teile der Kaffeemaschine aufzählen. Und sechs Sorten Gebäck, die Sie verkaufen."

# game/scripts/c27/c27.rpy:3212
translate german c27s004_ScaInterview_ccb885b8:

    # sca "Lo siento, [mc]. Sé que no soy una buena compañía cuando me pongo así. Quiero saber todo lo posible antes de la entrevista."
    sca "Es tut mir leid, [mc]. Ich weiß, dass ich in diesem Zustand keine angenehme Gesellschaft bin. Ich möchte vor dem Vorstellungsgespräch so viel wie möglich wissen."

# game/scripts/c27/c27.rpy:3213
translate german c27s004_ScaInterview_8b945464:

    # mc "No te preocupes, es lógico. Va a ser tu primer trabajo."
    mc "Keine Sorge, das ist normal. Es wird dein erster Job sein."

# game/scripts/c27/c27.rpy:3214
translate german c27s004_ScaInterview_cd4ee309:

    # sca "Si consigo el trabajo..."
    sca "Wenn ich den Job bekomme..."

# game/scripts/c27/c27.rpy:3215
translate german c27s004_ScaInterview_d042c476:

    # mc "Cuando consigas el trabajo."
    mc "Wenn du den Job bekommst."

# game/scripts/c27/c27.rpy:3217
translate german c27s004_ScaInterview_e7c8aee0:

    # oma "Entonces, ¿me llevas a casa?"
    oma "Bringst du mich also nach Hause?"

# game/scripts/c27/c27.rpy:3218
translate german c27s004_ScaInterview_8baab0ee:

    # mc "Sí, si estas dos van a seguir ignorándome no tiene ningún sentido que me quede. *Risa*"
    mc "Ja, wenn die beiden mich weiterhin ignorieren, hat es keinen Sinn, dass ich bleibe. *lacht*"

# game/scripts/c27/c27.rpy:3219
translate german c27s004_ScaInterview_f298e3b6:

    # oma "Tengo que pasar por mi apartamento a coger los pijamas para dejarlos en casa."
    oma "Ich muss in meine Wohnung fahren, um meinen Schlafanzug zu holen, den ich zu Hause lassen werde."

# game/scripts/c27/c27.rpy:3220
translate german c27s004_ScaInterview_0a1c3e79:

    # mc "¿También te vas a quedar a dormir hoy?"
    mc "Übernachtest du auch?"

# game/scripts/c27/c27.rpy:3222
translate german c27s004_ScaInterview_3444ddb5:

    # oma "No puedo. Empiezo mi turno a medianoche. Me iré después de cenar, pero así ya tendré los pijamas allí para el día que me pueda quedar."
    oma "Das geht nicht. Meine Schicht beginnt um Mitternacht. Ich gehe nach dem Abendessen, aber so habe ich meinen Schlafanzug für den Tag, an dem ich bleiben kann."

# game/scripts/c27/c27.rpy:3224
translate german c27s004_ScaInterview_c77fdd8c:

    # oma "*Risa* ¡[sai] no tiene pijamas! Y no estoy acostumbrada a dormir en camisón."
    oma "*Lacht* [sai] Sie hat keinen Schlafanzug! Und ich bin es nicht gewohnt, in einem Nachthemd zu schlafen."

# game/scripts/c27/c27.rpy:3226
translate german c27s004_ScaInterview_dd92fb48:

    # mc "Pues te quedaba genial. Estabas super sexy."
    mc "Es stand dir ausgezeichnet. Du sahst super sexy aus."

# game/scripts/c27/c27.rpy:3228
translate german c27s004_ScaInterview_017f6902:

    # mc "Pues te quedaba muy bien."
    mc "Es stand dir ausgezeichnet."

# game/scripts/c27/c27.rpy:3229
translate german c27s004_ScaInterview_cbc8533a:

    # mc "Al menos te quedaba mejor de lo que le quedaba el pijama de [deb.nick] a [ama]."
    mc "Es sah an dir zumindest besser aus als der Pyjama von [deb.nick] an [ama]."

# game/scripts/c27/c27.rpy:3231
translate german c27s004_ScaInterview_bfc67aac:

    # "Te despides de [sca], [eil] y [eri] y emprendes el camino al apartamento de [oma]."
    "Du verabschiedest dich von [sca], [eil] und [eri] und beginnst deine Reise zu [oma]s Wohnung."

# game/scripts/c27/c27.rpy:3232
translate german c27s004_ScaInterview_2d46c0f1:

    # "Vive a dos calles y vais dando un paseo."
    "Er wohnt zwei Straßen weiter, man kann also zu Fuß gehen."

# game/scripts/c27/c27.rpy:3235
translate german c27s004_ScaInterview_c5432ede:

    # "Se te hace raro pasear cogido de la mano con [oma]. Maravillosamente raro."
    "Es fühlt sich seltsam an, Hand in Hand mit [oma] zu gehen. Wunderbar seltsam."

# game/scripts/c27/c27.rpy:3236
translate german c27s004_ScaInterview_ab172596:

    # "No habéis hecho muchas cosas de las que hacen las parejas normales. Nunca habéis paseado ni salido a cenar."
    "Ihr habt viele Dinge nicht getan, die normale Paare tun. Ihr seid nie spazieren gegangen oder essen gegangen."

# game/scripts/c27/c27.rpy:3237
translate german c27s004_ScaInterview_9a395341:

    # "Pero no por ello estás menos loco por ella. La normalidad está sobrevalorada."
    "Aber das macht dich nicht weniger verrückt nach ihr. Normalität wird überbewertet."

# game/scripts/c27/c27.rpy:3239
translate german c27s004_ScaInterview_6b0d3e09:

    # "Y vas a ver su apartamento por primera vez."
    "Und du wirst seine Wohnung zum ersten Mal sehen."

# game/scripts/c27/c27.rpy:3256
translate german c27s005_PaintBasement_b8c29d77:

    # "Mientras tanto, en el sótano..."
    "Unterdessen im Keller..."

# game/scripts/c27/c27.rpy:3257
translate german c27s005_PaintBasement_eb887920:

    # mom "Parece que hace años que pintamos la habitación de [sai]."
    mom "Es kommt mir vor, als wäre es schon Jahre her, seit wir [sai]s Zimmer gestrichen haben."

# game/scripts/c27/c27.rpy:3258
translate german c27s005_PaintBasement_ae49dea8:

    # nor "Tienes razón. Aunque parezca mentira, no ha pasado un mes todavía de aquello."
    nor "Du hast Recht. Ob du es glaubst oder nicht, es ist noch nicht einmal ein Monat her, seit das passiert ist."

# game/scripts/c27/c27.rpy:3259
translate german c27s005_PaintBasement_b4661f5d:

    # emm "Y aquel día estaba [mc] en vez de [kim]. Hoy no podremos humillarlo con una batalla de pintura."
    emm "Und an jenem Tag war es [mc] statt [kim]. Heute können wir ihn nicht mit einer Farbschlacht demütigen."

# game/scripts/c27/c27.rpy:3260
translate german c27s005_PaintBasement_6f1acaa2:

    # kim "¿Hicisteis una batalla de pintura?"
    kim "Hattet ihr eine Farbschlacht?"

# game/scripts/c27/c27.rpy:3262
translate german c27s005_PaintBasement_41cfb172:

    # mom "Ya sabes cómo va esto. *Risa* [mc] dijo algo que no le gustó a [emm] y [emm] le pegó con el rodillo."
    mom "Du kennst das ja. *lacht* [mc] hat etwas gesagt, was [emm] nicht gefallen hat, und [emm] hat ihn mit dem Nudelholz geschlagen."

# game/scripts/c27/c27.rpy:3263
translate german c27s005_PaintBasement_49686b65:

    # mom "Acabamos haciendo una batalla [emm] y yo contra [nor] y [mc]."
    mom "Am Ende kam es zu einem Kampf: [emm] und ich gegen [nor] und [mc]."

# game/scripts/c27/c27.rpy:3265
translate german c27s005_PaintBasement_0a696588:

    # kim "Me encanta cómo hacéis algo divertido de cualquier situación."
    kim "Ich liebe es, wie du aus jeder Situation etwas Lustiges machst."

# game/scripts/c27/c27.rpy:3267
translate german c27s005_PaintBasement_81cdea0f:

    # emm "No, [kim]. No es 'hacéis'. Ahora es 'hacemos'. Tienes que empezar a incluirte cuando hables de la familia."
    emm "Nein, [kim]. Es heißt nicht mehr „ihr alle“, sondern „wir alle“. Du musst anfangen, dich selbst mit einzubeziehen, wenn du über Familie sprichst."

# game/scripts/c27/c27.rpy:3268
translate german c27s005_PaintBasement_f988f88e:

    # emm "Por cierto, la batalla la ganamos nosotras como es normal."
    emm "Übrigens haben wir die Schlacht wie üblich gewonnen."

# game/scripts/c27/c27.rpy:3270
translate german c27s005_PaintBasement_503ff04b:

    # nor "*Risa* No estoy demasiado segura de que eso sea verdad."
    nor "*Lacht* Ich bin mir nicht so sicher, ob das stimmt."

# game/scripts/c27/c27.rpy:3272
translate german c27s005_PaintBasement_a6cc3943:

    # emm "¡Por supuesto que ganamos nosotras!"
    emm "Natürlich haben wir gewonnen!"

# game/scripts/c27/c27.rpy:3274
translate german c27s005_PaintBasement_33392f5a:

    # kim "¿A qué te refieres, [nor]?"
    kim "Was meinen Sie, [nor]?"

# game/scripts/c27/c27.rpy:3277
translate german c27s005_PaintBasement_fd412187:

    # nor "Perder aquella batalla de pintura fue el primer paso para que [mc] y yo acabáramos juntos."
    nor "Diese verlorene Farbschlacht war der erste Schritt dafür, dass [mc] und ich am Ende zusammenkamen."

# game/scripts/c27/c27.rpy:3279
translate german c27s005_PaintBasement_618fb198:

    # nor "Nos acabamos duchando juntos. Y no una ducha inocente como las que tomábamos cuando él era un niño."
    nor "Wir haben schließlich zusammen geduscht. Und nicht nur so eine harmlose Dusche, wie wir sie früher genommen haben, als er noch ein Kind war."

# game/scripts/c27/c27.rpy:3281
translate german c27s005_PaintBasement_3b59ea40:

    # emm "¿Qué? ¿Follasteis aquel día? ¿En la ducha?"
    emm "Was? Ihr hattet an dem Tag Sex? Unter der Dusche?"

# game/scripts/c27/c27.rpy:3283
translate german c27s005_PaintBasement_a2b1e979:

    # nor "*Risa* No, pero aún no sé cómo conseguimos parar a tiempo. Fue muy tórrido."
    nor "*Lacht* Nein, aber ich weiß immer noch nicht, wie wir es geschafft haben, rechtzeitig anzuhalten. Es war wirklich heiß."

# game/scripts/c27/c27.rpy:3285
translate german c27s005_PaintBasement_939f40b9:

    # nor "Estuve a punto de meterme en la ducha con él."
    nor "Ich wollte gerade mit ihm duschen gehen."

# game/scripts/c27/c27.rpy:3287
translate german c27s005_PaintBasement_c28db764:

    # emm "¿Qué? ¿Follasteis aquel día? ¿En el baño?"
    emm "Was? Ihr hattet an dem Tag Sex? Im Badezimmer?"

# game/scripts/c27/c27.rpy:3289
translate german c27s005_PaintBasement_7fb497eb:

    # nor "*Risa* No, no me dejó entrar en la ducha, pero no sé qué hubiera pasado si me hubiera dejado."
    nor "*Lacht* Nein, er hat mich nicht unter die Dusche gelassen, aber ich weiß nicht, was passiert wäre, wenn er es getan hätte."

# game/scripts/c27/c27.rpy:3291
translate german c27s005_PaintBasement_60baacae:

    # nor "Después de aquella batalla estaba buscando un sitio donde ducharme y quitarme la pintura. Encontré a [mc] en la ducha."
    nor "Nach dieser Schlacht suchte ich nach einer Möglichkeit zu duschen, um die Farbe abzuwaschen. Ich fand [mc] in der Dusche."

# game/scripts/c27/c27.rpy:3292
translate german c27s005_PaintBasement_cfb00f0c:

    # nor "¿Os acordáis del pestillo roto en el baño? Creo que fui la primera en verlo desnudo desde que volvió a casa."
    nor "Erinnerst du dich an den kaputten Türriegel im Badezimmer? Ich glaube, ich war die Erste, die ihn nackt gesehen hat, seit er nach Hause gekommen ist."

# game/scripts/c27/c27.rpy:3294
translate german c27s005_PaintBasement_b562ea2d:

    # emm "Nope. *Risita* Yo lo vi el día anterior, en la ducha del gimnasio."
    emm "Nein. *Kichert* Ich habe ihn am Tag zuvor in der Dusche des Fitnessstudios gesehen."

# game/scripts/c27/c27.rpy:3295
translate german c27s005_PaintBasement_185bf539:

    # emm "Y [sca] y [dap] un poco más tarde, en la piscina, mientras hacíamos una batalla de caballos."
    emm "Und [sca] und [dap] etwas später, im Pool, während wir ein Pferdegefecht veranstalteten."

# game/scripts/c27/c27.rpy:3297
translate german c27s005_PaintBasement_2a6ffe0e:

    # emm "Y [eri] ese mismo día, pero más tarde, también en la ducha del pestillo roto."
    emm "Und am selben Tag, aber später, auch unter der Dusche mit dem kaputten Riegel."

# game/scripts/c27/c27.rpy:3298
translate german c27s005_PaintBasement_3c88db8d:

    # emm "*Risa* Con lo que, como mínimo, fuiste la quinta, Tía [nor], dependiendo de si mi madre lo vio antes que tú."
    emm "*Lacht* Also, zumindest warst du die Fünfte, Tante [nor], je nachdem, ob meine Mutter es vor dir gesehen hat."

# game/scripts/c27/c27.rpy:3300
translate german c27s005_PaintBasement_c67edef3:

    # mom "*Risa* Yo el día de la batalla de pintura, pero por la noche."
    mom "*Lacht* Ich am Tag der Farbschlacht, aber nachts."

# game/scripts/c27/c27.rpy:3301
translate german c27s005_PaintBasement_18bd1ac0:

    # mom "Todas lo visteis desnudo antes que yo."
    mom "Ihr habt ihn alle nackt gesehen, bevor ich es tat."

# game/scripts/c27/c27.rpy:3303
translate german c27s005_PaintBasement_4d0d3242:

    # kim "*Risa* Parece uno de esos juegos a los que juega [deb.nick]."
    kim "*Lacht* Es sieht aus wie eines dieser Spiele, die [deb.nick] spielt."

# game/scripts/c27/c27.rpy:3305
translate german c27s005_PaintBasement_e5faa4e4:

    # nor "La verdad es que pasaron cosas realmente extrañas en aquellos días después de la llegada de [mc]."
    nor "Tatsächlich geschahen in jenen Tagen nach der Ankunft von [mc] wirklich seltsame Dinge."

# game/scripts/c27/c27.rpy:3306
translate german c27s005_PaintBasement_ec19456d:

    # nor "La paliza que recibió de Jack, el ex-novio de [eri]... Aunque después se la devolviera..."
    nor "Die Prügel, die sie von Jack, dem Ex-Freund von [eri], einstecken musste... Obwohl sie sich später revanchierte..."

# game/scripts/c27/c27.rpy:3308
translate german c27s005_PaintBasement_a7bbd184:

    # mom "La fiesta de disfraces..."
    mom "Die Kostümparty..."

# game/scripts/c27/c27.rpy:3310
translate german c27s005_PaintBasement_c949951d:

    # emm "El juego de verdad o reto..."
    emm "Das Spiel Wahrheit oder Pflicht..."

# game/scripts/c27/c27.rpy:3312
translate german c27s005_PaintBasement_221b8344:

    # kim "Y después pasó lo más raro. *Risa* Llegamos nosotras."
    kim "Und dann passierte etwas total Seltsames. *lacht* Wir sind angekommen."

# game/scripts/c27/c27.rpy:3314
translate german c27s005_PaintBasement_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c27/c27.rpy:3315
translate german c27s005_PaintBasement_956292ce:

    # mom "Bueno, lo realmente raro fue la llegada de [sai]. *Risa* Nadie la esperaba."
    mom "Das wirklich Seltsame war die Ankunft von [sai]. *lacht* Niemand hatte sie erwartet."

# game/scripts/c27/c27.rpy:3316
translate german c27s005_PaintBasement_8b5d3123:

    # nor "*Risa* Bueno, todos la esperábamos, pero no esperábamos que fuera la novia de [mc] en Portland."
    nor "*Lacht* Nun ja, wir hatten sie alle erwartet, aber nicht, dass sie die Freundin von [mc] in Portland sein würde."

# game/scripts/c27/c27.rpy:3318
translate german c27s005_PaintBasement_23677926:

    # emm "Bueno, no era la novia exactamente, ¿no?"
    emm "Nun ja, sie war ja nicht gerade die Freundin, oder?"

# game/scripts/c27/c27.rpy:3319
translate german c27s005_PaintBasement_3e96ff03:

    # emm "Tenían una relación abierta y todo eso."
    emm "Sie führten eine offene Beziehung und so weiter."

# game/scripts/c27/c27.rpy:3321
translate german c27s005_PaintBasement_0bb922b6:

    # kim "A ver qué sorpresas nos deparan las chicas nuevas. Tengo ganas de conocerlas."
    kim "Mal sehen, welche Überraschungen die neuen Mädchen für uns bereithalten. Ich freue mich schon darauf, sie kennenzulernen."

# game/scripts/c27/c27.rpy:3322
translate german c27s005_PaintBasement_6a212ef5:

    # kim "Y también tengo ganas de saber si se integrarán en la familia igual que nosotras."
    kim "Und ich bin auch gespannt darauf, ob sie sich genauso gut in die Familie integrieren werden wie wir."

# game/scripts/c27/c27.rpy:3324
translate german c27s005_PaintBasement_20ebb414:

    # nor "He intercambiado algunos correos con ellas, y parecen buenas chicas."
    nor "Ich habe schon ein paar E-Mails mit ihnen ausgetauscht, und sie scheinen nette Mädchen zu sein."

# game/scripts/c27/c27.rpy:3325
translate german c27s005_PaintBasement_de3aa4eb:

    # nor "Pero hay uno de los correos que me ha sorprendido mucho. Espera que lo busco en el móvil."
    nor "Aber eine E-Mail hat mich wirklich überrascht. Ich suche sie mal auf meinem Handy."

# game/scripts/c27/c27.rpy:3327
translate german c27s005_PaintBasement_0a01fb8e:

    # emm "*Risa* ¿Ya son raras antes de llegar?"
    emm "*Gelächter* Sind die schon seltsam, bevor sie überhaupt ankommen?"

# game/scripts/c27/c27.rpy:3329
translate german c27s005_PaintBasement_0ccc548e:

    # mom "Ya sé a qué correo se refiere [nor]. Más que raro, es algo que nunca se nos hubiera ocurrido."
    mom "Ich weiß, auf welche E-Mail sich [nor] bezieht. Es ist mehr als nur seltsam; darauf wären wir nie gekommen."

# game/scripts/c27/c27.rpy:3331
translate german c27s005_PaintBasement_fafda3c4:

    # nor "Ya lo tengo. Os lo leo."
    nor "Ich hab's. Ich lese es dir vor."

# game/scripts/c27/c27.rpy:3332
translate german c27s005_PaintBasement_1a24ae6c:

    # nor "Querida Señora Marks,"
    nor "Sehr geehrte Frau Marks,"

# game/scripts/c27/c27.rpy:3333
translate german c27s005_PaintBasement_51d96265:

    # nor "Soy [kal], una de las estudiantes que se van a alojar en su casa a partir del mes que viene."
    nor "Ich bin [kal], eine der Schülerinnen, die ab dem nächsten Monat bei Ihnen wohnen werden."

# game/scripts/c27/c27.rpy:3334
translate german c27s005_PaintBasement_533665d4:

    # nor "Es mi primera experiencia viviendo en el extranjero y con chicas de otras culturas."
    nor "Dies ist meine erste Erfahrung im Ausland und mit Mädchen aus anderen Kulturen."

# game/scripts/c27/c27.rpy:3335
translate german c27s005_PaintBasement_776c3ca5:

    # nor "La universidad me ha informado de que todas las chicas somos de primer año, con lo que es posible que a ellas les pase lo mismo."
    nor "Die Universität hat mir mitgeteilt, dass es sich bei allen Mädchen um Studentinnen im ersten Studienjahr handelt, daher ist es möglich, dass ihnen dasselbe widerfährt."

# game/scripts/c27/c27.rpy:3337
translate german c27s005_PaintBasement_cf5f2e87:

    # nor "No lo de diferentes culturas, claro, ya que ellas, por lo que tengo entendido son americanas."
    nor "Nicht die unterschiedlichen Kulturen natürlich, da sie, soweit ich weiß, Amerikaner sind."

# game/scripts/c27/c27.rpy:3338
translate german c27s005_PaintBasement_e1317dcc:

    # nor "Para empezar a conocernos, ya que vamos a compartir habitaciones durante al menos un año, me gustaría proponerle una idea."
    nor "Um uns besser kennenzulernen, da wir mindestens ein Jahr lang zusammenwohnen werden, möchte ich einen Vorschlag machen."

# game/scripts/c27/c27.rpy:3339
translate german c27s005_PaintBasement_23e4f570:

    # nor "Si fuera posible, nos podríamos hacer una foto cada una, y así sabríamos qué aspecto tenemos."
    nor "Wenn es möglich wäre, könnten wir alle ein Foto machen, und so wüssten wir, wie wir aussehen."

# game/scripts/c27/c27.rpy:3340
translate german c27s005_PaintBasement_5db14712:

    # nor "Para hacerlo más divertido, me gustaría proponer que fuera el mismo día a la misma hora, si fuera posible."
    nor "Um das Ganze etwas unterhaltsamer zu gestalten, schlage ich vor, dass es, wenn möglich, am selben Tag und zur selben Uhrzeit stattfindet."

# game/scripts/c27/c27.rpy:3341
translate german c27s005_PaintBasement_c653ea79:

    # nor "Así sería como si estuviéramos juntas por primera vez, aunque nos separen muchos kilómetros de distancia."
    nor "Es wäre, als wären wir zum ersten Mal zusammen, obwohl uns viele Kilometer trennen."

# game/scripts/c27/c27.rpy:3343
translate german c27s005_PaintBasement_af1884bc:

    # nor "He estado pensando en las diferencias horarias, y creo que hacerlo a las 19:00 GMT del 4 de agosto estaría bien."
    nor "Ich habe über die Zeitunterschiede nachgedacht und denke, dass es in Ordnung wäre, es am 4. August um 19:00 Uhr GMT zu tun."

# game/scripts/c27/c27.rpy:3344
translate german c27s005_PaintBasement_7f844e8d:

    # nor "De esa forma, en Estados Unidos serían entre las 11:00 y las 14:00, y las chicas no tendrían que madrugar demasiado."
    nor "Auf diese Weise wäre es in den Vereinigten Staaten zwischen 11:00 und 14:00 Uhr, und die Mädchen müssten nicht zu früh aufstehen."

# game/scripts/c27/c27.rpy:3345
translate german c27s005_PaintBasement_6f1ccc27:

    # nor "Si le parece bien, por favor, reenvíe este correo a las chicas con las que compartiré casa."
    nor "Wenn du möchtest, leite diese E-Mail bitte an die Mädchen weiter, mit denen ich in einer WG wohnen werde."

# game/scripts/c27/c27.rpy:3346
translate german c27s005_PaintBasement_64b67f90:

    # nor "Se lo enviaría yo, pero la Universidad no ha querido darme sus correos electrónicos."
    nor "Ich würde es ihnen schicken, aber die Universität weigert sich, mir ihre E-Mail-Adressen zu geben."

# game/scripts/c27/c27.rpy:3347
translate german c27s005_PaintBasement_2b5dedf8:

    # nor "Después, cada una de las que acepten hacerse la foto podemos enviárselas a usted para que nos las reenvíe al resto."
    nor "Dann können wir Ihnen die Fotos von jeder Person, die sich fotografieren lässt, zusenden, damit Sie sie an uns alle weiterleiten können."

# game/scripts/c27/c27.rpy:3349
translate german c27s005_PaintBasement_c80e7c9d:

    # nor "Estoy muy emocionada por conocerla a usted y a su familia. Mi prima me ha contado cosas alucinantes."
    nor "Ich freue mich riesig darauf, dich und deine Familie kennenzulernen. Meine Cousine hat mir so viel Tolles erzählt."

# game/scripts/c27/c27.rpy:3350
translate german c27s005_PaintBasement_19ad2b08:

    # nor "Gracias por todo por adelantado,"
    nor "Vielen Dank im Voraus für alles."

# game/scripts/c27/c27.rpy:3351
translate german c27s005_PaintBasement_2ff14579:

    # nor "[kal] Singh"
    nor "[kal] Singh"

# game/scripts/c27/c27.rpy:3352
translate german c27s005_PaintBasement_ef8ca24f:

    # nor "Hace días que lo recibí y se lo mandé al resto de las chicas. El 4 de agosto es mañana. A ver cuántas responden."
    nor "Ich habe es vor ein paar Tagen erhalten und an die anderen Mädchen weitergeleitet. Morgen ist der 4. August. Mal sehen, wie viele antworten."

# game/scripts/c27/c27.rpy:3354
translate german c27s005_PaintBasement_3085eb00:

    # kim "¿[kal]? Esa es la prima de [sai]."
    kim "[kal]? Das ist die Primzahl von [sai]."

# game/scripts/c27/c27.rpy:3355
translate german c27s005_PaintBasement_21bc27ff:

    # kim "Me hubiera gustado que la idea se nos hubiera ocurrido a nosotras antes de venir."
    kim "Ich wünschte, wir wären vor unserer Ankunft hierher auf diese Idee gekommen."

# game/scripts/c27/c27.rpy:3356
translate german c27s005_PaintBasement_c04a8f0e:

    # kim "Aunque hubiera venido acojonada. [kat], [lis], [deb.nick], y [sai] son guapísimas..." id c27s005_PaintBasement_c04a8f0e
    kim "Obwohl ich voller Angst gekommen war. [kat], [lis], [deb.nick] und [sai] sind wunderschön..." id c27s005_PaintBasement_c04a8f0e

# game/scripts/c27/c27.rpy:3358
translate german c27s005_PaintBasement_5ddd31e5:

    # emm "*Risa* Claro, como tú eres la prima fea de Quasimodo te tendrías que preocupar por cómo son las demás."
    emm "*Lacht* Na klar, da du Quasimodos hässlicher Cousin bist, solltest du dir Sorgen darüber machen, wie alle anderen aussehen."

# game/scripts/c27/c27.rpy:3360
translate german c27s005_PaintBasement_bdd0c787:

    # mom "La belleza es subjetiva, [emm]. Puede que yo te vea muy guapa y que para otras chicas parezcas un orco..."
    mom "Schönheit liegt im Auge des Betrachters. Ich finde dich vielleicht wunderschön, aber andere Mädchen halten dich vielleicht für einen Oger..."

# game/scripts/c27/c27.rpy:3362
translate german c27s005_PaintBasement_f9b92aa1:

    # emm "¿Qué? ¿Un orco? ¿Yo?"
    emm "Was? Ein Ork? Ich?"

# game/scripts/c27/c27.rpy:3364
translate german c27s005_PaintBasement_80f9105c:

    # nor "*Risa* Uno orco rosa. Cambiarías la armadura por un vestidito mono... y rosa."
    nor "*Lacht* Ein rosa Ork. Du würdest die Rüstung gegen ein süßes kleines Kleidchen tauschen... und zwar in Rosa."

# game/scripts/c27/c27.rpy:3366
translate german c27s005_PaintBasement_b3b94564_1:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c27/c27.rpy:3367
translate german c27s005_PaintBasement_1f8e7881:

    # emm "*Risa* A veces os odio. Por suerte, soy la que tiene el mejor gusto para los colores en casa."
    emm "*lacht* Manchmal hasse ich euch. Zum Glück habe ich zu Hause den besten Farbgeschmack."

# game/scripts/c27/c27.rpy:3368
translate german c27s005_PaintBasement_15a2fed2:

    # emm "[kim] me cayó bien el día que llegó con aquel vestido rosa. ¿Os acordáis?"
    emm "[kim] Ich mochte sie schon an dem Tag, als sie in diesem rosa Kleid ankam. Erinnerst du dich?"

# game/scripts/c27/c27.rpy:3369
translate german c27s005_PaintBasement_8a54ed4a:

    # mom "Me encanta cómo le quedaba aquel vestido, pero no se lo he vuelto a ver puesto."
    mom "Ich fand, das Kleid sah an ihr toll aus, aber ich habe sie es seitdem nicht mehr tragen sehen."

# game/scripts/c27/c27.rpy:3370
translate german c27s005_PaintBasement_d646a85f:

    # kim "*Risa* No quiero que [emm] me lo robe. Aunque se lo puedo prestar un día."
    kim "*Lacht* Ich will nicht, dass [emm] es stiehlt. Obwohl ich es ihm für einen Tag leihen kann."

# game/scripts/c27/c27.rpy:3371
translate german c27s005_PaintBasement_13327ac7:

    # nor "*Risa* ¡No alimentes al orco!"
    nor "*Gelächter* Füttert den Ork nicht!"

# game/scripts/c27/c27.rpy:3372
translate german c27s005_PaintBasement_b3b94564_2:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c27/c27.rpy:3373
translate german c27s005_PaintBasement_2f46c808:

    # emm "*Risa* Cada vez os odio más veces."
    emm "*Lacht* Ich hasse dich jedes Mal mehr und mehr."

# game/scripts/c27/c27.rpy:3375
translate german c27s005_PaintBasement_8084dbd9:

    # emm "Cambiando de tema y hablando de otras chicas, aunque me consideren un orco. ¿Puedo hacerte una pregunta personal, Tía [nor]?"
    emm "Ich wechsle das Thema und rede über andere Mädchen, auch wenn die mich vielleicht für ein Ungeheuer halten. Darf ich dir eine persönliche Frage stellen, Tante [nor]?"

# game/scripts/c27/c27.rpy:3377
translate german c27s005_PaintBasement_462da680:

    # nor "Claro, cielo, pregunta lo que quieras saber. Ya sabes que lo de tener secretos se nos ha dado mal."
    nor "Natürlich, Liebling, frag ruhig alles, was du wissen willst. Du weißt ja, dass wir nicht gut im Geheimnissebewahren sind."

# game/scripts/c27/c27.rpy:3379
translate german c27s005_PaintBasement_f02d297e:

    # emm "A ver... no es que tenga dudas, pero como tú eres más... lanzada... que mi madre..."
    emm "Nun ja... nicht, dass ich Zweifel hätte, aber da du... direkter bist... als meine Mutter..."

# game/scripts/c27/c27.rpy:3380
translate german c27s005_PaintBasement_be4b2e4b:

    # emm "¿Alguna vez has tenido alguna experiencia con alguna chica?"
    emm "Hast du jemals Erfahrungen mit einem Mädchen gemacht?"

# game/scripts/c27/c27.rpy:3382
translate german c27s005_PaintBasement_de940220:

    # nor "*Risa* ¡Eso sí que es un cambio de tema!"
    nor "*lacht* Das ist ja mal ein Themenwechsel!"

# game/scripts/c27/c27.rpy:3384
translate german c27s005_PaintBasement_9ad01b51:

    # nor "Pero sí. Tres veces, una en la universidad y otra poco después de acabar."
    nor "Ja, tatsächlich. Dreimal, einmal an der Universität und einmal kurz nach dem Studienabschluss."

# game/scripts/c27/c27.rpy:3385
translate german c27s005_PaintBasement_2d5d8d0b:

    # nor "{i}(Espero que no se den cuenta de que falta una. No sé si [eri] querría que les dijera lo que pasó en la piscina.){/i}"
    nor "{i}(Hoffentlich bemerken sie nicht, dass einer fehlt. Ich weiß nicht, ob [eri] möchte, dass ich ihnen erzähle, was am Pool passiert ist.){/i}"

# game/scripts/c27/c27.rpy:3387
translate german c27s005_PaintBasement_b4f9bad9:

    # nor "Pero sí. Dos veces, una en la universidad y otra poco después de acabar."
    nor "Ja, tatsächlich. Zweimal, einmal an der Universität und einmal kurz nach dem Studienabschluss."

# game/scripts/c27/c27.rpy:3389
translate german c27s005_PaintBasement_3028d3df:

    # kim "¿Y cómo fue? ¿Tenías dudas sobre tu sexualidad?"
    kim "Und wie war es? Hattest du Zweifel an deiner Sexualität?"

# game/scripts/c27/c27.rpy:3391
translate german c27s005_PaintBasement_c51aad71:

    # nor "No, cielo, nunca he tenido dudas, pero quería experimentar."
    nor "Nein, Schatz, ich hatte nie Zweifel, aber ich wollte es ausprobieren."

# game/scripts/c27/c27.rpy:3392
translate german c27s005_PaintBasement_5ea5d3ad:

    # nor "La primera vez no me gustó. La segunda fue mucho mejor."
    nor "Beim ersten Mal hat es mir nicht gefallen. Beim zweiten Mal war es viel besser."

# game/scripts/c27/c27.rpy:3394
translate german c27s005_PaintBasement_d288c764:

    # emm "¡Me sorprendes mucho, Tía [nor]! Pensaba que podías haber probado, pero no repetido si no te gustó la primera vez."
    emm "Du überraschst mich wirklich, Tante [nor]! Ich dachte, du könntest es versuchen, aber es nicht wiederholen, wenn es dir beim ersten Mal nicht gefallen hat."

# game/scripts/c27/c27.rpy:3396
translate german c27s005_PaintBasement_f7c6d72b:

    # nor "Bueno, la segunda vez fue con una persona especial. No especial en cuanto a que sintiera algo por ella, pero... especial."
    nor "Nun ja, das zweite Mal war mit jemand Besonderem. Nicht besonders in dem Sinne, dass ich Gefühle für sie hatte, sondern... besonders."

# game/scripts/c27/c27.rpy:3397
translate german c27s005_PaintBasement_9228143d:

    # nor "Pero, ¿por qué lo preguntas?"
    nor "Aber warum fragst du?"

# game/scripts/c27/c27.rpy:3401
translate german c27s005_PaintBasement_d9df3ce6:

    # emm "Por nada especial. Me he sentido tentada de experimentar en un par de ocasiones."
    emm "Ohne besonderen Grund. Ich war schon ein paar Mal in Versuchung, es auszuprobieren."

# game/scripts/c27/c27.rpy:3403
translate german c27s005_PaintBasement_d9df3ce6_1:

    # emm "Por nada especial. Me he sentido tentada de experimentar en un par de ocasiones."
    emm "Ohne besonderen Grund. Ich war schon ein paar Mal in Versuchung, es auszuprobieren."

# game/scripts/c27/c27.rpy:3405
translate german c27s005_PaintBasement_35c6e3f7:

    # emm "Por nada especial. Después de lo de los saludos con besos, me sentí tentada de experimentar."
    emm "Ohne besonderen Grund. Nach der ganzen Begrüßungssache mit Küssen hatte ich Lust, etwas Neues auszuprobieren."

# game/scripts/c27/c27.rpy:3407
translate german c27s005_PaintBasement_857534b9:

    # emm "Por nada especial. Cuando lo de los saludos con besos, pensé que experimentar podría estar bien. Después se me pasó."
    emm "Ohne besonderen Grund. Als diese ganze Sache mit den Begrüßungsküssen anfing, dachte ich, es wäre okay, mal damit zu experimentieren. Dann habe ich es aber wieder gelassen."

# game/scripts/c27/c27.rpy:3409
translate german c27s005_PaintBasement_e14abd5d:

    # kim "¿Y tú, [mar]? ¿Alguna experiencia?"
    kim "Und du, [mar]? Irgendwelche Erfahrungen?"

# game/scripts/c27/c27.rpy:3411
translate german c27s005_PaintBasement_989fa86b:

    # mom "*Risa* Según [emm] no soy lo suficientemente lanzada para probarlo."
    mom "*Lacht* Laut [emm] bin ich nicht mutig genug, es zu versuchen."

# game/scripts/c27/c27.rpy:3413
translate german c27s005_PaintBasement_8120f84d:

    # emm "¡Mamá! Lo he dicho porque le pega más a Tía [nor]."
    emm "Mama! Ich habe es gesagt, weil es besser zu Tante [nor] passt."

# game/scripts/c27/c27.rpy:3415
translate german c27s005_PaintBasement_e82d9990:

    # mom "Bueno, pues sí. Una vez en la universidad..."
    mom "Ja, schon. Sobald ich an der Universität war..."

# game/scripts/c27/c27.rpy:3417
translate german c27s005_PaintBasement_0ceb94f2:

    # emm "¿Qué?"
    emm "Das?"

# game/scripts/c27/c27.rpy:3420
translate german c27s005_PaintBasement_280a82f0:

    # mom "Poco después de que tu tía acabara la universidad."
    mom "Kurz nachdem deine Tante ihr Studium abgeschlossen hatte."

# game/scripts/c27/c27.rpy:3422
translate german c27s005_PaintBasement_43ced4d4:

    # emm "¿QUÉ?" (multiple=2)
    emm "DAS?" (multiple=2)

# game/scripts/c27/c27.rpy:3423
translate german c27s005_PaintBasement_e6800f64:

    # kim "¿Vosotras dos?" (multiple=2)
    kim "Ihr zwei?" (multiple=2)

# game/scripts/c27/c27.rpy:3425
translate german c27s005_PaintBasement_dac0c039:

    # mom "*Risa*" (multiple=2)
    mom "*Lachen*" (multiple=2)

# game/scripts/c27/c27.rpy:3426
translate german c27s005_PaintBasement_12a0453c:

    # nor "*Risa*" (multiple=2)
    nor "*Lachen*" (multiple=2)

# game/scripts/c27/c27.rpy:3427
translate german c27s005_PaintBasement_d5803862:

    # mom "Creo que deberíamos empezar a pintar o se va a hacer tarde."
    mom "Ich denke, wir sollten mit dem Streichen anfangen, sonst wird es zu spät."

# game/scripts/c27/c27.rpy:3428
translate german c27s005_PaintBasement_cba98c67:

    # nor "Yo también creo lo mismo."
    nor "Ich denke genauso."

# game/scripts/c27/c27.rpy:3430
translate german c27s005_PaintBasement_c7ec6c81:

    # emm "¡No es justo! ¡Ahora quiero saber más!"
    emm "Das ist nicht fair! Jetzt möchte ich mehr wissen!"

# game/scripts/c27/c27.rpy:3432
translate german c27s005_PaintBasement_c9b588f5:

    # mom "Yo creía que querías tener un estudio de fotografía."
    mom "Ich dachte, Sie wollten ein Fotostudio eröffnen."

# game/scripts/c27/c27.rpy:3433
translate german c27s005_PaintBasement_bb7a4767:

    # nor "Si no empezamos a pintar, no lo podrás tener montado para el fin de semana."
    nor "Wenn wir nicht mit dem Streichen anfangen, schaffen Sie es nicht, es bis zum Wochenende zusammenzubauen."

# game/scripts/c27/c27.rpy:3436
translate german c27s005_PaintBasement_c37315aa:

    # mom "No me gustó y no volví a repetir mientras estaba en la universidad."
    mom "Es hat mir nicht gefallen, und ich habe es während meiner Studienzeit nicht wiederholt."

# game/scripts/c27/c27.rpy:3437
translate german c27s005_PaintBasement_17a567f2:

    # mom "Quizás es porque estábamos experimentando y no sentíamos nada la una por la otra..."
    mom "Vielleicht lag es daran, dass wir experimentierten und keine Gefühle füreinander hatten..."

# game/scripts/c27/c27.rpy:3439
translate german c27s005_PaintBasement_b3f8cbfd:

    # emm "Me acabas de dejar sorprendida. No creía que hubieras probado algo así."
    emm "Du hast mich gerade überrascht. Ich hätte nicht gedacht, dass du so etwas versucht hättest."

# game/scripts/c27/c27.rpy:3440
translate german c27s005_PaintBasement_76646c41:

    # kim "Yo también estoy sorprendida. No porque lo probaras, sino porque lo probaras con alguien por quién no sintieras nada."
    kim "Ich bin auch überrascht. Nicht weil du es versucht hast, sondern weil du es mit jemandem versucht hast, für den du keine Gefühle hattest."

# game/scripts/c27/c27.rpy:3442
translate german c27s005_PaintBasement_239aacbc:

    # mom "La universidad es un momento para experimentar. Yo no pensaba demasiado en esas cosas todavía."
    mom "Das Studium ist eine Zeit zum Experimentieren. Ich habe mir über diese Dinge noch nicht allzu viele Gedanken gemacht."

# game/scripts/c27/c27.rpy:3443
translate german c27s005_PaintBasement_ae2b3a6d:

    # mom "A día de hoy no lo haría con nadie por quién no sintiera algo."
    mom "Heute würde ich das mit niemandem mehr tun, für den ich keine Gefühle hätte."

# game/scripts/c27/c27.rpy:3445
translate german c27s005_PaintBasement_99ab8c4a:

    # mom "Pero creo que deberíamos empezar a pintar o no vamos a acabar nunca."
    mom "Aber ich denke, wir sollten mit dem Malen anfangen, sonst werden wir nie fertig."

# game/scripts/c27/c27.rpy:3446
translate german c27s005_PaintBasement_196942a8:

    # nor "Estoy de acuerdo. Así estará seco para el fin de semana y [emm] podrá montar el estudio de fotografía."
    nor "Ich stimme zu. So ist es bis zum Wochenende trocken und ich kann das Fotostudio aufbauen."

# game/scripts/c27/c27.rpy:3448
translate german c27s005_PaintBasement_99b0cb63:

    # emm "Vale, pero no es justo. Sabéis que voy a seguir preguntando por eso."
    emm "Okay, aber das ist nicht fair. Du weißt, dass ich immer wieder danach fragen werde."

# game/scripts/c27/c27.rpy:3451
translate german c27s005_PaintBasement_b3b94564_3:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c27/c27.rpy:3459
translate german c27s006_OmaHouse_8c39eab6:

    # "En el apartamento de [oma]..."
    "In der Wohnung von [oma]..."

# game/scripts/c27/c27.rpy:3460
translate german c27s006_OmaHouse_d412e958:

    # oma "Pues este es mi pasillo. Casi no se puede considerar un apartamento."
    oma "Nun ja, das ist mein Flur. Man kann es kaum eine Wohnung nennen."

# game/scripts/c27/c27.rpy:3461
translate german c27s006_OmaHouse_5280379f:

    # oma "*Risa* Un pasillo con puertas a un lado."
    oma "*Gelächter* Ein Flur mit Türen auf einer Seite."

# game/scripts/c27/c27.rpy:3462
translate german c27s006_OmaHouse_cc59f643:

    # mc "*Risa* Pero es un pasillo muy bien arreglado para una persona."
    mc "*Gelächter* Aber für eine Person ist es ein sehr gut eingerichteter Flur."

# game/scripts/c27/c27.rpy:3464
translate german c27s006_OmaHouse_6addfb14:

    # oma "*Risa* El mayor problema es que puedo recordar y oler lo que cociné hace tres días cuando estoy viendo la tele."
    oma "*Lacht* Das größte Problem ist, dass ich mich beim Fernsehen daran erinnern und riechen kann, was ich vor drei Tagen gekocht habe."

# game/scripts/c27/c27.rpy:3465
translate german c27s006_OmaHouse_3b603823:

    # oma "No hay forma de que la campana se lleve todos los olores antes de que lleguen al sofá."
    oma "Es ist unmöglich, dass die Dunstabzugshaube alle Gerüche beseitigt, bevor sie das Sofa erreichen."

# game/scripts/c27/c27.rpy:3466
translate german c27s006_OmaHouse_c99670bb:

    # mc "Si lo que cocinas está bueno..."
    mc "Wenn das, was du kochst, gut ist..."

# game/scripts/c27/c27.rpy:3468
translate german c27s006_OmaHouse_4591f911:

    # oma "No. Por muy bueno que esté, no quiero olerlo tres días después. Y abrir las ventanas no sirve de mucho."
    oma "Nein. Egal wie gut es schmeckt, ich möchte es drei Tage später nicht mehr riechen. Und das Öffnen der Fenster hilft auch nicht viel."

# game/scripts/c27/c27.rpy:3469
translate german c27s006_OmaHouse_d016f00b:

    # oma "Dan a un patio interior y entonces entran los olores de lo que cocinan los vecinos."
    oma "Sie blicken auf einen Innenhof, und dann dringen die Gerüche von dem herein, was die Nachbarn kochen."

# game/scripts/c27/c27.rpy:3470
translate german c27s006_OmaHouse_8e4da8c2:

    # mc "*Risa* Se pueden dar combinaciones horribles entonces."
    mc "*Gelächter* Dann sind ja schreckliche Kombinationen möglich."

# game/scripts/c27/c27.rpy:3472
translate german c27s006_OmaHouse_62a6b4a3:

    # oma "Ven a mi habitación, te la enseño antes de coger los pijamas."
    oma "Komm in mein Zimmer, ich zeig's dir, bevor ich meinen Schlafanzug anziehe."

# game/scripts/c27/c27.rpy:3473
translate german c27s006_OmaHouse_ddbb2b57:

    # mc "*Risa* ¿Has hecho la cama?"
    mc "*lacht* Hast du das Bett gemacht?"

# game/scripts/c27/c27.rpy:3474
translate german c27s006_OmaHouse_0d321078:

    # oma "No dormí aquí anoche, con lo que no era necesario. Pero la hago siempre que me levanto."
    oma "Ich habe letzte Nacht nicht hier geschlafen, daher war es nicht nötig. Aber ich mache es jedes Mal, wenn ich aufstehe."

# game/scripts/c27/c27.rpy:3476
translate german c27s006_OmaHouse_c9d0cc38:

    # oma "Pues esta es mi habitación. No es gran cosa pero suficiente para mí."
    oma "Nun ja, das ist mein Zimmer. Es ist nichts Besonderes, aber es reicht mir."

# game/scripts/c27/c27.rpy:3477
translate german c27s006_OmaHouse_3ca2575e:

    # oma "Al otro lado de esa pared está la habitación de invitados y detrás de ésta, el baño que también sirve de sala de la colada."
    oma "Auf der anderen Seite dieser Wand befindet sich das Gästezimmer und dahinter das Badezimmer, das gleichzeitig als Waschküche dient."

# game/scripts/c27/c27.rpy:3478
translate german c27s006_OmaHouse_9105bad6:

    # mc "Me gustan los cuadros."
    mc "Ich mag Gemälde."

# game/scripts/c27/c27.rpy:3480
translate german c27s006_OmaHouse_6697c725:

    # mc "Y ese póster de reclutamiento."
    mc "Und dieses Rekrutierungsplakat."

# game/scripts/c27/c27.rpy:3481
translate german c27s006_OmaHouse_cc3253ed:

    # oma "*Risa* A ti lo que te gusta es la chica."
    oma "*Lacht* Was dir gefällt, ist das Mädchen."

# game/scripts/c27/c27.rpy:3482
translate german c27s006_OmaHouse_6835d88e:

    # mc "Es mona."
    mc "Sie ist süß."

# game/scripts/c27/c27.rpy:3484
translate german c27s006_OmaHouse_57b8be37:

    # oma "Es el poster de reclutamiento que veía por todos lados cuando era adolescente."
    oma "Das ist das Rekrutierungsplakat, das ich als Teenager überall gesehen habe."

# game/scripts/c27/c27.rpy:3485
translate german c27s006_OmaHouse_a6e51f62:

    # oma "Ver a una Latina tan mona con el uniforme me ayudó a cambiar mi idea sobre ser abogada. No es que me compare con ella, claro."
    oma "Der Anblick dieser hübschen Latina in Uniform hat meine Sichtweise auf den Anwaltsberuf verändert. Nicht, dass ich mich mit ihr vergleichen würde, natürlich nicht."

# game/scripts/c27/c27.rpy:3487
translate german c27s006_OmaHouse_45f56c03:

    # oma "Cuando vino a mi instituto a una de esas charlas que da la policía de vez en cuando, la idea ya estaba en mi cabeza y le pedí uno de los posters."
    oma "Als er für einen dieser Vorträge, die die Polizei von Zeit zu Zeit hält, an meine Schule kam, hatte ich die Idee bereits im Kopf und bat ihn um eines der Plakate."

# game/scripts/c27/c27.rpy:3488
translate german c27s006_OmaHouse_169c5cf5:

    # oma "Su charla y las explicaciones que dio sobre cómo podía ayudar al vecindario me acabó de convencer."
    oma "Seine Rede und seine Erklärungen darüber, wie er der Nachbarschaft helfen könne, haben mich schließlich überzeugt."

# game/scripts/c27/c27.rpy:3489
translate german c27s006_OmaHouse_975f8d96:

    # mc "Siempre pensé que la gente de esos carteles eran modelos."
    mc "Ich dachte immer, die Leute auf diesen Plakaten wären Models."

# game/scripts/c27/c27.rpy:3491
translate german c27s006_OmaHouse_5b93f3fa:

    # oma "No en el caso de Esperanza. Ella es... o era... una patrullera, pero la escogieron para la campaña de reclutamiento y de relaciones públicas."
    oma "Nicht so im Fall von Esperanza. Sie ist... oder war... eine Streifenpolizistin, wurde aber für die Rekrutierungs- und Öffentlichkeitskampagne ausgewählt."

# game/scripts/c27/c27.rpy:3492
translate german c27s006_OmaHouse_50086073:

    # mc "¿Has dicho 'era'...?"
    mc "Hast du „war“ gesagt...?"

# game/scripts/c27/c27.rpy:3494
translate german c27s006_OmaHouse_63f4c0a2:

    # oma "¡Oh, no! No me refiero a que haya muerto. *Risa* Me refería a que hace años de eso y a lo mejor ya es detective o sargento."
    oma "Oh nein! Ich meine nicht, dass er tot ist. *lacht* Ich meinte, dass es schon Jahre her ist; das Beste an ihm ist, dass er Detektiv oder Sergeant ist."

# game/scripts/c27/c27.rpy:3495
translate german c27s006_OmaHouse_0f7784d4:

    # mc "*Risa triste* Menos mal. Por un momento había pensado que..."
    mc "*Trauriges Lachen* Gott sei Dank. Einen Moment lang dachte ich, dass..."

# game/scripts/c27/c27.rpy:3497
translate german c27s006_OmaHouse_01a7133e:

    # oma "Lo entiendo. Cada vez que sale alguna noticia de un policía que ha muerto en acto de servicio en cualquier parte del país mi madre me llama."
    oma "Ich verstehe das. Jedes Mal, wenn in den Nachrichten von einem Polizisten die Rede ist, der irgendwo im Land im Dienst ums Leben gekommen ist, ruft mich meine Mutter an."

# game/scripts/c27/c27.rpy:3498
translate german c27s006_OmaHouse_d6fea21b:

    # oma "Hablamos todas las semanas por teléfono, pero cuando ve algo así en las noticias hace una video conferencia."
    oma "Wir telefonieren jede Woche miteinander, aber wenn er so etwas in den Nachrichten sieht, macht er eine Videokonferenz."

# game/scripts/c27/c27.rpy:3499
translate german c27s006_OmaHouse_fe7a2701:

    # mc "Quiere asegurarse de que estés bien. Y quiere verlo con sus propios ojos."
    mc "Er möchte sichergehen, dass es dir gut geht. Und er möchte es mit eigenen Augen sehen."

# game/scripts/c27/c27.rpy:3501
translate german c27s006_OmaHouse_bbc76ed2:

    # oma "Es exactamente eso, aunque ella no se dé cuenta. Da lo mismo si hemos hablado hoy. Si mañana muere un agente en Florida, mi madre hará una video llamada."
    oma "Genau das ist es, auch wenn sie es nicht merkt. Es spielt keine Rolle, ob wir heute miteinander gesprochen haben. Wenn morgen ein Agent in Florida stirbt, wird meine Mutter einen Videoanruf tätigen."

# game/scripts/c27/c27.rpy:3502
translate german c27s006_OmaHouse_fc49d380:

    # mc "Es normal. Yo también lo haría. Es más, yo haría video conferencias en cada llamada."
    mc "Das ist normal. Ich würde es genauso machen. Tatsächlich würde ich für jeden Anruf Videokonferenzen nutzen."

# game/scripts/c27/c27.rpy:3503
translate german c27s006_OmaHouse_dc521bb9:

    # mc "Creo que me voy a pasar el día pegado a la cámara cuando esté en Aruba."
    mc "Ich glaube, ich werde den ganzen Tag vor der Kamera verbringen, wenn ich in Aruba bin."

# game/scripts/c27/c27.rpy:3505
translate german c27s006_OmaHouse_4b1692cc:

    # oma "Te vamos a echar mucho de menos."
    oma "Wir werden dich sehr vermissen."

# game/scripts/c27/c27.rpy:3506
translate german c27s006_OmaHouse_3c28c0bd:

    # mc "Y yo a vosotras. Va a ser raro estar tanto tiempo separados."
    mc "Und mir geht es genauso mit dir. Es wird seltsam sein, so lange getrennt zu sein."

# game/scripts/c27/c27.rpy:3509
translate german c27s006_OmaHouse_26c2ab2a:

    # oma "Por suerte, aún quedan días para que te vayas."
    oma "Zum Glück sind es noch ein paar Tage bis zu Ihrer Abreise."

# game/scripts/c27/c27.rpy:3510
translate german c27s006_OmaHouse_cd0aac55:

    # oma "Déjame coger los pijamas y el uniforme y vamos a casa."
    oma "Ich hole schnell meinen Schlafanzug und meine Uniform, dann fahren wir nach Hause."

# game/scripts/c27/c27.rpy:3511
translate german c27s006_OmaHouse_52721442:

    # mc "Voy a cotillear tu piso un poco más y te espero al final del pasillo, en eso que llamas salón."
    mc "Ich werde mich noch ein bisschen in deiner Wohnung vergnügen und warte am Ende des Flurs auf dich, in dem, was du Wohnzimmer nennst."

# game/scripts/c27/c27.rpy:3516
translate german c27s006_OmaHouse_bb0c65a1:

    # mc "Aunque puedes venir a verme cuando quieras o cuando puedas."
    mc "Obwohl Sie mich jederzeit besuchen können, wann immer Sie wollen oder können."

# game/scripts/c27/c27.rpy:3517
translate german c27s006_OmaHouse_2262068a:

    # oma "Lo he pensado. Este año aún me quedan dos semanas de vacaciones."
    oma "Ich habe darüber nachgedacht. Ich habe dieses Jahr noch zwei Wochen Urlaub."

# game/scripts/c27/c27.rpy:3518
translate german c27s006_OmaHouse_70a6390e:

    # mc "Pues espero que vengas a Aruba a verme, al menos parte de esas dos semanas."
    mc "Nun, ich hoffe, du kommst nach Aruba, um mich zu besuchen, zumindest für einen Teil dieser zwei Wochen."

# game/scripts/c27/c27.rpy:3520
translate german c27s006_OmaHouse_37cf521c:

    # oma "Déjame coger una cosa en el baño. Espérame aquí."
    oma "Ich hole schnell etwas aus dem Badezimmer. Warte hier."

# game/scripts/c27/c27.rpy:3521
translate german c27s006_OmaHouse_9bbfd447:

    # mc "OK. ¿Tienes el uniforme y los pijamas en el baño?"
    mc "Okay. Hast du deine Uniform und deinen Schlafanzug im Badezimmer?"

# game/scripts/c27/c27.rpy:3523
translate german c27s006_OmaHouse_d08669e4:

    # oma "Ya te he dicho que también era la sala de lavandería. No tardo."
    oma "Ich hatte dir ja schon gesagt, dass es auch die Waschküche ist. Ich bin gleich wieder da."

# game/scripts/c27/c27.rpy:3531
translate german c27s006_OmaHouse_c39ffd4d:

    # oma "Ya estoy lista."
    oma "Ich bin bereit."

# game/scripts/c27/c27.rpy:3536
translate german c27s006_ColombiaPics_83c5e73e:

    # mc "¿Los cuadros son de Colombia?"
    mc "Stammen die Gemälde aus Kolumbien?"

# game/scripts/c27/c27.rpy:3537
translate german c27s006_ColombiaPics_03b11b44:

    # oma "*Desde el baño* Sí, me los regaló mi abuelo. No me gustan, pero me recuerdan a él, con lo que no quiero quitarlos."
    oma "*Aus dem Badezimmer* Ja, mein Großvater hat sie mir geschenkt. Ich mag sie nicht, aber sie erinnern mich an ihn, deshalb möchte ich sie nicht ausziehen."

# game/scripts/c27/c27.rpy:3538
translate german c27s006_ColombiaPics_7c91e6b4:

    # mc "Te entiendo. Creo que voy a tener fotos de todas vosotras en la casa de Aruba."
    mc "Ich verstehe. Ich denke, ich werde Fotos von euch allen im Haus auf Aruba machen."

# game/scripts/c27/c27.rpy:3540
translate german c27s006_ColombiaPics_e3c7c9e9:

    # mc "El salón es sorprendentemente cómodo."
    mc "Das Wohnzimmer ist überraschend gemütlich."

# game/scripts/c27/c27.rpy:3541
translate german c27s006_ColombiaPics_a8a8affc:

    # oma "*Desde el baño* Gracias. No me gusta tener demasiadas cosas, y menos en un piso tan pequeño."
    oma "*Aus dem Badezimmer* Danke. Ich mag es nicht, zu viele Dinge zu haben, besonders nicht in so einer kleinen Wohnung."

# game/scripts/c27/c27.rpy:3542
translate german c27s006_ColombiaPics_ffdf72ba:

    # oma "*Desde el baño* Con todo lo que ahorré en decoración, compré un buen sofá."
    oma "*Aus dem Badezimmer* Von dem ganzen Geld, das ich bei der Dekoration gespart habe, habe ich mir ein schönes Sofa gekauft."

# game/scripts/c27/c27.rpy:3546
translate german c27s006_Ready_8554240f:

    # oma "Ya estoy lista. Nos podemos ir cuando quieras."
    oma "Ich bin bereit. Wir können losfahren, wann immer du willst."

# game/scripts/c27/c27.rpy:3547
translate german c27s006_Ready_b58b04d2:

    # mc "Vamos, las chicas estarán deseando volverte a ver."
    mc "Na los, die Mädchen werden sich schon freuen, dich wiederzusehen."

# game/scripts/c27/c27.rpy:3551
translate german c27s006_Drive_c2b33a74:

    # "Poco después volvéis a por la camioneta y sigues charlando con [oma] mientras la llevas a casa."
    "Kurz darauf holst du den Lieferwagen zurück und unterhältst dich weiter mit [oma], während du sie nach Hause fährst."

# game/scripts/c27/c27.rpy:3552
translate german c27s006_Drive_df6dcad8:

    # "Nunca se había subido a tu camioneta y van dos veces en el mismo día."
    "Er ist noch nie zuvor in Ihrem Lastwagen mitgefahren, und dies ist bereits das zweite Mal am selben Tag."

# game/scripts/c27/c27.rpy:3553
translate german c27s006_Drive_9cf55007:

    # "Le gusta más que su viejo coche. No te sorprende."
    "Es gefällt ihm besser als sein altes Auto. Kein Wunder."

# game/scripts/c27/c27.rpy:3558
translate german c27s008_NoOma_450ebe3b:

    # "Mientras esperas que [eil] y [sca] vuelvan del café, subes a tu habitación a jugar a My Residence un rato."
    "Während du darauf wartest, dass [eil] und [sca] aus dem Café zurückkehren, gehst du auf dein Zimmer, um eine Weile My Residence zu spielen."

# game/scripts/c27/c27.rpy:3559
translate german c27s008_NoOma_b4156144:

    # "Tienes una tórrida escena con Alejandra, la bombera Latina, que se disfraza de policía para la escena, reforzando su parecido con [oma]."
    "Es gibt eine heiße Szene mit Alejandra, der lateinamerikanischen Feuerwehrfrau, die sich für die Szene als Polizistin verkleidet, was ihre Ähnlichkeit mit [oma] noch verstärkt."

# game/scripts/c27/c27.rpy:3569
translate german c27s006_Teaser_aeca0d27:

    # "Al cabo de un rato..."
    "Nach einer Weile..."

# game/scripts/c27/c27.rpy:3571
translate german c27s006_Teaser_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c27/c27.rpy:3572
translate german c27s006_Teaser_dba43fc1:

    # mc "¿Esperas a alguien?"
    mc "Wartest du auf jemanden?"

# game/scripts/c27/c27.rpy:3573
translate german c27s006_Teaser_a566da44:

    # oma "Es posible que sea mi casera."
    oma "Sie könnte meine Vermieterin sein."

# game/scripts/c27/c27.rpy:3575
translate german c27s006_Teaser_a1261f46:

    # mc "Inoportuna casera..."
    mc "Unangenehme Vermieterin..."

# game/scripts/c27/c27.rpy:3577
translate german c27s006_Teaser_59d8b241:

    # oma "*Risa* Con los gritos que he estado dando, alguien podría pensar que me estaban asesinando."
    oma "*lacht* Bei dem Geschrei, das ich von mir gegeben habe, könnte man meinen, ich würde ermordet."

# game/scripts/c27/c27.rpy:3578
translate german c27s006_Teaser_3d3c5712:

    # mc "*Risa* Espero que este no sea un apartamento de esos a los que no puedes traer visitas."
    mc "*lacht* Hoffentlich ist das nicht eine dieser Wohnungen, in denen man keinen Besuch empfangen darf."

# game/scripts/c27/c27.rpy:3580
translate german c27s006_Teaser_9d1fc4fb:

    # oma "No te preocupes, no lo es. Nunca cogería uno así porque no podría venir mi familia de San Diego a visitarme."
    oma "Keine Sorge, so ist es nicht. Ich würde mir so etwas nie anschaffen, weil meine Familie aus San Diego mich dann nicht besuchen könnte."

# game/scripts/c27/c27.rpy:3581
translate german c27s006_Teaser_abdcf07f:

    # oma "Sería bastante inutil tener una habitación de invitados si no puedo tener invitados."
    oma "Es wäre ziemlich sinnlos, ein Gästezimmer zu haben, wenn ich keine Gäste empfangen kann."

# game/scripts/c27/c27.rpy:3582
translate german c27s006_Teaser_fdde8b4c:

    # mc "No lo había pensado. *Risa* Creo que la sangre no ha vuelto a mi cerebro aún."
    mc "Daran hatte ich gar nicht gedacht. *lacht* Ich glaube, das Blut ist noch nicht wieder in mein Gehirn zurückgekehrt."

# game/scripts/c27/c27.rpy:3584
translate german c27s006_Teaser_883aa909:

    # oma "De todas formas no salgas y espérame aquí."
    oma "Also, geh nicht raus und warte hier auf mich."

# game/scripts/c27/c27.rpy:3585
translate german c27s006_Teaser_0e92c958:

    # mc "No te preocupes, no tengo ningún interés en tu casera. ¿Vas a abrirle así?"
    mc "Keine Sorge, ich habe kein Interesse an Ihrer Vermieterin. Wollen Sie die Tür so öffnen?"

# game/scripts/c27/c27.rpy:3586
translate german c27s006_Teaser_57095ea6:

    # oma "Voy a ponerme el albornoz. Está en el baño."
    oma "Ich werde meinen Bademantel anziehen. Er ist im Badezimmer."

# game/scripts/c27/c27.rpy:3587
translate german c27s006_Teaser_9112ae5b:

    # oma "También podría ser un paquete de Amazonian, pero lo esperaba para mañana. U otra cosa. En este edificio nunca puedes estar seguro de quién va a llamar a la puerta."
    oma "Es könnte auch ein Amazon-Paket sein, aber ich hatte es erst morgen erwartet. Oder etwas anderes. In diesem Gebäude weiß man nie, wer an die Tür klopft."

# game/scripts/c27/c27.rpy:3589
translate german c27s006_Teaser_dd4cc306:

    # "Alexia cierra la puerta corredera y te quedas solo con el póster de Esperanza."
    "Alexia schließt die Schiebetür und du bist allein mit dem Poster von Esperanza."

# game/scripts/c27/c27.rpy:3590
translate german c27s006_Teaser_981317b4:

    # mcp "(Bueno, nos hemos quedado solos tú y yo. Espero que hayas disfrutado del espectáculo.)"
    mcp "(So, jetzt sind nur noch du und ich da. Ich hoffe, dir hat die Show gefallen.)"

# game/scripts/c27/c27.rpy:3591
translate german c27s006_Teaser_fffb1d1b:

    # "Esperanza no contesta. Te hubieras acojonado si lo hubiera hecho."
    "Esperanza antwortet nicht. Du wärst entsetzt gewesen, wenn sie geantwortet hätte."

# game/scripts/c27/c27.rpy:3592
translate german c27s006_Teaser_d3c444b0:

    # "Escuchas voces en la puerta, casi susurros, pero no eres capaz de entender lo que dicen. Este piso tiene una acústica horrible."
    "Man hört Stimmen an der Tür, fast Flüstern, aber man kann nicht verstehen, was sie sagen. Die Akustik in dieser Wohnung ist furchtbar."

# game/scripts/c27/c27.rpy:3593
translate german c27s006_Teaser_9310e117:

    # "No eres capaz ni siquiera de reconocer la voz de [oma]."
    "Du bist nicht einmal in der Lage, die Stimme von [oma] zu erkennen."

# game/scripts/c27/c27.rpy:3594
translate german c27s006_Teaser_5b953202:

    # "Pasan alrededor de cinco minutos antes de que la puerta vuelva a deslizarse."
    "Es dauert ungefähr fünf Minuten, bis die Tür wieder aufgleitet."

# game/scripts/c27/c27.rpy:3600
translate german c27s006_Teaser_f859c0f0:

    # oma "Pues no, no era mi casera."
    oma "Nein, sie war nicht meine Vermieterin."

# game/scripts/c27/c27.rpy:3602
translate german c27s006_Teaser_0aa6f813:

    # mc "¡Wow, [oma]! Eso es aún mejor que el disfraz de policía."
    mc "Wow, [oma]! Das ist ja noch besser als das Polizeikostüm."

# game/scripts/c27/c27.rpy:3603
translate german c27s006_Teaser_9be03137:

    # mc "No sé cómo puedes meter el Yeti ahí dentro, parece cosa de magia."
    mc "Ich weiß nicht, wie man den Yeti da unterbringen kann, das scheint mir wie Zauberei."

# game/scripts/c27/c27.rpy:3604
translate german c27s006_Teaser_46a91b34:

    # mc "¿Era una entrega de Amazonian con esa lencería?"
    mc "War das eine Amazon-Lieferung mit der Lingerie?"

# game/scripts/c27/c27.rpy:3606
translate german c27s006_Teaser_52fb0aaf:

    # oma "Bueno, no era una entrega precisamente. La lencería me la regaló [emm] cuando volvisteis de Monterey. Tiene buen gusto y ha acertado con los colores."
    oma "Nun ja, es war nicht direkt eine Lieferung. [emm] hat mir die Dessous gegeben, als du aus Monterey zurückkamst. Sie hat einen guten Geschmack und hat die Farben perfekt ausgewählt."

# game/scripts/c27/c27.rpy:3607
translate german c27s006_Teaser_114e2bcb:

    # mc "¿Colores? Solo veo azul... Siempre he pensado que el azul te queda espectacular."
    mc "Farben? Ich sehe nur Blau... Ich fand schon immer, dass Blau dir hervorragend steht."

# game/scripts/c27/c27.rpy:3609
translate german c27s006_Teaser_bf90a7a3:

    # oma "No es el único color que vas a ver hoy."
    oma "Das ist nicht die einzige Farbe, die Sie heute sehen werden."

# game/scripts/c27/c27.rpy:3615
translate german c27s006_Teaser_7100e4fc:

    # eil "También tiene buen gusto para elegir el verde."
    eil "Sie hat auch einen guten Geschmack, wenn es um die Wahl von Grün geht."

# game/scripts/c27/c27.rpy:3617
translate german c27s006_Teaser_d0d6e388:

    # mc "¡Wow, [eil]! Ciertamente te queda muy vien el verde. Siempre ha sido tu color."
    mc "Wow, [eil]! Grün steht dir wirklich hervorragend. Das war schon immer deine Farbe."

# game/scripts/c27/c27.rpy:3618
translate german c27s006_Teaser_29b92bcf:

    # mc "¿No tenías que llevar a [sca] a casa?"
    mc "Musstest du [sca] nicht mit nach Hause nehmen?"

# game/scripts/c27/c27.rpy:3620
translate german c27s006_Teaser_da9cf840:

    # eil "Ya lo he hecho. La entrevista ha ido bien."
    eil "Ich habe es bereits erledigt. Das Vorstellungsgespräch verlief gut."

# game/scripts/c27/c27.rpy:3621
translate german c27s006_Teaser_318f01a5:

    # eil "Y en el camino de vuelta he recogido un paquete."
    eil "Und auf dem Rückweg habe ich ein Paket abgeholt."

# game/scripts/c27/c27.rpy:3622
translate german c27s006_Teaser_349d9527:

    # mc "¿Qué? ¿Qué paquete? Si la lencería os la había comprado [emm]... ¿La has traído tú de casa?"
    mc "Was? Welches Paket? Ich habe die Dessous für dich gekauft [emm]... Hast du sie von zu Hause mitgebracht?"

# game/scripts/c27/c27.rpy:3624
translate german c27s006_Teaser_1de3eb6a:

    # eil "Ese paquete..."
    eil "Dieses Paket..."

# game/scripts/c27/c27.rpy:3630
translate german c27s006_Teaser_6bfe76fd:

    # sai "El paquete soy yo. *Risa* Odio a la perra pelirroja por llamarme paquete."
    sai "Ich bin das Gesamtpaket. *lacht* Ich hasse diese rothaarige Schlampe dafür, dass sie mich ein Gesamtpaket genannt hat."

# game/scripts/c27/c27.rpy:3631
translate german c27s006_Teaser_9c051e94:

    # sai "Pero la adoro por haber propuesto esto. *Risa*"
    sai "Aber ich liebe sie dafür, dass sie das vorgeschlagen hat. *lacht*"

# game/scripts/c27/c27.rpy:3632
translate german c27s006_Teaser_f234a5f7:

    # mc "¡Wow, [sai]! Uno de los paquetes más bonitos del mundo."
    mc "Wow, [sai]! Eines der schönsten Pakete der Welt."

# game/scripts/c27/c27.rpy:3634
translate german c27s006_Teaser_cdbc5a06:

    # mc "Sería difícil decidir qué paquete me gusta más."
    mc "Es wäre schwierig zu entscheiden, welches Paket mir besser gefällt."

# game/scripts/c27/c27.rpy:3635
translate german c27s006_Teaser_b2241119:

    # oma "¿Vas a quedarte babeando en la cama?"
    oma "Willst du etwa sabbernd im Bett liegen bleiben?"

# game/scripts/c27/c27.rpy:3636
translate german c27s006_Teaser_54633dbb:

    # eil "¿O vas a venir a abrir tus regalos?"
    eil "Oder kommst du, um deine Geschenke auszupacken?"

# game/scripts/c27/c27.rpy:3637
translate german c27s006_Teaser_d3c08691:

    # sai "Mi Pequeñín parece que quiere divertirse..."
    sai "Mein Kleiner scheint etwas Spaß haben zu wollen..."

# game/scripts/c27/c27.rpy:3643
translate german c27s006_NoThreesome_aeca0d27:

    # "Al cabo de un rato..."
    "Nach einer Weile..."

# game/scripts/c27/c27.rpy:3645
translate german c27s006_NoThreesome_ae16ae33:

    # oma "Creo que deberíamos irnos a casa."
    oma "Ich denke, wir sollten nach Hause gehen."

# game/scripts/c27/c27.rpy:3646
translate german c27s006_NoThreesome_d37a323a:

    # mc "*Risa* ¿Ya te has cansado de mí? ¿No va a haber segundo round?"
    mc "*Lacht* Hast du mich schon satt? Gibt es denn keine zweite Runde?"

# game/scripts/c27/c27.rpy:3648
translate german c27s006_NoThreesome_57f4f5a7:

    # oma "*Risa* ¡No seas tonto! ¡Nunca me cansaré de ti!"
    oma "*Lacht* Sei doch nicht albern! Ich werde dich nie satt haben!"

# game/scripts/c27/c27.rpy:3649
translate german c27s006_NoThreesome_6915d346:

    # oma "Pero necesito descansar antes de entrar a trabajar. Si me sigues follando así voy a estar echa polvo esta noche."
    oma "Aber ich muss mich ausruhen, bevor ich anfange zu arbeiten. Wenn du mich weiterhin so vögelst, werde ich heute Abend total erschöpft sein."

# game/scripts/c27/c27.rpy:3650
translate german c27s006_NoThreesome_5b67b3e7:

    # mc "Solo bromeaba. ¿Te has dado cuenta de que siempre parece que vamos con prisas?"
    mc "Ich habe nur gescherzt. Ist Ihnen aufgefallen, wie in Eile wir immer sind?"

# game/scripts/c27/c27.rpy:3652
translate german c27s006_NoThreesome_8802f6f5:

    # mc "El prado, el lago, el jacuzzi, hoy..."
    mc "Die Wiese, der See, der Whirlpool, heute..."

# game/scripts/c27/c27.rpy:3654
translate german c27s006_NoThreesome_1cee67cd:

    # mc "El prado, el jacuzzi, hoy..."
    mc "Die Wiese, der Whirlpool, heute..."

# game/scripts/c27/c27.rpy:3656
translate german c27s006_NoThreesome_2bc3c9e3:

    # oma "Un día te secuestraré toda la noche y no abriré las esposas para que no te puedas ir."
    oma "Eines Tages werde ich dich für die ganze Nacht entführen und die Handschellen nicht öffnen, damit du nicht fliehen kannst."

# game/scripts/c27/c27.rpy:3657
translate german c27s006_NoThreesome_702f2950:

    # oma "Pero solo después de cada asalto. Ya te he dicho que prefiero que tus manos recorran mi piel."
    oma "Aber erst nach jeder Runde. Ich habe dir ja schon gesagt, dass ich es bevorzuge, wenn deine Hände über meine Haut streichen."

# game/scripts/c27/c27.rpy:3658
translate german c27s006_NoThreesome_ac2cb679:

    # mc "*Fingiendo sorpresa* ¡Agente Martinez! Secuestrarme sería delito... *Risa*"
    mc "*Tut überrascht* Agent Martinez! Mich zu entführen wäre ein Verbrechen... *Lacht*"

# game/scripts/c27/c27.rpy:3660
translate german c27s006_NoThreesome_76b8ce52:

    # oma "¿Me denunciarías?"
    oma "Würden Sie mich melden?"

# game/scripts/c27/c27.rpy:3661
translate german c27s006_NoThreesome_6ff41185:

    # mc "Nope."
    mc "Nein."

# game/scripts/c27/c27.rpy:3662
translate german c27s006_NoThreesome_eeba8148:

    # oma "Es lo que me parecía. Ve vistiéndote que voy a preparar una bolsa con el uniforme y los pijamas."
    oma "Das dachte ich mir. Zieh dich schon mal an, ich packe eine Tasche mit der Uniform und dem Schlafanzug."

# game/scripts/c27/c27.rpy:3663
translate german c27s006_NoThreesome_04b0d227:

    # mc "OK, te espero al final del pasillo, en eso que llamas salón."
    mc "Okay, ich warte am Ende des Flurs auf dich, in dem, was du Wohnzimmer nennst."

# game/scripts/c27/c27.rpy:3680
translate german c27s008_Oma_c39ffd4d:

    # oma "Ya estoy lista."
    oma "Ich bin bereit."

# game/scripts/c27/c27.rpy:3682
translate german c27s008_Oma_4ee40038:

    # mc "¡Wow, [oma]! ¿Vas a detenerme? No he puesto los pies encima del sofá. *Risa* ¡Lo juro!"
    mc "Wow, [oma]! Willst du mich etwa aufhalten? Ich habe meine Füße noch nicht mal auf die Couch gelegt. *Lacht* Ehrlich!"

# game/scripts/c27/c27.rpy:3684
translate german c27s008_Oma_0b06bca5:

    # oma "*Risa* No me tientes. Pero una vez me pediste que te esposara."
    oma "*Lacht* Bring mich nicht in Versuchung. Aber du hast mich doch einmal gebeten, dir Handschellen anzulegen."

# game/scripts/c27/c27.rpy:3685
translate german c27s008_Oma_3b29b6a1:

    # oma "¿Te has arrepentido?"
    oma "Hast du es bereut?"

# game/scripts/c27/c27.rpy:3686
translate german c27s008_Oma_f1cda333:

    # mc "Nope. No me han esposado nunca, y creo que es algo que querría probar al menos una vez en la vida."
    mc "Nein. Ich wurde noch nie in Handschellen gelegt, und ich denke, das ist etwas, das ich zumindest einmal in meinem Leben gerne einmal ausprobieren würde."

# game/scripts/c27/c27.rpy:3688
translate german c27s008_Oma_6e6ec337:

    # oma "Déjame quitarme esto. Es incomodísima."
    oma "Ich ziehe das aus. Es ist unglaublich unbequem."

# game/scripts/c27/c27.rpy:3689
translate german c27s008_Oma_946d03b0:

    # mc "Además, seguro que nos molesta para hacer esto."
    mc "Außerdem würde es uns sicher stören, das tun zu müssen."

# game/scripts/c27/c27.rpy:3691
translate german c27s008_Oma_325fcd49:

    # "Te levantas del sofá, la coges entre tus brazos, y la besas con dulzura y pasión."
    "Du stehst vom Sofa auf, nimmst sie in deine Arme und küsst sie zärtlich und leidenschaftlich."

# game/scripts/c27/c27.rpy:3692
translate german c27s008_Oma_af54af8d:

    # "Te parece que hace siglos que no estáis juntos y, si te va a esposar, no vas a poder usar las manos."
    "Es fühlt sich an, als sei es eine Ewigkeit her, seit ihr zusammen wart, und wenn er dir Handschellen anlegt, wirst du deine Hände nicht benutzen können."

# game/scripts/c27/c27.rpy:3694
translate german c27s008_Oma_293099b1:

    # "Aprovechas para darles un buen uso en ese momento."
    "Sie nutzen diesen Moment, um sie sinnvoll einzusetzen."

# game/scripts/c27/c27.rpy:3695
translate german c27s008_Oma_82c0b054:

    # "Ahora mismo te podrían detener por posesión de drogas. El cuerpo de [oma] es adictivo."
    "Du könntest jetzt wegen Drogenbesitzes verhaftet werden. [oma]s Körper macht süchtig."

# game/scripts/c27/c27.rpy:3697
translate german c27s008_Oma_9ee2e914:

    # oma "Creo que voy a tener que detenerle, Señor."
    oma "Ich glaube, ich muss Sie unterbrechen, mein Herr."

# game/scripts/c27/c27.rpy:3698
translate german c27s008_Oma_3ec1e0cd:

    # mc "¿Por qué? ¿De qué se me acusa, Agente?"
    mc "Warum? Wessen werde ich beschuldigt, Herr Wachtmeister?"

# game/scripts/c27/c27.rpy:3700
translate german c27s008_Oma_b6e745bb:

    # oma "*Risita* Posesión de armas."
    oma "*Kichern* Waffenbesitz."

# game/scripts/c27/c27.rpy:3701
translate german c27s008_Oma_e1bfc66e:

    # mc "*Risa* ¡Pero ese arma no es mía, Agente!"
    mc "*lacht* Aber die Waffe gehört mir nicht, Agent!"

# game/scripts/c27/c27.rpy:3703
translate german c27s008_Oma_5e53e8e8:

    # oma "¿Ah, no? ¿De quién es? ¿Va a decirme que no la ha visto nunca?"
    oma "Ach, wirklich? Wem gehört das? Willst du mir etwa erzählen, dass du es noch nie gesehen hast?"

# game/scripts/c27/c27.rpy:3704
translate german c27s008_Oma_56338ff7:

    # mc "No, la he visto muchas veces, pero ahora mismo es tuya."
    mc "Nein, ich habe sie schon oft gesehen, aber im Moment gehört sie dir."

# game/scripts/c27/c27.rpy:3706
translate german c27s008_Oma_fc3807d0:

    # oma "*Risa* Sabes que eso no te va a servir en un juicio, ¿verdad?"
    oma "*lacht* Du weißt schon, dass dir das vor Gericht nicht helfen wird, oder?"

# game/scripts/c27/c27.rpy:3707
translate german c27s008_Oma_4acfcfd0:

    # mc "Bueno, no esperaba llegar a juicio. *Guiño* Esperaba que pudiéramos llegar a algún tipo de acuerdo extrajudicial."
    mc "Nun ja, ich hatte nicht erwartet, dass es zu einem Prozess kommt. *Zwinker* Ich hatte gehofft, wir könnten eine außergerichtliche Einigung erzielen."

# game/scripts/c27/c27.rpy:3709
translate german c27s008_Oma_07c27513:

    # oma "¿Está intentando sobornarme, Sr. Marks?"
    oma "Wollen Sie mich etwa bestechen, Mr. Marks?"

# game/scripts/c27/c27.rpy:3710
translate german c27s008_Oma_4db9982d:

    # mc "No, Agente. Nunca haría algo así..."
    mc "Nein, Agent. Ich würde so etwas niemals tun..."

# game/scripts/c27/c27.rpy:3711
translate german c27s008_Oma_8ca6f137:

    # mc "Además, lo de la posesión de armas es sólo una sospecha hasta que me registre, ¿no?"
    mc "Außerdem ist die Sache mit dem Waffenbesitz nur ein Verdacht, bis ich mich registriere, richtig?"

# game/scripts/c27/c27.rpy:3714
translate german c27s008_Oma_bdbb0de0:

    # oma "¡Las manos contra la pared!"
    oma "Hände an die Wand!"

# game/scripts/c27/c27.rpy:3715
translate german c27s008_Oma_549dcc63:

    # mc "*Risa* Esto se pone interesante."
    mc "*lacht* Das wird ja immer interessanter."

# game/scripts/c27/c27.rpy:3717
translate german c27s008_Oma_95392c7c:

    # oma "Tiene derecho a guardar silencio."
    oma "Sie haben das Recht zu schweigen."

# game/scripts/c27/c27.rpy:3718
translate german c27s008_Oma_86865889:

    # oma "Cualquier cosa que diga puede y será usada en su contra en un tribunal."
    oma "Alles, was Sie sagen, kann und wird vor Gericht gegen Sie verwendet werden."

# game/scripts/c27/c27.rpy:3719
translate german c27s008_Oma_18f279ec:

    # mc "*Risa* Creía que ibas a buscar armas más abajo."
    mc "*lacht* Ich dachte, du würdest weiter unten nach Waffen suchen."

# game/scripts/c27/c27.rpy:3721
translate german c27s008_Oma_5b506897:

    # oma "Tiene el derecho a contar con un abogado."
    oma "Sie haben das Recht auf einen Anwalt."

# game/scripts/c27/c27.rpy:3722
translate german c27s008_Oma_91f3868c:

    # oma "Si no puede pagar un abogado, se le proporcionará uno de oficio."
    oma "Wenn Sie sich keinen Anwalt leisten können, wird Ihnen einer gestellt."

# game/scripts/c27/c27.rpy:3723
translate german c27s008_Oma_5020e1c0:

    # mc "La abogada que me hubiera gustado tener se acabó metiendo a policía."
    mc "Ich hätte mir gewünscht, dass der Anwalt Polizist geworden wäre."

# game/scripts/c27/c27.rpy:3725
translate german c27s008_Oma_0a963915:

    # oma "¡Y aquí aparece el arma que estaba buscando!"
    oma "Und da erscheint die Waffe, nach der ich gesucht habe!"

# game/scripts/c27/c27.rpy:3726
translate german c27s008_Oma_c68645a3:

    # oma "No sé si calificarla como arma de gran calibre o de destrucción masiva..."
    oma "Ich weiß nicht, ob ich es als großkalibrige Waffe oder als Massenvernichtungswaffe einstufen soll..."

# game/scripts/c27/c27.rpy:3727
translate german c27s008_Oma_ba98ad2d:

    # mc "¿Por qué no los dos?"
    mc "Warum nicht beides?"

# game/scripts/c27/c27.rpy:3729
translate german c27s008_Oma_dc936135:

    # oma "Creo que me lo voy a llevar detenido. Sígueme a la sala de interrogatorios para ser esposado."
    oma "Ich glaube, ich werde Sie verhaften. Folgen Sie mir in den Verhörraum, um sich Handschellen anlegen zu lassen."

# game/scripts/c27/c27.rpy:3730
translate german c27s008_Oma_33ad3452:

    # mc "*Risa* Espero que no le digas eso a los delincuentes de verdad y los esposes antes."
    mc "*Lacht* Ich hoffe, du sagst das nicht zu echten Kriminellen und legst ihnen vorher Handschellen an."

# game/scripts/c27/c27.rpy:3732
translate german c27s008_Oma_ec617e28:

    # oma "*Risa* Por norma ellos no quieren ser esposados. No es tu caso."
    oma "*Gelächter* Normalerweise wollen sie sich nicht in Handschellen legen lassen. Das ist bei Ihnen nicht der Fall."

# game/scripts/c27/c27.rpy:3733
translate german c27s008_Oma_0ee60c4a:

    # oma "Sé que tú me vas a seguir."
    oma "Ich weiß, dass du mir folgen wirst."

# game/scripts/c27/c27.rpy:3734
translate german c27s008_Oma_a362ef39:

    # mc "Me conoces demasiado bien."
    mc "Du kennst mich zu gut."

# game/scripts/c27/c27.rpy:3736
translate german c27s008_Oma_795b6dba:

    # oma "¿Qué tal?"
    oma "Wie geht es dir?"

# game/scripts/c27/c27.rpy:3737
translate german c27s008_Oma_16fe1f34:

    # mc "*Risa* Esperaba unas esposas de la policía."
    mc "*lacht* Ich hatte schon mit Polizeihandschellen gerechnet."

# game/scripts/c27/c27.rpy:3739
translate german c27s008_Oma_b8e28bac:

    # oma "Esas seguramente te acabarían haciendo daño. ¿Son incómodas?"
    oma "Die würden dir wahrscheinlich wehtun. Sind sie unbequem?"

# game/scripts/c27/c27.rpy:3740
translate german c27s008_Oma_49781109:

    # mc "No, los grilletes no son incómodos, pero la posición a la que me obliga la cadena sí que lo es."
    mc "Nein, die Fesseln an sich sind nicht unbequem, sondern die Position, in die mich die Kette zwingt."

# game/scripts/c27/c27.rpy:3742
translate german c27s008_Oma_00cf1960:

    # oma "Espera un segundo..."
    oma "Moment mal..."

# game/scripts/c27/c27.rpy:3743
translate german c27s008_Oma_8527cb0f:

    # mc "Con estas vistas, puedes tomarte todo el tiempo que quieras. *Risa*"
    mc "Bei dieser Aussicht können Sie sich alle Zeit der Welt nehmen. *lacht*"

# game/scripts/c27/c27.rpy:3745
translate german c27s008_Oma_b4c1dbc4:

    # oma "Ya está..."
    oma "Das war's..."

# game/scripts/c27/c27.rpy:3746
translate german c27s008_Oma_137c15d5:

    # mc "¿Sin cadena?"
    mc "Ohne Kette?"

# game/scripts/c27/c27.rpy:3748
translate german c27s008_Oma_b99b6556:

    # oma "Has dicho que era incómodo. Haz como si estuviera ahí. Los grilletes los sigues llevando, con lo que la sensación será parecida."
    oma "Du sagtest, es sei unangenehm. Stell dir einfach vor, es wäre da. Du trägst die Fesseln ja immer noch, also wird sich das Gefühl ähnlich anfühlen."

# game/scripts/c27/c27.rpy:3749
translate german c27s008_Oma_0ba12911:

    # mc "Ummm... me gusta la idea. Más juego de rol todavía..."
    mc "Hmm... die Idee gefällt mir. Noch mehr Rollenspiel..."

# game/scripts/c27/c27.rpy:3751
translate german c27s008_Oma_df38c391:

    # oma "¿Quién ha dicho que fuera un juego de rol?"
    oma "Wer hat behauptet, es sei ein Rollenspiel?"

# game/scripts/c27/c27.rpy:3752
translate german c27s008_Oma_63c201c8:

    # oma "Ahora, quédate ahí... encadenado... mientras te torturo para sacarte información."
    oma "Nun bleib dort... angekettet... während ich dich foltere, um Informationen aus dir herauszubekommen."

# game/scripts/c27/c27.rpy:3753
translate german c27s008_Oma_50ee082e:

    # mc "Creía que la tortura estaba prohibida por la Convención de Ginebra, o la de Vodka..."
    mc "Ich dachte, Folter sei durch die Genfer Konvention oder die Wodka-Konvention verboten..."

# game/scripts/c27/c27.rpy:3755
translate german c27s008_Oma_94f6489d:

    # oma "*Risa* No creo que la Convención de Ginebra diga nada de las detenciones policiales."
    oma "*Gelächter* Ich glaube nicht, dass die Genfer Konvention etwas über polizeiliche Verhaftungen aussagt."

# game/scripts/c27/c27.rpy:3756
translate german c27s008_Oma_94ffc53f:

    # oma "De todas formas, a nadie se le ocurrió poner ESTE TIPO de tortura en la Convención."
    oma "Jedenfalls kam niemand auf die Idee, DIESE ART von Folter in die Konvention aufzunehmen."

# game/scripts/c27/c27.rpy:3757
translate german c27s008_Oma_93ee1d8a:

    # mc "No me extraña... Seguramente si hubieran pensado en ello tampoco la hubieran prohibido..."
    mc "Das überrascht mich nicht... Hätten sie darüber nachgedacht, hätten sie es sicherlich auch nicht verboten..."

# game/scripts/c27/c27.rpy:3759
translate german c27s008_Oma_8f7063ba:

    # oma "Seguramente no pensaban en este tipo de botas tampoco. Más bien en botas de soldados."
    oma "Wahrscheinlich dachten sie auch nicht an solche Stiefel. Eher an Soldatenstiefel."

# game/scripts/c27/c27.rpy:3760
translate german c27s008_Oma_70c6658e:

    # mc "Con lo que un paso importante es eliminar esas botas."
    mc "Ein wichtiger Schritt ist also, die Stiefel auszuziehen."

# game/scripts/c27/c27.rpy:3762
translate german c27s008_Oma_39398b54:

    # mc "¿También te quitas los guantes?"
    mc "Ziehen Sie Ihre Handschuhe auch aus?"

# game/scripts/c27/c27.rpy:3763
translate german c27s008_Oma_6d183fc0:

    # oma "Prefiero tener mi sentido del tacto intacto para poder manipular ese arma de gran calibre."
    oma "Ich möchte meinen Tastsinn behalten, damit ich mit dieser großkalibrigen Waffe umgehen kann."

# game/scripts/c27/c27.rpy:3764
translate german c27s008_Oma_ca79670c:

    # mc "Me parece una muy buena razón para hacerlo."
    mc "Ich denke, das ist ein sehr guter Grund dafür."

# game/scripts/c27/c27.rpy:3766
translate german c27s008_Oma_aed0232b:

    # mc "Con la desaparición de ese cinturón, la cosa se está poniendo más interesante todavía."
    mc "Mit dem Verschwinden dieses Gürtels wird die Sache noch interessanter."

# game/scripts/c27/c27.rpy:3767
translate german c27s008_Oma_9df2b63c:

    # oma "¿No era lo suficientemente interesante para ti?"
    oma "War es nicht interessant genug für dich?"

# game/scripts/c27/c27.rpy:3768
translate german c27s008_Oma_fb1d866a:

    # mc "*Risa* Por supuesto que lo era. Por eso he dicho 'todavía'."
    mc "*Lacht* Natürlich war es das. Deshalb sagte ich ja „immer noch“."

# game/scripts/c27/c27.rpy:3770
translate german c27s008_Oma_7a729905:

    # oma "*Risa* Entonces no me daré por ofendida."
    oma "*Lacht* Dann werde ich mich nicht beleidigt fühlen."

# game/scripts/c27/c27.rpy:3771
translate german c27s008_Oma_dbcb25e3:

    # mc "Nunca querría ofenderte. Y menos aún cuando estoy indefenso, 'encadenado' a la cama."
    mc "Ich möchte dich niemals beleidigen. Und erst recht nicht, wenn ich hilflos bin, quasi ans Bett gefesselt."

# game/scripts/c27/c27.rpy:3773
translate german c27s008_Oma_70e82eac:

    # oma "Como puedes ver, yo no voy armada. No tengo dónde esconder un arma."
    oma "Wie Sie sehen, bin ich nicht bewaffnet. Ich habe auch keinen Ort, wo ich eine Waffe verstecken könnte."

# game/scripts/c27/c27.rpy:3774
translate german c27s008_Oma_ee2b4f08:

    # mc "Déjame estar en desacuerdo. *Risa* En el Yeti se podrían esconder un par de tanques."
    mc "Da bin ich anderer Meinung. *lacht* Im Yeti könnten ein paar Panzer versteckt werden."

# game/scripts/c27/c27.rpy:3776
translate german c27s008_Oma_05b88ef4:

    # oma "*Risa* ¡[mc]!"
    oma "*Lachen* [mc]!"

# game/scripts/c27/c27.rpy:3777
translate german c27s008_Oma_de5a1015:

    # mc "Y esa sonrisa podría desarmar a ejércitos enteros."
    mc "Und dieses Lächeln könnte ganze Armeen entwaffnen."

# game/scripts/c27/c27.rpy:3779
translate german c27s008_Oma_dfd8bbee:

    # oma "Eso me gusta más. ¿Qué tal la tortura hasta ahora?"
    oma "Das gefällt mir besser. Wie war die Folter bisher?"

# game/scripts/c27/c27.rpy:3780
translate german c27s008_Oma_c7430335:

    # mc "Las vistas son increíbles, pero esto de estar 'encadenado' y no poder usar las manos..."
